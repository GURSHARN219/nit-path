{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1,
  "lineCount": 53,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0001_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaadh ||",
      "translation": "The Lord is One and He can be attained through the grace of the true Guru.",
      "punjabiViakhya": "ੴ ਸਤਿਗੁਰਪ੍ਰਸਾਦਿ:",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "ੴ सतिगुर प्रसादि ॥",
      "sourceLineId": "74212",
      "sourceShabadId": "7402",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਾਪੁ ॥",
      "transliteration": "jaap ||",
      "translation": "Name of the Bani : Japu Sahib",
      "punjabiViakhya": "ਜਾਪੁ:",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "जापु ॥",
      "sourceLineId": "74213",
      "sourceShabadId": "7402",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸ੍ਰੀ ਮੁਖਵਾਕ ਪਾਤਿਸਾਹੀ ੧੦ ॥",
      "transliteration": "sree mukhavaak paatisaahee 10 ||",
      "translation": "The sacred utterance of The Tenth Sovereign:",
      "punjabiViakhya": "ਦਸਮ ਗੁਰੂ ਜੀ ਦੇ ਮੁਖ ਤੋਂ ਉਚਾਰੀ ਹੋਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "स्री मुखवाक पातिसाही १० ॥",
      "sourceLineId": "74214",
      "sourceShabadId": "7402",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਛਪੈ ਛੰਦ ॥ ਤ੍ਵ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "chhapai chha(n)dh || tavai prasaadh ||",
      "translation": "CHHAPAI STANZA. BY THY GRACE",
      "punjabiViakhya": "ਛਪੈ ਛੰਦ: ਤੇਰੀ ਕ੍ਰਿਪਾ ਨਾਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "छपै छंद ॥ त्व प्रसादि ॥",
      "sourceLineId": "74215",
      "sourceShabadId": "7402",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚੱਕ੍ਰ ਚਿਹਨ ਅਰੁ ਬਰਨ ਜਾਤਿ ਅਰੁ ਪਾਤਿ ਨਹਿਨ ਜਿਹ ॥",
      "transliteration": "cha'kr chihan ar baran jaat ar paat nahin jeh ||",
      "translation": "He who is without mark or sign, He who is without caste or line.",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਕੋਈ ਚਿੰਨ੍ਹ, ਚਕ੍ਰ, ਵਰਨ, ਜਾਤਿ ਅਤੇ ਗੋਤ ਨਹੀਂ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "चक्क्र चिहन अरु बरन जाति अरु पाति नहिन जिह ॥",
      "sourceLineId": "74216",
      "sourceShabadId": "7402",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰੂਪ ਰੰਗ ਅਰੁ ਰੇਖ ਭੇਖ ਕੋਊ ਕਹਿ ਨ ਸਕਤਿ ਕਿਹ ॥",
      "transliteration": "roop ra(n)g ar rekh bhekh kouoo keh na sakat keh ||",
      "translation": "He who is without colour or form, and without any distinctive norm.",
      "punjabiViakhya": "ਅਤੇ ਜਿਸ ਦੇ ਰੂਪ, ਰੰਗ, ਰੇਖ, ਭੇਖ ਬਾਰੇ ਕੋਈ ਕੁਝ ਨਹੀਂ ਕਹਿ ਸਕਦਾ (ਕਿ ਉਹ) ਕਿਹੋ ਜਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "रूप रंग अरु रेख भेख कोऊ कहि न सकति किह ॥",
      "sourceLineId": "74217",
      "sourceShabadId": "7402",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਚਲ ਮੂਰਤਿ ਅਨਭਉ ਪ੍ਰਕਾਸ ਅਮਿਤੋਜਿ ਕਹਿੱਜੈ ॥",
      "transliteration": "achal moorat anabhau prakaas amitoj kahi'jai ||",
      "translation": "He who is without limit and motion, All effulgence, non-descript Ocean.",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਅਚਲ ਸਰੂਪੀ, ਸੁਤਹ ਗਿਆਨ ਦਾ ਪ੍ਰਕਾਸ਼ਕ ਅਤੇ ਅਮਿਤ ਸ਼ਕਤੀ ਵਾਲਾ ਕਿਹਾ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "अचल मूरति अनभउ प्रकास अमितोजि कहिज्जै ॥",
      "sourceLineId": "74218",
      "sourceShabadId": "7402",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕੋਟਿ ਇੰਦ੍ਰ ਇੰਦ੍ਰਾਣ ਸਾਹੁ ਸਾਹਾਣਿ ਗਣਿਜੈ ॥",
      "transliteration": "koT i(n)dhr i(n)dhraan saahu saahaan ganijai ||",
      "translation": "The Lord of millions of Indras and kings, the Master of all worlds and beings.",
      "punjabiViakhya": "(ਉਹ ਪਰਮ ਸੱਤਾ) ਕਰੋੜਾ ਇੰਦਰਾ ਦਾ ਇੰਦਰ ਅਤੇ ਸ਼ਾਹਾ ਦਾ ਸ਼ਾਹ ਗਿਣਿਆ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "कोटि इंद्र इंद्राण साहु साहाणि गणिजै ॥",
      "sourceLineId": "74219",
      "sourceShabadId": "7402",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤ੍ਰਿਭਵਣ ਮਹੀਪ ਸੁਰ ਨਰ ਅਸੁਰ ਨੇਤ ਨੇਤ ਬਨ ਤ੍ਰਿਣ ਕਹਤ ॥",
      "transliteration": "tirabhavan maheep sur nar asur net net ban tiran kahat ||",
      "translation": "Each twig of the foliage proclaims: “Not this Thou art.”",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਤਿੰਨ ਲੋਕਾ (ਸੁਅਰਗ, ਮਾਤ ਅਤੇ ਪਾਤਾਲ) ਦੇ ਰਾਜੇ, ਦੇਵਤੇ, ਮਨੁੱਖ, ਦੈਂਤ ਅਤੇ ਬਨਾ ਦੇ ਤਿਨਕੇ ਵੀ ਬੇਅੰਤ ਬੇਅੰਤ ਕਹਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "तृभवण महीप सुर नर असुर नेत नेत बन तृण कहत ॥",
      "sourceLineId": "74220",
      "sourceShabadId": "7402",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਵ ਸਰਬ ਨਾਮ ਕਥੈ ਕਵਨ ਕਰਮ ਨਾਮ ਬਰਨਤ ਸੁਮਤਿ ॥੧॥",
      "transliteration": "tav sarab naam kathai kavan karam naam baranat sumat ||1||",
      "translation": "All Thy Names cannot be told. One doth impart Thy Action-Name with benign heart.1.",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੇਰੇ ਸਾਰੇ ਨਾਵਾ ਦਾ ਕਥਨ ਕੌਣ ਕਰ ਸਕਦਾ ਹੈ? (ਬਸ ਤੇਰੇ ਕੁਝ ਕੁ) ਕਰਮਾਚਾਰੀ (ਉਪਕਾਰੀ) ਨਾਵਾ ਦਾ ਚੰਗੀ ਮਤ ਵਾਲਿਆਂ ਨੇ ਵਰਣਨ ਕੀਤਾ ਹੈ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "तव सरब नाम कथै कवन करम नाम बरनत सुमति ॥१॥",
      "sourceLineId": "74221",
      "sourceShabadId": "7402",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "74222",
      "sourceShabadId": "7403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਮਸਤ੍ਵੰ ਅਕਾਲੇ ॥",
      "transliteration": "namasatavai(n) akaale ||",
      "translation": "Salutation to Thee O Timeless Lord",
      "punjabiViakhya": "ਹੇ ਅਕਾਲ ਪੁਰਖ! ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "नमसत्वं अकाले ॥",
      "sourceLineId": "74223",
      "sourceShabadId": "7403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਮਸਤ੍ਵੰ ਕ੍ਰਿਪਾਲੇ ॥",
      "transliteration": "namasatavai(n) kirapaale ||",
      "translation": "Salutation to Thee O Beneficent Lord!",
      "punjabiViakhya": "ਹੇ ਮੇਹਰਾ ਦੇ ਦਾਤੇ! ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "नमसत्वं कृपाले ॥",
      "sourceLineId": "74224",
      "sourceShabadId": "7403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਮਸਤੰ ਅਰੂਪੇ ॥",
      "transliteration": "namasata(n) aroope ||",
      "translation": "Salutation to Thee O Formless Lord!",
      "punjabiViakhya": "ਹੇ ਰੂਪ-ਰਹਿਤ! ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "नमसतं अरूपे ॥",
      "sourceLineId": "74225",
      "sourceShabadId": "7403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਮਸਤੰ ਅਨੂਪੇ ॥੨॥",
      "transliteration": "namasata(n) anoope ||2||",
      "translation": "Salutation to Thee O Wonderful Lord! 2.",
      "punjabiViakhya": "ਹੇ ਉਪਮਾ-ਰਹਿਤ! ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "नमसतं अनूपे ॥२॥",
      "sourceLineId": "74226",
      "sourceShabadId": "7403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਮਸਤੰ ਅਭੇਖੇ ॥",
      "transliteration": "namasata(n) abhekhe ||",
      "translation": "Salutation to Thee O Garbless Lord!",
      "punjabiViakhya": "ਹੇ ਭੇਖਰਹਿਤ! ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "नमसतं अभेखे ॥",
      "sourceLineId": "74227",
      "sourceShabadId": "7403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਮਸਤੰ ਅਲੇਖੇ ॥",
      "transliteration": "namasata(n) alekhe ||",
      "translation": "Salutation to Thee O Accountless Lord!",
      "punjabiViakhya": "ਹੇ ਲਿਖੇ ਨਾ ਜਾ ਸਕਣ ਵਾਲੇ! ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "नमसतं अलेखे ॥",
      "sourceLineId": "74228",
      "sourceShabadId": "7403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਮਸਤੰ ਅਕਾਏ ॥",
      "transliteration": "namasata(n) akaae ||",
      "translation": "Salutation to Thee O Bodyless Lord!",
      "punjabiViakhya": "ਹੇ ਕਾਇਆ-ਰਹਿਤ! ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "नमसतं अकाए ॥",
      "sourceLineId": "74229",
      "sourceShabadId": "7403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਮਸਤੰ ਅਜਾਏ ॥੩॥",
      "transliteration": "namasata(n) ajaae ||3||",
      "translation": "Salutation to Thee O Unborn Lord!3.",
      "punjabiViakhya": "ਹੇ ਅਜਨਮੇ! ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "नमसतं अजाए ॥३॥",
      "sourceLineId": "74230",
      "sourceShabadId": "7403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਮਸਤੰ ਅਗੰਜੇ ॥",
      "transliteration": "namasata(n) aga(n)je ||",
      "translation": "Salutation to Thee O Indestructible Lord!",
      "punjabiViakhya": "ਹੇ ਨਸ਼ਟ ਨਾ ਹੋ ਸਕਣ ਵਾਲੇ! ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "नमसतं अगंजे ॥",
      "sourceLineId": "74231",
      "sourceShabadId": "7403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਮਸਤੰ ਅਭੰਜੇ ॥",
      "transliteration": "namasata(n) abha(n)je ||",
      "translation": "Salutation to Thee O Indivisible Lord!",
      "punjabiViakhya": "ਹੇ ਨਾ ਭੰਨੇ ਜਾ ਸਕਣ ਵਾਲੇ! ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "नमसतं अभंजे ॥",
      "sourceLineId": "74232",
      "sourceShabadId": "7403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਮਸਤੰ ਅਨਾਮੇ ॥",
      "transliteration": "namasata(n) anaame ||",
      "translation": "Salutation to Thee O Nameless Lord!",
      "punjabiViakhya": "ਹੇ ਨਾਮ-ਰਹਿਤ! ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "नमसतं अनामे ॥",
      "sourceLineId": "74233",
      "sourceShabadId": "7403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਮਸਤੰ ਅਠਾਮੇ ॥੪॥",
      "transliteration": "namasata(n) aThaame ||4||",
      "translation": "Salutation to Thee O Non-Spatial Lord! 4",
      "punjabiViakhya": "ਹੇ ਸਥਾਨ-ਰਹਿਤ! ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1,
      "hindi": "",
      "hindiTransliteration": "नमसतं अठामे ॥४॥",
      "sourceLineId": "74234",
      "sourceShabadId": "7403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0001_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਮਸਤੰ ਅਕਰਮੰ ॥",
      "transliteration": "namasata(n) akarama(n) ||",
      "translation": "Salutation to Thee O Deedless Lord!",
