    {
      "id": "dasam_ang_0002_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਮਸਤੰ ਅਲੋਕੇ ॥",
      "transliteration": "namasata(n) aloke ||",
      "translation": "Salutation to Thee O Invinciblle Lord!",
      "punjabiViakhya": "ਹੇ ਨਾ ਵੇਖੇ ਜਾ ਸਕਣ ਵਾਲੇ! ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 2,
      "hindi": "",
      "hindiTransliteration": "नमसतं अलोके ॥",
      "sourceLineId": "74265",
      "sourceShabadId": "7403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
