      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "समसतं प्रसिज्जे ॥७२॥",
      "sourceLineId": "74495",
      "sourceShabadId": "7407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0052",
      "lineIndex": 52,
