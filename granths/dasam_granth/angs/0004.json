      "sourceShabadId": "7407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਮੋ ਸਰਬ ਦ੍ਰਿੱਸੰ ॥",
      "transliteration": "namo sarab dhira'sa(n) ||",
      "translation": "Salutation to Thee O All-Beholder Lord!",
      "punjabiViakhya": "ਹੇ ਸਭ ਨੂੰ ਵੇਖਣ ਵਾਲੇ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ;",
