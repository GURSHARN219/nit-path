      "punjabiViakhya": "ਅਤੇ ਸਭ ਦੁਆਰਾ ਮੰਨੇ ਜਾਣ ਵਾਲਾ (ਪੂਜਣਯੋਗ) ਹੈਂ ॥੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "सरबं माने ॥७६॥",
      "sourceLineId": "74511",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਸਰਬੰ ਪ੍ਰਾਣੰ ॥",
      "transliteration": "saraba(n) praana(n) ||",
      "translation": "Thou art the Life of all,",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ! ਤੂੰ) ਸਭ ਦਾ ਪ੍ਰਾਣ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "सरबं प्राणं ॥",
      "sourceLineId": "74512",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਸਰਬੰ ਤ੍ਰਾਣੰ ॥",
      "transliteration": "saraba(n) traana(n) ||",
      "translation": "Thou art the Strength of all.",
      "punjabiViakhya": "ਸਭ ਦਾ ਤ੍ਰਾਣ (ਬਲ) ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "सरबं त्राणं ॥",
      "sourceLineId": "74513",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਸਰਬੰ ਭੁਗਤਾ ॥",
      "transliteration": "saraba(n) bhugataa ||",
      "translation": "Thou art the Enjoyer of all,",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਭੋਗਣ ਵਾਲਾ ਹੈਂ",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "सरबं भुगता ॥",
      "sourceLineId": "74514",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਸਰਬੰ ਜੁਗਤਾ ॥੭੭॥",
      "transliteration": "saraba(n) jugataa ||77||",
      "translation": "Thou art United with all.77.",
      "punjabiViakhya": "ਅਤੇ ਸਭ ਨਾਲ ਜੁੜਿਆ ਹੋਇਆ ਹੈਂ ॥੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "सरबं जुगता ॥७७॥",
      "sourceLineId": "74515",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਸਰਬੰ ਦੇਵੰ ॥",
      "transliteration": "saraba(n) dheva(n) ||",
      "translation": "Thou art worshipped by all,",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ! ਤੂੰ) ਸਭ ਦਾ ਦੇਵ (ਇਸ਼ਟ) ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "सरबं देवं ॥",
      "sourceLineId": "74516",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0073",
      "lineIndex": 73,
      "gurmukhi": "ਸਰਬੰ ਭੇਵੰ ॥",
      "transliteration": "saraba(n) bheva(n) ||",
      "translation": "Thou art a mystery for all.",
      "punjabiViakhya": "ਸਭ ਦੇ ਭੇਦ ਨੂੰ ਜਾਣਨ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "सरबं भेवं ॥",
      "sourceLineId": "74517",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0074",
      "lineIndex": 74,
      "gurmukhi": "ਸਰਬੰ ਕਾਲੇ ॥",
      "transliteration": "saraba(n) kaale ||",
      "translation": "Thou art the Destroyer of all,",
      "punjabiViakhya": "ਸਭ ਦਾ ਕਾਲ ਹੈਂ",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "सरबं काले ॥",
      "sourceLineId": "74518",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0075",
      "lineIndex": 75,
      "gurmukhi": "ਸਰਬੰ ਪਾਲੇ ॥੭੮॥",
      "transliteration": "saraba(n) paale ||78||",
      "translation": "Thou art the Sustainer of all.78.",
      "punjabiViakhya": "ਅਤੇ ਸਭ ਦਾ ਪਾਲਕ ਹੈਂ ॥੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "सरबं पाले ॥७८॥",
      "sourceLineId": "74519",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0076",
      "lineIndex": 76,
      "gurmukhi": "ਰੂਆਲ ਛੰਦ ॥ ਤ੍ਵ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "rooaal chha(n)dh || tavai prasaadh ||",
      "translation": "ROOALL STANZA. BY THY GRACE",
      "punjabiViakhya": "ਰੂਆਲ ਛੰਦ: ਤੇਰੀ ਕ੍ਰਿਪਾ ਨਾਲ:",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "रूआल छंद ॥ त्व प्रसादि ॥",
      "sourceLineId": "74520",
      "sourceShabadId": "7409",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0077",
      "lineIndex": 77,
      "gurmukhi": "ਆਦਿ ਰੂਪ ਅਨਾਦਿ ਮੂਰਤਿ ਅਜੋਨਿ ਪੁਰਖ ਅਪਾਰ ॥",
      "transliteration": "aadh roop anaadh moorat ajon purakh apaar ||",
      "translation": "Thou art the Supreme Purush, an Eternal Entity in the beginning and free from birth.",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ! ਤੂੰ ਸਭ ਦਾ) ਆਦਿ-ਰੂਪ, ਸਭ ਤੋਂ ਪਹਿਲਾ ਹੋਣ ਵਾਲਾ ਸਰੂਪ, ਅਯੋਨਿਜ ਅਤੇ ਅਪਰ ਅਪਾਰ ਪੁਰਖ ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "आदि रूप अनादि मूरति अजोनि पुरख अपार ॥",
      "sourceLineId": "74521",
      "sourceShabadId": "7409",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0078",
      "lineIndex": 78,
      "gurmukhi": "ਸਰਬ ਮਾਨ ਤ੍ਰਿਮਾਨ ਦੇਵ ਅਭੇਵ ਆਦਿ ਉਦਾਰ ॥",
      "transliteration": "sarab maan tiramaan dhev abhev aadh udhaar ||",
      "translation": "Worshipped by all and venerated by three gods, Thou art without difference and art Generous from the very beginning.",
      "punjabiViakhya": "ਸਭ ਦਾ ਮਾਣ, ਤਿੰਨ ਦੇਵਤਿਆਂ ਦੁਆਰਾ ਮੰਨਣਯੋਗ, ਅਭੇਦ ਅਤੇ ਮੁੱਢ-ਕਦੀਮ ਤੋਂ ਉਦਾਰ ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "सरब मान तृमान देव अभेव आदि उदार ॥",
      "sourceLineId": "74522",
      "sourceShabadId": "7409",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0079",
      "lineIndex": 79,
      "gurmukhi": "ਸਰਬ ਪਾਲਕ ਸਰਬ ਘਾਲਕ ਸਰਬ ਕੋ ਪੁਨਿ ਕਾਲ ॥",
      "transliteration": "sarab paalak sarab ghaalak sarab ko pun kaal ||",
      "translation": "Thou art the Creator Sustainer, Inspirer and Destroyer of all.",
      "punjabiViakhya": "ਸਭ ਦਾ ਪਾਲਕ, ਸਭ ਦਾ ਨਾਸ਼ਕ ਅਤੇ ਫਿਰ ਸਭ ਦਾ ਕਾਲ-ਰੂਪ ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "सरब पालक सरब घालक सरब को पुनि काल ॥",
      "sourceLineId": "74523",
      "sourceShabadId": "7409",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0080",
      "lineIndex": 80,
      "gurmukhi": "ਜੱਤ੍ਰ ਤੱਤ੍ਰ ਬਿਰਾਜਹੀ ਅਵਧੂਤ ਰੂਪ ਰਿਸਾਲ ॥੭੯॥",
      "transliteration": "ja'tr ta'tr biraajahee avadhoot roop risaal ||79||",
      "translation": "Thou art present everywhere like an ascetic with a Generous disposition.79.",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਨਿਰਲਿਪਤ ('ਅਵਧੂਤ ਰੂਪ') ਹੋਣ ਤੇ ਵੀ ਪਸੀਜਣ ਵਾਲਾ ਹੋ ਕੇ ਬਿਰਾਜ ਰਿਹਾ ਹੈਂ ॥੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "जत्त्र तत्त्र बिराजही अवधूत रूप रिसाल ॥७९॥",
      "sourceLineId": "74524",
      "sourceShabadId": "7409",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0081",
      "lineIndex": 81,
      "gurmukhi": "ਨਾਮ ਠਾਮ ਨ ਜਾਤਿ ਜਾਕਰ ਰੂਪ ਰੰਗ ਨ ਰੇਖ ॥",
      "transliteration": "naam Thaam na jaat jaakar roop ra(n)g na rekh ||",
      "translation": "Thou art Nameless, Placeless, Casteless, Formless, Colourless and Lineless.",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਨਾਮ, ਧਾਮ, ਜਾਤਿ, ਰੂਪ, ਰੰਗ ਅਤੇ ਰੇਖ ਨਹੀਂ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "नाम ठाम न जाति जाकर रूप रंग न रेख ॥",
      "sourceLineId": "74525",
      "sourceShabadId": "7409",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0082",
      "lineIndex": 82,
      "gurmukhi": "ਆਦਿ ਪੁਰਖ ਉਦਾਰ ਮੂਰਤਿ ਅਜੋਨਿ ਆਦਿ ਅਸੇਖ ॥",
      "transliteration": "aadh purakh udhaar moorat ajon aadh asekh ||",
      "translation": "Thou, the Primal Purusha, art Unborn, Generous Entity and Perfect from the very beginning.",
      "punjabiViakhya": "ਜੋ ਆਦਿ ਪੁਰਖ, ਉਦਾਰ ਸਰੂਪ ਵਾਲਾ, ਅਜੋਨੀ ਅਤੇ ਮੁੱਢ ਤੋਂ ਹੀ ਅਸ਼ੇਸ਼-ਰੂਪ (ਪਰਿਪੂਰਣ) ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "आदि पुरख उदार मूरति अजोनि आदि असेख ॥",
      "sourceLineId": "74526",
      "sourceShabadId": "7409",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    }
  ]
}
