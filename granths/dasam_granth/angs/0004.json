      "sourceShabadId": "7407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਮੋ ਸਰਬ ਕ੍ਰਿੱਸੰ ॥",
      "transliteration": "namo sarab kira'sa(n) ||",
      "translation": "Salutation to Thee O Universal attraction Lord!",
      "punjabiViakhya": "ਹੇ ਸਭ ਨੂੰ ਆਕਰਸ਼ਿਤ ਕਰਨ ਵਾਲੇ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ;",
