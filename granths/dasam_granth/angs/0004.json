      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "नमो सरब भोगे ॥",
      "sourceLineId": "74481",
      "sourceShabadId": "7407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਮੋ ਸਰਬ ਜੀਤੰ ॥",
      "transliteration": "namo sarab jeeta(n) ||",
      "translation": "Salutation to Thee O Universal Ailment Lord!",
      "punjabiViakhya": "ਹੇ ਸਭ ਦੇ ਵਿਜੇਤਾ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ;",
