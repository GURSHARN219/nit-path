      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "कृपालं सरूपे ॥",
      "sourceLineId": "74496",
      "sourceShabadId": "7407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕੁਕਰਮੰ ਪ੍ਰਣਾਸੀ ॥",
      "transliteration": "kukarama(n) pranaasee ||",
      "translation": "Salutation to Thee O Sins-Destroyer Lord!",
      "punjabiViakhya": "ਮਾੜੇ ਕਰਮਾ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲੇ",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "कुकरमं प्रणासी ॥",
      "sourceLineId": "74497",
      "sourceShabadId": "7407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਦਾ ਸਰਬਦਾ ਰਿਧਿ ਸਿਧੰ ਨਿਵਾਸੀ ॥੭੩॥",
      "transliteration": "sadhaa sarabadhaa ridh sidha(n) nivaasee ||73||",
      "translation": "Salutation to Thee O Ever-Universal Riches Denizen Lord!  Salutation to Thee O Ever-Universal Powers Denizen Lord! 73",
      "punjabiViakhya": "ਅਤੇ ਸਦਾ ਸਭ ਥਾ ਰਿੱਧੀਆਂ ਸਿੱਧੀਆਂ ਦੇ ਮੂਲ ਸਥਾਨ! (ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ) ॥੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "सदा सरबदा रिधि सिधं निवासी ॥७३॥",
      "sourceLineId": "74498",
      "sourceShabadId": "7407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਚਰਪਟ ਛੰਦ ॥ ਤ੍ਵ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "charapaT chha(n)dh || tavai prasaadh ||",
      "translation": "CHARPAT STANZA. BY THY GRACE",
      "punjabiViakhya": "ਚਰਪਟ ਛੰਦ: ਤੇਰੀ ਕ੍ਰਿਪਾ ਨਾਲ:",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "चरपट छंद ॥ त्व प्रसादि ॥",
      "sourceLineId": "74499",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਅੰਮ੍ਰਿੱਤ ਕਰਮੇ ॥",
      "transliteration": "a(n)mira't karame ||",
      "translation": "Thy actions are Permanent,",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ! ਤੂੰ) ਅਮਰ ਕਰਮ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "अंमृत्त करमे ॥",
      "sourceLineId": "74500",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਅੰਬ੍ਰਿਤ ਧਰਮੇ ॥",
      "transliteration": "a(n)birat dharame ||",
      "translation": "Thy Laws are Permanent.",
      "punjabiViakhya": "ਅਖੰਡ ('ਅੰਬ੍ਰਿਤ') ਧਰਮ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "अंबृत धरमे ॥",
      "sourceLineId": "74501",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਅਖੱਲ ਜੋਗੇ ॥",
      "transliteration": "akha'l joge ||",
      "translation": "Thou art united with all,",
      "punjabiViakhya": "ਸਭ ਨਾਲ ਯੁਕਤ (ਜੁੜਿਆ ਹੋਇਆ)",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "अखल्ल जोगे ॥",
      "sourceLineId": "74502",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਅਚੱਲ ਭੋਗੇ ॥੭੪॥",
      "transliteration": "acha'l bhoge ||74||",
      "translation": "Thou art their permanent Enjoyer.74.",
      "punjabiViakhya": "ਅਤੇ ਅਚਲ ਭੋਗ ਸਾਮਗ੍ਰੀ ਵਾਲਾ ਹੈਂ ॥੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "अचल्ल भोगे ॥७४॥",
      "sourceLineId": "74503",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਅਚੱਲ ਰਾਜੇ ॥",
      "transliteration": "acha'l raaje ||",
      "translation": "Thy Kingdom is Permanent,",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ! ਤੂੰ) ਅਚਲ ਰਾਜ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "अचल्ल राजे ॥",
      "sourceLineId": "74504",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਅਟੱਲ ਸਾਜੇ ॥",
      "transliteration": "aTa'l saaje ||",
      "translation": "Thy Adornment is Permanent.",
      "punjabiViakhya": "ਅਟਲ ਸਾਜ (ਸਿਰਜਨਾ) ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "अटल्ल साजे ॥",
      "sourceLineId": "74505",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਅਖੱਲ ਧਰਮੰ ॥",
      "transliteration": "akha'l dharama(n) ||",
      "translation": "Thy Laws are Complete,",
      "punjabiViakhya": "ਸਾਰੇ ਧਰਮਾ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "अखल्ल धरमं ॥",
      "sourceLineId": "74506",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਅਲੱਖ ਕਰਮੰ ॥੭੫॥",
      "transliteration": "ala'kh karama(n) ||75||",
      "translation": "Thy Words are beyond Comprehension.75.",
      "punjabiViakhya": "ਅਤੇ ਅਦ੍ਰਿਸ਼ ਕਰਮਾ ਵਾਲਾ ਹੈਂ ॥੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "अलक्ख करमं ॥७५॥",
      "sourceLineId": "74507",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਸਰਬੰ ਦਾਤਾ ॥",
      "transliteration": "saraba(n) dhaataa ||",
      "translation": "Thou art the universal Donor,",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ! ਤੂੰ) ਸਭ ਨੂੰ ਦੇਣ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "सरबं दाता ॥",
      "sourceLineId": "74508",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਸਰਬੰ ਗਿਆਤਾ ॥",
      "transliteration": "saraba(n) giaataa ||",
      "translation": "Thou art Omniscient.",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਜਾਣਨ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "सरबं गिआता ॥",
      "sourceLineId": "74509",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਸਰਬੰ ਭਾਨੇ ॥",
      "transliteration": "saraba(n) bhaane ||",
      "translation": "Thou art the Enlightener of all,",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਪ੍ਰਕਾਸ਼ਮਾਨ ('ਭਾਨੇ') ਕਰਨ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "सरबं भाने ॥",
      "sourceLineId": "74510",
      "sourceShabadId": "7408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਸਰਬੰ ਮਾਨੇ ॥੭੬॥",
