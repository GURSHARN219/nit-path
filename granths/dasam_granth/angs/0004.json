{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 4,
  "lineCount": 82,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0004_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪਰੰ ਪਰਮ ਪਰਮੇਸ੍ਵਰੰ ਪ੍ਰੋਛ ਪਾਲੰ ॥",
      "transliteration": "para(n) param paramesavaira(n) prochh paala(n) ||",
      "translation": "Thou art the Supreme Master and Sustain all without being seen,",
      "punjabiViakhya": "ਹੇ ਪਰਮ ਸ੍ਰੇਸ਼ਠ ਪਰਮੇਸ਼ਵਰ! (ਤੂੰ ਸਭ ਦੀ) ਪਰੋਖ (ਅਦ੍ਰਿਸ਼) ਰੂਪ ਵਿਚ ਪਾਲਣਾ ਕਰਨ ਵਾਲਾ ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "परं परम परमेस्वरं प्रोछ पालं ॥",
      "sourceLineId": "74445",
      "sourceShabadId": "7405",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਦਾ ਸਰਬਦਾ ਸਿੱਧ ਦਾਤਾ ਦਿਆਲੰ ॥੬੦॥",
      "transliteration": "sadhaa sarabadhaa si'dh dhaataa dhiaala(n) ||60||",
      "translation": "Thou art ever the Donor of riches and merciful.60.",
      "punjabiViakhya": "ਹੇ ਦਿਆਲੂ! (ਤੂੰ) ਸਦਾ ਸਾਰਿਆਂ ਸਮਿਆਂ ਵਿਚ ਸਿੱਧੀਆਂ ਪ੍ਰਦਾਨ ਕਰਨ ਵਾਲਾ ਹੈਂ ॥੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "सदा सरबदा सिद्ध दाता दिआलं ॥६०॥",
      "sourceLineId": "74446",
      "sourceShabadId": "7405",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਛੇਦੀ ਅਭੇਦੀ ਅਨਾਮੰ ਅਕਾਮੰ ॥",
      "transliteration": "achhedhee abhedhee anaama(n) akaama(n) ||",
      "translation": "Thou art Invincible, Unbreakable, Nameless and Lustless.",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਨਾ (ਤੂੰ) ਕਟਿਆ ਜਾ ਸਕਦਾ ਹੈਂ, ਨਾ ਤੋੜਿਆ ਜਾ ਸਕਦਾ ਹੈਂ, ਤੂੰ ਨਾਮ ਅਤੇ ਕਾਮਨਾ ਤੋਂ ਰਹਿਤ ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "अछेदी अभेदी अनामं अकामं ॥",
      "sourceLineId": "74447",
      "sourceShabadId": "7405",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਮਸਤੋ ਪਰਾਜੀ ਸਮਸਤਸਤੁ ਧਾਮੰ ॥੬੧॥",
      "transliteration": "samasato paraajee samasatasat dhaama(n) ||61||",
      "translation": "Thou art Victorious over all and art present every-where.61.",
      "punjabiViakhya": "(ਤੂੰ) ਸਾਰੀ ਦੁਨੀਆ ਪੈਦਾ ਕੀਤੀ ਹੈ ਅਤੇ ਸਾਰੀ ਦਾ ਹੀ (ਤੂੰ) ਆਸਰਾ ਹੈਂ ॥੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "समसतो पराजी समसतसतु धामं ॥६१॥",
      "sourceLineId": "74448",
      "sourceShabadId": "7405",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤੇਰਾ ਜੋਰੁ ॥",
      "transliteration": "teraa jor ||",
      "translation": "ALL THY MIGHT.",
      "punjabiViakhya": "ਤੇਰਾ ਬਲ:",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "तेरा जोरु ॥",
      "sourceLineId": "74449",
      "sourceShabadId": "7406",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚਾਚਰੀ ਛੰਦ ॥",
      "transliteration": "chaacharee chha(n)dh ||",
      "translation": "CHACHARI STANZA",
      "punjabiViakhya": "ਚਾਚਰੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "चाचरी छंद ॥",
      "sourceLineId": "74450",
      "sourceShabadId": "7406",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਲੇ ਹੈਂ ॥",
      "transliteration": "jale hai(n) ||",
      "translation": "Thou art in water.",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ! ਤੂੰ) ਜਲ ਵਿਚ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "जले हैं ॥",
      "sourceLineId": "74451",
      "sourceShabadId": "7406",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਥਲੇ ਹੈਂ ॥",
      "transliteration": "thale hai(n) ||",
      "translation": "Thou art on land.",
      "punjabiViakhya": "ਥਲ ਵਿਚ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "थले हैं ॥",
      "sourceLineId": "74452",
      "sourceShabadId": "7406",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਭੀਤ ਹੈਂ ॥",
      "transliteration": "abheet hai(n) ||",
      "translation": "Thou art Fearless.",
      "punjabiViakhya": "ਅਭੈ ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "अभीत हैं ॥",
      "sourceLineId": "74453",
      "sourceShabadId": "7406",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਭੇ ਹੈਂ ॥੬੨॥",
      "transliteration": "abhe hai(n) ||62||",
      "translation": "Thou art Indiscriminate.62.",
      "punjabiViakhya": "(ਤੇਰੇ) ਭੇਦ ਨੂੰ ਨਹੀਂ ਪਾਇਆ ਜਾ ਸਕਦਾ ॥੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "अभे हैं ॥६२॥",
      "sourceLineId": "74454",
      "sourceShabadId": "7406",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪ੍ਰਭੂ ਹੈਂ ॥",
      "transliteration": "prabhoo hai(n) ||",
      "translation": "Thou art the Master of all.",
      "punjabiViakhya": "(ਤੂੰ ਸਭ ਦਾ) ਸੁਆਮੀ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "प्रभू हैं ॥",
      "sourceLineId": "74455",
      "sourceShabadId": "7406",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਜੂ ਹੈਂ ॥",
      "transliteration": "ajoo hai(n) ||",
      "translation": "Thou art Unborn.",
      "punjabiViakhya": "ਜਨਮ ਤੋਂ ਬਿਨਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "अजू हैं ॥",
      "sourceLineId": "74456",
      "sourceShabadId": "7406",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਦੇਸ ਹੈਂ ॥",
      "transliteration": "adhes hai(n) ||",
      "translation": "Thou art Countryless.",
      "punjabiViakhya": "ਦੇਸ ਤੋਂ ਬਿਨਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "अदेस हैं ॥",
      "sourceLineId": "74457",
      "sourceShabadId": "7406",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਭੇਸ ਹੈਂ ॥੬੩॥",
      "transliteration": "abhes hai(n) ||63||",
      "translation": "Thou art Garbless.63.",
      "punjabiViakhya": "ਭੇਸ ਤੋਂ ਬਿਨਾ ਹੈਂ ॥੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "अभेस हैं ॥६३॥",
      "sourceLineId": "74458",
      "sourceShabadId": "7406",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA,",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "74459",
      "sourceShabadId": "7407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਗਾਧੇ ਅਬਾਧੇ ॥",
      "transliteration": "agaadhe abaadhe ||",
      "translation": "Salutation to Thee O Impenetrable Lord!  Salutation to Thee O Unbound Lord!",
      "punjabiViakhya": "ਹੇ ਅਗਾਧ (ਅਥਾਹ) ਹੇ ਅਬਾਧ (ਅਸੀਮ)!",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "अगाधे अबाधे ॥",
      "sourceLineId": "74460",
      "sourceShabadId": "7407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਨੰਦੀ ਸਰੂਪੇ ॥",
      "transliteration": "ana(n)dhee saroope ||",
      "translation": "Salutation to Thee O All-Bliss Entity Lord!",
      "punjabiViakhya": "ਹੇ ਆਨੰਦ-ਸਰੂਪ!",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "अनंदी सरूपे ॥",
      "sourceLineId": "74461",
      "sourceShabadId": "7407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਮੋ ਸਰਬ ਮਾਨੇ ॥",
      "transliteration": "namo sarab maane ||",
      "translation": "Salutation to Thee O Universally-Honoured Lord!",
      "punjabiViakhya": "ਹੇ ਸਾਰਿਆਂ ਦੁਆਰਾ ਮੰਨੇ ਜਾਣ ਵਾਲੇ",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "नमो सरब माने ॥",
      "sourceLineId": "74462",
      "sourceShabadId": "7407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਮਸਤੀ ਨਿਧਾਨੇ ॥੬੪॥",
      "transliteration": "samasatee nidhaane ||64||",
      "translation": "Salutation to Thee O All-Treasure Lord! 64",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ (ਗੁਣਾ ਅਥਵਾ ਪਦਾਰਥਾ) ਦੇ ਖ਼ਜ਼ਾਨੇ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ ॥੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "समसती निधाने ॥६४॥",
      "sourceLineId": "74463",
      "sourceShabadId": "7407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਮਸਤ੍ਵੰ ਨ੍ਰਿਨਾਥੇ ॥",
      "transliteration": "namasatavai(n) niranaathe ||",
      "translation": "Salutation to Thee O Masterless Lord!",
      "punjabiViakhya": "ਹੇ ਸੁਆਮੀ-ਰਹਿਤ! ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "नमसत्वं नृनाथे ॥",
      "sourceLineId": "74464",
      "sourceShabadId": "7407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਮਸਤ੍ਵੰ ਪ੍ਰਮਾਥੇ ॥",
      "transliteration": "namasatavai(n) pramaathe ||",
      "translation": "Salutation to Thee O Destroyer Lord!",
      "punjabiViakhya": "ਹੇ (ਸਾਰਿਆਂ ਦੇ) ਸੰਘਾਰਕ! ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "नमसत्वं प्रमाथे ॥",
      "sourceLineId": "74465",
      "sourceShabadId": "7407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਮਸਤ੍ਵੰ ਅਗੰਜੇ ॥",
      "transliteration": "namasatavai(n) aga(n)je ||",
      "translation": "Salutation to Thee O Unconquerable Lord!",
      "punjabiViakhya": "ਹੇ ਨਾ ਨਸ਼ਟ ਕੀਤੇ ਜਾ ਸਕਣ ਵਾਲੇ! ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "नमसत्वं अगंजे ॥",
      "sourceLineId": "74466",
      "sourceShabadId": "7407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਮਸਤ੍ਵੰ ਅਭੰਜੇ ॥੬੫॥",
      "transliteration": "namasatavai(n) abha(n)je ||65||",
      "translation": "Salutation to Thee O Invincible Lord! 65",
      "punjabiViakhya": "ਹੇ ਨਾ ਭੰਨੇ ਜਾ ਸਕਣ ਵਾਲੇ! ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ ॥੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "नमसत्वं अभंजे ॥६५॥",
      "sourceLineId": "74467",
      "sourceShabadId": "7407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਮਸਤ੍ਵੰ ਅਕਾਲੇ ॥",
      "transliteration": "namasatavai(n) akaale ||",
      "translation": "Salutation to Thee O Deathless Lord!",
      "punjabiViakhya": "ਹੇ ਕਾਲ-ਰਹਿਤ! ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "नमसत्वं अकाले ॥",
      "sourceLineId": "74468",
      "sourceShabadId": "7407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਮਸਤ੍ਵੰ ਅਪਾਲੇ ॥",
      "transliteration": "namasatavai(n) apaale ||",
      "translation": "Salutation to Thee O Patronless Lord!",
      "punjabiViakhya": "ਹੇ ਪਾਲਕ-ਰਹਿਤ! ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "नमसत्वं अपाले ॥",
      "sourceLineId": "74469",
      "sourceShabadId": "7407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਮੋ ਸਰਬ ਦੇਸੇ ॥",
      "transliteration": "namo sarab dhese ||",
      "translation": "Salutation to Thee O All-Pervasive Lord!",
      "punjabiViakhya": "ਹੇ ਸਾਰੇ ਦੇਸ਼ਾ ਵਾਲੇ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": "नमो सरब देसे ॥",
      "sourceLineId": "74470",
      "sourceShabadId": "7407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0004_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਮੋ ਸਰਬ ਭੇਸੇ ॥੬੬॥",
      "transliteration": "namo sarab bhese ||66||",
      "translation": "Salutation to Thee O All-garb Lord! 66",
      "punjabiViakhya": "ਹੇ ਸਾਰੇ ਭੇਸਾ ਵਾਲੇ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ ॥੬੬॥",
