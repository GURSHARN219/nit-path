      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਕਿ ਸਰਬੰ ਦਲੀ ਹੈਂ ॥੧੧੦॥",
