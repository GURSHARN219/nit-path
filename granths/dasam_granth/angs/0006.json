      "lineIndex": 29,
      "gurmukhi": "ਨ ਕਾਏ ॥",
      "transliteration": "n kaae ||",
      "translation": "Thou art the Bodyless Lord",
      "punjabiViakhya": "ਨਾ ਸ਼ਰੀਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "न काए ॥",
      "sourceLineId": "74610",
      "sourceShabadId": "7413",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਜਨਮੰ ॥",
      "transliteration": "ajanama(n) ||",
      "translation": "Thu art the Birthless Lord",
      "punjabiViakhya": "(ਤੂੰ) ਨਾ ਜਨਮ ਲੈਂਦਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "अजनमं ॥",
      "sourceLineId": "74611",
      "sourceShabadId": "7413",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਜਾਏ ॥੧੦੦॥",
      "transliteration": "ajaae ||100||",
      "translation": "Thou art the Aboleless Lord.100.",
      "punjabiViakhya": "(ਤੇਰਾ) ਨਾ ਕੋਈ ਸਥਾਨ ਹੈ ॥੧੦੦॥",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "अजाए ॥१००॥",
      "sourceLineId": "74612",
      "sourceShabadId": "7413",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨ ਚਿੱਤ੍ਰੈ ॥",
      "transliteration": "n chi'trai ||",
      "translation": "Thou art the Portrait-less Lord",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ! ਤੇਰਾ) ਨਾ ਕੋਈ ਚਿਤਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "न चित्त्रै ॥",
      "sourceLineId": "74613",
      "sourceShabadId": "7413",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨ ਮਿੱਤ੍ਰੈ ॥",
      "transliteration": "n mi'trai ||",
      "translation": "Thou art the Friendliness Lord",
      "punjabiViakhya": "ਨਾ ਕੋਈ ਮਿਤਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "न मित्त्रै ॥",
      "sourceLineId": "74614",
      "sourceShabadId": "7413",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪਰੇ ਹੈਂ ॥",
      "transliteration": "pare hai(n) ||",
      "translation": "Thou art the Attachment-free Lord",
      "punjabiViakhya": "ਤੂੰ ਸਭ ਤੋਂ ਪਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "परे हैं ॥",
      "sourceLineId": "74615",
      "sourceShabadId": "7413",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪਵਿੱਤ੍ਰੈ ॥੧੦੧॥",
      "transliteration": "pavi'trai ||101||",
      "translation": "Thou art the Most Pure Lord.101.",
      "punjabiViakhya": "ਅਤੇ ਸ਼ੁੱਧ-ਸਰੂਪ ਹੈਂ ॥੧੦੧॥",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "पवित्त्रै ॥१०१॥",
      "sourceLineId": "74616",
      "sourceShabadId": "7413",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪ੍ਰਿਥੀਸੈ ॥",
      "transliteration": "piratheesai ||",
      "translation": "Thou art the World-Master Lord",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ! ਤੂੰ) ਪ੍ਰਿਥਵੀ ਦਾ ਸੁਆਮੀ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "पृथीसै ॥",
      "sourceLineId": "74617",
      "sourceShabadId": "7413",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਦੀਸੈ ॥",
      "transliteration": "adheesai ||",
      "translation": "Thou art the Primal Lord",
      "punjabiViakhya": "ਅਣਦਿਸ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "अदीसै ॥",
      "sourceLineId": "74618",
      "sourceShabadId": "7413",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਦ੍ਰਿਸੈ ॥",
      "transliteration": "adhirasai ||",
      "translation": "Thou art the Invincible Lord",
      "punjabiViakhya": "ਦ੍ਰਿਸ਼ਟਮਾਨ ਨਹੀਂ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "अदृसै ॥",
      "sourceLineId": "74619",
      "sourceShabadId": "7413",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਕ੍ਰਿਸੈ ॥੧੦੨॥",
      "transliteration": "akirasai ||102||",
      "translation": "Thou art the Almighty Lord.102.",
      "punjabiViakhya": "ਬਲ-ਹੀਨ ਨਹੀਂ ਹੈਂ ॥੧੦੨॥",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "अकृसै ॥१०२॥",
      "sourceLineId": "74620",
      "sourceShabadId": "7413",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭਗਵਤੀ ਛੰਦ ॥ ਤ੍ਵ ਪ੍ਰਸਾਦਿ ਕਥਤੇ ॥",
      "transliteration": "bhagavatee chha(n)dh || tavai prasaadh kathate ||",
      "translation": "BHAGVATI STANZA. UTTERED WITH THY GRACE",
      "punjabiViakhya": "ਭਗਵਤੀ ਛੰਦ: ਤੇਰੀ ਕ੍ਰਿਪਾ ਨਾਲ ਕਹਿੰਦਾ ਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "भगवती छंद ॥ त्व प्रसादि कथते ॥",
      "sourceLineId": "74621",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਿ ਆਛਿੱਜ ਦੇਸੈ ॥",
      "transliteration": "k aachhi'j dhesai ||",
      "translation": "That thy Abode is unconquerable!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੇਰਾ ਦੇਸ (ਸਥਾਨ) ਨਾਸ਼-ਰਹਿਤ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि आछिज्ज देसै ॥",
      "sourceLineId": "74622",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਿ ਆਭਿੱਜ ਭੇਸੈ ॥",
      "transliteration": "k aabhi'j bhesai ||",
      "translation": "That Thy Garb is unimpaired.",
      "punjabiViakhya": "ਤੇਰਾ ਸਰੂਪ (ਭੇਸ) ਸਦੀਵੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि आभिज्ज भेसै ॥",
      "sourceLineId": "74623",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਿ ਆਗੰਜ ਕਰਮੈ ॥",
      "transliteration": "k aaga(n)j karamai ||",
      "translation": "That Thou art beyond impact of Karmas!",
      "punjabiViakhya": "ਤੇਰਾ ਕਰਮ ਨਸ਼ਟ ਨਹੀਂ ਹੁੰਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि आगंज करमै ॥",
      "sourceLineId": "74624",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਿ ਆਭੰਜ ਭਰਮੈ ॥੧੦੩॥",
      "transliteration": "k aabha(n)j bharamai ||103||",
      "translation": "That Thou art free from doubts.103.",
      "punjabiViakhya": "ਤੂੰ ਭਰਮਾ ਨੂੰ ਤੋੜਨ ਵਾਲਾ ਹੈਂ ॥੧੦੩॥",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि आभंज भरमै ॥१०३॥",
      "sourceLineId": "74625",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਿ ਆਭਿਜ ਲੋਕੈ ॥",
      "transliteration": "k aabhij lokai ||",
      "translation": "That Thy abode is unimpaired!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਤਿੰਨਾ ਲੋਕਾ ਤੋਂ ਨਿਰਲੇਪ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि आभिज लोकै ॥",
      "sourceLineId": "74626",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਿ ਆਦਿਤ ਸੋਕੈ ॥",
      "transliteration": "k aadhit sokai ||",
      "translation": "That thy canst dry up the sun.",
      "punjabiViakhya": "ਤੂੰ ਸੂਰਜ ('ਆਦਿਤ') ਦੇ ਤੇਜ ਨੂੰ ਖ਼ਤਮ ਕਰ ਸਕਦਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि आदित सोकै ॥",
      "sourceLineId": "74627",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਿ ਅਵਧੂਤ ਬਰਨੈ ॥",
      "transliteration": "k avadhoot baranai ||",
      "translation": "That Thy demeanour is saintly!",
      "punjabiViakhya": "ਤੂੰ ਪਵਿਤਰ (ਮਾਇਆ ਤੋਂ ਅਪ੍ਰਭਾਵਿਤ) ਰੰਗ (ਸਰੂਪ) ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि अवधूत बरनै ॥",
      "sourceLineId": "74628",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਿ ਬਿਭੂਤ ਕਰਨੈ ॥੧੦੪॥",
      "transliteration": "k bibhoot karanai ||104||",
      "translation": "That thou art the Source of wealth.104.",
      "punjabiViakhya": "ਤੂੰ ਐਸ਼ਵਰਜ (ਵਿਭੂਤੀਆਂ) ਦਾ ਕਰਤਾ ਹੈਂ ॥੧੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि बिभूत करनै ॥१०४॥",
      "sourceLineId": "74629",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਿ ਰਾਜੰ ਪ੍ਰਭਾ ਹੈਂ ॥",
      "transliteration": "k raaja(n) prabhaa hai(n) ||",
      "translation": "That Thou art the glory of kingdom!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਰਾਜਿਆਂ ਦਾ ਤੇਜ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि राजं प्रभा हैं ॥",
      "sourceLineId": "74630",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਿ ਧਰਮੰ ਧੁਜਾ ਹੈਂ ॥",
      "transliteration": "k dharama(n) dhujaa hai(n) ||",
      "translation": "That Thou art eh ensign of righteousness.",
      "punjabiViakhya": "ਤੂੰ ਧਰਮਾ ਦਾ ਨਿਸ਼ਾਨ (ਝੰਡਾ) ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि धरमं धुजा हैं ॥",
      "sourceLineId": "74631",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਿ ਆਸੋਕ ਬਰਨੈ ॥",
      "transliteration": "k aasok baranai ||",
      "translation": "That Thou hast no worries!",
      "punjabiViakhya": "ਤੂੰ ਸ਼ੋਕ-ਰਹਿਤ ਸਰੂਪ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि आसोक बरनै ॥",
      "sourceLineId": "74632",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਿ ਸਰਬਾ ਅਭਰਨੈ ॥੧੦੫॥",
      "transliteration": "k sarabaa abharanai ||105||",
      "translation": "That Thou art the ornamentation of all.105.",
      "punjabiViakhya": "ਤੂੰ ਸਾਰਿਆਂ ਦਾ ਸ਼ਿੰਗਾਰ ਹੈਂ ॥੧੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि सरबा अभरनै ॥१०५॥",
      "sourceLineId": "74633",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਿ ਜਗਤੰ ਕ੍ਰਿਤੀ ਹੈਂ ॥",
      "transliteration": "k jagata(n) kiratee hai(n) ||",
      "translation": "That Thou art the Creator of the universe!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਜਗਤ ਦਾ ਕਰਤਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि जगतं कृती हैं ॥",
      "sourceLineId": "74634",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਿ ਛਤ੍ਰੰ ਛਤ੍ਰੀ ਹੈਂ ॥",
      "transliteration": "k chhatra(n) chhatree hai(n) ||",
      "translation": "That Thou art the Bravest of the Brave.",
      "punjabiViakhya": "ਤੂੰ ਛਤ੍ਰੀਆਂ (ਵੀਰਾ) ਦਾ ਵੀ ਛਤ੍ਰੀ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि छत्रं छत्री हैं ॥",
      "sourceLineId": "74635",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕਿ ਬ੍ਰਹਮੰ ਸਰੂਪੈ ॥",
      "transliteration": "k brahama(n) saroopai ||",
      "translation": "That Thou art All-Pervading Entity!",
      "punjabiViakhya": "ਤੂੰ ਬ੍ਰਹਮ-ਸਰੂਪੀ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि ब्रहमं सरूपै ॥",
      "sourceLineId": "74636",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕਿ ਅਨਭਉ ਅਨੂਪੈ ॥੧੦੬॥",
      "transliteration": "k anabhau anoopai ||106||",
      "translation": "That Thou art the Source of Divine Knowledge.106.",
      "punjabiViakhya": "ਤੂੰ ਭੈ-ਰਹਿਤ ਅਤੇ ਉਪਮਾ-ਰਹਿਤ ਹੈਂ ॥੧੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि अनभउ अनूपै ॥१०६॥",
      "sourceLineId": "74637",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0057",
      "lineIndex": 57,
