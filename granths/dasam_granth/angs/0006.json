      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि आदि अदेव हैं ॥",
      "sourceLineId": "74638",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਕਿ ਆਪਿ ਅਭੇਵ ਹੈਂ ॥",
      "transliteration": "k aap abhev hai(n) ||",
