      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਰਹੀਮੈ ਰਿਹਾਕੈ ॥",
      "transliteration": "raheemai rihaakai ||",
