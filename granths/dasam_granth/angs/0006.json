      "punjabiViakhya": "ਤੂੰ ਮਿਹਰਾ ਕਰਨ ਵਾਲਾ ਬਖ਼ਸ਼ਣਹਾਰ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि करमं करीम हैं ॥",
      "sourceLineId": "74651",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਕਿ ਸਰਬੰ ਕਲੀ ਹੈਂ ॥",
