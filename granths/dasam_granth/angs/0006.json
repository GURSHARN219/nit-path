      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि सरबं दली हैं ॥११०॥",
      "sourceLineId": "74653",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0073",
      "lineIndex": 73,
      "gurmukhi": "ਕਿ ਸਰਬੱਤ੍ਰ ਮਾਨਿਯੈ ॥",
      "transliteration": "k saraba'tr maaniyai ||",
