      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि अफवुल गुनाह हैं ॥",
      "sourceLineId": "74646",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਕਿ ਸ਼ਾਹਾਨ ਸ਼ਾਹ ਹੈਂ ॥",
      "transliteration": "k shaahaan shaeh hai(n) ||",
