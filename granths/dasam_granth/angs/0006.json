      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्त्र गउनै ॥",
      "sourceLineId": "74656",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0076",
      "lineIndex": 76,
      "gurmukhi": "ਕਿ ਸਰਬੱਤ੍ਰ ਭਉਨੈ ॥੧੧੧॥",
