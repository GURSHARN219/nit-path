      "punjabiViakhya": "ਤੂੰ ਸਭ ਨੂੰ ਦੇਣ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्त्र दानियै ॥",
      "sourceLineId": "74655",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0075",
      "lineIndex": 75,
      "gurmukhi": "ਕਿ ਸਰਬੱਤ੍ਰ ਗਉਨੈ ॥",
