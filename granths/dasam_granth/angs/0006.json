      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्त्र मानियै ॥",
      "sourceLineId": "74654",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0074",
      "lineIndex": 74,
      "gurmukhi": "ਕਿ ਸਰਬੱਤ੍ਰ ਦਾਨਿਯੈ ॥",
      "transliteration": "k saraba'tr dhaaniyai ||",
