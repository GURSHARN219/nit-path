      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "रहीमै रिहाकै ॥",
      "sourceLineId": "74643",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਕਿ ਪਾਕ ਬਿਐਬ ਹੈਂ ॥",
      "transliteration": "k paak biaaib hai(n) ||",
