      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि आपि अभेव हैं ॥",
      "sourceLineId": "74639",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਕਿ ਚਿੱਤ੍ਰੰ ਬਿਹੀਨੈ ॥",
      "transliteration": "k chi'tra(n) biheenai ||",
      "translation": "That Thou art without any portrait!",
      "punjabiViakhya": "ਤੂੰ ਚਿਤਰ (ਸਰੂਪ) ਤੋਂ ਬਿਨਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि चित्त्रं बिहीनै ॥",
      "sourceLineId": "74640",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
