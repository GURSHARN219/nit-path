      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਕਿ ਗੈਬੁਲ ਗ਼ੈਬ ਹੈਂ ॥੧੦੮॥",
