      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਸਭ ਨੂੰ ਦਿੰਦਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्त्र दीनै ॥",
      "sourceLineId": "74662",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0082",
      "lineIndex": 82,
      "gurmukhi": "ਕਿ ਸਰਬੱਤ੍ਰ ਲੀਨੈ ॥",
