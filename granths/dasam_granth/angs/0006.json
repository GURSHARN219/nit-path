      "punjabiViakhya": "ਤੂੰ ਸਭ ਕਾਰਨਾ ਦਾ ਕਰਤਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि कारन कुनिंद हैं ॥",
      "sourceLineId": "74648",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਕਿ ਰੋਜ਼ੀ ਦਿਹੰਦ ਹੈਂ ॥੧੦੯॥",
