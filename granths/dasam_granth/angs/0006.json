      "punjabiViakhya": "ਤੂੰ ਸ਼ਾਹਾ ਦਾ ਸ਼ਾਹ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि शाहान शाह हैं ॥",
      "sourceLineId": "74647",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਕਿ ਕਾਰਨ ਕੁਨਿੰਦ ਹੈਂ ॥",
      "transliteration": "k kaaran kuni(n)dh hai(n) ||",
