      "ang": 6,
      "hindi": "",
      "hindiTransliteration": "कि रोज़ी दिहंद हैं ॥१०९॥",
      "sourceLineId": "74649",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0006_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਕਿ ਰਾਜ਼ਕ ਰਹੀਮ ਹੈਂ ॥",
