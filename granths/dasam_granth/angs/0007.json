      "transliteration": "akaram hai(n) ||",
      "translation": "Thou art Actionless.",
      "punjabiViakhya": "ਤੂੰ ਕਰਮ-ਰਹਿਤ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "अकरम हैं ॥",
      "sourceLineId": "74748",
      "sourceShabadId": "7415",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
