      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "प्रजुगति अनूप हैं ॥१३२॥",
      "sourceLineId": "74741",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0068",
