      "punjabiViakhya": "ਤੂੰ ਭੇਖ ਤੋਂ ਬਿਨਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "अभेख हैं ॥",
      "sourceLineId": "74745",
      "sourceShabadId": "7415",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਅਲੇਖ ਹੈਂ ॥੧੩੩॥",
