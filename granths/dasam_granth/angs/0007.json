      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "अभंग हैं ॥",
      "sourceLineId": "74743",
      "sourceShabadId": "7415",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਅਨੰਗ ਹੈਂ ॥",
