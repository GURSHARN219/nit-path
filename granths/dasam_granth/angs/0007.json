      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "अनंग हैं ॥",
      "sourceLineId": "74744",
      "sourceShabadId": "7415",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਅਭੇਖ ਹੈਂ ॥",
