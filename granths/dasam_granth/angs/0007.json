      "punjabiViakhya": "ਤੂੰ ਲੇਖੇ ਤੋਂ ਬਾਹਰ ਹੈਂ ॥੧੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "अलेख हैं ॥१३३॥",
      "sourceLineId": "74746",
      "sourceShabadId": "7415",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0073",
