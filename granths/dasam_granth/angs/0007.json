{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 7,
  "lineCount": 88,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0007_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਿ ਸਰਬੱਤ੍ਰ ਰਾਜੈ ॥",
      "transliteration": "k saraba'tr raajai ||",
      "translation": "That Thou art the Glory of all!",
      "punjabiViakhya": "ਤੂੰ ਸਭ ਥਾ ਸੋਭ ਰਿਹਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्त्र राजै ॥",
      "sourceLineId": "74675",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਿ ਸਰਬੱਤ੍ਰ ਸੋਖੈ ॥",
      "transliteration": "k saraba'tr sokhai ||",
      "translation": "That Thou driest up all!",
      "punjabiViakhya": "ਤੂੰ ਸਭ ਨੂੰ ਸੁਕਾਉਾਂਦਾ (ਨਸ਼ਟ ਕਰਦਾ) ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्त्र सोखै ॥",
      "sourceLineId": "74676",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਿ ਸਰਬੱਤ੍ਰ ਪੋਖੈ ॥੧੧੬॥",
      "transliteration": "k saraba'tr pokhai ||116||",
      "translation": "That Thou fillest up all! 116",
      "punjabiViakhya": "ਤੂੰ ਸਭ ਦੀ ਪਾਲਨਾ ਕਰਦਾ ਹੈਂ ॥੧੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्त्र पोखै ॥११६॥",
      "sourceLineId": "74677",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਿ ਸਰਬੱਤ੍ਰ ਤ੍ਰਾਣੈ ॥",
      "transliteration": "k saraba'tr traanai ||",
      "translation": "That Thou art the Strength of all!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਸਭ ਦਾ ਤ੍ਰਾਣ (ਬਲ) ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्त्र त्राणै ॥",
      "sourceLineId": "74678",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਿ ਸਰਬੱਤ੍ਰ ਪ੍ਰਾਣੈ ॥",
      "transliteration": "k saraba'tr praanai ||",
      "translation": "That Thou art the life of all!",
      "punjabiViakhya": "ਤੂੰ ਸਭ ਦਾ ਪ੍ਰਾਣ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्त्र प्राणै ॥",
      "sourceLineId": "74679",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਿ ਸਰਬੱਤ੍ਰ ਦੇਸੈ ॥",
      "transliteration": "k saraba'tr dhesai ||",
      "translation": "That Thou art in all countries!",
      "punjabiViakhya": "ਤੂੰ ਸਭ ਦੇਸ਼ਾ ਵਿਚ ਮੌਜੂਦ ਹੈਂ",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्त्र देसै ॥",
      "sourceLineId": "74680",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਿ ਸਰਬੱਤ੍ਰ ਭੇਸੈ ॥੧੧੭॥",
      "transliteration": "k saraba'tr bhesai ||117||",
      "translation": "That Thou art in garbs! 117",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਭੇਸਾ ਵਿਚ ਸਥਿਤ ਹੈਂ ॥੧੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्त्र भेसै ॥११७॥",
      "sourceLineId": "74681",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਿ ਸਰਬੱਤ੍ਰ ਮਾਨਿਯੈਂ ॥",
      "transliteration": "k saraba'tr maaniyai(n) ||",
      "translation": "That Thou art worshipped everywhere!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਸਭ ਥਾ ਮੰਨਿਆ ਜਾਦਾ ਹੈਂ (ਪੂਜਣਯੋਗ ਹੈਂ)",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्त्र मानियैं ॥",
      "sourceLineId": "74682",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਦੈਵੰ ਪ੍ਰਧਾਨਿਯੈਂ ॥",
      "transliteration": "sadhaiva(n) pradhaaniyai(n) ||",
      "translation": "That Thou art the Supreme Controller of all!",
      "punjabiViakhya": "ਸਦਾ ਤੂੰ ਹੀ ਪ੍ਰਧਾਨ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "सदैवं प्रधानियैं ॥",
      "sourceLineId": "74683",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਿ ਸਰਬੱਤ੍ਰ ਜਾਪਿਯੈ ॥",
      "transliteration": "k saraba'tr jaapiyai ||",
      "translation": "That Thou art remembered everywhere!",
      "punjabiViakhya": "ਤੂੰ ਸਭ ਥਾਵਾ ਤੇ ਜਪਿਆ ਜਾਦਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्त्र जापियै ॥",
      "sourceLineId": "74684",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਿ ਸਰਬੱਤ੍ਰ ਥਾਪਿਯੈ ॥੧੧੮॥",
      "transliteration": "k saraba'tr thaapiyai ||118||",
      "translation": "That Thou art established everywhere! 118",
      "punjabiViakhya": "ਸਭ ਥਾਵਾ ਵਿਚ ਤੂੰ ਹੀ ਸਥਿਤ ਹੈਂ ॥੧੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्त्र थापियै ॥११८॥",
      "sourceLineId": "74685",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਿ ਸਰਬੱਤ੍ਰ ਭਾਨੈ ॥",
      "transliteration": "k saraba'tr bhaanai ||",
      "translation": "That Thou illuminest everything!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਸਭ ਦਾ ਪ੍ਰਕਾਸ਼ਕ (ਸੂਰਜ) ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्त्र भानै ॥",
      "sourceLineId": "74686",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਿ ਸਰਬੱਤ੍ਰ ਮਾਨੈ ॥",
      "transliteration": "k saraba'tr maanai ||",
      "translation": "That Thou art honoured by all!",
      "punjabiViakhya": "ਤੂੰ ਸਭ ਦਾ ਮਾਣ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्त्र मानै ॥",
      "sourceLineId": "74687",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਿ ਸਰਬੱਤ੍ਰ ਇੰਦ੍ਰੈ ॥",
      "transliteration": "k saraba'tr i(n)dhrai ||",
      "translation": "That Thou art Indra (King) of all!",
      "punjabiViakhya": "ਤੂੰ ਸਭ ਦਾ ਰਾਜਾ (ਇੰਦਰ) ਹੈਂ",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्त्र इंद्रै ॥",
      "sourceLineId": "74688",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਿ ਸਰਬੱਤ੍ਰ ਚੰਦ੍ਰੈ ॥੧੧੯॥",
      "transliteration": "k saraba'tr cha(n)dhrai ||119||",
      "translation": "That Thou art the moon (Light) of all! 119",
      "punjabiViakhya": "ਅਤੇ ਸਭ ਨੂੰ ਸ਼ਾਤੀ ਦੇਣ ਵਾਲਾ (ਚੰਦ੍ਰਮਾ) ਹੈਂ ॥੧੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्त्र चंद्रै ॥११९॥",
      "sourceLineId": "74689",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਿ ਸਰਬੰ ਕਲੀਮੈ ॥",
      "transliteration": "k saraba(n) kaleemai ||",
      "translation": "That Thou art master off all powers!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਸਭ ਦਾ ਬੋਲ (ਕਲਾਮ) ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "कि सरबं कलीमै ॥",
      "sourceLineId": "74690",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਿ ਪਰਮੰ ਫ਼ਹੀਮੈ ॥",
      "transliteration": "k parama(n) phaheemai ||",
      "translation": "That Thou art Most Intelligent!",
      "punjabiViakhya": "ਤੂੰ ਸ੍ਰੇਸ਼ਠ ਬੁੱਧੀਮਾਨ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "कि परमं फ़हीमै ॥",
      "sourceLineId": "74691",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਿ ਆਕਲ ਅਲਾਮੈ ॥",
      "transliteration": "k aakal alaamai ||",
      "translation": "That Thou art Most Wise and Learned!",
      "punjabiViakhya": "ਤੂੰ ਵੱਡਾ ਅਕਲਮੰਦ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "कि आकल अलामै ॥",
      "sourceLineId": "74692",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਿ ਸਾਹਿਬ ਕਲਾਮੈ ॥੧੨੦॥",
      "transliteration": "k saahib kalaamai ||120||",
      "translation": "That Thou art the Master of Languages! 120",
      "punjabiViakhya": "ਤੂੰ ਬੋਲੀਆਂ (ਕਲਾਮ) ਦਾ ਸੁਆਮੀ ਹੈਂ ॥੧੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "कि साहिब कलामै ॥१२०॥",
      "sourceLineId": "74693",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਿ ਹੁਸਨਲ ਵਜੂ ਹੈਂ ॥",
      "transliteration": "k husanal vajoo hai(n) ||",
      "translation": "That Thou art the Embodiment of Beauty!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਸੁੰਦਰਤਾ (ਹੁਸਨ) ਦੀ ਮੂਰਤੀ (ਵਜੂਦ) ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "कि हुसनल वजू हैं ॥",
      "sourceLineId": "74694",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਮਾਮੁਲ ਰੁਜੂ ਹੈਂ ॥",
      "transliteration": "tamaamul rujoo hai(n) ||",
      "translation": "That all look towards Thee!",
      "punjabiViakhya": "ਤੂੰ ਸਭ ਵਲ ਧਿਆਨ ('ਰੁਜੂ') ਦੇਣ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "तमामुल रुजू हैं ॥",
      "sourceLineId": "74695",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਹਮੇਸੁਲ ਸਲਾਮੈਂ ॥",
      "transliteration": "hamesul salaamai(n) ||",
      "translation": "That Thou abidest forever!",
      "punjabiViakhya": "ਤੂੰ ਹਮੇਸ਼ਾ ਸਲਾਮਤ ਰਹਿਣ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "हमेसुल सलामैं ॥",
      "sourceLineId": "74696",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਲੀਖਤ ਮੁਦਾਮੈਂ ॥੧੨੧॥",
      "transliteration": "saleekhat mudhaamai(n) ||121||",
      "translation": "That Thou hast perpetual offspring! 121",
      "punjabiViakhya": "ਤੂੰ ਸਥਿਰ ਸੰਤਾਨ ('ਸਲੀਖਤ') ਵਾਲਾ ਹੈਂ ॥੧੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "सलीखत मुदामैं ॥१२१॥",
      "sourceLineId": "74697",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗ਼ਨੀਮੁਲ ਸ਼ਿਕਸਤੈ ॥",
      "transliteration": "g(h)neemul shikasatai ||",
      "translation": "That Thou art the conquereror of mighty enemies!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਵੱਡਿਆਂ ਵੈਰੀਆਂ ਨੂੰ ਹਰਾਉਣ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "ग़नीमुल शिकसतै ॥",
      "sourceLineId": "74698",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗ਼ਰੀਬੁਲ ਪਰਸਤੈ ॥",
      "transliteration": "g(h)reebul parasatai ||",
      "translation": "That Thou art the Protector of the lowly!",
      "punjabiViakhya": "ਤੂੰ ਗ਼ਰੀਬਾ ਦਾ ਪਾਲਣਹਾਰ ('ਪਰਸਤੈ') ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "ग़रीबुल परसतै ॥",
      "sourceLineId": "74699",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਿਲੰਦੁਲ ਮਕਾਨੈਂ ॥",
      "transliteration": "bila(n)dhul makaanai(n) ||",
      "translation": "That Thy Abode is the Highest!",
      "punjabiViakhya": "ਤੇਰਾ ਸਥਾਨ (ਮਕਾਨ) ਬਹੁਤ ਉੱਚਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "बिलंदुल मकानैं ॥",
      "sourceLineId": "74700",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜ਼ਮੀਨਲ ਜ਼ਮਾਨੈਂ ॥੧੨੨॥",
      "transliteration": "zameenal zamaanai(n) ||122||",
      "translation": "That Thou Pervadest on Earth and in Heavens! 122",
      "punjabiViakhya": "ਤੂੰ ਧਰਤੀ ਅਤੇ ਆਕਾਸ਼ ਵਿਚ (ਭਾਵ ਸਭ ਵਿਚ) ਵਿਆਪਤ ਹੈਂ ॥੧੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "ज़मीनल ज़मानैं ॥१२२॥",
      "sourceLineId": "74701",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਮੀਜ਼ੁਲ ਤਮਾਮੈਂ ॥",
      "transliteration": "tameezul tamaamai(n) ||",
      "translation": "That Thou discriminatest all!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਸਭ ਨੂੰ ਪਛਾਣਨ ਵਾਲਾ (ਤਮੀਜ਼ ਕਰਨ ਵਾਲਾ) ਵਿਵੇਕੀ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "तमीज़ुल तमामैं ॥",
      "sourceLineId": "74702",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਰੁਜੂਅਲ ਨਿਧਾਨੈਂ ॥",
      "transliteration": "rujooal nidhaanai(n) ||",
      "translation": "That Thou art most Considerate!",
      "punjabiViakhya": "ਤੂੰ ਸਭ ਵਲ ਧਿਆਨ ਦੇਣ (ਰੁਜੂ ਕਰਨ) ਵਾਲੀ ਰੁਚੀ ਦਾ ਭੰਡਾਰ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "रुजूअल निधानैं ॥",
      "sourceLineId": "74703",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹਰੀਫੁਲ ਅਜੀਮੈਂ ॥",
      "transliteration": "hareeful ajeemai(n) ||",
      "translation": "That Thou art the Greatest Friend!",
      "punjabiViakhya": "ਤੂੰ (ਸਭ ਦਾ) ਵੱਡਾ ਮਿਤਰ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "हरीफुल अजीमैं ॥",
      "sourceLineId": "74704",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਜ਼ਾਇਕ ਯਕੀਨੈਂ ॥੧੨੩॥",
      "transliteration": "razaik yakeenai(n) ||123||",
      "translation": "That Thou art certainlyhe Giver of food! 123",
      "punjabiViakhya": "ਤੂੰ ਨਿਸਚੇ ਹੀ (ਸਭ ਨੂੰ) ਰੋਜ਼ੀ ਦਿੰਦਾ ਹੈਂ ॥੧੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "रज़ाइक यकीनैं ॥१२३॥",
      "sourceLineId": "74705",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਨੇਕੁਲ ਤਰੰਗ ਹੈਂ ॥",
      "transliteration": "anekul tara(n)g hai(n) ||",
      "translation": "That Thou, as Ocean, Hast innumerable waves!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਅਨੇਕ ਲਹਿਰਾ ਵਾਲਾ (ਸਾਗਰ) ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "अनेकुल तरंग हैं ॥",
      "sourceLineId": "74706",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਭੇਦ ਹੈਂ ਅਭੰਗ ਹੈਂ ॥",
      "transliteration": "abhedh hai(n) abha(n)g hai(n) ||",
      "translation": "That Thou art Immortal and none can know Thy secrets!",
      "punjabiViakhya": "ਤੇਰਾ ਭੇਦ ਨਹੀਂ ਪਾਇਆ ਜਾ ਸਕਦਾ, ਤੂੰ ਨਾਸ਼-ਰਹਿਤ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "अभेद हैं अभंग हैं ॥",
      "sourceLineId": "74707",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਜ਼ੀਜ਼ੁਲ ਨਿਵਾਜ਼ ਹੈਂ ॥",
      "transliteration": "azeezul nivaaz hai(n) ||",
      "translation": "That Thou Protectest the devotees!",
      "punjabiViakhya": "ਤੂੰ ਪਿਆਰਿਆਂ (ਅਜ਼ੀਜ਼ਾ) ਨੂੰ ਵਡਿਆਉਣ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "अज़ीज़ुल निवाज़ हैं ॥",
      "sourceLineId": "74708",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗ਼ਨੀਮੁਲ ਖ਼ਿਰਾਜ ਹੈਂ ॥੧੨੪॥",
      "transliteration": "g(h)neemul khhiraaj hai(n) ||124||",
      "translation": "That Thou punishest the evil-doers! 124",
      "punjabiViakhya": "ਤੂੰ ਵੈਰੀਆਂ (ਗ਼ਨੀਮਾ) ਤੋਂ ਕਰ ('ਖ਼ਿਰਾਜ') ਵਸੂਲ ਕਰਨ ਵਾਲਾ ਹੈਂ (ਅਰਥਾਤ ਸਭ ਤੇਰੇ ਅਧੀਨ ਹਨ) ॥੧੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "ग़नीमुल ख़िराज हैं ॥१२४॥",
      "sourceLineId": "74709",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਿਰੁਕਤ ਸਰੂਪ ਹੈਂ ॥",
      "transliteration": "nirukat saroop hai(n) ||",
      "translation": "That Thy Entity is Indexpressible!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੇਰਾ ਸਰੂਪ ਬਿਆਨ ਰਹਿਤ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "निरुकत सरूप हैं ॥",
      "sourceLineId": "74710",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤ੍ਰਿਮੁਕਤਿ ਬਿਭੂਤਿ ਹੈਂ ॥",
      "transliteration": "tiramukat bibhoot hai(n) ||",
      "translation": "That Thy Glory is Beyond the three Modes!",
      "punjabiViakhya": "ਤੇਰੀ ਵਿਭੂਤੀ (ਸੰਪੱਤੀ) ਮਾਇਆ ਦੇ ਤਿੰਨਾ ਗੁਣਾ ਤੋਂ ਪਰੇ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "तृमुकति बिभूति हैं ॥",
      "sourceLineId": "74711",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪ੍ਰਭੁਗਤਿ ਪ੍ਰਭਾ ਹੈਂ ॥",
      "transliteration": "prabhugat prabhaa hai(n) ||",
      "translation": "That Thine is the Most Powerful Glow!",
      "punjabiViakhya": "ਤੇਰੇ ਹੀ ਪ੍ਰਤਾਪ ਤੋਂ ਉਪਭੋਗੀ ਸਾਮਗ੍ਰੀ ਪੈਦਾ ਹੋਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "प्रभुगति प्रभा हैं ॥",
      "sourceLineId": "74712",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੁ ਜੁਗਤਿ ਸੁਧਾ ਹੈਂ ॥੧੨੫॥",
      "transliteration": "s jugat sudhaa hai(n) ||125||",
      "translation": "That Thou art ever united with all! 125",
      "punjabiViakhya": "ਤੂੰ ਅੰਮ੍ਰਿਤ ('ਸੁਧਾ') ਨਾਲ ਸੰਯੁਕਤ ਹੈਂ ॥੧੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "सु जुगति सुधा हैं ॥१२५॥",
      "sourceLineId": "74713",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਦੈਵੰ ਸਰੂਪ ਹੈਂ ॥",
      "transliteration": "sadhaiva(n) saroop hai(n) ||",
      "translation": "That Thou art Eternal Entity!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੇਰਾ ਸਰੂਪ ਸਦੀਵੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "सदैवं सरूप हैं ॥",
      "sourceLineId": "74714",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਭੇਦੀ ਅਨੂਪ ਹੈਂ ॥",
      "transliteration": "abhedhee anoop hai(n) ||",
      "translation": "That Thou art undivided and unparalleled!",
      "punjabiViakhya": "ਭੇਦ ਅਤੇ ਉਪਮਾ ਤੋਂ ਰਹਿਤ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "अभेदी अनूप हैं ॥",
      "sourceLineId": "74715",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਮਸਤੋਪਰਾਜ ਹੈਂ ॥",
      "transliteration": "samasatoparaaj hai(n) ||",
      "translation": "That Thou art the Creator of all!",
      "punjabiViakhya": "ਤੂੰ ਸਭ ਨੂੰ ਉਪਜਾਉਣ ਵਾਲਾ ਹੈਂ",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "समसतोपराज हैं ॥",
      "sourceLineId": "74716",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਦਾ ਸਰਬ ਸਾਜ ਹੈਂ ॥੧੨੬॥",
      "transliteration": "sadhaa sarab saaj hai(n) ||126||",
      "translation": "That Thou art ever the Ornamentation of all! 126",
      "punjabiViakhya": "ਅਤੇ ਸਭ ਨੂੰ ਸੁਸਜਿਤ ਕਰਨ ਵਾਲਾ ਹੈਂ ॥੧੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "सदा सरब साज हैं ॥१२६॥",
      "sourceLineId": "74717",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਮਸਤੁਲ ਸਲਾਮ ਹੈਂ ॥",
      "transliteration": "samasatul salaam hai(n) ||",
      "translation": "That Thou art saluted by all!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਸਾਰਿਆਂ ਦੁਆਰਾ ਪ੍ਰਨਾਮ ਕਰਨ ਯੋਗ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "समसतुल सलाम हैं ॥",
      "sourceLineId": "74718",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਦੈਵਲ ਅਕਾਮ ਹੈਂ ॥",
      "transliteration": "sadhaival akaam hai(n) ||",
      "translation": "That Thou art ever the Desireless Lord!",
      "punjabiViakhya": "ਤੂੰ ਸਦਾ ਕਾਮਨਾਵਾ ਤੋਂ ਮੁਕਤ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "सदैवल अकाम हैं ॥",
      "sourceLineId": "74719",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨ੍ਰਿਬਾਧ ਸਰੂਪ ਹੈਂ ॥",
      "transliteration": "nirabaadh saroop hai(n) ||",
      "translation": "That Thou art Invincible!",
      "punjabiViakhya": "ਤੂੰ (ਹਰ ਪ੍ਰਕਾਰ ਦੀਆਂ) ਰੁਕਾਵਟਾ ਤੋਂ ਰਹਿਤ ਸਰੂਪ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "नृबाध सरूप हैं ॥",
      "sourceLineId": "74720",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਗਾਧ ਹੈਂ ਅਨੂਪ ਹੈਂ ॥੧੨੭॥",
      "transliteration": "agaadh hai(n) anoop hai(n) ||127||",
      "translation": "That Thou art Impenetrable and Unparalleled Entity! 127",
      "punjabiViakhya": "ਨਾ ਤੇਰਾ ਪਾਰਾਵਾਰ ਪਾਇਆ ਜਾ ਸਕਦਾ ਹੈ ਅਤੇ ਨਾ ਹੀ ਤੇਰੀ ਉਪਮਾ ਦਿੱਤੀ ਜਾ ਸਕਦੀ ਹੈ ॥੧੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "अगाध हैं अनूप हैं ॥१२७॥",
      "sourceLineId": "74721",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਓਅੰ ਆਦਿ ਰੂਪੇ ॥",
      "transliteration": "oa(n) aadh roope ||",
      "translation": "That Thou art Aum the primal Entity!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਓਅੰਕਾਰ ਸਰੂਪ ਅਤੇ ਸਭ ਦਾ ਆਦਿ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "ओअं आदि रूपे ॥",
      "sourceLineId": "74722",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅਨਾਦਿ ਸਰੂਪੇ ॥",
      "transliteration": "anaadh saroope ||",
      "translation": "That Thou art also without beginning!",
      "punjabiViakhya": "ਤੂੰ ਸਾਰਿਆਂ ਦਾ ਸਰੋਤ-ਰੂਪ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "अनादि सरूपे ॥",
      "sourceLineId": "74723",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਅਨੰਗੀ ਅਨਾਮੇ ॥",
      "transliteration": "ana(n)gee anaame ||",
      "translation": "That Thu art Bodyless and Nameless!",
      "punjabiViakhya": "ਤੂੰ ਸ਼ਰੀਰ ਤੋਂ ਬਿਨਾ ('ਅਨੰਗ') ਅਤੇ ਨਾਮ ਤੋਂ ਰਹਿਤ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "अनंगी अनामे ॥",
      "sourceLineId": "74724",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਤ੍ਰਿਭੰਗੀ ਤ੍ਰਿਕਾਮੇ ॥੧੨੮॥",
      "transliteration": "tirabha(n)gee tirakaame ||128||",
      "translation": "That Thou art the Destroyer and Restorer of three modes! 128",
      "punjabiViakhya": "ਤੂੰ ਤਿੰਨਾ ਲੋਕਾ ਦਾ ਵਿਨਾਸ਼ਕ ਅਤੇ ਤਿੰਨਾ ਲੋਕਾ ਦੀਆਂ ਕਾਮਨਾਵਾ ਪੂਰੀਆਂ ਕਰਨ ਵਾਲਾ ਹੈਂ ॥੧੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "तृभंगी तृकामे ॥१२८॥",
      "sourceLineId": "74725",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਤ੍ਰਿਬਰਗੰ ਤ੍ਰਿਬਾਧੇ ॥",
      "transliteration": "tirabaraga(n) tirabaadhe ||",
      "translation": "That Thou art the Destroyer of three gods and modes!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਤਿੰਨ ਵਰਗਾ (ਅਰਥ, ਧਰਮ ਅਤੇ ਕਾਮ) ਵਾਲਾ ਅਤੇ ਤਿੰਨਾ ਲੋਕਾ ਨੂੰ ਬੰਨ੍ਹਣ ਵਾਲਾ (ਅਧੀਨ ਰਖਣ ਵਾਲਾ) ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "तृबरगं तृबाधे ॥",
      "sourceLineId": "74726",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਅਗੰਜੇ ਅਗਾਧੇ ॥",
      "transliteration": "aga(n)je agaadhe ||",
      "translation": "That Thou art Immortal and Impenetrable!",
      "punjabiViakhya": "ਤੂੰ ਨਾਸ਼ ਤੋਂ ਰਹਿਤ ਅਤੇ ਅਥਾਹ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "अगंजे अगाधे ॥",
      "sourceLineId": "74727",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸੁਭੰ ਸਰਬ ਭਾਗੇ ॥",
      "transliteration": "subha(n) sarab bhaage ||",
      "translation": "That Thy Writ of Destiny is for all!",
      "punjabiViakhya": "ਤੂੰ (ਸੰਸਾਰ ਦੇ) ਸਾਰਿਆਂ ਹਿੱਸਿਆਂ ਵਿਚ ਸ਼ੋਭਾਇਮਾਨ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "सुभं सरब भागे ॥",
      "sourceLineId": "74728",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸੁ ਸਰਬਾ ਅਨੁਰਾਗੇ ॥੧੨੯॥",
