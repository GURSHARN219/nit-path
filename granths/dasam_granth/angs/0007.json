      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "प्रजुगति अनूप हैं ॥१३१॥",
      "sourceLineId": "74737",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਨਿਰੁਕਤਿ ਸਦਾ ਹੈਂ ॥",
      "transliteration": "nirukat sadhaa hai(n) ||",
      "translation": "That Thou art ever Inexpressible!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਸਦਾ ਵਰਣਨ ਤੋਂ ਪਰੇ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "निरुकति सदा हैं ॥",
      "sourceLineId": "74738",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਬਿਭੁਗਤਿ ਪ੍ਰਭਾ ਹੈਂ ॥",
      "transliteration": "bibhugat prabhaa hai(n) ||",
      "translation": "That Thy Glory appears in diverse guises!",
      "punjabiViakhya": "ਤੇਰੀ ਸੋਭਾ ਵੱਖ ਵੱਖ ਤਰ੍ਹਾ ਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 7,
      "hindi": "",
      "hindiTransliteration": "बिभुगति प्रभा हैं ॥",
      "sourceLineId": "74739",
      "sourceShabadId": "7414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0007_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਅਨਉਕਤਿ ਸਰੂਪ ਹੈਂ ॥",
