      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਸ੍ਰੇਸ਼ਠ ਬੁੱਧੀ ਦਾ ਮਾਲਕ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "कि साहिब दिमाग़ हैं ॥",
      "sourceLineId": "74818",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਕਿ ਹੁਸਨਲ ਚਰਾਗ਼ ਹੈਂ ॥",
      "transliteration": "k husanal charaag(h) hai(n) ||",
      "translation": "That Thou art the Lamp of Beauty!",
      "punjabiViakhya": "ਤੂੰ ਹੁਸਨ ਦਾ ਦੀਪਕ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "कि हुसनल चराग़ हैं ॥",
      "sourceLineId": "74819",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਕਿ ਕਾਮਲ ਕਰੀਮ ਹੈਂ ॥",
      "transliteration": "k kaamal kareem hai(n) ||",
      "translation": "That Thou art completely Generous!",
      "punjabiViakhya": "ਤੂੰ ਪਰਮ ਬਖਸ਼ਿੰਦ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "कि कामल करीम हैं ॥",
      "sourceLineId": "74820",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਕਿ ਰਾਜ਼ਕ ਰਹੀਮ ਹੈਂ ॥੧੫੧॥",
      "transliteration": "k raazak raheem hai(n) ||151||",
      "translation": "That Thou art Sustainer and Merciful! 151",
      "punjabiViakhya": "ਤੂੰ ਰੋਜ਼ੀ ਦੇਣ ਵਾਲਾ ਦਿਆਲੂ ਹੈਂ ॥੧੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "कि राज़क रहीम हैं ॥१५१॥",
      "sourceLineId": "74821",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਕਿ ਰੋਜ਼ੀ ਦਿਹਿੰਦ ਹੈਂ ॥",
      "transliteration": "k rozee dhihi(n)dh hai(n) ||",
      "translation": "That Thou art Giver of Sustenance!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਰੋਜ਼ੀ ਦੇਣ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "कि रोज़ी दिहिंद हैं ॥",
      "sourceLineId": "74822",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਕਿ ਰਾਜ਼ਕ ਰਹਿੰਦ ਹੈਂ ॥",
      "transliteration": "k raazak rahi(n)dh hai(n) ||",
      "translation": "That Thou art ever the Sustainer!",
      "punjabiViakhya": "ਤੂੰ ਮੁਕਤੀ ਪ੍ਰਦਾਨ ਕਰਨ ਵਾਲਾ ਦਇਆਵਾਨ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "कि राज़क रहिंद हैं ॥",
      "sourceLineId": "74823",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਕਰੀਮੁਲ ਕਮਾਲ ਹੈਂ ॥",
      "transliteration": "kareemul kamaal hai(n) ||",
      "translation": "That Thou art the perfection of Generosity!",
      "punjabiViakhya": "ਤੂੰ ਸ੍ਰੇਸ਼ਠ ('ਕਮਾਲ') ਕ੍ਰਿਪਾਲੂ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "करीमुल कमाल हैं ॥",
      "sourceLineId": "74824",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਕਿ ਹੁਸਨਲ ਜਮਾਲ ਹੈਂ ॥੧੫੨॥",
      "transliteration": "k husanal jamaal hai(n) ||152||",
      "translation": "That Thou art Most Beautiful! 152",
      "punjabiViakhya": "ਤੂੰ ਅਤਿਅੰਤ ਸੁੰਦਰ ਹੈਂ ॥੧੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "कि हुसनल जमाल हैं ॥१५२॥",
      "sourceLineId": "74825",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਗ਼ਨੀਮੁਲ ਖ਼ਿਰਾਜ ਹੈਂ ॥",
      "transliteration": "g(h)neemul khhiraaj hai(n) ||",
      "translation": "That Thou art the Penaliser of enemies!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਵੈਰੀਆਂ ਤੋਂ ਵੀ ਕਰ ਵਸੂਲਣ ਵਾਲਾ ਹੈਂ (ਅਰਥਾਤ ਸਭ ਨੂੰ ਅਧੀਨ ਰਖਣ ਵਾਲਾ ਹੈਂ)",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "ग़नीमुल ख़िराज हैं ॥",
      "sourceLineId": "74826",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਗ਼ਰੀਬੁਲ ਨਿਵਾਜ਼ ਹੈਂ ॥",
      "transliteration": "g(h)reebul nivaaz hai(n) ||",
      "translation": "That Thou art the Supporter of the poor!",
      "punjabiViakhya": "ਤੂੰ ਗ਼ਰੀਬਾ ਨੂੰ ਵਡਿਆਉਣ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "ग़रीबुल निवाज़ हैं ॥",
      "sourceLineId": "74827",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਹਰੀਫ਼ੁਲ ਸ਼ਿਕੰਨ ਹੈਂ ॥",
      "transliteration": "hareephul shika(n)n hai(n) ||",
      "translation": "That Thou art the Destroyer of enemies !",
      "punjabiViakhya": "ਤੂੰ ਵੈਰੀਆਂ ਦਾ ਨਾਸ਼ਕ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "हरीफ़ुल शिकंन हैं ॥",
      "sourceLineId": "74828",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਹਿਰਾਸੁਲ ਫਿਕੰਨ ਹੈਂ ॥੧੫੩॥",
      "transliteration": "hiraasul fika(n)n hai(n) ||153||",
      "translation": "That Thou art the remover of Fear ! 153",
      "punjabiViakhya": "ਤੂੰ ਭੈ ਨੂੰ ਪਰੇ ਸੁਟਣ ਵਾਲਾ ('ਫਿਕੰਨ') ਹੈਂ ॥੧੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "हिरासुल फिकंन हैं ॥१५३॥",
      "sourceLineId": "74829",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਕਲੰਕੰ ਪ੍ਰਣਾਸ ਹੈਂ ॥",
      "transliteration": "kala(n)ka(n) pranaas hai(n) ||",
      "translation": "That Thou art the Destroyer of blemishes!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਕਲੰਕ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "कलंकं प्रणास हैं ॥",
      "sourceLineId": "74830",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਸਮਸਤੁਲ ਨਿਵਾਸ ਹੈਂ ॥",
      "transliteration": "samasatul nivaas hai(n) ||",
      "translation": "That Thou art the dweller in all!",
      "punjabiViakhya": "ਤੂੰ ਸਾਰਿਆਂ ਵਿਚ ਵਸਦਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "समसतुल निवास हैं ॥",
      "sourceLineId": "74831",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਅਗੰਜੁਲ ਗਨੀਮ ਹੈਂ ॥",
      "transliteration": "aga(n)jul ganeem hai(n) ||",
      "translation": "That Thou art invincible by enemies!",
      "punjabiViakhya": "ਤੂੰ ਵੈਰੀਆਂ ('ਗਨੀਮ') ਤੋਂ ਨਸ਼ਟ ਹੋਣ ਵਾਲਾ ਨਹੀਂ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "अगंजुल गनीम हैं ॥",
      "sourceLineId": "74832",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਰਜਾਇਕ ਰਹੀਮ ਹੈਂ ॥੧੫੪॥",
      "transliteration": "rajaik raheem hai(n) ||154||",
      "translation": "That Thou art the Sustainer and Gracious! 154",
      "punjabiViakhya": "ਤੂੰ ਸਭ ਨੂੰ ਰੋਜ਼ੀ ਦੇਣ ਵਾਲਾ ਮਿਹਰਬਾਨ ਹੈਂ ॥੧੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "रजाइक रहीम हैं ॥१५४॥",
      "sourceLineId": "74833",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਸਮਸਤੁਲ ਜੁਬਾਂ ਹੈਂ ॥",
      "transliteration": "samasatul jubaa(n) hai(n) ||",
      "translation": "That Thou art the Master of all languages!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਸਾਰਿਆਂ ਦੀ ਬੋਲੀ ਹੈਂ (ਅਰਥਾਤ ਸਭ ਵਿਚ ਤੂੰ ਹੀ ਬੋਲ ਰਿਹਾ ਹੈਂ)",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "समसतुल जुबाँ हैं ॥",
      "sourceLineId": "74834",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0073",
      "lineIndex": 73,
      "gurmukhi": "ਕਿ ਸਾਹਿਬ ਕਿਰਾਂ ਹੈਂ ॥",
      "transliteration": "k saahib kiraa(n) hai(n) ||",
      "translation": "That Thou art the Most Glorious!",
      "punjabiViakhya": "ਤੂੰ ਸ਼ੁਭ ਸ਼ਗਨਾ ('ਕਿਰਾ') ਦਾ ਸੁਆਮੀ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "कि साहिब किराँ हैं ॥",
      "sourceLineId": "74835",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0074",
      "lineIndex": 74,
      "gurmukhi": "ਕਿ ਨਰਕੰ ਪ੍ਰਣਾਸ ਹੈਂ ॥",
      "transliteration": "k naraka(n) pranaas hai(n) ||",
      "translation": "That Thou art the Destroyer of hell!",
      "punjabiViakhya": "ਤੂੰ ਨਰਕਾ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "कि नरकं प्रणास हैं ॥",
      "sourceLineId": "74836",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0075",
      "lineIndex": 75,
      "gurmukhi": "ਬਹਿਸਤੁਲ ਨਿਵਾਸ ਹੈਂ ॥੧੫੫॥",
      "transliteration": "bahisatul nivaas hai(n) ||155||",
      "translation": "That Thou art the dweller in heaven! 155",
      "punjabiViakhya": "ਤੂੰ ਬਹਿਸ਼ਤ (ਸੁਅਰਗ) ਵਿਚ ਨਿਵਾਸ ਕਰਦਾ ਹੈਂ ॥੧੫੫॥",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "बहिसतुल निवास हैं ॥१५५॥",
      "sourceLineId": "74837",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0076",
      "lineIndex": 76,
      "gurmukhi": "ਕਿ ਸਰਬੁਲ ਗਵੰਨ ਹੈਂ ॥",
      "transliteration": "k sarabul gava(n)n hai(n) ||",
      "translation": "That Thou art the Goer to all!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਸਭ ਵਿਚ ਗਮਨ ਕਰਦਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "कि सरबुल गवंन हैं ॥",
      "sourceLineId": "74838",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0077",
      "lineIndex": 77,
      "gurmukhi": "ਹਮੇਸੁਲ ਰਵੰਨ ਹੈਂ ॥",
      "transliteration": "hamesul rava(n)n hai(n) ||",
      "translation": "That Thou art ever Blissful!",
      "punjabiViakhya": "ਤੂੰ ਹਮੇਸ਼ਾ (ਸਭ ਵਿਚ) ਵਿਆਪਤ ਹੋਣ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "हमेसुल रवंन हैं ॥",
      "sourceLineId": "74839",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0078",
      "lineIndex": 78,
      "gurmukhi": "ਤਮਾਮੁਲ ਤਮੀਜ ਹੈਂ ॥",
      "transliteration": "tamaamul tameej hai(n) ||",
      "translation": "That Thou art the knower of all!",
      "punjabiViakhya": "ਤੂੰ ਸਭ ਦੀ ਪਛਾਣ ਰਖਦਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "तमामुल तमीज हैं ॥",
      "sourceLineId": "74840",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0079",
      "lineIndex": 79,
      "gurmukhi": "ਸਮਸਤੁਲ ਅਜੀਜ ਹੈਂ ॥੧੫੬॥",
