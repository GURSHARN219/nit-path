      "ang": 8,
      "hindi": "",
      "hindiTransliteration": "समसतुल कलाम हैं ॥१५०॥",
      "sourceLineId": "74817",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0008_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕਿ ਸਾਹਿਬ ਦਿਮਾਗ਼ ਹੈਂ ॥",
