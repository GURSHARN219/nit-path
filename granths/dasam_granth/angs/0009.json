{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 9,
  "lineCount": 84,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0009_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਿ ਅਮਿਤੋ ਪਸਾ ਹੈਂ ॥",
      "transliteration": "k amito pasaa hai(n) ||",
      "translation": "That Thou art Limitless Expanse!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਅਸੀਮ ਪਸਾਰ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "कि अमितो पसा हैं ॥",
      "sourceLineId": "74854",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਿ ਆਤਮ ਪ੍ਰਭਾ ਹੈਂ ॥",
      "transliteration": "k aatam prabhaa hai(n) ||",
      "translation": "That Thou art selfluminous!",
      "punjabiViakhya": "ਤੂੰ ਆਪਣੇ ਆਪ ਪ੍ਰਕਾਸ਼ਵਾਨ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "कि आतम प्रभा हैं ॥",
      "sourceLineId": "74855",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਿ ਅਚਲੰ ਅਨੰਗ ਹੈਂ ॥",
      "transliteration": "k achala(n) ana(n)g hai(n) ||",
      "translation": "That Thou art Steady and Limbless!",
      "punjabiViakhya": "ਤੂੰ ਅਚਲ ਅਤੇ ਸ਼ਰੀਰ-ਰਹਿਤ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "कि अचलं अनंग हैं ॥",
      "sourceLineId": "74856",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਿ ਅਮਿਤੋ ਅਭੰਗ ਹੈਂ ॥੧੬੦॥",
      "transliteration": "k amito abha(n)g hai(n) ||160||",
      "translation": "That Thou art Infinite and Indestructible! 160",
      "punjabiViakhya": "ਤੂੰ ਅਨੰਤ ਅਤੇ ਅਵਿਨਾਸ਼ੀ ਹੈਂ ॥੧੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "कि अमितो अभंग हैं ॥१६०॥",
      "sourceLineId": "74857",
      "sourceShabadId": "7418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਧੁਭਾਰ ਛੰਦ ॥ ਤ੍ਵ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "madhubhaar chha(n)dh || tavai prasaadh ||",
      "translation": "MADHUBHAR STANZA. BY THY GRACE.",
      "punjabiViakhya": "ਮਧੁਭਾਰ ਛੰਦ: ਤੇਰੀ ਕ੍ਰਿਪਾ ਨਾਲ:",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "मधुभार छंद ॥ त्व प्रसादि ॥",
      "sourceLineId": "74858",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮੁਨਿ ਮਨਿ ਪ੍ਰਨਾਮ ॥",
      "transliteration": "mun man pranaam ||",
      "translation": "O Lord !  The sages bow before Thee in their mind!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੈਨੂੰ ਮੁਨੀ ਮਨ ਵਿਚ ਪ੍ਰਨਾਮ ਕਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "मुनि मनि प्रनाम ॥",
      "sourceLineId": "74859",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੁਨਿ ਗਨ ਮੁਦਾਮ ॥",
      "transliteration": "gun gan mudhaam ||",
      "translation": "O Lord !  Thou art ever the Treasure of virtues.",
      "punjabiViakhya": "ਤੂੰ ਸਦਾ ਗੁਣਾ ਦਾ ਸੁਆਮੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "गुनि गन मुदाम ॥",
      "sourceLineId": "74860",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਰਿ ਬਰ ਅਗੰਜ ॥",
      "transliteration": "ar bar aga(n)j ||",
      "translation": "O Lord !  Thou canst not be destroyed by great enemies!",
      "punjabiViakhya": "ਤੂੰ ਵੱਡੇ ਵੈਰੀਆਂ ਲਈ ਵੀ ਅਜਿਤ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "अरि बर अगंज ॥",
      "sourceLineId": "74861",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹਰਿ ਨਰ ਪ੍ਰਭੰਜ ॥੧੬੧॥",
      "transliteration": "har nar prabha(n)j ||161||",
      "translation": "O Lord !  Thou art the Destroyer of all.161.",
      "punjabiViakhya": "ਹੇ ਹਰਿ! (ਤੂੰ) ਸਭ ਮਨੁੱਖਾ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਦੇ ਸਮਰਥ ਹੈਂ ॥੧੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "हरि नर प्रभंज ॥१६१॥",
      "sourceLineId": "74862",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਨਗਨ ਪ੍ਰਨਾਮ ॥",
      "transliteration": "anagan pranaam ||",
      "translation": "O Lord !  Innumerable beings bow before Thee. O Lord !",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੈਨੂੰ ਅਨੇਕ ਜੀਵ ਜੁਹਾਰ ਕਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "अनगन प्रनाम ॥",
      "sourceLineId": "74863",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮੁਨਿ ਮਨਿ ਸਲਾਮ ॥",
      "transliteration": "mun man salaam ||",
      "translation": "The sages salute Thee in their mind.",
      "punjabiViakhya": "ਤੈਨੂੰ ਮੁਨੀ ਲੋਕ ਮਨ ਵਿਚ ਪ੍ਰਨਾਮ ਕਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "मुनि मनि सलाम ॥",
      "sourceLineId": "74864",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਰਿ ਨਰ ਅਖੰਡ ॥",
      "transliteration": "har nar akha(n)dd ||",
      "translation": "O Lord !  Thou art complete controller of men. O Lord !",
      "punjabiViakhya": "ਹੇ ਹਰਿ! (ਤੂੰ) ਨਾ ਖੰਡਿਤ ਕੀਤੇ ਜਾ ਸਕਣ ਵਾਲਾ ਨਰ ਸ੍ਰੇਸ਼ਠ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "हरि नर अखंड ॥",
      "sourceLineId": "74865",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਰ ਨਰ ਅਮੰਡ ॥੧੬੨॥",
      "transliteration": "bar nar ama(n)dd ||162||",
      "translation": "Thou canst not be installed by the chiefs. 162.",
      "punjabiViakhya": "ਤੂੰ ਬਿਨਾ ਸਥਾਪਿਤ ਕੀਤੇ ਸ੍ਰੇਸ਼ਠ ਪੁਰਸ਼ ਹੈਂ ॥੧੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "बर नर अमंड ॥१६२॥",
      "sourceLineId": "74866",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਨਭਵ ਅਨਾਸ ॥",
      "transliteration": "anabhav anaas ||",
      "translation": "O Lord !  Thou art eternal knowledge. O Lord !",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਨਾ ਨਸ਼ਟ ਹੋਣ ਵਾਲੇ ਸੁਤਹ ਗਿਆਨ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "अनभव अनास ॥",
      "sourceLineId": "74867",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮੁਨਿ ਮਨਿ ਪ੍ਰਕਾਸ ॥",
      "transliteration": "mun man prakaas ||",
      "translation": "Thou art illumined in the hearts of the sages.",
      "punjabiViakhya": "ਤੂੰ ਮੁਨੀਆਂ ਦੇ ਮਨ ਦਾ ਪ੍ਰਕਾਸ਼ (ਗਿਆਨ) ਵੀ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "मुनि मनि प्रकास ॥",
      "sourceLineId": "74868",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੁਨਿ ਗਨ ਪ੍ਰਨਾਮ ॥",
      "transliteration": "gun gan pranaam ||",
      "translation": "O Lord !  The assemblies of virtuous bow before thee. O Lord !",
      "punjabiViakhya": "ਹੇ ਗੁਣਾ ਦੇ ਭੰਡਾਰ! (ਤੈਨੂੰ ਮੇਰਾ) ਪ੍ਰਨਾਮ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "गुनि गन प्रनाम ॥",
      "sourceLineId": "74869",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਲ ਥਲ ਮੁਦਾਮ ॥੧੬੩॥",
      "transliteration": "jal thal mudhaam ||163||",
      "translation": "Thou pervadest in water and on land. 163.",
      "punjabiViakhya": "ਤੂੰ ਜਲ ਥਲ ਵਿਚ ਸਦਾ ਮੌਜੂਦ ਹੈਂ ॥੧੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "जल थल मुदाम ॥१६३॥",
      "sourceLineId": "74870",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਨਛਿੱਜ ਅੰਗ ॥",
      "transliteration": "anachhi'j a(n)g ||",
      "translation": "O Lord !  Thy body is unbreakable. O Lord !",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੇਰਾ ਸਰੂਪ ਛਿਜਣ ਵਾਲਾ ਨਹੀਂ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "अनछिज्ज अंग ॥",
      "sourceLineId": "74871",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਆਸਨ ਅਭੰਗ ॥",
      "transliteration": "aasan abha(n)g ||",
      "translation": "Thy seat is perpetual.",
      "punjabiViakhya": "ਤੇਰਾ ਆਸਨ ਅਚਲ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "आसन अभंग ॥",
      "sourceLineId": "74872",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਉਪਮਾ ਅਪਾਰ ॥",
      "transliteration": "aupamaa apaar ||",
      "translation": "O Lord !  Thy Praises are boundless. O Lord !",
      "punjabiViakhya": "ਤੇਰੀ ਉਪਮਾ ਅਪਾਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "उपमा अपार ॥",
      "sourceLineId": "74873",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗਤਿ ਮਿਤਿ ਉਦਾਰ ॥੧੬੪॥",
      "transliteration": "gat mit udhaar ||164||",
      "translation": "Thy nature is most Generous. 164.",
      "punjabiViakhya": "ਤੇਰੀ ਚਾਲ ਅਤੇ ਸੀਮਾ ਅਤਿ ਉਦਾਰ ਹੈ ॥੧੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "गति मिति उदार ॥१६४॥",
      "sourceLineId": "74874",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਲ ਥਲ ਅਮੰਡ ॥",
      "transliteration": "jal thal ama(n)dd ||",
      "translation": "O Lord !  Thou art most glorious in water and on land. O Lord !",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਜਲ-ਥਲ ਵਿਚ ਸ਼ੋਭਾਇਮਾਨ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "जल थल अमंड ॥",
      "sourceLineId": "74875",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦਿਸ ਵਿਸ ਅਭੰਡ ॥",
      "transliteration": "dhis vis abha(n)dd ||",
      "translation": "Thou art free from slander at all places.",
      "punjabiViakhya": "ਤੂੰ ਦਿਸ਼ਾ-ਵਿਦਿਸ਼ਾ ਵਿਚ ਅਨਿੰਦ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "दिस विस अभंड ॥",
      "sourceLineId": "74876",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਲ ਥਲ ਮਹੰਤ ॥",
      "transliteration": "jal thal maha(n)t ||",
      "translation": "O Lord !  Thou art Supreme in water and on land. O Lord !",
      "punjabiViakhya": "ਤੂੰ ਜਲ-ਥਲ ਦਾ ਸੁਆਮੀ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "जल थल महंत ॥",
      "sourceLineId": "74877",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦਿਸ ਵਿਸ ਬਿਅੰਤ ॥੧੬੫॥",
      "transliteration": "dhis vis bia(n)t ||165||",
      "translation": "Thou art endless in all directions. 165.",
      "punjabiViakhya": "ਤੂੰ ਦਿਸ਼ਾ-ਵਿਦਿਸ਼ਾ ਵਿਚ ਬਿਨਾ ਅੰਤ ਦੇ ਹੈਂ ॥੧੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "दिस विस बिअंत ॥१६५॥",
      "sourceLineId": "74878",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਨਭਵ ਅਨਾਸ ॥",
      "transliteration": "anabhav anaas ||",
      "translation": "O Lord !  Thou art eternal knowledge. O Lord !",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੇਰਾ ਸੁਤਹ ਗਿਆਨ ਨਸ਼ਟ ਹੋਣ ਵਾਲਾ ਨਹੀਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "अनभव अनास ॥",
      "sourceLineId": "74879",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਧ੍ਰਿਤ ਧਰ ਧੁਰਾਸ ॥",
      "transliteration": "dhirat dhar dhuraas ||",
      "translation": "Thou art Supreme among the contented ones.",
      "punjabiViakhya": "ਤੂੰ ਧੀਰਜ-ਧਾਰੀਆਂ ਦਾ ਧੁਰਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "धृत धर धुरास ॥",
      "sourceLineId": "74880",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਆਜਾਨ ਬਾਹੁ ॥",
      "transliteration": "aajaan baahu ||",
      "translation": "O Lord !  Thou art the arm of gods. O Lord !",
      "punjabiViakhya": "ਤੂੰ ਦੇਵਤਿਆਂ ਦਾ ਪ੍ਰੇਰਕ ਹੈਂ (ਜਾ ਗੋਡਿਆਂ ਤਕ ਲੰਬੀਆਂ ਭੁਜਾਵਾ ਵਾਲਾ ਹੈਂ)",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "आजान बाहु ॥",
      "sourceLineId": "74881",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਏਕੈ ਸਦਾਹੁ ॥੧੬੬॥",
      "transliteration": "ekai sadhaahu ||166||",
      "translation": "Thou art ever the Only One. 166.",
      "punjabiViakhya": "ਤੂੰ ਸਦਾ ਇਕੋ ਇਕ ਹੈਂ ॥੧੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "एकै सदाहु ॥१६६॥",
      "sourceLineId": "74882",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਓਅੰਕਾਰ ਆਦਿ ॥",
      "transliteration": "oa(n)kaar aadh ||",
      "translation": "O Lord !  Thou art AUM, the origin of creation. O Lord !",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਆਦਿ ਤੋਂ ਓਅੰਕਾਰ ਸਰੂਪ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "ओअंकार आदि ॥",
      "sourceLineId": "74883",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਥਨੀ ਅਨਾਦਿ ॥",
      "transliteration": "kathanee anaadh ||",
      "translation": "Thou art stated to be without beginning.",
      "punjabiViakhya": "ਤੇਰਾ ਵਰਣਨ ਕਥਨ ਤੋਂ ਪਰੇ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "कथनी अनादि ॥",
      "sourceLineId": "74884",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਖਲ ਖੰਡ ਖਿਆਲ ॥",
      "transliteration": "khal kha(n)dd khiaal ||",
      "translation": "O Lord !  Thou destroyest the tyrants instantly!",
      "punjabiViakhya": "ਤੂੰ ਫੁਰਨੇ ਵਿਚ ਹੀ ਦੁਸ਼ਟਾ ('ਖਲ') ਨੂੰ ਨਸ਼ਟ ਕਰ ਸਕਦਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "खल खंड खिआल ॥",
      "sourceLineId": "74885",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗੁਰ ਬਰ ਅਕਾਲ ॥੧੬੭॥",
      "transliteration": "gur bar akaal ||167||",
      "translation": "O Lord thou art supreme and Immortal. 167.!",
      "punjabiViakhya": "ਤੂੰ ਸਭ ਤੋਂ ਵੱਡਾ ਅਤੇ ਕਾਲ ਤੋਂ ਪਰੇ ਹੈਂ ॥੧੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "गुर बर अकाल ॥१६७॥",
      "sourceLineId": "74886",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਘਰ ਘਰਿ ਪ੍ਰਨਾਮ ॥",
      "transliteration": "ghar ghar pranaam ||",
      "translation": "O Lord !  Thou art honoured in every house. O Lord !",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੈਨੂੰ ਘਰ ਘਰ ਵਿਚ ਪ੍ਰਨਾਮ ਹੁੰਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "घर घरि प्रनाम ॥",
      "sourceLineId": "74887",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚਿਤ ਚਰਨ ਨਾਮ ॥",
      "transliteration": "chit charan naam ||",
      "translation": "Thy Feet and Thy Name are meditated in every heart.",
      "punjabiViakhya": "(ਹਰ ਇਕ ਜੀਵ ਦੇ) ਚਿੱਤ ਵਿਚ ਤੇਰੇ ਚਰਨਾ ਦਾ ਧਿਆਨ ਅਤੇ ਤੇਰੇ ਨਾਮ ਦਾ ਸਿਮਰਨ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "चित चरन नाम ॥",
      "sourceLineId": "74888",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਨਛਿੱਜ ਗਾਤ ॥",
      "transliteration": "anachhi'j gaat ||",
      "translation": "O Lord !  Thy body never becomes old. O Lord !",
      "punjabiViakhya": "ਤੇਰਾ ਸ਼ਰੀਰ ਕਦੇ ਨਾਸ਼ ਹੋਣ ਵਾਲਾ ਨਹੀਂ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "अनछिज्ज गात ॥",
      "sourceLineId": "74889",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਆਜਿਜ ਨ ਬਾਤ ॥੧੬੮॥",
      "transliteration": "aajij na baat ||168||",
      "translation": "Thou art never subservient to anybody. 168.",
      "punjabiViakhya": "ਤੂੰ ਕਿਸੇ ਗੱਲ ਲਈ ਵੀ ਅਸਮਰਥ (ਆਜਿਜ਼) ਨਹੀਂ ॥੧੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "आजिज न बात ॥१६८॥",
      "sourceLineId": "74890",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਨਝੰਝ ਗਾਤ ॥",
      "transliteration": "anajha(n)jh gaat ||",
      "translation": "O Lord !  Thy body is ever steady. O Lord !",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਅਡੋਲ ਸ਼ਰੀਰ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "अनझंझ गात ॥",
      "sourceLineId": "74891",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਨਰੰਜ ਬਾਤ ॥",
      "transliteration": "anara(n)j baat ||",
      "translation": "Thou art free from rage.",
      "punjabiViakhya": "ਤੂੰ ਕਿਸੇ ਵੀ ਗੱਲ ਤੇ ਕ੍ਰੋਧਿਤ ਨਹੀਂ ਹੁੰਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "अनरंज बात ॥",
      "sourceLineId": "74892",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਨਟੁਟ ਭੰਡਾਰ ॥",
      "transliteration": "anaTuT bha(n)ddaar ||",
      "translation": "O Lord !  Thy store is inexhaustible. O Lord !",
      "punjabiViakhya": "ਤੂੰ ਅਮੁਕ ਭੰਡਾਰ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "अनटुट भंडार ॥",
      "sourceLineId": "74893",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਨਠਟ ਅਪਾਰ ॥੧੬੯॥",
      "transliteration": "anaThaT apaar ||169||",
      "translation": "Thou art uninstalled and boundless. 169.",
      "punjabiViakhya": "ਤੂੰ ਨਾ ਸਥਾਪਿਤ ਕੀਤਾ ਜਾ ਸਕਣ ਵਾਲਾ ਅਪਾਰ ਹੈਂ ॥੧੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "अनठट अपार ॥१६९॥",
      "sourceLineId": "74894",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਆਡੀਠ ਧਰਮ ॥",
      "transliteration": "aaddeeTh dharam ||",
      "translation": "O Lord !  Thy Law is imperceptible. O Lord !",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਅਦ੍ਰਿਸ਼ਟ ਕਰਤੱਵ ('ਧਰਮ') ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "आडीठ धरम ॥",
      "sourceLineId": "74895",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਤਿ ਢੀਠ ਕਰਮ ॥",
      "transliteration": "at ddeeTh karam ||",
      "translation": "Thy actions are most fearless.",
      "punjabiViakhya": "ਤੇਰੇ ਕਰਮ ਬੜੇ ਦ੍ਰਿੜ੍ਹ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "अति ढीठ करम ॥",
      "sourceLineId": "74896",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਣਬ੍ਰਣ ਅਨੰਤ ॥",
      "transliteration": "anabran ana(n)t ||",
      "translation": "O Lord !  Thou art Invincible and Infinite. O Lord !",
      "punjabiViakhya": "ਤੈਨੂੰ ਕੋਈ ਸਟ ਨਹੀਂ ਮਾਰ ਸਕਦਾ, ਤੂੰ ਅਨੰਤ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "अणब्रण अनंत ॥",
      "sourceLineId": "74897",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਦਾਤਾ ਮਹੰਤ ॥੧੭੦॥",
      "transliteration": "dhaataa maha(n)t ||170||",
      "translation": "Thou art the Supreme Donor. 170.",
      "punjabiViakhya": "ਤੂੰ ਮਹਾਨ ਦਾਤਾ ਹੈਂ ॥੧੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "दाता महंत ॥१७०॥",
      "sourceLineId": "74898",
      "sourceShabadId": "7419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਰਿਬੋਲਮਨਾ ਛੰਦ ॥ ਤ੍ਵ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "haribolamanaa chha(n)dh || tavai prasaadh ||",
      "translation": "HARIBOLMANA STANZA, BY THE GRACE",
      "punjabiViakhya": "ਹਰਿਬੋਲਮਨਾ ਛੰਦ: ਤੇਰੀ ਕ੍ਰਿਪਾ ਨਾਲ:",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "हरिबोलमना छंद ॥ त्व प्रसादि ॥",
      "sourceLineId": "74899",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਰੁਣਾਲਯ ਹੈਂ ॥",
      "transliteration": "karunaalay hai(n) ||",
      "translation": "O Lord! Thou art the house of Mercy!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਕ੍ਰਿਪਾ ('ਕਰੁਣਾ') ਦਾ ਘਰ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "करुणालय हैं ॥",
      "sourceLineId": "74900",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਰਿ ਘਾਲਯ ਹੈਂ ॥",
      "transliteration": "ar ghaalay hai(n) ||",
      "translation": "Lord! Thou art The Destroyer of enemies!",
      "punjabiViakhya": "ਤੂੰ ਦੁਸ਼ਮਣਾ ਦਾ ਨਾਸ਼ ਕਰਨ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "अरि घालय हैं ॥",
      "sourceLineId": "74901",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਖਲ ਖੰਡਨ ਹੈਂ ॥",
      "transliteration": "khal kha(n)ddan hai(n) ||",
      "translation": "O Lord! Thou art the killer of evil persons!",
      "punjabiViakhya": "ਤੂੰ ਦੁਸ਼ਟਾ ਨੂੰ ਮਾਰਨ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "खल खंडन हैं ॥",
      "sourceLineId": "74902",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਮਹਿ ਮੰਡਨ ਹੈਂ ॥੧੭੧॥",
      "transliteration": "meh ma(n)ddan hai(n) ||171||",
      "translation": "O Lord! Thou art the ornamentation of Earth! 171",
      "punjabiViakhya": "ਤੂੰ ਧਰਤੀ ਦਾ ਸ਼ਿੰਗਾਰ ਹੈਂ ॥੧੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "महि मंडन हैं ॥१७१॥",
      "sourceLineId": "74903",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜਗਤੇਸ੍ਵਰ ਹੈਂ ॥",
      "transliteration": "jagatesavair hai(n) ||",
      "translation": "O Lord! Thou art the Master of the universe!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਜਗਤ ਦਾ ਸੁਆਮੀ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "जगतेस्वर हैं ॥",
      "sourceLineId": "74904",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਪਰਮੇਸ੍ਵਰ ਹੈਂ ॥",
      "transliteration": "paramesavair hai(n) ||",
      "translation": "O Lord! Thou art the supreme Ishvara!",
      "punjabiViakhya": "ਤੂੰ ਸ੍ਰੇਸ਼ਠ ਈਸ਼ਵਰ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 9,
      "hindi": "",
      "hindiTransliteration": "परमेस्वर हैं ॥",
      "sourceLineId": "74905",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0009_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਲਿ ਕਾਰਣ ਹੈਂ ॥",
      "transliteration": "kal kaaran hai(n) ||",
