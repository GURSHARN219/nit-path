      "lineIndex": 38,
      "gurmukhi": "ਅਲੈ ॥",
      "transliteration": "alai ||",
      "translation": "O Indestructible Lord !",
      "punjabiViakhya": "ਅਵਿਨਾਸ਼ੀ,",
