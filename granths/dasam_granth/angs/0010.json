    },
    {
      "id": "dasam_ang_0010_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਕਾਸ ॥੧੯੦॥",
      "transliteration": "akaas ||190||",
      "translation": "O All-Pervasive Lord ! 190",
      "punjabiViakhya": "ਸੋਗ ('ਕਾਸ') ਰਹਿਤ ਹੈਂ ॥੧੯੦॥",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "अकास ॥१९०॥",
      "sourceLineId": "74981",
      "sourceShabadId": "7422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਗੰਜ ॥",
      "transliteration": "aga(n)j ||",
      "translation": "Eternal Lord !",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ! ਤੂੰ) ਨਾ ਨਸ਼ਟ ਹੋਣ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "अगंज ॥",
      "sourceLineId": "74982",
