    },
    {
      "id": "dasam_ang_0010_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਭੈ ॥",
      "transliteration": "abhai ||",
      "translation": "O Fearless Lord !",
      "punjabiViakhya": "ਨਿਰਭੈ",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "अभै ॥",
