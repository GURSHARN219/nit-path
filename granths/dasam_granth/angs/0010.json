      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਨਾਸ ॥",
      "transliteration": "anaas ||",
      "translation": "O Indestructible Lord !",
      "punjabiViakhya": "ਨਾਸ਼-ਰਹਿਤ,",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
