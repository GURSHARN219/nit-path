      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਭੰਜ ॥",
      "transliteration": "abha(n)j ||",
      "translation": "O Indivisible Lord !",
      "punjabiViakhya": "ਨਾ ਟੁੱਟਣ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "अभंज ॥",
      "sourceLineId": "74983",
      "sourceShabadId": "7422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਲੱਖ ॥",
      "transliteration": "ala'kh ||",
      "translation": "O Unknowable Lord !",
      "punjabiViakhya": "ਨਾ ਜਾਣਿਆ ਜਾ ਸਕਣ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "अलक्ख ॥",
      "sourceLineId": "74984",
      "sourceShabadId": "7422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਭੱਖ ॥੧੯੧॥",
      "transliteration": "abha'kh ||191||",
      "translation": "O Uninflammable Lord ! 191",
      "punjabiViakhya": "ਅਤੇ ਖਾਣ ਦੀ ਲੋੜ ਤੋਂ ਮੁਕਤ ਹੈਂ ॥੧੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "अभक्ख ॥१९१॥",
