{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 10,
  "lineCount": 81,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0010_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਰ ਨਾਇਕ ਹੈਂ ॥",
      "transliteration": "nar naik hai(n) ||",
      "translation": "O Lord! Thou art the Master of men!",
      "punjabiViakhya": "ਤੂੰ ਮਨੁੱਖਾ ਦਾ ਨਾਇਕ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "नर नाइक हैं ॥",
      "sourceLineId": "74938",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਖਲ ਘਾਇਕ ਹੈਂ ॥੧੮੦॥",
      "transliteration": "khal ghaik hai(n) ||180||",
      "translation": "O Lord! Thou art the destroyer of evil persons! 180",
      "punjabiViakhya": "ਤੂੰ ਦੁਸ਼ਟਾ ਦਾ ਸੰਘਾਰਕ ਹੈਂ ॥੧੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "खल घाइक हैं ॥१८०॥",
      "sourceLineId": "74939",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਿਸ੍ਵੰਭਰ ਹੈਂ ॥",
      "transliteration": "bisavai(n)bhar hai(n) ||",
      "translation": "O Lord! Thou art the Nourisher of the world!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਸ੍ਰਿਸ਼ਟੀ ਦਾ ਭਰਨ-ਪੋਸ਼ਣ ਕਰਨ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "बिस्वंभर हैं ॥",
      "sourceLineId": "74940",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਰੁਣਾਲਯ ਹੈਂ ॥",
      "transliteration": "karunaalay hai(n) ||",
      "translation": "O Lord! Thou art the House of Mercy!",
      "punjabiViakhya": "ਤੂੰ ਕ੍ਰਿਪਾ (ਕਰੁਣਾ) ਦਾ ਘਰ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "करुणालय हैं ॥",
      "sourceLineId": "74941",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨ੍ਰਿਪ ਨਾਇਕ ਹੈਂ ॥",
      "transliteration": "nirap naik hai(n) ||",
      "translation": "O Lord! Thou art the Lord of the kings!",
      "punjabiViakhya": "ਤੂੰ ਰਾਜਿਆਂ ਦਾ ਸੁਆਮੀ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "नृप नाइक हैं ॥",
      "sourceLineId": "74942",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਰਬ ਪਾਇਕ ਹੈਂ ॥੧੮੧॥",
      "transliteration": "sarab paik hai(n) ||181||",
      "translation": "O Lord! Thou art the Protector of all! 181",
      "punjabiViakhya": "ਤੂੰ ਸਭ ਨੂੰ ਪਾਲਣ ਵਾਲਾ (ਰਖਿਅਕ) ਹੈਂ ॥੧੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "सरब पाइक हैं ॥१८१॥",
      "sourceLineId": "74943",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭਵ ਭੰਜਨ ਹੈਂ ॥",
      "transliteration": "bhav bha(n)jan hai(n) ||",
      "translation": "O Lord! Thou art the destroyer of the cycle of transmigration!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਜਨਮ-ਮਰਨ ਦੇ ਚੱਕਰ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "भव भंजन हैं ॥",
      "sourceLineId": "74944",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਰਿ ਗੰਜਨ ਹੈਂ ॥",
      "transliteration": "ar ga(n)jan hai(n) ||",
      "translation": "O Lord! Thou art the conqueror of enemies!",
      "punjabiViakhya": "ਤੂੰ ਵੈਰੀਆਂ ਨੂੰ ਮਾਰਨ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "अरि गंजन हैं ॥",
      "sourceLineId": "74945",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰਿਪੁ ਤਾਪਨ ਹੈਂ ॥",
      "transliteration": "rip taapan hai(n) ||",
      "translation": "O Lord! Thou causest suffering to the enemies!",
      "punjabiViakhya": "ਤੂੰ ਦੁਸ਼ਮਣਾ ਨੂੰ ਦੁਖ ਦੇਣ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "रिपु तापन हैं ॥",
      "sourceLineId": "74946",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਪੁ ਜਾਪਨ ਹੈਂ ॥੧੮੨॥",
      "transliteration": "jap jaapan hai(n) ||182||",
      "translation": "O Lord! Thou makest others to repeat Thy Name! 182",
      "punjabiViakhya": "ਤੂੰ ਖੁਦ ਆਪਣਾ ਜਪ ਜਪਾਉਣ ਵਾਲਾ ਵੀ ਹੈਂ ॥੧੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "जपु जापन हैं ॥१८२॥",
      "sourceLineId": "74947",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਕਲੰ ਕ੍ਰਿਤ ਹੈਂ ॥",
      "transliteration": "akala(n) kirat hai(n) ||",
      "translation": "O Lord! Thou art free from blemishes!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਕਲੰਕ-ਰਹਿਤ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "अकलं कृत हैं ॥",
      "sourceLineId": "74948",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਰਬਾ ਕ੍ਰਿਤ ਹੈਂ ॥",
      "transliteration": "sarabaa kirat hai(n) ||",
      "translation": "O Lord! All are Thy Forms!",
      "punjabiViakhya": "ਤੂੰ ਸਭ ਦਾ ਕਰਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "सरबा कृत हैं ॥",
      "sourceLineId": "74949",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਰਤਾ ਕਰ ਹੈਂ ॥",
      "transliteration": "karataa kar hai(n) ||",
      "translation": "O Lord! Thou art the Creator of the creators!",
      "punjabiViakhya": "ਤੂੰ ਕਰਤਿਆਂ ਦਾ ਵੀ ਕਰਤਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "करता कर हैं ॥",
      "sourceLineId": "74950",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹਰਤਾ ਹਰਿ ਹੈਂ ॥੧੮੩॥",
      "transliteration": "harataa har hai(n) ||183||",
      "translation": "O Lord! Thou art the Destroyer of the destroyers! 183",
      "punjabiViakhya": "ਤੂੰ ਮਾਰਨ ਵਾਲਿਆਂ ਦਾ ਵੀ ਮਾਰਨ ਵਾਲਾ ਹੈਂ ॥੧੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "हरता हरि हैं ॥१८३॥",
      "sourceLineId": "74951",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪਰਮਾਤਮ ਹੈਂ ॥",
      "transliteration": "paramaatam hai(n) ||",
      "translation": "O Lord! Thou art the Supreme Soul!",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੂੰ ਪਾਰਬ੍ਰਹਮ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "परमातम हैं ॥",
      "sourceLineId": "74952",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਰਬਾਤਮ ਹੈਂ ॥",
      "transliteration": "sarabaatam hai(n) ||",
      "translation": "Lord! Thou art the origin of all the souls!",
      "punjabiViakhya": "ਤੂੰ ਸਭ ਦੀ ਆਤਮਾ (ਜਾ ਸਭ ਵਿਚ ਵਿਆਪਤ) ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "सरबातम हैं ॥",
      "sourceLineId": "74953",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਆਤਮ ਬਸ ਹੈਂ ॥",
      "transliteration": "aatam bas hai(n) ||",
      "translation": "O Lord! Thou art controlled by Thyself!",
      "punjabiViakhya": "ਤੂੰ ਆਪਣੇ ਹੀ ਵਸ ਵਿਚ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "आतम बस हैं ॥",
      "sourceLineId": "74954",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਸ ਕੇ ਜਸ ਹੈਂ ॥੧੮੪॥",
      "transliteration": "jas ke jas hai(n) ||184||",
      "translation": "O Lord! Thou art not subject! 184",
      "punjabiViakhya": "ਤੂੰ ਯਸ਼ਾ ਦਾ ਵੀ ਯਸ਼ ਹੈਂ ॥੧੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "जस के जस हैं ॥१८४॥",
      "sourceLineId": "74955",
      "sourceShabadId": "7420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "74956",
      "sourceShabadId": "7421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਮੋ ਸੂਰਜ ਸੂਰਜੇ ਨਮੋ ਚੰਦ੍ਰ ਚੰਦ੍ਰੇ ॥",
      "transliteration": "namo sooraj sooraje namo cha(n)dhr cha(n)dhre ||",
      "translation": "Salutation to Thee O Sun of suns! Salutation to Thee O Moon of moons!",
      "punjabiViakhya": "ਹੇ ਸੂਰਜਾ ਦੇ ਸੂਰਜ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ; ਹੇ ਚੰਦ੍ਰਮਿਆਂ ਦੇ ਚੰਦ੍ਰਮਾ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "नमो सूरज सूरजे नमो चंद्र चंद्रे ॥",
      "sourceLineId": "74957",
      "sourceShabadId": "7421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਮੋ ਰਾਜ ਰਾਜੇ ਨਮੋ ਇੰਦ੍ਰ ਇੰਦ੍ਰੇ ॥",
      "transliteration": "namo raaj raaje namo i(n)dhr i(n)dhre ||",
      "translation": "Salutation to Thee O King of kings! Salutation to thee O Indra of Indras!",
      "punjabiViakhya": "ਹੇ ਰਾਜਿਆਂ ਦੇ ਰਾਜੇ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ; ਹੇ ਇੰਦਰਾ ਦੇ ਇੰਦਰ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "नमो राज राजे नमो इंद्र इंद्रे ॥",
      "sourceLineId": "74958",
      "sourceShabadId": "7421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਮੋ ਅੰਧਕਾਰੇ ਨਮੋ ਤੇਜ ਤੇਜੇ ॥",
      "transliteration": "namo a(n)dhakaare namo tej teje ||",
      "translation": "Salutation to Thee O Creator of pitch darkness! Salutation to Thee O Light of lights.!",
      "punjabiViakhya": "ਹੇ ਅੰਧਕਾਰ ਸਰੂਪ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ; ਹੇ ਤੇਜਾ ਦੇ ਤੇਜ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "नमो अंधकारे नमो तेज तेजे ॥",
      "sourceLineId": "74959",
      "sourceShabadId": "7421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਮੋ ਬ੍ਰਿੰਦ ਬ੍ਰਿੰਦੇ ਨਮੋ ਬੀਜ ਬੀਜੇ ॥੧੮੫॥",
      "transliteration": "namo bira(n)dh bira(n)dhe namo beej beeje ||185||",
      "translation": "Salutation to Thee O Greatest of the great (multitudes) Salutation to Three O Subtlest of the subtle ! 185",
      "punjabiViakhya": "ਹੇ ਸਮੂਹਾ ਦੇ ਸਮੂਹ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ; ਹੇ (ਸੂਖਮ) ਬੀਜਾ ਦੇ ਬੀਜ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ ॥੧੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "नमो बृंद बृंदे नमो बीज बीजे ॥१८५॥",
      "sourceLineId": "74960",
      "sourceShabadId": "7421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਮੋ ਰਾਜਸੰ ਤਾਮਸੰ ਸਾਂਤ ਰੂਪੇ ॥",
      "transliteration": "namo raajasa(n) taamasa(n) saa(n)t roope ||",
      "translation": "Salutation to Thee O embodiment of peace! Salutation to Thee O Entity bearing three modes!",
      "punjabiViakhya": "ਹੇ ਰਜੋ, ਤਮੋ ਅਤੇ ਸਤੋ ਰੂਪ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "नमो राजसं तामसं साँत रूपे ॥",
      "sourceLineId": "74961",
      "sourceShabadId": "7421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਮੋ ਪਰਮ ਤੱਤੰ ਅਤੱਤੰ ਸਰੂਪੇ ॥",
      "transliteration": "namo param ta'ta(n) ata'ta(n) saroope ||",
      "translation": "Salutation to Thee O Supreme Essence and Elementless Entity!",
      "punjabiViakhya": "ਹੇ ਪਰਮ ਤੱਤ੍ਵ ਅਤੇ ਪੰਜ ਤੱਤ੍ਵਾ ਤੋਂ ਰਹਿਤ ਸਰੂਪ ਵਾਲੇ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "नमो परम तत्तं अतत्तं सरूपे ॥",
      "sourceLineId": "74962",
      "sourceShabadId": "7421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਮੋ ਜੋਗ ਜੋਗੇ ਨਮੋ ਗਿਆਨ ਗਿਆਨੇ ॥",
      "transliteration": "namo jog joge namo giaan giaane ||",
      "translation": "Salutation to Thee O Fountain of all Yogas! Salutation to Thee O Fountain of all knowledge!",
      "punjabiViakhya": "ਹੇ ਜੋਗਾ ਦੇ ਵੀ ਜੋਗ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ; ਹੇ ਗਿਆਨਾ ਦੇ ਵੀ ਗਿਆਨ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "नमो जोग जोगे नमो गिआन गिआने ॥",
      "sourceLineId": "74963",
      "sourceShabadId": "7421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਮੋ ਮੰਤ੍ਰ ਮੰਤ੍ਰੇ ਨਮੋ ਧਿਆਨ ਧਿਆਨੇ ॥੧੮੬॥",
      "transliteration": "namo ma(n)tr ma(n)tre namo dhiaan dhiaane ||186||",
      "translation": "Salutation to Thee O Supreme Mantra! Salutation to Thee O highest meditation 186.",
      "punjabiViakhya": "ਹੇ ਮੰਤ੍ਰਾ ਦੇ ਵੀ ਮੰਤ੍ਰ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ; ਹੇ ਧਿਆਨਾ ਦੇ ਵੀ ਧਿਆਨ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ ॥੧੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "नमो मंत्र मंत्रे नमो धिआन धिआने ॥१८६॥",
      "sourceLineId": "74964",
      "sourceShabadId": "7421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਮੋ ਜੁਧ ਜੁਧੇ ਨਮੋ ਗਿਆਨ ਗਿਆਨੇ ॥",
      "transliteration": "namo judh judhe namo giaan giaane ||",
      "translation": "Salutation to Thee O Conqueror of wars! Salutation to Thee O Fountain of all knowledge!",
      "punjabiViakhya": "ਹੇ ਯੁੱਧਾ ਦੇ ਯੁੱਧ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ; ਹੇ ਗਿਆਨਾ ਦੇ ਵੀ ਗਿਆਨ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "नमो जुध जुधे नमो गिआन गिआने ॥",
      "sourceLineId": "74965",
      "sourceShabadId": "7421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਮੋ ਭੋਜ ਭੋਜੇ ਨਮੋ ਪਾਨ ਪਾਨੇ ॥",
      "transliteration": "namo bhoj bhoje namo paan paane ||",
      "translation": "Salutation to Thee O Essence of Food ! Salutation to Thee O Essence of Warter!",
      "punjabiViakhya": "ਹੇ ਭੋਜਾ ਦੇ ਵੀ ਭੋਜ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ; ਤੇ ਪੇਯਾ (ਪੀਣਯੋਗ ਪਦਾਰਥ) ਦੇ ਪੇਯ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "नमो भोज भोजे नमो पान पाने ॥",
      "sourceLineId": "74966",
      "sourceShabadId": "7421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਮੋ ਕਲਹ ਕਰਤਾ ਨਮੋ ਸਾਂਤ ਰੂਪੇ ॥",
      "transliteration": "namo kaleh karataa namo saa(n)t roope ||",
      "translation": "Salutation to Thee O Originator of Food! Salutation to Thee O Embodiment of Peace!",
      "punjabiViakhya": "ਹੇ ਕਲਹ ਦੇ ਕਾਰਨ ਸਰੂਪ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ; ਹੇ ਸ਼ਾਤੀ-ਸਰੂਪ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "नमो कलह करता नमो साँत रूपे ॥",
      "sourceLineId": "74967",
      "sourceShabadId": "7421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਮੋ ਇੰਦ੍ਰ ਇੰਦ੍ਰੇ ਅਨਾਦੰ ਬਿਭੂਤੇ ॥੧੮੭॥",
      "transliteration": "namo i(n)dhr i(n)dhre anaadha(n) bibhoote ||187||",
      "translation": "Salutation to Thee O Indra of Indras! Salutation to Thee O Beginningless Effulgence! 187.",
      "punjabiViakhya": "ਹੇ ਇੰਦਰਾ ਦੇ ਵੀ ਇੰਦਰ, (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ; ਹੇ ਆਦਿ-ਰਹਿਤ ਸੰਪੱਤੀ ਵਾਲੇ! (ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ) ॥੧੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "नमो इंद्र इंद्रे अनादं बिभूते ॥१८७॥",
      "sourceLineId": "74968",
      "sourceShabadId": "7421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਲੰਕਾਰ ਰੂਪੇ ਅਲੰਕਾਰ ਅਲੰਕੇ ॥",
      "transliteration": "kala(n)kaar roope ala(n)kaar ala(n)ke ||",
      "translation": "Salutation to Thee O Entity inimical to blemishes! Salutation to Thee O Ornamentation of the ornaments",
      "punjabiViakhya": "ਹੇ ਦੋਸ਼ਾ ਤੋਂ ਮੁਕਤ ਰੂਪ ਵਾਲੇ! (ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ) ਹੇ ਸ਼ਿੰਗਾਰਾ ਦੇ ਵੀ ਸ਼ਿੰਗਾਰ! (ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ);",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "कलंकार रूपे अलंकार अलंके ॥",
      "sourceLineId": "74969",
      "sourceShabadId": "7421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਮੋ ਆਸ ਆਸੇ ਨਮੋ ਬਾਂਕ ਬੰਕੇ ॥",
      "transliteration": "namo aas aase namo baa(n)k ba(n)ke ||",
      "translation": "Salutation to Thee O Fulfiller of hopes! Salutation to Thee O Most Beautiful!",
      "punjabiViakhya": "ਹੇ ਮੁਖਾ ਦੇ ਵੀ ਮੁਖ (ਜਾ ਆਸ਼ਾਵਾ ਦੇ ਵੀ ਆਸ਼ਯ); (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ; ਹੇ ਬਾਣੀ ('ਬਾਕ') ਦੇ ਵੀ ਸ਼ਿੰਗਾਰ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "नमो आस आसे नमो बाँक बंके ॥",
      "sourceLineId": "74970",
      "sourceShabadId": "7421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਭੰਗੀ ਸਰੂਪੇ ਅਨੰਗੀ ਅਨਾਮੇ ॥",
      "transliteration": "abha(n)gee saroope ana(n)gee anaame ||",
      "translation": "Salutation to Thee O Eternal Entity, Limbless and Nameless!",
      "punjabiViakhya": "ਹੇ ਨਾਸ਼-ਰਹਿਤ ਰੂਪ ਵਾਲੇ! ਹੇ ਨਿਰਾਕਾਰ ਅਤੇ ਨਾਮ-ਰਹਿਤ ਰੂਪ ਵਾਲੇ! (ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ);",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "अभंगी सरूपे अनंगी अनामे ॥",
      "sourceLineId": "74971",
      "sourceShabadId": "7421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤ੍ਰਿਭੰਗੀ ਤ੍ਰਿਕਾਲੇ ਅਨੰਗੀ ਅਕਾਮੇ ॥੧੮੮॥",
      "transliteration": "tirabha(n)gee tirakaale ana(n)gee akaame ||188||",
      "translation": "Salutation to Thee O Destroyer of three worlds in three tenses! Salutation to O Limbless and Desireless Lord! 188.",
      "punjabiViakhya": "ਹੇ ਤਿੰਨਾ ਲੋਕਾ ਨੂੰ ਤਿੰਨਾ ਕਾਲਾ ਵਿਚ ਨਸ਼ਟ ਕਰਨ ਵਾਲੇ! ਹੇ ਦੇਹ-ਰਹਿਤ! ਹੇ ਕਾਮਨਾਵਾ ਤੋਂ ਮੁਕਤ! (ਤੈਨੂੰ ਨਮਸਕਾਰ ਹੈ) ॥੧੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "तृभंगी तृकाले अनंगी अकामे ॥१८८॥",
      "sourceLineId": "74972",
      "sourceShabadId": "7421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਏਕ ਅਛਰੀ ਛੰਦ ॥",
      "transliteration": "ek achharee chha(n)dh ||",
      "translation": "EK ACHHARI STANZA",
      "punjabiViakhya": "ਏਕ ਅਛਰੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "एक अछरी छंद ॥",
      "sourceLineId": "74973",
      "sourceShabadId": "7422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਜੈ ॥",
      "transliteration": "ajai ||",
      "translation": "O Unconquerable Lord !",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ! ਤੂੰ) ਅਜਿਤ,",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "अजै ॥",
      "sourceLineId": "74974",
