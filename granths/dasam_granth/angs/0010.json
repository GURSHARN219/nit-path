      "raag": "Dasam Granth"
    },
    {
      "id": "dasam_ang_0010_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਭੂ ॥",
      "transliteration": "abhoo ||",
      "translation": "O Unborn Lord !",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ! ਤੂੰ) ਅਜਨਮਾ,",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "अभू ॥",
      "sourceLineId": "74978",
