      "gurmukhi": "ਅਜੂ ॥",
      "transliteration": "ajoo ||",
      "translation": "O Perpetual Lord !",
      "punjabiViakhya": "ਅਜੂਨੀ,",
      "source": "DASAM_GRANTH",
      "ang": 10,
      "hindi": "",
      "hindiTransliteration": "अजू ॥",
      "sourceLineId": "74979",
      "sourceShabadId": "7422",
