{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 42,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0042_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਤੇ ਔਲੀਆ ਅੰਬੀਆ ਗੌਸ ਹ੍ਵੈਹੈਂ ॥",
      "transliteration": "jite aaualeeaa a(n)beeaa gauas havaihai(n) ||",
      "translation": "All those Prophets, saints and hermits, who came into being,!",
      "punjabiViakhya": "ਜਿਤਨੇ ਔਲੀਏ, ਅਤੇ ਹੋਰ ਮੁਸਲਮਾਨ ਦਰਵੇਸ਼ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "जिते औलीआ अंबीआ गौस ह्वैहैं ॥",
      "sourceLineId": "76232",
      "sourceShabadId": "7445",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਭੈ ਕਾਲ ਕੇ ਅੰਤ ਦਾੜਾ ਤਲੈ ਹੈਂ ॥੨੯॥",
      "transliteration": "sabhai kaal ke a(n)t dhaaRaa talai hai(n) ||29||",
      "translation": "Were all ultimately crushed under the grinder tooth of KAL! 29",
      "punjabiViakhya": "ਉਹ ਸਭ ਕਾਲ ਦੀਆਂ ਦਾੜਾਂ ਹੇਠਾ ਚਿੱਥੇ ਗਏ ਹਨ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "सभै काल के अंत दाड़ा तलै हैं ॥२९॥",
      "sourceLineId": "76233",
      "sourceShabadId": "7445",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਿਤੇ ਮਾਨਧਾਤਾਦਿ ਰਾਜਾ ਸੁਹਾਏ ॥",
      "transliteration": "jite maanadhaataadh raajaa suhaae ||",
      "translation": "All the glorious kings like Mandhata were all bound down !",
      "punjabiViakhya": "ਜਿਤਨੇ ਵੀ ਮਾਨਧਾਤਾ ਆਦਿ ਸ਼ੋਭਾਸ਼ਾਲੀ ਰਾਜੇ ਹੋਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "जिते मानधातादि राजा सुहाए ॥",
      "sourceLineId": "76234",
      "sourceShabadId": "7445",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਭੈ ਬਾਂਧ ਕੈ ਕਾਲ ਜੇਲੈ ਚਲਾਏ ॥",
      "transliteration": "sabhai baa(n)dh kai kaal jelai chalaae ||",
      "translation": "And thrown in the noose of KAL!",
      "punjabiViakhya": "(ਉਨ੍ਹਾ) ਸਭ ਨੂੰ ਬੰਨ੍ਹ ਕੇ ਕਾਲ ਨੇ ਆਪਣੇ ਅਧੀਨ (ਜੇਲੈ) ਕਰ ਕੇ ਰਖਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "सभै बाँध कै काल जेलै चलाए ॥",
      "sourceLineId": "76235",
      "sourceShabadId": "7445",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਿਨੈ ਨਾਮ ਤਾ ਕੋ ਉਚਾਰੋ ਉਬਾਰੇ ॥",
      "transliteration": "jinai naam taa ko uchaaro ubaare ||",
      "translation": "Those who have remembered the Name of the Lord, have been saved, !",
      "punjabiViakhya": "ਜਿਨ੍ਹਾ ਨੇ ਉਸ ਦਾ ਨਾਮ ਉੱਚਾਰਿਆ ਹੈ, (ਉਨ੍ਹਾ ਦਾ) ਉੱਧਾਰ ਹੋ ਗਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "जिनै नाम ता को उचारो उबारे ॥",
      "sourceLineId": "76236",
      "sourceShabadId": "7445",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਿਨਾ ਸਾਮ ਤਾ ਕੀ ਲਖੇ ਕੋਟ ਮਾਰੇ ॥੩੦॥",
      "transliteration": "binaa saam taa kee lakhe koT maare ||30||",
      "translation": "Without coming under His refuge, millions are considered as having been killed by KAL! 30",
      "punjabiViakhya": "ਬਿਨਾ ਉਸ (ਕਾਲ) ਦੀ ਸ਼ਰਨ ਵਿਚ ਗਿਆ, ਕਰੋੜਾ ਮਾਰੇ ਗਏ ਵੇਖੇ ਹਨ ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "बिना साम ता की लखे कोट मारे ॥३०॥",
      "sourceLineId": "76237",
      "sourceShabadId": "7445",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥ ਤ੍ਵ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "rasaaval chha(n)dh || tavai prasaadh ||",
      "translation": "RASAAVAL STANZA BY THY GRACE",
      "punjabiViakhya": "ਤੇਰੀ ਕ੍ਰਿਪਾ ਨਾਲ: ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥ त्व प्रसादि ॥",
      "sourceLineId": "76238",
      "sourceShabadId": "7446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਚਮੱਕਹਿ ਕ੍ਰਿਪਾਣੰ ॥",
      "transliteration": "chama'keh kirapaana(n) ||",
      "translation": "The sword of KAL glistens",
      "punjabiViakhya": "(ਮਹਾਕਾਲ ਦੇ ਹੱਥ ਵਿਚ) ਤਲਵਾਰ ਚਮਕਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "चमक्कहि कृपाणं ॥",
      "sourceLineId": "76239",
      "sourceShabadId": "7446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਭੂਤੰ ਭਯਾਣੰ ॥",
      "transliteration": "abhoota(n) bhayaana(n) ||",
      "translation": "Which is Non-elemental and terrible.",
      "punjabiViakhya": "ਜੋ ਬਹੁਤ ਹੀ ਭਿਆਨਕ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "अभूतं भयाणं ॥",
      "sourceLineId": "76240",
      "sourceShabadId": "7446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਧੁਨੰ ਨੇਵਰਾਣੰ ॥",
      "transliteration": "dhuna(n) nevaraana(n) ||",
      "translation": "While moving  his anklets rattle",
      "punjabiViakhya": "(ਉਸ ਦੀਆਂ) ਝਾਝਰਾ ਦਾ ਸ਼ਬਦ ਹੁੰਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "धुनं नेवराणं ॥",
      "sourceLineId": "76241",
      "sourceShabadId": "7446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਘੁਰੰ ਘੁੰਘਰਾਣੰ ॥੩੧॥",
      "transliteration": "ghura(n) ghu(n)gharaana(n) ||31||",
      "translation": "And the small bells jingle.31.",
      "punjabiViakhya": "ਅਤੇ ਘੁੰਘਰੂਆਂ ਦੀ ਛਣਕਾਰ ਹੁੰਦੀ ਹੈ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "घुरं घुँघराणं ॥३१॥",
      "sourceLineId": "76242",
      "sourceShabadId": "7446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਚਤੁਰ ਬਾਂਹ ਚਾਰੰ ॥",
      "transliteration": "chatur baa(n)h chaara(n) ||",
      "translation": "He hath four winsome arms and on his head",
      "punjabiViakhya": "ਉਸ ਦੀਆਂ ਚਾਰ ਸੁੰਦਰ ਬਾਹਵਾ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "चतुर बाँह चारं ॥",
      "sourceLineId": "76243",
      "sourceShabadId": "7446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਿਜੂਟੰ ਸੁਧਾਰੰ ॥",
      "transliteration": "nijooTa(n) sudhaara(n) ||",
      "translation": "His long hair have been bound in a lovely knot.",
      "punjabiViakhya": "(ਸਿਰ ਉਤੇ) ਸੁੰਦਰ ਜੂੜਾ ਸਜਿਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "निजूटं सुधारं ॥",
      "sourceLineId": "76244",
      "sourceShabadId": "7446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਗਦਾ ਪਾਸ ਸੋਹੰ ॥",
      "transliteration": "gadhaa paas soha(n) ||",
      "translation": "The mace with him appears splendid",
      "punjabiViakhya": "(ਉਸ) ਕੋਲ ਗਦਾ ਸੁਸ਼ੋਭਿਤ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "गदा पास सोहं ॥",
      "sourceLineId": "76245",
      "sourceShabadId": "7446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਮੰ ਮਾਨ ਮੋਹੰ ॥੩੨॥",
      "transliteration": "jama(n) maan moha(n) ||32||",
      "translation": "Which fascinate the honour of Yama.32.",
      "punjabiViakhya": "ਜੋ ਜਮ ਦੇ ਮਾਨ ਨੂੰ ਮੋਹ ਰਹੀ ਹੈ (ਪ੍ਰਭਾਵਿਤ ਕਰ ਰਹੀ ਹੈ) ॥੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "जमं मान मोहं ॥३२॥",
      "sourceLineId": "76246",
      "sourceShabadId": "7446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੁਭੰ ਜੀਭ ਜੁਆਲੰ ॥",
      "transliteration": "subha(n) jeebh juaala(n) ||",
      "translation": "His tongue red like fire seems magnificent",
      "punjabiViakhya": "ਅੱਗ ਵਾਗ ਜੀਭ ਸੋਭ ਰਹੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "सुभं जीभ जुआलं ॥",
      "sourceLineId": "76247",
      "sourceShabadId": "7446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੁ ਦਾੜ੍ਹਾ ਕਰਾਲੰ ॥",
      "transliteration": "s dhaaRhaa karaala(n) ||",
      "translation": "And his grinder teeth are very frightening.",
      "punjabiViakhya": "ਦਾੜ੍ਹਾ ਬਹੁਤ ਭਿਆਨਕ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "सु दाड़्हा करालं ॥",
      "sourceLineId": "76248",
      "sourceShabadId": "7446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਜੀ ਬੰਬ ਸੰਖੰ ॥",
      "transliteration": "bajee ba(n)b sa(n)kha(n) ||",
      "translation": "His conches and drums resound",
      "punjabiViakhya": "ਧੌਂਸੇ ਅਤੇ ਸੰਖ ਵਜ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "बजी बंब संखं ॥",
      "sourceLineId": "76249",
      "sourceShabadId": "7446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਉਠੇ ਨਾਦੰ ਬੰਖੰ ॥੩੩॥",
      "transliteration": "auThe naadha(n) ba(n)kha(n) ||33||",
      "translation": "Like the thundering sound of the sea. 33.",
      "punjabiViakhya": "(ਉਨ੍ਹਾ ਵਿਚ) ਸਮੁੰਦਰ ਦੀ ਗਰਜ ਵਰਗਾ ਨਾਦ ਨਿਕਲਦਾ ਹੈ ॥੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "उठे नादं बंखं ॥३३॥",
      "sourceLineId": "76250",
      "sourceShabadId": "7446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੁਭੰ ਰੂਪ ਸਿਆਮੰ ॥",
      "transliteration": "subha(n) roop siaama(n) ||",
      "translation": "His dark form looks elegant",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਸਾਵਲਾ ਰੂਪ ਸੋਭ ਰਿਹਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "सुभं रूप सिआमं ॥",
      "sourceLineId": "76251",
      "sourceShabadId": "7446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਹਾ ਸੋਭ ਧਾਮੰ ॥",
      "transliteration": "mahaa sobh dhaama(n) ||",
      "translation": "And is the abode of Great Glory.",
      "punjabiViakhya": "(ਜੋ) ਮਹਾਨ ਸੋਭਾ ਦਾ ਘਰ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "महा सोभ धामं ॥",
      "sourceLineId": "76252",
      "sourceShabadId": "7446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਛਬੇ ਚਾਰੁ ਚਿਤ੍ਰੰ ॥",
      "transliteration": "chhabe chaar chitra(n) ||",
      "translation": "On his face there are lovely delineations",
      "punjabiViakhya": "(ਉਸ ਦਾ ਚਿੱਤਰ) ਸੁੰਦਰ ਚਿੱਤਰ ਵਰਗਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "छबे चारु चित्रं ॥",
      "sourceLineId": "76253",
      "sourceShabadId": "7446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪਰੇਅੰ ਪਵਿਤ੍ਰੰ ॥੩੪॥",
      "transliteration": "parea(n) pavitra(n) ||34||",
      "translation": "Which are superbly holy. 34.",
      "punjabiViakhya": "(ਜੋ ਮਨ ਬਾਣੀ ਤੋਂ) ਪਰੇ (ਅਤਿਅੰਤ) ਪਵਿਤਰ ਹੈ ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "परेअं पवित्रं ॥३४॥",
      "sourceLineId": "76254",
      "sourceShabadId": "7446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "76255",
      "sourceShabadId": "7447",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਿਰੰ ਸੇਤ ਛਤ੍ਰੰ ਸੁ ਸੁਭ੍ਰੰ ਬਿਰਾਜੰ ॥",
      "transliteration": "sira(n) set chhatra(n) su subhra(n) biraaja(n) ||",
      "translation": "On his head there swings the beautiful  lustrous and white canopy",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਸਿਰ ਉਤੇ ਸੁੰਦਰ ਸਫੈਦ ਛਤ੍ਰ ਸੋਭਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "सिरं सेत छत्रं सु सुभ्रं बिराजं ॥",
      "sourceLineId": "76256",
      "sourceShabadId": "7447",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਲਖੇ ਛੈਲ ਛਾਯਾ ਕਰੇ ਤੇਜ ਲਾਜੰ ॥",
      "transliteration": "lakhe chhail chhaayaa kare tej laaja(n) ||",
      "translation": "Seeing whose shadow and considering it winsome , the light feels abashed.",
      "punjabiViakhya": "(ਜਿਸ ਦੀ) ਛਵੀ ਨੂੰ ਵੇਖ ਕੇ ਤੇਜ (ਪ੍ਰਕਾਸ਼) ਵੀ ਲਜਾ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "लखे छैल छाया करे तेज लाजं ॥",
      "sourceLineId": "76257",
      "sourceShabadId": "7447",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਿਸਾਲਲਾਲ ਨੈਨੰ ਮਹਾਰਾਜ ਸੋਹੰ ॥",
      "transliteration": "bisaalalaal naina(n) mahaaraaj soha(n) ||",
      "translation": "The fleshy and red eyes of the God seem magnificent",
      "punjabiViakhya": "(ਉਸ) ਮਹਾਨ ਰਾਜੇ ਦੇ ਵਿਸ਼ਾਲ ਲਾਲ ਲੋਚਨ ਸੋਭਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "बिसाललाल नैनं महाराज सोहं ॥",
      "sourceLineId": "76258",
      "sourceShabadId": "7447",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਢਿਗੰ ਅੰਸੁਮਾਲੰ ਹਸੰ ਕੋਟ ਕ੍ਰੋਹੰ ॥੩੫॥",
      "transliteration": "ddiga(n) a(n)sumaala(n) hasa(n) koT kroha(n) ||35||",
      "translation": "Before whose light millions of suns appear irritated. 35.",
      "punjabiViakhya": "(ਜਿਨ੍ਹਾ ਦੇ) ਸਾਹਮਣੇ ਕਰੋੜਾ ਸੂਰਜ ('ਅੰਸੁਮਾਲੰ') ਹੀਣਤਾ ('ਹਸੰ') ਨੂੰ ਪ੍ਰਾਪਤ ਹੋ ਕੇ ਕ੍ਰਿਝਦੇ ਹਨ (ਅਰਥਾਤ ਆਪਣੀ ਚਮਕ ਗੰਵਾ ਲੈਂਦੇ ਹਨ) ॥੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "ढिगं अंसुमालं हसं कोट क्रोहं ॥३५॥",
      "sourceLineId": "76259",
      "sourceShabadId": "7447",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਹੂੰ ਰੂਪ ਧਾਰੇ ਮਹਾਰਾਜ ਸੋਹੰ ॥",
      "transliteration": "kahoo(n) roop dhaare mahaaraaj soha(n) ||",
      "translation": "Somewhere He appears impressive in the semblance of a Great King",
      "punjabiViakhya": "ਕਿਤੇ (ਉਹ) ਵੱਡੇ ਰਾਜੇ ਦਾ ਰੂਪ ਧਾਰ ਕੇ ਸੋਭ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "कहूँ रूप धारे महाराज सोहं ॥",
      "sourceLineId": "76260",
      "sourceShabadId": "7447",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਹੂੰ ਦੇਵ ਕੰਨਿਆਨ ਕੇ ਮਾਨ ਮੋਹੰ ॥",
      "transliteration": "kahoo(n) dhev ka(n)niaan ke maan moha(n) ||",
      "translation": "Somewhere He allures the minds of apsaras or the daughters of gods.",
      "punjabiViakhya": "ਕਿਤੇ ਅਪੱਛਰਾ ਦੇ ਮਾਨ ਨੂੰ ਮੋਹ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "कहूँ देव कंनिआन के मान मोहं ॥",
      "sourceLineId": "76261",
      "sourceShabadId": "7447",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਹੂੰ ਬੀਰ ਹ੍ਵੈ ਕੈ ਧਰੇ ਬਾਨ ਪਾਨੰ ॥",
      "transliteration": "kahoo(n) beer havai kai dhare baan paana(n) ||",
      "translation": "Somewhere as a warrior He holds the bow in his hand",
      "punjabiViakhya": "ਕਿਤੇ ਸ਼ੂਰਵੀਰ ਹੋ ਕੇ (ਉਸ ਨੇ) ਹੱਥ ਵਿਚ ਬਾਣ ਧਾਰਨ ਕੀਤੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "कहूँ बीर ह्वै कै धरे बान पानं ॥",
      "sourceLineId": "76262",
      "sourceShabadId": "7447",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਹੂੰ ਭੂਪ ਹ੍ਵੈ ਕੈ ਬਜਾਏ ਨਿਸਾਨੰ ॥੩੬॥",
      "transliteration": "kahoo(n) bhoop havai kai bajaae nisaana(n) ||36||",
      "translation": "Somewhere as a king he causes the resounding of his trumpets.36.",
      "punjabiViakhya": "ਕਿਤੇ ਰਾਜਾ ਹੋ ਕੇ ਧੌਂਸਾ ਵਜਾ ਰਿਹਾ ਹੈ ॥੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "कहूँ भूप ह्वै कै बजाए निसानं ॥३६॥",
      "sourceLineId": "76263",
      "sourceShabadId": "7447",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "76264",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਧਨੁਰ ਬਾਨ ਧਾਰੇ ॥",
      "transliteration": "dhanur baan dhaare ||",
      "translation": "He seems bedecked beautifully",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਤੀਰ ਕਮਾਨ ਧਾਰਨ ਕੀਤੀ ਹੋਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "धनुर बान धारे ॥",
      "sourceLineId": "76265",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਛਕੇ ਛੈਲ ਭਾਰੇ ॥",
      "transliteration": "chhake chhail bhaare ||",
      "translation": "Wielding his bow and arrows.",
      "punjabiViakhya": "ਅਤੇ ਸ੍ਰੇਸ਼ਠ ਯੁੱਧ-ਵੀਰ ਵਾਗ ਫਬ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "छके छैल भारे ॥",
      "sourceLineId": "76266",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਲਏ ਖੱਗ ਐਸੇ ॥",
      "transliteration": "le kha'g aaise ||",
      "translation": "He holds the sword",
      "punjabiViakhya": "ਹੱਥ ਵਿਚ ਤਲਵਾਰ ਇੰਜ ਧਾਰਨ ਕੀਤੀ ਹੋਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "लए खग्ग ऐसे ॥",
      "sourceLineId": "76267",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਹਾਂ ਬੀਰ ਜੈਸੇ ॥੩੭॥",
      "transliteration": "mahaa(n) beer jaise ||37||",
      "translation": "Like a great warrior. 37.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕੋਈ ਵੱਡਾ ਸੂਰਮਾ ਹੁੰਦਾ ਹੈ ॥੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "महाँ बीर जैसे ॥३७॥",
      "sourceLineId": "76268",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੁਰੇ ਜੰਗ ਜੋਰੰ ॥",
      "transliteration": "jure ja(n)g jora(n) ||",
      "translation": "He is forcefully engaged in war",
      "punjabiViakhya": "(ਉਹ ਜਦੋਂ ਕਦੇ) ਜ਼ੋਰ ਨਾਲ ਜੰਗ ਵਿਚ ਜੁਟਦਾ ਹੇ",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "जुरे जंग जोरं ॥",
      "sourceLineId": "76269",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਰੇ ਜੱੁਧ ਘੋਰੰ ॥",
      "transliteration": "kare ja'udh ghora(n) ||",
      "translation": "Fighting frightening battles.",
      "punjabiViakhya": "(ਤਾ) ਭਿਆਨਕ ਯੁੱਧ ਕਰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "करे जु्ुध घोरं ॥",
      "sourceLineId": "76270",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਨਿਧਿ ਦਿਆਲੰ ॥",
      "transliteration": "kirapaa nidh dhiaala(n) ||",
      "translation": "He is the treasure of mercy",
      "punjabiViakhya": "(ਉਹ) ਕ੍ਰਿਪਾ ਦਾ ਸਮੁੰਦਰ ਅਤੇ ਦਇਆ ਦਾ ਘਰ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "कृपा निधि दिआलं ॥",
      "sourceLineId": "76271",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਦਾਯੰ ਕ੍ਰਿਪਾਲੰ ॥੩੮॥",
      "transliteration": "sadhaaya(n) kirapaala(n) ||38||",
      "translation": "And ever kind.38.",
      "punjabiViakhya": "(ਉਹ) ਹਮੇਸ਼ਾ ਹੀ ਕ੍ਰਿਪਾਲੂ ਹੈ ॥੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "सदायं कृपालं ॥३८॥",
      "sourceLineId": "76272",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਦਾ ਏਕ ਰੂਪੰ ॥",
      "transliteration": "sadhaa ek roopa(n) ||",
      "translation": "He is always the same (Kinds Lord)",
      "punjabiViakhya": "(ਉਹ) ਸਦਾ ਇਕ ਰੂਪ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "सदा एक रूपं ॥",
      "sourceLineId": "76273",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਭੈ ਲੋਕ ਭੂਪੰ ॥",
      "transliteration": "sabhai lok bhoopa(n) ||",
      "translation": "And the monarch of all.",
      "punjabiViakhya": "(ਉਹ) ਸਾਰਿਆਂ ਲੋਕਾ ਦਾ ਰਾਜਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "सभै लोक भूपं ॥",
      "sourceLineId": "76274",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਜੇਅੰ ਅਜਾਯੰ ॥",
      "transliteration": "ajea(n) ajaaya(n) ||",
      "translation": "He is Unconquerable and birthless",
      "punjabiViakhya": "(ਉਹ) ਜਿਤਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ ਅਤੇ ਜਨਮ ਵਿਚ ਨਹੀਂ ਆਉਾਂਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "अजेअं अजायं ॥",
      "sourceLineId": "76275",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਰਣਿਅੰ ਸਹਾਯੰ ॥੩੯॥",
      "transliteration": "sarania(n) sahaaya(n) ||39||",
      "translation": "And helps those who come under His refuge.39.",
      "punjabiViakhya": "(ਉਹ) ਸ਼ਰਨ ਆਇਆਂ ਦੀ ਸਹਾਇਤਾ ਕਰਦਾ ਹੈ ॥੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "सरणिअं सहायं ॥३९॥",
      "sourceLineId": "76276",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਪੈ ਖੱਗ ਪਾਨੰ ॥",
      "transliteration": "tapai kha'g paana(n) ||",
      "translation": "The sword shines in His hand",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਹੱਥ ਵਿਚ ਤਲਵਾਰ ਤਪ ਰਹੀ ਹੈ (ਅਰਥਾਤ ਚਲਣ ਲਈ ਉਤਾਵਲੀ ਹੈ)",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "तपै खग्ग पानं ॥",
      "sourceLineId": "76277",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮਹਾਂ ਲੋਕ ਦਾਨੰ ॥",
      "transliteration": "mahaa(n) lok dhaana(n) ||",
      "translation": "And He is a Great Donor for the people.",
      "punjabiViakhya": "(ਉਹ) ਲੋਕਾ ਵਿਚ ਵੱਡਾ ਦਾਨੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "महाँ लोक दानं ॥",
      "sourceLineId": "76278",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਭਵਿਖਿਅੰ ਭਵੇਅੰ ॥",
      "transliteration": "bhavikhia(n) bhavea(n) ||",
      "translation": "I salute the Supreme KAL",
      "punjabiViakhya": "ਵਰਤਮਾਨ ਅਤੇ ਭਵਿਖਤ ਕਾਲ ਵਿਚ (ਜਿਸ ਦੇ) ਜੋੜ ਦਾ ਕੋਈ ਨਹੀਂ,",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "भविखिअं भवेअं ॥",
      "sourceLineId": "76279",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਮੋ ਨਿਰਜੁਰੇਅੰ ॥੪੦॥",
      "transliteration": "namo nirajurea(n) ||40||",
      "translation": "Who is unique in the present and shall be unique in future. 40.",
      "punjabiViakhya": "(ਉਸ ਪਰਮ-ਸੱਤਾ ਨੂੰ ਮੈਂ) ਨਮਸਕਾਰ ਕਰਦਾ ਹਾ ॥੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "नमो निरजुरेअं ॥४०॥",
      "sourceLineId": "76280",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਮਧੋ ਮਾਨ ਮੁੰਡੰ ॥",
      "transliteration": "madho maan mu(n)dda(n) ||",
      "translation": "He is the effacer of the pride of the demon Madhu",
      "punjabiViakhya": "ਮਧੁ ਦੈਂਤ ਦੇ ਮਾਨ ਨੂੰ ਖ਼ਤਮ ਕਰਨ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "मधो मान मुँडं ॥",
      "sourceLineId": "76281",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸੁਭੰ ਰੁੰਡ ਝੁੰਡੰ ॥",
      "transliteration": "subha(n) ru(n)dd jhu(n)dda(n) ||",
      "translation": "And the destroyer of the demon Sumbh.",
      "punjabiViakhya": "ਅਤੇ ਧੜਾ ਦੇ ਸਮੂਹ ਵਿਚ ਸੋਭਣ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "सुभं रुँड झुँडं ॥",
      "sourceLineId": "76282",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਿਰੰ ਸੇਤ ਛੱਤ੍ਰੰ ॥",
      "transliteration": "sira(n) set chha'tra(n) ||",
      "translation": "He hath white canopy over His head",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਸਿਰ ਉਤੇ ਸਫੈਦ ਛਤ੍ਰ (ਝੂਲਦਾ ਹੈ)",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "सिरं सेत छत्त्रं ॥",
      "sourceLineId": "76283",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਲਸੰ ਹਾਥ ਅੱਤ੍ਰੰ ॥੪੧॥",
      "transliteration": "lasa(n) haath a'tra(n) ||41||",
      "translation": "And the weapons glisten in His hands.41.",
      "punjabiViakhya": "ਅਤੇ ਹੱਥ ਵਿਚ ਅਸਤ੍ਰ ਲਿਸ਼ਕਦੇ ਹਨ ॥੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "लसं हाथ अत्त्रं ॥४१॥",
      "sourceLineId": "76284",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸੁਣੇ ਨਾਦ ਭਾਰੀ ॥",
      "transliteration": "sune naadh bhaaree ||",
      "translation": "Hearing His loud voice",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਭਾਰੀ ਨਾਦ ਨੂੰ ਸੁਣ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "सुणे नाद भारी ॥",
      "sourceLineId": "76285",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਤ੍ਰਸੇ ਛਤ੍ਰਧਾਰੀ ॥",
      "transliteration": "trase chhatradhaaree ||",
      "translation": "The great monarchs are frightened.",
      "punjabiViakhya": "ਛਤ੍ਰਧਾਰੀ ਰਾਜੇ ਵੀ ਭੈਭੀਤ ਹੋ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "त्रसे छत्रधारी ॥",
      "sourceLineId": "76286",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਦਿਸਾ ਬਸਤ੍ਰ ਰਾਜੰ ॥",
      "transliteration": "dhisaa basatr raaja(n) ||",
      "translation": "He wears elegantly the garments of directions",
      "punjabiViakhya": "ਦਿਸ਼ਾਵਾ ਹੀ (ਉਸ ਦੇ) ਬਸਤ੍ਰ ਹਨ (ਅਰਥਾਤ ਉਹ ਨਗਨ ਹੈ)",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "दिसा बसत्र राजं ॥",
      "sourceLineId": "76287",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਸੁਣੇ ਦੋਖ ਭਾਜੰ ॥੪੨॥",
      "transliteration": "sune dhokh bhaaja(n) ||42||",
      "translation": "And listening to His voice the sorrows run away. 42.",
      "punjabiViakhya": "(ਉਸ ਦਾ ਨਾ) ਸੁਣਦਿਆਂ ਹੀ ਦੋਖ ਭਜ ਜਾਦੇ ਹਨ ॥੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "सुणे दोख भाजं ॥४२॥",
      "sourceLineId": "76288",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਸੁਣੇ ਗੱਦ ਸੱਦੰ ॥",
      "transliteration": "sune ga'dh sa'dha(n) ||",
      "translation": "Hearing His call",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਗਦਾ ਦੀ ਆਵਾਜ਼ ਨੂੰ ਸੁਣ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "सुणे गद्द सद्दं ॥",
      "sourceLineId": "76289",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਅਨੰਤੰ ਬਿਹੱਦੰ ॥",
      "transliteration": "ana(n)ta(n) biha'dha(n) ||",
      "translation": "The infinite happiness is attained.",
      "punjabiViakhya": "ਅਨੰਤ ਅਤੇ ਬੇਹੱਦ (ਡਰ ਪੈਦਾ ਹੋ ਜਾਦਾ ਹੈ)",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "अनंतं बिहद्दं ॥",
      "sourceLineId": "76290",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਘਟਾ ਜਾਣੁ ਸਿਆਮੰ ॥",
      "transliteration": "ghaTaa jaan siaama(n) ||",
      "translation": "He is Shyam in the form of clouds",
      "punjabiViakhya": "ਮਾਨੋ ਕਾਲੀ ਘਟਾ (ਚੜ੍ਹੀ ਹੋਵੇ)",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "घटा जाणु सिआमं ॥",
      "sourceLineId": "76291",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਦੁਤੰ ਅਭਿਰਾਮੰ ॥੪੩॥",
      "transliteration": "dhuta(n) abhiraama(n) ||43||",
      "translation": "And appears beautiful and impressive.43.",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਸ਼ੋਭਾ ਬਹੁਤ ਮਨੋਹਰ ਹੈ ॥੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "दुतं अभिरामं ॥४३॥",
      "sourceLineId": "76292",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਚਤੁਰ ਬਾਹੁ ਚਾਰੰ ॥",
      "transliteration": "chatur baahu chaara(n) ||",
      "translation": "He hath four beautiful arms",
      "punjabiViakhya": "(ਉਸ ਦੀਆਂ) ਸੁੰਦਰ ਚਾਰ ਬਾਹਵਾ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "चतुर बाहु चारं ॥",
      "sourceLineId": "76293",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਕਰੀਟੰ ਸੁ ਧਾਰੰ ॥",
      "transliteration": "kareeTa(n) su dhaara(n) ||",
      "translation": "And is wearing crown on the head.",
      "punjabiViakhya": "ਅਤੇ (ਸਿਰ ਉਤੇ) ਮੁਕਟ ਧਾਰਨ ਕੀਤਾ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "करीटं सु धारं ॥",
      "sourceLineId": "76294",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਗਦਾ ਸੰਖ ਚੱਕ੍ਰੰ ॥",
      "transliteration": "gadhaa sa(n)kh cha'kra(n) ||",
      "translation": "The mace  conch and disc glisten",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਗਦਾ, ਸੰਖ, ਚੱਕਰ",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "गदा संख चक्क्रं ॥",
      "sourceLineId": "76295",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਦਿਪੈ ਕ੍ਰੂਰ ਬਕ੍ਰੰ ॥੪੪॥",
      "transliteration": "dhipai kraoor bakra(n) ||44||",
      "translation": "And seem frightful and resplendent. 44.",
      "punjabiViakhya": "ਅਤੇ ਭਿਆਨਕ ਤੇ ਟੇਢੀਆਂ (ਭਵਾ) ਲਿਸ਼ਕ ਰਹੀਆਂ ਹਨ ॥੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "दिपै क्रूर बक्रं ॥४४॥",
      "sourceLineId": "76296",
      "sourceShabadId": "7448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "naraaj chha(n)dh ||",
      "translation": "NARAAJ STANZA",
      "punjabiViakhya": "ਨਰਾਜ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "नराज छंद ॥",
      "sourceLineId": "76297",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਅਨੂਪ ਰੂਪ ਰਾਜਿਅੰ ॥",
      "transliteration": "anoop roop raajia(n) ||",
      "translation": "The unique beauty appears graceful",
      "punjabiViakhya": "(ਤੇਰਾ) ਅਨੂਪਮ ਰੂਪ ਸੋਭ ਰਿਹਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "अनूप रूप राजिअं ॥",
      "sourceLineId": "76298",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਨਿਹਾਰ ਕਾਮੁ ਲਾਜਿਅੰ ॥",
      "transliteration": "nihaar kaam laajia(n) ||",
      "translation": "And on seeing it the Cupid seems ashamed.",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ) ਵੇਖ ਕੇ ਕਾਮ-ਦੇਵ ਵੀ ਲਜਾ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "निहार कामु लाजिअं ॥",
      "sourceLineId": "76299",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਅਲੋਕ ਲੋਕ ਸੋਭਿਅੰ ॥",
      "transliteration": "alok lok sobhia(n) ||",
      "translation": "In the worlds it has supernatural radiance",
      "punjabiViakhya": "(ਤੇਰੀ) ਅਲੌਕਿਕ (ਸ਼ੋਭਾ) ਲੋਕਾ ਵਿਚ ਸ਼ੁਭਾਇਮਾਨ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "अलोक लोक सोभिअं ॥",
      "sourceLineId": "76300",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਬਿਲੋਕ ਲੋਕ ਲੋਭਿਅੰ ॥੪੫॥",
      "transliteration": "bilok lok lobhia(n) ||45||",
      "translation": "Seeting whichall the people are fascinated. 45.",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਨੂੰ) ਵੇਖ ਕੇ ਲੋਕ ਲੁਭਾਇਮਾਨ ਹੋ ਰਹੇ ਹਨ ॥੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "बिलोक लोक लोभिअं ॥४५॥",
      "sourceLineId": "76301",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਚਮੱਕ ਚੰਦ੍ਰ ਸੀਸਿਯੰ ॥",
      "transliteration": "chama'k cha(n)dhr seesiya(n) ||",
      "translation": "The moon is bearning on his head",
      "punjabiViakhya": "(ਤੇਰੇ) ਸਿਰ ਉਤੇ ਚੰਦ੍ਰਮਾ ਚਮਕ ਰਿਹਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "चमक्क चंद्र सीसियं ॥",
      "sourceLineId": "76302",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0042_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਰਹਿਯੋ ਲਜਾਇ ਈਸਯੰ ॥",
      "transliteration": "rahiyo lajai ieesaya(n) ||",
      "translation": "Seeing which the god Shiva feels shy.",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ) ਵੇਖ ਕੇ ਸ਼ਿਵ ਸ਼ਰਮਿੰਦਾ ਹੋ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 42,
      "hindi": "",
      "hindiTransliteration": "रहियो लजाइ ईसयं ॥",
      "sourceLineId": "76303",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    }
  ]
}
