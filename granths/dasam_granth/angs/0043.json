{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 43,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0043_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੁ ਸੋਭ ਨਾਗ ਭੂਖਣੰ ॥",
      "transliteration": "s sobh naag bhookhana(n) ||",
      "translation": "The ornaments of Nagas bedeck his neck.",
      "punjabiViakhya": "(ਤੂੰ) ਨਾਗਾ ਦੇ ਗਹਿਣੇ ਪਾਏ ਹੋਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "सु सोभ नाग भूखणं ॥",
      "sourceLineId": "76304",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਨੇਕ ਦੁਸਟ ਦੂਖਣੰ ॥੪੬॥",
      "transliteration": "anek dhusaT dhookhana(n) ||46||",
      "translation": "Which have the power of destruction for the tyrants. 46.",
      "punjabiViakhya": "(ਜੋ) ਅਨੇਕ ਦੁਸ਼ਟਾ ਨੂੰ ਦੁਖ ਦੇਣ ਵਾਲੇ ਹਨ ॥੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "अनेक दुसट दूखणं ॥४६॥",
      "sourceLineId": "76305",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕ੍ਰਿਪਾਣ ਪਾਣ ਧਾਰੀਅੰ ॥",
      "transliteration": "kirapaan paan dhaareea(n) ||",
      "translation": "He  who wields the sword in his hand",
      "punjabiViakhya": "(ਤੂੰ) ਹੱਥ ਵਿਚ ਤਲਵਾਰ ਧਾਰਨ ਕੀਤੀ ਹੋਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "कृपाण पाण धारीअं ॥",
      "sourceLineId": "76306",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਰੋਰ ਪਾਪ ਟਾਰੀਅੰ ॥",
      "transliteration": "karor paap Taareea(n) ||",
      "translation": "He is the remover of millions of sins.",
      "punjabiViakhya": "(ਜੋ) ਕਰੋੜਾ ਪਾਪਾ ਨੂੰ ਹਟਾ ਦਿੰਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "करोर पाप टारीअं ॥",
      "sourceLineId": "76307",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗਦਾ ਗ੍ਰਿਸਟ ਪਾਣਿਯੰ ॥",
      "transliteration": "gadhaa girasaT paaniya(n) ||",
      "translation": "He hath caught hold of the big mace",
      "punjabiViakhya": "(ਤੂੰ) ਹੱਥ ਵਿਚ ਵੱਡੀ ਗਦਾ (ਧਾਰਨ ਕੀਤੀ ਹੋਈ ਹੈ)",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "गदा गृसट पाणियं ॥",
      "sourceLineId": "76308",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਮਾਣ ਬਾਣ ਤਾਣਿਅੰ ॥੪੭॥",
      "transliteration": "kamaan baan taania(n) ||47||",
      "translation": "And hath fitted the arrow in his stretched bow.47.",
      "punjabiViakhya": "ਅਤੇ ਕਮਾਨ ਵਿਚ ਬਾਣ ਤਣਿਆ ਹੋਇਆ ਹੈ ॥੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "कमाण बाण ताणिअं ॥४७॥",
      "sourceLineId": "76309",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਬਦ ਸੰਖ ਬੱਜਿਅੰ ॥",
      "transliteration": "sabadh sa(n)kh ba'jia(n) ||",
      "translation": "There is sound of the blowing conch",
      "punjabiViakhya": "(ਤੇਰੇ) ਸੰਖ ਦੇ ਵਜਣ ਨਾਲ ਪੈਦਾ ਹੋਣ ਵਾਲਾ ਸ਼ਬਦ",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "सबद संख बज्जिअं ॥",
      "sourceLineId": "76310",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਘਣੰਕਿ ਘੁੰਘਰ ਗੱਜਿਅੰ ॥",
      "transliteration": "ghana(n)k ghu(n)ghar ga'jia(n) ||",
      "translation": "And jingling of many small bells.",
      "punjabiViakhya": "ਬਦਲਾ ਦੀ ਗੜਕ ਵਰਗਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "घणंकि घुँघर गज्जिअं ॥",
      "sourceLineId": "76311",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਰਨਿ ਨਾਥ ਤੋਰੀਅੰ ॥",
      "transliteration": "saran naath toreea(n) ||",
      "translation": "O Lord  I have come under Thy Refuge",
      "punjabiViakhya": "ਹੇ ਨਾਥ! (ਮੈਂ) ਤੇਰੀ ਸ਼ਰਨ ਵਿਚ ਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "सरनि नाथ तोरीअं ॥",
      "sourceLineId": "76312",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਉਬਾਰ ਲਾਜ ਮੋਰੀਅੰ ॥੪੮॥",
      "transliteration": "aubaar laaj moreea(n) ||48||",
      "translation": "Protect my honour.48.",
      "punjabiViakhya": "ਮੇਰੀ ਲਾਜ ਰਖ ਲਵੋ ॥੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "उबार लाज मोरीअं ॥४८॥",
      "sourceLineId": "76313",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਨੇਕ ਰੂਪ ਸੋਹੀਅੰ ॥",
      "transliteration": "anek roop soheea(n) ||",
      "translation": "Thou appearest impressive in various forms",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ! ਤੂੰ) ਅਨੇਕ ਰੂਪਾ ਵਿਚ ਸੋਭ ਰਿਹਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "अनेक रूप सोहीअं ॥",
      "sourceLineId": "76314",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਿਸੇਖ ਦੇਵ ਮੋਹੀਅੰ ॥",
      "transliteration": "bisekh dhev moheea(n) ||",
      "translation": "And gods and are the treasure of the Grace alone.",
      "punjabiViakhya": "ਵਿਸ਼ੇਸ਼ ਦੇਵਤਿਆਂ ਨੂੰ ਮੋਹਣ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "बिसेख देव मोहीअं ॥",
      "sourceLineId": "76315",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਦੇਵ ਦੇਵ ਦੇਵਲੰ ॥",
      "transliteration": "adhev dhev dhevala(n) ||",
      "translation": "Thou art the worshipping temple of the demons",
      "punjabiViakhya": "ਦੇਵਤਿਆਂ ਅਤੇ ਦੈਂਤਾ ਦਾ ਪੂਜਾ-ਧਾਮ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "अदेव देव देवलं ॥",
      "sourceLineId": "76316",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਨਿਧਾਨ ਕੇਵਲੰ ॥੪੯॥",
      "transliteration": "kirapaa nidhaan kevala(n) ||49||",
      "translation": "And gods and are the treasure of the Grace alone . 49.",
      "punjabiViakhya": "ਨਿਰੋਲ ਕ੍ਰਿਪਾ ਦਾ ਭੰਡਾਰ ਹੈਂ ॥੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "कृपा निधान केवलं ॥४९॥",
      "sourceLineId": "76317",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੁ ਆਦਿ ਅੰਤ ਏਕਿਅੰ ॥",
      "transliteration": "s aadh a(n)t ekia(n) ||",
      "translation": "He remain uniform from the beginning to end",
      "punjabiViakhya": "(ਤੂੰ) ਆਦਿ ਤੋਂ ਅੰਤ ਤਕ ਇਕ-ਸਮਾਨ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "सु आदि अंत एकिअं ॥",
      "sourceLineId": "76318",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਧਰੇ ਸੁ ਰੂਪ ਅਨੇਕਿਅੰ ॥",
      "transliteration": "dhare su roop anekia(n) ||",
      "translation": "And hath adopted various forms.",
      "punjabiViakhya": "(ਤੂੰ) ਅਨੇਕ ਰੂਪ ਧਾਰਨ ਕੀਤੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "धरे सु रूप अनेकिअं ॥",
      "sourceLineId": "76319",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕ੍ਰਿਪਾਣ ਪਾਣ ਰਾਜਈ ॥",
      "transliteration": "kirapaan paan raajiee ||",
      "translation": "The sword appears impressive in his hand",
      "punjabiViakhya": "(ਤੇਰੇ) ਹੱਥ ਵਿਚ ਕ੍ਰਿਪਾਨ ਸੋਭ ਰਹੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "कृपाण पाण राजई ॥",
      "sourceLineId": "76320",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਿਲੋਕ ਪਾਪ ਭਾਜਈ ॥੫੦॥",
      "transliteration": "bilok paap bhaajiee ||50||",
      "translation": "Seeing which the sins run away.50.",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਪਾਪ ਭਜ ਜਾਦੇ ਹਨ ॥੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "बिलोक पाप भाजई ॥५०॥",
      "sourceLineId": "76321",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਲੰਕ੍ਰਿਤੰ ਸੁ ਦੇਹਯੰ ॥",
      "transliteration": "ala(n)kirata(n) su dhehaya(n) ||",
      "translation": "His body is bedecked with ornaments",
      "punjabiViakhya": "(ਤੇਰੀ) ਦੇਹ (ਗਹਿਣਿਆਂ ਨਾਲ) ਸ਼ਿੰਗਾਰੀ ਹੋਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "अलंकृतं सु देहयं ॥",
      "sourceLineId": "76322",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਨੋ ਮਨੋ ਕਿ ਮੋਹਯੰ ॥",
      "transliteration": "tano mano k mohaya(n) ||",
      "translation": "Which allures both body and mind.",
      "punjabiViakhya": "(ਜੋ) ਤਨ ਅਤੇ ਮਨ ਨੂੰ ਮੋਹ ਲੈਂਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "तनो मनो कि मोहयं ॥",
      "sourceLineId": "76323",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਮਾਣ ਬਾਣ ਧਾਰਹੀ ॥",
      "transliteration": "kamaan baan dhaarahee ||",
      "translation": "The arrow is fitted in the bow",
      "punjabiViakhya": "(ਤੂੰ) ਕਮਾਨ ਵਿਚ ਬਾਣ ਧਰਿਆ ਹੋਇਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "कमाण बाण धारही ॥",
      "sourceLineId": "76324",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਨੇਕ ਸੱਤ੍ਰੁ ਟਾਰਹੀ ॥੫੧॥",
      "transliteration": "anek sa'tr Taarahee ||51||",
      "translation": "Which causes many enemies to flee away.51.",
      "punjabiViakhya": "(ਜੋ) ਅਨੇਕ ਵੈਰੀਆਂ ਨੂੰ ਭਜਾ ਦਿੰਦਾ ਹੈ ॥੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "अनेक सत्त्रु टारही ॥५१॥",
      "sourceLineId": "76325",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਘਮੱਕਿ ਘੁੰਘਰੰ ਸੁਰੰ ॥",
      "transliteration": "ghama'k ghu(n)ghara(n) sura(n) ||",
      "translation": "There is the jingling sound of the small bells",
      "punjabiViakhya": "(ਤੇਰੇ) ਘੁੰਘਰੂਆਂ ਅਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "घमक्कि घुँघरं सुरं ॥",
      "sourceLineId": "76326",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਵੰ ਨਿਨਾਦ ਨੂਪਰੰ ॥",
      "transliteration": "nava(n) ninaadh noopara(n) ||",
      "translation": "And a new sound emanates from the anklets.",
      "punjabiViakhya": "ਨਵੀਆਂ ਝਾਝਰਾ ਦੀ ਆਵਾਜ਼ ਨਿਕਲ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "नवं निनाद नूपरं ॥",
      "sourceLineId": "76327",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪ੍ਰਜ੍ਵਾਲ ਬਿੱਜੁਲੰ ਜ੍ਵਲੰ ॥",
      "transliteration": "prajavaiaal bi'jula(n) javaila(n) ||",
      "translation": "There is light like the blazing fire and lightning",
      "punjabiViakhya": "(ਤੇਰੀ) ਚਮਕ ਬਿਜਲੀ ਦੀ ਜਵਾਲਾ ਵਰਗੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "प्रज्वाल बिज्जुलं ज्वलं ॥",
      "sourceLineId": "76328",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਵਿਤ੍ਰ ਪਰਮ ਨਿਰਮਲੰ ॥੫੨॥",
      "transliteration": "pavitr param niramala(n) ||52||",
      "translation": "Which is highly holy and pure.52.",
      "punjabiViakhya": "(ਜੋ) ਪਰਮ ਪਵਿਤਰ ਅਤੇ ਨਿਰਮਲ ਹੈ ॥੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "पवित्र परम निरमलं ॥५२॥",
      "sourceLineId": "76329",
      "sourceShabadId": "7449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੋਟਕ ਛੰਦ ॥ ਤ੍ਵ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "toTak chha(n)dh || tavai prasaadh ||",
      "translation": "TOTAK STANZA BY THY GRACE",
      "punjabiViakhya": "ਤੇਰੀ ਕ੍ਰਿਪਾ ਨਾਲ: ਤੋਟਕ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "तोटक छंद ॥ त्व प्रसादि ॥",
      "sourceLineId": "76330",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਵ ਨੇਵਰ ਨਾਦ ਸੁਰੰ ਨ੍ਰਿਮਲੰ ॥",
      "transliteration": "nav nevar naadh sura(n) niramala(n) ||",
      "translation": "Various kinds of pure tunes emanate from the anklets.",
      "punjabiViakhya": "(ਤੇਰੀਆਂ) ਝਾਝਰਾ ਵਿਚ ਨਿਰਮਲ ਨਾਦ ਨਿਕਲਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "नव नेवर नाद सुरं नृमलं ॥",
      "sourceLineId": "76331",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮੁਖ ਬਿੱਜੁਲ ਜ੍ਵਾਲ ਘਣੰ ਪ੍ਰਜੁਲੰ ॥",
      "transliteration": "mukh bi'jul javaiaal ghana(n) prajula(n) ||",
      "translation": "The face appears like the in blaze of lightning the dark clouds.",
      "punjabiViakhya": "(ਤੇਰਾ) ਮੁਖ ਬਦਲਾ ਦੀ ਬਿਜਲੀ ਦੀ ਅੱਗ ਵਾਗ ਲਿਸ਼ਕਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "मुख बिज्जुल ज्वाल घणं प्रजुलं ॥",
      "sourceLineId": "76332",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਦਰਾ ਕਰ ਮੱਤ ਮਹਾ ਭਭਕੰ ॥",
      "transliteration": "madharaa kar ma't mahaa bhabhaka(n) ||",
      "translation": "His gait is like that of an elephant",
      "punjabiViakhya": "(ਤੇਰੀ) ਭਭਕ ਸ਼ਰਾਬ ਪੀ ਕੇ ਮਸਤ ਹੋਏ ਹਾਥੀ ਵਰਗੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "मदरा कर मत्त महा भभकं ॥",
      "sourceLineId": "76333",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਨ ਮੈ ਮਨੋ ਬਾਘ ਬਚਾ ਬਬਕੰ ॥੫੩॥",
      "transliteration": "ban mai mano baagh bachaa babaka(n) ||53||",
      "translation": "Intoxicated with wine. His loud thunder appears like the roar of a cub in the forest.53",
      "punjabiViakhya": "ਮਾਨੋ ਜੰਗਲ ਵਿਚ ਸ਼ੇਰ ਦਾ ਬੱਚਾ ਦਹਾੜ ਰਿਹਾ ਹੋਵੇ ॥੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "बन मै मनो बाघ बचा बबकं ॥५३॥",
      "sourceLineId": "76334",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਵ ਭੂਤ ਭਵਿੱਖ ਭਵਾਨ ਭਵੰ ॥",
      "transliteration": "bhav bhoot bhavi'kh bhavaan bhava(n) ||",
      "translation": "Thou art in the world in the past",
      "punjabiViakhya": "(ਤੂੰ) ਭੂਤ, ਭਵਿਖਤ ਅਤੇ ਵਰਤਮਾਨ ਤਿੰਨਾ ਕਾਲਾ ਵਿਚ ਜਗਤ ਨੂੰ ਪੈਦਾ ਕਰਨ ਵਾਲਾ ਹੈਂ",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "भव भूत भविक्ख भवान भवं ॥",
      "sourceLineId": "76335",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਲ ਕਾਰਣ ਉਬਾਰਣ ਏਕ ਤੁਵੰ ॥",
      "transliteration": "kal kaaran ubaaran ek tuva(n) ||",
      "translation": "Future and present. Thou art the ONLY ONE Saviour in the Iron age.",
      "punjabiViakhya": "ਅਤੇ ਕਲਿਯੁਗ ਵਿਚ ਉਬਾਰਨ ਦਾ ਇਕ (ਤੂੰ) ਹੀ ਕਾਰਨ ਰੂਪ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "कल कारण उबारण एक तुवं ॥",
      "sourceLineId": "76336",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਭ ਠੌਰ ਨਿਰੰਤਰ ਨਿੱਤ ਨਯੰ ॥",
      "transliteration": "sabh Thauar nira(n)tar ni't naya(n) ||",
      "translation": "Thou art ever new continuously at all places.",
      "punjabiViakhya": "(ਤੂੰ) ਸਭ ਥਾਵਾ ਵਿਚ ਨਿਰੰਤਰ, ਨਿੱਤ ਨਵੇਾਂ ਰੂਪ ਵਿਚ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "सभ ठौर निरंतर नित्त नयं ॥",
      "sourceLineId": "76337",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮ੍ਰਿਦੁ ਮੰਗਲ ਰੂਪ ਤੁਯੰ ਸੁ ਭਯੰ ॥੫੪॥",
      "transliteration": "miradh ma(n)gal roop tuya(n) su bhaya(n) ||54||",
      "translation": "Thou appearest impressive and sweet in Thy Blissful form.54.",
      "punjabiViakhya": "ਕੋਮਲ ਅਤੇ ਮੰਗਲਮਈ ਰੂਪ ਵਿਚ ਤੂੰ ਹੀ ਸੋਭ ਰਿਹਾ ਹੈਂ ॥੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "मृदु मंगल रूप तुयं सु भयं ॥५४॥",
      "sourceLineId": "76338",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦਿੜ ਦਾੜ੍ਹ ਕਰਾਲ ਦ੍ਵੈ ਸੇਤ ਉਧੰ ॥",
      "transliteration": "dhiR dhaaRh karaal dhavai set udha(n) ||",
      "translation": "Thou hast two grinder teeth. Terrible  white and high",
      "punjabiViakhya": "(ਤੇਰੀਆਂ) ਦੋ ਭਿਆਨਕ ਅਤੇ ਦ੍ਰਿੜ੍ਹ ਚਿੱਟੀਆਂ ਉਚੀਆਂ ਦਾੜ੍ਹਾ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "दिड़ दाड़्ह कराल द्वै सेत उधं ॥",
      "sourceLineId": "76339",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਹ ਭਾਜਤ ਦੁਸਟ ਬਿਲੋਕ ਜੁਧੰ ॥",
      "transliteration": "jeh bhaajat dhusaT bilok judha(n) ||",
      "translation": "Seeing which the tyrants run away from the battlefield.",
      "punjabiViakhya": "ਜਿਨ੍ਹਾ ਨੂੰ ਦੁਸ਼ਟ ਵੇਖ ਕੇ ਯੁੱਧ-ਭੁਮੀ ਵਿਚੋਂ ਭਜ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "जिह भाजत दुसट बिलोक जुधं ॥",
      "sourceLineId": "76340",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਦ ਮਤ ਕ੍ਰਿਪਾਣ ਕਰਾਲ ਧਰੰ ॥",
      "transliteration": "madh mat kirapaan karaal dhara(n) ||",
      "translation": "Thou art inebriated  holding the terrible sword in Thy hand",
      "punjabiViakhya": "(ਤੂੰ) ਸ਼ਰਾਬ ਨਾਲ ਮਸਤ ਹੋ ਕੇ ਹੱਥ ਵਿਚ ਭਿਆਨਕ ਤਲਵਾਰ ਧਾਰਨ ਕੀਤੀ ਹੋਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "मद मत कृपाण कराल धरं ॥",
      "sourceLineId": "76341",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਯ ਸੱਦ ਸੁਰਾਸੁਰਯੰ ਉਚਰੰ ॥੫੫॥",
      "transliteration": "jay sa'dh suraasuraya(n) uchara(n) ||55||",
      "translation": ". Both the gods and demons sing the eulogy of His victory.55.",
      "punjabiViakhya": "ਦੇਵਤੇ ਅਤੇ ਦੈਂਤ ਸਦਾ (ਤੇਰੀ) ਜੈ ਜੈ ਕਾਰ ਕਰਦੇ ਹਨ ॥੫੫॥",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "जय सद्द सुरासुरयं उचरं ॥५५॥",
      "sourceLineId": "76342",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਵ ਕਿੰਕਣ ਨੇਵਰ ਨਾਦ ਹੂਅੰ ॥",
      "transliteration": "nav ki(n)kan nevar naadh hooa(n) ||",
      "translation": "When the united sound of the girdle bells and the anklets emantes",
      "punjabiViakhya": "(ਜਦੋਂ ਤੇਰੀ) ਤੜਾਗੀ ਅਤੇ ਝਾਝਰਾ ਦੇ ਮਿਲਵੇਾਂ ਨਵੇਾਂ ਰੂਪ ਵਾਲਾ ਨਾਦ ਹੁੰਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "नव किंकण नेवर नाद हूअं ॥",
      "sourceLineId": "76343",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚਲ ਚਾਲ ਸਭਾਚਲ ਕੰਪ ਭੂਅੰ ॥",
      "transliteration": "chal chaal sabhaachal ka(n)p bhooa(n) ||",
      "translation": "Then all the mountains become restless like mercury and the earth trembles.",
      "punjabiViakhya": "(ਤਾ) ਸਾਰੇ ਪਰਬਤ ਚਲਾਇਮਾਨ ਹੋ ਜਾਦੇ ਹਨ ਅਤੇ ਧਰਤੀ ਕੰਬਣ ਲਗ ਜਾਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "चल चाल सभाचल कंप भूअं ॥",
      "sourceLineId": "76344",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਘਣ ਘੁੰਘਰ ਘੰਟਣ ਘੋਰ ਸੁਰੰ ॥",
      "transliteration": "ghan ghu(n)ghar gha(n)Tan ghor sura(n) ||",
      "translation": "When the constant jingling loud sound is heard",
      "punjabiViakhya": "ਜਦੋਂ (ਤੇਰੇ) ਘੁੰਘਰੂਆਂ ਦੀ ਉੱਚੀ ਆਵਾਜ਼ ਨਿਕਲਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "घण घुँघर घंटण घोर सुरं ॥",
      "sourceLineId": "76345",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਚਰ ਚਾਰ ਚਰਾਚਰਯੰ ਹੁਹਰੰ ॥੫੬॥",
      "transliteration": "char chaar charaacharaya(n) huhara(n) ||56||",
      "translation": "Then all the movable and immovable objects become restless.56.",
      "punjabiViakhya": "(ਤਾ) ਚੌਹਾ ਦਿਸ਼ਾਵਾ ਦੇ ਜੜ-ਚੇਤਨ ਘਬਰਾ ਜਾਦੇ ਹਨ ॥੫੬॥",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "चर चार चराचरयं हुहरं ॥५६॥",
      "sourceLineId": "76346",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚਲ ਚੌਦਹੂੰ ਚੱਕ੍ਰਨ ਚੱਕ੍ਰ ਫਿਰੰ ॥",
      "transliteration": "chal chauadhahoo(n) cha'kran cha'kr fira(n) ||",
      "translation": "Thy weapons are used in all the fourteen worlds alongwith Thy Command  the empty ones.",
      "punjabiViakhya": "ਚੌਦਾ ਲੋਕਾ ਵਿਚ (ਤੇਰਾ ਹੀ) ਚੱਕਰ ਚਲਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "चल चौदहूँ चक्क्रन चक्क्र फिरं ॥",
      "sourceLineId": "76347",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਢਵੰ ਘਟਵੰ ਹਰੀਅੰ ਸੁਭਰੰ ॥",
      "transliteration": "baddava(n) ghaTava(n) hareea(n) subhara(n) ||",
      "translation": "With which Thou causest deficiency in the augmented once and fill to the brim",
      "punjabiViakhya": "(ਜਿਸ ਨਾਲ ਤੂੰ) ਵਧਿਆ ਹੋਇਆਂ ਨੂੰ ਘਟਾ ਦਿੰਦਾ ਹੈਂ ਅਤੇ ਸਖਣਿਆਂ ਨੂੰ ਚੰਗੀ ਤਰ੍ਹਾ ਭਰ ਦਿੰਦਾ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "बढवं घटवं हरीअं सुभरं ॥",
      "sourceLineId": "76348",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਗ ਜੀਵ ਜਿਤੇ ਜਲਯੰ ਥਲਯੰ ॥",
      "transliteration": "jag jeev jite jalaya(n) thalaya(n) ||",
      "translation": "All the creatures of the world on land and in water",
      "punjabiViakhya": "ਜਗਤ ਦੇ ਜਲ ਥਲ ਵਿਚ ਜਿਤਨੇ ਜੀਵ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "जग जीव जिते जलयं थलयं ॥",
      "sourceLineId": "76349",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0043_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਸ ਕੋ ਜੁ ਤਵਾਇਸੁਅੰ ਮਲਯੰ ॥੫੭॥",
      "transliteration": "as ko ju tavaisua(n) malaya(n) ||57||",
      "translation": "Who is the amongst them  who hath the audacity to refuse Thy Command? 57.",
      "punjabiViakhya": "(ਉਨ੍ਹਾ ਵਿਚ) ਅਜਿਹਾ ਕਿਹੜਾ ਹੈ ਜੋ ਤੇਰੀ ਆਗਿਆ ਨੂੰ ਮੇਟ (ਮਲ) ਦੇਵੇ ॥੫੭॥",
      "source": "DASAM_GRANTH",
      "ang": 43,
      "hindi": "",
      "hindiTransliteration": "अस को जु तवाइसुअं मलयं ॥५७॥",
      "sourceLineId": "76350",
      "sourceShabadId": "7450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
