{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 45,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0045_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "76400",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਿਤੇ ਰਾਮ ਹੂਏ ॥",
      "transliteration": "jite raam hooe ||",
      "translation": "All the Ramas who incarnated,",
      "punjabiViakhya": "ਜਿਤਨੇ ਵੀ ਰਾਮ (ਆਦਿ ਅਵਤਾਰ) ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "जिते राम हूए ॥",
      "sourceLineId": "76401",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਭੈ ਅੰਤ ਮੂਏ ॥",
      "transliteration": "sabhai a(n)t mooe ||",
      "translation": "Ultimately passed away.",
      "punjabiViakhya": "ਸਾਰੇ ਅੰਤ ਨੂੰ ਸਰੀਰ ਤਿਆਗ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "सभै अंत मूए ॥",
      "sourceLineId": "76402",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਿਤੇ ਕ੍ਰਿਸਨ ਹ੍ਵੈਹੈਂ ॥",
      "transliteration": "jite kirasan havaihai(n) ||",
      "translation": "All the Krishnas, who had incarnated,",
      "punjabiViakhya": "ਜਿਤਨੇ ਕ੍ਰਿਸ਼ਨ (ਵਰਗੇ ਅਵਤਾਰ) ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "जिते कृसन ह्वैहैं ॥",
      "sourceLineId": "76403",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਭੈ ਅੰਤ ਜੈਹੈਂ ॥੭੦॥",
      "transliteration": "sabhai a(n)t jaihai(n) ||70||",
      "translation": "Have all passed away.70.",
      "punjabiViakhya": "ਸਾਰੇ ਅੰਤ ਵਿਚ ਚਲੇ ਗਏ ਹਨ ॥੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "सभै अंत जैहैं ॥७०॥",
      "sourceLineId": "76404",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਿਤੇ ਦੇਵ ਹੋਸੀ ॥",
      "transliteration": "jite dhev hosee ||",
      "translation": "All the gods who will come into being in future,",
      "punjabiViakhya": "(ਭਵਿਸ਼ ਵਿਚ) ਜਿਤਨੇ ਦੇਵਤੇ ਹੋਣਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "जिते देव होसी ॥",
      "sourceLineId": "76405",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਭੈ ਅੰਤ ਜਾਸੀ ॥",
      "transliteration": "sabhai a(n)t jaasee ||",
      "translation": "They will all ultimately expire.",
      "punjabiViakhya": "(ਉਹ) ਸਾਰੇ ਅੰਤ ਵਿਚ ਚਲੇ ਜਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "सभै अंत जासी ॥",
      "sourceLineId": "76406",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਿਤੇ ਬੋਧ ਹ੍ਵੈਹੈਂ ॥",
      "transliteration": "jite bodh havaihai(n) ||",
      "translation": "All the Buddhas, who came into being,",
      "punjabiViakhya": "ਜਿਤਨੇ ਵੀ ਬੁੱਧ (ਵਰਗੇ ਮਹਾਪੁਰਸ਼) ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "जिते बोध ह्वैहैं ॥",
      "sourceLineId": "76407",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਭੈ ਅੰਤਿ ਛੈਹੈਂ ॥੭੧॥",
      "transliteration": "sabhai a(n)t chhaihai(n) ||71||",
      "translation": "Expired ultimately.71.",
      "punjabiViakhya": "(ਉਹ) ਸਾਰੇ ਅੰਤ ਨੂੰ ਨਸ਼ਟ ਹੋ ਗਏ ਹਨ ॥੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "सभै अंति छैहैं ॥७१॥",
      "sourceLineId": "76408",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਿਤੇ ਦੇਵ ਰਾਯੰ ॥",
      "transliteration": "jite dhev raaya(n) ||",
      "translation": "All the god-kings, who came into being,",
      "punjabiViakhya": "ਜਿਤਨੇ ਦੇਵ-ਰਾਜ (ਹੋਏ ਹਨ)",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "जिते देव रायं ॥",
      "sourceLineId": "76409",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਭੈ ਅੰਤ ਜਾਯੰ ॥",
      "transliteration": "sabhai a(n)t jaaya(n) ||",
      "translation": "Ultimately passed away.",
      "punjabiViakhya": "(ਉਹ) ਸਾਰੇ ਅੰਤ ਨੂੰ ਚਲੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "सभै अंत जायं ॥",
      "sourceLineId": "76410",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਿਤੇ ਦਈਤ ਏਸੰ ॥",
      "transliteration": "jite dhieet esa(n) ||",
      "translation": "All the demon-kings, who came into being,",
      "punjabiViakhya": "ਜਿਤਨੇ ਵੀ ਦੈਂਤ-ਰਾਜ (ਹੋਏ ਹਨ)",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "जिते दईत एसं ॥",
      "sourceLineId": "76411",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਿਤਿਓ ਕਾਲ ਲੇਸੰ ॥੭੨॥",
      "transliteration": "titio kaal lesa(n) ||72||",
      "translation": "They were all destroyed by KAL.72.",
      "punjabiViakhya": "ਉਨ੍ਹਾ ਨੂੰ ਕਾਲ ਨੇ ਲੈ ਲਿਆ ਹੈ (ਨਸ਼ਟ ਕਰ ਦਿੱਤਾ ਹੈ।)॥੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "तितिओ काल लेसं ॥७२॥",
      "sourceLineId": "76412",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਰਸਿੰਘਾਵਤਾਰੰ ॥",
      "transliteration": "narasi(n)ghaavataara(n) ||",
      "translation": "The incarnation Narsingh",
      "punjabiViakhya": "ਨਰ ਸਿੰਘ ਵਰਗੇ ਅਵਤਾਰ ਨੂੰ ਵੀ",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "नरसिंघावतारं ॥",
      "sourceLineId": "76413",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਵਹੈ ਕਾਲ ਮਾਰੰ ॥",
      "transliteration": "vahai kaal maara(n) ||",
      "translation": "Was also killed by KAL.",
      "punjabiViakhya": "ਕਾਲ ਨੇ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "वहै काल मारं ॥",
      "sourceLineId": "76414",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਡੋ ਡੰਡ ਧਾਰੀ ॥",
      "transliteration": "baddo dda(n)dd dhaaree ||",
      "translation": "The incarnation with grinder teeth (i.e. Boar)",
      "punjabiViakhya": "ਵੱਡੇ ਵੱਡੇ ਦੰਡ-ਧਾਰੀਆਂ ਦਾ ਵੀ",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "बडो डंड धारी ॥",
      "sourceLineId": "76415",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਣਿਓ ਕਾਲ ਭਾਰੀ ॥੭੩॥",
      "transliteration": "hanio kaal bhaaree ||73||",
      "translation": "Was killed by mighty KAL.73.",
      "punjabiViakhya": "ਬਲਵਾਨ ਕਾਲ ਨੇ ਨਾਸ਼ ਕਰ ਦਿੱਤਾ ॥੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "हणिओ काल भारी ॥७३॥",
      "sourceLineId": "76416",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦਿਜੰ ਬਾਵਨੇਯੰ ॥",
      "transliteration": "dhija(n) baavaneya(n) ||",
      "translation": "Vaman, the Brahmin incarnation,",
      "punjabiViakhya": "(ਅਵਤਾਰ ਰੂਪ) ਬਾਵਨ ਬ੍ਰਾਹਮਣ ਨੂੰ ਵੀ",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "दिजं बावनेयं ॥",
      "sourceLineId": "76417",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹਣਿਓ ਕਾਲ ਤੇਯੰ ॥",
      "transliteration": "hanio kaal teya(n) ||",
      "translation": "Was killed by KAL.",
      "punjabiViakhya": "ਕਾਲ ਨੇ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "हणिओ काल तेयं ॥",
      "sourceLineId": "76418",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਹਾ ਮੱਛ ਮੁੰਡੰ ॥",
      "transliteration": "mahaa ma'chh mu(n)dda(n) ||",
      "translation": "The Fish incarnation of spatious mouth,",
      "punjabiViakhya": "ਵੱਡੇ ਸਿਰ ਵਾਲੇ ਮੱਛ ਅਵਤਾਰ ਨੂੰ ਵੀ",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "महा मच्छ मुँडं ॥",
      "sourceLineId": "76419",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਫਧਿਓ ਕਾਲ ਝੁੰਡੰ ॥੭੪॥",
      "transliteration": "fadhio kaal jhu(n)dda(n) ||74||",
      "translation": "Was entrapped by KAL.74.",
      "punjabiViakhya": "ਕਾਲ ਨੇ ਜਾਲ (ਝੁੰਡੰ) ਵਿਚ ਫਸਾ ਲਿਆ ॥੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "फधिओ काल झुँडं ॥७४॥",
      "sourceLineId": "76420",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਤੇ ਹੋਇ ਬੀਤੇ ॥",
      "transliteration": "jite hoi beete ||",
      "translation": "All those who had come into being,",
      "punjabiViakhya": "ਜਿਤਨੇ ਵੀ (ਵੱਡੇ ਵੱਡੇ) ਹੋ ਚੁਕੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "जिते होइ बीते ॥",
      "sourceLineId": "76421",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਿਤੇ ਕਾਲ ਜੀਤੇ ॥",
      "transliteration": "tite kaal jeete ||",
      "translation": "They were all conquered by KAL.",
      "punjabiViakhya": "ਉਨ੍ਹਾ ਨੂੰ ਕਾਲ ਨੇ ਜਿਤ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "तिते काल जीते ॥",
      "sourceLineId": "76422",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਿਤੇ ਸਰਨਿ ਜੈਹੈਂ ॥",
      "transliteration": "jite saran jaihai(n) ||",
      "translation": "Those who will go under His Refuge,",
      "punjabiViakhya": "ਜਿਤਨੇ (ਮਹਾਕਾਲ ਦੀ) ਸ਼ਰਨ ਵਿਚ ਜਾਣਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "जिते सरनि जैहैं ॥",
      "sourceLineId": "76423",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਿਤਿਓ ਰਾਖ ਲੈਹੈਂ ॥੭੫॥",
      "transliteration": "titio raakh laihai(n) ||75||",
      "translation": "They will all be saved by him.75.",
      "punjabiViakhya": "ਉਨ੍ਹਾ (ਸਾਰਿਆਂ ਨੂੰ) ਬਚਾ ਲਏਗਾ ॥੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "तितिओ राख लैहैं ॥७५॥",
      "sourceLineId": "76424",
      "sourceShabadId": "7452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "76425",
      "sourceShabadId": "7453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਿਨਾ ਸਰਨਿ ਤਾਕੀ ਨ ਅਉਰੈ ਉਪਾਯੰ ॥",
      "transliteration": "binaa saran taakee na aaurai upaaya(n) ||",
      "translation": "Without coming under His Refuge, there is no other measure for protection,",
      "punjabiViakhya": "ਉਸ (ਮਹਾਕਾਲ) ਦੀ ਸ਼ਰਨ (ਵਿਚ ਗਏ ਤੋਂ) ਬਿਨਾ ਹੋਰ ਕੋਈ ਉਪਾ ਨਹੀਂ ਹੈ (ਕਾਲ ਤੋਂ ਬਚਣ ਦਾ)।",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "बिना सरनि ताकी न अउरै उपायं ॥",
      "sourceLineId": "76426",
      "sourceShabadId": "7453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਹਾ ਦੇਵ ਦਈਤੰ ਕਹਾ ਰੰਕ ਰਾਯੰ ॥",
      "transliteration": "kahaa dhev dhieeta(n) kahaa ra(n)k raaya(n) ||",
      "translation": "May be a god, demon, pauper or a king.",
      "punjabiViakhya": "ਕੀ ਦੇਵਤੇ ਅਤੇ ਦੈਂਤ, ਕੀ ਕੰਗਾਲ ਅਤੇ ਰਾਜੇ,",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "कहा देव दईतं कहा रंक रायं ॥",
      "sourceLineId": "76427",
      "sourceShabadId": "7453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਹਾ ਪਾਤਸਾਹੰ ਕਹਾ ਉਮਰਾਯੰ ॥",
      "transliteration": "kahaa paatasaaha(n) kahaa umaraaya(n) ||",
      "translation": "May be the Sovereign and may be the courtiers,",
      "punjabiViakhya": "ਕੀ ਬਾਦਸ਼ਾਹ, ਕੀ ਅਮੀਰ (ਖ਼ਾਨਦਾਨੀ)",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "कहा पातसाहं कहा उमरायं ॥",
      "sourceLineId": "76428",
      "sourceShabadId": "7453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਿਨਾ ਸਰਨ ਤਾ ਕੀ ਨ ਕੋਟੈ ਉਪਾਯੰ ॥੭੬॥",
      "transliteration": "binaa saran taa kee na koTai upaaya(n) ||76||",
      "translation": "Without coming under His shelter, millions of measures for protection will be useless. 76.",
      "punjabiViakhya": "(ਸਭ) ਉਸ ਦੀ ਓਟ ਤੋਂ ਬਿਨਾ ਕਰੋੜਾ ਉਪਾ (ਕਰਨ ਨਾਲ ਵੀ ਕਾਲ ਦੀ ਮਾਰ ਤੋਂ ਬਚ) ਨਹੀਂ ਸਕਦੇ ॥੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "बिना सरन ता की न कोटै उपायं ॥७६॥",
      "sourceLineId": "76429",
      "sourceShabadId": "7453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਿਤੇ ਜੀਵ ਜੰਤੰ ਸੁ ਦੁਨੀਅੰ ਉਪਾਯੰ ॥",
      "transliteration": "jite jeev ja(n)ta(n) su dhuneea(n) upaaya(n) ||",
      "translation": "All the creatures created by Him in the world",
      "punjabiViakhya": "ਜਿਤਨੇ ਵੀ ਜੀਵ ਜੰਤ (ਉਸ ਨੇ) ਦੁਨੀਆ ਵਿਚ ਪੈਦਾ ਕੀਤੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "जिते जीव जंतं सु दुनीअं उपायं ॥",
      "sourceLineId": "76430",
      "sourceShabadId": "7453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਭੈ ਅੰਤ ਕਾਲੰ ਬਲੀ ਕਾਲ ਘਾਯੰ ॥",
      "transliteration": "sabhai a(n)t kaala(n) balee kaal ghaaya(n) ||",
      "translation": "Will ultimately be killed by the mighty KAL.",
      "punjabiViakhya": "(ਉਹ) ਸਾਰੇ ਅੰਤ ਸਮੇਾਂ ਬਲਵਾਨ ਕਾਲ ਨੇ ਮਾਰ ਦਿੱਤੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "सभै अंत कालं बली काल घायं ॥",
      "sourceLineId": "76431",
      "sourceShabadId": "7453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਿਨਾ ਸਰਨ ਤਾ ਕੀ ਨਹੀ ਔਰ ਓਟੰ ॥",
      "transliteration": "binaa saran taa kee nahee aauar oTa(n) ||",
      "translation": "There is no other protection without coming under His shelter,",
      "punjabiViakhya": "ਉਸ ਦੀ ਸ਼ਰਨ ਤੋਂ ਬਿਨਾ (ਬਚਣ ਦੀ) ਹੋਰ ਕੋਈ ਓਟ ਨਹੀਂ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "बिना सरन ता की नही और ओटं ॥",
      "sourceLineId": "76432",
      "sourceShabadId": "7453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਲਿਖੇ ਜੰਤ੍ਰ ਕੇਤੇ ਪੜ੍ਹੇ ਮੰਤ੍ਰ ਕੋਟੰ ॥੭੭॥",
      "transliteration": "likhe ja(n)tr kete paRhe ma(n)tr koTa(n) ||77||",
      "translation": "Even though many Yantras be written and millions of Mantras be recited.77.",
      "punjabiViakhya": "(ਭਾਵੇਾਂ) ਕਿਤਨੇ ਹੀ ਯੰਤ੍ਰ ਲਿਖ ਲਏ ਜਾਣ ਜਾ ਮੰਤ੍ਰ ਪੜ੍ਹ ਲਏ ਜਾਣ ॥੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "लिखे जंत्र केते पड़्हे मंत्र कोटं ॥७७॥",
      "sourceLineId": "76433",
      "sourceShabadId": "7453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "naraaj chha(n)dh ||",
      "translation": "NARAAJ STANZA",
      "punjabiViakhya": "ਨਰਾਜ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "नराज छंद ॥",
      "sourceLineId": "76434",
      "sourceShabadId": "7454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਿਤੇਕਿ ਰਾਜ ਰੰਕਯੰ ॥",
      "transliteration": "jitek raaj ra(n)kaya(n) ||",
      "translation": "All the kings and pupers who have come into being,",
      "punjabiViakhya": "ਜਿਤਨੇ ਵੀ ਰਾਜੇ ਅਤੇ ਰੰਕ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "जितेकि राज रंकयं ॥",
      "sourceLineId": "76435",
      "sourceShabadId": "7454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਹਨੇ ਸੁ ਕਾਲ ਬੰਕਯੰ ॥",
      "transliteration": "hane su kaal ba(n)kaya(n) ||",
      "translation": "Are sure to be killed by KAL.",
      "punjabiViakhya": "(ਉਨ੍ਹਾ ਨੂੰ) ਟੇਢੀ ਚਾਲ ਵਾਲੇ ਕਾਲ ਨੇ ਮਾਰ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "हने सु काल बंकयं ॥",
      "sourceLineId": "76436",
      "sourceShabadId": "7454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਿਤੇਕਿ ਲੋਕ ਪਾਲਯੰ ॥",
      "transliteration": "jitek lok paalaya(n) ||",
      "translation": "All the Lokpals, who have come into being,",
      "punjabiViakhya": "ਜਿਤਨੇ ਲੋਕ-ਪਾਲ (ਹੋਏ ਹਨ, ਉਨ੍ਹਾ ਨੂੰ)",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "जितेकि लोक पालयं ॥",
      "sourceLineId": "76437",
      "sourceShabadId": "7454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਿਦਾਨ ਕਾਲ ਦਾਲਯੰ ॥੭੮॥",
      "transliteration": "nidhaan kaal dhaalaya(n) ||78||",
      "translation": "Will ultimately be mashed by KAL.78.",
      "punjabiViakhya": "ਅੰਤ ਵਿਚ ਕਾਲ ਨੇ ਦਲ ਦਿੱਤਾ ਹੈ ॥੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "निदान काल दालयं ॥७८॥",
      "sourceLineId": "76438",
      "sourceShabadId": "7454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕ੍ਰਿਪਾਣ ਪਾਣ ਜੇ ਜਪੈ ॥",
      "transliteration": "kirapaan paan je japai ||",
      "translation": "Those who meditate on the Supreme KAL,",
      "punjabiViakhya": "ਜਿਹੜੇ ਕ੍ਰਿਪਾਨ ਨੂੰ ਹੱਥ ਵਿਚ ਧਾਰਨ ਕਰਨ ਵਾਲੇ (ਮਹਾਕਾਲ) ਨੂੰ ਜਪਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "कृपाण पाण जे जपै ॥",
      "sourceLineId": "76439",
      "sourceShabadId": "7454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਨੰਤ ਥਾਟ ਤੇ ਥਾਪੈ ॥",
      "transliteration": "ana(n)t thaaT te thaapai ||",
      "translation": "The wielder of the sword, they firmly adopt innumerable measures for protection.",
      "punjabiViakhya": "(ਉਹ ਰਖਿਆ ਲਈ) ਬੇਸ਼ੁਮਾਰ ਸਾਧਨ ਜੁਟਾ ਲੈਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "अनंत थाट ते थापै ॥",
      "sourceLineId": "76440",
      "sourceShabadId": "7454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਿਤੇਕ ਕਾਲ ਧ੍ਯਾਇ ਹੈ ॥",
      "transliteration": "jitek kaal dhayai hai ||",
      "translation": "Those who remember KAL,",
      "punjabiViakhya": "ਜਿਤਨੇ ਵੀ ਕਾਲ (ਮਹਾਕਾਲ) ਨੂੰ ਧਿਆਉਾਂਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "जितेक काल ध्याइ है ॥",
      "sourceLineId": "76441",
      "sourceShabadId": "7454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਗਤ ਜੀਤ ਜਾਇ ਹੈ ॥੭੯॥",
      "transliteration": "jagat jeet jai hai ||79||",
      "translation": "They conquer the world and depart.79.",
      "punjabiViakhya": "ਉਹ ਜਗਤ ਉਤੇ ਜਿਤ ਪ੍ਰਾਪਤ ਕਰ ਕੇ ਜਾਦੇ ਹਨ ॥੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "जगत जीत जाइ है ॥७९॥",
      "sourceLineId": "76442",
      "sourceShabadId": "7454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਚਿਤ੍ਰ ਚਾਰੁ ਚਿਤ੍ਰਯੰ ॥",
      "transliteration": "bachitr chaar chitraya(n) ||",
      "translation": "That Supreme KAL is Supremely Pure,",
      "punjabiViakhya": "(ਜਿਸ ਦਾ) ਸਰੂਪ ਬਚਿਤ੍ਰ ਅਤੇ ਸੁੰਦਰ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "बचित्र चारु चित्रयं ॥",
      "sourceLineId": "76443",
      "sourceShabadId": "7454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪਰਮਯੰ ਪਵਿਤ੍ਰਯੰ ॥",
      "transliteration": "paramaya(n) pavitraya(n) ||",
      "translation": "Whose image is supernatural and winsome.",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਪਵਿਤਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "परमयं पवित्रयं ॥",
      "sourceLineId": "76444",
      "sourceShabadId": "7454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਲੋਕ ਰੂਪ ਰਾਜਿਯੰ ॥",
      "transliteration": "alok roop raajiya(n) ||",
      "translation": "He is bedecked with supernatural beauty,",
      "punjabiViakhya": "(ਜੋ) ਅਲੌਕਿਕ ਰੂਪ ਵਿਚ ਸਜ ਰਿਹਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "अलोक रूप राजियं ॥",
      "sourceLineId": "76445",
      "sourceShabadId": "7454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੁਣੇ ਸੁ ਪਾਪ ਭਾਜਿਯੰ ॥੮੦॥",
      "transliteration": "sune su paap bhaajiya(n) ||80||",
      "translation": "All the sins flee on hearing His Name.80.",
      "punjabiViakhya": "(ਉਸ ਦਾ ਨਾ) ਸੁਣ ਕੇ ਪਾਪ ਭਜ ਜਾਦੇ ਹਨ ॥੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "सुणे सु पाप भाजियं ॥८०॥",
      "sourceLineId": "76446",
      "sourceShabadId": "7454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬਿਸਾਲ ਲਾਲ ਲੋਚਨੰ ॥",
      "transliteration": "bisaal laal lochana(n) ||",
      "translation": "He, who hath wide and red eyes,",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਵਿਸ਼ਾਲ ਅਤੇ ਲਾਲ ਨੇਤਰ",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "बिसाल लाल लोचनं ॥",
      "sourceLineId": "76447",
      "sourceShabadId": "7454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਬਿਅੰਤ ਪਾਪ ਮੋਚਨੰ ॥",
      "transliteration": "bia(n)t paap mochana(n) ||",
      "translation": "And who is the destroyer of innumerable sins.",
      "punjabiViakhya": "ਬੇਅੰਤ ਪਾਪਾ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "बिअंत पाप मोचनं ॥",
      "sourceLineId": "76448",
      "sourceShabadId": "7454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਚਮੱਕ ਚੰਦ੍ਰ ਚਾਰੀਅੰ ॥",
      "transliteration": "chama'k cha(n)dhr chaareea(n) ||",
      "translation": "The glitter of his face is more beautiful than that of the moon",
      "punjabiViakhya": "(ਉਸ ਦੇ ਸਰੂਪ ਦੀ) ਚੰਦ੍ਰਮਾ ਤੋਂ ਵੀ ਸੁੰਦਰ ਚਮਕ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "चमक्क चंद्र चारीअं ॥",
      "sourceLineId": "76449",
      "sourceShabadId": "7454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅਘੀ ਅਨੇਕ ਤਾਰੀਅੰ ॥੮੧॥",
      "transliteration": "aghee anek taareea(n) ||81||",
      "translation": "And who hath caused many sinners to ferry across.81.",
      "punjabiViakhya": "ਅਨੇਕ ਪਾਪੀ ਤਾਰੇ ਹਨ ॥੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "अघी अनेक तारीअं ॥८१॥",
      "sourceLineId": "76450",
      "sourceShabadId": "7454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "76451",
      "sourceShabadId": "7455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਿਤੇ ਲੋਕ ਪਾਲੰ ॥",
      "transliteration": "jite lok paala(n) ||",
      "translation": "All the Lokpals",
      "punjabiViakhya": "ਜਿਤਨੇ ਲੋਕ ਪਾਲ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "जिते लोक पालं ॥",
      "sourceLineId": "76452",
      "sourceShabadId": "7455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤਿਤੇ ਜੇਰ ਕਾਲੰ ॥",
      "transliteration": "tite jer kaala(n) ||",
      "translation": "Are subservient to KAL.",
      "punjabiViakhya": "ਉਹ ਸਾਰੇ ਕਾਲ ਦੇ ਅਧੀਨ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "तिते जेर कालं ॥",
      "sourceLineId": "76453",
      "sourceShabadId": "7455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਿਤੇ ਸੂਰ ਚੰਦ੍ਰੰ ॥",
      "transliteration": "jite soor cha(n)dhra(n) ||",
      "translation": "All the suns and moons and",
      "punjabiViakhya": "ਜਿਤਨੇ ਸੂਰਜ ਤੇ ਚੰਦ੍ਰਮੇ ਹਨ ਅਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "जिते सूर चंद्रं ॥",
      "sourceLineId": "76454",
      "sourceShabadId": "7455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕਹਾ ਇੰਦ੍ਰ ਬਿੰਦ੍ਰੰ ॥੮੨॥",
      "transliteration": "kahaa i(n)dhr bi(n)dhra(n) ||82||",
      "translation": "Even Indra and Vaman (are subservient to KAL.82.",
      "punjabiViakhya": "ਕੀ ਇੰਦਰਾ ਦੇ ਸਮੁੱਚ ਹਨ (ਸਭ ਕਾਲ ਦੇ ਵਸ ਵਿਚ ਹਨ) ॥੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "कहा इंद्र बिंद्रं ॥८२॥",
      "sourceLineId": "76455",
      "sourceShabadId": "7455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "76456",
      "sourceShabadId": "7456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਫਿਰੈ ਚੌਦਹੂੰ ਲੋਕਯੰ ਕਾਲ ਚਕ੍ਰੰ ॥",
      "transliteration": "firai chauadhahoo(n) lokaya(n) kaal chakra(n) ||",
      "translation": "All the fourteen worlds are under the Command of KAL.",
      "punjabiViakhya": "ਚੌਦਾ ਲੋਕਾ ਵਿਚ ਕਾਲ ਦਾ ਚੱਕਰ ਚਲਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "फिरै चौदहूँ लोकयं काल चक्रं ॥",
      "sourceLineId": "76457",
      "sourceShabadId": "7456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਸਭੈ ਨਾਥ ਨਾਥੇ ਭ੍ਰਮੰ ਭਉਂਹ ਬਕ੍ਰੰ ॥",
      "transliteration": "sabhai naath naathe bhrama(n) bhau(n)h bakra(n) ||",
      "translation": "He hath stringed all the Naths by turning about the slanting evebrows.",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਟੇਢੀ ਭੌਂ ਫਿਰਾ ਕੇ ਸਾਰੇ ਨਾਥਾ ਨੂੰ ਨਥ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "सभै नाथ नाथे भ्रमं भउंह बक्रं ॥",
      "sourceLineId": "76458",
      "sourceShabadId": "7456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਕਹਾ ਰਾਮ ਕ੍ਰਿਸਨੰ ਕਹਾ ਚੰਦ ਸੂਰੰ ॥",
      "transliteration": "kahaa raam kirasana(n) kahaa cha(n)dh soora(n) ||",
      "translation": "May be Rama and Krishna, may be the moon and sun,",
      "punjabiViakhya": "ਕੀ ਰਾਮ ਅਤੇ ਕ੍ਰਿਸ਼ਨ, ਕੀ ਚੰਦ੍ਰਮਾ ਅਤੇ ਸੂਰਜ,",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "कहा राम कृसनं कहा चंद सूरं ॥",
      "sourceLineId": "76459",
      "sourceShabadId": "7456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਸਭੈ ਹਾਥ ਬਾਧੇ ਖਰੇ ਕਾਲ ਹਜੂਰੰ ॥੮੩॥",
      "transliteration": "sabhai haath baadhe khare kaal hajoora(n) ||83||",
      "translation": "All are standing with folded hands in the presence of KAL.83.",
      "punjabiViakhya": "ਸਾਰੇ ਕਾਲ ਦੀ ਹਜ਼ੂਰੀ ਵਿਚ ਹੱਥ ਬੰਨ੍ਹੀ ਖੜੋਤੇ ਹਨ ॥੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "सभै हाथ बाधे खरे काल हजूरं ॥८३॥",
      "sourceLineId": "76460",
      "sourceShabadId": "7456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਸਵੈਯਾ ॥",
      "transliteration": "savaiyaa ||",
      "translation": "SWAYYA.",
      "punjabiViakhya": "ਸ੍ਵੈਯਾ:",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "सवैया ॥",
      "sourceLineId": "76461",
      "sourceShabadId": "7457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਕਾਲ ਹੀ ਪਾਇ ਭਯੋ ਭਗਵਾਨ ਸੁ ਜਾਗਤ ਯਾ ਜਗ ਜਾ ਕੀ ਕਲਾ ਹੈ ॥",
      "transliteration": "kaal hee pai bhayo bhagavaan su jaagat yaa jag jaa kee kalaa hai ||",
      "translation": "At the instance of KAL, Vishnu appeared, whose power is manifested through the world.",
      "punjabiViakhya": "ਕਾਲ (ਸਮਾ) ਪਾ ਕੇ ਹੀ ਭਗਵਾਨ (ਵਿਸ਼ਣੂ) ਹੋਇਆ ਜਿਸ ਦੀ ਕਲਾ (ਸ਼ਕਤੀ) ਨਾਲ ਇਹ ਜਗਤ ਜਾਗ ਰਿਹਾ ਹੈ (ਗਤੀਮਾਨ ਹੈ)।",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "काल ही पाइ भयो भगवान सु जागत या जग जा की कला है ॥",
      "sourceLineId": "76462",
      "sourceShabadId": "7457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਕਾਲ ਹੀ ਪਾਇ ਭਯੋ ਬ੍ਰਹਮਾ ਸਿਵ ਕਾਲ ਹੀ ਪਾਇ ਭਯੋ ਜੁਗੀਆ ਹੈ ॥",
      "transliteration": "kaal hee pai bhayo brahamaa siv kaal hee pai bhayo jugeeaa hai ||",
      "translation": "At the instance of KAL, Brahma appeared and also at the instance of KAL the Yogi Shiva appeared.",
      "punjabiViakhya": "ਕਾਲ ਪਾ ਕੇ ਹੀ ਬ੍ਰਹਮਾ ਪ੍ਰਗਟ ਹੋਇਆ ਅਤੇ ਕਾਲ ਹੀ ਪਾ ਕੇ ਸ਼ਿਵ ਯੋਗੀ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "काल ही पाइ भयो ब्रहमा सिव काल ही पाइ भयो जुगीआ है ॥",
      "sourceLineId": "76463",
      "sourceShabadId": "7457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਕਾਲ ਹੀ ਪਾਇ ਸੁਰਾਸੁਰ ਗੰਧ੍ਰਬ ਜੱਛ ਭੁਜੰਗ ਦਿਸਾ ਬਿਦਿਸਾ ਹੈ ॥",
      "transliteration": "kaal hee pai suraasur ga(n)dhrab ja'chh bhuja(n)g dhisaa bidhisaa hai ||",
      "translation": "At the instance of KAL, the gods, demons, Gandharvas, Yakshas, Bhujang, directions and indications have appeared.",
      "punjabiViakhya": "ਕਾਲ ਹੀ ਪਾ ਕੇ ਦੇਵਤੇ, ਦੈਂਤ, ਗੰਧਰਬ, ਯਕਸ਼, ਸੱਪ, ਦਿਸ਼ਾਵਾ ਅਤੇ ਵਿਦਿਸ਼ਾਵਾ ਹੋਂਦ ਵਿਚ ਆਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "काल ही पाइ सुरासुर गंध्रब जच्छ भुजंग दिसा बिदिसा है ॥",
      "sourceLineId": "76464",
      "sourceShabadId": "7457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਔਰ ਸੁਕਾਲ ਸਭੈ ਬਸ ਕਾਲ ਕੇ ਏਕ ਹੀ ਕਾਲ ਅਕਾਲ ਸਦਾ ਹੈ ॥੮੪॥",
      "transliteration": "aauar sukaal sabhai bas kaal ke ek hee kaal akaal sadhaa hai ||84||",
      "translation": "All the other prevalent object are within KAL, only One supreme KAL is ever Timeless and eternal.84.",
      "punjabiViakhya": "ਹੋਰ ਜੋ ਵਰਤਮਾਨ ਪਦਾਰਥ ('ਸੁਕਾਲ') ਹਨ, ਉਹ ਸਾਰੇ ਕਾਲ ਦੇ ਵਸ ਵਿਚ ਹਨ, ਬਸ ਇਕੋ ਮਹਾਕਾਲ ਹੀ ਕਾਲ ਦੇ ਪ੍ਰਭਾਵ ਤੋਂ ਰਹਿਤ ਹੈ ॥੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "और सुकाल सभै बस काल के एक ही काल अकाल सदा है ॥८४॥",
      "sourceLineId": "76465",
      "sourceShabadId": "7457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "76466",
      "sourceShabadId": "7458",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਨਮੋ ਦੇਵ ਦੇਵੰ ਨਮੋ ਖੜਗਧਾਰੰ ॥",
      "transliteration": "namo dhev dheva(n) namo khaRagadhaara(n) ||",
      "translation": "Salutation to the God of gods and salutation to the wielder of sword,",
      "punjabiViakhya": "(ਹੇ) ਦੇਵਤਿਆਂ ਦੇ ਦੇਵਤੇ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ, ਹੇ ਖੜਗਧਾਰੀ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "नमो देव देवं नमो खड़गधारं ॥",
      "sourceLineId": "76467",
      "sourceShabadId": "7458",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਸਦਾ ਏਕ ਰੂਪੰ ਸਦਾ ਨਿਰਬਿਕਾਰੰ ॥",
      "transliteration": "sadhaa ek roopa(n) sadhaa nirabikaara(n) ||",
      "translation": "Who is ever monomorphic and ever without vices.",
      "punjabiViakhya": "(ਤੂੰ) ਸਦਾ ਇਕ ਰੂਪ ਵਿਚ ਰਹਿਣ ਵਾਲਾ ਅਤੇ ਵਿਕਾਰਾ ਤੋਂ ਰਹਿਤ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "सदा एक रूपं सदा निरबिकारं ॥",
      "sourceLineId": "76468",
      "sourceShabadId": "7458",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਨਮੋ ਰਾਜਸੰ ਸਾਤਕੰ ਤਾਮਸੇਅੰ ॥",
      "transliteration": "namo raajasa(n) saataka(n) taamasea(n) ||",
      "translation": "Salutation to Him, who manifests the qualities of activity (rajas), rhythm (sattava) and morbidity (tamas).",
      "punjabiViakhya": "(ਹੇ) ਰਜੋ, ਸਤੋ ਅਤੇ ਤਮੋ ਗੁਣਾ ਵਾਲੇ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "नमो राजसं सातकं तामसेअं ॥",
      "sourceLineId": "76469",
      "sourceShabadId": "7458",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਨਮੋ ਨਿਰਬਿਕਾਰੰ ਨਮੋ ਨਿਰਜੁਰੇਅੰ ॥੮੫॥",
      "transliteration": "namo nirabikaara(n) namo nirajurea(n) ||85||",
      "translation": "Salutation to Him who is without vices and who is without ailments. 85.",
      "punjabiViakhya": "(ਹੇ) ਵਿਕਾਰਾ ਤੋਂ ਰਹਿਤ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ, ਹੇ ਰੋਗਾ ਤੋਂ ਰਹਿਤ! (ਤੈਨੂੰ) ਨਮਸਕਾਰ ਹੈ ॥੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "नमो निरबिकारं नमो निरजुरेअं ॥८५॥",
      "sourceLineId": "76470",
      "sourceShabadId": "7458",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0045_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 45,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "76471",
      "sourceShabadId": "7459",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    }
  ]
}
