{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 50,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0050_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਚਾ ਬੈਰ ਬਾਦੰ ਬਿਧਾਤੇ ਅਪਾਰੰ ॥",
      "transliteration": "rachaa bair baadha(n) bidhaate apaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਧਾਤਾ ਨੇ ਕਈ ਤਰ੍ਹਾ ਦੇ ਵੈਰ ਅਤੇ ਵਿਵਾਦ ਰਚ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "रचा बैर बादं बिधाते अपारं ॥",
      "sourceLineId": "76688",
      "sourceShabadId": "7473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਿਸੈ ਸਾਧ ਸਾਕਿਓ ਨ ਕੋਊ ਸੁਧਾਰੰ ॥",
      "transliteration": "jisai saadh saakio na kouoo sudhaara(n) ||",
      "translation": "The Providence created the great vices of enmity and strife, which could not be controlled by any reformer.",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਕੋਈ ਸਾਧੂ ਪੁਰਸ਼ (ਨੇਕ ਆਦਮੀ) ਸੁਧਾਰ ਨਾ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "जिसै साध साकिओ न कोऊ सुधारं ॥",
      "sourceLineId": "76689",
      "sourceShabadId": "7473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਲੀ ਕਾਮਰਾਯੰ ਮਹਾ ਲੋਭ ਮੋਹੰ ॥",
      "transliteration": "balee kaamaraaya(n) mahaa lobh moha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾਬਲੀ ਕਾਮ, ਲੋਭ, ਮੋਹ ਆਦਿ ਵਿਕਾਰਾ ਦੇ ਹਥਿਆਰਾ ਦੀ ਮਾਰ ਤੋਂ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "बली कामरायं महा लोभ मोहं ॥",
      "sourceLineId": "76690",
      "sourceShabadId": "7473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗਯੋ ਕਉਨ ਬੀਰੰ ਸੁ ਯਾ ਤੇ ਅਲੋਹੰ ॥੧॥",
      "transliteration": "gayo kaun beera(n) su yaa te aloha(n) ||1||",
      "translation": "Which warrior could save himself from the blwos of mighty king lust and the great courtiers creed and attachment? 1.",
      "punjabiViakhya": "ਭਲਾ ਕੌਣ ਸ਼ੂਰਵੀਰ ਬਚ ਕੇ ਗਿਆ ਹੈ? ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "गयो कउन बीरं सु या ते अलोहं ॥१॥",
      "sourceLineId": "76691",
      "sourceShabadId": "7473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਹਾਂ ਬੀਰ ਬੰਕੇ ਬਕੈ ਆਪ ਮੱਧੰ ॥",
      "transliteration": "tahaa(n) beer ba(n)ke bakai aap ma'dha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ (ਰਣਭੂਮੀ ਵਿਚ) ਬਾਕੇ ਸੂਰਮੇ ਆਪਸ ਵਿਚ ਕੌੜੇ ਬਚਨ ਬੋਲ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "तहाँ बीर बंके बकै आप मद्धं ॥",
      "sourceLineId": "76692",
      "sourceShabadId": "7473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਉਠੇ ਸਸਤ੍ਰ ਲੈ ਲੈ ਮਚਾ ਜੁੱਧ ਸੱੁਧੰ ॥",
      "transliteration": "auThe sasatr lai lai machaa ju'dh sa'udha(n) ||",
      "translation": "There the youthful warriors are busy challenging shuts amongst themselves, they stand up with their weapons and are engaged in tough fight.",
      "punjabiViakhya": "(ਉਹ) ਸ਼ਸਤ੍ਰ ਲੈ ਲੈ ਕੇ ਉਠਦੇ ਹਨ ਅਤੇ ਘੋਰ ਯੁੱਧ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "उठे ससत्र लै लै मचा जुद्ध सु्ुधं ॥",
      "sourceLineId": "76693",
      "sourceShabadId": "7473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਹੂੰ ਖੱਪਰੀ ਖੋਲ ਖੰਡੇ ਅਪਾਰੰ ॥",
      "transliteration": "kahoo(n) kha'paree khol kha(n)dde apaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਖਪਰੇ (ਚੌੜੇ ਫਲ ਵਾਲਾ ਤੀਰ) ਖੋਲ ਅਤੇ ਖੰਡੇ ਧਾਰਨ ਕਰਨ ਵਾਲੇ (ਇਕ ਦੂਜੇ ਨੂੰ ਮਾਰ ਰਹੇ ਹਨ)",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "कहूँ खप्परी खोल खंडे अपारं ॥",
      "sourceLineId": "76694",
      "sourceShabadId": "7473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਚੇ ਬੀਰ ਬੈਤਾਲ ਡਉਰੂ ਡਕਾਰੰ ॥੨॥",
      "transliteration": "nache beer baitaal ddauroo ddakaara(n) ||2||",
      "translation": "In this fight, somewhere there are innumerable shafts, helmets and double-edged swords in use. The evil spirits and ghosts are dancing and the tabors are resounding.2.",
      "punjabiViakhya": "ਕਿਤੇ ਬੀਰ ਬੈਤਾਲ ਡਉਰੂ ਵਜਾ ਵਜਾ ਕੇ ਨਚਦੇ ਹਨ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "नचे बीर बैताल डउरू डकारं ॥२॥",
      "sourceLineId": "76695",
      "sourceShabadId": "7473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਹੂੰ ਈਸ ਸੀਸੰ ਪੁਐ ਰੁੰਡ ਮਾਲੰ ॥",
      "transliteration": "kahoo(n) iees seesa(n) puaai ru(n)dd maala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸ਼ਿਵ ਸਿਰਾ (ਰੁੰਡਾ) ਨੂੰ ਮਾਲਾ ਵਿਚ ਪਰੋਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "कहूँ ईस सीसं पुऐ रुँड मालं ॥",
      "sourceLineId": "76696",
      "sourceShabadId": "7473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਹੂੰ ਡਾਕ ਡਉਰੂ ਕਹੂੰ ਕੰਬਿਤਾਲੰ ॥",
      "transliteration": "kahoo(n) ddaak ddauroo kahoo(n) ka(n)bitaala(n) ||",
      "translation": "Somewhere the god Shiva is stringing the skulls in his rosary of skulls, somewhere the vampires and ghosts are shrieking joyfully.",
      "punjabiViakhya": "ਕਿਤੇ ਡਾਕਣੀਆਂ (ਊਲ ਜਲੂਲ) ਬੋਲਦੀਆਂ ਹਨ ਅਤੇ ਕਿਤੇ ਬੈਤਾਲ ਕੂਕਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "कहूँ डाक डउरू कहूँ कंबितालं ॥",
      "sourceLineId": "76697",
      "sourceShabadId": "7473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚਵੀ ਚਾਵਡੀਅੰ ਕਿਲੰਕਾਰ ਕੰਕੰ ॥",
      "transliteration": "chavee chaavaddeea(n) kila(n)kaar ka(n)ka(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਚਮੁੰਡਣਾ ਬੋਲਦੀਆਂ ਹਨ ਅਤੇ ਕਿਤੇ ਇੱਲਾ ਕਿਲਕਾਰੀਆਂ ਮਾਰਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "चवी चावडीअं किलंकार कंकं ॥",
      "sourceLineId": "76698",
      "sourceShabadId": "7473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੁਥੀ ਲੁੱਥ ਜੱੁਥੇ ਬਹੇ ਬੀਰ ਬੰਕੰ ॥੩॥",
      "transliteration": "guthee lu'th ja'uthe bahe beer ba(n)ka(n) ||3||",
      "translation": "Somewhere the terrible goddess Chamunda is shouting and somewhere the vultures are shrieking. Somewhere the corpses of youthful warriors are lying inter-lovked.3.",
      "punjabiViakhya": "ਕਿਤੇ ਬਾਕੇ ਸੂਰਬੀਰਾ ਦੀਆਂ ਲਾਸ਼ਾ ਗੁੱਥਮਗੁੱਥਾ ਹੋ ਰਹੀਆਂ ਹਨ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "गुथी लुत्थ जु्ुथे बहे बीर बंकं ॥३॥",
      "sourceLineId": "76699",
      "sourceShabadId": "7473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪਰੀ ਕੱੁਟ ਕੱੁਟੰ ਰੁਲੇ ਤੱਛ ਮੱੁਛੰ ॥",
      "transliteration": "paree ka'uT ka'uTa(n) rule ta'chh ma'uchha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਕੁਟ ਮਾਰ ਹੋਈ ਹੈ, (ਸੂਰਮਿਆਂ ਦੇ ਸ਼ਰੀਰਾ ਦੇ) ਟੋਟੇ ਰੁਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "परी कु्ुट कु्ुटं रुले तच्छ मु्ुछं ॥",
      "sourceLineId": "76700",
      "sourceShabadId": "7473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਹੇ ਹਾਥ ਡਾਰੇ ਉਭੈ ਉਰਧ ਮੱੁਛੰ ॥",
      "transliteration": "rahe haath ddaare ubhai uradh ma'uchha(n) ||",
      "translation": "There had been tough battle, because of which the chopped corpses are rolling in dush. Somewhere the dead warriors are lying uncared with their hands on their whiskers.",
      "punjabiViakhya": "(ਕਿਤੇ) ਦੋਵੇਾਂ ਹੱਥ ਮੁੱਛਾ ਉਤੇ ਰਖੇ (ਹੋਇਆਂ ਮੁਰਦੇ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਰੁਲ ਰਹੇ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "रहे हाथ डारे उभै उरध मु्ुछं ॥",
      "sourceLineId": "76701",
      "sourceShabadId": "7473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਹੂੰ ਖੋਪਰੀ ਖੋਲ ਖਿੰਗੰ ਖਤੰਗੰ ॥",
      "transliteration": "kahoo(n) khoparee khol khi(n)ga(n) khata(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਖੋਪੜੀ ਨੂੰ ਬਚਾਉਣ ਵਾਲੇ ਖੋਲ ਅਤੇ ਧਨੁਖ-ਬਾਣ ਰੁਲ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "कहूँ खोपरी खोल खिंगं खतंगं ॥",
      "sourceLineId": "76702",
      "sourceShabadId": "7473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਹੂੰ ਖਤ੍ਰੀਯੰ ਖੱਗ ਖੇਤੰ ਨਿਖੰਗੰ ॥੪॥",
      "transliteration": "kahoo(n) khatreeya(n) kha'g kheta(n) nikha(n)ga(n) ||4||",
      "translation": "Somewhere the skulls, helmets, bows and arrows are lying scattered. Somewhere the swords and quivers of the warriors are there in the battlefield.4.",
      "punjabiViakhya": "ਕਿਤੇ ਸੂਰਬੀਰਾ ਦੀਆਂ ਤਲਵਾਰਾ ਅਤੇ ਤੀਰਾ ਦੇ ਭੱਥੇ ਰੁਲ ਰਹੇ ਹਨ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "कहूँ खत्रीयं खग्ग खेतं निखंगं ॥४॥",
      "sourceLineId": "76703",
      "sourceShabadId": "7473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚਵੀ ਚਾਂਵਡੀ ਡਾਕਨੀ ਡਾਕ ਮਾਰੇ ॥",
      "transliteration": "chavee chaa(n)vaddee ddaakanee ddaak maare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਚਮੁੰਡਣਾ ਬੋਲਦੀਆਂ ਹਨ ਅਤੇ ਡਾਕਣੀਆਂ ਡਕਾਰਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "चवी चाँवडी डाकनी डाक मारे ॥",
      "sourceLineId": "76704",
      "sourceShabadId": "7473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਹੂੰ ਭੈਰਵੀ ਭੂਤ ਭੈਰੋਂ ਬਕਾਰੇ ॥",
      "transliteration": "kahoo(n) bhairavee bhoot bhairo(n) bakaare ||",
      "translation": "Somewhere the vultures shriek and somewhere the vampire is belching.",
      "punjabiViakhya": "ਕਿਤੇ ਭੈਰਵੀ, ਭੂਤ ਅਤੇ ਭੈਰੋ ਭੱਭਕਾ ਮਾਰ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "कहूँ भैरवी भूत भैरों बकारे ॥",
      "sourceLineId": "76705",
      "sourceShabadId": "7473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਹੂੰ ਬੀਰ ਬੈਤਾਲ ਬੰਕੇ ਬਿਹਾਰੰ ॥",
      "transliteration": "kahoo(n) beer baitaal ba(n)ke bihaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਬੀਰ ਬੈਤਾਲ ਆਕੜ ਕੇ ('ਬੰਕੇ') ਫਿਰਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "कहूँ बीर बैताल बंके बिहारं ॥",
      "sourceLineId": "76706",
      "sourceShabadId": "7473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਹੂੰ ਭੂਤ ਪ੍ਰੇਤੰ ਹਸੈ ਮਾਸਹਾਰੰ ॥੫॥",
      "transliteration": "kahoo(n) bhoot preta(n) hasai maasahaara(n) ||5||",
      "translation": "Somewhere the evil spirits and ghosts are walking slantingly, somewhere the ghosts, fiends and meateaters are laughing.5.",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਭੂਤ-ਪ੍ਰੇਤ ਅਤੇ ਮਾਸਹਾਰੀ ਜੀਵ ਹਸ ਰਹੇ ਹਨ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "कहूँ भूत प्रेतं हसै मासहारं ॥५॥",
      "sourceLineId": "76707",
      "sourceShabadId": "7473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "76708",
      "sourceShabadId": "7474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਹਾਂ ਬੀਰ ਗੱਜੇ ॥",
      "transliteration": "mahaa(n) beer ga'je ||",
      "translation": "",
      "punjabiViakhya": "ਵਡੇ ਸੂਰਮੇ ਗਜ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "महाँ बीर गज्जे ॥",
      "sourceLineId": "76709",
      "sourceShabadId": "7474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੁਣੈ ਮੇਘ ਲੱਜੇ ॥",
      "transliteration": "sunai megh la'je ||",
      "translation": "Hearing the thunder of mighty warriors, the clouds felt shy.",
      "punjabiViakhya": "(ਜਿਨ੍ਹਾ ਦੀ ਗਰਜ ਨੂੰ) ਸੁਣ ਕੇ ਬਦਲ ਵੀ ਲੱਜਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "सुणै मेघ लज्जे ॥",
      "sourceLineId": "76710",
      "sourceShabadId": "7474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਝੰਡਾ ਗੱਡ ਗਾਢੇ ॥",
      "transliteration": "jha(n)ddaa ga'dd gaadde ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਹਾ ਨੇ ਆਪਣੇ) ਝੰਡੇ ਪੱਕੀ ਤਰ੍ਹਾ ਗਡੇ ਹੋਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "झंडा गड्ड गाढे ॥",
      "sourceLineId": "76711",
      "sourceShabadId": "7474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮੰਡੇ ਰੋਸ ਬਾਢੇ ॥੬॥",
      "transliteration": "ma(n)dde ros baadde ||6||",
      "translation": "Strong banners have been fixed and highly infuriated the heroes are enaged in war.6.",
      "punjabiViakhya": "(ਜਿਨ੍ਹਾ ਨੂੰ ਵੇਖ ਕੇ ਵਿਰੋਧੀ ਵੈਰੀ ਦਲਾ ਦੇ ਸੂਰਮੇ) ਰੋਹ ਵਧਾ ਕੇ (ਯੁੱਧ ਵਿਚ) ਜੁਟੇ ਹੋਏ ਹਨ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "मंडे रोस बाढे ॥६॥",
      "sourceLineId": "76712",
      "sourceShabadId": "7474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕ੍ਰਿਪਾਣੰ ਕਟਾਰੰ ॥",
      "transliteration": "kirapaana(n) kaTaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਨਾ ਅਤੇ ਕਟਾਰਾ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "कृपाणं कटारं ॥",
      "sourceLineId": "76713",
      "sourceShabadId": "7474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਭਿਰੇ ਰੋਸ ਧਾਰੰ ॥",
      "transliteration": "bhire ros dhaara(n) ||",
      "translation": "Holding their swords and daggers, they are fighting in great anger.",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਰੋਸ ਵਧਾ ਕੇ ਲੜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "भिरे रोस धारं ॥",
      "sourceLineId": "76714",
      "sourceShabadId": "7474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਹਾਂ ਬੀਰ ਬੰਕੰ ॥",
      "transliteration": "mahaa(n) beer ba(n)ka(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਅਨੇਕ) ਬਾਕੇ ਮਹਾਨ ਯੋਧੇ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "महाँ बीर बंकं ॥",
      "sourceLineId": "76715",
      "sourceShabadId": "7474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭਿਰੇ ਭੂਮ ਹੰਕੰ ॥੭॥",
      "transliteration": "bhire bhoom ha(n)ka(n) ||7||",
      "translation": "The winsome great heroes, with their fighting, make the earth tremble.7.",
      "punjabiViakhya": "ਧਰਤੀ ਨੂੰ ਕੰਬਾਉਾਂਦੇ ਹੋਏ (ਇਕ ਦੂਜੇ ਨਾਲ) ਭਿੜ ਰਹੇ ਹਨ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "भिरे भूम हंकं ॥७॥",
      "sourceLineId": "76716",
      "sourceShabadId": "7474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਚੇ ਸੂਰ ਸਸਤ੍ਰੰ ॥",
      "transliteration": "mache soor sasatra(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਦੇ ਸ਼ਸਤ੍ਰ ਚਲਣ ਲਗੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "मचे सूर ससत्रं ॥",
      "sourceLineId": "76717",
      "sourceShabadId": "7474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਉਠੀ ਝਾਰ ਅਸਤ੍ਰੰ ॥",
      "transliteration": "auThee jhaar asatra(n) ||",
      "translation": "The warriors are fighting with their weapons in great excitement, the weapons as well as the armour are glistening.",
      "punjabiViakhya": "ਅਤੇ ਅਸਤ੍ਰਾ ਦੇ ਚਲਣ ਨਾਲ ਚਿਣਗਾ ਨਿਕਲਣ ਲਗੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "उठी झार असत्रं ॥",
      "sourceLineId": "76718",
      "sourceShabadId": "7474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕ੍ਰਿਪਾਣੰ ਕਟਾਰੰ ॥",
      "transliteration": "kirapaana(n) kaTaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਨਾ, ਕਟਾਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "कृपाणं कटारं ॥",
      "sourceLineId": "76719",
      "sourceShabadId": "7474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪਰੀ ਲੋਹ ਮਾਰੰ ॥੮॥",
      "transliteration": "paree loh maara(n) ||8||",
      "translation": "There is the great steel-killing with weapons like swords and daggers.8.",
      "punjabiViakhya": "ਅਤੇ ਲੋਹੇ (ਦੇ ਬਣੇ ਹੋਰ ਸ਼ਸਤ੍ਰਾ ਦੇ) ਖੂਬ ਪ੍ਰਹਾਰ ਹੋਏ ਹਨ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "परी लोह मारं ॥८॥",
      "sourceLineId": "76720",
      "sourceShabadId": "7474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "76721",
      "sourceShabadId": "7475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹੱਲਬੀ ਜੁਨੱਬੀ ਸਰੋਹੀ ਦੁਧਾਰੀ ॥",
      "transliteration": "ha'labee juna'bee sarohee dhudhaaree ||",
      "translation": "Various types of swords, the swords from Halab and Junab, Sarohi swords and the double-deged sword, knife, spear and dagger were struck with great ire.",
      "punjabiViakhya": "ਕਿਤੇ ਹਲਬ ਦੀ, ਕਿਤੇ ਜਨਬ ਦੀ, ਕਿਤੇ ਸਰੋਹੀ ਤਲਵਾਰ ਅਤੇ ਕਿਤੇ ਦੋਧਾਰੀ ਤਲਵਾਰ,",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "हल्लबी जुनब्बी सरोही दुधारी ॥",
      "sourceLineId": "76722",
      "sourceShabadId": "7475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਹੀ ਕੋਪ ਕਾਤੀ ਕ੍ਰਿਪਾਣੰ ਕਟਾਰੀ ॥",
      "transliteration": "bahee kop kaatee kirapaana(n) kaTaaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਛੁਰੀ, ਕ੍ਰਿਪਾਨ ਅਤੇ ਕਟਾਰ (ਆਪਣੇ ਧਾਰਕਾ ਦੁਆਰਾ) ਕ੍ਰੋਧ ਨਾਲ ਵਾਹੀਆਂ ਜਾ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "बही कोप काती कृपाणं कटारी ॥",
      "sourceLineId": "76723",
      "sourceShabadId": "7475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਹੂੰ ਸੈਹਥੀਅੰ ਕਹੂੰ ਸੁੱਧ ਸੇਲੰ ॥",
      "transliteration": "kahoo(n) saihatheea(n) kahoo(n) su'dh sela(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸੈਹੱਥੀਆਂ ਨਾਲ ਅਤੇ ਕਿਤੇ ਨੇਜ਼ਿਆਂ ਨਾਲ (ਲੜਾਈ ਹੋ ਰਹੀ ਹੈ)",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "कहूँ सैहथीअं कहूँ सुद्ध सेलं ॥",
      "sourceLineId": "76724",
      "sourceShabadId": "7475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਹੂੰ ਸੇਲ ਸਾਂਗੰ ਭਈ ਰੇਲ ਪੇਲੰ ॥੯॥",
      "transliteration": "kahoo(n) sel saa(n)ga(n) bhiee rel pela(n) ||9||",
      "translation": "Somewhere the lancet and somewhere the pike only were used, somewhere the lance and the dagger were being used violently.9.",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਨੇਜ਼ਿਆਂ ਅਤੇ ਬਰਛੀਆਂ ਨਾਲ ਧਕਮਧੱਕੀ ਹੋ ਰਹੀ ਹੈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "कहूँ सेल साँगं भई रेल पेलं ॥९॥",
      "sourceLineId": "76725",
      "sourceShabadId": "7475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "naraaj chha(n)dh ||",
      "translation": "NARAAJ STANZA",
      "punjabiViakhya": "ਨਰਾਜ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "नराज छंद ॥",
      "sourceLineId": "76726",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਰੋਖ ਸੁਰ ਸਾਜਿਅੰ ॥",
      "transliteration": "sarokh sur saajia(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰੋਹ ਨਾਲ ਸੂਰਮੇ ਸੱਜੇ ਹੋਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "सरोख सुर साजिअं ॥",
      "sourceLineId": "76727",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਿਸਾਰ ਸੰਕ ਬਾਜਿਅੰ ॥",
      "transliteration": "bisaar sa(n)k baajia(n) ||",
      "translation": "The warriors are fiercely adorned with weapons, with which tthey fight forsaking all doubts.",
      "punjabiViakhya": "ਅਤੇ ਸ਼ੰਕਾ ਨੂੰ ਭੁਲਾ ਕੇ ਖੂਬ ਭਿੜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "बिसार संक बाजिअं ॥",
      "sourceLineId": "76728",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਿਸੰਕ ਸਸਤ੍ਰ ਮਾਰਹੀ ॥",
      "transliteration": "nisa(n)k sasatr maarahee ||",
      "translation": "",
      "punjabiViakhya": "ਨਿਸੰਗ ਹੋ ਕੇ ਸ਼ਸਤ੍ਰ ਮਾਰਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "निसंक ससत्र मारही ॥",
      "sourceLineId": "76729",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਉਤਾਰ ਅੰਗ ਡਾਰਹੀ ॥੧੦॥",
      "transliteration": "autaar a(n)g ddaarahee ||10||",
      "translation": "Without hesitation they strike the weapons and chop the limbs.10.",
      "punjabiViakhya": "ਅਤੇ (ਵਿਰੋਧੀਆਂ ਦੇ) ਅੰਗ ਉਤਾਰਦੇ ਜਾ ਰਹੇ ਹਨ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "उतार अंग डारही ॥१०॥",
      "sourceLineId": "76730",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਛੂ ਨ ਕਾਨ ਰਾਖਹੀਂ ॥",
      "transliteration": "kachhoo na kaan raakhahee(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਦੀ ਕੋਈ ਪਰਵਾਹ ਨਹੀਂ ਕਰਦੇ,",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "कछू न कान राखहीं ॥",
      "sourceLineId": "76731",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੁ ਮਾਰ ਮਾਰ ਭਾਖਹੀਂ ॥",
      "transliteration": "s maar maar bhaakhahee(n) ||",
      "translation": "They do not care at all and shout “kill, kill”.",
      "punjabiViakhya": "ਬਸ ਮਾਰੋ-ਮਾਰੋ ਹੀ ਬੋਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "सु मार मार भाखहीं ॥",
      "sourceLineId": "76732",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੁ ਹਾਂਕ ਹਾਠ ਰੇਲਯੰ ॥",
      "transliteration": "s haa(n)k haaTh relaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਲਲਕਾਰਾ ਮਾਰ ਕੇ (ਵਿਰੋਧੀ ਨੂੰ) ਧੱਕ ਲੈ ਜਾਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "सु हाँक हाठ रेलयं ॥",
      "sourceLineId": "76733",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਨੰਤ ਸਸਤ੍ਰ ਝੇਲਯੰ ॥੧੧॥",
      "transliteration": "ana(n)t sasatr jhelaya(n) ||11||",
      "translation": "They challenge and drive with force and endure the blows of many weapons.11.",
      "punjabiViakhya": "ਅਤੇ ਅਨੰਤ ਸ਼ਸਤ੍ਰਾ ਦੇ ਵਾਰਾ ਨੂੰ ਸਹਿੰਦੇ ਹਨ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "अनंत ससत्र झेलयं ॥११॥",
      "sourceLineId": "76734",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਹਜਾਰ ਹੂਰ ਅੰਬਰੰ ॥",
      "transliteration": "hajaar hoor a(n)bara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹਜ਼ਾਰਾ ਹੂਰਾ ਆਕਾਸ਼ (ਵਿਚ ਵਿਚਰ ਰਹੀਆਂ ਹਨ)",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "हजार हूर अंबरं ॥",
      "sourceLineId": "76735",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਬਿਰੁਧ ਕੈ ਸ੍ਵਯੰਬਰੰ ॥",
      "transliteration": "birudh kai savaiya(n)bara(n) ||",
      "translation": "Thousand of houris (beautiful heavenly damsels) move in the sky; they move forward to marry the martyrs.",
      "punjabiViakhya": "ਅਤੇ ਯੁੱਧ-ਭੂਮੀ (ਬਿਰੁਧ) ਨੂੰ ਸੁਅੰਬਰ ਬਣਾ ਕੇ (ਵੀਰਗਤੀ ਪ੍ਰਾਪਤ ਕਰਨ ਵਾਲੇ ਸੂਰਮਿਆਂ ਨੂੰ ਵਰਦੀਆਂ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "बिरुध कै स्वयंबरं ॥",
      "sourceLineId": "76736",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਰੂਰ ਭਾਂਤ ਡੋਲਹੀ ॥",
      "transliteration": "karoor bhaa(n)t ddolahee ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ) ਭਿਆਨਕ ਢੰਗ ਨਾਲ ਡੋਲਦੇ ਫਿਰਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "करूर भाँत डोलही ॥",
      "sourceLineId": "76737",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸੁ ਮਾਰ ਮਾਰ ਬੋਲਹੀ ॥੧੨॥",
      "transliteration": "s maar maar bolahee ||12||",
      "translation": "The warriors move in the battlefield in a frightful manner, and utter “kill, kill” 12.",
      "punjabiViakhya": "ਅਤੇ (ਮੂੰਹੋਂ) 'ਮਾਰੋ' 'ਮਾਰੋ' ਹੀ ਬੋਲਦੇ ਹਨ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "सु मार मार बोलही ॥१२॥",
      "sourceLineId": "76738",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਹੂੰ ਕਿ ਅੰਗ ਕੱਟੀਅੰ ॥",
      "transliteration": "kahoo(n) k a(n)g ka'Teea(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਦੇ ਅੰਗ ਕਟੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "कहूँ कि अंग कट्टीअं ॥",
      "sourceLineId": "76739",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਹੂੰ ਸੁਰੋਹ ਪੱਟੀਅੰ ॥",
      "transliteration": "kahoo(n) suroh pa'Teea(n) ||",
      "translation": "The limbs of some warrior have been chopped and the hair of some have been uprooted.",
      "punjabiViakhya": "ਕਿਸੇ ਦੇ ਵਾਲ (ਸੁਰੋਹ) ਪੁਟੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "कहूँ सुरोह पट्टीअं ॥",
      "sourceLineId": "76740",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਹੂੰ ਸੁ ਮਾਸ ਮੁੱਛੀਅੰ ॥",
      "transliteration": "kahoo(n) su maas mu'chheea(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਦਾ ਮਾਸ ਕਟਿਆ ਗਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "कहूँ सु मास मुच्छीअं ॥",
      "sourceLineId": "76741",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਗਿਰੇ ਸੁ ਤੱਛ ਮੁੱਛੀਅੰ ॥੧੩॥",
      "transliteration": "gire su ta'chh mu'chheea(n) ||13||",
      "translation": "The flesh of someone has been peeled and someone hath fallen after being chopped.13.",
      "punjabiViakhya": "ਅਤੇ (ਕਿਤੇ ਕੋਈ) ਵਢਿਆ-ਟੁਕਿਆ ਡਿਗਿਆ ਪਿਆ ਹੈ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "गिरे सु तच्छ मुच्छीअं ॥१३॥",
      "sourceLineId": "76742",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਢਮੱਕ ਢੋਲ ਢਾਲਯੰ ॥",
      "transliteration": "ddama'k ddol ddaalaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਢਾਲਾ ਤੇ ਢੋਲ ਢੰਮ-ਢੰਮ ਵਜਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "ढमक्क ढोल ढालयं ॥",
      "sourceLineId": "76743",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਹਰੋਲ ਹਾਲ ਚਾਲਯੰ ॥",
      "transliteration": "harol haal chaalaya(n) ||",
      "translation": "There is knocking sound of drums and shield. The frontline army hath been uprooted.",
      "punjabiViakhya": "ਅਤੇ (ਸੈਨਾ ਦੇ) ਮੂਹਰਲੇ (ਹਿੱਸੇ ਦੇ ਸੈਨਿਕ) ਮੌਜ-ਮਸਤੀ ਵਿਚ ਚਲ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "हरोल हाल चालयं ॥",
      "sourceLineId": "76744",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਝਟਾਕ ਝਟ ਬਾਹੀਅੰ ॥",
      "transliteration": "jhaTaak jhaT baaheea(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਫੁਰਤੀ ਨਾਲ (ਹਥਿਆਰ) ਚਲਾਉਾਂਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "झटाक झट बाहीअं ॥",
      "sourceLineId": "76745",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਸੁ ਬੀਰ ਸੈਨ ਗਾਹੀਅੰ ॥੧੪॥",
      "transliteration": "s beer sain gaaheea(n) ||14||",
      "translation": "The warriors strike their weapons very quickly and trample over the heroic army.14.",
      "punjabiViakhya": "ਅਤੇ ਸੈਨਾ ਨੂੰ ਗਾਹੁੰਦੇ ਹਨ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "सु बीर सैन गाहीअं ॥१४॥",
      "sourceLineId": "76746",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਨਿਵੰ ਨਿਸਾਣ ਬਾਜਿਅੰ ॥",
      "transliteration": "niva(n) nisaan baajia(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨਵੇਾਂ ਧੌਂਸੇ ਵਜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "निवं निसाण बाजिअं ॥",
      "sourceLineId": "76747",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਸੁ ਬੀਰ ਧੀਰ ਗਾਜਿਅੰ ॥",
      "transliteration": "s beer dheer gaajia(n) ||",
      "translation": "New trumpets resound and the mighty warriors with quality of forbearance, roar.",
      "punjabiViakhya": "ਧੀਰਜਵਾਨ ਸੂਰਮੇ ਗਜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "सु बीर धीर गाजिअं ॥",
      "sourceLineId": "76748",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਕ੍ਰਿਪਾਨ ਬਾਣ ਬਾਹਹੀ ॥",
      "transliteration": "kirapaan baan baahahee ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਨਾ ਅਤੇ ਤੀਰ ਚਲਾਉਾਂਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "कृपान बाण बाहही ॥",
      "sourceLineId": "76749",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਅਜਾਤ ਅੰਗ ਲਾਹਹੀ ॥੧੫॥",
      "transliteration": "ajaat a(n)g laahahee ||15||",
      "translation": "They strike the swords and shoot the arrows and suddenly chop away the limbs. 15.",
      "punjabiViakhya": "ਅਤੇ ਅਛੋਪਲੇ ਹੀ ਅੰਗ ਵੱਢ ਸੁਟਦੇ ਹਨ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "अजात अंग लाहही ॥१५॥",
      "sourceLineId": "76750",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਬਿਰੁੱਧ ਕ੍ਰੁੱਧ ਰਾਜਿਯੰ ॥",
      "transliteration": "biru'dh kru'dh raajiya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ-ਭੂਮੀ (ਵਿਚ ਸੂਰਮੇ) ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਸ਼ੁਭਾਇਮਾਨ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "बिरुद्ध क्रुद्ध राजियं ॥",
      "sourceLineId": "76751",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਨ ਚਾਰ ਪੈਰ ਭਾਜਿਯੰ ॥",
      "transliteration": "n chaar pair bhaajiya(n) ||",
      "translation": "Filled with anger, they move forward and do not go back even four feet.",
      "punjabiViakhya": "ਅਤੇ ਚਾਰ ਕਦਮ ਵੀ (ਇਧਰ-ਉਧਰ) ਨਹੀਂ ਭਜਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "न चार पैर भाजियं ॥",
      "sourceLineId": "76752",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਸੰਭਾਰ ਸਸਤ੍ਰ ਗਾਜਹੀ ॥",
      "transliteration": "sa(n)bhaar sasatr gaajahee ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰਾ ਨੂੰ ਸੰਭਾਲ ਕੇ ਗਜਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "संभार ससत्र गाजही ॥",
      "sourceLineId": "76753",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਸੁ ਨਾਦ ਮੇਘ ਲਾਜਹੀ ॥੧੬॥",
      "transliteration": "s naadh megh laajahee ||16||",
      "translation": "They hold the weapons and challenge and hearing their thunder, the clouds feel shy.16.",
      "punjabiViakhya": "(ਉਨ੍ਹਾ ਦੇ ਗੱਜਣ ਦੀ) ਆਵਾਜ਼ ਨੂੰ ਸੁਣ ਕੇ ਮੇਘ ਵੀ ਸ਼ਰਮਿੰਦੇ ਹੁੰਦੇ ਹਨ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "सु नाद मेघ लाजही ॥१६॥",
      "sourceLineId": "76754",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਹਲੰਕ ਹਾਕ ਮਾਰਹੀ ॥",
      "transliteration": "hala(n)k haak maarahee ||",
      "translation": "",
      "punjabiViakhya": "ਭਿਆਨਕ ਲਲਕਾਰੇ ਮਾਰਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "हलंक हाक मारही ॥",
      "sourceLineId": "76755",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਸਰੱਕ ਸਸਤ੍ਰ ਝਾਰਹੀ ॥",
      "transliteration": "sara'k sasatr jhaarahee ||",
      "translation": "They raise their heart-rending shouts and strike their weapons violently.",
      "punjabiViakhya": "ਅਤੇ (ਨਾਲ ਹੀ) 'ਸੜੱਕ' ਦੀ ਆਵਾਜ਼ ਕਰਦੇ ਸ਼ਸਤ੍ਰ ਚਲਾ ਦਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "सरक्क ससत्र झारही ॥",
      "sourceLineId": "76756",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਭਿਰੇ ਬਿਸਾਰਿ ਸੋਕਿਯੰ ॥",
      "transliteration": "bhire bisaar sokiya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੋਗ ਨੂੰ ਭੁਲਾ ਕੇ ਲੜਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
      "hindiTransliteration": "भिरे बिसारि सोकियं ॥",
      "sourceLineId": "76757",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0050_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਸਿਧਾਰ ਦੇਵ ਲੋਕਿਯੰ ॥੧੭॥",
      "transliteration": "sidhaar dhev lokiya(n) ||17||",
      "translation": "They fight, forgetting all sorrows and several of them move towards heaven.17.",
      "punjabiViakhya": "ਅਤੇ (ਵੀਰ-ਗਤੀ ਪਾ ਕੇ) ਸੁਅਰਗ ਲੋਕ ਨੂੰ ਜਾਦੇ ਹਨ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 50,
      "hindi": "",
