{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 51,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0051_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੁ ਮਾਰਿ ਝਾਰਿ ਤੀਰਯੰ ॥",
      "transliteration": "s maar jhaar teeraya(n) ||",
      "translation": "The warriors filled with ire and moving forward shoot a volley of arrows.",
      "punjabiViakhya": "ਤੇ ਤੀਰਾ ਦੀ ਮਾਰ ਨਾਲ (ਪਰਪੱਖ ਵਾਲਿਆਂ ਨੂੰ) ਝਾੜ ਦਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "सु मारि झारि तीरयं ॥",
      "sourceLineId": "76760",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਬਦ ਸੰਖ ਬੱਜਿਯੰ ॥",
      "transliteration": "sabadh sa(n)kh ba'jiya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਖ ਦੇ ਵਜਣ ਦੀ ਧੁਨ ਆਉਾਂਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "सबद संख बज्जियं ॥",
      "sourceLineId": "76761",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੁ ਬੀਰ ਧੀਰ ਸੱਜਿਯੰ ॥੧੮॥",
      "transliteration": "s beer dheer sa'jiya(n) ||18||",
      "translation": "The conch is blown and in such a terrible time, the warriors get adorned with patience. 18.",
      "punjabiViakhya": "ਅਤੇ ਸੂਰਮੇ ਧੀਰਜ ਨਾਲ ਸੁਸਜਿਤ ਹੁੰਦੇ ਹਨ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "सु बीर धीर सज्जियं ॥१८॥",
      "sourceLineId": "76762",
      "sourceShabadId": "7476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "76763",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤੁਰੀ ਸੰਖ ਬਾਜੇ ॥",
      "transliteration": "turee sa(n)kh baaje ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਗਲ ਅਤੇ ਸੰਖ ਵਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "तुरी संख बाजे ॥",
      "sourceLineId": "76764",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਹਾ ਬੀਰ ਸਾਜੇ ॥",
      "transliteration": "mahaa beer saaje ||",
      "translation": "The trumpet and conch resound and the great warriors look impressive.",
      "punjabiViakhya": "ਵੱਡੇ ਸੂਰਮੇ ਸਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "महा बीर साजे ॥",
      "sourceLineId": "76765",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਚੇ ਤੁੰਦ ਤਾਜੀ ॥",
      "transliteration": "nache tu(n)dh taajee ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਜ਼ ਚਾਲ ਵਾਲੇ ਘੋੜੇ ਨਚ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "नचे तुँद ताजी ॥",
      "sourceLineId": "76766",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮਚੇ ਸੂਰ ਗਾਜੀ ॥੧੯॥",
      "transliteration": "mache soor gaajee ||19||",
      "translation": "The swift-running horses dance and the brave warriors are excited.19.",
      "punjabiViakhya": "ਅਤੇ ਧਰਮ-ਵੀਰ ਸੂਰਮੇ ਮਸਤ ਹੋਏ ਫਿਰ ਰਹੇ ਹਨ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "मचे सूर गाजी ॥१९॥",
      "sourceLineId": "76767",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਝਿਮੀ ਤੇਜ ਤੇਗੰ ॥",
      "transliteration": "jhimee tej tega(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਜ਼ ਤਲਵਾਰਾ ਚਮਕ ਰਹੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "झिमी तेज तेगं ॥",
      "sourceLineId": "76768",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਨੋ ਬਿੱਜ ਬੇਗੰ ॥",
      "transliteration": "mano bi'j bega(n) ||",
      "translation": "The glistening sharp swords flash like lightning.",
      "punjabiViakhya": "ਮਾਨੋ ਬਿਜਲੀ ਤੇਜ਼ੀ ਨਾਲ ਚਲ ਰਹੀ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "मनो बिज्ज बेगं ॥",
      "sourceLineId": "76769",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਉਠੈ ਨੱਦ ਨਾਦੰ ॥",
      "transliteration": "auThai na'dh naadha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਧੌਂਸਿਆਂ (ਨਦ) ਦੀ ਆਵਾਜ਼ ਆ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "उठै नद्द नादं ॥",
      "sourceLineId": "76770",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਧੁਨੰ ਨ੍ਰਿਬਿਖਾਦੰ ॥੨੦॥",
      "transliteration": "dhuna(n) nirabikhaadha(n) ||20||",
      "translation": "The sound of drums arises and is heard continuously. 20.",
      "punjabiViakhya": "ਇਹ ਧੁਨ ਨਿਰੰਤਰ (ਸੁਣਾਈ ਦੇ ਰਹੀ ਹੈ) ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "धुनं नृबिखादं ॥२०॥",
      "sourceLineId": "76771",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤੁਟੈ ਖੱਗ ਖੋਲੰ ॥",
      "transliteration": "tuTai kha'g khola(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਤੇ) ਤਲਵਾਰਾ ਅਤੇ ਸਿਰ ਦੇ ਖੋਲ ਟੁੱਟੇ ਪਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "तुटै खग्ग खोलं ॥",
      "sourceLineId": "76772",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੁਖੰ ਮਾਰ ਬੋਲੰ ॥",
      "transliteration": "mukha(n) maar bola(n) ||",
      "translation": "Somewhere the double-edged swords and helmets lie broken, somewhere the warriors shout “kill, kill”.",
      "punjabiViakhya": "(ਕਿਤੇ ਸੂਰਮੇ) ਮੂੰਹ ਤੋਂ ਮਾਰੋ-ਮਾਰੋ ਬੋਲ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "मुखं मार बोलं ॥",
      "sourceLineId": "76773",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਧਕਾ ਧੀਕ ਧੱਕੰ ॥",
      "transliteration": "dhakaa dheek dha'ka(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਧਕਮਧੱਕੀ ਹੋ ਰਹੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "धका धीक धक्कं ॥",
      "sourceLineId": "76774",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗਿਰੇ ਹੱਕ ਬੱਕੰ ॥੨੧॥",
      "transliteration": "gire ha'k ba'ka(n) ||21||",
      "translation": "Somewhere the warriors are forcefully knocked about and somewhere, being puzzled, they have fallen down. 21.",
      "punjabiViakhya": "ਕਿਤੇ ਹੱਕੇ-ਬੱਕੇ ਹੋਏ (ਸੂਰਮੇ) ਡਿਗੇ ਹੋਏ ਹਨ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "गिरे हक्क बक्कं ॥२१॥",
      "sourceLineId": "76775",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦਲੰ ਦੀਹ ਗਾਹੰ ॥",
      "transliteration": "dhala(n) dheeh gaaha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਤੇ) ਵੱਡਿਆਂ ਦਲਾ ਨੂੰ ਲਤਾੜਿਆ ਜਾ ਰਿਹਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "दलं दीह गाहं ॥",
      "sourceLineId": "76776",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਧੋ ਅੰਗ ਲਾਹੰ ॥",
      "transliteration": "adho a(n)g laaha(n) ||",
      "translation": "The great army is being trampled and limbs are being chopped into halves.",
      "punjabiViakhya": "(ਕਿਤੇ) ਅੱਧੇ ਅੰਗ ਵਢੇ ਜਾ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "अधो अंग लाहं ॥",
      "sourceLineId": "76777",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪ੍ਰਯੋਘੰ ਪਰਹਾਰੰ ॥",
      "transliteration": "prayogha(n) parahaara(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਤੇ ਵੀਰ) ਲੋਹੇ ਦੀ ਗਦਾ ਮਾਰਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "प्रयोघं परहारं ॥",
      "sourceLineId": "76778",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਕੈ ਮਾਰ ਮਾਰੰ ॥੨੨॥",
      "transliteration": "bakai maar maara(n) ||22||",
      "translation": "The long steel maces are struck and the shouts of “kill, kill” are raised.22.",
      "punjabiViakhya": "ਅਤੇ (ਕਿਤੇ) 'ਮਾਰੋ' 'ਮਾਰੋ' ਕਹਿੰਦੇ ਹਨ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "बकै मार मारं ॥२२॥",
      "sourceLineId": "76779",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਦੀ ਰਕਤ ਪੂਰੰ ॥",
      "transliteration": "nadhee rakat poora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਲਹੂ ਨਾਲ ਨਦੀ ਭਰ ਗਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "नदी रकत पूरं ॥",
      "sourceLineId": "76780",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਫਿਰੀ ਗੈਣ ਹੂਰੰ ॥",
      "transliteration": "firee gain hoora(n) ||",
      "translation": "The stream of blood is full and the houris walk over the sky.",
      "punjabiViakhya": "ਆਕਾਸ਼ ਵਿਚ ਹੂਰਾ ਵਿਚਰਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "फिरी गैण हूरं ॥",
      "sourceLineId": "76781",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗਜੈ ਗੈਣ ਕਾਲੀ ॥",
      "transliteration": "gajai gain kaalee ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲੀ ਦੇਵੀ ਆਸਮਾਨ ਵਿਚ ਗਜ ਰਹੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "गजै गैण काली ॥",
      "sourceLineId": "76782",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹਸੀ ਖੱਪਰਾਲੀ ॥੨੩॥",
      "transliteration": "hasee kha'paraalee ||23||",
      "translation": "The goddess Kali is thundering in the sky and the vamps are laughing.23.",
      "punjabiViakhya": "ਅਤੇ ਖੱਪਰ ਭਰ ਕੇ ਪੀਣ ਵਾਲੀਆਂ (ਕਲਜੋਗਣਾ) ਹਸਦੀਆਂ ਹਨ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "हसी खप्पराली ॥२३॥",
      "sourceLineId": "76783",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਹਾ ਸੂਰ ਸੋਹੰ ॥",
      "transliteration": "mahaa soor soha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਡੇ ਸੂਰਮੇ ਸੋਭਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "महा सूर सोहं ॥",
      "sourceLineId": "76784",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੰਡੇ ਲੋਹ ਕ੍ਰੋਹੰ ॥",
      "transliteration": "ma(n)dde loh kroha(n) ||",
      "translation": "The great warriors equipped with steel and filled with ire look impressive.",
      "punjabiViakhya": "ਜੋ ਜੰਗ ਵਿਚ ਕ੍ਰੋਧ ਨਾਲ ਭੜਕੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "मंडे लोह क्रोहं ॥",
      "sourceLineId": "76785",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਹਾਂ ਗਰਬ ਗਜਿਯੰ ॥",
      "transliteration": "mahaa(n) garab gajiya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਡੇ ਹੰਕਾਰ ਨਾਲ ਗਜਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "महाँ गरब गजियं ॥",
      "sourceLineId": "76786",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਧੁਨੰ ਮੇਘ ਲਜਿਯੰ ॥੨੪॥",
      "transliteration": "dhuna(n) megh lajiya(n) ||24||",
      "translation": "They roar with great pride and hearing them, the clouds feel shy.24.",
      "punjabiViakhya": "(ਜਿਨ੍ਹਾ ਦੀ) ਆਵਾਜ਼ (ਸੁਣ ਕੇ) ਬਦਲ ਵੀ ਸ਼ਰਮਿੰਦਾ ਹੁੰਦਾ ਹੈ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "धुनं मेघ लजियं ॥२४॥",
      "sourceLineId": "76787",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਛਕੇ ਲੋਹ ਛੱਕੰ ॥",
      "transliteration": "chhake loh chha'ka(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਸ਼ਸਤ੍ਰਾ ਦੀ ਸਾਜ ਸਜਾਵਟ ਨਾਲ ਸੱਜੇ ਹੋਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "छके लोह छक्कं ॥",
      "sourceLineId": "76788",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮੁਖੰ ਮਾਰ ਬੱਕੰ ॥",
      "transliteration": "mukha(n) maar ba'ka(n) ||",
      "translation": "The warriors are adorned with steel-weapons and shout “kill, kill”.",
      "punjabiViakhya": "ਅਤੇ ਮੂੰਹ ਤੋਂ 'ਮਾਰੋ' 'ਮਾਰੋ' ਬੋਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "मुखं मार बक्कं ॥",
      "sourceLineId": "76789",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮੁਖੰ ਮੱੁਛ ਬੰਕੰ ॥",
      "transliteration": "mukha(n) ma'uchh ba(n)ka(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮਿਆਂ ਦੇ) ਮੂੰਹ ਉਤੇ ਕੁੰਡਲੀਆਂ ਮੁੱਛਾ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "मुखं मु्ुछ बंकं ॥",
      "sourceLineId": "76790",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਿਰੇ ਛਾਡ ਸੰਕੰ ॥੨੫॥",
      "transliteration": "bhire chhaadd sa(n)ka(n) ||25||",
      "translation": "They have slanting whiskers on their faces and fight without caring for their life. 25.",
      "punjabiViakhya": "ਅਤੇ ਨਿਸੰਗ ਹੋ ਕੇ ਲੜ ਰਹੇ ਹਨ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "भिरे छाड संकं ॥२५॥",
      "sourceLineId": "76791",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਕੰ ਹਾਕ ਬਾਜੀ ॥",
      "transliteration": "haka(n) haak baajee ||",
      "translation": "",
      "punjabiViakhya": "(ਯੋਧਿਆਂ ਨੇ) ਘੋੜਿਆਂ (ਬਾਜੀ) ਨੂੰ ਹਕ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "हकं हाक बाजी ॥",
      "sourceLineId": "76792",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਘਿਰੀ ਸੈਣ ਸਾਜੀ ॥",
      "transliteration": "ghiree sain saajee ||",
      "translation": "There are shouts and the army hath laid the siege.",
      "punjabiViakhya": "ਸੈਨਾ ਨੂੰ ਘੇਰ ਲਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "घिरी सैण साजी ॥",
      "sourceLineId": "76793",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚਿਰੇ ਚਾਰ ਢੂਕੇ ॥",
      "transliteration": "chire chaar ddooke ||",
      "translation": "",
      "punjabiViakhya": "ਚਿੜ੍ਹੇ ਹੋਏ (ਸੂਰਮੇ) ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ ਢੁਕ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "चिरे चार ढूके ॥",
      "sourceLineId": "76794",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮੁਖੰ ਮਾਰ ਕੂਕੇ ॥੨੬॥",
      "transliteration": "mukha(n) maar kooke ||26||",
      "translation": "In great anger the warriors rush from all sides shouting “kill, kill”.26.",
      "punjabiViakhya": "ਅਤੇ ਮੂੰਹ ਤੋਂ ਮਾਰੋ-ਮਾਰੋ ਬੋਲ ਰਹੇ ਹਨ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "मुखं मार कूके ॥२६॥",
      "sourceLineId": "76795",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਰੁਕੇ ਸੂਰ ਸਾਂਗੰ ॥",
      "transliteration": "ruke soor saa(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਗਾ ਨਾਲ ਸੂਰਮੇ ਅਟਕੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "रुके सूर साँगं ॥",
      "sourceLineId": "76796",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਨੋ ਸਿੰਧ ਗੰਗੰ ॥",
      "transliteration": "mano si(n)dh ga(n)ga(n) ||",
      "translation": "The warriors are meeting with their lances like the Ganges with the sea.",
      "punjabiViakhya": "ਮਾਨੋ ਸਮੁੰਦਰ ਨਾਲ ਗੰਗਾ ਮਿਲ ਗਈ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "मनो सिंध गंगं ॥",
      "sourceLineId": "76797",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਢਹੇ ਨਾਲ ਢੱਕੰ ॥",
      "transliteration": "ddahe naal dda'ka(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈ) ਢਾਲਾ ਦੇ ਓਹਲੇ ਲੁਕ ਗਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "ढहे नाल ढक्कं ॥",
      "sourceLineId": "76798",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕ੍ਰਿਪਾਣੰ ਕੜੱਕੰ ॥੨੭॥",
      "transliteration": "kirapaana(n) kaRa'ka(n) ||27||",
      "translation": "Many of them under cover of their shields even break the striking swords with cracking sound.27.",
      "punjabiViakhya": "ਅਤੇ (ਢਾਲ ਉਤੇ ਵਜਣ ਕਾਰਨ) ਕ੍ਰਿਪਾਨਾ ਨੂੰ ਕੜਕਾ ਦਿੰਦੇ ਹਨ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "कृपाणं कड़क्कं ॥२७॥",
      "sourceLineId": "76799",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਕੰ ਹਾਕ ਬਾਜੀ ॥",
      "transliteration": "haka(n) haak baajee ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜਿਆਂ ਨੂੰ ਲਲਕਾਰਿਆ ਜਾ ਹੱਕਿਆ ਜਾ ਰਿਹਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "हकं हाक बाजी ॥",
      "sourceLineId": "76800",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਚੇ ਤੁੰਦ ਤਾਜੀ ॥",
      "transliteration": "nache tu(n)dh taajee ||",
      "translation": "There are shouts after shouts and the swift-running horses dance.",
      "punjabiViakhya": "ਉਹ ਤੇਜ਼ ਚਾਲ ਵਾਲੇ ਘੋੜੇ ਨਚਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "नचे तुँद ताजी ॥",
      "sourceLineId": "76801",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਰਸੰ ਰੁਦ੍ਰ ਪਾਗੇ ॥",
      "transliteration": "rasa(n) rudhr paage ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਰੌਦਰ ਰਸ ਵਿਚ ਰੰਗੇ ਹੋਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "रसं रुद्र पागे ॥",
      "sourceLineId": "76802",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਭਿਰੇ ਰੋਸ ਜਾਗੇ ॥੨੮॥",
      "transliteration": "bhire ros jaage ||28||",
      "translation": "The warriors are highly ferocious and are fighting with the awakening of anger.28.",
      "punjabiViakhya": "ਅਤੇ ਕ੍ਰੋਧਿਤ ਹੋਣ ਤੇ ਲੜ ਰਹੇ ਹਨ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "भिरे रोस जागे ॥२८॥",
      "sourceLineId": "76803",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗਿਰੇ ਸੁੱਧ ਸੇਲੰ ॥",
      "transliteration": "gire su'dh sela(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਿਖੇ ਨੇਜ਼ਿਆਂ ਨਾਲ (ਸੂਰਮੇ) ਡਿਗੇ ਪਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "गिरे सुद्ध सेलं ॥",
      "sourceLineId": "76804",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭਈ ਰੇਲ ਪੇਲੰ ॥",
      "transliteration": "bhiee rel pela(n) ||",
      "translation": "The sharp lances have fallen down and there is great knocking.",
      "punjabiViakhya": "ਅਤੇ (ਉਨ੍ਹਾ ਵਿਚ) ਧਕਮਧੱਕੀ ਹੋ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "भई रेल पेलं ॥",
      "sourceLineId": "76805",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪਲੰਹਾਰ ਨੱਚੇ ॥",
      "transliteration": "pala(n)haar na'che ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਸਾਹਾਰੀ ਜੀਵ ਨਚ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "पलंहार नच्चे ॥",
      "sourceLineId": "76806",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0051_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਣੰ ਬੀਰ ਮੱਚੇ ॥੨੯॥",
      "transliteration": "rana(n) beer ma'che ||29||",
      "translation": "The eaters of flesh are dancing and the warriors are engaged in hot war.29.",
      "punjabiViakhya": "ਅਤੇ ਯੁੱਧ ਵਿਚ ਸੂਰਮੇ ਚਾਉ ਨਾਲ ਜੁਟੇ ਹੋਏ ਹਨ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 51,
      "hindi": "",
      "hindiTransliteration": "रणं बीर मच्चे ॥२९॥",
      "sourceLineId": "76807",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    }
  ]
}
