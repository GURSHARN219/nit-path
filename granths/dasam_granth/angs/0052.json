{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 52,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0052_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਸੇ ਮਾਸਹਾਰੀ ॥",
      "transliteration": "hase maasahaaree ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਸ ਖਾਣ ਵਾਲੇ ਹਸ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "हसे मासहारी ॥",
      "sourceLineId": "76808",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਚੇ ਭੂਤ ਭਾਰੀ ॥",
      "transliteration": "nache bhoot bhaaree ||",
      "translation": "The flesh-eating creatures are laughing and the gangs of ghosts are dancing.",
      "punjabiViakhya": "ਅਤੇ ਵਡੇ ਭੂਤ ਨਚ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "नचे भूत भारी ॥",
      "sourceLineId": "76809",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਹਾ ਢੀਠ ਢੂਕੇ ॥",
      "transliteration": "mahaa ddeeTh ddooke ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤੇ ਨਿਡਰ (ਯੋਧੇ ਭਿੜਨ ਲਈ) ਉਲ੍ਹਰੇ ਹੋਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "महा ढीठ ढूके ॥",
      "sourceLineId": "76810",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮੁਖੰ ਮਾਰ ਕੂਕੇ ॥੩੦॥",
      "transliteration": "mukha(n) maar kooke ||30||",
      "translation": "The persistent warriors are moving forward and shouting “kill, kill”.30.",
      "punjabiViakhya": "ਅਤੇ ਮੁਖ ਵਿਚੋਂ ਮਾਰੋ-ਮਾਰੋ ਬੋਲ ਰਹੇ ਹਨ ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "मुखं मार कूके ॥३०॥",
      "sourceLineId": "76811",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗਜੈ ਗੈਣ ਦੇਵੀ ॥",
      "transliteration": "gajai gain dhevee ||",
      "translation": "",
      "punjabiViakhya": "ਆਕਾਸ਼ ਵਿਚ ਦੇਵੀ ਗਜ ਰਹੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "गजै गैण देवी ॥",
      "sourceLineId": "76812",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਹਾ ਅੰਸ ਭੇਵੀ ॥",
      "transliteration": "mahaa a(n)s bhevee ||",
      "translation": "That goddess hath roared in the sky, who hath been brought into being by Supreme KAL.",
      "punjabiViakhya": "ਜੋ ਮਹਾਕਾਲ ਤੋਂ ਪੈਦਾ ਹੋਈ ਹੈ (ਅਰਥਾਤ ਮਹਾਕਾਲ ਦੀ ਸ਼ਕਤੀ ਹੈ)।",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "महा अंस भेवी ॥",
      "sourceLineId": "76813",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭਲੇ ਭੂਤ ਨਾਚੰ ॥",
      "transliteration": "bhale bhoot naacha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭੂਤ ਚੰਗੀ ਤਰ੍ਹਾ ਨਚ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "भले भूत नाचं ॥",
      "sourceLineId": "76814",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਸੰ ਰੁਦ੍ਰ ਰਾਚੰ ॥੩੧॥",
      "transliteration": "rasa(n) rudhr raacha(n) ||31||",
      "translation": "The ghosts are dancing excitedly and are saturated with great anger.31.",
      "punjabiViakhya": "ਅਤੇ ਰੌਦਰ ਰਸ ਵਿਚ ਮਗਨ ਹਨ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "रसं रुद्र राचं ॥३१॥",
      "sourceLineId": "76815",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭਿਰੈ ਬੈਰ ਰੱੁਝੈ ॥",
      "transliteration": "bhirai bair ra'ujhai ||",
      "translation": "",
      "punjabiViakhya": "(ਵੀਰ ਸੈਨਿਕ) ਵੈਰ ਨਾਲ ਭਰੇ-ਪੀਤੇ ਭਿੜ ਰਹੇ",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "भिरै बैर रु्ुझै ॥",
      "sourceLineId": "76816",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਹਾ ਜੋਧ ਜੁੱਝੈ ॥",
      "transliteration": "mahaa jodh ju'jhai ||",
      "translation": "The warriors are fighting with each other because of enmity and the great heroes are falling as martyras.",
      "punjabiViakhya": "ਅਤੇ ਵੱਡੇ ਯੋਧੇ ਜੂਝ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "महा जोध जुज्झै ॥",
      "sourceLineId": "76817",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਝੰਡਾ ਗੱਡ ਗਾਢੇ ॥",
      "transliteration": "jha(n)ddaa ga'dd gaadde ||",
      "translation": "",
      "punjabiViakhya": "ਦ੍ਰਿੜ੍ਹਤਾ ਨਾਲ ਝੰਡੇ ਗਡ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "झंडा गड्ड गाढे ॥",
      "sourceLineId": "76818",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਜੇ ਬੈਰ ਬਾਢੇ ॥੩੨॥",
      "transliteration": "baje bair baadde ||32||",
      "translation": "Fixing their strong banner and with increased enemity they are shouting.32.",
      "punjabiViakhya": "ਅਤੇ ਵੈਰ ਵਧਾ ਕੇ ਲਲਕਾਰੇ ਮਾਰ ਰਹੇ ਹਨ ॥੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "बजे बैर बाढे ॥३२॥",
      "sourceLineId": "76819",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗਜੰ ਗਾਹ ਬਾਧੇ ॥",
      "transliteration": "gaja(n) gaeh baadhe ||",
      "translation": "",
      "punjabiViakhya": "ਸਿਰ ਉਤੇ ਭੂਖਣ ਸਜਾਏ ਹੋਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "गजं गाह बाधे ॥",
      "sourceLineId": "76820",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਧਨੁਰ ਬਾਣ ਸਾਧੇ ॥",
      "transliteration": "dhanur baan saadhe ||",
      "translation": "They have adorned their head with the ornament and have stretched their bows in their hands.",
      "punjabiViakhya": "ਅਤੇ ਤੀਰ-ਕਮਾਨਾ ਸਾਧੀਆਂ ਹੋਈਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "धनुर बाण साधे ॥",
      "sourceLineId": "76821",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਹੇ ਆਪ ਮੱਧੰ ॥",
      "transliteration": "bahe aap ma'dha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਸ ਵਿਚ (ਤੀਰ) ਚਲਾਉਾਂਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "बहे आप मद्धं ॥",
      "sourceLineId": "76822",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗਿਰੇ ਅੱਧ ਅੱਧੰ ॥੩੩॥",
      "transliteration": "gire a'dh a'dha(n) ||33||",
      "translation": "They shoot their arrows confronting the opponents, some of them fall down, having been chopped into halves.33.",
      "punjabiViakhya": "ਅਤੇ ਅੱਧੇ ਅੱਧੇ ਟੁਕੜੇ ਹੋ ਕੇ ਡਿਗ ਪੈਂਦੇ ਹਨ ॥੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "गिरे अद्ध अद्धं ॥३३॥",
      "sourceLineId": "76823",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗਜੰ ਬਾਜ ਜੱੁਝੇ ॥",
      "transliteration": "gaja(n) baaj ja'ujhe ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਥੀ ਅਤੇ ਘੋੜੇ ਵੀ ਜੂਝ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "गजं बाज जु्ुझे ॥",
      "sourceLineId": "76824",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਲੀ ਬੈਰ ਰੱੁਝੇ ॥",
      "transliteration": "balee bair ra'ujhe ||",
      "translation": "The elephants and horses are lying dead and the warriors engaged in enmity",
      "punjabiViakhya": "ਅਤੇ ਸੂਰਵੀਰ ਵੀ ਵੈਰ ਵਿਚ ਰੁਝੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "बली बैर रु्ुझे ॥",
      "sourceLineId": "76825",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨ੍ਰਿਭੈ ਸਸਤ੍ਰ ਬਾਹੈਂ ॥",
      "transliteration": "nirabhai sasatr baahai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨਿਰਭੈ ਹੋ ਕੇ ਸ਼ਸਤ੍ਰ ਚਲਾਉਾਂਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "नृभै ससत्र बाहैं ॥",
      "sourceLineId": "76826",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਉਭੈ ਜੀਤ ਚਾਹੈਂ ॥੩੪॥",
      "transliteration": "aubhai jeet chaahai(n) ||34||",
      "translation": "Fearlessly strike their weapons; both sides wish for their victory.34.",
      "punjabiViakhya": "ਅਤੇ ਦੋਹਾ (ਪਾਸਿਆਂ ਦੇ ਸੂਰਮੇ ਆਪਣੀ ਹੀ) ਜਿਤ ਚਾਹੁੰਦੇ ਹਨ ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "उभै जीत चाहैं ॥३४॥",
      "sourceLineId": "76827",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗਜੇ ਆਨਿ ਗਾਜੀ ॥",
      "transliteration": "gaje aan gaajee ||",
      "translation": "",
      "punjabiViakhya": "ਅਣਖ ਵਾਲੇ ਸੂਰਮੇ ਗਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "गजे आनि गाजी ॥",
      "sourceLineId": "76828",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਚੇ ਤੁੰਦ ਤਾਜੀ ॥",
      "transliteration": "nache tu(n)dh taajee ||",
      "translation": "The warriors are roaring and the swiftly-running horses dance.",
      "punjabiViakhya": "ਤਿਖੀ ਚਾਲ ਵਾਲੇ ਘੋੜੇ ਨਚ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "नचे तुँद ताजी ॥",
      "sourceLineId": "76829",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਕੰ ਹਾਕ ਬੱਜੀ ॥",
      "transliteration": "haka(n) haak ba'jee ||",
      "translation": "",
      "punjabiViakhya": "ਲਲਕਾਰੇ ਤੇ ਲਲਕਾਰਾ ਵਜ ਰਿਹਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "हकं हाक बज्जी ॥",
      "sourceLineId": "76830",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਫਿਰੈ ਸੈਨ ਭੱਜੀ ॥੩੫॥",
      "transliteration": "firai sain bha'jee ||35||",
      "translation": "There are shouts and in this way the army is running about. 35.",
      "punjabiViakhya": "ਅਤੇ ਸੈਨਾ (ਇਧਰ ਉਧਰ) ਭਜੀ ਫਿਰਦੀ ਹੈ ॥੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "फिरै सैन भज्जी ॥३५॥",
      "sourceLineId": "76831",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਦੰ ਮੱਤ ਮਾਤੇ ॥",
      "transliteration": "madha(n) ma't maate ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਸ਼ਰਾਬ ਨਾਲ ਮਸਤੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "मदं मत्त माते ॥",
      "sourceLineId": "76832",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਸੰ ਰੁਦ੍ਰ ਰਾਤੇ ॥",
      "transliteration": "rasa(n) rudhr raate ||",
      "translation": "The warriors are intoxicated with wine and are absorbed in great rage.",
      "punjabiViakhya": "ਰੌਦਰ ਰਸ ਵਿਚ ਪੂਰੀ ਤਰ੍ਹਾ ਮਗਨ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "रसं रुद्र राते ॥",
      "sourceLineId": "76833",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗਜੰ ਜੂਹ ਸਾਜੇ ॥",
      "transliteration": "gaja(n) jooh saaje ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਥੀ ਦੇ ਝੁੰਡ ਸਜੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "गजं जूह साजे ॥",
      "sourceLineId": "76834",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭਿਰੇ ਰੋਸ ਬਾਜੇ ॥੩੬॥",
      "transliteration": "bhire ros baaje ||36||",
      "translation": "The group of elephants are adorned and the warriors are fighting with increased anger. 36.",
      "punjabiViakhya": "ਅਤੇ ਰੋਸ ਵਧਾ ਕੇ ਭਿੜ ਰਹੇ ਹਨ ॥੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "भिरे रोस बाजे ॥३६॥",
      "sourceLineId": "76835",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਝਮੀ ਤੇਜ ਤੇਗੰ ॥",
      "transliteration": "jhamee tej tega(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਜ਼ ਤਲਵਾਰਾ ਇਸ ਤਰ੍ਹਾ ਚਮਕ ਰਹੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "झमी तेज तेगं ॥",
      "sourceLineId": "76836",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਘਣੰ ਬਿਜ ਬੇਗੰ ॥",
      "transliteration": "ghana(n) bij bega(n) ||",
      "translation": "The sharp swords glisten like the flash of lightning in the clouds.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਬਦਲਾ ਵਿਚ ਬਿਜਲੀ ਦੀ ਚਾਲ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "घणं बिज बेगं ॥",
      "sourceLineId": "76837",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਹੈ ਬਾਰ ਬੈਰੀ ॥",
      "transliteration": "bahai baar bairee ||",
      "translation": "",
      "punjabiViakhya": "ਵੈਰੀਆਂ ਦੇ ਘੋੜੇ ਇਉਾਂ ਨਸੇ ਫਿਰਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "बहै बार बैरी ॥",
      "sourceLineId": "76838",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਲੰ ਜਯੋ ਗੰਗੈਰੀ ॥੩੭॥",
      "transliteration": "jala(n) jayo ga(n)gairee ||37||",
      "translation": "The blows are struck on the enemy like the swift-moving water-insect.37.",
      "punjabiViakhya": "ਜਿਉਾਂ ਜਲ ਉਤੇ ਗੰਗੈਰੀ (ਜਲ ਜੁਲਾਹਾ) ਭਜਿਆ ਫਿਰਦਾ ਹੈ ॥੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "जलं जयो गंगैरी ॥३७॥",
      "sourceLineId": "76839",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਪੋ ਆਪ ਬਾਹੰ ॥",
      "transliteration": "apo aap baaha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਸ ਵਿਚ (ਆਹਮੋ ਸਾਹਮਣੇ ਸ਼ਸਤ੍ਰ) ਚਲਾਉਾਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "अपो आप बाहं ॥",
      "sourceLineId": "76840",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਉਭੈ ਜੀਤ ਚਾਹੰ ॥",
      "transliteration": "aubhai jeet chaaha(n) ||",
      "translation": "They strike weapons confronting each other; both sides wish for their victory.",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਪਾਸੇ (ਆਪਣੀ ਆਪਣੀ) ਜਿਤ ਚਾਹੁੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "उभै जीत चाहं ॥",
      "sourceLineId": "76841",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰਸੰ ਰੁਦ੍ਰ ਰਾਤੇ ॥",
      "transliteration": "rasa(n) rudhr raate ||",
      "translation": "",
      "punjabiViakhya": "ਰੌਦਰ ਰਸ ਵਿਚ ਰਤੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "रसं रुद्र राते ॥",
      "sourceLineId": "76842",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮਹਾਂ ਮੱਤ ਮਾਤੇ ॥੩੮॥",
      "transliteration": "mahaa(n) ma't maate ||38||",
      "translation": "They are absorbed in violent rage and are highly intoxicated.38.",
      "punjabiViakhya": "(ਨਸ਼ੇ ਵਿਚ) ਬਹੁਤ ਮਸਤ ਹੋਏ ਹੋਏ ਹਨ ॥੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "महाँ मत्त माते ॥३८॥",
      "sourceLineId": "76843",
      "sourceShabadId": "7477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "76844",
      "sourceShabadId": "7478",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਚੇ ਬੀਰ ਬੀਰੰ ਅਭੂਤੰ ਭਯਾਣੰ ॥",
      "transliteration": "mache beer beera(n) abhoota(n) bhayaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਸੂਰਮਿਆਂ ਨਾਲ ਲੜਦੇ ਹੋਏ ਅਲੌਕਿਕ ਅਤੇ ਭਿਆਨਕ ਹੋ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "मचे बीर बीरं अभूतं भयाणं ॥",
      "sourceLineId": "76845",
      "sourceShabadId": "7478",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਜੀ ਭੇਰ ਭੁੰਕਾਰ ਧੱੁਕੇ ਨਿਸਾਣੰ ॥",
      "transliteration": "bajee bher bhu(n)kaar dha'uke nisaana(n) ||",
      "translation": "The warriors fighting with warriors are looking wonderfully frightening. The clattering sound of kettledrums is heard and there is also the thunder of trumpets.",
      "punjabiViakhya": "ਵਜਦੀਆਂ ਭੇਰੀਆਂ ਦੀ ਭੁੰਕਾਰ ਅਤੇ ਧੌਂਸਿਆਂ ਦੀ (ਧੁੰਕਾਰ) ਸੁਣਾਈ ਦਿੰਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "बजी भेर भुँकार धु्ुके निसाणं ॥",
      "sourceLineId": "76846",
      "sourceShabadId": "7478",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਵੰ ਨੱਦ ਨੀਸਾਣ ਗੱਜੇ ਗਹੀਰੰ ॥",
      "transliteration": "nava(n) na'dh neesaan ga'je gaheera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨਵੇਾਂ ਧੌਂਸਿਆਂ ਦੇ ਵਜਣ ਨਾਲ ਗੰਭੀਰ ਸ਼ਬਦ ਨਿਕਲਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "नवं नद्द नीसाण गज्जे गहीरं ॥",
      "sourceLineId": "76847",
      "sourceShabadId": "7478",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਫਿਰੈ ਰੁੰਡ ਮੁੰਡੰ ਤਨੰ ਤੱਛ ਤੀਰੰ ॥੩੯॥",
      "transliteration": "firai ru(n)dd mu(n)dda(n) tana(n) ta'chh teera(n) ||39||",
      "translation": "The serious tone of the new trumpets resounds. Somewhere the trunks, somewhere the heads, somewhere the bodies hewed by arrows are seen moving.39.",
      "punjabiViakhya": "ਅਤੇ ਰੁੰਡ, ਮੁੰਡ ਅਤੇ ਤੀਰਾ ਨਾਲ ਪੱਛੇ ਹੋਏ ਸ਼ਰੀਰ (ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਇਧਰ ਉਧਰ) ਫਿਰ ਰਹੇ ਹਨ ॥੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "फिरै रुँड मुँडं तनं तच्छ तीरं ॥३९॥",
      "sourceLineId": "76848",
      "sourceShabadId": "7478",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਹੇ ਖੱਗ ਖੇਤੰ ਖਿਆਲੰ ਖਤੰਗੰ ॥",
      "transliteration": "bahe kha'g kheta(n) khiaala(n) khata(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਤਲਵਾਰ ਚਲਦੀ ਹੈ, ਤੀਰਾ (ਖਤੰਗ) ਦੀ ਸ਼ਿਸ਼ਤਾ (ਖਿਆਲੰ) ਬੰਨ੍ਹ ਕੇ (ਬੌਛਾੜ) ਹੁੰਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "बहे खग्ग खेतं खिआलं खतंगं ॥",
      "sourceLineId": "76849",
      "sourceShabadId": "7478",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਰੁਲੇ ਤੱਛ ਮੁੱਛੰ ਮਹਾ ਜੋਧ ਜੰਗੰ ॥",
      "transliteration": "rule ta'chh mu'chha(n) mahaa jodh ja(n)ga(n) ||",
      "translation": "The warriors strike their swords and care for their arrows in the battlefield. The great heroes, chopped in the war are rolling in dust.",
      "punjabiViakhya": "ਵੱਡੇ ਵੱਡੇ ਯੋਧੇ ਵੱਢੇ ਕਟੇ (ਰਣ ਵਿਚ) ਰੁਲ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "रुले तच्छ मुच्छं महा जोध जंगं ॥",
      "sourceLineId": "76850",
      "sourceShabadId": "7478",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬੰਧੇ ਬੀਰ ਬਾਨਾ ਬਡੇ ਐਠਿ ਵਾਰੇ ॥",
      "transliteration": "ba(n)dhe beer baanaa badde aaiTh vaare ||",
      "translation": "",
      "punjabiViakhya": "ਵਡੇ ਆਕੜਖਾਨ ਯੋਧਿਆਂ ਨੇ (ਸ਼ਹਾਦਤ ਦੇ) ਬਾਣੇ ਸਜਾਏ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "बंधे बीर बाना बडे ऐठि वारे ॥",
      "sourceLineId": "76851",
      "sourceShabadId": "7478",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਘੁਮੈ ਲੋਹ ਘੁੱਟੰ ਮਨੋ ਮਤਵਾਰੇ ॥੪੦॥",
      "transliteration": "ghumai loh ghu'Ta(n) mano matavaare ||40||",
      "translation": "The greatly proud warriors, having tied their quivers and equipped with armour move in the battlefield like the drunkards.40.",
      "punjabiViakhya": "ਉਹ ਸ਼ਸਤ੍ਰਾ (ਲੋਹ) ਦੇ ਵਾਰ ਸਹਿ ਕੇ (ਘੁਟ ਭਰ ਕੇ) ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਮਤਵਾਲੇ ਹੋਏ ਫਿਰਦੇ ਹਨ ॥੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "घुमै लोह घुट्टं मनो मतवारे ॥४०॥",
      "sourceLineId": "76852",
      "sourceShabadId": "7478",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਉਠੀ ਕੂਹ ਜੂਹੰ ਸਮਰ ਸਾਰ ਬੱਜਿਯੰ ॥",
      "transliteration": "auThee kooh jooha(n) samar saar ba'jiya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯੂੱਧ-ਭੂਮੀ ਵਿਚ ਸ਼ਸਤ੍ਰਾ ਦੇ (ਇਕ ਦੂਜੇ ਉਤੇ) ਵਜਣ ਨਾਲ ਹਰ ਪਾਸੇ ਰੌਲਾ ਪੈ ਗਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "उठी कूह जूहं समर सार बज्जियं ॥",
      "sourceLineId": "76853",
      "sourceShabadId": "7478",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਿਧੋ ਅੰਤ ਕੇ ਕਾਲ ਕੋ ਮੇਘ ਗੱਜਿਯੰ ॥",
      "transliteration": "kidho a(n)t ke kaal ko megh ga'jiya(n) ||",
      "translation": "The weapons were struck and there was confusion all around, it seemed that the clouds of doomsday were thundering.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕਿਤੋਂ ਪਰਲੋ ਦੇ ਸਮੇਾਂ ਦੇ ਬਦਲ ਗਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "किधो अंत के काल को मेघ गज्जियं ॥",
      "sourceLineId": "76854",
      "sourceShabadId": "7478",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0052_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਭਈ ਤੀਰ ਭੀਰੰ ਕਮਾਣੰ ਕੱੜਕਿਯੰ ॥",
      "transliteration": "bhiee teer bheera(n) kamaana(n) ka'Rakiya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰਾ ਦੀ ਬੌਛਾੜ ਲਗ ਗਈ ਹੈ ਅਤੇ ਕਮਾਨਾ ਕੜਕਣ ਲਗ ਗਈਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 52,
      "hindi": "",
      "hindiTransliteration": "भई तीर भीरं कमाणं कड़्ड़कियं ॥",
      "sourceLineId": "76855",
      "sourceShabadId": "7478",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    }
  ]
}
