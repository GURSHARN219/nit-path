{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 56,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0056_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਿਸਨ ਆਪ ਹੀ ਕੋ ਠਹਿਰਾਯੋ ॥",
      "transliteration": "bisan aap hee ko Thahiraayo ||",
      "translation": "Mahadeo (Shiva) was called Achyuta (blotless), Vishnu considered himself the Supreme.",
      "punjabiViakhya": "ਅਤੇ ਵਿਸ਼ਣੂ ਨੇ ਆਪਣੇ ਆਪ ਨੂੰ (ਪਰਮੇਸ਼ਵਰ) ਸਥਾਪਿਤ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "बिसन आप ही को ठहिरायो ॥",
      "sourceLineId": "77048",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬ੍ਰਹਮਾ ਆਪ ਪਾਰਬ੍ਰਹਮ ਬਖਾਨਾ ॥",
      "transliteration": "brahamaa aap paarabraham bakhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਹਮਾ ਨੇ ਖੁਦ ਨੂੰ ਪਾਰਬ੍ਰਹਮ ਦਸਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "ब्रहमा आप पारब्रहम बखाना ॥",
      "sourceLineId": "77049",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪ੍ਰਭ ਕੋ ਪ੍ਰਭੂ ਨ ਕਿਨਹੂੰ ਜਾਨਾ ॥੮॥",
      "transliteration": "prabh ko prabhoo na kinahoo(n) jaanaa ||8||",
      "translation": "Brahma called himself Para Brahman, none could comprehend the Lord.8.",
      "punjabiViakhya": "ਅਤੇ ਪ੍ਰਭੂ ਨੂੰ ਪ੍ਰਭੂ ਕਰ ਕੇ ਕਿਸੇ ਨੇ ਵੀ ਨਹੀਂ ਜਾਣਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "प्रभ को प्रभू न किनहूँ जाना ॥८॥",
      "sourceLineId": "77050",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਬ ਸਾਖੀ ਪ੍ਰਭ ਅਸਟ ਬਨਾਏ ॥",
      "transliteration": "tab saakhee prabh asaT banaae ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਪਰਮਾਤਮਾ ਨੇ) ਅੱਠ ਸਾਖੀ (ਚੰਦ੍ਰਮਾ, ਸੂਰਜ, ਪ੍ਰਿਥਵੀ, ਧ੍ਰੁਵ, ਅਗਨੀ, ਪਵਨ, ਪ੍ਰਤ੍ਰਯੂਸ਼ ਅਤੇ ਪ੍ਰਭਾਸ) ਬਣਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "तब साखी प्रभ असट बनाए ॥",
      "sourceLineId": "77051",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਾਖ ਨਮਿਤ ਦੇਬੇ ਠਹਿਰਾਏ ॥",
      "transliteration": "saakh namit dhebe Thahiraae ||",
      "translation": "Then I created eight Sakshis in order to give evidence of my Entity.",
      "punjabiViakhya": "ਅਤੇ ਸਾਖ (ਗਵਾਹੀ) ਦੇਣ ਲਈ ਸਥਾਪਿਤ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "साख नमित देबे ठहिराए ॥",
      "sourceLineId": "77052",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤੇ ਕਹੈ ਕਰੋ ਹਮਾਰੀ ਪੂਜਾ ॥",
      "transliteration": "te kahai karo hamaaree poojaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਹਾ ਨੇ ਵੀ) ਕਹਿਣਾ ਸ਼ੁਰੂ ਕਰ ਦਿੱਤਾ ਕਿ ਸਾਡੀ ਪੂਜਾ ਕਰੋ",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "ते कहै करो हमारी पूजा ॥",
      "sourceLineId": "77053",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਮ ਬਿਨ ਅਵਰੁ ਨ ਠਾਕੁਰੁ ਦੂਜਾ ॥੯॥",
      "transliteration": "ham bin avar na Thaakur dhoojaa ||9||",
      "translation": "But they considered themselves all in all and asked the people to worship them.9.",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ) ਸਾਡੇ ਤੋਂ ਬਿਨਾ ਕੋਈ ਠਾਕੁਰ ਨਹੀਂ ਹੈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "हम बिन अवरु न ठाकुरु दूजा ॥९॥",
      "sourceLineId": "77054",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪਰਮ ਤੱਤ ਕੋ ਜਿਨ ਨ ਪਛਾਨਾ ॥",
      "transliteration": "param ta't ko jin na pachhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਹਾ ਨੇ ਪਰਮ-ਤੱਤ੍ਵ ਨੂੰ ਨਹੀਂ ਪਛਾਣਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "परम तत्त को जिन न पछाना ॥",
      "sourceLineId": "77055",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਿਨ ਕਰਿ ਈਸਰ ਤਿਨ ਕਹੁ ਮਾਨਾ ॥",
      "transliteration": "tin kar ieesar tin kahu maanaa ||",
      "translation": "Those who did not comprehend the Lord, they were considered as Ishvara.",
      "punjabiViakhya": "ਉਨ੍ਹਾ ਨੇ ਅੱਠਾ ਸਾਖੀਆਂ ਨੂੰ ਈਸ਼ਵਰ ਕਰ ਕੇ ਮੰਨ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "तिन करि ईसर तिन कहु माना ॥",
      "sourceLineId": "77056",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕੇਤੇ ਸੂਰ ਚੰਦ ਕਹੁ ਮਾਨੈ ॥",
      "transliteration": "kete soor cha(n)dh kahu maanai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਚੰਦ੍ਰਮਾ ਅਤੇ ਸੂਰਜ ਨੂੰ ਮੰਨਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "केते सूर चंद कहु मानै ॥",
      "sourceLineId": "77057",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਗਨਿ ਹੋਤ੍ਰ ਕਈ ਪਵਨ ਪ੍ਰਮਾਨੈ ॥੧੦॥",
      "transliteration": "agan hotr kiee pavan pramaanai ||10||",
      "translation": "Several people worshipped the sun and the moon and several others worshipped Fire and Ait.10.",
      "punjabiViakhya": "ਕਈ ਅਗਨੀ ਹੋਤ੍ਰ ਕਰਦੇ ਰਹੇ ਅਤੇ ਕਈ ਪੌਣ ਨੂੰ ਮਾਨਤਾ ਦਿੰਦੇ ਰਹੇ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "अगनि होत्र कई पवन प्रमानै ॥१०॥",
      "sourceLineId": "77058",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਿਨਹੂੰ ਪ੍ਰਭੁ ਪਾਹਨ ਪਹਿਚਾਨਾ ॥",
      "transliteration": "kinahoo(n) prabh paahan pahichaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਈਆਂ ਨੇ ਪੱਥਰ ਨੂੰ ਪ੍ਰਭੂ ਕਰ ਕੇ ਪਛਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "किनहूँ प्रभु पाहन पहिचाना ॥",
      "sourceLineId": "77059",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨ੍ਹਾਤ ਕਿਤੇ ਜਲ ਕਰਤ ਬਿਧਾਨਾ ॥",
      "transliteration": "nhaat kite jal karat bidhaanaa ||",
      "translation": "Several of them considered God as stone and several others bathed considering the Lordship of Water.",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਜਲ ਵਿਚ ਇਸ਼ਨਾਨ ਕਰਨ ਦਾ ਵਿਧਾਨ ਕਰਦੇ ਰਹੇ।",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "न्हात किते जल करत बिधाना ॥",
      "sourceLineId": "77060",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕੇਤਿਕ ਕਰਮ ਕਰਤ ਡਰਪਾਨਾ ॥",
      "transliteration": "ketik karam karat ddarapaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਕਰਮ ਕਰਦਿਆਂ ਡਰਦੇ ਰਹੇ",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "केतिक करम करत डरपाना ॥",
      "sourceLineId": "77061",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਧਰਮ ਰਾਜ ਕੋ ਧਰਮ ਪਛਾਨਾ ॥੧੧॥",
      "transliteration": "dharam raaj ko dharam pachhaanaa ||11||",
      "translation": "Considering Dharmaraja as the Supreme representative of Dharma, several bore fear of him in their actions. 11.",
      "punjabiViakhya": "ਅਤੇ ਕਈਆਂ ਨੇ ਧਰਮਰਾਜ ਨੂੰ ਹੀ ਪਰਮਾਤਮਾ ਸਮਝਣ ਦਾ ਵਿਚਾਰ ਪ੍ਰਚਲਿਤ ਕੀਤਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "धरम राज को धरम पछाना ॥११॥",
      "sourceLineId": "77062",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜੋ ਪ੍ਰਭ ਸਾਖ ਨਮਿਤ ਠਹਿਰਾਏ ॥",
      "transliteration": "jo prabh saakh namit Thahiraae ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਪ੍ਰਭੂ ਨੇ ਸਾਖੀ ਦੇਣ ਲਈ ਸਥਾਪਿਤ ਕੀਤੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "जो प्रभ साख नमित ठहिराए ॥",
      "sourceLineId": "77063",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤੇ ਹਿਆਂ ਆਇ ਪ੍ਰਭੂ ਕਹਵਾਏ ॥",
      "transliteration": "te hiaa(n) aai prabhoo kahavaae ||",
      "translation": "All those whom God established for the revelation of His Supremacy, they themselves were called Supreme.",
      "punjabiViakhya": "ਉਹ ਇਥੇ ਆ ਕੇ ਪ੍ਰਭੂ ਅਖਵਾਉਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "ते हिआँ आइ प्रभू कहवाए ॥",
      "sourceLineId": "77064",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾ ਕੀ ਬਾਤ ਬਿਸਰ ਜਾਤੀ ਭੀ ॥",
      "transliteration": "taa kee baat bisar jaatee bhee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਹਾ ਨੂੰ) ਪ੍ਰਭੂ ਦੀ ਗੱਲ ਹੀ ਭੁਲ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "ता की बात बिसर जाती भी ॥",
      "sourceLineId": "77065",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਪਨੀ ਅਪਨੀ ਪਰਤ ਸੋਭ ਭੀ ॥੧੨॥",
      "transliteration": "apanee apanee parat sobh bhee ||12||",
      "translation": "They forgot the Lord in their race for supremacy. 12",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੀ ਆਪਣੀ ਸ਼ੋਭਾ ਵਿਚ ਹੀ ਲਗੇ ਰਹੇ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "अपनी अपनी परत सोभ भी ॥१२॥",
      "sourceLineId": "77066",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਬ ਪ੍ਰਭ ਕੋ ਨ ਤਿਨੈ ਪਹਿਚਾਨਾ ॥",
      "transliteration": "jab prabh ko na tinai pahichaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਉਨ੍ਹਾ ਨੇ ਪ੍ਰਭੂ ਨੂੰ ਨਾ ਪਛਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "जब प्रभ को न तिनै पहिचाना ॥",
      "sourceLineId": "77067",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਬ ਹਰਿ ਇਨ ਮਨੁਛਨ ਠਹਿਰਾਨਾ ॥",
      "transliteration": "tab har in manuchhan Thahiraanaa ||",
      "translation": "When they did not comprehend the Lord, then I established human beings in their place.",
      "punjabiViakhya": "ਤਾ ਹਰਿ ਨੇ ਇਨ੍ਹਾ ਮਨੁੱਖਾ ਨੂੰ ਕਾਇਮ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "तब हरि इन मनुछन ठहिराना ॥",
      "sourceLineId": "77068",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤੇ ਭੀ ਬਸਿ ਮਮਤਾ ਹੁਇ ਗਏ ॥",
      "transliteration": "te bhee bas mamataa hui ge ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਵੀ ਮਮਤਾ ਦੇ ਵਸ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "ते भी बसि ममता हुइ गए ॥",
      "sourceLineId": "77069",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪਰਮੇਸਰ ਪਾਹਨ ਠਹਿਰਏ ॥੧੩॥",
      "transliteration": "paramesar paahan Thahire ||13||",
      "translation": "They also were overpowered by ‘mineness’ and exhibited the Lord in statues.13.",
      "punjabiViakhya": "ਅਤੇ ਪਰਮੇਸ਼ਵਰ ਨੂੰ ਮੂਰਤੀ ਵਿਚ ਮੰਨਣਾ ਸ਼ੁਰੂ ਕੀਤਾ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "परमेसर पाहन ठहिरए ॥१३॥",
      "sourceLineId": "77070",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਬ ਹਰਿ ਸਿੱਧ ਸਾਧ ਠਹਿਰਾਏ ॥",
      "transliteration": "tab har si'dh saadh Thahiraae ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹਰਿ ਨੇ ਸਿੱਧ ਅਤੇ ਸਾਧ ਪੈਦਾ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "तब हरि सिद्ध साध ठहिराए ॥",
      "sourceLineId": "77071",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਿਨ ਭੀ ਪਰਮ ਪੁਰਖ ਨਹੀ ਪਾਏ ॥",
      "transliteration": "tin bhee param purakh nahee paae ||",
      "translation": "Then I created Siddhas and sadhs, who also could not realize the Lord.",
      "punjabiViakhya": "(ਪਰ) ਉਨ੍ਹਾ ਨੇ ਵੀ ਪਰਮਾਤਮਾ ਨੂੰ ਪ੍ਰਾਪਤ ਨਹੀਂ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "तिन भी परम पुरख नही पाए ॥",
      "sourceLineId": "77072",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੇ ਕੋਈ ਹੋਤ ਭਯੋ ਜਗਿ ਸਿਆਨਾ ॥",
      "transliteration": "je koiee hot bhayo jag siaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਕੋਈ ਜਗਤ ਵਿਚ ਸਿਆਣਾ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "जे कोई होत भयो जगि सिआना ॥",
      "sourceLineId": "77073",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਿਨ ਤਿਨ ਅਪਨੋ ਪੰਥੁ ਚਲਾਨਾ ॥੧੪॥",
      "transliteration": "tin tin apano pa(n)th chalaanaa ||14||",
      "translation": "On whomsoever wisdom dawned, he started his own path. 14.",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੇ ਵੀ ਆਪਣਾ ਆਪਣਾ (ਵਖਰਾ) ਪੰਥ ਚਲਾਇਆ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "तिन तिन अपनो पंथु चलाना ॥१४॥",
      "sourceLineId": "77074",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪਰਮ ਪੁਰਖ ਕਿਨਹੂੰ ਨਹ ਪਾਯੋ ॥",
      "transliteration": "param purakh kinahoo(n) neh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਮ ਪੁਰਖ ਕਿਸੇ ਨੇ ਪ੍ਰਾਪਤ ਨਹੀਂ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "परम पुरख किनहूँ नह पायो ॥",
      "sourceLineId": "77075",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬੈਰ ਬਾਦ ਅਹੰਕਾਰ ਬਢਾਯੋ ॥",
      "transliteration": "bair baadh aha(n)kaar baddaayo ||",
      "translation": "None could realise the Supreme Lord, but instead spread strife, enmity and ego.",
      "punjabiViakhya": "(ਸਗੋਂ) ਵੈਰ, ਵਾਦ-ਵਿਵਾਦ ਅਤੇ ਹੰਕਾਰ ਵਧਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "बैर बाद अहंकार बढायो ॥",
      "sourceLineId": "77076",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪੇਡ ਪਾਤ ਆਪਨ ਤੇ ਜਲੈ ॥",
      "transliteration": "pedd paat aapan te jalai ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਵੇਾਂ) ਬ੍ਰਿਛਾ ਦੇ ਪੱਤਰ ਆਪਣੇ ਆਪ ਹੀ ਜਲਣ ਲਗਦੇ ਹਨ (ਉਸੇ ਤਰ੍ਹਾ ਉਹ ਲੋਕ ਆਪਣੇ ਵਿਕਾਰਾ ਕਾਰਨ ਸੜ ਗਏ)",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "पेड पात आपन ते जलै ॥",
      "sourceLineId": "77077",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪ੍ਰਭ ਕੈ ਪੰਥ ਨ ਕੋਊ ਚਲੈ ॥੧੫॥",
      "transliteration": "prabh kai pa(n)th na kouoo chalai ||15||",
      "translation": "The tree and the leaves began to burn, because of the inner fire.None followed the path of the Lord.15.",
      "punjabiViakhya": "ਪਰ ਪਰਮਾਤਮਾ ਦੇ ਮਾਰਗ ਉਤੇ ਕੋਈ ਨਹੀਂ ਚਲਿਆ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "प्रभ कै पंथ न कोऊ चलै ॥१५॥",
      "sourceLineId": "77078",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਿਨਿ ਜਿਨਿ ਤਨਿਕ ਸਿੱਧ ਕੋ ਪਾਯੋ ॥",
      "transliteration": "jin jin tanik si'dh ko paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਜਿਸ ਨੇ ਰਤਾ ਕੁ ਸਿੱਧੀ ਪ੍ਰਾਪਤ ਕੀਤੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "जिनि जिनि तनिक सिद्ध को पायो ॥",
      "sourceLineId": "77079",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਿਨ ਤਿਨ ਅਪਨਾ ਰਾਹੁ ਚਲਾਯੋ ॥",
      "transliteration": "tin tin apanaa raahu chalaayo ||",
      "translation": "Whosoever attained a little spiritual power, he started his own path.",
      "punjabiViakhya": "ਉਸ ਨੇ ਆਪਣਾ ਆਪਣਾ ਮਾਰਗ ਚਲਾ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "तिन तिन अपना राहु चलायो ॥",
      "sourceLineId": "77080",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪਰਮੇਸਰ ਨ ਕਿਨਹੂੰ ਪਹਿਚਾਨਾ ॥",
      "transliteration": "paramesar na kinahoo(n) pahichaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਮੇਸ਼ਵਰ ਨੂੰ ਕਿਸੇ ਨੇ ਨਹੀਂ ਪਛਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "परमेसर न किनहूँ पहिचाना ॥",
      "sourceLineId": "77081",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਮ ਉਚਾਰਤੇ ਭਯੋ ਦਿਵਾਨਾ ॥੧੬॥",
      "transliteration": "mam uchaarate bhayo dhivaanaa ||16||",
      "translation": "None could comprehend the Lord, but instead became mad with ‘I-ness’.16.",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੀ ਉਪਾਸਨਾ ਕਾਰਨ (ਸਭ) ਦਿਵਾਨੇ ਹੋ ਗਏ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "मम उचारते भयो दिवाना ॥१६॥",
      "sourceLineId": "77082",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪਰਮ ਤੱਤ ਕਿਨਹੂੰ ਨ ਪਛਾਨਾ ॥",
      "transliteration": "param ta't kinahoo(n) na pachhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਮ-ਸੱਤਾ ਨੂੰ ਕਿਸੇ ਨੇ ਨਹੀਂ ਪਛਾਣਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "परम तत्त किनहूँ न पछाना ॥",
      "sourceLineId": "77083",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਆਪ ਆਪ ਭੀਤਰਿ ਉਰਝਾਨਾ ॥",
      "transliteration": "aap aap bheetar urajhaanaa ||",
      "translation": "Nobody recognized the Supreme Essence, but was entangled within himself.",
      "punjabiViakhya": "ਆਪਣੇ ਆਪ ਵਿਚ ਹੀ ਉਲਝ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "आप आप भीतरि उरझाना ॥",
      "sourceLineId": "77084",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਬ ਜੇ ਜੇ ਰਿਖਰਾਜ ਬਨਾਏ ॥",
      "transliteration": "tab je je rikharaaj banaae ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਜੋ ਜੋ ਰਾਜ ਰਿਸ਼ੀ ਬਣਾਏ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "तब जे जे रिखराज बनाए ॥",
      "sourceLineId": "77085",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਿਨ ਆਪਨ ਪੁਨ ਸਿੰਮ੍ਰਿਤ ਚਲਾਏ ॥੧੭॥",
      "transliteration": "tin aapan pun si(n)mirat chalaae ||17||",
      "translation": "All the great rishis (sages), who were then created, produced their own Smritis.17.",
      "punjabiViakhya": "ਉਨ੍ਹਾ ਨੇ ਫਿਰ ਆਪਣੀਆਂ ਸਮ੍ਰਿਤੀਆਂ (ਧਰਮ-ਮਰਯਾਦਾ ਦੀਆਂ ਪੁਸਤਕਾ) ਦਾ ਪ੍ਰਚਲਨ ਕਰ ਦਿੱਤਾ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "तिन आपन पुन सिंमृत चलाए ॥१७॥",
      "sourceLineId": "77086",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜੇ ਸਿੰਮ੍ਰਿਤਨ ਕੇ ਭਏ ਅਨੁਰਾਗੀ ॥",
      "transliteration": "je si(n)mritan ke bhe anuraagee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੜੇ ਜਿਹੜੇ (ਉਨ੍ਹਾ) ਸਮ੍ਰਿਤੀਆਂ ਵਿਚ ਪ੍ਰੇਮ ਪਾਣ ਲਗ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "जे सिंमृतन के भए अनुरागी ॥",
      "sourceLineId": "77087",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਿਨਿ ਤਿਨਿ ਕ੍ਰਿਆ ਬ੍ਰਹਮ ਕੀ ਤਿਆਗੀ ॥",
      "transliteration": "tin tin kriaa braham kee tiaagee ||",
      "translation": "All those who became followers of these smritis, they abandoned the path of the Lord.",
      "punjabiViakhya": "ਉਨ੍ਹਾ ਨੇ (ਸੱਚੀ) ਅਧਿਆਤਮਿਕ ਸਾਧਨਾ ਦਾ ਤਿਆਗ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "तिनि तिनि कृआ ब्रहम की तिआगी ॥",
      "sourceLineId": "77088",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਿਨ ਮਨ ਹਰਿ ਚਰਨਨ ਠਹਿਰਾਯੋ ॥",
      "transliteration": "jin man har charanan Thahiraayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਹਾ ਨੇ ਆਪਣਾ ਮਨ ਹਰਿ ਚਰਨਾ ਨਾਲ ਜੋੜਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "जिन मन हरि चरनन ठहिरायो ॥",
      "sourceLineId": "77089",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੋ ਸਿੰਮ੍ਰਿਤਨ ਕੇ ਰਾਹ ਨ ਆਯੋ ॥੧੮॥",
      "transliteration": "so si(n)mritan ke raeh na aayo ||18||",
      "translation": "Those who devoted themselves to the Feet of the Lord, they did not adopt the path of the Smritis.18.",
      "punjabiViakhya": "ਉਹ ਸਮ੍ਰਿਤੀਆਂ ਦੇ (ਧਰਮ) ਮਾਰਗ ਉਤੇ ਨਹੀਂ ਚਲੇ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "सो सिंमृतन के राह न आयो ॥१८॥",
      "sourceLineId": "77090",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬ੍ਰਹਮਾ ਚਾਰ ਹੀ ਬੇਦ ਬਨਾਏ ॥",
      "transliteration": "brahamaa chaar hee bedh banaae ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਹਮਾ ਨੇ ਚਾਰ ਵੇਦਾ ਦੀ ਰਚਨਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "ब्रहमा चार ही बेद बनाए ॥",
      "sourceLineId": "77091",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਰਬ ਲੋਕ ਤਿਹ ਕਰਮ ਚਲਾਏ ॥",
      "transliteration": "sarab lok teh karam chalaae ||",
      "translation": "Brahma composed all the four Vedas, all the people followed the injunctions contained in them.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਲੋਕਾ ਨੂੰ (ਵੇਦ ਅਨੁਸਾਰੀ) ਕਰਮ ਮਾਰਗ ਉਤੇ ਤੋਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "सरब लोक तिह करम चलाए ॥",
      "sourceLineId": "77092",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਿਨ ਕੀ ਲਿਵ ਹਰਿ ਚਰਨਨ ਲਾਗੀ ॥",
      "transliteration": "jin kee liv har charanan laagee ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ) ਜਿਨ੍ਹਾ ਦੀ ਲਿਵ ਹਰਿ-ਚਰਨਾ ਨਾਲ ਲਗ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 56,
      "hindi": "",
      "hindiTransliteration": "जिन की लिव हरि चरनन लागी ॥",
      "sourceLineId": "77093",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0056_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤੇ ਬੇਦਨ ਤੇ ਭਏ ਤਿਆਗੀ ॥੧੯॥",
      "transliteration": "te bedhan te bhe tiaagee ||19||",
