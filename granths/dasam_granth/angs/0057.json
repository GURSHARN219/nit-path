{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 57,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0057_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਕੇ ਭੇ ਅਨੁਰਾਗੀ ॥",
      "transliteration": "paarabraham ke bhe anuraagee ||",
      "translation": "Those who abandoned the path of the Vedas and Katebs, they became the devotees of the Lord.",
      "punjabiViakhya": "(ਉਹ) ਪਾਰਬ੍ਰਹਮ ਦੇ (ਸੱਚੇ ਅਰਥਾ ਵਿਚ) ਪ੍ਰੇਮੀ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "पारब्रहम के भे अनुरागी ॥",
      "sourceLineId": "77096",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਿਨ ਕੇ ਗੂੜ ਮੱਤ ਜੇ ਚਲਹੀ ॥",
      "transliteration": "tin ke gooR ma't je chalahee ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ (ਕੋਈ) ਪਾਰਬ੍ਰਹਮ ਦੇ ਗੰਭੀਰ ਸਿੱਧਾਤਾ ਅਨੁਸਾਰ ਚਲੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "तिन के गूड़ मत्त जे चलही ॥",
      "sourceLineId": "77097",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭਾਂਤਿ ਅਨੇਕ ਦੁਖਨ ਸੋ ਦਲਹੀ ॥੨੦॥",
      "transliteration": "bhaa(n)t anek dhukhan so dhalahee ||20||",
      "translation": "Whosoever follows their path, he crushes various types of sufferings.20.",
      "punjabiViakhya": "ਉਹ (ਆਪਣੇ) ਅਨੇਕ ਪ੍ਰਕਾਰ ਦੇ ਦੁਖਾ ਨੂੰ ਨਸ਼ਟ ਕਰ ਦੇਵੇਗਾ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "भाँति अनेक दुखन सो दलही ॥२०॥",
      "sourceLineId": "77098",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੇ ਜੇ ਸਹਿਤ ਜਾਤਨ ਸੰਦੇਹਿ ॥",
      "transliteration": "je je sahit jaatan sa(n)dheh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੜੇ ਜਿਹੜੇ (ਸਾਧਕ) ਸ਼ਰੀਰ ਉਤੇ ਕਸ਼ਟ ('ਜਾਤਨ') ਸਹਿਨ ਕਰਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "जे जे सहित जातन संदेहि ॥",
      "sourceLineId": "77099",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪ੍ਰਭ ਕੇ ਸੰਗਿ ਨ ਛੋਡਤ ਨੇਹ ॥",
      "transliteration": "prabh ke sa(n)g na chhoddat neh ||",
      "translation": "Those who consider the castes illusory, they do not abandon the love of the Lord.",
      "punjabiViakhya": "ਪਰ ਪਰਮਾਤਮਾ ਨਾਲੋਂ ਪਿਆਰ ਨਹੀਂ ਤੋੜਦੇ,",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "प्रभ के संगि न छोडत नेह ॥",
      "sourceLineId": "77100",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤੇ ਤੇ ਪਰਮ ਪੁਰੀ ਕਹ ਜਾਹੀ ॥",
      "transliteration": "te te param puree keh jaahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸਭ ਪਰਮਾਤਮਾ ਦੇ ਦੁਆਰ (ਪਰਮ-ਪੁਰੀ) ਉਤੇ ਜਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "ते ते परम पुरी कह जाही ॥",
      "sourceLineId": "77101",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਿਨ ਹਰਿ ਸਿਉ ਅੰਤਰੁ ਕਛੁ ਨਾਹੀਂ ॥੨੧॥",
      "transliteration": "tin har siau a(n)tar kachh naahee(n) ||21||",
      "translation": "When they leave the world, they go to the abode of the Lord, and there is no difference between them and the Lord.21.",
      "punjabiViakhya": "ਉਨ੍ਹਾ ਦਾ ਹਰਿ ਨਾਲੋਂ ਕੋਈ ਅੰਤਰ ਨਹੀਂ ਰਹਿ ਜਾਦਾ (ਅਰਥਾਤ ਅਦ੍ਵੈਤ ਅਵਸਥਾ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰਦੇ ਹਨ) ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "तिन हरि सिउ अंतरु कछु नाहीं ॥२१॥",
      "sourceLineId": "77102",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੇ ਜੇ ਜੀਯ ਜਾਤਨ ਤੇ ਡਰੈ ॥",
      "transliteration": "je je jeey jaatan te ddarai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੜੇ ਜਿਹੜੇ ਸਾਧਕ ਕਸ਼ਟਾ ਤੋਂ ਡਰੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "जे जे जीय जातन ते डरै ॥",
      "sourceLineId": "77103",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪਰਮ ਪੁਰਖ ਤਜਿ ਤਿਨ ਮਗ ਪਰੈ ॥",
      "transliteration": "param purakh taj tin mag parai ||",
      "translation": "Those who fear the castes and follow their path, abandoning the Supreme Lord.",
      "punjabiViakhya": "ਅਤੇ ਪਰਮ-ਪੁਰਖ (ਦਾ ਅਧਿਆਤਮੀ ਮਾਰਗ) ਛੱਡ ਕੇ ਵੇਦਾ ਦੇ ਮਾਰਗ ਉਤੇ ਪੈ ਗਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "परम पुरख तजि तिन मग परै ॥",
      "sourceLineId": "77104",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤੇ ਤੇ ਨਰਕ ਕੁੰਡ ਮੋ ਪਰਹੀ ॥",
      "transliteration": "te te narak ku(n)dd mo parahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸਾਰੇ ਨਰਕ-ਕੁੰਡ ਵਿਚ ਪੈਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "ते ते नरक कुँड मो परही ॥",
      "sourceLineId": "77105",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਾਰ ਬਾਰ ਜਗ ਮੋ ਬਪੁ ਧਰਹੀ ॥੨੨॥",
      "transliteration": "baar baar jag mo bap dharahee ||22||",
      "translation": "They fall into hell and transmigrate again and again.22.",
      "punjabiViakhya": "ਅਤੇ ਜਗਤ ਵਿਚ ਮੁੜ ਮੁੜ ਕੇ ਸ਼ਰੀਰ ਧਾਰਨ ਕਰਨਗੇ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "बार बार जग मो बपु धरही ॥२२॥",
      "sourceLineId": "77106",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਬ ਹਰਿ ਬਹੁਰਿ ਦੱਤ ਉਪਜਾਇਓ ॥",
      "transliteration": "tab har bahur dha't upajaio ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਫਿਰ ਹਰਿ ਨੇ ਦੱਤਾਤ੍ਰੇਯ ਨੂੰ ਉਤਪੰਨ ਕੀਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "तब हरि बहुरि दत्त उपजाइओ ॥",
      "sourceLineId": "77107",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਿਨ ਭੀ ਅਪਨਾ ਪੰਥੁ ਚਲਾਇਓ ॥",
      "transliteration": "tin bhee apanaa pa(n)th chalaio ||",
      "translation": "Then I created Dutt, who also started his own path.",
      "punjabiViakhya": "ਉਸ ਨੇ ਵੀ ਆਪਣਾ ਧਰਮ-ਮਾਰਗ ਚਲਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "तिन भी अपना पंथु चलाइओ ॥",
      "sourceLineId": "77108",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਰ ਮੋ ਨਖ ਸਿਰ ਜਟਾਂ ਸਵਾਰੀ ॥",
      "transliteration": "kar mo nakh sir jaTaa(n) savaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਹੱਥਾ ਵਿਚ ਨਹੁੰ ਅਤੇ ਸਿਰ ਉਤੇ ਜਟਾਵਾ ਸੰਵਾਰ ਲਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "कर मो नख सिर जटाँ सवारी ॥",
      "sourceLineId": "77109",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਕ੍ਰਿਆ ਨ ਕਛੂ ਬਿਚਾਰੀ ॥੨੩॥",
      "transliteration": "prabh kee kriaa na kachhoo bichaaree ||23||",
      "translation": "His followers have long nails on their hands and matted hair on their heads . They did not understand the ways of the Lord.23",
      "punjabiViakhya": "ਅਤੇ ਪ੍ਰਭੂ ਦੀ ਕਰਨੀ ਬਾਰੇ ਜ਼ਰਾ ਵਿਚਾਰ ਨਾ ਕੀਤਾ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "प्रभ की कृआ न कछू बिचारी ॥२३॥",
      "sourceLineId": "77110",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪੁਨਿ ਹਰਿ ਗੋਰਖ ਕੌ ਉਪਰਾਜਾ ॥",
      "transliteration": "pun har gorakh kau uparaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਹਰਿ ਨੇ ਗੋਰਖ-ਨਾਥ ਨੂੰ ਉਤਪੰਨ ਕੀਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "पुनि हरि गोरख कौ उपराजा ॥",
      "sourceLineId": "77111",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਿੱਖ ਕਰੇ ਤਿਨਹੰੂ ਬਡ ਰਾਜਾ ॥",
      "transliteration": "si'kh kare tinaha(n)oo badd raajaa ||",
      "translation": "Then I created Gorakh, who made great kings his disciples.",
      "punjabiViakhya": "ਉਸ ਨੇ ਵਡੇ ਵਡੇ ਰਾਜਿਆਂ ਨੂੰ ਆਪਣਾ ਸੇਵਕ ਬਣਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "सिक्ख करे तिनहंू बड राजा ॥",
      "sourceLineId": "77112",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸ੍ਰਵਨ ਫਾਰਿ ਮੁਦ੍ਰਾ ਦੁਐ ਡਾਰੀ ॥",
      "transliteration": "sravan faar mudhraa dhuaai ddaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਕੰਨ ਪਾੜ ਕੇ ਦੋ ਮੁੰਦਰਾ ਪਾ ਦਿੱਤੀਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "स्रवन फारि मुद्रा दुऐ डारी ॥",
      "sourceLineId": "77113",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹਰਿ ਕੀ ਪ੍ਰਤਿ ਰੀਤਿ ਨ ਬਿਚਾਰੀ ॥੨੪॥",
      "transliteration": "har kee prat reet na bichaaree ||24||",
      "translation": "His disciples wear rings in their ears and do not know the love of the lord.24.",
      "punjabiViakhya": "ਪਰ ਪਰਮਾਤਮਾ ਦੇ ਪ੍ਰੇਮ ਦੀ ਰੀਤ ਨੂੰ ਨਾ ਵਿਚਾਰਿਆ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "हरि की प्रति रीति न बिचारी ॥२४॥",
      "sourceLineId": "77114",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪੁਨਿ ਹਰਿ ਰਾਮਾਨੰਦ ਕੋ ਕਰਾ ॥",
      "transliteration": "pun har raamaana(n)dh ko karaa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਹਰਿ ਨੇ ਰਾਮਾਨੰਦ ਨੂੰ ਪੈਦਾ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "पुनि हरि रामानंद को करा ॥",
      "sourceLineId": "77115",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭੇਸ ਬੈਰਾਗੀ ਕੋ ਜਿਨ ਧਰਾ ॥",
      "transliteration": "bhes bairaagee ko jin dharaa ||",
      "translation": "Then I created Ramanand, who adopted the path of Bairagi.",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਬੈਰਾਗੀ ਭੇਖ ਧਾਰਨ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "भेस बैरागी को जिन धरा ॥",
      "sourceLineId": "77116",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕੰਠੀ ਕੰਠਿ ਕਾਠ ਕੀ ਡਾਰੀ ॥",
      "transliteration": "ka(n)Thee ka(n)Th kaaTh kee ddaaree ||",
      "translation": "",
      "punjabiViakhya": "ਗਲ ਵਿਚ ਕਾਠ ਦੀ ਕੰਠੀ ਪਾ ਲਈ,",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "कंठी कंठि काठ की डारी ॥",
      "sourceLineId": "77117",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਕ੍ਰਿਆ ਨ ਕਛੂ ਬਿਚਾਰੀ ॥੨੫॥",
      "transliteration": "prabh kee kriaa na kachhoo bichaaree ||25||",
      "translation": "Around his neck he wore necklace of wooden beads and did not comprehend the ways of the Lord.25.",
      "punjabiViakhya": "ਪਰ (ਉਸ ਨੇ ਵੀ) ਪ੍ਰਭੂ ਦੀ ਕ੍ਰਿਆ ਦਾ ਕੁਝ ਵੀ ਵਿਚਾਰ ਨਹੀਂ ਕੀਤਾ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "प्रभ की कृआ न कछू बिचारी ॥२५॥",
      "sourceLineId": "77118",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜੇ ਪ੍ਰਭੁ ਪਰਮ ਪੁਰਖ ਉਪਜਾਏ ॥",
      "transliteration": "je prabh param purakh upajaae ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਭੂ ਨੇ ਜਿਹੜੇ ਜਿਹੜੇ ਮਹਾ ਪੁਰਖ ਪੈਦਾ ਕੀਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "जे प्रभु परम पुरख उपजाए ॥",
      "sourceLineId": "77119",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਿਨ ਤਿਨ ਅਪਨੇ ਰਾਹ ਚਲਾਏ ॥",
      "transliteration": "tin tin apane raeh chalaae ||",
      "translation": "All the great Purushas created by me started their own paths.",
      "punjabiViakhya": "ਉਨ੍ਹਾ ਨੇ ਆਪਣੇ ਆਪਣੇ (ਧਰਮ) ਮਾਰਗ ਚਲਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "तिन तिन अपने राह चलाए ॥",
      "sourceLineId": "77120",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਹਾਦੀਨ ਤਬ ਪ੍ਰਭ ਉਪਰਾਜਾ ॥",
      "transliteration": "mahaadheen tab prabh uparaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਪ੍ਰਭੂ ਨੇ ਹਜ਼ਰਤ ਮੁਹੰਮਦ ('ਮਹਾਦੀਨ') ਨੂੰ ਪੈਦਾ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "महादीन तब प्रभ उपराजा ॥",
      "sourceLineId": "77121",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਰਬ ਦੇਸ ਕੋ ਕੀਨੋ ਰਾਜਾ ॥੨੬॥",
      "transliteration": "arab dhes ko keeno raajaa ||26||",
      "translation": "Then I created Muhammed, who was made the master of Arabia.26.",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਅਰਬ ਦੇਸ਼ ਦਾ ਰਾਜਾ ਬਣਾਇਆ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "अरब देस को कीनो राजा ॥२६॥",
      "sourceLineId": "77122",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਿਨ ਭੀ ਏਕੁ ਪੰਥੁ ਉਪਰਾਜਾ ॥",
      "transliteration": "tin bhee ek pa(n)th uparaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਵੀ ਇਕ ਧਰਮ ਚਲਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "तिन भी एकु पंथु उपराजा ॥",
      "sourceLineId": "77123",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਲਿੰਗ ਬਿਨਾ ਕੀਨੇ ਸਭ ਰਾਜਾ ॥",
      "transliteration": "li(n)g binaa keene sabh raajaa ||",
      "translation": "He started a religion and circumcised all the kings.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਰਾਜਿਆਂ ਦੀ ਸੁੰਨਤ (ਖ਼ਤਨਾ) ਕਰਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "लिंग बिना कीने सभ राजा ॥",
      "sourceLineId": "77124",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਭ ਤੇ ਅਪਨਾ ਨਾਮੁ ਜਪਾਯੋ ॥",
      "transliteration": "sabh te apanaa naam japaayo ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਤੋਂ ਆਪਣਾ ਨਾਮ ਜਪਵਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "सभ ते अपना नामु जपायो ॥",
      "sourceLineId": "77125",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਤਿ ਨਾਮੁ ਕਾਹੂੰ ਨ ਦ੍ਰਿੜਾਯੋ ॥੨੭॥",
      "transliteration": "sat naam kaahoo(n) na dhiraRaayo ||27||",
      "translation": "He caused all to utter his name and did not give True Name of the Lord with firmness to anyone.27.",
      "punjabiViakhya": "ਪਰ ਸਤਿਨਾਮ ਕਿਸੇ ਨੂੰ ਦ੍ਰਿੜ੍ਹ ਨਾ ਕਰਾਇਆ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "सति नामु काहूँ न दृड़ायो ॥२७॥",
      "sourceLineId": "77126",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਭ ਅਪਨੀ ਅਪਨੀ ਉਰਝਾਨਾ ॥",
      "transliteration": "sabh apanee apanee urajhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਆਪਣੀ ਆਪਣੀ (ਵਿਚਾਰਧਾਰਾ ਵਿਚ) ਉਲਝੇ ਰਹੇ,",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "सभ अपनी अपनी उरझाना ॥",
      "sourceLineId": "77127",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਕਾਹੂ ਨ ਪਛਾਨਾ ॥",
      "transliteration": "paarabraham kaahoo na pachhaanaa ||",
      "translation": "Everyone placed his own interest first and foremost and did not comprehend the Supreme Brahman.",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਵੀ ਪਾਰਬ੍ਰਹਮ ਨੂੰ ਨਹੀਂ ਪਛਾਣਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "पारब्रहम काहू न पछाना ॥",
      "sourceLineId": "77128",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਪ ਸਾਧਤ ਹਰਿ ਮੋਹਿ ਬੁਲਾਯੋ ॥",
      "transliteration": "tap saadhat har moh bulaayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਤਪ ਕਰਦੇ ਨੂੰ ਹਰਿ ਨੇ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "तप साधत हरि मोहि बुलायो ॥",
      "sourceLineId": "77129",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਇਮ ਕਹਿ ਕੈ ਇਹ ਲੋਕ ਪਠਾਯੋ ॥੨੮॥",
      "transliteration": "eim keh kai ieh lok paThaayo ||28||",
      "translation": "When I was busy in the austere devotion, the Lord called me and sent me to this world with the following words.28.",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਤਰ੍ਹਾ ਕਹਿ ਕੇ ਇਸ ਲੋਕ ਵਿਚ ਭੇਜਿਆ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "इम कहि कै इह लोक पठायो ॥२८॥",
      "sourceLineId": "77130",
      "sourceShabadId": "7496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਕਾਲ ਪੁਰਖ ਬਾਚ ॥",
      "transliteration": "akaal purakh baach ||",
      "translation": "The Word of the Non-Temporal Lord:",
      "punjabiViakhya": "ਅਕਾਲ ਪੁਰਖ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "अकाल पुरख बाच ॥",
      "sourceLineId": "77131",
      "sourceShabadId": "7497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "77132",
      "sourceShabadId": "7497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮੈ ਅਪਨਾ ਸੁਤ ਤੋਹਿ ਨਿਵਾਜਾ ॥",
      "transliteration": "mai apanaa sut toh nivaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਤੈਨੂੰ ਆਪਣੇ ਪੁੱਤਰ ਵਜੋਂ ਗੌਰਵ ਬਖ਼ਸ਼ਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "मै अपना सुत तोहि निवाजा ॥",
      "sourceLineId": "77133",
      "sourceShabadId": "7497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪੰਥ ਪ੍ਰਚੁਰ ਕਰਬੇ ਕਹੁ ਸਾਜਾ ॥",
      "transliteration": "pa(n)th prachur karabe kahu saajaa ||",
      "translation": "I have adopted you as my son and hath created you for the propagation of the path (Panth).",
      "punjabiViakhya": "ਅਤੇ ਪੰਥ ਦਾ ਪ੍ਰਚਾਰ ਕਰਨ ਲਈ ਸੁਸਜਿਤ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "पंथ प्रचुर करबे कहु साजा ॥",
      "sourceLineId": "77134",
      "sourceShabadId": "7497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਾਹਿ ਤਹਾਂ ਤੈ ਧਰਮੁ ਚਲਾਇ ॥",
      "transliteration": "jaeh tahaa(n) tai dharam chalai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਜਾ ਕੇ ਤੂੰ ਧਰਮ-ਚੱਕਰ ਚਲਾਉਣਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "जाहि तहाँ तै धरमु चलाइ ॥",
      "sourceLineId": "77135",
      "sourceShabadId": "7497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਬੁਧਿ ਕਰਨ ਤੇ ਲੋਕ ਹਟਾਇ ॥੨੯॥",
      "transliteration": "kabudh karan te lok haTai ||29||",
      "translation": "“You go therefore for the spread of Dharma (righteousness) and cause people to retrace their steps from evil actions”.29.",
      "punjabiViakhya": "ਅਤੇ ਦੁਰਮਤਿ ਕਰਨ ਤੋਂ ਲੋਕਾ ਨੂੰ ਹਟਾਉਣਾ ਹੈ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "कबुधि करन ते लोक हटाइ ॥२९॥",
      "sourceLineId": "77136",
      "sourceShabadId": "7497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਬਿਬਾਚ ॥ ਦੋਹਰਾ ॥",
      "transliteration": "kabibaach || dhoharaa ||",
      "translation": "The World of the Poet: DOHRA",
      "punjabiViakhya": "ਕਵੀ ਨੇ ਕਿਹਾ ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "कबिबाच ॥ दोहरा ॥",
      "sourceLineId": "77137",
      "sourceShabadId": "7498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਠਾਢ ਭਯੋ ਮੈ ਜੋਰਿ ਕਰ ਬਚਨ ਕਹਾ ਸਿਰ ਨਿਆਇ ॥",
      "transliteration": "Thaadd bhayo mai jor kar bachan kahaa sir niaai ||",
      "translation": "I stood up with folded hands and bowing down my head, I said:",
      "punjabiViakhya": "ਮੈਂ ਹੱਥ ਜੋੜ ਕੇ ਖੜਾ ਹੋ ਗਿਆ ਅਤੇ ਸਿਰ ਨੀਵਾ ਕਰ ਕੇ ਬੇਨਤੀ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "ठाढ भयो मै जोरि कर बचन कहा सिर निआइ ॥",
      "sourceLineId": "77138",
      "sourceShabadId": "7498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪੰਥ ਚਲੈ ਤਬ ਜਗਤ ਮੈ ਜਬ ਤੁਮ ਕਰਹੁ ਸਹਾਇ ॥੩੦॥",
      "transliteration": "pa(n)th chalai tab jagat mai jab tum karahu sahai ||30||",
      "translation": "“The path (Panth) shall prevail only in the world, with THY ASSISTANCE.”30.",
      "punjabiViakhya": "ਕਿ ਜਦੋਂ ਤੁਸੀਂ ਸਹਾਇਤਾ ਕਰੋਗੇ ਤਾ ਜਗਤ ਵਿਚ (ਨਿਸਚੇ ਹੀ) ਪੰਥ ਦਾ ਵਿਕਾਸ ਹੋਏਗਾ ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "पंथ चलै तब जगत मै जब तुम करहु सहाइ ॥३०॥",
      "sourceLineId": "77139",
      "sourceShabadId": "7498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "77140",
      "sourceShabadId": "7499",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਇਹ ਕਾਰਨਿ ਪ੍ਰਭ ਮੋਹਿ ਪਠਾਯੋ ॥",
      "transliteration": "eeh kaaran prabh moh paThaayo ||",
      "translation": "For this reason the Lord sent me.",
      "punjabiViakhya": "ਇਸ ਕਾਰਨ ਪ੍ਰਭੂ ਨੇ ਮੈਨੂੰ (ਇਸ ਜਗਤ ਵਿਚ) ਭੇਜਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "इह कारनि प्रभ मोहि पठायो ॥",
      "sourceLineId": "77141",
      "sourceShabadId": "7499",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0057_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਬ ਮੈ ਜਗਤ ਜਨਮ ਧਰਿ ਆਯੋ ॥",
      "transliteration": "tab mai jagat janam dhar aayo ||",
      "translation": "And then I was born into this world.",
      "punjabiViakhya": "ਅਤੇ ਤਦ ਹੀ ਮੈਂ ਜਗਤ ਵਿਚ ਜਨਮ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 57,
      "hindi": "",
      "hindiTransliteration": "तब मै जगत जनम धरि आयो ॥",
      "sourceLineId": "77142",
      "sourceShabadId": "7499",
      "sourceUpdated": "2022-12-24 02:22:37",
