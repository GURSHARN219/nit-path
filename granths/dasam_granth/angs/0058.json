{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 58,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0058_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਉਰ ਕਿਸੂ ਤੇ ਬੈਰ ਨ ਗਹਿਹੋਂ ॥੩੧॥",
      "transliteration": "aaur kisoo te bair na gahiho(n) ||31||",
      "translation": "I do not bear enmity towards anyone. 31.",
      "punjabiViakhya": "ਹੋਰ ਕਿਸੇ ਨਾਲ ਵੈਰ ਨਹੀਂ ਪਾਲਾਗਾ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "अउर किसू ते बैर न गहिहों ॥३१॥",
      "sourceLineId": "77144",
      "sourceShabadId": "7499",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜੋ ਹਮ ਕੋ ਪਰਮੇਸਰ ਉਚਰਿਹੈਂ ॥",
      "transliteration": "jo ham ko paramesar ucharihai(n) ||",
      "translation": "Whosoever shall call me the Lord,",
      "punjabiViakhya": "ਜੋ ਲੋਕ ਸਾਨੂੰ ਪਰਮੇਸ਼ਵਰ ਕਹਿਣਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "जो हम को परमेसर उचरिहैं ॥",
      "sourceLineId": "77145",
      "sourceShabadId": "7499",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤੇ ਸਭ ਨਰਕ ਕੁੰਡ ਮਹਿ ਪਰਿਹੈਂ ॥",
      "transliteration": "te sabh narak ku(n)dd meh parihai(n) ||",
      "translation": "shall all fall into the pits of hell.",
      "punjabiViakhya": "ਉਹ ਸਾਰੇ ਨਰਕ-ਕੁੰਡ ਵਿਚ ਪੈਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "ते सभ नरक कुँड महि परिहैं ॥",
      "sourceLineId": "77146",
      "sourceShabadId": "7499",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮੋ ਕੌ ਦਾਸ ਤਵਨ ਕਾ ਜਾਨੋ ॥",
      "transliteration": "mo kau dhaas tavan kaa jaano ||",
      "translation": "Consider me the servant of the Transcendent Lord.",
      "punjabiViakhya": "ਮੈਨੂੰ ਪਰਮੇਸ਼ਵਰ ਦਾ ਦਾਸ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "मो कौ दास तवन का जानो ॥",
      "sourceLineId": "77147",
      "sourceShabadId": "7499",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਯਾ ਮੈ ਭੇਦ ਨ ਰੰਚ ਪਛਾਨੋ ॥੩੨॥",
      "transliteration": "yaa mai bhedh na ra(n)ch pachhaano ||32||",
      "translation": "Do not think of any difference between me and Him. 32.",
      "punjabiViakhya": "ਇਸ (ਗੱਲ) ਵਿਚ ਜ਼ਰਾ ਜਿੰਨਾ ਵੀ ਫ਼ਰਕ ਨਾ ਸਮਝੋ ॥੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "या मै भेद न रंच पछानो ॥३२॥",
      "sourceLineId": "77148",
      "sourceShabadId": "7499",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮੈ ਹੋ ਪਰਮ ਪੁਰਖ ਕੋ ਦਾਸਾ ॥",
      "transliteration": "mai ho param purakh ko dhaasaa ||",
      "translation": "I am the servant of the Supreme Being.",
      "punjabiViakhya": "ਮੈਂ ਤਾ ਪਰਮ-ਪੁਰਖ (ਪਰਮਾਤਮਾ) ਦਾ ਦਾਸ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "मै हो परम पुरख को दासा ॥",
      "sourceLineId": "77149",
      "sourceShabadId": "7499",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦੇਖਨ ਆਯੋ ਜਗਤ ਤਮਾਸਾ ॥",
      "transliteration": "dhekhan aayo jagat tamaasaa ||",
      "translation": "I have come to see the spectacle of the world.",
      "punjabiViakhya": "ਅਤੇ ਜਾਗਤਿਕ ਪ੍ਰਪੰਚ ਦਾ ਤਮਾਸ਼ਾ ਦੇਖਣ ਆਇਆ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "देखन आयो जगत तमासा ॥",
      "sourceLineId": "77150",
      "sourceShabadId": "7499",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੋ ਪ੍ਰਭ ਜਗਤਿ ਕਹਾ ਸੋ ਕਹਿਹੋਂ ॥",
      "transliteration": "jo prabh jagat kahaa so kahiho(n) ||",
      "translation": "Whatever the Lord of the world said,",
      "punjabiViakhya": "ਪ੍ਰਭੂ ਨੇ ਜੋ ਕਿਹਾ ਹੈ, ਉਹੀ ਜਗਤ ਵਿਚ ਕਹਾਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "जो प्रभ जगति कहा सो कहिहों ॥",
      "sourceLineId": "77151",
      "sourceShabadId": "7499",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮ੍ਰਿਤ ਲੋਕ ਤੇ ਮੋਨ ਨ ਰਹਿਹੋਂ ॥੩੩॥",
      "transliteration": "mirat lok te mon na rahiho(n) ||33||",
      "translation": "I say the same unto you, I cannot remain silent in this abode of death. 33.",
      "punjabiViakhya": "ਅਤੇ ਮਰਨ-ਸ਼ੀਲ ਸੰਸਾਰ (ਤੋਂ ਕਿਸੇ ਤਰ੍ਹਾ ਡਰ ਕੇ) ਮੌਨ ਨਹੀਂ ਰਹਾਗਾ ॥੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "मृत लोक ते मोन न रहिहों ॥३३॥",
      "sourceLineId": "77152",
      "sourceShabadId": "7499",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "naraaj chha(n)dh ||",
      "translation": "NAARAAJ CHHAND",
      "punjabiViakhya": "ਨਰਾਜ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "नराज छंद ॥",
      "sourceLineId": "77153",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਹਿਓ ਪ੍ਰਭੂ ਸੁ ਭਾਖਿ ਹੋਂ ॥",
      "transliteration": "kahio prabhoo su bhaakh ho(n) ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਭੂ ਨੇ (ਜੋ ਕੁਝ) ਕਿਹਾ ਹੈ, ਉਹੀ (ਮੈਂ) ਕਹਾਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "कहिओ प्रभू सु भाखि हों ॥",
      "sourceLineId": "77154",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਿਸੂ ਨ ਕਾਨ ਰਾਖਿ ਹੋਂ ॥",
      "transliteration": "kisoo na kaan raakh ho(n) ||",
      "translation": "I say only that which the Lord hath said, I do not yield to anyone else.",
      "punjabiViakhya": "ਕਿਸੇ ਦੀ ਵੀ ਪਰਵਾਹ ਨਹੀਂ ਰਖਾਂਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "किसू न कान राखि हों ॥",
      "sourceLineId": "77155",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਿਸੂ ਨ ਭੇਖ ਭੀਜ ਹੋਂ ॥",
      "transliteration": "kisoo na bhekh bheej ho(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਭੇਖ ਤੋ ਪ੍ਰਭਾਵਿਤ ਨਹੀ ਹੋਵਾਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "किसू न भेख भीज हों ॥",
      "sourceLineId": "77156",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਲੇਖ ਬੀਜ ਬੀਜ ਹੋਂ ॥੩੪॥",
      "transliteration": "alekh beej beej ho(n) ||34||",
      "translation": "I do not feel pleased with any particular garb, I sow the seed of God’s Name.34.",
      "punjabiViakhya": "ਅਤੇ ਪ੍ਰਭੂ ('ਅਲੇਖ' ਦੇ ਨਾ ਦਾ) ਬੀਜ ਬੀਜਾਗਾ (ਅਰਥਾਤ ਪ੍ਰਚਾਰ ਕਰਾਗਾ) ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "अलेख बीज बीज हों ॥३४॥",
      "sourceLineId": "77157",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪਖਾਣ ਪੂਜ ਹੋਂ ਨਹੀਂ ॥",
      "transliteration": "pakhaan pooj ho(n) nahee(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਪੱਥਰ-ਪੂਜ ਨਹੀਂ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "पखाण पूज हों नहीं ॥",
      "sourceLineId": "77158",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨ ਭੇਖ ਭੀਜ ਹੋ ਕਹੀਂ ॥",
      "transliteration": "n bhekh bheej ho kahee(n) ||",
      "translation": "I do not worship stones, nor I have any liking for a particular guise.",
      "punjabiViakhya": "ਅਤੇ ਨਾ ਹੀ (ਕਿਸੇ ਵਿਸ਼ੇਸ਼) ਭੇਖ ਵਿਚ ਭਿਜਣ ਵਾਲਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "न भेख भीज हो कहीं ॥",
      "sourceLineId": "77159",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਨੰਤ ਨਾਮੁ ਗਾਇ ਹੋਂ ॥",
      "transliteration": "ana(n)t naam gai ho(n) ||",
      "translation": "I sing the Name (of the Lord),",
      "punjabiViakhya": "(ਮੈਂ) ਪ੍ਰਭੂ ਦੇ ਨਾਮ ਦਾ ਸਿਮਰਨ ਕਰਾਂਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "अनंत नामु गाइ हों ॥",
      "sourceLineId": "77160",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪਰੱਮ ਪੁਰਖ ਪਾਇ ਹੋਂ ॥੩੫॥",
      "transliteration": "para'm purakh pai ho(n) ||35||",
      "translation": "I sing infinite Names (of the Lord), and meet the Supreme Purusha.35.",
      "punjabiViakhya": "ਅਤੇ ਪਰਮ ਪੁਰਖ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰਾਗਾ ॥੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "परम्म पुरख पाइ हों ॥३५॥",
      "sourceLineId": "77161",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਟਾ ਨ ਸੀਸ ਧਾਰਿਹੋਂ ॥",
      "transliteration": "jaTaa na sees dhaariho(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਸੀਸ ਉਤੇ ਜਟਾਵਾਂ ਧਾਰਨ ਨਹੀਂ ਕਰਾਂਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "जटा न सीस धारिहों ॥",
      "sourceLineId": "77162",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨ ਮੁੰਦ੍ਰਕਾ ਸੁਧਾਰਿਹੋਂ ॥",
      "transliteration": "n mu(n)dhrakaa sudhaariho(n) ||",
      "translation": "I do not wear matted hair on my head, nor do I put rings in my ears.",
      "punjabiViakhya": "ਅਤੇ ਨਾ ਹੀ (ਕੰਨਾ ਵਿਚ) ਮੁੰਦਰਾ ਪਾਵਾਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "न मुँद्रका सुधारिहों ॥",
      "sourceLineId": "77163",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨ ਕਾਨਿ ਕਾਹੂੰ ਕੀ ਧਰੋ ॥",
      "transliteration": "n kaan kaahoo(n) kee dharo ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਕਿਸੇ ਦੀ ਪਰਵਾਹ ਨਹੀਂ ਕਰਾਂਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "न कानि काहूँ की धरो ॥",
      "sourceLineId": "77164",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਹਿਓ ਪ੍ਰਭੂ ਸੁ ਮੈ ਕਰੋਂ ॥੩੬॥",
      "transliteration": "kahio prabhoo su mai karo(n) ||36||",
      "translation": "I do not pay attention to anyone else, all my actions are at the bidding of the Lord.36.",
      "punjabiViakhya": "ਜੋ ਪ੍ਰਭੂ ਨੇ ਕਿਹਾ ਹੈ, ਉਹੀ ਕਰਾਗਾ ॥੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "कहिओ प्रभू सु मै करों ॥३६॥",
      "sourceLineId": "77165",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭਜੋਂ ਸੁ ਏਕ ਨਾਮਯੰ ॥",
      "transliteration": "bhajo(n) su ek naamaya(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ ਕੇਵਲ) ਇਕ (ਪ੍ਰਭੂ ਦੇ) ਨਾਮ ਦਾ ਭਜਨ ਕਰਾਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "भजों सु एक नामयं ॥",
      "sourceLineId": "77166",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜੁ ਕਾਮ ਸਰਬ ਠਾਮਯੰ ॥",
      "transliteration": "j kaam sarab Thaamaya(n) ||",
      "translation": "I recite only the Name of the Lord, which is useful at all places.",
      "punjabiViakhya": "ਜੋ ਸਾਰਿਆ ਸਥਾਨਾ ਉਤੇ ਕੰਮ ਆਉਣ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "जु काम सरब ठामयं ॥",
      "sourceLineId": "77167",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨ ਜਾਪ ਆਨ ਕੋ ਜਪੋ ॥",
      "transliteration": "n jaap aan ko japo ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਕਿਸੇ ਹੋਰ ਦਾ ਜਾਪ ਨਹੀਂ ਜਪਾਂਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "न जाप आन को जपो ॥",
      "sourceLineId": "77168",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨ ਅਉਰ ਥਾਪਨਾ ਥਪੋ ॥੩੭॥",
      "transliteration": "n aaur thaapanaa thapo ||37||",
      "translation": "I do not meditate on anyone else, nor do I seek assistance from any other quarter.37.",
      "punjabiViakhya": "ਅਤੇ ਨਾ ਹੀ ਹੋਰ ਕੋਈ ਸਥਾਪਨਾ ਕਰਾਗਾ ॥੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "न अउर थापना थपो ॥३७॥",
      "sourceLineId": "77169",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਿਅੰਤਿ ਨਾਮ ਧਿਆਇ ਹੋਂ ॥",
      "transliteration": "bia(n)t naam dhiaai ho(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਪ੍ਰਭੂ (ਬੇਅੰਤ) ਦੇ ਨਾਮ ਦਾ ਸਿਮਰਨ ਕਰਾਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "बिअंति नाम धिआइ हों ॥",
      "sourceLineId": "77170",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪਰਮ ਜੋਤਿ ਪਾਇ ਹੋਂ ॥",
      "transliteration": "param jot pai ho(n) ||",
      "translation": "I recite infinite Names and attain the Supreme light.",
      "punjabiViakhya": "ਅਤੇ (ਉਸ) ਪਰਮ-ਜੋਤਿ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰਾਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "परम जोति पाइ हों ॥",
      "sourceLineId": "77171",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨ ਧਿਆਨ ਆਨ ਕੋ ਧਰੋਂ ॥",
      "transliteration": "n dhiaan aan ko dharo(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਕਿਸੇ ਹੋਰ (ਇਸ਼ਟ-ਦੇਵ ਦਾ) ਧਿਆਨ ਨਹੀ ਧਰਾਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "न धिआन आन को धरों ॥",
      "sourceLineId": "77172",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨ ਨਾਮ ਆਨ ਉਚਰੋਂ ॥੩੮॥",
      "transliteration": "n naam aan ucharo(n) ||38||",
      "translation": "I do not meditate on anyone else, nor do I repeat the Name of anyone else.38.",
      "punjabiViakhya": "ਅਤੇ ਨਾ ਹੀ (ਕਿਸੇ) ਦੂਜੇ ਦਾ ਨਾਮ ਉਚਾਰਾਗਾ ॥੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "न नाम आन उचरों ॥३८॥",
      "sourceLineId": "77173",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਵੱਕ ਨਾਮ ਰੱਤਿਯੰ ॥",
      "transliteration": "tava'k naam ra'tiya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਰੇ ਇਕ ਨਾਮ ਵਿਚ (ਪੂਰੀ ਤਰ੍ਹਾ) ਰੰਗਿਆ ਜਾਵਾਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "तवक्क नाम रत्तियं ॥",
      "sourceLineId": "77174",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨ ਆਨ ਮਾਨ ਮੱਤਿਯੰ ॥",
      "transliteration": "n aan maan ma'tiya(n) ||",
      "translation": "I am absorbed only in the Name of the Lord, and honour none else.",
      "punjabiViakhya": "ਹੋਰ ਕਿਸੇ ਮਾਨ-ਸਨਮਾਨ ਵਿਚ ਮਗਨ ਨਹੀ ਹੋਵਾਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "न आन मान मत्तियं ॥",
      "sourceLineId": "77175",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪਰੱਮ ਧਿਆਨ ਧਾਰੀਯੰ ॥",
      "transliteration": "para'm dhiaan dhaareeya(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ ਪਰਮਾਤਮਾ ਦੇ) ਸ੍ਰੇਸ਼ਠ ਧਿਆਨ ਨੂੰ (ਹਿਰਦੇ ਵਿਚ) ਧਾਰਨ ਕਰਾਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "परम्म धिआन धारीयं ॥",
      "sourceLineId": "77176",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਨੰਤ ਪਾਪ ਟਾਰੀਯੰ ॥੩੯॥",
      "transliteration": "ana(n)t paap Taareeya(n) ||39||",
      "translation": "By meditating on the Supreme, I am absolved of infinite sins.39.",
      "punjabiViakhya": "ਅਤੇ (ਇਸ ਤਰਾ ਕਰਨ ਨਾਲ) ਅਨੇਕ ਪਾਪਾ ਨੂੰ ਟਾਲ ਦਿਆਂਗਾ ॥੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "अनंत पाप टारीयं ॥३९॥",
      "sourceLineId": "77177",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤੁਮੇਵ ਰੂਪ ਰਾਚਿਯੰ ॥",
      "transliteration": "tumev roop raachiya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਰੇ ਹੀ ਰੂਪ ਵਿਚ ਲੀਨ ਹੋਵਾਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "तुमेव रूप राचियं ॥",
      "sourceLineId": "77178",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨ ਆਨ ਦਾਨ ਮਾਚਿਯੰ ॥",
      "transliteration": "n aan dhaan maachiya(n) ||",
      "translation": "I am absorbed only in His Sight, and do not attend to any other charitable action.",
      "punjabiViakhya": "ਹੋਰ ਕਿਸੇ ਦੇ ਦਾਨ ਵਿਚ ਰੁਚਿਤ ਨਹੀ ਹੋਵਾਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "न आन दान माचियं ॥",
      "sourceLineId": "77179",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਵੱਕ ਨਾਮ ਉਚਾਰਿਯੰ ॥",
      "transliteration": "tava'k naam uchaariya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਰੇ ਹੀ ਇਕ ਨਾਮ ਨੂੰ ਉਚਾਰਾਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "तवक्क नाम उचारियं ॥",
      "sourceLineId": "77180",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਨੰਤ ਦੂਖ ਟਾਰੀਯੰ ॥੪੦॥",
      "transliteration": "ana(n)t dhookh Taareeya(n) ||40||",
      "translation": "By uttering only His Name, I am absolved of infinite sorrows.40.",
      "punjabiViakhya": "ਅਤੇ ਬੇਅੰਤ ਦੁਖਾ ਨੂੰ ਦੂਰ ਕਰ ਦਿਆਂਗਾ ॥੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "अनंत दूख टारीयं ॥४०॥",
      "sourceLineId": "77181",
      "sourceShabadId": "7500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "77182",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਿਨ ਜਿਨ ਨਾਮ ਤਿਹਾਰੋ ਧਿਆਇਆ ॥",
      "transliteration": "jin jin naam tihaaro dhiaaiaa ||",
      "translation": "Those who meditated on Your Name,",
      "punjabiViakhya": "ਜਿਸ ਜਿਸ ਨੇ ਤੇਰੇ ਨਾਮ ਦੀ ਆਰਾਧਨਾ ਕੀਤੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "जिन जिन नाम तिहारो धिआइआ ॥",
      "sourceLineId": "77183",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੂਖ ਪਾਪ ਤਿਹ ਨਿਕਟ ਨ ਆਇਆ ॥",
      "transliteration": "dhookh paap teh nikaT na aaiaa ||",
      "translation": "no sorrows and sins came near them.",
      "punjabiViakhya": "ਉਸ ਦੇ ਨੇੜੇ ਦੁਖ ਅਤੇ ਪਾਪ ਨਹੀਂ ਆਉਾਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "दूख पाप तिह निकट न आइआ ॥",
      "sourceLineId": "77184",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜੇ ਜੇ ਅਉਰ ਧਿਆਨ ਕੋ ਧਰਹੀਂ ॥",
      "transliteration": "je je aaur dhiaan ko dharahee(n) ||",
      "translation": "Those who meditated on any other",
      "punjabiViakhya": "ਜਿਹੜੇ ਜਿਹੜੇ ਹੋਰਨਾ ਦੇ ਧਿਆਨ ਨੂੰ ਧਾਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "जे जे अउर धिआन को धरहीं ॥",
      "sourceLineId": "77185",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਹਿਸ ਬਹਿਸ ਬਾਦਨ ਤੇ ਮਰਹੀਂ ॥੪੧॥",
      "transliteration": "bahis bahis baadhan te marahee(n) ||41||",
      "translation": "died in futile discussions and quarrels in the end. ||41||",
      "punjabiViakhya": "ਉਹ (ਅਧਿਆਤਮਿਕ) ਝਗੜਿਆਂ ਵਿਚ ਬਹਿਸ ਬਹਿਸ ਕੇ ਮਰਦੇ ਹਨ ॥੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "बहिस बहिस बादन ते मरहीं ॥४१॥",
      "sourceLineId": "77186",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਮ ਇਹ ਕਾਜ ਜਗਤ ਮੋ ਆਏ ॥",
      "transliteration": "ham ieh kaaj jagat mo aae ||",
      "translation": "I have come into the world for this purpose.",
      "punjabiViakhya": "ਇਹੀ ਕੰਮ (ਕਰਨ ਲਈ) ਅਸੀਂ ਜਗਤ ਵਿਚ ਆਏ ਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "हम इह काज जगत मो आए ॥",
      "sourceLineId": "77187",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਧਰਮ ਹੇਤ ਗੁਰਦੇਵ ਪਠਾਏ ॥",
      "transliteration": "dharam het gurdhev paThaae ||",
      "translation": "The Divine Guru sent me to propagate the righteous way of life.",
      "punjabiViakhya": "ਧਰਮ (ਦੇ ਪ੍ਰਸਾਰ) ਲਈ ਨਿਰਾਕਾਰ (ਗੁਰਦੇਵ) ਨੇ ਭੇਜਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "धरम हेत गुरदेव पठाए ॥",
      "sourceLineId": "77188",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਹਾਂ ਤਹਾਂ ਤੁਮ ਧਰਮ ਬਿਥਾਰੋ ॥",
      "transliteration": "jahaa(n) tahaa(n) tum dharam bithaaro ||",
      "translation": "In this way, You asked me to spread the righteous path,",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ (ਸਰਬਤ੍ਰ) ਤੁਸੀਂ ਧਰਮ ਦਾ ਵਿਸਤਾਰ ਕਰੋ",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "जहाँ तहाँ तुम धरम बिथारो ॥",
      "sourceLineId": "77189",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦੁਸਟ ਦੋਖੀਅਨਿ ਪਕਰਿ ਪਛਾਰੋ ॥੪੨॥",
      "transliteration": "dhusaT dhokheean pakar pachhaaro ||42||",
      "translation": "and vanquish evil tyrants. ||42||",
      "punjabiViakhya": "ਅਤੇ ਦੁਸ਼ਟਾ ਅਤੇ ਦੋਖੀਆਂ ਨੂੰ ਪਕੜ ਕੇ ਪਛਾੜ ਦਿਓ ॥੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "दुसट दोखीअनि पकरि पछारो ॥४२॥",
      "sourceLineId": "77190",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਯਾਹੀ ਕਾਜ ਧਰਾ ਹਮ ਜਨਮੰ ॥",
      "transliteration": "yaahee kaaj dharaa ham janama(n) ||",
      "translation": "I have taken birth for this purpose.",
      "punjabiViakhya": "ਇਸੇ ਕੰਮ ਲਈ ਅਸੀਂ ਜਨਮ ਧਾਰਨ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "याही काज धरा हम जनमं ॥",
      "sourceLineId": "77191",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਮਝ ਲੇਹੁ ਸਾਧੂ ਸਭ ਮਨ ਮੰ ॥",
      "transliteration": "samajh leh saadhoo sabh man ma(n) ||",
      "translation": "The saints should understand this in their minds.",
      "punjabiViakhya": "ਹੇ ਸਾਧੂ ਪੁਰਸ਼ੋ! ਇਸ ਨੂੰ ਚੰਗੀ ਤਰ੍ਹਾ ਮਨ ਵਿਚ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "समझ लेहु साधू सभ मन मं ॥",
      "sourceLineId": "77192",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਧਰਮ ਚਲਾਵਨ ਸੰਤ ਉਬਾਰਨ ॥",
      "transliteration": "dharam chalaavan sa(n)t ubaaran ||",
      "translation": "To protect the saints and spread the true path.",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਹਾ ਸਾਡਾ ਕਰਤੱਵ ਹੈ ਕਿ) ਧਰਮ ਨੂੰ ਚਲਾਇਆ ਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "धरम चलावन संत उबारन ॥",
      "sourceLineId": "77193",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਦੁਸਟ ਸਭਨ ਕੋ ਮੂਲ ਉਪਾਰਨ ॥੪੩॥",
      "transliteration": "dhusaT sabhan ko mool upaaran ||43||",
      "translation": "To destroy all of the evil tyrants at their root. ||43||",
      "punjabiViakhya": "ਅਤੇ ਸੰਤਾ ਦਾ ਉੱਧਾਰ ਕੀਤਾ ਜਾਏ ਅਤੇ ਸਾਰਿਆਂ ਦੁਸ਼ਟਾ ਨੂੰ ਜੜ੍ਹੋਂ ਪੁਟਿਆ ਜਾਏ ॥੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "दुसट सभन को मूल उपारन ॥४३॥",
      "sourceLineId": "77194",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜੇ ਜੇ ਭਏ ਪਹਿਲ ਅਵਤਾਰਾ ॥",
      "transliteration": "je je bhe pahil avataaraa ||",
      "translation": "Those earlier incarnations that manifested,",
      "punjabiViakhya": "ਜਿਹੜੇ ਜਿਹੜੇ ਪਹਿਲੇ ਅਵਤਾਰ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "जे जे भए पहिल अवतारा ॥",
      "sourceLineId": "77195",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਆਪੁ ਆਪੁ ਤਿਨ ਜਾਪੁ ਉਚਾਰਾ ॥",
      "transliteration": "aap aap tin jaap uchaaraa ||",
      "translation": "Caused others to meditate only on their own names.",
      "punjabiViakhya": "ਉਨ੍ਹਾ ਨੇ ਆਪਣੇ ਆਪਣੇ (ਨਾਮ ਦਾ) ਜਾਪ ਕਰਵਾਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "आपु आपु तिन जापु उचारा ॥",
      "sourceLineId": "77196",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਪ੍ਰਭ ਦੋਖੀ ਕੋਈ ਨ ਬਿਦਾਰਾ ॥",
      "transliteration": "prabh dhokhee koiee na bidhaaraa ||",
      "translation": "Not one of them struck down the enemies of God,",
      "punjabiViakhya": "ਕਿਸੇ ਵੀ ਪ੍ਰਭੂ-ਦੋਖੀ ਦਾ ਨਾਸ਼ ਨਹੀਂ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "प्रभ दोखी कोई न बिदारा ॥",
      "sourceLineId": "77197",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਧਰਮ ਕਰਨ ਕੋ ਰਾਹੁ ਨ ਡਾਰਾ ॥੪੪॥",
      "transliteration": "dharam karan ko raahu na ddaaraa ||44||",
      "translation": "Nor proselytized about the righteous path. ||44||",
      "punjabiViakhya": "ਅਤੇ ਨਾ ਹੀ (ਲੋਕਾ ਨੂੰ) ਧਰਮ ਕਰਨ ਵਾਲੇ ਰਾਹ ਉਤੇ ਪਾਇਆ ਹੈ ॥੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "धरम करन को राहु न डारा ॥४४॥",
      "sourceLineId": "77198",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਜੇ ਜੇ ਗਉਸ ਅੰਬੀਆ ਭਏ ॥",
      "transliteration": "je je gaus a(n)beeaa bhe ||",
      "translation": "The earlier prophets, ascetics, and wise-ones",
      "punjabiViakhya": "ਜਿਹੜੇ ਜਿਹੜੇ ਪੀਰ-ਫ਼ਕੀਰ ਅਤੇ ਨੱਬੀ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "जे जे गउस अंबीआ भए ॥",
      "sourceLineId": "77199",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਮੈ ਮੈ ਕਰਤ ਜਗਤ ਤੇ ਗਏ ॥",
      "transliteration": "mai mai karat jagat te ge ||",
      "translation": "All were filled with ego and left this world.",
      "punjabiViakhya": "(ਉਹ ਸਾਰੇ) ਮੈਂ ਮੈਂ ਕਰਦਿਆਂ ਜਗਤ ਤੋਂ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "मै मै करत जगत ते गए ॥",
      "sourceLineId": "77200",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਮਹਾਪੁਰਖ ਕਾਹੂ ਨ ਪਛਾਨਾ ॥",
      "transliteration": "mahaapurakh kaahoo na pachhaanaa ||",
      "translation": "Not one recognized the Supreme Being.",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਵੀ ਮਹਾਪੁਰਖ (ਪ੍ਰਭੂ) ਨੂੰ ਨਹੀਂ ਪਛਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "महापुरख काहू न पछाना ॥",
      "sourceLineId": "77201",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਕਰਮ ਧਰਮ ਕੋ ਕਛੂ ਨ ਜਾਨਾ ॥੪੫॥",
      "transliteration": "karam dharam ko kachhoo na jaanaa ||45||",
      "translation": "Nor did they care for righteous deeds. ||45||",
      "punjabiViakhya": "ਅਤੇ ਧਰਮ-ਕਰਮ ਨੂੰ ਵੀ ਕੁਝ ਨਹੀਂ ਜਾਣਿਆ ॥੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "करम धरम को कछू न जाना ॥४५॥",
      "sourceLineId": "77202",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਅਵਰਨ ਕੀ ਆਸਾ ਕਿਛੁ ਨਾਹੀ ॥",
      "transliteration": "avaran kee aasaa kichh naahee ||",
      "translation": "Hope in any other is worthless.",
      "punjabiViakhya": "ਹੋਰਨਾ ਦੀ ਆਸ ਦਾ ਕੁਝ ਵੀ (ਮਹੱਤਵ) ਨਹੀਂ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "अवरन की आसा किछु नाही ॥",
      "sourceLineId": "77203",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਏਕੈ ਆਸ ਧਰੋ ਮਨ ਮਾਹੀ ॥",
      "transliteration": "ekai aas dharo man maahee ||",
      "translation": "There is only one hope that should dwell in your mind.",
      "punjabiViakhya": "ਇਕੋ (ਨਿਰੰਕਾਰ) ਦੀ ਆਸ ਨੂੰ ਮਨ ਵਿਚ ਧਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "एकै आस धरो मन माही ॥",
      "sourceLineId": "77204",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਆਨ ਆਸ ਉਪਜਤ ਕਿਛੁ ਨਾਹੀ ॥",
      "transliteration": "aan aas upajat kichh naahee ||",
      "translation": "Hope in others will never be fruitful.",
      "punjabiViakhya": "ਹੋਰਨਾ (ਦੇਵੀ-ਦੇਵਤਿਆਂ) ਦੀ ਆਸ ਤੋਂ ਕੁਝ ਵੀ ਹਾਸਲ ਨਹੀਂ ਹੁੰਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "आन आस उपजत किछु नाही ॥",
      "sourceLineId": "77205",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਵਾ ਕੀ ਆਸ ਧਰੋਂ ਮਨ ਮਾਹੀ ॥੪੬॥",
      "transliteration": "vaa kee aas dharo(n) man maahee ||46||",
      "translation": "This is why, only one hope should dwell within your mind. ||46||",
      "punjabiViakhya": "(ਇਸ ਲਈ ਕੇਵਲ) ਉਸ ਪ੍ਰਭੂ ਦੀ ਆਸ ਨੂੰ ਮਨ ਵਿਚ ਧਾਰਨ ਕਰੋ ॥੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "वा की आस धरों मन माही ॥४६॥",
      "sourceLineId": "77206",
      "sourceShabadId": "7501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "77207",
      "sourceShabadId": "7502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਕੋਈ ਪੜ੍ਹਤ ਕੁਰਾਨ ਕੋ ਕੋਈ ਪੜ੍ਹਤ ਪੁਰਾਨ ॥",
      "transliteration": "koiee paRhat kuraan ko koiee paRhat puraan ||",
      "translation": "Someone studies the Quran and someone studies the Puranas.",
      "punjabiViakhya": "ਕੋਈ ਕੁਰਾਨ ਨੂੰ ਪੜ੍ਹਦਾ ਹੈ ਅਤੇ ਕੋਈ ਪੁਰਾਣ ਪੜ੍ਹਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "कोई पड़्हत कुरान को कोई पड़्हत पुरान ॥",
      "sourceLineId": "77208",
      "sourceShabadId": "7502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਕਾਲ ਨ ਸਕਤ ਬਚਾਇ ਕੈ ਫੋਕਟ ਧਰਮ ਨਿਦਾਨ ॥੪੭॥",
      "transliteration": "kaal na sakat bachai kai fokaT dharam nidhaan ||47||",
      "translation": "Mere reading cannot save one from death. Therefore such works are vain and do not help at the time of death.47.",
      "punjabiViakhya": "(ਪਰ) ਇਹ ਸਭ ਵਿਅਰਥ ਧਾਰਮਿਕ ਉਪਚਾਰ ਹਨ ਅਤੇ ਕਾਲ ਤੋਂ ਬਚਾ ਨਹੀਂ ਸਕਦੇ ॥੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "काल न सकत बचाइ कै फोकट धरम निदान ॥४७॥",
      "sourceLineId": "77209",
      "sourceShabadId": "7502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "77210",
      "sourceShabadId": "7503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਮਿਲਿ ਪੜ੍ਹਤ ਕੁਰਾਨਾ ॥",
      "transliteration": "kiee koT mil paRhat kuraanaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਕਰੋੜਾ (ਲੋਕ) ਮਿਲ ਕੇ ਕੁਰਾਨ ਪੜ੍ਹਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "कई कोटि मिलि पड़्हत कुराना ॥",
      "sourceLineId": "77211",
      "sourceShabadId": "7503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਬਾਚਤ ਕਿਤੇ ਪੁਰਾਨ ਅਜਾਨਾ ॥",
      "transliteration": "baachat kite puraan ajaanaa ||",
      "translation": "Millions of people recite the Quran and many study Puranas witout understanding the crux.",
      "punjabiViakhya": "ਅਤੇ (ਕਈ) ਅਣਜਾਣ ਲੋਕ ਪੁਰਾਣਾ ਨੂੰ ਵਾਚਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "बाचत किते पुरान अजाना ॥",
      "sourceLineId": "77212",
      "sourceShabadId": "7503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਅੰਤ ਕਾਲ ਕੋਈ ਕਾਮ ਨ ਆਵਾ ॥",
      "transliteration": "a(n)t kaal koiee kaam na aavaa ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ) ਅੰਤ-ਕਾਲ (ਇਨ੍ਹਾ ਵਿਚੋਂ) ਕੋਈ ਵੀ ਕੰਮ ਨਹੀਂ ਆਉਾਂਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "अंत काल कोई काम न आवा ॥",
      "sourceLineId": "77213",
      "sourceShabadId": "7503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਦਾਵ ਕਾਲ ਕਾਹੂ ਨ ਬਚਾਵਾ ॥੪੮॥",
      "transliteration": "dhaav kaal kaahoo na bachaavaa ||48||",
      "translation": "It will be of no use at the time of death and none will be saved.48.",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ) ਕਾਲ ਦੇ ਦਾਓ ਤੋਂ ਕੋਈ ਵੀ ਬਚਾ ਨਹੀਂ ਸਕਦਾ ॥੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "दाव काल काहू न बचावा ॥४८॥",
      "sourceLineId": "77214",
      "sourceShabadId": "7503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0058_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਕਿਉ ਨ ਜਪੋ ਤਾ ਕੋ ਤੁਮ ਭਾਈ ॥",
      "transliteration": "kiau na japo taa ko tum bhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਭਾਈ! ਤੂੰ ਉਸ ਦੀ ਆਰਾਧਨਾ ਕਿਉਾਂ ਨਹੀਂ ਕਰਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 58,
      "hindi": "",
      "hindiTransliteration": "किउ न जपो ता को तुम भाई ॥",
      "sourceLineId": "77215",
      "sourceShabadId": "7503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    }
  ]
}
