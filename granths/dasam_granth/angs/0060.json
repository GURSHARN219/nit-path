{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 60,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0060_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜੇ ਜੇ ਬਾਦਿ ਕਰਤ ਹੰਕਾਰਾ ॥",
      "transliteration": "je je baadh karat ha(n)kaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਜੋ ਹੰਕਾਰ-ਵਸ ਹੋ ਕੇ ਵਾਦ-ਵਿਵਾਦ ਕਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "जे जे बादि करत हंकारा ॥",
      "sourceLineId": "77264",
      "sourceShabadId": "7510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਿਨ ਤੇ ਭਿੰਨ ਰਹਤ ਕਰਤਾਰਾ ॥",
      "transliteration": "tin te bhi(n)n rahat karataaraa ||",
      "translation": "Those who quarrel in ego, they are far removed from the Lord.",
      "punjabiViakhya": "ਉਨ੍ਹਾ ਤੋਂ ਪਰਮਾਤਮਾ (ਹਮੇਸ਼ਾ) ਵਖ ਰਹਿੰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "तिन ते भिंन रहत करतारा ॥",
      "sourceLineId": "77265",
      "sourceShabadId": "7510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬੇਦ ਕਤੇਬ ਬਿਖੈ ਹਰਿ ਨਾਹੀਂ ॥",
      "transliteration": "bedh kateb bikhai har naahee(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵੇਦਾ ਕਤੇਬਾ ਵਿਚ ਪਰਮਾਤਮਾ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "बेद कतेब बिखै हरि नाहीं ॥",
      "sourceLineId": "77266",
      "sourceShabadId": "7510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਾਨ ਲੇਹੁ ਹਰਿਜਨ ਮਨ ਮਾਹੀਂ ॥੬੧॥",
      "transliteration": "jaan leh harijan man maahee(n) ||61||",
      "translation": "O men of God! Understand this that the Lord doth not reside in Vedas and katebs. 61.",
      "punjabiViakhya": "(ਇਸ ਤੱਥ ਨੂੰ) ਹਰਿ-ਜਨ ਆਪਣੇ ਮਨ ਵਿਚ ਚੰਗੀ ਤਰ੍ਹਾ ਜਾਣ ਲੈਣ ॥੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "जान लेहु हरिजन मन माहीं ॥६१॥",
      "sourceLineId": "77267",
      "sourceShabadId": "7510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਆਂਖ ਮੂੰਦਿ ਕੋਊ ਡਿੰਭ ਦਿਖਾਵੈ ॥",
      "transliteration": "aa(n)kh moo(n)dh kouoo ddi(n)bh dhikhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਕੋਈ ਅੱਖਾ ਬੰਦ ਕਰ ਕੇ ਪਾਖੰਡ ਕਰਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "आँख मूँदि कोऊ डिंभ दिखावै ॥",
      "sourceLineId": "77268",
      "sourceShabadId": "7510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਆਂਧਰ ਕੀ ਪਦਵੀ ਕਹਿ ਪਾਵੈ ॥",
      "transliteration": "aa(n)dhar kee padhavee keh paavai ||",
      "translation": "He, who exhibits heresy in closing his eyes, attains the state of blindness.",
      "punjabiViakhya": "ਤਾ ਉਹ ਅੰਨ੍ਰਹਿਆਂ ਦਾ ਪਦ ਪ੍ਰਾਪਤ ਕਰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "आँधर की पदवी कहि पावै ॥",
      "sourceLineId": "77269",
      "sourceShabadId": "7510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਆਂਖਿ ਮੀਚ ਮਗ ਸੂਝ ਨ ਜਾਈ ॥",
      "transliteration": "aa(n)kh meech mag soojh na jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਖਾ ਮੀਟਣ ਨਾਲ (ਜਦ) ਰਸਤਾ ਹੀ ਨਹੀਂ ਦਿਸਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "आँखि मीच मग सूझ न जाई ॥",
      "sourceLineId": "77270",
      "sourceShabadId": "7510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਾਹਿ ਅਨੰਤ ਮਿਲੈ ਕਿਮ ਭਾਈ ॥੬੨॥",
      "transliteration": "taeh ana(n)t milai kim bhaiee ||62||",
      "translation": "By closing the eyes one cannot know the path, how can then, O brother! He meet the Infinite Lord?62.",
      "punjabiViakhya": "ਤਾ ਹੇ ਭਾਈ! ਉਸ ਨੂੰ ਪਰਮਾਤਮਾ ਕਿਵੇਾਂ ਮਿਲੇਗਾ ॥੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "ताहि अनंत मिलै किम भाई ॥६२॥",
      "sourceLineId": "77271",
      "sourceShabadId": "7510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਹੁ ਬਿਸਥਾਰ ਕਹ ਲਉ ਕੋਈ ਕਹੈ ॥",
      "transliteration": "bahu bisathaar keh lau koiee kahai ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਵਿਸਤਾਰ ਨਾਲ ਕੋਈ ਕਿਥੋਂ ਤਕ ਕਹੇ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "बहु बिसथार कह लउ कोई कहै ॥",
      "sourceLineId": "77272",
      "sourceShabadId": "7510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਮਝਤ ਬਾਤਿ ਥਕਤ ਹੁਐ ਰਹੈ ॥",
      "transliteration": "samajhat baat thakat huaai rahai ||",
      "translation": "To what extent, can the details be given? When one understands, he feels tired.",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ) (ਅਧਿਆਤਮਿਕ ਭੇਦ ਦੀ) ਗੱਲ ਸਮਝਣ ਤਕ (ਸਾਧਕ) ਥਕ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "समझत बाति थकत हुऐ रहै ॥",
      "sourceLineId": "77273",
      "sourceShabadId": "7510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਸਨਾ ਧਰੈ ਕਈ ਜੋ ਕੋਟਾ ॥",
      "transliteration": "rasanaa dharai kiee jo koTaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਕੋਈ ਕਰੋੜਾ ਜੀਭਾ ਧਾਰਨ ਕਰ ਲਏ,",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "रसना धरै कई जो कोटा ॥",
      "sourceLineId": "77274",
      "sourceShabadId": "7510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਦਪਿ ਗਨਤ ਤਿਹ ਪਰਤ ਸੁ ਤੋਟਾ ॥੬੩॥",
      "transliteration": "tadhap ganat teh parat su toTaa ||63||",
      "translation": "If one is blessed with millions of tongues, even then he feels them short in number, (while singing the Praises of the Lord)63.",
      "punjabiViakhya": "ਤਾ ਵੀ (ਉਸ ਦੇ ਨਾਮਾ ਅਥਵਾ ਗੁਣਾ ਦੀ) ਗਿਣਤੀ ਕਰਦਿਆਂ, ਘਾਟ ਹੀ ਮਹਿਸੂਸ ਹੋਵੇਗੀ ॥੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "तदपि गनत तिह परत सु तोटा ॥६३॥",
      "sourceLineId": "77275",
      "sourceShabadId": "7510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "77276",
      "sourceShabadId": "7511",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਬ ਆਇਸੁ ਪ੍ਰਭ ਕੋ ਭਯੋ ਜਨਮੁ ਧਰਾ ਜਗ ਆਇ ॥",
      "transliteration": "jab aais prabh ko bhayo janam dharaa jag aai ||",
      "translation": "When the Lord Willed, I was born on this earth.",
      "punjabiViakhya": "ਜਦੋਂ ਪ੍ਰਭੂ ਦੀ ਆਗਿਆ ਹੋਈ ਤਾ (ਮੈਂ) ਇਸ ਸੰਸਾਰ ਵਿਚ ਜਨਮ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "जब आइसु प्रभ को भयो जनमु धरा जग आइ ॥",
      "sourceLineId": "77277",
      "sourceShabadId": "7511",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਬ ਮੈ ਕਥਾ ਸੰਛੇਪ ਤੇ ਸਬਹੂੰ ਕਹਤ ਸੁਨਾਇ ॥੬੪॥",
      "transliteration": "ab mai kathaa sa(n)chhep te sabahoo(n) kahat sunai ||64||",
      "translation": "Now I shall narrate briefly my own story.64.",
      "punjabiViakhya": "ਹੁਣ ਮੈਂ ਕਥਾ ਨੂੰ ਸੰਖੇਪ ਨਾਲ ਸਾਰਿਆਂ ਨੂੰ ਕਹਿ ਕੇ ਸੁਣਾਉਾਂਦਾ ਹਾ ॥੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "अब मै कथा संछेप ते सबहूँ कहत सुनाइ ॥६४॥",
      "sourceLineId": "77278",
      "sourceShabadId": "7511",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਮਮ ਆਗਿਆ ਕਾਲ ਜਗ ਪ੍ਰਵੇਸ ਕਰਨ ਨਾਮ ਖਸਟਮੋ ਧਿਆਇ ਸਮਾਪਤ ਸਤੁ ਸੁਭ ਮਸਤੁ ॥੬॥ਅਫਜੂ॥੨੭੯॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the mam aagiaa kaal jag praves karan naam khasaTamo dhiaai samaapat sat subh masat ||6||afajoo||279||",
      "translation": "End of the Sixth Chapter of BACHITTAR NATAK entitled The Command of Supreme KAL to Me for Coming into the World.6.279.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ 'ਮਮ ਆਗਿਆ ਕਾਲ ਜਗ ਪ੍ਰਵੇਸ਼ ਕਰਨਾ' ਨਾ ਦਾ ਛੇਵਾ ਅਧਿਆਇ ਸਮਾਪਤ ਹੁੰਦਾ ਹੈ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੬॥ਅਫਜੂ॥੨੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे मम आगिआ काल जग प्रवेस करन नाम खसटमो धिआइ समापत सतु सुभ मसतु ॥६॥अफजू॥२७९॥",
      "sourceLineId": "77279",
      "sourceShabadId": "7511",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਥ ਕਬਿ ਜਨਮ ਕਥਨੰ ॥",
      "transliteration": "ath kab janam kathana(n) ||",
      "translation": "HERE BEGINS THE DESCRIPTION OF THE BIRTH OF THE POET.",
      "punjabiViakhya": "ਹੁਣ ਕਵੀ ਦੇ ਜਨਮ ਦਾ ਕਥਨ:",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "अथ कबि जनम कथनं ॥",
      "sourceLineId": "77280",
      "sourceShabadId": "7512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "77281",
      "sourceShabadId": "7512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮੁਰ ਪਿਤ ਪੂਰਬ ਕੀਯਸਿ ਪਯਾਨਾ ॥",
      "transliteration": "mur pit poorab keeyas payaanaa ||",
      "translation": "My father (Guru Tegh Bahadur) proceeded towards the east.",
      "punjabiViakhya": "ਮੇਰੇ ਪਿਤਾ (ਭਾਵ ਗੁਰੂ ਤੇਗ ਬਹਾਦੁਰ) ਨੇ ਪੂਰਬ ਵਲ ਜਾਣਾ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "मुर पित पूरब कीयसि पयाना ॥",
      "sourceLineId": "77282",
      "sourceShabadId": "7512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਭਾਂਤਿ ਭਾਂਤਿ ਕੇ ਤੀਰਥਿ ਨਾਨਾ ॥",
      "transliteration": "bhaa(n)t bhaa(n)t ke teerath naanaa ||",
      "translation": "He bathed at several places of pilgrimage.",
      "punjabiViakhya": "ਅਤੇ ਭਿੰਨ ਭਿੰਨ ਤੀਰਥਾ ਉਤੇ ਇਸ਼ਨਾਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "भाँति भाँति के तीरथि नाना ॥",
      "sourceLineId": "77283",
      "sourceShabadId": "7512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਬ ਹੀ ਜਾਤ ਤ੍ਰਿਬੇਣੀ ਭਏ ॥",
      "transliteration": "jab hee jaat tirabenee bhe ||",
      "translation": "When he went to Triveni (Prayag),",
      "punjabiViakhya": "ਜਦ ਉਹ ਤ੍ਰਿਵੇਣੀ (ਪ੍ਰਯਾਗ) ਪਹੁੰਚੇ,",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "जब ही जात तृबेणी भए ॥",
      "sourceLineId": "77284",
      "sourceShabadId": "7512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪੁੰਨ ਦਾਨ ਦਿਨ ਕਰਤ ਬਿਤਏ ॥੧॥",
      "transliteration": "pu(n)n dhaan dhin karat bite ||1||",
      "translation": "he passed his days in acts of charity ||1||",
      "punjabiViakhya": "(ਤਾ ਉਥੇ) ਪੁੰਨ-ਦਾਨ ਕਰਦਿਆਂ ਕਈ ਦਿਨ ਬਿਤਾ ਦਿੱਤੇ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "पुँन दान दिन करत बितए ॥१॥",
      "sourceLineId": "77285",
      "sourceShabadId": "7512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਹੀ ਪ੍ਰਕਾਸ ਹਮਾਰਾ ਭਯੋ ॥",
      "transliteration": "tahee prakaas hamaaraa bhayo ||",
      "translation": "I was conceived there.",
      "punjabiViakhya": "ਉਥੇ ਹੀ ਸਾਡਾ ਪ੍ਰਕਾਸ਼ ਹੋਇਆ (ਅਰਥਾਤ ਗਰਭ-ਸਥਿਤ ਹੋਏ)",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "तही प्रकास हमारा भयो ॥",
      "sourceLineId": "77286",
      "sourceShabadId": "7512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪਟਨਾ ਸਹਰ ਬਿਖੈ ਭਵ ਲਯੋ ॥",
      "transliteration": "paTanaa sahar bikhai bhav layo ||",
      "translation": "I took birth at Patna City.",
      "punjabiViakhya": "ਅਤੇ ਪਟਨਾ ਸ਼ਹਿਰ ਵਿਚ ਜਨਮ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "पटना सहर बिखै भव लयो ॥",
      "sourceLineId": "77287",
      "sourceShabadId": "7512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮੱਦ੍ਰ ਦੇਸ ਹਮ ਕੋ ਲੇ ਆਏ ॥",
      "transliteration": "ma'dhr dhes ham ko le aae ||",
      "translation": "When I was brought to Punjab,",
      "punjabiViakhya": "(ਪੂਰਬ ਤੋਂ) ਸਾਨੂੰ ਮਦ੍ਰ ਦੇਸ਼ (ਪੰਜਾਬ) ਵਿਚ ਲੈ ਆਏ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "मद्द्र देस हम को ले आए ॥",
      "sourceLineId": "77288",
      "sourceShabadId": "7512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭਾਂਤਿ ਭਾਂਤਿ ਦਾਈਅਨਿ ਦੁਲਰਾਏ ॥੨॥",
      "transliteration": "bhaa(n)t bhaa(n)t dhaieean dhularaae ||2||",
      "translation": "I was nurtured by various nurses. ||2||",
      "punjabiViakhya": "ਅਤੇ ਤਰ੍ਹਾ ਤਰ੍ਹਾ ਦਾਈਆਂ ਨੇ ਲਾਡ ਕਰਕੇ (ਵੱਡਾ ਕੀਤਾ) ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "भाँति भाँति दाईअनि दुलराए ॥२॥",
      "sourceLineId": "77289",
      "sourceShabadId": "7512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕੀਨੀ ਅਨਿਕ ਭਾਂਤਿ ਤਨ ਰੱਛਾ ॥",
      "transliteration": "keenee anik bhaa(n)t tan ra'chhaa ||",
      "translation": "I was given physical protection in various ways.",
      "punjabiViakhya": "ਅਨੇਕ ਤਰ੍ਹਾ ਨਾਲ (ਮੇਰੇ) ਸ਼ਰੀਰ ਦੀ ਰਖਿਆ ਕੀਤੀ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "कीनी अनिक भाँति तन रच्छा ॥",
      "sourceLineId": "77290",
      "sourceShabadId": "7512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੀਨੀ ਭਾਂਤਿ ਭਾਂਤਿ ਕੀ ਸਿੱਛਾ ॥",
      "transliteration": "dheenee bhaa(n)t bhaa(n)t kee si'chhaa ||",
      "translation": "And I was given various types of education.",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਤਰ੍ਹਾ ਦੀ ਸਿਖਿਆ ਦਿੱਤੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "दीनी भाँति भाँति की सिच्छा ॥",
      "sourceLineId": "77291",
      "sourceShabadId": "7512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਬ ਹਮ ਧਰਮ ਕਰਮ ਮੋ ਆਏ ॥",
      "transliteration": "jab ham dharam karam mo aae ||",
      "translation": "When I began to understand the righteous path,",
      "punjabiViakhya": "ਜਦ ਅਸੀਂ ਧਰਮ ਕਰਮ (ਨੂੰ ਸਮਝਣ ਦੇ) ਯੋਗ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "जब हम धरम करम मो आए ॥",
      "sourceLineId": "77292",
      "sourceShabadId": "7512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦੇਵ ਲੋਕ ਤਬ ਪਿਤਾ ਸਿਧਾਏ ॥੩॥",
      "transliteration": "dhev lok tab pitaa sidhaae ||3||",
      "translation": "my father departed for his heavenly abode ||3||",
      "punjabiViakhya": "ਤਾ ਪਿਤਾ ਜੀ ਦੇਵ-ਲੋਕ ਨੂੰ ਚਲੇ ਗਏ (ਭਾਵ ਸ਼ਹੀਦ ਹੋ ਗਏ) ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "देव लोक तब पिता सिधाए ॥३॥",
      "sourceLineId": "77293",
      "sourceShabadId": "7512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਕਬਿ ਜਨਮ ਕਥਨੰ ਨਾਮ ਸਪਤਮੋ ਧਿਆਇ ਸਮਾਪਤ ਮਸਤੁ ਸੁਭ ਮਸਤੁ ॥੭॥ਅਫਜੂ॥੨੮੨॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the kab janam kathana(n) naam sapatamo dhiaai samaapat masat subh masat ||7||afajoo||282||",
      "translation": "End of the Seventh Chapter of BACHITTTAR NATAK entitled Description of the Poet.7.282",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦਾ 'ਕਬਿ ਜਨਮ ਕਥਨ' ਨਾ ਦਾ ਸੱਤਵਾ ਅਧਿਆਇ ਸਮਾਪਤ ਹੋਇਆ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੭॥੨੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे कबि जनम कथनं नाम सपतमो धिआइ समापत मसतु सुभ मसतु ॥७॥अफजू॥२८२॥",
      "sourceLineId": "77294",
      "sourceShabadId": "7512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਥ ਰਾਜ ਸਾਜ ਕਥਨੰ ॥",
      "transliteration": "ath raaj saaj kathana(n) ||",
      "translation": "Here begins the Description of the Magnificence of Authority:",
      "punjabiViakhya": "ਹੁਣ ਰਾਜ-ਸਾਜ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "अथ राज साज कथनं ॥",
      "sourceLineId": "77295",
      "sourceShabadId": "7513",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "77296",
      "sourceShabadId": "7513",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰਾਜ ਸਾਜ ਹਮ ਪਰ ਜਬ ਆਯੋ ॥",
      "transliteration": "raaj saaj ham par jab aayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਗੁਰਗੱਦੀ (ਰਾਜ) ਦੀ ਜ਼ਿਮੇਵਾਰੀ ਸਾਡੇ ਉਤੇ ਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "राज साज हम पर जब आयो ॥",
      "sourceLineId": "77297",
      "sourceShabadId": "7513",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਥਾ ਸਕਤ ਤਬ ਧਰਮ ਚਲਾਯੋ ॥",
      "transliteration": "jathaa sakat tab dharam chalaayo ||",
      "translation": "When I obtained the position of responsibility, I performed the religious acts to the best of my ability.",
      "punjabiViakhya": "ਤਾ (ਅਸਾ) ਆਪਣੀ ਵਿਤ ਅਨੁਸਾਰ ਧਰਮ ਦਾ ਪ੍ਰਚਲਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "जथा सकत तब धरम चलायो ॥",
      "sourceLineId": "77298",
      "sourceShabadId": "7513",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਾਂਤਿ ਭਾਂਤਿ ਬਨ ਖੇਲ ਸਿਕਾਰਾ ॥",
      "transliteration": "bhaa(n)t bhaa(n)t ban khel sikaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਬਨ ਵਿਚ ਤਰ੍ਹਾ ਤਰ੍ਹਾ ਦੇ ਸ਼ਿਕਾਰ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "भाँति भाँति बन खेल सिकारा ॥",
      "sourceLineId": "77299",
      "sourceShabadId": "7513",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਾਰੇ ਰੀਛ ਰੋਝ ਝੰਖਾਰਾ ॥੧॥",
      "transliteration": "maare reechh rojh jha(n)khaaraa ||1||",
      "translation": "I went hunting various kinds of animals in the forest and killed bears, nilgais (blue bulls) and elks.1.",
      "punjabiViakhya": "ਅਤੇ ਰਿਛ, ਰੋਝ (ਨੀਲਗਾਏ) ਅਤੇ ਬਾਰਹ ਸਿੰਘੇ ਮਾਰੇ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "मारे रीछ रोझ झंखारा ॥१॥",
      "sourceLineId": "77300",
      "sourceShabadId": "7513",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦੇਸ ਚਾਲ ਹਮ ਤੇ ਪੁਨਿ ਭਈ ॥",
      "transliteration": "dhes chaal ham te pun bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਸਾਨੂੰ ਦੇਸ (ਆਨੰਦਪੁਰ) ਤੋਂ ਜਾਣਾ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "देस चाल हम ते पुनि भई ॥",
      "sourceLineId": "77301",
      "sourceShabadId": "7513",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਹਰ ਪਾਂਵਟਾ ਕੀ ਸੁਧਿ ਲਈ ॥",
      "transliteration": "sahar paa(n)vaTaa kee sudh liee ||",
      "translation": "Then I left my home and went to place named Paonta.",
      "punjabiViakhya": "ਅਤੇ ਪਾਵਟਾ ਨਗਰ ਵਲ ਚਲੇ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "सहर पाँवटा की सुधि लई ॥",
      "sourceLineId": "77302",
      "sourceShabadId": "7513",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਾਲਿੰਦ੍ਰੀ ਤਟਿ ਕਰੇ ਬਿਲਾਸਾ ॥",
      "transliteration": "kaali(n)dhree taT kare bilaasaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ) ਜਮਨਾ ਨਦੀ ਦੇ ਕੰਢੇ (ਅਨੇਕ) ਕੌਤਕ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "कालिंद्री तटि करे बिलासा ॥",
      "sourceLineId": "77303",
      "sourceShabadId": "7513",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਨਿਕ ਭਾਂਤ ਕੇ ਪੇਖ ਤਮਾਸਾ ॥੨॥",
      "transliteration": "anik bhaa(n)t ke pekh tamaasaa ||2||",
      "translation": "I enjoyed my stay on the banks of Kalindri (Yamuna) and saw amusement of various kind2.",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਤਰ੍ਹਾ ਦੇ ਤਮਾਸ਼ੇ ਵੇਖੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "अनिक भाँत के पेख तमासा ॥२॥",
      "sourceLineId": "77304",
      "sourceShabadId": "7513",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਹ ਕੇ ਸਿੰਘ ਘਨੇ ਚੁਨਿ ਮਾਰੇ ॥",
      "transliteration": "teh ke si(n)gh ghane chun maare ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੋਂ (ਦੇ ਜੰਗਲ ਵਿਚੋਂ) ਅਨੇਕ ਸ਼ੇਰ ਚੁਣ ਚੁਣ ਕੇ ਮਾਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "तह के सिंघ घने चुनि मारे ॥",
      "sourceLineId": "77305",
      "sourceShabadId": "7513",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਰੋਝ ਰੀਛ ਬਹੁ ਭਾਂਤਿ ਬਿਦਾਰੇ ॥",
      "transliteration": "rojh reechh bahu bhaa(n)t bidhaare ||",
      "translation": "There I killed many lions, nilgais and bears.",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਤਰ੍ਹਾ ਦੇ ਰਿਛਾ ਅਤੇ ਨੀਲਗਾਵਾ (ਰੋਝ) ਨੂੰ ਮਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "रोझ रीछ बहु भाँति बिदारे ॥",
      "sourceLineId": "77306",
      "sourceShabadId": "7513",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਫਤੇਸਾਹ ਕੋਪਾ ਤਬਿ ਰਾਜਾ ॥",
      "transliteration": "fatesaeh kopaa tab raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਫਤੇ ਸ਼ਾਹ ਰਾਜਾ (ਸਾਡੇ ਨਾਲ) ਖ਼ਫ਼ਾ ਹੋ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "फतेसाह कोपा तबि राजा ॥",
      "sourceLineId": "77307",
      "sourceShabadId": "7513",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਲੋਹ ਪਰਾ ਹਮ ਸੋ ਬਿਨੁ ਕਾਜਾ ॥੩॥",
      "transliteration": "loh paraa ham so bin kaajaa ||3||",
      "translation": "On this the king Fateh Shah become angry and fought with me without any reason.3.",
      "punjabiViakhya": "(ਫਲਸਰੂਪ) ਬਿਨਾ ਕਿਸੇ ਕਾਰਨ ਸਾਡੇ ਨਾਲ ਜੰਗ ਹੋ ਗਈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "लोह परा हम सो बिनु काजा ॥३॥",
      "sourceLineId": "77308",
      "sourceShabadId": "7513",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "77309",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਹਾਂ ਸਾਹ ਸ੍ਰੀਸਾਹ ਸੰਗ੍ਰਾਮ ਕੋਪੇ ॥",
      "transliteration": "tahaa(n) saeh sreesaeh sa(n)graam kope ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਯੁੱਧ ਵਿਚ ਸ੍ਰੀ ਸੰਗੋ ਸ਼ਾਹ ਕ੍ਰੋਧ ਵਿਚ ਆ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "तहाँ साह स्रीसाह संग्राम कोपे ॥",
      "sourceLineId": "77310",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪੰਚੋ ਬੀਰ ਬੰਕੇ ਪ੍ਰਿਥੀ ਪਾਇ ਰੋਪੇ ॥",
      "transliteration": "pa(n)cho beer ba(n)ke pirathee pai rope ||",
      "translation": "There Sri Shah (Sango Shah) become enraged and all the five warriors stood firmly in the battlefield.",
      "punjabiViakhya": "ਅਤੇ ਪੰਜਾ ਭਰਾਵਾ (ਬੀਬੀ ਵੀਰੋ ਦੇ ਪੁੱਤਰਾ) ਨੇ ਧਰਤੀ ਉਤੇ ਪੈਰ ਜਮਾ ਦਿੱਤੇ (ਅਰਥਾਤ ਯੁੱਧ ਲਈ ਡਟ ਗਏ)।",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "पंचो बीर बंके पृथी पाइ रोपे ॥",
      "sourceLineId": "77311",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਹਠੀ ਜੀਤਮੱਲੰ ਸੁ ਗਾਜੀ ਗੁਲਾਬੰ ॥",
      "transliteration": "haThee jeetama'la(n) su gaajee gulaaba(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੀਤ ਮਲ ਹਠੀ ਯੋਧਾ ਸੀ ਅਤੇ ਗੁਲਾਬ (ਰਾਇ) ਪਰਮ ਸੂਰਮਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "हठी जीतमल्लं सु गाजी गुलाबं ॥",
      "sourceLineId": "77312",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਰਣੰ ਦੇਖੀਐ ਰੰਗ ਰੂਪੰ ਸਹਾਬੰ ॥੪॥",
      "transliteration": "rana(n) dhekheeaai ra(n)g roopa(n) sahaaba(n) ||4||",
      "translation": "Including the tenacious Jit Mal and the desparate hero Gulab, whose faces were red with ire, in the field.4.",
      "punjabiViakhya": "ਯੁੱਧ ਦਾ ਰੰਗ ਵੇਖ ਕੇ (ਉਨ੍ਹਾ ਨੂੰ) ਲਾਲੀਆਂ ਚੜ੍ਹ ਗਈਆਂ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "रणं देखीऐ रंग रूपं सहाबं ॥४॥",
      "sourceLineId": "77313",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਹਠਿਯੋ ਮਾਹਰੀਚੰਦਯੰ ਗੰਗਰਾਮੰ ॥",
      "transliteration": "haThiyo maahareecha(n)dhaya(n) ga(n)garaama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਹਰੀ ਚੰਦ ਅਤੇ ਗੰਗਾ ਰਾਮ ਡਟ ਕੇ ਲੜੇ,",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "हठियो माहरीचंदयं गंगरामं ॥",
      "sourceLineId": "77314",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਿਨੈ ਕਿਤਯੰ ਜਿਤੀਯੰ ਫੌਜ ਤਾਮੰ ॥",
      "transliteration": "jinai kitaya(n) jiteeya(n) fauaj taama(n) ||",
      "translation": "The persistent Mahari Chand and Ganga Ram, who had defeated lot of forces.",
      "punjabiViakhya": "ਜਿਨ੍ਹਾ ਨੇ ਕਿਤਨੀਆਂ ਹੀ ਫ਼ੌਜਾ ਨੂੰ ਜਿਤ ਕੇ (ਸ਼ਿਕਾਰੀ ਜਾਨਵਰਾ ਲਈ ਉਨ੍ਹਾ ਦਾ) ਖਾਜਾ (ਤਾਮ) ਬਣਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "जिनै कितयं जितीयं फौज तामं ॥",
      "sourceLineId": "77315",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕੁਪੇ ਲਾਲਚੰਦੰ ਕੀਏ ਲਾਲ ਰੂਪੰ ॥",
      "transliteration": "kupe laalacha(n)dha(n) ke'ee laal roopa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਲਾਲ ਚੰਦ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਸੂਹੇ-ਲਾਲ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "कुपे लालचंदं कीए लाल रूपं ॥",
      "sourceLineId": "77316",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਿਨੈ ਗੱਜੀਯੰ ਗਰਬ ਸਿੰਘੰ ਅਨੂਪੰ ॥੫॥",
      "transliteration": "jinai ga'jeeya(n) garab si(n)gha(n) anoopa(n) ||5||",
      "translation": "Lal Chand was red with anger, who had shattered pride of several lion-like heroes.5.",
      "punjabiViakhya": "ਜਿਨ੍ਹਾ ਨੇ ਅਨੂਪਮ ਸ਼ੇਰਾ ਦਾ ਹੰਕਾਰ ਤੋੜ ਦਿੱਤਾ ਸੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "जिनै गज्जीयं गरब सिंघं अनूपं ॥५॥",
      "sourceLineId": "77317",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕੁਪਿਯੋ ਮਾਹਰੂ ਕਾਹਰੂ ਰੂਪ ਧਾਰੇ ॥",
      "transliteration": "kupiyo maaharoo kaaharoo roop dhaare ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਹਰੀ ਚੰਦ ਨੇ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਭਿਆਨਕ ਰੂਪ ਧਾਰਨ ਕਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "कुपियो माहरू काहरू रूप धारे ॥",
      "sourceLineId": "77318",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਜਿਨੈ ਖਾਨ ਖਾਵੀਨਿਯੰ ਖੇਤ ਮਾਰੇ ॥",
      "transliteration": "jinai khaan khaaveeniya(n) khet maare ||",
      "translation": "Maharu got enraged and with frightening expression killed brave Khans in the battlefield.",
      "punjabiViakhya": "ਜਿਨ੍ਹਾ ਨੇ ਵਡੇ ਵਡੇ ਖਬੀ ਖ਼ਾਨਾ ਨੂੰ ਮਾਰਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "जिनै खान खावीनियं खेत मारे ॥",
      "sourceLineId": "77319",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਕੁਪਿਓ ਦੇਵਤੇਸੰ ਦਯਾਰਾਮ ਜੁੱਧੰ ॥",
      "transliteration": "kupio dhevatesa(n) dhayaaraam ju'dha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਵਿਚ ਦਯਾ ਰਾਮ ਬ੍ਰਾਹਮਣ ਨੇ ਵੀ ਬਹੁਤ ਕ੍ਰੋਧ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "कुपिओ देवतेसं दयाराम जुद्धं ॥",
      "sourceLineId": "77320",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਕੀਯੋ ਦ੍ਰੋਣ ਕੀ ਜਿਉ ਮਹਾ ਜੱੁਧ ਸੱੁਧੰ ॥੬॥",
      "transliteration": "keeyo dhron kee jiau mahaa ja'udh sa'udha(n) ||6||",
      "translation": "The godly Daya Ram, filled with great ire, fought very heroically in the field like Dronacharya.6.",
      "punjabiViakhya": "ਅਤੇ ਦ੍ਰੋਣਾਚਾਰਯ ਵਰਗਾ (ਭਿਆਨਕ) ਯੁੱਧ ਮਚਾਇਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "कीयो द्रोण की जिउ महा जु्ुध सु्ुधं ॥६॥",
      "sourceLineId": "77321",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਕ੍ਰਿਪਾਲ ਕੋਪੀਯੰ ਕੁਤਕੋ ਸੰਭਾਰੀ ॥",
      "transliteration": "kirapaal kopeeya(n) kutako sa(n)bhaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਮਹੰਤ) ਕ੍ਰਿਪਾਲ ਦਾਸ ਨੇ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਸੋਟਾ ਸੰਭਾਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "कृपाल कोपीयं कुतको संभारी ॥",
      "sourceLineId": "77322",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਹਠੀ ਖਾਨਹੱਯਾਤ ਕੇ ਸੀਸ ਝਾਰੀ ॥",
      "transliteration": "haThee khaanaha'yaat ke sees jhaaree ||",
      "translation": "Kirpal in rage, rushed with his mace and struck it on the head of the tenacious Hayaat Khan.",
      "punjabiViakhya": "ਅਤੇ ਹਠਵਾਨ ਨੇ ਹਯਾਤ ਖ਼ਾਨ ਦੇ ਸਿਰ ਉਤੇ ਝਾੜ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "हठी खानहय्यात के सीस झारी ॥",
      "sourceLineId": "77323",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਉੱਠੀ ਛਿੱਛ ਇੱਛੰ ਕਢਾ ਮੇਝ ਜੋਰੰ ॥",
      "transliteration": "au'Thee chhi'chh i'chha(n) kaddaa mejh jora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਜ਼ੋਰ ਨਾਲ (ਹਯਾਤ ਖ਼ਾਨ ਦੀ) ਮਿਝ ਕਢ ਦਿੱਤੀ ਅਤੇ ਉਸ ਦੀਆਂ ਛਿਟਾ ਇੰਜ ਉਠੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "उट्ठी छिच्छ इच्छं कढा मेझ जोरं ॥",
      "sourceLineId": "77324",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਮਨੋ ਮਾਖਨੰ ਮੱਟਕੀ ਕਾਨ੍ਹ ਫੋਰੰ ॥੭॥",
      "transliteration": "mano maakhana(n) ma'Takee kaanh fora(n) ||7||",
      "translation": "With all his might, he caused the marrow flow out of his head, which splashed like the butter spattering out of the pitcher of butter broken by lord Krishan.7.",
      "punjabiViakhya": "ਮਾਨੋ ਕਾਨ੍ਹ ਨੇ ਮੱਖਣ ਦੀ ਮਟਕੀ ਭੰਨ ਦਿੱਤੀ ਹੋਵੇ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "मनो माखनं मट्टकी कान्ह फोरं ॥७॥",
      "sourceLineId": "77325",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਤਹਾ ਨੰਦਚੰਦੰ ਕੀਯੋ ਕੋਪੁ ਭਾਰੋ ॥",
      "transliteration": "tahaa na(n)dhacha(n)dha(n) keeyo kop bhaaro ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ (ਉਸੇ ਵੇਲੇ ਦੀਵਾਨ) ਨੰਦ ਚੰਦ ਨੇ ਬਹੁਤ ਕ੍ਰੋਧ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "तहा नंदचंदं कीयो कोपु भारो ॥",
      "sourceLineId": "77326",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਲਗਾਈ ਬਰੱਛੀ ਕ੍ਰਿਪਾਣੰ ਸੰਭਾਰੋ ॥",
      "transliteration": "lagaiee bara'chhee kirapaana(n) sa(n)bhaaro ||",
      "translation": "Then Nand Chand, in fierce rage, wielding his sword struck it with force.",
      "punjabiViakhya": "ਅਤੇ ਬਰਛੀ ਨਾਲ ਵਾਰ ਕੀਤਾ ਅਤੇ ਕ੍ਰਿਪਾਨ ਨੂੰ ਸੰਭਾਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "लगाई बरच्छी कृपाणं संभारो ॥",
      "sourceLineId": "77327",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਤੁਟੀ ਤੇਗ ਤ੍ਰਿੱਖੀ ਕਢੇ ਜਮਦੱਢੰ ॥",
      "transliteration": "tuTee teg tira'khee kadde jamadha'dda(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਲੜਦਿਆਂ ਲੜਦਿਆਂ) ਤਿਖੀ ਤਲਵਾਰ ਟੁੱਟ ਗਈ ਅਤੇ ਉਸ ਨੇ ਕਟਾਰ ਕਢ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "तुटी तेग तृक्खी कढे जमदड्ढं ॥",
      "sourceLineId": "77328",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਹਠੀ ਰਾਖਯੰ ਲੱਜ ਬੰਸੰ ਸੱਨਢੰ ॥੮॥",
      "transliteration": "haThee raakhaya(n) la'j ba(n)sa(n) sa'nadda(n) ||8||",
      "translation": "But it broke. Then he drew his dagger and the tenacious warrior saved the honour of the Sodhi clan.8.",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਹਾ ਉਸ) ਦ੍ਰਿੜ੍ਹ ਸੂਰਮੇ ਨੇ ਸੋਢੀ ਬੰਸ ਦੀ ਲਾਜ ਰਖ ਲਈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "हठी राखयं लज्ज बंसं सन्नढं ॥८॥",
      "sourceLineId": "77329",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਤਹਾਂ ਮਾਤਲੇਯੰ ਕ੍ਰਿਪਾਲੰ ਕ੍ਰੱੁਧੰ ॥",
      "transliteration": "tahaa(n) maataleya(n) kirapaala(n) kra'udha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਮਾਮਾ ਕ੍ਰਿਪਾਲ ਨੇ ਕ੍ਰੋਧ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "तहाँ मातलेयं कृपालं क्रु्ुधं ॥",
      "sourceLineId": "77330",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਛਕਿਓ ਛੋਭ ਛੱਤ੍ਰੀ ਕਰਯੋ ਜੱੁਧ ਸੱੁਧੰ ॥",
      "transliteration": "chhakio chhobh chha'tree karayo ja'udh sa'udha(n) ||",
      "translation": "Then the Maternal uncle Kirpal, in great ire, manifested the war-feats like a true Kshatriya.",
      "punjabiViakhya": "ਅਤੇ ਛਾਤ੍ਰ-ਤੇਜ ਵਿਚ ਰੰਗੀਜ ਕੇ ਉਨ੍ਹਾ ਨੇ ਭਿਆਨਕ ਯੁੱਧ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "छकिओ छोभ छत्त्री करयो जु्ुध सु्ुधं ॥",
      "sourceLineId": "77331",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਸਹੇ ਦੇਹ ਆਪੰ ਮਹਾਂ ਬੀਰ ਬਾਣੰ ॥",
      "transliteration": "sahe dheh aapa(n) mahaa(n) beer baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮਹਾ ਬੀਰ ਨੇ ਆਪਣੇ ਸ਼ਰੀਰ ਉਤੇ ਬਾਣ ਸਹਾਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "सहे देह आपं महाँ बीर बाणं ॥",
      "sourceLineId": "77332",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਕਰੋ ਖਾਨ ਬਾਨੀਨ ਖਾਲੀ ਪਲਾਣੰ ॥੯॥",
      "transliteration": "karo khaan baaneen khaalee palaana(n) ||9||",
      "translation": "The great hero was struck by an arrow, but he caused the brave Khan to fall from the saddle.9.",
      "punjabiViakhya": "ਪਰ ਬਾਕੇ ਖ਼ਾਨਾ ਦੇ (ਘੋੜਿਆਂ ਦੀਆਂ) ਕਾਠੀਆਂ (ਸਵਾਰਾ ਤੋਂ) ਸਖਣੀਆਂ ਕਰ ਦਿੱਤੀਆਂ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "करो खान बानीन खाली पलाणं ॥९॥",
      "sourceLineId": "77333",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਹਠਿਯੋ ਸਾਹਬੰਚੰਦ ਖੇਤੰ ਖਤ੍ਰਿਯਾਣੰ ॥",
      "transliteration": "haThiyo saahaba(n)cha(n)dh kheta(n) khatirayaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹਠੀ ਸਾਹਿਬ ਚੰਦ ਪੂਰੇ ਛਾਤ੍ਰ-ਪੁਣੇ ਨਾਲ ਯੁੱਧ-ਭੂਮੀ (ਵਿਚ ਲੜਿਆ ਅਤੇ)",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "हठियो साहबंचंद खेतं खतृयाणं ॥",
      "sourceLineId": "77334",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0060_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਹਨੇ ਖਾਨ ਖੂਨੀ ਖੁਰਾਸਾਨ ਭਾਨੰ ॥",
      "transliteration": "hane khaan khoonee khuraasaan bhaana(n) ||",
      "translation": "Sahib Chand, the valiant Kshatriya, killed a bloody Khan of Khorasan.",
      "punjabiViakhya": "ਖੁਰਾਸਾਨ ਦੇ ਤੇਜਸਵੀ ਅਤੇ ਖ਼ੂਨਖਾਰ ਖ਼ਾਨਾ ਨੂੰ ਮਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 60,
      "hindi": "",
      "hindiTransliteration": "हने खान खूनी खुरासान भानं ॥",
      "sourceLineId": "77335",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    }
  ]
}
