{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 61,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0061_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਹਾਂ ਬੀਰ ਬੰਕੇ ਭਲੀ ਭਾਂਤਿ ਮਾਰੇ ॥",
      "transliteration": "tahaa(n) beer ba(n)ke bhalee bhaa(n)t maare ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਬਾਕੇ ਸੂਰਮਿਆਂ ਨੂੰ ਚੰਗੀ ਤਰ੍ਹਾ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "तहाँ बीर बंके भली भाँति मारे ॥",
      "sourceLineId": "77336",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਚੇ ਪ੍ਰਾਨ ਲੈ ਕੇ ਸਿਪਾਹੀ ਸਿਧਾਰੇ ॥੧੦॥",
      "transliteration": "bache praan lai ke sipaahee sidhaare ||10||",
      "translation": "He slew several graceful warriors, with full force  the soldiers who survived, fled away in order to save their lives.10.",
      "punjabiViakhya": "(ਕੇਵਲ ਉਹੀ) ਬਚੇ ਜੋ ਪ੍ਰਾਣ ਲੈ ਕੇ ਭਜ ਗਏ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "बचे प्रान लै के सिपाही सिधारे ॥१०॥",
      "sourceLineId": "77337",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਹਾਂ ਸਾਹ ਸੰਗ੍ਰਾਮ ਕੀਨੇ ਅਖਾਰੇ ॥",
      "transliteration": "tahaa(n) saeh sa(n)graam keene akhaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਸੰਗੋ ਸ਼ਾਹ ਨੇ ਯੁੱਧ (ਦੇ ਕਰਤਬ ਵਿਖਾਉਣ ਲਈ) ਅਖਾੜਾ ਬਣਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "तहाँ साह संग्राम कीने अखारे ॥",
      "sourceLineId": "77338",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਘਨੇ ਖੇਤ ਮੋ ਖਾਨ ਖੂਨੀ ਲਤਾਰੇ ॥",
      "transliteration": "ghane khet mo khaan khoonee lataare ||",
      "translation": "There (Sango) Shah exhibited his acts of bravery in the battlefield and trampled under feet many bloody Khans.",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਸਾਰੇ ਖ਼ੂਨਖ਼ਾਰ ਪਠਾਣਾ ਨੂੰ ਮਿਧ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "घने खेत मो खान खूनी लतारे ॥",
      "sourceLineId": "77339",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨ੍ਰਿਪੰ ਗੋਪਲਾਯੰ ਖਰੋ ਖੇਤ ਗਾਜੈ ॥",
      "transliteration": "nirapa(n) gopalaaya(n) kharo khet gaajai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਵੇਲੇ ਗੁਲੇਰੀਆ) ਰਾਜਾ ਗੋਪਾਲ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਖੜੋ ਕੇ ਗਜ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "नृपं गोपलायं खरो खेत गाजै ॥",
      "sourceLineId": "77340",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮ੍ਰਿਗਾ ਝੁੰਡ ਮੱਧਿਯੰ ਮਨੋ ਸਿੰਘ ਰਾਜੈ ॥੧੧॥",
      "transliteration": "miragaa jhu(n)dd ma'dhiya(n) mano si(n)gh raajai ||11||",
      "translation": "Gopal, the king of Guleria, stood firmly in the field and roared like a lion amidst a herd of deers.11.",
      "punjabiViakhya": "ਮਾਨੋ ਹਿਰਨਾ ਦੇ ਝੁੰਡ ਵਿਚ ਸ਼ੇਰ ਸੋਭ ਰਿਹਾ ਹੋਵੇ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "मृगा झुँड मद्धियं मनो सिंघ राजै ॥११॥",
      "sourceLineId": "77341",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਹਾਂ ਏਕ ਬੀਰੰ ਹਰੀ ਚੰਦ ਕੋਪ੍ਯੋ ॥",
      "transliteration": "tahaa(n) ek beera(n) haree cha(n)dh kopayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਦੋਂ ਇਕ ਸੂਰਮੇ ਹਰੀ ਚੰਦ ਨੇ ਕ੍ਰੋਧ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "तहाँ एक बीरं हरी चंद कोप्यो ॥",
      "sourceLineId": "77342",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭਲੀ ਭਾਂਤਿ ਸੋ ਖੇਤ ਮੋ ਪਾਵ ਰੋਪ੍ਯੋ ॥",
      "transliteration": "bhalee bhaa(n)t so khet mo paav ropayo ||",
      "translation": "There in great fury, a warrior Hari Chand, very skillfully took position in the battlefield.",
      "punjabiViakhya": "ਅਤੇ ਚੰਗੀ ਤਰ੍ਹਾ ਨਾਲ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਪੈਰ ਗਡ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "भली भाँति सो खेत मो पाव रोप्यो ॥",
      "sourceLineId": "77343",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਹਾ ਕ੍ਰੋਧ ਕੈ ਤੀਰ ਤੀਖੇ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "mahaa krodh kai teer teekhe prahaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਬਹੁਤ ਕ੍ਰੋਧ ਕਰ ਕੇ ਤਿਖੇ ਤੀਰ ਚਲਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "महा क्रोध कै तीर तीखे प्रहारे ॥",
      "sourceLineId": "77344",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਲਗੈ ਜੌਨ ਕੇ ਤਾਹਿ ਪਾਰੈ ਪਧਾਰੇ ॥੧੨॥",
      "transliteration": "lagai jauan ke taeh paarai padhaare ||12||",
      "translation": "He discharged sharp arrows in great rage and whosoever was struck, left for the other world.12.",
      "punjabiViakhya": "ਕਿ ਜਿਨ੍ਹਾ ਨੂੰ ਲਗੇ ਉਹ (ਸੰਸਾਰ ਤੋਂ) ਪਰਲੇ ਪਾਸੇ ਚਲੇ ਗਏ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "लगै जौन के ताहि पारै पधारे ॥१२॥",
      "sourceLineId": "77345",
      "sourceShabadId": "7514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "77346",
      "sourceShabadId": "7515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਰੀਚੰਦ ਕ੍ਰੁੱਧੰ ॥",
      "transliteration": "hareecha(n)dh kru'dha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹਰੀ ਚੰਦ ਨੇ ਕ੍ਰੋਧ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "हरीचंद क्रुद्धं ॥",
      "sourceLineId": "77347",
      "sourceShabadId": "7515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹਨੇ ਸੂਰ ਸੁੱਧੰ ॥",
      "transliteration": "hane soor su'dha(n) ||",
      "translation": "Hari Chand (Handooria) in great fury, killed significant heroes.",
      "punjabiViakhya": "ਚੰਗੇ ਸੂਰਮੇ ਮਾਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "हने सूर सुद्धं ॥",
      "sourceLineId": "77348",
      "sourceShabadId": "7515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਭਲੇ ਬਾਣ ਬਾਹੇ ॥",
      "transliteration": "bhale baan baahe ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਤੀਰਾ ਦੀ ਚੰਗੀ ਵਾਛੜ ਲਗਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "भले बाण बाहे ॥",
      "sourceLineId": "77349",
      "sourceShabadId": "7515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਡੇ ਸੈਨ ਗਾਹੇ ॥੧੩॥",
      "transliteration": "badde sain gaahe ||13||",
      "translation": "He shot skillfully a volley of arrows and killed a lot of forces.13.",
      "punjabiViakhya": "ਅਤੇ ਵਡੇ ਵਡੇ ਸੈਨਿਕਾ ਨੂੰ ਮਿਧ ਸੁਟਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "बडे सैन गाहे ॥१३॥",
      "sourceLineId": "77350",
      "sourceShabadId": "7515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰਸੰ ਰੁੱਦ੍ਰ ਰਾਚੇ ॥",
      "transliteration": "rasa(n) ru'dhr raache ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਰੌਦਰ ਰਸ ਵਿਚ (ਪੂਰੀ ਤਰ੍ਹਾ) ਮਗਨ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "रसं रुद्द्र राचे ॥",
      "sourceLineId": "77351",
      "sourceShabadId": "7515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਹਾ ਲੋਹ ਮਾਚੇ ॥",
      "transliteration": "mahaa loh maache ||",
      "translation": "He was absorbed in dreadful feat of arms.",
      "punjabiViakhya": "(ਇਸ ਲਈ) ਘੋਰ ਯੁੱਧ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "महा लोह माचे ॥",
      "sourceLineId": "77352",
      "sourceShabadId": "7515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਹਨੇ ਸਸਤ੍ਰ ਧਾਰੀ ॥",
      "transliteration": "hane sasatr dhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰ-ਧਾਰੀਆਂ ਨੂੰ (ਉਸ ਨੇ) ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "हने ससत्र धारी ॥",
      "sourceLineId": "77353",
      "sourceShabadId": "7515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਲਿਟੇ ਭੂਪ ਭਾਰੀ ॥੧੪॥",
      "transliteration": "liTe bhoop bhaaree ||14||",
      "translation": "Armed warriors were being killed and great kings were falling on the ground.14.",
      "punjabiViakhya": "ਅਤੇ ਵਡੇ ਵਡੇ ਰਾਜਿਆਂ ਨੂੰ (ਧਰਤੀ ਉਤੇ) ਲਿਟਾ ਦਿੱਤਾ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "लिटे भूप भारी ॥१४॥",
      "sourceLineId": "77354",
      "sourceShabadId": "7515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਬੈ ਜੀਤਮੱਲੰ ॥",
      "transliteration": "tabai jeetama'la(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ (ਸਾਡੇ ਸੂਰਮੇ) ਜੀਤ ਮੱਲ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "तबै जीतमल्लं ॥",
      "sourceLineId": "77355",
      "sourceShabadId": "7515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹਰੀਚੰਦ ਭੱਲੰ ॥",
      "transliteration": "hareecha(n)dh bha'la(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਲਾ ਲੈ ਕੇ ਹਰੀ ਚੰਦ ਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "हरीचंद भल्लं ॥",
      "sourceLineId": "77356",
      "sourceShabadId": "7515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਹ੍ਰਿਦੈ ਐਂਚ ਮਾਰਿਓ ॥",
      "transliteration": "hiradhai aai(n)ch maario ||",
      "translation": "",
      "punjabiViakhya": "ਹਿਰਦੇ ਵਿਚ ਤਣ ਕੇ ਮਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "हृदै ऐंच मारिओ ॥",
      "sourceLineId": "77357",
      "sourceShabadId": "7515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੁ ਖੇਤੰ ਉਤਾਰਿਓ ॥੧੫॥",
      "transliteration": "s kheta(n) utaario ||15||",
      "translation": "Then Jit Mal aimed and struck Hari Chand down to the ground with his spear.15.",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਭੁੰਜੇ ਸੁਟ ਦਿੱਤਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "सु खेतं उतारिओ ॥१५॥",
      "sourceLineId": "77358",
      "sourceShabadId": "7515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਲਗੇ ਬੀਰ ਬਾਣੰ ॥",
      "transliteration": "lage beer baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵੀਰ-ਯੋਧਿਆਂ ਨੂੰ ਤੀਰ ਲਗਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "लगे बीर बाणं ॥",
      "sourceLineId": "77359",
      "sourceShabadId": "7515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਰਿਸਿਯੋ ਤੇਜਿ ਮਾਣੰ ॥",
      "transliteration": "risiyo tej maana(n) ||",
      "translation": "The warriors struck with arrows became red with blood.",
      "punjabiViakhya": "ਅਤੇ ਉਹ ਅਗਨੀ ਵਾਗ (ਤੇਜਿ ਮਾਣੰ) ਲਹੂ ਨਾਲ ਲਾਲ ਹੋ ਜਾਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "रिसियो तेजि माणं ॥",
      "sourceLineId": "77360",
      "sourceShabadId": "7515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਮੁਹ ਬਾਜ ਡਾਰੇ ॥",
      "transliteration": "samuh baaj ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸਾਰੇ ਘੋੜਿਆਂ ਨੂੰ ਛਡ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "समुह बाज डारे ॥",
      "sourceLineId": "77361",
      "sourceShabadId": "7515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੁਵਰਗੰ ਸਿਧਾਰੇ ॥੧੬॥",
      "transliteration": "suvaraga(n) sidhaare ||16||",
      "translation": "Their horses feel and they left for heavens.16.",
      "punjabiViakhya": "ਸੁਅਰਗ ਨੂੰ ਸਿਧਾਰ ਜਾਦੇ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "सुवरगं सिधारे ॥१६॥",
      "sourceLineId": "77362",
      "sourceShabadId": "7515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "77363",
      "sourceShabadId": "7516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਖੁਲੈ ਖਾਨ ਖੂਨੀ ਖੁਰਾਸਾਨ ਖੱਗੰ ॥",
      "transliteration": "khulai khaan khoonee khuraasaan kha'ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਖ਼ੂਨਖ਼ਾਰ ਪਠਾਣਾ ਨੇ ਖੁਰਾਸਾਨ ਦੀਆਂ ਨੰਗੀਆਂ ਤਲਵਾਰਾ (ਸੂਤੀਆਂ ਹੋਈਆਂ ਸਨ)",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "खुलै खान खूनी खुरासान खग्गं ॥",
      "sourceLineId": "77364",
      "sourceShabadId": "7516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪਰੀ ਸਸਤ੍ਰ ਧਾਰੰ ਉਠੀ ਝਾਲ ਅੱਗੰ ॥",
      "transliteration": "paree sasatr dhaara(n) uThee jhaal a'ga(n) ||",
      "translation": "In the hands of blood-thirsty Khans, there were the Khorasan swords, whose sharp edges flashed like fire.",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਸਤ੍ਰਾ ਦੇ (ਇਕ ਦੂਜੇ ਉਤੇ) ਵਜਣ ਨਾਲ ਅੱਗ ਦੀਆਂ ਚਿੰਗਾਰੀਆਂ ਨਿਕਲਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "परी ससत्र धारं उठी झाल अग्गं ॥",
      "sourceLineId": "77365",
      "sourceShabadId": "7516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭਈ ਤੀਰ ਭੀਰੰ ਕਮਾਣੰ ਕੱੜਕੇ ॥",
      "transliteration": "bhiee teer bheera(n) kamaana(n) ka'Rake ||",
      "translation": "",
      "punjabiViakhya": "(ਆਕਾਸ਼ ਵਿਚ) ਤੀਰਾ ਦੀ ਭੀੜ ਲਗ ਗਈ ਸੀ ਅਤੇ ਕਮਾਨਾ ਕੜ ਕੜ ਕਰਨ ਲਗੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "भई तीर भीरं कमाणं कड़्ड़के ॥",
      "sourceLineId": "77366",
      "sourceShabadId": "7516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗਿਰੇ ਬਾਜ ਤਾਜੀ ਲਗੇ ਧੀਰ ਧੱਕੇ ॥੧੭॥",
      "transliteration": "gire baaj taajee lage dheer dha'ke ||17||",
      "translation": "The bows shooing out volleys of arrows twanged, the splendid horses fell because of the heavy blows.17.",
      "punjabiViakhya": "ਧੀਰਜ ਵਾਲੇ ਸੂਰਮਿਆਂ ਦੇ ਧੱਕੇ ਵਜਣ ਨਾਲ ਕਈ ਅਰਬੀ ਘੋੜੇ ਡਿਗ ਰਹੇ ਸਨ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "गिरे बाज ताजी लगे धीर धक्के ॥१७॥",
      "sourceLineId": "77367",
      "sourceShabadId": "7516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਜੀ ਭੇਰਿ ਭੁੰਕਾਰ ਧੁੱਕੇ ਨਗਾਰੇ ॥",
      "transliteration": "bajee bher bhu(n)kaar dhu'ke nagaare ||",
      "translation": "",
      "punjabiViakhya": "ਭੇਰੀਆਂ ਭੂੰ-ਭੂੰ ਕਰ ਕੇ ਵਜ ਰਹੀਆਂ ਸਨ ਅਤੇ ਨਗਾਰੇ ਧੁੰਕਾਰ (ਪਾ ਰਹੇ ਸਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "बजी भेरि भुँकार धुक्के नगारे ॥",
      "sourceLineId": "77368",
      "sourceShabadId": "7516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦੁਹੂੰ ਓਰ ਤੇ ਬੀਰ ਬੰਕੇ ਬਕਾਰੇ ॥",
      "transliteration": "dhuhoo(n) or te beer ba(n)ke bakaare ||",
      "translation": "The trumpets sounded and the musical pipes were played, the brave warriors thundered from both sides.",
      "punjabiViakhya": "ਦੋਹਾ ਪਾਸਿਆਂ ਤੋਂ ਬਾਕੇ ਵੀਰ ਲਲਕਾਰੇ ਮਾਰ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "दुहूँ ओर ते बीर बंके बकारे ॥",
      "sourceLineId": "77369",
      "sourceShabadId": "7516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਰੇ ਬਾਹੁ ਆਘਾਤ ਸਸਤ੍ਰੰ ਪ੍ਰਹਾਰੰ ॥",
      "transliteration": "kare baahu aaghaat sasatra(n) prahaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਹਵਾ ਨੂੰ ਉਲਾਰ ਕੇ ਸ਼ਸਤ੍ਰਾ ਨਾਲ ਸਟ ਮਾਰਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "करे बाहु आघात ससत्रं प्रहारं ॥",
      "sourceLineId": "77370",
      "sourceShabadId": "7516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਡਕੀ ਡਾਕਣੀ ਚਾਂਵਡੀ ਚੀਤਕਾਰੰ ॥੧੮॥",
      "transliteration": "ddakee ddaakanee chaa(n)vaddee cheetakaara(n) ||18||",
      "translation": "And with their strong arms struck (the enemy), the witches drank blood to their fill and produced dreadful sounds.18.",
      "punjabiViakhya": "(ਅਤੇ ਯੁੱਧ-ਸਥਲ ਵਿਚ) ਡਾਕਣੀਆਂ ਡਕਾਰ ਰਹੀਆਂ ਸਨ ਅਤੇ ਚਾਮੁੰਡੀਆਂ ਚੀਕਾ ਮਾਰ ਰਹੀਆਂ ਸਨ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "डकी डाकणी चाँवडी चीतकारं ॥१८॥",
      "sourceLineId": "77371",
      "sourceShabadId": "7516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "77372",
      "sourceShabadId": "7517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਹਾ ਲਗੇ ਬਰਨਨ ਕਰੋਂ ਮਚਿਯੋ ਜੁਧੁ ਅਪਾਰ ॥",
      "transliteration": "kahaa lage baranan karo(n) machiyo judh apaar ||",
      "translation": "How far should I describe the great battle?",
      "punjabiViakhya": "ਕਿਥੋਂ ਤਕ ਵਰਣਨ ਕਰਾ, ਭਿਆਨਕ ਯੁੱਧ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "कहा लगे बरनन करों मचियो जुधु अपार ॥",
      "sourceLineId": "77373",
      "sourceShabadId": "7517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜੇ ਲੱੁਝੇ ਜੁੱਝੇ ਸਬੈ ਭੱਜੇ ਸੂਰ ਹਜਾਰ ॥੧੯॥",
      "transliteration": "je la'ujhe ju'jhe sabai bha'je soor hajaar ||19||",
      "translation": "Those fought attained martyrdom, thousands fled away. 19.",
      "punjabiViakhya": "ਜਿਹੜੇ (ਸੂਰਮੇ) ਲੜੇ ਸਨ (ਉਹ) ਸਾਰੇ ਮਾਰੇ ਗਏ ਸਨ ਅਤੇ ਹਜ਼ਾਰਾ ਯੋਧੇ (ਯੁੱਧ-ਭੂਮੀ ਵਿਚੋਂ) ਭਜ ਗਏ ਸਨ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "जे लु्ुझे जुज्झे सबै भज्जे सूर हजार ॥१९॥",
      "sourceLineId": "77374",
      "sourceShabadId": "7517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "77375",
      "sourceShabadId": "7518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭਜਿਯੋ ਸਾਹ ਪਹਾੜਤਾਜੀ ਤ੍ਰਿਪਾਯੰ ॥",
      "transliteration": "bhajiyo saeh pahaaRataajee tirapaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਆਖਰ) ਪਹਾੜੀ ਰਾਜਾ (ਫਤਿਹ ਸ਼ਾਹ) ਘੋੜੇ ਨੂੰ ਟਪੋਸੀ ਮਰਵਾ ਕੇ ਭਜ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "भजियो साह पहाड़ताजी तृपायं ॥",
      "sourceLineId": "77376",
      "sourceShabadId": "7518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚਲਿਯੋ ਬੀਰੀਯਾ ਤੀਰੀਯਾ ਨ ਚਲਾਯੰ ॥",
      "transliteration": "chaliyo beereeyaa teereeyaa na chalaaya(n) ||",
      "translation": "The hill-chief spurred his horse and fled, the warriors went away without discharging their arrows.",
      "punjabiViakhya": "ਭਜੇ ਜਾਦੇ ਉਤੇ (ਸਾਡੇ) ਵੀਰਾ ਨੇ (ਕੋਈ) ਤੀਰ ਨਾ ਚਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "चलियो बीरीया तीरीया न चलायं ॥",
      "sourceLineId": "77377",
      "sourceShabadId": "7518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਸੋ ਡੱਢਵਾਲੰ ਮਧੁੱਕਰ ਸੁ ਸਾਹੰ ॥",
      "transliteration": "jaso dda'ddavaala(n) madhu'kar su saaha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਪਿਛੋਂ) ਜਸੋ ਵਾਲੀਆ ਅਤੇ ਡੱਡਵਾਲੀਆ ਮਧੁਕਰ ਸ਼ਾਹ (ਯੁੱਧ ਲਈ ਨਾ ਡਟ ਸਕੇ ਅਤੇ)",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "जसो डड्ढवालं मधुक्कर सु साहं ॥",
      "sourceLineId": "77378",
      "sourceShabadId": "7518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਭਜੇ ਸੰਗਿ ਲੈ ਕੇ ਸੁ ਸਾਰੀ ਸਿਪਾਹੰ ॥੨੦॥",
      "transliteration": "bhaje sa(n)g lai ke su saaree sipaaha(n) ||20||",
      "translation": "The chiefs of Jaswal and Dadhwal, who were fighting (in the field), left with all their soldiers.20.",
      "punjabiViakhya": "ਆਪਣੀ ਸਾਰੀ ਸੈਨਾ ਲੈ ਕੇ ਭਜ ਗਏ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "भजे संगि लै के सु सारी सिपाहं ॥२०॥",
      "sourceLineId": "77379",
      "sourceShabadId": "7518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚਕ੍ਰਿਤ ਚੋਪਿਯੋ ਚੰਦ ਗਾਜੀ ਚੰਦੇਲੰ ॥",
      "transliteration": "chakirat chopiyo cha(n)dh gaajee cha(n)dhela(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਸਥਿਤੀ ਤੋਂ) ਹੈਰਾਨ ਹੋ ਕੇ ਯੁੱਧ-ਵੀਰ ਚੰਦੇਲੀਆ (ਰਾਜਾ) ਜੋਸ਼ ਵਿਚ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "चकृत चोपियो चंद गाजी चंदेलं ॥",
      "sourceLineId": "77380",
      "sourceShabadId": "7518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਠੀ ਹਰੀਚੰਦੰ ਗਹੇ ਹਾਥ ਸੇਲੰ ॥",
      "transliteration": "haThee hareecha(n)dha(n) gahe haath sela(n) ||",
      "translation": "The Raja of Chandel was perplexed, when the tenacious Hari Chand caught hold of the spear in his hand.",
      "punjabiViakhya": "(ਉਧਰੋਂ) ਹਠੀ ਹਰੀਚੰਦ ਹੱਥ ਵਿਚ ਬਰਛਾ ਫੜ ਕੇ (ਆਇਆ)।",
      "source": "DASAM_GRANTH",
      "ang": 61,
      "hindi": "",
      "hindiTransliteration": "हठी हरीचंदं गहे हाथ सेलं ॥",
      "sourceLineId": "77381",
      "sourceShabadId": "7518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0061_line_0047",
      "lineIndex": 47,
