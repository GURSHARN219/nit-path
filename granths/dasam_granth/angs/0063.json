{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 63,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0063_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਵਹੈ ਕਾਲ ਘਾਯੰ ॥੩੩॥",
      "transliteration": "vahai kaal ghaaya(n) ||33||",
      "translation": "The chief of Kot Lehar was seized by death.33.",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੀ ਕਾਲ ਨੇ ਮਾਰ ਦਿੱਤਾ ॥੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "वहै काल घायं ॥३३॥",
      "sourceLineId": "77432",
      "sourceShabadId": "7521",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਣੰ ਤਿਆਗਿ ਭਾਗੇ ॥",
      "transliteration": "rana(n) tiaag bhaage ||",
      "translation": "",
      "punjabiViakhya": "(ਫਲਸਰੂਪ ਰਾਜੇ) ਯੁੱਧ-ਭੂਮੀ ਨੂੰ ਛਡ ਕੇ ਭਜ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "रणं तिआगि भागे ॥",
      "sourceLineId": "77433",
      "sourceShabadId": "7521",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਬੈ ਤ੍ਰਾਸ ਪਾਗੇ ॥",
      "transliteration": "sabai traas paage ||",
      "translation": "The hill-men fled from the battlefield, all were filled with fear.",
      "punjabiViakhya": "ਸਾਰੇ ਅਤਿਅੰਤ ਭੈਭੀਤ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "सबै त्रास पागे ॥",
      "sourceLineId": "77434",
      "sourceShabadId": "7521",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭਈ ਜੀਤ ਮੇਰੀ ॥",
      "transliteration": "bhiee jeet meree ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੀ ਜਿਤ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "भई जीत मेरी ॥",
      "sourceLineId": "77435",
      "sourceShabadId": "7521",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਕਾਲ ਕੇਰੀ ॥੩੪॥",
      "transliteration": "kirapaa kaal keree ||34||",
      "translation": "I gained victory through the favour of the Eternal Lord (KAL).34.",
      "punjabiViakhya": "(ਸਭ ਕੁਝ) ਕਾਲ ਦੀ ਕ੍ਰਿਪਾ ਕਰਕੇ (ਹੋਇਆ) ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "कृपा काल केरी ॥३४॥",
      "sourceLineId": "77436",
      "sourceShabadId": "7521",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਣੰ ਜੀਤਿ ਆਏ ॥",
      "transliteration": "rana(n) jeet aae ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਨੂੰ ਜਿਤ ਕੇ (ਅਸੀਂ ਵਾਪਸ) ਪਰਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "रणं जीति आए ॥",
      "sourceLineId": "77437",
      "sourceShabadId": "7521",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਯੰ ਗੀਤ ਗਾਏ ॥",
      "transliteration": "jaya(n) geet gaae ||",
      "translation": "We returned after victory and sang songs of triumph.",
      "punjabiViakhya": "ਅਤੇ ਜਿਤ ਦੇ ਗੀਤ ਗਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "जयं गीत गाए ॥",
      "sourceLineId": "77438",
      "sourceShabadId": "7521",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਧਨੰ ਧਾਰ ਬਰਖੇ ॥",
      "transliteration": "dhana(n) dhaar barakhe ||",
      "translation": "",
      "punjabiViakhya": "ਧਨ ਦਾ ਮੀਂਹ ਵਸਾ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "धनं धार बरखे ॥",
      "sourceLineId": "77439",
      "sourceShabadId": "7521",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਬੈ ਸੂਰ ਹਰਖੇ ॥੩੫॥",
      "transliteration": "sabai soor harakhe ||35||",
      "translation": "I showered wealth on the warriors, who were full of rejoicings.35.",
      "punjabiViakhya": "(ਜਿਸ ਕਰਕੇ) ਸਾਰੇ ਸੂਰਮੇ ਪ੍ਰਸੰਨ ਹੋ ਗਏ ॥੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "सबै सूर हरखे ॥३५॥",
      "sourceLineId": "77440",
      "sourceShabadId": "7521",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "77441",
      "sourceShabadId": "7522",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੁਧ ਜੀਤ ਆਏ ਜਬੈ ਟਿਕੈ ਨ ਤਿਨ ਪੁਰ ਪਾਂਵ ॥",
      "transliteration": "judh jeet aae jabai Tikai na tin pur paa(n)v ||",
      "translation": "When I returned after victory, I did not remain at Paonta.",
      "punjabiViakhya": "ਜਦ (ਮੇਰੇ ਸੈਨਿਕ) ਯੁੱਧ ਜਿਤ ਕੇ ਆਏ (ਤਾ) ਉਨ੍ਹਾ ਦੇ ਨਗਰ (ਪੁਰ) ਵਿਚ ਪੈਰ ਨਾ ਟਿਕੇ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "जुध जीत आए जबै टिकै न तिन पुर पाँव ॥",
      "sourceLineId": "77442",
      "sourceShabadId": "7522",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਾਹਲੂਰ ਮੈ ਬਾਂਧਿਯੋ ਆਨ ਆਨੰਦਪੁਰ ਗਾਂਵ ॥੩੬॥",
      "transliteration": "kaahaloor mai baa(n)dhiyo aan aana(n)dhapur gaa(n)v ||36||",
      "translation": "I came to Kahlur and established the village Anandpur.36.",
      "punjabiViakhya": "ਕਹਿਲੂਰ (ਦੀ ਰਿਆਸਤ ਵਿਚ) ਆ ਕੇ ਆਨੰਦਪੁਰ ਪਿੰਡ ਨੂੰ ਆਬਾਦ ਕੀਤਾ ॥੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "काहलूर मै बाँधियो आन आनंदपुर गाँव ॥३६॥",
      "sourceLineId": "77443",
      "sourceShabadId": "7522",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੇ ਜੇ ਨਰ ਤਹ ਨ ਭਿਰੇ ਦੀਨੇ ਨਗਰ ਨਿਕਾਰ ॥",
      "transliteration": "je je nar teh na bhire dheene nagar nikaar ||",
      "translation": "Those, who did not join the forces, were turned out from the town.",
      "punjabiViakhya": "ਜਿਹੜੇ ਜਿਹੜੇ ਆਦਮੀ ਉਥੇ (ਭੰਗਾਣੀ ਵਿਚ) ਨਹੀਂ ਲੜੇ ਸਨ, ਉਨ੍ਹਾ ਨੂੰ ਨਗਰ ਤੋਂ ਕੱਢ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "जे जे नर तह न भिरे दीने नगर निकार ॥",
      "sourceLineId": "77444",
      "sourceShabadId": "7522",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜੇ ਤਿਹ ਠਉਰ ਭਲੇ ਭਿਰੇ ਤਿਨੈ ਕਰੀ ਪ੍ਰਤਿਪਾਰ ॥੩੭॥",
      "transliteration": "je teh Thaur bhale bhire tinai karee pratipaar ||37||",
      "translation": "And those who fought bravely were patronized by me 37.",
      "punjabiViakhya": "ਜਿਹੜੇ ਉਸ ਥਾ ਚੰਗੀ ਤਰ੍ਹਾ ਲੜੇ ਸਨ, ਉਨ੍ਹਾ ਦੀ (ਚੰਗੀ) ਪ੍ਰਤਿਪਾਲਣਾ ਕੀਤੀ ॥੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "जे तिह ठउर भले भिरे तिनै करी प्रतिपार ॥३७॥",
      "sourceLineId": "77445",
      "sourceShabadId": "7522",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "77446",
      "sourceShabadId": "7523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਹੁਤ ਦਿਵਸ ਇਹ ਭਾਂਤਿ ਬਿਤਾਏ ॥",
      "transliteration": "bahut dhivas ieh bhaa(n)t bitaae ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਹਾ ਬਹੁਤ ਦਿਨ ਬਤੀਤ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "बहुत दिवस इह भाँति बिताए ॥",
      "sourceLineId": "77447",
      "sourceShabadId": "7523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੰਤ ਉਬਾਰ ਦੁਸਟ ਸਭ ਘਾਏ ॥",
      "transliteration": "sa(n)t ubaar dhusaT sabh ghaae ||",
      "translation": "Many days passed in this way, the saints were protected and the wicked persons were killed.",
      "punjabiViakhya": "ਸੰਤਾ ਨੂੰ ਉਚਿਆ ਕੇ ਸਾਰੇ ਦੁਸ਼ਟ ਮਾਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "संत उबार दुसट सभ घाए ॥",
      "sourceLineId": "77448",
      "sourceShabadId": "7523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਟਾਂਗ ਟਾਂਗ ਕਰਿ ਹਨੇ ਨਿਦਾਨਾ ॥",
      "transliteration": "Taa(n)g Taa(n)g kar hane nidhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਹਾ ਮੂਰਖਾ ਨੂੰ ਟੰਗ ਟੰਗ ਕੇ ਮਾਰ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "टाँग टाँग करि हने निदाना ॥",
      "sourceLineId": "77449",
      "sourceShabadId": "7523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕੂਕਰ ਜਿਮਿ ਤਿਨ ਤਜੇ ਪਰਾਨਾ ॥੩੮॥",
      "transliteration": "kookar jim tin taje paraanaa ||38||",
      "translation": "The tyrants were hanged ultimately killed, they breathed their last like dogs.38.",
      "punjabiViakhya": "ਉਨ੍ਹਾ ਨੇ ਕੁਤਿਆਂ ਵਾਗ ਪ੍ਰਾਣ ਛੱਡੇ ॥੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "कूकर जिमि तिन तजे पराना ॥३८॥",
      "sourceLineId": "77450",
      "sourceShabadId": "7523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਭੰਗਾਣੀ ਜੁੱਧ ਬਰਨਨੰ ਨਾਮ ਅਸਟਮੋ ਧਿਆਇ ਸਮਾਪਤ ਮਸਤੁ ਸੁਭ ਮਸਤੁ ॥੮॥ਅਫਜੂ॥੩੨੦॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the bha(n)gaanee ju'dh baranana(n) naam asaTamo dhiaai samaapat masat subh masat ||8||afajoo||320||",
      "translation": "End of the Eighth Chapter of BACHITTAR NATAK entitled ‘Description of the Battle of Bhangani.’8.320.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ 'ਰਾਜ-ਸਾਜ ਕਥਨ' ਅਤੇ 'ਭੰਗਾਣੀ ਜੁਧ ਬਰਨਨੰ' ਨਾ ਦਾ ਅੱਠਵਾ ਅਧਿਆਇ ਸਮਾਪਤ ਹੁੰਦਾ ਹੈ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੮॥ਅਫਜੂ॥੩੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे भंगाणी जुद्ध बरननं नाम असटमो धिआइ समापत मसतु सुभ मसतु ॥८॥अफजू॥३२०॥",
      "sourceLineId": "77451",
      "sourceShabadId": "7523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਥ ਨਦਉਣ ਕਾ ਜੁੱਧ ਬਰਨਨੰ ॥",
      "transliteration": "ath nadhaun kaa ju'dh baranana(n) ||",
      "translation": "Here begins the Description of the Battle of Nadaun:",
      "punjabiViakhya": "ਹੁਣ ਨਣੌਣ ਦੇ ਯੁੱਧ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "अथ नदउण का जुद्ध बरननं ॥",
      "sourceLineId": "77452",
      "sourceShabadId": "7524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "77453",
      "sourceShabadId": "7524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਹੁਤ ਕਾਲ ਇਹ ਭਾਂਤਿ ਬਿਤਾਯੋ ॥",
      "transliteration": "bahut kaal ieh bhaa(n)t bitaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਹਾ ਬਹੁਤ ਸਮਾ ਬਤੀਤ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "बहुत काल इह भाँति बितायो ॥",
      "sourceLineId": "77454",
      "sourceShabadId": "7524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮੀਆਂ ਖਾਨ ਜੰਮੂ ਕਹ ਆਯੋ ॥",
      "transliteration": "meeaa(n) khaan ja(n)moo keh aayo ||",
      "translation": "Much time passed in this way, Mian Khan came (from Delhi) to Jammu (for collection of revenue).",
      "punjabiViakhya": "(ਦਿੱਲੀ ਤੋਂ) ਮੀਆਂ ਖ਼ਾਨ (ਮਾਲੀਆ ਵਸੂਲਣ ਲਈ) ਜੰਮੂ ਵਲ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "मीआँ खान जंमू कह आयो ॥",
      "sourceLineId": "77455",
      "sourceShabadId": "7524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਲਫ ਖਾਨ ਨਾਦੌਣ ਪਠਾਵਾ ॥",
      "transliteration": "alaf khaan naadhauan paThaavaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਅਲਫ਼ ਖ਼ਾਨ ਨੂੰ ਨਾਦੌਣ ਭੇਜਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "अलफ खान नादौण पठावा ॥",
      "sourceLineId": "77456",
      "sourceShabadId": "7524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭੀਮਚੰਦ ਤਨ ਬੈਰ ਬਢਾਵਾ ॥੧॥",
      "transliteration": "bheemacha(n)dh tan bair baddaavaa ||1||",
      "translation": "He sent Alif Khan to Nadaun, who developed enmity towards Bhim Chand (the Chief of Kahlur).1.",
      "punjabiViakhya": "(ਉਸ ਨੇ ਕਹਿਲੂਰ ਦੇ ਰਾਜੇ) ਭੀਮ ਚੰਦ ਨਾਲ ਵੈਰ ਵਧਾ ਲਿਆ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "भीमचंद तन बैर बढावा ॥१॥",
      "sourceLineId": "77457",
      "sourceShabadId": "7524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੁੱਧ ਕਾਜ ਨ੍ਰਿਪ ਹਮੈ ਬੁਲਾਯੋ ॥",
      "transliteration": "ju'dh kaaj nirap hamai bulaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਅਲਫ਼ ਖ਼ਾਨ ਨਾਲ) ਜੂਝਣ ਲਈ ਰਾਜੇ ਨੇ ਸਾਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "जुद्ध काज नृप हमै बुलायो ॥",
      "sourceLineId": "77458",
      "sourceShabadId": "7524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਆਪਿ ਤਵਨ ਕੀ ਓਰ ਸਿਧਾਯੋ ॥",
      "transliteration": "aap tavan kee or sidhaayo ||",
      "translation": "Bhim Chnad called me for assistance and himself went to face (the enemy).",
      "punjabiViakhya": "ਅਤੇ ਆਪ ਉਸ ਵਲ ਅਗੇ ਵਧਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "आपि तवन की ओर सिधायो ॥",
      "sourceLineId": "77459",
      "sourceShabadId": "7524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਿਨ ਕਠ ਗੜ ਨਵਰਸ ਪਰ ਬਾਂਧਯੋ ॥",
      "transliteration": "tin kaTh gaR navaras par baa(n)dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਲਫ਼ ਖ਼ਾਨ ਨੇ ਨਵਰਸ (ਨਾ ਵਾਲੇ ਟਿੱਲੇ) ਉਤੇ ਕਾਠ ਦਾ ਕਿਲ੍ਹਾ (ਮੋਰਚਾ) ਬਣਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "तिन कठ गड़ नवरस पर बाँधयो ॥",
      "sourceLineId": "77460",
      "sourceShabadId": "7524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤੀਰ ਤੁਫੰਗ ਨਰੇਸਨ ਸਾਧਯੋ ॥੨॥",
      "transliteration": "teer tufa(n)g naresan saadhayo ||2||",
      "translation": "Alif Khan prepared a wooden fort of the hill of Navras. The hill-chief also prepared their arrows and guns.2.",
      "punjabiViakhya": "(ਇਧਰ ਭੀਮ ਚੰਦ ਦੇ ਮੱਦਦਗਾਰ) ਰਾਜਿਆਂ ਨੇ ਵੀ ਤੀਰਾ ਅਤੇ ਬੰਦੂਕਾ ਦੀਆਂ ਸ਼ਿਸ਼ਤਾ ਬੰਨ੍ਹ ਲਈਆ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "तीर तुफंग नरेसन साधयो ॥२॥",
      "sourceLineId": "77461",
      "sourceShabadId": "7524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭੁਜੰਗ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g chha(n)dh ||",
      "translation": "BHUJANG STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "भुजंग छंद ॥",
      "sourceLineId": "77462",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਹਾ ਰਾਜ ਸਿੰਘੰ ਬਲੀ ਭੀਮਚੰਦੰ ॥",
      "transliteration": "tahaa raaj si(n)gha(n) balee bheemacha(n)dha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਭੀਮ ਚੰਦ ਨਾਲ ਬਲਵਾਨ ਰਾਜਾ ਰਾਜ ਸਿੰਘ",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "तहा राज सिंघं बली भीमचंदं ॥",
      "sourceLineId": "77463",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚੜਿਓ ਰਾਮ ਸਿੰਘੰ ਮਹਾ ਤੇਜ ਵੰਦੰ ॥",
      "transliteration": "chaRio raam si(n)gha(n) mahaa tej va(n)dha(n) ||",
      "translation": "With brave Bhim Chand, there were Raj Singh, illustrious Ram Singh,",
      "punjabiViakhya": "ਅਤੇ ਮਹਾ ਤੇਜਵੰਤ ਰਾਮ ਸਿੰਘ ਨੇ ਚੜ੍ਹਾਈ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "चड़िओ राम सिंघं महा तेज वंदं ॥",
      "sourceLineId": "77464",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੁਖੰ ਦੇਵ ਗਾਜੀ ਜਸਾਰੋਟ ਰਾਜੰ ॥",
      "transliteration": "sukha(n) dhev gaajee jasaaroT raaja(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਸਰੋਟ ਦਾ ਪ੍ਰਤਾਪੀ ਰਾਜਾ ਸੁਖਦੇਵ ਵੀ",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "सुखं देव गाजी जसारोट राजं ॥",
      "sourceLineId": "77465",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚੜੇ ਕ੍ਰੁੱਧ ਕੀਨੇ ਕਰੇ ਸਰਬ ਕਾਜੰ ॥੩॥",
      "transliteration": "chaRe kru'dh keene kare sarab kaaja(n) ||3||",
      "translation": "And Sukhdev Gaji of Jasrot, were full of fury and managed their affairs with enthusiasm.3.",
      "punjabiViakhya": "ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਚੜ੍ਰਹਿਆ (ਅਤੇ ਯੁੱਧ ਦੀ) ਸਾਰੀ ਤਿਆਰੀ ਕਰ ਲਈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "चड़े क्रुद्ध कीने करे सरब काजं ॥३॥",
      "sourceLineId": "77466",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪ੍ਰਿਥੀਚੰਦ ਚਢਿਓ ਡਢੇ ਡਢਵਾਰੰ ॥",
      "transliteration": "piratheecha(n)dh chaddio ddadde ddaddavaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਢਾਢਾ ਬਲਵਾਨ ਪ੍ਰਿਥੀਚੰਦ ਡਢਵਾਲੀਆ ਚੜ੍ਰਹਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "पृथीचंद चढिओ डढे डढवारं ॥",
      "sourceLineId": "77467",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਚਲੇ ਸਿੱਧ ਹੁਐ ਕਾਰ ਰਾਜੰ ਸੁਧਾਰੰ ॥",
      "transliteration": "chale si'dh huaai kaar raaja(n) sudhaara(n) ||",
      "translation": "There came also the brave Prithi Chand of Dadhwar after having made arrangements regarding the affairs of his state.",
      "punjabiViakhya": "(ਇਹ ਸਾਰੇ) ਤਿਆਰ ਹੋ ਕੇ ਰਾਜੇ ਦਾ ਕੰਮ ਸੰਵਾਰਨ ਲਈ ਚੜ੍ਹੇ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "चले सिद्ध हुऐ कार राजं सुधारं ॥",
      "sourceLineId": "77468",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਰੀ ਢੂਕ ਢੋਅੰ ਕਿਰਪਾਲਚੰਦੰ ॥",
      "transliteration": "karee ddook ddoa(n) kirapaalacha(n)dha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਲ ਚੰਦ ਨੇ ਨੇੜੇ ਢੁਕ ਕੇ ਹਮਲਾ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "करी ढूक ढोअं किरपालचंदं ॥",
      "sourceLineId": "77469",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹਟਾਏ ਸਬੈ ਮਾਰਿ ਕੈ ਬੀਰ ਬ੍ਰਿੰਦੰ ॥੪॥",
      "transliteration": "haTaae sabai maar kai beer bira(n)dha(n) ||4||",
      "translation": "Kirpal Chand (of Kanara) arrived with ammunition and drove back and killed many of the warriors (of Bhim Chand).4.",
      "punjabiViakhya": "ਅਤੇ ਸੂਰਮਿਆਂ ਦੇ ਜੁੱਟਾ ਨੂੰ ਮਾਰ ਕੇ ਪਿਛੇ ਕੀਤਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "हटाए सबै मारि कै बीर बृंदं ॥४॥",
      "sourceLineId": "77470",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੁਤੀਯ ਢੋਅ ਢੂਕੇ ਵਹੈ ਮਾਰਿ ਉਤਾਰੀ ॥",
      "transliteration": "dhuteey ddoa ddooke vahai maar utaaree ||",
      "translation": "",
      "punjabiViakhya": "ਦੂਜੀ ਵਾਰ ਮੁਕਾਬਲੇ ਲਈ ਢੁਕੇ, (ਉਨ੍ਹਾ ਨੂੰ) ਮਾਰ ਕੇ ਹੇਠਾ ਉਤਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "दुतीय ढोअ ढूके वहै मारि उतारी ॥",
      "sourceLineId": "77471",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਖਰੇ ਦਾਂਤ ਪੀਸੈ ਛੁਭੈ ਛੱਤ੍ਰਧਾਰੀ ॥",
      "transliteration": "khare dhaa(n)t peesai chhubhai chha'tradhaaree ||",
      "translation": "When for the second time, the forces of Bhim Chand advanced, they were beaten back downwards to the great sorrow of (the allies of Bhim Chand),",
      "punjabiViakhya": "(ਹੇਠਾ) ਪਹਾੜੀ ਰਾਜੇ ਕ੍ਰੋਧ ਨਾਲ ਦੰਦ ਪੀਹ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "खरे दाँत पीसै छुभै छत्त्रधारी ॥",
      "sourceLineId": "77472",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਉਤੈ ਵੈ ਖਰੇ ਬੀਰ ਬੰਬੈ ਬਜਾਵੈਂ ॥",
      "transliteration": "autai vai khare beer ba(n)bai bajaavai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਧਰ ਉਹ ਯੋਧੇ ਧੌਂਸੇ ਵਜਾ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "उतै वै खरे बीर बंबै बजावैं ॥",
      "sourceLineId": "77473",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਰੇ ਭੂਪ ਠਾਂਢੇ ਬਡੋ ਸੋਕੁ ਪਾਵੈਂ ॥੫॥",
      "transliteration": "tare bhoop Thaa(n)dde baddo sok paavai(n) ||5||",
      "translation": "The warriors on the hill sounded trumpets, while the chiefs below were filled with remorse.5.",
      "punjabiViakhya": "ਹੇਠਾ ਰਾਜੇ ਖੜੋ ਕੇ ਸੋਗ ਪਾਲ ਰਹੇ ਸਨ (ਅਰਥਾਤ ਦੁਖੀ ਹੋ ਕੇ ਕ੍ਰੋਧ ਕਰ ਰਹੇ ਸਨ) ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "तरे भूप ठाँढे बडो सोकु पावैं ॥५॥",
      "sourceLineId": "77474",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਬੈ ਭੀਮਚੰਦੰ ਕੀਯੋ ਕੋਪ ਆਪੰ ॥",
      "transliteration": "tabai bheemacha(n)dha(n) keeyo kop aapa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਭੀਮ ਚੰਦ ਨੇ ਆਪ ਕ੍ਰੋਧ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "तबै भीमचंदं कीयो कोप आपं ॥",
      "sourceLineId": "77475",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹਨੂਮਾਨ ਕੇ ਮੰਤ੍ਰ ਕੋ ਮੁਖ ਜਾਪੰ ॥",
      "transliteration": "hanoomaan ke ma(n)tr ko mukh jaapa(n) ||",
      "translation": "Then Bhim Chand was filled with great ire and began to recite the incantations of Hanuman.",
      "punjabiViakhya": "ਅਤੇ ਮੂੰਹ ਨਾਲ ਹਨੂਮਾਨ ਦੇ ਮੰਤ੍ਰ ਦਾ ਜਾਪ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "हनूमान के मंत्र को मुख जापं ॥",
      "sourceLineId": "77476",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਬੈ ਬੀਰ ਬੋਲੈ ਹਮੈ ਭੀ ਬੁਲਾਯੰ ॥",
      "transliteration": "sabai beer bolai hamai bhee bulaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਸੂਰਮਿਆਂ ਨੂੰ ਸਦ ਲਿਆ ਅਤੇ ਸਾਨੂੰ ਵੀ ਬੁਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "सबै बीर बोलै हमै भी बुलायं ॥",
      "sourceLineId": "77477",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਬੈ ਢੋਅ ਕੈ ਕੈ ਸੁ ਨੀਕੈ ਸਿਧਾਯੰ ॥੬॥",
      "transliteration": "tabai ddoa kai kai su neekai sidhaaya(n) ||6||",
      "translation": "He called all his warriors and also called me. Then all assembled and advanced for attack.6.",
      "punjabiViakhya": "ਤਦੋਂ (ਸਭ) ਇਕੱਠ ਹੋ ਕੇ ਚੰਗੀ ਤਰ੍ਹਾ (ਯੁੱਧ ਲਈ) ਅਗੇ ਵਧੇ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "तबै ढोअ कै कै सु नीकै सिधायं ॥६॥",
      "sourceLineId": "77478",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਬੈ ਕੋਪ ਕੈ ਕੈ ਮਹਾ ਬੀਰ ਢੂਕੈ ॥",
      "transliteration": "sabai kop kai kai mahaa beer ddookai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਮਹਾਨ ਯੋਧੇ ਕ੍ਰੋਧ ਕਰ ਕੇ ਅਗੇ ਢੁਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "सबै कोप कै कै महा बीर ढूकै ॥",
      "sourceLineId": "77479",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਚਲੇ ਬਾਰਿਬੇ ਬਾਰ ਕੋ ਜਿਉ ਭਭੂਕੈ ॥",
      "transliteration": "chale baaribe baar ko jiau bhabhookai ||",
      "translation": "All the great warriors marched forward with great ire like a flame over a fence of dry weeds.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਵਾੜ ਨੂੰ ਸਾੜਨ ਲਈ ਅੱਗ ਦੇ ਅਲੰਬੇ ਚਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "चले बारिबे बार को जिउ भभूकै ॥",
      "sourceLineId": "77480",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤਹਾ ਬਿਝੁੜਿਆਲੰ ਹਠਿਓ ਬੀਰ ਦਿਆਲੰ ॥",
      "transliteration": "tahaa bijhuRiaala(n) haThio beer dhiaala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਬਿੱਝੜ ਵਾਲੀਆ ਵੀਰ ਦਿਆਲ ਚੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "तहा बिझुड़िआलं हठिओ बीर दिआलं ॥",
      "sourceLineId": "77481",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਉਠਿਓ ਸੈਨ ਲੈ ਸੰਗਿ ਸਾਰੀ ਕ੍ਰਿਪਾਲੰ ॥੭॥",
      "transliteration": "auThio sain lai sa(n)g saaree kirapaala(n) ||7||",
      "translation": "Then on the other side, the valiant Raja Dayal of Bijharwal advanced with Raja Kirpal, along with all his army.7.",
      "punjabiViakhya": "ਅਤੇ (ਕਾਗੜੇ ਦਾ) ਕ੍ਰਿਪਾਲ ਚੰਦ ਸਾਰੀ ਫੌਜ ਨੂੰ ਨਾਲ ਲੈ ਕੇ ਚੜ੍ਹ ਆਏ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "उठिओ सैन लै संगि सारी कृपालं ॥७॥",
      "sourceLineId": "77482",
      "sourceShabadId": "7525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮਧੁਭਾਰ ਛੰਦ ॥",
      "transliteration": "madhubhaar chha(n)dh ||",
      "translation": "MADHUBHAAR STANZA",
      "punjabiViakhya": "ਮਧੁਭਾਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "मधुभार छंद ॥",
      "sourceLineId": "77483",
      "sourceShabadId": "7526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕੱੁਪਿਓ ਕ੍ਰਿਪਾਲ ॥",
      "transliteration": "ka'upio kirapaal ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਲ ਚੰਦ ਕ੍ਰੋਧਵਾਨ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "कु्ुपिओ कृपाल ॥",
      "sourceLineId": "77484",
      "sourceShabadId": "7526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਨੱਚੇ ਮਰਾਲ ॥",
      "transliteration": "na'che maraal ||",
      "translation": "Kirpal Chand was in great fury. The horses danced.",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਘੋੜੇ ਨੂੰ ਨਚਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "नच्चे मराल ॥",
      "sourceLineId": "77485",
      "sourceShabadId": "7526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਬੱਜੇ ਬਜੰਤ ॥",
      "transliteration": "ba'je baja(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਦੇ ਵਾਜੇ ਵਜਣ ਲਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "बज्जे बजंत ॥",
      "sourceLineId": "77486",
      "sourceShabadId": "7526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕ੍ਰੂਰੰ ਅਨੰਤ ॥੮॥",
      "transliteration": "kraoora(n) ana(n)t ||8||",
      "translation": "And the pipes were played which presented a dreadful scene.8.",
      "punjabiViakhya": "(ਅਤੇ ਸਾਰਾ ਵਾਤਾਵਰਣ) ਭਿਆਨਕ ਬਣ ਗਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "क्रूरं अनंत ॥८॥",
      "sourceLineId": "77487",
      "sourceShabadId": "7526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜੱਝੰਤ ਜੁਆਣ ॥",
      "transliteration": "ja'jha(n)t juaan ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਲੜਨ ਲਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "जज्झंत जुआण ॥",
      "sourceLineId": "77488",
      "sourceShabadId": "7526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਬਾਹੈ ਕ੍ਰਿਪਾਣ ॥",
      "transliteration": "baahai kirapaan ||",
      "translation": "The warriors foutht and struck their swords.",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਨਾ ਚਲਾਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "बाहै कृपाण ॥",
      "sourceLineId": "77489",
      "sourceShabadId": "7526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਜੀਅ ਧਾਰ ਕ੍ਰੋਧ ॥",
      "transliteration": "jeea dhaar krodh ||",
      "translation": "",
      "punjabiViakhya": "ਮਨ ਵਿਚ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "जीअ धार क्रोध ॥",
      "sourceLineId": "77490",
      "sourceShabadId": "7526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਛੱਡੇ ਸਰੋਘ ॥੯॥",
      "transliteration": "chha'dde sarogh ||9||",
      "translation": "With rage, they showered volley of arrows.9.",
      "punjabiViakhya": "ਤੀਰਾ ਦੀ ਬਰਖਾ ਕਰਨ ਲਗੇ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "छड्डे सरोघ ॥९॥",
      "sourceLineId": "77491",
      "sourceShabadId": "7526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਲੱੁਝੈ ਨਿਦਾਨ ॥",
      "transliteration": "la'ujhai nidhaan ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਲੜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "लु्ुझै निदान ॥",
      "sourceLineId": "77492",
      "sourceShabadId": "7526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਤੱਜੰਤ ਪ੍ਰਾਣ ॥",
      "transliteration": "ta'ja(n)t praan ||",
      "translation": "The fighting soldiers fell in the field and breathed their last.",
      "punjabiViakhya": "ਅੰਤ ਵਿਚ ਉਹ ਪ੍ਰਾਣ ਤਿਆਗਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "तज्जंत प्राण ॥",
      "sourceLineId": "77493",
      "sourceShabadId": "7526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਗਿਰ ਪਰਤ ਭੂਮਿ ॥",
      "transliteration": "gir parat bhoom ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ ਉਤੇ ਡਿਗ ਪੈਂਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "गिर परत भूमि ॥",
      "sourceLineId": "77494",
      "sourceShabadId": "7526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਜਣੁ ਮੇਘ ਝੂਮ ॥੧੦॥",
      "transliteration": "jan megh jhoom ||10||",
      "translation": "They fell. Like thundering clouds on the earth.10.",
      "punjabiViakhya": "ਮਾਨੋ ਬਦਲ ਝੂਮ ਕੇ ਆ ਗਏ ਹੋਣ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "जणु मेघ झूम ॥१०॥",
      "sourceLineId": "77495",
      "sourceShabadId": "7526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "77496",
      "sourceShabadId": "7527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਕ੍ਰਿਪਾਲ ਕੋਪਿਯੰ ॥",
      "transliteration": "kirapaal kopiya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਲ ਚੰਦ ਕ੍ਰੋਧਵਾਨ ਹੋਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "कृपाल कोपियं ॥",
      "sourceLineId": "77497",
      "sourceShabadId": "7527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਹਠੀ ਪਾਵ ਰੋਪਿਯੰ ॥",
      "transliteration": "haThee paav ropiya(n) ||",
      "translation": "Kirpal Chand, in great anger, stood firmly in the field.",
      "punjabiViakhya": "(ਉਸ) ਯੁੱਧਵੀਰ ਨੇ ਪੈਰ ਜਮਾ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "हठी पाव रोपियं ॥",
      "sourceLineId": "77498",
      "sourceShabadId": "7527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਸਰੋਘੰ ਚਲਾਏ ॥",
      "transliteration": "sarogha(n) chalaae ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਅਧਿਕ ਤੀਰ ਚਲਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "सरोघं चलाए ॥",
      "sourceLineId": "77499",
      "sourceShabadId": "7527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਬਡੇ ਬੀਰ ਘਾਏ ॥੧੧॥",
      "transliteration": "badde beer ghaae ||11||",
      "translation": "With his volley of arrows, he killed great warriors.11.",
      "punjabiViakhya": "ਅਤੇ ਵੱਡੇ ਵੱਡੇ ਸੂਰਮੇ ਮਾਰ ਦਿੱਤੇ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "बडे बीर घाए ॥११॥",
      "sourceLineId": "77500",
      "sourceShabadId": "7527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਹਣੇ ਛੱਤ੍ਰਧਾਰੀ ॥",
      "transliteration": "hane chha'tradhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਛਤ੍ਰਧਾਰੀ (ਰਾਜੇ) ਮਾਰ ਦਿੱਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "हणे छत्त्रधारी ॥",
      "sourceLineId": "77501",
      "sourceShabadId": "7527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਲਿਟੇ ਭੂਪ ਭਾਰੀ ॥",
      "transliteration": "liTe bhoop bhaaree ||",
      "translation": "He killed the chief, who lay dead on the ground.",
      "punjabiViakhya": "(ਫਲਸਰੂਪ) ਵੱਡੇ ਵੱਡੇ ਰਾਜੇ ਧਰਤੀ ਉਤੇ ਲੇਟ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "लिटे भूप भारी ॥",
      "sourceLineId": "77502",
      "sourceShabadId": "7527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0063_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਮਹਾਂ ਨਾਦ ਬਾਜੇ ॥",
      "transliteration": "mahaa(n) naadh baaje ||",
      "translation": "",
      "punjabiViakhya": "ਧੌਂਸੇ ਵਜ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 63,
      "hindi": "",
      "hindiTransliteration": "महाँ नाद बाजे ॥",
      "sourceLineId": "77503",
      "sourceShabadId": "7527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    }
  ]
}
