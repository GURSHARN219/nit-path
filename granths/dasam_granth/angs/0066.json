{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 66,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0066_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੂਰ ਲੈ ਕੈ ਸਿਲਾ ਸਾਜ ਸਜਿਯੰ ॥੧॥",
      "transliteration": "soor lai kai silaa saaj sajiya(n) ||1||",
      "translation": "Then Hussian thundered striking his arms and prepared for attack with all his brave warriors.1.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਸੂਰਮਿਆਂ ਨੂੰ ਨਾਲ ਲੈ ਕੇ ਸ਼ਸਤ੍ਰ ਅਤੇ ਕਵਚ ਸਜਾ ਲਏ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "सूर लै कै सिला साज सजियं ॥१॥",
      "sourceLineId": "77600",
      "sourceShabadId": "7536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਰਿਯੋ ਜੋਰ ਸੈਨੰ ਹੁਸੈਨੀ ਪਯਾਨੰ ॥",
      "transliteration": "kariyo jor saina(n) husainee payaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੈਨਾ ਨੂੰ ਇਕੱਠਾ (ਜੋਰ) ਕਰ ਕੇ ਹੁਸੈਨੀ ਨੇ ਪ੍ਰਸਥਾਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "करियो जोर सैनं हुसैनी पयानं ॥",
      "sourceLineId": "77601",
      "sourceShabadId": "7536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪ੍ਰਥਮ ਕੂਟਿ ਕੈ ਲੂਟ ਲੀਨੇ ਅਵਾਨੰ ॥",
      "transliteration": "pratham kooT kai looT leene avaana(n) ||",
      "translation": "Hussain assembled all his forces and advanced. At first he plundered the houses of the hill-people.",
      "punjabiViakhya": "ਪਹਿਲਾ ਪਹਾੜ ਦੇ (ਨਿਵਾਸੀਆਂ ਦੇ) ਘਰਾ ਨੂੰ ਲੁਟ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "प्रथम कूटि कै लूट लीने अवानं ॥",
      "sourceLineId": "77602",
      "sourceShabadId": "7536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪੁਨਰ ਡਢਵਾਲੰ ਕੀਯੋ ਜੀਤਿ ਜੇਰੰ ॥",
      "transliteration": "punar ddaddavaala(n) keeyo jeet jera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਡਢਵਾਲ (ਦੇ ਰਾਜੇ) ਨੂੰ ਜਿਤ ਕੇ ਅਧੀਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "पुनर डढवालं कीयो जीति जेरं ॥",
      "sourceLineId": "77603",
      "sourceShabadId": "7536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਰੇ ਬੰਦਿ ਕੈ ਰਾਜ ਪੁਤ੍ਰਾਨ ਚੇਰੰ ॥੨॥",
      "transliteration": "kare ba(n)dh kai raaj putraan chera(n) ||2||",
      "translation": "Then he conquered the Raja of Dadhwal and brought him under submission. The sons of the Raja were made slaves.2.",
      "punjabiViakhya": "ਅਤੇ ਕਈਆਂ ਰਾਜਪੂਤਾ ਨੂੰ ਬੰਦੀ ਅਤੇ ਗੁਲਾਮ ਬਣਾ ਲਿਆ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "करे बंदि कै राज पुत्रान चेरं ॥२॥",
      "sourceLineId": "77604",
      "sourceShabadId": "7536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪੁਨਰਿ ਦੂਨਿ ਕੋ ਲੂਟ ਲੀਨੋ ਸੁਧਾਰੰ ॥",
      "transliteration": "punar dhoon ko looT leeno sudhaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਘਾਟੀ (ਦੂਨ) ਨੂੰ ਚੰਗੀ ਤਰ੍ਹਾ ਲੁਟ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "पुनरि दूनि को लूट लीनो सुधारं ॥",
      "sourceLineId": "77605",
      "sourceShabadId": "7536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕੋਈ ਸਾਮੁਹੇ ਹ੍ਵੈ ਸਕਿਯੋ ਨ ਗਵਾਰੰ ॥",
      "transliteration": "koiee saamuhe havai sakiyo na gavaara(n) ||",
      "translation": "Then he plundered the Doon thoroughly, none could face the barbarian.",
      "punjabiViakhya": "ਕੋਈ ਵੀ ਮੂਰਖ (ਪਹਾੜੀ ਰਾਜਾ) ਉਸ ਦਾ ਸਾਹਮਣਾ ਨਾ ਕਰ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "कोई सामुहे ह्वै सकियो न गवारं ॥",
      "sourceLineId": "77606",
      "sourceShabadId": "7536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਲੀਯੋ ਛੀਨ ਅੰਨੰ ਦਲੰ ਬਾਂਟਿ ਦੀਯੰ ॥",
      "transliteration": "leeyo chheen a(n)na(n) dhala(n) baa(n)T dheeya(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਲੋਕਾ ਤੋਂ) ਅੰਨ ਖੋਹ ਲਿਆ ਅਤੇ (ਆਪਣੀ) ਸੈਨਾ ਵਿਚ ਵੰਡ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "लीयो छीन अंनं दलं बाँटि दीयं ॥",
      "sourceLineId": "77607",
      "sourceShabadId": "7536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਹਾ ਮੂੜਿਯੰ ਕੁਤਸਤੰ ਕਾਜ ਕੀਯੰ ॥੩॥",
      "transliteration": "mahaa mooRiya(n) kutasata(n) kaaj keeya(n) ||3||",
      "translation": "He took away forcibly the foodgrains and distributed them (amongst the soldiers), the big fool thus committed a very bad act.3.",
      "punjabiViakhya": "(ਉਸ) ਮਹਾ ਮੂਰਖ (ਹੁਸੈਨੀ) ਨੇ (ਇਹ) ਘਿਨੌਣਾ ਕੰਮ ਕੀਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "महा मूड़ियं कुतसतं काज कीयं ॥३॥",
      "sourceLineId": "77608",
      "sourceShabadId": "7536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "77609",
      "sourceShabadId": "7537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਿਤਕ ਦਿਵਸ ਬੀਤਤ ਭਏ ਕਰਤ ਉਸੈ ਉਤਪਾਤ ॥",
      "transliteration": "kitak dhivas beetat bhe karat usai utapaat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ (ਅਜਿਹਾ) ਉਪਦਰ ਕਰਦਿਆਂ ਕਈ ਦਿਨ ਬੀਤ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "कितक दिवस बीतत भए करत उसै उतपात ॥",
      "sourceLineId": "77610",
      "sourceShabadId": "7537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੁਆਲੇਰੀਅਨ ਕੀ ਪਰਤ ਭੀ ਆਨ ਮਿਲਨ ਕੀ ਬਾਤ ॥੪॥",
      "transliteration": "guaalereean kee parat bhee aan milan kee baat ||4||",
      "translation": "Some days passed in such acts, the turn of meeting the Raja of Guler came.4.",
      "punjabiViakhya": "ਅਤੇ ਗੁਲੇਰੀਆਂ ਨੂੰ ਵੀ (ਉਸ ਨਾਲ) ਮਿਲਣ ਦੀ ਲੋੜ ਆ ਪਈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "गुआलेरीअन की परत भी आन मिलन की बात ॥४॥",
      "sourceLineId": "77611",
      "sourceShabadId": "7537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੌ ਦਿਨ ਦੁਇਕ ਨ ਵੇ ਮਿਲਤ ਤਬ ਆਵਤ ਅਰਰਾਇ ॥",
      "transliteration": "jau dhin dhuik na ve milat tab aavat ararai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਦੋ ਕੁ ਦਿਨ (ਉਹ ਹੁਸੈਨੀ ਨੂੰ) ਨਾ ਮਿਲਦੇ ਤਾ ਵੈਰੀ (ਇਧਰ) ਆ ਜਾਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "जौ दिन दुइक न वे मिलत तब आवत अरराइ ॥",
      "sourceLineId": "77612",
      "sourceShabadId": "7537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਾਲਿ ਤਿਨੂ ਕੇ ਘਰ ਬਿਖੈ ਡਾਰੀ ਕਲਹ ਬਨਾਇ ॥੫॥",
      "transliteration": "kaal tinoo ke ghar bikhai ddaaree kaleh banai ||5||",
      "translation": "If he had met (Hussain) for two days more, the enemy would have come here (towards me), but the Providence had thrown a device of discord towards his house.5.",
      "punjabiViakhya": "ਕਾਲ ਨੇ ਉਨ੍ਹਾ ਦੇ ਘਰ ਵਿਚ ਹੀ ਲੜਾਈ ਦੀ ਜੁਗਤ ਬਣਾ ਦਿੱਤੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "कालि तिनू के घर बिखै डारी कलह बनाइ ॥५॥",
      "sourceLineId": "77613",
      "sourceShabadId": "7537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "77614",
      "sourceShabadId": "7538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੁਆਲੇਰੀਆ ਮਿਲਨ ਕਹੁ ਆਏ ॥",
      "transliteration": "guaalereeaa milan kahu aae ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦੋਂ) ਗੁਲੇਰੀਆ (ਹੁਸੈਨੀ ਨੂੰ) ਮਿਲਣ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "गुआलेरीआ मिलन कहु आए ॥",
      "sourceLineId": "77615",
      "sourceShabadId": "7538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਾਮ ਸਿੰਘ ਭੀ ਸੰਗਿ ਸਿਧਾਏ ॥",
      "transliteration": "raam si(n)gh bhee sa(n)g sidhaae ||",
      "translation": "The Raja of Guler came to meet Hussain and with him came Ram Singh.",
      "punjabiViakhya": "ਤਾ ਰਾਮ ਸਿੰਘ ਵੀ ਉਸ ਦੇ ਨਾਲ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "राम सिंघ भी संगि सिधाए ॥",
      "sourceLineId": "77616",
      "sourceShabadId": "7538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚਤਰਥ ਆਨ ਮਿਲਤ ਭਏ ਜਾਮੰ ॥",
      "transliteration": "chatarath aan milat bhe jaama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਥੇ ਪਹਿਰ ਆ ਕੇ ਉਹ ਮਿਲੇ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "चतरथ आन मिलत भए जामं ॥",
      "sourceLineId": "77617",
      "sourceShabadId": "7538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਫੂਟਿ ਗਈ ਲਖਿ ਨਜਰਿ ਗੁਲਾਮੰ ॥੬॥",
      "transliteration": "fooT giee lakh najar gulaama(n) ||6||",
      "translation": "They met Hussain after the four quarters of the days had passed. The slave Hussian become blind in vanity.6.",
      "punjabiViakhya": "ਉਨ੍ਹਾ ਨੂੰ ਵੇਖ ਕੇ ਹੁਸੈਨੀ ('ਗੁਲਾਮ') ਦੀ ਨਜ਼ਰ ਫਟ ਗਈ (ਅਰਥਾਤ ਬਹੁਤ ਹੰਕਾਰ ਹੋ ਗਿਆ) ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "फूटि गई लखि नजरि गुलामं ॥६॥",
      "sourceLineId": "77618",
      "sourceShabadId": "7538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "77619",
      "sourceShabadId": "7539",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜੈਸੇ ਰਵਿ ਕੇ ਤੇਜ ਤੇ ਰੇਤ ਅਧਿਕ ਤਪਤਾਇ ॥",
      "transliteration": "jaise rav ke tej te ret adhik tapatai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਸੂਰਜ ਦੇ ਤੇਜ ਨਾਲ ਰੇਤ ਬਹੁਤ ਤਪ ਜਾਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "जैसे रवि के तेज ते रेत अधिक तपताइ ॥",
      "sourceLineId": "77620",
      "sourceShabadId": "7539",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰਵਿ ਬਲਿ ਛੁਦ੍ਰ ਨ ਜਾਨਈ ਆਪਨ ਹੀ ਗਰਬਾਇ ॥੭॥",
      "transliteration": "rav bal chhudhr na jaaniee aapan hee garabai ||7||",
      "translation": "Just as the sand becomes heated by the heat of the sun, the wretched sand doth not know the might of the sun and become proud of itself.7.",
      "punjabiViakhya": "(ਉਹ) ਨੀਚ (ਰੇਤ) ਸੂਰਜ ਦੇ ਬਲ ਨੂੰ ਨਹੀਂ ਜਾਣਦੀ ਅਤੇ ਆਪਣੇ ਆਪ ਵਿਚ ਗਰਬੀਆ ਰਹਿੰਦੀ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "रवि बलि छुद्र न जानई आपन ही गरबाइ ॥७॥",
      "sourceLineId": "77621",
      "sourceShabadId": "7539",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "77622",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤੈਸੇ ਹੀ ਫੂਲ ਗੁਲਾਮ ਜਾਤ ਭਯੋ ॥",
      "transliteration": "taise hee fool gulaam jaat bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਤਰ੍ਹਾ ਗੁਲਾਮ (ਹੁਸੈਨੀ) ਫੁਲ ਕੇ (ਅੰਨ੍ਹਾ ਹੋ) ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "तैसे ही फूल गुलाम जात भयो ॥",
      "sourceLineId": "77623",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਿਨੈ ਨ ਦ੍ਰਿਸਟ ਤਰੇ ਆਨਤ ਭਯੋ ॥",
      "transliteration": "tinai na dhirasaT tare aanat bhayo ||",
      "translation": "Slimilarly the slave Hussain was puffed up with ego, he did not care to notice them.",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਹਾ ਨੂੰ ਨਜ਼ਰ ਥਲੇ ਹੀ ਨਾ ਲਿਆਂਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "तिनै न दृसट तरे आनत भयो ॥",
      "sourceLineId": "77624",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਹਲੂਰੀਆ ਕਟੋਚ ਸੰਗਿ ਲਹਿ ॥",
      "transliteration": "kahalooreeaa kaToch sa(n)g leh ||",
      "translation": "",
      "punjabiViakhya": "ਕਹਿਲੂਰੀਏ (ਭੀਮ ਚੰਦ) ਅਤੇ ਕਟੌਚ (ਕ੍ਰਿਪਾਲ ਚੰਦ) ਨੂੰ ਇਕੱਠਿਆਂ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "कहलूरीआ कटोच संगि लहि ॥",
      "sourceLineId": "77625",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਾਨਾ ਆਨ ਨ ਮੋ ਸਰ ਮਹਿ ਮਹਿ ॥੮॥",
      "transliteration": "jaanaa aan na mo sar meh meh ||8||",
      "translation": "With the Rajas of Kahlur and Katoch on his side, he considered himself peerless. 8.",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸਮਝਿਆ ਕਿ ਮੇਰੇ ਵਰਗਾ ਧਰਤੀ ਉਤੇ ਹੋਰ ਕੋਈ ਨਹੀਂ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "जाना आन न मो सर महि महि ॥८॥",
      "sourceLineId": "77626",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਿਨ ਜੋ ਧਨ ਆਨੋ ਸੋ ਸਾਥਾ ॥",
      "transliteration": "tin jo dhan aano so saathaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਹਾ (ਗੁਪਾਲ ਅਤੇ ਰਾਮ ਸਿੰਘ) ਨੇ ਆਪਣੇ ਨਾਲ ਜੋ ਧਨ ਲਿਆਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "तिन जो धन आनो सो साथा ॥",
      "sourceLineId": "77627",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤੇ ਦੇ ਰਹੇ ਹੁਸੈਨੀ ਹਾਥਾ ॥",
      "transliteration": "te dhe rahe husainee haathaa ||",
      "translation": "(The Raja of Guler and Ram Singh) offered money to Hussain, which they had brought with them.",
      "punjabiViakhya": "ਉਹ ਹੁਸੈਨੀ ਦੇ ਹੱਥ ਵਿਚ ਦੇ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "ते दे रहे हुसैनी हाथा ॥",
      "sourceLineId": "77628",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦੇਤ ਲੇਤ ਆਪਨ ਕੁਰਰਾਨੇ ॥",
      "transliteration": "dhet let aapan kuraraane ||",
      "translation": "",
      "punjabiViakhya": "ਦਿੰਦਿਆਂ ਲੈਂਦਿਆਂ ਆਪਸ ਵਿਚ ਤਕਰਾਰ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "देत लेत आपन कुरराने ॥",
      "sourceLineId": "77629",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤੇ ਧਨਿ ਲੈ ਨਿਜਿ ਧਾਮ ਸਿਧਾਨੇ ॥੯॥",
      "transliteration": "te dhan lai nij dhaam sidhaane ||9||",
      "translation": "A dispute arose in giving and taking, therefore the Rajas returned to their places with the money.9.",
      "punjabiViakhya": "(ਫਲਸਰੂਪ ਉਹ ਦੋਵੇਾਂ) ਧਨ ਲੈ ਕੇ ਆਪਣੇ ਆਪਣੇ ਘਰਾ ਨੂੰ ਪਰਤ ਗਏ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "ते धनि लै निजि धाम सिधाने ॥९॥",
      "sourceLineId": "77630",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚੇਰੋ ਤਬੈ ਤੇਜ ਤਨ ਤਯੋ ॥",
      "transliteration": "chero tabai tej tan tayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਉਸ) ਗੁਲਾਮ (ਹੁਸੈਨੀ) ਦਾ ਸ਼ਰੀਰ ਗੁੱਸੇ ਨਾਲ ਤਪ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "चेरो तबै तेज तन तयो ॥",
      "sourceLineId": "77631",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭਲਾ ਬੁਰਾ ਕਛੁ ਲਖਤ ਨ ਭਯੋ ॥",
      "transliteration": "bhalaa buraa kachh lakhat na bhayo ||",
      "translation": "Then Hussain was enraged and lost the power of discriminating between good and bad.",
      "punjabiViakhya": "ਅਤੇ (ਆਪਣਾ) ਚੰਗਾ ਮੰਦਾ ਕੁਝ ਵੀ ਨਾ ਵਿਚਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "भला बुरा कछु लखत न भयो ॥",
      "sourceLineId": "77632",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਛੰਦ ਬੰਦ ਨਹ ਨੈਕੁ ਬਿਚਾਰਾ ॥",
      "transliteration": "chha(n)dh ba(n)dh neh naik bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਕੋਈ ਰਾਜਨੈਤਿਕ ਚਾਲ ਨਾ ਸੋਚੀ",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "छंद बंद नह नैकु बिचारा ॥",
      "sourceLineId": "77633",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਾਤ ਭਯੋ ਦੇ ਤਬਹਿ ਨਗਾਰਾ ॥੧੦॥",
      "transliteration": "jaat bhayo dhe tabeh nagaaraa ||10||",
      "translation": "He made no other consideration and ordered the beating drum against the Raja of Guler.10.",
      "punjabiViakhya": "ਅਤੇ ਤੁਰਤ ਧੌਂਸਾ ਵਜਾ ਕੇ (ਗੁਪਾਲ ਉਤੇ) ਜਾ ਪਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "जात भयो दे तबहि नगारा ॥१०॥",
      "sourceLineId": "77634",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦਾਵ ਘਾਵ ਤਿਨ ਨੈਕੁ ਨ ਕਰਾ ॥",
      "transliteration": "dhaav ghaav tin naik na karaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਰਤਾ ਜਿੰਨਾ ਵੀ ਕੋਈ ਦਾਉ-ਪੇਚ ਨਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "दाव घाव तिन नैकु न करा ॥",
      "sourceLineId": "77635",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਿੰਘਹਿ ਘੇਰਿ ਸਸਾ ਕਹੁ ਡਰਾ ॥",
      "transliteration": "si(n)gheh gher sasaa kahu ddaraa ||",
      "translation": "He did not think of any tactical consideration. The hare surrounded the lion for frightening him.",
      "punjabiViakhya": "(ਉਸ ਨੇ ਗੁਪਾਲ ਨੂੰ ਇੰਜ ਜਾ ਡਰਾਇਆ ਜਿਵੇਾਂ) ਸ਼ੇਰ ਨੂੰ ਘੇਰ ਕੇ ਸਹਿਆ ਡਰਾਉਣਾ ਚਾਹੁੰਦਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "सिंघहि घेरि ससा कहु डरा ॥",
      "sourceLineId": "77636",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪੰਦ੍ਰਹ ਪਹਿਰ ਗਿਰਦ ਤਿਨ ਕੀਯੋ ॥",
      "transliteration": "pa(n)dhreh pahir giradh tin keeyo ||",
      "translation": "",
      "punjabiViakhya": "ਪੰਦ੍ਰਹਾ ਪਹਿਰ ਉਸ ਨੇ ਘੇਰਾ ਘਤੀ ਰਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "पंद्रह पहिर गिरद तिन कीयो ॥",
      "sourceLineId": "77637",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਖਾਨ ਪਾਨ ਤਿਨ ਜਾਨ ਨ ਦੀਯੋ ॥੧੧॥",
      "transliteration": "khaan paan tin jaan na dheeyo ||11||",
      "translation": "He besieged him for fifteen pahars (about 45 hours) and did not allow the items of food and drink to reach the state.11.",
      "punjabiViakhya": "ਅਤੇ ਖਾਣ ਪੀਣ (ਦੀ ਕੋਈ ਚੀਜ਼ ਅੰਦਰ) ਜਾਣ ਨਾ ਦਿੱਤੀ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "खान पान तिन जान न दीयो ॥११॥",
      "sourceLineId": "77638",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਖਾਨ ਪਾਨ ਬਿਨ ਸੂਰਿ ਰਿਸਾਏ ॥",
      "transliteration": "khaan paan bin soor risaae ||",
      "translation": "",
      "punjabiViakhya": "ਖਾਣ ਪੀਣ ਤੋਂ ਬਿਨਾ ਸੂਰਮੇ ਕ੍ਰੋਧਵਾਨ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "खान पान बिन सूरि रिसाए ॥",
      "sourceLineId": "77639",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਾਮ ਕਰਨ ਹਿਤ ਦੂਤ ਪਠਾਏ ॥",
      "transliteration": "saam karan hit dhoot paThaae ||",
      "translation": "Being without food and drink, the warriors were filled with ire, the Raja sent the messengers for the Purpose of making peace.",
      "punjabiViakhya": "(ਉਨ੍ਹਾ ਨੇ) ਸੰਧੀ ਕਰਨ ਲਈ ਦੂਤ ਭੇਜੇ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "साम करन हित दूत पठाए ॥",
      "sourceLineId": "77640",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦਾਸ ਨਿਰਖ ਸੰਗਿ ਸੈਨ ਪਠਾਨੀ ॥",
      "transliteration": "dhaas nirakh sa(n)g sain paThaanee ||",
      "translation": "",
      "punjabiViakhya": "ਗੁਲਾਮ (ਹੁਸੈਨੀ) ਆਪਣੇ ਨਾਲ ਆਈ ਪਠਾਣਾ ਦੀ ਸੈਨਾ ਨੂੰ ਵੇਖ ਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "दास निरख संगि सैन पठानी ॥",
      "sourceLineId": "77641",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਫੂਲਿ ਗਯੋ ਤਿਨ ਕੀ ਨਹੀਂ ਮਾਨੀ ॥੧੨॥",
      "transliteration": "fool gayo tin kee nahee(n) maanee ||12||",
      "translation": "Seeing the Pathan forces around him, the slave Hussain lost his balance and did not consider the request of the Raja.12.",
      "punjabiViakhya": "ਹੰਕਾਰਿਆ ਗਿਆ ਅਤੇ ਉਨ੍ਹਾ ਦੀ ਕੋਈ (ਵੀ ਗੱਲ) ਨਾ ਮੰਨੀ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "फूलि गयो तिन की नहीं मानी ॥१२॥",
      "sourceLineId": "77642",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦਸ ਸਹੰਸ੍ਰ ਅਬ ਹੀ ਕੈ ਦੈਹੂ ॥",
      "transliteration": "dhas saha(n)sr ab hee kai dhaihoo ||",
      "translation": "",
      "punjabiViakhya": "(ਹੁਸੈਨੀ ਨੇ ਸਪਸ਼ਟ ਕੀਤਾ ਕਿ) ਹੁਣ ਹੀ ਦਸ ਹਜ਼ਾਰ ਰੁਪਿਆ ਦਿਉ",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "दस सहंस्र अब ही कै दैहू ॥",
      "sourceLineId": "77643",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾ ਤਰ ਮੀਚ ਮੂੰਡ ਪਰ ਲੈਹੂ ॥",
      "transliteration": "naa tar meech moo(n)dd par laihoo ||",
      "translation": "He said, “Either give me ten thousand rupees immediately or take death on your head.”",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਸਿਰ ਉਤੇ ਮੌਤ ਆਈ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "ना तर मीच मूँड पर लैहू ॥",
      "sourceLineId": "77644",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਿੰਘ ਸੰਗਤੀਆ ਤਹਾ ਪਠਾਏ ॥",
      "transliteration": "si(n)gh sa(n)gateeaa tahaa paThaae ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ ਸੁਣ ਕੇ ਰਾਜਾ ਗੁਪਾਲ ਘਰ ਪਰਤ ਆਇਆ ਅਤੇ ਬਾਗ਼ੀ ਹੋ ਬੈਠਾ) (ਭੀਮ ਚੰਦ ਨੇ) ਸੰਗਤੀਆ ਸਿੰਘ ਨੂੰ ਉਸ ਕੋਲ ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "सिंघ संगतीआ तहा पठाए ॥",
      "sourceLineId": "77645",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗੋਪਾਲੈ ਸੁ ਧਰਮੁ ਦੇ ਲਿਆਏ ॥੧੩॥",
      "transliteration": "gopaalai su dharam dhe liaae ||13||",
      "translation": "I had sent Sangatia Singh there for making peace (among the chief), he brought Gopal on oath of God.13.",
      "punjabiViakhya": "(ਜੋ) ਗੁਪਾਲ ਨੂੰ ਧਰਮ-ਸਾਖੀ ਦੇ ਕੇ ਲੈ ਆਇਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "गोपालै सु धरमु दे लिआए ॥१३॥",
      "sourceLineId": "77646",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਿਨ ਕੈ ਸੰਗਿ ਨ ਉਨ ਕੀ ਬਨੀ ॥",
      "transliteration": "tin kai sa(n)g na un kee banee ||",
      "translation": "",
      "punjabiViakhya": "ਗੋਪਾਲ ਦੀ ਭੀਮ ਚੰਦ ਨਾਲ ਨਾ ਬਣੀ",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "तिन कै संगि न उन की बनी ॥",
      "sourceLineId": "77647",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਤਬ ਕ੍ਰਿਪਾਲ ਚਿਤ ਮੋ ਇਹ ਗਨੀ ॥",
      "transliteration": "tab kirapaal chit mo ieh ganee ||",
      "translation": "But he could not reconcile with them  then Kirpal thought within his mind:",
      "punjabiViakhya": "ਤਾ ਕ੍ਰਿਪਾਲ ਨੇ ਮਨ ਵਿਚ ਵਿਚਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "तब कृपाल चित मो इह गनी ॥",
      "sourceLineId": "77648",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਐਸਿ ਘਾਤਿ ਫਿਰ ਹਾਥ ਨ ਐਹੈ ॥",
      "transliteration": "aais ghaat fir haath na aaihai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਅਜਿਹਾ ਮੌਕਾ ਫਿਰ ਹੱਥ ਨਹੀਂ ਆਉਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "ऐसि घाति फिर हाथ न ऐहै ॥",
      "sourceLineId": "77649",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਬਹੂੰ ਫੇਰ ਸਮੋ ਛਲਿ ਜੈਹੈ ॥੧੪॥",
      "transliteration": "sabahoo(n) fer samo chhal jaihai ||14||",
      "translation": "That such an opportunity will not be available again, because the circle of time deceives everybody.14.",
      "punjabiViakhya": "ਸਮੇਾਂ ਦਾ ਗੇੜ ਸਭ ਨੂੰ ਛਲ ਜਾਵੇਗਾ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "सबहूँ फेर समो छलि जैहै ॥१४॥",
      "sourceLineId": "77650",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਗੋਪਾਲੈ ਸੁ ਅਬੈ ਗਹਿ ਲੀਜੈ ॥",
      "transliteration": "gopaalai su abai geh leejai ||",
      "translation": "",
      "punjabiViakhya": "ਗੋਪਾਲ ਨੂੰ ਹੁਣੇ ਹੀ ਫੜ ਲਈਏ,",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "गोपालै सु अबै गहि लीजै ॥",
      "sourceLineId": "77651",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕੈਦ ਕੀਜੀਐ ਕੈ ਬਧ ਕੀਜੈ ॥",
      "transliteration": "kaidh keejeeaai kai badh keejai ||",
      "translation": "He decided to catch hold of Gopal immediately, either to imprision him or kill him.",
      "punjabiViakhya": "ਕੈਦ ਕਰ ਰਖੀਏ ਜਾ ਮਾਰ ਦੇਈਏ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "कैद कीजीऐ कै बध कीजै ॥",
      "sourceLineId": "77652",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤਨਕ ਭਨਕ ਜਬ ਤਿਨ ਸੁਨ ਪਾਈ ॥",
      "transliteration": "tanak bhanak jab tin sun paiee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਗੱਲ ਦੀ) ਕੁਝ ਭਿਣਕ ਜਦ ਗੋਪਾਲ ਨੂੰ ਪਈ,",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "तनक भनक जब तिन सुन पाई ॥",
      "sourceLineId": "77653",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਿਜ ਦਲ ਜਾਤ ਭਯੋ ਭਟਰਾਈ ॥੧੫॥",
      "transliteration": "nij dhal jaat bhayo bhaTaraiee ||15||",
      "translation": "When Gopal got scent of the conspiracy, he escaped to his people (forces).15.",
      "punjabiViakhya": "ਤਾ ਉਹ ਸੂਰਮਾ ਆਪਣੀ ਸੈਨਾ ਵਿਚ ਚਲਾ ਗਿਆ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "निज दल जात भयो भटराई ॥१५॥",
      "sourceLineId": "77654",
      "sourceShabadId": "7540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਮਧੁਭਾਰ ਛੰਦ ॥",
      "transliteration": "madhubhaar chha(n)dh ||",
      "translation": "MADHUBHAAR STANZA",
      "punjabiViakhya": "ਮਧੁਭਾਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "मधुभार छंद ॥",
      "sourceLineId": "77655",
      "sourceShabadId": "7541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜਬ ਗਯੋ ਗੁਪਾਲ ॥",
      "transliteration": "jab gayo gupaal ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਗੋਪਾਲ ਚੰਦ ਚਲਾ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "जब गयो गुपाल ॥",
      "sourceLineId": "77656",
      "sourceShabadId": "7541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਕੱੁਪਿਯੋ ਕ੍ਰਿਪਾਲ ॥",
      "transliteration": "ka'upiyo kirapaal ||",
      "translation": "When Gopal was gone, Kirpal was filled with anger.",
      "punjabiViakhya": "ਤਦ ਕ੍ਰਿਪਾਲ ਕ੍ਰੋਧਿਤ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "कु्ुपियो कृपाल ॥",
      "sourceLineId": "77657",
      "sourceShabadId": "7541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਹਿੰਮਤ ਹੁਸੈਨ ॥",
      "transliteration": "hi(n)mat husain ||",
      "translation": "",
      "punjabiViakhya": "ਹਿੰਮਤ ਕਰਕੇ ਹੁਸੈਨੀ (ਵਲੋਂ)",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "हिंमत हुसैन ॥",
      "sourceLineId": "77658",
      "sourceShabadId": "7541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਜੁੰਮੈ ਲੁਝੈਨ ॥੧੬॥",
      "transliteration": "ju(n)mai lujhain ||16||",
      "translation": "Himmat and Hussain rushed for fighting in the field.16.",
      "punjabiViakhya": "ਲੜਨ ਲਈ ਤੁਰ ਪਿਆ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "जुँमै लुझैन ॥१६॥",
      "sourceLineId": "77659",
      "sourceShabadId": "7541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਕਰਿ ਕੇ ਗੁਮਾਨ ॥",
      "transliteration": "kar ke gumaan ||",
      "translation": "",
      "punjabiViakhya": "ਹੰਕਾਰ ਕਰਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "करि के गुमान ॥",
      "sourceLineId": "77660",
      "sourceShabadId": "7541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਜੁੰਮੈ ਜੁਆਨ ॥",
      "transliteration": "ju(n)mai juaan ||",
      "translation": "With great pride, more warriors followed.",
      "punjabiViakhya": "ਸੂਰਮੇ ਚਲ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "जुँमै जुआन ॥",
      "sourceLineId": "77661",
      "sourceShabadId": "7541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਬੱਜੇ ਤੱਬਲ ॥",
      "transliteration": "ba'je ta'bal ||",
      "translation": "",
      "punjabiViakhya": "ਧੌਂਸੇ ਅਤੇ ਨਗਾਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "बज्जे तब्बल ॥",
      "sourceLineId": "77662",
      "sourceShabadId": "7541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਦੁੰਦਭਿ ਦੱਬਲ ॥੧੭॥",
      "transliteration": "dhu(n)dhabh dha'bal ||17||",
      "translation": "The drums and trumpets resounded.17.",
      "punjabiViakhya": "ਖ਼ੂਬ ਵਜਣ ਲਗੇ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "दुँदभि दब्बल ॥१७॥",
      "sourceLineId": "77663",
      "sourceShabadId": "7541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਬੱਜੇ ਨਿਸਾਣ ॥",
      "transliteration": "ba'je nisaan ||",
      "translation": "",
      "punjabiViakhya": "ਨਗਾਰੇ ਵਜਣ ਲਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "बज्जे निसाण ॥",
      "sourceLineId": "77664",
      "sourceShabadId": "7541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਨੱਚੇ ਕਿਕਾਣ ॥",
      "transliteration": "na'che kikaan ||",
      "translation": "On the other side, the trumpets also resounded and the horses danced in the battlefield.",
      "punjabiViakhya": "ਘੋੜੇ ਨਚਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "नच्चे किकाण ॥",
      "sourceLineId": "77665",
      "sourceShabadId": "7541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਬਾਹੈ ਤੜਾਕ ॥",
      "transliteration": "baahai taRaak ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਸ਼ਤ ਬੰਨ੍ਹ ਕੇ (ਤੀਰ) ਚਲਾਏ ਜਾਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "बाहै तड़ाक ॥",
      "sourceLineId": "77666",
      "sourceShabadId": "7541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਉੱਠੈ ਕੜਾਕ ॥੧੮॥",
      "transliteration": "au'Thai kaRaak ||18||",
      "translation": "The warriors enthusiastically strike their weapons, creating clattering sound.18.",
      "punjabiViakhya": "ਅਤੇ ਕੜ-ਕੜ (ਦੀ ਧੁਨ) ਉਠਦੀ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "उट्ठै कड़ाक ॥१८॥",
      "sourceLineId": "77667",
      "sourceShabadId": "7541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਬੱਜੇ ਨਿਸੰਗ ॥",
      "transliteration": "ba'je nisa(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਨਿਸੰਗ ਹੋ ਕੇ (ਯੋਧੇ ਧੌਂਸੇ) ਵਜਾਉਾਂਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "बज्जे निसंग ॥",
      "sourceLineId": "77668",
      "sourceShabadId": "7541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਗੱਜੇ ਨਿਹੰਗ ॥",
      "transliteration": "ga'je niha(n)g ||",
      "translation": "The fearless warriors blow their horns and shout loudly.",
      "punjabiViakhya": "ਅਤੇ ਮਹਾਨ ਯੋਧੇ (ਨਿਹੰਗ) ਗਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "गज्जे निहंग ॥",
      "sourceLineId": "77669",
      "sourceShabadId": "7541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਛੁੱਟੈ ਕ੍ਰਿਪਾਨ ॥",
      "transliteration": "chhu'Tai kirapaan ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਨਾ ਚਲਦੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "छुट्टै कृपान ॥",
      "sourceLineId": "77670",
      "sourceShabadId": "7541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0066_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਲਿੱਟੈ ਜੁਆਨ ॥੧੯॥",
      "transliteration": "li'Tai juaan ||19||",
      "translation": "The swords are struck and the warriors are lying on the ground.19.",
      "punjabiViakhya": "ਅਤੇ ਯੋਧੇ ਧਰਤੀ ਉਤੇ ਲੇਟਦੇ ਹਨ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 66,
      "hindi": "",
      "hindiTransliteration": "लिट्टै जुआन ॥१९॥",
      "sourceLineId": "77671",
      "sourceShabadId": "7541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    }
  ]
}
