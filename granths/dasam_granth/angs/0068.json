{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 68,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0068_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਹਾਂ ਕੋਪ ਕੈ ਬੀਰ ਬ੍ਰਿੰਦੰ ਸੰਘਾਰੇ ॥",
      "transliteration": "mahaa(n) kop kai beer bira(n)dha(n) sa(n)ghaare ||",
      "translation": "In a great rage, he killed many soldiers.",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਕ੍ਰੋਧ ਕਰ ਕੇ ਬਹੁਤ ਸੂਰਮੇ ਮਾਰ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "महाँ कोप कै बीर बृंदं संघारे ॥",
      "sourceLineId": "77720",
      "sourceShabadId": "7543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਡੋ ਜੁਧ ਕੈ ਦੇਵ ਲੋਕੰ ਪਧਾਰੇ ॥੩੧॥",
      "transliteration": "baddo judh kai dhev loka(n) padhaare ||31||",
      "translation": "After a great fight he departed for the heavenly abode ||31||",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਤਕੜਾ ਯੁੱਧ ਕਰਕੇ ਸੁਅਰਗ ਚਲਾ ਗਿਆ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "बडो जुध कै देव लोकं पधारे ॥३१॥",
      "sourceLineId": "77721",
      "sourceShabadId": "7543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਠਿਯੋ ਹਿੰਮਤੰ ਕਿੰਮਤੰ ਲੈ ਕ੍ਰਿਪਾਨੰ ॥",
      "transliteration": "haThiyo hi(n)mata(n) ki(n)mata(n) lai kirapaana(n) ||",
      "translation": "The tenacious Himmat Singh and Kimmat Singh drew out their kirpans.",
      "punjabiViakhya": "(ਰਾਜਿਆਂ ਵਲੋਂ) ਹਿੰਮਤ ਸਿੰਘ ਅਤੇ ਕਿੰਮਤ ਸਿੰਘ ਨਾ ਦੇ ਕੜੀਅਲ ਯੋਧੇ ਕ੍ਰਿਪਾਨਾ ਲੈ ਕੇ ਆਏ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "हठियो हिंमतं किंमतं लै कृपानं ॥",
      "sourceLineId": "77722",
      "sourceShabadId": "7543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਲਏ ਗੁਰਜ ਚੱਲੰ ਸੁ ਜਲਾਲਖਾਨੰ ॥",
      "transliteration": "le guraj cha'la(n) su jalaalakhaana(n) ||",
      "translation": "Jalal Khan joined with a mace.",
      "punjabiViakhya": "(ਹੁਸੈਨੀ ਦੇ ਦਲ ਵਲੋਂ) ਜਲਾਲ ਖ਼ਾਨ ਗੁਰਜ ਲੈ ਕੇ ਚਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "लए गुरज चल्लं सु जलालखानं ॥",
      "sourceLineId": "77723",
      "sourceShabadId": "7543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹਠੇ ਸੂਰਮਾ ਮੱਤ ਜੋਧਾ ਜੁਝਾਰੰ ॥",
      "transliteration": "haThe sooramaa ma't jodhaa jujhaara(n) ||",
      "translation": "The determined warriors fought, seemingly intoxicated.",
      "punjabiViakhya": "ਉਹ ਜੁਝਾਰੂ ਯੋਧੇ ਅਭਿਮਾਨ ਨਾਲ ਮਸਤੇ ਹੋਏ ਖ਼ੂਬ ਲੜੇ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "हठे सूरमा मत्त जोधा जुझारं ॥",
      "sourceLineId": "77724",
      "sourceShabadId": "7543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪਰੀ ਕੁੱਟ ਕੱੁਟੰ ਉਠੀ ਸਸਤ੍ਰ ਝਾਰੰ ॥੩੨॥",
      "transliteration": "paree ku'T ka'uTa(n) uThee sasatr jhaara(n) ||32||",
      "translation": "There were blows after blows and the sparks fell, when the weapons struck each other ||32||",
      "punjabiViakhya": "(ਸ਼ਸਤ੍ਰਾ ਦੇ) ਲਗਾਤਾਰ ਵਾਰਾ ਨਾਲ ਸ਼ਸਤ੍ਰਾ ਤੋਂ ਚਿੰਗਾਰੀਆਂ ਨਿਕਲਣ ਲਗੀਆਂ ॥੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "परी कुट्ट कु्ुटं उठी ससत्र झारं ॥३२॥",
      "sourceLineId": "77725",
      "sourceShabadId": "7543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "77726",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਸੰਵਾਲ ਧਾਏ ॥",
      "transliteration": "jasa(n)vaal dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਜਸਵਾਲ (ਦਾ ਰਾਜਾ ਕੇਸਰੀ ਚੰਦ)",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "जसंवाल धाए ॥",
      "sourceLineId": "77727",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤੁਰੰਗੰ ਨਚਾਏ ॥",
      "transliteration": "tura(n)ga(n) nachaae ||",
      "translation": "The Raja of Jaswal rushed forward on the galloping horse.",
      "punjabiViakhya": "ਘੋੜਾ ਨਚਾਉਾਂਦਾ ਹੋਇਆ ਅਗੇ ਵਧਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "तुरंगं नचाए ॥",
      "sourceLineId": "77728",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਲਯੋ ਘੇਰ ਹੁਸੈਨੀ ॥",
      "transliteration": "layo gher husainee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਹੁਸੈਨੀ ਨੂੰ ਘੇਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "लयो घेर हुसैनी ॥",
      "sourceLineId": "77729",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹਨਿਯੋ ਸਾਂਗ ਪੈਨੀ ॥੩੩॥",
      "transliteration": "haniyo saa(n)g painee ||33||",
      "translation": "He surrounded Hussain and struck his sharp lance at him.33.",
      "punjabiViakhya": "ਅਤੇ ਤਿਖੀ ਬਰਛੀ ਦਾ ਵਾਰ ਕੀਤਾ ॥੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "हनियो साँग पैनी ॥३३॥",
      "sourceLineId": "77730",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਿਨੂ ਬਾਣ ਬਾਹੇ ॥",
      "transliteration": "tinoo baan baahe ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਸੈਨੀ ਨੇ (ਅਗੋਂ) ਤੀਰ ਚਲਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "तिनू बाण बाहे ॥",
      "sourceLineId": "77731",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਡੇ ਸੈਨ ਗਾਹੇ ॥",
      "transliteration": "badde sain gaahe ||",
      "translation": "He (Hussaini) discharged arrow and destroyed much of the army.",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਸੈਨਾ ਲਿਤਾੜ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "बडे सैन गाहे ॥",
      "sourceLineId": "77732",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਿਸੈ ਅੰਗਿ ਲਾਗਿਯੋ ॥",
      "transliteration": "jisai a(n)g laagiyo ||",
      "translation": "",
      "punjabiViakhya": "(ਤੀਰ) ਜਿਸ ਦੇ ਸ਼ਰੀਰ ਵਿਚ ਲਗਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "जिसै अंगि लागियो ॥",
      "sourceLineId": "77733",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਿਸੈ ਪ੍ਰਾਣ ਤਯਾਗਯੋ ॥੩੪॥",
      "transliteration": "tisai praan tayaagayo ||34||",
      "translation": "He, who is struck by the arrow on his chest, he breathes his last.34.",
      "punjabiViakhya": "ਉਸੇ ਦੇ ਪ੍ਰਾਣ ਨਿਕਲ ਜਾਦੇ ਹਨ ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "तिसै प्राण तयागयो ॥३४॥",
      "sourceLineId": "77734",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਬੈ ਘਾਵ ਲਾਗਯੋ ॥",
      "transliteration": "jabai ghaav laagayo ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਕਿਸੇ ਨੂੰ) ਜਦੋਂ ਜ਼ਖਮ ਲਗਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "जबै घाव लागयो ॥",
      "sourceLineId": "77735",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਬੈ ਕੋਪ ਜਾਗਯੋ ॥",
      "transliteration": "tabai kop jaagayo ||",
      "translation": "Whenever one is wounded, he gets highly infuriated.",
      "punjabiViakhya": "ਤਾ (ਉਸ ਦਾ) ਕ੍ਰੋਧ ਭੜਕ ਪੈਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "तबै कोप जागयो ॥",
      "sourceLineId": "77736",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੰਭਾਰੀ ਕਮਾਣੰ ॥",
      "transliteration": "sa(n)bhaaree kamaana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਫਿਰ) ਕਮਾਨ ਸੰਭਾਲ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "संभारी कमाणं ॥",
      "sourceLineId": "77737",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹਣੇ ਬੀਰ ਬਾਣੰ ॥੩੫॥",
      "transliteration": "hane beer baana(n) ||35||",
      "translation": "Then, holding his bow, he kills the warriors with arrows. 35.",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਨੂੰ ਬਾਣਾ ਨਾਲ ਮਾਰੀ ਜਾਦਾ ਹੈ ॥੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "हणे बीर बाणं ॥३५॥",
      "sourceLineId": "77738",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚਹੂੰ ਓਰ ਢੂਕੇ ॥",
      "transliteration": "chahoo(n) or ddooke ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ ਅਗੇ ਢੁਕਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "चहूँ ओर ढूके ॥",
      "sourceLineId": "77739",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮੁਖੰ ਮਾਰ ਕੂਕੇ ॥",
      "transliteration": "mukha(n) maar kooke ||",
      "translation": "The warriors advance from all the four sides and shout “kill, kill”.",
      "punjabiViakhya": "ਅਤੇ ਮੂੰਹ ਤੋਂ ਮਾਰੋ-ਮਾਰੋ ਪੁਕਾਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "मुखं मार कूके ॥",
      "sourceLineId": "77740",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨ੍ਰਿਭੈ ਸਸਤ੍ਰ ਬਾਹੈਂ ॥",
      "transliteration": "nirabhai sasatr baahai(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਨਿਰਭੈ ਹੋ ਕੇ ਸ਼ਸਤ੍ਰ ਚਲਾਉਾਂਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "नृभै ससत्र बाहैं ॥",
      "sourceLineId": "77741",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦੋਊ ਜੀਤ ਚਾਹੈਂ ॥੩੬॥",
      "transliteration": "dhouoo jeet chaahai(n) ||36||",
      "translation": "They strike their weapons fearlessly, both the sides wish for their victory.36.",
      "punjabiViakhya": "ਅਤੇ ਦੋਵੇਾਂ (ਆਪਣੀ ਆਪਣੀ) ਜਿਤ ਪ੍ਰਾਪਤ ਕਰਨ ਦੇ ਚਾਹਵਾਨ ਹੁੰਦੇ ਹਨ ॥੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "दोऊ जीत चाहैं ॥३६॥",
      "sourceLineId": "77742",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਿਸੇ ਖਾਨਜਾਦੇ ॥",
      "transliteration": "rise khaanajaadhe ||",
      "translation": "",
      "punjabiViakhya": "ਪਠਾਣ ਸੈਨਿਕ ਕ੍ਰੋਧਿਤ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "रिसे खानजादे ॥",
      "sourceLineId": "77743",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਹਾ ਮੱਦ ਮਾਦੇ ॥",
      "transliteration": "mahaa ma'dh maadhe ||",
      "translation": "The sons of Khans, in great ire and puffed up with great ego,",
      "punjabiViakhya": "ਹੈਂਕੜ ਨਾਲ ਹੰਕਾਰੇ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "महा मद्द मादे ॥",
      "sourceLineId": "77744",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਹਾ ਬਾਣ ਬਰਖੇ ॥",
      "transliteration": "mahaa baan barakhe ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰਾ ਦੀ ਬਰਖਾ ਹੋਣ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "महा बाण बरखे ॥",
      "sourceLineId": "77745",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਭੈ ਸੂਰ ਹਰਖੇ ॥੩੭॥",
      "transliteration": "sabhai soor harakhe ||37||",
      "translation": "Shower the rain of arrows  all the warriors are filled with anger.37.",
      "punjabiViakhya": "ਸਾਰੇ ਸੂਰਮੇ ਪ੍ਰਸੰਨ ਹੋ ਗਏ ॥੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "सभै सूर हरखे ॥३७॥",
      "sourceLineId": "77746",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਰੈ ਬਾਣ ਅਰਚਾ ॥",
      "transliteration": "karai baan arachaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਦ੍ਰਿਸ਼ ਅਜਿਹਾ ਸੀ) ਮਾਨੋ ਬਾਣ (ਸੁਗੰਧਿਤ ਪਦਾਰਥਾ ਦੀ) ਅਰਚਾ (ਛਿੜਕਾਉ) ਕਰ ਰਹੇ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "करै बाण अरचा ॥",
      "sourceLineId": "77747",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਧਨੁਰ ਬੇਦ ਚਰਚਾ ॥",
      "transliteration": "dhanur bedh charachaa ||",
      "translation": "There is spattering of arrows (in worship) and the bows seem engaged in Vedic discussion.",
      "punjabiViakhya": "(ਧਨੁਸ਼ਾ ਦੀ ਟੰਕਾਰ ਨਾਲ) ਧਨੁਰ ਵੇਦ ਦਾ ਪਾਠ ਹੋ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "धनुर बेद चरचा ॥",
      "sourceLineId": "77748",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੁ ਸਾਗੰ ਸਮ੍ਹਾਲੰ ॥",
      "transliteration": "s saaga(n) samhaala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਥਾ ਤੇ (ਵੇਦ-ਪਾਠ ਦਾ)",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "सु सागं सम्हालं ॥",
      "sourceLineId": "77749",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਰੈ ਤਉਨ ਠਾਮੰ ॥੩੮॥",
      "transliteration": "karai taun Thaama(n) ||38||",
      "translation": "Wherever the warrior wants to strike the blow, he strikes it.38.",
      "punjabiViakhya": "ਕੋਈ ਰੂਪਕ ਖੇਡਿਆ ਜਾ ਰਿਹਾ ਸੀ ॥੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "करै तउन ठामं ॥३८॥",
      "sourceLineId": "77750",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਲੀ ਬੀਰ ਰੁੱਝੇ ॥",
      "transliteration": "balee beer ru'jhe ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਕੰਮ ਵਿਚ) ਬਲਵਾਨ ਵੀਰ ਰੁਝੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "बली बीर रुज्झे ॥",
      "sourceLineId": "77751",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਮੂਹ ਸਸਤ੍ਰ ਜੁੱਝੇ ॥",
      "transliteration": "samooh sasatr ju'jhe ||",
      "translation": "The brave fighters are busy in this task  they are engaged in war with all their wepons.",
      "punjabiViakhya": "ਸਾਰੇ ਸ਼ਸਤ੍ਰਾ ਨਾਲ ਜੂਝ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "समूह ससत्र जुज्झे ॥",
      "sourceLineId": "77752",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਲਗੈ ਧੀਰ ਧੱਕੇ ॥",
      "transliteration": "lagai dheer dha'ke ||",
      "translation": "",
      "punjabiViakhya": "ਧੀਰਜਵਾਨ (ਸੂਰਮਿਆਂ) ਦੇ ਧਕੇ ਵਜ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "लगै धीर धक्के ॥",
      "sourceLineId": "77753",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕ੍ਰਿਪਾਣੰ ਝਨੱਕੇ ॥੩੯॥",
      "transliteration": "kirapaana(n) jhana'ke ||39||",
      "translation": "The warriors, with the quality of forbearance, are knocking forcefully and their swords are clattering.39.",
      "punjabiViakhya": "ਅਤੇ ਕ੍ਰਿਪਾਨਾ ਛਣਕ ਰਹੀਆਂ ਸਨ ॥੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "कृपाणं झनक्के ॥३९॥",
      "sourceLineId": "77754",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕੱੜਕੈ ਕਮਾਣੰ ॥",
      "transliteration": "ka'Rakai kamaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਮਾਨਾ ਕੜਕਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "कड़्ड़कै कमाणं ॥",
      "sourceLineId": "77755",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਝਣੱਕੈ ਕ੍ਰਿਪਾਣੰ ॥",
      "transliteration": "jhana'kai kirapaana(n) ||",
      "translation": "The bows crackle and the swords clatter.",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਨਾ ਛਣਕਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "झणक्कै कृपाणं ॥",
      "sourceLineId": "77756",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕੜੰਕਾਰ ਛੱੁਟੈ ॥",
      "transliteration": "kaRa(n)kaar chha'uTai ||",
      "translation": "",
      "punjabiViakhya": "ਕੜਾਕ ਕੜਾਕ (ਤੀਰ) ਚਲਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "कड़ंकार छु्ुटै ॥",
      "sourceLineId": "77757",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਝਣੰਕਾਰ ਉੱਠੈ ॥੪੦॥",
      "transliteration": "jhana(n)kaar u'Thai ||40||",
      "translation": "The arrows, when discharged, produce knocking sound, and the weapons when struck, produce jingling sound.40.",
      "punjabiViakhya": "(ਹਰ ਪਾਸੇ) ਝਣਕਾਰ (ਦਾ ਨਾਦ) ਪੈਦਾ ਹੋ ਰਿਹਾ ਸੀ ॥੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "झणंकार उट्ठै ॥४०॥",
      "sourceLineId": "77758",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹਠੀ ਸਸਤ੍ਰ ਝਾਰੈ ॥",
      "transliteration": "haThee sasatr jhaarai ||",
      "translation": "",
      "punjabiViakhya": "ਹਠੀ (ਸੂਰਮੇ) ਸ਼ਸਤ੍ਰਾ ਦਾ ਵਾਰ ਕਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "हठी ससत्र झारै ॥",
      "sourceLineId": "77759",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨ ਸੰਕਾ ਬਿਚਾਰੈ ॥",
      "transliteration": "n sa(n)kaa bichaarai ||",
      "translation": "The warriors are striking their weapons, they do not think of the impending death.",
      "punjabiViakhya": "(ਮਨ ਵਿਚ) ਕੋਈ ਸ਼ੰਕਾ ਨਹੀਂ ਵਿਚਾਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "न संका बिचारै ॥",
      "sourceLineId": "77760",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਰੈ ਤੀਰ ਮਾਰੰ ॥",
      "transliteration": "karai teer maara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ (ਇਤਨੇ ਅਧਿਕ) ਚਲਾਏ ਜਾ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "करै तीर मारं ॥",
      "sourceLineId": "77761",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਫਿਰੈ ਲੋਹ ਧਾਰੰ ॥੪੧॥",
      "transliteration": "firai loh dhaara(n) ||41||",
      "translation": "The arrows are being discharged and the swords are being struck. 41.",
      "punjabiViakhya": "ਮਾਨੋ ਲੋਹੇ ਦੀ ਬਰਖਾ ਹੋ ਰਹੀ ਹੋਵੇ ॥੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "फिरै लोह धारं ॥४१॥",
      "sourceLineId": "77762",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਦੀ ਸ੍ਰੌਣ ਪੂਰੰ ॥",
      "transliteration": "nadhee srauan poora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨਦੀ ਲਹੂ ਨਾਲ ਪੂਰੀ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "नदी स्रौण पूरं ॥",
      "sourceLineId": "77763",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਫਿਰੈ ਗੈਣ ਹੂਰੰ ॥",
      "transliteration": "firai gain hoora(n) ||",
      "translation": "The stream of bloods is full, the houris (the heavenly damsels) are moving in the sky.",
      "punjabiViakhya": "ਆਕਾਸ਼ ਵਿਚ ਹੂਰਾ ਵਿਚਰ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "फिरै गैण हूरं ॥",
      "sourceLineId": "77764",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਉਭੇ ਖੇਤ ਪਾਲੰ ॥",
      "transliteration": "aubhe khet paala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਪਾਸਿਆਂ ਤੋਂ ਮੁੱਖੀ ਸੂਰਮੇ",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "उभे खेत पालं ॥",
      "sourceLineId": "77765",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਕੇ ਬਿੱਕਰਾਲੰ ॥੪੨॥",
      "transliteration": "bake bi'karaala(n) ||42||",
      "translation": "On both sides, the warriors utter dreadful shouts.42.",
      "punjabiViakhya": "ਭਿਆਨਕ ਆਵਾਜ਼ਾ ਕਢ ਰਹੇ ਹਨ ॥੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "बके बिक्करालं ॥४२॥",
      "sourceLineId": "77766",
      "sourceShabadId": "7544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪਾਧੜੀ ਛੰਦ ॥",
      "transliteration": "paadhaRee chha(n)dh ||",
      "translation": "PAADHARI STANZA",
      "punjabiViakhya": "ਪਾਧੜੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "पाधड़ी छंद ॥",
      "sourceLineId": "77767",
      "sourceShabadId": "7545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਤਹ ਹੜ ਹੜਾਇ ਹੱਸੇ ਮਸਾਣ ॥",
      "transliteration": "teh haR haRai ha'se masaan ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਮਸਾਣ ਖਿੜ ਖਿੜ ਕੇ ਹਸ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "तह हड़ हड़ाइ हस्से मसाण ॥",
      "sourceLineId": "77768",
      "sourceShabadId": "7545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਲਿੱਟੇ ਗਜਿੰਦ੍ਰ ਛੱੁਟੇ ਕਿਕਾਣ ॥",
      "transliteration": "li'Te gaji(n)dhr chha'uTe kikaan ||",
      "translation": "The ghosts are laughing loudly in the battlefield, the elephants are soiling in dust and the horses are roaming without riders.",
      "punjabiViakhya": "(ਕਿਤੇ) ਹਾਥੀ ਡਿਗੇ ਪਏ ਸਨ ਅਤੇ ਘੋੜੇ ਖੁਲ੍ਹੇ ਫਿਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "लिट्टे गजिंद्र छु्ुटे किकाण ॥",
      "sourceLineId": "77769",
      "sourceShabadId": "7545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜੁੱਟੇ ਸੁ ਬੀਰ ਤਹ ਕੜਕ ਜੰਗ ॥",
      "transliteration": "ju'Te su beer teh kaRak ja(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਘੋਰ ਯੁੱਧ ਵਿਚ ਸੂਰਮੇ ਜੁਟੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "जुट्टे सु बीर तह कड़क जंग ॥",
      "sourceLineId": "77770",
      "sourceShabadId": "7545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਛੁੱਟੀ ਕ੍ਰਿਪਾਣ ਵੁਠੇ ਖਤੰਗ ॥੪੩॥",
      "transliteration": "chhu'Tee kirapaan vuThe khata(n)g ||43||",
      "translation": "The warriors are fighting with one another and their weapons are creating knocking sounds. The swords are being struck and the arrows are being showered.43.",
      "punjabiViakhya": "(ਕਿਤੇ) ਤਲਵਾਰਾ ਚਲ ਰਹੀਆਂ ਸਨ ਅਤੇ ਬਾਣ ਵਰ੍ਹ ਰਹੇ ਸਨ ॥੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "छुट्टी कृपाण वुठे खतंग ॥४३॥",
      "sourceLineId": "77771",
      "sourceShabadId": "7545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਡਾਕਨਿ ਡਹਿਕ ਚਾਵਡਿ ਚਿਕਾਰ ॥",
      "transliteration": "ddaakan ddahik chaavadd chikaar ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਤੇ) ਡਾਕਣੀਆਂ ਡਕਾਰ ਰਹੀਆਂ ਸਨ ਅਤੇ ਚਾਵੰਡੀਆਂ ਚੀਖ਼ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "डाकनि डहिक चावडि चिकार ॥",
      "sourceLineId": "77772",
      "sourceShabadId": "7545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਾਕੰ ਕਹੱਕਿ ਬੱਜੇ ਦੁਧਾਰ ॥",
      "transliteration": "kaaka(n) kaha'k ba'je dhudhaar ||",
      "translation": "The vampires are shouting and the hagh are shrieking. The crows are cawing loudly and the double-edged swords are clattering.",
      "punjabiViakhya": "ਕਿਤੇ ਕਾਵਾ ਦੀ ਕੁਰਲਾਹਟ ਪੈ ਰਹੀ ਸੀ ਅਤੇ ਕਿਤੇ ਦੁਧਾਰੇ (ਖੰਡੇ) ਵਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "काकं कहक्कि बज्जे दुधार ॥",
      "sourceLineId": "77773",
      "sourceShabadId": "7545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਖੋਲੰ ਖੜੱਕਿ ਤੁਪਕਿ ਤੜਾਕਿ ॥",
      "transliteration": "khola(n) khaRa'k tupak taRaak ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਤੇ) ਲੋਹੇ ਦੇ ਟੋਪ ਖੜਕ ਰਹੇ ਸਨ ਅਤੇ (ਕਿਤੇ) ਬੰਦੂਕਾ ਤੜਾਕ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "खोलं खड़क्कि तुपकि तड़ाकि ॥",
      "sourceLineId": "77774",
      "sourceShabadId": "7545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸੈਥੰ ਸੜੱਕ ਧੱਕੰ ਧਹਾਕਿ ॥੪੪॥",
      "transliteration": "saitha(n) saRa'k dha'ka(n) dhahaak ||44||",
      "translation": "The helmets are being knocked at and the guns are booming. The daggers are clattering and there is violent pushing. 44.",
      "punjabiViakhya": "(ਕਿਤੇ) ਸੈਹੱਥੀਆਂ ਸਰਕ ਰਹੀਆਂ ਸਨ ਅਤੇ (ਕਿਤੇ) ਧੱਕਮ-ਧੱਕੀ ਹੋ ਰਹੀ ਸੀ ॥੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "सैथं सड़क्क धक्कं धहाकि ॥४४॥",
      "sourceLineId": "77775",
      "sourceShabadId": "7545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਭੁਜੰਗ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g chha(n)dh ||",
      "translation": "BHUJANG STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "भुजंग छंद ॥",
      "sourceLineId": "77776",
      "sourceShabadId": "7546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਤਹਾ ਆਪ ਕੀਨੋ ਹੁਸੈਨੀ ਉਤਾਰੰ ॥",
      "transliteration": "tahaa aap keeno husainee utaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਹੁਸੈਨੀ ਖੁਦ (ਜੰਗ ਕਰਨ ਲਈ) ਨਿਤਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "तहा आप कीनो हुसैनी उतारं ॥",
      "sourceLineId": "77777",
      "sourceShabadId": "7546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਸਭੂ ਹਾਥ ਬਾਣੰ ਕਮਾਣੰ ਸੰਭਾਰੰ ॥",
      "transliteration": "sabhoo haath baana(n) kamaana(n) sa(n)bhaara(n) ||",
      "translation": "Then Hussain himself entered the fray, all the warriors took up bows and arrows.",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਸਾਰੇ (ਸਾਥੀਆਂ ਨੇ) ਹੱਥਾ ਵਿਚ ਤੀਰ ਅਤੇ ਕਮਾਨਾ ਸੰਭਾਲੀਆਂ ਹੋਈਆ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "सभू हाथ बाणं कमाणं संभारं ॥",
      "sourceLineId": "77778",
      "sourceShabadId": "7546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਰੁਪੇ ਖਾਨਿ ਖੂਨੀ ਕਰੈ ਲਾਗ ਜੱੁਧੰ ॥",
      "transliteration": "rupe khaan khoonee karai laag ja'udha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਖ਼ੂਨਖ਼ਾਰ ਪਠਾਣ ਯੁੱਧ ਕਰਨ ਲਈ ਡਟ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "रुपे खानि खूनी करै लाग जु्ुधं ॥",
      "sourceLineId": "77779",
      "sourceShabadId": "7546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਮੁਖੰ ਰਕਤ ਨੈਣੰ ਭਰੇ ਸੂਰ ਕ੍ਰੁੱਧੰ ॥੪੫॥",
      "transliteration": "mukha(n) rakat naina(n) bhare soor kru'dha(n) ||45||",
      "translation": "The bloody Khans stood firmly and began to fight with faces and eyes red with ire.45.",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਕਰ ਕੇ (ਸਾਰਿਆਂ) ਸੂਰਮਿਆਂ ਦੇ ਮੂੰਹ ਅਤੇ ਅੱਖਾ ਲਾਲ ਹੋ ਗਈਆਂ ਸਨ ॥੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "मुखं रकत नैणं भरे सूर क्रुद्धं ॥४५॥",
      "sourceLineId": "77780",
      "sourceShabadId": "7546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਜਗਿਯੋ ਜੰਗ ਜਾਲਮ ਸੁ ਜੋਧੰ ਜੁਝਾਰੰ ॥",
      "transliteration": "jagiyo ja(n)g jaalam su jodha(n) jujhaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਠੋਰ ਅਤੇ ਭਿਆਨਕ ਯੋਧਿਆਂ (ਦੇ ਮਨ ਵਿਚ) ਜੰਗ (ਦੀ ਬਿਰਤੀ) ਜਾਗ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "जगियो जंग जालम सु जोधं जुझारं ॥",
      "sourceLineId": "77781",
      "sourceShabadId": "7546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਬਹੇ ਬਾਣ ਬਾਂਕੇ ਬਰੱਛੀ ਦੁਧਾਰੰ ॥",
      "transliteration": "bahe baan baa(n)ke bara'chhee dhudhaara(n) ||",
      "translation": "The terrible battle of valiant warriors began. The arrows, spears and double-edged swords were used by the heroes.",
      "punjabiViakhya": "ਸੁੰਦਰ ਤਿਖੇ ਤੀਰ, ਬਰਛੀਆਂ ਅਤੇ ਦੁਧਾਰੇ (ਖੰਡੇ) ਚਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "बहे बाण बाँके बरच्छी दुधारं ॥",
      "sourceLineId": "77782",
      "sourceShabadId": "7546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਮਿਲੇ ਬੀਰ ਬੀਰੰ ਮਹਾਂ ਧੀਰ ਬੰਕੇ ॥",
      "transliteration": "mile beer beera(n) mahaa(n) dheer ba(n)ke ||",
      "translation": "",
      "punjabiViakhya": "ਵਡੇ ਵਡੇ ਸੂਰਮੇ ਧੀਰਜਵਾਨ ਬਾਕੇ ਸੂਰਮਿਆਂ ਨਾਲ ਗੁੱਥਮ-ਗੁੱਥਾ ਹੁੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "मिले बीर बीरं महाँ धीर बंके ॥",
      "sourceLineId": "77783",
      "sourceShabadId": "7546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਧਕਾ ਧਕਿ ਸੈਥੰ ਕ੍ਰਿਪਾਨੰ ਝਨੰਕੇ ॥੪੬॥",
      "transliteration": "dhakaa dhak saitha(n) kirapaana(n) jhana(n)ke ||46||",
      "translation": "The warriors met being pushed forward and the swords are jingling.46.",
      "punjabiViakhya": "(ਕਿਤੇ) ਸੈਹੱਥੀਆਂ ਨਾਲ ਧਕਮ-ਧਕੀ ਹੋ ਰਹੀ ਹੈ, (ਕਿਤੇ) ਤਲਵਾਰਾ ਦੀ ਛਣਕਾਰ ਹੋ ਰਹੀ ਹੈ ॥੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "धका धकि सैथं कृपानं झनंके ॥४६॥",
      "sourceLineId": "77784",
      "sourceShabadId": "7546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਭਏ ਢੋਲ ਢੰਕਾਰ ਨਾਦੰ ਨਫੀਰੰ ॥",
      "transliteration": "bhe ddol dda(n)kaar naadha(n) nafeera(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਤੇ) ਢੋਲਾ ਦੀ ਢਮਕਾਰ ਅਤੇ ਤੂਤੀਆਂ ਦੀ ਆਵਾਜ਼ ਪੈਦਾ ਹੋ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "भए ढोल ढंकार नादं नफीरं ॥",
      "sourceLineId": "77785",
      "sourceShabadId": "7546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਉਠੈ ਬਾਹੁ ਆਘਾਤ ਗੱਜੈ ਸੁ ਬੀਰੰ ॥",
      "transliteration": "auThai baahu aaghaat ga'jai su beera(n) ||",
      "translation": "The drums and the fifes are resounding, the arms rise to strike blows and the brave fighters are roaring.",
      "punjabiViakhya": "(ਕਿਤੇ) ਬਾਹਵਾ ਦੀ ਸੱਟ (ਨਾਲ ਧੁਨ) ਉਠਦੀ ਹੈ ਅਤੇ (ਕਿਤੇ) ਸੂਰਬੀਰ ਗਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "उठै बाहु आघात गज्जै सु बीरं ॥",
      "sourceLineId": "77786",
      "sourceShabadId": "7546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਨਵੰ ਨੱਦ ਨੀਸਾਨ ਬੱਜੇ ਅਪਾਰੰ ॥",
      "transliteration": "nava(n) na'dh neesaan ba'je apaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਧੌਂਸਿਆਂ ਦੇ ਵਜਣ ਤੋਂ ਕਈ ਪ੍ਰਕਾਰ ਦੀਆਂ ਨਵੇਕਲੀਆਂ ਆਵਾਜ਼ਾ ਨਿਕਲਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "नवं नद्द नीसान बज्जे अपारं ॥",
      "sourceLineId": "77787",
      "sourceShabadId": "7546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਰੁਲੇ ਤੱਛ ਮੁੱਛੰ ਉਠੀ ਸਸਤ੍ਰ ਝਾਰੰ ॥੪੭॥",
      "transliteration": "rule ta'chh mu'chha(n) uThee sasatr jhaara(n) ||47||",
      "translation": "The new trumpets resound in great numbers. The chopped heroes are rolling in dust and the sparks arise with the collision of weapons.47.",
      "punjabiViakhya": "ਵਢੇ ਟੁਕੇ (ਸੂਰਵੀਰ) ਰੁਲ ਰਹੇ ਹਨ ਅਤੇ ਸ਼ਸਤ੍ਰਾ (ਦੇ ਵਜਣ ਨਾਲ) ਚਿੰਗਾਰੀਆਂ ਉਠਦੀਆਂ ਹਨ ॥੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "रुले तच्छ मुच्छं उठी ससत्र झारं ॥४७॥",
      "sourceLineId": "77788",
      "sourceShabadId": "7546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਟਕਾ ਟੁੱਕ ਟੋਪੰ ਢਕਾ ਢੁੱਕ ਢਾਲੰ ॥",
      "transliteration": "Takaa Tu'k Topa(n) ddakaa ddu'k ddaala(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਲੋਹੇ ਦੇ) ਟੋਪਾ ਦੀ ਟਕ-ਟਕ ਅਤੇ ਢਾਲਾ ਦੀ ਢਕ-ਢਕ (ਦੀਆਂ ਅਵਾਜ਼ਾ ਸੁਣਾਈ ਦਿੰਦੀਆਂ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "टका टुक्क टोपं ढका ढुक्क ढालं ॥",
      "sourceLineId": "77789",
      "sourceShabadId": "7546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਮਹਾਂ ਬੀਰ ਬਾਨੈਤ ਬੰਕੇ ਬਿਕ੍ਰਾਲੰ ॥",
      "transliteration": "mahaa(n) beer baanait ba(n)ke bikraala(n) ||",
      "translation": "The helmets and shield have been broken into bits and the great heroes shooting arrows look terrible and not elegant.",
      "punjabiViakhya": "ਮਹਾਵੀਰ ਅਤੇ ਬਾਕੇ ਤੀਰ-ਅੰਦਾਜ਼ ਭਿਆਨਕ (ਰੂਪ ਧਾਰ ਰਹੇ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "महाँ बीर बानैत बंके बिक्रालं ॥",
      "sourceLineId": "77790",
      "sourceShabadId": "7546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0068_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਨਚੇ ਬੀਰ ਬੈਤਾਲਯੰ ਭੂਤ ਪ੍ਰੇਤੰ ॥",
      "transliteration": "nache beer baitaalaya(n) bhoot preta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬੀਰ-ਬੈਤਾਲ, ਭੂਤ ਅਤੇ ਪ੍ਰੇਤ ਨਚ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 68,
      "hindi": "",
      "hindiTransliteration": "नचे बीर बैतालयं भूत प्रेतं ॥",
      "sourceLineId": "77791",
      "sourceShabadId": "7546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    }
  ]
}
