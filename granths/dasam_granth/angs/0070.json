{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 70,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0070_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਘਨਿਯੋ ਕਾਲ ਕੈ ਕੈ ॥",
      "transliteration": "ghaniyo kaal kai kai ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤਿਆਂ ਦੀ ਮੌਤ (ਦਾ ਕਾਰਨ) ਬਣ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "घनियो काल कै कै ॥",
      "sourceLineId": "77840",
      "sourceShabadId": "7551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚਲੈ ਜੱਸ ਲੈ ਕੈ ॥੬੧॥",
      "transliteration": "chalai ja's lai kai ||61||",
      "translation": "After destroying many and receiving approbation, he hath left.61.",
      "punjabiViakhya": "ਯਸ਼ ਹਾਸਲ ਕਰਦਾ (ਖ਼ੁਦ ਵੀ ਕਾਲ ਵਸ ਹੋ ਕੇ) ਚਲਾ ਗਿਆ ॥੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "चलै जस्स लै कै ॥६१॥",
      "sourceLineId": "77841",
      "sourceShabadId": "7551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਜੇ ਸੰਖ ਨਾਦੰ ॥",
      "transliteration": "baje sa(n)kh naadha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਖ ਅਤੇ ਧੌਂਸੇ ਵਜਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "बजे संख नादं ॥",
      "sourceLineId": "77842",
      "sourceShabadId": "7551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੁਰੰ ਨਿਰਬਿਖਾਦੰ ॥",
      "transliteration": "sura(n) nirabikhaadha(n) ||",
      "translation": "The conches and trumpets resound and their sound is heard constantly.",
      "punjabiViakhya": "ਅਤੇ ਲਗਾਤਾਰ ਧੁਨਾ ਨਿਕਲ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "सुरं निरबिखादं ॥",
      "sourceLineId": "77843",
      "sourceShabadId": "7551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਜੇ ਡੌਰ ਡੱਢੰ ॥",
      "transliteration": "baje ddauar dda'dda(n) ||",
      "translation": "",
      "punjabiViakhya": "ਡੌਰੂ ਅਤੇ ਡੱਫਾ ਵੱਜਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "बजे डौर डड्ढं ॥",
      "sourceLineId": "77844",
      "sourceShabadId": "7551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਠੇ ਸਸਤ੍ਰ ਕੱਢੰ ॥੬੨॥",
      "transliteration": "haThe sasatr ka'dda(n) ||62||",
      "translation": "The tabors and drums resound and the warriors are taking out their weapons.62.",
      "punjabiViakhya": "ਹਠੀਲੇ ਸੂਰਮੇ ਸ਼ਸਤ੍ਰ ਕਢਦੇ ਹਨ ॥੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "हठे ससत्र कड्ढं ॥६२॥",
      "sourceLineId": "77845",
      "sourceShabadId": "7551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪਰੀ ਭੀਰ ਭਾਰੀ ॥",
      "transliteration": "paree bheer bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਭੀੜ ਮਚ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "परी भीर भारी ॥",
      "sourceLineId": "77846",
      "sourceShabadId": "7551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੁਝੈ ਛਤ੍ਰ ਧਾਰੀ ॥",
      "transliteration": "jujhai chhatr dhaaree ||",
      "translation": "There is overcrowding and the kings have fallen as martyrs.",
      "punjabiViakhya": "ਕਈ ਛਤ੍ਰਧਾਰੀ (ਰਾਜੇ) ਮਾਰੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "जुझै छत्र धारी ॥",
      "sourceLineId": "77847",
      "sourceShabadId": "7551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮੁਖੰ ਮੱੁਛ ਬੰਕੰ ॥",
      "transliteration": "mukha(n) ma'uchh ba(n)ka(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮੂੰਹ ਉਤੇ ਸੁੰਦਰ ਮੁੱਛਾ ਵਾਲੇ",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "मुखं मु्ुछ बंकं ॥",
      "sourceLineId": "77848",
      "sourceShabadId": "7551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮੰਡੇ ਬੀਰ ਹੰਕੰ ॥੬੩॥",
      "transliteration": "ma(n)dde beer ha(n)ka(n) ||63||",
      "translation": "The warriors on whose faces there are winsome whiskers, they are shouting very loudly.63.",
      "punjabiViakhya": "ਸੂਰਵੀਰ ਲਲਕਾਰੇ ਮਾਰ ਰਹੇ ਹਨ ॥੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "मंडे बीर हंकं ॥६३॥",
      "sourceLineId": "77849",
      "sourceShabadId": "7551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮੁਖੰ ਮਾਰਿ ਬੋਲੈਂ ॥",
      "transliteration": "mukha(n) maar bolai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮੂੰਹੋ ਮਾਰੋ-ਮਾਰੋ ਬੋਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "मुखं मारि बोलैं ॥",
      "sourceLineId": "77850",
      "sourceShabadId": "7551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਣੰ ਭੂਮਿ ਡੋਲੈਂ ॥",
      "transliteration": "rana(n) bhoom ddolai(n) ||",
      "translation": "From their mouths, they are shouting “kill. Kill”, and roam in the battlefield.",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਵਿਚਰ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "रणं भूमि डोलैं ॥",
      "sourceLineId": "77851",
      "sourceShabadId": "7551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹਥਿਆਰੰ ਸੰਭਾਰੈਂ ॥",
      "transliteration": "hathiaara(n) sa(n)bhaarai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹਥਿਆਰਾ ਨੂੰ ਸੰਭਾਲ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "हथिआरं संभारैं ॥",
      "sourceLineId": "77852",
      "sourceShabadId": "7551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਉਭੈ ਬਾਜ ਡਾਰੈਂ ॥੬੪॥",
      "transliteration": "aubhai baaj ddaarai(n) ||64||",
      "translation": "They hold their weapons and cause the horses of both sides to flee.64",
      "punjabiViakhya": "ਦੋਹਾ ਪਾਸਿਆਂ (ਦੇ ਸੂਰਮੇ) ਘੋੜੇ ਭਜਾਉਾਂਦੇ ਹਨ ॥੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "उभै बाज डारैं ॥६४॥",
      "sourceLineId": "77853",
      "sourceShabadId": "7551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "77854",
      "sourceShabadId": "7552",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰਣ ਜੁਝਤ ਕਿਰਪਾਲ ਕੇ ਨਾਚਤ ਭਯੋ ਗੁਪਾਲ ॥",
      "transliteration": "ran jujhat kirapaal ke naachat bhayo gupaal ||",
      "translation": "When Kirpal died in the battlefield, Gopal rejoiced.",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਕ੍ਰਿਪਾਲ ਚੰਦ ਦੇ ਜੂਝਣ ਨਾਲ ਗੋਪਾਲ ਚੰਦ (ਖੁਸ਼ੀ ਨਾਲ) ਨਚਣ ਲਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "रण जुझत किरपाल के नाचत भयो गुपाल ॥",
      "sourceLineId": "77855",
      "sourceShabadId": "7552",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੈਨ ਸਭੈ ਸਿਰਦਾਰ ਦੈ ਭਾਜਤ ਭਈ ਬਿਹਾਲ ॥੬੫॥",
      "transliteration": "sain sabhai siradhaar dhai bhaajat bhiee bihaal ||65||",
      "translation": "All the army fled in disorder, when their leaders Hussain and Kirpal were killed. 65.",
      "punjabiViakhya": "ਦੋਹਾ ਸਰਦਾਰਾ (ਹੁਸੈਨੀ ਅਤੇ ਕ੍ਰਿਪਾਲ ਚੰਦ) ਦੀ ਸਾਰੀ ਸੈਨਾ ਬੇਹਾਲ ਹੋ ਕੇ ਭਜ ਗਈ ॥੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "सैन सभै सिरदार दै भाजत भई बिहाल ॥६५॥",
      "sourceLineId": "77856",
      "sourceShabadId": "7552",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਖਾਨ ਹੁਸੈਨ ਕ੍ਰਿਪਾਲ ਕੇ ਹਿੰਮਤ ਰਣ ਜੂਝੰਤ ॥",
      "transliteration": "khaan husain kirapaal ke hi(n)mat ran joojha(n)t ||",
      "translation": "After the death of Hussain and Kirpal and the fall of Himmat",
      "punjabiViakhya": "ਹੁਸੈਨੀ ਖ਼ਾਨ, ਕ੍ਰਿਪਾਲ ਚੰਦ ਅਤੇ ਹਿੰਮਤ ਦੇ ਰਣ ਵਿਚ ਮਾਰੇ ਜਾਣ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "खान हुसैन कृपाल के हिंमत रण जूझंत ॥",
      "sourceLineId": "77857",
      "sourceShabadId": "7552",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭਾਜਿ ਚਲੇ ਜੋਧਾ ਸਬੈ ਜਿਮ ਦੇ ਮੁਕਟ ਮਹੰਤ ॥੬੬॥",
      "transliteration": "bhaaj chale jodhaa sabai jim dhe mukaT maha(n)t ||66||",
      "translation": "All the warriors fled, just as people go away after giving authority to the Mahant.66.",
      "punjabiViakhya": "ਸਾਰੇ ਯੋਧੇ (ਉਥੋਂ) ਭਜ ਚਲੇ ਜਿਵੇਾਂ (ਕਿਸੇ) ਮਹੰਤ ਨੂੰ ਮੁਕਟ ਦੇ ਕੇ ਲੋਕੀਂ ਚਲੇ ਜਾਦੇ ਹਨ ॥੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "भाजि चले जोधा सबै जिम दे मुकट महंत ॥६६॥",
      "sourceLineId": "77858",
      "sourceShabadId": "7552",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "77859",
      "sourceShabadId": "7553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਹ ਬਿਧ ਸਤੁ੍ਰ ਸਬੈ ਚੁਨਿ ਮਾਰੇ ॥",
      "transliteration": "eeh bidh satur sabai chun maare ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਹਾ (ਗੋਪਾਲ ਚੰਦ ਨੇ) ਸਾਰੇ ਵੈਰੀ ਚੁਣ ਚੁਣ ਕੇ ਮਾਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "इह बिध सतु्र सबै चुनि मारे ॥",
      "sourceLineId": "77860",
      "sourceShabadId": "7553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗਿਰੇ ਆਪਨੇ ਸੂਰ ਸੰਭਾਰੇ ॥",
      "transliteration": "gire aapane soor sa(n)bhaare ||",
      "translation": "In this way, all the enemies were aimed and killed. After that they took care of their dead.",
      "punjabiViakhya": "(ਅਤੇ ਫਿਰ) ਡਿਗੇ ਹੋਏ ਆਪਣੇ ਸੂਰਮੇ ਸੰਭਾਲੇ।",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "गिरे आपने सूर संभारे ॥",
      "sourceLineId": "77861",
      "sourceShabadId": "7553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਹ ਘਾਇਲ ਹਿਮੰਤ ਕੱਹ ਲਹਾ ॥",
      "transliteration": "teh ghail hima(n)t ka'h lahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਘਾਇਲ ਹੋਏ ਹਿੰਮਤ ਨੂੰ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "तह घाइल हिमंत कह्ह लहा ॥",
      "sourceLineId": "77862",
      "sourceShabadId": "7553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਾਮ ਸਿੰਘ ਗੋਪਾਲ ਸਿਉਂ ਕਹਾ ॥੬੭॥",
      "transliteration": "raam si(n)gh gopaal siau(n) kahaa ||67||",
      "translation": "Then on seeing Himmat lying wounded, Ram Singh said to Gopal.67.",
      "punjabiViakhya": "ਰਾਮ ਸਿੰਘ ਨੇ ਗੋਪਾਲ ਚੰਦ ਨੂੰ ਕਿਹਾ ॥੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "राम सिंघ गोपाल सिउं कहा ॥६७॥",
      "sourceLineId": "77863",
      "sourceShabadId": "7553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਿਨ ਹਿੰਮਤ ਅਸ ਕਲਹ ਬਢਾਯੋ ॥",
      "transliteration": "jin hi(n)mat as kaleh baddaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਹਿੰਮਤ ਨੇ ਅਜਿਹਾ ਵੈਰ ਵਧਾਇਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "जिन हिंमत अस कलह बढायो ॥",
      "sourceLineId": "77864",
      "sourceShabadId": "7553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਘਾਇਲ ਆਜ ਹਾਥ ਵਹ ਆਯੋ ॥",
      "transliteration": "ghail aaj haath veh aayo ||",
      "translation": "“That Himmat, who had been the root-cause of all the quarrels, hath now fallen wounded in our hands.”",
      "punjabiViakhya": "ਅਜ ਉਹ ਘਾਇਲ (ਅਵਸਥਾ ਵਿਚ ਸਾਡੇ) ਹੱਥ ਲਗਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "घाइल आज हाथ वह आयो ॥",
      "sourceLineId": "77865",
      "sourceShabadId": "7553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਬ ਗੁਪਾਲ ਐਸੇ ਸੁਨਿ ਪਾਵਾ ॥",
      "transliteration": "jab gupaal aaise sun paavaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਗੋਪਾਲ ਚੰਦ ਨੇ ਅਜਿਹਾ ਸੁਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "जब गुपाल ऐसे सुनि पावा ॥",
      "sourceLineId": "77866",
      "sourceShabadId": "7553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਾਰਿ ਦੀਓ ਜੀਅਤ ਨ ਉਠਾਵਾ ॥੬੮॥",
      "transliteration": "maar dheeo jeeat na uThaavaa ||68||",
      "translation": "When Gopal heard these words, he killed Himmat and did not allow him to get up alive. 68.",
      "punjabiViakhya": "ਤਾ (ਉਸ ਨੇ ਹਿੰਮਤ ਨੂੰ) ਮਾਰ ਦਿੱਤਾ ਅਤੇ ਜੀਉਾਂਦਾ ਨਾ ਉਠਣ ਦਿੱਤਾ ॥੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "मारि दीओ जीअत न उठावा ॥६८॥",
      "sourceLineId": "77867",
      "sourceShabadId": "7553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜੀਤ ਭਈ ਰਨ ਭਯੋ ਉਜਾਰਾ ॥",
      "transliteration": "jeet bhiee ran bhayo ujaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਪਹਾੜੀ ਰਾਜਿਆਂ ਦੀ) ਜਿਤ ਹੋ ਗਈ ਅਤੇ ਰਣ-ਭੂਮੀ ਖਿੰਡ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "जीत भई रन भयो उजारा ॥",
      "sourceLineId": "77868",
      "sourceShabadId": "7553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਿਮ੍ਰਿਤ ਕਰਿ ਸਭ ਘਰੋ ਸਿਧਾਰਾ ॥",
      "transliteration": "simirat kar sabh gharo sidhaaraa ||",
      "translation": "The victory was gained and the battle ended. While remembering homes, all went there.",
      "punjabiViakhya": "(ਯੁੱਧ ਦੀਆਂ ਘਟਨਾਵਾ ਨੂੰ) ਚੇਤੇ ਕਰਦੇ ਸਭ (ਸੈਨਿਕ) ਘਰੋ-ਘਰੀਂ ਚਲੇ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "सिमृत करि सभ घरो सिधारा ॥",
      "sourceLineId": "77869",
      "sourceShabadId": "7553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਖਿ ਲੀਯੋ ਹਮ ਕੋ ਜਗਰਾਈ ॥",
      "transliteration": "raakh leeyo ham ko jagaraiee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਨੂੰ ਪਰਮਾਤਮਾ ਨੈ ਰਖ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "राखि लीयो हम को जगराई ॥",
      "sourceLineId": "77870",
      "sourceShabadId": "7553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਲੋਹ ਘਟਾ ਅਨਤੈ ਬਰਸਾਈ ॥੬੯॥",
      "transliteration": "loh ghaTaa anatai barasaiee ||69||",
      "translation": "The Lord protected me from the cloud of battle, which rained elsewhere. 69.",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਸਤ੍ਰਾ ਦਾ ਬਦਲ (ਲੋਹ-ਘਟਾ) ਹੋਰ ਥਾ ਤੇ ਵਰ੍ਹਾ ਦਿੱਤਾ ॥੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "लोह घटा अनतै बरसाई ॥६९॥",
      "sourceLineId": "77871",
      "sourceShabadId": "7553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਹੁਸੈਨੀ ਬਧ ਕ੍ਰਿਪਾਲ ਹਿੰਮਤ ਸੰਗਤੀਆ ਬਧ ਬਰਨਨੰ ਨਾਮ ਗਿਆਰਮੋ ਧਿਆਇ ਸਮਾਪਤ ਮਸਤੁ ਸੁਭ ਮਸਤੁ ॥੧੧॥ਅਫਜੂ॥੪੨੩॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the husainee badh kirapaal hi(n)mat sa(n)gateeaa badh baranana(n) naam giaaramo dhiaai samaapat masat subh masat ||11||afajoo||423||",
      "translation": "End of Eleventh Chapter of BACHITTAR NATAK entitled Description of the Killing of Hussaini and also the Killing of Kirpal, Himmat and Sangatia.11.423",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ ਞ'ਹੁਸੈਨੀ ਬਧ ਕ੍ਰਿਪਾਲ ਹਿੰਮਤ ਸੰਗਤੀਆਂ ਬਧ ਬਰਨਨੰਞ' ਨਾ ਦਾ ਗਿਆਰ੍ਹਵਾ ਅਧਿਆਇ ਸਮਾਪਤ ਹੁੰਦਾ ਹੈ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੧॥ਅਫਜੂ॥੪੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे हुसैनी बध कृपाल हिंमत संगतीआ बध बरननं नाम गिआरमो धिआइ समापत मसतु सुभ मसतु ॥११॥अफजू॥४२३॥",
      "sourceLineId": "77872",
      "sourceShabadId": "7553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "77873",
      "sourceShabadId": "7554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜੁੱਧ ਭਯੋ ਇਹ ਭਾਂਤਿ ਅਪਾਰਾ ॥",
      "transliteration": "ju'dh bhayo ieh bhaa(n)t apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਹਾ ਨਾਲ ਵਡਾ ਯੁੱਧ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "जुद्ध भयो इह भाँति अपारा ॥",
      "sourceLineId": "77874",
      "sourceShabadId": "7554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤੁਰਕਨ ਕੋ ਮਾਰਿਓ ਸਿਰਦਾਰਾ ॥",
      "transliteration": "turakan ko maario siradhaaraa ||",
      "translation": "In this way, the great battle was fought, when the leader of the Turks (Muslims) was killed.",
      "punjabiViakhya": "ਜਿਸ ਵਿਚ ਤੁਰਕਾ ਦੇ ਮੁੱਖੀਆਂ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "तुरकन को मारिओ सिरदारा ॥",
      "sourceLineId": "77875",
      "sourceShabadId": "7554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਰਿਸ ਤਨ ਖਾਨ ਦਿਲਾਵਰ ਤਏ ॥",
      "transliteration": "ris tan khaan dhilaavar te ||",
      "translation": "",
      "punjabiViakhya": "(ਫਲਸਰੂਪ) ਦਿਲਾਵਰ ਖ਼ਾਨ ਨੇ ਕ੍ਰੋਧ ਨਾਲ ਲਾਲ-ਪੀਲਾ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "रिस तन खान दिलावर तए ॥",
      "sourceLineId": "77876",
      "sourceShabadId": "7554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਇਤੈ ਸਊਰ ਪਠਾਵਤ ਭਏ ॥੧॥",
      "transliteration": "eitai suoor paThaavat bhe ||1||",
      "translation": "On this Dilawar become very angry and sent a contingent of horsemen in this direction.1.",
      "punjabiViakhya": "ਇਧਰ ਸਵਾਰਾ (ਦਾ ਦਲ) ਭੇਜ ਦਿੱਤਾ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "इतै सऊर पठावत भए ॥१॥",
      "sourceLineId": "77877",
      "sourceShabadId": "7554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਉਤੈ ਪਠਿਓ ਉਨ ਸਿੰਘ ਜੁਝਾਰਾ ॥",
      "transliteration": "autai paThio un si(n)gh jujhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੋਂ (ਦੂਜੇ ਪਾਸਿਓਂ) ਉਨ੍ਹਾ ਨੇ ਜੁਝਾਰ ਸਿੰਘ ਨੂੰ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "उतै पठिओ उन सिंघ जुझारा ॥",
      "sourceLineId": "77878",
      "sourceShabadId": "7554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਿਹ ਭਲਾਨ ਤੇ ਖੇਦ ਨਿਕਾਰਾ ॥",
      "transliteration": "teh bhalaan te khedh nikaaraa ||",
      "translation": "From the other side, Jujhar Singh was sent, who drove out the enemy from Bhallan immediately.",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਭਲਾਨ (ਨਾਮਕ ਕਸਬੇ) ਤੋਂ ਉਨ੍ਹਾ ਨੂੰ (ਸ਼ਾਹੀ ਫੌਜ ਨੂੰ) ਭਜਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "तिह भलान ते खेद निकारा ॥",
      "sourceLineId": "77879",
      "sourceShabadId": "7554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਇਤਿ ਗਜ ਸਿੰਘ ਪੰਮਾ ਦਲ ਜੋਰਾ ॥",
      "transliteration": "eit gaj si(n)gh pa(n)maa dhal joraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਧਰੋਂ ਗਜ ਸਿੰਘ ਅਤੇ ਪੰਮਾ (ਪਰਮਾਨੰਦ) ਨੇ ਸੈਨਾ ਇਕੱਠੀ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "इति गज सिंघ पंमा दल जोरा ॥",
      "sourceLineId": "77880",
      "sourceShabadId": "7554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਧਾਇ ਪਰੇ ਤਿਨ ਊਪਰ ਭੋਰਾ ॥੨॥",
      "transliteration": "dhai pare tin uoopar bhoraa ||2||",
      "translation": "On this side Gaj Singh and Pamma (Parmanand) assembled their forces and fell upon them early in the morning.2.",
      "punjabiViakhya": "ਅਤੇ ਪ੍ਰਭਾਤ ਵੇਲੇ ਉਨ੍ਹਾ ਉਤੇ ਜਾ ਪਏ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "धाइ परे तिन ऊपर भोरा ॥२॥",
      "sourceLineId": "77881",
      "sourceShabadId": "7554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਉਤੈ ਜੁਝਾਰ ਸਿੰਘ ਭਯੋ ਆਡਾ ॥",
      "transliteration": "autai jujhaar si(n)gh bhayo aaddaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਧਰ ਜੁਝਾਰ ਸਿੰਘ (ਰਣ-ਭੂਮੀ ਵਿਚ) ਇੰਜ ਡਟ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "उतै जुझार सिंघ भयो आडा ॥",
      "sourceLineId": "77882",
      "sourceShabadId": "7554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਮ ਰਨ ਖੰਭ ਭੂਮਿ ਰਨਿ ਗਾਡਾ ॥",
      "transliteration": "jim ran kha(n)bh bhoom ran gaaddaa ||",
      "translation": "On the other side Jujhar Singh stood firmly like a flagpost planted in the battlefield.",
      "punjabiViakhya": "ਮਾਨੋ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਕਿਸੇ ਨੇ ਖੰਭਾ ਗਡ ਦਿੱਤਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "जिम रन खंभ भूमि रनि गाडा ॥",
      "sourceLineId": "77883",
      "sourceShabadId": "7554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗਾਡਾ ਚਲੇ ਨ ਹਾਡਾ ਚਲਿ ਹੈ ॥",
      "transliteration": "gaaddaa chale na haaddaa chal hai ||",
      "translation": "",
      "punjabiViakhya": "ਗਡਿਆ ਹੋਇਆ (ਝੰਡਾ) ਤਾ ਭਾਵੇਾਂ ਹਿਲ ਜਾਏ, ਪਰ ਹਾਡਾ (ਜਾਤਿ ਦਾ ਰਾਜਪੂਤ ਯੁੱਧ-ਭੂਮੀ ਵਿਚੋਂ) ਹਿਲਣ ਵਾਲਾ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "गाडा चले न हाडा चलि है ॥",
      "sourceLineId": "77884",
      "sourceShabadId": "7554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਾਮੁਹਿ ਸੇਲ ਸਮਰ ਮੋ ਝਲਿ ਹੈ ॥੩॥",
      "transliteration": "saamuh sel samar mo jhal hai ||3||",
      "translation": "Even the flagpost might be loosened, but the brave Rajput did not waver, he received the blows without flinching.3.",
      "punjabiViakhya": "ਯੁੱਧ ਵਿਚ ਸਾਹਮਣਿਓਾਂ ਬਰਛੇ ਨੂੰ ਝਲਦਾ ਹੈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 70,
      "hindi": "",
      "hindiTransliteration": "सामुहि सेल समर मो झलि है ॥३॥",
      "sourceLineId": "77885",
      "sourceShabadId": "7554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0070_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਾਟ ਚੜ੍ਹੈ ਦਲ ਦੋਊ ਜੁਝਾਰਾ ॥",
      "transliteration": "baaT chaRhai dhal dhouoo jujhaaraa ||",
      "translation": "",
