{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 71,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0071_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮੰਡਿਓ ਬੀਰ ਖੇਤ ਮੋ ਜੱੁਧਾ ॥",
      "transliteration": "ma(n)ddio beer khet mo ja'udhaa ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ-ਵੀਰਾ ਨੇ ਰਣ-ਭੂਮੀ ਵਿਚ ਯੁੱਧ ਮਚਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "मंडिओ बीर खेत मो जु्ुधा ॥",
      "sourceLineId": "77888",
      "sourceShabadId": "7554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਉਪਜਿਉ ਸਮਰਸੂਰ ਮਨ ਕ੍ਰੱੁਧਾ ॥੪॥",
      "transliteration": "aupajiau samarasoor man kra'udhaa ||4||",
      "translation": "All the warriors were in great rage and the fight began in the battlefield.4.",
      "punjabiViakhya": "ਯੁੱਧ ਵਿਚ ਸੂਰਮਿਆਂ ਦੇ ਮਨ ਵਿਚ ਬਹੁਤ ਕ੍ਰੋਧ ਪੈਦਾ ਹੋਇਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "उपजिउ समरसूर मन क्रु्ुधा ॥४॥",
      "sourceLineId": "77889",
      "sourceShabadId": "7554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕੋਪ ਭਰੇ ਦੋਊ ਦਿਸ ਭਟ ਭਾਰੇ ॥",
      "transliteration": "kop bhare dhouoo dhis bhaT bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਪਾਸਿਆਂ ਦੇ ਮਹਾਨ ਸੂਰਮੇ ਕ੍ਰੋਧਵਾਨ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "कोप भरे दोऊ दिस भट भारे ॥",
      "sourceLineId": "77890",
      "sourceShabadId": "7554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਤੈ ਚੰਦੇਲ ਉਤੈ ਜਸਵਾਰੇ ॥",
      "transliteration": "eitai cha(n)dhel utai jasavaare ||",
      "translation": "The brave heroes of both the armies were in great anger, warriors of Chandel on this side and warriors of Jaswar on the other.",
      "punjabiViakhya": "ਇਧਰ ਚੰਦੇਲ ਅਤੇ ਉਧਰ ਜਸਵਾਲ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "इतै चंदेल उतै जसवारे ॥",
      "sourceLineId": "77891",
      "sourceShabadId": "7554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਢੋਲ ਨਗਾਰੇ ਬਜੇ ਅਪਾਰਾ ॥",
      "transliteration": "ddol nagaare baje apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਅਧਿਕ ਢੋਲ ਅਤੇ ਨਗਾਰੇ ਵਜੇ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "ढोल नगारे बजे अपारा ॥",
      "sourceLineId": "77892",
      "sourceShabadId": "7554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭੀਮ ਰੂਪ ਭੈਰੋ ਭਭਕਾਰਾ ॥੫॥",
      "transliteration": "bheem roop bhairo bhabhakaaraa ||5||",
      "translation": "Many drums and trumpets resounded, the terrible Bhairo (the god of war) shouted.5.",
      "punjabiViakhya": "ਭਿਆਨਕ ਰੂਪ ਵਾਲਾ ਭੈਰੋ ਵੀ ਲਲਕਾਰ ਰਿਹਾ ਹੈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "भीम रूप भैरो भभकारा ॥५॥",
      "sourceLineId": "77893",
      "sourceShabadId": "7554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "77894",
      "sourceShabadId": "7555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਧੁਣੰ ਢੋਲ ਬੱਜੇ ॥",
      "transliteration": "dhuna(n) ddol ba'je ||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲ ਵਜਣ ਦੀ ਧੁੰਨ ਸੁਣ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "धुणं ढोल बज्जे ॥",
      "sourceLineId": "77895",
      "sourceShabadId": "7555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਹਾਂ ਸੂਰ ਗੱਜੇ ॥",
      "transliteration": "mahaa(n) soor ga'je ||",
      "translation": "Listening to the resounding voice of the drums, the warriors thunder.",
      "punjabiViakhya": "ਵਡੇ ਸੂਰਮੇ ਗਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "महाँ सूर गज्जे ॥",
      "sourceLineId": "77896",
      "sourceShabadId": "7555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਰੇ ਸਸਤ੍ਰ ਘਾਵੰ ॥",
      "transliteration": "kare sasatr ghaava(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰ ਨਾਲ ਜ਼ਖ਼ਮ ਕਰਨ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "करे ससत्र घावं ॥",
      "sourceLineId": "77897",
      "sourceShabadId": "7555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚੜ੍ਹੇ ਚਿੱਤ ਚਾਵੰ ॥੬॥",
      "transliteration": "chaRhe chi't chaava(n) ||6||",
      "translation": "They inflict wounds with weapons, their minds filled with great zest.6.",
      "punjabiViakhya": "ਉਨ੍ਹਾ ਦੇ ਚਿਤ ਵਿਚ ਚਾਉ ਚੜ੍ਹਦਾ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "चड़्हे चित्त चावं ॥६॥",
      "sourceLineId": "77898",
      "sourceShabadId": "7555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨ੍ਰਿਭੈ ਬਾਜ ਡਾਰੈ ॥",
      "transliteration": "nirabhai baaj ddaarai ||",
      "translation": "",
      "punjabiViakhya": "ਨਿਰਭੈ ਹੋ ਕੇ ਘੋੜੇ ਭਜਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "नृभै बाज डारै ॥",
      "sourceLineId": "77899",
      "sourceShabadId": "7555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪਰੱਘੈ ਪ੍ਰਹਾਰੈ ॥",
      "transliteration": "para'ghai prahaarai ||",
      "translation": "Fearlessly, they cause their horses to run and strike the blows of axes.",
      "punjabiViakhya": "ਗੁਰਜਾ ਦੇ ਵਾਰ ਕਰ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "परग्घै प्रहारै ॥",
      "sourceLineId": "77900",
      "sourceShabadId": "7555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਰੇ ਤੇਗ ਘਾਯੰ ॥",
      "transliteration": "kare teg ghaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਨਾਲ ਘਾਉ ਕਰਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "करे तेग घायं ॥",
      "sourceLineId": "77901",
      "sourceShabadId": "7555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚੜ੍ਹੇ ਚਿੱਤ ਚਾਯੰ ॥੭॥",
      "transliteration": "chaRhe chi't chaaya(n) ||7||",
      "translation": "Many inflict wounds with their swords and the minds of all are very enthusiastic.7.",
      "punjabiViakhya": "ਅਤੇ (ਉਨ੍ਹਾ ਦੇ) ਚਿਤ ਵਿਚ ਚਾਉ ਚੜ੍ਹਦਾ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "चड़्हे चित्त चायं ॥७॥",
      "sourceLineId": "77902",
      "sourceShabadId": "7555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਕੈ ਮਾਰ ਮਾਰੰ ॥",
      "transliteration": "bakai maar maara(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਮੂੰਹੋਂ) ਮਾਰੋ-ਮਾਰੋ ਪੁਕਾਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "बकै मार मारं ॥",
      "sourceLineId": "77903",
      "sourceShabadId": "7555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨ ਸੰਕਾ ਬਿਚਾਰੰ ॥",
      "transliteration": "n sa(n)kaa bichaara(n) ||",
      "translation": "From their mouths, they shout “kill, kill”, without any doubts.",
      "punjabiViakhya": "ਕਿਸੇ ਪ੍ਰਕਾਰ ਦਾ ਕੋਈ ਸੰਗ ਸੰਕੋਚ ਨਹੀਂ ਵਿਚਾਰਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "न संका बिचारं ॥",
      "sourceLineId": "77904",
      "sourceShabadId": "7555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰੁਲੈ ਤੱਛ ਮੱੁਛੰ ॥",
      "transliteration": "rulai ta'chh ma'uchha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈ ਯੋਧੇ) ਕਟੇ ਵਢੇ ਹੋਏ ਰੁਲ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "रुलै तच्छ मु्ुछं ॥",
      "sourceLineId": "77905",
      "sourceShabadId": "7555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਰੈ ਸੁਰਗ ਇੱਛੰ ॥੮॥",
      "transliteration": "karai surag i'chha(n) ||8||",
      "translation": "The chopped warriors are rolling in dust and wish to go to heaven.8.",
      "punjabiViakhya": "ਅਤੇ ਸੁਅਰਗ ਜਾਣ ਦੀ ਇੱਛਾ ਕਰ ਰਹੇ ਹਨ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "करै सुरग इच्छं ॥८॥",
      "sourceLineId": "77906",
      "sourceShabadId": "7555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "77907",
      "sourceShabadId": "7556",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨੈਕ ਨ ਰਨ ਤੇ ਮੁਰਿ ਚਲੈਂ ਕਰੈ ਨਿਡਰ ਹ੍ਵੈ ਘਾਇ ॥",
      "transliteration": "naik na ran te mur chalai(n) karai niddar havai ghai ||",
      "translation": "They do not retrace their steps from the battlefield and inflict wounds fearlessly.",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਜ਼ਰਾ ਜਿੰਨਾ ਵੀ ਯੁੱਧ ਤੋਂ ਮੁੜਦੇ ਨਹੀਂ ਅਤੇ ਨਿਡਰ ਹੋ ਕੇ ਘਾਉ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "नैक न रन ते मुरि चलैं करै निडर ह्वै घाइ ॥",
      "sourceLineId": "77908",
      "sourceShabadId": "7556",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗਿਰ ਗਿਰ ਪਰੈ ਪਵੰਗ ਤੇ ਬਰੇਂ ਬਰੰਗਨ ਜਾਇ ॥੯॥",
      "transliteration": "gir gir parai pava(n)g te bare(n) bara(n)gan jai ||9||",
      "translation": "Those who fall from their horses, the heavenly damsels go to wed them.9.",
      "punjabiViakhya": "(ਉਹ) ਘੋੜਿਆਂ ਤੋਂ ਡਿਗ ਡਿਗ ਪੈਂਦੇ ਹਨ (ਅਤੇ ਪਰਲੋਕ ਵਿਚ) ਅਪੱਛਰਾਵਾ ਨੂੰ ਜਾ ਕੇ ਵਰਦੇ ਹਨ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "गिर गिर परै पवंग ते बरें बरंगन जाइ ॥९॥",
      "sourceLineId": "77909",
      "sourceShabadId": "7556",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "77910",
      "sourceShabadId": "7557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਹੋਤ ਭਯੋ ਸੰਗ੍ਰਾਮਾ ॥",
      "transliteration": "eeh bidh hot bhayo sa(n)graamaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਢੰਗ ਦਾ ਸੰਗ੍ਰਾਮ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "इह बिधि होत भयो संग्रामा ॥",
      "sourceLineId": "77911",
      "sourceShabadId": "7557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜੂਝੇ ਚੰਦ ਨਰਾਇਨ ਨਾਮਾ ॥",
      "transliteration": "joojhe cha(n)dh narain naamaa ||",
      "translation": "In this way, the battle continued on both sides (with great vigour). Chandan Rai was killed.",
      "punjabiViakhya": "(ਜਿਸ ਵਿਚ) ਨਰਾਇਨ ਚੰਦ ਨਾ (ਵਾਲਾ ਸੂਰਮਾ) ਮਾਰਿਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "जूझे चंद नराइन नामा ॥",
      "sourceLineId": "77912",
      "sourceShabadId": "7557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਬ ਜੁਝਾਰ ਏਕਲ ਹੀ ਧਯੋ ॥",
      "transliteration": "tab jujhaar ekal hee dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਜੁਝਾਰ (ਸਿੰਘ) ਇਕਲਾ ਹੀ ਧਾ ਕੇ ਪਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "तब जुझार एकल ही धयो ॥",
      "sourceLineId": "77913",
      "sourceShabadId": "7557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬੀਰਨ ਘੇਰ ਦਸੋ ਦਿਸ ਲਯੋ ॥੧੦॥",
      "transliteration": "beeran gher dhaso dhis layo ||10||",
      "translation": "Then Jujhar Singh continued the fight quite alone. He was surrounded from all sides.10.",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਦਸਾ ਦਿਸ਼ਾਵਾ ਤੋਂ (ਵੈਰੀ) ਸੂਰਮਿਆਂ ਨੇ ਘੇਰ ਲਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "बीरन घेर दसो दिस लयो ॥१०॥",
      "sourceLineId": "77914",
      "sourceShabadId": "7557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "77915",
      "sourceShabadId": "7558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਧਸਿਯੋ ਕਟਕ ਮੈ ਝਟਕ ਦੈ ਕਛੂ ਨ ਸੰਕ ਬਿਚਾਰ ॥",
      "transliteration": "dhasiyo kaTak mai jhaTak dhai kachhoo na sa(n)k bichaar ||",
      "translation": "He rushed into the army of the enemy without any hesitation.",
      "punjabiViakhya": "(ਜੁਝਾਰ ਸਿੰਘ ਚਿਤ ਵਿਚ) ਬਿਨਾ ਕੋਈ ਸ਼ੰਕਾ ਵਿਚਾਰੇ ਝਟਕ ਕੇ (ਵੈਰੀ ਦੀ) ਫ਼ੌਜ ਵਿਚ ਜਾ ਧਸਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "धसियो कटक मै झटक दै कछू न संक बिचार ॥",
      "sourceLineId": "77916",
      "sourceShabadId": "7558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗਾਹਤ ਭਯੋ ਸੁਭਟਨ ਬਡੇ ਬਾਹਤਿ ਭਯੋ ਹਥਿਆਰ ॥੧੧॥",
      "transliteration": "gaahat bhayo subhaTan badde baahat bhayo hathiaar ||11||",
      "translation": "And killed many soldiers, wielding his weapons very skillfully.11.",
      "punjabiViakhya": "ਵਡੇ ਵਡੇ ਯੋਧਿਆਂ ਨੂੰ ਗਾਹ ਦਿੱਤਾ ਅਤੇ (ਚੰਗੀ ਤਰ੍ਹਾ ਨਾਲ) ਹਥਿਆਰ ਵਾਹੇ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "गाहत भयो सुभटन बडे बाहति भयो हथिआर ॥११॥",
      "sourceLineId": "77917",
      "sourceShabadId": "7558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "77918",
      "sourceShabadId": "7559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਘਣੇ ਘਰਨ ਕੋ ਗਾਰਾ ॥",
      "transliteration": "eeh bidh ghane gharan ko gaaraa ||",
      "translation": "In this way, he destroyed many homes.",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਹਾ (ਉਸ ਨੇ) ਬਹੁਤ ਸਾਰੇ ਘਰਾ ਨੂੰ ਬਰਬਾਦ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "इह बिधि घणे घरन को गारा ॥",
      "sourceLineId": "77919",
      "sourceShabadId": "7559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭਾਂਤਿ ਭਾਂਤਿ ਕੇ ਕਰਿ ਹਥੀਯਾਰਾ ॥",
      "transliteration": "bhaa(n)t bhaa(n)t ke kar hatheeyaaraa ||",
      "translation": "He used various types of weapons.",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ-ਭਾਤ ਦੇ ਹਥਿਆਰਾ ਨਾਲ ਵਾਰ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "भाँति भाँति के करि हथीयारा ॥",
      "sourceLineId": "77920",
      "sourceShabadId": "7559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਚੁਨਿ ਚੁਨਿ ਬੀਰ ਪਖਰੀਆ ਮਾਰੇ ॥",
      "transliteration": "chun chun beer pakhareeaa maare ||",
      "translation": "He aimed and killed the brave horsemen.",
      "punjabiViakhya": "ਚੁਣ ਚੁਣ ਕੇ ਘੋੜ-ਚੜ੍ਹੇ ਸੂਰਮੇ ਮਾਰ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "चुनि चुनि बीर पखरीआ मारे ॥",
      "sourceLineId": "77921",
      "sourceShabadId": "7559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅੰਤਿ ਦੇਵ ਪੁਰ ਆਪ ਪਧਾਰੇ ॥੧੨॥",
      "transliteration": "a(n)t dhev pur aap padhaare ||12||",
      "translation": "But at last he left for the heavenly abode himself. ||12||",
      "punjabiViakhya": "ਅਤੇ ਅੰਤ ਵਿਚ ਆਪ ਸੁਅਰਗ ਨੂੰ ਚਲਾ ਗਿਆ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "अंति देव पुर आप पधारे ॥१२॥",
      "sourceLineId": "77922",
      "sourceShabadId": "7559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਜੁਝਾਰ ਸਿੰਘ ਜੁਧ ਬਰਨਨੰ ਨਾਮ ਦ੍ਵਾਦਸਮੋ ਧਿਆਇ ਸਮਾਪਤ ਮਸਤੁ ਸੁਭ ਮਸਤੁ ॥੧੨॥ਅਫਜੂ॥੪੩੫॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the jujhaar si(n)gh judh baranana(n) naam dhavaiaadhasamo dhiaai samaapat masat subh masat ||12||afajoo||435||",
      "translation": "End of the Twelfth Chapter of BACHITTAR NATAK entitled Description of the battle with Jujhar Singh. True, all is true. ||12|| Continues ||435||",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ \"ਜੁਝਾਰ ਸਿੰਹ ਜੁਧ ਬਰਨਨੰ\" ਨਾ ਵਾਲੇ ਬਾਰ੍ਹਵੇਂ ਅਧਿਆਏ ਦੀ ਸਮਾਪਤੀ ਹੁੰਦੀ ਹੈ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੨॥ਅਫਜੂ॥੪੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे जुझार सिंघ जुध बरननं नाम द्वादसमो धिआइ समापत मसतु सुभ मसतु ॥१२॥अफजू॥४३५॥",
      "sourceLineId": "77923",
      "sourceShabadId": "7559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਹਜਾਦੇ ਕੋ ਆਗਮਨ ਮਦ੍ਰ ਦੇਸ ॥",
      "transliteration": "sahajaadhe ko aagaman madhr dhes ||",
      "translation": "The arrival of Shahzada (the prince) in Madra Desha (Punjab):",
      "punjabiViakhya": "ਸ਼ਹਜਾਦੇ ਦਾ ਮਦ੍ਰ (ਪੰਜਾਬ) ਦੇਸ਼ ਵਿਚ ਆਉਣਾ",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "सहजादे को आगमन मद्र देस ॥",
      "sourceLineId": "77924",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "77925",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਸੋ ਬਧ ਭਯੋ ਜੁਝਾਰਾ ॥",
      "transliteration": "eeh bidh so badh bhayo jujhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਹਾ ਨਾਲ ਜਦੋਂ ਜੁਝਾਰ ਸਿੰਘ ਸ਼ਹੀਦ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "इह बिधि सो बध भयो जुझारा ॥",
      "sourceLineId": "77926",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਆਨ ਬਸੇ ਤਬ ਧਾਮ ਲੁਝਾਰਾ ॥",
      "transliteration": "aan base tab dhaam lujhaaraa ||",
      "translation": "In this way, when Jujhar Singh was killed, the soldiers returned to their homes.",
      "punjabiViakhya": "ਤਾ ਲੜਾਕੇ ਯੋਧੇ (ਆਪਣੇ) ਘਰਾ ਵਿਚ ਜਾ ਟਿਕੇ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "आन बसे तब धाम लुझारा ॥",
      "sourceLineId": "77927",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਬ ਅਉਰੰਗ ਮਨ ਮਾਹਿ ਰਿਸਾਵਾ ॥",
      "transliteration": "tab aaura(n)g man maeh risaavaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਔਰੰਗਜ਼ੇਬ ਮਨ ਵਿਚ ਕ੍ਰੋਧਵਾਨ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "तब अउरंग मन माहि रिसावा ॥",
      "sourceLineId": "77928",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮੱਦ੍ਰ ਦੇਸ ਕੋ ਪੂਤ ਪਠਾਵਾ ॥੧॥",
      "transliteration": "ma'dhr dhes ko poot paThaavaa ||1||",
      "translation": "Then Aurangzeb became very angry and sent his son to Madr Desha (Punjab).1.",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਪੰਜਾਬ ਵਲ ਆਪਣੇ ਪੁੱਤਰ ਨੂੰ ਭੇਜਿਆ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "मद्द्र देस को पूत पठावा ॥१॥",
      "sourceLineId": "77929",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਿੱਹ ਆਵਤ ਸਭ ਲੋਕ ਡਰਾਨੇ ॥",
      "transliteration": "ti'h aavat sabh lok ddaraane ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਆਣ ਨਾਲ ਸਭ ਲੋਕ ਭੈਭੀਤ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "तिह्ह आवत सभ लोक डराने ॥",
      "sourceLineId": "77930",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਡੇ ਬਡੇ ਗਿਰ ਹੇਰ ਲੁਕਾਨੇ ॥",
      "transliteration": "badde badde gir her lukaane ||",
      "translation": "On his arrival, all were frightened and hid themselves in big hills.",
      "punjabiViakhya": "ਵਡੇ ਵਡੇ (ਰਾਜੇ) ਪਹਾੜ ਲਭ ਕੇ (ਵਿਚ ਜਾ) ਲੁਕੇ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "बडे बडे गिर हेर लुकाने ॥",
      "sourceLineId": "77931",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹਮਹੂੰ ਲੋਗਨ ਅਧਿਕ ਡਰਾਯੋ ॥",
      "transliteration": "hamahoo(n) logan adhik ddaraayo ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਨੂੰ ਵੀ ਲੋਕਾ ਨੇ ਬਹੁਤ ਡਰਾਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "हमहूँ लोगन अधिक डरायो ॥",
      "sourceLineId": "77932",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਾਲ ਕਰਮ ਕੋ ਮਰਮ ਨ ਪਾਯੋ ॥੨॥",
      "transliteration": "kaal karam ko maram na paayo ||2||",
      "translation": "The people tried to frighten me also, because they did not understand the ways of Almighty.2.",
      "punjabiViakhya": "(ਪਰ ਉਨ੍ਹਾ ਵਿਚੋਂ ਕਿਸੇ ਨੇ ਵੀ) ਕਾਲ-ਕਰਮ ਦੇ ਭੇਦ ਨੂੰ ਨਾ ਪਾਇਆ (ਕਿ ਉਸ ਦੀ) ਗਤੀ ਕਿਵੇਾਂ ਹੈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "काल करम को मरम न पायो ॥२॥",
      "sourceLineId": "77933",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਿਤਕ ਲੋਕ ਤਜਿ ਸੰਗਿ ਸਿਧਾਰੇ ॥",
      "transliteration": "kitak lok taj sa(n)g sidhaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਲੋਕ (ਸਾਡਾ) ਸਾਥ ਛਡ ਕੇ ਚਲੇ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "कितक लोक तजि संगि सिधारे ॥",
      "sourceLineId": "77934",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਾਇ ਬਸੇ ਗਿਰਵਰ ਜਹਿ ਭਾਰੇ ॥",
      "transliteration": "jai base giravar jeh bhaare ||",
      "translation": "Some people left us and took refuge in the big hills.",
      "punjabiViakhya": "ਅਤੇ (ਉਥੇ) ਜਾ ਵਸੇ ਜਿਥੇ ਵਡੇ ਪਹਾੜ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "जाइ बसे गिरवर जहि भारे ॥",
      "sourceLineId": "77935",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਚਿਤ ਮੂਜੀਯਨ ਕੋ ਅਧਿਕ ਡਰਾਨਾ ॥",
      "transliteration": "chit moojeeyan ko adhik ddaraanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਹਾ) ਕਾਇਰਾ ਦਾ ਚਿਤ ਬਹੁਤ ਭੈਭੀਤ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "चित मूजीयन को अधिक डराना ॥",
      "sourceLineId": "77936",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤਿਨੈ ਉਬਾਰ ਨ ਅਪਨਾ ਜਾਨਾ ॥੩॥",
      "transliteration": "tinai ubaar na apanaa jaanaa ||3||",
      "translation": "The cowards were so much frightened that they did not consider their safety with me.3.",
      "punjabiViakhya": "ਉਨ੍ਹਾ ਨੇ (ਸਾਡੇ ਕੋਲ ਟਿਕੇ ਰਹਿਣ ਵਿਚ) ਆਪਣੀ ਸੁਰਖਿਆ ਨਾ ਸਮਝੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "तिनै उबार न अपना जाना ॥३॥",
      "sourceLineId": "77937",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਤਬ ਅਉਰੰਗ ਜੀਅ ਮਾਂਝ ਰਿਸਾਏ ॥",
      "transliteration": "tab aaura(n)g jeea maa(n)jh risaae ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਔਰੰਗਜ਼ੇਬ (ਆਪਣੇ) ਮਨ ਵਿਚ ਬਹੁਤ ਕ੍ਰੋਧਵਾਨ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "तब अउरंग जीअ माँझ रिसाए ॥",
      "sourceLineId": "77938",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਏਕ ਅਹਦੀਆ ਈਹਾਂ ਪਠਾਏ ॥",
      "transliteration": "ek ahadheeaa ieehaa(n) paThaae ||",
      "translation": "The son of Aurangzeb grew very angry and sent a subordinate in this direction.",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਅਹਿਦੀ (ਕਰ ਵਸੂਲਣ ਵਾਲਾ ਅਧਿਕਾਰੀ) ਇਥੇ (ਆਨੰਦਪੁਰ) ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "एक अहदीआ ईहाँ पठाए ॥",
      "sourceLineId": "77939",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਹਮ ਤੇ ਭਾਜਿ ਬਿਮੁਖ ਜੇ ਗਏ ॥",
      "transliteration": "ham te bhaaj bimukh je ge ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਡੇ ਕੋਲੋਂ ਬੇਮੁਖ ਹੋ ਕੇ ਜੋ ਭਜ ਗਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "हम ते भाजि बिमुख जे गए ॥",
      "sourceLineId": "77940",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤਿਨ ਕੇ ਧਾਮ ਗਿਰਾਵਤ ਭਏ ॥੪॥",
      "transliteration": "tin ke dhaam giraavat bhe ||4||",
      "translation": "Those who had left me in distrust, their homes were demolished by him.4.",
      "punjabiViakhya": "ਉਨ੍ਹਾ ਦੇ ਘਰ (ਅਹਿਦੀਏ ਨੇ) ਢਵਾ ਦਿੱਤੇ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "तिन के धाम गिरावत भए ॥४॥",
      "sourceLineId": "77941",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜੇ ਅਪਨੇ ਗੁਰ ਤੇ ਮੁਖ ਫਿਰਹੈਂ ॥",
      "transliteration": "je apane gur te mukh firahai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਆਪਣੇ ਗੁਰੂ ਤੋਂ ਮੁਖ ਮੋੜ ਲੈਂਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "जे अपने गुर ते मुख फिरहैं ॥",
      "sourceLineId": "77942",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਈਹਾਂ ਊਹਾਂ ਤਿਨ ਕੇ ਗ੍ਰਿਹ ਗਿਰਿਹੈਂ ॥",
      "transliteration": "e'eehaa(n) uoohaa(n) tin ke gireh girihai(n) ||",
      "translation": "Those who turn away their faces from the Guru, their houses are demolished in this and the next world.",
      "punjabiViakhya": "ਉਨ੍ਹਾ ਦੇ ਘਰ ਇਥੇ ਅਤੇ ਉਥੇ (ਲੋਕ ਅਤੇ ਪਰਲੋਕ) ਵਿਚ ਨਸ਼ਟ ਹੋ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "ईहाँ ऊहाँ तिन के गृह गिरिहैं ॥",
      "sourceLineId": "77943",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਇਹਾਂ ਉਪਹਾਸ ਨ ਸੁਰ ਪੁਰ ਬਾਸਾ ॥",
      "transliteration": "eihaa(n) upahaas na sur pur baasaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ (ਉਨ੍ਹਾ ਨੂੰ) ਮਖ਼ੌਲ ਹੁੰਦੇ ਹਨ ਅਤੇ ਸੁਅਰਗ ਵਿਚ ਨਿਵਾਸ ਨਹੀਂ ਮਿਲਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "इहाँ उपहास न सुर पुर बासा ॥",
      "sourceLineId": "77944",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਸਭ ਬਾਤਨ ਤੇ ਰਹੈ ਨਿਰਾਸਾ ॥੫॥",
      "transliteration": "sabh baatan te rahai niraasaa ||5||",
      "translation": "They are ridiculed here and also do not get an abode in heaven. They also remain disappointed in all things.5.",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਗੱਲਾ ਤੋਂ ਨਿਰਾਸ਼ ਹੀ ਰਹਿੰਦੇ ਹਨ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "सभ बातन ते रहै निरासा ॥५॥",
      "sourceLineId": "77945",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਦੂਖ ਭੂਖ ਤਿਨ ਕੋ ਰਹੈ ਲਾਗੀ ॥",
      "transliteration": "dhookh bhookh tin ko rahai laagee ||",
      "translation": "",
      "punjabiViakhya": "ਦੁਖ ਅਤੇ ਭੁਖ ਉਨ੍ਹਾ ਨੂੰ (ਸਦਾ) ਲਗੀ ਰਹਿੰਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "दूख भूख तिन को रहै लागी ॥",
      "sourceLineId": "77946",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਸੰਤ ਸੇਵ ਤੇ ਜੋ ਹੈ ਤਿਆਗੀ ॥",
      "transliteration": "sa(n)t sev te jo hai tiaagee ||",
      "translation": "They are always inflicted by hunger and sorrow, those, who have forsaken the service of the saints.",
      "punjabiViakhya": "ਜਿਹੜੇ ਸੰਤ-ਸੇਵਾ ਤੋਂ ਕਤਰਾਉਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "संत सेव ते जो है तिआगी ॥",
      "sourceLineId": "77947",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਜਗਤ ਬਿਖੈ ਕੋਈ ਕਾਮ ਨ ਸਰਹੀਂ ॥",
      "transliteration": "jagat bikhai koiee kaam na sarahee(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਹਾ ਦਾ) ਸੰਸਾਰ ਵਿਚ ਕੋਈ ਕੰਮ ਨਹੀਂ ਸਰਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "जगत बिखै कोई काम न सरहीं ॥",
      "sourceLineId": "77948",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਅੰਤਹਿ ਕੁੰਡ ਨਰਕ ਕੀ ਪਰਹੀਂ ॥੬॥",
      "transliteration": "a(n)teh ku(n)dd narak kee parahee(n) ||6||",
      "translation": "None of their wishes are fulfilled in the world and in the end, they abide in the fire of the abyss of hell.6.",
      "punjabiViakhya": "ਅੰਤ ਵਿਚ ਉਹ ਨਰਕ-ਕੁੰਡ ਵਿਚ ਜਾ ਡਿਗਦੇ ਹਨ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "अंतहि कुँड नरक की परहीं ॥६॥",
      "sourceLineId": "77949",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਤਿਨ ਕੋ ਸਦਾ ਜਗਤ ਉਪਹਾਸਾ ॥",
      "transliteration": "tin ko sadhaa jagat upahaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਹਾ ਦੀ ਜਗਤ ਸਦਾ ਹਾਸੀ ਕਰਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "तिन को सदा जगत उपहासा ॥",
      "sourceLineId": "77950",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਅੰਤਹਿ ਕੁੰਡ ਨਰਕ ਕੀ ਬਾਸਾ ॥",
      "transliteration": "a(n)teh ku(n)dd narak kee baasaa ||",
      "translation": "They are always ridiculed in the world and in the end, they abide in the fire of the abyss of hell.",
      "punjabiViakhya": "ਅਤੇ ਅੰਤ ਵਿਚ (ਉਨ੍ਹਾ ਨੂੰ) ਨਰਕਕੁੰਡ ਵਿਚ ਨਿਵਾਸ ਮਿਲਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "अंतहि कुँड नरक की बासा ॥",
      "sourceLineId": "77951",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਗੁਰ ਪਗ ਤੇ ਜੇ ਬੇਮੁਖ ਸਿਧਾਰੇ ॥",
      "transliteration": "gur pag te je bemukh sidhaare ||",
      "translation": "",
      "punjabiViakhya": "ਗੁਰੂ-ਚਰਨਾ ਤੋਂ ਜੋ ਬੇਮੁਖ ਹੁੰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "गुर पग ते जे बेमुख सिधारे ॥",
      "sourceLineId": "77952",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਈਹਾਂ ਊਹਾ ਤਿਨ ਕੇ ਮੁਖ ਕਾਰੇ ॥੭॥",
      "transliteration": "e'eehaa(n) uoohaa tin ke mukh kaare ||7||",
      "translation": "Those, who turn away their face from the feet of the Guru, their faces are blackened in this and the next world.7.",
      "punjabiViakhya": "ਲੋਕ-ਪਰਲੋਕ ਵਿਚ ਉਨ੍ਹਾ ਦੇ ਮੂੰਹ ਕਾਲੇ ਹੁੰਦੇ ਹਨ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "ईहाँ ऊहा तिन के मुख कारे ॥७॥",
      "sourceLineId": "77953",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਪੁਤ੍ਰ ਪਉਤ੍ਰ ਤਿਨ ਕੇ ਨਹੀਂ ਫਰੈਂ ॥",
      "transliteration": "putr pautr tin ke nahee(n) farai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਹਾ ਦੇ ਪੁੱਤਰ-ਪੋਤਰੇ ਵੀ ਨਹੀਂ ਫਲਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "पुत्र पउत्र तिन के नहीं फरैं ॥",
      "sourceLineId": "77954",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਦੁਖ ਦੈ ਮਾਤ ਪਿਤਾ ਕੋ ਮਰੈਂ ॥",
      "transliteration": "dhukh dhai maat pitaa ko marai(n) ||",
      "translation": "Their sons and grandsons do not prosper and they die, creating great agony for their parents.",
      "punjabiViakhya": "ਅਤੇ ਮਾਤਾ ਪਿਤਾ ਨੂੰ (ਜੁਦਾਈ ਦਾ) ਦੁਖ ਦੇ ਕੇ ਮਰ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "दुख दै मात पिता को मरैं ॥",
      "sourceLineId": "77955",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਗੁਰ ਦੋਖੀ ਸਗ ਕੀ ਮ੍ਰਿਤੁ ਪਾਵੈ ॥",
      "transliteration": "gur dhokhee sag kee mrit paavai ||",
      "translation": "",
      "punjabiViakhya": "ਗੁਰੂ ਦੇ ਦੋਖੀ ਕੁੱਤੇ ਦੀ ਮੌਤੇ ਮਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "गुर दोखी सग की मृतु पावै ॥",
      "sourceLineId": "77956",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਨਰਕ ਕੁੰਡ ਡਾਰੇ ਪਛੁਤਾਵੈ ॥੮॥",
      "transliteration": "narak ku(n)dd ddaare pachhutaavai ||8||",
      "translation": "The one, who hath malice of the Guru in his heart, dies the death of ad dog. He repents, when he is thrown in the abyss of hell.8.",
      "punjabiViakhya": "ਜਦੋਂ (ਉਨ੍ਹਾ ਨੂੰ) ਨਰਕ ਕੁੰਡ ਵਿਚ ਸੁਟਿਆ ਜਾਵੇਗਾ (ਤਾ ਉਹ) ਪਛਤਾਉਣਗੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": "नरक कुँड डारे पछुतावै ॥८॥",
      "sourceLineId": "77957",
      "sourceShabadId": "7560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": "Amrit Keertan"
    },
    {
      "id": "dasam_ang_0071_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਬਾਬੇ ਕੇ ਬਾਬਰ ਕੇ ਦੋਊ ॥",
      "transliteration": "baabe ke baabar ke dhouoo ||",
      "translation": "",
