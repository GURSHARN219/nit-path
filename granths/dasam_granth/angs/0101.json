{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 101,
  "lineCount": 45,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0101_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "78974",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਬੈ ਦੇਵ ਧਾਏ ॥",
      "transliteration": "tabai dhev dhaae ||",
      "translation": "Then the gods ran towards the goddess",
      "punjabiViakhya": "ਤਦੋਂ ਦੇਵਤੇ (ਹੋਰ ਅਗੇ) ਵਧੇ,",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "तबै देव धाए ॥",
      "sourceLineId": "78975",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਭੋ ਸੀਸ ਨਿਆਏ ॥",
      "transliteration": "sabho sees niaae ||",
      "translation": "With bowed heads.",
      "punjabiViakhya": "ਸਭ ਨੇ (ਦੇਵੀ ਅਗੇ) ਸੀਸ ਝੁਕਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "सभो सीस निआए ॥",
      "sourceLineId": "78976",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੁਮਨ ਧਾਰ ਬਰਖੇ ॥",
      "transliteration": "suman dhaar barakhe ||",
      "translation": "The flowers were showered",
      "punjabiViakhya": "ਫੁਲਾ ਦੀ ਬਰਖਾ ਹੋਣ ਲਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "सुमन धार बरखे ॥",
      "sourceLineId": "78977",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਬੈ ਸਾਧ ਹਰਖੇ ॥੬॥",
      "transliteration": "sabai saadh harakhe ||6||",
      "translation": "And all the saints (hods) were pleased.6.",
      "punjabiViakhya": "ਸਾਰੇ ਸਾਧੂ ਲੋਕ ਪ੍ਰਸੰਨ ਹੋਏ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "सबै साध हरखे ॥६॥",
      "sourceLineId": "78978",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਰੀ ਦੇਬਿ ਅਰਚਾ ॥",
      "transliteration": "karee dheb arachaa ||",
      "translation": "The goddess was worshipped",
      "punjabiViakhya": "(ਸਾਰਿਆਂ ਨੇ) ਦੇਵੀ ਦੀ ਪੂਜਾ ਕੀਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "करी देबि अरचा ॥",
      "sourceLineId": "78979",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬ੍ਰਹਮ ਬੇਦ ਚਰਚਾ ॥",
      "transliteration": "braham bedh charachaa ||",
      "translation": "With the recitation of Vesdas manifested by Brahma.",
      "punjabiViakhya": "ਬ੍ਰਹਮਾ ਨੇ ਵੇਦਾ ਦਾ ਪਾਠ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "ब्रहम बेद चरचा ॥",
      "sourceLineId": "78980",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਬੈ ਪਾਇ ਲਾਗੇ ॥",
      "transliteration": "jabai pai laage ||",
      "translation": "When they fell at the feet of the goddess",
      "punjabiViakhya": "ਜਦੋਂ (ਦੇਵੀ ਦੇ) ਚਰਨਾ ਦੀ ਛੋਹ ਪ੍ਰਾਪਤ ਕੀਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "जबै पाइ लागे ॥",
      "sourceLineId": "78981",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਬੈ ਸੋਗ ਭਾਗੇ ॥੭॥",
      "transliteration": "tabai sog bhaage ||7||",
      "translation": "All their sufferings ended.7.",
      "punjabiViakhya": "ਤਦੋਂ (ਸਾਰਿਆਂ ਦੇ) ਦੁਖ (ਸੋਗ) ਦੂਰ ਹੋ ਗਏ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "तबै सोग भागे ॥७॥",
      "sourceLineId": "78982",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਿਨੰਤੀ ਸੁਨਾਈ ॥",
      "transliteration": "bina(n)tee sunaiee ||",
      "translation": "They made their supplication,",
      "punjabiViakhya": "(ਦੇਵਤਿਆਂ ਨੇ) ਆਪਣੀ ਵਿਥਿਆ ਸੁਣਾਈ,",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "बिनंती सुनाई ॥",
      "sourceLineId": "78983",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭਵਾਨੀ ਰਿਝਾਈ ॥",
      "transliteration": "bhavaanee rijhaiee ||",
      "translation": "And pleased the goddess",
      "punjabiViakhya": "ਦੇਵੀ ਪ੍ਰਸੰਨ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "भवानी रिझाई ॥",
      "sourceLineId": "78984",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਬੈ ਸਸਤ੍ਰ ਧਾਰੀ ॥",
      "transliteration": "sabai sasatr dhaaree ||",
      "translation": "Who wore all her weapons,",
      "punjabiViakhya": "(ਤਦ ਦੇਵੀ ਨੇ) ਸਾਰੇ ਸ਼ਸਤ੍ਰ ਧਾਰਨ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "सबै ससत्र धारी ॥",
      "sourceLineId": "78985",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਰੀ ਸਿੰਘ ਸੁਆਰੀ ॥੮॥",
      "transliteration": "karee si(n)gh suaaree ||8||",
      "translation": "And mounted the lion.8.",
      "punjabiViakhya": "ਅਤੇ ਸ਼ੇਰ ਉਤੇ ਸਵਾਰ ਹੋ ਗਈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "करी सिंघ सुआरी ॥८॥",
      "sourceLineId": "78986",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਰੇ ਘੰਟ ਨਾਦੰ ॥",
      "transliteration": "kare gha(n)T naadha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਘੰਟਿਆਂ ਨੂੰ ਵਜਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "करे घंट नादं ॥",
      "sourceLineId": "78987",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਧੁਨੰ ਨਿਰਬਿਖਾਦੰ ॥",
      "transliteration": "dhuna(n) nirabikhaadha(n) ||",
      "translation": "The songs resounded without interruption",
      "punjabiViakhya": "ਜਿਨ੍ਹਾ ਵਿਚੋਂ ਲਗਾਤਾਰ ਧੁਨੀ ਨਿਕਲਣ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "धुनं निरबिखादं ॥",
      "sourceLineId": "78988",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੁਨੋ ਦਈਤ ਰਾਜੰ ॥",
      "transliteration": "suno dhieet raaja(n) ||",
      "translation": "The sounds was heard by the demon-king,",
      "punjabiViakhya": "(ਉਸ ਧੁਨੀ ਨੂੰ) ਦੈਂਤ-ਰਾਜ (ਮਹਿਖਾਸੁਰ) ਨੇ ਸੁਣਦਿਆਂ ਹੀ",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "सुनो दईत राजं ॥",
      "sourceLineId": "78989",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਜਿਯੋ ਜੁਧ ਸਾਜੰ ॥੯॥",
      "transliteration": "sajiyo judh saaja(n) ||9||",
      "translation": "Who made preparations for the war.9.",
      "punjabiViakhya": "ਯੁੱਧ ਦੀ ਤਿਆਰੀ ਕਰ ਲਈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "सजियो जुध साजं ॥९॥",
      "sourceLineId": "78990",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚੜਿਯੋ ਰਾਛਸੇਸੰ ॥",
      "transliteration": "chaRiyo raachhasesa(n) ||",
      "translation": "The demon-king marched forward",
      "punjabiViakhya": "ਰਾਖਸ਼ਾ ਦੇ ਰਾਜੇ (ਮਹਿਖਾਸੁਰ) ਨੇ ਚੜ੍ਹਾਈ ਕਰ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "चड़ियो राछसेसं ॥",
      "sourceLineId": "78991",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਚੇ ਚਾਰ ਅਨੇਸੰ ॥",
      "transliteration": "rache chaar anesa(n) ||",
      "translation": "And appointed four generals",
      "punjabiViakhya": "ਅਤੇ (ਆਪਣੀ ਫ਼ੌਜ ਦੇ) ਚਾਰ ਸੈਨਾਪਤੀ (ਅਨੇ) ਬਣਾ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "रचे चार अनेसं ॥",
      "sourceLineId": "78992",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਲੀ ਚਾਮਰੇਵੰ ॥",
      "transliteration": "balee chaamareva(n) ||",
      "translation": "One was Chamar, the second was Chichhur,",
      "punjabiViakhya": "(ਜਿੰਨ੍ਹਾ ਵਿਚੋਂ ਇਕ) ਬਲੀ ਚਾਮਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "बली चामरेवं ॥",
      "sourceLineId": "78993",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹਠੀ ਚਿਛੁਰੇਵੰ ॥੧੦॥",
      "transliteration": "haThee chichhureva(n) ||10||",
      "translation": "Both brave and persistent.10.",
      "punjabiViakhya": "(ਦੂਜਾ) ਹਠੀ ਚਿਛੁਰ ਸੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "हठी चिछुरेवं ॥१०॥",
      "sourceLineId": "78994",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਿੜਾਲਛ ਬੀਰੰ ॥",
      "transliteration": "biRaalachh beera(n) ||",
      "translation": "The third was the brave biralachh,",
      "punjabiViakhya": "ਅਤੇ (ਤੀਜਾ) ਬਹਾਦਰ ਬਿੜਾਲਛ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "बिड़ालछ बीरं ॥",
      "sourceLineId": "78995",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚੜੇ ਬੀਰ ਧੀਰੰ ॥",
      "transliteration": "chaRe beer dheera(n) ||",
      "translation": "They were all mighty warriors and most tenacious.",
      "punjabiViakhya": "(ਉਨ੍ਹਾ) ਬੜੇ ਧੀਰਜਵਾਨ ਯੋਧਿਆਂ ਨੇ ਚੜ੍ਹਾਈ ਕੀਤੀ;",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "चड़े बीर धीरं ॥",
      "sourceLineId": "78996",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬੜੇ ਇਖੁ ਧਾਰੀ ॥",
      "transliteration": "baRe ikh dhaaree ||",
      "translation": "They were great archers",
      "punjabiViakhya": "(ਉਹ) ਬਹੁਤ ਵੱਡੇ ਧਨੁਸ਼ਧਾਰੀ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "बड़े इखु धारी ॥",
      "sourceLineId": "78997",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਘਟਾ ਜਾਨ ਕਾਰੀ ॥੧੧॥",
      "transliteration": "ghaTaa jaan kaaree ||11||",
      "translation": "And marched forward like dark clouds.11.",
      "punjabiViakhya": "(ਅਤੇ ਉਨ੍ਹਾ ਦੀ ਸੈਨਾ ਇਸ ਤਰ੍ਹਾ ਚੜ੍ਹੀ ਸੀ) ਮਾਨੋ ਕਾਲੀਆਂ ਘਟਾਵਾ ਚੜ੍ਹੀਆਂ ਹੋਣ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "घटा जान कारी ॥११॥",
      "sourceLineId": "78998",
      "sourceShabadId": "7674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "78999",
      "sourceShabadId": "7675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਾਣਿ ਜਿਤੇ ਰਾਛਸਨਿ ਮਿਲਿ ਛਾਡਤ ਭਏ ਅਪਾਰ ॥",
      "transliteration": "baan jite raachhasan mil chhaaddat bhe apaar ||",
      "translation": "The arrows showered by all the demons together in great numbers,",
      "punjabiViakhya": "ਰਾਖਸ਼ਾ ਨੇ ਇਕੱਠੇ ਹੋ ਕੇ ਜਿਤਨੇ ਵੀ ਅਣਗਿਣਤ ਬਾਣ ਛਡੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "बाणि जिते राछसनि मिलि छाडत भए अपार ॥",
      "sourceLineId": "79000",
      "sourceShabadId": "7675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਫੂਲਮਾਲ ਹੁਐ ਮਾਤ ਉਰਿ ਸੋਭੇ ਸਭੇ ਸੁਧਾਰ ॥੧੨॥",
      "transliteration": "foolamaal huaai maat ur sobhe sabhe sudhaar ||12||",
      "translation": "Became a garland the neck of the goddess (the universal mother), bedecking it.12.",
      "punjabiViakhya": "ਉਹ ਸਾਰੇ ਦੁਰਗਾ ਦੇ ਗਲੇ (ਉਰ) ਵਿਚ ਫੁਲਾ ਦੀ ਮਾਲਾ ਬਣ ਕੇ ਸੋਭ ਰਹੇ ਸਨ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "फूलमाल हुऐ मात उरि सोभे सभे सुधार ॥१२॥",
      "sourceLineId": "79001",
      "sourceShabadId": "7675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "79002",
      "sourceShabadId": "7676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਿਤੇ ਦਾਨਵੌ ਬਾਨ ਪਾਨੀ ਚਲਾਏ ॥",
      "transliteration": "jite dhaanavau baan paanee chalaae ||",
      "translation": "All the shafts shot by the demons with their hands,",
      "punjabiViakhya": "ਜਿਤਨੇ ਵੀ ਬਾਣ ਦਾਨਵਾ ਨੇ ਆਪਣੇ ਹੱਥਾ ਨਾਲ ਚਲਾਏ,",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "जिते दानवौ बान पानी चलाए ॥",
      "sourceLineId": "79003",
      "sourceShabadId": "7676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਿਤੇ ਦੇਵਤਾ ਆਪਿ ਕਾਟੇ ਬਚਾਏ ॥",
      "transliteration": "tite dhevataa aap kaaTe bachaae ||",
      "translation": "Were intercepted by the goddess to protect herself.",
      "punjabiViakhya": "ਉਤਨੇ ਹੀ ਦੇਵੀ ਨੇ ਕਟ ਕੇ ਆਪਣੇ ਆਪ ਨੂੰ ਬਚਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "तिते देवता आपि काटे बचाए ॥",
      "sourceLineId": "79004",
      "sourceShabadId": "7676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਿਤੇ ਢਾਲ ਢਾਹੇ ਕਿਤੇ ਪਾਸ ਪੇਲੇ ॥",
      "transliteration": "kite ddaal ddaahe kite paas pele ||",
      "translation": "Many were thrown on the ground with her shield and many were entrapped within the baited trap.",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ (ਦੈਂਤਾ) ਨੂੰ ਢਾਲ ਮਾਰ ਕੇ ਢਾਹ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "किते ढाल ढाहे किते पास पेले ॥",
      "sourceLineId": "79005",
      "sourceShabadId": "7676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭਰੇ ਬਸਤ੍ਰ ਲੋਹੂ ਜਨੋ ਫਾਗ ਖੇਲੈ ॥੧੩॥",
      "transliteration": "bhare basatr lohoo jano faag khelai ||13||",
      "translation": "The clothes saturated with blood created an illusion of Holi.13.",
      "punjabiViakhya": "ਅਤੇ ਕਿਤਨਿਆਂ ਨੂੰ ਪਾਸ਼ (ਫੰਧੇ) ਵਿਚ ਫਸਾ ਲਿਆ। (ਉਨ੍ਹਾ ਦੇ) ਬਸਤ੍ਰ ਲਹੂ ਨਾਲ ਲਿਬੜੇ ਹੋਏ ਸਨ ਮਾਨੋ ਹੋਲੀ ਖੇਡ ਰਹੇ ਹੋਣ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "भरे बसत्र लोहू जनो फाग खेलै ॥१३॥",
      "sourceLineId": "79006",
      "sourceShabadId": "7676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦ੍ਰੁਗਾ ਹੂੰ ਕੀਯੰ ਖੇਤ ਧੁੰਕੇ ਨਗਾਰੇ ॥",
      "transliteration": "dhrugaa hoo(n) keeya(n) khet dhu(n)ke nagaare ||",
      "translation": "The trumpets sounded and Durga began to wage war.",
      "punjabiViakhya": "ਦੁਰਗਾ ਨੇ ਰਣ ਮੰਡਿਆ ਅਤੇ ਨਗਾਰੇ ਵਜੇ।",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "द्रुगा हूँ कीयं खेत धुँके नगारे ॥",
      "sourceLineId": "79007",
      "sourceShabadId": "7676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਰੰ ਪਟਿਸੰ ਪਰਿਘ ਪਾਸੀ ਸੰਭਾਰੇ ॥",
      "transliteration": "kara(n) paTisa(n) parigh paasee sa(n)bhaare ||",
      "translation": "She had pattas, axes and baits in her hands",
      "punjabiViakhya": "ਉਸ ਨੇ ਹੱਥਾ ਵਿਚ ਪਟਾ, ਕੁਹਾੜਾ ('ਪਰਿਘ') ਅਤੇ ਫੰਧਾ ('ਪਾਸੀ') ਆਦਿ ਫੜੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "करं पटिसं परिघ पासी संभारे ॥",
      "sourceLineId": "79008",
      "sourceShabadId": "7676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਹਾ ਗੋਫਨੈ ਗੁਰਜ ਗੋਲੇ ਸੰਭਾਰੈ ॥",
      "transliteration": "tahaa gofanai guraj gole sa(n)bhaarai ||",
      "translation": "She caught of pellet bow, mace and pellets.",
      "punjabiViakhya": "(ਦੈਂਤ ਸੂਰਬੀਰਾ ਨੇ) ਹੱਥ ਵਿਚ ਕਮੰਦਾ ('ਗੋਫਨੈ') ਗੁਰਜ ਤੇ ਗੋਲੇ ਆਦਿ ਧਾਰਨ ਕਰ ਕੇ-",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "तहा गोफनै गुरज गोले संभारै ॥",
      "sourceLineId": "79009",
      "sourceShabadId": "7676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਹਠੀ ਮਾਰ ਹੀ ਮਾਰ ਕੈ ਕੈ ਪੁਕਾਰੈ ॥੧੪॥",
      "transliteration": "haThee maar hee maar kai kai pukaarai ||14||",
      "translation": "The persistent warriors were shouting “Kill, Kill”.14.",
      "punjabiViakhya": "ਉਥੇ ਹਠੀ 'ਮਾਰੋ-ਮਾਰੋ' ਪੁਕਾਰਨਾ ਸ਼ੁਰੂ ਕਰ ਦਿੱਤਾ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "हठी मार ही मार कै कै पुकारै ॥१४॥",
      "sourceLineId": "79010",
      "sourceShabadId": "7676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਬੇ ਅਸਟ ਹਾਥੰ ਹਥਿਯਾਰੰ ਸੰਭਾਰੇ ॥",
      "transliteration": "tabe asaT haatha(n) hathiyaara(n) sa(n)bhaare ||",
      "translation": "The goddess held eight weapons in her eitht hands,",
      "punjabiViakhya": "ਤਦੋਂ ਅੱਠ ਭੁਜਾਵਾ ਵਾਲੀ (ਦੇਵੀ ਨੇ) ਅੱਠਾ ਹੱਥਾ ਵਿਚ ਹਥਿਆਰ ਫੜ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "तबे असट हाथं हथियारं संभारे ॥",
      "sourceLineId": "79011",
      "sourceShabadId": "7676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਿਰੰ ਦਾਨਵੇਾਂਦ੍ਰਾਨ ਕੇ ਤਾਕਿ ਝਾਰੇ ॥",
      "transliteration": "sira(n) dhaanaveaa(n)dhraan ke taak jhaare ||",
      "translation": "And hit them on the heads of chief demons.",
      "punjabiViakhya": "ਅਤੇ ਦਾਨਵਾ ਦੇ ਮੁਖੀਆਂ ਦੇ ਸਿਰਾ ਨੂੰ ਨਿਸ਼ਾਣਾ ਬਣਾ ਕੇ ਚਲਾ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "सिरं दानवेाँद्रान के ताकि झारे ॥",
      "sourceLineId": "79012",
      "sourceShabadId": "7676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਬਕਿਯੋ ਬਲੀ ਸਿੰਘ ਜੁਧੰ ਮਝਾਰੰ ॥",
      "transliteration": "babakiyo balee si(n)gh judha(n) majhaara(n) ||",
      "translation": "The demon-king rored like a lion in the battlefield,",
      "punjabiViakhya": "ਉੱਧਰ ਯੁੱਧ ਵਿਚ ਬਲਵਾਨ ਸ਼ੇਰ ਭਬਕਣ ਲਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "बबकियो बली सिंघ जुधं मझारं ॥",
      "sourceLineId": "79013",
      "sourceShabadId": "7676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਰੇ ਖੰਡ ਖੰਡੰ ਸੁ ਜੋਧਾ ਅਪਾਰੰ ॥੧੫॥",
      "transliteration": "kare kha(n)dd kha(n)dda(n) su jodhaa apaara(n) ||15||",
      "translation": "And chopped into bits, many great warriors.15.",
      "punjabiViakhya": "ਅਤੇ ਅਣਗਿਣਤ ਯੋਧਿਆਂ ਨੂੰ ਟੋਟੇ ਟੋਟੇ ਕਰ ਦਿੱਤਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "करे खंड खंडं सु जोधा अपारं ॥१५॥",
      "sourceLineId": "79014",
      "sourceShabadId": "7676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤੋਟਕ ਛੰਦ ॥",
      "transliteration": "toTak chha(n)dh ||",
      "translation": "TOTAK STANZA",
      "punjabiViakhya": "ਤੋਟਕ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "तोटक छंद ॥",
      "sourceLineId": "79015",
      "sourceShabadId": "7677",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਬ ਦਾਨਵ ਰੋਸ ਭਰੇ ਸਬ ਹੀ ॥",
      "transliteration": "tab dhaanav ros bhare sab hee ||",
      "translation": "All the demons were filled with anger,",
      "punjabiViakhya": "ਜਦੋਂ ਦੁਰਗਾ ਦੇ ਬਾਣ (ਉਨ੍ਹਾ ਦੈਂਤਾ ਨੂੰ) ਲਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "तब दानव रोस भरे सब ही ॥",
      "sourceLineId": "79016",
      "sourceShabadId": "7677",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਗ ਮਾਤ ਕੇ ਬਾਣ ਲਗੈ ਜਬ ਹੀ ॥",
      "transliteration": "jag maat ke baan lagai jab hee ||",
      "translation": "When the were pierced by the arrows of the Mother of the worls.",
      "punjabiViakhya": "ਤਦੋਂ ਸਾਰੇ ਦਾਨਵ ਗੁੱਸੇ ਨਾਲ ਭਰ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "जग मात के बाण लगै जब ही ॥",
      "sourceLineId": "79017",
      "sourceShabadId": "7677",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0101_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਿਬਿਧਾਯੁਧ ਲੈ ਸੁ ਬਲੀ ਹਰਖੇ ॥",
      "transliteration": "bibidhaayudh lai su balee harakhe ||",
      "translation": "Those brave warriors caught hold of their weapons with pleasure,",
      "punjabiViakhya": "ਅਨੇਕ ਪ੍ਰਕਾਰ ਦੇ ਸ਼ਸਤ੍ਰ ਲੈ ਕੇ ਬਹਾਦਰ (ਦੈਂਤ) ਪ੍ਰਸੰਨ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 101,
      "hindi": "",
      "hindiTransliteration": "बिबिधायुध लै सु बली हरखे ॥",
      "sourceLineId": "79018",
      "sourceShabadId": "7677",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
