{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 104,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0104_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਛੀਨ ਲਯੋ ਅਲਕੇਸ ਭੰਡਾਰਾ ॥",
      "transliteration": "chheen layo alakes bha(n)ddaaraa ||",
      "translation": "They snatched the treasure of Kuber",
      "punjabiViakhya": "(ਜਿਨ੍ਹਾ ਨੇ) ਕੁਬੇਰ ('ਅਲਕੇਸ') ਦਾ ਖ਼ਜ਼ਾਨਾ ਖੋਹ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "छीन लयो अलकेस भंडारा ॥",
      "sourceLineId": "79139",
      "sourceShabadId": "7686",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੇਸ ਦੇਸ ਕੇ ਜੀਤਿ ਨ੍ਰਿਪਾਰਾ ॥",
      "transliteration": "dhes dhes ke jeet nirapaaraa ||",
      "translation": "And conquered the kings of various countries.",
      "punjabiViakhya": "ਅਤੇ ਦੇਸ-ਦੇਸਾਤਰਾ ਦੇ ਰਾਜੇ ਜਿਤ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "देस देस के जीति नृपारा ॥",
      "sourceLineId": "79140",
      "sourceShabadId": "7686",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਹਾ ਤਹਾ ਕਰ ਦੈਤ ਪਠਾਏ ॥",
      "transliteration": "jahaa tahaa kar dhait paThaae ||",
      "translation": "Wherever they sent their forces",
      "punjabiViakhya": "(ਉਨ੍ਹਾ ਨੇ) ਜਿਥੇ ਕਿਥੇ ਦੈਂਤਾ ਨੂੰ ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "जहा तहा कर दैत पठाए ॥",
      "sourceLineId": "79141",
      "sourceShabadId": "7686",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦੇਸ ਬਿਦੇਸ ਜੀਤੇ ਫਿਰ ਆਏ ॥੭॥੪੫॥",
      "transliteration": "dhes bidhes jeete fir aae ||7||45||",
      "translation": "They returned after conquering many countries.7.45.",
      "punjabiViakhya": "ਜੋ ਦੇਸਾ-ਵਿਦੇਸਾ ਨੂੰ ਜਿਤ ਕੇ ਪਰਤ ਆਏ ॥੭॥੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "देस बिदेस जीते फिर आए ॥७॥४५॥",
      "sourceLineId": "79142",
      "sourceShabadId": "7686",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "79143",
      "sourceShabadId": "7687",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਦੇਵ ਸਬੈ ਤ੍ਰਾਸਤਿ ਭਏ ਮਨ ਮੋ ਕੀਯੋ ਬਿਚਾਰ ॥",
      "transliteration": "dhev sabai traasat bhe man mo keeyo bichaar ||",
      "translation": "All the gods were filled with fear and thought in their mind",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਦੇਵਤਿਆਂ ਨੇ ਭੈ-ਭੀਤ ਹੋ ਕੇ ਮਨ ਵਿਚ ਵਿਚਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "देव सबै त्रासति भए मन मो कीयो बिचार ॥",
      "sourceLineId": "79144",
      "sourceShabadId": "7687",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਰਨ ਭਵਾਨੀ ਕੀ ਸਬੈ ਭਾਜਿ ਪਰੇ ਨਿਰਧਾਰ ॥੮॥੪੬॥",
      "transliteration": "saran bhavaanee kee sabai bhaaj pare niradhaar ||8||46||",
      "translation": "Being helpless, they all ran to come under the refuge of the goddess.8.46.",
      "punjabiViakhya": "(ਆਖਿਰ) ਸਾਰੇ ਨਿਆਸਰੇ ਹੋ ਕੇ ਭਜ ਕੇ ਦੇਵੀ ਦੀ ਸ਼ਰਨ ਵਿਚ ਜਾ ਪਏ ॥੮॥੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "सरन भवानी की सबै भाजि परे निरधार ॥८॥४६॥",
      "sourceLineId": "79145",
      "sourceShabadId": "7687",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "naraaj chha(n)dh ||",
      "translation": "NARAAJ STANZA",
      "punjabiViakhya": "ਨਰਾਜ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "नराज छंद ॥",
      "sourceLineId": "79146",
      "sourceShabadId": "7688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੁ ਤ੍ਰਾਸ ਦੇਵ ਭਾਜੀਅੰ ॥",
      "transliteration": "s traas dhev bhaajeea(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤੇ ਡਰ ਨਾਲ ਭਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "सु त्रास देव भाजीअं ॥",
      "sourceLineId": "79147",
      "sourceShabadId": "7688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਸੇਖ ਲਾਜ ਲਾਜੀਅੰ ॥",
      "transliteration": "basekh laaj laajeea(n) ||",
      "translation": "The gods ran in great fear and felt ashamed with particular self-abasment.",
      "punjabiViakhya": "ਵਿਸ਼ੇਸ਼ ਰੂਪ ਵਿਚ ਲਜਿਤ ਹੋ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "बसेख लाज लाजीअं ॥",
      "sourceLineId": "79148",
      "sourceShabadId": "7688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਿਸਿਖ ਕਾਰਮੰ ਕਸੇ ॥",
      "transliteration": "bisikh kaarama(n) kase ||",
      "translation": "",
      "punjabiViakhya": "ਜ਼ਹਿਰੀਲੇ ਤੀਰਾ ('ਬਿਸਿਖ') ਅਤੇ ਕਮਾਨਾ ('ਕਾਰਮੰ') ਨੂੰ ਕਸੇ ਹੋਇਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "बिसिख कारमं कसे ॥",
      "sourceLineId": "79149",
      "sourceShabadId": "7688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੁ ਦੇਵਿ ਲੋਕ ਮੋ ਬਸੇ ॥੯॥੪੭॥",
      "transliteration": "s dhev lok mo base ||9||47||",
      "translation": "They had fitted poisonous shafts in their bows and in this way they went ot reside in the city of goddess.9.47.",
      "punjabiViakhya": "ਦੇਵੀ ਦੇ ਲੋਕ ਵਿਚ ਜਾ ਵਸੇ ਸਨ ॥੯॥੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "सु देवि लोक मो बसे ॥९॥४७॥",
      "sourceLineId": "79150",
      "sourceShabadId": "7688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਬੈ ਪ੍ਰਕੋਪ ਦੇਬਿ ਹੁਐ ॥",
      "transliteration": "tabai prakop dheb huaai ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਦੇਵੀ ਬਹੁਤ ਕ੍ਰੋਧਵਾਨ ਹੋਈ",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "तबै प्रकोप देबि हुऐ ॥",
      "sourceLineId": "79151",
      "sourceShabadId": "7688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚਲੀ ਸੁ ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਲੈ ॥",
      "transliteration": "chalee su sasatr asatr lai ||",
      "translation": "Then the goddess was filled with great rage and marched towards the battlefield with her weapons and arms.",
      "punjabiViakhya": "ਅਤੇ ਅਸਤ੍ਰ-ਸ਼ਸਤ੍ਰ ਲੈ ਕੇ (ਯੁੱਧ ਲਈ) ਚਲ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "चली सु ससत्र असत्र लै ॥",
      "sourceLineId": "79152",
      "sourceShabadId": "7688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੁ ਮੁਦ ਪਾਨਿ ਪਾਨ ਕੈ ॥",
      "transliteration": "s mudh paan paan kai ||",
      "translation": "",
      "punjabiViakhya": "ਖੁਸ਼ੀ ਨਾਲ ਮਦਿਰਾ ('ਪਾਨਿ') ਨੂੰ ਪੀ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "सु मुद पानि पान कै ॥",
      "sourceLineId": "79153",
      "sourceShabadId": "7688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗਜੀ ਕ੍ਰਿਪਾਨ ਪਾਨਿ ਲੈ ॥੧੦॥੪੮॥",
      "transliteration": "gajee kirapaan paan lai ||10||48||",
      "translation": "She drank the nectar in ther delight and roared wihile taking the sword in her hand.10.48.",
      "punjabiViakhya": "ਅਤੇ ਹੱਥ ਵਿਚ ਕ੍ਰਿਪਾਨ ਲੈ ਕੇ ਗਰਜੀ ॥੧੦॥੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "गजी कृपान पानि लै ॥१०॥४८॥",
      "sourceLineId": "79154",
      "sourceShabadId": "7688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "79155",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੁਨੀ ਦੇਵ ਬਾਨੀ ॥",
      "transliteration": "sunee dhev baanee ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤਿਆਂ ਦੀ ਗੱਲ ਸੁਣ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "सुनी देव बानी ॥",
      "sourceLineId": "79156",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚੜੀ ਸਿੰਘ ਰਾਨੀ ॥",
      "transliteration": "chaRee si(n)gh raanee ||",
      "translation": "Listening to the talk of the gods, the queen (goddess) munted the lion.",
      "punjabiViakhya": "ਦੇਵੀ ਸ਼ੇਰ ਉਤੇ ਸਵਾਰ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "चड़ी सिंघ रानी ॥",
      "sourceLineId": "79157",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੁਭੰ ਸਸਤ੍ਰ ਧਾਰੇ ॥",
      "transliteration": "subha(n) sasatr dhaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਹਰ ਤਰ੍ਹਾ ਨਾਲ) ਸ਼ੁਭ ਸ਼ਸਤ੍ਰਾ ਨੂੰ ਧਾਰਨ ਕਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "सुभं ससत्र धारे ॥",
      "sourceLineId": "79158",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਭੇ ਪਾਪ ਟਾਰੇ ॥੧੧॥੪੯॥",
      "transliteration": "sabhe paap Taare ||11||49||",
      "translation": "She had worn all her auspicious weapons and she is the one who effaces all the sins.11.49.",
      "punjabiViakhya": "ਜੋ ਸਭ ਤਰ੍ਹਾ ਦੇ ਪਾਪਾ ਨੂੰ ਮਿਟਾਉਣ ਵਾਲੇ ਸਨ ॥੧੧॥੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "सभे पाप टारे ॥११॥४९॥",
      "sourceLineId": "79159",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਰੋ ਨਦ ਨਾਦੰ ॥",
      "transliteration": "karo nadh naadha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਦੇਵੀ ਨੇ ਹੁਕਮ ਦੇ ਕੇ) ਵਡੇ ਨਗਾਰਿਆਂ ਤੋਂ ਨਾਦ ਕਰਵਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "करो नद नादं ॥",
      "sourceLineId": "79160",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਹਾ ਮਦ ਮਾਦੰ ॥",
      "transliteration": "mahaa madh maadha(n) ||",
      "translation": "The goddess commanded that highly inebriating trumpets besounded.",
      "punjabiViakhya": "ਜੋ ਬਹੁਤ ਮਦ-ਮਸਤ ਕਰ ਦੇਣ ਵਾਲਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "महा मद मादं ॥",
      "sourceLineId": "79161",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭਯੋ ਸੰਖ ਸੋਰੰ ॥",
      "transliteration": "bhayo sa(n)kh sora(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਵੇਲੇ) ਸੰਖਾ ਦਾ ਸ਼ੋਰ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "भयो संख सोरं ॥",
      "sourceLineId": "79162",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੁਣਿਯੋ ਚਾਰ ਓਰੰ ॥੧੨॥੫੦॥",
      "transliteration": "suniyo chaar ora(n) ||12||50||",
      "translation": "Then the conches created great noise, which was heard. In all the four directions.12.50.",
      "punjabiViakhya": "ਜੋ ਚੌਹਾ ਪਾਸੇ ਸੁਣਿਆਂ ਗਿਆ ॥੧੨॥੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "सुणियो चार ओरं ॥१२॥५०॥",
      "sourceLineId": "79163",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਉਤੇ ਦੈਤ ਧਾਏ ॥",
      "transliteration": "aute dhait dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਉਧਰੋਂ ਬਹੁਤ ਵਡੀ ਸੈਨਾ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "उते दैत धाए ॥",
      "sourceLineId": "79164",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਡੀ ਸੈਨ ਲਿਆਏ ॥",
      "transliteration": "baddee sain liaae ||",
      "translation": "The demons marched forward and brought great forces.",
      "punjabiViakhya": "ਦੈਂਤ ਅਗੇ ਵਧੇ।",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "बडी सैन लिआए ॥",
      "sourceLineId": "79165",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮੁਖੰ ਰਕਤ ਨੈਣੰ ॥",
      "transliteration": "mukha(n) rakat naina(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਲਾਲ ਅੱਖਾ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "मुखं रकत नैणं ॥",
      "sourceLineId": "79166",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਕੇ ਬੰਕ ਬੈਣੰ ॥੧੩॥੫੧॥",
      "transliteration": "bake ba(n)k baina(n) ||13||51||",
      "translation": "Their faces and eyes were red like blood and they shouted prickig words.13.51.",
      "punjabiViakhya": "ਮੂੰਹੋਂ ਚੁਭਵੇਾਂ ਬੋਲ ਬੋਲਣ ਲਗੇ ॥੧੩॥੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "बके बंक बैणं ॥१३॥५१॥",
      "sourceLineId": "79167",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚਵੰ ਚਾਰ ਢੂਕੇ ॥",
      "transliteration": "chava(n) chaar ddooke ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ (ਫੌਜਾ) ਨੇੜੇ ਹੋਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "चवं चार ढूके ॥",
      "sourceLineId": "79168",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮੁਖੰ ਮਾਰੁ ਕੂਕੇ ॥",
      "transliteration": "mukha(n) maar kooke ||",
      "translation": "Four types of forces rushed and shouted from their mouths: “Kill, Kill”.",
      "punjabiViakhya": "ਅਤੇ (ਸੂਰਬੀਰ) ਮੂੰਹੋਂ ਮਾਰੋ-ਮਾਰੋ ਬੋਲਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "मुखं मारु कूके ॥",
      "sourceLineId": "79169",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਲਏ ਬਾਣ ਪਾਣੰ ॥",
      "transliteration": "le baan paana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਹਾ ਨੇ ਹੱਥ ਵਿਚ ਤੀਰ,",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "लए बाण पाणं ॥",
      "sourceLineId": "79170",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੁ ਕਾਤੀ ਕ੍ਰਿਪਾਣੰ ॥੧੪॥੫੨॥",
      "transliteration": "s kaatee kirapaana(n) ||14||52||",
      "translation": "They took up in their hands the arrows, daggers and swords.14.52.",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਅਤੇ ਛੁਰੀਆਂ ਲਈਆਂ ਹੋਈਆਂ ਸਨ ॥੧੪॥੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "सु काती कृपाणं ॥१४॥५२॥",
      "sourceLineId": "79171",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮੰਡੇ ਮਧ ਜੰਗੰ ॥",
      "transliteration": "ma(n)dde madh ja(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਜੰਗ ਵਿਚ ਜੁਟ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "मंडे मध जंगं ॥",
      "sourceLineId": "79172",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪ੍ਰਹਾਰੰ ਖਤੰਗੰ ॥",
      "transliteration": "prahaara(n) khata(n)ga(n) ||",
      "translation": "They are all active in warfare and shoot arrows.",
      "punjabiViakhya": "ਤੀਰਾ ਦੀ ਬਰਖਾ ਕਰਨ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "प्रहारं खतंगं ॥",
      "sourceLineId": "79173",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਰਉਤੀ ਕਟਾਰੰ ॥",
      "transliteration": "karautee kaTaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਾ ('ਕਰਉਤੀ') ਕਟਾਰਾ ਆਦਿ ਸ਼ਸਤ੍ਰਾ (ਦੇ ਵਜਣ ਨਾਲ)",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "करउती कटारं ॥",
      "sourceLineId": "79174",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਉਠੀ ਸਸਤ੍ਰ ਝਾਰੰ ॥੧੫॥੫੩॥",
      "transliteration": "auThee sasatr jhaara(n) ||15||53||",
      "translation": "The weapons like swods and daggers glisten.15.53.",
      "punjabiViakhya": "ਫੁਲਝੜੀਆਂ ਉਠਣ ਲਗੀਆਂ ॥੧੫॥੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "उठी ससत्र झारं ॥१५॥५३॥",
      "sourceLineId": "79175",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਹਾ ਬੀਰ ਢਾਏ ॥",
      "transliteration": "mahaa beer ddaae ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਬਲਵਾਨ ਅਗੇ ਵਧੇ।",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "महा बीर ढाए ॥",
      "sourceLineId": "79176",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਰੋਘੰ ਚਲਾਏ ॥",
      "transliteration": "sarogha(n) chalaae ||",
      "translation": "The great heroes rushed forward and many on them shot arrows.",
      "punjabiViakhya": "ਬਹੁਤ ਅਧਿਕ ਤੀਰ ਚਲਾਉਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "सरोघं चलाए ॥",
      "sourceLineId": "79177",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਰੈ ਬਾਰਿ ਬੈਰੀ ॥",
      "transliteration": "karai baar bairee ||",
      "translation": "",
      "punjabiViakhya": "ਵੈਰੀ ਉਤੇ (ਇਸ ਤਰ੍ਹਾ ਤੀਬਰਤਾ ਨਾਲ) ਵਾਰ ਕਰਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "करै बारि बैरी ॥",
      "sourceLineId": "79178",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਫਿਰੇ ਜ੍ਯੋ ਗੰਗੈਰੀ ॥੧੬॥੫੪॥",
      "transliteration": "fire jayo ga(n)gairee ||16||54||",
      "translation": "They strike blows on the enemy with much swiftness like the watter-bird.16.54.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਜਲ-ਭੌਰਾ ('ਗੰਗੈਰੀ') (ਜਲ ਵਿਚ ਤੇਜ਼ੀ ਨਾਲ) ਫਿਰਦਾ ਹੈ ॥੧੬॥੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "फिरे ज्यो गंगैरी ॥१६॥५४॥",
      "sourceLineId": "79179",
      "sourceShabadId": "7689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "79180",
      "sourceShabadId": "7690",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਉਧਿਤ ਸਟਾਯੰ ਉਤੈ ਸਿੰਘ ਧਾਯੋ ॥",
      "transliteration": "audhit saTaaya(n) utai si(n)gh dhaayo ||",
      "translation": "With elevated tail and full of rage the lion ran forward.",
      "punjabiViakhya": "ਉਧਰ ਵਾਲਾ ਦੇ ਗੁਛੇ ਵਾਲੀ ਪੂੰਛ ਉੱਚੀ ਕਰ ਕੇ ਸ਼ੇਰ ਅਗੇ ਵਧਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "उधित सटायं उतै सिंघ धायो ॥",
      "sourceLineId": "79181",
      "sourceShabadId": "7690",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇਤੇ ਸੰਖ ਲੈ ਹਾਥਿ ਦੇਵੀ ਬਜਾਯੋ ॥",
      "transliteration": "eite sa(n)kh lai haath dhevee bajaayo ||",
      "translation": "There the goddess holding the conch in her hand, blew it.",
      "punjabiViakhya": "ਇਧਰ ਦੇਵੀ ਨੇ ਹੱਥ ਵਿਚ ਸੰਖ ਲੈ ਕੇ ਵਜਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "इते संख लै हाथि देवी बजायो ॥",
      "sourceLineId": "79182",
      "sourceShabadId": "7690",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪੁਰੀ ਚਉਦਹੂੰਯੰ ਰਹਿਯੋ ਨਾਦ ਪੂਰੰ ॥",
      "transliteration": "puree chaudhahoo(n)ya(n) rahiyo naadh poora(n) ||",
      "translation": "Its sound reverberated in all the fourteen regions.",
      "punjabiViakhya": "(ਜਿਸ ਦੀ) ਧੁਨੀ ਚੌਦਾ ਲੋਕਾ ਵਿਚ ਗੂੰਜਣ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "पुरी चउदहूँयं रहियो नाद पूरं ॥",
      "sourceLineId": "79183",
      "sourceShabadId": "7690",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚਮਕਿਯੋ ਮੁਖੰ ਜੁਧ ਕੇ ਮਧਿ ਨੂਰੰ ॥੧੭॥੫੫॥",
      "transliteration": "chamakiyo mukha(n) judh ke madh noora(n) ||17||55||",
      "translation": "The face of the goddess was filled with brightness in the battlefield.17.55.",
      "punjabiViakhya": "(ਅਤੇ ਦੇਵੀ ਦੇ) ਮੁਖ ਵਿਚਲਾ ਨੂਰ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਚਮਕਣ ਲਗਾ ॥੧੭॥੫੫॥",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "चमकियो मुखं जुध के मधि नूरं ॥१७॥५५॥",
      "sourceLineId": "79184",
      "sourceShabadId": "7690",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਬੈ ਧੂਮ੍ਰ ਨੈਣੰ ਮਚਿਯੋ ਸਸਤ੍ਰ ਧਾਰੀ ॥",
      "transliteration": "tabai dhoomr naina(n) machiyo sasatr dhaaree ||",
      "translation": "Then Dhumar Nain, the weapon-wielder, was greatly excited.",
      "punjabiViakhya": "ਤਦੋਂ ਧੂਮ੍ਰ ਨੈਣ ਸ਼ਸਤ੍ਰ ਧਾਰ ਕੇ (ਯੁੱਧ ਲਈ) ਅਗੇ ਵਧਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "तबै धूम्र नैणं मचियो ससत्र धारी ॥",
      "sourceLineId": "79185",
      "sourceShabadId": "7690",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0104_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਲਏ ਸੰਗ ਜੋਧਾ ਬਡੇ ਬੀਰ ਭਾਰੀ ॥",
      "transliteration": "le sa(n)g jodhaa badde beer bhaaree ||",
      "translation": "He took many brave warriors with him.",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਆਪਣੇ ਨਾਲ ਵੱਡੇ ਯੋਧੇ ਲਏ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 104,
      "hindi": "",
      "hindiTransliteration": "लए संग जोधा बडे बीर भारी ॥",
      "sourceLineId": "79186",
      "sourceShabadId": "7690",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
