{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 107,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0107_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪਰੀ ਕੁਟ ਕੁਟੰ ਲਗੇ ਧੀਰ ਧਕੇ ॥",
      "transliteration": "paree kuT kuTa(n) lage dheer dhake ||",
      "translation": "There is a great rush of blows and the men of endurance are experiencing shocks.",
      "punjabiViakhya": "ਕਰਕੁਟ ਮੱਚੀ ਹੋਈ ਹੈ ਅਤੇ ਧੀਰਜਵਾਨ (ਯੋਧਿਆਂ ਨੂੰ ਵੀ) ਧੱਕੇ ਵਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "परी कुट कुटं लगे धीर धके ॥",
      "sourceLineId": "79307",
      "sourceShabadId": "7699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚਵੀ ਚਾਵਡੀਯੰ ਨਫੀਰੰ ਰਣੰਕੰ ॥",
      "transliteration": "chavee chaavaddeeya(n) nafeera(n) rana(n)ka(n) ||",
      "translation": "The vultures shriek and the clarionets are being played.",
      "punjabiViakhya": "ਇਲਾ ਬੋਲ ਰਹੀਆਂ ਹਨ ਅਤੇ ਤੂਤੀਆਂ ਵਜ ਰਹੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "चवी चावडीयं नफीरं रणंकं ॥",
      "sourceLineId": "79308",
      "sourceShabadId": "7699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਨੋ ਬਿਚਰੰ ਬਾਘ ਬੰਕੇ ਬਬਕੰ ॥੮॥੮੫॥",
      "transliteration": "mano bichara(n) baagh ba(n)ke babaka(n) ||8||85||",
      "translation": "It appears that terrible tigers are roaring and roaming.8.85.",
      "punjabiViakhya": "ਮਾਨੋ ਭਿਆਨਕ (ਬੰਕੇ) ਸ਼ੇਰ ਭਬਕਦੇ ਹੋਏ ਵਿਚਰ ਰਹੇ ਹੋਣ ॥੮॥੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "मनो बिचरं बाघ बंके बबकं ॥८॥८५॥",
      "sourceLineId": "79309",
      "sourceShabadId": "7699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਉਤੇ ਕੋਪੀਯੰ ਸ੍ਰੋਣਬਿੰਦੰ ਸੁ ਬੀਰੰ ॥",
      "transliteration": "aute kopeeya(n) sronabi(n)dha(n) su beera(n) ||",
      "translation": "On the other side the demon warrior Rkat Beej was infuriated.",
      "punjabiViakhya": "ਇਧਰੋਂ ਸੂਰਬੀਰ ਰਕਤਬੀਜ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "उते कोपीयं स्रोणबिंदं सु बीरं ॥",
      "sourceLineId": "79310",
      "sourceShabadId": "7699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪ੍ਰਹਾਰੇ ਭਲੀ ਭਾਤਿ ਸੋ ਆਨਿ ਤੀਰੰ ॥",
      "transliteration": "prahaare bhalee bhaat so aan teera(n) ||",
      "translation": "He shot his arrows very dexterously.",
      "punjabiViakhya": "ਅਤੇ ਤੀਰਾ ਦਾ ਚੰਗੀ ਤਰ੍ਹਾ ਹਮਲਾ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "प्रहारे भली भाति सो आनि तीरं ॥",
      "sourceLineId": "79311",
      "sourceShabadId": "7699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਉਤੇ ਦਉਰ ਦੇਵੀ ਕਰਿਯੋ ਖਗ ਪਾਤੰ ॥",
      "transliteration": "aute dhaur dhevee kariyo khag paata(n) ||",
      "translation": "The goddess then speedily struck her sword.",
      "punjabiViakhya": "ਉਧਰੋਂ ਦੇਵੀ ਨੇ ਭਜ ਕੇ ਤਲਵਾਰ ਦਾ ਵਾਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "उते दउर देवी करियो खग पातं ॥",
      "sourceLineId": "79312",
      "sourceShabadId": "7699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗਰਿਯੋ ਮੂਰਛਾ ਹੁਐ ਭਯੋ ਜਾਨੁ ਘਾਤੰ ॥੯॥੮੬॥",
      "transliteration": "gariyo moorachhaa huaai bhayo jaan ghaata(n) ||9||86||",
      "translation": "Which cused the demon to fall senseless, it seemed that he has passed away.9.86.",
      "punjabiViakhya": "ਕਿ (ਦੈਂਤ) ਮੂਰਛਿਤ ਹੋ ਕੇ ਡਿਗ ਪਿਆ, ਮਾਨੋ ਮਰ ਗਿਆ ਹੋਵੇ ॥੯॥੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "गरियो मूरछा हुऐ भयो जानु घातं ॥९॥८६॥",
      "sourceLineId": "79313",
      "sourceShabadId": "7699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਛੁਟੀ ਮੂਰਛਨਾਯੰ ਮਹਾਬੀਰ ਗਜਿਯੋ ॥",
      "transliteration": "chhuTee moorachhanaaya(n) mahaabeer gajiyo ||",
      "translation": "When he came to senses, the mighty hero roared.",
      "punjabiViakhya": "ਜਦੋਂ (ਉਸ ਦੀ) ਮੂਰਛਨਾ ਟੁਟੀ ਤਾ ਮਹਾਵੀਰ (ਦੈਂਤ) ਗੱਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "छुटी मूरछनायं महाबीर गजियो ॥",
      "sourceLineId": "79314",
      "sourceShabadId": "7699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਘਰੀ ਚਾਰ ਲਉ ਸਾਰ ਸੋ ਸਾਰ ਬਜਿਯੋ ॥",
      "transliteration": "gharee chaar lau saar so saar bajiyo ||",
      "translation": "For four gharis, the steel clasged with steel.",
      "punjabiViakhya": "ਅਤੇ ਚਾਰ ਘੜੀਆਂ ਤਕ ਲੋਹੇ ਨਾਲ ਲੋਹਾ ਖੜਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "घरी चार लउ सार सो सार बजियो ॥",
      "sourceLineId": "79315",
      "sourceShabadId": "7699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਲਗੇ ਬਾਣ ਸ੍ਰੋਣੰ ਗਿਰਿਯੋ ਭੂਮਿ ਜੁਧੇ ॥",
      "transliteration": "lage baan srona(n) giriyo bhoom judhe ||",
      "translation": "With the infliction of the arrow of the goddess, the blood of Rakat Beej began to fall on the ground.",
      "punjabiViakhya": "ਬਾਣ ਲਗਣ ਨਾਲ ਯੁੱਧ-ਭੂਮੀ (ਵਿਚ ਰਕਤਬੀਜ ਦਾ ਜਿਤਨਾ) ਲਹੂ ਡਿਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "लगे बाण स्रोणं गिरियो भूमि जुधे ॥",
      "sourceLineId": "79316",
      "sourceShabadId": "7699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਉਠੇ ਬੀਰ ਤੇਤੇ ਕੀਏ ਨਾਦ ਕ੍ਰੁਧੰ ॥੧੦॥੮੭॥",
      "transliteration": "auThe beer tete ke'ee naadh krudha(n) ||10||87||",
      "translation": "With innumerable drops of blood arose innumerable Rakat Beejas, who began to shout with rage.10.87",
      "punjabiViakhya": "ਉਤਨੇ ਹੀ (ਹੋਰ) ਵੀਰ-ਯੋਧਾ ਪੈਦਾ ਹੋ ਗਏ ਅਤੇ ਕ੍ਰੋਧ ਨਾਲ ਲਲਕਾਰਨ ਲਗ ਗਏ ॥੧੦॥੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "उठे बीर तेते कीए नाद क्रुधं ॥१०॥८७॥",
      "sourceLineId": "79317",
      "sourceShabadId": "7699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਉਠੇ ਬੀਰ ਜੇਤੇ ਤਿਤੇ ਕਾਲ ਕੂਟੇ ॥",
      "transliteration": "auThe beer jete tite kaal kooTe ||",
      "translation": "All the warriors who arose, were destroyed by Kali.",
      "punjabiViakhya": "ਜਿਤਨੇ ਵੀਰ-ਯੋਧੇ (ਉਸ ਵੇਲੇ ਲਹੂ ਦੀਆਂ ਬੂੰਦਾ ਤੋਂ) ਪੈਦਾ ਹੋਏ, ਉਤਨੇ ਹੀ ਕਾਲੀ ਨੇ ਮਾਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "उठे बीर जेते तिते काल कूटे ॥",
      "sourceLineId": "79318",
      "sourceShabadId": "7699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪਰੇ ਚਰਮ ਬਰਮੰ ਕਹੂੰ ਗਾਤ ਟੂਟੇ ॥",
      "transliteration": "pare charam barama(n) kahoo(n) gaat TooTe ||",
      "translation": "Somewhere their shields, armour and wounded bodies are lying scattered",
      "punjabiViakhya": "(ਯੁੱਧ-ਭੂਮੀ ਵਿਚ) ਕਿਤੇ ਢਾਲਾ, ਕਵਚ ਅਤੇ ਕਿਤੇ ਕਟੇ ਹੋਏ ਸ਼ਰੀਰ ਪਏ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "परे चरम बरमं कहूँ गात टूटे ॥",
      "sourceLineId": "79319",
      "sourceShabadId": "7699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਿਤੀ ਭੂਮਿ ਮਧੰ ਪਰੀ ਸ੍ਰੋਣ ਧਾਰੰ ॥",
      "transliteration": "jitee bhoom madha(n) paree sron dhaara(n) ||",
      "translation": "With all the drops of blood that fall on the ground.",
      "punjabiViakhya": "ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਜਿਤਨੀਆਂ ਵੀ ਲਹੂ ਦੀਆਂ ਬੂੰਦਾ ਡਿਗਦੀਆਂ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "जिती भूमि मधं परी स्रोण धारं ॥",
      "sourceLineId": "79320",
      "sourceShabadId": "7699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਗੇ ਸੂਰ ਤੇਤੇ ਕੀਏ ਮਾਰ ਮਾਰੰ ॥੧੧॥੮੮॥",
      "transliteration": "jage soor tete ke'ee maar maara(n) ||11||88||",
      "translation": "The same number of warriors arise shouting “kill, kill”. 11.88.",
      "punjabiViakhya": "ਉਤਨੇ ਹੀ (ਉਨ੍ਹਾ ਵਿਚੋਂ ਹੋਰ ਰਕਤਬੀਜ) ਸੂਰਮੇ ਪੈਦਾ ਹੋ ਕੇ ਮਾਰੋ-ਮਾਰੋ ਪੁਕਾਰਦੇ ਸਨ ॥੧੧॥੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "जगे सूर तेते कीए मार मारं ॥११॥८८॥",
      "sourceLineId": "79321",
      "sourceShabadId": "7699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪਰੀ ਕੁਟ ਕੁਟੰ ਰੁਲੇ ਤਛ ਮੁਛੰ ॥",
      "transliteration": "paree kuT kuTa(n) rule tachh muchha(n) ||",
      "translation": "There were struck blows after blows and the warriors being chopped are rolling in dust.",
      "punjabiViakhya": "ਖੂਬ ਮਾਰ-ਕੁਟ ਹੋਈ ਹੈ, (ਸੂਰਵੀਰ) ਟੋਟੇ ਟੋਟੇ ਹੋ ਕੇ ਡਿਗੇ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "परी कुट कुटं रुले तछ मुछं ॥",
      "sourceLineId": "79322",
      "sourceShabadId": "7699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਹੂੰ ਮੁੰਡ ਤੁੰਡੰ ਕਹੂੰ ਮਾਸੁ ਮੁਛੰ ॥",
      "transliteration": "kahoo(n) mu(n)dd tu(n)dda(n) kahoo(n) maas muchha(n) ||",
      "translation": "Their heads, faces and pieces of flesh are lying scattered.",
      "punjabiViakhya": "ਕਿਤੇ ਸਿਰ, ਕਿਤੇ ਮੂੰਹ ਅਤੇ ਕਿਤੇ ਮਾਸ ਦੇ ਲੋਥੜੇ ਰੁਲ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "कहूँ मुँड तुँडं कहूँ मासु मुछं ॥",
      "sourceLineId": "79323",
      "sourceShabadId": "7699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਭਯੋ ਚਾਰ ਸੈ ਕੋਸ ਲਉ ਬੀਰ ਖੇਤੰ ॥",
      "transliteration": "bhayo chaar sai kos lau beer kheta(n) ||",
      "translation": "For four hundred kos, the battlefield was occupied by warriors.",
      "punjabiViakhya": "ਚਾਰ ਸੌ ਕੋਹਾ ਤਕ ਯੁੱਧ-ਭੂਮੀ ਪਸਰ ਗਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "भयो चार सै कोस लउ बीर खेतं ॥",
      "sourceLineId": "79324",
      "sourceShabadId": "7699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਿਦਾਰੇ ਪਰੇ ਬੀਰ ਬ੍ਰਿੰਦ੍ਰੰ ਬਿਚੇਤੰ ॥੧੨॥੮੯॥",
      "transliteration": "bidhaare pare beer bira(n)dhra(n) bicheta(n) ||12||89||",
      "translation": "Most of whom are lying dead or senseless.12.89.",
      "punjabiViakhya": "(ਜਿਸ ਵਿਚ) ਬਹੁਤ ਸਾਰੇ ਸੂਰਮੇ ਅਚੇਤ ('ਬਿਦਾਰੇ') ਅਤੇ ਬੇਸੁਰਤ ਪਏ ਹ ਨਾ ॥੧੨॥੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "बिदारे परे बीर बृंद्रं बिचेतं ॥१२॥८९॥",
      "sourceLineId": "79325",
      "sourceShabadId": "7699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "79326",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚਹੂੰ ਓਰ ਢੂਕੇ ॥",
      "transliteration": "chahoo(n) or ddooke ||",
      "translation": "",
      "punjabiViakhya": "(ਵੀਰ ਯੋਧੇ) ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ ਢੁਕ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "चहूँ ओर ढूके ॥",
      "sourceLineId": "79327",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮੁਖੰ ਮਾਰੁ ਕੂਕੇ ॥",
      "transliteration": "mukha(n) maar kooke ||",
      "translation": "",
      "punjabiViakhya": "ਮੂੰਹੋਂ ਮਾਰੋ-ਮਾਰੋ ਕੂਕਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "मुखं मारु कूके ॥",
      "sourceLineId": "79328",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਝੰਡਾ ਗਡ ਗਾਢੇ ॥",
      "transliteration": "jha(n)ddaa gadd gaadde ||",
      "translation": "",
      "punjabiViakhya": "ਪੱਕੀ ਤਰ੍ਹਾ ਝੰਡੇ ਗਡੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "झंडा गड गाढे ॥",
      "sourceLineId": "79329",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮਚੇ ਰੋਸ ਬਾਢੇ ॥੧੩॥੯੦॥",
      "transliteration": "mache ros baadde ||13||90||",
      "translation": "They have fixed firmly their banners and in excitement their rage is increasing.13.90.",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਵਧਾ ਕੇ (ਯੁੱਧ ਵਿਚ) ਗਹਿ-ਗਚ ਹਨ ॥੧੩॥੯੦॥",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "मचे रोस बाढे ॥१३॥९०॥",
      "sourceLineId": "79330",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭਰੇ ਬੀਰ ਹਰਖੰ ॥",
      "transliteration": "bhare beer harakha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਬੀਰ ਖੁਸ਼ੀ ਨਾਲ ਭਰੇ ਹੋਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "भरे बीर हरखं ॥",
      "sourceLineId": "79331",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਰੀ ਬਾਣ ਬਰਖੰ ॥",
      "transliteration": "karee baan barakha(n) ||",
      "translation": "The warriors filled with delight are showering their arrows.",
      "punjabiViakhya": "ਅਤੇ ਤੀਰਾ ਦੀ ਬਰਖਾ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "करी बाण बरखं ॥",
      "sourceLineId": "79332",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚਵੰ ਚਾਰ ਢੁਕੇ ॥",
      "transliteration": "chava(n) chaar dduke ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ (ਪਾਸਿਆਂ ਤੋਂ) ਚਾਰ ਪ੍ਰਕਾਰ ਦੀ ਸੈਨਾ ਢੁਕ ਰਹੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "चवं चार ढुके ॥",
      "sourceLineId": "79333",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪਛੇ ਆਹੁ ਰੁਕੇ ॥੧੪॥੯੧॥",
      "transliteration": "pachhe aahu ruke ||14||91||",
      "translation": "All the four types of forces are moving forward and staying in their arens.14.91.",
      "punjabiViakhya": "ਅਤੇ (ਆਪਣੇ ਆਪਣੇ) ਪੱਖਾ ਵਿਚ ਹੀ ਰੁਕੀ ਹੋਈ ਹੈ ॥੧੪॥੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "पछे आहु रुके ॥१४॥९१॥",
      "sourceLineId": "79334",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪਰੀ ਸਸਤ੍ਰ ਝਾਰੰ ॥",
      "transliteration": "paree sasatr jhaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰਾ ਦੀ (ਖੂਬ) ਝਾੜ ਪਈ,",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "परी ससत्र झारं ॥",
      "sourceLineId": "79335",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚਲੀ ਸ੍ਰੋਣ ਧਾਰੰ ॥",
      "transliteration": "chalee sron dhaara(n) ||",
      "translation": "With the use of all the weapons, the stream of blood began to flow.",
      "punjabiViakhya": "(ਫਲਸਰੂਪ) ਲਹੂ ਦੀ ਨਦੀ ਵਗ ਚਲੀ।",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "चली स्रोण धारं ॥",
      "sourceLineId": "79336",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਉਠੇ ਬੀਰ ਮਾਨੀ ॥",
      "transliteration": "auThe beer maanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਭਿਮਾਨੀ ਵੀਰ-ਸੈਨਿਕ ਉਠ ਖੜੋਤੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "उठे बीर मानी ॥",
      "sourceLineId": "79337",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਧਰੇ ਬਾਨ ਹਾਨੀ ॥੧੫॥੯੨॥",
      "transliteration": "dhare baan haanee ||15||92||",
      "translation": "The most honoured warriors arose with bow and arrows in their hands.15.92.",
      "punjabiViakhya": "(ਜਿਨ੍ਹਾ ਨੇ ਆਪਣੇ) ਹੱਥ ਬਾਣਾ ਉਤੇ ਧਰੇ ਹੋਏ ਹਨ ॥੧੫॥੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "धरे बान हानी ॥१५॥९२॥",
      "sourceLineId": "79338",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਹਾ ਰੋਸਿ ਗਜੇ ॥",
      "transliteration": "mahaa ros gaje ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬਹੁਤ ਕ੍ਰੋਧ ਨਾਲ ਗੱਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "महा रोसि गजे ॥",
      "sourceLineId": "79339",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤੁਰੀ ਨਾਦ ਬਜੇ ॥",
      "transliteration": "turee naadh baje ||",
      "translation": "They are raaring in great anger, and the clarionets and drums are being played.",
      "punjabiViakhya": "ਤੁਰੀਆਂ ਅਤੇ ਧੌਂਸੇ ਵਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "तुरी नाद बजे ॥",
      "sourceLineId": "79340",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭਏ ਰੋਸ ਭਾਰੀ ॥",
      "transliteration": "bhe ros bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਤਿ-ਅਧਿਕ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "भए रोस भारी ॥",
      "sourceLineId": "79341",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮਚੇ ਛਤ੍ਰਧਾਰੀ ॥੧੬॥੯੩॥",
      "transliteration": "mache chhatradhaaree ||16||93||",
      "translation": "Filled with great fury, the wielders of canopies are much excited.16.93.",
      "punjabiViakhya": "(ਵੱਡੇ) ਛਤ੍ਰਧਾਰੀ (ਯੁੱਧ-ਕਾਰਜ ਵਿਚ) ਮਗਨ ਹਨ ॥੧੬॥੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "मचे छत्रधारी ॥१६॥९३॥",
      "sourceLineId": "79342",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਹਕੰ ਹਾਕ ਬਜੀ ॥",
      "transliteration": "haka(n) haak bajee ||",
      "translation": "",
      "punjabiViakhya": "ਲਲਕਾਰੇ ਤੇ ਲਲਕਾਰਾ ਮਾਰਿਆ ਜਾ ਰਿਹਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "हकं हाक बजी ॥",
      "sourceLineId": "79343",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਫਿਰੈ ਸੈਣ ਭਜੀ ॥",
      "transliteration": "firai sain bhajee ||",
      "translation": "There are shouts after shouts and the forces are running hither and thither.",
      "punjabiViakhya": "ਸੈਨਾ (ਯੁੱਧ-ਭੂਮੀ ਵਿਚ) ਭਜੀ ਫਿਰਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "फिरै सैण भजी ॥",
      "sourceLineId": "79344",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪਰਿਯੋ ਲੋਹ ਕ੍ਰੋਹੰ ॥",
      "transliteration": "pariyo loh kroha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਪੂਰਵਕ ਲੋਹੇ ਨਾਲ ਲੋਹਾ ਖੜਕ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "परियो लोह क्रोहं ॥",
      "sourceLineId": "79345",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਛਕੇ ਸੂਰ ਸੋਹੰ ॥੧੭॥੯੪॥",
      "transliteration": "chhake soor soha(n) ||17||94||",
      "translation": "With great ire, the steel is being used, and the inebriated warriors look glorious.17.94.",
      "punjabiViakhya": "ਯੋਧੇ (ਯੁੱਧ ਵਿਚ) ਮਤੇ ਹੋਏ ਸੋਭ ਰਹੇ ਹਨ ॥੧੭॥੯੪॥",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "छके सूर सोहं ॥१७॥९४॥",
      "sourceLineId": "79346",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗਿਰੇ ਅੰਗ ਭੰਗੰ ॥",
      "transliteration": "gire a(n)g bha(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਟੁਟੇ ਹੋਏ ਅੰਗ ਡਿਗੇ ਪਏ (ਇੰਜ) ਲਗਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "गिरे अंग भंगं ॥",
      "sourceLineId": "79347",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦਵੰ ਜਾਨੁ ਦੰਗੰ ॥",
      "transliteration": "dhava(n) jaan dha(n)ga(n) ||",
      "translation": "The warriors with chopped limbs have fallen and the red blood appears like flaming fire.",
      "punjabiViakhya": "ਮਾਨੋ ਅੰਗਾਰੇ ਦਗ ਦਗ ਕਰ ਰਹੇ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "दवं जानु दंगं ॥",
      "sourceLineId": "79348",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕੜੰਕਾਰ ਛੁਟੇ ॥",
      "transliteration": "kaRa(n)kaar chhuTe ||",
      "translation": "",
      "punjabiViakhya": "ਕਾੜ ਕਾੜ ਕਰਦੇ ਤੀਰ ਛੁਟਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "कड़ंकार छुटे ॥",
      "sourceLineId": "79349",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਝਣੰਕਾਰ ਉਠੇ ॥੧੮॥੯੫॥",
      "transliteration": "jhana(n)kaar uThe ||18||95||",
      "translation": "The jingling and the twanging sounds of weapons are being heard.18.95.",
      "punjabiViakhya": "ਅਤੇ ਝਣਕਾਰ ਪੈਦਾ ਹੁੰਦੀ ਹੈ ॥੧੮॥੯੫॥",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "झणंकार उठे ॥१८॥९५॥",
      "sourceLineId": "79350",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਟਾ ਕਟ ਬਾਹੇ ॥",
      "transliteration": "kaTaa kaT baahe ||",
      "translation": "",
      "punjabiViakhya": "ਕਟਾਕਟ (ਸ਼ਸਤ੍ਰ) ਚਲ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "कटा कट बाहे ॥",
      "sourceLineId": "79351",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਉਭੈ ਜੀਤ ਚਾਹੈ ॥",
      "transliteration": "aubhai jeet chaahai ||",
      "translation": "The weapons are being struck with clinking sound and both sides wan their victory.",
      "punjabiViakhya": "ਅਤੇ ਦੋਹਾ ਪਾਸਿਆਂ ਤੋਂ (ਵੀਰ-ਯੋਧੇ ਆਪਣੀ) ਜਿਤ ਦੇ ਚਾਹਵਾਨ (ਬਣੇ ਹੋਏ) ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "उभै जीत चाहै ॥",
      "sourceLineId": "79352",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮਹਾ ਮਦ ਮਾਤੇ ॥",
      "transliteration": "mahaa madh maate ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬਹੁਤ ਮਦ-ਮਸਤ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "महा मद माते ॥",
      "sourceLineId": "79353",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0107_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਪੇ ਤੇਜ ਤਾਤੇ ॥੧੯॥੯੬॥",
      "transliteration": "tape tej taate ||19||96||",
      "translation": "Many are intoxicated with wine and in great fury, they appear highly inflamed.19.96.",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਤੇਜ ਨਾਲ ਬਹੁਤ ਤਪੇ ਹੋਏ ਹਨ ॥੧੯॥੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 107,
      "hindi": "",
      "hindiTransliteration": "तपे तेज ताते ॥१९॥९६॥",
      "sourceLineId": "79354",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
