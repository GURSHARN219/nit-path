{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 108,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0108_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਸੰ ਰੁਦ੍ਰ ਰਾਚੇ ॥",
      "transliteration": "rasa(n) rudhr raache ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਪਾਸਿਆਂ ਤੋਂ ਰੌਦਰ ਰਸ ਵਿਚ ਰਚੇ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "रसं रुद्र राचे ॥",
      "sourceLineId": "79355",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਉਭੈ ਜੁਧ ਮਾਚੇ ॥",
      "transliteration": "aubhai judh maache ||",
      "translation": "They are flushed with rage and are absorbed in waging war.",
      "punjabiViakhya": "ਯੁੱਧ ਕਰ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "उभै जुध माचे ॥",
      "sourceLineId": "79356",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਰੈ ਬਾਣ ਅਰਚਾ ॥",
      "transliteration": "karai baan arachaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬਾਣਾ ਦੀ ਭੇਟਾ ਚੜ੍ਹਾ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "करै बाण अरचा ॥",
      "sourceLineId": "79357",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਧਨੁਰ ਬੇਦ ਚਰਚਾ ॥੨੦॥੯੭॥",
      "transliteration": "dhanur bedh charachaa ||20||97||",
      "translation": "They offer arrows and are discussing archery.20.97.",
      "punjabiViakhya": "ਅਤੇ ਧਨੁਰ-ਵੇਦ ਦੀ ਚਰਚਾ ਹੋ ਰਹੀ ਹੈ ॥੨੦॥੯੭॥",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "धनुर बेद चरचा ॥२०॥९७॥",
      "sourceLineId": "79358",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਚੇ ਬੀਰ ਬੀਰੰ ॥",
      "transliteration": "mache beer beera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਵੀਰਤਾ (ਦਾ ਪ੍ਰਦਰਸ਼ਨ ਕਰਨ ਵਿਚ) ਮਸਤ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "मचे बीर बीरं ॥",
      "sourceLineId": "79359",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਉਠੀ ਝਾਰ ਤੀਰੰ ॥",
      "transliteration": "auThee jhaar teera(n) ||",
      "translation": "The heroes are absorbed in heroic feats and are rainiong the shafts.",
      "punjabiViakhya": "ਅਤੇ ਬਾਣਾ ਦੀ ਝੜੀ ਲਗੀ ਹੋਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "उठी झार तीरं ॥",
      "sourceLineId": "79360",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗਲੋ ਗਡ ਫੋਰੈ ॥",
      "transliteration": "galo gadd forai ||",
      "translation": "",
      "punjabiViakhya": "ਚਕ੍ਰ-ਵਿਯੂਹ ਨੂੰ ਤੋੜਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "गलो गड फोरै ॥",
      "sourceLineId": "79361",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਹੀ ਨੈਨ ਮੋਰੈ ॥੨੧॥੯੮॥",
      "transliteration": "nahee nain morai ||21||98||",
      "translation": "They are penetrating into the warrior-stronghold and do not turn away their eyes from it.21.98.",
      "punjabiViakhya": "(ਅਤੇ ਉਸ ਵੱਲੋਂ) ਅੱਖ ਮੋੜਦੇ ਨਹੀਂ ਹਨ ॥੨੧॥੯੮॥",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "नही नैन मोरै ॥२१॥९८॥",
      "sourceLineId": "79362",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਮੁਹ ਸਸਤ੍ਰ ਬਰਖੇ ॥",
      "transliteration": "samuh sasatr barakhe ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਹਮਣੇ ਹੋ ਕੇ ਸ਼ਸਤ੍ਰ ਚਲਾਉਾਂਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "समुह ससत्र बरखे ॥",
      "sourceLineId": "79363",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਹਿਖੁਆਸੁ ਕਰਖੇ ॥",
      "transliteration": "mahikhuaas karakhe ||",
      "translation": "They are striking their weapons, facing the enemy and are pulling their bow-strings.",
      "punjabiViakhya": "ਅਤੇ ਧਨੁਸ਼ਾ ('ਮਹਿਖੁਆਸ') ਉਤੇ ਚਿੱਲਾ ਚੜ੍ਹਾਉਾਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "महिखुआसु करखे ॥",
      "sourceLineId": "79364",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਰੈ ਤੀਰ ਮਾਰੰ ॥",
      "transliteration": "karai teer maara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰਾ ਦੀ ਮਾਰ ਕਰਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "करै तीर मारं ॥",
      "sourceLineId": "79365",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਹੈ ਲੋਹ ਧਾਰੰ ॥੨੨॥੯੯॥",
      "transliteration": "bahai loh dhaara(n) ||22||99||",
      "translation": "They are showering the arrows and striking the sharp steel-arms.22.99.",
      "punjabiViakhya": "ਅਤੇ ਲਹੂ ਦੀ ਧਾਰਾ ਵਗਦੀ ਹੈ ॥੨੨॥੯੯॥",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "बहै लोह धारं ॥२२॥९९॥",
      "sourceLineId": "79366",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਦੀ ਸ੍ਰੋਣ ਪੂਰੰ ॥",
      "transliteration": "nadhee sron poora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਲਹੂ ਨਾਲ ਨਦੀ ਭਰ ਗਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "नदी स्रोण पूरं ॥",
      "sourceLineId": "79367",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਫਿਰੀ ਗੈਣ ਹੂਰੰ ॥",
      "transliteration": "firee gain hoora(n) ||",
      "translation": "The stream of blood has become full and the houris are roaming in the sky.",
      "punjabiViakhya": "ਆਕਾਸ਼ ਵਿਚ ਹੂਰਾ ਫਿਰ ਰਹੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "फिरी गैण हूरं ॥",
      "sourceLineId": "79368",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗਜੈ ਗੈਣਿ ਕਾਲੀ ॥",
      "transliteration": "gajai gain kaalee ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲੀ ਆਸਮਾਨ ਵਿਚ ਗੱਜ ਰਹੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "गजै गैणि काली ॥",
      "sourceLineId": "79369",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹਸੀ ਖਪਰਾਲੀ ॥੨੩॥੧੦੦॥",
      "transliteration": "hasee khaparaalee ||23||100||",
      "translation": "The goddess Kali is roaring in the firmament and the female demon of the begging bowl is laughing.23.100.",
      "punjabiViakhya": "ਅਤੇ ਖੱਪਰ ਵਾਲੀਆਂ (ਜੋਗਣਾ) ਹਸ ਰਹੀਆਂ ਹਨ ॥੨੩॥੧੦੦॥",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "हसी खपराली ॥२३॥१००॥",
      "sourceLineId": "79370",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਹੂੰ ਬਾਜ ਮਾਰੇ ॥",
      "transliteration": "kahoo(n) baaj maare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਘੋੜੇ ਮੋਏ ਪਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "कहूँ बाज मारे ॥",
      "sourceLineId": "79371",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਹੂੰ ਸੂਰ ਭਾਰੇ ॥",
      "transliteration": "kahoo(n) soor bhaare ||",
      "translation": "Somewhere there are dead horses and somewhere the fallen mighty warriors.",
      "punjabiViakhya": "ਕਿਤੇ ਵਡੇ ਸੂਰਮੇ (ਡਿਗੇ ਪਏ ਹਨ)",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "कहूँ सूर भारे ॥",
      "sourceLineId": "79372",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਹੂੰ ਚਰਮ ਟੂਟੈ ॥",
      "transliteration": "kahoo(n) charam TooTai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਢਾਲਾ ਟੁਟੀਆਂ ਪਈਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "कहूँ चरम टूटै ॥",
      "sourceLineId": "79373",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਫਿਰੇ ਗਜ ਫੂਟੈ ॥੨੪॥੧੦੧॥",
      "transliteration": "fire gaj fooTai ||24||101||",
      "translation": "Somewhere there are broken shields and somewhere the wounded elephants are roaming.24.101.",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਘਾਇਲ ਹਾਥੀ ਫਿਰ ਰਹੇ ਹਨ ॥੨੪॥੧੦੧॥",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "फिरे गज फूटै ॥२४॥१०१॥",
      "sourceLineId": "79374",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਹੂੰ ਬਰਮ ਬੇਧੇ ॥",
      "transliteration": "kahoo(n) baram bedhe ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਕਵਚ ਵਿੰਨ੍ਹੇ (ਪਏ ਹਨ)",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "कहूँ बरम बेधे ॥",
      "sourceLineId": "79375",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਹੂੰ ਚਰਮ ਛੇਦੇ ॥",
      "transliteration": "kahoo(n) charam chhedhe ||",
      "translation": "Somewhere the armour is penetrated and the inflicted skein is being seen.",
      "punjabiViakhya": "ਕਿਤੇ ਢਾਲਾ ਟੁੱਟੀਆਂ ਪਈਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "कहूँ चरम छेदे ॥",
      "sourceLineId": "79376",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਹੂੰ ਪੀਲ ਪਰਮੰ ॥",
      "transliteration": "kahoo(n) peel parama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਵਡੇ ਹਾਥੀ (ਕਟੇ ਪਏ ਹਨ)",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "कहूँ पील परमं ॥",
      "sourceLineId": "79377",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਟੇ ਬਾਜ ਬਰਮੰ ॥੨੫॥੧੦੨॥",
      "transliteration": "kaTe baaj barama(n) ||25||102||",
      "translation": "Somewhere there are chopped elephants and somewhere the saddles of horses are seen cut down.25.102.",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਘੋੜਿਆਂ ਦੇ ਕਵਚ (ਬਰਮੰ) ਕੁਟੇ ਪਏ ਹਨ ॥੨੫॥੧੦੨॥",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "कटे बाज बरमं ॥२५॥१०२॥",
      "sourceLineId": "79378",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਲੀ ਬੈਰ ਰੁਝੇ ॥",
      "transliteration": "balee bair rujhe ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਵੈਰ-ਭਾਵ ਨਾਲ ਰੁਝੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "बली बैर रुझे ॥",
      "sourceLineId": "79379",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਮੁਹਿ ਸਾਰ ਜੁਝੇ ॥",
      "transliteration": "samuh saar jujhe ||",
      "translation": "The brave warriors are engaged in inimical acts, all of them are fightning with their weapons.",
      "punjabiViakhya": "ਸਾਰੇ ਸ਼ਸਤ੍ਰ ਨਾਲ ਝੂਝ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "समुहि सार जुझे ॥",
      "sourceLineId": "79380",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਲਖੇ ਬੀਰ ਖੇਤੰ ॥",
      "transliteration": "lakhe beer kheta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧਿਆਂ ਨੂੰ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "लखे बीर खेतं ॥",
      "sourceLineId": "79381",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਚੇ ਭੂਤ ਪ੍ਰੇਤੰ ॥੨੬॥੧੦੩॥",
      "transliteration": "nache bhoot preta(n) ||26||103||",
      "translation": "Realising the presence of warriors in the battlefield, the ghosts and evil spirits are dancing.26.103.",
      "punjabiViakhya": "ਭੂਤ ਅਤੇ ਪ੍ਰੇਤ ਨਚ ਰਹੇ ਹਨ ॥੨੬॥੧੦੩॥",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "नचे भूत प्रेतं ॥२६॥१०३॥",
      "sourceLineId": "79382",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਚੇ ਮਾਸਹਾਰੀ ॥",
      "transliteration": "nache maasahaaree ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਸਾਹਾਰੀ ਨਚ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "नचे मासहारी ॥",
      "sourceLineId": "79383",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹਸੇ ਬ੍ਰਯੋਮਚਾਰੀ ॥",
      "transliteration": "hase brayomachaaree ||",
      "translation": "The meat-eaters are dancing, those who roam in the sky, are laughing.",
      "punjabiViakhya": "ਆਕਾਸ਼ ਵਿਚ ਵਿਚਰਨ ਵਾਲੇ ਹਸ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "हसे ब्रयोमचारी ॥",
      "sourceLineId": "79384",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਿਲਕ ਕਾਰ ਕੰਕੰ ॥",
      "transliteration": "kilak kaar ka(n)ka(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਾ ('ਕੰਕੰ') ਕਿਲਕਾਰੀਆਂ ਮਾਰਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "किलक कार कंकं ॥",
      "sourceLineId": "79385",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਚੇ ਬੀਰ ਬੰਕੰ ॥੨੭॥੧੦੪॥",
      "transliteration": "mache beer ba(n)ka(n) ||27||104||",
      "translation": "The crows are cawing and the elegant warriors are intoxicated.27.104.",
      "punjabiViakhya": "ਅਤੇ ਬਲਵਾਨ ਯੋਧੇ ਪੂਰੀ ਮਸਤੀ ਨਾਲ (ਯੁੱਧ-ਕਾਰਜ ਵਿਚ) ਮਗਨ ਹਨ ॥੨੭॥੧੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "मचे बीर बंकं ॥२७॥१०४॥",
      "sourceLineId": "79386",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਛੁਭੇ ਛਤ੍ਰਧਾਰੀ ॥",
      "transliteration": "chhubhe chhatradhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਛਤ੍ਰਧਾਰੀ (ਸੈਨਾ-ਨਾਇਕ) ਕ੍ਰੋਧ (ਨਾਲ ਭਰੇ ਹੋਏ ਹਨ)",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "छुभे छत्रधारी ॥",
      "sourceLineId": "79387",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮਹਿਖੁਆਸ ਚਾਰੀ ॥",
      "transliteration": "mahikhuaas chaaree ||",
      "translation": "The wears of canopies are full of fury and from their bows shoot their arrows.",
      "punjabiViakhya": "ਧਨੁਸ਼ਾ ('ਮਹਿਖੁਆਸ') ਵਿਚੋਂ ਤੀਰ ਚਲਾਉਾਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "महिखुआस चारी ॥",
      "sourceLineId": "79388",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਉਠੇ ਛਿਛ ਇਛੰ ॥",
      "transliteration": "auThe chhichh ichha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸ਼ਰੀਰਾ ਵਿਚੋਂ ਲਹੂ ਦੀਆਂ) ਛਿੱਟਾ ਉਠਦੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "उठे छिछ इछं ॥",
      "sourceLineId": "79389",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚਲੇ ਤੀਰ ਤਿਛੰ ॥੨੮॥੧੦੫॥",
      "transliteration": "chale teer tichha(n) ||28||105||",
      "translation": "They are desirous of their victory and thus are shooting their sharp shafts.28.105.",
      "punjabiViakhya": "ਤਿਖੇ ਤੀਰਾ ਦੇ ਲਗਣ ਨਾਲ ॥੨੮॥੧੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "चले तीर तिछं ॥२८॥१०५॥",
      "sourceLineId": "79390",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗਣੰ ਗਾਧ੍ਰਬੇਯੰ ॥",
      "transliteration": "gana(n) gaadhrabeya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਗਣ, ਗੰਧਰਬ, ਦੂਤ",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "गणं गाध्रबेयं ॥",
      "sourceLineId": "79391",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਚਰੰ ਚਾਰਣੇਸੰ ॥",
      "transliteration": "chara(n) chaaranesa(n) ||",
      "translation": "Ganas, Gandharvas, spies, minstrels and the Siddhas with miraculous powers.",
      "punjabiViakhya": "(ਚਰ) ਚਾਰਨ",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "चरं चारणेसं ॥",
      "sourceLineId": "79392",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹਸੇ ਸਿਧ ਸਿਧੰ ॥",
      "transliteration": "hase sidh sidha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਿੱਧੀਆਂ ਵਾਲੇ ਸਿੱਧ ਹਸ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "हसे सिध सिधं ॥",
      "sourceLineId": "79393",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਚੇ ਬੀਰ ਕ੍ਰੁਧੰ ॥੨੯॥੧੦੬॥",
      "transliteration": "mache beer krudha(n) ||29||106||",
      "translation": "All of them laugh and the warriors are inebriatedwith rage.29.106.",
      "punjabiViakhya": "ਅਤੇ ਕ੍ਰੋਧਿਤ ਵੀਰ-ਯੋਧੇ (ਯੁੱਧ ਕਰਮ ਵਿਚ) ਮਗਨ ਹਨ ॥੨੯॥੧੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "मचे बीर क्रुधं ॥२९॥१०६॥",
      "sourceLineId": "79394",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਡਕਾ ਡਕ ਡਾਕੈ ॥",
      "transliteration": "ddakaa ddak ddaakai ||",
      "translation": "",
      "punjabiViakhya": "ਡਾਕਣੀਆਂ ਡਕਾਰ ਰਹੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "डका डक डाकै ॥",
      "sourceLineId": "79395",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਹਕਾ ਹਕ ਹਾਕੈ ॥",
      "transliteration": "hakaa hak haakai ||",
      "translation": "The vampires are belching and the egoist warriors are shouting.",
      "punjabiViakhya": "(ਯੋਧੇ) ਲਲਕਾਰੇ ਤੇ ਲਲਕਾਰਾ ਮਾਰ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "हका हक हाकै ॥",
      "sourceLineId": "79396",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭਕਾ ਭੁੰਕ ਭੇਰੀ ॥",
      "transliteration": "bhakaa bhu(n)k bheree ||",
      "translation": "",
      "punjabiViakhya": "ਭੇਰੀਆਂ ਭਕ-ਭਕ ਦੀ ਧੁਨੀ ਨਾਲ ਵਜ ਰਹੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "भका भुँक भेरी ॥",
      "sourceLineId": "79397",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਡਮਕ ਡਾਕ ਡੇਰੀ ॥੩੦॥੧੦੭॥",
      "transliteration": "ddamak ddaak dderee ||30||107||",
      "translation": "The drums are creating loud sound and there are clanging noises.30.107.",
      "punjabiViakhya": "ਅਤੇ ਡੁਗਡੁਗੀਆਂ ਡਮ-ਡਮ ਦੀ ਆਵਾਜ਼ (ਕਢ ਰਹੀਆਂ ਹਨ) ॥੩੦॥੧੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "डमक डाक डेरी ॥३०॥१०७॥",
      "sourceLineId": "79398",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮਹਾ ਬੀਰ ਗਾਜੇ ॥",
      "transliteration": "mahaa beer gaaje ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਵੀਰ ਗਜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "महा बीर गाजे ॥",
      "sourceLineId": "79399",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਵੰ ਨਾਦ ਬਾਜੇ ॥",
      "transliteration": "nava(n) naadh baaje ||",
      "translation": "The mighty warriors are roaring and the new instruments are being sounded.",
      "punjabiViakhya": "ਨਵੇਾਂ ਨਵੇਾਂ ਨਗਾਰੇ ਵਜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "नवं नाद बाजे ॥",
      "sourceLineId": "79400",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਧਰਾ ਗੋਮ ਗਜੇ ॥",
      "transliteration": "dharaa gom gaje ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਡਫਾ ਗੂੰਜ ਉਠ ਰਹੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "धरा गोम गजे ॥",
      "sourceLineId": "79401",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0108_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦ੍ਰੁਗਾ ਦੈਤ ਬਜੇ ॥੩੧॥੧੦੮॥",
      "transliteration": "dhrugaa dhait baje ||31||108||",
      "translation": "The trumpets are resounding and the forces of Durga and the demons are fighting.31.108.",
      "punjabiViakhya": "ਅਤੇ ਦੁਰਗਾ ਨਾਲ ਦੈਂਤ ਲੜ ਰਹੇ ਹਨ ॥੩੧॥੧੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 108,
      "hindi": "",
      "hindiTransliteration": "द्रुगा दैत बजे ॥३१॥१०८॥",
      "sourceLineId": "79402",
      "sourceShabadId": "7700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
