{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 110,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0110_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਫਟੀ ਨਖ ਸਿੰਘੰ ਮੁਖੰ ਡਢ ਕੋਲੰ ॥",
      "transliteration": "faTee nakh si(n)gha(n) mukha(n) ddadd kola(n) ||",
      "translation": "The earth splitted because of the roar of the lion and the attack of his nails.",
      "punjabiViakhya": "ਸ਼ੇਰ ਦੇ ਨਹੁੰਆਂ ਨਾਲ (ਧਰਤੀ ਇੰਜ) ਫਟ ਗਈ (ਜਿਵੇਾਂ) ਸੂਰ (ਕੋਲੰ) ਨੇ ਆਪਣੇ ਹੁੱਡ ਨਾਲ (ਪੁਟੀ ਹੋਈ ਹੁੰਦੀ ਹੈ)।",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "फटी नख सिंघं मुखं डढ कोलं ॥",
      "sourceLineId": "79475",
      "sourceShabadId": "7707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਡਮਾ ਡੰਮਿ ਡਉਰੂ ਡਕਾ ਡੁੰਕ ਡੰਕੰ ॥",
      "transliteration": "ddamaa dda(n)m ddauroo ddakaa ddu(n)k dda(n)ka(n) ||",
      "translation": "The sound of the trumpets and the tabors is being heard.",
      "punjabiViakhya": "ਡੌਰੂ ਡੰਮ ਡੰਮ ਕਰ ਰਹੇ ਸਨ (ਅਤੇ ਨਗਾਰਿਆਂ ਉਤੇ) ਡੱਗੇ ਡਕ ਡਕ ਕਰ ਕੇ (ਵਜ ਰਹੇ ਸਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "डमा डंमि डउरू डका डुँक डंकं ॥",
      "sourceLineId": "79476",
      "sourceShabadId": "7707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰੜੇ ਗ੍ਰਿਧ ਬ੍ਰਿਧੰ ਕਿਲਕਾਰ ਕੰਕੰ ॥੩॥੧੨੫॥",
      "transliteration": "raRe giradh biradha(n) kilakaar ka(n)ka(n) ||3||125||",
      "translation": "And the huge vultures and crows are shrieking and flying .3.125.",
      "punjabiViakhya": "ਵਡੇ ਆਕਾਰ ਵਾਲੀਆਂ ਗਿਧਾ ਬੋਲ (ਰੜੰ) ਰਹੀਆਂ ਸਨ ਅਤੇ ਕਾ ਕਿਲਕਾਰੀਆਂ ਮਾਰ ਰਹੇ ਸਨ ॥੩॥੧੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "रड़े गृध बृधं किलकार कंकं ॥३॥१२५॥",
      "sourceLineId": "79477",
      "sourceShabadId": "7707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਖੁਰੰ ਖੇਹ ਉਠੀ ਰਹਿਯੋ ਗੈਨ ਪੂਰੰ ॥",
      "transliteration": "khura(n) kheh uThee rahiyo gain poora(n) ||",
      "translation": "The sky is filled with the dust risen by the hooves of the animals.",
      "punjabiViakhya": "(ਘੋੜਿਆਂ ਦੇ) ਖੁਰਾ ਨਾਲ (ਇਤਨੀ) ਗਰਦ ਉਠੀ ਕਿ ਸਾਰਾ ਆਕਾਸ਼ ਭਰ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "खुरं खेह उठी रहियो गैन पूरं ॥",
      "sourceLineId": "79478",
      "sourceShabadId": "7707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦਲੇ ਸਿੰਧੁ ਬਿਧੰ ਭਏ ਪਬ ਚੂਰੰ ॥",
      "transliteration": "dhale si(n)dh bidha(n) bhe pab choora(n) ||",
      "translation": "And these animals have broken into prices Vidhyachal mountain and other small mounts.",
      "punjabiViakhya": "(ਉਨ੍ਹਾ ਦੇ ਪੈਰਾ ਹੇਠਾ) ਸਮੁੰਦਰ ਅਤੇ ਪਰਬਤ ('ਬਿਧੰ') ਦਲੇ ਗਏ ਅਤੇ ਛੋਟੇ ਪਰਬਤ ਚੂਰਨ ਬਣ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "दले सिंधु बिधं भए पब चूरं ॥",
      "sourceLineId": "79479",
      "sourceShabadId": "7707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੁਣੋ ਸੋਰ ਕਾਲੀ ਗਹੈ ਸਸਤ੍ਰ ਪਾਣੰ ॥",
      "transliteration": "suno sor kaalee gahai sasatr paana(n) ||",
      "translation": "The goddess Kali hearing the din, held her weapons in her hands.",
      "punjabiViakhya": "ਕਾਲੀ ਨੇ ਸ਼ੋਰ ਸੁਣਦਿਆਂ ਹੀ ਹੱਥ ਵਿਚ ਸ਼ਸਤ੍ਰ ਧਾਰਨ ਕਰ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "सुणो सोर काली गहै ससत्र पाणं ॥",
      "sourceLineId": "79480",
      "sourceShabadId": "7707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਿਲਕਾਰ ਜੇਮੀ ਹਨੇ ਜੰਗ ਜੁਆਣੰ ॥੪॥੧੨੬॥",
      "transliteration": "kilakaar jemee hane ja(n)g juaana(n) ||4||126||",
      "translation": "While roaring she ate up the limps of the killed youthful warriors.4.126.",
      "punjabiViakhya": "ਅਤੇ ਜੈ ਘੋਸ਼ ('ਜੇਮੀ ਕਿਲਕਾਰ') ਕਰਦੀ ਹੋਈ ਨੇ ਯੁੱਧ ਵਿਚ ਸੂਰਵੀਰਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ॥੪॥੧੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "किलकार जेमी हने जंग जुआणं ॥४॥१२६॥",
      "sourceLineId": "79481",
      "sourceShabadId": "7707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "79482",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗਜੇ ਬੀਰ ਗਾਜੀ ॥",
      "transliteration": "gaje beer gaajee ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਜੈਸ਼ਾਲੀ ਯੋਧੇ ਗਜ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "गजे बीर गाजी ॥",
      "sourceLineId": "79483",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤੁਰੇ ਤੁੰਦ ਤਾਜੀ ॥",
      "transliteration": "ture tu(n)dh taajee ||",
      "translation": "The brave warriors are thundering and the horses are speedily moving.",
      "punjabiViakhya": "ਅਤੇ ਤੇਜ਼ੀ ਨਾਲ ਘੋੜੇ ਦੌੜਾਉਾਂਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "तुरे तुँद ताजी ॥",
      "sourceLineId": "79484",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਹਿਖੁਆਸ ਕਰਖੇ ॥",
      "transliteration": "mahikhuaas karakhe ||",
      "translation": "",
      "punjabiViakhya": "ਧਨੁਸ਼ਾ ('ਮਹਿਖੁਆਸ') ਨੂੰ ਖਿਚ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "महिखुआस करखे ॥",
      "sourceLineId": "79485",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਰੰ ਧਾਰ ਬਰਖੇ ॥੫॥੧੨੭॥",
      "transliteration": "sara(n) dhaar barakhe ||5||127||",
      "translation": "The bows are being pulled and the shafts are raining.5.127.",
      "punjabiViakhya": "ਅਤੇ ਬਾਣਾ ਦੀ ਝੜੀ ਲਗਾ ਰਹੇ ਸਨ ॥੫॥੧੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "सरं धार बरखे ॥५॥१२७॥",
      "sourceLineId": "79486",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਇਤੇ ਸਿੰਘ ਗਜਿਯੋ ॥",
      "transliteration": "eite si(n)gh gajiyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਧਰੋਂ ਸ਼ੇਰ ਗਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "इते सिंघ गजियो ॥",
      "sourceLineId": "79487",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਹਾ ਸੰਖ ਬਜਿਯੋ ॥",
      "transliteration": "mahaa sa(n)kh bajiyo ||",
      "translation": "From this side the lion hath roared and the conch hath been blown.",
      "punjabiViakhya": "(ਮਾਨੋ) ਵੱਡਾ ਸੰਖ ਵਜਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "महा संख बजियो ॥",
      "sourceLineId": "79488",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਹਿਯੋ ਨਾਦ ਪੂਰੰ ॥",
      "transliteration": "rahiyo naadh poora(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ ਗਰਜ ਦੀ) ਧੁਨੀ ਹਰ ਪਾਸੇ ਪਸਰ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "रहियो नाद पूरं ॥",
      "sourceLineId": "79489",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਛੁਹੀ ਗੈਣਿ ਧੂਰੰ ॥੬॥੧੨੮॥",
      "transliteration": "chhuhee gain dhoora(n) ||6||128||",
      "translation": "Its sound is filling the atmosphere. The sky is filled with the dust risen from the battlefield.6.128.",
      "punjabiViakhya": "ਅਤੇ ਧੂੜ ਆਕਾਸ਼ ਤਕ ਪਹੁੰਚ ਗਈ ॥੬॥੧੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "छुही गैणि धूरं ॥६॥१२८॥",
      "sourceLineId": "79490",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਬੈ ਸਸਤ੍ਰ ਸਾਜੇ ॥",
      "transliteration": "sabai sasatr saaje ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਸ਼ਸਤ੍ਰ ਸਜਾਏ ਹੋਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "सबै ससत्र साजे ॥",
      "sourceLineId": "79491",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਘਣੰ ਜੇਮ ਗਾਜੇ ॥",
      "transliteration": "ghana(n) jem gaaje ||",
      "translation": "The warriors have bedecked themselves with weapons and are thundering like clouds.",
      "punjabiViakhya": "ਬਦਲ ਵਾਗ ਗਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "घणं जेम गाजे ॥",
      "sourceLineId": "79492",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚਲੇ ਤੇਜ ਤੈ ਕੈ ॥",
      "transliteration": "chale tej tai kai ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਵੀਰ) ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "चले तेज तै कै ॥",
      "sourceLineId": "79493",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਨੰਤ ਸਸਤ੍ਰ ਲੈ ਕੈ ॥੭॥੧੨੯॥",
      "transliteration": "ana(n)t sasatr lai kai ||7||129||",
      "translation": "They are furiously moving, carrying countless weapons.7.129.",
      "punjabiViakhya": "ਅਤੇ ਅਨੰਤ ਸ਼ਸਤ੍ਰ ਲੈ ਕੇ (ਚਲ ਰਹੇ ਸਨ) ॥੭॥੧੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "अनंत ससत्र लै कै ॥७॥१२९॥",
      "sourceLineId": "79494",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚਹੂੰ ਓਰ ਢੂਕੇ ॥",
      "transliteration": "chahoo(n) or ddooke ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ (ਸੂਰਮੇ) ਆਣ ਢੁੱਕੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "चहूँ ओर ढूके ॥",
      "sourceLineId": "79495",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮੁਖੰ ਮਾਰ ਕੂਕੇ ॥",
      "transliteration": "mukha(n) maar kooke ||",
      "translation": "From all four sides the warriors are closing their ranks, shouting “kill, kill”.",
      "punjabiViakhya": "ਅਤੇ ਮੂੰਹਾ ਤੋਂ 'ਮਾਰੋ' 'ਮਾਰੋ' ਪੁਕਾਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "मुखं मार कूके ॥",
      "sourceLineId": "79496",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਨੰਤ ਸਸਤ੍ਰ ਬਜੇ ॥",
      "transliteration": "ana(n)t sasatr baje ||",
      "translation": "",
      "punjabiViakhya": "ਬੇਹਿਸਾਬੇ ਸ਼ਸਤ੍ਰ ਵਜ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "अनंत ससत्र बजे ॥",
      "sourceLineId": "79497",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮਹਾ ਬੀਰ ਗਜੇ ॥੮॥੧੩੦॥",
      "transliteration": "mahaa beer gaje ||8||130||",
      "translation": "The mighty warriors are thundering and countless weapons are striking blows.8.130.",
      "punjabiViakhya": "ਅਤੇ ਮਹਾਨ ਯੋਧੇ ਗਜ ਰਹੇ ਸਨ ॥੮॥੧੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "महा बीर गजे ॥८॥१३०॥",
      "sourceLineId": "79498",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮੁਖੰ ਨੈਣ ਰਕਤੰ ॥",
      "transliteration": "mukha(n) nain rakata(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਹਾ ਸੂਰਵੀਰਾ ਦੇ) ਮੂੰਹ ਅਤੇ ਅੱਖਾ ਲਾਲ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "मुखं नैण रकतं ॥",
      "sourceLineId": "79499",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਧਰੇ ਪਾਣਿ ਸਕਤੰ ॥",
      "transliteration": "dhare paan sakata(n) ||",
      "translation": "Carrying the powerful weapons in their hands, their faces and eyes are becoming blood-red.",
      "punjabiViakhya": "ਅਤੇ ਹੱਥਾ ਵਿਚ ਬਰਛੇ ('ਸਕਤੰ') ਧਾਰਨ ਕੀਤੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "धरे पाणि सकतं ॥",
      "sourceLineId": "79500",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕੀਏ ਕ੍ਰੋਧ ਉਠੇ ॥",
      "transliteration": "ke'ee krodh uThe ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਕ੍ਰੋਧ ਕਰ ਕੇ ਡਟ ਗਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "कीए क्रोध उठे ॥",
      "sourceLineId": "79501",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਰੰ ਬ੍ਰਿਸਟਿ ਬੁਠੇ ॥੯॥੧੩੧॥",
      "transliteration": "sara(n) birasaT buThe ||9||131||",
      "translation": "In great fury, they are marching and showering their arrows.9.131.",
      "punjabiViakhya": "ਅਤੇ ਤੀਰਾ ਦੀ ਬਰਖਾ ਕਰ ਰਹੇ ਸਨ ॥੯॥੧੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "सरं बृसटि बुठे ॥९॥१३१॥",
      "sourceLineId": "79502",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਿਤੇ ਦੁਸਟ ਕੂਟੇ ॥",
      "transliteration": "kite dhusaT kooTe ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਦੁਸ਼ਟ ਕੁਟੇ ਜਾ ਚੁਕੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "किते दुसट कूटे ॥",
      "sourceLineId": "79503",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਨੰਤਾਸਤ੍ਰ ਛੂਟੇ ॥",
      "transliteration": "ana(n)taasatr chhooTe ||",
      "translation": "Many of the tyrants have been killed and consequently countless weapons are lying scattered hither and thither.",
      "punjabiViakhya": "ਅਤੇ ਅਨੇਕਾ ਅਸਤ੍ਰ ਚਲ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "अनंतासत्र छूटे ॥",
      "sourceLineId": "79504",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਰੀ ਬਾਣ ਬਰਖੰ ॥",
      "transliteration": "karee baan barakha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣਾ ਦੀ ਬਰਖਾ ਕੀਤੀ ਜਾ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "करी बाण बरखं ॥",
      "sourceLineId": "79505",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਰੀ ਦੇਬਿ ਹਰਖੰ ॥੧੦॥੧੩੨॥",
      "transliteration": "bharee dheb harakha(n) ||10||132||",
      "translation": "The goddess hath been pleased and is showering her arrows.10.132.",
      "punjabiViakhya": "ਦੇਵੀ ਆਨੰਦਿਤ ਹੋ ਰਹੀ ਸੀ ॥੧੦॥੧੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "भरी देबि हरखं ॥१०॥१३२॥",
      "sourceLineId": "79506",
      "sourceShabadId": "7708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬੇਲੀ ਬਿੰਦ੍ਰਮ ਛੰਦ ॥",
      "transliteration": "belee bi(n)dhram chha(n)dh ||",
      "translation": "BELI BINDRAM STANZA",
      "punjabiViakhya": "ਬੇਲੀ ਬਿਦ੍ਰਮ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "बेली बिंद्रम छंद ॥",
      "sourceLineId": "79507",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਹ ਕਹ ਸੁ ਕੂਕਤ ਕੰਕੀਯੰ ॥",
      "transliteration": "keh keh su kookat ka(n)keeya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਉਏ ਕਾ ਕਾ ਕਰ ਕੇ ਸ਼ੋਰ ਕਰ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "कह कह सु कूकत कंकीयं ॥",
      "sourceLineId": "79508",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਹਿ ਬਹਤ ਬੀਰ ਸੁ ਬੰਕੀਯੰ ॥",
      "transliteration": "beh bahat beer su ba(n)keeya(n) ||",
      "translation": "The crows are uttering “caw, caw” and the blood of mighty heroes is flowing.",
      "punjabiViakhya": "ਅਤੇ ਬਾਕੇ ਯੋਧੇ ਬਹਿ ਬਹਿ ਕਰਦੇ (ਸ਼ਸਤ੍ਰ) ਵਾਹ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "बहि बहत बीर सु बंकीयं ॥",
      "sourceLineId": "79509",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਲਹ ਲਹਤ ਬਾਣਿ ਕ੍ਰਿਪਾਣਯੰ ॥",
      "transliteration": "leh lahat baan kirapaanaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣ ਅਤੇ ਕ੍ਰਿਪਾਨਾ ਲਹ-ਲਹ ਕਰ ਕੇ (ਚਮਕ ਰਹੀਆਂ ਸਨ)",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "लह लहत बाणि कृपाणयं ॥",
      "sourceLineId": "79510",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗਹ ਗਹਤ ਪ੍ਰੇਤ ਮਸਾਣਯੰ ॥੧੧॥੧੩੩॥",
      "transliteration": "geh gahat pret masaanaya(n) ||11||133||",
      "translation": "The arrows and swords are waving in the wind and the ghosts and evil spirits are catching the dead.11.133.",
      "punjabiViakhya": "ਅਤੇ ਪ੍ਰੇਤ ਮੁਰਦਿਆਂ ('ਮਸਾਣ') ਨੂੰ ਪਕੜ ਪਕੜ ਕੇ ਛਕਦੇ ('ਗਹਤ') ਸਨ ॥੧੧॥੧੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "गह गहत प्रेत मसाणयं ॥११॥१३३॥",
      "sourceLineId": "79511",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਡਹ ਡਹਤ ਡਵਰ ਡਮੰਕਯੰ ॥",
      "transliteration": "ddeh ddahat ddavar ddama(n)kaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਡਹਿ ਡਹਿ ਕਰ ਕੇ ਡਉਰੂ ਡਮਕਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "डह डहत डवर डमंकयं ॥",
      "sourceLineId": "79512",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਲਹ ਲਹਤ ਤੇਗ ਤ੍ਰਮੰਕਯੰ ॥",
      "transliteration": "leh lahat teg trama(n)kaya(n) ||",
      "translation": "The tobors are resounding and the swords are glistening.",
      "punjabiViakhya": "ਅਤੇ ਲਹ ਲਹ ਕਰਕੇ ਤੇਗਾ ਚਮਕਦੀਆਂ ('ਤ੍ਰਮੰਕਯੰ') ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "लह लहत तेग त्रमंकयं ॥",
      "sourceLineId": "79513",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਧ੍ਰਮ ਧ੍ਰਮਤ ਸਾਗ ਧਮੰਕਯੰ ॥",
      "transliteration": "dhram dhramat saag dhama(n)kaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਧ੍ਰਮ ਧ੍ਰਮ ਕਰਕੇ ਬਰਛਿਆਂ ਦੇ ਧਮਾਕੇ ਹੁੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "ध्रम ध्रमत साग धमंकयं ॥",
      "sourceLineId": "79514",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਬਕੰਤ ਬੀਰ ਸੁ ਬੰਕਯੰ ॥੧੨॥੧੩੪॥",
      "transliteration": "babaka(n)t beer su ba(n)kaya(n) ||12||134||",
      "translation": "The sounds of striking daggers and the thundering of the warriors are being heard.12.134.",
      "punjabiViakhya": "ਬਾਕੇ ਸੂਰਵੀਰ ਬੜਕਾ ਮਾਰਦੇ ਸਨ ॥੧੨॥੧੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "बबकंत बीर सु बंकयं ॥१२॥१३४॥",
      "sourceLineId": "79515",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਛੁਟਕੰਤ ਬਾਣ ਕਮਾਣਯੰ ॥",
      "transliteration": "chhuTaka(n)t baan kamaanaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਮਾਨਾ ਵਿਚੋਂ ਛੁਟਦੇ ਬਾਣ",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "छुटकंत बाण कमाणयं ॥",
      "sourceLineId": "79516",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹਰਰੰਤ ਖੇਤ ਖਤ੍ਰਾਣਯੰ ॥",
      "transliteration": "harara(n)t khet khatraanaya(n) ||",
      "translation": "The arrows shot from the bows create surprises in the minds of the warriors.",
      "punjabiViakhya": "ਯੁੱਧ ਵਿਚ ਛਤ੍ਰੀਆਂ ਨੂੰ ਹੈਰਾਨ ਕਰ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "हररंत खेत खत्राणयं ॥",
      "sourceLineId": "79517",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਡਹਕੰਤ ਡਾਮਰ ਡੰਕਣੀ ॥",
      "transliteration": "ddahaka(n)t ddaamar dda(n)kanee ||",
      "translation": "",
      "punjabiViakhya": "ਡਾਕਣੀਆਂ ਡਮਰੂ (ਦੀ ਧੁਨੀ ਸੁਣ ਕੇ) ਡਕਾਰ ਰਹੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "डहकंत डामर डंकणी ॥",
      "sourceLineId": "79518",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਹ ਕਹਕ ਕੂਕਤ ਜੁਗਣੀ ॥੧੩॥੧੩੫॥",
      "transliteration": "keh kahak kookat juganee ||13||135||",
      "translation": "The vampires are fearing from the sound of the labor and the female demons are wandering and laughing.13.135.",
      "punjabiViakhya": "ਅਤੇ ਜੋਗਣਾ ਕਹਿ-ਕਹਿ ਕਰਕੇ ਕੂਕ ਰਹੀਆਂ ਹਨ ॥੧੩॥੧੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "कह कहक कूकत जुगणी ॥१३॥१३५॥",
      "sourceLineId": "79519",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਉਫਟੰਤ ਸ੍ਰੋਣਤ ਛਿਛਯੰ ॥",
      "transliteration": "aufaTa(n)t sronat chhichhaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਲਹੂ ਦੀਆਂ ਛਿਟਾ ਉਠਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "उफटंत स्रोणत छिछयं ॥",
      "sourceLineId": "79520",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਰਖੰਤ ਸਾਇਕ ਤਿਛਯੰ ॥",
      "transliteration": "barakha(n)t saik tichhaya(n) ||",
      "translation": "Because of the rain of sharp arrows, the blood is splashing.",
      "punjabiViakhya": "ਤਿਖੇ ਤੀਰਾ ਦੀ ਬਰਖਾ ਹੁੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "बरखंत साइक तिछयं ॥",
      "sourceLineId": "79521",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0110_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬਬਕੰਤ ਬੀਰ ਅਨੇਕਯੰ ॥",
      "transliteration": "babaka(n)t beer anekaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੇਕਾ ਵੀਰ-ਸੈਨਿਕ ਬੜ੍ਹਕ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 110,
      "hindi": "",
      "hindiTransliteration": "बबकंत बीर अनेकयं ॥",
      "sourceLineId": "79522",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
