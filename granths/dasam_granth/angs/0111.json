{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 111,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0111_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਫਿਕਰੰਤ ਸਿਆਰ ਬਸੇਖਯੰ ॥੧੪॥੧੩੬॥",
      "transliteration": "fikara(n)t siaar basekhaya(n) ||14||136||",
      "translation": "Many warriors are roaring and the jackals, in particular, being pleased, are howling.14.136.",
      "punjabiViakhya": "ਅਤੇ ਗਿਦੜ ਹੁੰਕਾਰ ('ਫਿਕਰੰਤ') ਰਹੇ ਸਨ ॥੧੪॥੧੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "फिकरंत सिआर बसेखयं ॥१४॥१३६॥",
      "sourceLineId": "79523",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਹਰਖੰਤ ਸ੍ਰੋਣਤਿ ਰੰਗਣੀ ॥",
      "transliteration": "harakha(n)t sronat ra(n)ganee ||",
      "translation": "",
      "punjabiViakhya": "ਲਹੂ ਵਿਚ ਰੰਗਣ ਵਾਲੀ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "हरखंत स्रोणति रंगणी ॥",
      "sourceLineId": "79524",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਿਹਰੰਤ ਦੇਬਿ ਅਭੰਗਣੀ ॥",
      "transliteration": "bihara(n)t dheb abha(n)ganee ||",
      "translation": "The immortal Durga, the dyer with blood, is moving, pleased with her task.",
      "punjabiViakhya": "ਅਤੇ ਨਸ਼ਟ ਨਾ ਹੋ ਸਕਣ ਵਾਲੀ ਦੇਵੀ ਪ੍ਰਸੰਨ ਹੋ ਕੇ ਫਿਰ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "बिहरंत देबि अभंगणी ॥",
      "sourceLineId": "79525",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਬਕੰਤ ਕੇਹਰ ਡੋਲਹੀ ॥",
      "transliteration": "babaka(n)t kehar ddolahee ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੇਰ ('ਕੇਹਰ') ਦਹਾੜਦਾ ਹੋਇਆ ਘੁੰਮ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "बबकंत केहर डोलही ॥",
      "sourceLineId": "79526",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰਣਿ ਅਭੰਗ ਕਲੋਲਹੀ ॥੧੫॥੧੩੭॥",
      "transliteration": "ran abha(n)g kalolahee ||15||137||",
      "translation": "The roaring lion is running and such is the continuous situation in the battlefield.15.137.",
      "punjabiViakhya": "ਅਤੇ ਰਣ-ਭੂਮੀ ਵਿਚ ਨਿਰੰਤਰ ਕਲੋਲ ਕਰ ਰਿਹਾ ਸੀ ॥੧੫॥੧੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "रणि अभंग कलोलही ॥१५॥१३७॥",
      "sourceLineId": "79527",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਢਮ ਢਮਤ ਢੋਲ ਢਮਕਯੰ ॥",
      "transliteration": "ddam ddamat ddol ddamakaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲਾ ਦੀ ਢੰਮ ਢੰਮ ਢੰਮਕ ਹੋ ਰਹੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "ढम ढमत ढोल ढमकयं ॥",
      "sourceLineId": "79528",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਧਮ ਧਮਤ ਸਾਗ ਧਮਕਯੰ ॥",
      "transliteration": "dham dhamat saag dhamakaya(n) ||",
      "translation": "The drums are resounding and the daggers are clanking.",
      "punjabiViakhya": "ਬਰਛਿਆਂ ਦੀ ਧੰਮ ਧੰਮ ਦੀ ਧਮਕ ਹੋ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "धम धमत साग धमकयं ॥",
      "sourceLineId": "79529",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਹ ਬਹਤ ਕ੍ਰੁਧ ਕ੍ਰਿਪਾਣਯੰ ॥",
      "transliteration": "beh bahat krudh kirapaanaya(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਵੀਰ ਯੋਧੇ) ਕ੍ਰੋਧ ਨਾਲ ਬਹਿ ਬਹਿ ਕਰਦੀਆਂ ਕ੍ਰਿਪਾਨਾ ਚਲਾਉਾਂਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "बह बहत क्रुध कृपाणयं ॥",
      "sourceLineId": "79530",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੁਝੈਤ ਜੋਧ ਜੁਆਣਯੰ ॥੧੬॥੧੩੮॥",
      "transliteration": "jujhait jodh juaanaya(n) ||16||138||",
      "translation": "The fighting warriors, in great fury, are striking their swords.16.138.",
      "punjabiViakhya": "ਅਤੇ ਯੋਧੇ ਯੁੱਧ ਵਿਚ ਜੂਝ ਰਹੇ ਸਨ ॥੧੬॥੧੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "जुझैत जोध जुआणयं ॥१६॥१३८॥",
      "sourceLineId": "79531",
      "sourceShabadId": "7709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "79532",
      "sourceShabadId": "7710",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭਜੀ ਚਮੂੰ ਸਬ ਦਾਨਵੀ ਸੁੰਭ ਨਿਰਖ ਨਿਜ ਨੈਣ ॥",
      "transliteration": "bhajee chamoo(n) sab dhaanavee su(n)bh nirakh nij nain ||",
      "translation": "Seeing with his own eyes the running demon-army",
      "punjabiViakhya": "ਦੈਂਤਾ ਦੀ ਸਾਰੀ ਸੈਨਾ ਭਜ ਗਈ, (ਇਹ ਸਥਿਤੀ) ਸੁੰਭ ਨੇ ਆਪਣੀਆਂ ਅੱਖਾ ਨਾਲ ਵੇਖ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "भजी चमूँ सब दानवी सुँभ निरख निज नैण ॥",
      "sourceLineId": "79533",
      "sourceShabadId": "7710",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਿਕਟ ਬਿਕਟ ਭਟ ਜੇ ਹੁਤੇ ਤਿਨ ਪ੍ਰਤਿ ਬੁਲਿਯੋ ਬੈਣ ॥੧੭॥੧੩੯॥",
      "transliteration": "nikaT bikaT bhaT je hute tin prat buliyo bain ||17||139||",
      "translation": "Sumbh spoke to the mighty warriors standing near him.17.139.",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਨੇੜੇ ਜਿਤਨੇ ਵੀ ਲੜਾਕੇ ਸੂਰਮੇ (ਮੌਜੂਦ ਸਨ) ਉਨ੍ਹਾ ਪ੍ਰਤਿ (ਇਸ ਤਰ੍ਹਾ) ਬਚਨ ਬੋਲਿਆ ॥੧੭॥੧੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "निकट बिकट भट जे हुते तिन प्रति बुलियो बैण ॥१७॥१३९॥",
      "sourceLineId": "79534",
      "sourceShabadId": "7710",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "naraaj chha(n)dh ||",
      "translation": "NARAAJ STANZA",
      "punjabiViakhya": "ਨਰਾਜ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "नराज छंद ॥",
      "sourceLineId": "79535",
      "sourceShabadId": "7711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਿਸੁੰਭ ਸੁੰਭ ਕੋਪ ਕੈ ॥",
      "transliteration": "nisu(n)bh su(n)bh kop kai ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਨਾਲ ਸੁੰਭ ਨੇ ਧਰਤੀ ਉਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "निसुँभ सुँभ कोप कै ॥",
      "sourceLineId": "79536",
      "sourceShabadId": "7711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪਠਿਯੋ ਸੁ ਪਾਵ ਰੋਪ ਕੈ ॥",
      "transliteration": "paThiyo su paav rop kai ||",
      "translation": "Srriking his foot on the earth Sumbh sent Nisumbh saying",
      "punjabiViakhya": "ਪੈਰ ਗਡਦੇ ਹੋਇਆਂ ਨਿਸੁੰਭ ਨੂੰ ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "पठियो सु पाव रोप कै ॥",
      "sourceLineId": "79537",
      "sourceShabadId": "7711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਹਿਯੋ ਕਿ ਸੀਘ੍ਰ ਜਾਈਯੋ ॥",
      "transliteration": "kahiyo k seeghr jaieeyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਹਾ ਕਿ ਜਲਦੀ ਜਾਓ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "कहियो कि सीघ्र जाईयो ॥",
      "sourceLineId": "79538",
      "sourceShabadId": "7711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦ੍ਰੁਗਾਹਿ ਬਾਧ ਲ੍ਯਾਈਯੋ ॥੧੮॥੧੪੦॥",
      "transliteration": "dhrugaeh baadh layaieeyo ||18||140||",
      "translation": "“Go immediately and bring Durga after binding her.”18.140.",
      "punjabiViakhya": "ਅਤੇ ਦੁਰਗਾ ਨੂੰ ਬੰਨ੍ਹ ਲਿਆਓ ॥੧੮॥੧੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "द्रुगाहि बाध ल्याईयो ॥१८॥१४०॥",
      "sourceLineId": "79539",
      "sourceShabadId": "7711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚੜ੍ਯੋ ਸੁ ਸੈਣ ਸਜਿ ਕੈ ॥",
      "transliteration": "chaRayo su sain saj kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸੈਨਾ ਨੂੰ ਸਜਾ ਕੇ ਕ੍ਰੋਧਵਾਨ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "चड़्यो सु सैण सजि कै ॥",
      "sourceLineId": "79540",
      "sourceShabadId": "7711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਕੋਪ ਸੂਰ ਗਜਿ ਕੈ ॥",
      "transliteration": "sakop soor gaj kai ||",
      "translation": "Thundering and in great fury, he marched forward alongwith his army.",
      "punjabiViakhya": "ਅਤੇ ਚੜ੍ਹ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "सकोप सूर गजि कै ॥",
      "sourceLineId": "79541",
      "sourceShabadId": "7711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਉਠੈ ਬਜੰਤ੍ਰ ਬਾਜਿ ਕੈ ॥",
      "transliteration": "auThai baja(n)tr baaj kai ||",
      "translation": "",
      "punjabiViakhya": "(ਸੈਨਿਕ) ਵਾਜੇ ਵਜਾਉਾਂਦੇ ਹੋਏ ਡਟ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "उठै बजंत्र बाजि कै ॥",
      "sourceLineId": "79542",
      "sourceShabadId": "7711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚਲਿਯੋ ਸੁਰੇਸੁ ਭਾਜਿ ਕੈ ॥੧੯॥੧੪੧॥",
      "transliteration": "chaliyo sures bhaaj kai ||19||141||",
      "translation": "The trumpets were sounded, hearing which caused the king of gods run away.19.141.",
      "punjabiViakhya": "(ਉਨ੍ਹਾ ਦੀ ਚੜ੍ਹਤ ਨੂੰ ਵੇਖ ਕੇ) ਇੰਦਰ ਭਜ ਚਲਿਆ ॥੧੯॥੧੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "चलियो सुरेसु भाजि कै ॥१९॥१४१॥",
      "sourceLineId": "79543",
      "sourceShabadId": "7711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਨੰਤ ਸੂਰ ਸੰਗਿ ਲੈ ॥",
      "transliteration": "ana(n)t soor sa(n)g lai ||",
      "translation": "",
      "punjabiViakhya": "ਅਣਗਿਣਤ ਸੂਰਮਿਆਂ ਨੂੰ ਨਾਲ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "अनंत सूर संगि लै ॥",
      "sourceLineId": "79544",
      "sourceShabadId": "7711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚਲਿਯੋ ਸੁ ਦੁੰਦਭੀਨ ਦੈ ॥",
      "transliteration": "chaliyo su dhu(n)dhabheen dhai ||",
      "translation": "Beating his drums, he marched forward taking countless warriors with him.",
      "punjabiViakhya": "ਅਤੇ ਧੌਂਸਿਆਂ ਨੂੰ ਵਜਾ ਕੇ (ਨਿਸੁੰਭ) ਚੜ੍ਹ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "चलियो सु दुँदभीन दै ॥",
      "sourceLineId": "79545",
      "sourceShabadId": "7711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹਕਾਰਿ ਸੂਰਮਾ ਭਰੇ ॥",
      "transliteration": "hakaar sooramaa bhare ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਸੂਰਮਿਆਂ ਨੂੰ ਬੁਲਾ ਕੇ ਇਕੱਠਾ ('ਭਰੇ') ਕਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "हकारि सूरमा भरे ॥",
      "sourceLineId": "79546",
      "sourceShabadId": "7711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਿਲੋਕਿ ਦੇਵਤਾ ਡਰੇ ॥੨੦॥੧੪੨॥",
      "transliteration": "bilok dhevataa ddare ||20||142||",
      "translation": "He called and gathered so many brave fighters, seeing whom the gods were frightened.20.142.",
      "punjabiViakhya": "(ਜਿੰਨ੍ਹਾ ਨੂੰ) ਵੇਖ ਕੇ ਦੇਵਤੇ ਡਰ ਗਏ ॥੨੦॥੧੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "बिलोकि देवता डरे ॥२०॥१४२॥",
      "sourceLineId": "79547",
      "sourceShabadId": "7711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਧੁਭਾਰ ਛੰਦ ॥",
      "transliteration": "madhubhaar chha(n)dh ||",
      "translation": "MADHUBHAAR STANZA",
      "punjabiViakhya": "ਮਧੁਭਾਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "मधुभार छंद ॥",
      "sourceLineId": "79548",
      "sourceShabadId": "7712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕੰਪਿਯੋ ਸੁਰੇਸ ॥",
      "transliteration": "ka(n)piyo sures ||",
      "translation": "",
      "punjabiViakhya": "ਇੰਦਰ ਕੰਬ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "कंपियो सुरेस ॥",
      "sourceLineId": "79549",
      "sourceShabadId": "7712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬੁਲਿਯੋ ਮਹੇਸ ॥",
      "transliteration": "buliyo mahes ||",
      "translation": "The king of gods trembled and reated all his painful circumstances to Lord Shiva.",
      "punjabiViakhya": "ਮਹੇਸ਼ ਨੇ (ਉਸ ਨੂੰ) ਕੋਲ ਬੁਲਾਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "बुलियो महेस ॥",
      "sourceLineId": "79550",
      "sourceShabadId": "7712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਿਨੋ ਬਿਚਾਰ ॥",
      "transliteration": "kino bichaar ||",
      "translation": "",
      "punjabiViakhya": "(ਆਪਸ ਵਿਚ) ਸਲਾਹ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "किनो बिचार ॥",
      "sourceLineId": "79551",
      "sourceShabadId": "7712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪੁਛੇ ਜੁਝਾਰ ॥੨੧॥੧੪੩॥",
      "transliteration": "puchhe jujhaar ||21||143||",
      "translation": "When he gave out all his feflections, Shiva asked him about the number of his warriors.21.143.",
      "punjabiViakhya": "ਅਤੇ ਸੈਨਿਕਾ ਬਾਰੇ ਪੁਛਿਆ ॥੨੧॥੧੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "पुछे जुझार ॥२१॥१४३॥",
      "sourceLineId": "79552",
      "sourceShabadId": "7712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕੀਜੈ ਸੁ ਮਿਤ੍ਰ ॥",
      "transliteration": "keejai su mitr ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮਿਤਰ!",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "कीजै सु मित्र ॥",
      "sourceLineId": "79553",
      "sourceShabadId": "7712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਉਨੇ ਚਰਿਤ੍ਰ ॥",
      "transliteration": "kaune charitr ||",
      "translation": "(He further asked him) to make friends all others through all possible means",
      "punjabiViakhya": "ਉਹ ਕਿਹੜਾ ਕੌਤਕ ਕਰੀਏ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "कउने चरित्र ॥",
      "sourceLineId": "79554",
      "sourceShabadId": "7712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਾਤੇ ਸੁ ਮਾਇ ॥",
      "transliteration": "jaate su mai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਦੁਰਗਾ ਮਾਤਾ ਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "जाते सु माइ ॥",
      "sourceLineId": "79555",
      "sourceShabadId": "7712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜੀਤੈ ਬਨਾਇ ॥੨੨॥੧੪੪॥",
      "transliteration": "jeetai banai ||22||144||",
      "translation": "So that the victory of the mother of the world is assured.22.144.",
      "punjabiViakhya": "ਚੰਗੀ ਤਰ੍ਹਾ ਜਿਤ ਹੋ ਜਾਏ ॥੨੨॥੧੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "जीतै बनाइ ॥२२॥१४४॥",
      "sourceLineId": "79556",
      "sourceShabadId": "7712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਕਤੈ ਨਿਕਾਰ ॥",
      "transliteration": "sakatai nikaar ||",
      "translation": "",
      "punjabiViakhya": "(ਆਪਣੀਆਂ ਅਪਾਰ) ਸ਼ਕਤੀਆਂ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "सकतै निकार ॥",
      "sourceLineId": "79557",
      "sourceShabadId": "7712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭੇਜੋ ਅਪਾਰ ॥",
      "transliteration": "bhejo apaar ||",
      "translation": "Bring out all your powers, and send them in the war",
      "punjabiViakhya": "ਕਢ ਲਵੋ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "भेजो अपार ॥",
      "sourceLineId": "79558",
      "sourceShabadId": "7712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਤ੍ਰਨ ਜਾਇ ॥",
      "transliteration": "satran jai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਯੁੱਧ ਵਿਚ) ਭੇਜ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "सत्रन जाइ ॥",
      "sourceLineId": "79559",
      "sourceShabadId": "7712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹਨਿ ਹੈ ਰਿਸਾਇ ॥੨੩॥੧੪੫॥",
      "transliteration": "han hai risai ||23||145||",
      "translation": "So that they may go before enemies and in great rage destroy them.23.145.",
      "punjabiViakhya": "(ਤਾ ਜੋ) ਜਾ ਕੇ ਕ੍ਰੋਧ ਨਾਲ ਵੈਰੀਆਂ ਨੂੰ ਮਾਰ ਦੇਣ ॥੨੩॥੧੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "हनि है रिसाइ ॥२३॥१४५॥",
      "sourceLineId": "79560",
      "sourceShabadId": "7712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੋਈ ਕਾਮ ਕੀਨ ॥",
      "transliteration": "soiee kaam keen ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਹਾ) ਪ੍ਰਬੀਨ ਦੇਵਤਿਆਂ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "सोई काम कीन ॥",
      "sourceLineId": "79561",
      "sourceShabadId": "7712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੇਵਨ ਪ੍ਰਬੀਨ ॥",
      "transliteration": "dhevan prabeen ||",
      "translation": "The wise gods did as advised",
      "punjabiViakhya": "ਓਹੀ ਕੰਮ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "देवन प्रबीन ॥",
      "sourceLineId": "79562",
      "sourceShabadId": "7712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਕਤੈ ਨਿਕਾਰਿ ॥",
      "transliteration": "sakatai nikaar ||",
      "translation": "",
      "punjabiViakhya": "(ਆਪਣੀਆਂ) ਅਪਾਰ ਸ਼ਕਤੀਆਂ ਕਢ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "सकतै निकारि ॥",
      "sourceLineId": "79563",
      "sourceShabadId": "7712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭੇਜੀ ਅਪਾਰ ॥੨੪॥੧੪੬॥",
      "transliteration": "bhejee apaar ||24||146||",
      "translation": "And sent their boundless powers from amoungst themselves to the battlefield.24.146.",
      "punjabiViakhya": "ਭੇਜ ਦਿੱਤੀਆਂ ॥੨੪॥੧੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "भेजी अपार ॥२४॥१४६॥",
      "sourceLineId": "79564",
      "sourceShabadId": "7712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬ੍ਰਿਧ ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "biradh naraaj chha(n)dh ||",
      "translation": "BIRADH NIRAAJ STANZA",
      "punjabiViakhya": "ਬ੍ਰਿਧ ਨਰਾਜ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "बृध नराज छंद ॥",
      "sourceLineId": "79565",
      "sourceShabadId": "7713",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚਲੀ ਸਕਤਿ ਸੀਘ੍ਰ ਸ੍ਰੀ ਕ੍ਰਿਪਾਣਿ ਪਾਣਿ ਧਾਰ ਕੈ ॥",
      "transliteration": "chalee sakat seeghr sree kirapaan paan dhaar kai ||",
      "translation": "Immediately the powers wore the sword and went towards the arena of war",
      "punjabiViakhya": "(ਉਹ) ਸ਼ਕਤੀਆਂ ਤੁਰਤ ਹੱਥਾ ਵਿਚ ਤਲਵਾਰਾ ਧਾਰਨ ਕਰ ਕੇ (ਯੁੱਧ-ਭੂਮੀ ਵਲ) ਚਲ ਪਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "चली सकति सीघ्र स्री कृपाणि पाणि धार कै ॥",
      "sourceLineId": "79566",
      "sourceShabadId": "7713",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਉਠੇ ਸੁ ਗ੍ਰਿਧ ਬ੍ਰਿਧ ਡਉਰ ਡਾਕਣੀ ਡਕਾਰ ਕੈ ॥",
      "transliteration": "auThe su giradh biradh ddaur ddaakanee ddakaar kai ||",
      "translation": "And with them ran the great vultures nd belching vampires.",
      "punjabiViakhya": "(ਉਨ੍ਹਾ ਨੂੰ ਤੁਰਦਿਆਂ ਵੇਖ ਕੇ) ਵੱਡੇ ਵੱਡੇ ਗਿੱਧ ਡੌਰ ਭੌਰ ਹੋ ਕੇ ਅਤੇ ਡਾਕਣੀਆਂ ਡਕਾਰ ਕੇ ਤੁਰ ਪਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "उठे सु गृध बृध डउर डाकणी डकार कै ॥",
      "sourceLineId": "79567",
      "sourceShabadId": "7713",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਸੇ ਸੁ ਰੰਗ ਕੰਕ ਬੰਕਯੰ ਕਬੰਧ ਅੰਧ ਉਠਹੀ ॥",
      "transliteration": "hase su ra(n)g ka(n)k ba(n)kaya(n) kaba(n)dh a(n)dh uThahee ||",
      "translation": "The terrible crows smiled and the blind headless bodies also moved.",
      "punjabiViakhya": "ਵਡੇ ਆਕਾਰ ਵਾਲੇ ਕਾ ਹਸਣ ਲਗੇ ਅਤੇ ਧੜ ਵੀ ਅੰਨ੍ਹੇ ਵਾਹ ਉਠਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "हसे सु रंग कंक बंकयं कबंध अंध उठही ॥",
      "sourceLineId": "79568",
      "sourceShabadId": "7713",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਿਸੇਖ ਦੇਵਤਾ ਰੁ ਬੀਰ ਬਾਣ ਧਾਰ ਬੁਠਹੀ ॥੨੫॥੧੪੭॥",
      "transliteration": "bisekh dhevataa r beer baan dhaar buThahee ||25||147||",
      "translation": "From this side, the gods and other heroes began to shower shafts.25.147.",
      "punjabiViakhya": "ਬਹੁਤ ਸਾਰੇ ਦੇਵਤੇ ਅਤੇ ਸੂਰਵੀਰ ਬਾਣਾ ਦੀ ਬਰਖਾ ਕਰਨ ਲਗੇ ॥੨੫॥੧੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "बिसेख देवता रु बीर बाण धार बुठही ॥२५॥१४७॥",
      "sourceLineId": "79569",
      "sourceShabadId": "7713",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "79570",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਬੈ ਸਕਤਿ ਐ ਕੈ ॥",
      "transliteration": "sabai sakat aai kai ||",
      "translation": "",
      "punjabiViakhya": "(ਦੇਵਤਿਆਂ ਦੀਆਂ) ਸਾਰੀਆਂ ਸ਼ਕਤੀਆਂ ਨੇ ਆ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "सबै सकति ऐ कै ॥",
      "sourceLineId": "79571",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਚਲੀ ਸੀਸ ਨਿਐ ਕੈ ॥",
      "transliteration": "chalee sees niaai kai ||",
      "translation": "All the powers came and went back paying their obeisance.",
      "punjabiViakhya": "ਸੀਸ ਝੁਕਾਏ ਅਤੇ (ਯੁੱਧ ਲਈ) ਚਾਲੇ ਪਾ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "चली सीस निऐ कै ॥",
      "sourceLineId": "79572",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮਹਾ ਅਸਤ੍ਰ ਧਾਰੇ ॥",
      "transliteration": "mahaa asatr dhaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਹਾ ਨੇ) ਮਹਾਨ ਅਸਤ੍ਰ ਧਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "महा असत्र धारे ॥",
      "sourceLineId": "79573",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮਹਾ ਬੀਰ ਮਾਰੇ ॥੨੬॥੧੪੮॥",
      "transliteration": "mahaa beer maare ||26||148||",
      "translation": "They wore terrible arms and killed many great warriors.26.148.",
      "punjabiViakhya": "ਵੱਡੇ ਵੱਡੇ ਸੂਰਮਿਆਂ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ॥੨੬॥੧੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "महा बीर मारे ॥२६॥१४८॥",
      "sourceLineId": "79574",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮੁਖੰ ਰਕਤ ਨੈਣੰ ॥",
      "transliteration": "mukha(n) rakat naina(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਹਾ ਦੇ) ਮੂੰਹਾ ਅਤੇ ਅੱਖਾ ਵਿਚੋਂ ਲਹੂ ਉਤਰ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "मुखं रकत नैणं ॥",
      "sourceLineId": "79575",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਬਕੈ ਬੰਕ ਬੈਣੰ ॥",
      "transliteration": "bakai ba(n)k baina(n) ||",
      "translation": "Their faces and eyes are reddened with blood and they are uttering challenging words from their mouths.",
      "punjabiViakhya": "ਅਤੇ ਕਠੋਰ ਬਚਨ ਬੋਲ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "बकै बंक बैणं ॥",
      "sourceLineId": "79576",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਧਰੇ ਅਸਤ੍ਰ ਪਾਣੰ ॥",
      "transliteration": "dhare asatr paana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਹਾ ਨੇ) ਹੱਥਾ ਵਿਚ ਅਸਤ੍ਰ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "धरे असत्र पाणं ॥",
      "sourceLineId": "79577",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕਟਾਰੀ ਕ੍ਰਿਪਾਣੰ ॥੨੭॥੧੪੯॥",
      "transliteration": "kaTaaree kirapaana(n) ||27||149||",
      "translation": "They are holding arms, daggers and swords in their hands.27.149.",
      "punjabiViakhya": "ਅਤੇ ਕਟਾਰਾ ਤੇ ਕ੍ਰਿਪਾਨਾ ਫੜੀਆਂ ਹੋਈਆਂ ਸਨ ॥੨੭॥੧੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "कटारी कृपाणं ॥२७॥१४९॥",
      "sourceLineId": "79578",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਉਤੈ ਦੈਤ ਗਾਜੇ ॥",
      "transliteration": "autai dhait gaaje ||",
      "translation": "",
      "punjabiViakhya": "ਉਧਰੋਂ ਦੈਂਤ ਗਜਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "उतै दैत गाजे ॥",
      "sourceLineId": "79579",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਤੁਰੀ ਨਾਦ ਬਾਜੇ ॥",
      "transliteration": "turee naadh baaje ||",
      "translation": "From the other side, the demons are thundering, and the trumpets are resounding.",
      "punjabiViakhya": "ਤੁਰੀਆਂ ਤੇ ਧੌਂਸੇ ਵਜਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "तुरी नाद बाजे ॥",
      "sourceLineId": "79580",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਧਾਰੇ ਚਾਰ ਚਰਮੰ ॥",
      "transliteration": "dhaare chaar charama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੱਥਾ ਵਿਚ ਸੁੰਦਰ ਢਾਲਾ ਧਾਰਨ ਕੀਤੀਆਂ ਹੋਈਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "धारे चार चरमं ॥",
      "sourceLineId": "79581",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਸ੍ਰਜੇ ਕ੍ਰੂਰ ਬਰਮੰ ॥੨੮॥੧੫੦॥",
      "transliteration": "sraje kraoor barama(n) ||28||150||",
      "translation": "They are wearing cruel armour, holding winsome shields in their hands.28.150.",
      "punjabiViakhya": "ਅਤੇ ਕਠੋਰ ਕਵਚ ਪਹਿਨੇ ਹੋਏ ਸਨ ॥੨੮॥੧੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "स्रजे क्रूर बरमं ॥२८॥१५०॥",
      "sourceLineId": "79582",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਚਹੂੰ ਓਰ ਗਰਜੇ ॥",
      "transliteration": "chahoo(n) or garaje ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ (ਦੈਂਤ) ਗਜ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "चहूँ ओर गरजे ॥",
      "sourceLineId": "79583",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਸਬੈ ਦੇਵ ਲਰਜੇ ॥",
      "transliteration": "sabai dhev laraje ||",
      "translation": "They began to roar from all the four sides and hearing their voices, all the gods trembled.",
      "punjabiViakhya": "(ਉਨ੍ਹਾ ਦੀ ਗਰਜ ਨੂੰ ਸੁਣ ਕੇ) ਸਾਰੇ ਦੇਵਤੇ ਕੰਬ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "सबै देव लरजे ॥",
      "sourceLineId": "79584",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਛੁਟੇ ਤਿਛ ਤੀਰੰ ॥",
      "transliteration": "chhuTe tichh teera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਖਣ ਤੀਰ ਛੁਟ ਰਹੇ ਸਨ ਅਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "छुटे तिछ तीरं ॥",
      "sourceLineId": "79585",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਕਟੇ ਚਉਰ ਚੀਰੰ ॥੨੯॥੧੫੧॥",
      "transliteration": "kaTe chaur cheera(n) ||29||151||",
      "translation": "The sharp arrows were shot and the garments and fly-whisks were torn.29.151.",
      "punjabiViakhya": "(ਉਨ੍ਹਾ ਦੇ ਲਗਣ ਨਾਲ) ਚੌਰਾ ਅਤੇ ਬਸਤ੍ਰ ਕਟੇ ਜਾ ਰਹੇ ਸਨ ॥੨੯॥੧੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "कटे चउर चीरं ॥२९॥१५१॥",
      "sourceLineId": "79586",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਰੁਸੰ ਰੁਦ੍ਰ ਰਤੇ ॥",
      "transliteration": "rusa(n) rudhr rate ||",
      "translation": "",
      "punjabiViakhya": "(ਸਾਰੇ) ਰੌਦਰ ਰਸ ਵਿਚ ਮਸਤ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "रुसं रुद्र रते ॥",
      "sourceLineId": "79587",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਮਹਾ ਤੇਜ ਤਤੇ ॥",
      "transliteration": "mahaa tej tate ||",
      "translation": "Inebriated with extreme ferocity, the warriors are seen with brightened faces.",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਅਧਿਕ ਤੇਜ ਨਾਲ ਭੜਕੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "महा तेज तते ॥",
      "sourceLineId": "79588",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਕਰੀ ਬਾਣ ਬਰਖੰ ॥",
      "transliteration": "karee baan barakha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣਾ ਦੀ ਬਰਖਾ ਕਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "करी बाण बरखं ॥",
      "sourceLineId": "79589",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਭਰੀ ਦੇਬਿ ਹਰਖੰ ॥੩੦॥੧੫੨॥",
      "transliteration": "bharee dheb harakha(n) ||30||152||",
      "translation": "The goddess Durga, being very much pleased, hath begun showering the rain of arrows.30.152.",
      "punjabiViakhya": "ਦੇਵੀ ਆਨੰਦ ਨਾਲ ਭਰਪੂਰ ਸੀ ॥੩੦॥੧੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "भरी देबि हरखं ॥३०॥१५२॥",
      "sourceLineId": "79590",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਇਤੇ ਦੇਬਿ ਮਾਰੈ ॥",
      "transliteration": "eite dheb maarai ||",
      "translation": "",
      "punjabiViakhya": "ਇਧਰੋਂ ਦੇਵੀ ਮਾਰ ਰਹੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "इते देबि मारै ॥",
      "sourceLineId": "79591",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਉਤੈ ਸਿੰਘੁ ਫਾਰੈ ॥",
      "transliteration": "autai si(n)gh faarai ||",
      "translation": "On this side, the goddess is busy in killing and on the other side the lion is tearing up all.",
      "punjabiViakhya": "ਉਧਰੋਂ ਸ਼ੇਰ ਪਾੜ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "उतै सिंघु फारै ॥",
      "sourceLineId": "79592",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਗਣੰ ਗੂੜ ਗਰਜੈ ॥",
      "transliteration": "gana(n) gooR garajai ||",
      "translation": "",
      "punjabiViakhya": "(ਸ਼ਿਵ) ਗਣਾ ਦੀ ਗੰਭੀਰ ਗਰਜਨਾ ਹੋ ਰਹੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "गणं गूड़ गरजै ॥",
      "sourceLineId": "79593",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0111_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਸਬੈ ਦੈਤ ਲਰਜੇ ॥੩੧॥੧੫੩॥",
      "transliteration": "sabai dhait laraje ||31||153||",
      "translation": "Hearing the roars of the Ganas (attendants) of Shiva, the demons have become frightened.31.153.",
      "punjabiViakhya": "(ਜਿਸ ਕਰਕੇ) ਸਾਰੇ ਦੈਂਤ ਕੰਬ ਰਹੇ ਸਨ ॥੩੧॥੧੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 111,
      "hindi": "",
      "hindiTransliteration": "सबै दैत लरजे ॥३१॥१५३॥",
      "sourceLineId": "79594",
      "sourceShabadId": "7714",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
