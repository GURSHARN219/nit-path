{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 113,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0113_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚੜਿਯੋ ਸੁ ਕੋਪ ਗਜਿ ਕੈ ॥",
      "transliteration": "chaRiyo su kop gaj kai ||",
      "translation": "He (demon-king) marched forward, in great fury, bedecking himself with an army of warriors.",
      "punjabiViakhya": "ਪੂਰੇ ਕ੍ਰੋਧ ਨਾਲ ਗਜਦਾ ਹੋਇਆ (ਸੁੰਭ) ਚੜ੍ਹ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "चड़ियो सु कोप गजि कै ॥",
      "sourceLineId": "79643",
      "sourceShabadId": "7717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚਲਿਯੋ ਸੁ ਸਸਤ੍ਰ ਧਾਰ ਕੈ ॥",
      "transliteration": "chaliyo su sasatr dhaar kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸ਼ਸਤ੍ਰ ਧਾਰ ਕੇ ਚਲ ਪਿਆ-",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "चलियो सु ससत्र धार कै ॥",
      "sourceLineId": "79644",
      "sourceShabadId": "7717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪੁਕਾਰ ਮਾਰੁ ਮਾਰ ਕੈ ॥੯॥੧੬੫॥",
      "transliteration": "pukaar maar maar kai ||9||165||",
      "translation": "He moved, wearing his weapons, with shouts of “kill, kill”.9.165.",
      "punjabiViakhya": "ਮਾਰੋ' 'ਮਾਰੋ' ਪੁਕਾਰਦਾ ਹੋਇਆ ॥੯॥੧੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "पुकार मारु मार कै ॥९॥१६५॥",
      "sourceLineId": "79645",
      "sourceShabadId": "7717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੰਗੀਤ ਮਧੁਭਾਰ ਛੰਦ ॥",
      "transliteration": "sa(n)geet madhubhaar chha(n)dh ||",
      "translation": "SANGEET MADHUBHAAE STANZA",
      "punjabiViakhya": "ਸੰਗੀਤ ਮਧੁਭਾਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "संगीत मधुभार छंद ॥",
      "sourceLineId": "79646",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਾਗੜਦੰ ਕੜਾਕ ॥",
      "transliteration": "kaagaRadha(n) kaRaak ||",
      "translation": "",
      "punjabiViakhya": "ਕੜਾਕ-ਕੜਾਕ",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "कागड़दं कड़ाक ॥",
      "sourceLineId": "79647",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਾਗੜਦੰ ਤੜਾਕ ॥",
      "transliteration": "taagaRadha(n) taRaak ||",
      "translation": "There were sounds of clattering and twanging.",
      "punjabiViakhya": "ਅਤੇ ਤਾੜ-ਤਾੜ ਦੀ ਧੁਨੀ ਹੋ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "तागड़दं तड़ाक ॥",
      "sourceLineId": "79648",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਾਗੜਦੰ ਸੁ ਬੀਰ ॥",
      "transliteration": "saagaRadha(n) su beer ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਵੀਰ ਗੜਗੜ ਕਰਦੇ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "सागड़दं सु बीर ॥",
      "sourceLineId": "79649",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗਾਗੜਦੰ ਗਹੀਰ ॥੧੦॥੧੬੬॥",
      "transliteration": "gaagaRadha(n) gaheer ||10||166||",
      "translation": "The warriors were shouting loudly and thundering profoundly.10.166.",
      "punjabiViakhya": "ਗਰਜ ਰਹੇ ਸਨ ॥੧੦॥੧੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "गागड़दं गहीर ॥१०॥१६६॥",
      "sourceLineId": "79650",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਗੜਦੰ ਨਿਸਾਣ ॥",
      "transliteration": "naagaRadha(n) nisaan ||",
      "translation": "",
      "punjabiViakhya": "ਨਾਦ ਕਰ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "नागड़दं निसाण ॥",
      "sourceLineId": "79651",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਾਗੜਦੰ ਜੁਆਣ ॥",
      "transliteration": "jaagaRadha(n) juaan ||",
      "translation": "The resonance of trumpets was precipitating the youthful warriors.",
      "punjabiViakhya": "ਜੁਆਨ ਜੂਝ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "जागड़दं जुआण ॥",
      "sourceLineId": "79652",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਗੜਦੀ ਨਿਹੰਗ ॥",
      "transliteration": "naagaRadhee niha(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰਮੱਛਾ ('ਨਿਹੰਗ') ਵਾਗ ਇਕ ਦੂਜੇ ਨੂੰ ਪਕੜਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "नागड़दी निहंग ॥",
      "sourceLineId": "79653",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪਾਗੜਦੀ ਪਲੰਗ ॥੧੧॥੧੬੭॥",
      "transliteration": "paagaRadhee pala(n)g ||11||167||",
      "translation": "Those brave men were jumping and engaged in chivalrous acts. 11.167.",
      "punjabiViakhya": "ਅਤੇ ਚਿਤਰਿਆਂ ਵਾਗ ਉਛਲ ਕੇ ਪੈਂਦੇ ਸਨ ॥੧੧॥੧੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "पागड़दी पलंग ॥११॥१६७॥",
      "sourceLineId": "79654",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਾਗੜਦੀ ਤਮਕਿ ॥",
      "transliteration": "taagaRadhee tamak ||",
      "translation": "",
      "punjabiViakhya": "ਗੁੱਸੇ ਨਾਲ ਤਾੜਦੇ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "तागड़दी तमकि ॥",
      "sourceLineId": "79655",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਲਾਗੜਦੀ ਲਹਕਿ ॥",
      "transliteration": "laagaRadhee lahak ||",
      "translation": "In great rage, the warriors showed signs of anger on their faces.",
      "punjabiViakhya": "ਦਗ-ਦਗ ਕਰੇ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "लागड़दी लहकि ॥",
      "sourceLineId": "79656",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਾਗੜਦੰ ਕ੍ਰਿਪਾਣ ॥",
      "transliteration": "kaagaRadha(n) kirapaan ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਵੀਰ ਕਠੋਰ ਕ੍ਰਿਪਾਨਾ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "कागड़दं कृपाण ॥",
      "sourceLineId": "79657",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਾਹੈ ਜੁਆਣ ॥੧੨॥੧੬੮॥",
      "transliteration": "baahai juaan ||12||168||",
      "translation": "They were striking their swords.12.168.",
      "punjabiViakhya": "ਚਲਾ ਰਹੇ ਸਨ ॥੧੨॥੧੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "बाहै जुआण ॥१२॥१६८॥",
      "sourceLineId": "79658",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਖਾਗੜਦੀ ਖਤੰਗ ॥",
      "transliteration": "khaagaRadhee khata(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਖਰ-ਖਰ ਕਰਦੇ ਤੀਰ ('ਖਤੰਗ')",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "खागड़दी खतंग ॥",
      "sourceLineId": "79659",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਗੜਦੀ ਨਿਹੰਗ ॥",
      "transliteration": "naagaRadhee niha(n)g ||",
      "translation": "The arrows shot by the warriors were blowing away",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ (ਨਿਹੰਗਾ) ਨੇ ਫੜੇ ਹੋਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "नागड़दी निहंग ॥",
      "sourceLineId": "79660",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਛਾਗੜਦੀ ਛੁਟੰਤ ॥",
      "transliteration": "chhaagaRadhee chhuTa(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਛੜ-ਛੜ ਕਰਦੇ ਛੁਟਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "छागड़दी छुटंत ॥",
      "sourceLineId": "79661",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਆਗੜਦੀ ਉਡੰਤ ॥੧੩॥੧੬੯॥",
      "transliteration": "aagaRadhee udda(n)t ||13||169||",
      "translation": "And throwing down those coming in front of them.13.169.",
      "punjabiViakhya": "ਅਤੇ ਅਗੋਂ ਆਣ ਵਾਲਿਆਂ ਨੂੰ ਉਡਾਉਾਂਦੇ ਜਾਦੇ ਸਨ ॥੧੩॥੧੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "आगड़दी उडंत ॥१३॥१६९॥",
      "sourceLineId": "79662",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪਾਗੜਦੀ ਪਵੰਗ ॥",
      "transliteration": "paagaRadhee pava(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਪਗੜੀਆਂ ਵਾਲੇ (ਯੋਧੇ) ਘੋੜੇ ('ਪਵੰਗ')",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "पागड़दी पवंग ॥",
      "sourceLineId": "79663",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਾਗੜਦੀ ਸੁਭੰਗ ॥",
      "transliteration": "saagaRadhee subha(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੁੰਦਰ ਅੰਗਾ ਵਾਲੇ",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "सागड़दी सुभंग ॥",
      "sourceLineId": "79664",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਾਗੜਦੀ ਜੁਆਣ ॥",
      "transliteration": "jaagaRadhee juaan ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਜਗਹ ਜਗਹ ਉਤੇ ਜੁਆਨ",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "जागड़दी जुआण ॥",
      "sourceLineId": "79665",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਝਾਗੜਦੀ ਜੁਝਾਣਿ ॥੧੪॥੧੭੦॥",
      "transliteration": "jhaagaRadhee jujhaan ||14||170||",
      "translation": "The winsome brave horse-riders were fighting courageously.14.170.",
      "punjabiViakhya": "ਝਗੜਦੇ ਅਤੇ ਜੂਝਦੇ ਸਨ ॥੧੪॥੧੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "झागड़दी जुझाणि ॥१४॥१७०॥",
      "sourceLineId": "79666",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਝਾਗੜਦੀ ਝੜੰਗ ॥",
      "transliteration": "jhaagaRadhee jhaRa(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਝੜ-ਝੜ ਕਰਦੇ ਝੜਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "झागड़दी झड़ंग ॥",
      "sourceLineId": "79667",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਾਗੜਦੀ ਕੜੰਗ ॥",
      "transliteration": "kaagaRadhee kaRa(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਕੜ-ਕੜ ਕਰਦੇ ਕੜਕਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "कागड़दी कड़ंग ॥",
      "sourceLineId": "79668",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਾਗੜਦੀ ਤੜਾਕ ॥",
      "transliteration": "taagaRadhee taRaak ||",
      "translation": "",
      "punjabiViakhya": "ਤੜ-ਤੜ ਕਰਦੇ (ਗੋਲੇ) ਨਿਕਲਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "तागड़दी तड़ाक ॥",
      "sourceLineId": "79669",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚਾਗੜਦੀ ਚਟਾਕ ॥੧੫॥੧੭੧॥",
      "transliteration": "chaagaRadhee chaTaak ||15||171||",
      "translation": "Several types of noise were spreading in the battlefield.15.171.",
      "punjabiViakhya": "ਅਤੇ ਚੜਚੜ ਕਰਦੇ (ਬਰਛੇ) ਵਜਦੇ ਸਨ ॥੧੫॥੧੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "चागड़दी चटाक ॥१५॥१७१॥",
      "sourceLineId": "79670",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਘਾਗੜਦੀ ਘਬਾਕ ॥",
      "transliteration": "ghaagaRadhee ghabaak ||",
      "translation": "",
      "punjabiViakhya": "ਘੜ-ਘੜ (ਪੇਟ ਵਿਚ ਗੋਲੇ) ਵਜਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "घागड़दी घबाक ॥",
      "sourceLineId": "79671",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭਾਗੜਦੀ ਭਭਾਕ ॥",
      "transliteration": "bhaagaRadhee bhabhaak ||",
      "translation": "The arms were being swung in the battlefield and the stream of blood was flowing.",
      "punjabiViakhya": "ਭੜ-ਭੜ ਕਰਦੇ (ਜ਼ਖਮਾ ਦੇ) ਮੂੰਹ ਖੁਲਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "भागड़दी भभाक ॥",
      "sourceLineId": "79672",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਾਗੜਦੰ ਕਪਾਲਿ ॥",
      "transliteration": "kaagaRadha(n) kapaal ||",
      "translation": "",
      "punjabiViakhya": "(ਯੁੱਧ-ਭੂਮੀ ਵਿਚ) ਕਪਾਲੀ (ਕਾਲਕਾ)",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "कागड़दं कपालि ॥",
      "sourceLineId": "79673",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਚੀ ਬਿਕ੍ਰਾਲ ॥੧੬॥੧੭੨॥",
      "transliteration": "nachee bikraal ||16||172||",
      "translation": "Manifesting her frightful form, Kapali Durga was dancing.16.172.",
      "punjabiViakhya": "ਭਿਆਨਕ ਰੂਪ ਧਾਰਨ ਕਰਕੇ ਨਚ ਰਹੀ ਸੀ ॥੧੬॥੧੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "नची बिक्राल ॥१६॥१७२॥",
      "sourceLineId": "79674",
      "sourceShabadId": "7718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "naraaj chha(n)dh ||",
      "translation": "NARAAJ STANZA",
      "punjabiViakhya": "ਨਰਾਜ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "नराज छंद ॥",
      "sourceLineId": "79675",
      "sourceShabadId": "7719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਨੰਤ ਦੁਸਟ ਮਾਰੀਯੰ ॥",
      "transliteration": "ana(n)t dhusaT maareeya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੰਤ ਦੁਸ਼ਟਾ ਨੂੰ ਮਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "अनंत दुसट मारीयं ॥",
      "sourceLineId": "79676",
      "sourceShabadId": "7719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਿਅੰਤ ਸੋਕ ਟਾਰੀਯੰ ॥",
      "transliteration": "bia(n)t sok Taareeya(n) ||",
      "translation": "Killing the countless tyrants, Durga effaced many sufferings.",
      "punjabiViakhya": "(ਦੁਰਗਾ ਨੇ) ਬੇਅੰਤ ਦੁਖ ਦੂਰ ਕਰ ਦਿੱਤੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "बिअंत सोक टारीयं ॥",
      "sourceLineId": "79677",
      "sourceShabadId": "7719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਮੰਧ ਅੰਧ ਉਠੀਯੰ ॥",
      "transliteration": "kama(n)dh a(n)dh uTheeya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਨ੍ਹੇ ਵਾਹ ਧੜ ਉਠ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "कमंध अंध उठीयं ॥",
      "sourceLineId": "79678",
      "sourceShabadId": "7719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਿਸੇਖ ਬਾਣ ਬੁਠੀਯੰ ॥੧੭॥੧੭੩॥",
      "transliteration": "bisekh baan buTheeya(n) ||17||173||",
      "translation": "The blinds trunks were rising and moving and they were being felled on the ground with the shower of arrows.17.173.",
      "punjabiViakhya": "ਅਤੇ ਵਿਸ਼ੇਸ਼ ਢੰਗ ਨਾਲ ਤੀਰ ਚਲਾਉਾਂਦੇ ਸਨ ॥੧੭॥੧੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "बिसेख बाण बुठीयं ॥१७॥१७३॥",
      "sourceLineId": "79679",
      "sourceShabadId": "7719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕੜਕਾ ਕਰਮੁਕੰ ਉਧੰ ॥",
      "transliteration": "kaRakaa karamuka(n) udha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਧਨੁਸਾ ('ਕਰਮੁਕੰ') ਦੀ ਕੜਾਕ-ਕੜਾਕ ਦੀ ਉੱਚੀ ਧੁਨੀ",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "कड़का करमुकं उधं ॥",
      "sourceLineId": "79680",
      "sourceShabadId": "7719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੜਾਕ ਸੈਹਥੀ ਜੁਧੰ ॥",
      "transliteration": "saRaak saihathee judha(n) ||",
      "translation": "The sounds of working bows and striking daggers are being heard.",
      "punjabiViakhya": "ਅਤੇ ਸੜ-ਸੜ ਕਰਦੀਆਂ ਸੈਹੱਥੀਆਂ ਦੀ ਆਵਾਜ਼ ਹੋ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "सड़ाक सैहथी जुधं ॥",
      "sourceLineId": "79681",
      "sourceShabadId": "7719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਿਅੰਤ ਬਾਣਿ ਬਰਖਯੰ ॥",
      "transliteration": "bia(n)t baan barakhaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬੇਅੰਤ (ਸੂਰਮੇ) ਬਾਣਾ ਦੀ ਬਰਖਾ ਕਰਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "बिअंत बाणि बरखयं ॥",
      "sourceLineId": "79682",
      "sourceShabadId": "7719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਿਸੇਖ ਬੀਰ ਪਰਖਯੰ ॥੧੮॥੧੭੪॥",
      "transliteration": "bisekh beer parakhaya(n) ||18||174||",
      "translation": "In this continuous shower of arrows the significantly honoured heroes have been tasted.18.174.",
      "punjabiViakhya": "ਅਤੇ ਵਿਸ਼ੇਸ਼ ਸੂਰਮਿਆਂ ਦੀ ਪਰਖ ਹੋ ਰਹੀ ਸੀ ॥੧੮॥੧੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "बिसेख बीर परखयं ॥१८॥१७४॥",
      "sourceLineId": "79683",
      "sourceShabadId": "7719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੰਗੀਤ ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "sa(n)geet naraaj chha(n)dh ||",
      "translation": "SANGEET NARAAJ STANZA",
      "punjabiViakhya": "ਸੰਗੀਤ ਨਰਾਜ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "संगीत नराज छंद ॥",
      "sourceLineId": "79684",
      "sourceShabadId": "7720",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕੜਾ ਕੜੀ ਕ੍ਰਿਪਾਣਯੰ ॥",
      "transliteration": "kaRaa kaRee kirapaanaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਨਾ ਦੀ ਕੜ-ਕੜ ਦੀ (ਆਵਾਜ਼) ਹੁੰਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "कड़ा कड़ी कृपाणयं ॥",
      "sourceLineId": "79685",
      "sourceShabadId": "7720",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਟਾ ਜੁਟੀ ਜੁਆਣਯੰ ॥",
      "transliteration": "jaTaa juTee juaanaya(n) ||",
      "translation": "Alongwith the clattering of swords, the daggers are striking fastly.",
      "punjabiViakhya": "ਜੁਆਨ (ਇਕ-ਦੂਜੇ ਨਾਲ) ਗੁਥਮ ਗੁਥਾ ਹੋ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "जटा जुटी जुआणयं ॥",
      "sourceLineId": "79686",
      "sourceShabadId": "7720",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੁਬੀਰ ਜਾਗੜਦੰ ਜਗੇ ॥",
      "transliteration": "subeer jaagaRadha(n) jage ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਵੀਰ ਉਤੇਜਿਤ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "सुबीर जागड़दं जगे ॥",
      "sourceLineId": "79687",
      "sourceShabadId": "7720",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਲੜਾਕ ਲਾਗੜਦੰ ਪਗੇ ॥੧੯॥੧੭੫॥",
      "transliteration": "laRaak laagaRadha(n) page ||19||175||",
      "translation": "The heroic warriors have been inspired to face the fighters. 19.175.",
      "punjabiViakhya": "ਅਤੇ ਲੜਾਕਿਆਂ ਨਾਲ ਆ ਕੇ ਲੜ ਰਹੇ ਸਨ ॥੧੯॥੧੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "लड़ाक लागड़दं पगे ॥१९॥१७५॥",
      "sourceLineId": "79688",
      "sourceShabadId": "7720",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "79689",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0113_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਝਮੀ ਤੇਗ ਝਟੰ ॥",
      "transliteration": "jhamee teg jhaTa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਝਟ-ਪਟ ਤੇਗਾ ਚਮਕਾਉਾਂਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 113,
      "hindi": "",
      "hindiTransliteration": "झमी तेग झटं ॥",
      "sourceLineId": "79690",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
