{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 114,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0114_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਛੁਰੀ ਛਿਪ੍ਰ ਛੁਟੰ ॥",
      "transliteration": "chhuree chhipr chhuTa(n) ||",
      "translation": "The striking swords are glistening and the daggers are striking fastly.",
      "punjabiViakhya": "ਛੁਰੀਆਂ ਨੂੰ ਤੇਜ਼ੀ ਨਾਲ ਚਲਾਉਾਂਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "छुरी छिप्र छुटं ॥",
      "sourceLineId": "79691",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗੁਰੰ ਗੁਰਜ ਗਟੰ ॥",
      "transliteration": "gura(n) guraj gaTa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਰੀ (ਗੁਰੰ) ਗੁਰਜਾ ਨੂੰ ਗਟ-ਗਟ ਕਰਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "गुरं गुरज गटं ॥",
      "sourceLineId": "79692",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪਲੰਗੰ ਪਿਸਟੰ ॥੨੦॥੧੭੬॥",
      "transliteration": "pala(n)ga(n) pisaTa(n) ||20||176||",
      "translation": "The brave warriors are giving blows of maces on the back of the lion.20.176.",
      "punjabiViakhya": "ਸ਼ੇਰ ਦੀ ਪਿਠ ਉਤੇ ਮਾਰਦੇ ਸਨ ॥੨੦॥੧੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "पलंगं पिसटं ॥२०॥१७६॥",
      "sourceLineId": "79693",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਿਤੇ ਸ੍ਰੋਣ ਚਟੰ ॥",
      "transliteration": "kite sron chaTa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ (ਗਿਦੜ ਆਦਿ ਸੂਰਮਿਆਂ ਦਾ) ਲਹੂ ਚਟ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "किते स्रोण चटं ॥",
      "sourceLineId": "79694",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਿਤੇ ਸੀਸ ਫੁਟੰ ॥",
      "transliteration": "kite sees fuTa(n) ||",
      "translation": "Somewhere the blood is being drunk, somewhere the head is lying broken.",
      "punjabiViakhya": "ਕਿਤੇ ਸਿਰ ਫੁਟੇ ਪਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "किते सीस फुटं ॥",
      "sourceLineId": "79695",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਹੂੰ ਹੂਹ ਛੁਟੰ ॥",
      "transliteration": "kahoo(n) hooh chhuTa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਹਲਾ-ਗੁਲਾ ਹੋ ਰਿਹਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "कहूँ हूह छुटं ॥",
      "sourceLineId": "79696",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਹੂੰ ਬੀਰ ਉਠੰ ॥੨੧॥੧੭੭॥",
      "transliteration": "kahoo(n) beer uTha(n) ||21||177||",
      "translation": "Somewhere there is din and somewhere the heroes are rising again.21.177.",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਵੀਰ ਯੋਧੇ ਫਿਰ ਉਠ ਖੜੋਤੇ ਸਨ ॥੨੧॥੧੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "कहूँ बीर उठं ॥२१॥१७७॥",
      "sourceLineId": "79697",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਹੂੰ ਧੂਰਿ ਲੁਟੰ ॥",
      "transliteration": "kahoo(n) dhoor luTa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ (ਸੂਰਮੇ) ਧੂੜ ਵਿਚ ਲੇਟੇ ਪਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "कहूँ धूरि लुटं ॥",
      "sourceLineId": "79698",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਿਤੇ ਮਾਰ ਰਟੰ ॥",
      "transliteration": "kite maar raTa(n) ||",
      "translation": "Somewhere the warriors are lying in the dust, somewhere there is repetition of the shouts of “kill, kill”.",
      "punjabiViakhya": "ਕਿਤੇ ਮਾਰੋ-ਮਾਰੋ ਬੋਲ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "किते मार रटं ॥",
      "sourceLineId": "79699",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਭਣੈ ਜਸ ਭਟੰ ॥",
      "transliteration": "bhanai jas bhaTa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਭੱਟ ਲੋਕ ਯਸ਼ ਗਾ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "भणै जस भटं ॥",
      "sourceLineId": "79700",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਿਤੇ ਪੇਟ ਫਟੰ ॥੨੨॥੧੭੮॥",
      "transliteration": "kite peT faTa(n) ||22||178||",
      "translation": "Somewhere the minstrels are eulogizing the warriors and somewhere warriors with wounded bellies are lying down.22.178.",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਪਾਟੇ ਹੋਏ ਪੇਟ ਪਏ ਸਨ ॥੨੨॥੧੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "किते पेट फटं ॥२२॥१७८॥",
      "sourceLineId": "79701",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਜੇ ਛਤ੍ਰਿ ਥਟੰ ॥",
      "transliteration": "bhaje chhatr thaTa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਛਤਰਾ ਨੂੰ ਧਾਰਨ ਕਰਨ ਵਾਲੇ ਭਜੇ ਜਾਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "भजे छतृ थटं ॥",
      "sourceLineId": "79702",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਿਤੇ ਖੂਨ ਖਟੰ ॥",
      "transliteration": "kite khoon khaTa(n) ||",
      "translation": "The bearers of canopies are running away and somewhere the blood is being flowin.",
      "punjabiViakhya": "ਕਿਤੇ ਖੂਨ ਵਹਾਇਆ ਜਾ ਰਿਹਾ ਸੀ ('ਖਟੰ')",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "किते खून खटं ॥",
      "sourceLineId": "79703",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਿਤੇ ਦੁਸਟ ਦਟੰ ॥",
      "transliteration": "kite dhusaT dhaTa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਦੁਸ਼ਟਾ ਨੂੰ ਨਸ਼ਟ ਕੀਤਾ ਜਾ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "किते दुसट दटं ॥",
      "sourceLineId": "79704",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਫਿਰੇ ਜ੍ਯੋ ਹਰਟੰ ॥੨੩॥੧੭੯॥",
      "transliteration": "fire jayo haraTa(n) ||23||179||",
      "translation": "Somewhere the tyrants are being destroyed and the warriors are running hither and thither like the Persian wheel.23.179.",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ (ਵੀਰ ਯੋਧੇ) ਹਰਟ ਵਾਗ ਫਿਰ ਰਹੇ ਹਨ ॥੨੩॥੧੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "फिरे ज्यो हरटं ॥२३॥१७९॥",
      "sourceLineId": "79705",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਜੇ ਸੂਰ ਸਾਰੇ ॥",
      "transliteration": "saje soor saare ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਸੂਰਵੀਰ ਸਜੇ ਹੋਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "सजे सूर सारे ॥",
      "sourceLineId": "79706",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਹਿਖੁਆਸ ਧਾਰੇ ॥",
      "transliteration": "mahikhuaas dhaare ||",
      "translation": "All the warriors are bedecked with the bow",
      "punjabiViakhya": "(ਹੱਥ ਵਿਚ) ਧਨੁਸ਼ ('ਮਹਿਖੁਆਸ') ਧਾਰੇ ਹੋਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "महिखुआस धारे ॥",
      "sourceLineId": "79707",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਲਏ ਖਗਆਰੇ ॥",
      "transliteration": "le khagaare ||",
      "translation": "",
      "punjabiViakhya": "(ਹੱਥ ਵਿਚ) ਤਿਖੇ ਖੰਡੇ ਲਏ ਹੋਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "लए खगआरे ॥",
      "sourceLineId": "79708",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਹਾ ਰੋਹ ਵਾਰੇ ॥੨੪॥੧੮੦॥",
      "transliteration": "mahaa roh vaare ||24||180||",
      "translation": "And all of them are holding their swords like the dreadful saw.24.180.",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਕ੍ਰੋਧ ਵਾਲੇ ਸਨ ॥੨੪॥੧੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "महा रोह वारे ॥२४॥१८०॥",
      "sourceLineId": "79709",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਹੀ ਰੂਪ ਕਾਰੇ ॥",
      "transliteration": "sahee roop kaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਠੀਕ ਇਸ ਤਰ੍ਹਾ ਦੇ ਕਾਲੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "सही रूप कारे ॥",
      "sourceLineId": "79710",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਨੋ ਸਿੰਧੁ ਖਾਰੇ ॥",
      "transliteration": "mano si(n)dh khaare ||",
      "translation": "They are verily of dark complexion like the saltish sea.",
      "punjabiViakhya": "ਮਾਨੋ ਖਾਰਾ ਸਮੁੰਦਰ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "मनो सिंधु खारे ॥",
      "sourceLineId": "79711",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਈ ਬਾਰ ਗਾਰੇ ॥",
      "transliteration": "kiee baar gaare ||",
      "translation": "",
      "punjabiViakhya": "(ਭਾਵੇਾਂ ਦੁਰਗਾ ਨੇ ਉਨ੍ਹਾ ਨੂੰ) ਕਈ ਵਾਰ ਨਸ਼ਟ ਕੀਤਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "कई बार गारे ॥",
      "sourceLineId": "79712",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੁ ਮਾਰੰ ਉਚਾਰੇ ॥੨੫॥੧੮੧॥",
      "transliteration": "s maara(n) uchaare ||25||181||",
      "translation": "Though they have been destroyed several times, but still they are shouting “kill, kill”.25.181.",
      "punjabiViakhya": "(ਪਰ ਉਹ ਫਿਰ ਵੀ) ਮਾਰੋ-ਮਾਰੋ ਪੁਕਾਰਦੇ ਸਨ ॥੨੫॥੧੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "सु मारं उचारे ॥२५॥१८१॥",
      "sourceLineId": "79713",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭਵਾਨੀ ਪਛਾਰੇ ॥",
      "transliteration": "bhavaanee pachhaare ||",
      "translation": "",
      "punjabiViakhya": "ਭਵਾਨੀ ਨੇ (ਉਨ੍ਹਾ ਨੂੰ) ਪਛਾੜ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "भवानी पछारे ॥",
      "sourceLineId": "79714",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਵਾ ਜੇਮਿ ਜਾਰੇ ॥",
      "transliteration": "javaa jem jaare ||",
      "translation": "Bhavani (Durga) hath destroyed all like the jawahan plant destroyed by the continuous rain.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਜਵਾਹੇ ਨੂੰ (ਚੌਮਾਸੇ ਦੀ ਬਰਖਾ) ਸਾੜ ਦਿੰਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "जवा जेमि जारे ॥",
      "sourceLineId": "79715",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਡੇਈ ਲੁਝਾਰੇ ॥",
      "transliteration": "baddeiee lujhaare ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੜੇ ਬਹੁਤ ਲੜਾਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "बडेई लुझारे ॥",
      "sourceLineId": "79716",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹੁਤੇ ਜੇ ਹੀਏ ਵਾਰੇ ॥੨੬॥੧੮੨॥",
      "transliteration": "hute je he'ee vaare ||26||182||",
      "translation": "Many other brave demons have been crushed under her feet.26.182.",
      "punjabiViakhya": "ਅਤੇ ਤਕੜੇ ਹੌਂਸਲੇ ਵਾਲੇ ਸਨ ॥੨੬॥੧੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "हुते जे हीए वारे ॥२६॥१८२॥",
      "sourceLineId": "79717",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਕੰ ਬਾਰ ਟਾਰੇ ॥",
      "transliteration": "eika(n) baar Taare ||",
      "translation": "",
      "punjabiViakhya": "(ਦੇਵੀ ਨੇ ਦੈਂਤ ਵੀਰਾ ਨੂੰ) ਇਕ ਵਾਰ ਤਾ ਉਖਾੜ ਸੁਟਿਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "इकं बार टारे ॥",
      "sourceLineId": "79718",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਠਮੰ ਠੋਕਿ ਠਾਰੇ ॥",
      "transliteration": "Thama(n) Thok Thaare ||",
      "translation": "The enemies have been destroyed in the first round and thrown away. They have been struck on their bodies with weapons and made cool (by death).",
      "punjabiViakhya": "ਅਤੇ ਮਾਰ-ਮਾਰ ਕੇ ਠੰਡਾ ਕਰ ਦਿੱਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "ठमं ठोकि ठारे ॥",
      "sourceLineId": "79719",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਲੀ ਮਾਰ ਡਾਰੇ ॥",
      "transliteration": "balee maar ddaare ||",
      "translation": "",
      "punjabiViakhya": "(ਬੜੇ ਬੜੇ) ਬਲਵਾਨਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "बली मार डारे ॥",
      "sourceLineId": "79720",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਢਮਕੇ ਢਢਾਰੇ ॥੨੭॥੧੮੩॥",
      "transliteration": "ddamake ddaddaare ||27||183||",
      "translation": "Many mighty warriors have been killed and the sound of the drums is continuously being heard.27.183.",
      "punjabiViakhya": "ਢੱਢਾ ਦੀ ਢੰਮ ਢੰਮ ਦੀ (ਧੁਨੀ ਲਗਾਤਾਰ ਹੋ ਰਹੀ ਹੈ) ॥੨੭॥੧੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "ढमके ढढारे ॥२७॥१८३॥",
      "sourceLineId": "79721",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਹੇ ਬਾਣਣਿਆਰੇ ॥",
      "transliteration": "bahe baananiaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਣੀਆਰੇ ਤੀਰ ਚਲਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "बहे बाणणिआरे ॥",
      "sourceLineId": "79722",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਿਤੈ ਤੀਰ ਤਾਰੇ ॥",
      "transliteration": "kitai teer taare ||",
      "translation": "Wonderful type of arrows have been shot and because of them many fighters have expired.",
      "punjabiViakhya": "(ਉਨ੍ਹਾ) ਤੀਰਾ ਨੇ ਕਿਤਨੇ (ਯੁੱਧਵੀਰ) (ਯੁੱਧ ਰੂਪੀ ਨਦੀ ਤੋਂ) ਪਾਰ ਕਰ ਦਿੱਤੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "कितै तीर तारे ॥",
      "sourceLineId": "79723",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਲਖੇ ਹਾਥ ਬਾਰੇ ॥",
      "transliteration": "lakhe haath baare ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਬਲਵਾਨ ਯੋਧੇ (ਦੇਵੀ ਨੂੰ) ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "लखे हाथ बारे ॥",
      "sourceLineId": "79724",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦਿਵਾਨੇ ਦਿਦਾਰੇ ॥੨੮॥੧੮੪॥",
      "transliteration": "dhivaane dhidhaare ||28||184||",
      "translation": "When the demon-warriors of great might saw the goddess in person, they became senseless.28.184",
      "punjabiViakhya": "ਸੁੱਧ-ਬੁੱਧ ਭੁਲਾ ਬੈਠੇ ਸਨ ॥੨੮॥੧੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "दिवाने दिदारे ॥२८॥१८४॥",
      "sourceLineId": "79725",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹਣੇ ਭੂਮਿ ਪਾਰੇ ॥",
      "transliteration": "hane bhoom paare ||",
      "translation": "",
      "punjabiViakhya": "(ਦੇਵੀ ਨੇ) ਕਈਆਂ (ਦੈਂਤਾ) ਨੂੰ ਮਾਰ ਕੇ ਭੂਮੀ ਉਤੇ ਪਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "हणे भूमि पारे ॥",
      "sourceLineId": "79726",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਿਤੇ ਸਿੰਘ ਫਾਰੇ ॥",
      "transliteration": "kite si(n)gh faare ||",
      "translation": "Many brave fighters were torn by the lion and thrown on the ground.",
      "punjabiViakhya": "ਅਤੇ ਕਈਆਂ ਨੂੰ ਸ਼ੇਰ ਨੇ ਪਾੜ ਸੁਟਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "किते सिंघ फारे ॥",
      "sourceLineId": "79727",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਿਤੇ ਆਪੁ ਬਾਰੇ ॥",
      "transliteration": "kite aap baare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਵਡੇ ਵਡੇ ਹੰਕਾਰੀ ਦੈਂਤਾ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "किते आपु बारे ॥",
      "sourceLineId": "79728",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਿਤੇ ਦੈਤ ਭਾਰੇ ॥੨੯॥੧੮੫॥",
      "transliteration": "jite dhait bhaare ||29||185||",
      "translation": "And many huge demons were personally killed and destroyed by the goddess.29.185.",
      "punjabiViakhya": "(ਦੇਵੀ ਨੇ) ਆਪ ਜਿਤ ਲਿਆ ॥੨੯॥੧੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "जिते दैत भारे ॥२९॥१८५॥",
      "sourceLineId": "79729",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਿਤੇ ਅੰਤ ਹਾਰੇ ॥",
      "transliteration": "tite a(n)t haare ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸਾਰੇ ਅੰਤ ਨੂੰ ਹਾਰ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "तिते अंत हारे ॥",
      "sourceLineId": "79730",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਡੇਈ ਅੜਿਆਰੇ ॥",
      "transliteration": "baddeiee aRiaare ||",
      "translation": "Many real heroes who stuck fast before the goddess.",
      "punjabiViakhya": "ਜਿਹੜੇ ਬਹੁਤ ਅੜੀਅਲ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "बडेई अड़िआरे ॥",
      "sourceLineId": "79731",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਖਰੇਈ ਬਰਿਆਰੇ ॥",
      "transliteration": "khareiee bariaare ||",
      "translation": "",
      "punjabiViakhya": "ਖਰੂਦੀ ਅਤੇ ਧਕਾ ਕਰਨ ਵਾਲੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "खरेई बरिआरे ॥",
      "sourceLineId": "79732",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਰੂਰੰ ਕਰਾਰੇ ॥੩੦॥੧੮੬॥",
      "transliteration": "karoora(n) karaare ||30||186||",
      "translation": "And who were extremely hard-hearted and renowned for their mercilessness ultimately ran away.30.186.",
      "punjabiViakhya": "ਕਠੋਰ ਅਤੇ ਜ਼ਾਲਮ ਸਨ ॥੩੦॥੧੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "करूरं करारे ॥३०॥१८६॥",
      "sourceLineId": "79733",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਲਪਕੇ ਲਲਾਹੇ ॥",
      "transliteration": "lapake lalaahe ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਹਾ ਦੇ) ਮੱਥੇ ਚਮਕਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "लपके ललाहे ॥",
      "sourceLineId": "79734",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਰੀਲੇ ਅਰਿਆਰੇ ॥",
      "transliteration": "areele ariaare ||",
      "translation": "The egoist warriors with brightened faces who ran forward.",
      "punjabiViakhya": "ਅੜੀਅਲ ਅਤੇ ਆਕੜਖਾਨ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "अरीले अरिआरे ॥",
      "sourceLineId": "79735",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਣੇ ਕਾਲ ਕਾਰੇ ॥",
      "transliteration": "hane kaal kaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਹਾ) ਕਾਲਿਆਂ (ਦੈਂਤਾ) ਨੂੰ ਕਾਲਕਾ ਨੇ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "हणे काल कारे ॥",
      "sourceLineId": "79736",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭਜੇ ਰੋਹ ਵਾਰੇ ॥੩੧॥੧੮੭॥",
      "transliteration": "bhaje roh vaare ||31||187||",
      "translation": "And also the mighty and furious heroes were killed by the dreadful death.31.187.",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਕ੍ਰੋਧ ਕਰਨ ਵਾਲੇ (ਰਣਭੂਮੀ ਵਿਚੋਂ) ਭਜ ਗਏ ॥੩੧॥੧੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "भजे रोह वारे ॥३१॥१८७॥",
      "sourceLineId": "79737",
      "sourceShabadId": "7721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "79738",
      "sourceShabadId": "7722",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਦੁਸਟ ਪ੍ਰਜਾਰ ਕੈ ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਕਰਿ ਲੀਨ ॥",
      "transliteration": "eeh bidh dhusaT prajaar kai sasatr asatr kar leen ||",
      "translation": "In this way, destroying the tyrants, Durga again wore her weapons and armour.",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਹਾ ਦੁਸ਼ਟਾ ਨੂੰ ਨਸ਼ਟ ਕਰ ਕੇ (ਦੇਵੀ ਨੇ) ਹੱਥ ਵਿਚ ਅਸਤ੍ਰ ਅਤੇ ਸ਼ਸਤ੍ਰ ਫੜ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "इह बिधि दुसट प्रजार कै ससत्र असत्र करि लीन ॥",
      "sourceLineId": "79739",
      "sourceShabadId": "7722",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਬਾਣ ਬੂੰਦ ਪ੍ਰਿਥਮੈ ਬਰਖ ਸਿੰਘ ਨਾਦ ਪੁਨਿ ਕੀਨ ॥੩੨॥੧੮੮॥",
      "transliteration": "baan boo(n)dh pirathamai barakh si(n)gh naadh pun keen ||32||188||",
      "translation": "At first she showered her arrows and then her lion roared heavily.32.188.",
      "punjabiViakhya": "ਪਹਿਲਾ (ਬਰਖਾ ਦੀਆਂ) ਬੂੰਦਾ ਵਾਗ ਬਾਣਾ (ਦੀ ਵਾਛੜ ਲਾਈ) ਅਤੇ ਫਿਰ ਸਿੰਘ-ਨਾਦ ਕੀਤਾ ॥੩੨॥੧੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "बाण बूँद पृथमै बरख सिंघ नाद पुनि कीन ॥३२॥१८८॥",
      "sourceLineId": "79740",
      "sourceShabadId": "7722",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "79741",
      "sourceShabadId": "7723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸੁਣਿਯੋ ਸੁੰਭ ਰਾਯੰ ॥",
      "transliteration": "suniyo su(n)bh raaya(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦੋਂ) ਸੁੰਭ ਰਾਜੇ ਨੇ (ਇਹ) ਸੁਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "सुणियो सुँभ रायं ॥",
      "sourceLineId": "79742",
      "sourceShabadId": "7723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਚੜਿਯੋ ਚਉਪ ਚਾਯੰ ॥",
      "transliteration": "chaRiyo chaup chaaya(n) ||",
      "translation": "When the demon-king Sumbh heard all that had happened, he marched forward in great excitement.",
      "punjabiViakhya": "ਤਾ ਬੜੇ ਉਤਸਾਹ ਨਾਲ (ਜੰਗ ਕਰਨ ਲਈ) ਚੜ੍ਹ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "चड़ियो चउप चायं ॥",
      "sourceLineId": "79743",
      "sourceShabadId": "7723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਜੇ ਸਸਤ੍ਰ ਪਾਣੰ ॥",
      "transliteration": "saje sasatr paana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੱਥਾ ਵਿਚ ਸ਼ਸਤ੍ਰ ਸਜਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "सजे ससत्र पाणं ॥",
      "sourceLineId": "79744",
      "sourceShabadId": "7723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਚੜੇ ਜੰਗਿ ਜੁਆਣੰ ॥੩੩॥੧੮੯॥",
      "transliteration": "chaRe ja(n)g juaana(n) ||33||189||",
      "translation": "His soldiers bedecked with weapons came forward to wage war.33.189.",
      "punjabiViakhya": "(ਦੈਂਤ) ਸੈਨਿਕ ਯੁੱਧ ਲਈ ਨਿਕਲ ਪਏ ॥੩੩॥੧੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "चड़े जंगि जुआणं ॥३३॥१८९॥",
      "sourceLineId": "79745",
      "sourceShabadId": "7723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਲਗੈ ਢੋਲ ਢੰਕੇ ॥",
      "transliteration": "lagai ddol dda(n)ke ||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲਾ ਉਤੇ ਡਗੇ ਵਜਣ ਲਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "लगै ढोल ढंके ॥",
      "sourceLineId": "79746",
      "sourceShabadId": "7723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਕਮਾਣੰ ਕੜੰਕੇ ॥",
      "transliteration": "kamaana(n) kaRa(n)ke ||",
      "translation": "The sound created by drums, bows",
      "punjabiViakhya": "ਕਮਾਨਾ ਕੜਕਣ ਲਗੀਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "कमाणं कड़ंके ॥",
      "sourceLineId": "79747",
      "sourceShabadId": "7723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਭਏ ਨਦ ਨਾਦੰ ॥",
      "transliteration": "bhe nadh naadha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਧੌਂਸਿਆ ਦੇ ਨਾਦ ਹੋਣ ਲਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "भए नद नादं ॥",
      "sourceLineId": "79748",
      "sourceShabadId": "7723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਧੁਣੰ ਨਿਰਬਿਖਾਦੰ ॥੩੪॥੧੯੦॥",
      "transliteration": "dhuna(n) nirabikhaadha(n) ||34||190||",
      "translation": "And trumpets were continuously heard.34.190.",
      "punjabiViakhya": "(ਅਤੇ ਉਨ੍ਹਾ ਦੀ) ਧੁਨੀ ਲਗਾਤਾਰ ਹੋਣ ਲਗੀ ॥੩੪॥੧੯੦॥",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "धुणं निरबिखादं ॥३४॥१९०॥",
      "sourceLineId": "79749",
      "sourceShabadId": "7723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਚਮਕੀ ਕ੍ਰਿਪਾਣੰ ॥",
      "transliteration": "chamakee kirapaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਨਾ ਚਮਕ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "चमकी कृपाणं ॥",
      "sourceLineId": "79750",
      "sourceShabadId": "7723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਹਠੇ ਤੇਜ ਮਾਣੰ ॥",
      "transliteration": "haThe tej maana(n) ||",
      "translation": "The swords of the persistent and renowned fighters glistened.",
      "punjabiViakhya": "ਹਠੀ ਯੋਧੇ (ਆਪਣੇ) ਤੇਜ ਉਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "हठे तेज माणं ॥",
      "sourceLineId": "79751",
      "sourceShabadId": "7723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਮਹਾਬੀਰ ਹੁੰਕੇ ॥",
      "transliteration": "mahaabeer hu(n)ke ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਣ ਕਰ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "महाबीर हुँके ॥",
      "sourceLineId": "79752",
      "sourceShabadId": "7723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਸੁ ਨੀਸਾਣ ਦ੍ਰੁੰਕੇ ॥੩੫॥੧੯੧॥",
      "transliteration": "s neesaan dhru(n)ke ||35||191||",
      "translation": "The great heroes raised loud shouts and the trumpets sounded.35.191.",
      "punjabiViakhya": "ਧੌਂਸਿਆਂ ਦੀ ਗੂੰਜ ਉਠ ਰਹੀ ਸੀ ॥੩੫॥੧੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "सु नीसाण द्रुँके ॥३५॥१९१॥",
      "sourceLineId": "79753",
      "sourceShabadId": "7723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਚਹੂੰ ਓਰ ਗਰਜੇ ॥",
      "transliteration": "chahoo(n) or garaje ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ (ਦੈਂਤ) ਗਰਜ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "चहूँ ओर गरजे ॥",
      "sourceLineId": "79754",
      "sourceShabadId": "7723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਸਬੇ ਦੇਵ ਲਰਜੇ ॥",
      "transliteration": "sabe dhev laraje ||",
      "translation": "The demons thundered from all the four sides and the gods collectively trembled.",
      "punjabiViakhya": "ਸਾਰੇ ਦੇਵਤੇ ਕੰਬ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "सबे देव लरजे ॥",
      "sourceLineId": "79755",
      "sourceShabadId": "7723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਸਰੰ ਧਾਰ ਬਰਖੇ ॥",
      "transliteration": "sara(n) dhaar barakhe ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣਾ ਦੀ ਬਰਖਾ ਹੋ ਰਹੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "सरं धार बरखे ॥",
      "sourceLineId": "79756",
      "sourceShabadId": "7723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਮਈਯਾ ਪਾਣ ਪਰਖੇ ॥੩੬॥੧੯੨॥",
      "transliteration": "mieeyaa paan parakhe ||36||192||",
      "translation": "Showering her arrows Durga herself is testing the dtength of all.36.192.",
      "punjabiViakhya": "ਮਾਤਾ ਦੁਰਗਾ ਦੇ ਹੱਥਾ (ਦਾ ਮਜ਼ਾ ਦੈਂਤ) ਚਖ ਰਹੇ ਸਨ ॥੩੬॥੧੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "मईया पाण परखे ॥३६॥१९२॥",
      "sourceLineId": "79757",
      "sourceShabadId": "7723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "79758",
      "sourceShabadId": "7724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਜੇ ਲਏ ਸਸਤ੍ਰ ਸਾਮੁਹੇ ਧਏ ॥",
      "transliteration": "je le sasatr saamuhe dhe ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੜੇ (ਦੈਂਤ) ਸ਼ਸਤ੍ਰ ਲੈ ਕੇ (ਦੁਰਗਾ ਦੇ) ਸਾਹਮਣੇ ਆਏ,",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "जे लए ससत्र सामुहे धए ॥",
      "sourceLineId": "79759",
      "sourceShabadId": "7724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਤਿਤੇ ਨਿਧਨ ਕਹੁੰ ਪ੍ਰਾਪਤਿ ਭਏ ॥",
      "transliteration": "tite nidhan kahu(n) praapat bhe ||",
      "translation": "All those demons, carrying their weapons, came in front of the goddess were all subjected to death.",
      "punjabiViakhya": "ਉਨ੍ਹਾ (ਸਾਰਿਆਂ ਦੀ) ਮ੍ਰਿਤੂ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "तिते निधन कहुँ प्रापति भए ॥",
      "sourceLineId": "79760",
      "sourceShabadId": "7724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਝਮਕਤ ਭਈ ਅਸਨ ਕੀ ਧਾਰਾ ॥",
      "transliteration": "jhamakat bhiee asan kee dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਨਾ ('ਅਸਨ') ਦੀ ਧਾਰ ਚਮਕਾ ਮਾਰ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "झमकत भई असन की धारा ॥",
      "sourceLineId": "79761",
      "sourceShabadId": "7724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0114_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਭਭਕੇ ਰੁੰਡ ਮੁੰਡ ਬਿਕਰਾਰਾ ॥੩੭॥੧੯੩॥",
      "transliteration": "bhabhake ru(n)dd mu(n)dd bikaraaraa ||37||193||",
      "translation": "The edges of the swords are glistening and the headless trunks, in dreadful forms are raising their voices.37.193.",
      "punjabiViakhya": "ਸਿਰ ਅਤੇ ਧੜ ਭਿਆਨਕ ਢੰਗ ਨਾਲ ਭਬਕ ਰਹੇ ਸਨ ॥੩੭॥੧੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 114,
      "hindi": "",
      "hindiTransliteration": "भभके रुँड मुँड बिकरारा ॥३७॥१९३॥",
      "sourceLineId": "79762",
      "sourceShabadId": "7724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
