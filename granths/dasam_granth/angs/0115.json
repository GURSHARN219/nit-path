{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 115,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0115_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "79763",
      "sourceShabadId": "7725",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਹੈ ਗੈ ਰਥ ਪੈਦਲ ਕਟੇ ਬਚਿਯੋ ਨ ਜੀਵਤ ਕੋਇ ॥",
      "transliteration": "hai gai rath paidhal kaTe bachiyo na jeevat koi ||",
      "translation": "The elephants, horses and warriors on foot were all chopped and none could survive.",
      "punjabiViakhya": "ਘੋੜੇ, ਹਾਥੀ, ਰਥ ਅਤੇ ਪੈਦਲ (ਚੌਹਾ ਤਰ੍ਹਾ ਦੀ ਸੈਨਾ) ਕਟ ਦਿੱਤੀ ਗਈ ਸੀ (ਉਨ੍ਹਾ ਵਿਚੋਂ) ਕੋਈ ਵੀ ਜਿਉਾਂਦਾ ਨਹੀਂ ਬਚਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "है गै रथ पैदल कटे बचियो न जीवत कोइ ॥",
      "sourceLineId": "79764",
      "sourceShabadId": "7725",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਬ ਆਪੇ ਨਿਕਸਿਯੋ ਨ੍ਰਿਪਤਿ ਸੁੰਭ ਕਰੈ ਸੋ ਹੋਇ ॥੩੮॥੧੯੪॥",
      "transliteration": "tab aape nikasiyo nirapat su(n)bh karai so hoi ||38||194||",
      "translation": "Then the king Sumbh himself marched forward for war and on seeing him it appears that whatever he desires, he will achive.38.194.",
      "punjabiViakhya": "ਤਦ ਦੈਂਤ ਰਾਜਾ ਆਪ ਨਿਤਰਿਆ। (ਇੰਜ ਪ੍ਰਤੀਤ ਹੋਣ ਲਗਾ ਕਿ ਹੁਣ ਜੋ ਉਹ ਕਰੇਗਾ) ਉਹੀ ਹੋਏਗਾ ॥੩੮॥੧੯੪॥",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "तब आपे निकसियो नृपति सुँभ करै सो होइ ॥३८॥१९४॥",
      "sourceLineId": "79765",
      "sourceShabadId": "7725",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "79766",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਿਵ ਦੂਤੀ ਇਤਿ ਦ੍ਰੁਗਾ ਬੁਲਾਈ ॥",
      "transliteration": "siv dhootee it dhrugaa bulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵੀ ਦੁਰਗਾ ਨੇ ਆਪਣੇ ਕੋਲ ਸ਼ਿਵ-ਦੂਤੀ ਨੂੰ ਬੁਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "सिव दूती इति द्रुगा बुलाई ॥",
      "sourceLineId": "79767",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਾਨ ਲਾਗਿ ਨੀਕੈ ਸਮੁਝਾਈ ॥",
      "transliteration": "kaan laag neekai samujhaiee ||",
      "translation": "On this side, Durga after reflecting, called a female messenger of Shiva and making her conscious gave this message in her ear:",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਕੰਨ ਵਿਚ (ਇਹ ਗੱਲ) ਚੰਗੀ ਤਰ੍ਹਾ ਸਮਝਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "कान लागि नीकै समुझाई ॥",
      "sourceLineId": "79768",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਿਵ ਕੋ ਭੇਜ ਦੀਜੀਐ ਤਹਾ ॥",
      "transliteration": "siv ko bhej dheejeeaai tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਸ਼ਿਵ ਨੂੰ ਉਥੇ ਭੇਜ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "सिव को भेज दीजीऐ तहा ॥",
      "sourceLineId": "79769",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੈਤ ਰਾਜ ਇਸਥਿਤ ਹੈ ਜਹਾ ॥੩੯॥੧੯੫॥",
      "transliteration": "dhait raaj isathit hai jahaa ||39||195||",
      "translation": "“Send Lord Shiva to the place, where the demon-king is standing.”39.195.",
      "punjabiViakhya": "ਜਿਥੇ ਦੈਂਤ-ਰਾਜਾ ਖੜੋਤਾ ਹੈ ॥੩੯॥੧੯੫॥",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "दैत राज इसथित है जहा ॥३९॥१९५॥",
      "sourceLineId": "79770",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਿਵ ਦੂਤੀ ਜਬ ਇਮ ਸੁਨ ਪਾਵਾ ॥",
      "transliteration": "siv dhootee jab im sun paavaa ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ-ਦੂਤੀ ਨੇ ਜਦ ਇਹ ਸੁਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "सिव दूती जब इम सुन पावा ॥",
      "sourceLineId": "79771",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਿਵਹਿੰ ਦੂਤ ਕਰਿ ਉਤੈ ਪਠਾਵਾ ॥",
      "transliteration": "sivahi(n) dhoot kar utai paThaavaa ||",
      "translation": "When the female messenger of Shiva heard this, she sent Shiva as a messenger of Shiva",
      "punjabiViakhya": "(ਤਦ) ਸ਼ਿਵ ਨੂੰ ਦੂਤ ਬਣਾ ਕੇ ਉਥੇ ਭੇਜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "सिवहिं दूत करि उतै पठावा ॥",
      "sourceLineId": "79772",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਿਵ ਦੂਤੀ ਤਾ ਤੇ ਭਯੋ ਨਾਮਾ ॥",
      "transliteration": "siv dhootee taa te bhayo naamaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤੋਂ (ਦੁਰਗਾ ਦਾ) ਨਾ ਸ਼ਿਵ-ਦੂਤੀ ਪੈ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "सिव दूती ता ते भयो नामा ॥",
      "sourceLineId": "79773",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਾਨਤ ਸਕਲ ਪੁਰਖ ਅਰੁ ਬਾਮਾ ॥੪੦॥੧੯੬॥",
      "transliteration": "jaanat sakal purakh ar baamaa ||40||196||",
      "translation": "Since that day, the name of Durga became\" shiv- Duti\" ( the messenger of shiva ), all men and women know this.40.196.",
      "punjabiViakhya": "ਇਸ ਗੱਲ ਨੂੰ ਸਭ ਇਸਤਰੀਆਂ ਅਤੇ ਮਰਦ ਜਾਣਦੇ ਹਨ ॥੪੦॥੧੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "जानत सकल पुरख अरु बामा ॥४०॥१९६॥",
      "sourceLineId": "79774",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਿਵ ਕਹੀ ਦੈਤ ਰਾਜ ਸੁਨਿ ਬਾਤਾ ॥",
      "transliteration": "siv kahee dhait raaj sun baataa ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਨੇ (ਜਾ ਕੇ) ਕਿਹਾ ਕਿ ਹੇ ਦੈਂਤ-ਰਾਜੇ, (ਮੇਰੀ) ਗੱਲ ਸੁਣ,",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "सिव कही दैत राज सुनि बाता ॥",
      "sourceLineId": "79775",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਕਹਿਯੋ ਤੁਮਹੁ ਜਗਮਾਤਾ ॥",
      "transliteration": "eeh bidh kahiyo tumahu jagamaataa ||",
      "translation": "Shiva said to the demon-king, “Listen to my words, the mother of she universe hath said this",
      "punjabiViakhya": "ਤੈਨੂੰ ਦੁਰਗਾ ਮਾਤਾ ਨੇ ਇਸ ਤਰ੍ਹਾ ਕਿਹਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "इह बिधि कहियो तुमहु जगमाता ॥",
      "sourceLineId": "79776",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੇਵਨ ਕੇ ਦੈ ਕੈ ਠਕੁਰਾਈ ॥",
      "transliteration": "dhevan ke dhai kai Thakuraiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜਾ ਤਾ ਦੇਵਤਿਆਂ ਨੂੰ ਬਾਦਸ਼ਾਹੀ ਦੇ ਦਿਉ",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "देवन के दै कै ठकुराई ॥",
      "sourceLineId": "79777",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕੈ ਮਾਡਹੁ ਹਮ ਸੰਗ ਲਰਾਈ ॥੪੧॥੧੯੭॥",
      "transliteration": "kai maaddahu ham sa(n)g laraiee ||41||197||",
      "translation": "“That either you return the kingdom to gods or wage the war with me.”41.197.",
      "punjabiViakhya": "ਜਾ ਫਿਰ ਮੇਰੇ ਨਾਲ ਯੁੱਧ ਕਰੋ ॥੪੧॥੧੯੭॥",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "कै माडहु हम संग लराई ॥४१॥१९७॥",
      "sourceLineId": "79778",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੈਤ ਰਾਜ ਇਹ ਬਾਤ ਨ ਮਾਨੀ ॥",
      "transliteration": "dhait raaj ieh baat na maanee ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤ-ਰਾਜੇ ਨੇ ਇਹ ਗੱਲ ਨਾ ਮੰਨੀ।",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "दैत राज इह बात न मानी ॥",
      "sourceLineId": "79779",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਆਪ ਚਲੇ ਜੂਝਨ ਅਭਿਮਾਨੀ ॥",
      "transliteration": "aap chale joojhan abhimaanee ||",
      "translation": "The demon-king Sumbh did not accept this proposal and in his pride, marched forward for war.",
      "punjabiViakhya": "(ਉਹ) ਅਭਿਮਾਨੀ (ਦੁਰਗਾ ਨਾਲ) ਲੜਨ ਲਈ ਆਪ ਤੁਰ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "आप चले जूझन अभिमानी ॥",
      "sourceLineId": "79780",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗਰਜਤ ਕਾਲਿ ਕਾਲ ਜ੍ਯੋ ਜਹਾ ॥",
      "transliteration": "garajat kaal kaal jayo jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਾਲਕਾ ਕਾਲ ਵਾਗ ਗਰਜ ਰਹੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "गरजत कालि काल ज्यो जहा ॥",
      "sourceLineId": "79781",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪ੍ਰਾਪਤਿ ਭਯੋ ਅਸੁਰ ਪਤਿ ਤਹਾ ॥੪੨॥੧੯੮॥",
      "transliteration": "praapat bhayo asur pat tahaa ||42||198||",
      "translation": "The place where Kali, like death, was thundering, that demon-king reached there.42.198.",
      "punjabiViakhya": "ਉਥੇ ਦੈਂਤ-ਰਾਜਾ ਜਾ ਪਹੁੰਚਿਆ ॥੪੨॥੧੯੮॥",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "प्रापति भयो असुर पति तहा ॥४२॥१९८॥",
      "sourceLineId": "79782",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚਮਕੀ ਤਹਾ ਅਸਨ ਕੀ ਧਾਰਾ ॥",
      "transliteration": "chamakee tahaa asan kee dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਕ੍ਰਿਪਾਨਾ ਦੀ ਧਾਰ ਚਮਕ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "चमकी तहा असन की धारा ॥",
      "sourceLineId": "79783",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਾਚੇ ਭੂਤ ਪ੍ਰੇਤ ਬੈਤਾਰਾ ॥",
      "transliteration": "naache bhoot pret baitaaraa ||",
      "translation": "There the edges of sword glistened and the ghosts, goblins and evil spirits began to dance.",
      "punjabiViakhya": "ਭੂਤ, ਪ੍ਰੇਤ ਅਤੇ ਬੈਤਾਲ ਨਚਣ ਲਗ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "नाचे भूत प्रेत बैतारा ॥",
      "sourceLineId": "79784",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਫਰਕੇ ਅੰਧ ਕਬੰਧ ਅਚੇਤਾ ॥",
      "transliteration": "farake a(n)dh kaba(n)dh achetaa ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਨ੍ਹੇਵਾਹ ਧੜ ਅਚੇਤ ਹੋ ਕੇ ਤੜਫਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "फरके अंध कबंध अचेता ॥",
      "sourceLineId": "79785",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭਿਭਰੇ ਭਈਰਵ ਭੀਮ ਅਨੇਕਾ ॥੪੩॥੧੯੯॥",
      "transliteration": "bhibhare bhieerav bheem anekaa ||43||199||",
      "translation": "There the blind headless trunks came into motion senselessly. There many Bhairavas and Bhimas began to roam.43.199.",
      "punjabiViakhya": "ਅਨੇਕਾ ਭਿਆਨਕ ਅਤੇ ਵੱਡੇ ਆਕਾਰ ਵਾਲੇ ਭੈਰੋ ਬੋਲਣ ਲਗ ਗਏ ॥੪੩॥੧੯੯॥",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "भिभरे भईरव भीम अनेका ॥४३॥१९९॥",
      "sourceLineId": "79786",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤੁਰਹੀ ਢੋਲ ਨਗਾਰੇ ਬਾਜੇ ॥",
      "transliteration": "turahee ddol nagaare baaje ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਰੀਆਂ, ਢੋਲ, ਨਗਾਰੇ ਵਜਣ ਲਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "तुरही ढोल नगारे बाजे ॥",
      "sourceLineId": "79787",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਜੋਧਾ ਰਣਿ ਗਾਜੈ ॥",
      "transliteration": "bhaat bhaat jodhaa ran gaajai ||",
      "translation": "The clarionets, drums and trumpets sounded any many types.",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦੇ ਯੋਧੇ ਰਣ-ਭੂਮੀ ਵਿਚ ਗਜਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "भाति भाति जोधा रणि गाजै ॥",
      "sourceLineId": "79788",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਢਡਿ ਡਫ ਡਮਰੁ ਡੁਗਡੁਗੀ ਘਨੀ ॥",
      "transliteration": "ddadd ddaf ddamar ddugaddugee ghanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਣਗਿਣਤ ਢੱਢਾ, ਡੱਫਾ, ਡਮਰੂ ਅਤੇ ਡੁਗਡੁਗੀਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "ढडि डफ डमरु डुगडुगी घनी ॥",
      "sourceLineId": "79789",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਇ ਨਫੀਰੀ ਜਾਤ ਨ ਗਨੀ ॥੪੪॥੨੦੦॥",
      "transliteration": "nai nafeeree jaat na ganee ||44||200||",
      "translation": "The tambourines, tabors etc., were played loudly and the musical instruments like Shahnai etc., were being played in such numbers that they cannot be counted.44.200.",
      "punjabiViakhya": "ਸ਼ਹਿਨਾਈਆਂ, ਤੂਤੀਆਂ ਵਜਣ ਲਗ ਗਈਆਂ ॥੪੪॥੨੦੦॥",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "नाइ नफीरी जात न गनी ॥४४॥२००॥",
      "sourceLineId": "79790",
      "sourceShabadId": "7726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਧੁਭਾਰ ਛੰਦ ॥",
      "transliteration": "madhubhaar chha(n)dh ||",
      "translation": "MADHUBHAAR STANZA",
      "punjabiViakhya": "ਮਧੁਭਾਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "मधुभार छंद ॥",
      "sourceLineId": "79791",
      "sourceShabadId": "7727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹੁੰਕੇ ਕਿਕਾਣ ॥",
      "transliteration": "hu(n)ke kikaan ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜੇ ਹਿਣਕ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "हुँके किकाण ॥",
      "sourceLineId": "79792",
      "sourceShabadId": "7727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਧੁੰਕੇ ਨਿਸਾਣ ॥",
      "transliteration": "dhu(n)ke nisaan ||",
      "translation": "The horses are neighing and the trumpets are resounding.",
      "punjabiViakhya": "ਧੌਂਸੇ ਗੂੰਜ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "धुँके निसाण ॥",
      "sourceLineId": "79793",
      "sourceShabadId": "7727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਜੇ ਸੁ ਬੀਰ ॥",
      "transliteration": "saje su beer ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਸੱਜੇ ਹੋਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "सजे सु बीर ॥",
      "sourceLineId": "79794",
      "sourceShabadId": "7727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗਜੇ ਗਹੀਰ ॥੪੫॥੨੦੧॥",
      "transliteration": "gaje gaheer ||45||201||",
      "translation": "The bedecked warriors are roaring profoundly.45.201.",
      "punjabiViakhya": "ਗੰਭੀਰ (ਸੁਰ ਨਾਲ) ਗਜ ਰਹੇ ਸਨ ॥੪੫॥੨੦੧॥",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "गजे गहीर ॥४५॥२०१॥",
      "sourceLineId": "79795",
      "sourceShabadId": "7727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਝੁਕੇ ਨਿਝਕ ॥",
      "transliteration": "jhuke nijhak ||",
      "translation": "",
      "punjabiViakhya": "ਨਿਝੱਕ ਹੋ ਕੇ (ਇਕ ਦੂਜੇ ਉਤੇ) ਝੁਕੇ ਹੋਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "झुके निझक ॥",
      "sourceLineId": "79796",
      "sourceShabadId": "7727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਜੇ ਉਬਕ ॥",
      "transliteration": "baje ubak ||",
      "translation": "The heroes coming near unhesitatingly are striking blows and jumping.",
      "punjabiViakhya": "ਸਚੇਤ ਯੋਧੇ ('ਉਬਕ') ਭਿੜ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "बजे उबक ॥",
      "sourceLineId": "79797",
      "sourceShabadId": "7727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਜੇ ਸੁਬਾਹ ॥",
      "transliteration": "saje subaeh ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਯੋਧੇ ਸੱਜੇ ਹੋਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "सजे सुबाह ॥",
      "sourceLineId": "79798",
      "sourceShabadId": "7727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਛੈ ਉਛਾਹ ॥੪੬॥੨੦੨॥",
      "transliteration": "achhai uchhaeh ||46||202||",
      "translation": "The smart warriors fight each other and the beautiful heroes are bedecking themselves. The heavenly damsels (apsaras) are feeling inspired.46.202.",
      "punjabiViakhya": "ਅਪੱਛਰਾਵਾ ਦਾ ਉਤਸਾਹ ਵਧ ਰਿਹਾ ਸੀ ॥੪੬॥੨੦੨॥",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "अछै उछाह ॥४६॥२०२॥",
      "sourceLineId": "79799",
      "sourceShabadId": "7727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਟੇ ਕਿਕਾਣ ॥",
      "transliteration": "kaTe kikaan ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈ) ਘੋੜੇ ਕਟੇ ਪਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "कटे किकाण ॥",
      "sourceLineId": "79800",
      "sourceShabadId": "7727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਫੁਟੈ ਚਵਾਣ ॥",
      "transliteration": "fuTai chavaan ||",
      "translation": "The horses are being chopped and the faces are being torn.",
      "punjabiViakhya": "(ਕਈਆਂ ਦੇ) ਮੂੰਹ ਫਟੇ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "फुटै चवाण ॥",
      "sourceLineId": "79801",
      "sourceShabadId": "7727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੂਲੰ ਸੜਾਕ ॥",
      "transliteration": "soola(n) saRaak ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਤੇ) ਤ੍ਰਿਸ਼ੂਲ ਦੀ ਸੜਾਕ ਹੁੰਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "सूलं सड़ाक ॥",
      "sourceLineId": "79802",
      "sourceShabadId": "7727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਉਠੇ ਕੜਾਕ ॥੪੭॥੨੦੩॥",
      "transliteration": "auThe kaRaak ||47||203||",
      "translation": "The sound created by tridents are being heard. 47.203.",
      "punjabiViakhya": "ਅਤੇ (ਕਿਤੇ) ਕੜਾਕ (ਦੀ ਆਵਾਜ਼) ਉਠਦੀ ਸੀ ॥੪੭॥੨੦੩॥",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "उठे कड़ाक ॥४७॥२०३॥",
      "sourceLineId": "79803",
      "sourceShabadId": "7727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗਜੇ ਜੁਆਣ ॥",
      "transliteration": "gaje juaan ||",
      "translation": "",
      "punjabiViakhya": "ਜੁਆਨ ਗੱਜ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "गजे जुआण ॥",
      "sourceLineId": "79804",
      "sourceShabadId": "7727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਜੇ ਨਿਸਾਣਿ ॥",
      "transliteration": "baje nisaan ||",
      "translation": "The trumpets are resounding and the youthful warriors are thundering.",
      "punjabiViakhya": "ਧੌਂਸੇ ਵਜ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "बजे निसाणि ॥",
      "sourceLineId": "79805",
      "sourceShabadId": "7727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਜੇ ਰਜੇਾਂਦ੍ਰ ॥",
      "transliteration": "saje rajeaa(n)dhr ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਸਜੇ ਹੋਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "सजे रजेाँद्र ॥",
      "sourceLineId": "79806",
      "sourceShabadId": "7727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗਜੇ ਗਜੇਾਂਦ੍ਰ ॥੪੮॥੨੦੪॥",
      "transliteration": "gaje gajeaa(n)dhr ||48||204||",
      "translation": "The kings and chieftains are bedecked and the elephants are screeching.48.204.",
      "punjabiViakhya": "ਹਾਥੀਆਂ ਵਾਲੇ ਸੈਨਾਪਤੀ ਗਜ ਰਹੇ ਸਨ ॥੪੮॥੨੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "गजे गजेाँद्र ॥४८॥२०४॥",
      "sourceLineId": "79807",
      "sourceShabadId": "7727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "79808",
      "sourceShabadId": "7728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਫਿਰੇ ਬਾਜੀਯੰ ਤਾਜੀਯੰ ਇਤ ਉਤੰ ॥",
      "transliteration": "fire baajeeya(n) taajeeya(n) it uta(n) ||",
      "translation": "The beautiful horses are roaming hither and thither.",
      "punjabiViakhya": "ਉਤਮ ਅਰਬੀ ਘੋੜੇ ਇਧਰ ਉਧਰ ਫਿਰਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "फिरे बाजीयं ताजीयं इत उतं ॥",
      "sourceLineId": "79809",
      "sourceShabadId": "7728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0115_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗਜੇ ਬਾਰਣੰ ਦਾਰੁਣੰ ਰਾਜ ਪੁਤ੍ਰੰ ॥",
      "transliteration": "gaje baarana(n) dhaaruna(n) raaj putra(n) ||",
      "translation": "The elephants of the princes are roaring dreadfully.",
      "punjabiViakhya": "ਰਾਜ-ਪੁੱਤਰਾ ਦੇ ਹਾਥੀ ਭਿਆਨਕ ਢੰਗ ਨਾਲ ਗਰਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 115,
      "hindi": "",
      "hindiTransliteration": "गजे बारणं दारुणं राज पुत्रं ॥",
      "sourceLineId": "79810",
      "sourceShabadId": "7728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
