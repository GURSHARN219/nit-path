{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 116,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0116_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਜੇ ਸੰਖ ਭੇਰੀ ਉਠੈ ਸੰਖ ਨਾਦੰ ॥",
      "transliteration": "baje sa(n)kh bheree uThai sa(n)kh naadha(n) ||",
      "translation": "The sound of conches and drums is rising.",
      "punjabiViakhya": "ਭੇਰੀਆਂ ਅਤੇ ਸੰਖ ਵਜ ਰਹੇ ਹਨ ਅਤੇ ਸੰਖਾ ਵਿਚ ਨਾਦ ਨਿਕਲ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "बजे संख भेरी उठै संख नादं ॥",
      "sourceLineId": "79811",
      "sourceShabadId": "7728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਣੰਕੈ ਨਫੀਰੀ ਧੁਣ ਨਿਰਬਿਖਾਦੰ ॥੪੯॥੨੦੫॥",
      "transliteration": "rana(n)kai nafeeree dhun nirabikhaadha(n) ||49||205||",
      "translation": "The clarionets are being played continuously.49.205.",
      "punjabiViakhya": "ਤੂਤੀਆਂ ਦੀ ਧੁਨੀ ਨਿਰੰਤਰ ਚਲ ਰਹੀ ਸੀ ॥੪੯॥੨੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "रणंकै नफीरी धुण निरबिखादं ॥४९॥२०५॥",
      "sourceLineId": "79812",
      "sourceShabadId": "7728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕੜਕੇ ਕ੍ਰਿਪਾਣੰ ਸੜਕਾਰ ਸੇਲੰ ॥",
      "transliteration": "kaRake kirapaana(n) saRakaar sela(n) ||",
      "translation": "The swords and daggers are producing their sounds.",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਕੜ-ਕੜ ਕਰਦੀਆਂ ਸਨ, ਬਰਛੇ ਸੜ-ਸੜ ਕਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "कड़के कृपाणं सड़कार सेलं ॥",
      "sourceLineId": "79813",
      "sourceShabadId": "7728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਉਠੀ ਕੂਹ ਜੂਹੰ ਭਈ ਰੇਲ ਪੇਲੰ ॥",
      "transliteration": "auThee kooh jooha(n) bhiee rel pela(n) ||",
      "translation": "There is vehement run in the whole battlefield.",
      "punjabiViakhya": "ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਰੌਲਾ ਪੈ ਗਿਆ ਸੀ, ਧਕਮ-ਧਕੀ ਹੋ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "उठी कूह जूहं भई रेल पेलं ॥",
      "sourceLineId": "79814",
      "sourceShabadId": "7728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰੁਲੇ ਤਛ ਮੁਛੰ ਗਿਰੇ ਚਉਰ ਚੀਰੰ ॥",
      "transliteration": "rule tachh muchha(n) gire chaur cheera(n) ||",
      "translation": "The bodies having been chopped and the garments and fly-whisks having been torn have fallen down.",
      "punjabiViakhya": "(ਕਿਤੇ) ਸ਼ਰੀਰ ਦੇ ਟੋਟੇ ਰੁਲ ਰਹੇ ਸਨ ਅਤੇ ਕਿਤੇ ਚੌਰ ਅਤੇ ਬਸਤ੍ਰ ਡਿਗੇ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "रुले तछ मुछं गिरे चउर चीरं ॥",
      "sourceLineId": "79815",
      "sourceShabadId": "7728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਹੂੰ ਹਥ ਮਥੰ ਕਹੂੰ ਬਰਮ ਬੀਰੰ ॥੫੦॥੨੦੬॥",
      "transliteration": "kahoo(n) hath matha(n) kahoo(n) baram beera(n) ||50||206||",
      "translation": "Somewhere the hands, somewhere the foreheads and somewhere the armours are lying scattered.50.206.",
      "punjabiViakhya": "ਕਿਤੇ ਹੱਥ ਅਤੇ ਸਿਰ ਅਤੇ ਕਿਤੇ ਯੋਧਿਆਂ ਦੇ ਕਵਚ ('ਬਰਮ') (ਡਿਗੇ ਪਏ ਸਨ।) ॥੫੦॥੨੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "कहूँ हथ मथं कहूँ बरम बीरं ॥५०॥२०६॥",
      "sourceLineId": "79816",
      "sourceShabadId": "7728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "79817",
      "sourceShabadId": "7729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਲੀ ਬੈਰ ਰੁਝੇ ॥",
      "transliteration": "balee bair rujhe ||",
      "translation": "",
      "punjabiViakhya": "ਬਲਵਾਨ ਸੂਰਮੇ ਵੈਰ ਭਾਵ ਨਾਲ ਉਲਝ ਪਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "बली बैर रुझे ॥",
      "sourceLineId": "79818",
      "sourceShabadId": "7729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਮੂਹ ਸਾਰ ਜੁਝੇ ॥",
      "transliteration": "samooh saar jujhe ||",
      "translation": "The mighty enemies are busy in fighting with all their weapons.",
      "punjabiViakhya": "ਸਾਰੇ ਸ਼ਸਤ੍ਰਾ ਨਾਲ ਜੂਝ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "समूह सार जुझे ॥",
      "sourceLineId": "79819",
      "sourceShabadId": "7729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੰਭਾਰੇ ਹਥੀਯਾਰੰ ॥",
      "transliteration": "sa(n)bhaare hatheeyaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹਥਿਆਰਾ ਨੂੰ ਸੰਭਾਲ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "संभारे हथीयारं ॥",
      "sourceLineId": "79820",
      "sourceShabadId": "7729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਕੈ ਮਾਰੁ ਮਾਰੰ ॥੫੧॥੨੦੭॥",
      "transliteration": "bakai maar maara(n) ||51||207||",
      "translation": "Holding their arms, they are shouting “kill, kill”.51.207.",
      "punjabiViakhya": "ਮਾਰੋ-ਮਾਰੋ ਦਾ ਰੌਲਾ ਪਾ ਰਹੇ ਸਨ ॥੫੧॥੨੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "बकै मारु मारं ॥५१॥२०७॥",
      "sourceLineId": "79821",
      "sourceShabadId": "7729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਬੈ ਸਸਤ੍ਰ ਸਜੇ ॥",
      "transliteration": "sabai sasatr saje ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਮਹਾਨ ਯੋਧੇ ਸ਼ਸਤ੍ਰ ਸਜਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "सबै ससत्र सजे ॥",
      "sourceLineId": "79822",
      "sourceShabadId": "7729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਹਾਬੀਰ ਗਜੇ ॥",
      "transliteration": "mahaabeer gaje ||",
      "translation": "Being completely dressed with their weapons the brave fighters are roaring.",
      "punjabiViakhya": "ਗਰਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "महाबीर गजे ॥",
      "sourceLineId": "79823",
      "sourceShabadId": "7729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਰੰ ਓਘ ਛੁਟੇ ॥",
      "transliteration": "sara(n) ogh chhuTe ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰਾ ਦੀ ਵਾਛੜ ਹੋ ਰਹੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "सरं ओघ छुटे ॥",
      "sourceLineId": "79824",
      "sourceShabadId": "7729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕੜੱਕਾਰੁ ਉਠੇ ॥੫੨॥੨੦੮॥",
      "transliteration": "kaRa'kaar uThe ||52||208||",
      "translation": "There has been a volley of arrows producing hissing sounds.52.208.",
      "punjabiViakhya": "ਕਾੜ-ਕਾੜ (ਦੀ ਧੁਨੀ) ਉਠ ਰਹੀ ਸੀ ॥੫੨॥੨੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "कड़क्कारु उठे ॥५२॥२०८॥",
      "sourceLineId": "79825",
      "sourceShabadId": "7729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਜੈ ਬਾਦ੍ਰਿਤੇਅੰ ॥",
      "transliteration": "bajai baadhiratea(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵਾਜੇ ਵਜ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "बजै बादृतेअं ॥",
      "sourceLineId": "79826",
      "sourceShabadId": "7729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਸੈ ਗਾਧ੍ਰਬੇਅੰ ॥",
      "transliteration": "hasai gaadhrabea(n) ||",
      "translation": "Various types of musical instruments are being played and the Gandharvas are laughing.",
      "punjabiViakhya": "ਗੰਧਰਬ ਹਸ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "हसै गाध्रबेअं ॥",
      "sourceLineId": "79827",
      "sourceShabadId": "7729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਝੰਡਾ ਗਡ ਜੁਟੇ ॥",
      "transliteration": "jha(n)ddaa gadd juTe ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਝੰਡੇ ਗਡ ਕੇ (ਆਪਸ ਵਿਚ) ਜੁਟੇ ਹੋਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "झंडा गड जुटे ॥",
      "sourceLineId": "79828",
      "sourceShabadId": "7729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਰੰ ਸੰਜ ਫੁਟੇ ॥੫੩॥੨੦੯॥",
      "transliteration": "sara(n) sa(n)j fuTe ||53||209||",
      "translation": "The warriors after fixing their banners firmly are busy in fighting and their armours are being torn with arrows.53.209.",
      "punjabiViakhya": "ਤੀਰਾ ਨਾਲ ਕਵਚ ਫੁਟ ਰਹੇ ਸਨ ॥੫੩॥੨੦੯॥",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "सरं संज फुटे ॥५३॥२०९॥",
      "sourceLineId": "79829",
      "sourceShabadId": "7729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚਹੂੰ ਓਰ ਉਠੇ ॥",
      "transliteration": "chahoo(n) or uThe ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਵੀਰ) ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ ਖੜੋ ਗਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "चहूँ ओर उठे ॥",
      "sourceLineId": "79830",
      "sourceShabadId": "7729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਰੰ ਬ੍ਰਿਸਟ ਬੁਠੇ ॥",
      "transliteration": "sara(n) birasaT buThe ||",
      "translation": "From all the four sides, the arrows are being showered.",
      "punjabiViakhya": "ਤੀਰਾ ਦੀ ਬਰਖਾ ਕਰ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "सरं बृसट बुठे ॥",
      "sourceLineId": "79831",
      "sourceShabadId": "7729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਰੋਧੀ ਕਰਾਲੰ ॥",
      "transliteration": "karodhee karaala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧੀ ਅਤੇ ਭਿਆਨਕ (ਵੀਰ ਯੋਧੇ)",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "करोधी करालं ॥",
      "sourceLineId": "79832",
      "sourceShabadId": "7729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਕੈ ਬਿਕਰਾਲੰ ॥੫੪॥੨੧੦॥",
      "transliteration": "bakai bikaraala(n) ||54||210||",
      "translation": "The fierce and frightful warriors are busy in various types of prattle.54.210.",
      "punjabiViakhya": "ਬਕਵਾਦ ਕਰ ਰਹੇ ਸਨ ॥੫੪॥੨੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "बकै बिकरालं ॥५४॥२१०॥",
      "sourceLineId": "79833",
      "sourceShabadId": "7729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "79834",
      "sourceShabadId": "7730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਿਤੇ ਕੁਠੀਅੰ ਬੁਠੀਅੰ ਬ੍ਰਿਸਟ ਬਾਣੰ ॥",
      "transliteration": "kite kuTheea(n) buTheea(n) birasaT baana(n) ||",
      "translation": "Somewhere the brave fighters are being chopped and somewhere the arrows are being showered.",
      "punjabiViakhya": "ਕਿਤੇ (ਵੀਰ) ਕੁਠੇ ਜਾ ਰਹੇ ਸਨ, (ਕਿਤੇ) ਬਾਣਾ ਦਾ ਮੀਂਹ ਵਰ੍ਹ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "किते कुठीअं बुठीअं बृसट बाणं ॥",
      "sourceLineId": "79835",
      "sourceShabadId": "7730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਣੰ ਡੁਲੀਯੰ ਬਾਜ ਖਾਲੀ ਪਲਾਣੰ ॥",
      "transliteration": "rana(n) dduleeya(n) baaj khaalee palaana(n) ||",
      "translation": "The horses without saddles are lying in dust in the battlefield.",
      "punjabiViakhya": "(ਕਿਤੇ) ਰਣ-ਭੂਮੀ ਵਿਚ ਖਾਲੀ ਕਾਠੀਆਂ ਵਾਲੇ ਘੋੜੇ ਫਿਰਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "रणं डुलीयं बाज खाली पलाणं ॥",
      "sourceLineId": "79836",
      "sourceShabadId": "7730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੁਝੇ ਜੋਧਿਯੰ ਬੀਰ ਦੇਵੰ ਅਦੇਵੰ ॥",
      "transliteration": "jujhe jodhiya(n) beer dheva(n) adheva(n) ||",
      "translation": "The warriors of gods and demons both are fighting against one another.",
      "punjabiViakhya": "ਦੈਂਤ ਅਤੇ ਦੇਵਤੇ ਸੂਰਮੇ (ਆਪਸ ਵਿਚ) ਲੜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "जुझे जोधियं बीर देवं अदेवं ॥",
      "sourceLineId": "79837",
      "sourceShabadId": "7730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਭੇ ਸਸਤ੍ਰ ਸਾਜਾ ਮਨੋ ਸਾਤਨੇਵੰ ॥੫੫॥੨੧੧॥",
      "transliteration": "sabhe sasatr saajaa mano saataneva(n) ||55||211||",
      "translation": "It appears that the dreadful warriors are Bhisham Pitamahas.55.211.",
      "punjabiViakhya": "ਸਭ ਨੇ ਸ਼ਸਤ੍ਰ ਸਜਾਏ ਹੋਏ ਸਨ। (ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਭੀਸ਼ਣ ਪਿਤਾਮਾ ('ਸਾਤਨੇਵੰ') ਹੋਣ ॥੫੫॥੨੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "सभे ससत्र साजा मनो सातनेवं ॥५५॥२११॥",
      "sourceLineId": "79838",
      "sourceShabadId": "7730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗਜੇ ਗਜੀਯੰ ਸਰਬ ਸਜੇ ਪਵੰਗੰ ॥",
      "transliteration": "gaje gajeeya(n) sarab saje pava(n)ga(n) ||",
      "translation": "The decorated horses and elephants are thundering",
      "punjabiViakhya": "ਸਾਰੇ ਗਾਜੀ ਗਰਜਦੇ ਸਨ, (ਉਨ੍ਹਾ ਦੇ) ਘੋੜੇ ਸਜੇ ਹੋਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "गजे गजीयं सरब सजे पवंगं ॥",
      "sourceLineId": "79839",
      "sourceShabadId": "7730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜੁਧੰ ਜੁਟੀਯੰ ਜੋਧ ਛੁਟੇ ਖਤੰਗੰ ॥",
      "transliteration": "judha(n) juTeeya(n) jodh chhuTe khata(n)ga(n) ||",
      "translation": "And the arrows of brave warriors are being shot.",
      "punjabiViakhya": "ਯੋਧੇ ਯੁੱਧ ਵਿਚ ਜੁਟੇ ਹੋਏ ਸਨ ਅਤੇ ਤੀਰ ਛੁਟ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "जुधं जुटीयं जोध छुटे खतंगं ॥",
      "sourceLineId": "79840",
      "sourceShabadId": "7730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤੜਕੇ ਤਬਲੰ ਝੜੰਕੇ ਕ੍ਰਿਪਾਣੰ ॥",
      "transliteration": "taRake tabala(n) jhaRa(n)ke kirapaana(n) ||",
      "translation": "The clatter of swords and the resounding of trumpets",
      "punjabiViakhya": "ਤਬਲੇ ਵਜਦੇ ਸਨ, ਕ੍ਰਿਪਾਨਾ ਝਟਕ ਰਹੀਆਂ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "तड़के तबलं झड़ंके कृपाणं ॥",
      "sourceLineId": "79841",
      "sourceShabadId": "7730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੜਕਾਰ ਸੇਲੰ ਰਣੰਕੇ ਨਿਸਾਣੰ ॥੫੬॥੨੧੨॥",
      "transliteration": "saRakaar sela(n) rana(n)ke nisaana(n) ||56||212||",
      "translation": "Along the sounds of daggers and drums are being heard.56.212.",
      "punjabiViakhya": "ਬਰਛੇ ਸਰੜ ਸਰੜ ਕਰਦੇ ਸਨ, ਧੌਂਸੇ ਗੂੰਜਦੇ ਸਨ ॥੫੬॥੨੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "सड़कार सेलं रणंके निसाणं ॥५६॥२१२॥",
      "sourceLineId": "79842",
      "sourceShabadId": "7730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਢਮਾ ਢਮ ਢੋਲੰ ਢਲਾ ਢੁਕ ਢਾਲੰ ॥",
      "transliteration": "ddamaa ddam ddola(n) ddalaa dduk ddaala(n) ||",
      "translation": "The sounds of drums and shields resound continuously",
      "punjabiViakhya": "ਢਮ-ਢਮ ਢੋਲ ਅਤੇ ਢਕ-ਢਕ ਢਾਲਾ (ਵਜ ਰਹੀਆਂ ਸਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "ढमा ढम ढोलं ढला ढुक ढालं ॥",
      "sourceLineId": "79843",
      "sourceShabadId": "7730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗਹਾ ਜੂਹ ਗਜੇ ਹਯੰ ਹਲਚਾਲੰ ॥",
      "transliteration": "gahaa jooh gaje haya(n) halachaala(n) ||",
      "translation": "And the horses running hither and thither have cused consternation.",
      "punjabiViakhya": "ਹਾਥੀਆਂ ('ਗਹਾ') ਦੇ ਸਮੂਹ ਗਰਜ ਰਹੇ ਸਨ ਅਤੇ ਘੋੜਿਆਂ ਵਿਚ ਹਲ-ਚਲ ਮਚੀ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "गहा जूह गजे हयं हलचालं ॥",
      "sourceLineId": "79844",
      "sourceShabadId": "7730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਟਾ ਸਟ ਸੈਲੰ ਖਹਾ ਖੂਨਿ ਖਗੰ ॥",
      "transliteration": "saTaa saT saila(n) khahaa khoon khaga(n) ||",
      "translation": "The daggers are being struck violently and the swords are besmeared with blood.",
      "punjabiViakhya": "ਬਰਛਿਆਂ ਦੀ ਸਟ ਤੇ ਸਟ ਪੈ ਰਹੀ ਸੀ, ਖੂਨ ਰੰਗੀਆਂ ਤਲਵਾਰਾ (ਆਪਸ ਵਿਚ) ਖਹਿੰਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "सटा सट सैलं खहा खूनि खगं ॥",
      "sourceLineId": "79845",
      "sourceShabadId": "7730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤੁਟੇ ਚਰਮ ਬਰਮੰ ਉਠੇ ਨਾਲ ਅਗੰ ॥੫੭॥੨੧੩॥",
      "transliteration": "tuTe charam barama(n) uThe naal aga(n) ||57||213||",
      "translation": "Te armours on the bodies of the warriors are breaking and the limbs are coming out with them.57.213.",
      "punjabiViakhya": "ਢਾਲਾ ਅਤੇ ਕਵਚ ਟੁਟੇ ਪਏ ਸਨ ਅਤੇ ਬੰਦੂਕਾ ਵਿਚੋਂ ਅੱਗ ਨਿਕਲ ਰਹੀ ਸੀ ॥੫੭॥੨੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "तुटे चरम बरमं उठे नाल अगं ॥५७॥२१३॥",
      "sourceLineId": "79846",
      "sourceShabadId": "7730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਉਠੇ ਅਗਿ ਨਾਲੰ ਖਹੇ ਖੋਲ ਖਗੰ ॥",
      "transliteration": "auThe ag naala(n) khahe khol khaga(n) ||",
      "translation": "The blows of swords on the helmets create flames of fire.",
      "punjabiViakhya": "(ਸਿਰ ਦੇ) ਟੋਪਾ (ਖੋਲ) ਉਤੇ ਤਲਵਾਰਾ ਵਜਦੀਆਂ ਸਨ ਅਤੇ ਅੱਗ ਦੀਆਂ ਚਿੰਗਾਰੀਆਂ ਨਿਕਲਦੀਆਂ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "उठे अगि नालं खहे खोल खगं ॥",
      "sourceLineId": "79847",
      "sourceShabadId": "7730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਿਸਾ ਮਾਵਸੀ ਜਾਣੁ ਮਾਸਾਣ ਜਗੰ ॥",
      "transliteration": "nisaa maavasee jaan maasaan jaga(n) ||",
      "translation": "And in the utter darkness that has spread, the ghosts and goblins considering it night, have awakened.",
      "punjabiViakhya": "ਮਾਨੋ ਮਸਿਆ ਦੀ ਰਾਤ ('ਨਿਸਾ') ਸਮਝ ਕੇ ਭੂਤ-ਪ੍ਰੇਤ ਜਾਗ ਪਏ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "निसा मावसी जाणु मासाण जगं ॥",
      "sourceLineId": "79848",
      "sourceShabadId": "7730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਡਕੀ ਡਾਕਣੀ ਡਾਮਰੂ ਡਉਰ ਡਕੰ ॥",
      "transliteration": "ddakee ddaakanee ddaamaroo ddaur ddaka(n) ||",
      "translation": "The vampires are belching and the tabors are being played.",
      "punjabiViakhya": "ਡਾਕਣੀਆਂ ਡਕਾਰਨ ਲਗੀਆਂ ਸਨ ਅਤੇ ਡਮਰੂ ਡਕ-ਡਕ ਕਰਦੇ ਵਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "डकी डाकणी डामरू डउर डकं ॥",
      "sourceLineId": "79849",
      "sourceShabadId": "7730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਚੇ ਬੀਰ ਬੈਤਾਲ ਭੂਤੰ ਭਭਕੰ ॥੫੮॥੨੧੪॥",
      "transliteration": "nache beer baitaal bhoota(n) bhabhaka(n) ||58||214||",
      "translation": "And in accompaniment with their sound, the ghosts and evil spirits are dancing.58.214.",
      "punjabiViakhya": "ਬੀਰ, ਬੈਤਾਲ ਅਤੇ ਭੂਤ ਭਭਕਾ ਮਾਰਦੇ ਹੋਏ ਨਚ ਰਹੇ ਸਨ ॥੫੮॥੨੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "नचे बीर बैताल भूतं भभकं ॥५८॥२१४॥",
      "sourceLineId": "79850",
      "sourceShabadId": "7730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬੇਲੀ ਬਿਦ੍ਰਮ ਛੰਦ ॥",
      "transliteration": "belee bidhram chha(n)dh ||",
      "translation": "BELI BINDRAM STNZA",
      "punjabiViakhya": "ਬੇਲੀ ਬਿਦ੍ਰਮ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "बेली बिद्रम छंद ॥",
      "sourceLineId": "79851",
      "sourceShabadId": "7731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਰਬ ਸਸਤ੍ਰੁ ਆਵਤ ਭੇ ਜਿਤੇ ॥",
      "transliteration": "sarab sasatr aavat bhe jite ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਤਨੇ ਵੀ ਸ਼ਸਤ੍ਰਾ (ਦੇ ਵਾਰ) ਹੋ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "सरब ससत्रु आवत भे जिते ॥",
      "sourceLineId": "79852",
      "sourceShabadId": "7731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਭ ਕਾਟਿ ਦੀਨ ਦ੍ਰੁਗਾ ਤਿਤੇ ॥",
      "transliteration": "sabh kaaT dheen dhrugaa tite ||",
      "translation": "All the blows being struck by the weapons have been annulled by the goddess Durga.",
      "punjabiViakhya": "ਉਤਨੇ ਹੀ ਦੁਰਗਾ ਨੇ ਸਭ ਕਟ ਦਿੱਤੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "सभ काटि दीन द्रुगा तिते ॥",
      "sourceLineId": "79853",
      "sourceShabadId": "7731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਰਿ ਅਉਰ ਜੇਤਿਕੁ ਡਾਰੀਅੰ ॥",
      "transliteration": "ar aaur jetik ddaareea(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ ਵੀ ਜਿਤਨੇ (ਅਸਤ੍ਰ) ਵੈਰੀ ਸੁਟਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "अरि अउर जेतिकु डारीअं ॥",
      "sourceLineId": "79854",
      "sourceShabadId": "7731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤੇਉ ਕਾਟਿ ਭੂਮਿ ਉਤਾਰੀਅੰ ॥੫੯॥੨੧੫॥",
      "transliteration": "teau kaaT bhoom utaareea(n) ||59||215||",
      "translation": "Beside these all other blows, that are being struck, are being annulled and the weapons are thrown on the ground by the goddess.59.215.",
      "punjabiViakhya": "ਉਨ੍ਹਾ ਨੂੰ ਕਟ ਕੇ ਭੂਮੀ ਉਤੇ ਸੁਟ ਦਿੰਦੀ ਸੀ ॥੫੯॥੨੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "तेउ काटि भूमि उतारीअं ॥५९॥२१५॥",
      "sourceLineId": "79855",
      "sourceShabadId": "7731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਰ ਆਪ ਕਾਲੀ ਛੰਡੀਅੰ ॥",
      "transliteration": "sar aap kaalee chha(n)ddeea(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲੀ ਨੇ ਆਪ ਬਾਣ ਛਡੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "सर आप काली छंडीअं ॥",
      "sourceLineId": "79856",
      "sourceShabadId": "7731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਰਬਾਸਤ੍ਰ ਸਤ੍ਰ ਬਿਹੰਡੀਅੰ ॥",
      "transliteration": "sarabaasatr satr biha(n)ddeea(n) ||",
      "translation": "Kali herself made use of her weapons and made all the weapons of the demons ineffective.",
      "punjabiViakhya": "ਵੈਰੀ ਦੇ ਸਾਰੇ ਅਸਤ੍ਰ ਤੋੜ ਫੋੜ ਦਿੱਤੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 116,
      "hindi": "",
      "hindiTransliteration": "सरबासत्र सत्र बिहंडीअं ॥",
      "sourceLineId": "79857",
      "sourceShabadId": "7731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0116_line_0048",
      "lineIndex": 48,
