{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 117,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0117_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜੈ ਸਬਦ ਦੇਵਨ ਉਚਾਰਿਯੋ ॥੬੦॥੨੧੬॥",
      "transliteration": "jai sabadh dhevan uchaariyo ||60||216||",
      "translation": "When the gods saw (Sumbh) without weapons, they began to hail the goddess.60.216.",
      "punjabiViakhya": "(ਤਦੋਂ) ਦੇਵਤਿਆਂ ਨੇ (ਦੁਰਗਾ ਦਾ) ਜੈ-ਘੋਸ਼ ਕਰ ਦਿੱਤਾ ॥੬੦॥੨੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "जै सबद देवन उचारियो ॥६०॥२१६॥",
      "sourceLineId": "79859",
      "sourceShabadId": "7731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਭਿ ਮਧਿ ਬਾਜਨ ਬਾਜਹੀ ॥",
      "transliteration": "nabh madh baajan baajahee ||",
      "translation": "",
      "punjabiViakhya": "ਆਕਾਸ਼ ਵਿਚ ਵਾਜੇ ਵਜਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नभि मधि बाजन बाजही ॥",
      "sourceLineId": "79860",
      "sourceShabadId": "7731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਵਿਲੋਕਿ ਦੇਵਾ ਗਾਜਹੀ ॥",
      "transliteration": "avilok dhevaa gaajahee ||",
      "translation": "The musical instruments were played in the firmament and no0w the gods also began to raor.",
      "punjabiViakhya": "ਅਤੇ (ਇਹ ਦ੍ਰਿਸ਼) ਵੇਖ ਕੇ ਦੇਵਤੇ ਗਜਣ ਲਗ ਗਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "अविलोकि देवा गाजही ॥",
      "sourceLineId": "79861",
      "sourceShabadId": "7731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਲਖਿ ਦੇਵ ਬਾਰੰ ਬਾਰਹੀ ॥",
      "transliteration": "lakh dhev baara(n) baarahee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਦੇਵਤੇ (ਦੇਵੀ ਨੂੰ) ਬਾਰ ਬਾਰ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "लखि देव बारं बारही ॥",
      "sourceLineId": "79862",
      "sourceShabadId": "7731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜੈ ਸਬਦ ਸਰਬ ਪੁਕਾਰਹੀ ॥੬੧॥੨੧੭॥",
      "transliteration": "jai sabadh sarab pukaarahee ||61||217||",
      "translation": "The gods began to view repeatedly and raise shouts of victory.61.217.",
      "punjabiViakhya": "ਜੈ ਦਾ ਘੋਸ਼ ਕਰਨ ਲਗ ਗਏ ਸਨ ॥੬੧॥੨੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "जै सबद सरब पुकारही ॥६१॥२१७॥",
      "sourceLineId": "79863",
      "sourceShabadId": "7731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਣਿ ਕੋਪਿ ਕਾਲ ਕਰਾਲੀਯੰ ॥",
      "transliteration": "ran kop kaal karaaleeya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਕਾਲੀ ਕ੍ਰੋਧ ਨਾਲ ਭਿਆਨਕ ਰੂਪ ਧਾਰ ਕੇ ਫਿਰ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "रणि कोपि काल करालीयं ॥",
      "sourceLineId": "79864",
      "sourceShabadId": "7731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਖਟ ਅੰਗ ਪਾਣਿ ਉਛਾਲੀਯੰ ॥",
      "transliteration": "khaT a(n)g paan uchhaaleeya(n) ||",
      "translation": "Now in great rage in the battlefield, the dreadful Kali raised six hands of her arms powerfully",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਛੇ ਹੱਥਾ ਅਤੇ ਭੁਜਾਵਾ ਨੂੰ ਉਤੇ ਉਛਾਲਿਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "खट अंग पाणि उछालीयं ॥",
      "sourceLineId": "79865",
      "sourceShabadId": "7731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਿਰਿ ਸੁੰਭ ਹਥ ਦੁਛੰਡੀਯੰ ॥",
      "transliteration": "sir su(n)bh hath dhuchha(n)ddeeya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਸੁੰਭ ਕੇ ਸਿਰ ਵਿਚ ਦੋਵੇਾਂ ਹੱਥ ਦੇ ਮਾਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "सिरि सुँभ हथ दुछंडीयं ॥",
      "sourceLineId": "79866",
      "sourceShabadId": "7731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਇਕ ਚੋਟਿ ਦੁਸਟ ਬਿਹੰਡੀਯੰ ॥੬੨॥੨੧੮॥",
      "transliteration": "eik choT dhusaT biha(n)ddeeya(n) ||62||218||",
      "translation": "And struck them on the head of Sumbh and with one blow she destroyed the tyrant.62.218.",
      "punjabiViakhya": "ਇਕੋ ਸਟ ਨਾਲ ਦੁਸ਼ਟ ਨੂੰ ਮਾਰ ਮੁਕਾਇਆ ॥੬੨॥੨੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "इक चोटि दुसट बिहंडीयं ॥६२॥२१८॥",
      "sourceLineId": "79867",
      "sourceShabadId": "7731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "79868",
      "sourceShabadId": "7732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਮ ਸੁੰਭਾਸੁਰ ਕੋ ਹਨਾ ਅਧਿਕ ਕੋਪ ਕੈ ਕਾਲਿ ॥",
      "transliteration": "jim su(n)bhaasur ko hanaa adhik kop kai kaal ||",
      "translation": "The manner in which, with extreme fury, Kali destroyed the demon-king Sumbh",
      "punjabiViakhya": "ਹੇ ਕਾਲੀ। ਜਿਵੇਾਂ (ਤੂੰ) ਬਹੁਤ ਕ੍ਰੋਧ ਕਰ ਕੇ ਸੁੰਭ ਦੈਂਤ ਨੂੰ ਮਾਰਿਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "जिम सुँभासुर को हना अधिक कोप कै कालि ॥",
      "sourceLineId": "79869",
      "sourceShabadId": "7732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤ੍ਰਯੋ ਸਾਧਨ ਕੇ ਸਤ੍ਰੁ ਸਭ ਚਾਬਤ ਜਾਹ ਕਰਾਲ ॥੬੩॥੨੧੯॥",
      "transliteration": "trayo saadhan ke satr sabh chaabat jaeh karaal ||63||219||",
      "translation": "All the enemies of the saints are destroyed in the same manner.63.219.",
      "punjabiViakhya": "(ਤਿਵੇਾਂ) ਸੰਤਾ ਦੇ ਸਾਰੇ ਵੈਰੀਆਂ ਨੂੰ ਭਿਆਨਕ ਰੂਪ ਧਾਰ ਕੇ ਚਬ ਜਾਇਆ ਕਰ ॥੬੩॥੨੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "त्रयो साधन के सत्रु सभ चाबत जाह कराल ॥६३॥२१९॥",
      "sourceLineId": "79870",
      "sourceShabadId": "7732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਚੰਡੀ ਚਰਿਤ੍ਰੇ ਸੁੰਭ ਬਧਹ ਖਸਟਮੋ ਧਿਆਯ ਸੰਪੂਰਨਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੬॥",
      "transliteration": "eit sree bachitr naaTake cha(n)ddee charitre su(n)bh badheh khasaTamo dhiaay sa(n)pooranam sat subham sat ||6||",
      "translation": "Here ends the Sixth Chapter entitled ‘The Killing of Sumbh’ of Chandi Charitra in BACHITTAR NATAK.6.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਦੇ 'ਚੰਡੀ-ਚਰਿਤ੍ਰ' ਪ੍ਰਸੰਗ ਦੇ 'ਸੁੰਭ-ਬਧ' ਨਾ ਦੇ ਛੇਵੇਾਂ ਅਧਿਆਇ ਦੀ ਸ਼ੁਭ ਸਮਾਪਤੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटके चंडी चरित्रे सुँभ बधह खसटमो धिआय संपूरनम सतु सुभम सतु ॥६॥",
      "sourceLineId": "79871",
      "sourceShabadId": "7732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਥ ਜੈਕਾਰ ਸਬਦ ਕਥਨੰ ॥",
      "transliteration": "ath jaikaar sabadh kathana(n) ||",
      "translation": "NOW THE WORDS OF VICTORY ARE RELATED:",
      "punjabiViakhya": "ਹੁਣ ਜੈਕਾਰ ਸ਼ਬਦ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "अथ जैकार सबद कथनं ॥",
      "sourceLineId": "79872",
      "sourceShabadId": "7733",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬੇਲੀ ਬਿਦ੍ਰਮ ਛੰਦ ॥",
      "transliteration": "belee bidhram chha(n)dh ||",
      "translation": "BELI BINDRAM STANZA",
      "punjabiViakhya": "ਬੇਲੀ ਬਿਦ੍ਰਮ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "बेली बिद्रम छंद ॥",
      "sourceLineId": "79873",
      "sourceShabadId": "7733",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜੈ ਸਬਦ ਦੇਵ ਪੁਕਾਰ ਹੀ ॥",
      "transliteration": "jai sabadh dhev pukaar hee ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤੇ ਜੈ-ਜੈ-ਕਾਰ ਦੇ ਸ਼ਬਦ ਬੋਲਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "जै सबद देव पुकार ही ॥",
      "sourceLineId": "79874",
      "sourceShabadId": "7733",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਬ ਫੂਲਿ ਫੂਲਨ ਡਾਰ ਹੀ ॥",
      "transliteration": "sab fool foolan ddaar hee ||",
      "translation": "All the gods are hailing the victory of the goddess and showering the flowers.",
      "punjabiViakhya": "ਸਭ ਖੁਸ਼ ਹੋ ਕੇ ਫੁਲ ਸੁਟਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "सब फूलि फूलन डार ही ॥",
      "sourceLineId": "79875",
      "sourceShabadId": "7733",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਘਨਸਾਰ ਕੁੰਕਮ ਲਿਆਇ ਕੈ ॥",
      "transliteration": "ghanasaar ku(n)kam liaai kai ||",
      "translation": "",
      "punjabiViakhya": "ਕੇਸਰ ਅਤੇ ਚੰਦਨ ਲਿਆ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "घनसार कुँकम लिआइ कै ॥",
      "sourceLineId": "79876",
      "sourceShabadId": "7733",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਟੀਕਾ ਦੀਯ ਹਰਖਾਇ ਕੈ ॥੧॥੨੨੦॥",
      "transliteration": "Teekaa dheey harakhai kai ||1||220||",
      "translation": "They brought the saffron and with great delight they applied the mark on their foreheds.1.220.",
      "punjabiViakhya": "(ਦੇਵਤਿਆਂ ਨੇ) ਖੁਸ਼ੀ ਨਾਲ (ਦੇਵੀ ਨੂੰ) ਤਿਲਕ ਕਰ ਦਿੱਤਾ ॥੧॥੨੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "टीका दीय हरखाइ कै ॥१॥२२०॥",
      "sourceLineId": "79877",
      "sourceShabadId": "7733",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "79878",
      "sourceShabadId": "7734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਉਸਤਤਿ ਸਬ ਹੂੰ ਕਰੀ ਅਪਾਰਾ ॥",
      "transliteration": "ausatat sab hoo(n) karee apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਨੇ ਮਿਲ ਕੇ (ਦੇਵੀ ਦੀ) ਬਹੁਤ ਉਸਤਤ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "उसतति सब हूँ करी अपारा ॥",
      "sourceLineId": "79879",
      "sourceShabadId": "7734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬ੍ਰਹਮ ਕਵਚ ਕੋ ਜਾਪ ਉਚਾਰਾ ॥",
      "transliteration": "braham kavach ko jaap uchaaraa ||",
      "translation": "All of them extremely eulogized the goddess and repeated the mantra known as “Brahm-Kavach”.",
      "punjabiViakhya": "ਬ੍ਰਹਮ-ਕਵਚ' ਜਾਪ ਨੂੰ ਪੜ੍ਰਹਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "ब्रहम कवच को जाप उचारा ॥",
      "sourceLineId": "79880",
      "sourceShabadId": "7734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੰਤ ਸੰਬੂਹ ਪ੍ਰਫੁਲਤ ਭਏ ॥",
      "transliteration": "sa(n)t sa(n)booh prafulat bhe ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਸੰਤ ਆਨੰਦਿਤ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "संत संबूह प्रफुलत भए ॥",
      "sourceLineId": "79881",
      "sourceShabadId": "7734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੁਸਟ ਅਰਿਸਟ ਨਾਸ ਹੁਐ ਗਏ ॥੨॥੨੨੧॥",
      "transliteration": "dhusaT arisaT naas huaai ge ||2||221||",
      "translation": "All the saints were pleased because the tyrants have been destroyed.2.221.",
      "punjabiViakhya": "ਕਿਉਾਂਕਿ ਸਾਰੇ ਵੱਡੇ ਦੁਸ਼ਟਾ ਦਾ ਨਾਸ਼ ਹੋ ਗਿਆ ਸੀ ॥੨॥੨੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "दुसट अरिसट नास हुऐ गए ॥२॥२२१॥",
      "sourceLineId": "79882",
      "sourceShabadId": "7734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਾਧਨ ਕੋ ਸੁਖ ਬਢੇ ਅਨੇਕਾ ॥",
      "transliteration": "saadhan ko sukh badde anekaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਧਾ (ਦੇਵਤਿਆਂ) ਦਾ ਸੁਖ ਅਨੇਕ ਤਰ੍ਹਾ ਨਾਲ ਵਧਣ ਲਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "साधन को सुख बढे अनेका ॥",
      "sourceLineId": "79883",
      "sourceShabadId": "7734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦਾਨਵ ਦੁਸਟ ਨ ਬਾਚਾ ਏਕਾ ॥",
      "transliteration": "dhaanav dhusaT na baachaa ekaa ||",
      "translation": "The comfort of the saints increased in many ways and not even one demon could survive.",
      "punjabiViakhya": "ਕਿਉਾਂਕਿ ਇਕ ਵੀ ਦੁਸ਼ਟ ਦਾਨਵ ਬਾਕੀ ਨਹੀਂ ਬਚਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "दानव दुसट न बाचा एका ॥",
      "sourceLineId": "79884",
      "sourceShabadId": "7734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੰਤ ਸਹਾਇ ਸਦਾ ਜਗ ਮਾਈ ॥",
      "transliteration": "sa(n)t sahai sadhaa jag maiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਗਤ ਮਾਤਾ (ਦੇਵੀ) ਸਦਾ ਸੰਤਾ ਦੀ ਸਹਾਇਕ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "संत सहाइ सदा जग माई ॥",
      "sourceLineId": "79885",
      "sourceShabadId": "7734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਹ ਤਹ ਸਾਧਨ ਹੋਇ ਸਹਾਈ ॥੩॥੨੨੨॥",
      "transliteration": "jeh teh saadhan hoi sahaiee ||3||222||",
      "translation": "The mother of the universe ever helps the saints and is helpful to them everywhere.3.222.",
      "punjabiViakhya": "ਅਤੇ ਜਿਥੇ ਕਿਥੇ ਉਨ੍ਹਾ ਦੀ ਸਹਾਇਕ ਹੁੰਦੀ ਹੈ ॥੩॥੨੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "जह तह साधन होइ सहाई ॥३॥२२२॥",
      "sourceLineId": "79886",
      "sourceShabadId": "7734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੇਵੀ ਜੂ ਕੀ ਉਸਤਤਿ ॥",
      "transliteration": "dhevee joo kee usatat ||",
      "translation": "Eulogy of the Goddess:",
      "punjabiViakhya": "ਦੇਵੀ ਜੀ ਦੀ ਉਸਤਤ:",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "देवी जू की उसतति ॥",
      "sourceLineId": "79887",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "79888",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਮੋ ਜੋਗ ਜ੍ਵਾਲੰ ਧਰੀਯੰ ਜੁਆਲੰ ॥",
      "transliteration": "namo jog javaiaala(n) dhareeya(n) juaala(n) ||",
      "translation": "O Yoga-fire, Enlightener of the Earth! I salute Thee.",
      "punjabiViakhya": "ਯੋਗ-ਅਗਨੀ ਦੀ ਅਗਨੀ ਨੂੰ ਧਾਰਨ ਕਰਨ ਵਾਲੀ (ਦੇਵੀ) ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो जोग ज्वालं धरीयं जुआलं ॥",
      "sourceLineId": "79889",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਮੋ ਸੁੰਭ ਹੰਤੀ ਨਮੋ ਕਰੂਰ ਕਾਲੰ ॥",
      "transliteration": "namo su(n)bh ha(n)tee namo karoor kaala(n) ||",
      "translation": "O the Destroyer of Sumbh and dreadful manifestation of Death!",
      "punjabiViakhya": "ਸੁੰਭ ਨੂੰ ਮਾਰਨ ਵਾਲੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ; ਭਿਆਨਕ ਕਾਲ-ਰੂਪਣੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो सुँभ हंती नमो करूर कालं ॥",
      "sourceLineId": "79890",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਮੋ ਸ੍ਰੋਣ ਬੀਰਜਾਰਦਨੀ ਧੂਮ੍ਰ ਹੰਤੀ ॥",
      "transliteration": "namo sron beerajaaradhanee dhoomr ha(n)tee ||",
      "translation": "O the Destroyer of Dhumar Nain , O the Destroyer of Rakat Beej!",
      "punjabiViakhya": "ਰਕਤਬੀਜ ਨੂੰ ਮਾਰਨ ਵਾਲੀ ਅਤੇ ਧੂਮ੍ਰਲੋਚਨ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो स्रोण बीरजारदनी धूम्र हंती ॥",
      "sourceLineId": "79891",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਮੋ ਕਾਲਿਕਾ ਰੂਪ ਜੁਆਲਾ ਜਯੰਤੀ ॥੪॥੨੨੩॥",
      "transliteration": "namo kaalikaa roop juaalaa jaya(n)tee ||4||223||",
      "translation": "O Blazing like fire Kalika! I salute Thee.4.223.",
      "punjabiViakhya": "ਜੁਆਲਾ ਰੂਪ ਵਾਲੀ ਅਤੇ ਜੇਤੂ ਕਾਲਕਾ ਨੂੰ ਨਮਸਕਾਰ ਹੈ ॥੪॥੨੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो कालिका रूप जुआला जयंती ॥४॥२२३॥",
      "sourceLineId": "79892",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਮੋ ਅੰਬਿਕਾ ਜੰਭਹਾ ਜੋਤਿ ਰੂਪਾ ॥",
      "transliteration": "namo a(n)bikaa ja(n)bhahaa jot roopaa ||",
      "translation": "O Ambika! O Jambhaha (the killer of the demon Jambh) O manifestation of Light! I salute Thee.",
      "punjabiViakhya": "ਅੰਬਕਾ, ਜੰਭਹਾ (ਜੰਭ ਦੈਂਤ ਨੂੰ ਮਾਰਨ ਵਾਲੀ) ਅਤੇ ਜੋਤ-ਸਰੂਪ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो अंबिका जंभहा जोति रूपा ॥",
      "sourceLineId": "79893",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਮੋ ਚੰਡ ਮੁੰਡਾਰਦਨੀ ਭੂਪਿ ਭੂਪਾ ॥",
      "transliteration": "namo cha(n)dd mu(n)ddaaradhanee bhoop bhoopaa ||",
      "translation": "O the killer of Chand and Mund! O the Sovereign of Sovereigns! I salute Thee.",
      "punjabiViakhya": "ਚੰਡ-ਮੁੰਡ ਨੂੰ ਮਾਰਨ ਵਾਲੀ ਅਤੇ ਰਾਜ-ਰਾਜੇਸ਼੍ਵਰੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो चंड मुँडारदनी भूपि भूपा ॥",
      "sourceLineId": "79894",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਮੋ ਚਾਮਰੰ ਚੀਰਣੀ ਚਿਤ੍ਰ ਰੂਪੰ ॥",
      "transliteration": "namo chaamara(n) cheeranee chitr roopa(n) ||",
      "translation": "O the sawer of the demon Chamar! O the one looking like a portrait! I salute Thee.",
      "punjabiViakhya": "ਚਾਮਰ ਦੈਂਤ ਨੂੰ ਚੀਰਨ ਵਾਲੀ ਚਿਤਰ-ਰੂਪਣੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो चामरं चीरणी चित्र रूपं ॥",
      "sourceLineId": "79895",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਮੋ ਪਰਮ ਪ੍ਰਗਿਯਾ ਬਿਰਾਜੈ ਅਨੂਪੰ ॥੫॥੨੨੪॥",
      "transliteration": "namo param pragiyaa biraajai anoopa(n) ||5||224||",
      "translation": "O the bearer of knowledge, unique one! I Salute Thee.5.224.",
      "punjabiViakhya": "ਉਪਮਾ ਤੋਂ ਰਹਿਤ ਬਿਰਾਜਣ ਵਾਲੀ ਪਰਮ-ਪ੍ਰਗਿਆ ਨੂੰ ਨਮਸਕਾਰ ਹੈ ॥੫॥੨੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो परम प्रगिया बिराजै अनूपं ॥५॥२२४॥",
      "sourceLineId": "79896",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਮੋ ਪਰਮ ਰੂਪਾ ਨਮੋ ਕ੍ਰੂਰ ਕਰਮਾ ॥",
      "transliteration": "namo param roopaa namo kraoor karamaa ||",
      "translation": "O the supreme manifestation of the doer of dreadful actions! I salute thee.",
      "punjabiViakhya": "ਪਰਮ-ਰੂਪਾ ਨੂੰ ਨਮਸਕਾਰ ਹੈ; ਭਿਆਨਕ ਕਰਮ ਕਰਨ ਵਾਲੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो परम रूपा नमो क्रूर करमा ॥",
      "sourceLineId": "79897",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਮੋ ਰਾਜਸਾ ਸਾਤਕਾ ਪਰਮ ਬਰਮਾ ॥",
      "transliteration": "namo raajasaa saatakaa param baramaa ||",
      "translation": "O the bearer of the three modes of Rajas, Sattva and Tamas.",
      "punjabiViakhya": "ਰਜੋ, ਸਤੋ (ਆਦਿ ਗੁਣਾ ਨੂੰ ਧਾਰਨ ਕਰਨ ਵਾਲੀ) ਅਤੇ ਸ੍ਰੇਸ਼ਠ ਕਵਚ (ਬਰਮਾ) ਵਾਲੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो राजसा सातका परम बरमा ॥",
      "sourceLineId": "79898",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਮੋ ਮਹਿਖ ਦਈਤ ਕੋ ਅੰਤ ਕਰਣੀ ॥",
      "transliteration": "namo mahikh dhieet ko a(n)t karanee ||",
      "translation": "O the manifestation of supreme steel armour, O the destroyer of Mahishasura.",
      "punjabiViakhya": "ਮਹਿਖਲੇ ਦੈਂਤ ਦਾ ਅੰਤ ਕਰਨ ਵਾਲੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो महिख दईत को अंत करणी ॥",
      "sourceLineId": "79899",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਮੋ ਤੋਖਣੀ ਸੋਖਣੀ ਸਰਬ ਇਰਣੀ ॥੬॥੨੨੫॥",
      "transliteration": "namo tokhanee sokhanee sarab iranee ||6||225||",
      "translation": "Destroyer of all, the killer of all! I salute Thee.6.225.",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਤ੍ਰਿਪਤ ਕਰਨ ਵਾਲੀ, ਸੁਕਾਉਣ ਵਾਲੀ ਅਤੇ ਪ੍ਰੇਰਨ ਵਾਲੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ ॥੬॥੨੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो तोखणी सोखणी सरब इरणी ॥६॥२२५॥",
      "sourceLineId": "79900",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਿੜਾਲਾਛ ਹੰਤੀ ਕਰੂਰਾਛ ਘਾਯਾ ॥",
      "transliteration": "biRaalaachh ha(n)tee karooraachh ghaayaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਿੜਾਲਾਛ (ਦੈਂਤ) ਨੂੰ ਮਾਰਨ ਵਾਲੀ ਅਤੇ ਕਰੂਰਾਛ (ਦੈਂਤ) ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "बिड़ालाछ हंती करूराछ घाया ॥",
      "sourceLineId": "79901",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦਿਜਗਿ ਦਯਾਰਦਨੀਅੰ ਨਮੋ ਜੋਗ ਮਾਯਾ ॥",
      "transliteration": "dhijag dhayaaradhaneea(n) namo jog maayaa ||",
      "translation": "O the killer of Biralachh, the destroyer of Karurachh.",
      "punjabiViakhya": "ਬ੍ਰਾਹਮਣਾ ਦੇ ਮੁਖੀ (ਬ੍ਰਹਮਾ) ਉਤੇ ਪਸੀਜਣ ਵਾਲੀ ('ਅਰਦਨੀਅੰ') ਅਤੇ ਯੋਗਚੰਡੀ ਮਾਇਆ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "दिजगि दयारदनीअं नमो जोग माया ॥",
      "sourceLineId": "79902",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਮੋ ਭਈਰਵੀ ਭਾਰਗਵੀਅੰ ਭਵਾਨੀ ॥",
      "transliteration": "namo bhieeravee bhaaragaveea(n) bhavaanee ||",
      "translation": "O the one showing mercy on Brahma in her delight, O Yog Maya! I salute Thee.",
      "punjabiViakhya": "ਭੈਰਵੀ, ਭਾਰਗਵੀ ਅਤੇ ਭਵਾਨੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो भईरवी भारगवीअं भवानी ॥",
      "sourceLineId": "79903",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਮੋ ਜੋਗ ਜ੍ਵਾਲੰ ਧਰੀ ਸਰਬ ਮਾਨੀ ॥੭॥੨੨੬॥",
      "transliteration": "namo jog javaiaala(n) dharee sarab maanee ||7||226||",
      "translation": "O Bhairavi, Bhavani, Jalandhari and the Destiny through all! I salute Thee.7.226.",
      "punjabiViakhya": "ਯੋਗਅਗਨੀ ਨੂੰ ਧਾਰਨ ਕਰਨ ਵਾਲੀ ਅਤੇ ਸਭ ਤੋਂ ਮਾਨਤਾ ਪ੍ਰਾਪਤ ਕਰਨ ਵਾਲੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ ॥੭॥੨੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो जोग ज्वालं धरी सरब मानी ॥७॥२२६॥",
      "sourceLineId": "79904",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਧੀ ਉਰਧਵੀ ਆਪ ਰੂਪਾ ਅਪਾਰੀ ॥",
      "transliteration": "adhee uradhavee aap roopaa apaaree ||",
      "translation": "Thou art seated everywhere, up and below.",
      "punjabiViakhya": "ਉਪਰ-ਹੇਠਾ ਵਿਚ ਵਿਆਪਤ ਹੋਣ ਵਾਲੀ ਅਪਾਰ-ਰੂਪਾ (ਨੂੰ ਨਮਸਕਾਰ ਹੈ);",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "अधी उरधवी आप रूपा अपारी ॥",
      "sourceLineId": "79905",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਮਾ ਰਸਟਰੀ ਕਾਮ ਰੂਪਾ ਕੁਮਾਰੀ ॥",
      "transliteration": "ramaa rasaTaree kaam roopaa kumaaree ||",
      "translation": "Thou art Lakshmi, Kamakhya and Kumar Kanya.",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਆਨੰਦ ਦੇਣ ਵਾਲੀ ('ਰਮਾ') ਰਾਜ-ਸਾਜ ('ਰਸਟਰੀ') ਕਰਨ ਵਾਲੀ, ਕਾਮ ਰੂਪ ਵਾਲੀ (ਕਾਮਾਖਿਆ) ਕੁਮਾਰੀ (ਨੂੰ ਨਮਸਕਾਰ ਹੈ);",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "रमा रसटरी काम रूपा कुमारी ॥",
      "sourceLineId": "79906",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਭਵੀ ਭਾਵਨੀ ਭਈਰਵੀ ਭੀਮ ਰੂਪਾ ॥",
      "transliteration": "bhavee bhaavanee bhieeravee bheem roopaa ||",
      "translation": "Thou art Bhavani and manifestation of Bhairavi and Bhima,",
      "punjabiViakhya": "ਭਵਾਨੀ, ਸ਼ਰਧਾ, ਭੈਰਵੀ ਅਤੇ ਭੀਮਾ (ਨੂੰ ਨਮਸਕਾਰ ਹੈ);",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "भवी भावनी भईरवी भीम रूपा ॥",
      "sourceLineId": "79907",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਮੋ ਹਿੰਗੁਲਾ ਪਿੰਗੁਲਾਯੰ ਅਨੂਪਾ ॥੮॥੨੨੭॥",
      "transliteration": "namo hi(n)gulaa pi(n)gulaaya(n) anoopaa ||8||227||",
      "translation": "Thou art seated at Hinglaj and Pinglaj, Thou art unique! I salute Thee.8.227.",
      "punjabiViakhya": "ਹਿੰਗੁਲਾ, ਪਿੰਗੁਲਾ ਅਤੇ ਅਨੂਪਮਾ ਨੂੰ ਨਮਸਕਾਰ ਹੈ ॥੮॥੨੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो हिंगुला पिंगुलायं अनूपा ॥८॥२२७॥",
      "sourceLineId": "79908",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਨਮੋ ਜੁਧਨੀ ਕ੍ਰੁਧਨੀ ਕ੍ਰੂਰ ਕਰਮਾ ॥",
      "transliteration": "namo judhanee krudhanee kraoor karamaa ||",
      "translation": "Thou art the performer of dreadful acts, while infuriated in the battlefield.",
      "punjabiViakhya": "ਯੁੱਧ ਕਰਨ ਵਾਲੀ, ਕ੍ਰੋਧ ਕਰਨ ਵਾਲੀ, ਭਿਆਨਕ ਕਰਮ ਕਰਨ ਵਾਲੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो जुधनी क्रुधनी क्रूर करमा ॥",
      "sourceLineId": "79909",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮਹਾ ਬੁਧਿਨੀ ਸਿਧਿਨੀ ਸੁਧ ਕਰਮਾ ॥",
      "transliteration": "mahaa budhinee sidhinee sudh karamaa ||",
      "translation": "Thou art most wise, master of powers and doer of pure deeds.",
      "punjabiViakhya": "ਮਹਾਨ ਬੁੱਧੀ ਵਾਲੀ, ਸਿੱਧੀਆਂ ਵਾਲੀ ਅਤੇ ਸ਼ੁੱਧ ਕਰਮਾ ਵਾਲੀ (ਨੂੰ ਨਮਸਕਾਰ ਹੈ);",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "महा बुधिनी सिधिनी सुध करमा ॥",
      "sourceLineId": "79910",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਪਰੀ ਪਦਮਿਨੀ ਪਾਰਬਤੀ ਪਰਮ ਰੂਪਾ ॥",
      "transliteration": "paree padhaminee paarabatee param roopaa ||",
      "translation": "Thou art most beautiful like and apsara (heavenly damsel), Padmini and the goddess Parbati.",
      "punjabiViakhya": "ਅਪੱਛਰਾ, ਪਦਮਨੀ ਅਤੇ ਪਾਰਬਤੀ ਵਰਗੇ ਪਰਮ ਰੂਪਾ ਵਾਲੀ (ਨੂੰ ਨਮਸਕਾਰ ਹੈ);",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "परी पदमिनी पारबती परम रूपा ॥",
      "sourceLineId": "79911",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਿਵੀ ਬਾਸਵੀ ਬ੍ਰਾਹਮੀ ਰਿਧ ਕੂਪਾ ॥੯॥੨੨੮॥",
      "transliteration": "sivee baasavee braahamee ridh koopaa ||9||228||",
      "translation": "Thou art the source of power of Shiva, the power of Indra and the power of Brahma! I salute Thee.9.228.",
      "punjabiViakhya": "ਸ਼ਿਵ-ਸ਼ਕਤੀ, ਇੰਦਰ-ਸ਼ਕਤੀ (ਬਾਸਵੀ) ਬ੍ਰਹਮਾ-ਸ਼ਕਤੀ ਅਤੇ ਕੁਬੇਰ ਸ਼ਕਤੀ ('ਰਿਧ-ਕੂਪਾ') (ਨੂੰ ਨਮਸਕਾਰ ਹੈ) ॥੯॥੨੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "सिवी बासवी ब्राहमी रिध कूपा ॥९॥२२८॥",
      "sourceLineId": "79912",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਮਿੜਾ ਮਾਰਜਨੀ ਸੂਰਤਵੀ ਮੋਹ ਕਰਤਾ ॥",
      "transliteration": "miRaa maarajanee sooratavee moh karataa ||",
      "translation": "Enchantress of the ghosts and goblins!",
      "punjabiViakhya": "ਮਿੜਾ (ਮ੍ਰਿੜ ਰੁਦ੍ਰ ਦੀ ਸ਼ਕਤੀ) ਮਾਰਜਨੀ (ਦੋਸ਼ਾ ਨੂੰ ਦੂਰ ਕਰਨ ਵਾਲੀ) ਸੂਰਤਵੀ (ਦਇਆ ਕਰਨ ਵਾਲੀ) ਅਤੇ ਮੋਹ ਕਰਨ ਵਾਲੀ (ਨੂੰ ਨਮਸਕਾਰ ਹੈ)",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "मिड़ा मारजनी सूरतवी मोह करता ॥",
      "sourceLineId": "79913",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਪਰਾ ਪਸਟਣੀ ਪਾਰਬਤੀ ਦੁਸਟ ਹਰਤਾ ॥",
      "transliteration": "paraa pasaTanee paarabatee dhusaT harataa ||",
      "translation": "Thou art the greatest apsara, Parbati and the killer of tyrants.",
      "punjabiViakhya": "ਪਰਾ (ਬ੍ਰਹਮਵਿਦਿਆ) ਪਸਟਣੀ (ਪ੍ਰਸੰਨ ਹੋਣ ਵਾਲੀ) ਪਾਰਬਤੀ ਅਤੇ ਦੁਸ਼ਟਾ ਨੂੰ ਮਾਰਨ ਵਾਲੀ (ਨੂੰ ਨਮਸਕਾਰ ਹੈ);",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "परा पसटणी पारबती दुसट हरता ॥",
      "sourceLineId": "79914",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਨਮੋ ਹਿੰਗੁਲਾ ਪਿੰਗੁਲਾ ਤੋਤਲਾਯੰ ॥",
      "transliteration": "namo hi(n)gulaa pi(n)gulaa totalaaya(n) ||",
      "translation": "Performer of gentle acts like children at the places like Hinglaj and Pinglaj.",
      "punjabiViakhya": "ਹਿੰਗੁਲਾ, ਪਿੰਗੁਲਾ ਅਤੇ ਤੋਤਲਾ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो हिंगुला पिंगुला तोतलायं ॥",
      "sourceLineId": "79915",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਨਮੋ ਕਾਰਤਿਕ੍ਰਯਾਨੀ ਸਿਵਾ ਸੀਤਲਾਯੰ ॥੧੦॥੨੨੯॥",
      "transliteration": "namo kaaratikrayaanee sivaa seetalaaya(n) ||10||229||",
      "translation": "Thou art the power of Kartikeya and Shiva etc.! I salute thee.10.229.",
      "punjabiViakhya": "ਕਾਰਤਿਕਯਾਨੀ (ਕਾਰਤੀਕੇਯ-ਸ਼ਕਤੀ) ਸ਼ਿਵਾ ਅਤੇ ਸੀਤਲਾ ਨੂੰ ਨਮਸਕਾਰ ਹੈ ॥੧੦॥੨੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो कारतिक्रयानी सिवा सीतलायं ॥१०॥२२९॥",
      "sourceLineId": "79916",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਭਵੀ ਭਾਰਗਵੀਯੰ ਨਮੋ ਸਸਤ੍ਰ ਪਾਣੰ ॥",
      "transliteration": "bhavee bhaaragaveeya(n) namo sasatr paana(n) ||",
      "translation": "O the power of Yama, O the power of Bhrigu and the the wielder of weapons in Thy hands, I salute Thee.",
      "punjabiViakhya": "ਭਵੀ (ਯਮ-ਸ਼ਕਤੀ) ਭਾਰਗਵੀ (ਭ੍ਰਿਗੂ-ਸ਼ਕਤੀ) ਅਤੇ ਸ਼ਸਤ੍ਰ ਧਾਰਨ ਕਰਨ ਵਾਲੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "भवी भारगवीयं नमो ससत्र पाणं ॥",
      "sourceLineId": "79917",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਨਮੋ ਅਸਤ੍ਰ ਧਰਤਾ ਨਮੋ ਤੇਜ ਮਾਣੰ ॥",
      "transliteration": "namo asatr dharataa namo tej maana(n) ||",
      "translation": "Thou art the wearer of arms, most Glorious",
      "punjabiViakhya": "ਅਸਤ੍ਰ ਧਾਰਨ ਕਰਨ ਵਾਲੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ; ਤੇਜ ਨੂੰ ਮਾਣ ਦੇਣ ਵਾਲੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो असत्र धरता नमो तेज माणं ॥",
      "sourceLineId": "79918",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਜਯਾ ਅਜਯਾ ਚਰਮਣੀ ਚਾਵਡਾਯੰ ॥",
      "transliteration": "jayaa ajayaa charamanee chaavaddaaya(n) ||",
      "translation": "Unconquerable for ever and conqueror of all, bearer of elegant shield",
      "punjabiViakhya": "ਜਿਤ ਪ੍ਰਾਪਤ ਕਰਨ ਵਾਲੀ, ਨਾ ਜਿਤੇ ਜਾ ਸਕਣ ਵਾਲੀ, ਚੁੜੇਲਾ ਨੂੰ ਚਬਣ ਵਾਲੀ (ਨੂੰ ਨਮਸਕਾਰ ਹੈ);",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "जया अजया चरमणी चावडायं ॥",
      "sourceLineId": "79919",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਕਾਲਿਕਾਯੰ ਨਯੰ ਨਿਤਿ ਨਿਆਯੰ ॥੧੧॥੨੩੦॥",
      "transliteration": "kirapaa kaalikaaya(n) naya(n) nit niaaya(n) ||11||230||",
      "translation": "And performer of justice at all times, the Merciful Kalika! I salute thee. 11.230.",
      "punjabiViakhya": "ਕ੍ਰਿਪਾ (ਕਰਨ ਵਾਲੀ) ਕਾਲਕਾ ਰੂਪ ਵਾਲੀ, ਨਿੱਤ ਨਵੇਾਂ ਅਤੇ ਨਿਆਇਸ਼ੀਲ ਰੂਪ ਵਾਲੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ ॥੧੧॥੨੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "कृपा कालिकायं नयं निति निआयं ॥११॥२३०॥",
      "sourceLineId": "79920",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਨਮੋ ਚਾਪਣੀ ਚਰਮਣੀ ਖੜਗ ਪਾਣੰ ॥",
      "transliteration": "namo chaapanee charamanee khaRag paana(n) ||",
      "translation": "O the wielder of bow, sword, shield and mace,",
      "punjabiViakhya": "ਹੱਥ ਵਿਚ ਧਨੁਸ਼ ਧਾਰਨ ਕਰਨ ਵਾਲੀ ('ਚਾਪਣੀ') ਢਾਲ ਧਾਰਨ ਕਰਨ ਵਾਲੀ ('ਚਰਮਣੀ') ਹੱਥ ('ਪਾਣੰ') ਵਿਚ ਖੜਗ ਧਾਰਨ ਕਰਨ ਵਾਲੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो चापणी चरमणी खड़ग पाणं ॥",
      "sourceLineId": "79921",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਗਦਾ ਪਾਣਿਣੀ ਚਕ੍ਰਣੀ ਚਿਤ੍ਰ ਮਾਣੰ ॥",
      "transliteration": "gadhaa paaninee chakranee chitr maana(n) ||",
      "translation": "The user of the disc, and of the honoured portrait, I salute Thee.",
      "punjabiViakhya": "ਹੱਥ ਵਿਚ ਗਦਾ ਫੜਨ ਵਾਲੀ, ਚੱਕਰ ਧਾਰਨ ਕਰਨ ਵਾਲੀ ਅਤੇ ਚਿਤਰ ਸਰੂਪੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "गदा पाणिणी चक्रणी चित्र माणं ॥",
      "sourceLineId": "79922",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਨਮੋ ਸੂਲਣੀ ਸਹਥੀ ਪਾਣਿ ਮਾਤਾ ॥",
      "transliteration": "namo soolanee sahathee paan maataa ||",
      "translation": "Thou art the mother of the universe and wielder of trident and dagger.",
      "punjabiViakhya": "ਹੱਥ ਵਿਚ ਤ੍ਰਿਸ਼ੂਲ ਧਾਰਨ ਕਰਨ ਵਾਲੀ ਅਤੇ ਸੈਹੱਥੀ ਫੜਨ ਵਾਲੀ ਮਾਤਾ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो सूलणी सहथी पाणि माता ॥",
      "sourceLineId": "79923",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਨਮੋ ਗਿਆਨ ਬਿਗਿਆਨ ਕੀ ਗਿਆਨ ਗਿਆਤਾ ॥੧੨॥੨੩੧॥",
      "transliteration": "namo giaan bigiaan kee giaan giaataa ||12||231||",
      "translation": "Thou art the knower of all the knowledge of all sciences! I salute Thee.12.231.",
      "punjabiViakhya": "ਗਿਆਨ ਅਤੇ ਵਿਗਿਆਨ ਦੇ ਗਿਆਨ ਨੂੰ ਜਾਣਨ ਵਾਲੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ ॥੧੨॥੨੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो गिआन बिगिआन की गिआन गिआता ॥१२॥२३१॥",
      "sourceLineId": "79924",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਨਮੋ ਪੋਖਣੀ ਸੋਖਣੀਅੰ ਮ੍ਰਿੜਾਲੀ ॥",
      "transliteration": "namo pokhanee sokhaneea(n) miraRaalee ||",
      "translation": "Thou art the preserver and destroyer of all, science! Thou art the rider of the dead.",
      "punjabiViakhya": "ਪਾਲਨ ਕਰਨ ਵਾਲੀ, ਸੁਕਾਉਣ ਵਾਲੀ ਅਤੇ ਮ੍ਰਿੜਾਲੀ (ਮੁਰਦਿਆਂ ਦੀ ਸਵਾਰੀ ਕਰਨ ਵਾਲੀ) ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो पोखणी सोखणीअं मृड़ाली ॥",
      "sourceLineId": "79925",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਨਮੋ ਦੁਸਟ ਦੋਖਾਰਦਨੀ ਰੂਪ ਕਾਲੀ ॥",
      "transliteration": "namo dhusaT dhokhaaradhanee roop kaalee ||",
      "translation": "Thou art the destroyer of tyrants in the manifestation of Kali, I salute Thee.",
      "punjabiViakhya": "ਦੁਸ਼ਟਾ ਨੂੰ ਦੁਖ ਦੇਣ ਲਈ ਕਾਲੀ ਦਾ ਰੂਪ ਧਾਰਨ ਕਰਨ ਵਾਲੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो दुसट दोखारदनी रूप काली ॥",
      "sourceLineId": "79926",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਨਮੋ ਜੋਗ ਜੁਆਲਾ ਨਮੋ ਕਾਰਤਿਕ੍ਰਯਾਨੀ ॥",
      "transliteration": "namo jog juaalaa namo kaaratikrayaanee ||",
      "translation": "O Yoga-fire! the power of Kartikeya",
      "punjabiViakhya": "ਯੋਗ-ਅਗਨੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ; ਕਾਰਤੀਕੇਯ ਸ਼ਕਤੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो जोग जुआला नमो कारतिक्रयानी ॥",
      "sourceLineId": "79927",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਨਮੋ ਅੰਬਿਕਾ ਤੋਤਲਾ ਸ੍ਰੀ ਭਵਾਨੀ ॥੧੩॥੨੩੨॥",
      "transliteration": "namo a(n)bikaa totalaa sree bhavaanee ||13||232||",
      "translation": "O Ambika! o Bhavani! I salute Thee.13.232.",
      "punjabiViakhya": "ਅੰਬਕਾ, ਤੋਤਲਾ ਅਤੇ ਸ੍ਰੀ ਭਵਾਨੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ ॥੧੩॥੨੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो अंबिका तोतला स्री भवानी ॥१३॥२३२॥",
      "sourceLineId": "79928",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਨਮੋ ਦੋਖ ਦਾਹੀ ਨਮੋ ਦੁਖ੍ਯ ਹਰਤਾ ॥",
      "transliteration": "namo dhokh dhaahee namo dhukhay harataa ||",
      "translation": "O the effacer and destroyer of sorrows!",
      "punjabiViakhya": "ਦੁਖਾ ਨੂੰ ਸਾੜਨ ਵਾਲੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ, ਦੁਖਾ ਨੂੰ ਹਰਨ ਵਾਲੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो दोख दाही नमो दुख्य हरता ॥",
      "sourceLineId": "79929",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0117_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਨਮੋ ਸਸਤ੍ਰਣੀ ਅਸਤ੍ਰਣੀ ਕਰਮ ਕਰਤਾ ॥",
      "transliteration": "namo sasatranee asatranee karam karataa ||",
      "translation": "O the wager of war with weapons and arms!",
      "punjabiViakhya": "ਅਸਤ੍ਰਾ ਅਤੇ ਸ਼ਸਤ੍ਰਾ ਨਾਲ ਕਰਮ ਕਰਨ ਵਾਲੀ ਨੂੰ ਨਮਸਕਾਰ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 117,
      "hindi": "",
      "hindiTransliteration": "नमो ससत्रणी असत्रणी करम करता ॥",
      "sourceLineId": "79930",
      "sourceShabadId": "7735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
