{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 128,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0128_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਹੀ ਜਾਨ ਜਾਈ ਕਛੂ ਰੂਪ ਰੇਖੰ ॥",
      "transliteration": "nahee jaan jaiee kachhoo roop rekha(n) ||",
      "translation": "His form and mark cannot be comprehended at all.",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਕੁਝ ਵੀ ਰੂਪ ਅਤੇ ਆਕਾਰ ਜਾਣਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "नही जान जाई कछू रूप रेखं ॥",
      "sourceLineId": "80435",
      "sourceShabadId": "7741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਹਾ ਬਾਸੁ ਤਾ ਕੋ ਫਿਰੈ ਕਉਨ ਭੇਖੰ ॥",
      "transliteration": "kahaa baas taa ko firai kaun bhekha(n) ||",
      "translation": "Where doth He live? and in what guise He moves?",
      "punjabiViakhya": "(ਨਾ ਇਹ ਪਤਾ ਲਗਦਾ ਹੈ ਕਿ) ਉਸ ਦਾ ਵਾਸ ਕਿਥੇ ਹੈ ਅਤੇ ਕਿਹੜੇ ਭੇਸ ਵਿਚ ਫਿਰ ਰਿਹਾ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "कहा बासु ता को फिरै कउन भेखं ॥",
      "sourceLineId": "80436",
      "sourceShabadId": "7741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਹਾ ਨਾਮ ਤਾ ਕੋ ਕਹਾ ਕੈ ਕਹਾਵੈ ॥",
      "transliteration": "kahaa naam taa ko kahaa kai kahaavai ||",
      "translation": "What is His Name? and how is He called?",
      "punjabiViakhya": "ਉਸ ਦਾ ਕੀ ਨਾ ਹੈ ਅਤੇ ਕੀ ਕਰ ਕੇ ਜਾਣਿਆ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "कहा नाम ता को कहा कै कहावै ॥",
      "sourceLineId": "80437",
      "sourceShabadId": "7741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਹਾ ਮੈ ਬਖਾਨੋ ਕਹੈ ਮੈ ਨ ਆਵੈ ॥੬॥",
      "transliteration": "kahaa mai bakhaano kahai mai na aavai ||6||",
      "translation": "What should I say? I lack expression.6.",
      "punjabiViakhya": "ਮੈਂ (ਉਸ ਦਾ) ਕੀ ਬਖਾਨ ਕਰਾ (ਕਿਉਾਂਕਿ ਉਹ) ਕਥਨ ਵਿਚ ਨਹੀਂ ਆਉਾਂਦਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "कहा मै बखानो कहै मै न आवै ॥६॥",
      "sourceLineId": "80438",
      "sourceShabadId": "7741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਜੋਨੀ ਅਜੈ ਪਰਮ ਰੂਪੀ ਪ੍ਰਧਾਨੈ ॥",
      "transliteration": "ajonee ajai param roopee pradhaanai ||",
      "translation": "He is Unborn, Unconquerable, Most beautiful and Supreme.",
      "punjabiViakhya": "(ਉਹ) ਜੂਨਾ ਵਿਚ ਨਹੀਂ ਆਉਾਂਦਾ, ਜਿਤਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ, ਪਰਮ ਰੂਪ ਵਾਲਾ ਅਤੇ (ਸਭ ਦਾ) ਮੁਖੀ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "अजोनी अजै परम रूपी प्रधानै ॥",
      "sourceLineId": "80439",
      "sourceShabadId": "7741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਛੇਦੀ ਅਭੇਦੀ ਅਰੂਪੀ ਮਹਾਨੈ ॥",
      "transliteration": "achhedhee abhedhee aroopee mahaanai ||",
      "translation": "He is Unassailable, Indiscriminate, Formless and Unmatchable.",
      "punjabiViakhya": "ਅਛੇਦ, ਅਭੇਦ, ਅਰੂਪ ਅਤੇ ਮਹਾਨ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "अछेदी अभेदी अरूपी महानै ॥",
      "sourceLineId": "80440",
      "sourceShabadId": "7741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਸਾਧੇ ਅਗਾਧੇ ਅਗੰਜੁਲ ਗਨੀਮੇ ॥",
      "transliteration": "asaadhe agaadhe aga(n)jul ganeeme ||",
      "translation": "He is Incorrigible, Unfathomable, and Indestructible by enemies.",
      "punjabiViakhya": "ਅਸਾਧ, ਅਗਾਧ ਅਤੇ ਵੈਰੀਆਂ ਤੋਂ ਮਾਰੇ ਨਾ ਜਾ ਸਕਣ ਵਾਲਾ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "असाधे अगाधे अगंजुल गनीमे ॥",
      "sourceLineId": "80441",
      "sourceShabadId": "7741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਰੰਜੁਲ ਅਰਾਧੇ ਰਹਾਕੁਲ ਰਹੀਮੇ ॥੭॥",
      "transliteration": "ara(n)jul araadhe rahaakul raheeme ||7||",
      "translation": "He, who rememberest Thee, Thou makest him griefless, He is the Deliverer and Merciful Lord.7.",
      "punjabiViakhya": "(ਉਹ) ਆਰਾਧਕ ਨੂੰ ਰੰਜ ਤੋਂ ਮੁਕਤ ਕਰਨ ਵਾਲਾ ਅਤੇ ਰਿਹਾ (ਆਜ਼ਾਦ) ਕਰਾਉਣ ਵਾਲਾ ਦਿਆਲੂ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "अरंजुल अराधे रहाकुल रहीमे ॥७॥",
      "sourceLineId": "80442",
      "sourceShabadId": "7741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਦਾ ਸਰਬਦਾ ਸਿਧਦਾ ਬੁਧਿ ਦਾਤਾ ॥",
      "transliteration": "sadhaa sarabadhaa sidhadhaa budh dhaataa ||",
      "translation": "He is ever the Giver of Power and intellect to all.",
      "punjabiViakhya": "ਸਦਾ ਸਭ ਨੂੰ ਦੇਣ ਵਾਲਾ, ਸਿੱਧੀ ਪ੍ਰਦਾਨ ਕਰਨ ਵਾਲਾ ਅਤੇ ਬੁੱਧੀ ਦੇਣ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "सदा सरबदा सिधदा बुधि दाता ॥",
      "sourceLineId": "80443",
      "sourceShabadId": "7741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਮੋ ਲੋਕ ਲੋਕੇਸ੍ਵਰੰ ਲੋਕ ਗ੍ਯਾਤਾ ॥",
      "transliteration": "namo lok lokesavaira(n) lok gayaataa ||",
      "translation": "Salutations to Him, the Knower of the secrets of the people and their Lord.",
      "punjabiViakhya": "(ਉਸ) ਸਾਰਿਆਂ ਲੋਕਾ ਦੇ ਸੁਆਮੀ ਅਤੇ ਸਾਰਿਆਂ ਲੋਕਾ ਨੂੰ ਜਾਣਨ ਵਾਲੇ ਨੂੰ ਨਮਸਕਾਰ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "नमो लोक लोकेस्वरं लोक ग्याता ॥",
      "sourceLineId": "80444",
      "sourceShabadId": "7741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਛੇਦੀ ਅਭੈ ਆਦਿ ਰੂਪੰ ਅਨੰਤੰ ॥",
      "transliteration": "achhedhee abhai aadh roopa(n) ana(n)ta(n) ||",
      "translation": "He is unassailable, fearless, the Primal Entity and Boundless.",
      "punjabiViakhya": "(ਉਹ) ਅਛੇਦ, ਭੈ-ਰਹਿਤ, ਆਦਿ-ਰੂਪ ਵਾਲਾ ਅਤੇ ਅਨੰਤ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "अछेदी अभै आदि रूपं अनंतं ॥",
      "sourceLineId": "80445",
      "sourceShabadId": "7741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਛੇਦੀ ਅਛੈ ਆਦਿ ਅਦ੍ਵੈ ਦੁਰੰਤੰ ॥੮॥",
      "transliteration": "achhedhee achhai aadh adhavai dhura(n)ta(n) ||8||",
      "translation": "He is unassailable, invincible, PrimE6268:E6298al, non-dual and very difficult to realise.8.",
      "punjabiViakhya": "ਅਛੇਦ, ਅਛੈ (ਨਸ਼ਟ ਨਾ ਹੋਣ ਵਾਲਾ) ਆਦਿ-ਰੂਪ, ਅਦ੍ਵੈਤ-ਸਰੂਪ ਅਤੇ ਕਠਨਤਾ ਨਾਲ ਪ੍ਰਾਪਤ ਹੋਣ ਵਾਲਾ (ਦੁਰੰਤੰ) ਹੈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "अछेदी अछै आदि अद्वै दुरंतं ॥८॥",
      "sourceLineId": "80446",
      "sourceShabadId": "7741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "naraaj chha(n)dh ||",
      "translation": "NARAAJ STANZA",
      "punjabiViakhya": "ਨਰਾਜ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "नराज छंद ॥",
      "sourceLineId": "80447",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਨੰਤ ਆਦਿ ਦੇਵ ਹੈ ॥",
      "transliteration": "ana(n)t aadh dhev hai ||",
      "translation": "He is Boundless and Primal Lord",
      "punjabiViakhya": "(ਤੂੰ) ਅੰਤ ਤੋਂ ਬਿਨਾ ਅਤੇ ਆਦਿ-ਦੇਵ ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "अनंत आदि देव है ॥",
      "sourceLineId": "80448",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਿਅੰਤ ਭਰਮ ਭੇਵ ਹੈ ॥",
      "transliteration": "bia(n)t bharam bhev hai ||",
      "translation": "He is endless and Indiscriminate from illusion.",
      "punjabiViakhya": "ਬੇਅੰਤ ਅਤੇ ਭਰਮਾ ਤੋਂ ਭਿੰਨ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "बिअंत भरम भेव है ॥",
      "sourceLineId": "80449",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਗਾਧਿ ਬਿਆਧਿ ਨਾਸ ਹੈ ॥",
      "transliteration": "agaadh biaadh naas hai ||",
      "translation": "He is Unfathomable and Destroyer of ailments",
      "punjabiViakhya": "ਅਗਾਧ ਅਤੇ ਵਿਆਧੀਆਂ ਦਾ ਨਾਸ਼ਕ ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "अगाधि बिआधि नास है ॥",
      "sourceLineId": "80450",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਦੈਵ ਸਰਬ ਪਾਸ ਹੈ ॥੧॥੯॥",
      "transliteration": "sadhaiv sarab paas hai ||1||9||",
      "translation": "He is always with everyone.1.9.",
      "punjabiViakhya": "ਸਦਾ ਸਭ ਦੇ ਕੋਲ ਹੈ ॥੧॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "सदैव सरब पास है ॥१॥९॥",
      "sourceLineId": "80451",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਚਿਤ੍ਰ ਚਿਤ੍ਰ ਚਾਪ ਹੈ ॥",
      "transliteration": "bachitr chitr chaap hai ||",
      "translation": "His painting is marvelous",
      "punjabiViakhya": "(ਤੇਰੀ) ਕਮਾਨ ('ਚਾਪ') ਦਾ ਸਰੂਪ ('ਚਿਤ੍ਰ') ਅਲੌਕਿਕ ਹੈ (ਸੰਕੇਤ ਇੰਦਰ-ਧਨੁਸ਼ ਵਲ ਹੈ);",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "बचित्र चित्र चाप है ॥",
      "sourceLineId": "80452",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਖੰਡ ਦੁਸਟ ਖਾਪ ਹੈ ॥",
      "transliteration": "akha(n)dd dhusaT khaap hai ||",
      "translation": "He is Indivisible and Destroyer on tyrants.",
      "punjabiViakhya": "(ਤੂੰ) ਅਖੰਡ ਰੂਪ ਵਾਲਾ ਅਤੇ ਦੁਸ਼ਟਾ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "अखंड दुसट खाप है ॥",
      "sourceLineId": "80453",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਭੇਦ ਆਦਿ ਕਾਲ ਹੈ ॥",
      "transliteration": "abhedh aadh kaal hai ||",
      "translation": "",
      "punjabiViakhya": "(ਤੂੰ) ਨਾ ਭੇਦਿਆ ਜਾ ਸਕਣਾ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "अभेद आदि काल है ॥",
      "sourceLineId": "80454",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਦੈਵ ਸਰਬ ਪਾਲ ਹੈ ॥੨॥੧੦॥",
      "transliteration": "sadhaiv sarab paal hai ||2||10||",
      "translation": "He is Indiscriminate from the very beginning and always sustains all.2.10.",
      "punjabiViakhya": "ਅਤੇ ਆਦਿ-ਕਾਲ ਵਾਲਾ ਹੈਂ; ਸਦਾ ਸਭ ਦੀ ਪਾਲਣਾ ਕਰਨ ਵਾਲਾ ਹੈਂ ॥੨॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "सदैव सरब पाल है ॥२॥१०॥",
      "sourceLineId": "80455",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਖੰਡ ਚੰਡ ਰੂਪ ਹੈ ॥",
      "transliteration": "akha(n)dd cha(n)dd roop hai ||",
      "translation": "He is Indivisible and hast terrible form",
      "punjabiViakhya": "(ਤੂੰ) ਅਖੰਡ ਅਤੇ ਪ੍ਰਚੰਡ ਰੂਪ ਵਾਲਾ ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "अखंड चंड रूप है ॥",
      "sourceLineId": "80456",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪ੍ਰਚੰਡ ਸਰਬ ਸ੍ਰੂਪ ਹੈ ॥",
      "transliteration": "pracha(n)dd sarab sraoop hai ||",
      "translation": "His Powerful Entity manifests all.",
      "punjabiViakhya": "ਬਹੁਤ ਤੇਜ ਵਾਲਾ ਅਤੇ ਸਰਬ ਸਰੂਪਾ ਵਾਲਾ ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "प्रचंड सरब स्रूप है ॥",
      "sourceLineId": "80457",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਾਲ ਹੂੰ ਕੇ ਕਾਲ ਹੈ ॥",
      "transliteration": "kaal hoo(n) ke kaal hai ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਦਾ ਵੀ ਕਾਲ ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "काल हूँ के काल है ॥",
      "sourceLineId": "80458",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਦੈਵ ਰਛਪਾਲ ਹੈ ॥੩॥੧੧॥",
      "transliteration": "sadhaiv rachhapaal hai ||3||11||",
      "translation": "He is the death of death and is also always the Protector.3.11.",
      "punjabiViakhya": "ਸਦਾ ਹੀ ਰਖਿਆ ਕਰਨ ਵਾਲਾ ਹੈਂ ॥੩॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "सदैव रछपाल है ॥३॥११॥",
      "sourceLineId": "80459",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕ੍ਰਿਪਾਲ ਦਿਆਲ ਰੂਪ ਹੈ ॥",
      "transliteration": "kirapaal dhiaal roop hai ||",
      "translation": "",
      "punjabiViakhya": "(ਤੂੰ) ਕ੍ਰਿਪਾਲੂ ਅਤੇ ਦਿਆਲੂ ਰੂਪ ਵਾਲਾ ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "कृपाल दिआल रूप है ॥",
      "sourceLineId": "80460",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਦੈਵ ਸਰਬ ਭੂਪ ਹੈ ॥",
      "transliteration": "sadhaiv sarab bhoop hai ||",
      "translation": "He is the Kind and Merciful entity and is ever the Sovereign of all.",
      "punjabiViakhya": "ਸਦਾ ਸਭ ਦਾ ਰਾਜਾ ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "सदैव सरब भूप है ॥",
      "sourceLineId": "80461",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਨੰਤ ਸਰਬ ਆਸ ਹੈ ॥",
      "transliteration": "ana(n)t sarab aas hai ||",
      "translation": "He is boundless and fulfiller of the hopes of all",
      "punjabiViakhya": "ਅਨੰਤ ਅਤੇ ਸਭ ਦੀਆਂ ਆਸ਼ਾਵਾ (ਪੂਰੀਆਂ ਕਰਨ ਵਾਲਾ) ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "अनंत सरब आस है ॥",
      "sourceLineId": "80462",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪਰੇਵ ਪਰਮ ਪਾਸ ਹੈ ॥੪॥੧੨॥",
      "transliteration": "parev param paas hai ||4||12||",
      "translation": "He is very far away and also very near.4.12.",
      "punjabiViakhya": "ਬਹੁਤ ਪਰੇ ਵੀ ਹੈ ਅਤੇ ਬਹੁਤ ਨੇੜੇ ਵੀ ॥੪॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "परेव परम पास है ॥४॥१२॥",
      "sourceLineId": "80463",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਦ੍ਰਿਸਟ ਅੰਤ੍ਰ ਧਿਆਨ ਹੈ ॥",
      "transliteration": "adhirasaT a(n)tr dhiaan hai ||",
      "translation": "He is Invisible but abides in inner meditation",
      "punjabiViakhya": "(ਤੂੰ) ਅਦ੍ਰਿਸ਼ਟ (ਨ ਦਿਖਣ ਵਾਲਾ) ਅਤੇ (ਸਭ ਦੇ) ਧਿਆਨ ਵਿਚ (ਸਥਿਤ) ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "अदृसट अंत्र धिआन है ॥",
      "sourceLineId": "80464",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਦੈਵ ਸਰਬ ਮਾਨ ਹੈ ॥",
      "transliteration": "sadhaiv sarab maan hai ||",
      "translation": "He is always honoured by all.",
      "punjabiViakhya": "ਸਦਾ ਸਭ ਦਾ ਮਾਣ ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "सदैव सरब मान है ॥",
      "sourceLineId": "80465",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕ੍ਰਿਪਾਲ ਕਾਲ ਹੀਨ ਹੈ ॥",
      "transliteration": "kirapaal kaal heen hai ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਲੂ ਅਤੇ ਕਾਲ ਤੋਂ ਰਹਿਤ ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "कृपाल काल हीन है ॥",
      "sourceLineId": "80466",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਦੈਵ ਸਾਧ ਅਧੀਨ ਹੈ ॥੫॥੧੩॥",
      "transliteration": "sadhaiv saadh adheen hai ||5||13||",
      "translation": "He is Merciful and Eternal and is always honoured by all.5.13.",
      "punjabiViakhya": "ਸਦਾ ਸੰਤਾ ਦੇ ਅਧੀਨ ਹੈਂ ॥੫॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "सदैव साध अधीन है ॥५॥१३॥",
      "sourceLineId": "80467",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭਜਸ ਤੁਯੰ ॥",
      "transliteration": "bhajas tuya(n) ||",
      "translation": "Therefore I meditate on Thee,",
      "punjabiViakhya": "(ਇਸ ਲਈ ਮੈਂ ਸਦਾ) ਤੈਨੂੰ ਭਜਦਾ ਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "भजस तुयं ॥",
      "sourceLineId": "80468",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭਜਸ ਤੁਯੰ ॥ ਰਹਾਉ ॥",
      "transliteration": "bhajas tuya(n) || rahaau ||",
      "translation": "I meditate on Thee. PAUSE.",
      "punjabiViakhya": "ਤੈਨੂੰ ਸਿਮਰਦਾ ਹਾ। ਰਹਾਉ।",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "भजस तुयं ॥ रहाउ ॥",
      "sourceLineId": "80469",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਗਾਧਿ ਬਿਆਧਿ ਨਾਸਨੰ ॥",
      "transliteration": "agaadh biaadh naasana(n) ||",
      "translation": "He is Unfathomable and destroyer of ailment",
      "punjabiViakhya": "(ਤੂੰ) ਅਗਾਧ ਅਤੇ ਵਿਆਧੀਆਂ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲਾ ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "अगाधि बिआधि नासनं ॥",
      "sourceLineId": "80470",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪਰੇਯੰ ਪਰਮ ਉਪਾਸਨੰ ॥",
      "transliteration": "pareya(n) param upaasana(n) ||",
      "translation": "He is far beyond and supremely aborable.",
      "punjabiViakhya": "ਬਹੁਤ ਹੀ ਪਰੇ ਅਤੇ ਸ੍ਰੇਸ਼ਠ ਉਪਾਸਨਾ ਦੇ ਯੋਗ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "परेयं परम उपासनं ॥",
      "sourceLineId": "80471",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤ੍ਰਿਕਾਲ ਲੋਕ ਮਾਨ ਹੈ ॥",
      "transliteration": "tirakaal lok maan hai ||",
      "translation": "He is worshipped by all in the past, present and future",
      "punjabiViakhya": "ਤਿੰਨਾ ਕਾਲਾ ਵਿਚ ਲੋਕੀਂ (ਤੈਨੂੰ) ਮੰਨਦੇ ਹਨ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "तृकाल लोक मान है ॥",
      "sourceLineId": "80472",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਦੈਵ ਪੁਰਖ ਪਰਧਾਨ ਹੈ ॥੬॥੧੪॥",
      "transliteration": "sadhaiv purakh paradhaan hai ||6||14||",
      "translation": "He is always the Supreme Purusha. 6. 14.",
      "punjabiViakhya": "(ਤੂੰ) ਸਦਾ ਪ੍ਰਧਾਨ ਪੁਰਖ ਹੈਂ ॥੬॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "सदैव पुरख परधान है ॥६॥१४॥",
      "sourceLineId": "80473",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਥਸ ਤੁਯੰ ॥",
      "transliteration": "tathas tuya(n) ||",
      "translation": "Thou art of such attributes",
      "punjabiViakhya": "ਤੂੰ ਹੀ ਅਜਿਹਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "तथस तुयं ॥",
      "sourceLineId": "80474",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਥਸ ਤੁਯੰ ॥ ਰਹਾਉ ॥",
      "transliteration": "tathas tuya(n) || rahaau ||",
      "translation": "Thou art of such attributes. PAUSE.",
      "punjabiViakhya": "ਤੂੰ ਹੀ ਅਜਿਹਾ ਹੈਂ। ਰਹਾਉ।",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "तथस तुयं ॥ रहाउ ॥",
      "sourceLineId": "80475",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕ੍ਰਿਪਾਲ ਦਿਆਲ ਕਰਮ ਹੈ ॥",
      "transliteration": "kirapaal dhiaal karam hai ||",
      "translation": "He, the merciful Lord performs actions of kindness",
      "punjabiViakhya": "(ਹੇ) ਕ੍ਰਿਪਾਲੂ! ਦਿਆਲਤਾ (ਤੇਰਾ) ਕਰਮ ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "कृपाल दिआल करम है ॥",
      "sourceLineId": "80476",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਗੰਜ ਭੰਜ ਭਰਮ ਹੈ ॥",
      "transliteration": "aga(n)j bha(n)j bharam hai ||",
      "translation": "He is invincible and destroys illusions.",
      "punjabiViakhya": "(ਹੇ) ਅਗੰਜ! (ਤੂੰ) ਭਰਮਾ ਨੂੰ ਭੰਨਦਾ ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "अगंज भंज भरम है ॥",
      "sourceLineId": "80477",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤ੍ਰਿਕਾਲ ਲੋਕ ਪਾਲ ਹੈ ॥",
      "transliteration": "tirakaal lok paal hai ||",
      "translation": "",
      "punjabiViakhya": "(ਤੂੰ) ਤਿੰਨਾ ਕਾਲਾ ਵਿਚ ਲੋਕਾ ਨੂੰ ਪਾਲਦਾ ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "तृकाल लोक पाल है ॥",
      "sourceLineId": "80478",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਦੈਵ ਸਰਬ ਦਿਆਲ ਹੈ ॥੭॥੧੫॥",
      "transliteration": "sadhaiv sarab dhiaal hai ||7||15||",
      "translation": "He is the Sustainer of people in past, present and future and is always compassionate towards all.7.15.",
      "punjabiViakhya": "ਸਦਾ ਸਭ ਉਤੇ ਦਿਆਲ ਹੁੰਦਾ ਹੈਂ ॥੭॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "सदैव सरब दिआल है ॥७॥१५॥",
      "sourceLineId": "80479",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਪਸ ਤੁਯੰ ॥",
      "transliteration": "japas tuya(n) ||",
      "translation": "Therefore I repeat Thy Name,",
      "punjabiViakhya": "(ਮੈਂ) ਤੈਨੂੰ ਜਪਦਾ ਹਾ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "जपस तुयं ॥",
      "sourceLineId": "80480",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਪਸ ਤੁਯੰ ॥ ਰਹਾਉ ॥",
      "transliteration": "japas tuya(n) || rahaau ||",
      "translation": "I repeat Thy Name. PAUSE.",
      "punjabiViakhya": "(ਮੈਂ) ਤੈਨੂੰ ਆਰਾਧਦਾ ਹਾ। ਰਹਾਉ।",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "जपस तुयं ॥ रहाउ ॥",
      "sourceLineId": "80481",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0128_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮਹਾਨ ਮੋਨ ਮਾਨ ਹੈ ॥",
      "transliteration": "mahaan mon maan hai ||",
      "translation": "He is Supreme in remaining peaceful",
      "punjabiViakhya": "(ਤੂੰ) ਮਹਾਨ ਮੋਨੀ ਮੰਨਿਆ ਜਾਣ ਵਾਲਾ ਹੈਂ;",
      "source": "DASAM_GRANTH",
      "ang": 128,
      "hindi": "",
      "hindiTransliteration": "महान मोन मान है ॥",
      "sourceLineId": "80482",
      "sourceShabadId": "7742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
