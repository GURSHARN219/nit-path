{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 135,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0135_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਖੰਡ ਖੰਡ ਦੁਪਲਾ ॥",
      "transliteration": "akha(n)dd kha(n)dd dhupalaa ||",
      "translation": "Thou destroyest in an instant seemingly imperishable warriors.",
      "punjabiViakhya": "ਅਖੰਡ (ਸਮਝੇ ਜਾਣ ਵਾਲਿਆਂ) ਨੂੰ ਦੋ ਪਲਾ ਵਿਚ ਹੀ ਖੰਡਿਤ ਕਰ ਦਿੰਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "अखंड खंड दुपला ॥",
      "sourceLineId": "80771",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਖਿਵੰਤ ਬਿਜੁ ਜ੍ਵਾਲਕਾ ॥",
      "transliteration": "khiva(n)t bij javaiaalakaa ||",
      "translation": "Thou movest like the fire of lightning",
      "punjabiViakhya": "ਬਿਜਲੀ ਵਾਗ (ਤੇਰੀ) ਜਵਾਲਾ ਖਿਮਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "खिवंत बिजु ज्वालका ॥",
      "sourceLineId": "80772",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਨੰਤ ਗਦਿ ਬਿਦਸਾ ॥੨॥੮੦॥",
      "transliteration": "ana(n)t gadh bidhasaa ||2||80||",
      "translation": "O Infinite Lord! Thy Thorne is visualized in all directions.2.80.",
      "punjabiViakhya": "ਅਤੇ ਚੌਹਾ ਪਾਸੇ ਅਨੰਤ ਸ਼ਬਦਾ (ਗਦਿ) ਦਾ ਗਾਇਨ ਹੁੰਦਾ ਹੈ ॥੨॥੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "अनंत गदि बिदसा ॥२॥८०॥",
      "sourceLineId": "80773",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਲਸੰਤ ਭਾਵ ਉਜਲੰ ॥",
      "transliteration": "lasa(n)t bhaav ujala(n) ||",
      "translation": "Thy Pure emotions gleam",
      "punjabiViakhya": "(ਤੇਰਾ) ਉਜਲਾ ਸਰੂਪ ਲਿਸ਼ਕਾ ਮਾਰਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "लसंत भाव उजलं ॥",
      "sourceLineId": "80774",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦਲੰਤ ਦੁਖ ਦੁ ਦਲੰ ॥",
      "transliteration": "dhala(n)t dhukh dh dhala(n) ||",
      "translation": "And destroy the forces of suffering.",
      "punjabiViakhya": "ਦੁੱਖਾ ਦੇ ਦੋਹਾ ਦਲਾ (ਜਨਮ ਅਤੇ ਮਰਨ) ਨੂੰ ਦਲ ਦਿੰਦਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "दलंत दुख दु दलं ॥",
      "sourceLineId": "80775",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪਵੰਗ ਪਾਤ ਸੋਹੀਯੰ ॥",
      "transliteration": "pava(n)g paat soheeya(n) ||",
      "translation": "The row of Thy horses looks graceful",
      "punjabiViakhya": "(ਤੇਰੇ) ਘੋੜਿਆਂ ਦੀ ਕਤਾਰ ਸ਼ੁਭਾਇਮਾਨ ਹੈ (ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ)",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "पवंग पात सोहीयं ॥",
      "sourceLineId": "80776",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਮੁੰਦ੍ਰ ਬਾਜ ਲੋਹੀਯੰ ॥੩॥੮੧॥",
      "transliteration": "samu(n)dhr baaj loheeya(n) ||3||81||",
      "translation": "Seeing which the horse of the Ocean gets angry.3.81.",
      "punjabiViakhya": "ਸਮੁੰਦਰ ਦਾ ਘੋੜਾ (ਬਾਜ) (ਉਚੈਸ੍ਰਵਾ) ਕ੍ਰੋਧਵਾਨ ਹੋ ਜਾਦਾ ਹੈ ॥੩॥੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "समुँद्र बाज लोहीयं ॥३॥८१॥",
      "sourceLineId": "80777",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਿਨੰਦ ਗੇਦ ਬ੍ਰਿਦਯੰ ॥",
      "transliteration": "nina(n)dh gedh biradhaya(n) ||",
      "translation": "Thou art radiant like the great ball of the Sun",
      "punjabiViakhya": "(ਤੇਰੇ ਸਿਰਜੇ ਹੋਏ) ਸਾਰੇ ਗੋਲ ਬ੍ਰਹਮੰਡ ਨਿੰਦਾ-ਰਹਿਤ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "निनंद गेद बृदयं ॥",
      "sourceLineId": "80778",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਖੇਦ ਨਾਦ ਦੁਧਰੰ ॥",
      "transliteration": "akhedh naadh dhudhara(n) ||",
      "translation": "Beyond the tunes of worldly joys.",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਆਨੰਦ ('ਅਖੇਦ') ਨਾਦ ਵਜੋਂ ਦੋਹਾ ਪਾਸੇ (ਪੂਰਨ) ਹੋ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "अखेद नाद दुधरं ॥",
      "sourceLineId": "80779",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਠਟ ਬਟ ਬਟਕੰ ॥",
      "transliteration": "aThaT baT baTaka(n) ||",
      "translation": "Thou art everlasting like the Bunyan-seed",
      "punjabiViakhya": "ਨਾ ਬਣਾਏ ਜਾ ਸਕਣ ('ਅਠਟ') ਵਾਲੀ (ਬ੍ਰਹਮ ਰੂਪ) ਗੋਲੀ ('ਬਟਕੰ') ਨੂੰ ਵਟਦੇ ਹੋ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "अठट बट बटकं ॥",
      "sourceLineId": "80780",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਘਟ ਅਨਟ ਸੁਖਲੰ ॥੪॥੮੨॥",
      "transliteration": "aghaT anaT sukhala(n) ||4||82||",
      "translation": "And art Blissful ever perfectly.4.82.",
      "punjabiViakhya": "ਨਾ ਘਟਣ ਵਾਲੇ ਸਦੀਵੀ ('ਅਨਟ') ਸੁਖਾ ਨਾਲ ਭਰੇ ਪੂਰੇ ਹੋ ॥੪॥੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "अघट अनट सुखलं ॥४॥८२॥",
      "sourceLineId": "80781",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਖੁਟ ਤੁਟ ਦ੍ਰਿਬਕੰ ॥",
      "transliteration": "akhuT tuT dhirabaka(n) ||",
      "translation": "The Treasure of Thy wealth is inexhaustible",
      "punjabiViakhya": "(ਤੇਰਾ) ਧਨ ('ਦ੍ਰਿਬਕੰ') ਨਾ ਮੁਕਣ ਵਾਲਾ ਅਤੇ ਨਾ ਘਟਣ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "अखुट तुट दृबकं ॥",
      "sourceLineId": "80782",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਜੁਟ ਛੁਟ ਸੁਛਕੰ ॥",
      "transliteration": "ajuT chhuT suchhaka(n) ||",
      "translation": "O Immaculate Lord! Thou art not united with anyone.",
      "punjabiViakhya": "(ਤੂੰ) ਨਾ ਜੁੜਨ ਵਾਲਾ ('ਅਜੁਟ') ਸੁਤੰਤਰ ਅਤੇ ਨਿਰਲਿਪਤ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "अजुट छुट सुछकं ॥",
      "sourceLineId": "80783",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਘੁਟ ਤੁਟ ਆਸਨੰ ॥",
      "transliteration": "aghuT tuT aasana(n) ||",
      "translation": "Thy seat is eternal",
      "punjabiViakhya": "(ਤੇਰਾ) ਆਸਣ ਨਾ ਘਟਣ ਵਾਲਾ ਅਤੇ ਨਾ ਟੁੱਟਣ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "अघुट तुट आसनं ॥",
      "sourceLineId": "80784",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਲੇਖ ਅਭੇਖ ਅਨਾਸਨੰ ॥੫॥੮੩॥",
      "transliteration": "alekh abhekh anaasana(n) ||5||83||",
      "translation": "Thou art accountless, guiseless and Imperishable.5.83.",
      "punjabiViakhya": "(ਤੂੰ) ਲੇਖੇ ਤੋਂ ਬਾਹਰ, ਭੇਖ ਤੋਂ ਰਹਿਤ ਅਤੇ ਨਾਸ਼ ਤੋਂ ਪਰੇ ਹੈਂ ॥੫॥੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "अलेख अभेख अनासनं ॥५॥८३॥",
      "sourceLineId": "80785",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੁਭੰਤ ਦੰਤ ਪਦੁਕੰ ॥",
      "transliteration": "subha(n)t dha(n)t padhuka(n) ||",
      "translation": "The row of thy teeth looks graceful",
      "punjabiViakhya": "(ਤੇਰੇ) ਦੰਦਾ ਦੀ ਪੰਕਤੀ ਸ਼ੋਭਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "सुभंत दंत पदुकं ॥",
      "sourceLineId": "80786",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਲੰਤ ਸਾਮ ਸੁ ਘਟੰ ॥",
      "transliteration": "jala(n)t saam su ghaTa(n) ||",
      "translation": "Seeing which the dark clouds feel jealous.",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਦੁਖਾ ਰੂਪੀ) ਕਾਲੀਆਂ ਘਟਾਵਾ ਸੜਦੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "जलंत साम सु घटं ॥",
      "sourceLineId": "80787",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੁਭੰਤ ਛੁਦ੍ਰ ਘੰਟਕਾ ॥",
      "transliteration": "subha(n)t chhudhr gha(n)Takaa ||",
      "translation": "The small bells look elegant in the string round Thy waist",
      "punjabiViakhya": "(ਤੇਰੀ ਤੜਾਗੀ ਨਾਲ) ਛੋਟੀਆਂ ਛੋਟੀਆਂ ਘੁੰਘਰੀਆਂ ਸੋਭ ਰਹੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "सुभंत छुद्र घंटका ॥",
      "sourceLineId": "80788",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਲੰਤ ਭਾਰ ਕਛਟਾ ॥੬॥੮੪॥",
      "transliteration": "jala(n)t bhaar kachhaTaa ||6||84||",
      "translation": "Seeing Thy effulgence the splendour of the Sun feels jealous.6.84.",
      "punjabiViakhya": "(ਤੇਰੀ) ਚਮਕ ਨੂੰ (ਵੇਖ ਕੇ) ਸੂਰਜ ਦੀ ਸ਼ੋਭਾ ਸੜਦੀ ਹੈ (ਦੁਖੀ ਹੁੰਦੀ ਹੈ ਜਾ ਸ਼ਰਮਾਉਾਂਦੀ ਹੈ) ॥੬॥੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "जलंत भार कछटा ॥६॥८४॥",
      "sourceLineId": "80789",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਿਰੀਸੁ ਸੀਸ ਸੁਭੀਯੰ ॥",
      "transliteration": "sirees sees subheeya(n) ||",
      "translation": "The crest on Thy head seems splendid",
      "punjabiViakhya": "(ਤੇਰੇ) ਸਿਰ ਉਤੇ ਕਲਗੀ ('ਸਿਰੀਸੁ') (ਇੰਜ) ਸੁਭਾਇਮਾਨ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "सिरीसु सीस सुभीयं ॥",
      "sourceLineId": "80790",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਘਟਾਕ ਬਾਨ ਉਭੀਯੰ ॥",
      "transliteration": "ghaTaak baan ubheeya(n) ||",
      "translation": "Like the shaft high up in the clouds.",
      "punjabiViakhya": "(ਜਿਵੇਾਂ) ਘਟਾਵਾ ਵਿਚ ਇੰਦਰ-ਧਨੁਸ਼ ('ਘਟਾਕ ਬਾਨ') ਉਭਰਿਆ ਹੋਇਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "घटाक बान उभीयं ॥",
      "sourceLineId": "80791",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੁਭੰਤ ਸੀਸ ਸਿਧਰੰ ॥",
      "transliteration": "subha(n)t sees sidhara(n) ||",
      "translation": "The Crown on Thy head looks elegant",
      "punjabiViakhya": "ਸਿਰ ਉਤੇ ਮੁਕਟ ('ਸਿਧਰੰ') ਸ਼ੋਭ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "सुभंत सीस सिधरं ॥",
      "sourceLineId": "80792",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਲੰਤ ਸਿਧਰੀ ਨਰੰ ॥੭॥੮੫॥",
      "transliteration": "jala(n)t sidharee nara(n) ||7||85||",
      "translation": "Seeing which the moon feels shy.7.85.",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ) ਚੰਦ੍ਰਮਾ ('ਸਿਧਰੀ ਨਿਰੰ') ਸ਼ਰਮਾਉਾਂਦਾ ਹੇ ॥੭॥੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "जलंत सिधरी नरं ॥७॥८५॥",
      "sourceLineId": "80793",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚਲੰਤ ਦੰਤ ਪਤਕੰ ॥",
      "transliteration": "chala(n)t dha(n)t pataka(n) ||",
      "translation": "The rows of demons are moving",
      "punjabiViakhya": "(ਤੁਹਾਨੂੰ ਵੇਖ ਕੇ) ਦੈਂਤਾ ਦੀਆਂ ਕਤਾਰਾ ਚਲੀਆਂ ਜਾਦੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "चलंत दंत पतकं ॥",
      "sourceLineId": "80794",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭਜੰਤ ਦੇਖਿ ਦੁਦਲੰ ॥",
      "transliteration": "bhaja(n)t dhekh dhudhala(n) ||",
      "translation": "And both the armies are running.",
      "punjabiViakhya": "ਅਤੇ ਦੁਸ਼ਟਾ ਦੇ ਦਲ ਭਜ ਜਾਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "भजंत देखि दुदलं ॥",
      "sourceLineId": "80795",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਜੰਤ ਸਸਤ੍ਰ ਅਸਤ੍ਰਕੰ ॥",
      "transliteration": "taja(n)t sasatr asatraka(n) ||",
      "translation": "When Thou usest Thy arms and weapons",
      "punjabiViakhya": "ਜਦੋਂ (ਤੁਸੀਂ) ਅਸਤ੍ਰ ਅਤੇ ਸ਼ਸਤ੍ਰ ਛਡਦੇ ਹੋ",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "तजंत ससत्र असत्रकं ॥",
      "sourceLineId": "80796",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚਲੰਤ ਚਕ੍ਰ ਚਉਦਿਸੰ ॥੮॥੮੬॥",
      "transliteration": "chala(n)t chakr chaudhisa(n) ||8||86||",
      "translation": "And Thy disc moves in all the four directions.8.86.",
      "punjabiViakhya": "(ਤਦੋਂ ਤੁਹਾਡਾ ਹੁਕਮ ਰੂਪ) ਚੱਕਰ ਚੌਹਾ ਪਾਸੇ ਚਲਣ ਲਗਦਾ ਹੈ ॥੮॥੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "चलंत चक्र चउदिसं ॥८॥८६॥",
      "sourceLineId": "80797",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਗੰਮ ਤੇਜ ਸੋਭੀਯੰ ॥",
      "transliteration": "aga(n)m tej sobheeya(n) ||",
      "translation": "Thy Inaccesible Glory looks elegant",
      "punjabiViakhya": "(ਤੁਹਾਡਾ) ਨਾ ਨਸ਼ਟ ਕੀਤਾ ਜਾ ਸਕਣ ਵਾਲਾ (ਅਗੰਜ) ਤੇਜ ਸ਼ੋਭ ਰਿਹਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "अगंम तेज सोभीयं ॥",
      "sourceLineId": "80798",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਰਿਖੀਸ ਈਸ ਲੋਭੀਯੰ ॥",
      "transliteration": "rikhees iees lobheeya(n) ||",
      "translation": "Therefore the great sages and Shiva are covetous to have Thy Sight.",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ ਵੇਖਣ ਲਈ) ਰਿਸ਼ੀ ਅਤੇ ਸ਼ਿਵ ਲੁਭਾਇਮਾਨ ਹੋ ਰਹੇ ਹਨ;",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "रिखीस ईस लोभीयं ॥",
      "sourceLineId": "80799",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਨੇਕ ਬਾਰ ਧਿਆਵਹੀ ॥",
      "transliteration": "anek baar dhiaavahee ||",
      "translation": "They remember Thy Name many times",
      "punjabiViakhya": "ਅਨੇਕ ਵਾਰ (ਤੇਰੇ ਨਾਮ ਦਾ) ਸਿਮਰਨ ਕਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "अनेक बार धिआवही ॥",
      "sourceLineId": "80800",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨ ਤਤ੍ਰ ਪਾਰ ਪਾਵਹੀ ॥੯॥੮੭॥",
      "transliteration": "n tatr paar paavahee ||9||87||",
      "translation": "Even then they have not been able go know Thy limits.9.87.",
      "punjabiViakhya": "(ਪਰ) ਫਿਰ ਵੀ ਤੇਰਾ ਪਾਰ ਨਹੀਂ ਪਾ ਸਕਦੇ ॥੯॥੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "न तत्र पार पावही ॥९॥८७॥",
      "sourceLineId": "80801",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਧੋ ਸੁ ਧੂਮ ਧੂਮਹੀ ॥",
      "transliteration": "adho su dhoom dhoomahee ||",
      "translation": "Many with faces upside down light the fire",
      "punjabiViakhya": "(ਅਨੇਕਾ ਲੋਕ) ਉਲਟੇ ਲਟਕ ਕੇ ਧੂਣੀਆਂ ਧੁਖਾਉਾਂਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "अधो सु धूम धूमही ॥",
      "sourceLineId": "80802",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਘੂਰ ਨੇਤ੍ਰ ਘੂਮਹੀ ॥",
      "transliteration": "aghoor netr ghoomahee ||",
      "translation": "Many ascetics roam forsaking their sleep.",
      "punjabiViakhya": "(ਅਨੇਕਾ ਸਾਧਕ) ਅਚਲ ਨੇਤਰਾ ਨਾਲ (ਇਧਰ ਉਧਰ) ਘੁੰਮਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "अघूर नेत्र घूमही ॥",
      "sourceLineId": "80803",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੁ ਪੰਚ ਅਗਨ ਸਾਧੀਯੰ ॥",
      "transliteration": "s pa(n)ch agan saadheeya(n) ||",
      "translation": "Many perform austerity of five fires",
      "punjabiViakhya": "(ਕਈ) ਪੰਜ ਅਗਨੀਆਂ ਜਾ ਧੂਣੀਆਂ ਧੁਖਾ ਕੇ ਸਾਧਨਾ ਕਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "सु पंच अगन साधीयं ॥",
      "sourceLineId": "80804",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨ ਤਾਮ ਪਾਰ ਲਾਧੀਯੰ ॥੧੦॥੮੮॥",
      "transliteration": "n taam paar laadheeya(n) ||10||88||",
      "translation": "Even they have not been able to know thy limits.10.88.",
      "punjabiViakhya": "(ਪਰ) ਤਾ ਵੀ (ਉਹ ਤੇਰਾ) ਪਾਰ ਨਹੀਂ ਪਾ ਸਕਦੇ ॥੧੦॥੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "न ताम पार लाधीयं ॥१०॥८८॥",
      "sourceLineId": "80805",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਿਵਲ ਆਦਿ ਕਰਮਣੰ ॥",
      "transliteration": "nival aadh karamana(n) ||",
      "translation": "The performance of Neoli Karma (cleansing of intestines): the innumerable religious acts of giving charities",
      "punjabiViakhya": "(ਚਾਹੇ ਕੋਈ) ਨੌਲਿ ਆਦਿ ਕਰਮ ਕਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "निवल आदि करमणं ॥",
      "sourceLineId": "80806",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਨੰਤ ਦਾਨ ਧਰਮਣੰ ॥",
      "transliteration": "ana(n)t dhaan dharamana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਨੰਤ ਦਾਨ ਦੇ ਕੇ ਧਰਮ-ਕਰਮ ਕਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "अनंत दान धरमणं ॥",
      "sourceLineId": "80807",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਨੰਤ ਤੀਰਥ ਬਾਸਨੰ ॥",
      "transliteration": "ana(n)t teerath baasana(n) ||",
      "translation": "Abiding at pilgrim-stations for numberless times",
      "punjabiViakhya": "ਅਨੇਕਾ ਤੀਰਥਾ ਉਤੇ ਜਾ ਕੇ ਵਸੇ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "अनंत तीरथ बासनं ॥",
      "sourceLineId": "80808",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨ ਏਕ ਨਾਮ ਕੇ ਸਮੰ ॥੧੧॥੮੯॥",
      "transliteration": "n ek naam ke sama(n) ||11||89||",
      "translation": "All these acts do not equal do not equal the merit of the remembrance of the Name of One Lord.11.89.",
      "punjabiViakhya": "(ਉਹ ਸਭ) ਇਕ ਨਾਮ ਜਪਣ ਦੇ ਤੁਲ ਨਹੀਂ ਹ ਨਾ ॥੧੧॥੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "न एक नाम के समं ॥११॥८९॥",
      "sourceLineId": "80809",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਨੰਤ ਜਗ੍ਯ ਕਰਮਣੰ ॥",
      "transliteration": "ana(n)t jagay karamana(n) ||",
      "translation": "The performance of innumerable acts of sacrifices",
      "punjabiViakhya": "(ਭਾਵੇਾਂ ਕੋਈ) ਅਨੰਤ ਯੱਗ ਅਤੇ ਕਰਮ (ਕਰਦਾ ਫਿਰੇ)",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "अनंत जग्य करमणं ॥",
      "sourceLineId": "80810",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗਜਾਦਿ ਆਦਿ ਧਰਮਣੰ ॥",
      "transliteration": "gajaadh aadh dharamana(n) ||",
      "translation": "The performance of the religious act of giving elephants etc. in charity",
      "punjabiViakhya": "ਹਾਥੀਆਂ ਨੂੰ ਦਾਨ ਦੇਣ ਦਾ ਧਰਮ ਪਾਲੇ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "गजादि आदि धरमणं ॥",
      "sourceLineId": "80811",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਨੇਕ ਦੇਸ ਭਰਮਣੰ ॥",
      "transliteration": "anek dhes bharamana(n) ||",
      "translation": "Wandering in many countries",
      "punjabiViakhya": "ਅਨੇਕ ਦੇਸਾ ਵਿਚ ਫਿਰਦਾ ਰਹੇ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "अनेक देस भरमणं ॥",
      "sourceLineId": "80812",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨ ਏਕ ਨਾਮ ਕੇ ਸਮੰ ॥੧੨॥੯੦॥",
      "transliteration": "n ek naam ke sama(n) ||12||90||",
      "translation": "All these acts do not equal the merit of the remembrance of the Name of One Lord.12.90.",
      "punjabiViakhya": "(ਇਹ ਸਭ) ਇਕ ਨਾਮ ਦੇ ਬਰਾਬਰ ਨਹੀਂ ਹਨ ॥੧੨॥੯੦॥",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "न एक नाम के समं ॥१२॥९०॥",
      "sourceLineId": "80813",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇਕੰਤ ਕੁੰਟ ਬਾਸਨੰ ॥",
      "transliteration": "eika(n)t ku(n)T baasana(n) ||",
      "translation": "Dwelling in solitary confinement",
      "punjabiViakhya": "(ਭਾਵੇਾਂ ਕੋਈ) ਗੁਫਾ ਵਿਚ ਇਕਾਤ ਵਾਸ ਕਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "इकंत कुँट बासनं ॥",
      "sourceLineId": "80814",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭ੍ਰਮੰਤ ਕੋਟਕੰ ਬਨੰ ॥",
      "transliteration": "bhrama(n)t koTaka(n) bana(n) ||",
      "translation": "Wandering in millions of forests",
      "punjabiViakhya": "ਕਰੋੜਾ ਬਨਾ ਵਿਚ ਭਰਮਦਾ ਰਹੇ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "भ्रमंत कोटकं बनं ॥",
      "sourceLineId": "80815",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਉਚਾਟਨਾਦ ਕਰਮਣੰ ॥",
      "transliteration": "auchaaTanaadh karamana(n) ||",
      "translation": "Becoming unattached many recite mantras",
      "punjabiViakhya": "ਦੁਨੀਆ ਤੋਂ ਉਚਾਟ ਹੋਣ ਦੇ ਕਰਮ ਕਰਦਾ ਰਹੇ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "उचाटनाद करमणं ॥",
      "sourceLineId": "80816",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਨੇਕ ਉਦਾਸ ਭਰਮਣੰ ॥੧੩॥੯੧॥",
      "transliteration": "anek udhaas bharamana(n) ||13||91||",
      "translation": "Many roam like hermits.13.91.",
      "punjabiViakhya": "ਅਤੇ ਉਦਾਸ ਹੋ ਕੇ ਅਨੇਕ (ਥਾਵਾ ਤੇ) ਫਿਰਦਾ ਰਹੇ ॥੧੩॥੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "अनेक उदास भरमणं ॥१३॥९१॥",
      "sourceLineId": "80817",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0135_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਨੇਕ ਭੇਖ ਆਸਨੰ ॥",
      "transliteration": "anek bhekh aasana(n) ||",
      "translation": "Many move in various guises and adopt several postures",
      "punjabiViakhya": "ਅਨੇਕ ਤਰ੍ਹਾ ਦੇ ਭੇਖ ਅਤੇ ਆਸਨ ਕਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 135,
      "hindi": "",
      "hindiTransliteration": "अनेक भेख आसनं ॥",
      "sourceLineId": "80818",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
