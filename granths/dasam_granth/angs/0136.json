{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 136,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0136_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਰੋਰ ਕੋਟਕੰ ਬ੍ਰਤੰ ॥",
      "transliteration": "karor koTaka(n) brata(n) ||",
      "translation": "Millions hold million types of fasts.",
      "punjabiViakhya": "ਕਰੋੜਾ ਵਾਰ ਕਰੋੜਾ ਤਰ੍ਹਾ ਦੇ ਬ੍ਰਤ ਧਾਰਨ ਕਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "करोर कोटकं ब्रतं ॥",
      "sourceLineId": "80819",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦਿਸਾ ਦਿਸਾ ਭ੍ਰਮੇਸਨੰ ॥",
      "transliteration": "dhisaa dhisaa bhramesana(n) ||",
      "translation": "One may roam in many directions",
      "punjabiViakhya": "ਦਿਸ਼ਾ-ਵਿਦਿਸ਼ਾ ਵਿਚ ਭਰਮਦਾ ਰਹੇ",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "दिसा दिसा भ्रमेसनं ॥",
      "sourceLineId": "80820",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਨੇਕ ਭੇਖ ਪੇਖਨੰ ॥੧੪॥੯੨॥",
      "transliteration": "anek bhekh pekhana(n) ||14||92||",
      "translation": "He may observe many types of guises.14.92.",
      "punjabiViakhya": "ਅਤੇ ਅਨੇਕਾ ਭੇਖਾ ਨੂੰ ਵੇਖਦਾ ਰਹੇ ॥੧੪॥੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "अनेक भेख पेखनं ॥१४॥९२॥",
      "sourceLineId": "80821",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਰੋਰ ਕੋਟ ਦਾਨਕੰ ॥",
      "transliteration": "karor koT dhaanaka(n) ||",
      "translation": "One may perform m,illions of types of charities",
      "punjabiViakhya": "ਕਰੋੜਾ ਵਾਰ ਕਰੋੜਾ ਤਰ੍ਹਾ ਦੇ ਦਾਨ ਕਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "करोर कोट दानकं ॥",
      "sourceLineId": "80822",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਨੇਕ ਜਗ੍ਯ ਕ੍ਰਤਬਿਯੰ ॥",
      "transliteration": "anek jagay kratabiya(n) ||",
      "translation": "He may perform many types of sacrifices and actions.",
      "punjabiViakhya": "ਅਨੇਕ ਤਰ੍ਹਾ ਦੇ ਯੱਗ ਕਰਦਾ ਫਿਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "अनेक जग्य क्रतबियं ॥",
      "sourceLineId": "80823",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਨ੍ਯਾਸ ਆਦਿ ਧਰਮਣੰ ॥",
      "transliteration": "sanayaas aadh dharamana(n) ||",
      "translation": "One may adopt the religious garb of mendicant",
      "punjabiViakhya": "ਸੰਨਿਆਸ ਆਦਿ ਧਰਮ (ਦਾ ਪਾਲਨ) ਕਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "सन्यास आदि धरमणं ॥",
      "sourceLineId": "80824",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਉਦਾਸ ਨਾਮ ਕਰਮਣੰ ॥੧੫॥੯੩॥",
      "transliteration": "audhaas naam karamana(n) ||15||93||",
      "translation": "He may perform many rituals of a hermit. 15.93.",
      "punjabiViakhya": "ਅਤੇ ਉਦਾਸ ਨਾਮ ਵਾਲੇ ਕਰਮ ਕਰਦਾ ਫਿਰੇ ॥੧੫॥੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "उदास नाम करमणं ॥१५॥९३॥",
      "sourceLineId": "80825",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਨੇਕ ਪਾਠ ਪਾਠਨੰ ॥",
      "transliteration": "anek paaTh paaThana(n) ||",
      "translation": "One may read the religious texts continuously",
      "punjabiViakhya": "ਅਨੇਕ ਤਰ੍ਹਾ ਦੇ ਪਾਠ ਪੜ੍ਹਦਾ ਰਹੇ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "अनेक पाठ पाठनं ॥",
      "sourceLineId": "80826",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਨੰਤ ਠਾਟ ਠਾਟਨੰ ॥",
      "transliteration": "ana(n)t ThaaT ThaaTana(n) ||",
      "translation": "He may perform many ostentations.",
      "punjabiViakhya": "ਅਨੇਕ ਤਰ੍ਹਾ ਦੇ ਠਾਠ ਬਣਾਉਾਂਦਾ ਰਹੇ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "अनंत ठाट ठाटनं ॥",
      "sourceLineId": "80827",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨ ਏਕ ਨਾਮ ਕੇ ਸਮੰ ॥",
      "transliteration": "n ek naam ke sama(n) ||",
      "translation": "None of them equals the Name of One Lord",
      "punjabiViakhya": "(ਪਰ ਇਨ੍ਹਾ ਵਿਚੋਂ ਕੋਈ ਵੀ ਪਰਮਾਤਮਾ ਦੇ) ਇਕ ਨਾਮ ਦੇ ਸਮਾਨ ਨਹੀਂ ਹੈ?",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "न एक नाम के समं ॥",
      "sourceLineId": "80828",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਮਸਤ ਸ੍ਰਿਸਟ ਕੇ ਭ੍ਰਮੰ ॥੧੬॥੯੪॥",
      "transliteration": "samasat sirasaT ke bhrama(n) ||16||94||",
      "translation": "They are all an illusion like the world.16.94.",
      "punjabiViakhya": "(ਇਹ) ਸਾਰੇ ਅਸਲ ਵਿਚ ਸ੍ਰਿਸ਼ਟੀ (ਵਿਚ ਪਸਰੇ) ਭਰਮ ਹੀ ਹਨ ॥੧੬॥੯੪॥",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "समसत सृसट के भ्रमं ॥१६॥९४॥",
      "sourceLineId": "80829",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਗਾਦਿ ਆਦਿ ਧਰਮਣੰ ॥",
      "transliteration": "jagaadh aadh dharamana(n) ||",
      "translation": "One may perform the religious acts of the ancient ages",
      "punjabiViakhya": "(ਭਾਵੇਾਂ ਕੋਈ) ਯੱਗ ਆਦਿ ਧਰਮਾ ਦਾ ਪਾਲਨ ਕਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "जगादि आदि धरमणं ॥",
      "sourceLineId": "80830",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬੈਰਾਗ ਆਦਿ ਕਰਮਣੰ ॥",
      "transliteration": "bairaag aadh karamana(n) ||",
      "translation": "He may perform the ascetic and monastic works.",
      "punjabiViakhya": "ਬੈਰਾਗ ਆਦਿ ਕਰਮ ਕਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "बैराग आदि करमणं ॥",
      "sourceLineId": "80831",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦਯਾਦਿ ਆਦਿ ਕਾਮਣੰ ॥",
      "transliteration": "dhayaadh aadh kaamana(n) ||",
      "translation": "He may perform the works of mercy etc., and magic",
      "punjabiViakhya": "ਦਇਆ ਆਦਿ ਕਾਮਨਾਵਾ ਕਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "दयादि आदि कामणं ॥",
      "sourceLineId": "80832",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਨਾਦ ਸੰਜਮੰ ਬ੍ਰਿਦੰ ॥੧੭॥੯੫॥",
      "transliteration": "anaadh sa(n)jama(n) biradha(n) ||17||95||",
      "translation": "They are all wworks of great restraint, prevalent from times immemorial.17.95.",
      "punjabiViakhya": "ਅਨਾਦਿ ਕਾਲ ਤੋਂ ਚਲੇ ਆ ਰਹੇ ਵੱਡੇ ਸੰਯਮ ਧਾਰਨ ਕਰੇ ॥੧੭॥੯੫॥",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "अनाद संजमं बृदं ॥१७॥९५॥",
      "sourceLineId": "80833",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਨੇਕ ਦੇਸ ਭਰਮਣੰ ॥",
      "transliteration": "anek dhes bharamana(n) ||",
      "translation": "One may wander in many countries",
      "punjabiViakhya": "(ਭਾਵੇਾਂ ਕੋਈ) ਅਨੇਕ ਦੇਸ਼ਾ ਵਿਚ ਘੁੰਮਦਾ ਫਿਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "अनेक देस भरमणं ॥",
      "sourceLineId": "80834",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਰੋਰ ਦਾਨ ਸੰਜਮੰ ॥",
      "transliteration": "karor dhaan sa(n)jama(n) ||",
      "translation": "He may adopt the discipline of giving million of charities.",
      "punjabiViakhya": "ਕਰੋੜਾ ਦਾਨ ਦੇਣ ਦਾ ਸੰਯਮ ਕਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "करोर दान संजमं ॥",
      "sourceLineId": "80835",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਨੇਕ ਗੀਤ ਗਿਆਨਨੰ ॥",
      "transliteration": "anek geet giaanana(n) ||",
      "translation": "Many songs of knowledge are sung",
      "punjabiViakhya": "ਅਨੇਕ ਤਰ੍ਹਾ ਗਿਆਨ-ਗੀਤਾ ਦਾ ਗਾਇਨ ਕਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "अनेक गीत गिआननं ॥",
      "sourceLineId": "80836",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਨੰਤ ਗਿਆਨ ਧਿਆਨਨੰ ॥੧੮॥੯੬॥",
      "transliteration": "ana(n)t giaan dhiaanana(n) ||18||96||",
      "translation": "He may be proficient in innumerable types of knowledge and contemplation.18.96.",
      "punjabiViakhya": "ਅਨੇਕ ਤਰ੍ਹਾ ਦੇ ਧਿਆਨਾ ਨੂੰ ਜਾਣਦਾ ਹੋਵੇ ॥੧੮॥੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "अनंत गिआन धिआननं ॥१८॥९६॥",
      "sourceLineId": "80837",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਨੰਤ ਗਿਆਨ ਸੁਤਮੰ ॥",
      "transliteration": "ana(n)t giaan sutama(n) ||",
      "translation": "Those who are superb by achieving millions of types of knowledge",
      "punjabiViakhya": "(ਭਾਵੇਾਂ ਕੋਈ) ਅਨੇਕ ਤਰ੍ਹਾ ਦੇ ਸ੍ਰੇਸ਼ਠ ਗਿਆਨ ਜਾਣਦਾ ਫਿਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "अनंत गिआन सुतमं ॥",
      "sourceLineId": "80838",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਨੇਕ ਕ੍ਰਿਤ ਸੁ ਬ੍ਰਿਤੰ ॥",
      "transliteration": "anek kirat su birata(n) ||",
      "translation": "They are also observing many good actions.",
      "punjabiViakhya": "ਅਨੇਕ ਸ਼ੁਭ ਕਰਮਾ ਵਿਚ ਬਿਰਤੀ ਲਗਾਦਾ ਰਹੇ",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "अनेक कृत सु बृतं ॥",
      "sourceLineId": "80839",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਿਆਸ ਨਾਰਦ ਆਦਕੰ ॥",
      "transliteration": "biaas naaradh aadhaka(n) ||",
      "translation": "Like Vyas, Narad etc.,",
      "punjabiViakhya": "(ਪਰ) ਬਿਆਸ ਨਾਰਦ ਆਦਿ ਵੀ",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "बिआस नारद आदकं ॥",
      "sourceLineId": "80840",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੁ ਬ੍ਰਹਮੁ ਮਰਮ ਨਹਿ ਲਹੰ ॥੧੯॥੯੭॥",
      "transliteration": "s braham maram neh laha(n) ||19||97||",
      "translation": "they even have not been able to know the secret of a Brahman.19.97.",
      "punjabiViakhya": "ਉਸ ਬ੍ਰਹਮ ਦਾ ਭੇਦ ਨਹੀਂ ਪਾ ਸਕਦੇ ॥੧੯॥੯੭॥",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "सु ब्रहमु मरम नहि लहं ॥१९॥९७॥",
      "sourceLineId": "80841",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਰੋਰ ਜੰਤ੍ਰ ਮੰਤ੍ਰਣੰ ॥",
      "transliteration": "karor ja(n)tr ma(n)trana(n) ||",
      "translation": "Though millions of yantras and mantras may be practiced",
      "punjabiViakhya": "(ਭਾਵੇਾਂ ਕੋਈ) ਕਰੋੜਾ ਜੰਤਰ-ਮੰਤਰ ਕਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "करोर जंत्र मंत्रणं ॥",
      "sourceLineId": "80842",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਨੰਤ ਤੰਤ੍ਰਣੰ ਬਣੰ ॥",
      "transliteration": "ana(n)t ta(n)trana(n) bana(n) ||",
      "translation": "And innumerable Tantras may be made.",
      "punjabiViakhya": "ਅਨੰਤ ਤੰਤਰ ਬਣਾਉਾਂਦਾ ਫਿਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "अनंत तंत्रणं बणं ॥",
      "sourceLineId": "80843",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਸੇਖ ਬ੍ਯਾਸ ਨਾਸਨੰ ॥",
      "transliteration": "basekh bayaas naasana(n) ||",
      "translation": "One may even sit on the seat of Vyas",
      "punjabiViakhya": "ਵਿਸ਼ੇਸ਼ ਰੂਪ ਵਿਚ ਬਿਆਸ ਰਿਸ਼ੀ ਦੀ ਗੱਦੀ ਉਤੇ ਬੈਠਣ (ਦਾ ਉਦਮ ਕਰੇ)",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "बसेख ब्यास नासनं ॥",
      "sourceLineId": "80844",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਨੰਤ ਨ੍ਯਾਸ ਪ੍ਰਾਸਨੰ ॥੨੦॥੯੮॥",
      "transliteration": "ana(n)t nayaas praasana(n) ||20||98||",
      "translation": "And forsake many types of food.20.98.",
      "punjabiViakhya": "ਅਨੇਕ ਤਰ੍ਹਾ ਦੇ ਭੋਜਨਾ ਦਾ ਤਿਆਗ ਕਰੇ ॥੨੦॥੯੮॥",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "अनंत न्यास प्रासनं ॥२०॥९८॥",
      "sourceLineId": "80845",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਪੰਤ ਦੇਵ ਦੈਤਨੰ ॥",
      "transliteration": "japa(n)t dhev dhaitana(n) ||",
      "translation": "All the gods and demons remember Him",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ! ਤੈਨੂੰ) ਦੈਂਤ ਅਤੇ ਦੇਵਤੇ ਜਪਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "जपंत देव दैतनं ॥",
      "sourceLineId": "80846",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਥਪੰਤ ਜਛ ਗੰਧ੍ਰਬੰ ॥",
      "transliteration": "thapa(n)t jachh ga(n)dhraba(n) ||",
      "translation": "All the Yakshas and Gandharvas worship Him.",
      "punjabiViakhya": "ਜੱਛ (ਯਕਸ਼) ਅਤੇ ਗੰਧਰਬ ਪੂਜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "थपंत जछ गंध्रबं ॥",
      "sourceLineId": "80847",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਦੰਤ ਬਿਦਣੋਧਰੰ ॥",
      "transliteration": "badha(n)t bidhanodhara(n) ||",
      "translation": "The Visyadhars sing His Prises",
      "punjabiViakhya": "ਵਿਦਿਆਧਰ ਯਸ਼ ਗਾਉਾਂਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "बदंत बिदणोधरं ॥",
      "sourceLineId": "80848",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗਣੰਤ ਸੇਸ ਉਰਗਣੰ ॥੨੧॥੯੯॥",
      "transliteration": "gana(n)t ses uragana(n) ||21||99||",
      "translation": "The reamaing categories including Nagas remember His Name.21.99.",
      "punjabiViakhya": "ਸ਼ੇਸ਼ ਨਾਗ ('ਉਰਗਣ') ਨਾਮ ਜਪਦੇ ਹਨ ('ਗਣੰਤ') ॥੨੧॥੯੯॥",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "गणंत सेस उरगणं ॥२१॥९९॥",
      "sourceLineId": "80849",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਪੰਤ ਪਾਰਵਾਰਯੰ ॥",
      "transliteration": "japa(n)t paaravaaraya(n) ||",
      "translation": "He is remembered by all in this and other worlds",
      "punjabiViakhya": "(ਤੈਨੂੰ) ਉਰਾਰ ਅਤੇ ਪਾਰ (ਦੇ ਲੋਕ) ਜਪਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "जपंत पारवारयं ॥",
      "sourceLineId": "80850",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਮੁੰਦ੍ਰ ਸਪਤ ਧਾਰਯੰ ॥",
      "transliteration": "samu(n)dhr sapat dhaaraya(n) ||",
      "translation": "He hath put the seven oceans at their places.",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਸੱਤ ਸਮੁੰਦਰ ਟਿਕਾਏ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "समुँद्र सपत धारयं ॥",
      "sourceLineId": "80851",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਣੰਤ ਚਾਰ ਚਕ੍ਰਣੰ ॥",
      "transliteration": "jana(n)t chaar chakrana(n) ||",
      "translation": "He is known in all the four directions",
      "punjabiViakhya": "ਚੌਹਾ ਚੱਕਾ ਵਿਚ (ਤੁਸੀਂ) ਜਾਣੇ ਜਾਦੇ ਹੋ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "जणंत चार चक्रणं ॥",
      "sourceLineId": "80852",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਧ੍ਰਮੰਤ ਚਕ੍ਰ ਬਕ੍ਰਣੰ ॥੨੨॥੧੦੦॥",
      "transliteration": "dhrama(n)t chakr bakrana(n) ||22||100||",
      "translation": "The wheel of His Discipline keeps moving.22.100.",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਟੇਢੇ ਚੱਕਰ ਨੂੰ ਧਾਰਨ ਕੀਤਾ ਹੋਇਆ ਹੈ ॥੨੨॥੧੦੦॥",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "ध्रमंत चक्र बक्रणं ॥२२॥१००॥",
      "sourceLineId": "80853",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਪੰਤ ਪੰਨਗੰ ਨਕੰ ॥",
      "transliteration": "japa(n)t pa(n)naga(n) naka(n) ||",
      "translation": "He is remembered by serpents and octopus",
      "punjabiViakhya": "(ਤੈਨੂੰ) ਸੱਪ ('ਪੰਨਗੰ') ਅਤੇ ਤੇਾਂਦੂਏ ('ਨਕੰ') ਜਪਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "जपंत पंनगं नकं ॥",
      "sourceLineId": "80854",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਰੰ ਨਰੰ ਬਨਸਪਤੰ ॥",
      "transliteration": "bara(n) nara(n) banasapata(n) ||",
      "translation": "The vegetation narrates His Praises.",
      "punjabiViakhya": "ਬਨਸਪਤੀ ਅਤੇ ਸ੍ਰਸ਼ਠ ਮਨੁੱਖ (ਤੇਰਾ ਵਰਣਨ) ਕਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "बरं नरं बनसपतं ॥",
      "sourceLineId": "80855",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਕਾਸ ਉਰਬੀਅੰ ਜਲੰ ॥",
      "transliteration": "akaas urabeea(n) jala(n) ||",
      "translation": "The beings of sky, earth and water remember Him",
      "punjabiViakhya": "ਆਕਾਸ਼, ਪ੍ਰਿਥਵੀ ('ਉਰਬੀਅੰ') ਪਾਤਾਲ (ਜਲੰ-ਜਲ ਦਾ ਹੇਠਲਾ ਲੋਕ)",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "अकास उरबीअं जलं ॥",
      "sourceLineId": "80856",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਪੰਤ ਜੀਵ ਜਲ ਥਲੰ ॥੨੩॥੧੦੧॥",
      "transliteration": "japa(n)t jeev jal thala(n) ||23||101||",
      "translation": "The beings in water and on land repeat His Name.23.101.",
      "punjabiViakhya": "ਅਤੇ ਜਲਾ-ਥਲਾ ਦੇ ਜੀਵ ਜਪਦੇ ਹਨ ॥੨੩॥੧੦੧॥",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "जपंत जीव जल थलं ॥२३॥१०१॥",
      "sourceLineId": "80857",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੋ ਕੋਟ ਚਕ੍ਰ ਬਕਤ੍ਰਣੰ ॥",
      "transliteration": "so koT chakr bakatrana(n) ||",
      "translation": "Millions of four-headed Brahmas",
      "punjabiViakhya": "ਕਰੋੜਾ ਚੌਹਾ ਮੂੰਹਾ ਵਾਲੇ ਬ੍ਰਹਮੇ (ਚਕ੍ਰ ਬਕਤ੍ਰਣੰ)",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "सो कोट चक्र बकत्रणं ॥",
      "sourceLineId": "80858",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਦੰਤ ਬੇਦ ਚਤ੍ਰਕੰ ॥",
      "transliteration": "badha(n)t bedh chatraka(n) ||",
      "translation": "Recite the four Vedas.",
      "punjabiViakhya": "ਅਤੇ ਚਾਰ ਵੇਦ (ਤੇਰਾ) ਯਸ਼ ਕਥਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "बदंत बेद चत्रकं ॥",
      "sourceLineId": "80859",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਸੰਭ ਅਸੰਭ ਮਾਨੀਐ ॥",
      "transliteration": "asa(n)bh asa(n)bh maaneeaai ||",
      "translation": "Millions of Shiva worship that Wonderful Entity",
      "punjabiViakhya": "ਸ਼ਿਵ (ਤੇਰੇ) ਵਿਚਿਤ੍ਰ ਰੂਪ ਨੂੰ ਮੰਨਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "असंभ असंभ मानीऐ ॥",
      "sourceLineId": "80860",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਰੋਰ ਬਿਸਨ ਠਾਨੀਐ ॥੨੪॥੧੦੨॥",
      "transliteration": "karor bisan Thaaneeaai ||24||102||",
      "translation": "Millions of Vishnus adore Him.24.102.",
      "punjabiViakhya": "ਅਤੇ ਕਰੋੜਾ ਵਿਸ਼ਣੂ ਵੀ (ਤੇਰਾ) ਧਿਆਨ ਕਰਦੇ ਹਨ ॥੨੪॥੧੦੨॥",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "करोर बिसन ठानीऐ ॥२४॥१०२॥",
      "sourceLineId": "80861",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਨੰਤ ਸੁਰਸੁਤੀ ਸਤੀ ॥",
      "transliteration": "ana(n)t surasutee satee ||",
      "translation": "Innumerable Sarswatis goddess and Satis (Parvati-goddess)",
      "punjabiViakhya": "ਅਨੰਤ ਸਰਸਵਤੀ, ਸਤੀ ਅਤੇ ਲਕਸ਼ਮੀ ਆਦਿ ਦੇਵੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "अनंत सुरसुती सती ॥",
      "sourceLineId": "80862",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਦੰਤ ਕ੍ਰਿਤ ਈਸੁਰੀ ॥",
      "transliteration": "badha(n)t kirat ieesuree ||",
      "translation": "And Lakshmis goddess and Satis (Parvati-goddess) and Lakshmis goddess sing His Praises.",
      "punjabiViakhya": "ਤੇਰੇ ਯਸ਼ ਦਾ ਗਾਇਨ ਕਰਦੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "बदंत कृत ईसुरी ॥",
      "sourceLineId": "80863",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਨੰਤ ਅਨੰਤ ਭਾਖੀਐ ॥",
      "transliteration": "ana(n)t ana(n)t bhaakheeaai ||",
      "translation": "Innumerable Sheshanaga eulogize Him",
      "punjabiViakhya": "ਅਨੰਤ ਸ਼ੇਸ਼ਨਾਗ (ਅਨੰਤ) ਸਿਮਰਨ ਕਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "अनंत अनंत भाखीऐ ॥",
      "sourceLineId": "80864",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਨੰਤ ਅੰਤ ਲਾਖੀਐ ॥੨੫॥੧੦੩॥",
      "transliteration": "ana(n)t a(n)t laakheeaai ||25||103||",
      "translation": "That Lord is comprehended as infinite ultimeately.25.103.",
      "punjabiViakhya": "ਅੰਤ ਵਿਚ (ਸਭ ਦੁਅਰਾ ਤੂੰ) ਅਨੰਤ ਰੂਪ ਵਾਲਾ ਜਾਣਿਆ ਜਾਦਾ ਹੈ ॥੨੫॥੧੦੩॥",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "अनंत अंत लाखीऐ ॥२५॥१०३॥",
      "sourceLineId": "80865",
      "sourceShabadId": "7758",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0136_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬ੍ਰਿਧ ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "biradh naraaj chha(n)dh ||",
      "translation": "BRIDH NARAAJ STANZA",
      "punjabiViakhya": "ਬ੍ਰਿਧ ਨਰਾਜ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 136,
      "hindi": "",
      "hindiTransliteration": "बृध नराज छंद ॥",
      "sourceLineId": "80866",
      "sourceShabadId": "7759",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
