  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0138_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗਤਸਤੁਆ ਅਗੰਡੰ ॥੭॥੧੧੫॥",
      "transliteration": "gatasatuaa aga(n)dda(n) ||7||115||",
      "translation": "Thou canst not be attached with anything.7.115.",
      "punjabiViakhya": "ਅੰਗਾ ਤੋਂ ਬਿਨਾ ਤੂੰ ਗਤਿਮਾਨ ਹੈਂ ॥੭॥੧੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "गतसतुआ अगंडं ॥७॥११५॥",
      "sourceLineId": "80915",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਘਰਸਤੁਆ ਘਰਾਨੰ ॥",
      "transliteration": "gharasatuaa gharaana(n) ||",
      "translation": "Thou art the superb Abode among abodes",
      "punjabiViakhya": "ਘਰਾਨਿਆਂ ਦਾ ਤੂੰ ਘਰ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "घरसतुआ घरानं ॥",
      "sourceLineId": "80916",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਙ੍ਰਿਅਸਤੁਆ ਙ੍ਰਿਹਾਲੰ ॥",
      "transliteration": "n(g)riasatuaa n(g)irahaala(n) ||",
      "translation": "Thou art the householder among householders.",
      "punjabiViakhya": "ਗ੍ਰਿਹਸਥੀਆਂ ਵਿਚ ਤੂੰ ਗ੍ਰਿਹਸਥੀ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "ङृअसतुआ ङृहालं ॥",
      "sourceLineId": "80917",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚਿਤਸਤੁਆ ਅਤਾਪੰ ॥",
      "transliteration": "chitasatuaa ataapa(n) ||",
      "translation": "Thou art conscious Entity devoid of ailments",
      "punjabiViakhya": "ਚੇਤਨ ਸਰੂਪ ਹੋ ਕੇ ਤੂੰ ਦੁਖਾ ਤੋਂ ਰਹਿਤ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "चितसतुआ अतापं ॥",
      "sourceLineId": "80918",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਛਿਤਸਤੁਆ ਅਛਾਪੰ ॥੮॥੧੧੬॥",
      "transliteration": "chhitasatuaa achhaapa(n) ||8||116||",
      "translation": "Thou art there on the eath but hidden.8.116.",
      "punjabiViakhya": "ਧਰਤੀ (ਛਿਤ) ਉਤੇ ਤੂੰ ਹੀ ਪ੍ਰਗਟ ਹੈਂ ॥੮॥੧੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "छितसतुआ अछापं ॥८॥११६॥",
      "sourceLineId": "80919",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਿਤਸਤੁਆ ਅਜਾਪੰ ॥",
      "transliteration": "jitasatuaa ajaapa(n) ||",
      "translation": "Thou art conqueror and without effect on muttering",
      "punjabiViakhya": "ਤੂੰ ਜਿਤ ਰੂਪ ਅਤੇ ਜਾਪਾ ਤੋਂ ਪਰੇ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "जितसतुआ अजापं ॥",
      "sourceLineId": "80920",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਝਿਕਸਤੁਆ ਅਝਾਪੰ ॥",
      "transliteration": "jhikasatuaa ajhaapa(n) ||",
      "translation": "Thou art Fearless and Invisible.",
      "punjabiViakhya": "ਤੂੰ ਕਿਸੇ ਦੀ ਰੁਕਾਵਟ ਤੋਂ ਨਹੀਂ ਡਰਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "झिकसतुआ अझापं ॥",
      "sourceLineId": "80921",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਇਕਸਤੁਆ ਅਨੇਕੰ ॥",
      "transliteration": "eikasatuaa aneka(n) ||",
      "translation": "Thou art the Only One amongst many :",
      "punjabiViakhya": "ਅਨੇਕਾ ਵਿਚ ਤੂੰ ਇਕ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "इकसतुआ अनेकं ॥",
      "sourceLineId": "80922",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਟੁਟਸਤੁਆ ਅਟੇਟੰ ॥੯॥੧੧੭॥",
      "transliteration": "TuTasatuaa aTeTa(n) ||9||117||",
      "translation": "Thou art ever indivisble.9.117",
      "punjabiViakhya": "ਤੂੰ ਤੋੜਨ ਵਾਲਾ ਹੈ ਪਰ (ਆਪ) ਅਟੁੱਟ ਹੈਂ ॥੯॥੧੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "टुटसतुआ अटेटं ॥९॥११७॥",
      "sourceLineId": "80923",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਠਟਸਤੁਆ ਅਠਾਟੰ ॥",
      "transliteration": "ThaTasatuaa aThaaTa(n) ||",
      "translation": "Thou art beyond all ostentations",
      "punjabiViakhya": "ਤੂੰ ਠਾਠਾ ਵਾਲਾ ਅਤੇ ਠਾਠ-ਰਹਿਤ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "ठटसतुआ अठाटं ॥",
      "sourceLineId": "80924",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਡਟਸਤੁਆ ਅਡਾਟੰ ॥",
      "transliteration": "ddaTasatuaa addaaTa(n) ||",
      "translation": "Thou art far away from all pressures.",
      "punjabiViakhya": "ਤੂੰ ਡਾਟਣ ਵਾਲਾ ਅਤੇ (ਆਪ) ਡਾਟਣ ਤੋਂ ਪਰੇ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "डटसतुआ अडाटं ॥",
      "sourceLineId": "80925",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਢਟਸਤੁਆ ਅਢਾਪੰ ॥",
      "transliteration": "ddaTasatuaa addaapa(n) ||",
      "translation": "Thou canst not be vanquished by anyone",
      "punjabiViakhya": "ਤੂੰ ਢਾਹੁਣ ਵਾਲਾ ਅਤੇ ਨਾ ਢਾਹੇ ਜਾ ਸਕਣ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "ढटसतुआ अढापं ॥",
      "sourceLineId": "80926",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਣਕਸਤੁਆ ਅਣਾਪੰ ॥੧੦॥੧੧੮॥",
      "transliteration": "nakasatuaa anaapa(n) ||10||118||",
      "translation": "Thy limits canst not be measured by anyone.10.118.",
      "punjabiViakhya": "ਤੂੰ ਨਾਪਣ ਵਾਲਾ ਅਤੇ ਨਾਪ-ਰਹਿਤ ਹੈਂ ॥੧੦॥੧੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "णकसतुआ अणापं ॥१०॥११८॥",
      "sourceLineId": "80927",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਪਸਤੁਆ ਅਤਾਪੰ ॥",
      "transliteration": "tapasatuaa ataapa(n) ||",
      "translation": "Thou art beyond all ailments and agonies",
      "punjabiViakhya": "ਤੂੰ ਤਪ-ਤੇਜ ਵਾਲਾ ਹੈਂ (ਪਰ ਆਪ) ਅਤਾਪ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "तपसतुआ अतापं ॥",
      "sourceLineId": "80928",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਥਪਸਤੁਆ ਅਥਾਪੰ ॥",
      "transliteration": "thapasatuaa athaapa(n) ||",
      "translation": "Thou canst not established.",
      "punjabiViakhya": "ਤੂੰ ਥਾਪਣਾ ਵਾਲਾ (ਅਤੇ ਆਪ) ਕਿਸੇ ਦੁਆਰਾ ਨਾ ਥਾਪੇ ਜਾਣ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "थपसतुआ अथापं ॥",
      "sourceLineId": "80929",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦਲਸਤੁਆਦਿ ਦੋਖੰ ॥",
      "transliteration": "dhalasatuaadh dhokha(n) ||",
      "translation": "Thou art the masher of all blemishes from the beginning",
      "punjabiViakhya": "ਆਦਿ ਤੋਂ ਹੀ ਤੂੰ ਦੁਖਾ ਨੂੰ ਦਲਣ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "दलसतुआदि दोखं ॥",
      "sourceLineId": "80930",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਹਿਸਤੁਆ ਅਨੋਖੰ ॥੧੧॥੧੧੯॥",
      "transliteration": "nahisatuaa anokha(n) ||11||119||",
      "translation": "There is none other so extraordinary as Thou.11.119.",
      "punjabiViakhya": "ਤੇਰੇ ਵਰਗਾ ਕੋਈ ਅਨੋਖਾ ਨਹੀਂ ਹੈ ॥੧੧॥੧੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "नहिसतुआ अनोखं ॥११॥११९॥",
      "sourceLineId": "80931",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਪਕਤੁਆ ਅਪਾਨੰ ॥",
      "transliteration": "apakatuaa apaana(n) ||",
      "translation": "Thou art Most Holy",
      "punjabiViakhya": "ਤੂੰ ਪਕਣ ਅਤੇ ਪੀਣ ਤੋਂ ਮੁਕਤ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "अपकतुआ अपानं ॥",
      "sourceLineId": "80932",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਫਲਕਤੁਆ ਫਲਾਨੰ ॥",
      "transliteration": "falakatuaa falaana(n) ||",
      "translation": "Thou promptest the flourishing of the world.",
      "punjabiViakhya": "ਫਲਾ ਵਿਚ ਤੂੰ ਫਲ-ਰੂਪ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "फलकतुआ फलानं ॥",
      "sourceLineId": "80933",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਦਕਤੁਆ ਬਿਸੇਖੰ ॥",
      "transliteration": "badhakatuaa bisekha(n) ||",
      "translation": "Distinctively Thou art Supporting",
      "punjabiViakhya": "ਬਦੀ ਕਰਨ ਵਾਲਿਆਂ ਵਿਚ ਤੂੰ ਵਿਸ਼ੇਸ਼ ਰੂਪ ਵਿਚ ਮੌਜੂਦ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "बदकतुआ बिसेखं ॥",
      "sourceLineId": "80934",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭਜਸਤੁਆ ਅਭੇਖੰ ॥੧੨॥੧੨੦॥",
      "transliteration": "bhajasatuaa abhekha(n) ||12||120||",
      "translation": "O guideless Lord! Thou art worshipped by all.12.120.",
      "punjabiViakhya": "ਭਜਨ ਕਰਨ ਵਾਲਿਆਂ ਵਿਚ ਤੂੰ ਭੇਖਰਹਿਤ ਹੈਂ ॥੧੨॥੧੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "भजसतुआ अभेखं ॥१२॥१२०॥",
      "sourceLineId": "80935",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਤਸਤੁਆ ਫਲਾਨੰ ॥",
      "transliteration": "matasatuaa falaana(n) ||",
      "translation": "Thou art the sap in flowers and fruits",
      "punjabiViakhya": "ਫਲਾ ਵਿਚ ਮਸਤੀ ਭਰਨ ਵਾਲਾ ਤੂੰ ਹੀ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "मतसतुआ फलानं ॥",
      "sourceLineId": "80936",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਰਿਕਤੁਆ ਹਿਰਦਾਨੰ ॥",
      "transliteration": "harikatuaa hiradhaana(n) ||",
      "translation": "Thou art the inspirer in the hearts.",
      "punjabiViakhya": "ਹਿਰਦਿਆਂ ਵਿਚ ਤੂੰ ਉਤਸਾਹਿਤ ਕਰਨ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "हरिकतुआ हिरदानं ॥",
      "sourceLineId": "80937",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅੜਕਤੁਆ ਅੜੰਗੰ ॥",
      "transliteration": "aRakatuaa aRa(n)ga(n) ||",
      "translation": "Thou art the one to resist among the resistant",
      "punjabiViakhya": "ਅੜਿਕਿਆਂ ਵਿਚ ਤੂੰ ਅੜਨ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "अड़कतुआ अड़ंगं ॥",
      "sourceLineId": "80938",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤ੍ਰਿਕਸਤੁਆ ਤ੍ਰਿਭੰਗੰ ॥੧੩॥੧੨੧॥",
      "transliteration": "tirakasatuaa tirabha(n)ga(n) ||13||121||",
      "translation": "Thou art the destroyer of the three worlds (or modes).13.121.",
      "punjabiViakhya": "ਤਿੰਨ (ਲੋਕ) ਵੀ ਤੂੰ ਹੈ ਅਤੇ ਤਿੰਨਾ ਨੂੰ ਭੰਨਣ ਵਾਲਾ ਵੀ ਤੂੰ ਹੈਂ ॥੧੩॥੧੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "तृकसतुआ तृभंगं ॥१३॥१२१॥",
      "sourceLineId": "80939",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰੰਗਸਤੁਆ ਅਰੰਗੰ ॥",
      "transliteration": "ra(n)gasatuaa ara(n)ga(n) ||",
      "translation": "Thou art the colour as well as devoid of colour",
      "punjabiViakhya": "ਤੂੰ ਰੰਗ ਸਹਿਤ ਅਤੇ ਰੰਗ-ਰਹਿਤ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "रंगसतुआ अरंगं ॥",
      "sourceLineId": "80940",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਲਵਸਤੁਆ ਅਲੰਗੰ ॥",
      "transliteration": "lavasatuaa ala(n)ga(n) ||",
      "translation": "Thou art the beauty as well as the lover of beauty.",
      "punjabiViakhya": "ਤੂੰ ਹੀ ਲਿਪਤ ਹੋਣ ਵਾਲਾ ਅਤੇ ਨਿਰਲੇਪ ਵੀ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "लवसतुआ अलंगं ॥",
      "sourceLineId": "80941",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਯਕਸਤੁਆ ਯਕਾਪੰ ॥",
      "transliteration": "yakasatuaa yakaapa(n) ||",
      "translation": "Thou art the Only One and ONLY ONE like Thyself",
      "punjabiViakhya": "ਤੂੰ ਇਕੋ ਇਕ ਹੈਂ, ਇਕੋ ਵਰਗਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "यकसतुआ यकापं ॥",
      "sourceLineId": "80942",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਇਕਸਤੁਆ ਇਕਾਪੰ ॥੧੪॥੧੨੨॥",
      "transliteration": "eikasatuaa ikaapa(n) ||14||122||",
      "translation": "Thou art the Only One now and shall be the Only One in future.14.122.",
      "punjabiViakhya": "ਤੂੰ ਆਪ ਹੀ ਹੈਂ ਅਤੇ ਕੇਵਲ ਇਕ ਹੈਂ ॥੧੪॥੧੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "इकसतुआ इकापं ॥१४॥१२२॥",
      "sourceLineId": "80943",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਵਦਿਸਤੁਆ ਵਰਦਾਨੰ ॥",
      "transliteration": "vadhisatuaa varadhaana(n) ||",
      "translation": "Thou art described as the Donor of boons",
      "punjabiViakhya": "ਤੂੰ ਕਥਨ ਕੀਤਾ ਜਾਦਾ ਹੈ ਅਤੇ ਵਰ ਦੇਣ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "वदिसतुआ वरदानं ॥",
      "sourceLineId": "80944",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਯਕਸਤੁਆ ਇਕਾਨੰ ॥",
      "transliteration": "yakasatuaa ikaana(n) ||",
      "translation": "Thou art the Only One, the Only One.",
      "punjabiViakhya": "ਤੂੰ ਕੇਵਲ ਇਕੋ ਇਕ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "यकसतुआ इकानं ॥",
      "sourceLineId": "80945",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਲਵਸਤੁਆ ਅਲੇਖੰ ॥",
      "transliteration": "lavasatuaa alekha(n) ||",
      "translation": "Thou art affectionate and accountless",
      "punjabiViakhya": "ਤੂੰ ਲਿਪਤ ਹੋਣ ਵਾਲਾ ਅਤੇ ਲੇਖੇ ਤੋਂ ਪਰੇ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "लवसतुआ अलेखं ॥",
      "sourceLineId": "80946",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਰਰਿਸਤੁਆ ਅਰੇਖੰ ॥੧੫॥੧੨੩॥",
      "transliteration": "rarisatuaa arekha(n) ||15||123||",
      "translation": "Thou art depicted as markless.15.123.",
      "punjabiViakhya": "ਤੂੰ ਰੇਖਾ ਤੋਂ ਬਿਨਾ ਕਥਨ ਕੀਤਾ ਜਾ ਰਿਹਾ ਹੈਂ ॥੧੫॥੧੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "ररिसतुआ अरेखं ॥१५॥१२३॥",
      "sourceLineId": "80947",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤ੍ਰਿਅਸਤੁਆ ਤ੍ਰਿਭੰਗੇ ॥",
      "transliteration": "triasatuaa tirabha(n)ge ||",
      "translation": "Thou art in the three worlds and also the destroyer of three modes",
      "punjabiViakhya": "ਤਿੰਨਾ ਲੋਕਾ ਵਿਚ ਤੂੰ ਹੈ ਅਤੇ (ਉਨ੍ਹਾ ਨੂੰ) ਭੰਨਣ ਵਾਲਾ ਵੀ ਤੂੰ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "तृअसतुआ तृभंगे ॥",
      "sourceLineId": "80948",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਰਿਸਤੁਆ ਹਰੰਗੇ ॥",
      "transliteration": "harisatuaa hara(n)ge ||",
      "translation": "O Lord! Thou art in every colour.",
      "punjabiViakhya": "ਹਰ ਇਕ ਵਿਚ ਤੂੰ ਹਰ ਰੰਗ ਵਿਚ ਵਿਆਪਤ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "हरिसतुआ हरंगे ॥",
      "sourceLineId": "80949",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮਹਿਸਤੁਆ ਮਹੇਸੰ ॥",
      "transliteration": "mahisatuaa mahesa(n) ||",
      "translation": "Thou art the earth and also the Lord of the earth.",
      "punjabiViakhya": "ਤੂੰ ਮਹੇਸ਼ਾ ਵਿਚ ਮਹੇਸ਼ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "महिसतुआ महेसं ॥",
      "sourceLineId": "80950",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭਜਸਤੁਆ ਅਭੇਸੰ ॥੧੬॥੧੨੪॥",
      "transliteration": "bhajasatuaa abhesa(n) ||16||124||",
      "translation": "O Guiseless Lord! All adore Thee.16.124.",
      "punjabiViakhya": "ਅਤੇ ਭਜਣ ਯੋਗ (ਕੇਵਲ) ਤੂੰ ਅਭੇਸ ਹੀ ਹੈਂ ॥੧੬॥੧੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "भजसतुआ अभेसं ॥१६॥१२४॥",
      "sourceLineId": "80951",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਰਸਤੁਆ ਬਰਾਨੰ ॥",
      "transliteration": "barasatuaa baraana(n) ||",
      "translation": "Thou art the Suprb of the eminent ones.",
      "punjabiViakhya": "ਤੂੰ ਸਭ ਤੋਂ ਸ੍ਰੇਸ਼ਠ ਦਸਿਆ ਗਿਆ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "बरसतुआ बरानं ॥",
      "sourceLineId": "80952",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪਲਸਤੁਆ ਫਲਾਨੰ ॥",
      "transliteration": "palasatuaa falaana(n) ||",
      "translation": "Thou art the Giver of reward in an instant.",
      "punjabiViakhya": "ਤੂੰ ਪਲ ਭਰ ਵਿਚ ਫਲ ਦੇਣ ਵਾਲਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "पलसतुआ फलानं ॥",
      "sourceLineId": "80953",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਰਸਤੁਆ ਨਰੇਸੰ ॥",
      "transliteration": "narasatuaa naresa(n) ||",
      "translation": "Thou art the Sovereign of men.",
      "punjabiViakhya": "ਨਰਾ ਵਿਚ ਤੂੰ ਸ੍ਰੇਸ਼ਠ ਨਰ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "नरसतुआ नरेसं ॥",
      "sourceLineId": "80954",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦਲਸਤੁਸਾ ਦਲੇਸੰ ॥੧੭॥੧੨੫॥",
      "transliteration": "dhalasatusaa dhalesa(n) ||17||125||",
      "translation": "Thou art the destroyer of the Masters of the armies.17.125.",
      "punjabiViakhya": "ਤੂੰ ਦਲਾ ਦੇ ਸੁਆਮੀਆਂ ਨੂੰ ਦਲਣ ਵਾਲਾ ਹੈਂ ॥੧੭॥੧੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "दलसतुसा दलेसं ॥१७॥१२५॥",
      "sourceLineId": "80955",
      "sourceShabadId": "7760",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪਾਧੜੀ ਛੰਦ ॥ ਤ੍ਵਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "paadhaRee chha(n)dh || tavaiprasaadh ||",
      "translation": "PAADHRAI STANZA BY THY GRACE",
      "punjabiViakhya": "ਪਾਧੜੀ ਛੰਦ: ਤੇਰੀ ਕ੍ਰਿਪਾ ਨਾਲ:",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "पाधड़ी छंद ॥ त्वप्रसादि ॥",
      "sourceLineId": "80956",
      "sourceShabadId": "7761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦਿਨ ਅਜਬ ਏਕ ਆਤਮਾ ਰਾਮ ॥",
      "transliteration": "dhin ajab ek aatamaa raam ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਜੀਵਾਤਮਾ ਨੇ ਪਰਮਾਤਮਾ ਤੋਂ ਅਣੋਖਾ ਜਿਹਾ (ਪ੍ਰਸ਼ਨ) ਪੁਛਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "दिन अजब एक आतमा राम ॥",
      "sourceLineId": "80957",
      "sourceShabadId": "7761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਨਭਉ ਸਰੂਪ ਅਨਹਦ ਅਕਾਮ ॥",
      "transliteration": "anabhau saroop anahadh akaam ||",
      "translation": "On a day the curious soul (asked): The infinite and Desire less Lord, the Intuitive Entity.",
      "punjabiViakhya": "ਕਿ ਹੇ ਅਨੁਭਵ ਦੁਆਰਾ ਜਾਣੇ ਜਾਣ ਵਾਲੇ, ਅਨਹਦ ਸਰੂਪ, ਕਾਮਨਾ-ਰਹਿਤ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "अनभउ सरूप अनहद अकाम ॥",
      "sourceLineId": "80958",
      "sourceShabadId": "7761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਨਛਿਜ ਤੇਜ ਆਜਾਨ ਬਾਹੁ ॥",
      "transliteration": "anachhij tej aajaan baahu ||",
      "translation": "Of everlasting Glory and long-armed",
      "punjabiViakhya": "ਅਣਛਿਜ ਤੇਜ ਵਾਲੇ, ਲੰਬੀਆਂ ਭੁਜਾਵਾ ਵਾਲੇ,",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "अनछिज तेज आजान बाहु ॥",
      "sourceLineId": "80959",
      "sourceShabadId": "7761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਰਾਜਾਨ ਰਾਜ ਸਾਹਾਨ ਸਾਹੁ ॥੧॥੧੨੬॥",
      "transliteration": "raajaan raaj saahaan saahu ||1||126||",
      "translation": "The King of kings and Emperor of emperors.1.126.",
      "punjabiViakhya": "ਰਾਜਿਆਂ ਦੇ ਰਾਜੇ ਅਤੇ ਸ਼ਾਹਾ ਦੇ ਸ਼ਾਹ! ॥੧॥੧੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "राजान राज साहान साहु ॥१॥१२६॥",
      "sourceLineId": "80960",
      "sourceShabadId": "7761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਉਚਰਿਓ ਆਤਮਾ ਪਰਮਾਤਮਾ ਸੰਗ ॥",
      "transliteration": "auchario aatamaa paramaatamaa sa(n)g ||",
      "translation": "The soul said to the Higher Soul",
      "punjabiViakhya": "ਆਤਮਾ ਨੇ ਪਰਮਾਤਮਾ ਤੋਂ ਪੁਛਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "उचरिओ आतमा परमातमा संग ॥",
      "sourceLineId": "80961",
      "sourceShabadId": "7761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0138_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਉਤਭੁਜ ਸਰੂਪ ਅਬਿਗਤ ਅਭੰਗ ॥",
      "transliteration": "autabhuj saroop abigat abha(n)g ||",
      "translation": "The Germinating Entity, Unmanifested and Invincible",
      "punjabiViakhya": "ਨਾਸ਼ ਤੋਂ ਬਿਨਾ ਹੈ ਗਤਿ ਤੋਂ ਰਹਿਤ",
      "source": "DASAM_GRANTH",
      "ang": 138,
      "hindi": "",
      "hindiTransliteration": "उतभुज सरूप अबिगत अभंग ॥",
      "sourceLineId": "80962",
      "sourceShabadId": "7761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
