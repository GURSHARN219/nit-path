{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 148,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0148_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "81419",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਸੁਮੇਧ ਅਰੁ ਅਸਮੇਦਹਾਰਾ ॥",
      "transliteration": "asumedh ar asamedhahaaraa ||",
      "translation": "Asumedh and Asumedhan (the sons of Janmeja),",
      "punjabiViakhya": "(ਜਨਮੇਜਾ ਰਾਜੇ ਦੇ ਦੋ ਪੁੱਤਰ ਸਨ-) ਅਸੁਮੇਧ ਅਤੇ ਅਸਮੇਦਹਾਰ।",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "असुमेध अरु असमेदहारा ॥",
      "sourceLineId": "81420",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਹਾ ਸੂਰ ਸਤਵਾਨ ਅਪਾਰਾ ॥",
      "transliteration": "mahaa soor satavaan apaaraa ||",
      "translation": "Were great heroes and truthful (princes).",
      "punjabiViakhya": "(ਦੋਵੇਾਂ) ਬਹੁਤ ਵੱਡੇ ਸੂਰਵੀਰ ਅਤੇ ਅਪਾਰ ਸੱਤਾ ਵਾਲੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "महा सूर सतवान अपारा ॥",
      "sourceLineId": "81421",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਹਾ ਬੀਰ ਬਰਿਆਰ ਧਨੁਖ ਧਰ ॥",
      "transliteration": "mahaa beer bariaar dhanukh dhar ||",
      "translation": "They were very brave, mighty and archers.",
      "punjabiViakhya": "ਮਹਾਨਬਹਾਦਰ, ਬਲਵਾਨ ਅਤੇ ਧਨੁਸ਼ਧਾਰੀ ਸਨ)",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "महा बीर बरिआर धनुख धर ॥",
      "sourceLineId": "81422",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗਾਵਤ ਕੀਰਤ ਦੇਸ ਸਭ ਘਰ ਘਰ ॥੧॥੨੩੮॥",
      "transliteration": "gaavat keerat dhes sabh ghar ghar ||1||238||",
      "translation": "Their praises were sung in every home in the country.1.238.",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਦੀ) ਕੀਰਤੀ ਸਾਰੇ ਦੇਸ਼ ਦੇ ਘਰ ਘਰ ਗਾਈ ਜਾਦੀ ਸੀ ॥੧॥੨੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "गावत कीरत देस सभ घर घर ॥१॥२३८॥",
      "sourceLineId": "81423",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਹਾ ਬੀਰ ਅਰੁ ਮਹਾ ਧਨੁਖ ਧਰ ॥",
      "transliteration": "mahaa beer ar mahaa dhanukh dhar ||",
      "translation": "They were supreme warriors and supreme archers.",
      "punjabiViakhya": "(ਦੋਵੇਾਂ) ਬਹੁਤ ਸੂਰਵੀਰ ਅਤੇ ਵੱਡੇ ਧਨੁਸ਼ਧਾਰੀ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "महा बीर अरु महा धनुख धर ॥",
      "sourceLineId": "81424",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਾਪਤ ਤੀਨ ਲੋਕ ਜਾ ਕੇ ਡਰ ॥",
      "transliteration": "kaapat teen lok jaa ke ddar ||",
      "translation": "Because of their fear, the three worlds trembled.",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦੇ ਡਰ ਨਾਲ ਤਿੰਨੋ ਲੋਕ ਕੰਬਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "कापत तीन लोक जा के डर ॥",
      "sourceLineId": "81425",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਡ ਮਹੀਪ ਅਰੁ ਅਖੰਡ ਪ੍ਰਤਾਪਾ ॥",
      "transliteration": "badd maheep ar akha(n)dd prataapaa ||",
      "translation": "They were kings of indivisible glory.",
      "punjabiViakhya": "(ਉਹ) ਮਹਾਨ ਰਾਜੇ ਅਤੇ ਅਖੰਡ ਪ੍ਰਤਾਪ ਵਾਲੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "बड महीप अरु अखंड प्रतापा ॥",
      "sourceLineId": "81426",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਮਿਤ ਤੇਜ ਜਾਪਤ ਜਗ ਜਾਪਾ ॥੨॥੨੩੯॥",
      "transliteration": "amit tej jaapat jag jaapaa ||2||239||",
      "translation": "They were persons of unlimited splendour and the whole world remembered them.2.239.",
      "punjabiViakhya": "(ਉਹ) ਅਮਿਤ ਤੇਜ ਵਾਲੇ ਸਨ, ਸਾਰਾ ਜਗਤ (ਉਨ੍ਰਹਾ ਦਾ) ਜਾਪ ਜਪਦਾ ਸੀ ॥੨॥੨੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "अमित तेज जापत जग जापा ॥२॥२३९॥",
      "sourceLineId": "81427",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਜੈ ਸਿੰਘ ਉਤ ਸੂਰ ਮਹਾਨਾ ॥",
      "transliteration": "ajai si(n)gh ut soor mahaanaa ||",
      "translation": "On the other hand, Ajai Singh was a superb hero,",
      "punjabiViakhya": "ਦੂਜੇ ਪਾਸੇ ਅਜੈ ਸਿੰਘ ਮਹਾਨ ਸੂਰਵੀਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "अजै सिंघ उत सूर महाना ॥",
      "sourceLineId": "81428",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਡ ਮਹੀਪ ਦਸ ਚਾਰ ਨਿਧਾਨਾ ॥",
      "transliteration": "badd maheep dhas chaar nidhaanaa ||",
      "translation": "Who was a great monarch and adept in fourteen learnings.",
      "punjabiViakhya": "(ਉਹ) ਵੱਡਾ ਮਹੀਪ ਅਤੇ ਚੌਦਾ ਵਿਦਿਆਵਾ ਦਾ ਖ਼ਜ਼ਾਨਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "बड महीप दस चार निधाना ॥",
      "sourceLineId": "81429",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਨਬਿਕਾਰ ਅਨਤੋਲ ਅਤੁਲ ਬਲ ॥",
      "transliteration": "anabikaar anatol atul bal ||",
      "translation": "He was without any vices, he was incomparable and of unweighable minght,",
      "punjabiViakhya": "(ਉਹ) ਵਿਕਾਰਾ ਤੋਂ ਰਹਿਤ, ਤੁਲਨਾ ਤੋਂ ਬਿਨਾ ਅਤੇ ਅਤੁਲ ਬਲ ਵਾਲਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "अनबिकार अनतोल अतुल बल ॥",
      "sourceLineId": "81430",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਰ ਅਨੇਕ ਜੀਤੇ ਜਿਨ ਦਲਮਲ ॥੩॥੨੪੦॥",
      "transliteration": "ar anek jeete jin dhalamal ||3||240||",
      "translation": "Who conqured many enemies and mashed them.3.240.",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਅਨੇਕ ਵੈਰੀ ਜਿਤ ਕੇ ਕੁਚਲ ਦਿੱਤੇ ਸਨ ॥੩॥੨੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "अर अनेक जीते जिन दलमल ॥३॥२४०॥",
      "sourceLineId": "81431",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਿਨ ਜੀਤੇ ਸੰਗ੍ਰਾਮ ਅਨੇਕਾ ॥",
      "transliteration": "jin jeete sa(n)graam anekaa ||",
      "translation": "He was the conqueror of many wars.",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਅਨੇਕਾ ਜੰਗਾ ਜਿਤੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "जिन जीते संग्राम अनेका ॥",
      "sourceLineId": "81432",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਧਰਿ ਛਾਡਨ ਏਕਾ ॥",
      "transliteration": "sasatr asatr dhar chhaaddan ekaa ||",
      "translation": "None of the weapon-wielders could escape him.",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰ-ਅਸਤ੍ਰ ਧਾਰਨ ਕਰਨ ਵਾਲਿਆਂ ਵਿਚੋਂ ਇਕ ਵੀ (ਜੀਉਾਂਦਾ) ਰਹਿਣ ਨਹੀਂ ਦਿੱਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "ससत्र असत्र धरि छाडन एका ॥",
      "sourceLineId": "81433",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਹਾ ਸੂਰ ਗੁਨਵਾਨ ਮਹਾਨਾ ॥",
      "transliteration": "mahaa soor gunavaan mahaanaa ||",
      "translation": "He was a great hero, possessing great qualities",
      "punjabiViakhya": "(ਉਹ) ਮਹਾਨ ਸ਼ੂਰਵੀਰ ਅਤੇ ਉਤੱਮ ਗੁਣਾ ਵਾਲਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "महा सूर गुनवान महाना ॥",
      "sourceLineId": "81434",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਾਨਤ ਲੋਕ ਸਗਲ ਜਿਹ ਆਨਾ ॥੪॥੨੪੧॥",
      "transliteration": "maanat lok sagal jeh aanaa ||4||241||",
      "translation": "And all the world venerated him.4.241.",
      "punjabiViakhya": "ਸਾਰਾ ਜਗਤ ਉਸ ਦੀ ਈਨ ਮੰਨਦਾ ਸੀ ॥੪॥੨੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "मानत लोक सगल जिह आना ॥४॥२४१॥",
      "sourceLineId": "81435",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਰਨ ਕਾਲ ਜਨਮੇਜੇ ਰਾਜਾ ॥",
      "transliteration": "maran kaal janameje raajaa ||",
      "translation": "At the time of death, the king janmeja,",
      "punjabiViakhya": "ਮਰਨ ਵੇਲੇ ਰਾਜਾ ਜਨਮੇਜਾ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "मरन काल जनमेजे राजा ॥",
      "sourceLineId": "81436",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮੰਤ੍ਰ ਕੀਓ ਮੰਤ੍ਰੀਨ ਸਮਾਜਾ ॥",
      "transliteration": "ma(n)tr keeo ma(n)treen samaajaa ||",
      "translation": "Consulted his council of ministers,",
      "punjabiViakhya": "ਮੰਤਰੀ ਮੰਡਲ ਨਾਲ ਸਲਾਹ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "मंत्र कीओ मंत्रीन समाजा ॥",
      "sourceLineId": "81437",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਾਜ ਤਿਲਕ ਭੂਪਤ ਅਭਖੇਖਾ ॥",
      "transliteration": "raaj tilak bhoopat abhakhekhaa ||",
      "translation": "As to whom should the kingship be awarded?",
      "punjabiViakhya": "ਕਿ ਰਾਜ ਸਿੰਘਾਸਨ ਦਾ ਤਿਲਕ ਕਿਸ ਨੂੰ ਦਿੱਤਾ ਜਾਏ,",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "राज तिलक भूपत अभखेखा ॥",
      "sourceLineId": "81438",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਿਰਖਤ ਭਏ ਨ੍ਰਿਪਤ ਕੀ ਰੇਖਾ ॥੫॥੨੪੨॥",
      "transliteration": "nirakhat bhe nirapat kee rekhaa ||5||242||",
      "translation": "They looked for the mark of kingship.5.242.",
      "punjabiViakhya": "(ਇਸ ਉਦੇਸ਼ ਤੋਂ 'ਰਾਜਕੁਮਾਰ' ਦੀਆਂ) ਰਾਜਾ ਬਣਨ ਦੀਆਂ ਭਾਗ-ਰੇਖਾਵਾ ਨੂੰ ਵਿਚਾਰਨ ਲਗੇ ॥੫॥੨੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "निरखत भए नृपत की रेखा ॥५॥२४२॥",
      "sourceLineId": "81439",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਇਨ ਮਹਿ ਰਾਜ ਕਵਨ ਕਉ ਦੀਜੈ ॥",
      "transliteration": "ein meh raaj kavan kau dheejai ||",
      "translation": "Out of these three who should be given the kingship?",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ (ਤਿੰਨਾ) ਵਿਚੋਂ ਰਾਜ ਕਿਸ ਨੂੰ ਦੇਈਏ,",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "इन महि राज कवन कउ दीजै ॥",
      "sourceLineId": "81440",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਉਨ ਨ੍ਰਿਪਤ ਸੁਤ ਕਉ ਨ੍ਰਿਪੁ ਕੀਜੈ ॥",
      "transliteration": "kaun nirapat sut kau nirap keejai ||",
      "translation": "Which son of the king should be made the king?",
      "punjabiViakhya": "ਰਾਜੇ ਦੇ ਕਿਸ ਪੁੱਤਰ ਨੂੰ ਰਾਜਾ ਬਣਾਈਏ।",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "कउन नृपत सुत कउ नृपु कीजै ॥",
      "sourceLineId": "81441",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਜੀਆ ਪੂਤ ਨ ਰਾਜ ਕੀ ਜੋਗਾ ॥",
      "transliteration": "rajeeaa poot na raaj kee jogaa ||",
      "translation": "The son of the maid-servant is not entitled to be the king",
      "punjabiViakhya": "(ਇਕ ਵਿਚਾਰ ਸਾਹਮਣੇ ਆਇਆ ਕਿ) ਰਜੀਆ (ਦਾਸੀ) ਦਾ ਪੁੱਤਰ ਰਾਜ ਦੇ ਲਾਇਕ ਨਹੀਂ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "रजीआ पूत न राज की जोगा ॥",
      "sourceLineId": "81442",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਯਾਹਿ ਕੇ ਜੋਗ ਨ ਰਾਜ ਕੇ ਭੋਗਾ ॥੬॥੨੪੩॥",
      "transliteration": "yaeh ke jog na raaj ke bhogaa ||6||243||",
      "translation": "The enjoyments of kingship are not meant for him.6.243.",
      "punjabiViakhya": "ਨਾ ਹੀ ਉਹ ਰਾਜ ਦੇ ਭੋਗਾ ਲਈ ਯੋਗ ਹੈ ॥੬॥੨੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "याहि के जोग न राज के भोगा ॥६॥२४३॥",
      "sourceLineId": "81443",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਸ੍ਵਮੇਦ ਕਹੁ ਦੀਨੋ ਰਾਜਾ ॥",
      "transliteration": "asavaimedh kahu dheeno raajaa ||",
      "translation": "(The eldest son) Asumedh was made the king,",
      "punjabiViakhya": "(ਵਿਚਾਰ ਵਟਾਦਰੇ ਉਪਰੰਤ ਸਭ ਤੋਂ ਵੱਡੇ ਪੁੱਤਰ) ਅਸੁਮੇਦ ਨੂੰ ਰਾਜ ਦਿੱਤਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "अस्वमेद कहु दीनो राजा ॥",
      "sourceLineId": "81444",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੈ ਪਤਿ ਭਾਖ੍ਯੋ ਸਕਲ ਸਮਾਜਾ ॥",
      "transliteration": "jai pat bhaakhayo sakal samaajaa ||",
      "translation": "And all the people cheered him as king.",
      "punjabiViakhya": "ਸਾਰੇ ਮੰਤਰੀ ਮੰਡਲ ਨੇ ਜੈ-ਜੈ-ਕਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "जै पति भाख्यो सकल समाजा ॥",
      "sourceLineId": "81445",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਨਮੇਜਾ ਕੀ ਸੁਗਤਿ ਕਰਾਈ ॥",
      "transliteration": "janamejaa kee sugat karaiee ||",
      "translation": "The funeral rites of Janmeja were performed.",
      "punjabiViakhya": "(ਉਸ ਨੇ ਰਾਜਾ ਬਣ ਕੇ) ਜਨਮੇਜਾ ਦੀ ਸੁਗਤਿ (ਕ੍ਰਿਆ) ਕਰਵਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "जनमेजा की सुगति कराई ॥",
      "sourceLineId": "81446",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਸ੍ਵਮੇਦ ਕੈ ਵਜੀ ਵਧਾਈ ॥੭॥੨੪੪॥",
      "transliteration": "asavaimedh kai vajee vadhaiee ||7||244||",
      "translation": "There were great rejoicings in the house of Asumedh.7.244.",
      "punjabiViakhya": "ਅਤੇ ਅਸੁਮੇਦ ਦੇ ਘਰ ਖੁਸ਼ੀਆਂ ਦੇ ਵਾਜੇ ਵਜੇ ॥੭॥੨੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "अस्वमेद कै वजी वधाई ॥७॥२४४॥",
      "sourceLineId": "81447",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦੂਸਰ ਭਾਇ ਹੁਤੋ ਜੋ ਏਕਾ ॥",
      "transliteration": "dhoosar bhai huto jo ekaa ||",
      "translation": "Another one brother that the king had,",
      "punjabiViakhya": "(ਅਸੁਮੇਦ ਦਾ) ਜੋ ਇਕ ਹੋਰ ਭਰਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "दूसर भाइ हुतो जो एका ॥",
      "sourceLineId": "81448",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਤਨ ਦੀਏ ਤਿਹ ਦਰਬ ਅਨੇਕਾ ॥",
      "transliteration": "ratan dhe'ee teh dharab anekaa ||",
      "translation": "Was given enormous wealth and precious articles.",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਅਨੇਕਾ ਰਤਨ ਅਤੇ ਧੰਨ-ਦੌਲਤ ਦਿੱਤੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "रतन दीए तिह दरब अनेका ॥",
      "sourceLineId": "81449",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮੰਤ੍ਰੀ ਕੈ ਅਪਨਾ ਠਹਰਾਇਓ ॥",
      "transliteration": "ma(n)tree kai apanaa Thaharaio ||",
      "translation": "He was also made one of the ministers,",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਆਪਣਾ ਮੰਤਰੀ ਬਣਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "मंत्री कै अपना ठहराइओ ॥",
      "sourceLineId": "81450",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦੂਸਰ ਠਉਰ ਤਿਸਹਿ ਬੈਠਾਇਓ ॥੮॥੨੪੫॥",
      "transliteration": "dhoosar Thaur tiseh baiThaio ||8||245||",
      "translation": "And placed him at another position.8.245.",
      "punjabiViakhya": "ਦੂਜਾ ਸਥਾਨ ਦੇ ਦਿੱਤਾ ॥੮॥੨੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "दूसर ठउर तिसहि बैठाइओ ॥८॥२४५॥",
      "sourceLineId": "81451",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤੀਸਰ ਜੋ ਰਜੀਆ ਸੁਤ ਰਹਾ ॥",
      "transliteration": "teesar jo rajeeaa sut rahaa ||",
      "translation": "The third one, who was the son of maid-servant.",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਤੀਜਾ (ਭਰਾ) ਜੋ ਰਜੀਆ (ਦਾਸੀ) ਦਾ ਪੁੱਤਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "तीसर जो रजीआ सुत रहा ॥",
      "sourceLineId": "81452",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੈਨਪਾਲ ਤਾ ਕੋ ਪੁਨ ਕਹਾ ॥",
      "transliteration": "sainapaal taa ko pun kahaa ||",
      "translation": "He was given the position of army-general",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸੈਨਾਪਤੀ ਨਿਯੁਕਤ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "सैनपाल ता को पुन कहा ॥",
      "sourceLineId": "81453",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਖਸੀ ਕਰਿ ਤਾਕੌ ਠਹਰਾਇਓ ॥",
      "transliteration": "bakhasee kar taakau Thaharaio ||",
      "translation": "He was made the Bakhshi",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਕਰ ਵਸੂਲਣ ਲਈ 'ਬਖ਼ਸ਼ੀ' ਪਦ ਪ੍ਰਦਾਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "बखसी करि ताकौ ठहराइओ ॥",
      "sourceLineId": "81454",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਬ ਦਲ ਕੋ ਤਿਹ ਕਾਮੁ ਚਲਾਇਓ ॥੯॥੨੪੬॥",
      "transliteration": "sab dhal ko teh kaam chalaio ||9||246||",
      "translation": "And he administered all the work of the forces.9.246.",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੇ ਸਾਰੀ ਸੈਨਾ ਦੀ ਵਿਵਸਥਾ ਚਲਾਈ ॥੯॥੨੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "सब दल को तिह कामु चलाइओ ॥९॥२४६॥",
      "sourceLineId": "81455",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਾਜੁ ਪਾਇ ਸਭਹੂ ਸੁਖ ਪਾਇਓ ॥",
      "transliteration": "raaj pai sabhahoo sukh paio ||",
      "translation": "(All the brothers) were happy on getting their positions in kingdom.",
      "punjabiViakhya": "ਰਾਜ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰ ਕੇ ਸਭ ਸੁਖੀ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "राजु पाइ सभहू सुख पाइओ ॥",
      "sourceLineId": "81456",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਭੂਪਤ ਕਉ ਨਾਚਬ ਸੁਖ ਆਇਓ ॥",
      "transliteration": "bhoopat kau naachab sukh aaio ||",
      "translation": "The king felt great pleasure in seeing dances.",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਨਾਚ (ਮਹਿਫ਼ਲ ਦੇਖਣ ਨਾਲ) ਹੀ ਸੁਖ ਪ੍ਰਾਪਤ ਹੋਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "भूपत कउ नाचब सुख आइओ ॥",
      "sourceLineId": "81457",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤੇਰਹ ਸੈ ਚੌਸਠ ਮਰਦੰਗਾ ॥",
      "transliteration": "tereh sai chauasaTh maradha(n)gaa ||",
      "translation": "There were thirteen hundred and sixty-four Mridangs,",
      "punjabiViakhya": "(ਉਸ ਦੇ ਦਰਬਾਰ ਵਿਚ) ੧੩੬੪ ਮ੍ਰਿਦੰਗ",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "तेरह सै चौसठ मरदंगा ॥",
      "sourceLineId": "81458",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਾਜਤ ਹੈ ਕਈ ਕੋਟ ਉਪੰਗਾ ॥੧੦॥੨੪੭॥",
      "transliteration": "baajat hai kiee koT upa(n)gaa ||10||247||",
      "translation": "And millions of other musical instruments resounded in his presence.10.247.",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਕਰੋੜ ਵਾਜੇ ('ਉਪੰਗ') ਵਜਦੇ ਸਨ ॥੧੦॥੨੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "बाजत है कई कोट उपंगा ॥१०॥२४७॥",
      "sourceLineId": "81459",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੂਸਰ ਭਾਇ ਭਏ ਮਦ ਅੰਧਾ ॥",
      "transliteration": "dhoosar bhai bhe madh a(n)dhaa ||",
      "translation": "The second brother took to heavy drinding.",
      "punjabiViakhya": "ਦੂਜਾ ਭਰਾ ਸ਼ਰਾਬ ਵਿਚ ਧੁਤ ਰਹਿ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "दूसर भाइ भए मद अंधा ॥",
      "sourceLineId": "81460",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦੇਖਤ ਨਾਚਤ ਲਾਇ ਸੁਗੰਧਾ ॥",
      "transliteration": "dhekhat naachat lai suga(n)dhaa ||",
      "translation": "He was fond of applying perfumes and seeing dances.",
      "punjabiViakhya": "ਅਤੇ ਸੁਗੰਧੀਆਂ ਲਗਾ ਕੇ ਨਾਚ ਹੀ ਵੇਖਦਾ ਰਹਿੰਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "देखत नाचत लाइ सुगंधा ॥",
      "sourceLineId": "81461",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰਾਜ ਸਾਜ ਦੁਹਹੂੰ ਤੇ ਭੂਲਾ ॥",
      "transliteration": "raaj saaj dhuhahoo(n) te bhoolaa ||",
      "translation": "Both the brothers forgot to perform the royal responsibilities,",
      "punjabiViakhya": "ਦੋਹਾ ਨੂੰ ਰਾਜ ਦਾ ਕੰਮ-ਕਾਜ ਭੁਲ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "राज साज दुहहूँ ते भूला ॥",
      "sourceLineId": "81462",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਵਾਹੀ ਕੈ ਜਾਇ ਛਤ੍ਰ ਸਿਰ ਝੂਲਾ ॥੧੧॥੨੪੮॥",
      "transliteration": "vaahee kai jai chhatr sir jhoolaa ||11||248||",
      "translation": "And the canopy of royalty was held on the head of the third one.11.248.",
      "punjabiViakhya": "ਅਤੇ ਉਸੇ (ਅਜੈ ਸਿੰਘ) ਦੇ ਸਿਰ ਉਤੇ ਛਤਰ ਝੁਲਣ ਲਗਾ ॥੧੧॥੨੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "वाही कै जाइ छत्र सिर झूला ॥११॥२४८॥",
      "sourceLineId": "81463",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਰਤ ਕਰਤ ਬਹੁ ਦਿਨ ਅਸ ਰਾਜਾ ॥",
      "transliteration": "karat karat bahu dhin as raajaa ||",
      "translation": "After the passage of many days in the kingdom like this,",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਬਹੁਤ ਦਿਨਾ ਤਕ ਰਾਜ ਕਰਦਿਆਂ ਕਰਦਿਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "करत करत बहु दिन अस राजा ॥",
      "sourceLineId": "81464",
      "sourceShabadId": "7771",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0148_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਉਨ ਦੁਹੂੰ ਭੂਲਿਓ ਰਾਜ ਸਮਾਜਾ ॥",
      "transliteration": "aun dhuhoo(n) bhoolio raaj samaajaa ||",
      "translation": "Both the brothers forgot the royal responsibilities.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਰਾਜ ਦੇ ਫ਼ਰਜ਼ ਨਿਭਾਣੇ ਭੁਲ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 148,
      "hindi": "",
      "hindiTransliteration": "उन दुहूँ भूलिओ राज समाजा ॥",
