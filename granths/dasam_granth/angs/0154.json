{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 154,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0154_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨ੍ਰਿਪ ਕੇ ਸੰਗਿ ਜੋ ਮਿਲਿ ਜਾਤੁ ਭਏ ॥",
      "transliteration": "nirap ke sa(n)g jo mil jaat bhe ||",
      "translation": "Those Brahmins who ate together with the king.",
      "punjabiViakhya": "ਜੋ (ਬ੍ਰਾਹਮਣ) ਰਾਜੇ ਦੇ ਨਾਲ ਮਿਲ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "नृप के संगि जो मिलि जातु भए ॥",
      "sourceLineId": "81707",
      "sourceShabadId": "7780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਰ ਸੋ ਰਜਪੂਤ ਕਹਾਤ ਭਏ ॥੧੮॥੩੦੮॥",
      "transliteration": "nar so rajapoot kahaat bhe ||18||308||",
      "translation": "They were called Rajputs.18.308.",
      "punjabiViakhya": "ਉਹ ਪੁਰਸ਼ ਰਾਜਪੂਤ ਅਖਵਾਉਣ ਲਗੇ ॥੧੮॥੩੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "नर सो रजपूत कहात भए ॥१८॥३०८॥",
      "sourceLineId": "81708",
      "sourceShabadId": "7780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਿਨ ਜੀਤ ਬਿਜੈ ਕਹੁ ਰਾਉ ਚੜ੍ਯੋ ॥",
      "transliteration": "tin jeet bijai kahu raau chaRayo ||",
      "translation": "After conquering them, the king (Ajai Singh) moved to gain further conquests.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਜਿਤ ਕੇ ਦਿਗਵਿਜੈ ਲਈ ਰਾਜਾ (ਅਜੈ ਸਿੰਘ) ਨੇ ਚੜ੍ਰਹਾਈ ਕਰ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "तिन जीत बिजै कहु राउ चड़्यो ॥",
      "sourceLineId": "81709",
      "sourceShabadId": "7780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਤਿ ਤੇਜੁ ਪ੍ਰਚੰਡ ਪ੍ਰਤਾਪੁ ਬਢ੍ਯੋ ॥",
      "transliteration": "at tej pracha(n)dd prataap baddayo ||",
      "translation": "His glory and magnificence increased enormously.",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਤੇਜ ਪ੍ਰਚੰਡ ਹੋ ਗਿਆ ਅਤੇ ਪ੍ਰਤਾਪ ਬਹੁਤ ਵੱਧ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "अति तेजु प्रचंड प्रतापु बढ्यो ॥",
      "sourceLineId": "81710",
      "sourceShabadId": "7780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜੋਊ ਆਨਿ ਮਿਲੇ ਅਰੁ ਸਾਕ ਦਏ ॥",
      "transliteration": "jouoo aan mile ar saak dhe ||",
      "translation": "Those who surrendered before him and married their daughters to him,",
      "punjabiViakhya": "ਜਿਹੜੇ (ਉਸ ਨੂੰ) ਆ ਕੇ ਮਿਲ ਪਏ ਅਤੇ (ਬੇਟੀਆਂ ਦੇ) ਸਾਕ ਦਿੱਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "जोऊ आनि मिले अरु साक दए ॥",
      "sourceLineId": "81711",
      "sourceShabadId": "7780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਰ ਤੇ ਰਜਪੂਤ ਕਹਾਤ ਭਏ ॥੧੯॥੩੦੯॥",
      "transliteration": "nar te rajapoot kahaat bhe ||19||309||",
      "translation": "They were also called Rajputs.19.309.",
      "punjabiViakhya": "ਉਹ ਪੁਰਸ਼ ਵੀ ਰਾਜਪੂਤ ਅਖਵਾਉਣ ਲਗੇ ॥੧੯॥੩੦੯॥",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "नर ते रजपूत कहात भए ॥१९॥३०९॥",
      "sourceLineId": "81712",
      "sourceShabadId": "7780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਿਨ ਸਾਕ ਦਏ ਨਹਿ ਰਾਰਿ ਬਢੀ ॥",
      "transliteration": "jin saak dhe neh raar baddee ||",
      "translation": "Those who did not marry their daughters, the wrangle increased with them.",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੇ ਸਾਕ ਨਾ ਦਿੱਤੇ (ਉਨ੍ਰਹਾ ਨਾਲ) ਲੜਾਈ ਵੱਧ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "जिन साक दए नहि रारि बढी ॥",
      "sourceLineId": "81713",
      "sourceShabadId": "7780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਿਨ ਕੀ ਇਨ ਲੈ ਜੜ ਮੂਲ ਕਢੀ ॥",
      "transliteration": "tin kee in lai jaR mool kaddee ||",
      "translation": "He (the king) completely uprooted them.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੀ ਜੜ੍ਰਹ ਇਸ ਨੇ ਮੂਲੋਂ ਕਢ ਸੁਟੀ।",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "तिन की इन लै जड़ मूल कढी ॥",
      "sourceLineId": "81714",
      "sourceShabadId": "7780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦਲ ਤੇ ਬਲ ਤੇ ਧਨ ਟੂਟਿ ਗਏ ॥",
      "transliteration": "dhal te bal te dhan TooT ge ||",
      "translation": "The armies, might and wealth were finished.",
      "punjabiViakhya": "(ਜੋ) ਸੈਨਾ ਵਜੋਂ, ਸ਼ਕਤੀ ਵਜੋਂ ਜਾ ਧਨ ਵਜੋਂ ਟੁਟ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "दल ते बल ते धन टूटि गए ॥",
      "sourceLineId": "81715",
      "sourceShabadId": "7780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਵਹਿ ਲਾਗਤ ਬਾਨਜ ਕਰਮ ਭਏ ॥੨੦॥੩੧੦॥",
      "transliteration": "veh laagat baanaj karam bhe ||20||310||",
      "translation": "And they adopted the occupation of traders.20.310.",
      "punjabiViakhya": "ਉਹ ਵਣਜ ਕਰਨ ਲਗ ਗਏ ॥੨੦॥੩੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "वहि लागत बानज करम भए ॥२०॥३१०॥",
      "sourceLineId": "81716",
      "sourceShabadId": "7780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੋਊ ਆਨਿ ਮਿਲੇ ਨਹਿ ਜੋਰਿ ਲਰੇ ॥",
      "transliteration": "jouoo aan mile neh jor lare ||",
      "translation": "Those who did not surrender and fought violently,",
      "punjabiViakhya": "ਜਿਹੜੇ ਆਣ ਕੇ ਮਿਲੇ ਨਹੀਂ, ਸਗੋਂ ਜ਼ੋਰ ਨਾਲ ਲੜੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "जोऊ आनि मिले नहि जोरि लरे ॥",
      "sourceLineId": "81717",
      "sourceShabadId": "7780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਵਹਿ ਬਾਧ ਮਹਾਗਨਿ ਹੋਮ ਕਰੇ ॥",
      "transliteration": "veh baadh mahaagan hom kare ||",
      "translation": "Their bodies were bound and reduced to ashes in big fires.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਬੰਨ੍ਰਹ ਕੇ ਮਹਾਨ ਅਗਨੀ ਵਿਚ ਸਾੜ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "वहि बाध महागनि होम करे ॥",
      "sourceLineId": "81718",
      "sourceShabadId": "7780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਨਗੰਧ ਜਰੇ ਮਹਾ ਕੁੰਡ ਅਨਲੰ ॥",
      "transliteration": "anaga(n)dh jare mahaa ku(n)dd anala(n) ||",
      "translation": "They were burnt in the fire-altar-pit uninformed.",
      "punjabiViakhya": "ਉਹ ਵੱਡੇ ਅਗਨਕੁੰਡ ਵਿਚ ਬਿਨਾ ਪਤਾ ਚਲੇ (ਅਨਗੰਧ) ਸੜ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "अनगंध जरे महा कुँड अनलं ॥",
      "sourceLineId": "81719",
      "sourceShabadId": "7780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਭਇਓ ਛਤ੍ਰੀਅ ਮੇਧੁ ਮਹਾ ਪ੍ਰਬਲੰ ॥੨੧॥੩੧੧॥",
      "transliteration": "bhio chhatreea medh mahaa prabala(n) ||21||311||",
      "translation": "Thus there was a very great sacrifice of Kshatriyas.21.311.",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਛਤਰੀਆਂ ਦੀ ਕੁਰਬਾਨੀ ਦਾ ਬਹੁਤ ਵੱਡਾ ਯੱਗ ਹੋਇਆ ॥੨੧॥੩੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "भइओ छत्रीअ मेधु महा प्रबलं ॥२१॥३११॥",
      "sourceLineId": "81720",
      "sourceShabadId": "7780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਇਤਿ ਅਜੈ ਸਿੰਘ ਕਾ ਰਾਜ ਸੰਪੂਰਨ ਭਇਆ ॥",
      "transliteration": "eit ajai si(n)gh kaa raaj sa(n)pooran bhiaa ||",
      "translation": "Here ends the complete Description of the Rule of Ajai Singh.",
      "punjabiViakhya": "ਇਥੇ ਅਜੈ ਸਿੰਘ ਦਾ ਰਾਜ ਸੰਪੂਰਨ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "इति अजै सिंघ का राज संपूरन भइआ ॥",
      "sourceLineId": "81721",
      "sourceShabadId": "7780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਗਰਾਜ ॥ ਤੋਮਰ ਛੰਦ ॥ ਤ੍ਵਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "jagaraaj || tomar chha(n)dh || tavaiprasaadh ||",
      "translation": "The King Jag: TOMAR STANZA BY THY GRACE",
      "punjabiViakhya": "ਜਗਰਾਜ ਤੋਮਰ ਛੰਦ: ਤੇਰੀ ਕ੍ਰਿਪਾ ਨਾਲ:",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "जगराज ॥ तोमर छंद ॥ त्वप्रसादि ॥",
      "sourceLineId": "81722",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਿਆਸੀ ਬਰਖ ਪਰਮਾਨ ॥",
      "transliteration": "biaasee barakh paramaan ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਆਸੀ ਸਾਲ,",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "बिआसी बरख परमान ॥",
      "sourceLineId": "81723",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦਿਨ ਦੋਇ ਮਾਸ ਅਸਟਾਨ ॥",
      "transliteration": "dhin dhoi maas asaTaan ||",
      "translation": "For eighty-two years, eight months and two days,",
      "punjabiViakhya": "ਅੱਠ ਮਹੀਨੇ ਅਤੇ ਦੋ ਦਿਨ ਤਕ",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "दिन दोइ मास असटान ॥",
      "sourceLineId": "81724",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਹੁ ਰਾਜੁ ਭਾਗ ਕਮਾਇ ॥",
      "transliteration": "bahu raaj bhaag kamai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ-ਭਾਗ ਚੰਗੀ ਤਰ੍ਰਹਾ ਕਮਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "बहु राजु भाग कमाइ ॥",
      "sourceLineId": "81725",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪੁਨਿ ਨ੍ਰਿਪ ਕੋ ਨ੍ਰਿਪਰਾਇ ॥੧॥੩੧੨॥",
      "transliteration": "pun nirap ko niraparai ||1||312||",
      "translation": "Ruled very prosperously the king of kings (Ajai Singh).1.312.",
      "punjabiViakhya": "ਰਾਜਿਆਂ ਦੇ ਰਾਜੇ (ਅਜੈ ਸਿੰਘ) ਦਾ ਫਿਰ (ਦੇਹਾਤ ਹੋ ਗਿਆ) ॥੧॥੩੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "पुनि नृप को नृपराइ ॥१॥३१२॥",
      "sourceLineId": "81726",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੁਨ ਰਾਜ ਰਾਜ ਮਹਾਨ ॥",
      "transliteration": "sun raaj raaj mahaan ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਣੋ, ਰਾਜਿਆਂ ਦੇ ਵੱਡੇ ਰਾਜੇ",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "सुन राज राज महान ॥",
      "sourceLineId": "81727",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦਸ ਚਾਰਿ ਚਾਰਿ ਨਿਧਾਨ ॥",
      "transliteration": "dhas chaar chaar nidhaan ||",
      "translation": "Listen, the king of great kingdom, who was treasure of fourteen learnings",
      "punjabiViakhya": "ਅਤੇ ਦਸ ਅਤੇ ਚਾਰ ਵਿਦਿਆਵਾ ਦੇ ਸੁੰਦਰ ਖ਼ਜ਼ਾਨੇ!",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "दस चारि चारि निधान ॥",
      "sourceLineId": "81728",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦਸ ਦੋਇ ਦੁਆਦਸ ਮੰਤ ॥",
      "transliteration": "dhas dhoi dhuaadhas ma(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਦਸ ਅਤੇ ਦੋ ਬਾਰ੍ਰਹਾ (ਅੱਖਰਾ ਦੇ) ਮੰਤਰ",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "दस दोइ दुआदस मंत ॥",
      "sourceLineId": "81729",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਧਰਨੀ ਧਰਾਨ ਮਹੰਤਿ ॥੨॥੩੧੩॥",
      "transliteration": "dharanee dharaan maha(n)t ||2||313||",
      "translation": "Who recited the mantra of twelve letters and was the Supreme Sovereign on the earth.2.313.",
      "punjabiViakhya": "(ਓਨਮ ਭਗਵਤੇ ਵਾਸਦੇਵਯ) ਨੂੰ ਪੜ੍ਰਹਨ ਵਾਲੇ ਅਤੇ ਧਰਤੀ ਉਤੇ ਪੂਜਣ-ਯੋਗ! ॥੨॥੩੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "धरनी धरान महंति ॥२॥३१३॥",
      "sourceLineId": "81730",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪੁਨਿ ਭਯੋ ਉਦੋਤ ਨ੍ਰਿਪਾਲ ॥",
      "transliteration": "pun bhayo udhot nirapaal ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਮਹਾਰਾਜਾ (ਜਗ) ਪ੍ਰਗਟ (ਉਦੋਤ) ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "पुनि भयो उदोत नृपाल ॥",
      "sourceLineId": "81731",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਸ ਰਤਿ ਰੂਪ ਰਸਾਲ ॥",
      "transliteration": "ras rat roop rasaal ||",
      "translation": "Then the great king Jag took birth, who was very beautiful and affectionate",
      "punjabiViakhya": "ਜੋ ਪ੍ਰੇਮ ਦੀ ਰੀਤ ਵਾਲਾ ਅਤੇ ਸੁੰਦਰ ਸਰੂਪ ਵਾਲਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "रस रति रूप रसाल ॥",
      "sourceLineId": "81732",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਤਿ ਭਾਨ ਤੇਜ ਪ੍ਰਚੰਡ ॥",
      "transliteration": "at bhaan tej pracha(n)dd ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਤੇਜ ਸੂਰਜ ਨਾਲੋਂ ਵੀ ਪ੍ਰਚੰਡ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "अति भान तेज प्रचंड ॥",
      "sourceLineId": "81733",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਨਖੰਡ ਤੇਜ ਪ੍ਰਚੰਡ ॥੩॥੩੧੪॥",
      "transliteration": "anakha(n)dd tej pracha(n)dd ||3||314||",
      "translation": "Who was highly lustrous than the sun, His great effulgence was indestructible.3.314.",
      "punjabiViakhya": "ਅਤੇ (ਉਹ) ਪ੍ਰਚੰਡ ਤੇਜ ਨਾਸ਼ ਤੋਂ ਰਹਿਤ ਸੀ ॥੩॥੩੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "अनखंड तेज प्रचंड ॥३॥३१४॥",
      "sourceLineId": "81734",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਿਨਿ ਬੋਲਿ ਬਿਪ੍ਰ ਮਹਾਨ ॥",
      "transliteration": "tin bol bipr mahaan ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ (ਬਹੁਤ ਸਾਰੇ) ਮਹਾਨ ਬ੍ਰਾਹਮਣ ਬੁਲਾ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "तिनि बोलि बिप्र महान ॥",
      "sourceLineId": "81735",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪਸੁ ਮੇਧ ਜਗ ਰਚਾਨ ॥",
      "transliteration": "pas medh jag rachaan ||",
      "translation": "He called all the great Brahmins. In order to perform the animal sacrifice,",
      "punjabiViakhya": "ਅਤੇ ਪਸ਼ੂ-ਮੇਧ ਯੱਗ ਚਾਇ।",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "पसु मेध जग रचान ॥",
      "sourceLineId": "81736",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦਿਜ ਪ੍ਰਾਗ ਜੋਤ ਬੁਲਾਇ ॥",
      "transliteration": "dhij praag jot bulai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋਤਿਸ਼ ਵਿਦਿਆ ਦੇ ਗਿਆਤਾ ਅਤੇ ਆਪਣੇ ਆਪ ਨੂੰ (ਅਸਾਮ ਦੇ)",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "दिज प्राग जोत बुलाइ ॥",
      "sourceLineId": "81737",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਪਿ ਕਾਮਰੂਪ ਕਹਾਇ ॥੪॥੩੧੫॥",
      "transliteration": "ap kaamaroop kahai ||4||315||",
      "translation": "He called very leaned Brahmins, who called themselves very beautiful like Cupid.4.315.",
      "punjabiViakhya": "ਕਾਮ-ਰੂਪ (ਤੀਰਥ ਦੇ ਨਿਵਾਸੀ) ਅਖਵਾਉਣ ਵਾਲੇ ਬ੍ਰਾਹਮਣਾ ਨੂੰ (ਬੁਲਾ ਲਿਆ) ॥੪॥੩੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "अपि कामरूप कहाइ ॥४॥३१५॥",
      "sourceLineId": "81738",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦਿਜ ਕਾਮਰੂਪ ਅਨੇਕ ॥",
      "transliteration": "dhij kaamaroop anek ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮ-ਰੂਪ (ਤੀਰਥ) ਤੋਂ ਅਨੇਕ ਬ੍ਰਾਹਮਣ",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "दिज कामरूप अनेक ॥",
      "sourceLineId": "81739",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨ੍ਰਿਪ ਬੋਲਿ ਲੀਨ ਬਿਸੇਖ ॥",
      "transliteration": "nirap bol leen bisekh ||",
      "translation": "Many Brahmin beautiful like Cuaid were especially invited by the king.",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਖ਼ਾਸ ਤੌਰ ਤੇ ਬੁਲਾ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "नृप बोलि लीन बिसेख ॥",
      "sourceLineId": "81740",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਭ ਜੀਅ ਜਗ ਅਪਾਰ ॥",
      "transliteration": "sabh jeea jag apaar ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਜਗਤ ਵਿਚੋਂ ਅਪਾਰ ਜੀਵ (ਇਕੱਠੇ ਕਰ ਲਏ)",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "सभ जीअ जग अपार ॥",
      "sourceLineId": "81741",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮਖ ਹੋਮ ਕੀਨ ਅਬਿਚਾਰ ॥੫॥੩੧੬॥",
      "transliteration": "makh hom keen abichaar ||5||316||",
      "translation": "Innumerable animals of the world, were caught and burnt in altar-pit thoughtlessly.5.316.",
      "punjabiViakhya": "ਅਤੇ ਬਲਿਦਾਨ ਦੀ ਰੀਤ ਅਨੁਸਾਰ ('ਅਬਿਚਾਰ') ਸਭ ਨੂੰ ਯੱਗ ਵਿਚ ਹੋਮ ਕਰ ਦਿੱਤਾ ॥੫॥੩੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "मख होम कीन अबिचार ॥५॥३१६॥",
      "sourceLineId": "81742",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪਸੁ ਏਕ ਪੈ ਦਸ ਬਾਰ ॥",
      "transliteration": "pas ek pai dhas baar ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਇਕ ਪਸ਼ੂ ਉਤੇ (ਬ੍ਰਾਹਮਣਾ ਨੇ) ਦਸ ਦਸ ਵਾਰ",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "पसु एक पै दस बार ॥",
      "sourceLineId": "81743",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪੜਿ ਬੇਦ ਮੰਤ੍ਰ ਅਬਿਚਾਰ ॥",
      "transliteration": "paR bedh ma(n)tr abichaar ||",
      "translation": "Ten times on one animal, the Vedic mantra was recited thoughtlessly.",
      "punjabiViakhya": "ਬਲਿਦਾਨ ਦੀ ਰੀਤ ਅਨੁਸਾਰ ਵੇਦ ਮੰਤਰ ਪੜ੍ਰਹ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "पड़ि बेद मंत्र अबिचार ॥",
      "sourceLineId": "81744",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਬਿ ਮਧਿ ਹੋਮ ਕਰਾਇ ॥",
      "transliteration": "ab madh hom karai ||",
      "translation": "",
      "punjabiViakhya": "ਬਕਰਿਆਂ ('ਅਬਿ') ਨੂੰ (ਹਵਨ ਕੁੰਡ) ਵਿਚ ਹੋਮ ਕਰਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "अबि मधि होम कराइ ॥",
      "sourceLineId": "81745",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਧਨੁ ਭੂਪ ਤੇ ਬਹੁ ਪਾਇ ॥੬॥੩੧੭॥",
      "transliteration": "dhan bhoop te bahu pai ||6||317||",
      "translation": "The animal was burnt in the altar-pit, for which much wealth was received from the king.6.317.",
      "punjabiViakhya": "(ਬ੍ਰਾਹਮਣਾ ਨੇ) ਰਾਜ ਤੋਂ ਬਹੁਤ ਧਨ ਪ੍ਰਾਪਤ ਕੀਤਾ ॥੬॥੩੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "धनु भूप ते बहु पाइ ॥६॥३१७॥",
      "sourceLineId": "81746",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪਸੁ ਮੇਘ ਜਗ ਕਰਾਇ ॥",
      "transliteration": "pas megh jag karai ||",
      "translation": "",
      "punjabiViakhya": "ਪਸ਼ੂ-ਮੇਧ ਯੱਗ ਕਰਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "पसु मेघ जग कराइ ॥",
      "sourceLineId": "81747",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਹੁ ਭਾਤ ਰਾਜੁ ਸੁਹਾਇ ॥",
      "transliteration": "bahu bhaat raaj suhai ||",
      "translation": "By performing animal-sacrifice, the kingdom prospered in many ways.",
      "punjabiViakhya": "ਅਤੇ ਅਨੇਕ ਤਰ੍ਰਹਾ ਨਾਲ ਰਾਜਾ ਨੂੰ ਸੁਸ਼ੋਭਿਤ ਕਰਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "बहु भात राजु सुहाइ ॥",
      "sourceLineId": "81748",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਰਖ ਅਸੀਹ ਅਸਟ ਪ੍ਰਮਾਨ ॥",
      "transliteration": "barakh aseeh asaT pramaan ||",
      "translation": "",
      "punjabiViakhya": "ਅਠਾਸੀ ਵਰ੍ਰਹੇ",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "बरख असीह असट प्रमान ॥",
      "sourceLineId": "81749",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦੁਇ ਮਾਸ ਰਾਜੁ ਕਮਾਨ ॥੭॥੩੧੮॥",
      "transliteration": "dhui maas raaj kamaan ||7||318||",
      "translation": "For eighty-eight years and two months, the monarch ruled the kingdom.7.318.",
      "punjabiViakhya": "ਅਤੇ ਦੋ ਮਹੀਨੇ ਤਕ ਰਾਜ ਕੀਤਾ ॥੭॥੩੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "दुइ मास राजु कमान ॥७॥३१८॥",
      "sourceLineId": "81750",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪੁਨ ਕਠਨ ਕਾਲ ਕਰਵਾਲ ॥",
      "transliteration": "pun kaThan kaal karavaal ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਕਠੋਰ ਕਾਲ ਦੀ ਤਲਵਾਰ,",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "पुन कठन काल करवाल ॥",
      "sourceLineId": "81751",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਗ ਜਾਰੀਆ ਜਿਹ ਜੁਵਾਲ ॥",
      "transliteration": "jag jaareeaa jeh juvaal ||",
      "translation": "Then the terrible sword of death, whose flame hath burnt the world",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਆਪਣੀ ਜੁਆਲਾ ਨਾਲ ਸਾਰਾ ਜਗਤ ਸਾੜ ਦਿੱਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "जग जारीआ जिह जुवाल ॥",
      "sourceLineId": "81752",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਵਹਿ ਖੰਡੀਆ ਅਨਖੰਡ ॥",
      "transliteration": "veh kha(n)ddeeaa anakha(n)dd ||",
      "translation": "",
      "punjabiViakhya": "ਨੇ ਨਾ ਖੰਡੇ ਜਾ ਸਕਣ ਵਾਲੇ (ਜਗ ਰਾਜੇ) ਨੂੰ ਖੰਡਿਤ ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "वहि खंडीआ अनखंड ॥",
      "sourceLineId": "81753",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0154_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਨਖੰਡ ਰਾਜ ਪ੍ਰਚੰਡ ॥੮॥੩੧੯॥",
      "transliteration": "anakha(n)dd raaj pracha(n)dd ||8||319||",
      "translation": "Broke the unbreakable king, whose rule was entirely glorious.8.319.",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਰਾਜ ਪ੍ਰਚੰਡ ਅਤੇ ਅਖੰਡ ਸੀ ॥੮॥੩੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": "अनखंड राज प्रचंड ॥८॥३१९॥",
      "sourceLineId": "81754",
      "sourceShabadId": "7781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
