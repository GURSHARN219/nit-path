{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 156,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0156_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਪਨ ਰਹਤ ਨਿਰਾਲਮ ਜਗ ਤੇ ॥",
      "transliteration": "aapan rahat niraalam jag te ||",
      "translation": "He Himself remains detached from the world,",
      "punjabiViakhya": "ਆਪ ਜਗਤ ਤੋਂ ਨਿਰਲਿਪਤ ਰਹਿੰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "आपन रहत निरालम जग ते ॥",
      "sourceLineId": "81851",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਾਨ ਲਏ ਜਾ ਨਾਮੈ ਤਬ ਤੇ ॥੫॥",
      "transliteration": "jaan le jaa naamai tab te ||5||",
      "translation": "I know this fact from the very beginning (ancient times).5.",
      "punjabiViakhya": "(ਮੈਂ) ਉਦੋਂ ਤੋਂ ਹੀ (ਇਹ ਸਭ ਕੁਝ) ਜਾਣ ਲਿਆ, ਜਦੋਂ ਤੋਂ (ਇਨ੍ਰਹਾ ਦਾ) ਨਾਮ ਧਰਿਆ ਗਿਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "जान लए जा नामै तब ते ॥५॥",
      "sourceLineId": "81852",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਆਪ ਰਚੇ ਆਪੇ ਕਲ ਘਾਏ ॥",
      "transliteration": "aap rache aape kal ghaae ||",
      "translation": "He creates Himself and destroys Himself",
      "punjabiViakhya": "ਕਾਲ ਆਪ ਹੀ ਰਚਦਾ ਹੈ ਅਤੇ ਆਪ ਹੀ ਮਾਰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "आप रचे आपे कल घाए ॥",
      "sourceLineId": "81853",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਵਰਨ ਕੇ ਦੇ ਮੂੰਡਿ ਹਤਾਏ ॥",
      "transliteration": "avaran ke dhe moo(n)dd hataae ||",
      "translation": "But He imposes the responsibility on the head of others",
      "punjabiViakhya": "(ਪਰ) ਦੂਜਿਆਂ ਦੇ ਸਿਰ ਮੜ੍ਰਹ ਕੇ (ਉਨ੍ਰਹਾ ਨੂੰ) ਮਰਵਾਉਾਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "अवरन के दे मूँडि हताए ॥",
      "sourceLineId": "81854",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਆਪ ਨਿਰਾਲਮ ਰਹਾ ਨ ਪਾਯਾ ॥",
      "transliteration": "aap niraalam rahaa na paayaa ||",
      "translation": "He Himself remains detached and Beyond Everything",
      "punjabiViakhya": "(ਉਹ) ਆਪ (ਹਰ ਗੱਲ ਤੋਂ) ਨਿਰਲੇਪ ਰਹਿੰਦਾ ਹੈ (ਪਰ ਇਸ ਭੇਦ ਨੂੰ ਕੋਈ) ਨਹੀਂ ਪਾ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "आप निरालम रहा न पाया ॥",
      "sourceLineId": "81855",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਾ ਤੇ ਨਾਮ ਬਿਅੰਤ ਕਹਾਯਾ ॥੬॥",
      "transliteration": "taa te naam bia(n)t kahaayaa ||6||",
      "translation": "Therefore, He is called ‘Infinite’.6.",
      "punjabiViakhya": "ਇਸੇ ਕਰਕੇ (ਉਸ ਨੂੰ) 'ਬੇਅੰਤ' ਕਿਹਾ ਜਾਦਾ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "ता ते नाम बिअंत कहाया ॥६॥",
      "sourceLineId": "81856",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜੋ ਚਉਬੀਸ ਅਵਤਾਰ ਕਹਾਏ ॥",
      "transliteration": "jo chaubees avataar kahaae ||",
      "translation": "Those who are called twenty-four incarnations",
      "punjabiViakhya": "(ਜਗਤ ਵਿਚ) ਜੋ ਚੌਵੀ ਅਵਤਾਰ ਅਖਵਾਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "जो चउबीस अवतार कहाए ॥",
      "sourceLineId": "81857",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਿਨ ਭੀ ਤੁਮ ਪ੍ਰਭ ਤਨਿਕ ਨ ਪਾਏ ॥",
      "transliteration": "tin bhee tum prabh tanik na paae ||",
      "translation": "O Lord! they even could not realise thee in a small measure",
      "punjabiViakhya": "ਹੇ ਪ੍ਰਭੂ! ਉਨ੍ਰਹਾ ਨੇ ਵੀ ਤੈਨੂੰ ਜ਼ਰਾ ਜਿੰਨਾ ਨਹੀਂ ਪਾਇਆ (ਸਮਝਿਆ)।",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "तिन भी तुम प्रभ तनिक न पाए ॥",
      "sourceLineId": "81858",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਭ ਹੀ ਜਗ ਭਰਮੇ ਭਵਰਾਯੰ ॥",
      "transliteration": "sabh hee jag bharame bhavaraaya(n) ||",
      "translation": "They became kings of the world and got deluded",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਸਾਰਾ ਜਗਤ ਭਰਮਾ ਵਿਚ ਭੁਲਾਇਆ ਹੋਇਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "सभ ही जग भरमे भवरायं ॥",
      "sourceLineId": "81859",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਾ ਤੇ ਨਾਮ ਬਿਅੰਤ ਕਹਾਯੰ ॥੭॥",
      "transliteration": "taa te naam bia(n)t kahaaya(n) ||7||",
      "translation": "Therefore they were called by innumerable names.7.",
      "punjabiViakhya": "ਇਸੇ ਲਈ ਤੁਹਾਡਾ ਨਾ 'ਬੇਅੰਤ' ਕਿਹਾ ਜਾਦਾ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "ता ते नाम बिअंत कहायं ॥७॥",
      "sourceLineId": "81860",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਭ ਹੀ ਛਲਤ ਨ ਆਪ ਛਲਾਯਾ ॥",
      "transliteration": "sabh hee chhalat na aap chhalaayaa ||",
      "translation": "O Lord! Thou hast been deluding others, but could not be deluded by others",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਛਲਦਾ ਹੈ, ਪਰ ਆਪ (ਕਿਸੇ ਤੋਂ) ਛਲਿਆ ਨਹੀਂ ਜਾਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "सभ ही छलत न आप छलाया ॥",
      "sourceLineId": "81861",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਾ ਤੇ ਛਲੀਆ ਆਪ ਕਹਾਯਾ ॥",
      "transliteration": "taa te chhaleeaa aap kahaayaa ||",
      "translation": "Therefore Thou art called ‘Crafty’",
      "punjabiViakhya": "ਇਸੇ ਲਈ ਆਪਣੇ ਆਪ ਨੂੰ 'ਛਲੀਆ' ਅਖਵਾਉਾਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "ता ते छलीआ आप कहाया ॥",
      "sourceLineId": "81862",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੰਤਨ ਦੁਖੀ ਨਿਰਖਿ ਅਕੁਲਾਵੈ ॥",
      "transliteration": "sa(n)tan dhukhee nirakh akulaavai ||",
      "translation": "Thou becomest agitated on seeing the saints in agony,",
      "punjabiViakhya": "ਸੰਤਾ ਨੂੰ ਦੁਖੀ ਵੇਖ ਕੇ ਘਬਰਾ ਜਾਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "संतन दुखी निरखि अकुलावै ॥",
      "sourceLineId": "81863",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੀਨ ਬੰਧੁ ਤਾ ਤੇ ਕਹਲਾਵੈ ॥੮॥",
      "transliteration": "dheen ba(n)dh taa te kahalaavai ||8||",
      "translation": "Therefore Thou art also called ‘the fiend of the humble’.8.",
      "punjabiViakhya": "ਇਸੇ ਲਈ 'ਦੀਨ ਬੰਧੁ' ਅਖਵਾਉਾਂਦਾ ਹੈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "दीन बंधु ता ते कहलावै ॥८॥",
      "sourceLineId": "81864",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅੰਤਿ ਕਰਤ ਸਭ ਜਗ ਕੋ ਕਾਲਾ ॥",
      "transliteration": "a(n)t karat sabh jag ko kaalaa ||",
      "translation": "At time Thou destroyest the universe",
      "punjabiViakhya": "(ਤੂੰ ਹੀ) ਅੰਤ ਵਿਚ ਸਾਰੇ ਜਗਤ ਦਾ ਨਾਸ਼ ਕਰਦਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "अंति करत सभ जग को काला ॥",
      "sourceLineId": "81865",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਮੁ ਕਾਲ ਤਾ ਤੇ ਜਗ ਡਾਲਾ ॥",
      "transliteration": "naam kaal taa te jag ddaalaa ||",
      "translation": "Therefore the world hath named you KAL (the Destroyer Lord)",
      "punjabiViakhya": "ਇਸੇ ਕਰਕੇ ਜਗਤ ਨੇ (ਤੇਰਾ) ਨਾਮ 'ਕਾਲ' ਰਖ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "नामु काल ता ते जग डाला ॥",
      "sourceLineId": "81866",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਮੈ ਸੰਤ ਪਰ ਹੋਤ ਸਹਾਈ ॥",
      "transliteration": "samai sa(n)t par hot sahaiee ||",
      "translation": "Thou hast been helping all the saints",
      "punjabiViakhya": "(ਸੰਕਟ ਦੇ) ਸਮੇਾਂ (ਤੂੰ) ਸੰਤਾ ਦਾ ਸਹਾਈ ਹੁੰਦਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "समै संत पर होत सहाई ॥",
      "sourceLineId": "81867",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾ ਤੇ ਸੰਖ੍ਯਾ ਸੰਤ ਸੁਨਾਈ ॥੯॥",
      "transliteration": "taa te sa(n)khayaa sa(n)t sunaiee ||9||",
      "translation": "Therefore the saints have reckoned Thy incarnations.9.",
      "punjabiViakhya": "ਇਸ ਕਰ ਕੇ (ਤੇਰੀ) ਸੰਗਿਆ 'ਸੰਤ' ਸੁਣੀ ਜਾਦੀ ਹੈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "ता ते संख्या संत सुनाई ॥९॥",
      "sourceLineId": "81868",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਿਰਖਿ ਦੀਨ ਪਰ ਹੋਤ ਦਿਆਰਾ ॥",
      "transliteration": "nirakh dheen par hot dhiaaraa ||",
      "translation": "Seeing Thy mercifulness towards the lowly",
      "punjabiViakhya": "(ਤੈਨੂੰ) ਦੀਨਾ ਉਤੇ ਦਿਆਲ ਹੁੰਦਾ ਵੇਖਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "निरखि दीन पर होत दिआरा ॥",
      "sourceLineId": "81869",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦੀਨ ਬੰਧੁ ਹਮ ਤਬੈ ਬਿਚਾਰਾ ॥",
      "transliteration": "dheen ba(n)dh ham tabai bichaaraa ||",
      "translation": "Thy name ‘Deen Bandhu’ (the helper of the lowly) hath been thought out",
      "punjabiViakhya": "ਤਦੇ ਤੇਰਾ ਨਾ ਅਸੀਂ 'ਦੀਨਬੰਧੁ' ਵਿਚਾਰਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "दीन बंधु हम तबै बिचारा ॥",
      "sourceLineId": "81870",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੰਤਨ ਪਰ ਕਰੁਣਾ ਰਸੁ ਢਰਈ ॥",
      "transliteration": "sa(n)tan par karunaa ras ddariee ||",
      "translation": "Thou art Compassionate towards the saints",
      "punjabiViakhya": "ਸੰਤਾ ਉਤੇ (ਤੂੰ) ਕਰੁਣਾ ਦੀ ਭਾਵਨਾ ਨਾਲ ਦ੍ਰਵਿਤ ਹੁੰਦਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "संतन पर करुणा रसु ढरई ॥",
      "sourceLineId": "81871",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਰੁਣਾਨਿਧਿ ਜਗ ਤਬੈ ਉਚਰਈ ॥੧੦॥",
      "transliteration": "karunaanidh jag tabai uchariee ||10||",
      "translation": "Therefore the world calls Thee ‘Karuna-nidhi’ (the Tresure of mercy).10.",
      "punjabiViakhya": "ਇਸੇ ਲਈ ਜਗਤ ਤੈਨੂੰ 'ਕਰੁਣਾਨਿਧੀ' ਉਚਾਰਦਾ ਹੈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "करुणानिधि जग तबै उचरई ॥१०॥",
      "sourceLineId": "81872",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੰਕਟ ਹਰਤ ਸਾਧਵਨ ਸਦਾ ॥",
      "transliteration": "sa(n)kaT harat saadhavan sadhaa ||",
      "translation": "Thou ever removest the distress of the saints",
      "punjabiViakhya": "(ਤੂੰ) ਸਦਾ ਸਾਧਾ ਦੇ ਸੰਕਟ ਹਰਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 156,
      "hindi": "",
      "hindiTransliteration": "संकट हरत साधवन सदा ॥",
      "sourceLineId": "81873",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0156_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੰਕਟ ਹਰਨ ਨਾਮੁ ਭਯੋ ਤਦਾ ॥",
      "transliteration": "sa(n)kaT haran naam bhayo tadhaa ||",
      "translation": "Therefore Thou art named ‘Sankat-haran’, the remover of the distresses",
