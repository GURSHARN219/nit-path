{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 159,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0159_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਏਕਹਿ ਆਪ ਸਭਨ ਮੋ ਬਿਆਪਾ ॥",
      "transliteration": "ekeh aap sabhan mo biaapaa ||",
      "translation": "Only one lord pervades all",
      "punjabiViakhya": "ਇਕੋ ਆਪ ਹੀ ਸਾਰਿਆਂ ਵਿਚ ਵਿਆਪਤ ਹੋ ਰਿਹਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "एकहि आप सभन मो बिआपा ॥",
      "sourceLineId": "81971",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਭ ਕੋਈ ਭਿੰਨ ਭਿੰਨ ਕਰ ਥਾਪਾ ॥੩੫॥",
      "transliteration": "sabh koiee bhi(n)n bhi(n)n kar thaapaa ||35||",
      "translation": "But appears to everyone as distinctly separate accofding to his discernment.35.",
      "punjabiViakhya": "(ਪਰ ਉਸੇ ਨੂੰ) ਸਭ ਲੋਕ ਭਿੰਨ ਭਿੰਨ ਰੂਪ ਵਿਚ ਸਥਾਪਿਤ ਕਰਦੇ ਹਨ ॥੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "सभ कोई भिंन भिंन कर थापा ॥३५॥",
      "sourceLineId": "81972",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਭ ਹੀ ਮਹਿ ਰਮ ਰਹਿਯੋ ਅਲੇਖਾ ॥",
      "transliteration": "sabh hee meh ram rahiyo alekhaa ||",
      "translation": "That inconceivable Lord pervades all",
      "punjabiViakhya": "ਸਭ ਵਿਚ ਅਲੇਖ (ਜੋ ਲੇਖ ਵਿਚ ਨਾ ਆ ਸਕੇ) ਹੀ ਰਮਣ ਕਰ ਰਿਹਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "सभ ही महि रम रहियो अलेखा ॥",
      "sourceLineId": "81973",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਾਗਤ ਭਿੰਨ ਭਿੰਨ ਤੇ ਲੇਖਾ ॥",
      "transliteration": "maagat bhi(n)n bhi(n)n te lekhaa ||",
      "translation": "And all the beings beg from him according to their writ",
      "punjabiViakhya": "(ਪਰ ਉਹ ਸਭ ਤੋਂ) ਵਖਰਾ ਵਖਰਾ ਲੇਖਾ ਮੰਗਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "मागत भिंन भिंन ते लेखा ॥",
      "sourceLineId": "81974",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਿਨ ਨਰ ਏਕ ਵਹੈ ਠਹਰਾਯੋ ॥",
      "transliteration": "jin nar ek vahai Thaharaayo ||",
      "translation": "He, who hath comprehended the Lord as One,",
      "punjabiViakhya": "ਜਿੰਨ੍ਰਹਾ ਪੁਰਸ਼ਾ ਨੇ ਉਸ ਇਕ ਨੂੰ (ਸਾਰਿਆਂ ਰੂਪਾ) ਵਿਚ ਠਹਿਰਾਇਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "जिन नर एक वहै ठहरायो ॥",
      "sourceLineId": "81975",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਿਨ ਹੀ ਪਰਮ ਤਤੁ ਕਹੁ ਪਾਯੋ ॥੩੬॥",
      "transliteration": "tin hee param tat kahu paayo ||36||",
      "translation": "Only he hath realized the Supreme Essence.36.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਹੀ ਪਰਮ-ਤੱਤ੍ਵ ਨੂੰ ਪਾਇਆ ਹੈ ॥੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "तिन ही परम ततु कहु पायो ॥३६॥",
      "sourceLineId": "81976",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਏਕਹ ਰੂਪ ਅਨੂਪ ਸਰੂਪਾ ॥",
      "transliteration": "ekeh roop anoop saroopaa ||",
      "translation": "That One Lord hath a hath a Unique Beauty and Form",
      "punjabiViakhya": "(ਉਹ) ਇਕ ਰੂਪ ਵਾਲਾ ਹੀ ਅਨੇਕ ਸਰੂਪਾ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "एकह रूप अनूप सरूपा ॥",
      "sourceLineId": "81977",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰੰਕ ਭਯੋ ਰਾਵ ਕਹੂੰ ਭੂਪਾ ॥",
      "transliteration": "ra(n)k bhayo raav kahoo(n) bhoopaa ||",
      "translation": "And he Himself is somewhere a king and somewhere a pauper",
      "punjabiViakhya": "(ਕਿਤੇ) ਉਹ ਰੰਕ ਹੈ, (ਕਿਤੇ) ਰਾਓ ਹੈ (ਅਤੇ ਕਿਤੇ) ਰਾਜਾ ਬਣਿਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "रंक भयो राव कहूँ भूपा ॥",
      "sourceLineId": "81978",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭਿੰਨ ਭਿੰਨ ਸਭਹਨ ਉਰਝਾਯੋ ॥",
      "transliteration": "bhi(n)n bhi(n)n sabhahan urajhaayo ||",
      "translation": "He hath involved all through various means",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਵਖਰੇ ਵਖਰੇ (ਕੰਮਾਧੰ ਧਿਆਂ ਵਿਚ) ਉਲਝਾਇਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "भिंन भिंन सभहन उरझायो ॥",
      "sourceLineId": "81979",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਭ ਤੇ ਜੁਦੋ ਨ ਕਿਨਹੁੰ ਪਾਯੋ ॥੩੭॥",
      "transliteration": "sabh te judho na kinahu(n) paayo ||37||",
      "translation": "But he Himself is separate from all and none could know His mystey.37.",
      "punjabiViakhya": "(ਉਹ) ਸਭ ਤੋਂ ਵਖਰਾ ਹੈ, ਉਸ (ਦੇ ਭੇਦ) ਨੂੰ ਕਿਸੇ ਨਹੀਂ ਜਾਣਿਆ ॥੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "सभ ते जुदो न किनहुँ पायो ॥३७॥",
      "sourceLineId": "81980",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭਿੰਨ ਭਿੰਨ ਸਭਹੂੰ ਉਪਜਾਯੋ ॥",
      "transliteration": "bhi(n)n bhi(n)n sabhahoo(n) upajaayo ||",
      "translation": "He hath created all in separate forms",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਭਿੰਨ ਭਿੰਨ ਰੂਪ ਵਿਚ ਸਭ ਨੂੰ ਪੈਦਾ ਕੀਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "भिंन भिंन सभहूँ उपजायो ॥",
      "sourceLineId": "81981",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਿੰਨ ਭਿੰਨ ਕਰਿ ਤਿਨੋ ਖਪਾਯੋ ॥",
      "transliteration": "bhi(n)n bhi(n)n kar tino khapaayo ||",
      "translation": "And He Himself destroys all",
      "punjabiViakhya": "ਅਤੇ ਭਿੰਨ ਭਿੰਨ ਕਰ ਕੇ ਉਨ੍ਰਹਾ ਨੂੰ ਨਸ਼ਟ ਕਰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "भिंन भिंन करि तिनो खपायो ॥",
      "sourceLineId": "81982",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਪ ਕਿਸੂ ਕੋ ਦੋਸ ਨ ਲੀਨਾ ॥",
      "transliteration": "aap kisoo ko dhos na leenaa ||",
      "translation": "He doth not take any blame on His own Head",
      "punjabiViakhya": "(ਉਹ) ਆਪ ਕਿਸੇ ਦਾ ਦੋਸ਼ ਆਪਣੇ ਸਿਰ ਉਤੇ ਨਹੀਂ ਲੈਂਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "आप किसू को दोस न लीना ॥",
      "sourceLineId": "81983",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਉਰਨ ਸਿਰ ਬੁਰਿਆਈ ਦੀਨਾ ॥੩੮॥",
      "transliteration": "aauran sir buriaaiee dheenaa ||38||",
      "translation": "And fixes the responsibility of vicious acts on others.38.",
      "punjabiViakhya": "ਅਤੇ ਹੋਰਨਾ ਦੇ ਸਿਰ ਉਤੇ ਬੁਰਿਆਈ (ਦੀ ਜ਼ਿਮੇਵਾਰੀ) ਪਾਉਾਂਦਾ ਹੈ ॥੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "अउरन सिर बुरिआई दीना ॥३८॥",
      "sourceLineId": "81984",
      "sourceShabadId": "7784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਥ ਪ੍ਰਥਮ ਮਛ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "transliteration": "ath pratham machh avataar kathana(n) ||",
      "translation": "Now begins the description of the first Machh Incarnation",
      "punjabiViakhya": "ਹੁਣ ਪ੍ਰਥਮ ਮੱਛ ਅਵਤਾਰ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "अथ प्रथम मछ अवतार कथनं ॥",
      "sourceLineId": "81985",
      "sourceShabadId": "7785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "81986",
      "sourceShabadId": "7785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੰਖਾਸੁਰ ਦਾਨਵ ਪੁਨਿ ਭਯੋ ॥",
      "transliteration": "sa(n)khaasur dhaanav pun bhayo ||",
      "translation": "Once there was born a demon named Shankhasura",
      "punjabiViakhya": "ਫਿਰ ਸੰਖਾਸੁਰ (ਨਾ ਦਾ ਇਕ) ਦੈਂਤ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "संखासुर दानव पुनि भयो ॥",
      "sourceLineId": "81987",
      "sourceShabadId": "7785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਕੈ ਜਗ ਕੋ ਦੁਖ ਦਯੋ ॥",
      "transliteration": "bahu bidh kai jag ko dhukh dhayo ||",
      "translation": "Who, in many ways, distressed the world",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਜਗਤ ਨੂੰ ਦੁਖ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि कै जग को दुख दयो ॥",
      "sourceLineId": "81988",
      "sourceShabadId": "7785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਛ ਅਵਤਾਰ ਆਪਿ ਪੁਨਿ ਧਰਾ ॥",
      "transliteration": "machh avataar aap pun dharaa ||",
      "translation": "Then the Lord manifested Himself as Machh (Fish) incarnation,",
      "punjabiViakhya": "(ਕਾਲ ਨੇ) ਤਦੋਂ ਆਪ ਮੱਛ ਅਵਤਾਰ ਧਾਰਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "मछ अवतार आपि पुनि धरा ॥",
      "sourceLineId": "81989",
      "sourceShabadId": "7785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਆਪਨ ਜਾਪੁ ਆਪ ਮੋ ਕਰਾ ॥੩੯॥",
      "transliteration": "aapan jaap aap mo karaa ||39||",
      "translation": "Who repeated His Own name Himself.39.",
      "punjabiViakhya": "ਅਤੇ ਆਪਣਾ ਜਾਪ ਆਪ ਹੀ ਜਪਿਆ (ਅਰਥਾਤ ਆਪ ਹੀ ਆਪਣੇ ਰੂਪ ਨੂੰ ਪਛਾਣਿਆ) ॥੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "आपन जापु आप मो करा ॥३९॥",
      "sourceLineId": "81990",
      "sourceShabadId": "7785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪ੍ਰਿਥਮੈ ਤੁਛ ਮੀਨ ਬਪੁ ਧਰਾ ॥",
      "transliteration": "pirathamai tuchh meen bap dharaa ||",
      "translation": "At first he Lord manifested Himself as small fish,",
      "punjabiViakhya": "ਪਹਿਲਾ (ਇਸ ਅਵਤਾਰ ਨੇ) ਛੋਟੀ ਜਿਹੀ ਮੱਛਲੀ ਦਾ ਸ਼ਰੀਰ ਧਾਰਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "पृथमै तुछ मीन बपु धरा ॥",
      "sourceLineId": "81991",
      "sourceShabadId": "7785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪੈਠਿ ਸਮੁੰਦ੍ਰ ਝਕਝੋਰਨ ਕਰਾ ॥",
      "transliteration": "paiTh samu(n)dhr jhakajhoran karaa ||",
      "translation": "And shook the ocean violenty",
      "punjabiViakhya": "ਅਤੇ ਸਮੁੰਦਰ ਵਿਚ ਵੜ ਕੇ (ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ) ਝਕਝੋਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "पैठि समुँद्र झकझोरन करा ॥",
      "sourceLineId": "81992",
      "sourceShabadId": "7785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪੁਨਿ ਪੁਨਿ ਕਰਤ ਭਯੋ ਬਿਸਥਾਰਾ ॥",
      "transliteration": "pun pun karat bhayo bisathaaraa ||",
      "translation": "Then He enlarged his body,",
      "punjabiViakhya": "ਫਿਰ ਹੌਲੀ ਹੌਲੀ (ਆਪਣਾ) ਵਿਸਤਾਰ ਕਰਦਾ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": "पुनि पुनि करत भयो बिसथारा ॥",
      "sourceLineId": "81993",
      "sourceShabadId": "7785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0159_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੰਖਾਸੁਰਿ ਤਬ ਕੋਪ ਬਿਚਾਰਾ ॥੪੦॥",
      "transliteration": "sa(n)khaasur tab kop bichaaraa ||40||",
