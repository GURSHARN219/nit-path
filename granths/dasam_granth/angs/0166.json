{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 166,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0166_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਥਟਿਯੋ ਧਰਮ ਰਾਜੰ ਜਿਤੇ ਦੇਵ ਸਰਬੰ ॥",
      "transliteration": "thaTiyo dharam raaja(n) jite dhev saraba(n) ||",
      "translation": "There was the victory of Dharma (righteousness) and the gods collectively were Victorious,",
      "punjabiViakhya": "ਧਰਮ ਦਾ ਰਾਜ ਕਾਇਮ ਕੀਤਾ ਅਤੇ ਸਾਰੇ ਦੇਵਤੇ ਜਿਤ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "थटियो धरम राजं जिते देव सरबं ॥",
      "sourceLineId": "82259",
      "sourceShabadId": "7801",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਉਤਾਰਿਯੋ ਭਲੀ ਭਾਤ ਸੋ ਤਾਹਿ ਗਰਬੰ ॥੧੪॥",
      "transliteration": "autaariyo bhalee bhaat so taeh garaba(n) ||14||",
      "translation": "And they caused to remove the pride of all in a right way.14.",
      "punjabiViakhya": "ਉਸ ਨੇ ਉਨ੍ਰਹਾ (ਦੈਂਤਾ ਦਾ) ਹੰਕਾਰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਉਤਾਰਿਆ ਸੀ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "उतारियो भली भात सो ताहि गरबं ॥१४॥",
      "sourceLineId": "82260",
      "sourceShabadId": "7801",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਬੈਰਾਹ ਖਸਟਮ ਅਵਤਾਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੬॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the bairaeh khasaTam avataar samaapatam sat subham sat ||6||",
      "translation": "End of the description of the sixth BOAR INCARNATION in BACHITTAR NATAK.6.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਦੇ ਛੇਵੇਾਂ ਬੈਰਾਹ ਅਵਤਾਰ ਪ੍ਰਸੰਗ ਦੀ ਸਮਾਪਤੀ ਸਭ ਸ਼ੁਭ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे बैराह खसटम अवतार समापतम सतु सुभम सतु ॥६॥",
      "sourceLineId": "82261",
      "sourceShabadId": "7801",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਥ ਨਰਸਿੰਘ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "transliteration": "ath narasi(n)gh avataar kathana(n) ||",
      "translation": "Now begins the description of Narsingh Incarnation:",
      "punjabiViakhya": "ਹੁਣ ਨਰਸਿੰਘ ਅਵਤਾਰ ਦਾ ਕਥਨ:",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "अथ नरसिंघ अवतार कथनं ॥",
      "sourceLineId": "82262",
      "sourceShabadId": "7802",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ ॥",
      "transliteration": "sree bhagautee jee sahai ||",
      "translation": "Let Shri Bhagauti Ji (The Primal Lord) be helpful.",
      "punjabiViakhya": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ:",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "स्री भगउती जी सहाइ ॥",
      "sourceLineId": "82263",
      "sourceShabadId": "7802",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪਾਧਰੀ ਛੰਦ ॥",
      "transliteration": "paadharee chha(n)dh ||",
      "translation": "PADHRI STANZA",
      "punjabiViakhya": "ਪਾਧਰੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "पाधरी छंद ॥",
      "sourceLineId": "82264",
      "sourceShabadId": "7802",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਕੀਯੋ ਦਿਵਰਾਜ ਰਾਜ ॥",
      "transliteration": "eeh bhaat keeyo dhivaraaj raaj ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦੇਵ ਰਾਜ ਇੰਦਰ ਨੇ ਰਾਜ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "इह भाति कीयो दिवराज राज ॥",
      "sourceLineId": "82265",
      "sourceShabadId": "7802",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭੰਡਾਰ ਭਰੇ ਸੁਭ ਸਰਬ ਸਾਜ ॥",
      "transliteration": "bha(n)ddaar bhare subh sarab saaj ||",
      "translation": "In this way, Indra, the king of gods ruled and filled the granaries of materials through all modes",
      "punjabiViakhya": "ਅਤੇ ਸਭ ਪ੍ਰਾਕਰ ਦੇ ਸਾਜ਼ੋ-ਸਾਮਾਨ ਨਾਲ ਸ਼ੁਭ ਭੰਡਾਰ ਭਰ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "भंडार भरे सुभ सरब साज ॥",
      "sourceLineId": "82266",
      "sourceShabadId": "7802",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਬ ਦੇਵਤਾਨ ਬਢਿਯੋ ਗਰੂਰ ॥",
      "transliteration": "jab dhevataan baddiyo garoor ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਦੇਵਤਿਆਂ ਦਾ ਹੰਕਾਰ ਵੱਧ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "जब देवतान बढियो गरूर ॥",
      "sourceLineId": "82267",
      "sourceShabadId": "7802",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਲਵੰਤ ਦੈਤ ਉਠੇ ਕਰੂਰ ॥੧॥",
      "transliteration": "balava(n)t dhait uThe karoor ||1||",
      "translation": "When the pride of the gods grew enormously, then in order to shelve their pride, the hard-hearted mighty demons rose again.1.",
      "punjabiViakhya": "(ਤਦੋਂ ਉਨ੍ਰਹਾ ਦਾ ਹੰਕਾਰ ਤੋੜਨ ਲਈ) ਕਠੋਰ ਅਤੇ ਬਲਸ਼ਾਲੀ ਦੈਂਤ ਉਠ ਖੜੋਤਾ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "बलवंत दैत उठे करूर ॥१॥",
      "sourceLineId": "82268",
      "sourceShabadId": "7802",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਲਿਨੋ ਛਿਨਾਇ ਦਿਵਰਾਜ ਰਾਜ ॥",
      "transliteration": "lino chhinai dhivaraaj raaj ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇੰਦਰ ਦਾ ਰਾਜ ਖੋਹ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "लिनो छिनाइ दिवराज राज ॥",
      "sourceLineId": "82269",
      "sourceShabadId": "7802",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਾਜਿਤ੍ਰ ਨੇਕ ਉਠੇ ਸੁ ਬਾਜਿ ॥",
      "transliteration": "baajitr nek uThe su baaj ||",
      "translation": "The kingdom of Indra was seized and this proclamation was made on all sides with the accompaniment of many musical instruments,",
      "punjabiViakhya": "ਅਤੇ ਅਨੇਕ ਵਾਜੇ ਵਜ ਉਠੇ।",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "बाजित्र नेक उठे सु बाजि ॥",
      "sourceLineId": "82270",
      "sourceShabadId": "7802",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਜਗਤਿ ਦੋਹੀ ਫਿਰਾਇ ॥",
      "transliteration": "eeh bhaat jagat dhohee firai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ (ਉਸ ਨੇ) ਜਗਤ ਵਿਚ ਦੁਹਾਈ ਫਿਰਾ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "इह भाति जगति दोही फिराइ ॥",
      "sourceLineId": "82271",
      "sourceShabadId": "7802",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਲੰ ਬਾ ਥਲੇਅੰ ਹਿਰਿਨਾਛ ਰਾਇ ॥੨॥",
      "transliteration": "jala(n) baa thalea(n) hirinaachh rai ||2||",
      "translation": "That Hiranayakashipu is the emperor at all the places.2.",
      "punjabiViakhya": "ਕਿ ਜਲ ਅਤੇ ਥਲ ਦਾ ਰਾਜਾ ਹਿਰਨਕਸ਼ਪ ਹੈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "जलं बा थलेअं हिरिनाछ राइ ॥२॥",
      "sourceLineId": "82272",
      "sourceShabadId": "7802",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਇਕ ਦ੍ਯੋਸ ਗਯੋ ਨਿਜ ਨਾਰਿ ਤੀਰ ॥",
      "transliteration": "eik dhayos gayo nij naar teer ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ (ਹਿਰਨਕਸ਼ਪ) ਆਪਣੀ ਇਸਤਰੀ ਦੇ ਕੋਲ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "इक द्योस गयो निज नारि तीर ॥",
      "sourceLineId": "82273",
      "sourceShabadId": "7802",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਜਿ ਸੁਧ ਸਾਜ ਨਿਜ ਅੰਗਿ ਬੀਰ ॥",
      "transliteration": "saj sudh saaj nij a(n)g beer ||",
      "translation": "One day, this mighty ruler, bedecking himself, went to his wife,",
      "punjabiViakhya": "(ਉਸ ਵੇਲੇ ਉਸ) ਸੂਰਮੇ ਨੇ ਆਪਣੇ ਅੰਗਾ ਤੇ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਸਾਜ ਸਜਾਵਟ ਕੀਤੀ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "सजि सुध साज निज अंगि बीर ॥",
      "sourceLineId": "82274",
      "sourceShabadId": "7802",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਿਹ ਭਾਤਿ ਸ੍ਵਤ੍ਰਿਯ ਮੋ ਭਯੋ ਨਿਰੁਕਤ ॥",
      "transliteration": "keh bhaat savaitiray mo bhayo nirukat ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਕਿਸੇ ਤਰ੍ਰਹਾ ਇਸਤਰੀ ਨਾਲ ਪ੍ਰੇਮ ਕ੍ਰੀੜਾ ਵਿਚ ਲਗ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "किह भाति स्वतृय मो भयो निरुकत ॥",
      "sourceLineId": "82275",
      "sourceShabadId": "7802",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਬ ਭਯੋ ਦੁਸਟ ਕੋ ਬੀਰਜ ਮੁਕਤ ॥੩॥",
      "transliteration": "tab bhayo dhusaT ko beeraj mukat ||3||",
      "translation": "And absorbed himself with her so intensely that at the time of his intercourse, his semen was discharged.3.",
      "punjabiViakhya": "ਕਿ ਤਦੋਂ ਦੁਸ਼ਟ ਦਾ ਵੀਰਜਪਾਤ ਹੋ ਗਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "तब भयो दुसट को बीरज मुकत ॥३॥",
      "sourceLineId": "82276",
      "sourceShabadId": "7802",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪ੍ਰਹਲਾਦ ਭਗਤ ਲੀਨੋ ਵਤਾਰ ॥",
      "transliteration": "prahalaadh bhagat leeno vataar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ ਇਸਤਰੀ ਨੂੰ ਹੋਏ ਗਰਭ ਤੋਂ ਸਮਾ ਆਉਣ ਤੇ)",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "प्रहलाद भगत लीनो वतार ॥",
      "sourceLineId": "82277",
      "sourceShabadId": "7802",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਬ ਕਰਨਿ ਕਾਜ ਸੰਤਨ ਉਧਾਰ ॥",
      "transliteration": "sab karan kaaj sa(n)tan udhaar ||",
      "translation": "From that semen Prahlad was born in order to help nad protect the saints.",
      "punjabiViakhya": "ਸੰਤਾ ਦੇ ਕੰਮ ਸਾਰਨ ਅਤੇ ਉੱਧਾਰ ਕਰਨ ਲਈ ਪ੍ਰਹਿਲਾਦ ਭਗਤ ਨੇ ਅਵਤਾਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "सब करनि काज संतन उधार ॥",
      "sourceLineId": "82278",
      "sourceShabadId": "7802",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚਟਸਾਰ ਪੜਨਿ ਸਉਪ੍ਯੋ ਨ੍ਰਿਪਾਲਿ ॥",
      "transliteration": "chaTasaar paRan saupayo nirapaal ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਪਾਠਸ਼ਾਲਾ ਵਿਚ ਪੜ੍ਰਹਨ ਲਈ (ਪਾਧੇ ਨੂੰ) ਸੌਂਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "चटसार पड़नि सउप्यो नृपालि ॥",
      "sourceLineId": "82279",
      "sourceShabadId": "7802",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪਟੀਯਹਿ ਕਹਿਯੋ ਲਿਖਿ ਦੈ ਗੁਪਾਲ ॥੪॥",
      "transliteration": "paTeeyeh kahiyo likh dhai gupaal ||4||",
      "translation": "When the king sent him to school for education, he asked his teacher to write the Name of Lord-God on his tablet.4.",
      "punjabiViakhya": "(ਪ੍ਰਹਿਲਾਦ ਨੇ ਪਾਧੇ ਨੂੰ) ਕਿਹਾ ਕਿ (ਮੇਰੀ) ਪੱਟੀ ਉਤੇ ਗੋਪਾਲ ਦਾ ਨਾ ਲਿਖ ਦਿਓ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "पटीयहि कहियो लिखि दै गुपाल ॥४॥",
      "sourceLineId": "82280",
      "sourceShabadId": "7802",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0166_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤੋਟਕ ਛੰਦ ॥",
      "transliteration": "toTak chha(n)dh ||",
      "translation": "TOTAK STANZA",
      "punjabiViakhya": "ਤੋਟਕ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 166,
      "hindi": "",
      "hindiTransliteration": "तोटक छंद ॥",
      "sourceLineId": "82281",
