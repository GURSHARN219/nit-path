{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 168,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0168_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਿਵ ਧਿਆਨ ਛੁਟ੍ਰਯੋ ਬ੍ਰਹਮੰਡ ਗਿਰਿਯੋ ॥",
      "transliteration": "siv dhiaan chhuTrayo brahama(n)dd giriyo ||",
      "translation": "The horses are moving in so much intoxication and creating noise that the attention of Shiva was dissolved, And it seemed that the universe had been displaced",
      "punjabiViakhya": "ਕਿ ਸ਼ਿਵ ਦਾ ਧਿਆਨ ਛੁਟ ਗਿਆ ਅਤੇ ਬ੍ਰਹਮੰਡ ਹਿਲ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "सिव धिआन छुट्रयो ब्रहमंड गिरियो ॥",
      "sourceLineId": "82331",
      "sourceShabadId": "7803",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਰ ਸੇਲ ਸਿਲਾ ਸਿਤ ਐਸ ਬਹੇ ॥",
      "transliteration": "sar sel silaa sit aais bahe ||",
      "translation": "",
      "punjabiViakhya": "ਪੱਥਰ ਉਤੇ ਘਿਸਾ ਕੇ ਚਿੱਟੇ ਕੀਤੇ ਤੀਰ ਅਤੇ ਬਰਛੇ ਇੰਜ ਚਲ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "सर सेल सिला सित ऐस बहे ॥",
      "sourceLineId": "82332",
      "sourceShabadId": "7803",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਭ ਅਉਰ ਧਰਾ ਦੋਊ ਪੂਰਿ ਰਹੇ ॥੧੭॥",
      "transliteration": "nabh aaur dharaa dhouoo poor rahe ||17||",
      "translation": "The arrows, daggers and stones were flying and filling both the earth and the sky.17.",
      "punjabiViakhya": "ਕਿ ਜਿਨ੍ਰਹਾ ਨਾਲ ਧਰਤੀ ਅਤੇ ਆਕਾਸ਼ ਦੋਵੇਾਂ ਢੱਕੇ ਗਏ ਸਨ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "नभ अउर धरा दोऊ पूरि रहे ॥१७॥",
      "sourceLineId": "82333",
      "sourceShabadId": "7803",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗਣ ਗੰਧ੍ਰਬ ਦੇਖਿ ਦੋਊ ਹਰਖੇ ॥",
      "transliteration": "gan ga(n)dhrab dhekh dhouoo harakhe ||",
      "translation": "",
      "punjabiViakhya": "ਗਣਾ ਅਤੇ ਗੰਧਰਬ ਦੋਵੇਾਂ ਵੇਖ ਕੇ ਪ੍ਰਸੰਨ ਹੋ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "गण गंध्रब देखि दोऊ हरखे ॥",
      "sourceLineId": "82334",
      "sourceShabadId": "7803",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪੁਹਪਾਵਲਿ ਦੇਵ ਸਭੈ ਬਰਖੇ ॥",
      "transliteration": "puhapaaval dhev sabhai barakhe ||",
      "translation": "The Ganas and Gandharvas, seeing both, were pleased and the gods showered flowers.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਦੇਵਤੇ ਫੁਲਾ ਦੀਆਂ ਮਾਲਾਵਾ ਬਰਸਾ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "पुहपावलि देव सभै बरखे ॥",
      "sourceLineId": "82335",
      "sourceShabadId": "7803",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਿਲ ਗੇ ਭਟ ਆਪ ਬਿਖੈ ਦੋਊ ਯੋ ॥",
      "transliteration": "mil ge bhaT aap bikhai dhouoo yo ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਯੋਧੇ ਆਪਸ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਮਿਲ ਗਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "मिल गे भट आप बिखै दोऊ यो ॥",
      "sourceLineId": "82336",
      "sourceShabadId": "7803",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਿਸ ਖੇਲਤ ਰੈਣਿ ਹੁਡੂਹੁਡ ਜਿਯੋ ॥੧੮॥",
      "transliteration": "sis khelat rain huddoohudd jiyo ||18||",
      "translation": "Two warriors were fighting with each other like the children competing with one another in their play during the night.18.",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਬਾਲਕ ਰਾਤ ਨੂੰ ਸ਼ਰਤਾ ਲਗਾ ਕੇ (ਜ਼ਿਦ-ਬਜ਼ਿਦੀ) ਖੇਡਦੇ ਹਨ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "सिस खेलत रैणि हुडूहुड जियो ॥१८॥",
      "sourceLineId": "82337",
      "sourceShabadId": "7803",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬੇਲੀ ਬ੍ਰਿੰਦਮ ਛੰਦ ॥",
      "transliteration": "belee bira(n)dham chha(n)dh ||",
      "translation": "BELI BINDRAM STANZA",
      "punjabiViakhya": "ਬੇਲੀ ਬਿੰਦ੍ਰਮ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "बेली बृंदम छंद ॥",
      "sourceLineId": "82338",
      "sourceShabadId": "7804",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰਣਧੀਰ ਬੀਰ ਸੁ ਗਜਹੀ ॥",
      "transliteration": "ranadheer beer su gajahee ||",
      "translation": "",
      "punjabiViakhya": "ਧੀਰਜ ਵਾਲੇ ਸੂਰਮੇ ਰਣ ਵਿਚ ਗਜਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "रणधीर बीर सु गजही ॥",
      "sourceLineId": "82339",
      "sourceShabadId": "7804",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਲਖਿ ਦੇਵ ਅਦੇਵ ਸੁ ਲਜਹੀ ॥",
      "transliteration": "lakh dhev adhev su lajahee ||",
      "translation": "The warriors are thundering in the war and seeing them both the gods and demons are feeling shy",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੂੰ ਵੇਖ ਕੇ ਦੈਂਤ ਅਤੇ ਦੇਵਤੇ ਸ਼ਰਮਿੰਦੇ ਹੋ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "लखि देव अदेव सु लजही ॥",
      "sourceLineId": "82340",
      "sourceShabadId": "7804",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਕ ਸੂਰ ਘਾਇਲ ਘੂੰਮਹੀ ॥",
      "transliteration": "eik soor ghail ghoo(n)mahee ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਇਕ ਘਾਇਲ ਸੂਰਮੇ ਘੁੰਮ ਰਹੇ ਸਨ, (ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ)",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "इक सूर घाइल घूँमही ॥",
      "sourceLineId": "82341",
      "sourceShabadId": "7804",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਨੁ ਧੂਮਿ ਅਧੋਮੁਖ ਧੂਮਹੀ ॥੧੯॥",
      "transliteration": "jan dhoom adhomukh dhoomahee ||19||",
      "translation": "The brave fighters, who have been wounded, are roaming and it appears that the smoke is flying upwards.19.",
      "punjabiViakhya": "ਮਾਨੋ ਧੂੰਆਂ ਸੇਵਨ ਕਰਨ ਵਾਲੇ ਮੂਧੇ ਮੂੰਹ ਧੂੰਆਂ ਪੀ ਰਹੇ ਹੋਣ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "जनु धूमि अधोमुख धूमही ॥१९॥",
      "sourceLineId": "82342",
      "sourceShabadId": "7804",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭਟ ਏਕ ਅਨੇਕ ਪ੍ਰਕਾਰ ਹੀ ॥",
      "transliteration": "bhaT ek anek prakaar hee ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੇਕ ਪ੍ਰਕਾਰ ਦੇ ਸੂਰਵੀਰ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "भट एक अनेक प्रकार ही ॥",
      "sourceLineId": "82343",
      "sourceShabadId": "7804",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜੁਝੇ ਅਜੁਝ ਜੁਝਾਰ ਹੀ ॥",
      "transliteration": "jujhe ajujh jujhaar hee ||",
      "translation": "The brave fighters of many types are fighting bravely with one another.",
      "punjabiViakhya": "ਨਾ ਮਾਰੇ ਜਾ ਸਕਣ ਵਾਲੇ ਵੀ ਜੂਝ ਕੇ ਵੀਰਗਤਿ ਪ੍ਰਾਪਤ ਕਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "जुझे अजुझ जुझार ही ॥",
      "sourceLineId": "82344",
      "sourceShabadId": "7804",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਫਹਰੰਤ ਬੈਰਕ ਬਾਣਯੰ ॥",
      "transliteration": "fahara(n)t bairak baanaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਝੰਡੀਆਂ ਅਤੇ ਤੀਰ ਫਰ-ਫਰ ਕਰ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "फहरंत बैरक बाणयं ॥",
      "sourceLineId": "82345",
      "sourceShabadId": "7804",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਥਹਰੰਤ ਜੋਧ ਕਿਕਾਣਯੰ ॥੨੦॥",
      "transliteration": "thahara(n)t jodh kikaanaya(n) ||20||",
      "translation": "The lances and arrows are being hurled and the horses of the warriors are advancing hesitantly.20.",
      "punjabiViakhya": "ਅਤੇ ਘੋੜ ਸਵਾਰ ਯੋਧੇ (ਫੁਰਤੀ ਨਾਲ) ਥਰਕਦੇ ਫਿਰਦੇ ਸਨ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "थहरंत जोध किकाणयं ॥२०॥",
      "sourceLineId": "82346",
      "sourceShabadId": "7804",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤੋਮਰ ਛੰਦ ॥",
      "transliteration": "tomar chha(n)dh ||",
      "translation": "TOMAR STANZA",
      "punjabiViakhya": "ਤੋਮਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "तोमर छंद ॥",
      "sourceLineId": "82347",
      "sourceShabadId": "7805",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਹਿਰਣਾਤ ਕੋਟ ਕਿਕਾਨ ॥",
      "transliteration": "hiranaat koT kikaan ||",
      "translation": "",
      "punjabiViakhya": "ਕਰੋੜਾ ਘੋੜੇ ਹਿਣਕਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "हिरणात कोट किकान ॥",
      "sourceLineId": "82348",
      "sourceShabadId": "7805",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਰਖੰਤ ਸੇਲ ਜੁਆਨ ॥",
      "transliteration": "barakha(n)t sel juaan ||",
      "translation": "Millions of horses are neighing and the warriors are showering arrows",
      "punjabiViakhya": "ਸੂਰਵੀਰ ਬਰਛਿਆਂ ਦਾ ਮੀਂਹ ਵਰ੍ਰਹਾਉਾਂਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "बरखंत सेल जुआन ॥",
      "sourceLineId": "82349",
      "sourceShabadId": "7805",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਛੁਟਕੰਤ ਸਾਇਕ ਸੁਧ ॥",
      "transliteration": "chhuTaka(n)t saik sudh ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਗੀ ਤਰ੍ਰਹਾ ਤੀਰ ਚਲ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "छुटकंत साइक सुध ॥",
      "sourceLineId": "82350",
      "sourceShabadId": "7805",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਚਿਯੋ ਅਨੂਪਮ ਜੁਧ ॥੨੧॥",
      "transliteration": "machiyo anoopam judh ||21||",
      "translation": "The bows have slipped and fallen from the hands and in this way the terrible and unique war is being waged.21.",
      "punjabiViakhya": "ਅਤੇ ਅਨੂਪਮ ਯੁੱਧ ਮਚਿਆ ਹੋਇਆ ਸੀ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "मचियो अनूपम जुध ॥२१॥",
      "sourceLineId": "82351",
      "sourceShabadId": "7805",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਭਟ ਏਕ ਅਨੇਕ ਪ੍ਰਕਾਰ ॥",
      "transliteration": "bhaT ek anek prakaar ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੇਕ ਤਰ੍ਰਹਾ ਦੇ ਸੂਰਮੇ (ਲੜਦੇ ਸਨ)",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "भट एक अनेक प्रकार ॥",
      "sourceLineId": "82352",
      "sourceShabadId": "7805",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜੁਝੇ ਅਨੰਤ ਸ੍ਵਾਰ ॥",
      "transliteration": "jujhe ana(n)t savaiaar ||",
      "translation": "Many types of warriors and innumerable horsemen are fighting with one another",
      "punjabiViakhya": "ਅਣਗਿਣਤ ਸਵਾਰ ਜੂਝਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "जुझे अनंत स्वार ॥",
      "sourceLineId": "82353",
      "sourceShabadId": "7805",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਾਹੈ ਕ੍ਰਿਪਾਣ ਨਿਸੰਗ ॥",
      "transliteration": "baahai kirapaan nisa(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਨਿਡਰ ਹੋ ਕੇ (ਸੈਨਿਕ) ਤਲਵਾਰਾ ਚਲਾਉਾਂਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "बाहै कृपाण निसंग ॥",
      "sourceLineId": "82354",
      "sourceShabadId": "7805",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਚਿਯੋ ਅਪੂਰਬ ਜੰਗ ॥੨੨॥",
      "transliteration": "machiyo apoorab ja(n)g ||22||",
      "translation": "They are striking their swords without any suspicion and in this way, a unique war is going on.22.",
      "punjabiViakhya": "ਅਤੇ ਬੇਮਿਸਾਲ ਯੁੱਧ ਹੋ ਰਿਹਾ ਸੀ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "मचियो अपूरब जंग ॥२२॥",
      "sourceLineId": "82355",
      "sourceShabadId": "7805",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੋਧਕ ਛੰਦ ॥",
      "transliteration": "dhodhak chha(n)dh ||",
      "translation": "DODHAK STANZA",
      "punjabiViakhya": "ਦੋਧਕ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "दोधक छंद ॥",
      "sourceLineId": "82356",
      "sourceShabadId": "7806",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਾਹਿ ਕ੍ਰਿਪਾਣ ਸੁ ਬਾਣ ਭਟ ਗਣ ॥",
      "transliteration": "baeh kirapaan su baan bhaT gan ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਵੀਰਾ ਦੇ ਦਲ ਤੀਰ ਤੇ ਤਲਵਾਰਾ ਚਲਾਉਾਂਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "बाहि कृपाण सु बाण भट गण ॥",
      "sourceLineId": "82357",
      "sourceShabadId": "7806",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅੰਤਿ ਗਿਰੈ ਪੁਨਿ ਜੂਝਿ ਮਹਾ ਰਣਿ ॥",
      "transliteration": "a(n)t girai pun joojh mahaa ran ||",
      "translation": "After striking their swords and arrows, the brave fighters ultimately fell down during that great war.",
      "punjabiViakhya": "ਅੰਤਿ ਵਿਚ ਉਸ ਵੱਡੀ ਜੰਗ ਵਿਚ ਜੂਝ ਕੇ ਡਿਗਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "अंति गिरै पुनि जूझि महा रणि ॥",
      "sourceLineId": "82358",
      "sourceShabadId": "7806",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਘਾਇ ਲਗੈ ਇਮ ਘਾਇਲ ਝੂਲੈ ॥",
      "transliteration": "ghai lagai im ghail jhoolai ||",
      "translation": "",
      "punjabiViakhya": "ਜ਼ਖਮ ਲਗਣ ਨਾਲ ਘਾਇਲ ਇੰਜ ਝੂਲ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "घाइ लगै इम घाइल झूलै ॥",
      "sourceLineId": "82359",
      "sourceShabadId": "7806",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਫਾਗੁਨਿ ਅੰਤਿ ਬਸੰਤ ਸੇ ਫੂਲੈ ॥੨੩॥",
      "transliteration": "faagun a(n)t basa(n)t se foolai ||23||",
      "translation": "The wounded warriors are swinging like the blossomed spring at the end of the month of Phagun.23.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਫਗਣ ਮਹੀਨੇ ਦੇ ਅੰਤ ਵਿਚ ਬਸੰਤ ਫੁਲੀ ਹੋਈ ਝੂਲਦੀ ਹੁੰਦੀ ਹੈ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "फागुनि अंति बसंत से फूलै ॥२३॥",
      "sourceLineId": "82360",
      "sourceShabadId": "7806",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਾਹਿ ਕਟੀ ਭਟ ਏਕਨ ਐਸੀ ॥",
      "transliteration": "baeh kaTee bhaT ekan aaisee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕਨਾ ਯੋਧਿਆਂ ਦੀ ਕਟੀ ਹੋਈ ਬਾਹ ਇੰਜ ਲਗਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "बाहि कटी भट एकन ऐसी ॥",
      "sourceLineId": "82361",
      "sourceShabadId": "7806",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੁੰਡ ਮਨੋ ਗਜ ਰਾਜਨ ਜੈਸੀ ॥",
      "transliteration": "su(n)dd mano gaj raajan jaisee ||",
      "translation": "Somewhere the chopped arms of the warriors appear like the trunks of the elephants",
      "punjabiViakhya": "ਮਾਨੋ ਗਜ-ਰਾਜ ਦੀ ਸੁੰਡ ਡਿਗੀ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "सुँड मनो गज राजन जैसी ॥",
      "sourceLineId": "82362",
      "sourceShabadId": "7806",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੋਹਤ ਏਕ ਅਨੇਕ ਪ੍ਰਕਾਰੰ ॥",
      "transliteration": "sohat ek anek prakaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਸੂਰਮੇ ਅਨੇਕ ਤਰ੍ਰਹਾ ਨਾਲ ਸ਼ੁਭਾਇਮਾਨ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "सोहत एक अनेक प्रकारं ॥",
      "sourceLineId": "82363",
      "sourceShabadId": "7806",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਫੂਲ ਖਿਲੇ ਜਨੁ ਮਧਿ ਫੁਲਵਾਰੰ ॥੨੪॥",
      "transliteration": "fool khile jan madh fulavaara(n) ||24||",
      "translation": "The brave fighters appear beautiful like the flowers blooming in the garden.24.",
      "punjabiViakhya": "ਮਾਨੋ ਫੁਲਵਾੜੀ ਵਿਚ ਫੁਲ ਖਿੜੇ ਹੋਣ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "फूल खिले जनु मधि फुलवारं ॥२४॥",
      "sourceLineId": "82364",
      "sourceShabadId": "7806",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸ੍ਰੋਣ ਰੰਗੇ ਅਰਿ ਏਕ ਅਨੇਕੰ ॥",
      "transliteration": "sron ra(n)ge ar ek aneka(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਇਕ ਵੈਰੀ ਲਹੂ ਨਾਲ ਇੰਜ ਰੰਗੇ ਹੋਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "स्रोण रंगे अरि एक अनेकं ॥",
      "sourceLineId": "82365",
      "sourceShabadId": "7806",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਫੂਲ ਰਹੇ ਜਨੁ ਕਿੰਸਕ ਨੇਕੰ ॥",
      "transliteration": "fool rahe jan ki(n)sak neka(n) ||",
      "translation": "The enemies were dyed with blood like many types of blooming flowers.",
      "punjabiViakhya": "ਮਾਨੋ ਕੇਸੂ ਦੇ ਅਨੇਕ ਫੁਲ ਖਿੜੇ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "फूल रहे जनु किंसक नेकं ॥",
      "sourceLineId": "82366",
      "sourceShabadId": "7806",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਧਾਵਤ ਘਾਵ ਕ੍ਰਿਪਾਣ ਪ੍ਰਹਾਰੰ ॥",
      "transliteration": "dhaavat ghaav kirapaan prahaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਨਾ ਦੇ ਵਾਰ ਨਾਲ ਜ਼ਖ਼ਮੀ ਹੋਏ (ਇਧਰ ਉਧਰ) ਭਜ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "धावत घाव कृपाण प्रहारं ॥",
      "sourceLineId": "82367",
      "sourceShabadId": "7806",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਾਨੁ ਕਿ ਕੋਪ ਪ੍ਰਤਛ ਦਿਖਾਰੰ ॥੨੫॥",
      "transliteration": "jaan k kop pratachh dhikhaara(n) ||25||",
      "translation": "After having been wounded with swords the brave soldiers were roaming like the manifestation of anger itself.25.",
      "punjabiViakhya": "ਮਾਨੋ ਕ੍ਰੋਧ ਪ੍ਰਤੱਖ ਹੋ ਕੇ ਦਿਖਾਈ ਦੇ ਰਿਹਾ ਹੋਵੇ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "जानु कि कोप प्रतछ दिखारं ॥२५॥",
      "sourceLineId": "82368",
      "sourceShabadId": "7806",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤੋਟਕ ਛੰਦ ॥",
      "transliteration": "toTak chha(n)dh ||",
      "translation": "TOTAK STANZA",
      "punjabiViakhya": "ਤੋਟਕ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "तोटक छंद ॥",
      "sourceLineId": "82369",
      "sourceShabadId": "7807",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜੂਝਿ ਗਿਰੇ ਅਰਿ ਏਕ ਅਨੇਕੰ ॥",
      "transliteration": "joojh gire ar ek aneka(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਇਕ ਵੈਰੀ ਜੂਝ ਕੇ ਡਿਗ ਪਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "जूझि गिरे अरि एक अनेकं ॥",
      "sourceLineId": "82370",
      "sourceShabadId": "7807",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਘਾਇ ਲਗੇ ਬਿਸੰਭਾਰ ਬਿਸੇਖੰ ॥",
      "transliteration": "ghai lage bisa(n)bhaar bisekha(n) ||",
      "translation": "Many enemies fell down fighting and Narsingh, the incarnation of Vishnu also received many wounds.",
      "punjabiViakhya": "ਅਤੇ ਨਰਸਿੰਘ ਨੂੰ ਵੀ ਇਤਨੇ ਅਧਿਕ ਜ਼ਖ਼ਮ ਲਗੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "घाइ लगे बिसंभार बिसेखं ॥",
      "sourceLineId": "82371",
      "sourceShabadId": "7807",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਾਟਿ ਗਿਰੇ ਭਟ ਏਕਹਿ ਵਾਰੰ ॥",
      "transliteration": "kaaT gire bhaT ekeh vaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਇਕੋ ਵਾਰ ਨਾਲ (ਨਰਸਿੰਘ) ਨੇ ਅਨੇਕ ਸੂਰਮੇ ਕਟ ਕੇ ਡਿਗਾ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "काटि गिरे भट एकहि वारं ॥",
      "sourceLineId": "82372",
      "sourceShabadId": "7807",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਾਬੁਨ ਜਾਨੁ ਗਈ ਬਹਿ ਤਾਰੰ ॥੨੬॥",
      "transliteration": "saabun jaan giee beh taara(n) ||26||",
      "translation": "The chopped bits of the warriors were flowing in the stream of blood like the bubbles of foam.26.",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ) ਮਾਨੋ ਸਾਬਨ ਵਿਚ ਤਾਰ ਚਲ ਗਈ ਹੋਵੇ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "साबुन जानु गई बहि तारं ॥२६॥",
      "sourceLineId": "82373",
      "sourceShabadId": "7807",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪੂਰ ਪਰੇ ਭਏ ਚੂਰ ਸਿਪਾਹੀ ॥",
      "transliteration": "poor pare bhe choor sipaahee ||",
      "translation": "",
      "punjabiViakhya": "ਸਿਪਾਹੀਆਂ ਦੇ ਪੂਰ ਚੂਰ ਚੂਰ ਹੋ ਕੇ ਡਿਗੇ ਪਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "पूर परे भए चूर सिपाही ॥",
      "sourceLineId": "82374",
      "sourceShabadId": "7807",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੁਆਮਿ ਕੇ ਕਾਜ ਕੀ ਲਾਜ ਨਿਬਾਹੀ ॥",
      "transliteration": "suaam ke kaaj kee laaj nibaahee ||",
      "translation": "The fighting soldiers, having been cut into bits, fell down, but none of them put to disrepute the dignity of their master.",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੇ ਸੁਆਮੀ ਦਾ ਕੰਮ ਕਰਕੇ ਲਾਜ ਪਾਲੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "सुआमि के काज की लाज निबाही ॥",
      "sourceLineId": "82375",
      "sourceShabadId": "7807",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬਾਹਿ ਕ੍ਰਿਪਾਣਨ ਬਾਣ ਸੁ ਬੀਰੰ ॥",
      "transliteration": "baeh kirapaanan baan su beera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਇਕ ਸੂਰਮੇ ਕ੍ਰਿਪਾਨਾ ਅਤੇ ਤੀਰਾ ਨੂੰ ਚਲਾਉਾਂਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "बाहि कृपाणन बाण सु बीरं ॥",
      "sourceLineId": "82376",
      "sourceShabadId": "7807",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅੰਤਿ ਭਜੇ ਭਯ ਮਾਨਿ ਅਧੀਰੰ ॥੨੭॥",
      "transliteration": "a(n)t bhaje bhay maan adheera(n) ||27||",
      "translation": "Showing the blows of the swords and arrows, the warriors fled away ultimately in great fear.27.",
      "punjabiViakhya": "ਪਰ ਅੰਤ ਵਿਚ ਭੈਭੀਤ ਅਤੇ ਅਧੀਰ ਹੋ ਕੇ ਭਜ ਜਾਦੇ ਸਨ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "अंति भजे भय मानि अधीरं ॥२७॥",
      "sourceLineId": "82377",
      "sourceShabadId": "7807",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0168_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 168,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "82378",
      "sourceShabadId": "7808",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
