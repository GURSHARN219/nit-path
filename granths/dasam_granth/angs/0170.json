{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 170,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0170_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕੰਪਾਈ ਸਟਾ ਪੂਛ ਫੇਰੀ ਬਿਸਾਲੰ ॥੩੩॥",
      "transliteration": "ka(n)paiee saTaa poochh feree bisaala(n) ||33||",
      "translation": "That terrible and dreadful Narsingh moved in the battlefield and began to stir his neck and wag his tail.33.",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੀ ਗਰਦਨ ਦੇ ਵਾਲਾ ਨੂੰ ਛੰਡਦਾ ਅਤੇ ਲੰਬੀ ਪੂਛ ਨੂੰ ਘੁਮਾਉਾਂਦਾ ਸੀ ॥੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "कंपाई सटा पूछ फेरी बिसालं ॥३३॥",
      "sourceLineId": "82403",
      "sourceShabadId": "7809",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "82404",
      "sourceShabadId": "7810",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗਰਜਤ ਰਣਿ ਨਰਸਿੰਘ ਕੇ ਭਜੇ ਸੂਰ ਅਨੇਕ ॥",
      "transliteration": "garajat ran narasi(n)gh ke bhaje soor anek ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਨਰਸਿੰਘ ਦੇ ਗਜਦਿਆਂ ਹੀ ਅਨੇਕਾ ਸੂਰਮੇ ਭਜ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "गरजत रणि नरसिंघ के भजे सूर अनेक ॥",
      "sourceLineId": "82405",
      "sourceShabadId": "7810",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਏਕ ਟਿਕਿਯੋ ਹਿਰਿਨਾਛ ਤਹ ਅਵਰ ਨ ਜੋਧਾ ਏਕੁ ॥੩੪॥",
      "transliteration": "ek Tikiyo hirinaachh teh avar na jodhaa ek ||34||",
      "translation": "Many warriors fled on the thunder of Narsingh and none could stand in battlefield except Hiranayakashipu.34.",
      "punjabiViakhya": "ਉਥੇ ਕੇਵਲ ਇਕ ਹਿਰਨਕਸ਼ਪ ਟਿਕਿਆ, ਹੋਰ ਕੋਈ ਇਕ ਵੀ ਨਾ (ਡਟਿਆ) ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "एक टिकियो हिरिनाछ तह अवर न जोधा एकु ॥३४॥",
      "sourceLineId": "82406",
      "sourceShabadId": "7810",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "82407",
      "sourceShabadId": "7811",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮੁਸਟ ਜੁਧ ਜੁੱਟੇ ਭਟ ਦੋਊ ॥",
      "transliteration": "musaT judh ju'Te bhaT dhouoo ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਮਹਾਨ ਯੋਧੇ ਮੁਕਿਆਂ ਦੀ ਲੜਾਈ ਵਿਚ ਜੁਟ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "मुसट जुध जुट्टे भट दोऊ ॥",
      "sourceLineId": "82408",
      "sourceShabadId": "7811",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤੀਸਰ ਤਾਹਿ ਨ ਪੇਖੀਅਤ ਕੋਊ ॥",
      "transliteration": "teesar taeh na pekheeat kouoo ||",
      "translation": "The war with fists of both the warriors began and none other except those two could be seen in the battlefield.",
      "punjabiViakhya": "ਤੀਜਾ ਉਥੇ ਕੋਈ ਨਜ਼ਰ ਨਹੀਂ ਆਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "तीसर ताहि न पेखीअत कोऊ ॥",
      "sourceLineId": "82409",
      "sourceShabadId": "7811",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭਏ ਦੁਹੁਨ ਕੇ ਰਾਤੇ ਨੈਣਾ ॥",
      "transliteration": "bhe dhuhun ke raate nainaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਦੀਆਂ ਅੱਖਾ ਲਾਲ ਹੋ ਗਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "भए दुहुन के राते नैणा ॥",
      "sourceLineId": "82410",
      "sourceShabadId": "7811",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੇਖਤ ਦੇਵ ਤਮਾਸੇ ਗੈਣਾ ॥੩੫॥",
      "transliteration": "dhekhat dhev tamaase gainaa ||35||",
      "translation": "The eyes of both had become red and all the groups of gods were seeing this performance form the sky.35.",
      "punjabiViakhya": "ਦੇਵਤੇ ਆਕਾਸ਼ ਵਿਚ ਤਮਾਸ਼ਾ ਵੇਖ ਰਹੇ ਸਨ ॥੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "देखत देव तमासे गैणा ॥३५॥",
      "sourceLineId": "82411",
      "sourceShabadId": "7811",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਸਟ ਦਿਵਸ ਅਸਟੇ ਨਿਸਿ ਜੁਧਾ ॥",
      "transliteration": "asaT dhivas asaTe nis judhaa ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਠ ਦਿਨ ਅਤੇ ਅੱਠ ਰਾਤਾ ਦੋਹਾ ਯੋਧਿਆਂ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "असट दिवस असटे निसि जुधा ॥",
      "sourceLineId": "82412",
      "sourceShabadId": "7811",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕੀਨੋ ਦੁਹੂੰ ਭਟਨ ਮਿਲਿ ਕ੍ਰੁਧਾ ॥",
      "transliteration": "keeno dhuhoo(n) bhaTan mil krudhaa ||",
      "translation": "For eight days and eight nights both these brave heroes, furiously, waged the dreadful war.",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਸਹਿਤ ਆਪਸ ਵਿਚ ਯੁੱਧ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "कीनो दुहूँ भटन मिलि क्रुधा ॥",
      "sourceLineId": "82413",
      "sourceShabadId": "7811",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਹੁਰੋ ਅਸੁਰ ਕਿਛੁ ਕੁ ਮੁਰਝਾਨਾ ॥",
      "transliteration": "bahuro asur kichh k murajhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਦੈਂਤ ਕੁਝ ਕੁ ਮੁਰਝਾ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "बहुरो असुर किछु कु मुरझाना ॥",
      "sourceLineId": "82414",
      "sourceShabadId": "7811",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗਿਰਿਯੋ ਭੂਮਿ ਜਨੁ ਬ੍ਰਿਛ ਪੁਰਾਨਾ ॥੩੬॥",
      "transliteration": "giriyo bhoom jan birachh puraanaa ||36||",
      "translation": "After this, the demon-king felt weakness and fell down on the earth like an old tree.36.",
      "punjabiViakhya": "ਅਤੇ ਧਰਤੀ ਉਤੇ (ਇੰਜ) ਡਿਗ ਪਿਆ ਮਾਨੋ ਪੁਰਾਣਾ ਬ੍ਰਿਛ ਹੋਵੇ ॥੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "गिरियो भूमि जनु बृछ पुराना ॥३६॥",
      "sourceLineId": "82415",
      "sourceShabadId": "7811",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੀਚਿ ਬਾਰਿ ਪੁਨਿ ਤਾਹਿ ਜਗਾਯੋ ॥",
      "transliteration": "seech baar pun taeh jagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ (ਨਰਸਿੰਘ ਨੇ) ਪਾਣੀ (ਬਾਰ) ਛਿੜਕ ਕੇ ਉਸ ਨੂੰ ਸਚੇਤ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "सीचि बारि पुनि ताहि जगायो ॥",
      "sourceLineId": "82416",
      "sourceShabadId": "7811",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਗੋ ਮੂਰਛਨਾ ਪੁਨਿ ਜੀਯ ਆਯੋ ॥",
      "transliteration": "jago moorachhanaa pun jeey aayo ||",
      "translation": "Narsingh sprinkled ambrosia and woke him up from the unconscious state and he become alert after coming out of the state of unconsciousness.",
      "punjabiViakhya": "(ਜਦੋਂ) ਉਹ ਮੂਰਛਨਾ ਤੋਂ ਉਠਿਆ ਤਾ (ਉਸ ਨੂੰ) ਹਿੰਮਤ ਬਝੀ।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "जगो मूरछना पुनि जीय आयो ॥",
      "sourceLineId": "82417",
      "sourceShabadId": "7811",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਹੁਰੋ ਭਿਰੇ ਸੂਰ ਦੋਈ ਕ੍ਰੁਧਾ ॥",
      "transliteration": "bahuro bhire soor dhoiee krudhaa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਦੋਵੇਾਂ ਸੂਰਵੀਰ ਕ੍ਰੋਧ ਸਹਿਤ ਲੜਨ ਲਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "बहुरो भिरे सूर दोई क्रुधा ॥",
      "sourceLineId": "82418",
      "sourceShabadId": "7811",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੰਡਿਯੋ ਬਹੁਰਿ ਆਪ ਮਹਿ ਜੁਧਾ ॥੩੭॥",
      "transliteration": "ma(n)ddiyo bahur aap meh judhaa ||37||",
      "translation": "Both the heroes began to fight again furiously and a dreadful war began again.37.",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਆਪਸ ਵਿਚ ਯੁੱਧ ਸ਼ੁਰੂ ਕਰ ਦਿੱਤਾ ॥੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "मंडियो बहुरि आप महि जुधा ॥३७॥",
      "sourceLineId": "82419",
      "sourceShabadId": "7811",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "82420",
      "sourceShabadId": "7812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹਲਾ ਚਾਲ ਕੈ ਕੈ ਪੁਨਰ ਬੀਰ ਢੂਕੇ ॥",
      "transliteration": "halaa chaal kai kai punar beer ddooke ||",
      "translation": "",
      "punjabiViakhya": "ਲਲਕਾਰੇ ਮਾਰ ਕੇ ਫਿਰ ਦੋਵੇਾਂ ਯੁੱਧਵੀਰ (ਇਕ ਦੂਜੇ ਦੇ ਨੇੜੇ) ਢੁਕੇ।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "हला चाल कै कै पुनर बीर ढूके ॥",
      "sourceLineId": "82421",
      "sourceShabadId": "7812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਚਿਯੋ ਜੁਧ ਜਿਯੋ ਕਰਨ ਸੰਗੰ ਘੜੂਕੇ ॥",
      "transliteration": "machiyo judh jiyo karan sa(n)ga(n) ghaRooke ||",
      "translation": "After challenging each other, both the heroes began to fight again, and a dreadful war ensued between them for gaining victory over the other.",
      "punjabiViakhya": "(ਦੋਹਾ ਵਿਚ ਅਜਿਹਾ) ਯੁੱਧ ਮਚਿਆ, ਜਿਵੇਾਂ (ਮਹਾਭਾਰਤ ਦੀ ਲੜਾਈ ਵਿਚ) ਕਰਨ ਦਾ ਘੜੂਕੇ (ਭੀਮ ਦਾ ਹਿੜਿੰਬੀ ਦੀ ਕੁੱਖੋਂ ਪੈਦਾ ਹੋਇਆ ਪੁੱਤਰ-ਘਟੋਤਕਚ) ਨਾਲ (ਹੋਇਆ ਸੀ)।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "मचियो जुध जियो करन संगं घड़ूके ॥",
      "sourceLineId": "82422",
      "sourceShabadId": "7812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਖੰ ਪਾਤ ਦੋਊ ਕਰੇ ਦੈਤ ਘਾਤੰ ॥",
      "transliteration": "nakha(n) paat dhouoo kare dhait ghaata(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਨਰਸਿੰਘ ਨੇ) ਦੋਹਾ ਹੱਥਾ ਦੇ ਨਹੁੰਆਂ ਨਾਲ ਦੈਂਤ ਨੂੰ ਜ਼ਖ਼ਮੀ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "नखं पात दोऊ करे दैत घातं ॥",
      "sourceLineId": "82423",
      "sourceShabadId": "7812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਨੋ ਗਜ ਜੁਟੇ ਬਨੰ ਮਸਤਿ ਮਾਤੰ ॥੩੮॥",
      "transliteration": "mano gaj juTe bana(n) masat maata(n) ||38||",
      "translation": "Both of them were giving destructive blows to one another with their nails and appeared like two intoxicated elephants fighting each other in the forest.38.",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਬਨ ਵਿਚ ਦੋ ਮਦਮਾਤੇ ਹਾਥੀ ਆਪਸ ਵਿਚ ਜੂਝ ਰਹੇ ਹੋਣ ॥੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "मनो गज जुटे बनं मसति मातं ॥३८॥",
      "sourceLineId": "82424",
      "sourceShabadId": "7812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪੁਨਰ ਨਰਸਿੰਘੰ ਧਰਾ ਤਾਹਿ ਮਾਰਿਯੋ ॥",
      "transliteration": "punar narasi(n)gha(n) dharaa taeh maariyo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਨਰਸਿੰਘ ਨੇ (ਦੈਂਤ ਨੂੰ) ਧਰਤੀ ਉਤੇ ਪਟਕ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "पुनर नरसिंघं धरा ताहि मारियो ॥",
      "sourceLineId": "82425",
      "sourceShabadId": "7812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪੁਰਾਨੋ ਪਲਾਸੀ ਮਨੋ ਬਾਇ ਡਾਰਿਯੋ ॥",
      "transliteration": "puraano palaasee mano bai ddaariyo ||",
      "translation": "Narsingh again threw Hiranayakashipu on the earth just as the old Palas tree (Butea frondosa) falls down on the earth with a gust of wind.",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਢਕ ਦੇ ਪੁਰਾਣੇ ਬ੍ਰਿਛ ਨੂੰ ਹਵਾ ਨੇ (ਧਰਤੀ ਉਤੇ) ਸੁਟ ਦਿੱਤਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "पुरानो पलासी मनो बाइ डारियो ॥",
      "sourceLineId": "82426",
      "sourceShabadId": "7812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹਨ੍ਯੋ ਦੇਖਿ ਦੁਸਟੰ ਭਈ ਪੁਹਪ ਬਰਖੰ ॥",
      "transliteration": "hanayo dhekh dhusaTa(n) bhiee puhap barakha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦੁਸ਼ਟ ਨੂੰ ਮਾਰਿਆ ਗਿਆ ਵੇਖ ਕੇ (ਆਕਾਸ਼ ਤੋਂ) ਫੁਲਾ ਦੀ ਬਰਖਾ ਹੋਈ।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "हन्यो देखि दुसटं भई पुहप बरखं ॥",
      "sourceLineId": "82427",
      "sourceShabadId": "7812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕੀਏ ਦੇਵਤਿਯੋ ਆਨ ਕੈ ਜੀਤ ਕਰਖੰ ॥੩੯॥",
      "transliteration": "ke'ee dhevatiyo aan kai jeet karakha(n) ||39||",
      "translation": "Seeing that tyrants hath died, sang many types of songs of victory.39.",
      "punjabiViakhya": "ਦੇਵਤਿਆਂ ਨੇ ਆ ਕੇ ਜਿਤ ਦੀ ਖੁਸ਼ੀ ਦੇ ਗੀਤ (ਗਾਏ) ॥੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "कीए देवतियो आन कै जीत करखं ॥३९॥",
      "sourceLineId": "82428",
      "sourceShabadId": "7812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪਾਧਰੀ ਛੰਦ ॥",
      "transliteration": "paadharee chha(n)dh ||",
      "translation": "PAADHARI STANZA",
      "punjabiViakhya": "ਪਾਧਰੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "पाधरी छंद ॥",
      "sourceLineId": "82429",
      "sourceShabadId": "7813",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕੀਨੋ ਨਰਸਿੰਘ ਦੁਸਟੰ ਸੰਘਾਰ ॥",
      "transliteration": "keeno narasi(n)gh dhusaTa(n) sa(n)ghaar ||",
      "translation": "",
      "punjabiViakhya": "ਨਰਸਿੰਘ ਨੇ ਦੁਸ਼ਟ ਦੈਂਤ ਦਾ ਸੰਘਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "कीनो नरसिंघ दुसटं संघार ॥",
      "sourceLineId": "82430",
      "sourceShabadId": "7813",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਧਰਿਯੋ ਸੁ ਬਿਸਨ ਸਪਤਮ ਵਤਾਰ ॥",
      "transliteration": "dhariyo su bisan sapatam vataar ||",
      "translation": "Narsingh destroyed the tyrant and in this way Vishnu manifested his seventh incarnation.",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਵਿਸ਼ਣੂ ਨੇ ਸੱਤਵਾ ਅਵਤਾਰ ਧਾਰਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "धरियो सु बिसन सपतम वतार ॥",
      "sourceLineId": "82431",
      "sourceShabadId": "7813",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਲਿਨੋ ਸੁ ਭਗਤ ਅਪਨੋ ਛਿਨਾਇ ॥",
      "transliteration": "lino su bhagat apano chhinai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਆਪਣੇ ਭਗਤ ਨੂੰ (ਵੈਰੀ ਦੇ ਹੱਥੋਂ) ਖੋਹ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "लिनो सु भगत अपनो छिनाइ ॥",
      "sourceLineId": "82432",
      "sourceShabadId": "7813",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਬ ਸਿਸਟਿ ਧਰਮ ਕਰਮਨ ਚਲਾਇ ॥੪੦॥",
      "transliteration": "sab sisaT dharam karaman chalai ||40||",
      "translation": "He protected his devotee and spread righteousness on the earth.40.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੀ ਸ੍ਰਿਸ਼ਟੀ ਵਿਚ ਧਰਮ-ਕਰਮ ਦੀ ਵਿਵਸਥਾ ਕੀਤੀ ॥੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "सब सिसटि धरम करमन चलाइ ॥४०॥",
      "sourceLineId": "82433",
      "sourceShabadId": "7813",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪ੍ਰਹਲਾਦ ਕਰਿਯੋ ਨ੍ਰਿਪ ਛਤ੍ਰ ਫੇਰਿ ॥",
      "transliteration": "prahalaadh kariyo nirap chhatr fer ||",
      "translation": "",
      "punjabiViakhya": "(ਨਰਸਿੰਘ ਨੇ) ਪ੍ਰਹਿਲਾਦ ਨੂੰ ਰਾਜਾ ਬਣਾਇਆ ਅਤੇ (ਉਸ ਦੇ ਸਿਰ ਉਤੇ) ਛੱਤਰ ਫਿਰਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "प्रहलाद करियो नृप छत्र फेरि ॥",
      "sourceLineId": "82434",
      "sourceShabadId": "7813",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦੀਨੋ ਸੰਘਾਰ ਸਬ ਇਮ ਅੰਧੇਰ ॥",
      "transliteration": "dheeno sa(n)ghaar sab im a(n)dher ||",
      "translation": "The canopy was swung over the head of Prahlad and he was made a king, and in this way, the demons, who were darkness-incarnate, were destroyed.",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ (ਪਾਪਾ ਦਾ) ਸਾਰਾ ਅੰਧਕਾਰ ਖ਼ਤਮ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "दीनो संघार सब इम अंधेर ॥",
      "sourceLineId": "82435",
      "sourceShabadId": "7813",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਬ ਦੁਸਟ ਅਰਿਸਟ ਦਿਨੇ ਖਪਾਇ ॥",
      "transliteration": "sab dhusaT arisaT dhine khapai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਦੁਸ਼ਟ ਅਤੇ ਵਿਘਨਕਾਰੀ ਸ਼ਕਤੀਆਂ ਨਸ਼ਟ ਕਰ ਦਿੱਤੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "सब दुसट अरिसट दिने खपाइ ॥",
      "sourceLineId": "82436",
      "sourceShabadId": "7813",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪੁਨਿ ਲਈ ਜੋਤਿ ਜੋਤਹਿ ਮਿਲਾਇ ॥੪੧॥",
      "transliteration": "pun liee jot joteh milai ||41||",
      "translation": "Destroying all the tyrants and vicious people, Narsingh merged his light in the Supreme Light.41.",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ (ਆਪਣੀ) ਜੋਤਿ ਬ੍ਰਹਮ-ਜੋਤਿ ਵਿਚ ਮਿਲਾ ਦਿੱਤੀ ॥੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "पुनि लई जोति जोतहि मिलाइ ॥४१॥",
      "sourceLineId": "82437",
      "sourceShabadId": "7813",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਭ ਦੁਸਟ ਮਾਰਿ ਕੀਨੇ ਅਭੇਖ ॥",
      "transliteration": "sabh dhusaT maar keene abhekh ||",
      "translation": "By killing them, all the tyrants were put to shame,",
      "punjabiViakhya": "(ਨਰਸਿੰਘ ਨੇ) ਸਾਰਿਆਂ ਦੁਸ਼ਟਾ ਨੂੰ ਮਾਰ ਕੇ ਬੇਹਾਲ ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "सभ दुसट मारि कीने अभेख ॥",
      "sourceLineId": "82438",
      "sourceShabadId": "7813",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪੁਨ ਮਿਲ੍ਯੋ ਜਾਇ ਭੀਤਰ ਅਲੇਖ ॥",
      "transliteration": "pun milayo jai bheetar alekh ||",
      "translation": "And that Imperceptible Lord-God merged again in His Own Self.",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਅਲੇਖ (ਪਰਮ-ਸੱਤਾ) ਵਿਚ ਮਿਲ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "पुन मिल्यो जाइ भीतर अलेख ॥",
      "sourceLineId": "82439",
      "sourceShabadId": "7813",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਬਿ ਜਥਾਮਤਿ ਕਥ੍ਯੋ ਬਿਚਾਰੁ ॥",
      "transliteration": "kab jathaamat kathayo bichaar ||",
      "translation": "The poet, according to his own understanding, after reflection, hath uttered the above-mentioned saying,",
      "punjabiViakhya": "ਕਵੀ ਨੇ ਆਪਣੀ ਬੁੱਧੀ ਅਨੁਸਾਰ ਵਿਚਾਰ-ਪੂਰਵਕ ਕਥਨ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "कबि जथामति कथ्यो बिचारु ॥",
      "sourceLineId": "82440",
      "sourceShabadId": "7813",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਮ ਧਰਿਯੋ ਬਿਸਨੁ ਸਪਤਮ ਵਤਾਰ ॥੪੨॥",
      "transliteration": "eim dhariyo bisan sapatam vataar ||42||",
      "translation": "That in this way, Vishnu manifested himself in his seventh incarnation.42.",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਵਿਸ਼ਣੂ ਨੇ ਸੱਤਵਾ ਅਵਤਾਰ ਧਾਰਨ ਕੀਤਾ ਸੀ ॥੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "इम धरियो बिसनु सपतम वतार ॥४२॥",
      "sourceLineId": "82441",
      "sourceShabadId": "7813",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਨਰਸਿੰਘ ਸਪਤਮੋ ਅਵਤਾਰ ਸਮਾਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੭॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the narasi(n)gh sapatamo avataar samaatam sat subham sat ||7||",
      "translation": "End of the description of the seventh incarnation of NARSINGH.7.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦਾ ਨਰਸਿੰਘ ਸੱਤਵਾ ਅਵਤਾਰ ਪ੍ਰਸੰਗ ਸਮਾਪਤ ਸਭ ਸ਼ੁਭ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे नरसिंघ सपतमो अवतार समातम सतु सुभम सतु ॥७॥",
      "sourceLineId": "82442",
      "sourceShabadId": "7813",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਥ ਬਾਵਨ ਅਵਤਾਰ ਬਰਨੰ ॥",
      "transliteration": "ath baavan avataar barana(n) ||",
      "translation": "Now begins the description of Bawan (Vaman) Incarnation:",
      "punjabiViakhya": "ਹੁਣ ਬਾਵਨ ਅਵਤਾਰ ਦਾ ਕਥਨ:",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "अथ बावन अवतार बरनं ॥",
      "sourceLineId": "82443",
      "sourceShabadId": "7814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ ॥",
      "transliteration": "sree bhagautee jee sahai ||",
      "translation": "Let Sri Bhagauti Ji (The Primal Lord) be helpfrul.",
      "punjabiViakhya": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ:",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "स्री भगउती जी सहाइ ॥",
      "sourceLineId": "82444",
      "sourceShabadId": "7814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "82445",
      "sourceShabadId": "7814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਭਏ ਦਿਵਸ ਕੇਤੈ ਨਰਸਿੰਘਾਵਤਾਰੰ ॥",
      "transliteration": "bhe dhivas ketai narasi(n)ghaavataara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨਰਸਿੰਘ ਅਵਤਾਰ ਨੂੰ ਹੋਇਆਂ ਕਿਤਨਾ ਸਮਾ ਬੀਤ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
      "hindiTransliteration": "भए दिवस केतै नरसिंघावतारं ॥",
      "sourceLineId": "82446",
      "sourceShabadId": "7814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0170_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪੁਨਰ ਭੂਮਿ ਮੋ ਪਾਪਾ ਬਾਢ੍ਯੋ ਅਪਾਰੰ ॥",
      "transliteration": "punar bhoom mo paapaa baaddayo apaara(n) ||",
      "translation": "After passing away of the epoch of Narsingh incarnation, the sins began to grow in intensity on the earth again.",
      "punjabiViakhya": "ਧਰਤੀ ਉਤੇ ਫਿਰ ਅਪਾਰ ਪਾਪ ਵੱਧ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 170,
      "hindi": "",
