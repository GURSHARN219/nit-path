{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 171,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0171_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭਈ ਇੰਦ੍ਰ ਕੀ ਰਾਜਧਾਨੀ ਬਿਨਾਸੰ ॥",
      "transliteration": "bhiee i(n)dhr kee raajadhaanee binaasa(n) ||",
      "translation": "There was no position of gods in the Yajnas of king Bali and the capital of Indra was also destroyed.",
      "punjabiViakhya": "ਇੰਦਰ ਦੀ ਰਾਜਧਾਨੀ ਨਸ਼ਟ ਹੋ ਗਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "भई इंद्र की राजधानी बिनासं ॥",
      "sourceLineId": "82451",
      "sourceShabadId": "7814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਰੀ ਜੋਗ ਅਰਾਧਨਾ ਸਰਬ ਦੇਵੰ ॥",
      "transliteration": "karee jog araadhanaa sarab dheva(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਦੇਵਤਿਆਂ ਨੇ ਯੋਗ ਆਰਾਧਨਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "करी जोग अराधना सरब देवं ॥",
      "sourceLineId": "82452",
      "sourceShabadId": "7814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪ੍ਰਸੰਨੰ ਭਏ ਕਾਲ ਪੁਰਖੰ ਅਭੇਵੰ ॥੨॥",
      "transliteration": "prasa(n)na(n) bhe kaal purakha(n) abheva(n) ||2||",
      "translation": "In great agony, all the gods meditated on the Lord, by which the Supreme Destroyer Purusha was pleased.2.",
      "punjabiViakhya": "(ਜਿਸ ਦੇ ਫਲਸਰੂਪ) ਅਭੇਵ ਰੂਪ ਵਾਲੇ 'ਕਾਲ ਪੁਰਖ' ਪ੍ਰਸੰਨ ਹੋਏ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "प्रसंनं भए काल पुरखं अभेवं ॥२॥",
      "sourceLineId": "82453",
      "sourceShabadId": "7814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦੀਯੋ ਆਇਸੰ ਕਾਲਪੁਰਖੰ ਅਪਾਰੰ ॥",
      "transliteration": "dheeyo aaisa(n) kaalapurakha(n) apaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਪਾਰ 'ਕਾਲ ਪੁਰਖ' ਨੇ ਵਿਸ਼ਣੂ ਨੂੰ ਅਗਿਆ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "दीयो आइसं कालपुरखं अपारं ॥",
      "sourceLineId": "82454",
      "sourceShabadId": "7814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਧਰੋ ਬਾਵਨਾ ਬਿਸਨੁ ਅਸਟਮ ਵਤਾਰੰ ॥",
      "transliteration": "dharo baavanaa bisan asaTam vataara(n) ||",
      "translation": "The Non-temporal Lord asked Vishnu out of all gods to assume his eighth manifestation in the form of Vaman incarnation.",
      "punjabiViakhya": "ਕਿ ਉਹ ਹੁਣ ਅੱਠਵਾ ਅਵਤਾਰ ਧਾਰਨ ਕਰੇ।",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "धरो बावना बिसनु असटम वतारं ॥",
      "sourceLineId": "82455",
      "sourceShabadId": "7814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਲਈ ਬਿਸਨੁ ਆਗਿਆ ਚਲਿਯੋ ਧਾਇ ਐਸੇ ॥",
      "transliteration": "liee bisan aagiaa chaliyo dhai aaise ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਸ਼ਣੂ ਆਗਿਆ ਲੈ ਕੇ ਇੰਜ ਧਾਈ ਕਰ ਕੇ ਚਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "लई बिसनु आगिआ चलियो धाइ ऐसे ॥",
      "sourceLineId": "82456",
      "sourceShabadId": "7814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਲਹਿਯੋ ਦਾਰਦੀ ਭੂਪ ਭੰਡਾਰ ਜੈਸੇ ॥੩॥",
      "transliteration": "lahiyo dhaaradhee bhoop bha(n)ddaar jaise ||3||",
      "translation": "Vishnu after seeking permission of the Lord, moved like a servant at the command of a king.3.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕੰਗਲੇ ਨੂੰ ਸ਼ਾਹੀ ਖ਼ਜ਼ਾਨਾ ਮਿਲ ਗਿਆ ਹੁੰਦਾ ਹੈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "लहियो दारदी भूप भंडार जैसे ॥३॥",
      "sourceLineId": "82457",
      "sourceShabadId": "7814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "naraaj chha(n)dh ||",
      "translation": "NARAAJ STANZA",
      "punjabiViakhya": "ਨਰਾਜ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "नराज छंद ॥",
      "sourceLineId": "82458",
      "sourceShabadId": "7815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਰੂਪ ਛੋਟ ਧਾਰਿ ਕੈ ॥",
      "transliteration": "saroop chhoT dhaar kai ||",
      "translation": "",
      "punjabiViakhya": "(ਵਿਸ਼ਣੂ ਬ੍ਰਾਹਮਣ ਦਾ) ਛੋਟਾ ਜਿਹਾ ਰੂਪ ਧਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "सरूप छोट धारि कै ॥",
      "sourceLineId": "82459",
      "sourceShabadId": "7815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚਲਿਯੋ ਤਹਾ ਬਿਚਾਰਿ ਕੈ ॥",
      "transliteration": "chaliyo tahaa bichaar kai ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਚਾਰ-ਪੂਰਵਕ ਉਥੋਂ ਚਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "चलियो तहा बिचारि कै ॥",
      "sourceLineId": "82460",
      "sourceShabadId": "7815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਭਾ ਨਰੇਸ ਜਾਨ੍ਯੋ ॥",
      "transliteration": "sabhaa nares jaanayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦੇ ਦਰਬਾਰ ਨੂੰ ਜਾਣਨ ਉਪਰੰਤ",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "सभा नरेस जान्यो ॥",
      "sourceLineId": "82461",
      "sourceShabadId": "7815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਹੀ ਸੁ ਪਾਵ ਠਾਨ੍ਰਯੋ ॥੪॥",
      "transliteration": "tahee su paav Thaanrayo ||4||",
      "translation": "He transformed himself ad a dwarf and after some reflection, he moved towards the court of the king Bali, where, on reaching, he stood firmly.4.",
      "punjabiViakhya": "ਉਥੇ ਪੈਰ ਗਡ ਦਿੱਤੇ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "तही सु पाव ठान्रयो ॥४॥",
      "sourceLineId": "82462",
      "sourceShabadId": "7815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੁ ਬੇਦ ਚਾਰ ਉਚਾਰ ਕੈ ॥",
      "transliteration": "s bedh chaar uchaar kai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਬ੍ਰਾਹਮਣ ਨੇ) ਚੌਹਾ ਵੇਦਾ ਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਉਚਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "सु बेद चार उचार कै ॥",
      "sourceLineId": "82463",
      "sourceShabadId": "7815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੁਣ੍ਯੋ ਨ੍ਰਿਪੰ ਸੁਧਾਰ ਕੈ ॥",
      "transliteration": "sunayo nirapa(n) sudhaar kai ||",
      "translation": "This Brahmin recited all the four Vedas, which the king listened to attentively.",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਸੁਣਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "सुण्यो नृपं सुधार कै ॥",
      "sourceLineId": "82464",
      "sourceShabadId": "7815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬੁਲਾਇ ਬਿਪੁ ਕੋ ਲਯੋ ॥",
      "transliteration": "bulai bip ko layo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਬ੍ਰਾਹਮਣ ਨੂੰ (ਆਪਣੇ ਕੋਲ) ਬੁਲਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "बुलाइ बिपु को लयो ॥",
      "sourceLineId": "82465",
      "sourceShabadId": "7815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਲਯਾਗਰ ਮੂੜਕਾ ਦਯੋ ॥੫॥",
      "transliteration": "malayaagar mooRakaa dhayo ||5||",
      "translation": "The king Bali then called the Brahmin and got him seated respectfully on a seat of sandalwood.5.",
      "punjabiViakhya": "ਅਤੇ ਚੰਦਨ ਦੀ ਲਕੜੀ ਦੀ ਬਣੀ ਪੀੜ੍ਰਹੀ (ਬੈਠਣ ਨੂੰ) ਦਿੱਤੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "मलयागर मूड़का दयो ॥५॥",
      "sourceLineId": "82466",
      "sourceShabadId": "7815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪਦਾਰਘ ਦੀਪ ਦਾਨ ਦੈ ॥",
      "transliteration": "padhaaragh dheep dhaan dhai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ ਬ੍ਰਾਹਮਣ ਦੇ) ਪੈਰ ਧੋਤੇ ਅਤੇ ਆਰਤੀ ਉਤਾਰੀ",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "पदारघ दीप दान दै ॥",
      "sourceLineId": "82467",
      "sourceShabadId": "7815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪ੍ਰਦਛਨਾ ਅਨੇਕ ਕੈ ॥",
      "transliteration": "pradhachhanaa anek kai ||",
      "translation": "The king quaffed the water, with which the feet of the Brahmin had been washed and offered charities.",
      "punjabiViakhya": "ਤੇ ਅਨੇਕ ਵਾਰ ਪ੍ਰਦਖਣਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "प्रदछना अनेक कै ॥",
      "sourceLineId": "82468",
      "sourceShabadId": "7815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਰੋਰਿ ਦਛਨਾ ਦਈ ॥",
      "transliteration": "karor dhachhanaa dhiee ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਕਰੋੜਾ ਦੱਛਣਾ ਦਿੱਤੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "करोरि दछना दई ॥",
      "sourceLineId": "82469",
      "sourceShabadId": "7815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨ ਹਾਥਿ ਬਿਪ ਨੈ ਲਈ ॥੬॥",
      "transliteration": "n haath bip nai liee ||6||",
      "translation": "Then he circumambulated around the Brahmin several times, after that the king offered millions of charities, but the Brahmin did not touch anything with his hand.6.",
      "punjabiViakhya": "(ਪਰ) ਬ੍ਰਾਹਮਣ ਨੇ (ਕਿਸੇ ਨੂੰ) ਹੱਥ ਤਕ ਨਾ ਲਾਇਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "न हाथि बिप नै लई ॥६॥",
      "sourceLineId": "82470",
      "sourceShabadId": "7815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਹਿਯੋ ਨ ਮੋਰ ਕਾਜ ਹੈ ॥",
      "transliteration": "kahiyo na mor kaaj hai ||",
      "translation": "",
      "punjabiViakhya": "(ਬ੍ਰਾਹਮਣ ਨੇ) ਕਿਹਾ ਕਿ ਇਹ ਮੇਰੇ ਕਿਸੇ ਕੰਮ ਨਹੀਂ।",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "कहियो न मोर काज है ॥",
      "sourceLineId": "82471",
      "sourceShabadId": "7815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਿਥ੍ਯਾ ਇਹ ਤੋਰ ਸਾਜ ਹੈ ॥",
      "transliteration": "mithayaa ieh tor saaj hai ||",
      "translation": "The Brahmin said that all those things were of no use to him and all the ostentations offered by the king were false.",
      "punjabiViakhya": "ਇਹ ਤੇਰੇ (ਸਾਰੇ) ਸਾਜ ਮਿਥਿਆ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "मिथ्या इह तोर साज है ॥",
      "sourceLineId": "82472",
      "sourceShabadId": "7815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਢਾਇ ਪਾਵ ਭੂਮਿ ਦੈ ॥",
      "transliteration": "addai paav bhoom dhai ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਨੂੰ) ਢਾਈ ਕਦਮ ਭੂਮੀ ਪ੍ਰਦਾਨ ਕਰ।",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "अढाइ पाव भूमि दै ॥",
      "sourceLineId": "82473",
      "sourceShabadId": "7815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਸੇਖ ਪੂਰ ਕੀਰਤਿ ਲੈ ॥੭॥",
      "transliteration": "basekh poor keerat lai ||7||",
      "translation": "He then asked him to give only two and a half steps of the earth  and accept the special eulogy.7.",
      "punjabiViakhya": "ਉਸ (ਦੇ ਫਲ ਵਜੋਂ) ਹੇ ਰਾਜਨ! ਵਿਸ਼ੇਸ਼ ਯਸ਼ ਅਰਜਿਤ ਕਰ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "बसेख पूर कीरति लै ॥७॥",
      "sourceLineId": "82474",
      "sourceShabadId": "7815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "82475",
      "sourceShabadId": "7816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਬ ਦਿਜ ਐਸ ਬਖਾਨੀ ਬਾਨੀ ॥",
      "transliteration": "jab dhij aais bakhaanee baanee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਬ੍ਰਾਹਮਣ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਗੱਲ ਕਹੀ,",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "जब दिज ऐस बखानी बानी ॥",
      "sourceLineId": "82476",
      "sourceShabadId": "7816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਭੂਪਤਿ ਸਹਤ ਨ ਜਾਨ੍ਯੋ ਰਾਨੀ ॥",
      "transliteration": "bhoopat sahat na jaanayo raanee ||",
      "translation": "When the Brahmin uttered these words, the king along with the queen could not understand its import.",
      "punjabiViakhya": "(ਤਾ) ਰਾਣੀ ਸਮੇਤ ਰਾਜੇ ਨੇ (ਇਸ ਦੇ ਭੇਦ ਨੂੰ) ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "भूपति सहत न जान्यो रानी ॥",
      "sourceLineId": "82477",
      "sourceShabadId": "7816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪੈਰ ਅਢਾਇ ਭੂੰਮਿ ਦੇ ਕਹੀ ॥",
      "transliteration": "pair addai bhoo(n)m dhe kahee ||",
      "translation": "",
      "punjabiViakhya": "(ਸ੍ਰੇਸ਼ਠ ਬ੍ਰਾਹਮਣ ਨੇ) ਢਾਈ ਕਦਮ ਦੇਣ ਲਈ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "पैर अढाइ भूँमि दे कही ॥",
      "sourceLineId": "82478",
      "sourceShabadId": "7816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦ੍ਰਿੜ ਕਰਿ ਬਾਤ ਦਿਜੋਤਮ ਗਹੀ ॥੮॥",
      "transliteration": "dhiraR kar baat dhijotam gahee ||8||",
      "translation": "That Brahmin again said the same thing with determination that he had asked only for two and a half steps of the earth.8.",
      "punjabiViakhya": "(ਉਸ ਗੱਲ ਨੂੰ) ਦ੍ਰਿੜ੍ਰਹਤਾ ਪੂਰਵਕ ਫੜ ਲਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "दृड़ करि बात दिजोतम गही ॥८॥",
      "sourceLineId": "82479",
      "sourceShabadId": "7816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦਿਜਬਰ ਸੁਕ੍ਰ ਹੁਤੋ ਨ੍ਰਿਪ ਤੀਰਾ ॥",
      "transliteration": "dhijabar sukr huto nirap teeraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵੇਲੇ ਰਾਜ-ਪੁਰੋਹਿਤ ਸ਼ੁਕ੍ਰਾਚਾਰਯ ਰਾਜੇ ਕੋਲ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "दिजबर सुक्र हुतो नृप तीरा ॥",
      "sourceLineId": "82480",
      "sourceShabadId": "7816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਾਨ ਗਯੋ ਸਭ ਭੇਦੁ ਵਜੀਰਾ ॥",
      "transliteration": "jaan gayo sabh bhedh vajeeraa ||",
      "translation": "Shukracharya, the preceptor of the king was with him at that time, and he alongwith all the ministers comprehended the mystery of asking only for earth.",
      "punjabiViakhya": "(ਉਹ ਵਜ਼ੀਰ ਰੂਪ ਪੁਰੋਹਿਤ) ਸਾਰਾ ਭੇਦ ਸਮਝ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "जान गयो सभ भेदु वजीरा ॥",
      "sourceLineId": "82481",
      "sourceShabadId": "7816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਿਯੋ ਜਿਯੋ ਦੇਨ ਪ੍ਰਿਥਵੀ ਨ੍ਰਿਪ ਕਹੈ ॥",
      "transliteration": "jiyo jiyo dhen pirathavee nirap kahai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਜਿਵੇਾਂ ਰਾਜਾ ਪ੍ਰਿਥਵੀ ਦੇਣ ਦੀ ਗੱਲ ਕਹਿੰਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "जियो जियो देन पृथवी नृप कहै ॥",
      "sourceLineId": "82482",
      "sourceShabadId": "7816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਿਮੁ ਤਿਮੁ ਨਾਹਿ ਪੁਰੋਹਿਤ ਗਹੈ ॥੯॥",
      "transliteration": "tim tim naeh purohit gahai ||9||",
      "translation": "As many times the king orders for the donation of the earth, for so many times the preceptor Shukracharya asks him not to agree to it.9.",
      "punjabiViakhya": "ਤਿਵੇਾਂ ਤਿਵੇਾਂ ਪੁਰੋਹਿਤ ਨਾਹ ਨਾਹ ਕਹੀ ਜਾਦਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "तिमु तिमु नाहि पुरोहित गहै ॥९॥",
      "sourceLineId": "82483",
      "sourceShabadId": "7816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਬ ਨ੍ਰਿਪ ਦੇਨ ਧਰਾ ਮਨੁ ਕੀਨਾ ॥",
      "transliteration": "jab nirap dhen dharaa man keenaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਰਾਜੇ ਨੇ ਧਰਤੀ ਦੇਣ ਦਾ ਮਨ ਬਣਾਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "जब नृप देन धरा मनु कीना ॥",
      "sourceLineId": "82484",
      "sourceShabadId": "7816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਬ ਹੀ ਉਤਰ ਸੁਕ੍ਰ ਇਮ ਦੀਨਾ ॥",
      "transliteration": "tab hee utar sukr im dheenaa ||",
      "translation": "But when the king made up his mind firmly to give the required earth as alms, then Shukracharya giving his reply said this to the king,",
      "punjabiViakhya": "ਤਦੋਂ ਸ਼ੁਕ੍ਰਾਚਾਰਯ ਨੇ ਇੰਜ ਉੱਤਰ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "तब ही उतर सुक्र इम दीना ॥",
      "sourceLineId": "82485",
      "sourceShabadId": "7816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਲਘੁ ਦਿਜ ਯਾਹਿ ਨ ਭੂਪ ਪਛਾਨੋ ॥",
      "transliteration": "lagh dhij yaeh na bhoop pachhaano ||",
      "translation": "",
      "punjabiViakhya": "\"ਹੇ ਰਾਜਨ! ਇਸ ਨੂੰ ਨਿੱਕਾ ਜਿਹਾ ਬ੍ਰਾਹਮਣ ਨਾ ਸਮਝੋ,",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "लघु दिज याहि न भूप पछानो ॥",
      "sourceLineId": "82486",
      "sourceShabadId": "7816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਿਸਨੁ ਅਵਤਾਰ ਇਸੀ ਕਰਿ ਮਾਨੋ ॥੧੦॥",
      "transliteration": "bisan avataar isee kar maano ||10||",
      "translation": "“O king! do not consider him a small-sized Brahmin, consider him only as an incarnation of Vishnu.”10.",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਵਿਸ਼ਣੂ ਦਾ ਅਵਤਾਰ ਕਰ ਕੇ ਮੰਨੋ\" ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "बिसनु अवतार इसी करि मानो ॥१०॥",
      "sourceLineId": "82487",
      "sourceShabadId": "7816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੁਨਤ ਬਚਨ ਦਾਨਵ ਸਭ ਹਸੇ ॥",
      "transliteration": "sunat bachan dhaanav sabh hase ||",
      "translation": "",
      "punjabiViakhya": "(ਸ਼ੁਕ੍ਰਾਚਾਰਯ ਦੀ ਗੱਲ ਸੁਣ ਕੇ) ਸਾਰੇ ਦੈਂਤ ਹਸਣ ਲਗ ਪਏ",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "सुनत बचन दानव सभ हसे ॥",
      "sourceLineId": "82488",
      "sourceShabadId": "7816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਉਚਰਤ ਸੁਕ੍ਰ ਕਹਾ ਘਰਿ ਬਸੇ ॥",
      "transliteration": "aucharat sukr kahaa ghar base ||",
      "translation": "Hearing this, all the demons laughed and said: “Shukracharya is only thinking of useless thing,”",
      "punjabiViakhya": "ਅਤੇ ਕਹਿਣ ਲਗੇ, ਸ਼ੁਕ੍ਰ ਜੀ! (ਤੁਹਾਡੀ ਸੁਰਤ) ਕਿਸ ਥਾ ਟਿਕੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "उचरत सुक्र कहा घरि बसे ॥",
      "sourceLineId": "82489",
      "sourceShabadId": "7816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਸਿਕ ਸਮਾਨ ਨ ਦਿਜ ਮਹਿ ਮਾਸਾ ॥",
      "transliteration": "sasik samaan na dhij meh maasaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਬ੍ਰਾਹਮਣ ਵਿਚ ਸਹੇ ਜਿੰਨਾ ਵੀ ਮਾਸ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "ससिक समान न दिज महि मासा ॥",
      "sourceLineId": "82490",
      "sourceShabadId": "7816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਸ ਕਰਹੈ ਇਹ ਜਗ ਬਿਨਾਸਾ ॥੧੧॥",
      "transliteration": "kas karahai ieh jag binaasaa ||11||",
      "translation": "“The Brahmin, whose body does not contain the flesh more than a rabbit, how can he destroy the world?”11.",
      "punjabiViakhya": "ਇਹ ਕਿਸ ਤਰ੍ਰਹਾ ਯੱਗ ਦਾ ਨਾਸ਼ ਕਰ ਦੇਵੇਗਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "कस करहै इह जग बिनासा ॥११॥",
      "sourceLineId": "82491",
      "sourceShabadId": "7816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "82492",
      "sourceShabadId": "7817",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੁਕ੍ਰੋਬਾਚ ॥",
      "transliteration": "sukrobaach ||",
      "translation": "Shukracharya said :",
      "punjabiViakhya": "ਸ਼ੁਕ੍ਰ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "सुक्रोबाच ॥",
      "sourceLineId": "82493",
      "sourceShabadId": "7817",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਮ ਚਿਨਗਾਰੀ ਅਗਨਿ ਕੀ ਗਿਰਤ ਸਘਨ ਬਨ ਮਾਹਿ ॥",
      "transliteration": "jim chinagaaree agan kee girat saghan ban maeh ||",
      "translation": "“The manner in which only a spark of fire, falling down, grows immensely in stature",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਜਿਵੇਾਂ ਅਗਨੀ ਦੀ ਨਿੱਕੀ ਜਿਹੀ ਚਿੰਗਾਰੀ ਸੰਘਣੇ ਬਨ ਵਿਚ ਡਿਗ ਪਏ,",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "जिम चिनगारी अगनि की गिरत सघन बन माहि ॥",
      "sourceLineId": "82494",
      "sourceShabadId": "7817",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਧਿਕ ਤਨਿਕ ਤੇ ਹੋਤ ਹੈ ਤਿਮ ਦਿਜਬਰ ਨਰ ਨਾਹਿ ॥੧੨॥",
      "transliteration": "adhik tanik te hot hai tim dhijabar nar naeh ||12||",
      "translation": "“Likewise this small-sized Brahmin is not a man.”12.",
      "punjabiViakhya": "ਉਹ ਥੋੜੀ ਤੋਂ ਜ਼ਿਆਦਾ ਹੋ ਜਾਦੀ ਹੈ, ਉਸੇ ਤਰ੍ਰਹਾ (ਦੀ ਸਥਿਤੀ) ਇਸ ਬ੍ਰਾਹਮਣ ਦੀ ਹੈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "अधिक तनिक ते होत है तिम दिजबर नर नाहि ॥१२॥",
      "sourceLineId": "82495",
      "sourceShabadId": "7817",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "82496",
      "sourceShabadId": "7818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਸਿ ਭੂਪਤਿ ਇਹ ਬਾਤ ਬਖਾਨੀ ॥",
      "transliteration": "has bhoopat ieh baat bakhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਬਲੀ ਰਾਜੇ ਨੇ ਹਸ ਕੇ ਇਹ ਗੱਲ ਕਹੀ,",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "हसि भूपति इह बात बखानी ॥",
      "sourceLineId": "82497",
      "sourceShabadId": "7818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0171_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੁਨਹੋ ਸੁਕ੍ਰ ਤੁਮ ਬਾਤ ਨ ਜਾਨੀ ॥",
      "transliteration": "sunaho sukr tum baat na jaanee ||",
      "translation": "The king Bali, laughingly, said these words to Shukracharya: “O Shukracharya! You are not comprehending it, I shall not regain such an occasion,",
      "punjabiViakhya": "\"ਹੇ ਸ਼ੁਕ੍ਰ! ਸੁਣ, ਤੂੰ ਇਸ ਗੱਲ ਦਾ ਭੇਦ ਨਹੀਂ ਪਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 171,
      "hindi": "",
      "hindiTransliteration": "सुनहो सुक्र तुम बात न जानी ॥",
      "sourceLineId": "82498",
      "sourceShabadId": "7818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
