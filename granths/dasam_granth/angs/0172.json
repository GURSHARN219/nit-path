{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 172,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0172_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਫੁਨਿ ਇਹ ਸਮੋ ਸਭੋ ਛਲ ਜੈ ਹੈ ॥",
      "transliteration": "fun ieh samo sabho chhal jai hai ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਸਮਾ ਫਿਰ ਹੱਥੋਂ ਨਿਕਲ ਜਾਵੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "फुनि इह समो सभो छल जै है ॥",
      "sourceLineId": "82499",
      "sourceShabadId": "7818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਹਰਿ ਸੋ ਫੇਰਿ ਨ ਭਿਛਕ ਐ ਹੈ ॥੧੩॥",
      "transliteration": "har so fer na bhichhak aai hai ||13||",
      "translation": "“Because I shall not be able to get such a God-like beggar again.”13.",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ) ਹਰਿ ਵਰਗਾ ਕੋਈ ਮੰਗਤਾ ਮੁੜ ਕੇ ਨਹੀਂ ਆ ਸਕੇਗਾ\" ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "हरि सो फेरि न भिछक ऐ है ॥१३॥",
      "sourceLineId": "82500",
      "sourceShabadId": "7818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਨ ਮਹਿ ਬਾਤ ਇਹੈ ਠਹਰਾਈ ॥",
      "transliteration": "man meh baat ihai Thaharaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਮਨ ਵਿਚ ਇਹ ਧਾਰਨਾ ਬਣਾ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "मन महि बात इहै ठहराई ॥",
      "sourceLineId": "82501",
      "sourceShabadId": "7818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਨ ਮੋ ਧਰੀ ਨ ਕਿਸੂ ਬਤਾਈ ॥",
      "transliteration": "man mo dharee na kisoo bataiee ||",
      "translation": "The King decided this general notion in his mind, but perceptibly he did not divulge it to anyone.",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਮਨ ਵਿਚ ਹੀ ਰਖੀ, ਕਿਸੇ ਨੂੰ ਵੀ ਨਾ ਦਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "मन मो धरी न किसू बताई ॥",
      "sourceLineId": "82502",
      "sourceShabadId": "7818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭ੍ਰਿਤ ਤੇ ਮਾਗ ਕਮੰਡਲ ਏਸਾ ॥",
      "transliteration": "bhirat te maag kama(n)ddal esaa ||",
      "translation": "",
      "punjabiViakhya": "ਨੌਕਰ ਤੋਂ ਜਲ ਦਾ ਕਮੰਡਲ ਮੰਗਵਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "भृत ते माग कमंडल एसा ॥",
      "sourceLineId": "82503",
      "sourceShabadId": "7818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਲਗ੍ਯੋ ਦਾਨ ਤਿਹ ਦੇਨ ਨਰੇਸਾ ॥੧੪॥",
      "transliteration": "lagayo dhaan teh dhen naresaa ||14||",
      "translation": "He asked the medicant to give his pot, in order to enact such a base deed.14.",
      "punjabiViakhya": "ਰਾਜਾ ਦਾਨ ਦੇਣ ਲਗਿਆ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "लग्यो दान तिह देन नरेसा ॥१४॥",
      "sourceLineId": "82504",
      "sourceShabadId": "7818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੁਕ੍ਰ ਬਾਤ ਮਨ ਮੋ ਪਹਿਚਾਨੀ ॥",
      "transliteration": "sukr baat man mo pahichaanee ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੁਕ੍ਰਾਚਾਰਯ ਨੇ (ਇਸ) ਗੱਲ ਨੂੰ ਮਨ ਵਿਚ ਸਮਝ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "सुक्र बात मन मो पहिचानी ॥",
      "sourceLineId": "82505",
      "sourceShabadId": "7818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭੇਦ ਨ ਲਹਤ ਭੂਪ ਅਗਿਆਨੀ ॥",
      "transliteration": "bhedh na lahat bhoop agiaanee ||",
      "translation": "Shukracharya understood the notion of the mind of the King, but the ignorant King could not comprehend it.",
      "punjabiViakhya": "(ਅਤੇ ਵਿਚਾਰਨ ਲਗਾ ਕਿ) ਨਾਮਸਮਝ ਰਾਜਾ ਇਸ ਭੇਦ ਨੂੰ ਨਹੀਂ ਜਾਣਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "भेद न लहत भूप अगिआनी ॥",
      "sourceLineId": "82506",
      "sourceShabadId": "7818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਧਾਰਿ ਮਕਰਿ ਕੇ ਜਾਰ ਸਰੂਪਾ ॥",
      "transliteration": "dhaar makar ke jaar saroopaa ||",
      "translation": "",
      "punjabiViakhya": "(ਸ਼ੁਕ੍ਰਾਚਾਰਯ ਨੇ) ਮਕੜੀ ਦੇ ਜਾਲੇ ਦਾ ਰੂਪ ਧਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "धारि मकरि के जार सरूपा ॥",
      "sourceLineId": "82507",
      "sourceShabadId": "7818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪੈਠਿਯੋ ਮਧ ਕਮੰਡਲ ਭੂਪਾ ॥੧੫॥",
      "transliteration": "paiThiyo madh kama(n)ddal bhoopaa ||15||",
      "translation": "Shukracharya transformed himself into a small fish and seated himself in the mendicant’s pot.15.",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਦੇ ਕਮੰਡਲ ਦੀ ਟੂਟੀ ਵਿਚ ਬੈਠ ਗਿਆ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "पैठियो मध कमंडल भूपा ॥१५॥",
      "sourceLineId": "82508",
      "sourceShabadId": "7818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨ੍ਰਿਪ ਬਰ ਪਾਨਿ ਸੁਰਾਹੀ ਲਈ ॥",
      "transliteration": "nirap bar paan suraahee liee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਆਪਣੇ ਹੱਥ ਵਿਚ ਕਮੰਡਲ ਫੜ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "नृप बर पानि सुराही लई ॥",
      "sourceLineId": "82509",
      "sourceShabadId": "7818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦਾਨ ਸਮੈ ਦਿਜਬਰ ਕੀ ਭਈ ॥",
      "transliteration": "dhaan samai dhijabar kee bhiee ||",
      "translation": "The King took the mendicant’s pot in his hand and the time forgiving alms to the Brahmin arrived.",
      "punjabiViakhya": "ਬ੍ਰਾਹਮਣ ਨੂੰ ਦਾਨ ਦੇਣ ਦੀ ਘੜੀ ਆ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "दान समै दिजबर की भई ॥",
      "sourceLineId": "82510",
      "sourceShabadId": "7818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦਾਨ ਹੇਤ ਜਬ ਹਾਥ ਚਲਾਯੋ ॥",
      "transliteration": "dhaan het jab haath chalaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਰਾਜੇ ਨੇ ਦਾਨ ਦੇਣ ਲਈ ਹੱਥ ਅਗੇ ਕੀਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "दान हेत जब हाथ चलायो ॥",
      "sourceLineId": "82511",
      "sourceShabadId": "7818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਿਕਸ ਨੀਰ ਕਰਿ ਤਾਹਿ ਨ ਆਯੋ ॥੧੬॥",
      "transliteration": "nikas neer kar taeh na aayo ||16||",
      "translation": "When the King in order to give alms took some water in his hand, no water came out of the pot.16.",
      "punjabiViakhya": "ਪਰ ਕਮੰਡਲ ਵਿਚੋਂ ਪਾਣੀ ਨਿਕਲ ਕੇ (ਰਾਜੇ ਦੇ) ਹੱਥ ਵਿਚ ਨਾ ਆਇਆ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "निकस नीर करि ताहि न आयो ॥१६॥",
      "sourceLineId": "82512",
      "sourceShabadId": "7818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤੋਮਰ ਛੰਦ ॥",
      "transliteration": "tomar chha(n)dh ||",
      "translation": "TOMAR STANZA",
      "punjabiViakhya": "ਤੋਮਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "तोमर छंद ॥",
      "sourceLineId": "82513",
      "sourceShabadId": "7819",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚਮਕ੍ਯੋ ਤਬੈ ਦਿਜਰਾਜ ॥",
      "transliteration": "chamakayo tabai dhijaraaj ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਸ੍ਰੇਸ਼ਠ ਬ੍ਰਾਹਮਣ ਭੜਕ ਉਠਿਆ (ਅਤੇ ਕਹਿਣ ਲਗਾ)",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "चमक्यो तबै दिजराज ॥",
      "sourceLineId": "82514",
      "sourceShabadId": "7819",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਰੀਐ ਨ੍ਰਿਪੇਸੁ ਇਲਾਜ ॥",
      "transliteration": "kareeaai nirapes ilaaj ||",
      "translation": "Then the Brahmin became furious and told the King to check up the por.",
      "punjabiViakhya": "\"ਰਾਜਨ! ਇਸ ਦਾ ਉਪਾ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "करीऐ नृपेसु इलाज ॥",
      "sourceLineId": "82515",
      "sourceShabadId": "7819",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਿਨਕਾ ਮਿਲੈ ਇਹ ਬੀਚਿ ॥",
      "transliteration": "tinakaa milai ieh beech ||",
      "translation": "",
      "punjabiViakhya": "\"(ਬ੍ਰਾਮਹਣ ਨੇ ਮਨ ਵਿਚ ਵਿਚਾਰ ਕੀਤਾ ਕਿ ਜੇ) ਟੂਟੀ ਵਿਚ ਤੀਲਾ ਫੇਰਿਆ ਜਾਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "तिनका मिलै इह बीचि ॥",
      "sourceLineId": "82516",
      "sourceShabadId": "7819",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਇਕ ਚਛ ਹੁਐ ਹੈ ਨੀਚ ॥੧੭॥",
      "transliteration": "eik chachh huaai hai neech ||17||",
      "translation": "The pipe of the pot was searched with a straw and with this search one eye of Shukracharya was lost.17.",
      "punjabiViakhya": "ਤਾ ਦੁਸ਼ਟ (ਸ਼ੁਕ੍ਰਾਚਾਰਯ) ਇਕ ਅੱਖ ਵਾਲਾ ਹੋ ਜਾਏਗਾ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "इक चछ हुऐ है नीच ॥१७॥",
      "sourceLineId": "82517",
      "sourceShabadId": "7819",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਿਨੁਕਾ ਨ੍ਰਿਪਤ ਕਰਿ ਲੀਨ ॥",
      "transliteration": "tinukaa nirapat kar leen ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਹੱਥ ਵਿਚ ਤੀਲਾ ਫੜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "तिनुका नृपत करि लीन ॥",
      "sourceLineId": "82518",
      "sourceShabadId": "7819",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭੀਤਰ ਕਮੰਡਲ ਦੀਨ ॥",
      "transliteration": "bheetar kama(n)ddal dheen ||",
      "translation": "The King took the straw in his hand and revolved it within the pot.",
      "punjabiViakhya": "ਅਤੇ ਕਮੰਡਲ (ਦੀ ਟੂਟੀ ਵਿਚ) ਫੇਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "भीतर कमंडल दीन ॥",
      "sourceLineId": "82519",
      "sourceShabadId": "7819",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੁਕ੍ਰ ਆਖਿ ਲਗੀਆ ਜਾਇ ॥",
      "transliteration": "sukr aakh lageeaa jai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸ਼ੁਕ੍ਰਾਚਾਰਯ ਦੀ ਅੱਖ ਵਿਚ ਜਾ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "सुक्र आखि लगीआ जाइ ॥",
      "sourceLineId": "82520",
      "sourceShabadId": "7819",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇਕ ਚਛ ਭਯੋ ਦਿਜ ਰਾਇ ॥੧੮॥",
      "transliteration": "eik chachh bhayo dhij rai ||18||",
      "translation": "It pierced the eye of Shukrachraya and thus one eye of the preceptor Shukraccharya was lost.18.",
      "punjabiViakhya": "(ਉਸ ਨਾਲ) ਸ਼ੁਕ੍ਰਾਚਾਰਯ ਇਕ ਅੱਖ ਵਾਲਾ ਹੋ ਗਿਆ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "इक चछ भयो दिज राइ ॥१८॥",
      "sourceLineId": "82521",
      "sourceShabadId": "7819",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0172_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨੇਤ੍ਰ ਤੇ ਜੁ ਗਿਰਿਯੋ ਨੀਰ ॥",
      "transliteration": "netr te ju giriyo neer ||",
      "translation": "",
      "punjabiViakhya": "(ਸ਼ੁਕ੍ਰ ਦੀ) ਅੱਖ ਤੋਂ ਜੋ ਜਲ ਨਿਕਲਿਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 172,
      "hindi": "",
      "hindiTransliteration": "नेत्र ते जु गिरियो नीर ॥",
      "sourceLineId": "82522",
      "sourceShabadId": "7819",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
