{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 173,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0173_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੋਈ ਲੀਯੋ ਕਰਿ ਦਿਜ ਬੀਰ ॥",
      "transliteration": "soiee leeyo kar dhij beer ||",
      "translation": "The water that oozed out from the eye of Shukracharya, the King took it in his hand.",
      "punjabiViakhya": "ਉਹੀ (ਉਸ) ਸ੍ਰੇਸ਼ਠ ਬ੍ਰਾਹਮਣ ਨੇ ਲੈ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "सोई लीयो करि दिज बीर ॥",
      "sourceLineId": "82523",
      "sourceShabadId": "7819",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਰਿ ਨੀਰ ਚੁਵਨ ਨ ਦੀਨ ॥",
      "transliteration": "kar neer chuvan na dheen ||",
      "translation": "",
      "punjabiViakhya": "(ਸ਼ੁਕ੍ਰ ਨੇ ਆਪਣੀ ਅੱਖ ਅੰਨ੍ਰਹੀ) ਕਰਵਾ ਲਈ, ਪਰ ਪਾਣੀ ਨਾ ਚੋਣ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "करि नीर चुवन न दीन ॥",
      "sourceLineId": "82524",
      "sourceShabadId": "7819",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਇਮ ਸੁਆਮਿ ਕਾਰਜ ਕੀਨ ॥੧੯॥",
      "transliteration": "eim suaam kaaraj keen ||19||",
      "translation": "Shukracharya did not allow the water to leak and in this way, tried to protect his master from destruction.19.",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਆਪਣੇ ਸੁਆਮੀ ਦਾ ਕਾਰਜ ਕੀਤਾ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "इम सुआमि कारज कीन ॥१९॥",
      "sourceLineId": "82525",
      "sourceShabadId": "7819",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "82526",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚਛ ਨੀਰ ਕਰ ਭੀਤਰ ਪਰਾ ॥",
      "transliteration": "chachh neer kar bheetar paraa ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਦੇ) ਹੱਥ ਵਿਚ ਅੱਖ ਦਾ ਪਾਣੀ ਪਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "चछ नीर कर भीतर परा ॥",
      "sourceLineId": "82527",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਵਹੈ ਸੰਕਲਪ ਦਿਜਹ ਕਰਿ ਧਰਾ ॥",
      "transliteration": "vahai sa(n)kalap dhijeh kar dharaa ||",
      "translation": "When the water (from the eye) oozed out on the hand of the King, he gave it as alms, notionally, on the hand of the Brahmin.",
      "punjabiViakhya": "ਉਸੇ ਨਾਲ ਬ੍ਰਾਹਮਣ ਨੂੰ (ਰਾਜੇ ਨੇ ਧਰਤੀ ਦਾ) ਸੰਕਲਪ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "वहै संकलप दिजह करि धरा ॥",
      "sourceLineId": "82528",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਐਸ ਤਬੈ ਨਿਜ ਦੇਹ ਬਢਾਯੋ ॥",
      "transliteration": "aais tabai nij dheh baddaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ (ਜਦ ਧਰਤੀ ਮਾਪਣ ਦਾ ਸਮਾ ਆਇਆ) ਤਦੋਂ (ਬ੍ਰਾਹਮਣ ਨੇ) ਆਪਣੀ ਦੇਹ ਵਧਾ ਲਈ,",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "ऐस तबै निज देह बढायो ॥",
      "sourceLineId": "82529",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਲੋਕ ਛੇਦਿ ਪਰਲੋਕਿ ਸਿਧਾਯੋ ॥੨੦॥",
      "transliteration": "lok chhedh paralok sidhaayo ||20||",
      "translation": "After this the dwarf expanded his body, which became so huge that it touched the heavens after penetrating through this world.20.",
      "punjabiViakhya": "ਜੇ ਇਸ ਲੋਕ ਨੂੰ ਲੰਘ ਕੇ ਪਰਲੋਕ ਤਕ ਜਾ ਪਹੁੰਚੀ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "लोक छेदि परलोकि सिधायो ॥२०॥",
      "sourceLineId": "82530",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਿਰਖ ਲੋਗ ਅਦਭੁਤ ਬਿਸਮਏ ॥",
      "transliteration": "nirakh log adhabhut bisame ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਅਦਭੁਤ (ਕੌਤਕ) ਵੇਖ ਕੇ ਲੋਕੀ ਹੈਰਾਨ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "निरख लोग अदभुत बिसमए ॥",
      "sourceLineId": "82531",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦਾਨਵ ਪੇਖਿ ਮੂਰਛਨ ਭਏ ॥",
      "transliteration": "dhaanav pekh moorachhan bhe ||",
      "translation": "Seeing this, al the people were wonder-struck and visualizing such a huge form of Vishnu, the demons became unconscious.",
      "punjabiViakhya": "ਅਤੇ ਦੈਂਤ ਵੇਖ ਕੇ ਮੂਰਛਿਤ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "दानव पेखि मूरछन भए ॥",
      "sourceLineId": "82532",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪਾਵ ਪਤਾਰ ਛੁਯੋ ਸਿਰ ਕਾਸਾ ॥",
      "transliteration": "paav pataar chhuyo sir kaasaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਵੇਲੇ ਬੌਣੇ ਬ੍ਰਾਹਮਣ) ਦੇ ਪੈਰ ਪਾਤਾਲ (ਵਿਚ ਸਨ ਅਤੇ) ਸਿਰ ਆਕਾਸ਼ ਨੂੰ ਛੋਹਣ ਲਗ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "पाव पतार छुयो सिर कासा ॥",
      "sourceLineId": "82533",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਚਕ੍ਰਿਤ ਭਏ ਲਖਿ ਲੋਕ ਤਮਾਸਾ ॥੨੧॥",
      "transliteration": "chakirat bhe lakh lok tamaasaa ||21||",
      "translation": "The feet of Vishnu touched the nether-worlds and the head touched the heavens  all were non-plussed on seeing this.21.",
      "punjabiViakhya": "ਇਹ ਤਮਾਸ਼ਾ ਵੇਖ ਕੇ ਲੋਕੀ ਹੈਰਾਨ ਹੋ ਗਏ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "चकृत भए लखि लोक तमासा ॥२१॥",
      "sourceLineId": "82534",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਏਕੈ ਪਾਵ ਪਤਾਰਹਿ ਛੂਆ ॥",
      "transliteration": "ekai paav pataareh chhooaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਪੈਰ (ਕਦਮ) ਨਾਲ ਪਾਤਾਲ ਛੋਹਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "एकै पाव पतारहि छूआ ॥",
      "sourceLineId": "82535",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੂਸਰ ਪਾਵ ਗਗਨ ਲਉ ਹੂਆ ॥",
      "transliteration": "dhoosar paav gagan lau hooaa ||",
      "translation": "With one step, he measured the nether-world and with the second step he measured the heavens.",
      "punjabiViakhya": "ਅਤੇ ਦੂਜਾ ਪੈਰ (ਕਦਮ) ਆਕਾਸ਼ ਤਕ ਪੂਰਾ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "दूसर पाव गगन लउ हूआ ॥",
      "sourceLineId": "82536",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਿਦਿਯੋ ਅੰਡ ਬ੍ਰਹਮੰਡ ਅਪਾਰਾ ॥",
      "transliteration": "bhidhiyo a(n)dd brahama(n)dd apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਪਾਰ ਅੰਡ ਰੂਪ ਬ੍ਰਹਮੰਡ (ਦੋ ਕਦਮਾ ਵਿਚ) ਮਿਣਿਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "भिदियो अंड ब्रहमंड अपारा ॥",
      "sourceLineId": "82537",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਿਹ ਤੇ ਗਿਰੀ ਗੰਗ ਕੀ ਧਾਰਾ ॥੨੨॥",
      "transliteration": "teh te giree ga(n)g kee dhaaraa ||22||",
      "translation": "In this way, Vishnu touched the whole universe and the current of Ganges began to flow down from the whole universe.22.",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਗੰਗਾ ਦੀ ਧਾਰਾ (ਧਰਤੀ) ਉਤੇ ਡਿਗੀ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "तिह ते गिरी गंग की धारा ॥२२॥",
      "sourceLineId": "82538",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਭੂਪ ਅਚੰਭਵ ਲਹਾ ॥",
      "transliteration": "eeh bidh bhoop acha(n)bhav lahaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਵੀ ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਅਚੰਭਾ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "इह बिधि भूप अचंभव लहा ॥",
      "sourceLineId": "82539",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਨ ਕ੍ਰਮ ਬਚਨ ਚਕ੍ਰਿਤ ਹੁਐ ਰਹਾ ॥",
      "transliteration": "man kram bachan chakirat huaai rahaa ||",
      "translation": "In this way, the king was also astonished and remained puzzled in mind, word and deeds.",
      "punjabiViakhya": "ਅਤੇ ਮਨ, ਬਾਣੀ ਅਤੇ ਕਰਮ ਤੋਂ ਹੈਰਾਨ ਹੋ ਰਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "मन क्रम बचन चकृत हुऐ रहा ॥",
      "sourceLineId": "82540",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੁ ਕੁਛ ਭਯੋ ਜੋਊ ਸੁਕ੍ਰਿ ਉਚਾਰਾ ॥",
      "transliteration": "s kuchh bhayo jouoo sukr uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹੀ ਕੁਝ ਹੋਇਆ ਜੋ ਸ਼ੁਕ੍ਰਾਚਾਰਯ ਨੇ ਕਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "सु कुछ भयो जोऊ सुकृ उचारा ॥",
      "sourceLineId": "82541",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੋਈ ਅਖੀਯਨ ਹਮ ਆਜ ਨਿਹਾਰਾ ॥੨੩॥",
      "transliteration": "soiee akheeyan ham aaj nihaaraa ||23||",
      "translation": "Whatever Shukracharya had said, the same had happened and he himself had seen all this with his own eyes on that day.23.",
      "punjabiViakhya": "ਉਹੀ (ਹੋਇਆ ਹੈ) ਅਜ ਮੈਂ ਅੱਖੀਆਂ ਨਾਲ ਵੇਖ ਲਿਆ ਹੈ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "सोई अखीयन हम आज निहारा ॥२३॥",
      "sourceLineId": "82542",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਰਧਿ ਦੇਹਿ ਅਪਨੋ ਮਿਨਿ ਦੀਨਾ ॥",
      "transliteration": "aradh dheh apano min dheenaa ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਅੱਧੇ ਕਦਮ ਲਈ ਆਪਣੀ ਦੇਹ ਮਿਣ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "अरधि देहि अपनो मिनि दीना ॥",
      "sourceLineId": "82543",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਕੈ ਭੂਪਤਿ ਜਸੁ ਲੀਨਾ ॥",
      "transliteration": "eeh bidh kai bhoopat jas leenaa ||",
      "translation": "For the remaining half a step, the king Bali got his own body measured and earned approbation.",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਰਾਜੇ ਨੇ ਯਸ਼ ਖਟ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "इह बिधि कै भूपति जसु लीना ॥",
      "sourceLineId": "82544",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਬ ਲਉ ਗੰਗ ਜਮੁਨ ਕੋ ਨੀਰਾ ॥",
      "transliteration": "jab lau ga(n)g jamun ko neeraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਤਕ ਗੰਗਾ ਅਤੇ ਯਮਨਾ ਦਾ ਜਲ (ਧਰਤੀ ਉਤੇ ਮੌਜੂਦ ਹੈ)",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "जब लउ गंग जमुन को नीरा ॥",
      "sourceLineId": "82545",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਬ ਲਉ ਚਲੀ ਕਥਾ ਜਗਿ ਧੀਰਾ ॥੨੪॥",
      "transliteration": "tab lau chalee kathaa jag dheeraa ||24||",
      "translation": "As long as there is water in the Ganges and Yamuna, till that time the story of his time the story of this enduring king will be narrated.24.",
      "punjabiViakhya": "ਤਦੋਂ ਤਕ ਇਹ ਕਥਾ ਜਗਤ ਵਿਚ ਚਲਦੀ ਰਹੇਗੀ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "तब लउ चली कथा जगि धीरा ॥२४॥",
      "sourceLineId": "82546",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਿਸਨ ਪ੍ਰਸੰਨਿ ਪ੍ਰਤਛ ਹੁਐ ਕਹਾ ॥",
      "transliteration": "bisan prasa(n)n pratachh huaai kahaa ||",
      "translation": "Vishnu was then pleased and manifesting himself said",
      "punjabiViakhya": "ਵਿਸ਼ਣੂ ਪ੍ਰਸੰਨ ਹੋ ਕੇ ਪ੍ਰਤੱਖ ਹੋਇਆ ਅਤੇ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "बिसन प्रसंनि प्रतछ हुऐ कहा ॥",
      "sourceLineId": "82547",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਚੋਬਦਾਰੁ ਦੁਆਰੇ ਹੁਐ ਰਹਾ ॥",
      "transliteration": "chobadhaar dhuaare huaai rahaa ||",
      "translation": "“O king  I shall be a watchmen and servant at your gate myself",
      "punjabiViakhya": "(\"ਹੇ ਰਾਜਨ! ਮੈਂ) ਤੇਰੇ ਦੁਆਰੇ ਉਤੇ ਚੋਬਦਾਰ ਹੋ ਕੇ ਰਹਾਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "चोबदारु दुआरे हुऐ रहा ॥",
      "sourceLineId": "82548",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਹਿਯੋ ਚਲੇ ਤਬ ਲਗੈ ਕਹਾਨੀ ॥",
      "transliteration": "kahiyo chale tab lagai kahaanee ||",
      "translation": "",
      "punjabiViakhya": "\"ਅਤੇ ਇਹ ਵੀ ਕਿਹਾ ਕਿ ਤਦੋਂ ਤਕ (ਤੇਰੀ ਇਹ) ਕਹਾਣੀ ਜਗਤ ਵਿਚ ਚਲੇਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "कहियो चले तब लगै कहानी ॥",
      "sourceLineId": "82549",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਬ ਲਗ ਗੰਗ ਜਮੁਨ ਕੋ ਪਾਨੀ ॥੨੫॥",
      "transliteration": "jab lag ga(n)g jamun ko paanee ||25||",
      "translation": "And as long as there will be water in the Ganges and Yamuna, the story of your charity will be narrate.25.",
      "punjabiViakhya": "ਜਦੋਂ ਤਕ ਗੰਗਾ ਅਤੇ ਯਮਨਾ ਵਿਚ ਪਾਣੀ ਰਹੇਗਾ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "जब लग गंग जमुन को पानी ॥२५॥",
      "sourceLineId": "82550",
      "sourceShabadId": "7820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "82551",
      "sourceShabadId": "7821",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਹ ਸਾਧਨ ਸੰਕਟ ਪਰੈ ਤਹ ਤਹ ਭਏ ਸਹਾਇ ॥",
      "transliteration": "jeh saadhan sa(n)kaT parai teh teh bhe sahai ||",
      "translation": "Wherever the saints are in distress, the Non-temporal Lord comes there for help.",
      "punjabiViakhya": "ਜਿਥੇ ਜਿਥੇ ਵੀ ਸਾਧਾ ਨੂੰ ਸੰਕਟ ਪੈਂਦਾ ਹੈ, ਉਥੇ ਉਥੇ ਹੀ (ਪਰਮ-ਸੱਤਾ) ਸਹਾਇਕ ਹੁੰਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "जह साधन संकट परै तह तह भए सहाइ ॥",
      "sourceLineId": "82552",
      "sourceShabadId": "7821",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦੁਆਰਪਾਲ ਹੁਐ ਦਰਿ ਬਸੇ ਭਗਤ ਹੇਤ ਹਰਿਰਾਇ ॥੨੬॥",
      "transliteration": "dhuaarapaal huaai dhar base bhagat het harirai ||26||",
      "translation": "The Lord, coming under the control of His devotee, became his gate-keeper.26.",
      "punjabiViakhya": "ਹਰਿ-ਰਾਇ ਭਗਤ ਲਈ ਦੁਆਰਪਾਲ ਹੋ ਕੇ (ਉਸ ਦੇ) ਦਰ ਤੇ ਵਸਦਾ ਹੈ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "दुआरपाल हुऐ दरि बसे भगत हेत हरिराइ ॥२६॥",
      "sourceLineId": "82553",
      "sourceShabadId": "7821",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "82554",
      "sourceShabadId": "7822",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਸਟਮ ਅਵਤਾਰ ਬਿਸਨ ਅਸ ਧਰਾ ॥",
      "transliteration": "asaTam avataar bisan as dharaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਵਿਸ਼ਣੂ ਨੇ ਅੱਠਵਾ ਅਵਤਾਰ ਧਾਰਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "असटम अवतार बिसन अस धरा ॥",
      "sourceLineId": "82555",
      "sourceShabadId": "7822",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਾਧਨ ਸਬੈ ਕ੍ਰਿਤਾਰਥ ਕਰਾ ॥",
      "transliteration": "saadhan sabai kirataarath karaa ||",
      "translation": "In this way, Vishnu, manifesting himself as the eighth incarnation, gratified all the saints.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਸਾਧਾ ਨੂੰ ਸਫਲ-ਮਨੋਰਥ (ਕ੍ਰਿਤਾਰਥ) ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "साधन सबै कृतारथ करा ॥",
      "sourceLineId": "82556",
      "sourceShabadId": "7822",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਬ ਨਵਮੋ ਬਰਨੋ ਅਵਤਾਰਾ ॥",
      "transliteration": "ab navamo barano avataaraa ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ (ਮੈਂ) ਨੌਵੇਾਂ ਅਵਤਾਰ ਦਾ ਵਰਣਨ ਕਰਦਾ ਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "अब नवमो बरनो अवतारा ॥",
      "sourceLineId": "82557",
      "sourceShabadId": "7822",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੁਨਹੁ ਸੰਤ ਚਿਤ ਲਾਇ ਸੁ ਧਾਰਾ ॥੨੭॥",
      "transliteration": "sunahu sa(n)t chit lai su dhaaraa ||27||",
      "translation": "Now I describe the ninth incarnation, which may please be listened to and understood correctly by all the saints..27.",
      "punjabiViakhya": "ਹੇ ਸੰਤੋ! ਚਿਤ ਲਾ ਕੇ ਸੁਣੋ ਅਤੇ (ਮਨ ਵਿਚ) ਧਾਰਨ ਕਰੋ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "सुनहु संत चित लाइ सु धारा ॥२७॥",
      "sourceLineId": "82558",
      "sourceShabadId": "7822",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਬਾਵਨ ਅਸਟਮੋ ਅਵਤਾਰ ਬਲਿ ਛਲਨ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੮॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the baavan asaTamo avataar bal chhalan samaapatam sat subham sat ||8||",
      "translation": "End of the description of VAMAN, the eighth incarnation of Vishnu and the deception of the king BALI in BACHITTAR NATAK.8.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ ਅੱਠਵੇਾਂ ਬਾਵਨ ਅਵਤਾਰ ਦਾ ਕਥਨ, ਬਲੀ ਦੇ ਛਲਨ ਪ੍ਰਸੰਗ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे बावन असटमो अवतार बलि छलन समापतम सतु सुभम सतु ॥८॥",
      "sourceLineId": "82559",
      "sourceShabadId": "7822",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਥ ਪਰਸਰਾਮ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "transliteration": "ath parasaraam avataar kathana(n) ||",
      "translation": "Now begins the description of Parashuram Incarnation:",
      "punjabiViakhya": "ਹੁਣ ਪਰਸਰਾਮ ਅਵਤਾਰ ਦਾ ਕਥਨ:",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "अथ परसराम अवतार कथनं ॥",
      "sourceLineId": "82560",
      "sourceShabadId": "7823",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ ॥",
      "transliteration": "sree bhagautee jee sahai ||",
      "translation": "Let Sri Bhagauti Ji (The Primal Lord) be helpful.",
      "punjabiViakhya": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ:",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "स्री भगउती जी सहाइ ॥",
      "sourceLineId": "82561",
      "sourceShabadId": "7823",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "82562",
      "sourceShabadId": "7823",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪੁਨਿ ਕੇਤਿਕ ਦਿਨ ਭਏ ਬਿਤੀਤਾ ॥",
      "transliteration": "pun ketik dhin bhe biteetaa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਕਿਤਨਾ ਹੀ ਸਮਾ ਬੀਤ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "पुनि केतिक दिन भए बितीता ॥",
      "sourceLineId": "82563",
      "sourceShabadId": "7823",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਛਤ੍ਰਨਿ ਸਕਲ ਧਰਾ ਕਹੁ ਜੀਤਾ ॥",
      "transliteration": "chhatran sakal dharaa kahu jeetaa ||",
      "translation": "Then a long period of time elapsed and the Kshatriyas conquered all the earth.",
      "punjabiViakhya": "ਛਤਰੀਆਂ ਨੇ ਸਾਰੀ ਧਰਤੀ ਨੂੰ ਜਿਤ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "छत्रनि सकल धरा कहु जीता ॥",
      "sourceLineId": "82564",
      "sourceShabadId": "7823",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਧਿਕ ਜਗਤ ਮਹਿ ਊਚ ਜਨਾਯੋ ॥",
      "transliteration": "adhik jagat meh uooch janaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ ਆਪਣੇ ਆਪ ਨੂੰ) ਸਾਰੇ ਜਗਤ ਵਿਚ ਵੱਡਾ ਕਰਕੇ ਜਣਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "अधिक जगत महि ऊच जनायो ॥",
      "sourceLineId": "82565",
      "sourceShabadId": "7823",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਾਸਵ ਬਲਿ ਕਹੂੰ ਲੈਨ ਨ ਪਾਯੋ ॥੧॥",
      "transliteration": "baasav bal kahoo(n) lain na paayo ||1||",
      "translation": "They considered themselves as the most high and their strength became unlimited.1.",
      "punjabiViakhya": "ਇੰਦਰ (ਬਾਸਵ) ਕਿਤੋਂ ਵੀ ਬਲੀ ਲੈ ਸਕਣ ਦੇ ਸਮਰਥ ਨਾ ਰਿਹਾ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "बासव बलि कहूँ लैन न पायो ॥१॥",
      "sourceLineId": "82566",
      "sourceShabadId": "7823",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਿਆਕੁਲ ਸਕਲ ਦੇਵਤਾ ਭਏ ॥",
      "transliteration": "biaakul sakal dhevataa bhe ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਦੇਵਤੇ ਵਿਆਕੁਲ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "बिआकुल सकल देवता भए ॥",
      "sourceLineId": "82567",
      "sourceShabadId": "7823",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਿਲਿ ਕਰਿ ਸਭੁ ਬਾਸਵ ਪੈ ਗਏ ॥",
      "transliteration": "mil kar sabh baasav pai ge ||",
      "translation": "Realising this all the gods were worried and went to Indra and said:",
      "punjabiViakhya": "ਸਾਰੇ ਮਿਲ ਕੇ ਇੰਦਰ ਕੋਲ ਗਏ (ਅਤੇ ਕਹਿਣ ਲਗੇ ਕਿ)",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "मिलि करि सभु बासव पै गए ॥",
      "sourceLineId": "82568",
      "sourceShabadId": "7823",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0173_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਛਤ੍ਰੀ ਰੂਪ ਧਰੇ ਸਭੁ ਅਸੁਰਨ ॥",
      "transliteration": "chhatree roop dhare sabh asuran ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਦੈਂਤਾ ਨੇ ਛਤਰੀ ਰੂਪ ਧਾਰਨ ਕਰ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 173,
      "hindi": "",
      "hindiTransliteration": "छत्री रूप धरे सभु असुरन ॥",
      "sourceLineId": "82569",
      "sourceShabadId": "7823",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
