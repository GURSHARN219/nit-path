{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 175,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0175_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਬੈ ਸੂਰ ਦਉਰੇ ॥",
      "transliteration": "sabai soor dhaure ||",
      "translation": "All the warriors ran and gathered at one place.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਨੇ ਦੌੜ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "सबै सूर दउरे ॥",
      "sourceLineId": "82619",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਲਯੋ ਘੇਰਿ ਰਾਮੰ ॥",
      "transliteration": "layo gher raama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਸ਼ੁਰਾਮ ਨੂੰ (ਇੰਜ) ਘੇਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "लयो घेरि रामं ॥",
      "sourceLineId": "82620",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਘਟਾ ਸੂਰ ਸ੍ਯਾਮੰ ॥੧੪॥",
      "transliteration": "ghaTaa soor sayaama(n) ||14||",
      "translation": "And the besieged Parashurama, just as the clouds besiege the sun.14.",
      "punjabiViakhya": "(ਜਿਵੇਾਂ) ਕਾਲੀਆਂ ਘਟਾਵਾ ਸੂਰਜ ਨੂੰ ਘੇਰਦੀਆਂ ਹਨ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "घटा सूर स्यामं ॥१४॥",
      "sourceLineId": "82621",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਮਾਣੰ ਕੜੰਕੇ ॥",
      "transliteration": "kamaana(n) kaRa(n)ke ||",
      "translation": "",
      "punjabiViakhya": "ਕਮਾਨਾ ਕੜਕ ਰਹੀਆਂ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "कमाणं कड़ंके ॥",
      "sourceLineId": "82622",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭਏ ਨਾਦ ਬੰਕੇ ॥",
      "transliteration": "bhe naadh ba(n)ke ||",
      "translation": "With the crackling of bows a queer sound was produced,",
      "punjabiViakhya": "ਭਿਆਨਕ ਨਾਦ ਹੋ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "भए नाद बंके ॥",
      "sourceLineId": "82623",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਘਟਾ ਜਾਣਿ ਸਿਆਹੰ ॥",
      "transliteration": "ghaTaa jaan siaaha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਕਾਲੀਆਂ ਘਟਾਵਾ (ਚੜ੍ਰਹ ਆਈਆਂ ਹੋਣ)",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "घटा जाणि सिआहं ॥",
      "sourceLineId": "82624",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚੜਿਓ ਤਿਉ ਸਿਪਾਹੰ ॥੧੫॥",
      "transliteration": "chaRio tiau sipaaha(n) ||15||",
      "translation": "And the army swarmed like the dark clouds.15.",
      "punjabiViakhya": "ਸੈਨਿਕ ਇਸ ਤਰ੍ਰਹਾ ਚੜ੍ਰਹੇ ਹਨ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "चड़िओ तिउ सिपाहं ॥१५॥",
      "sourceLineId": "82625",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭਏ ਨਾਦ ਬੰਕੇ ॥",
      "transliteration": "bhe naadh ba(n)ke ||",
      "translation": "",
      "punjabiViakhya": "ਬੜੇ ਡਰਾਵਣੇ ਨਾਦ ਹੋਣ ਲਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "भए नाद बंके ॥",
      "sourceLineId": "82626",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੁ ਸੇਲੰ ਧਮੰਕੇ ॥",
      "transliteration": "s sela(n) dhama(n)ke ||",
      "translation": "With the clattering of the daggers, a queer sound was produced,",
      "punjabiViakhya": "ਬਰਛਿਆਂ ਦੀ ਧਮਕ ਪੈਣ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "सु सेलं धमंके ॥",
      "sourceLineId": "82627",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗਜਾ ਜੂਹ ਗਜੇ ॥",
      "transliteration": "gajaa jooh gaje ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਥੀਆਂ ਦੇ ਝੁੰਡ ਗਜਣ ਲਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "गजा जूह गजे ॥",
      "sourceLineId": "82628",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੁਭੰ ਸੰਜ ਸਜੇ ॥੧੬॥",
      "transliteration": "subha(n) sa(n)j saje ||16||",
      "translation": "The elephants began to roar in groups and bedecked with armour, the warriors seemed impressive.16.",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੇ ਸੁੰਦਰ ਕਵਚ ਸਜਾਏ ਹੋਏ ਸਨ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "सुभं संज सजे ॥१६॥",
      "sourceLineId": "82629",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਚਹੂੰ ਓਰ ਢੂਕੇ ॥",
      "transliteration": "chahoo(n) or ddooke ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ ਢੁਕ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "चहूँ ओर ढूके ॥",
      "sourceLineId": "82630",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗਜੰ ਜੂਹ ਝੂਕੇ ॥",
      "transliteration": "gaja(n) jooh jhooke ||",
      "translation": "Gathering from all the four sides, the groups of elephants began a fight.",
      "punjabiViakhya": "ਅਤੇ ਹਾਥੀਆਂ ਦੇ ਝੁੰਡਾ ਨੂੰ ਅਗੇ ਝੋਂਕਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "गजं जूह झूके ॥",
      "sourceLineId": "82631",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਰੰ ਬ੍ਰਯੂਹ ਛੂਟੇ ॥",
      "transliteration": "sara(n) brayooh chhooTe ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਸਾਰੇ ਤੀਰ ਛਡ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "सरं ब्रयूह छूटे ॥",
      "sourceLineId": "82632",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਿਪੰ ਸੀਸ ਫੂਟੇ ॥੧੭॥",
      "transliteration": "ripa(n) sees fooTe ||17||",
      "translation": "The volleys of arrows were shot and the heads of the kings were shattered. 17.",
      "punjabiViakhya": "ਅਤੇ ਵੈਰੀਆਂ ਦੇ ਸਿਰ ਫੁਟ ਰਹੇ ਸਨ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "रिपं सीस फूटे ॥१७॥",
      "sourceLineId": "82633",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਉਠੇ ਨਾਦ ਭਾਰੀ ॥",
      "transliteration": "auThe naadh bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਰੀ ਨਾਦ ਉਠ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "उठे नाद भारी ॥",
      "sourceLineId": "82634",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਿਸੇ ਛਤ੍ਰਧਾਰੀ ॥",
      "transliteration": "rise chhatradhaaree ||",
      "translation": "The frightful sound emanated and all the kings got infuriated.",
      "punjabiViakhya": "ਛਤਰਧਾਰੀ ਕ੍ਰੋਧਵਾਨ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "रिसे छत्रधारी ॥",
      "sourceLineId": "82635",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਘਿਰਿਯੋ ਰਾਮ ਸੈਨੰ ॥",
      "transliteration": "ghiriyo raam saina(n) ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਸ਼ੁਰਾਮ ਨੂੰ ਸੈਨਾ ਨੇ (ਇੰਜ) ਘੇਰ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "घिरियो राम सैनं ॥",
      "sourceLineId": "82636",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਿਵੰ ਜੇਮ ਮੈਨੰ ॥੧੮॥",
      "transliteration": "siva(n) jem maina(n) ||18||",
      "translation": "Parashurama was besieged by the army like Shiva encircled by the forces of Cupid.18.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਸ਼ਿਵ ਨੂੰ ਕਾਮ ਨੇ (ਘੇਰ ਲਿਆ ਸੀ) ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "सिवं जेम मैनं ॥१८॥",
      "sourceLineId": "82637",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਣੰ ਰੰਗ ਰਤੇ ॥",
      "transliteration": "rana(n) ra(n)g rate ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਯੁੱਧ ਦੇ ਰੰਗ ਵਿਚ ਰਤੇ ਹੋਏ ਸਨੱ",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "रणं रंग रते ॥",
      "sourceLineId": "82638",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤ੍ਰਸੇ ਤੇਜ ਤਤੇ ॥",
      "transliteration": "trase tej tate ||",
      "translation": "All being absorbed and dyed with the dye of war, feared the glory of others.",
      "punjabiViakhya": "ਅਤੇ (ਦੂਜਿਆਂ ਦੇ) ਤੀਬਰ ਤੇਜ ਤੋਂ ਡਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "त्रसे तेज तते ॥",
      "sourceLineId": "82639",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਉਠੀ ਸੈਣ ਧੂਰੰ ॥",
      "transliteration": "auThee sain dhoora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੈਨਾ ਦੇ (ਪੈਰਾ ਨਾਲ ਜੋ) ਧੂੜ ਉਡੀ,",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "उठी सैण धूरं ॥",
      "sourceLineId": "82640",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਹਿਯੋ ਗੈਣ ਪੂਰੰ ॥੧੯॥",
      "transliteration": "rahiyo gain poora(n) ||19||",
      "translation": "So much dust arose by (the movement of the) army that the sky was filled with dust.19.",
      "punjabiViakhya": "(ਉਸ ਨਾਲ) ਆਕਾਸ਼ ਢਕ ਗਿਆ ਸੀ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "रहियो गैण पूरं ॥१९॥",
      "sourceLineId": "82641",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਘਣੇ ਢੋਲ ਬਜੇ ॥",
      "transliteration": "ghane ddol baje ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਸਾਰੇ ਢੋਲ ਵਜਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "घणे ढोल बजे ॥",
      "sourceLineId": "82642",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਹਾ ਬੀਰ ਗਜੇ ॥",
      "transliteration": "mahaa beer gaje ||",
      "translation": "The drums resounded violently and the mighty warriors began to roar.",
      "punjabiViakhya": "ਅਤੇ ਸੂਰਵੀਰ ਗਜਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "महा बीर गजे ॥",
      "sourceLineId": "82643",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਨੋ ਸਿੰਘ ਛੁਟੇ ॥",
      "transliteration": "mano si(n)gh chhuTe ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧੇ ਇਸ ਤਰ੍ਰਹਾ ਜੁਟੇ ਹੋਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "मनो सिंघ छुटे ॥",
      "sourceLineId": "82644",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹਿਮੰ ਬੀਰ ਜੁਟੇ ॥੨੦॥",
      "transliteration": "hima(n) beer juTe ||20||",
      "translation": "The warriors were fighting each other like the freely roaming lions.20.",
      "punjabiViakhya": "ਮਾਨੋ (ਬੰਨ੍ਰਹੇ ਹੋਏ) ਸ਼ੇਰ ਛੁਟਣ ਤੇ (ਜੁਟ ਜਾਦੇ ਹੋਣ) ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "हिमं बीर जुटे ॥२०॥",
      "sourceLineId": "82645",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਰੈ ਮਾਰਿ ਮਾਰੰ ॥",
      "transliteration": "karai maar maara(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸਾਰੇ) ਮਾਰੋ ਮਾਰ ਕਰਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "करै मारि मारं ॥",
      "sourceLineId": "82646",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਕੈ ਬਿਕਰਾਰੰ ॥",
      "transliteration": "bakai bikaraara(n) ||",
      "translation": "With the shouts of “kill, kill”, the warriors were uttering dreadful words.",
      "punjabiViakhya": "ਅਤੇ ਭਿਆਨਕ ਸ਼ਬਦ ਬੋਲਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "बकै बिकरारं ॥",
      "sourceLineId": "82647",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗਿਰੈ ਅੰਗ ਭੰਗੰ ॥",
      "transliteration": "girai a(n)g bha(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਗ ਟੁਟ ਕੇ ਡਿਗ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "गिरै अंग भंगं ॥",
      "sourceLineId": "82648",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦਵੰ ਜਾਨ ਦੰਗੰ ॥੨੧॥",
      "transliteration": "dhava(n) jaan dha(n)ga(n) ||21||",
      "translation": "The chopped limbs of the warriors are falling and it appeared that there is fire on all the four sides.21.",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਜਿਵੇਾਂ ਅੱਗ ਦਗ ਦਗ ਕਰ ਰਹੀ ਹੈ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "दवं जान दंगं ॥२१॥",
      "sourceLineId": "82649",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗਏ ਛੂਟ ਅਸਤ੍ਰੰ ॥",
      "transliteration": "ge chhooT asatra(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਸੂਰਮਿਆਂ ਦੇ ਹੱਥੋਂ) ਅਸਤ੍ਰ ਛੁਟ ਗਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "गए छूट असत्रं ॥",
      "sourceLineId": "82650",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭਜੈ ਹ੍ਵੈ ਨ੍ਰਿਅਸਤ੍ਰੰ ॥",
      "transliteration": "bhajai havai nriasatra(n) ||",
      "translation": "The weapons began to fall from the hands and the warriors began to run away empty-handed.",
      "punjabiViakhya": "(ਉਹ) ਅਸਤ੍ਰ-ਹੀਣ ਹੋ ਕੇ ਭਜ ਗਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "भजै ह्वै नृअसत्रं ॥",
      "sourceLineId": "82651",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਖਿਲੈ ਸਾਰ ਬਾਜੀ ॥",
      "transliteration": "khilai saar baajee ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈ) ਲੋਹੇ ਦੀ ਬਾਜੀ ਖੇਡ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "खिलै सार बाजी ॥",
      "sourceLineId": "82652",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤੁਰੇ ਤੁੰਦ ਤਾਜੀ ॥੨੨॥",
      "transliteration": "ture tu(n)dh taajee ||22||",
      "translation": "The horses were neighing and were running hither and thither with swiftness.22.",
      "punjabiViakhya": "ਅਤੇ ਘੋੜੇ ਤੇਜ਼ੀ ਨਾਲ ਭਜ ਰਹੇ ਸਨ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "तुरे तुँद ताजी ॥२२॥",
      "sourceLineId": "82653",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭੁਜਾ ਠੋਕਿ ਬੀਰੰ ॥",
      "transliteration": "bhujaa Thok beera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭੁਜਾਵਾ ਨੂੰ ਠੋਕ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "भुजा ठोकि बीरं ॥",
      "sourceLineId": "82654",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਰੇ ਘਾਇ ਤੀਰੰ ॥",
      "transliteration": "kare ghai teera(n) ||",
      "translation": "The warriors are wounding the enemy by showering their arrows  they were also patting their arms.",
      "punjabiViakhya": "ਸੂਰਮੇ ਤੀਰਾ ਨਾਲ ਜ਼ਖ਼ਮ ਲਗਾ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "करे घाइ तीरं ॥",
      "sourceLineId": "82655",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨੇਜੇ ਗਡ ਗਾਢੇ ॥",
      "transliteration": "neje gadd gaadde ||",
      "translation": "",
      "punjabiViakhya": "ਨੇਜ਼ਿਆਂ ਨੂੰ ਪੱਕੀ ਤਰ੍ਰਹਾ ਗਡਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "नेजे गड गाढे ॥",
      "sourceLineId": "82656",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮਚੇ ਬੈਰ ਬਾਢੇ ॥੨੩॥",
      "transliteration": "mache bair baadde ||23||",
      "translation": "The warriors by planting their daggers, increasing their inimical intentions, are waging a terrible war. 23",
      "punjabiViakhya": "ਅਤੇ ਵੈਰ ਵਧਾ ਕੇ (ਯੁੱਧ) ਮਚਾ ਰਹੇ ਸਨ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "मचे बैर बाढे ॥२३॥",
      "sourceLineId": "82657",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਘਣੈ ਘਾਇ ਪੇਲੇ ॥",
      "transliteration": "ghanai ghai pele ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ (ਸੂਰਮੇ) ਘਾਇਲ ਹੋ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "घणै घाइ पेले ॥",
      "sourceLineId": "82658",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮਨੋ ਫਾਗ ਖੇਲੇ ॥",
      "transliteration": "mano faag khele ||",
      "translation": "Many wounds are being inflicted and the wounded warriors appear to be playing Holi",
      "punjabiViakhya": "ਮਾਨੋ ਹੋਲੀ ਖੇਡ ਰਹੇ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "मनो फाग खेले ॥",
      "sourceLineId": "82659",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਰੀ ਬਾਣ ਬਰਖਾ ॥",
      "transliteration": "karee baan barakhaa ||",
      "translation": "",
      "punjabiViakhya": "(ਸਾਰੇ ਸੂਰਮੇ) ਬਾਣਾ ਦੀ ਵਰਖਾ ਕਰ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "करी बाण बरखा ॥",
      "sourceLineId": "82660",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭਏ ਜੀਤ ਕਰਖਾ ॥੨੪॥",
      "transliteration": "bhe jeet karakhaa ||24||",
      "translation": "Showering their arrows, all are desirous of the victory.24.",
      "punjabiViakhya": "ਅਤੇ ਜਿਤ ਲਈ ਚਾਹਵਾਨ ਸਨ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "भए जीत करखा ॥२४॥",
      "sourceLineId": "82661",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗਿਰੇ ਅੰਤ ਘੂਮੰ ॥",
      "transliteration": "gire a(n)t ghooma(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈ ਸੂਰਮੇ) ਅੰਤ ਵਿਚ ਭਵਾਟਣੀ ਖਾ ਕੇ ਡਿਗਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "गिरे अंत घूमं ॥",
      "sourceLineId": "82662",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮਨੋ ਬ੍ਰਿਛ ਝੂਮੰ ॥",
      "transliteration": "mano birachh jhooma(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਬ੍ਰਿਛ ਝੂਮ ਰਿਹਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "मनो बृछ झूमं ॥",
      "sourceLineId": "82663",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਟੂਟੇ ਸਸਤ੍ਰ ਅਸਤ੍ਰੰ ॥",
      "transliteration": "TooTe sasatr asatra(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈਆਂ ਦੇ) ਅਸਤ੍ਰ ਅਤੇ ਸ਼ਸਤ੍ਰ ਟੁਟ ਗਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "टूटे ससत्र असत्रं ॥",
      "sourceLineId": "82664",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭਜੇ ਹੁਐ ਨਿਰ ਅਸਤ੍ਰੰ ॥੨੫॥",
      "transliteration": "bhaje huaai nir asatra(n) ||25||",
      "translation": "The warriors are roaming and falling like the swinging, after the breaking of their weapons and becoming trees armless, the warriors sped away.25.",
      "punjabiViakhya": "ਅਤੇ ਅਸਤ੍ਰ ਤੋਂ ਸਖਣੇ ਹੋ ਕੇ ਭਜ ਰਹੇ ਸਨ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "भजे हुऐ निर असत्रं ॥२५॥",
      "sourceLineId": "82665",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0175_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਿਤੇ ਸਤ੍ਰੁ ਆਏ ॥",
      "transliteration": "jite satr aae ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਤਨੇ ਵੈਰੀ (ਸਾਹਮਣੇ) ਆਏ,",
      "source": "DASAM_GRANTH",
      "ang": 175,
      "hindi": "",
      "hindiTransliteration": "जिते सत्रु आए ॥",
      "sourceLineId": "82666",
      "sourceShabadId": "7826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
