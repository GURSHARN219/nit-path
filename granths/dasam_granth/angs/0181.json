{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 181,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0181_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚੜੇ ਤੇਜ ਮਾਣੰ ॥",
      "transliteration": "chaRe tej maana(n) ||",
      "translation": "Holding the Shakti (his power) in his hands the supremely glorious Shiva,",
      "punjabiViakhya": "ਤੇਜ ਅਤੇ ਗੌਰਵ ਨਾਲ (ਯੁੱਧ ਕਰਨ ਲਈ) ਚੜ੍ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "चड़े तेज माणं ॥",
      "sourceLineId": "82859",
      "sourceShabadId": "7838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗਣੰ ਗਾੜ ਗਾਜੇ ॥",
      "transliteration": "gana(n) gaaR gaaje ||",
      "translation": "",
      "punjabiViakhya": "(ਯੁੱਧ-ਭੂਮੀ ਵਿਚ) ਗੜ ਗੜ ਕਰਦੇ ਗਜ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "गणं गाड़ गाजे ॥",
      "sourceLineId": "82860",
      "sourceShabadId": "7838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਣੰ ਰੁਦ੍ਰ ਰਾਜੇ ॥੨੮॥",
      "transliteration": "rana(n) rudhr raaje ||28||",
      "translation": "Thundering dreadfully, is absorbed in war, and is looking impressive.28.",
      "punjabiViakhya": "ਅਤੇ ਰਣ-ਭੂਮੀ ਵਿਚ ਰੁਦਰ ਸ਼ੋਭਾ ਪਾ ਰਿਹਾ ਸੀ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "रणं रुद्र राजे ॥२८॥",
      "sourceLineId": "82861",
      "sourceShabadId": "7838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭਭੰਕੰਤ ਘਾਯੰ ॥",
      "transliteration": "bhabha(n)ka(n)t ghaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ) ਜਖ਼ਮਾ ਤੋਂ ਭਕ-ਭਕ ਕਰਦਾ (ਲਹੂ ਵਗ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "भभंकंत घायं ॥",
      "sourceLineId": "82862",
      "sourceShabadId": "7838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਲਰੇ ਚਉਪ ਚਾਯੰ ॥",
      "transliteration": "lare chaup chaaya(n) ||",
      "translation": "The blood is oozing out of the wounds and all the fighters are fighting with enthusiasm.",
      "punjabiViakhya": "ਪਰ ਉਹ) ਚਾਹ ਨਾਲ ਲੜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "लरे चउप चायं ॥",
      "sourceLineId": "82863",
      "sourceShabadId": "7838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਡਕੀ ਡਾਕਣੀਯੰ ॥",
      "transliteration": "ddakee ddaakaneeya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਡਾਕਣੀਆਂ (ਲਹੂ ਪੀ ਕੇ) ਡਕਾਰ ਰਹੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "डकी डाकणीयं ॥",
      "sourceLineId": "82864",
      "sourceShabadId": "7838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰੜੈ ਕਾਕਣੀਯੰ ॥੨੯॥",
      "transliteration": "raRai kaakaneeya(n) ||29||",
      "translation": "The vampires are pleased and the horses etc, are rolling in dust.29.",
      "punjabiViakhya": "ਅਤੇ ਗਿਰਝਾ ਬੋਲ ਰਹੀਆਂ ਸਨ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "रड़ै काकणीयं ॥२९॥",
      "sourceLineId": "82865",
      "sourceShabadId": "7838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭਯੰ ਰੋਸ ਰੁਦ੍ਰੰ ॥",
      "transliteration": "bhaya(n) ros rudhra(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰੁਦਰ ਕ੍ਰੋਧਵਾਨ ਹੋਇਆ ਅਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "भयं रोस रुद्रं ॥",
      "sourceLineId": "82866",
      "sourceShabadId": "7838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹਣੈ ਦੈਤ ਛੁਦ੍ਰੰ ॥",
      "transliteration": "hanai dhait chhudhra(n) ||",
      "translation": "Rudra, in great fury, hath destroyed the demons,",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਕਾਇਰ ਦੈਂਤਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "हणै दैत छुद्रं ॥",
      "sourceLineId": "82867",
      "sourceShabadId": "7838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਟੇ ਅਧੁ ਅਧੰ ॥",
      "transliteration": "kaTe adh adha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੂੰ ਰੁਦਰ ਨੇ) ਅਧੋ ਅਧ ਕਟ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "कटे अधु अधं ॥",
      "sourceLineId": "82868",
      "sourceShabadId": "7838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭਈ ਸੈਣ ਬਧੰ ॥੩੦॥",
      "transliteration": "bhiee sain badha(n) ||30||",
      "translation": "And hath chopped their bodies into bits and killed the army.30.",
      "punjabiViakhya": "ਅਤੇ (ਇਸ ਤਰ੍ਰਹਾ ਸਾਰੀ ਦੈਂਤ) ਸੈਨਾ ਮਾਰੀ ਗਈ ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "भई सैण बधं ॥३०॥",
      "sourceLineId": "82869",
      "sourceShabadId": "7838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਿਸਿਯੋ ਸੂਲ ਪਾਣੰ ॥",
      "transliteration": "risiyo sool paana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਬਹੁਤ ਗੁੱਸੇ ਵਿਚ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "रिसियो सूल पाणं ॥",
      "sourceLineId": "82870",
      "sourceShabadId": "7838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹਣੈ ਦੈਤ ਭਾਣੰ ॥",
      "transliteration": "hanai dhait bhaana(n) ||",
      "translation": "Shiva, the holder of the trident, is in extreme anger and he hath destroyed the demons.",
      "punjabiViakhya": "ਅਤੇ ਮਹਾਨ ਤੇਜਸਵੀ ('ਭਾਣੰ') ਦੈਂਤਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "हणै दैत भाणं ॥",
      "sourceLineId": "82871",
      "sourceShabadId": "7838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਰੰ ਓਘ ਛੁਟੇ ॥",
      "transliteration": "sara(n) ogh chhuTe ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ (ਇਸ ਤਰ੍ਰਹਾ) ਛਡੇ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "सरं ओघ छुटे ॥",
      "sourceLineId": "82872",
      "sourceShabadId": "7838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਘਣੰ ਜੇਮ ਟੁਟੇ ॥੩੧॥",
      "transliteration": "ghana(n) jem TuTe ||31||",
      "translation": "The arrows are being showered like the raining clouds.31.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਬਦਲ ਫਟ ਜਾਦਾ ਹੈ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "घणं जेम टुटे ॥३१॥",
      "sourceLineId": "82873",
      "sourceShabadId": "7838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰਣੰ ਰੁਦ੍ਰ ਗਜੇ ॥",
      "transliteration": "rana(n) rudhr gaje ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦੋਂ) ਰਣ-ਭੂਮੀ ਵਿਚ ਰੁਦਰ ਗਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "रणं रुद्र गजे ॥",
      "sourceLineId": "82874",
      "sourceShabadId": "7838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਬੈ ਦੈਤ ਭਜੇ ॥",
      "transliteration": "tabai dhait bhaje ||",
      "translation": "When Rudra thundered in the battlefield, then all the demons ran away.",
      "punjabiViakhya": "ਤਦੋਂ ਸਾਰੇ ਦੈਂਤ ਭਜ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "तबै दैत भजे ॥",
      "sourceLineId": "82875",
      "sourceShabadId": "7838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਜੈ ਸਸਤ੍ਰ ਸਰਬੰ ॥",
      "transliteration": "tajai sasatr saraba(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ (ਦੈਂਤਾ) ਨੇ ਸ਼ਸਤ੍ਰ ਤਿਆਗ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "तजै ससत्र सरबं ॥",
      "sourceLineId": "82876",
      "sourceShabadId": "7838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਿਟਿਓ ਦੇਹ ਗਰਬੰ ॥੩੨॥",
      "transliteration": "miTio dheh garaba(n) ||32||",
      "translation": "All of them abandoned their weapons and the pride of all was shattered.32.",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਰੀਰ ਦਾ ਮਾਣ ਮਿਟਾ ਦਿੱਤਾ ॥੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "मिटिओ देह गरबं ॥३२॥",
      "sourceLineId": "82877",
      "sourceShabadId": "7838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "82878",
      "sourceShabadId": "7839",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਧਾਯੋ ਤਬੈ ਅੰਧਕ ਬਲਵਾਨਾ ॥",
      "transliteration": "dhaayo tabai a(n)dhak balavaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਆਪਣੇ ਨਾਲ ਕਈ ਪ੍ਰਕਾਰ ਦੀ ਦੈਂਤ ਸੈਨਾ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "धायो तबै अंधक बलवाना ॥",
      "sourceLineId": "82879",
      "sourceShabadId": "7839",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੰਗ ਲੈ ਸੈਨ ਦਾਨਵੀ ਨਾਨਾ ॥",
      "transliteration": "sa(n)g lai sain dhaanavee naanaa ||",
      "translation": "At that time, the mighty Andhakasura, alongwith the army of demons sped towards the fornt.",
      "punjabiViakhya": "ਬਲਵਾਨ ਅੰਧਕ ਨੇ ਧਾਵਾ ਬੋਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "संग लै सैन दानवी नाना ॥",
      "sourceLineId": "82880",
      "sourceShabadId": "7839",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਮਿਤ ਬਾਣ ਨੰਦੀ ਕਹੁ ਮਾਰੇ ॥",
      "transliteration": "amit baan na(n)dhee kahu maare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸ਼ਿਵ ਦੀ ਸਵਾਰੀ ਨੰਦੀ ਬਲਦ ਨੂੰ ਅਣਗਿਣਤ ਤੀਰ ਮਾਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "अमित बाण नंदी कहु मारे ॥",
      "sourceLineId": "82881",
      "sourceShabadId": "7839",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬੇਧਿ ਅੰਗ ਕਹ ਪਾਰ ਪਧਾਰੇ ॥੩੩॥",
      "transliteration": "bedh a(n)g keh paar padhaare ||33||",
      "translation": "He discharged many arrows on Nandi, which penetrated through his limbs.33.",
      "punjabiViakhya": "ਜੋ ਉਸ ਦੇ ਸ਼ਰੀਰ ਵਿਚੋਂ ਪਾਰ ਹੋ ਗਏ ॥੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "बेधि अंग कह पार पधारे ॥३३॥",
      "sourceLineId": "82882",
      "sourceShabadId": "7839",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਬ ਹੀ ਬਾਣ ਲਗੇ ਬਾਹਣ ਤਨਿ ॥",
      "transliteration": "jab hee baan lage baahan tan ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਨੰਦੀ ਬਲਦ ਦੇ ਸ਼ਰੀਰ ਵਿਚ ਤੀਰ ਲਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "जब ही बाण लगे बाहण तनि ॥",
      "sourceLineId": "82883",
      "sourceShabadId": "7839",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰੋਸ ਜਗਿਯੋ ਤਬ ਹੀ ਸਿਵ ਕੇ ਮਨਿ ॥",
      "transliteration": "ros jagiyo tab hee siv ke man ||",
      "translation": "When the god Shiva saw the infliction of the arrows on his vehicle, then he became violently furious.",
      "punjabiViakhya": "ਤਦੋਂ ਸ਼ਿਵ ਦੇ ਮਨ ਵਿਚ ਕ੍ਰੋਧ ਭੜਕ ਉਠਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "रोस जगियो तब ही सिव के मनि ॥",
      "sourceLineId": "82884",
      "sourceShabadId": "7839",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਧਿਕ ਰੋਸ ਕਰਿ ਬਿਸਖ ਚਲਾਏ ॥",
      "transliteration": "adhik ros kar bisakh chalaae ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਬਹੁਤ ਕ੍ਰੋਧ ਕਰ ਕੇ ਬਾਣ ਚਲਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "अधिक रोस करि बिसख चलाए ॥",
      "sourceLineId": "82885",
      "sourceShabadId": "7839",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭੂਮਿ ਅਕਾਸਿ ਛਿਨਕ ਮਹਿ ਛਾਏ ॥੩੪॥",
      "transliteration": "bhoom akaas chhinak meh chhaae ||34||",
      "translation": "With great ire, he discharge his poisonous arrows, which spread over the earth and sky in an instant.34.",
      "punjabiViakhya": "ਜੋ ਛਿਣ ਭਰ ਵਿਚ ਆਕਾਸ਼ ਅਤੇ ਧਰਤੀ ਵਿਚ ਛਾ ਗਏ ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "भूमि अकासि छिनक महि छाए ॥३४॥",
      "sourceLineId": "82886",
      "sourceShabadId": "7839",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਾਣਾਵਲੀ ਰੁਦ੍ਰ ਜਬ ਸਾਜੀ ॥",
      "transliteration": "baanaavalee rudhr jab saajee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਸ਼ਿਵ ਨੇ ਬਾਣਾ ਦੀ ਝੜੀ ਲਾ ਦਿੱਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "बाणावली रुद्र जब साजी ॥",
      "sourceLineId": "82887",
      "sourceShabadId": "7839",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਬ ਹੀ ਸੈਣ ਦਾਨਵੀ ਭਾਜੀ ॥",
      "transliteration": "tab hee sain dhaanavee bhaajee ||",
      "translation": "When Rudra shot his arrows, the army of demons sped away.",
      "punjabiViakhya": "ਤਦੋਂ ਦੈਂਤਾ ਦੀ ਸੈਨਾ ਭਜ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "तब ही सैण दानवी भाजी ॥",
      "sourceLineId": "82888",
      "sourceShabadId": "7839",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਬ ਅੰਧਕ ਸਿਵ ਸਾਮੁਹੁ ਧਾਯੋ ॥",
      "transliteration": "tab a(n)dhak siv saamuh dhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਅੰਧਕ ਦੈਂਤ ਸ਼ਿਵ ਦੇ ਸਾਹਮਣੇ (ਆ ਕੇ) ਡਟਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "तब अंधक सिव सामुहु धायो ॥",
      "sourceLineId": "82889",
      "sourceShabadId": "7839",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੁੰਦ ਜੁਧੁ ਰਣ ਮਧਿ ਮਚਾਯੋ ॥੩੫॥",
      "transliteration": "dhu(n)dh judh ran madh machaayo ||35||",
      "translation": "Then Andhakasura came in front of Shiva, a dreadful war ensured.35.",
      "punjabiViakhya": "ਅਤੇ (ਦੋਹਾ ਨੇ) ਰਣ-ਭੂਮੀ ਵਿਚ ਦੁਅੰਦ-ਯੁੱਧ ਮਚਾਇਆ ॥੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "दुँद जुधु रण मधि मचायो ॥३५॥",
      "sourceLineId": "82890",
      "sourceShabadId": "7839",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "82891",
      "sourceShabadId": "7840",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬੀਸ ਬਾਣ ਤਿਨ ਸਿਵਹਿ ਪ੍ਰਹਾਰੇ ਕੋਪ ਕਰਿ ॥",
      "transliteration": "bees baan tin siveh prahaare kop kar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਕ੍ਰੋਧ ਕਰ ਕੇ ੨੦ ਬਾਣ ਸ਼ਿਵ ਉਤੇ ਚਲਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "बीस बाण तिन सिवहि प्रहारे कोप करि ॥",
      "sourceLineId": "82892",
      "sourceShabadId": "7840",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਲਗੇ ਰੁਦ੍ਰ ਕੇ ਗਾਤ ਗਏ ਓਹ ਘਾਨਿ ਕਰ ॥",
      "transliteration": "lage rudhr ke gaat ge oh ghaan kar ||",
      "translation": "The demons, highly infuriated, discharged twenty arrows on Shiva, which struck the body of Shiva and wounded it.",
      "punjabiViakhya": "ਉਹ ਰੁਦਰ ਦੇ ਸ਼ਰੀਰ ਵਿਚ ਲਗੇ ਅਤੇ ਜ਼ਖ਼ਮ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "लगे रुद्र के गात गए ओह घानि कर ॥",
      "sourceLineId": "82893",
      "sourceShabadId": "7840",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗਹਿ ਪਿਨਾਕ ਕਹ ਪਾਣਿ ਪਿਨਾਕੀ ਧਾਇਓ ॥",
      "transliteration": "geh pinaak keh paan pinaakee dhaio ||",
      "translation": "",
      "punjabiViakhya": "(ਦੂਜੇ ਪਾਸੇ ਨਿਕਲ) ਗਏ। ਸ਼ਿਵ ਨੇ (ਤੁਰੰਤ) ਹੱਥ ਵਿਚ ਪਿਨਾਕ ਧਨੁਸ਼ ਲੈ ਕੇ ਧਾਵਾ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "गहि पिनाक कह पाणि पिनाकी धाइओ ॥",
      "sourceLineId": "82894",
      "sourceShabadId": "7840",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਹੋ ਤੁਮੁਲ ਜੁਧੁ ਦੁਹੂੰਅਨ ਰਣ ਮਧਿ ਮਚਾਇਓ ॥੩੬॥",
      "transliteration": "ho tumul judh dhuhoo(n)an ran madh machaio ||36||",
      "translation": "Shiva also ran forward, holding his bow in his hand and a fearful war began between them.36.",
      "punjabiViakhya": "ਅਤੇ ਦੋਹਾ ਨੇ ਰਣ-ਭੂਮੀ ਵਿਚ ਖੂਬ ਘੋਰ ਯੁੱਧ ਮਚਾਇਆ ॥੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "हो तुमुल जुधु दुहूँअन रण मधि मचाइओ ॥३६॥",
      "sourceLineId": "82895",
      "sourceShabadId": "7840",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਾੜਿ ਸਤ੍ਰੁ ਕਹ ਬਹੁਰਿ ਪਿਨਾਕੀ ਕੋਪੁ ਹੁਐ ॥",
      "transliteration": "taaR satr keh bahur pinaakee kop huaai ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਨੇ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਵੈਰੀ ਨੂੰ ਤਾੜਨਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "ताड़ि सत्रु कह बहुरि पिनाकी कोपु हुऐ ॥",
      "sourceLineId": "82896",
      "sourceShabadId": "7840",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹਣੈ ਦੁਸਟ ਕਹੁ ਬਾਣ ਨਿਖੰਗ ਤੇ ਕਾਢ ਦੁਐ ॥",
      "transliteration": "hanai dhusaT kahu baan nikha(n)g te kaadd dhuaai ||",
      "translation": "Then Shiva took out tow arrow from his quiver, and aiming them at the tyrant, he discharged them in great anger.",
      "punjabiViakhya": "ਅਤੇ ਭਥੇ ਵਿਚੋਂ ਦੋ ਤੀਰ ਕਢ ਕੇ ਦੁਸ਼ਟ ਨੂੰ ਮਾਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "हणै दुसट कहु बाण निखंग ते काढ दुऐ ॥",
      "sourceLineId": "82897",
      "sourceShabadId": "7840",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗਿਰਿਯੋ ਭੂਮਿ ਭੀਤਰਿ ਸਿਰਿ ਸਤ੍ਰੁ ਪ੍ਰਹਾਰਿਯੋ ॥",
      "transliteration": "giriyo bhoom bheetar sir satr prahaariyo ||",
      "translation": "The arrows struck the head of the enemy and he fell down on the earth",
      "punjabiViakhya": "ਜੋ (ਉਸ ਦੇ ਸਿਰ ਵਿਚ) ਲਗੇ ਅਤੇ ਉਹ ਧਰਤੀ ਉਤੇ ਡਿਗ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "गिरियो भूमि भीतरि सिरि सत्रु प्रहारियो ॥",
      "sourceLineId": "82898",
      "sourceShabadId": "7840",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹੋ ਜਨਕੁ ਗਾਜ ਕਰਿ ਕੋਪ ਬੁਰਜ ਕਹੁ ਮਾਰਿਯੋ ॥੩੭॥",
      "transliteration": "ho janak gaaj kar kop buraj kahu maariyo ||37||",
      "translation": "He fell like a column falling flat on the ground having been hit by lightning.37.",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ) ਮਾਨੋ ਬਿਜਲੀ ਨੇ ਕ੍ਰੋਧ ਕਰ ਕੇ ਬੁਰਜ ਨੂੰ ਡਿਗਾ ਦਿੱਤਾ ਹੋਵੇ ॥੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "हो जनकु गाज करि कोप बुरज कहु मारियो ॥३७॥",
      "sourceLineId": "82899",
      "sourceShabadId": "7840",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤੋਟਕ ਛੰਦ ॥",
      "transliteration": "toTak chha(n)dh ||",
      "translation": "TOTAK STANZA",
      "punjabiViakhya": "ਤੋਟਕ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "तोटक छंद ॥",
      "sourceLineId": "82900",
      "sourceShabadId": "7841",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਘਟਿ ਏਕ ਬਿਖੈ ਰਿਪੁ ਚੇਤ ਭਯੋ ॥",
      "transliteration": "ghaT ek bikhai rip chet bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਧਕ ਦੈਂਤ ਇਕ ਘੜੀ ਵਿਚ ਸੁਚੇਤ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "घटि एक बिखै रिपु चेत भयो ॥",
      "sourceLineId": "82901",
      "sourceShabadId": "7841",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਧਨੁ ਬਾਣ ਬਲੀ ਪੁਨਿ ਪਾਣਿ ਲਯੋ ॥",
      "transliteration": "dhan baan balee pun paan layo ||",
      "translation": "After one ghari (about 24 mintues), the enemy (Andhakasura) regained his senses and that mighty warrior again took bow and arrows in his hands.",
      "punjabiViakhya": "ਅਤੇ (ਉਸ) ਬਲਵਾਨ ਨੇ ਫਿਰ ਹੱਥ ਵਿਚ ਧਨੁਸ਼ ਬਾਣ ਲੈ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "धनु बाण बली पुनि पाणि लयो ॥",
      "sourceLineId": "82902",
      "sourceShabadId": "7841",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਰਿ ਕੋਪ ਕਵੰਡ ਕਰੇ ਕਰਖ੍ਰਯੰ ॥",
      "transliteration": "kar kop kava(n)dd kare karakhraya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਕਰ ਕੇ (ਉਸ ਨੇ) ਧਨੁਸ਼ ਨੂੰ ਹੱਥ ਨਾਲ ਖਿਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "करि कोप कवंड करे करख्रयं ॥",
      "sourceLineId": "82903",
      "sourceShabadId": "7841",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਰ ਧਾਰ ਬਲੀ ਘਨ ਜਿਯੋ ਬਰਖ੍ਰਯੋ ॥੩੮॥",
      "transliteration": "sar dhaar balee ghan jiyo barakhrayo ||38||",
      "translation": "The bow was pulled in his hands in great anger and a volley of arrows was showered like rain.38.",
      "punjabiViakhya": "ਅਤੇ ਬਦਲ ਵਾਗ (ਉਸ) ਬਲਵਾਨ ਨੇ ਤੀਰਾ ਦੀ ਬਰਖਾ ਸ਼ੁਰੂ ਕਰ ਦਿੱਤੀ ॥੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "सर धार बली घन जियो बरख्रयो ॥३८॥",
      "sourceLineId": "82904",
      "sourceShabadId": "7841",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਰਿ ਕੋਪ ਬਲੀ ਬਰਖ੍ਰਯੋ ਬਿਸਖੰ ॥",
      "transliteration": "kar kop balee barakhrayo bisakha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਬਲਵਾਨ ਦੈਂਤ ਬਾਣਾ ਦੀ ਬਰਖਾ ਕਰਨ ਲਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "करि कोप बली बरख्रयो बिसखं ॥",
      "sourceLineId": "82905",
      "sourceShabadId": "7841",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0181_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਇਹ ਓਰ ਲਗੈ ਨਿਸਰੇ ਦੁਸਰੰ ॥",
      "transliteration": "eeh or lagai nisare dhusara(n) ||",
      "translation": "In great ire, that mighty warrior began to discharge and shower his distinctively powerful arrows, which struck on one side came out from the other side.",
      "punjabiViakhya": "(ਉਹ ਤੀਰ) ਇਕ ਪਾਸਿਓਾਂ ਲਗ ਕੇ ਦੂਜੇ ਪਾਸੇ ਨਿਕਲਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": "इह ओर लगै निसरे दुसरं ॥",
      "sourceLineId": "82906",
      "sourceShabadId": "7841",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
