{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 182,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0182_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਬ ਕੋਪ ਕਰੰ ਸਿਵ ਸੂਲ ਲੀਯੋ ॥",
      "transliteration": "tab kop kara(n) siv sool leeyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਸ਼ਿਵ ਨੇ ਕ੍ਰੋਧ ਕਰ ਕੇ ਹੱਥ ਵਿਚ ਤ੍ਰਿਸ਼ੂਲ ਫੜ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "तब कोप करं सिव सूल लीयो ॥",
      "sourceLineId": "82907",
      "sourceShabadId": "7841",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਰਿ ਕੋ ਸਿਰੁ ਕਾਟਿ ਦੁਖੰਡ ਕੀਯੋ ॥੩੯॥",
      "transliteration": "ar ko sir kaaT dhukha(n)dd keeyo ||39||",
      "translation": "Then greatly infuriated, Shiva took the trident in his hand, and cut the head of the enemy into two parts.39.",
      "punjabiViakhya": "ਅਤੇ ਵੈਰੀ ਦਾ ਸਿਰ ਕਟ ਕੇ ਦੋ ਟੋਟੇ ਕਰ ਦਿੱਤੇ ॥੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "अरि को सिरु काटि दुखंड कीयो ॥३९॥",
      "sourceLineId": "82908",
      "sourceShabadId": "7841",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਪਿਨਾਕਿ ਪ੍ਰਬੰਧਹਿ ਅੰਧਕ ਬਧਹਿ ਰੁਦ੍ਰੋਸਤਤਿ ਧਯਾਇ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੦॥",
      "transliteration": "eit sree bachitr naaTake pinaak praba(n)dheh a(n)dhak badheh rudhrosatat dhayai samaapatam sat subham sat ||10||",
      "translation": "End of the description of the killing of the demon ANDHAK and the Eulogy of SHIVA in BACHITTAR NATAK.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਦੇ 'ਪਿਨਾਕਿਪ੍ਰਬੰਧਹ' 'ਅੰਧਕ-ਬਧ' ਅਤੇ 'ਰੁਦ੍ਰ-ਉਸਤਤ' ਵਾਲੇ ਅਧਿਆਇ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटके पिनाकि प्रबंधहि अंधक बधहि रुद्रोसतति धयाइ समापतम सतु सुभम सतु ॥१०॥",
      "sourceLineId": "82909",
      "sourceShabadId": "7841",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਥ ਗਉਰ ਬਧਹ ਕਥਨੰ ॥",
      "transliteration": "ath gaur badheh kathana(n) ||",
      "translation": "Now begins the description of the killing of Parbati:",
      "punjabiViakhya": "ਹੁਣ ਗੌਰੀ (ਪਾਰਬਤੀ) ਦੇ ਵੱਧ ਦਾ ਕਥਨ:",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "अथ गउर बधह कथनं ॥",
      "sourceLineId": "82910",
      "sourceShabadId": "7842",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ ॥",
      "transliteration": "sree bhagautee jee sahai ||",
      "translation": "Let Sri Bhagauti ji (The Primal Lord) be helpful.",
      "punjabiViakhya": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ:",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "स्री भगउती जी सहाइ ॥",
      "sourceLineId": "82911",
      "sourceShabadId": "7842",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤੋਟਕ ਛੰਦ ॥",
      "transliteration": "toTak chha(n)dh ||",
      "translation": "TOTAK STANZA",
      "punjabiViakhya": "ਤੋਟਕ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "तोटक छंद ॥",
      "sourceLineId": "82912",
      "sourceShabadId": "7842",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੁਰ ਰਾਜ ਪ੍ਰਸੰਨਿ ਭਏ ਤਬ ਹੀ ॥",
      "transliteration": "sur raaj prasa(n)n bhe tab hee ||",
      "translation": "",
      "punjabiViakhya": "ਇੰਦਰ ਦੇਵ ਉਦੋਂ ਪ੍ਰਸੰਨ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "सुर राज प्रसंनि भए तब ही ॥",
      "sourceLineId": "82913",
      "sourceShabadId": "7842",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਰਿ ਅੰਧਕ ਨਾਸ ਸੁਨਿਯੋ ਜਬ ਹੀ ॥",
      "transliteration": "ar a(n)dhak naas suniyo jab hee ||",
      "translation": "When Indra heard about the destruction of Andhakasura he was very much pleased.",
      "punjabiViakhya": "ਜਦੋਂ ਉਸ ਨੇ ਵੈਰੀ ਅੰਧਕ ਦਾ ਨਾਸ ਹੋਣਾ ਸੁਣਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "अरि अंधक नास सुनियो जब ही ॥",
      "sourceLineId": "82914",
      "sourceShabadId": "7842",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਇਮ ਕੈ ਦਿਨ ਕੇਤਕ ਬੀਤ ਗਏ ॥",
      "transliteration": "eim kai dhin ketak beet ge ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਕਈ ਦਿਨ ਬੀਤ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "इम कै दिन केतक बीत गए ॥",
      "sourceLineId": "82915",
      "sourceShabadId": "7842",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਿਵ ਧਾਮਿ ਸਤਕ੍ਰਿਤ ਜਾਤ ਭਏ ॥੧॥",
      "transliteration": "siv dhaam satakirat jaat bhe ||1||",
      "translation": "In this way, may days elapsed and Shiva also went to Indra’s place.1.",
      "punjabiViakhya": "ਤਾ ਇਕ ਦਿਨ ਸ਼ਿਵ ਇੰਦਰ ਦੇ ਘਰ ਗਿਆ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "सिव धामि सतकृत जात भए ॥१॥",
      "sourceLineId": "82916",
      "sourceShabadId": "7842",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਬ ਰੁਦ੍ਰ ਭਯਾਨਕ ਰੂਪ ਧਰਿਯੋ ॥",
      "transliteration": "tab rudhr bhayaanak roop dhariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਸ਼ਿਵ ਨੇ ਭਿਆਨਕ ਰੂਪ ਧਾਰਨ ਕੀਤਾ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "तब रुद्र भयानक रूप धरियो ॥",
      "sourceLineId": "82917",
      "sourceShabadId": "7842",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਰਿ ਹੇਰਿ ਹਰੰ ਹਥਿਯਾਰ ਹਰਿਯੋ ॥",
      "transliteration": "har her hara(n) hathiyaar hariyo ||",
      "translation": "Then Rudra manifested himself in a dreadful form  seeing Shiva, Indra discharged his wapons.",
      "punjabiViakhya": "ਇੰਦਰ ਨੇ ਸ਼ਿਵ ਨੂੰ ਵੇਖ ਕੇ ਉਸ ਉਤੇ ਹਥਿਆਰ ਸੁਟਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "हरि हेरि हरं हथियार हरियो ॥",
      "sourceLineId": "82918",
      "sourceShabadId": "7842",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਬ ਹੀ ਸਿਵ ਕੋਪ ਅਖੰਡ ਕੀਯੋ ॥",
      "transliteration": "tab hee siv kop akha(n)dd keeyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਦੋਂ ਸ਼ਿਵ ਨੇ ਵੀ ਅਖੰਡ ਕ੍ਰੋਧ ਕੀਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "तब ही सिव कोप अखंड कीयो ॥",
      "sourceLineId": "82919",
      "sourceShabadId": "7842",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਕ ਜਨਮ ਅੰਗਾਰ ਅਪਾਰ ਲੀਯੋ ॥੨॥",
      "transliteration": "eik janam a(n)gaar apaar leeyo ||2||",
      "translation": "Then Shiva was highly infuriated and blazed like a live charcoal.2.",
      "punjabiViakhya": "ਜਿਸ ਤੋਂ ਇਕ ਅਪਾਰ ਅੰਗਾਰ ਨੇ ਜਨਮ ਲਿਆ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "इक जनम अंगार अपार लीयो ॥२॥",
      "sourceLineId": "82920",
      "sourceShabadId": "7842",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਿਹ ਤੇਜ ਜਰੇ ਜਗ ਜੀਵ ਸਬੈ ॥",
      "transliteration": "teh tej jare jag jeev sabai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਅੰਗਾਰ ਦੇ ਤੇਜ ਨਾਲ ਜਗਤ ਦੇ ਸਾਰੇ ਜੀਵ ਸੜਨ ਲਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "तिह तेज जरे जग जीव सबै ॥",
      "sourceLineId": "82921",
      "sourceShabadId": "7842",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਿਹ ਡਾਰ ਦਯੋ ਮਧਿ ਸਿੰਧੁ ਤਬੈ ॥",
      "transliteration": "teh ddaar dhayo madh si(n)dh tabai ||",
      "translation": "With that blaze, all the beings of the world began to burn. Then Shiva in order to pacify his anger threw his weapon and anger into the sea",
      "punjabiViakhya": "(ਇਸ ਕਰ ਕੇ) ਉਸ ਨੂੰ ਉਸ ਵੇਲੇ ਸਮੁੰਦਰ ਵਿਚ ਸੁਟ ਦਿੱਤਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "तिह डार दयो मधि सिंधु तबै ॥",
      "sourceLineId": "82922",
      "sourceShabadId": "7842",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੋਊ ਡਾਰ ਦਯੋ ਸਿੰਧੁ ਮਹਿ ਨ ਗਯੋ ॥",
      "transliteration": "souoo ddaar dhayo si(n)dh meh na gayo ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਸੁਟੇ ਜਾਣ ਤੇ ਸਮੁੰਦਰ ਨੇ ਉਸ ਨੂੰ ਗ੍ਰਹਿਣ ਨਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "सोऊ डार दयो सिंधु महि न गयो ॥",
      "sourceLineId": "82923",
      "sourceShabadId": "7842",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਿਹ ਆਨਿ ਜਲੰਧਰ ਰੂਪ ਲਯੋ ॥੩॥",
      "transliteration": "teh aan jala(n)dhar roop layo ||3||",
      "translation": "But it could not be drowned and manifested itself in the from of the demon Jalandhar.3.",
      "punjabiViakhya": "ਇਸ ਕਰ ਕੇ ਉਸ ਨੇ ਧਰਤੀ ਉਤੇ ਆ ਕੇ ਜਲੰਧਰ ਦਾ ਰੂਪ ਧਾਰਨ ਕੀਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "तिह आनि जलंधर रूप लयो ॥३॥",
      "sourceLineId": "82924",
      "sourceShabadId": "7842",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "82925",
      "sourceShabadId": "7843",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਭਯੋ ਅਸੁਰ ਬਲਵਾਨਾ ॥",
      "transliteration": "eeh bidh bhayo asur balavaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਬਲਵਾਨ ਦੈਂਤ ਪ੍ਰਗਟ ਹੋਇਆ ਅਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "इह बिधि भयो असुर बलवाना ॥",
      "sourceLineId": "82926",
      "sourceShabadId": "7843",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਲਯੋ ਕੁਬੇਰ ਕੋ ਲੂਟ ਖਜਾਨਾ ॥",
      "transliteration": "layo kuber ko looT khajaanaa ||",
      "translation": "In this way, this demon grew in strength excessively and he also looted the treasure of Kuber.",
      "punjabiViakhya": "ਉਸ ਨੇ ਕੁਬੇਰ ਦਾ ਖ਼ਜ਼ਾਨਾ ਲੁਟ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "लयो कुबेर को लूट खजाना ॥",
      "sourceLineId": "82927",
      "sourceShabadId": "7843",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪਕਰ ਸਮਸ ਤੇ ਬ੍ਰਹਮੁ ਰੁਵਾਯੋ ॥",
      "transliteration": "pakar samas te braham ruvaayo ||",
      "translation": "",
      "punjabiViakhya": "ਦਾੜ੍ਰਹੀ ਤੋਂ ਪਕੜ ਕੇ ਬ੍ਰਹਮਾ ਨੂੰ ਰੁਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "पकर समस ते ब्रहमु रुवायो ॥",
      "sourceLineId": "82928",
      "sourceShabadId": "7843",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇੰਦ੍ਰ ਜੀਤਿ ਸਿਰ ਛਤ੍ਰ ਢੁਰਾਯੋ ॥੪॥",
      "transliteration": "ei(n)dhr jeet sir chhatr dduraayo ||4||",
      "translation": "He caught Brahma and caused him to weep, and conquering Indra, He seized his canopy and swung over his head.4.",
      "punjabiViakhya": "ਅਤੇ ਇੰਦਰ ਨੂੰ ਜਿਤ ਕੇ (ਆਪਣੇ) ਸਿਰ ਉਤੇ ਛੱਤਰ ਝੁਲਵਾਇਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "इंद्र जीति सिर छत्र ढुरायो ॥४॥",
      "sourceLineId": "82929",
      "sourceShabadId": "7843",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜੀਤਿ ਦੇਵਤਾ ਪਾਇ ਲਗਾਏ ॥",
      "transliteration": "jeet dhevataa pai lagaae ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤਿਆਂ ਨੂੰ ਜਿਤ ਕੇ ਆਪਣੀ ਚਰਨੀ ਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "जीति देवता पाइ लगाए ॥",
      "sourceLineId": "82930",
      "sourceShabadId": "7843",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਰੁਦ੍ਰ ਬਿਸਨੁ ਨਿਜ ਪੁਰੀ ਬਸਾਏ ॥",
      "transliteration": "rudhr bisan nij puree basaae ||",
      "translation": "After conquering the gods, he caused them to fall at his feet and forced Vishnu and Shiva to abide only within their own cities.l",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਿਵ ਤੇ ਵਿਸ਼ਣੂ ਨੂੰ (ਲਿਆ ਕੇ) ਆਪਣੇ ਸ਼ਹਿਰ ਵਿਚ ਵਸਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "रुद्र बिसनु निज पुरी बसाए ॥",
      "sourceLineId": "82931",
      "sourceShabadId": "7843",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਚਉਦਹ ਰਤਨ ਆਨਿ ਰਾਖੇ ਗ੍ਰਿਹ ॥",
      "transliteration": "chaudheh ratan aan raakhe gireh ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਚੌਦਾ ਰਤਨ ਲਿਆ ਕੇ ਆਪਣੇ ਘਰ ਵਿਚ ਪਾ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "चउदह रतन आनि राखे गृह ॥",
      "sourceLineId": "82932",
      "sourceShabadId": "7843",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਹਾ ਤਹਾ ਬੈਠਾਏ ਨਵ ਗ੍ਰਹ ॥੫॥",
      "transliteration": "jahaa tahaa baiThaae nav greh ||5||",
      "translation": "He gathered all the fourteen jewels in his own house and fixed the polaces on nine planets at his will.5.",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ (ਲੋਕਾ ਨੂੰ ਦੁਖ ਦੇਣ ਲਈ) ਨੌਂ ਗ੍ਰਹਿ ਬਿਠਾ ਦਿੱਤੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "जहा तहा बैठाए नव ग्रह ॥५॥",
      "sourceLineId": "82933",
      "sourceShabadId": "7843",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "82934",
      "sourceShabadId": "7844",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜੀਤਿ ਬਸਾਏ ਨਿਜ ਪੁਰੀ ਅਸੁਰ ਸਕਲ ਅਸੁਰਾਰ ॥",
      "transliteration": "jeet basaae nij puree asur sakal asuraar ||",
      "translation": "The demon-king, conquering all, caused them to live in his own territory.",
      "punjabiViakhya": "(ਜਲੰਧਰ ਨੇ) ਸਾਰਿਆਂ ਦੇਵਤਿਆਂ ਅਤੇ ਦੈਂਤਾ ਨੂੰ ਜਿਤ ਕੇ ਆਪਣੀ ਪੁਰੀ ਵਿਚ ਲਿਆ ਵਸਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "जीति बसाए निज पुरी असुर सकल असुरार ॥",
      "sourceLineId": "82935",
      "sourceShabadId": "7844",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪੂਜਾ ਕਰੀ ਮਹੇਸ ਕੀ ਗਿਰਿ ਕੈਲਾਸ ਮਧਾਰ ॥੬॥",
      "transliteration": "poojaa karee mahes kee gir kailaas madhaar ||6||",
      "translation": "The gods went to Kailash mountain and worshipped him.6.",
      "punjabiViakhya": "ਕੈਲਾਸ਼ ਪਰਬਤ ਉਤੇ ਜਾ ਕੇ ਮਹੇਸ਼ ਦੀ ਪੂਜਾ ਕੀਤੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "पूजा करी महेस की गिरि कैलास मधार ॥६॥",
      "sourceLineId": "82936",
      "sourceShabadId": "7844",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "82937",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਧ੍ਰਯਾਨ ਬਿਧਾਨ ਕਰੇ ਬਹੁ ਭਾਤਾ ॥",
      "transliteration": "dhrayaan bidhaan kare bahu bhaataa ||",
      "translation": "",
      "punjabiViakhya": "(ਜਲੰਧਰ) ਨੇ ਬਹੁਤ ਵਿਧੀਆਂ ਨਾਲ ਸ਼ਿਵ ਦਾ ਧਿਆਨ ਧਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "ध्रयान बिधान करे बहु भाता ॥",
      "sourceLineId": "82938",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੇਵਾ ਕਰੀ ਅਧਿਕ ਦਿਨ ਰਾਤਾ ॥",
      "transliteration": "sevaa karee adhik dhin raataa ||",
      "translation": "They performed various types of mediation, worship and service day and service day and night for a long time.",
      "punjabiViakhya": "ਅਤੇ ਦਿਨ ਰਾਤ ਬਹੁਤ ਸੇਵਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "सेवा करी अधिक दिन राता ॥",
      "sourceLineId": "82939",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਐਸ ਭਾਤਿ ਤਿਹ ਕਾਲ ਬਿਤਾਯੋ ॥",
      "transliteration": "aais bhaat teh kaal bitaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਨਾਲ ਉਸ ਨੇ ਕੁਝ ਸਮਾ ਬਿਤਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "ऐस भाति तिह काल बितायो ॥",
      "sourceLineId": "82940",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਬ ਪ੍ਰਸੰਗਿ ਸਿਵ ਊਪਰ ਆਯੋ ॥੭॥",
      "transliteration": "ab prasa(n)g siv uoopar aayo ||7||",
      "translation": "Now everything depended on the support of Shiva.7.",
      "punjabiViakhya": "ਹੁਣ ਪ੍ਰਸੰਗ ਸ਼ਿਵ ਵਲ ਆਉਾਂਦਾ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "अब प्रसंगि सिव ऊपर आयो ॥७॥",
      "sourceLineId": "82941",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭੂਤਰਾਟ ਕੋ ਨਿਰਖਿ ਅਤੁਲ ਬਲ ॥",
      "transliteration": "bhootaraaT ko nirakh atul bal ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਦਾ ਅਤੁੱਲ ਬਲ ਵੇਖ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "भूतराट को निरखि अतुल बल ॥",
      "sourceLineId": "82942",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਾਪਤ ਭਏ ਅਨਿਕ ਅਰਿ ਜਲ ਥਲ ॥",
      "transliteration": "kaapat bhe anik ar jal thal ||",
      "translation": "All the enemies on water and land trembled, seeing the innumerable forces of Shiva, the lord of ghosts.",
      "punjabiViakhya": "ਜਲ ਥਲ ਵਿਚ ਰਹਿਣ ਵਾਲੇ ਅਨੇਕਾ ਵੈਰੀ ਕੰਬਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "कापत भए अनिक अरि जल थल ॥",
      "sourceLineId": "82943",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦਛ ਪ੍ਰਜਾਪਤਿ ਹੋਤ ਨ੍ਰਿਪਤ ਬਰ ॥",
      "transliteration": "dhachh prajaapat hot nirapat bar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਸਮੇਾਂ ਦਕਸ਼ ਪ੍ਰਜਾਪਤੀ ਨਾ ਦਾ ਇਕ ਉਤੱਮ ਰਾਜਾ ਹੋਇਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "दछ प्रजापति होत नृपत बर ॥",
      "sourceLineId": "82944",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦਸ ਸਹੰਸ੍ਰ ਦੁਹਿਤਾ ਤਾ ਕੇ ਘਰ ॥੮॥",
      "transliteration": "dhas saha(n)sr dhuhitaa taa ke ghar ||8||",
      "translation": "Out of all the kings, the king Daksha was most respected, who had ten thousand daughters in his home.8.",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਘਰ ਦਸ ਹਜ਼ਾਰ ਪੁੱਤਰੀਆਂ (ਪੈਦਾ ਹੋਈਆਂ) ਸਨ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "दस सहंस्र दुहिता ता के घर ॥८॥",
      "sourceLineId": "82945",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਿਨ ਇਕ ਬਾਰ ਸੁਯੰਬਰ ਕੀਯਾ ॥",
      "transliteration": "tin ik baar suya(n)bar keeyaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਕ ਵਾਰ ਸੁਅੰਬਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "तिन इक बार सुयंबर कीया ॥",
      "sourceLineId": "82946",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦਸ ਸਹੰਸ੍ਰ ਦੁਹਿਤਾਇਸ ਦੀਯਾ ॥",
      "transliteration": "dhas saha(n)sr dhuhitais dheeyaa ||",
      "translation": "Once that king held a swayyamvara at his place and permitted his ten thousand daughters.",
      "punjabiViakhya": "ਅਤੇ ਦਸ ਹਜ਼ਾਰ ਰਾਜ-ਕੰਨਿਆਵਾ ਨੂੰ ਆਗਿਆ ਦਿੱਤੀ ਕਿ",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "दस सहंस्र दुहिताइस दीया ॥",
      "sourceLineId": "82947",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜੋ ਬਰੁ ਰੁਚੇ ਬਰਹੁ ਅਬ ਸੋਈ ॥",
      "transliteration": "jo bar ruche barahu ab soiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਜੋ ਵਰ ਚੰਗਾ ਲਗਦਾ ਹੈ, ਹੁਣੇ ਉਹੀ ਵਰ ਲਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "जो बरु रुचे बरहु अब सोई ॥",
      "sourceLineId": "82948",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਊਚ ਨੀਚ ਰਾਜਾ ਹੋਇ ਕੋਈ ॥੯॥",
      "transliteration": "uooch neech raajaa hoi koiee ||9||",
      "translation": "To wed according to their interest forsaking all thought of high and low in society.9.",
      "punjabiViakhya": "(ਭਾਵੇਾਂ) ਕੋਈ ਰਾਜਾ ਜਾ ਊਚ-ਨੀਚ (ਕਿਉਾਂ ਨਾ) ਹੋਵੇ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "ऊच नीच राजा होइ कोई ॥९॥",
      "sourceLineId": "82949",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜੋ ਜੋ ਜਿਸੈ ਰੁਚਾ ਤਿਨਿ ਬਰਾ ॥",
      "transliteration": "jo jo jisai ruchaa tin baraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਜੋ ਜੋ (ਵਰ) ਚੰਗਾ ਲਗਿਆ ਉਸ ਨੇ ਉਸ ਨੂੰ ਵਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "जो जो जिसै रुचा तिनि बरा ॥",
      "sourceLineId": "82950",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਬ ਪ੍ਰਸੰਗ ਨਹੀ ਜਾਤ ਉਚਰਾ ॥",
      "transliteration": "sab prasa(n)g nahee jaat ucharaa ||",
      "translation": "Each one of them wed whomsoever she liked, but all such anecdotes cannot be described",
      "punjabiViakhya": "ਸਾਰਾ ਪ੍ਰਸੰਗ ਉਚਾਰਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "सब प्रसंग नही जात उचरा ॥",
      "sourceLineId": "82951",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜੋ ਬਿਰਤਾਤ ਕਹਿ ਛੋਰਿ ਸੁਨਾਊ ॥",
      "transliteration": "jo birataat keh chhor sunaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਮੁੱਢ ਤੋਂ ਸਾਰਾ ਬ੍ਰਿੱਤਾਤ ਕਹਿ ਕੇ ਸੁਣਾਵਾ,",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "जो बिरतात कहि छोरि सुनाऊ ॥",
      "sourceLineId": "82952",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਥਾ ਬ੍ਰਿਧਿ ਤੇ ਅਧਿਕ ਡਰਾਊ ॥੧੦॥",
      "transliteration": "kathaa biradh te adhik ddaraauoo ||10||",
      "translation": "It all of them are narrated in detail, then there will always be the fear of increasing the volume.10.",
      "punjabiViakhya": "ਤਾ ਕਥਾ ਦੇ ਵੱਧ ਜਾਣ ਤੋਂ ਡਰਦਾ ਹਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": "कथा बृधि ते अधिक डराऊ ॥१०॥",
      "sourceLineId": "82953",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0182_line_0048",
      "lineIndex": 48,
