{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 183,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0183_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕੇਤਕ ਬ੍ਯਾਹ ਚੰਦ੍ਰਮਾ ਲੀਨੀ ॥",
      "transliteration": "ketak bayaeh cha(n)dhramaa leenee ||",
      "translation": "Four daughters were given to the sage Kashyap, and many of the daughters married the god Chandrama (moon).",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਚੰਦ੍ਰਮਾ ਨੇ ਵਿਆਹ ਲਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "केतक ब्याह चंद्रमा लीनी ॥",
      "sourceLineId": "82955",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕੇਤਕ ਗਈ ਅਉਰ ਦੇਸਨ ਮਹਿ ॥",
      "transliteration": "ketak giee aaur dhesan meh ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ (ਪੁੱਤਰੀਆਂ) ਦੂਜੇ ਦੇਸ਼ਾ ਵਿਚ ਗਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "केतक गई अउर देसन महि ॥",
      "sourceLineId": "82956",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਰਿਯੋ ਗਉਰਜਾ ਏਕ ਰੁਦ੍ਰ ਕਹਿ ॥੧੧॥",
      "transliteration": "bariyo gaurajaa ek rudhr keh ||11||",
      "translation": "Many of them went to foreign countries, but Guri (Parvait) named and married Shiva.11.",
      "punjabiViakhya": "ਗੌਰਜਾ (ਨਾ ਦੀ ਇਕ ਪੁੱਤਰੀ) ਨੇ ਰੁਦਰ ਨਾਲ ਵਿਆਹ ਕੀਤਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "बरियो गउरजा एक रुद्र कहि ॥११॥",
      "sourceLineId": "82957",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਬ ਹੀ ਬ੍ਯਾਹ ਰੁਦ੍ਰ ਗ੍ਰਿਹਿ ਆਨੀ ॥",
      "transliteration": "jab hee bayaeh rudhr gireh aanee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਸ਼ਿਵ ਨੇ (ਗੌਰੀ ਨੂੰ) ਵਿਆਹ ਕੇ ਘਰ ਲੈ ਆਉਾਂਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "जब ही ब्याह रुद्र गृहि आनी ॥",
      "sourceLineId": "82958",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚਲੀ ਜਗ ਕੀ ਬਹੁਰਿ ਕਹਾਨੀ ॥",
      "transliteration": "chalee jag kee bahur kahaanee ||",
      "translation": "When, after wedding, Parvati reached the home of Shiva (Rudra), the many types of narratives became prevalent.",
      "punjabiViakhya": "ਤਾ ਫਿਰ (ਉਸ ਤੋਂ ਕਾਫੀ ਦੇਰ ਬਾਦ) ਪ੍ਰਜਾਪਤੀ ਦੇ ਘਰ ਯੱਗ ਦੀ ਗੱਲ ਚਲ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "चली जग की बहुरि कहानी ॥",
      "sourceLineId": "82959",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਬ ਦੁਹਿਤਾ ਤਿਹ ਬੋਲਿ ਪਠਾਈ ॥",
      "transliteration": "sab dhuhitaa teh bol paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸਨੇ ਸਾਰੀਆਂ ਧੀਆਂ ਨੂੰ ਬੁਲਾ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "सब दुहिता तिह बोलि पठाई ॥",
      "sourceLineId": "82960",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਲੀਨੋ ਸੰਗਿ ਭਤਾਰਨ ਆਈ ॥੧੨॥",
      "transliteration": "leeno sa(n)g bhataaran aaiee ||12||",
      "translation": "The king called all his daughters and all of them came to their father’s home alongwith their husband.12.",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਆਪਣੇ ਪਤੀਆਂ ਸਹਿਤ (ਪਿਤਾ ਦੇ ਘਰ) ਆਈਆਂ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "लीनो संगि भतारन आई ॥१२॥",
      "sourceLineId": "82961",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੇ ਜੇ ਹੁਤੇ ਦੇਸ ਪਰਦੇਸਾ ॥",
      "transliteration": "je je hute dhes paradhesaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੜੇ ਜਿਹੜੇ ਦੇਸ਼ਾ ਪ੍ਰਦੇਸ਼ਾ (ਵਿਚ ਰਾਜੇ ਦੇ ਜੁਆਈ ਸਨ)",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "जे जे हुते देस परदेसा ॥",
      "sourceLineId": "82962",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਾਤ ਭਏ ਸਸੁਰਾਰਿ ਨਰੇਸਾ ॥",
      "transliteration": "jaat bhe sasuraar naresaa ||",
      "translation": "All the kings within and outside the country, began to reach at the house of their father-in-law.",
      "punjabiViakhya": "ਉਹ ਸਾਰੇ ਸਹੁਰੇ ਘਰ ਨੂੰ ਚਲੇ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "जात भए ससुरारि नरेसा ॥",
      "sourceLineId": "82963",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਿਰਖਿ ਰੁਦ੍ਰ ਕੋ ਅਉਰ ਪ੍ਰਕਾਰਾ ॥",
      "transliteration": "nirakh rudhr ko aaur prakaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਨੂੰ ਹੋਰ ਜਿਹੇ ਰੂਪ ਵਾਲਾ ਵੇਖ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "निरखि रुद्र को अउर प्रकारा ॥",
      "sourceLineId": "82964",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਿਨਹੂੰ ਨ ਭੂਪਤਿ ਤਾਹਿ ਚਿਤਾਰਾ ॥੧੩॥",
      "transliteration": "kinahoo(n) na bhoopat taeh chitaaraa ||13||",
      "translation": "Considering the queer dressing habits of Rudra, no one could think of him.13.",
      "punjabiViakhya": "ਪ੍ਰਜਾਪਤੀ ਅਤੇ ਹੋਰ ਕਿਸੇ ਨੇ ਵੀ ਉਸ ਨੂੰ ਰਾਜਾ ਨਾ ਸਮਝਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "किनहूँ न भूपति ताहि चितारा ॥१३॥",
      "sourceLineId": "82965",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਹਨ ਗਉਰਜਾ ਦਛ ਬੁਲਾਈ ॥",
      "transliteration": "nahan gaurajaa dhachh bulaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਆਪਣੀ ਪੁੱਤਰੀ) ਗੌਰਜਾ ਨੂੰ ਵੀ ਦਕਸ਼ ਨੇ ਨਹੀਂ ਬੁਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "नहन गउरजा दछ बुलाई ॥",
      "sourceLineId": "82966",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੁਨਿ ਨਾਰਦ ਤੇ ਹ੍ਰਿਦੈ ਰਿਸਾਈ ॥",
      "transliteration": "sun naaradh te hiradhai risaiee ||",
      "translation": "The king Daksha did not invite Gauri  then Gauri heard about it from the mouth of Narad, she got extremely angry in her mind.",
      "punjabiViakhya": "ਨਾਰਦ ਪਾਸੋਂ (ਪਿਤਾ ਦੇ ਘਰ ਯੱਗ ਦੀ ਗੱਲ) ਸੁਣ ਕੇ (ਗੌਰਜਾ) ਹਿਰਦੇ ਵਿਚ ਬਹੁਤ ਕ੍ਰੋਧਵਾਨ ਹੋਈ",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "सुनि नारद ते हृदै रिसाई ॥",
      "sourceLineId": "82967",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਿਨ ਬੋਲੇ ਪਿਤ ਕੇ ਗ੍ਰਿਹ ਗਈ ॥",
      "transliteration": "bin bole pit ke gireh giee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਿਨਾ ਬੁਲਾਏ ਪਿਤਾ ਦੇ ਘਰ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "बिन बोले पित के गृह गई ॥",
      "sourceLineId": "82968",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਨਿਕ ਪ੍ਰਕਾਰ ਤੇਜ ਤਨ ਤਈ ॥੧੪॥",
      "transliteration": "anik prakaar tej tan tiee ||14||",
      "translation": "She went to her father’s house without telling anybody, and her body and mind were emotionally blazing.14.",
      "punjabiViakhya": "(ਪਰ ਉਥੇ ਸਾਰਿਆਂ ਦਾ ਰੁਖਾ ਵਿਵਹਾਰ ਵੇਖ ਕੇ) ਅਨੇਕ ਤਰ੍ਰਹਾ ਨਾਲ ਤਨੋ ਮਨੋ ਸੜ ਗਈ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "अनिक प्रकार तेज तन तई ॥१४॥",
      "sourceLineId": "82969",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਗ ਕੁੰਡ ਮਹਿ ਪਰੀ ਉਛਰ ਕਰਿ ॥",
      "transliteration": "jag ku(n)dd meh paree uchhar kar ||",
      "translation": "",
      "punjabiViakhya": "(ਆਪਣਾ ਅਤੇ ਪਤੀ ਦਾ ਨਿਰਾਦਰ ਵੇਖ ਕੇ ਗੌਰਜਾ) ਉਛਲ ਕੇ ਯੱਗ ਕੁੰਡ ਵਿਚ ਜਾ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "जग कुँड महि परी उछर करि ॥",
      "sourceLineId": "82970",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਤ ਪ੍ਰਤਾਪਿ ਪਾਵਕ ਭਈ ਸੀਤਰਿ ॥",
      "transliteration": "sat prataap paavak bhiee seetar ||",
      "translation": "Being extremely infuriated, she plunged into the sacrificial pit, and because of her dignified demeanour, the fire cooled down.",
      "punjabiViakhya": "(ਗੌਰਜਾ ਦੇ) ਸੱਤ ਅਤੇ ਪ੍ਰਤਾਪ ਨਾਲ ਯੱਗ ਅਗਨੀ ਸੀਤਲ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "सत प्रतापि पावक भई सीतरि ॥",
      "sourceLineId": "82971",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜੋਗ ਅਗਨਿ ਕਹੁ ਬਹੁਰਿ ਪ੍ਰਕਾਸਾ ॥",
      "transliteration": "jog agan kahu bahur prakaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ (ਗੌਰਜਾ ਨੇ) ਯੋਗ ਅਗਨੀ ਨੂੰ ਪ੍ਰਗਟ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "जोग अगनि कहु बहुरि प्रकासा ॥",
      "sourceLineId": "82972",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਾ ਤਨ ਕੀਯੋ ਪ੍ਰਾਨ ਕੋ ਨਾਸਾ ॥੧੫॥",
      "transliteration": "taa tan keeyo praan ko naasaa ||15||",
      "translation": "But Sati (Parvati) lighted her Yoga-fire and with that fire, her body was destroyed.15.",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਵਿਚ (ਕੁਦ ਕੇ) ਆਪਣੇ ਸ਼ਰੀਰ ਅਤੇ ਪ੍ਰਾਣਾ ਦਾ ਨਾਸ਼ ਕਰ ਦਿੱਤਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "ता तन कीयो प्रान को नासा ॥१५॥",
      "sourceLineId": "82973",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਆਇ ਨਾਰਦ ਇਮ ਸਿਵਹਿ ਜਤਾਈ ॥",
      "transliteration": "aai naaradh im siveh jataiee ||",
      "translation": "",
      "punjabiViakhya": "ਨਾਰਦ ਨੇ ਆ ਕੇ ਸ਼ਿਵ ਨੂੰ ਸਾਰੀ ਗੱਲ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣਾਈ '",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "आइ नारद इम सिवहि जताई ॥",
      "sourceLineId": "82974",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਹਾ ਬੈਠਿ ਹੋ ਭਾਗ ਚੜਾਈ ॥",
      "transliteration": "kahaa baiTh ho bhaag chaRaiee ||",
      "translation": "Narad, on the other side, came to Shiva and said, “Why art thou sitting here, having been intoxicated with hemp (and there Guari hath burnt herself alive)?”",
      "punjabiViakhya": "ਤੂੰ ਭੰਗ ਪੀ ਕੇ ਇਥੇ ਬੈਠਾ ਹੈਂ, (ਉਧਰ ਗੌਰਜਾ ਯੱਗ ਦੇ ਕੁੰਡ ਵਿਚ ਸੜ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "कहा बैठि हो भाग चड़ाई ॥",
      "sourceLineId": "82975",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਛੂਟਿਯੋ ਧਿਆਨ ਕੋਪੁ ਜੀਯ ਜਾਗਾ ॥",
      "transliteration": "chhooTiyo dhiaan kop jeey jaagaa ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ ਸੁਣਦਿਆਂ ਹੀ ਸ਼ਿਵ ਦਾ) ਧਿਆਨ ਛੁਟ ਗਿਆ ਅਤੇ ਮਨ ਵਿਚ ਕ੍ਰੋਧ ਪੈਦਾ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": "छूटियो धिआन कोपु जीय जागा ॥",
      "sourceLineId": "82976",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0183_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗਹਿ ਤ੍ਰਿਸੂਲ ਤਹ ਕੋ ਉਠ ਭਾਗਾ ॥੧੬॥",
      "transliteration": "geh tirasool teh ko uTh bhaagaa ||16||",
