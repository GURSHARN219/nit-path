{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 184,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0184_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਲਯੋ ਉਠਾਇ ਸੂਲ ਕਰਿ ਬਲੈ ॥",
      "transliteration": "layo uThai sool kar balai ||",
      "translation": "When Shiva reached the place where Sati had burnt herself, he caught his trident also very firmly.",
      "punjabiViakhya": "(ਤਦੋਂ) ਜ਼ੋਰ ਨਾਲ ਤ੍ਰਿਸ਼ੂਲ ਨੂੰ ਹੱਥ ਵਿਚ ਉਠਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "लयो उठाइ सूल करि बलै ॥",
      "sourceLineId": "82979",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਿਨ ਕਰੇ ਪ੍ਰਹਾਰਾ ॥",
      "transliteration": "bhaat bhaat tin kare prahaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਕਈ ਤਰ੍ਰਹਾ ਨਾਲ ਵਾਰ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तिन करे प्रहारा ॥",
      "sourceLineId": "82980",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਕਲ ਬਿਧੁੰਸ ਜਗ ਕਰ ਡਾਰਾ ॥੧੭॥",
      "transliteration": "sakal bidhu(n)s jag kar ddaaraa ||17||",
      "translation": "With blows of various types, he destroyed the merit of the whole Yajna (sacrifice).17.",
      "punjabiViakhya": "ਸਾਰੇ ਯੱਗ ਨੂੰ ਨਸ਼ਟ ਕਰ ਦਿੱਤਾ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "सकल बिधुँस जग कर डारा ॥१७॥",
      "sourceLineId": "82981",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਭੂਪ ਸੰਘਾਰੇ ॥",
      "transliteration": "bhaat bhaat tan bhoop sa(n)ghaare ||",
      "translation": "",
      "punjabiViakhya": "(ਸ਼ਿਵ ਨੇ) ਤਰ੍ਰਹਾ ਤਰ੍ਰਹਾ ਨਾਲ ਰਾਜਿਆਂ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन भूप संघारे ॥",
      "sourceLineId": "82982",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਇਕ ਇਕ ਤੇ ਕਰ ਦੁਇ ਦੁਇ ਡਾਰੇ ॥",
      "transliteration": "eik ik te kar dhui dhui ddaare ||",
      "translation": "He destroyed many kings and chopped their bodies into bits.",
      "punjabiViakhya": "ਇਕ ਇਕ ਦੇ ਦੋ ਦੋ (ਟੋਟੇ) ਕਰ ਸੁਟੇ।",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "इक इक ते कर दुइ दुइ डारे ॥",
      "sourceLineId": "82983",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਾ ਕਹੁ ਪਹੁੰਚਿ ਤ੍ਰਿਸੂਲ ਪ੍ਰਹਾਰਾ ॥",
      "transliteration": "jaa kahu pahu(n)ch tirasool prahaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਕ ਪਹੁੰਚ ਕੇ ਤ੍ਰਿਸ਼ੂਲ ਦਾ ਵਾਰ ਕੀਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "जा कहु पहुँचि तृसूल प्रहारा ॥",
      "sourceLineId": "82984",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਾ ਕਹੁ ਮਾਰ ਠਉਰ ਹੀ ਡਾਰਾ ॥੧੮॥",
      "transliteration": "taa kahu maar Thaur hee ddaaraa ||18||",
      "translation": "On whomsoever the blow of the trident struck, he died there and then.18.",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਥਾ ਤੇ ਹੀ ਮਾਰ ਦਿੱਤਾ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "ता कहु मार ठउर ही डारा ॥१८॥",
      "sourceLineId": "82985",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਗ ਕੁੰਡ ਨਿਰਖਤ ਭਯੋ ਜਬ ਹੀ ॥",
      "transliteration": "jag ku(n)dd nirakhat bhayo jab hee ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਨੇ ਜਦੋਂ ਯੱਗ ਕੁੰਡ ਵਲ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "जग कुँड निरखत भयो जब ही ॥",
      "sourceLineId": "82986",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੂਟ ਜਟਾਨ ਉਖਾਰਸ ਤਬ ਹੀ ॥",
      "transliteration": "jooT jaTaan ukhaaras tab hee ||",
      "translation": "When Shiva looked into the sacrificial pit and saw he burnt body of Gauri, he began to pluck his matted hair.",
      "punjabiViakhya": "ਤਦੋਂ ਹੀ ਆਪਣੇ ਜੂੜੇ ਵਿਚੋਂ ਇਕ ਜਟਾ ਉਖਾੜ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "जूट जटान उखारस तब ही ॥",
      "sourceLineId": "82987",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬੀਰਭਦ੍ਰ ਤਬ ਕੀਆ ਪ੍ਰਕਾਸਾ ॥",
      "transliteration": "beerabhadhr tab keeaa prakaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਵੇਲੇ (ਉਸ ਵਿਚੋਂ) ਵੀਰ ਭੱਦਰ ਪ੍ਰਗਟ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "बीरभद्र तब कीआ प्रकासा ॥",
      "sourceLineId": "82988",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਉਪਜਤ ਕਰੋ ਨਰੇਸਨ ਨਾਸਾ ॥੧੯॥",
      "transliteration": "aupajat karo naresan naasaa ||19||",
      "translation": "At that time, Virbhandra manifested himself there and after his manifestation, he began to destroy the kings.19.",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਪੈਦਾ ਹੁੰਦੇ ਹੀ ਸ਼ਿਵ ਨੇ ਆਦੇਸ਼ ਦਿੱਤਾ ਕਿ (ਤੂੰ) ਰਾਜਿਆਂ ਦਾ ਨਾਸ਼ ਕਰ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "उपजत करो नरेसन नासा ॥१९॥",
      "sourceLineId": "82989",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕੇਤਕ ਕਰੇ ਖੰਡ ਨ੍ਰਿਪਤਿ ਬਰ ॥",
      "transliteration": "ketak kare kha(n)dd nirapat bar ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਸ੍ਰੇਸ਼ਠ ਰਾਜਿਆਂ ਦੇ (ਵੀਰ ਭੱਦਰ ਨੇ) ਟੋਟੇ ਟੋਟੇ ਕਰ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "केतक करे खंड नृपति बर ॥",
      "sourceLineId": "82990",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕੇਤਕ ਪਠੈ ਦਏ ਜਮ ਕੇ ਘਰਿ ॥",
      "transliteration": "ketak paThai dhe jam ke ghar ||",
      "translation": "He chopped several kings into part and sent several of them to the abode of Yama.",
      "punjabiViakhya": "ਅਤੇ ਕਈਆਂ ਨੂੰ ਜਮ ਦੇ ਘਰ ਭੇਜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "केतक पठै दए जम के घरि ॥",
      "sourceLineId": "82991",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕੇਤਕ ਗਿਰੇ ਧਰਣਿ ਬਿਕਰਾਰਾ ॥",
      "transliteration": "ketak gire dharan bikaraaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਨੇ ਹੀ ਨਿਤਾਣੇ ਹੋ ਕੇ ਧਰਤੀ ਉਤੇ ਜਾ ਡਿਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "केतक गिरे धरणि बिकरारा ॥",
      "sourceLineId": "82992",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਨੁ ਸਰਤਾ ਕੇ ਗਿਰੇ ਕਰਾਰਾ ॥੨੦॥",
      "transliteration": "jan sarataa ke gire karaaraa ||20||",
      "translation": "Just as with the flooding of the stream, the banks are eroded further, likewise many terrible warriors began to fall on the earth.20.",
      "punjabiViakhya": "ਮਾਨੋ ਨਦੀ ਦੇ ਕੰਢੇ ਡਿਗੇ ਪਏ ਹੋਣ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "जनु सरता के गिरे करारा ॥२०॥",
      "sourceLineId": "82993",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਬ ਲਉ ਸਿਵਹ ਚੇਤਨਾ ਆਈ ॥",
      "transliteration": "tab lau siveh chetanaa aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਦੋਂ ਤਕ ਸ਼ਿਵ ਨੂੰ (ਗੌਰਜਾ ਦੇ ਮਰਨ ਦਾ) ਚੇਤਾ ਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "तब लउ सिवह चेतना आई ॥",
      "sourceLineId": "82994",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗਹਿ ਪਿਨਾਕ ਕਹੁ ਪਰੋ ਰਿਸਾਈ ॥",
      "transliteration": "geh pinaak kahu paro risaiee ||",
      "translation": "At that time, Shiva regained his senses and fell on the enemy with his bow in his hand.",
      "punjabiViakhya": "(ਤਾ) ਪਿਨਾਕ ਧਨੁਸ਼ ਨੂੰ ਫੜ ਕੇ, ਗੁੱਸੇ ਨਾਲ ਟੁਟ ਕੇ ਪੈ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "गहि पिनाक कहु परो रिसाई ॥",
      "sourceLineId": "82995",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਾ ਕੈ ਤਾਣਿ ਬਾਣ ਤਨ ਮਾਰਾ ॥",
      "transliteration": "jaa kai taan baan tan maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਸ਼ਰੀਰ ਵਿਚ ਖਿਚ ਕੇ ਤੀਰ ਮਾਰਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "जा कै ताणि बाण तन मारा ॥",
      "sourceLineId": "82996",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪ੍ਰਾਨ ਤਜੇ ਤਿਨ ਪਾਨਿ ਨੁਚਾਰਾ ॥੨੧॥",
      "transliteration": "praan taje tin paan nuchaaraa ||21||",
      "translation": "Whomsoever Shiva struck his arrow by pulling his bow, he breathed his last there and then.21.",
      "punjabiViakhya": "ਉਸ ਨੇ ਪ੍ਰਾਣ ਤਜ ਦਿੱਤੇ ਅਤੇ ਪਾਣੀ ਵੀ ਨਾ ਮੰਗਿਆ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "प्रान तजे तिन पानि नुचारा ॥२१॥",
      "sourceLineId": "82997",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਡਮਾ ਡਮ ਡਉਰੂ ਬਹੁ ਬਾਜੇ ॥",
      "transliteration": "ddamaa ddam ddauroo bahu baaje ||",
      "translation": "",
      "punjabiViakhya": "ਡੰਮ ਡੰਮ ਕਰ ਕੇ ਬਹੁਤ ਡੌਰੂ ਵਜ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "डमा डम डउरू बहु बाजे ॥",
      "sourceLineId": "82998",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭੂਤ ਪ੍ਰੇਤ ਦਸਊ ਦਿਸਿ ਗਾਜੈ ॥",
      "transliteration": "bhoot pret dhasuoo dhis gaajai ||",
      "translation": "The tabors began to resound and in all the ten directions, the ghosts and fiends began to roar.",
      "punjabiViakhya": "ਭੂਤ ਪ੍ਰੇਤ ਦਸਾ ਦਿਸ਼ਾਵਾ ਵਿਚ ਗਜ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "भूत प्रेत दसऊ दिसि गाजै ॥",
      "sourceLineId": "82999",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਝਿਮ ਝਿਮ ਕਰਤ ਅਸਿਨ ਕੀ ਧਾਰਾ ॥",
      "transliteration": "jhim jhim karat asin kee dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਦੀ ਧਾਰ ਝਿੰਮ ਝਿੰਮ ਕਰਦੀ ਲਿਸ਼ਕਾਰੇ ਮਾਰ ਰਹੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "झिम झिम करत असिन की धारा ॥",
      "sourceLineId": "83000",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਾਚੇ ਰੁੰਡ ਮੁੰਡ ਬਿਕਰਾਰਾ ॥੨੨॥",
      "transliteration": "naache ru(n)dd mu(n)dd bikaraaraa ||22||",
      "translation": "The swords glittered and their blows were showered and the headless trunks began to dance on all the four sides.22.",
      "punjabiViakhya": "ਭਿਆਨਕ ਰੁੰਡ ਅਤੇ ਮੁੰਡ ਨਚ ਰਹੇ ਸਨ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "नाचे रुँड मुँड बिकरारा ॥२२॥",
      "sourceLineId": "83001",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਜੇ ਢੋਲ ਸਨਾਇ ਨਗਾਰੇ ॥",
      "transliteration": "baje ddol sanai nagaare ||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲ, ਡਫਾ ਅਤੇ ਨਗਾਰੇ ਵਜ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "बजे ढोल सनाइ नगारे ॥",
      "sourceLineId": "83002",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜੁਟੈ ਜੰਗ ਕੋ ਜੋਧ ਜੁਝਾਰੇ ॥",
      "transliteration": "juTai ja(n)g ko jodh jujhaare ||",
      "translation": "The trumpets and drums resounded and their sound was heard  the warriors fought bravely in the war.",
      "punjabiViakhya": "ਲੜਾਕੇ ਜੁਆਨ ਜੰਗ ਵਿਚ ਜੁਟ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "जुटै जंग को जोध जुझारे ॥",
      "sourceLineId": "83003",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਖਹਿ ਖਹਿ ਮਰੇ ਅਪਰ ਰਿਸ ਬਢੇ ॥",
      "transliteration": "kheh kheh mare apar ris badde ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਖਹਿ ਖਹਿ ਕੇ ਮਰ ਰਹੇ ਸਨ ਅਤੇ ਹੋਰਨਾ ਨੂੰ ਕ੍ਰੋਧ ਚੜ੍ਰਹ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "खहि खहि मरे अपर रिस बढे ॥",
      "sourceLineId": "83004",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਹੁਰਿ ਨ ਦੇਖੀਯਤ ਤਾਜੀਅਨ ਚਢੇ ॥੨੩॥",
      "transliteration": "bahur na dhekheeyat taajeean chadde ||23||",
      "translation": "They collided with one another, being filled with great anger, and they were never seen again, riding on their horses.23.",
      "punjabiViakhya": "ਇਸ ਪਿਛੋਂ ਘੋੜੇ ਉਤੇ ਚੜ੍ਰਹਿਆ ਹੋਇਆ ਕੋਈ ਵੀ ਨਹੀਂ ਸੀ ਦਿਸ ਰਿਹਾ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "बहुरि न देखीयत ताजीअन चढे ॥२३॥",
      "sourceLineId": "83005",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਾ ਪਰ ਮੁਸਟ ਤ੍ਰਿਸੂਲ ਪ੍ਰਹਾਰਾ ॥",
      "transliteration": "jaa par musaT tirasool prahaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਨੇ ਜਿਸ ਨੂੰ ਤ੍ਰਿਸ਼ੂਲ ਦੀ ਮੁਠ ਮਾਰ ਦਿੱਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "जा पर मुसट तृसूल प्रहारा ॥",
      "sourceLineId": "83006",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਾਕਹੁ ਠਉਰ ਮਾਰ ਹੀ ਡਾਰਾ ॥",
      "transliteration": "taakahu Thaur maar hee ddaaraa ||",
      "translation": "On whomsoever, there was the blow of the trident, held in the fist of Shiva, he was killed there and then,",
      "punjabiViakhya": "(ਬਸ) ਉਸਨੂੰ ਉਥੇ ਹੀ ਮਾਰ ਸੁਟਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "ताकहु ठउर मार ही डारा ॥",
      "sourceLineId": "83007",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਐਸੋ ਭਯੋ ਬੀਰ ਘਮਸਾਨਾ ॥",
      "transliteration": "aaiso bhayo beer ghamasaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਯੋਧਿਆਂ ਦਾ ਘਮਸਾਨ ਦਾ ਯੁੱਧ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "ऐसो भयो बीर घमसाना ॥",
      "sourceLineId": "83008",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭਕ ਭਕਾਇ ਤਹ ਜਗੇ ਮਸਾਨਾ ॥੨੪॥",
      "transliteration": "bhak bhakai teh jage masaanaa ||24||",
      "translation": "Virbhadra foutht such a fierce fight, that in great confusion, the ghosts and fiends were awakened.24.",
      "punjabiViakhya": "ਕਿ ਉਥੇ ਭਕ ਭਕ ਕਰ ਕੇ ਮਸਾਨ ਜਾਗ ਪਏ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "भक भकाइ तह जगे मसाना ॥२४॥",
      "sourceLineId": "83009",
      "sourceShabadId": "7845",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "83010",
      "sourceShabadId": "7846",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤੀਰ ਤਬਰ ਬਰਛੀ ਬਿਛੂਅ ਬਰਸੇ ਬਿਸਖ ਅਨੇਕ ॥",
      "transliteration": "teer tabar barachhee bichhooa barase bisakh anek ||",
      "translation": "The arrows, daggers, lances and other types of weapons were showered,",
      "punjabiViakhya": "ਅਨੇਕਾ ਤੀਰ, ਕੁਹਾੜੇ, ਬਰਛੀਆਂ, ਬਿਛੂਏ ਅਤੇ ਜ਼ਹਿਰ ਦੀ ਪਾਣ ਵਾਲੇ ਬਾਣ ਚਲੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "तीर तबर बरछी बिछूअ बरसे बिसख अनेक ॥",
      "sourceLineId": "83011",
      "sourceShabadId": "7846",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਬ ਸੂਰਾ ਜੂਝਤ ਭਏ ਸਾਬਤ ਬਚਾ ਨ ਏਕ ॥੨੫॥",
      "transliteration": "sab sooraa joojhat bhe saabat bachaa na ek ||25||",
      "translation": "And all the warriors fell as martyrs and none remained alive.25.",
      "punjabiViakhya": "ਸਾਰੇ ਸੂਰਮੇ ਲੜਦੇ ਹੋਏ ਸ਼ਹੀਦ ਹੋ ਗਏ, ਉਨ੍ਰਹਾ ਵਿਚੋਂ ਕੋਈ ਵੀ ਜ਼ਿੰਦਾ ਨਹੀਂ ਬਚਿਆ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "सब सूरा जूझत भए साबत बचा न एक ॥२५॥",
      "sourceLineId": "83012",
      "sourceShabadId": "7846",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "83013",
      "sourceShabadId": "7847",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਟਿ ਕਟਿ ਮਰੇ ਨਰੇਸ ਦੁਖੰਡਾ ॥",
      "transliteration": "kaT kaT mare nares dhukha(n)ddaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦੂਜੇ ਨੂੰ ਕੱਟ-ਵੱਢ ਕੇ ਰਾਜੇ ਦੋ ਦੋ ਟੋਟੇ ਹੋ ਕੇ ਮਰ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "कटि कटि मरे नरेस दुखंडा ॥",
      "sourceLineId": "83014",
      "sourceShabadId": "7847",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਾਇ ਹਨੇ ਗਿਰਿ ਗੇ ਜਨੁ ਝੰਡਾ ॥",
      "transliteration": "bai hane gir ge jan jha(n)ddaa ||",
      "translation": "The kings, chopped into bits, were lying the cluster of trees fallen down by the blow of wind.",
      "punjabiViakhya": "(ਉਹ ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦੇ ਹਨ) ਮਾਨੋ ਹਵਾ ਦੇ ਮਾਰੇ ਝੰਡੇ ਡਿਗੇ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "बाइ हने गिरि गे जनु झंडा ॥",
      "sourceLineId": "83015",
      "sourceShabadId": "7847",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੂਲ ਸੰਭਾਰਿ ਰੁਦ੍ਰ ਜਬ ਪਰਿਯੋ ॥",
      "transliteration": "sool sa(n)bhaar rudhr jab pariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤ੍ਰਿਸ਼ੂਲ ਨੂੰ ਸੰਭਾਲ ਕੇ ਜਦੋਂ ਸ਼ਿਵ (ਵੈਰੀਦਲ ਉਤੇ) ਜਾ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "सूल संभारि रुद्र जब परियो ॥",
      "sourceLineId": "83016",
      "sourceShabadId": "7847",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚਿਤ੍ਰ ਬਚਿਤ੍ਰ ਅਯੋਧਨ ਕਰਿਯੋ ॥੨੬॥",
      "transliteration": "chitr bachitr ayodhan kariyo ||26||",
      "translation": "When Rudra, holding his trident wrought the destruction, then the scence of that place looked very queer.26.",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੇ ਅਲੌਕਿਕ ਤਰ੍ਰਹਾ ਦਾ ਯੁੱਧ ਕੀਤਾ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "चित्र बचित्र अयोधन करियो ॥२६॥",
      "sourceLineId": "83017",
      "sourceShabadId": "7847",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭਾਜ ਭਾਜ ਤਬ ਚਲੇ ਨਰੇਸਾ ॥",
      "transliteration": "bhaaj bhaaj tab chale naresaa ||",
      "translation": "",
      "punjabiViakhya": "(ਯੱਗ ਵਿਚ ਸ਼ਾਮਲ ਹੋਣ ਲਈ ਆਏ) ਰਾਜੇ ਭਜਦੇ ਹੋਏ ਚਲੇ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "भाज भाज तब चले नरेसा ॥",
      "sourceLineId": "83018",
      "sourceShabadId": "7847",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਗ ਬਿਸਾਰ ਸੰਭਾਰਿਯੋ ਦੇਸਾ ॥",
      "transliteration": "jag bisaar sa(n)bhaariyo dhesaa ||",
      "translation": "Then the kings, forgetting the Yajna, began to run away to their countries.",
      "punjabiViakhya": "ਅਤੇ ਦਕਸ਼ ਦੇ ਯੱਗ ਨੂੰ ਭੁਲਾ ਕੇ (ਉਨ੍ਰਹਾ ਨੇ) ਆਪਣੇ ਦੇਸ਼ਾ ਨੂੰ ਯਾਦ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "जग बिसार संभारियो देसा ॥",
      "sourceLineId": "83019",
      "sourceShabadId": "7847",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਬ ਰਣ ਰੁਦ੍ਰ ਰੁਦ੍ਰ ਹੁਐ ਧਾਏ ॥",
      "transliteration": "jab ran rudhr rudhr huaai dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਸ਼ਿਵ ਨੇ ਭਿਆਨਕ ਰੂਪ ਹੋ ਕੇ ਧਾਵਾ ਕੀਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "जब रण रुद्र रुद्र हुऐ धाए ॥",
      "sourceLineId": "83020",
      "sourceShabadId": "7847",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭਾਜਤ ਭੂਪ ਨ ਬਾਚਨ ਪਾਏ ॥੨੭॥",
      "transliteration": "bhaajat bhoop na baachan paae ||27||",
      "translation": "When Rudra pursued them as fury-incarnate, then none of the running kings could survive.27.",
      "punjabiViakhya": "ਤਦੋਂ ਭਜੇ ਜਾਦੇ ਰਾਜੇ ਵੀ ਉਸ ਦੀ ਮਾਰ ਤੋਂ ਬਚ ਨਾ ਸਕੇ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "भाजत भूप न बाचन पाए ॥२७॥",
      "sourceLineId": "83021",
      "sourceShabadId": "7847",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਬ ਸਬ ਭਰੇ ਤੇਜ ਤਨੁ ਰਾਜਾ ॥",
      "transliteration": "tab sab bhare tej tan raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਸਾਰੇ ਰਾਜੇ ਕ੍ਰੋਧ ਨਾਲ ਭਰ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "तब सब भरे तेज तनु राजा ॥",
      "sourceLineId": "83022",
      "sourceShabadId": "7847",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਾਜਨ ਲਗੇ ਅਨੰਤਨ ਬਾਜਾ ॥",
      "transliteration": "baajan lage ana(n)tan baajaa ||",
      "translation": "Then all the kings, becoming alert, were highly activated and the musical instruments resounded from all the sides.",
      "punjabiViakhya": "ਅਤੇ ਅਨੰਤ ਕਿਸਮਾ ਦੇ ਮਾਰੂ ਵਾਜੇ ਵਜਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "बाजन लगे अनंतन बाजा ॥",
      "sourceLineId": "83023",
      "sourceShabadId": "7847",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਚਿਯੋ ਬਹੁਰਿ ਘੋਰਿ ਸੰਗ੍ਰਾਮਾ ॥",
      "transliteration": "machiyo bahur ghor sa(n)graamaa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਘਮਸਾਨ ਦਾ ਯੁੱਧ ਮਚਣ ਲਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "मचियो बहुरि घोरि संग्रामा ॥",
      "sourceLineId": "83024",
      "sourceShabadId": "7847",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0184_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਮ ਕੋ ਭਰਾ ਛਿਨਕ ਮਹਿ ਧਾਮਾ ॥੨੮॥",
      "transliteration": "jam ko bharaa chhinak meh dhaamaa ||28||",
      "translation": "Then the war become more intense and the house of Yama began to be filled with the dead.28.",
      "punjabiViakhya": "ਜਮ ਦਾ ਘਰ ਇਕ ਛਿਣ ਵਿਚ ਹੀ ਭਰ ਦਿੱਤਾ ਗਿਆ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": "जम को भरा छिनक महि धामा ॥२८॥",
