{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 185,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0185_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਲੈ ਲੈ ਬਾਣਿ ਪਾਣਿ ਹਥੀਯਾਰਨ ॥",
      "transliteration": "lai lai baan paan hatheeyaaran ||",
      "translation": "The kings returned with several kinds of arrows and weapons for waging the war.",
      "punjabiViakhya": "ਹੱਥਾ ਵਿਚ ਧਨੁਸ਼, ਬਾਣ ਅਤੇ ਸ਼ਸਤ੍ਰ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "लै लै बाणि पाणि हथीयारन ॥",
      "sourceLineId": "83027",
      "sourceShabadId": "7847",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਧਾਇ ਧਾਇ ਅਰਿ ਕਰਤ ਪ੍ਰਹਾਰਾ ॥",
      "transliteration": "dhai dhai ar karat prahaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਭਜ ਭਜ ਕੇ ਵੈਰੀ ਉਪਰ (ਇਸ ਤਰ੍ਰਹਾ) ਵਾਰ ਕਰਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "धाइ धाइ अरि करत प्रहारा ॥",
      "sourceLineId": "83028",
      "sourceShabadId": "7847",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਨ ਕਰ ਚੋਟ ਪਰਤ ਘਰੀਯਾਰਾ ॥੨੯॥",
      "transliteration": "jan kar choT parat ghareeyaaraa ||29||",
      "translation": "They began to strike blows speedily like the strokes on the gong.29.",
      "punjabiViakhya": "ਮਾਨੋ ਘੜਿਆਲ ਉਤੇ ਚੋਟਾ ਪੈਂਦੀਆਂ ਹੋਣ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "जन कर चोट परत घरीयारा ॥२९॥",
      "sourceLineId": "83029",
      "sourceShabadId": "7847",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਖੰਡ ਖੰਡ ਰਣਿ ਗਿਰੇ ਅਖੰਡਾ ॥",
      "transliteration": "kha(n)dd kha(n)dd ran gire akha(n)ddaa ||",
      "translation": "",
      "punjabiViakhya": "ਨ ਖੰਡਿਤ ਹੋਣ ਵਾਲੇ ਸੂਰਮੇ ਟੋਟੇ-ਟੋਟੇ ਹੋ ਕੇ ਰਣ-ਭੂਮੀ ਵਿਚ ਡਿਗ ਪਏ,",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "खंड खंड रणि गिरे अखंडा ॥",
      "sourceLineId": "83030",
      "sourceShabadId": "7847",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਾਪਿਯੋ ਖੰਡ ਨਵੇ ਬ੍ਰਹਮੰਡਾ ॥",
      "transliteration": "kaapiyo kha(n)dd nave brahama(n)ddaa ||",
      "translation": "The mighty warriors began to fall as bits and the nine regions of the world trembled.",
      "punjabiViakhya": "ਨੌਂ ਖੰਡਾ ਵਾਲਾ ਬ੍ਰਹਿਮੰਡ ਕੰਬਣ ਲਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "कापियो खंड नवे ब्रहमंडा ॥",
      "sourceLineId": "83031",
      "sourceShabadId": "7847",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਛਾਡਿ ਛਾਡਿ ਅਸਿ ਗਿਰੇ ਨਰੇਸਾ ॥",
      "transliteration": "chhaadd chhaadd as gire naresaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤਲਵਾਰਾ ਛਡ ਛਡ ਕੇ ਰਾਜੇ ਡਿਗ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "छाडि छाडि असि गिरे नरेसा ॥",
      "sourceLineId": "83032",
      "sourceShabadId": "7847",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਚਿਯੋ ਜੁਧੁ ਸੁਯੰਬਰ ਜੈਸਾ ॥੩੦॥",
      "transliteration": "machiyo judh suya(n)bar jaisaa ||30||",
      "translation": "Forsaking their swords, the kings began to fall down and there was dreadful scene in the battlefield.30.",
      "punjabiViakhya": "ਸੁਅੰਬਰ ਵਰਗਾ ਜੰਗ ਦਾ ਦ੍ਰਿਸ਼ ਪੇਸ਼ ਹੋ ਗਿਆ ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "मचियो जुधु सुयंबर जैसा ॥३०॥",
      "sourceLineId": "83033",
      "sourceShabadId": "7847",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "naraaj chha(n)dh ||",
      "translation": "NARAAJ STANZA",
      "punjabiViakhya": "ਨਰਾਜ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "नराज छंद ॥",
      "sourceLineId": "83034",
      "sourceShabadId": "7848",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਰੁਝੇ ਕਿਕਾਣੀ ॥",
      "transliteration": "arujhe kikaanee ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜ ਚੜ੍ਰਹੇ ਸੂਰਮੇ (ਆਪਸ ਵਿਚ) ਉਲਝੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "अरुझे किकाणी ॥",
      "sourceLineId": "83035",
      "sourceShabadId": "7848",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਧਰੇ ਸਸਤ੍ਰ ਪਾਣੀ ॥",
      "transliteration": "dhare sasatr paanee ||",
      "translation": "The warriors riding on the horses, coming down, began to roam, holding their weapons",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਹੱਥਾ ਵਿਚ ਸ਼ਸਤ੍ਰ ਫੜੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "धरे ससत्र पाणी ॥",
      "sourceLineId": "83036",
      "sourceShabadId": "7848",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪਰੀ ਮਾਰ ਬਾਣੀ ॥",
      "transliteration": "paree maar baanee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦੂਜੇ ਨੂੰ ਤੀਰਾ ਦੀ ਮਾਰ ਪੈ ਰਹੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "परी मार बाणी ॥",
      "sourceLineId": "83037",
      "sourceShabadId": "7848",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕੜਕੇ ਕਮਾਣੀ ॥੩੧॥",
      "transliteration": "kaRake kamaanee ||31||",
      "translation": "The arrows were discharged and the bows crackled.31.",
      "punjabiViakhya": "ਅਤੇ ਕਮਾਨਾ ਕੜਕ ਰਹੀਆਂ ਸਨ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "कड़के कमाणी ॥३१॥",
      "sourceLineId": "83038",
      "sourceShabadId": "7848",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਝੜਕੇ ਕ੍ਰਿਪਾਣੀ ॥",
      "transliteration": "jhaRake kirapaanee ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧੇ ਇਕ ਦੂਜੇ ਉਤੇ ਕ੍ਰਿਪਾਨਾ ਝਾੜਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "झड़के कृपाणी ॥",
      "sourceLineId": "83039",
      "sourceShabadId": "7848",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਧਰੇ ਧੂਲ ਧਾਣੀ ॥",
      "transliteration": "dhare dhool dhaanee ||",
      "translation": "The sword began to fall and the dust rose from the earth upwards.",
      "punjabiViakhya": "ਧਰਤੀ ਉਤੇ ਧੂੜ ਛਾ ਗਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "धरे धूल धाणी ॥",
      "sourceLineId": "83040",
      "sourceShabadId": "7848",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚੜੇ ਬਾਨ ਸਾਣੀ ॥",
      "transliteration": "chaRe baan saanee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਣਾ ਉਤੇ ਚੜ੍ਰਹਾ (ਕੇ ਤੇਜ਼ ਕੀਤੇ) ਬਾਣ (ਚਲਦੇ ਸਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "चड़े बान साणी ॥",
      "sourceLineId": "83041",
      "sourceShabadId": "7848",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰਟੈ ਏਕ ਪਾਣੀ ॥੩੨॥",
      "transliteration": "raTai ek paanee ||32||",
      "translation": "On one side, the sharp arrows are being discharged and on the other side people are repeating request for water.32.",
      "punjabiViakhya": "(ਕਈ ਇਕ ਘਾਇਲ) ਪਾਣੀ ਮੰਗ ਰਹੇ ਸਨ ॥੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "रटै एक पाणी ॥३२॥",
      "sourceLineId": "83042",
      "sourceShabadId": "7848",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚਵੀ ਚਾਵਡਾਣੀ ॥",
      "transliteration": "chavee chaavaddaanee ||",
      "translation": "",
      "punjabiViakhya": "ਚੁੜੇਲਾ ਬੋਲਦੀਆਂ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "चवी चावडाणी ॥",
      "sourceLineId": "83043",
      "sourceShabadId": "7848",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜੁਟੇ ਹਾਣੁ ਹਾਣੀ ॥",
      "transliteration": "juTe haan haanee ||",
      "translation": "The vultures are swooping down and the warriors equal in strength are fighting.",
      "punjabiViakhya": "ਹਾਣੀ ਨਾਲ ਹਾਣ ਜੁਟਿਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "जुटे हाणु हाणी ॥",
      "sourceLineId": "83044",
      "sourceShabadId": "7848",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹਸੀ ਦੇਵ ਰਾਣੀ ॥",
      "transliteration": "hasee dhev raanee ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵ ਰਾਣੀਆਂ (ਅਪੱਛਰਾਵਾ) ਹਸਦੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "हसी देव राणी ॥",
      "sourceLineId": "83045",
      "sourceShabadId": "7848",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਝਮਕੇ ਕ੍ਰਿਪਾਣੀ ॥੩੩॥",
      "transliteration": "jhamake kirapaanee ||33||",
      "translation": "Durga is laughing and the glittering swords are being struck.33.",
      "punjabiViakhya": "ਅਤੇ ਕ੍ਰਿਪਾਨਾ ਝਮਕਦੀਆਂ ਸਨ ॥੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "झमके कृपाणी ॥३३॥",
      "sourceLineId": "83046",
      "sourceShabadId": "7848",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬ੍ਰਿਧ ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "biradh naraaj chha(n)dh ||",
      "translation": "BRIDH NARAAJ STANZA",
      "punjabiViakhya": "ਬ੍ਰਿਧ ਨਰਾਜ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "बृध नराज छंद ॥",
      "sourceLineId": "83047",
      "sourceShabadId": "7849",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੁ ਮਾਰੁ ਮਾਰ ਸੂਰਮਾ ਪੁਕਾਰ ਮਾਰ ਕੇ ਚਲੇ ॥",
      "transliteration": "s maar maar sooramaa pukaar maar ke chale ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਰੋ ਮਾਰੋ ਕਹਿੰਦੇ ਹੋਏ ਸੂਰਮੇ ਵੈਰੀ ਨੂੰ ਮਾਰਨ ਲਈ ਚਲਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "सु मारु मार सूरमा पुकार मार के चले ॥",
      "sourceLineId": "83048",
      "sourceShabadId": "7849",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਨੰਤ ਰੁਦ੍ਰ ਕੇ ਗਣੋ ਬਿਅੰਤ ਬੀਰਹਾ ਦਲੇ ॥",
      "transliteration": "ana(n)t rudhr ke gano bia(n)t beerahaa dhale ||",
      "translation": "The brave fighters marched forward with their shouts of “kill, kill”. And form this side, the ganas of Rudra destroyed innumerable warriors.",
      "punjabiViakhya": "ਰੁਦਰ ਦੇ ਅਨੰਤ ਗਣਾ ਨੇ ਬੇਅੰਤ ਸੂਰਮਿਆਂ ਨੂੰ ਦਲ ਦਿੱਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "अनंत रुद्र के गणो बिअंत बीरहा दले ॥",
      "sourceLineId": "83049",
      "sourceShabadId": "7849",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਘਮੰਡ ਘੋਰ ਸਾਵਣੀ ਅਘੋਰ ਜਿਉ ਘਟਾ ਉਠੀ ॥",
      "transliteration": "ghama(n)dd ghor saavanee aghor jiau ghaTaa uThee ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਦੇ ਗਣਾ ਦਾ ਵੱਡਾ ਭਾਰਾ ਦਲ (ਇੰਜ ਸੀ) ਜਿਵੇਾਂ ਸਾਵਣ ਦੀ ਘਨਘੋਰ ਘਟਾ ਚੜ੍ਰਹਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "घमंड घोर सावणी अघोर जिउ घटा उठी ॥",
      "sourceLineId": "83050",
      "sourceShabadId": "7849",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਨੰਤ ਬੂੰਦ ਬਾਣ ਧਾਰ ਸੁਧ ਕ੍ਰੁਧ ਕੈ ਬੁਠੀ ॥੩੪॥",
      "transliteration": "ana(n)t boo(n)dh baan dhaar sudh krudh kai buThee ||34||",
      "translation": "The furious arrows are being showered like the drops from the visible rising dark thundering clouds in the month of Sawan.34.",
      "punjabiViakhya": "ਪੂਰੇ ਕ੍ਰੋਧ ਨਾਲ ਚਲੇ ਬਾਣ ਅਨੰਤ ਬੂੰਦਾ ਦੀ ਝੜੀ ਵਾਗ ਵਰ੍ਰਹ ਰਹੇ ਸਨ ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "अनंत बूँद बाण धार सुध क्रुध कै बुठी ॥३४॥",
      "sourceLineId": "83051",
      "sourceShabadId": "7849",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "naraaj chha(n)dh ||",
      "translation": "NARAAJ STANZA",
      "punjabiViakhya": "ਨਰਾਜ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "नराज छंद ॥",
      "sourceLineId": "83052",
      "sourceShabadId": "7850",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਿਅੰਤ ਸੂਰ ਧਾਵਹੀ ॥",
      "transliteration": "bia(n)t soor dhaavahee ||",
      "translation": "",
      "punjabiViakhya": "ਬੇਅੰਤ ਸੂਰਮੇ ਭਜ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "बिअंत सूर धावही ॥",
      "sourceLineId": "83053",
      "sourceShabadId": "7850",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੁ ਮਾਰੁ ਮਾਰੁ ਘਾਵਹੀ ॥",
      "transliteration": "s maar maar ghaavahee ||",
      "translation": "Many warriors are running forward and with their blows are wounding the enemies.",
      "punjabiViakhya": "ਅਤੇ 'ਮਾਰੋ' 'ਮਾਰੋ' ਬੋਲ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "सु मारु मारु घावही ॥",
      "sourceLineId": "83054",
      "sourceShabadId": "7850",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਘਾਇ ਘਾਇ ਉਠ ਹੀ ॥",
      "transliteration": "aghai ghai uTh hee ||",
      "translation": "",
      "punjabiViakhya": "ਜ਼ਖ਼ਮ ਖਾ ਕੇ ਅਤ੍ਰਿਪਤ ਯੋਧੇ (ਫਿਰ) ਉਠ ਖਲੋਂਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "अघाइ घाइ उठ ही ॥",
      "sourceLineId": "83055",
      "sourceShabadId": "7850",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਨੇਕ ਬਾਣ ਬੁਠਹੀ ॥੩੫॥",
      "transliteration": "anek baan buThahee ||35||",
      "translation": "Many warriors, being wounded, are roaming and showering arrows.35.",
      "punjabiViakhya": "ਅਤੇ ਅਨੇਕਾ ਬਾਣਾ ਦੀ ਵਰਖਾ ਕਰਦੇ ਸਨ ॥੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "अनेक बाण बुठही ॥३५॥",
      "sourceLineId": "83056",
      "sourceShabadId": "7850",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਨੰਤ ਅਸਤ੍ਰ ਸਜ ਕੈ ॥",
      "transliteration": "ana(n)t asatr saj kai ||",
      "translation": "",
      "punjabiViakhya": "ਅਸਤ੍ਰਾ ਨਾਲ ਸਜ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "अनंत असत्र सज कै ॥",
      "sourceLineId": "83057",
      "sourceShabadId": "7850",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚਲੈ ਸੁ ਬੀਰ ਗਜ ਕੈ ॥",
      "transliteration": "chalai su beer gaj kai ||",
      "translation": "Bedecked with several arms, the warriors are marching forward and thundering",
      "punjabiViakhya": "ਅਤੇ ਗਜ ਵਜ ਕੇ ਅਨੰਤ ਸੂਰਮੇ ਜੰਗ ਨੂੰ ਚਲ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "चलै सु बीर गज कै ॥",
      "sourceLineId": "83058",
      "sourceShabadId": "7850",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਿਰਭੈ ਹਥਿਯਾਰ ਝਾਰ ਹੀ ॥",
      "transliteration": "nirabhai hathiyaar jhaar hee ||",
      "translation": "",
      "punjabiViakhya": "ਭੈ ਤੋਂ ਰਹਿਤ ਹੋ ਕੇ ਸ਼ਸਤ੍ਰ ਚਲਾਉਾਂਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "निरभै हथियार झार ही ॥",
      "sourceLineId": "83059",
      "sourceShabadId": "7850",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੁ ਮਾਰੁ ਮਾਰ ਉਚਾਰਹੀ ॥੩੬॥",
      "transliteration": "s maar maar uchaarahee ||36||",
      "translation": "And striking their blows fearlessly, are shouting “kill, kill”.36.",
      "punjabiViakhya": "ਅਤੇ ਮੂੰਹੋਂ 'ਮਾਰੋ' 'ਮਾਰੋ' ਬੋਲਦੇ ਸਨ ॥੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "सु मारु मार उचारही ॥३६॥",
      "sourceLineId": "83060",
      "sourceShabadId": "7850",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਘਮੰਡ ਘੋਰ ਜਿਉ ਘਟਾ ॥",
      "transliteration": "ghama(n)dd ghor jiau ghaTaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਵਣ ਦੀ ਘਨਘੋਰ ਘਟਾ ਵਾਗ",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "घमंड घोर जिउ घटा ॥",
      "sourceLineId": "83061",
      "sourceShabadId": "7850",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚਲੇ ਬਨਾਹਿ ਤਿਉ ਥਟਾ ॥",
      "transliteration": "chale banaeh tiau thaTaa ||",
      "translation": "Preparing themselves like the thundering dark clouds, the brave fighters are marching forward.",
      "punjabiViakhya": "(ਯੋਧੇ) ਠਾਠ ਬਣਾ ਕੇ ਚਲੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "चले बनाहि तिउ थटा ॥",
      "sourceLineId": "83062",
      "sourceShabadId": "7850",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੁ ਸਸਤ੍ਰ ਸੂਰ ਸੋਭਹੀ ॥",
      "transliteration": "s sasatr soor sobhahee ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਸ਼ਸਤ੍ਰਾ ਨਾਲ ਸੋਭ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "सु ससत्र सूर सोभही ॥",
      "sourceLineId": "83063",
      "sourceShabadId": "7850",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੁਤਾ ਸੁਰਾਨ ਲੋਭਹੀ ॥੩੭॥",
      "transliteration": "sutaa suraan lobhahee ||37||",
      "translation": "Bedecked with weapons, they are looking so beautiful that the daughters of the gods are getting allured by them.37.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਵੇਖ ਕੇ ਦੇਵ-ਕੰਨਿਆਵਾ ਲੋਭਾਇਮਾਨ ਹੋ ਰਹੀਆਂ ਸਨ ॥੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "सुता सुरान लोभही ॥३७॥",
      "sourceLineId": "83064",
      "sourceShabadId": "7850",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੁ ਬੀਰ ਬੀਨ ਕੈ ਬਰੈ ॥",
      "transliteration": "s beer been kai barai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸੂਰਮਿਆਂ ਨੂੰ ਚੁਣ ਚੁਣ ਕੇ ਵਰ ਰਹੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "सु बीर बीन कै बरै ॥",
      "sourceLineId": "83065",
      "sourceShabadId": "7850",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੁਰੇਸ ਲੋਗਿ ਬਿਚਰੈ ॥",
      "transliteration": "sures log bicharai ||",
      "translation": "They are very selective in wedding the warriors and all the heroes are moving about and looking impressive in the battlefield like Indra, the king of gods.",
      "punjabiViakhya": "ਅਤੇ ਇੰਦਰ ਲੋਕ ਵਿਚ ਖੁਸ਼ੀ ਨਾਲ ਵਿਚਰਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "सुरेस लोगि बिचरै ॥",
      "sourceLineId": "83066",
      "sourceShabadId": "7850",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੁ ਤ੍ਰਾਸ ਭੂਪ ਜੇ ਭਜੇ ॥",
      "transliteration": "s traas bhoop je bhaje ||",
      "translation": "",
      "punjabiViakhya": "ਡਰ ਨਾਲ ਜਿਹੜੇ ਰਾਜੇ ਜੰਗ ਤੋਂ ਭਜ ਗਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "सु त्रास भूप जे भजे ॥",
      "sourceLineId": "83067",
      "sourceShabadId": "7850",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੁ ਦੇਵ ਪੁਤ੍ਰਕਾ ਤਜੇ ॥੩੮॥",
      "transliteration": "s dhev putrakaa taje ||38||",
      "translation": "All those kings, who are frightened, they have been abandoned by the daughters of the gods.38.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਦੇਵ ਕੰਨਿਆਵਾ ਨੇ ਤਿਆਗ ਦਿੱਤਾ ਸੀ ॥੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "सु देव पुत्रका तजे ॥३८॥",
      "sourceLineId": "83068",
      "sourceShabadId": "7850",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬ੍ਰਿਧ ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "biradh naraaj chha(n)dh ||",
      "translation": "BRIDH NARAAJ STANZA",
      "punjabiViakhya": "ਬ੍ਰਿਧ ਨਰਾਜ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "बृध नराज छंद ॥",
      "sourceLineId": "83069",
      "sourceShabadId": "7851",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੁ ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਸਜ ਕੈ ਪਰੇ ਹੁਕਾਰ ਕੈ ਹਠੀ ॥",
      "transliteration": "s sasatr asatr saj kai pare hukaar kai haThee ||",
      "translation": "",
      "punjabiViakhya": "ਹਠੀਲੇ ਸੂਰਮੇ ਅਸਤ੍ਰ ਸ਼ਸਤ੍ਰ ਸਜਾ ਕੇ ਅਤੇ ਲਲਕਾਰਦੇ ਹੋਏ ਪੈਂਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "सु ससत्र असत्र सज कै परे हुकार कै हठी ॥",
      "sourceLineId": "83070",
      "sourceShabadId": "7851",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਿਲੋਕਿ ਰੁਦ੍ਰ ਰੁਦ੍ਰ ਕੋ ਬਨਾਇ ਸੈਣ ਏਕਠੀ ॥",
      "transliteration": "bilok rudhr rudhr ko banai sain ekaThee ||",
      "translation": "The warriors thundering dreadfully and bedecked with arms and weapons fell (on the enemy) and seeing the anger of Rudra, they gathered all the forces.",
      "punjabiViakhya": "ਸ਼ਿਵ ਦੇ ਭਿਆਨਕ ਰੂਪ ਨੂੰ ਵੇਖ ਕੇ ਰਾਜਿਆਂ ਨੇ ਸੈਨਾ ਇਕੱਠੀ ਕਰ ਲਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "बिलोकि रुद्र रुद्र को बनाइ सैण एकठी ॥",
      "sourceLineId": "83071",
      "sourceShabadId": "7851",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਨੰਤ ਘੋਰ ਸਾਵਣੀ ਦੁਰੰਤ ਜਿਯੋ ਉਠੀ ਘਟਾ ॥",
      "transliteration": "ana(n)t ghor saavanee dhura(n)t jiyo uThee ghaTaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਵਣ ਦੀ ਘਨਘੋਰ ਘਟਾ ਵਾਗ ਅਨੰਤ ਸੈਨਾ ਦੀ ਪ੍ਰਚੰਡ ਘਟਾ ਚੜ੍ਰਹ ਆਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "अनंत घोर सावणी दुरंत जियो उठी घटा ॥",
      "sourceLineId": "83072",
      "sourceShabadId": "7851",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੁ ਸੋਭ ਸੂਰਮਾ ਨਚੈ ਸੁ ਛੀਨਿ ਛਤ੍ਰ ਕੀ ਛਟਾ ॥੩੯॥",
      "transliteration": "s sobh sooramaa nachai su chheen chhatr kee chhaTaa ||39||",
      "translation": "They gathered quickly like the rising and thundering clouds of Sawan and gathering the glory of heaven in themselves, began to dance, being highly intoxicated.39.",
      "punjabiViakhya": "ਸੂਰਮੇ ਨਚਦੇ ਹੋਏ ਇੰਜ ਸ਼ੋਭ ਰਹੇ ਸਨ, ਮਾਨੋ (ਉਨ੍ਰਹਾ ਨੇ) ਛੱਤਰ ਦੀ ਸ਼ੋਭਾ ਖੋਹ ਲਈ ਹੋਵੇ ॥੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "सु सोभ सूरमा नचै सु छीनि छत्र की छटा ॥३९॥",
      "sourceLineId": "83073",
      "sourceShabadId": "7851",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0185_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕੰਪਾਇ ਖਗ ਪਾਣ ਮੋ ਤ੍ਰਪਾਇ ਤਾਜੀਯਨ ਤਹਾ ॥",
      "transliteration": "ka(n)pai khag paan mo trapai taajeeyan tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੱਥ ਵਿਚ ਖੜਗ ਨੂੰ ਘੁਮਾ ਕੇ ਅਤੇ ਘੋੜਿਆਂ ਨੂੰ ਕੁਦਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": "कंपाइ खग पाण मो त्रपाइ ताजीयन तहा ॥",
      "sourceLineId": "83074",
      "sourceShabadId": "7851",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
