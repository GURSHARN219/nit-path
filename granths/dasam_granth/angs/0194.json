{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 194,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0194_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਾਲ ਪੁਰਖ ਆਗ੍ਯਾ ਤਬ ਦੀਨੀ ॥",
      "transliteration": "kaal purakh aagayaa tab dheenee ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ-ਪੁਰਖ' ਨੇ ਤਦ ਆਗਿਆ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "काल पुरख आग्या तब दीनी ॥",
      "sourceLineId": "83387",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਿਸਨੁ ਚੰਦ ਸੋਈ ਬਿਧਿ ਕੀਨੀ ॥੨॥",
      "transliteration": "bisan cha(n)dh soiee bidh keenee ||2||",
      "translation": "Then the Immanent Lord ordered Vishnu, who did as commanded.2.",
      "punjabiViakhya": "ਅਤੇ ਵਿਸ਼ਣੂ ਨੇ ਉਸੇ ਤਰ੍ਰਹਾ ਪਾਲਣਾ ਕੀਤੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "बिसनु चंद सोई बिधि कीनी ॥२॥",
      "sourceLineId": "83388",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਨੁ ਹ੍ਵੈ ਰਾਜ ਵਤਾਰ ਅਵਤਰਾ ॥",
      "transliteration": "man havai raaj vataar avataraa ||",
      "translation": "",
      "punjabiViakhya": "ਮਨੁ ਰਾਜਾ ਅਵਤਾਰ ਹੋ ਕੇ (ਵਿਸ਼ਣੂ) ਅਵਤਰਿਤ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "मनु ह्वै राज वतार अवतरा ॥",
      "sourceLineId": "83389",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਨੁ ਸਿਮਿਰਿਤਹਿ ਪ੍ਰਚੁਰ ਜਗਿ ਕਰਾ ॥",
      "transliteration": "man simiriteh prachur jag karaa ||",
      "translation": "Vishnu manifested himself as king Manu and propagated Manu Smriti in the world.",
      "punjabiViakhya": "ਅਤੇ 'ਮਨੁ ਸਮ੍ਰਿਤੀ' ਦਾ ਜਗਤ ਵਿਚ ਪ੍ਰਚਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "मनु सिमिरितहि प्रचुर जगि करा ॥",
      "sourceLineId": "83390",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਕਲ ਕੁਪੰਥੀ ਪੰਥਿ ਚਲਾਏ ॥",
      "transliteration": "sakal kupa(n)thee pa(n)th chalaae ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਪੰਥੀਆਂ (ਜੈਨ ਮਾਰਗੀਆਂ) ਨੂੰ ਸਹੀ ਮਾਰਗ ਉਤੇ ਤੋਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "सकल कुपंथी पंथि चलाए ॥",
      "sourceLineId": "83391",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪਾਪ ਕਰਮ ਤੇ ਲੋਗ ਹਟਾਏ ॥੩॥",
      "transliteration": "paap karam te log haTaae ||3||",
      "translation": "He brought all the corrupt persons on the right path and cused the people to become devoid of sinful actions.3.",
      "punjabiViakhya": "ਅਤੇ ਪਾਪ-ਕਰਮ ਤੋਂ ਲੋਕਾ ਨੂੰ ਹਟਾ ਦਿੱਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "पाप करम ते लोग हटाए ॥३॥",
      "sourceLineId": "83392",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਾਜ ਅਵਤਾਰ ਭਯੋ ਮਨੁ ਰਾਜਾ ॥",
      "transliteration": "raaj avataar bhayo man raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਅਵਤਾਰ ਰੂਪ ਵਿਚ (ਵਿਸ਼ਣੂ) ਮਨੁ ਰਾਜਾ ਵਜੋਂ ਪ੍ਰਗਟ ਹੋਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "राज अवतार भयो मनु राजा ॥",
      "sourceLineId": "83393",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਰਬ ਹੀ ਸਿਰਜੇ ਧਰਮ ਕੇ ਸਾਜਾ ॥",
      "transliteration": "sarab hee siraje dharam ke saajaa ||",
      "translation": "Vishnu incarnated himself as the king Manu and established all the actions of Dgarma.",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਧਰਮ ਦੇ ਸਾਰੇ ਸਾਜ ਸਿਰਜ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "सरब ही सिरजे धरम के साजा ॥",
      "sourceLineId": "83394",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪਾਪ ਕਰਾ ਤਾ ਕੋ ਗਹਿ ਮਾਰਾ ॥",
      "transliteration": "paap karaa taa ko geh maaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੇ ਕੋਈ) ਪਾਪ ਕਰਮ ਕੀਤਾ, ਉਸੇ ਨੂੰ ਫੜ ਕੇ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "पाप करा ता को गहि मारा ॥",
      "sourceLineId": "83395",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਕਲ ਪ੍ਰਜਾ ਕਹੁ ਮਾਰਗਿ ਡਾਰਾ ॥੪॥",
      "transliteration": "sakal prajaa kahu maarag ddaaraa ||4||",
      "translation": "If anyone committed a sin, he was now killed and in this way, the king made all his subjects to tread on the right path.4.",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਸਾਰੀ ਪਰਜਾ ਨੂੰ (ਧਰਮ ਦੇ) ਮਾਰਗ ਉਤੇ ਚਲਾ ਦਿੱਤਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "सकल प्रजा कहु मारगि डारा ॥४॥",
      "sourceLineId": "83396",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪਾਪ ਕਰਾ ਜਾ ਹੀ ਤਹ ਮਾਰਸ ॥",
      "transliteration": "paap karaa jaa hee teh maaras ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਵੀ ਕਿਸੇ ਨੇ ਪਾਪ ਕੀਤਾ, ਉਥੇ (ਉਸ ਨੂੰ) ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "पाप करा जा ही तह मारस ॥",
      "sourceLineId": "83397",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਕਲ ਪ੍ਰਜਾ ਕਹੁ ਧਰਮ ਸਿਖਾਰਸ ॥",
      "transliteration": "sakal prajaa kahu dharam sikhaaras ||",
      "translation": "The sinner was killed instantly and all the subjects were given instructions on Dharma.",
      "punjabiViakhya": "ਸਾਰੀ ਪਰਜਾ ਨੂੰ ਧਰਮ (ਦੀ ਵਿਧੀ) ਸਿਖਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "सकल प्रजा कहु धरम सिखारस ॥",
      "sourceLineId": "83398",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾਮ ਦਾਨ ਸਬਹੂਨ ਸਿਖਾਰਾ ॥",
      "transliteration": "naam dhaan sabahoon sikhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਨਾਮ-ਸਿਮਰਨ ਅਤੇ ਦਾਨ ਦੇਣ ਦੀ ਜੁਗਤ ਦਸ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "नाम दान सबहून सिखारा ॥",
      "sourceLineId": "83399",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸ੍ਰਾਵਗ ਪੰਥ ਦੂਰ ਕਰਿ ਡਾਰਾ ॥੫॥",
      "transliteration": "sraavag pa(n)th dhoor kar ddaaraa ||5||",
      "translation": "Now all attained the instructions about the Name of the Lord and about virtuous actions like charity etc. And in this way, the king got abandoned the discipline of Sharavaks.5.",
      "punjabiViakhya": "ਅਤੇ ਜੈਨ ਮਤ (ਸੰਸਾਰ ਵਿਚੋਂ) ਦੂਰ ਕਰ ਦਿੱਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "स्रावग पंथ दूर करि डारा ॥५॥",
      "sourceLineId": "83400",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜੇ ਜੇ ਭਾਜਿ ਦੂਰ ਕਹੁ ਗਏ ॥",
      "transliteration": "je je bhaaj dhoor kahu ge ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੜੇ ਜਿਹੜੇ ਭਜ ਕੇ ਦੁਰਾਡੇ ਦੇਸ਼ਾ ਨੂੰ ਚਲੇ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "जे जे भाजि दूर कहु गए ॥",
      "sourceLineId": "83401",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸ੍ਰਾਵਗ ਧਰਮਿ ਸੋਊ ਰਹਿ ਗਏ ॥",
      "transliteration": "sraavag dharam souoo reh ge ||",
      "translation": "The people who had run away from the kingdom of the king Manu, they only remained adherents of Sharavak Religion.",
      "punjabiViakhya": "ਜੈਨ ਮਤ ਵਿਚ ਉਹੀ ਰਹਿ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "स्रावग धरमि सोऊ रहि गए ॥",
      "sourceLineId": "83402",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਉਰ ਪ੍ਰਜਾ ਸਬ ਮਾਰਗਿ ਲਾਈ ॥",
      "transliteration": "aaur prajaa sab maarag laiee ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ ਸਾਰੀ ਪਰਜਾ ਨੂੰ ਧਰਮ ਦੇ ਰਸਤੇ ਉਤੇ ਲਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "अउर प्रजा सब मारगि लाई ॥",
      "sourceLineId": "83403",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕੁਪੰਥ ਪੰਥ ਤੇ ਸੁਪੰਥ ਚਲਾਈ ॥੬॥",
      "transliteration": "kupa(n)th pa(n)th te supa(n)th chalaiee ||6||",
      "translation": "All the remaining subjects followed the path of Dharma and abandoning the wrong path, acquired the path of Dharma.6.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਨੂੰ ਮਾੜੇ ਰਸਤੇ ਤੋਂ ਹਟਾ ਕੇ ਸ਼ੁਭ ਮਾਰਗ ਉਤੇ ਤੋਰ ਦਿੱਤਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "कुपंथ पंथ ते सुपंथ चलाई ॥६॥",
      "sourceLineId": "83404",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਾਜ ਅਵਤਾਰ ਭਯੋ ਮਨੁ ਰਾਜਾ ॥",
      "transliteration": "raaj avataar bhayo man raajaa ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਰਾਜ-ਅਵਤਾਰ (ਦੇ ਰੂਪ ਵਿਚ) ਮਨੁ ਰਾਜਾ ਹੋਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "राज अवतार भयो मनु राजा ॥",
      "sourceLineId": "83405",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਰਮ ਧਰਮ ਜਗ ਮੋ ਭਲੁ ਸਾਜਾ ॥",
      "transliteration": "karam dharam jag mo bhal saajaa ||",
      "translation": "The king Manu was the incarnation of Vishnu and he propagated in the right manner the actions of Dharma.",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਜਗਤ ਵਿਚ ਧਰਮ ਕਰਮ ਦੀ ਚੰਗੀ ਵਿਵਸਥਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "करम धरम जग मो भलु साजा ॥",
      "sourceLineId": "83406",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਕਲ ਕੁਪੰਥੀ ਪੰਥ ਚਲਾਏ ॥",
      "transliteration": "sakal kupa(n)thee pa(n)th chalaae ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਕੁਪੰਥੀਆਂ ਨੂੰ ਸਹੀ ਮਾਰਗ ਉਤੇ ਤੋਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "सकल कुपंथी पंथ चलाए ॥",
      "sourceLineId": "83407",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪਾਪ ਕਰਮ ਤੇ ਧਰਮ ਲਗਾਏ ॥੭॥",
      "transliteration": "paap karam te dharam lagaae ||7||",
      "translation": "He put all the followers of wrong values on the right path an brought the people towards Dharma, who were absorbed then in sinful action.7.",
      "punjabiViakhya": "ਅਤੇ ਪਾਪ ਕਰਮਾ ਤੋਂ (ਹਟਾ ਕੇ) ਧਰਮ ਦੇ ਕਰਮਾ ਵਿਚ ਲਗਾ ਦਿੱਤਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "पाप करम ते धरम लगाए ॥७॥",
      "sourceLineId": "83408",
      "sourceShabadId": "7876",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "83409",
      "sourceShabadId": "7877",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪੰਥ ਕੁਪੰਥੀ ਸਬ ਲਗੇ ਸ੍ਰਾਵਗ ਮਤ ਭਯੋ ਦੂਰ ॥",
      "transliteration": "pa(n)th kupa(n)thee sab lage sraavag mat bhayo dhoor ||",
      "translation": "All those who tread on the wrong paths, began to follow the right path and in this way, the Sharvak Religion receded far away.",
      "punjabiViakhya": "ਸਾਰੇ ਜੈਨ ਧਰਮੀ (ਸਹੀ ਧਰਮ) ਮਾਰਗ ਉਤੇ ਤੁਰ ਪਏ ਅਤੇ ਜੈਨ ਮਤ (ਜਗ ਵਿਚੋਂ) ਦੂਰ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "पंथ कुपंथी सब लगे स्रावग मत भयो दूर ॥",
      "sourceLineId": "83410",
      "sourceShabadId": "7877",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਨੁ ਰਾਜਾ ਕੋ ਜਗਤ ਮੋ ਰਹਿਯੋ ਸੁਜਸੁ ਭਰਪੂਰ ॥੮॥",
      "transliteration": "man raajaa ko jagat mo rahiyo sujas bharapoor ||8||",
      "translation": "For this work, the king Manu was highly venerated in the whole world.8.",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਮਨੁ ਰਾਜੇ ਦਾ ਉਜਲਾ ਯਸ਼ ਜਗਤ ਵਿਚ ਭਰਪੂਰ ਹੋ ਗਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "मनु राजा को जगत मो रहियो सुजसु भरपूर ॥८॥",
      "sourceLineId": "83411",
      "sourceShabadId": "7877",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਗ੍ਰੰਥੇ ਮਨੁ ਰਾਜਾ ਅਵਤਾਰ ਸੋਲ੍ਰਹਵਾ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੬॥",
      "transliteration": "eit sree bachitr naaTake gra(n)the man raajaa avataar solrahavaa samaapatam sat subham sat ||16||",
      "translation": "For this work, the king Manu was MANU, the sixteenth incarnation in BACHITTAR BATAK.16.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦਾ ਮਨੁ ਰਾਜਾ ਅਵਤਾਰ ਸੋਲਹਵਾ ਸਮਾਪਤ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटके ग्रंथे मनु राजा अवतार सोल्रहवा समापतम सतु सुभम सतु ॥१६॥",
      "sourceLineId": "83412",
      "sourceShabadId": "7877",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਥ ਧਨੰਤਰ ਬੈਦ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "transliteration": "ath dhana(n)tar baidh avataar kathana(n) ||",
      "translation": "Now begins the description of the incarnation named Dhanantar Vaid:",
      "punjabiViakhya": "ਹੁਣ ਧਨੰਤਰ ਵੈਦ ਅਵਤਾਰ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "अथ धनंतर बैद अवतार कथनं ॥",
      "sourceLineId": "83413",
      "sourceShabadId": "7878",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ ॥",
      "transliteration": "sree bhagautee jee sahai ||",
      "translation": "Let Sri Bhagauti Ji (The Primal Lord) be helpful.",
      "punjabiViakhya": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "स्री भगउती जी सहाइ ॥",
      "sourceLineId": "83414",
      "sourceShabadId": "7878",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "83415",
      "sourceShabadId": "7878",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਭ ਧਨਵੰਤ ਭਏ ਜਗ ਲੋਗਾ ॥",
      "transliteration": "sabh dhanava(n)t bhe jag logaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਜਗਤ ਦੇ ਲੋਕ ਧਨਵਾਨ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "सभ धनवंत भए जग लोगा ॥",
      "sourceLineId": "83416",
      "sourceShabadId": "7878",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਏਕ ਨ ਰਹਾ ਤਿਨੋ ਤਨ ਸੋਗਾ ॥",
      "transliteration": "ek na rahaa tino tan sogaa ||",
      "translation": "The people of all the world grew wealthy and there remained no anxiety on their body and mind.",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਦੇ ਤਨ (ਤੇ ਮਨ) ਵਿੱਚ ਇਕ ਵੀ ਸੋਗ ਨਾ ਰਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "एक न रहा तिनो तन सोगा ॥",
      "sourceLineId": "83417",
      "sourceShabadId": "7878",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਭੱਛਤ ਪਕਵਾਨਾ ॥",
      "transliteration": "bhaat bhaat bha'chhat pakavaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ-ਭਾਤ ਦੇ ਪਕਵਾਨ ਖਾਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "भाति भाति भच्छत पकवाना ॥",
      "sourceLineId": "83418",
      "sourceShabadId": "7878",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਉਪਜਤ ਰੋਗ ਦੇਹ ਤਿਨ ਨਾਨਾ ॥੧॥",
      "transliteration": "aupajat rog dheh tin naanaa ||1||",
      "translation": "They began to eat various kinds of foods and consequentsly they suffered form various kinds of ailments.1.",
      "punjabiViakhya": "ਜਿਸ ਕਰਕੇ ਉਨ੍ਰਹਾ ਦੀ ਦੇਹ ਵਿੱਚ ਅਨੇਕਾ ਰੋਗ ਪੈਦਾ ਹੋ ਗਏ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "उपजत रोग देह तिन नाना ॥१॥",
      "sourceLineId": "83419",
      "sourceShabadId": "7878",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰੋਗਾਕੁਲ ਸਭ ਹੀ ਭਏ ਲੋਗਾ ॥",
      "transliteration": "rogaakul sabh hee bhe logaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਲੋਕ ਰੋਗ ਨਾਲ ਦੁਖੀ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "रोगाकुल सभ ही भए लोगा ॥",
      "sourceLineId": "83420",
      "sourceShabadId": "7878",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਉਪਜਾ ਅਧਿਕ ਪ੍ਰਜਾ ਕੋ ਸੋਗਾ ॥",
      "transliteration": "aupajaa adhik prajaa ko sogaa ||",
      "translation": "All the people got worried about their ailments and the subjects became extremely distressed.",
      "punjabiViakhya": "ਅਤੇ ਪਰਜਾ ਲਈ ਬਹੁਤ ਦੁਖ ਪੈਦਾ ਹੈ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "उपजा अधिक प्रजा को सोगा ॥",
      "sourceLineId": "83421",
      "sourceShabadId": "7878",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪਰਮ ਪੁਰਖ ਕੀ ਕਰੀ ਬਡਾਈ ॥",
      "transliteration": "param purakh kee karee baddaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ ਸਭ ਨੇ ਮਿਲ ਕੇ) ਪਰਮ ਪੁਰਖ ਦੀ ਸਿਫਤ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "परम पुरख की करी बडाई ॥",
      "sourceLineId": "83422",
      "sourceShabadId": "7878",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਕਰੀ ਤਿਨ ਪਰ ਹਰਿ ਰਾਈ ॥੨॥",
      "transliteration": "kirapaa karee tin par har raiee ||2||",
      "translation": "All of them snag the praises of the Immanent Lord and He become Gracious towards all.2.",
      "punjabiViakhya": "(ਜਿਸ ਕਰਕੇ) ਹਰੀ ਰਾਜੇ (ਕਾਲ ਪੁਰਖ) ਨੇ ਉਨ੍ਰਹਾ ਉਤੇ ਕ੍ਰਿਪਾ ਕੀਤੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "कृपा करी तिन पर हरि राई ॥२॥",
      "sourceLineId": "83423",
      "sourceShabadId": "7878",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਿਸਨ ਚੰਦ ਕੋ ਕਹਾ ਬੁਲਾਈ ॥",
      "transliteration": "bisan cha(n)dh ko kahaa bulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਸ਼ਣੂ ਨੂੰ ਸਦ ਕੇ (ਕਾਲ ਪੁਰਖ) ਨੇ ਕਿਹਾ-",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "बिसन चंद को कहा बुलाई ॥",
      "sourceLineId": "83424",
      "sourceShabadId": "7878",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਧਰ ਅਵਤਾਰ ਧਨੰਤਰ ਜਾਈ ॥",
      "transliteration": "dhar avataar dhana(n)tar jaiee ||",
      "translation": "Vishnu was called by the Supreme Lord and ordered to manifest himself in the form of Dhanwantar.",
      "punjabiViakhya": "ਧਨੰਤਰੀ ਅਵਤਾਰ ਧਾਰ ਕੇ (ਜਗਤ ਵਿੱਚ) ਜਾਓ,",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "धर अवतार धनंतर जाई ॥",
      "sourceLineId": "83425",
      "sourceShabadId": "7878",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਆਯੁਰਬੇਦ ਕੋ ਕਰੋ ਪ੍ਰਕਾਸਾ ॥",
      "transliteration": "aayurabedh ko karo prakaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਆਯੁਰਵੇਦ' ਪ੍ਰਗਟ ਕਰੋ",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "आयुरबेद को करो प्रकासा ॥",
      "sourceLineId": "83426",
      "sourceShabadId": "7878",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰੋਗ ਪ੍ਰਜਾ ਕੋ ਕਰਿਯਹੁ ਨਾਸਾ ॥੩॥",
      "transliteration": "rog prajaa ko kariyahu naasaa ||3||",
      "translation": "He also told him to spread Ayurveda and destroy the ailments of the subjects.3.",
      "punjabiViakhya": "ਅਤੇ ਪਰਜਾ ਦੇ ਸਾਰੇ ਰੋਗਾ ਨੂੰ ਨਾਸ ਕਰੋ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "रोग प्रजा को करियहु नासा ॥३॥",
      "sourceLineId": "83427",
      "sourceShabadId": "7878",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "83428",
      "sourceShabadId": "7879",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਾ ਤੇ ਦੇਵ ਇਕਤ੍ਰ ਹੁਐ ਮਥਯੋ ਸਮੁੰਦ੍ਰਹਿ ਜਾਇ ॥",
      "transliteration": "taa te dhev ikatr huaai mathayo samu(n)dhreh jai ||",
      "translation": "Then all the gods gathered and churned the ocean,",
      "punjabiViakhya": "ਇਸ ਵਾਸਤੇ ਦੇਵਤੇ (ਅਤੇ ਦੈਤਾ ਨੇ) ਮਿਲ ਕੇ ਸਮੁੰਦਰ ਨੂੰ ਜਾ ਰਿੜਕਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "ता ते देव इकत्र हुऐ मथयो समुँद्रहि जाइ ॥",
      "sourceLineId": "83429",
      "sourceShabadId": "7879",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰੋਗ ਬਿਨਾਸਨ ਪ੍ਰਜਾ ਹਿਤ ਕਢਯੋ ਧਨੰਤਰ ਰਾਇ ॥੪॥",
      "transliteration": "rog binaasan prajaa hit kaddayo dhana(n)tar rai ||4||",
      "translation": "And for the welfare of the subjects and destruction of their ailments, they acquired Dhanantar from the ocean.4.",
      "punjabiViakhya": "ਅਤੇ ਲੋਕਾ ਦੇ ਰੋਗਾ ਨੂੰ ਨਾਸ਼ ਕਰਨ ਲਈ (ਸਮੁੰਦਰ ਵਿਚੋਂ) ਧਨੰਤਰੀ ਰਾਜੇ ਨੂੰ ਕੱਢਿਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "रोग बिनासन प्रजा हित कढयो धनंतर राइ ॥४॥",
      "sourceLineId": "83430",
      "sourceShabadId": "7879",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "83431",
      "sourceShabadId": "7880",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਆਯੁਰਬੇਦ ਤਿਨ ਕੀਯੋ ਪ੍ਰਕਾਸਾ ॥",
      "transliteration": "aayurabedh tin keeyo prakaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਧਨੰਤਰੀ ਨੇ ਜਗਤ ਵਿੱਚ 'ਆਯੁਰਵੇਦ' ਪ੍ਰਗਟ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "आयुरबेद तिन कीयो प्रकासा ॥",
      "sourceLineId": "83432",
      "sourceShabadId": "7880",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0194_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਗ ਕੇ ਰੋਗ ਕਰੇ ਸਬ ਨਾਸਾ ॥",
      "transliteration": "jag ke rog kare sab naasaa ||",
      "translation": "He spread Ayurveda and destroyed the ailments from the whole world.",
      "punjabiViakhya": "ਅਤੇ ਜਗਤ ਦੇ ਸਾਰੇ ਰੋਗਾ ਨੂੰ ਨਸ਼ਟ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": "जग के रोग करे सब नासा ॥",
      "sourceLineId": "83433",
