{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 196,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0196_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਟੂਕ ਟੂਕ ਹੁਐ ਗਿਰੇ ਨ ਪਗ ਪਾਛੇ ਫਿਰੇ ॥",
      "transliteration": "Took Took huaai gire na pag paachhe fire ||",
      "translation": "Holding their swords in their hands, the warriors of both the side, fought with one another in the battlefield. They fell, having been chopped into bits, but still they did not retrace their steps.",
      "punjabiViakhya": "ਟੋਟੇ-ਟੋਟੇ ਹੋ ਕੇ (ਧਰਤੀ ਉੱਤੇ) ਡਿੱਗਣ ਲੱਗੇ, ਪਰ ਪਿੱਛੇ ਨੂੰ ਪੈਰ ਨਾ ਮੋੜਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "टूक टूक हुऐ गिरे न पग पाछे फिरे ॥",
      "sourceLineId": "83483",
      "sourceShabadId": "7887",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅੰਗਨਿ ਸੋਭੇ ਘਾਇ ਪ੍ਰਭਾ ਅਤਿ ਹੀ ਬਢੇ ॥",
      "transliteration": "a(n)gan sobhe ghai prabhaa at hee badde ||",
      "translation": "",
      "punjabiViakhya": "ਸਰੀਰਾ ਉੱਤੇ ਜ਼ਖ਼ਮ ਲੱਗਣ ਨਾਲ ਉਨ੍ਰਹਾ ਦੀ ਸ਼ੋਭਾ ਬਹੁਤ ਵਧ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "अंगनि सोभे घाइ प्रभा अति ही बढे ॥",
      "sourceLineId": "83484",
      "sourceShabadId": "7887",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹੋ ਬਸਤ੍ਰ ਮਨੋ ਛਿਟਕਾਇ ਜਨੇਤੀ ਸੇ ਚਢੇ ॥੧੦॥",
      "transliteration": "ho basatr mano chhiTakai janetee se chadde ||10||",
      "translation": "Having been wounded, their increased still further and they appeared like the members of the marriage party walking and exhibiting their dressers.10.",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਲਾਲ ਰੰਗ ਦੇ ਕੱਪੜੇ ਪਾ ਕੇ (ਜਾੀ) ਬਰਾਤ ਨਾਲ ਚੜ੍ਰਹੇ ਹੋਣ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "हो बसत्र मनो छिटकाइ जनेती से चढे ॥१०॥",
      "sourceLineId": "83485",
      "sourceShabadId": "7887",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਨੁਭਵ ਛੰਦ ॥",
      "transliteration": "anubhav chha(n)dh ||",
      "translation": "ANBHAV STANZA",
      "punjabiViakhya": "ਅਨੁਭਵ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "अनुभव छंद ॥",
      "sourceLineId": "83486",
      "sourceShabadId": "7888",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਨਹਦ ਬੱਜੇ ॥",
      "transliteration": "anahadh ba'je ||",
      "translation": "",
      "punjabiViakhya": "ਧੌਸੇ ਵਜਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "अनहद बज्जे ॥",
      "sourceLineId": "83487",
      "sourceShabadId": "7888",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਧੁਣ ਘਣ ਲੱਜੇ ॥",
      "transliteration": "dhun ghan la'je ||",
      "translation": "Hearing the resounding of the trumpets, the clouds are feeling shy.",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦੀ) ਅਵਾਜ਼ ਅੱਗੇ ਬੱਦਲ ਵੀ ਲਜਾਉਾਂਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "धुण घण लज्जे ॥",
      "sourceLineId": "83488",
      "sourceShabadId": "7888",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਘਣ ਹਣ ਘੋਰੰ ॥",
      "transliteration": "ghan han ghora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਡਗਿਆਂ ਦੇ ਵੱਜਣ ਤੋਂ ਜੋ ਗੂੰਜ ਉੱਠਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "घण हण घोरं ॥",
      "sourceLineId": "83489",
      "sourceShabadId": "7888",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਣ ਬਣ ਮੋਰੰ ॥੧੧॥",
      "transliteration": "jan ban mora(n) ||11||",
      "translation": "The army is swelling forward like the clouds, from all the four side, and it appears that there is a large gathering of peacocks in the forest.11.",
      "punjabiViakhya": "(ਇੰਜ ਲੱਗਦਾ ਸੀ) ਮਾਨੋ ਜੰਗਲ ਵਿੱਚ ਮੋਰ (ਕੂਕਦੇ ਹੋਣ) ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "जण बण मोरं ॥११॥",
      "sourceLineId": "83490",
      "sourceShabadId": "7888",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਧੁਰ ਧੁਨਿ ਛੰਦ ॥",
      "transliteration": "madhur dhun chha(n)dh ||",
      "translation": "MADHUR DHUN STANZA",
      "punjabiViakhya": "ਮਧੁਰ ਧੁਨਿ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "मधुर धुनि छंद ॥",
      "sourceLineId": "83491",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਢਲ ਹਲ ਢਾਲੰ ॥",
      "transliteration": "ddal hal ddaala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਢਾਲਾ (ਇੰਜ) ਚਮਕਦੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "ढल हल ढालं ॥",
      "sourceLineId": "83492",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਮ ਗੁਲ ਲਾਲੰ ॥",
      "transliteration": "jim gul laala(n) ||",
      "translation": "The luster of the shields appears like the red roses.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਲਾਲਾ ਦੇ ਫੁੱਲ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "जिम गुल लालं ॥",
      "sourceLineId": "83493",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਖੜ ਭੜ ਬੀਰੰ ॥",
      "transliteration": "khaR bhaR beera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਵਿੱਚ ਖੜਬੜਾਹਟ (ਮਚੀ ਹੋਈ ਸੀ)",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "खड़ भड़ बीरं ॥",
      "sourceLineId": "83494",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤੜ ਸੜ ਤੀਰੰ ॥੧੨॥",
      "transliteration": "taR saR teera(n) ||12||",
      "translation": "The movement of warriors and the shooting of arrows are creating different distinct sounded.12.",
      "punjabiViakhya": "ਅਤੇ ਤੀਰ ਤੜ-ਸੜ ਅਵਾਜ਼ ਕਰਦੇ (ਚਲ ਰਹੇ ਸਨ) ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "तड़ सड़ तीरं ॥१२॥",
      "sourceLineId": "83495",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰੁਣ ਝੁਣ ਬਾਜੇ ॥",
      "transliteration": "run jhun baaje ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਰੁਣ-ਝੁਣ ਕਰਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "रुण झुण बाजे ॥",
      "sourceLineId": "83496",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਣ ਘਣ ਗਾਜੇ ॥",
      "transliteration": "jan ghan gaaje ||",
      "translation": "Such a sound is being heard in the battlefield as if the clouds are thundering.",
      "punjabiViakhya": "ਮਾਨੋ ਬੱਦਲ ਗੱਜਦੇ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "जण घण गाजे ॥",
      "sourceLineId": "83497",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਢੰਮਕ ਢੋਲੰ ॥",
      "transliteration": "dda(n)mak ddola(n) ||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲਾ ਦੀ ਢਮਕਾਰ ਹੋ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "ढंमक ढोलं ॥",
      "sourceLineId": "83498",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਖੜ ਰੜ ਖੋਲੰ ॥੧੩॥",
      "transliteration": "khaR raR khola(n) ||13||",
      "translation": "The resounding of the drums and the sound of the empty quivers is also being hard.13.",
      "punjabiViakhya": "ਖੋਲਾ ਵਿੱਚ ਖੜ-ਖੜ ਦੀ ਅਵਾਜ਼ ਨਿਕਲ ਰਹੀ ਸੀ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "खड़ रड़ खोलं ॥१३॥",
      "sourceLineId": "83499",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਥਰ ਹਰ ਕੰਪੈ ॥",
      "transliteration": "thar har ka(n)pai ||",
      "translation": "",
      "punjabiViakhya": "ਡਰਪੋਕ ਥਰ-ਥਰ ਕੰਬਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "थर हर कंपै ॥",
      "sourceLineId": "83500",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਜੰਪੈ ॥",
      "transliteration": "har har ja(n)pai ||",
      "translation": "The warriors are battled and seeing the dreadful war, they are mediating upon the Lord-God.",
      "punjabiViakhya": "ਅਤੇ ਹਰਿ ਹਰਿ ਜਪਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "हरि हरि जंपै ॥",
      "sourceLineId": "83501",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਣ ਰੰਗ ਰੱਤੇ ॥",
      "transliteration": "ran ra(n)g ra'te ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਦੇ ਰੰਗ ਵਿੱਚ ਸੂਰਮੇ ਰਤੇ ਹੋਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "रण रंग रत्ते ॥",
      "sourceLineId": "83502",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਣ ਗਣ ਮਤੇ ॥੧੪॥",
      "transliteration": "jan gan mate ||14||",
      "translation": "All are absorbed in the war and are submerged in the thoughts of war.14.",
      "punjabiViakhya": "ਮਾਨੋ ਮਸਤ ਹਾਥੀ (ਘੁਲ ਰਹੇ) ਹੋਣ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "जण गण मते ॥१४॥",
      "sourceLineId": "83503",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਥਰਕਤ ਸੂਰੰ ॥",
      "transliteration": "tharakat soora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਥਿਰਕਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "थरकत सूरं ॥",
      "sourceLineId": "83504",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਿਰਖਤ ਹੂਰੰ ॥",
      "transliteration": "nirakhat hoora(n) ||",
      "translation": "The brave fighters are moving hither and thither and the heavenly damsels are looking at them.",
      "punjabiViakhya": "ਅਤੇ ਹੂਰਾ ਉਨ੍ਰਹਾ ਨੂੰ ਵੇਖ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "निरखत हूरं ॥",
      "sourceLineId": "83505",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0196_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਰਬਰ ਛੁੱਟੇ ॥",
      "transliteration": "sarabar chhu'Te ||",
      "translation": "",
      "punjabiViakhya": "ਉੱਤਮ ਤੀਰ ਚੱਲਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": "सरबर छुट्टे ॥",
      "sourceLineId": "83506",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
