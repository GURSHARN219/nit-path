{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 197,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0197_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਟ ਭਟ ਲੁਟੇ ॥੧੫॥",
      "transliteration": "kaT bhaT luTe ||15||",
      "translation": "The heroes have abandoned everything and having been chopped several warriors have played with their lives.15.",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨਾਲ) ਕਟ-ਕਟ ਕੇ (ਸੂਰਮੇ) ਲੋਟਦੇ ਜਾ ਰਹੇ ਸਨ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "कट भट लुटे ॥१५॥",
      "sourceLineId": "83507",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚਮਕਤ ਬਾਣੰ ॥",
      "transliteration": "chamakat baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ ਚਮਕਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "चमकत बाणं ॥",
      "sourceLineId": "83508",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਫੁਰਹ ਨਿਸਾਣੰ ॥",
      "transliteration": "fureh nisaana(n) ||",
      "translation": "The arrows are glittering and the flags are flying",
      "punjabiViakhya": "ਝੰਡੇ ਝੂਲਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "फुरह निसाणं ॥",
      "sourceLineId": "83509",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚਟ ਪਟ ਜੂਟੇ ॥",
      "transliteration": "chaT paT jooTe ||",
      "translation": "",
      "punjabiViakhya": "ਝਟ-ਪਟ (ਸੂਰਮੇ ਯੁੱਧ ਵਿੱਚ) ਜੁਟਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "चट पट जूटे ॥",
      "sourceLineId": "83510",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਰ ਉਰ ਫੂਟੇ ॥੧੬॥",
      "transliteration": "ar ur fooTe ||16||",
      "translation": "The warriors are fighting face to face very quickly and the blood is oozing out of their chests.16.",
      "punjabiViakhya": "ਅਤੇ ਵੈਰੀ ਦੀ ਛਾਤੀ ਨੂੰ ਪਾੜ ਦਿੰਦੇ ਸਨ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "अर उर फूटे ॥१६॥",
      "sourceLineId": "83511",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਰ ਬਰ ਗੱਜੇ ॥",
      "transliteration": "nar bar ga'je ||",
      "translation": "",
      "punjabiViakhya": "ਬਲਵਾਨ ਯੋਧੇ ਗਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "नर बर गज्जे ॥",
      "sourceLineId": "83512",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਰ ਬਰ ਸੱਜੇ ॥",
      "transliteration": "sar bar sa'je ||",
      "translation": "Bedecked with the arrows, the brave warriors are roaring",
      "punjabiViakhya": "(ਉਹ) ਉੱਤਮ ਤੀਰਾ ਨਾਲ ਸਜੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "सर बर सज्जे ॥",
      "sourceLineId": "83513",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਿਲਹ ਸੰਜੋਯੰ ॥",
      "transliteration": "sileh sa(n)joya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧੇ ਕਵਚਾ ਅਤੇ ਸੰਜੋਆਂ ਨਾਲ ਸਜੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "सिलह संजोयं ॥",
      "sourceLineId": "83514",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੁਰ ਪੁਰ ਪੋਯੰ ॥੧੭॥",
      "transliteration": "sur pur poya(n) ||17||",
      "translation": "They are ornamented with steel armours and are moving towards heaven.17.",
      "punjabiViakhya": "ਅਤੇ ਸੁਅਰਗ ਵਿੱਚ ਪਹੁੰਚਦੇ ਜਾਦੇ ਸਨ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "सुर पुर पोयं ॥१७॥",
      "sourceLineId": "83515",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਰਬਰ ਛੂਟੇ ॥",
      "transliteration": "sarabar chhooTe ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੇਸ਼ਠ ਤੀਰ ਚਲਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "सरबर छूटे ॥",
      "sourceLineId": "83516",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਰ ਉਰ ਫੂਟੇ ॥",
      "transliteration": "ar ur fooTe ||",
      "translation": "When the superior arrows are discharged, the chests of the enemies are wounded.",
      "punjabiViakhya": "(ਜੋ) ਵੈਰੀ ਦੀ ਛਾਤੀ ਨੂੰ ਪਾੜ ਦਿੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "अर उर फूटे ॥",
      "sourceLineId": "83517",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਚਟ ਪਟ ਚਰਮੰ ॥",
      "transliteration": "chaT paT charama(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਤੀਰ) ਝਟਪਟ ਢਾਲ (ਨੂੰ ਪਾੜ ਦਿੰਦੇ ਸਨ)",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "चट पट चरमं ॥",
      "sourceLineId": "83518",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਫਟ ਫੁਟ ਬਰਮੰ ॥੧੮॥",
      "transliteration": "faT fuT barama(n) ||18||",
      "translation": "The shields being cut are producing knocking sound and the armours are being torn.18.",
      "punjabiViakhya": "ਅਤੇ ਕਵਚ ਨੂੰ ਫੋੜ ਦਿੰਦੇ ਸਨ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "फट फुट बरमं ॥१८॥",
      "sourceLineId": "83519",
      "sourceShabadId": "7889",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "naraaj chha(n)dh ||",
      "translation": "NARAAJ STANZA",
      "punjabiViakhya": "ਨਰਾਜ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "नराज छंद ॥",
      "sourceLineId": "83520",
      "sourceShabadId": "7890",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦਿਨੇਸ ਬਾਣ ਪਾਣ ਲੈ ਰਿਪੇਸ ਤਾਕ ਧਾਈਯੰ ॥",
      "transliteration": "dhines baan paan lai ripes taak dhaieeya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਜ ਹੱਥ ਵਿੱਚ ਬਾਣ ਲੈ ਕੇ ਵੱਡੇ ਦੁਸ਼ਮਣ ਦੀਰਘ ਕਾਇ ਨੂੰ ਵੇਖ ਕੇ ਭੱਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "दिनेस बाण पाण लै रिपेस ताक धाईयं ॥",
      "sourceLineId": "83521",
      "sourceShabadId": "7890",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਨੰਤ ਜੁੱਧ ਕ੍ਰੁੱਧ ਸੁੱਧੁ ਭੂਮ ਮੈ ਮਚਾਈਯੰ ॥",
      "transliteration": "ana(n)t ju'dh kru'dh su'dh bhoom mai machaieeya(n) ||",
      "translation": "Taking his arrow in his hand, Suraj ran towards the enemy Deeraghkaya and in great ire began a dreadful war.",
      "punjabiViakhya": "ਯੁੱਧ-ਭੂਮੀ ਵਿੱਚ (ਜਾ ਕੇ) ਕ੍ਰੋਧ ਨਾਲ ਅਨੰਤ ਤਰ੍ਰਹਾ ਦਾ ਯੁੱਧ ਮਚਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "अनंत जुद्ध क्रुद्ध सुद्धु भूम मै मचाईयं ॥",
      "sourceLineId": "83522",
      "sourceShabadId": "7890",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਿਤੇਕ ਭਾਜ ਚਾਲੀਯੰ ਸੁਰੇਸ ਲੋਗ ਕੋ ਗਏ ॥",
      "transliteration": "kitek bhaaj chaaleeya(n) sures log ko ge ||",
      "translation": "",
      "punjabiViakhya": "ਕਿੰਨੇ ਹੀ ਦੈਤ ਭੱਜ ਕੇ ਇੰਦਰ ਪੁਰੀ ਵੱਲ ਚਲੇ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "कितेक भाज चालीयं सुरेस लोग को गए ॥",
      "sourceLineId": "83523",
      "sourceShabadId": "7890",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਿਸੰਤ ਜੀਤ ਜੀਤ ਕੈ ਅਨੰਤ ਸੂਰਮਾ ਲਏ ॥੧੯॥",
      "transliteration": "nisa(n)t jeet jeet kai ana(n)t sooramaa le ||19||",
      "translation": "Many people came running under the refuge of gods, and Suraj, who ends the night, conquered many warriors.19.",
      "punjabiViakhya": "ਅਨੰਤ ਸੂਰਮਿਆਂ ਨੂੰ ਸੂਰਜ ਨੇ ਜਿੱਤ ਲਿਆ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "निसंत जीत जीत कै अनंत सूरमा लए ॥१९॥",
      "sourceLineId": "83524",
      "sourceShabadId": "7890",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਮੱਟ ਸੇਲ ਸਾਮੁਹੇ ਸਰੱਕ ਸੂਰ ਝਾੜਹੀਂ ॥",
      "transliteration": "sama'T sel saamuhe sara'k soor jhaaRahee(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਸਿਮਟ ਕੇ ਸਾਹਮਣੇ ਵਲ ਨੂੰ ਸਰ-ਸਰ ਕਰਦੇ ਬਰਛੇ ਚਲਾਉਾਂਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "समट्ट सेल सामुहे सरक्क सूर झाड़हीं ॥",
      "sourceLineId": "83525",
      "sourceShabadId": "7890",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਬੱਕ ਬਾਘ ਜਯੋਂ ਬਲੀ ਹਲੱਕ ਹਾਕ ਮਾਰਹੀਂ ॥",
      "transliteration": "baba'k baagh jayo(n) balee hala'k haak maarahee(n) ||",
      "translation": "The warriors are striking the daggers, holding them tightly and coming face to face and the brave fighters are challenging one another, roaring like the lions.",
      "punjabiViakhya": "ਬਾਘ ਵੰਗ ਬੜ੍ਰਹਕਦੇ ਹੋਏ ਸੂਰਮੇ ਹੱਲਾ ਕਰਨ ਲਈ (ਲਲਕਾਰੇ ਮਾਰਦੇ ਸਨ)",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "बबक्क बाघ जयों बली हलक्क हाक मारहीं ॥",
      "sourceLineId": "83526",
      "sourceShabadId": "7890",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਭੰਗ ਅੰਗ ਭੰਗ ਹ੍ਵੈ ਉਤੰਗ ਜੰਗ ਮੋ ਗਿਰੇ ॥",
      "transliteration": "abha(n)g a(n)g bha(n)g havai uta(n)g ja(n)g mo gire ||",
      "translation": "",
      "punjabiViakhya": "ਦ੍ਰਿੜ੍ਰਹ ਅੰਗਾ ਵਾਲਿਆਂ (ਅਭੰਗ) ਦੋ ਅੰਗ-ਭੰਗ ਹੁੰਦੇ ਜਾ ਰਹੇ ਸਨ ਅਤੇ ਉਛਲ-ਉਛਲ ਕੇ ਰਣਭੂਮੀ ਵਿੱਚ ਡਿਗ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "अभंग अंग भंग ह्वै उतंग जंग मो गिरे ॥",
      "sourceLineId": "83527",
      "sourceShabadId": "7890",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੁਰੰਗ ਸੂਰਮਾ ਸਭੈ ਨਿਸੰਗ ਜਾਨ ਕੈ ਅਰੈ ॥੨੦॥",
      "transliteration": "sura(n)g sooramaa sabhai nisa(n)g jaan kai arai ||20||",
      "translation": "The firm limbs, after swinging continuously, are falling down and the brave and beautiful fighters, fearlessly coming face to face with others are clashing.20.",
      "punjabiViakhya": "ਸੂਹੇ ਰੰਗ ਵਿੱਚ ਰੰਗੇ ਹੋਏ ਸਾਰੇ ਯੋਧੇ ਨਿਡਰ ਹੋ ਕੇ (ਵੈਰੀ ਨਾਲ) ਜੁਟੇ ਹੋਏ ਸਨ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "सुरंग सूरमा सभै निसंग जान कै अरै ॥२०॥",
      "sourceLineId": "83528",
      "sourceShabadId": "7890",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਰਧ ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "aradh naraaj chha(n)dh ||",
      "translation": "ARDH NARAAJ STANZA",
      "punjabiViakhya": "ਅਰਧ ਨਰਾਜ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "अरध नराज छंद ॥",
      "sourceLineId": "83529",
      "sourceShabadId": "7891",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਵੰ ਨਿਸਾਣ ਬਾਜੀਯੰ ॥",
      "transliteration": "nava(n) nisaan baajeeya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨਵੇਾਂ ਨਗਾਰੇ ਵਜਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "नवं निसाण बाजीयं ॥",
      "sourceLineId": "83530",
      "sourceShabadId": "7891",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਘਟਾ ਘਮੰਡ ਲਾਜੀਯੰ ॥",
      "transliteration": "ghaTaa ghama(n)dd laajeeya(n) ||",
      "translation": "Listening to the resonance of the trumpets, the clouds are feeling shy.",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦੀ ਆਵਾਜ਼ ਅੱਗੋਂ ਘਟਾਵਾ ਵੀ ਲਜਾਉਾਂਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "घटा घमंड लाजीयं ॥",
      "sourceLineId": "83531",
      "sourceShabadId": "7891",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਬੱਲ ਤੁੰਦਰੰ ਬਜੇ ॥",
      "transliteration": "taba'l tu(n)dhara(n) baje ||",
      "translation": "",
      "punjabiViakhya": "ਛੋਟੇ ਨਗਾਰੇ ਵਜਣ ਲੱਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "तबल्ल तुँदरं बजे ॥",
      "sourceLineId": "83532",
      "sourceShabadId": "7891",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੁਣੰਤ ਸੂਰਮਾ ਗਜੇ ॥੨੧॥",
      "transliteration": "suna(n)t sooramaa gaje ||21||",
      "translation": "The fastened trumpets have resounded and haring their sound, the warriors are thundering.21.",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦੀ ਆਵਾਜ਼ ਸੁਣ ਕੇ ਸੂਰਮੇ ਗੱਜਣ ਲੱਗ ਪਏ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "सुणंत सूरमा गजे ॥२१॥",
      "sourceLineId": "83533",
      "sourceShabadId": "7891",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੁ ਜੂਝਿ ਜੂਝਿ ਕੈ ਪਰੈਂ ॥",
      "transliteration": "s joojh joojh kai parai(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਲੜਾਕੇ ਯੋਧੇ) ਜੂਝ-ਜੂਝ ਕੇ ਡਿੱਗਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "सु जूझि जूझि कै परैं ॥",
      "sourceLineId": "83534",
      "sourceShabadId": "7891",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੁਰੇਸ ਲੋਗ ਬਿਚਰੈਂ ॥",
      "transliteration": "sures log bicharai(n) ||",
      "translation": "Fighting ferociously, the gods and their kings are moving (here and there).",
      "punjabiViakhya": "ਅਤੇ ਇੰਦਰ ਲੋਕ ਨੂੰ ਚਲੇ ਜਾਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "सुरेस लोग बिचरैं ॥",
      "sourceLineId": "83535",
      "sourceShabadId": "7891",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚੜੈ ਬਿਵਾਨ ਸੋਭਹੀ ॥",
      "transliteration": "chaRai bivaan sobhahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਵਿਮਾਨਾ ਉੱਤੇ ਚੜ੍ਰਹ ਕੇ ਸ਼ੋਭਾ ਪਾਉਾਂਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "चड़ै बिवान सोभही ॥",
      "sourceLineId": "83536",
      "sourceShabadId": "7891",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਦੇਵ ਦੇਵ ਲੋਭਹੀ ॥੨੨॥",
      "transliteration": "adhev dhev lobhahee ||22||",
      "translation": "They are roaming by mountain on air-vehicles and the harts of the gods and demons both are feeling envious.22.",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨੂੰ ਵੇਖ ਕੇ) ਦੈਂਤ ਅਤੇ ਦੇਵਤੇ (ਉਸ ਪਦਵੀ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰਨ ਲਈ) ਸ਼ੁਭਾਇਮਾਨ ਹੁੰਦੇ ਸਨ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "अदेव देव लोभही ॥२२॥",
      "sourceLineId": "83537",
      "sourceShabadId": "7891",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬੇਲੀ ਬਿੰਦ੍ਰਮ ਛੰਦ ॥",
      "transliteration": "belee bi(n)dhram chha(n)dh ||",
      "translation": "BELI BINDRAM STANZA",
      "punjabiViakhya": "ਬੇਲੀ ਬਿਦ੍ਰਮ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "बेली बिंद्रम छंद ॥",
      "sourceLineId": "83538",
      "sourceShabadId": "7892",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਡਹ ਡਹ ਸੁ ਡਾਮਰ ਡੰਕਣੀ ॥",
      "transliteration": "ddeh ddeh su ddaamar dda(n)kanee ||",
      "translation": "",
      "punjabiViakhya": "ਡਾਹ-ਡਾਹ ਕਰਦੇ ਡਮਰੂ ਵਜ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "डह डह सु डामर डंकणी ॥",
      "sourceLineId": "83539",
      "sourceShabadId": "7892",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਹ ਕਹ ਸੁ ਕੂਕਤ ਜੋਗਣੀ ॥",
      "transliteration": "keh keh su kookat joganee ||",
      "translation": "The sound of he tabors of vampires and the cries of the Yoginis are being heard.",
      "punjabiViakhya": "ਅਤੇ ਕਹ-ਕਹ ਕਰਦੀਆਂ ਜੋਗਣਾ ਕੂਕ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "कह कह सु कूकत जोगणी ॥",
      "sourceLineId": "83540",
      "sourceShabadId": "7892",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਝਮ ਝਮਕ ਸਾਗ ਝਮੱਕੀਯੰ ॥",
      "transliteration": "jham jhamak saag jhama'keeya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਝਮ-ਝਮ ਕਰਦੇ ਬਰਛੇ ਚਮਕਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "झम झमक साग झमक्कीयं ॥",
      "sourceLineId": "83541",
      "sourceShabadId": "7892",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰਣ ਗਾਜ ਬਾਜ ਉਥੱਕੀਯੰ ॥੨੩॥",
      "transliteration": "ran gaaj baaj utha'keeya(n) ||23||",
      "translation": "The daggers are glistening and glittering and the elephants and horses are jumping in the battlefield.23.",
      "punjabiViakhya": "ਅਤੇ ਰਣ-ਭੂਮੀ ਵਿੱਚ ਹਾਥੀ ਅਤੇ ਘੋੜੇ ਉਛਲਦੇ ਸਨ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "रण गाज बाज उथक्कीयं ॥२३॥",
      "sourceLineId": "83542",
      "sourceShabadId": "7892",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਢਮ ਢਮਕ ਢੋਲ ਢਮੱਕੀਯੰ ॥",
      "transliteration": "ddam ddamak ddol ddama'keeya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਢੰਮ-ਢੰਮ ਢੋਲ ਢਮਕਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "ढम ढमक ढोल ढमक्कीयं ॥",
      "sourceLineId": "83543",
      "sourceShabadId": "7892",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਝਲ ਝਲਕ ਤੇਗ ਝਲੱਕੀਯੰ ॥",
      "transliteration": "jhal jhalak teg jhala'keeya(n) ||",
      "translation": "The resonance of drum is being heard and the luster of swords is glimmering.",
      "punjabiViakhya": "ਝਲ-ਝਲ ਕਰਦੀਆਂ ਤੇਗਾ ਲਿਸ਼ਕ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "झल झलक तेग झलक्कीयं ॥",
      "sourceLineId": "83544",
      "sourceShabadId": "7892",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਟ ਛੋਰ ਰੁਦ੍ਰ ਤਹ ਨੱਚੀਯੰ ॥",
      "transliteration": "jaT chhor rudhr teh na'cheeya(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸਿਰ ਦਾ) ਜੂੜਾ ਖੋਲ੍ਰਹ ਕੇ ਰੁਦ੍ਰ ਉਥੇ ਨੱਚਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "जट छोर रुद्र तह नच्चीयं ॥",
      "sourceLineId": "83545",
      "sourceShabadId": "7892",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਿਕ੍ਰਾਰ ਮਾਰ ਤਹ ਮੱਚੀਯੰ ॥੨੪॥",
      "transliteration": "bikraar maar teh ma'cheeya(n) ||24||",
      "translation": "Rudra is also dancing there with his loosened matted hair and a dreadful war is being waged there.24.",
      "punjabiViakhya": "ਉਥੇ ਭਿਆਨਕ ਮਾਰ ਮੱਚੀ ਹੋਈ ਸੀ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "बिक्रार मार तह मच्चीयं ॥२४॥",
      "sourceLineId": "83546",
      "sourceShabadId": "7892",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤੋਟਕ ਛੰਦ ॥",
      "transliteration": "toTak chha(n)dh ||",
      "translation": "TOTAK STANZA",
      "punjabiViakhya": "ਤੋਟਕ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "तोटक छंद ॥",
      "sourceLineId": "83547",
      "sourceShabadId": "7893",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਉਥਕੇ ਰਣ ਬੀਰਣ ਬਾਜ ਬਰੰ ॥",
      "transliteration": "authake ran beeran baaj bara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਦੇ ਘੋੜੇ ਰਣ ਵਿੱਚ ਉਛਲਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "उथके रण बीरण बाज बरं ॥",
      "sourceLineId": "83548",
      "sourceShabadId": "7893",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਝਮਕੀ ਘਣ ਬਿੱਜੁ ਕ੍ਰਿਪਾਣ ਕਰੰ ॥",
      "transliteration": "jhamakee ghan bi'j kirapaan kara(n) ||",
      "translation": "The winsome horses of the warriors are jumping in the war and the sword are glistening in their hands like the flash of lightning in the clouds.",
      "punjabiViakhya": "ਬੱਦਲਾ ਵਿੱਚ ਬਿਜਲੀ ਵਾਗ, ਹੱਥਾ ਵਿੱਚ ਕ੍ਰਿਪਾਨਾ ਚਮਕਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "झमकी घण बिज्जु कृपाण करं ॥",
      "sourceLineId": "83549",
      "sourceShabadId": "7893",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਲਹਕੇ ਰਣ ਧੀਰਣ ਬਾਣ ਉਰੰ ॥",
      "transliteration": "lahake ran dheeran baan ura(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ ਦੇ ਧੀਰਜਵਾਨ (ਸੂਰਮਿਆਂ) ਦੀ ਛਾਤੀ ਵਿੱਚੋਂ ਬਾਣ ਲੰਘ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "लहके रण धीरण बाण उरं ॥",
      "sourceLineId": "83550",
      "sourceShabadId": "7893",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰੰਗ ਸ੍ਰੋਣਤ ਰੱਤ ਕਢੇ ਦੁਸਰੰ ॥੨੫॥",
      "transliteration": "ra(n)g sronat ra't kadde dhusara(n) ||25||",
      "translation": "The arrows are seen penetrated in the waist of the warriors and they are taking out the blood of one antoher.25.",
      "punjabiViakhya": "ਲਹੂ ਦੇ ਰੰਗ ਨਾਲ ਰੱਤੇ ਹੋਏ ਦੂਜੇ ਪਾਸੇ ਨਿਕਲ ਜਾਦੇ ਸਨ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "रंग स्रोणत रत्त कढे दुसरं ॥२५॥",
      "sourceLineId": "83551",
      "sourceShabadId": "7893",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਫਹਰੰਤ ਧੁਜਾ ਥਹਰੰਤ ਭਟੰ ॥",
      "transliteration": "fahara(n)t dhujaa thahara(n)t bhaTa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਝੰਡੇ ਝੂਲਦੇ ਸਨ ਅਤੇ ਸੂਰਮੇ ਥਿਰਕਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "फहरंत धुजा थहरंत भटं ॥",
      "sourceLineId": "83552",
      "sourceShabadId": "7893",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਿਰਖੰਤ ਲਜੀ ਛਬਿ ਸਯਾਮ ਘਟੰ ॥",
      "transliteration": "nirakha(n)t lajee chhab sayaam ghaTa(n) ||",
      "translation": "The flags are fluttering and the brave fighters have become fearful, seeing the glitter of the arrows and the swords, the lightning in the dark clouds is also feeling shy",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੂੰ ਵੇਖ ਕੇ ਕਾਲੀ ਘਟਾ ਵੀ ਲਜਾਉਾਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "निरखंत लजी छबि सयाम घटं ॥",
      "sourceLineId": "83553",
      "sourceShabadId": "7893",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0197_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚਮਕੰਤ ਸੁ ਬਾਣ ਕ੍ਰਿਪਾਣ ਰਣੰ ॥",
      "transliteration": "chamaka(n)t su baan kirapaan rana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਵਿੱਚ ਤੀਰ ਅਤੇ ਤਲਵਾਰਾ ਇਉਾਂ ਚਮਕਦੀਆਂ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": "चमकंत सु बाण कृपाण रणं ॥",
      "sourceLineId": "83554",
      "sourceShabadId": "7893",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
