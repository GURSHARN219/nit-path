{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 198,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0198_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਮ ਕਉਾਂਧਿਤ ਸਾਵਣ ਬਿੱਜੁ ਘਣੰ ॥੨੬॥",
      "transliteration": "jim kauaa(n)dhit saavan bi'j ghana(n) ||26||",
      "translation": "And this scene looks like the flash of lightning in the thundering clouds of the month of Sawan.26.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਸਾਵਣ ਦੇ ਬੱਦਲਾ ਵਿੱਚ ਬਿਜਲੀ ਚਮਕਦੀ ਹੈ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "जिम कउाँधित सावण बिज्जु घणं ॥२६॥",
      "sourceLineId": "83555",
      "sourceShabadId": "7893",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "83556",
      "sourceShabadId": "7894",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਥਾ ਬ੍ਰਿਧ ਤੇ ਮੈ ਡਰੋ ਕਹਾ ਕਰੋ ਬਖਯਾਨ ॥",
      "transliteration": "kathaa biradh te mai ddaro kahaa karo bakhayaan ||",
      "translation": "How far should I narrate the story for fear of lengthening the same",
      "punjabiViakhya": "ਕਥਾ ਦੇ ਵਧ ਜਾਣ ਤੋਂ ਮੈਂ ਡਰਦਾ ਹਾ, ਕਿੱਥੋਂ ਤਕ ਕਥਨ ਕਰਾ?",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "कथा बृध ते मै डरो कहा करो बखयान ॥",
      "sourceLineId": "83557",
      "sourceShabadId": "7894",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਿਸਾਹੰਤ ਅਸੁਰੇਸ ਸੋ ਸਰ ਤੇ ਭਯੋ ਨਿਦਾਨ ॥੨੭॥",
      "transliteration": "nisaaha(n)t asures so sar te bhayo nidhaan ||27||",
      "translation": "Ultimately the arrows of Suraj became the reason for the end of that demon.27.",
      "punjabiViakhya": "(ਮੁਕਦੀ ਗੱਲ ਇਹ ਹੈ ਕਿ) ਸੂਰਜ (ਨਿਸਾਹੰਤ) ਦੇ ਤੀਰ ਨਾਲ ਅਸੁਰੇਸ (ਦੈਂਤ ਰਾਜ ਦੀਰਘ-ਕਾਇ) ਦਾ ਅੰਤ ਹੋ ਗਿਆ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "निसाहंत असुरेस सो सर ते भयो निदान ॥२७॥",
      "sourceLineId": "83558",
      "sourceShabadId": "7894",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਸੂਰਜ ਅਵਤਾਰ ਅਸਟ ਦਸਮੋ ਅਵਤਾਰ ਸਮਾਪਤ ॥੧੮॥",
      "transliteration": "eit sree bachitr naaTake sooraj avataar asaT dhasamo avataar samaapat ||18||",
      "translation": "End of the description of the Eighteenth Incarnation SURAJ in BACHITTAR NATAK.18.",
      "punjabiViakhya": "ਇਥੇ ਸੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦਾ ਸੂਰਜ ਅਠਾਰ੍ਰਹਵਾ ਸਮਾਪਤ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटके सूरज अवतार असट दसमो अवतार समापत ॥१८॥",
      "sourceLineId": "83559",
      "sourceShabadId": "7894",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਥ ਚੰਦ੍ਰ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "transliteration": "ath cha(n)dhr avataar kathana(n) ||",
      "translation": "Now begins the description of Chandra Incarnation:",
      "punjabiViakhya": "ਹੁਣ ਚੰਦ੍ਰ ਅਵਤਾਰ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "अथ चंद्र अवतार कथनं ॥",
      "sourceLineId": "83560",
      "sourceShabadId": "7895",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ ॥",
      "transliteration": "sree bhagautee jee sahai ||",
      "translation": "Let Sri Bhaguti Ji (The Primal Lord) be helpful.",
      "punjabiViakhya": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "स्री भगउती जी सहाइ ॥",
      "sourceLineId": "83561",
      "sourceShabadId": "7895",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੋਧਕ ਛੰਦ ॥",
      "transliteration": "dhodhak chha(n)dh ||",
      "translation": "DODHAK STANZA",
      "punjabiViakhya": "ਦੋਧਕ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "दोधक छंद ॥",
      "sourceLineId": "83562",
      "sourceShabadId": "7895",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਫੇਰਿ ਗਨੋ ਨਿਸਰਾਜ ਬਿਚਾਰਾ ॥",
      "transliteration": "fer gano nisaraaj bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ (ਮੈਂ) ਚੰਦ੍ਰਮਾ (ਨਿਸਰਾਜ) ਦਾ ਵਿਚਾਰ ਕਰਦਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "फेरि गनो निसराज बिचारा ॥",
      "sourceLineId": "83563",
      "sourceShabadId": "7895",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜੈਸ ਧਰਯੋ ਅਵਤਾਰ ਮੁਰਾਰਾ ॥",
      "transliteration": "jais dharayo avataar muraaraa ||",
      "translation": "Now I think about Chandrama, how did Vishnu manifest as Chandra incarnation?",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਵਿਸ਼ਣੂ ਨੇ ਚੰਦਰ ਅਵਤਾਰ ਧਾਰਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "जैस धरयो अवतार मुरारा ॥",
      "sourceLineId": "83564",
      "sourceShabadId": "7895",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਾਤ ਪੁਰਾਤਨ ਭਾਖ ਸੁਨਾਊਾਂ ॥",
      "transliteration": "baat puraatan bhaakh sunaauooaa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਪੁਰਾਣੀ ਕਥਾ ਕਹਿ ਕੇ ਸੁਣਾਉਾਂਦਾ ਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "बात पुरातन भाख सुनाऊाँ ॥",
      "sourceLineId": "83565",
      "sourceShabadId": "7895",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਾ ਤੇ ਕਬ ਕੁਲ ਸਰਬ ਰਿਝਾਊਾਂ ॥੧॥",
      "transliteration": "jaa te kab kul sarab rijhaauooaa(n) ||1||",
      "translation": "I an narriating a very ancient story, hearing which all the poets will be pleased.1.",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਸਾਰੇ ਕਵੀ-ਕੁਲ ਨੂੰ ਪ੍ਰਸੰਨ ਕਰਦਾ ਹਾ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "जा ते कब कुल सरब रिझाऊाँ ॥१॥",
      "sourceLineId": "83566",
      "sourceShabadId": "7895",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦੋਧਕ ॥",
      "transliteration": "dhodhak ||",
      "translation": "DODHAK STANZA",
      "punjabiViakhya": "ਦੋਧਕ:",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "दोधक ॥",
      "sourceLineId": "83567",
      "sourceShabadId": "7896",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨੈਕ ਕ੍ਰਿਸਾ ਕਹੁ ਠਉਰ ਨ ਹੋਈ ॥",
      "transliteration": "naik kirasaa kahu Thaur na hoiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਜਗ੍ਰਹਾ ਤੇ ਥੋੜ੍ਰਹੀ ਜਿੰਨੀ ਖੇਤੀ ਵੀ ਨਹੀਂ ਹੁੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "नैक कृसा कहु ठउर न होई ॥",
      "sourceLineId": "83568",
      "sourceShabadId": "7896",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭੂਖਨ ਲੋਗ ਮਰੈ ਸਭ ਕੋਈ ॥",
      "transliteration": "bhookhan log marai sabh koiee ||",
      "translation": "There was not even a little farming anywhere and the people were dying with hunger.",
      "punjabiViakhya": "ਭੁੱਖ ਨਾਲ ਸਾਰੇ ਲੋਕ ਮਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "भूखन लोग मरै सभ कोई ॥",
      "sourceLineId": "83569",
      "sourceShabadId": "7896",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅੰਧਿ ਨਿਸਾ ਦਿਨ ਭਾਨੁ ਜਰਾਵੈ ॥",
      "transliteration": "a(n)dh nisaa dhin bhaan jaraavai ||",
      "translation": "",
      "punjabiViakhya": "ਹਨ੍ਰਹੇਰੀ ਰਾਤ ਬੀਤਣ ਮਗਰੋਂ ਦਿਨੇ ਸੂਰਜ (ਖੇਤੀਆਂ ਨੂੰ) ਸਾੜ ਦਿੰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "अंधि निसा दिन भानु जरावै ॥",
      "sourceLineId": "83570",
      "sourceShabadId": "7896",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਾ ਤੇ ਕ੍ਰਿਸ ਕਹੂੰ ਹੋਨ ਨ ਪਾਵੈ ॥੨॥",
      "transliteration": "taa te kiras kahoo(n) hon na paavai ||2||",
      "translation": "The nights were full of darkness and during the day the sun blazed, therefore nothing grew anywhere.2.",
      "punjabiViakhya": "ਇਸ ਕਰਕੇ ਖੇਤੀ ਕਿਤੇ ਵੀ ਨਹੀਂ ਹੋ ਸਕਦੀ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "ता ते कृस कहूँ होन न पावै ॥२॥",
      "sourceLineId": "83571",
      "sourceShabadId": "7896",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਲੋਗ ਸਭੈ ਇਹ ਤੇ ਅਕੁਲਾਨੇ ॥",
      "transliteration": "log sabhai ieh te akulaane ||",
      "translation": "",
      "punjabiViakhya": "ਫਲਸਰੂਪ ਸਾਰੇ ਲੋਕ ਵਿਆਕੁਲ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "लोग सभै इह ते अकुलाने ॥",
      "sourceLineId": "83572",
      "sourceShabadId": "7896",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭਾਜਿ ਚਲੇ ਜਿਮ ਪਾਤ ਪੁਰਾਨੇ ॥",
      "transliteration": "bhaaj chale jim paat puraane ||",
      "translation": "For this reason all the beings were agitated and they were destroyed like the old leaves.",
      "punjabiViakhya": "(ਇਉਾਂ) ਭੱਜਦੇ ਜਾ ਰਹੇ ਸਨ, ਜਿਸ ਤਰ੍ਰਹਾ ਪੁਰਾਣੇ ਪੱਤਰ (ਹਵਾ ਨਾਲ ਉੱਡ ਜਾਦੇ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "भाजि चले जिम पात पुराने ॥",
      "sourceLineId": "83573",
      "sourceShabadId": "7896",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਭਾਤ ਹੀ ਭਾਤ ਕਰੇ ਹਰਿ ਸੇਵਾ ॥",
      "transliteration": "bhaat hee bhaat kare har sevaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਤਰ੍ਰਹਾ-ਤਰ੍ਰਹਾ ਨਾਲ ਹਰਿ ਦੀ ਸੇਵਾ ਕਰਨ ਲੱਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "भात ही भात करे हरि सेवा ॥",
      "sourceLineId": "83574",
      "sourceShabadId": "7896",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਾ ਤੇ ਪ੍ਰਸੰਨ ਭਏ ਗੁਰਦੇਵਾ ॥੩॥",
      "transliteration": "taa te prasa(n)n bhe gurdhevaa ||3||",
      "translation": "Everyone worshipped, adored and served in various ways and the Supreme Preceptor (i.e. the Lord) was pleased.3.",
      "punjabiViakhya": "ਜਿਸ ਕਰਕੇ ਗੁਰਦੇਵ (ਕਾਲ-ਪੁਰਖ) ਪ੍ਰਸੰਨ ਹੋ ਗਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "ता ते प्रसंन भए गुरदेवा ॥३॥",
      "sourceLineId": "83575",
      "sourceShabadId": "7896",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਾਰਿ ਨ ਸੇਵ ਕਰੈਂ ਨਿਜ ਨਾਥੰ ॥",
      "transliteration": "naar na sev karai(n) nij naatha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀਆਂ ਆਪਣੇ ਪਤੀਆਂ ਦੀ ਸੇਵਾ ਨਹੀਂ ਕਰਦੀਆਂ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "नारि न सेव करैं निज नाथं ॥",
      "sourceLineId": "83576",
      "sourceShabadId": "7896",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਲੀਨੇ ਹੀ ਰੋਸੁ ਫਿਰੈਂ ਜੀਅ ਸਾਥੰ ॥",
      "transliteration": "leene hee ros firai(n) jeea saatha(n) ||",
      "translation": "(This was the situation at that time) that the wife did no service to her husband and ever remained displeased with him.",
      "punjabiViakhya": "(ਸਗੋਂ) ਮਨ ਵਿੱਚ ਗੁੱਸਾ ਲਈ ਫਿਰਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "लीने ही रोसु फिरैं जीअ साथं ॥",
      "sourceLineId": "83577",
      "sourceShabadId": "7896",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਾਮਨਿ ਕਾਮੁ ਕਹੂੰ ਨ ਸੰਤਾਵੈ ॥",
      "transliteration": "kaaman kaam kahoo(n) na sa(n)taavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀਆਂ ਨੂੰ ਕਦੀ ਕਾਮ ਸਤਾਉਾਂਦਾ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "कामनि कामु कहूँ न संतावै ॥",
      "sourceLineId": "83578",
      "sourceShabadId": "7896",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਾਮ ਬਿਨਾ ਕੋਊ ਕਾਮੁ ਨ ਭਾਵੈ ॥੪॥",
      "transliteration": "kaam binaa kouoo kaam na bhaavai ||4||",
      "translation": "The lust did not overpower the wives and in the absence of sexual instinct, all the works for the growth of the world had ended.4.",
      "punjabiViakhya": "(ਇਸ ਲਈ) ਕਾਮ ਭਾਵ ਤੋਂ ਬਿਨਾ ਇਸਤਰੀ ਨੂੰ ਪਤੀ ਨਾਲ ਕੋਈ ਕੰਮ ਹੀ ਨਹੀਂ ਪੈਂਦਾ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "काम बिना कोऊ कामु न भावै ॥४॥",
      "sourceLineId": "83579",
      "sourceShabadId": "7896",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤੋਮਰ ਛੰਦ ॥",
      "transliteration": "tomar chha(n)dh ||",
      "translation": "TOMAR STANZA",
      "punjabiViakhya": "ਤੋਮਰ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "तोमर छंद ॥",
      "sourceLineId": "83580",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪੂਜੇ ਨ ਕੋ ਤ੍ਰੀਯਾ ਨਾਥ ॥",
      "transliteration": "pooje na ko treeyaa naath ||",
      "translation": "",
      "punjabiViakhya": "(ਕੋਈ ਵੀ) ਇਸਤਰੀ ਪਤੀ ਦੀ ਸੇਵਾ ਨਹੀਂ ਕਰਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "पूजे न को त्रीया नाथ ॥",
      "sourceLineId": "83581",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਐਂਠੀ ਫਿਰੈ ਜੀਅ ਸਾਥ ॥",
      "transliteration": "aai(n)Thee firai jeea saath ||",
      "translation": "No wife worshipped her husband and always remained in her pride.",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਆਪ ਵਿੱਚ ਆਕੜੀ ਫਿਰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "ऐंठी फिरै जीअ साथ ॥",
      "sourceLineId": "83582",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੁਖੁ ਵੈ ਨ ਤਿਨ ਕਹੁ ਕਾਮ ॥",
      "transliteration": "dhukh vai na tin kahu kaam ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਉਾਂਕਿ ਕਾਮ ਉਨ੍ਰਹਾ ਨੂੰ ਦੁੱਖ ਨਹੀਂ ਸੀ ਦਿੰਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "दुखु वै न तिन कहु काम ॥",
      "sourceLineId": "83583",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਾ ਤੇ ਨ ਬਿਨਵਤ ਬਾਮ ॥੫॥",
      "transliteration": "taa te na binavat baam ||5||",
      "translation": "She had no grief and did not suffer because of the sexual instinct, therefore, there was no desire for supplication in them.5.",
      "punjabiViakhya": "ਇਸ ਕਰਕੇ ਇਸਤਰੀ (ਪਤੀ ਅੱਗੋਂ) ਲਿਫਦੀ ਨਹੀਂ ਸੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "ता ते न बिनवत बाम ॥५॥",
      "sourceLineId": "83584",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਰ ਹੈ ਨ ਪਤਿ ਕੀ ਸੇਵ ॥",
      "transliteration": "kar hai na pat kee sev ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸਤਰੀਆਂ) ਪਤੀਆਂ ਦੀ ਸੇਵਾ ਨਹੀਂ ਕਰਦੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "कर है न पति की सेव ॥",
      "sourceLineId": "83585",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪੂਜੈ ਨ ਗੁਰ ਗੁਰਦੇਵ ॥",
      "transliteration": "poojai na gur gurdhev ||",
      "translation": "Neither she served her husband, nor worshipped and abored the preceptors.",
      "punjabiViakhya": "ਅਤੇ ਨਾ ਹੀ (ਕਿਸੇ) ਵੱਡੇ ਤੋਂ ਵੱਡੇ ਦੇਵਤੇ ਦੀ ਪੂਜਾ ਕਰਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "पूजै न गुर गुरदेव ॥",
      "sourceLineId": "83586",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਧਰ ਹੈਂ ਨ ਹਰਿ ਕੋ ਧਯਾਨ ॥",
      "transliteration": "dhar hai(n) na har ko dhayaan ||",
      "translation": "",
      "punjabiViakhya": "ਹਰਿ ਦਾ ਧਿਆਨ ਵੀ ਨਹੀਂ ਕਰਦੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "धर हैं न हरि को धयान ॥",
      "sourceLineId": "83587",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਰਿ ਹੈਂ ਨ ਨਿਤ ਇਸਨਾਨ ॥੬॥",
      "transliteration": "kar hai(n) na nit isanaan ||6||",
      "translation": "Neither she meditated on Lord-God nor she ever took bath.6.",
      "punjabiViakhya": "ਅਤੇ ਨਾ ਹੀ ਨਿੱਤ ਇਸ਼ਨਾਨ ਕਰਦੀਆਂ ਸਨ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "करि हैं न नित इसनान ॥६॥",
      "sourceLineId": "83588",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਬ ਕਾਲ ਪੁਰਖ ਬੁਲਾਇ ॥",
      "transliteration": "tab kaal purakh bulai ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ 'ਕਾਲ-ਪੁਰਖ' ਨੇ (ਵਿਸ਼ਣੂ ਨੂੰ) ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "तब काल पुरख बुलाइ ॥",
      "sourceLineId": "83589",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਿਸਨੈ ਕਹਯੋ ਸਮਝਾਇ ॥",
      "transliteration": "bisanai kahayo samajhai ||",
      "translation": "Then the Immanent Lord called Vishnu and giving instruction to him, told, him that,",
      "punjabiViakhya": "ਅਤੇ ਵਿਸ਼ਣੂ ਨੂੰ ਸਮਝਾ ਕੇ ਕਿਹਾ-",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "बिसनै कहयो समझाइ ॥",
      "sourceLineId": "83590",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਸਿ ਕੋ ਧਰਿਹੁ ਅਵਤਾਰ ॥",
      "transliteration": "sas ko dharih avataar ||",
      "translation": "",
      "punjabiViakhya": "ਜਗਤ ਵਿੱਚ ਜਾ ਕੇ 'ਚੰਦਰ' ਅਵਤਾਰ ਧਾਰਨ ਕਰੋ,",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "ससि को धरिहु अवतार ॥",
      "sourceLineId": "83591",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਹੀ ਆਨ ਬਾਤ ਬਿਚਾਰ ॥੭॥",
      "transliteration": "nahee aan baat bichaar ||7||",
      "translation": "Without taking any other thing into consideration, he should manifest himself as Chandra incarnation.7.",
      "punjabiViakhya": "(ਇਸ ਤੋਂ ਬਿਨਾ) ਹੋਰ ਕਿਸੇ ਗੱਲ ਦਾ ਵਿਚਾਰ ਨਾ ਕਰੋ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "नही आन बात बिचार ॥७॥",
      "sourceLineId": "83592",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਬ ਬਿਸਨ ਸੀਸ ਨਿਵਾਇ ॥",
      "transliteration": "tab bisan sees nivai ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਵਿਸ਼ਣੂ ਨੇ ਸਿਰ ਨਿਵਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "तब बिसन सीस निवाइ ॥",
      "sourceLineId": "83593",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਰਿ ਜੋਰਿ ਕਹੀ ਬਨਾਇ ॥",
      "transliteration": "kar jor kahee banai ||",
      "translation": "Then Vishnu bowing his head said with folded hands,",
      "punjabiViakhya": "ਅਤੇ ਹੱਥ ਜੋੜ ਕੇ ਕਿਹਾ-(ਮੈਂ ਆਪ ਦੀ ਆਗਿਆ ਨਾਲ)",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "करि जोरि कही बनाइ ॥",
      "sourceLineId": "83594",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਧਰਿਹੋਂ ਦਿਨਾਤ ਵਤਾਰ ॥",
      "transliteration": "dhariho(n) dhinaat vataar ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਦਰ (ਦਿਨਾਤ) ਅਵਤਾਰ ਧਰਦਾ ਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "धरिहों दिनात वतार ॥",
      "sourceLineId": "83595",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਿਤ ਹੋਇ ਜਗਤ ਕੁਮਾਰ ॥੮॥",
      "transliteration": "jit hoi jagat kumaar ||8||",
      "translation": "“I shall assume the form of Chandra incarnation, so that the beauty may prosper in the world.8.",
      "punjabiViakhya": "ਜਿਸ ਕਰਕੇ ਜਗਤ ਵਿੱਚ ਪੁਰਖ ਦੀ ਜਿੱਤ ਹੋ ਸਕੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "जित होइ जगत कुमार ॥८॥",
      "sourceLineId": "83596",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਬ ਮਹਾ ਤੇਜ ਮੁਰਾਰ ॥",
      "transliteration": "tab mahaa tej muraar ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਵੱਡੇ ਤੇਜ਼ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "तब महा तेज मुरार ॥",
      "sourceLineId": "83597",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਧਰਿਯੋ ਸੁ ਚੰਦ੍ਰ ਅਵਤਾਰ ॥",
      "transliteration": "dhariyo su cha(n)dhr avataar ||",
      "translation": "Then the extremely glorious Vishnu manifested himself as Chandra (incarnation),",
      "punjabiViakhya": "ਵਿਸ਼ਣੂ ਨੇ ਚੰਦਰ ਅਵਤਾਰ ਧਾਰਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "धरियो सु चंद्र अवतार ॥",
      "sourceLineId": "83598",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਨ ਕੈ ਮਦਨ ਕੋ ਬਾਨ ॥",
      "transliteration": "tan kai madhan ko baan ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਕਾਮ ਦਾ ਤੀਰ ਖਿੱਚ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "तन कै मदन को बान ॥",
      "sourceLineId": "83599",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਾਰਿਯੋ ਤ੍ਰੀਯਨ ਕਹ ਤਾਨ ॥੯॥",
      "transliteration": "maariyo treeyan keh taan ||9||",
      "translation": "And he shot continuously the arrows of the god of love towards women.9.",
      "punjabiViakhya": "ਇਸਤਰੀਆਂ ਨੂੰ ਕਸ ਮਾਰਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "मारियो त्रीयन कह तान ॥९॥",
      "sourceLineId": "83600",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਾ ਤੇ ਭਈ ਤ੍ਰੀਯ ਦੀਨ ॥",
      "transliteration": "taa te bhiee treey dheen ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਕਰਕੇ ਇਸਤਰੀਆਂ ਨਿਮਰਤਾਵਾਨ ਹੋ ਗਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "ता ते भई त्रीय दीन ॥",
      "sourceLineId": "83601",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0198_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਭ ਗਰਬ ਹੁਐ ਗਯੋ ਛੀਨ ॥",
      "transliteration": "sabh garab huaai gayo chheen ||",
      "translation": "Because of this the women became modest and all their pride was shattered.",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਦਾ ਸਾਰਾ ਹੰਕਾਰ ਨਸ਼ਟ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": "सभ गरब हुऐ गयो छीन ॥",
      "sourceLineId": "83602",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
