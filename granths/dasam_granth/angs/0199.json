{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 199,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0199_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਲਾਗੀ ਕਰਨ ਪਤਿ ਸੇਵ ॥",
      "transliteration": "laagee karan pat sev ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਪਤੀ ਦੀ ਸੇਵਾ ਕਰਨ ਲੱਗੀਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "लागी करन पति सेव ॥",
      "sourceLineId": "83603",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਯਾ ਤੇ ਪ੍ਰਸੰਨਿ ਭਏ ਦੇਵ ॥੧੦॥",
      "transliteration": "yaa te prasa(n)n bhe dhev ||10||",
      "translation": "They again began to perform service to their husbands and by this all the gods were pleased.10.",
      "punjabiViakhya": "ਜਿਸ ਕਰਕੇ ਦੇਵ (ਕਾਲ ਪੁਰਖ) ਪ੍ਰਸੰਨ ਹੋਏ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "या ते प्रसंनि भए देव ॥१०॥",
      "sourceLineId": "83604",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਹੁ ਕ੍ਰਿਸਾ ਲਾਗੀ ਹੋਨ ॥",
      "transliteration": "bahu kirasaa laagee hon ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਦਰਮਾ ਦੀ ਚਾਨਣੀ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "बहु कृसा लागी होन ॥",
      "sourceLineId": "83605",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਲਖ ਚੰਦ੍ਰਮਾ ਕੀ ਜੌਨ ॥",
      "transliteration": "lakh cha(n)dhramaa kee jauan ||",
      "translation": "Seeing Chandra, people began to do farming to a large extent.",
      "punjabiViakhya": "ਵੇਖ ਕੇ ਬਹੁਤ ਖੇਤੀ ਹੋਣ ਲੱਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "लख चंद्रमा की जौन ॥",
      "sourceLineId": "83606",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਭ ਭਏ ਸਿਧ ਬਿਚਾਰ ॥",
      "transliteration": "sabh bhe sidh bichaar ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਵਿਚਾਰ ਪੂਰੇ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "सभ भए सिध बिचार ॥",
      "sourceLineId": "83607",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਇਮ ਭਯੋ ਚੰਦ੍ਰ ਅਵਤਾਰ ॥੧੧॥",
      "transliteration": "eim bhayo cha(n)dhr avataar ||11||",
      "translation": "All the thoughts-out works were accomplished, in this manner, Chandra incarnation came into being.11.",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਚੰਦਰਮਾ ਦਾ ਅਵਤਾਰ ਹੋਇਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "इम भयो चंद्र अवतार ॥११॥",
      "sourceLineId": "83608",
      "sourceShabadId": "7897",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI.",
      "punjabiViakhya": "ਚੌਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "83609",
      "sourceShabadId": "7898",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਇਮ ਹਰਿ ਧਰਾ ਚੰਦ੍ਰ ਅਵਤਾਰਾ ॥",
      "transliteration": "eim har dharaa cha(n)dhr avataaraa ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਸ਼ਣੂ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਨਾਲ ਚੰਦਰਮਾ ਅਵਤਾਰ ਧਾਰਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "इम हरि धरा चंद्र अवतारा ॥",
      "sourceLineId": "83610",
      "sourceShabadId": "7898",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਢਿਯੋ ਗਰਬ ਲਹਿ ਰੂਪ ਅਪਾਰਾ ॥",
      "transliteration": "baddiyo garab leh roop apaaraa ||",
      "translation": "In this way Vishnu manifested himself as Chandra incarnation, but Chandra also became egoistic about his own beauty",
      "punjabiViakhya": "(ਪਰ ਉਸ ਦਾ ਆਪਣਾ) ਅਪਾਰ ਰੂਪ ਵੇਖ ਕੇ ਹੰਕਾਰ ਵਧ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "बढियो गरब लहि रूप अपारा ॥",
      "sourceLineId": "83611",
      "sourceShabadId": "7898",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਆਨ ਕਿਸੂ ਕਹੁ ਚਿਤ ਨ ਲਿਆਯੋ ॥",
      "transliteration": "aan kisoo kahu chit na liaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਹੋਰ ਕਿਸੇ ਨੂੰ ਚਿੱਤ ਵਿੱਚ ਨਾ ਲਿਆਉਾਂਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "आन किसू कहु चित न लिआयो ॥",
      "sourceLineId": "83612",
      "sourceShabadId": "7898",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਾ ਤੇ ਤਾਹਿ ਕਲੰਕ ਲਗਾਯੋ ॥੧੨॥",
      "transliteration": "taa te taeh kala(n)k lagaayo ||12||",
      "translation": "He also abandoned the meditation of any other, therefore he was also blemished.12.",
      "punjabiViakhya": "ਇਸੇ ਕਰਕੇ ਉਸ ਨੂੰ ਕਲੰਕ ਲੱਗ ਗਿਆ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "ता ते ताहि कलंक लगायो ॥१२॥",
      "sourceLineId": "83613",
      "sourceShabadId": "7898",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਜਤ ਭਯੋ ਅੰਬਰ ਕੀ ਦਾਰਾ ॥",
      "transliteration": "bhajat bhayo a(n)bar kee dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਹਸਪਤੀ (ਅੰਬਰ) ਦੀ ਇਸਤਰੀ ਨਾਲ (ਚੰਦ੍ਰਮਾ ਨੇ) ਭੋਗ ਕੀਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "भजत भयो अंबर की दारा ॥",
      "sourceLineId": "83614",
      "sourceShabadId": "7898",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਾ ਤੇ ਕੀਯ ਮੁਨ ਰੋਸ ਅਪਾਰਾ ॥",
      "transliteration": "taa te keey mun ros apaaraa ||",
      "translation": "He was engrossed with the wife of the sage (Gautam), which made th sage highly infuriated in his mind",
      "punjabiViakhya": "ਇਸ ਕਰਕੇ ਮੁਨੀ ਨੇ ਬਹੁਤ ਗੁੱਸਾ ਕੀਤਾ ਅਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "ता ते कीय मुन रोस अपारा ॥",
      "sourceLineId": "83615",
      "sourceShabadId": "7898",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਿਸਨਾਰਜੁਨ ਮ੍ਰਿਗ ਚਰਮ ਚਲਾਯੋ ॥",
      "transliteration": "kisanaarajun mirag charam chalaayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲੇ (ਕ੍ਰਿਸ਼ਨਾਰਜੁਨ) ਹਿਰਨ ਦੀ ਖਲ (ਚੰਦਰਮਾ ਨੂੰ) ਮਾਰੀ,",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "किसनारजुन मृग चरम चलायो ॥",
      "sourceLineId": "83616",
      "sourceShabadId": "7898",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਿਹ ਕਰਿ ਤਾਹਿ ਕਲੰਕ ਲਗਾਯੋ ॥੧੩॥",
      "transliteration": "teh kar taeh kala(n)k lagaayo ||13||",
      "translation": "The sage struck him with his deer-skin, which created a mark on his body and he was thus blemished.13.",
      "punjabiViakhya": "ਜਿਸ ਕਰਕੇ ਚੰਦਰਮਾ ਨੂੰ ਕਲੰਕ ਲੱਗ ਗਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "तिह करि ताहि कलंक लगायो ॥१३॥",
      "sourceLineId": "83617",
      "sourceShabadId": "7898",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸ੍ਰਾਪ ਲਗਯੋ ਤਾ ਕੋ ਮੁਨਿ ਸੰਦਾ ॥",
      "transliteration": "sraap lagayo taa ko mun sa(n)dhaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੂਜਾ ਗੌਤਮ ਮੁਨੀ ਦਾ ਵੀ ਉਸ ਨੂੰ ਸਰਾਪ ਲੱਗਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "स्राप लगयो ता को मुनि संदा ॥",
      "sourceLineId": "83618",
      "sourceShabadId": "7898",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਘਟਤ ਬਢਤ ਤਾ ਦਿਨ ਤੇ ਚੰਦਾ ॥",
      "transliteration": "ghaTat baddat taa dhin te cha(n)dhaa ||",
      "translation": "With the curse of the sage he keeps on decreasing and increasing",
      "punjabiViakhya": "ਉਸ ਦਿਨ ਤੋਂ ਚੰਦਰਮਾ ਵਧਦਾ ਘਟਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "घटत बढत ता दिन ते चंदा ॥",
      "sourceLineId": "83619",
      "sourceShabadId": "7898",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਲਜਿਤ ਅਧਿਕ ਹਿਰਦੇ ਮੋ ਭਯੋ ॥",
      "transliteration": "lajit adhik hiradhe mo bhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਿਨ ਤੋਂ) ਹਿਰਦੇ ਵਿੱਚ (ਚੰਦਰਮਾ) ਬਹੁਤ ਸ਼ਰਮਿੰਦਾ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "लजित अधिक हिरदे मो भयो ॥",
      "sourceLineId": "83620",
      "sourceShabadId": "7898",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗਰਬ ਅਖਰਬ ਦੂਰ ਹੁਐ ਗਯੋ ॥੧੪॥",
      "transliteration": "garab akharab dhoor huaai gayo ||14||",
      "translation": "Because of this event, he felt extremely ashamed and his pride was extremely shattered.14.",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਦੇ ਮਨ ਵਿਚੋਂ) ਵੱਡਾ ਹੰਕਾਰ ਦੁਰ ਹੋ ਗਿਆ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "गरब अखरब दूर हुऐ गयो ॥१४॥",
      "sourceLineId": "83621",
      "sourceShabadId": "7898",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਪਸਾ ਕਰੀ ਬਹੁਰੁ ਤਿਹ ਕਾਲਾ ॥",
      "transliteration": "tapasaa karee bahur teh kaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ (ਚੰਦਰਮਾ ਨੇ) ਬਹੁਤ ਚਿਰ ਤਪਸਿਆ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "तपसा करी बहुरु तिह काला ॥",
      "sourceLineId": "83622",
      "sourceShabadId": "7898",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਾਲ ਪੁਰਖ ਪੁਨ ਭਯੋ ਦਿਆਲਾ ॥",
      "transliteration": "kaal purakh pun bhayo dhiaalaa ||",
      "translation": "He then performed austerities for a long time, by which the Immanent Lord became merciful towards him",
      "punjabiViakhya": "ਫਿਰ 'ਕਾਲ-ਪੁਰਖ' (ਉਸ ਉੱਤੇ) ਕ੍ਰਿਪਾਲੂ ਹੋਏ।",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "काल पुरख पुन भयो दिआला ॥",
      "sourceLineId": "83623",
      "sourceShabadId": "7898",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਛਈ ਰੋਗ ਤਿਹ ਸਕਲ ਬਿਨਾਸਾ ॥",
      "transliteration": "chhiee rog teh sakal binaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਖਈ ਰੋਗ (ਤਪੇਦਿਕ) ਨਸ਼ਟ ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "छई रोग तिह सकल बिनासा ॥",
      "sourceLineId": "83624",
      "sourceShabadId": "7898",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭਯੋ ਸੂਰ ਤੇ ਊਚ ਨਿਵਾਸਾ ॥੧੫॥",
      "transliteration": "bhayo soor te uooch nivaasaa ||15||",
      "translation": "His destructive ailment decayed and by the Grace of the Supreme Immanent Lord, he attained a higher status than the Sun.15.",
      "punjabiViakhya": "ਅਤੇ ਚੰਦਰਮਾ ਨੂੰ ਸੂਰਜ ਨਾਲੋਂ ਵੀ ਉੱਚਾ ਸਥਾਨ ਪ੍ਰਾਪਤ ਹੋਇਆ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "भयो सूर ते ऊच निवासा ॥१५॥",
      "sourceLineId": "83625",
      "sourceShabadId": "7898",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0199_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਇਤਿ ਚੰਦ੍ਰ ਅਵਤਾਰ ਉਨੀਸਵੋਂ ॥੧੯॥ ਸੁਭਮ ਸਤੁ ॥",
      "transliteration": "eit cha(n)dhr avataar uneesavo(n) ||19|| subham sat ||",
      "translation": "End of the description of the Nineteenth Incarnation i.e. CHANDRA. 19.",
      "punjabiViakhya": "ਇਥੇ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ ਸ੍ਰੀ ਚੰਦ੍ਰ ਅਵਤਾਰ ਉਨ੍ਰਹੀਵੇਾਂ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": "इति चंद्र अवतार उनीसवों ॥१९॥ सुभम सतु ॥",
      "sourceLineId": "83626",
