{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 207,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0207_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਘੋਰਿ ਘੋਰਿ ਦਸੋ ਦਿਸਾ ਨਹਿ ਸੂਰਬੀਰ ਪ੍ਰਮਾਥ ॥",
      "transliteration": "ghor ghor dhaso dhisaa neh soorabeer pramaath ||",
      "translation": "",
      "punjabiViakhya": "ਦਸਾ ਦਿਸ਼ਾਵਾ ਵਿੱਚ ਸੂਰਵੀਰਾ ਨੇ ਘੇਰਾ ਘੱਤਿਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "घोरि घोरि दसो दिसा नहि सूरबीर प्रमाथ ॥",
      "sourceLineId": "83915",
      "sourceShabadId": "7909",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਆਇ ਕੈ ਜੂਝੇ ਸਬੈ ਰਣ ਰਾਮ ਏਕਲ ਸਾਥ ॥੬੮॥",
      "transliteration": "aai kai joojhe sabai ran raam ekal saath ||68||",
      "translation": "From all the ten directions, the demon warriors rushed forth for fighting only with Ram.68.",
      "punjabiViakhya": "ਇਕੱਲੇ ਰਾਮ ਨਾਲ ਆ ਕੇ ਸਾਰੇ ਸੂਰਮੇ ਰਣ-ਭੂਮੀ ਵਿੱਚ ਲੜ ਰਹੇ ਸਨ ॥੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "आइ कै जूझे सबै रण राम एकल साथ ॥६८॥",
      "sourceLineId": "83916",
      "sourceShabadId": "7909",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "83917",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਣੰ ਪੇਖਿ ਰਾਮੰ ॥",
      "transliteration": "rana(n) pekh raama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿੱਚ ਧਰਮ ਸਥਾਨ ਦੇ ਝੰਡੇ ਵਾਗ",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "रणं पेखि रामं ॥",
      "sourceLineId": "83918",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਧੁਜੰ ਧਰਮ ਧਾਮੰ ॥",
      "transliteration": "dhuja(n) dharam dhaama(n) ||",
      "translation": "Seeing Ram, the Dharma-incarnate, in the battlefield and uttering various shouts from their mouth,",
      "punjabiViakhya": "ਰਾਮ (ਅਡੋਲ) ਦਿਸ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "धुजं धरम धामं ॥",
      "sourceLineId": "83919",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚਹੂੰ ਓਰ ਢੂਕੇ ॥",
      "transliteration": "chahoo(n) or ddooke ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ (ਰਾਖਸ਼ ਨੇੜੇ) ਢੁੱਕੇ ਹੋਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "चहूँ ओर ढूके ॥",
      "sourceLineId": "83920",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮੁਖੰ ਮਾਰ ਕੂਕੇ ॥੬੯॥",
      "transliteration": "mukha(n) maar kooke ||69||",
      "translation": "The demons rushed forth all the four directions and gathered together.69.",
      "punjabiViakhya": "ਅਤੇ ਮੂੰਹ ਤੋਂ ਮਾਰੋ ਮਾਰੋ ਬੋਲ ਰਹੇ ਸਨ ॥੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "मुखं मार कूके ॥६९॥",
      "sourceLineId": "83921",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਜੇ ਘੋਰ ਬਾਜੇ ॥",
      "transliteration": "baje ghor baaje ||",
      "translation": "",
      "punjabiViakhya": "ਘੋਰ ਵਾਜੇ ਵੱਜਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "बजे घोर बाजे ॥",
      "sourceLineId": "83922",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਧੁਣੰ ਮੇਘ ਲਾਜੇ ॥",
      "transliteration": "dhuna(n) megh laaje ||",
      "translation": "The musical instruments resounded violently and hearing their sounds, he clouds felt shy.",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਦੀ) ਆਵਾਜ਼ ਅੱਗੇ ਬੱਦਲ (ਦੀ ਧੁਨੀ) ਲੱਜਾ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "धुणं मेघ लाजे ॥",
      "sourceLineId": "83923",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਝੰਡਾ ਗੱਡ ਗਾੜੇ ॥",
      "transliteration": "jha(n)ddaa ga'dd gaaRe ||",
      "translation": "",
      "punjabiViakhya": "ਪੱਕੇ ਝੰਡੇ ਗਡ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "झंडा गड्ड गाड़े ॥",
      "sourceLineId": "83924",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮੰਡੇ ਬੈਰ ਬਾੜੇ ॥੭੦॥",
      "transliteration": "ma(n)dde bair baaRe ||70||",
      "translation": "Fixing their banners on the earth  the demons, filled with enmity began to wage war.70.",
      "punjabiViakhya": "ਵੈਰ ਵਧਾ ਕੇ ਲੜ ਰਹੇ ਸਨ ॥੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "मंडे बैर बाड़े ॥७०॥",
      "sourceLineId": "83925",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕੜੱਕੇ ਕਮਾਣੰ ॥",
      "transliteration": "kaRa'ke kamaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਮਾਨਾ ਕੜਕਦੀਆਂ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "कड़क्के कमाणं ॥",
      "sourceLineId": "83926",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਝੜੱਕੇ ਕ੍ਰਿਪਾਣੰ ॥",
      "transliteration": "jhaRa'ke kirapaana(n) ||",
      "translation": "The bows clattered and the swords struck.",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਝਟਕਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "झड़क्के कृपाणं ॥",
      "sourceLineId": "83927",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਢਲਾ ਢੁੱਕ ਢਾਲੈ ॥",
      "transliteration": "ddalaa ddu'k ddaalai ||",
      "translation": "",
      "punjabiViakhya": "ਢਾਲਾ ਤੋਂ ਢੁੱਕ-ਢੁੱਕ ਕੇ ਸ਼ਬਦ ਹੁੰਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "ढला ढुक्क ढालै ॥",
      "sourceLineId": "83928",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚਲੀ ਪੀਤ ਪਾਲੈ ॥੭੧॥",
      "transliteration": "chalee peet paalai ||71||",
      "translation": "There was great knocking on the shields and the swords falling on them performed the rite of love.71.",
      "punjabiViakhya": "ਅਤੇ ਤਲਵਾਰਾ ਚਲਦੀਆਂ ਸਨ ॥੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "चली पीत पालै ॥७१॥",
      "sourceLineId": "83929",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰਣੰ ਰੰਗ ਰੱਤੇ ॥",
      "transliteration": "rana(n) ra(n)g ra'te ||",
      "translation": "",
      "punjabiViakhya": "(ਯੋਧੇ) ਰਣ-ਰੰਗ ਵਿੱਚ (ਇਉਾਂ) ਰਤੇ ਹੋਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "रणं रंग रत्ते ॥",
      "sourceLineId": "83930",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਨੋ ਮੱਲ ਮੱਤੇ ॥",
      "transliteration": "mano ma'l ma'te ||",
      "translation": "All the warriors were absorbed in the war so much like the werestlers in th wrestling arena.",
      "punjabiViakhya": "ਮਾਨੋ ਮਸਤ ਮਲ ਫਿਰਦੇ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "मनो मल्ल मत्ते ॥",
      "sourceLineId": "83931",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਰੰ ਧਾਰ ਬਰਖੇ ॥",
      "transliteration": "sara(n) dhaar barakhe ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰਾ ਦਾ ਮੀਂਹ ਵਸਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "सरं धार बरखे ॥",
      "sourceLineId": "83932",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਹਿਖੁਆਸ ਕਰਖੈ ॥੭੨॥",
      "transliteration": "mahikhuaas karakhai ||72||",
      "translation": "The arrows were showered and there was the crackling of the bows.72.",
      "punjabiViakhya": "ਵੱਡਿਆਂ ਧਨੁਸ਼ਾ ਨੂੰ ਖਿੱਚਿਆ ਜਾ ਰਿਹਾ ਸੀ ॥੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "महिखुआस करखै ॥७२॥",
      "sourceLineId": "83933",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਰੀ ਬਾਨ ਬਰਖਾ ॥",
      "transliteration": "karee baan barakhaa ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰਾ ਦੀ ਬਰਖਾ ਕਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "करी बान बरखा ॥",
      "sourceLineId": "83934",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੁਣੇ ਜੀਤ ਕਰਖਾ ॥",
      "transliteration": "sune jeet karakhaa ||",
      "translation": "Wishing for their victory, the demons showered their arrows.",
      "punjabiViakhya": "ਜਿੱਤ ਦੇ ਗੀਤ ਸੁਣਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "सुणे जीत करखा ॥",
      "sourceLineId": "83935",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੁਬਾਹੰ ਮਰੀਚੰ ॥",
      "transliteration": "subaaha(n) mareecha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਬਾਹੂ ਅਤੇ ਮਰੀਚ ਦੈਂਤ ਮੌਤ ਦੀ ਇੱਛਾ ਕਰਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "सुबाहं मरीचं ॥",
      "sourceLineId": "83936",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚਲੇ ਬਾਛ ਮੀਚੰ ॥੭੩॥",
      "transliteration": "chale baachh meecha(n) ||73||",
      "translation": "Sabahu and Marich, knocking their teeth in fury, marched forward.73.",
      "punjabiViakhya": "(ਰਾਮ ਦੇ) ਸਾਹਮਣੇ ਆ ਗਏ ॥੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "चले बाछ मीचं ॥७३॥",
      "sourceLineId": "83937",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਇਕੈ ਬਾਰ ਟੂਟੇ ॥",
      "transliteration": "eikai baar TooTe ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਦੈਂਤ ਇਕੋ ਵਾਰ (ਇਸ ਤਰ੍ਰਹਾ) ਟੁੱਟ ਕੇ ਆ ਪਏ,",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "इकै बार टूटे ॥",
      "sourceLineId": "83938",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਨੋ ਬਾਜ ਛੂਟੇ ॥",
      "transliteration": "mano baaj chhooTe ||",
      "translation": "Both of them together pounced upon like a falcon, and,",
      "punjabiViakhya": "ਮਾਨੋ ਬਾਜ ਛੁੱਟ ਕੇ ਆਏ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "मनो बाज छूटे ॥",
      "sourceLineId": "83939",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਲਯੋ ਘੋਰਿ ਰਾਮੰ ॥",
      "transliteration": "layo ghor raama(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਇਉਾਂ) ਰਾਮ ਨੂੰ ਘੇਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "लयो घोरि रामं ॥",
      "sourceLineId": "83940",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਸੰ ਜੇਮ ਕਾਮੰ ॥੭੪॥",
      "transliteration": "sasa(n) jem kaama(n) ||74||",
      "translation": "They surrounded ram like the Cupid (Kamdev), surrounding the moon.74.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਚੰਦ੍ਰਮਾ ਨੂੰ ਕਾਮਦੇਵ ਨੂੰ ਘੇਰ ਲਿਆ ਸੀ ॥੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "ससं जेम कामं ॥७४॥",
      "sourceLineId": "83941",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਘਿਰਯੋ ਦੈਤ ਸੈਣੰ ॥",
      "transliteration": "ghirayo dhait saina(n) ||",
      "translation": "",
      "punjabiViakhya": "ਇਉਾਂ ਦੈਂਤ ਦੀ ਸੈਨਾ ਨੇ (ਰਾਮ ਨੂੰ) ਘੇਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "घिरयो दैत सैणं ॥",
      "sourceLineId": "83942",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਿਮੰ ਰੁਦ੍ਰ ਮੈਣੰ ॥",
      "transliteration": "jima(n) rudhr maina(n) ||",
      "translation": "Ram was surrounded by the forces of demons like Shiva by the forces of Cupid (Kamdev).",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਰੁਦ੍ਰ ਨੂੰ ਕਾਮ ਨੇ ਘੇਰਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "जिमं रुद्र मैणं ॥",
      "sourceLineId": "83943",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰੁਕੇ ਰਾਮ ਜੰਗੰ ॥",
      "transliteration": "ruke raam ja(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਜੀ ਜੰਗ ਵਿੱਚ ਇਉਾਂ ਡੱਟੇ ਹੋਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "रुके राम जंगं ॥",
      "sourceLineId": "83944",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮਨੋ ਸਿੰਧ ਗੰਗੰ ॥੭੫॥",
      "transliteration": "mano si(n)dh ga(n)ga(n) ||75||",
      "translation": "Ram tarried there for war like Ganges on meeting the ocean.75.",
      "punjabiViakhya": "ਮਾਨੋ ਸਮੁੰਦਰ ਵਿੱਚ ਗੰਗਾ ਮਿਲੀ ਹੁੰਦੀ ਹੈ ॥੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "मनो सिंध गंगं ॥७५॥",
      "sourceLineId": "83945",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਰਣੰ ਰਾਮ ਬੱਜੇ ॥",
      "transliteration": "rana(n) raam ba'je ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ ਵਿੱਚ ਰਾਮ ਲਲਕਾਰਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "रणं राम बज्जे ॥",
      "sourceLineId": "83946",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਧੁਣੰ ਮੇਘ ਲੱਜੇ ॥",
      "transliteration": "dhuna(n) megh la'je ||",
      "translation": "Ram shouted so loudly in the war that the clouds felt shy",
      "punjabiViakhya": "(ਜਿਸ ਅੱਗੇ) ਬੱਦਲਾ ਦੀ ਧੁਨ ਸਰਮਸਾਰ ਹੁੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "धुणं मेघ लज्जे ॥",
      "sourceLineId": "83947",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰੁਲੇ ਤੱਛ ਮੁੱਛੰ ॥",
      "transliteration": "rule ta'chh mu'chha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਢੇ ਟੁੱਕੇ (ਸੂਰਮੇ) ਰੁਲ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "रुले तच्छ मुच्छं ॥",
      "sourceLineId": "83948",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗਿਰੇ ਸੂਰ ਸ੍ਵੱਛੰ ॥੭੬॥",
      "transliteration": "gire soor savai'chha(n) ||76||",
      "translation": "The warriors rolled in dust and mighty heroes fell on the earth.76.",
      "punjabiViakhya": "ਸ੍ਰੇਸ਼ਠ ਸੂਰਮੇ ਡਿੱਗੇ ਹੋਏ ਸਨ ॥੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "गिरे सूर स्वच्छं ॥७६॥",
      "sourceLineId": "83949",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚਲੈ ਐਂਠ ਮੁੱਛੈਂ ॥",
      "transliteration": "chalai aai(n)Th mu'chhai(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਖਸ਼) ਮੁੱਛਾ ਨੂੰ ਵੱਟ ਚੜ੍ਰਹਾ ਕੇ ਚਲੇ ਆਉਾਂਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "चलै ऐंठ मुच्छैं ॥",
      "sourceLineId": "83950",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਹਾ ਰਾਮ ਪੁੱਛੈਂ ॥",
      "transliteration": "kahaa raam pu'chhai(n) ||",
      "translation": "Subadhu and Marich began to search for Ram, while twisting their whiskers,",
      "punjabiViakhya": "ਪੁੱਛਦੇ ਸਨ-ਰਾਮ ਕਿੱਥੇ ਹੈ?",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "कहा राम पुच्छैं ॥",
      "sourceLineId": "83951",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਬੈ ਹਾਥਿ ਲਾਗੇ ॥",
      "transliteration": "abai haath laage ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਹੁਣ (ਸਾਡੇ) ਹੱਥ ਲੱਗ ਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "अबै हाथि लागे ॥",
      "sourceLineId": "83952",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਹਾ ਜਾਹੁ ਭਾਗੈ ॥੭੭॥",
      "transliteration": "kahaa jaahu bhaagai ||77||",
      "translation": "And said, “Where will he go and save himself, we will catch him just now.”77.",
      "punjabiViakhya": "ਤਾ ਫਿਰ ਕਿੱਥੇ ਭੱਜ ਕੇ ਜਾਏਗਾ ॥੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "कहा जाहु भागै ॥७७॥",
      "sourceLineId": "83953",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰਿਪੰ ਪੇਖ ਰਾਮੰ ॥",
      "transliteration": "ripa(n) pekh raama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਨੇ ਵੈਰੀ ਨੂੰ ਵੇਖ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "रिपं पेख रामं ॥",
      "sourceLineId": "83954",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਠਿਯੋ ਧਰਮ ਧਾਮੰ ॥",
      "transliteration": "haThiyo dharam dhaama(n) ||",
      "translation": "Seeing the enemies Ram became persistent and serious,",
      "punjabiViakhya": "ਅਤੇ ਧਰਮ-ਧਾਮ ਸਰੂਪ (ਰਾਮ) ਡੱਟ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "हठियो धरम धामं ॥",
      "sourceLineId": "83955",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਰੈ ਨੈਣ ਰਾਤੰ ॥",
      "transliteration": "karai nain raata(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਰੋਹ ਨਾਲ) ਨੈਣ ਲਾਲ ਕਰ ਲਏ,",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "करै नैण रातं ॥",
      "sourceLineId": "83956",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਧਨੁਰ ਬੇਦ ਗਯਾਤੰ ॥੭੮॥",
      "transliteration": "dhanur bedh gayaata(n) ||78||",
      "translation": "And the eyes of that knower of the science of archery, reddened.78.",
      "punjabiViakhya": "ਉਹ ਧਨੁਰ ਵੇਦ ਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਜਾਣਦੇ ਸਨ ॥੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "धनुर बेद गयातं ॥७८॥",
      "sourceLineId": "83957",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਧਨੰ ਉਗ੍ਰ ਕਰਖਿਯੋ ॥",
      "transliteration": "dhana(n) ugr karakhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਨੇ ਕਠੋਰ ਧਨੁਸ਼ ਨੂੰ ਖਿੱਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "धनं उग्र करखियो ॥",
      "sourceLineId": "83958",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਰੰਧਾਰ ਬਰਖਿਯੋ ॥",
      "transliteration": "sara(n)dhaar barakhiyo ||",
      "translation": "The bow of Ram raised a terrible sound and showered a volley of arrows.",
      "punjabiViakhya": "ਅਤੇ ਤੀਰਾ ਦੀ ਬਰਖਾ ਸ਼ੁਰੂ ਕਰ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "सरंधार बरखियो ॥",
      "sourceLineId": "83959",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਣੀ ਸੱਤ੍ਰ ਸੈਣੰ ॥",
      "transliteration": "hanee sa'tr saina(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵੈਰੀ ਸੈਨਾ ਮਾਰ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "हणी सत्त्र सैणं ॥",
      "sourceLineId": "83960",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਸੇ ਦੇਵ ਗੈਣੰ ॥੭੯॥",
      "transliteration": "hase dhev gaina(n) ||79||",
      "translation": "The armies of the enemy were being destroyed, seeing which the gods smiled in heaven.79.",
      "punjabiViakhya": "(ਇਹ ਵੇਖ ਕੇ) ਆਕਾਸ਼ ਵਿੱਚ ਦੇਵਤੇ ਹੱਸਣ ਲੱਗੇ ॥੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "हसे देव गैणं ॥७९॥",
      "sourceLineId": "83961",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0207_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਭਜੀ ਸਰਬ ਸੈਣੰ ॥",
      "transliteration": "bhajee sarab saina(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਸੈਨਾ ਭੱਜ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 207,
      "hindi": "",
      "hindiTransliteration": "भजी सरब सैणं ॥",
      "sourceLineId": "83962",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
