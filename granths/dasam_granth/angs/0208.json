{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 208,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0208_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਲਖੀ ਮ੍ਰੀਚ ਨੈਣੰ ॥",
      "transliteration": "lakhee mreech naina(n) ||",
      "translation": "Marich saw his army running away,",
      "punjabiViakhya": "ਮਾਰੀਚ ਨੇ (ਆਪਣੀ) ਅੱਖੀਂ ਵੇਖ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "लखी म्रीच नैणं ॥",
      "sourceLineId": "83963",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਫਿਰਿਯੋ ਰੋਸ ਪ੍ਰੇਰਿਯੋ ॥",
      "transliteration": "firiyo ros preriyo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ (ਉਸ ਨੇ ਸੈਨਾ ਨੂੰ) ਗੁੱਸੇ ਨਾਲ ਇੰਜ ਪ੍ਰੇਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "फिरियो रोस प्रेरियो ॥",
      "sourceLineId": "83964",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਨੋ ਸਾਪ ਛੇੜਯੋ ॥੮੦॥",
      "transliteration": "mano saap chheRayo ||80||",
      "translation": "And challenged his forces in great ire like the rage of a snake.80.",
      "punjabiViakhya": "ਮਾਨੋ ਸੱਪ ਨੂੰ ਛੇੜਿਆ ਹੋਵੇ ॥੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "मनो साप छेड़यो ॥८०॥",
      "sourceLineId": "83965",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹਣਿਯੋ ਰਾਮ ਬਾਣੰ ॥",
      "transliteration": "haniyo raam baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਨੇ (ਉਸ ਨੂੰ) ਬਾਣ ਮਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "हणियो राम बाणं ॥",
      "sourceLineId": "83966",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਰਿਯੋ ਸਿੰਧ ਪਯਾਣੰ ॥",
      "transliteration": "kariyo si(n)dh payaana(n) ||",
      "translation": "Ram discharge his arrow towards Marich, who ran towards the sea.",
      "punjabiViakhya": "(ਜਿਸ ਦੇ ਨਾਲ ਮਾਰੀਚ) ਸਮੁੰਦਰ ਦੇ ਕੰਢੇ ਜਾ ਡਿੱਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "करियो सिंध पयाणं ॥",
      "sourceLineId": "83967",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਜਿਯੋ ਰਾਜ ਦੇਸੰ ॥",
      "transliteration": "tajiyo raaj dhesa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਇਸ) ਦੇਸ਼ ਦਾ ਰਾਜ ਛੱਡ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "तजियो राज देसं ॥",
      "sourceLineId": "83968",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਲਿਯੋ ਜੋਗ ਭੇਸੰ ॥੮੧॥",
      "transliteration": "liyo jog bhesa(n) ||81||",
      "translation": "He adopted the garb of a Yogi, abandoning his kingdom and country.81.",
      "punjabiViakhya": "ਅਤੇ ਯੋਗ ਤੇ ਭੇਸ ਨੂੰ ਧਾਰਨ ਕਰ ਲਿਆ ॥੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "लियो जोग भेसं ॥८१॥",
      "sourceLineId": "83969",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੁ ਬਸਤ੍ਰੰ ਉਤਾਰੇ ॥",
      "transliteration": "s basatra(n) utaare ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਬਸਤ੍ਰ (ਮਾਰੀਚ ਨੇ) ਉਤਾਰ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "सु बसत्रं उतारे ॥",
      "sourceLineId": "83970",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭਗਵੇ ਬਸਤ੍ਰ ਧਾਰੇ ॥",
      "transliteration": "bhagave basatr dhaare ||",
      "translation": "He wore the garments of a Yogi on forsaking the beautiful royal dress,",
      "punjabiViakhya": "ਅਤੇ ਭਗਵੇਾਂ ਬਸਤ੍ਰ ਪਾ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "भगवे बसत्र धारे ॥",
      "sourceLineId": "83971",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਸਯੋ ਲੰਕ ਬਾਗੰ ॥",
      "transliteration": "basayo la(n)k baaga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਲੰਕਾ ਦੇ ਬਾਗ਼ ਵਿੱਚ ਜਾ ਕੇ ਵਸਣ ਲੱਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "बसयो लंक बागं ॥",
      "sourceLineId": "83972",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪੁਨਰ ਦ੍ਰੋਹ ਤਿਆਗੰ ॥੮੨॥",
      "transliteration": "punar dhroh tiaaga(n) ||82||",
      "translation": "And abandoning all inimical ideas, he began to live in a cottage in Lanka.82.",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਰਾਮ ਨਾਲ ਵੈਰ ਕਰਨਾ ਛੱਡ ਦਿੱਤਾ ॥੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "पुनर द्रोह तिआगं ॥८२॥",
      "sourceLineId": "83973",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਰੋਸੰ ਸੁਬਾਹੰ ॥",
      "transliteration": "sarosa(n) subaaha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਗੁੱਸੇ ਨਾਲ ਸੁਬਾਹੂ",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "सरोसं सुबाहं ॥",
      "sourceLineId": "83974",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚੜਯੋ ਲੈ ਸਿਪਾਹੰ ॥",
      "transliteration": "chaRayo lai sipaaha(n) ||",
      "translation": "Subahu marched forward alongwith his soldiers in great rage,]",
      "punjabiViakhya": "ਸੈਨਾ ਲੈ ਕੇ ਚੜ੍ਰਹ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "चड़यो लै सिपाहं ॥",
      "sourceLineId": "83975",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਠਟਯੋ ਆਣ ਜੁਧੰ ॥",
      "transliteration": "ThaTayo aan judha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਆ ਕੇ ਯੁੱਧ ਸ਼ੁਰੂ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "ठटयो आण जुधं ॥",
      "sourceLineId": "83976",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਯੋ ਨਾਦ ਉੱਧੰ ॥੮੩॥",
      "transliteration": "bhayo naadh u'dha(n) ||83||",
      "translation": "And in the war of arrows, he also heard the terrible sound.83.",
      "punjabiViakhya": "ਅਤੇ ਭਿਆਨਕ ਰੌਲਾ ਪੈ ਗਿਆ ॥੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "भयो नाद उद्धं ॥८३॥",
      "sourceLineId": "83977",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੁਭੰ ਸੈਣ ਸਾਜੀ ॥",
      "transliteration": "subha(n) sain saajee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਸੋਹਣੀ ਸੈਨਾ ਸਜਾਈ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "सुभं सैण साजी ॥",
      "sourceLineId": "83978",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤੁਰੇ ਤੁੰਦ ਤਾਜੀ ॥",
      "transliteration": "ture tu(n)dh taajee ||",
      "translation": "In the bedecked forces, very swift horses began to run",
      "punjabiViakhya": "ਤੇਜ਼ ਚਾਲ ਵਾਲੇ ਘੋੜੇ ਭੱਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "तुरे तुँद ताजी ॥",
      "sourceLineId": "83979",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗਜਾ ਜੂਹ ਗੱਜੇ ॥",
      "transliteration": "gajaa jooh ga'je ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਥੀਆਂ ਦੇ ਦਲ ਚਿੰਘਾੜਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "गजा जूह गज्जे ॥",
      "sourceLineId": "83980",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਧੁਣੰ ਮੇਘ ਲੱਜੇ ॥੮੪॥",
      "transliteration": "dhuna(n) megh la'je ||84||",
      "translation": "The elephants roared in all the for directions and in front of their roars, the thunder of clouds appeared very dull.84.",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਦੀ ਆਵਾਜ਼ ਅੱਗੇ) ਬੱਦਲਾ ਦੀ ਧੁਨ ਲੱਜਾ ਰਹੀ ਸੀ ॥੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "धुणं मेघ लज्जे ॥८४॥",
      "sourceLineId": "83981",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਢਕਾ ਢੁੱਕ ਢਾਲੰ ॥",
      "transliteration": "ddakaa ddu'k ddaala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਢਾਲਾ ਆਪਸ ਵਿੱਚ ਢੱਕ-ਢੱਕ ਕਰਕੇ ਵੱਜਣ ਲੱਗੀਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "ढका ढुक्क ढालं ॥",
      "sourceLineId": "83982",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੁਭੀ ਪੀਤ ਲਾਲੰ ॥",
      "transliteration": "subhee peet laala(n) ||",
      "translation": "The knocking on the shields was audible and the yellow and red shields looked impressive.",
      "punjabiViakhya": "(ਉਹ) ਲਾਲ ਪੀਲੇ ਰੰਗਾ ਵਿੱਚ ਸ਼ੋਭਾ ਪਾ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "सुभी पीत लालं ॥",
      "sourceLineId": "83983",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗਹੇ ਸਸਤ੍ਰ ਉੱਠੇ ॥",
      "transliteration": "gahe sasatr u'The ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧੇ ਸ਼ਸਤ੍ਰ ਫੜ ਕੇ ਡਟੇ ਹੋਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "गहे ससत्र उट्ठे ॥",
      "sourceLineId": "83984",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਰੰਧਾਰ ਬੁੱਠੇ ॥੮੫॥",
      "transliteration": "sara(n)dhaar bu'The ||85||",
      "translation": "The warriors began to rise holding their weapons in their hands, and there was a continuous flow of shafts.85.",
      "punjabiViakhya": "ਅਤੇ ਤੀਰਾ ਦਾ ਮੀਂਹ ਵਸਾ ਰਹੇ ਸਨ ॥੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "सरंधार बुट्ठे ॥८५॥",
      "sourceLineId": "83985",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਹੈ ਅਗਨ ਅਸਤ੍ਰੰ ॥",
      "transliteration": "bahai agan asatra(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਗਨਿ-ਅਸਤ੍ਰ ਚਲਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "बहै अगन असत्रं ॥",
      "sourceLineId": "83986",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਛੁਟੇ ਸਰਬ ਸਸਤ੍ਰੰ ॥",
      "transliteration": "chhuTe sarab sasatra(n) ||",
      "translation": "The fire-shafts were discharged and the weapons began to fall form the hands of the warriors .",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਸ਼ਸਤ੍ਰ ਵੀ ਚਲਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "छुटे सरब ससत्रं ॥",
      "sourceLineId": "83987",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰੰਗੇ ਸ੍ਰੋਣ ਐਸੇ ॥",
      "transliteration": "ra(n)ge sron aaise ||",
      "translation": "",
      "punjabiViakhya": "ਲਹੂ ਨਾਲ ਰੰਗੇ ਹੋਏ (ਸੂਰਮੇ) ਇਉਾਂ ਲੱਗਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "रंगे स्रोण ऐसे ॥",
      "sourceLineId": "83988",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚੜੇ ਬਯਾਹ ਜੈਸੇ ॥੮੬॥",
      "transliteration": "chaRe bayaeh jaise ||86||",
      "translation": "The brave fighters saturated with blood appeared like the participants in a marriage party wearing red garments.86.",
      "punjabiViakhya": "ਜਿਉਾਂ ਵਿਆਹ ਨੂੰ ਚੜ੍ਰਹੇ ਹਨ ॥੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "चड़े बयाह जैसे ॥८६॥",
      "sourceLineId": "83989",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਘਣੈ ਘਾਇ ਘੂਮੇ ॥",
      "transliteration": "ghanai ghai ghoome ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤੇ (ਸੂਰਮੇ) ਘਾਇਲ ਹੋ ਕੇ (ਇਸ ਤਰ੍ਰਹਾ) ਘੁੰਮਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "घणै घाइ घूमे ॥",
      "sourceLineId": "83990",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਦੀ ਜੈਸ ਝੂਮੇ ॥",
      "transliteration": "madhee jais jhoome ||",
      "translation": "Many wounded people are roaming like a drunkard swinging in intoxication.",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਸ਼ਰਾਬੀ ਝੂਮਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "मदी जैस झूमे ॥",
      "sourceLineId": "83991",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗਹੇ ਬੀਰ ਐਸੇ ॥",
      "transliteration": "gahe beer aaise ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਇੰਜ ਸ਼ੋਭ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "गहे बीर ऐसे ॥",
      "sourceLineId": "83992",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਫੁਲੈ ਫੂਲ ਜੈਸੇ ॥੮੭॥",
      "transliteration": "fulai fool jaise ||87||",
      "translation": "The warriors have caught hold of each other like a flower meeting the other flower joyfully.87.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਫੁੱਲ ਖਿੜੇ ਹੁੰਦੇ ਹਨ ॥੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "फुलै फूल जैसे ॥८७॥",
      "sourceLineId": "83993",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਹਠਿਯੋ ਦਾਨਵੇਸੰ ॥",
      "transliteration": "haThiyo dhaanavesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤ ਰਾਜਾ",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "हठियो दानवेसं ॥",
      "sourceLineId": "83994",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭਯੋ ਆਪ ਭੇਸੰ ॥",
      "transliteration": "bhayo aap bhesa(n) ||",
      "translation": "The demon-king was killed and he attained his real form.",
      "punjabiViakhya": "(ਸੁਬਾਹੂ- ਹੱਠ ਨਾਲ ਤੱਤਪਰ ਹੋ ਗਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "भयो आप भेसं ॥",
      "sourceLineId": "83995",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਜੇ ਘੋਰ ਬਾਜੇ ॥",
      "transliteration": "baje ghor baaje ||",
      "translation": "",
      "punjabiViakhya": "ਘੋਰ ਵਾਜੇ ਵੱਜਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "बजे घोर बाजे ॥",
      "sourceLineId": "83996",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਧੁਣੰ ਅੱਭ੍ਰ ਲਾਜੇ ॥੮੮॥",
      "transliteration": "dhuna(n) a'bhr laaje ||88||",
      "translation": "The musical instruments were played and listening to their sound, the clouds felt.88.",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਦੀ) ਧੁਨ ਅੱਗੋਂ ਬੱਦਲ ਵੀ ਲਜਾਦੇ ਸਨ ॥੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "धुणं अब्भ्र लाजे ॥८८॥",
      "sourceLineId": "83997",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰਥੀ ਨਾਗ ਕੂਟੇ ॥",
      "transliteration": "rathee naag kooTe ||",
      "translation": "",
      "punjabiViakhya": "ਰੱਥਾ ਵਾਲਿਆਂ ਨੇ ਹਾਥੀ (ਨਾਗ) ਮਾਰ ਸੁੱਟੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "रथी नाग कूटे ॥",
      "sourceLineId": "83998",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਫਿਰੈਂ ਬਾਜ ਛੂਟੈ ॥",
      "transliteration": "firai(n) baaj chhooTai ||",
      "translation": "Many charioteers were killed and the horses began to roam in the battlefield unclaimed.",
      "punjabiViakhya": "ਘੋੜੇ ਛੁੱਟੇ ਫਿਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "फिरैं बाज छूटै ॥",
      "sourceLineId": "83999",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭਯੋ ਜੁੱਧ ਭਾਰੀ ॥",
      "transliteration": "bhayo ju'dh bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਰਾ ਯੁੱਧ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "भयो जुद्ध भारी ॥",
      "sourceLineId": "84000",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਛੁਟੀ ਰੁਦ੍ਰ ਤਾਰੀ ॥੮੯॥",
      "transliteration": "chhuTee rudhr taaree ||89||",
      "translation": "This war was so dreadful that even the meditation of Shiva was ruptured.89.",
      "punjabiViakhya": "(ਜਿਸ ਕਰਕੇ) ਸ਼ਿਵ ਦੀ ਸਮਾਧੀ ਖੁੱਲ੍ਰਹ ਗਈ ਸੀ ॥੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "छुटी रुद्र तारी ॥८९॥",
      "sourceLineId": "84001",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਜੇ ਘੰਟ ਭੇਰੀ ॥",
      "transliteration": "baje gha(n)T bheree ||",
      "translation": "",
      "punjabiViakhya": "ਘੰਟੇ ਤੇ ਭੇਰੀਆਂ ਵੱਜਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "बजे घंट भेरी ॥",
      "sourceLineId": "84002",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਡਹੇ ਡਾਮ ਡੇਰੀ ॥",
      "transliteration": "ddahe ddaam dderee ||",
      "translation": "The resounding of the gongs, drums and tabors began.",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਤੋਂ) ਡੰਮ-ਡੰਮ ਦੀ ਆਵਾਜ਼ ਨਿਕਲਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "डहे डाम डेरी ॥",
      "sourceLineId": "84003",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰਣੰਕੇ ਨਿਸਾਣੰ ॥",
      "transliteration": "rana(n)ke nisaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਧੌਂਸੇ ਗੂੰਜਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "रणंके निसाणं ॥",
      "sourceLineId": "84004",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਣੰਛੇ ਕਿਕਾਣੰ ॥੯੦॥",
      "transliteration": "kana(n)chhe kikaana(n) ||90||",
      "translation": "The trumpets were sounded and the horses neighed.90.",
      "punjabiViakhya": "ਅਤੇ ਘੋੜੇ ਹਿਣਕਦੇ ਸਨ ॥੯੦॥",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "कणंछे किकाणं ॥९०॥",
      "sourceLineId": "84005",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਧਹਾ ਧੂਹ ਧੋਪੰ ॥",
      "transliteration": "dhahaa dhooh dhopa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਾ (ਧੋਪ) ਦੇ ਵੱਜਣ ਨਾਲ ਧੂੰਹਾ-ਧੂੰਹ ਦੀ ਆਵਾਜ਼ ਹੁੰਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "धहा धूह धोपं ॥",
      "sourceLineId": "84006",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਟਕਾ ਟੂਕ ਟੋਪੰ ॥",
      "transliteration": "Takaa Took Topa(n) ||",
      "translation": "Various sounds arose in the battlefield and there were knocking on the helmets.",
      "punjabiViakhya": "ਟੱਕਾ-ਟੱਕ' ਕਰਕੇ ਟੋਪ ਟੁੱਟਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "टका टूक टोपं ॥",
      "sourceLineId": "84007",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਟੇ ਚਰਮ ਬਰਮੰ ॥",
      "transliteration": "kaTe charam barama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਢਾਲਾ ਅਤੇ ਕਵਚ ਕਟੇ ਜਾ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "कटे चरम बरमं ॥",
      "sourceLineId": "84008",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪਲਿਯੋ ਛੱਤ੍ਰ ਧਰਮੰ ॥੯੧॥",
      "transliteration": "paliyo chha'tr dharama(n) ||91||",
      "translation": "The armours on the bodies were chopped and the heroes followed the discipline of Kshatriyas.91.",
      "punjabiViakhya": "ਅਤੇ (ਯੋਧੇ) ਛੱਤ੍ਰਹੀ ਧਰਮ ਪਾਲ ਰਹੇ ਸਨ ॥੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "पलियो छत्त्र धरमं ॥९१॥",
      "sourceLineId": "84009",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0208_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਭਯੋ ਦੁੰਦ ਜੁੱਧੰ ॥",
      "transliteration": "bhayo dhu(n)dh ju'dha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਮ ਤੇ ਸੁਬਾਹੂ) ਦਾ ਦੁਅੰਦ ਯੁੱਧ ਹੋਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 208,
      "hindi": "",
      "hindiTransliteration": "भयो दुँद जुद्धं ॥",
      "sourceLineId": "84010",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
