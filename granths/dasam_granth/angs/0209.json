{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 209,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0209_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭਰਯੋ ਰਾਮ ਕ੍ਰੁੱਧੰ ॥",
      "transliteration": "bharayo raam kru'dha(n) ||",
      "translation": "Ram was highly infuriated on seeing the continuance of the terrible war.",
      "punjabiViakhya": "ਰਾਮ ਕ੍ਰੋਧ ਨਾਲ ਭਰ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "भरयो राम क्रुद्धं ॥",
      "sourceLineId": "84011",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਟੀ ਦੁਸਟ ਬਾਹੰ ॥",
      "transliteration": "kaTee dhusaT baaha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਦੁਸ਼ਟ ਦੀ ਬਾਹ ਕੱਟ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "कटी दुसट बाहं ॥",
      "sourceLineId": "84012",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੰਘਾਰਯੋ ਸੁਬਾਹੰ ॥੯੨॥",
      "transliteration": "sa(n)ghaarayo subaaha(n) ||92||",
      "translation": "He chopped the arms of Subahu and killed him.92.",
      "punjabiViakhya": "ਅਤੇ (ਅੰਤ ਨੂੰ) ਸੁਬਾਹੂ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ॥੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "संघारयो सुबाहं ॥९२॥",
      "sourceLineId": "84013",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤ੍ਰਸੈ ਦੈਤ ਭਾਜੇ ॥",
      "transliteration": "trasai dhait bhaaje ||",
      "translation": "",
      "punjabiViakhya": "ਡਰਦੇ ਹੋਏ ਦੈਂਤ ਭੱਜ ਗਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "त्रसै दैत भाजे ॥",
      "sourceLineId": "84014",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰਣੰ ਰਾਮ ਗਾਜੇ ॥",
      "transliteration": "rana(n) raam gaaje ||",
      "translation": "On seeing this, the frightened demons ran away and Ram thundered in the battlefield.",
      "punjabiViakhya": "ਅਤੇ ਰਣ ਵਿੱਚ ਰਾਮ ਗੱਜਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "रणं राम गाजे ॥",
      "sourceLineId": "84015",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭੁਅੰ ਭਾਰ ਉਤਾਰਿਯੋ ॥",
      "transliteration": "bhua(n) bhaar utaariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਉਨ੍ਰਹਾ ਨੇ ਧਰਤੀ ਦਾ ਭਾਰ ਉਤਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "भुअं भार उतारियो ॥",
      "sourceLineId": "84016",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਿਖੀਸੰ ਉਬਾਰਿਯੋ ॥੯੩॥",
      "transliteration": "rikheesa(n) ubaariyo ||93||",
      "translation": "Ram lightened the burden of the earth and protected the sages.93.",
      "punjabiViakhya": "ਅਤੇ ਰਿਸ਼ੀਆਂ ਨੂੰ ਬਚਾ ਲਿਆ ॥੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "रिखीसं उबारियो ॥९३॥",
      "sourceLineId": "84017",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਭੈ ਸਾਧ ਹਰਖੇ ॥",
      "transliteration": "sabhai saadh harakhe ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਸਾਧ ਪ੍ਰਸੰਨ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "सभै साध हरखे ॥",
      "sourceLineId": "84018",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭਏ ਜੀਤ ਕਰਖੇ ॥",
      "transliteration": "bhe jeet karakhe ||",
      "translation": "All the saints were pleased over the victory.",
      "punjabiViakhya": "ਅਤੇ ਜਿੱਤ ਦੇ ਗੀਤ ਗਾਏ ਜਾ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "भए जीत करखे ॥",
      "sourceLineId": "84019",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਰੈ ਦੇਵ ਅਰਚਾ ॥",
      "transliteration": "karai dhev arachaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤੇ (ਰਾਮ ਦੀ) ਪੂਜਾ ਕਰ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "करै देव अरचा ॥",
      "sourceLineId": "84020",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਰੈ ਬੇਦ ਚਰਚਾ ॥੯੪॥",
      "transliteration": "rarai bedh charachaa ||94||",
      "translation": "The gods were worshipped and the discussion on Vedas began.94.",
      "punjabiViakhya": "ਅਤੇ ਵੇਦ-ਚਰਚਾ ਹੋ ਰਹੀ ਸੀ ॥੯੪॥",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "ररै बेद चरचा ॥९४॥",
      "sourceLineId": "84021",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਯੋ ਜੱਗ ਪੂਰੰ ॥",
      "transliteration": "bhayo ja'g poora(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਵਿਸ਼ਵਾਮਿੱਤਰ ਦਾ) ਯੱਗ ਪੂਰਾ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "भयो जग्ग पूरं ॥",
      "sourceLineId": "84022",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗਏ ਪਾਪ ਦੂਰੰ ॥",
      "transliteration": "ge paap dhoora(n) ||",
      "translation": "The Yajna (of Vishwamitra) was complete and all the sins were destroyed.",
      "punjabiViakhya": "ਅਤੇ ਪਾਪ ਦੂਰ ਹੋ ਗਏ ।",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "गए पाप दूरं ॥",
      "sourceLineId": "84023",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੁਰੰ ਸਰਬ ਹਰਖੇ ॥",
      "transliteration": "sura(n) sarab harakhe ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਦੇਵਤੇ ਪ੍ਰਸੰਨ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "सुरं सरब हरखे ॥",
      "sourceLineId": "84024",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਧਨੰਧਾਰ ਬਰਖੇ ॥੯੫॥",
      "transliteration": "dhana(n)dhaar barakhe ||95||",
      "translation": "On seeing this, the gods were pleased and began to shower flowers.95.",
      "punjabiViakhya": "ਅਤੇ ਧਨ ਦੀ ਵਰਖਾ ਹੋਣ ਲੱਗੀ ॥੯੫॥",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "धनंधार बरखे ॥९५॥",
      "sourceLineId": "84025",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਰਾਮਾਵਤਾਰੇ ਕਥਾ ਸੁਬਾਹ ਮਰੀਚ ਬਧਹ ਜਗਯ ਸੰਪੂਰਨ ਕਰਨੰ ਸਮਾਪਤਮ ॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the raamaavataare kathaa subaeh mareech badheh jagay sa(n)pooran karana(n) samaapatam ||",
      "translation": "End of the description of the story of the Killing of MARICH and SUBAHU and also the Completion of Yajna in Rama Avtar in BACHITTAR NATAK.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ ਰਾਮਾਵਤਾਰ ਦੀ ਕਥਾ ਵਿੱਚ ਸੁਬਾਹੂ ਮਰੀਚ ਬਧ ਅਤੇ ਯੋਗ ਸੰਪੂਰਨ ਕਰਨ ਦੀ ਸਮਾਪਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे रामावतारे कथा सुबाह मरीच बधह जगय संपूरन करनं समापतम ॥",
      "sourceLineId": "84026",
      "sourceShabadId": "7910",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਥ ਸੀਤਾ ਸੁਯੰਬਰ ਕਥਨੰ ॥",
      "transliteration": "ath seetaa suya(n)bar kathana(n) ||",
      "translation": "Now begins the description of the Swayyamvara of Sita :",
      "punjabiViakhya": "ਹੁਣ ਸੀਤਾ ਸੁਅੰਬਰ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "अथ सीता सुयंबर कथनं ॥",
      "sourceLineId": "84027",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "84028",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਚਯੋ ਸੁਯੰਬਰ ਸੀਤਾ ॥",
      "transliteration": "rachayo suya(n)bar seetaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੀਤਾ ਦਾ (ਜਨਕ ਨੇ) ਸੁਅੰਬਰ ਰਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "रचयो सुयंबर सीता ॥",
      "sourceLineId": "84029",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਹਾ ਸੁੱਧ ਗੀਤਾ ॥",
      "transliteration": "mahaa su'dh geetaa ||",
      "translation": "The day of the Swayyamvara of Sita was fixed, who was extremely pure like Gita.",
      "punjabiViakhya": "ਜੋ ਗੀਤਾ ਵਾਗ ਵੱਡੀ ਪਵਿੱਤਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "महा सुद्ध गीता ॥",
      "sourceLineId": "84030",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਿਧੰ ਚਾਰ ਬੈਣੀ ॥",
      "transliteration": "bidha(n) chaar bainee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਕੋਇਲ ਵਰਗੀ ਸੁੰਦਰ ਬੋਲਾ ਵਾਲੀ",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "बिधं चार बैणी ॥",
      "sourceLineId": "84031",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮ੍ਰਿਗੀ ਰਾਜ ਨੈਣੀ ॥੯੬॥",
      "transliteration": "miragee raaj nainee ||96||",
      "translation": "Her words were winsome like those of the nightingale. She had eyes like the eyes of the king of deer.96.",
      "punjabiViakhya": "ਅਤੇ ਹਿਰਨ ਵਰਗੀਆਂ ਅੱਖਾ ਵਾਲੀ ਸੀ ॥੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "मृगी राज नैणी ॥९६॥",
      "sourceLineId": "84032",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੁਣਯੋ ਮੋਨਨੇਸੰ ॥",
      "transliteration": "sunayo monanesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਨੀ-ਰਾਜ (ਵਿਸ਼ਵਾਮਿਤਰ) ਨੇ (ਸੁਅੰਬਰ ਦੀ ਗੱਲ ਨੂੰ) ਸੁਣ ਲਿਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "सुणयो मोननेसं ॥",
      "sourceLineId": "84033",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚਤੁਰ ਚਾਰ ਦੇਸੰ ॥",
      "transliteration": "chatur chaar dhesa(n) ||",
      "translation": "The chief sage Vishwamitra had heard about it.",
      "punjabiViakhya": "ਕਿ ਚੌਹਾ ਕੁੰਟਾ ਅਤੇ ਦਿਸ਼ਾਵਾ (ਤੋਂ ਰਾਜ ਕੁਮਾਰ ਆ ਰਹੇ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "चतुर चार देसं ॥",
      "sourceLineId": "84034",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਲਯੋ ਸੰਗ ਰਾਮੰ ॥",
      "transliteration": "layo sa(n)g raama(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਲਈ ਉਸ ਨੇ) ਰਾਮ ਨੂੰ ਆਪਣੇ ਨਾਲ ਲੈ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "लयो संग रामं ॥",
      "sourceLineId": "84035",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਚਲਯੋ ਧਰਮ ਧਾਮੰ ॥੯੭॥",
      "transliteration": "chalayo dharam dhaama(n) ||97||",
      "translation": "He took with his Ram, the wise and beautiful Youngman of the country and went (to Jankpuri), the abode of righteousness.97.",
      "punjabiViakhya": "ਅਤੇ ਧਰਮ-ਧਾਮ (ਰਾਜਾ ਜਨਕ ਦੇ ਸ਼ਹਿਰ) ਵੱਲ ਚੱਲ ਪਿਆ ॥੯੭॥",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "चलयो धरम धामं ॥९७॥",
      "sourceLineId": "84036",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੁਨੋ ਰਾਮ ਪਿਆਰੇ ॥",
      "transliteration": "suno raam piaare ||",
      "translation": "",
      "punjabiViakhya": "(ਵਿਸ਼ਵਾਮਿੱਤਰ ਨੇ ਕਿਹਾ-) ਹੇ ਪਿਆਰੇ ਰਾਮ! ਸੁਣੋ,",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "सुनो राम पिआरे ॥",
      "sourceLineId": "84037",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚਲੋ ਸਾਥ ਹਮਾਰੇ ॥",
      "transliteration": "chalo saath hamaare ||",
      "translation": "“O dear Ram, listen, accompany me there",
      "punjabiViakhya": "ਮੇਰੇ ਨਾਲ (ਜਨਕ ਪੁਰੀ ਨੂੰ) ਚੱਲੋ,",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "चलो साथ हमारे ॥",
      "sourceLineId": "84038",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੀਆ ਸੁਯੰਬਰ ਕੀਨੋ ॥",
      "transliteration": "seeaa suya(n)bar keeno ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ) ਸੀਤਾ ਦਾ ਸੁਅੰਬਰ ਹੋ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "सीआ सुयंबर कीनो ॥",
      "sourceLineId": "84039",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨ੍ਰਿਪੰ ਬੋਲ ਲੀਨੋ ॥੯੮॥",
      "transliteration": "nirapa(n) bol leeno ||98||",
      "translation": "“The Swayyamvara of Sita has been fixed and the king (Janak) has called us.98.",
      "punjabiViakhya": "(ਇਸ ਲਈ) ਜਨਕ ਰਾਜਾ ਨੇ ਨਿਮੰਤਰਿਤ ਕੀਤਾ ਹੈ ॥੯੮॥",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "नृपं बोल लीनो ॥९८॥",
      "sourceLineId": "84040",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਹਾ ਪ੍ਰਾਤ ਜੱਈਐ ॥",
      "transliteration": "tahaa praat ja'ieeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਪ੍ਰਾਤਾਕਾਲ ਚਲੋ!",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "तहा प्रात जई्ईऐ ॥",
      "sourceLineId": "84041",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੀਆ ਜੀਤ ਲੱਈਐ ॥",
      "transliteration": "seeaa jeet la'ieeaai ||",
      "translation": "“We may go there at day-dawn and conquer Sita",
      "punjabiViakhya": "ਸੀਤਾ ਨੂੰ ਜਿੱਤ ਲਿਆਓ।",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "सीआ जीत लई्ईऐ ॥",
      "sourceLineId": "84042",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਹੀ ਮਾਨ ਮੇਰੀ ॥",
      "transliteration": "kahee maan meree ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੀ ਕਹੀ ਗੱਲ ਮੰਨ ਲਵੋ,",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "कही मान मेरी ॥",
      "sourceLineId": "84043",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਨੀ ਬਾਤ ਤੇਰੀ ॥੯੯॥",
      "transliteration": "banee baat teree ||99||",
      "translation": "“Obey my saying, now it is upto you.99.",
      "punjabiViakhya": "(ਇਸ ਨਾਲ) ਤੇਰੀ ਗੱਲ ਬਣ ਜਾਵੇਗੀ, (ਅਰਥਾਤ ਵਡਿਆਈ ਹੋਵੇਗੀ) ॥੯੯॥",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "बनी बात तेरी ॥९९॥",
      "sourceLineId": "84044",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਲੀ ਪਾਨ ਬਾਕੇ ॥",
      "transliteration": "balee paan baake ||",
      "translation": "",
      "punjabiViakhya": "(ਆਪਣੇ) ਬਲਵਾਨ ਤੇ ਬਾਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "बली पान बाके ॥",
      "sourceLineId": "84045",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਿਪਾਤੋ ਪਿਨਾਕੇ ॥",
      "transliteration": "nipaato pinaake ||",
      "translation": "“With your beautiful and strong hands, break the bow",
      "punjabiViakhya": "ਹੱਥਾ ਨਾਲ ਸ਼ਿਵ-ਧਨੁਸ਼ ਤੋੜ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "निपातो पिनाके ॥",
      "sourceLineId": "84046",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੀਆ ਜੀਤ ਆਨੋ ॥",
      "transliteration": "seeaa jeet aano ||",
      "translation": "",
      "punjabiViakhya": "ਸੀਤਾ ਜਿੱਤ ਲਿਆਓ",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "सीआ जीत आनो ॥",
      "sourceLineId": "84047",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹਨੋ ਸਰਬ ਦਾਨੋ ॥੧੦੦॥",
      "transliteration": "hano sarab dhaano ||100||",
      "translation": "“Conquer and bring Sita and destroy all the demons.”100.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਦੈਂਤਾ ਨੂੰ ਮਾਰ ਦਿਓ ॥੧੦੦॥",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "हनो सरब दानो ॥१००॥",
      "sourceLineId": "84048",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚਲੇ ਰਾਮ ਸੰਗੰ ॥",
      "transliteration": "chale raam sa(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ (ਵਿਸ਼ਵਾਮਿਤਰ) ਨਾਲ ਚਲ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "चले राम संगं ॥",
      "sourceLineId": "84049",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੁਹਾਏ ਨਿਖੰਗੰ ॥",
      "transliteration": "suhaae nikha(n)ga(n) ||",
      "translation": "He (the sage) went with Ram and the quiver (of Ram) seemed impressive.",
      "punjabiViakhya": "(ਪਿਛ ਪਛੋ) ਭੱਥਾ ਸ਼ੋਭ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "सुहाए निखंगं ॥",
      "sourceLineId": "84050",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭਏ ਜਾਇ ਠਾਢੇ ॥",
      "transliteration": "bhe jai Thaadde ||",
      "translation": "",
      "punjabiViakhya": "ਜਨਕ ਪੁਰੀ ਵਿੱਚ ਜਾ ਖੜੋਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "भए जाइ ठाढे ॥",
      "sourceLineId": "84051",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮਹਾ ਮੋਦ ਬਾਢੇ ॥੧੦੧॥",
      "transliteration": "mahaa modh baadde ||101||",
      "translation": "They went an stood there, their delight extended extremely.101.",
      "punjabiViakhya": "(ਉਥੇ ਹਰ ਪਾਸੇ) ਆਨੰਦ ਵਧ ਗਿਆ ॥੧੦੧॥",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "महा मोद बाढे ॥१०१॥",
      "sourceLineId": "84052",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪੁਰੰ ਨਾਰ ਦੇਖੈ ॥",
      "transliteration": "pura(n) naar dhekhai ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਹਿਰ ਦੀਆਂ ਨਾਰੀਆਂ ਨੇ (ਰਾਮ ਨੂੰ) ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "पुरं नार देखै ॥",
      "sourceLineId": "84053",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਹੀ ਕਾਮ ਲੇਖੈ ॥",
      "transliteration": "sahee kaam lekhai ||",
      "translation": "The women of the city look (toward Ram), they considered him Kamdev (Cupid) in reality.",
      "punjabiViakhya": "ਅਤੇ ਸਹੀ ਕਾਮ ਰੂਪ ਕਰ ਕੇ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "सही काम लेखै ॥",
      "sourceLineId": "84054",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰਿਪੰ ਸੱਤ੍ਰੁ ਜਾਨੈ ॥",
      "transliteration": "ripa(n) sa'tr jaanai ||",
      "translation": "",
      "punjabiViakhya": "ਵੈਰੀਆਂ ਨੇ ਵੈਰੀ ਕਰਕੇ ਜਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "रिपं सत्त्रु जानै ॥",
      "sourceLineId": "84055",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਿਧੰ ਸਾਧ ਮਾਨੈ ॥੧੦੨॥",
      "transliteration": "sidha(n) saadh maanai ||102||",
      "translation": "The inimical participants comprehend him as an enemy and the saintly persons consider him a saint.102.",
      "punjabiViakhya": "ਅਤੇ ਸੰਤਾ ਨੇ ਸਾਧ ਰੂਪ ਕਰਕੇ ਮੰਨਿਆ ॥੧੦੨॥",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "सिधं साध मानै ॥१०२॥",
      "sourceLineId": "84056",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਿਸੰ ਬਾਲ ਰੂਪੰ ॥",
      "transliteration": "sisa(n) baal roopa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਲਕਾ ਨੇ ਬਾਲ ਰੂਪ ਕਰਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "सिसं बाल रूपं ॥",
      "sourceLineId": "84057",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0209_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਲਹਯੋ ਭੂਪ ਭੂਪੰ ॥",
      "transliteration": "lahayo bhoop bhoopa(n) ||",
      "translation": "For children he is a boy, the kings consider him a king.",
      "punjabiViakhya": "ਰਾਜਿਆਂ ਨੇ ਰਾਜਾ ਕਰਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 209,
      "hindi": "",
      "hindiTransliteration": "लहयो भूप भूपं ॥",
      "sourceLineId": "84058",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
