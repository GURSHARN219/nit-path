{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 210,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0210_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਪਯੋ ਪਉਨ ਹਾਰੀ ॥",
      "transliteration": "tapayo paun haaree ||",
      "translation": "",
      "punjabiViakhya": "ਤਪੀਆਂ ਨੇ ਤਪਸਵੀ ('ਪਉਨਹਾਰੀ')",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "तपयो पउन हारी ॥",
      "sourceLineId": "84059",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਭਰੰ ਸਸਤ੍ਰ ਧਾਰੀ ॥੧੦੩॥",
      "transliteration": "bhara(n) sasatr dhaaree ||103||",
      "translation": "The ascetics look towards him as Shiva, with sustenance of air, and the bard considers him a weapons-wielder.103.",
      "punjabiViakhya": "ਅਤੇ ਸੂਰਮਿਆਂ ਨੇ ਸੂਰਮੇ ਵਜੋਂ ਜਾਣਿਆ ॥੧੦੩॥",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "भरं ससत्र धारी ॥१०३॥",
      "sourceLineId": "84060",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਿਸਾ ਚੰਦ ਜਾਨਯੋ ॥",
      "transliteration": "nisaa cha(n)dh jaanayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਨੇ (ਰਾਮ ਨੂੰ) ਚੰਦ੍ਰਮਾ ਕਰਕੇ ਪਛਾਣਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "निसा चंद जानयो ॥",
      "sourceLineId": "84061",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦਿਨੰ ਭਾਨ ਮਾਨਯੋ ॥",
      "transliteration": "dhina(n) bhaan maanayo ||",
      "translation": "For the night he is the moon and for day he is the sun.",
      "punjabiViakhya": "ਦਿਨ ਨੇ ਸੂਰਜ ਰੂਪ ਕਰਕੇ ਮੰਨਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "दिनं भान मानयो ॥",
      "sourceLineId": "84062",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗਣੰ ਰੁਦ੍ਰ ਰੇਖਯੋ ॥",
      "transliteration": "gana(n) rudhr rekhayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣਾ ਨੇ ਰੁਦ੍ਰ ਰੂਪ ਜਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "गणं रुद्र रेखयो ॥",
      "sourceLineId": "84063",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੁਰੰ ਇੰਦ੍ਰ ਦੇਖਯੋ ॥੧੦੪॥",
      "transliteration": "sura(n) i(n)dhr dhekhayo ||104||",
      "translation": "The Ganas marked him as Rudra and the gods saw him as Indra.104.",
      "punjabiViakhya": "ਅਤੇ ਦੇਵਤਿਆਂ ਨੇ ਇੰਦਰ ਰੂਪ ਕਰਕੇ ਵੇਖਿਆ ॥੧੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "सुरं इंद्र देखयो ॥१०४॥",
      "sourceLineId": "84064",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸ੍ਰੁਤੰ ਬ੍ਰਹਮ ਜਾਨਯੋ ॥",
      "transliteration": "sruta(n) braham jaanayo ||",
      "translation": "",
      "punjabiViakhya": "ਵੇਦਾ ਨੇ ਬ੍ਰਹਮ ਰੂਪ ਕਰਕੇ ਜਾਣਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "स्रुतं ब्रहम जानयो ॥",
      "sourceLineId": "84065",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦਿਜੰ ਬਯਾਸ ਮਾਨਯੋ ॥",
      "transliteration": "dhija(n) bayaas maanayo ||",
      "translation": "The Vedas comprehended him as Brahman, the Brahmins considered him as Vyas.",
      "punjabiViakhya": "ਪੰਡਿਤਾ ਨੇ ਬਿਆਸ ਰੂਪ ਕਰਕੇ ਮੰਨਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "दिजं बयास मानयो ॥",
      "sourceLineId": "84066",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹਰੀ ਬਿਸਨ ਲੇਖੇ ॥",
      "transliteration": "haree bisan lekhe ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਸ਼ਣੂ ਨੇ 'ਹਰੀ' ਵਜੋਂ ਖਿਆਲ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "हरी बिसन लेखे ॥",
      "sourceLineId": "84067",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੀਆ ਰਾਮ ਦੇਖੇ ॥੧੦੫॥",
      "transliteration": "seeaa raam dhekhe ||105||",
      "translation": "Vishnu visualized him as the Immanent Lord, and Sita sees him as Ram.105.",
      "punjabiViakhya": "ਅਤੇ ਸੀਤਾ ਨੇ ਸੁਆਮੀ ਰੂਪ ਵਿੱਚ ਵੇਖਿਆ ॥੧੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "सीआ राम देखे ॥१०५॥",
      "sourceLineId": "84068",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੀਆ ਪੇਖ ਰਾਮੰ ॥",
      "transliteration": "seeaa pekh raama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੀਤਾ ਨੇ ਰਾਮ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "सीआ पेख रामं ॥",
      "sourceLineId": "84069",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਿਧੀ ਬਾਣ ਕਾਮੰ ॥",
      "transliteration": "bidhee baan kaama(n) ||",
      "translation": "Sita looks towards him as Ram, being pierced by Cupid’s arrow.",
      "punjabiViakhya": "ਤੇ ਕਾਮ ਦੇ ਤੀਰ ਨਾਲ ਵਿੰਨ੍ਰਹੀ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "बिधी बाण कामं ॥",
      "sourceLineId": "84070",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗਿਰੀ ਝੂਮਿ ਭੂਮੰ ॥",
      "transliteration": "giree jhoom bhooma(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘੇਰਨੀ ਖਾ ਕੇ ਧਰਤੀ ਉੱਤੇ ਡਿੱਗ ਪਈ,",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "गिरी झूमि भूमं ॥",
      "sourceLineId": "84071",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਦੀ ਜਾਣੁ ਘੂਮੰ ॥੧੦੬॥",
      "transliteration": "madhee jaan ghooma(n) ||106||",
      "translation": "She fell down swinging on the earth like a roaming drunkeard.106.",
      "punjabiViakhya": "ਮਾਨੋ ਸ਼ਰਾਬੀ ਨੇ ਘੁਮੇਰੀ ਖਾਧੀ ਹੋਵੇ ॥੧੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "मदी जाणु घूमं ॥१०६॥",
      "sourceLineId": "84072",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਉਠੀ ਚੇਤ ਐਸੇ ॥",
      "transliteration": "auThee chet aaise ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਚੇਤ ਹੋਕੇ (ਫਿਰ) ਇਸ ਤਰ੍ਰਹਾ ਉੱਠੀ",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "उठी चेत ऐसे ॥",
      "sourceLineId": "84073",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਹਾਬੀਰ ਜੈਸੇ ॥",
      "transliteration": "mahaabeer jaise ||",
      "translation": "She gained consciousness and arose like a great warrior.",
      "punjabiViakhya": "(ਜਿਸ ਤਰ੍ਰਹਾ) ਬਹਾਦਰ ਯੋਧਾ (ਮੂਰਛਾ ਤੋਂ ਉੱਠਦਾ ਹੈ)",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "महाबीर जैसे ॥",
      "sourceLineId": "84074",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਹੀ ਨੈਨ ਜੋਰੀ ॥",
      "transliteration": "rahee nain joree ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਫਿਰ ਰਾਮ ਵਲ ਇਉਾਂ) ਅੱਖਾ ਟਿਕਾ ਲਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "रही नैन जोरी ॥",
      "sourceLineId": "84075",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਸੰ ਜਿਉ ਚਕੋਰੀ ॥੧੦੭॥",
      "transliteration": "sasa(n) jiau chakoree ||107||",
      "translation": "She kept her eyes concentrated like that off a Chakori (a hill bird) on the moon.107.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਚਕੋਰੀ ਚੰਦ੍ਰਮਾ ਵਲ ਅੱਖਾ ਜੋੜ ਲੈਂਦੀ ਹੈ ॥੧੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "ससं जिउ चकोरी ॥१०७॥",
      "sourceLineId": "84076",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਹੇ ਮੋਹ ਦੋਨੋ ॥",
      "transliteration": "rahe moh dhono ||",
      "translation": "",
      "punjabiViakhya": "(ਸੀਤਾ ਤੇ ਰਾਮ) ਦੋਵੇਾਂ ਇਕ ਦੂਜੇ ਉੱਤੇ ਮੋਹਿਤ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "रहे मोह दोनो ॥",
      "sourceLineId": "84077",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਟਰੇ ਨਾਹਿ ਕੋਨੋ ॥",
      "transliteration": "Tare naeh kono ||",
      "translation": "Both were attached to each other and none on them faltered.",
      "punjabiViakhya": "ਦੋਹਾ ਵਿੱਚੋਂ ਕੋਈ ਵੀ ਟਲਦਾ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "टरे नाहि कोनो ॥",
      "sourceLineId": "84078",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰਹੇ ਠਾਢ ਐਸੇ ॥",
      "transliteration": "rahe Thaadd aaise ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ (ਇਕ ਦੂਜੇ ਸਾਹਮਣੇ) ਖਲੋਤੇ ਹੋਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "रहे ठाढ ऐसे ॥",
      "sourceLineId": "84079",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰਣੰ ਬੀਰ ਜੈਸੇ ॥੧੦੮॥",
      "transliteration": "rana(n) beer jaise ||108||",
      "translation": "They stood firmly like the warrior in the battlefield.108.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਯੁੱਧ ਵਿੱਚ ਸੂਰਮੇ (ਸਾਹਮਣੇ ਡਟਦੇ ਹਨ) ॥੧੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "रणं बीर जैसे ॥१०८॥",
      "sourceLineId": "84080",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪਠੇ ਕੋਟ ਦੂਤੰ ॥",
      "transliteration": "paThe koT dhoota(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੀਤਾ ਦੇ ਸੁਅੰਬਰ ਦੀ ਸੂਚਨਾ ਦੇਣ ਲਈ ਰਾਜੇ ਜਨਕ ਨੇ) ਕਰੋੜਾ ਦੂਤ ਭੇਜੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "पठे कोट दूतं ॥",
      "sourceLineId": "84081",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0210_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚਲੇ ਪਉਨ ਪੂਤੰ ॥",
      "transliteration": "chale paun poota(n) ||",
      "translation": "The messengers were sent in the fort who went swiftly like Hanuman, the son of wind-god.",
      "punjabiViakhya": "ਜੋ ਪੌਣ ਦੇ ਪੁੱਤਰ (ਹਨੂਮਾਨ) ਵਾਗ ਚਲਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": "चले पउन पूतं ॥",
      "sourceLineId": "84082",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
