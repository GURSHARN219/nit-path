{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 211,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0211_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕੁਵੰਡਾਨ ਡਾਰੇ ॥",
      "transliteration": "kuva(n)ddaan ddaare ||",
      "translation": "",
      "punjabiViakhya": "(ਦੇਸ਼ਾ-ਦੇਸ਼ਾਤਰਾ ਦੇ ਰਾਜਿਆਂ ਦੇ ਇਕੱਠੋ ਹੇ ਜਾਣ 'ਤੇ) ਸ਼ਿਵ ਧਨੁਸ਼ ਨੂੰ ਲਿਆ ਕੇ (ਰਾਜ ਸਭਾ ਵਿੱਚ) ਰੱਖਿਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "कुवंडान डारे ॥",
      "sourceLineId": "84083",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਰੇਸੋ ਦਿਖਾਰੇ ॥੧੦੯॥",
      "transliteration": "nareso dhikhaare ||109||",
      "translation": "The saw was placed after showing it to the gathered kings.109.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਰਾਜਿਆਂ ਨੂੰ ਵਿਖਾਇਆ ਗਿਆ ॥੧੦੯॥",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "नरेसो दिखारे ॥१०९॥",
      "sourceLineId": "84084",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਲਯੋ ਰਾਮ ਪਾਨੰ ॥",
      "transliteration": "layo raam paana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਨੇ (ਸ਼ਿਵ ਧਨੁਸ਼ ਨੂੰ) ਹੱਥ ਵਿੱਚ ਚੁੱਕ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "लयो राम पानं ॥",
      "sourceLineId": "84085",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭਰਯੋ ਬੀਰ ਮਾਨੰ ॥",
      "transliteration": "bharayo beer maana(n) ||",
      "translation": "Ram took it in his hand, the hero (Ram) was filled with pride.",
      "punjabiViakhya": "ਵੀਰਤਾ ਵਾਲੇ ਗੌਰਵ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "भरयो बीर मानं ॥",
      "sourceLineId": "84086",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹਸਯੋ ਐਚ ਲੀਨੋ ॥",
      "transliteration": "hasayo aaich leeno ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੱਸਦੇ ਹੋਇਆਂ (ਧਨੁਸ਼ ਨੂੰ)",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "हसयो ऐच लीनो ॥",
      "sourceLineId": "84087",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਉਭੈ ਟੂਕ ਕੀਨੋ ॥੧੧੦॥",
      "transliteration": "aubhai Took keeno ||110||",
      "translation": "He pulled it smilingly and broke it into two parts.110.",
      "punjabiViakhya": "ਖਿੱਚ ਕੇ ਦੋ ਟੋਟੇ ਕਰ ਦਿੱਤੇ ॥੧੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "उभै टूक कीनो ॥११०॥",
      "sourceLineId": "84088",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਭੈ ਦੇਵ ਹਰਖੇ ॥",
      "transliteration": "sabhai dhev harakhe ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਦੇਵਤੇ ਪ੍ਰਸੰਨ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "सभै देव हरखे ॥",
      "sourceLineId": "84089",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਘਨੰ ਪੁਹਪ ਬਰਖੇ ॥",
      "transliteration": "ghana(n) puhap barakhe ||",
      "translation": "All the gods were pleased and a loot of flowers were showered.",
      "punjabiViakhya": "ਅਤੇ ਆਕਾਸ਼ ਤੋਂ ਫੁੱਲ ਵਰਸਾਉਣ ਲੱਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "घनं पुहप बरखे ॥",
      "sourceLineId": "84090",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਲਜਾਨੇ ਨਰੇਸੰ ॥",
      "transliteration": "lajaane naresa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਇਕੱਠੇ ਹੋਏ ਸਾਰੇ) ਰਾਜੇ ਸ਼ਰਮਸਾਰ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "लजाने नरेसं ॥",
      "sourceLineId": "84091",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚਲੇ ਆਪ ਦੇਸੰ ॥੧੧੧॥",
      "transliteration": "chale aap dhesa(n) ||111||",
      "translation": "Other kings felt shy and went back to their countries.111.",
      "punjabiViakhya": "ਆਪੋ ਆਪਣੇ ਦੇਸ਼ਾ ਨੂੰ ਚਲੇ ਗਏ ॥੧੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "चले आप देसं ॥१११॥",
      "sourceLineId": "84092",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਬੈ ਰਾਜ ਕੰਨਿਆ ॥",
      "transliteration": "tabai raaj ka(n)niaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵੇਲੇ ਰਾਜ ਪੁੱਤਰੀ ਸੀਤਾ ਨੇ,",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "तबै राज कंनिआ ॥",
      "sourceLineId": "84093",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਿਹੂੰ ਲੋਕ ਧੰਨਿਆ ॥",
      "transliteration": "tihoo(n) lok dha(n)niaa ||",
      "translation": "Then the princess, the most fortunate in three worlds.",
      "punjabiViakhya": "(ਜੋ) ਤਿੰਨਾ ਲੋਕਾ ਵਿੱਚ ਖ਼ੁਸ਼ਨਸੀਬ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "तिहूँ लोक धंनिआ ॥",
      "sourceLineId": "84094",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਧਰੇ ਫੂਲ ਮਾਲਾ ॥",
      "transliteration": "dhare fool maalaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਨੂੰ ਫੁੱਲਾ ਦੀ (ਮਾਲਾ) ਧਾਰਨ ਕਰਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "धरे फूल माला ॥",
      "sourceLineId": "84095",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਰਿਯੋ ਰਾਮ ਬਾਲਾ ॥੧੧੨॥",
      "transliteration": "bariyo raam baalaa ||112||",
      "translation": "Garlanded Ram and wedded him as her spouse.112.",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ ਨਾਲ) ਸੀਤਾ ਨੇ ਰਾਮ ਨੂੰ ਵਰ ਲਿਆ ॥੧੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "बरियो राम बाला ॥११२॥",
      "sourceLineId": "84096",
      "sourceShabadId": "7911",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJNAG PRAYYAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "84097",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਿਧੌ ਦੇਵ ਕੰਨਿਆ ਕਿਧੌ ਬਾਸਵੀ ਹੈ ॥",
      "transliteration": "kidhau dhev ka(n)niaa kidhau baasavee hai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ ਸੀਤਾ ਨਹੀਂ) ਕਿਤੇ ਦੇਵ ਪੁੱਤਰੀ ਹੈ, ਜਾ ਇੰਦਰਾਣੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "किधौ देव कंनिआ किधौ बासवी है ॥",
      "sourceLineId": "84098",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਿਧੌ ਜੱਛਨੀ ਕਿੰਨ੍ਰਨੀ ਨਾਗਨੀ ਹੈ ॥",
      "transliteration": "kidhau ja'chhanee ki(n)nranee naaganee hai ||",
      "translation": "Sita appeared like the daughter of a god or Indra, daughter of a Naga, daughter of a Yaksha or daughter of a Kinnar.",
      "punjabiViakhya": "ਜਾ ਯਕਸ਼ਣੀ ਹੈ, ਜਾ ਕਿੰਨਰਨੀ ਹੈ,ਜਾ ਨਾਗ ਪੁੱਤਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "किधौ जच्छनी किंन्रनी नागनी है ॥",
      "sourceLineId": "84099",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਿਧੌ ਗੰਧ੍ਰਬੀ ਦੈਤ ਜਾ ਦੇਵਤਾ ਸੀ ॥",
      "transliteration": "kidhau ga(n)dhrabee dhait jaa dhevataa see ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਗੰਧਰਥ ਪੁੱਤਰੀ, ਦੈਂਤ ਪੁੱਤਰੀ ਅਥਵਾ ਦੇਵ ਪੁੱਤਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "किधौ गंध्रबी दैत जा देवता सी ॥",
      "sourceLineId": "84100",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਿਧੌ ਸੂਰਜਾ ਸੁਧ ਸੋਧੀ ਸੁਧਾ ਸੀ ॥੧੧੩॥",
      "transliteration": "kidhau soorajaa sudh sodhee sudhaa see ||113||",
      "translation": "She looked like the daughter of a Gandharva, daughter of a demon or goddess. She appeared like the daughter of Sum or like the ambrosial light of the Moon.113.",
      "punjabiViakhya": "ਜਾ ਸੂਰਜ ਪੁੱਤਰੀ ਹੈ, ਜਾ ਸੋਧੀ ਹੋਈ ਪਵਿੱਤਰਤਾਈ ਜਾ ਅੰਮ੍ਰਿਤ ਹੈ ॥੧੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "किधौ सूरजा सुध सोधी सुधा सी ॥११३॥",
      "sourceLineId": "84101",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਿਧੌ ਜੱਛ ਬਿੱਦਿਆ ਧਰੀ ਗੰਧ੍ਰਬੀ ਹੈ ॥",
      "transliteration": "kidhau ja'chh bi'dhiaa dharee ga(n)dhrabee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਯਕਸ਼ ਪੁੱਤਰੀ ਹੈ, ਜਾ ਬਿਦਿਆਧਰੀ ਹੈ, ਜਾ ਗੰਧਰਥ ਇਸਤਰੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "किधौ जच्छ बिद्दिआ धरी गंध्रबी है ॥",
      "sourceLineId": "84102",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਿਧੌ ਰਾਗਨੀ ਭਾਗ ਪੂਰੇ ਰਚੀ ਹੈ ॥",
      "transliteration": "kidhau raaganee bhaag poore rachee hai ||",
      "translation": "She appeared like a Gandharva woman, having obtained the learning of Yakshas or a complete creation of a Ragini (musical mode).",
      "punjabiViakhya": "ਜਾ ਪੂਰੇ ਭਾਗ ਦੀ ਰਚੀ ਹੋਈ ਰਾਗਨੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "किधौ रागनी भाग पूरे रची है ॥",
      "sourceLineId": "84103",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਿਧੌ ਸੁਵਰਨ ਕੀ ਚਿਤ੍ਰ ਕੀ ਪੁੱਤ੍ਰਕਾ ਹੈ ॥",
      "transliteration": "kidhau suvaran kee chitr kee pu'trakaa hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਸੋਨੇ ਦੀ ਮੂਰਤ ਦੀ ਪੁਤਲੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "किधौ सुवरन की चित्र की पुत्त्रका है ॥",
      "sourceLineId": "84104",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਿਧੌ ਕਾਮ ਕੀ ਕਾਮਨੀ ਕੀ ਪ੍ਰਭਾ ਹੈ ॥੧੧੪॥",
      "transliteration": "kidhau kaam kee kaamanee kee prabhaa hai ||114||",
      "translation": "She looked like a golden puppet or the glory of a beautiful lady, full of passion.114.",
      "punjabiViakhya": "ਜਾ ਕਾਮ ਦੀ ਇਸਤਰੀ ਰਤੀ ਦੀ ਸੁੰਦਰਤਾਈ ਹੈ ॥੧੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "किधौ काम की कामनी की प्रभा है ॥११४॥",
      "sourceLineId": "84105",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਿਧੌ ਚਿੱਤ੍ਰ ਕੀ ਪੁੱਤ੍ਰਕਾ ਸੀ ਬਨੀ ਹੈ ॥",
      "transliteration": "kidhau chi'tr kee pu'trakaa see banee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਮੂਰਤ ਦੀ ਪੁਤਲੀ ਜਿਹੀ ਬਣੀ ਹੋਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "किधौ चित्त्र की पुत्त्रका सी बनी है ॥",
      "sourceLineId": "84106",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਿਧੌ ਸੰਖਨੀ ਚਿੱਤ੍ਰਨੀ ਪਦਮਨੀ ਹੈ ॥",
      "transliteration": "kidhau sa(n)khanee chi'tranee padhamanee hai ||",
      "translation": "She appeared like a puppet exquisite a Padmini (different gradations of a woman).",
      "punjabiViakhya": "ਜਾ ਸੰਖਨੀ, ਚਿਤ੍ਰਨੀ ਜਾ ਪਦਮਨੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "किधौ संखनी चित्त्रनी पदमनी है ॥",
      "sourceLineId": "84107",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਿਧੌ ਰਾਗ ਪੂਰੇ ਭਰੀ ਰਾਗ ਮਾਲਾ ॥",
      "transliteration": "kidhau raag poore bharee raag maalaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਪੂਰੇ ਰਾਗਾ ਦੀ ਭਰੀ ਹੋਈ ਰਾਗ-ਮਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "किधौ राग पूरे भरी राग माला ॥",
      "sourceLineId": "84108",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਰੀ ਰਾਮ ਤੈਸੀ ਸੀਆ ਆਜ ਬਾਲਾ ॥੧੧੫॥",
      "transliteration": "baree raam taisee seeaa aaj baalaa ||115||",
      "translation": "She looked like Ragmala, studded completely with Ragas (musical modes), and Ram wedded such a beautiful Sita.115.",
      "punjabiViakhya": "(ਉਸ ਤਰ੍ਰਹਾ ਦੀ) ਅੱਜ ਰਾਮ ਨੇ ਸੀਤਾ ਇਸਤਰੀ ਨੂੰ ਪਰਨਾਇਆ ਹੈ ॥੧੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "बरी राम तैसी सीआ आज बाला ॥११५॥",
      "sourceLineId": "84109",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਛਕੇ ਪ੍ਰੇਮ ਦੋਨੋ ਲਗੇ ਨੈਨ ਐਸੇ ॥",
      "transliteration": "chhake prem dhono lage nain aaise ||",
      "translation": "",
      "punjabiViakhya": "ਸੀਤਾ ਤੇ ਰਾਮ ਦੋਵੇਾਂ ਪ੍ਰੇਮ ਵਿੱਚ ਮਸਤ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "छके प्रेम दोनो लगे नैन ऐसे ॥",
      "sourceLineId": "84110",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਨੋ ਫਾਧ ਫਾਧੈ ਮ੍ਰਿਗੀਰਾਜ ਜੈਸੇ ॥",
      "transliteration": "mano faadh faadhai mirageeraaj jaise ||",
      "translation": "Having been absorbed in love for each other.",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ) ਨੈਣ (ਆਪਸ ਵਿੱਚ) ਇਸ ਤਰ੍ਰਹਾ ਲੱਗੇ ਹੋਏ ਸਨ ਮਾਨੋ ਫੰਧਕ ਨੇ ਹਿਰਨ ਨੂੰ ਫਸਾ ਲਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "मनो फाध फाधै मृगीराज जैसे ॥",
      "sourceLineId": "84111",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਿਧੁੰ ਬਾਕ ਬੈਣੀ ਕਟੰ ਦੇਸ ਛੀਣੰ ॥",
      "transliteration": "bidhu(n) baak bainee kaTa(n) dhes chheena(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕੋਇਲ ਵਾਗ ਬੋਲਣ ਵਾਲੀ ਅਤੇ ਪਤਲੇ ਲਕ ਵਾਲੀ (ਸੀਤਾ)",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "बिधुँ बाक बैणी कटं देस छीणं ॥",
      "sourceLineId": "84112",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰੰਗੇ ਰੰਗ ਰਾਮੰ ਸੁਨੈਣੰ ਪ੍ਰਬੀਣੰ ॥੧੧੬॥",
      "transliteration": "ra(n)ge ra(n)g raama(n) sunaina(n) prabeena(n) ||116||",
      "translation": "Sita of sweet speech and slim waist and visually absorbed with Ram, is looking exquisitely beautiful.116.",
      "punjabiViakhya": "ਨੈਣਾ ਵਾਲੇ ਪ੍ਰਬੀਨ ਰਾਮ ਦੇ ਪ੍ਰੇਮ ਵਿੱਚ ਰੰਗੀ ਗਈ ਸੀ ॥੧੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "रंगे रंग रामं सुनैणं प्रबीणं ॥११६॥",
      "sourceLineId": "84113",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਿਣੀ ਰਾਮ ਸੀਤਾ ਸੁਣੀ ਸ੍ਰਉਣ ਰਾਮੰ ॥",
      "transliteration": "jinee raam seetaa sunee sraun raama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਨੇ ਸੀਤਾ ਜਿੱਤ ਲਈ ਹੈ-(ਇਹ ਗੱਲ) ਪਰਸ਼ੂਰਾਮ ਨੇ (ਜਿਸ ਵੇਲੇ) ਕੰਨੀ ਸੁਣੀ,",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "जिणी राम सीता सुणी स्रउण रामं ॥",
      "sourceLineId": "84114",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗਹੇ ਸਸਤ੍ਰ ਅਸਤ੍ਰੰ ਰਿਸਯੋ ਤਉਨ ਜਾਮੰ ॥",
      "transliteration": "gahe sasatr asatra(n) risayo taun jaama(n) ||",
      "translation": "When Parashuram heard this that Ram hath conquered Sita, he at that time, in great ire, held up his arms and weapons.",
      "punjabiViakhya": "ਤਾ ਉਸੇ ਵੇਲੇ ਕ੍ਰੋਧ ਨਾਲ ਭਰ ਗਿਆ ਤੇ ਅਸਤ੍ਰ ਸ਼ਸਤ੍ਰ ਫੜ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "गहे ससत्र असत्रं रिसयो तउन जामं ॥",
      "sourceLineId": "84115",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਹਾ ਜਾਤ ਭਾਖਿਯੋ ਰਹੋ ਰਾਮ ਠਾਢੇ ॥",
      "transliteration": "kahaa jaat bhaakhiyo raho raam Thaadde ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ ਆ ਕੇ) ਕਹਿਣ ਲੱਗਾ-ਹੇ ਰਾਮ! ਕਿੱਥੇ ਜਾਦਾ ਹੈਂ? ਖੜਾ ਰਹਿ",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "कहा जात भाखियो रहो राम ठाढे ॥",
      "sourceLineId": "84116",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਲਖੋ ਆਜ ਕੈਸੇ ਭਏ ਬੀਰ ਗਾਢੇ ॥੧੧੭॥",
      "transliteration": "lakho aaj kaise bhe beer gaadde ||117||",
      "translation": "He asked Ram to stop there and challenged him saying.”I shall now see, what type of hero thou art.”117.",
      "punjabiViakhya": "(ਤਾ ਕਿ ਮੈਂ) ਅੱਜ ਵੇਖਾ ਜੋ ਕਿਸ ਤਰ੍ਰਹਾ ਦੇ ਬਹਾਦਰ ਯੋਧਾ ਹੋ ਗਏ ਹਨ ॥੧੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "लखो आज कैसे भए बीर गाढे ॥११७॥",
      "sourceLineId": "84117",
      "sourceShabadId": "7912",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਾਖਾ ਪਿੰਗਲ ਦੀ ॥",
      "transliteration": "bhaakhaa pi(n)gal dhee ||",
      "translation": "Bhakha Pingal Di (The language of prosody):",
      "punjabiViakhya": "ਭਾਖਾ ਪਿੰਗਲ ਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "भाखा पिंगल दी ॥",
      "sourceLineId": "84118",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੁੰਦਰੀ ਛੰਦ ॥",
      "transliteration": "su(n)dharee chha(n)dh ||",
      "translation": "SUNDARI STANZA",
      "punjabiViakhya": "ਸੁੰਦਰੀ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "सुँदरी छंद ॥",
      "sourceLineId": "84119",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭਟ ਹੁੰਕੇ ਧੁੰਕੇ ਬੰਕਾਰੇ ॥",
      "transliteration": "bhaT hu(n)ke dhu(n)ke ba(n)kaare ||",
      "translation": "",
      "punjabiViakhya": "ਬਹਾਦਰ ਸੂਰਮੇ ਹੁੰਗਾਰੇ ਅਤੇ ਲਲਕਾਰੇ ਮਾਰਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "भट हुँके धुँके बंकारे ॥",
      "sourceLineId": "84120",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਣ ਬੱਜੇ ਗੱਜੇ ਨੱਗਾਰੇ ॥",
      "transliteration": "ran ba'je ga'je na'gaare ||",
      "translation": "The warriors raised loud shouts and the terrible trumpets resounded.",
      "punjabiViakhya": "ਰਣ ਦੇ ਅੰਦਰ ਨਗਾਰੇ ਵੱਜ ਗੱਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "रण बज्जे गज्जे नग्गारे ॥",
      "sourceLineId": "84121",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰਣ ਹੁੱਲ ਕਲੋਲੰ ਹੁੱਲਾਲੰ ॥",
      "transliteration": "ran hu'l kalola(n) hu'laala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿੱਚ ਹੱਲਾ-ਗੁੱਲਾ ਅਤੇ ਰੌਲਾ-ਰੱਪਾ ਪੈ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "रण हुल्ल कलोलं हुल्लालं ॥",
      "sourceLineId": "84122",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਢਲ ਹੱਲੰ ਢੱਲੰ ਉੱਛਾਲੰ ॥੧੧੮॥",
      "transliteration": "ddal ha'la(n) dda'la(n) u'chhaala(n) ||118||",
      "translation": "There were war-cries in the battlefield and the warriors, being pleased began to hurl their shields up and down.118.",
      "punjabiViakhya": "ਅਤੇ (ਯੋਧੇ) ਢਾਲਾ ਨਾਲ (ਇਕ ਦੂਜੇ ਨੂੰ) ਧੱਕਦੇ ਅਤੇ ਢਾਲਾ ਨੂੰ ਉਛਾਲਦੇ ਸਨ ॥੧੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "ढल हल्लं ढल्लं उच्छालं ॥११८॥",
      "sourceLineId": "84123",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰਣ ਉੱਠੇ ਕੁੱਠੇ ਮੁੱਛਾਲੇ ॥",
      "transliteration": "ran u'The ku'The mu'chhaale ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ ਵਿੱਚ ਮੁੱਛਾ ਵਾਲੇ ਸੂਰਮੇ ਉਠੇ ਅਤੇ ਕੁੱਠੇ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "रण उट्ठे कुट्ठे मुच्छाले ॥",
      "sourceLineId": "84124",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਰ ਛੁੱਟੇ ਜੁੱਟੇ ਭੀਹਾਲੇ ॥",
      "transliteration": "sar chhu'Te ju'Te bheehaale ||",
      "translation": "The warriors with twined whiskers gathered together for war and fought with each other discharging dreadful shower of arrows.",
      "punjabiViakhya": "ਤੀਰ ਚਲਣ ਲਈ, ਭਿਆਨਕ ਯੋਧੇ, ਯੁੱਧ ਵਿੱਚ ਜੁੱਟ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "सर छुट्टे जुट्टे भीहाले ॥",
      "sourceLineId": "84125",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰਤੁ ਡਿੱਗੇ ਭਿੱਗੇ ਜੋਧਾਣੰ ॥",
      "transliteration": "rat ddi'ge bhi'ge jodhaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਲਹੂ ਨਾਲ ਲੱਥ-ਪੱਥ (ਹੋ ਕੇ ਕਈ) ਯੋਧੇ ਡਿੱਗ ਪਏ",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "रतु डिग्गे भिग्गे जोधाणं ॥",
      "sourceLineId": "84126",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਣਣੰਛੇ ਕੱਛੇ ਕਿਕਾਣੰ ॥੧੧੯॥",
      "transliteration": "kanana(n)chhe ka'chhe kikaana(n) ||119||",
      "translation": "The fighters drenched with blood began to fell and the horses were being crushed in the battlefield.119.",
      "punjabiViakhya": "ਅਤੇ ਖ਼ਾਲੀ ਘੋੜੇ ਹਿਣਕਦੇ ਹੋਏ ਫਿਰਨ ਲੱਗੇ ॥੧੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "कणणंछे कच्छे किकाणं ॥११९॥",
      "sourceLineId": "84127",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭੀਖਣੀਯੰ ਭੇਰੀ ਭੁੰਕਾਰੰ ॥",
      "transliteration": "bheekhaneeya(n) bheree bhu(n)kaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਡੀਆਂ ਭੇਰੀਆਂ ਭੂੰ-ਭੂੰ ਕਰਦੀਆਂ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "भीखणीयं भेरी भुँकारं ॥",
      "sourceLineId": "84128",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਝਲ ਲੰਕੇ ਖੰਡੇ ਦੁੱਧਾਰੰ ॥",
      "transliteration": "jhal la(n)ke kha(n)dde dhu'dhaara(n) ||",
      "translation": "The sound of the drums of Yoginis was being heard and the double-edged daggers glistened.",
      "punjabiViakhya": "ਦੁੱਧਾਰੇ ਖੰਡੇ ਲਿਸ਼ਕਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": "झल लंके खंडे दुद्धारं ॥",
      "sourceLineId": "84129",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0211_line_0048",
      "lineIndex": 48,
