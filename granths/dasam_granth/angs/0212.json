{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 212,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0212_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰੁੱਲੀਏ ਪਖਰੀਏ ਆਹਾੜੇ ॥੧੨੦॥",
      "transliteration": "ru'le'ee pakhare'e aahaaRe ||120||",
      "translation": "The warriors were mumbling and falling as martyrs and the heroes wearing armours were rolling in dust.120.",
      "punjabiViakhya": "ਘੋੜ-ਚੜ੍ਰਹੇ ਸੂਰਮੇ ਰਣ-ਭੂਮੀ (ਵਿੱਚ) ਰੁਲ ਰਹੇ ਸਨ ॥੧੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "रुल्लीए पखरीए आहाड़े ॥१२०॥",
      "sourceLineId": "84131",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬੱਕੇ ਬੱਬਾੜੇ ਬੰਕਾਰੰ ॥",
      "transliteration": "ba'ke ba'baaRe ba(n)kaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧੇ ਬੜਕਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "बक्के बब्बाड़े बंकारं ॥",
      "sourceLineId": "84132",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨੱਚੇ ਪੱਖਰੀਏ ਜੁਝਾਰੰ ॥",
      "transliteration": "na'che pa'khare'e jujhaara(n) ||",
      "translation": "The brave fighters thundered and the warriors wearing steel armours, being intoxicated, began to dance.",
      "punjabiViakhya": "ਲੜਾਕੂ ਸੂਰਮਿਆਂ ਦੇ ਘੋੜੇ ਨੱਚਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "नच्चे पक्खरीए जुझारं ॥",
      "sourceLineId": "84133",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬੱਜੇ ਸੰਗਲੀਏ ਭੀਹਾਲੇ ॥",
      "transliteration": "ba'je sa(n)gale'ee bheehaale ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਗਲਾ ਨਾਲ ਬੱਧੇ ਹੋਏ ਭਿਆਨਕ ਧੌਂਸੇ ਵੱਜਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "बज्जे संगलीए भीहाले ॥",
      "sourceLineId": "84134",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰਣ ਰੱਤੇ ਮੱਤੇ ਮੁੱਛਾਲੇ ॥੧੨੧॥",
      "transliteration": "ran ra'te ma'te mu'chhaale ||121||",
      "translation": "The terrible trumpets resounded and the warriors with dreadful whiskers began to fight in the war.121.",
      "punjabiViakhya": "ਰਣ ਵਿੱਚ ਮੁੱਛਾ ਵਾਲੇ ਮਸਤ ਸੂਰਮੇ (ਫਿਰਦੇ ਸਨ) ॥੧੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "रण रत्ते मत्ते मुच्छाले ॥१२१॥",
      "sourceLineId": "84135",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਉਛਲੀਏ ਕੱਛੀ ਕੱਛਾਲੇ ॥",
      "transliteration": "auchhale'ee ka'chhee ka'chhaale ||",
      "translation": "",
      "punjabiViakhya": "ਕੱਛ ਦੇ ਇਲਾਕੇ ਦੇ ਘੋੜੇ ਕੁੱਦਦੇ ਹੋਏ (ਇਉਾਂ ਪ੍ਰਤੀਤ ਹੁੰਦੇ ਸਨ)",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "उछलीए कच्छी कच्छाले ॥",
      "sourceLineId": "84136",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਉੱਡੇ ਜਣੁ ਪੱਬੰ ਪੱਛਾਲੇ ॥",
      "transliteration": "au'dde jan pa'ba(n) pa'chhaale ||",
      "translation": "The warriors were fighting with each other while twisting their whiskers. The chopping heroes were jumping like the winged mountains.",
      "punjabiViakhya": "ਮਾਨੋ ਖੰਭਾ ਵਾਲੇ ਪਹਾੜ ਉੱਤੇ ਜਾਦੇ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "उड्डे जणु पब्बं पच्छाले ॥",
      "sourceLineId": "84137",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੁੱਟੇ ਭਟ ਛੁੱਟੇ ਮੁੱਛਾਲੇ ॥",
      "transliteration": "ju'Te bhaT chhu'Te mu'chhaale ||",
      "translation": "",
      "punjabiViakhya": "ਭੱਟ (ਆਪਸ ਵਿੱਚ) ਜੁਟੇ ਹੋਏ ਸਨ ਅਤੇ ਬੰਬਲਾ ਵਾਲੇ ਨੇਜ਼ੇ ਚਲ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "जुट्टे भट छुट्टे मुच्छाले ॥",
      "sourceLineId": "84138",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰੁਲੀਏ ਆਹਾੜੰ ਪਖਰਾਲੇ ॥੧੨੨॥",
      "transliteration": "rule'ee aahaaRa(n) pakharaale ||122||",
      "translation": "The brave soldiers wearing armours are lying down on the earh.122.",
      "punjabiViakhya": "ਪਾਖਰਾ ਵਾਲੇ (ਘੋੜੇ) ਯੁੱਧ-ਭੂਮੀ ਵਿੱਚ (ਅਹਾੜੇ) ਰੁਲ ਰਹੇ ਸਨ ॥੧੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "रुलीए आहाड़ं पखराले ॥१२२॥",
      "sourceLineId": "84139",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬੱਜੇ ਸੰਧੂਰੰ ਨੱਗਾਰੇ ॥",
      "transliteration": "ba'je sa(n)dhoora(n) na'gaare ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਥੀਆਂ ਉੱਤੇ ਲਦੇ ਨਗਾਰੇ ਵੱਜ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "बज्जे संधूरं नग्गारे ॥",
      "sourceLineId": "84140",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕੱਛੇ ਕੱਛੀਲੇ ਲੁੱਝਾਰੇ ॥",
      "transliteration": "ka'chhe ka'chheele lu'jhaare ||",
      "translation": "The trumpets resounded upto distant places and the horses began to run hither and thither.",
      "punjabiViakhya": "ਭਿਆਨਕ ਯੋਧੇ (ਲੁਝਾਰੇ ਤਲਵਾਰਾ ਖਿੱਚੀ ਫਿਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "कच्छे कच्छीले लुज्झारे ॥",
      "sourceLineId": "84141",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗਣ ਹੂਰੰ ਪੂਰੰ ਗੈਣਾਯੰ ॥",
      "transliteration": "gan hoora(n) poora(n) gainaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਾ ਆਕਾਸ਼ ਹੂਰਾ ਦੇ ਝੁੰਡਾ ਨਾਲ ਭਰਿਆ ਹੋਇਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "गण हूरं पूरं गैणायं ॥",
      "sourceLineId": "84142",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅੰਜਨਯੰ ਅੰਜੇ ਨੈਣਾਯੰ ॥੧੨੩॥",
      "transliteration": "a(n)janaya(n) a(n)je nainaaya(n) ||123||",
      "translation": "The heavenly damsels began to roam in the sky and bedecking themselves and putting collyrium in their eyes they began to see the war.123.",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨੇ) ਅੱਖਾ ਵਿੱਚ ਅੰਜਨ ਪਾਇਆ ਹੋਇਆ ਸੀ ॥੧੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "अंजनयं अंजे नैणायं ॥१२३॥",
      "sourceLineId": "84143",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਣ ਣੱਕੇ ਨਾਦੰ ਨਾਫੀਰੰ ॥",
      "transliteration": "ran na'ke naadha(n) naafeera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਛੋਟੇ ਨਗਾਰੇ ਗੂੰਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "रण णक्के नादं नाफीरं ॥",
      "sourceLineId": "84144",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬੱਬਾੜੇ ਬੀਰੰ ਹਾਬੀਰੰ ॥",
      "transliteration": "ba'baaRe beera(n) haabeera(n) ||",
      "translation": "The thundering musical instruments were played in the war and the brave soldiers roared.",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਨੂੰ ਮਾਰਨ ਵਾਲੇ ਸੂਰਮੇ ਲਲਕਾਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "बब्बाड़े बीरं हाबीरं ॥",
      "sourceLineId": "84145",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਉੱਘੇ ਜਣੁ ਨੇਜੇ ਜੱਟਾਲੇ ॥",
      "transliteration": "au'ghe jan neje ja'Taale ||",
      "translation": "",
      "punjabiViakhya": "ਉਲਰੇ ਹੋਏ ਨੇਜ਼ੇ (ਇਉਾਂ ਪ੍ਰਤੀਤ ਹੁੰਦੇ ਸਨ) ਮਾਨੋ ਜਟਾ ਵਾਲੇ ਸਾਧੂ ਖੜੋਤੇ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "उग्घे जणु नेजे जट्टाले ॥",
      "sourceLineId": "84146",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਛੁੱਟੇ ਸਿਲ ਸਿਤਿਯੰ ਮੁੱਛਾਲੇ ॥੧੨੪॥",
      "transliteration": "chhu'Te sil sitiya(n) mu'chhaale ||124||",
      "translation": "The warriors holding their spears in their hands began to strike them, the arms and weapons of the warriors were put to use.124.",
      "punjabiViakhya": "ਬੰਬਲਾ ਵਾਲੇ ਚਮਕੀਲੇ ('ਸਿਤਿਯ') ਭਾਲੇ ਉਨ੍ਰਹਾ ਦੇ ਹੱਥੋਂ ਛੁੱਟ ਰਹੇ ਸਨ ॥੧੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "छुट्टे सिल सितियं मुच्छाले ॥१२४॥",
      "sourceLineId": "84147",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਭਟ ਡਿੱਗੇ ਘਾਯੰ ਅੱਘਾਯੰ ॥",
      "transliteration": "bhaT ddi'ge ghaaya(n) a'ghaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜ਼ਖ਼ਮ ਖਾ-ਖਾ ਕੇ ਤ੍ਰਿਪਤ ਹੋਏ ਯੋਧੇ ਡਿੱਗ ਪਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "भट डिग्गे घायं अग्घायं ॥",
      "sourceLineId": "84148",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਨ ਸੁੱਭੇ ਅੱਧੇ ਅੱਧਾਯੰ ॥",
      "transliteration": "tan su'bhe a'dhe a'dhaaya(n) ||",
      "translation": "The wounded warriors fell down and their bodies were chopped.",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਦੇ ਤਨ ਅੱਧੋ-ਅੱਧ ਹੋਏ ਸ਼ੋਭ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "तन सुब्भे अद्धे अद्धायं ॥",
      "sourceLineId": "84149",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦਲ ਗੱਜੇ ਬੱਜੇ ਨੀਸਾਣੰ ॥",
      "transliteration": "dhal ga'je ba'je neesaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੈਨਾਵਾ ਗੱਜਦੀਆਂ ਸਨ, ਧੌਂਸੇ ਵੱਜਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "दल गज्जे बज्जे नीसाणं ॥",
      "sourceLineId": "84150",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚੰਚਲੀਏ ਤਾਜੀ ਚੀਹਾਣੰ ॥੧੨੫॥",
      "transliteration": "cha(n)chale'ee taajee cheehaana(n) ||125||",
      "translation": "The armies thundered and the trumpets resounded, the restless horses neighed in the battlefield.125.",
      "punjabiViakhya": "ਅਤੇ ਚੰਚਲ ਘੋੜੇ ਹਿਣਕਦੇ ਸਨ ॥੧੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "चंचलीए ताजी चीहाणं ॥१२५॥",
      "sourceLineId": "84151",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚਵ ਦਿਸਯੰ ਚਿੰਕੀ ਚਾਵੰਡੈ ॥",
      "transliteration": "chav dhisaya(n) chi(n)kee chaava(n)ddai ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ ਪਾਸੇ ਗਿਰਝਾ ਚੀਕਦੀਆਂ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "चव दिसयं चिंकी चावंडै ॥",
      "sourceLineId": "84152",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਖੰਡੇ ਖੰਡੇ ਕੈ ਆਖੰਡੈ ॥",
      "transliteration": "kha(n)dde kha(n)dde kai aakha(n)ddai ||",
      "translation": "The vultures shrieked on all the four sides and they began to reduce already chopped bodies into bits.",
      "punjabiViakhya": "ਅਖੰਡਿਤਾ ਨੂੰ ਖੰਡ-ਖੰਡ ਕਰ ਦਿੱਤਾ ਗਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "खंडे खंडे कै आखंडै ॥",
      "sourceLineId": "84153",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਣ ੜੰਕੇ ਗਿੱਧੰ ਉੱਧਾਣੰ ॥",
      "transliteration": "ran Ra(n)ke gi'dha(n) u'dhaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉੱਚੇ (ਸਥਾਨ) ਉੱਤੇ ਬੈਠੀਆਂ ਗਿੱਧਾ ਇੰਜ ਬੋਲਦੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "रण ड़ंके गिद्धं उद्धाणं ॥",
      "sourceLineId": "84154",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜੈ ਜੰਪੈ ਸਿੰਧੰ ਸੁੱਧਾਣੰ ॥੧੨੬॥",
      "transliteration": "jai ja(n)pai si(n)dha(n) su'dhaana(n) ||126||",
      "translation": "In the jungle of that battlefield they began to play with the bits of flesh and the adepts and yogis wished for victory.126.",
      "punjabiViakhya": "ਮਾਨੋ ਯੁੱਧ ਸਿੱਧ ਜੈ ਜੈ ਜਪਦੇ ਹੋਣ ॥੧੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "जै जंपै सिंधं सुद्धाणं ॥१२६॥",
      "sourceLineId": "84155",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਫੁੱਲੇ ਜਣੁ ਕਿੰਸਕ ਬਾਸੰਤੰ ॥",
      "transliteration": "fu'le jan ki(n)sak baasa(n)ta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਬਸੰਤ ਰੁਤ ਵਿੱਚ ਕੇਸੂ ਫੁੱਲੇ ਹੋਣ-",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "फुल्ले जणु किंसक बासंतं ॥",
      "sourceLineId": "84156",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰਣ ਰੱਤੇ ਸੂਰਾ ਸਾਮੰਤੰ ॥",
      "transliteration": "ran ra'te sooraa saama(n)ta(n) ||",
      "translation": "Just as the flowers blossom in the spring, in the same manner are seen the mighty warriors fighting in the war.",
      "punjabiViakhya": "(ਲਹੂ ਨਾਲ) ਲਾਲ ਹੋਏ ਸੂਰਮੇ ਰਣ ਵਿੱਚ ਇਸ ਤਰ੍ਰਹਾ ਫਿਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "रण रत्ते सूरा सामंतं ॥",
      "sourceLineId": "84157",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਡਿੱਗੇ ਰਣ ਸੁੰਡੀ ਸੁੰਡਾਣੰ ॥",
      "transliteration": "ddi'ge ran su(n)ddee su(n)ddaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ ਵਿੱਚ ਹਾਥੀਆਂ ਦੀਆਂ ਸੁੰਡਾ ਡਿੱਗੀਆਂ ਪਈਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "डिग्गे रण सुँडी सुँडाणं ॥",
      "sourceLineId": "84158",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਧਰ ਭੂਰੰ ਪੂਰੰ ਮੁੰਡਾਣੰ ॥੧੨੭॥",
      "transliteration": "dhar bhoora(n) poora(n) mu(n)ddaana(n) ||127||",
      "translation": "The trunks of the elephants began to fell in the battlefield and the whole earth was filled with hacked heads.127.",
      "punjabiViakhya": "ਅਤੇ ਧਰਤੀ ਸੂਰਮਿਆਂ ਦੇ ਸਿਰਾ ਨਾਲ ਭਰੀ ਹੋਈ ਸੀ ॥੧੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "धर भूरं पूरं मुँडाणं ॥१२७॥",
      "sourceLineId": "84159",
      "sourceShabadId": "7913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਧੁਰ ਧੁਨਿ ਛੰਦ ॥",
      "transliteration": "madhur dhun chha(n)dh ||",
      "translation": "MADHUR DHUN STANZA",
      "punjabiViakhya": "ਮਧੁਰ ਧੁਨਿ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "मधुर धुनि छंद ॥",
      "sourceLineId": "84160",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਰ ਭਰ ਰਾਮੰ ॥",
      "transliteration": "tar bhar raama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ (ਨੇ ਤੀਰਾ ਨਾਲ) ਤਰਥੱਲੀ ਮੱਚਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "तर भर रामं ॥",
      "sourceLineId": "84161",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪਰਹਰ ਕਾਮੰ ॥",
      "transliteration": "parahar kaama(n) ||",
      "translation": "Parashuram, who had abandoned his desires created a sensation in all the four directions,",
      "punjabiViakhya": "(ਫਲਸਰੂਪ ਸੂਰਮਿਆਂ ਨੇ ਜੀਵਨ ਦੀ) ਇੱਛਾ ਛੱਡ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "परहर कामं ॥",
      "sourceLineId": "84162",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਧਰ ਬਰ ਧੀਰੰ ॥",
      "transliteration": "dhar bar dheera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਧੀਰਜ ਤੇ ਬਲ ਧਾਰਨ ਵਾਲੇ",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "धर बर धीरं ॥",
      "sourceLineId": "84163",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪਰਹਰਿ ਤੀਰੰ ॥੧੨੮॥",
      "transliteration": "parahar teera(n) ||128||",
      "translation": "And began to discharge arrows like the brave fighers.128.",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਤੀਰਾ ਨੂੰ ਚਲਾਉਾਂਦੇ ਸਨ ॥੧੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "परहरि तीरं ॥१२८॥",
      "sourceLineId": "84164",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦਰ ਬਰ ਗਯਾਨੰ ॥",
      "transliteration": "dhar bar gayaana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰਸ਼ੂਰਾਮ ਨੂੰ ਵੇਖ ਕੇ) ਸਾਰੇ ਦਲ ਦਾ ਬਲ,",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "दर बर गयानं ॥",
      "sourceLineId": "84165",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪਰ ਹਰਿ ਧਯਾਨੰ ॥",
      "transliteration": "par har dhayaana(n) ||",
      "translation": "Observing his fury, the men of wisdom, meditated on the Lord,",
      "punjabiViakhya": "ਗਿਆਨ ਅਤੇ ਧਿਆਨ ਦੂਰ ਹੋ ਗਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "पर हरि धयानं ॥",
      "sourceLineId": "84166",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਥਰਹਰ ਕੰਪੈ ॥",
      "transliteration": "tharahar ka(n)pai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਥਰ-ਥਰ ਕੰਬ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "थरहर कंपै ॥",
      "sourceLineId": "84167",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਜੰਪੈ ॥੧੨੯॥",
      "transliteration": "har har ja(n)pai ||129||",
      "translation": "And began to repeat the name of Lord, trembling with fear.129.",
      "punjabiViakhya": "ਅਤੇ ਹਰਿ-ਹਰਿ ਜਪਦੇ ਸਨ ॥੧੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "हरि हरि जंपै ॥१२९॥",
      "sourceLineId": "84168",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕ੍ਰੋਧੰ ਗਲਿਤੰ ॥",
      "transliteration": "krodha(n) galita(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ ਆਪਣੇ) ਕ੍ਰੋਧ ਨੂੰ ਪੀ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "क्रोधं गलितं ॥",
      "sourceLineId": "84169",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬੋਧੰ ਦਲਿਤੰ ॥",
      "transliteration": "bodha(n) dhalita(n) ||",
      "translation": "Agonised by extreme rage, the intellect was destroyed.",
      "punjabiViakhya": "ਹੋਸ਼ ਭੁੱਲੀ ਜਾ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "बोधं दलितं ॥",
      "sourceLineId": "84170",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਰ ਸਰ ਸਰਤਾ ॥",
      "transliteration": "kar sar sarataa ||",
      "translation": "",
      "punjabiViakhya": "ਹੱਥਾ ਵਿੱਚ ਤੀਰ ਸਰਕਦੇ ਜਾਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "कर सर सरता ॥",
      "sourceLineId": "84171",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਧਰਮਰ ਹਰਤਾ ॥੧੩੦॥",
      "transliteration": "dharamar harataa ||130||",
      "translation": "A stream of arrows flowed from his hands and with them the life-breath of opponents was removed.130.",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ ਪਰਸੁਰਾਮ ਦੇ ਹੱਥੋਂ) ਧਨੁਸ਼ ਵਾਲਿਆਂ ਜਾ ਧਰਮ ਦੇ ਵੈਰੀਆਂ ਦਾ ਨਾਸ਼ ਹੁੰਦਾ ਜਾ ਰਿਹਾ ਸੀ ॥੧੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "धरमर हरता ॥१३०॥",
      "sourceLineId": "84172",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਰਬਰ ਪਾਣੰ ॥",
      "transliteration": "sarabar paana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ ਆਪਣੇ) ਹੱਥਾ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "सरबर पाणं ॥",
      "sourceLineId": "84173",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਧਰ ਕਰ ਮਾਣੰ ॥",
      "transliteration": "dhar kar maana(n) ||",
      "translation": "Holding their arrows in their hand s and filled with pride,",
      "punjabiViakhya": "ਚੰਗੇ ਤੀਰਾ ਨੂੰ ਕਮਾਨਾ ਵਿੱਚ ਧਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "धर कर माणं ॥",
      "sourceLineId": "84174",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਰ ਉਰ ਸਾਲੀ ॥",
      "transliteration": "ar ur saalee ||",
      "translation": "",
      "punjabiViakhya": "ਵੈਰੀ ਦੀ ਛਾਤੀ ਨੂੰ ਸਲ੍ਰਹ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "अर उर साली ॥",
      "sourceLineId": "84175",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਧਰ ਉਰਿ ਮਾਲੀ ॥੧੩੧॥",
      "transliteration": "dhar ur maalee ||131||",
      "translation": "The warriors are imposing them in the hearts of the enemies like the hoeing of the earth by the gardener.131.",
      "punjabiViakhya": "(ਜਿਸ ਕਰਕੇ ਵੈਰੀ) ਧਰਤੀ ਉੱਤੇ ਪਏ ਛਾਤੀ ਨੂੰ ਮਲ ਰਹੇ ਸਨ ॥੧੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "धर उरि माली ॥१३१॥",
      "sourceLineId": "84176",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਰ ਬਰ ਕੋਪੰ ॥",
      "transliteration": "kar bar kopa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਵਿੱਚ ਭਰੇ (ਬਲਵਾਨ ਪਰਸੁਰਾਮ) ਦੇ ਹੱਥ ਵਿੱਚ",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "कर बर कोपं ॥",
      "sourceLineId": "84177",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0212_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਥਰਹਰ ਧੋਪੰ ॥",
      "transliteration": "tharahar dhopa(n) ||",
      "translation": "All tremble on account of the fury by the warriors and because of their activities in respect of warfare.",
      "punjabiViakhya": "ਪਤਲੀ ਤਲਵਾਰ ਨੂੰ ਥਰਥਰਾਦੇ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 212,
      "hindi": "",
      "hindiTransliteration": "थरहर धोपं ॥",
      "sourceLineId": "84178",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
