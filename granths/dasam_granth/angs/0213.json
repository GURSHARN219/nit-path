{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 213,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0213_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗਰ ਬਰ ਕਰਣੰ ॥",
      "transliteration": "gar bar karana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੰਕਾਰ ਕਰਨ ਵਾਲੇ ਸੂਰਮੇ",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "गर बर करणं ॥",
      "sourceLineId": "84179",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਘਰ ਬਰ ਹਰਣੰ ॥੧੩੨॥",
      "transliteration": "ghar bar harana(n) ||132||",
      "translation": "The masters of the horses were being destroyed.132.",
      "punjabiViakhya": "ਘਬਰਾ ਕੇ ਭੱਜਦੇ ਜਾ ਰਹੇ ਸਨ ॥੧੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "घर बर हरणं ॥१३२॥",
      "sourceLineId": "84180",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਛਰ ਹਰ ਅੰਗੰ ॥",
      "transliteration": "chhar har a(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਹਾੜੇ ਨਾਲ ਸਰੀਰ ਦੇ ਅੰਗਾ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "छर हर अंगं ॥",
      "sourceLineId": "84181",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚਰ ਖਰ ਸੰਗੰ ॥",
      "transliteration": "char khar sa(n)ga(n) ||",
      "translation": "Every limb of the warriors was pierced by arrows,",
      "punjabiViakhya": "ਕੱਟਣ ਵੱਢਣ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "चर खर संगं ॥",
      "sourceLineId": "84182",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਰ ਬਰ ਜਾਮੰ ॥",
      "transliteration": "jar bar jaama(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰਸੁਰਾਮ) ਆਪਣੇ ਜਾਮੇ ਵਿੱਚ ਸੜ ਬਲ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "जर बर जामं ॥",
      "sourceLineId": "84183",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਝਰ ਹਰ ਰਾਮੰ ॥੧੩੩॥",
      "transliteration": "jhar har raama(n) ||133||",
      "translation": "And Parashuram began to shower a volley of his arms.133.",
      "punjabiViakhya": "ਰਾਮ ਨਾਲ ਝਗੜ ਰਿਹਾ ਹੈ ॥੧੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "झर हर रामं ॥१३३॥",
      "sourceLineId": "84184",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਟਰ ਧਰਿ ਜਾਯੰ ॥",
      "transliteration": "Tar dhar jaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ ਭਾਵੇਾਂ ਟਲ ਜਾਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "टर धरि जायं ॥",
      "sourceLineId": "84185",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਠਰ ਹਰਿ ਪਾਯੰ ॥",
      "transliteration": "Thar har paaya(n) ||",
      "translation": "He who advances to that side goes straight to the feet of the Lord (i.e. he is killed).",
      "punjabiViakhya": "(ਪਰ ਉਸ ਦੇ) ਪੈਰ ਟਿਕੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "ठर हरि पायं ॥",
      "sourceLineId": "84186",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਢਰ ਹਰ ਢਾਲੰ ॥",
      "transliteration": "ddar har ddaala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਢਾਲ ਨੂੰ ਖੜਕਾਉਾਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "ढर हर ढालं ॥",
      "sourceLineId": "84187",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਥਰਹਰ ਕਾਲੰ ॥੧੩੪॥",
      "transliteration": "tharahar kaala(n) ||134||",
      "translation": "Hearing the knocks on the shields, the god of death came down.134.",
      "punjabiViakhya": "ਅਤੇ ਕਾਲ ਵਾਗ ਕ੍ਰੋਧ ਨਾਲ ਕੰਬ ਰਿਹਾ ਸੀ ॥੧੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "थरहर कालं ॥१३४॥",
      "sourceLineId": "84188",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਰ ਬਰ ਦਰਣੰ ॥",
      "transliteration": "ar bar dharana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਲਵਾਨ ਵੈਰੀਆਂ ਨੂੰ ਦਲਣ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "अर बर दरणं ॥",
      "sourceLineId": "84189",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਰ ਬਰ ਹਰਣੰ ॥",
      "transliteration": "nar bar harana(n) ||",
      "translation": "The superb enemies were killed and the eminent men were destroyed.",
      "punjabiViakhya": "ਅਤੇ ਰਾਜਿਆਂ ਨੂੰ ਮਾਰਨ ਵਾਲਾ ਬਲ",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "नर बर हरणं ॥",
      "sourceLineId": "84190",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਧਰ ਬਰ ਧੀਰੰ ॥",
      "transliteration": "dhar bar dheera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਧੀਰਜ ਧਾਰਨ ਕਰਨ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "धर बर धीरं ॥",
      "sourceLineId": "84191",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਫਰ ਹਰ ਤੀਰੰ ॥੧੩੫॥",
      "transliteration": "far har teera(n) ||135||",
      "translation": "On the bodies of the enduring warriors, the arrows waved.135.",
      "punjabiViakhya": "(ਪਰਸੁਰਾਮ) ਤੀਰ ਨੂੰ ਘੁੰਮਾ ਰਿਹਾ ਸੀ ॥੧੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "फर हर तीरं ॥१३५॥",
      "sourceLineId": "84192",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਰ ਨਰ ਦਰਣੰ ॥",
      "transliteration": "bar nar dharana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੇਸ਼ਠ ਸੂਰਮਿਆਂ ਨੂੰ ਦਲਣ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "बर नर दरणं ॥",
      "sourceLineId": "84193",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭਰ ਹਰ ਕਰਣੰ ॥",
      "transliteration": "bhar har karana(n) ||",
      "translation": "The eminent persons were destroyed and the remaining sped away.",
      "punjabiViakhya": "ਅਤੇ ਭਿਆਨਕ ਕੰਮ ਕਰਨ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "भर हर करणं ॥",
      "sourceLineId": "84194",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਰ ਹਰ ਰੜਤਾ ॥",
      "transliteration": "har har raRataa ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰਸੁਰਾਮ) ਹਰ ਹਰ ਬੋਲਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "हर हर रड़ता ॥",
      "sourceLineId": "84195",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਰ ਹਰ ਗੜਤਾ ॥੧੩੬॥",
      "transliteration": "bar har gaRataa ||136||",
      "translation": "The repeated Shiva’s name and created confusion.136.",
      "punjabiViakhya": "ਅਤੇ ਤਰਥੱਲੀ ਮਚਾਉਾਂਦਾ ਸੀ ॥੧੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "बर हर गड़ता ॥१३६॥",
      "sourceLineId": "84196",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਰਬਰ ਹਰਤਾ ॥",
      "transliteration": "sarabar harataa ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੇਸ਼ਠ ਤੀਰ ਅੰਦਾਜ਼ਾ (ਛਤ੍ਰੀਆਂ) ਨੂੰ ਮਾਰਨ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "सरबर हरता ॥",
      "sourceLineId": "84197",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚਰਮਰਿ ਧਰਤਾ ॥",
      "transliteration": "charamar dharataa ||",
      "translation": "Parashuram, the wielder of axe,",
      "punjabiViakhya": "(ਪਰਸੁਰਾਮ) ਕੁਹਾੜਾ ਚੁੱਕੀ ਫਿਰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "चरमरि धरता ॥",
      "sourceLineId": "84198",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਰਮਰਿ ਪਾਣੰ ॥",
      "transliteration": "baramar paana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੱਥਾ ਵਿੱਚ ਕੁਹਾੜਾ ਲੈ ਕੇ (ਵੈਰੀਆਂ ਨੂੰ) ਮਾਰ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "बरमरि पाणं ॥",
      "sourceLineId": "84199",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਰਬਰ ਜਾਣੰ ॥੧੩੭॥",
      "transliteration": "karabar jaana(n) ||137||",
      "translation": "Had power of to destroy all in the war, his arms were long.137.",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਹੱਥ ਗੋਡਿਆਂ ਤਕ ਪਹੁੰਚਦੇ ਸਨ ॥੧੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "करबर जाणं ॥१३७॥",
      "sourceLineId": "84200",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਰਬਰਿ ਹਾਰੰ ॥",
      "transliteration": "harabar haara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹਰ ਇਕ ਦੋ ਬਲ ਨੂੰ ਹਰਨ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "हरबरि हारं ॥",
      "sourceLineId": "84201",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0213_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਰ ਬਰ ਬਾਰੰ ॥",
      "transliteration": "kar bar baara(n) ||",
      "translation": "The brave fighters struck blows and the rosary of skulls on the neck of Shiva looked impressive.",
      "punjabiViakhya": "ਅਤੇ ਬਲ ਪੂਰਵਕ ਵਾਰ ਕਰਨ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 213,
      "hindi": "",
      "hindiTransliteration": "कर बर बारं ॥",
      "sourceLineId": "84202",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
