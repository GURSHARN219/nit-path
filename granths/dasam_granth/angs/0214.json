{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 214,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0214_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗਡਬਡ ਰਾਮੰ ॥",
      "transliteration": "gaddabadd raama(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰਸੁ) ਰਾਮ ਰੌਲਾ ਪਾਣ",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "गडबड रामं ॥",
      "sourceLineId": "84203",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗੜਬੜ ਧਾਮੰ ॥੧੩੮॥",
      "transliteration": "gaRabaR dhaama(n) ||138||",
      "translation": "Ram stood firmly and within the whole place, there was turmoil.138.",
      "punjabiViakhya": "ਅਤੇ ਖਲਬਲੀ ਮਚਾਣ ਵਾਲਾ ਸੀ ॥੧੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "गड़बड़ धामं ॥१३८॥",
      "sourceLineId": "84204",
      "sourceShabadId": "7914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚਰਪਟ ਛੀਗਾ ਕੇ ਆਦਿ ਕ੍ਰਿਤ ਛੰਦ ॥",
      "transliteration": "charapaT chheegaa ke aadh kirat chha(n)dh ||",
      "translation": "CHARPAT CHHIGA KE AAD KRIT STANZA",
      "punjabiViakhya": "ਚਰਪਟ ਛੀਗਾ ਕੇ ਆਦਿ ਕ੍ਰਿਤ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "चरपट छीगा के आदि कृत छंद ॥",
      "sourceLineId": "84205",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਖੱਗ ਖਯਾਤਾ ॥",
      "transliteration": "kha'g khayaataa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਤਲਵਾਰ ਨੂੰ ਚਮਕਾਉਣ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "खग्ग खयाता ॥",
      "sourceLineId": "84206",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗਯਾਨ ਗਯਾਤਾ ॥",
      "transliteration": "gayaan gayaataa ||",
      "translation": "In the use of the sword the noteworthy and greatly wise persons are being seen.",
      "punjabiViakhya": "ਤੇ ਗਿਆਨ ਨੂੰ ਜਾਣਨ ਵਾਲਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "गयान गयाता ॥",
      "sourceLineId": "84207",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚਿੱਤ੍ਰ ਬਰਮਾ ॥",
      "transliteration": "chi'tr baramaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਵਿਚਿਤ੍ਰ ਕਵਚ ਧਾਰਨ ਕੀਤਾ ਹੋਇਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "चित्त्र बरमा ॥",
      "sourceLineId": "84208",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚਾਰ ਚਰਮਾ ॥੧੩੯॥",
      "transliteration": "chaar charamaa ||139||",
      "translation": "Those with beautiful bodies are wearing armours which seen like portraits.139.",
      "punjabiViakhya": "ਅਤੇ ਸੁੰਦਰ ਢਾਲ ਵਾਲਾ ਸੀ ॥੧੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "चार चरमा ॥१३९॥",
      "sourceLineId": "84209",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਾਸਤ੍ਰੰ ਗਯਾਤਾ ॥",
      "transliteration": "saasatra(n) gayaataa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸ਼ਾਸਤ੍ਰਾ ਨੂੰ ਜਾਣਨ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "सासत्रं गयाता ॥",
      "sourceLineId": "84210",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਸਤ੍ਰੰ ਖਯਾਤਾ ॥",
      "transliteration": "sasatra(n) khayaataa ||",
      "translation": "Those who are specialists in arm and scholars of Shastras",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰ ਨੂੰ ਚਮਕਾਉਣ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "ससत्रं खयाता ॥",
      "sourceLineId": "84211",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚਿਤ੍ਰੰ ਜੋਧੀ ॥",
      "transliteration": "chitra(n) jodhee ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਚਿਤ੍ਰ ਸੂਰਮਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "चित्रं जोधी ॥",
      "sourceLineId": "84212",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੁੱਧੰ ਕ੍ਰੋਧੀ ॥੧੪੦॥",
      "transliteration": "ju'dha(n) krodhee ||140||",
      "translation": "And also the famous warriors are busy in warfare in great rage.140.",
      "punjabiViakhya": "ਅਤੇ ਯੁੱਧ ਵਿੱਚ ਕ੍ਰੋਧ ਕਰਨ ਵਾਲਾ ਸੀ ॥੧੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "जुद्धं क्रोधी ॥१४०॥",
      "sourceLineId": "84213",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬੀਰੰ ਬਰਣੰ ॥",
      "transliteration": "beera(n) barana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬੀਰਾ ਨੂੰ ਘਾਇਲ (ਬਰਣੰ) ਕਰਨ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "बीरं बरणं ॥",
      "sourceLineId": "84214",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭੀਰੰ ਭਰਣੰ ॥",
      "transliteration": "bheera(n) bharana(n) ||",
      "translation": "The eminent warriors are filling others with fear",
      "punjabiViakhya": "ਰਣ ਵਿੱਚ) ਕਾਇਰਾ ਨੂੰ ਭੈ ਦੇਣ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "भीरं भरणं ॥",
      "sourceLineId": "84215",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਤ੍ਰੰ ਹਰਤਾ ॥",
      "transliteration": "satra(n) harataa ||",
      "translation": "",
      "punjabiViakhya": "ਵੈਰੀਆਂ ਨੂੰ ਮਾਰਨ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "सत्रं हरता ॥",
      "sourceLineId": "84216",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅੱਤ੍ਰੰ ਧਰਤਾ ॥੧੪੧॥",
      "transliteration": "a'tra(n) dharataa ||141||",
      "translation": "Wearing their arms they are destroying the enemies.141.",
      "punjabiViakhya": "ਅਤੇ ਅਸਤ੍ਰਾ ਨੂੰ ਧਾਰਨ ਕਰਨ ਵਾਲਾ ਸੀ ॥੧੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "अत्त्रं धरता ॥१४१॥",
      "sourceLineId": "84217",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਰਮੰ ਬੇਧੀ ॥",
      "transliteration": "barama(n) bedhee ||",
      "translation": "",
      "punjabiViakhya": "ਕਵਚਾ ਨੂੰ ਭੰਨਣ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "बरमं बेधी ॥",
      "sourceLineId": "84218",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚਰਮੰ ਛੇਦੀ ॥",
      "transliteration": "charama(n) chhedhee ||",
      "translation": "The brave fighters piercing the armours are boring the bodies",
      "punjabiViakhya": "ਢਾਲਾ ਨੂੰ ਛੇਦਣ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "चरमं छेदी ॥",
      "sourceLineId": "84219",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਛੱਤ੍ਰੰ ਹੰਤਾ ॥",
      "transliteration": "chha'tra(n) ha(n)taa ||",
      "translation": "",
      "punjabiViakhya": "ਛਤ੍ਰੀਆਂ ਨੂੰ ਮਾਰਨ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "छत्त्रं हंता ॥",
      "sourceLineId": "84220",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅੱਤ੍ਰੰ ਗੰਤਾ ॥੧੪੨॥",
      "transliteration": "a'tra(n) ga(n)taa ||142||",
      "translation": "With the use of arms, the canopies of the kings are being destroyed.142.",
      "punjabiViakhya": "ਅਤੇ ਅਸਤ੍ਰਾ ਨੂੰ ਜਾਣਨ ਵਾਲਾ ਸੀ ॥੧੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "अत्त्रं गंता ॥१४२॥",
      "sourceLineId": "84221",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੁਧੰ ਧਾਮੀ ॥",
      "transliteration": "judha(n) dhaamee ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਕਰਨ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "जुधं धामी ॥",
      "sourceLineId": "84222",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬੁਧੰ ਗਾਮੀ ॥",
      "transliteration": "budha(n) gaamee ||",
      "translation": "Those who marched towards the battlefield,",
      "punjabiViakhya": "ਬੁੱਧ ਨੂੰ ਪਹੁੰਚਣ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "बुधं गामी ॥",
      "sourceLineId": "84223",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਸਤ੍ਰੰ ਖਯਾਤਾ ॥",
      "transliteration": "sasatra(n) khayaataa ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰ ਨੂੰ ਵਰਤਣ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "ससत्रं खयाता ॥",
      "sourceLineId": "84224",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਸਤ੍ਰੰ ਗਯਾਤਾ ॥੧੪੩॥",
      "transliteration": "asatra(n) gayaataa ||143||",
      "translation": "They know the secrets of arms and wepons.143.",
      "punjabiViakhya": "ਅਤੇ ਅਸਤ੍ਰ ਦੇ ਭੇਦ ਜਾਣਨ ਵਾਲਾ ਸੀ ॥੧੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "असत्रं गयाता ॥१४३॥",
      "sourceLineId": "84225",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜੁੱਧਾ ਮਾਲੀ ॥",
      "transliteration": "ju'dhaa maalee ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰਸੁਰਾਮ) ਯੁੱਧ ਨੂੰ ਜਿੱਤਣ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "जुद्धा माली ॥",
      "sourceLineId": "84226",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕੀਰਤ ਸਾਲੀ ॥",
      "transliteration": "keerat saalee ||",
      "translation": "The warriors wandered in the battlefield like the gardeners of the forest who prune the plants, they began to destroy the reputation of the heroes.",
      "punjabiViakhya": "ਕੀਰਤੀ ਦੇ ਸਥਾਨ",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "कीरत साली ॥",
      "sourceLineId": "84227",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਧਰਮੰ ਧਾਮੰ ॥",
      "transliteration": "dharama(n) dhaama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਧਰਮ ਦੇ ਘਰ ਵਾਲੇ",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "धरमं धामं ॥",
      "sourceLineId": "84228",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰੂਪੰ ਰਾਮੰ ॥੧੪੪॥",
      "transliteration": "roopa(n) raama(n) ||144||",
      "translation": "In that battlefield the beautiful Ram, who is the abode of righteousness is looking glorious.144.",
      "punjabiViakhya": "ਰੂਪ ਵਾਲਾ ਸੀ ॥੧੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "रूपं रामं ॥१४४॥",
      "sourceLineId": "84229",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਧੀਰੰ ਧਰਤਾ ॥",
      "transliteration": "dheera(n) dharataa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਧੀਰਜ ਨੂੰ ਧਾਰਨ ਕਰਨ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "धीरं धरता ॥",
      "sourceLineId": "84230",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬੀਰੰ ਹਰਤਾ ॥",
      "transliteration": "beera(n) harataa ||",
      "translation": "He is a hero with the quality of forbearance, he is the destroyer of warriors",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਨੂੰ ਮਾਰਨ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "बीरं हरता ॥",
      "sourceLineId": "84231",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜੁੱਧੰ ਜੇਤਾ ॥",
      "transliteration": "ju'dha(n) jetaa ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਨੂੰ ਜਿੱਤਣ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "जुद्धं जेता ॥",
      "sourceLineId": "84232",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਸਤ੍ਰੰ ਨੇਤਾ ॥੧੪੫॥",
      "transliteration": "sasatra(n) netaa ||145||",
      "translation": "Conqueror of war and eminently specialist in the use of weapons.145.",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਸਤ੍ਰਾ ਨੂੰ ਵਰਤਣ ਵਾਲਾ ਸੀ ॥੧੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "ससत्रं नेता ॥१४५॥",
      "sourceLineId": "84233",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੁਰਦੰ ਗਾਮੀ ॥",
      "transliteration": "dhuradha(n) gaamee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਹਾਥੀਆਂ ਵਾਗ ਚੱਲਣ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "दुरदं गामी ॥",
      "sourceLineId": "84234",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਧਰਮੰ ਧਾਮੀ ॥",
      "transliteration": "dharama(n) dhaamee ||",
      "translation": "He has the gait of an elephant and an abode of Dharma",
      "punjabiViakhya": "ਧਰਮ ਦਾ ਘਰ,",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "धरमं धामी ॥",
      "sourceLineId": "84235",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜੋਗੰ ਜ੍ਵਾਲੀ ॥",
      "transliteration": "joga(n) javaiaalee ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਗ ਦੀ ਅਗਨੀ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "जोगं ज्वाली ॥",
      "sourceLineId": "84236",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜੋਤੰ ਮਾਲੀ ॥੧੪੬॥",
      "transliteration": "jota(n) maalee ||146||",
      "translation": "He is the master of yoga-fire and protector of the supreme light.146.",
      "punjabiViakhya": "ਅਤੇ ਤੇਜ਼ ਪ੍ਰਕਾਸ਼ ਵਾਲਾ ਸੀ ॥੧੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "जोतं माली ॥१४६॥",
      "sourceLineId": "84237",
      "sourceShabadId": "7915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪਰਸੁਰਾਮ ਬਾਚ ॥",
      "transliteration": "parasuraam baach ||",
      "translation": "The Speech of Parachuram :",
      "punjabiViakhya": "ਪਰਸੁਰਾਮ ਨੇ ਕਿਹਾ-",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "परसुराम बाच ॥",
      "sourceLineId": "84238",
      "sourceShabadId": "7916",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸ੍ਵੈਯਾ ॥",
      "transliteration": "savaiyaa ||",
      "translation": "SWAYYA",
      "punjabiViakhya": "ਸ੍ਵੈਯਾ",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "स्वैया ॥",
      "sourceLineId": "84239",
      "sourceShabadId": "7916",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤੂਣਿ ਕਸੇ ਕਟ ਚਾਪ ਧਰੇ ਕਰ ਕੋਪ ਕਹੀ ਦਿਜ ਰਾਮ ਅਹੋ ॥",
      "transliteration": "toon kase kaT chaap dhare kar kop kahee dhij raam aho ||",
      "translation": "Wearnig his bow and quiver, the Brahmin Parshuram in great rage said to Ram :",
      "punjabiViakhya": "ਲਕ ਨਾਲ ਭੱਥਾ ਬੰਨ੍ਰਹੇ ਹੋਏ ਅਤੇ ਹੱਥ ਵਿੱਚ ਧਨੁਸ਼ ਫੜੇ ਹੋਏ (ਰਾਮ ਨੂੰ) ਪਰਸੁਰਾਮ ਬ੍ਰਾਹਮਣ ਨੇ ਕ੍ਰੋਧ ਨਾਲ ਕਿਹਾ-ਹੇ ਰਾਮ!",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "तूणि कसे कट चाप धरे कर कोप कही दिज राम अहो ॥",
      "sourceLineId": "84240",
      "sourceShabadId": "7916",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗ੍ਰਹ ਤੋਰਿ ਸਰਾਸਨ ਸੰਕਰ ਕੋ ਸੀਅ ਜਾਤ ਹਰੇ ਤੁਮ ਕਉਨ ਕਹੋ ॥",
      "transliteration": "greh tor saraasan sa(n)kar ko seea jaat hare tum kaun kaho ||",
      "translation": "“O the breaker of the bow of Shiva and the conqueror of Sita, who ate you?",
      "punjabiViakhya": "ਘਰ ਵਿੱਚ ਪਏ ਹੋਏ ਸ਼ਿਵ ਧਨੁਸ਼ ਨੂੰ ਤੋੜ ਕੇ, ਸੀਤਾ ਨੂੰ ਲਈ ਜਾਣ ਵਾਲਾ, ਦਸ ਤੂੰ ਕੌਣ ਹੈਂ?",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "ग्रह तोरि सरासन संकर को सीअ जात हरे तुम कउन कहो ॥",
      "sourceLineId": "84241",
      "sourceShabadId": "7916",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਿਨ ਸਾਚ ਕਹੇ ਨੇਹੀ ਪ੍ਰਾਨ ਬਚੇ ਜਿਨਿ ਕੰਠ ਕੁਠਾਰ ਕੀ ਧਾਰ ਸਹੋ ॥",
      "transliteration": "bin saach kahe nehee praan bache jin ka(n)Th kuThaar kee dhaar saho ||",
      "translation": "“Tell me the truth otherwise you will not he able to save yourself and you will have to bear the blow of the sharp edge of my axe on your neck.",
      "punjabiViakhya": "ਸੱਚ ਦੱਸੇ ਬਿਨਾ ਤੇਰੇ ਪ੍ਰਾਣ ਨਹੀਂ ਬਚਣਗੇ। ਨਹੀਂ ਤਾ ਗਲੇ ਉੱਤੇ (ਮੇਰੇ) ਕੁਹਾੜੇ ਦੀ ਧਾਰ ਸਹਾਰ ਲੈ।",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "बिन साच कहे नेही प्रान बचे जिनि कंठ कुठार की धार सहो ॥",
      "sourceLineId": "84242",
      "sourceShabadId": "7916",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਘਰ ਜਾਹੁ ਚਲੇ ਤਜ ਰਾਮ ਰਣੰ ਜਿਨਿ ਜੂਝਿ ਮਰੋ ਪਲ ਠਾਢ ਰਹੋ ॥੧੪੭॥",
      "transliteration": "ghar jaahu chale taj raam rana(n) jin joojh maro pal Thaadd raho ||147||",
      "translation": "“It will be appropriate, if you leave the war-arena and run away to your home, otherwise if you stay here for another instant, you will have to die.”147.",
      "punjabiViakhya": "ਹੇ ਰਾਮ! ਰਣ ਨੂੰ ਛੱਡ ਕੇ ਘਰ ਨੂੰ ਚਲਿਆ ਜਾ। ਜੇ ਇਕ ਪਲ ਵੀ ਖੜਾ ਰਿਹਾ, ਤਾ ਮਾਰਿਆ ਜਾਵੇਾਂਗਾ ॥੧੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "घर जाहु चले तज राम रणं जिनि जूझि मरो पल ठाढ रहो ॥१४७॥",
      "sourceLineId": "84243",
      "sourceShabadId": "7916",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸ੍ਵੈਯਾ ॥",
      "transliteration": "savaiyaa ||",
      "translation": "SWAYYA",
      "punjabiViakhya": "ਸ੍ਵੈਯਾ",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "स्वैया ॥",
      "sourceLineId": "84244",
      "sourceShabadId": "7917",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਾਨਤ ਹੋ ਅਵਿਲੋਕ ਮੁਝੈ ਹਠਿ ਏਕ ਬਲੀ ਨਹੀ ਠਾਢ ਰਹੈਂਗੇ ॥",
      "transliteration": "jaanat ho avilok mujhai haTh ek balee nahee Thaadd rahai(n)ge ||",
      "translation": "“You know that no mighty warrior can stay here firmly on seeing me",
      "punjabiViakhya": "ਇਹ (ਮੈਂ) ਜਾਣਦਾ ਹਾ ਕਿ ਮੈਨੂੰ ਵੇਖ ਕੇ ਹਠੀ ਜਾ ਬਲੀ, ਇਕ ਵੀ (ਰਣ-ਭੂਮੀ ਵਿੱਚ) ਖੜੋਤਾ ਨਹੀਂ ਰਹੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "जानत हो अविलोक मुझै हठि एक बली नही ठाढ रहैंगे ॥",
      "sourceLineId": "84245",
      "sourceShabadId": "7917",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਾਤਿ ਗਹਯੋ ਜਿਨ ਕੋ ਤ੍ਰਿਣ ਦਾਤਨ ਤੇਨ ਕਹਾ ਰਣ ਆਜ ਗਹੈਂਗੇ ॥",
      "transliteration": "taat gahayo jin ko tiran dhaatan ten kahaa ran aaj gahai(n)ge ||",
      "translation": "“Those whose fathers and grandfathers held the blades of grass within their teeth on seeing me (i.e. they accepted defeat) what type of war will they wage with me now?",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦੇ ਬਾਪ ਨੇ ਦੰਦਾ ਵਿੱਚ ਘਾਹ ਲੈ ਕੇ (ਜਾਨ ਬਖ਼ਸ਼ਵਾਈ ਸੀ), ਕੀ ਉਸ ਦਾ (ਪੁੱਤਰ) ਅਜ (ਮੇਰੇ ਨਾਲ ਯੁੱਧ ਕਰਨ ਲਈ ਹਥਿਆਰ) ਫੜ ਸਕੇਗਾ?",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "ताति गहयो जिन को तृण दातन तेन कहा रण आज गहैंगे ॥",
      "sourceLineId": "84246",
      "sourceShabadId": "7917",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬੰਬ ਬਜੇ ਰਣ ਖੰਡ ਗਡੇ ਗਹਿ ਹਾਥ ਹਥਿਆਰ ਕਹੂੰ ਉਮਹੈਂਗੇ ॥",
      "transliteration": "ba(n)b baje ran kha(n)dd gadde geh haath hathiaar kahoo(n) umahai(n)ge ||",
      "translation": "“Even if there is waged a terrible war how can they be bold enough now to march forward for war by taking hold of their weapons again?",
      "punjabiViakhya": "(ਜਦੋਂ) ਧੌਂਸਾ ਵੱਜੇਗਾ ਤੇ ਰਣ ਵਿੱਚ (ਪਰਸੁਰਾਮ) ਖੰਭੇ ਵਾਗ ਗਡਿਆ ਜਾਵੇਗਾ। (ਤਦੋਂ) ਹੱਥ ਵਿੱਚ ਹਥਿਆਰ ਫੜਨ ਦੀ ਉਮੰਗ ਕਿਸ ਨੂੰ ਹੋਵੇਗੀ?",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "बंब बजे रण खंड गडे गहि हाथ हथिआर कहूँ उमहैंगे ॥",
      "sourceLineId": "84247",
      "sourceShabadId": "7917",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭੂਮ ਅਕਾਸ ਪਤਾਲ ਦੁਰੈਬੇ ਕਉ ਰਾਮ ਕਹੋ ਕਹਾ ਠਾਮ ਲਹੈਂਗੇ ॥੧੪੮॥",
      "transliteration": "bhoom akaas pataal dhuraibe kau raam kaho kahaa Thaam lahai(n)ge ||148||",
      "translation": "“Then tell me, O Ram, where will you find a place one earth, sky or netherworld to hide yourself?”148.",
      "punjabiViakhya": "ਹੇ ਰਾਮ! ਦਸ, ਉਸ ਵੇਲੇ ਲੁਕਣ ਵਾਸਤੇ ਧਰਤੀ, ਆਕਾਸ਼ ਪਾਤਾਲ ਵਿੱਚ ਕਿਥੋਂ ਥਾ ਲਭੇਾਂਗਾ ॥੧੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "भूम अकास पताल दुरैबे कउ राम कहो कहा ठाम लहैंगे ॥१४८॥",
      "sourceLineId": "84248",
      "sourceShabadId": "7917",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਬਿ ਬਾਚ ॥",
      "transliteration": "kab baach ||",
      "translation": "Speech of the Poet:",
      "punjabiViakhya": "ਕਵੀ ਕਹਿੰਦਾ ਹੈ-",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "कबि बाच ॥",
      "sourceLineId": "84249",
      "sourceShabadId": "7918",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0214_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਯੌ ਜਬ ਬੈਨ ਸੁਨੇ ਅਰਿ ਕੇ ਤਬ ਸ੍ਰੀ ਰਘੁਬੀਰ ਬਲੀ ਬਲਕਾਨੇ ॥",
      "transliteration": "yau jab bain sune ar ke tab sree raghubeer balee balakaane ||",
      "translation": "Hearing these words of the enemy (Parashuram), Ram looked like a mighty hero.",
      "punjabiViakhya": "ਜਦੋਂ ਵੈਰੀ ਦੇ ਇਸ ਤਰ੍ਰਹਾ ਦੇ ਬੋਲ ਸੁਣੇ ਤਦੋਂ ਸ੍ਰੀ ਰਾਮ ਸੂਰਮੇ ਵਾਗ ਉਛਲ ਕੇ ਅੱਗੇ ਆਏ।",
      "source": "DASAM_GRANTH",
      "ang": 214,
      "hindi": "",
      "hindiTransliteration": "यौ जब बैन सुने अरि के तब स्री रघुबीर बली बलकाने ॥",
      "sourceLineId": "84250",
      "sourceShabadId": "7918",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
