{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 216,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0216_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਮ ਸੀਆ ਬਰ ਕੈ ਘਰਿ ਆਏ ॥",
      "transliteration": "raam seeaa bar kai ghar aae ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਸੀਤਾ ਨੂੰ ਵਿਆਹ ਕੇ ਘਰ ਆਏ।",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "राम सीआ बर कै घरि आए ॥",
      "sourceLineId": "84299",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੇਸ ਬਿਦੇਸਨ ਹੋਤ ਬਧਾਏ ॥੧੫੮॥",
      "transliteration": "dhes bidhesan hot badhaae ||158||",
      "translation": "After the marriage of Ram and Sita, the congratulatory messages were received from various countries, when they returned to their home.158.",
      "punjabiViakhya": "ਦੇਸ਼ਾ ਪਰਦੇਸਾ ਵਿੱਚ ਵਧਾਈ ਦਾ ਮਾਹੌਲ ਬਣ ਗਿਆ ॥੧੫੮॥",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "देस बिदेसन होत बधाए ॥१५८॥",
      "sourceLineId": "84300",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਹ ਤਹ ਹੋਤ ਉਛਾਹ ਅਪਾਰੂ ॥",
      "transliteration": "jeh teh hot uchhaeh apaaroo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ-ਕਿਥੇ ਬਹੁਤ ਉਤਸ਼ਾਹ ਦਿਸ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "जह तह होत उछाह अपारू ॥",
      "sourceLineId": "84301",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਿਹੂੰ ਸੁਤਨ ਕੋ ਬਯਾਹ ਬਿਚਾਰੂ ॥",
      "transliteration": "tihoo(n) sutan ko bayaeh bichaaroo ||",
      "translation": "There was atmosphere of zest on all sides and the arrangements were being made for the celebration of the marriage of three sons.",
      "punjabiViakhya": "(ਹਰ ਪਾਸੇ ਰਾਜੇ ਦੇ) ਤਿੰਨਾ ਪੁੱਤਰਾ ਦੇ ਵਿਆਹ ਦਾ ਹੀ ਵਿਚਾਰ ਹੋ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "तिहूँ सुतन को बयाह बिचारू ॥",
      "sourceLineId": "84302",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਾਜਤ ਤਾਲ ਮ੍ਰਿਦੰਗ ਅਪਾਰੰ ॥",
      "transliteration": "baajat taal miradha(n)g apaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਪਾਰ ਤਾਲ ਅਤੇ ਮ੍ਰਿਦੰਗ ਵੱਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "बाजत ताल मृदंग अपारं ॥",
      "sourceLineId": "84303",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾਚਤ ਕੋਟਨ ਕੋਟ ਅਖਾਰੰ ॥੧੫੯॥",
      "transliteration": "naachat koTan koT akhaara(n) ||159||",
      "translation": "On all sides the drums resounded in various tunes and many companies of dancers began to dance.159.",
      "punjabiViakhya": "ਬਹੁਤ ਅਧਿਕ ਨਾਚ-ਮੰਡਲੀਆਂ ਨਾਚ ਕਰ ਰਹੀਆਂ ਸਨ ॥੧੫੯॥",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "नाचत कोटन कोट अखारं ॥१५९॥",
      "sourceLineId": "84304",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਨਿ ਬਨਿ ਬੀਰ ਪਖਰੀਆ ਚਲੇ ॥",
      "transliteration": "ban ban beer pakhareeaa chale ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜ-ਸਵਾਰ ਸੂਰਮੇ ਸਜ-ਸਜ ਕੇ ਜਾ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "बनि बनि बीर पखरीआ चले ॥",
      "sourceLineId": "84305",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੋਬਨਵੰਤ ਸਿਪਾਹੀ ਭਲੇ ॥",
      "transliteration": "jobanava(n)t sipaahee bhale ||",
      "translation": "The warriors decorated with armours and the youthful soldiers marched forward.",
      "punjabiViakhya": "ਜੇ ਜਵਾਨ ਚੰਗੇ ਸਿਪਾਹੀ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "जोबनवंत सिपाही भले ॥",
      "sourceLineId": "84306",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭਏ ਜਾਇ ਇਸਥਤ ਨ੍ਰਿਪ ਦਰ ਪਰ ॥",
      "transliteration": "bhe jai isathat nirap dhar par ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦਸ਼ਰਥ ਦੇ ਦੁਆਰ 'ਤੇ ਜਾ ਪਹੁੰਚੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "भए जाइ इसथत नृप दर पर ॥",
      "sourceLineId": "84307",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਹਾਰਥੀ ਅਰੁ ਮਹਾ ਧਨੁਰਧਰ ॥੧੬੦॥",
      "transliteration": "mahaarathee ar mahaa dhanuradhar ||160||",
      "translation": "All these great charioteers and archers came and stood at the gate of the king Dasrath.160.",
      "punjabiViakhya": "ਮਹਾਰਥੀ ਅਤੇ ਵੱਡੇ ਧਨੁਸ਼ ਧਾਰੀ ॥੧੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "महारथी अरु महा धनुरधर ॥१६०॥",
      "sourceLineId": "84308",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਾਜਤ ਜੰਗ ਮੁਚੰਗ ਅਪਾਰੰ ॥",
      "transliteration": "baajat ja(n)g mucha(n)g apaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਾਰਾ ਹੀ ਟਲ ('ਜੰਗ') ਅਤੇ ਮੁਚੰਗ ਵੱਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "बाजत जंग मुचंग अपारं ॥",
      "sourceLineId": "84309",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਢੋਲ ਮ੍ਰਿਦੰਗ ਸੁਰੰਗ ਸੁਧਾਰੰ ॥",
      "transliteration": "ddol miradha(n)g sura(n)g sudhaara(n) ||",
      "translation": "Many types of musical instruments resounded and the melodious sounds of the drums were heard.",
      "punjabiViakhya": "ਢੋਲ, ਮ੍ਰਿਦੰਗ ਤੇ ਸੁਰੰਗ (ਦੀ ਸੁਰ ਵੀ) ਮਿਲਾਈ ਜਾ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "ढोल मृदंग सुरंग सुधारं ॥",
      "sourceLineId": "84310",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗਾਵਤ ਗੀਤ ਚੰਚਲਾ ਨਾਰੀ ॥",
      "transliteration": "gaavat geet cha(n)chalaa naaree ||",
      "translation": "",
      "punjabiViakhya": "ਵੇਸ਼ਿਆਵਾ ਗੀਤ ਗਾ ਰਹੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "गावत गीत चंचला नारी ॥",
      "sourceLineId": "84311",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨੈਨ ਨਚਾਇ ਬਜਾਵਤ ਤਾਰੀ ॥੧੬੧॥",
      "transliteration": "nain nachai bajaavat taaree ||161||",
      "translation": "The energetic women began to sing and reveal their joy by dancing their eyes and clapping their hands.161.",
      "punjabiViakhya": "ਅਤੇ ਨੈਣਾ ਨੂੰ ਮਟਕਾ ਕੇ ਹੱਥਾ ਦੀ ਤਾੜੀ ਵਜਾ ਰਹੀਆਂ ਸਨ ॥੧੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "नैन नचाइ बजावत तारी ॥१६१॥",
      "sourceLineId": "84312",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਿੱਛਕਨ ਹਵਸ ਨ ਧਨ ਕੀ ਰਹੀ ॥",
      "transliteration": "bhi'chhakan havas na dhan kee rahee ||",
      "translation": "",
      "punjabiViakhya": "ਮੰਗਤਿਆਂ ਨੂੰ ਧਨ ਦੀ ਇੱਛਾ ਨ ਰਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "भिच्छकन हवस न धन की रही ॥",
      "sourceLineId": "84313",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦਾਨ ਸ੍ਵਰਨ ਸਰਤਾ ਹੁਇ ਬਹੀ ॥",
      "transliteration": "dhaan savairan sarataa hui bahee ||",
      "translation": "The beggars had no more desire for wealth because the gift of gold flowed like a stream.",
      "punjabiViakhya": "ਸੋਨੇ ਦੇ ਦਾਨ ਦੀ ਮਾਨੋ ਨਦੀ ਵਗ ਰਹੀ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "दान स्वरन सरता हुइ बही ॥",
      "sourceLineId": "84314",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਏਕ ਬਾਤ ਮਾਗਨ ਕੱਉ ਆਵੈ ॥",
      "transliteration": "ek baat maagan ka'au aavai ||",
      "translation": "",
      "punjabiViakhya": "(ਜੇ ਕੋਈ) ਇਕ ਚੀਜ਼ ਮੰਗਣ ਲਈ ਆਉਾਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "एक बात मागन कउ्उ आवै ॥",
      "sourceLineId": "84315",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬੀਸਕ ਬਾਤ ਘਰੈ ਲੈ ਜਾਵੈ ॥੧੬੨॥",
      "transliteration": "beesak baat gharai lai jaavai ||162||",
      "translation": "Anyone who asked for one thing, he would return to his home with twenty things.162.",
      "punjabiViakhya": "ਤਾ ਉਹ ਵੀਹ ਚੀਜ਼ਾ ਲੈ ਕੇ ਘਰ ਜਾਦਾ ਸੀ ॥੧੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "बीसक बात घरै लै जावै ॥१६२॥",
      "sourceLineId": "84316",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਨਿ ਬਨਿ ਚਲਤ ਭਏ ਰਘੁਨੰਦਨ ॥",
      "transliteration": "ban ban chalat bhe raghuna(n)dhan ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਚੰਦਰ ਸਜ-ਧਜ ਕੇ ਤੁਰ ਪਏ ਸਨ। (ਉਹ ਇੰਜ ਪ੍ਰਤੀਤ ਹੋ ਰਹੇ ਸਨ)",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "बनि बनि चलत भए रघुनंदन ॥",
      "sourceLineId": "84317",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਫੂਲੇ ਪੁਹਪ ਬਸੰਤ ਜਾਨੁ ਬਨ ॥",
      "transliteration": "foole puhap basa(n)t jaan ban ||",
      "translation": "The sons of king Dasrath playing in the forests appeared like the flowers bloomed in spring season.",
      "punjabiViakhya": "ਮਾਨੋ ਬਣ ਵਿੱਚ ਬਸੰਤ ਰੁਤ ਦੇ ਫੁੱਲ ਖਿੜੇ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "फूले पुहप बसंत जानु बन ॥",
      "sourceLineId": "84318",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੋਭਤ ਕੇਸਰ ਅੰਗਿ ਡਰਾਯੋ ॥",
      "transliteration": "sobhat kesar a(n)g ddaraayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਸਰੀਰ ਉੱਤੇ ਪਾਇਆ ਕੇਸਰ ਇਸ ਤਰ੍ਰਹਾ ਸ਼ੋਭਾ ਪਾ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "सोभत केसर अंगि डरायो ॥",
      "sourceLineId": "84319",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਆਨੰਦ ਹੀਏ ਉਛਰ ਜਨ ਆਯੋ ॥੧੬੩॥",
      "transliteration": "aana(n)dh he'ee uchhar jan aayo ||163||",
      "translation": "The saffron sprinkled on the limbs appeared like the bliss gushing forth form the heart.163.",
      "punjabiViakhya": "ਮਾਨੋ ਹਿਰਦੇ ਦਾ ਆਨੰਦ ਉਛਲ ਕੇ ਬਾਹਰ ਆ ਗਿਆ ਹੋਵੇ ॥੧੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "आनंद हीए उछर जन आयो ॥१६३॥",
      "sourceLineId": "84320",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਾਜਤ ਭਏ ਅਮਿਤ ਚਤੁਰੰਗਾ ॥",
      "transliteration": "saajat bhe amit chatura(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਆਪਣੀ ਅਮਿਤ ਚਤੁਰੰਗੀ ਸੈਨਾ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਸਜਾਇਆ ਹੋਇਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 216,
      "hindi": "",
      "hindiTransliteration": "साजत भए अमित चतुरंगा ॥",
      "sourceLineId": "84321",
      "sourceShabadId": "7924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0216_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਉਮਡ ਚਲਤ ਜਿਹ ਬਿਧਿ ਕਰਿ ਗੰਗਾ ॥",
      "transliteration": "aumadd chalat jeh bidh kar ga(n)gaa ||",
      "translation": "They are gathering their limitless fourfold army like the gushing forth of the Ganges.",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਗੰਗਾ ਉਮੜ ਕੇ ਚਲਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
