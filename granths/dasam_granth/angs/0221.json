{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 221,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0221_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕ੍ਰਿਪਾਲ ਕਰਮ ਕਾਰਣੰ ॥",
      "transliteration": "kirapaal karam kaarana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਲੂ ਤੇ ਬਸ਼ਸ਼ਿਸ਼ ਕਰਨ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "कृपाल करम कारणं ॥",
      "sourceLineId": "84491",
      "sourceShabadId": "7931",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਿਹਾਲ ਦਿਆਲ ਤਾਰਣੰ ॥੨੦੪॥",
      "transliteration": "bihaal dhiaal taarana(n) ||204||",
      "translation": "“He is merciful and kind towards all and mercifully gives support to helpless and ferries them across.204.",
      "punjabiViakhya": "ਮਾੜੀ ਹਾਲਤ ਨੂੰ ਸੁਧਾਰਨ ਵਾਲਾ ਦਿਆਲੂ ਹੈ ॥੨੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "बिहाल दिआल तारणं ॥२०४॥",
      "sourceLineId": "84492",
      "sourceShabadId": "7931",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਨੇਕ ਸੰਤ ਤਾਰਣੰ ॥",
      "transliteration": "anek sa(n)t taarana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੇਕਾ ਸੰਤਾ ਨੂੰ ਤਾਰਨ ਵਾਲਾ ਹੇ,",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "अनेक संत तारणं ॥",
      "sourceLineId": "84493",
      "sourceShabadId": "7931",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਦੇਵ ਦੇਵ ਕਾਰਣੰ ॥",
      "transliteration": "adhev dhev kaarana(n) ||",
      "translation": "“He is the saviour of many saints and is the basic cause of the gods and demons.",
      "punjabiViakhya": "ਦੈਂਤਾ ਤੇ ਦੇਵਤਿਆਂ ਦਾ ਕਾਰਨ ਰੂਪ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "अदेव देव कारणं ॥",
      "sourceLineId": "84494",
      "sourceShabadId": "7931",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੁਰੇਸ ਭਾਇ ਰੂਪਣੰ ॥",
      "transliteration": "sures bhai roopana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਇੰਦਰ ਦੇ ਸਰੂਪ ਵਾਲਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "सुरेस भाइ रूपणं ॥",
      "sourceLineId": "84495",
      "sourceShabadId": "7931",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਮਿੱਧ੍ਰ ਸਿੱਧ ਕੂਪਣੰ ॥੨੦੫॥",
      "transliteration": "sami'dhr si'dh koopana(n) ||205||",
      "translation": "“He is also the king of gods and is the store of all powers.”205.",
      "punjabiViakhya": "ਅਤੇ ਸਿੱਧੀਆਂ ਦਾ ਅਮੁੱਕ ਭੰਡਾਰ ਹੈ ॥੨੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "समिद्ध्र सिद्ध कूपणं ॥२०५॥",
      "sourceLineId": "84496",
      "sourceShabadId": "7931",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਰੰ ਨਰੇਸ ਦੀਜੀਐ ॥",
      "transliteration": "bara(n) nares dheejeeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ ਕੈਕਈ ਕਹਿਣ ਲੱਗੀ-) ਹੇ ਰਾਜਨ! (ਮੈਨੂੰ) ਵਰ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "बरं नरेस दीजीऐ ॥",
      "sourceLineId": "84497",
      "sourceShabadId": "7931",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਹੇ ਸੁ ਪੂਰ ਕੀਜੀਐ ॥",
      "transliteration": "kahe su poor keejeeaai ||",
      "translation": "The queen said, “O king! Grant me the boons and fulfil thy sayins.",
      "punjabiViakhya": "ਜੋ (ਤੁਸੀਂ) ਕਹੇ ਹੋਏ ਹਨ, ਉਹ ਪੂਰੇ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "कहे सु पूर कीजीऐ ॥",
      "sourceLineId": "84498",
      "sourceShabadId": "7931",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨ ਸੰਕ ਰਾਜ ਧਾਰੀਐ ॥",
      "transliteration": "n sa(n)k raaj dhaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਮਨ ਵਿੱਚ ਕੋਈ ਸ਼ੰਕਾ ਨਾ ਧਾਰੋ,",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "न संक राज धारीऐ ॥",
      "sourceLineId": "84499",
      "sourceShabadId": "7931",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨ ਬੋਲ ਬੋਲ ਹਾਰੀਐ ॥੨੦੬॥",
      "transliteration": "n bol bol haareeaai ||206||",
      "translation": "“Adandon the position of duality from your mind and do not fail in your promise.”206.",
      "punjabiViakhya": "ਬੋਲ ਕਹਿ ਕੇ ਬੋਲ ਤੋਂ ਨਾ ਹਾਰੋ ॥੨੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "न बोल बोल हारीऐ ॥२०६॥",
      "sourceLineId": "84500",
      "sourceShabadId": "7931",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਗ ਸਰੂਪੀ ਅੱਧਾ ਛੰਦ ॥",
      "transliteration": "nag saroopee a'dhaa chha(n)dh ||",
      "translation": "NAG SWAROOPI ARDH STANZA",
      "punjabiViakhya": "ਨਗ ਸਰੂਪੀ ਅੱਧਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "नग सरूपी अद्धा छंद ॥",
      "sourceLineId": "84501",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨ ਲਾਜੀਐ ॥",
      "transliteration": "n laajeeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਹੇ ਰਾਜਨ!) ਲੱਜਾ ਨਾ ਕਰੋ",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "न लाजीऐ ॥",
      "sourceLineId": "84502",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨ ਭਾਜੀਐ ॥",
      "transliteration": "n bhaajeeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਬਚਨ ਤੋਂ) ਨਾ ਫਿਰੋ,",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "न भाजीऐ ॥",
      "sourceLineId": "84503",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਘੁਏਸ ਕੋ ॥",
      "transliteration": "raghues ko ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "रघुएस को ॥",
      "sourceLineId": "84504",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਨੇਸ ਕੋ ॥੨੦੭॥",
      "transliteration": "banes ko ||207||",
      "translation": "“O king! Do not hesitate and run away from your promise, give exile to Ram.207.",
      "punjabiViakhya": "ਤਪੋ ਬਣ ਵਲ ਭੇਜੋ ॥੨੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "बनेस को ॥२०७॥",
      "sourceLineId": "84505",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਿਦਾ ਕਰੋ ॥",
      "transliteration": "bidhaa karo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਮ ਨੂੰ) ਵਿਦਾ ਕਰ ਦਿਓ,",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "बिदा करो ॥",
      "sourceLineId": "84506",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਧਰਾ ਹਰੋ ॥",
      "transliteration": "dharaa haro ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ (ਦਾ ਭਾਰ) ਦੂਰ ਕਰੋ,",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "धरा हरो ॥",
      "sourceLineId": "84507",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨ ਭਾਜੀਐ ॥",
      "transliteration": "n bhaajeeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਬਚਨ ਤੋਂ) ਨਾ ਫਿਰੋ,",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "न भाजीऐ ॥",
      "sourceLineId": "84508",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਿਰਾਜੀਐ ॥੨੦੮॥",
      "transliteration": "biraajeeaai ||208||",
      "translation": "“Bid farewell to Ram and take back the proposed rule from him. Don’t run away from your promise and be seated peacefully.208.",
      "punjabiViakhya": "ਸਥਿਰ ਹੋਵੋ ॥੨੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "बिराजीऐ ॥२०८॥",
      "sourceLineId": "84509",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਸਿਸਟ ਕੋ ॥",
      "transliteration": "basisaT ko ||",
      "translation": "",
      "punjabiViakhya": "(ਹੇ ਰਾਜਾ!) ਵਸ਼ਿਸ਼ਟ",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "बसिसट को ॥",
      "sourceLineId": "84510",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦਿਜਿਸਟ ਕੋ ॥",
      "transliteration": "dhijisaT ko ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ ਪੁਰੋਹਿਤ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "दिजिसट को ॥",
      "sourceLineId": "84511",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬੁਲਾਈਐ ॥",
      "transliteration": "bulaieeaai ||",
      "translation": "",
      "punjabiViakhya": "ਬੁਲਾ ਲਵੋ",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "बुलाईऐ ॥",
      "sourceLineId": "84512",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪਠਾਈਐ ॥੨੦੯॥",
      "transliteration": "paThaieeaai ||209||",
      "translation": "“O king! Cal Vasishtha and the royal priest and send Ram to the forest.”209.",
      "punjabiViakhya": "(ਅਤੇ ਰਾਮ ਚੰਦਰ ਨੂੰ ਬਣ) ਭੇਜੋ ॥੨੦੯॥",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "पठाईऐ ॥२०९॥",
      "sourceLineId": "84513",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਰੇਸ ਜੀ ॥",
      "transliteration": "nares jee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ (ਦਸ਼ਰਥ) ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "नरेस जी ॥",
      "sourceLineId": "84514",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਉਸੇਸ ਲੀ ॥",
      "transliteration": "auses lee ||",
      "translation": "",
      "punjabiViakhya": "ਠੰਡਾ ਸਾਹ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "उसेस ली ॥",
      "sourceLineId": "84515",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਘੁਮੇ ਘਿਰੇ ॥",
      "transliteration": "ghume ghire ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘੇਰਨੀ ਖਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "घुमे घिरे ॥",
      "sourceLineId": "84516",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਧਰਾ ਗਿਰੇ ॥੨੧੦॥",
      "transliteration": "dharaa gire ||210||",
      "translation": "The king heaved a long sigh, moved hither and thither and then fell down.210.",
      "punjabiViakhya": "ਧਰਤੀ ਉੱਤੇ ਡਿੱਗ ਪਿਆ ॥੨੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "धरा गिरे ॥२१०॥",
      "sourceLineId": "84517",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੁਚੇਤ ਭੇ ॥",
      "transliteration": "suchet bhe ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਰਾਜਾ",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "सुचेत भे ॥",
      "sourceLineId": "84518",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਚੇਤ ਤੇ ॥",
      "transliteration": "achet te ||",
      "translation": "",
      "punjabiViakhya": "ਅਚੇਤ ਅਵਸਥਾ ਤੋਂ ਸੁਚੇਤ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "अचेत ते ॥",
      "sourceLineId": "84519",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਉਸਾਸ ਲੈ ॥",
      "transliteration": "ausaas lai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਹੌਕਾ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "उसास लै ॥",
      "sourceLineId": "84520",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਉਦਾਸ ਹ੍ਵੈ ॥੨੧੧॥",
      "transliteration": "audhaas havai ||211||",
      "translation": "The king again came to his senses from the stupor and grievously heaved a long breath.211.",
      "punjabiViakhya": "ਉਦਾਸ ਹੋ ਗਿਆ ॥੨੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "उदास ह्वै ॥२११॥",
      "sourceLineId": "84521",
      "sourceShabadId": "7932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਉਗਾਧ ਛੰਦ ॥",
      "transliteration": "augaadh chha(n)dh ||",
      "translation": "UGAADH STANZA",
      "punjabiViakhya": "ਉਗਾਧ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "उगाध छंद ॥",
      "sourceLineId": "84522",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਬਾਰ ਨੈਣੰ ॥",
      "transliteration": "sabaar naina(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਜਲ ਭਰੀਆਂ ਅੱਖਾ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "सबार नैणं ॥",
      "sourceLineId": "84523",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਉਦਾਸ ਬੈਣੰ ॥",
      "transliteration": "audhaas baina(n) ||",
      "translation": "With tears in his eyes and anguish in his utterance,",
      "punjabiViakhya": "ਅਤੇ ਉਦਾਸ ਬਚਨਾ (ਨਾਲ ਕੈਕਈ ਨੂੰ)",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "उदास बैणं ॥",
      "sourceLineId": "84524",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਹਿਯੋ ਕੁਨਾਰੀ ॥",
      "transliteration": "kahiyo kunaaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਹਾ- ਹੇ ਨੀਚ ਔਰਤ!",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "कहियो कुनारी ॥",
      "sourceLineId": "84525",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕੁਬ੍ਰਿੱਤ ਕਾਰੀ ॥੨੧੨॥",
      "transliteration": "kubira't kaaree ||212||",
      "translation": "The kin said to Kaikeyi, “You are a mean and evil woman.212.",
      "punjabiViakhya": "ਬੁਰੇ ਸੁਭਾਵ ਵਾਲੀ! ॥੨੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "कुबृत्त कारी ॥२१२॥",
      "sourceLineId": "84526",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਲੰਕ ਰੂਪਾ ॥",
      "transliteration": "kala(n)k roopaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੈ ਕਲੰਕ ਰੂਪਣੀ!",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "कलंक रूपा ॥",
      "sourceLineId": "84527",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕੁਵਿਰਤ ਕੂਪਾ ॥",
      "transliteration": "kuvirat koopaa ||",
      "translation": "“You are a blemish on womankind and a store of vices.",
      "punjabiViakhya": "ਹੇ ਬੁਰੀ ਸੁਭਾਵ ਦੀ ਖੂਹ!",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "कुविरत कूपा ॥",
      "sourceLineId": "84528",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਿਲੱਜ ਨੈਣੀ ॥",
      "transliteration": "nila'j nainee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਨਿਰਲਜ ਅੱਖਾ ਵਾਲੀ!",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "निलज्ज नैणी ॥",
      "sourceLineId": "84529",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕੁਬਾਕ ਬੈਣੀ ॥੨੧੩॥",
      "transliteration": "kubaak bainee ||213||",
      "translation": "“You have no shame in your eyes and your words are ignominious.213.",
      "punjabiViakhya": "ਹੇ ਬੁਰੇ ਬੋਲ ਬੋਲਣ ਵਾਲੀ! ॥੨੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "कुबाक बैणी ॥२१३॥",
      "sourceLineId": "84530",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਲੰਕ ਕਰਣੀ ॥",
      "transliteration": "kala(n)k karanee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਕਲੰਕ ਕਰਨ ਵਾਲੀ!",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "कलंक करणी ॥",
      "sourceLineId": "84531",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਮ੍ਰਿੱਧ ਹਰਣੀ ॥",
      "transliteration": "samira'dh haranee ||",
      "translation": "“You are evil woman and are the destroyer of enhancement.",
      "punjabiViakhya": "ਹੇ ਅਮੀਰੀ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲੀ!",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "समृद्ध हरणी ॥",
      "sourceLineId": "84532",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਕ੍ਰਿੱਤ ਕਰਮਾ ॥",
      "transliteration": "akira't karamaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਨ ਕਰਨ ਯੋਗ ਕਰਮਾ ਨੂੰ ਕਰਨ ਵਾਲੀ!",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "अकृत्त करमा ॥",
      "sourceLineId": "84533",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਿਲੱਜ ਧਰਮਾ ॥੨੧੪॥",
      "transliteration": "nila'j dharamaa ||214||",
      "translation": "“You are performer of evil deeds and shameless in your Dharma.214.",
      "punjabiViakhya": "ਹੇ ਨਿਰਲਜ ਧਰਮ ਵਾਲੀ! ॥੨੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "निलज्ज धरमा ॥२१४॥",
      "sourceLineId": "84534",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਲੱਜ ਧਾਮੰ ॥",
      "transliteration": "ala'j dhaama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਬੇਸ਼ਰਮੀ ਦਾ ਘਰ",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "अलज्ज धामं ॥",
      "sourceLineId": "84535",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਿਲੱਜ ਬਾਮੰ ॥",
      "transliteration": "nila'j baama(n) ||",
      "translation": "“You are the abode of shamelessness and a woman forsaking hesitation (shyness).",
      "punjabiViakhya": "ਰੂਪ ਨਿਰਲਜ ਇਸਤਰੀ!",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "निलज्ज बामं ॥",
      "sourceLineId": "84536",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਸੋਭ ਕਰਣੀ ॥",
      "transliteration": "asobh karanee ||",
      "translation": "",
      "punjabiViakhya": "ਬਦਨਾਮੀ ਕਰਾਉਣ ਵਾਲੀ!",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "असोभ करणी ॥",
      "sourceLineId": "84537",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0221_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਸੋਭ ਹਰਣੀ ॥੨੧੫॥",
      "transliteration": "sasobh haranee ||215||",
      "translation": "“You are the performer of misdeeds and destroyer of glory.215.",
      "punjabiViakhya": "ਹੇ ਸ਼ੋਭਾ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲੀ! ॥੨੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": "ससोभ हरणी ॥२१५॥",
      "sourceLineId": "84538",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
