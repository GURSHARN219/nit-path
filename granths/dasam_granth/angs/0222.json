{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 222,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0222_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਿਲੱਜ ਨਾਰੀ ॥",
      "transliteration": "nila'j naaree ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਲੱਜਾ-ਹੀਣ ਇਸਤਰੀ!",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "निलज्ज नारी ॥",
      "sourceLineId": "84539",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕੁਕਰਮ ਕਾਰੀ ॥",
      "transliteration": "kukaram kaaree ||",
      "translation": "“O shameless woman! you are the doer of evil acts,",
      "punjabiViakhya": "ਹੇ ਕੁਕਰਮ ਕਰਨ ਵਾਲੀ!",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "कुकरम कारी ॥",
      "sourceLineId": "84540",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਧਰਮ ਰੂਪਾ ॥",
      "transliteration": "adharam roopaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਅਧਰਮ ਰੂਪ ਵਾਲੀ!",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "अधरम रूपा ॥",
      "sourceLineId": "84541",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਕੱਜ ਕੂਪਾ ॥੨੧੬॥",
      "transliteration": "aka'j koopaa ||216||",
      "translation": "“Impiety-incarnate and store of vicious works.216.",
      "punjabiViakhya": "ਨ ਕੱਜੇ ਜਾਣ ਵਾਲੇ (ਪਾਪਾ ਦੇ) ਖੂਹ (ਦੇ ਰੂਪ) ਵਾਲੀ! ॥੨੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "अकज्ज कूपा ॥२१६॥",
      "sourceLineId": "84542",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪਹਪਿਟਆਰੀ ॥",
      "transliteration": "pahapiTaaree ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਾਪਾ ਦੀ ਪਿਟਾਰੀ!",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "पहपिटआरी ॥",
      "sourceLineId": "84543",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕੁਕਰਮ ਕਾਰੀ ॥",
      "transliteration": "kukaram kaaree ||",
      "translation": "“O the basket of sins! evil-doer,",
      "punjabiViakhya": "ਹੇ ਕੁਕਰਮ ਕਰਨ ਵਾਲੀ!",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "कुकरम कारी ॥",
      "sourceLineId": "84544",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਰੈ ਨ ਮਰਣੀ ॥",
      "transliteration": "marai na maranee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮਰਿਆਂ ਨ ਮਰਨ ਵਾਲੀ!",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "मरै न मरणी ॥",
      "sourceLineId": "84545",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਕਾਜ ਕਰਣੀ ॥੨੧੭॥",
      "transliteration": "akaaj karanee ||217||",
      "translation": "“You do not die even we wish you to die, you are the performer of misdeeds.”217.",
      "punjabiViakhya": "ਹੇ ਬੁਰੇ ਕੰਮ ਕਰਮ ਕਰਨ ਵਾਲੀ! ॥੨੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "अकाज करणी ॥२१७॥",
      "sourceLineId": "84546",
      "sourceShabadId": "7933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕੇਕਈ ਬਾਚ ॥",
      "transliteration": "kekiee baach ||",
      "translation": "The Speech of Kaikeyi:",
      "punjabiViakhya": "ਕੈਕਈ ਨੇ ਕਿਹਾ-",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "केकई बाच ॥",
      "sourceLineId": "84547",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਰੇਸ ਮਾਨੋ ॥",
      "transliteration": "nares maano ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! (ਮੇਰਾ ਕਿਹਾ) ਮੰਨੋ",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "नरेस मानो ॥",
      "sourceLineId": "84548",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਹਯੋ ਪਛਾਨੋ ॥",
      "transliteration": "kahayo pachhaano ||",
      "translation": "“O king! Accept my saying and remember your words",
      "punjabiViakhya": "(ਆਪਣਾ) ਕਿਹਾ ਯਾਦ ਕਰੋ",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "कहयो पछानो ॥",
      "sourceLineId": "84549",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਦਯੋ ਸੁ ਦੇਹੂ ॥",
      "transliteration": "badhayo su dhehoo ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਕਿਹਾ ਸੀ, ਉਸ ਅਨੁਸਾਰ",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "बदयो सु देहू ॥",
      "sourceLineId": "84550",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਰੰ ਦੁ ਮੋਹੂ ॥੨੧੮॥",
      "transliteration": "bara(n) dh mohoo ||218||",
      "translation": "“Whatever you have promised, grant me two boons according to that.218.",
      "punjabiViakhya": "ਮੈਨੂੰ ਦੋ ਵਰ ਦਿਓ ॥੨੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "बरं दु मोहू ॥२१८॥",
      "sourceLineId": "84551",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚਿਤਾਰ ਲੀਜੈ ॥",
      "transliteration": "chitaar leejai ||",
      "translation": "",
      "punjabiViakhya": "ਚੇਤੇ ਕਰ ਲਵੋ,",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "चितार लीजै ॥",
      "sourceLineId": "84552",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਹਯੋ ਸੁ ਦੀਜੈ ॥",
      "transliteration": "kahayo su dheejai ||",
      "translation": "“Remember rightly and give whatever you have said.",
      "punjabiViakhya": "ਜੋ ਕਿਹਾ ਹੋਇਆ ਹੈ, ਉਹੀ ਦਿਓ,",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "कहयो सु दीजै ॥",
      "sourceLineId": "84553",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨ ਧਰਮ ਹਾਰੋ ॥",
      "transliteration": "n dharam haaro ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਮ ਨ ਹਾਰੋ,",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "न धरम हारो ॥",
      "sourceLineId": "84554",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨ ਭਰਮ ਟਾਰੋ ॥੨੧੯॥",
      "transliteration": "n bharam Taaro ||219||",
      "translation": "“Do not forsake your Dharma and do not shatter my trust.219.",
      "punjabiViakhya": "ਭਰਮ (ਦੇ ਵਿੱਚ ਪੈ ਕੇ ਬਚਨ ਨੂੰ) ਨਾ ਟਾਲੋ ॥੨੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "न भरम टारो ॥२१९॥",
      "sourceLineId": "84555",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬੁਲੈ ਬਸਿਸਟੈ ॥",
      "transliteration": "bulai basisaTai ||",
      "translation": "",
      "punjabiViakhya": "ਵਸ਼ਿਸ਼ਟ ਨੂੰ ਬੁਲਾ ਲਵੋ",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "बुलै बसिसटै ॥",
      "sourceLineId": "84556",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਪੂਰਬ ਇਸਟੈ ॥",
      "transliteration": "apoorab isaTai ||",
      "translation": "“Call Vasishtha, your unique spiritual head,",
      "punjabiViakhya": "ਜੋ ਅਦੁੱਤੀ ਇਸ਼ਟ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "अपूरब इसटै ॥",
      "sourceLineId": "84557",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਹੀ ਸੀਏਸੈ ॥",
      "transliteration": "kahee se'eesai ||",
      "translation": "",
      "punjabiViakhya": "ਸੀਤਾ ਦੇ ਪਤੀ (ਰਾਮ ਚੰਦਰ) ਨੂੰ (ਇਹ ਗੱਲ) ਕਹੋ",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "कही सीएसै ॥",
      "sourceLineId": "84558",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਿਕਾਰ ਦੇਸੈ ॥੨੨੦॥",
      "transliteration": "nikaar dhesai ||220||",
      "translation": "“Order the husband of Sita for his exile.220.",
      "punjabiViakhya": "ਅਤੇ ਦੇਸੋਂ ਕੱਢ ਦਿਓ ॥੨੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "निकार देसै ॥२२०॥",
      "sourceLineId": "84559",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਿਲਮ ਨ ਕੀਜੈ ॥",
      "transliteration": "bilam na keejai ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਰੀ ਨ ਕਰੋ,",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "बिलम न कीजै ॥",
      "sourceLineId": "84560",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੁ ਮਾਨ ਲੀਜੈ ॥",
      "transliteration": "s maan leejai ||",
      "translation": "“Do not cuase any delay in the task and accept my saying",
      "punjabiViakhya": "(ਮੇਰੀ ਬੇਨਤੀ) ਮੰਨ ਲਵੋ,",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "सु मान लीजै ॥",
      "sourceLineId": "84561",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਿਖੇਸ ਰਾਮੰ ॥",
      "transliteration": "rikhes raama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਨੂੰ ਰਿਸ਼ੀ ਭੇਸ (ਧਾਰਨ ਕਰਾ ਕੇ)",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "रिखेस रामं ॥",
      "sourceLineId": "84562",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਿਕਾਰ ਧਾਮੰ ॥੨੨੧॥",
      "transliteration": "nikaar dhaama(n) ||221||",
      "translation": "“Making Ram a sage, turn him out of the home ”221.",
      "punjabiViakhya": "ਘਰ ਤੋਂ ਕੱਢ ਦਿਓ ॥੨੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "निकार धामं ॥२२१॥",
      "sourceLineId": "84563",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਹੇ ਨ ਇਆਨੀ ॥",
      "transliteration": "rahe na iaanee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ ਕਿਹਾ-) ਹੇ ਇਆਣੀ! (ਚੁੱਪ ਕਿਉਾਂ) ਨਹੀਂ ਰਹਿੰਦੀ?",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "रहे न इआनी ॥",
      "sourceLineId": "84564",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਭਈ ਦਿਵਾਨੀ ॥",
      "transliteration": "bhiee dhivaanee ||",
      "translation": "(The poet says) She was stubborn like a child and verged on madness.",
      "punjabiViakhya": "(ਕੀ) ਦਿਵਾਨੀ ਹੋ ਗਈ ਹੈਂ?",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "भई दिवानी ॥",
      "sourceLineId": "84565",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚੁਪੈ ਨ ਬਉਰੀ ॥",
      "transliteration": "chupai na bauree ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਗਲੀਏ! ਚੁੱਪ (ਕਿਉਾਂ) ਨਹੀਂ ਕਰਦੀ?",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "चुपै न बउरी ॥",
      "sourceLineId": "84566",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਕੈਤ ਡਉਰੀ ॥੨੨੨॥",
      "transliteration": "bakait ddauree ||222||",
      "translation": "She did not keep silent and was continuously speaking.222.",
      "punjabiViakhya": "ਹੇ ਬਕਵਾਦਣੇ! ਬਕਦੀ ਜਾਦੀ ਹੈਂ ॥੨੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "बकैत डउरी ॥२२२॥",
      "sourceLineId": "84567",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਧ੍ਰਿਗੰਸ ਰੂਪਾ ॥",
      "transliteration": "dhiraga(n)s roopaa ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਰੇ ਰੂਪ ਨੂੰ ਧ੍ਰਿਕਾਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "धृगंस रूपा ॥",
      "sourceLineId": "84568",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਿਖੇਧ ਕੂਪਾ ॥",
      "transliteration": "nikhedh koopaa ||",
      "translation": "She was worthy of reproach and store of man acts.",
      "punjabiViakhya": "(ਤੂੰ) ਨੀਚਤਾ ਦਾ ਖੂਹ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "निखेध कूपा ॥",
      "sourceLineId": "84569",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦ੍ਰੁਬਾਕ ਬੈਣੀ ॥",
      "transliteration": "dhrubaak bainee ||",
      "translation": "",
      "punjabiViakhya": "ਬੁਰੇ ਬੋਲ ਬੋਲਣ ਵਾਲੀ ਹੈਂ",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "द्रुबाक बैणी ॥",
      "sourceLineId": "84570",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਰੇਸ ਛੈਣੀ ॥੨੨੩॥",
      "transliteration": "nares chhainee ||223||",
      "translation": "She was evil-tongued queen and the cause of weakening the strength of the king.223.",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ (ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲੀ) ਛੈਣੀ ਹੈ ॥੨੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "नरेस छैणी ॥२२३॥",
      "sourceLineId": "84571",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਿਕਾਰ ਰਾਮੰ ॥",
      "transliteration": "nikaar raama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਘਰ ਦੇ ਆਸਰਾ ਰੂਪ ਰਾਮ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "निकार रामं ॥",
      "sourceLineId": "84572",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਧਾਰ ਧਾਮੰ ॥",
      "transliteration": "adhaar dhaama(n) ||",
      "translation": "She got the ouster of Ram, who was the pillar (support) of the house",
      "punjabiViakhya": "ਕੱਢ ਦਿੱਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "अधार धामं ॥",
      "sourceLineId": "84573",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹਤਯੋ ਨਿਜੇਸੰ ॥",
      "transliteration": "hatayo nijesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਸੁਆਮੀ ('ਨਿਜੇਸ') ਨੂੰ ਮਾਰਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "हतयो निजेसं ॥",
      "sourceLineId": "84574",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕੁਕਰਮ ਭੇਸੰ ॥੨੨੪॥",
      "transliteration": "kukaram bhesa(n) ||224||",
      "translation": "And in this way she performed the evil act of killing her husband.224.",
      "punjabiViakhya": "ਭੈੜੇ ਕਰਮ ਦੇ ਸਰੂਪ ਵਾਲੀ ਹੈਂ ॥੨੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "कुकरम भेसं ॥२२४॥",
      "sourceLineId": "84575",
      "sourceShabadId": "7934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਉਗਾਥਾ ਛੰਦ ॥",
      "transliteration": "augaathaa chha(n)dh ||",
      "translation": "UGAATHA STANZA",
      "punjabiViakhya": "ਉਗਾਥਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "उगाथा छंद ॥",
      "sourceLineId": "84576",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਜਿੱਤ ਜਿੱਤੇ ਅਬਾਹ ਬਾਹੇ ॥",
      "transliteration": "aji't ji'te abaeh baahe ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸਤਰੀਆਂ ਨੇ) ਨ ਜਿੱਤੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਜਿੱਤ ਲਿਆ, ਨ ਬਾਹੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਬਾਹ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "अजित्त जित्ते अबाह बाहे ॥",
      "sourceLineId": "84577",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਖੰਡ ਖੰਡੇ ਅਦਾਹ ਦਾਹੇ ॥",
      "transliteration": "akha(n)dd kha(n)dde adhaeh dhaahe ||",
      "translation": "(The poet says that the woman) conquered the unconquered, destroyed the indestructible, broke the unbreakable and (with her blaze) reduced to ashes the indeclinable.",
      "punjabiViakhya": "ਨ ਖੰਡੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਖੰਡ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "अखंड खंडे अदाह दाहे ॥",
      "sourceLineId": "84578",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਭੰਡ ਭੰਡੇ ਅਡੰਗ ਡੰਗੇ ॥",
      "transliteration": "abha(n)dd bha(n)dde adda(n)g dda(n)ge ||",
      "translation": "",
      "punjabiViakhya": "ਨ ਡੰਗੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਡੰਗ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "अभंड भंडे अडंग डंगे ॥",
      "sourceLineId": "84579",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਮੁੰਨ ਮੁੰਨੇ ਅਭੰਗ ਭੰਗੇ ॥੨੨੫॥",
      "transliteration": "amu(n)n mu(n)ne abha(n)g bha(n)ge ||225||",
      "translation": "She has slandered him who cannot be calumniated, she has given him a blow who cannot be farmed. She has deceived them who is beyond deception and has disjointed the compact one.225.",
      "punjabiViakhya": "ਨ ਮੁੰਨੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਮੁੰਨ ਦਿੱਤਾ, ਨ ਭੰਗ ਹੋਣ ਵਾਲਿਆਂ ਦਾ ਭੰਗਨ ਕਰ ਦਿੱਤਾ ॥੨੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "अमुँन मुँने अभंग भंगे ॥२२५॥",
      "sourceLineId": "84580",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਕਰਮ ਕਰਮੰ ਅਲੱਖ ਲੱਖੇ ॥",
      "transliteration": "akaram karama(n) ala'kh la'khe ||",
      "translation": "",
      "punjabiViakhya": "ਨ ਕੀਤੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ (ਕੰਮਾ) ਨੂੰ ਕਰ ਲਿਆ, ਨ ਲਖੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਲਖ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "अकरम करमं अलक्ख लक्खे ॥",
      "sourceLineId": "84581",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਡੰਡ ਡੰਡੇ ਅਭੱਖ ਭੱਖੇ ॥",
      "transliteration": "adda(n)dd dda(n)dde abha'kh bha'khe ||",
      "translation": "She has engrossed the detached one in action and her vision is so sharp that she can see providence. She can cause the unpunishable to be punished and uneatable to be eaten.",
      "punjabiViakhya": "ਨ ਡੰਡੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਡੰਡ ਦਿੱਤਾ, ਨ ਖਾਧੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਖਾ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "अडंड डंडे अभक्ख भक्खे ॥",
      "sourceLineId": "84582",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਥਾਹ ਥਾਹੇ ਅਦਾਹ ਦਾਹੇ ॥",
      "transliteration": "athaeh thaahe adhaeh dhaahe ||",
      "translation": "",
      "punjabiViakhya": "ਨ ਥਾਹ ਪਾਏ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਥਾਹ ਪਾ ਲਈ, ਨ ਸੜਨ ਵਾਲਿਆਂ ਨੂੰ ਸਾੜ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "अथाह थाहे अदाह दाहे ॥",
      "sourceLineId": "84583",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਭੰਗ ਭੰਗੇ ਅਬਾਹ ਬਾਹੇ ॥੨੨੬॥",
      "transliteration": "abha(n)g bha(n)ge abaeh baahe ||226||",
      "translation": "She has fathomed the unfathomable and has destroyed the indestructible. She has destroyed the indestructible and has moved the immovable as her vehicles.226.",
      "punjabiViakhya": "ਨ ਭੱਜਣ ਵਾਲਿਆਂ ਨੂੰ ਭੰਨ ਦਿੱਤਾ ਹੈ, ਨ ਫੜੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਫੜ ਲਿਆ ॥੨੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "अभंग भंगे अबाह बाहे ॥२२६॥",
      "sourceLineId": "84584",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਭਿੱਜ ਭਿੱਜੇ ਅਜਾਲ ਜਾਲੇ ॥",
      "transliteration": "abhi'j bhi'je ajaal jaale ||",
      "translation": "",
      "punjabiViakhya": "ਨ ਭਿੱਜਣ ਵਾਲਿਆਂ ਨੂੰ ਭਿਗੋ ਦਿੱਤਾ, ਨ ਫਸਣ ਵਾਲਿਆਂ ਨੂੰ ਫਸਾ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "अभिज्ज भिज्जे अजाल जाले ॥",
      "sourceLineId": "84585",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0222_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਖਾਪ ਖਾਪੇ ਅਚਾਲ ਚਾਲੇ ॥",
      "transliteration": "akhaap khaape achaal chaale ||",
      "translation": "She has dyed the dried one, blazed the incombustible. She has destroyed the indestructible and has moved the immovable.",
      "punjabiViakhya": "ਨ ਖੱਪ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਖਪਾ ਦਿੱਤਾ, ਨ ਚਲ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਚਲਾ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": "अखाप खापे अचाल चाले ॥",
      "sourceLineId": "84586",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
