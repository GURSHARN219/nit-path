{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 223,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0223_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਭਿੰਨ ਭਿੰਨੇ ਅਡੰਡ ਡਾਡੇ ॥",
      "transliteration": "abhi(n)n bhi(n)ne adda(n)dd ddaadde ||",
      "translation": "",
      "punjabiViakhya": "ਨ ਭੇਦੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਭੇਦ ਦਿੱਤਾ, ਨ ਡੰਡੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਡੰਡ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अभिंन भिंने अडंड डाडे ॥",
      "sourceLineId": "84587",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਕਿੱਤ ਕਿੱਤੇ ਅਮੁੰਡ ਮਾਡੇ ॥੨੨੭॥",
      "transliteration": "aki't ki'te amu(n)dd maadde ||227||",
      "translation": "She has disjoined the compact one and has punished the unpunishable. She can do whatever is not to be done and can corroborate the irrefutable.227.",
      "punjabiViakhya": "ਨ ਕੀਤੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਕਰ ਦਿੱਤਾ, ਨ ਮੰਡੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਮੰਡ ਦਿੱਤਾ ॥੨੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अकित्त कित्ते अमुँड माडे ॥२२७॥",
      "sourceLineId": "84588",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਛਿੱਦ ਛਿੱਦੇ ਅਦੱਗ ਦਾਗੇ ॥",
      "transliteration": "achhi'dh chhi'dhe adha'g dhaage ||",
      "translation": "",
      "punjabiViakhya": "ਨ ਛੇਦੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਛੇਦ ਦਿੱਤਾ, ਨ ਦਾਗੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਦਾਗ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अछिद्द छिद्दे अदग्ग दागे ॥",
      "sourceLineId": "84589",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਚੋਰ ਚੋਰੇ ਅਠੱਗ ਠਾਗੇ ॥",
      "transliteration": "achor chore aTha'g Thaage ||",
      "translation": "She has blemished the unblemishabel and has stained the pure one  she as made thieves and thus the persons who are never deceptive",
      "punjabiViakhya": "ਨ ਚੁਰਾਏ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਚੁਰਾ ਲਿਆ, ਨ ਠੱਗੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਠੱਗ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अचोर चोरे अठग्ग ठागे ॥",
      "sourceLineId": "84590",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਭਿੱਦ ਭਿੱਦੇ ਅਫੋੜ ਫੋੜੇ ॥",
      "transliteration": "abhi'dh bhi'dhe afoR foRe ||",
      "translation": "",
      "punjabiViakhya": "ਨ ਵੱਖ ਕੀਤੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਵੱਖ ਕਰ ਦਿੱਤਾ, ਨ ਫੁੱਟਣ ਵਾਲਿਆਂ ਨੂੰ ਫੋੜ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अभिद्द भिद्दे अफोड़ फोड़े ॥",
      "sourceLineId": "84591",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਕੱਜ ਕੱਜੇ ਅਜੋੜ ਜੋੜੇ ॥੨੨੮॥",
      "transliteration": "aka'j ka'je ajoR joRe ||228||",
      "translation": "She has discriminated the indiscriminate and has broken the unbreakable. She has covered the naked ones and united the disjointed.228.",
      "punjabiViakhya": "ਨ ਕੰਜੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਕੱਜ ਦਿੱਤਾ, ਨ ਜੋੜੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਜੋੜ ਦਿੱਤਾ ॥੨੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अकज्ज कज्जे अजोड़ जोड़े ॥२२८॥",
      "sourceLineId": "84592",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਦੱਗ ਦੱਗੇ ਅਮੋੜ ਮੋੜੇ ॥",
      "transliteration": "adha'g dha'ge amoR moRe ||",
      "translation": "",
      "punjabiViakhya": "ਇਸੇ ਤਰ੍ਰਹਾ ਨ ਦਾਗੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਦਾਗ ਦਿੱਤਾ, ਨ ਮੋੜੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਮੋੜ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अदग्ग दग्गे अमोड़ मोड़े ॥",
      "sourceLineId": "84593",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਖਿੱਚ ਖਿੱਚੇ ਅਜੋੜ ਜੋੜੇ ॥",
      "transliteration": "akhi'ch khi'che ajoR joRe ||",
      "translation": "She has burnt the incombustible and can bend the unbendable. She has pulled the pulled the annullable and has untited the disjointed.",
      "punjabiViakhya": "ਨ ਖਿੱਚੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਖਿੱਚ ਲਿਆ, ਨ ਜੁੜ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਜੋੜ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अखिच्च खिच्चे अजोड़ जोड़े ॥",
      "sourceLineId": "84594",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਕੱਢ ਕੱਢੇ ਅਸਾਧ ਸਾਧੇ ॥",
      "transliteration": "aka'dd ka'dde asaadh saadhe ||",
      "translation": "",
      "punjabiViakhya": "ਨ ਕੱਢੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਕੱਢ ਦਿੱਤਾ, ਨ ਸਾਧੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਸਾਧ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अकड्ढ कड्ढे असाध साधे ॥",
      "sourceLineId": "84595",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਫੱਟ ਫੱਟੇ ਅਫਾਧ ਫਾਧੇ ॥੨੨੯॥",
      "transliteration": "afa'T fa'Te afaadh faadhe ||229||",
      "translation": "She has taken out those which can never be taken our and fashioned the unfashionable, she has wounded the unconquerable and has entrapped those who cannot be entrapped.229.",
      "punjabiViakhya": "ਨਾ ਫਟ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਫਾੜ ਦਿੱਤਾ, ਨ ਫਸਣ ਵਾਲਿਆਂ ਨੂੰ ਫਸਾ ਲਿਆ ॥੨੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अफट्ट फट्टे अफाध फाधे ॥२२९॥",
      "sourceLineId": "84596",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਧੰਧ ਧੰਧੇ ਅਕੱਜ ਕੱਜੇ ॥",
      "transliteration": "adha(n)dh dha(n)dhe aka'j ka'je ||",
      "translation": "",
      "punjabiViakhya": "ਧੰਧੇ ਤੋਂ ਰਹਿਤਾ ਨੂੰ ਧੰਧੇ ਲਾਇਆ ਹੈ, ਨ ਕੱਜੇ ਜਾਣ ਵਾਲਿਆਂ ਨੂੰ ਕੱਜਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अधंध धंधे अकज्ज कज्जे ॥",
      "sourceLineId": "84597",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਭਿੰਨ ਭਿੰਨੇ ਅਭੱਜ ਭੱਜੇ ॥",
      "transliteration": "abhi(n)n bhi(n)ne abha'j bha'je ||",
      "translation": "She performs all forbidden works and she protects all vicious acts. She creates the sense of friendship in detached ones and the stable one run away when they face her.",
      "punjabiViakhya": "ਨ ਵੱਖ ਹੋਣ ਵਾਲਿਆਂ ਨੂੰ ਵੱਖ ਕਰ ਦਿੱਤਾ ਹੈ, ਨ ਭੱਜਣ ਵਾਲਿਆਂ ਨੂੰ ਲੱਭ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अभिंन भिंने अभज्ज भज्जे ॥",
      "sourceLineId": "84598",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਛੇੜ ਛੇੜੇ ਅਲੱਧ ਲੱਧੇ ॥",
      "transliteration": "achheR chheRe ala'dh la'dhe ||",
      "translation": "",
      "punjabiViakhya": "ਨ ਜਿੱਤੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਜਿੱਤ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अछेड़ छेड़े अलद्ध लद्धे ॥",
      "sourceLineId": "84599",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਜਿੱਤ ਜਿੱਤੇ ਅਬੱਧ ਬੱਧੇ ॥੨੩੦॥",
      "transliteration": "aji't ji'te aba'dh ba'dhe ||230||",
      "translation": "She teases the peaceful person and reveals a very mysterious one, she conquers the unconquerable and kills those cannot be killed.230.",
      "punjabiViakhya": "ਨ ਬੰਨ੍ਰਹੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਬੰਨ੍ਰਹ ਦਿੱਤਾ ॥੨੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अजित्त जित्ते अबद्ध बद्धे ॥२३०॥",
      "sourceLineId": "84600",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਚੀਰ ਚੀਰ ਅਤੋੜ ਤਾੜੇ ॥",
      "transliteration": "acheer cheer atoR taaRe ||",
      "translation": "",
      "punjabiViakhya": "ਨ ਚੀਰੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਚੀਰ ਦਿੱਤਾ, ਨ ਤਾੜੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਤਾੜ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अचीर चीर अतोड़ ताड़े ॥",
      "sourceLineId": "84601",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਠੱਟ ਠੱਟੇ ਅਪਾੜ ਪਾੜੇ ॥",
      "transliteration": "aTha'T Tha'Te apaaR paaRe ||",
      "translation": "She rips and breaks the hardest one, she establishes the unestablished and tears that which can’t be torn",
      "punjabiViakhya": "ਸਥਾਪਨਾ-ਹੀਣਾ ਨੂੰ ਸਥਾਪਿਤ ਕਰ ਦਿੱਤਾ, ਨ ਪਾਟਣ ਵਾਲਿਆਂ ਨੂੰ ਪਾੜ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अठट्ट ठट्टे अपाड़ पाड़े ॥",
      "sourceLineId": "84602",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਧੱਕ ਧੱਕੇ ਅਪੰਗ ਪੰਗੇ ॥",
      "transliteration": "adha'k dha'ke apa(n)g pa(n)ge ||",
      "translation": "",
      "punjabiViakhya": "ਨ ਧੱਕੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਧੱਕ ਦਿੱਤਾ, ਅਪੰਗ ਨੂੰ ਪੰਗੂ ਬਣਾ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अधक्क धक्के अपंग पंगे ॥",
      "sourceLineId": "84603",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਜੁੱਧ ਜੁੱਧੇ ਅਜੰਗ ਜੰਗੇ ॥੨੩੧॥",
      "transliteration": "aju'dh ju'dhe aja(n)g ja(n)ge ||231||",
      "translation": "She drives the immobile and makes a leper of a healthy person, she engages herself in battle with mighty ones an with whomsoever supremely strong person she fights, she lays obstructions in their art of war and finishes.231.",
      "punjabiViakhya": "ਯੁੱਧ ਤੋਂ ਹੀਣਾ ਨੂੰ ਯੁੱਧ ਵਿੱਚ ਰੁਝਾ ਦਿੱਤਾ, ਜੰਗ ਨ ਕਰਨ ਵਾਲਿਆਂ ਨੂੰ ਜੰਗ ਵਿੱਚ ਰੁਝਾ ਦਿੱਤਾ ॥੨੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अजुद्ध जुद्धे अजंग जंगे ॥२३१॥",
      "sourceLineId": "84604",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਕੁੱਟ ਕੁੱਟੇ ਅਘੁੱਟ ਘਾਏ ॥",
      "transliteration": "aku'T ku'Te aghu'T ghaae ||",
      "translation": "",
      "punjabiViakhya": "ਨ ਕੁੱਟੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਕੁਟਿਆ ਨ ਘੁੱਟੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਘੁੱਟਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अकुट्ट कुट्टे अघुट्ट घाए ॥",
      "sourceLineId": "84605",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਚੂਰ ਚੂਰੇ ਅਦਾਵ ਦਾਏ ॥",
      "transliteration": "achoor choore adhaav dhaae ||",
      "translation": "She has defeated the mighty ones and injured the invincible, she crushes those who cannot be crushed, she deceives the undeceivable",
      "punjabiViakhya": "ਨ ਚੂਰਨ ਹੋਣ ਵਾਲਿਆਂ ਨੂੰ ਚੂਰ-ਚੂਰ ਕਰ ਦਿੱਤਾ, ਦਾਓ ਵਿੱਚ ਨ ਫਸਣ ਵਾਲਿਆਂ ਨੂੰ ਫਸਾ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अचूर चूरे अदाव दाए ॥",
      "sourceLineId": "84606",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਭੀਰ ਭੀਰੇ ਅਭੰਗ ਭੰਗੇ ॥",
      "transliteration": "abheer bheere abha(n)g bha(n)ge ||",
      "translation": "",
      "punjabiViakhya": "ਅਭੀਰੂਆਂ ਨੂੰ ਭੀਰੂ ਬਣਾ ਦਿੱਤਾ, ਅਭੰਗਾ ਨੂੰ ਭੰਨ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अभीर भीरे अभंग भंगे ॥",
      "sourceLineId": "84607",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਟੁੱਕ ਟੁੱਕੇ ਅਕੰਗ ਕੰਗੇ ॥੨੩੨॥",
      "transliteration": "aTu'k Tu'ke aka(n)g ka(n)ge ||232||",
      "translation": "She frightens the fearless and destroys the indestructible, she break the unbreakable and turns into lepers those of healthy bodies.232.",
      "punjabiViakhya": "ਨ ਟੁੱਕੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਟੁੱਕ ਦਿੱਤਾ, ਬਿਨਾ ਕਵਚ ਵਾਲਿਆਂ ਨੂੰ ਕਵਚਾ ਵਾਲਾ ਕਰ ਦਿੱਤਾ ॥੨੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अटुक्क टुक्के अकंग कंगे ॥२३२॥",
      "sourceLineId": "84608",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਖਿੱਦ ਖੇਦੇ ਅਢਾਹ ਢਾਹੇ ॥",
      "transliteration": "akhi'dh khedhe addaeh ddaahe ||",
      "translation": "",
      "punjabiViakhya": "ਨਾ ਦੁਖੀ ਹੋਣ ਵਾਲਿਆਂ ਨੂੰ ਦੁਖੀ ਕਰ ਦਿੱਤਾ, ਨ ਢਹਿ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਢਾਹ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अखिद्द खेदे अढाह ढाहे ॥",
      "sourceLineId": "84609",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0223_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਗੰਜ ਗੰਜੇ ਅਬਾਹ ਬਾਹੇ ॥",
      "transliteration": "aga(n)j ga(n)je abaeh baahe ||",
      "translation": "She routs those who take a stand and pulls down those who are firm and stable  she breaks the unbreakable and ride over many, making them her slaves,",
      "punjabiViakhya": "ਨ ਗੰਜੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਗੰਜ ਦਿੱਤਾ ਨਾ ਪਕੜੇ ਜਾਣ ਵਾਲਿਆਂ ਨੂੰ ਪਕੜ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": "अगंज गंजे अबाह बाहे ॥",
      "sourceLineId": "84610",
      "sourceShabadId": "7935",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
