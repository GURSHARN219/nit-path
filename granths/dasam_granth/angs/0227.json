{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 227,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0227_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਾਤਾ ਬਾਚ ॥",
      "transliteration": "maataa baach ||",
      "translation": "Speech of the Mother :",
      "punjabiViakhya": "ਮਾਤਾ (ਕੁਸ਼ਲਿਆ) ਕਹਿੰਦੀ ਹੈ-",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "माता बाच ॥",
      "sourceLineId": "84731",
      "sourceShabadId": "7951",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਬਿੱਤ ॥",
      "transliteration": "kabi't ||",
      "translation": "KABIT",
      "punjabiViakhya": "ਕਬਿੱਤ",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "कबित्त ॥",
      "sourceLineId": "84732",
      "sourceShabadId": "7951",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਭੈ ਸੁਖ ਲੈ ਕੇ ਗਏ ਗਾੜੋ ਦੁਖ ਦੇਤ ਭਏ ਰਾਜਾ ਦਸਰਥ ਜੂ ਕੱਉ ਕੈ ਕੈ ਆਜ ਪਾਤ ਹੋ ॥",
      "transliteration": "sabhai sukh lai ke ge gaaRo dhukh dhet bhe raajaa dhasarath joo ka'au kai kai aaj paat ho ||",
      "translation": "They had taken all the comforts with them and giving us great agony, they have left us to see also the agony of the death of king Dasrath.",
      "punjabiViakhya": "ਸਾਰੇ ਸੁੱਖ ਲੈ ਕੇ ਚਲੇ ਗਏ ਹਨ, ਵੱਡੇ ਦੁੱਖ ਦੇ ਗਏ ਹਨ, ਰਾਜਾ ਦਸ਼ਰਥ ਵੀ ਅੱਜ ਮਰ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "सभै सुख लै के गए गाड़ो दुख देत भए राजा दसरथ जू कउ्उ कै कै आज पात हो ॥",
      "sourceLineId": "84733",
      "sourceShabadId": "7951",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਜ ਹੂੰ ਨ ਛੀਜੈ ਬਾਤ ਮਾਨ ਲੀਜੈ ਰਾਜ ਕੀਜੈ ਕਹੋ ਕਾਜ ਕਉਨ ਕੌ ਹਮਾਰੇ ਸ੍ਰੋਣ ਨਾਤ ਹੋ ॥",
      "transliteration": "aj hoo(n) na chheejai baat maan leejai raaj keejai kaho kaaj kaun kau hamaare sron naat ho ||",
      "translation": "The king ram, seeing and listening to all this, is not softening, O Ram! accept now whatever we say, please tell, who is the survivor Lord here?",
      "punjabiViakhya": "ਅਜੇ ਵੀ ਗੱਲ ਖ਼ਤਮ ਨਹੀਂ ਹੋਈ। ਮੇਰੀ ਗੱਲ ਮੰਨ ਲਵੋ ਅਤੇ ਰਾਜ ਕਰੋ, ਦੱਸੋ ਕਿਸ ਕੰਮ ਵਾਸਤੇ ਸਾਡੇ ਲਹੂ ਵਿੱਚ ਨਹਾਉਾਂਦੇ ਹੋ?",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "अज हूँ न छीजै बात मान लीजै राज कीजै कहो काज कउन कौ हमारे स्रोण नात हो ॥",
      "sourceLineId": "84734",
      "sourceShabadId": "7951",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰਾਜਸੀ ਕੇ ਧਾਰੌ ਸਾਜ ਸਾਧਨ ਕੈ ਕੀਜੈ ਕਾਜ ਕਹੋ ਰਘੁਰਾਜ ਆਜ ਕਾਹੇ ਕੱਉ ਸਿਧਾਤ ਹੋ ॥",
      "transliteration": "raajasee ke dhaarau saaj saadhan kai keejai kaaj kaho raghuraaj aaj kaahe ka'au sidhaat ho ||",
      "translation": "O Ram! take the reins of kingdom and do all the work. Tell us, why are you going now?",
      "punjabiViakhya": "ਰਾਜਿਆਂ ਦਾ ਸਾਜ ਧਾਰੋ, ਸੰਤਾ ਵਾਲੇ ਕੰਮ ਕਰੋ। ਹੇ ਰਾਮ ਚੰਦਰ! ਦੱਸੋ, ਅੱਜ (ਬਣ ਨੂੰ) ਕਿਸ ਲਈ ਤੁਰੋ ਜਾਦੇ ਹੋ?",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "राजसी के धारौ साज साधन कै कीजै काज कहो रघुराज आज काहे कउ्उ सिधात हो ॥",
      "sourceLineId": "84735",
      "sourceShabadId": "7951",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਾਪਸੀ ਕੇ ਭੇਸ ਕੀਨੇ ਜਾਨਕੀ ਕੌ ਸੰਗ ਲੀਨੇ ਮੇਰੇ ਬਨਬਾਸੀ ਮੋ ਉਦਾਸੀ ਦੀਏ ਜਾਤ ਹੋ ॥੨੬੫॥",
      "transliteration": "taapasee ke bhes keene jaanakee kau sa(n)g leene mere banabaasee mo udhaasee dhe'ee jaat ho ||265||",
      "translation": "O exiled Ram in the garb of an ascetic and taking Janaki (Sita) with you, why are you giving me sadness?265.",
      "punjabiViakhya": "ਤਪਸਵੀਆਂ ਦਾ ਭੇਸ ਕੀਤਾ ਹੋਇਆ ਹੈ ਅਤੇ ਸੀਤਾ ਨੂੰ ਨਾਲ ਲਿਆ ਹੋਇਆ ਹੈ। ਹੇ ਬਨਵਾਸੀ (ਪੁੱਤਰ) ਮੈਨੂੰ ਉਦਾਸੀ ਦੇਈ ਜਾਦੇ ਹੋ ॥੨੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "तापसी के भेस कीने जानकी कौ संग लीने मेरे बनबासी मो उदासी दीए जात हो ॥२६५॥",
      "sourceLineId": "84736",
      "sourceShabadId": "7951",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਾਰੇ ਕਾਰੇ ਕਰਿ ਬੇਸ ਰਾਜਾ ਜੂ ਕੌ ਛੋਰਿ ਦੇਸ ਤਾਪਸੀ ਕੋ ਕੈ ਭੇਸ ਸਾਥਿ ਹੀ ਸਿਧਾਰਿ ਹੌ ॥",
      "transliteration": "kaare kaare kar bes raajaa joo kau chhor dhes taapasee ko kai bhes saath hee sidhaar hau ||",
      "translation": "I shall also put on the black garb leaving the country of the king, and becoming an ascetic, I shall accompany you.",
      "punjabiViakhya": "(ਮੈਂ) ਕਾਲਾ ਕਾਲਾ ਵੇਸ ਕਰਕੇ, ਰਾਜਾ ਜੀ ਦਾ ਦੇਸ਼ ਛੱਡ ਕੇ ਤਪਸਵੀਆਂ ਦਾ ਭੇਸ ਧਾਰਨ ਕਰਕੇ, (ਤੁਹਾਡੇ) ਨਾਲ ਹੀ ਚਲਦੀ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "कारे कारे करि बेस राजा जू कौ छोरि देस तापसी को कै भेस साथि ही सिधारि हौ ॥",
      "sourceLineId": "84737",
      "sourceShabadId": "7951",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕੁਲ ਹੂੰ ਕੀ ਕਾਨ ਛੋਰੋਂ ਰਾਜਸੀ ਕੇ ਸਾਜ ਤੋਰੋਂ ਸੰਗਿ ਤੇ ਨ ਮੋਰੋਂ ਮੁਖ ਐਸੋ ਕੈ ਬਿਚਾਰਿ ਹੌ ॥",
      "transliteration": "kul hoo(n) kee kaan chhoro(n) raajasee ke saaj toro(n) sa(n)g te na moro(n) mukh aaiso kai bichaar hau ||",
      "translation": "I shall leave the family practice and abandon the royal splendour, but shall not turn my face away from you.",
      "punjabiViakhya": "ਕੁਲ ਦੀ ਮਰਿਆਦਾ ਨੂੰ ਛੱਡਦੀ ਹਾ, ਰਾਜਸੀ ਸਾਜ ਤੋੜਦੀ ਹਾ (ਪਰ ਤੇਰੇ) ਨਾਲ ਜਾਣ ਤੋਂ ਮੂੰਹ ਨਹੀਂ ਮੋੜਾਗੀ। ਅਜਿਹਾ ਵਿਚਾਰ ਕਰਦੀ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "कुल हूँ की कान छोरों राजसी के साज तोरों संगि ते न मोरों मुख ऐसो कै बिचारि हौ ॥",
      "sourceLineId": "84738",
      "sourceShabadId": "7951",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮੁੰਦ੍ਰਾ ਕਾਨ ਧਾਰੌ ਸਾਰੇ ਮੁਖ ਪੈ ਬਿਭੂਤਿ ਡਾਰੌਂ ਹਠਿ ਕੋ ਨ ਹਾਰੌਂ ਪੂਤ ਰਾਜ ਸਾਜ ਜਾਰਿ ਹੌਂ ॥",
      "transliteration": "mu(n)dhraa kaan dhaarau saare mukh pai bibhoot ddaaraua(n) haTh ko na haaraua(n) poot raaj saaj jaar haua(n) ||",
      "translation": "I shall wear the rings in the ear and smear the ashes over my body. I shall live in persistence, O my son! I shall forsake all the royal paraphernalia.",
      "punjabiViakhya": "ਕੰਨਾ ਵਿੱਚ ਮੁੰਦਰਾ ਪਾ ਲਵਾਗੀ, ਸਾਰੇ ਮੂੰਹ ਉੱਤੇ ਸੁਆਹ ਮਲ ਲਵਾਗੀ, ਹੇ ਪੁੱਤਰ! ਹਠ ਤੋਂ ਨਹੀਂ ਹਾਰਾਗੀ, ਰਾਜ ਦੇ ਸਾਜ ਨੂੰ ਸਾੜਾਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "मुँद्रा कान धारौ सारे मुख पै बिभूति डारौं हठि को न हारौं पूत राज साज जारि हौं ॥",
      "sourceLineId": "84739",
      "sourceShabadId": "7951",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜੁਗੀਆ ਕੋ ਕੀਨੋ ਬੇਸ ਕਉਸਲ ਕੇ ਛੋਰ ਦੇਸ ਰਾਜਾ ਰਾਮਚੰਦ ਜੂ ਕੇ ਸੰਗਿ ਹੀ ਸਿਧਾਰਿ ਹੌਂ ॥੨੬੬॥",
      "transliteration": "jugeeaa ko keeno bes kausal ke chhor dhes raajaa raamacha(n)dh joo ke sa(n)g hee sidhaar haua(n) ||266||",
      "translation": "I shall adopt the garb of a yogi, and leaving Kaushal (country), I shall go with the king Ram.266.",
      "punjabiViakhya": "ਯੋਗੀਆਂ ਵਾਲਾ ਭੇਸ ਕਰਕੇ ਕੌਸ਼ਲ ਦੇਸ਼ ਦੇ ਕਲੇਸ਼ਾ ਨੂੰ ਛੱਡ ਕੇ ਰਾਜਾ ਰਾਮ ਚੰਦਰ ਜੀ ਦੇ ਨਾਲ ਬਣ ਨੂੰ ਜਾਵਾਗੀ ॥੨੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "जुगीआ को कीनो बेस कउसल के छोर देस राजा रामचंद जू के संगि ही सिधारि हौं ॥२६६॥",
      "sourceLineId": "84740",
      "sourceShabadId": "7951",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਪੂਰਬ ਛੰਦ ॥",
      "transliteration": "apoorab chha(n)dh ||",
      "translation": "APOORAV STANZA",
      "punjabiViakhya": "ਅਪੂਰਬ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "अपूरब छंद ॥",
      "sourceLineId": "84741",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਾਨਨੇ ਗੇ ਰਾਮ ॥",
      "transliteration": "kaanane ge raam ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਚੰਦਰ ਬਣ ਵਿੱਚ ਗਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "कानने गे राम ॥",
      "sourceLineId": "84742",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਧਰਮ ਕਰਮੰ ਧਾਮ ॥",
      "transliteration": "dharam karama(n) dhaam ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੜੇ ਧਰਮ-ਕਰਮ ਦਾ ਘਰ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "धरम करमं धाम ॥",
      "sourceLineId": "84743",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਲੱਛਨੈ ਲੈ ਸੰਗਿ ॥",
      "transliteration": "la'chhanai lai sa(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਲੱਛਮਣ ਨੂੰ ਨਾਲ ਲੈ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "लच्छनै लै संगि ॥",
      "sourceLineId": "84744",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਾਨਕੀ ਸੁਭੰਗਿ ॥੨੬੭॥",
      "transliteration": "jaanakee subha(n)g ||267||",
      "translation": "Ram, the abode of religious action, went to the forest alongwith Lakshman and Janaki (Sita).267.",
      "punjabiViakhya": "ਸੁੰਦਰ ਸੀਤਾ (ਵੀ ਨਾਲ ਲੈ ਗਏ) ਹਨ ॥੨੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "जानकी सुभंगि ॥२६७॥",
      "sourceLineId": "84745",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਾਤ ਤਿਆਗੇ ਪ੍ਰਾਨ ॥",
      "transliteration": "taat tiaage praan ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਤਾ ਨੇ ਪ੍ਰਾਣ ਤਿਆਗ ਦਿੱਤੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "तात तिआगे प्रान ॥",
      "sourceLineId": "84746",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਉੱਤਰੇ ਬਯੋਮਾਨ ॥",
      "transliteration": "au'tare bayomaan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਲਈ ਸੁਅਰਗ ਤੋਂ) ਬਿਮਾਨ ਉਤਰੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "उत्तरे बयोमान ॥",
      "sourceLineId": "84747",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਿੱਚਰੇ ਬਿਚਾਰ ॥",
      "transliteration": "bi'chare bichaar ||",
      "translation": "",
      "punjabiViakhya": "(ਇਧਰ) ਅਨੇਕ ਮੰਤਰੀ ਬੈਠ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "बिच्चरे बिचार ॥",
      "sourceLineId": "84748",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮੰਤ੍ਰੀਯੰ ਅਪਾਰ ॥੨੬੮॥",
      "transliteration": "ma(n)treeya(n) apaar ||268||",
      "translation": "On that side the father breathed his last and left for heaven in and air-vehicle of gods. On this side, the ministers reflected on the situation.268.",
      "punjabiViakhya": "ਵਿਚਾਰ ਵਟਾਦਰਾ ਕਰ ਰਹੇ ਹਨ ॥੨੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "मंत्रीयं अपार ॥२६८॥",
      "sourceLineId": "84749",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬੈਠਯੋ ਬਸਿਸਟਿ ॥",
      "transliteration": "baiThayo basisaT ||",
      "translation": "",
      "punjabiViakhya": "ਵਸ਼ਿਸ਼ਟ ਬੈਠੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "बैठयो बसिसटि ॥",
      "sourceLineId": "84750",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਰਬ ਬਿੱਪ ਇਸਟ ॥",
      "transliteration": "sarab bi'p isaT ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸਾਰਿਆਂ ਬ੍ਰਾਹਮਣਾ ਦੇ ਪੂਜਣ ਯੋਗ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "सरब बिप्प इसट ॥",
      "sourceLineId": "84751",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮੁਕੱਲਿਯੋ ਕਾਗਦ ॥",
      "transliteration": "muka'liyo kaagadh ||",
      "translation": "",
      "punjabiViakhya": "(ਭਰਤ ਨੂੰ) ਪੱਤਰ ਭੇਜਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "मुकल्लियो कागद ॥",
      "sourceLineId": "84752",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪੱਠਏ ਮਾਗਧ ॥੨੬੯॥",
      "transliteration": "pa'The maagadh ||269||",
      "translation": "The advice of vasishtha, the eminent Brahmin amongst all the Brahmins, was accepted. A letter was written and sent to Magadh.269.",
      "punjabiViakhya": "(ਜਿਸ ਲਈ) ਮਾਗਧ (ਦੂਤ) ਨੂੰ ਘਲਿਆ ਹੈ ॥੨੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "पट्ठए मागध ॥२६९॥",
      "sourceLineId": "84753",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੰਕੜੇਸਾ ਵੰਤ ॥",
      "transliteration": "sa(n)kaResaa va(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਤਿਨਿਧ ਸਾਮੰਤਾ ਨੇ (ਬੈਠ ਕੇ)",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "संकड़ेसा वंत ॥",
      "sourceLineId": "84754",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮੱਤਏ ਮੱਤੰਤ ॥",
      "transliteration": "ma'te ma'ta(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਤਜਵੀਜ਼ਾ ਕੀਤੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "मत्तए मत्तंत ॥",
      "sourceLineId": "84755",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੁੱਕਲੇ ਕੇ ਦੂਤ ॥",
      "transliteration": "mu'kale ke dhoot ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੌਣ ਦੇ ਪੁੱਤਰ ਵਾਗ ਤੇਜ਼ ਚੱਲਣ ਵਾਲੇ",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "मुक्कले के दूत ॥",
      "sourceLineId": "84756",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪਉਨ ਕੇ ਸੇ ਪੂਤ ॥੨੭੦॥",
      "transliteration": "paun ke se poot ||270||",
      "translation": "A very brief discussion was held and several fast-moving messengers like Hanuman were sent.270.",
      "punjabiViakhya": "ਦੂਤ ਭੇਜ ਦਿੱਤੇ ॥੨੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "पउन के से पूत ॥२७०॥",
      "sourceLineId": "84757",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਸਟਨ ਦਯੰਲਾਖ ॥",
      "transliteration": "asaTan dhaya(n)laakh ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਠ ਨਦੀਆਂ ਲੰਘ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "असटन दयंलाख ॥",
      "sourceLineId": "84758",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੂਤ ਗੇ ਚਰਬਾਖ ॥",
      "transliteration": "dhoot ge charabaakh ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਜਾਨ ਦੂਤ ਚਲੇ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "दूत गे चरबाख ॥",
      "sourceLineId": "84759",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭਰਤ ਆਗੇ ਜਹਾ ॥",
      "transliteration": "bharat aage jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਗੇ ਭਰਤ ਜਿੱਥੇ (ਰਹਿੰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "भरत आगे जहा ॥",
      "sourceLineId": "84760",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਾਤ ਭੇ ਤੇ ਤਹਾ ॥੨੭੧॥",
      "transliteration": "jaat bhe te tahaa ||271||",
      "translation": "Ten messengers, who were specialist in their task, were searched and sent to the place where Bharat resided.271.",
      "punjabiViakhya": "ਦੂਤ) ਉਥੇ ਜਾ ਕੇ ਪਹੁੰਚੇ ॥੨੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "जात भे ते तहा ॥२७१॥",
      "sourceLineId": "84761",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਉਚਰੇ ਸੰਦੇਸ ॥",
      "transliteration": "auchare sa(n)dhes ||",
      "translation": "",
      "punjabiViakhya": "(ਭਰਤ ਨੂੰ ਦੂਤ ਨੇ) ਸੁਨੇਹਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "उचरे संदेस ॥",
      "sourceLineId": "84762",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਊਰਧ ਗੇ ਅਉਧੇਸ ॥",
      "transliteration": "uooradh ge aaudhes ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਰਾਜਾ ਦਸ਼ਰਥ ਸੁਅਰਗ (ਉਰਧ) ਚਲੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "ऊरध गे अउधेस ॥",
      "sourceLineId": "84763",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪੱਤ੍ਰ ਬਾਚੇ ਭਲੇ ॥",
      "transliteration": "pa'tr baache bhale ||",
      "translation": "",
      "punjabiViakhya": "(ਭਰਤ ਨੇ) ਚੰਗੀ ਤਰ੍ਰਹਾ ਪੱਤਰ ਪੜ੍ਰਹ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "पत्त्र बाचे भले ॥",
      "sourceLineId": "84764",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਲਾਗ ਸੰਗੰ ਚਲੇ ॥੨੭੨॥",
      "transliteration": "laag sa(n)ga(n) chale ||272||",
      "translation": "Those messengers delivered the message and told that the king Dasrath had died, Bharat read the letter and accompanied them.272.",
      "punjabiViakhya": "ਅਤੇ (ਉਨ੍ਰਹਾ ਨਾਲ) ਲੱਗ ਕੇ ਤੁਰ ਪਿਆ ॥੨੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "लाग संगं चले ॥२७२॥",
      "sourceLineId": "84765",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕੋਪ ਜੀਯੰ ਜਗਯੋ ॥",
      "transliteration": "kop jeeya(n) jagayo ||",
      "translation": "",
      "punjabiViakhya": "(ਭਰਤ ਦੇ) ਜੀਅ ਵਿੱਚ ਕ੍ਰੋਧ ਜਾਗ ਪਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "कोप जीयं जगयो ॥",
      "sourceLineId": "84766",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਧਰਮ ਭਰਮੰ ਭਗਯੋ ॥",
      "transliteration": "dharam bharama(n) bhagayo ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਮ ਦਾ ਭਰਮ ਮਿਟ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "धरम भरमं भगयो ॥",
      "sourceLineId": "84767",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਾਸਮੀਰੰ ਤਜਯੋ ॥",
      "transliteration": "kaasameera(n) tajayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਸ਼ਮੀਰ ਨੂੰ ਛੱਡ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "कासमीरं तजयो ॥",
      "sourceLineId": "84768",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਾਮ ਰਾਮੰ ਭਜਯੋ ॥੨੭੩॥",
      "transliteration": "raam raama(n) bhajayo ||273||",
      "translation": "The anger blazed in his mind and the sense of Dharma and respect disappeared from it. They left Kashmir (and started on return journey) and began to remember the Lord.273.",
      "punjabiViakhya": "ਅਤੇ ਰਾਮ ਨਾਮ ਜਪਣ ਲੱਗ ਪਿਆ ॥੨੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "राम रामं भजयो ॥२७३॥",
      "sourceLineId": "84769",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪੁੱਜਏ ਅਵੱਧ ॥",
      "transliteration": "pu'je ava'dh ||",
      "translation": "",
      "punjabiViakhya": "ਅਯੁੱਧਿਆ ਵਿੱਚ ਪਹੁੰਚ ਗਿਆ-",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "पुज्जए अवद्ध ॥",
      "sourceLineId": "84770",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੂਰਮਾ ਸਨੱਧ ॥",
      "transliteration": "sooramaa sana'dh ||",
      "translation": "",
      "punjabiViakhya": "ਹਥਿਆਰ ਬੰਦ ਸੂਰਮਾ (ਭਰਤ)",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "सूरमा सनद्ध ॥",
      "sourceLineId": "84771",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਹੇਰਿਓ ਅਉਧੇਸ ॥",
      "transliteration": "herio aaudhes ||",
      "translation": "",
      "punjabiViakhya": "ਆਉਧ ਦੇ ਰਾਜੇ (ਦਸ਼ਰਥ) ਨੂੰ ਵੇਖਿਆ-",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "हेरिओ अउधेस ॥",
      "sourceLineId": "84772",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮ੍ਰਿਤਕੰ ਕੇ ਭੇਸ ॥੨੭੪॥",
      "transliteration": "mritaka(n) ke bhes ||274||",
      "translation": "The brave hero Bharat reached Oudh and saw the king Dasrath as dead.274.",
      "punjabiViakhya": "ਮੁਰਦਾ ਰੂਪ ਵਿੱਚ ॥੨੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "मृतकं के भेस ॥२७४॥",
      "sourceLineId": "84773",
      "sourceShabadId": "7952",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਭਰਥ ਬਾਚ ਕੇਕਈ ਸੋਂ ॥",
      "transliteration": "bharath baach kekiee so(n) ||",
      "translation": "Speech of Bharat addressed to Kaikeyi :",
      "punjabiViakhya": "ਕੈਕਈ ਪ੍ਰਤਿ ਭਰਤ ਨੇ ਕਿਹਾ-",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "भरथ बाच केकई सों ॥",
      "sourceLineId": "84774",
      "sourceShabadId": "7953",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਲਖਯੋ ਕਸੂਤ ॥",
      "transliteration": "lakhayo kasoot ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦੋਂ ਉਥੇ ਪਹੁੰਚ ਕੇ) ਬੇ-ਮਰਿਆਦਗੀ ਵੇਖੀ",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "लखयो कसूत ॥",
      "sourceLineId": "84775",
      "sourceShabadId": "7953",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬੁੱਲਯੋ ਸਪੂਤ ॥",
      "transliteration": "bu'layo sapoot ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸੁਪੁੱਤਰ (ਭਰਤ) ਨੇ ਕਿਹਾ-",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "बुल्लयो सपूत ॥",
      "sourceLineId": "84776",
      "sourceShabadId": "7953",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਧ੍ਰਿਗ ਮਈਯਾ ਤੋਹਿ ॥",
      "transliteration": "dhirag mieeyaa toh ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮਾਤਾ! ਤੈਨੂੰ ਧ੍ਰਿਕਾਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "धृग मईया तोहि ॥",
      "sourceLineId": "84777",
      "sourceShabadId": "7953",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0227_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਲਜਿ ਲਾਈਯਾ ਮੋਹਿ ॥੨੭੫॥",
      "transliteration": "laj laieeyaa moh ||275||",
      "translation": "“O mother! when you saw that the worst had happened and then you called your son  you must be reproached, I feel ashamed. 275.",
      "punjabiViakhya": "(ਤੂੰ) ਮੈਨੂੰ ਲਾਜ ਲਗਵਾਈ ਹੈ ॥੨੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": "लजि लाईया मोहि ॥२७५॥",
      "sourceLineId": "84778",
      "sourceShabadId": "7953",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
