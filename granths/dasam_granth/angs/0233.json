{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 233,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0233_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪ੍ਰਭ ਭ੍ਰਾਤ ਸੰਗਿ ॥",
      "transliteration": "prabh bhraat sa(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਚੰਦਰ ਭਰਾ ਸਹਿਤ",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "प्रभ भ्रात संगि ॥",
      "sourceLineId": "84995",
      "sourceShabadId": "7963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੀਅ ਸੰਗ ਸੁਰੰਗ ॥",
      "transliteration": "seea sa(n)g sura(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਰਮ ਸੁੰਦਰੀ ਸੀਤਾ ਨੂੰ ਨਾਲ ਲੈ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "सीअ संग सुरंग ॥",
      "sourceLineId": "84996",
      "sourceShabadId": "7963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਜਿ ਚਿੰਤ ਅੰਗ ॥",
      "transliteration": "taj chi(n)t a(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਸਰੀਰ ਦੀ ਚਿੰਤਾ ਛੱਡਦੇ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "तजि चिंत अंग ॥",
      "sourceLineId": "84997",
      "sourceShabadId": "7963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਧਸ ਬਨ ਨਿਸੰਗ ॥੩੨੭॥",
      "transliteration": "dhas ban nisa(n)g ||327||",
      "translation": "Ram, alongwith his winsome wife Sita and his brother moved fearlessly in the dense forest, forsaking all his anxieties.327.",
      "punjabiViakhya": "ਨਿਸੰਗ ਹੀ ਬਣ ਵਿੱਚ ਜਾ ਵੜੇ ॥੩੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "धस बन निसंग ॥३२७॥",
      "sourceLineId": "84998",
      "sourceShabadId": "7963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਧਰਿ ਬਾਨ ਪਾਨ ॥",
      "transliteration": "dhar baan paan ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨੇ) ਹੱਥ ਵਿਚ ਬਾਣ ਧਾਰਨ ਕੀਤਾ ਹੋਇਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "धरि बान पान ॥",
      "sourceLineId": "84999",
      "sourceShabadId": "7963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਟਿ ਕਸਿ ਕ੍ਰਿਪਾਨ ॥",
      "transliteration": "kaT kas kirapaan ||",
      "translation": "",
      "punjabiViakhya": "ਲੱਕ ਨਾਲ ਤਲਵਾਰ ਬੰਨ੍ਰਹੀ ਹੋਈ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "कटि कसि कृपान ॥",
      "sourceLineId": "85000",
      "sourceShabadId": "7963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭੁਜ ਬਰ ਅਜਾਨ ॥",
      "transliteration": "bhuj bar ajaan ||",
      "translation": "",
      "punjabiViakhya": "ਗੋਡਿਆਂ (ਅਜਾਨੁ) ਤਕ (ਜਿਨ੍ਰਹਾ ਦੀਆਂ) ਸੁੰਦਰ ਬਾਹਾ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "भुज बर अजान ॥",
      "sourceLineId": "85001",
      "sourceShabadId": "7963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਚਲ ਤੀਰਥ ਨਾਨ ॥੩੨੮॥",
      "transliteration": "chal teerath naan ||328||",
      "translation": "With his sword tied by the waist and holding the arrows in him hand, the long-armed heroes started for the bath at pilgrim-stations.328.",
      "punjabiViakhya": "(ਉਹ ਰਾਮ) ਚਲ ਕੇ ਤੀਰਥ ਵਿੱਚ ਇਸ਼ਨਾਨ ਕਰਨ ਲੱਗੇ ॥੩੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "चल तीरथ नान ॥३२८॥",
      "sourceLineId": "85002",
      "sourceShabadId": "7963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗੋਦਾਵਰਿ ਤੀਰ ॥",
      "transliteration": "godhaavar teer ||",
      "translation": "",
      "punjabiViakhya": "ਗੋਦਾਵਰੀ ਦੇ ਕੰਢੇ ਉਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "गोदावरि तीर ॥",
      "sourceLineId": "85003",
      "sourceShabadId": "7963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗਏ ਸਹਿਤ ਬੀਰ ॥",
      "transliteration": "ge sahit beer ||",
      "translation": "",
      "punjabiViakhya": "(ਸ੍ਰੀ ਰਾਮ) ਭਰਾ ਸਹਿਤ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "गए सहित बीर ॥",
      "sourceLineId": "85004",
      "sourceShabadId": "7963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਜ ਰਾਮ ਚੀਰ ॥",
      "transliteration": "taj raam cheer ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਸਤ੍ਰ ਉਤਾਰ ਕੇ ਰਾਮ ਚੰਦਰ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "तज राम चीर ॥",
      "sourceLineId": "85005",
      "sourceShabadId": "7963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕੀਅ ਸੁਚ ਸਰੀਰ ॥੩੨੯॥",
      "transliteration": "keea such sareer ||329||",
      "translation": "He reached on the bank of Godavari alongwith his heroic brother and there Ram put off his clothes and took a bath, thus cleansing his body.329.­",
      "punjabiViakhya": "(ਇਸ਼ਨਾਨ ਕਰਕੇ) ਸਰੀਰ ਨੂੰ ਪਵਿੱਤਰ ਕੀਤਾ ॥੩੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "कीअ सुच सरीर ॥३२९॥",
      "sourceLineId": "85006",
      "sourceShabadId": "7963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਲਖਿ ਰਾਮ ਰੂਪ ॥",
      "transliteration": "lakh raam roop ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਚੰਦਰ ਦੇ ਅਦਭੁਤ",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "लखि राम रूप ॥",
      "sourceLineId": "85007",
      "sourceShabadId": "7963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਤਿਭੁਤ ਅਨੂਪ ॥",
      "transliteration": "atibhut anoop ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਨੂਪਮ ਰੂਪ ਨੂੰ ਵੇਖ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "अतिभुत अनूप ॥",
      "sourceLineId": "85008",
      "sourceShabadId": "7963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਹ ਹੁਤੀ ਸੂਪ ॥",
      "transliteration": "jeh hutee soop ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਸ਼ੂਰਪਣਖਾ ਰਹਿੰਦੀ ਹੁੰਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "जह हुती सूप ॥",
      "sourceLineId": "85009",
      "sourceShabadId": "7963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਹ ਗਏ ਭੂਪ ॥੩੩੦॥",
      "transliteration": "teh ge bhoop ||330||",
      "translation": "Ram had a marvellous body, when he came out after bath, on seeing his beauty the official of the place went to the royal lady Surapanakha.330.",
      "punjabiViakhya": "(ਉਸ) ਬਣ ਦੇ ਰਾਖੇ ਉਥੇ ਚਲੇ ਗਏ ॥੩੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "तह गए भूप ॥३३०॥",
      "sourceLineId": "85010",
      "sourceShabadId": "7963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਹੀ ਤਾਹਿ ਧਾਤਿ ॥",
      "transliteration": "kahee taeh dhaat ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਖਿਆਂ ਨੇ) ਜਾ ਕੇ ਉਸ ਨੂੰ ਕਿਹਾ-",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "कही ताहि धाति ॥",
      "sourceLineId": "85011",
      "sourceShabadId": "7963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੁਨਿ ਸੂਪ ਬਾਤਿ ॥",
      "transliteration": "sun soop baat ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸ਼ੂਰਪਣਖਾ! (ਤੂੰ ਸਾਡੀ ਗੱਲ ਨੂੰ) ਸੁਣ ਲੈ,",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "सुनि सूप बाति ॥",
      "sourceLineId": "85012",
      "sourceShabadId": "7963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦੁਐ ਅਤਿਥ ਨਾਤ ॥",
      "transliteration": "dhuaai atith naat ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਡੇ ਬਣ ਵਿੱਚ ਦੋ ਸਾਧੂਆਂ ਨੇ ਆ ਕੇ ਇਸ਼ਨਾਨ ਕੀਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "दुऐ अतिथ नात ॥",
      "sourceLineId": "85013",
      "sourceShabadId": "7963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਲਹਿ ਅਨੂਪ ਗਾਤ ॥੩੩੧॥",
      "transliteration": "leh anoop gaat ||331||",
      "translation": "They said to her, “Please listen to us O royal lady! two strangers of unique bodies have come to our kingeom.”331.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਅਨੂਪਮ ਸਰੀਰ ਪ੍ਰਾਪਤ ਕੀਤੇ ਹੋਏ ਹਨ ॥੩੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "लहि अनूप गात ॥३३१॥",
      "sourceLineId": "85014",
      "sourceShabadId": "7963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੁੰਦਰੀ ਛੰਦ ॥",
      "transliteration": "su(n)dharee chha(n)dh ||",
      "translation": "SUNDARI STANZA",
      "punjabiViakhya": "ਸੁੰਦਰੀ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "सुँदरी छंद ॥",
      "sourceLineId": "85015",
      "sourceShabadId": "7964",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੂਪਨਖਾ ਇਹ ਭਾਤਿ ਸੁਨੀ ਜਬ ॥",
      "transliteration": "soopanakhaa ieh bhaat sunee jab ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਪਣਖਾ ਨੇ ਜਦੋਂ ਇਸ ਤਰ੍ਰਹਾ ਦੀ ਗੱਲ ਸੁਣੀ,",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "सूपनखा इह भाति सुनी जब ॥",
      "sourceLineId": "85016",
      "sourceShabadId": "7964",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਧਾਇ ਚਲੀ ਅਬਿਲੰਬ ਤ੍ਰਿਯਾ ਤਬ ॥",
      "transliteration": "dhai chalee abila(n)b tirayaa tab ||",
      "translation": "When Surapanakha heard these words, she immediately started and reaching there,",
      "punjabiViakhya": "ਤਦ ਉਹ ਇਸਤਰੀ ਬਿਨਾ ਦੇਰ ਕੀਤੇ ਧਾਈ ਕਰਕੇ ਤੁਰ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "धाइ चली अबिलंब तृया तब ॥",
      "sourceLineId": "85017",
      "sourceShabadId": "7964",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0233_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਾਮ ਸਰੂਪ ਕਲੇਵਰ ਜਾਨੈ ॥",
      "transliteration": "kaam saroop kalevar jaanai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਰਾਮ ਚੰਦਰ ਦੇ ਸਰੀਰ ਨੂੰ ਕਾਮ ਸਰੂਪ ਕਰਕੇ ਜਾਣ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 233,
      "hindi": "",
      "hindiTransliteration": "काम सरूप कलेवर जानै ॥",
      "sourceLineId": "85018",
      "sourceShabadId": "7964",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
