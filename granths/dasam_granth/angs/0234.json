{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 234,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0234_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰੂਪ ਅਨੂਪ ਤਿਹੂੰ ਪੁਰ ਮਾਨੈ ॥੩੩੨॥",
      "transliteration": "roop anoop tihoo(n) pur maanai ||332||",
      "translation": "She considered all of them as Cupid-incarnate and believed in her mind that no one equaled them in beauty.332.",
      "punjabiViakhya": "ਉਹ ਰੂਪ ਅਨੂਪਮ ਅਤੇ ਤਿੰਨ ਲੋਕਾ ਵਿੱਚ ਮੰਨਣ ਯੋਗ ਸੀ ॥੩੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "रूप अनूप तिहूँ पुर मानै ॥३३२॥",
      "sourceLineId": "85019",
      "sourceShabadId": "7964",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਧਾਇ ਕਹਯੋ ਰਘੁਰਾਇ ਭਏ ਤਿੱਹ ॥",
      "transliteration": "dhai kahayo raghurai bhe ti'h ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਰਾਮ ਸਨ, (ਉਹ ਉਥੇ) ਭੱਜ ਕੇ ਪਹੁੰਚੀ (ਅਤੇ ਇਸ ਤਰ੍ਰਹਾ) ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "धाइ कहयो रघुराइ भए तिह्ह ॥",
      "sourceLineId": "85020",
      "sourceShabadId": "7964",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜੈਸ ਨ੍ਰਿਲਾਜ ਕਹੈ ਨ ਕੋਊ ਕਿੱਹ ॥",
      "transliteration": "jais niralaaj kahai na kouoo ki'h ||",
      "translation": "Coming before Ram, without feeling ashamed, she said :",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਕੋਈ ਨਿਰਲੱਜ ਇਸਤਰੀ ਵੀ ਕਿਸੇ ਨੂੰ ਨਹੀਂ ਕਹਿ ਸਕਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "जैस नृलाज कहै न कोऊ किह्ह ॥",
      "sourceLineId": "85021",
      "sourceShabadId": "7964",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹਉ ਅਟਕੀ ਤੁਮਰੀ ਛਬਿ ਕੇ ਬਰ ॥",
      "transliteration": "hau aTakee tumaree chhab ke bar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਕਹਿਣ ਲੱਗੀ-) ਹੇ ਪ੍ਰਿਯ! ਮੈਂ ਤੁਹਾਡੀ ਸੁੰਦਰਤਾ ਉਤੇ ਮੋਹਿਤ ਹੋ ਗਈ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "हउ अटकी तुमरी छबि के बर ॥",
      "sourceLineId": "85022",
      "sourceShabadId": "7964",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰੰਗ ਰੰਗੀ ਰੰਗਏ ਦ੍ਰਿਗ ਦੂਪਰ ॥੩੩੩॥",
      "transliteration": "ra(n)g ra(n)gee ra(n)ge dhirag dhoopar ||333||",
      "translation": "“I have halted here because of your beauty and my mind is dyed with the dye of your intoxicated eyes.”333.",
      "punjabiViakhya": "ਤੁਹਾਡੇ ਦੋਹਾ ਨੈਣਾ ਦੇ ਰੰਗ ਵਿੱਚ ਰੰਗੀ ਗਈ ਹਾ ॥੩੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "रंग रंगी रंगए दृग दूपर ॥३३३॥",
      "sourceLineId": "85023",
      "sourceShabadId": "7964",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਾਮ ਬਾਚ ॥",
      "transliteration": "raam baach ||",
      "translation": "Speech of Ram",
      "punjabiViakhya": "ਰਾਮ ਨੇ ਕਿਹਾ-",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "राम बाच ॥",
      "sourceLineId": "85024",
      "sourceShabadId": "7965",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੁੰਦਰੀ ਛੰਦ ॥",
      "transliteration": "su(n)dharee chha(n)dh ||",
      "translation": "SUNDARI STANZA",
      "punjabiViakhya": "ਸੁੰਦਰੀ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "सुँदरी छंद ॥",
      "sourceLineId": "85025",
      "sourceShabadId": "7965",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਾਹ ਤਹਾ ਜਹ ਭ੍ਰਾਤਿ ਹਮਾਰੇ ॥",
      "transliteration": "jaeh tahaa jeh bhraat hamaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਜਾ, ਜਿਥੇ ਮੇਰਾ ਛੋਟਾ ਭਰਾ ਬੈਠਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "जाह तहा जह भ्राति हमारे ॥",
      "sourceLineId": "85026",
      "sourceShabadId": "7965",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਵੈ ਰਿਝਹੈ ਲਖ ਨੈਨ ਤਿਹਾਰੇ ॥",
      "transliteration": "vai rijhahai lakh nain tihaare ||",
      "translation": "“You go to the place of my brother who will be bewitched on seeing your beautiful eyes",
      "punjabiViakhya": "ਉਹ ਤੇਰੇ ਨੈਣਾ ਨੂੰ ਵੇਖ ਕੇ ਪ੍ਰਸੰਨ ਹੋਵੇਗਾ ਵੇਖ,",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "वै रिझहै लख नैन तिहारे ॥",
      "sourceLineId": "85027",
      "sourceShabadId": "7965",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੰਗ ਸੀਆ ਅਵਿਲੋਕ ਕ੍ਰਿਸੋਦਰ ॥",
      "transliteration": "sa(n)g seeaa avilok kirasodhar ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਨਾਲ ਪਤਲੇ ਲੱਕ ਵਾਲੀ ਸੀਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "संग सीआ अविलोक कृसोदर ॥",
      "sourceLineId": "85028",
      "sourceShabadId": "7965",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕੈਸੇ ਕੈ ਰਾਖ ਸਕੋ ਤੁਮ ਕੱਉ ਘਰਿ ॥੩੩੪॥",
      "transliteration": "kaise kai raakh sako tum ka'au ghar ||334||",
      "translation": "“You can see that with me there is Sita of beautiful waist and in such a situation how can I keep you in my house.334.",
      "punjabiViakhya": "(ਇਸ ਲਈ ਮੈਂ) ਤੈਨੂੰ ਕਿਸ ਤਰ੍ਰਹਾ ਘਰ ਵਿੱਚ ਰੱਖ ਸਕਦਾ ਹਾ ॥੩੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "कैसे कै राख सको तुम कउ्उ घरि ॥३३४॥",
      "sourceLineId": "85029",
      "sourceShabadId": "7965",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮਾਤ ਪਿਤਾ ਕਹ ਮੋਹ ਤਜਯੋ ਮਨ ॥",
      "transliteration": "maat pitaa keh moh tajayo man ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਸੀਤਾ ਨੇ) ਮਨ ਵਿੱਚੋਂ ਮਾਤਾ ਪਿਤਾ ਦੇ ਮੋਹ ਨੂੰ ਛੱਡ ਦਿੱਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "मात पिता कह मोह तजयो मन ॥",
      "sourceLineId": "85030",
      "sourceShabadId": "7965",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੰਗ ਫਿਰੀ ਹਮਰੇ ਬਨ ਹੀ ਬਨ ॥",
      "transliteration": "sa(n)g firee hamare ban hee ban ||",
      "translation": "“She has abandoned the attachment towards her parents and is roaming with me in the forest",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੇ ਨਾਲ ਬਣ-ਬਣ ਵਿੱਚ ਫਿਰ ਰਹੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "संग फिरी हमरे बन ही बन ॥",
      "sourceLineId": "85031",
      "sourceShabadId": "7965",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਾਹਿ ਤਜੌ ਕਸ ਕੈ ਸੁਨਿ ਸੁੰਦਰ ॥",
      "transliteration": "taeh tajau kas kai sun su(n)dhar ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸੁੰਦਰੀ! ਸਣ, ਉਸ ਨੂੰ ਮੈਂ ਕਿਸ ਤਰ੍ਰਹਾ ਛੱਡ ਸਕਦਾ ਹਾ?",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "ताहि तजौ कस कै सुनि सुँदर ॥",
      "sourceLineId": "85032",
      "sourceShabadId": "7965",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਾਹੁ ਤਹਾ ਜਹਾ ਭ੍ਰਾਤ ਕ੍ਰਿਸੋਦਰਿ ॥੩੩੫॥",
      "transliteration": "jaahu tahaa jahaa bhraat kirasodhar ||335||",
      "translation": "“O beautiful lady! How can I forsake her, you go there where my brother is sitting.”335.",
      "punjabiViakhya": "ਹੇ ਪਤਲੇ ਲੱਕ ਵਾਲੀਏ! ਤੂੰ ਉਥੇ ਜਾ, ਜਿਥੇ ਮੇਰਾ ਭਰਾ ਬੈਠਾ ਹੈ ॥੩੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "जाहु तहा जहा भ्रात कृसोदरि ॥३३५॥",
      "sourceLineId": "85033",
      "sourceShabadId": "7965",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਾਤ ਭਈ ਸੁਨ ਬੈਨ ਤ੍ਰਿਯਾ ਤਹ ॥",
      "transliteration": "jaat bhiee sun bain tirayaa teh ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ) ਗੱਲ ਸੁਣ ਕੇ ਇਸਤਰੀ ਉਥੇ ਚਲੀ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "जात भई सुन बैन तृया तह ॥",
      "sourceLineId": "85034",
      "sourceShabadId": "7965",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬੈਠ ਹੁਤੇ ਰਣਧੀਰ ਜਤੀ ਜਹ ॥",
      "transliteration": "baiTh hute ranadheer jatee jeh ||",
      "translation": "Hearing these words of Ram, that lady Surpanakha went there were Lakshman was sitting.",
      "punjabiViakhya": "ਜਿਥੇ ਰਣਧੀਰ ਜਤੀ ਲਛਮਣ ਬੈਠਾ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "बैठ हुते रणधीर जती जह ॥",
      "sourceLineId": "85035",
      "sourceShabadId": "7965",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੋ ਨ ਬਰੈ ਅਤਿ ਰੋਸ ਭਰੀ ਤਬ ॥",
      "transliteration": "so na barai at ros bharee tab ||",
      "translation": "",
      "punjabiViakhya": "(ਲਛਮਣ) ਵਲੋਂ ਨਾ ਵਰਣ ਕਾਰਨ, ਉਸ ਵੇਲੇ (ਸ਼ੂਰਪਣਖਾ) ਕ੍ਰੋਧ ਨਾਲ ਭਰ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "सो न बरै अति रोस भरी तब ॥",
      "sourceLineId": "85036",
      "sourceShabadId": "7965",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਕ ਕਟਾਇ ਗਈ ਗ੍ਰਿਹ ਕੋ ਸਭ ॥੩੩੬॥",
      "transliteration": "naak kaTai giee gireh ko sabh ||336||",
      "translation": "When he also refused to wed her, then she was filled with great rage and went to her home after getting her nose chopped.336.",
      "punjabiViakhya": "(ਅਤੇ ਲਛਮਣ ਕੋਲੋਂ) ਨੱਕ ਕਟਵਾ ਕੇ ਘਰ ਨੂੰ ਮੁੜ ਗਈ ॥੩੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "नाक कटाइ गई गृह को सभ ॥३३६॥",
      "sourceLineId": "85037",
      "sourceShabadId": "7965",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਰਾਮ ਅਵਤਾਰ ਕਥਾ ਸੂਪਨਖਾ ਕੋ ਨਾਕ ਕਾਟਬੋ ਧਯਾਇ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੫॥",
      "transliteration": "eit sree bachitr naaTake raam avataar kathaa soopanakhaa ko naak kaaTabo dhayai samaapatam sat subham sat ||5||",
      "translation": "End of the chapter regarding the Chopping of the Nose of Surapanakha in the story of Rama Incarnation in BACHITTAR NATAK.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਦੀ ਰਾਮ-ਅਵਤਾਰ ਕਥਾ ਵਿਚ ਸ਼ੂਰਪਣਖਾ ਦੇ ਨੱਕ ਕੱਟਣ ਦੇ ਅਧਿਆਏ ਦੀ ਸਮਾਪਤੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटके राम अवतार कथा सूपनखा को नाक काटबो धयाइ समापतम सतु सुभम सतु ॥५॥",
      "sourceLineId": "85038",
      "sourceShabadId": "7965",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਥ ਖਰਦੂਖਨ ਦਈਤ ਜੁੱਧ ਕਥਨੰ ॥",
      "transliteration": "ath kharadhookhan dhieet ju'dh kathana(n) ||",
      "translation": "The beginning of the description of the battle with the demons Khar and Dusman :",
      "punjabiViakhya": "ਹੁਣ ਖਰ-ਦੂਖਨ ਦੈਂਤ ਦੇ ਯੁੱਧ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "अथ खरदूखन दईत जुद्ध कथनं ॥",
      "sourceLineId": "85039",
      "sourceShabadId": "7966",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੁੰਦਰੀ ਛੰਦ ॥",
      "transliteration": "su(n)dharee chha(n)dh ||",
      "translation": "SUNDARI STANZA",
      "punjabiViakhya": "ਸੁੰਦਰੀ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "सुँदरी छंद ॥",
      "sourceLineId": "85040",
      "sourceShabadId": "7966",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਾਵਨ ਤੀਰ ਰੁਰੋਤ ਭਈ ਜਬ ॥",
      "transliteration": "raavan teer rurot bhiee jab ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੂਰਪਣਖਾ ਜਦੋਂ ਰਾਵਣ ਕੋਲ ਜਾ ਕੇ ਰੋਈ",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "रावन तीर रुरोत भई जब ॥",
      "sourceLineId": "85041",
      "sourceShabadId": "7966",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰੋਸ ਭਰੇ ਦਨੁ ਬੰਸ ਬਲੀ ਸਭ ॥",
      "transliteration": "ros bhare dhan ba(n)s balee sabh ||",
      "translation": "When Surapanakha went weeping near Ravana, then the whole demon-clan was filled with fury.",
      "punjabiViakhya": "ਤਦੋਂ ਦਾਨਵ ਵੰਸ਼ ਦੇ ਸਾਰੇ ਬਲੀ (ਦੈਂਤ) ਕ੍ਰੋਧ ਨਾਲ ਭਰ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "रोस भरे दनु बंस बली सभ ॥",
      "sourceLineId": "85042",
      "sourceShabadId": "7966",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਲੰਕਸ ਧੀਰ ਬਜੀਰ ਬੁਲਾਏ ॥",
      "transliteration": "la(n)kas dheer bajeer bulaae ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਵਣ ਨੇ ਧੀਰਜ ਵਾਲੇ ਵਜ਼ੀਰ ਬੁਲਾਏ (ਅਤੇ ਉਨ੍ਰਹਾ ਦੀ ਸਲਾਹ ਨਾਲ)",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "लंकस धीर बजीर बुलाए ॥",
      "sourceLineId": "85043",
      "sourceShabadId": "7966",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੂਖਨ ਔ ਖਰ ਦਈਤ ਪਠਾਏ ॥੩੩੭॥",
      "transliteration": "dhookhan aau khar dhieet paThaae ||337||",
      "translation": "The king of Lanka called his ministers for consultations and sent two demons Khar and Dushan for killing ram etc. 337.",
      "punjabiViakhya": "ਖਰ ਅਤੇ ਦੂਖਨ (ਨਾ ਦੇ ਦੋਹਾ) ਦੈਂਤਾ ਨੂੰ ਭੇਜ ਦਿਤਾ ॥੩੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "दूखन औ खर दईत पठाए ॥३३७॥",
      "sourceLineId": "85044",
      "sourceShabadId": "7966",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਾਜ ਸਨਾਹ ਸੁਬਾਹ ਦੁਰੰ ਗਤ ॥",
      "transliteration": "saaj sanaeh subaeh dhura(n) gat ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਬਾਹਾ ਉਤੇ ਕਠੋਰ ਸ਼ਸਤ੍ਰ ਸਜਾ ਕੇ ਚਲ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "साज सनाह सुबाह दुरं गत ॥",
      "sourceLineId": "85045",
      "sourceShabadId": "7966",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਾਜਤ ਬਾਜ ਚਲੇ ਗਜ ਗੱਜਤ ॥",
      "transliteration": "baajat baaj chale gaj ga'jat ||",
      "translation": "Wearing their armours all the long-armed warriors marched forward with the resounding of musical instruments and the roaring of elephants.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨਾਲ ਵਾਜੇ ਵਜਦੇ ਸਨ ਅਤੇ ਹਾਥੀ ਗਰਜਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "बाजत बाज चले गज गज्जत ॥",
      "sourceLineId": "85046",
      "sourceShabadId": "7966",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਾਰ ਹੀ ਮਾਰ ਦਸੋ ਦਿਸ ਕੂਕੇ ॥",
      "transliteration": "maar hee maar dhaso dhis kooke ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਰੋ-ਮਾਰੋ ਦੀ ਦਸਾ ਦਿਸ਼ਾਵਾ ਵਿੱਚ ਆਵਾਜ਼ ਹੋ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "मार ही मार दसो दिस कूके ॥",
      "sourceLineId": "85047",
      "sourceShabadId": "7966",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਾਵਨ ਕੀ ਘਟ ਜਯੋਂ ਘੁਰ ਢੂਕੇ ॥੩੩੮॥",
      "transliteration": "saavan kee ghaT jayo(n) ghur ddooke ||338||",
      "translation": "There was noise of “kill, kill” from all the four sides and the army gushed forward like the clouds of the month of sawan.338.",
      "punjabiViakhya": "(ਉਹ) ਸਾਵਣ ਦੀਆਂ ਘਟਾਵਾ ਵਾਗ ਗਰਜਦੇ ਹੋਏ (ਰਾਮ ਚੰਦਰ ਦੇ ਨੇੜੇ ਆ ਢੁੱਕੇ ਸਨ) ॥੩੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "सावन की घट जयों घुर ढूके ॥३३८॥",
      "sourceLineId": "85048",
      "sourceShabadId": "7966",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗੱਜਤ ਹੈ ਰਣਬੀਰ ਮਹਾ ਮਨ ॥",
      "transliteration": "ga'jat hai ranabeer mahaa man ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਡੇ ਧੀਰਜ ਵਾਲੇ ਯੋਧੇ ਰਣ ਵਿੱਚ ਗੱਜਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "गज्जत है रणबीर महा मन ॥",
      "sourceLineId": "85049",
      "sourceShabadId": "7966",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤੱਜਤ ਹੈਂ ਨਹੀ ਭੂਮਿ ਅਯੋਧਨ ॥",
      "transliteration": "ta'jat hai(n) nahee bhoom ayodhan ||",
      "translation": "The mighty warriors thundered and stood firmly on the ground.",
      "punjabiViakhya": "ਅਤੇ ਜੰਗ ਦੀ ਭੂਮੀ ਨੂੰ ਤਿਆਗਦੇ ਨਹੀਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "तज्जत हैं नही भूमि अयोधन ॥",
      "sourceLineId": "85050",
      "sourceShabadId": "7966",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਛਾਜਤ ਹੈ ਚਖ ਸ੍ਰੋਣਤ ਸੋ ਸਰ ॥",
      "transliteration": "chhaajat hai chakh sronat so sar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦੇ ਨੈਣ ਲਹੂ ਦੇ ਸਰੋਵਰਾ ਵਾਗ ਸ਼ੋਭਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "छाजत है चख स्रोणत सो सर ॥",
      "sourceLineId": "85051",
      "sourceShabadId": "7966",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਦਿ ਕਰੈਂ ਕਿਲਕਾਰ ਭਯੰਕਰ ॥੩੩੯॥",
      "transliteration": "naadh karai(n) kilakaar bhaya(n)kar ||339||",
      "translation": "The pools of blood flourished and the warriors raised terrible shrieks.339.",
      "punjabiViakhya": "ਅਤੇ ਭਿਆਨਕ ਚੀਕਾ ਮਾਰਨ ਦੀ ਆਵਾਜ਼ ਕਰਦੇ ਸਨ ॥੩੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "नादि करैं किलकार भयंकर ॥३३९॥",
      "sourceLineId": "85052",
      "sourceShabadId": "7966",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਾਰਕਾ ਛੰਦ ॥",
      "transliteration": "taarakaa chha(n)dh ||",
      "translation": "TAARKAA STANZA",
      "punjabiViakhya": "ਤਾਰਕਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "तारका छंद ॥",
      "sourceLineId": "85053",
      "sourceShabadId": "7967",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰਨਿ ਰਾਜ ਕੁਮਾਰ ਬਿਰੱਚਹਿਗੇ ॥",
      "transliteration": "ran raaj kumaar bira'chahige ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ ਵਿੱਚ ਰਾਜ ਕੁਮਾਰ (ਰਾਮ ਤੇ ਲੱਛਮਣ) ਵਿਚਰਨਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "रनि राज कुमार बिरच्चहिगे ॥",
      "sourceLineId": "85054",
      "sourceShabadId": "7967",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਰ ਸੇਲ ਸਰਾਸਨ ਨੱਚਹਿਗੇ ॥",
      "transliteration": "sar sel saraasan na'chahige ||",
      "translation": "When the princes will begin the battle, there will be the dance of lances and shafts.",
      "punjabiViakhya": "(ਸੂਰਮਿਆਂ ਦੇ ਹੱਥ ਵਿਚ) ਤੀਰ, ਬਰਛੇ ਤੇ ਧਨੁਸ਼ ਨੱਚਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "सर सेल सरासन नच्चहिगे ॥",
      "sourceLineId": "85055",
      "sourceShabadId": "7967",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੁ ਬਿਰੁੱਧ ਅਵੱਧਿ ਸੁ ਗਾਜਹਿਗੇ ॥",
      "transliteration": "s biru'dh ava'dh su gaajahige ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਰਾਮ (ਅਵਧਿਸੁ) ਦੇ ਵਿਰੁੱਧ ਗੱਜਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "सु बिरुद्ध अवद्धि सु गाजहिगे ॥",
      "sourceLineId": "85056",
      "sourceShabadId": "7967",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਣ ਰੰਗਹਿ ਰਾਮ ਬਿਰਾਜਹਿਗੇ ॥੩੪੦॥",
      "transliteration": "ran ra(n)geh raam biraajahige ||340||",
      "translation": "The warriors will roar on seeing the opposing forces and Ram will be absorbed in the fighting mood.340.",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਰਣ-ਭੂਮੀ ਵਿੱਚ ਰਾਮ ਸ਼ੋਭਾ ਪਾਉਣਗੇ ॥੩੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "रण रंगहि राम बिराजहिगे ॥३४०॥",
      "sourceLineId": "85057",
      "sourceShabadId": "7967",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਰ ਓਘ ਪ੍ਰਓਘ ਪ੍ਰਹਾਰੈਗੇ ॥",
      "transliteration": "sar ogh progh prahaaraige ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਧ ਤੋਂ ਵੱਧ ਤੀਰ ਚਲਾਉਣਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "सर ओघ प्रओघ प्रहारैगे ॥",
      "sourceLineId": "85058",
      "sourceShabadId": "7967",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰਣਿ ਰੰਗ ਅਭੀਤ ਬਿਹਾਰੈਗੇ ॥",
      "transliteration": "ran ra(n)g abheet bihaaraige ||",
      "translation": "There will be showers of arrows and the fighters will roam in the battlefield fearlessly.",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਨਿਡਰ ਹੋ ਕੇ ਫਿਰਨਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "रणि रंग अभीत बिहारैगे ॥",
      "sourceLineId": "85059",
      "sourceShabadId": "7967",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਰ ਸੂਲ ਸਨਾਹਰਿ ਛੁੱਟਹਿਗੇ ॥",
      "transliteration": "sar sool sanaahar chhu'Tahige ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ, ਤ੍ਰਿਸ਼ੂਲ ਤੇ ਖੜਗ (ਸਨਾਹਰਿ) ਚਲਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "सर सूल सनाहरि छुट्टहिगे ॥",
      "sourceLineId": "85060",
      "sourceShabadId": "7967",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦਿਤ ਪੁੱਤ੍ਰ ਪਰਾ ਪਰ ਲੁੱਟਹਿਗੇ ॥੩੪੧॥",
      "transliteration": "dhit pu'tr paraa par lu'Tahige ||341||",
      "translation": "The tridents and arrows will be struck and the sons of demons will roll in dust.341.",
      "punjabiViakhya": "ਅਤੇ ਦਿਤੀ ਦੇ ਪੁੱਤਰ (ਦੈਂਤ) ਧਰਤੀ ਉਤੇ ਲੇਟਣਗੇ ॥੩੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "दित पुत्त्र परा पर लुट्टहिगे ॥३४१॥",
      "sourceLineId": "85061",
      "sourceShabadId": "7967",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਰ ਸੰਕ ਅਸੰਕਤ ਬਾਹਹਿਗੇ ॥",
      "transliteration": "sar sa(n)k asa(n)kat baahahige ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੰਕਾ ਤੋਂ ਆਸ਼ੰਕਿਤ ਹੋ ਕੇ ਤੀਰ ਚਲਾਉਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "सर संक असंकत बाहहिगे ॥",
      "sourceLineId": "85062",
      "sourceShabadId": "7967",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਿਨੁ ਭੀਤ ਭਯਾ ਦਲ ਦਾਹਹਿਗੇ ॥",
      "transliteration": "bin bheet bhayaa dhal dhaahahige ||",
      "translation": "They will discharge arrows undoubtedly and destroy the forces of the enemy.",
      "punjabiViakhya": "ਅਤੇ ਡਰ ਤੋਂ ਬਿਨਾ ਹੋ ਕੇ ਭਿਆਨਕ ਦਲ ਨੂੰ ਸਾੜ ਦੇਣਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "बिनु भीत भया दल दाहहिगे ॥",
      "sourceLineId": "85063",
      "sourceShabadId": "7967",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਛਿਤਿ ਲੁੱਥ ਬਿਲੁੱਥ ਬਿਥਾਰਹਿਗੇ ॥",
      "transliteration": "chhit lu'th bilu'th bithaarahige ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ ਉਤੇ ਲੋਥ ਤੇ ਲੋਥ ਖਿਲਾਰ ਦੇਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 234,
      "hindi": "",
      "hindiTransliteration": "छिति लुत्थ बिलुत्थ बिथारहिगे ॥",
      "sourceLineId": "85064",
      "sourceShabadId": "7967",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0234_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਰੁ ਸਣੈ ਸਮੂਲ ਉਪਾਰਹਿਗੇ ॥੩੪੨॥",
      "transliteration": "tar sanai samool upaarahige ||342||",
      "translation": "The corpses will be scattered on the earth and the great warriors will uproot the trees.342.",
