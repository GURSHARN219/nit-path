{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 244,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0244_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਾਰੈ ਲਾਗ ਮੰਤ੍ਰੰ ਕੁਮੰਤ੍ਰੰ ਬਿਚਾਰੰ ॥",
      "transliteration": "kaarai laag ma(n)tra(n) kuma(n)tra(n) bichaara(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ ਦੋਵੇਾਂ) ਕੁਮੰਤ੍ਰ ਰੂਪ ਮੰਤ੍ਰ ਨੂੰ ਵਿਚਾਰਨ ਲੱਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "कारै लाग मंत्रं कुमंत्रं बिचारं ॥",
      "sourceLineId": "85427",
      "sourceShabadId": "7988",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਤੈ ਉਚਰੇ ਬੈਨ ਭ੍ਰਾਤੰ ਲੁਝਾਰੰ ॥੪੧੭॥",
      "transliteration": "eitai uchare bain bhraata(n) lujhaara(n) ||417||",
      "translation": "They all held consultation together and talked to one another about the war.417.",
      "punjabiViakhya": "(ਰਾਵਣ ਨੇ) ਜੁਝਾਰੂ ਭਰਾ (ਕੁੰਭਕਰਨ ਨੂੰ) ਸਾਰੀ ਗੱਲ ਦੱਸ ਦਿੱਤੀ ॥੪੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "इतै उचरे बैन भ्रातं लुझारं ॥४१७॥",
      "sourceLineId": "85428",
      "sourceShabadId": "7988",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਲੰ ਗਾਗਰੀ ਸਪਤ ਸਾਹੰਸ੍ਰ ਪੂਰੰ ॥",
      "transliteration": "jala(n) gaagaree sapat saaha(n)sr poora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਪਾਣੀ ਦੀਆਂ ਭਰੀਆਂ ਹੋਈਆਂ ਸੱਤ ਹਜ਼ਾਰ ਗਾਗਰਾ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "जलं गागरी सपत साहंस्र पूरं ॥",
      "sourceLineId": "85429",
      "sourceShabadId": "7988",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮੁਖੰ ਪੁੱਛ ਲਯੋ ਕੁੰਭਕਾਨੰ ਕਰੂਰੰ ॥",
      "transliteration": "mukha(n) pu'chh layo ku(n)bhakaana(n) karoora(n) ||",
      "translation": "Kumbhkaran used seven thousand metallic pitchers of water to cleanse his face",
      "punjabiViakhya": "ਕੁੰਭਕਰਨ ਨੇ ਆਪਣਾ ਭਿਆਨਕ ਮੂੰਹ ਪੂੰਝ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "मुखं पुच्छ लयो कुँभकानं करूरं ॥",
      "sourceLineId": "85430",
      "sourceShabadId": "7988",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕੀਯੋ ਮਾਸਹਾਰੰ ਮਹਾ ਮੱਦਯ ਪਾਨੰ ॥",
      "transliteration": "keeyo maasahaara(n) mahaa ma'dhay paana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਮਾਸ ਦਾ ਆਹਾਰ ਕੀਤਾ ਅਤੇ ਬਹੁਤ ਸਾਰੀ ਸ਼ਰਾਬ ਪੀ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "कीयो मासहारं महा मद्दय पानं ॥",
      "sourceLineId": "85431",
      "sourceShabadId": "7988",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਉਠਯੋ ਲੈ ਗਦਾ ਕੋ ਭਰਯੋ ਵੀਰ ਮਾਨੰ ॥੪੧੮॥",
      "transliteration": "auThayo lai gadhaa ko bharayo veer maana(n) ||418||",
      "translation": "He ate flesh to his fill and drank wine excessively. After all this that proud warrior got up with his mace and marched forware.418.",
      "punjabiViakhya": "ਗੌਰਵ ਨਾਲ ਭਰਿਆ ਸੂਰਮਾ ਗਦਾ ਲੈ ਕੇ ਖੜਾ ਹੋ ਗਿਆ ॥੪੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "उठयो लै गदा को भरयो वीर मानं ॥४१८॥",
      "sourceLineId": "85432",
      "sourceShabadId": "7988",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭਜੀ ਬਾਨਰੀ ਪੇਖ ਸੈਨਾ ਅਪਾਰੰ ॥",
      "transliteration": "bhajee baanaree pekh sainaa apaara(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ) ਵੇਖ ਕੇ ਬੰਦਰ ਦੀ ਅਪਾਰ ਸੈਨਾ ਭੱਜ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "भजी बानरी पेख सैना अपारं ॥",
      "sourceLineId": "85433",
      "sourceShabadId": "7988",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤ੍ਰਸੇ ਜੂਥ ਪੈ ਜੂਥ ਜੋਧਾ ਜੁਝਾਰੰ ॥",
      "transliteration": "trase jooth pai jooth jodhaa jujhaara(n) ||",
      "translation": "Seeing him the innumerable army of monkeys fled away and many groups of gods became frightful",
      "punjabiViakhya": "ਜੁਝਾਰੂ ਯੋਧਿਆਂ ਦੇ ਦਲਾ ਦੇ ਦਲ ਡਰ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "त्रसे जूथ पै जूथ जोधा जुझारं ॥",
      "sourceLineId": "85434",
      "sourceShabadId": "7988",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਉਠੈ ਗੱਦ ਸੱਦੰ ਨਿਨੱਦੰਤਿ ਵੀਰੰ ॥",
      "transliteration": "auThai ga'dh sa'dha(n) nina'dha(n)t veera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਦੇ ਲਲਕਾਰਿਆਂ ਦਾ ਕਠੋਰ ਨਾਦ ਉੱਠਣ ਲੱਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "उठै गद्द सद्दं निनद्दंति वीरं ॥",
      "sourceLineId": "85435",
      "sourceShabadId": "7988",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਫਿਰੈ ਰੁੰਡ ਮੁੰਡੰ ਤਨੰ ਤੱਛ ਤੀਰੰ ॥੪੧੯॥",
      "transliteration": "firai ru(n)dd mu(n)dda(n) tana(n) ta'chh teera(n) ||419||",
      "translation": "The terrible shouts of the warriors were heard and the truncated bodies pared by the arrows were seen moving.419.",
      "punjabiViakhya": "ਅਤੇ ਤੀਰਾ ਨਾਲ ਪੱਛੇ ਹੋਏ ਸਿਰ ਅਤੇ ਧੜ ਰੁਲਣ ਲੱਗੇ ॥੪੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "फिरै रुँड मुँडं तनं तच्छ तीरं ॥४१९॥",
      "sourceLineId": "85436",
      "sourceShabadId": "7988",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "85437",
      "sourceShabadId": "7989",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗਿਰੈ ਮੁੰਡ ਤੁੰਡੰ ਭਸੁੰਡੰ ਗਜਾਨੰ ॥",
      "transliteration": "girai mu(n)dd tu(n)dda(n) bhasu(n)dda(n) gajaana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮਿਆਂ ਦੇ) ਧੜ ਤੇ ਸਿਰ ਅਤੇ ਹਾਥੀਆਂ ਦੇ ਸੁੰਡ ਡਿੱਗੇ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "गिरै मुँड तुँडं भसुँडं गजानं ॥",
      "sourceLineId": "85438",
      "sourceShabadId": "7989",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਫਿਰੈ ਰੁੰਡ ਮੁੰਡੰ ਸੁ ਝੁੰਡੰ ਨਿਸਾਨੰ ॥",
      "transliteration": "firai ru(n)dd mu(n)dda(n) su jhu(n)dda(n) nisaana(n) ||",
      "translation": "The chopped trunks of the elephants are falling down and the torn banners are swinging hither and thither",
      "punjabiViakhya": "ਸਿਰ ਅਤੇ ਧੜ ਭੱਜੇ ਫਿਰਦੇ ਸਨ। ਝੰਡਿਆਂ ਦੇ ਢੇਰ ਲੱਗੇ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "फिरै रुँड मुँडं सु झुँडं निसानं ॥",
      "sourceLineId": "85439",
      "sourceShabadId": "7989",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰੜੈ ਕੰਕ ਬੰਕੰ ਸੱਸੰਕੰਤ ਜੋਧੰ ॥",
      "transliteration": "raRai ka(n)k ba(n)ka(n) sa'sa(n)ka(n)t jodha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭਿਆਨਕ ਕਾ ਬੋਲਦੇ ਸਨ ਅਤੇ ਯੋਧੇ ਸਿਸਕ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "रड़ै कंक बंकं सस्संकंत जोधं ॥",
      "sourceLineId": "85440",
      "sourceShabadId": "7989",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਉਠੀ ਕੂਹ ਜੂਹੰ ਮਿਲੇ ਸੈਣ ਕ੍ਰੋਧੰ ॥੪੨੦॥",
      "transliteration": "auThee kooh jooha(n) mile sain krodha(n) ||420||",
      "translation": "The beautiful horses are rolling down and are warriors are sobbing in the battlefield, there is terrible lamination in the whole field.420.",
      "punjabiViakhya": "ਬਹੁਤ ਰੌਲਾ ਪੈ ਰਿਹਾ ਸੀ ਅਤੇ ਕ੍ਰੋਧ ਭਰੀ ਸੈਨਾ ਆਪਸ ਵਿੱਚ ਗੁੱਥਮਗੁੱਥਾ ਹੋ ਰਹੀ ਸੀ ॥੪੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "उठी कूह जूहं मिले सैण क्रोधं ॥४२०॥",
      "sourceLineId": "85441",
      "sourceShabadId": "7989",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਝਿਮੀ ਤੇਗ ਤੇਜੰ ਸਰੋਸੰ ਪ੍ਰਹਾਰੰ ॥",
      "transliteration": "jhimee teg teja(n) sarosa(n) prahaara(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਯੋਧੇ) ਕ੍ਰੋਧ ਨਾਲ ਤੇਜ਼ ਤਲਵਾਰਾ ਨੂੰ ਚਲਾਉਾਂਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "झिमी तेग तेजं सरोसं प्रहारं ॥",
      "sourceLineId": "85442",
      "sourceShabadId": "7989",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਖਿਮੀ ਦਾਮਨੀ ਜਾਣੁ ਭਾਦੋ ਮਝਾਰੰ ॥",
      "transliteration": "khimee dhaamanee jaan bhaadho majhaara(n) ||",
      "translation": "There are fast knocking of the blows, exhibiting the glitter of swords and it seems that the lightning is flashing in the month of Bhason",
      "punjabiViakhya": "(ਜੋ ਇਸ ਤਰ੍ਰਹਾ ਚਮਕਦੀਆਂ ਸਨ), ਮਾਨੋ ਭਾਦਰੋਂ (ਦੇ ਮਹੀਨੇ ਵਿੱਚ ਕਾਲੀਆਂ ਘਟਾਵਾ) ਅੰਦਰ ਬਿਜਲੀ ਲਿਸ਼ਕਦੀ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "खिमी दामनी जाणु भादो मझारं ॥",
      "sourceLineId": "85443",
      "sourceShabadId": "7989",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਹਸੇ ਕੰਕ ਬੰਕੰ ਕਸੇ ਸੂਰਵੀਰੰ ॥",
      "transliteration": "hase ka(n)k ba(n)ka(n) kase sooraveera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭਿਆਨਕ ਕਾ ਹੱਸਦੇ ਸਨ ਅਤੇ ਸੂਰਮੇ (ਯੁੱਧ ਲਈ ਕਮਰਕਸੇ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "हसे कंक बंकं कसे सूरवीरं ॥",
      "sourceLineId": "85444",
      "sourceShabadId": "7989",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਢਲੀ ਢਾਲ ਮਾਲੰ ਸੁਭੇ ਤੱਛ ਤੀਰੰ ॥੪੨੧॥",
      "transliteration": "ddalee ddaal maala(n) subhe ta'chh teera(n) ||421||",
      "translation": "The beautiful horses carrying warriors as neighing and the rosary of shields alongwith the sharp shafts look impressive.421.",
      "punjabiViakhya": "ਢਾਲਾ ਦੀ ਮਾਲਾ ਡਿੱਗੀ ਪਈ ਹੈ ਅਤੇ ਭਿਆਨਕ ਘਾਓ ਸ਼ੋਭ ਰਹੇ ਹਨ ॥੪੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "ढली ढाल मालं सुभे तच्छ तीरं ॥४२१॥",
      "sourceLineId": "85445",
      "sourceShabadId": "7989",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਿਰਾਜ ਛੰਦ ॥",
      "transliteration": "biraaj chha(n)dh ||",
      "translation": "BIRAAJ STANZA",
      "punjabiViakhya": "ਬਿਰਾਜ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "बिराज छंद ॥",
      "sourceLineId": "85446",
      "sourceShabadId": "7990",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹੱਕ ਦੇਬੀ ਕਰੰ ॥",
      "transliteration": "ha'k dhebee kara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵੀ (ਕਾਲੀ) ਆਵਾਜ਼ ਕਰ ਰਹੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "हक्क देबी करं ॥",
      "sourceLineId": "85447",
      "sourceShabadId": "7990",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੱਦ ਭੈਰੋ ਰਰੰ ॥",
      "transliteration": "sa'dh bhairo rara(n) ||",
      "translation": "A terrible war began in order in order to appease the goddess Kali",
      "punjabiViakhya": "ਭੈਰੋ (ਭਿਆਨਕ) ਸ਼ਬਦ ਬੋਲ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "सद्द भैरो ररं ॥",
      "sourceLineId": "85448",
      "sourceShabadId": "7990",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚਾਵਡੀ ਚਿੰਕਰੰ ॥",
      "transliteration": "chaavaddee chi(n)kara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਚੁੜੇਲ ਚੀਕਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "चावडी चिंकरं ॥",
      "sourceLineId": "85449",
      "sourceShabadId": "7990",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਡਾਕਣੀ ਡਿੰਕਰੰ ॥੪੨੨॥",
      "transliteration": "ddaakanee ddi(n)kara(n) ||422||",
      "translation": "And the Bhairvas began to shout  the vultures shrieked and the vampires belched.422.",
      "punjabiViakhya": "ਡਾਕਣੀ ਡਕਾਰ ਮਾਰਦੀ ਹੈ ॥੪੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "डाकणी डिंकरं ॥४२२॥",
      "sourceLineId": "85450",
      "sourceShabadId": "7990",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪੱਤ੍ਰ ਜੁੱਗਣ ਭਰੰ ॥",
      "transliteration": "pa'tr ju'gan bhara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੋਗਣਾ ਖੱਪਰ ਭਰਦੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "पत्त्र जुग्गण भरं ॥",
      "sourceLineId": "85451",
      "sourceShabadId": "7990",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਲੁੱਥ ਬਿੱਥੁਥਰੰ ॥",
      "transliteration": "lu'th bi'thuthara(n) ||",
      "translation": "The bowls of Yoginis were being filled and the corpses scattered",
      "punjabiViakhya": "ਲੋਥਾ ਖਿੰਡੀਆਂ ਪਈਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "लुत्थ बित्थुथरं ॥",
      "sourceLineId": "85452",
      "sourceShabadId": "7990",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੰਮੁਹੇ ਸੰਘਰੰ ॥",
      "transliteration": "sa(n)muhe sa(n)ghara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਆਹਮੋ-ਸਾਹਮਣੇ ਯੁੱਧ ਹੋ ਰਿਹਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "संमुहे संघरं ॥",
      "sourceLineId": "85453",
      "sourceShabadId": "7990",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਹੂਹ ਕੂਹੰ ਭਰੰ ॥੪੨੩॥",
      "transliteration": "hooh kooha(n) bhara(n) ||423||",
      "translation": "The clusters were destroyed and there was tumult all around.423.",
      "punjabiViakhya": "(ਰਣ-ਭੂਮੀ) ਰੌਲੇ ਰੱਪੇ ਨਾਲ ਭਰੀ ਪਈ ਹੈ ॥੪੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "हूह कूहं भरं ॥४२३॥",
      "sourceLineId": "85454",
      "sourceShabadId": "7990",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅੱਛਰੀ ਉਛਰੰ ॥",
      "transliteration": "a'chharee uchhara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਪੱਛਰਾਵਾ ਉਤਸਾਹਿਤ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "अच्छरी उछरं ॥",
      "sourceLineId": "85455",
      "sourceShabadId": "7990",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਿੰਧੁਰੈ ਸਿੰਧਰੰ ॥",
      "transliteration": "si(n)dhurai si(n)dhara(n) ||",
      "translation": "The heavenly damsels began to dance and the bugles sounded",
      "punjabiViakhya": "ਰਣ-ਸਿੰਘੇ ਧੁਨ ਕੱਢ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "सिंधुरै सिंधरं ॥",
      "sourceLineId": "85456",
      "sourceShabadId": "7990",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮਾਰ ਮਾਰੁੱਚਰੰ ॥",
      "transliteration": "maar maaru'chara(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਮਾਰੋ-ਮਾਰੋ ਉਚਾਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "मार मारुच्चरं ॥",
      "sourceLineId": "85457",
      "sourceShabadId": "7990",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬੱਜ ਗੱਜੇ ਸੁਰੰ ॥੪੨੪॥",
      "transliteration": "ba'j ga'je sura(n) ||424||",
      "translation": ", The shouts of “Kill, Kill” and the rustling of arrows were heard.424.",
      "punjabiViakhya": "ਵਾਜੇ ਉੱਚੀ ਸੁਰ ਵਿੱਚ ਗੱਜ ਰਹੇ ਹਨ ॥੪੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "बज्ज गज्जे सुरं ॥४२४॥",
      "sourceLineId": "85458",
      "sourceShabadId": "7990",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਉੱਝਰੇ ਲੁੱਝਰੰ ॥",
      "transliteration": "au'jhare lu'jhara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਲੜਾਕੇ ਉਲਝੇ ਪਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "उज्झरे लुज्झरं ॥",
      "sourceLineId": "85459",
      "sourceShabadId": "7990",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਝੁੱਮਰੇ ਜੁੱਝਰੰ ॥",
      "transliteration": "jhu'mare ju'jhara(n) ||",
      "translation": "The warriors got entangled with one another and the fighters gushed forward",
      "punjabiViakhya": "ਯੋਧੇ ਘੁਮੇਰੀਆਂ ਖਾ ਕੇ (ਡਿਗਦੇ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "झुम्मरे जुज्झरं ॥",
      "sourceLineId": "85460",
      "sourceShabadId": "7990",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬੱਜੀਯੰ ਡੰਮਰੰ ॥",
      "transliteration": "ba'jeeya(n) dda(n)mara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਡੌਰੂ, ਤੰਬੂਰੇ ਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "बज्जीयं डंमरं ॥",
      "sourceLineId": "85461",
      "sourceShabadId": "7990",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਾਲਣੋ ਤੁੰਬਰੰ ॥੪੨੫॥",
      "transliteration": "taalano tu(n)bara(n) ||425||",
      "translation": "The tabors and other musical instruments were played in the battlefield.425.",
      "punjabiViakhya": "ਤਾਲ ਛੈਣੇ ਵੱਜਦੇ ਹਨ ॥੪੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "तालणो तुँबरं ॥४२५॥",
      "sourceLineId": "85462",
      "sourceShabadId": "7990",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "85463",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪਰੀ ਮਾਰ ਮਾਰੰ ॥",
      "transliteration": "paree maar maara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਰੋ-ਮਾਰੋ ਹੋ ਰਹੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "परी मार मारं ॥",
      "sourceLineId": "85464",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮੰਡੇ ਸਸਤ੍ਰ ਧਾਰੰ ॥",
      "transliteration": "ma(n)dde sasatr dhaara(n) ||",
      "translation": "There were blows of arms and the edges of the weapons were sharpened",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰਾ ਦੀਆਂ ਧਾਰਾਵਾ (ਸੂਰਮਿਆਂ ਨੂੰ) ਕੱਟ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "मंडे ससत्र धारं ॥",
      "sourceLineId": "85465",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰਟੈ ਮਾਰ ਮਾਰੰ ॥",
      "transliteration": "raTai maar maara(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਮੂੰਹੋਂ) ਮਾਰੋ-ਮਾਰੋ ਬੋਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "रटै मार मारं ॥",
      "sourceLineId": "85466",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤੁਟੈ ਖੱਗ ਧਾਰੰ ॥੪੨੬॥",
      "transliteration": "tuTai kha'g dhaara(n) ||426||",
      "translation": "The warriors repeated the shouts of “kill, kill” and the edge of the spears began to break.426.",
      "punjabiViakhya": "ਕਲਵਾਰਾ ਦੀ ਧਾਰ ਖੁੰਡੀ ਪੈ ਰਹੀ ਹੈ ॥੪੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "तुटै खग्ग धारं ॥४२६॥",
      "sourceLineId": "85467",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਉਠੈ ਛਿੱਛ ਅਪਾਰੰ ॥",
      "transliteration": "auThai chhi'chh apaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਪਾਰ ਛਿੱਟਾ ਉੱਠਦੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "उठै छिच्छ अपारं ॥",
      "sourceLineId": "85468",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਹੈ ਸ੍ਰੋਣ ਧਾਰੰ ॥",
      "transliteration": "bahai sron dhaara(n) ||",
      "translation": "There was continuous flow of blood and it also spattered",
      "punjabiViakhya": "ਅਤੇ ਲਹੂ ਦੀ ਧਾਰ ਵਗਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "बहै स्रोण धारं ॥",
      "sourceLineId": "85469",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਸੈ ਮਾਸਹਾਰੰ ॥",
      "transliteration": "hasai maasahaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਸ ਖਾਣ ਵਾਲੇ ਹੱਸਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "हसै मासहारं ॥",
      "sourceLineId": "85470",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪੀਐ ਸ੍ਰੋਣ ਸਯਾਰੰ ॥੪੨੭॥",
      "transliteration": "peeaai sron sayaara(n) ||427||",
      "translation": "The flesh-eaters smiled and the jackals drank blood.427.",
      "punjabiViakhya": "ਗਿੱਦੜ ਲਹੂ ਪੀਂਦੇ ਹਨ ॥੪੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "पीऐ स्रोण सयारं ॥४२७॥",
      "sourceLineId": "85471",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗਿਰੇ ਚਉਰ ਚਾਰੰ ॥",
      "transliteration": "gire chaur chaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਚੌਰ ਡਿੱਗੇ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "गिरे चउर चारं ॥",
      "sourceLineId": "85472",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭਜੇ ਏਕ ਹਾਰੰ ॥",
      "transliteration": "bhaje ek haara(n) ||",
      "translation": "The beautiful fly-whiskers fell and on one side the defeated warriors ran away",
      "punjabiViakhya": "ਕਈ ਹਾਰ ਕੇ ਭੱਜੀ ਜਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "भजे एक हारं ॥",
      "sourceLineId": "85473",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0244_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਟੈ ਏਕ ਮਾਰੰ ॥",
      "transliteration": "raTai ek maara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਮਾਰੋ-ਮਾਰੋ ਰਟ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 244,
      "hindi": "",
      "hindiTransliteration": "रटै एक मारं ॥",
      "sourceLineId": "85474",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
