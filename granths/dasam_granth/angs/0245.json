{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 245,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0245_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗਿਰੇ ਸੂਰ ਸੁਆਰੰ ॥੪੨੮॥",
      "transliteration": "gire soor suaara(n) ||428||",
      "translation": "Then were repetitions of the shouts of “Kill, Kill” on the other side and the horse-riders fell.428.",
      "punjabiViakhya": "(ਘੋੜ) ਸਵਾਰ ਸੂਰਮੇ ਡਿੱਗੇ ਪਏ ਹਨ ॥੪੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "गिरे सूर सुआरं ॥४२८॥",
      "sourceLineId": "85475",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚਲੇ ਏਕ ਸੁਆਰੰ ॥",
      "transliteration": "chale ek suaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਸਵਾਰ ਚਲ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "चले एक सुआरं ॥",
      "sourceLineId": "85476",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪਰੇ ਏਕ ਬਾਰੰ ॥",
      "transliteration": "pare ek baara(n) ||",
      "translation": "On one side the horse-riders started moving and altogether made and attack.",
      "punjabiViakhya": "ਕਈ ਇਕੋ ਵਾਰ ਆ ਪੈਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "परे एक बारं ॥",
      "sourceLineId": "85477",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਡੋ ਜੁੱਧ ਪਾਰੰ ॥",
      "transliteration": "baddo ju'dh paara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਡਾ ਯੁੱਧ ਮਚਾਉਾਂਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "बडो जुद्ध पारं ॥",
      "sourceLineId": "85478",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਿਕਾਰੇ ਹਥਯਾਰੰ ॥੪੨੯॥",
      "transliteration": "nikaare hathayaara(n) ||429||",
      "translation": "They drew out their weapons and began o wage a terrible war.429.",
      "punjabiViakhya": "ਅਤੇ ਹਥਿਆਰ ਕੱਢ ਕੇ (ਚਲਾਉਾਂਦੇ ਹਨ) ॥੪੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "निकारे हथयारं ॥४२९॥",
      "sourceLineId": "85479",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਰੈ ਏਕ ਵਾਰੰ ॥",
      "transliteration": "karai ek vaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਇਕੋ ਵਾਰ ਹੀ ਵਾਰ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "करै एक वारं ॥",
      "sourceLineId": "85480",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਲਸੈ ਖੱਗ ਧਾਰੰ ॥",
      "transliteration": "lasai kha'g dhaara(n) ||",
      "translation": "The striking sharp edges of the swords look impressive, the knocking on the shields and",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਦੀ ਧਾਰ ਚਮਕਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "लसै खग्ग धारं ॥",
      "sourceLineId": "85481",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਉਠੈ ਅੰਗਿਆਰੰ ॥",
      "transliteration": "auThai a(n)giaara(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਤੋਂ ਅੱਗ ਦੀਆਂ ਚਿਣਗਾ ਨਿਕਲਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "उठै अंगिआरं ॥",
      "sourceLineId": "85482",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਲਖੈ ਬਯੋਮ ਚਾਰੰ ॥੪੩੦॥",
      "transliteration": "lakhai bayom chaara(n) ||430||",
      "translation": "The collision of the swords create sparks, which are being seen by the gods from the sky.430.",
      "punjabiViakhya": "ਆਕਾਸ਼ ਵਿੱਚ ਵਿਚਾਰਨ ਵਾਲੇ (ਦੇਵਤੇ) ਵੇਖਦੇ ਹਨ ॥੪੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "लखै बयोम चारं ॥४३०॥",
      "sourceLineId": "85483",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੁ ਪੈਜੰ ਪਚਾਰੰ ॥",
      "transliteration": "s paija(n) pachaara(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਵੀਰ) ਲਲਕਾਰੇ ਮਾਰਦੇ ਹੋਏ ਆਪਣੀ ਮਰਿਆਦਾ (ਪਾਲਦੇ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "सु पैजं पचारं ॥",
      "sourceLineId": "85484",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮੰਡੇ ਅਸਤ੍ਰ ਧਾਰੰ ॥",
      "transliteration": "ma(n)dde asatr dhaara(n) ||",
      "translation": "He, on whom the warriors attack, they thrust on him the sharp edges of their arms,",
      "punjabiViakhya": "ਅਸਤ੍ਰਾ ਦੀਆਂ ਧਾਰਾਵਾ ਸ਼ਿੰਗਾਰ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "मंडे असत्र धारं ॥",
      "sourceLineId": "85485",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਰੇਾਂ ਮਾਰ ਮਾਰੰ ॥",
      "transliteration": "kareaa(n) maar maara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਾਰੋ-ਮਾਰੋ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "करेाँ मार मारं ॥",
      "sourceLineId": "85486",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਇਕੇ ਕੰਪ ਚਾਰੰ ॥੪੩੧॥",
      "transliteration": "eike ka(n)p chaara(n) ||431||",
      "translation": "The shout of “Kill, Kill” is being raised and the warriors trembling with rage look impressive.431.",
      "punjabiViakhya": "ਕਈ ਬਹੁਤ ਕੰਬ ਰਹੇ ਹਨ ॥੪੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "इके कंप चारं ॥४३१॥",
      "sourceLineId": "85487",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਹਾ ਬੀਰ ਜੁੱਟੈਂ ॥",
      "transliteration": "mahaa beer ju'Tai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਲੀ ਯੋਧੇ (ਆਪਸ ਵਿੱਚ) ਜੁਟੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "महा बीर जुट्टैं ॥",
      "sourceLineId": "85488",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਰੰ ਸੰਜ ਫੁੱਟੈਂ ॥",
      "transliteration": "sara(n) sa(n)j fu'Tai(n) ||",
      "translation": "The great warriors have fought with one another and the armours are being torn by the arrows",
      "punjabiViakhya": "ਤੀਰ ਨਾਲ ਕਵਚ ਟੁੱਟ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "सरं संज फुट्टैं ॥",
      "sourceLineId": "85489",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤੜੰਕਾਰ ਛੁੱਟੈਂ ॥",
      "transliteration": "taRa(n)kaar chhu'Tai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਤੜ-ਤੜ ਕਰਕੇ ਫੁੱਟਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "तड़ंकार छुट्टैं ॥",
      "sourceLineId": "85490",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਝੜੰਕਾਰ ਉੱਠੈਂ ॥੪੩੨॥",
      "transliteration": "jhaRa(n)kaar u'Thai(n) ||432||",
      "translation": "The arrows are being discharged with crackling sound and the tinkling sound is being heard.432.",
      "punjabiViakhya": "ਅਤੇ (ਉਨ੍ਰਹਾ ਵਿੱਚੋਂ ਝੜ-ਝੜ ਸ਼ਬਦ ਨਿਕਲਦਾ ਹੈ ॥੪੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "झड़ंकार उट्ठैं ॥४३२॥",
      "sourceLineId": "85491",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਰੰਧਾਰ ਬੁੱਠੈਂ ॥",
      "transliteration": "sara(n)dhaar bu'Thai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰਾ ਦਾ ਮੀਂਹ ਵਰ੍ਰਹਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "सरंधार बुट्ठैं ॥",
      "sourceLineId": "85492",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜੁਗੰ ਜੁੱਧ ਜੁੱਠੈਂ ॥",
      "transliteration": "juga(n) ju'dh ju'Thai(n) ||",
      "translation": "There is shower of arrows and it appears that the whole world is absorbed in the war",
      "punjabiViakhya": "ਦੋ-ਦੋ ਯੋਧੇ (ਆਪਸ ਵਿੱਚ) ਜੁੱਟੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "जुगं जुद्ध जुट्ठैं ॥",
      "sourceLineId": "85493",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਣੰ ਰੋਸੁ ਰੁੱਠੈਂ ॥",
      "transliteration": "rana(n) ros ru'Thai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਨਾਲ ਰਣ ਵਿੱਚ ਰੁੱਝੇ ਹੋਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "रणं रोसु रुट्ठैं ॥",
      "sourceLineId": "85494",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਕੰ ਏਕ ਕੁੱਠੈਂ ॥੪੩੩॥",
      "transliteration": "eika(n) ek ku'Thai(n) ||433||",
      "translation": "The warriors are knocking their blows in fury over one another and are chopping (the limbs).433.",
      "punjabiViakhya": "ਅਤੇ ਇਕ-ਇਕ ਨੂੰ ਕੋਹ ਰਿਹਾ ਹੈ ॥੪੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "इकं एक कुट्ठैं ॥४३३॥",
      "sourceLineId": "85495",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਢਲੀ ਢਾਲ ਉੱਠੈਂ ॥",
      "transliteration": "ddalee ddaal u'Thai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਢਾਲਾ ਤੋਂ ਢਲ-ਢਲ ਸ਼ਬਦ ਨਿਕਲਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "ढली ढाल उट्ठैं ॥",
      "sourceLineId": "85496",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਰੰ ਫਉਜ ਫੁੱਟੈਂ ॥",
      "transliteration": "ara(n) fauj fu'Tai(n) ||",
      "translation": "The fallen shields are being picked up and the forces of the enemy are being torn asunder",
      "punjabiViakhya": "ਵੈਰੀ ਦੀ ਸੈਨਾ ਫੁਟ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "अरं फउज फुट्टैं ॥",
      "sourceLineId": "85497",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਿ ਨੇਜੇ ਪਲੱਟੈ ॥",
      "transliteration": "k neje pala'Tai ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈ) ਨੇਜ਼ਿਆਂ ਨਾਲ ਨੇਜ਼ੇ ਵੱਜਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "कि नेजे पलट्टै ॥",
      "sourceLineId": "85498",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚਮਤਕਾਰ ਉੱਠੈ ॥੪੩੪॥",
      "transliteration": "chamatakaar u'Thai ||434||",
      "translation": "The lances are overturning and being used miraculously.434.",
      "punjabiViakhya": "ਅਤੇ ਚਿੰਗਾਰੇ ਨਿਕਲਦੇ ਹਨ ॥੪੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "चमतकार उट्ठै ॥४३४॥",
      "sourceLineId": "85499",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਿਤੇ ਭੂਮਿ ਲੁੱਠੈਂ ॥",
      "transliteration": "kite bhoom lu'Thai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿੰਨੇ ਹੀ ਧਰਤੀ 'ਤੇ ਲੁੜ੍ਰਹਕੇ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "किते भूमि लुट्ठैं ॥",
      "sourceLineId": "85500",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗਿਰੇ ਏਕ ਉੱਠੈਂ ॥",
      "transliteration": "gire ek u'Thai(n) ||",
      "translation": "Many people are lying down on the earth and many of those fallen down are getting up and",
      "punjabiViakhya": "ਕਈ ਇਕ ਡਿੱਗਦੇ (ਹੋਏ ਫਿਰ) ਉਠ ਖੜੋਤੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "गिरे एक उट्ठैं ॥",
      "sourceLineId": "85501",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰਣੰ ਫੇਰਿ ਜੁੱਟੈਂ ॥",
      "transliteration": "rana(n) fer ju'Tai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮੁੜ ਕੇ ਰਣ ਵਿੱਚ ਜੁੱਟ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "रणं फेरि जुट्टैं ॥",
      "sourceLineId": "85502",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਹੇ ਤੇਗ ਤੁੱਟੈਂ ॥੪੩੫॥",
      "transliteration": "bahe teg tu'Tai(n) ||435||",
      "translation": "Being absorbed in the war, are excessively knocking and breaking their swords.435.",
      "punjabiViakhya": "ਚਲ-ਚਲ ਕੇ ਤਲਵਾਰਾ ਟੁੱਟ ਗਈਆਂ ਹਨ ॥੪੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "बहे तेग तुट्टैं ॥४३५॥",
      "sourceLineId": "85503",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਚੇ ਵੀਰ ਵੀਰੰ ॥",
      "transliteration": "mache veer veera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਵੀਰਤਾ ਦੀ ਮੌਜ ਵਿੱਚ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "मचे वीर वीरं ॥",
      "sourceLineId": "85504",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਧਰੇ ਵੀਰ ਚੀਰੰ ॥",
      "transliteration": "dhare veer cheera(n) ||",
      "translation": "The warriors are fighting with warriors and are ripping them with their weapons",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਨੇ ਬਸਤ੍ਰ ਧਾਰਨ ਕੀਤੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "धरे वीर चीरं ॥",
      "sourceLineId": "85505",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਰੈ ਸਸਤ੍ਰ ਪਾਤੰ ॥",
      "transliteration": "karai sasatr paata(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰਾ ਦਾ ਪ੍ਰਹਾਰ ਕਰਦੇ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "करै ससत्र पातं ॥",
      "sourceLineId": "85506",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਉਠੈ ਅਸਤ੍ਰ ਘਾਤੰ ॥੪੩੬॥",
      "transliteration": "auThai asatr ghaata(n) ||436||",
      "translation": "They are causing the weapons to fall down and inflicting wounds with their arms.436.",
      "punjabiViakhya": "ਘਾਤ ਲਾ ਕੇ ਅਸਤ੍ਰ ਚਲਾਦੇ ਹਨ ॥੪੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "उठै असत्र घातं ॥४३६॥",
      "sourceLineId": "85507",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਇਤੈਂ ਬਾਨ ਰਾਜੰ ॥",
      "transliteration": "eitai(n) baan raaja(n) ||",
      "translation": "",
      "punjabiViakhya": "ਇਧਰੋਂ ਬੰਦਰਾ ਦਾ ਰਾਜਾ (ਸੁਗ੍ਰੀਵ)",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "इतैं बान राजं ॥",
      "sourceLineId": "85508",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਉਤੈ ਕੁੰਭ ਕਾਜੰ ॥",
      "transliteration": "autai ku(n)bh kaaja(n) ||",
      "translation": "On this side the arrows are being discharged and on that side Kumbhkaran is doing his job of destroying the army,",
      "punjabiViakhya": "ਅਤੇ ਉਧਰੋਂ ਕੁੰਭਕਰਨ ਲੜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "उतै कुँभ काजं ॥",
      "sourceLineId": "85509",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਰਯੋ ਸਾਲ ਪਾਤੰ ॥",
      "transliteration": "karayo saal paata(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਅੰਤ ਨੂੰ ਸੁਗ੍ਰੀਵ ਨੇ) ਸਾਲ ਦਾ ਬ੍ਰਿਛ ਪੁੱਟ ਕੇ ਮਾਰਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "करयो साल पातं ॥",
      "sourceLineId": "85510",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗਿਰਯੋ ਵੀਰ ਭ੍ਰਾਤੰ ॥੪੩੭॥",
      "transliteration": "girayo veer bhraata(n) ||437||",
      "translation": "But in the end that brother of Ravana fell down like the tree of saal.437.",
      "punjabiViakhya": "(ਜਿਸ ਨਾਲ) ਰਾਵਣ ਦਾ ਭਰਾ (ਕੁੰਭਕਰਨ) ਡਿੱਗ ਪਿਆ ॥੪੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "गिरयो वीर भ्रातं ॥४३७॥",
      "sourceLineId": "85511",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦੋਊ ਜਾਘ ਫੂਟੀ ॥",
      "transliteration": "dhouoo jaagh fooTee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀਆਂ) ਦੋਵੇਾਂ ਟੰਗਾ ਟੁੱਟ ਗਈਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "दोऊ जाघ फूटी ॥",
      "sourceLineId": "85512",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਤੰ ਧਾਰ ਛੂਟੀ ॥",
      "transliteration": "rata(n) dhaar chhooTee ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਵਿਚੋਂ) ਲਹੂ ਦੀ ਧਾਰ ਚਲ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "रतं धार छूटी ॥",
      "sourceLineId": "85513",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗਿਰੇ ਰਾਮ ਦੇਖੇ ॥",
      "transliteration": "gire raam dhekhe ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਨੇ ਡਿਗਦਾ ਹੋਇਆ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "गिरे राम देखे ॥",
      "sourceLineId": "85514",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਡੇ ਦੁਸਟ ਲੇਖੇ ॥੪੩੮॥",
      "transliteration": "badde dhusaT lekhe ||438||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਵੱਡਾ ਦੁਸ਼ਟ ਲੇਖੇ ਲੱਗ ਗਿਆ ਹੈ ॥੪੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "बडे दुसट लेखे ॥४३८॥",
      "sourceLineId": "85515",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਰੀ ਬਾਣ ਬਰਖੰ ॥",
      "transliteration": "karee baan barakha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵੇਲੇ (ਰਾਮ ਨੇ) ਤੀਰਾ ਦੀ ਬਰਖਾ ਕੀਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "करी बाण बरखं ॥",
      "sourceLineId": "85516",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭਰਯੋ ਸੈਨ ਹਰਖੰ ॥",
      "transliteration": "bharayo sain harakha(n) ||",
      "translation": "Both his legs cracked and from them came out the continuous flow of blood.",
      "punjabiViakhya": "ਬੰਦਰ ਸੈਨਾ ਵਿੱਚ ਆਨੰਦ ਛਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "भरयो सैन हरखं ॥",
      "sourceLineId": "85517",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਣੇ ਬਾਣ ਤਾਣੰ ॥",
      "transliteration": "hane baan taana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਮ ਦੇ) ਹੱਥ ਦੇ ਮਾਰੇ ਹੋਏ ਬਾਣ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "हणे बाण ताणं ॥",
      "sourceLineId": "85518",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਝਿਣਯੋ ਕੁੰਭਕਾਣੰ ॥੪੩੯॥",
      "transliteration": "jhinayo ku(n)bhakaana(n) ||439||",
      "translation": "Ram saw and shot an arrow, which killed Kumbhkaran.439.",
      "punjabiViakhya": "ਕੁੰਭਕਰਨ ਮਾਰਿਆ ਗਿਆ ਹੈ ॥੪੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "झिणयो कुँभकाणं ॥४३९॥",
      "sourceLineId": "85519",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭਏ ਦੇਵ ਹਰਖੰ ॥",
      "transliteration": "bhe dhev harakha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤੇ ਪ੍ਰਸੰਨ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "भए देव हरखं ॥",
      "sourceLineId": "85520",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਰੀ ਪੁਹਪ ਬਰਖੰ ॥",
      "transliteration": "karee puhap barakha(n) ||",
      "translation": "In their joy she gods showered floweres. When Ranvana the king of Lanka,",
      "punjabiViakhya": "(ਅਤੇ ਉਨ੍ਰਹਾ ਨੇ ਰਾਮ ਉਤੇ) ਫੁੱਲਾ ਦੀ ਬਰਖਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "करी पुहप बरखं ॥",
      "sourceLineId": "85521",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0245_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੁਣਯੋ ਲੰਕ ਨਾਥੰ ॥",
      "transliteration": "sunayo la(n)k naatha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਵਣ ਨੇ (ਕੁੰਭਕਰਨ ਦਾ ਮਰਨਾ) ਸੁਣਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 245,
      "hindi": "",
      "hindiTransliteration": "सुणयो लंक नाथं ॥",
      "sourceLineId": "85522",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
