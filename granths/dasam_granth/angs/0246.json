{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 246,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0246_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਣੇ ਭੂਮ ਮਾਥੰ ॥੪੪੦॥",
      "transliteration": "hane bhoom maatha(n) ||440||",
      "translation": "Heard this news, he, in great anguish, threw his head on the earth.440.",
      "punjabiViakhya": "(ਤਾ ਉਸ ਨੇ ਆਪਣਾ) ਮੱਥਾ ਧਰਤੀ ਨਾਲ ਮਾਰਿਆ ॥੪੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "हणे भूम माथं ॥४४०॥",
      "sourceLineId": "85523",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਰਾਮਵਤਾਰ ਕੁੰਭਕਰਨ ਬਧਹਿ ਧਯਾਇ ਸਮਾਪਤਮ ਸਤੁ ॥",
      "transliteration": "eit sree bachitr naaTake raamavataar ku(n)bhakaran badheh dhayai samaapatam sat ||",
      "translation": "End on the chapter entitled ‘The Killing of Kumbhkaran’ in Ramavtar in BACHHITTAR NATAK",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਦੇ ਰਾਮਾਵਤਾਰ ਦਾ ਕੁੰਭਕਰਨ ਬਧਹਿ ਨਾ ਦਾ ਅਧਿਆਇ ਸਮਾਪਤ।",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटके रामवतार कुँभकरन बधहि धयाइ समापतम सतु ॥",
      "sourceLineId": "85524",
      "sourceShabadId": "7991",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਥ ਤ੍ਰਿਮੁੰਡ ਜੁੱਧ ਕਥਨੰ ॥",
      "transliteration": "ath tiramu(n)dd ju'dh kathana(n) ||",
      "translation": "Now begins the description of the war with Trimund :",
      "punjabiViakhya": "ਹੁਣ ਤ੍ਰਿਮੁੰਡ ਯੁੱਧ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "अथ तृमुँड जुद्ध कथनं ॥",
      "sourceLineId": "85525",
      "sourceShabadId": "7992",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "85526",
      "sourceShabadId": "7992",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪਠਯੋ ਤੀਨ ਮੁੰਡੰ ॥",
      "transliteration": "paThayo teen mu(n)dda(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ ਰਾਵਣ ਨੇ) ਤ੍ਰਿਮੁੰਡ ਦੈਂਤ ਨੂੰ ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "पठयो तीन मुँडं ॥",
      "sourceLineId": "85527",
      "sourceShabadId": "7992",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚਲਯੋ ਸੈਨ ਝੁੰਡੰ ॥",
      "transliteration": "chalayo sain jhu(n)dda(n) ||",
      "translation": "Now Ravana sent the demon Trimund who marched at the head of the army",
      "punjabiViakhya": "(ਜੋ) ਸੈਨਾ ਦਾ ਝੁੰਡ (ਨਾਲ ਲੈ ਕੇ) ਚਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "चलयो सैन झुँडं ॥",
      "sourceLineId": "85528",
      "sourceShabadId": "7992",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕ੍ਰਿਤੀ ਚਿਤ੍ਰ ਜੋਧੀ ॥",
      "transliteration": "kiratee chitr jodhee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਯੁੱਧ ਦਾ ਰੰਗ ਬੰਨ੍ਰਹ ਦੇਣ ਵਾਲਾ ਯੋਧਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "कृती चित्र जोधी ॥",
      "sourceLineId": "85529",
      "sourceShabadId": "7992",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮੰਡੇ ਪਰਮ ਕ੍ਰੋਧੀ ॥੪੪੧॥",
      "transliteration": "ma(n)dde param krodhee ||441||",
      "translation": "That warriors was unique like a portrait and a demon of supreme fury.441.",
      "punjabiViakhya": "ਅਤੇ ਵੱਡੇ ਕ੍ਰੋਧ ਨਾਲ ਰਣ ਮੰਡਣ ਵਾਲਾ ਸੀ ॥੪੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "मंडे परम क्रोधी ॥४४१॥",
      "sourceLineId": "85530",
      "sourceShabadId": "7992",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਕੈਂ ਮਾਰ ਮਾਰੰ ॥",
      "transliteration": "bakai(n) maar maara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਰ ਲੌ, ਮਾਰ ਲੌ, ਬੋਲਦਾ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "बकैं मार मारं ॥",
      "sourceLineId": "85531",
      "sourceShabadId": "7992",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਜੈ ਬਾਣ ਧਾਰੰ ॥",
      "transliteration": "tajai baan dhaara(n) ||",
      "translation": "He shouted “Kill, Kill” and discharged a current of arrows,",
      "punjabiViakhya": "ਤੀਰਾ ਦੀ ਵਾਛੜ ਲਗਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "तजै बाण धारं ॥",
      "sourceLineId": "85532",
      "sourceShabadId": "7992",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹਨੂਮੰਤ ਕੋਪੇ ॥",
      "transliteration": "hanooma(n)t kope ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ ਸਾਹਮਣੇ) ਹਨੂਮਾਨ ਨੇ ਕ੍ਰੋਧ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "हनूमंत कोपे ॥",
      "sourceLineId": "85533",
      "sourceShabadId": "7992",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਣੰ ਪਾਇ ਰੋਪੇ ॥੪੪੨॥",
      "transliteration": "rana(n) pai rope ||442||",
      "translation": "With great rage Hanuman stood with a firm foot in the battlefield.442.",
      "punjabiViakhya": "ਰਣ ਵਿੱਚ ਪੈਰ ਗੱਡ ਲਏ ਸਨ ॥੪੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "रणं पाइ रोपे ॥४४२॥",
      "sourceLineId": "85534",
      "sourceShabadId": "7992",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਸੰ ਛੀਨ ਲੀਨੋ ॥",
      "transliteration": "asa(n) chheen leeno ||",
      "translation": "",
      "punjabiViakhya": "(ਹਨੂਮਾਨ ਨੇ ਤ੍ਰਿਮੁੰਡ ਦੇ ਹੱਥੋਂ) ਤਲਵਾਰ ਖੋਹ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "असं छीन लीनो ॥",
      "sourceLineId": "85535",
      "sourceShabadId": "7992",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਿਸੀ ਕੰਠਿ ਦੀਨੋ ॥",
      "transliteration": "tisee ka(n)Th dheeno ||",
      "translation": "Hanuman seized the sword of that demon and with the same he gave a blow on his neck.",
      "punjabiViakhya": "ਅਤੇ ਉਸੇ ਦੀ ਗਰਦਨ ਉਤੇ ਮਾਰ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "तिसी कंठि दीनो ॥",
      "sourceLineId": "85536",
      "sourceShabadId": "7992",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਹਨਯੋ ਖਸਟ ਨੈਣੰ ॥",
      "transliteration": "hanayo khasaT naina(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਛੇ ਅੱਖਾ ਵਾਲੇ (ਤ੍ਰਿਮੁੰਡ) ਨੂੰ ਮਾਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "हनयो खसट नैणं ॥",
      "sourceLineId": "85537",
      "sourceShabadId": "7992",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹਸੇ ਦੇਵ ਗੈਣੰ ॥੪੪੩॥",
      "transliteration": "hase dhev gaina(n) ||443||",
      "translation": "That six-eyed demon was killed, seeing whom the gods smiled in the sky.443.",
      "punjabiViakhya": "(ਇਸ ਨਜ਼ਾਰੇ ਨੂੰ ਵੇਖ ਕੇ) ਦੇਵਤੇ ਆਕਾਸ਼ ਵਿੱਚ ਪ੍ਰਸੰਨ ਹੋ ਗਏ ॥੪੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "हसे देव गैणं ॥४४३॥",
      "sourceLineId": "85538",
      "sourceShabadId": "7992",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਰਾਮਵਤਾਰ ਤ੍ਰਿਮੁੰਡ ਬਧਹ ਧਯਾਇ ਸਮਾਪਤਮ ਸਤੁ ॥",
      "transliteration": "eit sree bachitr naaTak raamavataar tiramu(n)dd badheh dhayai samaapatam sat ||",
      "translation": "End on the chapter entitled ‘The Killing of Trimund’ in Ramavtar in BACHITTAR NATAK.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਦੇ ਰਾਮਵਤਾਰ ਦੇ ਤ੍ਰਿਮੁੰਡ ਬਧਹਿ ਅਧਿਆਇ ਦੀ ਸਮਾਪਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक रामवतार तृमुँड बधह धयाइ समापतम सतु ॥",
      "sourceLineId": "85539",
      "sourceShabadId": "7992",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਥ ਮਹੋਦਰ ਮੰਤ੍ਰੀ ਜੁੱਧ ਕਥਨੰ ॥",
      "transliteration": "ath mahodhar ma(n)tree ju'dh kathana(n) ||",
      "translation": "Now begin the description of the war with the minister Mahodar :",
      "punjabiViakhya": "ਹੁਣ ਮਹੋਦਰ ਮੰਤਰੀ ਦੇ ਯੁੱਧ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "अथ महोदर मंत्री जुद्ध कथनं ॥",
      "sourceLineId": "85540",
      "sourceShabadId": "7993",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "85541",
      "sourceShabadId": "7993",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੁਣਯੋ ਲੰਕ ਨਾਥੰ ॥",
      "transliteration": "sunayo la(n)k naatha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਲੰਕਾ ਦੇ ਸੁਆਮੀ (ਰਾਵਣ) ਨੇ (ਤ੍ਰਿਮੁੰਡ ਦਾ ਮਰਨਾ) ਸੁਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "सुणयो लंक नाथं ॥",
      "sourceLineId": "85542",
      "sourceShabadId": "7993",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਧੁਣੇ ਸਰਬ ਮਾਥੰ ॥",
      "transliteration": "dhune sarab maatha(n) ||",
      "translation": "When Ravana heard the news about the destruction of his warriors he held his forehead in extreme anguish.",
      "punjabiViakhya": "ਤਾ ਸਾਰਿਆਂ ਸਿਰਾ ਨੂੰ ਹਿਲਾਣ ਲੱਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "धुणे सरब माथं ॥",
      "sourceLineId": "85543",
      "sourceShabadId": "7993",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਰਯੋ ਮੱਦ ਪਾਣੰ ॥",
      "transliteration": "karayo ma'dh paana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਮਦਿਰਾ ਦਾ ਸੇਵਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "करयो मद्द पाणं ॥",
      "sourceLineId": "85544",
      "sourceShabadId": "7993",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭਰੇ ਬੀਰ ਮਾਣੰ ॥੪੪੪॥",
      "transliteration": "bhare beer maana(n) ||444||",
      "translation": "(In order to forget his agony), he in his pride drank wine.444.",
      "punjabiViakhya": "ਅਤੇ ਵੀਰਤਾ ਦੇ ਗੌਰਵ ਨਾਲ ਭਰ ਗਿਆ ॥੪੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "भरे बीर माणं ॥४४४॥",
      "sourceLineId": "85545",
      "sourceShabadId": "7993",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮਹਿਖੁਆਸ ਕਰਖੈਂ ॥",
      "transliteration": "mahikhuaas karakhai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜ਼ੋਰ ਨਾਲ ਧਨੁਸ਼ ਨੂੰ ਖਿਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "महिखुआस करखैं ॥",
      "sourceLineId": "85546",
      "sourceShabadId": "7993",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਰੰਧਾਰ ਬਰਖੈਂ ॥",
      "transliteration": "sara(n)dhaar barakhai(n) ||",
      "translation": "There was sound of the pulling of bows and the arrows were being showered,",
      "punjabiViakhya": "ਅਤੇ ਤੀਰਾ ਦੀ ਵਾਛੜ ਲਗਾ ਦਿੱਤੀ। ਮਹੋਦਰ ਆਦਿ ਹਠੀਲੇ",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "सरंधार बरखैं ॥",
      "sourceLineId": "85547",
      "sourceShabadId": "7993",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਹੋਦ੍ਰਾਦਿ ਵੀਰੰ ॥",
      "transliteration": "mahodhraadh veera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਧੀਰਜਵਾਨ ਸੂਰਮਿਆਂ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "महोद्रादि वीरं ॥",
      "sourceLineId": "85548",
      "sourceShabadId": "7993",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹਠੇ ਖੱਗ ਧੀਰੰ ॥੪੪੫॥",
      "transliteration": "haThe kha'g dheera(n) ||445||",
      "translation": "The persistent warriors like Mahodar held their swords and stood firmly with forbearance.445.",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਫੜ ਲਈਆਂ ॥੪੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "हठे खग्ग धीरं ॥४४५॥",
      "sourceLineId": "85549",
      "sourceShabadId": "7993",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮੋਹਣੀ ਛੰਦ ॥",
      "transliteration": "mohanee chha(n)dh ||",
      "translation": "MOHINI STANZA",
      "punjabiViakhya": "ਮੋਹਣੀ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "मोहणी छंद ॥",
      "sourceLineId": "85550",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਢਲ ਹੱਲ ਸੁਢੱਲੀ ਢੋਲਾਣੰ ॥",
      "transliteration": "ddal ha'l sudda'lee ddolaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਢਲ-ਢਲ ਕਰਦੀ ਢੋਲਾ ਦੀ ਕੜਕੁਟ ਹੁੰਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "ढल हल्ल सुढल्ली ढोलाणं ॥",
      "sourceLineId": "85551",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰਣ ਰੰਗ ਅਭੰਗ ਕਲੋਲਾਣੰ ॥",
      "transliteration": "ran ra(n)g abha(n)g kalolaana(n) ||",
      "translation": "The shields sounded like drums and there was being heard the agitated atmosphere of the war",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿੱਚ ਲਗਾਤਾਰ ਰੌਲਾ ਪੈ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "रण रंग अभंग कलोलाणं ॥",
      "sourceLineId": "85552",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭਰਣੰਕ ਸੁ ਨੱਦੰ ਨਾਫੀਰੰ ॥",
      "transliteration": "bharana(n)k su na'dha(n) naafeera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭਣ-ਭਣ ਕਰਦਾ ਨਫੀਰੀ ਦਾ ਨਾਦ ਹੋ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "भरणंक सु नद्दं नाफीरं ॥",
      "sourceLineId": "85553",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਰਣੰਕਸੁ ਬੱਜੇ ਮੱਜੀਰੰ ॥੪੪੬॥",
      "transliteration": "barana(n)kas ba'je ma'jeera(n) ||446||",
      "translation": "The sound of fifes filled a all the four directions and small cymbals of different colors rang.446.",
      "punjabiViakhya": "ਬਰਣ-ਬਰਣ' ਆਵਾਜ਼ ਕਰਦੇ ਹੋਏ ਮਜੀਰੇ ਵਜਦੇ ਹਨ ॥੪੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "बरणंकसु बज्जे मज्जीरं ॥४४६॥",
      "sourceLineId": "85554",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭਰਣੰਕਸੁ ਭੇਰੀ ਘੋਰਾਣੰ ॥",
      "transliteration": "bharana(n)kas bheree ghoraana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭਰਣ-ਭਰਣ ਕਰਦੀਆਂ ਭੇਰੀਆਂ ਗੂੰਜਦੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "भरणंकसु भेरी घोराणं ॥",
      "sourceLineId": "85555",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਣੁ ਸਾਵਣ ਭਾਦੋ ਮੋਰਾਣੰ ॥",
      "transliteration": "jan saavan bhaadho moraana(n) ||",
      "translation": "The kettledrums sounded like the resonance of the group of peacocks on seeing the clouds in the month of Sawan",
      "punjabiViakhya": "ਮਾਨੋ ਸਾਵਣ-ਭਾਦੋਂ ਵਿੱਚ ਮੋਰ (ਬੋਲਦੇ ਹੋਣ)।",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "जणु सावण भादो मोराणं ॥",
      "sourceLineId": "85556",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਉੱਛਲੀਏ ਪ੍ਰਖਰੇ ਪਾਵੰਗੰ ॥",
      "transliteration": "au'chhale'ee prakhare paava(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਪਾਖਰਾ ਵਾਲੇ ਘੋੜੇ ਕੁੱਦਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "उच्छलीए प्रखरे पावंगं ॥",
      "sourceLineId": "85557",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮੱਚੇ ਜੁੱਝਾਰੇ ਜੋਧੰਗੰ ॥੪੪੭॥",
      "transliteration": "ma'che ju'jhaare jodha(n)ga(n) ||447||",
      "translation": "The armoured horse jumped and the warriors were absorbed in war.447.",
      "punjabiViakhya": "ਲੜਾਕੇ ਸੂਰਮੇ ਯੁੱਧ ਦੇ ਰੰਗ ਵਿੱਚ ਰਚੇ ਹੋਏ ਹਨ ॥੪੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "मच्चे जुज्झारे जोधंगं ॥४४७॥",
      "sourceLineId": "85558",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਿੰਧੁਰੀਏ ਸੁੰਡੀ ਦੰਤਾਲੇ ॥",
      "transliteration": "si(n)dhure'e su(n)ddee dha(n)taale ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਡੇ-ਵੱਡੇ ਦੰਦਾ ਵਾਲੇ ਮਸਤ ਹਾਥੀ ਫਿਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "सिंधुरीए सुँडी दंताले ॥",
      "sourceLineId": "85559",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨੱਚੇ ਪੱਖਰੀਏ ਮੁੱਛਾਲੇ ॥",
      "transliteration": "na'che pa'khare'e mu'chhaale ||",
      "translation": "The elephants having trunks and tusks got intoxicated and the warriors of frightful whiskers danced",
      "punjabiViakhya": "ਮੁੱਛਾ ਵਾਲੇ (ਯੋਧੇ) ਪਾਖਰਾ ਵਾਲੇ (ਘੋੜਿਆਂ ਨੂੰ) ਨਚਾਉਾਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "नच्चे पक्खरीए मुच्छाले ॥",
      "sourceLineId": "85560",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਓਰੜੀਏ ਸਰਬੰ ਸੈਣਾਯੰ ॥",
      "transliteration": "oraRe'e saraba(n) sainaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਸੈਨਾ ਓਰੜ ਕੇ ਆ ਗਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "ओरड़ीए सरबं सैणायं ॥",
      "sourceLineId": "85561",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੇਖੰਤ ਸੁ ਦੇਵੰ ਗੈਣਾਯੰ ॥੪੪੮॥",
      "transliteration": "dhekha(n)t su dheva(n) gainaaya(n) ||448||",
      "translation": "There was movement of all the forces and the gobs saw them from the sky.448.",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ) ਦੇਵਤੇ ਆਕਾਸ਼ ਵਿੱਚ ਦੇਖ ਰਹੇ ਹਨ ॥੪੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "देखंत सु देवं गैणायं ॥४४८॥",
      "sourceLineId": "85562",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਝੱਲੈ ਅਵਝੜੀਯੰ ਉੱਝਾੜੰ ॥",
      "transliteration": "jha'lai avajhaReeya(n) u'jhaaRa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਡਿੱਗ ਸੂਰਮੇ ਵਾਰ ਢਲ ਕੇ ਡਿੱਗ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "झल्लै अवझड़ीयं उज्झाड़ं ॥",
      "sourceLineId": "85563",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰਣ ਉਠੈ ਬੈਹੈਂ ਬੱਬਾੜੰ ॥",
      "transliteration": "ran uThai baihai(n) ba'baaRa(n) ||",
      "translation": "The blows of very stern warriors are being endured  the fighters are falling in the battlefield and are flowing in the stream of blood",
      "punjabiViakhya": "ਰਣ ਵਿੱਚ ਫਿਰ ਉਠਦੇ ਤੇ ਬਹਿੰਦੇ ਹੋਏ ਲਲਕਾਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "रण उठै बैहैं बब्बाड़ं ॥",
      "sourceLineId": "85564",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਘੈ ਘੁੱਮੇ ਘਾਯੰ ਅੱਘਾਯੰ ॥",
      "transliteration": "ghai ghu'me ghaaya(n) a'ghaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜ਼ਖ਼ਮ ਲੱਗਦਿਆਂ ਹੀ ਘੇਰਨੀ ਖਾ ਕੇ ਡਿੱਗ ਪੈਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "घै घुम्मे घायं अग्घायं ॥",
      "sourceLineId": "85565",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਭੂਅ ਡਿੱਗੇ ਅੱਧੋ ਅੱਧਾਯੰ ॥੪੪੯॥",
      "transliteration": "bhooa ddi'ge a'dho a'dhaaya(n) ||449||",
      "translation": "The wounded warriors are wandering circularly and are falling on the earth with downward faces.449.",
      "punjabiViakhya": "ਅੱਧੋ-ਅੱਧ ਹੋ ਕੇ ਧਰਤੀ ਉਤੇ ਡਿਗਦੇ ਹਨ ॥੪੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "भूअ डिग्गे अद्धो अद्धायं ॥४४९॥",
      "sourceLineId": "85566",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰਿਸ ਮੰਡੈ ਛੰਡੈ ਅਉ ਛੰਡੈ ॥",
      "transliteration": "ris ma(n)ddai chha(n)ddai aau chha(n)ddai ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਨਾਲ ਭਰ ਕੇ ਨਾ ਛੰਡੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਛੰਡ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "रिस मंडै छंडै अउ छंडै ॥",
      "sourceLineId": "85567",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਠਿ ਹੱਸੈ ਕੱਸੈ ਕੋ ਅੰਡੈ ॥",
      "transliteration": "haTh ha'sai ka'sai ko a(n)ddai ||",
      "translation": "In great fury they are killing others and are going on killing  the persistent warriors are tightening their weapons smilingly",
      "punjabiViakhya": "ਹਠੀ ਯੋਧੇ ਹੱਸ-ਹੱਸ ਕੇ (ਧਨੁਸ਼ਾ) ਨੂੰ ਖਿੱਚਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "हठि हस्सै कस्सै को अंडै ॥",
      "sourceLineId": "85568",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰਿਸ ਬਾਹੈਂ ਗਾਹੈਂ ਜੋਧਾਣੰ ॥",
      "transliteration": "ris baahai(n) gaahai(n) jodhaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧਿਆਂ ਨੂੰ ਫੜ ਕੇ ਕ੍ਰੋਧ ਨਾਲ ਸ਼ਸਤ੍ਰ ਮਾਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "रिस बाहैं गाहैं जोधाणं ॥",
      "sourceLineId": "85569",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0246_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਣ ਹੋਹੈਂ ਜੋਹੈਂ ਕ੍ਰੋਧਾਣੰ ॥੪੫੦॥",
      "transliteration": "ran hohai(n) johai(n) krodhaana(n) ||450||",
      "translation": "And being enraged are churning the fighters and are raising the ire of others.450.",
      "punjabiViakhya": "ਯੁੱਧ ਨੂੰ ਕ੍ਰੋਧ ਨਾਲ ਵੇਖਦੇ ਹਨ ॥੪੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 246,
      "hindi": "",
      "hindiTransliteration": "रण होहैं जोहैं क्रोधाणं ॥४५०॥",
      "sourceLineId": "85570",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
