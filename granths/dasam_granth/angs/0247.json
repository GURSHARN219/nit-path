{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 247,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0247_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਣ ਗੱਜੈ ਸੱਜੈ ਸਸਤ੍ਰਾਣੰ ॥",
      "transliteration": "ran ga'jai sa'jai sasatraana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰਾ ਨਾਲ ਸਜੇ ਹੋਏ (ਯੋਧੇ) ਰਣ ਵਿੱਚ ਗੱਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "रण गज्जै सज्जै ससत्राणं ॥",
      "sourceLineId": "85571",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਧਨੁ ਕਰਖੈਂ ਬਰਖੈਂ ਅਸਤ੍ਰਾਣੰ ॥",
      "transliteration": "dhan karakhai(n) barakhai(n) asatraana(n) ||",
      "translation": "The warriors bedecked with weapons in the war are thundering and the arrows are being showered by repeatedly pulling their bows.",
      "punjabiViakhya": "ਧਨੁਸ਼ਾ ਨੂੰ ਖਿੱਚਦੇ ਹਨ ਅਤੇ ਤੀਰਾ ਦੀ ਬਰਖਾ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "धनु करखैं बरखैं असत्राणं ॥",
      "sourceLineId": "85572",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦਲ ਗਾਹੈ ਬਾਹੈ ਹਥਿਯਾਰੰ ॥",
      "transliteration": "dhal gaahai baahai hathiyaara(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਦਲਾ ਨੂੰ ਗਾਹੁੰਦੇ ਹੋਏ ਸ਼ਸਤ੍ਰਾ ਨੂੰ ਚਲਾਉਾਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "दल गाहै बाहै हथियारं ॥",
      "sourceLineId": "85573",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਣ ਰੁੱਝੈ ਲੁੰਝੈ ਲੁੱਝਾਰੰ ॥੪੫੧॥",
      "transliteration": "ran ru'jhai lu(n)jhai lu'jhaara(n) ||451||",
      "translation": "The brave heroes are destroying the forces by striking their weapons and are engaged in continuous fighting.451.",
      "punjabiViakhya": "ਲੜਾਕੇ ਯੋਧੇ ਰਣ ਵਿੱਚ ਰੁੱਝੇ ਹੋਏ ਹਨ ॥੪੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "रण रुज्झै लुँझै लुज्झारं ॥४५१॥",
      "sourceLineId": "85574",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭਟ ਭੇਦੇ ਛੇਦੇ ਬਰਮਾਯੰ ॥",
      "transliteration": "bhaT bhedhe chhedhe baramaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਵਚਾ ਵਿੱਚ ਛੇਕ ਹੋ ਜਾਣ ਨਾਲ ਸੂਰਮੇ ਵਿੰਨ੍ਰਹੇ ਗਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "भट भेदे छेदे बरमायं ॥",
      "sourceLineId": "85575",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭੂਅ ਡਿੱਗੇ ਚਉਰੰ ਚਰਮਾਯੰ ॥",
      "transliteration": "bhooa ddi'ge chaura(n) charamaaya(n) ||",
      "translation": "The warriors are being faced and killed and they are falling on the ground with armours and fly-whisks",
      "punjabiViakhya": "ਚੌੜੀਆਂ ਢਾਲਾ ਡਿੱਗੀਆਂ ਪਈਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "भूअ डिग्गे चउरं चरमायं ॥",
      "sourceLineId": "85576",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਉੱਘੇ ਜਣ ਨੇਜੇ ਮਤਵਾਲੇ ॥",
      "transliteration": "au'ghe jan neje matavaale ||",
      "translation": "",
      "punjabiViakhya": "ਹੱਥਾ ਨਾਲ ਉਲਰੇ ਹੋਏ ਨੇਜ਼ੇ ਲੈ ਕੇ ਮਤਵਾਲੇ ਸੂਰਮੇ",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "उग्घे जण नेजे मतवाले ॥",
      "sourceLineId": "85577",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਚੱਲੇ ਜਯੋਂ ਰਾਵਲ ਜੱਟਾਲੇ ॥੪੫੨॥",
      "transliteration": "cha'le jayo(n) raaval ja'Taale ||452||",
      "translation": "The brave fighters are moving with their long lances like the Yogis of Raval Panth wearing matted locks.452.",
      "punjabiViakhya": "(ਇਉਾਂ) ਫਿਰਦੇ ਹਨ, (ਜਿਉਾਂ) ਜਟਾਵਾ ਵਾਲੇ ਯੋਗੀ ਚਲੇ ਜਾ ਰਹੇ ਹੋਣ ॥੪੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "चल्ले जयों रावल जट्टाले ॥४५२॥",
      "sourceLineId": "85578",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹੱਠੇ ਤਰਵਰੀਏ ਹੰਕਾਰੰ ॥",
      "transliteration": "ha'The taravare'e ha(n)kaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੰਕਾਰ ਦੇ ਭਰੇ ਹੋਏ ਤਲਵਾਰ ਧਾਰੀ ਹਠੀਲੇ ਸੂਰਮੇ",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "हट्ठे तरवरीए हंकारं ॥",
      "sourceLineId": "85579",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮੰਚੇ ਪੱਖਰੀਏ ਸੂਰਾਰੰ ॥",
      "transliteration": "ma(n)che pa'khare'e sooraara(n) ||",
      "translation": "The egoist sword-bearers are showing persistence and the armoured warriors are fighting",
      "punjabiViakhya": "ਘੋੜਿਆਂ ਉੱਤੇ ਸਵਾਰ ਹੋ ਕੇ ਯੁੱਧ ਵਿੱਚ ਰੁਝੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "मंचे पक्खरीए सूरारं ॥",
      "sourceLineId": "85580",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅੱਕੁੜਿਯੰ ਵੀਰੰ ਐਠਾਲੇ ॥",
      "transliteration": "a'kuRiya(n) veera(n) aaiThaale ||",
      "translation": "",
      "punjabiViakhya": "ਘਮੰਡੀ ਯੋਧੇ ਆਕੜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "अक्कुड़ियं वीरं ऐठाले ॥",
      "sourceLineId": "85581",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਨ ਸੋਹੇ ਪੱਤ੍ਰੀ ਪੱਤ੍ਰਾਲੇ ॥੪੫੩॥",
      "transliteration": "tan sohe pa'tree pa'traale ||453||",
      "translation": "The magnificent heroes are exhibiting pride and on their bodies the armours of steel-strips look impressive.453.",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦੇ ਸਰੀਰ ਉੱਤੇ ਖੰਭਾ ਵਾਲੇ ਤੀਰ ਵੱਜੇ ਹੋਏ ਸ਼ੋਭਾ ਪਾ ਰਹੇ ਹਨ ॥੪੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "तन सोहे पत्त्री पत्त्राले ॥४५३॥",
      "sourceLineId": "85582",
      "sourceShabadId": "7994",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਵ ਨਾਮਕ ਛੰਦ ॥",
      "transliteration": "nav naamak chha(n)dh ||",
      "translation": "NAV NAAMAK STANZA",
      "punjabiViakhya": "ਨਵ ਨਾਮਕ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "नव नामक छंद ॥",
      "sourceLineId": "85583",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਰਭਰ ਪਰ ਸਰ ॥",
      "transliteration": "tarabhar par sar ||",
      "translation": "",
      "punjabiViakhya": "ਤੜ ਤੜ ਤੀਰ ਵੱਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "तरभर पर सर ॥",
      "sourceLineId": "85584",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਿਰਖਤ ਸੁਰ ਨਰ ॥",
      "transliteration": "nirakhat sur nar ||",
      "translation": "The brave fighters are seen writhing, to whom all the gods and men are looking  it seems that the abode of Indra,",
      "punjabiViakhya": "ਦੇਵਤੇ ਅਤੇ ਮਨੁੱਖ ਵੇਖ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "निरखत सुर नर ॥",
      "sourceLineId": "85585",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹਰ ਪੁਰ ਪੁਰ ਸੁਰ ॥",
      "transliteration": "har pur pur sur ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਜ ਦਾ ਨਗਰ (ਆਕਾਸ਼) ਤੀਰਾ ਨਾਲ ਭਰ ਦਿੱਤਾ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "हर पुर पुर सुर ॥",
      "sourceLineId": "85586",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਿਰਖਤ ਬਰ ਨਰ ॥੪੫੪॥",
      "transliteration": "nirakhat bar nar ||454||",
      "translation": "Filled with ghosts, fiends and ganas, has become the dwelling place of Shiva  all the people are looking at this scene.454.",
      "punjabiViakhya": "ਭਲੇ ਪੁਰਸ਼ ਵੇਖ ਰਹੇ ਹਨ ॥੪੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "निरखत बर नर ॥४५४॥",
      "sourceLineId": "85587",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਰਖਤ ਸਰ ਬਰ ॥",
      "transliteration": "barakhat sar bar ||",
      "translation": "",
      "punjabiViakhya": "ਬਲ ਪੂਰਵਕ ਤੀਰਾ ਦੀ ਬਰਖਾ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "बरखत सर बर ॥",
      "sourceLineId": "85588",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਰਖਤ ਧਨੁ ਕਰਿ ॥",
      "transliteration": "karakhat dhan kar ||",
      "translation": "There is shower of arrows and the bows are being pulled",
      "punjabiViakhya": "ਹੱਥ ਨਾਲ ਧਨੁਸ਼ ਨੂੰ ਖਿੱਚਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "करखत धनु करि ॥",
      "sourceLineId": "85589",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪਰਹਰ ਪੁਰ ਕਰ ॥",
      "transliteration": "parahar pur kar ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਧਨੁਸ਼ ਨਾਲ ਤੀਰ ਜੋੜ ਕੇ ਛੱਡ ਦਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "परहर पुर कर ॥",
      "sourceLineId": "85590",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਿਰਖਤ ਬਰ ਨਰ ॥੪੫੫॥",
      "transliteration": "nirakhat bar nar ||455||",
      "translation": "People are leaving the city and this scene is being viewed by all.455.",
      "punjabiViakhya": "ਸ੍ਰੇਸ਼ਠ ਪੁਰਸ਼ ਵੇਖ ਰਹੇ ਹਨ ॥੪੫੫॥",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "निरखत बर नर ॥४५५॥",
      "sourceLineId": "85591",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਰ ਬਰ ਧਰ ਕਰ ॥",
      "transliteration": "sar bar dhar kar ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਗਾ ਤੀਰ ਹੱਥ ਵਿੱਚ ਧਾਰਨ ਕਰਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "सर बर धर कर ॥",
      "sourceLineId": "85592",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪਰਹਰ ਪੁਰ ਸਰ ॥",
      "transliteration": "parahar pur sar ||",
      "translation": "The people are leaving the city very quickly, they are testing their own endurance and",
      "punjabiViakhya": "ਅਤੇ ਕੱਸੇ ਹੋਏ ਤੀਰਾ ਨੂੰ ਚਲਾ ਦਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "परहर पुर सर ॥",
      "sourceLineId": "85593",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0247_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪਰਖਤ ਉਰ ਨਰ ॥",
      "transliteration": "parakhat ur nar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਤੀਰ ਸੂਰਮੇ ਦੀ ਛਾਤੀ ਨੂੰ ਪਰਖਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 247,
      "hindi": "",
      "hindiTransliteration": "परखत उर नर ॥",
      "sourceLineId": "85594",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
