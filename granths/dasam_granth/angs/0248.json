{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 248,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0248_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਿਸਰਤ ਉਰ ਧਰ ॥੪੫੬॥",
      "transliteration": "nisarat ur dhar ||456||",
      "translation": "Are leaving keeping their desire within their hearts.456.",
      "punjabiViakhya": "ਅਤੇ ਦੂਜੇ ਪਾਸੇ ਨੂੰ ਨਿਕਲ ਜਾਦੇ ਹਨ ॥੪੫੬॥",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "निसरत उर धर ॥४५६॥",
      "sourceLineId": "85595",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਉਝਰਤ ਜੁਝ ਕਰ ॥",
      "transliteration": "aujharat jujh kar ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਵੀਰ) ਯੁੱਧ ਕਰਕੇ ਉਲਝ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "उझरत जुझ कर ॥",
      "sourceLineId": "85596",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਿਝੁਰਤ ਜੁਝ ਨਰ ॥",
      "transliteration": "bijhurat jujh nar ||",
      "translation": "The warriors are entangled among themselves and all are fighting with one another,",
      "punjabiViakhya": "ਜੂਝ ਕੇ (ਹੋਰਨਾ) ਵੀਰਾ ਤੋਂ ਵਿਛੁੜ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "बिझुरत जुझ नर ॥",
      "sourceLineId": "85597",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹਰਖਤ ਮਸਹਰ ॥",
      "transliteration": "harakhat masahar ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਸਾਹਾਰੀ (ਜੰਤੂ) ਪ੍ਰਸੰਨ ਹੁੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "हरखत मसहर ॥",
      "sourceLineId": "85598",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਰਖਤ ਸਿਤ ਸਰ ॥੪੫੭॥",
      "transliteration": "barakhat sit sar ||457||",
      "translation": "Some people are getting delighted and showering their arrows.457.",
      "punjabiViakhya": "ਚਮਕਦਾਰ ਤੀਰਾ ਦੀ ਬਰਖਾ ਕਰਦੇ ਹਨ ॥੪੫੭॥",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "बरखत सित सर ॥४५७॥",
      "sourceLineId": "85599",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਝੁਰ ਝਰ ਕਰ ਕਰ ॥",
      "transliteration": "jhur jhar kar kar ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਝ (ਯੋਧੇ) ਝੁਰ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "झुर झर कर कर ॥",
      "sourceLineId": "85600",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਡਰਿ ਡਰਿ ਧਰ ਹਰ ॥",
      "transliteration": "ddar ddar dhar har ||",
      "translation": "People who are afraid in their minds, are meditating on Shiva and",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਡਰ ਕਰਕੇ ਕੰਬਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "डरि डरि धर हर ॥",
      "sourceLineId": "85601",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹਰ ਬਰ ਧਰ ਕਰ ॥",
      "transliteration": "har bar dhar kar ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਸੂਰਮੇ ਤਲਵਾਰ ਨੂੰ ਹੱਥ ਵਿੱਚ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "हर बर धर कर ॥",
      "sourceLineId": "85602",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਿਹਰਤ ਉਠ ਨਰ ॥੪੫੮॥",
      "transliteration": "biharat uTh nar ||458||",
      "translation": "Remembering Shiva for their for their protection, they are trembling.458.",
      "punjabiViakhya": "ਉਠ ਕੇ ਫਿਰਨ ਲੱਗ ਜਾਦੇ ਹਨ ॥੪੫੮॥",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "बिहरत उठ नर ॥४५८॥",
      "sourceLineId": "85603",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਉਚਰਤ ਜਸ ਨਰ ॥",
      "transliteration": "aucharat jas nar ||",
      "translation": "",
      "punjabiViakhya": "ਬੰਦੀਜਨ ਯਸ਼ ਉਚਾਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "उचरत जस नर ॥",
      "sourceLineId": "85604",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਿਚਰਤ ਧਸਿ ਨਰ ॥",
      "transliteration": "bicharat dhas nar ||",
      "translation": "As soon as the sound rises, people go into their houses and",
      "punjabiViakhya": "ਵੀਰਾ ਨੂੰ ਧੱਸੀ ਫਿਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "बिचरत धसि नर ॥",
      "sourceLineId": "85605",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਥਰਕਤ ਨਰ ਹਰ ॥",
      "transliteration": "tharakat nar har ||",
      "translation": "",
      "punjabiViakhya": "(ਕ੍ਰੋਧ ਕਾਰਨ) ਨਰ ਸਿੰਘ ਵਾਗ ਕੰਬ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "थरकत नर हर ॥",
      "sourceLineId": "85606",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਰਖਤ ਭੁਅ ਪਰ ॥੪੫੯॥",
      "transliteration": "barakhat bhua par ||459||",
      "translation": "The warriors here are falling on the earth, moving like man-lion incarnation.459.",
      "punjabiViakhya": "ਅਤੇ ਧਰਤੀ ਉੱਤੇ ਡਿੱਗਦੇ ਜਾਦੇ ਹਨ ॥੪੫੯॥",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "बरखत भुअ पर ॥४५९॥",
      "sourceLineId": "85607",
      "sourceShabadId": "7995",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਿਲਕੜੀਆ ਛੰਦ ॥",
      "transliteration": "tilakaReeaa chha(n)dh ||",
      "translation": "TILKARIYA STANZA",
      "punjabiViakhya": "ਤਿਲਕੜੀਆ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "तिलकड़ीआ छंद ॥",
      "sourceLineId": "85608",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚਟਾਕ ਚੋਟੈ ॥",
      "transliteration": "chaTaak choTai ||",
      "translation": "",
      "punjabiViakhya": "(ਵੀਰ) ਚੱਟਕ ਕਰਕੇ (ਤਲਵਾਰ ਦੀ) ਚੋਟ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "चटाक चोटै ॥",
      "sourceLineId": "85609",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਟਾਕ ਓਟੈ ॥",
      "transliteration": "aTaak oTai ||",
      "translation": "The blows of the swords are causing knocking sounds on the shields and the warriors are saving themselves from the shields",
      "punjabiViakhya": "(ਅੱਗੋਂ ਦੂਜੇ ਸੈਨਿਕ) ਢਾਲ ਦੀ ਓਟ ਲੈਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "अटाक ओटै ॥",
      "sourceLineId": "85610",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਝੜਾਕ ਝਾੜੈ ॥",
      "transliteration": "jhaRaak jhaaRai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਝਟਕ ਕੇ ਤਲਵਾਰ ਝਾੜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "झड़ाक झाड़ै ॥",
      "sourceLineId": "85611",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤੜਾਕ ਤਾੜੈ ॥੪੬੦॥",
      "transliteration": "taRaak taaRai ||460||",
      "translation": "The weapons are being struck and (the warriors) are being killed by making them targets.460.",
      "punjabiViakhya": "ਤੜ-ਤੜ ਕਰਦੀ (ਬੰਦੂਕ) ਨਾਲ ਭੁੰਨ ਦਿੰਦੇ ਹਨ ॥੪੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "तड़ाक ताड़ै ॥४६०॥",
      "sourceLineId": "85612",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਫਿਰੰਤ ਹੂਰੰ ॥",
      "transliteration": "fira(n)t hoora(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਆਕਾਸ਼ ਵਿੱਚ) ਹੂਰਾ ਫਿਰਦੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "फिरंत हूरं ॥",
      "sourceLineId": "85613",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਰੰਤ ਸੂਰੰ ॥",
      "transliteration": "bara(n)t soora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੂਰਮਿਆਂ ਨੂੰ ਵਰਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "बरंत सूरं ॥",
      "sourceLineId": "85614",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰਣੰਤ ਜੋਹੰ ॥",
      "transliteration": "rana(n)t joha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਕੋਈ ਘੁੰਘਰੂਆਂ ਦੀ ਛਣਕਾਰ ਵੇਖਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "रणंत जोहं ॥",
      "sourceLineId": "85615",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਉਠੰਤ ਕ੍ਰੋਹੰ ॥੪੬੧॥",
      "transliteration": "auTha(n)t kroha(n) ||461||",
      "translation": "The heavenly damsels are moving in the battlefield and wedding the warriors, they are seeing the war and the warriors, who are desirous of obtaining them, are getting immensely infuriated.461.",
      "punjabiViakhya": "ਤਾ ਕ੍ਰੋਧ ਨਾਲ ਖੜਾ ਹੋ ਜਾਦਾ ਹੈ ॥੪੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "उठंत क्रोहं ॥४६१॥",
      "sourceLineId": "85616",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭਰੰਤ ਪੱਤ੍ਰੰ ॥",
      "transliteration": "bhara(n)t pa'tra(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੋਗਣਾ ਖੱਪਰ ਭਰਦੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "भरंत पत्त्रं ॥",
      "sourceLineId": "85617",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤੁਟੰਤ ਅੱਤ੍ਰੰ ॥",
      "transliteration": "tuTa(n)t a'tra(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਸਤ੍ਰ ਟੁੱਟਦੇ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "तुटंत अत्त्रं ॥",
      "sourceLineId": "85618",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਝੜੰਤ ਅਗਨੰ ॥",
      "transliteration": "jhaRa(n)t agana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਤਲਵਾਰਾ ਦੇ ਵਜਣ ਨਾਲ) ਚਿੰਗਾੜੀਆਂ ਝੜਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "झड़ंत अगनं ॥",
      "sourceLineId": "85619",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਲੰਤ ਜਗਨੰ ॥੪੬੨॥",
      "transliteration": "jala(n)t jagana(n) ||462||",
      "translation": "The bowls are being filled with blood, the arms are breaking, the sparks of fire are looking like glow-worms.462.",
      "punjabiViakhya": "(ਮਾਨੋ) ਜੁਗਨੂੰ ਪ੍ਰਕਾਸ਼ ਕਰਦੇ ਹੋਣ ॥੪੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "जलंत जगनं ॥४६२॥",
      "sourceLineId": "85620",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੁਟੰਤ ਖੋਲੰ ॥",
      "transliteration": "tuTa(n)t khola(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮਿਆਂ ਦੇ) ਸਿਰ ਦੇ ਟੋਪ ਟੁੱਟਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "तुटंत खोलं ॥",
      "sourceLineId": "85621",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜੁਟੰਤ ਟੋਲੰ ॥",
      "transliteration": "juTa(n)t Tola(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਨ੍ਰਹਾ ਦੇ) ਟੋਲੇ (ਆਪਸ ਵਿੱਚ) ਜੁਟੀ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "जुटंत टोलं ॥",
      "sourceLineId": "85622",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਖਿਮੰਤ ਖੱਗੰ ॥",
      "transliteration": "khima(n)t kha'ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਚਮਕਦੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "खिमंत खग्गं ॥",
      "sourceLineId": "85623",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਉਠੰਤ ਅੱਗੰ ॥੪੬੩॥",
      "transliteration": "auTha(n)t a'ga(n) ||463||",
      "translation": "The warriors are fighting, the armours are breaking, the spears are falling on the shields and the sparks are rising.463.",
      "punjabiViakhya": "(ਮਾਨੋ) ਅੱਗ ਨਿਕਲਦੀ ਹੋਵੇ ॥੪੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "उठंत अग्गं ॥४६३॥",
      "sourceLineId": "85624",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚਲੰਤ ਬਾਣੰ ॥",
      "transliteration": "chala(n)t baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣ ਚੱਲਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "चलंत बाणं ॥",
      "sourceLineId": "85625",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਰੁਕੰ ਦਿਸਾਣੰ ॥",
      "transliteration": "ruka(n) dhisaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦਿਸ਼ਾਵਾ ਰੁਕ ਗਈਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "रुकं दिसाणं ॥",
      "sourceLineId": "85626",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪਪਾਤ ਸਸਤ੍ਰੰ ॥",
      "transliteration": "papaat sasatra(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰਾ ਦੇ ਪ੍ਰਹਾਰ ਹੁੰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "पपात ससत्रं ॥",
      "sourceLineId": "85627",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਘਾਤ ਅਸਤ੍ਰੰ ॥੪੬੪॥",
      "transliteration": "aghaat asatra(n) ||464||",
      "translation": "With the discharge of arrows, the directions have turned, there are blows and the sparks are rising.464.",
      "punjabiViakhya": "ਅਸਤ੍ਰਾ ਦੇ ਆਘਾਤ ਹੁੰਦੇ ਹਨ ॥੪੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "अघात असत्रं ॥४६४॥",
      "sourceLineId": "85628",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਖਹੰਤ ਖੱਤ੍ਰੀ ॥",
      "transliteration": "khaha(n)t kha'tree ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸ਼ਤ੍ਰਧਾਰੀ ਸੂਰਮੇ ਖਹਿੰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "खहंत खत्त्री ॥",
      "sourceLineId": "85629",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਿਰੰਤ ਅੱਤ੍ਰੀ ॥",
      "transliteration": "bhira(n)t a'tree ||",
      "translation": "",
      "punjabiViakhya": "ਅਸਤ੍ਰਾ ਵਾਲੇ ਭਿੜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "भिरंत अत्त्री ॥",
      "sourceLineId": "85630",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬੁਠੰਤ ਬਾਣੰ ॥",
      "transliteration": "buTha(n)t baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣਾ ਦੀ ਬਰਖਾ ਹੁੰਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "बुठंत बाणं ॥",
      "sourceLineId": "85631",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਖਿਵੈ ਕ੍ਰਿਪਾਣੰ ॥੪੬੫॥",
      "transliteration": "khivai kirapaana(n) ||465||",
      "translation": "The Kshatriyas, getting hold of arms in their hands, are fighting, they are discharging arrows and striking with swords.465.",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਚਮਕਦੀਆਂ ਹਨ ॥੪੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "खिवै कृपाणं ॥४६५॥",
      "sourceLineId": "85632",
      "sourceShabadId": "7996",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "85633",
      "sourceShabadId": "7997",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਲੁੱਥ ਜੁੱਥ ਬਿੱਥੁਰ ਰਹੀ ਰਾਵਣ ਰਾਮ ਬਿਰੁੱਧ ॥",
      "transliteration": "lu'th ju'th bi'thur rahee raavan raam biru'dh ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਦੇ ਵਿਰੋਧੀ ਪੱਖ ਵਾਲੇ ਰਾਵਣ (ਦੀ ਸੈਨਾ) ਦੀਆਂ ਲੋਥਾ ਦੇ ਝੁੰਡ ਪਸਰੇ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "लुत्थ जुत्थ बित्थुर रही रावण राम बिरुद्ध ॥",
      "sourceLineId": "85634",
      "sourceShabadId": "7997",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਤਯੋ ਮਹੋਦਰ ਦੇਖ ਕਰ ਹਰਿ ਅਰਿ ਫਿਰਯੋ ਸੁ ਕ੍ਰੁੱਧ ॥੪੬੬॥",
      "transliteration": "hatayo mahodhar dhekh kar har ar firayo su kru'dh ||466||",
      "translation": "In this war between Ram and Ravana the clusters of corpses scattered here and there and seeing Mahodar being killed Inderjit (Meghand) marched forward.466.",
      "punjabiViakhya": "ਮਹੋਦਰ (ਨੂੰ ਮਰਦਾ ਵੇਖ ਕੇ)ਇੰਦਰ ਦਾ ਵੈਰੀ (ਮੇਘਨਾਦ) ਕ੍ਰੋਧ ਨਾਲ ਮੁੜ ਪਿਆ ਹੈ ॥੪੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "हतयो महोदर देख कर हरि अरि फिरयो सु क्रुद्ध ॥४६६॥",
      "sourceLineId": "85635",
      "sourceShabadId": "7997",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਰਾਮਵਤਾਰ ਮਹੋਦਰ ਮੰਤ੍ਰੀ ਬਧਹਿ ਧਿਆਇ ਸਮਾਪਤਮ ਸਤੁ ॥",
      "transliteration": "eit sree bachitr naaTake raamavataar mahodhar ma(n)tree badheh dhiaai samaapatam sat ||",
      "translation": "End of the chapter entitled ‘The Killing of Mahodar Mantri’ in Ramavtar in BACHITTAR NATAK.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਦੇ ਰਾਮਾਵਤਾਰ ਦੇ ਮਹੋਦਰ ਮੰਤਰੀ ਬਧਹਿ ਅਧਿਆਇ ਦੀ ਸਮਾਪਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटके रामवतार महोदर मंत्री बधहि धिआइ समापतम सतु ॥",
      "sourceLineId": "85636",
      "sourceShabadId": "7997",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਥ ਇੰਦ੍ਰਜੀਤ ਜੁੱਧ ਕਥਨੰ ॥",
      "transliteration": "ath i(n)dhrajeet ju'dh kathana(n) ||",
      "translation": "Now begins the description of war with Inderjit :",
      "punjabiViakhya": "ਹੁਣ ਇੰਦਰਜੀਤ ਦੇ ਯੁੱਧ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "अथ इंद्रजीत जुद्ध कथनं ॥",
      "sourceLineId": "85637",
      "sourceShabadId": "7998",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਿਰਖਿੰਡੀ ਛੰਦ ॥",
      "transliteration": "sirakhi(n)ddee chha(n)dh ||",
      "translation": "SIRKHINDI STANZA",
      "punjabiViakhya": "ਸਿਰ ਖੰਡੀ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "सिरखिंडी छंद ॥",
      "sourceLineId": "85638",
      "sourceShabadId": "7998",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜੁੱਟੇ ਵੀਰ ਜੁੱਝਾਰੇ ਧੱਗਾ ਵੱਜੀਆਂ ॥",
      "transliteration": "ju'Te veer ju'jhaare dha'gaa va'jeeaa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨਗਾਰੇ ਵੱਜੇ ਅਤੇ ਲੜਾਕੇ ਸੂਰਮੇ (ਆਪਸ ਵਿੱਚ) ਜੁੱਟ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "जुट्टे वीर जुज्झारे धग्गा वज्जीआँ ॥",
      "sourceLineId": "85639",
      "sourceShabadId": "7998",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬੱਜੇ ਨਾਦ ਕਰਾਰੇ ਦਲਾ ਮੁਸਾਹਦਾ ॥",
      "transliteration": "ba'je naadh karaare dhalaa musaahadhaa ||",
      "translation": "The trumpets sounded and the warriors faced one another and both the armies, prepared for war while thundering",
      "punjabiViakhya": "ਧੌਂਸੇ ਜ਼ੋਰ ਨਾਲ ਵਜੇ, (ਦੋਹਾ ਫ਼ੌਜਾ ਦਾ) ਮੁਕਾਬਲਾ ਸ਼ੁਰੂ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "बज्जे नाद करारे दला मुसाहदा ॥",
      "sourceLineId": "85640",
      "sourceShabadId": "7998",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਲੁੱਝੇ ਕਾਰਣਯਾਰੇ ਸੰਘਰ ਸੂਰਮੇ ॥",
      "transliteration": "lu'jhe kaaranayaare sa(n)ghar soorame ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਵਿੱਚ ਸਾਕੇ ਕਰ ਵਿਖਾਉਣ ਵਾਲੇ ਸੂਰਮੇ ਲੜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "लुज्झे कारणयारे संघर सूरमे ॥",
      "sourceLineId": "85641",
      "sourceShabadId": "7998",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0248_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਵੁੱਠੇ ਜਾਣੁ ਡਰਾਰੇ ਘਣੀਅਰ ਕੈਬਰੀ ॥੪੬੭॥",
      "transliteration": "vu'The jaan ddaraare ghaneear kaibaree ||467||",
      "translation": "They who performed very difficult tasks, fought with one another and the arrows were discharged like the frightful flying serpents.467.",
      "punjabiViakhya": "ਤੀਰਾ ਦੀ ਬਰਖਾ ਇਸ ਤਰ੍ਰਹਾ ਹੋ ਰਹੀ ਹੈ ਮਾਨੋ ਡਰਾਉਣੇ ਬੱਦਲਾ ਤੋਂ ਬਰਖਾ ਹੋ ਰਹੀ ਹੋਵੇ ॥੪੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 248,
      "hindi": "",
      "hindiTransliteration": "वुट्ठे जाणु डरारे घणीअर कैबरी ॥४६७॥",
      "sourceLineId": "85642",
      "sourceShabadId": "7998",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
