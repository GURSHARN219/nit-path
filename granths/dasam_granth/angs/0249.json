{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 249,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0249_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਵੱਜੇ ਸੰਗਲੀਆਲੇ ਹਾਠਾ ਜੁੱਟੀਆਂ ॥",
      "transliteration": "va'je sa(n)galeeaale haaThaa ju'Teeaa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦੋਂ) ਸੰਗਲਾ ਵਾਲੇ ਧੌਂਸੇ ਵੱਜੇ (ਤਦੋਂ ਦੋਵੇਾਂ) ਧਿਰਾ (ਆਪਸ ਵਿੱਚ) ਜੁੱਟ ਪਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "वज्जे संगलीआले हाठा जुट्टीआँ ॥",
      "sourceLineId": "85643",
      "sourceShabadId": "7998",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਖੇਤ ਬਹੇ ਮੁੱਛਾਲੇ ਕਹਰ ਤਤਾਰਚੇ ॥",
      "transliteration": "khet bahe mu'chhaale kahar tataarache ||",
      "translation": "The big chained trumpets sounded and the rows of soldiers began to fight with one another, the long-whiskered and tyrannical warriors marched forward",
      "punjabiViakhya": "ਮੁੱਛਾ ਵਾਲੇ ਸੂਰਮੇ ਰਣ-ਭੂਮੀ ਵਿੱਚ ਕਹਿਰ ਭਰੇ ਤੀਰ ਚਲਾਉਾਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "खेत बहे मुच्छाले कहर ततारचे ॥",
      "sourceLineId": "85644",
      "sourceShabadId": "7998",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਡਿੱਗੇ ਵੀਰ ਜੁੱਝਾਰੇ ਹੂੰਗਾ ਫੁੱਟੀਆਂ ॥",
      "transliteration": "ddi'ge veer ju'jhaare hoo(n)gaa fu'Teeaa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਲੜਾਕੇ ਯੋਧੇ ਡਿੱਗੇ ਪਏ ਹਨ। (ਉਨ੍ਰਹਾ ਦੀਆਂ) ਹੂੰਗਰਾ ਨਿਕਲ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "डिग्गे वीर जुज्झारे हूँगा फुट्टीआँ ॥",
      "sourceLineId": "85645",
      "sourceShabadId": "7998",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬੱਕੇ ਜਾਣ ਮਤਵਾਲੇ ਭੰਗਾ ਖਾਇ ਕੈ ॥੪੬੮॥",
      "transliteration": "ba'ke jaan matavaale bha(n)gaa khai kai ||468||",
      "translation": "Alongwith them the powerful fighters began to sob on falling in the battlefield.The warriors being intoxicated are shouting like someone shrieking in inebriation after eating hemp. 468",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ) ਮਾਨੋ ਭੰਗ ਪੀ ਕੇ ਮਤਵਾਲੇ ਹੋ ਗਏ ਹੋਣ ॥੪੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "बक्के जाण मतवाले भंगा खाइ कै ॥४६८॥",
      "sourceLineId": "85646",
      "sourceShabadId": "7998",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਓਰੜਏ ਹੰਕਾਰੀ ਧੱਗਾ ਵਾਇ ਕੈ ॥",
      "transliteration": "oraRe ha(n)kaaree dha'gaa vai kai ||",
      "translation": "",
      "punjabiViakhya": "ਧੌਂਸਿਆਂ ਨੂੰ ਵਜਾ ਕੇ ਹੰਕਾਰੀ (ਸੂਰਮੇ) ਉਲਰ ਕੇ ਪੈ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "ओरड़ए हंकारी धग्गा वाइ कै ॥",
      "sourceLineId": "85647",
      "sourceShabadId": "7998",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਵਾਹਿ ਫਿਰੇ ਤਰਵਾਰੀ ਸੂਰੇ ਸੂਰਿਆਂ ॥",
      "transliteration": "vaeh fire taravaaree soore sooriaa(n) ||",
      "translation": "The proud warriors marched forward after causing the resonance of big trumpets and began to strike blows with their swords.",
      "punjabiViakhya": "ਸੂਰਮੇ ਸੂਰਮਿਆਂ ਉੱਪਰ ਤਲਵਾਰਾ ਵਾਹੁੰਦੇ ਫਿਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "वाहि फिरे तरवारी सूरे सूरिआँ ॥",
      "sourceLineId": "85648",
      "sourceShabadId": "7998",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਵੱਗੈ ਰਤੁ ਝੁਲਾਰੀ ਝਾੜੀ ਕੈਬਰੀ ॥",
      "transliteration": "va'gai rat jhulaaree jhaaRee kaibaree ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰਾ ਦੀ ਝੜੀ ਲੱਗਣ ਨਾਲ ਝਲਾਰਾ ਦੇ ਪਾਣੀ ਵਾਗ ਲਹੂ ਵਗਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "वग्गै रतु झुलारी झाड़ी कैबरी ॥",
      "sourceLineId": "85649",
      "sourceShabadId": "7998",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪਾਈ ਧੂੰਮ ਲੁਝਾਰੀ ਰਾਵਣ ਰਾਮ ਦੀ ॥੪੬੯॥",
      "transliteration": "paiee dhoo(n)m lujhaaree raavan raam dhee ||469||",
      "translation": "With the shower of arrows a continuous stream of blood flowed and this war of Ram and Ravana became famours on all the four sides.469.",
      "punjabiViakhya": "ਲੜਾਕੇ ਵੀਰਾ ਨੇ ਰਾਵਣ ਤੇ ਰਾਮ ਦੀ ਧੁੰਮ ਪਾ ਦਿੱਤੀ ਹੈ ॥੪੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "पाई धूँम लुझारी रावण राम दी ॥४६९॥",
      "sourceLineId": "85650",
      "sourceShabadId": "7998",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਚੋਬੀ ਧਉਸ ਵਜਾਈ ਸੰਘੁਰ ਮੱਚਿਆ ॥",
      "transliteration": "chobee dhaus vajaiee sa(n)ghur ma'chiaa ||",
      "translation": "",
      "punjabiViakhya": "ਨਗਾਰਚੀਆਂ ਨੇ ਨਗਾਰਿਆਂ ਨੂੰ ਵਜਾਇਆ ਤਾ ਯੁੱਧ ਸ਼ੁਰੂ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "चोबी धउस वजाई संघुर मच्चिआ ॥",
      "sourceLineId": "85651",
      "sourceShabadId": "7998",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਾਹਿ ਫਿਰੈ ਵੈਰਾਈ ਤੁਰੇ ਤਤਾਰਚੇ ॥",
      "transliteration": "baeh firai vairaiee ture tataarache ||",
      "translation": "With the sounding of trumpets a terrible war began and the enemies wandered here and there on the fast-moving steeds",
      "punjabiViakhya": "ਘੋੜਿਆਂ ਉੱਤੇ ਚੜ੍ਰਹੇ ਹੋਏ ਯੋਧੇ ਵੈਰੀਆਂ ਉੱਤੇ ਬਾਣ ਚਲਾਉਦੇ ਫਿਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "बाहि फिरै वैराई तुरे ततारचे ॥",
      "sourceLineId": "85652",
      "sourceShabadId": "7998",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹੂਰਾ ਚਿੱਤ ਵਧਾਈ ਅੰਬਰ ਪੂਰਿਆ ॥",
      "transliteration": "hooraa chi't vadhaiee a(n)bar pooriaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੂਰਾ ਦੇ ਚਿੱਤ ਵਿੱਚ ਪ੍ਰਸੰਨਤਾ ਹੋ ਰਹੀ ਹੈ (ਅਤੇ ਉਨ੍ਰਹਾ ਨਾਲ) ਆਕਾਸ਼ ਭਰਿਆ ਪਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "हूरा चित्त वधाई अंबर पूरिआ ॥",
      "sourceLineId": "85653",
      "sourceShabadId": "7998",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੋਧਿਯਾ ਦੇਖਣ ਤਾਈ ਹੂਲੇ ਹੋਈਆਂ ॥੪੭੦॥",
      "transliteration": "jodhiyaa dhekhan taiee hoole hoieeaa(n) ||470||",
      "translation": "There on the sky the heavenly damsels gathered together with the zeal of wedding the brave warriors and came nearer in order to see them waging the war.470.",
      "punjabiViakhya": "ਯੋਧਿਆਂ ਨੂੰ ਵੇਖਣ ਲਈ ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ ਇਕੱਠੀਆਂ ਹੋ ਗਈਆਂ ਹਨ ॥੪੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "जोधिया देखण ताई हूले होईआँ ॥४७०॥",
      "sourceLineId": "85654",
      "sourceShabadId": "7998",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪਾਧੜੀ ਛੰਦ ॥",
      "transliteration": "paadhaRee chha(n)dh ||",
      "translation": "PAADHARI STANZA",
      "punjabiViakhya": "ਪਾਧੜੀ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "पाधड़ी छंद ॥",
      "sourceLineId": "85655",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇੰਦ੍ਰਾਰ ਵੀਰ ਕੁੱਪਯੋ ਕਰਾਲ ॥",
      "transliteration": "ei(n)dhraar veer ku'payo karaal ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਘਨਾਦ (ਇੰਦ੍ਰਾਰਿ) ਸੂਰਮੇ ਨੇ ਭਿਆਨਕ ਕ੍ਰੋਧ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "इंद्रार वीर कुप्पयो कराल ॥",
      "sourceLineId": "85656",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮੁਕਤੰਤ ਬਾਣ ਗਹਿ ਧਨੁ ਬਿਸਾਲ ॥",
      "transliteration": "mukata(n)t baan geh dhan bisaal ||",
      "translation": "Inderjit in great fury, holding his wide bow, began to discharge arrows",
      "punjabiViakhya": "ਵਿਸ਼ਾਲ ਧਨੁਸ਼ ਨੂੰ ਫੜ ਕੇ ਤੀਰ ਛੱਡ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "मुकतंत बाण गहि धनु बिसाल ॥",
      "sourceLineId": "85657",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਥਰਕੰਤ ਲੁੱਥ ਫਰਕੰਤ ਬਾਹ ॥",
      "transliteration": "tharaka(n)t lu'th faraka(n)t baeh ||",
      "translation": "",
      "punjabiViakhya": "ਲੋਥਾ ਤੜਫ ਰਹੀਆਂ ਹਨ ਅਤੇ ਬਾਹਵਾ ਫਰਕ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "थरकंत लुत्थ फरकंत बाह ॥",
      "sourceLineId": "85658",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜੁੱਝੰਤ ਸੂਰ ਅੱਛਰੈ ਉਛਾਹ ॥੪੭੧॥",
      "transliteration": "ju'jha(n)t soor a'chharai uchhaeh ||471||",
      "translation": "The corpses writhed and the arms of the warriors fluttered  the warriors began to fight and the heavenly damsels were filled with joy.471.",
      "punjabiViakhya": "ਸੂਰਮੇ ਜੂਝਦੇ ਹਨ ਅਤੇ ਅਪਸਰਾਵਾ ਉਤਸ਼ਾਹਿਤ ਹੋ ਰਹੀਆਂ ਹਨ ॥੪੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "जुज्झंत सूर अच्छरै उछाह ॥४७१॥",
      "sourceLineId": "85659",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚਮਕੰਤ ਚੱਕ੍ਰ ਸਰਖੰਤ ਸੇਲ ॥",
      "transliteration": "chamaka(n)t cha'kr sarakha(n)t sel ||",
      "translation": "",
      "punjabiViakhya": "ਚੱਕਰ ਚਮਕਦੇ ਹਨ, ਭਾਲੇ ਸਰਕਦੇ ਹਨ। ਜਟਾ ਵਾਲੇ (ਰਾਖਸ਼) ਚਲ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "चमकंत चक्क्र सरखंत सेल ॥",
      "sourceLineId": "85660",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜੁੱਮੇ ਜਟਾਲ ਜਣ ਗੰਗ ਮੇਲ ॥",
      "transliteration": "ju'me jaTaal jan ga(n)g mel ||",
      "translation": "The discs glittered, the lances moved and the fighters with matted hair sped up to fight as if they are going to take a bath in the Ganges.",
      "punjabiViakhya": "ਮਾਨੋ ਗੰਗਾ ਤੇ ਮੇਲੇ ਤੋਂ (ਸਾਧੂ ਇਕੱਠੇ ਹੋ ਕੇ ਜਾ ਰਹੇ ਹੋਣ)",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "जुम्मे जटाल जण गंग मेल ॥",
      "sourceLineId": "85661",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੰਘਰੇ ਸੂਰ ਆਘਾਇ ਘਾਇ ॥",
      "transliteration": "sa(n)ghare soor aaghai ghai ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਯੁੱਧ ਵਿੱਚ ਰੱਜ ਕੇ ਘਾਉ ਖਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "संघरे सूर आघाइ घाइ ॥",
      "sourceLineId": "85662",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਰਖੰਤ ਬਾਣ ਚੜ ਚਉਪ ਚਾਇ ॥੪੭੨॥",
      "transliteration": "barakha(n)t baan chaR chaup chai ||472||",
      "translation": "The wounded warriors were killed and on the other hand the warriors began to shower arrows with fourfold zeal.472.",
      "punjabiViakhya": "ਤੀਰਾ ਦੀ ਬਰਖਾ ਕਰਦੇ ਹਨ ਅਤੇ (ਉਨ੍ਰਹਾ ਦੇ ਚਿੱਤ ਵਿੱਚ) ਚਾਉ ਚੜ੍ਰਹ ਰਿਹਾ ਹੈ ॥੪੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "बरखंत बाण चड़ चउप चाइ ॥४७२॥",
      "sourceLineId": "85663",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੱਮੁਲੇ ਸੂਰ ਆਰੁਹੇ ਜੰਗ ॥",
      "transliteration": "sa'mule soor aaruhe ja(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣਾ ਆਪ ਸੰਭਲੇ ਹੋਏ ਸੂਰਮੇ ਯੁੱਧ ਵਿੱਚ ਰੁਝੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "सम्मुले सूर आरुहे जंग ॥",
      "sourceLineId": "85664",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਰਖੰਤ ਬਾਣ ਬਿਖ ਧਰ ਸੁਰੰਗ ॥",
      "transliteration": "barakha(n)t baan bikh dhar sura(n)g ||",
      "translation": "The frightful warriors entangled in war are showering arrows like poisonous serpents",
      "punjabiViakhya": "ਵਿਸ਼ ਬੁਝੇ ਬਾਣਾ ਦੀ ਬਰਖਾ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "बरखंत बाण बिख धर सुरंग ॥",
      "sourceLineId": "85665",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਭਿ ਹ੍ਵੈ ਅਲੋਪ ਸਰ ਬਰਖ ਧਾਰ ॥",
      "transliteration": "nabh havai alop sar barakh dhaar ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰਾ ਦੀ ਲੜੀ ਨੇ ਆਕਾਸ਼ ਨੂੰ ਢੱਕ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "नभि ह्वै अलोप सर बरख धार ॥",
      "sourceLineId": "85666",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਭ ਊਚ ਨੀਚ ਕਿੰਨੇ ਸੁਮਾਰ ॥੪੭੩॥",
      "transliteration": "sabh uooch neech ki(n)ne sumaar ||473||",
      "translation": "With the shower of arrows the sky is not visible and there in no differentiation between high and low.473.",
      "punjabiViakhya": "ਸਾਰੇ ਛੋਟੇ ਵੱਡੇ ਗਿਣ ਲਏ ਗਏ ਹਨ ॥੪੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "सभ ऊच नीच किंने सुमार ॥४७३॥",
      "sourceLineId": "85667",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਭ ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਬਿੱਦਿਆ ਪ੍ਰਬੀਨ ॥",
      "transliteration": "sabh sasatr asatr bi'dhiaa prabeen ||",
      "translation": "",
      "punjabiViakhya": "(ਮੇਘਨਾਦ) ਸਾਰਿਆਂ ਸ਼ਸਤ੍ਰਾ ਤੇ ਅਸਤ੍ਰਾ ਦੀ ਵਿਦਿਆ ਵਿੱਚ ਪ੍ਰਬੀਨ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "सभ ससत्र असत्र बिद्दिआ प्रबीन ॥",
      "sourceLineId": "85668",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਰ ਧਾਰ ਬਰਖ ਸਰਦਾਰ ਚੀਨ ॥",
      "transliteration": "sar dhaar barakh saradhaar cheen ||",
      "translation": "All the warriors specialize in the science of weaponry and locating the general they are showering arrows on them",
      "punjabiViakhya": "ਉਸ ਨੇ ਮੁੱਖੀ ਸੈਨਾ-ਨਾਇਕ ਨੂੰ ਪਛਾਣ ਕੇ ਤੀਰਾ ਦੀ ਮੋਹਲੇਧਾਰ ਬਰਖਾ ਕਰ ਦਿੱਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "सर धार बरख सरदार चीन ॥",
      "sourceLineId": "85669",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰਘੁਰਾਜ ਆਦਿ ਮੋਹੇ ਸੁ ਬੀਰ ॥",
      "transliteration": "raghuraaj aadh mohe su beer ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਕਰਕੇ) ਰਾਮ ਚੰਦਰ ਆਦਿ ਸੂਰਮੇ ਮੋਹੇ ਗਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "रघुराज आदि मोहे सु बीर ॥",
      "sourceLineId": "85670",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦਲ ਸਹਿਤ ਭੂਮ ਡਿੱਗੇ ਅਧੀਰ ॥੪੭੪॥",
      "transliteration": "dhal sahit bhoom ddi'ge adheer ||474||",
      "translation": "Even Ram, the king of Raghu clan was beguiled and fell on the earth alongwith his army.474.",
      "punjabiViakhya": "ਅਤੇ ਸੈਨਾ ਸਮੇਤ ਬੇਸੁੱਧ ਹੋ ਕੇ ਧਰਤੀ ਉੱਤੇ ਡਿੱਗ ਪਏ ਹਨ ॥੪੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "दल सहित भूम डिग्गे अधीर ॥४७४॥",
      "sourceLineId": "85671",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਬ ਕਹੀ ਦੂਤ ਰਾਵਣਹਿ ਜਾਇ ॥",
      "transliteration": "tab kahee dhoot raavaneh jai ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਦੂਤ ਨੇ ਜਾ ਕੇ ਰਾਵਣ ਨੂੰ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "तब कही दूत रावणहि जाइ ॥",
      "sourceLineId": "85672",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਪਿ ਕਟਕ ਆਜੁ ਜੀਤਯੋ ਬਨਾਇ ॥",
      "transliteration": "kap kaTak aaj jeetayo banai ||",
      "translation": "Then the messengers went to give the news to Ravana that the forces of monkeys have been defeated",
      "punjabiViakhya": "ਕਿ ਬੰਦਰਾ ਦੀ ਸੈਨਾ ਅੱਜ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਜਿੱਤੀ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "कपि कटक आजु जीतयो बनाइ ॥",
      "sourceLineId": "85673",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੀਅ ਭਜਹੁ ਆਜੁ ਹੁਐ ਕੈ ਨਿਚੀਤ ॥",
      "transliteration": "seea bhajahu aaj huaai kai nicheet ||",
      "translation": "",
      "punjabiViakhya": "ਬੇਫ਼ਿਕਰ ਹੋ ਕੇ ਅੱਜ ਸੀਤਾ ਨਾਲ ਮੌਜ ਕਰੋ (ਕਿਉਾਂਕਿ)",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "सीअ भजहु आजु हुऐ कै निचीत ॥",
      "sourceLineId": "85674",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੰਘਰੇ ਰਾਮ ਰਣ ਇੰਦ੍ਰਜੀਤ ॥੪੭੫॥",
      "transliteration": "sa(n)ghare raam ran i(n)dhrajeet ||475||",
      "translation": "And he could certainly wed Sita on that day because Inderjit has killed ram in the war.475.",
      "punjabiViakhya": "ਰਾਮ ਚੰਦਰ ਰਣ-ਭੂਮੀ ਵਿੱਚ (ਮੇਘ ਨਾਦ ਨਾਲ) ਲੜ ਮੋਏ ਹਨ ॥੪੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "संघरे राम रण इंद्रजीत ॥४७५॥",
      "sourceLineId": "85675",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਬ ਕਹੇ ਬੈਣ ਤ੍ਰਿਜਟੀ ਬੁਲਾਇ ॥",
      "transliteration": "tab kahe bain tirajaTee bulai ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ (ਰਾਵਣ ਨੇ) ਤ੍ਰਿਜਟਾ (ਰਾਖਸ਼ੀ) ਨੂੰ ਬੁਲਾ ਕੇ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "तब कहे बैण तृजटी बुलाइ ॥",
      "sourceLineId": "85676",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰਣ ਮ੍ਰਿਤਕ ਰਾਮ ਸੀਤਹਿ ਦਿਖਾਇ ॥",
      "transliteration": "ran mritak raam seeteh dhikhai ||",
      "translation": "Then Ravana called the demoness named Trajata and asked her to show the dead Ram to Sita",
      "punjabiViakhya": "ਕਿ ਸੀਤਾ ਨੂੰ ਰਣ-ਭੂਮੀ ਵਿੱਚ ਮੋਏ ਹੋਏ ਰਾਮ ਨੂੰ ਵਿਖਾ ਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "रण मृतक राम सीतहि दिखाइ ॥",
      "sourceLineId": "85677",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਲੈ ਗਈ ਨਾਥ ਜਹਿ ਗਿਰੇ ਖੇਤ ॥",
      "transliteration": "lai giee naath jeh gire khet ||",
      "translation": "",
      "punjabiViakhya": "(ਤ੍ਰਿਜਟਾ ਸੀਤਾ ਨੂੰ ਉਥੇ) ਲੈ ਕੇ ਗਈ ਜਿੱਥੇ (ਉਸ ਦੇ) ਸੁਆਮੀ ਰਾਮ ਚੰਦਰ ਡਿੱਗੇ ਪਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "लै गई नाथ जहि गिरे खेत ॥",
      "sourceLineId": "85678",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮ੍ਰਿਗ ਮਾਰ ਸਿੰਘ ਜਯੋ ਸੁਪਤ ਅਚੇਤ ॥੪੭੬॥",
      "transliteration": "mirag maar si(n)gh jayo supat achet ||476||",
      "translation": "She rook away Sita from that place with her tantric power to the place where ram was sleeping in unconscious state like a lion after killing the deer.476.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਹਿਰਨਾ ਨੂੰ ਮਾਰ ਕੇ ਸ਼ੇਰ ਬੇਫ਼ਿਕਰ ਹੋ ਕੇ ਸੁੱਤਾ ਪਿਆ ਹੈ ॥੪੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "मृग मार सिंघ जयो सुपत अचेत ॥४७६॥",
      "sourceLineId": "85679",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੀਅ ਨਿਰਖ ਨਾਥ ਮਨ ਮਹਿ ਰਿਸਾਨ ॥",
      "transliteration": "seea nirakh naath man meh risaan ||",
      "translation": "",
      "punjabiViakhya": "ਸੀਤਾ ਨੇ (ਆਪਣੇ) ਸੁਆਮੀ ਦੀ (ਅਜਿਹੀ ਹਾਲਤ ਵੇਖ ਕੇ) ਮਨ ਵਿੱਚ ਕ੍ਰੋਧ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "सीअ निरख नाथ मन महि रिसान ॥",
      "sourceLineId": "85680",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦਸ ਅਉਰ ਚਾਰ ਬਿੱਦਿਆ ਨਿਧਾਨ ॥",
      "transliteration": "dhas aaur chaar bi'dhiaa nidhaan ||",
      "translation": "Seeing Ram in such a state, the mind of Sita was filled with extreme agony because Ram was the store-house of fourteen arts and it was impossible to make her believe in such an event",
      "punjabiViakhya": "ਚੌਦਾ ਵਿਦਿਆਵਾ ਦੀ ਖ਼ਜ਼ਾਨਾ ਰੂਪ (ਸੀਤਾ ਨੇ)",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "दस अउर चार बिद्दिआ निधान ॥",
      "sourceLineId": "85681",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪੜ ਨਾਗ ਮੰਤ੍ਰ ਸੰਘਰੀ ਪਾਸ ॥",
      "transliteration": "paR naag ma(n)tr sa(n)gharee paas ||",
      "translation": "",
      "punjabiViakhya": "ਨਾਗ ਮੰਤ੍ਰ ਪੜ੍ਰਹ ਕੇ ਫਾਹੀ ਕੱਟ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "पड़ नाग मंत्र संघरी पास ॥",
      "sourceLineId": "85682",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪਤਿ ਭ੍ਰਾਤ ਜਯਾਇ ਚਿਤ ਭਯੋ ਹੁਲਾਸ ॥੪੭੭॥",
      "transliteration": "pat bhraat jayai chit bhayo hulaas ||477||",
      "translation": "Sita went near Ram reciting Nagmantra and reviving both Ram and Lakshman her mind was filled with joy.477.",
      "punjabiViakhya": "ਅਤੇ ਪਤੀ ਨੂੰ ਭਰਾ ਸਮੇਤ ਜਿਵਾ ਕੇ ਚਿੱਤ ਵਿੱਚ ਪ੍ਰੰਸਨ ਹੋਈ ॥੪੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "पति भ्रात जयाइ चित भयो हुलास ॥४७७॥",
      "sourceLineId": "85683",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੀਅ ਗਈ ਜਗੇ ਅੰਗਰਾਇ ਰਾਮ ॥",
      "transliteration": "seea giee jage a(n)garai raam ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦੋਂ) ਸੀਤਾ (ਰਣ-ਭੂਮੀ) ਵਿਚੋਂ ਗਈ (ਤਦੋਂ) ਰਾਮ ਨੇ ਜਾਗ ਕੇ ਅੰਗੜਾਈ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "सीअ गई जगे अंगराइ राम ॥",
      "sourceLineId": "85684",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦਲ ਸਹਿਤ ਭ੍ਰਾਤ ਜੁਤ ਧਰਮ ਧਾਮ ॥",
      "transliteration": "dhal sahit bhraat jut dharam dhaam ||",
      "translation": "When Sita went back, Ram woke up alongwith his brother and forces.",
      "punjabiViakhya": "ਅਤੇ ਧਾਮ ( ਰਾਮ) ਭਰਾ (ਲੱਛਮਣ) ਅਤੇ ਸੈਨਾ ਸਮੇਤ (ਸੁਚੇਤ ਹੋ ਗਏ)।",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
      "hindiTransliteration": "दल सहित भ्रात जुत धरम धाम ॥",
      "sourceLineId": "85685",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0249_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬੱਜੇ ਸੁ ਨਾਦਿ ਗੱਜੇ ਸੁ ਬੀਰ ॥",
      "transliteration": "ba'je su naadh ga'je su beer ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਵੇਲੇ) ਧੌਂਸੇ ਵੱਜ ਪਏ ਅਤੇ ਯੋਧੇ ਗੱਜਣ ਲੱਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 249,
      "hindi": "",
