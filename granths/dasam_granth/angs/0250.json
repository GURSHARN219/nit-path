{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 250,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0250_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਥਲ ਗਯੋ ਨਕੁੰਭਲਾ ਹੋਮ ਕਰਣ ॥੪੭੯॥",
      "transliteration": "thal gayo naku(n)bhalaa hom karan ||479||",
      "translation": "At this time Inderjit Mehgnad forsook the war-arena and returned to perform the Hom Yajna (Sacrifice).479.",
      "punjabiViakhya": "ਨਿਕੁੰਭਲਾ (ਦੇਵੀ ਦੇ) ਸਥਾਨ ਵਿੱਚ ਹੋਮ ਕਰਨ ਲਈ ਚਲਾ ਗਿਆ ॥੪੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "थल गयो नकुँभला होम करण ॥४७९॥",
      "sourceLineId": "85691",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਲਘ ਬੀਰ ਤੀਰ ਲੰਕੇਸ ਆਨ ॥",
      "transliteration": "lagh beer teer la(n)kes aan ||",
      "translation": "",
      "punjabiViakhya": "ਲੱਛਮਣ ਕੋਲ ਆ ਕੇ ਵਿਭੀਸ਼ਣ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "लघ बीर तीर लंकेस आन ॥",
      "sourceLineId": "85692",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਇਮ ਕਹੈ ਬੈਣ ਤਜ ਭ੍ਰਾਤ ਕਾਨ ॥",
      "transliteration": "eim kahai bain taj bhraat kaan ||",
      "translation": "Coming near the younger brother Vibhishan said that,",
      "punjabiViakhya": "(ਆਪਣੇ) ਭਰਾ (ਰਾਵਣ ਦੀ) ਪ੍ਰਵਾਹ ਛੱਡ ਕੇ (ਲੱਛਮਣ ਨੂੰ ਸਮਾਝਾਇਆ ਕਿ ਇਸ ਦਾਓ) ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "इम कहै बैण तज भ्रात कान ॥",
      "sourceLineId": "85693",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਆਇ ਹੈ ਸੱਤ੍ਰੁ ਇਹ ਘਾਤ ਹਾਥ ॥",
      "transliteration": "aai hai sa'tr ieh ghaat haath ||",
      "translation": "",
      "punjabiViakhya": "ਵੈਰੀ (ਮੇਘਨਾਦ) ਹੱਥ ਆ ਸਕਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "आइ है सत्त्रु इह घात हाथ ॥",
      "sourceLineId": "85694",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਇੰਦ੍ਰਾਰ ਬੀਰ ਅਰਬਰ ਪ੍ਰਮਾਥ ॥੪੮੦॥",
      "transliteration": "ei(n)dhraar beer arabar pramaath ||480||",
      "translation": "At that time his supreme enemy and the mighty warrior Inderjit is wwithing your ambush.480.",
      "punjabiViakhya": "ਜੋ ਆਪਣੇ ਬਲ ਨਾਲ ਵੈਰੀਆਂ ਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਮਿਧਣ ਵਾਲਾ ਅਤੇ ਇੰਦਰ ਨੂੰ ਜਿੱਤਣ ਵਾਲਾ ਹੈ ॥੪੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "इंद्रार बीर अरबर प्रमाथ ॥४८०॥",
      "sourceLineId": "85695",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਿਜ ਮਾਸ ਕਾਟ ਕਰ ਕਰਤ ਹੋਮ ॥",
      "transliteration": "nij maas kaaT kar karat hom ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਇਸ ਵੇਲੇ) ਆਪਣੇ ਸਰੀਰ ਤੋਂ ਮਾਸ ਕੱਟ ਕੇ ਹੋਮ ਕਰ ਰਿਹਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "निज मास काट कर करत होम ॥",
      "sourceLineId": "85696",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਥਰਹਰਤ ਭੂੰਮਿ ਅਰ ਚਕਤ ਬਯੋਮ ॥",
      "transliteration": "tharaharat bhoo(n)m ar chakat bayom ||",
      "translation": "He is performing havana (sacrifice) by chopping his flesh, with which the whole earth is trembling and the sky is wondering.",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ) ਧਰਤੀ ਕੰਬ ਰਹੀ ਹੈ ਅਤੇ ਦੇਵਤੇ ('ਬ੍ਰਯੋਮ') ਹੈਰਾਨ ਹੋ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "थरहरत भूँमि अर चकत बयोम ॥",
      "sourceLineId": "85697",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਹ ਗਯੋ ਰਾਮ ਭ੍ਰਾਤਾ ਨਿਸੰਗਿ ॥",
      "transliteration": "teh gayo raam bhraataa nisa(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਸੁਣਦੇ ਹੀ ਲੱਛਮਣ ਨਿਸੰਗ ਹੀ ਚਲਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "तह गयो राम भ्राता निसंगि ॥",
      "sourceLineId": "85698",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਰ ਧਰੇ ਧਨੁਖ ਕਟ ਕਸਿ ਨਿਖੰਗ ॥੪੮੧॥",
      "transliteration": "kar dhare dhanukh kaT kas nikha(n)g ||481||",
      "translation": "Hearing this, Lakshman went there fearlessly with bow in his hand and quiver tied to his back.481.",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਹੱਥ ਵਿੱਚ ਧਨੁਸ਼ ਫੜਿਆ ਹੋਇਆ ਸੀ ਅਤੇ ਲੱਕ ਨਾਲ ਭੱਥਾ ਬੰਨ੍ਰਹਿਆ ਹੋਇਆ ਸੀ ॥੪੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "कर धरे धनुख कट कसि निखंग ॥४८१॥",
      "sourceLineId": "85699",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚਿੰਤੀ ਸੁ ਚਿਤ ਦੇਵੀ ਪ੍ਰਚੰਡ ॥",
      "transliteration": "chi(n)tee su chit dhevee pracha(n)dd ||",
      "translation": "",
      "punjabiViakhya": "(ਮੇਘਨਾਦ ਦੇ) ਚਿੱਤ ਵਿੱਚ ਦੇਵੀ ਨੂੰ ਪ੍ਰਚੰਡ ਕਰਨ ਦੀ ਚਿੰਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "चिंती सु चित देवी प्रचंड ॥",
      "sourceLineId": "85700",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਰ ਹਣਯੋ ਬਾਣ ਕੀਨੋ ਦੁਖੰਡ ॥",
      "transliteration": "ar hanayo baan keeno dhukha(n)dd ||",
      "translation": "Inderjit began to recite for the manifestation of the goddess and Lakshman discharged his arrows and killed Inderjit into two halves.",
      "punjabiViakhya": "ਲੱਛਮਣ ਨੇ ਅਜਿਹੀ ਸਥਿਤੀ ਵਿੱਚ ਤੀਰ ਮਾਰਕੇ ਵੈਰੀ ਨੂੰ ਦੋ ਟੋਟੇ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "अर हणयो बाण कीनो दुखंड ॥",
      "sourceLineId": "85701",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਿਪ ਫਿਰੇ ਮਾਰ ਦੁੰਦਭ ਬਜਾਇ ॥",
      "transliteration": "rip fire maar dhu(n)dhabh bajai ||",
      "translation": "",
      "punjabiViakhya": "ਵੈਰੀ ਨੂੰ ਮਾਰ ਕੇ (ਜਿੱਤ ਦੇ) ਧੌਂਸੇ ਵਜਾਉਾਂਦਾ (ਲੱਛਮਣ) ਪਰਤ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "रिप फिरे मार दुँदभ बजाइ ॥",
      "sourceLineId": "85702",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਉਤ ਭਜੇ ਦਈਤ ਦਲਪਤਿ ਜੁਝਾਇ ॥੪੮੨॥",
      "transliteration": "aut bhaje dhieet dhalapat jujhai ||482||",
      "translation": "Lakshman returned with his forces, playing on the drum and on the other side the demons ran away on seeing their general dead.482.",
      "punjabiViakhya": "ਉਧਰ ਆਪਣੇ ਸੈਨਾਪਤੀ (ਮੇਘਨਾਦ ਨੂੰ) ਮਰਵਾ ਕੇ ਦੈਂਤ ਦਲ (ਲੰਕਾ ਵਲ) ਭੱਜ ਗਿਆ ॥੪੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "उत भजे दईत दलपति जुझाइ ॥४८२॥",
      "sourceLineId": "85703",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਤਿ ਇੰਦ੍ਰਜੀਤ ਬਧਹਿ ਧਿਆਇ ਸਮਾਪਤਮ ਸਤੁ ॥",
      "transliteration": "eit i(n)dhrajeet badheh dhiaai samaapatam sat ||",
      "translation": "End of the chapter entitled “The Killing of Inderjit’ in Ramavtar in BACHITTAR NATAK.",
      "punjabiViakhya": "ਇਥੇ ਇੰਦ੍ਰਜੀਤ ਬਧਹਿ ਅਧਿਆਇ ਦੀ ਸਮਾਪਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "इति इंद्रजीत बधहि धिआइ समापतम सतु ॥",
      "sourceLineId": "85704",
      "sourceShabadId": "7999",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਥ ਅਤਕਾਇ ਦਈਤ ਜੁੱਧ ਕਥਨੰ ॥",
      "transliteration": "ath atakai dhieet ju'dh kathana(n) ||",
      "translation": "Now begins the description of the war with the demon Atkaaye :",
      "punjabiViakhya": "ਹੁਣ ਅਤਕਾਇ ਦੈਂਤ ਦੇ ਯੁੱਧ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "अथ अतकाइ दईत जुद्ध कथनं ॥",
      "sourceLineId": "85705",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੰਗੀਤ ਪਧਿਸਟਕਾ ਛੰਦ ॥",
      "transliteration": "sa(n)geet padhisaTakaa chha(n)dh ||",
      "translation": "SANGEET PADHISTAKA STANZA",
      "punjabiViakhya": "ਸੰਗੀਤ ਪਧਿਸਟਕਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "संगीत पधिसटका छंद ॥",
      "sourceLineId": "85706",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਾਗੜਦੰਗ ਕੋਪ ਕੈ ਦਈਤ ਰਾਜ ॥",
      "transliteration": "kaagaRadha(n)g kop kai dhieet raaj ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਵਣ ਨੇ ਕ੍ਰੋਧ ਕਰਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "कागड़दंग कोप कै दईत राज ॥",
      "sourceLineId": "85707",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਾਗੜਦੰਗ ਜੁੱਧ ਕੋ ਸਜਯੋ ਸਾਜ ॥",
      "transliteration": "jaagaRadha(n)g ju'dh ko sajayo saaj ||",
      "translation": "The demon-king in great fury, began the war,",
      "punjabiViakhya": "ਯੁੱਧ ਦਾ ਸਾਜ ਸਾਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "जागड़दंग जुद्ध को सजयो साज ॥",
      "sourceLineId": "85708",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਾਗੜਦੰਗ ਬੀਰ ਬੁੱਲੇ ਅਨੰਤ ॥",
      "transliteration": "baagaRadha(n)g beer bu'le ana(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੰਤ ਯੁੱਧ ਵੀਰ ਬੁਲਾ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "बागड़दंग बीर बुल्ले अनंत ॥",
      "sourceLineId": "85709",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਾਗੜਦੰਗ ਰੋਸ ਰੋਹੇ ਦੁਰੰਤ ॥੪੮੩॥",
      "transliteration": "raagaRadha(n)g ros rohe dhura(n)t ||483||",
      "translation": "Calling his innumerable warriors, full of resentment and very wrathful.483.",
      "punjabiViakhya": "(ਜੋ) ਪ੍ਰਚੰਡ ਕ੍ਰੋਧ ਦੇ ਭਰੇ ਹੋਏ ਗੁਸੈਲ ਸਨ ॥੪੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "रागड़दंग रोस रोहे दुरंत ॥४८३॥",
      "sourceLineId": "85710",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪਾਗੜਦੰਗ ਪਰਮ ਬਾਜੀ ਬੁਲੰਤ ॥",
      "transliteration": "paagaRadha(n)g param baajee bula(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੇਸ਼ਠ ਘੋੜਿਆਂ (ਵਾਲੇ ਸੂਰਮੇ) ਬੁਲਾ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "पागड़दंग परम बाजी बुलंत ॥",
      "sourceLineId": "85711",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚਾਗੜਦੰਗ ਚੱਤ੍ਰ ਨਟ ਜਯੋਂ ਕੁਦੰਤ ॥",
      "transliteration": "chaagaRadha(n)g cha'tr naT jayo(n) kudha(n)t ||",
      "translation": "Very swift-moving horses were brought who jumped hither and thither like and actor",
      "punjabiViakhya": "(ਉਹ ਘੋੜੇ) ਚਤੁਰ ਨਟ ਵਾਗ ਕੁੱਦਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": "चागड़दंग चत्त्र नट जयों कुदंत ॥",
      "sourceLineId": "85712",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0250_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਾਗੜਦੰਗ ਕ੍ਰੂਰ ਕੱਢੇ ਹਥਿਆਰ ॥",
      "transliteration": "kaagaRadha(n)g kraoor ka'dde hathiaar ||",
      "translation": "",
      "punjabiViakhya": "ਭਿਆਨਕ ਹਥਿਆਰ ਕੱਢੇ ਹੋਏ ਸਨ",
      "source": "DASAM_GRANTH",
