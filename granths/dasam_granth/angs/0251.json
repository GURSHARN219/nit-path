      "punjabiViakhya": "ਪਰ ਮੁੜੇ ਨਹੀਂ।",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "नवे मुरे ॥",
      "sourceLineId": "85741",
      "sourceShabadId": "8001",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
