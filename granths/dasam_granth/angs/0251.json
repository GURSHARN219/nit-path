      "punjabiViakhya": "ਘੇਰਨੀ ਖਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "भरे भयं ॥",
      "sourceLineId": "85753",
      "sourceShabadId": "8001",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0040",
