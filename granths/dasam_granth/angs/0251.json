      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "रिसं जरं ॥",
      "sourceLineId": "85757",
      "sourceShabadId": "8001",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰੁਪੈ ਰਣੰ ॥",
      "transliteration": "rupai rana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜ਼ਖ਼ਮੀ ਸੂਰਮੇ ਘੁੰਮਦੇ ਫਿਰਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "रुपै रणं ॥",
      "sourceLineId": "85758",
      "sourceShabadId": "8001",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਘੁਮੇ ਬ੍ਰਣੰ ॥੪੯੫॥",
      "transliteration": "ghume brana(n) ||495||",
      "translation": "They are reciting the name of Shiva in order to kill the enemies with jealousy in their mind and they are tighting in the field wandering with fear.495.",
      "punjabiViakhya": "ਯੁੱਧ ਵਿੱਚ ਜੁੱਟੇ ਹੋਏ ਹਨ ॥੪੯੫॥",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "घुमे ब्रणं ॥४९५॥",
      "sourceLineId": "85759",
      "sourceShabadId": "8001",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗਿਰੈਂ ਧਰੰ ॥",
      "transliteration": "girai(n) dhara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਧਰਤੀ ਤੇ ਡਿੱਗਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "गिरैं धरं ॥",
      "sourceLineId": "85760",
      "sourceShabadId": "8001",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
