      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਮੰ ਅਟੰ ॥੪੯੩॥",
      "transliteration": "jima(n) aTa(n) ||493||",
      "translation": "The arrows are being discharged in fury and the warriors are falling on the earth like the earth like the effacement of the through ones.493.",
      "punjabiViakhya": "ਯੋਧੇ ਡਿੱਗਦੇ ਹਨ ॥੪੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "जिमं अटं ॥४९३॥",
      "sourceLineId": "85751",
      "sourceShabadId": "8001",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
