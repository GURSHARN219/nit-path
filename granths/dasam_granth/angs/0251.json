      "gurmukhi": "ਸਰੰ ਤਛੇ ॥",
      "transliteration": "sara(n) tachhe ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰਾ ਨਾਲ ਪੱਛੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "सरं तछे ॥",
      "sourceLineId": "85762",
      "sourceShabadId": "8001",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
