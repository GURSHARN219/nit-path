{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 251,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0251_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਗੜਦੰਗ ਰਾਮ ਸੈਨਾ ਸੁ ਕ੍ਰੁੱਧ ॥",
      "transliteration": "raagaRadha(n)g raam sainaa su kru'dh ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਦੀ ਸੈਨਾ ਦੇ ਕ੍ਰੋਧਵਾਨ ਸੂਰਮੇ",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "रागड़दंग राम सैना सु क्रुद्ध ॥",
      "sourceLineId": "85715",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਾਗੜਦੰਗ ਜ੍ਵਾਨ ਜੁਝੰਤ ਜੁੱਧ ॥",
      "transliteration": "jaagaRadha(n)g javaiaan jujha(n)t ju'dh ||",
      "translation": "On this side, the warriors in the army of Ram, started fighting in great rage",
      "punjabiViakhya": "ਯੁੱਧ ਵਿੱਚ ਜੂਝਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "जागड़दंग ज्वान जुझंत जुद्ध ॥",
      "sourceLineId": "85716",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਾਗੜਦੰਗ ਨਿਸਾਣ ਨਵ ਸੈਨ ਸਾਜ ॥",
      "transliteration": "naagaRadha(n)g nisaan nav sain saaj ||",
      "translation": "",
      "punjabiViakhya": "ਸੈਨਾ ਨੇ ਨਵੇਾਂ ਧੌਂਸੇ ਵਜਾ ਕੇ 'ਮਕਰਾਛ' (ਨਾ ਦੇ)",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "नागड़दंग निसाण नव सैन साज ॥",
      "sourceLineId": "85717",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਾਗੜਦੰਗ ਮੂੜ ਮਕਰਾਛ ਗਾਜ ॥੪੮੫॥",
      "transliteration": "maagaRadha(n)g mooR makaraachh gaaj ||485||",
      "translation": "The foolish Makrachh thundered, carrying his new banner.485.",
      "punjabiViakhya": "ਮੂਰਖ ਰਣ-ਭੂਮੀ ਵਿੱਚ ਗੱਜਣ ਲੱਗਾ ॥੪੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "मागड़दंग मूड़ मकराछ गाज ॥४८५॥",
      "sourceLineId": "85718",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਆਗੜਦੰਗ ਏਕ ਅਤਕਾਇ ਵੀਰ ॥",
      "transliteration": "aagaRadha(n)g ek atakai veer ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਅਤਕਾਇ' (ਨਾਮ ਦੇ) ਸੂਰਮੇ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "आगड़दंग एक अतकाइ वीर ॥",
      "sourceLineId": "85719",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਾਗੜਦੰਗ ਰੋਸ ਕੀਨੇ ਗਹੀਰ ॥",
      "transliteration": "raagaRadha(n)g ros keene gaheer ||",
      "translation": "There was one demon named Atkaaye in the demon forces who rushed with serious fury",
      "punjabiViakhya": "ਗੰਭੀਰ ਰੂਪ ਵਿੱਚ ਗੁੱਸਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "रागड़दंग रोस कीने गहीर ॥",
      "sourceLineId": "85720",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਆਗੜਦੰਗ ਏਕ ਹੁੱਕੇ ਅਨੇਕ ॥",
      "transliteration": "aagaRadha(n)g ek hu'ke anek ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਕ ਨਾਲ ਅਨੇਕਾ (ਸੂਰਵੀਰ) ਲਲਕਾਰੇ।",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "आगड़दंग एक हुक्के अनेक ॥",
      "sourceLineId": "85721",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਾਗੜਦੰਗ ਸਿੰਧ ਬੇਲਾ ਬਿਬੇਕ ॥੪੮੬॥",
      "transliteration": "saagaRadha(n)g si(n)dh belaa bibek ||486||",
      "translation": "Many warriors confronted him and began to fight with discriminating intellect.486.",
      "punjabiViakhya": "(ਰਣ-ਭੂਮੀ) ਸਮੁੰਦਰ ਦੇ ਕੰਢੇ ਤੇ ਵਿਸਥਾਪਿਤ ਹੈ ॥੪੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "सागड़दंग सिंध बेला बिबेक ॥४८६॥",
      "sourceLineId": "85722",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਾਗੜਦੰਗ ਤੀਰ ਛੁਟੈ ਅਪਾਰ ॥",
      "transliteration": "taagaRadha(n)g teer chhuTai apaar ||",
      "translation": "",
      "punjabiViakhya": "ਅਪਾਰ ਤੀਰ ਛੁੱਟਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "तागड़दंग तीर छुटै अपार ॥",
      "sourceLineId": "85723",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਾਗੜਦੰਗ ਬੂੰਦ ਬਨ ਦਲ ਅਨੁਚਾਰ ॥",
      "transliteration": "baagaRadha(n)g boo(n)dh ban dhal anuchaar ||",
      "translation": "There was huge shower of arrows which fell like rain-drops",
      "punjabiViakhya": "ਜੋ ਬੂੰਦਾ ਜਾ ਬਣ ਦੇ ਪੱਤਿਆਂ ਅਨੁਸਾਰ (ਸਮਝਣੇ ਚਾਹੀਦੇ ਹਨ),",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "बागड़दंग बूँद बन दल अनुचार ॥",
      "sourceLineId": "85724",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਆਗੜਦੰਗ ਅਰਬ ਟੀਡੀ ਪ੍ਰਮਾਨ ॥",
      "transliteration": "aagaRadha(n)g arab Teeddee pramaan ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਨਾ ਰਥਾ ਦੇ (ਪੈਦਲ ਸੈਨਾ) ਟਿੱਡੀਦਲ ਜਿਹੀ",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "आगड़दंग अरब टीडी प्रमान ॥",
      "sourceLineId": "85725",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਚਾਗੜਦੰਗ ਚਾਰ ਚੀਟੀ ਸਮਾਨ ॥੪੮੭॥",
      "transliteration": "chaagaRadha(n)g chaar cheeTee samaan ||487||",
      "translation": "The army looked like locusts and array of ants.487.",
      "punjabiViakhya": "ਜਾ ਕੀੜੀਆਂ ਦੇ ਦਲ ਵਰਗੀ ਸਮਝਣੀ ਚਾਹੀਦੀ ਹੈ ॥੪੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "चागड़दंग चार चीटी समान ॥४८७॥",
      "sourceLineId": "85726",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਾਗੜਦੰਗ ਬੀਰ ਬਾਹੁੜੇ ਨੇਖ ॥",
      "transliteration": "baagaRadha(n)g beer baahuRe nekh ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੇਕ ਸੂਰਮੇ ਨੇੜੇ ਪਹੁੰਚ ਗਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "बागड़दंग बीर बाहुड़े नेख ॥",
      "sourceLineId": "85727",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਾਗੜਦੰਗ ਜੁੱਧ ਅਤਕਾਇ ਦੇਖ ॥",
      "transliteration": "jaagaRadha(n)g ju'dh atakai dhekh ||",
      "translation": "The warriors reached near Atkaaye in order to see him fighting.",
      "punjabiViakhya": "ਅਤੇ 'ਅਤਕਾਇ' ਦਾ ਯੁੱਧ ਵੇਖ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "जागड़दंग जुद्ध अतकाइ देख ॥",
      "sourceLineId": "85728",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦਾਗੜਦੰਗ ਦੇਵ ਜੈ ਜੈ ਕਹੰਤ ॥",
      "transliteration": "dhaagaRadha(n)g dhev jai jai kaha(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤੇ ਜੈ ਜੈ ਕਾਰ ਕਰ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "दागड़दंग देव जै जै कहंत ॥",
      "sourceLineId": "85729",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭਾਗੜਦੰਗ ਭੂਪ ਧਨ ਧਨ ਭਨੰਤ ॥੪੮੮॥",
      "transliteration": "bhaagaRadha(n)g bhoop dhan dhan bhana(n)t ||488||",
      "translation": "The gods hailed him and the king uttered “Bravo, Bravo!”.488.",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਧੰਨ-ਧੰਨ ਕਹਿੰਦੇ ਸਨ ॥੪੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "भागड़दंग भूप धन धन भनंत ॥४८८॥",
      "sourceLineId": "85730",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਾਗੜਦੰਗ ਕਹਕ ਕਾਲੀ ਕਰਾਲ ॥",
      "transliteration": "kaagaRadha(n)g kahak kaalee karaal ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲੀ ਪ੍ਰਚੰਡ ਠਹਾਕਾ ਮਾਰਕੇ ਹੱਸ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "कागड़दंग कहक काली कराल ॥",
      "sourceLineId": "85731",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਾਗੜਦੰਗ ਜੂਹ ਜੁੱਗਣ ਬਿਸਾਲ ॥",
      "transliteration": "jaagaRadha(n)g jooh ju'gan bisaal ||",
      "translation": "The terrible goddess Kali began to shout and great number of Yoginis roamed in the battlefield.",
      "punjabiViakhya": "ਜੋਗਣਾ ਦੇ ਵਿਸ਼ਾਲ ਟੋਲੇ",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "जागड़दंग जूह जुग्गण बिसाल ॥",
      "sourceLineId": "85732",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭਾਗੜਦੰਗ ਭੂਤ ਭੈਰੋ ਅਨੰਤ ॥",
      "transliteration": "bhaagaRadha(n)g bhoot bhairo ana(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਨੰਤ ਭੈਰੋ ਤੇ ਭੂਤ",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "भागड़दंग भूत भैरो अनंत ॥",
      "sourceLineId": "85733",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਾਗੜਦੰਗ ਸ੍ਰੋਣ ਪਾਣੰ ਕਰੰਤ ॥੪੮੯॥",
      "transliteration": "saagaRadha(n)g sron paana(n) kara(n)t ||489||",
      "translation": "Innumerable Bhairvas and ghosts began to drink blood.489.",
      "punjabiViakhya": "ਲਹੂ ਪੀ ਰਹੇ ਸਨ ॥੪੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "सागड़दंग स्रोण पाणं करंत ॥४८९॥",
      "sourceLineId": "85734",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਡਾਗੜਦੰਗ ਡਉਰ ਡਾਕਣ ਡਹੱਕ ॥",
      "transliteration": "ddaagaRadha(n)g ddaur ddaakan ddaha'k ||",
      "translation": "",
      "punjabiViakhya": "ਡਾਕਣੀਆਂ ਡਗ-ਡਗ ਡੌਰੂ ਵਜਾਉਾਂਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "डागड़दंग डउर डाकण डहक्क ॥",
      "sourceLineId": "85735",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਾਗੜਦੰਗ ਕ੍ਰੂਰ ਕਾਕੰ ਕਹੱਕ ॥",
      "transliteration": "kaagaRadha(n)g kraoor kaaka(n) kaha'k ||",
      "translation": "The tabors of vampires sounded and the inauspicious crows began to caw",
      "punjabiViakhya": "ਭਿਆਨਕ ਕਾ ਕੂਕਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "कागड़दंग क्रूर काकं कहक्क ॥",
      "sourceLineId": "85736",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚਾਗੜਦੰਗ ਚਤ੍ਰ ਚਾਵਡੀ ਚਿਕਾਰ ॥",
      "transliteration": "chaagaRadha(n)g chatr chaavaddee chikaar ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ ਪਾਸੇ ਚੁੜੇਲਾ ਚੀਖਦੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "चागड़दंग चत्र चावडी चिकार ॥",
      "sourceLineId": "85737",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭਾਗੜਦੰਗ ਭੂਤ ਡਾਰਤ ਧਮਾਰ ॥੪੯੦॥",
      "transliteration": "bhaagaRadha(n)g bhoot ddaarat dhamaar ||490||",
      "translation": "On all the four sides there were heard and seen shrieks of vultures and leapings and hopping of ghosts and fiends.490.",
      "punjabiViakhya": "ਅਤੇ ਭੂਤ ਧਮਾਰ ਪਾ ਰਹੇ ਸਨ ॥੪੯੦॥",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "भागड़दंग भूत डारत धमार ॥४९०॥",
      "sourceLineId": "85738",
      "sourceShabadId": "8000",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹੋਹਾ ਛੰਦ ॥",
      "transliteration": "hohaa chha(n)dh ||",
      "translation": "HOHA STANZA",
      "punjabiViakhya": "ਹੋਹਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "होहा छंद ॥",
      "sourceLineId": "85739",
