      "transliteration": "chape kisa(n) ||492||",
      "translation": "Seeing the discharge of arrows the clouds wondered  because of the arrows all the sides were hindered.492.",
      "punjabiViakhya": "ਬੰਦਰ ਖਿੱਝ ਗਏ ਹਨ ॥੪੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "चपे किसं ॥४९२॥",
      "sourceLineId": "85747",
      "sourceShabadId": "8001",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
