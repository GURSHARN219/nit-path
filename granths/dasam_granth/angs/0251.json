      "translation": "",
      "punjabiViakhya": "ਤੀਰ ਚਲਾਉਾਂਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "रिसं भरं ॥",
      "sourceLineId": "85749",
      "sourceShabadId": "8001",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
