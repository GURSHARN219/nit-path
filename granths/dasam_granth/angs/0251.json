      "transliteration": "hulai(n) nara(n) ||",
      "translation": "The people are getting delighted with the falling of demons on the earth",
      "punjabiViakhya": "ਸੈਨਿਕਾ ਨੂੰ ਧੱਕੇ ਵੱਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 251,
      "hindi": "",
      "hindiTransliteration": "हुलैं नरं ॥",
      "sourceLineId": "85761",
      "sourceShabadId": "8001",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0251_line_0048",
