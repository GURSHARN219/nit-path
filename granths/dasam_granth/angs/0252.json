{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 252,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0252_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਛੰ ਕਛੇ ॥੪੯੬॥",
      "transliteration": "kachha(n) kachhe ||496||",
      "translation": "The arrows are penetrating into the demons and the warriors are being crushed.496.",
      "punjabiViakhya": "ਕਾਤਰਾ (ਟੁਕੜੇ) ਲਾਹੁੰਦੇ ਹਨ ॥੪੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "कछं कछे ॥४९६॥",
      "sourceLineId": "85763",
      "sourceShabadId": "8001",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਘੁਮੇ ਬ੍ਰਣੰ ॥",
      "transliteration": "ghume brana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਘਾਇਲ ਘੁਮੇਰੀ ਖਾਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "घुमे ब्रणं ॥",
      "sourceLineId": "85764",
      "sourceShabadId": "8001",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭ੍ਰਮੇ ਰਣੰ ॥",
      "transliteration": "bhrame rana(n) ||",
      "translation": "The wounded warriors are wandering and writhing in the battlefield",
      "punjabiViakhya": "ਅਤੇ ਰਣ-ਭੂਮੀ ਵਿੱਚ ਫਿਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "भ्रमे रणं ॥",
      "sourceLineId": "85765",
      "sourceShabadId": "8001",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਲਜੰ ਫਸੇ ॥",
      "transliteration": "laja(n) fase ||",
      "translation": "",
      "punjabiViakhya": "ਲਾਜ ਦੇ ਮਾਰੇ ਹੋਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "लजं फसे ॥",
      "sourceLineId": "85766",
      "sourceShabadId": "8001",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਟੰ ਕਸੇ ॥੪੯੭॥",
      "transliteration": "kaTa(n) kase ||497||",
      "translation": "They are feeling shy in being entrapped, having been girdled.497.",
      "punjabiViakhya": "ਅਤੇ ਕਮਰਕਸੇ ਕੀਤੀ ਫਿਰਦੇ ਹਨ ॥੪੯੭॥",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "कटं कसे ॥४९७॥",
      "sourceLineId": "85767",
      "sourceShabadId": "8001",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਧੁਕੇ ਧਕੰ ॥",
      "transliteration": "dhuke dhaka(n) ||",
      "translation": "",
      "punjabiViakhya": "ਧੱਕੇ ਤੇ ਧੱਕਾ ਪੈਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "धुके धकं ॥",
      "sourceLineId": "85768",
      "sourceShabadId": "8001",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਟੁਕੇ ਟਕੰ ॥",
      "transliteration": "Tuke Taka(n) ||",
      "translation": "",
      "punjabiViakhya": "ਟੱਕਾ ਨਾਲ ਟੁੱਕੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "टुके टकं ॥",
      "sourceLineId": "85769",
      "sourceShabadId": "8001",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਛੁਟੇ ਸਰੰ ॥",
      "transliteration": "chhuTe sara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ ਚਲਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "छुटे सरं ॥",
      "sourceLineId": "85770",
      "sourceShabadId": "8001",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰੁਕੇ ਦਿਸੰ ॥੪੯੮॥",
      "transliteration": "ruke dhisa(n) ||498||",
      "translation": "The throbbing of the hearts continues, the arrows are being discharged intermittently and the directions are being hindered.498.",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨਾਲ) ਦਿਸ਼ਾਵਾ ਰੁਕ ਗਈਆਂ ਹਨ ॥੪੯੮॥",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "रुके दिसं ॥४९८॥",
      "sourceLineId": "85771",
      "sourceShabadId": "8001",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਛਪੈ ਛੰਦ ॥",
      "transliteration": "chhapai chha(n)dh ||",
      "translation": "CHHAPAI STANZA",
      "punjabiViakhya": "ਛਪੈ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "छपै छंद ॥",
      "sourceLineId": "85772",
      "sourceShabadId": "8002",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇੱਕ ਇੱਕ ਆਰੁਹੇ ਇੱਕ ਇੱਕਨ ਕਹੱ ਤੱਕੈ ॥",
      "transliteration": "ei'k i'k aaruhe i'k i'kan kaha' ta'kai ||",
      "translation": "The warriors excelling one another are coming and looking at each other one by one",
      "punjabiViakhya": "ਇਕ (ਸੂਰਮਾ) ਇਕ ਨਾਲ ਜੁਟਿਆ ਹੈ, ਇਕ ਇਕਨਾ ਵਲ ਤੱਕ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "इक्क इक्क आरुहे इक्क इक्कन कह ् तक्कै ॥",
      "sourceLineId": "85773",
      "sourceShabadId": "8002",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਇੱਕ ਇੱਕ ਲੈ ਚਲੈ ਇੱਕ ਕਹ ਇੱਕ ਉਚੱਕੈ ॥",
      "transliteration": "ei'k i'k lai chalai i'k keh i'k ucha'kai ||",
      "translation": "They are moving with each one and are being startle by each one",
      "punjabiViakhya": "ਇਕ ਯੋਧਾ ਇਕ ਨੂੰ ਲੈ ਚਲਿਆ ਹੈ ਅਤੇ ਇਕ ਨੂੰ ਇਕ ਚੁੱਕ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "इक्क इक्क लै चलै इक्क कह इक्क उचक्कै ॥",
      "sourceLineId": "85774",
      "sourceShabadId": "8002",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਇੱਕ ਇੱਕ ਸਰ ਬਰਖ ਇੱਕ ਧਨ ਕਰਖ ਰੋਸ ਭਰ ॥",
      "transliteration": "ei'k i'k sar barakh i'k dhan karakh ros bhar ||",
      "translation": "On one side they are discharging arrows and on the other they are pulling their bows in rage",
      "punjabiViakhya": "ਇਕ-ਇਕ ਉੱਤੇ ਤੀਰਾ ਦੀ ਬਰਖਾ ਕਰ ਰਿਹਾ ਹੈ ਅਤੇ ਇਕ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਧਨੁਸ਼ ਖਿੱਚ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "इक्क इक्क सर बरख इक्क धन करख रोस भर ॥",
      "sourceLineId": "85775",
      "sourceShabadId": "8002",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇੱਕ ਇੱਕ ਤਰਫੰਤ ਇੱਕ ਭਵ ਸਿੰਧ ਗਏ ਤਰਿ ॥",
      "transliteration": "ei'k i'k tarafa(n)t i'k bhav si(n)dh ge tar ||",
      "translation": "On one side the fighters are writing and on the other side the dead ones are ferrying across the world-ocean",
      "punjabiViakhya": "ਕਈ ਇਕ ਡਿੱਗੇ ਹੋਏ ਤੜਪ ਰਹੇ ਹਨ ਅਤੇ ਇਕ ਸੰਸਾਰ ਸਮੁੰਦਰ ਤੋਂ ਤਰ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "इक्क इक्क तरफंत इक्क भव सिंध गए तरि ॥",
      "sourceLineId": "85776",
      "sourceShabadId": "8002",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਣਿ ਇੱਕ ਇੱਕ ਸਾਵੰਤ ਭਿੜੈਂ ਇੱਕ ਇੱਕ ਹੁਐ ਬਿੱਝੜੇ ॥",
      "transliteration": "ran i'k i'k saava(n)t bhiRai(n) i'k i'k huaai bi'jhaRe ||",
      "translation": "The warriors excelling one another have fought and died",
      "punjabiViakhya": "ਰਣ ਵਿੱਚ ਇਕ ਸੂਰਮਾ ਇਕ ਨਾਲ ਭਿੜ ਰਿਹਾ ਹੈ ਅਤੇ ਕਈ ਇਕ ਪਛੜ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "रणि इक्क इक्क सावंत भिड़ैं इक्क इक्क हुऐ बिज्झड़े ॥",
      "sourceLineId": "85777",
      "sourceShabadId": "8002",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਰ ਇੱਕ ਅਨਿਕ ਸਸਤ੍ਰਣ ਭਿੜੇ ਇੱਕ ਇੱਕ ਅਵਝੜ ਝੜੇ ॥੪੯੯॥",
      "transliteration": "nar i'k anik sasatran bhiRe i'k i'k avajhaR jhaRe ||499||",
      "translation": "All the warriors are alike, but the weapons are many and these weapons are striking blows on the soldiers like rain.499.",
      "punjabiViakhya": "ਇਕ (ਸੂਰਮਾ) ਅਨੇਕਾ ਸ਼ਸਤ੍ਰਾ ਵਾਲਿਆਂ ਨਾਲ ਭਿੜ ਰਿਹਾ ਹੈ ਅਤੇ ਨਾ ਝੜਨ ਵਾਲਿਆਂ ਨੂੰ ਇਕੱਲਾ ਹੀ ਝਾੜ ਰਿਹਾ ਹੈ ॥੪੯੯॥",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "नर इक्क अनिक ससत्रण भिड़े इक्क इक्क अवझड़ झड़े ॥४९९॥",
      "sourceLineId": "85778",
      "sourceShabadId": "8002",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਇੱਕ ਜੂਝ ਭਟ ਗਿਰੈਂ ਇੱਕ ਬਬਕੰਤ ਮੱਧ ਰਣ ॥",
      "transliteration": "ei'k joojh bhaT girai(n) i'k babaka(n)t ma'dh ran ||",
      "translation": "On one side the warriors have fallen and on the other they are shouting",
      "punjabiViakhya": "ਇਕ ਸੂਰਮੇ ਸ਼ਹੀਦ ਹੋ ਕੇ ਡਿੱਗ ਰਹੇ ਹਨ ਅਤੇ ਇਕ ਰਣ-ਭੂਮੀ ਵਿੱਚ ਲਲਕਾਰ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "इक्क जूझ भट गिरैं इक्क बबकंत मद्ध रण ॥",
      "sourceLineId": "85779",
      "sourceShabadId": "8002",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਇੱਕ ਦੇਵਪੁਰ ਬਸੈ ਇੱਕ ਭਜ ਚਲਤ ਖਾਇ ਬ੍ਰਣ ॥",
      "transliteration": "ei'k dhevapur basai i'k bhaj chalat khai bran ||",
      "translation": "On one side they have entered the city of gods and on the other, having been wounded, they have sped away",
      "punjabiViakhya": "ਇਕ ਸੁਅਰਗਪੁਰੀ ਜਾ ਵਸੇ ਹਨ ਅਤੇ ਇਕ ਜ਼ਖ਼ਮ ਖਾ ਕੇ ਭੱਜ ਚੱਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "इक्क देवपुर बसै इक्क भज चलत खाइ ब्रण ॥",
      "sourceLineId": "85780",
      "sourceShabadId": "8002",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਇੱਕ ਜੁੱਝ ਉੱਝੜੇ ਇੱਕ ਮੁਕਤੰਤ ਬਾਨ ਕਸਿ ॥",
      "transliteration": "ei'k ju'jh u'jhaRe i'k mukata(n)t baan kas ||",
      "translation": "Some are fighting in the war firmly and on the other side they are falling down having been chopped like trees",
      "punjabiViakhya": "ਇਕ ਲੜ ਕੇ ਡਿੱਗਦੇ ਹਨ ਅਤੇ ਇਕ ਤਲਵਾਰ ਦੀ ਵਾਢ ਨਾਲ ਡਿੱਗ ਪੈਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "इक्क जुज्झ उज्झड़े इक्क मुकतंत बान कसि ॥",
      "sourceLineId": "85781",
      "sourceShabadId": "8002",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਇੱਕ ਅਨਿਕ ਬ੍ਰਣ ਝਲੈਂ ਇੱਕ ਮੁਕਤੰਤ ਬਾਨ ਕਸਿ ॥",
      "transliteration": "ei'k anik bran jhalai(n) i'k mukata(n)t baan kas ||",
      "translation": "On one side many wounded are being endured and on the other the arrows are being discharged with full strength",
      "punjabiViakhya": "ਇਕ (ਆਪਣੇ ਸਰੀਰ ਉੱਤੇ) ਅਨੇਕਾ ਜ਼ਖ਼ਮ ਸਹਾਰਦੇ ਹਨ ਅਤੇ ਇਕ ਕੱਸ-ਕੱਸ ਕੇ ਤੀਰ ਛੱਡਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "इक्क अनिक ब्रण झलैं इक्क मुकतंत बान कसि ॥",
      "sourceLineId": "85782",
      "sourceShabadId": "8002",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰਣ ਭੂੰਮ ਘੂਮ ਸਾਵੰਤ ਮੰਡੈ ਦੀਰਘੁ ਕਾਇ ਲਛਮਣ ਪ੍ਰਬਲ ॥",
      "transliteration": "ran bhoo(n)m ghoom saava(n)t ma(n)ddai dheeragh kai lachhaman prabal ||",
      "translation": "Diraghkaya and Lakshman have wounded and created such a situation in the battlefield,",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿੱਚ ਯੋਧੇ ਫਿਰਦੇ ਹਨ, 'ਦੀਰਘ-ਕਾਇ' ਦੈਂਤ ਅਤੇ 'ਲਛਮਣ' ਨੇ ਚੰਗੀ ਤਰ੍ਰਹਾ ਰਣ ਮੰਡਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "रण भूँम घूम सावंत मंडै दीरघु काइ लछमण प्रबल ॥",
      "sourceLineId": "85783",
      "sourceShabadId": "8002",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਥਿਰ ਰਹੇ ਬ੍ਰਿਛ ਉਪਵਨ ਕਿਧੋ ਉੱਤਰ ਦਿਸ ਦੁਐ ਅਚਲ ॥੫੦੦॥",
      "transliteration": "thir rahe birachh upavan kidho u'tar dhis dhuaai achal ||500||",
      "translation": "As if they are large trees in a forest or eternal and immovable pole-stars in the north.500.",
      "punjabiViakhya": "(ਦੋਵੇਾਂ ਸੂਰਮੇ ਇਉਾਂ ਖੜੋਤੇ ਹਨ ਮਾਨੋ) ਬਾਗ਼ ਵਿੱਚ ਦੋ ਬ੍ਰਿਛ ਖੜੇ ਹੋਣ ਜਾ ਇਉਾਂ ਸਮਝੋ ਕਿ ਉੱਤਰ ਦਿਸ਼ਾ ਵਿੱਚ ਦੋ ਪਹਾੜ ਹੋਣ ॥੫੦੦॥",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "थिर रहे बृछ उपवन किधो उत्तर दिस दुऐ अचल ॥५००॥",
      "sourceLineId": "85784",
      "sourceShabadId": "8002",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਜਬਾ ਛੰਦ ॥",
      "transliteration": "ajabaa chha(n)dh ||",
      "translation": "AJBA STANZA",
      "punjabiViakhya": "ਅਜਬਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "अजबा छंद ॥",
      "sourceLineId": "85785",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜੁੱਟੇ ਬੀਰੰ ॥",
      "transliteration": "ju'Te beera(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਦੋਵੇਾਂ ਬੀਰ ਜੁੱਟੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "जुट्टे बीरं ॥",
      "sourceLineId": "85786",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਛੁੱਟੇ ਤੀਰੰ ॥",
      "transliteration": "chhu'Te teera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ ਛੱਡਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "छुट्टे तीरं ॥",
      "sourceLineId": "85787",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਢੁੱਕੀ ਢਾਲੰ ॥",
      "transliteration": "ddu'kee ddaala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਢਾਲਾ ਉੱਤੇ (ਵਾਰ ਹੋਣ ਨਾਲ) ਢੱਕ- ਢੱਕ ਹੋ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "ढुक्की ढालं ॥",
      "sourceLineId": "85788",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕ੍ਰੋਹੇ ਕਾਲੰ ॥੫੦੧॥",
      "transliteration": "krohe kaala(n) ||501||",
      "translation": "The warriors fought, the arrows were discharged, there was knocking on the shields and the death-like warriors were infuriated.501.",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਨਾਲ ਕਾਲ ਰੂਪ ਹੋ ਰਹੇ ਹਨ ॥੫੦੧॥",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "क्रोहे कालं ॥५०१॥",
      "sourceLineId": "85789",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਢੰਕੇ ਢੋਲੰ ॥",
      "transliteration": "dda(n)ke ddola(n) ||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲਾ ਤੇ ਡੱਗੇ ਵੱਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "ढंके ढोलं ॥",
      "sourceLineId": "85790",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬੰਕੇ ਬੋਲੰ ॥",
      "transliteration": "ba(n)ke bola(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਬੋਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "बंके बोलं ॥",
      "sourceLineId": "85791",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕੱਛੇ ਸਸਤ੍ਰੰ ॥",
      "transliteration": "ka'chhe sasatra(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰ ਫੱਬ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "कच्छे ससत्रं ॥",
      "sourceLineId": "85792",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅੱਛੇ ਅਸਤ੍ਰੰ ॥੫੦੨॥",
      "transliteration": "a'chhe asatra(n) ||502||",
      "translation": "The drums sounded, the blows of the swords were heard and the weapons and arrows were struck.502.",
      "punjabiViakhya": "ਅਸਤ੍ਰ ਸ਼ੋਭ ਰਹੇ ਹਨ ॥੫੦੨॥",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "अच्छे असत्रं ॥५०२॥",
      "sourceLineId": "85793",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕ੍ਰੋਧੰ ਗਲਿਤੰ ॥",
      "transliteration": "krodha(n) galita(n) ||",
      "translation": "",
      "punjabiViakhya": "ਗੁੱਸਾ ਪੀ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "क्रोधं गलितं ॥",
      "sourceLineId": "85794",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬੋਧੰ ਦਲਿਤੰ ॥",
      "transliteration": "bodha(n) dhalita(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਸ਼ ਨੂੰ ਛੱਡ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "बोधं दलितं ॥",
      "sourceLineId": "85795",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗੱਜੈ ਵੀਰੰ ॥",
      "transliteration": "ga'jai veera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਗੱਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "गज्जै वीरं ॥",
      "sourceLineId": "85796",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤੱਜੈ ਤੀਰੰ ॥੫੦੩॥",
      "transliteration": "ta'jai teera(n) ||503||",
      "translation": "Highly infuriated and with great understanding, the forces are being mashed, the warriors are thundering and showering arrows.503.",
      "punjabiViakhya": "ਤੀਰਾ ਨੂੰ ਛੱਡਦੇ ਹਨ ॥੫੦੩॥",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "तज्जै तीरं ॥५०३॥",
      "sourceLineId": "85797",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰੱਤੇ ਨੈਣੰ ॥",
      "transliteration": "ra'te naina(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਖਾ ਲਾਲ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "रत्ते नैणं ॥",
      "sourceLineId": "85798",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮੱਤੇ ਬੈਣੰ ॥",
      "transliteration": "ma'te baina(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮਸਤੀ ਨਾਲ ਬੋਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "मत्ते बैणं ॥",
      "sourceLineId": "85799",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਲੁੱਝੈ ਸੂਰੰ ॥",
      "transliteration": "lu'jhai soora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਲੜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "लुज्झै सूरं ॥",
      "sourceLineId": "85800",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੁੱਝੈ ਹੂਰੰ ॥੫੦੪॥",
      "transliteration": "su'jhai hoora(n) ||504||",
      "translation": "The warriors with red eyes are shouting, having been intoxicated they are fighting and the heavenly damsels are looking at them.504.",
      "punjabiViakhya": "ਅਪਸਰਾਵਾ ਵੇਖਦੀਆਂ ਹਨ ॥੫੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "सुज्झै हूरं ॥५०४॥",
      "sourceLineId": "85801",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਲੱਗੈਂ ਤੀਰੰ ॥",
      "transliteration": "la'gai(n) teera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਈਆਂ ਨੂੰ ਤੀਰ ਲੱਗਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "लग्गैं तीरं ॥",
      "sourceLineId": "85802",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭੱਗੈਂ ਵੀਰੰ ॥",
      "transliteration": "bha'gai(n) veera(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈ ਸੂਰਮੇ) ਭੱਜੇ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "भग्गैं वीरं ॥",
      "sourceLineId": "85803",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰੋਸੰ ਰੁੱਝੈ ॥",
      "transliteration": "rosa(n) ru'jhai ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈ) ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਰੁਝੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "रोसं रुज्झै ॥",
      "sourceLineId": "85804",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅੱਸਤ੍ਰੰ ਜੁੱਝੈ ॥੫੦੫॥",
      "transliteration": "a'satra(n) ju'jhai ||505||",
      "translation": "Having been pierced by arrows, the warriors are fleeing and (some) are fighting with arms, being highly enraged.505.",
      "punjabiViakhya": "(ਕਈ) ਅਸਤ੍ਰਾ ਨਾਲ ਲੜ ਰਹੇ ਹਨ ॥੫੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "अस्सत्रं जुज्झै ॥५०५॥",
      "sourceLineId": "85805",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਝੁੱਮੇ ਸੂਰੰ ॥",
      "transliteration": "jhu'me soora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਝੂਮ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "झुम्मे सूरं ॥",
      "sourceLineId": "85806",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਘੁੱਮੇ ਹੂਰੰ ॥",
      "transliteration": "ghu'me hoora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੂਰਾ ਘੁੰਮ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "घुम्मे हूरं ॥",
      "sourceLineId": "85807",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੱਕੈਂ ਚਾਰੰ ॥",
      "transliteration": "cha'kai(n) chaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹੀਂ ਪਾਸੇ ਦੇਖਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "चक्कैं चारं ॥",
      "sourceLineId": "85808",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬੱਕੈਂ ਮਾਰੰ ॥੫੦੬॥",
      "transliteration": "ba'kai(n) maara(n) ||506||",
      "translation": "The warriors are swinging and the heavenly damsels, while wandering, are looking at them and are wondering on listening to their shouts of “Kill, Kill”.506.",
      "punjabiViakhya": "ਮਾਰੋ-ਮਾਰੋ ਬੋਲਦੇ ਹਨ ॥੫੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "बक्कैं मारं ॥५०६॥",
      "sourceLineId": "85809",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0252_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਭਿੱਦੇ ਬਰਮੰ ॥",
      "transliteration": "bhi'dhe barama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਵਚ ਟੁੱਟ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 252,
      "hindi": "",
      "hindiTransliteration": "भिद्दे बरमं ॥",
      "sourceLineId": "85810",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
