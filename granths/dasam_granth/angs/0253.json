{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 253,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0253_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਛਿੱਦੇ ਚਰਮੰ ॥",
      "transliteration": "chhi'dhe charama(n) ||",
      "translation": "The weapons, coming into contact with armours, are piercing the bodies",
      "punjabiViakhya": "ਢਾਲਾ ਛਿਜ ਗਈਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "छिद्दे चरमं ॥",
      "sourceLineId": "85811",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤੁੱਟੈ ਖੱਗੰ ॥",
      "transliteration": "tu'Tai kha'ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਖੜਗਾ ਟੁੱਟ ਗਈਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "तुट्टै खग्गं ॥",
      "sourceLineId": "85812",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਉੱਠੈ ਅੰਗੰ ॥੫੦੭॥",
      "transliteration": "au'Thai a(n)ga(n) ||507||",
      "translation": "The spars are breaking and the sparks of fire are coming out from them.507.",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਵਿੱਚੋਂ ਅੱਗ ਦੀਆਂ ਚਿੰਗਾਰੀਆਂ ਨਿਕਲ ਰਹੀਆਂ ਹਨ ॥੫੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "उट्ठै अंगं ॥५०७॥",
      "sourceLineId": "85813",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨੱਚੇ ਤਾਜੀ ॥",
      "transliteration": "na'che taajee ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜੇ ਨੱਚਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "नच्चे ताजी ॥",
      "sourceLineId": "85814",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗੱਜੇ ਗਾਜੀ ॥",
      "transliteration": "ga'je gaajee ||",
      "translation": "The horses are dancing and the warriors are thundering",
      "punjabiViakhya": "ਗਾਜ਼ੀ ਗੱਜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "गज्जे गाजी ॥",
      "sourceLineId": "85815",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਡਿੱਗੇ ਵੀਰੰ ॥",
      "transliteration": "ddi'ge veera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਡਿੱਗ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "डिग्गे वीरं ॥",
      "sourceLineId": "85816",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤੱਜੇ ਤੀਰੰ ॥੫੦੮॥",
      "transliteration": "ta'je teera(n) ||508||",
      "translation": "They are falling while discharging the arrows.508.",
      "punjabiViakhya": "ਅਤੇ ਤੀਰ ਛੱਡ ਰਹੇ ਹਨ ॥੫੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "तज्जे तीरं ॥५०८॥",
      "sourceLineId": "85817",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਝੁੱਮੇਾਂ ਸੂਰੰ ॥",
      "transliteration": "jhu'meaa(n) soora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਝੂਮਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "झुम्मेाँ सूरं ॥",
      "sourceLineId": "85818",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਘੁੱਮੀ ਹੂਰੰ ॥",
      "transliteration": "ghu'mee hoora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੂਰਾ ਫਿਰਦੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "घुम्मी हूरं ॥",
      "sourceLineId": "85819",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕੱਛੇ ਬਾਣੰ ॥",
      "transliteration": "ka'chhe baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਨੇ ਬਾਣੇ ਫਬਾਏ ਹੋਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "कच्छे बाणं ॥",
      "sourceLineId": "85820",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮੱਤੇ ਮਾਣੰ ॥੫੦੯॥",
      "transliteration": "ma'te maana(n) ||509||",
      "translation": "Seeing the heavenly damsels moving, the warriors are swinging and, being intoxicated, are discharging arrows.509.",
      "punjabiViakhya": "ਅਤੇ ਮਾਣ ਨਾਲ ਮਤੇ ਹੋਏ ਹਨ ॥੫੦੯॥",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "मत्ते माणं ॥५०९॥",
      "sourceLineId": "85821",
      "sourceShabadId": "8003",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪਾਧਰੀ ਛੰਦ ॥",
      "transliteration": "paadharee chha(n)dh ||",
      "translation": "PAADHARI STANZA",
      "punjabiViakhya": "ਪਾਧੜੀ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "पाधरी छंद ॥",
      "sourceLineId": "85822",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਹ ਭਯੋ ਘੋਰ ਆਹਵ ਅਪਾਰ ॥",
      "transliteration": "teh bhayo ghor aahav apaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਬਹੁਤ ਵੱਡਾ ਅਤੇ ਭਿਆਨਕ ਯੁੱਧ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "तह भयो घोर आहव अपार ॥",
      "sourceLineId": "85823",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਣ ਭੂੰਮਿ ਝੂਮਿ ਜੁੱਝੇ ਜੁਝਾਰ ॥",
      "transliteration": "ran bhoo(n)m jhoom ju'jhe jujhaar ||",
      "translation": "In this way, the war ensued and many warriors fell in the field",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿੱਚ ਲੜਾਕੇ ਯੋਧੇ ਮਸਤੀ ਵਿੱਚ ਆ ਕੇ ਲੜੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "रण भूँमि झूमि जुज्झे जुझार ॥",
      "sourceLineId": "85824",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਇਤ ਰਾਮ ਭ੍ਰਾਤ ਅਤਕਾਇ ਉੱਤ ॥",
      "transliteration": "eit raam bhraat atakai u't ||",
      "translation": "",
      "punjabiViakhya": "ਇਧਰੋਂ ਲੱਛਮਣ ਤੇ ਉਧਰੋਂ ਅਤਕਾਇ (ਨਾ ਦੇ ਯੋਧੇ)",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "इत राम भ्रात अतकाइ उत्त ॥",
      "sourceLineId": "85825",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰਿਸ ਜੁੱਝ ਉੱਝਰੇ ਰਾਜ ਪੁੱਤ ॥੫੧੦॥",
      "transliteration": "ris ju'jh u'jhare raaj pu't ||510||",
      "translation": "On one side there is Lakshman, brother of Ram and on the other there is the demon Atkaaye and both these princes are fighting with each other.510.",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਰਾਜਕੁਮਾਰ ਕ੍ਰੋਧ ਨਾਲ ਜੁਟੇ ਪਏ ਹਨ ॥੫੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "रिस जुज्झ उज्झरे राज पुत्त ॥५१०॥",
      "sourceLineId": "85826",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਬ ਰਾਮ ਭ੍ਰਾਤ ਅਤਿ ਕੀਨ ਰੋਸ ॥",
      "transliteration": "tab raam bhraat at keen ros ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਲੱਛਮਣ ਨੇ ਬਹੁਤ ਕ੍ਰੋਧ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "तब राम भ्रात अति कीन रोस ॥",
      "sourceLineId": "85827",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਿਮ ਪਰਤ ਅਗਨ ਘ੍ਰਿਤ ਕਰਤ ਜੋਸ ॥",
      "transliteration": "jim parat agan ghirat karat jos ||",
      "translation": "Then Lakshman became highly infuriated and increased it with zeal like the fire blazing fiercely when the ghee is poured over it",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਘਿਉ ਦੇ ਪੈਂਦਿਆਂ ਹੀ ਅੱਗ ਜੋਸ਼ ਨਾਲ ਭੜਕ ਪੈਂਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "जिम परत अगन घृत करत जोस ॥",
      "sourceLineId": "85828",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗਹਿ ਬਾਣ ਪਾਣ ਤੱਜੇ ਅਨੰਤ ॥",
      "transliteration": "geh baan paan ta'je ana(n)t ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਧਨੁਸ਼ ਹੱਥ ਵਿੱਚ ਫੜ ਕੇ ਬੇਅੰਤ ਤੀਰ (ਇਸ ਤਰ੍ਰਹਾ ਛੱਡ ਦਿੱਤੇ)",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "गहि बाण पाण तज्जे अनंत ॥",
      "sourceLineId": "85829",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਿਮ ਜੇਠ ਸੂਰ ਕਿਰਣੈ ਦੁਰੰਤ ॥੫੧੧॥",
      "transliteration": "jim jeTh soor kiranai dhura(n)t ||511||",
      "translation": "He discharged the scorching arrows like the terrible sunrays of eh month of Jyestha.511.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਜੇਠ ਦੇ ਮਹੀਨੇ ਵਿੱਚ ਸੂਰਜ ਦੀਆਂ ਕਿਰਨਾ ਪ੍ਰਚੰਡ ਹੁੰਦੀਆਂ ਹਨ ॥੫੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "जिम जेठ सूर किरणै दुरंत ॥५११॥",
      "sourceLineId": "85830",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬ੍ਰਣ ਆਪ ਮੱਧ ਬਾਹਤ ਅਨੇਕ ॥",
      "transliteration": "bran aap ma'dh baahat anek ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਸ ਵਿੱਚ (ਯੋਧੇ) ਅਨੇਕਾ ਘਾਓ ਲਗਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "ब्रण आप मद्ध बाहत अनेक ॥",
      "sourceLineId": "85831",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਰਣੈ ਨ ਜਾਹਿ ਕਹਿ ਏਕ ਏਕ ॥",
      "transliteration": "baranai na jaeh keh ek ek ||",
      "translation": "Getting himself wounded he discharged so many arrows which are indescribable",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਦਾ) ਇਕ-ਇਕ ਕਰਕੇ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "बरणै न जाहि कहि एक एक ॥",
      "sourceLineId": "85832",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਉੱਝਰੇ ਵੀਰ ਜੁੱਝਣ ਜੁਝਾਰ ॥",
      "transliteration": "au'jhare veer ju'jhan jujhaar ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈ) ਲੜਾਕੇ ਸੂਰਮੇ ਯੁੱਧ ਕਰਕੇ ਸ਼ਹੀਦ ਹੋ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "उज्झरे वीर जुज्झण जुझार ॥",
      "sourceLineId": "85833",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0253_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜੈ ਸਬਦ ਦੇਵ ਭਾਖਤ ਪੁਕਾਰ ॥੫੧੨॥",
      "transliteration": "jai sabadh dhev bhaakhat pukaar ||512||",
      "translation": "These brave fighters are absorbed in fight and on the other hand, the gods are raising the sound of victory.512.",
      "punjabiViakhya": "(ਇਸ ਲਈ) ਦੇਵਤੇ ਜੈ-ਨਾਦ ਕਰ ਰਹੇ ਹਨ ॥੫੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 253,
      "hindi": "",
      "hindiTransliteration": "जै सबद देव भाखत पुकार ॥५१२॥",
      "sourceLineId": "85834",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
