{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 254,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0254_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਿਪੁ ਕਰਯੋ ਸੱਸਤ੍ਰ ਅਸਤ੍ਰੰ ਬਿਹੀਨ ॥",
      "transliteration": "rip karayo sa'satr asatra(n) biheen ||",
      "translation": "",
      "punjabiViakhya": "ਲੱਛਮਣ ਨੇ ਵੈਰੀ ਨੂੰ ਸ਼ਸਤ੍ਰਾ ਤੇ ਅਸਤ੍ਰਾ ਤੋਂ ਵਾਝਿਆਂ ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "रिपु करयो सस्सत्र असत्रं बिहीन ॥",
      "sourceLineId": "85835",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਹੁ ਸੱਸਤ੍ਰ ਸਾਸਤ੍ਰ ਬਿੱਦਿਆ ਪ੍ਰਬੀਨ ॥",
      "transliteration": "bahu sa'satr saasatr bi'dhiaa prabeen ||",
      "translation": "Ultimately Lakshman deprived Atkaaye, the specialist in many sciences of weapons and arms, of his weapons and arms",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ) ਉਹ ਸ਼ਸਤ੍ਰ ਦੀ ਵਿਦਿਆ ਵਿੱਚ ਪ੍ਰਬੀਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "बहु सस्सत्र सासत्र बिद्दिआ प्रबीन ॥",
      "sourceLineId": "85836",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹੱਯ ਮੁਕਟ ਸੂਤ ਬਿਨੁ ਭਯੋ ਗਵਾਰ ॥",
      "transliteration": "ha'y mukaT soot bin bhayo gavaar ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਅਤਕਾਇ ਘੋੜੇ, ਮੁਕਟ ਅਤੇ ਸਾਰਥੀ ਤੋਂ ਬਿਨਾ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "हय्य मुकट सूत बिनु भयो गवार ॥",
      "sourceLineId": "85837",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਛੁ ਚਪੇ ਚੋਰ ਜਿਮ ਬਲ ਸੰਭਾਰ ॥੫੧੩॥",
      "transliteration": "kachh chape chor jim bal sa(n)bhaar ||513||",
      "translation": "He was deprived of his horse, crown and garments and he tried ot conceal himself like a thief mustering his strength.513.",
      "punjabiViakhya": "ਬਲ ਨੂੰ ਸੰਭਾਲ ਕੇ ਚੋਰ ਵਾਗੂੰ ਦੁਬਕ ਗਿਆ ॥੫੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "कछु चपे चोर जिम बल संभार ॥५१३॥",
      "sourceLineId": "85838",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰਿਪੁ ਹਣੇ ਬਾਣ ਬੱਜ੍ਰਵ ਘਾਤ ॥",
      "transliteration": "rip hane baan ba'jrav ghaat ||",
      "translation": "",
      "punjabiViakhya": "(ਲੱਛਮਣ) ਵੈਰੀ ਨੂੰ ਬਜ੍ਰ ਵਰਗੇ ਤੀਰ ਮਾਰਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "रिपु हणे बाण बज्ज्रव घात ॥",
      "sourceLineId": "85839",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਮ ਚਲੇ ਕਾਲ ਕੀ ਜੁਆਲ ਤਾਤ ॥",
      "transliteration": "sam chale kaal kee juaal taat ||",
      "translation": "He discharged arrows causing destruction like Indra’s Vajra and they were striking like the advancing fire of death",
      "punjabiViakhya": "ਜੋ ਕਾਲ ਦੀ ਅੱਗ ਵਾਗ ਸਾੜਦੇ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "सम चले काल की जुआल तात ॥",
      "sourceLineId": "85840",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਬ ਕੁਪਯੋ ਵੀਰ ਅਤਕਾਇ ਐਸ ॥",
      "transliteration": "tab kupayo veer atakai aais ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਅਤਕਾਇ ਯੋਧਾ ਵੀ ਕ੍ਰੋਧਵਾਨ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "तब कुपयो वीर अतकाइ ऐस ॥",
      "sourceLineId": "85841",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਨ ਪ੍ਰਲੈ ਕਾਲ ਕੋ ਮੇਘ ਜੈਸ ॥੫੧੪॥",
      "transliteration": "jan pralai kaal ko megh jais ||514||",
      "translation": "The hero Atkaaye become highly infuriated like the clouds of doomsday.514.",
      "punjabiViakhya": "ਮਾਨੋ ਪਰਲੋ ਦੇ ਸਮੇਾਂ ਦੇ ਮੇਘ ਵਰਗਾ ਹੋਵੇ ॥੫੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "जन प्रलै काल को मेघ जैस ॥५१४॥",
      "sourceLineId": "85842",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਇਮ ਕਰਨ ਲਾਗ ਲਪਟੈਂ ਲਬਾਰ ॥",
      "transliteration": "eim karan laag lapaTai(n) labaar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤਕਾਇ' ਇਸ ਤਰ੍ਰਹਾ ਬਕਵਾਦ ਦੀਆਂ ਲਪਟਾ ਪ੍ਰਗਟ ਕਰਨ ਲੱਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "इम करन लाग लपटैं लबार ॥",
      "sourceLineId": "85843",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਿਮ ਜੁੱਬਣ ਹੀਣ ਲਪਟਾਇ ਨਾਰ ॥",
      "transliteration": "jim ju'ban heen lapaTai naar ||",
      "translation": "He began to prattle like a man without the energy of a youth, clinging to a woman without satisfying her,",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਜੋਬਨ-ਹੀਣ (ਬਿਰਧ) ਇਸਤਰੀ ਨਾਲ ਲਿਪਟ ਜਾਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "जिम जुब्बण हीण लपटाइ नार ॥",
      "sourceLineId": "85844",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਮ ਦੰਤ ਰਹਤ ਗਹ ਸ੍ਵਾਨ ਸਸਕ ॥",
      "transliteration": "jim dha(n)t rahat geh savaiaan sasak ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕੁੱਤਾ ਦੰਦਾ ਤੋਂ ਬਿਨਾ ਸਹੇ ਨੂੰ ਫੜਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "जिम दंत रहत गह स्वान ससक ॥",
      "sourceLineId": "85845",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਿਮ ਗਏ ਬੈਸ ਬਲ ਬੀਰਜ ਰਸਕ ॥੫੧੫॥",
      "transliteration": "jim ge bais bal beeraj rasak ||515||",
      "translation": "Or like a teethless dog on catching a rabbit whom he can do no harm, or like a libertine without the semen.515.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਉਮਰ ਦੇ ਬੀਤਣ ਨਾਲ ਬਲ ਤੇ ਬੀਰਜ ਰਿਸ ਜਾਦਾ ਹੈ ॥੫੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "जिम गए बैस बल बीरज रसक ॥५१५॥",
      "sourceLineId": "85846",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਿਮ ਦਰਬ ਹੀਣ ਕਛੁ ਕਰਿ ਬਪਾਰ ॥",
      "transliteration": "jim dharab heen kachh kar bapaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਧਨ ਰਹਿਤ ਵਿਅਕਤੀ ਕੁਝ ਵਪਾਰ ਕਰਦਾ ਹੈ ਜਾ",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "जिम दरब हीण कछु करि बपार ॥",
      "sourceLineId": "85847",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਣ ਸਸਤ੍ਰ ਹੀਣ ਰੁੱਝਯੋ ਜੁਝਾਰ ॥",
      "transliteration": "jan sasatr heen ru'jhayo jujhaar ||",
      "translation": "Atkaaye was in such a situation which is experienced by a trader without money or a warriors without weapons.",
      "punjabiViakhya": "ਮਾਨੋ ਸ਼ਸਤ੍ਰ-ਹੀਣ (ਵਿਅਕਤੀ) ਯੁੱਧ ਵਿੱਚ ਰੁੱਝਿਆ ਹੋਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "जण ससत्र हीण रुज्झयो जुझार ॥",
      "sourceLineId": "85848",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਿਮ ਰੂਪ ਹੀਣ ਬੇਸਯਾ ਪ੍ਰਭਾਵ ॥",
      "transliteration": "jim roop heen besayaa prabhaav ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਰੂਪ ਤੋਂ ਹੀਣੀ ਵੇਸਵਾ ਦਾ ਪ੍ਰਭਾਵ ਹੁੰਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "जिम रूप हीण बेसया प्रभाव ॥",
      "sourceLineId": "85849",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਣ ਬਾਜ ਹੀਣ ਰਥ ਕੋ ਚਲਾਵ ॥੫੧੬॥",
      "transliteration": "jan baaj heen rath ko chalaav ||516||",
      "translation": "He looked like and ugly prostitute or a chariot without horses.516.",
      "punjabiViakhya": "ਜਾ ਮਾਨੋ ਘੋੜੇ ਤੋਂ ਬਿਨਾ ਰਥ ਦਾ ਤੁਰਨਾ ਹੋਵੇ ॥੫੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "जण बाज हीण रथ को चलाव ॥५१६॥",
      "sourceLineId": "85850",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਬ ਤਮਕ ਤੇਗ ਲਛਮਣ ਉਦਾਰ ॥",
      "transliteration": "tab tamak teg lachhaman udhaar ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਉਦਾਰ ਲੱਛਮਣ ਨੇ ਗੁੱਸਾ ਖਾ ਕੇ (ਉਸ ਉੱਤੇ) ਤਲਵਾਰ (ਦਾ ਵਾਰ ਕੀਤਾ) ਅਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "तब तमक तेग लछमण उदार ॥",
      "sourceLineId": "85851",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਹ ਹਣਯੋ ਸੀਸ ਕਿੱਨੋ ਦੁਫਾਰ ॥",
      "transliteration": "teh hanayo sees ki'no dhufaar ||",
      "translation": "Then the benevolent Lakshman stuck his sharp-edged sword and chopped the demon into two halves.",
      "punjabiViakhya": "ਉਸ ਦੇ ਸਿਰ ਦੇ ਦੋ ਟੁਕੜੇ ਕਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "तह हणयो सीस किन्नो दुफार ॥",
      "sourceLineId": "85852",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਬ ਗਿਰਯੋ ਬੀਰ ਅਤਿਕਾਇ ਏਕ ॥",
      "transliteration": "tab girayo beer atikai ek ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਅਤਕਾਇ (ਨਾ ਦਾ) ਇਕ ਯੋਧਾ ਡਿੱਗ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "तब गिरयो बीर अतिकाइ एक ॥",
      "sourceLineId": "85853",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਲਖ ਤਾਹਿ ਸੂਰ ਭੱਜੇ ਅਨੇਕ ॥੫੧੭॥",
      "transliteration": "lakh taeh soor bha'je anek ||517||",
      "translation": "That warriors named Atkaaye fell in the battlefield and on seeing him (falling) many warriors fled away.517.",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਅਨੇਕਾ ਸੂਰਮੇ ਰਣ-ਭੂਮੀ ਵਿੱਚੋਂ ਭੱਜ ਗਏ ॥੫੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "लख ताहि सूर भज्जे अनेक ॥५१७॥",
      "sourceLineId": "85854",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਰਾਮਵਤਾਰ ਅਤਕਾਇ ਬਧਹਿ ਧਿਆਇ ਸਮਾਪਤਮ ਸਤੁ ॥੧੪॥",
      "transliteration": "eit sree bachitr naaTake raamavataar atakai badheh dhiaai samaapatam sat ||14||",
      "translation": "End of the chapter entitled ‘Killing of Atkaaye’ in Ramavtar in BACHITTAR NATAK.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਦੇ ਰਾਮਾਵਤਾਰ ਦੇ ਅਤਿਕਾਇ-ਬਧਹਿ ਅਧਿਆਇ ਦੀ ਸਮਾਪਤੀ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटके रामवतार अतकाइ बधहि धिआइ समापतम सतु ॥१४॥",
      "sourceLineId": "85855",
      "sourceShabadId": "8004",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਥ ਮਕਰਾਛ ਜੁੱਧ ਕਥਨੰ ॥",
      "transliteration": "ath makaraachh ju'dh kathana(n) ||",
      "translation": "Now begins the description of the war with Makrachh :",
      "punjabiViakhya": "ਹੁਣ ਮਕਰਾਛ ਦੇ ਯੁੱਧ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "अथ मकराछ जुद्ध कथनं ॥",
      "sourceLineId": "85856",
      "sourceShabadId": "8005",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪਾਧਰੀ ਛੰਦ ॥",
      "transliteration": "paadharee chha(n)dh ||",
      "translation": "PAADHRI STANZA",
      "punjabiViakhya": "ਪਾਧੜੀ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "पाधरी छंद ॥",
      "sourceLineId": "85857",
      "sourceShabadId": "8005",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਬ ਰੁਕਯੋ ਸੈਨ ਮਕਰਾਛ ਆਨ ॥",
      "transliteration": "tab rukayo sain makaraachh aan ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਮਕਰਾਛ ਆ ਕੇ ਸੈਨਾ ਦੇ (ਸਾਹਮਣੇ) ਖੜੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "तब रुकयो सैन मकराछ आन ॥",
      "sourceLineId": "85858",
      "sourceShabadId": "8005",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਹ ਜਾਹੁ ਰਾਮ ਨਹੀ ਪੈਹੋ ਜਾਨ ॥",
      "transliteration": "keh jaahu raam nahee paiho jaan ||",
      "translation": "After that Makrachh joined the army and said. “O Ram! You cannot save yourself now",
      "punjabiViakhya": "ਅਤੇ ਕਹਿਣ ਲੱਗਾ-ਹੇ ਰਾਮ! (ਤੂੰ ਹੁਣ) ਜੀਊਾਂਦਾ ਨਹੀਂ ਜਾ ਸਕੇਾਂਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "कह जाहु राम नही पैहो जान ॥",
      "sourceLineId": "85859",
      "sourceShabadId": "8005",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਿਨ ਹਤਯੋ ਤਾਤ ਰਣ ਮੋ ਅਖੰਡ ॥",
      "transliteration": "jin hatayo taat ran mo akha(n)dd ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਮੇਰੇ ਅਖੰਡ ਪਿਤਾ (ਖਰ) ਨੂੰ ਰਣ-ਖੇਤਰ ਵਿੱਚ ਮਾਰਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "जिन हतयो तात रण मो अखंड ॥",
      "sourceLineId": "85860",
      "sourceShabadId": "8005",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੋ ਲਰੋ ਆਨ ਮੋ ਸੋਂ ਪ੍ਰਚੰਡ ॥੫੧੮॥",
      "transliteration": "so laro aan mo so(n) pracha(n)dd ||518||",
      "translation": "He who has killed my father, that mighty warriors should come forward and wage war with me.”518.",
      "punjabiViakhya": "ਉਹ ਮੇਰੇ ਨਾਲ ਆ ਕੇ ਪ੍ਰਚੰਡ ਯੁੱਧ ਕਰੇ ॥੫੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "सो लरो आन मो सों प्रचंड ॥५१८॥",
      "sourceLineId": "85861",
      "sourceShabadId": "8005",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਮ ਸੁਣਿ ਕੁਬੈਣ ਰਾਮਾਵਤਾਰ ॥",
      "transliteration": "eim sun kubain raamaavataar ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਚੰਦਰ ਨੇ (ਉਸ ਦੇ) ਇਸ ਤਰ੍ਰਹਾ ਦੇ ਕੁਬੋਲ ਸੁਣੇ",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "इम सुणि कुबैण रामावतार ॥",
      "sourceLineId": "85862",
      "sourceShabadId": "8005",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗਹਿ ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਕੋਪਯੋ ਜੁਝਾਰ ॥",
      "transliteration": "geh sasatr asatr kopayo jujhaar ||",
      "translation": "Ram heard these crooked words and in great rage he held his weapons and arms in his hands",
      "punjabiViakhya": "ਤਾ ਸ਼ਸਤ੍ਰ-ਅਸਤ੍ਰ ਫੜ ਕੇ ਕ੍ਰੋਧ ਨਾਲ ਯੁੱਧ ਕਰਨ ਲੱਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "गहि ससत्र असत्र कोपयो जुझार ॥",
      "sourceLineId": "85863",
      "sourceShabadId": "8005",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਹੁ ਤਾਣ ਬਾਣ ਤਿਹ ਹਣੇ ਅੰਗ ॥",
      "transliteration": "bahu taan baan teh hane a(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਸਰੀਰ ਵਿੱਚ ਬਹੁਤ ਤੀਰ ਖਿੱਚ ਕੇ ਮਾਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "बहु ताण बाण तिह हणे अंग ॥",
      "sourceLineId": "85864",
      "sourceShabadId": "8005",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮਕਰਾਛ ਮਾਰਿ ਡਾਰਯੋ ਨਿਸੰਗ ॥੫੧੯॥",
      "transliteration": "makaraachh maar ddaarayo nisa(n)g ||519||",
      "translation": "He pulled (his bow) discharged his arrows, and fearlessly killed Makrachh.519.",
      "punjabiViakhya": "ਅਤੇ ਨਿਸੰਗ ਹੋ ਕੇ ਮਕਰਾਛ ਨੂੰ ਮਾਰ ਕੇ ਸੁੱਟ ਦਿੱਤਾ ॥੫੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "मकराछ मारि डारयो निसंग ॥५१९॥",
      "sourceLineId": "85865",
      "sourceShabadId": "8005",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਬ ਹਤੇ ਬੀਰ ਅਰ ਹਣੀ ਸੈਨ ॥",
      "transliteration": "jab hate beer ar hanee sain ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਮਕਰਾਛ) ਸੂਰਮਾ ਮਾਰਿਆ ਗਿਆ ਅਤੇ ਸੈਨਾ ਵੀ ਮਾਰੀ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "जब हते बीर अर हणी सैन ॥",
      "sourceLineId": "85866",
      "sourceShabadId": "8005",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਬ ਭਜੌ ਸੂਰ ਹੁਐ ਕਰ ਨਿਚੈਨ ॥",
      "transliteration": "tab bhajau soor huaai kar nichain ||",
      "translation": "When this hero and his army were killed, then all the warriors, becoming weaponsless, ran away (from the filed)",
      "punjabiViakhya": "ਤਦ (ਹੋਰ) ਸੂਰਮੇ ਬੇਚੈਨ ਹੋ ਕੇ ਭਜ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "तब भजौ सूर हुऐ कर निचैन ॥",
      "sourceLineId": "85867",
      "sourceShabadId": "8005",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਬ ਕੁੰਭ ਔਰ ਅਨਕੁੰਭ ਆਨ ॥",
      "transliteration": "tab ku(n)bh aauar anaku(n)bh aan ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ 'ਕੁੰਭ' ਅਤੇ 'ਅਨਕੁੰਭ' (ਨਾਮ ਵਾਲੇ ਦੋ ਦੈਂਤਾ ਨੇ) ਆ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "तब कुँभ और अनकुँभ आन ॥",
      "sourceLineId": "85868",
      "sourceShabadId": "8005",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦਲ ਰੁੱਕਯੋ ਰਾਮ ਕੋ ਤਯਾਗ ਕਾਨ ॥੫੨੦॥",
      "transliteration": "dhal ru'kayo raam ko tayaag kaan ||520||",
      "translation": "After that Kumbh and Ankumbh came forward and obstructed the army of Ram.520.",
      "punjabiViakhya": "ਰਾਮ ਦਾ ਡਰ ਛੱਡਕੇ (ਉਨ੍ਰਹਾ ਦੇ) ਦਲ ਨੂੰ ਰੋਕ ਲਿਆ ॥੫੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "दल रुक्कयो राम को तयाग कान ॥५२०॥",
      "sourceLineId": "85869",
      "sourceShabadId": "8005",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਤਿ ਮਰਾਛ ਬਧਹ ॥",
      "transliteration": "eit maraachh badheh ||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਮਕਰਾਛ ਬਧ ਸਮਾਪਤ।",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "इति मराछ बधह ॥",
      "sourceLineId": "85870",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਜਬਾ ਛੰਦ ॥",
      "transliteration": "ajabaa chha(n)dh ||",
      "translation": "AJBA STANZA",
      "punjabiViakhya": "ਅਜਬਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "अजबा छंद ॥",
      "sourceLineId": "85871",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤ੍ਰੱਪੇ ਤਾਜੀ ॥",
      "transliteration": "tra'pe taajee ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜੇ ਕੁੱਦਣ ਲੱਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "त्रप्पे ताजी ॥",
      "sourceLineId": "85872",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੱਜੇ ਗਾਜੀ ॥",
      "transliteration": "ga'je gaajee ||",
      "translation": "",
      "punjabiViakhya": "ਗਾਜ਼ੀ ਗੱਜਣ ਲੱਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "गज्जे गाजी ॥",
      "sourceLineId": "85873",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੱਜੇ ਸਸਤ੍ਰੰ ॥",
      "transliteration": "sa'je sasatra(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਸ਼ਸਤ੍ਰਾ ਨਾਲ ਸਜੇ ਹੋਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "सज्जे ससत्रं ॥",
      "sourceLineId": "85874",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕੱਛੇ ਅਸਤ੍ਰੰ ॥੫੨੧॥",
      "transliteration": "ka'chhe asatra(n) ||521||",
      "translation": "The horses jumped, the warriors thundered and began to strike blows, being bedecked with weapons and arms.521.",
      "punjabiViakhya": "ਅਤੇ ਅਸਤ੍ਰਾ ਨਾਲ ਫਬੇ ਹੋਏ ਹਨ ॥੫੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "कच्छे असत्रं ॥५२१॥",
      "sourceLineId": "85875",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤੁੱਟੇ ਤ੍ਰਾਣੰ ॥",
      "transliteration": "tu'Te traana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਵਚ ਟੁੱਟ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "तुट्टे त्राणं ॥",
      "sourceLineId": "85876",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਛੁੱਟੇ ਬਾਣੰ ॥",
      "transliteration": "chhu'Te baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣ ਚੱਲ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "छुट्टे बाणं ॥",
      "sourceLineId": "85877",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰੁੱਪੇ ਬੀਰੰ ॥",
      "transliteration": "ru'pe beera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਨੇ (ਪੈਰ) ਗੱਡੇ ਹੋਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "रुप्पे बीरं ॥",
      "sourceLineId": "85878",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬੁੱਠੇ ਤੀਰੰ ॥੫੨੨॥",
      "transliteration": "bu'The teera(n) ||522||",
      "translation": "The bows broke, the arrows were discharged, the warriors became firm and the shafts were showered.522.",
      "punjabiViakhya": "ਅਤੇ ਤੀਰਾ ਦੀ ਬਰਖਾ ਹੋ ਰਹੀ ਹੈ ॥੫੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "बुट्ठे तीरं ॥५२२॥",
      "sourceLineId": "85879",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਘੁੱਮੇ ਘਾਯੰ ॥",
      "transliteration": "ghu'me ghaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਘਾਇਲ ਘੁੰਮਦੇ ਫਿਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "घुम्मे घायं ॥",
      "sourceLineId": "85880",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜੁੱਮੇ ਚਾਯੰ ॥",
      "transliteration": "ju'me chaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਉਮੰਗ ਨਾਲ ਭਰੇ ਹੋਏ ਚੱਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "जुम्मे चायं ॥",
      "sourceLineId": "85881",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0254_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰੱਜੇ ਰੋਸੰ ॥",
      "transliteration": "ra'je rosa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈ) ਕ੍ਰੋਧ ਨਾਲ ਭਰੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 254,
      "hindi": "",
      "hindiTransliteration": "रज्जे रोसं ॥",
      "sourceLineId": "85882",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
