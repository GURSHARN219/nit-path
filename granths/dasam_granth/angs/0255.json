{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 255,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0255_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤੱਜੇ ਹੋਸੰ ॥੫੨੩॥",
      "transliteration": "ta'je hosa(n) ||523||",
      "translation": "The warriors wandered after getting wounded and their zeal grew, with fury, they began to lose their senses.523.",
      "punjabiViakhya": "(ਜਿਸ ਕਰ ਕੇ) ਹੋਸ਼ ਠਿਕਾਣੇ ਨਹੀਂ ਹੈ ॥੫੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "तज्जे होसं ॥५२३॥",
      "sourceLineId": "85883",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕੱਜੇ ਸੰਜੰ ॥",
      "transliteration": "ka'je sa(n)ja(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨੇ) ਕਵਚਾ ਨਾਲ (ਤਨ) ਕੱਜੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "कज्जे संजं ॥",
      "sourceLineId": "85884",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪੂਰੇ ਪੰਜੰ ॥",
      "transliteration": "poore pa(n)ja(n) ||",
      "translation": "",
      "punjabiViakhya": "ਪੰਜ (ਪ੍ਰਕਾਰ ਦੇ ਸ਼ਸਤ੍ਰ ਧਾਰਨ) ਕੀਤੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "पूरे पंजं ॥",
      "sourceLineId": "85885",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੁੱਝੇ ਖੇਤੰ ॥",
      "transliteration": "ju'jhe kheta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿੱਚ ਲੜ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "जुज्झे खेतं ॥",
      "sourceLineId": "85886",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਡਿੱਗੇ ਚੇਤੰ ॥੫੨੪॥",
      "transliteration": "ddi'ge cheta(n) ||524||",
      "translation": "The warriors covered with armours, began to fight in the battlefield and fell down unconscious.524.",
      "punjabiViakhya": "ਅਤੇ ਅਚੇਤ ਹੋ ਕੇ ਡਿੱਗੇ ਪਏ ਹਨ ॥੫੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "डिग्गे चेतं ॥५२४॥",
      "sourceLineId": "85887",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਘੇਰੀ ਲੰਕੰ ॥",
      "transliteration": "gheree la(n)ka(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਕੇ ਸੂਰਮਿਆ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "घेरी लंकं ॥",
      "sourceLineId": "85888",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬੀਰੰ ਬੰਕੰ ॥",
      "transliteration": "beera(n) ba(n)ka(n) ||",
      "translation": "The foppish warriors besieged Lanka",
      "punjabiViakhya": "ਲੰਕਾ ਘੇਰ ਲਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "बीरं बंकं ॥",
      "sourceLineId": "85889",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭੱਜੀ ਸੈਣੰ ॥",
      "transliteration": "bha'jee saina(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਰਮਿੰਦੀਆਂ ਅੱਖਾ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "भज्जी सैणं ॥",
      "sourceLineId": "85890",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਲੱਜੀ ਨੈਣੰ ॥੫੨੫॥",
      "transliteration": "la'jee naina(n) ||525||",
      "translation": "The demons army sped away feeling ashamed.525.",
      "punjabiViakhya": "ਰਾਖਸ਼ਾ ਦੀ ਸੈਨਾ ਭਜ ਗਈ ਹੈ ॥੫੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "लज्जी नैणं ॥५२५॥",
      "sourceLineId": "85891",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਡਿੱਗੇ ਸੂਰੰ ॥",
      "transliteration": "ddi'ge soora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਡਿੱਗ ਪਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "डिग्गे सूरं ॥",
      "sourceLineId": "85892",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭਿੱਗੇ ਨੂਰੰ ॥",
      "transliteration": "bhi'ge noora(n) ||",
      "translation": "The brave fighters fell and their faces shone",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ) ਮੁਖ (ਲਹੂ ਨਾਲ) ਭਿੱਜੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "भिग्गे नूरं ॥",
      "sourceLineId": "85893",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਯਾਹੈਂ ਹੂਰੰ ॥",
      "transliteration": "bayaahai(n) hoora(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੂੰ) ਹੂਰਾ ਵਿਆਹ ਰਹੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "बयाहैं हूरं ॥",
      "sourceLineId": "85894",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਾਮੰ ਪੂਰੰ ॥੫੨੬॥",
      "transliteration": "kaama(n) poora(n) ||526||",
      "translation": "They wedded the heavenly damsels and fulfilled their wishes.526.",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਦੀ ਕਾਮਨਾ ਪੂਰੀ ਹੋ ਰਹੀ ਹੈ ॥੫੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "कामं पूरं ॥५२६॥",
      "sourceLineId": "85895",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਰਾਮਵਤਾਰ ਮਕਰਾਛ ਕੁੰਭ ਅਨਕੁੰਭ ਬਧਹਿ ਧਯਾਇ ਸਮਾਪਤਮ ਸਤੁ ॥",
      "transliteration": "eit sree bachitr naaTake raamavataar makaraachh ku(n)bh anaku(n)bh badheh dhayai samaapatam sat ||",
      "translation": "End of the chapter entitled ‘Killing of Makrachh, Kumbh and Ankumbh’ in Ramavtar in BACHITTAR NATAK.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਦੇ ਰਾਮਾਵਤਾਰ ਦੇ ਕੁੰਭ ਬਧਹਿ ਅਧਿਆਇ ਦੀ ਸਮਾਪਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटके रामवतार मकराछ कुँभ अनकुँभ बधहि धयाइ समापतम सतु ॥",
      "sourceLineId": "85896",
      "sourceShabadId": "8006",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਥ ਰਾਵਨ ਜੁੱਧ ਕਥਨੰ ॥",
      "transliteration": "ath raavan ju'dh kathana(n) ||",
      "translation": "Now begins the description of the war with Ravna :",
      "punjabiViakhya": "ਹੁਣ ਰਾਵਣ ਦੇ ਯੁੱਧ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "अथ रावन जुद्ध कथनं ॥",
      "sourceLineId": "85897",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹੋਹਾ ਛੰਦ ॥",
      "transliteration": "hohaa chha(n)dh ||",
      "translation": "HOHA STANZA",
      "punjabiViakhya": "ਹੋਹਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "होहा छंद ॥",
      "sourceLineId": "85898",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੁਣਯੋ ਇੱਸੰ ॥",
      "transliteration": "sunayo i'sa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਦੈਂਤਾ ਦੇ) ਰਾਜੇ (ਰਾਵਣ) ਨੇ ਸੁਣਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "सुणयो इस्सं ॥",
      "sourceLineId": "85899",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਿਣਯੋ ਕਿੱਸੰ ॥",
      "transliteration": "jinayo ki'sa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਬੰਦਰ ਜਿੱਤ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "जिणयो किस्सं ॥",
      "sourceLineId": "85900",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚੱਪਯੋ ਚਿੱਤੰ ॥",
      "transliteration": "cha'payo chi'ta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਚਿੱਤ ਵਿੱਚ ਖਿੱਝ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "चप्पयो चित्तं ॥",
      "sourceLineId": "85901",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬੁੱਲਯੋ ਬਿੱਤੰ ॥੫੨੭॥",
      "transliteration": "bu'layo bi'ta(n) ||527||",
      "translation": "Ravna heard about the victory (of Ram), he being highly infuriated in his mind, began to shout violently.527.",
      "punjabiViakhya": "ਅਤੇ (ਆਪਣੇ) ਪੂਰੇ ਬਲ ਨਾਲ ਬੋਲਣ ਲੱਗਿਆਂ (ਬੰਦਰਾ ਦਾ ਰਾਜਾ ਜਿੱਤ ਗਿਆ) ॥੫੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "बुल्लयो बित्तं ॥५२७॥",
      "sourceLineId": "85902",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਘਿਰਿਯੋ ਗੜੰ ॥",
      "transliteration": "ghiriyo gaRa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਬੰਦਰਾ ਦੁਆਰਾ) ਕਿਲੇ ਦਾ ਘਿਰਨ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "घिरियो गड़ं ॥",
      "sourceLineId": "85903",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰਿਸੰ ਬੜੰ ॥",
      "transliteration": "risa(n) baRa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਵਣ ਦਾ) ਕ੍ਰੋਧ ਵਧ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "रिसं बड़ं ॥",
      "sourceLineId": "85904",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭਜੀ ਤ੍ਰਿਯੰ ॥",
      "transliteration": "bhajee tiraya(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਵਣ ਦੀਆਂ) ਇਸਤਰੀਆਂ ਭੱਜ ਗਈਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "भजी तृयं ॥",
      "sourceLineId": "85905",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭ੍ਰਮੀ ਭਯੰ ॥੫੨੮॥",
      "transliteration": "bhramee bhaya(n) ||528||",
      "translation": "Seeing his citadel besieged his ire grew more and he saw women running away in fear.528.",
      "punjabiViakhya": "ਅਤੇ ਭੈ ਨਾਲ ਭਰਮੀਆਂ ਹੋਈਆਂ ਹਨ ॥੫੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "भ्रमी भयं ॥५२८॥",
      "sourceLineId": "85906",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭ੍ਰਮੀ ਤਬੈ ॥",
      "transliteration": "bhramee tabai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਵਣ ਦੀਆਂ) ਭੈਭੀਤ ਹੋਣ ਵਾਲੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "भ्रमी तबै ॥",
      "sourceLineId": "85907",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭਜੀ ਸਭੈ ॥",
      "transliteration": "bhajee sabhai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆਂ (ਇਸਤਰੀਆਂ) ਭੱਜੀ ਜਾਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "भजी सभै ॥",
      "sourceLineId": "85908",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤ੍ਰਿਯੰ ਇਸੰ ॥",
      "transliteration": "tiraya(n) isa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਵਣ ਦੀ ਇਸਤਰੀ (ਮੰਦੋਦਰੀ) ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "तृयं इसं ॥",
      "sourceLineId": "85909",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗਹਯੋ ਕਿਸੰ ॥੫੨੯॥",
      "transliteration": "gahayo kisa(n) ||529||",
      "translation": "All the women are running away in illusion and Ravana obstructed them catching their hair.529.",
      "punjabiViakhya": "ਬੰਦਰਾ ਨੇ ਫੜ ਲਿਆ ਹੈ ॥੫੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "गहयो किसं ॥५२९॥",
      "sourceLineId": "85910",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਰੈਂ ਹਹੰ ॥",
      "transliteration": "karai(n) haha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਇ-ਹਾਇ ਕਰਦੀ ਹੋਈ",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "करैं हहं ॥",
      "sourceLineId": "85911",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਹੋ ਦਯੰ ॥",
      "transliteration": "aho dhaya(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲੱਗੀ ਕਿ) ਹੇ ਦੇਵ!",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "अहो दयं ॥",
      "sourceLineId": "85912",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਰੋ ਗਈ ॥",
      "transliteration": "karo giee ||",
      "translation": "",
      "punjabiViakhya": "(ਜੇ ਕੋਈ) ਅਵੱਗਿਆ ਹੋ ਗਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "करो गई ॥",
      "sourceLineId": "85913",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਛਮੋ ਭਈ ॥੫੩੦॥",
      "transliteration": "chhamo bhiee ||530||",
      "translation": "They were lamenting profusely and praying to God and were asking for forgiveness for their sins.530.",
      "punjabiViakhya": "ਤਾ ਖਿਮਾ ਕਰ ਦਿਓ ॥੫੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "छमो भई ॥५३०॥",
      "sourceLineId": "85914",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੁਣੀ ਸ੍ਰੁੱਤੰ ॥",
      "transliteration": "sunee sru'ta(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਵਣ ਨੇ) ਉਸ (ਮੰਦੋਦਰੀ ਦੀ ਪੁਕਾਰ ਨੂੰ)",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "सुणी स्रुत्तं ॥",
      "sourceLineId": "85915",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਧੁਣੰ ਉਤੰ ॥",
      "transliteration": "dhuna(n) uta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕੰਨੀਂ ਸੁਣ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "धुणं उतं ॥",
      "sourceLineId": "85916",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਉਠਯੋ ਹਠੀ ॥",
      "transliteration": "auThayo haThee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਹੱਠੀ (ਇਸ ਤਰ੍ਰਹਾ ਉੱਠਿਆ)",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "उठयो हठी ॥",
      "sourceLineId": "85917",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਿਮੰ ਭਠੀ ॥੫੩੧॥",
      "transliteration": "jima(n) bhaThee ||531||",
      "translation": "That persistent Ravana got up on listening to such sounds and it seemed that a fire cauldron was blazing.531.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਭੱਠੀ (ਵਿਚੋਂ ਅੱਗ ਦਾ ਲੰਬੂ ਨਿਕਲਦਾ ਹੈ) ॥੫੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "जिमं भठी ॥५३१॥",
      "sourceLineId": "85918",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਛਯੋ ਨਰੰ ॥",
      "transliteration": "kachhayo nara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਡਟ ਕੇ ਯੋਧੇ (ਰਾਵਣ ਨੇ)",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "कछयो नरं ॥",
      "sourceLineId": "85919",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਜੇ ਸਰੰ ॥",
      "transliteration": "taje sara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ ਛੱਡੇ",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "तजे सरं ॥",
      "sourceLineId": "85920",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹਣੇ ਕਿਸੰ ॥",
      "transliteration": "hane kisa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬੰਦਰ ਮਾਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "हणे किसं ॥",
      "sourceLineId": "85921",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰੁਕੀ ਦਿਸੰ ॥੫੩੨॥",
      "transliteration": "rukee dhisa(n) ||532||",
      "translation": "He began to kill the human army and with his arrows all the directions were obstructed.532.",
      "punjabiViakhya": "(ਸਾਰੀਆਂ) ਦਿਸ਼ਾਵਾ (ਤੀਰਾ ਨਾਲ) ਭਰ ਗਈਆਂ ॥੫੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "रुकी दिसं ॥५३२॥",
      "sourceLineId": "85922",
      "sourceShabadId": "8007",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤ੍ਰਿਣਣਿਣ ਛੰਦ ॥",
      "transliteration": "tirananin chha(n)dh ||",
      "translation": "TRINANIN STANZA",
      "punjabiViakhya": "ਤ੍ਰਿਣਣਿਣ ਛੰਦ (ਨੋਟ-ਇਸ ਨਾ ਅਧੀਨ ਲਿਖੇ ਗਏ ਛੰਦਾ ਦੇ ਪਹਿਲੇ ਸ਼ਬਦ ਉਾਂਜ ਤਾ ਅਰਥਹੀਣ ਹਨ ਪਰ ਜੰਗ ਦਾ ਜੋਸ਼ ਪੈਦਾ ਕਰਨ ਲਈ ਵਰਤੇ ਗਏ ਹਨ।)",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "तृणणिण छंद ॥",
      "sourceLineId": "85923",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤ੍ਰਿਣਣਿਣ ਤੀਰੰ ॥",
      "transliteration": "tirananin teera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ ਚੱਲਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "तृणणिण तीरं ॥",
      "sourceLineId": "85924",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬ੍ਰਿਣਣਿਣ ਬੀਰੰ ॥",
      "transliteration": "birananin beera(n) ||",
      "translation": "The arrows were discharged and the warriors were wounded.",
      "punjabiViakhya": "ਸੂਰਮੇ ਬੋਲਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "बृणणिण बीरं ॥",
      "sourceLineId": "85925",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਢ੍ਰਣਣਣ ਢਾਲੰ ॥",
      "transliteration": "ddrananan ddaala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਢਾਲਾ ਵੱਜਦੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "ढ्रणणण ढालं ॥",
      "sourceLineId": "85926",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜ੍ਰਣਣਣ ਜ੍ਵਾਲੰ ॥੫੩੩॥",
      "transliteration": "jrananan javaiaala(n) ||533||",
      "translation": "The shields were slipping down and the fires blazed.533.",
      "punjabiViakhya": "ਅਤੇ ਵਿੱਚੋਂ ਅੱਗ ਨਿਕਲਦੀ ਹੈ ॥੫੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "ज्रणणण ज्वालं ॥५३३॥",
      "sourceLineId": "85927",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਖ੍ਰਣਣਣ ਖੋਲੰ ॥",
      "transliteration": "khrananan khola(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸਿਰ ਦੇ) ਟੋਪਾ ਵਿੱਚ",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "ख्रणणण खोलं ॥",
      "sourceLineId": "85928",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬ੍ਰਣਣਣ ਬੋਲੰ ॥",
      "transliteration": "brananan bola(n) ||",
      "translation": "",
      "punjabiViakhya": "ਖੜਾਕ ਦੀ ਆਵਾਜ਼ ਹੁੰਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "ब्रणणण बोलं ॥",
      "sourceLineId": "85929",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0255_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕ੍ਰਣਣਣ ਰੋਸੰ ॥",
      "transliteration": "krananan rosa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਕ੍ਰੋਧ ਕਰਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 255,
      "hindi": "",
      "hindiTransliteration": "क्रणणण रोसं ॥",
      "sourceLineId": "85930",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
