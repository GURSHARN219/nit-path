    {
      "id": "dasam_ang_0256_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜ੍ਰਣਣਣ ਜੋਸੰ ॥੫੩੪॥",
      "transliteration": "jrananan josa(n) ||534||",
      "translation": "The helmets were knocked and the wounds were caused, the warriors were infuriated and their zeal grew.534.",
      "punjabiViakhya": "ਜੋਸ਼ ਨਾਲ (ਲੜਦੇ ਹਨ) ॥੫੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "ज्रणणण जोसं ॥५३४॥",
      "sourceLineId": "85931",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬ੍ਰਣਣਣ ਬਾਜੀ ॥",
      "transliteration": "brananan baajee ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜੇ",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "ब्रणणण बाजी ॥",
      "sourceLineId": "85932",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤ੍ਰਿਣਣਣ ਤਾਜੀ ॥",
      "transliteration": "tirananan taajee ||",
      "translation": "",
      "punjabiViakhya": "ਕਲਾਬਾਜ਼ੀਆਂ ਪਾਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "तृणणण ताजी ॥",
      "sourceLineId": "85933",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜ੍ਰਣਣਣ ਜੂਝੇ ॥",
      "transliteration": "jrananan joojhe ||",
      "translation": "",
      "punjabiViakhya": "ਜੁਝਾਰੂ",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "ज्रणणण जूझे ॥",
      "sourceLineId": "85934",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਲ੍ਰਣਣਣ ਲੂਝੇ ॥੫੩੫॥",
      "transliteration": "lrananan loojhe ||535||",
      "translation": "The fast-moving horses began to run and the warriors obtained salvation after severe fighting.535.",
      "punjabiViakhya": "ਲੜਦੇ ਹਨ ॥੫੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "ल्रणणण लूझे ॥५३५॥",
      "sourceLineId": "85935",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਰਣਣ ਹਾਥੀ ॥",
      "transliteration": "haranan haathee ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਥੀਆਂ ਸਮੇਤ",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "हरणण हाथी ॥",
      "sourceLineId": "85936",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਰਣਣ ਸਾਥੀ ॥",
      "transliteration": "saranan saathee ||",
      "translation": "The elephants ran like deer and the warriors took refuge with their comrades",
      "punjabiViakhya": "ਸੂਰਮੇ",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "सरणण साथी ॥",
      "sourceLineId": "85937",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭਰਣਣ ਭਾਜੇ ॥",
      "transliteration": "bharanan bhaaje ||",
      "translation": "",
      "punjabiViakhya": "ਲਾਜ ਦੇ ਮਾਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "भरणण भाजे ॥",
      "sourceLineId": "85938",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਲਰਣਣ ਲਾਜੇ ॥੫੩੬॥",
      "transliteration": "laranan laaje ||536||",
      "translation": "The enemies ran and felt shy of fighting.536.",
      "punjabiViakhya": "ਭੱਜੇ ਜਾਦੇ ਹਨ ॥੫੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "लरणण लाजे ॥५३६॥",
      "sourceLineId": "85939",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚਰਣਣ ਚਰਮੰ ॥",
      "transliteration": "charanan charama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਢਾਲਾ ਚੂਰ-ਚੂਰ",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "चरणण चरमं ॥",
      "sourceLineId": "85940",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਰਣਣ ਬਰਮੰ ॥",
      "transliteration": "baranan barama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੋ ਗਈਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "बरणण बरमं ॥",
      "sourceLineId": "85941",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਰਣਣ ਕਾਟੇ ॥",
      "transliteration": "karanan kaaTe ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਵਚ ਟੁੱਟ ਗਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "करणण काटे ॥",
      "sourceLineId": "85942",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਰਣਣ ਬਾਟੇ ॥੫੩੭॥",
      "transliteration": "baranan baaTe ||537||",
      "translation": "The bodies and the armours were cut, the ears and eyes were amputated.537.",
      "punjabiViakhya": "(ਸਰੀਰ) ਵੱਢੇ ਗਏ ਹਨ ॥੫੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "बरणण बाटे ॥५३७॥",
      "sourceLineId": "85943",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਰਣਣ ਮਾਰੇ ॥",
      "transliteration": "maranan maare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਵੈਰੀ ਮਾਰੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "मरणण मारे ॥",
      "sourceLineId": "85944",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਰਣਣ ਤਾਰੇ ॥",
      "transliteration": "taranan taare ||",
      "translation": "",
      "punjabiViakhya": "ਦੁਸ਼ਟ ਤਾੜੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "तरणण तारे ॥",
      "sourceLineId": "85945",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਰਣਣ ਜੀਤਾ ॥",
      "transliteration": "jaranan jeetaa ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ (ਉਸ ਨੇ) ਜਿੱਤਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "जरणण जीता ॥",
      "sourceLineId": "85946",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਰਣਣ ਸੀਤਾ ॥੫੩੮॥",
      "transliteration": "saranan seetaa ||538||",
      "translation": "The warriors breathed their last and ferried across the world-ocean, some were burnt in the fire of ire and took rufuge.538.",
      "punjabiViakhya": "(ਜਿਸ ਦੀ ਸ਼ਰਨ ਵਿੱਚ) ਸੀਤਾ (ਰਹਿੰਦੀ ਹੈ) ॥੫੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "सरणण सीता ॥५३८॥",
      "sourceLineId": "85947",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗਰਣਣ ਗੈਣੰ ॥",
      "transliteration": "garanan gaina(n) ||",
      "translation": "",
      "punjabiViakhya": "ਆਕਾਸ਼ ਹੀ",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "गरणण गैणं ॥",
      "sourceLineId": "85948",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਰਣਣ ਐਣੰ ॥",
      "transliteration": "aranan aaina(n) ||",
      "translation": "The gods moved in their air-vehicles and saw the scene",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਦਾ) ਘਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "अरणण ऐणं ॥",
      "sourceLineId": "85949",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹਰਣਣ ਹੂਰੰ ॥",
      "transliteration": "haranan hoora(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ) ਹੂਰਾ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "हरणण हूरं ॥",
      "sourceLineId": "85950",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪਰਣਣ ਪੂਰੰ ॥੫੩੯॥",
      "transliteration": "paranan poora(n) ||539||",
      "translation": "The heavenly damsels wandered and began to wed the warriors.539.",
      "punjabiViakhya": "(ਉਹ) ਭਰਿਆ ਹੋਇਆ ਹੈ ॥੫੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "परणण पूरं ॥५३९॥",
      "sourceLineId": "85951",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਰਣਣ ਬਾਜੇ ॥",
      "transliteration": "baranan baaje ||",
      "translation": "",
      "punjabiViakhya": "ਵਾਜੇ ਵੱਜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "बरणण बाजे ॥",
      "sourceLineId": "85952",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗਰਣਣ ਗਾਜੇ ॥",
      "transliteration": "garanan gaaje ||",
      "translation": "Various types of musical instruments resounded and the elephants thundered",
      "punjabiViakhya": "ਗਾਜ਼ੀ ਗੱਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "गरणण गाजे ॥",
      "sourceLineId": "85953",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਰਣਣ ਸੁੱਝੇ ॥",
      "transliteration": "saranan su'jhe ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੂੰ ਵਾਰ ਕਰਨੇ) ਸੁੱਝਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "सरणण सुज्झे ॥",
      "sourceLineId": "85954",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਰਣਣ ਜੁੱਝੇ ॥੫੪੦॥",
      "transliteration": "jaranan ju'jhe ||540||",
      "translation": "The warriors took refuge while some began to fight.,540.",
      "punjabiViakhya": "ਅਤੇ ਚੰਗੀ ਤਰ੍ਰਹਾ ਜੂਝਦੇ ਹਨ ॥੫੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "जरणण जुज्झे ॥५४०॥",
      "sourceLineId": "85955",
      "sourceShabadId": "8008",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤ੍ਰਿਗਤਾ ਛੰਦ ॥",
      "transliteration": "tiragataa chha(n)dh ||",
      "translation": "TRIGTAA STANZA",
      "punjabiViakhya": "ਤ੍ਰਿਗਤਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "तृगता छंद ॥",
      "sourceLineId": "85956",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੱਤ ਤੀਰੰ ॥",
      "transliteration": "ta't teera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਤੀਰ",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "तत्त तीरं ॥",
      "sourceLineId": "85957",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬੱਬ ਬੀਰੰ ॥",
      "transliteration": "ba'b beera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਛੱਡਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "बब्ब बीरं ॥",
      "sourceLineId": "85958",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਢੱਲ ਢਾਲੰ ॥",
      "transliteration": "dda'l ddaala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਢਾਲਾ ('ਤੇ ਲੱਗਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "ढल्ल ढालं ॥",
      "sourceLineId": "85959",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜੱਜ ਜੁਆਲੰ ॥੫੪੧॥",
      "transliteration": "ja'j juaala(n) ||541||",
      "translation": "The arrows began to kill warriors and the fire came out of the shelds.541.",
      "punjabiViakhya": "ਅਤੇ ਵਿੱਚੋਂ) ਅੱਗ ਨਿਕਲਦੀ ਹੈ ॥੫੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "जज्ज जुआलं ॥५४१॥",
      "sourceLineId": "85960",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤੱਜ ਤਾਜੀ ॥",
      "transliteration": "ta'j taajee ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜਿਆਂ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 256,
      "hindi": "",
      "hindiTransliteration": "तज्ज ताजी ॥",
      "sourceLineId": "85961",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0256_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੱਗ ਗਾਜੀ ॥",
