    {
      "id": "dasam_ang_0257_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅੱਅ ਅੰਗੰ ॥",
      "transliteration": "a'a a(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਗਾ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "अअ्अ अंगं ॥",
      "sourceLineId": "85979",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜੱਜ ਜੰਗੰ ॥੫੪੬॥",
      "transliteration": "ja'j ja(n)ga(n) ||546||",
      "translation": "The limbs are being chopped in the war. 546",
      "punjabiViakhya": "ਵਿੰਨ੍ਰਹ ਦਿੰਦੇ ਹਨ ॥੫੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "जज्ज जंगं ॥५४६॥",
      "sourceLineId": "85980",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕੱਕ ਕ੍ਰੋਧੰ ॥",
      "transliteration": "ka'k krodha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "कक्क क्रोधं ॥",
      "sourceLineId": "85981",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੱਜ ਜੋਧੰ ॥",
      "transliteration": "ja'j jodha(n) ||",
      "translation": "There is lot of discipline and lot of obstruction",
      "punjabiViakhya": "ਯੋਧੇ ਭੱਜ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "जज्ज जोधं ॥",
      "sourceLineId": "85982",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਘੱਘ ਘਾਏ ॥",
      "transliteration": "gha'gh ghaae ||",
      "translation": "",
      "punjabiViakhya": "(ਵੈਰੀ ਨੂੰ)",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "घग्घ घाए ॥",
      "sourceLineId": "85983",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਧੱਧ ਧਾਏ ॥੫੪੭॥",
      "transliteration": "dha'dh dhaae ||547||",
      "translation": "The limbs are being chopped in the war.547.",
      "punjabiViakhya": "ਮਾਰਦੇ ਹਨ ॥੫੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "धद्ध धाए ॥५४७॥",
      "sourceLineId": "85984",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹੱਹ ਹੂਰੰ ॥",
      "transliteration": "ha'h hoora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੂਰਾ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "हह्ह हूरं ॥",
      "sourceLineId": "85985",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪੱਪ ਪੂਰੰ ॥",
      "transliteration": "pa'p poora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭਰ ਗਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "पप्प पूरं ॥",
      "sourceLineId": "85986",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗੱਗ ਗੈਣੰ ॥",
      "transliteration": "ga'g gaina(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "गग्ग गैणं ॥",
      "sourceLineId": "85987",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅੱਅ ਐਣੰ ॥੫੪੮॥",
      "transliteration": "a'a aaina(n) ||548||",
      "translation": "The sky is becoming full of heavenly damsels.548.",
      "punjabiViakhya": "ਆਕਾਸ਼ ॥੫੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "अअ्अ ऐणं ॥५४८॥",
      "sourceLineId": "85988",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬੱਬ ਬਾਣੰ ॥",
      "transliteration": "ba'b baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣ",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "बब्ब बाणं ॥",
      "sourceLineId": "85989",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤੱਤ ਤਾਣੰ ॥",
      "transliteration": "ta't taana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਣ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "तत्त ताणं ॥",
      "sourceLineId": "85990",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਛੱਛ ਛੋਰੈਂ ॥",
      "transliteration": "chha'chh chhorai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਛੱਡਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "छच्छ छोरैं ॥",
      "sourceLineId": "85991",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜੱਜ ਜੋਰੈਂ ॥੫੪੯॥",
      "transliteration": "ja'j jorai(n) ||549||",
      "translation": "The warriors are pulling bows and discharging arrows.549.",
      "punjabiViakhya": "ਜ਼ੋਰ ਨਾਲ ॥੫੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "जज्ज जोरैं ॥५४९॥",
      "sourceLineId": "85992",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬੱਬ ਬਾਜੇ ॥",
      "transliteration": "ba'b baaje ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ ਵੱਜੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "बब्ब बाजे ॥",
      "sourceLineId": "85993",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੱਗ ਗਾਜੇ ॥",
      "transliteration": "ga'g gaaje ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ) ਗਾਜ਼ੀਆਂ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "गग्ग गाजे ॥",
      "sourceLineId": "85994",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਭੱਭ ਭੂਮੰ ॥",
      "transliteration": "bha'bh bhooma(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਧਰਤੀ ਉੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "भब्भ भूमं ॥",
      "sourceLineId": "85995",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਝੱਝ ਝੂਮੰ ॥੫੫੦॥",
      "transliteration": "jha'jh jhooma(n) ||550||",
      "translation": "The musical instruments are resounding, the warriors are thundering and are falling on the ground after swinging.550.",
      "punjabiViakhya": "ਲੇਟ ਗਏ ਹਨ ॥੫੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "झज्झ झूमं ॥५५०॥",
      "sourceLineId": "85996",
      "sourceShabadId": "8009",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਨਾਦ ਛੰਦ ॥",
      "transliteration": "anaadh chha(n)dh ||",
      "translation": "ANAAD STANZA",
      "punjabiViakhya": "ਅਨਾਦ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "अनाद छंद ॥",
      "sourceLineId": "85997",
      "sourceShabadId": "8010",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚੱਲੇ ਬਾਣ ਰੁੱਕੇ ਗੈਣ ॥",
      "transliteration": "cha'le baan ru'ke gain ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰਾ ਦੇ ਚੱਲਣ ਨਾਲ ਆਕਾਸ਼ ਰੁਕ ਗਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "चल्ले बाण रुक्के गैण ॥",
      "sourceLineId": "85998",
      "sourceShabadId": "8010",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮੱਤੇ ਸੂਰ ਰੱਤੇ ਨੈਣ ॥",
      "transliteration": "ma'te soor ra'te nain ||",
      "translation": "The sky is torn with arrows and the eyes of the warriors are getting red",
      "punjabiViakhya": "(ਯੁੱਧ ਕਰਮ ਵਿੱਚ) ਮਸਤ ਸੂਰਮਿਆਂ ਦੀਆਂ ਅੱਖਾ ਲਾਲ ਹੋ ਗਈਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "मत्ते सूर रत्ते नैण ॥",
      "sourceLineId": "85999",
      "sourceShabadId": "8010",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਢੱਕੇ ਢੋਲ ਢੁੱਕੀ ਢਾਲ ॥",
      "transliteration": "dda'ke ddol ddu'kee ddaal ||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲ ਉਤੇ ਡਗੇ ਵੱਜਦੇ ਹਨ ਅਤੇ ਢਾਲ (ਵੈਰੀ ਦੇ ਵਾਲ ਨੂੰ) ਰੋਕ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "ढक्के ढोल ढुक्की ढाल ॥",
      "sourceLineId": "86000",
      "sourceShabadId": "8010",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਛੁੱਟੈ ਬਾਨ ਉੱਠੈ ਜ੍ਵਾਲ ॥੫੫੧॥",
      "transliteration": "chhu'Tai baan u'Thai javaiaal ||551||",
      "translation": "The knocking on the shields is being heard and the rising flames re being seen.551.",
      "punjabiViakhya": "ਤੀਰਾ ਦੇ (ਢਾਲਾ ਉੱਤੇ) ਵੱਜਣ ਨਾਲ (ਉਨ੍ਰਹਾ ਵਿੱਚੋਂ) ਅੱਗ ਨਿਕਲਦੀ ਹੈ ॥੫੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "छुट्टै बान उट्ठै ज्वाल ॥५५१॥",
      "sourceLineId": "86001",
      "sourceShabadId": "8010",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0257_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭਿੱਗੇ ਸ੍ਰੋਣ ਡਿੱਗੇ ਸੂਰ ॥",
      "transliteration": "bhi'ge sron ddi'ge soor ||",
      "translation": "",
      "punjabiViakhya": "ਲਹੂ ਨਾਲ ਭਿੱਜੇ ਸੂਰਮੇ (ਧਰਤੀ ਉੱਤੇ) ਡਿੱਗਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 257,
      "hindi": "",
      "hindiTransliteration": "भिग्गे स्रोण डिग्गे सूर ॥",
      "sourceLineId": "86002",
      "sourceShabadId": "8010",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
