{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 259,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0259_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਾਗੜਦੀ ਜਾਣ ਜੁਝਿ ਗਯੋ ਰਾਗੜਦੀ ਰਘੁਪਤ ਇਮ ਬੁਝਯੋ ॥੫੬੩॥",
      "transliteration": "jaagaRadhee jaan jujh gayo raagaRadhee raghupat im bujhayo ||563||",
      "translation": "The king of Raghava clan, considering him dead, became pale.563.",
      "punjabiViakhya": "ਰਾਮ ਚੰਦਰ ਨੇ ਇੰਜ ਸਮਝਿਆ ਕਿ (ਲੱਛਮਣ) ਮਾਰਿਆ ਗਿਆ ਹੈ ॥੫੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "जागड़दी जाण जुझि गयो रागड़दी रघुपत इम बुझयो ॥५६३॥",
      "sourceLineId": "86051",
      "sourceShabadId": "8012",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਰਾਮਵਤਾਰ ਲਛਮਨ ਮੂਰਛਨਾ ਭਵੇਤ ਧਿਆਇ ਸਮਾਪਤਮ ਸਤੁ ॥",
      "transliteration": "eit sree bachitr naaTake raamavataar lachhaman moorachhanaa bhavet dhiaai samaapatam sat ||",
      "translation": "End of the chapter entitled ‘Lakshman becoming Unconscious’ in Ramvtar in BACHITTAR NATAK.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਦੇ ਰਾਮਾਵਤਾਰ ਦੇ ਲੱਛਮਣ ਦੇ ਮੂਰਛਿਤ ਹੋਣ ਦਾ ਅਧਿਆਇ ਸਮਾਪਤ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटके रामवतार लछमन मूरछना भवेत धिआइ समापतम सतु ॥",
      "sourceLineId": "86052",
      "sourceShabadId": "8012",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੰਗੀਤ ਬਹੜਾ ਛੰਦ ॥",
      "transliteration": "sa(n)geet bahaRaa chha(n)dh ||",
      "translation": "SANGEET BAHRAA STANZA",
      "punjabiViakhya": "ਸੰਗੀਤ ਬਹਰਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "संगीत बहड़ा छंद ॥",
      "sourceLineId": "86053",
      "sourceShabadId": "8013",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਾਗੜਦੀ ਕਟਕ ਕਪਿ ਭਜਯੋ ਲਾਗੜਦੀ ਲਛਮਣ ਜੁੱਝਯੋ ਜਬ ॥",
      "transliteration": "kaagaRadhee kaTak kap bhajayo laagaRadhee lachhaman ju'jhayo jab ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਲੱਛਮਣ ਡਿੱਗ ਪਿਆ ਤਾ ਬੰਦਰਾ ਦੀ ਸੈਨਾ ਭੱਜ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "कागड़दी कटक कपि भजयो लागड़दी लछमण जुज्झयो जब ॥",
      "sourceLineId": "86054",
      "sourceShabadId": "8013",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰਾਗੜਦੀ ਰਾਮ ਰਿਸ ਭਰਯੋ ਸਾਗੜਦੀ ਗਹਿ ਅਸਤ੍ਰ ਸਸਤ੍ਰ ਸਭ ॥",
      "transliteration": "raagaRadhee raam ris bharayo saagaRadhee geh asatr sasatr sabh ||",
      "translation": "The force of monkeys ran helter-skelter when Lakshman fell down and catching hold of his weapons and arms in his hand Ram was highly infuriated",
      "punjabiViakhya": "ਰਾਮ ਚੰਦਰ ਨੇ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਸਾਰੇ ਅਸਤ੍ਰ-ਸ਼ਸਤ੍ਰ ਧਾਰ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "रागड़दी राम रिस भरयो सागड़दी गहि असत्र ससत्र सभ ॥",
      "sourceLineId": "86055",
      "sourceShabadId": "8013",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਧਾਗੜਦੀ ਧਉਲ ਧੜ ਹੜਯੋ ਕਾਗੜਦੀ ਕੋੜੰਭ ਕੜੱਕਯੋ ॥",
      "transliteration": "dhaagaRadhee dhaul dhaR haRayo kaagaRadhee koRa(n)bh kaRa'kayo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਮ ਦੇ ਗੁੱਸੇ ਕਾਰਨ ਧਰਤੀ ਨੂੰ ਚੁੱਕਣ ਵਾਲਾ) ਬਲਦ ਘਬਰਾ ਗਿਆ ਅਤੇ ਕਛੂ ਦੀ ਪਿੱਠ ਵੀ ਕੜਕ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "धागड़दी धउल धड़ हड़यो कागड़दी कोड़ंभ कड़क्कयो ॥",
      "sourceLineId": "86056",
      "sourceShabadId": "8013",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭਾਗੜਦੀ ਭੂੰਮਿ ਭੜਹੜੀ ਪਾਗੜਦੀ ਜਨ ਪਲੈ ਪਲੱਟਯੋ ॥੫੬੪॥",
      "transliteration": "bhaagaRadhee bhoo(n)m bhaRahaRee paagaRadhee jan palai pala'Tayo ||564||",
      "translation": "With the clattering sound of the weapons of Ram, the Bull, the support of the earth trembled and the earth shook as if the doomsday had arrived.564.",
      "punjabiViakhya": "ਧਰਤੀ (ਇਸ ਤਰ੍ਰਹਾ) ਕੰਬ ਗਈ ਮਾਨੋ ਪਰਲੋ ਨੇ ਪਲਟਾ ਦਿੱਤੀ ਹੋਵੇ ॥੫੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "भागड़दी भूँमि भड़हड़ी पागड़दी जन पलै पलट्टयो ॥५६४॥",
      "sourceLineId": "86057",
      "sourceShabadId": "8013",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਰਧ ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "aradh naraaj chha(n)dh ||",
      "translation": "ARDH NARAAJ STANZA",
      "punjabiViakhya": "ਅਰਧ-ਨਰਾਜ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "अरध नराज छंद ॥",
      "sourceLineId": "86058",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਢੀ ਸੁ ਤੇਗ ਦੁੱਧਰੰ ॥",
      "transliteration": "kaddee su teg dhu'dhara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦੋ-ਧਾਰੀ ਤਲਵਾਰ ਕੱਢ ਲਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "कढी सु तेग दुद्धरं ॥",
      "sourceLineId": "86059",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਨੂਪ ਰੂਪ ਸੁੱਭਰੰ ॥",
      "transliteration": "anoop roop su'bhara(n) ||",
      "translation": "The double-edged swords came out and Ram seemed greatly impressive",
      "punjabiViakhya": "ਜੋ ਅਨੂਪ ਰੂਪ ਨਾਲ ਸ਼ੋਭ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "अनूप रूप सुब्भरं ॥",
      "sourceLineId": "86060",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭਕਾਰ ਭੇਰ ਭੈ ਕਰੰ ॥",
      "transliteration": "bhakaar bher bhai kara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭੇਰੀਆਂ ਭਿਆਨਕ (ਆਵਾਜ਼) ਕੱਢਦੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "भकार भेर भै करं ॥",
      "sourceLineId": "86061",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਕਾਰ ਬੰਦਣੋ ਬਰੰ ॥੫੬੫॥",
      "transliteration": "bakaar ba(n)dhano bara(n) ||565||",
      "translation": "The sound of the kettle-drums was heard and the imprisoned people began to cry.565.",
      "punjabiViakhya": "ਅਤੇ ਬੰਦੀ-ਜਨ (ਭਟ) ਉੱਤਮ ਯਸ਼ ਬੋਲਦੇ ਹਨ ॥੫੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "बकार बंदणो बरं ॥५६५॥",
      "sourceLineId": "86062",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਚਿਤ੍ਰ ਚਿਤ੍ਰਤੰ ਸਰੰ ॥",
      "transliteration": "bachitr chitrata(n) sara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਦਭੁਤ ਚਿੱਤ੍ਰਕਾਰੀ ਵਾਲੇ ਤੀਰਾ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "बचित्र चित्रतं सरं ॥",
      "sourceLineId": "86063",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਜੰਤ ਤੀਖਣੋ ਨਰੰ ॥",
      "transliteration": "taja(n)t teekhano nara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧੇ ਛੱਡ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "तजंत तीखणो नरं ॥",
      "sourceLineId": "86064",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪਰੰਤ ਜੂਝਤੰ ਭਟੰ ॥",
      "transliteration": "para(n)t joojhata(n) bhaTa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ (ਇਸ ਤਰ੍ਰਹਾ) ਲੜਦੇ ਹੋਏ ਪ੍ਰਤੀਤ ਹੁੰਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "परंत जूझतं भटं ॥",
      "sourceLineId": "86065",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਣੰਕਿ ਸਾਵਣੰ ਘਟੰ ॥੫੬੬॥",
      "transliteration": "jana(n)k saavana(n) ghaTa(n) ||566||",
      "translation": "A queer scene was created and the forces of men and monkey fell on the demon forces with sharp nails like the rising clouds of the month of Sawan.566.",
      "punjabiViakhya": "ਮਾਨੋ ਸਾਵਣ ਦੀਆਂ ਕਾਲੀਆਂ ਘਟਾਵਾ ਛਾਈਆਂ ਹੋਣ ॥੫੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "जणंकि सावणं घटं ॥५६६॥",
      "sourceLineId": "86066",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਘੁਮੰਤ ਅਘ ਓਘਯੰ ॥",
      "transliteration": "ghuma(n)t agh oghaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਪਾਸੇ ਪਾਪ (ਰੂਪ ਰਾਖਸ਼) ਫਿਰ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "घुमंत अघ ओघयं ॥",
      "sourceLineId": "86067",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਦੰਤ ਬਕਤ੍ਰ ਤੇਜਯੰ ॥",
      "transliteration": "badha(n)t bakatr tejaya(n) ||",
      "translation": "The warriors are roaming on all the four sides for the destruction of sins and are challenging one another",
      "punjabiViakhya": "ਮੂੰਹ ਤੋਂ ਜੈ-ਜੈ ਬੋਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "बदंत बकत्र तेजयं ॥",
      "sourceLineId": "86068",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚਲੰਤ ਤਯਾਗਤੇ ਤਨੰ ॥",
      "transliteration": "chala(n)t tayaagate tana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਤਨ ਨੂੰ ਤਿਆਗ ਕੇ ਚਲੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "चलंत तयागते तनं ॥",
      "sourceLineId": "86069",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਭਣੰਤ ਦੇਵਤਾ ਧਨੰ ॥੫੬੭॥",
      "transliteration": "bhana(n)t dhevataa dhana(n) ||567||",
      "translation": "The brave fighters are leaving their bodies the gods are shouting “Bravo, Bravo”.567.",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੂੰ) ਦੇਵਤੇ ਧੰਨ-ਧੰਨ ਕਹਿੰਦੇ ਹਨ ॥੫੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "भणंत देवता धनं ॥५६७॥",
      "sourceLineId": "86070",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਛੁਟੰਤ ਤੀਰ ਤੀਖਣੰ ॥",
      "transliteration": "chhuTa(n)t teer teekhana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਿੱਖੇ ਤੀਰ ਚੱਲਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "छुटंत तीर तीखणं ॥",
      "sourceLineId": "86071",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਜੰਤ ਭੇਰ ਭੀਖਣੰ ॥",
      "transliteration": "baja(n)t bher bheekhana(n) ||",
      "translation": "The sharp arrows are being discharged and the terrible kettle-drums are resounding",
      "punjabiViakhya": "ਭੈ-ਦਾਇਕ ਸੁਰ ਨਾਲ ਭੋਰੀਆਂ ਵੱਜਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "बजंत भेर भीखणं ॥",
      "sourceLineId": "86072",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਉਠੰਤ ਗੱਦ ਸੱਦਣੰ ॥",
      "transliteration": "auTha(n)t ga'dh sa'dhana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਰਣ-ਭੂਮੀ ਵਿੱਚ) ਗੰਭੀਰ ਸੱਦ ਉੱਠਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "उठंत गद्द सद्दणं ॥",
      "sourceLineId": "86073",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮਸੱਤ ਜਾਣ ਮੱਦਣੰ ॥੫੬੮॥",
      "transliteration": "masa't jaan ma'dhana(n) ||568||",
      "translation": "The intoxicating sounds are being heard from all the four sides.568.",
      "punjabiViakhya": "ਜਾਣੋ (ਯੋਧੇ) ਸ਼ਰਾਬ ਨਾਲ ਮਤਵਾਲੇ ਹੋ ਰਹੇ ਹੋਣ ॥੫੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "मसत्त जाण मद्दणं ॥५६८॥",
      "sourceLineId": "86074",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਰੰਤ ਚਾਚਰੋ ਚਰੰ ॥",
      "transliteration": "kara(n)t chaacharo chara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭੱਟ ਯੱਸ਼ ਉਚਾਰ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "करंत चाचरो चरं ॥",
      "sourceLineId": "86075",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਚੰਤ ਨਿਰਤਣੋ ਹਰੰ ॥",
      "transliteration": "nacha(n)t niratano hara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਤਾਡਵ ਨਾਚ ਨੱਚ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "नचंत निरतणो हरं ॥",
      "sourceLineId": "86076",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪੁਅੰਤ ਪਾਰਬਤੀ ਸਿਰੰ ॥",
      "transliteration": "pua(n)t paarabatee sira(n) ||",
      "translation": "",
      "punjabiViakhya": "ਪਾਰਬਤੀ (ਸ਼ਿਵ ਦੇ ਗਲ ਵਿੱਚ) ਰੁੰਡ ਮਾਲਾ ਪਾ ਰਹੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "पुअंत पारबती सिरं ॥",
      "sourceLineId": "86077",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਹਸੰਤ ਪ੍ਰੇਤਣੀ ਫਿਰੰ ॥੫੬੯॥",
      "transliteration": "hasa(n)t pretanee fira(n) ||569||",
      "translation": "Shiva and his Ganas (attendants) are seen dancing and it seems that the female ghosts are laughing and bowing their heads before Parvati.569.",
      "punjabiViakhya": "ਅਤੇ ਪ੍ਰੇਤਣੀਆਂ ਹੱਸਦੀਆਂ ਫਿਰਦੀਆਂ ਹਨ ॥੫੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "हसंत प्रेतणी फिरं ॥५६९॥",
      "sourceLineId": "86078",
      "sourceShabadId": "8014",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਨੂਪ ਨਿਰਾਜ ਛੰਦ ॥",
      "transliteration": "anoop niraaj chha(n)dh ||",
      "translation": "ANOOP NIRAAJ STANZA",
      "punjabiViakhya": "ਅਨੂਪ ਨਰਾਜ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "अनूप निराज छंद ॥",
      "sourceLineId": "86079",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਡਕੰਤ ਡਾਕਣੀ ਡੁਲੰ ॥",
      "transliteration": "ddaka(n)t ddaakanee ddula(n) ||",
      "translation": "",
      "punjabiViakhya": "ਡਾਕਣੀਆਂ ਡਕਾਰਦੀਆਂ ਫਿਰਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "डकंत डाकणी डुलं ॥",
      "sourceLineId": "86080",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭ੍ਰਮੰਤ ਬਾਜ ਕੁੰਡਲੰ ॥",
      "transliteration": "bhrama(n)t baaj ku(n)ddala(n) ||",
      "translation": "The vampires are roaming and the horses are moving creating a circular spectacle",
      "punjabiViakhya": "ਘੋੜੇ ਗੋਲ ਘੇਰੇ ਵਿੱਚ ਫਿਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "भ्रमंत बाज कुँडलं ॥",
      "sourceLineId": "86081",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਰੜੰਤ ਬੰਦਿਣੋ ਕ੍ਰਿਤੰ ॥",
      "transliteration": "raRa(n)t ba(n)dhino kirata(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬੰਦੀ ਜਨ ਯਸ਼ ਪੜ੍ਰਹਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "रड़ंत बंदिणो कृतं ॥",
      "sourceLineId": "86082",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਦੰਤ ਮਾਗਯੋ ਜਯੰ ॥੫੭੦॥",
      "transliteration": "badha(n)t maagayo jaya(n) ||570||",
      "translation": "The warriors are being made prisoners and are hailing.570.",
      "punjabiViakhya": "ਭੱਟ ਲੋਕ ਜੈ-ਜੈ ਕਾਰ ਕਰਦੇ ਹਨ ॥੫੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "बदंत मागयो जयं ॥५७०॥",
      "sourceLineId": "86083",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਢਲੰਤ ਢਾਲ ਉੱਢਲੰ ॥",
      "transliteration": "ddala(n)t ddaal u'ddala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉੱਚੀਆਂ ਚੁੱਕੀਆਂ ਹੋਈਆਂ ਢਾਲਾ ਖੜਕਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "ढलंत ढाल उड्ढलं ॥",
      "sourceLineId": "86084",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਖਿਮੰਤ ਤੇਗ ਨਿਰਮਲੰ ॥",
      "transliteration": "khima(n)t teg niramala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਲ ਰਹਿਤ ਤਲਵਾਰਾ ਚਮਕਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "खिमंत तेग निरमलं ॥",
      "sourceLineId": "86085",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚਲੰਤ ਰਾਜਵੰ ਸਰੰ ॥",
      "transliteration": "chala(n)t raajava(n) sara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰਾ ਦੀਆਂ ਲੜੀਆਂ ਚੱਲ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "चलंत राजवं सरं ॥",
      "sourceLineId": "86086",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪਪਾਤ ਉਰਵੀਅੰ ਨਰੰ ॥੫੭੧॥",
      "transliteration": "papaat uraveea(n) nara(n) ||571||",
      "translation": "There are knockings of the blows of the swords on the shields and with the arrows being discharged by the kings the humans and monkeys are falling on the earth.571.",
      "punjabiViakhya": "ਸੂਰਮੇ ਧਰਤੀ ਉੱਤੇ ਡਿੱਗ ਰਹੇ ਹਨ ॥੫੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "पपात उरवीअं नरं ॥५७१॥",
      "sourceLineId": "86087",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭਜੰਤ ਆਸੁਰੀ ਸੁਤੰ ॥",
      "transliteration": "bhaja(n)t aasuree suta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਖਸ਼ਣੀਆਂ ਦੇ ਪੁੱਤਰ ਭੱਜੇ ਫਿਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "भजंत आसुरी सुतं ॥",
      "sourceLineId": "86088",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਿਲੰਕ ਬਾਨਰੀ ਪੁਤੰ ॥",
      "transliteration": "kila(n)k baanaree puta(n) ||",
      "translation": "On the other side the monkeys are shrieking",
      "punjabiViakhya": "ਬੰਦਰੀਆਂ ਦੇ ਪੁੱਤਰ ਕਿਲਕਾਰੀਆਂ ਮਾਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "किलंक बानरी पुतं ॥",
      "sourceLineId": "86089",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਜੰਤ ਤੀਰ ਤੁੱਪਕੰ ॥",
      "transliteration": "baja(n)t teer tu'paka(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ ਤੇ ਬੰਦੂਕਾ ਛੁੱਟਦੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "बजंत तीर तुप्पकं ॥",
      "sourceLineId": "86090",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਉਠੰਤ ਦਾਰੁਣੋ ਸੁਰੰ ॥੫੭੨॥",
      "transliteration": "auTha(n)t dhaaruno sura(n) ||572||",
      "translation": "On account of what the demons are fleeing   the sounds of arrows and other weapons are creating the terrible and tumultuous resonance.572.",
      "punjabiViakhya": "ਭਿਆਨਕ ਆਵਾਜ਼ ਨਿਕਲ ਰਹੀ ਹੈ ॥੫੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "उठंत दारुणो सुरं ॥५७२॥",
      "sourceLineId": "86091",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭਭੱਕ ਭੂਤ ਭੈ ਕਰੰ ॥",
      "transliteration": "bhabha'k bhoot bhai kara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭਿਆਨਕ ਭੂਤ ਭਭਕ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "भभक्क भूत भै करं ॥",
      "sourceLineId": "86092",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਚਚੱਕ ਚਉਦਣੋ ਚਕੰ ॥",
      "transliteration": "chacha'k chaudhano chaka(n) ||",
      "translation": "The groups of ghosts are feeling frightened and perplexed",
      "punjabiViakhya": "ਚੌਦਾ ਲੋਕ ਚਕ੍ਰਿਤ ਹੋ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "चचक्क चउदणो चकं ॥",
      "sourceLineId": "86093",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਤੱਖ ਪੱਖਰੰ ਤੁਰੇ ॥",
      "transliteration": "tata'kh pa'khara(n) ture ||",
      "translation": "",
      "punjabiViakhya": "ਝੁੱਲਾ ਵਾਲੇ ਘੋੜੇ ਤੜਫ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "ततक्ख पक्खरं तुरे ॥",
      "sourceLineId": "86094",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਜੇ ਨਿਨੱਦ ਸਿੰਧੁਰੇ ॥੫੭੩॥",
      "transliteration": "baje nina'dh si(n)dhure ||573||",
      "translation": "The armoured horses and roaring elephants are moving in the battlefield.573.",
      "punjabiViakhya": "ਰਣ-ਸਿੰਘੇ ਲਗਾਤਾਰ ਵੱਜ ਰਹੇ ਹਨ ॥੫੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "बजे निनद्द सिंधुरे ॥५७३॥",
      "sourceLineId": "86095",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਉਠੰਤ ਭੈ ਕਰੀ ਸਰੰ ॥",
      "transliteration": "auTha(n)t bhai karee sara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿੱਚ ਡਰਾਉਣੀ ਆਵਾਜ਼ ਹੋ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "उठंत भै करी सरं ॥",
      "sourceLineId": "86096",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮਚੰਤ ਜੋਧਣੇ ਜੁਧੰ ॥",
      "transliteration": "macha(n)t jodhane judha(n) ||",
      "translation": "The gods are also becoming fearful on seeing the terrible war of the warriors",
      "punjabiViakhya": "ਸੂਰਮੇ ਯੁੱਧ ਨੂੰ ਮਚਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "मचंत जोधणे जुधं ॥",
      "sourceLineId": "86097",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0259_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਖਿਮੰਤ ਉੱਜਲੀਅਸੰ ॥",
      "transliteration": "khima(n)t u'jaleeasa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਜਲੀਆਂ ਤਲਵਾਰਾ ਚਮਕ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": "खिमंत उज्जलीअसं ॥",
      "sourceLineId": "86098",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
