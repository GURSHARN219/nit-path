{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 260,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0260_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਬਰਖ ਤੀਖਣੋ ਸਰੰ ॥੫੭੪॥",
      "transliteration": "babarakh teekhano sara(n) ||574||",
      "translation": "The white swords and sharp arrows are being showered.574.",
      "punjabiViakhya": "ਤਿੱਖੇ ਤੀਰਾ ਦੀ ਬਰਖਾ ਹੋ ਰਹੀ ਹੈ ॥੫੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "बबरख तीखणो सरं ॥५७४॥",
      "sourceLineId": "86099",
      "sourceShabadId": "8015",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੰਗੀਤ ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "sa(n)geet bhuja(n)g prayaat chha(n)dh ||",
      "translation": "SANGEET BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਸੰਗੀਤ ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "संगीत भुजंग प्रयात छंद ॥",
      "sourceLineId": "86100",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਾਗੜਦੰਗ ਜੁੱਝਯੋ ਭਾਗੜਦੰਗ ਭ੍ਰਾਤੰ ॥",
      "transliteration": "jaagaRadha(n)g ju'jhayo bhaagaRadha(n)g bhraata(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦੋਂ ਛੋਟਾ) ਭਰਾ ਮੂਰਛਿਤ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "जागड़दंग जुज्झयो भागड़दंग भ्रातं ॥",
      "sourceLineId": "86101",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਾਗੜਦੰਗ ਰਾਮੰ ਤਾਗੜਦੰਗ ਤਾਤੰ ॥",
      "transliteration": "raagaRadha(n)g raama(n) taagaRadha(n)g taata(n) ||",
      "translation": "Ram saw his brother Lakshman fighting,",
      "punjabiViakhya": "(ਤਾ ਰਾਮ ਚੰਦਰ ਨੇ) ਤੁਰਤ",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "रागड़दंग रामं तागड़दंग तातं ॥",
      "sourceLineId": "86102",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਾਗੜਦੰਗ ਬਾਣੰ ਛਾਗੜਦੰਗ ਛੋਰੇ ॥",
      "transliteration": "baagaRadha(n)g baana(n) chhaagaRadha(n)g chhore ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਤੀਰ ਛੱਡੇ",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "बागड़दंग बाणं छागड़दंग छोरे ॥",
      "sourceLineId": "86103",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਆਗੜਦੰਗ ਆਕਾਸ ਤੇ ਜਾਨ ਓਰੇ ॥੫੭੫॥",
      "transliteration": "aagaRadha(n)g aakaas te jaan ore ||575||",
      "translation": "And he discharged the arrows touching the sky.575.",
      "punjabiViakhya": "ਮਾਨੋ ਆਕਾਸ਼ ਤੋਂ ਗੜ੍ਰਹੇ ਪੈ ਰਹੇ ਹੋਣ ॥੫੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "आगड़दंग आकास ते जान ओरे ॥५७५॥",
      "sourceLineId": "86104",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਾਗੜਦੰਗ ਬਾਜੀ ਰਥੀ ਬਾਣ ਕਾਟੇ ॥",
      "transliteration": "baagaRadha(n)g baajee rathee baan kaaTe ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਮ ਚੰਦਰ ਦੇ) ਬਾਣਾ ਨੇ ਘੋੜਿਆਂ ਵਾਲੇ ਅਤੇ ਰਥਾ ਵਾਲੇ (ਸੂਰਮੇ) ਕੱਟ ਸੁੱਟੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "बागड़दंग बाजी रथी बाण काटे ॥",
      "sourceLineId": "86105",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗਾਗੜਦੰਗ ਗਾਜੀ ਗਜੀ ਵੀਰ ਡਾਟੇ ॥",
      "transliteration": "gaagaRadha(n)g gaajee gajee veer ddaaTe ||",
      "translation": "These arrows chopped the riders on chariots and horses, but still the warriors stood firmly in the field",
      "punjabiViakhya": "ਅਤੇ ਗਾਜ਼ੀ ਤੇ ਹਾਥੀਆਂ ਵਾਲੇ ਯੋਧੇ ਵੀ ਡਰਾ ਦਿੱਤੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "गागड़दंग गाजी गजी वीर डाटे ॥",
      "sourceLineId": "86106",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਾਗੜਦੰਗ ਮਾਰੇ ਸਾਗੜਦੰਗ ਸੂਰੰ ॥",
      "transliteration": "maagaRadha(n)g maare saagaRadha(n)g soora(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ ਸੂਰਮੇ) ਮਾਰੇ ਗਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "मागड़दंग मारे सागड़दंग सूरं ॥",
      "sourceLineId": "86107",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਾਗੜਦੰਗ ਬਯਾਹੈਂ ਹਾਗੜਦੰਗ ਹੂਰੰ ॥੫੭੬॥",
      "transliteration": "baagaRadha(n)g bayaahai(n) haagaRadha(n)g hoora(n) ||576||",
      "translation": "Ram killed the brave fighters who were wedded by the heavenly damsels.576.",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੂੰ) ਹੂਰਾ ਵਿਆਹ ਰਹੀਆਂ ਹਨ ॥੫੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "बागड़दंग बयाहैं हागड़दंग हूरं ॥५७६॥",
      "sourceLineId": "86108",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਾਗੜਦੰਗ ਜੀਤਾ ਖਾਗੜਦੰਗ ਖੇਤੰ ॥",
      "transliteration": "jaagaRadha(n)g jeetaa khaagaRadha(n)g kheta(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਮ ਚੰਦਰ ਨੇ) ਰਣ-ਭੂਮੀ) ਨੂੰ ਜਿੱਤ ਲਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "जागड़दंग जीता खागड़दंग खेतं ॥",
      "sourceLineId": "86109",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਾਗੜਦੰਗ ਭਾਗੇ ਕਾਗੜਦੰਗ ਕੇਤੰ ॥",
      "transliteration": "bhaagaRadha(n)g bhaage kaagaRadha(n)g keta(n) ||",
      "translation": "In this way the war was conquered and in this war many warriors fled away",
      "punjabiViakhya": "ਅਨੇਕਾ (ਵੈਰੀ) ਭੱਜ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "भागड़दंग भागे कागड़दंग केतं ॥",
      "sourceLineId": "86110",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਾਗੜਦੰਗ ਸੂਰਾਨੁ ਜੁੰਆਨ ਪੇਖਾ ॥",
      "transliteration": "saagaRadha(n)g sooraan ju(n)aan pekhaa ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਸੂਰਵੀਰ ਛੋਟੇ ਭਰਾ ਨੂੰ ਆ ਕੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "सागड़दंग सूरानु जुँआन पेखा ॥",
      "sourceLineId": "86111",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪਾਗੜਦੰਗ ਪ੍ਰਾਨਾਨ ਤੇ ਪ੍ਰਾਨ ਲੇਖਾ ॥੫੭੭॥",
      "transliteration": "paagaRadha(n)g praanaan te praan lekhaa ||577||",
      "translation": "Wherever the brave fighters saw one another, they cleared the account only on sacrificing their lives.577.",
      "punjabiViakhya": "(ਜੋ) ਪ੍ਰਾਣਾ ਤੋਂ ਵੀ ਪਿਆਰਾ ਜਾਣਿਆ ਜਾਦਾ ਸੀ ॥੫੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "पागड़दंग प्रानान ते प्रान लेखा ॥५७७॥",
      "sourceLineId": "86112",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚਾਗੜਦੰਗ ਚਿੰਤੰ ਪਾਗੜਦੰਗ ਪ੍ਰਾਜੀ ॥",
      "transliteration": "chaagaRadha(n)g chi(n)ta(n) paagaRadha(n)g praajee ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਵਿੱਚ (ਰਾਮ ਚੰਦਰ ਦੀ) ਹਾਰ ਦੀ ਗੱਲ ਸੋਚ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "चागड़दंग चिंतं पागड़दंग प्राजी ॥",
      "sourceLineId": "86113",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਾਗੜਦੰਗ ਸੈਨਾ ਲਾਗੜਦੰਗ ਲਾਜੀ ॥",
      "transliteration": "saagaRadha(n)g sainaa laagaRadha(n)g laajee ||",
      "translation": "The army felt ashamed on remembering the defeat",
      "punjabiViakhya": "(ਬੰਦਰਾ ਦੀ) ਸੈਨਾ ਲੱਜਾਵਾਨ ਹੋਈ।",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "सागड़दंग सैना लागड़दंग लाजी ॥",
      "sourceLineId": "86114",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਾਗੜਦੰਗ ਸੁਗ੍ਰੀਵ ਤੇ ਆਦਿ ਲੈ ਕੈ ॥",
      "transliteration": "saagaRadha(n)g sugreev te aadh lai kai ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਗ੍ਰੀਵ ਆਦਿ ਤੋਂ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "सागड़दंग सुग्रीव ते आदि लै कै ॥",
      "sourceLineId": "86115",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਾਗੜਦੰਗ ਕੋਪੇ ਤਾਗੜਦੰਗ ਤੈ ਕੈ ॥੫੭੮॥",
      "transliteration": "kaagaRadha(n)g kope taagaRadha(n)g tai kai ||578||",
      "translation": "Sugriva and others got highly enraged.578.",
      "punjabiViakhya": "(ਸਾਰੇ ਸੈਨਿਕ) ਕ੍ਰੋਧ ਨਾਲ ਤੱਤੇ ਹੋ ਗਏ ॥੫੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "कागड़दंग कोपे तागड़दंग तै कै ॥५७८॥",
      "sourceLineId": "86116",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹਾਗੜਦੰਗ ਹਨੂ ਕਾਗੜਦੰਗ ਕੋਪਾ ॥",
      "transliteration": "haagaRadha(n)g hanoo kaagaRadha(n)g kopaa ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦੋਂ) ਹਨੂਮਾਨ ਨੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "हागड़दंग हनू कागड़दंग कोपा ॥",
      "sourceLineId": "86117",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਾਗੜਦੰਗ ਬੀਰਾ ਨਮੋ ਪਾਵ ਰੋਪਾ ॥",
      "transliteration": "baagaRadha(n)g beeraa namo paav ropaa ||",
      "translation": "Hanuman was also greatly infuriated and he stood firmly in the battlefield",
      "punjabiViakhya": "ਰਣ-ਖੇਤਰ ਵਿੱਚ ਪੈਰ ਜਮਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "बागड़दंग बीरा नमो पाव रोपा ॥",
      "sourceLineId": "86118",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਾਗੜਦੰਗ ਸੂਰੰ ਹਾਗੜਦੰਗ ਹਾਰੇ ॥",
      "transliteration": "saagaRadha(n)g soora(n) haagaRadha(n)g haare ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦੋਂ ਬੂਟੀ ਲਿਆਣੇ ਸਾਰੇ) ਸੂਰਮੇ ਹਾਰ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "सागड़दंग सूरं हागड़दंग हारे ॥",
      "sourceLineId": "86119",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਾਗੜਦੰਗ ਤੈ ਕੈ ਹਨੂ ਤਉ ਪੁਕਾਰੇ ॥੫੭੯॥",
      "transliteration": "taagaRadha(n)g tai kai hanoo tau pukaare ||579||",
      "translation": "All those who fought with him suffered defeat and for this reason Hanuman is called the “killer of all”.579.",
      "punjabiViakhya": "ਤਾ ਗੁੱਸਾ ਖਾ ਕੇ ਹਨੂਮਾਨ ਕਹਿਣ ਲੱਗਾ ॥੫੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "तागड़दंग तै कै हनू तउ पुकारे ॥५७९॥",
      "sourceLineId": "86120",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਾਗੜਦੰਗ ਸੁਨਹੋ ਰਾਗੜਦੰਗ ਰਾਮੰ ॥",
      "transliteration": "saagaRadha(n)g sunaho raagaRadha(n)g raama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਮ ਜੀ! ਸੁਣੋ (ਜੇ ਤੁਸੀਂ ਆਪਣੇ)",
      "source": "DASAM_GRANTH",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": "सागड़दंग सुनहो रागड़दंग रामं ॥",
      "sourceLineId": "86121",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0260_line_0024",
      "lineIndex": 24,
