{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 261,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0261_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪਾਗੜਦੰਗ ਪੀਠੰ ਠਾਗੜਦੰਗ ਠੋਕੋ ॥",
      "transliteration": "paagaRadha(n)g peeTha(n) ThaagaRadha(n)g Thoko ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੀ ਪਿੱਠ ਠੋਕ ਦਿਓ (ਤਾ ਬੂਟੀ ਦੀ ਕੀ ਗੱਲ)",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "पागड़दंग पीठं ठागड़दंग ठोको ॥",
      "sourceLineId": "86123",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਹਰੋ ਆਜ ਪਾਨੰ ਸੁਰੰ ਮੋਹ ਲੋਕੋ ॥੫੮੦॥",
      "transliteration": "haro aaj paana(n) sura(n) moh loko ||580||",
      "translation": "“By patting me on my back and I shall conquer all the abodes of gods today.”580.",
      "punjabiViakhya": "ਮੈਂ ਅੱਜ ਸੁਅਰਗ ਲੋਕ ਵਿੱਚੋਂ ਦੇਵਤਿਆਂ ਕੋਲੋਂ ਅੰਮ੍ਰਿਤ ਵੀ ਖੋਹ ਲਿਆਵਾ ॥੫੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "हरो आज पानं सुरं मोह लोको ॥५८०॥",
      "sourceLineId": "86124",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਆਗੜਦੰਗ ਐਸੇ ਕਹਯੋ ਅਉ ਉਡਾਨੋ ॥",
      "transliteration": "aagaRadha(n)g aaise kahayo aau uddaano ||",
      "translation": "",
      "punjabiViakhya": "(ਹਨੂਮਾਨ ਨੇ) ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ਅਤੇ ਉੱਡ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "आगड़दंग ऐसे कहयो अउ उडानो ॥",
      "sourceLineId": "86125",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗਾਗੜਦੰਗ ਗੈਨੰ ਮਿਲਯੋ ਮੱਧ ਮਾਨੋ ॥",
      "transliteration": "gaagaRadha(n)g gaina(n) milayo ma'dh maano ||",
      "translation": "Uttering these words Hanuman flew and it seemed that he had become one with the sky.",
      "punjabiViakhya": "ਮਾਨੋ ਝੱਟ ਹੀ ਆਕਾਸ਼ ਵਿੱਚ ਹੀ ਮਿਲ ਗਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "गागड़दंग गैनं मिलयो मद्ध मानो ॥",
      "sourceLineId": "86126",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰਾਗੜਦੰਗ ਰਾਮੰ ਆਗੜਦੰਗ ਆਸੰ ॥",
      "transliteration": "raagaRadha(n)g raama(n) aagaRadha(n)g aasa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨਿਰਾਸ਼ ਬੈਠੇ ਰਾਮ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "रागड़दंग रामं आगड़दंग आसं ॥",
      "sourceLineId": "86127",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਾਗੜਦੰਗ ਬੈਠੇ ਨਾਗੜਦੰਗ ਨਿਰਾਸੰ ॥੫੮੧॥",
      "transliteration": "baagaRadha(n)g baiThe naagaRadha(n)g niraasa(n) ||581||",
      "translation": "Ram sat down disappointed, keeping the hope in his mind.581.",
      "punjabiViakhya": "ਲੱਛਮਣ ਦੇ ਜਿਊਣ ਦੀ ਆਸ ਹੋ ਗਈ ॥੫੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "बागड़दंग बैठे नागड़दंग निरासं ॥५८१॥",
      "sourceLineId": "86128",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਆਗੜਦੰਗ ਆਗੇ ਕਾਗੜਦੰਗ ਕੋਊ ॥",
      "transliteration": "aagaRadha(n)g aage kaagaRadha(n)g kouoo ||",
      "translation": "",
      "punjabiViakhya": "(ਹਨੂਮਾਨ ਦੇ) ਅੱਗੇ ਜੋ ਕੋਈ (ਆਇਆ)",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "आगड़दंग आगे कागड़दंग कोऊ ॥",
      "sourceLineId": "86129",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮਾਗੜਦੰਗ ਮਾਰੇ ਸਾਗੜਦੰਗ ਸੋਊ ॥",
      "transliteration": "maagaRadha(n)g maare saagaRadha(n)g souoo ||",
      "translation": "Whosoever came in front of Hanuman, he killed him,",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "मागड़दंग मारे सागड़दंग सोऊ ॥",
      "sourceLineId": "86130",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਗੜਦੰਗ ਨਾਕੀ ਤਾਗੜਦੰਗ ਤਾਲੰ ॥",
      "transliteration": "naagaRadha(n)g naakee taagaRadha(n)g taala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਾਉ ਵਿੱਚ (ਇਕ) ਵਿਸ਼ਾਲ ਤੰਦੂਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "नागड़दंग नाकी तागड़दंग तालं ॥",
      "sourceLineId": "86131",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਾਗੜਦੰਗ ਮਾਰੇ ਬਾਗੜਦੰਗ ਬਿਸਾਲੰ ॥੫੮੨॥",
      "transliteration": "maagaRadha(n)g maare baagaRadha(n)g bisaala(n) ||582||",
      "translation": "And thus killing (the forces) he reached on the bank of a tank.582.",
      "punjabiViakhya": "(ਉਸ ਨੂੰ ਵੀ ਹਨੂਮਾਨ ਨੇ) ਮਾਰ ਦਿੱਤਾ ॥੫੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "मागड़दंग मारे बागड़दंग बिसालं ॥५८२॥",
      "sourceLineId": "86132",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਆਗੜਦੰਗ ਏਕੰ ਦਾਗੜਦੰਗ ਦਾਨੋ ॥",
      "transliteration": "aagaRadha(n)g eka(n) dhaagaRadha(n)g dhaano ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਾਨੇ (ਜੋ ਮੁਨੀ ਦੇ ਭੇਸ ਵਿੱਚ) ਲੁਕਿਆ ਹੋਇਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "आगड़दंग एकं दागड़दंग दानो ॥",
      "sourceLineId": "86133",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਚਾਗੜਦੰਗ ਚੀਰਾ ਦਾਗੜਦੰਗ ਦੁਰਾਨੋ ॥",
      "transliteration": "chaagaRadha(n)g cheeraa dhaagaRadha(n)g dhuraano ||",
      "translation": "There a terrible-looking demon was hiding",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੀ (ਹਨੂਮਾਨ ਨੇ) ਚੀਰ ਸੁੱਟਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "चागड़दंग चीरा दागड़दंग दुरानो ॥",
      "sourceLineId": "86134",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦਾਗੜਦੰਗ ਦੋਖੀ ਬਾਗੜਦੰਗ ਬੂਟੀ ॥",
      "transliteration": "dhaagaRadha(n)g dhokhee baagaRadha(n)g booTee ||",
      "translation": "",
      "punjabiViakhya": "(ਅੱਗੇ ਜਾ ਕੇ) ਬੂਟੀਆਂ ਵੇਖੀਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "दागड़दंग दोखी बागड़दंग बूटी ॥",
      "sourceLineId": "86135",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਆਗੜਦੰਗ ਹੈ ਏਕ ਤੇ ਏਕ ਜੂਟੀ ॥੫੮੩॥",
      "transliteration": "aagaRadha(n)g hai ek te ek jooTee ||583||",
      "translation": "And at the same place Hanuman saw many herbs clustered with one another.583.",
      "punjabiViakhya": "ਜੋ ਇਕ ਨਾਲ ਇਕ ਜੁੜੀ ਹੋਈ ਸੀ ॥੫੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "आगड़दंग है एक ते एक जूटी ॥५८३॥",
      "sourceLineId": "86136",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚਾਗੜਦੰਗ ਚਉਕਾ ਹਾਗੜਦੰਗ ਹਨਵੰਤਾ ॥",
      "transliteration": "chaagaRadha(n)g chaukaa haagaRadha(n)g hanava(n)taa ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾਨ ਤੇਜ ਵਾਲਾ ਯੋਧਾ ਹਨੂਮਾਨ (ਸਾਰੀਆਂ ਬੂਟੀਆਂ ਨੂੰ ਦੇਖ ਕੇ)",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "चागड़दंग चउका हागड़दंग हनवंता ॥",
      "sourceLineId": "86137",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਾਗੜਦੰਗ ਜੋਧਾ ਮਹਾ ਤੇਜ ਮੰਤਾ ॥",
      "transliteration": "jaagaRadha(n)g jodhaa mahaa tej ma(n)taa ||",
      "translation": "The highly radiant Hanuman, seeing this, was perturbed and felt confused about the herb to be taken away",
      "punjabiViakhya": "ਚੌਂਕਿਆ (ਅਤੇ ਸੋਚੀਂ ਪੈ ਗਿਆ ਕਿ ਕਿਹੜੀ ਬੂਟੀ ਲੈ ਕੇ ਜਾਵਾ,",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "जागड़दंग जोधा महा तेज मंता ॥",
      "sourceLineId": "86138",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਆਗੜਦੰਗ ਉਖਾਰਾ ਪਾਗੜਦੰਗ ਪਹਾਰੰ ॥",
      "transliteration": "aagaRadha(n)g ukhaaraa paagaRadha(n)g pahaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ) ਪਹਾੜ ਹੀ ਪੁੱਟ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "आगड़दंग उखारा पागड़दंग पहारं ॥",
      "sourceLineId": "86139",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਆਗੜਦੰਗ ਲੈ ਅਉਖਧੀ ਕੋ ਸਿਧਾਰੰ ॥੫੮੪॥",
      "transliteration": "aagaRadha(n)g lai aaukhadhee ko sidhaara(n) ||584||",
      "translation": "He uprooted the whole mountain and returned with the medicinal herbs.584.",
      "punjabiViakhya": "ਅਤੇ (ਇਉਾਂ) ਬੂਟੀ ਲੈ ਕੇ ਚਲ ਪਿਆ ॥੫੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "आगड़दंग लै अउखधी को सिधारं ॥५८४॥",
      "sourceLineId": "86140",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਆਗੜਦੰਗ ਆਏ ਜਹਾ ਰਾਮ ਖੇਤੰ ॥",
      "transliteration": "aagaRadha(n)g aae jahaa raam kheta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੀ ਰਾਮ ਜੀ ਜਿੱਥੇ ਰਣ-ਭੂਮੀ ਵਿੱਚ ਬੈਠੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "आगड़दंग आए जहा राम खेतं ॥",
      "sourceLineId": "86141",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਾਗੜਦੰਗ ਬੀਰੰ ਜਹਾ ਤੇ ਅਚੇਤੰ ॥",
      "transliteration": "baagaRadha(n)g beera(n) jahaa te acheta(n) ||",
      "translation": "He reached that battlefield with the mountain where Lakshman was lying unconscious",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਦਾ ਵੀਰ ਬੇਸੁੱਧ ਪਿਆ ਸੀ, (ਹਨੂਮਾਨ ਪਹਾੜ ਸਮੇਤ) ਉਥੇ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "बागड़दंग बीरं जहा ते अचेतं ॥",
      "sourceLineId": "86142",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਾਗੜਦੰਗ ਬਿਸੱਲਯਾ ਮਾਗੜਦੰਗ ਮੁੱਖੰ ॥",
      "transliteration": "baagaRadha(n)g bisa'layaa maagaRadha(n)g mu'kha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ ਮੂੰਹ ਵਿੱਚ) 'ਬਿਸਰਯਾ' ਬੂਟੀ ਪਾ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "बागड़दंग बिसल्लया मागड़दंग मुक्खं ॥",
      "sourceLineId": "86143",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਡਾਗੜਦੰਗ ਡਾਰੀ ਸਾਗੜਦੰਗ ਸੁੱਖੰ ॥੫੮੫॥",
      "transliteration": "ddaagaRadha(n)g ddaaree saagaRadha(n)g su'kha(n) ||585||",
      "translation": "The apothecary Sushan put the required herb in the month of Lakshman.585.",
      "punjabiViakhya": "(ਜਿਸ ਨਾਲ ਉਹ) ਸੁਖੀ ਹੋ ਗਿਆ ॥੫੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "डागड़दंग डारी सागड़दंग सुक्खं ॥५८५॥",
      "sourceLineId": "86144",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਾਗੜਦੰਗ ਜਾਗੇ ਸਾਗੜਦੰਗ ਸੂਰੰ ॥",
      "transliteration": "jaagaRadha(n)g jaage saagaRadha(n)g soora(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਲੱਛਮਣ ਦੇ ਸੁਖੀ ਹੋਣ ਨਾਲ) ਸਾਰੇ ਸੂਰਮੇ ਜਾਗ ਪਏ",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "जागड़दंग जागे सागड़दंग सूरं ॥",
      "sourceLineId": "86145",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਘਾਗੜਦੰਗ ਘੁੱਮੀ ਹਾਗੜਦੰਗ ਹੂਰੰ ॥",
      "transliteration": "ghaagaRadha(n)g ghu'mee haagaRadha(n)g hoora(n) ||",
      "translation": "The mighty warrior Lakshman regained his senses and the roaming heavenly damsels went back",
      "punjabiViakhya": "ਅਤੇ ਹੂਰਾ (ਆਕਾਸ਼ ਵਿੱਚ) ਘੁੰਮਣ ਲੱਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "घागड़दंग घुम्मी हागड़दंग हूरं ॥",
      "sourceLineId": "86146",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਛਾਗੜਦੰਗ ਛੂਟੇ ਨਾਗੜਦੰਗ ਨਾਦੰ ॥",
      "transliteration": "chhaagaRadha(n)g chhooTe naagaRadha(n)g naadha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨਾਦ ਨਿਕਲਣ ਲੱਗ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "छागड़दंग छूटे नागड़दंग नादं ॥",
      "sourceLineId": "86147",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਾਗੜਦੰਗ ਬਾਜੇ ਨਾਗੜਦੰਗ ਨਾਦੰ ॥੫੮੬॥",
      "transliteration": "baagaRadha(n)g baaje naagaRadha(n)g naadha(n) ||586||",
      "translation": "The great trumpets resounded in the battlefield.586.",
      "punjabiViakhya": "ਨਗਾਰਿਆਂ ਅਤੇ ਵਾਜਿਆਂ ਵਿੱਚੋਂ ॥੫੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "बागड़दंग बाजे नागड़दंग नादं ॥५८६॥",
      "sourceLineId": "86148",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਾਗੜਦੰਗ ਤੀਰੰ ਛਾਗੜਦੰਗ ਛੂਟੇ ॥",
      "transliteration": "taagaRadha(n)g teera(n) chhaagaRadha(n)g chhooTe ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ ਚਲਣ ਲੱਗ ਪਏ",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "तागड़दंग तीरं छागड़दंग छूटे ॥",
      "sourceLineId": "86149",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗਾਗੜਦੰਗ ਗਾਜੀ ਜਾਗੜਦੰਗ ਜੁਟੇ ॥",
      "transliteration": "gaagaRadha(n)g gaajee jaagaRadha(n)g juTe ||",
      "translation": "The arrows were discharged and the warriors began to fight again with one another.",
      "punjabiViakhya": "ਅਤੇ ਗਾਜ਼ੀ (ਲੋਕ ਯੁੱਧ ਵਿੱਚ) ਜੁੱਟ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "गागड़दंग गाजी जागड़दंग जुटे ॥",
      "sourceLineId": "86150",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਖਾਗੜਦੰਗ ਖੇਤੰ ਸਾਗੜਦੰਗ ਸੋਏ ॥",
      "transliteration": "khaagaRadha(n)g kheta(n) saagaRadha(n)g soe ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਰਣ-ਭੂਮੀ ਵਿੱਚ (ਬੇਸੁੱਧ) ਸੁੱਤੇ ਪਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "खागड़दंग खेतं सागड़दंग सोए ॥",
      "sourceLineId": "86151",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪਾਗੜਦੰਗ ਤੇ ਪਾਕ ਸਾਹੀਦ ਹੋਏ ॥੫੮੭॥",
      "transliteration": "paagaRadha(n)g te paak saaheedh hoe ||587||",
      "translation": "The brave fighters dying in the battlefield became true martyrs.587.",
      "punjabiViakhya": "ਓਹੀ ਪਵਿੱਤਰ ਸ਼ਹੀਦ ਹੋਏ ਹਨ ॥੫੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "पागड़दंग ते पाक साहीद होए ॥५८७॥",
      "sourceLineId": "86152",
      "sourceShabadId": "8016",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਲਸ ॥",
      "transliteration": "kalas ||",
      "translation": "KALAS",
      "punjabiViakhya": "ਕਲਸ:",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "कलस ॥",
      "sourceLineId": "86153",
      "sourceShabadId": "8017",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮੱਚੇ ਸੂਰਬੀਰ ਬਿਕ੍ਰਾਰੰ ॥",
      "transliteration": "ma'che soorabeer bikraara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਚੰਡ ਸੂਰਬੀਰ (ਆਪਸ ਵਿੱਚ) ਗੁੱਥਮ-ਗੁੱਥਾ ਹੋ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "मच्चे सूरबीर बिक्रारं ॥",
      "sourceLineId": "86154",
      "sourceShabadId": "8017",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨੱਚੇ ਭੂਤ ਪ੍ਰੇਤ ਬੈਤਾਰੰ ॥",
      "transliteration": "na'che bhoot pret baitaara(n) ||",
      "translation": "The terrible warriors were absorbed in fighting the ghosts, fiends and Baitals began to dance",
      "punjabiViakhya": "ਭੂਤ ਪ੍ਰੇਤ ਅਤੇ ਬੈਤਾਲ (ਰਣ-ਭੂਮੀ ਵਿੱਚ) ਨਚ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "नच्चे भूत प्रेत बैतारं ॥",
      "sourceLineId": "86155",
      "sourceShabadId": "8017",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਝਮਝਮ ਲਸਤ ਕੋਟਿ ਕਰਵਾਰੰ ॥",
      "transliteration": "jhamajham lasat koT karavaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਰੋੜਾ ਤਲਵਾਰਾ ਝਮ-ਝਮ ਕਰਕੇ ਲਿਸ਼ਕਣ ਲੱਗੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "झमझम लसत कोटि करवारं ॥",
      "sourceLineId": "86156",
      "sourceShabadId": "8017",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਝਲਹਲੰਤ ਉੱਜਲ ਅਸਿ ਧਾਰੰ ॥੫੮੮॥",
      "transliteration": "jhalahala(n)t u'jal as dhaara(n) ||588||",
      "translation": "The blows were struck with many hands creating knocking sounds and the white edges of the swords glittered.588.",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਨਾ ਦੀਆਂ ਚਿੱਟੀਆਂ ਧਾਰਾਵਾ ਹਿਲਦੀਆਂ ਹੋਈਆਂ ਝਿਲਮਿਲ ਕਰਦੀਆਂ ਹਨ ॥੫੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "झलहलंत उज्जल असि धारं ॥५८८॥",
      "sourceLineId": "86157",
      "sourceShabadId": "8017",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤ੍ਰਿਭੰਗੀ ਛੰਦ ॥",
      "transliteration": "tirabha(n)gee chha(n)dh ||",
      "translation": "TRIBHANGI STANZA",
      "punjabiViakhya": "ਤ੍ਰਿਭੰਗੀ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "तृभंगी छंद ॥",
      "sourceLineId": "86158",
      "sourceShabadId": "8018",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਉੱਜਲ ਅਸ ਧਾਰੰ ਲਸਤ ਅਪਾਰੰ ਕਰਣ ਲੁਝਾਰੰ ਛਬਿ ਧਾਰੰ ॥",
      "transliteration": "au'jal as dhaara(n) lasat apaara(n) karan lujhaara(n) chhab dhaara(n) ||",
      "translation": "The white edges of the swords, increasing splendour, looked impressive",
      "punjabiViakhya": "ਤਲਵਾਰ ਦੀ ਚਿੱਟੀ ਧਾਰ ਬਹੁਤ ਅਧਿਕ ਲਿਸ਼ਕਦੀ ਹੈ ਅਤੇ ਲੜਾਈ ਕਰਨ ਵਾਲੀ ਤਦੇ ਸੁੰਦਰਤਾ ਨੂੰ ਧਾਰਨ ਕਰਨ ਵਾਲੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "उज्जल अस धारं लसत अपारं करण लुझारं छबि धारं ॥",
      "sourceLineId": "86159",
      "sourceShabadId": "8018",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੋਭਿਤ ਜਿਮੁ ਆਰੰ ਅਤ ਛਬਿ ਧਾਰੰ ਸੁ ਬਧ ਸੁਧਾਰੰ ਅਰ ਗਾਰੰ ॥",
      "transliteration": "sobhit jim aara(n) at chhab dhaara(n) su badh sudhaara(n) ar gaara(n) ||",
      "translation": "These sword are the destroyers of the enemies and appear like saws",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਨੇਕ ਸੂਏ ਵਾਗ ਸ਼ੋਭਦੀ ਹੈ। ਵੱਡੀ ਛਬੀ ਨੂੰ ਧਾਰਦੀ ਹੈ, ਚੰਗੇ ਉਪਾਅ ਬਣਾਉਣ ਵਾਲੀ ਹੈ ਅਤੇ ਵੈਰੀ ਨੂੰ ਗਾਲਣ ਵਾਲੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "सोभित जिमु आरं अत छबि धारं सु बध सुधारं अर गारं ॥",
      "sourceLineId": "86160",
      "sourceShabadId": "8018",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜੈਪੱਤ੍ਰੰ ਦਾਤੀ ਮਦਿਣੰ ਮਾਤੀ ਸ੍ਰੋਣੰ ਰਾਤੀ ਜੈ ਕਰਣੰ ॥",
      "transliteration": "jaipa'tra(n) dhaatee madhina(n) maatee srona(n) raatee jai karana(n) ||",
      "translation": "They frighten the enemy by granting victory, by bathing in the blood,",
      "punjabiViakhya": "ਜੈ-ਪਤ੍ਰ' ਦੇਣ ਵਾਲੀ ਹੈ। ਮਸਤ ਕਰਨ ਵਾਲੀ ਹੈ, ਲਹੂ ਨਾਲ ਲਾਲ ਹੈ ਅਤੇ ਜਿੱਤ ਕਰਨ ਵਾਲੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "जैपत्त्रं दाती मदिणं माती स्रोणं राती जै करणं ॥",
      "sourceLineId": "86161",
      "sourceShabadId": "8018",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੁੱਜਨ ਦਲ ਹੰਤੀ ਅਛਲ ਜਯੰਤੀ ਕਿਲਵਿਖ ਹੰਤੀ ਭੈ ਹਰਣੰ ॥੫੮੯॥",
      "transliteration": "dhu'jan dhal ha(n)tee achhal jaya(n)tee kilavikh ha(n)tee bhai harana(n) ||589||",
      "translation": "By destroying the intoxicated tyrants and by perishing all the vices.589.",
      "punjabiViakhya": "ਦੁਰਜਨਾ ਦੇ ਦਲਾ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲੀ ਹੈ, ਨਿਸ਼ਕਪਟ ਜਿੱਤ ਦਿਵਾਉਣ ਵਾਲੀ ਹੈ, ਪਾਪਾ ਨੂੰ ਖ਼ਤਮ ਕਰਨ ਵਾਲੀ ਹੈ ਅਤੇ ਡਰ ਨੂੰ ਹਰਨ ਵਾਲੀ ਹੈ ॥੫੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "दुज्जन दल हंती अछल जयंती किलविख हंती भै हरणं ॥५८९॥",
      "sourceLineId": "86162",
      "sourceShabadId": "8018",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਲਸ ॥",
      "transliteration": "kalas ||",
      "translation": "KALAS",
      "punjabiViakhya": "ਕਲਸ:",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "कलस ॥",
      "sourceLineId": "86163",
      "sourceShabadId": "8019",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭਰਹਰੰਤ ਭੱਜਤ ਰਣ ਸੂਰੰ ॥",
      "transliteration": "bharahara(n)t bha'jat ran soora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੱਲਾ ਗੁੱਲਾ ਮਚਣ ਨਾਲ ਸੂਰਮੇ ਰਣ ਵਿੱਚ ਭੱਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "भरहरंत भज्जत रण सूरं ॥",
      "sourceLineId": "86164",
      "sourceShabadId": "8019",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਥਰਹਰ ਕਰਤ ਲੋਹ ਤਨ ਪੂਰੰ ॥",
      "transliteration": "tharahar karat loh tan poora(n) ||",
      "translation": "There was consternation, the warriors ran and their bodies wearing armour trembled",
      "punjabiViakhya": "ਲੋਹੇ ਨਾਲ ਮੜ੍ਰਹੇ ਹੋਏ ਸਰੀਰਾ ਵਾਲੇ (ਰਣ ਵਿਕ੍ਰਮ) ਵੀ ਥਰ-ਥਰ ਕੰਬਣ ਲੱਗ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "थरहर करत लोह तन पूरं ॥",
      "sourceLineId": "86165",
      "sourceShabadId": "8019",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤੜਭੜ ਬਜੈਂ ਤਬਲ ਅਰੁ ਤੂਰੰ ॥",
      "transliteration": "taRabhaR bajai(n) tabal ar toora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਬਲੇ ਅਤੇ ਤੂਰ ਜ਼ੋਰ ਨਾਲ ਵੱਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 261,
      "hindi": "",
      "hindiTransliteration": "तड़भड़ बजैं तबल अरु तूरं ॥",
      "sourceLineId": "86166",
      "sourceShabadId": "8019",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0261_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਘੁੱਮੀ ਪੇਖ ਸੁਭਟ ਰਨ ਹੂਰੰ ॥੫੯੦॥",
      "transliteration": "ghu'mee pekh subhaT ran hoora(n) ||590||",
      "translation": "The trumpets resounded violently in the war and seeing the mighty warriors the heavenly damsels advanced towards them again.590.",
