{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 266,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0266_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚਟਪਟ ਲਾਗੀ ਅਟਪਟ ਪਾਯੰ ॥",
      "transliteration": "chaTapaT laagee aTapaT paaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆਂ (ਰਾਮ ਚੰਦਰ ਦੇ) ਪੈਰੀਂ ਆ ਲੱਗੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "चटपट लागी अटपट पायं ॥",
      "sourceLineId": "86339",
      "sourceShabadId": "8044",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਰਬਰ ਨਿਰਖੇ ਰਘੁਬਰ ਰਾਯੰ ॥੬੨੭॥",
      "transliteration": "narabar nirakhe raghubar raaya(n) ||627||",
      "translation": "Ram saw all the spectacle.627.",
      "punjabiViakhya": "ਅਤੇ ਸ੍ਰੇਸ਼ਠ ਪੁਰਸ਼ ਰਾਮ ਦੇ ਦਰਸ਼ਨ ਕੀਤੇ ॥੬੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "नरबर निरखे रघुबर रायं ॥६२७॥",
      "sourceLineId": "86340",
      "sourceShabadId": "8044",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚਟਪਟ ਲੋਟੈਂ ਅਟਪਟ ਧਰਣੀ ॥",
      "transliteration": "chaTapaT loTai(n) aTapaT dharanee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਊਬੜ ਖਾਬੜ ਧਰਤੀ ਉਤੇ ਇਧਰ ਉਧਰ ਲੇਟਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "चटपट लोटैं अटपट धरणी ॥",
      "sourceLineId": "86341",
      "sourceShabadId": "8044",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਸਿ ਕਸਿ ਰੋਵੈਂ ਬਰਨਰ ਬਰਣੀ ॥",
      "transliteration": "kas kas rovai(n) baranar baranee ||",
      "translation": "The queens rolled on the earth and began to weep and lament in various ways",
      "punjabiViakhya": "ਰਾਖਸ਼-ਇਸਤਰੀਆਂ ਜ਼ੋਰ-ਜ਼ੋਰ ਨਾਲ ਰੋਂਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "कसि कसि रोवैं बरनर बरणी ॥",
      "sourceLineId": "86342",
      "sourceShabadId": "8044",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪਟਪਟ ਡਾਰੈਂ ਅਟਪਟ ਕੇਸੰ ॥",
      "transliteration": "paTapaT ddaarai(n) aTapaT kesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਖਿਲਰੇ ਹੋਏ ਕੇਸ਼ਾ ਨੂੰ ਪੁੱਟ-ਪੁੱਟ ਕੇ ਸੁੱਟਦੀਆਂ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "पटपट डारैं अटपट केसं ॥",
      "sourceLineId": "86343",
      "sourceShabadId": "8044",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਟ ਹਰਿ ਕੂਕੈਂ ਨਟ ਵਰ ਭੇਸੰ ॥੬੨੮॥",
      "transliteration": "baT har kookai(n) naT var bhesa(n) ||628||",
      "translation": "They pulled their hair and garments and cried and shrieked in various ways.628.",
      "punjabiViakhya": "ਲੁੱਟੇ ਗਏ ਰਾਹੀ (ਪਥਕ) ਵਾਗ ਕੂਕਦੀਆਂ ਸਨ ਅਤੇ (ਉਨ੍ਰਹਾ ਦਾ ਸਾਰਾ) ਭੇਸ ਸਿੱਧ-ਹਸਤ ਨਟ ਵਰਗਾ ਸੀ ॥੬੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "बट हरि कूकैं नट वर भेसं ॥६२८॥",
      "sourceLineId": "86344",
      "sourceShabadId": "8044",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚਟਪਟ ਚੀਰੰ ਅਟਪਟ ਪਾਰੈਂ ॥",
      "transliteration": "chaTapaT cheera(n) aTapaT paarai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਬਸਤ੍ਰਾ ਨੂੰ ਬੇਸੁਰੀ ਅਵਸਥਾ ਵਿੱਚ ਪਾੜ ਰਹੀਆਂ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "चटपट चीरं अटपट पारैं ॥",
      "sourceLineId": "86345",
      "sourceShabadId": "8044",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਧਰ ਕਰ ਧੂਮੰ ਸਰਬਰ ਡਾਰੈਂ ॥",
      "transliteration": "dhar kar dhooma(n) sarabar ddaarai(n) ||",
      "translation": "They began to tear their raiments and put the dust on their heads",
      "punjabiViakhya": "ਮਿੱਟੀ ਨੂੰ ਹੱਥਾ ਨਾਲ ਸਿਰ ਉਤੇ ਪਾਦੀਆਂ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "धर कर धूमं सरबर डारैं ॥",
      "sourceLineId": "86346",
      "sourceShabadId": "8044",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਟਪਟ ਲੋਟੈਂ ਖਟਪਟ ਭੂਮੰ ॥",
      "transliteration": "saTapaT loTai(n) khaTapaT bhooma(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਰਤ ਧਰਤੀ ਉਤੇ ਲੇਟ ਰਹੀਆਂ ਸਨ, ਗ਼ਮ ਨਾਲ ਝਾਟਿਆਂ ਨੂੰ ਪੁੱਟਦੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "सटपट लोटैं खटपट भूमं ॥",
      "sourceLineId": "86347",
      "sourceShabadId": "8044",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਝਟਪਟ ਝੂਰੈਂ ਘਰਹਰ ਘੂਮੰ ॥੬੨੯॥",
      "transliteration": "jhaTapaT jhoorai(n) gharahar ghooma(n) ||629||",
      "translation": "They in great sorrow cried, threw themselves down and rolled.629.",
      "punjabiViakhya": "ਅਤੇ ਘਬਰਾਈਆਂ ਹੋਈਆਂ ਘੁੰਮ ਰਹੀਆਂ ਸਨ ॥੬੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "झटपट झूरैं घरहर घूमं ॥६२९॥",
      "sourceLineId": "86348",
      "sourceShabadId": "8044",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "86349",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਬੈ ਰਾਮ ਦੇਖੈ ॥",
      "transliteration": "jabai raam dhekhai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਨੂੰ ਜਦੋਂ (ਉਨ੍ਰਹਾ ਨੇ) ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "जबै राम देखै ॥",
      "sourceLineId": "86350",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਹਾ ਰੂਪ ਲੇਖੈ ॥",
      "transliteration": "mahaa roop lekhai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਵੱਡਾ ਰੂਪਮਾਨ ਜਾਣਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "महा रूप लेखै ॥",
      "sourceLineId": "86351",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਹੀ ਨਯਾਇ ਸੀਸੰ ॥",
      "transliteration": "rahee nayai seesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਰਾਣੀਆਂ ਸਿਰ",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "रही नयाइ सीसं ॥",
      "sourceLineId": "86352",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਭੈ ਨਾਰ ਈਸੰ ॥੬੩੦॥",
      "transliteration": "sabhai naar ieesa(n) ||630||",
      "translation": "When all of them saw the most beautiful Ram, they bowed their heads and stood before him.630.",
      "punjabiViakhya": "ਨਿਵਾਣ ਲਗ ਗਈਆਂ ॥੬੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "सभै नार ईसं ॥६३०॥",
      "sourceLineId": "86353",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਲਖੈਂ ਰੂਪ ਮੋਹੀ ॥",
      "transliteration": "lakhai(n) roop mohee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਦੇ ਰੂਪ ਨੂੰ ਦੇਖ ਕੇ ਮੋਹੀਆਂ ਗਈਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "लखैं रूप मोही ॥",
      "sourceLineId": "86354",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਫਿਰੀ ਰਾਮ ਦੇਹੀ ॥",
      "transliteration": "firee raam dhehee ||",
      "translation": "They were allured to see the beauty of Ram",
      "punjabiViakhya": "ਲੰਕਾ ਵਿੱਚ ਰਾਮ ਦੀ ਦੁਹਾਈ ਫਿਰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "फिरी राम देही ॥",
      "sourceLineId": "86355",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦਈ ਤਾਹਿ ਲੰਕਾ ॥",
      "transliteration": "dhiee taeh la(n)kaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਵਿਭੀਸ਼ਣ) ਨੂੰ (ਰਾਮ ਨੇ) ਲੰਕਾ (ਇਉਾਂ ਦੇ ਦਿੱਤੀ)",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "दई ताहि लंका ॥",
      "sourceLineId": "86356",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਿਮੰ ਰਾਜ ਟੰਕਾ ॥੬੩੧॥",
      "transliteration": "jima(n) raaj Ta(n)kaa ||631||",
      "translation": "There was talk about Ram on all the four sides and they all gave Ram the kingdom of Lanka like the tax-payer setting tax with the authority.631.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਰਾਜੇ ਲਈ ਟਕਾ ਦੇਣਾ ਹੁੰਦਾ ਹੈ ॥੬੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "जिमं राज टंका ॥६३१॥",
      "sourceLineId": "86357",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਦ੍ਰਿਸਟ ਭੀਨੇ ॥",
      "transliteration": "kirapaa dhirasaT bheene ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਮ) ਕ੍ਰਿਪਾ-ਦ੍ਰਿਸ਼ਟੀ ਨਾਲ ਭਿੱਜ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "कृपा दृसट भीने ॥",
      "sourceLineId": "86358",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਰੇ ਨੇਤ੍ਰ ਕੀਨੇ ॥",
      "transliteration": "tare netr keene ||",
      "translation": "Ram bowed down his eyes filled with grace",
      "punjabiViakhya": "ਅਤੇ (ਰਾਣੀਆਂ ਦੀ ਦਸ਼ਾ ਦੇਖ ਕੇ) ਨੇਤਰ ਨੀਵੇਾਂ ਕਰ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "तरे नेत्र कीने ॥",
      "sourceLineId": "86359",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਝਰੈ ਬਾਰ ਐਸੇ ॥",
      "transliteration": "jharai baar aaise ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਤੋਂ ਜਲ ਇਸ ਤਰ੍ਰਹਾ ਝਰ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "झरै बार ऐसे ॥",
      "sourceLineId": "86360",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਹਾ ਮੇਘ ਜੈਸੇ ॥੬੩੨॥",
      "transliteration": "mahaa megh jaise ||632||",
      "translation": "Seeing him, the tears of joy flowed down from the eyes of people like the rain falling from the clouds.632.",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਮਹਾ ਮੇਘ (ਤੋਂ ਮੀਂਹ ਵਸ ਰਿਹਾ ਹੋਵੇ) ॥੬੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "महा मेघ जैसे ॥६३२॥",
      "sourceLineId": "86361",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਛਕੀ ਪੇਖ ਨਾਰੀ ॥",
      "transliteration": "chhakee pekh naaree ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਮ ਨੂੰ) ਵੇਖ ਕੇ ਇਸਤਰੀਆਂ ਪ੍ਰਸੰਨ ਹੋ ਗਈਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "छकी पेख नारी ॥",
      "sourceLineId": "86362",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਰੰ ਕਾਮ ਮਾਰੀ ॥",
      "transliteration": "sara(n) kaam maaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮ ਦੇ ਤੀਰ ਨਾਲ ਮਾਰੀਆਂ ਗਈਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "सरं काम मारी ॥",
      "sourceLineId": "86363",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਿਧੀ ਰੂਪ ਰਾਮੰ ॥",
      "transliteration": "bidhee roop raama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਦੇ ਰੂਪ ਨਾਲ ਵਿੰਨ੍ਰਹੀਆਂ ਗਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "बिधी रूप रामं ॥",
      "sourceLineId": "86364",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਹਾ ਧਰਮ ਧਾਮੰ ॥੬੩੩॥",
      "transliteration": "mahaa dharam dhaama(n) ||633||",
      "translation": "The woman allured by lust, were delighted to see Ram and they all ended their identity in Ram, the abode of Dharma. 633.",
      "punjabiViakhya": "ਪਰ (ਰਾਮ) ਮਹਾਨ ਧਰਮ ਦੇ ਘਰ ਸਨ ॥੬੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "महा धरम धामं ॥६३३॥",
      "sourceLineId": "86365",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਜੀ ਨਾਥ ਪ੍ਰੀਤੰ ॥",
      "transliteration": "tajee naath preeta(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀਆਂ ਨੇ ਆਪਣੇ) ਸੁਆਮੀ ਦੀ ਪ੍ਰੀਤ ਛੱਡ ਦਿਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "तजी नाथ प्रीतं ॥",
      "sourceLineId": "86366",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਚੁਭੇ ਰਾਮ ਚੀਤੰ ॥",
      "transliteration": "chubhe raam cheeta(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ) ਚਿੱਤ ਵਿੱਚ ਰਾਮ ਖੁੱਭ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "चुभे राम चीतं ॥",
      "sourceLineId": "86367",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰਹੀ ਜੋਰ ਨੈਣੰ ॥",
      "transliteration": "rahee jor naina(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਲਈ ਅੱਖਾ ਜੋੜ ਰਹੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "रही जोर नैणं ॥",
      "sourceLineId": "86368",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਹੈਂ ਮੱਦ ਬੈਣੰ ॥੬੩੪॥",
      "transliteration": "kahai(n) ma'dh baina(n) ||634||",
      "translation": "They all absorbed their minds in Ram, forsaking the love of their husbands and looking towards him resolutely, they began to talk with one another.634.",
      "punjabiViakhya": "ਅਤੇ ਮਸਤੀ ਵਾਲੇ ਬਚਨ ਬੋਲ ਰਹੀਆਂ ਸਨ ॥੬੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "कहैं मद्द बैणं ॥६३४॥",
      "sourceLineId": "86369",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੀਆ ਨਾਥ ਨੀਕੇ ॥",
      "transliteration": "seeaa naath neeke ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਚੰਦਰ ਚੰਗੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "सीआ नाथ नीके ॥",
      "sourceLineId": "86370",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਰੈਂ ਹਾਰ ਜੀਕੇ ॥",
      "transliteration": "harai(n) haar jeeke ||",
      "translation": "Ram, the Lord of Sita, is winsome and abductor of the mind",
      "punjabiViakhya": "ਦਿਲ ਰੂਪ ਹਾਰ ਨੂੰ ਹਰਨ ਵਾਲੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "हरैं हार जीके ॥",
      "sourceLineId": "86371",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਲਏ ਜਾਤ ਚਿੱਤੰ ॥",
      "transliteration": "le jaat chi'ta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਿੱਤ ਨੂੰ ਇਉਾਂ (ਚੁਰਾ ਕੇ) ਲਈ ਜਾਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "लए जात चित्तं ॥",
      "sourceLineId": "86372",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਨੋ ਚੋਰ ਬਿੱਤੰ ॥੬੩੫॥",
      "transliteration": "mano chor bi'ta(n) ||635||",
      "translation": "He is stealing the conscious mind like a thief.635.",
      "punjabiViakhya": "ਮਾਨੋ ਚੋਰ ਧਨ ਨੂੰ (ਚੁਰਾ ਕੇ ਲੈ ਚਲਿਆ ਹੋਵੇ) ॥੬੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "मनो चोर बित्तं ॥६३५॥",
      "sourceLineId": "86373",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਭੈ ਪਾਇ ਲਾਗੋ ॥",
      "transliteration": "sabhai pai laago ||",
      "translation": "",
      "punjabiViakhya": "(ਮੰਦੋਦਰੀ ਨੇ ਹੋਰਨਾ ਰਾਣੀਆਂ ਨੂੰ ਕਿਹਾ-) ਸਾਰੀਆਂ ਜਾ ਕੇ (ਸ੍ਰੀ ਰਾਮ) ਦੇ ਚਰਨੀਂ ਲੱਗੋ",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "सभै पाइ लागो ॥",
      "sourceLineId": "86374",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪਤੰ ਦ੍ਰੋਹ ਤਯਾਗੋ ॥",
      "transliteration": "pata(n) dhroh tayaago ||",
      "translation": "All the wives of Ravana were told to abandon the sorrow of their husband and touch the feet of Ram",
      "punjabiViakhya": "ਅਤੇ ਪਤੀ ਦੇ ਵੈਰ ਭਾਵ ਨੂੰ ਤਿਆਗ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "पतं द्रोह तयागो ॥",
      "sourceLineId": "86375",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਲਗੀ ਧਾਇ ਪਾਯੰ ॥",
      "transliteration": "lagee dhai paaya(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ ਸੁਣ ਕੇ) ਸਾਰੀਆਂ ਇਸਤਰੀਆਂ ਭਜ ਕੇ ਆਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "लगी धाइ पायं ॥",
      "sourceLineId": "86376",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਭੈ ਨਾਰਿ ਆਯੰ ॥੬੩੬॥",
      "transliteration": "sabhai naar aaya(n) ||636||",
      "translation": "All of them came forward and fell on his feet.636.",
      "punjabiViakhya": "ਅਤੇ ਸ੍ਰੀ ਰਾਮ ਦੇ ਚਰਨੀਂ ਲੱਗ ਗਈਆਂ ॥੬੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "सभै नारि आयं ॥६३६॥",
      "sourceLineId": "86377",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਹਾ ਰੂਪ ਜਾਨੇ ॥",
      "transliteration": "mahaa roop jaane ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਰਾਮ ਨੂੰ ਮਹਾ ਰੂਪਵਾਨ ਜਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "महा रूप जाने ॥",
      "sourceLineId": "86378",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚਿਤੰ ਚੋਰ ਮਾਨੇ ॥",
      "transliteration": "chita(n) chor maane ||",
      "translation": "The most beautiful Ram recognized their feelings",
      "punjabiViakhya": "ਤੇ ਚਿੱਤ (ਚੁਰਾਉਣ ਵਾਲਾ) ਚੋਰ ਮੰਨਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "चितं चोर माने ॥",
      "sourceLineId": "86379",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚੁਭੇ ਚਿੱਤ੍ਰ ਐਸੇ ॥",
      "transliteration": "chubhe chi'tr aaise ||",
      "translation": "",
      "punjabiViakhya": "(ਸ੍ਰੀ ਰਾਮ ਦਾ ਰੂਪ ਉਨ੍ਰਹਾ ਦੇ) ਚਿੱਤ ਵਿੱਚ ਇਸ ਤਰ੍ਰਹਾ ਚੁਭ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "चुभे चित्त्र ऐसे ॥",
      "sourceLineId": "86380",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਿਤੰ ਸਾਇ ਕੈਸੇ ॥੬੩੭॥",
      "transliteration": "sita(n) sai kaise ||637||",
      "translation": "He absorbed himself in the minds of all and all of them pursued him like shadow.637.",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਤਿੱਖੇ ਤੀਰ ਖੁਭ ਜਾਦੇ ਹਨ ॥੬੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "सितं साइ कैसे ॥६३७॥",
      "sourceLineId": "86381",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਲਗੋ ਹੇਮ ਰੂਪੰ ॥",
      "transliteration": "lago hem roopa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਮ ਚੰਦਰ) ਸੁਨਹਿਰੀ ਰੂਪ ਵਾਲੇ ਪ੍ਰਤੀਤ ਹੁੰਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "लगो हेम रूपं ॥",
      "sourceLineId": "86382",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਭੈ ਭੂਪ ਭੂਪੰ ॥",
      "transliteration": "sabhai bhoop bhoopa(n) ||",
      "translation": "Ram appeared to them in golden hue and looked like king of all kings",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਰਾਜਿਆਂ ਦੇ ਰਾਜੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "सभै भूप भूपं ॥",
      "sourceLineId": "86383",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਰੰਗੇ ਰੰਗ ਨੈਣੰ ॥",
      "transliteration": "ra(n)ge ra(n)g naina(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ) ਰੰਗ ਵਿੱਚ ਸਾਰਿਆਂ ਦੇ ਨੈਣ ਰੰਗੇ ਹੋਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "रंगे रंग नैणं ॥",
      "sourceLineId": "86384",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਛਕੇ ਦੇਵ ਗੈਣੰ ॥੬੩੮॥",
      "transliteration": "chhake dhev gaina(n) ||638||",
      "translation": "The eyes of all were dyed in his love and the gods were delighted to see him from the sky.638.",
      "punjabiViakhya": "ਅਤੇ ਆਕਾਸ਼ ਵਿੱਚ ਦੇਵਤੇ ਪ੍ਰਸੰਨ ਹੋ ਰਹੇ ਹਨ ॥੬੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "छके देव गैणं ॥६३८॥",
      "sourceLineId": "86385",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0266_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਿਨੈ ਏਕ ਬਾਰੰ ॥",
      "transliteration": "jinai ek baara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਇਕ ਵਾਰ",
      "source": "DASAM_GRANTH",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": "जिनै एक बारं ॥",
      "sourceLineId": "86386",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
