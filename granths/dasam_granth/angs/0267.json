{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 267,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0267_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਲਖੇ ਰਾਵਣਾਰੰ ॥",
      "transliteration": "lakhe raavanaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੀ ਰਾਮ ਨੂੰ ਵੇਖਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "लखे रावणारं ॥",
      "sourceLineId": "86387",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਹੀ ਮੋਹਤ ਹ੍ਵੈ ਕੈ ॥",
      "transliteration": "rahee mohat havai kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹੀ ਮੋਹਿਤ ਹੋ ਕੇ ਵੇਖਣ ਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "रही मोहत ह्वै कै ॥",
      "sourceLineId": "86388",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਲੁਭੀ ਦੇਖ ਕੈ ਕੈ ॥੬੩੯॥",
      "transliteration": "lubhee dhekh kai kai ||639||",
      "translation": "He, who saw Ram even once, she was completely allured.639.",
      "punjabiViakhya": "ਲੋਭ ਕਰ ਰਹੀ ਹੈ ॥੬੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "लुभी देख कै कै ॥६३९॥",
      "sourceLineId": "86389",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਛਕੀ ਰੂਪ ਰਾਮੰ ॥",
      "transliteration": "chhakee roop raama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਦੇ ਰੂਪ ਉਤੇ ਪ੍ਰਸੰਨ ਹੋ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "छकी रूप रामं ॥",
      "sourceLineId": "86390",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗਏ ਭੂਲ ਧਾਮੰ ॥",
      "transliteration": "ge bhool dhaama(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੂੰ) ਘਰ ਭੁਲ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "गए भूल धामं ॥",
      "sourceLineId": "86391",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਰਯੋ ਰਾਮ ਬੋਧੰ ॥",
      "transliteration": "karayo raam bodha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਰਾਮ ਚੰਦਰ ਨੇ ਗਿਆਨ ਉਪਦੇਸ਼ ਕੀਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "करयो राम बोधं ॥",
      "sourceLineId": "86392",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਹਾ ਜੁੱਧ ਜੋਧੰ ॥੬੪੦॥",
      "transliteration": "mahaa ju'dh jodha(n) ||640||",
      "translation": "She forgot the consciousness of all else seeing the beauty of Ram and began to talk to supremely mighty Ram.640.",
      "punjabiViakhya": "(ਜੋ ਰਾਮ) ਯੁੱਧ ਕਰਨ ਵਾਲੇ (ਮਹਾਨ) ਯੋਧੇ ਹਨ ॥੬੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "महा जुद्ध जोधं ॥६४०॥",
      "sourceLineId": "86393",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਾਮ ਬਾਚ ਮਦੋਦਰੀ ਪ੍ਰਤਿ ॥",
      "transliteration": "raam baach madhodharee prat ||",
      "translation": "The speech of Ram addressed to Mandodari :",
      "punjabiViakhya": "ਰਾਮ ਨੇ ਮੰਦੋਦਰੀ ਨੂੰ ਕਿਹਾ-",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "राम बाच मदोदरी प्रति ॥",
      "sourceLineId": "86394",
      "sourceShabadId": "8045",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "86395",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੁਨੋ ਰਾਜ ਨਾਰੀ ॥",
      "transliteration": "suno raaj naaree ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜ-ਇਸਤਰੀ! ਸੁਣੋ",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "सुनो राज नारी ॥",
      "sourceLineId": "86396",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਹਾ ਭੂਲ ਹਮਾਰੀ ॥",
      "transliteration": "kahaa bhool hamaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਸਭ ਵਿੱਚ) ਮੇਰੀ ਕੀ ਭੁਲ ਹੈ?",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "कहा भूल हमारी ॥",
      "sourceLineId": "86397",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਚਿਤੰ ਚਿੱਤ ਕੀਜੈ ॥",
      "transliteration": "chita(n) chi't keejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲੇ ਚਿੱਤ ਵਿੱਚ (ਸਾਰੀ ਗੱਲ ਨੂੰ) ਵਿਚਾਰੋ,",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "चितं चित्त कीजै ॥",
      "sourceLineId": "86398",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪੁਨਰ ਦੋਸ ਦੀਜੈ ॥੬੪੧॥",
      "transliteration": "punar dhos dheejai ||641||",
      "translation": "“O queen! I have not committed a mistake in killing your husband, think rightly in your mind about it and the blame me.641.",
      "punjabiViakhya": "ਫਿਰ (ਕਿਸੇ ਨੂੰ) ਦੋਸ਼ ਦਿਓ ॥੬੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "पुनर दोस दीजै ॥६४१॥",
      "sourceLineId": "86399",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਿਲੈ ਮੋਹਿ ਸੀਤਾ ॥",
      "transliteration": "milai moh seetaa ||",
      "translation": "",
      "punjabiViakhya": "(ਹੁਣ) ਮੈਨੂੰ ਸੀਤਾ ਮਿਲ ਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "मिलै मोहि सीता ॥",
      "sourceLineId": "86400",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚਲੈ ਧਰਮ ਗੀਤਾ ॥",
      "transliteration": "chalai dharam geetaa ||",
      "translation": "“I should get my Sita back, so that the work of righteousness may move forward",
      "punjabiViakhya": "(ਤਾ ਜੋ) ਧਰਮ ਦੀ ਮਰਯਾਦਾ ਚਲ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "चलै धरम गीता ॥",
      "sourceLineId": "86401",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪਠਯੋ ਪਉਨ ਪੂਤੰ ॥",
      "transliteration": "paThayo paun poota(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਪਿਛੋਂ ਰਾਮ ਨੇ) ਹਨੂਮਾਨ ਨੂੰ (ਸੀਤਾ ਲਿਆਉਣ ਲਈ) ਭੇਜ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "पठयो पउन पूतं ॥",
      "sourceLineId": "86402",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹੁਤੋ ਅੱਗ੍ਰ ਦੂਤੰ ॥੬੪੨॥",
      "transliteration": "huto a'gr dhoota(n) ||642||",
      "translation": "” (Saying in this way) Ram sent Hanuman, she son of wind-god, like an envoy (in advance).642.",
      "punjabiViakhya": "(ਜੋ ਉਨ੍ਰਹਾ ਦਾ) ਮੁੱਖ ਦੂਤ ਸੀ ॥੬੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "हुतो अग्ग्र दूतं ॥६४२॥",
      "sourceLineId": "86403",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚਲਯੋ ਧਾਇ ਕੈ ਕੈ ॥",
      "transliteration": "chalayo dhai kai kai ||",
      "translation": "",
      "punjabiViakhya": "(ਹਨੂਮਾਨ) ਤੇਜ਼ੀ ਨਾਲ ਤੁਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "चलयो धाइ कै कै ॥",
      "sourceLineId": "86404",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੀਆ ਸੋਧ ਲੈ ਕੈ ॥",
      "transliteration": "seeaa sodh lai kai ||",
      "translation": "",
      "punjabiViakhya": "ਸੀਤਾ ਦੀ ਸੁਧ ਲੈ ਕੇ (ਉਥੇ ਪੁੱਜਿਆ ਜਿਥੇ)",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "सीआ सोध लै कै ॥",
      "sourceLineId": "86405",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹੁਤੀ ਬਾਗ ਮਾਹੀ ॥",
      "transliteration": "hutee baag maahee ||",
      "translation": "",
      "punjabiViakhya": "ਸੀਤਾ ਬਾਗ ਵਿਚ",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "हुती बाग माही ॥",
      "sourceLineId": "86406",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਰੇ ਬ੍ਰਿਛ ਛਾਹੀ ॥੬੪੩॥",
      "transliteration": "tare birachh chhaahee ||643||",
      "translation": "Searching for Sita, he reached there, where she was sitting in the garden under a tree.643.",
      "punjabiViakhya": "ਬ੍ਰਿਛ ਦੀ ਛਾ ਹੇਠਾ ਬੈਠੀ ਸੀ ॥੬੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "तरे बृछ छाही ॥६४३॥",
      "sourceLineId": "86407",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪਰਯੋ ਜਾਇ ਪਾਯੰ ॥",
      "transliteration": "parayo jai paaya(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਹਨੂਮਾਨ) ਜਾ ਕੇ ਚਰਨੀਂ ਪੈ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "परयो जाइ पायं ॥",
      "sourceLineId": "86408",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੁਨੋ ਸੀਅ ਮਾਯੰ ॥",
      "transliteration": "suno seea maaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਕਹਿਣ ਲੱਗਾ) ਹੇ ਸੀਤਾ ਮਾਤਾ! ਸੁਣੋ,",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "सुनो सीअ मायं ॥",
      "sourceLineId": "86409",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0267_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਿਪੰ ਰਾਮ ਮਾਰੇ ॥",
      "transliteration": "ripa(n) raam maare ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਜੀ ਨੇ ਵੈਰੀ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": "रिपं राम मारे ॥",
      "sourceLineId": "86410",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
