{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 268,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0268_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਖਰੇ ਤੋਹਿ ਦੁਆਰੇ ॥੬੪੪॥",
      "transliteration": "khare toh dhuaare ||644||",
      "translation": "Hanuman, falling at the feet of Sita, said, “O mother Sita! Ram has killed the enemy (Ravana) and now he is standing at your door.644.",
      "punjabiViakhya": "ਅਤੇ (ਹੁਣ) ਤੁਹਾਡੇ ਦੁਆਰ ਉਤੇ ਖੜੋਤੇ ਹਨ ॥੬੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "खरे तोहि दुआरे ॥६४४॥",
      "sourceLineId": "86411",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚਲੋ ਬੇਗ ਸੀਤਾ ॥",
      "transliteration": "chalo beg seetaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸੀਤਾ ਮਾਤਾ ਜੀ! ਜਲਦੀ ਚਲੋ,",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "चलो बेग सीता ॥",
      "sourceLineId": "86412",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਹਾ ਰਾਮ ਜੀਤਾ ॥",
      "transliteration": "jahaa raam jeetaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਰਾਮ ਜੀ ਨੇ (ਯੁੱਧ) ਜਿੱਤਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "जहा राम जीता ॥",
      "sourceLineId": "86413",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਭੈ ਸੱਤ੍ਰੁ ਮਾਰੇ ॥",
      "transliteration": "sabhai sa'tr maare ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਵੈਰੀ ਮਾਰੇ ਗਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "सभै सत्त्रु मारे ॥",
      "sourceLineId": "86414",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭੂਅੰ ਭਾਰ ਉਤਾਰੇ ॥੬੪੫॥",
      "transliteration": "bhooa(n) bhaar utaare ||645||",
      "translation": "“O mother Sita! go to the place of Ram quickly, where he has won and lightened the burden of the earth by killing all the enemie.”645.",
      "punjabiViakhya": "ਅਤੇ ਧਰਤੀ ਦਾ ਭਾਰ ਉਤਾਰ ਦਿੱਤਾ ਹੈ ॥੬੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "भूअं भार उतारे ॥६४५॥",
      "sourceLineId": "86415",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚਲੀ ਮੋਦ ਕੈ ਕੈ ॥",
      "transliteration": "chalee modh kai kai ||",
      "translation": "",
      "punjabiViakhya": "(ਸੀਤਾ) ਪ੍ਰਸੰਨ ਹੋ ਕੇ ਤੁਰ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "चली मोद कै कै ॥",
      "sourceLineId": "86416",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਨੂ ਸੰਗ ਲੈ ਕੈ ॥",
      "transliteration": "hanoo sa(n)g lai kai ||",
      "translation": "",
      "punjabiViakhya": "ਹਨੂਮਾਨ (ਉਨ੍ਰਹਾ ਨੂੰ) ਨਾਲ ਲੈ ਕੇ (ਰਾਮ ਜੀ ਪਾਸ ਆਇਆ)।",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "हनू संग लै कै ॥",
      "sourceLineId": "86417",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੀਆ ਰਾਮ ਦੇਖੇ ॥",
      "transliteration": "seeaa raam dhekhe ||",
      "translation": "",
      "punjabiViakhya": "ਸੀਤਾ ਨੇ ਰਾਮ ਜੀ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "सीआ राम देखे ॥",
      "sourceLineId": "86418",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਉਹੀ ਰੂਪ ਲੇਖੇ ॥੬੪੬॥",
      "transliteration": "auhee roop lekhe ||646||",
      "translation": "Being highly pleased Sita accompanied Hanuman, she saw Ram and found Ram retaining his precious beauty.646.",
      "punjabiViakhya": "ਅਤੇ ਪਹਿਲੇ ਵਾਲੇ ਰੂਪ ਕਰਕੇ ਹੀ ਜਾਣਿਆ ॥੬੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "उही रूप लेखे ॥६४६॥",
      "sourceLineId": "86419",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਲਗੀ ਆਨ ਪਾਯੰ ॥",
      "transliteration": "lagee aan paaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੀਤਾ (ਸ੍ਰੀ ਰਾਮ) ਦੇ ਪੈਰੀਂ ਆ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "लगी आन पायं ॥",
      "sourceLineId": "86420",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਲਖੀ ਰਾਮ ਰਾਯੰ ॥",
      "transliteration": "lakhee raam raaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਰਾਜੇ ਨੇ ਵੇਖ ਲਿਆ। (ਤਾ ਰਾਮ ਨੇ ਕਿਹਾ-)",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "लखी राम रायं ॥",
      "sourceLineId": "86421",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਹਯੋ ਕਉਲ ਨੈਨੀ ॥",
      "transliteration": "kahayo kaul nainee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਕਮਲ ਵਰਗੀਆਂ ਅੱਖਾ ਵਾਲੀਏ!",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "कहयो कउल नैनी ॥",
      "sourceLineId": "86422",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਿਧੁੰ ਬਾਕ ਬੈਨੀ ॥੬੪੭॥",
      "transliteration": "bidhu(n) baak bainee ||647||",
      "translation": "Sita fell at the feet of Ram who saw towards her and addressed to that lady of lotus eyes and sweet speech 647",
      "punjabiViakhya": "ਹੇ ਕੋਇਲ ਦੀ ਸੁਰ ਵਰਗੇ ਬੋਲ ਬੋਲਣ ਵਾਲੀਏ! ਦੱਸੋ (ਤੁਹਾਡੀ ਪਵਿੱਤਰਤਾ ਦੀ ਪਰੀਖਿਆ ਕਿਸ ਤਰ੍ਰਹਾ ਹੋਵੇ) ॥੬੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "बिधुँ बाक बैनी ॥६४७॥",
      "sourceLineId": "86423",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਧਸੋ ਅੱਗ ਮੱਧੰ ॥",
      "transliteration": "dhaso a'g ma'dha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਤੂੰ) ਅੱਗ ਵਿੱਚ ਵੜ ਜਾ,",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "धसो अग्ग मद्धं ॥",
      "sourceLineId": "86424",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਬੈ ਹੋਇ ਸੁੱਧੰ ॥",
      "transliteration": "tabai hoi su'dha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੇ ਸ਼ੁੱਧ ਹੋਵੇਾਂਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "तबै होइ सुद्धं ॥",
      "sourceLineId": "86425",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਲਈ ਮਾਨ ਸੀਸੰ ॥",
      "transliteration": "liee maan seesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੀਤਾ ਨੇ (ਇਹ ਆਗਿਆ) ਸਿਰ ਮੱਥੇ ਮੰਨ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "लई मान सीसं ॥",
      "sourceLineId": "86426",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਚਯੋ ਪਾਵਕੀਸੰ ॥੬੪੮॥",
      "transliteration": "rachayo paavakeesa(n) ||648||",
      "translation": "“O Sita! enter the fire, so that you may become pure.” She agreed and prepared a pyre of fire.648.",
      "punjabiViakhya": "(ਉਸੇ ਵੇਲੇ) ਅੱਗ ਦਾ ਅੰਗੀਠਾ ਰਚਿਆ ਗਿਆ ॥੬੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "रचयो पावकीसं ॥६४८॥",
      "sourceLineId": "86427",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗਈ ਪੈਠ ਐਸੇ ॥",
      "transliteration": "giee paiTh aaise ||",
      "translation": "",
      "punjabiViakhya": "(ਅਗਨੀ ਦੇ ਲਟ-ਲਟ ਬਲਣ 'ਤੇ ਸੀਤਾ ਉਸ ਵਿੱਚ) ਇਸ ਤਰ੍ਰਹਾ ਪ੍ਰਵੇਸ਼ ਕਰ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "गई पैठ ऐसे ॥",
      "sourceLineId": "86428",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਘਨੰ ਬਿੱਜ ਜੈਸੇ ॥",
      "transliteration": "ghana(n) bi'j jaise ||",
      "translation": "She merged in the fire like the lightning seen in the clouds",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਬੱਦਲ ਵਿੱਚ ਬਿਜਲੀ (ਲੁਕ ਜਾਦੀ ਹੈ),",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "घनं बिज्ज जैसे ॥",
      "sourceLineId": "86429",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸ੍ਰੁਤੰ ਜੇਮ ਗੀਤਾ ॥",
      "transliteration": "sruta(n) jem geetaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਵੇਦਾ ਨਾਲ ਗੀਤਾ ਮਿਲੀ ਹੋਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "स्रुतं जेम गीता ॥",
      "sourceLineId": "86430",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਿਲੀ ਤੇਮ ਸੀਤਾ ॥੬੪੯॥",
      "transliteration": "milee tem seetaa ||649||",
      "translation": "She became one with fire like Gita with Shrutis (recorded texts).649.",
      "punjabiViakhya": "ਤਿਵੇਾਂ ਸ਼ੁੱਧ ਸਰੂਪ-ਸੀਤਾ (ਅਗਨੀ ਦੇ ਅੰਦਰ) ਸਮਾ ਗਈ ॥੬੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "मिली तेम सीता ॥६४९॥",
      "sourceLineId": "86431",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਧਸੀ ਜਾਇ ਕੈ ਕੈ ॥",
      "transliteration": "dhasee jai kai kai ||",
      "translation": "",
      "punjabiViakhya": "ਧਾਈ ਕਰਕੇ (ਸੀਤਾ ਅੱਗ ਵਿੱਚ) ਜਾ ਦਾਖ਼ਲ ਹੋਈ।",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "धसी जाइ कै कै ॥",
      "sourceLineId": "86432",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਢੀ ਕੁੰਦਨ ਹ੍ਵੈ ਕੈ ॥",
      "transliteration": "kaddee ku(n)dhan havai kai ||",
      "translation": "She entered the fire and came out like pure gold",
      "punjabiViakhya": "(ਅਗਨੀ ਦੇਵਤਾ ਨੇ ਉਸ ਨੂੰ ਸੋਨੇ) (ਵਾਗ ਨਿਖਾਰ ਕੇ) ਬਾਹਰ ਕੱਢਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "कढी कुँदन ह्वै कै ॥",
      "sourceLineId": "86433",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗਰੈ ਰਾਮ ਲਾਈ ॥",
      "transliteration": "garai raam laiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਨੇ (ਉਸ ਨੂੰ) ਆਪਣੇ ਗਲ ਨਾਲ ਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "गरै राम लाई ॥",
      "sourceLineId": "86434",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਬੰ ਕ੍ਰਿਤ ਗਾਈ ॥੬੫੦॥",
      "transliteration": "kaba(n) kirat gaiee ||650||",
      "translation": "Ram hold her to his bosom and the poets sang in praise about this fact.650.",
      "punjabiViakhya": "(ਅਜਿਹੇ ਪਵਿੱਤਰ ਆਚਰਨ ਕਰਕੇ ਹੀ) ਕਵੀਆਂ ਨੇ (ਸੀਤਾ ਜੀ ਦਾ) ਯਸ਼ ਗਾਇਆ ਹੈ ॥੬੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "कबं कृत गाई ॥६५०॥",
      "sourceLineId": "86435",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਭੋ ਸਾਧ ਮਾਨੀ ॥",
      "transliteration": "sabho saadh maanee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਸਾਧੂ (ਵਿਅਕਤੀਆਂ ਨੇ ਇਸ ਅਗਨੀ ਪ੍ਰੀਖਿਆ ਨੂੰ) ਮੰਨ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "सभो साध मानी ॥",
      "sourceLineId": "86436",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਿਹੂ ਲੋਗ ਜਾਨੀ ॥",
      "transliteration": "tihoo log jaanee ||",
      "translation": "All the saints accepted this type of fire-test and the beings of the three worlds accepted this fact",
      "punjabiViakhya": "ਅਤੇ ਤਿੰਨਾ ਲੋਕਾ ਵਿੱਚ (ਇਹ ਗੱਲ) ਜਾਣੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "तिहू लोग जानी ॥",
      "sourceLineId": "86437",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਜੇ ਜੀਤ ਬਾਜੇ ॥",
      "transliteration": "baje jeet baaje ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦੋਂ) ਜਿੱਤ ਦੇ ਵਾਜੇ ਵੱਜਣ ਲਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "बजे जीत बाजे ॥",
      "sourceLineId": "86438",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਬੈ ਰਾਮ ਗਾਜੇ ॥੬੫੧॥",
      "transliteration": "tabai raam gaaje ||651||",
      "translation": "The musical instruments of victory were played and Ram also thundered in great joy.651.",
      "punjabiViakhya": "ਤਦੋਂ ਰਾਮ ਗੱਜਣ ਲੱਗੇ ॥੬੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "तबै राम गाजे ॥६५१॥",
      "sourceLineId": "86439",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਲਈ ਜੀਤ ਸੀਤਾ ॥",
      "transliteration": "liee jeet seetaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਸੀਤਾ ਜਿੱਤ ਲਈ,",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "लई जीत सीता ॥",
      "sourceLineId": "86440",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮਹਾ ਸੁਭ੍ਰ ਗੀਤਾ ॥",
      "transliteration": "mahaa subhr geetaa ||",
      "translation": "The pure SIta was conquered like a superbly auspicious song",
      "punjabiViakhya": "ਜੋ ਮਹਾਨ ਯਸ਼ ਵਾਲੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "महा सुभ्र गीता ॥",
      "sourceLineId": "86441",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਭੈ ਦੇਵ ਹਰਖੇ ॥",
      "transliteration": "sabhai dhev harakhe ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਦੇਵਤੇ ਆਨੰਦਿਤ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "सभै देव हरखे ॥",
      "sourceLineId": "86442",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਭੰ ਪੁਹਪ ਬਰਖੇ ॥੬੫੨॥",
      "transliteration": "nabha(n) puhap barakhe ||652||",
      "translation": "All the gods began to shower flowers from the sky.652.",
      "punjabiViakhya": "ਅਤੇ ਆਕਾਸ਼ ਤੋਂ ਫੁੱਲਾ ਦੀ ਵਰਖਾ ਕਰਨ ਲੱਗੇ ॥੬੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "नभं पुहप बरखे ॥६५२॥",
      "sourceLineId": "86443",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਰਾਮਵਤਾਰ ਬਭੀਛਨ ਕੋ ਲੰਕਾ ਕੋ ਰਾਜ ਦੀਬੋ ਮਦੋਦਰੀ ਸਮੋਧ ਕੀਬੋ ਸੀਤਾ ਮਿਲਬੋ ਧਯਾਇ ਸਮਾਪਤੰ ॥੧੮॥",
      "transliteration": "eit sree bachitr naaTake raamavataar babheechhan ko la(n)kaa ko raaj dheebo madhodharee samodh keebo seetaa milabo dhayai samaapata(n) ||18||",
      "translation": "End of the chapter entitled The Bestowal of Kingdom on Vibhishan, Imparting of Contemporaneous Knowledge to Mandodari and the Union with Sita’ in Ramavtar in BACHITTAR NATAK.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ ਰਾਮਾਵਤਾਰ ਦੇ ਵਿਭੀਸ਼ਣ ਨੂੰ ਲੰਕਾ ਦਾ ਰਾਜ ਦੇਣ, ਮੰਦੋਦਰੀ ਨੂੰ ਸਮਿਅਕ ਗਿਆਨ ਕਰਨ ਅਤੇ ਸੀਤਾ ਦੇ ਮਿਲਣ ਦੇ ਅਧਿਆਇ ਦੀ ਸਮਾਪਤੀ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटके रामवतार बभीछन को लंका को राज दीबो मदोदरी समोध कीबो सीता मिलबो धयाइ समापतं ॥१८॥",
      "sourceLineId": "86444",
      "sourceShabadId": "8046",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਥ ਅਉਧਪੁਰੀ ਕੋ ਚਲਬੋ ਕਥਨੰ ॥",
      "transliteration": "ath aaudhapuree ko chalabo kathana(n) ||",
      "translation": "Now begins the description of the entry into Ayodhya :",
      "punjabiViakhya": "ਹੁਣ ਅਯੁਧਿਆ ਨੂੰ ਚਲਣ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "अथ अउधपुरी को चलबो कथनं ॥",
      "sourceLineId": "86445",
      "sourceShabadId": "8047",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "86446",
      "sourceShabadId": "8047",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਬੈ ਪੁਹਪੁ ਪੈ ਕੈ ॥",
      "transliteration": "tabai puhap pai kai ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਰਾਮ ਯੁੱਧ ਜਿੱਤ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "तबै पुहपु पै कै ॥",
      "sourceLineId": "86447",
      "sourceShabadId": "8047",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਚੜੇ ਜੁੱਧ ਜੈ ਕੈ ॥",
      "transliteration": "chaRe ju'dh jai kai ||",
      "translation": "Gaining victory in war, then Ram mounted on the air-vehicle Pushpak",
      "punjabiViakhya": "ਪੁਸ਼ਪਕ ਬਿਮਾਨ ਉਤੇ ਚੜ੍ਰਹੇ,",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "चड़े जुद्ध जै कै ॥",
      "sourceLineId": "86448",
      "sourceShabadId": "8047",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਭੈ ਸੂਰ ਗਾਜੈ ॥",
      "transliteration": "sabhai soor gaajai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਸੂਰਮੇ ਗੱਜਣ ਲਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "सभै सूर गाजै ॥",
      "sourceLineId": "86449",
      "sourceShabadId": "8047",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਯੰ ਗੀਤ ਬਾਜੇ ॥੬੫੩॥",
      "transliteration": "jaya(n) geet baaje ||653||",
      "translation": "All the warriors roared in great joy and the musical instruments of victory resounded.653.",
      "punjabiViakhya": "ਅਤੇ ਜਿੱਤ ਦੇ ਗੀਤਾ ਦੀਆਂ ਧੁੰਨਾ ਵਜਣ ਲਗੀਆਂ ॥੬੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "जयं गीत बाजे ॥६५३॥",
      "sourceLineId": "86450",
      "sourceShabadId": "8047",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚਲੇ ਮੋਦ ਹ੍ਵੈ ਕੈ ॥",
      "transliteration": "chale modh havai kai ||",
      "translation": "",
      "punjabiViakhya": "ਬੜੇ ਪ੍ਰਸੰਨ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "चले मोद ह्वै कै ॥",
      "sourceLineId": "86451",
      "sourceShabadId": "8047",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਪੀ ਬਾਹਨ ਲੈ ਕੈ ॥",
      "transliteration": "kapee baahan lai kai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬੰਦਰਾ ਦੀ ਸੈਨਾ ਨੂੰ ਨਾਲ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "कपी बाहन लै कै ॥",
      "sourceLineId": "86452",
      "sourceShabadId": "8047",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪੁਰੀ ਅਉਧ ਪੇਖੀ ॥",
      "transliteration": "puree aaudh pekhee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਮ ਜੀ ਨੇ ਆ ਕੇ) ਅਯੁੱਧਿਆ ਪੁਰੀ ਵੇਖੀ",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "पुरी अउध पेखी ॥",
      "sourceLineId": "86453",
      "sourceShabadId": "8047",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸ੍ਰੁਤੰ ਸੁਰਗ ਲੇਖੀ ॥੬੫੪॥",
      "transliteration": "sruta(n) surag lekhee ||654||",
      "translation": "The monkeys in great delight caused the air-vehicle to fly and they saw Avadhpuri, beautiful like heaven.654.",
      "punjabiViakhya": "(ਜੋ) ਸੁਅਰਗ ਵਰਗੀ ਸੁਣੀ ਜਾਦੀ ਹੈ ॥੬੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "स्रुतं सुरग लेखी ॥६५४॥",
      "sourceLineId": "86454",
      "sourceShabadId": "8047",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮਕਰਾ ਛੰਦ ॥",
      "transliteration": "makaraa chha(n)dh ||",
      "translation": "MAKRA STANZA",
      "punjabiViakhya": "ਮਕਰਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "मकरा छंद ॥",
      "sourceLineId": "86455",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੀਅ ਲੈ ਸੀਏਸ ਆਏ ॥",
      "transliteration": "seea lai se'ees aae ||",
      "translation": "",
      "punjabiViakhya": "ਸੀਤਾ ਦੇ ਸੁਆਮੀ (ਰਾਮ ਚੰਦਰ) ਸੀਤਾ ਨੂੰ ਲੈ ਕੇ ਆਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "सीअ लै सीएस आए ॥",
      "sourceLineId": "86456",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮੰਗਲ ਸੁ ਚਾਰ ਗਾਏ ॥",
      "transliteration": "ma(n)gal su chaar gaae ||",
      "translation": "Ram has come and brought Sita with him and",
      "punjabiViakhya": "(ਉਥੇ) ਸ਼ੁਭ ਮੰਗਲਾਚਾਰ ਗਾਏ ਜਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "मंगल सु चार गाए ॥",
      "sourceLineId": "86457",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0268_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਆਨੰਦ ਹੀਏ ਬਢਾਏ ॥",
      "transliteration": "aana(n)dh he'ee baddaae ||",
      "translation": "",
      "punjabiViakhya": "(ਸਭਨਾ ਨੇ) ਦਿਲਾ ਵਿੱਚ ਆਨੰਦ ਵਧਾਇਆ ਹੋਇਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": "आनंद हीए बढाए ॥",
      "sourceLineId": "86458",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
