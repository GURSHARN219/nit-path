{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 269,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0269_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਹਰੋ ਅਵਧ ਜਹਾ ਰੇ ॥੬੫੫॥",
      "transliteration": "saharo avadh jahaa re ||655||",
      "translation": "There are rejoicings in the city  the joy is growing in the heart of Avadh.655.",
      "punjabiViakhya": "(ਕਿੱਥੇ?) ਜਿਥੇ ਅਯੁਧਿਆ ਸ਼ਹਿਰ ਹੈ ॥੬੫੫॥",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "सहरो अवध जहा रे ॥६५५॥",
      "sourceLineId": "86459",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਧਾਈ ਲੁਗਾਈ ਆਵੈ ॥",
      "transliteration": "dhaiee lugaiee aavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀਆਂ ਭੱਜੀਆਂ ਆਉਾਂਦੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "धाई लुगाई आवै ॥",
      "sourceLineId": "86460",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭੀਰੋ ਨ ਬਾਰ ਪਾਵੈ ॥",
      "transliteration": "bheero na baar paavai ||",
      "translation": "",
      "punjabiViakhya": "ਭੀੜ ਕਰਕੇ ਬੂਹੇ ਤਕ ਪਹੁੰਚ ਨਹੀਂ ਸਕਦੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "भीरो न बार पावै ॥",
      "sourceLineId": "86461",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਆਕਲ ਖਰੇ ਉਘਾਵੈ ॥",
      "transliteration": "aakal khare ughaavai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਵਿਆਕੁਲ ਖੜੋਤੀਆਂ ਹੋਈਆਂ ਬੋਲ ਰਹੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "आकल खरे उघावै ॥",
      "sourceLineId": "86462",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭਾਖੈਂ ਢੋਲਨ ਕਹਾ ਰੇ ॥੬੫੬॥",
      "transliteration": "bhaakhai(n) ddolan kahaa re ||656||",
      "translation": "The women are coming at speed, there is endless crowd, all are standing amazed and asking, “Where is our Lord Ram?”656.",
      "punjabiViakhya": "ਅਤੇ ਕਹਿੰਦੀਆਂ ਹਨ-ਪਿਆਰਾ ਰਾਮ (ਢੋਲਨ) ਕਿਥੇ ਹੈ? ॥੬੫੬॥",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "भाखैं ढोलन कहा रे ॥६५६॥",
      "sourceLineId": "86463",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜੁਲਫੈ ਅਨੂਪ ਜਾ ਕੀ ॥",
      "transliteration": "julafai anoop jaa kee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀਆਂ ਜ਼ੁਲਫ਼ਾ ਅਨੂਪਮ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "जुलफै अनूप जा की ॥",
      "sourceLineId": "86464",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਾਗਨ ਕਿ ਸਿਆਹ ਬਾਕੀ ॥",
      "transliteration": "naagan k siaaeh baakee ||",
      "translation": "“He, whose hair are unique and black like serpents",
      "punjabiViakhya": "ਅਤੇ ਨਾਗਨ ਵਾਗ ਕਾਲੀਆਂ ਅਤੇ ਪੇਚਦਾਰ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "नागन कि सिआह बाकी ॥",
      "sourceLineId": "86465",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਧਭੁਤ ਅਦਾਇ ਤਾ ਕੀ ॥",
      "transliteration": "adhabhut adhai taa kee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਅਦਾ ਅਦਭੁਤ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "अधभुत अदाइ ता की ॥",
      "sourceLineId": "86466",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਐਸੋ ਢੋਲਨ ਕਹਾ ਹੈ ॥੬੫੭॥",
      "transliteration": "aaiso ddolan kahaa hai ||657||",
      "translation": "He whose thinking is wonderful, where is that dear Ram?657.",
      "punjabiViakhya": "ਅਜਿਹੀਆਂ (ਸਿਫ਼ਤਾ ਵਾਲਾ) ਪਿਆਰਾ ਕਿਥੇ ਹੈ? ॥੬੫੭॥",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "ऐसो ढोलन कहा है ॥६५७॥",
      "sourceLineId": "86467",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਰਵੋਸ ਹੀ ਚਮਨਰਾ ॥",
      "transliteration": "saravos hee chamanaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਬਾਗ ਦਾ ਸਹੀ ਸਰੂ ਅਤੇ ਜਾਨ ਤੇ ਸਰੀਰ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "सरवोस ही चमनरा ॥",
      "sourceLineId": "86468",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪਰ ਚੁਸਤ ਜਾ ਵਤਨਰਾ ॥",
      "transliteration": "par chusat jaa vatanaraa ||",
      "translation": "“He who is ever in blossom like garden and ever thoughtful about his kingdom",
      "punjabiViakhya": "ਚੇਤਨਾ ਦੇਣ ਵਾਲਾ (ਪੁਰਚੁਸਤ) ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "पर चुसत जा वतनरा ॥",
      "sourceLineId": "86469",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਿਨ ਦਿਲ ਹਰਾ ਹਮਾਰਾ ॥",
      "transliteration": "jin dhil haraa hamaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਸਾਡਾ ਦਿਲ ਚੁਰਾ ਲਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "जिन दिल हरा हमारा ॥",
      "sourceLineId": "86470",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਵਹ ਮਨ ਹਰਨ ਕਹਾ ਹੈ ॥੬੫੮॥",
      "transliteration": "veh man haran kahaa hai ||658||",
      "translation": "He, who hath stolen our mind, where is that Ram.658.",
      "punjabiViakhya": "ਉਹ ਮਨ ਨੂੰ ਚਰਾਉਣ ਵਾਲਾ (ਸ੍ਰੀ ਰਾਮ) ਕਿਥੇ ਹੈ? ॥੬੫੮॥",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "वह मन हरन कहा है ॥६५८॥",
      "sourceLineId": "86471",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚਿਤ ਕੋ ਚੁਰਾਇ ਲੀਨਾ ॥",
      "transliteration": "chit ko churai leenaa ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੇ) ਚਿੱਤ ਨੂੰ ਚੁਰਾ ਲਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "चित को चुराइ लीना ॥",
      "sourceLineId": "86472",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਾਲਮ ਫਿਰਾਕ ਦੀਨਾ ॥",
      "transliteration": "jaalam firaak dheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜ਼ਾਲਮ ਵਿਛੋੜਾ ਦਿੱਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "जालम फिराक दीना ॥",
      "sourceLineId": "86473",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਿਨ ਦਿਲ ਹਰਾ ਹਮਾਰਾ ॥",
      "transliteration": "jin dhil haraa hamaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਸਾਡਾ ਦਿਲ ਚੁਰਾਇਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "जिन दिल हरा हमारा ॥",
      "sourceLineId": "86474",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਵਹ ਗੁਲ ਚਿਹਰ ਕਹਾ ਹੈ ॥੬੫੯॥",
      "transliteration": "veh gul chihar kahaa hai ||659||",
      "translation": "“He, who hath stolen our heart and given as separation from him, were is that flower-faced and alluring Ram?659.",
      "punjabiViakhya": "ਉਹ ਫੁੱਲ ਜਿਹੇ ਚਿਹਰੇ ਵਾਲਾ (ਰਾਮ) ਕਿਥੇ ਹੈ? ॥੬੫੯॥",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "वह गुल चिहर कहा है ॥६५९॥",
      "sourceLineId": "86475",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕੋਊ ਬਤਾਇ ਦੈ ਰੇ ॥",
      "transliteration": "kouoo batai dhai re ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਕੋਈ ਆ ਕੇ ਦੱਸ ਦੇਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "कोऊ बताइ दै रे ॥",
      "sourceLineId": "86476",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚਾਹੋ ਸੁ ਆਨ ਲੈ ਰੇ ॥",
      "transliteration": "chaaho su aan lai re ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਚਾਹੇ ਸਾਥੋਂ ਆ ਕੇ ਲੈ ਲਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "चाहो सु आन लै रे ॥",
      "sourceLineId": "86477",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਿਨ ਦਿਲ ਹਰਾ ਹਮਾਰਾ ॥",
      "transliteration": "jin dhil haraa hamaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜਿਸ ਨੇ ਸਾਡਾ ਦਿਲ ਚੁਰਾਇਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "जिन दिल हरा हमारा ॥",
      "sourceLineId": "86478",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਵਹ ਮਨ ਹਰਨ ਕਹਾ ਹੈ ॥੬੬੦॥",
      "transliteration": "veh man haran kahaa hai ||660||",
      "translation": "“Someone may tell us and take whatever he wants from us, but he should tell us where is that alluring Ram?660.",
      "punjabiViakhya": "ਉਹ ਮਨ ਨੂੰ ਹਰਨ ਵਾਲਾ (ਰਾਮ) ਕਿਥੇ ਹੈ? ॥੬੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "वह मन हरन कहा है ॥६६०॥",
      "sourceLineId": "86479",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਾਤੇ ਮਨੋ ਅਮਲ ਕੇ ॥",
      "transliteration": "maate mano amal ke ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਦਾ ਸਰੂਪ) ਮਾਨੋ ਅਮਲ ਦਾ ਮਤਿਆ ਹੋਇਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "माते मनो अमल के ॥",
      "sourceLineId": "86480",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਰੀਆ ਕਿ ਜਾ ਵਤਨ ਕੇ ॥",
      "transliteration": "hareeaa k jaa vatan ke ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਜਾਨ ਅਤੇ ਸਰੀਰ ਨੂੰ ਚੁਰਾਉਣ ਵਾਲਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "हरीआ कि जा वतन के ॥",
      "sourceLineId": "86481",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਲਮ ਕੁਸਾਇ ਖੂਬੀ ॥",
      "transliteration": "aalam kusai khoobee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਖੂਬੀ ਨਾਲ ਜਗਤ ਨੂੰ ਜਿੱਤਣ ਵਾਲਾ (ਕੁਸਾਇ) ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "आलम कुसाइ खूबी ॥",
      "sourceLineId": "86482",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਵਹ ਗੁਲ ਚਿਹਰ ਕਹਾ ਹੈ ॥੬੬੧॥",
      "transliteration": "veh gul chihar kahaa hai ||661||",
      "translation": "“He accepted the orders of his father like a drunkard accepting every word of the giver of intoxicant and he left his country. Where is he, the beauty-incarnation of the world and rose-faced?661.",
      "punjabiViakhya": "ਉਹ ਫੁੱਲ ਵਰਗੇ ਮੁਖੜੇ ਵਾਲਾ ਕਿਥੇ ਹੈ? ॥੬੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "वह गुल चिहर कहा है ॥६६१॥",
      "sourceLineId": "86483",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਾਲਮ ਅਦਾਇ ਲੀਏ ॥",
      "transliteration": "jaalam adhai le'ee ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਦੀ) ਚਾਲ (ਅਦਾਇ) ਜ਼ੁਲਮ ਢਾਣ ਵਾਲੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "जालम अदाइ लीए ॥",
      "sourceLineId": "86484",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਖੰਜਨ ਖਿਸਾਨ ਕੀਏ ॥",
      "transliteration": "kha(n)jan khisaan ke'ee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਅੱਖਾ ਦੀ ਚੰਚਲਤਾ) ਮਮੋਲਿਆਂ ਨੂੰ ਵੀ ਸ਼ਰਮਸ਼ਾਰ (ਖਿਸਾਨ) ਕਰ ਰਹੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "खंजन खिसान कीए ॥",
      "sourceLineId": "86485",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਿਨ ਦਿਲ ਹਰਾ ਹਮਾਰਾ ॥",
      "transliteration": "jin dhil haraa hamaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਸਾਡਾ ਦਿਲ ਚੁਰਾਇਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "जिन दिल हरा हमारा ॥",
      "sourceLineId": "86486",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਵਹ ਮਹਬਦਨ ਕਹਾ ਹੈ ॥੬੬੨॥",
      "transliteration": "veh mahabadhan kahaa hai ||662||",
      "translation": "“The wagtail (birds) were envious of his cruel gestures, he who hath allured our mind, where is that Ram of blossomed face?662.",
      "punjabiViakhya": "ਉਹ ਚੰਦ ਵਰਗੇ ਮੁਖੜੇ ਵਾਲਾ (ਮਹਬਦਾਨ) ਕਿਥੇ ਹੈ? ॥੬੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "वह महबदन कहा है ॥६६२॥",
      "sourceLineId": "86487",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਾਲਮ ਅਦਾਏ ਲੀਨੇ ॥",
      "transliteration": "jaalam adhaae leene ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਜ਼ੁਲਮ ਕਰਨ ਵਾਲੀ ਅਦਾ ਅਪਣਾਈ ਹੋਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "जालम अदाए लीने ॥",
      "sourceLineId": "86488",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਾਨੁਕ ਸਰਾਬ ਪੀਨੇ ॥",
      "transliteration": "jaanuk saraab peene ||",
      "translation": "“His gestures were the gestures of an intoxicated person",
      "punjabiViakhya": "ਮਾਨੋ ਸ਼ਰਾਬ ਪੀਤੀ ਹੋਈ ਹੋਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "जानुक सराब पीने ॥",
      "sourceLineId": "86489",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਰੁਖਸਰ ਜਹਾਨ ਤਾਬਾ ॥",
      "transliteration": "rukhasar jahaan taabaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀਆਂ ਗੱਲ੍ਰਹਾ ਸੰਸਾਰ ਨੂੰ ਰੌਸ਼ਨ (ਤਾਬਾ) ਕਰਨ ਵਾਲੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "रुखसर जहान ताबा ॥",
      "sourceLineId": "86490",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਵਹ ਗੁਲਬਦਨ ਕਹਾ ਹੈ ॥੬੬੩॥",
      "transliteration": "veh gulabadhan kahaa hai ||663||",
      "translation": "All the world is obedient to his personality  someone may tell where is that flower-faced Ram?663.",
      "punjabiViakhya": "ਉਹ ਫੁੱਲ ਵਰਗੇ ਮੁਖੜੇ ਵਾਲਾ ਕਿਥੇ ਹੈ? ॥੬੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "वह गुलबदन कहा है ॥६६३॥",
      "sourceLineId": "86491",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਾਲਮ ਜਮਾਲ ਖੂਬੀ ॥",
      "transliteration": "jaalam jamaal khoobee ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਦੀ) ਖੂਬੀ ਜ਼ਾਲਮ ਸੁੰਦਰਤਾ (ਜਮਾਲ) ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "जालम जमाल खूबी ॥",
      "sourceLineId": "86492",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰੋਸਨ ਦਿਮਾਗ ਅਖਸਰ ॥",
      "transliteration": "rosan dhimaag akhasar ||",
      "translation": "“The splendour of this face was significant and he was perfect in intellect",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਦਿਮਾਗ਼ ਅਕਸਰ ਰੌਸ਼ਨ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "रोसन दिमाग अखसर ॥",
      "sourceLineId": "86493",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪੁਰ ਚੁਸਤ ਜਾ ਜਿਗਰ ਰਾ ॥",
      "transliteration": "pur chusat jaa jigar raa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਜਾਨ ਅਤੇ ਜਿਗਰ ਨੂੰ ਚੇਤਨਾ ਪ੍ਰਦਾਨ ਕਰਨ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "पुर चुसत जा जिगर रा ॥",
      "sourceLineId": "86494",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਵਹ ਗੁਲ ਚਿਹਰ ਕਹਾ ਹੈ ॥੬੬੪॥",
      "transliteration": "veh gul chihar kahaa hai ||664||",
      "translation": "He, who is a vessel full of the wine of heart’s love, where is that flower faced Ram?664.",
      "punjabiViakhya": "ਉਹ ਫੁੱਲ ਵਰਗੇ ਚਿਹਰੇ ਵਾਲਾ ਕਿਥੇ ਹੈ? ॥੬੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "वह गुल चिहर कहा है ॥६६४॥",
      "sourceLineId": "86495",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਾਲਮ ਬਿਦੇਸ ਆਏ ॥",
      "transliteration": "baalam bidhes aae ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਆਰੇ (ਰਾਮ ਜੀ) ਵਿਦੇਸ਼ ਤੋਂ ਆਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "बालम बिदेस आए ॥",
      "sourceLineId": "86496",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜੀਤੇ ਜੁਆਨ ਜਾਲਮ ॥",
      "transliteration": "jeete juaan jaalam ||",
      "translation": "“After conquering the tyrants the beloved Ram has come back from distant lands",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੇ (ਰਾਵਣ ਵਰਗੇ) ਜ਼ਾਲਮ ਸੂਰਮਿਆਂ ਨੂੰ ਜਿੱਤਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "जीते जुआन जालम ॥",
      "sourceLineId": "86497",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਾਮਲ ਕਮਾਲ ਸੂਰਤ ॥",
      "transliteration": "kaamal kamaal soorat ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦੀ ਸੂਰਤ ਕਮਾਲ ਦੀ ਪਰਿਪੂਰਨ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "कामल कमाल सूरत ॥",
      "sourceLineId": "86498",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਵਰ ਗੁਲ ਚਿਹਰ ਕਹਾ ਹੈ ॥੬੬੫॥",
      "transliteration": "var gul chihar kahaa hai ||665||",
      "translation": "Where is he, the perfect one in all arts and who hath flower-like face?665.",
      "punjabiViakhya": "ਉਹ ਫੁੱਲ ਵਰਗੇ ਮੁਖੜੇ ਵਾਲਾ ਕਿਥੇ ਹੈ? ॥੬੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "वर गुल चिहर कहा है ॥६६५॥",
      "sourceLineId": "86499",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰੋਸਨ ਜਹਾਨ ਖੂਬੀ ॥",
      "transliteration": "rosan jahaan khoobee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਜਹਾਨ ਵਿੱਚ ਨੇਕੀ ਨੂੰ ਰੌਸ਼ਨ ਕਰਨ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "रोसन जहान खूबी ॥",
      "sourceLineId": "86500",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਾਹਰ ਕਲੀਮ ਹਫਤ ਜਿ ॥",
      "transliteration": "jaahar kaleem hafat j ||",
      "translation": "“His qualities are known all over the world and he is famous in the seven regions of the world",
      "punjabiViakhya": "ਜੋ ਸੱਤਾ (ਹਫ਼ਤ) ਵਲਾਇਤਾ ਵਿੱਚ ਪ੍ਰਗਟ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "जाहर कलीम हफत जि ॥",
      "sourceLineId": "86501",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਆਲਮ ਖੁਸਾਇ ਜਲਵਾ ॥",
      "transliteration": "aalam khusai jalavaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਜਲਵਾ ਜਗਤ ਨੂੰ ਪ੍ਰਗਟ (ਕੁਸਾਇ) ਕਰਨ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "आलम खुसाइ जलवा ॥",
      "sourceLineId": "86502",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਵਹ ਗੁਲ ਚਿਹਰ ਕਹਾ ਹੈ ॥੬੬੬॥",
      "transliteration": "veh gul chihar kahaa hai ||666||",
      "translation": "He whose light hath spread throughout the world, where is that flower-faced Ram?666.",
      "punjabiViakhya": "ਉਹ ਫੁਲ ਵਰਗੇ ਮੁਖੜੇ ਵਾਲਾ ਕਿਥੇ ਹੈ? ॥੬੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "वह गुल चिहर कहा है ॥६६६॥",
      "sourceLineId": "86503",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜੀਤੇ ਬਜੰਗ ਜਾਲਮ ॥",
      "transliteration": "jeete baja(n)g jaalam ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਜ਼ਾਲਮ (ਰਾਵਣ) ਨੂੰ ਜੰਗ ਵਿੱਚ ਜਿੱਤਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "जीते बजंग जालम ॥",
      "sourceLineId": "86504",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕੀਨ ਖਤੰਗ ਪਰਰਾ ॥",
      "transliteration": "keen khata(n)g pararaa ||",
      "translation": "“He who conquered the tyrants with the blows of his arrows",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਤੀਰਾ ਨੂੰ ਪਰਾ ਵਾਲੇ (ਪੰਛੀ) ਬਣਾ ਦਿੱਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "कीन खतंग पररा ॥",
      "sourceLineId": "86505",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0269_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪੁਹਪਕ ਬਿਬਾਨ ਬੈਠੇ ॥",
      "transliteration": "puhapak bibaan baiThe ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਪੁਸ਼ਪਕ ਬਿਮਾਨ ਵਿੱਚ ਬੈਠੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": "पुहपक बिबान बैठे ॥",
      "sourceLineId": "86506",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
