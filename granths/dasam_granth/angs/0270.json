{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 270,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0270_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੀਤਾ ਰਵਨ ਕਹਾ ਹੈ ॥੬੬੭॥",
      "transliteration": "seetaa ravan kahaa hai ||667||",
      "translation": "Where is he who mouth the air-vehicle Pushapak and accompanies Sita?667.",
      "punjabiViakhya": "ਉਹ ਸੀਤਾ ਨਾਲ ਰਮਣ ਕਰਨ ਵਾਲਾ ਕਿਥੇ ਹੈ? ॥੬੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "सीता रवन कहा है ॥६६७॥",
      "sourceLineId": "86507",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਾਦਰ ਖੁਸਾਲ ਖਾਤਰ ॥",
      "transliteration": "maadhar khusaal khaatar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਮਾਤਾ (ਮਾਦਰ ਕੈਕਈ) ਨੂੰ ਖੁਸ਼ (ਖੁਸਾਲਿ) ਕਰਨ ਵਾਸਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "मादर खुसाल खातर ॥",
      "sourceLineId": "86508",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕੀਨੇ ਹਜਾਰ ਛਾਵਰ ॥",
      "transliteration": "keene hajaar chhaavar ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਹਜ਼ਾਰਾ (ਸੁੱਖ) ਨਿਛਾਵਰ ਕੀਤੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "कीने हजार छावर ॥",
      "sourceLineId": "86509",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਾਤੁਰ ਸਿਤਾ ਬਧਾਈ ॥",
      "transliteration": "maatur sitaa badhaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ ਮਿਲਣ ਲਈ) ਮਾਤਾ ਛੇਤੀ ਨਾਲ ਭੱਜੀ ਆਉਾਂਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "मातुर सिता बधाई ॥",
      "sourceLineId": "86510",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਵਹ ਗੁਲ ਚਿਹਰ ਕਹਾ ਹੈ ॥੬੬੮॥",
      "transliteration": "veh gul chihar kahaa hai ||668||",
      "translation": "“He who sacrificed thousands of his joys in order to please his mother, where is he? The mother Sita may also be congratulate today, but someone may tell us where is that flower-faced Ram?”668.",
      "punjabiViakhya": "(ਅਤੇ ਪੁੱਛਦੀ ਹੈ), ਉਹ ਗੁਲਾਬ ਜਿਹੇ ਮੁਖੜੇ ਵਾਲਾ (ਮੇਰਾ ਰਾਮ) ਕਿਥੇ ਹੈ? ॥੬੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "वह गुल चिहर कहा है ॥६६८॥",
      "sourceLineId": "86511",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਰਾਮ ਅਵਤਾਰ ਸੀਤਾ ਅਯੁਧਿਆ ਆਗਮ ਨਾਮ ਧਿਆਇ ਸਮਾਪਤੰ ॥",
      "transliteration": "eit sree raam avataar seetaa ayudhiaa aagam naam dhiaai samaapata(n) ||",
      "translation": "End of the chapter entitled ‘The Entry of Sita in Ayodhya’ in Ramvatar.",
      "punjabiViakhya": "ਇਥੇ ਰਾਮ ਅਵਤਾਰ ਦੇ ਅਯੁਧਿਆ ਵਿੱਚ ਆਗਮਨ ਨਾ ਵਾਲੇ ਅਧਿਆਇ ਦੀ ਸਮਾਪਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "इति स्री राम अवतार सीता अयुधिआ आगम नाम धिआइ समापतं ॥",
      "sourceLineId": "86512",
      "sourceShabadId": "8048",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਥ ਮਾਤਾ ਮਿਲਣੰ ॥",
      "transliteration": "ath maataa milana(n) ||",
      "translation": "Now begins the description of the Meeting with the Mother :",
      "punjabiViakhya": "ਹੁਣ ਮਾਤਾ-ਮਿਲਣ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "अथ माता मिलणं ॥",
      "sourceLineId": "86513",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASSVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "86514",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੁਨੇ ਰਾਮ ਆਏ ॥",
      "transliteration": "sune raam aae ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦੋਂ ਅਯੁਧਿਆ ਨਿਵਾਸੀਆਂ ਨੇ) ਸੁਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "सुने राम आए ॥",
      "sourceLineId": "86515",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਭੈ ਲੋਗ ਧਾਏ ॥",
      "transliteration": "sabhai log dhaae ||",
      "translation": "When the people heard that Ram had returned, then all the people ran and fell at his feet",
      "punjabiViakhya": "ਕਿ ਸ੍ਰੀ ਰਾਮ ਆਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "सभै लोग धाए ॥",
      "sourceLineId": "86516",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਲਗੇ ਆਨ ਪਾਯੰ ॥",
      "transliteration": "lage aan paaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਲੋਕ (ਦੀਦਾਰ ਕਰਨ ਲਈ) ਭਜ ਪਏ,",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "लगे आन पायं ॥",
      "sourceLineId": "86517",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮਿਲੇ ਰਾਮ ਰਾਯੰ ॥੬੬੯॥",
      "transliteration": "mile raam raaya(n) ||669||",
      "translation": "Ram met all of them.669.",
      "punjabiViakhya": "ਆ ਕੇ ਉਨ੍ਰਹਾ ਦੇ ਪੈਰੀਂ ਪਏ। ਰਾਜਾ ਰਾਮ ਵੀ (ਸਭ ਨੂੰ) ਮਿਲੇ ॥੬੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "मिले राम रायं ॥६६९॥",
      "sourceLineId": "86518",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕੋਊ ਚਉਰ ਢਾਰੈਂ ॥",
      "transliteration": "kouoo chaur ddaarai(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸ੍ਰੀ ਰਾਮ ਨੂੰ ਆ ਕੇ) ਕੋਈ ਚੌਰ ਕਰਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "कोऊ चउर ढारैं ॥",
      "sourceLineId": "86519",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕੋਊ ਪਾਨ ਖੁਆਰੈਂ ॥",
      "transliteration": "kouoo paan khuaarai(n) ||",
      "translation": "Someone swung she fly-whisk, someone offered the betel",
      "punjabiViakhya": "ਕੋਈ ਪਾਨ ਖੁਆਉਾਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "कोऊ पान खुआरैं ॥",
      "sourceLineId": "86520",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪਰੇ ਮਾਤ ਪਾਯੰ ॥",
      "transliteration": "pare maat paaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੀ ਰਾਮ ਜਾ ਕੇ ਮਾਤਾ ਦੀ ਚਰਨੀਂ ਲੱਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "परे मात पायं ॥",
      "sourceLineId": "86521",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਲਏ ਕੰਠ ਲਾਯੰ ॥੬੭੦॥",
      "transliteration": "le ka(n)Th laaya(n) ||670||",
      "translation": "Ram fell at the feet of his mother and his mothers hugged him to their bosom.670.",
      "punjabiViakhya": "(ਮਾਤਾ ਨੇ) ਗਲ ਨਾਲ ਲਾ ਲਿਆ ॥੬੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "लए कंठ लायं ॥६७०॥",
      "sourceLineId": "86522",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਿਲੈ ਕੰਠ ਰੋਵੈਂ ॥",
      "transliteration": "milai ka(n)Th rovai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਗਲ ਮਿਲ ਕੇ ਦੋਵੇਾਂ (ਮਾਤਾ ਅਤੇ ਪੁੱਤਰ) ਰੋਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "मिलै कंठ रोवैं ॥",
      "sourceLineId": "86523",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਨੋ ਸੋਕ ਧੋਵੈਂ ॥",
      "transliteration": "mano sok dhovai(n) ||",
      "translation": "On being hugged he was weeping in order to wash away all his suffering",
      "punjabiViakhya": "ਮਾਨੋ (ਮਨ ਦਾ) ਸ਼ੋਕ ਧੋ ਰਹੇ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "मनो सोक धोवैं ॥",
      "sourceLineId": "86524",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਰੈਂ ਬੀਰ ਬਾਤੈਂ ॥",
      "transliteration": "karai(n) beer baatai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਯੁੱਧ-ਵੀਰ (ਸ੍ਰੀ ਰਾਮ) ਗੱਲਾ ਕਰਨ ਲੱਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "करैं बीर बातैं ॥",
      "sourceLineId": "86525",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੁਨੇ ਸਰਬ ਮਾਤੈਂ ॥੬੭੧॥",
      "transliteration": "sune sarab maatai(n) ||671||",
      "translation": "The brave Ram began to talk and all the mothers listened.671.",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ) ਸਾਰੀਆਂ ਨੂੰ ਮਾਤਾ ਸੁਣਨ ਲਗੀ ॥੬੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "सुने सरब मातैं ॥६७१॥",
      "sourceLineId": "86526",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਿਲੈ ਲੱਛ ਮਾਤੰ ॥",
      "transliteration": "milai la'chh maata(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਲੱਛਮਣ ਦੀ ਮਾਤਾ ਨੂੰ ਮਿਲੇ।",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "मिलै लच्छ मातं ॥",
      "sourceLineId": "86527",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪਰੇ ਪਾਇ ਭ੍ਰਾਤੰ ॥",
      "transliteration": "pare pai bhraata(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਦੋਵੇਾਂ) ਭਰਾ (ਉਸ ਦੇ) ਪੈਰੀਂ ਪੈ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "परे पाइ भ्रातं ॥",
      "sourceLineId": "86528",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਰਿਯੋ ਦਾਨ ਏਤੋ ॥",
      "transliteration": "kariyo dhaan eto ||",
      "translation": "",
      "punjabiViakhya": "(ਸੁਮਿਤ੍ਰਾ) ਨੇ ਇਤਨਾ ਦਾਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "करियो दान एतो ॥",
      "sourceLineId": "86529",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0270_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗਨੈ ਕਉਨ ਕੇਤੋ ॥੬੭੨॥",
      "transliteration": "ganai kaun keto ||672||",
      "translation": "Then he met the mother of Lakshman and the brother Bharat and Shatrughan touched his feet. On account of the joy of union, unaccountable charity was given.672.",
      "punjabiViakhya": "ਕਿ ਉਸ ਨੂੰ ਕੌਣ ਗਿਣੇ ਕਿ ਕਿੰਨਾ ਕੁ ਸੀ? ॥੬੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": "गनै कउन केतो ॥६७२॥",
      "sourceLineId": "86530",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
