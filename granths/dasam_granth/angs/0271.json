{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 271,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0271_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਿਲੇ ਭਰਥ ਮਾਤੰ ॥",
      "transliteration": "mile bharath maata(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਭਰਤ ਦੀ ਮਾਤਾ (ਕੈਕਈ) ਨੂੰ ਮਿਲੇ",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "मिले भरथ मातं ॥",
      "sourceLineId": "86531",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਹੀ ਸਰਬ ਬਾਤੰ ॥",
      "transliteration": "kahee sarab baata(n) ||",
      "translation": "Then Ram met the mother of Bharat and told her all that happened with him",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੀਆਂ ਗੱਲਾ (ਉਸ ਨੂੰ) ਦਸੀਆਂ ਅਤੇ (ਕਿਹਾ)",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "कही सरब बातं ॥",
      "sourceLineId": "86532",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਧਨੰ ਮਾਤ ਤੋ ਕੋ ॥",
      "transliteration": "dhana(n) maat to ko ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮਾਤਾ! ਤੇਰਾ ਧੰਨਵਾਦ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "धनं मात तो को ॥",
      "sourceLineId": "86533",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਰਿਣੀ ਕੀਨ ਮੋ ਕੋ ॥੬੭੩॥",
      "transliteration": "arinee keen mo ko ||673||",
      "translation": "Ram said, “O mother, I am thankful to you because you have made me free from indebtedness.673.",
      "punjabiViakhya": "ਕਿ (ਤੂੰ ਮੈਨੂੰ ਪਿਤਾ ਦੇ) ਰਿਣ ਤੋਂ ਮੁਕਤ ਕੀਤਾ ਹੈ ॥੬੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "अरिणी कीन मो को ॥६७३॥",
      "sourceLineId": "86534",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਹਾ ਦੋਸ ਤੇਰੈ ॥",
      "transliteration": "kahaa dhos terai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਵਿੱਚ) ਤੇਰਾ ਕੀ ਦੋਸ਼ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "कहा दोस तेरै ॥",
      "sourceLineId": "86535",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਲਿਖੀ ਲੇਖ ਮੇਰੈ ॥",
      "transliteration": "likhee lekh merai ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਭਾਗਾ ਵਿੱਚ (ਅਜਿਹੀ ਗੱਲ) ਲਿਖੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "लिखी लेख मेरै ॥",
      "sourceLineId": "86536",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹੁਨੀ ਹੋ ਸੁ ਹੋਈ ॥",
      "transliteration": "hunee ho su hoiee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਹੋਣੀ ਸੀ, ਉਹੀ ਹੋਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "हुनी हो सु होई ॥",
      "sourceLineId": "86537",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਹੈ ਕਉਨ ਕੋਈ ॥੬੭੪॥",
      "transliteration": "kahai kaun koiee ||674||",
      "translation": "“You are not to be blamed for this, because it was recorded in my destiny, whatever happens, has to happen, none can describe it.”674.",
      "punjabiViakhya": "(ਇਸ ਵਿੱਚ) ਕੋਈ ਕੀ ਕਹਿ ਸਕਦਾ ਹੈ ॥੬੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "कहै कउन कोई ॥६७४॥",
      "sourceLineId": "86538",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਰੋ ਬੋਧ ਮਾਤੰ ॥",
      "transliteration": "karo bodh maata(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕੈਕਈ) ਮਾਤਾ ਨੂੰ (ਇਸ ਤਰ੍ਰਹਾ ਦਾ) ਗਿਆਨ ਉਪਦੇਸ਼ ਦੇ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "करो बोध मातं ॥",
      "sourceLineId": "86539",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਿਲਯੋ ਫੇਰਿ ਭ੍ਰਾਤੰ ॥",
      "transliteration": "milayo fer bhraata(n) ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਭਰਾ ਨੂੰ ਮਿਲੇ।",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "मिलयो फेरि भ्रातं ॥",
      "sourceLineId": "86540",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੁਨਯੋ ਭਰਥ ਧਾਏ ॥",
      "transliteration": "sunayo bharath dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਭਰਤ ਸੁਣਦਿਆਂ ਹੀ ਦੌੜ ਕੇ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "सुनयो भरथ धाए ॥",
      "sourceLineId": "86541",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪਗੰ ਸੀਸ ਲਾਏ ॥੬੭੫॥",
      "transliteration": "paga(n) sees laae ||675||",
      "translation": "He pacified his mother in this way and then he met his brother Bharat. Bharat on hearing his arrival ran towards him and touched his head with the feet of Ram.675.",
      "punjabiViakhya": "ਅਤੇ (ਸ੍ਰੀ ਰਾਮ) ਦੇ ਚਰਨਾ ਉਤੇ ਸਿਰ ਰੱਖ ਦਿੱਤਾ ॥੬੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "पगं सीस लाए ॥६७५॥",
      "sourceLineId": "86542",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭਰੇ ਰਾਮ ਅੰਕੰ ॥",
      "transliteration": "bhare raam a(n)ka(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੀ ਰਾਮ ਨੇ ਉਸ (ਭਰਤ) ਨੂੰ ਜੱਫੀ ਵਿੱਚ ਲੈ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "भरे राम अंकं ॥",
      "sourceLineId": "86543",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਿਟੀ ਸਰਬ ਸੰਕੰ ॥",
      "transliteration": "miTee sarab sa(n)ka(n) ||",
      "translation": "Ram hugged him to his bosom and cleared all the doubts",
      "punjabiViakhya": "ਅਤੇ (ਭਰਤ ਦੇ ਮਨ) ਦੀ ਸਾਰੀ ਸ਼ੰਕਾ ਖ਼ਤਮ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "मिटी सरब संकं ॥",
      "sourceLineId": "86544",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਿਲਯੰ ਸੱਤ੍ਰ ਹੰਤਾ ॥",
      "transliteration": "milaya(n) sa'tr ha(n)taa ||",
      "translation": "",
      "punjabiViakhya": "ਇੰਨੇ ਨੂੰ ਸ਼ਤਰੂਘਨ ਆਣ ਮਿਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "मिलयं सत्त्र हंता ॥",
      "sourceLineId": "86545",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਰੰ ਸਾਸਤ੍ਰ ਗੰਤਾ ॥੬੭੬॥",
      "transliteration": "sara(n) saasatr ga(n)taa ||676||",
      "translation": "Then he met Shatrugan, who had expert knowledge of weapons and Shastras.676.",
      "punjabiViakhya": "ਜੋ ਸ੍ਰੇਸ਼ਠ ਸ਼ਾਸਤ੍ਰਾ ਦਾ ਗਿਆਤਾ ਸੀ ॥੬੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "सरं सासत्र गंता ॥६७६॥",
      "sourceLineId": "86546",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਟੰ ਧੂਰ ਝਾਰੀ ॥",
      "transliteration": "jaTa(n) dhoor jhaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਸ਼ਤਰੂਘਨ ਯੋਧੇ ਨੇ) ਆਪਣੀਆਂ ਜਟਾ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "जटं धूर झारी ॥",
      "sourceLineId": "86547",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪਗੰ ਰਾਮ ਰਾਰੀ ॥",
      "transliteration": "paga(n) raam raaree ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੀ ਰਾਮ ਦੇ ਚਰਨਾ ਦੀ ਧੂੜ ਨੂੰ ਝਾੜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "पगं राम रारी ॥",
      "sourceLineId": "86548",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਰੀ ਰਾਜ ਅਰਚਾ ॥",
      "transliteration": "karee raaj arachaa ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਰਾਜਿਆਂ ਨੇ (ਰਾਮ ਦੀ) ਪੂਜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "करी राज अरचा ॥",
      "sourceLineId": "86549",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦਿਜੰ ਬੇਦ ਚਰਚਾ ॥੬੭੭॥",
      "transliteration": "dhija(n) bedh charachaa ||677||",
      "translation": "The brothers cleansed the dust from the feet and matted hair of Ram. They worlshipped him in royal way and the Brahmins recited the Vedas.677.",
      "punjabiViakhya": "(ਬਾਦ ਵਿੱਚ) ਬ੍ਰਾਹਮਣਾ ਨੇ ਵੇਦ ਪਾਠ ਕੀਤਾ ॥੬੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "दिजं बेद चरचा ॥६७७॥",
      "sourceLineId": "86550",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਰੈਂ ਗੀਤ ਗਾਨੰ ॥",
      "transliteration": "karai(n) geet gaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਖੁਸ਼ੀ ਦੇ ਗੀਤ ਗਾਉਾਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "करैं गीत गानं ॥",
      "sourceLineId": "86551",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਭਰੇ ਵੀਰ ਮਾਨੰ ॥",
      "transliteration": "bhare veer maana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਵੀਰ ਸੂਰਮਤਾਈ ਦੇ ਮਾਣ ਨਾਲ ਭਰੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "भरे वीर मानं ॥",
      "sourceLineId": "86552",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦੀਯੰ ਰਾਮ ਰਾਜੰ ॥",
      "transliteration": "dheeya(n) raam raaja(n) ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਰਾਮ ਜੀ ਨੂੰ ਰਾਜ ਦਿੱਤਾ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "दीयं राम राजं ॥",
      "sourceLineId": "86553",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਰੇ ਸਰਬ ਕਾਜੰ ॥੬੭੮॥",
      "transliteration": "sare sarab kaaja(n) ||678||",
      "translation": "All the brothers sang full of love. Ram was made the king and all the works were completed in this way.678.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਕਾਰਜ ਪੂਰੇ ਹੋ ਗਏ ॥੬੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "सरे सरब काजं ॥६७८॥",
      "sourceLineId": "86554",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬੁਲੈ ਬਿੱਪ ਲੀਨੇ ॥",
      "transliteration": "bulai bi'p leene ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਬ੍ਰਾਹਮਣ ਬੁਲਾ ਲਏ,",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "बुलै बिप्प लीने ॥",
      "sourceLineId": "86555",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸ੍ਰੁੱਤੋਚਾਰ ਕੀਨੇ ॥",
      "transliteration": "sru'tochaar keene ||",
      "translation": "The Brahmins were called in and with the recitation of Vedic mantras Ram was enthroned",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨੇ) ਵੇਦਾ ਦਾ ਪਾਠ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "स्रुत्तोचार कीने ॥",
      "sourceLineId": "86556",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਭਏ ਰਾਮ ਰਾਜਾ ॥",
      "transliteration": "bhe raam raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਜਦ ਰਾਮ ਜੀ ਰਾਜਾ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "भए राम राजा ॥",
      "sourceLineId": "86557",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਜੇ ਜੀਤ ਬਾਜਾ ॥੬੭੯॥",
      "transliteration": "baje jeet baajaa ||679||",
      "translation": "On all the four sides resounded the musical instruments denoting victory.679.",
      "punjabiViakhya": "ਤਾ ਜਿੱਤ ਦੇ ਵਾਜੇ ਵਜਣ ਲੱਗੇ ॥੬੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "बजे जीत बाजा ॥६७९॥",
      "sourceLineId": "86558",
      "sourceShabadId": "8049",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "86559",
      "sourceShabadId": "8050",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚਹੂੰ ਚੱਕ ਕੇ ਛੱਤ੍ਰਧਾਰੀ ਬੁਲਾਏ ॥",
      "transliteration": "chahoo(n) cha'k ke chha'tradhaaree bulaae ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ ਛੱਤਰਧਾਰੀ ਰਾਜੇ ਬੁਲਾ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "चहूँ चक्क के छत्त्रधारी बुलाए ॥",
      "sourceLineId": "86560",
      "sourceShabadId": "8050",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਧਰੇ ਅੱਤ੍ਰ ਨੀਕੇ ਪੁਰੀ ਅਉਧ ਆਏ ॥",
      "transliteration": "dhare a'tr neeke puree aaudh aae ||",
      "translation": "The sovereigns were called from all the four directions and they all reached Avadhpuri",
      "punjabiViakhya": "ਜੋ ਉਤਮ ਅਸਤ੍ਰ ਧਾਰਨ ਕਰਕੇ ਅਯੁਧਿਆ ਪੁਰੀ ਵਿੱਚ ਆਏ।",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "धरे अत्त्र नीके पुरी अउध आए ॥",
      "sourceLineId": "86561",
      "sourceShabadId": "8050",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗਹੇ ਰਾਮ ਪਾਯੰ ਪਰਮ ਪ੍ਰੀਤ ਕੈ ਕੈ ॥",
      "transliteration": "gahe raam paaya(n) param preet kai kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਵੱਡੀ ਪ੍ਰੀਤ ਕਰਕੇ ਸ੍ਰੀ ਰਾਮ ਦੇ ਚਰਨ ਫੜ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "गहे राम पायं परम प्रीत कै कै ॥",
      "sourceLineId": "86562",
      "sourceShabadId": "8050",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਿਲੇ ਚੱਤ੍ਰ ਦੇਸੀ ਬਡੀ ਭੇਟ ਦੈ ਕੈ ॥੬੮੦॥",
      "transliteration": "mile cha'tr dhesee baddee bheT dhai kai ||680||",
      "translation": "They all fell at the feet of Ram, exhibiting their supreme love and met him with great presents.680.",
      "punjabiViakhya": "ਚੌਹਾ ਦਿਸ਼ਾਵਾ ਦੇ ਰਾਜੇ ਵੱਡੀਆਂ ਭੇਟਾ ਦੇ ਕੇ ਸ੍ਰੀ ਰਾਮ ਨੂੰ ਮਿਲੇ ॥੬੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "मिले चत्त्र देसी बडी भेट दै कै ॥६८०॥",
      "sourceLineId": "86563",
      "sourceShabadId": "8050",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦਏ ਚੀਨ ਮਾਚੀਨ ਚੀਨੰਤ ਦੇਸੰ ॥",
      "transliteration": "dhe cheen maacheen cheena(n)t dhesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਿਆਂ ਨੇ ਚੀਨ ਮਚੀਨ ਦੇਸ਼ ਦੀਆਂ ਸੁਗਾਤਾ (ਚੀਨੰਤ) ਦਿੱਤੀਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "दए चीन माचीन चीनंत देसं ॥",
      "sourceLineId": "86564",
      "sourceShabadId": "8050",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਹਾ ਸੁੰਦ੍ਰੀ ਚੇਰਕਾ ਚਾਰ ਕੇਸੰ ॥",
      "transliteration": "mahaa su(n)dhree cherakaa chaar kesa(n) ||",
      "translation": "The kings presented gifts from various and beautiful maidens of elegant hair.",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਵਿੱਚ ਸੋਹਣੇ ਕੇਸਾ ਵਾਲੀਆਂ ਅਤਿ ਸੁੰਦਰ ਦਾਸੀਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "महा सुँद्री चेरका चार केसं ॥",
      "sourceLineId": "86565",
      "sourceShabadId": "8050",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮਨੰ ਮਾਨਕੰ ਹੀਰ ਚੀਰੰ ਅਨੇਕੰ ॥",
      "transliteration": "mana(n) maanaka(n) heer cheera(n) aneka(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੇਕਾ ਮਣੀਆਂ, ਮਾਣਕ, ਹੀਰੇ ਤੇ ਕੱਪੜੇ ਸਨ। (ਜੇ) ਖੋਜ ਕੀਤੀ ਜਾਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "मनं मानकं हीर चीरं अनेकं ॥",
      "sourceLineId": "86566",
      "sourceShabadId": "8050",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕੀਏ ਖੇਜ ਪੱਈਯੈ ਕਹੂੰ ਏਕ ਏਕੰ ॥੬੮੧॥",
      "transliteration": "ke'ee khej pa'ieeyai kahoo(n) ek eka(n) ||681||",
      "translation": "They also presented rare gems. Jewels and garments 681.",
      "punjabiViakhya": "ਤਾ (ਉਨ੍ਰਹਾ ਵਰਗੀ) ਕਿਤੇ ਕੋਈ ਇਕ ਇਕ ਹੀ ਮਿਲ ਸਕਦੀ ਹੈ ॥੬੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "कीए खेज पई्ईयै कहूँ एक एकं ॥६८१॥",
      "sourceLineId": "86567",
      "sourceShabadId": "8050",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਨੰ ਮੁੱਤੀਯੰ ਮਾਨਕੰ ਬਾਜ ਰਾਜੰ ॥",
      "transliteration": "mana(n) mu'teeya(n) maanaka(n) baaj raaja(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਸੇ ਨੇ) ਮਣੀਆਂ, ਮੋਤੀ, ਮਾਣਕ, ਸ਼੍ਰੇਸਠ ਘੋੜੇ",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "मनं मुत्तीयं मानकं बाज राजं ॥",
      "sourceLineId": "86568",
      "sourceShabadId": "8050",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦਏ ਦੰਤਪੰਤੀ ਸਜੇ ਸਰਬ ਸਾਜੰ ॥",
      "transliteration": "dhe dha(n)tapa(n)tee saje sarab saaja(n) ||",
      "translation": "They presented winsome horses, jewels, gems, pearls as well as elephants",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਸਾਜ਼ੋ-ਸਾਮਾਨ ਨਾਲ ਸਜੇ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "दए दंतपंती सजे सरब साजं ॥",
      "sourceLineId": "86569",
      "sourceShabadId": "8050",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰਥੰ ਬੇਸਟੰ ਹੀਰ ਚੀਰੰ ਅਨੰਤੰ ॥",
      "transliteration": "ratha(n) besaTa(n) heer cheera(n) ana(n)ta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਥੀਆਂ ਦੀਆਂ ਕਤਾਰਾ ਦਿੱਤੀਆਂ ਸਨ। (ਕਿਸੇ ਨੇ) ਹੀਰਿਆਂ ਨਾਲ ਜੜ੍ਰਹੇ ਬਸਤ੍ਰ ਅਤੇ ਅਨੰਤ ਰਥ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "रथं बेसटं हीर चीरं अनंतं ॥",
      "sourceLineId": "86570",
      "sourceShabadId": "8050",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮਨੰ ਮਾਨਕੰ ਬੱਧ ਰੱਧੰ ਦੁਰੰਤੰ ॥੬੮੨॥",
      "transliteration": "mana(n) maanaka(n) ba'dh ra'dha(n) dhura(n)ta(n) ||682||",
      "translation": "The chariots, diamonds, raiments and invaluable precious stones were also presented.682.",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨਾਲ ਮਣੀ ਅਤੇ ਮਾਣਕਾ ਦੇ ਅਮੋਲਕ ਗੁੱਛੇ ਬੰਨ੍ਰਹੇ ਹੋਏ ਸਨ ॥੬੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "मनं मानकं बद्ध रद्धं दुरंतं ॥६८२॥",
      "sourceLineId": "86571",
      "sourceShabadId": "8050",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਿਤੇ ਸ੍ਵੇਤ ਐਰਾਵਤੰ ਤੁੱਲਿ ਦੰਤੀ ॥",
      "transliteration": "kite savaiet aairaavata(n) tu'l dha(n)tee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਨੇ ਸਫੈਦ ਐਰਾਵਤ ਵਰਗੇ ਹਾਥੀ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "किते स्वेत ऐरावतं तुल्लि दंती ॥",
      "sourceLineId": "86572",
      "sourceShabadId": "8050",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦਏ ਮੁੱਤਯੰ ਸਾਜ ਸੱਜੇ ਸੁਪੰਤੀ ॥",
      "transliteration": "dhe mu'taya(n) saaj sa'je supa(n)tee ||",
      "translation": "Somewhere the whit elephants bedecked with gems are being presented",
      "punjabiViakhya": "ਜੋ ਮੋਤੀਆਂ ਦੀਆਂ ਲੜੀਆਂ ਦੀ ਸਜਾਵਟ ਨਾਲ ਸੁਸਜਿਤ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "दए मुत्तयं साज सज्जे सुपंती ॥",
      "sourceLineId": "86573",
      "sourceShabadId": "8050",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਿਤੇ ਬਾਜ ਰਾਜੰ ਜਰੀ ਜੀਨ ਸੰਗੰ ॥",
      "transliteration": "kite baaj raaja(n) jaree jeen sa(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਨੇ ਜ਼ਰੀ ਦੀਆਂ ਜ਼ੀਨਾ ਸਹਿਤ ਸ੍ਰੇਸ਼ਠ ਘੋੜੇ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "किते बाज राजं जरी जीन संगं ॥",
      "sourceLineId": "86574",
      "sourceShabadId": "8050",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਚੈ ਨੱਟ ਮਾਨੋ ਮਚੇ ਜੰਗ ਰੰਗੰ ॥੬੮੩॥",
      "transliteration": "nachai na'T maano mache ja(n)g ra(n)ga(n) ||683||",
      "translation": "Somewhere the horses tightened with brocaded thick cloth are dancing exhibiting a spectacle of war. 683.",
      "punjabiViakhya": "ਜੋ ਨਟ ਵਾਗ ਨਚਦੇ ਸਨ, ਮਾਨੋ ਯੁੱਧ ਦੇ ਰੰਗ ਵਿੱਚ ਮੱਚੇ ਹੋਏ ਹੋਣ ॥੬੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "नचै नट्ट मानो मचे जंग रंगं ॥६८३॥",
      "sourceLineId": "86575",
      "sourceShabadId": "8050",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਿਤੇ ਪੱਖਰੇ ਪੀਲ ਰਾਜਾ ਪ੍ਰਮਾਣੰ ॥",
      "transliteration": "kite pa'khare peel raajaa pramaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਨੇ ਰਾਜਸੀ ਫਬ ਵਾਲੇ ਪਾਖਰਾ ਸਮੇਤ ਹਾਥੀ",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "किते पक्खरे पील राजा प्रमाणं ॥",
      "sourceLineId": "86576",
      "sourceShabadId": "8050",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦਏ ਬਾਜ ਰਾਜੀ ਸਿਰਾਜੀ ਨ੍ਰਿਪਾਣੰ ॥",
      "transliteration": "dhe baaj raajee siraajee nirapaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈਆਂ ਰਾਜਿਆਂ ਨੇ ਸ਼ੀਰਾਜ਼ ਸ਼ਹਿਰ ਦੇ ਉੱਤਮ ਘੋੜੇ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "दए बाज राजी सिराजी नृपाणं ॥",
      "sourceLineId": "86577",
      "sourceShabadId": "8050",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0271_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦਈ ਰਕਤ ਨੀਲੰ ਮਣੀ ਰੰਗ ਰੰਗੰ ॥",
      "transliteration": "dhiee rakat neela(n) manee ra(n)g ra(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਲਾਲ ਰੰਗ ਦੀਆਂ (ਅਤੇ ਕਿਸੇ ਨੇ) ਨੀਲੇ ਰੰਗ ਦੀਆਂ ਅਤੇ ਹੋਰ ਰੰਗ ਬਰੰਗੀਆਂ ਮਣੀਆਂ ਭੇਟ ਕੀਤੀਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": "दई रकत नीलं मणी रंग रंगं ॥",
      "sourceLineId": "86578",
      "sourceShabadId": "8050",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
