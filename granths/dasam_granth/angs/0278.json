  "lines": [
    {
      "id": "dasam_ang_0278_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚਲਾਏ ॥",
      "transliteration": "chalaae ||",
      "translation": "",
      "punjabiViakhya": "(ਲਵ ਅਤੇ ਕੁਸ਼ ਨੇ ਤੀਰ) ਚਲਾਏ,",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "चलाए ॥",
      "sourceLineId": "86819",
      "sourceShabadId": "8058",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪਚਾਏ ॥",
      "transliteration": "pachaae ||",
      "translation": "",
      "punjabiViakhya": "ਲਲਕਾਰੇ ਮਾਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "पचाए ॥",
      "sourceLineId": "86820",
      "sourceShabadId": "8058",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤ੍ਰਸਾਏ ॥",
      "transliteration": "trasaae ||",
      "translation": "",
      "punjabiViakhya": "(ਵੈਰੀ ਨੂੰ) ਡਰਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "त्रसाए ॥",
      "sourceLineId": "86821",
      "sourceShabadId": "8058",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚੁਟਆਏ ॥੭੪੨॥",
      "transliteration": "chuTaae ||742||",
      "translation": "The warriors were discharged, endured and the warriors were made fearful.742.",
      "punjabiViakhya": "ਅਤੇ ਚੰਗੇ ਨਿਸ਼ਾਨੇ ਫੁੰਡੇ ॥੭੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "चुटआए ॥७४२॥",
      "sourceLineId": "86822",
      "sourceShabadId": "8058",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਇਤਿ ਲਵ ਬਾਧਵੋ ਸਤ੍ਰੁਘਣ ਬਧਹਿ ਸਮਾਪਤ ॥",
      "transliteration": "eit lav baadhavo satrughan badheh samaapat ||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਲਵ ਦੁਆਰਾ ਘੋੜਾ ਛੱਡਣ ਅਤੇ ਸ਼ਤਰੂਘਨ ਦੇ ਬਧ ਪ੍ਰਸੰਗ ਦੀ ਸਮਾਪਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "इति लव बाधवो सत्रुघण बधहि समापत ॥",
      "sourceLineId": "86823",
      "sourceShabadId": "8058",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਥ ਲਛਮਨ ਜੁਧ ਕਥਨੰ ॥",
      "transliteration": "ath lachhaman judh kathana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਲੱਛਮਣ ਦੇ ਯੁੱਧ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "अथ लछमन जुध कथनं ॥",
      "sourceLineId": "86824",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਣਕਾ ਛੰਦ ॥",
      "transliteration": "anakaa chha(n)dh ||",
      "translation": "ANKA STANZA",
      "punjabiViakhya": "ਅਣਕਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "अणका छंद ॥",
      "sourceLineId": "86825",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਬ ਸਰ ਲਾਗੇ ॥",
      "transliteration": "jab sar laage ||",
      "translation": "",
      "punjabiViakhya": "(ਲਵ ਅਤੇ ਕੁਸ਼ ਦੇ) ਜਦੋਂ ਤੀਰ ਲੱਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "जब सर लागे ॥",
      "sourceLineId": "86826",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਬ ਸਭ ਭਾਗੇ ॥",
      "transliteration": "tab sabh bhaage ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ (ਰਾਮ ਦੇ) ਸਾਰੇ ਸੂਰਮੇ ਭੱਜ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "तब सभ भागे ॥",
      "sourceLineId": "86827",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦਲਪਤਿ ਮਾਰੇ ॥",
      "transliteration": "dhalapat maare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ) ਸੈਨਾਪਤੀ ਮਾਰੇ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "दलपति मारे ॥",
      "sourceLineId": "86828",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭਟ ਭਟਕਾਰੇ ॥੭੪੩॥",
      "transliteration": "bhaT bhaTakaare ||743||",
      "translation": "When the arrows struck, then all ran away  the generals were killed and the warriors ran hither and thither.743.",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਭਜਾ ਦਿੱਤੇ ਗਏ ॥੭੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "भट भटकारे ॥७४३॥",
      "sourceLineId": "86829",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਯ ਤਜ ਭਾਗੇ ॥",
      "transliteration": "hay taj bhaage ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈ ਯੋਧੇ) ਘੋੜੇ ਛੱਡ ਕੇ ਭੱਜ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "हय तज भागे ॥",
      "sourceLineId": "86830",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਘੁਬਰ ਆਗੇ ॥",
      "transliteration": "raghubar aage ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ੍ਰੀ ਰਾਮ ਅੱਗੇ ਜਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "रघुबर आगे ॥",
      "sourceLineId": "86831",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਹੁ ਬਿਧ ਰੋਵੈਂ ॥",
      "transliteration": "bahu bidh rovai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਰੋਣ ਲੱਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "बहु बिध रोवैं ॥",
      "sourceLineId": "86832",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਮੁਹਿ ਨ ਜੋਵੈਂ ॥੭੪੪॥",
      "transliteration": "samuh na jovai(n) ||744||",
      "translation": "Leaving their horses, they ran towards Ram and lamenting in various ways, they had no courage to come face to face.744.",
      "punjabiViakhya": "ਪਰ ਸ਼ਰਮ ਦੇ ਮਾਰੇ ਸਾਹਮਣੇ ਨਹੀਂ ਵੇਖ ਸਕਦੇ ॥੭੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "समुहि न जोवैं ॥७४४॥",
      "sourceLineId": "86833",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਲਵ ਅਰ ਮਾਰੇ ॥",
      "transliteration": "lav ar maare ||",
      "translation": "",
      "punjabiViakhya": "(ਹੇ ਰਾਮ ਜੀ!) ਲਵ ਨੇ ਵੈਰੀਆਂ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "लव अर मारे ॥",
      "sourceLineId": "86834",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਵ ਦਲ ਹਾਰੇ ॥",
      "transliteration": "tav dhal haare ||",
      "translation": "(The soldiers said to Ram :) “Lava, killing the enemies, has defeated your army",
      "punjabiViakhya": "ਤੁਹਾਡੀ ਸੈਨਾ ਹਾਰ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "तव दल हारे ॥",
      "sourceLineId": "86835",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦ੍ਵੈ ਸਿਸ ਜੀਤੇ ॥",
      "transliteration": "dhavai sis jeete ||",
      "translation": "",
      "punjabiViakhya": "ਦੋ ਬਾਲਕ ਜਿੱਤ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "द्वै सिस जीते ॥",
      "sourceLineId": "86836",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਹ ਭਯ ਭੀਤੇ ॥੭੪੫॥",
      "transliteration": "neh bhay bheete ||745||",
      "translation": "Those two boys are fearlessly waging the war and have gained victory,”745.",
      "punjabiViakhya": "(ਉਹ) ਡਰ ਨਹੀਂ ਮੰਨਦੇ ॥੭੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "नह भय भीते ॥७४५॥",
      "sourceLineId": "86837",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਲਛਮਨ ਭੇਜਾ ॥",
      "transliteration": "lachhaman bhejaa ||",
      "translation": "",
      "punjabiViakhya": "(ਸ੍ਰੀ ਰਾਮ ਨੇ) ਲੱਛਮਣ ਨੂੰ ਭੇਜਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "लछमन भेजा ॥",
      "sourceLineId": "86838",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਹੁ ਦਲ ਲੇਜਾ ॥",
      "transliteration": "bahu dhal lejaa ||",
      "translation": "Ram asked Lakshman to take a huge army and sent him",
      "punjabiViakhya": "(ਉਸ ਨੂੰ ਕਿਹਾ ਕਿ) ਬਹੁਤ ਸਾਰੀ ਸੈਨਾ ਲੈ ਜਾਓ,",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "बहु दल लेजा ॥",
      "sourceLineId": "86839",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਨ ਸਿਸ ਮਾਰੂ ॥",
      "transliteration": "jin sis maaroo ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਬੱਚਿਆਂ ਨੂੰ ਮਾਰਨਾ ਨਹੀਂ,",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "जिन सिस मारू ॥",
      "sourceLineId": "86840",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮੋਹਿ ਦਿਖਾਰੂ ॥੭੪੬॥",
      "transliteration": "moh dhikhaaroo ||746||",
      "translation": "He said to him, “Do not kill those boys, but catch hold of them and show them to me.”746.",
      "punjabiViakhya": "ਮੈਨੂੰ ਲਿਆ ਕੇ ਵਿਖਾਓ ॥੭੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "मोहि दिखारू ॥७४६॥",
      "sourceLineId": "86841",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੁਣ ਲਹੁ ਭ੍ਰਾਤੰ ॥",
      "transliteration": "sun lahu bhraata(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੀ ਰਾਮ ਦੀ ਗੱਲ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "सुण लहु भ्रातं ॥",
      "sourceLineId": "86842",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਰਘੁਬਰ ਬਾਤੰ ॥",
      "transliteration": "raghubar baata(n) ||",
      "translation": "",
      "punjabiViakhya": "ਲੱਛਮਣ ਨੇ ਸੁਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "रघुबर बातं ॥",
      "sourceLineId": "86843",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਜਿ ਦਲ ਚੱਲਯੋ ॥",
      "transliteration": "saj dhal cha'layo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸੈਨਾ ਸਜਾ ਕੇ ਚੱਲ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "सजि दल चल्लयो ॥",
      "sourceLineId": "86844",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਲ ਥਲ ਹੱਲਯੋ ॥੭੪੭॥",
      "transliteration": "jal thal ha'layo ||747||",
      "translation": "Hearing the words of Raghuvir, Lakshman started, decorating his forces and sharing the waters and the planes.747.",
      "punjabiViakhya": "(ਉਸ ਵੇਲੇ) ਜਲ ਥਲ ਹਿੱਲ ਗਿਆ ॥੭੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "जल थल हल्लयो ॥७४७॥",
      "sourceLineId": "86845",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਉਠ ਦਲ ਧੂਰੰ ॥",
      "transliteration": "auTh dhal dhoora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦਲਾ ਦੇ ਚੱਲਣ ਨਾਲ ਉਠੀ ਗਰਦ ਨੇ ਆਕਾਸ਼ ਵਿੱਚ ਫੈਲ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "उठ दल धूरं ॥",
      "sourceLineId": "86846",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਭ ਝੜ ਪੂਰੰ ॥",
      "transliteration": "nabh jhaR poora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬੱਦਲਵਾਹੀ ਵਰਗੀ ਹਾਲਤ ਕਰ ਦਿੱਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "नभ झड़ पूरं ॥",
      "sourceLineId": "86847",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚਹੂ ਦਿਸ ਢੂਕੇ ॥",
      "transliteration": "chahoo dhis ddooke ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਪਾਸਿਆਂ ਤੋਂ ਯੋਧੇ ਆ ਚੁੱਕੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "चहू दिस ढूके ॥",
      "sourceLineId": "86848",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਕੂਕੇ ॥੭੪੮॥",
      "transliteration": "har har kooke ||748||",
      "translation": "The sky was filled with dust because of the movement of army, all the soldiers rushed forth from all the four directions and began to remember the name of the Lord.748.",
      "punjabiViakhya": "ਅਤੇ ਮੂੰਹੋਂ ਹਰਿ ਹਰਿ ਬੋਲਦੇ ਹਨ ॥੭੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "हरि हरि कूके ॥७४८॥",
      "sourceLineId": "86849",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਰਖਤ ਬਾਣੰ ॥",
      "transliteration": "barakhat baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ ਦਰਸਾਉਾਂਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "बरखत बाणं ॥",
      "sourceLineId": "86850",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਥਿਰਕਤ ਜੁਆਣੰ ॥",
      "transliteration": "thirakat juaana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨੂੰ ਵੱਜਦੇ ਹਨ ਉਹ) ਜਵਾਨ ਥਿਰਕਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "थिरकत जुआणं ॥",
      "sourceLineId": "86851",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਲਹ ਲਹ ਧੁਜਣੰ ॥",
      "transliteration": "leh leh dhujana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਝੰਡੀਆਂ ਝੁਲਦੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "लह लह धुजणं ॥",
      "sourceLineId": "86852",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਖਹਖਹ ਭੁਜਣੰ ॥੭੪੯॥",
      "transliteration": "khahakheh bhujana(n) ||749||",
      "translation": "The staggering soldiers began to shower arrows, the banners waved and the arms fought with one another.749.",
      "punjabiViakhya": "ਅਤੇ (ਸੂਰਮਿਆਂ ਦੀਆਂ) ਬਾਹਵਾ ਗੁੱਥਮ-ਗੁੱਥਾ ਹੋ ਰਹੀਆਂ ਹਨ ॥੭੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "खहखह भुजणं ॥७४९॥",
      "sourceLineId": "86853",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹਸਿ ਹਸਿ ਢੂਕੇ ॥",
      "transliteration": "has has ddooke ||",
      "translation": "",
      "punjabiViakhya": "ਹੱਸ-ਹੱਸ ਕੇ (ਸੂਰਮੇ) ਨੇੜੇ ਢੁੱਕਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "हसि हसि ढूके ॥",
      "sourceLineId": "86854",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਸਿ ਕਸਿ ਕੂਕੇ ॥",
      "transliteration": "kas kas kooke ||",
      "translation": "",
      "punjabiViakhya": "ਜ਼ੋਰ-ਜ਼ੋਰ ਨਾਲ ਬੋਲਦੇ ਹਨ-",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "कसि कसि कूके ॥",
      "sourceLineId": "86855",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੁਣ ਸੁਣ ਬਾਲੰ ॥",
      "transliteration": "sun sun baala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਬਾਲਕੋ! ਸੁਣੋ,",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "सुण सुण बालं ॥",
      "sourceLineId": "86856",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹਠਿ ਤਜ ਉਤਾਲੰ ॥੭੫੦॥",
      "transliteration": "haTh taj utaala(n) ||750||",
      "translation": "Coming near smilingly they shouted loudly, “O boys! forsake your persistence quickly.”750.",
      "punjabiViakhya": "ਹਠ ਨੂੰ ਜਲਦੀ ਛੱਡ ਦਿਓ ॥੭੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "हठि तज उतालं ॥७५०॥",
      "sourceLineId": "86857",
      "sourceShabadId": "8059",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "86858",
      "sourceShabadId": "8060",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਮ ਨਹੀ ਤਯਾਗਤ ਬਾਜ ਬਰ ਸੁਣਿ ਲਛਮਨਾ ਕੁਮਾਰ ॥",
      "transliteration": "ham nahee tayaagat baaj bar sun lachhamanaa kumaar ||",
      "translation": "",
      "punjabiViakhya": "(ਲਵ ਤੇ ਕੁਸ਼ ਨੇ ਉੱਤਰ ਦਿੱਤਾ-) ਹੇ ਲੱਛਮਣ ਕੁਮਾਰ! ਸੁਣੋ, ਅਸੀਂ ਇਸ ਸੁੰਦਰ ਘੋੜੇ ਨੂੰ ਨਹੀਂ ਛੱਡਾਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "हम नही तयागत बाज बर सुणि लछमना कुमार ॥",
      "sourceLineId": "86859",
      "sourceShabadId": "8060",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਪਨੋ ਭਰ ਬਲ ਜੁੱਧ ਕਰ ਅਬ ਹੀ ਸੰਕ ਬਿਸਾਰ ॥੭੫੧॥",
      "transliteration": "apano bhar bal ju'dh kar ab hee sa(n)k bisaar ||751||",
      "translation": "The boys said, “O Lakshman! we shall not unfasten the horse, abandoning all your doubts you come forward to fight with all your might.”751.",
      "punjabiViakhya": "ਤੂੰ ਆਪਣਾ ਸਾਰਾ ਜ਼ੋਰ ਲਾ ਕੇ, ਨਿਸੰਗ ਹੋ ਕੇ ਯੁੱਧ ਕਰ ॥੭੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "अपनो भर बल जुद्ध कर अब ही संक बिसार ॥७५१॥",
      "sourceLineId": "86860",
      "sourceShabadId": "8060",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਣਕਾ ਛੰਦ ॥",
      "transliteration": "anakaa chha(n)dh ||",
      "translation": "ANKA STANZA",
      "punjabiViakhya": "ਅਣਕਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "अणका छंद ॥",
      "sourceLineId": "86861",
      "sourceShabadId": "8061",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਲਛਮਨ ਗੱਜਯੋ ॥",
      "transliteration": "lachhaman ga'jayo ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ ਸੁਣ ਕੇ) ਲੱਛਮਣ ਗੱਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "लछमन गज्जयो ॥",
      "sourceLineId": "86862",
      "sourceShabadId": "8061",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਡ ਧਨ ਸੱਜਯੋ ॥",
      "transliteration": "badd dhan sa'jayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਹੱਥ ਵਿੱਚ) ਵੱਡਾ ਧਨੁਸ਼ ਧਾਰਨ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "बड धन सज्जयो ॥",
      "sourceLineId": "86863",
      "sourceShabadId": "8061",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬਹੁ ਸਰ ਛੋਰੇ ॥",
      "transliteration": "bahu sar chhore ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਤੀਰ ਛੱਡੇ,",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "बहु सर छोरे ॥",
      "sourceLineId": "86864",
      "sourceShabadId": "8061",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਣੁ ਘਣ ਓਰੇ ॥੭੫੨॥",
      "transliteration": "jan ghan ore ||752||",
      "translation": "Catching hold of his very huge bow Lakshman thundering like clouds, showered a volley of arrows.752.",
      "punjabiViakhya": "ਮਾਨੋ ਬੱਦਲਾ ਤੋਂ ਗੜੇ ਵਰ੍ਰਹਦੇ ਹੋਣ ॥੭੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "जणु घण ओरे ॥७५२॥",
      "sourceLineId": "86865",
      "sourceShabadId": "8061",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0278_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਉਤ ਦਿਵ ਦੇਖੈਂ ॥",
      "transliteration": "aut dhiv dhekhai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਧਰ ਦੇਵਤੇ ਦੇਖਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": "उत दिव देखैं ॥",
      "sourceLineId": "86866",
      "sourceShabadId": "8061",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
