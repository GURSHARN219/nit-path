{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 279,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0279_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਧਨੁ ਧਨੁ ਲੇਖੈਂ ॥",
      "transliteration": "dhan dhan lekhai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਧੰਨ-ਧੰਨ ਉਚਾਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "धनु धनु लेखैं ॥",
      "sourceLineId": "86867",
      "sourceShabadId": "8061",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਤ ਸਰ ਛੋਰੇ ॥",
      "transliteration": "eit sar chhore ||",
      "translation": "",
      "punjabiViakhya": "ਇਧਰੋਂ ਤੀਰ ਛੁੱਟਦੇ ਹਨ (ਜਿਨ੍ਰਹਾ ਨਾਲ ਸੂਰਮਿਆਂ ਦੇ)",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "इत सर छोरे ॥",
      "sourceLineId": "86868",
      "sourceShabadId": "8061",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਸ ਕਣ ਤੂਟੈਂ ॥੭੫੩॥",
      "transliteration": "mas kan tooTai(n) ||753||",
      "translation": "From the other side the gods are seeing the war and the sound of “Bravo, Bravo” is being heard. On this side the arrows are being discharged and bits of flesh are being chopped.753.",
      "punjabiViakhya": "ਮਾਸ ਦੇ ਨਿੱਕੇ-ਨਿੱਕੇ ਕਣ ਟੁੱਟ ਕੇ ਡਿੱਗਦੇ ਹਨ ॥੭੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "मस कण तूटैं ॥७५३॥",
      "sourceLineId": "86869",
      "sourceShabadId": "8061",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭਟ ਬਰ ਗਾਜੈਂ ॥",
      "transliteration": "bhaT bar gaajai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੇਸ਼ਠ ਸੂਰਮੇ ਗੱਜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "भट बर गाजैं ॥",
      "sourceLineId": "86870",
      "sourceShabadId": "8061",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੁੰਦਭ ਬਾਜੈਂ ॥",
      "transliteration": "dhu(n)dhabh baajai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਧੌਂਸੇ ਵੱਜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "दुँदभ बाजैं ॥",
      "sourceLineId": "86871",
      "sourceShabadId": "8061",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਰਬਰ ਛੋਰੈਂ ॥",
      "transliteration": "sarabar chhorai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਗੇ ਬਾਣ ਚੱਲਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "सरबर छोरैं ॥",
      "sourceLineId": "86872",
      "sourceShabadId": "8061",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮੁਖ ਨਹ ਮੋਰੈਂ ॥੭੫੪॥",
      "transliteration": "mukh neh morai(n) ||754||",
      "translation": "The warriors are thundering, the drums are resounding, the arrows are being discharge, but still they are not retreating from the war-arena.754.",
      "punjabiViakhya": "(ਯੋਧੇ) ਮੂੰਹ ਨਹੀਂ ਮੋੜਦੇ ॥੭੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "मुख नह मोरैं ॥७५४॥",
      "sourceLineId": "86873",
      "sourceShabadId": "8061",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਲਛਮਨ ਬਾਚ ਸਿਸ ਸੋ ॥",
      "transliteration": "lachhaman baach sis so ||",
      "translation": "The speech of Lakshman addressed to the boys :",
      "punjabiViakhya": "ਲੱਛਮਣ ਨੇ ਬੱਚਿਆਂ ਨੂੰ ਕਿਹਾ-",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "लछमन बाच सिस सो ॥",
      "sourceLineId": "86874",
      "sourceShabadId": "8061",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਣਕਾ ਛੰਦ ॥",
      "transliteration": "anakaa chha(n)dh ||",
      "translation": "ANKA STANZA",
      "punjabiViakhya": "ਅਣਕਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "अणका छंद ॥",
      "sourceLineId": "86875",
      "sourceShabadId": "8062",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸ੍ਰਿਣ ਸ੍ਰਿਣ ਲਰਕਾ ॥",
      "transliteration": "siran siran larakaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਣੋ, ਸੁਣੋ, ਲੜਕਿਓ!",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "सृण सृण लरका ॥",
      "sourceLineId": "86876",
      "sourceShabadId": "8062",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਨ ਕਰੁ ਕਰਖਾ ॥",
      "transliteration": "jin kar karakhaa ||",
      "translation": "",
      "punjabiViakhya": "ਲੜਾਈ ('ਕਰਖਾ') ਨਾ ਕਰੋ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "जिन करु करखा ॥",
      "sourceLineId": "86877",
      "sourceShabadId": "8062",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦੇ ਮਿਲਿ ਘੋਰਾ ॥",
      "transliteration": "dhe mil ghoraa ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜਾ ਦੇ ਕੇ ਮਿਲ ਪਵੋ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "दे मिलि घोरा ॥",
      "sourceLineId": "86878",
      "sourceShabadId": "8062",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤੁਹਿ ਬਲ ਥੋਰਾ ॥੭੫੫॥",
      "transliteration": "tuh bal thoraa ||755||",
      "translation": "“O boys! listen and do not wage the war, meet me while bringing the horse, because you have inadequate strength.755.",
      "punjabiViakhya": "ਤੁਹਾਡੇ ਵਿੱਚ ਬਲ ਥੋੜਾ ਹੈ ॥੭੫੫॥",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "तुहि बल थोरा ॥७५५॥",
      "sourceLineId": "86879",
      "sourceShabadId": "8062",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹਠ ਤਜਿ ਅੱਈਐ ॥",
      "transliteration": "haTh taj a'ieeaai ||",
      "translation": "",
      "punjabiViakhya": "ਹਠ ਨੂੰ ਛੱਡ ਕੇ ਆ ਜਾਓ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "हठ तजि अई्ईऐ ॥",
      "sourceLineId": "86880",
      "sourceShabadId": "8062",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਿਨ ਸਮੁਹੱਈਐ ॥",
      "transliteration": "jin samuha'ieeaai ||",
      "translation": "",
      "punjabiViakhya": "ਟਾਕਰਾ ਨਾ ਕਰੋ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "जिन समुहई्ईऐ ॥",
      "sourceLineId": "86881",
      "sourceShabadId": "8062",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਿਲਿ ਮਿਲਿ ਮੋ ਕੋ ॥",
      "transliteration": "mil mil mo ko ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਆ ਮਿਲੋ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "मिलि मिलि मो को ॥",
      "sourceLineId": "86882",
      "sourceShabadId": "8062",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਡਰ ਨਹੀਂ ਤੋ ਕੋ ॥੭੫੬॥",
      "transliteration": "ddar nahee(n) to ko ||756||",
      "translation": "“Come after forsaking your persistence and do not confront me, have no fear, come and meet me.”756.",
      "punjabiViakhya": "ਤੁਹਾਨੂੰ ਕੋਈ ਡਰ ਨਹੀਂ ॥੭੫੬॥",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "डर नहीं तो को ॥७५६॥",
      "sourceLineId": "86883",
      "sourceShabadId": "8062",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਿਸ ਨਹੀ ਮਾਨੀ ॥",
      "transliteration": "sis nahee maanee ||",
      "translation": "",
      "punjabiViakhya": "(ਲੱਛਮਣ ਦੀ ਗੱਲ) ਬੱਚਿਆਂ ਨੇ ਨਹੀਂ ਮੰਨੀ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "सिस नही मानी ॥",
      "sourceLineId": "86884",
      "sourceShabadId": "8062",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਤਿ ਅਭਿਮਾਨੀ ॥",
      "transliteration": "at abhimaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਵੱਡੇ ਅਭਿਮਾਨੀ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "अति अभिमानी ॥",
      "sourceLineId": "86885",
      "sourceShabadId": "8062",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗਹਿ ਧਨੁ ਗੱਜਯੋ ॥",
      "transliteration": "geh dhan ga'jayo ||",
      "translation": "",
      "punjabiViakhya": "ਧਨੁਸ਼ ਫੜ ਕੇ ਉਹ ਗੱਜਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "गहि धनु गज्जयो ॥",
      "sourceLineId": "86886",
      "sourceShabadId": "8062",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦੁ ਪਗ ਨ ਭੱਜਯੋ ॥੭੫੭॥",
      "transliteration": "dh pag na bha'jayo ||757||",
      "translation": "The boys did not agree because they were proud their strength, they caught hold of their bows and roared and did not retrace even two steps.757.",
      "punjabiViakhya": "ਅਤੇ ਯੁੱਧ-ਭੂਮੀ ਵਿੱਚੋਂ ਦੋ ਕਦਮ ਵੀ ਨਹੀਂ ਹਟਦੇ ਹਨ ॥੭੫੭॥",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "दु पग न भज्जयो ॥७५७॥",
      "sourceLineId": "86887",
      "sourceShabadId": "8062",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਜਬਾ ਛੰਦ ॥",
      "transliteration": "ajabaa chha(n)dh ||",
      "translation": "AJBA STANZA",
      "punjabiViakhya": "ਅਜਬਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "अजबा छंद ॥",
      "sourceLineId": "86888",
      "sourceShabadId": "8063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰੁੱਧੇ ਰਣ ਭਾਈ ॥",
      "transliteration": "ru'dhe ran bhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਭਰਾ ਰਣ ਵਿੱਚ ਰੁੱਧੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "रुद्धे रण भाई ॥",
      "sourceLineId": "86889",
      "sourceShabadId": "8063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਰ ਝੜਿ ਲਾਈ ॥",
      "transliteration": "sar jhaR laiee ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰਾ ਦੀ ਝੜੀ ਲਾ ਦਿੱਤੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "सर झड़ि लाई ॥",
      "sourceLineId": "86890",
      "sourceShabadId": "8063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਰਖੇ ਬਾਣੰ ॥",
      "transliteration": "barakhe baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰਾ ਦੀ ਬਰਖਾ ਕਰਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "बरखे बाणं ॥",
      "sourceLineId": "86891",
      "sourceShabadId": "8063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਰਖੇ ਜੁਆਣੰ ॥੭੫੮॥",
      "transliteration": "parakhe juaana(n) ||758||",
      "translation": "Both the brother were absorbed in war and showering their arrows, they tested the strength of the soldiers.758.",
      "punjabiViakhya": "ਅਤੇ ਸੂਰਮਿਆਂ ਦੀ ਪਰਖ ਹੋ ਰਹੀ ਹੈ ॥੭੫੮॥",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "परखे जुआणं ॥७५८॥",
      "sourceLineId": "86892",
      "sourceShabadId": "8063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਡਿੱਗੇ ਰਣ ਮੱਧੰ ॥",
      "transliteration": "ddi'ge ran ma'dha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ ਵਿੱਚ (ਕਈ) ਡਿੱਗੇ ਪਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "डिग्गे रण मद्धं ॥",
      "sourceLineId": "86893",
      "sourceShabadId": "8063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅੱਧੋ ਅੱਧੰ ॥",
      "transliteration": "a'dho a'dha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈ) ਅੱਧੋ-ਅੱਧ ਕੱਟੇ ਪਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "अद्धो अद्धं ॥",
      "sourceLineId": "86894",
      "sourceShabadId": "8063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕੱਟੇ ਅੰਗੰ ॥",
      "transliteration": "ka'Te a(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈਆਂ ਦੇ) ਅੰਗ ਕੱਟੇ ਗਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "कट्टे अंगं ॥",
      "sourceLineId": "86895",
      "sourceShabadId": "8063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰੁੱਝੈ ਜੰਗੰ ॥੭੫੯॥",
      "transliteration": "ru'jhai ja(n)ga(n) ||759||",
      "translation": "The warriors fell in the battlefield being chopped into bits, and the limbs of the fighting soldiers were cut.759.",
      "punjabiViakhya": "(ਕਈ) ਯੁੱਧ ਵਿੱਚ ਰੁੱਝੇ ਹੋਏ ਹਨ ॥੭੫੯॥",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "रुज्झै जंगं ॥७५९॥",
      "sourceLineId": "86896",
      "sourceShabadId": "8063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਾਣਨ ਝੜ ਲਾਯੋ ॥",
      "transliteration": "baanan jhaR laayo ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮਿਆਂ ਨੇ ਰਣ-ਭੂਮੀ ਵਿੱਚ) ਤੀਰਾ ਦੀ ਝੜੀ ਲਾ ਦਿੱਤੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "बाणन झड़ लायो ॥",
      "sourceLineId": "86897",
      "sourceShabadId": "8063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਰਬ ਰਸਾਯੋ ॥",
      "transliteration": "sarab rasaayo ||",
      "translation": "The pools of blood waved with the shower of arrows",
      "punjabiViakhya": "ਸਾਰੇ ਕ੍ਰੋਧ ਨਾਲ ਭਰੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "सरब रसायो ॥",
      "sourceLineId": "86898",
      "sourceShabadId": "8063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਹੁ ਅਰ ਮਾਰੇ ॥",
      "transliteration": "bahu ar maare ||",
      "translation": "",
      "punjabiViakhya": "(ਲਵ ਨੇ) ਬਹੁਤ ਵੈਰੀ ਮਾਰੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "बहु अर मारे ॥",
      "sourceLineId": "86899",
      "sourceShabadId": "8063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਡੀਲ ਡਰਾਰੇ ॥੭੬੦॥",
      "transliteration": "ddeel ddaraare ||760||",
      "translation": "Many enemies were killed and many were filled with fear.760.",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦੇ ਕੱਦ-ਕਾਠ ਡਰਾਉਣੇ ਹਨ ॥੭੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "डील डरारे ॥७६०॥",
      "sourceLineId": "86900",
      "sourceShabadId": "8063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਡਿੱਗੇ ਰਣ ਭੂਮੰ ॥",
      "transliteration": "ddi'ge ran bhooma(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿੱਚ (ਕਈ) ਡਿੱਗੇ ਪਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "डिग्गे रण भूमं ॥",
      "sourceLineId": "86901",
      "sourceShabadId": "8063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਰਬਰ ਘੂਮੰ ॥",
      "transliteration": "narabar ghooma(n) ||",
      "translation": "The superb warriors began to fall in the battlefield while swinging",
      "punjabiViakhya": "ਸੂਰਬੀਰ (ਫੱਟੜ ਹੋ ਕੇ) ਘੁਮੇਰੀਆਂ ਖਾ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "नरबर घूमं ॥",
      "sourceLineId": "86902",
      "sourceShabadId": "8063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਰੱਜੇ ਰਣ ਘਾਯੰ ॥",
      "transliteration": "ra'je ran ghaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਯੁੱਧ ਕਰਦੇ ਰੱਜ ਗਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "रज्जे रण घायं ॥",
      "sourceLineId": "86903",
      "sourceShabadId": "8063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਚੱਕੇ ਚਾਯੰ ॥੭੬੧॥",
      "transliteration": "cha'ke chaaya(n) ||761||",
      "translation": "The wounds on the bodies were inflicted but still there was no dearth of zeal in them.761.",
      "punjabiViakhya": "ਅਤੇ ਯੁੱਧ ਦੇ ਚਾਉ ਨਾਲ ਮੱਚੇ ਹੋਏ ਹਨ ॥੭੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "चक्के चायं ॥७६१॥",
      "sourceLineId": "86904",
      "sourceShabadId": "8063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਪੂਰਬ ਛੰਦ ॥",
      "transliteration": "apoorab chha(n)dh ||",
      "translation": "APOORAB STANZA",
      "punjabiViakhya": "ਅਪੂਰਬ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "अपूरब छंद ॥",
      "sourceLineId": "86905",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗਣੇ ਕੇਤੇ ॥",
      "transliteration": "gane kete ||",
      "translation": "",
      "punjabiViakhya": "ਕਿੰਨੇ ਕੁ ਗਿਣੀਏ",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "गणे केते ॥",
      "sourceLineId": "86906",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਣੇ ਜੇਤੇ ॥",
      "transliteration": "hane jete ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੜੇ ਮਾਰੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "हणे जेते ॥",
      "sourceLineId": "86907",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਈ ਮਾਰੇ ॥",
      "transliteration": "kiee maare ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੇਕਾ ਮਾਰੇ ਗਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "कई मारे ॥",
      "sourceLineId": "86908",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਿਤੇ ਹਾਰੇ ॥੭੬੨॥",
      "transliteration": "kite haare ||762||",
      "translation": "The number of died is unaccountable, how many of them were killed and how many of them were defeated.762.",
      "punjabiViakhya": "ਅਤੇ ਕਿਤਨੇ ਹੀ ਹਾਰ ਕੇ (ਭੱਜ ਗਏ ਹਨ) ॥੭੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "किते हारे ॥७६२॥",
      "sourceLineId": "86909",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਭੈ ਭਾਜੇ ॥",
      "transliteration": "sabhai bhaaje ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਭੱਜ ਗਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "सभै भाजे ॥",
      "sourceLineId": "86910",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚਿਤੰ ਲਾਜੇ ॥",
      "transliteration": "chita(n) laaje ||",
      "translation": "",
      "punjabiViakhya": "ਚਿੱਤ ਵਿੱਚ ਸ਼ਰਮਸਾਰ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "चितं लाजे ॥",
      "sourceLineId": "86911",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭਜੇ ਭੈ ਕੈ ॥",
      "transliteration": "bhaje bhai kai ||",
      "translation": "",
      "punjabiViakhya": "ਡਰ-ਡਰ ਕੇ ਭੱਜੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "भजे भै कै ॥",
      "sourceLineId": "86912",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜੀਯੰ ਲੈ ਕੈ ॥੭੬੩॥",
      "transliteration": "jeeya(n) lai kai ||763||",
      "translation": "Feeling ashamed in their mind all ran away and absorbed in fear they went away, saving their lives.763.",
      "punjabiViakhya": "ਅਤੇ ਜਾਨ ਬਚਾ ਕੇ ਚਲੇ ਗਏ ਹਨ ॥੭੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "जीयं लै कै ॥७६३॥",
      "sourceLineId": "86913",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0279_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਫਿਰੇ ਜੇਤੇ ॥",
      "transliteration": "fire jete ||",
      "translation": "",
      "punjabiViakhya": "(ਲੜਣ ਨੂੰ ਜਿੰਨੇ ਵੀ) ਮੁੜ ਕੇ ਆਏ",
      "source": "DASAM_GRANTH",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": "फिरे जेते ॥",
      "sourceLineId": "86914",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
