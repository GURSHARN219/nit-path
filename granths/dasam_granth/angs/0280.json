{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 280,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0280_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਣੇ ਕੇਤੇ ॥",
      "transliteration": "hane kete ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਮਾਰੇ ਗਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "हणे केते ॥",
      "sourceLineId": "86915",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਿਤੇ ਘਾਏ ॥",
      "transliteration": "kite ghaae ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਫੱਟੜ ਹੋਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "किते घाए ॥",
      "sourceLineId": "86916",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਿਤੇ ਧਾਏ ॥੭੬੪॥",
      "transliteration": "kite dhaae ||764||",
      "translation": "Those who returned, were killed, many were wounded and many fled away.764.",
      "punjabiViakhya": "ਅਤੇ ਕਿਤਨੇ ਭੱਜ ਗਏ ਹਨ ॥੭੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "किते धाए ॥७६४॥",
      "sourceLineId": "86917",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਿਸੰ ਜੀਤੇ ॥",
      "transliteration": "sisa(n) jeete ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਲਕ ਜਿੱਤੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "सिसं जीते ॥",
      "sourceLineId": "86918",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭਟੰ ਭੀਤੇ ॥",
      "transliteration": "bhaTa(n) bheete ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਡਰ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "भटं भीते ॥",
      "sourceLineId": "86919",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਹਾ ਕ੍ਰੁੱਧੰ ॥",
      "transliteration": "mahaa kru'dha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਬਾਲਕਾ ਨੇ) ਵੱਡੇ ਕ੍ਰੋਧ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "महा क्रुद्धं ॥",
      "sourceLineId": "86920",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕੀਯੋ ਜੁੱਧੰ ॥੭੬੫॥",
      "transliteration": "keeyo ju'dha(n) ||765||",
      "translation": "The boys were victorious and the warriors were frightened, they being highly infuriated waged the war.765.",
      "punjabiViakhya": "ਯੁੱਧ ਕੀਤਾ ਸੀ ॥੭੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "कीयो जुद्धं ॥७६५॥",
      "sourceLineId": "86921",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੋਊ ਭ੍ਰਾਤਾ ॥",
      "transliteration": "dhouoo bhraataa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਭਰਾ (ਲਵ ਅਤੇ ਕੁਸ਼)",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "दोऊ भ्राता ॥",
      "sourceLineId": "86922",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਖਗੰ ਖਯਾਤਾ ॥",
      "transliteration": "khaga(n) khayaataa ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਨੂੰ ਚਮਕਾਉਾਂਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "खगं खयाता ॥",
      "sourceLineId": "86923",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਹਾ ਜੋਧੰ ॥",
      "transliteration": "mahaa jodha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਵੱਡੇ ਯੋਧੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "महा जोधं ॥",
      "sourceLineId": "86924",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮੰਡੇ ਕ੍ਰੋਧੰ ॥੭੬੬॥",
      "transliteration": "ma(n)dde krodha(n) ||766||",
      "translation": "Both the brothers who were specialists in swordsmanship, in great fury were engrossed in great war.766.",
      "punjabiViakhya": "ਅਤੇ ਕ੍ਰੋਧ ਨਾਲ ਭਰੇ ਹੋਏ ਹਨ ॥੭੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "मंडे क्रोधं ॥७६६॥",
      "sourceLineId": "86925",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਜੇ ਬਾਣੰ ॥",
      "transliteration": "taje baana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਧਨੁਸ਼ ਖਿੱਚ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "तजे बाणं ॥",
      "sourceLineId": "86926",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਧਨੰ ਤਾਣੰ ॥",
      "transliteration": "dhana(n) taana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣ ਛੱਡਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "धनं ताणं ॥",
      "sourceLineId": "86927",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਚੇ ਬੀਰੰ ॥",
      "transliteration": "mache beera(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਯੁੱਧ ਵਿੱਚ) ਮਤੇ ਹੋਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "मचे बीरं ॥",
      "sourceLineId": "86928",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਜੇ ਭੀਰੰ ॥੭੬੭॥",
      "transliteration": "bhaje bheera(n) ||767||",
      "translation": "They pulled their bows and discharged the armour and seeing these warriors absorbed in a terrible war, the clusters of forces fled away.767.",
      "punjabiViakhya": "ਅਤੇ ਕਾਇਰ (ਡਰ ਕੇ) ਭੱਜੇ ਜਾ ਰਹੇ ਹਨ ॥੭੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "भजे भीरं ॥७६७॥",
      "sourceLineId": "86929",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਟੇ ਅੰਗੰ ॥",
      "transliteration": "kaTe a(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈਆਂ) ਦੇ) ਅੰਗ ਕੱਟੇ ਪਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "कटे अंगं ॥",
      "sourceLineId": "86930",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਭਜੇ ਜੰਗੰ ॥",
      "transliteration": "bhaje ja(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈ) ਜੰਗ ਤੋਂ ਭੱਜੇ ਜਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "भजे जंगं ॥",
      "sourceLineId": "86931",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰਣੰ ਰੁੱਝੇ ॥",
      "transliteration": "rana(n) ru'jhe ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਰਣ ਵਿੱਚ ਰੁੱਝੇ ਹੋਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "रणं रुज्झे ॥",
      "sourceLineId": "86932",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਰੰ ਜੁੱਝੇ ॥੭੬੮॥",
      "transliteration": "nara(n) ju'jhe ||768||",
      "translation": "After getting their limbs chopped, the warriors fled away and the remaining ones fought in the war.768.",
      "punjabiViakhya": "(ਉਹ) ਪੁਰਸ਼ ਜੂਝ ਗਏ ਹਨ ॥੭੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "नरं जुज्झे ॥७६८॥",
      "sourceLineId": "86933",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਭਜੀ ਸੈਨੰ ॥",
      "transliteration": "bhajee saina(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸਾਰੀ) ਸੈਨਾ ਭੱਜ ਗਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "भजी सैनं ॥",
      "sourceLineId": "86934",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਿਨਾ ਚੈਨੰ ॥",
      "transliteration": "binaa chaina(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬੇਚੈਨ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "बिना चैनं ॥",
      "sourceLineId": "86935",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਲਛਨ ਬੀਰੰ ॥",
      "transliteration": "lachhan beera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਲੱਛਮਣ ਸੂਰਮਾ ਧੀਰਜ ਕਰਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "लछन बीरं ॥",
      "sourceLineId": "86936",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਫਿਰਯੋ ਧੀਰੰ ॥੭੬੯॥",
      "transliteration": "firayo dheera(n) ||769||",
      "translation": "The army, being confounded, fled away, then Laksman retuned with composure.769.",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿੱਚ ਫਿਰ ਰਿਹਾ ਹੈ ॥੭੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "फिरयो धीरं ॥७६९॥",
      "sourceLineId": "86937",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0280_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਇਕੈ ਬਾਣੰ ॥",
      "transliteration": "eikai baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵੈਰੀ ਨੇ ਇਕ ਤੀਰ ਧਨੁਸ਼ ਵਿੱਚ ਖਿੱਚਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 280,
      "hindi": "",
      "hindiTransliteration": "इकै बाणं ॥",
      "sourceLineId": "86938",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
