{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 281,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0281_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਿਪੰ ਤਾਣੰ ॥",
      "transliteration": "ripa(n) taana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਲੱਛਮਣ ਦੇ) ਮੱਥੇ ਵਿੱਚ ਮਾਰਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "रिपं ताणं ॥",
      "sourceLineId": "86939",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਹਣਯੋ ਭਾਲੰ ॥",
      "transliteration": "hanayo bhaala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਹ) ਤੁਰੰਤ",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "हणयो भालं ॥",
      "sourceLineId": "86940",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗਿਰਯੋ ਤਾਲੰ ॥੭੭੦॥",
      "transliteration": "girayo taala(n) ||770||",
      "translation": "Lava, stretching his bow, discharge and arrow toward the enemy, which struck Lakshman on the forehead and he fell like a tree.770.",
      "punjabiViakhya": "(ਰਣ-ਭੂਮੀ ਵਿੱਚ) ਡਿੱਗ ਪਿਆ ॥੭੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "गिरयो तालं ॥७७०॥",
      "sourceLineId": "86941",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਤਿ ਲਛਮਨ ਬਧਹਿ ਸਮਾਪਤੰ ॥",
      "transliteration": "eit lachhaman badheh samaapata(n) ||",
      "translation": "End of the chapter entitled ‘Killing of Lakshman’ in Ramvtar in BACHITTAR NATAK.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਦੇ ਰਾਮਾਵਤਾਰ ਦੇ ਲੱਛਮਣ-ਬਧਹਿ ਅਧਿਆਇ ਦੀ ਸਮਾਪਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "इति लछमन बधहि समापतं ॥",
      "sourceLineId": "86942",
      "sourceShabadId": "8064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਥ ਭਰਥ ਜੁਧ ਕਥਨੰ ॥",
      "transliteration": "ath bharath judh kathana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਭਰਤ ਦੇ ਯੁੱਧ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "अथ भरथ जुध कथनं ॥",
      "sourceLineId": "86943",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅੜੂਹਾ ਛੰਦ ॥",
      "transliteration": "aRoohaa chha(n)dh ||",
      "translation": "AROOHAA STANZA",
      "punjabiViakhya": "ਅੜੂਹਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "अड़ूहा छंद ॥",
      "sourceLineId": "86944",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭਾਗ ਗਯੋ ਦਲ ਤ੍ਰਾਮ ਕੈ ਕੈ ॥",
      "transliteration": "bhaag gayo dhal traam kai kai ||",
      "translation": "",
      "punjabiViakhya": "ਸੈਨਾ ਡਰ ਕੇ ਭੱਜ ਗਈ-",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "भाग गयो दल त्राम कै कै ॥",
      "sourceLineId": "86945",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਲਛਮਣੰ ਰਣ ਭੂਮ ਦੈ ਕੈ ॥",
      "transliteration": "lachhamana(n) ran bhoom dhai kai ||",
      "translation": "Making a sacrifice of Lakshman in the war, his army, being frightened fled away",
      "punjabiViakhya": "ਲੱਛਮਣ ਨੂੰ ਰਣ-ਭੂਮੀ ਵਿੱਚ ਭੇਟਾ ਚੜ੍ਰਹਾ ਕੇ।",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "लछमणं रण भूम दै कै ॥",
      "sourceLineId": "86946",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਖਲੇ ਰਾਮਚੰਦ ਹੁਤੇ ਜਹਾ ॥",
      "transliteration": "khale raamacha(n)dh hute jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿੱਥੇ ਰਾਮ ਚੰਦਰ ਖੜੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "खले रामचंद हुते जहा ॥",
      "sourceLineId": "86947",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਭਟ ਭਾਜ ਭੱਗ ਲਗੇ ਤਹਾ ॥੭੭੧॥",
      "transliteration": "bhaT bhaaj bha'g lage tahaa ||771||",
      "translation": "Te warriors reached the place where Ram was standing.771.",
      "punjabiViakhya": "ਕਾਇਰ ਸੂਰਮੇ ਭੱਜ ਕੇ ਉਥੇ ਚਲੇ ਗਏ ॥੭੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "भट भाज भग्ग लगे तहा ॥७७१॥",
      "sourceLineId": "86948",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਬ ਜਾਇ ਬਾਤ ਕਹੀ ਉਨੈ ॥",
      "transliteration": "jab jai baat kahee unai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਜਾ ਕੇ ਉਨ੍ਰਹਾ ਨੂੰ ਲੱਛਮਣ ਦੇ ਜੂਝਣ ਦੀ) ਗੱਲ ਕਹੀ",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "जब जाइ बात कही उनै ॥",
      "sourceLineId": "86949",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਹੁ ਭਾਤ ਸੋਕ ਦਯੋ ਤਿਨੈ ॥",
      "transliteration": "bahu bhaat sok dhayo tinai ||",
      "translation": "When all the events were related to him, he was in great anguish",
      "punjabiViakhya": "ਤਦ ਉਨ੍ਰਹਾ ਨੂੰ ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਸ਼ੋਕ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "बहु भात सोक दयो तिनै ॥",
      "sourceLineId": "86950",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੁਨਿ ਬੈਨ ਮੋਨ ਰਹੈ ਬਲੀ ॥",
      "transliteration": "sun bain mon rahai balee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ) ਬਚਨ ਸੁਣ ਕੇ ਸ੍ਰੀ ਰਾਮ (ਇਉਾਂ) ਚੁੱਪ ਕਰ ਰਹੇ",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "सुनि बैन मोन रहै बली ॥",
      "sourceLineId": "86951",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਨ ਚਿੱਤ੍ਰ ਪਾਹਨ ਕੀ ਖਲੀ ॥੭੭੨॥",
      "transliteration": "jan chi'tr paahan kee khalee ||772||",
      "translation": "Hearing their word the mighty sovereign remained silent like a portrait, becoming like a stone-slab.772.",
      "punjabiViakhya": "ਮਾਨੋ ਪੱਥਰ ਦੀ ਮੂਰਤੀ ਖੜੋਤੀ ਹੋਵੇ ॥੭੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "जन चित्त्र पाहन की खली ॥७७२॥",
      "sourceLineId": "86952",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪੁਨ ਬੈਠ ਮੰਤ੍ਰ ਬਿਚਾਰਯੋ ॥",
      "transliteration": "pun baiTh ma(n)tr bichaarayo ||",
      "translation": "",
      "punjabiViakhya": "(ਸ੍ਰੀ ਰਾਮ ਨੇ) ਫਿਰ ਬੈਠ ਕੇ ਵਿਚਾਰ ਕੀਤਾ ਅਤੇ ਕਿਹਾ-",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "पुन बैठ मंत्र बिचारयो ॥",
      "sourceLineId": "86953",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤੁਮ ਜਾਹੁ ਭਰਥ ਉਚਾਰਯੋ ॥",
      "transliteration": "tum jaahu bharath uchaarayo ||",
      "translation": "Then sitting down, he held consultations and addressing Bharat, he asked him to go, saying,",
      "punjabiViakhya": "ਹੇ ਭਰਤ! ਤੁਸੀਂ ਜਾਓ,",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "तुम जाहु भरथ उचारयो ॥",
      "sourceLineId": "86954",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੁਨ ਬਾਲ ਦ੍ਵੈ ਜਿਨ ਮਾਰੀਯੋ ॥",
      "transliteration": "mun baal dhavai jin maareeyo ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਨ੍ਰਹਾ ਦੋਹਾ ਮੁਨੀ ਬਾਲਕਾ ਨੂੰ ਮਾਰਨਾ ਨਹੀਂ,",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "मुन बाल द्वै जिन मारीयो ॥",
      "sourceLineId": "86955",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਧਰਿ ਆਨ ਮੋਹਿ ਦਿਖਾਰੀਯੋ ॥੭੭੩॥",
      "transliteration": "dhar aan moh dhikhaareeyo ||773||",
      "translation": "“Do not kill the boys of the sages, but bring them and show them to me.”773.",
      "punjabiViakhya": "ਫੜ ਲਿਆਓ ਅਤੇ ਮੈਨੂੰ ਵਿਖਾਓ ॥੭੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "धरि आन मोहि दिखारीयो ॥७७३॥",
      "sourceLineId": "86956",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਜ ਸੈਨ ਭਰਥ ਚਲੇ ਤਹਾ ॥",
      "transliteration": "saj sain bharath chale tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੈਨਾ ਨੂੰ ਸਜਾ ਕੇ ਭਰਤ ਉਧਰ ਨੂੰ ਚਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "सज सैन भरथ चले तहा ॥",
      "sourceLineId": "86957",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਣ ਬਾਲ ਬੀਰ ਮੰਡੇ ਜਹਾ ॥",
      "transliteration": "ran baal beer ma(n)dde jahaa ||",
      "translation": "Bharat decorating his army marched to the place where the boys were standing ready (for war)",
      "punjabiViakhya": "ਜਿੱਧਰ ਬਾਲਕ ਸੂਰਮਿਆਂ ਨੇ ਰਣ ਮੰਡਿਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "रण बाल बीर मंडे जहा ॥",
      "sourceLineId": "86958",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਹੁ ਭਾਤ ਬੀਰ ਸੰਘਾਰਹੀ ॥",
      "transliteration": "bahu bhaat beer sa(n)ghaarahee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਸੂਰਮਿਆਂ ਨੂੰ ਮਾਰਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "बहु भात बीर संघारही ॥",
      "sourceLineId": "86959",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਰ ਓਘ ਪ੍ਰਓਘ ਪ੍ਰਹਾਰਹੀ ॥੭੭੪॥",
      "transliteration": "sar ogh progh prahaarahee ||774||",
      "translation": "They were ready to kill the warriors by striking blows with many types of arrows.774.",
      "punjabiViakhya": "ਅਤੇ ਤੀਰਾ ਦੇ ਝੁੰਡਾ ਦੇ ਝੁੰਡ ਚਲਾ ਰਹੇ ਸਨ ॥੭੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "सर ओघ प्रओघ प्रहारही ॥७७४॥",
      "sourceLineId": "86960",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੁਗ੍ਰੀਵ ਔਰ ਭਭੀਛਨੰ ॥",
      "transliteration": "sugreev aauar bhabheechhana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਭਰਤ) ਸੁਗ੍ਰੀਵ, ਵਿਭੀਸ਼ਣ,",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "सुग्रीव और भभीछनं ॥",
      "sourceLineId": "86961",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹਨਵੰਤ ਅੰਗਦ ਰੀਛਨੰ ॥",
      "transliteration": "hanava(n)t a(n)gadh reechhana(n) ||",
      "translation": "Alongwith Sugriva, Vibhishan, Hanuman, Angad, Jambvant,",
      "punjabiViakhya": "ਹਨੂਮਾਨ, ਅੰਗਦ ਅਤੇ ਜਾਮਵੰਤ ਆਦਿ ਸੈਨਾਪਤੀਆਂ ਵਾਲੀ",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "हनवंत अंगद रीछनं ॥",
      "sourceLineId": "86962",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਹੁ ਭਾਤਿ ਸੈਨ ਬਨਾਇ ਕੈ ॥",
      "transliteration": "bahu bhaat sain banai kai ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਤਰ੍ਰਹਾ ਦੀ ਸੈਨਾ ਜੋੜ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "बहु भाति सैन बनाइ कै ॥",
      "sourceLineId": "86963",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਿਨ ਪੈ ਚਲਯੋ ਸਮੁਹਾਇ ਕੈ ॥੭੭੫॥",
      "transliteration": "tin pai chalayo samuhai kai ||775||",
      "translation": "And with their various types of forces, Bharat went forward towards the brave boys.775.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦਾ ਸਾਹਮਣਾ ਕਰਨ ਲਈ ਚੜ੍ਰਹ ਪਿਆ ॥੭੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "तिन पै चलयो समुहाइ कै ॥७७५॥",
      "sourceLineId": "86964",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰਣ ਭੂਮਿ ਭਰਥ ਗਏ ਜਬੈ ॥",
      "transliteration": "ran bhoom bharath ge jabai ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿੱਚ ਜਦੋਂ ਭਰਤ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "रण भूमि भरथ गए जबै ॥",
      "sourceLineId": "86965",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮੁਨ ਬਾਲ ਦੋਇ ਲਖੇ ਤਬੈ ॥",
      "transliteration": "mun baal dhoi lakhe tabai ||",
      "translation": "When Bharat reached the battlefield, he saw both the boys of sages",
      "punjabiViakhya": "ਤਦ ਉਸ ਨੇ ਦੋ ਮੁਨੀ ਬਾਲਕਾ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "मुन बाल दोइ लखे तबै ॥",
      "sourceLineId": "86966",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੁਇ ਕਾਕ ਪੱਛਾ ਸੋਭਹੀ ॥",
      "transliteration": "dhui kaak pa'chhaa sobhahee ||",
      "translation": "",
      "punjabiViakhya": "???",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "दुइ काक पच्छा सोभही ॥",
      "sourceLineId": "86967",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਲਖਿ ਦੇਵ ਦਾਨੋ ਲੋਭਹੀ ॥੭੭੬॥",
      "transliteration": "lakh dhev dhaano lobhahee ||776||",
      "translation": "Both boys looked impressive and both the gods and demons were allured on seeing them.776.",
      "punjabiViakhya": "ਦੇਵਤੇ ਅਤੇ ਦੈਂਤ ਮੋਹਿਤ ਹੋ ਰਹੇ ਸਨ (ਜਿਨ੍ਰਹਾ ਦੇ ਰੂਪ ਨੂੰ ਵੇਖ ਕੇ) ॥੭੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "लखि देव दानो लोभही ॥७७६॥",
      "sourceLineId": "86968",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭਰਥ ਬਾਚ ਲਵ ਸੋ ॥",
      "transliteration": "bharath baach lav so ||",
      "translation": "Speech of Bharat addressed to Lava :",
      "punjabiViakhya": "ਭਰਤ ਨੇ ਲਵ ਨੂੰ ਕਿਹਾ-",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "भरथ बाच लव सो ॥",
      "sourceLineId": "86969",
      "sourceShabadId": "8065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਕੜਾ ਛੰਦ ॥",
      "transliteration": "akaRaa chha(n)dh ||",
      "translation": "AKRAA STANZA",
      "punjabiViakhya": "ਅਕੜਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "अकड़ा छंद ॥",
      "sourceLineId": "86970",
      "sourceShabadId": "8066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮੁਨਿ ਬਾਲ ਛਾਡਹੁ ਗਰਬ ॥",
      "transliteration": "mun baal chhaaddahu garab ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮੁਨੀ ਬਾਲਕੋ! ਗਰਬ ਛੱਡ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "मुनि बाल छाडहु गरब ॥",
      "sourceLineId": "86971",
      "sourceShabadId": "8066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮਿਲਿ ਆਨ ਮੋਹੂ ਸਰਬ ॥",
      "transliteration": "mil aan mohoo sarab ||",
      "translation": "“O boys of the sages! forsake your pride, come and meet me",
      "punjabiViakhya": "ਸਭ ਮੈਨੂੰ ਆ ਕੇ ਮਿਲੋ,",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "मिलि आन मोहू सरब ॥",
      "sourceLineId": "86972",
      "sourceShabadId": "8066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਲੈ ਜਾਹਿ ਰਾਘਵ ਤੀਰ ॥",
      "transliteration": "lai jaeh raaghav teer ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ ਤੁਹਾਨੂੰ) ਰਾਮ ਚੰਦਰ ਪਾਸ ਲੈ ਜਾਵਾਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "लै जाहि राघव तीर ॥",
      "sourceLineId": "86973",
      "sourceShabadId": "8066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤੁਹਿ ਨੈਕ ਦੈ ਕੈ ਚੀਰ ॥੭੭੭॥",
      "transliteration": "tuh naik dhai kai cheer ||777||",
      "translation": "“I shall dress you and take you to (Raghava) Ram.”777.",
      "punjabiViakhya": "ਉਹ ਤੁਹਾਨੂੰ ਸੁੰਦਰ ਬਸਤ੍ਰ ਦੇਣਗੇ ॥੭੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "तुहि नैक दै कै चीर ॥७७७॥",
      "sourceLineId": "86974",
      "sourceShabadId": "8066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੁਨਤੇ ਭਰੇ ਸਿਸ ਮਾਨ ॥",
      "transliteration": "sunate bhare sis maan ||",
      "translation": "",
      "punjabiViakhya": "(ਭਰਤ ਦੇ ਕਥਨ) ਸੁਣਦਿਆਂ ਹੀ ਬਾਲਕ ਗਰਬ ਨਾਲ ਭਰ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "सुनते भरे सिस मान ॥",
      "sourceLineId": "86975",
      "sourceShabadId": "8066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਰ ਕੋਪ ਤਾਨ ਕਮਾਨ ॥",
      "transliteration": "kar kop taan kamaan ||",
      "translation": "Hearing these words the boys were filled with pride and being enraged they pulled their bows",
      "punjabiViakhya": "ਅਤੇ ਕ੍ਰੋਧ ਕਰਕੇ ਕਮਾਨਾ ਖਿੱਚ ਲਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "कर कोप तान कमान ॥",
      "sourceLineId": "86976",
      "sourceShabadId": "8066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਹੁ ਭਾਤਿ ਸਾਇਕ ਛੋਰਿ ॥",
      "transliteration": "bahu bhaat saik chhor ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਤੀਰ ਛੱਡ ਦਿੱਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "बहु भाति साइक छोरि ॥",
      "sourceLineId": "86977",
      "sourceShabadId": "8066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਨ ਅਭ੍ਰ ਸਾਵਣ ਓਰ ॥੭੭੮॥",
      "transliteration": "jan abhr saavan or ||778||",
      "translation": "They discharged many arrows like the clouds of the month of Sawan.778.",
      "punjabiViakhya": "ਮਾਨੋ ਸਾਵਣ ਦੇ ਬੱਦਲ ਵਿੱਚੋਂ ਗੜੇ (ਡਿੱਗ ਰਹੇ ਹੋਣ) ॥੭੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "जन अभ्र सावण ओर ॥७७८॥",
      "sourceLineId": "86978",
      "sourceShabadId": "8066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਲਾਗੇ ਸੁ ਸਾਇਕ ਅੰਗ ॥",
      "transliteration": "laage su saik a(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਦੇ) ਸਰੀਰ ਵਿੱਚ ਬਾਣ ਲੱਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "लागे सु साइक अंग ॥",
      "sourceLineId": "86979",
      "sourceShabadId": "8066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗਿਰਗੇ ਸੁ ਬਾਹ ਉਤੰਗ ॥",
      "transliteration": "girage su baeh uta(n)g ||",
      "translation": "Those, whom those arrows struck, fell down and overturned",
      "punjabiViakhya": "(ਉਹ) ਸੂਰਮੇ ਮੂਧੇ ਮੂੰਹ ਡਿੱਗ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "गिरगे सु बाह उतंग ॥",
      "sourceLineId": "86980",
      "sourceShabadId": "8066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਹੂੰ ਅੰਗ ਭੰਗ ਸੁਬਾਹ ॥",
      "transliteration": "kahoo(n) a(n)g bha(n)g subaeh ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸੂਰਮਿਆਂ ਦੇ, ਅੰਗ ਵੱਢੇ ਪਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "कहूँ अंग भंग सुबाह ॥",
      "sourceLineId": "86981",
      "sourceShabadId": "8066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਹੂੰ ਚਉਰ ਚੀਰ ਸਨਾਹ ॥੭੭੯॥",
      "transliteration": "kahoo(n) chaur cheer sanaeh ||779||",
      "translation": "Somewhere those arrows chopped the limbs and somewhere they penetrated through the fly-whisk and armour.779.",
      "punjabiViakhya": "ਕਿਤੇ ਚੌਰ, ਸ਼ਸਤ੍ਰ ਅਤੇ ਕਵਚ (ਡਿੱਗ ਪਏ ਹਨ) ॥੭੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "कहूँ चउर चीर सनाह ॥७७९॥",
      "sourceLineId": "86982",
      "sourceShabadId": "8066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਹੂੰ ਚਿੱਤ੍ਰ ਚਾਰ ਕਮਾਨ ॥",
      "transliteration": "kahoo(n) chi'tr chaar kamaan ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸੁੰਦਰ ਚਿੱਤਰ ਵਾਲੀਆਂ ਕਮਾਨਾ (ਡਿੱਗੀਆਂ ਪਈਆਂ ਹਨ),",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "कहूँ चित्त्र चार कमान ॥",
      "sourceLineId": "86983",
      "sourceShabadId": "8066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਹੂੰ ਅੰਗ ਜੋਧਨ ਬਾਨ ॥",
      "transliteration": "kahoo(n) a(n)g jodhan baan ||",
      "translation": "Somewhere they created portraits on coming out of the beautiful bows and somewhere they pierced the limbs of the warriors",
      "punjabiViakhya": "ਕਿਤੇ ਯੋਧਿਆਂ ਦੇ ਅੰਗਾ ਵਿੱਚ ਬਾਣ (ਲੱਗੇ ਹੋਏ ਹਨ),",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "कहूँ अंग जोधन बान ॥",
      "sourceLineId": "86984",
      "sourceShabadId": "8066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਹੂੰ ਅੰਗ ਘਾਇ ਭਭੱਕ ॥",
      "transliteration": "kahoo(n) a(n)g ghai bhabha'k ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਅੰਗਾ ਦੇ ਫਟਾ ਵਿੱਚੋਂ ਭਕ-ਭਕ ਕਰਕੇ (ਲਹੂ ਨਿਕਲ ਰਿਹਾ ਹੈ)",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "कहूँ अंग घाइ भभक्क ॥",
      "sourceLineId": "86985",
      "sourceShabadId": "8066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0281_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਹੂੰ ਸ੍ਰੋਣ ਸਰਤ ਛਲੱਕ ॥੭੮੦॥",
      "transliteration": "kahoo(n) sron sarat chhala'k ||780||",
      "translation": "Somewhere the wound of the limbs burst open and somewhere the stream of blood overflowed.780.",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਲਹੂ ਦੀ ਨਦੀ ਉਛਲ ਰਹੀ ਹੈ ॥੭੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": "कहूँ स्रोण सरत छलक्क ॥७८०॥",
      "sourceLineId": "86986",
      "sourceShabadId": "8066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
