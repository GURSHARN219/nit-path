{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 284,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0284_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭਿੱਨੇ ਨੂਰ ॥੮੦੩॥",
      "transliteration": "bhi'ne noor ||803||",
      "translation": "The warriors of chopped limbs fell in the field, they were looking extremely magnificent.803.",
      "punjabiViakhya": "ਅਤੇ (ਪਿੱਛੇ ਨੂੰ) ਨਹੀਂ ਵੇਖਦੇ ॥੮੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "भिन्ने नूर ॥८०३॥",
      "sourceLineId": "87083",
      "sourceShabadId": "8070",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਲੱਖੈ ਨਾਹਿ ॥",
      "transliteration": "la'khai naeh ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ ਭੇਸ ਬਦਲ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "लक्खै नाहि ॥",
      "sourceLineId": "87084",
      "sourceShabadId": "8070",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭੱਗੇ ਜਾਹਿ ॥",
      "transliteration": "bha'ge jaeh ||",
      "translation": "",
      "punjabiViakhya": "ਕੇਸ ਖੁੱਲ੍ਰਹੇ ਛੱਡ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "भग्गे जाहि ॥",
      "sourceLineId": "87085",
      "sourceShabadId": "8070",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤੱਜੇ ਰਾਮ ॥",
      "transliteration": "ta'je raam ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰਾ ਨੂੰ ਛੱਡ ਕੇ-",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "तज्जे राम ॥",
      "sourceLineId": "87086",
      "sourceShabadId": "8070",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਧਰਮੰ ਧਾਮ ॥੮੦੪॥",
      "transliteration": "dharama(n) dhaam ||804||",
      "translation": "They are running away without seeing anything  they are leaving even Ram, the abode of Dharma.804.",
      "punjabiViakhya": "ਭੇਟਾ ('ਕੋਰ') ਵਜੋਂ- (ਭੱਜੇ ਜਾ ਰਹੇ ਹਨ ॥੮੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "धरमं धाम ॥८०४॥",
      "sourceLineId": "87087",
      "sourceShabadId": "8070",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਉਰੈ ਭੇਸ ॥",
      "transliteration": "aaurai bhes ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "अउरै भेस ॥",
      "sourceLineId": "87088",
      "sourceShabadId": "8070",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਖੁੱਲੇ ਕੇਸ ॥",
      "transliteration": "khu'le kes ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਪਾਸਿਆਂ ਤੋਂ ਸੂਰਮੇ ਮਾਰੇ ਗਏ, ਦੋ ਪਹਿਰ ਚੰਗਾ ਯੁੱਧ ਮਚਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "खुल्ले केस ॥",
      "sourceLineId": "87089",
      "sourceShabadId": "8070",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਸਤ੍ਰੰ ਛੋਰ ॥",
      "transliteration": "sasatra(n) chhor ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਸੈਨਾ ਮਾਰੀ ਗਈ, ਸ੍ਰੀ ਰਾਮ ਹੀ ਇਕੱਲੇ ਰਹਿ ਗਏ ॥੮੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "ससत्रं छोर ॥",
      "sourceLineId": "87090",
      "sourceShabadId": "8070",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੈ ਦੈ ਕੋਰ ॥੮੦੫॥",
      "transliteration": "dhai dhai kor ||805||",
      "translation": "The warriors, disguising themselves, loosening their hair and forsaking their weapons, are running away by the sides of the battlefield.805.",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨੇ) ਨਿਡਰ ਹੋ ਕੇ ਤਿੰਨਾ ਭਰਾਵਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ਅਤੇ ਸਾਰੀ ਸੈਨਾ ਨੂੰ ਸੰਘਾਰ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "दै दै कोर ॥८०५॥",
      "sourceLineId": "87091",
      "sourceShabadId": "8070",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਲਵ ਅਤੇ ਕੁਸ਼ (ਉਨ੍ਰਹਾ ਦੋਹਾ ਭਰਾਵਾ) ਨੇ ਸ੍ਰੀ ਰਾਮ ਨੂੰ ਯੁੱਧ ਲਈ ਵੰਗਾਰਿਆ ॥੮੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "87092",
      "sourceShabadId": "8071",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦੁਹੂੰ ਦਿਸਨ ਜੋਧਾ ਹਰੈ ਪਰਯੋ ਜੁੱਧ ਦੁਐ ਜਾਮ ॥",
      "transliteration": "dhuhoo(n) dhisan jodhaa harai parayo ju'dh dhuaai jaam ||",
      "translation": "The warriors of both sides were killed and for two pehars (about six houts) the war continued",
      "punjabiViakhya": "ਸਾਰੀ ਸੈਨਾ ਨੂੰ ਮਰਵਾ ਕੇ ਕਿੱਥੇ ਜਾ ਕੇ ਲੁਕੇ ਬੈਠੇ ਹੋ ?",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "दुहूँ दिसन जोधा हरै परयो जुद्ध दुऐ जाम ॥",
      "sourceLineId": "87093",
      "sourceShabadId": "8071",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੂਝ ਸਕਲ ਸੈਨਾ ਗਈ ਰਹਿਗੇ ਏਕਲ ਰਾਮ ॥੮੦੬॥",
      "transliteration": "joojh sakal sainaa giee rahige ekal raam ||806||",
      "translation": "All the forces of Ram were killed and now he survived alone.806.",
      "punjabiViakhya": "ਹੇ ਕੌਸ਼ਲ ਦੇਸ਼ ਦੇ ਰਾਜੇ (ਸ੍ਰੀ ਰਾਮ) ਹੁਣ ਤੁਸੀਂ ਆਪ ਆ ਕੇ ਸਾਡੇ ਨਾਲ ਯੁੱਧ ਕਰੋ ॥੮੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "जूझ सकल सैना गई रहिगे एकल राम ॥८०६॥",
      "sourceLineId": "87094",
      "sourceShabadId": "8071",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਿਹੂ ਭ੍ਰਾਤ ਬਿਨੁ ਭੈ ਹਨਯੋ ਅਰ ਸਭ ਦਲਹਿ ਸੰਘਾਰ ॥",
      "transliteration": "tihoo bhraat bin bhai hanayo ar sabh dhaleh sa(n)ghaar ||",
      "translation": "Lava and Kusha killed the three brothers and",
      "punjabiViakhya": "ਸ੍ਰੀ ਰਾਮ ਨੇ ਬਾਲਕਾ ਨੂੰ ਆਪਣੇ ਮੁਹਾਦਰੇ ਵਾਲਾ ਵੇਖ ਕੇ ਹੱਸ ਕੇ ਬਚਨ ਕਿਹਾ-",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "तिहू भ्रात बिनु भै हनयो अर सभ दलहि संघार ॥",
      "sourceLineId": "87095",
      "sourceShabadId": "8071",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਲਵ ਅਰੁ ਕੁਸ ਜੂਝਨ ਨਿਮਿਤ ਲੀਨੋ ਰਾਮ ਹਕਾਰ ॥੮੦੭॥",
      "transliteration": "lav ar kus joojhan nimit leeno raam hakaar ||807||",
      "translation": "Their forces fearlessly and now they challenged Ram.807.",
      "punjabiViakhya": "ਹੇ ਬਾਲਕੋ! ਤੁਹਾਡਾ ਪਿਤਾ ਕੌਣ ਹੈ? ਅਤੇ ਤੁਹਾਡੀ ਮਾਤਾ ਕੌਣ ਹੈ? ॥੮੦੯॥",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "लव अरु कुस जूझन निमित लीनो राम हकार ॥८०७॥",
      "sourceLineId": "87096",
      "sourceShabadId": "8071",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੈਨਾ ਸਕਲ ਜੁਝਾਇ ਕੈ ਕਤਿ ਬੈਠੇ ਛਪ ਜਾਇ ॥",
      "transliteration": "sainaa sakal jujhai kai kat baiThe chhap jai ||",
      "translation": "The boys (of the sage) said to Ram, “O, the King of Kaushal!",
      "punjabiViakhya": "ਅਕਰਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "सैना सकल जुझाइ कै कति बैठे छप जाइ ॥",
      "sourceLineId": "87097",
      "sourceShabadId": "8071",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਬ ਹਮ ਸੋ ਤੁਮਹੂੰ ਲਰੋ ਸੁਨਿ ਸੁਨਿ ਕਉਸਲ ਰਾਇ ॥੮੦੮॥",
      "transliteration": "ab ham so tumahoo(n) laro sun sun kausal rai ||808||",
      "translation": "You have got all your army killed and where are you hiding now? Now come and fight with us.”808.",
      "punjabiViakhya": "ਮਿਥਲਾ ਸ਼ਹਿਰ",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "अब हम सो तुमहूँ लरो सुनि सुनि कउसल राइ ॥८०८॥",
      "sourceLineId": "87098",
      "sourceShabadId": "8071",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਿਰਖ ਬਾਲ ਨਿਜ ਰੂਪ ਪ੍ਰਭ ਕਹੇ ਬੈਨ ਮੁਸਕਾਇ ॥",
      "transliteration": "nirakh baal nij roop prabh kahe bain musakai ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੋਭਾਸ਼ਾਲੀ ਰਾਜੇ ਜਨਕ",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "निरख बाल निज रूप प्रभ कहे बैन मुसकाइ ॥",
      "sourceLineId": "87099",
      "sourceShabadId": "8071",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਵਨ ਤਾਤ ਬਾਲਕ ਤੁਮੈ ਕਵਨ ਤਿਹਾਰੀ ਮਾਇ ॥੮੦੯॥",
      "transliteration": "kavan taat baalak tumai kavan tihaaree mai ||809||",
      "translation": "Seeing the children as his own replica, Ram asked smilingly, “O boys! who are your parents?”809.",
      "punjabiViakhya": "ਦੀ ਬਹੁਤ ਸ਼ੋਭਾਸ਼ਾਲੀ",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "कवन तात बालक तुमै कवन तिहारी माइ ॥८०९॥",
      "sourceLineId": "87100",
      "sourceShabadId": "8071",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਕਰਾ ਛੰਦ ॥",
      "transliteration": "akaraa chha(n)dh ||",
      "translation": "AKRAA STANZA",
      "punjabiViakhya": "ਪੁੱਤਰੀ ਸੀਤਾ ਹੈ ॥੮੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "अकरा छंद ॥",
      "sourceLineId": "87101",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਿਥਲਾ ਪੁਰ ਰਾਜਾ ॥",
      "transliteration": "mithalaa pur raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬਣ ਵਿੱਚ ਆਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "मिथला पुर राजा ॥",
      "sourceLineId": "87102",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਨਕ ਸੁਭਾਜਾ ॥",
      "transliteration": "janak subhaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਸਾਨੂੰ ਜਨਮ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "जनक सुभाजा ॥",
      "sourceLineId": "87103",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਿਹ ਸਿਸ ਸੀਤਾ ॥",
      "transliteration": "teh sis seetaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਸੀਂ ਦੋਵੇਾਂ ਭਰਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "तिह सिस सीता ॥",
      "sourceLineId": "87104",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਤਿ ਸੁਭ ਗੀਤਾ ॥੮੧੦॥",
      "transliteration": "at subh geetaa ||810||",
      "translation": "“Sita, the daughter of the king Janak of Mithilapur is beautiful like a propitious song 810",
      "punjabiViakhya": "ਹੇ ਰਘੂ ਕੁਲ ਦੇ ਰਾਜੇ! ਸੁਣ ਲਵੋ ॥੮੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "अति सुभ गीता ॥८१०॥",
      "sourceLineId": "87105",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0284_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੋ ਬਨਿ ਆਏ ॥",
      "transliteration": "so ban aae ||",
      "translation": "",
      "punjabiViakhya": "ਸੀਤਾ ਰਾਣੀ (ਦੇ ਪੁੱਤਰ ਹੋਣ ਦੀ ਗੱਲ) ਸੁਣ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": "सो बनि आए ॥",
      "sourceLineId": "87106",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
