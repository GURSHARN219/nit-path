{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 285,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0285_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਿਹ ਹਮ ਜਾਏ ॥",
      "transliteration": "teh ham jaae ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਜਾਣ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "तिह हम जाए ॥",
      "sourceLineId": "87107",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਹੈਂ ਦੁਇ ਭਾਈ ॥",
      "transliteration": "hai(n) dhui bhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਚਿੱਤ ਵਿੱਚ (ਉਨ੍ਰਹਾ ਨੂੰ) ਪਛਾਣ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "हैं दुइ भाई ॥",
      "sourceLineId": "87108",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੁਨਿ ਰਘੁਰਾਈ ॥੮੧੧॥",
      "transliteration": "sun raghuraiee ||811||",
      "translation": "“O the king of Raghu clan! she has come to the forest and given birth to us and we are two brothers.”811.",
      "punjabiViakhya": "ਪਰ ਮੂੰਹੋਂ ਕੋਈ ਗੱਲ ਨਾ ਆਖੀ ॥੮੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "सुनि रघुराई ॥८११॥",
      "sourceLineId": "87109",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੁਨਿ ਸੀਅ ਰਾਨੀ ॥",
      "transliteration": "sun seea raanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਆਪਣੇ ਪੁੱਤਰ ਮੰਨ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "सुनि सीअ रानी ॥",
      "sourceLineId": "87110",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰਘੁਬਰ ਜਾਨੀ ॥",
      "transliteration": "raghubar jaanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਤਿ ਬਲ ਵਾਲੇ ਜਾਣ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "रघुबर जानी ॥",
      "sourceLineId": "87111",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚਿਤ ਪਹਿਚਾਨੀ ॥",
      "transliteration": "chit pahichaanee ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਵੀ ਹਠ ਨਾਲ ਯੁੱਧ ਕੀਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "चित पहिचानी ॥",
      "sourceLineId": "87112",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮੁਖ ਨ ਬਖਾਨੀ ॥੮੧੨॥",
      "transliteration": "mukh na bakhaanee ||812||",
      "translation": "When Sita heard and came to know about Ram, she then, even recognizing him, did not utter a word from her mouth.812.",
      "punjabiViakhya": "ਅਤੇ ਕੁਝ ਵੀ ਨਾ ਕਿਹਾ ॥੮੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "मुख न बखानी ॥८१२॥",
      "sourceLineId": "87113",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਿਹ ਸਿਸ ਮਾਨਯੋ ॥",
      "transliteration": "teh sis maanayo ||",
      "translation": "",
      "punjabiViakhya": "ਖਿੱਚ-ਖਿੱਚ ਕੇ ਤੀਰ ਮਾਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "तिह सिस मानयो ॥",
      "sourceLineId": "87114",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਤਿ ਬਲ ਜਾਨਯੋ ॥",
      "transliteration": "at bal jaanayo ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਬਾਲਕ ਨਹੀਂ ਹਾਰੇ।",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "अति बल जानयो ॥",
      "sourceLineId": "87115",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਹਠਿ ਰਣ ਕੀਨੋ ॥",
      "transliteration": "haTh ran keeno ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਵੀ) ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਤੀਰਾ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "हठि रण कीनो ॥",
      "sourceLineId": "87116",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਹ ਨਹੀ ਦੀਨੋ ॥੮੧੩॥",
      "transliteration": "keh nahee dheeno ||813||",
      "translation": "She forbade her sons and told them, “Ram is extremely mighty, you are persistently waging a war against him.” Saying this even Sita did not say the whole thing.813.",
      "punjabiViakhya": "ਧਨੁਸ਼ ਤੋਂ ਖਿੱਚ-ਖਿੱਚ ਕੇ ਮਾਰਦੇ ਸਨ ॥੮੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "कह नही दीनो ॥८१३॥",
      "sourceLineId": "87117",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਸਿ ਸਰ ਮਾਰੇ ॥",
      "transliteration": "kas sar maare ||",
      "translation": "",
      "punjabiViakhya": "(ਲਵ ਕੁਸ਼ ਨੇ) ਅੰਗ-ਅੰਗ ਵਿੰਨ੍ਰਹ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "कसि सर मारे ॥",
      "sourceLineId": "87118",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਿਸ ਨਹੀ ਹਾਰੇ ॥",
      "transliteration": "sis nahee haare ||",
      "translation": "",
      "punjabiViakhya": "(ਸ੍ਰੀ ਰਾਮ ਦੇ) ਸਾਰੇ ਸਰੀਰ ਨੂੰ ਛੇਕ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "सिस नही हारे ॥",
      "sourceLineId": "87119",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਬਾਣੰ ॥",
      "transliteration": "bahu bidh baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਸੈਨਾ ਨੂੰ ਅਹਿਸਾਸ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि बाणं ॥",
      "sourceLineId": "87120",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਤਿ ਧਨੁ ਤਾਣੰ ॥੮੧੪॥",
      "transliteration": "at dhan taana(n) ||814||",
      "translation": "Those boys did not retreat and accept defeat and discharged their arrows with full force after stretching their bows.814.",
      "punjabiViakhya": "ਕਿ ਸ੍ਰੀ ਰਾਮ ਜੂਝ ਗਏ ਹਨ ॥੮੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "अति धनु ताणं ॥८१४॥",
      "sourceLineId": "87121",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅੰਗ ਅੰਗ ਬੇਧੇ ॥",
      "transliteration": "a(n)g a(n)g bedhe ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਸ੍ਰੀ ਰਾਮ ਮਾਰੇ ਗਏ ਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "अंग अंग बेधे ॥",
      "sourceLineId": "87122",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਭ ਤਨ ਛੇਦੇ ॥",
      "transliteration": "sabh tan chhedhe ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਸੈਨਾ ਹਾਰ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "सभ तन छेदे ॥",
      "sourceLineId": "87123",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਭ ਦਲ ਸੂਝੇ ॥",
      "transliteration": "sabh dhal soojhe ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "सभ दल सूझे ॥",
      "sourceLineId": "87124",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਘੁਬਰ ਜੂਝੇ ॥੮੧੫॥",
      "transliteration": "raghubar joojhe ||815||",
      "translation": "Al the limbs of Ram were pierced and his whole body eroded, the whole army came to know this that Ram had passed away.815.",
      "punjabiViakhya": "ਦੋਹਾ ਬਾਲਕਾ ਅੱਗੇ ਭੱਜ ਤੁਰੀ ॥੮੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "रघुबर जूझे ॥८१५॥",
      "sourceLineId": "87125",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਬ ਪ੍ਰਭ ਮਾਰੇ ॥",
      "transliteration": "jab prabh maare ||",
      "translation": "",
      "punjabiViakhya": "(ਸੈਨਿਕ) ਮੁੜ ਕੇ ਨਹੀਂ ਵੇਖਦੇ,",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "जब प्रभ मारे ॥",
      "sourceLineId": "87126",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਭ ਦਲ ਹਾਰੇ ॥",
      "transliteration": "sabh dhal haare ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੀ ਰਾਮ ਨੂੰ ਚੇਤੇ ਵੀ ਨਹੀਂ ਕਰਦੇ,",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "सभ दल हारे ॥",
      "sourceLineId": "87127",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਭਾਗੇ ॥",
      "transliteration": "bahu bidh bhaage ||",
      "translation": "",
      "punjabiViakhya": "ਘਰ ਦਾ ਰਾਹ ਫੜ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि भागे ॥",
      "sourceLineId": "87128",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦੁਐ ਸਿਸ ਆਗੇ ॥੮੧੬॥",
      "transliteration": "dhuaai sis aage ||816||",
      "translation": "When Ram passed away, then the whole army began to flee accordingly in front of those two boys.816.",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਯੁੱਧ ਕੀਤਾ ॥੮੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "दुऐ सिस आगे ॥८१६॥",
      "sourceLineId": "87129",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਫਿਰਿ ਨ ਨਿਹਾਰੈਂ ॥",
      "transliteration": "fir na nihaarai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "फिरि न निहारैं ॥",
      "sourceLineId": "87130",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪ੍ਰਭੂ ਨ ਚਿਤਾਰੈਂ ॥",
      "transliteration": "prabhoo na chitaarai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦੋਹਾ ਬਾਲਕ ਨੇ ਰਣ-ਭੂਮੀ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "प्रभू न चितारैं ॥",
      "sourceLineId": "87131",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗ੍ਰਹ ਦਿਸਿ ਲੀਨਾ ॥",
      "transliteration": "greh dhis leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਉਸ ਨੂੰ ਰੁਦ੍ਰ ਦਾ 'ਕ੍ਰੀੜਾ ਬਣ' ਸਮਝਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "ग्रह दिसि लीना ॥",
      "sourceLineId": "87132",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਸ ਰਣ ਕੀਨਾ ॥੮੧੭॥",
      "transliteration": "as ran keenaa ||817||",
      "translation": "They were not even turning around to see Ram, and being helpless they fled away to whichever side they could.817.",
      "punjabiViakhya": "ਜਿਸ ਵਿੱਚ ਕਟੀ ਹੋਈ ਸੈਨਾ ਬ੍ਰਿਛਾ ਵਰਗੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "अस रण कीना ॥८१७॥",
      "sourceLineId": "87133",
      "sourceShabadId": "8072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਅਤੇ ਸੂਰਮਿਆਂ ਦੇ ਅੰਗਾ ਤੋਂ ਉਭਰੇ ਗਹਿਣੇ (ਫੁੱਲਾ ਫਲਾ ਵਰਗੇ ਹਨ) ॥੮੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "87134",
      "sourceShabadId": "8073",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਬ ਦੁਹੂੰ ਬਾਲ ਅਯੋਧਨ ਦੇਖਾ ॥",
      "transliteration": "tab dhuhoo(n) baal ayodhan dhekhaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੜੇ ਬੇਹੋਸ਼ ਪਏ ਸਨ। (ਉਨ੍ਰਹਾ) ਸਾਰਿਆਂ ਨੂੰ ਚੁੱਕ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "तब दुहूँ बाल अयोधन देखा ॥",
      "sourceLineId": "87135",
      "sourceShabadId": "8073",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਨੋ ਰੁਦ੍ਰ ਕੀੜਾ ਬਨਿ ਪੇਖਾ ॥",
      "transliteration": "mano rudhr keeRaa ban pekhaa ||",
      "translation": "Then both the boys without any anxiety, looked towards the battlefield like Rudra surveying the forest",
      "punjabiViakhya": "ਘੋੜੇ ਸਮੇਤ ਉਥੋ ਚਲੇ ਗਏ, ਜਿੱਥੇ ਮਾਤਾ (ਸੀਤਾ) ਬੈਠੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "मनो रुद्र कीड़ा बनि पेखा ॥",
      "sourceLineId": "87136",
      "sourceShabadId": "8073",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਾਟਿ ਧੁਜਨ ਕੇ ਬ੍ਰਿੱਛ ਸਵਾਰੇ ॥",
      "transliteration": "kaaT dhujan ke bira'chh savaare ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਸੀਤਾ ਨੇ ਮੂਰਛਿਤ ਪਤੀ ਦਾ ਮੁੱਖ ਵੇਖਿਆ ਤਾ ਰੋਣ ਲੱਗ ਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "काटि धुजन के बृच्छ सवारे ॥",
      "sourceLineId": "87137",
      "sourceShabadId": "8073",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭੂਖਨ ਅੰਗ ਅਨੂਪ ਉਤਾਰੇ ॥੮੧੮॥",
      "transliteration": "bhookhan a(n)g anoop utaare ||818||",
      "translation": "The banners were cut and attached to the trees and the unique ornaments of the soldiers were removed from their limbs and thrown away.818.",
      "punjabiViakhya": "ਅਤੇ ਕਹਿਣ ਲੱਗੀ-ਹੇ ਪੁੱਤਰੋ! ਤੁਸਾ ਮੈਨੂੰ ਵਿਧਵਾ ਕਰ ਦਿੱਤਾ ਹੈ ॥੮੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "भूखन अंग अनूप उतारे ॥८१८॥",
      "sourceLineId": "87138",
      "sourceShabadId": "8073",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮੂਰਛ ਭਏ ਸਭ ਲਏ ਉਠਈ ॥",
      "transliteration": "moorachh bhe sabh le uThiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਦੇ ਰਾਮਾਵਤਾਰ ਦੇ ਲਵ ਦੇ ਘੋੜਾ ਬੰਨਣ ਅਤੇ ਰਾਮ-ਬਧ ਵਾਲੇ ਅਧਿਆਇ ਦੀ ਸਮਾਪਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "मूरछ भए सभ लए उठई ॥",
      "sourceLineId": "87139",
      "sourceShabadId": "8073",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਾਜ ਸਹਿਤ ਤਹ ਗੇ ਜਹ ਮਾਈ ॥",
      "transliteration": "baaj sahit teh ge jeh maiee ||",
      "translation": "Those who were unconscious, the boys raised them and reached the place alongwith the horses, where Sita was sitting",
      "punjabiViakhya": "ਹੁਣ ਸੀਤਾ ਨੇ ਸਭ ਨੂੰ ਜੀਵਾਣ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "बाज सहित तह गे जह माई ॥",
      "sourceLineId": "87140",
      "sourceShabadId": "8073",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੇਖਿ ਸੀਆ ਪਤਿ ਮੁਖ ਰੋ ਦੀਨਾ ॥",
      "transliteration": "dhekh seeaa pat mukh ro dheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੀਤਾ ਨੇ ਪੁੱਤਰਾ ਪ੍ਰਤਿ ਕਿਹਾ-",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "देखि सीआ पति मुख रो दीना ॥",
      "sourceLineId": "87141",
      "sourceShabadId": "8073",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਹਯੋ ਪੂਤ ਬਿਧਵਾ ਮੁਹਿ ਕੀਨਾ ॥੮੧੯॥",
      "transliteration": "kahayo poot bidhavaa muh keenaa ||819||",
      "translation": "Seeing her dead husband Sita said, “O sons! you have made me a widow.”819.",
      "punjabiViakhya": "ਚੌਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "कहयो पूत बिधवा मुहि कीना ॥८१९॥",
      "sourceLineId": "87142",
      "sourceShabadId": "8073",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਰਾਮਵਤਾਰ ਲਵ ਬਾਜ ਬਾਧਵੇ ਰਾਮ ਬਧਹ ॥",
      "transliteration": "eit sree bachitr naaTake raamavataar lav baaj baadhave raam badheh ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੈਨੂੰ ਲਕੜਾ ਲਿਆ ਦਿਉ",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटके रामवतार लव बाज बाधवे राम बधह ॥",
      "sourceLineId": "87143",
      "sourceShabadId": "8073",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਥ ਸੀਤਾ ਨੇ ਸਭ ਜੀਵਾਏ ਕਥਨੰ ॥",
      "transliteration": "ath seetaa ne sabh jeevaae kathana(n) ||",
      "translation": "The description of the Revival of all by Sita :",
      "punjabiViakhya": "ਤਾ ਜੁ ਮੈਂ ਵੀ ਪਤੀ ਨਾਲ ਸੜ ਕੇ ਸੁਆਹ (ਮਸਾਨਾ) ਹੋਵਾ।",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "अथ सीता ने सभ जीवाए कथनं ॥",
      "sourceLineId": "87144",
      "sourceShabadId": "8074",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੀਤਾ ਬਾਚ ਪੁਤ੍ਰਨ ਸੋ ॥",
      "transliteration": "seetaa baach putran so ||",
      "translation": "The description of the Revival of all by Sita :",
      "punjabiViakhya": "(ਸਾਰੀ ਵਾਰਤਾ) ਸੁਣ ਕੇ ਮੁਨੀ ਰਾਜ (ਬਾਲਮੀਕ) ਵੀ ਬਹੁਤ ਰੋਏ।",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "सीता बाच पुत्रन सो ॥",
      "sourceLineId": "87145",
      "sourceShabadId": "8074",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿਣ ਲੱਗੇ-) ਇਨ੍ਰਹਾ ਬਾਲਕਾ ਨੇ ਸਾਡੇ ਸੁੱਖ ਨਸ਼ਟ ਕਰ ਦਿੱਤੇ ਹਨ ॥੮੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "87146",
      "sourceShabadId": "8074",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਬ ਮੋ ਕਉ ਕਾਸਟ ਦੇ ਆਨਾ ॥",
      "transliteration": "ab mo kau kaasaT dhe aanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਸੀਤਾ ਨੇ ਚਾਹਿਆ ਕਿ ਆਪਣੇ ਸਰੀਰ ਤੋਂ ਜੋਗ ਅਗਨੀ ਕੱਢਾ",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "अब मो कउ कासट दे आना ॥",
      "sourceLineId": "87147",
      "sourceShabadId": "8074",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਰਉ ਲਾਗਿ ਪਹਿ ਹੋਊਾਂ ਮਸਾਨਾ ॥",
      "transliteration": "jarau laag peh houooaa(n) masaanaa ||",
      "translation": "“Bring wood for me so that I may get myself reduced to ashes with my husband.”",
      "punjabiViakhya": "(ਅਤੇ ਸਰੀਰ ਨੂੰ) ਛੱਡ ਦਿਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "जरउ लागि पहि होऊाँ मसाना ॥",
      "sourceLineId": "87148",
      "sourceShabadId": "8074",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੁਨਿ ਮੁਨਿ ਰਾਜ ਬਹੁਤ ਬਿਧਿ ਰੋਏ ॥",
      "transliteration": "sun mun raaj bahut bidh roe ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੇ ਇਸ ਤਰ੍ਰਹਾ ਆਕਾਸ਼ ਬਾਣੀ ਹੋਈ-",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "सुनि मुनि राज बहुत बिधि रोए ॥",
      "sourceLineId": "87149",
      "sourceShabadId": "8074",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇਨ ਬਾਲਨ ਹਮਰੇ ਸੁਖ ਖੋਏ ॥੮੨੦॥",
      "transliteration": "ein baalan hamare sukh khoe ||820||",
      "translation": "Hearing this the great sage (Valmiki) lamented greatly and said, “These boys have destroyed all our comforts.”820.",
      "punjabiViakhya": "ਹੇ ਸੀਤਾ! ਕੀ ਤੂੰ ਇਆਣੀ ਹੋ ਗਈ ਹੈਂ ॥੮੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "इन बालन हमरे सुख खोए ॥८२०॥",
      "sourceLineId": "87150",
      "sourceShabadId": "8074",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਬ ਸੀਤਾ ਤਨ ਚਹਾ ਕਿ ਕਾਢੂੰ ॥",
      "transliteration": "jab seetaa tan chahaa k kaaddoo(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਰੂਪਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "जब सीता तन चहा कि काढूँ ॥",
      "sourceLineId": "87151",
      "sourceShabadId": "8074",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜੋਗ ਅਗਨਿ ਉਪਰਾਜ ਸੁ ਛਾਡੂੰ ॥",
      "transliteration": "jog agan uparaaj su chhaaddoo(n) ||",
      "translation": "When Sita said this that she would forsake her body by emanating the Yoga-fire from his own body,",
      "punjabiViakhya": "(ਜਦ) ਸੀਤਾ ਰਾਣੀ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "जोग अगनि उपराज सु छाडूँ ॥",
      "sourceLineId": "87152",
      "sourceShabadId": "8074",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਬ ਇਮ ਭਈ ਗਗਨ ਤੇ ਬਾਨੀ ॥",
      "transliteration": "tab im bhiee gagan te baanee ||",
      "translation": "",
      "punjabiViakhya": "ਆਕਾਸ਼ ਬਾਣੀ ਸੁਣੀ,",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "तब इम भई गगन ते बानी ॥",
      "sourceLineId": "87153",
      "sourceShabadId": "8074",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0285_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਹਾ ਭਈ ਸੀਤਾ ਤੈ ਇਯਾਨੀ ॥੮੨੧॥",
      "transliteration": "kahaa bhiee seetaa tai iyaanee ||821||",
      "translation": "Then there was heard this speech from heaven, “O Sita, why are you acting childlike.”821.",
      "punjabiViakhya": "ਪਾਣੀ ਮੰਗਵਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": "कहा भई सीता तै इयानी ॥८२१॥",
      "sourceLineId": "87154",
      "sourceShabadId": "8074",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
