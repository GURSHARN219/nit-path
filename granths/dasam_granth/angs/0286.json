  "ang": 286,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0286_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਰੂਪਾ ਛੰਦ ॥",
      "transliteration": "aroopaa chha(n)dh ||",
      "translation": "AROOPA STANZA",
      "punjabiViakhya": "ਹੱਥ ਵਿੱਚ ਲਿਆ ॥੮੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "अरूपा छंद ॥",
      "sourceLineId": "87155",
      "sourceShabadId": "8075",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੁਨੀ ਬਾਨੀ ॥",
      "transliteration": "sunee baanee ||",
      "translation": "",
      "punjabiViakhya": "ਸੀਤਾ ਨੇ ਮਨ ਵਿੱਚ ਕਿਹਾ-",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "सुनी बानी ॥",
      "sourceLineId": "87156",
      "sourceShabadId": "8075",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੀਆ ਰਾਨੀ ॥",
      "transliteration": "seeaa raanee ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "सीआ रानी ॥",
      "sourceLineId": "87157",
      "sourceShabadId": "8075",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਲਯੋ ਆਨੀ ॥",
      "transliteration": "layo aanee ||",
      "translation": "",
      "punjabiViakhya": "ਜੇਕਰ ਮੈਂ ਮਨ ਬਚਨ ਅਤੇ ਕਰਮ ਸਹਿਤ ਸ੍ਰੀ ਰਾਮ ਤੋਂ ਬਿਨਾ ਕਿਸੇ ਹੋਰ ਨੂੰ (ਪੁਰਸ਼ ਰੂਪ ਕਰਕੇ ਨਹੀਂ ਵੇਖਿਆ)",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "लयो आनी ॥",
      "sourceLineId": "87158",
      "sourceShabadId": "8075",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਰੈ ਪਾਨੀ ॥੮੨੨॥",
      "transliteration": "karai paanee ||822||",
      "translation": "Sita heard the speech and took water in her hand.822.",
      "punjabiViakhya": "ਤਾ ਇਸ ਵੇਲੇ ਰਾਮ ਜੀ ਸਹਿਤ ਸਾਰੇ ਜੀ ਪੈਣ, ਇਹ ਕਹਿ ਕੇ ਉਸ ਸਥਾਨ (ਉਤੇ ਪਾਣੀ ਛਿੜਕ ਦਿੱਤਾ) ॥੮੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "करै पानी ॥८२२॥",
      "sourceLineId": "87159",
      "sourceShabadId": "8075",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੀਤਾ ਬਾਚ ਮਨ ਮੈ ॥",
      "transliteration": "seetaa baach man mai ||",
      "translation": "Address of Sita to her mind :",
      "punjabiViakhya": "ਅਰੂਪਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "सीता बाच मन मै ॥",
      "sourceLineId": "87160",
      "sourceShabadId": "8076",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "(ਉਸੇ ਵੇਲੇ) ਸਾਰੇ ਜਾਗ ਪਏ,",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "87161",
      "sourceShabadId": "8076",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਉ ਮਨ ਬਚ ਕਰਮਨ ਸਹਿਤ ਰਾਮ ਬਿਨਾ ਨਹੀ ਅਉਰ ॥",
      "transliteration": "jau man bach karaman sahit raam binaa nahee aaur ||",
      "translation": "If in my mind, speech and action someone else except Ram had not been there at any time,",
      "punjabiViakhya": "(ਸਭ ਦੇ) ਭਰਮ ਦੂਰ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "जउ मन बच करमन सहित राम बिना नही अउर ॥",
      "sourceLineId": "87162",
      "sourceShabadId": "8076",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਉ ਏ ਰਾਮ ਸਹਿਤ ਜੀਐ ਕਹਯੋ ਸੀਆ ਤਿਹ ਠਉਰ ॥੮੨੩॥",
      "transliteration": "tau e raam sahit jeeaai kahayo seeaa teh Thaur ||823||",
      "translation": "Then at this time all the dead alogwith Ram may be reanimated.823.",
      "punjabiViakhya": "ਹਠ ਨੂੰ ਤਿਆਗ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "तउ ए राम सहित जीऐ कहयो सीआ तिह ठउर ॥८२३॥",
      "sourceLineId": "87163",
      "sourceShabadId": "8076",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਰੂਪਾ ਛੰਦ ॥",
      "transliteration": "aroopaa chha(n)dh ||",
      "translation": "AROOPA STANZA",
      "punjabiViakhya": "(ਸੀਤਾ ਦੇ) ਪੈਰੀਂ ਜਾ ਲੱਗੇ ॥੮੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "अरूपा छंद ॥",
      "sourceLineId": "87164",
      "sourceShabadId": "8077",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਭੈ ਜਾਗੇ ॥",
      "transliteration": "sabhai jaage ||",
      "translation": "",
      "punjabiViakhya": "(ਸ੍ਰੀ ਰਾਮ ਨੇ) ਸੀਤਾ ਨੂੰ ਲਿਆਂਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "सभै जागे ॥",
      "sourceLineId": "87165",
      "sourceShabadId": "8077",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭ੍ਰਮੰ ਭਾਗੇ ॥",
      "transliteration": "bhrama(n) bhaage ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਨੂੰ) ਜਗਤ ਦੀ ਰਾਣੀ,",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "भ्रमं भागे ॥",
      "sourceLineId": "87166",
      "sourceShabadId": "8077",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹਠੰ ਤਯਾਗੇ ॥",
      "transliteration": "haTha(n) tayaage ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਮ ਦੀ ਧਾਮ",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "हठं तयागे ॥",
      "sourceLineId": "87167",
      "sourceShabadId": "8077",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪਗੰ ਲਾਗੇ ॥੮੨੪॥",
      "transliteration": "paga(n) laage ||824||",
      "translation": "All the dead were reanimated, the illusion of all was removed and all leaving their persistence fell at the feet of SIta.824.",
      "punjabiViakhya": "ਅਤੇ ਸਤੀ ਕਰਕੇ ਮੰਨ ਲਿਆ ॥੮੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "पगं लागे ॥८२४॥",
      "sourceLineId": "87168",
      "sourceShabadId": "8077",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੀਆ ਆਨੀ ॥",
      "transliteration": "seeaa aanee ||",
      "translation": "",
      "punjabiViakhya": "(ਸ੍ਰੀ ਰਾਮ ਦੇ) ਮਨ ਨੂੰ ਚੰਗੀ ਲੱਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "सीआ आनी ॥",
      "sourceLineId": "87169",
      "sourceShabadId": "8077",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਗੰ ਰਾਨੀ ॥",
      "transliteration": "jaga(n) raanee ||",
      "translation": "",
      "punjabiViakhya": "ਗਲ ਨਾਲ ਲਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "जगं रानी ॥",
      "sourceLineId": "87170",
      "sourceShabadId": "8077",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਧਰਮ ਧਾਨੀ ॥",
      "transliteration": "dharam dhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਤੀ ਕਰਕੇ ਜਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "धरम धानी ॥",
      "sourceLineId": "87171",
      "sourceShabadId": "8077",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਤੀ ਮਾਨੀ ॥੮੨੫॥",
      "transliteration": "satee maanee ||825||",
      "translation": "Sita was accepted as queen of the world and a sati, the source of Dharma.825.",
      "punjabiViakhya": "ਅਤੇ ਮਨ ਵਿੱਚ ਆਦਰ ਦਿੱਤਾ ॥੮੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "सती मानी ॥८२५॥",
      "sourceLineId": "87172",
      "sourceShabadId": "8077",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਨੰ ਭਾਈ ॥",
      "transliteration": "mana(n) bhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "मनं भाई ॥",
      "sourceLineId": "87173",
      "sourceShabadId": "8077",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਉਰੰ ਲਾਈ ॥",
      "transliteration": "aura(n) laiee ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਸੀਤਾ ਨੂੰ ਗਿਆਨ ਉਪਦੇਸ਼ ਦੇ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "उरं लाई ॥",
      "sourceLineId": "87174",
      "sourceShabadId": "8077",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਤੀ ਜਾਨੀ ॥",
      "transliteration": "satee jaanee ||",
      "translation": "",
      "punjabiViakhya": "ਲਵ ਅਤੇ ਕੁਸ਼ ਦੋਹਾ ਸਮੇਤ ਸ੍ਰੀ, ਰਾਜਾ ਰਾਮ ਚੰਦਰ ਅਯੁੱਧਿਆ ਦੇਸ਼ ਵੱਲ ਚੱਲ ਪਏ ॥੮੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "सती जानी ॥",
      "sourceLineId": "87175",
      "sourceShabadId": "8077",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਨੈ ਮਾਨੀ ॥੮੨੬॥",
      "transliteration": "manai maanee ||826||",
      "translation": "Ram loved her and considering her a sati, he hugged her to his bosom.826.",
      "punjabiViakhya": "ਚੌਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "मनै मानी ॥८२६॥",
      "sourceLineId": "87176",
      "sourceShabadId": "8077",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਪੁੱਤਰਾ ਨੂੰ ਗਿਆਨ ਉਪਦੇਸ਼ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "87177",
      "sourceShabadId": "8078",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਸੀਅਹਿ ਸਮੋਧ ਕਰਿ ਚਲੇ ਅਜੁਧਿਆ ਦੇਸ ॥",
      "transliteration": "bahu bidh se'eeh samodh kar chale ajudhiaa dhes ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੀਤਾ ਸਹਿਤ ਸ੍ਰੀ ਰਾਮ ਅਯੁੱਧਿਆ ਨੂੰ ਚੱਲੇ।",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि सीअहि समोध करि चले अजुधिआ देस ॥",
      "sourceLineId": "87178",
      "sourceShabadId": "8078",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਲਵ ਕੁਸ ਦੋਊ ਪੁਤ੍ਰਨਿ ਸਹਿਤ ਸ੍ਰੀ ਰਘੁਬੀਰ ਨਰੇਸ ॥੮੨੭॥",
      "transliteration": "lav kus dhouoo putran sahit sree raghubeer nares ||827||",
      "translation": "Instructing Sita in many ways and taking Lava and Kusha with him Raghuvir Ram started for Ajodhya.827.",
      "punjabiViakhya": "ਅਨੇਕ ਤਰ੍ਰਹਾ ਦੇ ਸ਼ਸਤ੍ਰ (ਉਨ੍ਰਹਾ ਦੇ ਸਰੀਰ ਉੱਤੇ ਸ਼ੋਭਾ ਪਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "लव कुस दोऊ पुत्रनि सहित स्री रघुबीर नरेस ॥८२७॥",
      "sourceLineId": "87179",
      "sourceShabadId": "8078",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਮਾਨੋ ਤਿੰਨ ਰਾਮ ਬਣ ਕੇ ਆਏ ਹਨ ॥੮੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "87180",
      "sourceShabadId": "8079",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਹੁਤੁ ਭਾਤਿ ਕਰ ਸਿਸਨ ਸਮੋਧਾ ॥",
      "transliteration": "bahut bhaat kar sisan samodhaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਦੇ ਰਾਮਾਵਤਾਰ ਦੇ ਤਿੰਨਾ ਭਰਾਵਾ ਦੇ ਸੈਨਾ ਸਹਿਤ ਜੀਣ ਦੇ ਪ੍ਰਸੰਗ ਦੀ ਸਮਾਪਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "बहुतु भाति कर सिसन समोधा ॥",
      "sourceLineId": "87181",
      "sourceShabadId": "8079",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੀਯ ਰਘੁਬੀਰ ਚਲੇ ਪੁਰਿ ਅਉਧਾ ॥",
      "transliteration": "seey raghubeer chale pur aaudhaa ||",
      "translation": "The children were also instructed in many ways and Sita and ram moved towards Oudh.",
      "punjabiViakhya": "ਹੁਣ ਸੀਤਾ ਦਾ ਦੋਹਾ ਪੁੱਤਰਾ ਸਹਿਤ ਅਵਧਪੁਰੀ ਵਿੱਚ ਪ੍ਰਵੇਸ਼ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "सीय रघुबीर चले पुरि अउधा ॥",
      "sourceLineId": "87182",
      "sourceShabadId": "8079",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਨਿਕ ਬੇਖ ਸੇ ਸਸਤ੍ਰ ਸੁਹਾਏ ॥",
      "transliteration": "anik bekh se sasatr suhaae ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "अनिक बेख से ससत्र सुहाए ॥",
      "sourceLineId": "87183",
      "sourceShabadId": "8079",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਾਨਤ ਤੀਨ ਰਾਮ ਬਨ ਆਏ ॥੮੨੮॥",
      "transliteration": "jaanat teen raam ban aae ||828||",
      "translation": "All the there were carrying weapons in different styles and it seemed that three Rams were walking.828.",
      "punjabiViakhya": "ਤਿੰਨਾ ਮਾਵਾ ਨੇ (ਪੋਤ੍ਰਿਆਂ ਨੂੰ) ਗਲ ਨਾਲ ਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "जानत तीन राम बन आए ॥८२८॥",
      "sourceLineId": "87184",
      "sourceShabadId": "8079",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਰਾਮਵਤਾਰੇ ਤਿਹੂ ਭਿਰਾਤਨ ਸੈਨਾ ਸਹਿਤ ਜੀਬੋ ॥",
      "transliteration": "eit sree bachitr naaTake raamavataare tihoo bhiraatan sainaa sahit jeebo ||",
      "translation": "End of the chapter entitled The Reanimation of the Three Brothers alongwith their forces in Ramavtar in BACHITTAR NATAK.",
      "punjabiViakhya": "ਅਤੇ ਦੋਵੇਾਂ ਪੁੱਤਰ ਚਰਨਾ ਨਾਲ ਲਿਪਟ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटके रामवतारे तिहू भिरातन सैना सहित जीबो ॥",
      "sourceLineId": "87185",
      "sourceShabadId": "8079",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੀਤਾ ਦੁਹੂ ਪੁਤ੍ਰਨ ਸਹਿਤ ਪੁਰੀ ਅਵਧ ਪ੍ਰਵੇਸ ਕਥਨੰ ॥",
      "transliteration": "seetaa dhuhoo putran sahit puree avadh praves kathana(n) ||",
      "translation": "The description of the Entry of Sita alongwith her two sons in Oudhpuri :",
      "punjabiViakhya": "ਫਿਰ ਸੀਤਾ ਆ ਕੇ (ਸੱਸਾ ਦੇ) ਪੈਰਾ 'ਤੇ ਡਿੱਗ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "सीता दुहू पुत्रन सहित पुरी अवध प्रवेस कथनं ॥",
      "sourceLineId": "87186",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਉਸ ਵੇਲੇ ਦੁੱਖਾ ਦੀ ਘੜੀ ਮਿਟ ਗਈ ॥੮੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "87187",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਿਹੂੰ ਮਾਤ ਕੰਠਨ ਸੋ ਲਾਏ ॥",
      "transliteration": "tihoo(n) maat ka(n)Than so laae ||",
      "translation": "",
      "punjabiViakhya": "ਕੌਸ਼ਲ ਦੇਸ਼ ਦੈ ਰਾਜੇ ਸ੍ਰੀ ਰਾਮ ਨੇ ਅਸ਼੍ਵਮੇਧ ਯੱਗ",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "तिहूँ मात कंठन सो लाए ॥",
      "sourceLineId": "87188",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੋਊ ਪੁਤ੍ਰ ਪਾਇਨ ਲਪਟਾਏ ॥",
      "transliteration": "dhouoo putr pain lapaTaae ||",
      "translation": "All the three mothers hugged all of them to their bosoms and Lava and Kusha came forward to touch their feet",
      "punjabiViakhya": "ਨਿਰਵਿਘਨ ਸਮਾਪਤ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "दोऊ पुत्र पाइन लपटाए ॥",
      "sourceLineId": "87189",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਹੁਰ ਆਨਿ ਸੀਤਾ ਪਗ ਪਰੀ ॥",
      "transliteration": "bahur aan seetaa pag paree ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਘਰ ਦੋ ਸਪੁੱਤਰ ਸ਼ੋਭਾ ਪਾ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "बहुर आनि सीता पग परी ॥",
      "sourceLineId": "87190",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਿਟ ਗਈ ਤਹੀਂ ਦੁਖਨ ਕੀ ਘਰੀ ॥੮੨੯॥",
      "transliteration": "miT giee tahee(n) dhukhan kee gharee ||829||",
      "translation": "Sita also touched their feet and it appeared that the time of suffering had ended.829lkh,",
      "punjabiViakhya": "ਅਤੇ ਉਹ ਦੇਸ਼ਾ ਵਿਦੇਸ਼ਾ ਨੂੰ ਜਿੱਤ ਕੇ ਘਰ ਆਏ ਹਨ ॥੮੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "मिट गई तहीं दुखन की घरी ॥८२९॥",
      "sourceLineId": "87191",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਾਜ ਮੇਧ ਪੂਰਨ ਕੀਅ ਜੱਗਾ ॥",
      "transliteration": "baaj medh pooran keea ja'gaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿੰਨੇ ਤਰ੍ਰਹਾ ਦੇ ਯੱਗਾ ਦਾ ਵਿਧਾਨ ਕਿਹਾ ਗਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "बाज मेध पूरन कीअ जग्गा ॥",
      "sourceLineId": "87192",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਉਸਲੇਸ ਰਘੁਬੀਰ ਅਭੱਗਾ ॥",
      "transliteration": "kausales raghubeer abha'gaa ||",
      "translation": "Raghuvir Ram completed the Ashavamedha Yajna (horse-sacrifice)",
      "punjabiViakhya": "ਉਹ ਵਿਧੀ ਪੂਰਵਕ ਅਨੇਕ (ਯੱਗ) ਕੀਤਾ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "कउसलेस रघुबीर अभग्गा ॥",
      "sourceLineId": "87193",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗ੍ਰਿਹ ਸਪੂਤ ਦੋ ਪੂਤ ਸੁਹਾਏ ॥",
      "transliteration": "gireh sapoot dho poot suhaae ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਇਕ ਘਟ ਸੌ ਯੱਗ ਪੂਰੇ ਹੋ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "गृह सपूत दो पूत सुहाए ॥",
      "sourceLineId": "87194",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੇਸ ਬਿਦੇਸ ਜੀਤ ਗ੍ਰਹ ਆਏ ॥੮੩੦॥",
      "transliteration": "dhes bidhes jeet greh aae ||830||",
      "translation": "And in his house, his two sons seemed very impressive who had come back home after conquering many countries.830.",
      "punjabiViakhya": "ਤਾ ਇੰਦਰ ਹੈਰਾਨ ਹੋ ਕੇ ਝਟਪਟ ਉਠ ਕੇ ਭੱਜ ਗਿਆ ॥੮੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "देस बिदेस जीत ग्रह आए ॥८३०॥",
      "sourceLineId": "87195",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜੇਤਿਕ ਕਹੇ ਸੁ ਜੱਗ ਬਿਧਾਨਾ ॥",
      "transliteration": "jetik kahe su ja'g bidhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਦਸ-ਬਾਰ੍ਰਹਾ ਰਾਜਸੂਯ ਯੱਗ ਕੀਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "जेतिक कहे सु जग्ग बिधाना ॥",
      "sourceLineId": "87196",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਿਧ ਪੂਰਬ ਕੀਨੇ ਤੇ ਨਾਨਾ ॥",
      "transliteration": "bidh poorab keene te naanaa ||",
      "translation": "All the rituals of Yajna were performed according to Vedic rites, s",
      "punjabiViakhya": "ਇੱਕੀ ਤਰ੍ਰਹਾ ਦੇ ਅਸ਼੍ਵਮੇਧ ਯੱਗ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "बिध पूरब कीने ते नाना ॥",
      "sourceLineId": "87197",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਏਕ ਘਾਟ ਸਤ ਕੀਨੇ ਜੱਗਾ ॥",
      "transliteration": "ek ghaaT sat keene ja'gaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੇਕਾ ਹੀ ਗੋਮੇਧ ਤੇ ਅਜਮੇਧ ਯੱਗ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "एक घाट सत कीने जग्गा ॥",
      "sourceLineId": "87198",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚਟ ਪਟ ਚਕ੍ਰ ਇੰਦ੍ਰ ਉਠਿ ਭੱਗਾ ॥੮੩੧॥",
      "transliteration": "chaT paT chakr i(n)dhr uTh bha'gaa ||831||",
      "translation": "Even Yajnas were performed at one place, seeing which Indra wondered and fled away.831.",
      "punjabiViakhya": "ਧਰਤੀ ਵਿੱਚ ਅਨੇਕਾ ਹੀ ਹੋਰ ਕਰਮ ਕੀਤੇ ॥੮੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "चट पट चक्र इंद्र उठि भग्गा ॥८३१॥",
      "sourceLineId": "87199",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਰਾਜਸੁਇ ਕੀਨੇ ਦਸ ਬਾਰਾ ॥",
      "transliteration": "raajasui keene dhas baaraa ||",
      "translation": "",
      "punjabiViakhya": "ਛੇ ਹਾਥੀ-ਮੇਧ ਯੱਗ ਕਰਾਏ,",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "राजसुइ कीने दस बारा ॥",
      "sourceLineId": "87200",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਾਜ ਮੇਧਿ ਇੱਕੀਸ ਪ੍ਰਕਾਰਾ ॥",
      "transliteration": "baaj medh i'kees prakaaraa ||",
      "translation": "Ten Rajsu Yajnas and twenty-one kinds of Ashvamedha Yajna were performed.",
      "punjabiViakhya": "ਜਿਹੜੇ ਜਨਮੇਜਾ ਵੀ ਨਾ ਕਰ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "बाज मेधि इक्कीस प्रकारा ॥",
      "sourceLineId": "87201",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0286_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗਵਾਲੰਭ ਅਜਮੇਧ ਅਨੇਕਾ ॥",
      "transliteration": "gavaala(n)bh ajamedh anekaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ ਕਿਥੋਂ ਤਕ ਗਿਣਦਾ ਜਾਵਾ ?",
      "source": "DASAM_GRANTH",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": "गवालंभ अजमेध अनेका ॥",
      "sourceLineId": "87202",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
