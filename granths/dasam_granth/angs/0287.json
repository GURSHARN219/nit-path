{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 287,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0287_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭੂਮਿ ਮੱਧ ਕਰਮ ਕੀਏ ਅਨੇਕਾ ॥੮੩੨॥",
      "transliteration": "bhoom ma'dh karam ke'ee anekaa ||832||",
      "translation": "Go-medh, Ajmedh and Bhoop-medh several types of Yajnas were performed.832.",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ) ਗ੍ਰੰਥ ਵੱਧ ਜਾਣ ਤੋਂ ਹਿਰਦੇ ਵਿੱਚ ਡਰਦਾ ਹਾ ॥੮੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "भूमि मद्ध करम कीए अनेका ॥८३२॥",
      "sourceLineId": "87203",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾਗਮੇਧ ਖਟ ਜੱਗ ਕਰਾਏ ॥",
      "transliteration": "naagamedh khaT ja'g karaae ||",
      "translation": "",
      "punjabiViakhya": "ਦਸ ਹਜ਼ਾਰ ਤੇ ਦਸ ਵਰ੍ਰਹੇ ਤਕ,",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "नागमेध खट जग्ग कराए ॥",
      "sourceLineId": "87204",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਉਨ ਕਰੇ ਜਨਮੇ ਜਯ ਪਾਏ ॥",
      "transliteration": "jaun kare janame jay paae ||",
      "translation": "Six Nagmedh Yajnas were performed which bring victory in life",
      "punjabiViakhya": "ਅਯੁੱਧਿਆ ਸ਼ਹਿਰ ਦਾ ਸ੍ਰੀ ਰਾਮ ਨੇ ਰਾਜ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "जउन करे जनमे जय पाए ॥",
      "sourceLineId": "87205",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਉਰੈ ਗਨਤ ਕਹਾ ਲਗ ਜਾਊਾਂ ॥",
      "transliteration": "aaurai ganat kahaa lag jaauooaa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਨੂੰ ਕਾਲ ਦੀ ਦਸ਼ਾ ਨੇੜੇ ਆ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "अउरै गनत कहा लग जाऊाँ ॥",
      "sourceLineId": "87206",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗ੍ਰੰਥ ਬਢਨ ਤੇ ਹੀਏ ਡਰਾਊਾਂ ॥੮੩੩॥",
      "transliteration": "gra(n)th baddan te he'ee ddaraauooaa(n) ||833||",
      "translation": "To what extent I should enumerate them because there is fear of the Granth becoming voluminous.833.",
      "punjabiViakhya": "ਸ੍ਰੀ ਰਾਮ ਦੇ ਸਿਰ ਉਤੇ ਮੌਤ ਨੇ ਡੰਕਾ ਵਜਾ ਦਿੱਤਾ ॥੮੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "ग्रंथ बढन ते हीए डराऊाँ ॥८३३॥",
      "sourceLineId": "87207",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਦਸ ਸਹੰਸ੍ਰ ਦਸ ਬਰਖ ਪ੍ਰਮਾਨਾ ॥",
      "transliteration": "dhas saha(n)sr dhas barakh pramaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਕਾਲ) ਨੂੰ ਅਨੇਕ ਤਰ੍ਰਹਾ ਨਾਲ ਨਮਸਕਾਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "दस सहंस्र दस बरख प्रमाना ॥",
      "sourceLineId": "87208",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਾਜ ਕਰਾ ਪੁਰ ਅਉਧ ਨਿਧਾਨਾ ॥",
      "transliteration": "raaj karaa pur aaudh nidhaanaa ||",
      "translation": "Ram ruled in Avadphpuri for ten thousand and ten years,",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਸਾਰੇ ਜਗਤ ਨੂੰ ਜਿੱਤ ਕੇ ਆਪਣੇ ਵਸ ਕੀਤਾ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "राज करा पुर अउध निधाना ॥",
      "sourceLineId": "87209",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਬ ਲਉ ਕਾਲ ਦਸਾ ਨੀਅਰਾਈ ॥",
      "transliteration": "tab lau kaal dhasaa neearaiee ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਦੇ ਸਿਰ ਉਤੇ ਉਸ ਦਾ ਡੰਕਾ ਵਜਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "तब लउ काल दसा नीअराई ॥",
      "sourceLineId": "87210",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰਘੁਬਰ ਸਿਰਿ ਮ੍ਰਿਤ ਡੰਕ ਬਜਾਈ ॥੮੩੪॥",
      "transliteration": "raghubar sir mirat dda(n)k bajaiee ||834||",
      "translation": "Then according to time schedule, the death beat its drum.834.",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਕੀ ਰਾਜਾ ਅਤੇ ਕੀ ਕੰਗਾਲ ਕੋਈ ਵੀ ਜਿੱਤ ਨਹੀਂ ਸਕਿਆ ॥੮੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "रघुबर सिरि मृत डंक बजाई ॥८३४॥",
      "sourceLineId": "87211",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਮਸਕਾਰ ਤਿਹ ਬਿਬਿਧਿ ਪ੍ਰਕਾਰਾ ॥",
      "transliteration": "namasakaar teh bibidh prakaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "नमसकार तिह बिबिधि प्रकारा ॥",
      "sourceLineId": "87212",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਨ ਜਗ ਜੀਤ ਕਰਯੋ ਬਸ ਸਾਰਾ ॥",
      "transliteration": "jin jag jeet karayo bas saaraa ||",
      "translation": "I bow before death in various ways, which has conquered the whole world and keeping it under its control.",
      "punjabiViakhya": "ਜਿਹੜੇ ਉਸ (ਕਾਲ) ਦੀ ਸ਼ਰਨੀਂ ਪਏ ਹਨ, (ਉਨ੍ਰਹਾ ਨੂੰ ਉਸ ਨੇ) ਹੱਥ ਦੇ ਕੇ ਬਚਾ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "जिन जग जीत करयो बस सारा ॥",
      "sourceLineId": "87213",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਭਹਨ ਸੀਸ ਡੰਕ ਤਿਹ ਬਾਜਾ ॥",
      "transliteration": "sabhahan sees dda(n)k teh baajaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਾਂਜ ਕ੍ਰਿਸ਼ਨ, ਵਿਸ਼ਣੂ ਤੇ ਰਾਮ ਚੰਦਰ ਆਦਿਕ ਕੋਈ ਵੀ (ਉਸ ਤੋਂ) ਬਚਿਆ ਨਹੀਂ ਹੈ ॥੮੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "सभहन सीस डंक तिह बाजा ॥",
      "sourceLineId": "87214",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੀਤ ਨ ਸਕਾ ਰੰਕ ਅਰੁ ਰਾਜਾ ॥੮੩੫॥",
      "transliteration": "jeet na sakaa ra(n)k ar raajaa ||835||",
      "translation": "The drum of death beats on everyone’s head and no king or pauper had been able to conquer it.835.",
      "punjabiViakhya": "ਚੌਪਈ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "जीत न सका रंक अरु राजा ॥८३५॥",
      "sourceLineId": "87215",
      "sourceShabadId": "8080",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਰਾਜ ਦੇ ਠਾਠ-ਬਾਠ ਕੀਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "87216",
      "sourceShabadId": "8081",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜੇ ਤਿਨ ਕੀ ਸਰਨੀ ਪਰੇ ਕਰ ਦੈ ਲਏ ਬਚਾਇ ॥",
      "transliteration": "je tin kee saranee pare kar dhai le bachai ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਸਾ ਦੇ ਰਾਜਿਆਂ ਨੂੰ ਜਿੱਤਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "जे तिन की सरनी परे कर दै लए बचाइ ॥",
      "sourceLineId": "87217",
      "sourceShabadId": "8081",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜੌ ਨਹੀ ਕੋਊ ਬਾਚਿਆ ਕਿਸਨ ਬਿਸਨ ਰਘੁਰਾਇ ॥੮੩੬॥",
      "transliteration": "jau nahee kouoo baachiaa kisan bisan raghurai ||836||",
      "translation": "He, who came under its refuge, it saved him and he, who did not go under its refuge, he could not be saved whether he was Krishna or Vishnu or Ram.836.",
      "punjabiViakhya": "(ਨੀਤੀ ਦੇ) ਸਾਮ, ਦਾਮ, ਦੰਡ ਅਤੇ ਭੇਦ ਚੌਹਾ ਅੰਗਾ ਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "जौ नही कोऊ बाचिआ किसन बिसन रघुराइ ॥८३६॥",
      "sourceLineId": "87218",
      "sourceShabadId": "8081",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚੌਪਈ ਛੰਦ ॥",
      "transliteration": "chauapiee chha(n)dh ||",
      "translation": "CHAUPAI STANZA",
      "punjabiViakhya": "ਵੇਦਾ ਅਨੁਸਾਰੀ ਵਿਵਸਥਾ ਦੀ ਪਾਲਣਾ ਕੀਤੀ ॥੮੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "चौपई छंद ॥",
      "sourceLineId": "87219",
      "sourceShabadId": "8082",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਕਰੋ ਰਾਜ ਕੋ ਸਾਜਾ ॥",
      "transliteration": "bahu bidh karo raaj ko saajaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਵਰਨਾ ਨੂੰ ਆਪਣੇ-ਆਪਣੇ ਕੰਮਾ ਵਿੱਚ ਰੱਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि करो राज को साजा ॥",
      "sourceLineId": "87220",
      "sourceShabadId": "8082",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦੇਸ ਦੇਸ ਕੇ ਜੀਤੇ ਰਾਜਾ ॥",
      "transliteration": "dhes dhes ke jeete raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ ਵਰਨਾ ਨੂੰ ਚਲਾਈ ਰਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "देस देस के जीते राजा ॥",
      "sourceLineId": "87221",
      "sourceShabadId": "8082",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਾਮ ਦਾਮ ਅਰੁ ਦੰਡ ਸਭੇਦਾ ॥",
      "transliteration": "saam dhaam ar dha(n)dd sabhedhaa ||",
      "translation": "",
      "punjabiViakhya": "ਛਤ੍ਰੀ ਬ੍ਰਾਹਮਣਾ ਦੀ ਸੇਵਾ ਕਰਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "साम दाम अरु दंड सभेदा ॥",
      "sourceLineId": "87222",
      "sourceShabadId": "8082",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਿਹ ਬਿਧਿ ਹੁਤੀ ਸਾਸਨਾ ਬੇਦਾ ॥੮੩੭॥",
      "transliteration": "jeh bidh hutee saasanaa bedhaa ||837||",
      "translation": "Performing his royal duties in many ways and practising Sama, Dama, Dand and Bhed and other methods of administration, Ram conquered other kings of many countries.837.",
      "punjabiViakhya": "ਅਤੇ ਵੈਸ਼ ਛਤ੍ਰੀਆਂ ਨੂੰ ਆਪਣਾ ਪੂਜਯ ਸਮਝਦੇ ਸਨ ॥੮੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "जिह बिधि हुती सासना बेदा ॥८३७॥",
      "sourceLineId": "87223",
      "sourceShabadId": "8082",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਰਨ ਬਰਨ ਅਪਨੀ ਕ੍ਰਿਤ ਲਾਏ ॥",
      "transliteration": "baran baran apanee kirat laae ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੂਦਰ ਸਾਰਿਆਂ ਦੀ ਸੇਵਾ ਕਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "बरन बरन अपनी कृत लाए ॥",
      "sourceLineId": "87224",
      "sourceShabadId": "8082",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚਾਰ ਚਾਰ ਹੀ ਬਰਨ ਚਲਾਏ ॥",
      "transliteration": "chaar chaar hee baran chalaae ||",
      "translation": "He caused every caste to do its duties and set in motion Varnashram Dharma",
      "punjabiViakhya": "ਜਿਥੇ ਕੋਈ (ਕਹਿੰਦਾ) ਉਥੇ ਹੀ ਉਹ ਜਾਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "चार चार ही बरन चलाए ॥",
      "sourceLineId": "87225",
      "sourceShabadId": "8082",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0287_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਛਤ੍ਰੀ ਕਰੈਂ ਬਿੱਪ੍ਰ ਕੀ ਸੇਵਾ ॥",
      "transliteration": "chhatree karai(n) bi'pr kee sevaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਵੇਦ ਦੀ ਆਗਿਆ ਹੁੰਦੀ,",
      "source": "DASAM_GRANTH",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": "छत्री करैं बिप्प्र की सेवा ॥",
      "sourceLineId": "87226",
      "sourceShabadId": "8082",
