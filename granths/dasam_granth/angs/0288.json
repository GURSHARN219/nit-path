{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 288,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0288_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬੈਸ ਲਖੈ ਛੱਤ੍ਰੀ ਕਹ ਦੇਵਾ ॥੮੩੮॥",
      "transliteration": "bais lakhai chha'tree keh dhevaa ||838||",
      "translation": "Kshatriyas began to serve the Brahmin and the Vaishyas considered the Kshatriyas as gods.838.",
      "punjabiViakhya": "ਸ੍ਰੀ ਰਾਮ ਦੀ ਰਸਨਾ ਤੋਂ ਉਹੀ ਕੁਝ ਨਿਕਲਦਾ ॥੮੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "बैस लखै छत्त्री कह देवा ॥८३८॥",
      "sourceLineId": "87227",
      "sourceShabadId": "8082",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੂਦ੍ਰ ਸਭਨ ਕੀ ਸੇਵ ਕਮਾਵੈ ॥",
      "transliteration": "soodhr sabhan kee sev kamaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਸ੍ਰੀ ਰਾਮ) ਨੇ ਰਾਵਣ ਵਰਗਿਆਂ ਨੂੰ ਰਣ ਵਿੱਚ ਲਲਕਾਰ ਕੇ ਮਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "सूद्र सभन की सेव कमावै ॥",
      "sourceLineId": "87228",
      "sourceShabadId": "8082",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਹ ਕੋਈ ਕਹੈ ਤਹੀ ਵਹ ਧਾਵੈ ॥",
      "transliteration": "jeh koiee kahai tahee veh dhaavai ||",
      "translation": "The Shudras began to serve all and they went wherever they were sent",
      "punjabiViakhya": "ਅਤੇ ਤਰ੍ਰਹਾ-ਤਰ੍ਰਹਾ ਨਾਲ ਸਾਰੇ ਸੇਵਕਾ ਨੂੰ ਤਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "जह कोई कहै तही वह धावै ॥",
      "sourceLineId": "87229",
      "sourceShabadId": "8082",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੈਸਕ ਹੁਤੀ ਬੇਦ ਸਾਸਨਾ ॥",
      "transliteration": "jaisak hutee bedh saasanaa ||",
      "translation": "",
      "punjabiViakhya": "ਲੰਕਾ (ਇਸ ਤਰ੍ਰਹਾ) ਦਿੱਤੀ ਮਾਨੋ ਟਕਾ ਦਿੱਤਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "जैसक हुती बेद सासना ॥",
      "sourceLineId": "87230",
      "sourceShabadId": "8082",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਿਕਸਾ ਤੈਸ ਰਾਮ ਕੀ ਰਸਨਾ ॥੮੩੯॥",
      "transliteration": "nikasaa tais raam kee rasanaa ||839||",
      "translation": "Ram always talked from his mouth about practicing administration according to Vedas.839.",
      "punjabiViakhya": "ਜਗਤ ਵਿੱਚ (ਰਾਮ ਨੇ) ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਰਾਜ ਕੀਤਾ ॥੮੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "निकसा तैस राम की रसना ॥८३९॥",
      "sourceLineId": "87231",
      "sourceShabadId": "8082",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਾਵਣਾਦਿ ਰਣਿ ਹਾਕ ਸੰਘਾਰੇ ॥",
      "transliteration": "raavanaadh ran haak sa(n)ghaare ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ ਛੰਦ",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "रावणादि रणि हाक संघारे ॥",
      "sourceLineId": "87232",
      "sourceShabadId": "8082",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਸੇਵਕ ਗਣ ਤਾਰੇ ॥",
      "transliteration": "bhaat bhaat sevak gan taare ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੀ ਰਾਮ ਨੇ ਵੈਰੀਆਂ ਨੂੰ ਨਸ਼ਟ ਕਰਕੇ ਬਹੁਤ ਵਰ੍ਰਹਿਆਂ ਤਕ ਰਾਜ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "भाति भाति सेवक गण तारे ॥",
      "sourceLineId": "87233",
      "sourceShabadId": "8082",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਲੰਕਾ ਦਈ ਟੰਕ ਜਨੁ ਦੀਨੋ ॥",
      "transliteration": "la(n)kaa dhiee Ta(n)k jan dheeno ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਬ੍ਰਹਮਰੰਧ੍ਰ ਨੂੰ ਫੋੜ ਕੇ ਕੁਸ਼ਲਿਆ ਦਾ ਕਾਲ ਹੋ ਗਿਆ ॥੮੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "लंका दई टंक जनु दीनो ॥",
      "sourceLineId": "87234",
      "sourceShabadId": "8082",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਰਾਜ ਜਗਤ ਮੈ ਕੀਨੋ ॥੮੪੦॥",
      "transliteration": "eeh bidh raaj jagat mai keeno ||840||",
      "translation": "Ram ruled by killing the tyrants like Ravana, by emancipating different devotees and attendants (ganas) and by collecting the taxes of Lanka.840.",
      "punjabiViakhya": "ਚੌਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "इह बिधि राज जगत मै कीनो ॥८४०॥",
      "sourceLineId": "87235",
      "sourceShabadId": "8082",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੋਹਰਾ ਛੰਦ ॥",
      "transliteration": "dhoharaa chha(n)dh ||",
      "translation": "DOHRA STANZA",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਨਾਲ ਮ੍ਰਿਤਕ ਦੇ ਸੰਸਕਾਰ ਹੁੰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "दोहरा छंद ॥",
      "sourceLineId": "87236",
      "sourceShabadId": "8083",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਹੁ ਬਰਖਨ ਲਉ ਰਾਮ ਜੀ ਰਾਜ ਕਰਾ ਅਰ ਟਾਲ ॥",
      "transliteration": "bahu barakhan lau raam jee raaj karaa ar Taal ||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਤਰ੍ਰਹਾ ਹੀ ਵੇਦ ਰੀਤ ਅਨੁਸਾਰ ਕੀਤੇ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "बहु बरखन लउ राम जी राज करा अर टाल ॥",
      "sourceLineId": "87237",
      "sourceShabadId": "8083",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬ੍ਰਹਮਰੰਧ੍ਰ ਕਹ ਫੋਰ ਕੈ ਭਯੋ ਕਉਸਲਿਆ ਕਾਲ ॥੮੪੧॥",
      "transliteration": "brahamara(n)dhr keh for kai bhayo kausaliaa kaal ||841||",
      "translation": "In this way, Ram ruled for a long time and on one day Kaushalya breathed her last on the bursting of her nerve Brahm-Randhra.841.",
      "punjabiViakhya": "ਜਿਸ ਘਰ ਵਿੱਚ ਰਾਮ ਵਰਗੇ ਸੁਪੱਤਰ ਪੈਦੇ ਹੋਏ ਹੋਣ,",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "ब्रहमरंध्र कह फोर कै भयो कउसलिआ काल ॥८४१॥",
      "sourceLineId": "87238",
      "sourceShabadId": "8083",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਕਿਸੇ ਤਰ੍ਰਹਾ ਦਾ ਕੋਈ ਤੋਟਾ ਨਹੀਂ ॥੮੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "87239",
      "sourceShabadId": "8084",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜੈਸ ਮ੍ਰਿਤਕ ਕੇ ਹੁਤੇ ਪ੍ਰਕਾਰਾ ॥",
      "transliteration": "jais mritak ke hute prakaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਸ੍ਰੀ ਰਾਮ ਨੇ) ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਮਾਤਾ ਦੀ ਸਦ-ਗਤਿ ਕੀਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "जैस मृतक के हुते प्रकारा ॥",
      "sourceLineId": "87240",
      "sourceShabadId": "8084",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤੈਸੇਈ ਕਰੇ ਬੇਦ ਅਨੁਸਾਰਾ ॥",
      "transliteration": "taiseiee kare bedh anusaaraa ||",
      "translation": "The ritual which is performed on the death of someone, the same was performed according to the Vedas",
      "punjabiViakhya": "ਤਦ ਤਕ ਕੈਕਈ ਦਾ ਸਰੀਰ ਵੀ ਸ਼ਾਤ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "तैसेई करे बेद अनुसारा ॥",
      "sourceLineId": "87241",
      "sourceShabadId": "8084",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰਾਮ ਸਪੂਤ ਜਾਹਿੰ ਘਰ ਮਾਹੀ ॥",
      "transliteration": "raam sapoot jaahi(n) ghar maahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਮਰਨ ਪਿਛੋਂ ਸੁਮਿਤ੍ਰਾ ਵੀ ਮਰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "राम सपूत जाहिं घर माही ॥",
      "sourceLineId": "87242",
      "sourceShabadId": "8084",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਾਕਹੁ ਤੋਟ ਕੋਊ ਕਹ ਨਾਹੀ ॥੮੪੨॥",
      "transliteration": "taakahu toT kouoo keh naahee ||842||",
      "translation": "The benign son Ram went to the home (and himself being an incarnation) he had no shortage of any type.842.",
      "punjabiViakhya": "ਵੇਖੋ ਕਾਲ ਨੇ ਕਿਸ ਤਰ੍ਰਹਾ ਦੀ ਕ੍ਰਿਆ ਕੀਤੀ ਹੈ ॥੮੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "ताकहु तोट कोऊ कह नाही ॥८४२॥",
      "sourceLineId": "87243",
      "sourceShabadId": "8084",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਗਤਿ ਕੀਨੀ ਪ੍ਰਭ ਮਾਤਾ ॥",
      "transliteration": "bahu bidh gat keenee prabh maataa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਸੀਤਾ ਨੇ ਇਸਤਰੀਆਂ ਦੇ ਸਿਖਾਏ,",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि गति कीनी प्रभ माता ॥",
      "sourceLineId": "87244",
      "sourceShabadId": "8084",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਬ ਲਉ ਭਈ ਕੈਕਈ ਸਾਤਾ ॥",
      "transliteration": "tab lau bhiee kaikiee saataa ||",
      "translation": "Many rituals were performed for the salvation of the mother and by that time Kaikeyi had also passed away.",
      "punjabiViakhya": "ਕੰਧ ਉਤੇ ਰਾਵਣ (ਦੀ ਸ਼ਕਲ) ਉਲੀਕ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "तब लउ भई कैकई साता ॥",
      "sourceLineId": "87245",
      "sourceShabadId": "8084",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਾ ਕੇ ਮਰਤ ਸੁਮਿਤ੍ਰਾ ਮਰੀ ॥",
      "transliteration": "taa ke marat sumitraa maree ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸ੍ਰੀ ਰਾਮ ਨੇ ਉਸ ਨੂੰ ਆ ਕੇ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "ता के मरत सुमित्रा मरी ॥",
      "sourceLineId": "87246",
      "sourceShabadId": "8084",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦੇਖਹੁ ਕਾਲ ਕ੍ਰਿਆ ਕਸ ਕਰੀ ॥੮੪੩॥",
      "transliteration": "dhekhahu kaal kriaa kas karee ||843||",
      "translation": "After her death, look at the doing of KAL (death). Sumitra also died.843.",
      "punjabiViakhya": "ਤਾ ਕੁਝ ਕ੍ਰੋਧ ਕਰਕੇ ਇਸ ਤਰ੍ਰਹਾ ਦੇ ਬਚਨ ਕਹੇ ॥੮੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "देखहु काल कृआ कस करी ॥८४३॥",
      "sourceLineId": "87247",
      "sourceShabadId": "8084",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਜਾਨਕਿ ਤ੍ਰਿਯ ਸਿਖਾ ॥",
      "transliteration": "ek dhivas jaanak tiray sikhaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਨੇ ਮਨ ਵਿੱਚ ਕਿਹਾ-",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "एक दिवस जानकि तृय सिखा ॥",
      "sourceLineId": "87248",
      "sourceShabadId": "8084",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭੀਤ ਭਏ ਰਾਵਣ ਕਹ ਲਿਖਾ ॥",
      "transliteration": "bheet bhe raavan keh likhaa ||",
      "translation": "One day explaining to women, Sita drew the portrait of Ravana on the wall,",
      "punjabiViakhya": "ਇਸ ਦਾ ਰਾਵਣ ਨਾਲ ਕੁਝ ਹਿੱਤ ਰਿਹਾ ਹੋਵੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "भीत भए रावण कह लिखा ॥",
      "sourceLineId": "87249",
      "sourceShabadId": "8084",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਬ ਰਘੁਬਰ ਤਿਹ ਆਨ ਨਿਹਾਰਾ ॥",
      "transliteration": "jab raghubar teh aan nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਉਸ ਦਾ ਚਿੱਤਰ ਉਲੀਕ ਕੇ ਵੇਖਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "जब रघुबर तिह आन निहारा ॥",
      "sourceLineId": "87250",
      "sourceShabadId": "8084",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਛੁਕ ਕੋਪ ਇਮ ਬਚਨ ਉਚਾਰਾ ॥੮੪੪॥",
      "transliteration": "kachhuk kop im bachan uchaaraa ||844||",
      "translation": "When Ram saw this, he said somewhat angrily.844.",
      "punjabiViakhya": "(ਇਸ) ਬਚਨ ਨੂੰ ਸੁਣਦਿਆਂ ਸੀਤਾ ਗੁੱਸੇ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "कछुक कोप इम बचन उचारा ॥८४४॥",
      "sourceLineId": "87251",
      "sourceShabadId": "8084",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਾਮ ਬਾਚ ਮਨ ਮੈ ॥",
      "transliteration": "raam baach man mai ||",
      "translation": "Speed of Ram in his mind :",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿਣ ਲੱਗੀ) ਹੇ ਸੁਆਮੀ ਜੀ! ਅਜੇ ਤਕ ਮੈਨੂੰ ਕਲੰਕ ਲਗਾਉਾਂਦੇ ਹੋ ॥੮੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "राम बाच मन मै ॥",
      "sourceLineId": "87252",
      "sourceShabadId": "8085",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਯਾ ਕੋ ਕਛੁ ਰਾਵਨ ਸੋ ਹੋਤਾ ॥",
      "transliteration": "yaa ko kachh raavan so hotaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "या को कछु रावन सो होता ॥",
      "sourceLineId": "87253",
      "sourceShabadId": "8085",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਾ ਤੇ ਚਿੱਤ੍ਰ ਚਿਤ੍ਰਕੈ ਦੇਖਾ ॥",
      "transliteration": "taa te chi'tr chitrakai dhekhaa ||",
      "translation": "She (Sita) must have had some love for Ravana, that is the reason why she is looking at his portrait drawn by her",
      "punjabiViakhya": "(ਸੀਤਾ ਨੇ ਕਿਹਾ-) ਜੇ ਬਾਣੀ ਅਤੇ ਕਰਮ ਕਰਕੇ ਮੇਰੇ ਹਿਰਦੇ ਵਿੱਚ ਸ੍ਰੀ ਰਾਮ ਵਸਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "ता ते चित्त्र चित्रकै देखा ॥",
      "sourceLineId": "87254",
      "sourceShabadId": "8085",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਚਨ ਸੁਨਤ ਸੀਤਾ ਭਈ ਰੋਖਾ ॥",
      "transliteration": "bachan sunat seetaa bhiee rokhaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਹੇ ਧਰਤੀ (ਮਾਤਾ! ਤੂੰ) ਮੈਨੂੰ ਰਸਤਾ ਦੇ ਅਤੇ ਮੈਨੂੰ ਸਮੇਟ ਲੈ ॥੮੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "बचन सुनत सीता भई रोखा ॥",
      "sourceLineId": "87255",
      "sourceShabadId": "8085",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪ੍ਰਭ ਮੁਹਿ ਅਜਹੂੰ ਲਗਾਵਤ ਦੋਖਾ ॥੮੪੫॥",
      "transliteration": "prabh muh ajahoo(n) lagaavat dhokhaa ||845||",
      "translation": "Sita became angry on hearing these words and said that even then Ram had been accusing her.845.",
      "punjabiViakhya": "ਚੌਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "प्रभ मुहि अजहूँ लगावत दोखा ॥८४५॥",
      "sourceLineId": "87256",
      "sourceShabadId": "8085",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "(ਸੀਤਾ ਦੇ) ਬਚਨ ਸੁਣਦਿਆਂ ਧਰਤੀ ਫਟ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "87257",
      "sourceShabadId": "8086",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਉ ਮੇਰੇ ਬਚ ਕਰਮ ਕਰਿ ਹ੍ਰਿਦੈ ਬਸਤ ਰਘੁਰਾਇ ॥",
      "transliteration": "jau mere bach karam kar hiradhai basat raghurai ||",
      "translation": "“If Ram the king Raghu clan abides ever in my heart, in my speech and action then,",
      "punjabiViakhya": "ਅਤੇ ਸੀਤਾ ਉਸ ਵਿੱਚ ਸਮਾ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "जउ मेरे बच करम करि हृदै बसत रघुराइ ॥",
      "sourceLineId": "87258",
      "sourceShabadId": "8086",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪ੍ਰਿਥੀ ਪੈਂਡ ਮੁਹਿ ਦੀਜੀਐ ਲੀਜੈ ਮੋਹਿ ਮਿਲਾਇ ॥੮੪੬॥",
      "transliteration": "pirathee pai(n)dd muh dheejeeaai leejai moh milai ||846||",
      "translation": "O mother earth! you give me some place and merge me in yourself.”846.",
      "punjabiViakhya": "(ਇਹ ਕੌਤਕ) ਵੇਖ ਕੇ ਸ੍ਰੀ ਰਾਮ ਹੈਰਾਨ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "पृथी पैंड मुहि दीजीऐ लीजै मोहि मिलाइ ॥८४६॥",
      "sourceLineId": "87259",
      "sourceShabadId": "8086",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ ਕਰਨ ਦੀ ਆਸ ਖ਼ਤਮ ਕਰ ਦਿੱਤੀ ॥੮੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "87260",
      "sourceShabadId": "8087",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੁਨਤ ਬਚਨ ਧਰਨੀ ਫਟ ਗਈ ॥",
      "transliteration": "sunat bachan dharanee faT giee ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "सुनत बचन धरनी फट गई ॥",
      "sourceLineId": "87261",
      "sourceShabadId": "8087",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਲੋਪ ਸੀਆ ਤਿਹ ਭੀਤਰ ਭਈ ॥",
      "transliteration": "lop seeaa teh bheetar bhiee ||",
      "translation": "Hearing these words the earth tore asunder and Sita merged in it",
      "punjabiViakhya": "ਇਹ ਜਗਤ ਧੂੰਏਾਂ ਦੇ ਮਹੱਲ ਵਰਗਾ ਹੈ, (ਦੱਸੋ) ਕਿਸ ਦੇ ਕੰਮ ਆਇਆ ਹੈ?",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "लोप सीआ तिह भीतर भई ॥",
      "sourceLineId": "87262",
      "sourceShabadId": "8087",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਚੱਕ੍ਰਤ ਰਹੇ ਨਿਰਖ ਰਘੁਰਾਈ ॥",
      "transliteration": "cha'krat rahe nirakh raghuraiee ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੀ ਰਾਮ ਤੋਂ ਬਿਨਾ ਸੀਤਾ ਨਹੀਂ ਜੀ ਸਕਦੀ ਅਤੇ ਸੀਤਾ ਤੋਂ ਬਿਨਾ ਰਾਮ ਨਹੀਂ ਜੀ ਸਕਣਗੇ ॥੮੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "चक्क्रत रहे निरख रघुराई ॥",
      "sourceLineId": "87263",
      "sourceShabadId": "8087",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਾਜ ਕਰਨ ਕੀ ਆਸ ਚੁਕਾਈ ॥੮੪੭॥",
      "transliteration": "raaj karan kee aas chukaiee ||847||",
      "translation": "Seeing this Ram wondered and in this suffering he ended all hope of ruling.847.",
      "punjabiViakhya": "ਚੌਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "राज करन की आस चुकाई ॥८४७॥",
      "sourceLineId": "87264",
      "sourceShabadId": "8087",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "(ਸ੍ਰੀ ਰਾਮ ਨੇ ਕਿਹਾ-) ਹੇ ਲੱਛਮਣ! ਤੂੰ ਦਰਵਾਜ਼ੇ ਉਤੇ ਬੈਠ,",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "87265",
      "sourceShabadId": "8088",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਇਹ ਜਗੁ ਧੂਅਰੋ ਧਉਲਹਰਿ ਕਿਹ ਕੇ ਆਯੋ ਕਾਮ ॥",
      "transliteration": "eeh jag dhooaro dhaulahar keh ke aayo kaam ||",
      "translation": "This world is the palace of smoke which had been of no value to anyone",
      "punjabiViakhya": "ਕੋਈ ਵੀ ਅੰਦਰ ਨਾ ਆਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "इह जगु धूअरो धउलहरि किह के आयो काम ॥",
      "sourceLineId": "87266",
      "sourceShabadId": "8088",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰਘੁਬਰ ਬਿਨੁ ਸੀਅ ਨਾ ਜੀਐ ਸੀਅ ਬਿਨ ਜੀਐ ਨ ਰਾਮ ॥੮੪੮॥",
      "transliteration": "raghubar bin seea naa jeeaai seea bin jeeaai na raam ||848||",
      "translation": "Sita could not live without Ram and it is impossible for Ram to remain alive without Sita.848.",
      "punjabiViakhya": "ਮਹੱਲ ਦੇ ਅੰਦਰ ਆਪ ਜੀ ਨੇ ਚਰਨ ਧਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "रघुबर बिनु सीअ ना जीऐ सीअ बिन जीऐ न राम ॥८४८॥",
      "sourceLineId": "87267",
      "sourceShabadId": "8088",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਅਤੇ ਦੇਹ ਨੂੰ ਸੰਸਾਰ ਵਿੱਚ ਛੱਡ ਕੇ (ਆਪ) 'ਮ੍ਰਿਤ ਲੋਕ' ਨੂੰ ਚਲੇ ਗਏ ॥੮੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "87268",
      "sourceShabadId": "8089",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦੁਆਰੇ ਕਹਯੋ ਬੈਠ ਲਛਮਨਾ ॥",
      "transliteration": "dhuaare kahayo baiTh lachhamanaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "दुआरे कहयो बैठ लछमना ॥",
      "sourceLineId": "87269",
      "sourceShabadId": "8089",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪੈਠ ਨ ਕੋਊ ਪਾਵੈ ਜਨਾ ॥",
      "transliteration": "paiTh na kouoo paavai janaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਰਾਜਾ ਅਜ ਨੇ ਇੰਦਰਮਤੀ ਲਈ ਘਰ ਨੂੰ ਛੱਡ ਕੇ ਯੋਗ ਧਾਰ ਲਿਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "पैठ न कोऊ पावै जना ॥",
      "sourceLineId": "87270",
      "sourceShabadId": "8089",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅੰਤਹਿ ਪੁਰਹਿ ਆਪ ਪਗੁ ਧਾਰਾ ॥",
      "transliteration": "a(n)teh pureh aap pag dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਤਰ੍ਰਹਾ ਸ੍ਰੀ ਰਾਮ ਨੇ ਵੀ ਸ੍ਰੀ ਸੀਤਾ ਦੇ ਵਿਯੋਗ ਵਿੱਚ ਸਰੀਰ ਨੂੰ ਤਿਆਗ ਦਿੱਤਾ ॥੮੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "अंतहि पुरहि आप पगु धारा ॥",
      "sourceLineId": "87271",
      "sourceShabadId": "8089",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੇਹਿ ਛੋਰਿ ਮ੍ਰਿਤ ਲੋਕ ਸਿਧਾਰਾ ॥੮੪੯॥",
      "transliteration": "dheh chhor mirat lok sidhaaraa ||849||",
      "translation": "Ram said to Lakshman, “You sit on the gate and do not let anyone to come in.” Ram himself went into the palace and abandoning his body left this abode of death.849.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਦੇ ਰਾਮਾਵਤਾਰ ਦੇ ਸੀਤਾ ਲਈ ਮ੍ਰਿਤ ਲੋਕ ਨੂੰ ਗਏ ਅਧਿਆਇ ਦੀ ਸਮਾਪਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "देहि छोरि मृत लोक सिधारा ॥८४९॥",
      "sourceLineId": "87272",
      "sourceShabadId": "8089",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਹੁਣ ਤਿੰਨਾ ਭਰਾਵਾ ਦਾ ਇਸਤਰੀਆਂ ਸਹਿਤ ਮਰਨ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "87273",
      "sourceShabadId": "8090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0288_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਇੰਦ੍ਰ ਮਤੀ ਹਿਤ ਅਜ ਨ੍ਰਿਪਤ ਜਿਮ ਗ੍ਰਿਹ ਤਜ ਲੀਅ ਜੋਗ ॥",
      "transliteration": "ei(n)dhr matee hit aj nirapat jim gireh taj leea jog ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": "इंद्र मती हित अज नृपत जिम गृह तज लीअ जोग ॥",
      "sourceLineId": "87274",
      "sourceShabadId": "8090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
