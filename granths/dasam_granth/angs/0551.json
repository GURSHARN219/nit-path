{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 551,
  "lineCount": 28,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0551_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਦਸਮ ਸਿਕੰਧ ਪੁਰਾਣੇ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਕ੍ਰਿਸਨਾਵਤਾਰੇ ਧਯਾਇ ਇਕੀਸਵੋ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥",
      "transliteration": "eit sree dhasam sika(n)dh puraane bachitr naaTak gra(n)the kirasanaavataare dhayai ikeesavo samaapatam sat subham sat ||",
      "translation": "End of the concluding auspicious chapter of Krishnavatara (based on Dasham Skandh Purana) in Bachittar Natak.21.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਦਸਮ ਸਕੰਧ ਪੁਰਾਣ, ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ ਕ੍ਰਿਸ਼ਨਾਵਤਾਰ ਅਧਿਆਇ ਇਕੀਸਵੇਾਂ ਦੀ ਸਮਾਪਤੀ। ਸਭ ਸ਼ੁਭ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "इति स्री दसम सिकंध पुराणे बचित्र नाटक ग्रंथे कृसनावतारे धयाइ इकीसवो समापतम सतु सुभम सतु ॥",
      "sourceLineId": "97999",
      "sourceShabadId": "9173",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚੌਬੀਸ ਅਵਤਾਰ ॥",
      "transliteration": "chauabees avataar ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਬੀਸ ਅਵਤਾਰ:",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "चौबीस अवतार ॥",
      "sourceLineId": "98000",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ੴ ਵਾਹਿਗੁਰੂ ਜੀ ਕੀ ਫਤਹਿ ॥",
      "transliteration": "ikOankaar vaahiguroo jee kee fateh ||",
      "translation": "The Lord is one and He can be attained through the Grace of the True Guru.",
      "punjabiViakhya": "ੴ ਸਤਿਗੁਰਪ੍ਰਸਾਦਿ:",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "ੴ वाहिगुरू जी की फतहि ॥",
      "sourceLineId": "98001",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਥ ਨਰ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "transliteration": "ath nar avataar kathana(n) ||",
      "translation": "Now beings the description of Nara incarnation",
      "punjabiViakhya": "ਹੁਣ ਨਰ ਅਵਤਾਰ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "अथ नर अवतार कथनं ॥",
      "sourceLineId": "98002",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "98003",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਬ ਬਾਈਸ੍ਵੋ ਗਨਿ ਅਵਤਾਰਾ ॥",
      "transliteration": "ab baieesavaio gan avataaraa ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਬਾਈਵੇਾਂ ਅਵਤਾਰ ਦਾ ਵਰਣਨ ਕਰਦਾ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "अब बाईस्वो गनि अवतारा ॥",
      "sourceLineId": "98004",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜੈਸ ਰੂਪ ਕਹੁ ਧਰੋ ਮੁਰਾਰਾ ॥",
      "transliteration": "jais roop kahu dharo muraaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਦਾ ਮੁਰਾਰੀ (ਕਾਲਪੁਰਖ) ਨੇ ਰੂਪ ਧਾਰਨ ਕੀਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "जैस रूप कहु धरो मुरारा ॥",
      "sourceLineId": "98005",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਰ ਅਵਤਾਰ ਭਯੋ ਅਰਜੁਨਾ ॥",
      "transliteration": "nar avataar bhayo arajunaa ||",
      "translation": "",
      "punjabiViakhya": "ਨਰ ਅਵਤਾਰ ਵਜੋਂ ਅਰਜਨ ਪ੍ਰਗਟ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "नर अवतार भयो अरजुना ॥",
      "sourceLineId": "98006",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਿਹ ਜੀਤੇ ਜਗ ਕੇ ਭਟ ਗਨਾ ॥੧॥",
      "transliteration": "jeh jeete jag ke bhaT ganaa ||1||",
      "translation": "Now I enumerate the twenty-second incarnation as to how he assumed this form. Arjuna became the Nara incarnation, who conquered the warriors of all the world.1.",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਜਗਤ ਦੇ ਬਹੁਤ ਸਾਰੇ ਸੂਰਵੀਰ ਜਿਤ ਲਏ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "जिह जीते जग के भट गना ॥१॥",
      "sourceLineId": "98007",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪ੍ਰਿਥਮ ਨਿਵਾਤ ਕਵਚ ਸਭ ਮਾਰੇ ॥",
      "transliteration": "piratham nivaat kavach sabh maare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸਭ ਤੋਂ ਪਹਿਲਾ ਨਿਵਾਤ ਕਵਚਾ (ਇੰਦਰ ਦੇ ਵਿਰੋਧੀ ਬਲਵਾਨਾ) ਨੂੰ ਮਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "पृथम निवात कवच सभ मारे ॥",
      "sourceLineId": "98008",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇੰਦ੍ਰ ਤਾਤ ਕੇ ਸੋਕ ਨਿਵਾਰੇ ॥",
      "transliteration": "ei(n)dhr taat ke sok nivaare ||",
      "translation": "In the first place, he by killeing all the warriors, weaing unfailing coat of mail, removed the anxiety of his father Indra",
      "punjabiViakhya": "ਅਤੇ (ਆਪਣੇ) ਪਿਤਾ ਇੰਦਰ ਦੇ ਦੁਖ ਖ਼ਤਮ ਕਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "इंद्र तात के सोक निवारे ॥",
      "sourceLineId": "98009",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਹੁਰੇ ਜੁਧ ਰੁਦ੍ਰ ਤਨ ਕੀਆ ॥",
      "transliteration": "bahure judh rudhr tan keeaa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਸ਼ਿਵ ਨਾਲ ਯੁੱਧ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "बहुरे जुध रुद्र तन कीआ ॥",
      "sourceLineId": "98010",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰੀਝੈ ਭੂਤਿ ਰਾਟ ਬਰੁ ਦੀਆ ॥੨॥",
      "transliteration": "reejhai bhoot raaT bar dheeaa ||2||",
      "translation": "Then he fought a battle with Rudra (Shiva), the king of ghosts, who bestowed a boon on him.2.",
      "punjabiViakhya": "ਅਤੇ ਭੂਤਰਾਜ (ਸ਼ਿਵ ਨੇ) ਪ੍ਰਸੰਨ ਹੋ ਕੇ ਵਰ ਦਿੱਤਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "रीझै भूति राट बरु दीआ ॥२॥",
      "sourceLineId": "98011",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਹੁਰਿ ਦੁਰਜੋਧਨ ਕਹ ਮੁਕਤਾਯੋ ॥",
      "transliteration": "bahur dhurajodhan keh mukataayo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਦੁਰਯੋਧਨ ਨੂੰ (ਬੰਧਨਾ ਤੋਂ) ਮੁਕਤ ਕਰਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "बहुरि दुरजोधन कह मुकतायो ॥",
      "sourceLineId": "98012",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੰਧ੍ਰਬ ਰਾਜ ਬਿਮੁਖ ਫਿਰਿ ਆਯੋ ॥",
      "transliteration": "ga(n)dhrab raaj bimukh fir aayo ||",
      "translation": "Then he redeemed Duryodhana and burnt the king of Gandharavas in the fire of the Khandav forest",
      "punjabiViakhya": "ਅਤੇ ਗੰਧਰਬ ਰਾਜਾ ਨੂੰ ਯੁੱਧ ਤੋਂ ਬੇਮੁਖ ਕਰਕੇ ਪਰਤਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "गंध्रब राज बिमुख फिरि आयो ॥",
      "sourceLineId": "98013",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਖਾਡਵ ਬਨ ਪਾਵਕਹਿ ਚਰਾਵਾ ॥",
      "transliteration": "khaaddav ban paavakeh charaavaa ||",
      "translation": "",
      "punjabiViakhya": "ਖਾਡਵ ਬਨ ਨੂੰ ਅਗਨੀ ਤੋਂ ਖਵਾਇਆ (ਅਰਥਾਤ ਸਾੜ ਦਿੱਤਾ)",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "खाडव बन पावकहि चरावा ॥",
      "sourceLineId": "98014",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬੂੰਦ ਏਕ ਪੈਠੈ ਨਹਿ ਪਾਵਾ ॥੩॥",
      "transliteration": "boo(n)dh ek paiThai neh paavaa ||3||",
      "translation": "All these could not comprehend his secret.3.",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਉਤੇ ਤੀਰਾ ਦਾ ਅਜਿਹਾ ਛਤ੍ਰ ਬਣਾਇਆ ਕਿ) ਪਾਣੀ ਦੀ ਇਕ ਬੂੰਦ ਵੀ ਪਹੁੰਚ ਨਹੀਂ ਸਕੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "बूँद एक पैठै नहि पावा ॥३॥",
      "sourceLineId": "98015",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਉ ਕਹਿ ਕਥਾ ਪ੍ਰਸੰਗ ਸੁਨਾਊ ॥",
      "transliteration": "jau keh kathaa prasa(n)g sunaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਇਸ ਕਥਾ ਦਾ (ਸਾਰਾ) ਪ੍ਰਸੰਗ ਸੁਣਾਵਾ",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "जउ कहि कथा प्रसंग सुनाऊ ॥",
      "sourceLineId": "98016",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗ੍ਰੰਥ ਬਢਨ ਤੇ ਹ੍ਰਿਦੈ ਡਰਾਊ ॥",
      "transliteration": "gra(n)th baddan te hiradhai ddaraauoo ||",
      "translation": "My mind fears the enlargement of this Granth (Book) by relating all these stories,",
      "punjabiViakhya": "ਤਾ ਗ੍ਰੰਥ ਦੇ ਬਹੁਤ ਵਧਣ ਕਰ ਕੇ ਹਿਰਦੇ ਵਿਚ ਡਰਦਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "ग्रंथ बढन ते हृदै डराऊ ॥",
      "sourceLineId": "98017",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਾ ਤੇ ਥੋਰੀ ਕਥਾ ਕਹਾਈ ॥",
      "transliteration": "taa te thoree kathaa kahaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਥੋੜੀ ਹੀ ਕਥਾ ਕਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "ता ते थोरी कथा कहाई ॥",
      "sourceLineId": "98018",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭੂਲ ਦੇਖਿ ਕਬਿ ਲੇਹੁ ਬਨਾਈ ॥੪॥",
      "transliteration": "bhool dhekh kab leh banaiee ||4||",
      "translation": "Therefore I have said it in brief and the poets will themselves improves my mistakes.4.",
      "punjabiViakhya": "(ਜਿਥੇ ਕਿਥੇ) ਭੁਲ ਵੇਖੋ, ਤਾ ਹੇ ਕਵੀ ਜਨੋਂ! ਉਸ ਨੂੰ ਸੋਧ ਲੈਣਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "भूल देखि कबि लेहु बनाई ॥४॥",
      "sourceLineId": "98019",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਊਰਵ ਜੀਤਿ ਗਾਵ ਸਬ ਆਨੀ ॥",
      "transliteration": "kuoorav jeet gaav sab aanee ||",
      "translation": "",
      "punjabiViakhya": "ਕੌਰਵਾ ਨੂੰ ਜਿਤ ਕੇ (ਉਨ੍ਰਹਾ ਤੋਂ) ਸਾਰੀਆਂ ਬਸਤੀਆਂ ਖੋਹ ਲਈਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "कऊरव जीति गाव सब आनी ॥",
      "sourceLineId": "98020",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਿਨ ਮਹਿ ਅਭਿਮਾਨੀ ॥",
      "transliteration": "bhaat bhaat tin meh abhimaanee ||",
      "translation": "He conquered all the places, where several proud Kauravas lived",
      "punjabiViakhya": "(ਜੋ) ਭਾਤ ਭਾਤ ਦੇ ਅਭਿਮਾਨੀ ਬਣੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तिन महि अभिमानी ॥",
      "sourceLineId": "98021",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕ੍ਰਿਸਨ ਚੰਦ ਕਹੁ ਬਹੁਰਿ ਰਿਝਾਯੋ ॥",
      "transliteration": "kirasan cha(n)dh kahu bahur rijhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਸ੍ਰੀ ਕ੍ਰਿਸ਼ਨ ਨੂੰ ਪ੍ਰਸੰਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "कृसन चंद कहु बहुरि रिझायो ॥",
      "sourceLineId": "98022",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਾ ਤੈ ਜੈਤਪਤ੍ਰ ਕਹੁ ਪਾਯੋ ॥੫॥",
      "transliteration": "jaa tai jaitapatr kahu paayo ||5||",
      "translation": "He pleased Krishna and obtained the certificate of victory from him.5.",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਤੋਂ ਜਿਤ ਦਾ ਪੱਤਰ ਪ੍ਰਾਪਤ ਕੀਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "जा तै जैतपत्र कहु पायो ॥५॥",
      "sourceLineId": "98023",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗਾਗੇਵਹਿ ਭਾਨੁਜ ਕਹੁ ਮਾਰ੍ਯੋ ॥",
      "transliteration": "gaageveh bhaanuj kahu maarayo ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਭੀਸ਼ਮ ('ਗਾਗੇਵ') ਅਤੇ ਕਰਨ ('ਭਾਨੁਜ') ਨੂੰ ਮਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "गागेवहि भानुज कहु मार्यो ॥",
      "sourceLineId": "98024",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਘੋਰ ਭਯਾਨ ਅਯੋਧਨ ਪਾਰ੍ਯੋ ॥",
      "transliteration": "ghor bhayaan ayodhan paarayo ||",
      "translation": "He killed Bhishma, the son of Ganga and Karan, the son of Surya after fighting a dreadful war with them",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਨਾਲ ਭਿਆਨਕ ਯੁੱਧ ਰਚਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "घोर भयान अयोधन पार्यो ॥",
      "sourceLineId": "98025",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0551_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੁਰਜੋਧਨ ਜੀਤਾ ਅਤਿ ਬਲਾ ॥",
      "transliteration": "dhurajodhan jeetaa at balaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤਿ ਬਲਵਾਨ ਯੋਧੇ ਦੁਰਯੋਧਨ ਨੂੰ ਜਿਤਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 551,
      "hindi": "",
      "hindiTransliteration": "दुरजोधन जीता अति बला ॥",
      "sourceLineId": "98026",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
