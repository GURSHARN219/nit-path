{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 552,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0552_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪਾਵਤ ਭਯੋ ਰਾਜ ਅਬਿਚਲਾ ॥੬॥",
      "transliteration": "paavat bhayo raaj abichalaa ||6||",
      "translation": "He conquered the mighty warrior Duryodhana and obtained the eternal kingdom.6.",
      "punjabiViakhya": "ਅਤੇ (ਭਾਰਤ ਵਰਸ਼ ਦਾ) ਸਥਾਈ ਰਾਜ ਪ੍ਰਾਪਤ ਕੀਤਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "पावत भयो राज अबिचला ॥६॥",
      "sourceLineId": "98027",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਹ ਲਗਿ ਕਰਤ ਕਥਾ ਕਹੁ ਜਾਊ ॥",
      "transliteration": "keh lag karat kathaa kahu jaauoo ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਕਥਾ ਨੂੰ ਕਿਥੋਂ ਤਕ ਕਹਿੰਦਾ ਜਾਵਾ",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "कह लगि करत कथा कहु जाऊ ॥",
      "sourceLineId": "98028",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗ੍ਰੰਥ ਬਢਨ ਤੇ ਅਧਿਕ ਡਰਾਊ ॥",
      "transliteration": "gra(n)th baddan te adhik ddaraauoo ||",
      "translation": "Upto which doing I should narrate this story, because I greatly fear the enlargement of this volume",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ) ਗ੍ਰੰਥ ਦੇ ਵੱਡੇ ਹੋ ਜਾਣ ਦਾ ਬਹੁਤ ਡਰ ਲਗਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "ग्रंथ बढन ते अधिक डराऊ ॥",
      "sourceLineId": "98029",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਥਾ ਬ੍ਰਿਧ ਕਸ ਕਰੌ ਬਿਚਾਰਾ ॥",
      "transliteration": "kathaa biradh kas karau bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਥਾ ਬਹੁਤ ਵੱਡੀ ਹੈ, ਕਿਥੋਂ ਤਕ ਵਿਚਾਰ ਕਰਾ।",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "कथा बृध कस करौ बिचारा ॥",
      "sourceLineId": "98030",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਾਈਸਵੋ ਅਰਜੁਨ ਅਵਤਾਰਾ ॥੭॥",
      "transliteration": "baieesavo arajun avataaraa ||7||",
      "translation": "What should I think of the long story? I say only this that Arjuna was the twenty-second incarnation.7.",
      "punjabiViakhya": "(ਬਸ) ਅਰਜਨ ਬਾਈਵਾ ਅਵਤਾਰ ਹੋਇਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "बाईसवो अरजुन अवतारा ॥७॥",
      "sourceLineId": "98031",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਨਰ ਅਵਤਾਰ ਬਾਈਸਵੋ ਸੰਪੂਰਣੰ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੨॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the nar avataar baieesavo sa(n)poorana(n) sat subham sat ||22||",
      "translation": "Here ends the description of Nara Incarnation in Bachittar Natak.22.",
      "punjabiViakhya": "ਇਥੇ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦਾ ਨਰ ਅਵਤਾਰ ਬਾਈਸਵਾ ਸਮਾਪਤ ਹੋਇਆ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे नर अवतार बाईसवो संपूरणं सतु सुभम सतु ॥२२॥",
      "sourceLineId": "98032",
      "sourceShabadId": "9174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਥ ਬਊਧ ਅਵਤਾਰ ਤੇਈਸਵੌ ਕਥਨੰ ॥",
      "transliteration": "ath buoodh avataar teieesavau kathana(n) ||",
      "translation": "Now begins the description of the twenty-third Buddha incarnation",
      "punjabiViakhya": "ਹੁਣ ਤੇਈਵੇਾਂ ਬੁੱਧ ਅਵਤਾਰ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "अथ बऊध अवतार तेईसवौ कथनं ॥",
      "sourceLineId": "98033",
      "sourceShabadId": "9175",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "98034",
      "sourceShabadId": "9175",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਬ ਮੈ ਗਨੋ ਬਊਧ ਅਵਤਾਰਾ ॥",
      "transliteration": "ab mai gano buoodh avataaraa ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੈਂ ਬੁੱਧ ਅਵਤਾਰ ਦਾ ਵਰਣਨ ਕਰਦਾ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "अब मै गनो बऊध अवतारा ॥",
      "sourceLineId": "98035",
      "sourceShabadId": "9175",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜੈਸ ਰੂਪ ਕਹੁ ਧਰਾ ਮੁਰਾਰਾ ॥",
      "transliteration": "jais roop kahu dharaa muraaraa ||",
      "translation": "Now I describe the Buddha incarnation as to how the Lord assumed this form",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਮੁਰਾਰੀ (ਕਾਲ ਪੁਰਖ) ਨੇ ਉਹ ਰੂਪ ਧਾਰਨ ਕੀਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "जैस रूप कहु धरा मुरारा ॥",
      "sourceLineId": "98036",
      "sourceShabadId": "9175",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਊਧ ਅਵਤਾਰ ਇਹੀ ਕੋ ਨਾਊ ॥",
      "transliteration": "buoodh avataar ihee ko naauoo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹੀ ਬੁੱਧ ਅਵਤਾਰ ਦਾ ਨਾ ਸਮਝਣਾ ਚਾਹੀਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "बऊध अवतार इही को नाऊ ॥",
      "sourceLineId": "98037",
      "sourceShabadId": "9175",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਾਕਰ ਨਾਵ ਨ ਥਾਵ ਨ ਗਾਊ ॥੧॥",
      "transliteration": "jaakar naav na thaav na gaauoo ||1||",
      "translation": "Buddha incarnation is the name of that one, who has no name, no place and no villate.1.",
      "punjabiViakhya": "ਜਿਸ ਦਾ (ਕੋਈ) ਨਾ, ਥਾ ਜਾ ਪਿੰਡ ਨਹੀਂ ਹੈ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "जाकर नाव न थाव न गाऊ ॥१॥",
      "sourceLineId": "98038",
      "sourceShabadId": "9175",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਾਕਰ ਨਾਵ ਨ ਠਾਵ ਬਖਾਨਾ ॥",
      "transliteration": "jaakar naav na Thaav bakhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਕੋਈ ਨਾ ਜਾ ਠਿਕਾਣਾ ਨਹੀਂ ਦਸਿਆ ਜਾ ਸਕਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "जाकर नाव न ठाव बखाना ॥",
      "sourceLineId": "98039",
      "sourceShabadId": "9175",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਊਧ ਅਵਤਾਰ ਵਹੀ ਪਹਚਾਨਾ ॥",
      "transliteration": "buoodh avataar vahee pahachaanaa ||",
      "translation": "He, whose name and place are not described, he is only known as the Buddha incarnation",
      "punjabiViakhya": "ਉਸੇ ਨੂੰ ਬੁੱਧ ਅਵਤਾਰ ਸਮਝਣਾ ਚਾਹੀਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "बऊध अवतार वही पहचाना ॥",
      "sourceLineId": "98040",
      "sourceShabadId": "9175",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਿਲਾ ਸਰੂਪ ਰੂਪ ਤਿਹ ਜਾਨਾ ॥",
      "transliteration": "silaa saroop roop teh jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਸਰੂਪ ਪੱਥਰ ਰੂਪ (ਭਾਵ ਮੂਰਤੀ) ਜਾਣਨਾ ਚਾਹੀਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "सिला सरूप रूप तिह जाना ॥",
      "sourceLineId": "98041",
      "sourceShabadId": "9175",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਥਾ ਨ ਜਾਹਿ ਕਲੂ ਮਹਿ ਮਾਨਾ ॥੨॥",
      "transliteration": "kathaa na jaeh kaloo meh maanaa ||2||",
      "translation": "No one has accepted his sayings in the Iron Age, who visualizes the beauty only in stone (idols).2.",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਕਥਾ ਨੂੰ ਕਲਿਯੁਗ ਵਿਚ ਕਿਸੇ ਨਹੀਂ ਮੰਨਿਆ ਹੈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "कथा न जाहि कलू महि माना ॥२॥",
      "sourceLineId": "98042",
      "sourceShabadId": "9175",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "98043",
      "sourceShabadId": "9176",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰੂਪ ਰੇਖ ਜਾਕਰ ਨ ਕਛੁ ਅਰੁ ਕਛੁ ਨਹਿਨ ਆਕਾਰ ॥",
      "transliteration": "roop rekh jaakar na kachh ar kachh nahin aakaar ||",
      "translation": "Neither he is beautiful nor he does any work",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਕੁਝ ਰੂਪ-ਰੇਖਾ ਨਹੀਂ ਹੈ ਅਤੇ ਕੋਈ ਆਕਾਰ ਵੀ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "रूप रेख जाकर न कछु अरु कछु नहिन आकार ॥",
      "sourceLineId": "98044",
      "sourceShabadId": "9176",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਿਲਾ ਰੂਪ ਬਰਤਤ ਜਗਤ ਸੋ ਬਊਧ ਅਵਤਾਰ ॥੩॥",
      "transliteration": "silaa roop baratat jagat so buoodh avataar ||3||",
      "translation": "He considers the whole world like stone and calls himself the Buddha incarnation.3.",
      "punjabiViakhya": "ਜਗਤ ਵਿਚ (ਜੋ) ਸਿਲਾ ਰੂਪ ਵਰਤ ਰਿਹਾ ਹੈ, ਉਹ ਬੌਧ ਅਵਤਾਰ ਹੈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "सिला रूप बरतत जगत सो बऊध अवतार ॥३॥",
      "sourceLineId": "98045",
      "sourceShabadId": "9176",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਬਊਧ ਅਵਤਾਰ ਤੇਈਸਵੋ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੩॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the buoodh avataar teieesavo samaapatam sat subham sat ||23||",
      "translation": "Here ends the description of Buddha Incarnation in Bachittar Natak.23.",
      "punjabiViakhya": "ਇਥੇ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ ਬੌਧ ਅਵਤਾਰ ਤੇਈਵੇਾਂ ਦੀ ਸਮਾਪਤੀ ਹੈ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे बऊध अवतार तेईसवो समापतम सतु सुभम सतु ॥२३॥",
      "sourceLineId": "98046",
      "sourceShabadId": "9176",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਥ ਨਿਹਕਲੰਕੀ ਚੌਬੀਸਵੌ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "transliteration": "ath nihakala(n)kee chauabeesavau avataar kathana(n) ||",
      "translation": "Now begins the description of Nihkalanki, the twenty-fourth incarnation",
      "punjabiViakhya": "ਹੁਣ ਨਿਹਕਲੰਕੀ ਚੌਬੀਸਵੇਾਂ ਅਵਤਾਰ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "अथ निहकलंकी चौबीसवौ अवतार कथनं ॥",
      "sourceLineId": "98047",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "98048",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਬ ਮੈ ਮਹਾ ਸੁਧ ਮਤਿ ਕਰਿ ਕੈ ॥",
      "transliteration": "ab mai mahaa sudh mat kar kai ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੈਂ ਬੁੱਧੀ ਨੂੰ ਬਹੁਤ ਚੰਗੀ ਤਰ੍ਰਹਾ ਸ਼ੁੱਧ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "अब मै महा सुध मति करि कै ॥",
      "sourceLineId": "98049",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਹੋ ਕਥਾ ਚਿਤੁ ਲਾਇ ਬਿਚਰਿ ਕੈ ॥",
      "transliteration": "kaho kathaa chit lai bichar kai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਿਤ ਲਗਾ ਕੇ ਵਿਚਾਰ ਪੂਰਵਕ ਕਥਾ ਕਹਿੰਦਾ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "कहो कथा चितु लाइ बिचरि कै ॥",
      "sourceLineId": "98050",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚਉਬੀਸਵੋ ਕਲਕੀ ਅਵਤਾਰਾ ॥",
      "transliteration": "chaubeesavo kalakee avataaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ (ਵਿਸ਼ਣੂ ਦਾ) ਚੌਬੀਸਵਾ ਅਵਤਾਰ ਕਲਕੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "चउबीसवो कलकी अवतारा ॥",
      "sourceLineId": "98051",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਾ ਕਰ ਕਹੋ ਪ੍ਰਸੰਗ ਸੁਧਾਰਾ ॥੧॥",
      "transliteration": "taa kar kaho prasa(n)g sudhaaraa ||1||",
      "translation": "Now, I purging my intellect, relate the story with full concentration of Kalki, the twenty –fourth incarnation and describe his episode, while emending it.1.",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦਾ ਪ੍ਰਸੰਗ ਸੰਵਾਰ ਕੇ ਕਹਿੰਦਾ ਹਾ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "ता कर कहो प्रसंग सुधारा ॥१॥",
      "sourceLineId": "98052",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਭਾਰਾਕ੍ਰਿਤ ਹੋਤ ਜਬ ਧਰਣੀ ॥",
      "transliteration": "bhaaraakirat hot jab dharanee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਧਰਤੀ, (ਪਾਪਾ ਦੇ) ਭਾਰ ਨਾਲ ਦੁਖੀ ਹੋ ਜਾਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "भाराकृत होत जब धरणी ॥",
      "sourceLineId": "98053",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪਾਪ ਗ੍ਰਸਤ ਕਛੁ ਜਾਤ ਨ ਬਰਣੀ ॥",
      "transliteration": "paap grasat kachh jaat na baranee ||",
      "translation": "When the earth is pressed downward by the weight of sin and her suffering becomes indescribeable",
      "punjabiViakhya": "ਤਾ ਉਸ ਪਾਪਾ ਨਾਲ ਗ੍ਰਸੀ ਦਾ ਕੁਝ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "पाप ग्रसत कछु जात न बरणी ॥",
      "sourceLineId": "98054",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਹੋਤ ਉਤਪਾਤਾ ॥",
      "transliteration": "bhaat bhaat tan hot utapaataa ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦੇ ਉਪਦ੍ਰਵ ਜਾ ਖ਼ਰਾਬੀਆਂ ਹੁੰਦੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन होत उतपाता ॥",
      "sourceLineId": "98055",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪੁਤ੍ਰਹਿ ਸੇਜਿ ਸੋਵਤ ਲੈ ਮਾਤਾ ॥੨॥",
      "transliteration": "putreh sej sovat lai maataa ||2||",
      "translation": "Several types of crimes are committed and the mother sleeps for the sexual enjoyment with her son in the same bed.2.",
      "punjabiViakhya": "ਅਤੇ ਮਾ ਪੁੱਤਰ ਨੂੰ ਲੈ ਕੇ ਸੇਜ-ਸੁਖ ਮਾਣਦੀ ਹੈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "पुत्रहि सेजि सोवत लै माता ॥२॥",
      "sourceLineId": "98056",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੁਤਾ ਪਿਤਾ ਤਨ ਰਮਤ ਨਿਸੰਕਾ ॥",
      "transliteration": "sutaa pitaa tan ramat nisa(n)kaa ||",
      "translation": "",
      "punjabiViakhya": "ਪੁੱਤਰੀ ਪਿਤਾ ਨਾਲ ਨਿਰਸੰਕੋਚ ਰਮਣ ਕਰਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "सुता पिता तन रमत निसंका ॥",
      "sourceLineId": "98057",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਗਨੀ ਭਰਤ ਭ੍ਰਾਤ ਕਹੁ ਅੰਕਾ ॥",
      "transliteration": "bhaganee bharat bhraat kahu a(n)kaa ||",
      "translation": "The daughter unhesitatingly enjoys with her father and the sister embraces her brother",
      "punjabiViakhya": "ਅਤੇ ਭੈਣ ਭਰਾ ਨੂੰ ਜਫੀ ਪਾਉਾਂਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "भगनी भरत भ्रात कहु अंका ॥",
      "sourceLineId": "98058",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭ੍ਰਾਤ ਬਹਨ ਤਨ ਕਰਤ ਬਿਹਾਰਾ ॥",
      "transliteration": "bhraat bahan tan karat bihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਭਰਾ ਭੈਣ ਨਾਲ ਕਾਮ-ਕਰਮ ਕਰਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "भ्रात बहन तन करत बिहारा ॥",
      "sourceLineId": "98059",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਇਸਤ੍ਰੀ ਤਜੀ ਸਕਲ ਸੰਸਾਰਾ ॥੩॥",
      "transliteration": "eisatree tajee sakal sa(n)saaraa ||3||",
      "translation": "The brighter enjoys the body of the sister and the whole world relinquishes the wife/3.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਸੰਸਾਰ ਨੇ (ਵਿਆਹੀ ਹੋਈ) ਇਸਤਰੀ ਨੂੰ ਤਿਆਗ ਦਿੱਤਾ ਹੈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "इसत्री तजी सकल संसारा ॥३॥",
      "sourceLineId": "98060",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੰਕਰ ਬਰਣ ਪ੍ਰਜਾ ਸਭ ਹੋਈ ॥",
      "transliteration": "sa(n)kar baran prajaa sabh hoiee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਪ੍ਰਜਾ ਵਰਣ-ਸੰਕਰ (ਮਿਸ਼ਰਿਤ) ਹੋ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "संकर बरण प्रजा सभ होई ॥",
      "sourceLineId": "98061",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਏਕ ਗ੍ਰਯਾਤ ਕੋ ਰਹਾ ਨ ਕੋਈ ॥",
      "transliteration": "ek grayaat ko rahaa na koiee ||",
      "translation": "The whole subjects become hybrid and no one knows the other",
      "punjabiViakhya": "ਇਕ (ਜਾਤਿ ਦੀ) ਪਛਾਣ ਵਾਲਾ ਕੋਈ ਨਹੀਂ ਰਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "एक ग्रयात को रहा न कोई ॥",
      "sourceLineId": "98062",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਤਿ ਬਿਭਚਾਰ ਫਸੀ ਬਰ ਨਾਰੀ ॥",
      "transliteration": "at bibhachaar fasee bar naaree ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੇਸ਼ਠ (ਘਰਾ ਦੀਆਂ) ਇਸਤਰੀਆਂ ਬਹੁਤ ਵਿਭਚਾਰ ਵਿਚ ਫਸ ਗਈਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "अति बिभचार फसी बर नारी ॥",
      "sourceLineId": "98063",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਧਰਮ ਰੀਤ ਕੀ ਪ੍ਰੀਤਿ ਬਿਸਾਰੀ ॥੪॥",
      "transliteration": "dharam reet kee preet bisaaree ||4||",
      "translation": "The beautiful women are engrossed in adultery and forget the real love and the traditions of religion.4.",
      "punjabiViakhya": "ਅਤੇ ਧਰਮ ਆਧਾਰਿਤ ਪ੍ਰੀਤ ਦੀ ਰੀਤ ਭੁਲਾ ਦਿੱਤੀ ਹੈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "धरम रीत की प्रीति बिसारी ॥४॥",
      "sourceLineId": "98064",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਘਰਿ ਘਰਿ ਝੂਠ ਅਮਸਿਆ ਭਈ ॥",
      "transliteration": "ghar ghar jhooTh amasiaa bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਘਰ ਘਰ ਵਿਚ ਕੂੜ ਦੀ ਮਸਿਆ ਪਸਰੀ ਹੋਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "घरि घरि झूठ अमसिआ भई ॥",
      "sourceLineId": "98065",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਾਚ ਕਲਾ ਸਸਿ ਕੀ ਦੁਰ ਗਈ ॥",
      "transliteration": "saach kalaa sas kee dhur giee ||",
      "translation": "In every home, in the dark night of falsehood, the phases of the moon of truth are hidden",
      "punjabiViakhya": "ਅਤੇ ਸੱਚ ਰੂਪ ਚੰਦ੍ਰਮਾ ਦੀ ਕਲਾ ਲੁਕ ਛਿਪ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "साच कला ससि की दुर गई ॥",
      "sourceLineId": "98066",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਹ ਤਹ ਹੋਨ ਲਗੇ ਉਤਪਾਤਾ ॥",
      "transliteration": "jeh teh hon lage utapaataa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਉਪਦ੍ਰਵ ਹੋਣ ਲਗੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "जह तह होन लगे उतपाता ॥",
      "sourceLineId": "98067",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭੋਗਤ ਪੂਤ ਸੇਜਿ ਚੜਿ ਮਾਤਾ ॥੫॥",
      "transliteration": "bhogat poot sej chaR maataa ||5||",
      "translation": "The crimes are committed everywhere and the son comes to the bed of his mother and enjoys her.5.",
      "punjabiViakhya": "ਅਤੇ ਪੁੱਤਰ ਮਾਤਾ ਨਾਲ ਸੇਜ-ਸੁਖ ਮਾਣਨ ਲਗਾ ਹੈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "भोगत पूत सेजि चड़ि माता ॥५॥",
      "sourceLineId": "98068",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਢੂੰਢਤ ਸਾਚ ਨ ਕਤਹੂੰ ਪਾਯਾ ॥",
      "transliteration": "ddoo(n)ddat saach na katahoo(n) paayaa ||",
      "translation": "",
      "punjabiViakhya": "ਢੂੰਢਣ ਤੇ ਵੀ ਕਿਤੋਂ ਸੱਚ ਨਹੀਂ ਮਿਲਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "ढूँढत साच न कतहूँ पाया ॥",
      "sourceLineId": "98069",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਝੂਠ ਹੀ ਸੰਗ ਸਬੋ ਚਿਤ ਲਾਯਾ ॥",
      "transliteration": "jhooTh hee sa(n)g sabo chit laayaa ||",
      "translation": "The truth is not seen even on search and the mind of everyone is absorbed in falsehood",
      "punjabiViakhya": "ਅਤੇ ਸਭ ਨੇ (ਆਪਣਾ) ਚਿਤ ਝੂਠ ਵਿਚ ਹੀ ਲਗਾਇਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "झूठ ही संग सबो चित लाया ॥",
      "sourceLineId": "98070",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭਿੰਨ ਭਿੰਨ ਗ੍ਰਿਹ ਗ੍ਰਿਹ ਮਤ ਹੋਈ ॥",
      "transliteration": "bhi(n)n bhi(n)n gireh gireh mat hoiee ||",
      "translation": "",
      "punjabiViakhya": "(ਅਜਿਹੀ ਹਾਲਤ ਵਿਚ) ਘਰ ਘਰ ਵਿਚ ਵਖੋ ਵਖਰੇ ਮਤ ਹੋ ਜਾਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "भिंन भिंन गृह गृह मत होई ॥",
      "sourceLineId": "98071",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਾਸਤ੍ਰ ਸਿਮ੍ਰਿਤ ਛੁਐ ਨ ਕੋਈ ॥੬॥",
      "transliteration": "saasatr simirat chhuaai na koiee ||6||",
      "translation": "In every home, there Shastras and Smritis.6.",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਾਸਤ੍ਰ ਤੇ ਸਮ੍ਰਿਤੀਆਂ ਨੂੰ ਕੋਈ ਛੋਹੇਗਾ ਵੀ ਨਹੀਂ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
      "hindiTransliteration": "सासत्र सिमृत छुऐ न कोई ॥६॥",
      "sourceLineId": "98072",
      "sourceShabadId": "9177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0552_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਿੰਦਵ ਕੋਈ ਨ ਤੁਰਕਾ ਰਹਿ ਹੈ ॥",
      "transliteration": "hi(n)dhav koiee na turakaa reh hai ||",
      "translation": "",
      "punjabiViakhya": "(ਸੱਚਾ) ਹਿੰਦੂ ਅਤੇ ਮੁਸਲਮਾਨ ਕੋਈ ਵੀ ਨਹੀਂ ਰਹੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 552,
      "hindi": "",
