{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 556,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0556_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨ ਪ੍ਰੀਤਿ ਮਾਤ ਸੰਗਾ ॥",
      "transliteration": "n preet maat sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਤਾ ਨਾਲ ਪ੍ਰੀਤ ਨਹੀਂ ਹੋਵੇਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "न प्रीति मात संगा ॥",
      "sourceLineId": "98195",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਧੀਨ ਅਰਧੰਗਾ ॥੪੦॥",
      "transliteration": "adheen aradha(n)gaa ||40||",
      "translation": "They will have no affection for their mother and the people will become subservient to their wives.40.",
      "punjabiViakhya": "ਪਤਨੀ ਦੇ ਅਧੀਨ ਹੋਣਗੇ ॥੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "अधीन अरधंगा ॥४०॥",
      "sourceLineId": "98196",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਭੱਛ ਭੱਛ ਭਛੈ ॥",
      "transliteration": "abha'chh bha'chh bhachhai ||",
      "translation": "",
      "punjabiViakhya": "ਨ ਖਾਣ ਯੋਗ ਵਸਤੂਆਂ ਨੂੰ ਖਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "अभच्छ भच्छ भछै ॥",
      "sourceLineId": "98197",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਕੱਛ ਕਾਛ ਕੱਛੈ ॥",
      "transliteration": "aka'chh kaachh ka'chhai ||",
      "translation": "The uneatable will be eaten and people will visit the unworthy places",
      "punjabiViakhya": "ਨਾ ਫਿਰਨ ਵਾਲੇ ਸਥਾਨਾ ਉਤੇ ਫਿਰਨਗੇ (ਅਰਥਾਤਰ-ਨ ਧਾਰਨ ਕਰਨ ਯੋਗ ਰੂਪ ਧਾਰਨ ਕਰਨਗੇ)।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "अकच्छ काछ कच्छै ॥",
      "sourceLineId": "98198",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਭਾਖ ਬੈਨ ਭਾਖੈ ॥",
      "transliteration": "abhaakh bain bhaakhai ||",
      "translation": "",
      "punjabiViakhya": "ਨਾ ਬੋਲਣ ਯੋਗ ਬੋਲ ਬੋਲਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "अभाख बैन भाखै ॥",
      "sourceLineId": "98199",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਿਸੂ ਨ ਕਾਣਿ ਰਾਖੈ ॥੪੧॥",
      "transliteration": "kisoo na kaan raakhai ||41||",
      "translation": "The people will utter the unutterable words and will not care for anybody.41.",
      "punjabiViakhya": "ਕਿਸੇ ਦੀ ਪਰਵਾਹ ਨਹੀਂ ਕਰਨਗੇ ॥੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "किसू न काणि राखै ॥४१॥",
      "sourceLineId": "98200",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਧਰਮ ਕਰਮ ਕਰ ਹੈ ॥",
      "transliteration": "adharam karam kar hai ||",
      "translation": "",
      "punjabiViakhya": "ਅਧਰਮ ਦੇ ਕਰਮ ਕਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "अधरम करम कर है ॥",
      "sourceLineId": "98201",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨ ਤਾਤ ਮਾਤ ਡਰਿ ਹੈ ॥",
      "transliteration": "n taat maat ddar hai ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਤਾ ਮਾਤਾ ਤੋਂ ਨਹੀਂ ਡਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "न तात मात डरि है ॥",
      "sourceLineId": "98202",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕੁਮੰਤ੍ਰ ਮੰਤ੍ਰ ਕੈ ਹੈ ॥",
      "transliteration": "kuma(n)tr ma(n)tr kai hai ||",
      "translation": "",
      "punjabiViakhya": "ਮਾੜੇ ਸਲਾਹਕਾਰਾ ਨਾਲ ਸਾਲਾਹ ਕਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "कुमंत्र मंत्र कै है ॥",
      "sourceLineId": "98203",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੁਮੰਤ੍ਰ ਕੋ ਨ ਲੈ ਹੈ ॥੪੨॥",
      "transliteration": "suma(n)tr ko na lai hai ||42||",
      "translation": "They will peroform unrighteous acts and will not have any advice and will not seek good advice.42.",
      "punjabiViakhya": "ਚੰਗੀ ਸਲਾਹ ਨੂੰ ਗ੍ਰਹਿਣ ਨਹੀਂ ਕਰਨਗੇ ॥੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "सुमंत्र को न लै है ॥४२॥",
      "sourceLineId": "98204",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਧਰਮ ਕਰਮ ਕੈ ਹੈ ॥",
      "transliteration": "adharam karam kai hai ||",
      "translation": "",
      "punjabiViakhya": "ਅਧਰਮ ਵਾਲਾ ਕਰਮ ਕਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "अधरम करम कै है ॥",
      "sourceLineId": "98205",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੁ ਭਰਮ ਧਰਮ ਖੁਐ ਹੈ ॥",
      "transliteration": "s bharam dharam khuaai hai ||",
      "translation": "They will perform acts of unrighteousness and will lose their dharma in illusions",
      "punjabiViakhya": "ਚੰਗੇ ਧਰਮ ਨੂੰ ਭਰਮਾ ਵਿਚ ਗੰਵਾ ਦੇਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "सु भरम धरम खुऐ है ॥",
      "sourceLineId": "98206",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੁ ਕਾਲ ਫਾਸਿ ਫਸ ਹੈ ॥",
      "transliteration": "s kaal faas fas hai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਕਾਲ ਦੀ ਫਾਹੀ ਵਿਚ ਫਸ ਜਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "सु काल फासि फस है ॥",
      "sourceLineId": "98207",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਿਦਾਨ ਨਰਕ ਬਸਿ ਹੈ ॥੪੩॥",
      "transliteration": "nidhaan narak bas hai ||43||",
      "translation": "Thy will be entrapped in the noose of Yama and untimately reside in hell.43.",
      "punjabiViakhya": "ਅੰਤ ਵਿਚ ਨਰਕ ਵਿਚ ਵਾਸਾ ਕਰਨਗੇ ॥੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "निदान नरक बसि है ॥४३॥",
      "sourceLineId": "98208",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕੁਕਰਮ ਕਰਮ ਲਾਗੇ ॥",
      "transliteration": "kukaram karam laage ||",
      "translation": "",
      "punjabiViakhya": "ਭੈੜੇ ਕੰਮ ਕਰਨ ਵਿਚ ਲਗਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "कुकरम करम लागे ॥",
      "sourceLineId": "98209",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੁਧਰਮ ਛਾਡਿ ਭਾਗੇ ॥",
      "transliteration": "sudharam chhaadd bhaage ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਗੇ ਧਰਮ ਨੂੰ ਛਡ ਕੇ ਭਜ ਜਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "सुधरम छाडि भागे ॥",
      "sourceLineId": "98210",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਮਾਤ ਨਿੱਤ ਪਾਪੰ ॥",
      "transliteration": "kamaat ni't paapa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨਿੱਤ ਪਾਪ ਕਮਾਉਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "कमात नित्त पापं ॥",
      "sourceLineId": "98211",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਿਸਾਰਿ ਸਰਬ ਜਾਪੰ ॥੪੪॥",
      "transliteration": "bisaar sarab jaapa(n) ||44||",
      "translation": "The people being engrossed in misconduct will abandon disciplines and engross themselves in sinful actions.44.",
      "punjabiViakhya": "ਸਾਰੇ ਜਾਪਾ ਨੂੰ ਭੁਲਾ ਦੇਣਗੇ ॥੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "बिसारि सरब जापं ॥४४॥",
      "sourceLineId": "98212",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੁ ਮੱਦ ਮੋਹ ਮੱਤੇ ॥",
      "transliteration": "s ma'dh moh ma'te ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਹੰਕਾਰ ਅਤੇ ਮੋਹ ਵਿਚ ਮਸਤ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "सु मद्द मोह मत्ते ॥",
      "sourceLineId": "98213",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੁ ਕਰਮ ਕੇ ਕੁਪੱਤੇ ॥",
      "transliteration": "s karam ke kupa'te ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਗੇ ਕਰਮ (ਕਰਨ ਵਿਚ) ਨਿਖਿਧ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "सु करम के कुपत्ते ॥",
      "sourceLineId": "98214",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੁ ਕਾਮ ਕ੍ਰੋਧ ਰਾਚੇ ॥",
      "transliteration": "s kaam krodh raache ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਕਾਮ ਕ੍ਰੋਧ ਵਿਚ ਮਗਨ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "सु काम क्रोध राचे ॥",
      "sourceLineId": "98215",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਉਤਾਰਿ ਲਾਜ ਨਾਚੇ ॥੪੫॥",
      "transliteration": "autaar laaj naache ||45||",
      "translation": "The people intoxicated with wine and attachment will perform uncivilised acts and being absorbed in lust and anger, they will dance unashamedly.45.",
      "punjabiViakhya": "ਲਾਜ-ਮਰਯਾਦਾ ਨੂੰ ਤਿਆਗ ਕੇ ਨਚਣਗੇ ॥੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "उतारि लाज नाचे ॥४५॥",
      "sourceLineId": "98216",
      "sourceShabadId": "9183",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਗ ਸਰੂਪੀ ਛੰਦ ॥",
      "transliteration": "nag saroopee chha(n)dh ||",
      "translation": "NAG SAROOPI STANZA",
      "punjabiViakhya": "ਨਗ ਸਰੂਪੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "नग सरूपी छंद ॥",
      "sourceLineId": "98217",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨ ਧਰਮ ਕਰਮ ਕਉ ਕਰੈ ॥",
      "transliteration": "n dharam karam kau karai ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਮ ਦੇ ਕਰਮ ਨੂੰ ਨਹੀਂ ਕਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "न धरम करम कउ करै ॥",
      "sourceLineId": "98218",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬ੍ਰਿਥਾ ਕਥਾ ਸੁਨੈ ਰਰੈ ॥",
      "transliteration": "birathaa kathaa sunai rarai ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਅਰਥ ਦੀ ਕਥਾ ਸੁਣਨ ਅਤੇ ਪੜ੍ਰਹਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "बृथा कथा सुनै ररै ॥",
      "sourceLineId": "98219",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕੁਕਰਮ ਕਰਮਿ ਸੋ ਫਸੈ ॥",
      "transliteration": "kukaram karam so fasai ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਕਰਮਾ ਨੂੰ ਕਰਨ ਵਿਚ ਫਸੇ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "कुकरम करमि सो फसै ॥",
      "sourceLineId": "98220",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਤਿ ਛਾਡਿ ਧਰਮ ਵਾ ਨਸੈ ॥੪੬॥",
      "transliteration": "sat chhaadd dharam vaa nasai ||46||",
      "translation": "No one will perform the rituals enjoyed by religion and the people will quarrel amongst themselves in evil actions to such an extent that they will totally forsake the religion and truth.46.",
      "punjabiViakhya": "ਉਹ ਸੱਚੇ ਧਰਮ ਨੂੰ ਛਡ ਕੇ ਭਜਣਗੇ ॥੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "सति छाडि धरम वा नसै ॥४६॥",
      "sourceLineId": "98221",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪੁਰਾਣ ਕਾਬਿ ਨ ਪੜੈ ॥",
      "transliteration": "puraan kaab na paRai ||",
      "translation": "",
      "punjabiViakhya": "ਪੁਰਾਣ ਅਤੇ ਕਾਵਿ ਨੂੰ ਨਹੀਂ ਪੜ੍ਰਹਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "पुराण काबि न पड़ै ॥",
      "sourceLineId": "98222",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕੁਰਾਨ ਲੈ ਨ ਤੇ ਰੜੈ ॥",
      "transliteration": "kuraan lai na te raRai ||",
      "translation": "They will not study Puranas and Epics and will also not read the holy Quran",
      "punjabiViakhya": "ਕੁਰਾਨ ਨੂੰ ਲੈ ਕੇ ਨਹੀਂ ਉਚਾਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "कुरान लै न ते रड़ै ॥",
      "sourceLineId": "98223",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਧਰਮ ਕਰਮ ਕੋ ਕਰੈ ॥",
      "transliteration": "adharam karam ko karai ||",
      "translation": "",
      "punjabiViakhya": "ਅਧਰਮ ਦੇ ਕਰਮ ਕਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "अधरम करम को करै ॥",
      "sourceLineId": "98224",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੁ ਧਰਮ ਜਾਸੁ ਤੇ ਡਰੈ ॥੪੭॥",
      "transliteration": "s dharam jaas te ddarai ||47||",
      "translation": "They will perform such acts of adharma, that even dharma will also feel frightened.47.",
      "punjabiViakhya": "ਚੰਗੇ ਧਰਮ ਦੇ ਜਸ ਤੋਂ ਡਰਨਗੇ ॥੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "सु धरम जासु ते डरै ॥४७॥",
      "sourceLineId": "98225",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਧਰਾਕਿ ਵਰਣਤਾ ਭਈ ॥",
      "transliteration": "dharaak varanataa bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ ਇਕ ਵਰਣ ਵਾਲੀ ਹੋ ਜਾਏਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "धराकि वरणता भई ॥",
      "sourceLineId": "98226",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੁ ਭਰਮ ਧਰਮ ਕੀ ਗਈ ॥",
      "transliteration": "s bharam dharam kee giee ||",
      "translation": "The whole earth will assume only one caste (of sin) and the trust in religion will be finished",
      "punjabiViakhya": "ਚੰਗੇ ਧਰਮ ਦਾ ਭਰਮ (ਜਾ ਭਰੋਸਾ) ਖ਼ਤਮ ਹੋ ਜਾਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "सु भरम धरम की गई ॥",
      "sourceLineId": "98227",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗ੍ਰਿਹੰ ਗ੍ਰਿਹੰ ਨਯੰ ਮਤੰ ॥",
      "transliteration": "giraha(n) giraha(n) naya(n) mata(n) ||",
      "translation": "",
      "punjabiViakhya": "ਘਰ ਘਰ ਵਿਚ ਨਵੇਾਂ ਮਤ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "गृहं गृहं नयं मतं ॥",
      "sourceLineId": "98228",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚਲੇ ਭੂਅੰ ਜਥਾ ਤਥੰ ॥੪੮॥",
      "transliteration": "chale bhooa(n) jathaa tatha(n) ||48||",
      "translation": "There will be new sects in every home and the people will adopt only misconduct.48.",
      "punjabiViakhya": "ਧਰਤੀ ਉਤੇ (ਲੋਕੀਂ) ਯਥਾ-ਵਤ ਵਿਵਹਾਰ ਕਰਨਗੇ ॥੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "चले भूअं जथा तथं ॥४८॥",
      "sourceLineId": "98229",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗ੍ਰਿਹੰ ਗ੍ਰਿਹੰ ਨਏ ਮਤੰ ॥",
      "transliteration": "giraha(n) giraha(n) ne mata(n) ||",
      "translation": "",
      "punjabiViakhya": "ਘਰ ਘਰ ਨਵੇਾਂ ਮਤ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "गृहं गृहं नए मतं ॥",
      "sourceLineId": "98230",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭਈ ਧਰੰ ਨਈ ਗਤੰ ॥",
      "transliteration": "bhiee dhara(n) niee gata(n) ||",
      "translation": "There will be now sects in every home, there will be new paths on the earth",
      "punjabiViakhya": "ਧਰਤੀ ਦੀ ਨਵੀਂ ਸਥਿਤੀ ਹੋਵੇਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "भई धरं नई गतं ॥",
      "sourceLineId": "98231",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਧਰਮ ਰਾਜਤਾ ਲਈ ॥",
      "transliteration": "adharam raajataa liee ||",
      "translation": "",
      "punjabiViakhya": "ਅਧਰਮ ਦੀ ਬਾਦਸ਼ਾਹੀ ਹੋਵੇਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "अधरम राजता लई ॥",
      "sourceLineId": "98232",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਿਕਾਰਿ ਧਰਮ ਦੇਸ ਦੀ ॥੪੯॥",
      "transliteration": "nikaar dharam dhes dhee ||49||",
      "translation": "There will be the reign of adharma and dharma will be exiled.49.",
      "punjabiViakhya": "ਧਰਮ ਨੂੰ ਦੇਸੋਂ ਕਢ ਦਿੱਤਾ ਜਾਵੇਗਾ ॥੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "निकारि धरम देस दी ॥४९॥",
      "sourceLineId": "98233",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪ੍ਰਬੋਧ ਏਕ ਨ ਲਗੈ ॥",
      "transliteration": "prabodh ek na lagai ||",
      "translation": "",
      "punjabiViakhya": "(ਬ੍ਰਹਮ) ਗਿਆਨ ਵਿਚ ਇਕ ਵੀ ਨਹੀਂ ਲਗੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "प्रबोध एक न लगै ॥",
      "sourceLineId": "98234",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੁ ਧਰਮ ਅਧਰਮ ਤੇ ਭਗੈ ॥",
      "transliteration": "s dharam adharam te bhagai ||",
      "translation": "There will be no impact of knowledge on anyone and dharma will flee in the face of adharma",
      "punjabiViakhya": "ਉਹ ਅਧਰਮ (ਕਰਨਗੇ ਅਤੇ) ਧਰਮ ਤੋਂ ਭਜਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "सु धरम अधरम ते भगै ॥",
      "sourceLineId": "98235",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕੁਕਰਮ ਪ੍ਰਚੁਰਯੰ ਜਗੰ ॥",
      "transliteration": "kukaram prachuraya(n) jaga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਗਤ ਵਿਚ ਮਾੜੇ ਕਰਮ ਬਹੁਤ ਅਧਿਕ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "कुकरम प्रचुरयं जगं ॥",
      "sourceLineId": "98236",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੁ ਕਰਮ ਪੰਖ ਕੈ ਭਗੰ ॥੫੦॥",
      "transliteration": "s karam pa(n)kh kai bhaga(n) ||50||",
      "translation": "The wicked acts will be greatly propagated and dharma will fly away with wings.50.",
      "punjabiViakhya": "ਚੰਗੇ ਕਰਮ ਖੰਭ ਲਾ ਕੇ ਭਜ ਜਾਣਗੇ ॥੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "सु करम पंख कै भगं ॥५०॥",
      "sourceLineId": "98237",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪ੍ਰਪੰਚ ਪੰਚ ਹੁਇ ਗਡਾ ॥",
      "transliteration": "prapa(n)ch pa(n)ch hui gaddaa ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਪੰਚ (ਪਾਖੰਡ) ਪ੍ਰਧਾਨਤਾ ਪ੍ਰਾਪਤ ਕਰ ਕੇ ਦ੍ਰਿੜ੍ਰਹ ਹੋ ਜਾਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "प्रपंच पंच हुइ गडा ॥",
      "sourceLineId": "98238",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਪ੍ਰਪੰਚ ਪੰਖ ਕੇ ਉਡਾ ॥",
      "transliteration": "aprapa(n)ch pa(n)kh ke uddaa ||",
      "translation": "The deceit will be appointed as judge and the simplicity will fly away",
      "punjabiViakhya": "ਅਪ੍ਰਪੰਚ (ਸਚਾਈ) ਖੰਭ ਲਾ ਕੇ ਉਡ ਪੁਡ ਜਾਵੇਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "अप्रपंच पंख के उडा ॥",
      "sourceLineId": "98239",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕੁਕਰਮ ਬਿਚਰਤੰ ਜਗੰ ॥",
      "transliteration": "kukaram bicharata(n) jaga(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸਾਰਾ) ਜਗਤ ਕੁਕਰਮਾ ਵਿਚ ਲਗ ਜਾਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "कुकरम बिचरतं जगं ॥",
      "sourceLineId": "98240",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੁਕਰਮ ਸੁ ਭ੍ਰਮੰ ਭਗੰ ॥੫੧॥",
      "transliteration": "sukaram su bhrama(n) bhaga(n) ||51||",
      "translation": "The whole world will be absorbed in vicious acts and the good acts will speed away.51.",
      "punjabiViakhya": "ਸ਼ੁਭ ਕਰਮ ਭਰਮ ਬਣ ਕੇ ਭਜ ਜਾਣਗੇ ॥੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "सुकरम सु भ्रमं भगं ॥५१॥",
      "sourceLineId": "98241",
      "sourceShabadId": "9184",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0556_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਮਾਣ ਛੰਦ ॥",
      "transliteration": "ramaan chha(n)dh ||",
      "translation": "RAMAAN STANZA",
      "punjabiViakhya": "ਰਮਾਣ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 556,
      "hindi": "",
      "hindiTransliteration": "रमाण छंद ॥",
      "sourceLineId": "98242",
      "sourceShabadId": "9185",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
