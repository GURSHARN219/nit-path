{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 557,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0557_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੁਕ੍ਰਿਤੰ ਤਜਿਹੈ ॥",
      "transliteration": "sukirata(n) tajihai ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਗੇ ਕਰਮਾ ਨੂੰ ਛਡ ਦੇਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "सुकृतं तजिहै ॥",
      "sourceLineId": "98243",
      "sourceShabadId": "9185",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕੁਕ੍ਰਿਤੰ ਭਜਿ ਹੈ ॥੫੨॥",
      "transliteration": "kukirata(n) bhaj hai ||52||",
      "translation": "The people will pay attention to wicked things forsaking the good ones.52.",
      "punjabiViakhya": "ਮੰਦੇ ਕੰਮਾ ਵਿਚ ਲਿਪਤ ਹੋਣਗੇ ॥੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "कुकृतं भजि है ॥५२॥",
      "sourceLineId": "98244",
      "sourceShabadId": "9185",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭ੍ਰਮਣੰ ਭਰਿ ਹੈ ॥",
      "transliteration": "bhramana(n) bhar hai ||",
      "translation": "",
      "punjabiViakhya": "ਭਰਮਾ ਨਾਲ ਭਰ ਜਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "भ्रमणं भरि है ॥",
      "sourceLineId": "98245",
      "sourceShabadId": "9185",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਸ ਤੇ ਟਰਿ ਹੈ ॥੫੩॥",
      "transliteration": "jas te Tar hai ||53||",
      "translation": "They will be filled with illusions and will abandon the approbation.53.",
      "punjabiViakhya": "ਜਸ (ਖਟਣ ਵਾਲੇ ਕਰਮ) ਤੋਂ ਟਲਣਗੇ ॥੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "जस ते टरि है ॥५३॥",
      "sourceLineId": "98246",
      "sourceShabadId": "9185",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਰਿ ਹੈ ਕੁਕ੍ਰਿਤੰ ॥",
      "transliteration": "kar hai kukirata(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮਾੜੇ ਕਰਮ ਕਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "करि है कुकृतं ॥",
      "sourceLineId": "98247",
      "sourceShabadId": "9185",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਰਿ ਹੈ ਅਨ੍ਰਿਥੰ ॥੫੪॥",
      "transliteration": "rar hai aniratha(n) ||54||",
      "translation": "They will do wicked deeds and quarrel uselessly amongst themselves.54.",
      "punjabiViakhya": "ਅਨਰਥ ਬੋਲਣਗੇ ॥੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "ररि है अनृथं ॥५४॥",
      "sourceLineId": "98248",
      "sourceShabadId": "9185",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਪ ਹੈ ਅਜਪੰ ॥",
      "transliteration": "jap hai ajapa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨ ਜਪੇ ਜਾਣ ਯੋਗ ਨੂੰ ਜਪਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "जप है अजपं ॥",
      "sourceLineId": "98249",
      "sourceShabadId": "9185",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕੁਥਪੇਣ ਥਪੰ ॥੫੫॥",
      "transliteration": "kuthapen thapa(n) ||55||",
      "translation": "They will recite the evil mantras and will establish the uncivilised notions.55.",
      "punjabiViakhya": "ਮਾੜੀਆਂ ਸਥਾਪਨਾਵਾ ਕਰਨਗੇ ॥੫੫॥",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "कुथपेण थपं ॥५५॥",
      "sourceLineId": "98250",
      "sourceShabadId": "9185",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੋਮਰਾਜੀ ਛੰਦ ॥",
      "transliteration": "somaraajee chha(n)dh ||",
      "translation": "SOMRAJI STANZA",
      "punjabiViakhya": "ਸੋਮਰਾਜੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "सोमराजी छंद ॥",
      "sourceLineId": "98251",
      "sourceShabadId": "9186",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੁਨੈ ਦੇਸਿ ਦੇਸੰ ਮੁਨੰ ਪਾਪ ਕਰਮਾ ॥",
      "transliteration": "sunai dhes dhesa(n) muna(n) paap karamaa ||",
      "translation": "The sages will be noticed to have performed sinful acts in various countries",
      "punjabiViakhya": "ਦੇਸ ਦੇਸਾਤਰਾ ਵਿਚ ਮੁਨੀ ਲੋਗ ਪਾਪ ਕਰਨ ਵਾਲੇ ਸੁਣੇ ਜਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "सुनै देसि देसं मुनं पाप करमा ॥",
      "sourceLineId": "98252",
      "sourceShabadId": "9186",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚੁਨੈ ਜੂਠ ਕੂਠੰ ਸ੍ਰੁਤੰ ਛੋਰ ਧਰਮਾ ॥੫੬॥",
      "transliteration": "chunai jooTh kooTha(n) sruta(n) chhor dharamaa ||56||",
      "translation": "They will abandon the path enjoined by the Vedas and only select the impure and false rituals.56.",
      "punjabiViakhya": "ਵੈਦਿਕ ਧਰਮ ਨੂੰ ਛਡ ਕੇ ਝੂਠ ਮੂਠ ਦੇ ਕਰਮ ਚੁਣਨਗੇ ॥੫੬॥",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "चुनै जूठ कूठं स्रुतं छोर धरमा ॥५६॥",
      "sourceLineId": "98253",
      "sourceShabadId": "9186",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਜੈ ਧਰਮ ਨਾਰੀ ਤਕੈ ਪਾਪ ਨਾਰੰ ॥",
      "transliteration": "tajai dharam naaree takai paap naara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੀ ਧਰਮ ਇਸਤਰੀ ਨੂੰ ਛਡ ਕੇ ਪਾਪ ਇਸਤਰੀ (ਵਿਭਚਾਰਨ) ਵਲ ਤਕਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "तजै धरम नारी तकै पाप नारं ॥",
      "sourceLineId": "98254",
      "sourceShabadId": "9186",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਹਾ ਰੂਪ ਪਾਪੀ ਕੁਵਿਤ੍ਰਾਧਿਕਾਰੰ ॥੫੭॥",
      "transliteration": "mahaa roop paapee kuvitraadhikaara(n) ||57||",
      "translation": "The men and women will forsake dharma and absorb themselves in sinful deeds and the great sinners will become the administration.57.",
      "punjabiViakhya": "ਵੱਡੇ ਰੂਪ (ਸਮਰਥਾ) ਵਾਲੇ ਮਾੜੀ ਕਮਾਈ ਦੇ ਅਧਿਕਾਰੀ ਹੋਣਗੇ ॥੫੭॥",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "महा रूप पापी कुवित्राधिकारं ॥५७॥",
      "sourceLineId": "98255",
      "sourceShabadId": "9186",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਰੈ ਨਿਤ ਅਨਰਥੰ ਸਮਰਥੰ ਨ ਏਤੀ ॥",
      "transliteration": "karai nit anaratha(n) samaratha(n) na etee ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੀ ਸਮਰਥਾ ਤੋਂ ਵਧ ਕੇ ਨਿੱਤ ਅਨਰਥ ਕਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "करै नित अनरथं समरथं न एती ॥",
      "sourceLineId": "98256",
      "sourceShabadId": "9186",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਰੈ ਪਾਪ ਤੇਤੋ ਪਰਾਲਬਧ ਜੇਤੀ ॥੫੮॥",
      "transliteration": "karai paap teto paraalabadh jetee ||58||",
      "translation": "They will commit sins beyond their power and will perform wicked deeds in accordance with their conduct.58.",
      "punjabiViakhya": "ਜਿਤਨੀ ਪਰਾਲਬਧ ਹੋਵੇਗੀ ਉਤਨੇ ਪਾਪ ਕਰਨਗੇ ॥੫੮॥",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "करै पाप तेतो परालबध जेती ॥५८॥",
      "sourceLineId": "98257",
      "sourceShabadId": "9186",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਏ ਨਿੱਤ ਮੱਤੰ ਉਠੈ ਏਕ ਏਕੰ ॥",
      "transliteration": "ne ni't ma'ta(n) uThai ek eka(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨਿੱਤ ਇਕ ਤੋਂ ਇਕ (ਵਧ ਕੇ) ਨਵੇਾਂ ਮਤ ਪੈਦਾ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "नए नित्त मत्तं उठै एक एकं ॥",
      "sourceLineId": "98258",
      "sourceShabadId": "9186",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਰੈ ਨਿੰਤ ਅਨਰਥੰ ਅਨੇਕੰ ਅਨੇਕੰ ॥੫੯॥",
      "transliteration": "karai ni(n)t anaratha(n) aneka(n) aneka(n) ||59||",
      "translation": "The new sects will arise always and there will be great misfortunes.59.",
      "punjabiViakhya": "ਨਿੱਤ ਅਨੇਕਾ ਅਨੇਕਾ ਅਨਰਥ ਕਰਨਗੇ ॥੫੯॥",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "करै निंत अनरथं अनेकं अनेकं ॥५९॥",
      "sourceLineId": "98259",
      "sourceShabadId": "9186",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪ੍ਰਿਯਾ ਛੰਦ ॥",
      "transliteration": "pirayaa chha(n)dh ||",
      "translation": "PRIYA STANZA",
      "punjabiViakhya": "ਪ੍ਰਿਯਾ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "पृया छंद ॥",
      "sourceLineId": "98260",
      "sourceShabadId": "9187",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦੁਖ ਦੰਦ ਹੈ ਸੁਖਕੰਦ ਜੀ ॥",
      "transliteration": "dhukh dha(n)dh hai sukhaka(n)dh jee ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਖ ਦੇਣ ਵਾਲਿਆਂ ਨੂੰ ਦੁਖ ਦੇਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "दुख दंद है सुखकंद जी ॥",
      "sourceLineId": "98261",
      "sourceShabadId": "9187",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਹੀ ਬੰਧ ਹੈ ਜਗਬੰਦ ਜੀ ॥੬੦॥",
      "transliteration": "nahee ba(n)dh hai jagaba(n)dh jee ||60||",
      "translation": "People will not worship the Lord, the remover of all sufferings.60.",
      "punjabiViakhya": "ਜਗਤ ਤੋਂ ਬੰਦਨਾ ਕੀਤੇ ਜਾਣ ਵਾਲੇ ਦੀ ਬੰਦਨਾ ਨਹੀਂ ਕਰਨਗੇ ॥੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "नही बंध है जगबंद जी ॥६०॥",
      "sourceLineId": "98262",
      "sourceShabadId": "9187",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਹੀ ਬੇਦ ਬਾਕ ਪ੍ਰਮਾਨ ਹੈ ॥",
      "transliteration": "nahee bedh baak pramaan hai ||",
      "translation": "",
      "punjabiViakhya": "ਵੇਦ ਵਾਕ ਨੂੰ ਪ੍ਰਮਾਣ ਨਹੀਂ ਮੰਨਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "नही बेद बाक प्रमान है ॥",
      "sourceLineId": "98263",
      "sourceShabadId": "9187",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਤ ਭਿੰਨ ਭਿੰਨ ਬਖਾਨ ਹੈ ॥੬੧॥",
      "transliteration": "mat bhi(n)n bhi(n)n bakhaan hai ||61||",
      "translation": "The injunctions of Vedas will not be considered quthentic and the people will describe various other religions.61.",
      "punjabiViakhya": "ਵੱਖ ਵੱਖ ਮਤਾ ਦਾ ਬਖਾਨ ਕਰਨਗੇ ॥੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "मत भिंन भिंन बखान है ॥६१॥",
      "sourceLineId": "98264",
      "sourceShabadId": "9187",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨ ਕੁਰਾਨ ਕੋ ਮਤੁ ਲੇਹਗੇ ॥",
      "transliteration": "n kuraan ko mat lehage ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਰਾਨ ਦੀ ਸਿਖਿਆ ਨਹੀਂ ਲੈਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "न कुरान को मतु लेहगे ॥",
      "sourceLineId": "98265",
      "sourceShabadId": "9187",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0557_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨ ਪੁਰਾਨ ਦੇਖਨ ਦੇਹਗੇ ॥੬੨॥",
      "transliteration": "n puraan dhekhan dhehage ||62||",
      "translation": "No one will accept the advice of the holy Quran and no one will be able to see the Puranas.62.",
      "punjabiViakhya": "ਪੁਰਾਨਾ ਨੂੰ ਵੇਖਣ ਨਹੀਂ ਦੇਣਗੇ ॥੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 557,
      "hindi": "",
      "hindiTransliteration": "न पुरान देखन देहगे ॥६२॥",
      "sourceLineId": "98266",
      "sourceShabadId": "9187",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
