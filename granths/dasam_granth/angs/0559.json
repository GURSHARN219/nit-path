{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 559,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0559_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪਾਪ ਕਮੈ ਵਹ ਦੁਰਗਤਿ ਪੈ ਹੈ ॥",
      "transliteration": "paap kamai veh dhuragat pai hai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਪਾਪ ਕਮਾ ਕੇ ਦੁਰਗਤੀ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰਨਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "पाप कमै वह दुरगति पै है ॥",
      "sourceLineId": "98315",
      "sourceShabadId": "9191",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪਾਪ ਸਮੁੰਦ ਜੈ ਹੈ ਨ ਤਰਿ ॥੭੭॥",
      "transliteration": "paap samu(n)dh jai hai na tar ||77||",
      "translation": "They will move in the world unashamedly, they will earn through sinful acts and suffer catastrophies and will remain powerless and will not be able to ferry across the sea of sin.7",
      "punjabiViakhya": "ਅਤੇ ਪਾਪਾ ਦੇ ਸਮੁੰਦਰ ਨੂੰ ਤਰ ਕੇ (ਪਾਰ ਪਹੁੰਚ) ਨਹੀਂ ਸਕਣਗੇ ॥੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "पाप समुँद जै है न तरि ॥७७॥",
      "sourceLineId": "98316",
      "sourceShabadId": "9191",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "98317",
      "sourceShabadId": "9192",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਠਉਰ ਠਉਰ ਨਵ ਮਤ ਚਲੇ ਉਠਾ ਧਰਮ ਕੋ ਦੌਰ ॥",
      "transliteration": "Thaur Thaur nav mat chale uThaa dharam ko dhauar ||",
      "translation": "New sects will arise at various places and the impact of dharma will end",
      "punjabiViakhya": "ਥਾ ਥਾ ਤੇ ਨਵੇਾਂ ਮਤ ਚਲਣਗੇ ਅਤੇ ਧਰਮ ਦਾ ਦੌਰ ਹੀ ਸਮਾਪਤ ਹੋ ਜਾਏਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "ठउर ठउर नव मत चले उठा धरम को दौर ॥",
      "sourceLineId": "98318",
      "sourceShabadId": "9192",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੁਕ੍ਰਿਤ ਜਹ ਤਹ ਦੁਰ ਰਹੀ ਪਾਪ ਭਇਓ ਸਿਰਮੌਰ ॥੭੮॥",
      "transliteration": "sukirat jeh teh dhur rahee paap bhio siramauar ||78||",
      "translation": "The goodness will remain concealed and the sin will dance everywhere.78.",
      "punjabiViakhya": "ਪੁੰਨ ਕਰਮ ਜਿਥੇ ਕਿਥੇ ਲੁਕਿਆ ਰਹੇਗਾ ਅਤੇ ਪਾਪ ਪ੍ਰਧਾਨ ਹੋ ਜਾਏਗਾ ॥੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "सुकृत जह तह दुर रही पाप भइओ सिरमौर ॥७८॥",
      "sourceLineId": "98319",
      "sourceShabadId": "9192",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਵਪਦੀ ਛੰਦ ॥",
      "transliteration": "navapadhee chha(n)dh ||",
      "translation": "NAVPADI STANZA",
      "punjabiViakhya": "ਨਵਪਦੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "नवपदी छंद ॥",
      "sourceLineId": "98320",
      "sourceShabadId": "9193",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਹ ਤਹ ਕਰਨ ਲਗੇ ਸਭ ਪਾਪਨ ॥",
      "transliteration": "jeh teh karan lage sabh paapan ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਸਾਰੇ ਪਾਪ ਕਰਨ ਲਗਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "जह तह करन लगे सभ पापन ॥",
      "sourceLineId": "98321",
      "sourceShabadId": "9193",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਧਰਮ ਕਰਮ ਤਜਿ ਕਰ ਹਰਿ ਜਾਪਨ ॥",
      "transliteration": "dharam karam taj kar har jaapan ||",
      "translation": "Here and there all will leave the religious injunctions and the remembrance of the Name of the Lord and perform the sinful acts",
      "punjabiViakhya": "ਧਰਮ ਕਰਮ ਅਤੇ ਹਰਿ (ਦੇ ਨਾਮ) ਦਾ ਜਾਪ ਛਡ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "धरम करम तजि कर हरि जापन ॥",
      "sourceLineId": "98322",
      "sourceShabadId": "9193",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪਾਹਨ ਕਉ ਸੁ ਕਰਤ ਸਬ ਬੰਦਨ ॥",
      "transliteration": "paahan kau su karat sab ba(n)dhan ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਤੀਆਂ ਨੂੰ ਸਭ ਬੰਦਨਾ ਕਰਨਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "पाहन कउ सु करत सब बंदन ॥",
      "sourceLineId": "98323",
      "sourceShabadId": "9193",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਡਾਰਤ ਧੂਪ ਦੀਪ ਸਿਰਿ ਚੰਦਨ ॥੭੯॥",
      "transliteration": "ddaarat dhoop dheep sir cha(n)dhan ||79||",
      "translation": "The stone-idols will be worshipped and only on them incense. Lamp-lights and sandal will be offered.79.",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਦੇ ਸਿਰ ਤੇ ਧੂਪ, ਦੀਪ ਅਤੇ ਚੰਦਨ ਚੜ੍ਰਹਾਉਣਗੇ ॥੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "डारत धूप दीप सिरि चंदन ॥७९॥",
      "sourceLineId": "98324",
      "sourceShabadId": "9193",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਹ ਤਹ ਧਰਮ ਕਰਮ ਤਜਿ ਭਾਗਤ ॥",
      "transliteration": "jeh teh dharam karam taj bhaagat ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਧਰਮ ਦੇ ਕਰਮ ਨੂੰ ਛਡ ਕੇ (ਲੋਗ) ਭਜ ਜਾਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "जह तह धरम करम तजि भागत ॥",
      "sourceLineId": "98325",
      "sourceShabadId": "9193",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਉਠਿ ਉਠਿ ਪਾਪ ਕਰਮ ਸੌ ਲਾਗਤ ॥",
      "transliteration": "auTh uTh paap karam sau laagat ||",
      "translation": "Here and there, forsaking the religious injunction, people will run away, they will be absorbed in sinful acts",
      "punjabiViakhya": "ਅਤੇ ਉਠ ਉਠ ਕੇ ਪਾਪ ਕਰਮਾ ਵਿਚ ਲਗ ਜਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "उठि उठि पाप करम सौ लागत ॥",
      "sourceLineId": "98326",
      "sourceShabadId": "9193",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਹ ਤਹ ਭਈ ਧਰਮ ਗਤਿ ਲੋਪੰ ॥",
      "transliteration": "jeh teh bhiee dharam gat lopa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਧਰਮ ਦੀ ਗਤੀ ਲੁਪਤ ਹੋ ਜਾਵੇਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "जह तह भई धरम गति लोपं ॥",
      "sourceLineId": "98327",
      "sourceShabadId": "9193",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪਾਪਹਿ ਲਗੀ ਚਉਗਨੀ ਓਪੰ ॥੮੦॥",
      "transliteration": "paapeh lagee chauganee opa(n) ||80||",
      "translation": "No religion will remain visible and the sin will become fourfold.80.",
      "punjabiViakhya": "ਅਤੇ ਪਾਪਾ ਦੀ ਚੌਗੁਣੀ ਸ਼ੋਭਾ ਵਧ ਜਾਵੇਗੀ ॥੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "पापहि लगी चउगनी ओपं ॥८०॥",
      "sourceLineId": "98328",
      "sourceShabadId": "9193",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਾਜ੍ਯੋ ਧਰਮ ਭਰਮ ਤਜਿ ਅਪਨਾ ॥",
      "transliteration": "bhaajayo dharam bharam taj apanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਸੰਸਾਰ ਵਿਚ) ਧਰਮ ਆਪਣਾ (ਕੇਵਲ) ਖਿਆਲ ਛਡ ਕੇ ਭਜ ਜਾਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "भाज्यो धरम भरम तजि अपना ॥",
      "sourceLineId": "98329",
      "sourceShabadId": "9193",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਾਨੁਕ ਹੁਤੋ ਲਖਾ ਇਹ ਸੁਪਨਾ ॥",
      "transliteration": "jaanuk huto lakhaa ieh supanaa ||",
      "translation": "Forsaking their religious injunctions the people will run away in such a way as if they had seen a bad dread",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੋਵੇਗਾ) ਮਾਨੋ ਇਕ ਸੁਪਨਾ ਵੇਖਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "जानुक हुतो लखा इह सुपना ॥",
      "sourceLineId": "98330",
      "sourceShabadId": "9193",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਭ ਸੰਸਾਰ ਤਜੀ ਤ੍ਰੀਅ ਆਪਨ ॥",
      "transliteration": "sabh sa(n)saar tajee treea aapan ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਾ ਸੰਸਾਰ ਆਪਣੀਆਂ ਇਸਤਰੀਆਂ ਛਡ ਦੇਵੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "सभ संसार तजी त्रीअ आपन ॥",
      "sourceLineId": "98331",
      "sourceShabadId": "9193",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮੰਤ੍ਰ ਕੁਮੰਤ੍ਰ ਲਗੇ ਮਿਲਿ ਜਾਪਨ ॥੮੧॥",
      "transliteration": "ma(n)tr kuma(n)tr lage mil jaapan ||81||",
      "translation": "All the people will abandon their wives and will repeat evil notions.81.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ (ਲੋਕ) ਮਾੜੇ ਮੰਤ੍ਰਾ ਨੂੰ ਜਪਣ ਲਗ ਜਾਣਗੇ ॥੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "मंत्र कुमंत्र लगे मिलि जापन ॥८१॥",
      "sourceLineId": "98332",
      "sourceShabadId": "9193",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚਹੁ ਦਿਸ ਘੋਰ ਪ੍ਰਚਰ ਭਇਓ ਪਾਪਾ ॥",
      "transliteration": "chahu dhis ghor prachar bhio paapaa ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ ਪਾਸੇ ਅਤਿ ਅਧਿਕ ਘੋਰ ਪਾਪਾ (ਦਾ ਪਸਾਰਾ) ਹੋ ਜਾਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "चहु दिस घोर प्रचर भइओ पापा ॥",
      "sourceLineId": "98333",
      "sourceShabadId": "9193",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕੋਊ ਨ ਜਾਪ ਸਕੈ ਹਰਿ ਜਾਪਾ ॥",
      "transliteration": "kouoo na jaap sakai har jaapaa ||",
      "translation": "Because of the prevalence of sin in all the four directions, no one will be able to remember the Lord",
      "punjabiViakhya": "ਕੋਈ ਵੀ ਹਰਿ ਦਾ ਜਾਪ ਨਹੀਂ ਜਪ ਸਕੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "कोऊ न जाप सकै हरि जापा ॥",
      "sourceLineId": "98334",
      "sourceShabadId": "9193",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪਾਪ ਕ੍ਰਿਆ ਸਭ ਜਾ ਚਲ ਪਈ ॥",
      "transliteration": "paap kriaa sabh jaa chal piee ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਥਾਵਾ ਤੇ ਪਾਪ ਦੀ ਕ੍ਰਿਆ ਚਲ ਪਵੇਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "पाप कृआ सभ जा चल पई ॥",
      "sourceLineId": "98335",
      "sourceShabadId": "9193",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਧਰਮ ਕ੍ਰਿਆ ਯਾ ਜਗ ਤੇ ਗਈ ॥੮੨॥",
      "transliteration": "dharam kriaa yaa jag te giee ||82||",
      "translation": "The sinful tendencies will prevail in such a way that all the religious acts will be finished in the world.82.",
      "punjabiViakhya": "ਧਰਮ ਦੀ ਕ੍ਰਿਆ ਇਸ ਸੰਸਾਰ ਤੋਂ ਚਲੀ ਜਾਏਗੀ ॥੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "धरम कृआ या जग ते गई ॥८२॥",
      "sourceLineId": "98336",
      "sourceShabadId": "9193",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅੜਿਲ ਦੂਜਾ ॥",
      "transliteration": "aRil dhoojaa ||",
      "translation": "ARIL SECOND",
      "punjabiViakhya": "ਅੜਿਲ ਦੂਜਾ:",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "अड़िल दूजा ॥",
      "sourceLineId": "98337",
      "sourceShabadId": "9194",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਹਾ ਤਹਾ ਆਧਰਮ ਉਪਜਿਯਾ ॥",
      "transliteration": "jahaa tahaa aadharam upajiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਅਧਰਮ ਉਪਜ ਪਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "जहा तहा आधरम उपजिया ॥",
      "sourceLineId": "98338",
      "sourceShabadId": "9194",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਾਨੁਕ ਧਰਮ ਪੰਖ ਕਰਿ ਭਜਿਯਾ ॥",
      "transliteration": "jaanuk dharam pa(n)kh kar bhajiyaa ||",
      "translation": "Because of the birth of adharma here and there, the dharma will get wings and fly away",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੋਵੇਗਾ) ਮਾਨੋ ਧਰਮ ਖੰਭ ਲਾ ਕੇ ਉਡ ਗਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "जानुक धरम पंख करि भजिया ॥",
      "sourceLineId": "98339",
      "sourceShabadId": "9194",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਡੋਲਤ ਜਹ ਤਹ ਪੁਰਖ ਅਪਾਵਨ ॥",
      "transliteration": "ddolat jeh teh purakh apaavan ||",
      "translation": "",
      "punjabiViakhya": "ਅਪਵਿਤਰ ਲੋਗ ਜਿਥੇ ਕਿਥੇ ਫਿਰਦੇ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "डोलत जह तह पुरख अपावन ॥",
      "sourceLineId": "98340",
      "sourceShabadId": "9194",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਲਾਗਤ ਕਤ ਹੀ ਧਰਮ ਕੋ ਦਾਵਨ ॥੮੩॥",
      "transliteration": "laagat kat hee dharam ko dhaavan ||83||",
      "translation": "The bad people will roam here and there and the turn of dharma will never come.83.",
      "punjabiViakhya": "ਕਿਤੇ ਵੀ ਧਰਮ ਦਾ ਦਾਉ ਨਹੀਂ ਲਗੇਗਾ ॥੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "लागत कत ही धरम को दावन ॥८३॥",
      "sourceLineId": "98341",
      "sourceShabadId": "9194",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਰਥਹ ਛਾਡਿ ਅਨਰਥ ਬਤਾਵਤ ॥",
      "transliteration": "aratheh chhaadd anarath bataavat ||",
      "translation": "",
      "punjabiViakhya": "ਸਹੀ ਗੱਲਾ ਛਡ ਕੇ ਮਾੜੀਆਂ ਗੱਲਾ ਦਸਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "अरथह छाडि अनरथ बतावत ॥",
      "sourceLineId": "98342",
      "sourceShabadId": "9194",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਧਰਮ ਕਰਮ ਚਿਤਿ ਏਕ ਨ ਲਿਆਵਤ ॥",
      "transliteration": "dharam karam chit ek na liaavat ||",
      "translation": "The people will make meaningless all the meaningful things and will never let the notion of religious karmas enter there mind",
      "punjabiViakhya": "ਅਤੇ ਧਰਮ ਕਰਮ ਵਿਚ ਇਕ ਵੀ ਚਿਤ ਨਹੀਂ ਲਿਆਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "धरम करम चिति एक न लिआवत ॥",
      "sourceLineId": "98343",
      "sourceShabadId": "9194",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਰਮ ਧਰਮ ਕੀ ਕ੍ਰਿਆ ਭੁਲਾਵਤ ॥",
      "transliteration": "karam dharam kee kriaa bhulaavat ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਮ ਕਰਮ ਦੀ ਵਿਧੀ ਭੁਲਾ ਦੇਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "करम धरम की कृआ भुलावत ॥",
      "sourceLineId": "98344",
      "sourceShabadId": "9194",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਹਾ ਤਹਾ ਆਰਿਸਟ ਬਤਾਵਤ ॥੮੪॥",
      "transliteration": "jahaa tahaa aarisaT bataavat ||84||",
      "translation": "Forgetting the activities of dharma, they will propagate about sin here and there.84.",
      "punjabiViakhya": "ਅਤੇ ਜਿਥੇ ਕਿਥੇ ਘੋਰ ਪਾਪਾ ਦਾ ਬਖਾਨ ਕਰਨਗੇ ॥੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "जहा तहा आरिसट बतावत ॥८४॥",
      "sourceLineId": "98345",
      "sourceShabadId": "9194",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕੁਲਕ ਛੰਦ ॥",
      "transliteration": "kulak chha(n)dh ||",
      "translation": "KULAK STANZA",
      "punjabiViakhya": "ਕੁਲਕ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "कुलक छंद ॥",
      "sourceLineId": "98346",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਧਰਮ ਨ ਕਰਹੀ ॥",
      "transliteration": "dharam na karahee ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਮ ਨਹੀਂ ਕਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "धरम न करही ॥",
      "sourceLineId": "98347",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਹਰਿ ਨ ਉਚਰਹੀ ॥",
      "transliteration": "har na ucharahee ||",
      "translation": "They will not perform the acts of dharma, they will not utter the Name of the Lord",
      "punjabiViakhya": "ਹਰਿ ਨਾਮ ਦਾ ਉਚਾਰਨ ਨਹੀਂ ਕਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "हरि न उचरही ॥",
      "sourceLineId": "98348",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪਰ ਘਰਿ ਡੋਲੈ ॥",
      "transliteration": "par ghar ddolai ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਾਏ ਘਰਾ (ਦੀਆਂ ਇਸਤਰੀਆਂ ਅਤੇ ਮਾਲ ਧਨ ਨੂੰ ਵੇਖਣ ਲਈ) ਡੋਲਦੇ ਫਿਰਨਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "पर घरि डोलै ॥",
      "sourceLineId": "98349",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਲਹ ਬਿਰੋਲੈ ॥੮੫॥",
      "transliteration": "jaleh birolai ||85||",
      "translation": "They will enter the houses of others and churning water, they will try to realise the essence.85.",
      "punjabiViakhya": "(ਅਤੇ ਇਸ ਤਰ੍ਰਹਾ) ਜਲ ਨੂੰ ਰਿੜਕਦੇ ਹੋਣਗੇ ॥੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "जलह बिरोलै ॥८५॥",
      "sourceLineId": "98350",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਲਹੈ ਨ ਅਰਥੰ ॥",
      "transliteration": "lahai na aratha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸਹੀ) ਅਰਥ ਨੂੰ ਨਹੀਂ ਸਮਝਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "लहै न अरथं ॥",
      "sourceLineId": "98351",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਹੈ ਅਨਰਥੰ ॥",
      "transliteration": "kahai anaratha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਗ਼ਲਤ ਅਰਥ ਦਸਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "कहै अनरथं ॥",
      "sourceLineId": "98352",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਚਨ ਨ ਸਾਚੇ ॥",
      "transliteration": "bachan na saache ||",
      "translation": "",
      "punjabiViakhya": "ਬਚਨ ਦੇ ਸੱਚੇ ਨਹੀਂ ਹੋਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "बचन न साचे ॥",
      "sourceLineId": "98353",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਤਿ ਕੇ ਕਾਚੇ ॥੮੬॥",
      "transliteration": "mat ke kaache ||86||",
      "translation": "Without understanding the real meaning, they will deliver useless speeches and adopting the temporary religions, they will never talk about the truth.86.",
      "punjabiViakhya": "ਅਤੇ ਮੱਤ ਦੇ ਕੱਚੇ ਹੋਣਗੇ ॥੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "मति के काचे ॥८६॥",
      "sourceLineId": "98354",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪਰਤ੍ਰੀਆ ਰਾਚੈ ॥",
      "transliteration": "paratreeaa raachai ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਾਈ ਇਸਤਰੀ ਵਿਚ ਮਗਨ ਹੋਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "परत्रीआ राचै ॥",
      "sourceLineId": "98355",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਘਰਿ ਘਰਿ ਜਾਚੈ ॥",
      "transliteration": "ghar ghar jaachai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘਰ ਘਰ ਮੰਗਦੇ ਫਿਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "घरि घरि जाचै ॥",
      "sourceLineId": "98356",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਹ ਤਹ ਡੋਲੈ ॥",
      "transliteration": "jeh teh ddolai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਡੋਲਦੇ ਫਿਰਨਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "जह तह डोलै ॥",
      "sourceLineId": "98357",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰਹਿ ਰਹਿ ਬੋਲੈ ॥੮੭॥",
      "transliteration": "reh reh bolai ||87||",
      "translation": "Entering the houses of other, they will roam and speak here and there and will remain absorbed with others women.87.",
      "punjabiViakhya": "ਅਤੇ ਰਹਿ ਰਹਿ ਕੇ (ਅਰਥਾਤ ਥੋੜੀ ਥੋੜੀ ਦੇਰ ਬਾਦ ਮੰਗਣ ਦਾ) ਸਦ ਕਰਨਗੇ ॥੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "रहि रहि बोलै ॥८७॥",
      "sourceLineId": "98358",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਧਨ ਨਹੀ ਛੋਰੈ ॥",
      "transliteration": "dhan nahee chhorai ||",
      "translation": "",
      "punjabiViakhya": "ਧਨ ਨੂੰ ਨਹੀਂ ਛਡਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "धन नही छोरै ॥",
      "sourceLineId": "98359",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਿਸਿ ਘਰ ਫੋਰੈ ॥",
      "transliteration": "nis ghar forai ||",
      "translation": "Covering for wealth, they will go for theft during the night",
      "punjabiViakhya": "ਰਾਤ ਨੂੰ ਘਰਾ ਨੂੰ ਸੰਨ੍ਰਹਾ ਮਾਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "निसि घर फोरै ॥",
      "sourceLineId": "98360",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗਹਿ ਬਹੁ ਮਾਰੀਅਤ ॥",
      "transliteration": "geh bahu maareeat ||",
      "translation": "",
      "punjabiViakhya": "(ਜਮਗਣ ਉਨ੍ਰਹਾ ਨੂੰ ਚੋਰਾ ਵਾਗ) ਫੜ ਕੇ ਬਹੁਤ ਮਾਰਨਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "गहि बहु मारीअत ॥",
      "sourceLineId": "98361",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0559_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਰਕਹਿ ਡਾਰੀਅਤ ॥੮੮॥",
      "transliteration": "narakeh ddaareeat ||88||",
      "translation": "They will be destroyed collectively and will go to hell.88.",
      "punjabiViakhya": "ਅਤੇ ਨਰਕਾ ਵਿਚ ਸੁਟਣਗੇ ॥੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 559,
      "hindi": "",
      "hindiTransliteration": "नरकहि डारीअत ॥८८॥",
      "sourceLineId": "98362",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
