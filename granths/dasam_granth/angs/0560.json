{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 560,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0560_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਸ ਦੁਰ ਕਰਮੰ ॥",
      "transliteration": "as dhur karama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਜਿਹੇ ਮਾੜੇ ਕਰਮ ਹੋਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "अस दुर करमं ॥",
      "sourceLineId": "98363",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਛੁਟ ਜਗਿ ਧਰਮੰ ॥",
      "transliteration": "chhuT jag dharama(n) ||",
      "translation": "Because of their such-like sinful acts, no dharma will be left in the world",
      "punjabiViakhya": "ਕਿ ਜਗਤ ਤੋਂ ਧਰਮ ਛੁਟ ਜਾਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "छुट जगि धरमं ॥",
      "sourceLineId": "98364",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਤਿ ਪਿਤ ਭਰਮੈ ॥",
      "transliteration": "mat pit bharamai ||",
      "translation": "",
      "punjabiViakhya": "(ਪੁੱਤਰਾ ਦੇ ਮਾੜੇ ਵਿਵਹਾਰ ਕਰ ਕੇ) ਮਾਤਾ ਪਿਤਾ (ਘਰੋਂ ਬਾਹਰ) ਭਟਕਦੇ ਰਹਿਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "मति पित भरमै ॥",
      "sourceLineId": "98365",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਧਸਤ ਨ ਘਰ ਮੈ ॥੮੯॥",
      "transliteration": "dhasat na ghar mai ||89||",
      "translation": "The parents will not enter the houses being frightened.89.",
      "punjabiViakhya": "ਅਤੇ ਘਰ ਨਹੀਂ ਵੜਨਗੇ ॥੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "धसत न घर मै ॥८९॥",
      "sourceLineId": "98366",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਿਖ ਮੁਖ ਮੋਰੈ ॥",
      "transliteration": "sikh mukh morai ||",
      "translation": "",
      "punjabiViakhya": "ਸੇਵਕ (ਗੁਰੂ ਤੋਂ) ਮੁਖ ਮੋੜ ਲੈਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "सिख मुख मोरै ॥",
      "sourceLineId": "98367",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭ੍ਰਿਤ ਨ੍ਰਿਪਿ ਛੋਰੈ ॥",
      "transliteration": "bhirat nirap chhorai ||",
      "translation": "The disciples will turn away from their Guru and the servants will leave the king",
      "punjabiViakhya": "ਨੌਕਰ ਰਾਜੇ ਨੂੰ ਛਡ ਦੇਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "भृत नृपि छोरै ॥",
      "sourceLineId": "98368",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਜਿ ਤ੍ਰੀਆ ਭਰਤਾ ॥",
      "transliteration": "taj treeaa bharataa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀਆਂ ਪਤੀਆਂ ਨੂੰ ਛਡ ਦੇਣਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "तजि त्रीआ भरता ॥",
      "sourceLineId": "98369",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਿਸਰੋ ਕਰਤਾ ॥੯੦॥",
      "transliteration": "bisaro karataa ||90||",
      "translation": "The wife, relinquishing her husband, will also forget the Lord.90.",
      "punjabiViakhya": "(ਸਭ ਨੂੰ) ਕਰਤਾ (ਪੁਰਖ) ਭੁਲ ਜਾਏਗਾ ॥੯੦॥",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "बिसरो करता ॥९०॥",
      "sourceLineId": "98370",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਵ ਨਵ ਕਰਮੰ ॥",
      "transliteration": "nav nav karama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨਵੇਾਂ ਨਵੇਾਂ ਕਰਮ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "नव नव करमं ॥",
      "sourceLineId": "98371",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਢਿ ਗਇਓ ਭਰਮੰ ॥",
      "transliteration": "badd gio bharama(n) ||",
      "translation": "Because of the new types of Karmas, the illusions will increase",
      "punjabiViakhya": "ਭਰਮ ਵਧ ਗਿਆ ਹੋਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "बढि गइओ भरमं ॥",
      "sourceLineId": "98372",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਭ ਜਗ ਪਾਪੀ ॥",
      "transliteration": "sabh jag paapee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਾ ਜਗਤ ਪਾਪੀ (ਹੋ ਜਾਵੇਗਾ)।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "सभ जग पापी ॥",
      "sourceLineId": "98373",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਹੂੰ ਨ ਜਾਪੀ ॥੯੧॥",
      "transliteration": "kahoo(n) na jaapee ||91||",
      "translation": "The whole world will become sinful and no person repeating the Name or performing austerities, will be left in the world.91.",
      "punjabiViakhya": "ਕੋਈ ਵੀ ਜਪ ਕਰਨ ਵਾਲਾ ਨਹੀਂ ਹੋਵੇਗਾ ॥੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "कहूँ न जापी ॥९१॥",
      "sourceLineId": "98374",
      "sourceShabadId": "9195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪਦਮਾਵਤੀ ਛੰਦ ॥",
      "transliteration": "padhamaavatee chha(n)dh ||",
      "translation": "PADMAVATI STANZA",
      "punjabiViakhya": "ਪਦਮਾਵਤੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "पदमावती छंद ॥",
      "sourceLineId": "98375",
      "sourceShabadId": "9196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੇਖੀਅਤ ਸਬ ਪਾਪੀ ਨਹ ਹਰਿ ਜਾਪੀ ਤਦਿਪ ਮਹਾ ਰਿਸ ਠਾਨੈ ॥",
      "transliteration": "dhekheeat sab paapee neh har jaapee tadhip mahaa ris Thaanai ||",
      "translation": "The sinners will be seen on all sides, there will be no meditation on the Lord",
      "punjabiViakhya": "ਸਾਰੇ ਪਾਪੀ ਦਿਖਣਗੇ, (ਕੋਈ ਵੀ) ਹਰਿ ਦਾ ਜਪ ਕਰਨ ਵਾਲਾ ਨਹੀਂ ਹੋਵੇਗਾ; ਤਾ ਵੀ ਬਹੁਤ ਕ੍ਰੋਧ ਧਾਰਨ ਕੀਤਾ ਹੋਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "देखीअत सब पापी नह हरि जापी तदिप महा रिस ठानै ॥",
      "sourceLineId": "98376",
      "sourceShabadId": "9196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਤਿ ਬਿਭਚਾਰੀ ਪਰਤ੍ਰਿਅ ਭਾਰੀ ਦੇਵ ਪਿਤ੍ਰ ਨਹੀ ਮਾਨੈ ॥",
      "transliteration": "at bibhachaaree paratria bhaaree dhev pitr nahee maanai ||",
      "translation": "Even then there will be great jealousy with one another those who go to the wives of others and commit sinful acts will have no beliefs in gods and manes",
      "punjabiViakhya": "(ਸਭ) ਅਤਿ ਵਿਭਚਾਰੀ ਹੋਣਗੇ, ਪਰ ਇਸਤਰੀਆਂ ਨੂੰ ਭੋਗਣ ਵਾਲੇ ਹੋਣਗੇ ਅਤੇ ਦੇਵਤੇ ਤੇ ਪਿਤਰਾ ਨੂੰ ਨਹੀਂ ਮੰਨਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "अति बिभचारी परतृअ भारी देव पित्र नही मानै ॥",
      "sourceLineId": "98377",
      "sourceShabadId": "9196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਦਿਪ ਮਹਾ ਬਰ ਕਹਤੇ ਧਰਮ ਧਰ ਪਾਪ ਕਰਮ ਅਧਿਕਾਰੀ ॥",
      "transliteration": "tadhip mahaa bar kahate dharam dhar paap karam adhikaaree ||",
      "translation": "Even then the sinners will remain religious leader",
      "punjabiViakhya": "ਤਦ ਵੀ (ਆਪਣੇ ਆਪ ਨੂੰ) ਸ੍ਰੇਸ਼ਠ ਧਰਮ-ਧਾਰੀ ਕਹਿਣਗੇ ਪਰ ਪਾਪ ਕਰਮ ਕਰਨ ਦੇ ਅਧਿਕਾਰੀ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "तदिप महा बर कहते धरम धर पाप करम अधिकारी ॥",
      "sourceLineId": "98378",
      "sourceShabadId": "9196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਧ੍ਰਿਗ ਧ੍ਰਿਗ ਸਭ ਆਖੈ ਮੁਖ ਪਰ ਨਹੀ ਭਾਖੈ ਦੇਹਿ ਪ੍ਰਿਸਟ ਚੜਿ ਗਾਰੀ ॥੯੨॥",
      "transliteration": "dhirag dhirag sabh aakhai mukh par nahee bhaakhai dheh pirasaT chaR gaaree ||92||",
      "translation": "None will talk on the face, but slander others at the back.92.",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਧ੍ਰਿਗ ਧ੍ਰਿਗ ਕਹਿਣਗੇ, ਪਰ ਮੁਖ ਸਾਹਮਣੇ ਕੁਝ ਨਹੀਂ ਕਹਿਣਗੇ, ਪਰ ਪਿਠ ਪਿਛੇ ਗਾਲ੍ਰਹਾ ਦੇਣਗੇ ॥੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "धृग धृग सभ आखै मुख पर नही भाखै देहि पृसट चड़ि गारी ॥९२॥",
      "sourceLineId": "98379",
      "sourceShabadId": "9196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦੇਖੀਅਤ ਬਿਨ ਕਰਮੰ ਤਜ ਕੁਲ ਧਰਮੰ ਤਦਿਪ ਕਹਾਤ ਸੁ ਮਾਨਸ ॥",
      "transliteration": "dhekheeat bin karama(n) taj kul dharama(n) tadhip kahaat su maanas ||",
      "translation": "Without doing good work and forsaking the traditional religion of the clan, the people even then will be called good persons",
      "punjabiViakhya": "ਕਰਮਾ ਤੋਂ ਬਿਨਾ ਵੇਖੇ ਜਾਣਗੇ, ਕੁਲ ਧਰਮ ਨੂੰ ਛਡ ਦੇਣਗੇ, ਪਰ ਫਿਰ ਵੀ (ਆਪਣੇ ਆਪ ਨੂੰ) ਮਨੁੱਖ ਅਖਵਾਉਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "देखीअत बिन करमं तज कुल धरमं तदिप कहात सु मानस ॥",
      "sourceLineId": "98380",
      "sourceShabadId": "9196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਤਿ ਰਤਿ ਲੋਭੰ ਰਹਤ ਸਛੋਭੰ ਲੋਕ ਸਗਲ ਭਲੁ ਜਾਨਸ ॥",
      "transliteration": "at rat lobha(n) rahat sachhobha(n) lok sagal bhal jaanas ||",
      "translation": "The people will consider those persons good, who will always remain anxious, coveting in their mind for the sexual enjoyment",
      "punjabiViakhya": "ਲੋਭ ਵਿਚ ਬਹੁਤ ਲੀਨ ਹੋਣਗੇ, ਕ੍ਰੋਧ ਨਾਲ (ਭਰੇ) ਰਹਿਣਗੇ, ਪਰ ਸਾਰੇ ਲੋਕ (ਉਨ੍ਰਹਾ ਨੂੰ) ਭਲੇ ਪੁਰਸ਼ ਮੰਨਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "अति रति लोभं रहत सछोभं लोक सगल भलु जानस ॥",
      "sourceLineId": "98381",
      "sourceShabadId": "9196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਦਿਪ ਬਿਨਾ ਗਤਿ ਚਲਤ ਬੁਰੀ ਮਤਿ ਲੋਭ ਮੋਹ ਬਸਿ ਭਾਰੀ ॥",
      "transliteration": "tadhip binaa gat chalat buree mat lobh moh bas bhaaree ||",
      "translation": "The people will follow the vicious doctrines under the impact of great greed and attachment",
      "punjabiViakhya": "ਤਾ ਵੀ ਬਿਨਾ ਕਿਸੇ ਮਰਯਾਦਾ ਬੁਰੀ ਚਾਲ ਚਲਣਗੇ ਅਤੇ ਲੋਭ ਮੋਹ ਦੇ ਬਹੁਤ ਵਸ ਵਿਚ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "तदिप बिना गति चलत बुरी मति लोभ मोह बसि भारी ॥",
      "sourceLineId": "98382",
      "sourceShabadId": "9196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪਿਤ ਮਾਤ ਨ ਮਾਨੈ ਕਛੂ ਨ ਜਾਨੈ ਲੈਹ ਘਰਣ ਤੇ ਗਾਰੀ ॥੯੩॥",
      "transliteration": "pit maat na maanai kachhoo na jaanai laih gharan te gaaree ||93||",
      "translation": "They will have no love for their parents and will be rebuked by their wives.93.",
      "punjabiViakhya": "ਮਾਤਾ ਪਿਤਾ ਨੂੰ ਨਹੀਂ ਮੰਨਣਗੇ, (ਉਨ੍ਰਹਾ ਨੂੰ) ਕੁਝ ਵੀ ਨਹੀਂ ਸਮਝਣਗੇ ਅਤੇ ਘਰ ਵਾਲੀਆਂ ਤੋਂ ਗਾਲ੍ਰਹੀਆਂ ਲੈਣਗੇ ॥੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "पित मात न मानै कछू न जानै लैह घरण ते गारी ॥९३॥",
      "sourceLineId": "98383",
      "sourceShabadId": "9196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦੇਖਅਤ ਜੇ ਧਰਮੀ ਤੇ ਭਏ ਅਕਰਮੀ ਤਦਿਪ ਕਹਾਤ ਮਹਾ ਮਤਿ ॥",
      "transliteration": "dhekhat je dharamee te bhe akaramee tadhip kahaat mahaa mat ||",
      "translation": "The pious ones will be seen performing bad acts and even then they would like to be called good ones",
      "punjabiViakhya": "ਜਿਹੜੇ ਧਰਮੀ ਦਿਸਦੇ ਹੋਣਗੇ, ਉਹ ਕਰਮ-ਹੀਨ ਹੋਣਗੇ, ਪਰ ਫਿਰ ਵੀ (ਆਪਣੇ ਆਪ ਨੂੰ) ਮਹਾ ਪੁਰਸ਼ ਅਖਵਾਉਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "देखअत जे धरमी ते भए अकरमी तदिप कहात महा मति ॥",
      "sourceLineId": "98384",
      "sourceShabadId": "9196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਤਿ ਬਸ ਨਾਰੀ ਅਬਗਤਿ ਭਾਰੀ ਜਾਨਤ ਸਕਲ ਬਿਨਾ ਜਤ ॥",
      "transliteration": "at bas naaree abagat bhaaree jaanat sakal binaa jat ||",
      "translation": "All of them will be under the impact of their women and remaining without restraint, they will be in decadence",
      "punjabiViakhya": "ਇਸਤਰੀਆਂ ਦੇ ਬਹੁਤ ਵਸ ਵਿਚ ਹੋਣਗੇ, ਬਹੁਤ ਖੁਆਰੀ ਹੋਵੇਗੀ ਅਤੇ ਸਾਰੇ ਬਿਨਾ ਜੱਤ (ਸੱਤ) ਦੇ ਹੋ ਜਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "अति बस नारी अबगति भारी जानत सकल बिना जत ॥",
      "sourceLineId": "98385",
      "sourceShabadId": "9196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਦਿਪ ਨ ਮਾਨਤ ਕੁਮਤਿ ਪ੍ਰਠਾਨਤ ਮਤਿ ਅਰੁ ਗਤਿ ਕੇ ਕਾਚੇ ॥",
      "transliteration": "tadhip na maanat kumat praThaanat mat ar gat ke kaache ||",
      "translation": "Even then, the people without intellect, will not shirk from the performance of bad karmas",
      "punjabiViakhya": "ਤਦ ਵੀ ਮੰਨਣਗੇ ਨਹੀਂ, ਖੋਟੀ ਮਤ ਦਾ ਪ੍ਰਚਾਰ ਕਰਨਗੇ ਅਤੇ ਬੁੱਧੀ ਤੇ ਮਰਯਾਦਾ ਦੇ ਕੱਚੇ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "तदिप न मानत कुमति प्रठानत मति अरु गति के काचे ॥",
      "sourceLineId": "98386",
      "sourceShabadId": "9196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਿਹ ਤਿਹ ਘਰਿ ਡੋਲਤ ਭਲੇ ਨ ਬੋਲਤ ਲੋਗ ਲਾਜ ਤਜਿ ਨਾਚੇ ॥੯੪॥",
      "transliteration": "jeh teh ghar ddolat bhale na bolat log laaj taj naache ||94||",
      "translation": "They will roam here and there uttering uncivilized words and will also dance unashamedly.94.",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਘਰਾ ਵਿਚ ਡੋਲਣਗੇ, ਚੰਗਾ ਨਹੀਂ ਬੋਲਣਗੇ ਅਤੇ ਲੋਕ-ਲਾਜ ਨੂੰ ਛਡ ਕੇ ਨੱਚਣਗੇ ॥੯੪॥",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "जिह तिह घरि डोलत भले न बोलत लोग लाज तजि नाचे ॥९४॥",
      "sourceLineId": "98387",
      "sourceShabadId": "9196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਿਲਕਾ ਛੰਦ ॥",
      "transliteration": "kilakaa chha(n)dh ||",
      "translation": "KILKA STANZA",
      "punjabiViakhya": "ਕਿਲਕਾ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "किलका छंद ॥",
      "sourceLineId": "98388",
      "sourceShabadId": "9197",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪਾਪ ਕਰੈ ਨਿਤ ਪ੍ਰਾਤਿ ਘਨੇ ॥",
      "transliteration": "paap karai nit praat ghane ||",
      "translation": "",
      "punjabiViakhya": "ਨਿਤ ਸਵੇਰੇ ਬਹੁਤ ਪਾਪ ਕਰਨਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "पाप करै नित प्राति घने ॥",
      "sourceLineId": "98389",
      "sourceShabadId": "9197",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਨੁ ਦੋਖਨ ਕੇ ਤਰੁ ਸੁਧ ਬਨੇ ॥",
      "transliteration": "jan dhokhan ke tar sudh bane ||",
      "translation": "They will commit new sins and talking about the blemishes of others, they themselves will remain pure",
      "punjabiViakhya": "ਮਾਨੋ ਦੋਖਾ (ਔਗੁਣਾ) ਦੇ ਸ਼ੁੱਧ ਬ੍ਰਿਛ ਬਣੇ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "जनु दोखन के तरु सुध बने ॥",
      "sourceLineId": "98390",
      "sourceShabadId": "9197",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਗ ਛੋਰਿ ਭਜਾ ਗਤਿ ਧਰਮਣ ਕੀ ॥",
      "transliteration": "jag chhor bhajaa gat dharaman kee ||",
      "translation": "",
      "punjabiViakhya": "ਜਗਤ ਧਰਮਾ ਦੀ ਮਰਯਾਦਾ ਨੂੰ ਛਡ ਕੇ ਭਜੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "जग छोरि भजा गति धरमण की ॥",
      "sourceLineId": "98391",
      "sourceShabadId": "9197",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੁ ਜਹਾ ਤਹਾ ਪਾਪ ਕ੍ਰਿਆ ਪ੍ਰਚੁਰੀ ॥੯੫॥",
      "transliteration": "s jahaa tahaa paap kriaa prachuree ||95||",
      "translation": "The followers of the religions, will forsake the world and run away and there will be the propagation of the sinful activities here and there.95.",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਪਾਪ ਦੀ ਬਹੁਤ ਅਧਿਕ ਕਾਰਵਾਈ ਪਸਰ ਜਾਏਗੀ ॥੯੫॥",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "सु जहा तहा पाप कृआ प्रचुरी ॥९५॥",
      "sourceLineId": "98392",
      "sourceShabadId": "9197",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੰਗ ਲਏ ਫਿਰੈ ਪਾਪਨ ਹੀ ॥",
      "transliteration": "sa(n)g le firai paapan hee ||",
      "translation": "",
      "punjabiViakhya": "ਪਾਪਾ ਨੂੰ ਨਾਲ ਹੀ ਲਈ ਫਿਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "संग लए फिरै पापन ही ॥",
      "sourceLineId": "98393",
      "sourceShabadId": "9197",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਜਿ ਭਾਜ ਕ੍ਰਿਆ ਜਗ ਜਾਪਨ ਕੀ ॥",
      "transliteration": "taj bhaaj kriaa jag jaapan kee ||",
      "translation": "All of them will roam, committing sinful acts and the activites of recitation and worship will flee from the world",
      "punjabiViakhya": "ਜਗਤ ਤੋਂ ਜੱਪਾ ਦੀ ਕ੍ਰਿਆ ਭਜ ਜਾਏਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "तजि भाज कृआ जग जापन की ॥",
      "sourceLineId": "98394",
      "sourceShabadId": "9197",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦੇਵ ਪਿਤ੍ਰ ਨ ਪਾਵਕ ਮਾਨਹਿਗੇ ॥",
      "transliteration": "dhev pitr na paavak maanahige ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤਿਆਂ, ਪਿਤਰਾ ਅਤੇ ਅਗਨੀ (ਦੇਵਤਾ) ਨੂੰ ਨਹੀਂ ਮੰਨਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "देव पित्र न पावक मानहिगे ॥",
      "sourceLineId": "98395",
      "sourceShabadId": "9197",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਭ ਆਪਨ ਤੇ ਘਟਿ ਜਾਨਹਿਗੇ ॥੯੬॥",
      "transliteration": "sabh aapan te ghaT jaanahige ||96||",
      "translation": "They will not have any faith in gods and manes and will consider all others inferior to them.96.",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਆਪਣੇ ਤੋਂ ਘਟ ਜਾਣਨਗੇ ॥੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "सभ आपन ते घटि जानहिगे ॥९६॥",
      "sourceLineId": "98396",
      "sourceShabadId": "9197",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਧੁਭਾਰ ਛੰਦ ॥",
      "transliteration": "madhubhaar chha(n)dh ||",
      "translation": "MADHUBHAAR STANZA",
      "punjabiViakhya": "ਮਧੁਭਾਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "मधुभार छंद ॥",
      "sourceLineId": "98397",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਜਿਓ ਸੁ ਧਰਮ ॥",
      "transliteration": "bhajio su dharam ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਮ ਭਜ ਜਾਏਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "भजिओ सु धरम ॥",
      "sourceLineId": "98398",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪ੍ਰਚੁਰਿਓ ਕੁਕਰਮ ॥",
      "transliteration": "prachurio kukaram ||",
      "translation": "The dharma will run away and there will be propagation of evil Karmas",
      "punjabiViakhya": "ਕੁਕਰਮ ਬਹੁਤ ਪਸਰ ਜਾਏਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "प्रचुरिओ कुकरम ॥",
      "sourceLineId": "98399",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਹ ਤਹ ਜਹਾਨ ॥",
      "transliteration": "jeh teh jahaan ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਜਗਤ ਵਿਚ ਅਣਖ ('ਆਨਿ')",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "जह तह जहान ॥",
      "sourceLineId": "98400",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਜਿ ਭਾਜ ਆਨਿ ॥੯੭॥",
      "transliteration": "taj bhaaj aan ||97||",
      "translation": "There will not remain any propriety of conduct in the world.97.",
      "punjabiViakhya": "ਛਡ ਕੇ ਭਜ ਜਾਏਗੀ ॥੯੭॥",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "तजि भाज आनि ॥९७॥",
      "sourceLineId": "98401",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਿਤਪ੍ਰਤਿ ਅਨਰਥ ॥",
      "transliteration": "nitaprat anarath ||",
      "translation": "",
      "punjabiViakhya": "ਸਮਰਥ ਲੋਗ ਨਿੱਤ-ਪ੍ਰਤਿ",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "नितप्रति अनरथ ॥",
      "sourceLineId": "98402",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਰ ਹੈ ਸਮਰਥ ॥",
      "transliteration": "kar hai samarath ||",
      "translation": "",
      "punjabiViakhya": "ਅਨਰਥ ਕਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "कर है समरथ ॥",
      "sourceLineId": "98403",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਉਠਿ ਭਾਜ ਧਰਮ ॥",
      "transliteration": "auTh bhaaj dharam ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਮ ਚੰਗੇ ਕਰਮਾ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "उठि भाज धरम ॥",
      "sourceLineId": "98404",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਲੈ ਸੰਗਿ ਸੁਕਰਮ ॥੯੮॥",
      "transliteration": "lai sa(n)g sukaram ||98||",
      "translation": "The powerful people will always commit bad deeds and the dharma will flee alongwith goods acts.98.",
      "punjabiViakhya": "ਨਾਲ ਲੈ ਕੇ ਭਜ ਜਾਏਗਾ ॥੯੮॥",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "लै संगि सुकरम ॥९८॥",
      "sourceLineId": "98405",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਰ ਹੈ ਕੁਚਾਰ ॥",
      "transliteration": "kar hai kuchaar ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੁਭ ਆਚਾਰ ਛਡ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "कर है कुचार ॥",
      "sourceLineId": "98406",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਜਿ ਸੁਭ ਅਚਾਰ ॥",
      "transliteration": "taj subh achaar ||",
      "translation": "",
      "punjabiViakhya": "ਮਾੜਾ ਕੰਮ ਕਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "तजि सुभ अचार ॥",
      "sourceLineId": "98407",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭਈ ਕ੍ਰਿਆ ਅਉਰ ॥",
      "transliteration": "bhiee kriaa aaur ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਥਾਵਾ ਤੇ ਹੋਰ ਹੀ",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "भई कृआ अउर ॥",
      "sourceLineId": "98408",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0560_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਬ ਠੌਰ ਠੌਰ ॥੯੯॥",
      "transliteration": "sab Thauar Thauar ||99||",
      "translation": "Forsaking good character, all will be absorbed in bad conduct and wonderful activities will become apparent at several places.99.",
      "punjabiViakhya": "ਕ੍ਰਿਆ ਹੋ ਜਾਏਗੀ ॥੯੯॥",
      "source": "DASAM_GRANTH",
      "ang": 560,
      "hindi": "",
      "hindiTransliteration": "सब ठौर ठौर ॥९९॥",
      "sourceLineId": "98409",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
