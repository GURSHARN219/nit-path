{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 561,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0561_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪ੍ਰੇਰਤਿ ਅਨੰਗ ॥",
      "transliteration": "prerat ana(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਆਪਣੀ ਇਸਤਰੀ ਨਾਲ) ਸੰਯੋਗ ਨਹੀਂ ਕਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "प्रेरति अनंग ॥",
      "sourceLineId": "98411",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਰਿ ਸੁਤਾ ਭੋਗ ॥",
      "transliteration": "kar sutaa bhog ||",
      "translation": "",
      "punjabiViakhya": "ਪੁੱਤਰੀ ਨਾਲ ਭੋਗ ਕਰਨਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "करि सुता भोग ॥",
      "sourceLineId": "98412",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜੋ ਹੈ ਅਜੋਗ ॥੧੦੦॥",
      "transliteration": "jo hai ajog ||100||",
      "translation": "Not absorbing themselves with the sexual enjoyment with their wives, they will have sexual relations with these unbecoming daughter.100.",
      "punjabiViakhya": "ਜੋ ਅਯੋਗ ਹੈ ॥੧੦੦॥",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "जो है अजोग ॥१००॥",
      "sourceLineId": "98413",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਜਿ ਲਾਜ ਭਾਜ ॥",
      "transliteration": "taj laaj bhaaj ||",
      "translation": "",
      "punjabiViakhya": "ਸਮਾਜ ਸਹਿਤ ਲਾਜ-ਮਰਯਾਦਾ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "तजि लाज भाज ॥",
      "sourceLineId": "98414",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੰਜੁਤ ਸਮਾਜ ॥",
      "transliteration": "sa(n)jut samaaj ||",
      "translation": "The whole society will be on the run for the abandonment of shame",
      "punjabiViakhya": "ਛਡ ਕੇ ਭੱਜ ਜਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "संजुत समाज ॥",
      "sourceLineId": "98415",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਘਟ ਚਲਾ ਧਰਮ ॥",
      "transliteration": "ghaT chalaa dharam ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਮ ਘਟ ਜਾਏਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "घट चला धरम ॥",
      "sourceLineId": "98416",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਢਿਓ ਅਧਰਮ ॥੧੦੧॥",
      "transliteration": "baddio adharam ||101||",
      "translation": "Adharma will increase and dharma will decrease.101.",
      "punjabiViakhya": "ਅਤੇ ਅਧਰਮ ਵਧ ਜਾਏਗਾ ॥੧੦੧॥",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "बढिओ अधरम ॥१०१॥",
      "sourceLineId": "98417",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕ੍ਰੀੜਤ ਕੁਨਾਰਿ ॥",
      "transliteration": "kreeRat kunaar ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਮ-ਇਸਤਰੀਆਂ ਨੂੰ ਛਡ ਕੇ ਮਾੜੀਆਂ ਇਸਤਰੀਆਂ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "क्रीड़त कुनारि ॥",
      "sourceLineId": "98418",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਜਿ ਧਰਮ ਵਾਰਿ ॥",
      "transliteration": "taj dharam vaar ||",
      "translation": "Forsaking dharma, the people will have sexual enjoyment with the prostitutes",
      "punjabiViakhya": "ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "तजि धरम वारि ॥",
      "sourceLineId": "98419",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਢਿ ਗਯੋ ਭਰਮ ॥",
      "transliteration": "badd gayo bharam ||",
      "translation": "",
      "punjabiViakhya": "ਭਰਮ ਵਧ ਜਾਵੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "बढि गयो भरम ॥",
      "sourceLineId": "98420",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭਾਜੰਤ ਧਰਮ ॥੧੦੨॥",
      "transliteration": "bhaaja(n)t dharam ||102||",
      "translation": "The illusions will increase and the dharma will run away.102.",
      "punjabiViakhya": "ਅਤੇ ਧਰਮ ਭੱਜ ਜਾਵੇਗਾ ॥੧੦੨॥",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "भाजंत धरम ॥१०२॥",
      "sourceLineId": "98421",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦੇਸਨ ਬਿਦੇਸ ॥",
      "transliteration": "dhesan bidhes ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਸਾ ਬਿਦੇਸਾ ਵਿਚ",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "देसन बिदेस ॥",
      "sourceLineId": "98422",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪਾਪੀ ਨਰੇਸ ॥",
      "transliteration": "paapee nares ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਪਾਪੀ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "पापी नरेस ॥",
      "sourceLineId": "98423",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਧਰਮੀ ਨ ਕੋਇ ॥",
      "transliteration": "dharamee na koi ||",
      "translation": "",
      "punjabiViakhya": "ਕੋਈ ਧਰਮੀ (ਵਿਅਕਤੀ) ਨਹੀਂ ਹੋਏਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "धरमी न कोइ ॥",
      "sourceLineId": "98424",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪਾਪ ਅਤਿ ਹੋਇ ॥੧੦੩॥",
      "transliteration": "paap at hoi ||103||",
      "translation": "In all the countries, amongst the sinful kings, no follower of dharma will be left.103.",
      "punjabiViakhya": "ਬਹੁਤ ਅਧਿਕ ਪਾਪ ਹੋਣਗੇ ॥੧੦੩॥",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "पाप अति होइ ॥१०३॥",
      "sourceLineId": "98425",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਾਧੂ ਸਤ੍ਰਾਸ ॥",
      "transliteration": "saadhoo satraas ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਧੂ ਡਰਦੇ ਮਾਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "साधू सत्रास ॥",
      "sourceLineId": "98426",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਹ ਤਹ ਉਦਾਸ ॥",
      "transliteration": "jeh teh udhaas ||",
      "translation": "The saints, in their fear, will be seen in depression here and there",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਉਦਾਸ ਰਹਿਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "जह तह उदास ॥",
      "sourceLineId": "98427",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪਾਪੀਨ ਰਾਜ ॥",
      "transliteration": "paapeen raaj ||",
      "translation": "",
      "punjabiViakhya": "ਪਾਪੀਆਂ ਦਾ ਰਾਜ ਹੋਵੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "पापीन राज ॥",
      "sourceLineId": "98428",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗ੍ਰਿਹ ਸਰਬ ਸਾਜ ॥੧੦੪॥",
      "transliteration": "gireh sarab saaj ||104||",
      "translation": "The sin will reign in all the houses.104.",
      "punjabiViakhya": "(ਅਤੇ ਉਨ੍ਰਹਾ ਦੇ) ਘਰਾ ਵਿਚ ਸਭ ਤਰ੍ਰਹਾ ਦੀ ਸਾਜ-ਸਜਾਵਟ ਹੋਵੇਗੀ ॥੧੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "गृह सरब साज ॥१०४॥",
      "sourceLineId": "98429",
      "sourceShabadId": "9198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹਰਿ ਗੀਤਾ ਛੰਦ ॥",
      "transliteration": "har geetaa chha(n)dh ||",
      "translation": "HARIGEETA STANZA",
      "punjabiViakhya": "ਹਰਿ ਗੀਤਾ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "हरि गीता छंद ॥",
      "sourceLineId": "98430",
      "sourceShabadId": "9199",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਬ ਦ੍ਰੋਨ ਗਿਰਵਰ ਸਿਖਰ ਤਰ ਨਰ ਪਾਪ ਕਰਮ ਭਏ ਭਨੌ ॥",
      "transliteration": "sab dhron giravar sikhar tar nar paap karam bhe bhanau ||",
      "translation": "Somewhere there will be very great sins like the top of Dronagiri mountain",
      "punjabiViakhya": "ਦ੍ਰੋਣ ਪਰਬਤ ਦੇ ਹੇਠੋਂ ਤੋਂ ਲੈ ਕੇ ਧੁਰ ਚੋਟੀ ਤਕ ਸਾਰੇ ਪੁਰਸ਼ ਪਾਪ ਕਰਮ ਵਿਚ ਲੀਨ ਦਸੇ ਜਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "सब द्रोन गिरवर सिखर तर नर पाप करम भए भनौ ॥",
      "sourceLineId": "98431",
      "sourceShabadId": "9199",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਉਠਿ ਭਾਜ ਧਰਮ ਸਭਰਮ ਹੁਐ ਚਮਕੰਤ ਦਾਮਿਨਿ ਸੋ ਮਨੌ ॥",
      "transliteration": "auTh bhaaj dharam sabharam huaai chamaka(n)t dhaamin so manau ||",
      "translation": "All the people will abandon dharma and live in the flashing lighting of illusion",
      "punjabiViakhya": "ਧਰਮ ਉਠ ਕੇ ਭਜ ਜਾਵੇਗਾ ਅਤੇ ਭਰਮ ਮਾਨੋ ਬਿਜਲੀ ਬਣ ਕੇ ਚਮਕੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "उठि भाज धरम सभरम हुऐ चमकंत दामिनि सो मनौ ॥",
      "sourceLineId": "98432",
      "sourceShabadId": "9199",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਿਧੌ ਸੂਦ੍ਰ ਸੁਭਟ ਸਮਾਜ ਸੰਜੁਤ ਜੀਤ ਹੈ ਬਸੁਧਾ ਥਲੀ ॥",
      "transliteration": "kidhau soodhr subhaT samaaj sa(n)jut jeet hai basudhaa thalee ||",
      "translation": "Somewhere the Shudras, bedecked with warriors will conquer the earth and somewhere the Kshatriyas, forsaking the weapons and arms, will be running hither and thither",
      "punjabiViakhya": "ਜਾ ਸ਼ੂਦ੍ਰਾ ਨੇ ਸੂਰਮਿਆਂ ਦੇ ਸਮਾਜ ਸਮੇਤ ਧਰਤੀ ਨੂੰ ਬਲ ਪੂਰਵਕ ਜਿਤ ਲਿਆ ਹੋਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "किधौ सूद्र सुभट समाज संजुत जीत है बसुधा थली ॥",
      "sourceLineId": "98433",
      "sourceShabadId": "9199",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0561_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਿਧੌ ਅਤ੍ਰ ਛਤ੍ਰ ਤਜੇ ਭਜੇ ਅਰੁ ਅਉਰ ਅਉਰ ਕ੍ਰਿਆ ਚਲੀ ॥੧੦੫॥",
      "transliteration": "kidhau atr chhatr taje bhaje ar aaur aaur kriaa chalee ||105||",
      "translation": "There will be the prevalence of different types of activities.105.",
      "punjabiViakhya": "ਜਾ (ਸਾਰੇ ਰਾਜੇ) ਅਸਤ੍ਰ ਅਤੇ ਛਤ੍ਰ ਛਡ ਕੇ ਭਜ ਗਏ ਹੋਣਗੇ ਅਤੇ ਹੋਰ ਦੀ ਹੋਰ ਕ੍ਰਿਆ ਚਲ ਪਈ ਹੋਵੇਗੀ ॥੧੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 561,
      "hindi": "",
      "hindiTransliteration": "किधौ अत्र छत्र तजे भजे अरु अउर अउर कृआ चली ॥१०५॥",
      "sourceLineId": "98434",
      "sourceShabadId": "9199",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
