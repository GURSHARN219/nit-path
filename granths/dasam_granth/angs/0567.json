{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 567,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0567_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਹੂੰ ਨ ਚਰਚਾ ॥੧੬੦॥",
      "transliteration": "kahoo(n) na charachaa ||160||",
      "translation": "Even after searching in every home, no worship and prayer and no discussion on Vedas will be seen or heard.160.",
      "punjabiViakhya": "ਅਤੇ ਨਾ ਹੀ (ਹਰਿ ਨਾਮ ਦੀ) ਚਰਚਾ ਹੋਵੇਗੀ ॥੧੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "कहूँ न चरचा ॥१६०॥",
      "sourceLineId": "98651",
      "sourceShabadId": "9214",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਧੁਭਾਰ ਛੰਦ ॥",
      "transliteration": "madhubhaar chha(n)dh ||",
      "translation": "MADHUBHAAR STANZA",
      "punjabiViakhya": "ਮਧੁਭਾਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "मधुभार छंद ॥",
      "sourceLineId": "98652",
      "sourceShabadId": "9215",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਬ ਦੇਸ ਢਾਲ ॥",
      "transliteration": "sab dhes ddaal ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਦੇਸਾ ਦਾ ਇਹੀ ਚਲਨ ਹੋਵੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "सब देस ढाल ॥",
      "sourceLineId": "98653",
      "sourceShabadId": "9215",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਹ ਤਹ ਕੁਚਾਲ ॥",
      "transliteration": "jeh teh kuchaal ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਕੁਰੀਤਾ ਹੋਣਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "जह तह कुचाल ॥",
      "sourceLineId": "98654",
      "sourceShabadId": "9215",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਹ ਤਹ ਅਨਰਥ ॥",
      "transliteration": "jeh teh anarath ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਅਨਰਥ (ਹੋਵੇਗਾ)",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "जह तह अनरथ ॥",
      "sourceLineId": "98655",
      "sourceShabadId": "9215",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਹੀ ਹੋਤ ਅਰਥ ॥੧੬੧॥",
      "transliteration": "nahee hot arath ||161||",
      "translation": "The vicious conduct will be visible in all the countries and there be meaninglessness instead of meaningfulness everywhere.161.",
      "punjabiViakhya": "(ਕਿਤੇ ਵੀ) ਪੁਰਸ਼ਾਰਥ ਨਹੀਂ ਹੋਵੇਗਾ ॥੧੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "नही होत अरथ ॥१६१॥",
      "sourceLineId": "98656",
      "sourceShabadId": "9215",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਬ ਦੇਸ ਰਾਜ ॥",
      "transliteration": "sab dhes raaj ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਦੇਸਾ ਦੇ ਰਾਜੇ",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "सब देस राज ॥",
      "sourceLineId": "98657",
      "sourceShabadId": "9215",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਿਤਪ੍ਰਤਿ ਕੁਕਾਜ ॥",
      "transliteration": "nitaprat kukaaj ||",
      "translation": "",
      "punjabiViakhya": "ਨਿੱਤ ਪ੍ਰਤਿ ਮਾੜੇ ਕੰਮ ਕਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "नितप्रति कुकाज ॥",
      "sourceLineId": "98658",
      "sourceShabadId": "9215",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਹੀ ਹੋਤ ਨਿਆਇ ॥",
      "transliteration": "nahee hot niaai ||",
      "translation": "",
      "punjabiViakhya": "ਨਿਆਂ ਨਹੀਂ ਹੋਵੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "नही होत निआइ ॥",
      "sourceLineId": "98659",
      "sourceShabadId": "9215",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਹ ਤਹ ਅਨ੍ਯਾਇ ॥੧੬੨॥",
      "transliteration": "jeh teh anayai ||162||",
      "translation": "Evil action were committed throughout the country and everywhere there was injustice instead of justice.162.",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਅਨਿਆਂ ਹੋਵੇਗਾ ॥੧੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "जह तह अन्याइ ॥१६२॥",
      "sourceLineId": "98660",
      "sourceShabadId": "9215",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਛਿਤ ਭਈ ਸੁਦ੍ਰ ॥",
      "transliteration": "chhit bhiee sudhr ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ ਸ਼ੂਦ੍ਰ (ਰੁਚੀ ਵਾਲੀ) ਹੋ ਜਾਵੇਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "छित भई सुद्र ॥",
      "sourceLineId": "98661",
      "sourceShabadId": "9215",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕ੍ਰਿਤ ਕਰਤ ਛੁਦ੍ਰ ॥",
      "transliteration": "kirat karat chhudhr ||",
      "translation": "",
      "punjabiViakhya": "ਨੀਵੇਾਂ ਕਰਮ ਕਰਨ ਲਗੇਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "कृत करत छुद्र ॥",
      "sourceLineId": "98662",
      "sourceShabadId": "9215",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਹ ਬਿਪ੍ਰ ਏਕ ॥",
      "transliteration": "teh bipr ek ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਕ ਬ੍ਰਾਹਮਣ (ਹੋਵੇਗਾ)",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "तह बिप्र एक ॥",
      "sourceLineId": "98663",
      "sourceShabadId": "9215",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਿਹ ਗੁਨ ਅਨੇਕ ॥੧੬੩॥",
      "transliteration": "jeh gun anek ||163||",
      "translation": "All the people of the earth became Shudras and all were absorbed in base acts, there was only one Brahmin there who was full of virtues.163.",
      "punjabiViakhya": "ਜਿਸ ਵਿਚ ਅਨੇਕ ਗੁਣ ਹੋਣਗੇ ॥੧੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "जिह गुन अनेक ॥१६३॥",
      "sourceLineId": "98664",
      "sourceShabadId": "9215",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪਾਧਰੀ ਛੰਦ ॥",
      "transliteration": "paadharee chha(n)dh ||",
      "translation": "PAADHARI STANZA",
      "punjabiViakhya": "ਪਾਧਰੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "पाधरी छंद ॥",
      "sourceLineId": "98665",
      "sourceShabadId": "9216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਿਤ ਜਪਤ ਬਿਪ੍ਰ ਦੇਬੀ ਪ੍ਰਚੰਡ ॥",
      "transliteration": "nit japat bipr dhebee pracha(n)dd ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬ੍ਰਾਹਮਣ ਨਿੱਤ ਪ੍ਰਚੰਡ ਦੇਵੀ ਦਾ ਜਾਪ ਕਰਦਾ ਹੋਵੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "नित जपत बिप्र देबी प्रचंड ॥",
      "sourceLineId": "98666",
      "sourceShabadId": "9216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਿਹ ਕੀਨ ਧੂਮ੍ਰ ਲੋਚਨ ਦੁਖੰਡ ॥",
      "transliteration": "jeh keen dhoomr lochan dhukha(n)dd ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ (ਦੇਵੀ) ਨੇ ਧੂਮ੍ਰਲੋਚਨ ਦੇ ਦੋ ਖੰਡ ਕੀਤੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "जिह कीन धूम्र लोचन दुखंड ॥",
      "sourceLineId": "98667",
      "sourceShabadId": "9216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਿਹ ਕੀਨ ਦੇਵ ਦੇਵਿਸ ਸਹਾਇ ॥",
      "transliteration": "jeh keen dhev dhevis sahai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਦੇਵਤਿਆਂ ਅਤੇ ਦੇਵਰਾਜ (ਇੰਦਰ) ਦੀ ਮੱਦਦ ਕੀਤੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "जिह कीन देव देविस सहाइ ॥",
      "sourceLineId": "98668",
      "sourceShabadId": "9216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਿਹ ਲੀਨ ਰੁਦ੍ਰ ਕਰਿ ਬਚਾਇ ॥੧੬੪॥",
      "transliteration": "jeh leen rudhr kar bachai ||164||",
      "translation": "A Brahmin always worshipped that goddess, who had chopped the demon named Dhumarlochan into two parts, who had helped the gods and even saved Rudra.164.",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਹੱਥ ਦੇ ਕੇ ਸ਼ਿਵ ਨੂੰ ਬਚਾ ਲਿਆ ਸੀ ॥੧੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "जिह लीन रुद्र करि बचाइ ॥१६४॥",
      "sourceLineId": "98669",
      "sourceShabadId": "9216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਿਹ ਹਤੇ ਸੁੰਭ ਨੈਸੁੰਭ ਬੀਰ ॥",
      "transliteration": "jeh hate su(n)bh naisu(n)bh beer ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਸ਼ੁੰਭ ਅਤੇ ਨਿਸ਼ੁੰਭ (ਨਾ ਵਾਲੇ) ਸੂਰਮਿਆਂ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "जिह हते सुँभ नैसुँभ बीर ॥",
      "sourceLineId": "98670",
      "sourceShabadId": "9216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਿਨ ਜੀਤ ਇੰਦ੍ਰ ਕੀਨੋ ਫਕੀਰ ॥",
      "transliteration": "jin jeet i(n)dhr keeno fakeer ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ (ਦੈਂਤਾ) ਨੇ ਇੰਦਰ ਨੂੰ ਜਿਤ ਕੇ ਫ਼ਕੀਰ ਬਣਾ ਦਿੱਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "जिन जीत इंद्र कीनो फकीर ॥",
      "sourceLineId": "98671",
      "sourceShabadId": "9216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਿਨਿ ਗਹੀ ਸਰਨ ਜਗ ਮਾਤ ਜਾਇ ॥",
      "transliteration": "tin gahee saran jag maat jai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਇੰਦਰ) ਨੇ ਜਗ ਮਾਤ (ਦੇਵੀ) ਦੀ ਸ਼ਰਨ ਗ੍ਰਹਿਣ ਕੀਤੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "तिनि गही सरन जग मात जाइ ॥",
      "sourceLineId": "98672",
      "sourceShabadId": "9216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਿਹਿ ਕੀਅਸ ਚੰਡਿਕਾ ਦੇਵਰਾਇ ॥੧੬੫॥",
      "transliteration": "teh keeas cha(n)ddikaa dhevarai ||165||",
      "translation": "That goddess had destroyed Shumbh and Nishumbh, who had even conquered Indra and made him poor, Indra had taken refuge with the mother of the world, who had made him king of the gods again.165.",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਚੰਡਿਕਾ ਦੇਵੀ ਨੇ (ਫਿਰ) ਦੇਵਤਿਆਂ ਦਾ ਰਾਜਾ ਬਣਾ ਦਿੱਤਾ ਸੀ ॥੧੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "तिहि कीअस चंडिका देवराइ ॥१६५॥",
      "sourceLineId": "98673",
      "sourceShabadId": "9216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਿਹਿ ਜਪਤ ਰੈਣ ਦਿਨ ਦਿਜ ਉਦਾਰ ॥",
      "transliteration": "teh japat rain dhin dhij udhaar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਉਦਾਰ ਬ੍ਰਾਹਮਣ ਉਸ (ਦੇਵੀ) ਨੂੰ ਦਿਨ ਰਾਤ ਜਪਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "तिहि जपत रैण दिन दिज उदार ॥",
      "sourceLineId": "98674",
      "sourceShabadId": "9216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਿਹਿ ਹਣਿਓ ਰੋਸਿ ਰਣਿ ਬਾਸਵਾਰ ॥",
      "transliteration": "jeh hanio ros ran baasavaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਰਣ ਵਿਚ ਇੰਦਰ ਦੇ ਵੈਰੀ ('ਬਾਸਵਾਰ' ਮਹਿਖਾਸੁਰ) ਨੂੰ ਮਾਰਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "जिहि हणिओ रोसि रणि बासवार ॥",
      "sourceLineId": "98675",
      "sourceShabadId": "9216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗ੍ਰਿਹ ਹੁਤੀ ਤਾਸੁ ਇਸਤ੍ਰੀ ਕੁਚਾਰ ॥",
      "transliteration": "gireh hutee taas isatree kuchaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਬ੍ਰਾਹਮਣ) ਦੇ ਘਰ ਮਾੜੇ ਆਚਾਰ ਵਾਲੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "गृह हुती तासु इसत्री कुचार ॥",
      "sourceLineId": "98676",
      "sourceShabadId": "9216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਿਹ ਗਹਿਓ ਨਾਹ ਦਿਨ ਇਕ ਨਿਹਾਰਿ ॥੧੬੬॥",
      "transliteration": "teh gahio naeh dhin ik nihaar ||166||",
      "translation": "That Brahmin worshipped that goddess night and day, who in her fury had killed the demons of the nether-world, that Brahmin had a characterless (prostitute) wife in his home, one day she saw her husband performing the worship and offerings.166.",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਕ ਦਿਨ (ਆਪਣੇ) ਪਤੀ ਨੂੰ (ਦੇਵੀ ਦੀ ਪੂਜਾ ਕਰਦੇ ਹੋਇਆਂ) ਵੇਖ ਕੇ ਪਕੜ ਲਿਆ ॥੧੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "तिह गहिओ नाह दिन इक निहारि ॥१६६॥",
      "sourceLineId": "98677",
      "sourceShabadId": "9216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤ੍ਰੀਯੋ ਬਾਚ ਪਤਿ ਸੋ ॥",
      "transliteration": "treeyo baach pat so ||",
      "translation": "Speech of the wife addressed to the husband :",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਪਤੀ ਨੂੰ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "त्रीयो बाच पति सो ॥",
      "sourceLineId": "98678",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਿਹ ਕਾਜ ਮੂੜ ਸੇਵੰਤ ਦੇਵਿ ॥",
      "transliteration": "keh kaaj mooR seva(n)t dhev ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮੂਰਖ! ਤੂੰ ਕਿਸ ਕੰਮ ਲਈ ਦੇਵੀ ਦੀ ਪੂਜਾ ਕਰ ਰਿਹਾ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "किह काज मूड़ सेवंत देवि ॥",
      "sourceLineId": "98679",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਿਹ ਹੇਤ ਤਾਸੁ ਬੁਲਤ ਅਭੇਵਿ ॥",
      "transliteration": "keh het taas bulat abhev ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਕਿਸ ਵਾਸਤੇ 'ਅਭੇਵਿ' (ਜਿਸ ਦਾ ਭੇਦ ਨਾ ਪਾਇਆ ਜਾ ਸਕੇ) ਕਹਿੰਦਾ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "किह हेत तासु बुलत अभेवि ॥",
      "sourceLineId": "98680",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਿਹ ਕਾਰਣ ਵਾਹਿ ਪਗਿਆਨ ਪਰੰਤ ॥",
      "transliteration": "keh kaaran vaeh pagiaan para(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸ ਕਰ ਕੇ (ਤੂੰ) ਉਸ ਦੇ ਪੈਰਾ ਉਤੇ ਡਿਗਦਾ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "किह कारण वाहि पगिआन परंत ॥",
      "sourceLineId": "98681",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਿਮ ਜਾਨ ਬੂਝ ਦੋਜਖਿ ਗਿਰੰਤ ॥੧੬੭॥",
      "transliteration": "kim jaan boojh dhojakh gira(n)t ||167||",
      "translation": "”O fool! why are you worshipping the goddess and for what prupose you are uttering these mysterious mantras? Why are you falling at her feet and deliberately making an effort for going to hell?167.",
      "punjabiViakhya": "ਜਾਣ ਬੁਝ ਕੇ ਨਰਕ ਵਿਚ ਕਿਉਾਂ ਡਿਗਦਾ ਹੈਂ ॥੧੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "किम जान बूझ दोजखि गिरंत ॥१६७॥",
      "sourceLineId": "98682",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਿਹ ਕਾਜ ਮੂਰਖ ਤਿਹ ਜਪਤ ਜਾਪ ॥",
      "transliteration": "keh kaaj moorakh teh japat jaap ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮੂਰਖ! (ਤੂੰ) ਕਿਸ ਲਈ ਉਸ ਦਾ ਜਾਪ ਜਪਦਾ ਹੈਂ?",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "किह काज मूरख तिह जपत जाप ॥",
      "sourceLineId": "98683",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਹੀ ਡਰਤ ਤਉਨ ਕੋ ਥਪਤ ਥਾਪ ॥",
      "transliteration": "nahee ddarat taun ko thapat thaap ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸਥਾਪਨਾ ਕਰਦਿਆਂ (ਤੂੰ) ਡਰਦਾ ਨਹੀਂ।",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "नही डरत तउन को थपत थाप ॥",
      "sourceLineId": "98684",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕੈਹੋ ਪੁਕਾਰ ਰਾਜਾ ਸਮੀਪ ॥",
      "transliteration": "kaiho pukaar raajaa sameep ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਰਾਜੇ ਕੋਲ ਜਾ ਕੇ ਪੁਕਾਰ ਕਰਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "कैहो पुकार राजा समीप ॥",
      "sourceLineId": "98685",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦੈ ਹੈ ਨਿਕਾਰ ਤੁਹਿ ਬਾਧਿ ਦੀਪ ॥੧੬੮॥",
      "transliteration": "dhai hai nikaar tuh baadh dheep ||168||",
      "translation": "“O fool! for what purpose you are repeating her Name, and do you not have any fear while repeating her Name ? I shall tell the king about your worship and he will exile you after arresting you.”168.",
      "punjabiViakhya": "ਉਹ ਤੈਨੂੰ ਬੰਨ੍ਰਹ ਕੇ ਦੇਸ ਨਿਕਾਲਾ ਦੇ ਦੇਵੇਗਾ ॥੧੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "दै है निकार तुहि बाधि दीप ॥१६८॥",
      "sourceLineId": "98686",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਹੀ ਲਖਾ ਤਾਹਿ ਬ੍ਰਹਮਾ ਕੁਨਾਰਿ ॥",
      "transliteration": "nahee lakhaa taeh brahamaa kunaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮਾੜੀ ਇਸਤਰੀ ਨੇ ਬ੍ਰਾਹਮਣ (ਦੀ ਸ਼ਕਤੀ) ਨੂੰ ਨਹੀਂ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "नही लखा ताहि ब्रहमा कुनारि ॥",
      "sourceLineId": "98687",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਧਰਮਾਰਥ ਆਨਿ ਲਿਨੋ ਵਤਾਰ ॥",
      "transliteration": "dharamaarath aan lino vataar ||",
      "translation": "",
      "punjabiViakhya": "(ਕਾਲ ਪੁਰਖ ਨੇ) ਧਰਮ ਦੇ ਪ੍ਰਸਾਰ ਲਈ ਆਣ ਕੇ ਅਵਤਾਰ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "धरमारथ आनि लिनो वतार ॥",
      "sourceLineId": "98688",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੂਦ੍ਰੰ ਸਮਸਤ ਨਾਸਾਰਥ ਹੇਤੁ ॥",
      "transliteration": "soodhra(n) samasat naasaarath het ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਸ਼ੂਦ੍ਰਾ ਦੇ ਵਿਨਾਸ਼ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "सूद्रं समसत नासारथ हेतु ॥",
      "sourceLineId": "98689",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਲਕੀ ਵਤਾਰ ਕਰਬੇ ਸਚੇਤ ॥੧੬੯॥",
      "transliteration": "kalakee vataar karabe sachet ||169||",
      "translation": "That vile woman did not know that the Lord had incarnated Himself for the protection of the people with the wisdom of Shudras and for making the people cautious, the Lord had incarnated Himself as Kalki.169.",
      "punjabiViakhya": "ਅਤੇ (ਲੋਕਾ ਨੂੰ) ਸਚੇਤ ਕਰਨ ਲਈ ਕਲਕੀ ਅਵਤਾਰ ਲਿਆ ਹੈ ॥੧੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "कलकी वतार करबे सचेत ॥१६९॥",
      "sourceLineId": "98690",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਿਤ ਜਾਨਿ ਤਾਸੁ ਹਟਕਿਓ ਕੁਨਾਰਿ ॥",
      "transliteration": "hit jaan taas haTakio kunaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਹਿਤ ਜਾਣ ਕੇ (ਬ੍ਰਾਹਮਣ ਨੇ) ਮਾੜੀ ਇਸਤਰੀ ਨੂੰ ਰੋਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "हित जानि तासु हटकिओ कुनारि ॥",
      "sourceLineId": "98691",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਹੀ ਲੋਕ ਤ੍ਰਾਸ ਬੁਲੇ ਭਤਾਰ ॥",
      "transliteration": "nahee lok traas bule bhataar ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਲੋਕ ਡਰ ਤੋਂ ਪਤੀ ਬੋਲਿਆ ਨਹੀਂ।",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "नही लोक त्रास बुले भतार ॥",
      "sourceLineId": "98692",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਬ ਕੁੜ੍ਰਹੀ ਨਾਰਿ ਚਿਤ ਰੋਸ ਠਾਨਿ ॥",
      "transliteration": "tab kuRrahee naar chit ros Thaan ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਹ ਚਿਤ ਵਿਚ ਕ੍ਰੋਧ ਕਰ ਕੇ ਕੁੜ੍ਰਹਨ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "तब कुड़्रही नारि चित रोस ठानि ॥",
      "sourceLineId": "98693",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੰਭਲ ਨਰੇਸ ਤਨ ਕਹੀ ਆਨਿ ॥੧੭੦॥",
      "transliteration": "sa(n)bhal nares tan kahee aan ||170||",
      "translation": "He rebuked his wife, realizing her welfare and because of the fear of public discussion, the husband kept silent, on this, that woman got enraged and going before the king of the town of Sambhal, she related the whole episode.170.",
      "punjabiViakhya": "ਅਤੇ (ਅੰਤ ਵਿਚ ਉਸ ਨੇ) ਸੰਭਲ ਦੇ ਰਾਜੇ ਤਕ ਆ ਕੇ (ਸਾਰੀ ਗੱਲ) ਕਹਿ ਦਿੱਤੀ ॥੧੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "संभल नरेस तन कही आनि ॥१७०॥",
      "sourceLineId": "98694",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪੂਜੰਤ ਦੇਵ ਦੀਨੋ ਦਿਖਾਇ ॥",
      "transliteration": "pooja(n)t dhev dheeno dhikhai ||",
      "translation": "",
      "punjabiViakhya": "(ਪਤੀ ਦੁਆਰਾ) ਦੇਵੀ ਨੂੰ ਪੂਜਦਿਆਂ (ਰਾਜੇ ਨੂੰ) ਵਿਖਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "पूजंत देव दीनो दिखाइ ॥",
      "sourceLineId": "98695",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਿਹ ਗਹਾ ਕੋਪ ਕਰਿ ਸੂਦ੍ਰ ਰਾਇ ॥",
      "transliteration": "teh gahaa kop kar soodhr rai ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਸ਼ੂਦ੍ਰ ਰਾਜੇ ਨੇ ਕ੍ਰੋਧ ਕਰ ਕੇ ਉਸ ਨੂੰ ਪਕੜ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "तिह गहा कोप करि सूद्र राइ ॥",
      "sourceLineId": "98696",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗਹਿ ਤਾਹਿ ਅਧਿਕ ਦੀਨੀ ਸਜਾਇ ॥",
      "transliteration": "geh taeh adhik dheenee sajai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਪਕੜ ਕੇ ਬਹੁਤ ਸਜ਼ਾ ਦਿੱਤੀ (ਅਤੇ ਕਿਹਾ)",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "गहि ताहि अधिक दीनी सजाइ ॥",
      "sourceLineId": "98697",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0567_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕੈ ਹਨਤ ਤੋਹਿ ਕੈ ਜਪ ਨ ਮਾਇ ॥੧੭੧॥",
      "transliteration": "kai hanat toh kai jap na mai ||171||",
      "translation": "She showed the worshipping Brahmin to the king and the Shudra king getting infuriated, arrested him and giving him the hard punishment, the king said, “I shall kill you, or you abandon the worship of the goddess.”171.",
      "punjabiViakhya": "ਜਾ ਤਾ ਤੈਨੂੰ ਮਾਰ ਦਿਆਂਗਾ ਜਾ ਦੇਵੀ ਦੀ ਪੂਜਾ ਨਾ ਕਰ ॥੧੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 567,
      "hindi": "",
      "hindiTransliteration": "कै हनत तोहि कै जप न माइ ॥१७१॥",
      "sourceLineId": "98698",
      "sourceShabadId": "9217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
