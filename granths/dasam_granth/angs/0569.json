{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 569,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0569_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਹੀ ਕਰੋ ਚਿੰਤ ਚਿਤ ਮਾਝਿ ਏਕ ॥",
      "transliteration": "nahee karo chi(n)t chit maajh ek ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ ਕਿ ਹੇ ਬ੍ਰਾਹਮਣ!) ਮਨ ਵਿਚ ਇਕ ਵੀ ਚਿੰਤਾ ਨਾ ਕਰ,",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "नही करो चिंत चित माझि एक ॥",
      "sourceLineId": "98723",
      "sourceShabadId": "9219",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਵ ਹੇਤੁ ਸਤ੍ਰੁ ਹਨਿ ਹੈ ਅਨੇਕ ॥੧੭੭॥",
      "transliteration": "tav het satr han hai anek ||177||",
      "translation": "When the Brahmin mediated on KAL (death), then he appeared before him and said, “Do not worry in your mind, I shall kill many enemies for your sake.”177.",
      "punjabiViakhya": "ਤੇਰੀ (ਰਖਿਆ) ਲਈ ਅਨੇਕਾ ਵੈਰੀ ਮਾਰ ਦਿਆਂਗਾ ॥੧੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "तव हेतु सत्रु हनि है अनेक ॥१७७॥",
      "sourceLineId": "98724",
      "sourceShabadId": "9219",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਬ ਪਰੀ ਸੂੰਕ ਭੋਹਰ ਮਝਾਰ ॥",
      "transliteration": "tab paree soo(n)k bhohar majhaar ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਦੇਵਾਲੇ ਦੇ) ਭੋਰੇ ਵਿਚੋਂ ਇਕ ਧੁਨੀ (ਸੁਣਾਈ) ਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "तब परी सूँक भोहर मझार ॥",
      "sourceLineId": "98725",
      "sourceShabadId": "9219",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਉਪਜਿਓ ਆਨਿ ਕਲਕੀ ਵਤਾਰ ॥",
      "transliteration": "aupajio aan kalakee vataar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਲਕੀ ਅਵਤਾਰ ਪ੍ਰਗਟ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "उपजिओ आनि कलकी वतार ॥",
      "sourceLineId": "98726",
      "sourceShabadId": "9219",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਾੜ ਪ੍ਰਮਾਨੁ ਕਰਿ ਅਸਿ ਉਤੰਗ ॥",
      "transliteration": "taaR pramaan kar as uta(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਹੱਥ ਵਿਚ ਤਾੜ (ਬ੍ਰਿਛ) ਜਿਤਨੀ ਉੱਚੀ ਤਲਵਾਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "ताड़ प्रमानु करि असि उतंग ॥",
      "sourceLineId": "98727",
      "sourceShabadId": "9219",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤੁਰਕਛ ਸੁਵਛ ਤਾਜੀ ਸੁਰੰਗ ॥੧੭੮॥",
      "transliteration": "turakachh suvachh taajee sura(n)g ||178||",
      "translation": "Then a dreadful sound was heard from the basement of the temple and Kalki incarnation manifested Himself, he was long like the palm tree, He had bedecked His waist with quiver and he was riding on a beautiful horse.178.",
      "punjabiViakhya": "ਉਸ ਦੇ ਹੇਠਾ ਤੁਰਕਿਸਤਾਨ ਦਾ ਸੁੰਦਰ ਅਤੇ ਪਿਆਰਾ ਘੋੜਾ ਸੀ ॥੧੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "तुरकछ सुवछ ताजी सुरंग ॥१७८॥",
      "sourceLineId": "98728",
      "sourceShabadId": "9219",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਿਰਖੰਡੀ ਛੰਦ ॥",
      "transliteration": "sirakha(n)ddee chha(n)dh ||",
      "translation": "SIRKHANDI STANZA",
      "punjabiViakhya": "ਸਿਰਖੰਡੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "सिरखंडी छंद ॥",
      "sourceLineId": "98729",
      "sourceShabadId": "9220",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਵਜੇ ਨਾਦ ਸੁਰੰਗੀ ਧਗਾ ਘੋਰੀਆ ॥",
      "transliteration": "vaje naadh sura(n)gee dhagaa ghoreeaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਰੰਗ ਵਾਲੇ ਨਾਦ ਵਜੇ ਅਤੇ ਨਗਾਰਿਆਂ ਨੇ ਗੂੰਜ ਕੀਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "वजे नाद सुरंगी धगा घोरीआ ॥",
      "sourceLineId": "98730",
      "sourceShabadId": "9220",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਚੇ ਜਾਣ ਫਿਰੰਗੀ ਵਜੇ ਘੁੰਘਰੂ ॥",
      "transliteration": "nache jaan fira(n)gee vaje ghu(n)gharoo ||",
      "translation": "There was a loud sound and the heroic spirits began to dance tying small bells round the ankles",
      "punjabiViakhya": "ਮਾਨੋ ਯੁੱਧ ਵਿਚ ਫਿਰੰਗੀ ਨਚੇ ਹੋਣ ਅਤੇ ਘੁੰਘਰੂ ਵਜੇ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "नचे जाण फिरंगी वजे घुँघरू ॥",
      "sourceLineId": "98731",
      "sourceShabadId": "9220",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗਦਾ ਤ੍ਰਿਸੂਲ ਨਿਖੰਗੀ ਝੂਲਨ ਬੈਰਖਾ ॥",
      "transliteration": "gadhaa tirasool nikha(n)gee jhoolan bairakhaa ||",
      "translation": "",
      "punjabiViakhya": "ਗਦਾ, ਤ੍ਰਿਸ਼ੂਲ, ਭੱਥੇ ਅਤੇ ਬਰਛਿਆਂ ਦੇ ਝੰਡੇ ਝੁਲਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "गदा तृसूल निखंगी झूलन बैरखा ॥",
      "sourceLineId": "98732",
      "sourceShabadId": "9220",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਾਵਨ ਜਾਣ ਉਮੰਗੀ ਘਟਾ ਡਰਾਵਣੀ ॥੧੭੯॥",
      "transliteration": "saavan jaan uma(n)gee ghaTaa ddaraavanee ||179||",
      "translation": "The maces, tridents, quivers and lances swung and waved like the dark clouds of Sawan.179.",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਸਾਵਣ ਦੀਆਂ ਡਰਾਉਣੀਆਂ ਘਟਾਵਾ ਚੜ੍ਰਹ ਆਈਆਂ ਹੋਣ ॥੧੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "सावन जाण उमंगी घटा डरावणी ॥१७९॥",
      "sourceLineId": "98733",
      "sourceShabadId": "9220",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਾਣੇ ਅੰਗ ਭੁਜੰਗੀ ਸਾਵਲ ਸੋਹਣੇ ॥",
      "transliteration": "baane a(n)g bhuja(n)gee saaval sohane ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਰੀਰ ਉਤੇ ਕਾਲੇ ਸੱਪਾ ਵਰਗੇ ਬਾਣੇ ਧਾਰਨ ਕੀਤੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "बाणे अंग भुजंगी सावल सोहणे ॥",
      "sourceLineId": "98734",
      "sourceShabadId": "9220",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤ੍ਰੈ ਸੈ ਹਥ ਉਤੰਗੀ ਖੰਡਾ ਧੂਹਿਆ ॥",
      "transliteration": "trai sai hath uta(n)gee kha(n)ddaa dhoohiaa ||",
      "translation": "The army (with Kalki) had worn beautiful garments and that three hundred hands long-sized Kalki drew out his double-edged sword",
      "punjabiViakhya": "(ਕਲਕੀ ਨੇ) ਤਿੰਨ ਸੌ ਹੱਥ ਉੱਚਾ ਖੰਡਾ ਧੂਹਿਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "त्रै सै हथ उतंगी खंडा धूहिआ ॥",
      "sourceLineId": "98735",
      "sourceShabadId": "9220",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਾਜੀ ਭਉਰ ਪਿਲੰਗੀ ਛਾਲਾ ਪਾਈਆ ॥",
      "transliteration": "taajee bhaur pila(n)gee chhaalaa paieeaa ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜਾ (ਇੰਜ) ਫਿਰਦਾ ਹੈ ਮਾਨੋ ਸ਼ੇਰ ਨੇ ਛਾਲਾ ਮਾਰੀਆਂ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "ताजी भउर पिलंगी छाला पाईआ ॥",
      "sourceLineId": "98736",
      "sourceShabadId": "9220",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭੰਗੀ ਜਾਣ ਭਿੜੰਗੀ ਨਚੇ ਦਾਇਰੀ ॥੧੮੦॥",
      "transliteration": "bha(n)gee jaan bhiRa(n)gee nache dhairee ||180||",
      "translation": "The horses sprung like leopards and began to rotate.180.",
      "punjabiViakhya": "ਜਾ ਮਾਨੋ ਭੰਗਾ ਪੀਣ ਵਾਲੇ ਯੋਧੇ ਗੋਲ ਦਾਇਰੇ ਵਿਚ ਨਾਚ ਕਰ ਰਹੇ ਹੋਣ ॥੧੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "भंगी जाण भिड़ंगी नचे दाइरी ॥१८०॥",
      "sourceLineId": "98737",
      "sourceShabadId": "9220",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਜੇ ਨਾਦ ਸੁਰੰਗੀ ਅਣੀਆਂ ਜੁਟੀਆਂ ॥",
      "transliteration": "baje naadh sura(n)gee aneeaa(n) juTeeaa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੋਹਣੇ ਨਗਾਰੇ ਵਜੇ ਹਨ ਅਤੇ ਫੌਜ ਦੀਆਂ ਮੂਹਰਲੀਆਂ ਕਤਾਰਾ ('ਅਣੀਆਂ') (ਆਪਸ ਵਿਚ) ਜੁਟ ਗਈਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "बजे नाद सुरंगी अणीआँ जुटीआँ ॥",
      "sourceLineId": "98738",
      "sourceShabadId": "9220",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪੈਰੇ ਧਾਰ ਪਵੰਗੀ ਫਉਜਾ ਚੀਰ ਕੈ ॥",
      "transliteration": "paire dhaar pava(n)gee faujaa cheer kai ||",
      "translation": "The trumpets were sounded and the armies confronted each other, the warriors advanced through the armies",
      "punjabiViakhya": "ਘੋੜ ਚੜ੍ਰਹੇ ਯੋਧੇ ('ਪਵੰਗੀ') ਫੌਜਾ ਨੂੰ ਚੀਰ ਕੇ (ਯੁੱਧ ਰੂਪ ਨਦੀ ਦੀ) ਧਾਰਾ ਤੋਂ ਪਾਰ ਹੋ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "पैरे धार पवंगी फउजा चीर कै ॥",
      "sourceLineId": "98739",
      "sourceShabadId": "9220",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਉਠੈ ਛੈਲ ਛਲੰਗੀ ਛਾਲਾ ਪਾਈਆਂ ॥",
      "transliteration": "auThai chhail chhala(n)gee chhaalaa paieeaa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੋਹਣੀਆਂ ਛਾਲਾ ਮਾਰਨ ਵਾਲੇ ਯੋਧਿਆਂ ਨੇ ਉਠ ਕੇ ਛਾਲਾ ਮਾਰੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "उठै छैल छलंगी छाला पाईआँ ॥",
      "sourceLineId": "98740",
      "sourceShabadId": "9220",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਝਾੜਿ ਝੜਾਕ ਝੜੰਗੀ ਤੇਗਾ ਵਜੀਆਂ ॥੧੮੧॥",
      "transliteration": "jhaaR jhaRaak jhaRa(n)gee tegaa vajeeaa(n) ||181||",
      "translation": "They sprang and revolved and the swords struck with jerks.181.",
      "punjabiViakhya": "ਸ਼ਰੀਰ ਦੇ ਅੰਗਾ ਨੂੰ ਝਾੜ ਸੁਟਣ ਵਾਲੀਆਂ ('ਝੜੰਗੀ') ਤਲਵਾਰਾ ਝੜਾਕ ਕਰ ਕੇ ਵਜਦੀਆਂ ਹਨ ॥੧੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "झाड़ि झड़ाक झड़ंगी तेगा वजीआँ ॥१८१॥",
      "sourceLineId": "98741",
      "sourceShabadId": "9220",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਮਾਨਕਾ ਛੰਦ ॥",
      "transliteration": "samaanakaa chha(n)dh ||",
      "translation": "SAMANKA STANZA",
      "punjabiViakhya": "ਸਮਾਨਕਾ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "समानका छंद ॥",
      "sourceLineId": "98742",
      "sourceShabadId": "9221",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜੁ ਦੇਖ ਦੇਖ ਕੈ ਸਬੈ ॥",
      "transliteration": "j dhekh dhekh kai sabai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਵੇਖ ਕੇ ਸਾਰੇ ਉਸੇ ਵੇਲੇ ਭੱਜ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "जु देख देख कै सबै ॥",
      "sourceLineId": "98743",
      "sourceShabadId": "9221",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੁ ਭਾਜਿ ਭਾਜਿ ਗੇ ਤਬੇ ॥",
      "transliteration": "s bhaaj bhaaj ge tabe ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਤਰ੍ਰਹਾ) ਕਿਹਾ ਗਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "सु भाजि भाजि गे तबे ॥",
      "sourceLineId": "98744",
      "sourceShabadId": "9221",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਹਿਓ ਸੁ ਸੋਭ ਸੋਭ ਹੀ ॥",
      "transliteration": "kahio su sobh sobh hee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਤਰ੍ਰਹਾ ਉਹ ਸੁਸ਼ੋਭਿਤ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "कहिओ सु सोभ सोभ ही ॥",
      "sourceLineId": "98745",
      "sourceShabadId": "9221",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਿਲੋਕਿ ਲੋਕ ਲੋਭ ਹੀ ॥੧੮੨॥",
      "transliteration": "bilok lok lobh hee ||182||",
      "translation": "Seeing him, all ran away, everyone coveted to see him.182.",
      "punjabiViakhya": "ਅਤੇ ਲੋਕਾ ਅੰਦਰ (ਉਸ ਨੂੰ) ਵੇਖਣ ਦਾ ਲੋਭ ਹੈ ॥੧੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "बिलोकि लोक लोभ ही ॥१८२॥",
      "sourceLineId": "98746",
      "sourceShabadId": "9221",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪ੍ਰਚੰਡ ਰੂਪ ਰਾਜਈ ॥",
      "transliteration": "pracha(n)dd roop raajiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਪ੍ਰਚੰਡ ਰੂਪ ਵਿਚ ਸ਼ੋਭ ਰਿਹਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "प्रचंड रूप राजई ॥",
      "sourceLineId": "98747",
      "sourceShabadId": "9221",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਿਲੋਕਿ ਭਾਨ ਲਾਜਈ ॥",
      "transliteration": "bilok bhaan laajiee ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ) ਵੇਖ ਕੇ ਸੂਰਜ ਵੀ ਸ਼ਰਮਿੰਦਾ ਹੁੰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "बिलोकि भान लाजई ॥",
      "sourceLineId": "98748",
      "sourceShabadId": "9221",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੁ ਚੰਡ ਤੇਜ ਇਉ ਲਸੈ ॥",
      "transliteration": "s cha(n)dd tej iau lasai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਪ੍ਰਚੰਡ ਤੇਜ ਇੰਜ ਸ਼ੋਭ ਰਿਹਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "सु चंड तेज इउ लसै ॥",
      "sourceLineId": "98749",
      "sourceShabadId": "9221",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪ੍ਰਚੰਡ ਜੋਤਿ ਕੋ ਹਸੈ ॥੧੮੩॥",
      "transliteration": "pracha(n)dd jot ko hasai ||183||",
      "translation": "Seeing his powerful form, the sun is feeling shy and his effulgence is mocking the powerful light.183.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕੋਈ ਪ੍ਰਚੰਡ ਜੋਤਿ ਹਸ ਰਹੀ ਹੋਵੇ (ਅਰਥਾਤ ਪ੍ਰਕਾਸ਼ਮਾਨ ਹੋਵੇ) ॥੧੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "प्रचंड जोति को हसै ॥१८३॥",
      "sourceLineId": "98750",
      "sourceShabadId": "9221",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੁ ਕੋਪਿ ਕੋਪ ਕੈ ਹਠੀ ॥",
      "transliteration": "s kop kop kai haThee ||",
      "translation": "",
      "punjabiViakhya": "ਹਠੀਲੇ ਯੋਧੇ ਕ੍ਰੋਧ ਨਾਲ ਇਸ ਤਰ੍ਰਹਾ ਤਪੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "सु कोपि कोप कै हठी ॥",
      "sourceLineId": "98751",
      "sourceShabadId": "9221",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚਪੈ ਚਿਰਾਇ ਜਿਉ ਭਠੀ ॥",
      "transliteration": "chapai chirai jiau bhaThee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਭਠੀ ਦੇ ਤਪਾਏ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "चपै चिराइ जिउ भठी ॥",
      "sourceLineId": "98752",
      "sourceShabadId": "9221",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪ੍ਰਚੰਡ ਮੰਡਲੀ ਲਸੈ ॥",
      "transliteration": "pracha(n)dd ma(n)ddalee lasai ||",
      "translation": "",
      "punjabiViakhya": "ਤਿਖੇ ਤੇਜ ਵਾਲੀ ਮੰਡਲੀ ਲਿਸ਼ਕਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "प्रचंड मंडली लसै ॥",
      "sourceLineId": "98753",
      "sourceShabadId": "9221",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਿ ਮਾਰਤੰਡ ਕੋ ਹਸੈ ॥੧੮੪॥",
      "transliteration": "k maarata(n)dd ko hasai ||184||",
      "translation": "The persistent warriors in rage are inflamed like the furnace, the powerful group of warriors is even scoffing at the sun.184.",
      "punjabiViakhya": "ਮਾਨੋ ਸੂਰਜ ਨੂੰ ਹਸ ਰਹੀ ਹੋਵੇ ॥੧੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "कि मारतंड को हसै ॥१८४॥",
      "sourceLineId": "98754",
      "sourceShabadId": "9221",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੁ ਕੋਪ ਓਪ ਦੈ ਬਲੀ ॥",
      "transliteration": "s kop op dhai balee ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਨੂੰ ਉਤੇਜਿਤ ਕਰ ਕੇ ਬਲਵਾਨ ਚਲੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "सु कोप ओप दै बली ॥",
      "sourceLineId": "98755",
      "sourceShabadId": "9221",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਿ ਰਾਜ ਮੰਡਲੀ ਚਲੀ ॥",
      "transliteration": "k raaj ma(n)ddalee chalee ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਰਾਜ-ਮੰਡਲੀ ਤੁਰੀ ਜਾਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "कि राज मंडली चली ॥",
      "sourceLineId": "98756",
      "sourceShabadId": "9221",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੁ ਅਸਤ੍ਰ ਸਸਤ੍ਰ ਪਾਨਿ ਲੈ ॥",
      "transliteration": "s asatr sasatr paan lai ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰ ਅਸਤ੍ਰ ਹੱਥ ਵਿਚ ਪਕੜ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "सु असत्र ससत्र पानि लै ॥",
      "sourceLineId": "98757",
      "sourceShabadId": "9221",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਿਸੇਖ ਬੀਰ ਮਾਨ ਕੈ ॥੧੮੫॥",
      "transliteration": "bisekh beer maan kai ||185||",
      "translation": "The soldiers of the king advanced in rage and they were holding their arms and weapons in their hands.185.",
      "punjabiViakhya": "ਅਤੇ ਵੀਰ ਵਿਸ਼ੇਸ਼ ਮਾਣ ਨਾਲ (ਵਧਦੇ ਹਨ) ॥੧੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "बिसेख बीर मान कै ॥१८५॥",
      "sourceLineId": "98758",
      "sourceShabadId": "9221",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤੋਮਰ ਛੰਦ ॥",
      "transliteration": "tomar chha(n)dh ||",
      "translation": "TOMAR STANZA",
      "punjabiViakhya": "ਤੋਮਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "तोमर छंद ॥",
      "sourceLineId": "98759",
      "sourceShabadId": "9222",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭਟ ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਨਚਾਇ ॥",
      "transliteration": "bhaT sasatr asatr nachai ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਸ਼ਸਤ੍ਰਾ ਅਤੇ ਅਸਤ੍ਰਾ ਨੂੰ ਨਚਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "भट ससत्र असत्र नचाइ ॥",
      "sourceLineId": "98760",
      "sourceShabadId": "9222",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚਿਤ ਕੋਪ ਓਪ ਬਢਾਇ ॥",
      "transliteration": "chit kop op baddai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਿਤ ਵਿਚ ਕ੍ਰੋਧ ਦੇ ਤੇਜ ਨੂੰ ਵਧਾ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "चित कोप ओप बढाइ ॥",
      "sourceLineId": "98761",
      "sourceShabadId": "9222",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤੁਰਕਛ ਅਛ ਤੁਰੰਗ ॥",
      "transliteration": "turakachh achh tura(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਰਕਿਸਤਾਨ ਦੇ ਸ੍ਰੇਸ਼ਠ ਘੋੜੇ ਉਤੇ ਚੜ੍ਰਹ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "तुरकछ अछ तुरंग ॥",
      "sourceLineId": "98762",
      "sourceShabadId": "9222",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰਣ ਰੰਗਿ ਚਾਰ ਉਤੰਗ ॥੧੮੬॥",
      "transliteration": "ran ra(n)g chaar uta(n)g ||186||",
      "translation": "Imbued with the idea of fighting, getting enraged, the warriors riding the horses are swinging their arms and weapons.186.",
      "punjabiViakhya": "ਅਤੇ ਯੁੱਧ ਵਿਚ ਉੱਚੇ ਕਦ ਵਾਲੇ ਘੋੜੇ ਨੂੰ ਨਚਾ ਰਹੇ ਹਨ ॥੧੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "रण रंगि चार उतंग ॥१८६॥",
      "sourceLineId": "98763",
      "sourceShabadId": "9222",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਰਿ ਕ੍ਰੋਧ ਪੀਸਤ ਦਾਤ ॥",
      "transliteration": "kar krodh peesat dhaat ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਨਾਲ ਦੰਦ ਪੀਹ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "करि क्रोध पीसत दात ॥",
      "sourceLineId": "98764",
      "sourceShabadId": "9222",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਹਿ ਆਪੁ ਆਪਨ ਬਾਤ ॥",
      "transliteration": "keh aap aapan baat ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੀ ਆਪਣੀ ਗੱਲ ਕਹਿ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "कहि आपु आपन बात ॥",
      "sourceLineId": "98765",
      "sourceShabadId": "9222",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਭਟ ਭੈਰਹਵ ਹੈ ਧੀਰ ॥",
      "transliteration": "bhaT bhairahav hai dheer ||",
      "translation": "",
      "punjabiViakhya": "ਧੀਰਜਵਾਨ ਸੂਰਮੇ ਲਲਕਾਰਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "भट भैरहव है धीर ॥",
      "sourceLineId": "98766",
      "sourceShabadId": "9222",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਰਿ ਕੋਪ ਛਾਡਤ ਤੀਰ ॥੧੮੭॥",
      "transliteration": "kar kop chhaaddat teer ||187||",
      "translation": "In their fury, they are grinding their teeth and talking in themselves and filled with ego these warriors are discharging their arrows.187.",
      "punjabiViakhya": "ਅਤੇ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਤੀਰ ਛਡਦੇ ਹਨ ॥੧੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "करि कोप छाडत तीर ॥१८७॥",
      "sourceLineId": "98767",
      "sourceShabadId": "9222",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਰ ਕੋਪ ਕਲਿ ਅਵਤਾਰ ॥",
      "transliteration": "kar kop kal avataar ||",
      "translation": "",
      "punjabiViakhya": "ਕਲਕੀ ਅਵਤਾਰ ਨੇ ਕ੍ਰੋਧ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "कर कोप कलि अवतार ॥",
      "sourceLineId": "98768",
      "sourceShabadId": "9222",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗਹਿ ਪਾਨਿ ਅਜਾਨ ਕੁਠਾਰ ॥",
      "transliteration": "geh paan ajaan kuThaar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਗੋਡਿਆਂ ਤਕ (ਲੰਬੀਆਂ ਬਾਹਵਾ ਵਾਲੇ) ਹੱਥਾ ਵਿਚ ਕੁਹਾੜਾ ਪਕੜ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "गहि पानि अजान कुठार ॥",
      "sourceLineId": "98769",
      "sourceShabadId": "9222",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0569_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਨਕੇਕ ਕੀਨ ਪ੍ਰਹਾਰ ॥",
      "transliteration": "tanakek keen prahaar ||",
      "translation": "",
      "punjabiViakhya": "ਇਕਨਾ ਉਤੇ ਤਣ ਕੇ ਵਾਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 569,
      "hindi": "",
      "hindiTransliteration": "तनकेक कीन प्रहार ॥",
      "sourceLineId": "98770",
      "sourceShabadId": "9222",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
