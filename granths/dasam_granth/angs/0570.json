{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 570,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0570_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭਟ ਜੂਝ ਗਯੋ ਸੈ ਚਾਰ ॥੧੮੮॥",
      "transliteration": "bhaT joojh gayo sai chaar ||188||",
      "translation": "Kalki, getting infuriated caught hold of His axe in his long arms and with its slightest blow, four hundred warriors died and fell down.188.",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਚਾਰ ਸੌ ਸੂਰਮਾ ਮਾਰਿਆ ਗਿਆ ॥੧੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "भट जूझ गयो सै चार ॥१८८॥",
      "sourceLineId": "98771",
      "sourceShabadId": "9222",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਭੜਥੂਆ ਛੰਦ ॥",
      "transliteration": "bhaRathooaa chha(n)dh ||",
      "translation": "BHARTHUAA STANZA",
      "punjabiViakhya": "ਭੜਥੂਆ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "भड़थूआ छंद ॥",
      "sourceLineId": "98772",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਢਢਕੰਤ ਢੋਲੰ ॥",
      "transliteration": "ddaddaka(n)t ddola(n) ||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲਾ ਦਾ ਢਮਕਾਰ ਹੁੰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "ढढकंत ढोलं ॥",
      "sourceLineId": "98773",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਬਕੰਤ ਬੋਲੰ ॥",
      "transliteration": "babaka(n)t bola(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਬੜ੍ਰਹਕਾ ਮਾਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "बबकंत बोलं ॥",
      "sourceLineId": "98774",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਉਛਕੰਤ ਤਾਜੀ ॥",
      "transliteration": "auchhaka(n)t taajee ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜੇ ਉਛਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "उछकंत ताजी ॥",
      "sourceLineId": "98775",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗਜਕੰਤ ਗਾਜੀ ॥੧੮੯॥",
      "transliteration": "gajaka(n)t gaajee ||189||",
      "translation": "The drums sounded, the horses swung and the warriors thundered.189.",
      "punjabiViakhya": "ਗਾਜ਼ੀ ਗੱਜਦੇ ਹਨ ॥੧੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "गजकंत गाजी ॥१८९॥",
      "sourceLineId": "98776",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਛੁਟਕੰਤ ਤੀਰੰ ॥",
      "transliteration": "chhuTaka(n)t teera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ ਛੁਟਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "छुटकंत तीरं ॥",
      "sourceLineId": "98777",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਬਕੰਤ ਬੀਰੰ ॥",
      "transliteration": "babaka(n)t beera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਲਲਕਾਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "बबकंत बीरं ॥",
      "sourceLineId": "98778",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਢਲਕੰਤ ਢਾਲੰ ॥",
      "transliteration": "ddalaka(n)t ddaala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਢਾਲਾ ਢਲਕਦੀਆਂ (ਟਕਰਾਉਾਂਦੀਆਂ) ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "ढलकंत ढालं ॥",
      "sourceLineId": "98779",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਉਠਕੰਤ ਤਾਲੰ ॥੧੯੦॥",
      "transliteration": "auThaka(n)t taala(n) ||190||",
      "translation": "The thundering warriors discharged arrows, their shields were raised and the rhythmic sound was heard.190.",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਵਿਚੋਂ) ਲੈਅ ਪੈਦਾ ਹੁੰਦੀ ਹੈ ॥੧੯੦॥",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "उठकंत तालं ॥१९०॥",
      "sourceLineId": "98780",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਖਿਮਕੰਤ ਖਗੰ ॥",
      "transliteration": "khimaka(n)t khaga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਚਮਕਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "खिमकंत खगं ॥",
      "sourceLineId": "98781",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਧਧਕੰਤ ਧਗੰ ॥",
      "transliteration": "dhadhaka(n)t dhaga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਧੌਂਸੇ ਵਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "धधकंत धगं ॥",
      "sourceLineId": "98782",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਛੁਟਕੰਤ ਨਾਲੰ ॥",
      "transliteration": "chhuTaka(n)t naala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬੰਦੂਕਾ ਛੁਟਕਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "छुटकंत नालं ॥",
      "sourceLineId": "98783",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਉਠਕੰਤ ਜ੍ਵਾਲੰ ॥੧੯੧॥",
      "transliteration": "auThaka(n)t javaiaala(n) ||191||",
      "translation": "The daggers glistened, the flaming fires blazed and the flames rose high.191.",
      "punjabiViakhya": "ਅੱਗ (ਦੇ ਅਲੰਬੇ) ਉਠਦੇ ਹਨ ॥੧੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "उठकंत ज्वालं ॥१९१॥",
      "sourceLineId": "98784",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਹਤੰਤ ਘਾਯੰ ॥",
      "transliteration": "bahata(n)t ghaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਘਾਉਆਂ (ਤੋਂ ਲਹੂ) ਵਗਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "बहतंत घायं ॥",
      "sourceLineId": "98785",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਝਲਕੰਤ ਚਾਯੰ ॥",
      "transliteration": "jhalaka(n)t chaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮਿਆਂ ਦਾ) ਚਾਉ (ਉਨ੍ਰਹਾ ਦੇ ਮੂੰਹ ਤੋਂ) ਝਲਕਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "झलकंत चायं ॥",
      "sourceLineId": "98786",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਡਿਗਤੰਤ ਬੀਰੰ ॥",
      "transliteration": "ddigata(n)t beera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧੇ ਡਿਗਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "डिगतंत बीरं ॥",
      "sourceLineId": "98787",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਭਿਗਤੰਤ ਭੀਰੰ ॥੧੯੨॥",
      "transliteration": "bhigata(n)t bheera(n) ||192||",
      "translation": "The blood oozed out from the wounds, which demonstrated the zeal of the warriors, they ran and fell in the multitude.192.",
      "punjabiViakhya": "ਡਰਾਕਲ ਕੰਬਦੇ ਹਨ (ਜਾ ਪਸੀਨੇ ਨਾਲ ਭਿਜ ਜਾਦੇ ਹਨ) ॥੧੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "भिगतंत भीरं ॥१९२॥",
      "sourceLineId": "98788",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਟੁਟੰਤੰਤ ਖੋਲੰ ॥",
      "transliteration": "TuTa(n)ta(n)t khola(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਿਰ ਦੇ ਟੋਪ ('ਖੋਲੰ') ਟੁੱਟਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "टुटंतंत खोलं ॥",
      "sourceLineId": "98789",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਢਮੰਕੰਤ ਢੋਲੰ ॥",
      "transliteration": "ddama(n)ka(n)t ddola(n) ||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲ ਢਮਕਾਰ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "ढमंकंत ढोलं ॥",
      "sourceLineId": "98790",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਟਟੰਕੰਤ ਤਾਲੰ ॥",
      "transliteration": "TaTa(n)ka(n)t taala(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸ਼ਸਤ੍ਰਾ ਦੇ ਵਾਰ ਦੇ) ਤਾਲ ਟੁੱਟਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "टटंकंत तालं ॥",
      "sourceLineId": "98791",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਚੰਤੰਤ ਬਾਲੰ ॥੧੯੩॥",
      "transliteration": "nacha(n)ta(n)t baala(n) ||193||",
      "translation": "The helmets broke, the drums sounded and the heavenly damsels danced in consonance with the tune.193.",
      "punjabiViakhya": "ਚੁੜ੍ਰਹੇਲਾ (ਜਾ ਅਪੱਛਰਾਵਾ) ਨਚਦੀਆਂ ਹਨ ॥੧੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "नचंतंत बालं ॥१९३॥",
      "sourceLineId": "98792",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗਿਰੰਤੰਤ ਅੰਗੰ ॥",
      "transliteration": "gira(n)ta(n)t a(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਯੋਧਿਆਂ ਦੇ) ਅੰਗ ਡਿਗਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "गिरंतंत अंगं ॥",
      "sourceLineId": "98793",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਟੰਤੰਤ ਜੰਗੰ ॥",
      "transliteration": "kaTa(n)ta(n)t ja(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਅੰਗ) ਯੁੱਧ ਵਿਚ ਕਟੇ ਜਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "कटंतंत जंगं ॥",
      "sourceLineId": "98794",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚਲੰਤੰਤ ਤੀਰੰ ॥",
      "transliteration": "chala(n)ta(n)t teera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ ਚਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "चलंतंत तीरं ॥",
      "sourceLineId": "98795",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭਟੰਕੰਤ ਭੀਰੰ ॥੧੯੪॥",
      "transliteration": "bhaTa(n)ka(n)t bheera(n) ||194||",
      "translation": "The limbs were chopped, they fell down and because of the discharged arrows, the warriors were tossed about violently.194.",
      "punjabiViakhya": "ਡਰਪੋਕ ਭਟਕ ਰਹੇ ਹਨ ॥੧੯੪॥",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "भटंकंत भीरं ॥१९४॥",
      "sourceLineId": "98796",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੁਝੰਤੰਤ ਵੀਰੰ ॥",
      "transliteration": "jujha(n)ta(n)t veera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਜੂਝਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "जुझंतंत वीरं ॥",
      "sourceLineId": "98797",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭਜੰਤੰਤ ਭੀਰੰ ॥",
      "transliteration": "bhaja(n)ta(n)t bheera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਡਰਪੋਕ ਭਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "भजंतंत भीरं ॥",
      "sourceLineId": "98798",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਰੰਤੰਤ ਕ੍ਰੋਹੰ ॥",
      "transliteration": "kara(n)ta(n)t kroha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਜੁਝਾਰੂ ਯੋਧੇ) ਕ੍ਰੋਧ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "करंतंत क्रोहं ॥",
      "sourceLineId": "98799",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭਰੰਤੰਤ ਰੋਹੰ ॥੧੯੫॥",
      "transliteration": "bhara(n)ta(n)t roha(n) ||195||",
      "translation": "The warriors fought bravely and the cowards ran away, the heroic fighters were filled with anger and malice.195.",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਦੇ ਭਰੇ ਹੋਏ ਹਨ ॥੧੯੫॥",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "भरंतंत रोहं ॥१९५॥",
      "sourceLineId": "98800",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਜੰਤੰਤ ਤੀਰੰ ॥",
      "transliteration": "taja(n)ta(n)t teera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ ਛੁਟਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "तजंतंत तीरं ॥",
      "sourceLineId": "98801",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਜੰਤੰਤ ਭੀਰੰ ॥",
      "transliteration": "bhaja(n)ta(n)t bheera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਇਰ ਭਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "भजंतंत भीरं ॥",
      "sourceLineId": "98802",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਹੰਤੰਤ ਘਾਯੰ ॥",
      "transliteration": "baha(n)ta(n)t ghaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜ਼ਖ਼ਮਾ ਵਿਚੋਂ ਲਹੂ ਵਗਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "बहंतंत घायं ॥",
      "sourceLineId": "98803",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਝਲੰਤੰਤ ਜਾਯੰ ॥੧੯੬॥",
      "transliteration": "jhala(n)ta(n)t jaaya(n) ||196||",
      "translation": "With the discharge of the arrows, the cowards ran away and the zeal was exhibited by the oozing wounds.196.",
      "punjabiViakhya": "(ਉਹ) ਥਾ ਚਮਕਦੀ ਹੈ ॥੧੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "झलंतंत जायं ॥१९६॥",
      "sourceLineId": "98804",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਤਕੰਤ ਅੰਗੰ ॥",
      "transliteration": "tataka(n)t a(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕੱਟੇ ਹੋਏ) ਅੰਗ ਤੜਫਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "ततकंत अंगं ॥",
      "sourceLineId": "98805",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜੁਟਕੰਤ ਜੰਗੰ ॥",
      "transliteration": "juTaka(n)t ja(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਯੁੱਧ ਵਿਚ ਜੁੱਟੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "जुटकंत जंगं ॥",
      "sourceLineId": "98806",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਉਲਥਥ ਲੁਥੰ ॥",
      "transliteration": "aulathath lutha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਲੋਥਾ ਉਤੇ ਲੋਥ ਚੜ੍ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "उलथथ लुथं ॥",
      "sourceLineId": "98807",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪਲੁਥਤ ਜੁਥੰ ॥੧੯੭॥",
      "transliteration": "paluthat jutha(n) ||197||",
      "translation": "The limbs and corpses of the warriors engaged in war fell up and down.197.",
      "punjabiViakhya": "(ਸੈਨਿਕਾ ਦੀਆਂ ਟੋਲੀਆਂ) ਗੁਥਮ ਗੁੱਥਾ ਹਨ ॥੧੯੭॥",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "पलुथत जुथं ॥१९७॥",
      "sourceLineId": "98808",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਢਲੰਕੰਤ ਢਾਲੰ ॥",
      "transliteration": "ddala(n)ka(n)t ddaala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਢਾਲਾ ਢਲਕਦੀਆਂ (ਟਕਰਾਉਾਂਦੀਆਂ) ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "ढलंकंत ढालं ॥",
      "sourceLineId": "98809",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪੁਅੰਤੰਤ ਮਾਲੰ ॥",
      "transliteration": "pua(n)ta(n)t maala(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸ਼ਿਵ-ਗਣ ਮੁੰਡਾ ਦੀਆਂ) ਮਾਲਾਵਾ ਪਰੋਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "पुअंतंत मालं ॥",
      "sourceLineId": "98810",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਚੰਤੰਤ ਈਸੰ ॥",
      "transliteration": "nacha(n)ta(n)t ieesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕੱਟੇ ਹੋਏ ਸਿਰਾ ਨੂੰ (ਮਾਲਾਵਾ ਵਿਚ ਪਰੋ ਕੇ)",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "नचंतंत ईसं ॥",
      "sourceLineId": "98811",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਟੰਤੰਤ ਸੀਸੰ ॥੧੯੮॥",
      "transliteration": "kaTa(n)ta(n)t seesa(n) ||198||",
      "translation": "The shields gleamed and seeing the chopped heads, Shiva began to dance and wear the rosaries of skulls.198.",
      "punjabiViakhya": "ਸ਼ਿਵ ਨਚਦਾ ਹੈ ॥੧੯੮॥",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "कटंतंत सीसं ॥१९८॥",
      "sourceLineId": "98812",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਉਛੰਕੰਤ ਤਾਜੀ ॥",
      "transliteration": "auchha(n)ka(n)t taajee ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜੇ ਉਛਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "उछंकंत ताजी ॥",
      "sourceLineId": "98813",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਹੰਤੰਤ ਗਾਜੀ ॥",
      "transliteration": "baha(n)ta(n)t gaajee ||",
      "translation": "",
      "punjabiViakhya": "ਬਹਾਦਰ ਸੂਰਮਿਆਂ (ਦੇ ਘਾਓ) ਵਗਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "बहंतंत गाजी ॥",
      "sourceLineId": "98814",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਲੁਟੰਤੰਤ ਲੁਥੰ ॥",
      "transliteration": "luTa(n)ta(n)t lutha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਲੋਥਾ ਲੋਟ ਪੋਟ ਹੋ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "लुटंतंत लुथं ॥",
      "sourceLineId": "98815",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਟੰਤੰਤ ਮੁਖੰ ॥੧੯੯॥",
      "transliteration": "kaTa(n)ta(n)t mukha(n) ||199||",
      "translation": "The horses sprang and the warriors seeing the corpses and chopped heads got pleased.199.",
      "punjabiViakhya": "ਸਿਰ ਕਟੇ ਜਾ ਰਹੇ ਹਨ ॥੧੯੯॥",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "कटंतंत मुखं ॥१९९॥",
      "sourceLineId": "98816",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਪੰਤੰਤ ਤੇਗੰ ॥",
      "transliteration": "tapa(n)ta(n)t tega(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਾ (ਗਰਮ ਲਹੂ ਨਾਲ) ਤਪਦੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "तपंतंत तेगं ॥",
      "sourceLineId": "98817",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0570_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚਮੰਕੰਤ ਬੇਗੰ ॥",
      "transliteration": "chama(n)ka(n)t bega(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੇਜ਼ੀ ਨਾਲ ਚਮਕਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 570,
      "hindi": "",
      "hindiTransliteration": "चमंकंत बेगं ॥",
      "sourceLineId": "98818",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
