{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 571,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0571_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਚੇ ਮੁੰਡ ਮਾਲੀ ॥",
      "transliteration": "nache mu(n)dd maalee ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ('ਮੁੰਡਮਾਲੀ') ਨਚ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "नचे मुँड माली ॥",
      "sourceLineId": "98819",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਹਸੇਤਤ ਕਾਲੀ ॥੨੦੦॥",
      "transliteration": "hasetat kaalee ||200||",
      "translation": "The swords saturated with hot blood glistened and Shiva danced and laughed.200.",
      "punjabiViakhya": "ਕਾਲੀ ਹੱਸ ਰਹੀ ਹੈ ॥੨੦੦॥",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "हसेतत काली ॥२००॥",
      "sourceLineId": "98820",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜੁਟੰਤੰਤ ਵੀਰੰ ॥",
      "transliteration": "juTa(n)ta(n)t veera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ (ਯੁੱਧ ਵਿਚ) ਜੁਟ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "जुटंतंत वीरं ॥",
      "sourceLineId": "98821",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਛੁਟੰਤੰਤ ਤੀਰੰ ॥",
      "transliteration": "chhuTa(n)ta(n)t teera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ ਛੁਟ ਰਹੇ ਹਨ। (ਸ਼ਹੀਦ ਹੋਣ ਵਾਲੇ ਸੂਰਮਿਆਂ ਨੂੰ)",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "छुटंतंत तीरं ॥",
      "sourceLineId": "98822",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਰੰਤੰਤ ਬਾਲੰ ॥",
      "transliteration": "bara(n)ta(n)t baala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਪੱਛਰਾਵਾ ਵਰ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "बरंतंत बालं ॥",
      "sourceLineId": "98823",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਢਲੰਤੰਤ ਢਾਲੰ ॥੨੦੧॥",
      "transliteration": "ddala(n)ta(n)t ddaala(n) ||201||",
      "translation": "The warriors, getting together, began to discharge arrows and taking their gleaming shields they began to wed the heavenly damsels.201.",
      "punjabiViakhya": "ਢਾਲਾ ਢਲ ਰਹੀਆਂ ਹਨ ॥੨੦੧॥",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "ढलंतंत ढालं ॥२०१॥",
      "sourceLineId": "98824",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੁਮਤੰਤ ਮਦੰ ॥",
      "transliteration": "sumata(n)t madha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਮਦ-ਮਸਤ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "सुमतंत मदं ॥",
      "sourceLineId": "98825",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਉਠੈ ਸਦ ਗਦੰ ॥",
      "transliteration": "auThai sadh gadha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਗੁਰਜਾ (ਦੇ ਵਜਣ ਦੀਆਂ) ਆਵਾਜ਼ਾ ਉਠਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "उठै सद गदं ॥",
      "sourceLineId": "98826",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਟੰਤੰਤ ਅੰਗੰ ॥",
      "transliteration": "kaTa(n)ta(n)t a(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਗ ਕੱਟ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "कटंतंत अंगं ॥",
      "sourceLineId": "98827",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗਿਰੰਤੰਤ ਜੰਗੰ ॥੨੦੨॥",
      "transliteration": "gira(n)ta(n)t ja(n)ga(n) ||202||",
      "translation": "The intoxicated sound is rising from all the four sides and the chopped limbs are falling down in the battlefield.202.",
      "punjabiViakhya": "ਜੰਗ (ਦੇ ਮੈਦਾਨ) ਵਿਚ ਡਿਗ ਰਹੇ ਹਨ ॥੨੦੨॥",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "गिरंतंत जंगं ॥२०२॥",
      "sourceLineId": "98828",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚਲਤੰਤਿ ਚਾਯੰ ॥",
      "transliteration": "chalata(n)t chaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਚਾਓ ਨਾਲ ਚਲ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "चलतंति चायं ॥",
      "sourceLineId": "98829",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੁਝੰਤੰਤ ਜਾਯੰ ॥",
      "transliteration": "jujha(n)ta(n)t jaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਯੁੱਧ) ਭੂਮੀ ਵਿਚ ਜਾ ਕੇ ਜੂਝਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "जुझंतंत जायं ॥",
      "sourceLineId": "98830",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਣੰਕੰਤ ਨਾਦੰ ॥",
      "transliteration": "rana(n)ka(n)t naadha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨਾਦ ਗੂੰਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "रणंकंत नादं ॥",
      "sourceLineId": "98831",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਜੰਤੰਤ ਬਾਦੰ ॥੨੦੩॥",
      "transliteration": "baja(n)ta(n)t baadha(n) ||203||",
      "translation": "The warriors are fighting with each other with great zeal and the musical instruments are being and played in the battlefield.203.",
      "punjabiViakhya": "(ਮਾਰੂ) ਵਾਜੇ ਵਜਦੇ ਹਨ ॥੨੦੩॥",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "बजंतंत बादं ॥२०३॥",
      "sourceLineId": "98832",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪੁਐਰੰਤ ਪਤ੍ਰੀ ॥",
      "transliteration": "puaaira(n)t patree ||",
      "translation": "",
      "punjabiViakhya": "ਖੰਭਾ ('ਪਤ੍ਰੀ') ਵਾਲੇ ਤੀਰ ਪਰੁਚੇ ਹੋਏ ਚਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "पुऐरंत पत्री ॥",
      "sourceLineId": "98833",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਲਗੰਤੰਤ ਅਤ੍ਰੀ ॥",
      "transliteration": "laga(n)ta(n)t atree ||",
      "translation": "",
      "punjabiViakhya": "ਅਸਤ੍ਰ-ਧਾਰੀ ਸੂਰਮਿਆਂ ਨੂੰ ਲਗਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "लगंतंत अत्री ॥",
      "sourceLineId": "98834",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਜਤੰਤ੍ਰ ਅਤ੍ਰੰ ॥",
      "transliteration": "bajata(n)tr atra(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਸਤ੍ਰ (ਤੀਰ) ਵਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "बजतंत्र अत्रं ॥",
      "sourceLineId": "98835",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜੁਝਤੰਤ ਛਤ੍ਰੰ ॥੨੦੪॥",
      "transliteration": "jujhata(n)t chhatra(n) ||204||",
      "translation": "The tips of the arms and weapons are entering the bodies and the Kshatriyas are striking their arms and weapons in the battlefield.204.",
      "punjabiViakhya": "ਛਤ੍ਰੀ ਜੂਝਦੇ ਹਨ ॥੨੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "जुझतंत छत्रं ॥२०४॥",
      "sourceLineId": "98836",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗਿਰੰਤੰਤ ਭੂਮੀ ॥",
      "transliteration": "gira(n)ta(n)t bhoomee ||",
      "translation": "",
      "punjabiViakhya": "ਭੂਮੀ ਉਤੇ ਡਿਗਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "गिरंतंत भूमी ॥",
      "sourceLineId": "98837",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਉਠੰਤੰਤ ਝੂਮੀ ॥",
      "transliteration": "auTha(n)ta(n)t jhoomee ||",
      "translation": "",
      "punjabiViakhya": "ਘੁੰਮੇਰੀ ਖਾ ਕੇ ਉਠਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "उठंतंत झूमी ॥",
      "sourceLineId": "98838",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰਟੰਤੰਤ ਪਾਨੰ ॥",
      "transliteration": "raTa(n)ta(n)t paana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਪਾਣੀ ਮੰਗਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "रटंतंत पानं ॥",
      "sourceLineId": "98839",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜੁਝੰਤੰਤ ਜੁਆਨੰ ॥੨੦੫॥",
      "transliteration": "jujha(n)ta(n)t juaana(n) ||205||",
      "translation": "The warriors falling on the earth and then swinging up and fighting are shouting for water.205.",
      "punjabiViakhya": "ਸੂਰਮੇ ਜੂਝਦੇ ਹਨ ॥੨੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "जुझंतंत जुआनं ॥२०५॥",
      "sourceLineId": "98840",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚਲੰਤੰਤ ਬਾਣੰ ॥",
      "transliteration": "chala(n)ta(n)t baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣ ਚਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "चलंतंत बाणं ॥",
      "sourceLineId": "98841",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0571_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰੁਕੰਤੰਤ ਦਿਸਾਣੰ ॥",
      "transliteration": "ruka(n)ta(n)t dhisaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦਿਸ਼ਾਵਾ (ਤੀਰਾ ਨਾਲ) ਰੁਕ ਜਾਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 571,
      "hindi": "",
      "hindiTransliteration": "रुकंतंत दिसाणं ॥",
      "sourceLineId": "98842",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
