  "lines": [
    {
      "id": "dasam_ang_0572_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗਿਰੰਤੰਤ ਬੀਰੰ ॥",
      "transliteration": "gira(n)ta(n)t beera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਡਿਗ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "गिरंतंत बीरं ॥",
      "sourceLineId": "98843",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਭਜੰਤੰਤ ਭੀਰੰ ॥੨੦੬॥",
      "transliteration": "bhaja(n)ta(n)t bheera(n) ||206||",
      "translation": "The directions have disappeared by the discharge of arrows, the warriors are falling and the cowards are running away.206.",
      "punjabiViakhya": "ਡਰਪੋਕ ਭਜ ਰਹੇ ਹਨ ॥੨੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "भजंतंत भीरं ॥२०६॥",
      "sourceLineId": "98844",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਚੰਤੰਤ ਈਸੰ ॥",
      "transliteration": "nacha(n)ta(n)t ieesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਨਚ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "नचंतंत ईसं ॥",
      "sourceLineId": "98845",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪੁਅੰਤੰਤ ਸੀਸੰ ॥",
      "transliteration": "pua(n)ta(n)t seesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮੁੰਡਾ ਨੂੰ ਪਰੋ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "पुअंतंत सीसं ॥",
      "sourceLineId": "98846",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਜੰਤੰਤ ਡਉਰੂ ॥",
      "transliteration": "baja(n)ta(n)t ddauroo ||",
      "translation": "",
      "punjabiViakhya": "ਡੌਰੂ ਵਜਾਉਾਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "बजंतंत डउरू ॥",
      "sourceLineId": "98847",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭ੍ਰਮੰਤੰਤ ਭਉਰੂ ॥੨੦੭॥",
      "transliteration": "bhrama(n)ta(n)t bhauroo ||207||",
      "translation": "Shiva while dancing and playing his tabor is roaming and wearing the rosaries of skulls.207.",
      "punjabiViakhya": "ਭਿਆਨਕ ਸ਼ਕਲ ਵਿਚ ਘੁੰਮ ਰਿਹਾ ਹੈ ॥੨੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "भ्रमंतंत भउरू ॥२०७॥",
      "sourceLineId": "98848",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਚੰਤੰਤ ਬਾਲੰ ॥",
      "transliteration": "nacha(n)ta(n)t baala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਪੱਛਰਾਵਾ ਨਚ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "नचंतंत बालं ॥",
      "sourceLineId": "98849",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤੁਟੰਤੰਤ ਤਾਲੰ ॥",
      "transliteration": "tuTa(n)ta(n)t taala(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ) ਤਾਲ ਟੁੱਟ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "तुटंतंत तालं ॥",
      "sourceLineId": "98850",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਚੰਤੰਤ ਵੀਰੰ ॥",
      "transliteration": "macha(n)ta(n)t veera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ (ਚਾਉ ਨਾਲ) ਮਚ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "मचंतंत वीरं ॥",
      "sourceLineId": "98851",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਭਜੰਤੰਤ ਭੀਰੰ ॥੨੦੮॥",
      "transliteration": "bhaja(n)ta(n)t bheera(n) ||208||",
      "translation": "The heavenly damsels are dancing and with the dreadful fighting by warriors and running away by the cowards, there is a break in the tune.208.",
      "punjabiViakhya": "ਕਾਇਰ ਭਜ ਰਹੇ ਹਨ ॥੨੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "भजंतंत भीरं ॥२०८॥",
      "sourceLineId": "98852",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਲਗੰਤੰਤ ਬਾਣੰ ॥",
      "transliteration": "laga(n)ta(n)t baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣ ਲਗ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "लगंतंत बाणं ॥",
      "sourceLineId": "98853",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਢਹੰਤੰਤ ਜੁਆਣੰ ॥",
      "transliteration": "ddaha(n)ta(n)t juaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੁਆਨ ਡਿਗ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "ढहंतंत जुआणं ॥",
      "sourceLineId": "98854",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਟੰਤੰਤ ਅਧੰ ॥",
      "transliteration": "kaTa(n)ta(n)t adha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਅੱਧ ਵਿਚ ਕਟੇ ਜਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "कटंतंत अधं ॥",
      "sourceLineId": "98855",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਭਟੰਤੰਤ ਬਧੰ ॥੨੦੯॥",
      "transliteration": "bhaTa(n)ta(n)t badha(n) ||209||",
      "translation": "The warriors fall on being struck by the arrows and the headless trunks of the warriors are being chopped through the middle.209.",
      "punjabiViakhya": "ਯੋਧੇ ਮਾਰੇ ਜਾ ਰਹੇ ਹਨ ॥੨੦੯॥",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "भटंतंत बधं ॥२०९॥",
      "sourceLineId": "98856",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਖਹੰਤੰਤ ਖੂਨੀ ॥",
      "transliteration": "khaha(n)ta(n)t khoonee ||",
      "translation": "",
      "punjabiViakhya": "ਖ਼ੂਨਖਾਰ (ਯੋਧੇ ਆਪਸ ਵਿਚ) ਖਹਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "खहंतंत खूनी ॥",
      "sourceLineId": "98857",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚੜੇ ਚਉਪ ਦੂਨੀ ॥",
      "transliteration": "chaRe chaup dhoonee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ ਮਨ ਵਿਚ) ਦੂਣਾ ਚਾਉ ਚੜ੍ਰਹਿਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "चड़े चउप दूनी ॥",
      "sourceLineId": "98858",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਹੰਤੰਤ ਅਤ੍ਰੰ ॥",
      "transliteration": "baha(n)ta(n)t atra(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਸਤ੍ਰ ਚਲ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "बहंतंत अत्रं ॥",
      "sourceLineId": "98859",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਟੰਤੰਤ ਛਤ੍ਰੰ ॥੨੧੦॥",
      "transliteration": "kaTa(n)ta(n)t chhatra(n) ||210||",
      "translation": "The blood-spilling warriors are fighting with double zeal and with the blows of the arms, the canopies of the warriors being cut down, are falling.210.",
      "punjabiViakhya": "ਛਤ੍ਰ ਕਟੇ ਜਾ ਰਹੇ ਹਨ ॥੨੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "कटंतंत छत्रं ॥२१०॥",
      "sourceLineId": "98860",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਹੰਤੰਤ ਪਤ੍ਰੀ ॥",
      "transliteration": "baha(n)ta(n)t patree ||",
      "translation": "",
      "punjabiViakhya": "ਖੰਭਾ ਵਾਲੇ ਤੀਰ ਚਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "बहंतंत पत्री ॥",
      "sourceLineId": "98861",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੁਝੰਤੰਤ ਅਤ੍ਰੀ ॥",
      "transliteration": "jujha(n)ta(n)t atree ||",
      "translation": "",
      "punjabiViakhya": "ਅਸਤ੍ਰਾ (ਵਾਲੇ ਯੋਧੇ) ਜੂਝ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "जुझंतंत अत्री ॥",
      "sourceLineId": "98862",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹਿਣੰਕੰਤ ਤਾਜੀ ॥",
      "transliteration": "hina(n)ka(n)t taajee ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜੇ ਹਿਣਕ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "हिणंकंत ताजी ॥",
      "sourceLineId": "98863",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਣੰਛੰਤ ਗਾਜੀ ॥੨੧੧॥",
      "transliteration": "kana(n)chha(n)t gaajee ||211||",
      "translation": "The tips of the striking arms are piercing the bodies, the horses are neighing and the warriors are thundering.211.",
      "punjabiViakhya": "ਸੂਰਮੇ ਗੱਜਦੇ ਹਨ ॥੨੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "कणंछंत गाजी ॥२११॥",
      "sourceLineId": "98864",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤੁਟੰਤੰਤ ਚਰਮੰ ॥",
      "transliteration": "tuTa(n)ta(n)t charama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਢਾਲਾ ('ਚਰਮੰ') ਟੁੱਟ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "तुटंतंत चरमं ॥",
      "sourceLineId": "98865",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਟੰਤੰਤ ਬਰਮੰ ॥",
      "transliteration": "kaTa(n)ta(n)t barama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਵਚ ਕਟੇ ਜਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "कटंतंत बरमं ॥",
      "sourceLineId": "98866",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗਿਰੰਤੰਤ ਭੂਮੀ ॥",
      "transliteration": "gira(n)ta(n)t bhoomee ||",
      "translation": "",
      "punjabiViakhya": "(ਲੜਦੇ ਹੋਏ ਯੋਧੇ) ਭੂਮੀ ਉਤੇ ਡਿਗ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "गिरंतंत भूमी ॥",
      "sourceLineId": "98867",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਉਠੰਤੰਤ ਘੂਮੀ ॥੨੧੨॥",
      "transliteration": "auTha(n)ta(n)t ghoomee ||212||",
      "translation": "The shields and the armours are being cut, the warriors are falling on the earth and getting up while swinging.212.",
      "punjabiViakhya": "ਅਤੇ ਘੁੰਮੇਰੀ ਖਾ ਕੇ ਉਠ ਰਹੇ ਹਨ ॥੨੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "उठंतंत घूमी ॥२१२॥",
      "sourceLineId": "98868",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰਟੰਤੰਤ ਪਾਨੰ ॥",
      "transliteration": "raTa(n)ta(n)t paana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਬਾਰ ਬਾਰ) ਪਾਣੀ ਮੰਗਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "रटंतंत पानं ॥",
      "sourceLineId": "98869",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਟੰਤੰਤ ਜੁਆਨੰ ॥",
      "transliteration": "kaTa(n)ta(n)t juaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਕਟੇ ਜਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "कटंतंत जुआनं ॥",
      "sourceLineId": "98870",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਉਡੰਤੰਤ ਏਕੰ ॥",
      "transliteration": "audda(n)ta(n)t eka(n) ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ (ਤੀਰ) ਉਡਦੇ (ਅਰਥਾਤ ਛੁਟਦੇ ਹਨ)",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "उडंतंत एकं ॥",
      "sourceLineId": "98871",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗਡੰਤੰਤ ਨੇਕੰ ॥੨੧੩॥",
      "transliteration": "gadda(n)ta(n)t neka(n) ||213||",
      "translation": "The hands have fought with hands, the young soldiers being chopped and the arrows, flying numerously are being planted in the bodies.213.",
      "punjabiViakhya": "ਅਤੇ ਅਨੇਕਾ (ਦੇ ਸ਼ਰੀਰ ਵਿਚ) ਗਡੇ ਜਾਦੇ ਹਨ ॥੨੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "गडंतंत नेकं ॥२१३॥",
      "sourceLineId": "98872",
      "sourceShabadId": "9223",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਨੂਪ ਨਿਰਾਜ ਛੰਦ ॥",
      "transliteration": "anoop niraaj chha(n)dh ||",
      "translation": "ANOOP NIRAAJ STANZA",
      "punjabiViakhya": "ਅਨੂਪ ਨਿਰਾਜ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "अनूप निराज छंद ॥",
      "sourceLineId": "98873",
      "sourceShabadId": "9224",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਨੂਪ ਰੂਪ ਦਿਖ ਕੈ ਸੁ ਕ੍ਰਧੁ ਜੋਧਣੰ ਬਰੰ ॥",
      "transliteration": "anoop roop dhikh kai su kradh jodhana(n) bara(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਦੇ) ਰੂਪ ਬਹੁਤ ਸੁੰਦਰ ਦਿਖਦੇ ਹਨ, ਉਹ ਬਲਵਾਨ (ਜਵਾਨ) ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "अनूप रूप दिख कै सु क्रधु जोधणं बरं ॥",
      "sourceLineId": "98874",
      "sourceShabadId": "9224",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਨਧ ਬਧ ਉਦਿਤੰ ਸੁ ਕੋਪ ਓਪ ਦੇ ਨਰੰ ॥",
      "transliteration": "sanadh badh udhita(n) su kop op dhe nara(n) ||",
      "translation": "Seeing the unique beauty, the warriors are getting infuriated and wearing their weapons are reaching in the war-arena",
      "punjabiViakhya": "ਹਥਿਆਰ ਸਜਾ ਕੇ, ਕ੍ਰੋਧ ਨੂੰ ਪ੍ਰਗਟ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "सनध बध उदितं सु कोप ओप दे नरं ॥",
      "sourceLineId": "98875",
      "sourceShabadId": "9224",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਚਹੰਤ ਜੈਤ ਪਤ੍ਰਣੰ ਕਰੰਤ ਘਾਵ ਦੁਧਰੰ ॥",
      "transliteration": "chaha(n)t jait patrana(n) kara(n)t ghaav dhudhara(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਵਿਜੈ ਪੱਤਰ ਚਾਹੁੰਦੇ ਹਨ ਅਤੇ ਡੂੰਘੇ ਘਾਉ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "चहंत जैत पत्रणं करंत घाव दुधरं ॥",
      "sourceLineId": "98876",
      "sourceShabadId": "9224",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤੁਟੰਤ ਅਸਤ੍ਰ ਸਸਤ੍ਰਣੋ ਲਸੰਤ ਉਜਲੋ ਫਲੰ ॥੨੧੪॥",
      "transliteration": "tuTa(n)t asatr sasatrano lasa(n)t ujalo fala(n) ||214||",
      "translation": "The warriors are inflicting wounds from both the sides and are hoping to get the declaration of victory, with the breakage of weapons, their bright tips are being seen.214.",
      "punjabiViakhya": "ਅਸਤ੍ਰ ਅਤੇ ਸ਼ਸਤ੍ਰ ਟੁੱਟ ਰਹੇ ਹਨ ਅਤੇ (ਤੀਰਾ ਦੇ) ਸਫ਼ੈਦ ਫਲ ਲਿਸ਼ਕ ਰਹੇ ਹਨ ॥੨੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "तुटंत असत्र ससत्रणो लसंत उजलो फलं ॥२१४॥",
      "sourceLineId": "98877",
      "sourceShabadId": "9224",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਉਠੰਤ ਭਉਰ ਭੂਰਣੋ ਕਢੰਤ ਭੈਕਰੀ ਸੁਰੰ ॥",
      "transliteration": "auTha(n)t bhaur bhoorano kadda(n)t bhaikaree sura(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭੂਤ, ਪ੍ਰੇਤ (ਆਦਿ ਡਰਾਉਣੀਆਂ ਸ਼ਕਲਾ ਵਾਲੇ ਜੀਵ) ਉਠਦੇ ਹਨ ਅਤੇ ਭੈਦਾਇਕ ਆਵਾਜ਼ਾ ਕਢਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "उठंत भउर भूरणो कढंत भैकरी सुरं ॥",
      "sourceLineId": "98878",
      "sourceShabadId": "9224",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭਜੰਤ ਭੀਰ ਭੈਕਰੰ ਬਜੰਤ ਬੀਰ ਸੁਪ੍ਰਭੰ ॥",
      "transliteration": "bhaja(n)t bheer bhaikara(n) baja(n)t beer suprabha(n) ||",
      "translation": "The warriors rotating while roaming, are raising dreadful sounds, seeing the glory of the warriors, the cowards are running away",
      "punjabiViakhya": "ਡਰਪੋਕ ਲੋਗ ਡਰ ਕੇ ਭਜ ਰਹੇ ਹਨ ਅਤੇ ਪ੍ਰਭਾਵਸ਼ਾਲੀ ਸੂਰਮੇ ਗਰਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "भजंत भीर भैकरं बजंत बीर सुप्रभं ॥",
      "sourceLineId": "98879",
      "sourceShabadId": "9224",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤੁਟੰਤ ਤਾਲ ਤਥਿਯੰ ਨਚੰਤ ਈਸ੍ਰਣੋ ਰਣੰ ॥",
      "transliteration": "tuTa(n)t taal tathiya(n) nacha(n)t ieesrano rana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਤਥਈ ਕਰ ਕੇ ਤਾਲ ਟੁੱਟਦੇ ਹਨ ਅਤੇ ਰਣ-ਭੂਮੀ ਵਿਚ ਸ਼ਿਵ ਨਚ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "तुटंत ताल तथियं नचंत ईस्रणो रणं ॥",
      "sourceLineId": "98880",
      "sourceShabadId": "9224",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਖਹੰਤ ਖਤ੍ਰਿਣੋ ਖਗੰ ਨਿਨਦਿ ਗਦਿ ਘੁੰਘਰੰ ॥੨੧੫॥",
      "transliteration": "khaha(n)t khatirano khaga(n) ninadh gadh ghu(n)ghara(n) ||215||",
      "translation": "Shiva is engaged in Tandava dance and the daggers are colliding with one another producing various types of sounds.215.",
      "punjabiViakhya": "ਛਤ੍ਰੀਆਂ ਦੀਆਂ ਤਲਵਾਰਾ ਖੜਕ ਰਹੀਆਂ ਹਨ ਅਤੇ ਗਦਾਵਾ ਨਾਲ ਬੰਨ੍ਰਹੇ ਘੁੰਘਰੂਆਂ ਦੇ (ਇਕ-ਸੁਰ) ਧੁਨੀ ਨਿਕਲ ਰਹੀ ਹੈ ॥੨੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "खहंत खतृणो खगं निनदि गदि घुँघरं ॥२१५॥",
      "sourceLineId": "98881",
      "sourceShabadId": "9224",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭਜੰਤ ਆਸੁਰੀ ਸੁਤੰ ਉਠੰਤ ਭੈਕਰੀ ਧੁਣੰ ॥",
      "transliteration": "bhaja(n)t aasuree suta(n) uTha(n)t bhaikaree dhuna(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭਿਆਨਕ ਧੁਨ ਦੇ ਉਠਣ ਨਾਲ ਦੈਂਤਾ ਦੇ ਪੁੱਤਰ ਭਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "भजंत आसुरी सुतं उठंत भैकरी धुणं ॥",
      "sourceLineId": "98882",
      "sourceShabadId": "9224",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚਲੰਤ ਤੀਛਣੋ ਸਰੰ ਸਿਲੇਣ ਉਜਲੀ ਕ੍ਰਿਤੰ ॥",
      "transliteration": "chala(n)t teechhano sara(n) silen ujalee kirata(n) ||",
      "translation": "The sons of the demons, getting, frightened are running away and the sharp arrows are being discharged on them",
      "punjabiViakhya": "ਤਿਖੇ ਤੀਰ ਚਲ ਰਹੇ ਹਨ ਅਤੇ ਉਨ੍ਰਹਾ ਦੇ ਚਿੱਟੇ ਕੀਤੇ ਹੋਏ ਫਲ ਚਮਕਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "चलंत तीछणो सरं सिलेण उजली कृतं ॥",
      "sourceLineId": "98883",
      "sourceShabadId": "9224",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਚੰਤ ਰੰਗਿ ਜੋਗਣੰ ਚਚਕਿ ਚਉਦਣੋ ਦਿਸੰ ॥",
      "transliteration": "nacha(n)t ra(n)g jogana(n) chachak chaudhano dhisa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਜੋਗਣਾ ਨਚ ਰਹੀਆਂ ਹਨ ਅਤੇ ਚੌਦਾ ਦਿਸ਼ਾਵਾ ਵਿਚ ਚਮਕਾਰਾ ਪੈ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "नचंत रंगि जोगणं चचकि चउदणो दिसं ॥",
      "sourceLineId": "98884",
      "sourceShabadId": "9224",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਪੰਤ ਕੁੰਦਨੋ ਗਿਰੰ ਤ੍ਰਸੰਤ ਸਰਬਤੋ ਦਿਸੰ ॥੨੧੬॥",
      "transliteration": "kapa(n)t ku(n)dhano gira(n) trasa(n)t sarabato dhisa(n) ||216||",
      "translation": "The Yoginis are dancing in the fourteen directions and the Sumeru mountain are trembling.216.",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਦਿਸ਼ਾਵਾ ਡਰ ਰਹੀਆਂ ਹਨ ਅਤੇ ਸੁਮੇਰ ਪਰਬਤ ('ਕੁੰਦਨੋ ਗਿਰੰ') ਕੰਬ ਰਿਹਾ ਹੈ ॥੨੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "कपंत कुँदनो गिरं त्रसंत सरबतो दिसं ॥२१६॥",
      "sourceLineId": "98885",
      "sourceShabadId": "9224",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਚੰਤ ਬੀਰ ਬਾਵਰੰ ਖਹੰਤ ਬਾਹਣੀ ਧੁਜੰ ॥",
      "transliteration": "nacha(n)t beer baavara(n) khaha(n)t baahanee dhuja(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਵੰਜਾ ਬੀਰ ਨਚ ਰਹੇ ਹਨ ਅਤੇ ਸੈਨਾ ਦੀਆਂ ਧੁਜਾਵਾ (ਝੰਡੇ) ਆਪਸ ਵਿਚ ਖਹਿ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "नचंत बीर बावरं खहंत बाहणी धुजं ॥",
      "sourceLineId": "98886",
      "sourceShabadId": "9224",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਰੰਤ ਅਛ੍ਰਣੋ ਭਟੰ ਪ੍ਰਬੀਨ ਚੀਨ ਸੁਪ੍ਰਭੰ ॥",
      "transliteration": "bara(n)t achhrano bhaTa(n) prabeen cheen suprabha(n) ||",
      "translation": "All the warriors of Shiva are dancing and the heavenly damsels, after recognizing the fierce fighters are wedding them",
      "punjabiViakhya": "ਪ੍ਰਤਾਪੀ ਅਤੇ ਪ੍ਰਬੀਨ ਯੋਧਿਆਂ ਨੂੰ ਅਪੱਛਰਾਵਾ ਚੁਣ ਚੁਣ ਕੇ ਵਰ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "बरंत अछ्रणो भटं प्रबीन चीन सुप्रभं ॥",
      "sourceLineId": "98887",
      "sourceShabadId": "9224",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬਕੰਤ ਡਉਰ ਡਾਮਰੀ ਅਨੰਤ ਤੰਤ੍ਰਣੋ ਰਿਸੰ ॥",
      "transliteration": "baka(n)t ddaur ddaamaree ana(n)t ta(n)trano risa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਡਾਇਣਾ ਅਤੇ ਚੁੜੇਲਾ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਅਨੰਤ ਤੰਤ੍ਰ ਮੰਤ੍ਰ ਬੋਲ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "बकंत डउर डामरी अनंत तंत्रणो रिसं ॥",
      "sourceLineId": "98888",
      "sourceShabadId": "9224",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਸੰਤ ਜਛ ਗੰਧ੍ਰਬੰ ਪਿਸਾਚ ਭੂਤ ਪ੍ਰੇਤਨੰ ॥੨੧੭॥",
      "transliteration": "hasa(n)t jachh ga(n)dhraba(n) pisaach bhoot pretana(n) ||217||",
      "translation": "The witches in their fury are shouting and the yaskshas, gandharvas, imps, ghosts, fiends etc. are laughing.217.",
      "punjabiViakhya": "ਯਕਸ਼, ਗੰਧਰਬ, ਪਿਸ਼ਾਚ, ਭੂਤ ਅਤੇ ਪ੍ਰੇਤ ਹਸ ਰਹੇ ਹਨ ॥੨੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "हसंत जछ गंध्रबं पिसाच भूत प्रेतनं ॥२१७॥",
      "sourceLineId": "98889",
      "sourceShabadId": "9224",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0572_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਭਰੰਤ ਚੁਚ ਚਾਵਡੀ ਭਛੰਤ ਫਿਕ੍ਰਣੀ ਤਨੰ ॥",
      "transliteration": "bhara(n)t chuch chaavaddee bhachha(n)t fikranee tana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਗਿਰਝਾ (ਮਾਸ ਨਾਲ ਆਪਣੀਆਂ) ਚੁੰਜਾ ਭਰ ਰਹੀਆਂ ਹਨ ਅਤੇ ਗਿਦੜੀਆਂ ਲਾਸ਼ਾ ('ਤਨੰ') ਨੂੰ ਖਾਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 572,
      "hindi": "",
      "hindiTransliteration": "भरंत चुच चावडी भछंत फिक्रणी तनं ॥",
