  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0573_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਡਕੰਤ ਡਾਕਣੀ ਡੁਲੰ ਭਰੰਤ ਪਤ੍ਰ ਸ੍ਰੋਣਤੰ ॥",
      "transliteration": "ddaka(n)t ddaakanee ddula(n) bhara(n)t patr sronata(n) ||",
      "translation": "The vultures flying and revolving, are devouring flesh and the vampires are drinking blood, filling it in their bowls",
      "punjabiViakhya": "ਡਾਕਣੀ (ਰਜ ਕੇ) ਡਕਾਰ ਮਾਰਦੀਆਂ ਹੋਈਆਂ ਝੂਮ ਰਹੀਆਂ ਹਨ ਅਤੇ ਲਹੂ ਨਾਲ ਖੱਪਰ ਭਰ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "डकंत डाकणी डुलं भरंत पत्र स्रोणतं ॥",
      "sourceLineId": "98891",
      "sourceShabadId": "9224",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪਿਪੰਤ ਯਾਸਵੰ ਸੁਭੰ ਹਸੰਤ ਮਾਰਜਨੀ ਮ੍ਰਿੜੰ ॥",
      "transliteration": "pipa(n)t yaasava(n) subha(n) hasa(n)t maarajanee miraRa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾਕਾਲ ('ਮ੍ਰਿੜੰ') ਅਤੇ ਕਾਲਿਕਾ ('ਮਾਰਜਨੀ') ਹੱਸ ਹੱਸ ਕੇ (ਖੱਪਰਾ ਵਿਚਲੇ ਲਹੂ ਨੂੰ) ਸ਼ੁਭ ਮਦਿਰਾ ਸਮਝ ਕੇ ਪੀ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "पिपंत यासवं सुभं हसंत मारजनी मृड़ं ॥",
      "sourceLineId": "98892",
      "sourceShabadId": "9224",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਟੁਟ ਹਾਸਣੋ ਹਸੰ ਖਿਮੰਤ ਉਜਲੋ ਅਸੰ ॥੨੧੮॥",
      "transliteration": "aTuT haasano hasa(n) khima(n)t ujalo asa(n) ||218||",
      "translation": "The female ghosts and fiends are laughing while drinking blood and the luster of the swords is being seen and the continued laughter is being heard in the battlefield.218.",
      "punjabiViakhya": "(ਯੁੱਧ-ਭੂਮੀ ਵਿਚ) ਖਿੜ ਖਿੜਾ ਕੇ ਨਿਰੰਤਰ ਹਸਿਆ ਜਾ ਰਿਹਾ ਹੈ ਅਤੇ ਸਫ਼ੈਦ ਤਲਵਾਰਾ ਲਿਸ਼ਕ ਰਹੀਆਂ ਹਨ ॥੨੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "अटुट हासणो हसं खिमंत उजलो असं ॥२१८॥",
      "sourceLineId": "98893",
      "sourceShabadId": "9224",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਕਵਾ ਛੰਦ ॥",
      "transliteration": "akavaa chha(n)dh ||",
      "translation": "AKWA STANZA",
      "punjabiViakhya": "ਅਕਵਾ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "अकवा छंद ॥",
      "sourceLineId": "98894",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜੁਟੇ ਵੀਰੰ ॥",
      "transliteration": "juTe veera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੂਰਵੀਰ ਜੁੱਟੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "जुटे वीरं ॥",
      "sourceLineId": "98895",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਛੁਟੇ ਤੀਰੰ ॥",
      "transliteration": "chhuTe teera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ ਛੁਟ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "छुटे तीरं ॥",
      "sourceLineId": "98896",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜੁਝੇ ਤਾਜੀ ॥",
      "transliteration": "jujhe taajee ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜੇ ਜੂਝ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "जुझे ताजी ॥",
      "sourceLineId": "98897",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਡਿਗੇ ਗਾਜੀ ॥੨੧੯॥",
      "transliteration": "ddige gaajee ||219||",
      "translation": "The warriors fought, the arrows were discharged, the horses died and the fighters fell down.219.",
      "punjabiViakhya": "ਅਤੇ ਸੂਰਮੇ ਡਿਗ ਰਹੇ ਹਨ ॥੨੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "डिगे गाजी ॥२१९॥",
      "sourceLineId": "98898",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਜੇ ਜੁਆਣੰ ॥",
      "transliteration": "baje juaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੁਆਨ (ਆਪਸ ਵਿਚ) ਵਜ ਰਹੇ ਹਨ (ਭਾਵ ਲੜ ਰਹੇ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "बजे जुआणं ॥",
      "sourceLineId": "98899",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਾਹੇ ਬਾਣੰ ॥",
      "transliteration": "baahe baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣ ਚਲਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "बाहे बाणं ॥",
      "sourceLineId": "98900",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰੁਝੇ ਜੰਗੰ ॥",
      "transliteration": "rujhe ja(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੰਗ ਵਿਚ ਰੁਝੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "रुझे जंगं ॥",
      "sourceLineId": "98901",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੁਝੇ ਅੰਗੰ ॥੨੨੦॥",
      "transliteration": "jujhe a(n)ga(n) ||220||",
      "translation": "The soldiers discharging their arrows and being absorbed in the war are fighting with various limbs.220.",
      "punjabiViakhya": "ਅੰਗ ਪ੍ਰਤਿ ਅੰਗ ਜੂਝ ਰਹੇ ਹਨ ॥੨੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "जुझे अंगं ॥२२०॥",
      "sourceLineId": "98902",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤੁਟੇ ਤੰਗੰ ॥",
      "transliteration": "tuTe ta(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜਿਆਂ ਦੇ ਤੰਗ ਟੁੱਟ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "तुटे तंगं ॥",
      "sourceLineId": "98903",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਫੁਟੇ ਅੰਗੰ ॥",
      "transliteration": "fuTe a(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਗ ਫੁੱਟ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "फुटे अंगं ॥",
      "sourceLineId": "98904",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਜੇ ਸੂਰੰ ॥",
      "transliteration": "saje soora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਸੱਜੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "सजे सूरं ॥",
      "sourceLineId": "98905",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਘੁੰਮੀ ਹੂਰੰ ॥੨੨੧॥",
      "transliteration": "ghu(n)mee hoora(n) ||221||",
      "translation": "The swords are broken, the limbs are heavenly damsels are roaming for wedding them.221.",
      "punjabiViakhya": "ਹੂਰਾ ਘੁੰਮ ਰਹੀਆਂ ਹਨ ॥੨੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "घुँमी हूरं ॥२२१॥",
      "sourceLineId": "98906",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜੁਝੇ ਹਾਥੀ ॥",
      "transliteration": "jujhe haathee ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਥੀ ਜੂਝ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "जुझे हाथी ॥",
      "sourceLineId": "98907",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰੁਝੇ ਸਾਥੀ ॥",
      "transliteration": "rujhe saathee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਥੀ (ਸਾਥੀ ਨਾਲ ਜੰਗ-ਕਰਮ ਵਿਚ) ਰੁਝੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "रुझे साथी ॥",
      "sourceLineId": "98908",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਉਭੇ ਉਸਟੰ ॥",
      "transliteration": "aubhe usaTa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਚੇ ਆਕਾਰ ਵਾਲੇ ਊਠ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "उभे उसटं ॥",
      "sourceLineId": "98909",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੁਭੇ ਪੁਸਟੰ ॥੨੨੨॥",
      "transliteration": "subhe pusaTa(n) ||222||",
      "translation": "The elephants are engaged in fighting with other elephants, the camels, very high, are absorbed in fighting with other powerful camels.222.",
      "punjabiViakhya": "ਬੜੀ ਤਕੜੀ (ਡੀਲ ਡੌਲ ਵਾਲੇ) ਸ਼ੋਭ ਰਹੇ ਹਨ ॥੨੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "सुभे पुसटं ॥२२२॥",
      "sourceLineId": "98910",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਫੁਟੇ ਬੀਰੰ ॥",
      "transliteration": "fuTe beera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਘਾਇਲ ਹੋ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "फुटे बीरं ॥",
      "sourceLineId": "98911",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਛੁਟੇ ਤੀਰੰ ॥",
      "transliteration": "chhuTe teera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ ਛੁਟ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "छुटे तीरं ॥",
      "sourceLineId": "98912",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਡਿਗੇ ਭੂਮੰ ॥",
      "transliteration": "ddige bhooma(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਧਰਤੀ ਉਤੇ ਡਿਗ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "डिगे भूमं ॥",
      "sourceLineId": "98913",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਉਠੇ ਘੂਮੰ ॥੨੨੩॥",
      "transliteration": "auThe ghooma(n) ||223||",
      "translation": "With the discharge of arrows, the warriors being chopped are falling on the ground, they are getting up again.223.",
      "punjabiViakhya": "ਘੁੰਮੇਰੀ ਖਾ ਕੇ ਉਠ ਰਹੇ ਹਨ ॥੨੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "उठे घूमं ॥२२३॥",
      "sourceLineId": "98914",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਕੈ ਮਾਰੰ ॥",
      "transliteration": "bakai maara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਰੋ-ਮਾਰੋ ਬੋਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "बकै मारं ॥",
      "sourceLineId": "98915",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਚਕੈ ਚਾਰੰ ॥",
      "transliteration": "chakai chaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਚਾਰੇ ਚੱਕ ਹੈਰਾਨ ਹੋ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "चकै चारं ॥",
      "sourceLineId": "98916",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਜੈ ਸਸਤ੍ਰੰ ॥",
      "transliteration": "sajai sasatra(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰ ਸਜ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "सजै ससत्रं ॥",
      "sourceLineId": "98917",
      "sourceShabadId": "9225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0573_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਜੈ ਅਸਤ੍ਰੰ ॥੨੨੪॥",
      "transliteration": "bajai asatra(n) ||224||",
      "translation": "They are shouting “kill, kill” in all the four directions and bedecking themselves, they are striking their weapons.224.",
      "punjabiViakhya": "ਅਤੇ ਅਸਤ੍ਰ (ਇਕ ਦੂਜੇ ਨੂੰ) ਵਜ ਰਹੇ ਹਨ ॥੨੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 573,
      "hindi": "",
      "hindiTransliteration": "बजै असत्रं ॥२२४॥",
