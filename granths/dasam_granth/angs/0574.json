{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 574,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0574_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਰੰਬੀਰ ਉਠਤ ॥",
      "transliteration": "bara(n)beer uThat ||",
      "translation": "",
      "punjabiViakhya": "ਬਲਵਾਨ ਸੂਰਮੇ ਉਠਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "बरंबीर उठत ॥",
      "sourceLineId": "98939",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਨੰ ਤ੍ਰਾਨ ਫੁਟਤ ॥੨੨੯॥",
      "transliteration": "tana(n) traan fuTat ||229||",
      "translation": "Where the warriors are fighting and the arrows are being discharged, there the warriors get up and their armours, being shattered are falling down.229.",
      "punjabiViakhya": "ਕਵਚ ਫੁਟ ਰਹੇ ਹਨ ॥੨੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "तनं त्रान फुटत ॥२२९॥",
      "sourceLineId": "98940",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਣੰ ਬੀਰ ਗਿਰਤ ॥",
      "transliteration": "rana(n) beer girat ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ (ਯੁੱਧ-ਭੂਮੀ ਵਿਚ) ਡਿਗਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "रणं बीर गिरत ॥",
      "sourceLineId": "98941",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭਵੰ ਸਿੰਧੁ ਤਰਤ ॥",
      "transliteration": "bhava(n) si(n)dh tarat ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਸਾਰ ਸਾਗਰ ਤੋਂ ਤਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "भवं सिंधु तरत ॥",
      "sourceLineId": "98942",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਭੰ ਹੂਰ ਫਿਰਤ ॥",
      "transliteration": "nabha(n) hoor firat ||",
      "translation": "",
      "punjabiViakhya": "ਆਕਾਸ਼ ਵਿਚ ਹੂਰਾ ਘੁੰਮ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "नभं हूर फिरत ॥",
      "sourceLineId": "98943",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਰੰ ਬੀਰ ਬਰਤ ॥੨੩੦॥",
      "transliteration": "bara(n) beer barat ||230||",
      "translation": "The warriors falling down in the war-arena are ferrying across the ocean of fear and the heavenly damsels roaming in the sky, are wedding the warriors.230.",
      "punjabiViakhya": "ਸ੍ਰੇਸ਼ਠ ਸੂਰਮਿਆਂ ਨੂੰ ਵਿਆਹ ਰਹੀਆਂ ਹਨ ॥੨੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "बरं बीर बरत ॥२३०॥",
      "sourceLineId": "98944",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਣ ਨਾਦ ਬਜਤ ॥",
      "transliteration": "ran naadh bajat ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਮਾਰੂ ਨਾਦ ਵਜ ਰਿਹਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "रण नाद बजत ॥",
      "sourceLineId": "98945",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੁਣਿ ਭੀਰ ਭਜਤ ॥",
      "transliteration": "sun bheer bhajat ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ) ਸੁਣ ਕੇ ਕਾਇਰ ਭਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "सुणि भीर भजत ॥",
      "sourceLineId": "98946",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰਣ ਭੂਮਿ ਤਜਤ ॥",
      "transliteration": "ran bhoom tajat ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਨੂੰ ਛਡ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "रण भूमि तजत ॥",
      "sourceLineId": "98947",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਨ ਮਾਝ ਲਜਤ ॥੨੩੧॥",
      "transliteration": "man maajh lajat ||231||",
      "translation": "Listening to the musical instruments of the battlefield, the cowards are running away and abandoning the battlefield, they are feeling shy.231.",
      "punjabiViakhya": "ਮਨ ਵਿਚ ਸ਼ਰਮ ਮਹਿਸੂਸ ਕਰ ਰਹੇ ਹਨ ॥੨੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "मन माझ लजत ॥२३१॥",
      "sourceLineId": "98948",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਫਿਰਿ ਫੇਰਿ ਲਰਤ ॥",
      "transliteration": "fir fer larat ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਪਰਤ ਕੇ ਲੜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "फिरि फेरि लरत ॥",
      "sourceLineId": "98949",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਣ ਜੁਝਿ ਮਰਤ ॥",
      "transliteration": "ran jujh marat ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ ਵਿਚ ਜੂਝ ਕੇ ਮਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "रण जुझि मरत ॥",
      "sourceLineId": "98950",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਹਿ ਪਾਵ ਟਰਤ ॥",
      "transliteration": "neh paav Tarat ||",
      "translation": "",
      "punjabiViakhya": "ਕਦਮ ਪਿਛੇ ਨਹੀਂ ਕਰਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "नहि पाव टरत ॥",
      "sourceLineId": "98951",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਭਵ ਸਿੰਧੁ ਤਰਤ ॥੨੩੨॥",
      "transliteration": "bhav si(n)dh tarat ||232||",
      "translation": "The warriors are again rotating and embracing death by fighting, they do not retrace even one step from the battlefield and are ferrying across the dreadful ocean of Samsara by dying.232.",
      "punjabiViakhya": "ਸੰਸਾਰ ਸਾਗਰ ਨੂੰ ਤਰਦੇ ਹਨ ॥੨੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "भव सिंधु तरत ॥२३२॥",
      "sourceLineId": "98952",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਣ ਰੰਗਿ ਮਚਤ ॥",
      "transliteration": "ran ra(n)g machat ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਦੇ ਰੰਗ ਵਿਚ ਮਚੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "रण रंगि मचत ॥",
      "sourceLineId": "98953",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚਤੁਰੰਗ ਫਟਤ ॥",
      "transliteration": "chatura(n)g faTat ||",
      "translation": "",
      "punjabiViakhya": "ਚਤੁਰੰਗਨੀ ਸੈਨਾ ਘਾਇਲ ਹੋ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "चतुरंग फटत ॥",
      "sourceLineId": "98954",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਰਬੰਗ ਲਟਤ ॥",
      "transliteration": "saraba(n)g laTat ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਪੱਖੋਂ ਲੜਖੜਾ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "सरबंग लटत ॥",
      "sourceLineId": "98955",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਨਿ ਮਾਨ ਘਟਤ ॥੨੩੩॥",
      "transliteration": "man maan ghaTat ||233||",
      "translation": "In the dreadful war, the fourfold army was scattered into fragments and because of the infliction of wounds on the bodies of the warriors, their honour and respect declined.233.",
      "punjabiViakhya": "ਮਨ ਵਿਚੋਂ ਹੰਕਾਰ ਘਟ ਰਿਹਾ ਹੈ ॥੨੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "मनि मान घटत ॥२३३॥",
      "sourceLineId": "98956",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਰ ਬੀਰ ਭਿਰਤ ॥",
      "transliteration": "bar beer bhirat ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੇਸ਼ਠ ਯੋਧੇ ਲੜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "बर बीर भिरत ॥",
      "sourceLineId": "98957",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਹੀ ਨੈਕੁ ਫਿਰਤ ॥",
      "transliteration": "nahee naik firat ||",
      "translation": "",
      "punjabiViakhya": "ਜ਼ਰਾ ਜਿੰਨੇ ਵੀ ਪਿਛੇ ਨਹੀਂ ਹਟਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "नही नैकु फिरत ॥",
      "sourceLineId": "98958",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਬ ਚਿਤ ਚਿਰਤ ॥",
      "transliteration": "jab chit chirat ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ (ਉਨ੍ਰਹਾ ਦਾ) ਚਿਤ ਚਿੜ੍ਰਹ ਜਾਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "जब चित चिरत ॥",
      "sourceLineId": "98959",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਉਠਿ ਸੈਨ ਘਿਰਤ ॥੨੩੪॥",
      "transliteration": "auTh sain ghirat ||234||",
      "translation": "Without retracing their steps even slightly, the warriors are fighting and in anger, they are besieging the army.234.",
      "punjabiViakhya": "ਤਾ ਉਠ ਕੇ ਸੈਨਾ ਨੂੰ ਘੇਰ ਲੈਂਦੇ ਹਨ ॥੨੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "उठि सैन घिरत ॥२३४॥",
      "sourceLineId": "98960",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗਿਰ ਭੂਮਿ ਪਰਤ ॥",
      "transliteration": "gir bhoom parat ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ ਉਤੇ ਡਿਗ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "गिर भूमि परत ॥",
      "sourceLineId": "98961",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0574_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੁਰ ਨਾਰਿ ਬਰਤ ॥",
      "transliteration": "sur naar barat ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵ ਇਸਤਰੀਆਂ (ਉਨ੍ਰਹਾ ਨੂੰ) ਵਿਆਹ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 574,
      "hindi": "",
      "hindiTransliteration": "सुर नारि बरत ॥",
      "sourceLineId": "98962",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
