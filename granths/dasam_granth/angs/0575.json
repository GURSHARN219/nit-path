{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 575,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0575_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਹੀ ਪਾਵ ਟਰਤ ॥",
      "transliteration": "nahee paav Tarat ||",
      "translation": "",
      "punjabiViakhya": "ਪੈਰ ਪਿਛੇ ਨਹੀਂ ਮੋੜਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "नही पाव टरत ॥",
      "sourceLineId": "98963",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਨਿ ਕੋਪ ਭਰਤ ॥੨੩੫॥",
      "transliteration": "man kop bharat ||235||",
      "translation": "They fall down on the earth after dying and the women of gods are wedding them, the warriors getting enraged in their mind, do not retrace even one step.235.",
      "punjabiViakhya": "ਮਨ ਵਿਚ ਕ੍ਰੋਧ ਭਰਦੇ ਹਨ ॥੨੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "मनि कोप भरत ॥२३५॥",
      "sourceLineId": "98964",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਰ ਕੋਪ ਮੰਡਤ ॥",
      "transliteration": "kar kop ma(n)ddat ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਯੁੱਧ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "कर कोप मंडत ॥",
      "sourceLineId": "98965",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਗ ਦ੍ਵੈ ਨ ਭਜਤ ॥",
      "transliteration": "pag dhavai na bhajat ||",
      "translation": "",
      "punjabiViakhya": "ਦੋ ਕਦਮ ਵੀ ਪਿਛੇ ਨਹੀਂ ਹਟਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "पग द्वै न भजत ॥",
      "sourceLineId": "98966",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਰਿ ਰੋਸ ਲਰਤ ॥",
      "transliteration": "kar ros larat ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਕਰ ਕੇ ਲੜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "करि रोस लरत ॥",
      "sourceLineId": "98967",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗਿਰ ਭੂਮਿ ਪਰਤ ॥੨੩੬॥",
      "transliteration": "gir bhoom parat ||236||",
      "translation": "Getting infuriated, the warriors do not run for two steps and fighting in anger, they fall on the ground.236.",
      "punjabiViakhya": "(ਅੰਤ ਵਿਚ ਮਾਰੇ ਜਾ ਕੇ) ਧਰਤੀ ਉਤੇ ਡਿਗ ਪੈਂਦੇ ਹਨ ॥੨੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "गिर भूमि परत ॥२३६॥",
      "sourceLineId": "98968",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਣ ਨਾਦ ਬਜਤ ॥",
      "transliteration": "ran naadh bajat ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਵਿਚ ਨਾਦ ਵਜਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "रण नाद बजत ॥",
      "sourceLineId": "98969",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੁਣਿ ਮੇਘ ਲਜਤ ॥",
      "transliteration": "sun megh lajat ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਦੀ ਧੁਨ ਨੂੰ) ਸੁਣ ਕੇ ਬਦਲ ਸ਼ਰਮਿੰਦੇ ਹੁੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "सुणि मेघ लजत ॥",
      "sourceLineId": "98970",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਭ ਸਾਜ ਸਜਤ ॥",
      "transliteration": "sabh saaj sajat ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ (ਸੂਰਮੇ) ਸਾਜ਼ਾ ਨਾਲ ਸਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "सभ साज सजत ॥",
      "sourceLineId": "98971",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪਗ ਦ੍ਵੈ ਨ ਭਜਤ ॥੨੩੭॥",
      "transliteration": "pag dhavai na bhajat ||237||",
      "translation": "Because of the sound of the musical instruments of the battlefield the clouds are feeling shy and the bedecked warriors are not retracing, even slightly.237.",
      "punjabiViakhya": "ਦੋ ਕਦਮ ਵੀ (ਪਿਛੇ ਨੂੰ) ਨਹੀਂ ਭਜਦੇ ॥੨੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "पग द्वै न भजत ॥२३७॥",
      "sourceLineId": "98972",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਣਿ ਚਕ੍ਰ ਚਲਤ ॥",
      "transliteration": "ran chakr chalat ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਚੱਕਰ ਚਲਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "रणि चक्र चलत ॥",
      "sourceLineId": "98973",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦੁਤਿ ਮਾਨ ਦਲਤ ॥",
      "transliteration": "dhut maan dhalat ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਦੀ ਲਿਸ਼ਕ) ਪ੍ਰਕਾਸ਼ ('ਦੁਤਿ') ਦੇ ਮਾਣ ਨੂੰ ਵੀ ਨੀਵਾ ਵਿਖਾ ਦਿੰਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "दुति मान दलत ॥",
      "sourceLineId": "98974",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗਿਰਿ ਮੇਰੁ ਹਲਤ ॥",
      "transliteration": "gir mer halat ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਮੇਰ ਪਰਬਤ ਹਿਲ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "गिरि मेरु हलत ॥",
      "sourceLineId": "98975",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਭਟ ਸ੍ਰੋਣ ਪਲਤ ॥੨੩੮॥",
      "transliteration": "bhaT sron palat ||238||",
      "translation": "The striking discs are shattering the glory and pride of the warriors, because of the dreadfulness of war, the Sumeru mountain has also trembled and the steam of the blood of the warriors is flowing.238.",
      "punjabiViakhya": "ਸੂਰਮੇ ਲਹੂ ਨਾਲ ਲਥ ਪਥ ਹਨ ॥੨੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "भट स्रोण पलत ॥२३८॥",
      "sourceLineId": "98976",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਣ ਰੰਗਿ ਮਚਤ ॥",
      "transliteration": "ran ra(n)g machat ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਦਾ ਰੰਗ ਜੰਮ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "रण रंगि मचत ॥",
      "sourceLineId": "98977",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਰ ਬੰਬ ਬਜਤ ॥",
      "transliteration": "bar ba(n)b bajat ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਡੇ ਧੌਂਸੇ ਵਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "बर बंब बजत ॥",
      "sourceLineId": "98978",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਣ ਖੰਭ ਗਡਤਿ ॥",
      "transliteration": "ran kha(n)bh gaddat ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਰਣ ਵਿਚ ਖੰਭੇ (ਵਾਗ) ਗਡੇ ਜਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "रण खंभ गडति ॥",
      "sourceLineId": "98979",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਸਿਵਾਰ ਮੰਡਤ ॥੨੩੯॥",
      "transliteration": "asivaar ma(n)ddat ||239||",
      "translation": "The dreadful war is going on with terrible explosions and the horse-riders are fixing their columns of victory.239.",
      "punjabiViakhya": "ਤਲਵਾਰ-ਧਾਰੀ ('ਅਸਿਵਾਰ') ਯੁੱਧ ਮੰਡ ਦਿੰਦੇ ਹਨ ॥੨੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "असिवार मंडत ॥२३९॥",
      "sourceLineId": "98980",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕ੍ਰਿਪਾਨ ਕਿਰਤ ॥",
      "transliteration": "kirapaan kirat ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਧਾਰੀ (ਯੋਧੇ) ਕਰਤਬ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "कृपान किरत ॥",
      "sourceLineId": "98981",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਰਿ ਕੋਪ ਭਿਰਤ ॥",
      "transliteration": "kar kop bhirat ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਕਰ ਕੇ ਲੜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "करि कोप भिरत ॥",
      "sourceLineId": "98982",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਹੀ ਫਿਰੈ ਫਿਰਤ ॥",
      "transliteration": "nahee firai firat ||",
      "translation": "",
      "punjabiViakhya": "ਮੋੜਿਆਂ ਮੁੜਦੇ ਨਹੀਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "नही फिरै फिरत ॥",
      "sourceLineId": "98983",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਤਿ ਚਿਤ ਚਿਰਤ ॥੨੪੦॥",
      "transliteration": "at chit chirat ||240||",
      "translation": "Holding their swords in fury, the warriors are fighting and fighting with the strength of their mind, they are not moving back.240.",
      "punjabiViakhya": "ਚਿਤ ਵਿਚ ਬਹੁਤ ਖਿਝਦੇ (ਚਿੜ੍ਰਹਦੇ) ਹਨ ॥੨੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "अति चित चिरत ॥२४०॥",
      "sourceLineId": "98984",
      "sourceShabadId": "9227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚਾਚਰੀ ਛੰਦ ॥",
      "transliteration": "chaacharee chha(n)dh ||",
      "translation": "CHAACHARI STANZA",
      "punjabiViakhya": "ਚਾਚਰੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "चाचरी छंद ॥",
      "sourceLineId": "98985",
      "sourceShabadId": "9228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹਕਾਰੈ ॥",
      "transliteration": "hakaarai ||",
      "translation": "",
      "punjabiViakhya": "(ਯੋਧੇ ਇਕ ਦੂਜੇ ਨੂੰ) ਬੁਲਾਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "हकारै ॥",
      "sourceLineId": "98986",
      "sourceShabadId": "9228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪ੍ਰਚਾਰੈ ॥",
      "transliteration": "prachaarai ||",
      "translation": "",
      "punjabiViakhya": "ਲਲਕਾਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "प्रचारै ॥",
      "sourceLineId": "98987",
      "sourceShabadId": "9228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪ੍ਰਹਾਰੈ ॥",
      "transliteration": "prahaarai ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "प्रहारै ॥",
      "sourceLineId": "98988",
      "sourceShabadId": "9228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਰਵਾਰੈ ॥੨੪੧॥",
      "transliteration": "karavaarai ||241||",
      "translation": "The warriors are challenging and shouting, they are striking blows with their swords.241.",
      "punjabiViakhya": "ਵਾਰ ਕਰਦੇ ਹਨ ॥੨੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "करवारै ॥२४१॥",
      "sourceLineId": "98989",
      "sourceShabadId": "9228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਉਠਾਵੈ ॥",
      "transliteration": "auThaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਸ਼ਸਤ੍ਰ) ਉਠਾਉਾਂਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "उठावै ॥",
      "sourceLineId": "98990",
      "sourceShabadId": "9228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦਿਖਾਵੈ ॥",
      "transliteration": "dhikhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਖਾਉਾਂਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 575,
      "hindi": "",
      "hindiTransliteration": "दिखावै ॥",
      "sourceLineId": "98991",
      "sourceShabadId": "9228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0575_line_0030",
      "lineIndex": 30,
