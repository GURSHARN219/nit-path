      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0576_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਿ ਜੁਟੈਤ ਬੀਰੰ ॥",
      "transliteration": "k juTait beera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸੂਰਮੇ (ਯੁੱਧ ਵਿਚ) ਜੁਟੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 576,
      "hindi": "",
      "hindiTransliteration": "कि जुटैत बीरं ॥",
      "sourceLineId": "99047",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
