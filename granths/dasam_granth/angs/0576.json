      "lineIndex": 35,
      "gurmukhi": "ਉਥਕੈ ॥੨੫੫॥",
      "transliteration": "authakai ||255||",
      "translation": "The warriors striking blows, are bowing, challenging and getting up again.255.",
      "punjabiViakhya": "ਅਤੇ ਉਛਲ ਕੇ (ਮਾਰ) ਦਿੰਦੇ ਹਨ ॥੨੫੫॥",
      "source": "DASAM_GRANTH",
      "ang": 576,
      "hindi": "",
      "hindiTransliteration": "उथकै ॥२५५॥",
