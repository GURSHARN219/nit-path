      "translation": "",
      "punjabiViakhya": "ਤੀਰਾ ਨੂੰ ਛਡਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 576,
      "hindi": "",
      "hindiTransliteration": "कि छुटैत तीरं ॥",
