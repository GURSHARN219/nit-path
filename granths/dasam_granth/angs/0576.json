      "translation": "BHAGAUTI STANZA",
      "punjabiViakhya": "ਭਗਉਤੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 576,
      "hindi": "",
      "hindiTransliteration": "भगउती छंद ॥",
      "sourceLineId": "99046",
