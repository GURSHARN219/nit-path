      "lineIndex": 43,
      "gurmukhi": "ਕਿ ਬਜੈਤ ਖਗੰ ॥",
      "transliteration": "k bajait khaga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਵਜਦੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 576,
      "hindi": "",
      "hindiTransliteration": "कि बजैत खगं ॥",
      "sourceLineId": "99053",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
