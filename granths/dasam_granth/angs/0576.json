      "sourceLineId": "99055",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0576_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਿ ਰੁਝੇਤਿ ਜੰਗੰ ॥",
