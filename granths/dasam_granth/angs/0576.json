      "transliteration": "k nachet taajee ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜੇ ਨਚ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 576,
      "hindi": "",
      "hindiTransliteration": "कि नचेति ताजी ॥",
      "sourceLineId": "99057",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
