      "source": "DASAM_GRANTH",
      "ang": 576,
      "hindi": "",
      "hindiTransliteration": "कि फुटैत अंगं ॥",
      "sourceLineId": "99049",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
