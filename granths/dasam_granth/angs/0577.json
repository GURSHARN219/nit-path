{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 577,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0577_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਿ ਘਲੈਤਿ ਘਾਯੰ ॥",
      "transliteration": "k ghalait ghaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਘਾਉ ਲਗਾਉਾਂਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि घलैति घायं ॥",
      "sourceLineId": "99059",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਿ ਝਲੇਤਿ ਚਾਯੰ ॥",
      "transliteration": "k jhalet chaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਦੂਜਿਆਂ ਦੇ ਘਾਉਆਂ ਨੂੰ) ਚਾਉ ਨਾਲ ਝਲਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि झलेति चायं ॥",
      "sourceLineId": "99060",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਿ ਡਿਗੈਤਿ ਧੁਮੀ ॥",
      "transliteration": "k ddigait dhumee ||",
      "translation": "",
      "punjabiViakhya": "ਧੜੰਮ ਕਰਕੇ ਡਿਗਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि डिगैति धुमी ॥",
      "sourceLineId": "99061",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਿ ਝੁਮੈਤਿ ਝੁਮੀ ॥੨੫੯॥",
      "transliteration": "k jhumait jhumee ||259||",
      "translation": "The blows are being endured with pleasure, the warriors are falling down while swinging and thundering.259.",
      "punjabiViakhya": "ਅਤੇ (ਘਾਇਲ ਹੋ ਕੇ) ਝੂਮਦੇ ਹੋਏ ਨਿਉਾਂਦੇ ਹਨ ॥੨੫੯॥",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि झुमैति झुमी ॥२५९॥",
      "sourceLineId": "99062",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਿ ਛਡੈਤਿ ਹੂਹੰ ॥",
      "transliteration": "k chhaddait hooha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ (ਘਾਇਲ ਯੋਧੇ) ਹੂੰਗਰਾ ਛਡਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि छडैति हूहं ॥",
      "sourceLineId": "99063",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਿ ਸੁਭੇਤਿ ਬ੍ਰਯੂਹੰ ॥",
      "transliteration": "k subhet brayooha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਯੂਹ (ਘੇਰੇ) ਵਿਚ ਸ਼ੋਭਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि सुभेति ब्रयूहं ॥",
      "sourceLineId": "99064",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਿ ਡਿਗੈਤਿ ਚੇਤੰ ॥",
      "transliteration": "k ddigait cheta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਡਿਗੇ ਹੋਏ ਸਚੇਤ ਹੁੰਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि डिगैति चेतं ॥",
      "sourceLineId": "99065",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਿ ਨਚੇਤਿ ਪ੍ਰੇਤੰ ॥੨੬੦॥",
      "transliteration": "k nachet preta(n) ||260||",
      "translation": "Contacting the numberless spirits, the warriors are lamenting, they are getting unconscious and falling down, the ghosts are dancing.260.",
      "punjabiViakhya": "ਅਤੇ ਭੂਤ ਪ੍ਰੇਤ ਨਚਦੇ ਹਨ ॥੨੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि नचेति प्रेतं ॥२६०॥",
      "sourceLineId": "99066",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਿ ਬੁਠੇਤਿ ਬਾਣੰ ॥",
      "transliteration": "k buThet baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਬਾਣਾ ਦੀ ਬਰਖਾ ਕਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि बुठेति बाणं ॥",
      "sourceLineId": "99067",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਿ ਜੁਝੇਤਿ ਜੁਆਣੰ ॥",
      "transliteration": "k jujhet juaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੁਆਨ ਜੂਝਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि जुझेति जुआणं ॥",
      "sourceLineId": "99068",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਿ ਮਥੇਤਿ ਨੂਰੰ ॥",
      "transliteration": "k mathet noora(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ) ਮਥੇ ਉਤੇ ਨੂਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि मथेति नूरं ॥",
      "sourceLineId": "99069",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਿ ਤਕੇਤਿ ਹੂਰੰ ॥੨੬੧॥",
      "transliteration": "k taket hoora(n) ||261||",
      "translation": "The warriors are fighting catching hold of arrows, the beauty is resplendent on all the faces and the heavenly damsels are looking at the warriors.261.",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੂੰ) ਹੂਰਾ (ਵਰਨ ਲਈ) ਤਕ ਰਹੀਆਂ ਹਨ ॥੨੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि तकेति हूरं ॥२६१॥",
      "sourceLineId": "99070",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਿ ਜੁਜੇਤਿ ਹਾਥੀ ॥",
      "transliteration": "k jujet haathee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਹਾਥੀਆਂ ਉਤੇ ਚੜ੍ਰਹ ਕੇ ਜੂਝਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि जुजेति हाथी ॥",
      "sourceLineId": "99071",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਿ ਸਿਝੇਤਿ ਸਾਥੀ ॥",
      "transliteration": "k sijhet saathee ||",
      "translation": "",
      "punjabiViakhya": "(ਨਾਲ ਵਾਲੇ) ਸਾਥੀ ਮਾਰੇ ਗਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि सिझेति साथी ॥",
      "sourceLineId": "99072",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਿ ਭਗੇਤਿ ਵੀਰੰ ॥",
      "transliteration": "k bhaget veera(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸੂਰਮੇ ਭਜ ਗਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि भगेति वीरं ॥",
      "sourceLineId": "99073",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਿ ਲਗੇਤਿ ਤੀਰੰ ॥੨੬੨॥",
      "transliteration": "k laget teera(n) ||262||",
      "translation": "The warriors are fighting with the elephants after killing the enemies, they are running away after being hit by the arrows.262.",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨੂੰ) ਤੀਰ ਵਜੇ ਹਨ ॥੨੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि लगेति तीरं ॥२६२॥",
      "sourceLineId": "99074",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਿ ਰਜੇਤਿ ਰੋਸੰ ॥",
      "transliteration": "k rajet rosa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਕ੍ਰੋਧ ਨਾਲ ਰਜੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि रजेति रोसं ॥",
      "sourceLineId": "99075",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਿ ਤਜੇਤਿ ਹੋਸੰ ॥",
      "transliteration": "k tajet hosa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਸ਼ ਨੂੰ ਤਿਆਗ ਚੁਕੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि तजेति होसं ॥",
      "sourceLineId": "99076",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਿ ਖੁਲੇਤਿ ਕੇਸੰ ॥",
      "transliteration": "k khulet kesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕੇਸ ਖੁਲੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि खुलेति केसं ॥",
      "sourceLineId": "99077",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਿ ਡੁਲੇਤਿ ਭੇਸੰ ॥੨੬੩॥",
      "transliteration": "k ddulet bhesa(n) ||263||",
      "translation": "The warriors are lying down unconscious and in their fury, their hair have been loosened and their attires have been damaged.263.",
      "punjabiViakhya": "ਮੰਦੇ ਹਾਲ ਫਿਰ ਰਹੇ ਹਨ ॥੨੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि डुलेति भेसं ॥२६३॥",
      "sourceLineId": "99078",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਿ ਜੁਝੇਤਿ ਹਾਥੀ ॥",
      "transliteration": "k jujhet haathee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਹਾਥੀ ਉਤੇ ਚੜ੍ਰਹ ਕੇ ਲੜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि जुझेति हाथी ॥",
      "sourceLineId": "99079",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਿ ਲੁਝੇਤਿ ਸਾਥੀ ॥",
      "transliteration": "k lujhet saathee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ) ਸਾਥੀ ਲੜ ਕੇ ਮਰ ਗਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि लुझेति साथी ॥",
      "sourceLineId": "99080",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਿ ਛੁਟੇਤਿ ਤਾਜੀ ॥",
      "transliteration": "k chhuTet taajee ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜੇ ਛੁਟ ਗਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि छुटेति ताजी ॥",
      "sourceLineId": "99081",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਿ ਗਜੇਤਿ ਗਾਜੀ ॥੨੬੪॥",
      "transliteration": "k gajet gaajee ||264||",
      "translation": "The worriers have been destroyed while fighting with the elephants, the horses are roaming openly and the worriers are thundering. 264.",
      "punjabiViakhya": "ਸੂਰਮੇ ਲਲਕਾਰੇ ਮਾਰ ਰਹੇ ਹਨ ॥੨੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि गजेति गाजी ॥२६४॥",
      "sourceLineId": "99082",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਿ ਘੁੰਮੀਤਿ ਹੂਰੰ ॥",
      "transliteration": "k ghu(n)meet hoora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਹੂਰਾ ਘੁੰਮ ਰਹੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि घुँमीति हूरं ॥",
      "sourceLineId": "99083",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਿ ਭੁੰਮੀਤਿ ਪੂਰੰ ॥",
      "transliteration": "k bhu(n)meet poora(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਊਨ੍ਰਹਾ ਨਾਲ) ਧਰਤੀ ਭਰੀ ਗਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि भुँमीति पूरं ॥",
      "sourceLineId": "99084",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਿ ਜੁਝੇਤਿ ਵੀਰੰ ॥",
      "transliteration": "k jujhet veera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਮਾਰੇ ਜਾ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि जुझेति वीरं ॥",
      "sourceLineId": "99085",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਿ ਲਗੇਤਿ ਤੀਰੰ ॥੨੬੫॥",
      "transliteration": "k laget teera(n) ||265||",
      "translation": "The heavenly damsels are roaming over the whole earth, on being hit by the arrows the warriors are embracing martyrdom.265.",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੂੰ ਤੀਰ ਵਜਦੇ ਹਨ ॥੨੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि लगेति तीरं ॥२६५॥",
      "sourceLineId": "99086",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਿ ਚਲੈਤਿ ਬਾਣੰ ॥",
      "transliteration": "k chalait baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਤੀਰ ਚਲਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि चलैति बाणं ॥",
      "sourceLineId": "99087",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਿ ਰੁਕੀ ਦਿਸਾਣੰ ॥",
      "transliteration": "k rukee dhisaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਚਾਰੇ ਦਿਸ਼ਾਵਾ (ਤੀਰਾ ਨਾਲ) ਰੁਕ ਗਈਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि रुकी दिसाणं ॥",
      "sourceLineId": "99088",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਿ ਝਮਕੈਤਿ ਤੇਗੰ ॥",
      "transliteration": "k jhamakait tega(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਚਮਕਦੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि झमकैति तेगं ॥",
      "sourceLineId": "99089",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਿ ਨਭਿ ਜਾਨ ਬੇਗੰ ॥੨੬੬॥",
      "transliteration": "k nabh jaan bega(n) ||266||",
      "translation": "With the discharge of the arrows the directions have been hidden from view and the swords are gleaming high up in the sky.266.",
      "punjabiViakhya": "(ਮਾਨੋ) ਆਕਾਸ਼ ਵਿਚ (ਬਿਜਲੀ) ਜਲਦੀ ਨਾਲ ਚਮਕ ਰਹੀ ਹੋਵੇ ॥੨੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि नभि जान बेगं ॥२६६॥",
      "sourceLineId": "99090",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਿ ਛੁਟੇਤਿ ਗੋਰੰ ॥",
      "transliteration": "k chhuTet gora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਗੋਲੇ ਛੁਟਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि छुटेति गोरं ॥",
      "sourceLineId": "99091",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਿ ਬੁਠੇਤਿ ਓਰੰ ॥",
      "transliteration": "k buThet ora(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਮਾਨੋ) ਗੜੇ ਪੈ ਰਹੇ ਹੋਣ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि बुठेति ओरं ॥",
      "sourceLineId": "99092",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਿ ਗਜੈਤਿ ਗਾਜੀ ॥",
      "transliteration": "k gajait gaajee ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਗਜ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि गजैति गाजी ॥",
      "sourceLineId": "99093",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਿ ਪੇਲੇਤਿ ਤਾਜੀ ॥੨੬੭॥",
      "transliteration": "k pelet taajee ||267||",
      "translation": "The ghosts, arising from the graves, are coming towards the battlefield, the warriors are thundering and the horses are running.267.",
      "punjabiViakhya": "ਅਤੇ ਘੋੜਿਆਂ ਨੂੰ ਅਗੇ ਵਲ ਪ੍ਰੇਰ ਰਹੇ ਹਨ ॥੨੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि पेलेति ताजी ॥२६७॥",
      "sourceLineId": "99094",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਿ ਕਟੇਤਿ ਅੰਗੰ ॥",
      "transliteration": "k kaTet a(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਅੰਗ ਕਟੇ ਜਾ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि कटेति अंगं ॥",
      "sourceLineId": "99095",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਿ ਡਿਗੇਤਿ ਜੰਗੰ ॥",
      "transliteration": "k ddiget ja(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਣਭੂਮੀ ਵਿਚ ਡਿਗੇ ਪਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि डिगेति जंगं ॥",
      "sourceLineId": "99096",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਿ ਮਤੇਤਿ ਮਾਣੰ ॥",
      "transliteration": "k matet maana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਣ ਵਿਚ ਮਤੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि मतेति माणं ॥",
      "sourceLineId": "99097",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਿ ਲੁਝੇਤਿ ਜੁਆਣੰ ॥੨੬੮॥",
      "transliteration": "k lujhet juaana(n) ||268||",
      "translation": "The warriors whose limbs have been chopped, are falling in the war arena and the intoxicated warriors are being killed.268.",
      "punjabiViakhya": "ਯੋਧੇ (ਇਕ ਦੂਜੇ ਨਾਲ ਜੰਗ ਵਿਚ) ਉਲਝੇ ਹੋਏ ਹਨ ॥੨੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि लुझेति जुआणं ॥२६८॥",
      "sourceLineId": "99098",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਿ ਬਕੈਤਿ ਮਾਰੰ ॥",
      "transliteration": "k bakait maara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ 'ਮਾਰੋ' 'ਮਾਰੋ' ਬੋਲਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि बकैति मारं ॥",
      "sourceLineId": "99099",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਿ ਚਕੈਤਿ ਚਾਰੰ ॥",
      "transliteration": "k chakait chaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਚਾਰੇ ਚਕ ਹੈਰਾਨ ਹੋ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि चकैति चारं ॥",
      "sourceLineId": "99100",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਿ ਢੁਕੈਤਿ ਢੀਠੰ ॥",
      "transliteration": "k ddukait ddeeTha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹਠੀ ('ਢੀਠੰ') ਢੁਕੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि ढुकैति ढीठं ॥",
      "sourceLineId": "99101",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨ ਦੇਵੇਤਿ ਪੀਠੰ ॥੨੬੯॥",
      "transliteration": "n dhevet peeTha(n) ||269||",
      "translation": "The cries of “kill, kill” are being heard in all the four directions, the warriors are closing in and are not backing out.269.",
      "punjabiViakhya": "(ਅਤੇ) ਪਿਠ ਨਹੀਂ ਵਿਖਾ ਰਹੇ ਹਨ ॥੨੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "न देवेति पीठं ॥२६९॥",
      "sourceLineId": "99102",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਿ ਘਲੇਤਿ ਸਾਗੰ ॥",
      "transliteration": "k ghalet saaga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਬਰਛੇ ਮਾਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि घलेति सागं ॥",
      "sourceLineId": "99103",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਿ ਬੁਕੈਤਿ ਬਾਗੰ ॥",
      "transliteration": "k bukait baaga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਕਰੇ ਬੁਲਾਉਾਂਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि बुकैति बागं ॥",
      "sourceLineId": "99104",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਿ ਮੁਛੇਤਿ ਬੰਕੀ ॥",
      "transliteration": "k muchhet ba(n)kee ||",
      "translation": "",
      "punjabiViakhya": "ਟੇਢੀਆਂ ਮੁੱਛਾ ਵਾਲੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि मुछेति बंकी ॥",
      "sourceLineId": "99105",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0577_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਿ ਹਠੇਤਿ ਹੰਕੀ ॥੨੭੦॥",
      "transliteration": "k haThet ha(n)kee ||270||",
      "translation": "They are striking blows with their lances, while shouting, the whiskers of those egoists are also charming.270.",
      "punjabiViakhya": "ਹਠੀਲੇ ਅਤੇ ਹੰਕਾਰੀ ਹਨ ॥੨੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 577,
      "hindi": "",
      "hindiTransliteration": "कि हठेति हंकी ॥२७०॥",
      "sourceLineId": "99106",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
