{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 578,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0578_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਿ ਬਜੈਤਿ ਢੋਲੰ ॥",
      "transliteration": "k bajait ddola(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਢੋਲ ਵਜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "कि बजैति ढोलं ॥",
      "sourceLineId": "99107",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਿ ਬਕੈਤਿ ਬੋਲੰ ॥",
      "transliteration": "k bakait bola(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਕਰੇ ਬੁਲਾਉਾਂਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "कि बकैति बोलं ॥",
      "sourceLineId": "99108",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਿ ਬਜੇ ਨਗਾਰੇ ॥",
      "transliteration": "k baje nagaare ||",
      "translation": "",
      "punjabiViakhya": "ਨਗਾਰੇ ਵਜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "कि बजे नगारे ॥",
      "sourceLineId": "99109",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਿ ਜੁਟੇ ਹਠਿਆਰੇ ॥੨੭੧॥",
      "transliteration": "k juTe haThiaare ||271||",
      "translation": "The drums are being played and the warriors are shouting, the trumpets are sounding and the persistent warriors are fighting with one another.271.",
      "punjabiViakhya": "ਹਠੀ ਸੂਰਮੇ ਜੁਟੇ ਹੋਏ ਹਨ ॥੨੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "कि जुटे हठिआरे ॥२७१॥",
      "sourceLineId": "99110",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਉਛਕੈਤਿ ਤਾਜੀ ॥",
      "transliteration": "auchhakait taajee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਘੋੜੇ ਉਛਲਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "उछकैति ताजी ॥",
      "sourceLineId": "99111",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਮਕੈਤ ਗਾਜੀ ॥",
      "transliteration": "hamakait gaajee ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਹੰਕਾਰ ਕਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "हमकैत गाजी ॥",
      "sourceLineId": "99112",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਛੁਟਕੈਤ ਤੀਰੰ ॥",
      "transliteration": "chhuTakait teera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ ਛੁਟਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "छुटकैत तीरं ॥",
      "sourceLineId": "99113",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭਟਕੈਤ ਭੀਰੰ ॥੨੭੨॥",
      "transliteration": "bhaTakait bheera(n) ||272||",
      "translation": "The warriors are thundering, the horses are jumping, the arrows are being discharged and the fighters are going astray in the multitude.272.",
      "punjabiViakhya": "ਕਾਇਰ ਭਟਕ ਰਹੇ ਹਨ ॥੨੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "भटकैत भीरं ॥२७२॥",
      "sourceLineId": "99114",
      "sourceShabadId": "9229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭਵਾਨੀ ਛੰਦ ॥",
      "transliteration": "bhavaanee chha(n)dh ||",
      "translation": "BHAVANI STANZA",
      "punjabiViakhya": "ਭਵਾਨੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "भवानी छंद ॥",
      "sourceLineId": "99115",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਹਾ ਬੀਰ ਜੁਟੈ ॥",
      "transliteration": "jahaa beer juTai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਸੂਰਮੇ (ਆਪਸ ਵਿਚ) ਜੁਟੇ ਹੋਏ ਹਨ, (ਉਥੇ ਲੜਨ ਦੀਆਂ)",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "जहा बीर जुटै ॥",
      "sourceLineId": "99116",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਬੈ ਠਾਟ ਠਟੈ ॥",
      "transliteration": "sabai ThaaT ThaTai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਵਿਉਾਂਤਾ ਬਣਾਉਾਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "सबै ठाट ठटै ॥",
      "sourceLineId": "99117",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਿ ਨੇਜੇ ਪਲਟੈ ॥",
      "transliteration": "k neje palaTai ||",
      "translation": "",
      "punjabiViakhya": "ਨੇਜ਼ਿਆਂ ਨਾਲ (ਵੈਰੀਆਂ ਨੂੰ) ਪਲਟਾ ਸੁਟਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "कि नेजे पलटै ॥",
      "sourceLineId": "99118",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚਮਤਕਾਰ ਛੁਟੈ ॥੨੭੩॥",
      "transliteration": "chamatakaar chhuTai ||273||",
      "translation": "Where the warriors are fighting in the battlefield, there is much pomp and show, when the lances are turned upside down, there appears a miracle (that all the warriors re killed).273.",
      "punjabiViakhya": "(ਅਤੇ ਨੇਜ਼ਿਆਂ ਵਿਚੋਂ) ਚਮਕਾਰੇ ਨਿਕਲ ਰਹੇ ਹਨ ॥੨੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "चमतकार छुटै ॥२७३॥",
      "sourceLineId": "99119",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਹਾ ਸਾਰ ਬਜੈ ॥",
      "transliteration": "jahaa saar bajai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਲੋਹੇ ਨਾਲ ਲੋਹਾ ਵਜਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "जहा सार बजै ॥",
      "sourceLineId": "99120",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਹਾ ਬੀਰ ਗਜੈ ॥",
      "transliteration": "tahaa beer gajai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਯੋਧੇ ਗਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "तहा बीर गजै ॥",
      "sourceLineId": "99121",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਿਲੈ ਸੰਜ ਸਜੈ ॥",
      "transliteration": "milai sa(n)j sajai ||",
      "translation": "",
      "punjabiViakhya": "ਕਵਚ ਸਜਾ ਕੇ (ਆਪਸ ਵਿਚ) ਮਿਲੇ ਹਨ (ਭਾਵ-ਉਲਝੇ ਹਨ)",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "मिलै संज सजै ॥",
      "sourceLineId": "99122",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨ ਦ੍ਵੈ ਪੈਗ ਭਜੈ ॥੨੭੪॥",
      "transliteration": "n dhavai paig bhajai ||274||",
      "translation": "Where the steel is colliding, there the warriors are thundering, the armours are colliding with the armours, but the warriors are not retracing even two steps.274.",
      "punjabiViakhya": "ਅਤੇ ਪਿਛੇ ਨੂੰ ਦੋ ਕਦਮ ਵੀ ਨਹੀਂ ਹਟਦੇ ॥੨੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "न द्वै पैग भजै ॥२७४॥",
      "sourceLineId": "99123",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਹੂੰ ਭੂਰ ਭਾਜੈ ॥",
      "transliteration": "kahoo(n) bhoor bhaajai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਬਹੁਤੇ (ਕਾਇਰ) ਭਜੀ ਜਾ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "कहूँ भूर भाजै ॥",
      "sourceLineId": "99124",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਹੂੰ ਵੀਰ ਗਾਜੈ ॥",
      "transliteration": "kahoo(n) veer gaajai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸੂਰਮੇ ਗਜ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "कहूँ वीर गाजै ॥",
      "sourceLineId": "99125",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਹੂੰ ਜੋਧ ਜੁਟੈ ॥",
      "transliteration": "kahoo(n) jodh juTai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਯੋਧੇ ਜੁਟੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "कहूँ जोध जुटै ॥",
      "sourceLineId": "99126",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਹੂੰ ਟੋਪ ਟੁਟੈ ॥੨੭੫॥",
      "transliteration": "kahoo(n) Top TuTai ||275||",
      "translation": "Somewhere the horses are running, somewhere the warriors are thundering, somewhere the heroic fighters are fighting and somewhere the warriors with breaking of their helmets are falling down.275.",
      "punjabiViakhya": "ਕਿਤੇ (ਲੋਹੇ ਦੇ) ਟੋਪ ਟੁਟੇ ਪਏ ਹਨ ॥੨੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "कहूँ टोप टुटै ॥२७५॥",
      "sourceLineId": "99127",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਹਾ ਜੋਧ ਜੁਟੈ ॥",
      "transliteration": "jahaa jodh juTai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਯੋਧੇ ਜੁਟੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "जहा जोध जुटै ॥",
      "sourceLineId": "99128",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਹਾ ਅਸਤ੍ਰ ਛੁਟੈ ॥",
      "transliteration": "tahaa asatr chhuTai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਅਸਤ੍ਰ ਛੁਟ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "तहा असत्र छुटै ॥",
      "sourceLineId": "99129",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0578_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨ੍ਰਿਭੈ ਸਸਤ੍ਰ ਕਟੈ ॥",
      "transliteration": "nirabhai sasatr kaTai ||",
      "translation": "",
      "punjabiViakhya": "ਨਿਰਭੈ (ਯੋਧੇ ਵੈਰੀ ਦੇ) ਸ਼ਸਤ੍ਰ ਨਾਲ ਕਟ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 578,
      "hindi": "",
      "hindiTransliteration": "नृभै ससत्र कटै ॥",
      "sourceLineId": "99130",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
