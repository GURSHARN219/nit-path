{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 579,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0579_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਹੂੰ ਬੀਰ ਲੁਟੈ ॥੨੭੬॥",
      "transliteration": "kahoo(n) beer luTai ||276||",
      "translation": "Where the warriors have gathered, there they are striking the blows of their arms, they are fearlessly chopping with their weapons and killing the fighters.276.",
      "punjabiViakhya": "ਕਿਤੇ ਸੂਰਮੇ ਲੁੜਕ ਰਹੇ ਹਨ ॥੨੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "कहूँ बीर लुटै ॥२७६॥",
      "sourceLineId": "99131",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਹੂੰ ਮਾਰ ਬਕੈ ॥",
      "transliteration": "kahoo(n) maar bakai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ 'ਮਾਰੋ' 'ਮਾਰੋ' ਬੋਲ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "कहूँ मार बकै ॥",
      "sourceLineId": "99132",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਿਤੇ ਬਾਜ ਉਥਕੈ ॥",
      "transliteration": "kite baaj uthakai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਘੋੜੇ ਨਚਾ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "किते बाज उथकै ॥",
      "sourceLineId": "99133",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਿਤੇ ਸੈਣ ਹਕੈ ॥",
      "transliteration": "kite sain hakai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸੈਨਾ ਨੂੰ ਅਗੇ ਤੋਰ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "किते सैण हकै ॥",
      "sourceLineId": "99134",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਿਤੇ ਦਾਵ ਤਕੈ ॥੨੭੭॥",
      "transliteration": "kite dhaav takai ||277||",
      "translation": "Somewhere there are cries of “kill, kill”, and somewhere the horses are springing, somewhere seeing the opportunity the army is being removed.277.",
      "punjabiViakhya": "ਕਿਤੇ (ਵੈਰੀ ਨੂੰ ਮਾਰਨ ਲਈ) ਦਾਓ ਤਕ ਰਹੇ ਹਨ ॥੨੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "किते दाव तकै ॥२७७॥",
      "sourceLineId": "99135",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਿਤੇ ਘਾਇ ਮੇਲੈ ॥",
      "transliteration": "kite ghai melai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਘਾਉ ਲਗਾਏ ਜਾ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "किते घाइ मेलै ॥",
      "sourceLineId": "99136",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਿਤੇ ਸੈਣ ਪੇਲੈ ॥",
      "transliteration": "kite sain pelai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸੈਨਾ ਨੂੰ ਅਗੇ ਧਕਿਆ ਜਾ ਰਿਹਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "किते सैण पेलै ॥",
      "sourceLineId": "99137",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਿਤੇ ਭੂਮਿ ਡਿਗੇ ॥",
      "transliteration": "kite bhoom ddige ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ (ਕੋਈ ਯੋਧੇ) ਭੂਮੀ ਉਤੇ ਡਿਗ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "किते भूमि डिगे ॥",
      "sourceLineId": "99138",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਨੰ ਸ੍ਰੋਣ ਭਿਗੇ ॥੨੭੮॥",
      "transliteration": "tana(n) sron bhige ||278||",
      "translation": "Somewhere the wounds are being inflicted and somewhere the army is being pushed, somewhere the bodies saturated with blood are falling on the earth.278.",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਦੇ ਸ਼ਰੀਰ ਲਹੂ ਨਾਲ ਭਿਜ ਗਏ ਹਨ ॥੨੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "तनं स्रोण भिगे ॥२७८॥",
      "sourceLineId": "99139",
      "sourceShabadId": "9230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "99140",
      "sourceShabadId": "9231",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਮਚਾ ਪ੍ਰਚੰਡ ਰਣ ਅਰਧ ਮਹੂਰਤ ਉਦੰਡ ॥",
      "transliteration": "eeh bidh machaa pracha(n)dd ran aradh mahoorat udha(n)dd ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਉੱਚੇ ਦਰਜੇ ਦਾ ਯੁੱਧ ਅੱਧੇ ਮਹੂਰਤ ਦੇ ਸਮੇਾਂ ਜਿੰਨਾ ਮਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "इह बिधि मचा प्रचंड रण अरध महूरत उदंड ॥",
      "sourceLineId": "99141",
      "sourceShabadId": "9231",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬੀਸ ਅਯੁਤ ਦਸ ਸਤ ਸੁਭਟ ਜੁਝਤ ਭਏ ਅਡੰਡ ॥੨੭੯॥",
      "transliteration": "bees ayut dhas sat subhaT jujhat bhe adda(n)dd ||279||",
      "translation": "In this way, the dreadful war continued for a short while and two lakhs and one thousand warriors died in this war.279.",
      "punjabiViakhya": "ਜਿਸ ਵਿਚ ਦੋ ਲੱਖ, ਇਕ ਹਜ਼ਾਰ ਬਹਾਦਰ ਅਤੇ ਅਡੰਡ ਯੋਧੇ ਮਾਰੇ ਗਏ ॥੨੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "बीस अयुत दस सत सुभट जुझत भए अडंड ॥२७९॥",
      "sourceLineId": "99142",
      "sourceShabadId": "9231",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "99143",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੁਣ੍ਯੋ ਸੰਭਰੇਸੰ ॥",
      "transliteration": "sunayo sa(n)bharesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਭਰ (ਸੰਭਲ) ਦੇ ਰਾਜੇ ਨੇ (ਸੂਰਮਿਆਂ ਦਾ ਮਾਰਿਆ ਜਾਣਾ) ਸੁਣ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "सुण्यो संभरेसं ॥",
      "sourceLineId": "99144",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਯੋ ਅਪ ਭੇਸੰ ॥",
      "transliteration": "bhayo ap bhesa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕ੍ਰੋਧ ਨਾਲ) ਆਪਣੇ ਆਪ ਵਿਚ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "भयो अप भेसं ॥",
      "sourceLineId": "99145",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਉਡੀ ਬੰਬ ਰੈਣੰ ॥",
      "transliteration": "auddee ba(n)b raina(n) ||",
      "translation": "",
      "punjabiViakhya": "ਧੌਂਸਾ (ਵਜਣ ਨਾਲ ਅਤੇ ਸੈਨਾ ਦੇ ਚਲਣ ਨਾਲ) ਉਡੀ ਹੋਈ",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "उडी बंब रैणं ॥",
      "sourceLineId": "99146",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਛੁਹੀ ਸੀਸ ਗੈਣੰ ॥੨੮੦॥",
      "transliteration": "chhuhee sees gaina(n) ||280||",
      "translation": "When the king of Sambhal heard this, he, getting mad with anger turned black like the dark cloud, during the night, with his magic power, he, magnified his body to such an extent that head touched the sky.280.",
      "punjabiViakhya": "ਧੂੜ ਆਕਾਸ਼ ਦੇ ਸਿਰ ਜਾ ਲਗੀ ॥੨੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "छुही सीस गैणं ॥२८०॥",
      "sourceLineId": "99147",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਛਕੇ ਟੋਪ ਸੀਸੰ ॥",
      "transliteration": "chhake Top seesa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮਿਆਂ ਦੇ) ਸਿਰ ਉਤੇ ਲੋਹੇ ਦੇ ਟੋਪ ਸਜ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "छके टोप सीसं ॥",
      "sourceLineId": "99148",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਘਣੰ ਭਾਨੁ ਦੀਸੰ ॥",
      "transliteration": "ghana(n) bhaan dheesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਸੂਰਜਾ ਵਰਗੇ ਦਿਸਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "घणं भानु दीसं ॥",
      "sourceLineId": "99149",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਸੰ ਨਾਹ ਦੇਹੀ ॥",
      "transliteration": "sasa(n) naeh dhehee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦਾ ਸ਼ਰੀਰ ਚੰਦ੍ਰਮਾ ਦੇ ਸੁਆਮੀ (ਸ਼ਿਵ) ਵਰਗਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "ससं नाह देही ॥",
      "sourceLineId": "99150",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਥੰ ਉਕਤਿ ਕੇਹੀ ॥੨੮੧॥",
      "transliteration": "katha(n) ukat kehee ||281||",
      "translation": "With helmets on his head, he seems like the suns among the clouds, his powerful body is like Shiva, the Lord of Chandra, which is indescribable.281.",
      "punjabiViakhya": "ਉਸ ਬਾਰੇ ਵਰਣਨ ਕਿਵੇਾਂ ਕੀਤਾ ਜਾਏ ॥੨੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "कथं उकति केही ॥२८१॥",
      "sourceLineId": "99151",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਨੋ ਸਿਧ ਸੁਧੰ ॥",
      "transliteration": "mano sidh sudha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸ਼ੁੱਧ ਰੂਪ ਵਾਲੀ ਸਿੱਧੀ ਹੋਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "मनो सिध सुधं ॥",
      "sourceLineId": "99152",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੁਭੀ ਜ੍ਵਾਲ ਉਧੰ ॥",
      "transliteration": "subhee javaiaal udha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਅਗਨੀ ਦੀ ਉੱਚੀ ਲਾਟ ਸ਼ੋਭ ਰਹੀ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "सुभी ज्वाल उधं ॥",
      "sourceLineId": "99153",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਸੇ ਸਸਤ੍ਰ ਤ੍ਰੋਣੰ ॥",
      "transliteration": "kase sasatr trona(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਭੱਥੇ ਅਤੇ ਸ਼ਸਤ੍ਰ ਇੰਜ ਕਸੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "कसे ससत्र त्रोणं ॥",
      "sourceLineId": "99154",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗੁਰੂ ਜਾਣੁ ਦ੍ਰੋਣੰ ॥੨੮੨॥",
      "transliteration": "guroo jaan dhrona(n) ||282||",
      "translation": "It seemed that the flames were rising and the king had worn the weapons like the Guru Dronacharya.282.",
      "punjabiViakhya": "ਮਾਨੋ ਗੁਰੂ ਦ੍ਰੋਣਾਚਾਰਯ ਹੋਵੇ ॥੨੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "गुरू जाणु द्रोणं ॥२८२॥",
      "sourceLineId": "99155",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਹਾ ਢੀਠ ਢੂਕੇ ॥",
      "transliteration": "mahaa ddeeTh ddooke ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾਨ ਹਠੀ ਯੋਧੇ ਢੁਕੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "महा ढीठ ढूके ॥",
      "sourceLineId": "99156",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮੁਖੰ ਮਾਰ ਕੂਕੇ ॥",
      "transliteration": "mukha(n) maar kooke ||",
      "translation": "",
      "punjabiViakhya": "ਮੂੰਹ ਵਿਚੋਂ 'ਮਾਰੋ' 'ਮਾਰੋ' ਕੂਕ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "मुखं मार कूके ॥",
      "sourceLineId": "99157",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਰੈ ਸਸਤ੍ਰ ਪਾਤੰ ॥",
      "transliteration": "karai sasatr paata(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰ ਦੇ ਵਾਰ ਕਰਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "करै ससत्र पातं ॥",
      "sourceLineId": "99158",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਉਠੈ ਅਸਤ੍ਰ ਘਾਤੰ ॥੨੮੩॥",
      "transliteration": "auThai asatr ghaata(n) ||283||",
      "translation": "The warriors shouting “kill, kill” were coming near and with the blows of their arms and weapons, the wounds were being inflicted.283.",
      "punjabiViakhya": "ਅਤੇ ਅਸਤ੍ਰਾ ਦੇ ਘਾਤ ਹੁੰਦੇ ਹਨ ॥੨੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "उठै असत्र घातं ॥२८३॥",
      "sourceLineId": "99159",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਖਗੰ ਖਗ ਬਜੈ ॥",
      "transliteration": "khaga(n) khag bajai ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰ ਨਾਲ ਤਲਵਾਰ ਵਜਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "खगं खग बजै ॥",
      "sourceLineId": "99160",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਦੰ ਮਛ ਲਜੈ ॥",
      "transliteration": "nadha(n) machh lajai ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਦੀ ਚੰਚਲਤਾ ਨਾਲ) ਨਦੀਆਂ ਦੇ ਮੱਛਾ ਨੂੰ ਮਾਤ ਪੈਂਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "नदं मछ लजै ॥",
      "sourceLineId": "99161",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਉਠੈ ਛਿਛ ਇਛੰ ॥",
      "transliteration": "auThai chhichh ichha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਲਹੂ ਦੀਆਂ) ਛਿੱਟਾ (ਇਸ ਤਰ੍ਰਹਾ) ਉਠ ਰਹੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "उठै छिछ इछं ॥",
      "sourceLineId": "99162",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਹੈ ਬਾਣ ਤਿਛੰ ॥੨੮੪॥",
      "transliteration": "bahai baan tichha(n) ||284||",
      "translation": "With the sound of the collision of the dagger with dagger, the fishes of water were getting agitated and on all the four sides, the arrows were being showered violently.284.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਤਿਖੇ ਬਾਣ ਚਲਦੇ ਹਨ ॥੨੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "बहै बाण तिछं ॥२८४॥",
      "sourceLineId": "99163",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗਿਰੇ ਬੀਰ ਧੀਰੰ ॥",
      "transliteration": "gire beer dheera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਧੀਰਜ ਵਾਲੇ ਸੂਰਮੇ ਡਿਗਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "गिरे बीर धीरं ॥",
      "sourceLineId": "99164",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਧਰੇ ਬੀਰ ਚੀਰੰ ॥",
      "transliteration": "dhare beer cheera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧਿਆਂ ਵਾਲੇ ਬਸਤ੍ਰ ਧਾਰਨ ਕੀਤੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "धरे बीर चीरं ॥",
      "sourceLineId": "99165",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮੁਖੰ ਮੁਛ ਬੰਕੀ ॥",
      "transliteration": "mukha(n) muchh ba(n)kee ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਦੇ ਮੂੰਹ ਉਤੇ ਟੇਢੀਆਂ ਮੁੱਛਾ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "मुखं मुछ बंकी ॥",
      "sourceLineId": "99166",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਚੇ ਬੀਰ ਹੰਕੀ ॥੨੮੫॥",
      "transliteration": "mache beer ha(n)kee ||285||",
      "translation": "Wearing beautiful garments, the warriors are falling down and on all the four sides, the warriors of charming whickers, were absorbed in lamenting.285.",
      "punjabiViakhya": "ਅਤੇ ਹੰਕਾਰ ਵਿਚ ਮਚੇ ਹੋਏ ਹਨ ॥੨੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "मचे बीर हंकी ॥२८५॥",
      "sourceLineId": "99167",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਛੁਟੈ ਬਾਣ ਧਾਰੰ ॥",
      "transliteration": "chhuTai baan dhaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣਾ ਦੀ ਵਾਛੜ ਪੈਂਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "छुटै बाण धारं ॥",
      "sourceLineId": "99168",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਧਰੇ ਖਗ ਸਾਰੰ ॥",
      "transliteration": "dhare khag saara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਫੁਲਾਦੀ ਖੰਡੇ ਧਾਰਨ ਕੀਤੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "धरे खग सारं ॥",
      "sourceLineId": "99169",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗਿਰੇ ਅੰਗ ਭੰਗੰ ॥",
      "transliteration": "gire a(n)g bha(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਗ ਟੁਟ ਟੁਟ ਕੇ ਡਿਗ ਪਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "गिरे अंग भंगं ॥",
      "sourceLineId": "99170",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚਲੇ ਜਾਇ ਜੰਗੰ ॥੨੮੬॥",
      "transliteration": "chale jai ja(n)ga(n) ||286||",
      "translation": "The arrows and swords of sharp edges are being struck and the warriors are moving inspite of the chopping of their limbs.286.",
      "punjabiViakhya": "ਅਤੇ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਚਲੀ ਜਾ ਰਹੇ ਹਨ ॥੨੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "चले जाइ जंगं ॥२८६॥",
      "sourceLineId": "99171",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਚੇ ਮਾਸਹਾਰੰ ॥",
      "transliteration": "nache maasahaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਸ ਦਾ ਆਹਾਰ ਕਰਨ ਵਾਲੇ ਨਚਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "नचे मासहारं ॥",
      "sourceLineId": "99172",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹਸੈ ਬਿਓਮ ਚਾਰੰ ॥",
      "transliteration": "hasai biom chaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਆਕਾਸ਼ ਵਿਚ ਫਿਰਨ ਵਾਲੇ (ਭੂਤਪ੍ਰੇਤ ਜਾ ਇਲਾ-ਗਿਰਝਾ) ਪ੍ਰਸੰਨ ਹੋ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "हसै बिओम चारं ॥",
      "sourceLineId": "99173",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪੁਐ ਈਸ ਸੀਸੰ ॥",
      "transliteration": "puaai iees seesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਮੁੰਡਾ ਦੀ ਮਾਲਾ ਪਰੋ ਰਿਹਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "पुऐ ईस सीसं ॥",
      "sourceLineId": "99174",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਛਲੀ ਬਾਰੁਣੀਸੰ ॥੨੮੭॥",
      "transliteration": "chhalee baaruneesa(n) ||287||",
      "translation": "The flesh-eating beings are dancing and vultures and crows in the sky are getting pleased, the rosaries of skulls are being strung for the neck of Shiva and it seems that all have got intoxicated on drinking wine.287.",
      "punjabiViakhya": "(ਮਾਨੋ) ਵਿਸ਼ਣੂ ('ਬਾਰੁਣੀਸੰ') ਨੂੰ ਛਲ ਰਿਹਾ ਹੋਵੇ ॥੨੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "छली बारुणीसं ॥२८७॥",
      "sourceLineId": "99175",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਛੁਟੈ ਸਸਤ੍ਰ ਧਾਰੰ ॥",
      "transliteration": "chhuTai sasatr dhaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਜ਼ ਧਾਰਾ ਵਾਲੇ ਸ਼ਸਤ੍ਰ ਛੁਟਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "छुटै ससत्र धारं ॥",
      "sourceLineId": "99176",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਟੈ ਅਸਤ੍ਰ ਝਾਰੰ ॥",
      "transliteration": "kaTai asatr jhaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਸਤ੍ਰ (ਉਨ੍ਰਹਾ ਦੀ) ਝਾਲ ਨੂੰ ਕਟ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "कटै असत्र झारं ॥",
      "sourceLineId": "99177",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0579_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗਿਰੇ ਰਤ ਖੇਤੰ ॥",
      "transliteration": "gire rat kheta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ-ਭੂਮੀ ਵਿਚ (ਯੋਧਿਆਂ ਦਾ) ਲਹੂ ਡਿਗ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 579,
      "hindi": "",
      "hindiTransliteration": "गिरे रत खेतं ॥",
      "sourceLineId": "99178",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
