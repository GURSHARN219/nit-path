{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 580,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0580_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਟੇ ਬੀਰ ਅਚੇਤੰ ॥੨੮੮॥",
      "transliteration": "kaTe beer acheta(n) ||288||",
      "translation": "The warriors being chopped by chopped by the edges of the weapons and the blows of the arms, spilling their blood are getting unconscious and falling down.288.",
      "punjabiViakhya": "ਸੂਰਮੇ ਕਟੇ ਜਾਣ ਤੇ ਬੇਹੋਸ਼ ਹੋ ਰਹੇ ਹਨ ॥੨੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "कटे बीर अचेतं ॥२८८॥",
      "sourceLineId": "99179",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਉਠੈ ਕ੍ਰੁਧ ਧਾਰੰ ॥",
      "transliteration": "auThai krudh dhaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਦੀ ਧਾਰ ਉਠਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "उठै क्रुध धारं ॥",
      "sourceLineId": "99180",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਚੇ ਸਸਤ੍ਰ ਝਾਰੰ ॥",
      "transliteration": "mache sasatr jhaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰਾ ਦੇ ਖੂਬ ਵਾਰ ਹੁੰਦੇ ਹਨ, ਲਹੂ ਪੀਣ ਵਾਲੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "मचे ससत्र झारं ॥",
      "sourceLineId": "99181",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਖਹੈ ਖਗ ਖੂਨੀ ॥",
      "transliteration": "khahai khag khoonee ||",
      "translation": "",
      "punjabiViakhya": "ਖੜਗਾ (ਆਪਸ ਵਿਚ) ਖਹਿੰਦੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "खहै खग खूनी ॥",
      "sourceLineId": "99182",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚੜੈ ਚਉਪ ਦੂਨੀ ॥੨੮੯॥",
      "transliteration": "chaRai chaup dhoonee ||289||",
      "translation": "The warriors, flowing in the current of anger, are striking dreadfully their weapons and with the collision of the bloody daggers they are being excited doubly.289.",
      "punjabiViakhya": "(ਵੀਰਾ ਵਿਚ) ਦੂਣਾ ਚਾਉ ਚੜ੍ਰਹ ਜਾਦਾ ਹੈ ॥੨੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "चड़ै चउप दूनी ॥२८९॥",
      "sourceLineId": "99183",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪਿਪੰ ਸ੍ਰੋਣ ਦੇਵੀ ॥",
      "transliteration": "pipa(n) sron dhevee ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵੀ ਲਹੂ ਪੀਂਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "पिपं स्रोण देवी ॥",
      "sourceLineId": "99184",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਸੈ ਅੰਸੁ ਭੇਵੀ ॥",
      "transliteration": "hasai a(n)s bhevee ||",
      "translation": "",
      "punjabiViakhya": "(ਮਾਨੋ) ਬਿਜਲੀ ('ਅੰਸੁ ਭੇਵੀ') ਹਸ ਰਹੀ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "हसै अंसु भेवी ॥",
      "sourceLineId": "99185",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਟਾ ਅਟ ਹਾਸੰ ॥",
      "transliteration": "aTaa aT haasa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਖਿੜ ਖਿੜਾ ਕੇ ਹਸ ਰਹੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "अटा अट हासं ॥",
      "sourceLineId": "99186",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੁ ਜੋਤੰ ਪ੍ਰਕਾਸੰ ॥੨੯੦॥",
      "transliteration": "s jota(n) prakaasa(n) ||290||",
      "translation": "The goddess, thirsty of blood, is laughing and her laughter is pervading on all the four sides like the illumination of her light.290.",
      "punjabiViakhya": "ਉਸ ਦੀ ਜੋਤਿ ਪ੍ਰਕਾਸ਼ਮਾਨ ਹੋ ਰਹੀ ਹੈ ॥੨੯੦॥",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "सु जोतं प्रकासं ॥२९०॥",
      "sourceLineId": "99187",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਢੁਕੇ ਢੀਠ ਢਾਲੰ ॥",
      "transliteration": "dduke ddeeTh ddaala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹਠੀ (ਯੋਧੇ) ਢਾਲਾ ਲੈ ਕੇ (ਨੇੜੇ) ਢੁਕੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "ढुके ढीठ ढालं ॥",
      "sourceLineId": "99188",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਚੇ ਮੁੰਡ ਮਾਲੰ ॥",
      "transliteration": "nache mu(n)dd maala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮੁੰਡਾ ਦੀ ਮਾਲਾ ਵਾਲਾ (ਸ਼ਿਵ) ਨਚ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "नचे मुँड मालं ॥",
      "sourceLineId": "99189",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਰੈ ਸਸਤ੍ਰ ਪਾਤੰ ॥",
      "transliteration": "karai sasatr paata(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਸ਼ਸਤ੍ਰਾ ਦਾ ਵਾਰ ਕਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "करै ससत्र पातं ॥",
      "sourceLineId": "99190",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਉਠੈ ਅਸਤ੍ਰ ਘਾਤੰ ॥੨੯੧॥",
      "transliteration": "auThai asatr ghaata(n) ||291||",
      "translation": "The determined warriors are fighting taking up their shields and Shiva wearing his rosary of skulls is dancing, the blows of weapons and arms are being struck.291.",
      "punjabiViakhya": "ਅਸਤ੍ਰਾ ਦੇ ਘਾਤ ਹੁੰਦੇ ਹਨ ॥੨੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "उठै असत्र घातं ॥२९१॥",
      "sourceLineId": "99191",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰੁਪੇ ਵੀਰ ਧੀਰੰ ॥",
      "transliteration": "rupe veer dheera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਧੀਰਜਵਾਨ ਸੂਰਮੇ ਰੁਝੇ ਹੋਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "रुपे वीर धीरं ॥",
      "sourceLineId": "99192",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਜੈ ਤਾਣ ਤੀਰੰ ॥",
      "transliteration": "tajai taan teera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜ਼ੋਰ ਨਾਲ ਤੀਰ ਛਡਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "तजै ताण तीरं ॥",
      "sourceLineId": "99193",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਝਮੈ ਬਿਜੁ ਬੇਗੰ ॥",
      "transliteration": "jhamai bij bega(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਇੰਜ ਚਮਕਦੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "झमै बिजु बेगं ॥",
      "sourceLineId": "99194",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਲਸੈ ਏਮ ਤੇਗੰ ॥੨੯੨॥",
      "transliteration": "lasai em tega(n) ||292||",
      "translation": "The patient warriors are discharging arrows by repeatedly pulling their bows and the swords are being struck like the flash of lightning.292.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਬਿਜਲੀ ਲਿਸ਼ਕਦੀ ਹੈ ॥੨੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "लसै एम तेगं ॥२९२॥",
      "sourceLineId": "99195",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਖਹੇ ਖਗ ਖੂਨੀ ॥",
      "transliteration": "khahe khag khoonee ||",
      "translation": "",
      "punjabiViakhya": "ਲਹੂ ਪੀਣੀ ਤਲਵਾਰ ਖਹਿ ਰਹੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "खहे खग खूनी ॥",
      "sourceLineId": "99196",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚੜੈ ਚੌਪ ਦੂਨੀ ॥",
      "transliteration": "chaRai chauap dhoonee ||",
      "translation": "",
      "punjabiViakhya": "ਚਿਤ ਵਿਚ (ਯੁੱਧ ਦਾ) ਚਾਉ ਦੁਗਣਾ ਹੋ ਰਿਹਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "चड़ै चौप दूनी ॥",
      "sourceLineId": "99197",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਰੈ ਚਿਤ੍ਰ ਚਾਰੰ ॥",
      "transliteration": "karai chitr chaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਕਰਤਬ ਕੀਤੇ ਜਾ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "करै चित्र चारं ॥",
      "sourceLineId": "99198",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਕੈ ਮਾਰੁ ਮਾਰੰ ॥੨੯੩॥",
      "transliteration": "bakai maar maara(n) ||293||",
      "translation": "The bloody daggers are colliding and with double excitement, the warriors are fighting, those elegant warriors are shouting “kill, kill”.293.",
      "punjabiViakhya": "ਮੂੰਹੋਂ 'ਮਾਰੋ' 'ਮਾਰੋ' ਬੋਲ ਰਹੇ ਹਨ ॥੨੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "बकै मारु मारं ॥२९३॥",
      "sourceLineId": "99199",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਪੋ ਆਪ ਦਾਬੈ ॥",
      "transliteration": "apo aap dhaabai ||",
      "translation": "",
      "punjabiViakhya": "ਆਪੋ ਆਪਣੇ ਦਾਬੇ ਮਾਰ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "अपो आप दाबै ॥",
      "sourceLineId": "99200",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਣੰ ਬੀਰ ਫਾਬੈ ॥",
      "transliteration": "rana(n) beer faabai ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ ਵਿਚ ਸੂਰਮੇ ਫਬ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "रणं बीर फाबै ॥",
      "sourceLineId": "99201",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਘਣੰ ਘਾਇ ਪੇਲੈ ॥",
      "transliteration": "ghana(n) ghai pelai ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤਿਆਂ ਨੂੰ ਜ਼ਖ਼ਮ ਲਗਾਉਾਂਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "घणं घाइ पेलै ॥",
      "sourceLineId": "99202",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਹਾ ਵੀਰ ਝੇਲੈ ॥੨੯੪॥",
      "transliteration": "mahaa veer jhelai ||294||",
      "translation": "Pressing one another, the warriors are looking magnificent and the great warriors are inflicting wounds on one another.294.",
      "punjabiViakhya": "ਮਹਾਵੀਰ (ਸੱਟਾ ਨੂੰ) ਸਹਾਰਦੇ ਹਨ ॥੨੯੪॥",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "महा वीर झेलै ॥२९४॥",
      "sourceLineId": "99203",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੰਡੇ ਵੀਰ ਸੁਧੰ ॥",
      "transliteration": "ma(n)dde veer sudha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਨਿਰੋਲ ਵੀਰ ਰਸ ਵਿਚ ਮੰਡੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "मंडे वीर सुधं ॥",
      "sourceLineId": "99204",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਰੈ ਮਲ ਜੁਧੰ ॥",
      "transliteration": "karai mal judha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮੱਲ (ਪਹਿਲਵਾਨ) ਕੁਸ਼ਤੀਆਂ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "करै मल जुधं ॥",
      "sourceLineId": "99205",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਪੋ ਆਪ ਬਾਹੈ ॥",
      "transliteration": "apo aap baahai ||",
      "translation": "",
      "punjabiViakhya": "ਆਪੋ ਆਪਣੇ ਦਾਓ ਵਰਤਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "अपो आप बाहै ॥",
      "sourceLineId": "99206",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਉਭੈ ਜੀਤ ਚਾਹੈ ॥੨੯੫॥",
      "transliteration": "aubhai jeet chaahai ||295||",
      "translation": "The warriors are engaged like wrestlers among themselves and striking their weapons they are desiring for their victory.295.",
      "punjabiViakhya": "ਦੋਵੇਾਂ (ਆਪਣੀ ਆਪਣੀ) ਜਿਤ ਚਾਹੁੰਦੇ ਹਨ ॥੨੯੫॥",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "उभै जीत चाहै ॥२९५॥",
      "sourceLineId": "99207",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰਣੰ ਰੰਗ ਰਤੇ ॥",
      "transliteration": "rana(n) ra(n)g rate ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਹੜੇ) ਯੁੱਧ ਵਿਚ ਰਤੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "रणं रंग रते ॥",
      "sourceLineId": "99208",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚੜੇ ਤੇਜ ਤਤੇ ॥",
      "transliteration": "chaRe tej tate ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੂੰ) ਬਹੁਤ ਤੇਜ ਚੜ੍ਰਹਿਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "चड़े तेज तते ॥",
      "sourceLineId": "99209",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਖੁਲੇ ਖਗ ਖੂਨੀ ॥",
      "transliteration": "khule khag khoonee ||",
      "translation": "",
      "punjabiViakhya": "ਲਹੂ ਦੀਆਂ ਪਿਆਸੀਆਂ ਤਲਵਾਰਾ ਨੰਗੀਆਂ ਕੀਤੀਆਂ ਹੋਈਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "खुले खग खूनी ॥",
      "sourceLineId": "99210",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚੜੇ ਚਉਪ ਦੂਨੀ ॥੨੯੬॥",
      "transliteration": "chaRe chaup dhoonee ||296||",
      "translation": "The warriors are imbued with war and with double excitement, they are striking their bloody dagger.296.",
      "punjabiViakhya": "(ਸਭ ਨੂੰ) ਦੂਣਾ ਚਾਉ ਚੜ੍ਰਹਿਆ ਹੋਇਆ ਹੈ ॥੨੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "चड़े चउप दूनी ॥२९६॥",
      "sourceLineId": "99211",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਭੰ ਹੂਰ ਪੂਰੰ ॥",
      "transliteration": "nabha(n) hoor poora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਆਕਾਸ਼ ਹੂਰਾ ਨਾਲ ਭਰਿਆ ਹੋਇਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "नभं हूर पूरं ॥",
      "sourceLineId": "99212",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭਏ ਵੀਰ ਚੂਰੰ ॥",
      "transliteration": "bhe veer choora(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਯੁੱਧ ਵਿਚ) ਸੂਰਮੇ ਚੂਰ ਚੂਰ (ਟੋਟੇ ਟੋਟੇ) ਹੋ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "भए वीर चूरं ॥",
      "sourceLineId": "99213",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਜੈ ਤੂਰ ਤਾਲੀ ॥",
      "transliteration": "bajai toor taalee ||",
      "translation": "",
      "punjabiViakhya": "ਤੂਰ ਅਤੇ ਕੈਂਸੀਆਂ ਵਜ ਰਹੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "बजै तूर ताली ॥",
      "sourceLineId": "99214",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਚੇ ਮੁੰਡ ਮਾਲੀ ॥੨੯੭॥",
      "transliteration": "nache mu(n)dd maalee ||297||",
      "translation": "The heavenly damsels are moving the sky and the warriors, greatly tired, are falling down, the sound of clapping is being heard and Shiva is dancing.297.",
      "punjabiViakhya": "ਸ਼ਿਵ ('ਮੁੰਡ ਮਾਲੀ') ਨਚ ਰਿਹਾ ਹੈ ॥੨੯੭॥",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "नचे मुँड माली ॥२९७॥",
      "sourceLineId": "99215",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਣੰ ਰੂਹ ਉਠੈ ॥",
      "transliteration": "rana(n) rooh uThai ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਰੌਲਾ ਪੈ ਰਿਹਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "रणं रूह उठै ॥",
      "sourceLineId": "99216",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਰੰ ਧਾਰ ਬੁਠੈ ॥",
      "transliteration": "sara(n) dhaar buThai ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰਾ ਦੀ ਝੜੀ ਲਗੀ ਹੋਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "सरं धार बुठै ॥",
      "sourceLineId": "99217",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗਜੈ ਵੀਰ ਗਾਜੀ ॥",
      "transliteration": "gajai veer gaajee ||",
      "translation": "",
      "punjabiViakhya": "ਬਹਾਦਰ ਸੂਰਮੇ ਗਜ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "गजै वीर गाजी ॥",
      "sourceLineId": "99218",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤੁਰੇ ਤੁੰਦ ਤਾਜੀ ॥੨੯੮॥",
      "transliteration": "ture tu(n)dh taajee ||298||",
      "translation": "The sound of lamentation is rising in the battlefield and alongwith it, there is also shower of arrows, the warriors are thundering and the horses are running from this side to that side.298.",
      "punjabiViakhya": "ਘੋੜੇ ਤੇਜ਼ੀ ਨਾਲ ਭਜ ਰਹੇ ਹਨ ॥੨੯੮॥",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "तुरे तुँद ताजी ॥२९८॥",
      "sourceLineId": "99219",
      "sourceShabadId": "9232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "99220",
      "sourceShabadId": "9233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭਇਓ ਘੋਰ ਆਹਵ ਬਿਕਰਾਰਾ ॥",
      "transliteration": "bhio ghor aahav bikaraaraa ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਭਿਆਨਕ ਅਤੇ ਵਿਕਰਾਲ ਯੁੱਧ ਹੋ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "भइओ घोर आहव बिकरारा ॥",
      "sourceLineId": "99221",
      "sourceShabadId": "9233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਚੇ ਭੂਤ ਪ੍ਰੇਤ ਬੈਤਾਰਾ ॥",
      "transliteration": "naache bhoot pret baitaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਭੂਤ, ਪ੍ਰੇਤ ਅਤੇ ਬੈਤਾਲ ਨਚ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "नाचे भूत प्रेत बैतारा ॥",
      "sourceLineId": "99222",
      "sourceShabadId": "9233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬੈਰਕ ਬਾਣ ਗਗਨ ਗਇਓ ਛਾਈ ॥",
      "transliteration": "bairak baan gagan gio chhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਬੈਰਕਾ (ਝੰਡਿਆਂ ਜਾ ਭਾਲਿਆਂ) ਨਾਲ ਆਕਾਸ਼ ਭਰ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "बैरक बाण गगन गइओ छाई ॥",
      "sourceLineId": "99223",
      "sourceShabadId": "9233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਾਨੁਕ ਰੈਨ ਦਿਨਹਿ ਹੁਇ ਆਈ ॥੨੯੯॥",
      "transliteration": "jaanuk rain dhineh hui aaiee ||299||",
      "translation": "In this way, a dreadful war was waged and the ghosts, fiends and Baitals began to dance, the lances and arrows spread in the sky, and it appeared that the night had fallen during the day.299.",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ) ਮਾਨੋ ਦਿਨ ਨੂੰ ਹੀ ਰਾਤ ਹੋ ਗਈ ਹੋਵੇ ॥੨੯੯॥",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "जानुक रैन दिनहि हुइ आई ॥२९९॥",
      "sourceLineId": "99224",
      "sourceShabadId": "9233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਹੂੰ ਪਿਸਾਚ ਪ੍ਰੇਤ ਨਾਚੈ ਰਣਿ ॥",
      "transliteration": "kahoo(n) pisaach pret naachai ran ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਕਿਤੇ ਪਿਸ਼ਾਚ ਅਤੇ ਕਿਤੇ ਪ੍ਰੇਤ ਨਚ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "कहूँ पिसाच प्रेत नाचै रणि ॥",
      "sourceLineId": "99225",
      "sourceShabadId": "9233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0580_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜੂਝ ਜੂਝ ਕਹੂੰ ਗਿਰੇ ਸੁਭਟ ਗਣ ॥",
      "transliteration": "joojh joojh kahoo(n) gire subhaT gan ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਯੋਧਿਆਂ ਦੇ ਟੋਲੇ ਲੜ ਲੜ ਕੇ ਡਿਗ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 580,
      "hindi": "",
      "hindiTransliteration": "जूझ जूझ कहूँ गिरे सुभट गण ॥",
      "sourceLineId": "99226",
      "sourceShabadId": "9233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
