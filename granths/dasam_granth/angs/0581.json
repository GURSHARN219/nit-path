{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 581,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0581_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭਈਰਵ ਕਰਤ ਕਹੂੰ ਭਭਕਾਰਾ ॥",
      "transliteration": "bhieerav karat kahoo(n) bhabhakaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਭੈਰੋ ਭਭਕ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "भईरव करत कहूँ भभकारा ॥",
      "sourceLineId": "99227",
      "sourceShabadId": "9233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਉਡਤ ਕਾਕ ਕੰਕੈ ਬਿਕਰਾਰਾ ॥੩੦੦॥",
      "transliteration": "auddat kaak ka(n)kai bikaraaraa ||300||",
      "translation": "Somewhere the imps and fiends are dancing in the battlefield and somewhere after continued fighting the warriors have fallen in the war-arena, somewhere the Bhairavas are shouting loudly and somewhere the dreadful crows are flying.300.",
      "punjabiViakhya": "ਕਿਤੇ ਭਿਆਨਕ ਕਾ ਅਤੇ ਗਿਰਝਾ ਉਡ ਰਹੀਆਂ ਹਨ ॥੩੦੦॥",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "उडत काक कंकै बिकरारा ॥३००॥",
      "sourceLineId": "99228",
      "sourceShabadId": "9233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਾਜਤ ਢੋਲ ਮ੍ਰਿਦੰਗ ਨਗਾਰਾ ॥",
      "transliteration": "baajat ddol miradha(n)g nagaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲ, ਮ੍ਰਿਦੰਗ ਅਤੇ ਨਗਾਰੇ ਵਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "बाजत ढोल मृदंग नगारा ॥",
      "sourceLineId": "99229",
      "sourceShabadId": "9233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਾਲ ਉਪੰਗ ਬੇਣ ਬੰਕਾਰਾ ॥",
      "transliteration": "taal upa(n)g ben ba(n)kaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕੈਂਸੀਆਂ, ਉਪੰਗ ਅਤੇ ਬੀਨਾ ਵਜ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "ताल उपंग बेण बंकारा ॥",
      "sourceLineId": "99230",
      "sourceShabadId": "9233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮੁਰਲੀ ਨਾਦ ਨਫੀਰੀ ਬਾਜੇ ॥",
      "transliteration": "muralee naadh nafeeree baaje ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਰਲੀ, ਨਾਦ, ਨਫੀਰੀ (ਆਦਿ ਵਾਜੇ) ਵਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "मुरली नाद नफीरी बाजे ॥",
      "sourceLineId": "99231",
      "sourceShabadId": "9233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭੀਰ ਭਯਾਨਕ ਹੁਐ ਤਜਿ ਭਾਜੇ ॥੩੦੧॥",
      "transliteration": "bheer bhayaanak huaai taj bhaaje ||301||",
      "translation": "The small and big drums, trumpets, flute etc., are all being played, the pipe and fife are also being played and the warriors, getting frightened, are running away.301.",
      "punjabiViakhya": "ਡਰਪੋਕ ਲੋਕ ਭੈਭੀਤ ਹੋ ਕੇ (ਯੁੱਧ-ਭੂਮੀ ਨੂੰ) ਛਡ ਕੇ ਭਜ ਰਹੇ ਸਨ ॥੩੦੧॥",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "भीर भयानक हुऐ तजि भाजे ॥३०१॥",
      "sourceLineId": "99232",
      "sourceShabadId": "9233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਹਾ ਸੁਭਟ ਜੂਝੇ ਤਿਹ ਠਾਮਾ ॥",
      "transliteration": "mahaa subhaT joojhe teh Thaamaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਸਥਾਨ ਉਤੇ ਵੱਡੇ ਵੱਡੇ ਸੂਰਮੇ ਜੂਝ ਮੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "महा सुभट जूझे तिह ठामा ॥",
      "sourceLineId": "99233",
      "sourceShabadId": "9233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਖਰਭਰ ਪਰੀ ਇੰਦ੍ਰ ਕੇ ਧਾਮਾ ॥",
      "transliteration": "kharabhar paree i(n)dhr ke dhaamaa ||",
      "translation": "",
      "punjabiViakhya": "ਇੰਦਰ ਦੇ ਘਰ ਖਲਬਲੀ ਮਚ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "खरभर परी इंद्र के धामा ॥",
      "sourceLineId": "99234",
      "sourceShabadId": "9233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬੈਰਕ ਬਾਣ ਗਗਨ ਗਇਓ ਛਾਈ ॥",
      "transliteration": "bairak baan gagan gio chhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਬੈਰਕਾ (ਝੰਡੇ ਜਾ ਨੇਜ਼ੇ) ਅਤੇ ਬਾਣ ਆਕਾਸ਼ ਵਿਚ ਛਾ ਗਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "बैरक बाण गगन गइओ छाई ॥",
      "sourceLineId": "99235",
      "sourceShabadId": "9233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਉਠੈ ਘਟਾ ਸਾਵਣ ਜਨੁ ਆਈ ॥੩੦੨॥",
      "transliteration": "auThai ghaTaa saavan jan aaiee ||302||",
      "translation": "Great warriors fell martyrs in that battlefield and there was commotion in the country of Indra, the lances and arrows spread in the world like the rushing forth of the clouds of Sawan.302.",
      "punjabiViakhya": "ਮਾਨੋ ਸਾਵਣ ਦੀ ਘਟ ਛਾ ਗਈ ਹੋਵੇ ॥੩੦੨॥",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "उठै घटा सावण जनु आई ॥३०२॥",
      "sourceLineId": "99236",
      "sourceShabadId": "9233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤੋਮਰ ਛੰਦ ॥",
      "transliteration": "tomar chha(n)dh ||",
      "translation": "TOMAR STANZA",
      "punjabiViakhya": "ਤੋਮਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "तोमर छंद ॥",
      "sourceLineId": "99237",
      "sourceShabadId": "9234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਹੁ ਭਾਤਿ ਕੋਪੇ ਸਬੀਰ ॥",
      "transliteration": "bahu bhaat kope sabeer ||",
      "translation": "",
      "punjabiViakhya": "ਬਲਵਾਨ ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਕ੍ਰੋਧਵਾਨ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "बहु भाति कोपे सबीर ॥",
      "sourceLineId": "99238",
      "sourceShabadId": "9234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਧਨੁ ਤਾਨਿ ਤਿਆਗਤ ਤੀਰ ॥",
      "transliteration": "dhan taan tiaagat teer ||",
      "translation": "",
      "punjabiViakhya": "ਧਨੁਸ਼ਾ ਨੂੰ ਖਿਚ ਖਿਚ ਕੇ ਤੀਰ ਛਡਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "धनु तानि तिआगत तीर ॥",
      "sourceLineId": "99239",
      "sourceShabadId": "9234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਰ ਅੰਗਿ ਜਾਸੁ ਲਗੰਤ ॥",
      "transliteration": "sar a(n)g jaas laga(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਅੰਗ ਨੂੰ ਜਾ ਕੇ ਤੀਰ ਵਜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "सर अंगि जासु लगंत ॥",
      "sourceLineId": "99240",
      "sourceShabadId": "9234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਟ ਸੁਰਗਿ ਬਾਸ ਕਰੰਤ ॥੩੦੩॥",
      "transliteration": "bhaT surag baas kara(n)t ||303||",
      "translation": "Getting infuriated in many ways the warriors are discharging arrows by pulling their bows, whosoever is hit by these arrows, he leaves for heaven.303.",
      "punjabiViakhya": "(ਉਹ) ਸੂਰਮੇ ਸਵਰਗ ਵਿਚ ਵਾਸ ਕਰਦੇ ਹਨ ॥੩੦੩॥",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "भट सुरगि बास करंत ॥३०३॥",
      "sourceLineId": "99241",
      "sourceShabadId": "9234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਹੂੰ ਅੰਗ ਭੰਗ ਉਤੰਗ ॥",
      "transliteration": "kahoo(n) a(n)g bha(n)g uta(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਉੱਚੇ ਕਦ ਵਾਲੇ (ਸੂਰਮਿਆਂ ਦੇ) ਅੰਗ ਟੁਟ ਕੇ ਡਿਗੇ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "कहूँ अंग भंग उतंग ॥",
      "sourceLineId": "99242",
      "sourceShabadId": "9234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਹੂੰ ਤੀਰ ਤੇਗ ਸੁਰੰਗ ॥",
      "transliteration": "kahoo(n) teer teg sura(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਤੀਰਾ ਅਤੇ ਤੇਗਾ ਦਾ ਸੁੰਦਰ ਰੰਗ (ਵਿਖਾਈ ਦੇ ਰਿਹਾ ਹੈ)।",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "कहूँ तीर तेग सुरंग ॥",
      "sourceLineId": "99243",
      "sourceShabadId": "9234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਹੂੰ ਚਉਰ ਚੀਰ ਸੁਬਾਹ ॥",
      "transliteration": "kahoo(n) chaur cheer subaeh ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਯੋਧਿਆਂ ਦੇ ਚੌਰ ਅਤੇ ਬਸਤ੍ਰ (ਡਿਗੇ ਪਏ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "कहूँ चउर चीर सुबाह ॥",
      "sourceLineId": "99244",
      "sourceShabadId": "9234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਹੂੰ ਸੁਧ ਸੇਲ ਸਨਾਹ ॥੩੦੪॥",
      "transliteration": "kahoo(n) sudh sel sanaeh ||304||",
      "translation": "There are heaps of chopped limbs lying somewhere and somewhere there are lying arrows and swords, somewhere there are seen garments, somewhere lances and somewhere armours of steel.304.",
      "punjabiViakhya": "ਕਿਤੇ ਸੁੰਦਰ ਨੇਜ਼ੇ ਅਤੇ ਕਵਚ (ਟੁਟੇ ਪਏ ਹਨ) ॥੩੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "कहूँ सुध सेल सनाह ॥३०४॥",
      "sourceLineId": "99245",
      "sourceShabadId": "9234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਣਿ ਅੰਗ ਰੰਗਤ ਐਸ ॥",
      "transliteration": "ran a(n)g ra(n)gat aais ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ-ਭੂਮੀ ਵਿਚ (ਸੂਰਮਿਆਂ ਦੇ) ਅੰਗ ਇਸ ਤਰ੍ਰਹਾ ਰੰਗੇ ਪਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "रणि अंग रंगत ऐस ॥",
      "sourceLineId": "99246",
      "sourceShabadId": "9234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਨੁ ਫੁਲ ਕਿੰਸਕ ਜੈਸ ॥",
      "transliteration": "jan ful ki(n)sak jais ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ (ਜਿਵੇਾਂ) ਕੇਸੂ ਦੇ ਫੁਲ (ਰੁਲ ਰਹੇ ਹੋਣ)।",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "जनु फुल किंसक जैस ॥",
      "sourceLineId": "99247",
      "sourceShabadId": "9234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਇਕ ਐਸ ਜੂਝ ਮਰੰਤ ॥",
      "transliteration": "eik aais joojh mara(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ (ਯੋਧੇ) ਇਸ ਤਰ੍ਰਹਾ ਜੂਝ ਕੇ ਮਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "इक ऐस जूझ मरंत ॥",
      "sourceLineId": "99248",
      "sourceShabadId": "9234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਨੁ ਖੇਲਿ ਫਾਗੁ ਬਸੰਤ ॥੩੦੫॥",
      "transliteration": "jan khel faag basa(n)t ||305||",
      "translation": "The warriors are dyed in the colour of war like the kinsuk flowers, some of them are dying while fighting as if they are playing Holi.305.",
      "punjabiViakhya": "ਮਾਨੋ ਫਾਗ ਖੇਡ ਕੇ (ਥਕੇ ਹੋਏ ਲੇਟੇ ਹੋਣ) ॥੩੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "जनु खेलि फागु बसंत ॥३०५॥",
      "sourceLineId": "99249",
      "sourceShabadId": "9234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0581_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਇਕ ਧਾਇ ਆਇ ਪਰੰਤ ॥",
      "transliteration": "eik dhai aai para(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਧਾਵਾ ਕਰ ਕੇ ਆ ਪੈਂਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 581,
      "hindi": "",
      "hindiTransliteration": "इक धाइ आइ परंत ॥",
      "sourceLineId": "99250",
      "sourceShabadId": "9234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
