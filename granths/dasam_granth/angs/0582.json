{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 582,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0582_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪਗ ਦ੍ਵੈ ਨ ਭਾਗਿ ਚਲੰਤ ॥",
      "transliteration": "pag dhavai na bhaag chala(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਦੋ ਕਦਮ ਵੀ ਭਜਦੇ ਨਹੀਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "पग द्वै न भागि चलंत ॥",
      "sourceLineId": "99251",
      "sourceShabadId": "9234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਜਿ ਤ੍ਰਾਸ ਕਰਤ ਪ੍ਰਹਾਰ ॥",
      "transliteration": "taj traas karat prahaar ||",
      "translation": "",
      "punjabiViakhya": "ਡਰ ਨੂੰ ਛਡ ਕੇ ਵਾਰ ਕਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "तजि त्रास करत प्रहार ॥",
      "sourceLineId": "99252",
      "sourceShabadId": "9234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਨੁ ਖੇਲ ਫਾਗਿ ਧਮਾਰ ॥੩੦੬॥",
      "transliteration": "jan khel faag dhamaar ||306||",
      "translation": "Someone is coming running and is not retracing even two steps backwards, they are striking blows like playing Holi.306.",
      "punjabiViakhya": "ਮਾਨੋ ਫਾਗ ਖੇਡ ਰਹੇ ਹੋਣ ॥੩੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "जनु खेल फागि धमार ॥३०६॥",
      "sourceLineId": "99253",
      "sourceShabadId": "9234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਾਰਕ ਛੰਦ ॥",
      "transliteration": "taarak chha(n)dh ||",
      "translation": "TARAK STANZA",
      "punjabiViakhya": "ਤਾਰਕ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "तारक छंद ॥",
      "sourceLineId": "99254",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਲਕੀ ਅਵਤਾਰ ਰਿਸਾਵਹਿਗੇ ॥",
      "transliteration": "kalakee avataar risaavahige ||",
      "translation": "",
      "punjabiViakhya": "ਕਲਕੀ ਅਵਤਾਰ ਕ੍ਰੋਧਵਾਨ ਹੋਣਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "कलकी अवतार रिसावहिगे ॥",
      "sourceLineId": "99255",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭਟ ਓਘ ਪ੍ਰਓਘ ਗਿਰਾਵਹਿਗੇ ॥",
      "transliteration": "bhaT ogh progh giraavahige ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਦੇ ਟੋਲਿਆਂ ਦੇ ਟੋਲੇ (ਮਾਰ ਕੇ) ਡਿਗਾ ਦੇਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "भट ओघ प्रओघ गिरावहिगे ॥",
      "sourceLineId": "99256",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਹੁ ਭਾਤਨ ਸਸਤ੍ਰ ਪ੍ਰਹਾਰਹਿਗੇ ॥",
      "transliteration": "bahu bhaatan sasatr prahaarahige ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਤਰ੍ਰਹਾ ਦੇ ਸ਼ਸਤ੍ਰਾ ਨੂੰ ਚਲਾਉਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "बहु भातन ससत्र प्रहारहिगे ॥",
      "sourceLineId": "99257",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਰਿ ਓਘ ਪ੍ਰਓਘ ਸੰਘਾਰਹਿਗੇ ॥੩੦੭॥",
      "transliteration": "ar ogh progh sa(n)ghaarahige ||307||",
      "translation": "Now Kalki will get enraged and will knock down and kill a gathering of warriors, he will strike blows with various types of weapons and will destroy the groups of enemies.307.",
      "punjabiViakhya": "ਅਤੇ ਵੈਰੀਆਂ ਦੇ ਝੁੰਡਾ ਦੇ ਝੁੰਡ ਖਪਾ ਦੇਣਗੇ ॥੩੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "अरि ओघ प्रओघ संघारहिगे ॥३०७॥",
      "sourceLineId": "99258",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਰ ਸੇਲ ਸਨਾਹਰਿ ਛੂਟਹਿਗੇ ॥",
      "transliteration": "sar sel sanaahar chhooTahige ||",
      "translation": "",
      "punjabiViakhya": "ਕਵਚਾ ('ਸਨਾਹਰਿ') ਨੂੰ ਫੰਡਣ ਵਾਲੇ ਤੀਰ ਅਤੇ ਬਰਛੇ ਚਲਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "सर सेल सनाहरि छूटहिगे ॥",
      "sourceLineId": "99259",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰਣ ਰੰਗਿ ਸੁਰਾਸੁਰ ਜੂਟਹਿਗੇ ॥",
      "transliteration": "ran ra(n)g suraasur jooTahige ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਦੇਵਤੇ ਅਤੇ ਦੈਂਤ ਜੁਟਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "रण रंगि सुरासुर जूटहिगे ॥",
      "sourceLineId": "99260",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਰ ਸੇਲ ਸਨਾਹਰਿ ਝਾਰਹਿਗੇ ॥",
      "transliteration": "sar sel sanaahar jhaarahige ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ ਅਤੇ ਬਰਛੇ ਕਵਚਾ ਉਤੇ ਝਾੜਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "सर सेल सनाहरि झारहिगे ॥",
      "sourceLineId": "99261",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮੁਖ ਮਾਰ ਪਚਾਰ ਪ੍ਰਹਾਰਹਿਗੇ ॥੩੦੮॥",
      "transliteration": "mukh maar pachaar prahaarahige ||308||",
      "translation": "The arrows contacting the armours will be discharged and in this war, the gods and demons will all confront one another, there will be showers of lances and arrows and the warriors will strike shouting “kill, kill” from their months.308.",
      "punjabiViakhya": "ਮੂੰਹ ਤੋਂ 'ਮਾਰੋ' 'ਮਾਰੋ' ਲਲਕਾਰ ਕੇ (ਸ਼ਸਤ੍ਰਾ ਦਾ) ਪ੍ਰਹਾਰ ਕਰਨਗੇ ॥੩੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "मुख मार पचार प्रहारहिगे ॥३०८॥",
      "sourceLineId": "99262",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਮਡਢ ਕ੍ਰਿਪਾਣ ਨਿਕਾਰਹਿਗੇ ॥",
      "transliteration": "jamaddadd kirapaan nikaarahige ||",
      "translation": "",
      "punjabiViakhya": "ਜਮਦਾੜ੍ਰਹਾ ਅਤੇ ਤਲਵਾਰ ਕਢਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "जमडढ कृपाण निकारहिगे ॥",
      "sourceLineId": "99263",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਰਿ ਕੋਪ ਸੁਰਾਸੁਰ ਝਾਰਹਿਗੇ ॥",
      "transliteration": "kar kop suraasur jhaarahige ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਕਰ ਕੇ ਦੇਵਤੇ ਅਤੇ ਦੈਂਤ (ਇਕ ਦੂਜੇ ਉਤੇ) ਝਾੜਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "करि कोप सुरासुर झारहिगे ॥",
      "sourceLineId": "99264",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਣਿ ਲੁਥ ਪੈ ਲੁਥ ਗਿਰਾਵਹਿਗੇ ॥",
      "transliteration": "ran luth pai luth giraavahige ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਲੋਥ ਉਤੇ ਲੋਥ ਚੜ੍ਰਹਾਉਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "रणि लुथ पै लुथ गिरावहिगे ॥",
      "sourceLineId": "99265",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਲਖਿ ਪ੍ਰੇਤ ਪਰੀ ਰਹਸਾਵਹਿਗੇ ॥੩੦੯॥",
      "transliteration": "lakh pret paree rahasaavahige ||309||",
      "translation": "He will take out his axe and sword and in his fury, he will strike the gods and demons, he will cause the corpses fall over corpses in the war-arena and seeing this, the fiends and fairies will get pleased.309.",
      "punjabiViakhya": "ਪ੍ਰੇਤ ਅਤੇ ਪਰੀਆਂ ਵੇਖ ਕੇ ਪ੍ਰਸੰਨ ਹੋਣਗੀਆਂ ॥੩੦੯॥",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "लखि प्रेत परी रहसावहिगे ॥३०९॥",
      "sourceLineId": "99266",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਣਿ ਗੂੜ ਅਗੂੜਣਿ ਗਜਹਿਗੇ ॥",
      "transliteration": "ran gooR agooRan gajahige ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਵਿਚ (ਸੂਰਮੇ) ਪ੍ਰਗਟ ਅਤੇ ਗੁਪਤ ਗਜਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "रणि गूड़ अगूड़णि गजहिगे ॥",
      "sourceLineId": "99267",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਲਖਿ ਭੀਰ ਭਯਾਹਵ ਭਜਹਿਗੇ ॥",
      "transliteration": "lakh bheer bhayaahav bhajahige ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਭਿਆਨਕ ਯੁੱਧ ਨੂੰ ਵੇਖ ਕੇ ਕਾਇਰ ਲੋਕ ਭਜ ਜਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "लखि भीर भयाहव भजहिगे ॥",
      "sourceLineId": "99268",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਰ ਬਿੰਦ ਪ੍ਰਬਿੰਦ ਪ੍ਰਹਾਰਹਿਗੇ ॥",
      "transliteration": "sar bi(n)dh prabi(n)dh prahaarahige ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਛੇਤੀ ਛੇਤੀ (ਅਰਥਾਤਰ-ਝੁੰਡਾ ਦੇ ਝੁੰਡ) ਤੀਰ ਚਲਾਉਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "सर बिंद प्रबिंद प्रहारहिगे ॥",
      "sourceLineId": "99269",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਣਰੰਗਿ ਅਭੀਤ ਬਿਹਾਰਹਿਗੇ ॥੩੧੦॥",
      "transliteration": "ranara(n)g abheet bihaarahige ||310||",
      "translation": "The ganas of Shiva will roar and seeing them in affliction, all the people will run away, they will move in the war-arena discharging the arrows continuously.310.",
      "punjabiViakhya": "ਅਤੇ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਨਿਡਰ ਹੋ ਕੇ ਫਿਰਨਗੇ ॥੩੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "रणरंगि अभीत बिहारहिगे ॥३१०॥",
      "sourceLineId": "99270",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਖਗ ਉਧ ਅਧੋ ਅਧ ਬਜਹਿਗੇ ॥",
      "transliteration": "khag udh adho adh bajahige ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਉੱਚੀਆਂ ਉਠ ਕੇ ਅੱਧੀਆਂ ਪਚਧੀਆਂ ਵਜਣਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "खग उध अधो अध बजहिगे ॥",
      "sourceLineId": "99271",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਲਖਿ ਜੋਧ ਮਹਾ ਜੁਧ ਗਜਹਿਗੇ ॥",
      "transliteration": "lakh jodh mahaa judh gajahige ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧੇ ਮਹਾਨ ਯੁੱਧ ਨੂੰ ਵੇਖ ਕੇ ਗਜਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "लखि जोध महा जुध गजहिगे ॥",
      "sourceLineId": "99272",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਣਿਣੇਸ ਦੁਹੂੰ ਦਿਸ ਢੂਕਹਿਗੇ ॥",
      "transliteration": "anines dhuhoo(n) dhis ddookahige ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਪਾਸਿਆਂ ਦੇ ਸੈਨਾਪਤੀ ('ਅਣਿਣੇਸ') (ਸਾਹਮਣੇ ਹੋ ਕੇ) ਢੁਕਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "अणिणेस दुहूँ दिस ढूकहिगे ॥",
      "sourceLineId": "99273",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮੁਖ ਮਾਰ ਮਹਾ ਸੁਰ ਕੂਕਹਿਗੇ ॥੩੧੧॥",
      "transliteration": "mukh maar mahaa sur kookahige ||311||",
      "translation": "The swords will collide with one another and seeing all this, the great warriors will thunder, the generals will march forward from both the sides and shout “kill, kill” from their mouths.311.",
      "punjabiViakhya": "ਮੁਖ ਤੋਂ 'ਮਾਰੋ ਮਾਰੋ' ਉੱਚੇ ਸੁਰ ਨਾਲ ਕੂਕਣਗੇ ॥੩੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "मुख मार महा सुर कूकहिगे ॥३११॥",
      "sourceLineId": "99274",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗਣ ਗੰਧ੍ਰਵ ਦੇਵ ਨਿਹਾਰਹਿਗੇ ॥",
      "transliteration": "gan ga(n)dhrav dhev nihaarahige ||",
      "translation": "",
      "punjabiViakhya": "ਗਣ, ਗੰਧਰਬ ਅਤੇ ਦੇਵਤੇ (ਯੁੱਧ ਨੂੰ) ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "गण गंध्रव देव निहारहिगे ॥",
      "sourceLineId": "99275",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੈ ਸਦ ਨਿਨਦ ਪੁਕਾਰਹਿਗੇ ॥",
      "transliteration": "jai sadh ninadh pukaarahige ||",
      "translation": "",
      "punjabiViakhya": "ਅਖੰਡ ਸੁਰ ਨਾਲ ਜੈ-ਜੈਕਾਰ ਦਾ ਸ਼ਬਦ ਉਚਾਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "जै सद निनद पुकारहिगे ॥",
      "sourceLineId": "99276",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਮਦਾੜਿ ਕ੍ਰਿਪਾਣਣਿ ਬਾਹਹਿਗੇ ॥",
      "transliteration": "jamadhaaR kirapaanan baahahige ||",
      "translation": "",
      "punjabiViakhya": "ਜਮਦਾੜ੍ਰਹਾ ਅਤੇ ਕ੍ਰਿਪਾਨਾ ਚਲਾਉਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "जमदाड़ि कृपाणणि बाहहिगे ॥",
      "sourceLineId": "99277",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਧਅੰਗ ਅਧੋਅਧ ਲਾਹਹਿਗੇ ॥੩੧੨॥",
      "transliteration": "adha(n)g adhoadh laahahige ||312||",
      "translation": "Ganas, Gandharvas and gods will see all this and will raise the sounds of “hail, hail”, the axes and swords will be struck and the limbs, being cut into halves, will fall,312.",
      "punjabiViakhya": "(ਯੋਧਿਆਂ ਦੇ) ਅੱਧੇ ਅੱਧੇ ਕਰ ਕੇ (ਅਗੇ ਹੀ) ਅਧੇ ਹੋਏ ਅੰਗ ਉਤਾਰ ਦੇਣਗੇ ॥੩੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "अधअंग अधोअध लाहहिगे ॥३१२॥",
      "sourceLineId": "99278",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਰਣਰੰਗਿ ਤੁਰੰਗੈ ਬਾਜਹਿਗੇ ॥",
      "transliteration": "ranara(n)g tura(n)gai baajahige ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਤੁਰੀਆਂ ਵਜਣਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "रणरंगि तुरंगै बाजहिगे ॥",
      "sourceLineId": "99279",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਡਫ ਝਾਝ ਨਫੀਰੀ ਗਾਜਹਿਗੇ ॥",
      "transliteration": "ddaf jhaajh nafeeree gaajahige ||",
      "translation": "",
      "punjabiViakhya": "ਡਫ, ਝਾਝ ਅਤੇ ਨਫੀਰੀਆਂ ਗਜਣਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "डफ झाझ नफीरी गाजहिगे ॥",
      "sourceLineId": "99280",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਣਿਣੇਸ ਦੁਹੂੰ ਦਿਸ ਧਾਵਹਿਗੈ ॥",
      "transliteration": "anines dhuhoo(n) dhis dhaavahigai ||",
      "translation": "",
      "punjabiViakhya": "ਸੈਨਾਪਤੀ ('ਅਣਿਣੇਸ') ਦੋਹਾ ਦਿਸ਼ਾਵਾ ਵਿਚ ਧਾਵਾ ਕਰਨਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "अणिणेस दुहूँ दिस धावहिगै ॥",
      "sourceLineId": "99281",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਰਿ ਕਾਢਿ ਕ੍ਰਿਪਾਣ ਕੰਪਾਵਹਿਗੇ ॥੩੧੩॥",
      "transliteration": "kar kaadd kirapaan ka(n)paavahige ||313||",
      "translation": "The intoxicated horses imbued with war, will neigh and the sound of anklets and small cymbals will be heard, the generals of both the sides will fall upon each other and will glisten their swords, while holding them in their hands.313.",
      "punjabiViakhya": "ਅਤੇ ਹੱਥਾ ਵਿਚ ਕ੍ਰਿਪਾਨਾ ਕਢ ਕੇ ਘੁੰਮਾਉਣਗੇ ॥੩੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "करि काढि कृपाण कंपावहिगे ॥३१३॥",
      "sourceLineId": "99282",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਰਣਿ ਕੁੰਜਰ ਪੁੰਜ ਗਰਜਹਿਗੇ ॥",
      "transliteration": "ran ku(n)jar pu(n)j garajahige ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀਆਂ ਵਿਚ ਹਾਥੀਆਂ ਦੇ ਝੁੰਡ ਗਰਜਨਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "रणि कुँजर पुँज गरजहिगे ॥",
      "sourceLineId": "99283",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਲਖਿ ਮੇਘ ਮਹਾ ਦੁਤਿ ਲਜਹਿਗੇ ॥",
      "transliteration": "lakh megh mahaa dhut lajahige ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਦੀ) ਮਹਾਨ ਸ਼ੋਭਾ ਨੂੰ ਵੇਖ ਕੇ ਬਦਲ ਸ਼ਰਮਿੰਦੇ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "लखि मेघ महा दुति लजहिगे ॥",
      "sourceLineId": "99284",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰਿਸ ਮੰਡਿ ਮਹਾ ਰਣ ਜੂਟਹਿਗੇ ॥",
      "transliteration": "ris ma(n)dd mahaa ran jooTahige ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ (ਉਸ) ਮਹਾਨ ਯੁੱਧ ਵਿਚ ਜੁਟਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "रिस मंडि महा रण जूटहिगे ॥",
      "sourceLineId": "99285",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਛੁਟਿ ਛਤ੍ਰ ਛਟਾਛਟ ਛੂਟਹਿਗੇ ॥੩੧੪॥",
      "transliteration": "chhuT chhatr chhaTaachhaT chhooTahige ||314||",
      "translation": "The groups of elephants will roar in the war-arena and seeing them, the clouds will feel shy, all will fight in anger and the canopies of chariots etc. will drop from the hands of the warriors very quickly.314.",
      "punjabiViakhya": "ਛਤ੍ਰ ਜਲਦੀ ਜਲਦੀ ਛੁਟ ਕੇ ਡਿਗਣਗੇ ॥੩੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "छुटि छत्र छटाछट छूटहिगे ॥३१४॥",
      "sourceLineId": "99286",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਰਣਣੰਕ ਨਿਸਾਣ ਦਿਸਾਣ ਘੁਰੇ ॥",
      "transliteration": "ranana(n)k nisaan dhisaan ghure ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਨਗਾਰੇ (ਸਾਰੀਆਂ) ਦਿਸ਼ਾਵਾ ਵਿਚ ਗੂੰਜਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "रणणंक निसाण दिसाण घुरे ॥",
      "sourceLineId": "99287",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਗੜਗਜ ਹਠੀ ਰਣ ਰੰਗਿ ਫਿਰੇ ॥",
      "transliteration": "gaRagaj haThee ran ra(n)g fire ||",
      "translation": "",
      "punjabiViakhya": "ਗੜਗਜ ਹਠੀਲੇ (ਯੋਧੇ) ਰਣ-ਭੂਮੀ ਵਿਚ ਫਿਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "गड़गज हठी रण रंगि फिरे ॥",
      "sourceLineId": "99288",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਰਿ ਕੋਪ ਕ੍ਰਿਪਾਣ ਪ੍ਰਹਾਰਹਿਗੇ ॥",
      "transliteration": "kar kop kirapaan prahaarahige ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਤਲਵਾਰਾ ਚਲਾਉਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "करि कोप कृपाण प्रहारहिगे ॥",
      "sourceLineId": "99289",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭਟ ਘਾਇ ਝਟਾਝਟ ਝਾਰਹਿਗੇ ॥੩੧੫॥",
      "transliteration": "bhaT ghai jhaTaajhaT jhaarahige ||315||",
      "translation": "The war-trumpets sounded in all the directions and the warriors raising shouts turned towards the war-arena, now in their fury, they will strike blows with their swords and will quickly inflict wounds on the warriors.315.",
      "punjabiViakhya": "ਯੋਧੇ ਝਟਪਟ (ਸ਼ਸਤ੍ਰ) ਝਾੜ ਕੇ ਘਾਇਲ ਕਰਨਗੇ ॥੩੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "भट घाइ झटाझट झारहिगे ॥३१५॥",
      "sourceLineId": "99290",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਰਿ ਕਾਢਿ ਕ੍ਰਿਪਾਣ ਕੰਪਾਵਹਿਗੇ ॥",
      "transliteration": "kar kaadd kirapaan ka(n)paavahige ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰ ਕਢ ਕੇ ਹੱਥਾ ਵਿਚ ਕੰਬਾਉਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "करि काढि कृपाण कंपावहिगे ॥",
      "sourceLineId": "99291",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਲਿਕੀ ਕਲਿ ਕ੍ਰਿਤ ਬਢਾਵਹਿਗੇ ॥",
      "transliteration": "kalikee kal kirat baddaavahige ||",
      "translation": "",
      "punjabiViakhya": "ਕਲਕੀ ਅਵਤਾਰ ਕਲਿਯੁਗ ਵਿਚ ਆਪਣਾ ਯਸ਼ ਵਧਾਉਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "कलिकी कलि कृत बढावहिगे ॥",
      "sourceLineId": "99292",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਰਣਿ ਲੁਥ ਪਲੁਥ ਬਿਥਾਰਹਿਗੇ ॥",
      "transliteration": "ran luth paluth bithaarahige ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਲੋਥਾ ਉਤੇ ਲੋਥਾ ਖਿਲਾਰ ਦੇਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "रणि लुथ पलुथ बिथारहिगे ॥",
      "sourceLineId": "99293",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਕਿ ਤੀਰ ਸੁ ਬੀਰਨ ਮਾਰਹਿਗੇ ॥੩੧੬॥",
      "transliteration": "tak teer su beeran maarahige ||316||",
      "translation": "Taking out his sword in his hand and glistening it, Kalki will increase his approbation in the Iron Age, he will scatter the corpse upon corpse and aiming the warriors as targets, he will kill them.316.",
      "punjabiViakhya": "ਤਕ ਤਕ ਕੇ ਸੂਰਮਿਆਂ ਨੂੰ ਤੀਰ ਮਾਰਨਗੇ ॥੩੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "तकि तीर सु बीरन मारहिगे ॥३१६॥",
      "sourceLineId": "99294",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਘਣ ਘੁੰਘਰ ਘੋਰ ਘਮਕਹਿਗੇ ॥",
      "transliteration": "ghan ghu(n)ghar ghor ghamakahige ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਸਾਰੇ ਘੁੰਘਰੂ ਭਿਆਨਕ ਸੁਰ ਨਾਲ ਖੜਕਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "घण घुँघर घोर घमकहिगे ॥",
      "sourceLineId": "99295",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਰਣ ਮੋ ਰਣਧੀਰ ਪਲਕਹਿਗੇ ॥",
      "transliteration": "ran mo ranadheer palakahige ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਵਿਚ ਸੂਰਮੇ ਤੀਰ ਉਛਾਲਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "रण मो रणधीर पलकहिगे ॥",
      "sourceLineId": "99296",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗਹਿ ਤੇਗ ਝੜਾਝੜ ਝਾੜਹਿਗੇ ॥",
      "transliteration": "geh teg jhaRaajhaR jhaaRahige ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਫੜ ਕੇ (ਵੈਰੀਆਂ ਉਤੇ) ਤੁਰਤ ਝਾੜ ਦੇਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 582,
      "hindi": "",
      "hindiTransliteration": "गहि तेग झड़ाझड़ झाड़हिगे ॥",
      "sourceLineId": "99297",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0582_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਕਿ ਤੀਰ ਤੜਾਤੜ ਤਾੜਹਿਗੇ ॥੩੧੭॥",
      "transliteration": "tak teer taRaataR taaRahige ||317||",
