{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 583,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0583_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗਜ ਬਾਜ ਰਥੀ ਰਥ ਕੂਟਹਿਗੇ ॥",
      "transliteration": "gaj baaj rathee rath kooTahige ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਥੀ, ਘੋੜੇ, ਰਥਵਾਨ ਅਤੇ ਰਥਾ ਨੂੰ ਕੁਟਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "गज बाज रथी रथ कूटहिगे ॥",
      "sourceLineId": "99299",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗਹਿ ਕੇਸਨ ਏਕਿਨ ਝੂਟਹਿਗੇ ॥",
      "transliteration": "geh kesan ekin jhooTahige ||",
      "translation": "",
      "punjabiViakhya": "ਇਕਨਾ (ਯੋਧਿਆਂ) ਨੂੰ ਕੇਸਾ ਤੋਂ ਪਕੜ ਕੇ ਝਟਕੇ ਦੇਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "गहि केसन एकिन झूटहिगे ॥",
      "sourceLineId": "99300",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਲਖ ਲਾਤਨ ਮੁਸਟ ਪ੍ਰਹਾਰਹਿਗੇ ॥",
      "transliteration": "lakh laatan musaT prahaarahige ||",
      "translation": "",
      "punjabiViakhya": "ਲੱਖਾ (ਯੋਧਿਆਂ) ਨੂੰ ਲਤਾ ਅਤੇ ਮੁਕਿਆਂ ਨਾਲ ਕੁਟਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "लख लातन मुसट प्रहारहिगे ॥",
      "sourceLineId": "99301",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਣਿ ਦਾਤਨ ਕੇਸਨੁ ਪਾਰਹਿਗੇ ॥੩੧੮॥",
      "transliteration": "ran dhaatan kesan paarahige ||318||",
      "translation": "The elephants, horses, chariots and chariot-riders will be chopped and the warriors catching each other by their hair, they ill swing, there will be blows of legs and fists and the heads will be shattered with teeth.318.",
      "punjabiViakhya": "ਯੁੱਧਭੂਮੀ ਵਿਚ (ਇਕਨਾ ਦੇ) ਦੰਦ ਅਤੇ ਕੇਸ ਪੁਟ ਦੇਣਗੇ ॥੩੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "रणि दातन केसनु पारहिगे ॥३१८॥",
      "sourceLineId": "99302",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਵਣੇਸ ਅਣੀਣਿ ਸੁਧਾਰਹਿਗੇ ॥",
      "transliteration": "avanes aneen sudhaarahige ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਿਆਂ ਅਤੇ ਸੈਨਾ ਨਾਇਕਾ ਨੂੰ ਸੁਧਾਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "अवणेस अणीणि सुधारहिगे ॥",
      "sourceLineId": "99303",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਰਿ ਬਾਣ ਕ੍ਰਿਪਾਣ ਸੰਭਾਰਹਿਗੇ ॥",
      "transliteration": "kar baan kirapaan sa(n)bhaarahige ||",
      "translation": "",
      "punjabiViakhya": "ਹੱਥ ਵਿਚ ਬਾਣ ਤੇ ਕ੍ਰਿਪਾਨ ਸੰਭਾਲਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "करि बाण कृपाण संभारहिगे ॥",
      "sourceLineId": "99304",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਰਿ ਰੋਸ ਦੁਹੂੰ ਦਿਸਿ ਧਾਵਹਿਗੇ ॥",
      "transliteration": "kar ros dhuhoo(n) dhis dhaavahige ||",
      "translation": "",
      "punjabiViakhya": "ਰੋਸ ਕਰ ਕੇ ਦੋਹਾ ਪਾਸਿਆਂ ਨੂੰ ਭਜਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "करि रोस दुहूँ दिसि धावहिगे ॥",
      "sourceLineId": "99305",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਣਿ ਸੀਝਿ ਦਿਵਾਲਯ ਪਾਵਹਿਗੇ ॥੩੧੯॥",
      "transliteration": "ran seejh dhivaalay paavahige ||319||",
      "translation": "The kings of the earth will re-array their armies and hold their bows and arrows, there will be fought a dreadful war in anger in both the directions and the warriors will obtain a place in heaven in the dreadful war.319.",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਜਿਤ ਕੇ ਸਵਰਗ ('ਦਿਵਾਲਯ') ਨੂੰ ਪ੍ਰਾਪਤ ਕਰਨਗੇ ॥੩੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "रणि सीझि दिवालय पावहिगे ॥३१९॥",
      "sourceLineId": "99306",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਛਣਣੰਕਿ ਕ੍ਰਿਪਾਣ ਛਣਕਹਿਗੀ ॥",
      "transliteration": "chhanana(n)k kirapaan chhanakahigee ||",
      "translation": "",
      "punjabiViakhya": "ਛਣਕਾਰ ਕਰਦੀ ਹੋਈ ਕ੍ਰਿਪਾਨ ਛਣਕੇਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "छणणंकि कृपाण छणकहिगी ॥",
      "sourceLineId": "99307",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਝਣਣਕਿ ਸੰਜੋਅ ਝਣਕਹਿਗੀ ॥",
      "transliteration": "jhananak sa(n)joa jhanakahigee ||",
      "translation": "",
      "punjabiViakhya": "ਝਣ-ਝਣ ਕਰਦੀਆਂ ਕਵਚਾ ਡਿਗਣਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "झणणकि संजोअ झणकहिगी ॥",
      "sourceLineId": "99308",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਣਣੰਛਿ ਕੰਧਾਰਿ ਕਣਛਹਿਗੇ ॥",
      "transliteration": "kanana(n)chh ka(n)dhaar kanachhahige ||",
      "translation": "",
      "punjabiViakhya": "ਕੰਧਾਰੀ ਘੋੜਿਆਂ ਦੀ ਹਿਣਹਿਣਾਹਠ ਹੋਵੇਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "कणणंछि कंधारि कणछहिगे ॥",
      "sourceLineId": "99309",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਣਰੰਗਿ ਸੁ ਚਾਚਰ ਮਚਹਿਗੇ ॥੩੨੦॥",
      "transliteration": "ranara(n)g su chaachar machahige ||320||",
      "translation": "The swords will clatter and the jingling of the steel armours will be heard, the sharp-edged weapons will produce knocking sounds and the Holi of the war will be played.320.",
      "punjabiViakhya": "ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਫਾਗ ਮਚੇਗੀ ॥੩੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "रणरंगि सु चाचर मचहिगे ॥३२०॥",
      "sourceLineId": "99310",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦੁਹੂੰ ਓਰ ਤੇ ਸਾਗ ਅਨਚਹਿਗੀ ॥",
      "transliteration": "dhuhoo(n) or te saag anachahigee ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਪਾਸਿਆਂ ਤੋਂ ਬਰਛੇ ਉਗਰੇ ਜਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "दुहूँ ओर ते साग अनचहिगी ॥",
      "sourceLineId": "99311",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਟਿ ਧੂਰਿ ਧਰਾਰੰਗਿ ਰਚਹਿਗੀ ॥",
      "transliteration": "jaT dhoor dharaara(n)g rachahigee ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਧੂੜ ਵਿਚ ਧੁੰਧਲੇ ਹੋ ਜਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "जटि धूरि धरारंगि रचहिगी ॥",
      "sourceLineId": "99312",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਰਵਾਰਿ ਕਟਾਰੀਆ ਬਜਹਿਗੀ ॥",
      "transliteration": "karavaar kaTaareeaa bajahigee ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਤੇ ਕਟਾਰਾ ਜ਼ੋਰ ਨਾਲ ਵਜਣਗੀਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "करवारि कटारीआ बजहिगी ॥",
      "sourceLineId": "99313",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਘਟ ਸਾਵਣਿ ਜਾਣੁ ਸੁ ਗਜਹਿਗੀ ॥੩੨੧॥",
      "transliteration": "ghaT saavan jaanu su gajahigee ||321||",
      "translation": "The lances will be struck from both sides and the matted locks of the warriors will roll in dust, the spears will collide while striking blows like the thundering of the clouds of Sawan.321.",
      "punjabiViakhya": "ਮਾਨੋ ਸਾਵਣ ਦੀਆਂ ਘਟਾਵਾ ਗਰਜ ਰਹੀਆਂ ਹੋਣ ॥੩੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "घट सावणि जाणु सु गजहिगी ॥३२१॥",
      "sourceLineId": "99314",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਭਟ ਦਾਤਨ ਪੀਸ ਰਿਸਾਵਹਿਗੇ ॥",
      "transliteration": "bhaT dhaatan pees risaavahige ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧੇ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਦੰਦ ਪੀਹਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "भट दातन पीस रिसावहिगे ॥",
      "sourceLineId": "99315",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦੁਹੂੰ ਓਰਿ ਤੁਰੰਗ ਨਚਾਵਹਿਗੇ ॥",
      "transliteration": "dhuhoo(n) or tura(n)g nachaavahige ||",
      "translation": "",
      "punjabiViakhya": "(ਯੋਧੇ) ਦੋਹਾ ਪਾਸੇ ਘੋੜਿਆਂ ਨੂੰ ਨਚਾਉਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "दुहूँ ओरि तुरंग नचावहिगे ॥",
      "sourceLineId": "99316",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਣਿ ਬਾਣ ਕਮਾਣਣਿ ਛੋਰਹਿਗੇ ॥",
      "transliteration": "ran baan kamaanan chhorahige ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਅੰਦਰ ਕਮਾਨਾ ਵਿਚੋਂ ਤੀਰ ਛਡਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "रणि बाण कमाणणि छोरहिगे ॥",
      "sourceLineId": "99317",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹਯ ਤ੍ਰਾਣ ਸਨਾਹਿਨ ਫੋਰਹਿਗੇ ॥੩੨੨॥",
      "transliteration": "hay traan sanaahin forahige ||322||",
      "translation": "The warriors grinding their teeth in anger will cause their horses to dance from both sides, they will discharged arrows from their bows in the war-arena and will cut the saddles of horses and the armours.322.",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨਾਲ) ਘੋੜਿਆਂ ਦੀਆਂ (ਲੋਹੇ ਦੀਆਂ ਜਾਲੀਦਾਰ) ਝੁਲਾ ਅਤੇ ਕਵਚ ('ਸਨਾਹਿਨ') ਭੰਨਣਗੇ ॥੩੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "हय त्राण सनाहिन फोरहिगे ॥३२२॥",
      "sourceLineId": "99318",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਘਟਿ ਜਿਉ ਘਣਿ ਕੀ ਘੁਰਿ ਢੂਕਹਿਗੇ ॥",
      "transliteration": "ghaT jiau ghan kee ghur ddookahige ||",
      "translation": "",
      "punjabiViakhya": "(ਸੈਨਾਵਾ) ਬਦਲਾ ਦੀਆਂ ਘਟਾਵਾ ਵਾਗ ਗਰਜਦੀਆਂ ਹੋਈਆਂ ਨੇੜੇ ਢੁਕਣਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "घटि जिउ घणि की घुरि ढूकहिगे ॥",
      "sourceLineId": "99319",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮੁਖ ਮਾਰ ਦਸੋ ਦਿਸ ਕੂਕਹਿਗੇ ॥",
      "transliteration": "mukh maar dhaso dhis kookahige ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਦਿਸ਼ਾਵਾ ਤੋਂ (ਯੋਧੇ) 'ਮਾਰੋ' 'ਮਾਰੋ' ਕੂਕਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "मुख मार दसो दिस कूकहिगे ॥",
      "sourceLineId": "99320",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮੁਖ ਮਾਰ ਮਹਾ ਸੁਰ ਬੋਲਹਿਗੇ ॥",
      "transliteration": "mukh maar mahaa sur bolahige ||",
      "translation": "",
      "punjabiViakhya": "ਮੂੰਹ ਤੋਂ ਉੱਚੀ ਆਵਾਜ਼ ਵਿਚ 'ਮਾਰੋ' 'ਮਾਰੋ' ਬੋਲਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "मुख मार महा सुर बोलहिगे ॥",
      "sourceLineId": "99321",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗਿਰਿ ਕੰਚਨ ਜੇਮਿ ਨ ਡੋਲਹਿਗੇ ॥੩੨੩॥",
      "transliteration": "gir ka(n)chan jem na ddolahige ||323||",
      "translation": "The warriors will rush forth like clouds and will roam in all the ten directions, shouting,”kill, kill”, with their utterance of “kill, kill”, the heart of Sumeru mountain will all move.323.",
      "punjabiViakhya": "ਸੁਮੇਰ ਪਰਬਤ ਵਾਗ ਨਹੀਂ ਡੋਲਣਗੇ ॥੩੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "गिरि कंचन जेमि न डोलहिगे ॥३२३॥",
      "sourceLineId": "99322",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹਯ ਕੋਟਿ ਗਜੀ ਗਜ ਜੁਝਹਿਗੇ ॥",
      "transliteration": "hay koT gajee gaj jujhahige ||",
      "translation": "",
      "punjabiViakhya": "ਕਰੋੜਾ ਘੋੜੇ, ਹਾਥੀ ਅਤੇ ਹਾਥੀਆਂ ਦੇ ਸਵਾਰ ਜੂਝਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "हय कोटि गजी गज जुझहिगे ॥",
      "sourceLineId": "99323",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਵਿ ਕੋਟਿ ਕਹਾ ਲਗ ਬੁਝਹਿਗੇ ॥",
      "transliteration": "kav koT kahaa lag bujhahige ||",
      "translation": "",
      "punjabiViakhya": "ਕਵੀ ਕਰੋੜਾ ਦੀ ਗਿਣਤੀ ਕਿਥੋਂ ਤਕ ਕਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "कवि कोटि कहा लग बुझहिगे ॥",
      "sourceLineId": "99324",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗਣ ਦੇਵ ਅਦੇਵ ਨਿਹਾਰਹਿਗੇ ॥",
      "transliteration": "gan dhev adhev nihaarahige ||",
      "translation": "",
      "punjabiViakhya": "ਗਣ, ਦੇਵਤੇ ਅਤੇ ਦੈਂਤ ਵੇਖਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "गण देव अदेव निहारहिगे ॥",
      "sourceLineId": "99325",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜੈ ਸਦ ਨਿਨਦ ਪੁਕਾਰਹਿਗੇ ॥੩੨੪॥",
      "transliteration": "jai sadh ninadh pukaarahige ||324||",
      "translation": "Crores of elephants and horses and also the riders of elephants will die fighting. To what extent the poet will describe them? The ganas, gods and demons will all see and hail.324.",
      "punjabiViakhya": "ਉੱਚੀ ਸੁਰ ਵਿਚ ਜੈ ਜੈ ਕਾਰ ਬੋਲਣਗੇ ॥੩੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "जै सद निनद पुकारहिगे ॥३२४॥",
      "sourceLineId": "99326",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਲਖ ਬੈਰਖ ਬਾਨ ਸੁਹਾਵਹਿਗੇ ॥",
      "transliteration": "lakh bairakh baan suhaavahige ||",
      "translation": "",
      "punjabiViakhya": "ਲੱਖਾ ਬਾਣ ਅਤੇ ਝੰਡੇ ਸ਼ੋਭਾ ਪਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "लख बैरख बान सुहावहिगे ॥",
      "sourceLineId": "99327",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰਣ ਰੰਗ ਸਮੈ ਫਹਰਾਵਹਿਗੇ ॥",
      "transliteration": "ran ra(n)g samai faharaavahige ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ-ਭੂਮੀ ਵਿਚ (ਯੁੱਧ) ਵੇਲੇ ਲਹਿਰਾਉਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "रण रंग समै फहरावहिगे ॥",
      "sourceLineId": "99328",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਰ ਢਾਲ ਢਲਾ ਢਲ ਢੂਕਹਿਗੇ ॥",
      "transliteration": "bar ddaal ddalaa ddal ddookahige ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਗੀਆਂ ਢਾਲਾ ਢਲ ਢਲ ਕਰ ਕੇ ਟਕਰਾਉਣਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "बर ढाल ढला ढल ढूकहिगे ॥",
      "sourceLineId": "99329",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮੁਖ ਮਾਰ ਦਸੋ ਦਿਸਿ ਕੂਕਹਿਗੇ ॥੩੨੫॥",
      "transliteration": "mukh maar dhaso dhis kookahige ||325||",
      "translation": "Lakhs of lances and arrows will be discharged and the banners of all colours will wave in the war-arena, the superb warriors will fall on the enemies taking their shields etc. and in all the ten directions the sound of “kill, kill” will be heard.325.",
      "punjabiViakhya": "ਦਸਾ ਦਿਸ਼ਾਵਾ ਵਿਚ (ਯੋਧੇ) 'ਮਾਰੋ' 'ਮਾਰੋ' ਬੋਲਣਗੇ ॥੩੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "मुख मार दसो दिसि कूकहिगे ॥३२५॥",
      "sourceLineId": "99330",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਨ ਤ੍ਰਾਣ ਪੁਰਜਨ ਉਡਹਿਗੇ ॥",
      "transliteration": "tan traan purajan uddahige ||",
      "translation": "",
      "punjabiViakhya": "ਕਵਚਾ ('ਤਨੁ ਤ੍ਰਾਣ') ਦੇ ਪੁਰਜ਼ੇ ਉਡਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "तन त्राण पुरजन उडहिगे ॥",
      "sourceLineId": "99331",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗਡਵਾਰ ਗਾਡਾਗਡ ਗੁਡਹਿਗੇ ॥",
      "transliteration": "gaddavaar gaaddaagadd guddahige ||",
      "translation": "",
      "punjabiViakhya": "(ਤੀਰਾ ਨੂੰ) ਗਡ ਦੇਣ ਵਾਲੇ (ਯੋਧੇ) ਗਡਾ ਗਡ ਕਰਦੇ (ਤੀਰਾ ਨੂੰ) ਗਡ ਦੇਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "गडवार गाडागड गुडहिगे ॥",
      "sourceLineId": "99332",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰਣਿ ਬੈਰਖ ਬਾਨ ਝਮਕਹਿਗੇ ॥",
      "transliteration": "ran bairakh baan jhamakahige ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਬਾਣ ਅਤੇ ਝੰਡੇ ਝਮਕਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "रणि बैरख बान झमकहिगे ॥",
      "sourceLineId": "99333",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਟ ਭੂਤ ਪਰੇਤ ਭਭਕਹਿਗੇ ॥੩੨੬॥",
      "transliteration": "bhaT bhoot paret bhabhakahige ||326||",
      "translation": "The armours etc. will be seen flying in the war and the warriors will pitch their column of praise, the lances and arrows will be seen shining in the war-arena, besides the warriors, the ghosts and fiends will also be seen shouting loudly in the war.326.",
      "punjabiViakhya": "ਯੋਧੇ, ਭੂਤ, ਪ੍ਰੇਤ ਭਭਕਣਗੇ ॥੩੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "भट भूत परेत भभकहिगे ॥३२६॥",
      "sourceLineId": "99334",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਰ ਬੈਰਖ ਬਾਨ ਕ੍ਰਿਪਾਣ ਕਹੂੰ ॥",
      "transliteration": "bar bairakh baan kirapaan kahoo(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਰਣ ਵਿਚ) ਕਿਤੇ ਸੁੰਦਰ ਬਾਣ, ਕ੍ਰਿਪਾਨ ਅਤੇ ਝੰਡੇ (ਪਕੜੇ ਹੋਏ ਹੋਣਗੇ)।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "बर बैरख बान कृपाण कहूँ ॥",
      "sourceLineId": "99335",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਣਿ ਬੋਲਤ ਆਜ ਲਗੇ ਅਜਹੂੰ ॥",
      "transliteration": "ran bolat aaj lage ajahoo(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਯੋਧੇ) ਰਣ ਵਿਚ ਬੋਲਣਗੇ ਕਿ ਅਜ ਤਕ ਅਜਿਹਾ (ਯੁੱਧ ਨਹੀਂ) ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "रणि बोलत आज लगे अजहूँ ॥",
      "sourceLineId": "99336",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗਹਿ ਕੇਸਨ ਤੇ ਭ੍ਰਮਾਵਹਿਗੇ ॥",
      "transliteration": "geh kesan te bhramaavahige ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਨੂੰ ਕੇਸਾ ਤੋਂ ਪਕੜ ਕੇ ਘੁੰਮਾਉਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "गहि केसन ते भ्रमावहिगे ॥",
      "sourceLineId": "99337",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦਸਹੂੰ ਦਿਸਿ ਤਾਕਿ ਚਲਾਵਹਿਗੇ ॥੩੨੭॥",
      "transliteration": "dhasahoo(n) dhis taak chalaavahige ||327||",
      "translation": "Somewhere the lances and the arrows will be seen striking the targets, many will be thrown in all the ten directions by catching them from their hair.327.",
      "punjabiViakhya": "ਅਤੇ ਦਸਾ ਦਿਸ਼ਾਵਾ ਵਿਚ ਤਕ ਕੇ (ਸ਼ਸਤ੍ਰ ਅਤੇ ਅਸਤ੍ਰ) ਚਲਾਉਣਗੇ ॥੩੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "दसहूँ दिसि ताकि चलावहिगे ॥३२७॥",
      "sourceLineId": "99338",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਰੁਣੰ ਬਰਣੰ ਭਟ ਪੇਖੀਅਹਿਗੇ ॥",
      "transliteration": "aruna(n) barana(n) bhaT pekheeahige ||",
      "translation": "",
      "punjabiViakhya": "(ਸਾਰੇ) ਯੋਧੇ ਲਾਲ ਰੰਗ ਵਿਚ ਦਿਖਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "अरुणं बरणं भट पेखीअहिगे ॥",
      "sourceLineId": "99339",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਰਣੰ ਕਿਰਣੰ ਸਰ ਲੇਖੀਅਹਿਗੇ ॥",
      "transliteration": "tarana(n) kirana(n) sar lekheeahige ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਜ ਦੀਆਂ ਕਿਰਨਾ ਵਰਗੇ ਤੀਰ ਦਿਸਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "तरणं किरणं सर लेखीअहिगे ॥",
      "sourceLineId": "99340",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਹੁ ਭਾਤਿ ਪ੍ਰਭਾ ਭਟ ਪਾਵਹਿਗੇ ॥",
      "transliteration": "bahu bhaat prabhaa bhaT paavahige ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧੇ ਬਹੁਤ ਤਰ੍ਰਹਾ ਦੀ ਸ਼ੋਭਾ ਪ੍ਰਾਪਤ ਕਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "बहु भाति प्रभा भट पावहिगे ॥",
      "sourceLineId": "99341",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰੰਗ ਕਿੰਸੁਕ ਦੇਖਿ ਲਜਾਵਹਿਗੇ ॥੩੨੮॥",
      "transliteration": "ra(n)g ki(n)suk dhekh lajaavahige ||328||",
      "translation": "The warriors of red colour will be seen and the arrows will be struck like the rays of the sun, the glory of the warriors will be of different type and seeing them, the kinsuk flowers will also feel shy.328.",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ) ਰੰਗ ਨੂੰ ਵੇਖ ਕੇ ਕੇਸੂ ਵੀ ਹੀਣਾ ਮਹਿਸੂਸ ਕਰੇਗਾ ॥੩੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "रंग किंसुक देखि लजावहिगे ॥३२८॥",
      "sourceLineId": "99342",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗਜ ਬਾਜ ਰਥੀ ਰਥ ਜੁਝਹਿਗੇ ॥",
      "transliteration": "gaj baaj rathee rath jujhahige ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਥੀ, ਘੋੜੇ, ਰਥਾ ਵਾਲੇ, ਰਥ (ਯੁੱਧ ਵਿਚ) ਜੁਝਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "गज बाज रथी रथ जुझहिगे ॥",
      "sourceLineId": "99343",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਵਿ ਲੋਗ ਕਹਾ ਲਗਿ ਬੁਝਹਿਗੇ ॥",
      "transliteration": "kav log kahaa lag bujhahige ||",
      "translation": "",
      "punjabiViakhya": "ਕਵੀ ਲੋਕ ਕਿਥੋਂ ਤਕ (ਉਨ੍ਰਹਾ ਨੂੰ) ਸਮਝ ਸਕਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 583,
      "hindi": "",
      "hindiTransliteration": "कवि लोग कहा लगि बुझहिगे ॥",
      "sourceLineId": "99344",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0583_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਸੁ ਜੀਤ ਕੈ ਗੀਤ ਬਨਾਵਹਿਗੇ ॥",
      "transliteration": "jas jeet kai geet banaavahige ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਤ ਦੇ ਯਸ਼ ਦੇ ਗੀਤ ਬਣਾਉਣਗੇ।",
