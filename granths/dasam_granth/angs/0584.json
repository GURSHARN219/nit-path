{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 584,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0584_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਚਲੇਸ ਦੁਹੂੰ ਦਿਸਿ ਧਾਵਹਿਗੇ ॥",
      "transliteration": "achales dhuhoo(n) dhis dhaavahige ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਾੜੀ ਰਾਜੇ ਦੋਹਾ ਪਾਸੇ ਭਜਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "अचलेस दुहूँ दिसि धावहिगे ॥",
      "sourceLineId": "99347",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮੁਖਿ ਮਾਰੁ ਸੁ ਮਾਰੁ ਉਘਾਵਹਿਗੇ ॥",
      "transliteration": "mukh maaru su maar ughaavahige ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਖ ਤੋਂ 'ਮਾਰੋ' 'ਮਾਰੋ' ਉਚਾਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "मुखि मारु सु मारु उघावहिगे ॥",
      "sourceLineId": "99348",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਥਿਯਾਰ ਦੁਹੂੰ ਦਿਸਿ ਛੂਟਹਿਗੇ ॥",
      "transliteration": "hathiyaar dhuhoo(n) dhis chhooTahige ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਪਾਸਿਆਂ ਤੋਂ ਹਥਿਆਰ ਚਲਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "हथियार दुहूँ दिसि छूटहिगे ॥",
      "sourceLineId": "99349",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਰ ਓਘ ਰਣੰ ਧਨੁ ਟੂਟਹਿਗੇ ॥੩੩੦॥",
      "transliteration": "sar ogh rana(n) dhan TooTahige ||330||",
      "translation": "The stable warriors will fall upon their opponents from both sides and will shout “kill, kill” from their mouths, the weapons will strike from both sides and the volleys of arrows will be discharged.330.",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਬਹੁਤ ਸਾਰੇ ਧਨੁਸ਼ ਅਤੇ ਬਾਣ ਟੁਟਣਗੇ ॥੩੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "सर ओघ रणं धनु टूटहिगे ॥३३०॥",
      "sourceLineId": "99350",
      "sourceShabadId": "9235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹਰਿ ਬੋਲ ਮਨਾ ਛੰਦ ॥",
      "transliteration": "har bol manaa chha(n)dh ||",
      "translation": "HARIBOLMANA STANZA",
      "punjabiViakhya": "ਹਰਿ ਬੋਲ ਮਨਾ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "हरि बोल मना छंद ॥",
      "sourceLineId": "99351",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭਟ ਗਾਜਹਿਗੇ ॥",
      "transliteration": "bhaT gaajahige ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਗਜਣਗੇ (ਜਿਨ੍ਰਹਾ ਨੂੰ ਸੁਣ ਕੇ)",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "भट गाजहिगे ॥",
      "sourceLineId": "99352",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਘਨ ਲਾਜਹਿਗੇ ॥",
      "transliteration": "ghan laajahige ||",
      "translation": "",
      "punjabiViakhya": "ਬਦਲ ਵੀ ਸ਼ਰਮਿੰਦੇ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "घन लाजहिगे ॥",
      "sourceLineId": "99353",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦਲ ਜੂਟਹਿਗੇ ॥",
      "transliteration": "dhal jooTahige ||",
      "translation": "",
      "punjabiViakhya": "(ਦੋਹਾ ਪਾਸਿਆਂ ਦੇ) ਦਲ (ਆਪਸ ਵਿਚ) ਜੁਟਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "दल जूटहिगे ॥",
      "sourceLineId": "99354",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਰ ਛੂਟਹਿਗੇ ॥੩੩੧॥",
      "transliteration": "sar chhooTahige ||331||",
      "translation": "The warriors will shout, the clouds will be shy, the armies will fight and the arrows will be discharged.331.",
      "punjabiViakhya": "(ਦੋਹਾ ਧਿਰਾ ਵਲੋਂ) ਤੀਰ ਛੁਟਣਗੇ ॥੩੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "सर छूटहिगे ॥३३१॥",
      "sourceLineId": "99355",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਰ ਬਰਖਹਿਗੇ ॥",
      "transliteration": "sar barakhahige ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣਾ ਦੀ ਬਰਖਾ ਹੋਵੇਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "सर बरखहिगे ॥",
      "sourceLineId": "99356",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਧਨੁ ਕਰਖਹਿਗੇ ॥",
      "transliteration": "dhan karakhahige ||",
      "translation": "",
      "punjabiViakhya": "ਧਨੁਸ਼ਾ ਨੂੰ ਕਸਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "धनु करखहिगे ॥",
      "sourceLineId": "99357",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਸਿ ਬਾਜਹਿਗੇ ॥",
      "transliteration": "as baajahige ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਾ (ਆਪਸ ਵਿਚ) ਵਜਣਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "असि बाजहिगे ॥",
      "sourceLineId": "99358",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਣਿ ਸਾਜਹਿਗੇ ॥੩੩੨॥",
      "transliteration": "ran saajahige ||332||",
      "translation": "The warriors will be showered, there will be the twang of the bows, the sworeds will collide and the war will continue.332.",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਰਣ-ਭੂਮੀ ਸਜ ਜਾਵੇਗੀ ॥੩੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "रणि साजहिगे ॥३३२॥",
      "sourceLineId": "99359",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਭੂਅ ਡਿਗਹਿਗੇ ॥",
      "transliteration": "bhooa ddigahige ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਧਰਤੀ ਉਤੇ ਡਿਗਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "भूअ डिगहिगे ॥",
      "sourceLineId": "99360",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਯ ਭਿਗਹਿਗੇ ॥",
      "transliteration": "bhay bhigahige ||",
      "translation": "",
      "punjabiViakhya": "(ਕਾਇਰ) ਭੈ ਕਰਕੇ (ਪਸੀਨੇ ਨਾਲ) ਭਿਜਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "भय भिगहिगे ॥",
      "sourceLineId": "99361",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਉਠ ਭਾਜਹਿਗੇ ॥",
      "transliteration": "auTh bhaajahige ||",
      "translation": "",
      "punjabiViakhya": "ਉਠ ਕੇ ਭਜ ਜਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "उठ भाजहिगे ॥",
      "sourceLineId": "99362",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਹੀ ਲਾਜਹਿਗੇ ॥੩੩੩॥",
      "transliteration": "nahee laajahige ||333||",
      "translation": "The earth will thrust in and become fearful, the warriors will run away without getting shy.333.",
      "punjabiViakhya": "ਸ਼ਰਮਸਾਰ ਨਹੀਂ ਹੋਣਗੇ ॥੩੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "नही लाजहिगे ॥३३३॥",
      "sourceLineId": "99363",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗਣ ਦੇਖਹਿਗੇ ॥",
      "transliteration": "gan dhekhahige ||",
      "translation": "",
      "punjabiViakhya": "(ਸ਼ਿਵ ਦੇ) ਗਣ (ਯੁੱਧ ਨੂੰ) ਵੇਖਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "गण देखहिगे ॥",
      "sourceLineId": "99364",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਯ ਲੇਖਹਿਗੇ ॥",
      "transliteration": "jay lekhahige ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਜੈ-ਪੱਤਰ ਲਿਖਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "जय लेखहिगे ॥",
      "sourceLineId": "99365",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਸੁ ਗਾਵਹਿਗੇ ॥",
      "transliteration": "jas gaavahige ||",
      "translation": "",
      "punjabiViakhya": "ਯਸ਼ ਨੂੰ ਗਾਉਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "जसु गावहिगे ॥",
      "sourceLineId": "99366",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮੁਸਕਯਾਵਹਿਗੇ ॥੩੩੪॥",
      "transliteration": "musakayaavahige ||334||",
      "translation": "The ganas will see, they will hail, they will sing praises and smile.334.",
      "punjabiViakhya": "ਮੁਸਕਰਾਉਣਗੇ ॥੩੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "मुसकयावहिगे ॥३३४॥",
      "sourceLineId": "99367",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪ੍ਰਣ ਪੂਰਹਿਗੇ ॥",
      "transliteration": "pran poorahige ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਣ ਨੂੰ ਨਿਭਾਉਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "प्रण पूरहिगे ॥",
      "sourceLineId": "99368",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਜਿ ਰੂਰਹਿਗੇ ॥",
      "transliteration": "raj roorahige ||",
      "translation": "",
      "punjabiViakhya": "ਧੂੜ ਵਿਚ ਧੂਸਰਿਤ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "रजि रूरहिगे ॥",
      "sourceLineId": "99369",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0584_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਣਿ ਰਾਜਹਿਗੇ ॥",
      "transliteration": "ran raajahige ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਡਟਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 584,
      "hindi": "",
      "hindiTransliteration": "रणि राजहिगे ॥",
      "sourceLineId": "99370",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
