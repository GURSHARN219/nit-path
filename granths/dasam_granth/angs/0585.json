{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 585,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0585_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗਣ ਲਾਜਹਿਗੇ ॥੩੩੫॥",
      "transliteration": "gan laajahige ||335||",
      "translation": "The warriors will fulful their promises and will look beautiful, even the gods will feel shy from them in the war-arena.335.",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੂੰ ਵੇਖ ਕੇ) ਗਣ ਲਜਾਉਣਗੇ ॥੩੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "गण लाजहिगे ॥३३५॥",
      "sourceLineId": "99371",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਿਸ ਮੰਡਹਿਗੇ ॥",
      "transliteration": "ris ma(n)ddahige ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਨਾਲ ਮੰਡੇ ਹੋਏ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "रिस मंडहिगे ॥",
      "sourceLineId": "99372",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਰ ਛੰਡਹਿਗੇ ॥",
      "transliteration": "sar chha(n)ddahige ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣਾ ਨੂੰ ਛਡਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "सर छंडहिगे ॥",
      "sourceLineId": "99373",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਣ ਜੂਟਹਿਗੇ ॥",
      "transliteration": "ran jooTahige ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ ਵਿਚ ਜੁਟਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "रण जूटहिगे ॥",
      "sourceLineId": "99374",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਸਿ ਟੂਟਹਿਗੇ ॥੩੩੬॥",
      "transliteration": "as TooTahige ||336||",
      "translation": "In their fury, they will discharged arrows, during their fighting in the war, their swords will break.336.",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਟੁਟਣਗੀਆਂ ॥੩੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "असि टूटहिगे ॥३३६॥",
      "sourceLineId": "99375",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗਲ ਗਾਜਹਿਗੇ ॥",
      "transliteration": "gal gaajahige ||",
      "translation": "",
      "punjabiViakhya": "(ਯੋਧੇ) ਗਲੇ ਤੋਂ ਗਜਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "गल गाजहिगे ॥",
      "sourceLineId": "99376",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਹੀ ਭਾਜਹਿਗੇ ॥",
      "transliteration": "nahee bhaajahige ||",
      "translation": "",
      "punjabiViakhya": "(ਰਣ-ਭੂਮੀ) ਤੋਂ ਨਹੀਂ ਭਜਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "नही भाजहिगे ॥",
      "sourceLineId": "99377",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਸਿ ਝਾਰਹਿਗੇ ॥",
      "transliteration": "as jhaarahige ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਦੇ ਵਾਰ ਕਰਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "असि झारहिगे ॥",
      "sourceLineId": "99378",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਰਿ ਮਾਰਹਿਗੇ ॥੩੩੭॥",
      "transliteration": "ar maarahige ||337||",
      "translation": "The warriors will thunder, and not run away, they will strike their blows with swords and will knock down their enemies.337.",
      "punjabiViakhya": "ਵੈਰੀਆਂ ਨੂੰ ਮਾਰਨਗੇ ॥੩੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "अरि मारहिगे ॥३३७॥",
      "sourceLineId": "99379",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗਜ ਜੂਝਹਿਗੇ ॥",
      "transliteration": "gaj joojhahige ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਥੀ ਜੂਝਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "गज जूझहिगे ॥",
      "sourceLineId": "99380",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹਯ ਲੂਝਹਿਗੇ ॥",
      "transliteration": "hay loojhahige ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜੇ ਲੁਝਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "हय लूझहिगे ॥",
      "sourceLineId": "99381",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਟ ਮਾਰੀਅਹਿਗੇ ॥",
      "transliteration": "bhaT maareeahige ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਮਾਰੇ ਜਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "भट मारीअहिगे ॥",
      "sourceLineId": "99382",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭਵ ਤਾਰੀਅਹਿਗੇ ॥੩੩੮॥",
      "transliteration": "bhav taareeahige ||338||",
      "translation": "The horses will fight, the warriors will be killed and will ferry across the world-ocean.338.",
      "punjabiViakhya": "ਭਵ ਸਾਗਰ ਨੂੰ ਤਰ ਜਾਣਗੇ ॥੩੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "भव तारीअहिगे ॥३३८॥",
      "sourceLineId": "99383",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦਿਵ ਦੇਖਹਿਗੇ ॥",
      "transliteration": "dhiv dhekhahige ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤੇ ਵੇਖਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "दिव देखहिगे ॥",
      "sourceLineId": "99384",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਯ ਲੇਖਹਿਗੇ ॥",
      "transliteration": "jay lekhahige ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਤ ਨੂੰ ਜਾਣਨਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "जय लेखहिगे ॥",
      "sourceLineId": "99385",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਧਨਿ ਭਾਖਹਿਗੇ ॥",
      "transliteration": "dhan bhaakhahige ||",
      "translation": "",
      "punjabiViakhya": "ਧੰਨ ਧੰਨ ਆਖਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "धनि भाखहिगे ॥",
      "sourceLineId": "99386",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚਿਤਿ ਰਾਖਹਿਗੇ ॥੩੩੯॥",
      "transliteration": "chit raakhahige ||339||",
      "translation": "The gods will see and hail: they will utter “Bravo, Bravo” and will be pleased in their mind.339.",
      "punjabiViakhya": "ਮਨ ਵਿਚ (ਕਲਕੀ ਦਾ ਯਸ਼) ਰਖਣਗੇ ॥੩੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "चिति राखहिगे ॥३३९॥",
      "sourceLineId": "99387",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਯ ਕਾਰਣ ਹੈਂ ॥",
      "transliteration": "jay kaaran hai(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿ ਕਲਕੀ) ਜਿਤ ਦਾ ਕਾਰਨ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "जय कारण हैं ॥",
      "sourceLineId": "99388",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਰਿ ਹਾਰਣ ਹੈਂ ॥",
      "transliteration": "ar haaran hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵੈਰੀਆਂ ਨੂੰ ਹਰਾਉਣ ਵਾਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "अरि हारण हैं ॥",
      "sourceLineId": "99389",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਖਲ ਖੰਡਨੁ ਹੈਂ ॥",
      "transliteration": "khal kha(n)ddan hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦੁਸ਼ਟਾ ਨੂੰ ਖ਼ਤਮ ਕਰਨ ਵਾਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "खल खंडनु हैं ॥",
      "sourceLineId": "99390",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਹਿ ਮੰਡਨੁ ਹੈਂ ॥੩੪੦॥",
      "transliteration": "meh ma(n)ddan hai(n) ||340||",
      "translation": "The Lord is the cause of all victories and the remover of the enemies, He is the destroyer of the tyrants and is Full of Glory.340.",
      "punjabiViakhya": "ਧਰਤੀ ਦਾ ਸ਼ਿੰਗਾਰ ਹਨ ॥੩੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "महि मंडनु हैं ॥३४०॥",
      "sourceLineId": "99391",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਰਿ ਦੂਖਨ ਹੈਂ ॥",
      "transliteration": "ar dhookhan hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵੈਰੀ ਨੂੰ ਦੁਖ ਦੇਣ ਵਾਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "अरि दूखन हैं ॥",
      "sourceLineId": "99392",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭਵ ਭੂਖਨ ਹੈਂ ॥",
      "transliteration": "bhav bhookhan hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਸਾਰ ਨੂੰ (ਸ਼ਿੰਗਾਰਨ ਵਾਲੇ) ਗਹਿਣੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "भव भूखन हैं ॥",
      "sourceLineId": "99393",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮਹਿ ਮੰਡਨੁ ਹੈਂ ॥",
      "transliteration": "meh ma(n)ddan hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ ਨੂੰ ਸੁਸ਼ੋਭਿਤ ਕਰਨ ਵਾਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "महि मंडनु हैं ॥",
      "sourceLineId": "99394",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਰਿ ਡੰਡਨੁ ਹੈਂ ॥੩੪੧॥",
      "transliteration": "ar dda(n)ddan hai(n) ||341||",
      "translation": "He is the giver of suffering to the tyrants and is the ornamentation of the world, the praiseworthy Lord is the punisher of the enemies.341.",
      "punjabiViakhya": "ਵੈਰੀ ਨੂੰ ਦੰਗ ਦੇਣ ਵਾਲੇ ਹਨ ॥੩੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "अरि डंडनु हैं ॥३४१॥",
      "sourceLineId": "99395",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦਲ ਗਾਹਨ ਹੈਂ ॥",
      "transliteration": "dhal gaahan hai(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਵੈਰੀ) ਦਲ ਨੂੰ ਗਾਹਣ ਵਾਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "दल गाहन हैं ॥",
      "sourceLineId": "99396",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਸਿ ਬਾਹਨ ਹੈਂ ॥",
      "transliteration": "as baahan hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰ ਚਲਾਉਣ ਵਾਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "असि बाहन हैं ॥",
      "sourceLineId": "99397",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਗ ਕਾਰਨ ਹੈਂ ॥",
      "transliteration": "jag kaaran hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਗਤ ਦਾ ਕਾਰਨ ਰੂਪ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "जग कारन हैं ॥",
      "sourceLineId": "99398",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਯ ਧਾਰਨ ਹੈਂ ॥੩੪੨॥",
      "transliteration": "ay dhaaran hai(n) ||342||",
      "translation": "He is the destroyer of the armies and is the striker of the sword, He is the creator of the world and also its supporter.342.",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰ ('ਅਯ') ਧਾਰਨ ਕਰਨ ਵਾਲੇ ਹਨ ॥੩੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 585,
      "hindi": "",
      "hindiTransliteration": "अय धारन हैं ॥३४२॥",
      "sourceLineId": "99399",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0585_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਨ ਮੋਹਨ ਹੈਂ ॥",
      "transliteration": "man mohan hai(n) ||",
      "translation": "",
