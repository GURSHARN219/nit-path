{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 586,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0586_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਮ ਮੋਰਨ ਹੈਂ ॥੩੪੭॥",
      "transliteration": "sam moran hai(n) ||347||",
      "translation": "He comes and gives comfort and happiness, seeing he thick clouds, he gets pleased like the peacock.347.",
      "punjabiViakhya": "ਮੋਰਾ ਵਾਗ (ਬਦਲ ਦੀ ਗਰਜ ਸੁਣ ਕੇ ਪ੍ਰਸੰਨ ਹੋਣ ਵਾਲੇ) ਹਨ ॥੩੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "सम मोरन हैं ॥३४७॥",
      "sourceLineId": "99419",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਗਤੇਸ੍ਵਰ ਹੈਂ ॥",
      "transliteration": "jagatesavair hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਗਤ ਦੇ ਈਸ਼ਵਰ (ਸੁਆਮੀ) ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "जगतेस्वर हैं ॥",
      "sourceLineId": "99420",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਰੁਨਾਕਰ ਹੈਂ ॥",
      "transliteration": "karunaakar hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਰੁਣਾ ਦੀ ਖਾਣ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "करुनाकर हैं ॥",
      "sourceLineId": "99421",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭਵ ਭੂਖਨ ਹੈਂ ॥",
      "transliteration": "bhav bhookhan hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਸਾਰ ਦੇ ਭੂਸ਼ਣ (ਗਹਿਣੇ) ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "भव भूखन हैं ॥",
      "sourceLineId": "99422",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਰਿ ਦੂਖਨ ਹੈਂ ॥੩੪੮॥",
      "transliteration": "ar dhookhan hai(n) ||348||",
      "translation": "He is Merciful Lord of the world, He is the ornament of the universe and the remover of suffering.348.",
      "punjabiViakhya": "ਵੈਰੀ ਨੂੰ ਦੁਖ ਦੇਣ ਵਾਲੇ ਹਨ ॥੩੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "अरि दूखन हैं ॥३४८॥",
      "sourceLineId": "99423",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਛਬਿ ਸੋਭਿਤ ਹੈਂ ॥",
      "transliteration": "chhab sobhit hai(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੀ) ਛਬੀ ਸ਼ੋਭਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "छबि सोभित हैं ॥",
      "sourceLineId": "99424",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤ੍ਰੀਅ ਲੋਭਿਤ ਹੈਂ ॥",
      "transliteration": "treea lobhit hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀਆਂ ਮੋਹਿਤ ਹੁੰਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "त्रीअ लोभित हैं ॥",
      "sourceLineId": "99425",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦ੍ਰਿਗ ਛਾਜਤ ਹੈਂ ॥",
      "transliteration": "dhirag chhaajat hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਖਾ ਸ਼ੋਭ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "दृग छाजत हैं ॥",
      "sourceLineId": "99426",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮ੍ਰਿਗ ਲਾਜਤ ਹੈਂ ॥੩੪੯॥",
      "transliteration": "mirag laajat hai(n) ||349||",
      "translation": "He is the allurer of women and most beautiful, seeing his charming eyes, the deer are getting shy.349.",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨੂੰ ਵੇਖ ਕੇ) ਹਿਰਨ ਸ਼ਰਮਿੰਦੇ ਹੁੰਦੇ ਹਨ ॥੩੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "मृग लाजत हैं ॥३४९॥",
      "sourceLineId": "99427",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਹਰਣੀ ਪਤਿ ਸੇ ॥",
      "transliteration": "haranee pat se ||",
      "translation": "",
      "punjabiViakhya": "ਹਿਰਨੀ ਦੇ ਪਤੀ (ਹੀਰੇ ਹਿਰਨ) ਵਰਗੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "हरणी पति से ॥",
      "sourceLineId": "99428",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਲਣੀ ਧਰ ਸੇ ॥",
      "transliteration": "nalanee dhar se ||",
      "translation": "",
      "punjabiViakhya": "ਕੰਵਲ ਦੇ ਫੁਲ ਨੂੰ ਧਾਰਨ ਕਰਨ ਵਾਲੇ (ਸਰੋਵਰ ਵਰਗੇ ਗੰਭੀਰ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "नलणी धर से ॥",
      "sourceLineId": "99429",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਰੁਨਾਬੁਦ ਹੈਂ ॥",
      "transliteration": "karunaabudh hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਰੁਣਾ ਦਾ ਸਮੁੰਦਰ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "करुनाबुद हैं ॥",
      "sourceLineId": "99430",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੁ ਪ੍ਰਭਾ ਧਰ ਹੈਂ ॥੩੫੦॥",
      "transliteration": "s prabhaa dhar hai(n) ||350||",
      "translation": "His eyes are like the deer’s eyes and lotus, He is full of Mercy and Glory.350.",
      "punjabiViakhya": "ਸੁੰਦਰ ਪ੍ਰਭਾ ਨੂੰ ਧਾਰਨ ਕਰਨ ਵਾਲੇ ਹਨ ॥੩੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "सु प्रभा धर हैं ॥३५०॥",
      "sourceLineId": "99431",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਲਿ ਕਾਰਣ ਹੈ ॥",
      "transliteration": "kal kaaran hai ||",
      "translation": "",
      "punjabiViakhya": "ਕਲਿਯੁਗ ਦੇ ਕਾਰਨ ਸਰੂਪ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "कलि कारण है ॥",
      "sourceLineId": "99432",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਵ ਉਧਾਰਣ ਹੈ ॥",
      "transliteration": "bhav udhaaran hai ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਸਾਰ ਦਾ ਪਾਰ ਉਤਾਰਾ ਕਰਨ ਵਾਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "भव उधारण है ॥",
      "sourceLineId": "99433",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਛਬਿ ਛਾਜਤ ਹੈ ॥",
      "transliteration": "chhab chhaajat hai ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਸ਼ੋਭਿਤ ਛਬੀ ਵਾਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "छबि छाजत है ॥",
      "sourceLineId": "99434",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੁਰ ਲਾਜਤ ਹੈ ॥੩੫੧॥",
      "transliteration": "sur laajat hai ||351||",
      "translation": "He is the cause of the Iron Age and the redeemer of the world, He is Beauty-incarnate and even the gods become shy on seeing Him.351.",
      "punjabiViakhya": "ਦੇਵਤੇ (ਛਬੀ ਨੂੰ ਵੇਖ ਕੇ) ਸ਼ਰਮਿੰਦੇ ਹੁੰਦੇ ਹਨ ॥੩੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "सुर लाजत है ॥३५१॥",
      "sourceLineId": "99435",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਸਯੁਪਾਸਕ ਹੈ ॥",
      "transliteration": "asayupaasak hai ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰ ਦੇ ਉਪਾਸ਼ਕ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "असयुपासक है ॥",
      "sourceLineId": "99436",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਰਿ ਨਾਸਕ ਹੈ ॥",
      "transliteration": "ar naasak hai ||",
      "translation": "",
      "punjabiViakhya": "ਵੈਰੀ ਦੇ ਨਾਸ਼ਕ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "अरि नासक है ॥",
      "sourceLineId": "99437",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਰਿ ਘਾਇਕ ਹੈ ॥",
      "transliteration": "ar ghaik hai ||",
      "translation": "",
      "punjabiViakhya": "ਵੈਰੀ ਨੂੰ ਘਾਇਲ ਕਰਨ ਵਾਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "अरि घाइक है ॥",
      "sourceLineId": "99438",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੁਖਦਾਇਕ ਹੈ ॥੩੫੨॥",
      "transliteration": "sukhadhaik hai ||352||",
      "translation": "Heis the worshipper of the sword and the Destroyer of the enemy, He is the giver of happiness and killer of the enemy.352.",
      "punjabiViakhya": "ਸੁਖ ਦੇਣ ਵਾਲੇ ਹਨ ॥੩੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "सुखदाइक है ॥३५२॥",
      "sourceLineId": "99439",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਲਜੇਛਣ ਹੈ ॥",
      "transliteration": "jalajechhan hai ||",
      "translation": "",
      "punjabiViakhya": "ਕਮਲ ਫੁਲ ਵਰਗੀਆਂ ਅੱਖਾ ਵਾਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "जलजेछण है ॥",
      "sourceLineId": "99440",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪ੍ਰਣ ਪੇਛਣ ਹੈ ॥",
      "transliteration": "pran pechhan hai ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਣ ਨੂੰ ਪੂਰਾ ਕਰਨ ਵਾਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "प्रण पेछण है ॥",
      "sourceLineId": "99441",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਰਿ ਮਰਦਨ ਹੈ ॥",
      "transliteration": "ar maradhan hai ||",
      "translation": "",
      "punjabiViakhya": "ਵੈਰੀ ਨੂੰ ਮਿਧਣ ਵਾਲੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "अरि मरदन है ॥",
      "sourceLineId": "99442",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮ੍ਰਿਤ ਕਰਦਨ ਹੈ ॥੩੫੩॥",
      "transliteration": "mirat karadhan hai ||353||",
      "translation": "He is the Yaksha of water and the fulfiller of the promise, He is the Destroyer of the enemy and the masher of his pride.353.",
      "punjabiViakhya": "ਅਤੇ ਮੁਰਦਾ ਕਰ ਦੇਣ ਵਾਲੇ ਹਨ ॥੩੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "मृत करदन है ॥३५३॥",
      "sourceLineId": "99443",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਧਰਣੀਧਰ ਹੈ ॥",
      "transliteration": "dharaneedhar hai ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ ਨੂੰ ਧਾਰਨ ਕਰਨ ਵਾਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "धरणीधर है ॥",
      "sourceLineId": "99444",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਰਣੀਕਰ ਹੈ ॥",
      "transliteration": "karaneekar hai ||",
      "translation": "",
      "punjabiViakhya": "ਕਰਣੀ ਦੇ ਕਰਨ ਵਾਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "करणीकर है ॥",
      "sourceLineId": "99445",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਧਨੁ ਕਰਖਨ ਹੈ ॥",
      "transliteration": "dhan karakhan hai ||",
      "translation": "",
      "punjabiViakhya": "ਧਨੁਸ਼ ਨੂੰ ਖਿਚਣ ਵਾਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 586,
      "hindi": "",
      "hindiTransliteration": "धनु करखन है ॥",
      "sourceLineId": "99446",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0586_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਰ ਬਰਖਣ ਹੈ ॥੩੫੪॥",
      "transliteration": "sar barakhan hai ||354||",
      "translation": "He is the creator and support of the earth and by pulling His bow, He showers the arrows.354.",
