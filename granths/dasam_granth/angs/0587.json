{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 587,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0587_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਸਿ ਸੋਭ ਹਰੇ ॥੩੫੯॥",
      "transliteration": "sas sobh hare ||359||",
      "translation": "He is of such Captivating Beauty as if He is the god of love, His Brightness defeats the moon’s glory.359.",
      "punjabiViakhya": "ਚੰਦ੍ਰਮਾ ਦੀ ਸ਼ੋਭਾ ਨੂੰ ਹਰ ਰਿਹਾ ਹੈ ॥੩੫੯॥",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "ससि सोभ हरे ॥३५९॥",
      "sourceLineId": "99467",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਸ੍ਰਯ ਉਪਾਸਿਕ ਹੈਂ ॥",
      "transliteration": "asray upaasik hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰ ਦਾ ਉਪਾਸਕ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "अस्रय उपासिक हैं ॥",
      "sourceLineId": "99468",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਰਿ ਨਾਸਿਕ ਹੈਂ ॥",
      "transliteration": "ar naasik hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵੈਰੀਆਂ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "अरि नासिक हैं ॥",
      "sourceLineId": "99469",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਰ ਦਾਇਕ ਹੈਂ ॥",
      "transliteration": "bar dhaik hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵਰ ਦੇਣ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "बर दाइक हैं ॥",
      "sourceLineId": "99470",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪ੍ਰਭ ਪਾਇਕ ਹੈਂ ॥੩੬੦॥",
      "transliteration": "prabh paik hai(n) ||360||",
      "translation": "He is the worshipper of the sword and the Destroyer of the enemy, He is the Lord bestower of the boon.360.",
      "punjabiViakhya": "ਪ੍ਰਭੂ ਦਾ ਦੂਤ (ਅਥਵਾ ਸੇਵਕ ਹੈ) ॥੩੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "प्रभ पाइक हैं ॥३६०॥",
      "sourceLineId": "99471",
      "sourceShabadId": "9236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੰਗੀਤ ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "sa(n)geet bhuja(n)g prayaat chha(n)dh ||",
      "translation": "SANGEET BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਸੰਗੀਤ ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "संगीत भुजंग प्रयात छंद ॥",
      "sourceLineId": "99472",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਾਗੜਦੰ ਬੀਰੰ ਜਾਗੜਦੰ ਜੂਟੇ ॥",
      "transliteration": "baagaRadha(n) beera(n) jaagaRadha(n) jooTe ||",
      "translation": "",
      "punjabiViakhya": "ਬਹਾਦਰ ਯੋਧੇ (ਬਲ ਪੂਰਵਕ ਯੁੱਧ ਵਿਚ) ਜੁਟੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "बागड़दं बीरं जागड़दं जूटे ॥",
      "sourceLineId": "99473",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਾਗੜਦੰ ਤੀਰੰ ਛਾਗੜਦੰ ਛੂਟੇ ॥",
      "transliteration": "taagaRadha(n) teera(n) chhaagaRadha(n) chhooTe ||",
      "translation": "",
      "punjabiViakhya": "ਤਾੜ ਤਾੜ ਤੀਰ ਚਲਦੇ ਹਨ, ਛੜ ਛੜ ਕਰਦੇ ਛੁਟੀ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "तागड़दं तीरं छागड़दं छूटे ॥",
      "sourceLineId": "99474",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਾਗੜਦੰ ਸੁਆਰੰ ਜਾਗੜਦੰ ਜੂਝੇ ॥",
      "transliteration": "saagaRadha(n) suaara(n) jaagaRadha(n) joojhe ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਆਰ (ਆਪਸ ਵਿਚ) ਜੂਝੀ ਜਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "सागड़दं सुआरं जागड़दं जूझे ॥",
      "sourceLineId": "99475",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਾਗੜਦੰ ਕੋਪੇ ਰਾਗੜਦੰ ਰੁਝੈ ॥੩੬੧॥",
      "transliteration": "kaagaRadha(n) kope raagaRadha(n) rujhai ||361||",
      "translation": "The warriors are fighting in the war and the arrows are being discharged, the horse-riders are fighting in the battlefield and in their fury, they are absorbed in fighting.361.",
      "punjabiViakhya": "ਬਹੁਤ ਕ੍ਰੋਧ ਨਾਲ (ਯੁੱਧ ਕਰਮ ਵਿਚ) ਰੁਝੇ ਹੋਏ ਹਨ ॥੩੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "कागड़दं कोपे रागड़दं रुझै ॥३६१॥",
      "sourceLineId": "99476",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਾਗੜਦੰ ਮਾਚਿਓ ਜਾਗੜਦੰ ਜੁਧੰ ॥",
      "transliteration": "maagaRadha(n) maachio jaagaRadha(n) judha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਬਹੁਤ ਭਾਰਾ) ਯੁੱਧ ਮਚ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "मागड़दं माचिओ जागड़दं जुधं ॥",
      "sourceLineId": "99477",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਾਗੜਦੰ ਜੋਧਾ ਕਾਗੜਦੰ ਕ੍ਰੁੰਧੰ ॥",
      "transliteration": "jaagaRadha(n) jodhaa kaagaRadha(n) kru(n)dha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧੇ ਕ੍ਰੋਧਵਾਨ ਹੋ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "जागड़दं जोधा कागड़दं क्रुँधं ॥",
      "sourceLineId": "99478",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਾਗੜਦੰ ਸਾਗੰ ਡਾਗੜਦੰ ਡਾਰੇ ॥",
      "transliteration": "saagaRadha(n) saaga(n) ddaagaRadha(n) ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਗਾ (ਬਰਛੀਆਂ) (ਇਕ ਦੂਜੇ ਉਤੇ) ਸੁਟਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "सागड़दं सागं डागड़दं डारे ॥",
      "sourceLineId": "99479",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਾਗੜਦੰ ਬੀਰੰ ਆਗੜਦੰ ਉਤਾਰੇ ॥੩੬੨॥",
      "transliteration": "baagaRadha(n) beera(n) aagaRadha(n) utaare ||362||",
      "translation": "The dreadful fighting continues and the warriors have got enraged, the warriors are striking their lances and are dismounting the fighters from their horses.362.",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਨੂੰ (ਧਰਤੀ ਉਤੇ) ਵਿਛਾ ਦਿੱਤਾ ਹੈ ॥੩੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "बागड़दं बीरं आगड़दं उतारे ॥३६२॥",
      "sourceLineId": "99480",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਾਗੜਦੰ ਤੈ ਕੈ ਜਾਗੜਦੰ ਜੁਆਣੰ ॥",
      "transliteration": "taagaRadha(n) tai kai jaagaRadha(n) juaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੁਆਨ ਸੂਰਮੇ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "तागड़दं तै कै जागड़दं जुआणं ॥",
      "sourceLineId": "99481",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਛਾਗੜਦੰ ਛੋਰੈ ਬਾਗੜਦੰ ਬਾਣੰ ॥",
      "transliteration": "chhaagaRadha(n) chhorai baagaRadha(n) baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ ਛਡਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "छागड़दं छोरै बागड़दं बाणं ॥",
      "sourceLineId": "99482",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਾਗੜਦੰ ਜੂਝੇ ਬਾਗੜਦੰ ਬਾਜੀ ॥",
      "transliteration": "jaagaRadha(n) joojhe baagaRadha(n) baajee ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨਾਲ) ਘੋੜੇ ਜੂਝਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "जागड़दं जूझे बागड़दं बाजी ॥",
      "sourceLineId": "99483",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਡਾਗੜਦੰ ਡੋਲੈ ਤਾਗੜਦੰ ਤਾਜੀ ॥੩੬੩॥",
      "transliteration": "ddaagaRadha(n) ddolai taagaRadha(n) taajee ||363||",
      "translation": "The soldiers have discharged the arrows and the horses have been killed and the fast-moving horses jumped and ran away.363.",
      "punjabiViakhya": "ਅਤੇ (ਕਈ) ਘੋੜੇ (ਇਧਰ ਉਧਰ) ਡੋਲਦੇ ਫਿਰਦੇ ਹਨ ॥੩੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "डागड़दं डोलै तागड़दं ताजी ॥३६३॥",
      "sourceLineId": "99484",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਖਾਗੜਦੰ ਖੂਨੀ ਖਯਾਗੜਦੰ ਖੇਤੰ ॥",
      "transliteration": "khaagaRadha(n) khoonee khayaagaRadha(n) kheta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਖੂਨੀ (ਖੰਡੇ) ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਖੜਕਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "खागड़दं खूनी खयागड़दं खेतं ॥",
      "sourceLineId": "99485",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਝਾਗੜਦੰ ਝੂਝੇ ਆਗੜਦੰ ਅਚੇਤੰ ॥",
      "transliteration": "jhaagaRadha(n) jhoojhe aagaRadha(n) acheta(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈ ਯੋਧੇ) ਜੂਝ ਕੇ ਅਚੇਤ ਹੋ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "झागड़दं झूझे आगड़दं अचेतं ॥",
      "sourceLineId": "99486",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਆਗੜਦੰ ਉਠੇ ਕਾਗੜਦੰ ਕੋਪੇ ॥",
      "transliteration": "aagaRadha(n) uThe kaagaRadha(n) kope ||",
      "translation": "",
      "punjabiViakhya": "(ਸਚੇਤ ਹੋ ਕੇ) ਉਠਦੇ ਹਨ ਅਤੇ ਕ੍ਰੋਧ ਕਰਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "आगड़दं उठे कागड़दं कोपे ॥",
      "sourceLineId": "99487",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਡਾਗੜਦੰ ਡਾਰੇ ਧਾਗੜਦੰ ਧੋਪੇ ॥੩੬੪॥",
      "transliteration": "ddaagaRadha(n) ddaare dhaagaRadha(n) dhope ||364||",
      "translation": "The battlefield was saturated with blood and the warriors became unconscious during their fight, the fighters arise, get enraged and strike blows in great excitement.364.",
      "punjabiViakhya": "(ਵੈਰੀ ਉਤੇ) ਲੰਬੀਆਂ ਤਲਵਾਰਾ ਸੁਟਦੇ ਹਨ ॥੩੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "डागड़दं डारे धागड़दं धोपे ॥३६४॥",
      "sourceLineId": "99488",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਾਗੜਦੰ ਨਾਚੇ ਰਾਗੜਦੰ ਰੁਦ੍ਰੰ ॥",
      "transliteration": "naagaRadha(n) naache raagaRadha(n) rudhra(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰੁਦ੍ਰ (ਰਣ-ਭੂਮੀ ਵਿਚ) ਨਚ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "नागड़दं नाचे रागड़दं रुद्रं ॥",
      "sourceLineId": "99489",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭਾਗੜਦੰ ਭਾਜੇ ਛਾਗੜਦੰ ਛੁਦ੍ਰੰ ॥",
      "transliteration": "bhaagaRadha(n) bhaaje chhaagaRadha(n) chhudhra(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਇਰ ਭਜ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "भागड़दं भाजे छागड़दं छुद्रं ॥",
      "sourceLineId": "99490",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਾਗੜਦੰ ਜੁਝੇ ਵਾਗੜਦੰ ਵੀਰੰ ॥",
      "transliteration": "jaagaRadha(n) jujhe vaagaRadha(n) veera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧੇ (ਜੰਗ ਵਿਚ) ਮਾਰੇ ਗਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "जागड़दं जुझे वागड़दं वीरं ॥",
      "sourceLineId": "99491",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਲਾਗੜਦੰ ਲਾਗੇ ਤਾਗੜਦੰ ਤੀਰੰ ॥੩੬੫॥",
      "transliteration": "laagaRadha(n) laage taagaRadha(n) teera(n) ||365||",
      "translation": "Shiva is dancing and the cowards are running away, the warriors are fighting and are being struck by the arrows.365.",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨੂੰ) ਤੀਰ ਲਗੇ ਹਨ ॥੩੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "लागड़दं लागे तागड़दं तीरं ॥३६५॥",
      "sourceLineId": "99492",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰਾਗੜਦੰ ਰੁਝੇ ਸਾਗੜਦੰ ਸੂਰੰ ॥",
      "transliteration": "raagaRadha(n) rujhe saagaRadha(n) soora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ (ਯੁੱਧ ਕਰਮ ਵਿਚ) ਰੁਝੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "रागड़दं रुझे सागड़दं सूरं ॥",
      "sourceLineId": "99493",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਘਾਗੜਦੰ ਘੁਮੀ ਹਾਗੜਦੰ ਹੂਰੰ ॥",
      "transliteration": "ghaagaRadha(n) ghumee haagaRadha(n) hoora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੂਰਾ ਘੁੰਮ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "घागड़दं घुमी हागड़दं हूरं ॥",
      "sourceLineId": "99494",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਾਗੜਦੰ ਤਕੈ ਜਾਗੜਦੰ ਜੁਆਨੰ ॥",
      "transliteration": "taagaRadha(n) takai jaagaRadha(n) juaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੁਆਨਾ ਨੂੰ ਤਕਦੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "तागड़दं तकै जागड़दं जुआनं ॥",
      "sourceLineId": "99495",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਾਗੜਦੰ ਮੋਹੀ ਤਾਗੜਦੰ ਤਾਨੰ ॥੩੬੬॥",
      "transliteration": "maagaRadha(n) mohee taagaRadha(n) taana(n) ||366||",
      "translation": "The warriors are absorbed in fighting and the heavenly damsels are moving for wedding them, the warriors are looking at them and they are also fascinated by them.366.",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਉਤੇ ('ਤਾਨੰ') ਮੋਹੀਆਂ ਗਈਆਂ ਹਨ ॥੩੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "मागड़दं मोही तागड़दं तानं ॥३६६॥",
      "sourceLineId": "99496",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦਾਗੜਦੰ ਦੇਖੈ ਰਾਗੜਦੰ ਰੂਪੰ ॥",
      "transliteration": "dhaagaRadha(n) dhekhai raagaRadha(n) roopa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ) ਰੂਪ ਨੂੰ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "दागड़दं देखै रागड़दं रूपं ॥",
      "sourceLineId": "99497",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪਾਗੜਦੰ ਪ੍ਰੇਮੰ ਕਾਗੜਦੰ ਕੂਪੰ ॥",
      "transliteration": "paagaRadha(n) prema(n) kaagaRadha(n) koopa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰੇਮ ਦੇ ਖੂਹ ਵਿਚ (ਡੁਬ ਗਈਆਂ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "पागड़दं प्रेमं कागड़दं कूपं ॥",
      "sourceLineId": "99498",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਡਾਗੜਦੰ ਡੁਬੀ ਪਾਗੜਦੰ ਪਿਆਰੀ ॥",
      "transliteration": "ddaagaRadha(n) ddubee paagaRadha(n) piaaree ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਆਰੀਆਂ ਹੂਰਾ (ਪ੍ਰੇਮ ਵਿਚ) ਡੁਬ ਗਈਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "डागड़दं डुबी पागड़दं पिआरी ॥",
      "sourceLineId": "99499",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਾਗੜਦੰ ਕਾਮੰ ਮਾਗੜਦੰ ਮਾਰੀ ॥੩੬੭॥",
      "transliteration": "kaagaRadha(n) kaama(n) maagaRadha(n) maaree ||367||",
      "translation": "Their beauty allures the lovers like falling in the well, wherefrom they can never come out, these heavenly damsels have also drowned themselves in the sexual love of the beautiful warriors.367.",
      "punjabiViakhya": "ਅਤੇ ਕਾਮ (ਦੇ ਤੀਰ ਨਾਲ) ਮਾਰੀਆਂ ਗਈਆਂ ਹਨ ॥੩੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "कागड़दं कामं मागड़दं मारी ॥३६७॥",
      "sourceLineId": "99500",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਾਗੜਦੰ ਮੋਹੀ ਬਾਗੜਦੰ ਬਾਲਾ ॥",
      "transliteration": "maagaRadha(n) mohee baagaRadha(n) baalaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਪੱਛਰਾਵਾ ('ਬਾਲਾ')",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "मागड़दं मोही बागड़दं बाला ॥",
      "sourceLineId": "99501",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰਾਗੜਦੰ ਰੂਪੰ ਆਗੜਦੰ ਉਜਾਲਾ ॥",
      "transliteration": "raagaRadha(n) roopa(n) aagaRadha(n) ujaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਦੇ ਉਜਲੇ ਰੂਪ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "रागड़दं रूपं आगड़दं उजाला ॥",
      "sourceLineId": "99502",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦਾਗੜਦੰ ਦੇਖੈ ਸਾਗੜਦੰ ਸੂਰੰ ॥",
      "transliteration": "dhaagaRadha(n) dhekhai saagaRadha(n) soora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵੇਖ ਕੇ ਮੋਹੀਆਂ (ਗਈਆਂ ਹਨ)",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "दागड़दं देखै सागड़दं सूरं ॥",
      "sourceLineId": "99503",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਾਗੜਦੰ ਬਾਜੇ ਤਾਗੜਦੰ ਤੂਰੰ ॥੩੬੮॥",
      "transliteration": "baagaRadha(n) baaje taagaRadha(n) toora(n) ||368||",
      "translation": "The women are getting allured and there is brightness of their elegance, the warriors seeing them are playing on various kinds of musical instruments.368.",
      "punjabiViakhya": "ਅਤੇ ਵਾਜੇ ਵਜਦੇ ਹਨ ॥੩੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "बागड़दं बाजे तागड़दं तूरं ॥३६८॥",
      "sourceLineId": "99504",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਾਗੜਦੰ ਰੂਪੰ ਕਾਗੜਦੰ ਕਾਮੰ ॥",
      "transliteration": "raagaRadha(n) roopa(n) kaagaRadha(n) kaama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਰੂਪ ਵਾਲੀਆਂ ਇਸਤਰੀਆਂ ਕਾਮ ਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "रागड़दं रूपं कागड़दं कामं ॥",
      "sourceLineId": "99505",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਾਗੜਦੰ ਨਾਚੈ ਬਾਗੜਦੰ ਬਾਮੰ ॥",
      "transliteration": "naagaRadha(n) naachai baagaRadha(n) baama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵਸ ਵਿਚ ਹੋ ਕੇ ਨਚ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "नागड़दं नाचै बागड़दं बामं ॥",
      "sourceLineId": "99506",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰਾਗੜਦੰ ਰੀਝੇ ਸਾਗੜਦੰ ਸੂਰੰ ॥",
      "transliteration": "raagaRadha(n) reejhe saagaRadha(n) soora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਉਤੇ ਰੀਝ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "रागड़दं रीझे सागड़दं सूरं ॥",
      "sourceLineId": "99507",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਾਗੜਦੰ ਬਿਆਹੈ ਹਾਗੜਦੰ ਹੂਰੰ ॥੩੬੯॥",
      "transliteration": "baagaRadha(n) biaahai haagaRadha(n) hoora(n) ||369||",
      "translation": "The women, full of beauty and lust are dancing and the warriors, getting pleased are wedding them.369.",
      "punjabiViakhya": "ਹੂਰਾ ਉਨ੍ਰਹਾ ਨਾਲ ਵਿਆਹ ਕਰ ਰਹੀਆਂ ਹਨ ॥੩੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "बागड़दं बिआहै हागड़दं हूरं ॥३६९॥",
      "sourceLineId": "99508",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਾਗੜਦੰ ਕੋਪਾ ਭਾਗੜਦੰ ਭੂਪੰ ॥",
      "transliteration": "kaagaRadha(n) kopaa bhaagaRadha(n) bhoopa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੰਭਲ ਦਾ) ਰਾਜਾ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "कागड़दं कोपा भागड़दं भूपं ॥",
      "sourceLineId": "99509",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਾਗੜਦੰ ਕਾਲੰ ਰਾਗੜਦੰ ਰੂਪੰ ॥",
      "transliteration": "kaagaRadha(n) kaala(n) raagaRadha(n) roopa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਦਾ ਰੂਪ ਹੋ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "कागड़दं कालं रागड़दं रूपं ॥",
      "sourceLineId": "99510",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰਾਗੜਦੰ ਰੋਸੰ ਧਾਗੜਦੰ ਧਾਯੋ ॥",
      "transliteration": "raagaRadha(n) rosa(n) dhaagaRadha(n) dhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਨਾਲ ਉਹ ਧਾਵਾ ਕਰਕੇ ਪੈ ਗਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "रागड़दं रोसं धागड़दं धायो ॥",
      "sourceLineId": "99511",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚਾਗੜਦੰ ਚਲ੍ਯੋ ਆਗੜਦੰ ਆਯੋ ॥੩੭੦॥",
      "transliteration": "chaagaRadha(n) chalayo aagaRadha(n) aayo ||370||",
      "translation": "The king, getting infuriated, manifested himself as KAL (death) and in his anger, quickly advanced forward.370.",
      "punjabiViakhya": "ਅਤੇ ਅਗੇ ਵਧ ਕੇ ਆ ਗਿਆ ਹੈ ॥੩੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "चागड़दं चल्यो आगड़दं आयो ॥३७०॥",
      "sourceLineId": "99512",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਆਗੜਦੰ ਅਰੜੇ ਗਾਗੜਦੰ ਗਾਜੀ ॥",
      "transliteration": "aagaRadha(n) araRe gaagaRadha(n) gaajee ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਅਰੜਾ ਕੇ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "आगड़दं अरड़े गागड़दं गाजी ॥",
      "sourceLineId": "99513",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0587_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਾਗੜਦੰ ਨਾਚੇ ਤਾਗੜਦੰ ਤਾਜੀ ॥",
      "transliteration": "naagaRadha(n) naache taagaRadha(n) taajee ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜੇ (ਰਣ-ਭੂਮੀ ਵਿਚ) ਨਚ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 587,
      "hindi": "",
      "hindiTransliteration": "नागड़दं नाचे तागड़दं ताजी ॥",
      "sourceLineId": "99514",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
