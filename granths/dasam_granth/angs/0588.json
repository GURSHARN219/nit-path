{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 588,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0588_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਾਗੜਦੰ ਜੁਝੇ ਖਾਗੜਦੰ ਖੇਤੰ ॥",
      "transliteration": "jaagaRadha(n) jujhe khaagaRadha(n) kheta(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਯੋਧੇ) ਜੰਗ ਵਿਚ ਜੂਝ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "जागड़दं जुझे खागड़दं खेतं ॥",
      "sourceLineId": "99515",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਾਗੜਦੰ ਰਹਸੇ ਪਾਗੜਦੰ ਪ੍ਰੇਤੰ ॥੩੭੧॥",
      "transliteration": "raagaRadha(n) rahase paagaRadha(n) preta(n) ||371||",
      "translation": "The warriors shouted, the horses danced, the fighters died and the ghosts etc. became pleased.371.",
      "punjabiViakhya": "ਭੂਤ-ਪ੍ਰੇਤ ਪ੍ਰਸੰਨ ਹੋ ਰਹੇ ਹਨ ॥੩੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "रागड़दं रहसे पागड़दं प्रेतं ॥३७१॥",
      "sourceLineId": "99516",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਾਗੜਦੰ ਮਾਰੇ ਬਾਗੜਦੰ ਬੀਰੰ ॥",
      "transliteration": "maagaRadha(n) maare baagaRadha(n) beera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਬੀਰ ਮਾਰੇ ਜਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "मागड़दं मारे बागड़दं बीरं ॥",
      "sourceLineId": "99517",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਾਗੜਦੰ ਪਰਾਨੇ ਭਾਗੜਦੰ ਭੀਰੰ ॥",
      "transliteration": "paagaRadha(n) paraane bhaagaRadha(n) bheera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਡਰਪੋਕ ਲੋਕ ਭਜੀ ਜਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "पागड़दं पराने भागड़दं भीरं ॥",
      "sourceLineId": "99518",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਧਾਗੜਦੰ ਧਾਯੋ ਰਾਗੜਦੰ ਰਾਜਾ ॥",
      "transliteration": "dhaagaRadha(n) dhaayo raagaRadha(n) raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਧਾਵਾ ਕਰਕੇ ਪਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "धागड़दं धायो रागड़दं राजा ॥",
      "sourceLineId": "99519",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਾਗੜਦੰ ਰਣਕੇ ਬਾਗੜਦੰ ਬਾਜਾ ॥੩੭੨॥",
      "transliteration": "raagaRadha(n) ranake baagaRadha(n) baajaa ||372||",
      "translation": "The warriors were being killed and the cowards began to run away, the king also fell upon the opponents and the musical instruments of war were played.372.",
      "punjabiViakhya": "(ਰਣ ਦਾ ਮਾਰੂ) ਵਾਜਾ ਵਜਿਆ ਹੈ ॥੩੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "रागड़दं रणके बागड़दं बाजा ॥३७२॥",
      "sourceLineId": "99520",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਟਾਗੜਦੰ ਟੂਟੇ ਤਾਗੜਦੰ ਤਾਲੰ ॥",
      "transliteration": "TaagaRadha(n) TooTe taagaRadha(n) taala(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਹੂਰਾ ਦੇ ਨੱਚਣ ਵੇਲੇ) ਤਾਲ ਟੁਟ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "टागड़दं टूटे तागड़दं तालं ॥",
      "sourceLineId": "99521",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਆਗੜਦੰ ਉਠੇ ਜਾਗੜਦੰ ਜੁਆਲੰ ॥",
      "transliteration": "aagaRadha(n) uThe jaagaRadha(n) juaala(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਬੰਦੂਕਾ ਵਿਚੋਂ) ਅੱਗ ਨਿਕਲਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "आगड़दं उठे जागड़दं जुआलं ॥",
      "sourceLineId": "99522",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭਾਗੜਦੰ ਭਾਜੇ ਬਾਗੜਦੰ ਬੀਰੰ ॥",
      "transliteration": "bhaagaRadha(n) bhaaje baagaRadha(n) beera(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨੂੰ) ਤੀਰ ਲਗੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "भागड़दं भाजे बागड़दं बीरं ॥",
      "sourceLineId": "99523",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਲਾਗੜਦੰ ਲਾਗੇ ਤਾਗੜਦੰ ਤੀਰੰ ॥੩੭੩॥",
      "transliteration": "laagaRadha(n) laage taagaRadha(n) teera(n) ||373||",
      "translation": "The swords were broken and fires blazed, with the infliction of arrows the warriors ran hither and thither.373.",
      "punjabiViakhya": "ਉਹ ਸੂਰਮੇ (ਯੁੱਧ-ਭੂਮੀ ਵਿਚੋਂ) ਭਜਦੇ ਜਾ ਰਹੇ ਹਨ ॥੩੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "लागड़दं लागे तागड़दं तीरं ॥३७३॥",
      "sourceLineId": "99524",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਾਗੜਦੰ ਰਹਸੀ ਦਾਗੜਦੰ ਦੇਵੀ ॥",
      "transliteration": "raagaRadha(n) rahasee dhaagaRadha(n) dhevee ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵੀ ਖੁਸ਼ ਹੋ ਰਹੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "रागड़दं रहसी दागड़दं देवी ॥",
      "sourceLineId": "99525",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗਾਗੜਦੰ ਗੈਣ ਆਗੜਦੰ ਭੇਵੀ ॥",
      "transliteration": "gaagaRadha(n) gain aagaRadha(n) bhevee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਕਾਸ਼ ਵਿਚ ਵਿਚਰ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "गागड़दं गैण आगड़दं भेवी ॥",
      "sourceLineId": "99526",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭਾਗੜਦੰ ਭੈਰੰ ਭਾਗੜਦੰ ਪ੍ਰੇਤੰ ॥",
      "transliteration": "bhaagaRadha(n) bhaira(n) bhaagaRadha(n) preta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭੈਰੋ ਅਤੇ ਪ੍ਰੇਤ ਯੁੱਧ-ਭੂਮੀ",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "भागड़दं भैरं भागड़दं प्रेतं ॥",
      "sourceLineId": "99527",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹਾਗੜਦੰ ਹਸੇ ਖਾਗੜਦੰ ਖੇਤੰ ॥੩੭੪॥",
      "transliteration": "haagaRadha(n) hase khaagaRadha(n) kheta(n) ||374||",
      "translation": "Seeing the war, the goddess Kali also pleased in the sky, the Bhairav and ghosts etc. also in the battlefield.374.",
      "punjabiViakhya": "ਵਿਚ ਹਸ ਰਹੇ ਹਨ ॥੩੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "हागड़दं हसे खागड़दं खेतं ॥३७४॥",
      "sourceLineId": "99528",
      "sourceShabadId": "9237",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "99529",
      "sourceShabadId": "9238",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਸਿ ਟੁਟੇ ਲੁਟੇ ਘਨੇ ਤੁਟੇ ਸਸਤ੍ਰ ਅਨੇਕ ॥",
      "transliteration": "as TuTe luTe ghane tuTe sasatr anek ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਟੁੱਟੀਆਂ ਪਈਆਂ ਹਨ, ਬਹੁਤ (ਸੂਰਮੇ) ਲੋਟ ਪੋਟ ਹੋਏ ਪਏ ਹਨ, ਅਨੇਕਾ ਸ਼ਸਤ੍ਰ ਟੁਟੇ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "असि टुटे लुटे घने तुटे ससत्र अनेक ॥",
      "sourceLineId": "99530",
      "sourceShabadId": "9238",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜੇ ਜੁਟੇ ਕੁਟੇ ਸਬੈ ਰਹਿ ਗਯੋ ਭੂਪਤਿ ਏਕ ॥੩੭੫॥",
      "transliteration": "je juTe kuTe sabai reh gayo bhoopat ek ||375||",
      "translation": "The swords broke and many weapons were shattered into bits, those warriors who fought, were chopped and ultimately only the king survived.375.",
      "punjabiViakhya": "ਜੋ (ਸੂਰਮੇ) ਯੁੱਧ ਵਿਚ ਜੁਟੇ ਸਨ, ਸਾਰੇ ਕਟੇ ਗਏ ਹਨ, ਬਸ ਇਕ ਰਾਜਾ ਹੀ ਬਚਿਆ ਹੈ ॥੩੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "जे जुटे कुटे सबै रहि गयो भूपति एक ॥३७५॥",
      "sourceLineId": "99531",
      "sourceShabadId": "9238",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪੰਕਜ ਬਾਟਿਕਾ ਛੰਦ ॥",
      "transliteration": "pa(n)kaj baaTikaa chha(n)dh ||",
      "translation": "PANKAJ VAATIKA STANZA",
      "punjabiViakhya": "ਪੰਕਜ ਬਾਟਿਕਾ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "पंकज बाटिका छंद ॥",
      "sourceLineId": "99532",
      "sourceShabadId": "9239",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੈਨ ਜੁਝਤ ਨ੍ਰਿਪ ਭਯੋ ਅਤਿ ਆਕੁਲ ॥",
      "transliteration": "sain jujhat nirap bhayo at aakul ||",
      "translation": "",
      "punjabiViakhya": "ਸੈਨਾ ਦੇ ਮਾਰੇ ਜਾਣ ਕਾਰਨ ਰਾਜਾ ਬਹੁਤ ਬੇਚੈਨ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "सैन जुझत नृप भयो अति आकुल ॥",
      "sourceLineId": "99533",
      "sourceShabadId": "9239",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਧਾਵਤ ਭਯੋ ਸਾਮੁਹਿ ਅਤਿ ਬਿਆਕੁਲ ॥",
      "transliteration": "dhaavat bhayo saamuh at biaakul ||",
      "translation": "On the destruction of his army, the king extremely agitated went forward and came at the front",
      "punjabiViakhya": "ਬਹੁਤ ਵਿਆਕੁਲ ਹੋ ਕੇ ਧਾਵਾ ਕਰ ਕੇ ਸਾਹਮਣੇ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "धावत भयो सामुहि अति बिआकुल ॥",
      "sourceLineId": "99534",
      "sourceShabadId": "9239",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੰਨਿਧ ਹ੍ਵੈ ਚਿਤ ਮੈ ਅਤਿ ਕ੍ਰੁਧਤ ॥",
      "transliteration": "sa(n)nidh havai chit mai at krudhat ||",
      "translation": "",
      "punjabiViakhya": "ਹਥਿਆਰ-ਬੰਦ ਹੋ ਕੇ ਮਨ ਵਿਚ ਬਹੁਤ ਕ੍ਰੋਧਵਾਨ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "संनिध ह्वै चित मै अति क्रुधत ॥",
      "sourceLineId": "99535",
      "sourceShabadId": "9239",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਆਵਤ ਭਯੋ ਰਿਸ ਕੈ ਕਰਿ ਜੁਧਤ ॥੩੭੬॥",
      "transliteration": "aavat bhayo ris kai kar judhat ||376||",
      "translation": "Getting extremely angry in his mind and moved forward in order to fight.376.",
      "punjabiViakhya": "ਅਤੇ ਗੁੱਸੇ ਨਾਲ (ਭਰਿਆ ਹੋਇਆ) ਯੁੱਧ ਕਰਨ ਲਈ ਆ ਡਟਿਆ ॥੩੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "आवत भयो रिस कै करि जुधत ॥३७६॥",
      "sourceLineId": "99536",
      "sourceShabadId": "9239",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਸਤ੍ਰ ਪ੍ਰਹਾਰ ਅਨੇਕ ਕਰੇ ਤਬ ॥",
      "transliteration": "sasatr prahaar anek kare tab ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਤਦ ਅਨੇਕ ਤਰ੍ਰਹਾ ਦੇ ਸ਼ਸਤ੍ਰਾ ਦੇ ਵਾਰ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 588,
      "hindi": "",
      "hindiTransliteration": "ससत्र प्रहार अनेक करे तब ॥",
      "sourceLineId": "99537",
      "sourceShabadId": "9239",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0588_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜੰਗ ਜੁਟਿਓ ਅਪਨੋ ਦਲ ਲੈ ਸਬ ॥",
      "transliteration": "ja(n)g juTio apano dhal lai sab ||",
      "translation": "Taking his other forces with him, he struck blows in many ways",
