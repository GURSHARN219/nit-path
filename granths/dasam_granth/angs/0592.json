{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 592,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0592_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੇਖਤ ਹੈ ਦਿਵ ਦੇਵ ਧਨੈ ਧਨਿ ਜੰਪਤ ਹੈ ॥",
      "transliteration": "dhekhat hai dhiv dhev dhanai dhan ja(n)pat hai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਯੁੱਧ ਨੂੰ) ਪ੍ਰਕਾਸ਼ ('ਦਿਵ') ਰੂਪ ਦੇਵਤੇ ਵੇਖਦੇ ਹਨ ਅਤੇ ਧੰਨ ਧੰਨ ਜਪਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 592,
      "hindi": "",
      "hindiTransliteration": "देखत है दिव देव धनै धनि जंपत है ॥",
      "sourceLineId": "99659",
      "sourceShabadId": "9245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0592_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਭੂਮ ਅਕਾਸ ਪਤਾਲ ਚਵੋ ਚਕ ਕੰਪਤ ਹੈ ॥",
      "transliteration": "bhoom akaas pataal chavo chak ka(n)pat hai ||",
      "translation": "The gods and demons both are saying, Bravo!\" Looking at the fighting, the earth, sky, neither-world and all the four direcitions trembling",
      "punjabiViakhya": "(ਤਿੰਨ ਲੋਕ) ਧਰਤੀ, ਆਕਾਸ਼ ਅਤੇ ਪਾਤਾਲ ਅਤੇ ਚਾਰੇ ਚਕ ਕੰਬਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 592,
      "hindi": "",
      "hindiTransliteration": "भूम अकास पताल चवो चक कंपत है ॥",
      "sourceLineId": "99660",
      "sourceShabadId": "9245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0592_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭਾਜਤ ਨਾਹਿਨ ਬੀਰ ਮਹਾ ਰਣਿ ਗਾਜਤ ਹੈ ॥",
      "transliteration": "bhaajat naahin beer mahaa ran gaajat hai ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧੇ ਯੁੱਧ ਵਿਚੋਂ ਭਜਦੇ ਨਹੀਂ ਹਨ, ਸਗੋਂ ਗਜਦੇ ('ਮਾਰੋ-ਮਾਰੋ' ਪੁਕਾਰਦੇ) ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 592,
      "hindi": "",
      "hindiTransliteration": "भाजत नाहिन बीर महा रणि गाजत है ॥",
      "sourceLineId": "99661",
      "sourceShabadId": "9245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0592_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਛ ਭੁਜੰਗਨ ਨਾਰਿ ਲਖੇ ਛਬਿ ਲਾਜਤ ਹੈ ॥੪੦੬॥",
      "transliteration": "jachh bhuja(n)gan naar lakhe chhab laajat hai ||406||",
      "translation": "The warriors are not running away, but are thundering in the war-arena, seeing the glory of those warriors the women of Yakshas and Nagas are getting shy.406.",
      "punjabiViakhya": "ਯਕਸ਼ਾ, ਨਾਗਾ ਦੀਆਂ ਇਸਤਰੀਆਂ ਛਬੀ ਨੂੰ ਵੇਖ ਕੇ ਲਜਾ ਰਹੀਆਂ ਹਨ ॥੪੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 592,
      "hindi": "",
      "hindiTransliteration": "जछ भुजंगन नारि लखे छबि लाजत है ॥४०६॥",
      "sourceLineId": "99662",
      "sourceShabadId": "9245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0592_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਧਾਵਤ ਹੈ ਕਰਿ ਕੋਪ ਮਹਾ ਸੁਰ ਸੂਰ ਤਹਾ ॥",
      "transliteration": "dhaavat hai kar kop mahaa sur soor tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਕਰ ਕੇ ਉੱਚੀ ਸੁਰ ਵਿਚ (ਬੋਲਦੇ) ਸੂਰਮੇ ਉਥੇ ਧਾਵਾ ਕਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 592,
      "hindi": "",
      "hindiTransliteration": "धावत है करि कोप महा सुर सूर तहा ॥",
      "sourceLineId": "99663",
      "sourceShabadId": "9245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0592_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਾਡਤ ਹੈ ਬਿਕਰਾਰ ਭਯੰਕਰ ਜੁਧ ਜਹਾ ॥",
      "transliteration": "maaddat hai bikaraar bhaya(n)kar judh jahaa ||",
      "translation": "The great warriors, getting enraged, have attacked and are waging a dreadful and frightening war",
      "punjabiViakhya": "ਜਿਥੇ ਮਹਾ ਭਿਆਨਕ ਅਤੇ ਡਰਾਵਣਾ ਯੁੱਧ ਮੰਡਿਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 592,
      "hindi": "",
      "hindiTransliteration": "माडत है बिकरार भयंकर जुध जहा ॥",
      "sourceLineId": "99664",
      "sourceShabadId": "9245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0592_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪਾਵਤ ਹੈ ਸੁਰ ਨਾਰਿ ਸੁ ਸਾਮੁਹਿ ਜੁਝਤ ਹੈ ॥",
      "transliteration": "paavat hai sur naar su saamuh jujhat hai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਯੋਧਾ ਸਾਹਮਣੇ ਜੂਝਦਾ ਹੈ, ਉਸ ਨੂੰ ਦੇਵ-ਇਸਤਰੀਆਂ (ਅਪੱਛਰਾਵਾ) ਪ੍ਰਾਪਤ (ਕਰਨ ਲਈ ਦੌੜਦੀਆਂ) ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 592,
      "hindi": "",
      "hindiTransliteration": "पावत है सुर नारि सु सामुहि जुझत है ॥",
      "sourceLineId": "99665",
      "sourceShabadId": "9245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0592_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੇਵ ਅਦੇਵ ਗੰਧ੍ਰਬ ਸਬੈ ਕ੍ਰਿਤ ਸੁਝਤ ਹੈ ॥੪੦੭॥",
      "transliteration": "dhev adhev ga(n)dhrab sabai kirat sujhat hai ||407||",
      "translation": "Embracing martyrdom in the ear, they are meeting the heavenly damsels and this war appears as a great war to all the gods, demons and Yakshas.407.",
      "punjabiViakhya": "ਦੇਵਤੇ, ਦੈਂਤ, ਗੰਧਰਬ (ਆਦਿ) ਸਾਰੇ ਉਸ (ਕਲਕੀ) ਦੀ ਕੀਰਤੀ (ਯਸ਼) ਨੂੰ ਜਾਣ ਜਾਦੇ ਹਨ ॥੪੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 592,
      "hindi": "",
      "hindiTransliteration": "देव अदेव गंध्रब सबै कृत सुझत है ॥४०७॥",
      "sourceLineId": "99666",
      "sourceShabadId": "9245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0592_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਚੰਚਲਾ ਛੰਦ ॥",
      "transliteration": "cha(n)chalaa chha(n)dh ||",
      "translation": "CHANCHALA STANZA",
      "punjabiViakhya": "ਚੰਚਲਾ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 592,
      "hindi": "",
      "hindiTransliteration": "चंचला छंद ॥",
      "sourceLineId": "99667",
      "sourceShabadId": "9246",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0592_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਾਰਬੇ ਕੋ ਤਾਹਿ ਤਾਕਿ ਧਾਏ ਬੀਰ ਸਾਵਧਾਨ ॥",
      "transliteration": "maarabe ko taeh taak dhaae beer saavadhaan ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਮਾਰਨ ਲਈ ਸਾਵਧਾਨੀ ਨਾਲ ਨਿਸ਼ਾਨਾ ਬਣਾ ਕੇ ਸੂਰਵੀਰ ਹਮਲਾ ਕਰ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 592,
      "hindi": "",
      "hindiTransliteration": "मारबे को ताहि ताकि धाए बीर सावधान ॥",
      "sourceLineId": "99668",
      "sourceShabadId": "9246",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0592_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹੋਨ ਲਾਗੇ ਜੁਧ ਕੇ ਜਹਾ ਤਹਾ ਸਬੈ ਬਿਧਾਨ ॥",
      "transliteration": "hon laage judh ke jahaa tahaa sabai bidhaan ||",
      "translation": "In order to kill Kalki, the warriors cautiously marched forward and began to wage war here, there and everywhere",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਯੁੱਧ ਦੇ ਵਿਧਾਨ ਹੋਣ ਲਗੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 592,
      "hindi": "",
      "hindiTransliteration": "होन लागे जुध के जहा तहा सबै बिधान ॥",
      "sourceLineId": "99669",
      "sourceShabadId": "9246",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0592_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭੀਮ ਭਾਤਿ ਧਾਇ ਕੈ ਨਿਸੰਕ ਘਾਇ ਕਰਤ ਆਇ ॥",
      "transliteration": "bheem bhaat dhai kai nisa(n)k ghai karat aai ||",
      "translation": "",
      "punjabiViakhya": "ਭੀਮ ਵਾਗ ਧਾ ਕੇ ਪੈ ਰਹੇ ਹਨ ਅਤੇ ਨਿਸੰਗ ਹੋ ਕੇ ਘਾਉ ਕਰ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 592,
      "hindi": "",
      "hindiTransliteration": "भीम भाति धाइ कै निसंक घाइ करत आइ ॥",
      "sourceLineId": "99670",
      "sourceShabadId": "9246",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0592_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੂਝਿ ਜੂਝ ਕੈ ਮਰੈ ਸੁ ਦੇਵ ਲੋਕਿ ਬਸਤ ਜਾਇ ॥੪੦੮॥",
      "transliteration": "joojh joojh kai marai su dhev lok basat jai ||408||",
      "translation": "The brave warriors like Bhima are fearlessly striking blows and after fighting and embracing martyrdom, they are getting abode in the region of gods.408.",
      "punjabiViakhya": "ਜੋ ਜੂਝ ਜੂਝ ਕੇ ਮਰਦੇ ਹਨ, ਉਹ ਦੇਵ ਲੋਕ ਵਿਚ ਜਾ ਕੇ ਵਸਦੇ ਹਨ ॥੪੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 592,
      "hindi": "",
      "hindiTransliteration": "जूझि जूझ कै मरै सु देव लोकि बसत जाइ ॥४०८॥",
      "sourceLineId": "99671",
      "sourceShabadId": "9246",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0592_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਾਨਿ ਤਾਨਿ ਬਾਨ ਕੋ ਅਜਾਨੁ ਬਾਹ ਧਾਵਹੀ ॥",
      "transliteration": "taan taan baan ko ajaan baeh dhaavahee ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣ ਨੂੰ ਖਿਚ ਖਿਚ ਕੇ ਗੋਡਿਆਂ ਤਕ ਲੰਬੀਆਂ ਬਾਹਵਾ ਵਾਲੇ ਭਜੇ ਫਿਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 592,
      "hindi": "",
      "hindiTransliteration": "तानि तानि बान को अजानु बाह धावही ॥",
      "sourceLineId": "99672",
      "sourceShabadId": "9246",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0592_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜੂਝਿ ਜੂਝ ਕੈ ਮਰੈ ਅਲੋਕ ਲੋਕ ਪਾਵਹੀ ॥",
      "transliteration": "joojh joojh kai marai alok lok paavahee ||",
      "translation": "Pulling their bows and discharging arrows, they are advancing towards the Lord (Kalki) and embracing martyrdom, they are going to the next world",
      "punjabiViakhya": "ਜੋ ਲੜ ਲੜ ਕੇ ਮਰਦੇ ਹਨ, ਉਹ ਅਲੌਕਿਕ ਲੋਕ ਪ੍ਰਾਪਤ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 592,
      "hindi": "",
      "hindiTransliteration": "जूझि जूझ कै मरै अलोक लोक पावही ॥",
      "sourceLineId": "99673",
      "sourceShabadId": "9246",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0592_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰੰਗ ਜੰਗਿ ਅੰਗ ਨੰਗ ਭੰਗ ਅੰਗਿ ਹੋਇ ਪਰਤ ॥",
      "transliteration": "ra(n)g ja(n)g a(n)g na(n)g bha(n)g a(n)g hoi parat ||",
      "translation": "",
      "punjabiViakhya": "ਜੰਗ ਦੇ ਰੰਗ ਵਿਚ ਰੰਗੇ ਹੋਇਆਂ ਦਾ ਜੋ ਕੋਈ ਅੰਗ ਨੰਗਾ ਰਿਹਾ ਹੋਵੇ, ਉਹ ਧਰਤੀ ਉਤੇ ਟੁਟ ਕੇ ਡਿਗ ਪੈਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 592,
      "hindi": "",
      "hindiTransliteration": "रंग जंगि अंग नंग भंग अंगि होइ परत ॥",
      "sourceLineId": "99674",
      "sourceShabadId": "9246",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0592_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਟੂਕਿ ਟੂਕਿ ਹੋਇ ਗਿਰੈ ਸੁ ਦੇਵ ਸੁੰਦ੍ਰੀਨਿ ਬਰਤ ॥੪੦੯॥",
      "transliteration": "Took Took hoi girai su dhev su(n)dhreen barat ||409||",
      "translation": "They are absorbed in fighting and are falling into bits before him, these warriors are falling into bits for the sake of heavenly damsels and are embracing death.409.",
      "punjabiViakhya": "ਟੁਕੜੇ ਟੁਕੜੇ ਹੋ ਕੇ ਡਿਗ ਰਹੇ ਹਨ ਅਤੇ ਉਨ੍ਰਹਾ ਨੂੰ ਦੇਵ-ਇਸਤਰੀਆ ਵਰ ਰਹੀਆਂ ਹਨ ॥੪੦੯॥",
      "source": "DASAM_GRANTH",
      "ang": 592,
      "hindi": "",
      "hindiTransliteration": "टूकि टूकि होइ गिरै सु देव सुँद्रीनि बरत ॥४०९॥",
      "sourceLineId": "99675",
      "sourceShabadId": "9246",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0592_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤ੍ਰਿੜਕਾ ਛੰਦ ॥",
      "transliteration": "tiraRakaa chha(n)dh ||",
      "translation": "TIRIRKA STANZA",
      "punjabiViakhya": "ਤ੍ਰਿੜਕਾ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 592,
      "hindi": "",
      "hindiTransliteration": "तृड़का छंद ॥",
      "sourceLineId": "99676",
      "sourceShabadId": "9247",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0592_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤ੍ਰਿੜਰਿੜ ਤੀਰੰ ॥",
      "transliteration": "tiraRariR teera(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਨੋਟ- ਇਥੇ 'ਤ੍ਰਿੜਰਿੜ' ਆਦਿ ਸ਼ਬਦ ਯੁੱਧ-ਸੰਗੀਤ ਲਈ ਵਰਤੇ ਗਏ ਹਨ। ਉਾਂਜ ਇਹ ਨਿਰਰਥਕ ਜਿਹੇ ਹੈ। ਇਨ੍ਰਹਾ ਦੀ ਵਰਤਨੀ ਵਿਚ ਵੀ ਅਨੇਕ ਅੰਤਰ ਹਨ। ਤੀਰ ਤਿੜ ਤਿੜ ਕਰਦੇ (ਚਲਦੇ ਹਨ)",
      "source": "DASAM_GRANTH",
      "ang": 592,
      "hindi": "",
      "hindiTransliteration": "तृड़रिड़ तीरं ॥",
      "sourceLineId": "99677",
      "sourceShabadId": "9247",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0592_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬ੍ਰਿੜਰਿੜ ਬੀਰੰ ॥",
      "transliteration": "biraRariR beera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬੀਰ ਬਕਾਰਦੇ ਹਨ, ਢੋਲ ਢਮਕਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 592,
      "hindi": "",
      "hindiTransliteration": "बृड़रिड़ बीरं ॥",
      "sourceLineId": "99678",
      "sourceShabadId": "9247",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0592_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦ੍ਰਿੜਰਿੜ ਢੋਲੰ ॥",
      "transliteration": "dhiraRariR ddola(n) ||",
      "translation": "",
