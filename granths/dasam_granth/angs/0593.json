{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 593,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0593_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬ੍ਰਿੜਰਿੜ ਬਾਜੀ ॥",
      "transliteration": "biraRariR baajee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘੋੜੇ",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "बृड़रिड़ बाजी ॥",
      "sourceLineId": "99707",
      "sourceShabadId": "9247",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗ੍ਰਿੜਰਿੜ ਗਾਜੀ ॥੪੧੭॥",
      "transliteration": "giraRariR gaajee ||417||",
      "translation": "The horses and horse-riders are lying unconscious in the battlefield.417.",
      "punjabiViakhya": "ਅਤੇ ਸੂਰਮੇ ਡਿਗੇ ਪਏ ਹਲ ॥੪੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "गृड़रिड़ गाजी ॥४१७॥",
      "sourceLineId": "99708",
      "sourceShabadId": "9247",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗ੍ਰਿੜਰਿੜ ਗਜਣੰ ॥",
      "transliteration": "giraRariR gajana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਗਾਜ਼ੀ (ਯੋਧੇ) ਕਿੜ ਕਿੜ",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "गृड़रिड़ गजणं ॥",
      "sourceLineId": "99709",
      "sourceShabadId": "9247",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭ੍ਰਿੜਰਿੜ ਭਜਣੰ ॥",
      "transliteration": "bhiraRariR bhajana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਰ ਕੇ ਭਜ ਚਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "भृड़रिड़ भजणं ॥",
      "sourceLineId": "99710",
      "sourceShabadId": "9247",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰ੍ਰਿੜਰਿੜ ਰਾਜਾ ॥",
      "transliteration": "riraRariR raajaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੂੰ ਵੇਖ ਕੇ) ਰਾਜਾ ਵੀ",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "रृड़रिड़ राजा ॥",
      "sourceLineId": "99711",
      "sourceShabadId": "9247",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਲ੍ਰਿੜਰਿੜ ਲਾਜਾ ॥੪੧੮॥",
      "transliteration": "liraRariR laajaa ||418||",
      "translation": "The elephants are running away and in this way, the kings, because of the disgrace of defeat, are feeling ashamed.418.",
      "punjabiViakhya": "ਸ਼ਰਮਿੰਦਾ ਹੋ ਰਿਹਾ ਹੈ ॥੪੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "लृड़रिड़ लाजा ॥४१८॥",
      "sourceLineId": "99712",
      "sourceShabadId": "9247",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਖ੍ਰਿੜਰਿੜ ਖਾਡੇ ॥",
      "transliteration": "khiraRariR khaadde ||",
      "translation": "",
      "punjabiViakhya": "ਖੰਡੇ ਖਿੜ ਖਿੜ ਕੇ ਹਸਦੇ ਹਨ (ਲਿਸ਼ਕਾਰੇ ਮਾਰਦੇ ਹਨ)",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "खृड़रिड़ खाडे ॥",
      "sourceLineId": "99713",
      "sourceShabadId": "9247",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬ੍ਰਿੜਿਰਿੜ ਬਾਡੇ ॥",
      "transliteration": "biraRiriR baadde ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਸੂਰਮਿਆਂ ਦੀਆਂ) ਵੰਡੀਆਂ ਪਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "बृड़िरिड़ बाडे ॥",
      "sourceLineId": "99714",
      "sourceShabadId": "9247",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਰਿੜਰਿੜ ਅੰਗੰ ॥",
      "transliteration": "ariRariR a(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ) ਅੰਗ ਆਕੜ ਗਏ ਹਨ (ਅਰਥਾਤ ਉਨ੍ਰਹਾ ਦੀਆਂ ਲਾਸ਼ਾ ਆਕੜ ਗਈਆਂ ਹਨ)",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "अरिड़रिड़ अंगं ॥",
      "sourceLineId": "99715",
      "sourceShabadId": "9247",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜ੍ਰਿੜਰਿੜ ਜੰਗੰ ॥੪੧੯॥",
      "transliteration": "jiraRariR ja(n)ga(n) ||419||",
      "translation": "The large daggers are striking blows on the limbs in the war-arena.419.",
      "punjabiViakhya": "ਜਿਹੜੇ ਜੰਗ ਵਿਚ ਰੁਝੇ ਸਨ ॥੪੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "जृड़रिड़ जंगं ॥४१९॥",
      "sourceLineId": "99716",
      "sourceShabadId": "9247",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪਾਧੜੀ ਛੰਦ ॥",
      "transliteration": "paadhaRee chha(n)dh ||",
      "translation": "PAADHARI STANZA",
      "punjabiViakhya": "ਪਾਧੜੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "पाधड़ी छंद ॥",
      "sourceLineId": "99717",
      "sourceShabadId": "9248",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਸੈਨ ਜੁਝੀ ਅਪਾਰ ॥",
      "transliteration": "eeh bhaat sain jujhee apaar ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਅਪਾਰ ਸੈਨਾ ਜੂਝੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "इह भाति सैन जुझी अपार ॥",
      "sourceLineId": "99718",
      "sourceShabadId": "9248",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਣਿ ਰੋਹ ਕ੍ਰੋਹ ਧਾਏ ਲੁਝਾਰ ॥",
      "transliteration": "ran roh kroh dhaae lujhaar ||",
      "translation": "",
      "punjabiViakhya": "ਲੜਾਕੇ ਯੋਧੇ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਯੁੱਧ ਵਿਚ ਧਾਵਾ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "रणि रोह क्रोह धाए लुझार ॥",
      "sourceLineId": "99719",
      "sourceShabadId": "9248",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਜੰਤ ਬਾਣ ਗਜੰਤ ਬੀਰ ॥",
      "transliteration": "taja(n)t baan gaja(n)t beer ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਲਲਕਾਰਦੇ ਹੋਏ ਬਾਣ ਛਡਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "तजंत बाण गजंत बीर ॥",
      "sourceLineId": "99720",
      "sourceShabadId": "9248",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਉਠੰਤ ਨਾਦ ਭਜੰਤ ਭੀਰ ॥੪੨੦॥",
      "transliteration": "auTha(n)t naadh bhaja(n)t bheer ||420||",
      "translation": "In this way, innumerable army fought and the warriors, in anger, and discharging arrows and thundering advanced forward, hearing the dreadful sound, the cowards ran away.420.",
      "punjabiViakhya": "(ਬਹੁਤ ਭਿਆਨਕ) ਗੂੰਜ ਉਠਦੀ ਹੈ (ਜਿਸ ਨੂੰ ਸੁਣ ਕੇ) ਡਰਾਕਲ ਭਜਦੇ ਹਨ ॥੪੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "उठंत नाद भजंत भीर ॥४२०॥",
      "sourceLineId": "99721",
      "sourceShabadId": "9248",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਧਾਏ ਸਬਾਹ ਜੋਧਾ ਸਕੋਪ ॥",
      "transliteration": "dhaae sabaeh jodhaa sakop ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਗੀ ਡੀਲ ਡੌਲ ਵਾਲੇ ਯੋਧੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਧਾਵਾ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "धाए सबाह जोधा सकोप ॥",
      "sourceLineId": "99722",
      "sourceShabadId": "9248",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਢਤ ਕ੍ਰਿਪਾਣ ਬਾਹੰਤ ਧੋਪ ॥",
      "transliteration": "kaddat kirapaan baaha(n)t dhop ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਨ ਕਢਦੇ ਹਨ ਅਤੇ ਕਿਰਚਾ ('ਧੋਪ') ਵਾਹੁੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "कढत कृपाण बाहंत धोप ॥",
      "sourceLineId": "99723",
      "sourceShabadId": "9248",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਲੁਝੰਤ ਸੂਰ ਜੁਝੰਤ ਅਪਾਰ ॥",
      "transliteration": "lujha(n)t soor jujha(n)t apaar ||",
      "translation": "",
      "punjabiViakhya": "ਅਪਾਰ ਸੂਰਮੇ ਲੜਦੇ ਹੋਏ ਜੂਝ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "लुझंत सूर जुझंत अपार ॥",
      "sourceLineId": "99724",
      "sourceShabadId": "9248",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਣ ਸੇਤਬੰਧ ਦਿਖੀਅਤ ਪਹਾਰ ॥੪੨੧॥",
      "transliteration": "jan setaba(n)dh dhikheeat pahaar ||421||",
      "translation": "The warriors, in anger , marched forward with their contingents and taking out their swords, they bean to strike blows, the heaps of the corpses looked like the mountains lying on the sea-cost for building the dam.421.",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ) ਮਾਨੋ (ਰਾਮ ਦੁਆਰਾ) ਪੁਲ ਬੰਨ੍ਰਹਣ ਲਈ ਲਿਆਉਾਂਦੇ ਪਰਬਤ ਦਿਸ ਰਹੇ ਹੋਣ ॥੪੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "जण सेतबंध दिखीअत पहार ॥४२१॥",
      "sourceLineId": "99725",
      "sourceShabadId": "9248",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਟੰਤ ਅੰਗ ਭਭਕੰਤ ਘਾਵ ॥",
      "transliteration": "kaTa(n)t a(n)g bhabhaka(n)t ghaav ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਗ ਕਟੇ ਜਾ ਰਹੇ ਹਨ, ਜ਼ਖ਼ਮਾ ਵਿਚੋਂ ਲਹੂ ਭਕ ਭਕ ਕਰ ਕੇ ਨਿਕਲ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "कटंत अंग भभकंत घाव ॥",
      "sourceLineId": "99726",
      "sourceShabadId": "9248",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਿਝੰਤ ਸੂਰ ਜੁਝੰਤ ਚਾਵ ॥",
      "transliteration": "sijha(n)t soor jujha(n)t chaav ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਨਿਰਣਾਇਕ (ਜੰਗ) ਲੜਦੇ ਹਨ ਅਤੇ ਚਾਉ ਨਾਲ ਜੂਝਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "सिझंत सूर जुझंत चाव ॥",
      "sourceLineId": "99727",
      "sourceShabadId": "9248",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਿਰਖੰਤ ਸਿਧ ਚਾਰਣ ਅਨੰਤ ॥",
      "transliteration": "nirakha(n)t sidh chaaran ana(n)t ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮਿਆਂ ਦੀ ਲੜਾਈ ਨੂੰ) ਸਿੱਧ ਲੋਕ ਵੇਖਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "निरखंत सिध चारण अनंत ॥",
      "sourceLineId": "99728",
      "sourceShabadId": "9248",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਉਚਰੰਤ ਕ੍ਰਿਤ ਜੋਧਨ ਬਿਅੰਤ ॥੪੨੨॥",
      "transliteration": "auchara(n)t kirat jodhan bia(n)t ||422||",
      "translation": "The limbs are being chopped, the wounds are oozing our and the warriors are fighting full of zeal, the adepts, minstrels and ballad-singers etc. are looking at the fighting and are also singing the praises of the heroes.422.",
      "punjabiViakhya": "ਅਤੇ ਚਾਰਣ ਲੋਕ ਯੋਧਿਆਂ ਦਾ ਬੇਅੰਤ ਯਸ਼ ਕਹਿੰਦੇ ਹਨ ॥੪੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "उचरंत कृत जोधन बिअंत ॥४२२॥",
      "sourceLineId": "99729",
      "sourceShabadId": "9248",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾਚੰਤ ਆਪ ਈਸਰ ਕਰਾਲ ॥",
      "transliteration": "naacha(n)t aap ieesar karaal ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਆਪ ਭਿਆਨਕ ਨਾਚ ਨਚ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "नाचंत आप ईसर कराल ॥",
      "sourceLineId": "99730",
      "sourceShabadId": "9248",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਾਜੰਤ ਡਉਰੁ ਭੈਕਰਿ ਬਿਸਾਲ ॥",
      "transliteration": "baaja(n)t ddaur bhaikar bisaal ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਭੈਦਾਇਕ ਡੌਰੂ ਵਜਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "बाजंत डउरु भैकरि बिसाल ॥",
      "sourceLineId": "99731",
      "sourceShabadId": "9248",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪੋਅੰਤ ਮਾਲ ਕਾਲੀ ਕਪਾਲ ॥",
      "transliteration": "poa(n)t maal kaalee kapaal ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲੀ (ਸੂਰਮਿਆਂ ਦੇ) ਮੁੰਡਾ ਦੀ ਮਾਲਾ ਪਰੋ ਰਹੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "पोअंत माल काली कपाल ॥",
      "sourceLineId": "99732",
      "sourceShabadId": "9248",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚਲ ਚਿਤ ਚਖ ਛਾਡੰਤ ਜ੍ਵਾਲ ॥੪੨੩॥",
      "transliteration": "chal chit chakh chhaadda(n)t javaiaal ||423||",
      "translation": "Shiva, assuming his dreadful form, is dancing and his frightening tabor is being played, the goddess Kali is stringing the rosaries of skulls and is releasing the fire-flames, while drinking blood.423.",
      "punjabiViakhya": "ਜਿਸ ਦੀਆਂ ਅੱਖਾ ਚੰਚਲ ਹਨ ਅਤੇ (ਮੂੰਹ ਤੋਂ) ਜੁਆਲਾ ਛਡ ਰਹੀ ਹੈ ॥੪੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "चल चित चख छाडंत ज्वाल ॥४२३॥",
      "sourceLineId": "99733",
      "sourceShabadId": "9248",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "99734",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਜੇ ਘੋਰ ਬਾਜੇ ॥",
      "transliteration": "baje ghor baaje ||",
      "translation": "",
      "punjabiViakhya": "ਘੋਰ ਧੁਨ ਕਰਨ ਵਾਲੇ ਵਾਜੇ ਵਜਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "बजे घोर बाजे ॥",
      "sourceLineId": "99735",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਧੁਣੰ ਮੇਘ ਲਾਜੇ ॥",
      "transliteration": "dhuna(n) megh laaje ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਦੀ) ਗੂੰਜ (ਸੁਣ ਕੇ) ਬਦਲ ਸ਼ਰਮਿੰਦੇ ਹੋ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "धुणं मेघ लाजे ॥",
      "sourceLineId": "99736",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਖਹੇ ਖੇਤ ਖਤ੍ਰੀ ॥",
      "transliteration": "khahe khet khatree ||",
      "translation": "",
      "punjabiViakhya": "ਛਤ੍ਰੀ ਲੋਕ ਯੁੱਧ ਵਿਚ (ਇਕ ਦੂਜੇ ਨਾਲ) ਖਹਿ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "खहे खेत खत्री ॥",
      "sourceLineId": "99737",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਜੇ ਤਾਣਿ ਪਤ੍ਰੀ ॥੪੨੪॥",
      "transliteration": "taje taan patree ||424||",
      "translation": "The dreadful war-drums sounded, hearing which the cloud felt shy, the Kshatriyas fought in the battlefield and pulling their bows, discharged the arrows.424.",
      "punjabiViakhya": "ਅਤੇ ਤਣ ਕੇ ਖੰਭਾ ਵਾਲੇ ਤੀਰ ਛਡ ਰਹੇ ਹਨ ॥੪੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "तजे ताणि पत्री ॥४२४॥",
      "sourceLineId": "99738",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗਿਰੈ ਅੰਗ ਭੰਗੰ ॥",
      "transliteration": "girai a(n)g bha(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਯੋਧਿਆਂ ਦੇ) ਅੰਗ ਟੁਟ ਟੁਟ ਕੇ ਡਿਗ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "गिरै अंग भंगं ॥",
      "sourceLineId": "99739",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਚੇ ਜੰਗ ਰੰਗੰ ॥",
      "transliteration": "nache ja(n)g ra(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੰਗ ਦੇ ਰੰਗ ਵਿਚ (ਰੰਗੀਜ ਕੇ ਸੂਰਮੇ) ਨਚ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "नचे जंग रंगं ॥",
      "sourceLineId": "99740",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਖੁਲੇ ਖਗ ਖੂਨੀ ॥",
      "transliteration": "khule khag khoonee ||",
      "translation": "",
      "punjabiViakhya": "ਲਹੂ ਪੀਣੀਆਂ ਤਲਵਾਰਾ ਮਿਆਨੋ ਨਿਕਲ ਆਈਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "खुले खग खूनी ॥",
      "sourceLineId": "99741",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚੜੇ ਚਉਪ ਦੂਨੀ ॥੪੨੫॥",
      "transliteration": "chaRe chaup dhoonee ||425||",
      "translation": "The warriors, with the broken limbs, fell while dancing, being absorbed in fighting, the fighters drew out their daggers with double zeal.425.",
      "punjabiViakhya": "ਅਤੇ (ਉਨ੍ਰਹਾ ਨੂੰ ਵੇਖ ਕੇ ਯੋਧਿਆਂ ਨੂੰ) ਦੁਗਣਾ ਚਾਉ ਚੜ੍ਰਹ ਰਿਹਾ ਹੈ ॥੪੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "चड़े चउप दूनी ॥४२५॥",
      "sourceLineId": "99742",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭਯੋ ਘੋਰ ਜੁਧੰ ॥",
      "transliteration": "bhayo ghor judha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਘੋਰ ਯੁੱਧ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "भयो घोर जुधं ॥",
      "sourceLineId": "99743",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਇਤੀ ਕਾਹਿ ਸੁਧੰ ॥",
      "transliteration": "eitee kaeh sudha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਦੀ) ਇਤਨੀ ਖ਼ਬਰ ਕਿਸੇ ਨੂੰ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "इती काहि सुधं ॥",
      "sourceLineId": "99744",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਿਣਿਓ ਕਾਲ ਰੂਪੰ ॥",
      "transliteration": "jinio kaal roopa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਰਾਜਿਆਂ ਨੇ ਕਾਲ ਵਰਗੇ (ਸੂਰਮਿਆਂ ਨੂੰ) ਜਿਤ ਲਿਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "जिणिओ काल रूपं ॥",
      "sourceLineId": "99745",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭਜੇ ਸਰਬ ਭੂਪੰ ॥੪੨੬॥",
      "transliteration": "bhaje sarab bhoopa(n) ||426||",
      "translation": "Such a terrible war was fought, that none of the fighters remained in senses, Kalki, the manifestation of Yama, was victorious and all the kings fled away.426.",
      "punjabiViakhya": "ਉਹ ਸਾਰੇ ਰਾਜੇ ਭਜ ਚਲੇ ਹਨ ॥੪੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "भजे सरब भूपं ॥४२६॥",
      "sourceLineId": "99746",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਬੈ ਸੈਣ ਭਾਜਾ ॥",
      "transliteration": "sabai sain bhaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਸੈਨਾ ਭਜੀ ਜਾ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "सबै सैण भाजा ॥",
      "sourceLineId": "99747",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਫਿਰ੍ਯੋ ਆਪ ਰਾਜਾ ॥",
      "transliteration": "firayo aap raajaa ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ ਵੇਖ ਕੇ ਸੰਭਲ ਦਾ) ਰਾਜਾ ਫਿਰ ਪਰਤਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "फिर्यो आप राजा ॥",
      "sourceLineId": "99748",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਠਟ੍ਰਯੋ ਆਣਿ ਜੁਧੰ ॥",
      "transliteration": "ThaTrayo aan judha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਨੂੰ ਸ਼ੁਰੂ ਕਰ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "ठट्रयो आणि जुधं ॥",
      "sourceLineId": "99749",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਭਇਓ ਨਾਦ ਉਧੰ ॥੪੨੭॥",
      "transliteration": "bhio naadh udha(n) ||427||",
      "translation": "When all the kings fled away, then the king (of Sambhal) himself rotated and came in front and producing the terrible sound, he began the fighting.427.",
      "punjabiViakhya": "ਬਹੁਤ ਭਾਰਾ ਰੌਲਾ ਅਤੇ ਗੂੰਜ ਪੈ ਗਈ ਹੈ ॥੪੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "भइओ नाद उधं ॥४२७॥",
      "sourceLineId": "99750",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਜੇ ਬਾਣ ਐਸੇ ॥",
      "transliteration": "taje baan aaise ||",
      "translation": "",
      "punjabiViakhya": "(ਯੋਧੇ) ਇਉਾਂ ਤੀਰ ਛਡਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "तजे बाण ऐसे ॥",
      "sourceLineId": "99751",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬਣੰ ਪਤ੍ਰ ਜੈਸੇ ॥",
      "transliteration": "bana(n) patr jaise ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਉਾਂ (ਹਨੇਰੀ ਨਾਲ) ਬਨ ਵਿਚ ਪੱਤਰ ਉਡਦੇ ਹਨ;",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "बणं पत्र जैसे ॥",
      "sourceLineId": "99752",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਲੰ ਮੇਘ ਧਾਰਾ ॥",
      "transliteration": "jala(n) megh dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਜਿਵੇਾਂ ਬਦਲ ਵਿਚੋਂ ਜਲ ਦੀਆਂ ਬੂੰਦਾ ਡਿਗਦੀਆਂ ਹਨ;",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "जलं मेघ धारा ॥",
      "sourceLineId": "99753",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0593_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਭੰ ਜਾਣੁ ਤਾਰਾ ॥੪੨੮॥",
      "transliteration": "nabha(n) jaan taaraa ||428||",
      "translation": "He was discharging his arrows as if the leaves were flying in the forest or the stars were falling from the sky.428.",
      "punjabiViakhya": "ਜਾ ਆਕਾਸ਼ ਵਿਚੋਂ ਤਾਰੇ ਟੁਟ ਰਹੇ ਹਨ ॥੪੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 593,
      "hindi": "",
      "hindiTransliteration": "नभं जाणु तारा ॥४२८॥",
      "sourceLineId": "99754",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
