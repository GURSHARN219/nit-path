{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 594,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0594_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਰ ਅੰਸੁਮਾਲੀ ॥",
      "transliteration": "kar a(n)sumaalee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਸੂਰਜ ਦੀਆਂ ਕਿਰਨਾ ਹੋਣ,",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "कर अंसुमाली ॥",
      "sourceLineId": "99755",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਰੰ ਸਤ੍ਰੁ ਸਾਲੀ ॥",
      "transliteration": "sara(n) satr saalee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤਰ੍ਰਹਾ ਬਾਣ ਵੈਰੀਆਂ ਨੂੰ ਸਲ੍ਰਹਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "सरं सत्रु साली ॥",
      "sourceLineId": "99756",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚਹੂੰ ਓਰਿ ਛੂਟੇ ॥",
      "transliteration": "chahoo(n) or chhooTe ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ (ਬਾਣ) ਛੁਟ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "चहूँ ओरि छूटे ॥",
      "sourceLineId": "99757",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਹਾ ਜੋਧ ਜੂਟੇ ॥੪੨੯॥",
      "transliteration": "mahaa jodh jooTe ||429||",
      "translation": "He caused great loss to the enemies with his arrows, the arrows of the great warriors were discharged from all the four sides.429.",
      "punjabiViakhya": "ਮਹਾਨ ਯੁੱਧ ਵਿਚ ਜੁਟੇ ਹੋਏ ਹਨ ॥੪੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "महा जोध जूटे ॥४२९॥",
      "sourceLineId": "99758",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚਲੇ ਕੀਟਕਾ ਸੇ ॥",
      "transliteration": "chale keeTakaa se ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਸੈਨਾ) ਕੀੜਿਆਂ ਵਾਗ ਚਲ ਰਹੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "चले कीटका से ॥",
      "sourceLineId": "99759",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਢੇ ਟਿਡਕਾ ਸੇ ॥",
      "transliteration": "badde Tiddakaa se ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਵੱਡੇ ਟਿੱਡੀ ਦਲ ਵਰਗੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "बढे टिडका से ॥",
      "sourceLineId": "99760",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਨੰ ਸਿੰਧੁ ਰੇਤੰ ॥",
      "transliteration": "kana(n) si(n)dh reta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਸਮੁੰਦਰ ਦੀ ਰੇਤ ਦੇ ਕਿਣਕਿਆਂ ਜਿੰਨੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "कनं सिंधु रेतं ॥",
      "sourceLineId": "99761",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਨੰ ਰੋਮ ਤੇਤੰ ॥੪੩੦॥",
      "transliteration": "tana(n) rom teta(n) ||430||",
      "translation": "The arrows flew like the innumerable worms and locusts and they were countless in numbers like the particles of sand and the hair of the body.430.",
      "punjabiViakhya": "ਜਾ ਸ਼ਰੀਰ ਦੇ ਰੋਮਾ ਜਿਤਨੀ ਹੈ ॥੪੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "तनं रोम तेतं ॥४३०॥",
      "sourceLineId": "99762",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਛੁਟੇ ਸ੍ਵਰਣ ਪੁਖੀ ॥",
      "transliteration": "chhuTe savairan pukhee ||",
      "translation": "",
      "punjabiViakhya": "ਸੋਨੇ ਦੇ ਖੰਭਾ ਵਾਲੇ ਤੀਰ ਛੁਟੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "छुटे स्वरण पुखी ॥",
      "sourceLineId": "99763",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੁਧੰ ਸਾਰ ਮੁਖੀ ॥",
      "transliteration": "sudha(n) saar mukhee ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੀ ਲੋਹੇ ਦੀ ਮੁਖੀ ਲਿਸ਼ਕ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "सुधं सार मुखी ॥",
      "sourceLineId": "99764",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਲੰ ਕੰਕ ਪਤ੍ਰੀ ॥",
      "transliteration": "kala(n) ka(n)k patree ||",
      "translation": "",
      "punjabiViakhya": "ਕਾ ਦੇ ਖੰਭਾ ਵਰਗੇ ਤੀਰ",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "कलं कंक पत्री ॥",
      "sourceLineId": "99765",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਜੇ ਜਾਣੁ ਛਤ੍ਰੀ ॥੪੩੧॥",
      "transliteration": "taje jaan chhatree ||431||",
      "translation": "The arrows, with golden wings and steel tips, were discharged and in this way, the arrows with sharp tips were discharged on the Kshatriyas.431.",
      "punjabiViakhya": "ਮਾਨੋ ਛਤ੍ਰੀਆਂ ਨੇ ਛਡੇ ਹੋਣ ॥੪੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "तजे जाणु छत्री ॥४३१॥",
      "sourceLineId": "99766",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗਿਰੈ ਰੇਤ ਖੇਤੰ ॥",
      "transliteration": "girai ret kheta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰੇਤ ਦੇ (ਕਿਣਕਿਆਂ ਜਿੰਨੇ ਸੂਰਮੇ) ਯੁੱਧ ਵਿਚ ਡਿਗ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "गिरै रेत खेतं ॥",
      "sourceLineId": "99767",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਚੈ ਭੂਤ ਪ੍ਰੇਤੰ ॥",
      "transliteration": "nachai bhoot preta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭੂਤ ਅਤੇ ਪ੍ਰੇਤ ਨਚ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "नचै भूत प्रेतं ॥",
      "sourceLineId": "99768",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਰੈ ਚਿਤ੍ਰ ਚਾਰੰ ॥",
      "transliteration": "karai chitr chaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਚਿਤਰ ਵਰਗੇ ਬਣੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "करै चित्र चारं ॥",
      "sourceLineId": "99769",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਜੈ ਬਾਣ ਧਾਰੰ ॥੪੩੨॥",
      "transliteration": "tajai baan dhaara(n) ||432||",
      "translation": "The warriors began to fall in the battlefield and the ghosts and fiends danced, the fighters, getting pleased, showered arrows.432.",
      "punjabiViakhya": "ਬਾਣਾ ਦਾ ਮੀਂਹ ਬਰਸਾ ਰਹੇ ਹਨ ॥੪੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "तजै बाण धारं ॥४३२॥",
      "sourceLineId": "99770",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਲਹੈ ਜੋਧ ਜੋਧੰ ॥",
      "transliteration": "lahai jodh jodha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧੇ ਯੋਧਿਆਂ ਨੂੰ ਵੇਖਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "लहै जोध जोधं ॥",
      "sourceLineId": "99771",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਰੈ ਘਾਇ ਕ੍ਰੋਧੰ ॥",
      "transliteration": "karai ghai krodha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ (ਵੈਰੀ ਨੂੰ) ਘਾਉ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "करै घाइ क्रोधं ॥",
      "sourceLineId": "99772",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਖਹੈ ਖਗ ਖਗੈ ॥",
      "transliteration": "khahai khag khagai ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਨਾਲ ਤਲਵਾਰਾ ਖਹਿਬੜਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "खहै खग खगै ॥",
      "sourceLineId": "99773",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਉਠੈ ਝਾਲ ਅਗੈ ॥੪੩੩॥",
      "transliteration": "auThai jhaal agai ||433||",
      "translation": "The warriors challenging others in fury, inflicted wounds on them, with the collision of dagger with the dagger, the sparks of fire were emited.433.",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਵਿਚੋਂ) ਅੱਗ ਦੀਆਂ ਚਿੰਗਾਰੀਆਂ ਨਿਕਲਦੀਆਂ ਹਨ ॥੪੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "उठै झाल अगै ॥४३३॥",
      "sourceLineId": "99774",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਚੇ ਪਖਰਾਲੇ ॥",
      "transliteration": "nache pakharaale ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਠੀਆਂ ਵਾਲੇ ਘੋੜ ਸਵਾਰ ਨੱਚਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "नचे पखराले ॥",
      "sourceLineId": "99775",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚਲੇ ਬਾਲ ਆਲੇ ॥",
      "transliteration": "chale baal aale ||",
      "translation": "",
      "punjabiViakhya": "ਅਪੱਛਰਾਵਾ ਦੇ ਘਰਾ ਨੂੰ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "चले बाल आले ॥",
      "sourceLineId": "99776",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਸੇ ਪ੍ਰੇਤ ਨਾਚੈ ॥",
      "transliteration": "hase pret naachai ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰੇਤ ਹਸਦੇ ਹੋਏ ਨਚਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "हसे प्रेत नाचै ॥",
      "sourceLineId": "99777",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਣੰ ਰੰਗਿ ਰਾਚੈ ॥੪੩੪॥",
      "transliteration": "rana(n) ra(n)g raachai ||434||",
      "translation": "The horses danced and the ghosts roamed, the fiends, laughingly were absorbed in war.434.",
      "punjabiViakhya": "ਯੋਧੇ ਯੁੱਧ-ਕਰਮ ਵਿਚ ਮਗਨ ਹਨ ॥੪੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "रणं रंगि राचै ॥४३४॥",
      "sourceLineId": "99778",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਚੇ ਪਾਰਬਤੀਸੰ ॥",
      "transliteration": "nache paarabateesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਨਚ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "नचे पारबतीसं ॥",
      "sourceLineId": "99779",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੰਡਿਓ ਜੁਧ ਈਸੰ ॥",
      "transliteration": "ma(n)ddio judh ieesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਯੁੱਧ ਮੰਡਿਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "मंडिओ जुध ईसं ॥",
      "sourceLineId": "99780",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦਸੰ ਦਿਉਸ ਕੁਧੰ ॥",
      "transliteration": "dhasa(n) dhiaus kudha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦਸਾ ਦਿਸ਼ਾਵਾ ਵਿਚ ਕ੍ਰੋਧ ਛਾਇਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "दसं दिउस कुधं ॥",
      "sourceLineId": "99781",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭਯੋ ਘੋਰ ਜੁਧੰ ॥੪੩੫॥",
      "transliteration": "bhayo ghor judha(n) ||435||",
      "translation": "Shiva also fought, while dancing, and in this way, for ten days, this ire-full war was fought.435.",
      "punjabiViakhya": "ਭਿਆਨਕ ਯੁੱਧ ਹੋ ਰਿਹਾ ਹੈ ॥੪੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "भयो घोर जुधं ॥४३५॥",
      "sourceLineId": "99782",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪੁਨਰ ਬੀਰ ਤ੍ਯਾਗ੍ਰਯੋ ॥",
      "transliteration": "punar beer tayaagrayo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਯੋਧਿਆਂ ਨੇ (ਯੁੱਧ) ਤਿਆਗ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "पुनर बीर त्याग्रयो ॥",
      "sourceLineId": "99783",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪਗੰ ਦ੍ਵੈਕੁ ਭਾਗ੍ਯੋ ॥",
      "transliteration": "paga(n) dhavaik bhaagayo ||",
      "translation": "",
      "punjabiViakhya": "ਦੋ ਕੁ ਕਦਮ ਪਿਛੇ ਵਲ ਉਠਾਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "पगं द्वैकु भाग्यो ॥",
      "sourceLineId": "99784",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਫਿਰ੍ਯੋ ਫੇਰਿ ਐਸੇ ॥",
      "transliteration": "firayo fer aaise ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਇਸ ਤਰ੍ਰਹਾ ਪਰਤੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "फिर्यो फेरि ऐसे ॥",
      "sourceLineId": "99785",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕ੍ਰੋਧੀ ਸਾਪ ਜੈਸੇ ॥੪੩੬॥",
      "transliteration": "krodhee saap jaise ||436||",
      "translation": "Then the king, abandoning his spirit of bravery, ran for two steps, but then he rotated like the revengful snake.436.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕ੍ਰੋਧਿਤ ਸੱਪ ਪਿਛੇ ਨੂੰ ਪਰਤਦਾ ਹੈ ॥੪੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "क्रोधी साप जैसे ॥४३६॥",
      "sourceLineId": "99786",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪੁਨਰ ਜੁਧ ਮੰਡਿਓ ॥",
      "transliteration": "punar judh ma(n)ddio ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਯੁੱਧ ਸ਼ੁਰੂ ਕਰ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "पुनर जुध मंडिओ ॥",
      "sourceLineId": "99787",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਰੰ ਓਘ ਛੰਡਿਓ ॥",
      "transliteration": "sara(n) ogh chha(n)ddio ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਅਧਿਕ ਤੀਰ ਛਡੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "सरं ओघ छंडिओ ॥",
      "sourceLineId": "99788",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਜੈ ਵੀਰ ਬਾਣੰ ॥",
      "transliteration": "tajai veer baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵੀਰ ਯੋਧੇ ਬਾਣ ਛਡਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "तजै वीर बाणं ॥",
      "sourceLineId": "99789",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮ੍ਰਿਤੰ ਆਇ ਤ੍ਰਾਣੰ ॥੪੩੭॥",
      "transliteration": "mrita(n) aai traana(n) ||437||",
      "translation": "Then he again began the war and showered arrows, the warriors discharged arrows and the death released them from the terror of the war.437.",
      "punjabiViakhya": "(ਮਾਨੋ) ਜ਼ਬਰਦਸਤੀ ਮੌਤ ਆ ਗਈ ਹੋਵੇ ॥੪੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "मृतं आइ त्राणं ॥४३७॥",
      "sourceLineId": "99790",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਭੈ ਸਿਧ ਦੇਖੈ ॥",
      "transliteration": "sabhai sidh dhekhai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਸਿੱਧ ਲੋਕ ਵੇਖ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "सभै सिध देखै ॥",
      "sourceLineId": "99791",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਲੰਕ੍ਰਿਤ ਲੇਖੈ ॥",
      "transliteration": "kala(n)kirat lekhai ||",
      "translation": "",
      "punjabiViakhya": "(ਕਲਕੀ ਅਵਤਾਰ ਦੀ) ਕੀਰਤੀ ਲਿਖ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "कलंकृत लेखै ॥",
      "sourceLineId": "99792",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਧਨੰ ਧੰਨਿ ਜੰਪੈ ॥",
      "transliteration": "dhana(n) dha(n)n ja(n)pai ||",
      "translation": "",
      "punjabiViakhya": "ਧੰਨ ਧੰਨ ਜਪਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "धनं धंनि जंपै ॥",
      "sourceLineId": "99793",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਲਖੈ ਭੀਰ ਕੰਪੈ ॥੪੩੮॥",
      "transliteration": "lakhai bheer ka(n)pai ||438||",
      "translation": "All the adepts saw Kalki and repeated “bravo, bravo”, the cowards trembled on seeing him.438.",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ) ਵੇਖ ਕੇ ਕਾਇਰ ਲੋਕ ਕੰਬਦੇ ਹਨ ॥੪੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "लखै भीर कंपै ॥४३८॥",
      "sourceLineId": "99794",
      "sourceShabadId": "9249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "naraaj chha(n)dh ||",
      "translation": "NARAAJ STANZA",
      "punjabiViakhya": "ਨਰਾਜ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "नराज छंद ॥",
      "sourceLineId": "99795",
      "sourceShabadId": "9250",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਆਨਿ ਆਨਿ ਸੂਰਮਾ ਸੰਧਾਨਿ ਬਾਨ ਧਾਵਹੀਂ ॥",
      "transliteration": "aan aan sooramaa sa(n)dhaan baan dhaavahee(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਆ ਆ ਕੇ ਬਾਣਾ ਦਾ ਨਿਸ਼ਾਣਾ ਬੰਨ੍ਰਹ ਕੇ ਅਗੇ ਵਧਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "आनि आनि सूरमा संधानि बान धावहीं ॥",
      "sourceLineId": "99796",
      "sourceShabadId": "9250",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਰੂਝਿ ਜੂਝ ਕੈ ਮਰੈ ਸੁ ਦੇਵ ਨਾਰਿ ਪਾਵਹੀਂ ॥",
      "transliteration": "roojh joojh kai marai su dhev naar paavahee(n) ||",
      "translation": "The warriors aiming the targets of their arrows marched forward and embracing martyrdom in the war, they wedded the heavenly damsels",
      "punjabiViakhya": "(ਜੋ) ਲੜਾਈ ਵਿਚ ਰੁਝ ਕੇ ਮਰਦੇ ਹਨ, ਉਹ ਅਪੱਛਰਾਵਾ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰ ਲੈਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "रूझि जूझ कै मरै सु देव नारि पावहीं ॥",
      "sourceLineId": "99797",
      "sourceShabadId": "9250",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੁ ਰੀਝਿ ਰੀਝਿ ਅਛਰਾ ਅਲਛ ਸੂਰਣੋ ਬਰੈਂ ॥",
      "transliteration": "s reejh reejh achharaa alachh soorano barai(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਦੇਵ ਇਸਤਰੀਆਂ ਰੀਝ ਰੀਝ ਕੇ ਅਣਦਿਖ (ਅਥਵਾ ਅਦਾਗ਼) ਸੂਰਮਿਆਂ ਨੂੰ ਵਰਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "सु रीझि रीझि अछरा अलछ सूरणो बरैं ॥",
      "sourceLineId": "99798",
      "sourceShabadId": "9250",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪ੍ਰਬੀਨ ਬੀਨਿ ਬੀਨ ਕੈ ਸੁਧੀਨ ਪਾਨਿ ਕੈ ਧਰੈਂ ॥੪੩੯॥",
      "transliteration": "prabeen been been kai sudheen paan kai dharai(n) ||439||",
      "translation": "The heavenly damsels, also being pleased, began to wed the warriors catching their hands after selecting them.439.",
      "punjabiViakhya": "ਪ੍ਰਬੀਨ (ਯੋਧਿਆਂ) ਨੂੰ ਚੁਣ ਚੁਣ ਕੇ (ਉਨ੍ਰਹਾ) ਸ੍ਰੇਸ਼ਠ ਸੁਧ ਬੁਧ ਵਾਲਿਆਂ ਦਾ ਹੱਥ ਧਾਰਨ ਕਰਦੀਆਂ ਹਨ ॥੪੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "प्रबीन बीनि बीन कै सुधीन पानि कै धरैं ॥४३९॥",
      "sourceLineId": "99799",
      "sourceShabadId": "9250",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਨਧ ਬਧ ਅਧ ਹ੍ਵੈ ਬਿਰੁਧਿ ਸੂਰ ਧਾਵਹੀਂ ॥",
      "transliteration": "sanadh badh adh havai birudh soor dhaavahee(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹਥਿਆਰ ਬੰਦ ਸੂਰਮੇ ਲਕ ਬੰਨ੍ਰਹ ਕੇ ('ਬਧ ਅਧ') ਸਾਹਮਣੇ ਹੋ ਕੇ ਧਾਵਾ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "सनध बध अध ह्वै बिरुधि सूर धावहीं ॥",
      "sourceLineId": "99800",
      "sourceShabadId": "9250",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੁ ਕ੍ਰੋਧ ਸਾਗ ਤੀਛਣੰ ਕਿ ਤਾਕਿ ਸਤ੍ਰੁ ਲਾਵਹੀਂ ॥",
      "transliteration": "s krodh saag teechhana(n) k taak satr laavahee(n) ||",
      "translation": "The warriors, getting bedecked, fell on the direction of the opponents and striking sharp lances on the enemies",
      "punjabiViakhya": "ਤੀਖਣ ਸਾਗਾ ਲੈ ਕੇ ਵੈਰੀ ਦਾ ਨਿਸ਼ਾਣਾ ਬੰਨ੍ਰਹ ਕੇ ਮਾਰ ਦਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "सु क्रोध साग तीछणं कि ताकि सत्रु लावहीं ॥",
      "sourceLineId": "99801",
      "sourceShabadId": "9250",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0594_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੁ ਜੂਝਿ ਜੂਝ ਕੈ ਗਿਰੈ ਅਲੂਝ ਲੂਝ ਕੈ ਹਠੀਂ ॥",
      "transliteration": "s joojh joojh kai girai aloojh loojh kai haThee(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਯੁੱਧ ਵਿਚ ਜੂਝ ਕੇ ਡਿਗਦੇ ਹਨ ਅਤੇ ਹਠੀ (ਯੋਧੇ) ਬੇਲਾਗ ਹੋ ਕੇ ਲੜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 594,
      "hindi": "",
      "hindiTransliteration": "सु जूझि जूझ कै गिरै अलूझ लूझ कै हठीं ॥",
      "sourceLineId": "99802",
      "sourceShabadId": "9250",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
