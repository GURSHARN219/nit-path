{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 595,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0595_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਬੂਝ ਓਰਿ ਧਾਵਹੀ ਬਨਾਇ ਸੈਨ ਏਕਠੀਂ ॥੪੪੦॥",
      "transliteration": "aboojh or dhaavahee banai sain ekaThee(n) ||440||",
      "translation": "The persistent fighters are falling down after continued fighting and gathering their forces, are running in various directions here and there.440.",
      "punjabiViakhya": "ਸੈਨਾ ਨੂੰ ਇਕਠਿਆਂ ਕਰ ਕੇ ਅਣਜਾਣੇ ਪਾਸੇ ਵਲ ਧਾਵਾ ਕਰਦੇ ਹਨ ॥੪੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "अबूझ ओरि धावही बनाइ सैन एकठीं ॥४४०॥",
      "sourceLineId": "99803",
      "sourceShabadId": "9250",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੰਗੀਤ ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "sa(n)geet bhuja(n)g prayaat chha(n)dh ||",
      "translation": "SANGEET BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਸੰਗੀਤ ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "संगीत भुजंग प्रयात छंद ॥",
      "sourceLineId": "99804",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਾਗੜਦੰ ਕੋਪਾ ਰਾਗੜਦੰ ਰਾਜਾ ॥",
      "transliteration": "kaagaRadha(n) kopaa raagaRadha(n) raajaa ||",
      "translation": "",
      "punjabiViakhya": "(ਸੰਭਲ ਦਾ) ਰਾਜਾ ਕ੍ਰੋਧਿਤ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "कागड़दं कोपा रागड़दं राजा ॥",
      "sourceLineId": "99805",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਘਾਗੜਦੰ ਘੋਰੇ ਬਾਗੜਦੰ ਬਾਜਾ ॥",
      "transliteration": "ghaagaRadha(n) ghore baagaRadha(n) baajaa ||",
      "translation": "",
      "punjabiViakhya": "ਜ਼ੋਰ ਦਾ ਨਗਾਰਾ ਵਜਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "घागड़दं घोरे बागड़दं बाजा ॥",
      "sourceLineId": "99806",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਫਾਗੜਦੰ ਫੀਲੰ ਛਾਗੜਦੰ ਛੂਟੇ ॥",
      "transliteration": "faagaRadha(n) feela(n) chhaagaRadha(n) chhooTe ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਥੀ ਛੁਟ ਕੇ ਪੈ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "फागड़दं फीलं छागड़दं छूटे ॥",
      "sourceLineId": "99807",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਾਗੜਦੰ ਸੂਰੰ ਜਾਗੜਦੰ ਜੂਟੇ ॥੪੪੧॥",
      "transliteration": "saagaRadha(n) soora(n) jaagaRadha(n) jooTe ||441||",
      "translation": "The king trembled, the dreadful war-drums sounded, the elephants went out of control and the warriors fought with one-another.441.",
      "punjabiViakhya": "ਸੂਰਮੇ ਜੁਟ ਗਏ ਹਨ ॥੪੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "सागड़दं सूरं जागड़दं जूटे ॥४४१॥",
      "sourceLineId": "99808",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਾਗੜਦੰ ਬਾਜੇ ਨਾਗੜਦੰ ਨਗਾਰੇ ॥",
      "transliteration": "baagaRadha(n) baaje naagaRadha(n) nagaare ||",
      "translation": "",
      "punjabiViakhya": "ਨਗਾਰੇ ਵਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "बागड़दं बाजे नागड़दं नगारे ॥",
      "sourceLineId": "99809",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਾਗੜਦੰ ਜੋਧਾ ਮਾਗੜਦੰ ਮਾਰੇ ॥",
      "transliteration": "jaagaRadha(n) jodhaa maagaRadha(n) maare ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ 'ਮਾਰੋ-ਮਾਰੋ' ਕਹਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "जागड़दं जोधा मागड़दं मारे ॥",
      "sourceLineId": "99810",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਡਾਗੜਦੰ ਡਿਗੇ ਖਾਗੜਦੰ ਖੂਨੀ ॥",
      "transliteration": "ddaagaRadha(n) ddige khaagaRadha(n) khoonee ||",
      "translation": "",
      "punjabiViakhya": "ਖੂਨ ਨਾਲ ਲਥ ਪਥ (ਯੋਧੇ) ਡਿਗਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "डागड़दं डिगे खागड़दं खूनी ॥",
      "sourceLineId": "99811",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚਾਗੜਦੰ ਚਉਪੈ ਦਾਗੜਦੰ ਦੂਨੀ ॥੪੪੨॥",
      "transliteration": "chaagaRadha(n) chaupai dhaagaRadha(n) dhoonee ||442||",
      "translation": "The trumpets sounded and the warriors were killed, the bloody fighters fell and their zeal doubled.442.",
      "punjabiViakhya": "ਅਤੇ (ਸੂਰਮਿਆਂ ਵਿਚ) ਦੁਗਣਾ ਚਾਉ ਚੜ੍ਰਹਦਾ ਹੈ ॥੪੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "चागड़दं चउपै दागड़दं दूनी ॥४४२॥",
      "sourceLineId": "99812",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹਾਗੜਦੰ ਹਸੇ ਸਾਗੜਦੰ ਸਿਧੰ ॥",
      "transliteration": "haagaRadha(n) hase saagaRadha(n) sidha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਿੱਧ (ਲੋਕ ਯੁੱਧ ਨੂੰ ਵੇਖ ਕੇ) ਹਸ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "हागड़दं हसे सागड़दं सिधं ॥",
      "sourceLineId": "99813",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਾਗੜਦੰ ਭਾਜੇ ਬਾਗੜਦੰ ਬ੍ਰਿਧੰ ॥",
      "transliteration": "bhaagaRadha(n) bhaaje baagaRadha(n) biradha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਡੇ ਵੱਡੇ ਯੋਧੇ ('ਬ੍ਰਿਧੰ') ਭਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "भागड़दं भाजे बागड़दं बृधं ॥",
      "sourceLineId": "99814",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਛਾਗੜਦੰ ਛੁਟੇ ਤਾਗੜਦੰ ਤੀਰੰ ॥",
      "transliteration": "chhaagaRadha(n) chhuTe taagaRadha(n) teera(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ ਛੁਟ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "छागड़दं छुटे तागड़दं तीरं ॥",
      "sourceLineId": "99815",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਾਗੜਦੰ ਜੁਟੇ ਬਾਗੜਦੰ ਬੀਰੰ ॥੪੪੩॥",
      "transliteration": "jaagaRadha(n) juTe baagaRadha(n) beera(n) ||443||",
      "translation": "The adepts laughed and the groups of warriors ran away, the arrows were discharged and the warriors fought among themselves.443.",
      "punjabiViakhya": "ਸੂਰਮੇ (ਯੁੱਧ ਕਰਮ ਵਿਚ) ਜੁਟੇ ਹੋਏ ਹਨ ॥੪੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "जागड़दं जुटे बागड़दं बीरं ॥४४३॥",
      "sourceLineId": "99816",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਾਗੜਦੰ ਕੁਹਕੇ ਬਾਗੜਦੰ ਬਾਣੰ ॥",
      "transliteration": "kaagaRadha(n) kuhake baagaRadha(n) baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣ 'ਕੁਹ ਕੁਹ' ਕਰਦੇ ਚਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "कागड़दं कुहके बागड़दं बाणं ॥",
      "sourceLineId": "99817",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਫਾਗੜਦੰ ਫਰਕੇ ਨਾਗੜਦੰ ਨਿਸਾਣੰ ॥",
      "transliteration": "faagaRadha(n) farake naagaRadha(n) nisaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨਿਸ਼ਾਣ (ਝੰਡੇ) ਝੂਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "फागड़दं फरके नागड़दं निसाणं ॥",
      "sourceLineId": "99818",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਾਗੜਦੰ ਬਾਜੀ ਭਾਗੜਦੰ ਭੇਰੀ ॥",
      "transliteration": "baagaRadha(n) baajee bhaagaRadha(n) bheree ||",
      "translation": "",
      "punjabiViakhya": "ਭੇਰੀਆਂ ਵਜਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "बागड़दं बाजी भागड़दं भेरी ॥",
      "sourceLineId": "99819",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਾਗੜਦੰ ਸੈਣੰ ਫਾਗੜਦੰ ਫੇਰੀ ॥੪੪੪॥",
      "transliteration": "saagaRadha(n) saina(n) faagaRadha(n) feree ||444||",
      "translation": "There was the sound of arrows and the trumpets sounded, the kettledrums were played and the armies roamed.444.",
      "punjabiViakhya": "ਸੈਨਾ ਨੂੰ ਪਰਤਾ ਦਿੱਤਾ ਹੈ ॥੪੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "सागड़दं सैणं फागड़दं फेरी ॥४४४॥",
      "sourceLineId": "99820",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭਾਗੜਦੰ ਭੀਰੰ ਕਾਗੜਦੰ ਕੰਪੈ ॥",
      "transliteration": "bhaagaRadha(n) bheera(n) kaagaRadha(n) ka(n)pai ||",
      "translation": "",
      "punjabiViakhya": "ਡਰਾਕਲ ਲੋਕ ਕੰਬਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "भागड़दं भीरं कागड़दं कंपै ॥",
      "sourceLineId": "99821",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਾਗੜਦੰ ਮਾਰੇ ਜਾਗੜਦੰ ਜੰਪੈ ॥",
      "transliteration": "maagaRadha(n) maare jaagaRadha(n) ja(n)pai ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਰੇ ਹੋਏ (ਤੋਬਾ ਤੋਬਾ) ਜਪਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "मागड़दं मारे जागड़दं जंपै ॥",
      "sourceLineId": "99822",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਛਾਗੜਦੰ ਛਪ੍ਰੰ ਭਾਗੜਦੰ ਭਾਜੇ ॥",
      "transliteration": "chhaagaRadha(n) chhapra(n) bhaagaRadha(n) bhaaje ||",
      "translation": "",
      "punjabiViakhya": "ਛੇਤੀ ਨਾਲ ਭਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "छागड़दं छप्रं भागड़दं भाजे ॥",
      "sourceLineId": "99823",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚਾਗੜਦੰ ਚਿਤੰ ਲਾਗੜਦੰ ਲਾਜੇ ॥੪੪੫॥",
      "transliteration": "chaagaRadha(n) chita(n) laagaRadha(n) laaje ||445||",
      "translation": "The cowards trembled and were killed in the battlefield, Many of them speedily ran away and felt shameful in their mind. 445.",
      "punjabiViakhya": "ਚਿਤ ਵਿਚ ਸ਼ਰਮਿੰਦੇ ਹਨ ॥੪੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "चागड़दं चितं लागड़दं लाजे ॥४४५॥",
      "sourceLineId": "99824",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਛਾਗੜਦੰ ਛੋਰਿਓ ਰਾਗੜਦੰ ਰਾਜੰ ॥",
      "transliteration": "chhaagaRadha(n) chhorio raagaRadha(n) raaja(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਲਕੀ ਨੇ ਸੰਭਲ ਦੇ) ਰਾਜੇ ਨੂੰ ਛਡ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "छागड़दं छोरिओ रागड़दं राजं ॥",
      "sourceLineId": "99825",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0595_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਾਗੜਦੰ ਸੈਣੰ ਭਾਗੜਦੰ ਭਾਜਾ ॥",
      "transliteration": "saagaRadha(n) saina(n) bhaagaRadha(n) bhaajaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਸੈਨਾ ਭਜ ਚਲੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 595,
      "hindi": "",
      "hindiTransliteration": "सागड़दं सैणं भागड़दं भाजा ॥",
      "sourceLineId": "99826",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
