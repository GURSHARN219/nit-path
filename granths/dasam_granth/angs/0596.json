{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 596,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0596_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਛਾਗੜਦੰ ਛੂਟੇ ਬਾਗੜਦੰ ਬਾਣੰ ॥",
      "transliteration": "chhaagaRadha(n) chhooTe baagaRadha(n) baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣ ਛੁਟ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "छागड़दं छूटे बागड़दं बाणं ॥",
      "sourceLineId": "99827",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਾਗੜਦੰ ਰੋਕੀ ਦਾਗੜਦੰ ਦਿਸਾਣੰ ॥੪੪੬॥",
      "transliteration": "raagaRadha(n) rokee dhaagaRadha(n) dhisaana(n) ||446||",
      "translation": "The king was released and he ran away alongwith his army, with the discharge of arrows all the directions were covered.446.",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਦਿਸ਼ਾਵਾ ਰੋਕ ਦਿੱਤੀਆਂ ਹਨ ॥੪੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "रागड़दं रोकी दागड़दं दिसाणं ॥४४६॥",
      "sourceLineId": "99828",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਾਗੜਦੰ ਮਾਰੇ ਬਾਗੜਦੰ ਬਾਣੰ ॥",
      "transliteration": "maagaRadha(n) maare baagaRadha(n) baana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣ ਮਾਰੇ ਜਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "मागड़दं मारे बागड़दं बाणं ॥",
      "sourceLineId": "99829",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਟਾਗੜਦੰ ਟੂਟੇ ਤਾਗੜਦੰ ਤਾਣੰ ॥",
      "transliteration": "TaagaRadha(n) TooTe taagaRadha(n) taana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਵੈਰੀ ਦਾ) ਤ੍ਰਾਣ ਟੁਟ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "टागड़दं टूटे तागड़दं ताणं ॥",
      "sourceLineId": "99830",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਲਾਗੜਦੰ ਲਾਗੇ ਦਾਗੜਦੰ ਦਾਹੇ ॥",
      "transliteration": "laagaRadha(n) laage dhaagaRadha(n) dhaahe ||",
      "translation": "",
      "punjabiViakhya": "(ਅਗਨੀ ਬਾਣਾ ਦੇ) ਲਗਣ ਨਾਲ ਸੜ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "लागड़दं लागे दागड़दं दाहे ॥",
      "sourceLineId": "99831",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਡਾਗੜਦੰ ਡਾਰੇ ਬਾਗੜਦੰ ਬਾਹੇ ॥੪੪੭॥",
      "transliteration": "ddaagaRadha(n) ddaare baagaRadha(n) baahe ||447||",
      "translation": "By discharging the arrows, the pride of all was mashed, with the infliction of arrows all the warriors were weakened, their weapons fell down from their hands.447.",
      "punjabiViakhya": "(ਬਾਕੀਆਂ ਨੂੰ) ਭਜਾ ਦਿੱਤਾ ਹੈ ॥੪੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "डागड़दं डारे बागड़दं बाहे ॥४४७॥",
      "sourceLineId": "99832",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਾਗੜਦੰ ਬਰਖੇ ਫਾਗੜਦੰ ਫੂਲੰ ॥",
      "transliteration": "baagaRadha(n) barakhe faagaRadha(n) foola(n) ||",
      "translation": "",
      "punjabiViakhya": "ਫੁਲਾ ਦੀ ਬਰਖਾ ਹੋ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "बागड़दं बरखे फागड़दं फूलं ॥",
      "sourceLineId": "99833",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮਾਗੜਦੰ ਮਿਟਿਓ ਸਾਗੜਦੰ ਸੂਲੰ ॥",
      "transliteration": "maagaRadha(n) miTio saagaRadha(n) soola(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੰਭਲ ਵਾਸੀਆਂ ਦਾ) ਦੁਖ ਮਿਟ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "मागड़दं मिटिओ सागड़दं सूलं ॥",
      "sourceLineId": "99834",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਾਗੜਦੰ ਮਾਰਿਓ ਭਾਗੜਦੰ ਭੂਪੰ ॥",
      "transliteration": "maagaRadha(n) maario bhaagaRadha(n) bhoopa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "मागड़दं मारिओ भागड़दं भूपं ॥",
      "sourceLineId": "99835",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਾਗੜਦੰ ਕੋਪੇ ਰਾਗੜਦੰ ਰੂਪੰ ॥੪੪੮॥",
      "transliteration": "kaagaRadha(n) kope raagaRadha(n) roopa(n) ||448||",
      "translation": "The flowers were showered from the sky and in this way, the trouble ended, the kalki incarnation in his fury, killed the king.448.",
      "punjabiViakhya": "(ਕਲਕੀ ਨੇ ਆਪਣਾ) ਰੂਪ ਕ੍ਰੋਧਿਤ ਕੀਤਾ ਹੋਇਆ ਹੈ ॥੪੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "कागड़दं कोपे रागड़दं रूपं ॥४४८॥",
      "sourceLineId": "99836",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਾਗੜਦੰ ਜੰਪੈ ਪਾਗੜਦੰ ਪਾਨੰ ॥",
      "transliteration": "jaagaRadha(n) ja(n)pai paagaRadha(n) paana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੈ-ਜੈ-ਕਾਰ ('ਪਾਨੰ') ਜਪਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "जागड़दं जंपै पागड़दं पानं ॥",
      "sourceLineId": "99837",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦਾਗੜਦੰ ਦੇਵੰ ਆਗੜਦੰ ਆਨੰ ॥",
      "transliteration": "dhaagaRadha(n) dheva(n) aagaRadha(n) aana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤੇ ਹਾਜ਼ਰ ਹੋ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "दागड़दं देवं आगड़दं आनं ॥",
      "sourceLineId": "99838",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਾਗੜਦੰ ਸਿਧੰ ਕਾਗੜਦੰ ਕ੍ਰਿਤ ॥",
      "transliteration": "saagaRadha(n) sidha(n) kaagaRadha(n) kirat ||",
      "translation": "",
      "punjabiViakhya": "ਸਿੱਧ ਲੋਕਾ ਨੇ (ਕਲਕੀ ਦੇ)",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "सागड़दं सिधं कागड़दं कृत ॥",
      "sourceLineId": "99839",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਾਗੜਦੰ ਬਨਾਏ ਕਾਗੜਦੰ ਕਬਿਤੰ ॥੪੪੯॥",
      "transliteration": "baagaRadha(n) banaae kaagaRadha(n) kabita(n) ||449||",
      "translation": "The gods came from the front and catching the feet of the Lord (Kalki) eulogized him, the adepts also composed epics in Praise of the Lord.449.",
      "punjabiViakhya": "ਯਸ਼ ਦੇ ਕਬਿਤ ਬਣਾਏ ਹਨ ॥੪੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "बागड़दं बनाए कागड़दं कबितं ॥४४९॥",
      "sourceLineId": "99840",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਾਗੜਦੰ ਗਾਵੈ ਕਾਗੜਦੰ ਕਬਿਤੰ ॥",
      "transliteration": "raagaRadha(n) gaavai kaagaRadha(n) kabita(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਚਾਰਣ ਲੋਕ) ਕਬਿਤਾ ਗਾਉਾਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "रागड़दं गावै कागड़दं कबितं ॥",
      "sourceLineId": "99841",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਧਾਗੜਦੰ ਧਾਵੈ ਬਾਗੜਦੰ ਬਿਤ੍ਰੰ ॥",
      "transliteration": "dhaagaRadha(n) dhaavai baagaRadha(n) bitra(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੇਵਕ ਜਾ ਲਾਗੀ ('ਬ੍ਰਿਤੰ') ਭਜੇ ਆ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "धागड़दं धावै बागड़दं बित्रं ॥",
      "sourceLineId": "99842",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਾਗੜਦੰ ਹੋਹੀ ਜਾਗੜਦੰ ਜਾਤ੍ਰਾ ॥",
      "transliteration": "haagaRadha(n) hohee jaagaRadha(n) jaatraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਵਲੋਂ ਕਲਕੀ ਦੇ) ਦਰਸ਼ਨ ('ਜਾਤ੍ਰਾ') ਹੋ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "हागड़दं होही जागड़दं जात्रा ॥",
      "sourceLineId": "99843",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਗੜਦੰ ਨਾਚੈ ਪਾਗੜਦੰ ਪਾਤ੍ਰਾ ॥੪੫੦॥",
      "transliteration": "naagaRadha(n) naachai paagaRadha(n) paatraa ||450||",
      "translation": "For eulogizing the Lord, the epics were sung and the praise of the Lord spread in all the four sides, the pious people began pilgrimages and the true devotees of the Lord began to dance.450.",
      "punjabiViakhya": "ਨਟੀਆਂ (ਅਪੱਛਰਾਵਾ) ਨਚ ਰਹੀਆਂ ਹਨ ॥੪੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "नागड़दं नाचै पागड़दं पात्रा ॥४५०॥",
      "sourceLineId": "99844",
      "sourceShabadId": "9251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪਾਧਰੀ ਛੰਦ ॥",
      "transliteration": "paadharee chha(n)dh ||",
      "translation": "PAADHARI STANZA",
      "punjabiViakhya": "ਪਾਧਰੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "पाधरी छंद ॥",
      "sourceLineId": "99845",
      "sourceShabadId": "9252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੰਭਰ ਨਰੇਸ ਮਾਰਿਓ ਨਿਦਾਨ ॥",
      "transliteration": "sa(n)bhar nares maario nidhaan ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਤ ਨੂੰ ਸੰਭਲ ਦਾ ਰਾਜਾ ਮਾਰਿਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "संभर नरेस मारिओ निदान ॥",
      "sourceLineId": "99846",
      "sourceShabadId": "9252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਢੋਲੰ ਮਿਦੰਗ ਬਜੇ ਪ੍ਰਮਾਨ ॥",
      "transliteration": "ddola(n) midha(n)g baje pramaan ||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲ ਅਤੇ ਨਗਾਰੇ ਮਰਯਾਦਾ ਪੂਰਵਕ ('ਪ੍ਰਮਾਨ') ਵਜਾਏ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "ढोलं मिदंग बजे प्रमान ॥",
      "sourceLineId": "99847",
      "sourceShabadId": "9252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਭਾਜੇ ਸੁਬੀਰ ਤਜਿ ਜੁਧ ਤ੍ਰਾਸਿ ॥",
      "transliteration": "bhaaje subeer taj judh traas ||",
      "translation": "",
      "punjabiViakhya": "ਡਰ ਦੇ ਮਾਰੇ ਯੁੱਧ ਛਡ ਕੇ ਸੂਰਮੇ ਭਜੇ ਜਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "भाजे सुबीर तजि जुध त्रासि ॥",
      "sourceLineId": "99848",
      "sourceShabadId": "9252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਜਿ ਸਸਤ੍ਰ ਸਰਬ ਹ੍ਵੈ ਚਿਤਿ ਨਿਰਾਸ ॥੪੫੧॥",
      "transliteration": "taj sasatr sarab havai chit niraas ||451||",
      "translation": "Ultimately, the king of Sambhal was killed, the small and large drums sounded, the warriors, frightened of war ran away and getting disappointed, they abandoned all the weapons.451.",
      "punjabiViakhya": "ਚਿਤ ਵਿਚ ਨਿਰਾਸ ਹੋ ਕੇ ਸਬ ਨੇ ਸ਼ਸਤ੍ਰ ਛਡ ਦਿੱਤੇ ਹਨ ॥੪੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "तजि ससत्र सरब ह्वै चिति निरास ॥४५१॥",
      "sourceLineId": "99849",
      "sourceShabadId": "9252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਰਖੰਤ ਦੇਵ ਪੁਹਪਣ ਬ੍ਰਿਸਟ ॥",
      "transliteration": "barakha(n)t dhev puhapan birasaT ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤੇ ਫੁਲਾ ਦੀ ਬਰਖਾ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "बरखंत देव पुहपण बृसट ॥",
      "sourceLineId": "99850",
      "sourceShabadId": "9252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹੋਵੰਤ ਜਗ ਜਹ ਤਹ ਸੁ ਇਸਟ ॥",
      "transliteration": "hova(n)t jag jeh teh su isaT ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ (ਆਪਣੇ ਆਪਣੇ) ਇਸ਼ਟ ਅਨੁਸਾਰ ਯੱਗ ਹੋਣ ਲਗੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "होवंत जग जह तह सु इसट ॥",
      "sourceLineId": "99851",
      "sourceShabadId": "9252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪੂਜੰਤ ਲਾਗ ਦੇਵੀ ਕਰਾਲ ॥",
      "transliteration": "pooja(n)t laag dhevee karaal ||",
      "translation": "",
      "punjabiViakhya": "ਭਿਆਨਕ ਦੇਵੀ ਦੀ ਪੂਜਾ ਵਿਚ ਲਗ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "पूजंत लाग देवी कराल ॥",
      "sourceLineId": "99852",
      "sourceShabadId": "9252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹੋਵੰਤ ਸਿਧ ਕਾਰਜ ਸੁ ਢਾਲ ॥੪੫੨॥",
      "transliteration": "hova(n)t sidh kaaraj su ddaal ||452||",
      "translation": "The gods showered flowers and everywhere the patron-god was worshipped, the people adored the dreadful goddess and many works were finalized.452.",
      "punjabiViakhya": "ਚੰਗੀ ਤਰ੍ਰਹਾ ਸਾਰੇ ਕਾਰਜ ਸਿੱਧ ਹੋ ਗਏ ਹਨ ॥੪੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "होवंत सिध कारज सु ढाल ॥४५२॥",
      "sourceLineId": "99853",
      "sourceShabadId": "9252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪਾਵੰਤ ਦਾਨ ਜਾਚਕ ਦੁਰੰਤ ॥",
      "transliteration": "paava(n)t dhaan jaachak dhura(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਬੇਸ਼ੁਮਾਰ ('ਦੁਰੰਤ') ਮੰਗਤੇ ਦਾਨ ਪ੍ਰਾਪਤ ਕਰ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "पावंत दान जाचक दुरंत ॥",
      "sourceLineId": "99854",
      "sourceShabadId": "9252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭਾਖੰਤ ਕ੍ਰਿਤ ਜਹ ਤਹ ਬਿਅੰਤ ॥",
      "transliteration": "bhaakha(n)t kirat jeh teh bia(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਬੇਅੰਤ (ਲੋਕ) ਯਸ਼ (ਕੀਰਤੀ) ਗਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "भाखंत कृत जह तह बिअंत ॥",
      "sourceLineId": "99855",
      "sourceShabadId": "9252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਗ ਧੂਪ ਦੀਪ ਜਗਿ ਆਦਿ ਦਾਨ ॥",
      "transliteration": "jag dhoop dheep jag aadh dhaan ||",
      "translation": "",
      "punjabiViakhya": "ਜਗਤ ਵਿਚ ਧੂਪ, ਦੀਪ, ਦਾਨ ਅਤੇ ਯੱਗ ਆਦਿ (ਹੋਣ ਲਗ ਗਏ ਹਨ)",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "जग धूप दीप जगि आदि दान ॥",
      "sourceLineId": "99856",
      "sourceShabadId": "9252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹੋਵੰਤ ਹੋਮ ਬੇਦਨ ਬਿਧਾਨ ॥੪੫੩॥",
      "transliteration": "hova(n)t hom bedhan bidhaan ||453||",
      "translation": "The beggars received charity and everywhere the poems were composed, the Yajnas, burning of incense, lighting of lamps, the charities etc. were all done according to vedic rites.453.",
      "punjabiViakhya": "ਅਤੇ ਵੇਦ ਰੀਤੀ ਅਨੁਸਾਰ ਹੋਮ ਹੋਣ ਲਗ ਗਏ ਹਨ ॥੪੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "होवंत होम बेदन बिधान ॥४५३॥",
      "sourceLineId": "99857",
      "sourceShabadId": "9252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪੂਜੰਤ ਲਾਗ ਦੇਬੀ ਦੁਰੰਤ ॥",
      "transliteration": "pooja(n)t laag dhebee dhura(n)t ||",
      "translation": "",
      "punjabiViakhya": "(ਲੋਕੀਂ) ਪ੍ਰਚੰਡ ਦੇਵੀ ਦੀ ਪੂਜਾ ਕਰਨ ਲਗ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "पूजंत लाग देबी दुरंत ॥",
      "sourceLineId": "99858",
      "sourceShabadId": "9252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਜਿ ਸਰਬ ਕਾਮ ਜਹ ਤਹ ਮਹੰਤ ॥",
      "transliteration": "taj sarab kaam jeh teh maha(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਮਹੰਤਾ ਨੇ ਜਿਥੇ ਕਿਥੇ ਸਾਰੇ ਕਰਮ ਕਾਡ ਛਡ ਦਿੱਤੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "तजि सरब काम जह तह महंत ॥",
      "sourceLineId": "99859",
      "sourceShabadId": "9252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਾਧੀ ਧੁਜਾਨ ਪਰਮੰ ਪ੍ਰਚੰਡ ॥",
      "transliteration": "baadhee dhujaan parama(n) pracha(n)dd ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਡੇ ਝੰਡੇ (ਮੰਦਿਰਾ) ਉਤੇ ਬੰਨ੍ਰਹ ਦਿੱਤੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "बाधी धुजान परमं प्रचंड ॥",
      "sourceLineId": "99860",
      "sourceShabadId": "9252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪ੍ਰਚੁਰਿਓ ਸੁ ਧਰਮ ਖੰਡੇ ਅਖੰਡ ॥੪੫੪॥",
      "transliteration": "prachurio su dharam kha(n)dde akha(n)dd ||454||",
      "translation": "The heads of hermitages, leaving all other works, worshipped the goddess, the powerful goddess was established again and in this way, there was propagation of the perfect Dharma.454.",
      "punjabiViakhya": "ਪ੍ਰਚੰਡ ਸੂਰਮਿਆਂ ਨੂੰ ਮਾਰ ਕੇ (ਸੱਚੇ) ਧਰਮ ਦਾ ਬਹੁਤ ਪ੍ਰਚਾਰ ਹੋ ਰਿਹਾ ਹੈ ॥੪੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "प्रचुरिओ सु धरम खंडे अखंड ॥४५४॥",
      "sourceLineId": "99861",
      "sourceShabadId": "9252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਕਲਕੀ ਅਵਤਾਰ ਸੰਭਰ ਨਰੇਸ ਬਧਹ ਬਿਜਯ ਭਏਤ ਨਾਮ ਪ੍ਰਥਮ ਧਿਆਇ ਬਰਨਨੰ ਸਮਾਪਤੰ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the kalakee avataar sa(n)bhar nares badheh bijay bhet naam pratham dhiaai baranana(n) samaapata(n) sat subham sat ||1||",
      "translation": "End of the chapter entitled “the Kalki Incarnation after killing the king of Sambhal becomes victorious-the description of the war of Sambhal” Bachittar Natak.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ ਕਲਕੀ ਅਵਤਾਰ ਦੀ ਵਿਜੈ ਅਤੇ ਸੰਭਰ ਦੇ ਰਾਜੇ ਦੇ ਬਧ ਦਾ ਵਰਣਨ ਨਾ ਵਾਲੇ ਪਹਿਲੇ ਅਧਿਆਇ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे कलकी अवतार संभर नरेस बधह बिजय भएत नाम प्रथम धिआइ बरननं समापतं सतु सुभम सतु ॥१॥",
      "sourceLineId": "99862",
      "sourceShabadId": "9252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਥ ਦੇਸੰਤਰ ਜੁਧ ਕਥਨੰ ॥",
      "transliteration": "ath dhesa(n)tar judh kathana(n) ||",
      "translation": "Now begins the description of war with various countries.",
      "punjabiViakhya": "ਹੁਣ ਹੋਰਾ ਦੇਸਾ ਵਿਚ ਹੋਏ ਯੁੱਧ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "अथ देसंतर जुध कथनं ॥",
      "sourceLineId": "99863",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "99864",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹਣ੍ਯੋ ਸੰਭਰੇਸੰ ॥",
      "transliteration": "hanayo sa(n)bharesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਭਰ (ਸੰਭਲ) ਦਾ ਰਾਜਾ ਮਾਰਿਆ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "हण्यो संभरेसं ॥",
      "sourceLineId": "99865",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚਤੁਰ ਚਾਰੁ ਦੇਸੰ ॥",
      "transliteration": "chatur chaar dhesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਦਾ ਲੋਕਾ ਵਿਚ",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "चतुर चारु देसं ॥",
      "sourceLineId": "99866",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚਲੀ ਧਰਮ ਚਰਚਾ ॥",
      "transliteration": "chalee dharam charachaa ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਮ ਦੀ ਚਰਚਾ ਚਲ ਪਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "चली धरम चरचा ॥",
      "sourceLineId": "99867",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਰੈ ਕਾਲ ਅਰਚਾ ॥੪੫੫॥",
      "transliteration": "karai kaal arachaa ||455||",
      "translation": "The king of Sambhal was killed and there was discussion regarding dharma in all the four directions, people made offerings to Kalki.455.",
      "punjabiViakhya": "ਸ੍ਰੀ ਕਾਲ ਦੀ ਪੂਜਾ ਹੋਣ ਲਗ ਗਈ ਹੈ ॥੪੫੫॥",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "करै काल अरचा ॥४५५॥",
      "sourceLineId": "99868",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਿਤਿਓ ਦੇਸ ਐਸੇ ॥",
      "transliteration": "jitio dhes aaise ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਸਾਰਾ ਦੇਸ ਜਿਤਿਆ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "जितिओ देस ऐसे ॥",
      "sourceLineId": "99869",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੜਿਓ ਕੋਪ ਕੈਸੇ ॥",
      "transliteration": "chaRio kop kaise ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ ਕਲਕੀ ਅਵਤਾਰ) ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਕਿਸ ਤਰ੍ਰਹਾ ਚੜ੍ਰਹਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "चड़िओ कोप कैसे ॥",
      "sourceLineId": "99870",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬੁਲਿਓ ਸਰਬ ਸੈਣੰ ॥",
      "transliteration": "bulio sarab saina(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸਾਰੀ ਸੈਨਾ ਬੁਲਾ ਲਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "बुलिओ सरब सैणं ॥",
      "sourceLineId": "99871",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਰੇ ਰਕਤ ਨੈਣੰ ॥੪੫੬॥",
      "transliteration": "kare rakat naina(n) ||456||",
      "translation": "While the whole of the country was conquered, kalki got infuriated and he reddening his eyes, called all his army.456.",
      "punjabiViakhya": "ਅਤੇ ਅੱਖਾ ਨੂੰ ਲਾਲ ਕੀਤਾ ਹੋਇਆ ਹੈ ॥੪੫੬॥",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "करे रकत नैणं ॥४५६॥",
      "sourceLineId": "99872",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦਈ ਜੀਤ ਬੰਬੰ ॥",
      "transliteration": "dhiee jeet ba(n)ba(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਤ ਦਾ ਨਗਾਰਾ ਵਜਾਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 596,
      "hindi": "",
      "hindiTransliteration": "दई जीत बंबं ॥",
      "sourceLineId": "99873",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0596_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗਡਿਓ ਜੁਧ ਖੰਭੰ ॥",
      "transliteration": "gaddio judh kha(n)bha(n) ||",
      "translation": "",
