{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 597,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0597_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚਮੂੰ ਚਉਪਿ ਚਾਲੀ ॥",
      "transliteration": "chamoo(n) chaup chaalee ||",
      "translation": "",
      "punjabiViakhya": "ਸੈਨਾ ਉਤਸਾਹ ਪੂਰਵਕ ਚਲ ਪਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "चमूँ चउपि चाली ॥",
      "sourceLineId": "99875",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਥਿਰਾ ਸਰਬ ਹਾਲੀ ॥੪੫੭॥",
      "transliteration": "thiraa sarab haalee ||457||",
      "translation": "He sounded the horn of victory and he planted the column of war again, the whole army in great zeal, marched forward and the whole earth trembled.457.",
      "punjabiViakhya": "ਸਾਰੀ ਧਰਤੀ ('ਥਿਰਾ') ਡੋਲ ਗਈ ਹੈ ॥੪੫੭॥",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "थिरा सरब हाली ॥४५७॥",
      "sourceLineId": "99876",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਉਠੀ ਕੰਪਿ ਐਸੇ ॥",
      "transliteration": "auThee ka(n)p aaise ||",
      "translation": "",
      "punjabiViakhya": "(ਧਰਤੀ) ਇਸ ਤਰ੍ਰਹਾ ਕੰਬ ਉਠੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "उठी कंपि ऐसे ॥",
      "sourceLineId": "99877",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਦੰ ਨਾਵ ਜੈਸੇ ॥",
      "transliteration": "nadha(n) naav jaise ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਨਦੀ ਵਿਚ ਨੌਕਾ (ਡੋਲਦੀ ਹੈ)।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "नदं नाव जैसे ॥",
      "sourceLineId": "99878",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚੜੇ ਚਉਪ ਸੂਰੰ ॥",
      "transliteration": "chaRe chaup soora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਨੂੰ ਉਤਸਾਹ ਚੜ੍ਰਹਿਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "चड़े चउप सूरं ॥",
      "sourceLineId": "99879",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਹਿਓ ਧੂਰ ਪੂਰੰ ॥੪੫੮॥",
      "transliteration": "rahio dhoor poora(n) ||458||",
      "translation": "The earth trembled like the boat in water, the warriors moved with great excitement and the atmosphere was filled with dust on all the sides.458.",
      "punjabiViakhya": "(ਪੈਰਾ ਦੀ) ਧੂੜ ਨਾਲ ਆਕਾਸ਼ ਪੂਰਿਆ ਹੋਇਆ ਹੈ ॥੪੫੮॥",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "रहिओ धूर पूरं ॥४५८॥",
      "sourceLineId": "99880",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਛੁਭੇ ਛਤ੍ਰਧਾਰੀ ॥",
      "transliteration": "chhubhe chhatradhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਛਤ੍ਰਧਾਰੀ (ਰਾਜੇ) ਕ੍ਰੋਧਵਾਨ ਹੋ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "छुभे छत्रधारी ॥",
      "sourceLineId": "99881",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਣੀ ਜੋੜਿ ਭਾਰੀ ॥",
      "transliteration": "anee joR bhaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਭਾਰੀ ਸੈਨਾ ਇਕੱਠੀ ਕਰ ਲਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "अणी जोड़ि भारी ॥",
      "sourceLineId": "99882",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਚਲੇ ਕੋਪਿ ਐਸੇ ॥",
      "transliteration": "chale kop aaise ||",
      "translation": "",
      "punjabiViakhya": "(ਕਲਕੀ ਅਵਤਾਰ ਉਪਰ) ਇਸ ਤਰ੍ਰਹਾ ਚੜ੍ਰਹ ਚਲੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "चले कोपि ऐसे ॥",
      "sourceLineId": "99883",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬ੍ਰਿਤੰ ਇੰਦ੍ਰ ਜੈਸੇ ॥੪੫੯॥",
      "transliteration": "birata(n) i(n)dhr jaise ||459||",
      "translation": "All those who had canopies over their heads, got infuriated, taking with them all their armies, in anger, they marched like Indra or Vritasura.459.",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਵਿਤ੍ਰਾਸੁਰ ਇੰਦਰ ਉਤੇ (ਚੜ੍ਰਹਿਆ ਸੀ) ॥੪੫੯॥",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "बृतं इंद्र जैसे ॥४५९॥",
      "sourceLineId": "99884",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੁਭੈ ਸਰਬ ਸੈਣੰ ॥",
      "transliteration": "subhai sarab saina(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਸੈਨਾ ਸੋਭ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "सुभै सरब सैणं ॥",
      "sourceLineId": "99885",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਥੈ ਕੌਣ ਬੈਣੰ ॥",
      "transliteration": "kathai kauan baina(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਕੌਣ ਵਰਣਨ ਕਰ ਸਕਦਾ ਹੈ?",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "कथै कौण बैणं ॥",
      "sourceLineId": "99886",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚਲੀ ਸਾਜਿ ਸਾਜਾ ॥",
      "transliteration": "chalee saaj saajaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਜਾ ਨੂੰ ਸਜਾ ਕੇ (ਸੈਨਾ) ਚਲੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "चली साजि साजा ॥",
      "sourceLineId": "99887",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਜੈ ਜੀਤ ਬਾਜਾ ॥੪੬੦॥",
      "transliteration": "bajai jeet baajaa ||460||",
      "translation": "The glory of their armies is indescribable, all of them marched after bedcking themselves and the instruments of victory were played.460.",
      "punjabiViakhya": "ਅਤੇ ਜਿਤ ਦੇ ਵਾਜੇ ਵਜ ਰਹੇ ਹਨ ॥੪੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "बजै जीत बाजा ॥४६०॥",
      "sourceLineId": "99888",
      "sourceShabadId": "9253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "99889",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਿਣੇ ਗਖਰੀ ਪਖਰੀ ਖਗਧਾਰੀ ॥",
      "transliteration": "jine gakharee pakharee khagadhaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਤਨੇ ਵੀ) ਗਖੜ, ਪਖੜ ਤਲਵਾਰਾ ਧਾਰਨ ਕਰਨ ਵਾਲੇ ਸਨ (ਉਹ) ਜਿਤੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "जिणे गखरी पखरी खगधारी ॥",
      "sourceLineId": "99890",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਣੇ ਪਖਰੀ ਭਖਰੀ ਔ ਕੰਧਾਰੀ ॥",
      "transliteration": "hane pakharee bhakharee aau ka(n)dhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਪਖੜ, ਭਖਰ ਅਤੇ ਕੰਧਾਰ (ਦੇਸ਼ ਵਾਲੇ) ਮਾਰ ਦਿੱਤੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "हणे पखरी भखरी औ कंधारी ॥",
      "sourceLineId": "99891",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੁਰਜਿਸਤਾਨ ਗਾਜੀ ਰਜੀ ਰੋਹਿ ਰੂਮੀ ॥",
      "transliteration": "gurajisataan gaajee rajee roh roomee ||",
      "translation": "",
      "punjabiViakhya": "ਗੁਰਜਿਸਤਾਨ ਦੇ ਗਾਜ਼ੀਆਂ, ਰਜੀ, ਰੋਹ ਵਾਲੇ ਰੂਮੀ ਸੂਰਮਿਆਂ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "गुरजिसतान गाजी रजी रोहि रूमी ॥",
      "sourceLineId": "99892",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹਣੇ ਸੂਰ ਬੰਕੇ ਗਿਰੇ ਝੂਮਿ ਭੂਮੀ ॥੪੬੧॥",
      "transliteration": "hane soor ba(n)ke gire jhoom bhoomee ||461||",
      "translation": "Many bloody and great sword-wielders and armour-wearers were conquered, many Kandhari warriors, wearing large steel-armours, were destroyed, many elegant warriors of Rum country were killed and those great warriors swung and fell on the earth.461.",
      "punjabiViakhya": "ਅਤੇ ਬਾਕੇ (ਯੋਧੇ) ਧਰਤੀ ਉਤੇ ਘੁੰਮੇਰੀ ਖਾ ਕੇ ਡਿਗ ਪਏ ਹਨ ॥੪੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "हणे सूर बंके गिरे झूमि भूमी ॥४६१॥",
      "sourceLineId": "99893",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹਣੇ ਕਾਬੁਲੀ ਬਾਬਲੀ ਬੀਰ ਬਾਕੇ ॥",
      "transliteration": "hane kaabulee baabalee beer baake ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਬਲ ਦੇਸ ਦੇ, ਬਾਬਰ ਦੇ ਦੇਸ ਦੇ ਸੋਹਣੇ ਸੂਰਮੇ ਮਾਰ ਦਿੱਤੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "हणे काबुली बाबली बीर बाके ॥",
      "sourceLineId": "99894",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕੰਧਾਰੀ ਹਰੇਵੀ ਇਰਾਕੀ ਨਿਸਾਕੇ ॥",
      "transliteration": "ka(n)dhaaree harevee iraakee nisaake ||",
      "translation": "",
      "punjabiViakhya": "ਕੰਧਾਰ, ਹਿਰਾਤ, ਇਰਾਕ ਦੇ ਨਿਸੰਗ ਯੋਧੇ;",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "कंधारी हरेवी इराकी निसाके ॥",
      "sourceLineId": "99895",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਲੀ ਬਾਲਖੀ ਰੋਹਿ ਰੂਮੀ ਰਜੀਲੇ ॥",
      "transliteration": "balee baalakhee roh roomee rajeele ||",
      "translation": "",
      "punjabiViakhya": "ਬਲਖ ਦੇਸ ਦੇ ਬਲੀ ਰੋਹ ਵਾਲੇ, ਰੂਮ ਦੇਸ਼ ਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "बली बालखी रोहि रूमी रजीले ॥",
      "sourceLineId": "99896",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭਜੇ ਤ੍ਰਾਸ ਕੈ ਕੈ ਭਏ ਬੰਦ ਢੀਲੇ ॥੪੬੨॥",
      "transliteration": "bhaje traas kai kai bhe ba(n)dh ddeele ||462||",
      "translation": "The warriors of Kabul, Babylonia, Kandhar, Iraq and Balkh were destroyed an d they all, getting fearful, fled away.462.",
      "punjabiViakhya": "ਕਠੋਰ ਯੋਧੇ ਡਰ ਕੇ ਭਜ ਚਲੇ ਹਨ ਅਤੇ ਉਨ੍ਰਹਾ ਦੇ ਕਮਰ। ਕੱਸੇ ਢਿਲੇ ਹੋ ਗਏ ਹਨ ॥੪੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "भजे त्रास कै कै भए बंद ढीले ॥४६२॥",
      "sourceLineId": "99897",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਜੇ ਅਸਤ੍ਰ ਸਸਤ੍ਰੰ ਸਜੇ ਨਾਰਿ ਭੇਸੰ ॥",
      "transliteration": "taje asatr sasatra(n) saje naar bhesa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਅਸਤ੍ਰਾ ਅਤੇ ਸ਼ਸਤ੍ਰਾ ਨੂੰ ਛਡ ਦਿੱਤਾ ਹੈ ਅਤੇ ਔਰਤਾ ਦੇ ਬਸਤ੍ਰ ਸਜਾ ਲਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "तजे असत्र ससत्रं सजे नारि भेसं ॥",
      "sourceLineId": "99898",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਲਜੈ ਬੀਰ ਧੀਰੰ ਚਲੇ ਛਾਡਿ ਦੇਸੰ ॥",
      "transliteration": "lajai beer dheera(n) chale chhaadd dhesa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਧੀਰਜ ਵਾਲੇ ਸੂਰਮੇ ਸ਼ਰਮਿੰਦੇ ਹੋ ਕੇ ਦੇਸਾ ਨੂੰ ਛਡ ਚਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "लजै बीर धीरं चले छाडि देसं ॥",
      "sourceLineId": "99899",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗਜੀ ਬਾਜਿ ਗਾਜੀ ਰਥੀ ਰਾਜ ਹੀਣੰ ॥",
      "transliteration": "gajee baaj gaajee rathee raaj heena(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਥੀਆਂ ਉਤੇ ਚੜ੍ਰਹਨ ਵਾਲੇ ਗਾਜ਼ੀ, ਘੋੜਿਆਂ ਦੇ ਸਵਾਰ ਅਤੇ ਰਥਾ ਵਾਲੇ ਰਾਜਾ ਤੋਂ ਵਾਝੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "गजी बाजि गाजी रथी राज हीणं ॥",
      "sourceLineId": "99900",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਜੈ ਬੀਰ ਧੀਰੰ ਭਏ ਅੰਗ ਛੀਣੰ ॥੪੬੩॥",
      "transliteration": "tajai beer dheera(n) bhe a(n)g chheena(n) ||463||",
      "translation": "The warriors, abandoning their arms and weapons, assumed the garb of women and getting ashamed, left their own country, the elephant-riders, the horse-riders and chariot-riders were deprived of their kingdom and the warriors forsaking forbearance, became",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਨੇ ਧੀਰਜ ਛਡ ਦਿੱਤਾ ਹੈ ਅਤੇ ਉਨ੍ਰਹਾ ਦੇ ਸ਼ਰੀਰ ਢਿਲੇ ਹੋ ਗਏ ਹਨ ॥੪੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "तजै बीर धीरं भए अंग छीणं ॥४६३॥",
      "sourceLineId": "99901",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭਜੇ ਹਾਬਸੀ ਹਾਲਬੀ ਕਉਕ ਬੰਦ੍ਰੀ ॥",
      "transliteration": "bhaje haabasee haalabee kauk ba(n)dhree ||",
      "translation": "",
      "punjabiViakhya": "ਹਬਸ਼ ਦੇਸ ਦੇ, ਹਲਬ ਦੇਸ ਦੇ, ਕੋਕ ਬੰਦਰ (ਮਹਾਰਾਸ਼ਟਰ) ਦੇ ਰਹਿਣ ਵਾਲੇ ਭਜ ਤੁਰੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "भजे हाबसी हालबी कउक बंद्री ॥",
      "sourceLineId": "99902",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਚਲੇ ਬਰਬਰੀ ਅਰਮਨੀ ਛਾਡਿ ਤੰਦ੍ਰੀ ॥",
      "transliteration": "chale barabaree aramanee chhaadd ta(n)dhree ||",
      "translation": "",
      "punjabiViakhya": "ਬਰਬਰ (ਜੰਗਲੀ) ਦੇਸ ਵਾਲੇ, ਆਰਮੀਨੀਆ ਦੇਸ ਵਾਲੇ (ਆਪਣੇ) ਰਾਜਾ ('ਤੰਦ੍ਰੀ') ਨੂੰ ਛਡ ਕੇ ਤੁਰ ਚਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "चले बरबरी अरमनी छाडि तंद्री ॥",
      "sourceLineId": "99903",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਖੁਲਿਓ ਖਗ ਖੂਨੀ ਤਹਾ ਏਕ ਗਾਜੀ ॥",
      "transliteration": "khulio khag khoonee tahaa ek gaajee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਬਹਾਦਰ ਸੂਰਮੇ ਨੇ ਖੂਨੀ ਖੰਡਾ ਕਢ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "खुलिओ खग खूनी तहा एक गाजी ॥",
      "sourceLineId": "99904",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦੁਹੂੰ ਸੈਣ ਮਧੰ ਨਚਿਓ ਜਾਇ ਤਾਜੀ ॥੪੬੪॥",
      "transliteration": "dhuhoo(n) sain madha(n) nachio jai taajee ||464||",
      "translation": "The negroes and people of other countries fled away, and in the same way, the barbarians of Armenia also ran away, there one of the warriors taking out his sword, caused his horse to dance between both the armies.464.",
      "punjabiViakhya": "ਦੋਹਾ ਸੈਨਾਵਾ ਦੇ ਵਿਚਾਲੇ ਉਸ ਦਾ ਘੋੜਾ ਜਾ ਕੇ ਨਚਿਆ ਹੈ ॥੪੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "दुहूँ सैण मधं नचिओ जाइ ताजी ॥४६४॥",
      "sourceLineId": "99905",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਲਖਿਓ ਜੁਧ ਜੰਗੀ ਮਹਾ ਜੰਗ ਕਰਤਾ ॥",
      "transliteration": "lakhio judh ja(n)gee mahaa ja(n)g karataa ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਵਿਚ ਯੋਧਿਆਂ ਨੇ ਉਸ (ਕਲਕੀ) ਨੂੰ ਮਹਾਨ ਜੰਗ ਕਰਨ ਵਾਲਾ ਜਾਣਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "लखिओ जुध जंगी महा जंग करता ॥",
      "sourceLineId": "99906",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਛੁਭਿਓ ਛਤ੍ਰਧਾਰੀ ਰਣੰ ਛਤ੍ਰਿ ਹਰਤਾ ॥",
      "transliteration": "chhubhio chhatradhaaree rana(n) chhatr harataa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ (ਯੁੱਧ ਵਿਚ) ਛਤ੍ਰਧਾਰੀਆਂ ਦੇ ਛਤ੍ਰਾ ਨੂੰ ਹਰਨ ਵਾਲਾ (ਇਸ ਸਮੇਾਂ) ਭੜਕਿਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "छुभिओ छत्रधारी रणं छतृ हरता ॥",
      "sourceLineId": "99907",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦੁਰੰ ਦੁਰਦਗਾਮੀ ਦਲੰ ਜੁਧ ਜੇਤਾ ॥",
      "transliteration": "dhura(n) dhuradhagaamee dhala(n) judh jetaa ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਥੀਆਂ ਦੀ ਸਵਾਰੀ ਕਰਨ ਵਾਲੇ ('ਦੁਰਦਗਾਮੀ') ਅਤੇ ਯੁੱਧ ਵਿਚ ਦਲਾ ਨੂੰ ਜਿਤਣ ਵਾਲੇ (ਸੂਰਮੇ ਵੀ) ਲੁਕ ('ਦੁਰੰ') ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "दुरं दुरदगामी दलं जुध जेता ॥",
      "sourceLineId": "99908",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਛੁਭੇ ਛਤ੍ਰਿ ਹੰਤਾ ਜਯੰ ਜੁਧ ਹੇਤਾ ॥੪੬੫॥",
      "transliteration": "chhubhe chhatr ha(n)taa jaya(n) judh hetaa ||465||",
      "translation": "The Lord, the Great Creator of the wars saw all this and the destroyer of the great canopied-kings, the Lord (Kalki) became enraged, that Lord was the conqueror of the noteworthy most tyrannical armies and he got terrible infuriated.465.",
      "punjabiViakhya": "ਛਤ੍ਰਾ ਵਾਲਿਆਂ ਨੂੰ ਮਾਰਨ ਵਾਲੇ ਅਤੇ ਯੁੱਧ ਵਿਚ ਵਿਜੈ ਦਾ ਕਾਰਨ ਸਰੂਪ (ਕਲਕੀ) ਭੜਕੇ ਹੋਏ ਹਨ ॥੪੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "छुभे छतृ हंता जयं जुध हेता ॥४६५॥",
      "sourceLineId": "99909",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮਹਾ ਕ੍ਰੋਧ ਕੈ ਬਾਣ ਛਡੇ ਅਪਾਰੰ ॥",
      "transliteration": "mahaa krodh kai baan chhadde apaara(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਬਹੁਤ ਕ੍ਰੋਧ ਕਰ ਕੇ ਅਣਗਿਣਤ ਬਾਣ ਛਡੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "महा क्रोध कै बाण छडे अपारं ॥",
      "sourceLineId": "99910",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਟੇ ਟਟਰੰ ਫਉਜ ਫੁਟੀ ਨ੍ਰਿਪਾਰੰ ॥",
      "transliteration": "kaTe TaTara(n) fauj fuTee nirapaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਢਾਲਾ (ਅਥਵਾ ਸਿਰਾ ਦੇ ਟੋਪ) ਕਟੇ ਗਏ ਹਨ ਅਤੇ ਰਾਜਿਆਂ ਦੀ ਸੈਨਾ ਖਿੰਡ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "कटे टटरं फउज फुटी नृपारं ॥",
      "sourceLineId": "99911",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਗਿਰੀ ਲੁਥ ਜੁਥੰ ਮਿਲੇ ਹਥ ਬਥੰ ॥",
      "transliteration": "giree luth jutha(n) mile hath batha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਲੋਥਾ ਦੇ ਸਮੂਹ (ਯੁੱਧ-ਭੂਮੀ ਵਿਚ) ਡਿਗੇ ਪਏ ਹਨ ਅਤੇ (ਕਈ ਯੋਧੇ) ਆਪਸ ਵਿਚ ਗੁਥਮ ਗੁੱਥਾ ਹੋ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "गिरी लुथ जुथं मिले हथ बथं ॥",
      "sourceLineId": "99912",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗਿਰੇ ਅੰਗ ਭੰਗੰ ਰਣੰ ਮੁਖ ਜੁਥੰ ॥੪੬੬॥",
      "transliteration": "gire a(n)g bha(n)ga(n) rana(n) mukh jutha(n) ||466||",
      "translation": "He discharged arrows in great rage and the army of that king was chopped and knocked down, the corpses fell in groups, heaps of hands, waists and other broken limbs fell down.466.",
      "punjabiViakhya": "(ਕਈਆਂ ਦੇ) ਅੰਗ ਕਟ ਕੇ ਡਿਗੇ ਪਏ ਹਨ ਅਤੇ ਰਣ ਵਿਚ ਮੁੰਡਾ ਦੇ ਢੇਰ ਲਗੇ ਹੋਏ ਹਨ ॥੪੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "गिरे अंग भंगं रणं मुख जुथं ॥४६६॥",
      "sourceLineId": "99913",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਰੈ ਕੇਲ ਕੰਕੀ ਕਿਲਕੈਤ ਕਾਲੀ ॥",
      "transliteration": "karai kel ka(n)kee kilakait kaalee ||",
      "translation": "",
      "punjabiViakhya": "(ਮੁਰਦਿਆਂ ਨੂੰ ਨੋਚਣ ਵਾਲੇ) ਕਾ ਖੁਸ਼ੀ ਮੰਨਾਉਾਂਦੇ ਹਨ ਅਤੇ ਕਾਲੀ ਕਿਲਕਾਰੀਆਂ ਮਾਰਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "करै केल कंकी किलकैत काली ॥",
      "sourceLineId": "99914",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਜੈ ਜ੍ਵਾਲ ਮਾਲਾ ਮਹਾ ਜੋਤਿ ਜ੍ਵਾਲੀ ॥",
      "transliteration": "tajai javaiaal maalaa mahaa jot javaiaalee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮਹਾਨ ਜੋਤਿ ਵਾਲੀ ਜ੍ਵਾਲਾਮੁਖੀ (ਮੂੰਹ ਵਿਚੋਂ) ਅਗਨੀ ਦੀਆਂ ਲਾਟਾ ਕਢਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "तजै ज्वाल माला महा जोति ज्वाली ॥",
      "sourceLineId": "99915",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਹਸੈ ਭੂਤ ਪ੍ਰੇਤੰ ਤੁਟੈ ਤਥਿ ਤਾਲੰ ॥",
      "transliteration": "hasai bhoot preta(n) tuTai tath taala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭੂਤ ਪ੍ਰੇਤ ਹਸ ਰਹੇ ਹਨ ਅਤੇ ਤੱਤ-ਥੱਯਾ ਦੇ ਤਾਲ ਟੁਟ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "हसै भूत प्रेतं तुटै तथि तालं ॥",
      "sourceLineId": "99916",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਫਿਰੈ ਗਉਰ ਦੌਰੀ ਪੁਐ ਰੁੰਡ ਮਾਲੰ ॥੪੬੭॥",
      "transliteration": "firai gaur dhauaree puaai ru(n)dd maala(n) ||467||",
      "translation": "The crows shouted caw and the flames of fire arose creating crackling noise, the ghosts and fiends laughed there and the goddess Kali ran, while stringing the rosaries of skulls.467.",
      "punjabiViakhya": "ਗੌਰੀ ('ਗਉਰ') ਰੁੰਡਾ ਦੀ ਮਾਲਾ ਪਰੋਣ ਲਈ (ਇਧਰ ਉਧਰ) ਭਜੀ ਫਿਰਦੀ ਹੈ ॥੪੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "फिरै गउर दौरी पुऐ रुँड मालं ॥४६७॥",
      "sourceLineId": "99917",
      "sourceShabadId": "9254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 597,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "99918",
      "sourceShabadId": "9255",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0597_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਰੈ ਜੁਧ ਕ੍ਰੁਧੰ ॥",
