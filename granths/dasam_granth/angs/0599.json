{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 599,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0599_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਨੁ ਬਿਜੁਲ ਜੁਆਲ ਕਰਾਲ ਕਸੈ ॥੪੭੪॥",
      "transliteration": "jan bijul juaal karaal kasai ||474||",
      "translation": "Thousands of swords were looking magnificent and it appeared that the snakes were stinging every limb, the swords seemed smiling like the flash of the dreadful lightning.474.",
      "punjabiViakhya": "ਮਾਨੋ ਬਿਜਲੀ ਦੀ ਭਿਆਨਕ ਲਾਟ (ਲਕੀਰ) ਖਿਚੀ ਗਈ ਹੋਵੇ ॥੪੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "जनु बिजुल जुआल कराल कसै ॥४७४॥",
      "sourceLineId": "99947",
      "sourceShabadId": "9256",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਿਧੂਪ ਨਰਾਜ ਛੰਦ ॥",
      "transliteration": "bidhoop naraaj chha(n)dh ||",
      "translation": "VIDHOOP NARAAJ STANZA",
      "punjabiViakhya": "ਬਿਧੂਪ ਨਰਾਜ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "बिधूप नराज छंद ॥",
      "sourceLineId": "99948",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਖਿਮੰਤ ਤੇਗ ਐਸ ਕੈ ॥",
      "transliteration": "khima(n)t teg aais kai ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰ ਇਸ ਤਰ੍ਰਹਾ ਚਮਕਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "खिमंत तेग ऐस कै ॥",
      "sourceLineId": "99949",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੁਲੰਤ ਜ੍ਵਾਲ ਜੈਸ ਕੈ ॥",
      "transliteration": "jula(n)t javaiaal jais kai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਅਗਨੀ ਪ੍ਰਕਾਸ਼ਿਤ ਹੁੰਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "जुलंत ज्वाल जैस कै ॥",
      "sourceLineId": "99950",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹਸੰਤ ਜੇਮਿ ਕਾਮਿਣੰ ॥",
      "transliteration": "hasa(n)t jem kaamina(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਜਿਵੇਾਂ ਇਸਤਰੀ ਹਸਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "हसंत जेमि कामिणं ॥",
      "sourceLineId": "99951",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਖਿਮੰਤ ਜਾਣੁ ਦਾਮਿਣੰ ॥੪੭੫॥",
      "transliteration": "khima(n)t jaan dhaamina(n) ||475||",
      "translation": "The swords are glistening like the fires or like the smiling damsels or like the flashing lightning.475.",
      "punjabiViakhya": "ਜਾ ਜਿਵੇਾਂ ਬਿਜਲੀ ਚਮਕਦੀ ਹੈ ॥੪੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "खिमंत जाणु दामिणं ॥४७५॥",
      "sourceLineId": "99952",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਹੰਤ ਦਾਇ ਘਾਇਣੰ ॥",
      "transliteration": "baha(n)t dhai ghaina(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਤਲਵਾਰ) ਦਾਓ ਨਾਲ ਚਲ ਕੇ ਘਾਓ ਕਰਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "बहंत दाइ घाइणं ॥",
      "sourceLineId": "99953",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਚਲੰਤ ਚਿਤ੍ਰ ਚਾਇਣੰ ॥",
      "transliteration": "chala(n)t chitr chaina(n) ||",
      "translation": "",
      "punjabiViakhya": "ਚਲਦੀ ਹੋਈ ਚਿਤਰ ਦਰਸਾ ਦਿੰਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "चलंत चित्र चाइणं ॥",
      "sourceLineId": "99954",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗਿਰੰਤ ਅੰਗ ਭੰਗ ਇਉ ॥",
      "transliteration": "gira(n)t a(n)g bha(n)g iau ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਗ ਟੁਟ ਕੇ ਇੰਜ ਡਿਗ ਪੈਂਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "गिरंत अंग भंग इउ ॥",
      "sourceLineId": "99955",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਨੇ ਸੁ ਜ੍ਵਾਲ ਜਾਲ ਜਿਉ ॥੪੭੬॥",
      "transliteration": "bane su javaiaal jaal jiau ||476||",
      "translation": "While inflicting wounds, they are moving like the restless modifications of mind, the broken limbs are falling like meteors.476.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਅੱਗ (ਦੀਆਂ ਚਿਣਗਾ ਦਾ) ਜਾਲ ਵਿਛਿਆ ਹੁੰਦਾ ਹੈ ॥੪੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "बने सु ज्वाल जाल जिउ ॥४७६॥",
      "sourceLineId": "99956",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹਸੰਤ ਖੇਤਿ ਖਪਰੀ ॥",
      "transliteration": "hasa(n)t khet khaparee ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਖਪਰ ਵਾਲੀ (ਕਾਲੀ) ਹਸਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "हसंत खेति खपरी ॥",
      "sourceLineId": "99957",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਕੰਤ ਭੂਤ ਭੈ ਧਰੀ ॥",
      "transliteration": "bhaka(n)t bhoot bhai dharee ||",
      "translation": "",
      "punjabiViakhya": "ਭੈ ਪੈਦਾ ਕਰਨ ਵਾਲੇ ਭੂਤ ਡਕਾਰਦੇ ਫਿਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "भकंत भूत भै धरी ॥",
      "sourceLineId": "99958",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਖਿਮੰਤ ਜੇਮਿ ਦਾਮਿਣੀ ॥",
      "transliteration": "khima(n)t jem dhaaminee ||",
      "translation": "",
      "punjabiViakhya": "(ਕਾਲੀ ਦੀ ਹਾਸੀ) ਬਿਜਲੀ ਵਾਗ ਲਿਸ਼ਕ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "खिमंत जेमि दामिणी ॥",
      "sourceLineId": "99959",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਚੰਤ ਹੇਰਿ ਕਾਮਿਣੀ ॥੪੭੭॥",
      "transliteration": "nacha(n)t her kaaminee ||477||",
      "translation": "The goddess Kalika is laughing in the battlefield and the frightening ghosts are shouting, just as the lightning is flashing, In the same manner, the heavenly damsels are looking at the battlefield and dancing.477.",
      "punjabiViakhya": "(ਉਸ ਨੂੰ ਵੇਖਕੇ) ਕਾਮਣੀਆਂ (ਅਪੱਛਰਾਵਾ) ਨਚ ਰਹੀਆਂ ਹਨ ॥੪੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "नचंत हेरि कामिणी ॥४७७॥",
      "sourceLineId": "99960",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਹਹੰਕ ਭੈਰਵੀ ਸੁਰੀ ॥",
      "transliteration": "haha(n)k bhairavee suree ||",
      "translation": "",
      "punjabiViakhya": "ਭੈਰਵੀ ਸ਼ਕਤੀ ਲਲਕਾਰੇ ਮਾਰਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "हहंक भैरवी सुरी ॥",
      "sourceLineId": "99961",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਹੰਕ ਸਾਧ ਸਿਧਰੀ ॥",
      "transliteration": "kaha(n)k saadh sidharee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਧਾ ਨੂੰ ਸਿੱਧੀਆਂ ਦੇਣ ਵਾਲੀ (ਭਗਵਤੀ) ਕਹ-ਕਹ ਕਰ ਕੇ (ਹਸ ਰਹੀ ਹੈ)।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "कहंक साध सिधरी ॥",
      "sourceLineId": "99962",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਛਲੰਕ ਛਿਛ ਇਛਣੀ ॥",
      "transliteration": "chhala(n)k chhichh ichhanee ||",
      "translation": "",
      "punjabiViakhya": "(ਲਹੂ ਦੀਆਂ) ਛਿੱਟਾ ਉਭਰਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "छलंक छिछ इछणी ॥",
      "sourceLineId": "99963",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਹੰਤ ਤੇਗ ਤਿਛਣੀ ॥੪੭੮॥",
      "transliteration": "baha(n)t teg tichhanee ||478||",
      "translation": "Bhairavi is shouting and the yoginis are laughing, the sharp swords fulfilling the desires, are striking the blows.478.",
      "punjabiViakhya": "ਤਿੱਖੀ ਤਲਵਾਰ ਚਲਦੀ ਹੈ ॥੪੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "बहंत तेग तिछणी ॥४७८॥",
      "sourceLineId": "99964",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗਣੰਤ ਗੂੜ ਗੰਭਰੀ ॥",
      "transliteration": "gana(n)t gooR ga(n)bharee ||",
      "translation": "",
      "punjabiViakhya": "(ਕਾਲੀ) ਗੂੜ੍ਰਹੀ ਗੰਭੀਰਤਾ ਨਾਲ ਵਿਚਾਰ ਕਰ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "गणंत गूड़ गंभरी ॥",
      "sourceLineId": "99965",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੁਭੰਤ ਸਿਪ ਸੌ ਭਰੀ ॥",
      "transliteration": "subha(n)t sip sau bharee ||",
      "translation": "",
      "punjabiViakhya": "ਸਿੱਪ ਵਾਗ ਚਮਕ ਸੁਸ਼ੋਭਿਤ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "सुभंत सिप सौ भरी ॥",
      "sourceLineId": "99966",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚਲੰਤਿ ਚਿਤ੍ਰ ਚਾਪਣੀ ॥",
      "transliteration": "chala(n)t chitr chaapanee ||",
      "translation": "",
      "punjabiViakhya": "ਚਿਤਰਾ ਵਾਲੀਆਂ ਧਨੁਸ਼ਾ ਧਾਰਨ ਕਰ ਕੇ ਚਲ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "चलंति चित्र चापणी ॥",
      "sourceLineId": "99967",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਪੰਤ ਜਾਪੁ ਜਾਪਣੀ ॥੪੭੯॥",
      "transliteration": "japa(n)t jaap jaapanee ||479||",
      "translation": "The goddess Kali is seriously enumerating the corpses and filling her bowl with blood, is looking magnificent, she is moving carelessly and seems like a portrait, she is repeating the Lord’s Name.479.",
      "punjabiViakhya": "ਜਪਣ ਵਾਲੀਆਂ (ਜੰਗ ਦੇ) ਜਾਪ ਨੂੰ ਜਪ ਰਹੀਆਂ ਹਨ ॥੪੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "जपंत जापु जापणी ॥४७९॥",
      "sourceLineId": "99968",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪੁਅੰਤ ਸੀਸ ਈਸਣੀ ॥",
      "transliteration": "pua(n)t sees ieesanee ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵੀ ਮੁੰਡਾ ਦੀ (ਮਾਲਾ) ਪਰੋ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "पुअंत सीस ईसणी ॥",
      "sourceLineId": "99969",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹਸੰਤ ਹਾਰ ਸੀਸਣੀ ॥",
      "transliteration": "hasa(n)t haar seesanee ||",
      "translation": "",
      "punjabiViakhya": "(ਸ਼ਿਵ) ਦੇ ਸਿਰ ਦਾ ਹਾਰ (ਸੱਪ) ਹਸ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "हसंत हार सीसणी ॥",
      "sourceLineId": "99970",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਰੰਤ ਪ੍ਰੇਤ ਨਿਸਨੰ ॥",
      "transliteration": "kara(n)t pret nisana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰੇਤ ਰੌਲਾ ਪਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "करंत प्रेत निसनं ॥",
      "sourceLineId": "99971",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਗੰਮਗੰਮ ਭਿਉ ਰਣੰ ॥੪੮੦॥",
      "transliteration": "aga(n)maga(n)m bhiau rana(n) ||480||",
      "translation": "She is stringing the rosary of skulls and putting it around her neck, she is laughing, the ghosts are also visible there and the battlefield has become an unapproachable place.480.",
      "punjabiViakhya": "ਅਗੰਮ ਤੋਂ ਅਗੰਮ (ਵਰਣਨ ਤੋਂ ਪਰੇ) ਯੁੱਧ ਹੋਇਆ ਹੈ ॥੪੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "अगंमगंम भिउ रणं ॥४८०॥",
      "sourceLineId": "99972",
      "sourceShabadId": "9257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "99973",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਬੈ ਜੰਗ ਜੰਗੀ ਰਚਿਓ ਜੰਗ ਜੋਰੰ ॥",
      "transliteration": "jabai ja(n)g ja(n)gee rachio ja(n)g jora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ 'ਜੰਗ ਜੰਗੀ' (ਨਾ ਵਾਲੇ ਯੋਧੇ) ਨੇ ਜ਼ੋਰ ਨਾਲ ਜੰਗ ਸ਼ੁਰੂ ਕੀਤਾ ਹੈ (ਉਦੋਂ) ਬਹੁਤ ਬਾਕੇ ਵੀਰ ਮਾਰ ਦਿੱਤੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "जबै जंग जंगी रचिओ जंग जोरं ॥",
      "sourceLineId": "99974",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਨੇ ਬੀਰ ਬੰਕੇ ਤਮੰ ਜਾਣੁ ਭੋਰੰ ॥",
      "transliteration": "hane beer ba(n)ke tama(n) jaan bhora(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ) ਮਾਨੋ ਸਵੇਰ ਹੁੰਦੇ ਹਨੇਰਾ (ਭਜ ਗਿਆ ਹੋਵੇ)।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "हने बीर बंके तमं जाणु भोरं ॥",
      "sourceLineId": "99975",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਬੈ ਕੋਪਿ ਗਰਜਿਓ ਕਲਕੀ ਅਵਤਾਰੰ ॥",
      "transliteration": "tabai kop garajio kalakee avataara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਸਮੇਾਂ ਕਲਕੀ ਅਵਤਾਰ ਨੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਗਰਜਨਾ ਕੀਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "तबै कोपि गरजिओ कलकी अवतारं ॥",
      "sourceLineId": "99976",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਜੇ ਸਰਬ ਸਸਤ੍ਰੰ ਧਸਿਓ ਲੋਹ ਧਾਰੰ ॥੪੮੧॥",
      "transliteration": "saje sarab sasatra(n) dhasio loh dhaara(n) ||481||",
      "translation": "When the warriors waged a powerful war, many elegant fighters were killed, then Kalki thundered and bedecked with all the weapons, penetrated into the current of steel-weapons.481.",
      "punjabiViakhya": "ਸਾਰੇ ਸ਼ਸਤ੍ਰ ਸਜਾ ਕੇ (ਯੁੱਧ-ਭੂਮੀ ਵਿਚ) ਧਸ ਗਿਆ ਹੈ ਅਤੇ ਲੋਹੇ ਦੇ (ਹਥਿਆਰਾ ਦੀ) ਬਰਖਾ ਕਰ ਦਿੱਤੀ ਹੈ ॥੪੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "सजे सरब ससत्रं धसिओ लोह धारं ॥४८१॥",
      "sourceLineId": "99977",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਯਾ ਸਬਦ ਉਠੇ ਰਹੇ ਲੋਗ ਪੂਰੰ ॥",
      "transliteration": "jayaa sabadh uThe rahe log poora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੈ-ਜੈ-ਕਾਰ ਦੇ ਸ਼ਬਦ ਉਠੇ ਹਨ ਅਤੇ ਸਾਰਿਆਂ ਲੋਕਾ ਵਿਚ ਭਰ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "जया सबद उठे रहे लोग पूरं ॥",
      "sourceLineId": "99978",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਖੁਰੰ ਖੇਹ ਉਠੀ ਛੁਹੀ ਜਾਇ ਸੂਰੰ ॥",
      "transliteration": "khura(n) kheh uThee chhuhee jai soora(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਘੋੜਿਆਂ ਦੇ) ਖੁਰਾ ਦੀ ਧੂੜ ਉਡੀ ਹੈ ਅਤੇ (ਉਸ ਨੇ) ਸੂਰਜ ਨੂੰ ਜਾ ਛੋਹਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "खुरं खेह उठी छुही जाइ सूरं ॥",
      "sourceLineId": "99979",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਛੁਟੇ ਸ੍ਵਰਨਪੰਖੀ ਭਯੋ ਅੰਧਕਾਰੰ ॥",
      "transliteration": "chhuTe savairanapa(n)khee bhayo a(n)dhakaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੋਨੇ ਦੇ ਖੰਭਾ ਵਾਲੇ ਤੀਰ ਚਲੇ ਹਨ (ਜਿਸ ਦੇ ਫਲਸਰੂਪ) ਹਨੇਰਾ ਹੋ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "छुटे स्वरनपंखी भयो अंधकारं ॥",
      "sourceLineId": "99980",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅੰਧਾਧੁੰਦ ਮਚੀ ਉਠੀ ਸਸਤ੍ਰ ਝਾਰੰ ॥੪੮੨॥",
      "transliteration": "a(n)dhaadhu(n)dh machee uThee sasatr jhaara(n) ||482||",
      "translation": "There was such a thundering sound that the people were absorbed in the illusion and the dust of the horses’ feet arose high to touch the sky, because of the dust, the golden rays disappeared and the darkness prevailed, in that confusion, there was a showe",
      "punjabiViakhya": "ਅੰਧਾ ਧੁੰਧ ਮਾਰ ਮਚ ਰਹੀ ਹੈ ਅਤੇ ਸ਼ਸਤ੍ਰਾ ਦੇ ਝਾੜਨ ਨਾਲ (ਅੱਗ ਦੀਆਂ) ਚਿੰਗਾਰੀਆਂ ਨਿਕਲੀਆਂ ਹਨ ॥੪੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "अंधाधुँद मची उठी ससत्र झारं ॥४८२॥",
      "sourceLineId": "99981",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹਣਿਓ ਜੋਰ ਜੰਗੰ ਤਜਿਓ ਸਰਬ ਸੈਣੰ ॥",
      "transliteration": "hanio jor ja(n)ga(n) tajio sarab saina(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੋਰ ਜੰਗ' (ਨਾ ਵਾਲਾ ਬਹਾਦਰ ਯੋਧਾ) ਮਾਰਿਆ ਗਿਆ ਅਤੇ ਸਾਰੀ ਸੈਨਾ ਭਜ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "हणिओ जोर जंगं तजिओ सरब सैणं ॥",
      "sourceLineId": "99982",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤ੍ਰਿਣੰ ਦੰਤ ਥਾਭੈ ਬਕੈ ਦੀਨ ਬੈਣੰ ॥",
      "transliteration": "tirana(n) dha(n)t thaabhai bakai dheen baina(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦੰਦਾ ਵਿਚ ਘਾਹ ਦਬ ਕੇ ਆਜਿਜ਼ੀ ਭਰੇ ਬੋਲ ਬੋਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "तृणं दंत थाभै बकै दीन बैणं ॥",
      "sourceLineId": "99983",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਿਲੇ ਦੈ ਅਕੋਰੰ ਨਿਹੋਰੰਤ ਰਾਜੰ ॥",
      "transliteration": "mile dhai akora(n) nihora(n)t raaja(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨਜ਼ਰਾਨੇ ਪੇਸ਼ ਕਰ ਕੇ ਮਿਲਦੇ ਹਨ ਅਤੇ (ਹਾਰੇ ਹੋਏ) ਰਾਜੇ ਬੇਨਤੀ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "मिले दै अकोरं निहोरंत राजं ॥",
      "sourceLineId": "99984",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਭਜੇ ਗਰਬ ਸਰਬੰ ਤਜੇ ਰਾਜ ਸਾਜੰ ॥੪੮੩॥",
      "transliteration": "bhaje garab saraba(n) taje raaj saaja(n) ||483||",
      "translation": "In that dreadful war, the army, being destroyed, ran away and pressing straw between the teeth, it began to shout with humility, seeing this the king also abandoned his pride and ran away leaving behind his kingdom and all his paraphernalia.483.",
      "punjabiViakhya": "ਹੰਕਾਰੀਆਂ ਦੇ ਹੰਕਾਰ ਖ਼ਤਮ ਹੋ ਗਏ ਹਨ ਅਤੇ ਰਾਜਸੀ ਠਾਠ-ਬਾਠ ਛਡ ਦਿੱਤੇ ਹਨ ॥੪੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "भजे गरब सरबं तजे राज साजं ॥४८३॥",
      "sourceLineId": "99985",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਟੇ ਕਾਸਮੀਰੀ ਹਠੇ ਕਸਟਵਾਰੀ ॥",
      "transliteration": "kaTe kaasameeree haThe kasaTavaaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਸ਼ਮੀਰੀ ਕਟੇ ਗਏ ਹਨ ਅਤੇ ਹਠੀ ਕਸ਼ਟਵਾੜੀ (ਪਿਛੇ ਹਟ ਗਏ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "कटे कासमीरी हठे कसटवारी ॥",
      "sourceLineId": "99986",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕੁਪੇ ਕਾਸਕਾਰੀ ਬਡੇ ਛਤ੍ਰਧਾਰੀ ॥",
      "transliteration": "kupe kaasakaaree badde chhatradhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਸ਼ਗਰ ਦੇ ਨਿਵਾਸੀ 'ਕਾਸਕਾਰੀ' ਵੱਡੇ ਛਤ੍ਰਧਾਰੀ ਕ੍ਰੋਧਿਤ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "कुपे कासकारी बडे छत्रधारी ॥",
      "sourceLineId": "99987",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਲੀ ਬੰਗਸੀ ਗੋਰਬੰਦੀ ਗ੍ਰਦੇਜੀ ॥",
      "transliteration": "balee ba(n)gasee goraba(n)dhee gradhejee ||",
      "translation": "",
      "punjabiViakhya": "ਬੰਗਾਲ ਦੇ ਬਲਵਾਨ, ਗੋਰਬੰਦੀ ਅਤੇ ਗੁਰਦੇਜ (ਦੇ ਨਿਵਾਸੀ)",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "बली बंगसी गोरबंदी ग्रदेजी ॥",
      "sourceLineId": "99988",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮਹਾ ਮੂੜ ਮਾਜਿੰਦ੍ਰਰਾਨੀ ਮਜੇਜੀ ॥੪੮੪॥",
      "transliteration": "mahaa mooR maaji(n)dhraraanee majejee ||484||",
      "translation": "Many Kashmiri and patient, persistent and enduring warriors were chopped and killed and many canopied, many mighty Gurdezi fighters and fighters of other countries, who were siding that king with great foolishness, were defeated.484.",
      "punjabiViakhya": "ਮਾਜਿੰਦ੍ਰਰਾਨ ਦੇਸ ਦੇ ਮਹਾ ਮੂਰਖ ਅਤੇ ਅਭਿਮਾਨੀ ਨਿਵਾਸੀ (ਆਦਿ ਮਾਰੇ ਗਏ ਹਨ) ॥੪੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "महा मूड़ माजिंद्ररानी मजेजी ॥४८४॥",
      "sourceLineId": "99989",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਣੇ ਰੂਸਿ ਤੂਸੀ ਕ੍ਰਿਤੀ ਚਿਤ੍ਰ ਜੋਧੀ ॥",
      "transliteration": "hane roos toosee kiratee chitr jodhee ||",
      "translation": "",
      "punjabiViakhya": "ਰੂਸ ਦੇ, ਤੂਸ ਦੇ ਸੁੰਦਰ ਯੋਧੇ ਮਾਰੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "हणे रूसि तूसी कृती चित्र जोधी ॥",
      "sourceLineId": "99990",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹਠੇ ਪਾਰਸੀ ਯਦ ਖੂਬਾ ਸਕ੍ਰੋਧੀ ॥",
      "transliteration": "haThe paarasee yadh khoobaa sakrodhee ||",
      "translation": "",
      "punjabiViakhya": "ਫ਼ਾਰਸ ਦੇ ਹਠੀਲੇ, ਬਲਵਾਨ ਬਾਹਵਾ ਵਾਲੇ ਅਤੇ ਕ੍ਰੋਧਵਾਨ,",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "हठे पारसी यद खूबा सक्रोधी ॥",
      "sourceLineId": "99991",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0599_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬੁਰੇ ਬਾਗਦਾਦੀ ਸਿਪਾਹਾ ਕੰਧਾਰੀ ॥",
      "transliteration": "bure baagadhaadhee sipaahaa ka(n)dhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਬੁਰੇ ਬਗਦਾਦੀ ਅਤੇ ਕੰਧਾਰ ਦੇ ਸਿਪਾਹੀ, ਕਲਮਾਛ (ਤਾਤਾਰ ਦੇਸ਼) ਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 599,
      "hindi": "",
      "hindiTransliteration": "बुरे बागदादी सिपाहा कंधारी ॥",
      "sourceLineId": "99992",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
