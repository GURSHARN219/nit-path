{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 600,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0600_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਘੁਰੇ ਜਾਣ ਸ੍ਯਾਮੰ ਘਟਾ ਜਿਮਿ ਜ੍ਵਾਲੰ ॥",
      "transliteration": "ghure jaan sayaama(n) ghaTaa jim javaiaala(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ) ਮਾਨੋ ਕਾਲੀਆਂ ਘਟਾਵਾ ਗੂੰਜਦੀਆਂ ਹਨ ਅਤੇ ਜਿਵੇਾਂ (ਆਤਿਸ਼ਬਾਜੀ ਵਿਚੋਂ) ਅੱਗ ਨਿਕਲਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "घुरे जाण स्यामं घटा जिमि ज्वालं ॥",
      "sourceLineId": "99995",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਚੇ ਈਸ ਸੀਸੰ ਪੁਐ ਰੁੰਡ ਮਾਲੰ ॥",
      "transliteration": "nache iees seesa(n) puaai ru(n)dd maala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਨਚਦਾ ਹੈ, ਰੁੰਡਾ ਨੂੰ ਮਾਲਾ ਵਿਚ ਪਰੋਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "नचे ईस सीसं पुऐ रुँड मालं ॥",
      "sourceLineId": "99996",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜੁਝੇ ਬੀਰ ਧੀਰੰ ਬਰੈ ਬੀਨਿ ਬਾਲੰ ॥੪੮੬॥",
      "transliteration": "jujhe beer dheera(n) barai been baala(n) ||486||",
      "translation": "With the discharge of arrows, the firearms wre discharged like the fires rising in clourds, Shiva, dancing with his pleasure, strung the rosaries of skulls, the warriors began to fight and wed the heavenly damsels after selecting them.486.",
      "punjabiViakhya": "ਧੀਰਜ ਵਾਲੇ ਸੂਰਮੇ ਜੂਝਦੇ ਹਨ ਅਤੇ ਅਪੱਛਰਾਵਾ ਉਨ੍ਰਹਾ ਨੂੰ ਚੁਣ ਚੁਣ ਕੇ ਵਰਦੀਆਂ ਹਨ ॥੪੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "जुझे बीर धीरं बरै बीनि बालं ॥४८६॥",
      "sourceLineId": "99997",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗਿਰੈ ਅੰਗ ਭੰਗੰ ਭ੍ਰਮੰ ਰੁੰਡ ਮੁੰਡੰ ॥",
      "transliteration": "girai a(n)g bha(n)ga(n) bhrama(n) ru(n)dd mu(n)dda(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਤੇ) ਅੰਗ ਕਟ ਕੇ ਡਿਗ ਰਹੇ ਹਨ (ਅਤੇ ਕਿਤੇ) ਰੁੰਡ ਅਤੇ ਮੁੰਡ ਫਿਰ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "गिरै अंग भंगं भ्रमं रुँड मुँडं ॥",
      "sourceLineId": "99998",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗਜੀ ਬਾਜ ਗਾਜੀ ਗਿਰੈ ਬੀਰ ਝੁੰਡੰ ॥",
      "transliteration": "gajee baaj gaajee girai beer jhu(n)dda(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਤੇ) ਹਾਥੀਆਂ ਦੇ ਸਵਾਰ, ਘੋੜਿਆਂ ਦੇ ਸਵਾਰ, ਸੂਰਮਿਆਂ ਦੇ ਝੁੰਡ ਡਿਗੇ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "गजी बाज गाजी गिरै बीर झुँडं ॥",
      "sourceLineId": "99999",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਇਕੰ ਹਾਕ ਹੰਕੈਤਿ ਧਰਕੈਤ ਸੂਰੰ ॥",
      "transliteration": "eika(n) haak ha(n)kait dharakait soora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਇਕਨਾ ਵਲੋਂ ਹਾਕਾ ਪੈਂਦੀਆਂ ਹਨ ਅਤੇ (ਜਿਨ੍ਰਹਾ ਨੂੰ ਸੁਣ ਕੇ) ਸੂਰਮਿਆਂ (ਦੇ ਦਿਲ) ਧੜਕ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "इकं हाक हंकैति धरकैत सूरं ॥",
      "sourceLineId": "100000",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਉਠੇ ਤਛ ਮੁਛੰ ਭਈ ਲੋਹ ਪੂਰੰ ॥੪੮੭॥",
      "transliteration": "auThe tachh muchha(n) bhiee loh poora(n) ||487||",
      "translation": "Getting truncated and having the limbs broken the riders of elephants, the horses and other warriors began to fall in groups, the hearts of the warriors throbbed with each challenge and with the rising of the fighters with beautiful whiskers the earth bec",
      "punjabiViakhya": "ਕਟੇ ਹੋਏ ਧੜ ਉਠਦੇ ਹਨ ਅਤੇ (ਯੁੱਧ-ਭੂਮੀ) ਲੋਹੇ (ਦੇ ਹਥਿਆਰਾ ਨਾਲ) ਭਰੀ ਪਈ ਹੈ ॥੪੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "उठे तछ मुछं भई लोह पूरं ॥४८७॥",
      "sourceLineId": "100001",
      "sourceShabadId": "9258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "100002",
      "sourceShabadId": "9259",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਰੇ ਜੇ ਸੁ ਮਾਰੇ ॥",
      "transliteration": "are je su maare ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ ਸਾਹਮਣੇ) ਅੜੇ ਹਨ (ਉਹ) ਮਾਰੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "अरे जे सु मारे ॥",
      "sourceLineId": "100003",
      "sourceShabadId": "9259",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਿਲੇ ਤੇ ਜੁ ਹਾਰੇ ॥",
      "transliteration": "mile te ju haare ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਹਾਰ ਗਏ ਹਨ (ਉਹ ਈਨ ਮੰਨ ਕੇ) ਮਿਲ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "मिले ते जु हारे ॥",
      "sourceLineId": "100004",
      "sourceShabadId": "9259",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਲਏ ਸਰਬ ਸੰਗੰ ॥",
      "transliteration": "le sarab sa(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਨਾਲ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "लए सरब संगं ॥",
      "sourceLineId": "100005",
      "sourceShabadId": "9259",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਸੇ ਰੀਝ ਰੰਗੰ ॥੪੮੮॥",
      "transliteration": "rase reejh ra(n)ga(n) ||488||",
      "translation": "He, who resisted before them, was killed and he, who was defeated, he surrendered, in this way, all were delightfully adjusted.488.",
      "punjabiViakhya": "(ਕਲਕੀ ਅਵਤਾਰ ਯੁੱਧ) ਦੇ ਰੰਗ ਵਿਚ ਰੰਗੇ ਹੋਏ ਹਨ ॥੪੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "रसे रीझ रंगं ॥४८८॥",
      "sourceLineId": "100006",
      "sourceShabadId": "9259",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦਇਓ ਦਾਨ ਏਤੋ ॥",
      "transliteration": "dhio dhaan eto ||",
      "translation": "",
      "punjabiViakhya": "ਇਤਨਾ (ਅਧਿਕ) ਦਾਨ ਦਿੱਤਾ ਹੈ, ਕਿਤਨਾ ਹੈ?",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "दइओ दान एतो ॥",
      "sourceLineId": "100007",
      "sourceShabadId": "9259",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਥੈ ਕਬਿ ਕੇਤੋ ॥",
      "transliteration": "kathai kab keto ||",
      "translation": "",
      "punjabiViakhya": "ਕਵੀ ਜਨ (ਉਸ ਦਾ) ਵਰਣਨ ਨਹੀਂ ਕਰ ਸਕਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "कथै कबि केतो ॥",
      "sourceLineId": "100008",
      "sourceShabadId": "9259",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਿਝੇ ਸਰਬ ਰਾਜਾ ॥",
      "transliteration": "rijhe sarab raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਰਾਜੇ ਪ੍ਰਸੰਨ ਹੋ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "रिझे सरब राजा ॥",
      "sourceLineId": "100009",
      "sourceShabadId": "9259",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਜੇ ਬੰਬ ਬਾਜਾ ॥੪੮੯॥",
      "transliteration": "baje ba(n)b baajaa ||489||",
      "translation": "So much charity was bestowed, that they can only be described by the poets, all the kings became happy and the horns of victory sounded.489.",
      "punjabiViakhya": "ਨਗਾਰੇ ਅਤੇ ਵਾਜੇ ਵਜ ਰਹੇ ਹਨ ॥੪੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "बजे बंब बाजा ॥४८९॥",
      "sourceLineId": "100010",
      "sourceShabadId": "9259",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਖੁਰਾਸਾਨ ਜੀਤਾ ॥",
      "transliteration": "khuraasaan jeetaa ||",
      "translation": "",
      "punjabiViakhya": "ਖੁਰਾਸਾਨ ਦੇਸ਼ ਜਿਤ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "खुरासान जीता ॥",
      "sourceLineId": "100011",
      "sourceShabadId": "9259",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਬਹੂੰ ਸੰਗ ਲੀਤਾ ॥",
      "transliteration": "sabahoo(n) sa(n)g leetaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ (ਵੈਰੀਆਂ) ਨੂੰ ਨਾਲ ਲੈ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "सबहूँ संग लीता ॥",
      "sourceLineId": "100012",
      "sourceShabadId": "9259",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦਇਓ ਆਪ ਮੰਤ੍ਰੰ ॥",
      "transliteration": "dhio aap ma(n)tra(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸਭ ਨੂੰ ਕਲਕੀ ਨੇ) ਆਪ ਮੰਤ੍ਰ ਦਿੱਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "दइओ आप मंत्रं ॥",
      "sourceLineId": "100013",
      "sourceShabadId": "9259",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਭਲੇ ਅਉਰ ਜੰਤ੍ਰੰ ॥੪੯੦॥",
      "transliteration": "bhale aaur ja(n)tra(n) ||490||",
      "translation": "The Khorasan country was conquered and taking every-one with him, the Lord (Kalki) gave his mantra and Yantra to everyone.490.",
      "punjabiViakhya": "ਅਤੇ ਹੋਰ ਵੀ ਕਈ ਉਤਮ ਜੰਤ੍ਰ ਦਿੱਤੇ ਹਨ ॥੪੯੦॥",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "भले अउर जंत्रं ॥४९०॥",
      "sourceLineId": "100014",
      "sourceShabadId": "9259",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚਲਿਓ ਦੇ ਨਗਾਰਾ ॥",
      "transliteration": "chalio dhe nagaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਕਲਕੀ) ਧੌਂਸਾ ਵਜਾ ਕੇ ਤੁਰ ਪਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "चलिओ दे नगारा ॥",
      "sourceLineId": "100015",
      "sourceShabadId": "9259",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਿਲਿਓ ਸੈਨ ਭਾਰਾ ॥",
      "transliteration": "milio sain bhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਵੱਡਾ ਸੈਨਾ ਦਲ ਨਾਲ ਮਿਲ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "मिलिओ सैन भारा ॥",
      "sourceLineId": "100016",
      "sourceShabadId": "9259",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕ੍ਰਿਪਾਣੀ ਨਿਖੰਗੰ ॥",
      "transliteration": "kirapaanee nikha(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈ) ਕ੍ਰਿਪਾਨਾ ਵਾਲੇ ਅਤੇ ਭੱਥਿਆਂ ਵਾਲੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "कृपाणी निखंगं ॥",
      "sourceLineId": "100017",
      "sourceShabadId": "9259",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਕ੍ਰੋਧੀ ਭੜੰਗੰ ॥੪੯੧॥",
      "transliteration": "sakrodhee bhaRa(n)ga(n) ||491||",
      "translation": "From there, sounding trumpets and taking all the army alongwith him he marched forward, the warriors had the swords and quivers, they were extremely angry and clashing warriors.491.",
      "punjabiViakhya": "ਜੋ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਲੜਦੇ ਹਨ ॥੪੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "सक्रोधी भड़ंगं ॥४९१॥",
      "sourceLineId": "100018",
      "sourceShabadId": "9259",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤੋਟਕ ਛੰਦ ॥",
      "transliteration": "toTak chha(n)dh ||",
      "translation": "TOTAK STANZA",
      "punjabiViakhya": "ਤੋਟਕ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "तोटक छंद ॥",
      "sourceLineId": "100019",
      "sourceShabadId": "9260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭੂਅ ਕੰਪਤ ਜੰਪਤ ਸੇਸ ਫਣੰ ॥",
      "transliteration": "bhooa ka(n)pat ja(n)pat ses fana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਕਲਕੀ ਦੀ ਚੜ੍ਰਹਤਲ ਨਾਲ) ਭੂਮੀ ਕੰਬ ਗਈ ਹੈ। ਸ਼ੇਸ਼ ਨਾਗ ਜਾਪ ਕਰ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "भूअ कंपत जंपत सेस फणं ॥",
      "sourceLineId": "100020",
      "sourceShabadId": "9260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਘਹਰੰਤ ਸੁ ਘੁੰਘਰ ਘੋਰ ਰਣੰ ॥",
      "transliteration": "ghahara(n)t su ghu(n)ghar ghor rana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਘੋਰ ਆਵਾਜ਼ ਨਾਲ ਘੁੰਘਰੂ ਵਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "घहरंत सु घुँघर घोर रणं ॥",
      "sourceLineId": "100021",
      "sourceShabadId": "9260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਰ ਤਜਤ ਗਜਤ ਕ੍ਰੋਧ ਜੁਧੰ ॥",
      "transliteration": "sar tajat gajat krodh judha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਯੁੱਧ ਵਿਚ ਤੀਰ ਛਡਦੇ ਹਨ ਅਤੇ ਕ੍ਰੋਧ ਨਾਲ ਗਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "सर तजत गजत क्रोध जुधं ॥",
      "sourceLineId": "100022",
      "sourceShabadId": "9260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮੁਖ ਮਾਰ ਉਚਾਰਿ ਜੁਝਾਰ ਕ੍ਰੁਧੰ ॥੪੯੨॥",
      "transliteration": "mukh maar uchaar jujhaar krudha(n) ||492||",
      "translation": "The earth trembled and the Sheshnaga repeated Lord’s Names, the dreadful bells of war rang, the warriors in ire discharged arrows and shouted “kill, kill” from their mouth.492.",
      "punjabiViakhya": "ਜੁਝਾਰੂ ਸੂਰਮੇ ਕ੍ਰੋਧ ਨਾਲ ਮੁਖ ਤੋਂ 'ਮਾਰੋ' 'ਮਾਰੋ' ਪੁਕਾਰਦੇ ਹਨ ॥੪੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "मुख मार उचारि जुझार क्रुधं ॥४९२॥",
      "sourceLineId": "100023",
      "sourceShabadId": "9260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬ੍ਰਿਨ ਝਲਤ ਘਲਤ ਘਾਇ ਘਣੰ ॥",
      "transliteration": "biran jhalat ghalat ghai ghana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮੇ) ਜ਼ਖ਼ਮਾ ਨੂੰ ਝਲਦੇ ਹਨ ਅਤੇ (ਹੋਰਨਾ ਨੂੰ) ਘਾਇਲ ਕਰਦੇ ਵੀ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "बृन झलत घलत घाइ घणं ॥",
      "sourceLineId": "100024",
      "sourceShabadId": "9260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕੜਕੁਟ ਸੁ ਪਖਰ ਬਖਤਰਣੰ ॥",
      "transliteration": "kaRakuT su pakhar bakhatarana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਪਾਖਰਾ ਵਾਲਿਆਂ ਅਤੇ ਕਵਚਾ ਵਾਲਿਆਂ ਦੀ ਕਰਕੁਟ ਮਚੀ ਹੋਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "कड़कुट सु पखर बखतरणं ॥",
      "sourceLineId": "100025",
      "sourceShabadId": "9260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗਣ ਗਿਧ ਸੁ ਬ੍ਰਿਧ ਰੜੰਤ ਨਭੰ ॥",
      "transliteration": "gan gidh su biradh raRa(n)t nabha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਸਾਰੀਆਂ ਵੱਡੀਆਂ ਗਿਰਝਾ ਆਕਾਸ਼ ਵਿਚ ਸ਼ੋਰ ਪਾ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "गण गिध सु बृध रड़ंत नभं ॥",
      "sourceLineId": "100026",
      "sourceShabadId": "9260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਿਲਕਾਰਤ ਡਾਕਿਣ ਉਚ ਸੁਭੰ ॥੪੯੩॥",
      "transliteration": "kilakaarat ddaakin uch subha(n) ||493||",
      "translation": "Enduring the anguish of wounds, they began to inflict wounds and cut the good steel-armours in the battlefield, the ghosts and the vultures moved in the sky and the vampires shrieked vultures moved in the sky and the vampires shrieked violently.493.",
      "punjabiViakhya": "ਡਾਕਣੀਆਂ ਉੱਚੀ ਸੁਰ ਵਿਚ ਕਿਲਕਾਰੀਆਂ ਮਾਰ ਰਹੀਆਂ ਹਨ ॥੪੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "किलकारत डाकिण उच सुभं ॥४९३॥",
      "sourceLineId": "100027",
      "sourceShabadId": "9260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗਣਿ ਹੂਰ ਸੁ ਪੂਰ ਫਿਰੀ ਗਗਨੰ ॥",
      "transliteration": "gan hoor su poor firee gagana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੂਰਾ ਦੀਆਂ ਫਿਰਦੀਆਂ ਟੋਲੀਆਂ ਨਾਲ ਆਕਾਸ਼ ਪੂਰਿਆ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "गणि हूर सु पूर फिरी गगनं ॥",
      "sourceLineId": "100028",
      "sourceShabadId": "9260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਵਿਲੋਕਿ ਸਬਾਹਿ ਲਗੀ ਸਰਣੰ ॥",
      "transliteration": "avilok sabaeh lagee sarana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸੁੰਦਰ ਡੀਲ ਡੌਲ ਵਾਲੇ (ਸੂਰਮਿਆਂ) ਦੀ ਸਰਨ ਵਿਚ ਪੈਂਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "अविलोकि सबाहि लगी सरणं ॥",
      "sourceLineId": "100029",
      "sourceShabadId": "9260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮੁਖ ਭਾਵਤ ਗਾਵਤ ਗੀਤ ਸੁਰੀ ॥",
      "transliteration": "mukh bhaavat gaavat geet suree ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦੇਵ-ਇਸਤਰੀਆਂ ਮਨ ਭਾਉਾਂਦੇ ਗੀਤ ਮੁਖ ਤੋਂ ਗਾ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "मुख भावत गावत गीत सुरी ॥",
      "sourceLineId": "100030",
      "sourceShabadId": "9260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗਣ ਪੂਰ ਸੁ ਪਖਰ ਹੂਰ ਫਿਰੀ ॥੪੯੪॥",
      "transliteration": "gan poor su pakhar hoor firee ||494||",
      "translation": "The heavenly damsels moved in the sky and they came to look for and take refuge with the warriors in the battlefield, they sang song from their mouths and in this way, the ganas and heavenly damsels roamed in the sky.496.",
      "punjabiViakhya": "ਹੂਰਾ ਦੀਆਂ ਟੋਲੀਆਂ ਪੂਰੀ ਤਰ੍ਰਹਾ ਸਜ ਕੇ ਫਿਰਦੀਆਂ ਹਨ ॥੪੯੪॥",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "गण पूर सु पखर हूर फिरी ॥४९४॥",
      "sourceLineId": "100031",
      "sourceShabadId": "9260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭਟ ਪੇਖਤ ਪੋਅਤ ਹਾਰ ਹਰੀ ॥",
      "transliteration": "bhaT pekhat poat haar haree ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਵੇਖਦੇ ਹਨ ਅਤੇ ਸ਼ਿਵ (ਮੁੰਡਾ ਦੀ) ਮਾਲਾ ਪਰੋ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "भट पेखत पोअत हार हरी ॥",
      "sourceLineId": "100032",
      "sourceShabadId": "9260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹਹਰਾਵਤ ਹਾਸ ਫਿਰੀ ਪਖਰੀ ॥",
      "transliteration": "haharaavat haas firee pakharee ||",
      "translation": "",
      "punjabiViakhya": "ਅਪੱਛਰਾਵਾ ਹਸਦੀਆਂ ਹਸਾਉਾਂਦੀਆਂ ਫਿਰ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "हहरावत हास फिरी पखरी ॥",
      "sourceLineId": "100033",
      "sourceShabadId": "9260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦਲ ਗਾਹਤ ਬਾਹਤ ਬੀਰ ਬ੍ਰਿਣੰ ॥",
      "transliteration": "dhal gaahat baahat beer birana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਸੈਨਾ ਨੂੰ ਗਾਹੁੰਦੇ ਫਿਰਦੇ ਹਨ ਅਤੇ ਜ਼ਖ਼ਮ ਲਗਾਉਾਂਦੇ ਫਿਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "दल गाहत बाहत बीर बृणं ॥",
      "sourceLineId": "100034",
      "sourceShabadId": "9260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪ੍ਰਣ ਪੂਰ ਸੁ ਪਛਿਮ ਜੀਤ ਰਣੰ ॥੪੯੫॥",
      "transliteration": "pran poor su pachhim jeet rana(n) ||495||",
      "translation": "Seeing the warriors, Shiva began to string the rosary of skulls and Yoginis laughed and moved, the fighters, roaming in the armies received wounds and in this way they began to fulfill their promise of conquering the West.495.",
      "punjabiViakhya": "ਯੁੱਧ ਵਿਚ ਪੱਛਮ ਦਿਸ਼ਾ ਨੂੰ ਜਿਤ ਕੇ ਪ੍ਰਣ ਨੂੰ ਪੂਰਾ ਕਰ ਦਿੱਤਾ ਹੈ ॥੪੯੫॥",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "प्रण पूर सु पछिम जीत रणं ॥४९५॥",
      "sourceLineId": "100035",
      "sourceShabadId": "9260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "100036",
      "sourceShabadId": "9261",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜੀਤਿ ਸਰਬ ਪਛਿਮ ਦਿਸਾ ਦਛਨ ਕੀਨ ਪਿਆਨ ॥",
      "transliteration": "jeet sarab pachhim dhisaa dhachhan keen piaan ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਪੱਛਮ ਦਿਸ਼ਾ ਨੂੰ ਜਿਤ ਕੇ (ਕਲਕੀ ਨੇ) ਦੱਖਣ ਦਿਸ਼ਾ ਵਲ ਚਾਲੇ ਪਾਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "जीति सरब पछिम दिसा दछन कीन पिआन ॥",
      "sourceLineId": "100037",
      "sourceShabadId": "9261",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਮਿ ਜਿਮਿ ਜੁਧ ਤਹਾ ਪਰਾ ਤਿਮਿ ਤਿਮਿ ਕਰੋ ਬਖਾਨ ॥੪੯੬॥",
      "transliteration": "jim jim judh tahaa paraa tim tim karo bakhaan ||496||",
      "translation": "Conquering the whole of the west, Kalki thought of moving towards the South and I do not relate the wars, that occurred there.496.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਜਿਵੇਾਂ ਉਥੇ ਯੁੱਧ ਹੋਇਆ ਹੈ, ਤਿਵੇਾਂ ਤਿਵੇਾਂ (ਉਸ ਦਾ) ਕਥਨ ਕਰਦਾ ਹਾ ॥੪੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "जिमि जिमि जुध तहा परा तिमि तिमि करो बखान ॥४९६॥",
      "sourceLineId": "100038",
      "sourceShabadId": "9261",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤੋਟਕ ਛੰਦ ॥",
      "transliteration": "toTak chha(n)dh ||",
      "translation": "TOTAK STANZA",
      "punjabiViakhya": "ਤੋਟਕ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "तोटक छंद ॥",
      "sourceLineId": "100039",
      "sourceShabadId": "9262",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਰਣਿ ਜੰਪਤ ਜੁਗਿਣ ਜੂਹ ਜਯੰ ॥",
      "transliteration": "ran ja(n)pat jugin jooh jaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਜੋਗਣਾ ਦੀਆਂ ਟੋਲੀਆਂ 'ਜੈਜੈਕਾਰ' ਦਾ ਜਾਪ ਕਰ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "रणि जंपत जुगिण जूह जयं ॥",
      "sourceLineId": "100040",
      "sourceShabadId": "9262",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0600_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਲਿ ਕੰਪਤ ਭੀਰੁ ਅਭੀਰ ਭਯੰ ॥",
      "transliteration": "kal ka(n)pat bheer abheer bhaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਲਕੀ (ਅਵਤਾਰ) ਦੇ ਭੈ ਕਰ ਕੇ ਕਾਇਰ ਅਤੇ ਸੂਰਵੀਰ (ਸੂਰਮੇ) ਕੰਬ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 600,
      "hindi": "",
      "hindiTransliteration": "कलि कंपत भीरु अभीर भयं ॥",
      "sourceLineId": "100041",
