{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 602,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0602_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਸਿ ਲਸਤ ਰਸਤ ਤੇਗ ਜਗੀ ॥੫੦੩॥",
      "transliteration": "as lasat rasat teg jagee ||503||",
      "translation": "The mighty ghosts and Baitals, danced, the elephants trumpetted and the heart-moving instruments were played the horses neighed and the elephants roared the swords in the hands of the warriors looked splendid.503.",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਚਮਕਦੀਆਂ ਹਨ ਅਤੇ ਤੇਗਾ ਜਗਮਗਾਉਾਂਦੀਆਂ ਹਨ ॥੫੦੩॥",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "असि लसत रसत तेग जगी ॥५०३॥",
      "sourceLineId": "100067",
      "sourceShabadId": "9262",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "100068",
      "sourceShabadId": "9263",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਨੇ ਪਛਮੀ ਦੀਹ ਦਾਨੋ ਦਿਵਾਨੇ ॥",
      "transliteration": "hane pachhamee dheeh dhaano dhivaane ||",
      "translation": "",
      "punjabiViakhya": "ਪੱਛਮ ਦਿਸ਼ਾ ਵਿਚ ਵੱਡੇ ਆਕਾਰ ਦੇ ਦਿਵਾਨੇ ਦਾਨਵ ਮਾਰ ਦਿੱਤੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "हने पछमी दीह दानो दिवाने ॥",
      "sourceLineId": "100069",
      "sourceShabadId": "9263",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦਿਸਾ ਦਛਨੀ ਆਨਿ ਬਾਜੇ ਨਿਸਾਨੇ ॥",
      "transliteration": "dhisaa dhachhanee aan baaje nisaane ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਖਣ ਦਿਸ਼ਾ ਵਿਚ ਨਗਾਰੇ ਆ ਕੇ ਵਜੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "दिसा दछनी आनि बाजे निसाने ॥",
      "sourceLineId": "100070",
      "sourceShabadId": "9263",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹਨੇ ਬੀਰ ਬੀਜਾਪੁਰੀ ਗੋਲਕੁੰਡੀ ॥",
      "transliteration": "hane beer beejaapuree golaku(n)ddee ||",
      "translation": "",
      "punjabiViakhya": "ਬੀਜਾਪੁਰ ਅਤੇ ਗੋਲਕੁੰਡੇ ਦੇ ਯੋਧੇ ਮਾਰੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "हने बीर बीजापुरी गोलकुँडी ॥",
      "sourceLineId": "100071",
      "sourceShabadId": "9263",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗਿਰੇ ਤਛ ਮੁਛੰ ਨਚੀ ਰੁੰਡ ਮੁੰਡੀ ॥੫੦੪॥",
      "transliteration": "gire tachh muchha(n) nachee ru(n)dd mu(n)ddee ||504||",
      "translation": "After killing the proud demons of the West, now the trumpets sounded in the South, there the warriors of Bijapur and Golkunda were killed the warriors fell and the goddess Kali, the wearer of the rosary of skulls, began to dance.504.",
      "punjabiViakhya": "(ਵੀਰ ਲੋਕ) ਕਟੇ ਹੋਏ ਡਿਗਣ ਲਗ ਪਏ ਹਨ ਅਤੇ (ਉਨ੍ਰਹਾ ਦੇ) ਰੁੰਡ ਅਤੇ ਮੁੰਡ ਨਾਚ ਕਰਨ ਲਗ ਗਏ ਹਨ ॥੫੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "गिरे तछ मुछं नची रुँड मुँडी ॥५०४॥",
      "sourceLineId": "100072",
      "sourceShabadId": "9263",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਬੈ ਸੇਤੁਬੰਧੀ ਸੁਧੀ ਬੰਦ੍ਰ ਬਾਸੀ ॥",
      "transliteration": "sabai setuba(n)dhee sudhee ba(n)dhr baasee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮੇਸ਼੍ਵਰ ('ਸੇਤਬੰਧੀ') ਦੇ ਨਿਵਾਸੀ, ਅਤੇ ਸੁਧ ਬੁਧ ਵਾਲੇ ਬੰਦਰਗਾਹ ਉਤੇ ਰਹਿਣ ਵਾਲੇ,",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "सबै सेतुबंधी सुधी बंद्र बासी ॥",
      "sourceLineId": "100073",
      "sourceShabadId": "9263",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮੰਡੇ ਮਛਬੰਦ੍ਰੀ ਹਠੀ ਜੁਧ ਰਾਸੀ ॥",
      "transliteration": "ma(n)dde machhaba(n)dhree haThee judh raasee ||",
      "translation": "",
      "punjabiViakhya": "ਮੱਛਲੀ ਬੰਦਰਗਾਹ ਵਾਲੇ ਹਠੀਲੇ ਜੁਆਨ ਜੋ ਯੁੱਧ ਦੀ ਰਾਸ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "मंडे मछबंद्री हठी जुध रासी ॥",
      "sourceLineId": "100074",
      "sourceShabadId": "9263",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦ੍ਰਹੀ ਦ੍ਰਾਵੜੇ ਤੇਜ ਤਾਤੇ ਤਿਲੰਗੀ ॥",
      "transliteration": "dhrahee dhraavaRe tej taate tila(n)gee ||",
      "translation": "",
      "punjabiViakhya": "ਦ੍ਰਹੀ ਅਤੇ ਦ੍ਰਾਵੜੀ ਅਤੇ ਤੱਤੇ ਤੇਜ ਵਾਲੇ ਤਿਲੰਗਾਨਾ ਦੇ ਨਿਵਾਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "द्रही द्रावड़े तेज ताते तिलंगी ॥",
      "sourceLineId": "100075",
      "sourceShabadId": "9263",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਹਤੇ ਸੂਰਤੀ ਜੰਗ ਭੰਗੀ ਫਿਰੰਗੀ ॥੫੦੫॥",
      "transliteration": "hate sooratee ja(n)g bha(n)gee fira(n)gee ||505||",
      "translation": "The battles were fought with the residents of Setubandh and other ports and with the persistent warriors of Matasya Pradesh, the inhabitants of Telangana and the warriors of Dravir and Surat were destroyed.505.",
      "punjabiViakhya": "ਸੂਰਤ ਦੇਸ਼ ਦੇ ਵਾਸੀ, ਭੰਗੀ ਅਤੇ ਫਿਰੰਗੀ ਮਾਰੇ ਗਏ ਹਨ ॥੫੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "हते सूरती जंग भंगी फिरंगी ॥५०५॥",
      "sourceLineId": "100076",
      "sourceShabadId": "9263",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚਪੇ ਚਾਦ ਰਾਜਾ ਚਲੇ ਚਾਦ ਬਾਸੀ ॥",
      "transliteration": "chape chaadh raajaa chale chaadh baasee ||",
      "translation": "",
      "punjabiViakhya": "ਚਾਦਪੁਰ ਦਾ ਰਾਜਾ ਅੜਿਆ ਹੈ ਪਰ ਚੰਦੇਲੇ ਨਾਲ ਤੁਰ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "चपे चाद राजा चले चाद बासी ॥",
      "sourceLineId": "100077",
      "sourceShabadId": "9263",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਡੇ ਬੀਰ ਬਈਦਰਭਿ ਸੰਰੋਸ ਰਾਸੀ ॥",
      "transliteration": "badde beer bieedharabh sa(n)ros raasee ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਵੱਡੇ ਬਹਾਦਰ ਵੈਦਰਭ ਦੇ ਨਿਵਾਸੀ ਅਤੇ ਰਾਜਾ ਜੋ ਰੋਸ ਦੀ ਰਾਸ ਹੈ (ਹਾਰ ਮੰਨ ਗਏ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "बडे बीर बईदरभि संरोस रासी ॥",
      "sourceLineId": "100078",
      "sourceShabadId": "9263",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਿਤੇ ਦਛਨੀ ਸੰਗ ਲਿਨੇ ਸੁਧਾਰੰ ॥",
      "transliteration": "jite dhachhanee sa(n)g line sudhaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਤਨੇ ਦੱਖਣ ਦੇਸ਼ (ਦੇ ਵਿਅਕਤੀ ਸਨ) ਉਨ੍ਰਹਾ ਨੂੰ ਨਾਲ ਲੈ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "जिते दछनी संग लिने सुधारं ॥",
      "sourceLineId": "100079",
      "sourceShabadId": "9263",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦਿਸਾ ਪ੍ਰਾਚਿਯੰ ਕੋਪਿ ਕੀਨੋ ਸਵਾਰੰ ॥੫੦੬॥",
      "transliteration": "dhisaa praachiya(n) kop keeno savaara(n) ||506||",
      "translation": "The honour of the king of Chand town mashed, the kings of Vidarbha country were suppressed in great ire after conquering and chastising the South, the Lord Kalki journeyed towards the East.506.",
      "punjabiViakhya": "(ਹੁਣ) ਪੂਰਬ ਦਿਸ਼ਾ ਨੂੰ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਜਿਤਣ ਲਈ ਸਵਾਰ ਹੋਏ ਹਨ ॥੫੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "दिसा प्राचियं कोपि कीनो सवारं ॥५०६॥",
      "sourceLineId": "100080",
      "sourceShabadId": "9263",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਕਲਕੀ ਅਵਤਾਰ ਦਛਨ ਜੈ ਬਿਜਯ ਨਾਮ ਦੂਜਾ ਧਿਆਯ ਸਮਾਪਤੰ ॥੨॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the kalakee avataar dhachhan jai bijay naam dhoojaa dhiaay samaapata(n) ||2||",
      "translation": "End of the second chapter entitled “Kalki Incarnation, Victory over the South” in Bachittar Natak.2.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ ਕਲਕੀ ਅਵਤਾਰ ਦੇ ਦੱਛਣ ਦੇਸ਼ ਜੈ ਵਿਜੈ ਨਾ ਵਾਲੇ ਦੂਜੇ ਅਧਿਆਇ ਦੀ ਸਮਾਪਤੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे कलकी अवतार दछन जै बिजय नाम दूजा धिआय समापतं ॥२॥",
      "sourceLineId": "100081",
      "sourceShabadId": "9263",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪਾਧਰੀ ਛੰਦ ॥",
      "transliteration": "paadharee chha(n)dh ||",
      "translation": "PAADHARI STANZA (Now begins the description of the fighting in the East)",
      "punjabiViakhya": "ਪਾਧਰੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "पाधरी छंद ॥",
      "sourceLineId": "100082",
      "sourceShabadId": "9264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪਛਮਹਿ ਜੀਤਿ ਦਛਨ ਉਜਾਰਿ ॥",
      "transliteration": "pachhameh jeet dhachhan ujaar ||",
      "translation": "",
      "punjabiViakhya": "ਪੱਛਮ ਨੂੰ ਜਿਤ ਕੇ ਅਤੇ ਦੱਖਣ ਨੂੰ ਉਜਾੜ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "पछमहि जीति दछन उजारि ॥",
      "sourceLineId": "100083",
      "sourceShabadId": "9264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕੋਪਿਓ ਕਛੂਕੁ ਕਲਕੀ ਵਤਾਰ ॥",
      "transliteration": "kopio kachhook kalakee vataar ||",
      "translation": "",
      "punjabiViakhya": "ਕਲਕੀ ਅਵਤਾਰ ਨੂੰ ਕੁਝ ਕੁ ਕ੍ਰੋਧ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "कोपिओ कछूकु कलकी वतार ॥",
      "sourceLineId": "100084",
      "sourceShabadId": "9264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕੀਨੋ ਪਯਾਣ ਪੂਰਬ ਦਿਸਾਣ ॥",
      "transliteration": "keeno payaan poorab dhisaan ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਪੂਰਬ ਦਿਸ਼ਾ ਵਲ ਚੜ੍ਰਹਾਈ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "कीनो पयाण पूरब दिसाण ॥",
      "sourceLineId": "100085",
      "sourceShabadId": "9264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਜੀਅ ਜੈਤ ਪਤ੍ਰੰ ਨਿਸਾਣ ॥੫੦੭॥",
      "transliteration": "bajeea jait patra(n) nisaan ||507||",
      "translation": "After conquering the West and devastating the South, Kalki incarnation went towards the East and his trumpets of victory sounded.507.",
      "punjabiViakhya": "ਅਤੇ ਜਿਤ ਪ੍ਰਾਪਤੀ ਦੇ ਨਗਾਰੇ ਵਜਣ ਲਗੇ ॥੫੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "बजीअ जैत पत्रं निसाण ॥५०७॥",
      "sourceLineId": "100086",
      "sourceShabadId": "9264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਾਗਧਿ ਮਹੀਪ ਮੰਡੇ ਮਹਾਨ ॥",
      "transliteration": "maagadh maheep ma(n)dde mahaan ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਧ ਦੇ ਰਾਜੇ ਨੇ ਬਹੁਤ ਵੱਡਾ ਯੁੱਧ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "मागधि महीप मंडे महान ॥",
      "sourceLineId": "100087",
      "sourceShabadId": "9264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦਸ ਚਾਰ ਚਾਰੁ ਬਿਦਿਯਾ ਨਿਧਾਨ ॥",
      "transliteration": "dhas chaar chaar bidhiyaa nidhaan ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ੧੮ ਵਿਦਿਆਵਾ ਦਾ ਖ਼ਜ਼ਾਨਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "दस चार चारु बिदिया निधान ॥",
      "sourceLineId": "100088",
      "sourceShabadId": "9264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬੰਗੀ ਕਲਿੰਗ ਅੰਗੀ ਅਜੀਤ ॥",
      "transliteration": "ba(n)gee kali(n)g a(n)gee ajeet ||",
      "translation": "",
      "punjabiViakhya": "ਬੰਗ, ਕਲਿੰਗ, ਅੰਗ,",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "बंगी कलिंग अंगी अजीत ॥",
      "sourceLineId": "100089",
      "sourceShabadId": "9264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮੋਰੰਗ ਅਗੋਰ ਨਯਪਾਲ ਅਭੀਤ ॥੫੦੮॥",
      "transliteration": "mora(n)g agor nayapaal abheet ||508||",
      "translation": "There he met the kings of Magadha, who were experts in eighteen sciences, on that side there were also fearless kings of Bang, Kaling, Nepal etc.508.",
      "punjabiViakhya": "ਮੋਰੰਗ, ਅਗੋਰ, ਨੈਪਾਲ ਦੇ ਨਿਡਰ ਅਤੇ ਅਜਿਤ ਰਾਜੇ ॥੫੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "मोरंग अगोर नयपाल अभीत ॥५०८॥",
      "sourceLineId": "100090",
      "sourceShabadId": "9264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਛਜਾਦਿ ਕਰਣ ਇਕਾਦ ਪਾਵ ॥",
      "transliteration": "chhajaadh karan ikaadh paav ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਛਜਾਦ, ਕਰਣ ਅਤੇ ਇਕਾਦਪਾਵ (ਆਦਿਕ ਖੇਤਰਾ)",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "छजादि करण इकाद पाव ॥",
      "sourceLineId": "100091",
      "sourceShabadId": "9264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਾਰੇ ਮਹੀਪ ਕਰ ਕੈ ਉਪਾਵ ॥",
      "transliteration": "maare maheep kar kai upaav ||",
      "translation": "",
      "punjabiViakhya": "ਦੇ ਰਾਜੇ (ਕਲਕੀ ਨੇ) ਉਪਾਉ ਕਰ ਕੇ ਮਾਰ ਸੁਟੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "मारे महीप कर कै उपाव ॥",
      "sourceLineId": "100092",
      "sourceShabadId": "9264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਖੰਡੇ ਅਖੰਡ ਜੋਧਾ ਦੁਰੰਤ ॥",
      "transliteration": "kha(n)dde akha(n)dd jodhaa dhura(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਨਾ ਖੰਡੇ ਜਾ ਸਕਣ ਵਾਲੇ ਬੇਅੰਤ ਯੋਧੇ ਨਸ਼ਟ ਕਰ ਦਿੱਤੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "खंडे अखंड जोधा दुरंत ॥",
      "sourceLineId": "100093",
      "sourceShabadId": "9264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਲਿਨੋ ਛਿਨਾਇ ਪੂਰਬੁ ਪਰੰਤ ॥੫੦੯॥",
      "transliteration": "lino chhinai poorab para(n)t ||509||",
      "translation": "Many kings who were equal in authority like Yaksha, were killed by adopting suitable measures and in this way, cruel warriors were killed and the land of the East was also snatched.509.",
      "punjabiViakhya": "ਅਤੇ ਪੂਰਬ ਤਕ ('ਪਰੰਤ') ਦਾ (ਸਾਰਾ ਖੇਤਰ) ਖੋਹ ਲਿਆ ਹੈ ॥੫੦੯॥",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "लिनो छिनाइ पूरबु परंत ॥५०९॥",
      "sourceLineId": "100094",
      "sourceShabadId": "9264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦਿਨੋ ਨਿਕਾਰ ਰਾਛਸ ਦ੍ਰੁਬੁਧ ॥",
      "transliteration": "dhino nikaar raachhas dhrubudh ||",
      "translation": "",
      "punjabiViakhya": "ਦੁਰਬੁਧ ਰਾਖਸ਼ਾ ਨੂੰ (ਦੇਸੋਂ) ਕਢ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "दिनो निकार राछस द्रुबुध ॥",
      "sourceLineId": "100095",
      "sourceShabadId": "9264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਿਨੋ ਪਯਾਨ ਉਤਰ ਸੁਕ੍ਰੁਧ ॥",
      "transliteration": "kino payaan utar sukrudh ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ ਕਲਕੀ ਅਵਤਾਰ ਨੇ) ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਉੱਤਰ ਦਿਸ਼ਾ ਵਲ ਚੜ੍ਰਹਾਈ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "किनो पयान उतर सुक्रुध ॥",
      "sourceLineId": "100096",
      "sourceShabadId": "9264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮੰਡੇ ਮਹੀਪ ਮਾਵਾਸ ਥਾਨ ॥",
      "transliteration": "ma(n)dde maheep maavaas thaan ||",
      "translation": "",
      "punjabiViakhya": "ਆਕੀ ਰਾਜਿਆਂ ਦੇ ਸਥਾਨਾ (ਦੇਸ਼ਾ) ਉਤੇ ਯੁੱਧ ਮਚਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "मंडे महीप मावास थान ॥",
      "sourceLineId": "100097",
      "sourceShabadId": "9264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਖੰਡੇ ਅਖੰਡ ਖੂਨੀ ਖੁਰਾਨ ॥੫੧੦॥",
      "transliteration": "kha(n)dde akha(n)dd khoonee khuraan ||510||",
      "translation": "The demons of evil intellect were killed and turned towards the North in great anger and after killing many dangerous kings, bestowed their kingdom on others.510.",
      "punjabiViakhya": "ਅਤੇ ਨਾ ਖੰਡੇ ਜਾਣ ਵਾਲੇ ਖ਼ੂਨੀ ਅਤੇ ਖਰਾਟ ਰਾਜਿਆਂ ਨੂੰ ਟੋਟੇ ਟੋਟੇ ਕਰ ਦਿੱਤਾ ॥੫੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "खंडे अखंड खूनी खुरान ॥५१०॥",
      "sourceLineId": "100098",
      "sourceShabadId": "9264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਕਲਕੀ ਵਤਾਰ ਪੂਰਬ ਜੀਤ ਬਿਜਯ ਨਾਮ ਤੀਜਾ ਧਿਆਯ ਸਮਾਪਤੰ ॥੩॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the kalakee vataar poorab jeet bijay naam teejaa dhiaay samaapata(n) ||3||",
      "translation": "End of the chapter third entitled “Victory over the East” in Kalki incarmnation in Bachittar Natak.3.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ ਕਲਕੀ ਅਵਤਾਰ ਦੇ ਪੂਰਬ ਦਿਸ਼ਾ ਜੀਤ ਬਿਜਯ ਨਾ ਵਾਲੇ ਤੀਜੇ ਅਧਿਆਇ ਦੀ ਸਮਾਪਤੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे कलकी वतार पूरब जीत बिजय नाम तीजा धिआय समापतं ॥३॥",
      "sourceLineId": "100099",
      "sourceShabadId": "9264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪਾਧਰੀ ਛੰਦ ॥",
      "transliteration": "paadharee chha(n)dh ||",
      "translation": "PAADHARI STANZA",
      "punjabiViakhya": "ਪਾਧਰੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "पाधरी छंद ॥",
      "sourceLineId": "100100",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਪੂਰਬ ਪਟਨ ਉਪਟਿ ॥",
      "transliteration": "eeh bhaat poorab paTan upaT ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਪੂਰਬ ਦਿਸ਼ਾ ਦੇ ਨਗਰਾ ਨੂੰ ਉਜਾੜ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "इह भाति पूरब पटन उपटि ॥",
      "sourceLineId": "100101",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਖੰਡੇ ਅਖੰਡ ਕਟੇ ਅਕਟ ॥",
      "transliteration": "kha(n)dde akha(n)dd kaTe akaT ||",
      "translation": "",
      "punjabiViakhya": "ਨਾ ਖੰਡੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਖੰਡਿਤ ਕਰ ਦਿੱਤਾ ਅਤੇ ਨਾ ਕਟੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਕਟ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "खंडे अखंड कटे अकट ॥",
      "sourceLineId": "100102",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਫਟੇ ਅਫਟ ਖੰਡੇ ਅਖੰਡ ॥",
      "transliteration": "faTe afaT kha(n)dde akha(n)dd ||",
      "translation": "",
      "punjabiViakhya": "ਨਾ ਪਾੜੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਪਾੜ ਦਿੱਤਾ ਅਤੇ ਨਾ ਖੰਡੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਖੰਡਿਤ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "फटे अफट खंडे अखंड ॥",
      "sourceLineId": "100103",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਜੇ ਨਿਸਾਨ ਮਚਿਓ ਘਮੰਡ ॥੫੧੧॥",
      "transliteration": "baje nisaan machio ghama(n)dd ||511||",
      "translation": "(Now begins the description of the twenty-fourth of the cities of the east and Killing the fighters of indestructible Glory the trumpets of Kalki incarnation sounded proudly.511.",
      "punjabiViakhya": "ਬਹੁਤ ਭਿਆਨਕ ਯੁੱਧ ਹੋਇਆ ਅਤੇ (ਖੂਬ) ਧੌਂਸੇ ਵਜੇ ॥੫੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "बजे निसान मचिओ घमंड ॥५११॥",
      "sourceLineId": "100104",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜੋਰੇ ਸੁ ਜੰਗ ਜੋਧਾ ਜੁਝਾਰ ॥",
      "transliteration": "jore su ja(n)g jodhaa jujhaar ||",
      "translation": "",
      "punjabiViakhya": "ਜੁਝਾਰੂ ਯੋਧੇ ਜੰਗ ਕਰਨ ਲਈ ਇਕੱਠੇ ਕਰ ਦਿੱਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "जोरे सु जंग जोधा जुझार ॥",
      "sourceLineId": "100105",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜੋ ਤਜੇ ਬਾਣ ਗਜਤ ਲੁਝਾਰ ॥",
      "transliteration": "jo taje baan gajat lujhaar ||",
      "translation": "The warriors were again absorbed in war and showered arrows while thundering",
      "punjabiViakhya": "ਜੋ ਬਾਣ ਛਡਦੇ ਹਨ ਅਤੇ ਲੜਦੇ ਹੋਏ ਲਲਕਾਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "जो तजे बाण गजत लुझार ॥",
      "sourceLineId": "100106",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭਾਜੰਤ ਭੀਰ ਭਹਰੰਤ ਭਾਇ ॥",
      "transliteration": "bhaaja(n)t bheer bhahara(n)t bhai ||",
      "translation": "",
      "punjabiViakhya": "ਘਬਰਾਹਟ ਦੇ ਭਾਵ ਨਾਲ ਡਰਪੋਕ ਲੋਕ ਭਜੇ ਜਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "भाजंत भीर भहरंत भाइ ॥",
      "sourceLineId": "100107",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭਭਕੰਤ ਘਾਇ ਡਿੱਗੇ ਅਘਾਇ ॥੫੧੨॥",
      "transliteration": "bhabhaka(n)t ghai ddi'ge aghai ||512||",
      "translation": "The cowards ran away in fear and their wounds burst.512.",
      "punjabiViakhya": "ਘਾਇਲ ਹੋ ਕੇ ਡਿਗਦੇ ਹਨ ਅਤੇ (ਉਨ੍ਰਹਾ ਦੇ ਜ਼ਖ਼ਮਾ ਵਿਚੋਂ) ਲਹੂ ਭਕ ਭਕ ਕਰ ਕੇ ਨਿਕਲਦਾ ਹੈ ॥੫੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "भभकंत घाइ डिग्गे अघाइ ॥५१२॥",
      "sourceLineId": "100108",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਾਜੰਤ ਸਾਜ ਬਾਜਤ ਤੁਫੰਗ ॥",
      "transliteration": "saaja(n)t saaj baajat tufa(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਜ਼ਾ ਨੂੰ ਸਜਾਉਾਂਦੇ ਹਨ, ਬੰਦੂਕਾ (ਦੀਆਂ ਗੋਲੀਆਂ) ਵਜਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 602,
      "hindi": "",
      "hindiTransliteration": "साजंत साज बाजत तुफंग ॥",
      "sourceLineId": "100109",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0602_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਚੰਤ ਭੂਤ ਭੈਧਰ ਸੁਰੰਗ ॥",
      "transliteration": "naacha(n)t bhoot bhaidhar sura(n)g ||",
      "translation": "The warriors were bedecked",
      "punjabiViakhya": "ਭਿਆਨਕ ਅਤੇ (ਲਹੂ ਦੇ ਲਾਲ ਰੰਗ ਵਿਚ) ਚੰਗੀ ਤਰ੍ਰਹਾ ਰੰਗੇ ਹੋਏ ਭੂਤ ਨਚਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 602,
