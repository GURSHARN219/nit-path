{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 603,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0603_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕ੍ਰੀੜੰਤ ਈਸ ਪੋਅੰਤ ਕਪਾਲ ॥",
      "transliteration": "kreeRa(n)t iees poa(n)t kapaal ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ (ਯੁੱਧ-ਭੂਮੀ ਵਿਚ) ਕ੍ਰੀੜਾ ਕਰ ਰਿਹਾ ਹੈ (ਅਤੇ ਮਾਲਾ ਵਿਚ) ਖੋਪੜੀਆਂ ਪਰੋ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "क्रीड़ंत ईस पोअंत कपाल ॥",
      "sourceLineId": "100115",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਿਰਖਤ ਬੀਰ ਛਕਿ ਬਰਤ ਬਾਲ ॥੫੧੪॥",
      "transliteration": "nirakhat beer chhak barat baal ||514||",
      "translation": "The ghosts, fiends and Baitals danced, the Shiva, engaged in Sport, began to string the rosaries of skulls and the warriors looking at the heavenly damsels covetously, wedded them.514.",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਨੂੰ ਵੇਖ ਕੇ ਅਪੱਛਰਾਵਾ ਖੁਸ਼ ਹੋ ਕੇ (ਉਨ੍ਰਹਾ ਨੂੰ) ਵਰ ਰਹੀਆਂ ਹਨ ॥੫੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "निरखत बीर छकि बरत बाल ॥५१४॥",
      "sourceLineId": "100116",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਧਾਵੰਤ ਬੀਰ ਬਾਹੰਤ ਘਾਵ ॥",
      "transliteration": "dhaava(n)t beer baaha(n)t ghaav ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧੇ ਭਜੇ ਫਿਰਦੇ ਹਨ (ਅਤੇ ਉਨ੍ਰਹਾ ਦੇ) ਜ਼ਖ਼ਮਾ ਵਿਚੋਂ (ਲਹੂ) ਵਗ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "धावंत बीर बाहंत घाव ॥",
      "sourceLineId": "100117",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾਚੰਤ ਭੂਤ ਗਾਵੰਤ ਚਾਵ ॥",
      "transliteration": "naacha(n)t bhoot gaava(n)t chaav ||",
      "translation": "The warriors, inflicting wounds are falling upon the opponents and the ghosts are dancing and singing with zeal",
      "punjabiViakhya": "ਭੂਤ ਚਾਉ ਨਾਲ ਗਾਉਾਂਦੇ ਅਤੇ ਨਚਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "नाचंत भूत गावंत चाव ॥",
      "sourceLineId": "100118",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਡਮਕੰਤ ਡਉਰੁ ਨਾਚੰਤ ਈਸ ॥",
      "transliteration": "ddamaka(n)t ddaur naacha(n)t iees ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਡੌਰੂ ਵਜਾ ਕੇ ਨਚ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "डमकंत डउरु नाचंत ईस ॥",
      "sourceLineId": "100119",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰੀਝੰਤ ਹਿਮਦ੍ਰਿ ਅੰਤ ਸੀਸ ॥੫੧੫॥",
      "transliteration": "reejha(n)t himadhr a(n)t sees ||515||",
      "translation": "Shiva is dancing while playing on his tabor.515.",
      "punjabiViakhya": "ਪਾਰਬਤੀ ('ਹਿਮਦ੍ਰਿ') ਰੀਝ ਰਹੀ ਹੈ ਅਤੇ ਮੁੰਡਾ (ਨੂੰ ਮਾਲਾ ਵਿਚ) ਪਰੋ ਰਹੀ ਹੈ ॥੫੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "रीझंत हिमदृ अंत सीस ॥५१५॥",
      "sourceLineId": "100120",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੰਧ੍ਰਭ ਸਿਧ ਚਾਰਣ ਪ੍ਰਸਿਧ ॥",
      "transliteration": "ga(n)dhrabh sidh chaaran prasidh ||",
      "translation": "",
      "punjabiViakhya": "ਗੰਧਰਬ, ਸਿੱਧ, ਪ੍ਰਸਿੱਧ ਚਾਰਣ (ਸੂਰਮਿਆਂ ਅਥਵਾ ਕਲਕੀ ਦੇ ਯਸ਼ ਦੇ)",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "गंध्रभ सिध चारण प्रसिध ॥",
      "sourceLineId": "100121",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਥੰਤ ਕਾਬਿ ਸੋਭੰਤ ਸਿਧ ॥",
      "transliteration": "katha(n)t kaab sobha(n)t sidh ||",
      "translation": "The famous Gandharvas, the minstrels and adepts are composing poems in appreciation of war",
      "punjabiViakhya": "ਕਬਿੱਤ ਕਥਨ ਕਰ ਰਹੇ ਹਨ ਅਤੇ ਸਿੱਧ ਲੋਕ ਸ਼ੋਭਾ ਪਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "कथंत काबि सोभंत सिध ॥",
      "sourceLineId": "100122",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗਾਵੰਤ ਬੀਨ ਬੀਨਾ ਬਜੰਤ ॥",
      "transliteration": "gaava(n)t been beenaa baja(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਬੀਨ ('ਬੀਨ') (ਅਪੱਛਰਾਵਾ) ਗੀਤ ਗਾ ਰਹੀਆਂ ਹਨ ਅਤੇ ਬੀਣਾ ਵਜਾ ਰਹੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "गावंत बीन बीना बजंत ॥",
      "sourceLineId": "100123",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰੀਝੰਤ ਦੇਵ ਮੁਨਿ ਮਨਿ ਡੁਲੰਤ ॥੫੧੬॥",
      "transliteration": "reejha(n)t dhev mun man ddula(n)t ||516||",
      "translation": "The gods playing their lyres, are pleasing the mind of sages.516.",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨੂੰ ਵੇਖ ਕੇ) ਦੇਵ ਰੀਝ ਰਹੇ ਹਨ ਅਤੇ ਮੁਨੀਆਂ ਦੇ ਮਨ ਡੋਲ ਰਹੇ ਹਨ ॥੫੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "रीझंत देव मुनि मनि डुलंत ॥५१६॥",
      "sourceLineId": "100124",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗੁੰਜਤ ਗਜਿੰਦ੍ਰ ਹੈਵਰ ਅਸੰਖ ॥",
      "transliteration": "gu(n)jat gaji(n)dhr haivar asa(n)kh ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਡੇ ਵੱਡੇ ਹਾਥੀ ਚਿੰਘਾੜਦੇ ਹਨ, ਅਸੰਖਾ ਘੋੜੇ (ਹਿਣਕ ਰਹੇ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "गुँजत गजिंद्र हैवर असंख ॥",
      "sourceLineId": "100125",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬੁਲਤ ਸੁਬਾਹ ਮਾਰੂ ਬਜੰਤ ॥",
      "transliteration": "bulat subaeh maaroo baja(n)t ||",
      "translation": "There is sound of innumerable elephants and horses and the drums of war are being played",
      "punjabiViakhya": "ਚੰਗੀ ਡੀਲ ਡੌਲ ਵਾਲੇ ਛਤ੍ਰੀ ਲਲਕਾਰਦੇ ਹਨ ਅਤੇ ਮਾਰੂ ਵਜਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "बुलत सुबाह मारू बजंत ॥",
      "sourceLineId": "100126",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਉਠੰਤ ਨਾਦ ਪੂਰਤ ਦਿਸਾਣੰ ॥",
      "transliteration": "auTha(n)t naadh poorat dhisaana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਇਤਨਾ) ਨਾਦ ਹੋ ਰਿਹਾ ਹੈ (ਜਿਸ ਨਾਲ) ਸਾਰੀਆਂ ਦਿਸ਼ਾਵਾ ਭਰੀਆਂ ਗਈਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "उठंत नाद पूरत दिसाणं ॥",
      "sourceLineId": "100127",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਡੁਲਤ ਮਹੇਾਂਦ੍ਰ ਮਹਿ ਧਰ ਮਹਾਣੰ ॥੫੧੭॥",
      "transliteration": "ddulat maheaa(n)dhr meh dhar mahaana(n) ||517||",
      "translation": "The sound is spreading in all the directions and the Sheshnaga is wavering on felling the loss of Dharma.517.",
      "punjabiViakhya": "ਵੱਡੇ ਵੱਡੇ ਰਾਜੇ ਅਤੇ ਭੂਮੀਏ ਡੋਲਦੇ ਫਿਰ ਰਹੇ ਹਨ ॥੫੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "डुलत महेाँद्र महि धर महाणं ॥५१७॥",
      "sourceLineId": "100128",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਖੁਲੰਤ ਖੇਤਿ ਖੂਨੀ ਖਤੰਗ ॥",
      "transliteration": "khula(n)t khet khoonee khata(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਅਮੰਡ' ਲਹੂ ਪੀਣੇ ਤੀਰ ('ਖਤੰਗ') ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਖੁਲ੍ਰਹ ਰਹੇ ਹਨ (ਅਰਥਾਤ-ਚਲ ਰਹੇ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "खुलंत खेति खूनी खतंग ॥",
      "sourceLineId": "100129",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਛੁਟੰਤ ਬਾਣ ਜੁਟੇ ਨਿਸੰਗ ॥",
      "transliteration": "chhuTa(n)t baan juTe nisa(n)g ||",
      "translation": "The bloody swords have been drawn in the battlefield and the arrows are being discharged fearlessly",
      "punjabiViakhya": "ਬਾਣ ਛੁਟ ਰਹੇ ਹਨ ਅਤੇ (ਯੋਧੇ) ਨਿਸੰਗ ਹੋ ਕੇ (ਯੁੱਧ-ਕਰਮ ਵਿਚ) ਜੁਟੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "छुटंत बाण जुटे निसंग ॥",
      "sourceLineId": "100130",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਭਿਦੰਤ ਮਰਮ ਜੁਝਤ ਸੁਬਾਹ ॥",
      "transliteration": "bhidha(n)t maram jujhat subaeh ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਗਿਆਂ ਸੂਰਮਿਆਂ ਦੇ ਨਾਜ਼ਕ ਅੰਗਾ ਨੂੰ ਵਿੰਨ੍ਰਹ ਦਿੰਦੇ ਹਨ ਅਤੇ (ਉਹ) ਜੂਝ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "भिदंत मरम जुझत सुबाह ॥",
      "sourceLineId": "100131",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਘੁਮੰਤ ਗੈਣਿ ਅਛ੍ਰੀ ਉਛਾਹ ॥੫੧੮॥",
      "transliteration": "ghuma(n)t gain achhree uchhaeh ||518||",
      "translation": "The warriors are fighting and their secret parts are touching each other, the heavenly damsels are roaming in the sky enthusiastically.518.",
      "punjabiViakhya": "ਉਤਸਾਹ ਨਾਲ ਭਰੀਆਂ ਅਪੱਛਰਾਵਾ ਆਕਾਸ਼ ਵਿਚ ਘੁੰਮ ਰਹੀਆਂ ਹਨ ॥੫੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "घुमंत गैणि अछ्री उछाह ॥५१८॥",
      "sourceLineId": "100132",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਰਖੰਤ ਸੇਲ ਬਰਖੰਤ ਬਾਣ ॥",
      "transliteration": "sarakha(n)t sel barakha(n)t baan ||",
      "translation": "",
      "punjabiViakhya": "(ਯੋਧੇ) ਬਰਛਿਆਂ ਨੂੰ (ਅਗੇ ਵਲ) ਸਰਕਾ ਰਹੇ ਹਨ, ਬਾਣਾ ਦੀ ਬਰਖਾ ਕਰ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "सरखंत सेल बरखंत बाण ॥",
      "sourceLineId": "100133",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹਰਖੰਤ ਹੂਰ ਪਰਖੰਤ ਜੁਆਣ ॥",
      "transliteration": "harakha(n)t hoor parakha(n)t juaan ||",
      "translation": "There are showers of lances and arrows and seeing the warriors, the heavenly damsels are getting pleased",
      "punjabiViakhya": "ਹੂਰਾ ਖੁਸ਼ ਹੋ ਰਹੀਆਂ ਹਨ, ਜੁਆਨਾ ਨੂੰ ਪਰਖ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "हरखंत हूर परखंत जुआण ॥",
      "sourceLineId": "100134",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਾਜੰਤ ਢੋਲ ਡਉਰੂ ਕਰਾਲ ॥",
      "transliteration": "baaja(n)t ddol ddauroo karaal ||",
      "translation": "",
      "punjabiViakhya": "ਭਿਆਨਕ ਡੌਰੂ ਅਤੇ ਢੋਲ ਵਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "बाजंत ढोल डउरू कराल ॥",
      "sourceLineId": "100135",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਾਚੰਤ ਭੂਤ ਭੈਰੋ ਕਪਾਲਿ ॥੫੧੯॥",
      "transliteration": "naacha(n)t bhoot bhairo kapaal ||519||",
      "translation": "The drums and dreadful tabors are being and the ghosts and Bhairavas are dancing.519.",
      "punjabiViakhya": "ਭੂਤ, ਭੈਰੋ ਅਤੇ ਕਪਾਲੀ (ਦੇਵੀ) ਨਚ ਰਹੀ ਹੈ ॥੫੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "नाचंत भूत भैरो कपालि ॥५१९॥",
      "sourceLineId": "100136",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਰੜੰਤ ਹਥ ਖਰੜੰਤ ਖੋਲ ॥",
      "transliteration": "haraRa(n)t hath kharaRa(n)t khol ||",
      "translation": "",
      "punjabiViakhya": "ਹੱਥ ਹਿਲ ਰਹੇ ਹਨ, ਟੋਪ (ਅਥਵਾ ਖੋਲ) ਖੜਕ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "हरड़ंत हथ खरड़ंत खोल ॥",
      "sourceLineId": "100137",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਟਿਰੜੰਤ ਟੀਕ ਝਿਰੜੰਤ ਝੋਲ ॥",
      "transliteration": "TiraRa(n)t Teek jhiraRa(n)t jhol ||",
      "translation": "The knocking sound of the sheaths and the clattering of swords is being heard",
      "punjabiViakhya": "(ਹਾਥੀਆਂ, ਘੋੜਿਆਂ ਦੇ ਮੱਥੇ ਉਤੇ ਬੰਨ੍ਰਹੇ ਲੋਹੇ ਦੇ) ਟਿੱਕੇ ਟੁੱਟ ਰਹੇ ਹਨ ਅਤੇ ਫੁਲਾਦੀ ਝੁਲਾ ਫਟ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "टिरड़ंत टीक झिरड़ंत झोल ॥",
      "sourceLineId": "100138",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦਰੜੰਤ ਦੀਹ ਦਾਨੋ ਦੁਰੰਤ ॥",
      "transliteration": "dharaRa(n)t dheeh dhaano dhura(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੰਤ ਵਡਾਕਾਰੇ ਦੈਂਤ ਦਰੜੇ ਜਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "दरड़ंत दीह दानो दुरंत ॥",
      "sourceLineId": "100139",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹਰੜੰਤ ਹਾਸ ਹਸਤ ਮਹੰਤ ॥੫੨੦॥",
      "transliteration": "haraRa(n)t haas hasat maha(n)t ||520||",
      "translation": "The terrible demons are being crushed and the ganas and others are laughing loudly.520.",
      "punjabiViakhya": "ਮਹੰਤ ਲੋਕ ਹੜ ਹੜ ਕਰ ਕੇ ਹਸ ਰਹੇ ਹਨ ॥੫੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "हरड़ंत हास हसत महंत ॥५२०॥",
      "sourceLineId": "100140",
      "sourceShabadId": "9265",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਉਤਭੁਜ ਛੰਦ ॥",
      "transliteration": "autabhuj chha(n)dh ||",
      "translation": "UTBHUJ STANZA",
      "punjabiViakhya": "ਉਤਭੁਜ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "उतभुज छंद ॥",
      "sourceLineId": "100141",
      "sourceShabadId": "9266",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਹਹਾਸੰ ਕਪਾਲੰ ॥",
      "transliteration": "hahaasa(n) kapaala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਪਾਲ ਹਸ ਰਿਹਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "हहासं कपालं ॥",
      "sourceLineId": "100142",
      "sourceShabadId": "9266",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੁ ਬਾਸੰ ਛਤਾਲੰ ॥",
      "transliteration": "s baasa(n) chhataala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਯੁੱਧ-ਭੂਮੀ ('ਛਤਾਲ') ਵਿਚ ਨਿਵਾਸ ਕਰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "सु बासं छतालं ॥",
      "sourceLineId": "100143",
      "sourceShabadId": "9266",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪ੍ਰਭਾਸੰ ਜ੍ਵਾਲੰ ॥",
      "transliteration": "prabhaasa(n) javaiaala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਫਬ ਵਾਲੀ ਜਵਾਲਾ ਵਾਗ",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "प्रभासं ज्वालं ॥",
      "sourceLineId": "100144",
      "sourceShabadId": "9266",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਨਾਸੰ ਕਰਾਲੰ ॥੫੨੧॥",
      "transliteration": "anaasa(n) karaala(n) ||521||",
      "translation": "The Kalki incarnation like Shiva, giver of happiness to all, mounting on his Bull, remained stable in the battlefield like the dreadful fires.521.",
      "punjabiViakhya": "ਅਤੇ ਕਲਿਆਣਕਾਰੀ ('ਅਨਾਸ') ਭਿਆਨਕ ਰੂਪ ਵਾਲਾ ਹੈ ॥੫੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "अनासं करालं ॥५२१॥",
      "sourceLineId": "100145",
      "sourceShabadId": "9266",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਹਾ ਰੂਪ ਧਾਰੇ ॥",
      "transliteration": "mahaa roop dhaare ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਸੁੰਦਰ ਰੂਪ ਧਾਰਿਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "महा रूप धारे ॥",
      "sourceLineId": "100146",
      "sourceShabadId": "9266",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦੁਰੰ ਦੁਖ ਤਾਰੇ ॥",
      "transliteration": "dhura(n) dhukh taare ||",
      "translation": "He, assuming his great benign form, was destroying the afflicting agonies",
      "punjabiViakhya": "ਭੈੜੇ ਦੁਖਾ ਤੋਂ ਬਚਾ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "दुरं दुख तारे ॥",
      "sourceLineId": "100147",
      "sourceShabadId": "9266",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਰੰਨੀ ਉਧਾਰੇ ॥",
      "transliteration": "sara(n)nee udhaare ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਰਨ ਵਿਚ ਆਇਆਂ ਨੂੰ ਉੱਧਾਰ ਦਿੱਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "सरंनी उधारे ॥",
      "sourceLineId": "100148",
      "sourceShabadId": "9266",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਘੀ ਪਾਪ ਵਾਰੇ ॥੫੨੨॥",
      "transliteration": "aghee paap vaare ||522||",
      "translation": "He was redeeming those who had taken shelter and was removing th effect of sin of the sinners.522.",
      "punjabiViakhya": "(ਭਾਵੇਾਂ ਉਹ) ਪਾਪ ਕਰਨ ਵਾਲੇ ਹੀ ਸਨ ॥੫੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "अघी पाप वारे ॥५२२॥",
      "sourceLineId": "100149",
      "sourceShabadId": "9266",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦਿਪੈ ਜੋਤਿ ਜ੍ਵਾਲਾ ॥",
      "transliteration": "dhipai jot javaiaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਗ ਦੀ ਲਾਟ ਵਾਗ ਸ਼ੋਭ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "दिपै जोति ज्वाला ॥",
      "sourceLineId": "100150",
      "sourceShabadId": "9266",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਿਧੌ ਜ੍ਵਾਲ ਮਾਲਾ ॥",
      "transliteration": "kidhau javaiaal maalaa ||",
      "translation": "He was unfolding brilliance like the fire or the roasary of fire",
      "punjabiViakhya": "ਜਾ ਜਵਾਲਾ ਦੀ ਹੀ ਮਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "किधौ ज्वाल माला ॥",
      "sourceLineId": "100151",
      "sourceShabadId": "9266",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਨੋ ਜ੍ਵਾਲ ਬਾਲਾ ॥",
      "transliteration": "mano javaiaal baalaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ 'ਜਵਾਲਾ' (ਪ੍ਰਕਾਸ਼) ਕਰਨ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "मनो ज्वाल बाला ॥",
      "sourceLineId": "100152",
      "sourceShabadId": "9266",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਰੂਪੰ ਕਰਾਲਾ ॥੫੨੩॥",
      "transliteration": "saroopa(n) karaalaa ||523||",
      "translation": "His dreadful form was radiating brightness like fire.523.",
      "punjabiViakhya": "(ਜਾ) ਭਿਆਨਕ (ਪਰ) ਸੁੰਦਰ ਰੂਪ ਵਾਲਾ ਹੈ ॥੫੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "सरूपं कराला ॥५२३॥",
      "sourceLineId": "100153",
      "sourceShabadId": "9266",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਧਰੇ ਖਗ ਪਾਣੰ ॥",
      "transliteration": "dhare khag paana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੱਥ ਵਿਚ ਤਲਵਾਰ ਧਾਰਨ ਕੀਤੀ ਹੋਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "धरे खग पाणं ॥",
      "sourceLineId": "100154",
      "sourceShabadId": "9266",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਿਹੂੰ ਲੋਗ ਮਾਣੰ ॥",
      "transliteration": "tihoo(n) log maana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਿੰਨਾ ਲੋਕਾ ਦਾ ਮਾਣ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "तिहूँ लोग माणं ॥",
      "sourceLineId": "100155",
      "sourceShabadId": "9266",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦਯੰ ਦੀਹ ਦਾਨੰ ॥",
      "transliteration": "dhaya(n) dheeh dhaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਅਧਿਕ ਦਾਨ ਦੇਣ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "दयं दीह दानं ॥",
      "sourceLineId": "100156",
      "sourceShabadId": "9266",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭਰੇ ਸਉਜ ਮਾਨੰ ॥੫੨੪॥",
      "transliteration": "bhare sauj maana(n) ||524||",
      "translation": "The Lord of all the three worlds took his dagger in his hand and in his pleasure, he destroyed the demons.524.",
      "punjabiViakhya": "ਮਾਣ ਦੀ ਸਾਮਗ੍ਰੀ (ਅਥਵਾ ਮੌਜ) ਨਾਲ ਭਰਿਆ ਹੋਇਆ ਹੈ ॥੫੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "भरे सउज मानं ॥५२४॥",
      "sourceLineId": "100157",
      "sourceShabadId": "9266",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਜੰਨ ਛੰਦ ॥",
      "transliteration": "aja(n)n chha(n)dh ||",
      "translation": "ANJAN STANZA",
      "punjabiViakhya": "ਅਜੰਨ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "अजंन छंद ॥",
      "sourceLineId": "100158",
      "sourceShabadId": "9267",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਜੀਤੇ ਜੀਤ ਜੀਤ ਕੈ ॥",
      "transliteration": "ajeete jeet jeet kai ||",
      "translation": "",
      "punjabiViakhya": "ਨ ਜਿਤੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਜਿਤ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "अजीते जीत जीत कै ॥",
      "sourceLineId": "100159",
      "sourceShabadId": "9267",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਭੀਰੀ ਭਾਜੇ ਭੀਰ ਹ੍ਵੈ ॥",
      "transliteration": "abheeree bhaaje bheer havai ||",
      "translation": "Conquering the invincible people and causing the warriors to run away like cowards and",
      "punjabiViakhya": "ਨਿਡਰ ('ਅਭੀਰੀ') ਵੀ ਕਾਇਰ ('ਭੀਰ') ਹੋ ਕੇ ਭਜ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "अभीरी भाजे भीर ह्वै ॥",
      "sourceLineId": "100160",
      "sourceShabadId": "9267",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਿਧਾਰੇ ਚੀਨ ਰਾਜ ਪੈ ॥",
      "transliteration": "sidhaare cheen raaj pai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਸਾਥੀਆਂ ਦੇ ਸਾਥੀ ਬਣ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "सिधारे चीन राज पै ॥",
      "sourceLineId": "100161",
      "sourceShabadId": "9267",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0603_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਥੋਈ ਸਰਬ ਸਾਥ ਕੈ ॥੫੨੫॥",
      "transliteration": "sathoiee sarab saath kai ||525||",
      "translation": "taking all his allies with him, he reached the kingdom of China.525.",
      "punjabiViakhya": "ਚੀਨ ਦੇ ਰਾਜ ਉਤੇ ਚੜ੍ਰਹਾਈ ਕਰ ਦਿੱਤੀ ਹੈ ॥੫੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 603,
      "hindi": "",
      "hindiTransliteration": "सथोई सरब साथ कै ॥५२५॥",
      "sourceLineId": "100162",
      "sourceShabadId": "9267",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
