{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 604,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0604_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਮੰਕੇ ਰਾਜਧਾਰੀ ਕੈ ॥",
      "transliteration": "tama(n)ke raajadhaaree kai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਿਆਂ ਦੇ ਰਾਜੇ (ਕਲਕੀ) ਕ੍ਰੋਧਵਾਨ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "तमंके राजधारी कै ॥",
      "sourceLineId": "100163",
      "sourceShabadId": "9267",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਜੀਲੇ ਰੋਹਵਾਰੀ ਕੈ ॥",
      "transliteration": "rajeele rohavaaree kai ||",
      "translation": "The angry and furious tone of the Kalki incarnation, who assumed royalty, is very queer",
      "punjabiViakhya": "ਅਤੇ ਕਠੋਰ ('ਰਜੀਲੇ') ਗੁੱਸੇ ਵਾਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "रजीले रोहवारी कै ॥",
      "sourceLineId": "100164",
      "sourceShabadId": "9267",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਾਟੀਲੇ ਕਾਮ ਰੂਪਾ ਕੈ ॥",
      "transliteration": "kaaTeele kaam roopaa kai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਕਾਮਰੂਪ ਦੇ ਕਟਵੇਾਂ ਹੁਸਨ ਵਾਲੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "काटीले काम रूपा कै ॥",
      "sourceLineId": "100165",
      "sourceShabadId": "9267",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕੰਬੋਜੇ ਕਾਸਕਾਰੀ ਕੈ ॥੫੨੬॥",
      "transliteration": "ka(n)boje kaasakaaree kai ||526||",
      "translation": "Before him, the beauty of the women of Kamroop with bewitching eyes and the charm of Kamboj country is devoid of radiance.526.",
      "punjabiViakhya": "ਜਾ ਕਾਸਕਾਰੀ ਦੇ ਕੰਬੋਜ ਹਨ ॥੫੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "कंबोजे कासकारी कै ॥५२६॥",
      "sourceLineId": "100166",
      "sourceShabadId": "9267",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਢਮੰਕੇ ਢੋਲ ਢਾਲੋ ਕੈ ॥",
      "transliteration": "ddama(n)ke ddol ddaalo kai ||",
      "translation": "",
      "punjabiViakhya": "ਢਾਲਾ ਦੇ ਹੀ ਢੋਲਾ ਤੋਂ ਡੰਮ ਡੰਮ ਦੀ ਆਵਾਜ਼ ਆ ਰਹੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "ढमंके ढोल ढालो कै ॥",
      "sourceLineId": "100167",
      "sourceShabadId": "9267",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਡਮੰਕੇ ਡੰਕ ਵਾਰੋ ਕੈ ॥",
      "transliteration": "ddama(n)ke dda(n)k vaaro kai ||",
      "translation": "His drums, are his shields, his blows are severe,",
      "punjabiViakhya": "ਜਾ ਢਾਲਾ ਉਤੇ (ਹਥਿਆਰਾ ਦੇ) ਡਗੇ ਵਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "डमंके डंक वारो कै ॥",
      "sourceLineId": "100168",
      "sourceShabadId": "9267",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਘਮੰਕੇ ਨੇਜ ਬਾਜਾ ਦੇ ॥",
      "transliteration": "ghama(n)ke nej baajaa dhe ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਨੇਜ਼ੇਬਾਜ਼ਾ ਦੀ ਘੁੰਮਕਾਰ ਪੈ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "घमंके नेज बाजा दे ॥",
      "sourceLineId": "100169",
      "sourceShabadId": "9267",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਮੰਕੇ ਤੀਰ ਤਾਜਾ ਦੇ ॥੫੨੭॥",
      "transliteration": "tama(n)ke teer taajaa dhe ||527||",
      "translation": "his musical instruments create loud sounds and his arrows raise anger and ire.527.",
      "punjabiViakhya": "ਜਾ ਤੀਰਅੰਦਾਜ਼ਾ ਦੇ ਤੀਰ ਵਜ ਰਹੇ ਹਨ ॥੫੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "तमंके तीर ताजा दे ॥५२७॥",
      "sourceLineId": "100170",
      "sourceShabadId": "9267",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪਾਧਰੀ ਛੰਦ ॥",
      "transliteration": "paadharee chha(n)dh ||",
      "translation": "PAADHARI STANZA",
      "punjabiViakhya": "ਪਾਧਰੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "पाधरी छंद ॥",
      "sourceLineId": "100171",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜੀਤੇ ਅਜੀਤ ਮੰਡੇ ਅਮੰਡ ॥",
      "transliteration": "jeete ajeet ma(n)dde ama(n)dd ||",
      "translation": "",
      "punjabiViakhya": "ਨ ਜਿਤੇ ਜਾ ਸਕਣ ਵਾਲੇ ਜਿਤ ਲਏ ਹਨ, ਨਾ ਮੰਡੇ ਜਾਣ ਵਾਲੇ ਮੰਡ ਦਿੱਤੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "जीते अजीत मंडे अमंड ॥",
      "sourceLineId": "100172",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤੋਰੇ ਅਤੋਰ ਖੰਡੇ ਅਖੰਡ ॥",
      "transliteration": "tore ator kha(n)dde akha(n)dd ||",
      "translation": "He conquered the unconquerable, established the unestablished",
      "punjabiViakhya": "ਨਾ ਟੁਟਣ ਵਾਲੇ ਤੋੜ ਦਿੱਤੇ ਹਨ, ਨਾ ਖੰਡੇ ਜਾ ਸਕਣ ਵਾਲੇ ਖੰਡ ਦਿੱਤੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "तोरे अतोर खंडे अखंड ॥",
      "sourceLineId": "100173",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭੰਨੇ ਅਭੰਨ ਭਜੇ ਅਭਜਿ ॥",
      "transliteration": "bha(n)ne abha(n)n bhaje abhaj ||",
      "translation": "",
      "punjabiViakhya": "ਨਾ ਭੰਨੇ ਜਾ ਸਕਣ ਵਾਲੇ ਭੰਨ ਦਿੱਤੇ ਹਨ, ਨਾ ਭਜਣ ਵਾਲਿਆਂ ਨੂੰ ਭਜਾ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "भंने अभंन भजे अभजि ॥",
      "sourceLineId": "100174",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਖਾਨੇ ਖਵਾਸ ਮਾਵਾਸ ਤਜਿ ॥੫੨੮॥",
      "transliteration": "khaane khavaas maavaas taj ||528||",
      "translation": "He broke the unbreakable and devided the indivisible, He broke the unbreakable and he destroyed those who resisted.528.",
      "punjabiViakhya": "ਆਕੀ ਲੋਕ ਸ਼ਾਹੀ ਘਰਾ ਨੂੰ ਛਡ ਕੇ ਭਜ ਗਏ ਹਨ ॥੫੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "खाने खवास मावास तजि ॥५२८॥",
      "sourceLineId": "100175",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੰਕੜੇ ਸੂਰ ਭੰਭਰੇ ਭੀਰ ॥",
      "transliteration": "sa(n)kaRe soor bha(n)bhare bheer ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਸਹਿਮ ('ਸੰਕੜੇ') ਗਏ ਹਨ, ਕਾਇਰ ਡਰ ਨਾਲ ਭਰ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "संकड़े सूर भंभरे भीर ॥",
      "sourceLineId": "100176",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਿਰਖੰਤ ਜੋਧ ਰੀਝੰਤ ਹੂਰ ॥",
      "transliteration": "nirakha(n)t jodh reejha(n)t hoor ||",
      "translation": "The heavenly damsels, seeing both the brave and coward warriors were getting pleased",
      "punjabiViakhya": "ਯੋਧਿਆਂ ਨੂੰ ਵੇਖ ਕੇ ਹੂਰਾ ਰੀਝ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "निरखंत जोध रीझंत हूर ॥",
      "sourceLineId": "100177",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਡਾਰੰਤ ਸੀਸ ਕੇਸਰ ਕਟੋਰਿ ॥",
      "transliteration": "ddaara(n)t sees kesar kaTor ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮਿਆਂ ਦੇ) ਸਿਰ ਉਤੇ ਕੇਸਰ, ਕਸਤੂਰੀ,",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "डारंत सीस केसर कटोरि ॥",
      "sourceLineId": "100178",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮ੍ਰਿਗ ਮਦ ਗੁਲਾਬ ਕਰਪੂਰ ਘੋਰਿ ॥੫੨੯॥",
      "transliteration": "mirag madh gulaab karapoor ghor ||529||",
      "translation": "They were all sprinkling roses, camphor nad saffron on the head of kalki incarnation.529.",
      "punjabiViakhya": "ਗੁਲਾਬ ਅਤੇ ਕਪੂਰ ਨੂੰ ਘੋਲ ਕੇ ਕਟੋਰੀ ਉਲਟ ਦਿੰਦੀਆਂ ਹਨ ॥੫੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "मृग मद गुलाब करपूर घोरि ॥५२९॥",
      "sourceLineId": "100179",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਜੀਤ ਤੀਨੰ ਦਿਸਾਣ ॥",
      "transliteration": "eeh bhaat jeet teena(n) dhisaan ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਤਿੰਨੇ ਦਿਸ਼ਾਵਾ ਜਿਤ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "इह भाति जीत तीनं दिसाण ॥",
      "sourceLineId": "100180",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਜਿਓ ਸੁਕੋਪ ਉਤਰ ਨਿਸਾਣ ॥",
      "transliteration": "bajio sukop utar nisaan ||",
      "translation": "In this way, after conquering the three directions the trumpet sounded in the North",
      "punjabiViakhya": "(ਫਿਰ) ਉੱਤਰ ਦਿਸ਼ਾ ਵਲ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਧੌਂਸਾ ਵਜਾਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "बजिओ सुकोप उतर निसाण ॥",
      "sourceLineId": "100181",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚਲੇ ਸੁ ਚੀਨ ਮਾਚੀਨ ਦੇਸਿ ॥",
      "transliteration": "chale su cheen maacheen dhes ||",
      "translation": "",
      "punjabiViakhya": "ਚੀਨ ਅਤੇ ਮਚੀਨ ਦੇਸਾ ਵਲ ਚੜ੍ਰਹਾਈ ਕਰ ਦਿੱਤੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "चले सु चीन माचीन देसि ॥",
      "sourceLineId": "100182",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਾਮੰਤ ਸੁਧ ਰਾਵਲੀ ਭੇਖ ॥੫੩੦॥",
      "transliteration": "saama(n)t sudh raavalee bhekh ||530||",
      "translation": "He went towards China and Manchuria, where there were people in the garb of Rawalpanthis.530.",
      "punjabiViakhya": "(ਜਿਥੇ) ਸ਼ੁੱਧ ਜੋਗੀਆਂ ਦੇ ਭੇਸ ਵਾਲੇ ਸਾਮੰਤ ਰਾਜ ਕਰਦੇ ਸਨ ॥੫੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "सामंत सुध रावली भेख ॥५३०॥",
      "sourceLineId": "100183",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਜੇ ਬਜੰਤ੍ਰ ਗਜੇ ਸੁਬਾਹ ॥",
      "transliteration": "baje baja(n)tr gaje subaeh ||",
      "translation": "",
      "punjabiViakhya": "ਵਾਜੇ ਵਜਦੇ ਹਨ, ਬਹਾਦਰ ਸੂਰਮੇ ਗਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "बजे बजंत्र गजे सुबाह ॥",
      "sourceLineId": "100184",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਾਵੰਤ ਦੇਖਿ ਅਛ੍ਰੀ ਉਛਾਹ ॥",
      "transliteration": "saava(n)t dhekh achhree uchhaeh ||",
      "translation": "The war-musical instruments were played and the warriors thundered",
      "punjabiViakhya": "ਸੂਰਬੀਰਾ ('ਸਾਵੰਤ') ਨੂੰ ਵੇਖ ਕੇ ਅਪੱਛਰਾਵਾ ਦਾ ਉਤਸਾਹ ਵਧਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "सावंत देखि अछ्री उछाह ॥",
      "sourceLineId": "100185",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰੀਝੰਤ ਦੇਵ ਅਦੇਵ ਸਰਬ ॥",
      "transliteration": "reejha(n)t dhev adhev sarab ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਦੇਵਤੇ ਅਤੇ ਦੈਂਤ ਰੀਝ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "रीझंत देव अदेव सरब ॥",
      "sourceLineId": "100186",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗਾਵੰਤ ਗੀਤ ਤਜ ਦੀਨ ਗਰਬ ॥੫੩੧॥",
      "transliteration": "gaava(n)t geet taj dheen garab ||531||",
      "translation": "Seeing the Lords, the heavenly damsels were filled with zeal, the gods and others, all were pleased and all of them, abandoning their pride began to sing songs.531.",
      "punjabiViakhya": "(ਵੈਰੀਆਂ ਨੇ) ਹੰਕਾਰ ਛਡ ਕੇ (ਕਲਕੀ ਦੇ ਯਸ਼ ਦੇ) ਗੀਤ ਗਾਣੇ ਸ਼ੁਰੂ ਕਰ ਦਿੱਤੇ ਹਨ ॥੫੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "गावंत गीत तज दीन गरब ॥५३१॥",
      "sourceLineId": "100187",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਜਿਓ ਸੁ ਸੈਣ ਸੁਣਿ ਚੀਨ ਰਾਜ ॥",
      "transliteration": "sajio su sain sun cheen raaj ||",
      "translation": "",
      "punjabiViakhya": "ਚੀਨ ਦੇ ਰਾਜੇ ਨੇ (ਕਲਕੀ ਦੀ ਆਮਦ) ਸੁਣ ਕੇ ਸੈਨਾ ਨੂੰ ਤਿਆਰ ਕਰ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "सजिओ सु सैण सुणि चीन राज ॥",
      "sourceLineId": "100188",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਜੇ ਬਜੰਤ੍ਰ ਸਰਬੰ ਸਮਾਜ ॥",
      "transliteration": "baje baja(n)tr saraba(n) samaaj ||",
      "translation": "Listening to the news about the arrival of the army, the king of China caused the war-horns to be sounded in all his territory",
      "punjabiViakhya": "ਸਾਰੇ (ਸੈਨਿਕ) ਸਮਾਜ ਨੇ ਯੁੱਧ ਦੇ ਵਾਜੇ ਵਜਾ ਦਿੱਤੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "बजे बजंत्र सरबं समाज ॥",
      "sourceLineId": "100189",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚਲੇ ਅਚਲ ਸਾਵੰਤ ਜੁਧ ॥",
      "transliteration": "chale achal saava(n)t judh ||",
      "translation": "",
      "punjabiViakhya": "ਦ੍ਰਿੜ੍ਰਹ ('ਅਚਲ') ਯੋਧੇ ਯੁੱਧ ਲਈ ਚਲ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "चले अचल सावंत जुध ॥",
      "sourceLineId": "100190",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਰਖੰਤ ਬਾਣ ਭਰ ਲੋਹ ਕ੍ਰੁਧ ॥੫੩੨॥",
      "transliteration": "barakha(n)t baan bhar loh krudh ||532||",
      "translation": "All the warriors marched for the war and in their fury, they began to discharge arrows.532.",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਨਾਲ ਲੋਹੇ ਲਾਖੇ ਹੋ ਕੇ ਬਾਣਾ ਦੀ ਬਰਖਾ ਕਰਦੇ ਹਨ ॥੫੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "बरखंत बाण भर लोह क्रुध ॥५३२॥",
      "sourceLineId": "100191",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਖੁਲੇ ਖਤੰਗ ਖੂਨੀ ਖਤ੍ਰਿਹਾਣ ॥",
      "transliteration": "khule khata(n)g khoonee khatirahaan ||",
      "translation": "",
      "punjabiViakhya": "ਛਤ੍ਰੀਆਂ ਦਾ ਵਿਨਾਸ਼ ਕਰਨ ਲਈ ਖ਼ੂਨੀ ਬਾਣ ਛੁਟੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "खुले खतंग खूनी खतृहाण ॥",
      "sourceLineId": "100192",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਉਝਰੇ ਜੁਧ ਜੋਧਾ ਮਹਾਣ ॥",
      "transliteration": "aujhare judh jodhaa mahaan ||",
      "translation": "The bloody daggers came out and the great warriors died in the war",
      "punjabiViakhya": "ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਮਹਾਨ ਯੋਧੇ ਝੜ ਗਏ ਹਨ (ਅਰਥਾਤ ਮਾਰੇ ਗਏ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "उझरे जुध जोधा महाण ॥",
      "sourceLineId": "100193",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਧੁਕੰਤ ਢੋਲ ਘੁੰਮੰਤ ਘਾਇ ॥",
      "transliteration": "dhuka(n)t ddol ghu(n)ma(n)t ghai ||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲਾ ਦੀ ਗੰਭੀਰ ਧੁਨ ਹੋ ਰਹੀ ਹੈ। ਘਾਇਲ ਘੁੰਮ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "धुकंत ढोल घुँमंत घाइ ॥",
      "sourceLineId": "100194",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚਿਕੰਤ ਚਾਵਡੀ ਮਾਸੁ ਚਾਇ ॥੫੩੩॥",
      "transliteration": "chika(n)t chaavaddee maas chai ||533||",
      "translation": "The wounds were inflicted and the atmosphere became foggy with the dust of the feet of the warriors, the shouts of vultures were heard in all the four directions.533.",
      "punjabiViakhya": "ਮਾਸ ਦੇ ਚਾਉ ਨਾਲ ਚੁੜੇਲਾ ਚੀਕਾ ਮਾਰ ਰਹੀਆਂ ਹਨ ॥੫੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "चिकंत चावडी मासु चाइ ॥५३३॥",
      "sourceLineId": "100195",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਹਸੰਤ ਹਾਸ ਕਾਲੀ ਕਰਾਲ ॥",
      "transliteration": "hasa(n)t haas kaalee karaal ||",
      "translation": "",
      "punjabiViakhya": "ਭਿਆਨਕ ਕਾਲੀ ਹਾਸੇ ਹਸ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "हसंत हास काली कराल ॥",
      "sourceLineId": "100196",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭਭਕੰਤ ਭੂਤ ਭੈਰੋ ਬਿਸਾਲ ॥",
      "transliteration": "bhabhaka(n)t bhoot bhairo bisaal ||",
      "translation": "The dreadful Kali laughed and the huge Bhairavas and the ghosts shouted, the arrows were inflicted",
      "punjabiViakhya": "ਭੂਤ ਅਤੇ ਭੈਰੋ ਭਭਕਾ ਮਾਰ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "भभकंत भूत भैरो बिसाल ॥",
      "sourceLineId": "100197",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਲਾਗੰਤ ਬਾਣ ਭਾਖੰਤ ਮਾਸ ॥",
      "transliteration": "laaga(n)t baan bhaakha(n)t maas ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣ ਲਗ ਰਹੇ ਹਨ ਅਤੇ (ਯੋਧਿਆਂ ਦਾ) ਮਾਸ ਭਖ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "लागंत बाण भाखंत मास ॥",
      "sourceLineId": "100198",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭਾਜੰਤ ਭੀਰ ਹੁਇ ਹੁਇ ਉਦਾਸ ॥੫੩੪॥",
      "transliteration": "bhaaja(n)t bheer hui hui udhaas ||534||",
      "translation": "The ghosts and fiends ate the flesh the cowards in their anxiety began to run away.534.",
      "punjabiViakhya": "ਕਾਇਰ ਲੋਕ ਉਦਾਸ ਹੋ ਹੋ ਕੇ ਭਜੇ ਜਾ ਰਹੇ ਹਨ ॥੫੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "भाजंत भीर हुइ हुइ उदास ॥५३४॥",
      "sourceLineId": "100199",
      "sourceShabadId": "9268",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "100200",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚੜਿਓ ਚੀਨ ਰਾਜੰ ॥",
      "transliteration": "chaRio cheen raaja(n) ||",
      "translation": "",
      "punjabiViakhya": "ਚੀਨ ਦਾ ਰਾਜਾ ਚੜ੍ਰਹ ਆਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "चड़िओ चीन राजं ॥",
      "sourceLineId": "100201",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਜੇ ਸਰਬ ਸਾਜੰ ॥",
      "transliteration": "saje sarab saaja(n) ||",
      "translation": "The king of China attacked, he was ready in every way",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸਭ ਤਰ੍ਰਹਾ ਦੇ ਸਾਜ ਸਜਾਏ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "सजे सरब साजं ॥",
      "sourceLineId": "100202",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਖੁਲੇ ਖੇਤਿ ਖੂਨੀ ॥",
      "transliteration": "khule khet khoonee ||",
      "translation": "",
      "punjabiViakhya": "ਖ਼ੂਨਖ਼ਾਰ ਯੋਧੇ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਖੁਲ੍ਰਹੇ ਵਿਚਰ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "खुले खेति खूनी ॥",
      "sourceLineId": "100203",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚੜੇ ਚੌਪ ਦੂਨੀ ॥੫੩੫॥",
      "transliteration": "chaRe chauap dhoonee ||535||",
      "translation": "The bloody daggers came out of scabbards with double zeal.535.",
      "punjabiViakhya": "(ਚਿੱਤ ਵਿਚ) ਦੁਗਣਾ ਚਾਉ ਚੜ੍ਰਹਿਆ ਹੋਇਆ ਹੈ ॥੫੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "चड़े चौप दूनी ॥५३५॥",
      "sourceLineId": "100204",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜੁਟੇ ਜੋਧ ਜੋਧੰ ॥",
      "transliteration": "juTe jodh jodha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧੇ ਯੁੱਧ ਵਿਚ ਜੁਟੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "जुटे जोध जोधं ॥",
      "sourceLineId": "100205",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਜੈ ਬਾਣ ਕ੍ਰੋਧੰ ॥",
      "transliteration": "tajai baan krodha(n) ||",
      "translation": "The warriors, getting enraged, discharged arrows and",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਨਾਲ ਬਾਣ ਛਡ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "तजै बाण क्रोधं ॥",
      "sourceLineId": "100206",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤੁਟੈ ਅੰਗ ਭੰਗੰ ॥",
      "transliteration": "tuTai a(n)g bha(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਗ ਭੰਗ ਹੋ ਕੇ ਟੁਟ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "तुटै अंग भंगं ॥",
      "sourceLineId": "100207",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭ੍ਰਮੇ ਰੰਗ ਜੰਗੰ ॥੫੩੬॥",
      "transliteration": "bhrame ra(n)g ja(n)ga(n) ||536||",
      "translation": "Roamed in the battlefield, destroying the limbs of others.536.",
      "punjabiViakhya": "(ਫਿਰ ਵੀ) ਯੁੱਧ ਵਿਚ ਘੁੰਮ ਰਹੇ ਹਨ ॥੫੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "भ्रमे रंग जंगं ॥५३६॥",
      "sourceLineId": "100208",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਚੇ ਈਸ ਭੀਸੰ ॥",
      "transliteration": "nache iees bheesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਭਿਆਨਕ ਨਾਚ ਨਚ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "नचे ईस भीसं ॥",
      "sourceLineId": "100209",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0604_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪੁਐ ਮਾਲ ਸੀਸੰ ॥",
      "transliteration": "puaai maal seesa(n) ||",
      "translation": "Shiva also joined the armies and danced and discharged arrows in a queer way.537.",
      "punjabiViakhya": "ਸਿਰਾ ਦੀ ਮਾਲਾ ਪਰੋ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 604,
      "hindi": "",
      "hindiTransliteration": "पुऐ माल सीसं ॥",
      "sourceLineId": "100210",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
