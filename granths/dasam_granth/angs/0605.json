{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 605,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0605_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਰੈ ਚਿਤ੍ਰ ਚਾਰੰ ॥",
      "transliteration": "karai chitr chaara(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੈਨਾ ਨਾਇਕ) ਵਿਚਿਤ੍ਰ ਕੌਤਕ ਵਿਖਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "करै चित्र चारं ॥",
      "sourceLineId": "100211",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਜੈ ਬਾਣ ਧਾਰੰ ॥੫੩੭॥",
      "transliteration": "tajai baan dhaara(n) ||537||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣਾ ਦੀ ਝੜੀ ਲਾ ਰਹੇ ਹਨ ॥੫੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "तजै बाण धारं ॥५३७॥",
      "sourceLineId": "100212",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮੰਡੇ ਜੋਧ ਜੋਧੰ ॥",
      "transliteration": "ma(n)dde jodh jodha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧੇ ਯੁੱਧ-ਕਰਮ ਵਿਚ ਮਗਨ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "मंडे जोध जोधं ॥",
      "sourceLineId": "100213",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਜੇ ਬਾਣ ਕ੍ਰੋਧੰ ॥",
      "transliteration": "taje baan krodha(n) ||",
      "translation": "The warriors in their fury discharged arrows in the battlefield",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਨਾਲ ਬਾਣ ਛਡਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "तजे बाण क्रोधं ॥",
      "sourceLineId": "100214",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਦੀ ਸ੍ਰੋਣ ਪੂਰੰ ॥",
      "transliteration": "nadhee sron poora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਲਹੂ ਦੀ ਨਦੀ ਭਰ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "नदी स्रोण पूरं ॥",
      "sourceLineId": "100215",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਫਿਰੀ ਗੈਣ ਹੂਰੰ ॥੫੩੮॥",
      "transliteration": "firee gain hoora(n) ||538||",
      "translation": "The streams of blood were full and the heavenly damsels moved in the sky.538.",
      "punjabiViakhya": "ਆਕਾਸ਼ ਵਿਚ ਹੂਰਾ ਫਿਰ ਰਹੀਆਂ ਹਨ ॥੫੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "फिरी गैण हूरं ॥५३८॥",
      "sourceLineId": "100216",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਸੈ ਮੁੰਡ ਮਾਲਾ ॥",
      "transliteration": "hasai mu(n)dd maalaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੁੰਡਾ ਦੀ ਮਾਲਾ ਵਾਲਾ (ਸ਼ਿਵ ਰੁਦ੍ਰ) ਹਸ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "हसै मुँड माला ॥",
      "sourceLineId": "100217",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਜੈ ਜੋਗ ਜ੍ਵਾਲਾ ॥",
      "transliteration": "tajai jog javaiaalaa ||",
      "translation": "The goddess kali laughed and produced fire of Yoga",
      "punjabiViakhya": "(ਮੂੰਹ ਤੋਂ) ਯੋਗ-ਅਗਨੀ ਛਡ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "तजै जोग ज्वाला ॥",
      "sourceLineId": "100218",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਜੈ ਬਾਣ ਜ੍ਵਾਣੰ ॥",
      "transliteration": "tajai baan javaiaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਬਾਣ ਛਡ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "तजै बाण ज्वाणं ॥",
      "sourceLineId": "100219",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗ੍ਰਸੈ ਦੁਸਟ ਪ੍ਰਾਣੰ ॥੫੩੯॥",
      "transliteration": "grasai dhusaT praana(n) ||539||",
      "translation": "The tyrants were killed with the arrows of the soldiers.539.",
      "punjabiViakhya": "ਜੋ ਦੁਸ਼ਟਾ ਦੇ ਪ੍ਰਾਣਾ ਨੂੰ ਗ੍ਰਸ ਲੈਂਦੇ ਹਨ ॥੫੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "ग्रसै दुसट प्राणं ॥५३९॥",
      "sourceLineId": "100220",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗਿਰੇ ਘੁੰਮਿ ਭੂਮੀ ॥",
      "transliteration": "gire ghu(n)m bhoomee ||",
      "translation": "",
      "punjabiViakhya": "ਘੁੰਮੇਰੀ ਖਾ ਕੇ ਧਰਤੀ ਉਤੇ ਡਿਗਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "गिरे घुँमि भूमी ॥",
      "sourceLineId": "100221",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਉਠੀ ਧੂਰ ਧੂੰਮੀ ॥",
      "transliteration": "auThee dhoor dhoo(n)mee ||",
      "translation": "The warriors are swinging and falling on the ground and the dust is rising from the earth",
      "punjabiViakhya": "ਧਰਤੀ ਉਤੋਂ ਧੂੜ ਉਠਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "उठी धूर धूँमी ॥",
      "sourceLineId": "100222",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੁਭੇ ਰੇਤ ਖੇਤੰ ॥",
      "transliteration": "subhe ret kheta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਦੀ ਰੇਤ ਸ਼ੁਭ ਰੰਗ (ਭਾਵ ਲਹੂ ਰੰਗੀ) ਹੋ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "सुभे रेत खेतं ॥",
      "sourceLineId": "100223",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਚੇ ਭੂਤ ਪ੍ਰੇਤੰ ॥੫੪੦॥",
      "transliteration": "nache bhoot preta(n) ||540||",
      "translation": "The fighters have gathered zealously in the battlefield and the ghosts and fiends are dancing.540.",
      "punjabiViakhya": "ਭੂਤ ਅਤੇ ਪ੍ਰੇਤ ਨਚ ਰਹੇ ਹਨ ॥੫੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "नचे भूत प्रेतं ॥५४०॥",
      "sourceLineId": "100224",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਿਲਿਓ ਚੀਨ ਰਾਜਾ ॥",
      "transliteration": "milio cheen raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਚੀਨ ਦਾ ਰਾਜਾ (ਯੁੱਧ ਤਿਆਗ ਕੇ ਕਲਕੀ ਨੂੰ ਆ ਕੇ) ਮਿਲ ਪਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "मिलिओ चीन राजा ॥",
      "sourceLineId": "100225",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭਏ ਸਰਬ ਕਾਜਾ ॥",
      "transliteration": "bhe sarab kaajaa ||",
      "translation": "The king of China met his men, whose objectives were fulfilled",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਸਾਰੇ ਕਾਰਜ ਪੂਰੇ ਹੋ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "भए सरब काजा ॥",
      "sourceLineId": "100226",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਲਇਓ ਸੰਗ ਕੈ ਕੈ ॥",
      "transliteration": "lio sa(n)g kai kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਨਾਲ ਲੈ ਕੇ (ਕਲਕੀ ਸਭ ਦੇ)",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "लइओ संग कै कै ॥",
      "sourceLineId": "100227",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚਲਿਓ ਅਗ੍ਰ ਹ੍ਵੈ ਕੈ ॥੫੪੧॥",
      "transliteration": "chalio agr havai kai ||541||",
      "translation": "He took many with himself and advanced forward.541.",
      "punjabiViakhya": "ਅਗੇ ਹੋ ਕੇ ਚਲ ਰਿਹਾ ਹੈ ॥੫੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "चलिओ अग्र ह्वै कै ॥५४१॥",
      "sourceLineId": "100228",
      "sourceShabadId": "9269",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਛਪੈ ਛੰਦ ॥",
      "transliteration": "chhapai chha(n)dh ||",
      "translation": "CHHAPI STANZA",
      "punjabiViakhya": "ਛਪੈ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "छपै छंद ॥",
      "sourceLineId": "100229",
      "sourceShabadId": "9270",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਲਏ ਸੰਗ ਨ੍ਰਿਪ ਸਰਬ ਬਜੇ ਬਿਜਈ ਦੁੰਦਭਿ ਰਣ ॥",
      "transliteration": "le sa(n)g nirap sarab baje bijiee dhu(n)dhabh ran ||",
      "translation": "The king took all alongwith him and the drums of victory sounded",
      "punjabiViakhya": "(ਕਲਕੀ ਨੇ) ਸਾਰੇ ਰਾਜੇ ਨਾਲ ਲੈ ਕੇ ਰਣ-ਭੂਮੀ ਵਿਚ ਜਿਤ ਦੇ ਨਗਾਰੇ ਵਜਾਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "लए संग नृप सरब बजे बिजई दुँदभि रण ॥",
      "sourceLineId": "100230",
      "sourceShabadId": "9270",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੁਭੇ ਸੂਰ ਸੰਗ੍ਰਾਮ ਨਿਰਖਿ ਰੀਝਈ ਅਪਛਰ ਗਣ ॥",
      "transliteration": "subhe soor sa(n)graam nirakh reejhiee apachhar gan ||",
      "translation": "The warriors gathered in the battlefield and seeing them, the heavenly damsels were allured",
      "punjabiViakhya": "ਯੁੱਧ ਖੇਤਰ ਵਿਚ ਸੂਰਮਿਆਂ ਨੂੰ ਸੁਭਾਇਮਾਨ ਵੇਖ ਕੇ ਅਪੱਛਰਾਵਾ ਦੇ ਝੁੰਡ ਪ੍ਰਸੰਨ ਹੋ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "सुभे सूर संग्राम निरखि रीझई अपछर गण ॥",
      "sourceLineId": "100231",
      "sourceShabadId": "9270",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਛਕੇ ਦੇਵ ਆਦੇਵ ਜਕੇ ਗੰਧਰਬ ਜਛ ਬਰ ॥",
      "transliteration": "chhake dhev aadhev jake ga(n)dharab jachh bar ||",
      "translation": "The gods, demons and Gandharvas all were filled with wonder and pleased",
      "punjabiViakhya": "ਦੇਵਤੇ ਆਨੰਦਿਤ ਹੋ ਰਹੇ ਹਨ ਅਤੇ ਦੈਂਤ, ਗੰਧਰਬ ਅਤੇ ਉਤਮ ਯਕਸ਼ ਝਿਝਕ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "छके देव आदेव जके गंधरब जछ बर ॥",
      "sourceLineId": "100232",
      "sourceShabadId": "9270",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚਕੇ ਭੂਤ ਅਰੁ ਪ੍ਰੇਤ ਸਰਬ ਬਿਦਿਆਧਰ ਨਰ ਬਰ ॥",
      "transliteration": "chake bhoot ar pret sarab bidhiaadhar nar bar ||",
      "translation": "All ghosts, fiends and superb Vidyadharis wondered",
      "punjabiViakhya": "ਸਾਰੇ ਭੂਤ, ਪ੍ਰੇਤ, ਵਿਦਿਆਧਰ ਅਤੇ ਸ੍ਰੇਸ਼ਠ ਮਨੁੱਖ ਹੈਰਾਨ ਹੋ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "चके भूत अरु प्रेत सरब बिदिआधर नर बर ॥",
      "sourceLineId": "100233",
      "sourceShabadId": "9270",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0605_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਖੰਕੜੀਯ ਕਾਲ ਕ੍ਰੂਰਾ ਪ੍ਰਭਾ ਬਹੁ ਪ੍ਰਕਾਰ ਉਸਤਤਿ ਕਰੀਯ ॥",
      "transliteration": "kha(n)kaReey kaal kraooraa prabhaa bahu prakaar usatat kareey ||",
      "translation": "Kalki (Lord) thundered as a manifestation of KAL (death) and he was eulogized in various ways",
      "punjabiViakhya": "ਵਿਨਾਸ਼ਕ ਅਤੇ ਕਠੋਰ ਪ੍ਰਭਾ ਵਾਲੇ ਕਾਲ (ਕਲਕੀ) ਦੀ ਬਹੁਤ ਤਰ੍ਰਹਾ ਦੀ ਉਸਤਤ ਕੀਤੀ ਜਾ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 605,
      "hindi": "",
      "hindiTransliteration": "खंकड़ीय काल क्रूरा प्रभा बहु प्रकार उसतति करीय ॥",
      "sourceLineId": "100234",
      "sourceShabadId": "9270",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
