{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 608,
  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0608_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਜੈ ਮਹਾ ਰੂਪ ॥",
      "transliteration": "raajai mahaa roop ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਮਹਾਨ ਰੂਪ ਸੁਸ਼ੋਭਿਤ ਹੋ ਰਿਹਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "राजै महा रूप ॥",
      "sourceLineId": "100331",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਲਾਜੈ ਸਬੈ ਭੂਪ ॥",
      "transliteration": "laajai sabai bhoop ||",
      "translation": "Before his great beauty, all the kings felt shy",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ) ਸਾਰੇ ਰਾਜੇ ਸ਼ਰਮਿੰਦੇ ਹੁੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "लाजै सबै भूप ॥",
      "sourceLineId": "100332",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਗ ਆਨ ਮਾਨੀਸੁ ॥",
      "transliteration": "jag aan maanees ||",
      "translation": "",
      "punjabiViakhya": "(ਸਾਰੇ) ਜਗਤ ਨੇ (ਉਸ ਨੂੰ) ਈਸ਼ਵਰ ਜਾਣ ਲਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "जग आन मानीसु ॥",
      "sourceLineId": "100333",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਿਲਿ ਭੇਟ ਲੈ ਦੀਸੁ ॥੫੬੪॥",
      "transliteration": "mil bheT lai dhees ||564||",
      "translation": "All of them accepted defeat and made offerings to him.564.",
      "punjabiViakhya": "(ਅਥਵਾ ਈਨ ਮੰਨ ਲਈ ਹੈ) ਅਤੇ ਭੇਟਾ ਲਿਆ ਕੇ ਮਿਲ ਪਏ ਹਨ ॥੫੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "मिलि भेट लै दीसु ॥५६४॥",
      "sourceLineId": "100334",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੋਭੇ ਮਹਾਰਾਜ ॥",
      "transliteration": "sobhe mahaaraaj ||",
      "translation": "",
      "punjabiViakhya": "(ਕਲਕੀ) ਮਹਾਰਾਜ ਸ਼ੋਭਾ ਪਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "सोभे महाराज ॥",
      "sourceLineId": "100335",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਛ੍ਰੀ ਰਹੈ ਲਾਜ ॥",
      "transliteration": "achhree rahai laaj ||",
      "translation": "The warriors equivalent to his glory also felt shy",
      "punjabiViakhya": "(ਉਸ ਨੂੰ ਵੇਖ ਕੇ) ਅਪੱਛਰਾਵਾ ਸ਼ਰਮਸਾਰ ਹੋ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "अछ्री रहै लाज ॥",
      "sourceLineId": "100336",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਤਿ ਰੀਝਿ ਮਧੁ ਬੈਨ ॥",
      "transliteration": "at reejh madh bain ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਪ੍ਰਸੰਨ ਅਤੇ ਮਿਠੇ ਬੋਲਾ ਵਾਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "अति रीझि मधु बैन ॥",
      "sourceLineId": "100337",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਸ ਰੰਗ ਭਰੇ ਨੈਨ ॥੫੬੫॥",
      "transliteration": "ras ra(n)g bhare nain ||565||",
      "translation": "His words are very sweet and his eyes are full of enjoyment and pleasure.565.",
      "punjabiViakhya": "ਨੈਣ ਪ੍ਰੇਮ ਰਸ ਵਿਚ ਭਰੇ ਹੋਏ ਹਨ ॥੫੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "रस रंग भरे नैन ॥५६५॥",
      "sourceLineId": "100338",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੋਹਤ ਅਨੂਪਾਛ ॥",
      "transliteration": "sohat anoopaachh ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਗੇ ਅਨੂਪਮ (ਢੰਗ ਨਾਲ) ਸ਼ੋਭਾਇਮਾਨ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "सोहत अनूपाछ ॥",
      "sourceLineId": "100339",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਾਛੇ ਮਨੋ ਕਾਛ ॥",
      "transliteration": "kaachhe mano kaachh ||",
      "translation": "His body is so beautiful as if it was especially fashioned",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ) ਮਾਨੋ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਸ਼ਿੰਗਾਰਿਆ ਗਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "काछे मनो काछ ॥",
      "sourceLineId": "100340",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰੀਝੈ ਸੁਰੀ ਦੇਖਿ ॥",
      "transliteration": "reejhai suree dhekh ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ ਰੂਪ ਨੂੰ) ਵੇਖ ਕੇ ਦੇਵ ਇਸਤਰੀਆਂ ਰੀਝ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "रीझै सुरी देखि ॥",
      "sourceLineId": "100341",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਾਵਲੜੇ ਭੇਖਿ ॥੫੬੬॥",
      "transliteration": "raavalaRe bhekh ||566||",
      "translation": "The women of gods and saints are getting pleased. 566.",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦਾ) ਰਾਵਲਾ ਵਰਗਾ ਭੇਖ ਹੈ ॥੫੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "रावलड़े भेखि ॥५६६॥",
      "sourceLineId": "100342",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦੇਖੇ ਜਿਨੈ ਨੈਕੁ ॥",
      "transliteration": "dhekhe jinai naik ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੇ (ਕਲਕੀ ਨੂੰ) ਥੋੜਾ ਜਿਹਾ ਵੀ ਵੇਖਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "देखे जिनै नैकु ॥",
      "sourceLineId": "100343",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਲਾਗੈ ਤਿਸੈ ਐਖ ॥",
      "transliteration": "laagai tisai aaikh ||",
      "translation": "He who saw him even slightly, his eyes kept on looking at him",
      "punjabiViakhya": "ਉਸ ਦੀਆਂ ਅੱਖਾ (ਇਨ੍ਰਹਾ ਵਲ) ਲਗ ਗਈਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "लागै तिसै ऐख ॥",
      "sourceLineId": "100344",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰੀਝੈ ਸੁਰੀ ਨਾਰਿ ॥",
      "transliteration": "reejhai suree naar ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵ ਇਸਤਰੀਆਂ ਪ੍ਰਸੰਨ ਹੋ ਰਹੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "रीझै सुरी नारि ॥",
      "sourceLineId": "100345",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੇਖੈ ਧਰੇ ਪîਾਰ ॥੫੬੭॥",
      "transliteration": "dhekhai dhare paar ||567||",
      "translation": "The women of gods, getting allured are looking with love towards him.567.",
      "punjabiViakhya": "ਅਤੇ ਪ੍ਰੇਮ ਪੂਰਵਕ (ਇਨ੍ਰਹਾ ਵਲ) ਤਕਦੀਆਂ ਹਨ ॥੫੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "देखै धरे पîार ॥५६७॥",
      "sourceLineId": "100346",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰੰਗੇ ਮਹਾ ਰੰਗ ॥",
      "transliteration": "ra(n)ge mahaa ra(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਰੰਗ (ਪ੍ਰੇਮ ਰੰਗ) ਵਿਚ ਰੰਗੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "रंगे महा रंग ॥",
      "sourceLineId": "100347",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਲਾਜੈ ਲਖਿ ਅਨੰਗ ॥",
      "transliteration": "laajai lakh ana(n)g ||",
      "translation": "Seeing the beauty-incarnate Lord, the god of love is feeling shy",
      "punjabiViakhya": "(ਇਨ੍ਰਹਾ ਨੂੰ ਵੇਖ ਕੇ) ਕਾਮਦੇਵ ਵੀ ਸ਼ਰਮਿੰਦਾ ਹੋ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "लाजै लखि अनंग ॥",
      "sourceLineId": "100348",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚਿਤਗੰ ਚਿਰੈ ਸਤ੍ਰ ॥",
      "transliteration": "chitaga(n) chirai satr ||",
      "translation": "",
      "punjabiViakhya": "ਵੈਰੀ (ਵੇਖ ਕੇ) ਚਿਤ ਵਿਚ ਚਿੜ੍ਰਹਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "चितगं चिरै सत्र ॥",
      "sourceLineId": "100349",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਲਗੈ ਜਨੋ ਅਤ੍ਰ ॥੫੬੮॥",
      "transliteration": "lagai jano atr ||568||",
      "translation": "The enemes are so much fearful in their mind as if they have been ripped by the weapons.568.",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ) ਮਾਨੋ ਉਸ ਨੂੰ ਤੀਰ ਲਗ ਗਿਆ ਹੋਵੇ ॥੫੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "लगै जनो अत्र ॥५६८॥",
      "sourceLineId": "100350",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੋਭੇ ਮਹਾ ਸੋਭ ॥",
      "transliteration": "sobhe mahaa sobh ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾਨ ਸ਼ੋਭਾ ਨਾਲ ਸੋਭ ਰਹੇ ਹਨ;",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "सोभे महा सोभ ॥",
      "sourceLineId": "100351",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਛ੍ਰੀ ਰਹੈ ਲੋਭਿ ॥",
      "transliteration": "achhree rahai lobh ||",
      "translation": "The warriors are looking at his glory covetously",
      "punjabiViakhya": "ਅਪੱਛਰਾਵਾ ਲੋਭਾਇਮਾਨ ਹੋ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "अछ्री रहै लोभि ॥",
      "sourceLineId": "100352",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਆਂਜੇ ਇਸੇ ਨੈਨ ॥",
      "transliteration": "aa(n)je ise nain ||",
      "translation": "",
      "punjabiViakhya": "ਨੈਣਾ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਸੁਰਮਾ ਲਗਿਆ ਹੋਇਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "आँजे इसे नैन ॥",
      "sourceLineId": "100353",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0608_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਾਗੇ ਮਨੋ ਰੈਨ ॥੫੬੯॥",
      "transliteration": "jaage mano rain ||569||",
      "translation": "His eyes are black and touched with antimony, which seem to have awakened continuously for several nights.569.",
      "punjabiViakhya": "ਮਾਨੋ ਸਾਰੀ ਰਾਤ ਜਾਗਦੇ ਰਹੇ ਹੋਣ ॥੫੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 608,
      "hindi": "",
      "hindiTransliteration": "जागे मनो रैन ॥५६९॥",
      "sourceLineId": "100354",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
