{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 609,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0609_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰੂਪੰ ਭਰੇ ਰਾਗ ॥",
      "transliteration": "roopa(n) bhare raag ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰੇਮ ਅਤੇ ਰੂਪ ਦੇ ਭਰੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "रूपं भरे राग ॥",
      "sourceLineId": "100355",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੋਭੇ ਸੁ ਸੁਹਾਗ ॥",
      "transliteration": "sobhe su suhaag ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸੌਭਾਗਸ਼ਾਲੀ ਸੋਭ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "सोभे सु सुहाग ॥",
      "sourceLineId": "100356",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਾਛੇ ਨਟੰ ਰਾਜ ॥",
      "transliteration": "kaachhe naTa(n) raaj ||",
      "translation": "",
      "punjabiViakhya": "ਨਟਰਾਜ ਵਾਗ ਸਜੇ ਹੋਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "काछे नटं राज ॥",
      "sourceLineId": "100357",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾਚੈ ਮਨੋ ਬਾਜ ॥੫੭੦॥",
      "transliteration": "naachai mano baaj ||570||",
      "translation": "Filled with beauty and love they look magnificent like a comedian king.570.",
      "punjabiViakhya": "ਅਤੇ (ਚੰਚਲ ਇਤਨੇ ਹਨ) ਮਾਨੋ ਘੋੜਾ ਨਚ ਰਿਹਾ ਹੋਵੇ ॥੫੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "नाचै मनो बाज ॥५७०॥",
      "sourceLineId": "100358",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਆਖੈਂ ਮਨੋ ਬਾਨ ॥",
      "transliteration": "aakhai(n) mano baan ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਖਾ ਮਾਨੋ ਬਾਣ ਹੋਣ",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "आखैं मनो बान ॥",
      "sourceLineId": "100359",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕੈਧੋ ਧਰੇ ਸਾਨ ॥",
      "transliteration": "kaidho dhare saan ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸਾਣ ਉਤੇ ਚੜ੍ਰਹਾ ਕੇ ਤਿਖੇ ਕੀਤੇ ਗਏ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "कैधो धरे सान ॥",
      "sourceLineId": "100360",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਾਨੇ ਲਗੇ ਜਾਹਿ ॥",
      "transliteration": "jaane lage jaeh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਜਾ ਕੇ (ਇਹ ਬਾਣ) ਲਗਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "जाने लगे जाहि ॥",
      "sourceLineId": "100361",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਯਾ ਕੋ ਕਹੈ ਕਾਹਿ ॥੫੭੧॥",
      "transliteration": "yaa ko kahai kaeh ||571||",
      "translation": "The black arrows are fitted in the bow and they hit the enemies.571.",
      "punjabiViakhya": "ਉਸ ਦਾ (ਹਾਲ) ਕੌਣ ਕਹਿ ਸਕਦਾ ਹੈ ॥੫੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "या को कहै काहि ॥५७१॥",
      "sourceLineId": "100362",
      "sourceShabadId": "9275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੁਖਦਾ ਬ੍ਰਿਦ ਛੰਦ ॥",
      "transliteration": "sukhadhaa biradh chha(n)dh ||",
      "translation": "SUKHDAAVRAD STANZA",
      "punjabiViakhya": "ਸੁਖਦਾ ਬ੍ਰਿਦ ਛੰਦ।",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "सुखदा बृद छंद ॥",
      "sourceLineId": "100363",
      "sourceShabadId": "9276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਿ ਕਾਛੇ ਕਾਛ ਧਾਰੀ ਹੈਂ ॥",
      "transliteration": "k kaachhe kaachh dhaaree hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਤਾ ਸੁਆਂਗੀ ਨੇ ਸੁਆਂਗ ਧਾਰਿਆ ਹੋਇਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "कि काछे काछ धारी हैं ॥",
      "sourceLineId": "100364",
      "sourceShabadId": "9276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਿ ਰਾਜਾ ਅਧਿਕਾਰੀ ਹੈਂ ॥",
      "transliteration": "k raajaa adhikaaree hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਅਧਿਕਾਰ ਵਾਲਾ ਰਾਜਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "कि राजा अधिकारी हैं ॥",
      "sourceLineId": "100365",
      "sourceShabadId": "9276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਿ ਭਾਗ ਕੋ ਸੁਹਾਗ ਹੈਂ ॥",
      "transliteration": "k bhaag ko suhaag hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਭਾਗ ਦਾ ਸੌਭਾਗ (ਵਿਧਾਤਾ) ਹੈ;",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "कि भाग को सुहाग हैं ॥",
      "sourceLineId": "100366",
      "sourceShabadId": "9276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਿ ਰੰਗੋ ਅਨੁਰਾਗ ਹੈਂ ॥੫੭੨॥",
      "transliteration": "k ra(n)go anuraag hai(n) ||572||",
      "translation": "He leads the life of a producer, a king, an authority, bestower of fortune and love.572.",
      "punjabiViakhya": "ਜਾ ਪ੍ਰੇਮ ਦਾ ਰੰਗਿਆ ਹੋਇਆ ਹੈ ॥੫੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "कि रंगो अनुराग हैं ॥५७२॥",
      "sourceLineId": "100367",
      "sourceShabadId": "9276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਿ ਛੋਭੈ ਛਤ੍ਰ ਧਾਰੀ ਛੈ ॥",
      "transliteration": "k chhobhai chhatr dhaaree chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਛਤ੍ਰਧਾਰੀ ਵਰਗੇ ਸ਼ੋਭਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "कि छोभै छत्र धारी छै ॥",
      "sourceLineId": "100368",
      "sourceShabadId": "9276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਿ ਛਤ੍ਰੀ ਅਤ੍ਰ ਵਾਰੀ ਛੈ ॥",
      "transliteration": "k chhatree atr vaaree chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਅਸਤ੍ਰਾ ਵਾਲੇ ਛਤ੍ਰੀ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "कि छत्री अत्र वारी छै ॥",
      "sourceLineId": "100369",
      "sourceShabadId": "9276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਿ ਆਂਜੇ ਬਾਨ ਬਾਨੀ ਸੇ ॥",
      "transliteration": "k aa(n)je baan baanee se ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਬਾਣਾ ਨਾਲ ਸੱਜੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "कि आँजे बान बानी से ॥",
      "sourceLineId": "100370",
      "sourceShabadId": "9276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਿ ਕਾਛੀ ਕਾਛ ਕਾਰੀ ਹੈਂ ॥੫੭੩॥",
      "transliteration": "k kaachhee kaachh kaaree hai(n) ||573||",
      "translation": "He is a Soverign, an arms-wielding warrior, elehance-incarnate an the creator of the whole world.573.",
      "punjabiViakhya": "ਜਾ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਸੰਵਰੇ ਹੋਏ ਹਨ ॥੫੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "कि काछी काछ कारी हैं ॥५७३॥",
      "sourceLineId": "100371",
      "sourceShabadId": "9276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਿ ਕਾਮੀ ਕਾਮ ਬਾਨ ਸੇ ॥",
      "transliteration": "k kaamee kaam baan se ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਕਾਮਦੇਵ ਦੇ ਬਾਣ ਵਰਗੇ ਕਾਮੀ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "कि कामी काम बान से ॥",
      "sourceLineId": "100372",
      "sourceShabadId": "9276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਿ ਫੂਲੇ ਫੂਲ ਮਾਲ ਸੇ ॥",
      "transliteration": "k foole fool maal se ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਫੁਲਾ ਦੀ ਮਾਲਾ ਦੇ (ਸ਼ਿਰੋਮਣੀ) ਫੁਲ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "कि फूले फूल माल से ॥",
      "sourceLineId": "100373",
      "sourceShabadId": "9276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਿ ਰੰਗੇ ਰੰਗ ਰਾਗ ਸੇ ॥",
      "transliteration": "k ra(n)ge ra(n)g raag se ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਪ੍ਰੇਮ ਰੰਗ ਵਿਚ ਰੰਗੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "कि रंगे रंग राग से ॥",
      "sourceLineId": "100374",
      "sourceShabadId": "9276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਿ ਸੁੰਦਰ ਸੁਹਾਗ ਸੇ ॥੫੭੪॥",
      "transliteration": "k su(n)dhar suhaag se ||574||",
      "translation": "He is lustful like the god of love, blooming like a flower an dyed in love like a beautiful song.574.",
      "punjabiViakhya": "ਜਾ ਸੁੰਦਰਤਾ ਦੇ ਸੌਭਾਗ (ਵਿਧਾਤਾ) ਵਰਗੇ ਹਨ ॥੫੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "कि सुँदर सुहाग से ॥५७४॥",
      "sourceLineId": "100375",
      "sourceShabadId": "9276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਿ ਨਾਗਨੀ ਕੇ ਏਸ ਹੈਂ ॥",
      "transliteration": "k naaganee ke es hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਕਾਲੀ ਨਾਗ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "कि नागनी के एस हैं ॥",
      "sourceLineId": "100376",
      "sourceShabadId": "9276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਿ ਮ੍ਰਿਗੀ ਕੇ ਨਰੇਸ ਛੈ ॥",
      "transliteration": "k miragee ke nares chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਹਿਰਨੀਆਂ ਦੇ (ਸ਼ਿਰੋਮਣੀ) ਹਿਰਨ ਹਨ;",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "कि मृगी के नरेस छै ॥",
      "sourceLineId": "100377",
      "sourceShabadId": "9276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਿ ਰਾਜਾ ਛਤ੍ਰ ਧਾਰੀ ਹੈਂ ॥",
      "transliteration": "k raajaa chhatr dhaaree hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਛਤ੍ਰਧਾਰੀ ਰਾਜਾ ਹਨ;",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "कि राजा छत्र धारी हैं ॥",
      "sourceLineId": "100378",
      "sourceShabadId": "9276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਿ ਕਾਲੀ ਕੇ ਭਿਖਾਰੀ ਛੈ ॥੫੭੫॥",
      "transliteration": "k kaalee ke bhikhaaree chhai ||575||",
      "translation": "He is cobra for a female serpent, deer for the does, a canopied Sovereign for the kings and a devotee before the goddess Kali.575.",
      "punjabiViakhya": "ਜਾ ਕਾਲੀ ਦੇ ਭਿਖਾਰੀ (ਸੇਵਕ) ਹਨ ॥੫੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "कि काली के भिखारी छै ॥५७५॥",
      "sourceLineId": "100379",
      "sourceShabadId": "9276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੋਰਠਾ ॥",
      "transliteration": "soraThaa ||",
      "translation": "SORTHA",
      "punjabiViakhya": "ਸੋਰਠਾ:",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "सोरठा ॥",
      "sourceLineId": "100380",
      "sourceShabadId": "9277",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਇਮ ਕਲਕੀ ਅਵਤਾਰਿ ਜੀਤੇ ਜੁਧ ਸਬੈ ਨ੍ਰਿਪਤਿ ॥",
      "transliteration": "eim kalakee avataar jeete judh sabai nirapat ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਕਲਕੀ ਅਵਤਾਰ ਨੇ ਯੁੱਧ ਕਰ ਕੇ ਸਾਰੇ ਰਾਜੇ ਜਿਤ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "इम कलकी अवतारि जीते जुध सबै नृपति ॥",
      "sourceLineId": "100381",
      "sourceShabadId": "9277",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕੀਨੋ ਰਾਜ ਸੁਧਾਰਿ ਬੀਸ ਸਹਸ ਦਸ ਲਛ ਬਰਖ ॥੫੭੬॥",
      "transliteration": "keeno raaj sudhaar bees sahas dhas lachh barakh ||576||",
      "translation": "In this way Kalki incarnation conquered all the kings and ruled for ten lakh and twenty thousand years .576.",
      "punjabiViakhya": "(ਫਿਰ) ਦਸ ਲੱਖ ਵੀਹ ਹਜ਼ਾਰ ਵਰ੍ਰਹੇ ਰਾਜ (ਅਧਿਕਾਰ) ਧਾਰਨ ਕੀਤਾ ॥੫੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "कीनो राज सुधारि बीस सहस दस लछ बरख ॥५७६॥",
      "sourceLineId": "100382",
      "sourceShabadId": "9277",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਰਾਵਣਬਾਦ ਛੰਦ ॥",
      "transliteration": "raavanabaadh chha(n)dh ||",
      "translation": "RAVAN-VAADYA STANZA",
      "punjabiViakhya": "ਰਾਵਣਬਾਦ ਛੰਦ।",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "रावणबाद छंद ॥",
      "sourceLineId": "100383",
      "sourceShabadId": "9278",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗਹੀ ਸਮਸੇਰ ॥",
      "transliteration": "gahee samaser ||",
      "translation": "",
      "punjabiViakhya": "(ਹੱਥ ਵਿਚ) ਤਲਵਾਰ ਧਾਰਨ ਕਰ ਲਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "गही समसेर ॥",
      "sourceLineId": "100384",
      "sourceShabadId": "9278",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕੀਯੋ ਜੰਗਿ ਜੇਰ ॥",
      "transliteration": "keeyo ja(n)g jer ||",
      "translation": "",
      "punjabiViakhya": "ਜੰਗ ਕਰ ਕੇ (ਸਾਰਿਆਂ ਨੂੰ) ਅਧੀਨ ਕਰ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "कीयो जंगि जेर ॥",
      "sourceLineId": "100385",
      "sourceShabadId": "9278",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦਏ ਮਤਿ ਫੇਰ ॥",
      "transliteration": "dhe mat fer ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ (ਸਾਰਿਆਂ ਨੂੰ ਸੱਚੇ ਧਰਮ ਦੀ) ਸਿਖਿਆ ਦਿੱਤੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "दए मति फेर ॥",
      "sourceLineId": "100386",
      "sourceShabadId": "9278",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨ ਲਾਗੀ ਬੇਰ ॥੫੭੭॥",
      "transliteration": "n laagee ber ||577||",
      "translation": "He caught his sword in his hand and knocked down everyone in the war and there was no delay in the change of destiny.577.",
      "punjabiViakhya": "(ਜਿਸ ਲਈ) ਦੇਰ ਨਹੀਂ ਲਗੀ ਹੈ ॥੫੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "न लागी बेर ॥५७७॥",
      "sourceLineId": "100387",
      "sourceShabadId": "9278",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦਯੋ ਨਿਜ ਮੰਤ੍ਰ ॥",
      "transliteration": "dhayo nij ma(n)tr ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣਾ ਉਪਦੇਸ਼ (ਮੰਤ੍ਰ) ਦਿੱਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "दयो निज मंत्र ॥",
      "sourceLineId": "100388",
      "sourceShabadId": "9278",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਜੈ ਸਭ ਤੰਤ੍ਰ ॥",
      "transliteration": "tajai sabh ta(n)tr ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਤੰਤ੍ਰ ਛੁੜਵਾ ਦਿੱਤੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "तजै सभ तंत्र ॥",
      "sourceLineId": "100389",
      "sourceShabadId": "9278",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਲਿਖੈ ਨਿਜ ਜੰਤ੍ਰ ॥",
      "transliteration": "likhai nij ja(n)tr ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕਾਤ ਵਿਚ ਬੈਠ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "लिखै निज जंत्र ॥",
      "sourceLineId": "100390",
      "sourceShabadId": "9278",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੁ ਬੈਠਿ ਇਕੰਤ੍ਰ ॥੫੭੮॥",
      "transliteration": "s baiTh ika(n)tr ||578||",
      "translation": "He gave his mantra to everyone, he abandoned all the Tantras and sitting in solitude, he produced his Yantras.578.",
      "punjabiViakhya": "ਆਪਣੇ ਜੰਤ੍ਰ ਲਿਖ ਦਿੱਤੇ ਹਨ ॥੫੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "सु बैठि इकंत्र ॥५७८॥",
      "sourceLineId": "100391",
      "sourceShabadId": "9278",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਾਨ ਤੁਰੰਗਮ ਛੰਦ ॥",
      "transliteration": "baan tura(n)gam chha(n)dh ||",
      "translation": "BAAN TURANGAM STANZA",
      "punjabiViakhya": "ਬਾਨ ਤੁਰੰਗਮ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "बान तुरंगम छंद ॥",
      "sourceLineId": "100392",
      "sourceShabadId": "9279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਿਬਿਧ ਰੂਪ ਸੋਭੈ ॥",
      "transliteration": "bibidh roop sobhai ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਵਿਧ ਰੂਪ ਹੋ ਕੇ ਸੋਭ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "बिबिध रूप सोभै ॥",
      "sourceLineId": "100393",
      "sourceShabadId": "9279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਨਿਕ ਲੋਗ ਲੋਭੈ ॥",
      "transliteration": "anik log lobhai ||",
      "translation": "Many people got allured by his various beautiful forms",
      "punjabiViakhya": "(ਉਸ ਉਤੇ) ਅਨੇਕ ਲੋਕ ਲੁਭਾਇਮਾਨ ਹੋ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "अनिक लोग लोभै ॥",
      "sourceLineId": "100394",
      "sourceShabadId": "9279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਮਿਤ ਤੇਜ ਤਾਹਿ ॥",
      "transliteration": "amit tej taeh ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਅਮਿਤ ਤੇਜ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "अमित तेज ताहि ॥",
      "sourceLineId": "100395",
      "sourceShabadId": "9279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਿਗਮ ਗਨਤ ਜਾਹਿ ॥੫੭੯॥",
      "transliteration": "nigam ganat jaeh ||579||",
      "translation": "In the language of the Vedas, his Glory was infinite.579.",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਦ ਵਿਚਾਰਦੇ ਹਨ ॥੫੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "निगम गनत जाहि ॥५७९॥",
      "sourceLineId": "100396",
      "sourceShabadId": "9279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਨਿਕ ਭੇਖ ਤਾ ਕੇ ॥",
      "transliteration": "anik bhekh taa ke ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅਨੇਕ ਭੇਖ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "अनिक भेख ता के ॥",
      "sourceLineId": "100397",
      "sourceShabadId": "9279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਿਬਿਧ ਰੂਪ ਵਾ ਕੇ ॥",
      "transliteration": "bibidh roop vaa ke ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵਿਵਿਧ ਰੂਪ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "बिबिध रूप वा के ॥",
      "sourceLineId": "100398",
      "sourceShabadId": "9279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਨੂਪ ਰੂਪ ਰਾਜੈ ॥",
      "transliteration": "anoop roop raajai ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੂਪਮ ਰੂਪ ਵਿਚ ਸੋਭਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "अनूप रूप राजै ॥",
      "sourceLineId": "100399",
      "sourceShabadId": "9279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬਿਲੋਕਿ ਪਾਪ ਭਾਜੈ ॥੫੮੦॥",
      "transliteration": "bilok paap bhaajai ||580||",
      "translation": "Seeing his many garbs, charms and glories, the sings fled away.580.",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ) ਵੇਖ ਕੇ ਪਾਪ ਭਜ ਜਾਦੇ ਹਨ ॥੫੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "बिलोकि पाप भाजै ॥५८०॥",
      "sourceLineId": "100400",
      "sourceShabadId": "9279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਿਸੇਖ ਪ੍ਰਬਲ ਜੇ ਹੁਤੇ ॥",
      "transliteration": "bisekh prabal je hute ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੜੇ ਵਿਸ਼ੇਸ਼ ਬਲਵਾਨ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "बिसेख प्रबल जे हुते ॥",
      "sourceLineId": "100401",
      "sourceShabadId": "9279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0609_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਨੂਪ ਰੂਪ ਸੰਜੁਤੇ ॥",
      "transliteration": "anoop roop sa(n)jute ||",
      "translation": "Those who were special powerful people composed of various forms,",
      "punjabiViakhya": "ਅਤੇ ਜੋ ਅਨੂਪ ਰੂਪ ਨਾਲ ਸੰਯੁਕਤ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 609,
      "hindi": "",
      "hindiTransliteration": "अनूप रूप संजुते ॥",
      "sourceLineId": "100402",
      "sourceShabadId": "9279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
