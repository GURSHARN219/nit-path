{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 610,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0610_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਮਿਤ ਅਰਿ ਘਾਵਹੀਂ ॥",
      "transliteration": "amit ar ghaavahee(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ ਦੇ) ਅਗਿਣਤ ਵੈਰੀਆਂ ਨੂੰ ਮਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "अमित अरि घावहीं ॥",
      "sourceLineId": "100403",
      "sourceShabadId": "9279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਗਤ ਜਸੁ ਪਾਵਹੀਂ ॥੫੮੧॥",
      "transliteration": "jagat jas paavahee(n) ||581||",
      "translation": "The Lord killed these innumerable enemies and obtained approbation in the world.581.",
      "punjabiViakhya": "(ਕਲਕੀ ਨੇ) ਜਗਤ ਵਿਚ ਯਸ਼ ਪਾਇਆ ਹੈ ॥੫੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "जगत जसु पावहीं ॥५८१॥",
      "sourceLineId": "100404",
      "sourceShabadId": "9279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਖੰਡ ਬਾਹੁ ਹੈ ਬਲੀ ॥",
      "transliteration": "akha(n)dd baahu hai balee ||",
      "translation": "",
      "punjabiViakhya": "(ਕਲਕੀ) ਅਖੰਡ ਬਾਹਵਾ ਵਾਲੇ ਬਲਵਾਨ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "अखंड बाहु है बली ॥",
      "sourceLineId": "100405",
      "sourceShabadId": "9279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੁਭੰਤ ਜੋਤਿ ਨਿਰਮਲੀ ॥",
      "transliteration": "subha(n)t jot niramalee ||",
      "translation": "The Lord is most powerful with indestructible arms and his pure light looks splendid",
      "punjabiViakhya": "ਅਤੇ ਨਿਰਮਲ ਜੋਤਿ ਨਾਲ ਸ਼ੋਭਾਇਮਾਨ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "सुभंत जोति निरमली ॥",
      "sourceLineId": "100406",
      "sourceShabadId": "9279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੁ ਹੋਮ ਜਗ ਕੋ ਕਰੈਂ ॥",
      "transliteration": "s hom jag ko karai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਮ ਅਤੇ ਯੱਗ ਨੂੰ ਕਰਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "सु होम जग को करैं ॥",
      "sourceLineId": "100407",
      "sourceShabadId": "9279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪਰਮ ਪਾਪ ਕੋ ਹਰੈਂ ॥੫੮੨॥",
      "transliteration": "param paap ko harai(n) ||582||",
      "translation": "He is removing the sins by performing the hom-yajna.582.",
      "punjabiViakhya": "ਅਤੇ ਵੱਡੇ ਪਾਪਾ ਨੂੰ ਹਰਦੇ ਹਨ ॥੫੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "परम पाप को हरैं ॥५८२॥",
      "sourceLineId": "100408",
      "sourceShabadId": "9279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤੋਮਰ ਛੰਦ ॥",
      "transliteration": "tomar chha(n)dh ||",
      "translation": "TOMAR STANZA",
      "punjabiViakhya": "ਤੋਮਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "तोमर छंद ॥",
      "sourceLineId": "100409",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਗ ਜੀਤਿਓ ਜਬ ਸਰਬ ॥",
      "transliteration": "jag jeetio jab sarab ||",
      "translation": "",
      "punjabiViakhya": "(ਕਲਕੀ ਨੇ) ਜਦ ਸਾਰਾ ਜਗਤ ਜਿਤ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "जग जीतिओ जब सरब ॥",
      "sourceLineId": "100410",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਬ ਬਾਢਿਓ ਅਤਿ ਗਰਬ ॥",
      "transliteration": "tab baaddio at garab ||",
      "translation": "When he conquered the whole world, his pride was extremely increased",
      "punjabiViakhya": "ਤਾ (ਉਸ ਦਾ) ਹੰਕਾਰ ਬਹੁਤ ਵਧ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "तब बाढिओ अति गरब ॥",
      "sourceLineId": "100411",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੀਅ ਕਾਲ ਪੁਰਖ ਬਿਸਾਰ ॥",
      "transliteration": "dheea kaal purakh bisaar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਕਾਲ ਪੁਰਖ ਨੂੰ ਵਿਸਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "दीअ काल पुरख बिसार ॥",
      "sourceLineId": "100412",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਕੀਨ ਬਿਚਾਰ ॥੫੮੩॥",
      "transliteration": "eeh bhaat keen bichaar ||583||",
      "translation": "He also forgot the unmanifested Brahmin and said this583",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਤਰ੍ਰਹਾ ਵਿਚਾਰ ਕਰਨ ਲਗਾ ॥੫੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "इह भाति कीन बिचार ॥५८३॥",
      "sourceLineId": "100413",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਿਨੁ ਮੋਹਿ ਦੂਸਰ ਨ ਔਰ ॥",
      "transliteration": "bin moh dhoosar na aauar ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਤੋਂ ਬਿਨਾ ਹੋਰ ਕੋਈ ਦੂਜੀ (ਸੱਤਾ) ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "बिनु मोहि दूसर न और ॥",
      "sourceLineId": "100414",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਸਿ ਮਾਨ੍ਯੋ ਸਬ ਠਉਰ ॥",
      "transliteration": "as maanayo sab Thaur ||",
      "translation": "“There is no second except me and the same is accepted at all the place",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਸਭ ਥਾ ਮੰਨਿਆ ਜਾਣ ਲਗਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "असि मान्यो सब ठउर ॥",
      "sourceLineId": "100415",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਗੁ ਜੀਤਿ ਕੀਨ ਗੁਲਾਮ ॥",
      "transliteration": "jag jeet keen gulaam ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਜਗਤ ਨੂੰ ਜਿਤ ਕੇ ਆਪਣਾ ਸੇਵਕ ਬਣਾ ਲਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "जगु जीति कीन गुलाम ॥",
      "sourceLineId": "100416",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਆਪਨ ਜਪਾਯੋ ਨਾਮ ॥੫੮੪॥",
      "transliteration": "aapan japaayo naam ||584||",
      "translation": "I have conquered the whole world and made it my slave and have caused everyone to repeat my name.584.",
      "punjabiViakhya": "ਅਤੇ ਆਪਣਾ ਨਾਮ ਜਪਵਾਉਣ ਲਗਾ ਦਿੱਤਾ ਹੈ ॥੫੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "आपन जपायो नाम ॥५८४॥",
      "sourceLineId": "100417",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਗਿ ਐਸ ਰੀਤਿ ਚਲਾਇ ॥",
      "transliteration": "jag aais reet chalai ||",
      "translation": "",
      "punjabiViakhya": "ਜਗਤ ਵਿਚ ਅਜਿਹੀ ਰੀਤ ਚਲਾ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "जगि ऐस रीति चलाइ ॥",
      "sourceLineId": "100418",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਿਰ ਅਤ੍ਰ ਪਤ੍ਰ ਫਿਰਾਇ ॥",
      "transliteration": "sir atr patr firai ||",
      "translation": "I have given life again to the traditional and have swung the canopy over my head",
      "punjabiViakhya": "ਅਤੇ ਸਿਰ ਉਤੇ ਛਤ੍ਰ ਫਿਰਾਉਣਾ ਸ਼ੁਰੂ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "सिर अत्र पत्र फिराइ ॥",
      "sourceLineId": "100419",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਬ ਲੋਗ ਆਪਨ ਮਾਨ ॥",
      "transliteration": "sab log aapan maan ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਲੋਕਾ ਨੂੰ ਆਪਣਾ (ਸੇਵਕ) ਮੰਨ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "सब लोग आपन मान ॥",
      "sourceLineId": "100420",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਰਿ ਆਂਖਿ ਅਉਰ ਨ ਆਨਿ ॥੫੮੫॥",
      "transliteration": "tar aa(n)kh aaur na aan ||585||",
      "translation": "All the people consider me as their own and none other comes to their sight.585.",
      "punjabiViakhya": "ਅਤੇ ਹੋਰ ਕਿਸੇ ਨੂੰ (ਆਪਣੀ) ਅੱਖ ਹੇਠ ਨਾ ਲਿਆਂਦਾ ॥੫੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "तरि आँखि अउर न आनि ॥५८५॥",
      "sourceLineId": "100421",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਹੀ ਕਾਲ ਪੁਰਖ ਜਪੰਤ ॥",
      "transliteration": "nahee kaal purakh japa(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਪੁਰਖ ਨੂੰ ਕੋਈ ਨਹੀਂ ਜਪਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "नही काल पुरख जपंत ॥",
      "sourceLineId": "100422",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਹਿ ਦੇਵਿ ਜਾਪੁ ਭਣੰਤ ॥",
      "transliteration": "neh dhev jaap bhana(n)t ||",
      "translation": "No one the repeats the name of the Lord-God or the name of any other God goddess",
      "punjabiViakhya": "ਨਾ ਹੀ ਦੇਵ (ਭਗਵਾਨ) ਦਾ (ਕੋਈ) ਸਿਮਰਨ ਕਰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "नहि देवि जापु भणंत ॥",
      "sourceLineId": "100423",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਬ ਕਾਲ ਦੇਵ ਰਿਸਾਇ ॥",
      "transliteration": "tab kaal dhev risai ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕਾਲ ਪੁਰਖ ਨੇ ਕ੍ਰੋਧ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "तब काल देव रिसाइ ॥",
      "sourceLineId": "100424",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇਕ ਅਉਰ ਪੁਰਖ ਬਨਾਇ ॥੫੮੬॥",
      "transliteration": "eik aaur purakh banai ||586||",
      "translation": "” Seeing this the Unamanifested Brahma created another purusha.586.",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਹੋਰ ਪੁਰਖ ਬਣਾ ਦਿੱਤਾ ॥੫੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "इक अउर पुरख बनाइ ॥५८६॥",
      "sourceLineId": "100425",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਚਿਅਸੁ ਮਹਿਦੀ ਮੀਰ ॥",
      "transliteration": "rachias mahidhee meer ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਮੀਰ ਮਹਿਦੀ ਰਚ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "रचिअसु महिदी मीर ॥",
      "sourceLineId": "100426",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਰਿਸਵੰਤ ਹਾਠ ਹਮੀਰ ॥",
      "transliteration": "risava(n)t haaTh hameer ||",
      "translation": "Mehdi Mir was created, who was very angry and persistent one",
      "punjabiViakhya": "(ਜੋ) ਬਹੁਤ ਕ੍ਰੋਧਵਾਨ, ਹਠੀ ਅਤੇ ਜ਼ਬਰਦਸਤ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "रिसवंत हाठ हमीर ॥",
      "sourceLineId": "100427",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਿਹ ਤਉਨ ਕੋ ਬਧੁ ਕੀਨ ॥",
      "transliteration": "teh taun ko badh keen ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਉਸ (ਕਲਕੀ) ਨੂੰ ਕਤਲ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "तिह तउन को बधु कीन ॥",
      "sourceLineId": "100428",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪੁਨਿ ਆਪ ਮੋ ਕੀਅ ਲੀਨ ॥੫੮੭॥",
      "transliteration": "pun aap mo keea leen ||587||",
      "translation": "He killed the Kalki incarnation within himself again.587.",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ (ਕਾਲ ਪੁਰਖ ਨੇ) ਆਪਣੇ ਵਿਚ ਮਿਲਾ ਲਿਆ ॥੫੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "पुनि आप मो कीअ लीन ॥५८७॥",
      "sourceLineId": "100429",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਗ ਜੀਤਿ ਆਪਨ ਕੀਨ ॥",
      "transliteration": "jag jeet aapan keen ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨੇ) ਜਗਤ ਨੂੰ ਜਿਤ ਕੇ ਆਪਣੇ ਅਧੀਨ ਕਰ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "जग जीति आपन कीन ॥",
      "sourceLineId": "100430",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਬ ਅੰਤਿ ਕਾਲ ਅਧੀਨ ॥",
      "transliteration": "sab a(n)t kaal adheen ||",
      "translation": "Those who conquered, the made it there possession they are all under the control of KAL (death) in the end",
      "punjabiViakhya": "(ਉਹ) ਸਾਰੇ ਅੰਤ ਵਿਚ ਕਾਲ ਦੇ ਅਧੀਨ ਹੋ ਗਏ (ਮਰ ਗਏ)।",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "सब अंति काल अधीन ॥",
      "sourceLineId": "100431",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਪੂਰਨ ਸੁ ਧਾਰਿ ॥",
      "transliteration": "eeh bhaat pooran su dhaar ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਚੰਗੀ ਤਰ੍ਰਹਾ ਸੁਧਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "इह भाति पूरन सु धारि ॥",
      "sourceLineId": "100432",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭਏ ਚੌਬਿਸੇ ਅਵਤਾਰ ॥੫੮੮॥",
      "transliteration": "bhe chauabise avataar ||588||",
      "translation": "In this way, with complete improvement the description of twenty-fourth incarnation is completed.588.",
      "punjabiViakhya": "ਚੌਬੀਸ ਅਵਤਾਰ ਦਾ ਪ੍ਰਸੰਗ ਪੂਰਾ ਹੋਇਆ ॥੫੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "भए चौबिसे अवतार ॥५८८॥",
      "sourceLineId": "100433",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਚਤੁਰ ਬਿਸਤਿ ਕਲਕੀ ਅਵਤਾਰ ਬਰਨਨੰ ਸਮਾਪਤੰ ॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the chatur bisat kalakee avataar baranana(n) samaapata(n) ||",
      "translation": "End of the description of twenty-fourth incarnation in Bachittar natak.",
      "punjabiViakhya": "ਇਥੇ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ ਚੌਬੀਸਵੇਾਂ ਕਲਕੀ ਅਵਤਾਰ ਦੇ ਵਰਣਨ ਦੀ ਸਮਾਪਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे चतुर बिसति कलकी अवतार बरननं समापतं ॥",
      "sourceLineId": "100434",
      "sourceShabadId": "9280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਥ ਮਹਿਦੀ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "transliteration": "ath mahidhee avataar kathana(n) ||",
      "translation": "(Now being the description of the killing of Mehdi Mir)",
      "punjabiViakhya": "ਹੁਣ ਮਹਿਦੀ ਅਵਤਾਰ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "अथ महिदी अवतार कथनं ॥",
      "sourceLineId": "100435",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤੋਮਰ ਛੰਦ ॥",
      "transliteration": "tomar chha(n)dh ||",
      "translation": "TOMAR STANZA",
      "punjabiViakhya": "ਤੋਮਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "तोमर छंद ॥",
      "sourceLineId": "100436",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਕੈ ਤਿੰਹ ਨਾਸਿ ॥",
      "transliteration": "eeh bhaat kai ti(n)h naas ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਉਸ ਦਾ ਨਾਸ਼ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "इह भाति कै तिंह नासि ॥",
      "sourceLineId": "100437",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕੀਅ ਸਤਿਜੁਗ ਪ੍ਰਕਾਸ ॥",
      "transliteration": "keea satijug prakaas ||",
      "translation": "In the way, destroying him, the age of the truth was manifested",
      "punjabiViakhya": "ਸਤਿਯੁਗ ਦਾ ਪ੍ਰਕਾਸ਼ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "कीअ सतिजुग प्रकास ॥",
      "sourceLineId": "100438",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਲਿਜੁਗ ਸਰਬ ਬਿਹਾਨ ॥",
      "transliteration": "kalijug sarab bihaan ||",
      "translation": "",
      "punjabiViakhya": "ਕਲਿਯੁਗ ਸਾਰਾ ਬੀਤ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "कलिजुग सरब बिहान ॥",
      "sourceLineId": "100439",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਿਜੁ ਜੋਤਿ ਜੋਤਿ ਸਮਾਨ ॥੧॥",
      "transliteration": "nij jot jot samaan ||1||",
      "translation": "The whole of Iron Age had passed away and the light manifested itself everywhere consistently .1",
      "punjabiViakhya": "(ਕਲਕੀ ਅਵਤਾਰ ਦੀ) ਨਿਜ ਜੋਤਿ (ਆਪਣੀ ਮੂਲ) ਜੋਤਿ ਵਿਚ ਲੀਨ ਹੋ ਗਈ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "निजु जोति जोति समान ॥१॥",
      "sourceLineId": "100440",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮਹਿਦੀ ਭਰ੍ਯੋ ਤਬ ਗਰਬ ॥",
      "transliteration": "mahidhee bharayo tab garab ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਮੀਰ ਮਹਿੰਦੀ ਹੰਕਾਰ ਨਾਲ ਭਰ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "महिदी भर्यो तब गरब ॥",
      "sourceLineId": "100441",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਗ ਜੀਤਯੋ ਜਬ ਸਰਬ ॥",
      "transliteration": "jag jeetayo jab sarab ||",
      "translation": "Then Mir Mehdi, conquering the whole world, was filled with pride",
      "punjabiViakhya": "ਜਦ ਉਸ ਨੇ ਸਾਰਾ ਜਗਤ ਜਿਤ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "जग जीतयो जब सरब ॥",
      "sourceLineId": "100442",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਿਰਿ ਅਤ੍ਰ ਪਤ੍ਰ ਫਿਰਾਇ ॥",
      "transliteration": "sir atr patr firai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸਿਰ ਉਤੇ ਛਤ੍ਰ ਫਿਰਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "सिरि अत्र पत्र फिराइ ॥",
      "sourceLineId": "100443",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਗ ਜੇਰ ਕੀਨ ਬਨਾਇ ॥੨॥",
      "transliteration": "jag jer keen banai ||2||",
      "translation": "He also got the canopy swung over his head and caused the whole world to bow at his feet.2.",
      "punjabiViakhya": "ਅਤੇ ਜਗਤ ਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਆਪਣੇ ਅਧੀਨ ਕਰ ਲਿਆ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "जग जेर कीन बनाइ ॥२॥",
      "sourceLineId": "100444",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਿਨੁ ਆਪੁ ਜਾਨਿ ਨ ਔਰ ॥",
      "transliteration": "bin aap jaan na aauar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਆਪਣੇ ਤੋਂ ਬਿਨਾ",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "बिनु आपु जानि न और ॥",
      "sourceLineId": "100445",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਬ ਰੂਪ ਅਉ ਸਬ ਠਉਰ ॥",
      "transliteration": "sab roop aau sab Thaur ||",
      "translation": "Expect himself, he did not have faith in anyone",
      "punjabiViakhya": "ਸਾਰੇ ਰੂਪਾ ਅਤੇ ਸਥਾਨਾ ਵਿਚ ਹੋਰ ਕਿਸੇ ਨੂੰ ਵੀ ਨਾ ਜਾਣਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "सब रूप अउ सब ठउर ॥",
      "sourceLineId": "100446",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਿਨਿ ਏਕ ਦਿਸਟਿ ਨ ਆਨ ॥",
      "transliteration": "jin ek dhisaT na aan ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਇਕ (ਪ੍ਰਭੂ) ਨੂੰ ਵੀ ਨਜ਼ਰ ਹੇਠਾ ਨਾ ਲਿਆਂਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "जिनि एक दिसटि न आन ॥",
      "sourceLineId": "100447",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਿਸੁ ਲੀਨ ਕਾਲ ਨਿਦਾਨ ॥੩॥",
      "transliteration": "tis leen kaal nidhaan ||3||",
      "translation": "He who did not comprehend One Lord-God, he ultimately could not save himself from KAL(death).3.",
      "punjabiViakhya": "ਅੰਤ ਵਿਚ ਕਾਲ ਨੇ ਉਸ ਨੂੰ ਆਪਣੇ ਵਿਚ ਲੀਨ ਕਰ ਲਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "तिसु लीन काल निदान ॥३॥",
      "sourceLineId": "100448",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਿਨੁ ਏਕ ਦੂਸਰ ਨਾਹਿ ॥",
      "transliteration": "bin ek dhoosar naeh ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਰੰਗਾ ਰੂਪਾ ਵਿਚ",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "बिनु एक दूसर नाहि ॥",
      "sourceLineId": "100449",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0610_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਬ ਰੰਗ ਰੂਪਨ ਮਾਹਿ ॥",
      "transliteration": "sab ra(n)g roopan maeh ||",
      "translation": "There is not one other in all colours and forms except one God",
      "punjabiViakhya": "(ਉਸ) ਇਕ ਤੋਂ ਬਿਨਾ ਹੋਰ ਦੂਜਾ ਕੋਈ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 610,
      "hindi": "",
      "hindiTransliteration": "सब रंग रूपन माहि ॥",
      "sourceLineId": "100450",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
