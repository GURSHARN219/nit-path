{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 611,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0611_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਨਿ ਏਕ ਕੋ ਨ ਪਛਾਨ ॥",
      "transliteration": "jin ek ko na pachhaan ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ (ਉਸ) ਇਕ ਨੂੰ ਨਹੀਂ ਪਛਾਣਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "जिनि एक को न पछान ॥",
      "sourceLineId": "100451",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਿਹ ਬ੍ਰਿਥਾ ਜਨਮ ਬਿਤਾਨ ॥੪॥",
      "transliteration": "teh birathaa janam bitaan ||4||",
      "translation": "He, who has not recognized that one Lord, he wasted his birth.4.",
      "punjabiViakhya": "ਉਸ ਨੇ ਵਿਅਰਥ ਵਿਚ ਜਨਮ ਬਿਤਾ ਦਿੱਤਾ ਹੈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "तिह बृथा जनम बितान ॥४॥",
      "sourceLineId": "100452",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਿਨੁ ਏਕ ਦੂਜ ਨ ਔਰ ॥",
      "transliteration": "bin ek dhooj na aauar ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਤੋਂ ਬਿਨਾ ਹੋਰ ਦੂਜਾ ਕੋਈ ਨਹੀਂ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "बिनु एक दूज न और ॥",
      "sourceLineId": "100453",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਲ ਬਾ ਥਲੇ ਸਬ ਠਉਰ ॥",
      "transliteration": "jal baa thale sab Thaur ||",
      "translation": "Expect that one Lord, there is none other in water, on plain and all the places",
      "punjabiViakhya": "ਜਲ, ਥਲ ਅਤੇ ਸਭ ਥਾਵਾ ਵਿਚ ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "जल बा थले सब ठउर ॥",
      "sourceLineId": "100454",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਿਨਿ ਏਕ ਸਤਿ ਨ ਜਾਨ ॥",
      "transliteration": "jin ek sat na jaan ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਇਕ (ਪਰਮਾਤਮਾ) ਨੂੰ ਸਤਿ ਕਰ ਕੇ ਨਹੀਂ ਸਮਝਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "जिनि एक सति न जान ॥",
      "sourceLineId": "100455",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੋ ਜੂਨਿ ਜੂਨਿ ਭ੍ਰਮਾਨ ॥੫॥",
      "transliteration": "so joon joon bhramaan ||5||",
      "translation": "He who had not recognized the One Reality, he only roamed away amongst the Yogis.5.",
      "punjabiViakhya": "ਉਹ ਜੂਨਾ ਦਰ ਜੂਨਾ ਵਿਚ ਭਰਮਦਾ ਰਹਿੰਦਾ ਹੈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "सो जूनि जूनि भ्रमान ॥५॥",
      "sourceLineId": "100456",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਜਿ ਏਕ ਜਾਨਾ ਦੂਜ ॥",
      "transliteration": "taj ek jaanaa dhooj ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਹੜਾ) ਇਕ ਨੂੰ ਛਡ ਕੇ ਦੂਜੇ ਨੂੰ ਜਾਣਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "तजि एक जाना दूज ॥",
      "sourceLineId": "100457",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮਮ ਜਾਨਿ ਤਾਸੁ ਨ ਸੂਝ ॥",
      "transliteration": "mam jaan taas na soojh ||",
      "translation": "He who leaving the one, believed in another one, in my view, he is devoid of wisdom",
      "punjabiViakhya": "ਮੈਂ ਸਮਝਦਾ ਹਾ, ਉਸ ਵਿਚ ਸੂਝ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "मम जानि तासु न सूझ ॥",
      "sourceLineId": "100458",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਿਹ ਦੂਖ ਭੂਖ ਪਿਆਸ ॥",
      "transliteration": "teh dhookh bhookh piaas ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਦੁਖ, ਭੁਖ ਅਤੇ ਪਿਆਸ (ਸਦਾ ਘੇਰੀ ਰਖਦੀ ਹੈ)।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "तिह दूख भूख पिआस ॥",
      "sourceLineId": "100459",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦਿਨ ਰੈਨਿ ਸਰਬ ਉਦਾਸ ॥੬॥",
      "transliteration": "dhin rain sarab udhaas ||6||",
      "translation": "He will be surrounded by suffering, hunger, thirst and anxiety throughout day and night.6.",
      "punjabiViakhya": "(ਉਹ) ਦਿਨ ਰਾਤ ਸਭ ਵੇਲੇ ਉਦਾਸ ਰਹਿੰਦਾ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "दिन रैनि सरब उदास ॥६॥",
      "sourceLineId": "100460",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਹਿੰ ਚੈਨ ਐਨ ਸੁ ਵਾਹਿ ॥",
      "transliteration": "nahi(n) chain aain su vaeh ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਘਰ ਵਿਚ ਸੁਖ ਆਰਾਮ ਨਹੀਂ ਮਿਲੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "नहिं चैन ऐन सु वाहि ॥",
      "sourceLineId": "100461",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਿਤ ਰੋਗ ਹੋਵਤ ਤਾਹਿ ॥",
      "transliteration": "nit rog hovat taeh ||",
      "translation": "He will never get peace and will always be surrounded by ailments",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਨਿੱਤ ਰੋਗ ਹੋਣਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "नित रोग होवत ताहि ॥",
      "sourceLineId": "100462",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਤਿ ਦੂਖ ਭੂਖ ਮਰੰਤ ॥",
      "transliteration": "at dhookh bhookh mara(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਸਦਾ ਦੁਖ ਭੁਖ ਵਿਚ ਮਰੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "अति दूख भूख मरंत ॥",
      "sourceLineId": "100463",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਹੀ ਚੈਨ ਦਿਵਸ ਬਿਤੰਤ ॥੭॥",
      "transliteration": "nahee chain dhivas bita(n)t ||7||",
      "translation": "He will always suffer death on account of suffering and hunger, he will always remain restless.7.",
      "punjabiViakhya": "ਸੁਖ ਵਿਚ ਦਿਨ ਨਹੀਂ ਬੀਤਣਗੇ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "नही चैन दिवस बितंत ॥७॥",
      "sourceLineId": "100464",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਨ ਪਾਦ ਕੁਸਟ ਚਲੰਤ ॥",
      "transliteration": "tan paadh kusaT chala(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਪੈਰਾ ਤੇ ਕੋਹੜ ਹੋ ਜਾਵੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "तन पाद कुसट चलंत ॥",
      "sourceLineId": "100465",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਪੁ ਗਲਤ ਨਿਤ ਗਲੰਤ ॥",
      "transliteration": "bap galat nit gala(n)t ||",
      "translation": "The leprosy will prevail in his body and all his body will rot",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਰੀਰ (ਕੋਹੜ ਨਾਲ) ਸਦਾ ਗਲਦਾ ਰਹੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "बपु गलत नित गलंत ॥",
      "sourceLineId": "100466",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਹਿੰ ਨਿਤ ਦੇਹ ਅਰੋਗ ॥",
      "transliteration": "nahi(n) nit dheh arog ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਦੇਹ ਨਿੱਤ ਅਰੋਗ ਨਹੀਂ ਰਹੇਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "नहिं नित देह अरोग ॥",
      "sourceLineId": "100467",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਿਤਿ ਪੁਤ੍ਰ ਪੌਤ੍ਰਨ ਸੋਗ ॥੮॥",
      "transliteration": "nit putr pauatran sog ||8||",
      "translation": "His body will not remain health and his foundness for sons and grandson will always afflict him.8.",
      "punjabiViakhya": "ਅਤੇ ਨਿੱਤ ਪੁੱਤਰ-ਪੋਤਰਿਆਂ ਦਾ ਸੋਗ ਹੁੰਦਾ ਰਹੇਗਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "निति पुत्र पौत्रन सोग ॥८॥",
      "sourceLineId": "100468",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਿਤ ਨਾਸ ਤਿਹ ਪਰਿਵਾਰ ॥",
      "transliteration": "nit naas teh parivaar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਪਰਿਵਾਰ ਨਿੱਤ ਨਸ਼ਟ (ਹੁੰਦਾ ਰਹੇਗਾ)",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "नित नास तिह परिवार ॥",
      "sourceLineId": "100469",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਹਿ ਅੰਤ ਦੇਹ ਉਧਾਰ ॥",
      "transliteration": "neh a(n)t dheh udhaar ||",
      "translation": "His family will be destroyed and at the and, his body will not be redeemed also",
      "punjabiViakhya": "ਅਤੇ ਦੇਹ ਦਾ ਅੰਤ ਤਕ ਕਲਿਆਣ ਨਹੀਂ ਹੋਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "नहि अंत देह उधार ॥",
      "sourceLineId": "100470",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਿਤ ਰੋਗ ਸੋਗ ਗ੍ਰਸੰਤ ॥",
      "transliteration": "nit rog sog grasa(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਨਿੱਤ ਰੋਗਾ ਸੋਗਾ ਵਿਚ ਗ੍ਰਸਿਆ ਰਹੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "नित रोग सोग ग्रसंत ॥",
      "sourceLineId": "100471",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮ੍ਰਿਤ ਸ੍ਵਾਨ ਅੰਤ ਮਰੰਤ ॥੯॥",
      "transliteration": "mirat savaiaan a(n)t mara(n)t ||9||",
      "translation": "He will always be engrossed in disease and sorrow, ultimately, he will die the death of a dog .9.",
      "punjabiViakhya": "ਅੰਤ ਵਿਚ ਕੁੱਤੇ ਦੀ ਮੌਤ ਮਰੇਗਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "मृत स्वान अंत मरंत ॥९॥",
      "sourceLineId": "100472",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਬ ਜਾਨਿ ਕਾਲ ਪ੍ਰਬੀਨ ॥",
      "transliteration": "tab jaan kaal prabeen ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸਮਰਥ ਕਾਲ ਪੁਰਖ ਨੇ (ਮੀਰ ਮਹਿੰਦੀ ਦੇ ਹੰਕਾਰ ਨੂੰ) ਜਾਣ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "तब जानि काल प्रबीन ॥",
      "sourceLineId": "100473",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਿਹ ਮਾਰਿਓ ਕਰਿ ਦੀਨ ॥",
      "transliteration": "teh maario kar dheen ||",
      "translation": "Reflecting over the egoistic state of Mir Mehdi the Unmanifested Brahman thought of killing him",
      "punjabiViakhya": "(ਤਾ) ਉਸ ਨੂੰ ਬਹੁਤ ਹੀਣਾ ਕਰ ਕੇ ਮਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "तिह मारिओ करि दीन ॥",
      "sourceLineId": "100474",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਇਕੁ ਕੀਟ ਦੀਨ ਉਪਾਇ ॥",
      "transliteration": "eik keeT dheen upai ||",
      "translation": "",
      "punjabiViakhya": "(ਕਾਲ ਪੁਰਖ ਨੇ) ਇਕ ਕੀੜਾ ਪੈਦਾ ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "इकु कीट दीन उपाइ ॥",
      "sourceLineId": "100475",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਿਸ ਕਾਨਿ ਪੈਠੋ ਜਾਇ ॥੧੦॥",
      "transliteration": "tis kaan paiTho jai ||10||",
      "translation": "He created an insect, which entered the ear of Mir Mehdi.10.",
      "punjabiViakhya": "(ਅਤੇ ਉਸ ਨੂੰ ਹੁਕਮ ਦਿੱਤਾ ਕਿ) ਉਸ ਦੇ ਕੰਨ ਵਿਚ ਧਸ ਜਾਵੇ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "तिस कानि पैठो जाइ ॥१०॥",
      "sourceLineId": "100476",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਧਸਿ ਕੀਟ ਕਾਨਨ ਬੀਚ ॥",
      "transliteration": "dhas keeT kaanan beech ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਕੰਨ ਵਿਚ ਕੀੜਾ ਵੜ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "धसि कीट कानन बीच ॥",
      "sourceLineId": "100477",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਿਸੁ ਜੀਤਯੋ ਜਿਮਿ ਨੀਚ ॥",
      "transliteration": "tis jeetayo jim neech ||",
      "translation": "Entering his ear, that insect conquered that base fellow, and",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਨੀਚ ਵਾਗ ਜਿਤ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "तिसु जीतयो जिमि नीच ॥",
      "sourceLineId": "100478",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਹੁ ਭਾਤਿ ਦੇਇ ਦੁਖ ਤਾਹਿ ॥",
      "transliteration": "bahu bhaat dhei dhukh taeh ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਬਹੁਤ ਤਰ੍ਰਹਾ ਦੇ ਦੁਖ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "बहु भाति देइ दुख ताहि ॥",
      "sourceLineId": "100479",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਮਾਰਿਓ ਵਾਹਿ ॥੧੧॥",
      "transliteration": "eeh bhaat maario vaeh ||11||",
      "translation": "Giving him various types of suffering, killed him in this way.11.",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਤਰ੍ਰਹਾ ਉਸ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "इह भाति मारिओ वाहि ॥११॥",
      "sourceLineId": "100480",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਮਹਿਦੀ ਮੀਰ ਬਧ ॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the mahidhee meer badh ||",
      "translation": "End of the description of twenty-fourth incarnation in Bachittar natak.",
      "punjabiViakhya": "ਇਥੇ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ ਮੀਰ ਮਹਿੰਦੀ ਦਾ ਬਧ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे महिदी मीर बध ॥",
      "sourceLineId": "100481",
      "sourceShabadId": "9281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬ੍ਰਹਮਾ ਅਵਤਾਰ ॥",
      "transliteration": "brahamaa avataar ||",
      "translation": "Brahma Avatar",
      "punjabiViakhya": "ਬ੍ਰਹਮਾ ਅਵਤਾਰ:",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "ब्रहमा अवतार ॥",
      "sourceLineId": "100482",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ੴ ਸਤਿਗੁਰਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satiguraprasaadh ||",
      "translation": "Grace of the true Guru",
      "punjabiViakhya": "ੴ ਸਤਿਗੁਰਪ੍ਰਸਾਦਿ:",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "ੴ सतिगुरप्रसादि ॥",
      "sourceLineId": "100483",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਥ ਬ੍ਰਹਮਾ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "transliteration": "ath brahamaa avataar kathana(n) ||",
      "translation": "Now being the description of Brahma Incarnation",
      "punjabiViakhya": "ਹੁਣ ਬ੍ਰਹਮਾ ਅਵਤਾਰ ਦਾ ਕਥਨ:",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "अथ ब्रहमा अवतार कथनं ॥",
      "sourceLineId": "100484",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪਾਤਿਸਾਹੀ ੧੦ ॥",
      "transliteration": "paatisaahee 10 ||",
      "translation": "",
      "punjabiViakhya": "ਪਾਤਸ਼ਾਹੀ ੧੦:",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "पातिसाही १० ॥",
      "sourceLineId": "100485",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤੋਮਰ ਛੰਦ ॥",
      "transliteration": "tomar chha(n)dh ||",
      "translation": "TOMAR STANZA",
      "punjabiViakhya": "ਤੋਮਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "तोमर छंद ॥",
      "sourceLineId": "100486",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਤਿਜੁਗਿ ਫਿਰਿ ਉਪਰਾਜਿ ॥",
      "transliteration": "satijug fir uparaaj ||",
      "translation": "",
      "punjabiViakhya": "ਸਤਿਯੁਗ ਫਿਰ (ਧਰਤੀ ਉਤੇ) ਸਥਾਪਿਤ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "सतिजुगि फिरि उपराजि ॥",
      "sourceLineId": "100487",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਬ ਨਉਤਨੈ ਕਰਿ ਸਾਜ ॥",
      "transliteration": "sab nautanai kar saaj ||",
      "translation": "The age the truth was established again and all the new creation appeared",
      "punjabiViakhya": "ਸਾਰੇ ਸਾਜ ਨਵੇਾਂ ਕਰ ਲਏ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "सब नउतनै करि साज ॥",
      "sourceLineId": "100488",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਬ ਦੇਸ ਅਉਰ ਬਿਦੇਸ ॥",
      "transliteration": "sab dhes aaur bidhes ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਦੇਸਾ ਅਤੇ ਬਿਦੇਸਾ ਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "सब देस अउर बिदेस ॥",
      "sourceLineId": "100489",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਉਠਿ ਧਰਮ ਲਾਗਿ ਨਰੇਸ ॥੧॥",
      "transliteration": "auTh dharam laag nares ||1||",
      "translation": "The kings of all the countries because religious.1.",
      "punjabiViakhya": "ਰਾਜੇ ਉਠ ਕੇ ਧਰਮ-ਕਰਮ ਵਿਚ ਲਗ ਗਏ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "उठि धरम लागि नरेस ॥१॥",
      "sourceLineId": "100490",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਲਿ ਕਾਲ ਕੋਪਿ ਕਰਾਲ ॥",
      "transliteration": "kal kaal kop karaal ||",
      "translation": "",
      "punjabiViakhya": "ਕਲਿਯੁਗ ਦਾ ਭਿਆਨਕ ਅਤੇ ਕ੍ਰੋਧਵਾਨ ਸਮਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "कलि काल कोपि कराल ॥",
      "sourceLineId": "100491",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਗੁ ਜਾਰਿਆ ਤਿਹ ਜ੍ਵਾਲ ॥",
      "transliteration": "jag jaariaa teh javaiaal ||",
      "translation": "O the Lord of breadful fury! there is none else except thee,",
      "punjabiViakhya": "ਉਸ ਨੇ ਜਗਤ ਨੂੰ (ਆਪਣੀ) ਅੱਗ ਵਿਚ ਸਾੜ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "जगु जारिआ तिह ज्वाल ॥",
      "sourceLineId": "100492",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਿਨੁ ਤਾਸੁ ਔਰ ਨ ਕੋਈ ॥",
      "transliteration": "bin taas aauar na koiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਪਰਮ ਸੱਤਾ) ਤੋਂ ਬਿਨਾ ਹੋਰ ਕੋਈ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "बिनु तासु और न कोई ॥",
      "sourceLineId": "100493",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਬ ਜਾਪ ਜਾਪੋ ਸੋਇ ॥੨॥",
      "transliteration": "sab jaap jaapo soi ||2||",
      "translation": "Who created the Iron Age and its fires burning the word, everyone should repeat His Name.2.",
      "punjabiViakhya": "(ਇਸ ਲਈ) ਸਾਰੇ ਉਸ (ਇਕ) ਦਾ ਜਾਪ ਜਪੋ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "सब जाप जापो सोइ ॥२॥",
      "sourceLineId": "100494",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜੇ ਜਾਪ ਹੈ ਕਲਿ ਨਾਮੁ ॥",
      "transliteration": "je jaap hai kal naam ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਕਲਿਯੁਗ ਵਿਚ ਨਾਮ ਨੂੰ ਜਪਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "जे जाप है कलि नामु ॥",
      "sourceLineId": "100495",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਿਸੁ ਪੂਰਨ ਹੁਇ ਹੈ ਕਾਮ ॥",
      "transliteration": "tis pooran hui hai kaam ||",
      "translation": "Those who will remember the Name of the Lord in the Iron Age, all their tasks will be fulfilled",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੀਆਂ ਕਾਮਨਾਵਾ (ਮਨੋਰਥ) ਪੂਰਨ ਹੋ ਜਾਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "तिसु पूरन हुइ है काम ॥",
      "sourceLineId": "100496",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਿਸੁ ਦੂਖ ਭੂਖ ਨ ਪਿਆਸ ॥",
      "transliteration": "tis dhookh bhookh na piaas ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਨ੍ਰਹਾ ਨੂੰ ਦੁਖ, ਭੁਖ ਅਤੇ ਪਿਆਸ ਨਹੀਂ ਲਗਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "तिसु दूख भूख न पिआस ॥",
      "sourceLineId": "100497",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਿਤਿ ਹਰਖੁ ਕਹੂੰ ਨ ਉਦਾਸ ॥੩॥",
      "transliteration": "nit harakh kahoo(n) na udhaas ||3||",
      "translation": "They will never experience suffering, hunger and anxiety and will always remain happy.3.",
      "punjabiViakhya": "ਸਦਾ ਖੁਸ਼ ਰਹਿੰਦੇ ਹਨ ਅਤੇ ਕਦੇ ਵੀ ਉਦਾਸ ਨਹੀਂ ਹੁੰਦੇ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "निति हरखु कहूँ न उदास ॥३॥",
      "sourceLineId": "100498",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਬਿਨੁ ਏਕ ਦੂਸਰ ਨਾਹਿ ॥",
      "transliteration": "bin ek dhoosar naeh ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਇਕ ਤੋਂ ਬਿਨਾ ਹੋਰ ਦੂਜਾ ਕੋਈ ਨਹੀਂ;",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "बिनु एक दूसर नाहि ॥",
      "sourceLineId": "100499",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਭ ਰੰਗ ਰੂਪਨ ਮਾਹਿ ॥",
      "transliteration": "sabh ra(n)g roopan maeh ||",
      "translation": "There is none else except the One Lord pervanding all the colours and forms",
      "punjabiViakhya": "ਸਭ ਰੂਪਾ, ਰੰਗਾ ਵਿਚ (ਉਹੀ) ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "सभ रंग रूपन माहि ॥",
      "sourceLineId": "100500",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜਿਨ ਜਾਪਿਆ ਤਿਹਿ ਜਾਪੁ ॥",
      "transliteration": "jin jaapiaa teh jaap ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੇ ਉਸ ਦੇ ਜਾਪ ਨੂੰ ਜਪਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "जिन जापिआ तिहि जापु ॥",
      "sourceLineId": "100501",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਤਿਨ ਕੇ ਸਹਾਈ ਆਪ ॥੪॥",
      "transliteration": "tin ke sahaiee aap ||4||",
      "translation": "He helps those who repeat His Name.4.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਸਹਾਈ (ਉਹ) ਆਪ ਹੀ (ਹੋਏ ਹਨ) ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "तिन के सहाई आप ॥४॥",
      "sourceLineId": "100502",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜੇ ਤਾਸੁ ਨਾਮ ਜਪੰਤ ॥",
      "transliteration": "je taas naam japa(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਉਸ ਦੇ ਨਾਮ ਨੂੰ ਜਪਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "जे तासु नाम जपंत ॥",
      "sourceLineId": "100503",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਬਹੂੰ ਨ ਭਾਜਿ ਚਲੰਤ ॥",
      "transliteration": "kabahoo(n) na bhaaj chala(n)t ||",
      "translation": "Those who remember His Name, never run away",
      "punjabiViakhya": "ਉਹ ਕਦੇ (ਬਨਾ ਵਿਚ) ਭਜ ਕੇ ਨਹੀਂ ਜਾਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "कबहूँ न भाजि चलंत ॥",
      "sourceLineId": "100504",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਹਿ ਤ੍ਰਾਸੁ ਤਾ ਕੋ ਸਤ੍ਰ ॥",
      "transliteration": "neh traas taa ko satr ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਵੈਰੀ ਦਾ ਡਰ ਨਹੀਂ ਹੁੰਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "नहि त्रासु ता को सत्र ॥",
      "sourceLineId": "100505",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਦਿਸਿ ਜੀਤਿ ਹੈ ਗਹਿ ਅਤ੍ਰ ॥੫॥",
      "transliteration": "dhis jeet hai geh atr ||5||",
      "translation": "They do not fear the enemies and wearing their arms and weapons, they conquer all the direction.5.",
      "punjabiViakhya": "ਉਹ ਹਥਿਆਰ ਪਕੜ ਕੇ ਦਿਸ਼ਾਵਾ ਨੂੰ ਜਿਤ ਲੈਂਦੇ ਹਨ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "दिसि जीति है गहि अत्र ॥५॥",
      "sourceLineId": "100506",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਤਿਹ ਭਰੇ ਧਨ ਸੋ ਧਾਮ ॥",
      "transliteration": "teh bhare dhan so dhaam ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਘਰ ਧਨ ਨਾਲ ਭਰੇ ਰਹਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "तिह भरे धन सो धाम ॥",
      "sourceLineId": "100507",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਸਭ ਹੋਹਿ ਪੂਰਨ ਕਾਮ ॥",
      "transliteration": "sabh hoh pooran kaam ||",
      "translation": "Their houses are filled with wealth and all their tasks are fulfilled",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੀਆਂ) ਸਾਰੀਆਂ ਕਾਮਨਾਵਾ ਪੂਰੀਆਂ ਹੁੰਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "सभ होहि पूरन काम ॥",
      "sourceLineId": "100508",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਜੇ ਏਕ ਨਾਮੁ ਜਪੰਤ ॥",
      "transliteration": "je ek naam japa(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਇਕ ਨਾਮ ਦਾ ਸਿਮਰਨ ਕਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "जे एक नामु जपंत ॥",
      "sourceLineId": "100509",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਨਾਹਿ ਕਾਲ ਫਾਸਿ ਫਸੰਤ ॥੬॥",
      "transliteration": "naeh kaal faas fasa(n)t ||6||",
      "translation": "Those who remember the Name of one Lord, they are not entrapped in the noose of death.6.",
      "punjabiViakhya": "ਉਹ ਕਾਲ ਦੇ ਫੰਧੇ ਵਿਚ ਨਹੀਂ ਫਸਦੇ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "नाहि काल फासि फसंत ॥६॥",
      "sourceLineId": "100510",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਜੇ ਜੀਵ ਜੰਤ ਅਨੇਕ ॥",
      "transliteration": "je jeev ja(n)t anek ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਅਨੇਕ ਤਰ੍ਰਹਾ ਦੇ ਜੀਵ ਜੰਤ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "जे जीव जंत अनेक ॥",
      "sourceLineId": "100511",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਤਿਨ ਮੋ ਰਹ੍ਯੋ ਰਮਿ ਏਕ ॥",
      "transliteration": "tin mo rahayo ram ek ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਸਾਰਿਆਂ ਵਿਚ ਇਕ (ਪ੍ਰਭੂ) ਰਮ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "तिन मो रह्यो रमि एक ॥",
      "sourceLineId": "100512",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਬਿਨੁ ਏਕ ਦੂਸਰ ਨਾਹਿ ॥",
      "transliteration": "bin ek dhoosar naeh ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ (ਪ੍ਰਭੂ) ਦੇ ਹੋਰ ਦੂਜਾ ਕੋਈ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "बिनु एक दूसर नाहि ॥",
      "sourceLineId": "100513",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਜਗਿ ਜਾਨਿ ਲੈ ਜੀਅ ਮਾਹਿ ॥੭॥",
      "transliteration": "jag jaan lai jeea maeh ||7||",
      "translation": "That One Lord is pervading all the created beings and the whole world should know that there is none else except Him.7.",
      "punjabiViakhya": "ਜਗਤ ਨੂੰ ਇਹ ਗੱਲ ਮਨ ਵਿਚ ਸਮਝ ਲੈਣੀ ਚਾਹੀਦੀ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "जगि जानि लै जीअ माहि ॥७॥",
      "sourceLineId": "100514",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਭਵ ਗੜਨ ਭੰਜਨ ਹਾਰ ॥",
      "transliteration": "bhav gaRan bha(n)jan haar ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਸਾਰ ਨੂੰ ਘੜਨ ਅਤੇ ਭੰਨਣ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "भव गड़न भंजन हार ॥",
      "sourceLineId": "100515",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਹੈ ਏਕ ਹੀ ਕਰਤਾਰ ॥",
      "transliteration": "hai ek hee karataar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਕ ਹੀ ਕਰਤਾਰ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "है एक ही करतार ॥",
      "sourceLineId": "100516",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਬਿਨੁ ਏਕ ਅਉਰੁ ਨ ਕੋਇ ॥",
      "transliteration": "bin ek aaur na koi ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਇਕ ਤੋਂ ਬਿਨਾ ਹੋਰ ਦੂਜਾ ਕੋਈ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "बिनु एक अउरु न कोइ ॥",
      "sourceLineId": "100517",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਸਬ ਰੂਪ ਰੰਗੀ ਸੋਇ ॥੮॥",
      "transliteration": "sab roop ra(n)gee soi ||8||",
      "translation": "The One Lord is the creator as well as the Destroyer of the whole world and there is one other in all the colours and forms.8.",
      "punjabiViakhya": "ਸਭ ਰੂਪਾ ਰੰਗਾ ਵਾਲਾ ਉਹੀ ਹੈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "सब रूप रंगी सोइ ॥८॥",
      "sourceLineId": "100518",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਕਈ ਇੰਦ੍ਰ ਪਾਨਪਹਾਰ ॥",
      "transliteration": "kiee i(n)dhr paanapahaar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ ਦੁਆਰ ਉਤੇ) ਕਈ ਇੰਦਰ ਪਾਣੀ ਪਿਲਾਉਣ ਵਾਲੇ ਸੁਰਾਹੀ-ਬਰਦਾਰ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "कई इंद्र पानपहार ॥",
      "sourceLineId": "100519",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਕਈ ਬ੍ਰਹਮ ਬੇਦ ਉਚਾਰ ॥",
      "transliteration": "kiee braham bedh uchaar ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਬ੍ਰਹਮੇ ਵੇਦਾ ਦਾ ਉਚਾਰਨ ਕਰਨ ਵਾਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "कई ब्रहम बेद उचार ॥",
      "sourceLineId": "100520",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਕਈ ਬੈਠਿ ਦੁਆਰਿ ਮਹੇਸ ॥",
      "transliteration": "kiee baiTh dhuaar mahes ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਮਹੇਸ਼ ਦੁਆਰ ਉਤੇ ਬੈਠੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "कई बैठि दुआरि महेस ॥",
      "sourceLineId": "100521",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0611_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਕਈ ਸੇਸਨਾਗ ਅਸੇਸ ॥੯॥",
      "transliteration": "kiee sesanaag ases ||9||",
      "translation": "Many indras are in His service, many Brahmas recite the Vedas, many Shivas sit at His Gate and many Sheshnagas remain present in order to become His bed.9.",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਸ਼ੇਸ਼ਨਾਗ ਅਣਗਿਣਤ (ਨਾਮ ਜਪਦੇ ਹਨ) ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 611,
      "hindi": "",
      "hindiTransliteration": "कई सेसनाग असेस ॥९॥",
      "sourceLineId": "100522",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
