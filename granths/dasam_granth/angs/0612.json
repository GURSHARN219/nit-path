{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 612,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0612_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਈ ਸੂਰ ਚੰਦ ਸਰੂਪ ॥",
      "transliteration": "kiee soor cha(n)dh saroop ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਜਾ ਅਤੇ ਚੰਦ੍ਰਮਾ ਦੇ ਕਿਤਨੇ ਹੀ ਸਰੂਪ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "कई सूर चंद सरूप ॥",
      "sourceLineId": "100523",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਈ ਇੰਦ੍ਰ ਕੀ ਸਮ ਭੂਪ ॥",
      "transliteration": "kiee i(n)dhr kee sam bhoop ||",
      "translation": "",
      "punjabiViakhya": "ਇੰਦਰ ਵਰਗੇ ਕਿਤਨੇ ਰਾਜੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "कई इंद्र की सम भूप ॥",
      "sourceLineId": "100524",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਈ ਇੰਦ੍ਰ ਉਪਿੰਦ੍ਰ ਮੁਨਿੰਦ੍ਰ ॥",
      "transliteration": "kiee i(n)dhr upi(n)dhr muni(n)dhr ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਇੰਦਰ, ਉਪਿੰਦ੍ਰ (ਬਾਵਨ ਅਵਤਾਰ) ਅਤੇ ਕਿਤਨੇ ਹੀ ਮਹਾ ਮੁਨੀ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "कई इंद्र उपिंद्र मुनिंद्र ॥",
      "sourceLineId": "100525",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਈ ਮਛ ਕਛ ਫਨਿੰਦ੍ਰ ॥੧੦॥",
      "transliteration": "kiee machh kachh fani(n)dhr ||10||",
      "translation": "Many kings like Surya, Chandra and Indra and many Indras, upendras, great sages, the Fish incarnation, the Tortoise incarnation and sheshnagas remain ever present before Him.10.",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਮੱਛ ਅਵਤਾਰ, ਕੱਛ ਅਵਤਾਰ ਅਤੇ ਸ਼ੇਸ਼ਨਾਗ ਹਨ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "कई मछ कछ फनिंद्र ॥१०॥",
      "sourceLineId": "100526",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਕ੍ਰਿਸਨ ਅਵਤਾਰ ॥",
      "transliteration": "kiee koT kirasan avataar ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਕਰੋੜ ਕ੍ਰਿਸ਼ਨ ਅਵਤਾਰ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "कई कोटि कृसन अवतार ॥",
      "sourceLineId": "100527",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਈ ਰਾਮ ਬਾਰ ਬੁਹਾਰ ॥",
      "transliteration": "kiee raam baar buhaar ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਰਾਮ (ਉਸ ਦੇ) ਦੁਆਰ ਉਤੇ ਝਾੜੂ ਦਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "कई राम बार बुहार ॥",
      "sourceLineId": "100528",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਈ ਮਛ ਕਛ ਅਨੇਕ ॥",
      "transliteration": "kiee machh kachh anek ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਮੱਛ ਅਤੇ ਅਨੇਕ ਹੀ ਕੱਛ (ਅਵਤਾਰ) ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "कई मछ कछ अनेक ॥",
      "sourceLineId": "100529",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਵਿਲੋਕ ਦੁਆਰਿ ਬਿਸੇਖ ॥੧੧॥",
      "transliteration": "avilok dhuaar bisekh ||11||",
      "translation": "Many Krishna and Rama incarnation sweep His Door many Fish and Tortoise incarnations are seen standing at His special gate.11.",
      "punjabiViakhya": "ਜੋ (ਉਸ ਦੇ) ਵਿਸ਼ੇਸ਼ ਦੁਆਰ ਨੂੰ ਵੇਖ ਰਹੇ ਹਨ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "अविलोक दुआरि बिसेख ॥११॥",
      "sourceLineId": "100530",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਈ ਸੁਕ੍ਰ ਬ੍ਰਸਪਤਿ ਦੇਖਿ ॥",
      "transliteration": "kiee sukr brasapat dhekh ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਸ਼ੁਕ੍ਰ ਅਤੇ ਬ੍ਰਹਮਪਤੀ ਵੇਖੇ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "कई सुक्र ब्रसपति देखि ॥",
      "sourceLineId": "100531",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਈ ਦਤ ਗੋਰਖ ਭੇਖ ॥",
      "transliteration": "kiee dhat gorakh bhekh ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਦੱਤਾਤ੍ਰੇਯ ਅਤੇ ਗੋਰਖ ਦੇ ਭੇਖ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "कई दत गोरख भेख ॥",
      "sourceLineId": "100532",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਈ ਰਾਮ ਕ੍ਰਿਸਨ ਰਸੂਲ ॥",
      "transliteration": "kiee raam kirasan rasool ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਰਾਮ, ਕ੍ਰਿਸ਼ਨ ਅਤੇ ਰਸੂਲ (ਮੁਹੰਮਦ) ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "कई राम कृसन रसूल ॥",
      "sourceLineId": "100533",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਿਨੁ ਨਾਮ ਕੋ ਨ ਕਬੂਲ ॥੧੨॥",
      "transliteration": "bin naam ko na kabool ||12||",
      "translation": "There are many Shukras, Brahaspatis, Datts, Gorakhs, Rama Krishnas, Rasult ect, but none is acceptable at His gate wightout the remembrance of His Name.12.",
      "punjabiViakhya": "ਪਰ ਨਾਮ ਤੋਂ ਬਿਨਾ (ਉਸ ਦੇ ਦੁਆਰ ਤੇ) ਕੋਈ ਵੀ ਪ੍ਰਵਾਨ ਨਹੀਂ ਹੈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "बिनु नाम को न कबूल ॥१२॥",
      "sourceLineId": "100534",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਿਨੁ ਏਕੁ ਆਸ੍ਰੈ ਨਾਮ ॥",
      "transliteration": "bin ek aasrai naam ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ (ਪ੍ਰਭੂ ਦੇ) ਨਾਮ ਦੇ ਆਸਰੇ ਤੋਂ ਬਿਨਾ",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "बिनु एकु आस्रै नाम ॥",
      "sourceLineId": "100535",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਹੀ ਔਰ ਕੌਨੈ ਕਾਮ ॥",
      "transliteration": "nahee aauar kauanai kaam ||",
      "translation": "No other work is appropriate except the support of the one Name",
      "punjabiViakhya": "ਹੋਰ ਸਾਰੇ (ਸਾਧਨ, ਧਰਮ-ਕਰਮ) ਕਿਸੇ ਕੰਮ ਦੇ ਨਹੀਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "नही और कौनै काम ॥",
      "sourceLineId": "100536",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜੇ ਮਾਨਿ ਹੈ ਗੁਰਦੇਵ ॥",
      "transliteration": "je maan hai gurdhev ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਗੁਰੂ ਦੇ ਉਪਦੇਸ਼ ਨੂੰ ਮੰਨਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "जे मानि है गुरदेव ॥",
      "sourceLineId": "100537",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤੇ ਜਾਨਿ ਹੈ ਅਨਭੇਵ ॥੧੩॥",
      "transliteration": "te jaan hai anabhev ||13||",
      "translation": "Those who will believe in the one Guru-Lord, they will only comprehend His myself.13.",
      "punjabiViakhya": "ਉਹੀ (ਉਸ) ਭੇਦ ਰਹਿਤ (ਪ੍ਰਭੂ) ਨੂੰ ਪਛਾਣ ਸਕਦੇ ਹਨ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "ते जानि है अनभेव ॥१३॥",
      "sourceLineId": "100538",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਿਨੁ ਤਾਸੁ ਔਰ ਨ ਜਾਨੁ ॥",
      "transliteration": "bin taas aauar na jaan ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਬਿਨਾ ਕਿਸੇ ਨੂੰ (ਕੁਝ) ਨਾ ਸਮਝੋ",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "बिनु तासु और न जानु ॥",
      "sourceLineId": "100539",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚਿਤ ਆਨ ਭਾਵ ਨ ਆਨੁ ॥",
      "transliteration": "chit aan bhaav na aan ||",
      "translation": "We should not know anyone else except Him and none other should be kept in mind",
      "punjabiViakhya": "ਅਤੇ ਚਿਤ ਵਿਚ ਹੋਰ ਭਾਵ (ਦ੍ਵੈਤ ਭਾਵ) ਨਾ ਲਿਆਓ।",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "चित आन भाव न आनु ॥",
      "sourceLineId": "100540",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਇਕ ਮਾਨਿ ਜੈ ਕਰਤਾਰ ॥",
      "transliteration": "eik maan jai karataar ||",
      "translation": "",
      "punjabiViakhya": "(ਸਦਾ) ਇਕ ਕਰਤਾਰ ਦੀ ਜੈ ਨੂੰ ਹੀ ਮੰਨੋ,",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "इक मानि जै करतार ॥",
      "sourceLineId": "100541",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਿਤੁ ਹੋਇ ਅੰਤਿ ਉਧਾਰੁ ॥੧੪॥",
      "transliteration": "jit hoi a(n)t udhaar ||14||",
      "translation": "Only one Lord should be worshipped, so that we may be redeemed at the end.14.",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਅੰਤ ਵਿਚ ਉੱਧਾਰ ਹੋਏਗਾ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "जितु होइ अंति उधारु ॥१४॥",
      "sourceLineId": "100542",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਿਨੁ ਤਾਸ ਯੌ ਨ ਉਧਾਰੁ ॥",
      "transliteration": "bin taas yau na udhaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਬਿਨਾ ਇਸ ਤਰ੍ਰਹਾ (ਦੇ ਕਰਮ ਕਰਨ ਨਾਲ) ਉੱਧਾਰ ਨਹੀਂ ਹੋਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "बिनु तास यौ न उधारु ॥",
      "sourceLineId": "100543",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜੀਅ ਦੇਖਿ ਯਾਰ ਬਿਚਾਰਿ ॥",
      "transliteration": "jeea dhekh yaar bichaar ||",
      "translation": "O being! You may consider that without Him you cannot be redeemed",
      "punjabiViakhya": "ਹੇ ਮਿਤਰ! ਮਨ ਵਿਚ ਵਿਚਾਰ ਪੂਰਵਕ ਵੇਖ ਲੈ।",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "जीअ देखि यार बिचारि ॥",
      "sourceLineId": "100544",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜੋ ਜਾਪਿ ਹੈ ਕੋਈ ਔਰ ॥",
      "transliteration": "jo jaap hai koiee aauar ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਕਿਸੇ ਹੋਰ ਦਾ ਜਾਪ ਕਰਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "जो जापि है कोई और ॥",
      "sourceLineId": "100545",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਬ ਛੂਟਿ ਹੈ ਵਹ ਠੌਰ ॥੧੫॥",
      "transliteration": "tab chhooT hai veh Thauar ||15||",
      "translation": "If you adore anyone else, then you will get away from that Lord.15.",
      "punjabiViakhya": "ਤਦ (ਉਸ ਪਾਸੋਂ) ਉਹ ਸਥਾਨ (ਪ੍ਰਭੂ ਦੀ ਦਰਗਾਹ) ਛੁਟ ਜਾਦੀ ਹੈ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "तब छूटि है वह ठौर ॥१५॥",
      "sourceLineId": "100546",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਿਹ ਰਾਗ ਰੰਗ ਨ ਰੂਪ ॥",
      "transliteration": "jeh raag ra(n)g na roop ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ (ਕੋਈ) ਰਾਗ, ਰੰਗ ਅਤੇ ਰੂਪ ਨਹੀਂ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "जिह राग रंग न रूप ॥",
      "sourceLineId": "100547",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੋ ਮਾਨੀਐ ਸਮ ਰੂਪ ॥",
      "transliteration": "so maaneeaai sam roop ||",
      "translation": "Only that Lord should be adored consistently, who is beyond attachment, colours and form",
      "punjabiViakhya": "ਉਸ ਨੂੰ (ਸਭ ਲਈ) ਸਮਾਨ ਰੂਪ ਵਿਚ ਮੰਨਣਾ ਚਾਹੀਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "सो मानीऐ सम रूप ॥",
      "sourceLineId": "100548",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਿਨੁ ਏਕ ਤਾ ਕਰ ਨਾਮ ॥",
      "transliteration": "bin ek taa kar naam ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਕ (ਪ੍ਰਭੂ) ਦੇ ਨਾਮ ਤੋਂ ਬਿਨਾ",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "बिनु एक ता कर नाम ॥",
      "sourceLineId": "100549",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਹਿ ਜਾਨ ਦੂਸਰ ਧਾਮ ॥੧੬॥",
      "transliteration": "neh jaan dhoosar dhaam ||16||",
      "translation": "None other except the One Lord should be kept in view .16.",
      "punjabiViakhya": "ਕਿਸੇ ਹੋਰ ਘਰ ਨੂੰ ਨਾ ਪਛਾਣੋ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "नहि जान दूसर धाम ॥१६॥",
      "sourceLineId": "100550",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜੋ ਲੋਕ ਅਲੋਕ ਬਨਾਇ ॥",
      "transliteration": "jo lok alok banai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਲੋਕ ਅਤੇ ਪਰਲੋਕ ('ਅਲੋਕ') ਨੂੰ ਸਿਰਜਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "जो लोक अलोक बनाइ ॥",
      "sourceLineId": "100551",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਫਿਰ ਲੇਤ ਆਪਿ ਮਿਲਾਇ ॥",
      "transliteration": "fir let aap milai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ (ਸਭ ਨੂੰ) ਆਪਣੇ ਵਿਚ ਮਿਲਾ ਲੈਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "फिर लेत आपि मिलाइ ॥",
      "sourceLineId": "100552",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜੋ ਚਹੈ ਦੇਹ ਉਧਾਰੁ ॥",
      "transliteration": "jo chahai dheh udhaar ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਆਪਣੇ ਸ਼ਰੀਰ ਦੇ ਉੱਧਾਰ ਦੀ ਇੱਛਾ ਰਖਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "जो चहै देह उधारु ॥",
      "sourceLineId": "100553",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੋ ਭਜਨ ਏਕੰਕਾਰ ॥੧੭॥",
      "transliteration": "so bhajan eka(n)kaar ||17||",
      "translation": "He who creates this and the next word and merges them within himself, if you want the salvation of your body, then worship only that One Lord.17.",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਇਕ ਪਰਮਸੱਤਾ ਦਾ ਭਜਨ ਕਰਨਾ ਚਾਹੀਦਾ ਹੈ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "सो भजन एकंकार ॥१७॥",
      "sourceLineId": "100554",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਿਨਿ ਰਾਚਿਯੋ ਬ੍ਰਹਮੰਡ ॥",
      "transliteration": "jin raachiyo brahama(n)dd ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਬ੍ਰਹਮੰਡ,",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "जिनि राचियो ब्रहमंड ॥",
      "sourceLineId": "100555",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਬ ਲੋਕ ਔ ਨਵ ਖੰਡ ॥",
      "transliteration": "sab lok aau nav kha(n)dd ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਲੋਕਾ ਅਤੇ ਨੌਂ ਖੰਡਾ ਦੀ ਰਚਨਾ ਕੀਤੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "सब लोक औ नव खंड ॥",
      "sourceLineId": "100556",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਿਹ ਕਿਉ ਨ ਜਾਪ ਜਪੰਤ ॥",
      "transliteration": "teh kiau na jaap japa(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਜਾਪ ਨੂੰ ਕਿਉਾਂ ਨਹੀਂ ਜਪਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "तिह किउ न जाप जपंत ॥",
      "sourceLineId": "100557",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਿਮ ਜਾਨ ਕੂਪਿ ਪਰੰਤ ॥੧੮॥",
      "transliteration": "kim jaan koop para(n)t ||18||",
      "translation": "He who has created the nine regions, all the worlds and the universe, why do you not meditate on him and how do you fall in the well deliberately? 18.",
      "punjabiViakhya": "ਅਤੇ ਕਿਉਾਂ (ਆਪਣੀ) ਜਾਨ ਨੂੰ ਖੂਹ ਵਿਚ ਪਾਉਾਂਦਾ ਹੈ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "किम जान कूपि परंत ॥१८॥",
      "sourceLineId": "100558",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜੜ ਜਾਪ ਤਾ ਕਰ ਜਾਪ ॥",
      "transliteration": "jaR jaap taa kar jaap ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮੂਰਖ! ਉਸ ਦੇ ਜਾਪ ਨੂੰ ਜਪ",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "जड़ जाप ता कर जाप ॥",
      "sourceLineId": "100559",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਿਨਿ ਲੋਕ ਚਉਦਹੰ ਥਾਪ ॥",
      "transliteration": "jin lok chaudhaha(n) thaap ||",
      "translation": "O foolish being! you should adore Him who was established all the fourteen worlds",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਚੌਦਾ ਲੋਕਾ ਦੀ ਸਥਾਪਨਾ ਕੀਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "जिनि लोक चउदहं थाप ॥",
      "sourceLineId": "100560",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਿਸੁ ਜਾਪੀਐ ਨਿਤ ਨਾਮ ॥",
      "transliteration": "tis jaapeeaai nit naam ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਨਾਮ ਨੂੰ ਨਿੱਤ ਜਪਣਾ ਚਾਹੀਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "तिसु जापीऐ नित नाम ॥",
      "sourceLineId": "100561",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਭ ਹੋਹਿ ਪੂਰਨ ਕਾਮ ॥੧੯॥",
      "transliteration": "sabh hoh pooran kaam ||19||",
      "translation": "With His meditation all the wishes are fulfilled.19.",
      "punjabiViakhya": "(ਜਿਸ ਦੇ ਫਲਸਰੂਪ) ਸਾਰੀਆਂ ਕਾਮਨਾਵਾ ਪੂਰੀਆਂ ਹੋ ਜਾਦੀਆਂ ਹਨ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "सभ होहि पूरन काम ॥१९॥",
      "sourceLineId": "100562",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗਨਿ ਚਉਬਿਸੈ ਅਵਤਾਰ ॥",
      "transliteration": "gan chaubisai avataar ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਚੌਬੀਸ ਅਵਤਾਰ ਗਿਣੇ ਜਾਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "गनि चउबिसै अवतार ॥",
      "sourceLineId": "100563",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਹੁ ਕੈ ਕਹੇ ਬਿਸਥਾਰ ॥",
      "transliteration": "bahu kai kahe bisathaar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੂੰ ਮੈਂ) ਬਹੁਤ ਵਿਸਥਾਰ ਨਾਲ ਕਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "बहु कै कहे बिसथार ॥",
      "sourceLineId": "100564",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਬ ਗਨੋ ਉਪ ਅਵਤਾਰ ॥",
      "transliteration": "ab gano up avataar ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਉਪ-ਅਵਤਾਰਾ ਦਾ ਵਰਣਨ ਕਰਦਾ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "अब गनो उप अवतार ॥",
      "sourceLineId": "100565",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਮਿ ਧਰੇ ਰੂਪ ਮੁਰਾਰ ॥੨੦॥",
      "transliteration": "jim dhare roop muraar ||20||",
      "translation": "All the twenty-four incarnations have been enumerated in detail and now I am going to enumerate the smaller incarnations how the Lord assumed the other forms.20.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਮੁਰਾਰ (ਪ੍ਰਭੂ) ਨੇ (ਉਹ) ਰੂਪ ਧਾਰਨ ਕੀਤੇ ਹਨ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "जिमि धरे रूप मुरार ॥२०॥",
      "sourceLineId": "100566",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜੇ ਧਰੇ ਬ੍ਰਹਮਾ ਰੂਪ ॥",
      "transliteration": "je dhare brahamaa roop ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਹਮਾ ਨੇ ਜੋ ਰੂਪ ਧਾਰਨ ਕੀਤੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "जे धरे ब्रहमा रूप ॥",
      "sourceLineId": "100567",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤੇ ਕਹੋਂ ਕਾਬਿ ਅਨੂਪ ॥",
      "transliteration": "te kaho(n) kaab anoop ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਅਨੂਪਮ ਕਵਿਤਾ ਵਿਚ ਕਹਿੰਦਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "ते कहों काबि अनूप ॥",
      "sourceLineId": "100568",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜੇ ਧਰੇ ਰੁਦ੍ਰ ਅਵਤਾਰ ॥",
      "transliteration": "je dhare rudhr avataar ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਰੁਦ੍ਰ ਨੇ ਅਵਤਾਰ ਧਾਰਨ ਕੀਤੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "जे धरे रुद्र अवतार ॥",
      "sourceLineId": "100569",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0612_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਬ ਕਹੋਂ ਤਾਹਿ ਬਿਚਾਰ ॥੨੧॥",
      "transliteration": "ab kaho(n) taeh bichaar ||21||",
      "translation": "Those forms which Brahma assumed, I have narrated them in poetry and not after reflection, I narrated the incarnation of Rudra (Shiva).21.",
      "punjabiViakhya": "ਹੁਣ ਉਨ੍ਰਹਾ ਨੂੰ ਵੀ ਵਿਚਾਰ ਕੇ ਕਹਿੰਦਾ ਹਾ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 612,
      "hindi": "",
      "hindiTransliteration": "अब कहों ताहि बिचार ॥२१॥",
      "sourceLineId": "100570",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
