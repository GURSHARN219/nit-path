{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 613,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0613_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਲਿ ਤਾਸੁ ਆਗਿਆ ਦੀਨ ॥",
      "transliteration": "kal taas aagiaa dheen ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਕਾਲ ਪੁਰਖ ਨੇ ਉਸ ਨੂੰ ਆਗਿਆ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "कलि तासु आगिआ दीन ॥",
      "sourceLineId": "100571",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਬ ਬੇਦ ਬ੍ਰਹਮਾ ਕੀਨ ॥",
      "transliteration": "tab bedh brahamaa keen ||",
      "translation": "When the Lord commended, then Brahma preprared the Vedas",
      "punjabiViakhya": "ਤਦ ਬ੍ਰਹਮਾ ਨੇ ਵੇਦਾ ਨੂੰ ਉਚਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "तब बेद ब्रहमा कीन ॥",
      "sourceLineId": "100572",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਬ ਤਾਸੁ ਬਾਢ੍ਯੋ ਗਰਬ ॥",
      "transliteration": "tab taas baaddayo garab ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਨੂੰ ਹੰਕਾਰ ਹੋ ਗਿਆ (ਤਾ ਉਸ ਨੇ)",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "तब तासु बाढ्यो गरब ॥",
      "sourceLineId": "100573",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਰਿ ਆਪੁ ਜਾਨ ਨ ਸਰਬ ॥੨੨॥",
      "transliteration": "sar aap jaan na sarab ||22||",
      "translation": "At that time his pride was increased and he did not consider anyone else like himself.22.",
      "punjabiViakhya": "ਆਪਣੇ ਸਮਾਨ ਸਾਰਿਆਂ ਨੂੰ ਨਾ ਸਮਝਿਆ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "सरि आपु जान न सरब ॥२२॥",
      "sourceLineId": "100574",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਰਿ ਮੋਹ ਕਬਿ ਨਹਿ ਕੋਇ ॥",
      "transliteration": "sar moh kab neh koi ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਵਰਗਾ ਹੋਰ ਕੋਈ ਕਵੀ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "सरि मोह कबि नहि कोइ ॥",
      "sourceLineId": "100575",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਇਕ ਆਪ ਹੋਇ ਤ ਹੋਇ ॥",
      "transliteration": "eik aap hoi ta hoi ||",
      "translation": "He thought that there was none other like him and there was no other poet like him",
      "punjabiViakhya": "ਇਕ (ਮੈਂ) ਆਪ (ਆਪਣੇ ਵਰਗਾ) ਹੋਵਾ ਤਾ ਹੋਵਾ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "इक आप होइ त होइ ॥",
      "sourceLineId": "100576",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਛੁ ਕਾਲ ਕੀ ਭੂਅ ਬਕ੍ਰ ॥",
      "transliteration": "kachh kaal kee bhooa bakr ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ ਅਜਿਹੀ ਮਨੋ-ਸਥਿਤੀ ਕਰ ਕੇ) ਕਾਲ ਪੁਰਖ ਦੀਆਂ ਭਵਾ ਟੇਢੀਆਂ ਹੋ ਗਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "कछु काल की भूअ बक्र ॥",
      "sourceLineId": "100577",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਛਿਤਿ ਡਾਰੀਆ ਜਿਮ ਸਕ੍ਰ ॥੨੩॥",
      "transliteration": "chhit ddaareeaa jim sakr ||23||",
      "translation": "On the Lord-God because unhappay and threw him on the ground like the Vajra of Indra.23.",
      "punjabiViakhya": "ਅਤੇ ਇੰਦਰ ('ਸਕ੍ਰ') ਵਾਗ ਧਰਤੀ ਉਤੇ ਸੁਟ ਦਿੱਤਾ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "छिति डारीआ जिम सक्र ॥२३॥",
      "sourceLineId": "100578",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਬ ਗਿਰ੍ਯੋ ਭੂ ਤਰਿ ਆਨਿ ॥",
      "transliteration": "jab girayo bhoo tar aan ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਧਰਤੀ ਉਤੇ ਆ ਕੇ ਡਿਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "जब गिर्यो भू तरि आनि ॥",
      "sourceLineId": "100579",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮੁਖ ਚਾਰ ਬੇਦ ਨਿਧਾਨ ॥",
      "transliteration": "mukh chaar bedh nidhaan ||",
      "translation": "When Brahma, the ocean of four Vedas fell upon the earth,",
      "punjabiViakhya": "(ਤਦ) ਚਾਰ ਮੂੰਹਾ ਵਾਲੇ ਅਤੇ ਵੇਦਾ (ਦੇ ਗਿਆਨ) ਦੇ ਖ਼ਜ਼ਾਨੇ ਬ੍ਰਹਮਾ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "मुख चार बेद निधान ॥",
      "sourceLineId": "100580",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਉਠਿ ਲਾਗਿਆ ਫਿਰ ਸੇਵ ॥",
      "transliteration": "auTh laagiaa fir sev ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਸੇਵਾ ਸ਼ੁਰੂ ਕਰ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "उठि लागिआ फिर सेव ॥",
      "sourceLineId": "100581",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੀਅ ਜਾਨਿ ਦੇਵਿ ਅਭੇਵ ॥੨੪॥",
      "transliteration": "jeea jaan dhev abhev ||24||",
      "translation": "He began to worship with the fullness of his heart the mysterious Lord, who is beyond the ken of gods.24.",
      "punjabiViakhya": "ਜੀ ਜਾਨ ਨਾਲ ਅਭੇਵ ਪ੍ਰਭੂ ਦੀ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "जीअ जानि देवि अभेव ॥२४॥",
      "sourceLineId": "100582",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦਸ ਲਖ ਬਰਖ ਪ੍ਰਮਾਨ ॥",
      "transliteration": "dhas lakh barakh pramaan ||",
      "translation": "",
      "punjabiViakhya": "ਦਸ ਲੱਖ ਵਰ੍ਰਹਿਆਂ ਤਕ (ਉਸ ਨੇ)",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "दस लख बरख प्रमान ॥",
      "sourceLineId": "100583",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕੀਅ ਦੇਵਿ ਸੇਵ ਮਹਾਨ ॥",
      "transliteration": "keea dhev sev mahaan ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾਨ ਦੇਵ (ਪ੍ਰਭੂ) ਦੀ ਸੇਵਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "कीअ देवि सेव महान ॥",
      "sourceLineId": "100584",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਿਮਿ ਹੋਇ ਮੋਹਿ ਉਧਾਰ ॥",
      "transliteration": "kim hoi moh udhaar ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰਾ ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਉਧਾਰ ਹੋਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "किमि होइ मोहि उधार ॥",
      "sourceLineId": "100585",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਸ ਦੇਹੁ ਦੇਵ ਬਿਚਾਰ ॥੨੫॥",
      "transliteration": "as dheh dhev bichaar ||25||",
      "translation": "He worshipped the Lord for ten Lakh years and he to the Lord of gods to redeem him in any in any way.25.",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ) ਹੇ ਦੇਵ! (ਮੈਨੂੰ) ਅਜਿਹਾ ਵਿਚਾਰ ਦਿਓ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "अस देहु देव बिचार ॥२५॥",
      "sourceLineId": "100586",
      "sourceShabadId": "9282",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੇਵੋ ਵਾਚ ਬ੍ਰਹਮਾ ਪ੍ਰਤਿ ॥",
      "transliteration": "dhevo vaach brahamaa prat ||",
      "translation": "SPEECH OF THE GOD",
      "punjabiViakhya": "ਦੇਵ (ਪ੍ਰਭੂ) ਨੇ ਬ੍ਰਹਮਾ ਨੂੰ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "देवो वाच ब्रहमा प्रति ॥",
      "sourceLineId": "100587",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਨ ਚਿਤ ਕੈ ਕਰਿ ਸੇਵ ॥",
      "transliteration": "man chit kai kar sev ||",
      "translation": "",
      "punjabiViakhya": "(ਹੇ ਬ੍ਰਹਮਾ! ਤੂੰ) ਮਨ ਚਿਤ ਲਗਾ ਕੇ ਸੇਵਾ ਕਰ,",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "मन चित कै करि सेव ॥",
      "sourceLineId": "100588",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਬ ਰੀਝਿ ਹੈ ਗੁਰਦੇਵ ॥",
      "transliteration": "tab reejh hai gurdhev ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਗੁਰੂਦੇਵ ਤੇਰੇ ਉਤੇ ਪ੍ਰਸੰਨ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "तब रीझि है गुरदेव ॥",
      "sourceLineId": "100589",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਬ ਹੋਇ ਨਾਥ ਸਨਾਥ ॥",
      "transliteration": "tab hoi naath sanaath ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਤੂੰ) ਉਸ ਨਾਥ (ਨੂੰ ਪ੍ਰਾਪਤ ਕਰ ਕੇ) ਸਨਾਥ (ਸਮਰਥ) ਹੋਵੇਾਂਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "तब होइ नाथ सनाथ ॥",
      "sourceLineId": "100590",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਗਨਾਥ ਦੀਨਾ ਨਾਥ ॥੨੬॥",
      "transliteration": "jaganaath dheenaa naath ||26||",
      "translation": "(Vishnu said) “When you will adore Lord-God with the fullness of your heart, then the Lord who is the support of the helpless, will fulfill you wish.”26.",
      "punjabiViakhya": "ਜੋ ਜਗਤ ਦਾ ਨਾਥ ਅਤੇ ਦੀਨਾ ਦਾ ਨਾਥ ਹੈ, ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "जगनाथ दीना नाथ ॥२६॥",
      "sourceLineId": "100591",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੁਨਿ ਬੈਨ ਯੌ ਮੁਖਚਾਰ ॥",
      "transliteration": "sun bain yau mukhachaar ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਹਮਾ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਦੇ ਬਚਨ ਸੁਣ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "सुनि बैन यौ मुखचार ॥",
      "sourceLineId": "100592",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕੀਅ ਚਉਕ ਚਿਤਿ ਬਿਚਾਰ ॥",
      "transliteration": "keea chauk chit bichaar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੌਂਕ ਕੇ ਚਿਤ ਵਿਚ ਵਿਚਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "कीअ चउक चिति बिचार ॥",
      "sourceLineId": "100593",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਉਠਿ ਲਾਗਿਆ ਹਰਿ ਸੇਵ ॥",
      "transliteration": "auTh laagiaa har sev ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਠ ਕੇ ਹਰਿ ਦੀ ਸੇਵਾ ਵਿਚ ਲਗ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "उठि लागिआ हरि सेव ॥",
      "sourceLineId": "100594",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਿਹ ਭਾਤਿ ਭਾਖ੍ਯੋ ਦੇਵ ॥੨੭॥",
      "transliteration": "jeh bhaat bhaakhayo dhev ||27||",
      "translation": "Hearing this Brahma began to worship and make offerings exactly in the same way, as Vishnu had suggested.27.",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਦੇਵ (ਪ੍ਰਭੂ) ਨੇ ਕਿਹਾ ਸੀ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "जिह भाति भाख्यो देव ॥२७॥",
      "sourceLineId": "100595",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਰਿ ਪਾਇ ਚੰਡਿ ਪ੍ਰਚੰਡ ॥",
      "transliteration": "par pai cha(n)dd pracha(n)dd ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਚੰਡ ਚੰਡੀ ਦੇ ਪੈਰੀਂ ਪੈ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "परि पाइ चंडि प्रचंड ॥",
      "sourceLineId": "100596",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਿਹ ਮੰਡ ਦੁਸਟ ਅਖੰਡ ॥",
      "transliteration": "jeh ma(n)dd dhusaT akha(n)dd ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਨਾ ਖੰਡੇ ਜਾ ਸਕਣ ਵਾਲੇ ਦੁਸ਼ਟਾ ਨਾਲ (ਰਣ) ਮੰਡਿਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "जिह मंड दुसट अखंड ॥",
      "sourceLineId": "100597",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜ੍ਵਾਲਾਛ ਲੋਚਨ ਧੂਮ ॥",
      "transliteration": "javaiaalaachh lochan dhoom ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਸ ਨੇ ਜ੍ਵਾਲਾਛ ਅਤੇ ਧੂਮ੍ਰਲੋਚਨ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "ज्वालाछ लोचन धूम ॥",
      "sourceLineId": "100598",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਨਿ ਜਾਸੁ ਡਾਰੇ ਭੂਮਿ ॥੨੮॥",
      "transliteration": "han jaas ddaare bhoom ||28||",
      "translation": "Vishnu also said this, that the powerful Chandika, the destroyer of the tyrants should also be adored, who had killed the demons like Jawalaksha and Dhumar Lochan.28",
      "punjabiViakhya": "ਮਾਰ ਕੇ ਭੂਮੀ ਉਤੇ ਸੁਟ ਦਿੱਤਾ ਸੀ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "हनि जासु डारे भूमि ॥२८॥",
      "sourceLineId": "100599",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਿਸੁ ਜਾਪਿ ਹੋ ਜਬ ਜਾਪ ॥",
      "transliteration": "tis jaap ho jab jaap ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਡੀ ਨੇ ਕਿਹਾ, ਜਦੋਂ ਉਸ ਦਾ ਜਾਪ ਜਪੋਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "तिसु जापि हो जब जाप ॥",
      "sourceLineId": "100600",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਬ ਹੋਇ ਪੂਰਨ ਸ੍ਰਾਪ ॥",
      "transliteration": "tab hoi pooran sraap ||",
      "translation": "“When you will worship all of them, then the curse on you will terminte",
      "punjabiViakhya": "ਤਦ ਸਰਾਪ ਪੂਰਾ (ਭਾਵ ਖ਼ਤਮ) ਹੋ ਜਾਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "तब होइ पूरन स्राप ॥",
      "sourceLineId": "100601",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਉਠਿ ਲਾਗ ਕਾਲ ਜਪੰਨ ॥",
      "transliteration": "auTh laag kaal japa(n)n ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ ਸੁਣ ਕੇ ਬ੍ਰਹਮਾ) ਕਾਲ ਪੁਰਖ ਦਾ ਜਾਪ ਕਰਨ ਲਗ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "उठि लाग काल जपंन ॥",
      "sourceLineId": "100602",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਠਿ ਤਿਆਗ ਆਵ ਸਰੰਨ ॥੨੯॥",
      "transliteration": "haTh tiaag aav sara(n)n ||29||",
      "translation": "Worship the unmanifested Brahman and abandoning your persistence, you may go under his shelter.29.",
      "punjabiViakhya": "ਅਤੇ ਹਠ ਨੂੰ ਤਿਆਗ ਕੇ ਸ਼ਰਨ ਵਿਚ ਆ ਗਿਆ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "हठि तिआग आव सरंन ॥२९॥",
      "sourceLineId": "100603",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜੇ ਜਾਤ ਤਾਸੁ ਸਰੰਨਿ ॥",
      "transliteration": "je jaat taas sara(n)n ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਉਸ ਦੀ ਸ਼ਰਨ ਵਿਚ ਜਾਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "जे जात तासु सरंनि ॥",
      "sourceLineId": "100604",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤੇ ਹੈ ਧਰਾ ਮੈ ਧਨਿ ॥",
      "transliteration": "te hai dharaa mai dhan ||",
      "translation": "“Blessed are they, on the earth, who go under His refuge",
      "punjabiViakhya": "ਉਹ ਧਰਤੀ ਉਤੇ ਧੰਨ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "ते है धरा मै धनि ॥",
      "sourceLineId": "100605",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਿਨ ਕਉ ਨ ਕਉਨੈ ਤ੍ਰਾਸ ॥",
      "transliteration": "tin kau na kaunai traas ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਕਿਸੇ ਦਾ ਡਰ ਨਹੀਂ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "तिन कउ न कउनै त्रास ॥",
      "sourceLineId": "100606",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਬ ਹੋਤ ਕਾਰਜ ਰਾਸ ॥੩੦॥",
      "transliteration": "sab hot kaaraj raas ||30||",
      "translation": "They do not fear anyone and all their tasks are fulfilled.30.",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਦੇ ਸਾਰੇ ਕਾਰਜ ਰਾਸ ਹੋ ਜਾਦੇ ਹਨ ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "सब होत कारज रास ॥३०॥",
      "sourceLineId": "100607",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦਸ ਲਛ ਬਰਖ ਪ੍ਰਮਾਨ ॥",
      "transliteration": "dhas lachh barakh pramaan ||",
      "translation": "",
      "punjabiViakhya": "ਦਸ ਲਖ ਵਰ੍ਰਹਿਆਂ ਤਕ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "दस लछ बरख प्रमान ॥",
      "sourceLineId": "100608",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਹ੍ਯੋ ਠਾਢ ਏਕ ਪਗਾਨ ॥",
      "transliteration": "rahayo Thaadd ek pagaan ||",
      "translation": "",
      "punjabiViakhya": "(ਬ੍ਰਹਮਾ) ਇਕ ਪੈਰ ਉਤੇ ਖੜੋਤਾ ਰਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "रह्यो ठाढ एक पगान ॥",
      "sourceLineId": "100609",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚਿਤ ਲਾਇ ਕੀਨੀ ਸੇਵ ॥",
      "transliteration": "chit lai keenee sev ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਚਿਤ ਲਗਾ ਕੇ ਸੇਵਾ ਕੀਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "चित लाइ कीनी सेव ॥",
      "sourceLineId": "100610",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਬ ਰੀਝਿ ਗੇ ਗੁਰਦੇਵ ॥੩੧॥",
      "transliteration": "tab reejh ge gurdhev ||31||",
      "translation": "For ten Lack years Brahma stood on one leg and when he served the Lord with the singleness of his heart, then the Guru-Lord was pleased.31.",
      "punjabiViakhya": "ਤਦ (ਜਾ ਕੇ) ਗੁਰੂਦੇਵ ਪ੍ਰਸੰਨ ਹੋਏ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "तब रीझि गे गुरदेव ॥३१॥",
      "sourceLineId": "100611",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਬ ਭੇਤ ਦੇਵੀ ਦੀਨ ॥",
      "transliteration": "jab bhet dhevee dheen ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਦੇਵੀ ਨੇ (ਕਾਲ ਪੁਰਖ ਦੀ ਸੇਵਾ ਦਾ) ਭੇਦ ਦਸ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "जब भेत देवी दीन ॥",
      "sourceLineId": "100612",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਬ ਸੇਵ ਬ੍ਰਹਮਾ ਕੀਨ ॥",
      "transliteration": "tab sev brahamaa keen ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਬ੍ਰਹਮਾ ਨੇ (ਚਿਤ ਲਗਾ ਕੇ) ਸੇਵਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "तब सेव ब्रहमा कीन ॥",
      "sourceLineId": "100613",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਬ ਸੇਵ ਕੀ ਚਿਤ ਲਾਇ ॥",
      "transliteration": "jab sev kee chit lai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਚਿਤ ਲਗਾ ਕੇ ਸੇਵਾ ਕੀਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "जब सेव की चित लाइ ॥",
      "sourceLineId": "100614",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਬ ਰੀਝਿ ਗੇ ਹਰਿ ਰਾਇ ॥੩੨॥",
      "transliteration": "tab reejh ge har rai ||32||",
      "translation": "When with the goddess explained the myself, then Brahma served with fullness of his mind, and the unmanifested Bharma was pleased with him.32.",
      "punjabiViakhya": "ਤਦ ਹਰਿ ਰਾਇ (ਪ੍ਰਭੂ) ਪ੍ਰਸੰਨ ਹੋ ਗਏ ॥੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "तब रीझि गे हरि राइ ॥३२॥",
      "sourceLineId": "100615",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਬ ਭਯੋ ਸੁ ਐਸ ਉਚਾਰ ॥",
      "transliteration": "tab bhayo su aais uchaar ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਸ ਤਰ੍ਰਹਾ (ਦੀ ਬਾਣੀ) ਦਾ ਉਚਾਰ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "तब भयो सु ऐस उचार ॥",
      "sourceLineId": "100616",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਉ ਆਹਿ ਗ੍ਰਬ ਪ੍ਰਹਾਰ ॥",
      "transliteration": "hau aaeh grab prahaar ||",
      "translation": "",
      "punjabiViakhya": "(ਭਾਵ-ਆਕਾਸ਼ ਬਾਣੀ ਹੋਈ) (ਹੇ ਬ੍ਰਹਮਾ!) ਮੈਂ ਹੰਕਾਰ ਨੂੰ ਖ਼ਤਮ ਕਰਨ ਵਾਲਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "हउ आहि ग्रब प्रहार ॥",
      "sourceLineId": "100617",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮਮ ਗਰਬ ਕਹੂੰ ਨ ਛੋਰਿ ॥",
      "transliteration": "mam garab kahoo(n) na chhor ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਕਿਸੇ ਦਾ ਹੰਕਾਰ ਨਹੀਂ ਛਡਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "मम गरब कहूँ न छोरि ॥",
      "sourceLineId": "100618",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਭ ਕੀਨ ਜੇਰ ਮਰੋਰਿ ॥੩੩॥",
      "transliteration": "sabh keen jer maror ||33||",
      "translation": "Then there was such-like voice from heaven,”I am the masher of pride and I have subjugated all.33.",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਮਰੋੜ ਕੇ ਆਪਣੇ ਅਧੀਨ ਕਰ ਲਿਆ ਹੈ ॥੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "सभ कीन जेर मरोरि ॥३३॥",
      "sourceLineId": "100619",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤੈ ਗਰਬ ਕੀਨ ਸੁ ਕਾਹਿ ॥",
      "transliteration": "tai garab keen su kaeh ||",
      "translation": "",
      "punjabiViakhya": "ਤੂੰ ਕਿਸ ਲਈ ਹੰਕਾਰ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "तै गरब कीन सु काहि ॥",
      "sourceLineId": "100620",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਨਹਿ ਮੋਹ ਭਾਵਤ ਤਾਹਿ ॥",
      "transliteration": "neh moh bhaavat taeh ||",
      "translation": "“You had been puffed up with pride, therefore I did not like you",
      "punjabiViakhya": "ਇਸ ਲਈ (ਤੂੰ) ਮੈਨੂੰ ਚੰਗਾ ਨਹੀਂ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "नहि मोह भावत ताहि ॥",
      "sourceLineId": "100621",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਬ ਕਹੋ ਏਕ ਬਿਚਾਰ ॥",
      "transliteration": "ab kaho ek bichaar ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਇਕ ਵਿਚਾਰ (ਜੁਗਤ) ਕਹਿੰਦਾ ਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "अब कहो एक बिचार ॥",
      "sourceLineId": "100622",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਿਮਿ ਹੋਇ ਤੋਹਿ ਉਧਾਰ ॥੩੪॥",
      "transliteration": "jim hoi toh udhaar ||34||",
      "translation": "Now I sea this and tell you as to how you will be redeemed.34.",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਤੇਰਾ ਉੱਧਾਰ ਹੋਵੇਗਾ ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "जिमि होइ तोहि उधार ॥३४॥",
      "sourceLineId": "100623",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਧਰਿ ਸਪਤ ਭੂਮਿ ਵਤਾਰ ॥",
      "transliteration": "dhar sapat bhoom vataar ||",
      "translation": "",
      "punjabiViakhya": "(ਤੂੰ) ਧਰਤੀ ਉਤੇ ਜਾ ਕੇ ਸੱਤ ਅਵਤਾਰ ਧਾਰਨ ਕਰ,",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "धरि सपत भूमि वतार ॥",
      "sourceLineId": "100624",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਤਬ ਹੋਇ ਤੋਹਿ ਉਧਾਰਿ ॥",
      "transliteration": "tab hoi toh udhaar ||",
      "translation": "“You may now assume seven incarnation on the earth for your redemption",
      "punjabiViakhya": "ਤਦ ਤੇਰਾ ਉੱਧਾਰ ਹੋਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "तब होइ तोहि उधारि ॥",
      "sourceLineId": "100625",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸੋਈ ਮਾਨ ਬ੍ਰਹਮਾ ਲੀਨ ॥",
      "transliteration": "soiee maan brahamaa leen ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ (ਆਗਿਆ) ਬ੍ਰਹਮਾ ਨੇ ਮੰਨ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "सोई मान ब्रहमा लीन ॥",
      "sourceLineId": "100626",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਧਰਿ ਜਨਮ ਜਗਤਿ ਨਵੀਨ ॥੩੫॥",
      "transliteration": "dhar janam jagat naveen ||35||",
      "translation": "” Brahma accepted all this and assumed new births in the world.35.",
      "punjabiViakhya": "ਅਤੇ ਜਗਤ ਵਿਚ ਨਵੇਾਂ ਜਨਮ ਧਾਰਨ ਕੀਤੇ ॥੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "धरि जनम जगति नवीन ॥३५॥",
      "sourceLineId": "100627",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਮੁਰਿ ਨਿੰਦ ਉਸਤਤਿ ਤੂਲਿ ॥",
      "transliteration": "mur ni(n)dh usatat tool ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਲਈ ਨਿੰਦਿਆ ਅਤੇ ਉਸਤਤ ਇਕ-ਸਮਾਨ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "मुरि निंद उसतति तूलि ॥",
      "sourceLineId": "100628",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਇਮਿ ਜਾਨਿ ਜੀਯ ਜਿਨਿ ਭੂਲਿ ॥",
      "transliteration": "eim jaan jeey jin bhool ||",
      "translation": "“Never forget from your mind my slander and praise",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਚਿਤ ਵਿਚ ਜਾਣ ਲੈ, ਭੁਲੀਂ ਨਾ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "इमि जानि जीय जिनि भूलि ॥",
      "sourceLineId": "100629",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਇਕ ਕਹੋ ਔਰ ਬਿਚਾਰ ॥",
      "transliteration": "eik kaho aauar bichaar ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਹੋਰ ਵਿਚਾਰ ਕਹਿੰਦਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "इक कहो और बिचार ॥",
      "sourceLineId": "100630",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਸੁਨਿ ਲੇਹੁ ਬ੍ਰਹਮ ਕੁਮਾਰ ॥੩੬॥",
      "transliteration": "sun leh braham kumaar ||36||",
      "translation": "O Brahma! Also listen to one thing more36",
      "punjabiViakhya": "ਹੇ ਬ੍ਰਹਮਾ ਪੁੱਤਰ! (ਧਿਆਨ ਨਾਲ) ਸੁਣ ਲੈ ॥੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "सुनि लेहु ब्रहम कुमार ॥३६॥",
      "sourceLineId": "100631",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਇਕ ਬਿਸਨੁ ਮੋਹਿ ਧਿਆਨ ॥",
      "transliteration": "eik bisan moh dhiaan ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਵਿਸ਼ਣੂ (ਨਾ ਦੇ ਦੇਵਤਾ) ਨੇ ਵੀ ਮੇਰਾ ਧਿਆਨ (ਕੀਤਾ ਸੀ)",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "इक बिसनु मोहि धिआन ॥",
      "sourceLineId": "100632",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਬਹੁ ਸੇਵਿ ਮੋਹਿ ਰਿਝਾਨ ॥",
      "transliteration": "bahu sev moh rijhaan ||",
      "translation": "“A god named Vishnu has also meditated on me and greatly pleased me",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਸੇਵਾ ਕਰ ਕੇ ਮੈਨੂੰ ਰਿਝਾਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "बहु सेवि मोहि रिझान ॥",
      "sourceLineId": "100633",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਤਿਨਿ ਮਾਗਿਆ ਬਰ ਐਸ ॥",
      "transliteration": "tin maagiaa bar aais ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਵਰ ਮੰਗਿਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "तिनि मागिआ बर ऐस ॥",
      "sourceLineId": "100634",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਮਮ ਦੀਨ ਤਾ ਕਹੁ ਤੈਸ ॥੩੭॥",
      "transliteration": "mam dheen taa kahu tais ||37||",
      "translation": "He has also asked for a boon from me, which I have bestowed on him.37.",
      "punjabiViakhya": "ਅਤੇ ਮੈਂ ਉਸ ਨੂੰ ਉਸੇ ਤਰ੍ਰਹਾ ਦਾ (ਵਰ) ਦੇ ਦਿੱਤਾ ਸੀ ॥੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "मम दीन ता कहु तैस ॥३७॥",
      "sourceLineId": "100635",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਮਮ ਤਾਸ ਭੇਦ ਨ ਕੋਇ ॥",
      "transliteration": "mam taas bhedh na koi ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਅਤੇ ਉਸ ਵਿਚ ਕੋਈ ਭੇਦ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "मम तास भेद न कोइ ॥",
      "sourceLineId": "100636",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਸਬ ਲੋਕ ਜਾਨਤ ਸੋਇ ॥",
      "transliteration": "sab lok jaanat soi ||",
      "translation": "“There is no difference between me and him, all the people know this",
      "punjabiViakhya": "ਇਸ (ਤੱਥ) ਨੂੰ ਸਾਰੇ ਲੋਕ ਜਾਣਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "सब लोक जानत सोइ ॥",
      "sourceLineId": "100637",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਤਿਹ ਜਾਨ ਹੈ ਕਰਤਾਰ ॥",
      "transliteration": "teh jaan hai karataar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਨੂੰ (ਲੋਕੀਂ) ਸਾਰੇ ਲੋਕ-ਪਰਲੋਕ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "तिह जान है करतार ॥",
      "sourceLineId": "100638",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਸਬ ਲੋਕ ਅਲੋਕ ਪਹਾਰ ॥੩੮॥",
      "transliteration": "sab lok alok pahaar ||38||",
      "translation": "The people consider him the creator of this and the next world and their destroyer.38.",
      "punjabiViakhya": "ਅਤੇ ਪਰਬਤਾ ਦਾ ਕਰਤਾ ਸਮਝਦੇ ਹਨ ॥੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "सब लोक अलोक पहार ॥३८॥",
      "sourceLineId": "100639",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਜਬ ਜਬ ਧਰੇ ਬਪੁ ਸੋਇ ॥",
      "transliteration": "jab jab dhare bap soi ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਜਦੋਂ ਉਹ (ਵਿਸ਼ਣੂ) ਕੋਈ ਸ਼ਰੀਰ (ਅਵਤਾਰ) ਧਾਰਨ ਕਰੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "जब जब धरे बपु सोइ ॥",
      "sourceLineId": "100640",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਜੋ ਜੋ ਪਰਾਕ੍ਰਮ ਹੋਇ ॥",
      "transliteration": "jo jo paraakram hoi ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜੋ ਜੋ ਪਰਾਕ੍ਰਮ ਕਰੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "जो जो पराक्रम होइ ॥",
      "sourceLineId": "100641",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0613_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਸੋ ਸੋ ਕਥੌ ਅਬਿਚਾਰ ॥",
      "transliteration": "so so kathau abichaar ||",
      "translation": "",
      "punjabiViakhya": "(ਤੂੰ) ਬਿਨਾ ਸੋਚੇ ਉਸ ਉਸ (ਪਰਾਕ੍ਰਮ) ਦਾ ਕਥਨ ਕਰ।",
      "source": "DASAM_GRANTH",
      "ang": 613,
      "hindi": "",
      "hindiTransliteration": "सो सो कथौ अबिचार ॥",
      "sourceLineId": "100642",
      "sourceShabadId": "9283",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
