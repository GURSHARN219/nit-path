{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 615,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0615_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਬ ਕਹੋ ਤੋਹਿ ਤੀਸ੍ਰ ਬਿਚਾਰ ॥",
      "transliteration": "ab kaho toh teesr bichaar ||",
      "translation": "In this way the second incarnation manifested himself and now I am describing the third one thoughtfully",
      "punjabiViakhya": "ਹੁਣ (ਮੈਂ) ਤੈਨੂੰ ਤੀਜੇ (ਅਵਤਾਰ ਦਾ ਕਥਾ ਪ੍ਰਸੰਗ) ਵਿਚਾਰ ਕੇ ਕਹਿੰਦਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "अब कहो तोहि तीस्र बिचार ॥",
      "sourceLineId": "100691",
      "sourceShabadId": "9286",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਿਹ ਭਾਤਿ ਧਰ੍ਯੋ ਬਪੁ ਬ੍ਰਹਮ ਰਾਇ ॥",
      "transliteration": "jeh bhaat dharayo bap braham rai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਬ੍ਰਹਮਾ ਨੇ (ਤੀਜਾ) ਰੂਪ ਧਾਰਨ ਕੀਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "जिह भाति धर्यो बपु ब्रहम राइ ॥",
      "sourceLineId": "100692",
      "sourceShabadId": "9286",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਭ ਕਹ੍ਯੋ ਤਾਹਿ ਨੀਕੇ ਸੁਭਾਇ ॥੯॥",
      "transliteration": "sabh kahayo taeh neeke subhai ||9||",
      "translation": "The manner in which Brahma assumed his body, I now describe it nicely.9.",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਬੜੇ ਚੰਗੇ ਢੰਗ ਨਾਲ ਕਹਿੰਦਾ ਹਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "सभ कह्यो ताहि नीके सुभाइ ॥९॥",
      "sourceLineId": "100693",
      "sourceShabadId": "9286",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਦੁਤੀਯ ਅਵਤਾਰੇ ਬ੍ਰਹਮਾ ਕਸਪ ਸਮਾਪਤੰ ॥੨॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the dhuteey avataare brahamaa kasap samaapata(n) ||2||",
      "translation": "End of the description of Kashyap the second incarnation of Brahma, in Bachittar Natak.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ ਬ੍ਰਹਮਾ ਦੇ ਦੂਜੇ ਅਵਤਾਰ ਕਸਪ ਦੀ ਸਮਾਪਤੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे दुतीय अवतारे ब्रहमा कसप समापतं ॥२॥",
      "sourceLineId": "100694",
      "sourceShabadId": "9286",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਥ ਤ੍ਰਿਤੀਆ ਅਵਤਾਰ ਸੁਕ੍ਰ ਕਥਨੰ ॥",
      "transliteration": "ath tirateeaa avataar sukr kathana(n) ||",
      "translation": "Now being the description about the third incarnation Shukra",
      "punjabiViakhya": "ਹੁਣ ਤੀਜੇ ਅਵਤਾਰ ਸੁਕ੍ਰ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "अथ तृतीआ अवतार सुक्र कथनं ॥",
      "sourceLineId": "100695",
      "sourceShabadId": "9287",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪਾਧੜੀ ਛੰਦ ॥",
      "transliteration": "paadhaRee chha(n)dh ||",
      "translation": "PAADHARI STANZA",
      "punjabiViakhya": "ਪਾਧੜੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "पाधड़ी छंद ॥",
      "sourceLineId": "100696",
      "sourceShabadId": "9287",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪੁਨਿ ਧਰਾ ਤੀਸਰ ਇਹ ਭਾਤਿ ਰੂਪ ॥",
      "transliteration": "pun dharaa teesar ieh bhaat roop ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਇਸ ਤਰ੍ਰਹਾ (ਬ੍ਰਹਮਾ ਨੇ) ਤੀਜਾ ਰੂਪ (ਅਵਤਾਰ) ਧਾਰਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "पुनि धरा तीसर इह भाति रूप ॥",
      "sourceLineId": "100697",
      "sourceShabadId": "9287",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਗਿ ਭਯੋ ਆਨ ਕਰਿ ਦੈਤ ਭੂਪ ॥",
      "transliteration": "jag bhayo aan kar dhait bhoop ||",
      "translation": "The third from that Brahma assumed was this king, that he because the king (Guru) of the demons",
      "punjabiViakhya": "ਜਗਤ ਵਿਚ ਦੈਂਤ ਰਾਜੇ ਬਣ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "जगि भयो आन करि दैत भूप ॥",
      "sourceLineId": "100698",
      "sourceShabadId": "9287",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਬ ਦੇਬ ਬੰਸ ਪ੍ਰਚੁਰ੍ਯੋ ਅਪਾਰ ॥",
      "transliteration": "tab dheb ba(n)s prachurayo apaar ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦੈਂਤਾ ਦਾ ਵੰਸ਼ ਬਹੁਤ ਅਧਿਕ ਪਸਰ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "तब देब बंस प्रचुर्यो अपार ॥",
      "sourceLineId": "100699",
      "sourceShabadId": "9287",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕੀਨੇ ਸੁ ਰਾਜ ਪ੍ਰਿਥਮੀ ਸੁਧਾਰਿ ॥੧॥",
      "transliteration": "keene su raaj pirathamee sudhaar ||1||",
      "translation": "At that time, the clan of demons increased enormously and they ruled over the earth.1.",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਬੜੀ ਚੰਗੀ ਤਰ੍ਰਹਾ ਪ੍ਰਿਥਵੀ ਉਤੇ ਰਾਜ ਕੀਤਾ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "कीने सु राज पृथमी सुधारि ॥१॥",
      "sourceLineId": "100700",
      "sourceShabadId": "9287",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਡ ਪੁਤ੍ਰ ਜਾਨਿ ਕਿਨੀ ਸਹਾਇ ॥",
      "transliteration": "badd putr jaan kinee sahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੱਡਾ ਪੁੱਤਰ ਜਾਣ ਕੇ (ਕਸ਼ਪ ਨੇ ਉਸ ਦੀ) ਸਹਾਇਤਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "बड पुत्र जानि किनी सहाइ ॥",
      "sourceLineId": "100701",
      "sourceShabadId": "9287",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤੀਸਰ ਅਵਤਾਰ ਭਇਓ ਸੁਕ੍ਰ ਰਾਇ ॥",
      "transliteration": "teesar avataar bhio sukr rai ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਇਸ ਤਰ੍ਰਹਾ ਬ੍ਰਹਮਾ ਦਾ) ਤੀਜਾ ਅਵਤਾਰ 'ਸੁਕ੍ਰ' ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "तीसर अवतार भइओ सुक्र राइ ॥",
      "sourceLineId": "100702",
      "sourceShabadId": "9287",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਿੰਦਾ ਬ੍ਰਯਾਜ ਉਸਤਤੀ ਕੀਨ ॥",
      "transliteration": "ni(n)dhaa brayaaj usatatee keen ||",
      "translation": "Considering him as him eldest son Brahma helped him In the from of the a Guru and this way Shukracharya became the third incarnation of Brahma",
      "punjabiViakhya": "ਉਸ ਨੇ ਨਿੰਦਾ ਦੇ ਬਹਾਨੇ ('ਬ੍ਰਯਾਜ') (ਪ੍ਰਭੂ ਦੀ) ਉਸਤਤ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "निंदा ब्रयाज उसतती कीन ॥",
      "sourceLineId": "100703",
      "sourceShabadId": "9287",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਲਖਿ ਤਾਸੁ ਦੇਵਤਾ ਭਏ ਛੀਨ ॥੨॥",
      "transliteration": "lakh taas dhevataa bhe chheen ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਦੇਵਤੇ ਕਮਜ਼ੋਰ ਹੋ ਗਏ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "लखि तासु देवता भए छीन ॥२॥",
      "sourceLineId": "100704",
      "sourceShabadId": "9287",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗੰਥੇ ਤ੍ਰਿਤੀਆ ਅਵਤਾਰ ਬ੍ਰਹਮਾ ਸੁਕ੍ਰ ਸਮਾਪਤੰ ॥੩॥",
      "transliteration": "eit sree bachitr naaTak ga(n)the tirateeaa avataar brahamaa sukr samaapata(n) ||3||",
      "translation": "His fame spread further because of the slander of gods, seeing which the gods became weak.2.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਬ੍ਰਹਮਾ ਦੇ ਤੀਜੇ ਅਵਤਾਰ ਸ਼ੁਕ੍ਰ ਦੀ ਸਮਾਪਤੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक गंथे तृतीआ अवतार ब्रहमा सुक्र समापतं ॥३॥",
      "sourceLineId": "100705",
      "sourceShabadId": "9287",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਥ ਚਤੁਰਥ ਬ੍ਰਹਮਾ ਬਚੇਸ ਕਥਨੰ ॥",
      "transliteration": "ath chaturath brahamaa baches kathana(n) ||",
      "translation": "End of the description of shukra, the third incarnation of Brahma.",
      "punjabiViakhya": "ਹੁਣ ਚੌਥਾ ਬ੍ਰਹਮਾ ਅਵਤਾਰ 'ਬਚੇਸ' ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "अथ चतुरथ ब्रहमा बचेस कथनं ॥",
      "sourceLineId": "100706",
      "sourceShabadId": "9288",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪਾਧੜੀ ਛੰਦ ॥",
      "transliteration": "paadhaRee chha(n)dh ||",
      "translation": "PAADARI STANZA :Now begins the description about Baches the fourth incarnation of Brahma",
      "punjabiViakhya": "ਪਾਧੜੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "पाधड़ी छंद ॥",
      "sourceLineId": "100707",
      "sourceShabadId": "9288",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਿਲਿ ਦੀਨ ਦੇਵਤਾ ਲਗੇ ਸੇਵ ॥",
      "transliteration": "mil dheen dhevataa lage sev ||",
      "translation": "",
      "punjabiViakhya": "ਹੀਣੇ ਹੋ ਚੁਕੇ ਦੇਵਤੇ ਮਿਲ ਕੇ (ਕਾਲ ਪੁਰਖ ਦੀ) ਸੇਵਾ ਕਰਨ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "मिलि दीन देवता लगे सेव ॥",
      "sourceLineId": "100708",
      "sourceShabadId": "9288",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬੀਤੇ ਸੌ ਬਰਖ ਰੀਝੇ ਗੁਰਦੇਵ ॥",
      "transliteration": "beete sau barakh reejhe gurdhev ||",
      "translation": "The lowly gods served the Lord for a hundred years, when he (the Guru-Lord) was pleased",
      "punjabiViakhya": "ਸੌ ਵਰ੍ਰਹਿਆਂ ਦੇ ਬੀਤਣ ਤੋਂ ਬਾਦ ਗੁਰੂ ਦੇਵ ਪ੍ਰਸੰਨ ਹੋਏ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "बीते सौ बरख रीझे गुरदेव ॥",
      "sourceLineId": "100709",
      "sourceShabadId": "9288",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਬ ਧਰਾ ਰੂਪ ਬਾਚੇਸ ਆਨਿ ॥",
      "transliteration": "tab dharaa roop baaches aan ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਬ੍ਰਹਮਾ ਨੇ) ਆ ਕੇ ਬਾਚੇਸ ਦਾ ਰੂਪ ਧਾਰਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "तब धरा रूप बाचेस आनि ॥",
      "sourceLineId": "100710",
      "sourceShabadId": "9288",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜੀਤਾ ਸੁਰੇਸ ਭਈ ਅਸੁਰ ਹਾਨਿ ॥੩॥",
      "transliteration": "jeetaa sures bhiee asur haan ||3||",
      "translation": "Then Brahma assumed the from of Baches, when Indra, the king of gods became the conqueror and the demons were defeated.3.",
      "punjabiViakhya": "(ਜਿਸ ਦੇ ਫਲਸਰੂਪ) ਇੰਦਰ ਜਿਤ ਗਿਆ ਅਤੇ ਦੈਂਤਾ ਦਾ ਨੁਕਸਾਨ ਹੋਇਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "जीता सुरेस भई असुर हानि ॥३॥",
      "sourceLineId": "100711",
      "sourceShabadId": "9288",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਧਰਾ ਚਤੁਰਥ ਵਤਾਰ ॥",
      "transliteration": "eeh bhaat dharaa chaturath vataar ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ (ਬ੍ਰਹਮਾ ਨੇ) ਚੌਥਾ ਅਵਤਾਰ ਧਾਰਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "इह भाति धरा चतुरथ वतार ॥",
      "sourceLineId": "100712",
      "sourceShabadId": "9288",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜੀਤਾ ਸੁਰੇਸ ਹਾਰੇ ਦਿਵਾਰ ॥",
      "transliteration": "jeetaa sures haare dhivaar ||",
      "translation": "In way, the fourth incarnation manifested himself, on account of which Indra, conquered and the demons were defeated",
      "punjabiViakhya": "ਜਿਸ (ਕਰ ਕੇ) ਇੰਦਰ ਜਿਤ ਗਿਆ ਅਤੇ ਦੈਂਤ ('ਦਿਵਾਰ') ਹਾਰ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "जीता सुरेस हारे दिवार ॥",
      "sourceLineId": "100713",
      "sourceShabadId": "9288",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਉਠਿ ਦੇਵ ਸੇਵ ਲਾਗੇ ਸੁ ਸਰਬ ॥",
      "transliteration": "auTh dhev sev laage su sarab ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਦੇਵਤੇ ਉਠ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "उठि देव सेव लागे सु सरब ॥",
      "sourceLineId": "100714",
      "sourceShabadId": "9288",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਧਰਿ ਨੀਚ ਨੈਨ ਕਰਿ ਦੂਰ ਗਰਬ ॥੪॥",
      "transliteration": "dhar neech nain kar dhoor garab ||4||",
      "translation": "Then all the gods relinquished their pried and served with him bowed eyes.4.",
      "punjabiViakhya": "ਅੱਖਾ ਨੀਵੀਆਂ ਕਰ ਕੇ ਅਤੇ ਹੰਕਾਰ ਦੂਰ ਕਰ ਕੇ ਉਸ ਦੀ ਸੇਵਾ ਵਿਚ ਲਗ ਗਏ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "धरि नीच नैन करि दूर गरब ॥४॥",
      "sourceLineId": "100715",
      "sourceShabadId": "9288",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਚਤੁਰਥ ਅਵਤਾਰ ਬ੍ਰਹਮਾ ਬਚੇਸ ਸਮਾਪਤੰ ॥੪॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the chaturath avataar brahamaa baches samaapata(n) ||4||",
      "translation": "End of the description of Baches, the fourth incarnation of Brahma.",
      "punjabiViakhya": "ਇਥੇ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ ਬ੍ਰਹਮਾ ਦੇ ਚੌਥੇ ਅਵਤਾਰ 'ਬਾਚੇਸ' ਦੀ ਸਮਾਪਤੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे चतुरथ अवतार ब्रहमा बचेस समापतं ॥४॥",
      "sourceLineId": "100716",
      "sourceShabadId": "9288",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਥ ਪੰਚਮੋ ਅਵਤਾਰ ਬ੍ਰਹਮਾ ਬਿਆਸ ਮਨੁ ਰਾਜਾ ਕੋ ਰਾਜ ਕਥਨੰ ॥",
      "transliteration": "ath pa(n)chamo avataar brahamaa biaas man raajaa ko raaj kathana(n) ||",
      "translation": "Now being the description of Vyas, the fifth incarnation of Brahma and the description of the rule of king menu.",
      "punjabiViakhya": "ਹੁਣ ਬ੍ਰਹਮਾ ਦੇ ਪੰਜਵੇਾਂ ਅਵਤਾਰ ਬਿਆਸ ਦਾ ਪ੍ਰਸੰਗ ਮਨੁ ਰਾਜਾ ਦੇ ਰਾਜ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "अथ पंचमो अवतार ब्रहमा बिआस मनु राजा को राज कथनं ॥",
      "sourceLineId": "100717",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪਾਧੜੀ ਛੰਦ ॥",
      "transliteration": "paadhaRee chha(n)dh ||",
      "translation": "PAADHARI STANZA",
      "punjabiViakhya": "ਪਾਧੜੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "पाधड़ी छंद ॥",
      "sourceLineId": "100718",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤ੍ਰੇਤਾ ਬਿਤੀਤ ਜੁਗ ਦੁਆਪੁਰਾਨ ॥",
      "transliteration": "tretaa biteet jug dhuaapuraan ||",
      "translation": "",
      "punjabiViakhya": "ਤ੍ਰੇਤਾ (ਯੁਗ) ਬੀਤ ਗਿਆ ਅਤੇ ਦੁਆਪਰ ਯੁਗ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "त्रेता बितीत जुग दुआपुरान ॥",
      "sourceLineId": "100719",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਹੁ ਭਾਤਿ ਦੇਖ ਖੇਲੇ ਖਿਲਾਨ ॥",
      "transliteration": "bahu bhaat dhekh khele khilaan ||",
      "translation": "Treat age passed and Dwapar age came, when Krishna manifested himself and performed various kinds of sports, then Vyas was born",
      "punjabiViakhya": "(ਤਾ) ਬਹੁਤ ਤਰ੍ਰਹਾ ਦੀਆਂ ਲੀਲਾਵਾ ਅਤੇ ਕੌਤਕ ਵੇਖੇ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "बहु भाति देख खेले खिलान ॥",
      "sourceLineId": "100720",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਬ ਭਯੋ ਆਨਿ ਕ੍ਰਿਸਨਾਵਤਾਰ ॥",
      "transliteration": "jab bhayo aan kirasanaavataar ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਕ੍ਰਿਸ਼ਨਾਵਤਾਰ ਆ ਕੇ ਹੋਏ,",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "जब भयो आनि कृसनावतार ॥",
      "sourceLineId": "100721",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਬ ਭਏ ਬ੍ਯਾਸ ਮੁਖ ਆਨਿ ਚਾਰ ॥੫॥",
      "transliteration": "tab bhe bayaas mukh aan chaar ||5||",
      "translation": "He had a charming face.5.",
      "punjabiViakhya": "ਤਦ ਬ੍ਰਹਮਾ ਬਿਆਸ ਰੂਪ ਵਿਚ ਆ ਗਿਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "तब भए ब्यास मुख आनि चार ॥५॥",
      "sourceLineId": "100722",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜੇ ਜੇ ਚਰਿਤ੍ਰ ਕੀਅ ਕ੍ਰਿਸਨ ਦੇਵ ॥",
      "transliteration": "je je charitr keea kirasan dhev ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰਿਸ਼ਨ ਨੇ ਜੋ ਜੋ ਕੌਤਕ ਕੀਤੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "जे जे चरित्र कीअ कृसन देव ॥",
      "sourceLineId": "100723",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤੇ ਤੇ ਭਨੇ ਸੁ ਸਾਰਦਾ ਤੇਵ ॥",
      "transliteration": "te te bhane su saaradhaa tev ||",
      "translation": "Whatever sports Krishna performed, he described them with the halp of Saraswati the godess of learning",
      "punjabiViakhya": "ਉਹ ਉਹ ਸਾਰਦਾ ਦੇਵੀ ਨੇ ਕਹਿ ਸੁਣਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "ते ते भने सु सारदा तेव ॥",
      "sourceLineId": "100724",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਬ ਕਹੋ ਤਉਨ ਸੰਛੇਪ ਠਾਨਿ ॥",
      "transliteration": "ab kaho taun sa(n)chhep Thaan ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਹੁਣ ਉਨ੍ਰਹਾ ਨੂੰ ਸੰਖੇਪ ਵਿਚ ਕਹਿੰਦਾ ਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "अब कहो तउन संछेप ठानि ॥",
      "sourceLineId": "100725",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਿਹ ਭਾਤਿ ਕੀਨ ਸ੍ਰੀ ਅਭਿਰਾਮ ॥੬॥",
      "transliteration": "jeh bhaat keen sree abhiraam ||6||",
      "translation": "Now I describe them in brief, all the works, which Vyas executed.6.",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਦੇ ਸ਼ੋਭਾਸ਼ਾਲੀ (ਕ੍ਰਿਸ਼ਨ) ਨੇ (ਕੌਤਕ) ਕੀਤੇ ਸਨ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "जिह भाति कीन स्री अभिराम ॥६॥",
      "sourceLineId": "100726",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਹ ਭਾਤਿ ਕਥਿ ਕੀਨੋ ਪਸਾਰ ॥",
      "transliteration": "jeh bhaat kath keeno pasaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਵਿਸਥਾਰ ਨਾਲ ਕਥਨ ਕੀਤੇ ਗਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "जिह भाति कथि कीनो पसार ॥",
      "sourceLineId": "100727",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਿਹ ਭਾਤਿ ਕਾਬਿ ਕਥਿ ਹੈ ਬਿਚਾਰ ॥",
      "transliteration": "teh bhaat kaab kath hai bichaar ||",
      "translation": "The manner in which he propagated his writings, in the same manner, I relate the same here thoughtfully",
      "punjabiViakhya": "ਉਸੇ ਤਰ੍ਰਹਾ (ਬਿਆਸ ਨੇ) ਕਾਵਿ ਵਿਚ ਵਿਚਾਰ ਪੂਰਵਕ ਪ੍ਰਗਟ ਕੀਤੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "तिह भाति काबि कथि है बिचार ॥",
      "sourceLineId": "100728",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਹੋ ਜੈਸ ਕਾਬ੍ਰਯ ਕਹਿਯੋ ਬ੍ਯਾਸ ॥",
      "transliteration": "kaho jais kaabray kahiyo bayaas ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਬਿਆਸ ਨੇ ਕਾਵਿ ਰਚਨਾ ਕੀਤੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "कहो जैस काब्रय कहियो ब्यास ॥",
      "sourceLineId": "100729",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਉਨੇ ਕਥਾਨ ਕਥੋ ਪ੍ਰਭਾਸ ॥੭॥",
      "transliteration": "taune kathaan katho prabhaas ||7||",
      "translation": "The poetry that Vyas composed, I now relate here same type of glorious sayings.7.",
      "punjabiViakhya": "ਉਸੇ ਕਥਾ ਨੂੰ ਪ੍ਰਭਾ ਸਹਿਤ (ਅਰਥਾਤ-ਚਮਤਕਾਰ ਪੂਰਨ ਢੰਗ ਨਾਲ) (ਮੈਂ) ਬਿਆਨ ਕਰਦਾ ਹਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "तउने कथान कथो प्रभास ॥७॥",
      "sourceLineId": "100730",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜੇ ਭਏ ਭੂਪ ਭੂਅ ਮੋ ਮਹਾਨ ॥",
      "transliteration": "je bhe bhoop bhooa mo mahaan ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ ਉਤੇ ਜਿਹੜੇ ਜਿਹੜੇ ਮਹਾਨ ਰਾਜੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "जे भए भूप भूअ मो महान ॥",
      "sourceLineId": "100731",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਿਨ ਕੋ ਸੁਜਾਨ ਕਥਤ ਕਹਾਨ ॥",
      "transliteration": "tin ko sujaan kathat kahaan ||",
      "translation": "The scholars describe the stories of all the great kings, who ruled over the earth",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੀਆਂ ਕਹਾਣੀਆਂ ਸੁਜਾਨ ਕਵੀ (ਬਿਆਸ) ਨੇ ਕਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "तिन को सुजान कथत कहान ॥",
      "sourceLineId": "100732",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਹ ਲਗੇ ਤਾਸਿ ਕਿਜੈ ਬਿਚਾਰੁ ॥",
      "transliteration": "keh lage taas kijai bichaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦਾ ਵਿਚਾਰ ਕਿਥੋਂ ਤਕ ਕੀਤਾ ਜਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "कह लगे तासि किजै बिचारु ॥",
      "sourceLineId": "100733",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੁਣਿ ਲੇਹੁ ਬੈਣ ਸੰਛੇਪ ਯਾਰ ॥੮॥",
      "transliteration": "sun leh bain sa(n)chhep yaar ||8||",
      "translation": "To what extent, they may be narrated, O my fried! Listen to the same in brief.8.",
      "punjabiViakhya": "ਹੇ ਮਿਤਰੋ! (ਮੈਂ) ਸੰਖੇਪ ਵਿਚ ਕਹਿੰਦਾ ਹਾ, (ਧਿਆਨ ਨਾਲ) ਸੁਣ ਲਵੋ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "सुणि लेहु बैण संछेप यार ॥८॥",
      "sourceLineId": "100734",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜੇ ਭਏ ਭੂਪ ਤੇ ਕਹੇ ਬ੍ਯਾਸ ॥",
      "transliteration": "je bhe bhoop te kahe bayaas ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੜੇ ਰਾਜੇ ਹੋਏ ਹਨ, ਉਹ ਬਿਆਸ ਨੇ ਕਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "जे भए भूप ते कहे ब्यास ॥",
      "sourceLineId": "100735",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹੋਵਤ ਪੁਰਾਣ ਤੇ ਨਾਮ ਭਾਸ ॥",
      "transliteration": "hovat puraan te naam bhaas ||",
      "translation": "Vayas narrated the exploits of the erstwhile kings, we gather this from the Puranas",
      "punjabiViakhya": "ਪੁਰਾਣਾ ਵਿਚੋਂ ਉਨ੍ਰਹਾ ਦੇ ਨਾਵਾ ਦਾ ਆਭਾਸ ਹੁੰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "होवत पुराण ते नाम भास ॥",
      "sourceLineId": "100736",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮਨੁ ਭਯੋ ਰਾਜ ਮਹਿ ਕੋ ਭੂਆਰ ॥",
      "transliteration": "man bhayo raaj meh ko bhooaar ||",
      "translation": "",
      "punjabiViakhya": "ਮਨੁ ਨਾ ਦਾ (ਇਕ) ਰਾਜਾ ਧਰਤੀ ਉਤੇ ਰਾਜਾ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "मनु भयो राज महि को भूआर ॥",
      "sourceLineId": "100737",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਖੜਗਨ ਸੁ ਪਾਨਿ ਮਹਿਮਾ ਅਪਾਰ ॥੯॥",
      "transliteration": "khaRagan su paan mahimaa apaar ||9||",
      "translation": "There had been one mighty and glorious king named manu.9.",
      "punjabiViakhya": "ਉਹ ਹੱਥ ਵਿਚ ਤਲਵਾਰ ਰਖਦਾ ਸੀ (ਅਰਥਾਤ-ਤਲਵਾਰ ਦਾ ਧਨੀ ਸੀ) ਅਤੇ ਉਸ ਦੀ ਅਪਾਰ ਮਹਿਮਾ ਸੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "खड़गन सु पानि महिमा अपार ॥९॥",
      "sourceLineId": "100738",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਮਾਨਵੀ ਸ੍ਰਿਸਟਿ ਕਿਨੀ ਪ੍ਰਕਾਸ ॥",
      "transliteration": "maanavee sirasaT kinee prakaas ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਮਾਨਵੀ ਸ੍ਰਿਸ਼ਟੀ ਦਾ ਪ੍ਰਕਾਸ਼ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "मानवी सृसटि किनी प्रकास ॥",
      "sourceLineId": "100739",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਦਸ ਚਾਰ ਲੋਕ ਆਭਾ ਅਭਾਸ ॥",
      "transliteration": "dhas chaar lok aabhaa abhaas ||",
      "translation": "He brought to the human words and extending his approbation his greatness?",
      "punjabiViakhya": "ਅਤੇ ਚੌਦਾ ਲੋਕਾ ਵਿਚ ਆਪਣੀ ਸ਼ੋਭਾ ਨੂੰ ਪ੍ਰਕਾਸ਼ਿਤ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "दस चार लोक आभा अभास ॥",
      "sourceLineId": "100740",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮਹਿਮਾ ਅਪਾਰ ਬਰਨੇ ਸੁ ਕਉਨ ॥",
      "transliteration": "mahimaa apaar barane su kaun ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਅਪਾਰ ਮਹਿਮਾ ਦਾ ਕੌਣ ਕਥਨ ਕਰ ਸਕਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "महिमा अपार बरने सु कउन ॥",
      "sourceLineId": "100741",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸੁਣਿ ਸ੍ਰਵਣ ਕ੍ਰਿਤ ਹੁਇ ਰਹੈ ਮਉਨ ॥੧੦॥",
      "transliteration": "sun sravan kirat hui rahai maun ||10||",
      "translation": "And listening to his praise one can only remain mute.10.",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਕੀਰਤੀ ਨੂੰ ਕੰਨਾ ਨਾਲ ਸੁਣ ਕੇ, (ਸਾਰੇ) ਚੁਪ ਹੋ ਜਾਦੇ ਹਨ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "सुणि स्रवण कृत हुइ रहै मउन ॥१०॥",
      "sourceLineId": "100742",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਦਸ ਚਾਰ ਚਾਰਿ ਬਿਦਿਆ ਨਿਧਾਨ ॥",
      "transliteration": "dhas chaar chaar bidhiaa nidhaan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਅਠਾਰ੍ਰਹਾ ਵਿਦਿਆਵਾ ਦਾ ਖ਼ਜ਼ਾਨਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "दस चार चारि बिदिआ निधान ॥",
      "sourceLineId": "100743",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਅਰਿ ਜੀਤਿ ਜੀਤਿ ਦਿਨੋ ਨਿਸਾਨ ॥",
      "transliteration": "ar jeet jeet dhino nisaan ||",
      "translation": "He was ocean of eighteen sciences and he got his trumpets sounded after conquering his enemies",
      "punjabiViakhya": "ਅਤੇ ਵੈਰੀਆਂ ਨੂੰ ਜਿਤ ਜਿਤ ਕੇ ਧੌਂਸਾ ਵਜਾਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "अरि जीति जीति दिनो निसान ॥",
      "sourceLineId": "100744",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਮੰਡੇ ਮਹੀਪ ਮਾਵਾਸ ਖੇਤਿ ॥",
      "transliteration": "ma(n)dde maheep maavaas khet ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਆਕੀ ਰਾਜਿਆਂ ਨਾਲ ਯੁੱਧ ਰਚਾਇਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "मंडे महीप मावास खेति ॥",
      "sourceLineId": "100745",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਗਜੇ ਮਸਾਣ ਨਚੇ ਪਰੇਤ ॥੧੧॥",
      "transliteration": "gaje masaan nache paret ||11||",
      "translation": "He made many person kings, and those who resisted, he killed them, the ghosts and fiends also used to dance in his battlefield.11.",
      "punjabiViakhya": "ਜਿਸ ਵਿਚ ਮਸਾਣ ਗੱਜੇ ਸਨ ਅਤੇ ਪ੍ਰੇਤ ਨਚੇ ਸਨ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "गजे मसाण नचे परेत ॥११॥",
      "sourceLineId": "100746",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜਿਤੇ ਸੁ ਦੇਸ ਏਸੁਰ ਮਵਾਸ ॥",
      "transliteration": "jite su dhes esur mavaas ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਆਕੀ ਰਾਜੇ ਜਿਤ ਲਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "जिते सु देस एसुर मवास ॥",
      "sourceLineId": "100747",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਕਿਨੇ ਖਰਾਬ ਖਾਨੇ ਖ੍ਵਾਸ ॥",
      "transliteration": "kine kharaab khaane khavaiaas ||",
      "translation": "He conquered many countries of opponents and destroyed many to the status of royalty",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਦੇ ਮਹੱਲਾ ਅਤੇ ਰਣਵਾਸਾ ਨੂੰ ਖੁਆਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "किने खराब खाने ख्वास ॥",
      "sourceLineId": "100748",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਭੰਡੇ ਅਭੰਡ ਮੰਡੇ ਮਹੀਪ ॥",
      "transliteration": "bha(n)dde abha(n)dd ma(n)dde maheep ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਰਾਜਿਆਂ ਨਾਲ (ਯੁੱਧ) ਮੰਡ ਕੇ ਨਾ ਭੰਡੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਭੰਡ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "भंडे अभंड मंडे महीप ॥",
      "sourceLineId": "100749",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਦਿਨੇ ਨਿਕਾਰ ਛਿਨੇ ਸੁ ਦੀਪ ॥੧੨॥",
      "transliteration": "dhine nikaar chhine su dheep ||12||",
      "translation": "He snatched the countries of many and exiled them.12.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਦੇਸ ਜਿਤ ਕੇ ਬਾਹਰ ਕੱਢ ਦਿੱਤੇ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "दिने निकार छिने सु दीप ॥१२॥",
      "sourceLineId": "100750",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਖੰਡੇ ਸੁ ਖੇਤਿ ਖੂਨੀ ਖਤ੍ਰੀਯਾਣ ॥",
      "transliteration": "kha(n)dde su khet khoonee khatreeyaan ||",
      "translation": "",
      "punjabiViakhya": "ਖ਼ੂਨਖ਼ਾਰ ਛਤ੍ਰੀਆਂ ਨੂੰ ਰਣ-ਭੂਮੀ ਵਿਚ ਖੰਡ ਖੰਡ ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "खंडे सु खेति खूनी खत्रीयाण ॥",
      "sourceLineId": "100751",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਮੋਰੇ ਅਮੋਰ ਜੋਧਾ ਦੁਰਾਣ ॥",
      "transliteration": "more amor jodhaa dhuraan ||",
      "translation": "He killed many dreadful Kshatriyas and suppressed many corrupt and tyrannical warriors",
      "punjabiViakhya": "ਅਤੇ ਭਿਆਨਕ ਤੇ ਅਮੋੜ ਯੋਧਿਆਂ (ਦੇ ਮੂੰਹ) ਮੋੜ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "मोरे अमोर जोधा दुराण ॥",
      "sourceLineId": "100752",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਚਲੇ ਅਚਲ ਮੰਡੇ ਅਮੰਡ ॥",
      "transliteration": "chale achal ma(n)dde ama(n)dd ||",
      "translation": "",
      "punjabiViakhya": "ਨਾ ਵਿਚਲਿਤ ਕੀਤੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਚਲਾਇਮਾਨ ਕਰ ਦਿੱਤਾ ਅਤੇ (ਜਿਨ੍ਰਹਾ ਨਾਲ) ਯੁੱਧ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ ਸੀ (ਉਨ੍ਰਹਾ ਨਾਲ ਵੀ) ਯੁੱਧ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "चले अचल मंडे अमंड ॥",
      "sourceLineId": "100753",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਕਿਨੇ ਘਮੰਡ ਖੰਡੇ ਪ੍ਰਚੰਡ ॥੧੩॥",
      "transliteration": "kine ghama(n)dd kha(n)dde pracha(n)dd ||13||",
      "translation": "Many stable and invincible fighter fled before him and me destroyed many powerful warriors.13.",
      "punjabiViakhya": "ਅਤੇ ਪ੍ਰਚੰਡ ਸੂਰਮਿਆਂ ਦਾ ਘਮੰਡ ਖੰਡਿਤ ਕਰ ਦਿੱਤਾ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "किने घमंड खंडे प्रचंड ॥१३॥",
      "sourceLineId": "100754",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਕਿਨੇ ਸੁ ਜੇਰ ਖੂਨੀ ਖਤ੍ਰੇਸ ॥",
      "transliteration": "kine su jer khoonee khatres ||",
      "translation": "",
      "punjabiViakhya": "ਖ਼ੂਨਖ਼ਾਰ ਛਤ੍ਰੀਆਂ ਨੂੰ (ਆਪਣੇ) ਅਧੀਨ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "किने सु जेर खूनी खत्रेस ॥",
      "sourceLineId": "100755",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਮੰਡੇ ਮਹੀਪ ਮਾਵਾਸ ਦੇਸ ॥",
      "transliteration": "ma(n)dde maheep maavaas dhes ||",
      "translation": "He subdued many mighty kshatriyas and established many new kings,",
      "punjabiViakhya": "ਆਕੀ ਦੇਸ਼ਾ ਵਿਚ (ਨਵੇਾਂ) ਰਾਜੇ ਸਥਾਪਿਤ ਕਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "मंडे महीप मावास देस ॥",
      "sourceLineId": "100756",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਦੀਹ ਦੋਹੀ ਫਿਰਾਇ ॥",
      "transliteration": "eeh bhaat dheeh dhohee firai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ (ਹਰ ਪਾਸੇ) ਬਹੁਤ ਦੁਹਾਈ ਫਿਰਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "इह भाति दीह दोही फिराइ ॥",
      "sourceLineId": "100757",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0615_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਮਾਨੀ ਸੁ ਮਾਨਿ ਮਨੁ ਰਾਜ ਰਾਇ ॥੧੪॥",
      "transliteration": "maanee su maan man raaj rai ||14||",
      "translation": "In the countries of opposing kings, in the way, the king menu was hououred throughout the bravery.14.",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਮਨੁ ਰਾਜੇ ਦਾ ਮਾਨ ਸਨਮਾਨ ਹੋਣ ਲਗਾ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 615,
      "hindi": "",
      "hindiTransliteration": "मानी सु मानि मनु राज राइ ॥१४॥",
      "sourceLineId": "100758",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
