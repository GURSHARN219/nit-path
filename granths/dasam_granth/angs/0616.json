{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 616,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0616_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜੋ ਹੁਤੀ ਜਗ ਅਰੁ ਬੇਦ ਰੀਤਿ ॥",
      "transliteration": "jo hutee jag ar bedh reet ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਯੱਗ ਦੀ ਮਰਯਾਦਾ ਅਤੇ ਵੇਦ ਦੀ ਰੀਤ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "जो हुती जग अरु बेद रीति ॥",
      "sourceLineId": "100763",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੋ ਕਰੀ ਸਰਬ ਨ੍ਰਿਪ ਲਾਇ ਪ੍ਰੀਤਿ ॥",
      "transliteration": "so karee sarab nirap lai preet ||",
      "translation": "He performed all the Vedic traditions with devotion",
      "punjabiViakhya": "ਉਹ ਸਾਰੀ ਰਾਜੇ ਨੇ ਪ੍ਰੇਮ ਪੂਰਵਕ ਪੂਰੀ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "सो करी सरब नृप लाइ प्रीति ॥",
      "sourceLineId": "100764",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭੂਆ ਦਾਨ ਦਾਨ ਰਤਨਾਦਿ ਆਦਿ ॥",
      "transliteration": "bhooaa dhaan dhaan ratanaadh aadh ||",
      "translation": "",
      "punjabiViakhya": "ਭੂਮੀ ਦਾ ਦਾਨ ਅਤੇ ਰਤਨ ਆਦਿ ਦਾ ਦਾਨ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "भूआ दान दान रतनादि आदि ॥",
      "sourceLineId": "100765",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਿਨ ਭਾਤਿ ਭਾਤਿ ਲਿਨੇ ਸੁਵਾਦ ॥੧੬॥",
      "transliteration": "tin bhaat bhaat line suvaadh ||16||",
      "translation": "He also gave various types of charities concerning lands, jewels ect.16.",
      "punjabiViakhya": "ਉਸ ਨੇ ਭਾਤ ਭਾਤ ਦੇ ਆਨੰਦ ਮਾਣੇ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "तिन भाति भाति लिने सुवाद ॥१६॥",
      "sourceLineId": "100766",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਰਿ ਦੇਸ ਦੇਸ ਇਮਿ ਨੀਤਿ ਰਾਜ ॥",
      "transliteration": "kar dhes dhes im neet raaj ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਦੇਸ਼ ਦੇਸ਼ ਤੇ ਆਪਣੀ ਰਾਜਨੀਤੀ ਦੀ ਸਥਾਪਨਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "करि देस देस इमि नीति राज ॥",
      "sourceLineId": "100767",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਹੁ ਭਾਤਿ ਦਾਨ ਦੇ ਸਰਬ ਸਾਜ ॥",
      "transliteration": "bahu bhaat dhaan dhe sarab saaj ||",
      "translation": "He promulgated his policies in all the countries, and donated gifts of various type",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਸਾਰੇ ਦਾਨ ਦੇ ਸਾਜ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "बहु भाति दान दे सरब साज ॥",
      "sourceLineId": "100768",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਸਤਾਦਿ ਦਤ ਬਾਜਾਦਿ ਮੇਧ ॥",
      "transliteration": "hasataadh dhat baajaadh medh ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਰਾਜੇ ਨੇ) ਹਾਥੀ ਆਦਿ ਦਾਨ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "हसतादि दत बाजादि मेध ॥",
      "sourceLineId": "100769",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤੇ ਭਾਤਿ ਭਾਤਿ ਕਿਨੇ ਨ੍ਰਿਪੇਧ ॥੧੭॥",
      "transliteration": "te bhaat bhaat kine nirapedh ||17||",
      "translation": "He donated elephants ect. And performed various types of ashvamedha yajnas (horse-sacrifices). 17.",
      "punjabiViakhya": "ਅਤੇ ਤਰ੍ਰਹਾ ਤਰ੍ਰਹਾ ਦੇ ਅਸ਼੍ਵਮੇਧ ਅਤੇ ਨ੍ਰਿਪਮੇਧ ਯੱਗ ਕੀਤੇ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "ते भाति भाति किने नृपेध ॥१७॥",
      "sourceLineId": "100770",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਹੁ ਸਾਜ ਬਾਜ ਦਿਨੇ ਦਿਜਾਨ ॥",
      "transliteration": "bahu saaj baaj dhine dhijaan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਬ੍ਰਾਹਮਣਾ ਨੂੰ ਬਹੁਤ ਸਾਰੇ ਘੋੜੇ ਸਾਜ਼ਾ ਸਮੇਤ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "बहु साज बाज दिने दिजान ॥",
      "sourceLineId": "100771",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦਸ ਚਾਰੁ ਚਾਰੁ ਬਿਦਿਆ ਸੁਜਾਨ ॥",
      "transliteration": "dhas chaar chaar bidhiaa sujaan ||",
      "translation": "He donated many decorated horses to those Brahmins, who had the knowledge of eighteen sciences, who were the reciters of six Shastr ect.",
      "punjabiViakhya": "ਜੋ ਚੌਦਾ ਵਿਦਿਆਵਾ ਵਿਚ ਪ੍ਰਬੀਨ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "दस चारु चारु बिदिआ सुजान ॥",
      "sourceLineId": "100772",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਖਟ ਚਾਰ ਸਾਸਤ੍ਰ ਸਿੰਮ੍ਰਿਤ ਰਟੰਤ ॥",
      "transliteration": "khaT chaar saasatr si(n)mirat raTa(n)t ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਚਾਰ ਵੇਦਾ, ਛੇ ਸ਼ਾਸਤ੍ਰਾ ਅਤੇ ਸਮ੍ਰਿਤੀਆਂ ਦਾ ਪਾਠ ਕਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "खट चार सासत्र सिंमृत रटंत ॥",
      "sourceLineId": "100773",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕੋਕਾਦਿ ਭੇਦ ਬੀਨਾ ਬਜੰਤ ॥੧੮॥",
      "transliteration": "kokaadh bhedh beenaa baja(n)t ||18||",
      "translation": "And also those who were skilful in playing various types of musical instruments.18.",
      "punjabiViakhya": "ਕੋਕ (ਸੰਭੋਗ) ਆਦਿਕ ਦੇ ਭੇਦ (ਸਮਝਦੇ ਸਨ) ਅਤੇ ਬੀਨਾ (ਆਦਿਕ ਸਾਜ਼) ਵਜਾਉਾਂਦੇ ਸਨ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "कोकादि भेद बीना बजंत ॥१८॥",
      "sourceLineId": "100774",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਘਨਸਾਰ ਘੋਰਿ ਘਸੀਅਤ ਗੁਲਾਬ ॥",
      "transliteration": "ghanasaar ghor ghaseeat gulaab ||",
      "translation": "",
      "punjabiViakhya": "ਕਪੂਰ (ਕਾਫੂਰ) ਨੂੰ ਗੁਲਾਬ (ਦੇ ਅਰਕ ਵਿਚ) ਘੋਲ ਕੇ ਘਿਸਾਇਆ ਜਾਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "घनसार घोरि घसीअत गुलाब ॥",
      "sourceLineId": "100775",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮ੍ਰਿਗ ਮਦਿਤ ਡਾਰਿ ਚੂਵਤ ਸਰਾਬ ॥",
      "transliteration": "mirag madhit ddaar choovat saraab ||",
      "translation": "At that time the Sandal and roses were rubbed and the liquor of musk was prepared",
      "punjabiViakhya": "ਅਤੇ ਕਸਤੂਰੀ ('ਮ੍ਰਿਗ ਮਦਿਤ') ਪਾ ਕੇ ਸ਼ਰਾਬ ਕੱਢੀ ਜਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "मृग मदित डारि चूवत सराब ॥",
      "sourceLineId": "100776",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਸਮੀਰ ਘਾਸ ਘੋਰਤ ਸੁਬਾਸ ॥",
      "transliteration": "kasameer ghaas ghorat subaas ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਗੰਧੀ ਲਈ ਕੇਸਰ ('ਕਸ਼ਮੀਰ ਘਾਸ') ਨੂੰ ਘੋਲਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "कसमीर घास घोरत सुबास ॥",
      "sourceLineId": "100777",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਉਘਟਤ ਸੁਗੰਧ ਮਹਕੰਤ ਅਵਾਸ ॥੧੯॥",
      "transliteration": "aughaTat suga(n)dh mahaka(n)t avaas ||19||",
      "translation": "During the reign of that king, the abodes of all the people gave out the fragrance of Kashmiri grass.19.",
      "punjabiViakhya": "(ਉਸ ਤੋਂ) ਸੁਗੰਧੀ ਉਠਦੀ ਸੀ ਅਤੇ ਘਰ ਮਹਿਕ ਜਾਦੇ ਸਨ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "उघटत सुगंध महकंत अवास ॥१९॥",
      "sourceLineId": "100778",
      "sourceShabadId": "9289",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੰਗੀਤ ਪਾਧਰੀ ਛੰਦ ॥",
      "transliteration": "sa(n)geet paadharee chha(n)dh ||",
      "translation": "SANGET PADRI STANZA",
      "punjabiViakhya": "ਸੰਗੀਤ ਪਾਧਰੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "संगीत पाधरी छंद ॥",
      "sourceLineId": "100779",
      "sourceShabadId": "9290",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾਗੜਦੰ ਤਾਲ ਬਾਜਤ ਮੁਚੰਗ ॥",
      "transliteration": "taagaRadha(n) taal baajat mucha(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਛੈਣੇ, ਮੁਚੰਗ, ਬੀਣਾ,",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "तागड़दं ताल बाजत मुचंग ॥",
      "sourceLineId": "100780",
      "sourceShabadId": "9290",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬੀਨਾ ਸੁ ਬੈਣ ਬੰਸੀ ਮ੍ਰਿਦੰਗ ॥",
      "transliteration": "beenaa su bain ba(n)see miradha(n)g ||",
      "translation": "The tunes of Iyer, drum etc. were heard",
      "punjabiViakhya": "ਬੀਨ, ਬੰਸਰੀ, ਮ੍ਰਿਦੰਗ,",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "बीना सु बैण बंसी मृदंग ॥",
      "sourceLineId": "100781",
      "sourceShabadId": "9290",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਡਫ ਤਾਲ ਤੁਰੀ ਸਹਿਨਾਇ ਰਾਗ ॥",
      "transliteration": "ddaf taal turee sahinai raag ||",
      "translation": "",
      "punjabiViakhya": "ਡਫ, ਕੈਂਸੀਆਂ, ਤੁਰੀ, ਸ਼ਹਿਨਾਈਆਂ ਵਜਣ ਨਾਲ ਰਾਗ ਪੈਦਾ ਹੁੰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "डफ ताल तुरी सहिनाइ राग ॥",
      "sourceLineId": "100782",
      "sourceShabadId": "9290",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਾਜੰਤ ਜਾਨ ਉਪਨਤ ਸੁਹਾਗ ॥੨੦॥",
      "transliteration": "baaja(n)t jaan upanat suhaag ||20||",
      "translation": "The pleasing sounds of tabors, clarions, clarionets ect. Were also heard.2o.",
      "punjabiViakhya": "ਅਤੇ ਵਜਣ ਨਾਲ ਮਾਨੋ ਸੌਭਾਗ ਪ੍ਰਤਖ ਸੀ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "बाजंत जान उपनत सुहाग ॥२०॥",
      "sourceLineId": "100783",
      "sourceShabadId": "9290",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਹੂੰ ਤਾਲ ਤੂਰ ਬੀਨਾ ਮ੍ਰਿਦੰਗ ॥",
      "transliteration": "kahoo(n) taal toor beenaa miradha(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਛੈਣੇ, ਤੂਰ, ਬੀਣਾ, ਮ੍ਰਿਦੰਗ,",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "कहूँ ताल तूर बीना मृदंग ॥",
      "sourceLineId": "100784",
      "sourceShabadId": "9290",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਡਫ ਝਾਝ ਢੋਲ ਜਲਤਰ ਉਪੰਗ ॥",
      "transliteration": "ddaf jhaajh ddol jalatar upa(n)g ||",
      "translation": "Somewhere there wes tune of drum, lyer etc. and somewhere the sound of tabor, anklet, drum,musical glasses ect. Was heard",
      "punjabiViakhya": "ਡਫ, ਝਾਝ, ਢੋਲ, ਜਲਤਰੰਗ ਅਤੇ ਉਪੰਗ (ਨਾ ਦੇ ਸਾਜ਼ ਵਜਦੇ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "डफ झाझ ढोल जलतर उपंग ॥",
      "sourceLineId": "100785",
      "sourceShabadId": "9290",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਹ ਜਹ ਬਿਲੋਕ ਤਹ ਤਹ ਸੁਬਾਸ ॥",
      "transliteration": "jeh jeh bilok teh teh subaas ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਜਿਥੇ ਵੇਖੋ ਉਥੇ ਉਥੇ ਹੀ ਸੁਗੰਧੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "जह जह बिलोक तह तह सुबास ॥",
      "sourceLineId": "100786",
      "sourceShabadId": "9290",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਉਠਤ ਸੁਗੰਧ ਮਹਕੰਤ ਅਵਾਸ ॥੨੧॥",
      "transliteration": "auThat suga(n)dh mahaka(n)t avaas ||21||",
      "translation": "There was feeling of fragrance everywhere and with this rising odour,all the abodes seemed fragrant.21.",
      "punjabiViakhya": "ਸੁਗੰਧ ਦੇ ਉਠਣ ਨਾਲ ਘਰ ਮਹਿਕ ਰਹੇ ਹਨ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "उठत सुगंध महकंत अवास ॥२१॥",
      "sourceLineId": "100787",
      "sourceShabadId": "9290",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹਰਿ ਬੋਲ ਮਨਾ ਛੰਦ ॥",
      "transliteration": "har bol manaa chha(n)dh ||",
      "translation": "HARIBOLMANA STANZA",
      "punjabiViakhya": "ਹਰਿ ਬੋਲ ਮਨਾ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "हरि बोल मना छंद ॥",
      "sourceLineId": "100788",
      "sourceShabadId": "9291",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਨੁ ਰਾਜ ਕਰ੍ਯੋ ॥",
      "transliteration": "man raaj karayo ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ ਦਾ) ਮਨੁ ਰਾਜੇ ਨੇ ਰਾਜ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "मनु राज कर्यो ॥",
      "sourceLineId": "100789",
      "sourceShabadId": "9291",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੁਖ ਦੇਸ ਹਰ੍ਯੋ ॥",
      "transliteration": "dhukh dhes harayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੇਸ਼ ਦਾ ਦੁਖ ਹਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "दुख देस हर्यो ॥",
      "sourceLineId": "100790",
      "sourceShabadId": "9291",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਹੁ ਸਾਜ ਸਜੇ ॥",
      "transliteration": "bahu saaj saje ||",
      "translation": "",
      "punjabiViakhya": "(ਦੇਸ ਵਿਚ) ਬਹੁਤ ਸਾਰੇ ਸਾਜ ਸਜਾਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "बहु साज सजे ॥",
      "sourceLineId": "100791",
      "sourceShabadId": "9291",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੁਨਿ ਦੇਵ ਲਜੇ ॥੨੨॥",
      "transliteration": "sun dhev laje ||22||",
      "translation": "When manu ruled, he removed the suffering of the people and he was so good that even the gods felt shy after listening to his approbation.22.",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨੂੰ) ਸੁਣ ਕੇ ਦੇਵਤੇ ਵੀ ਸ਼ਰਮਸਾਰ ਹੁੰਦੇ ਸਨ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "सुनि देव लजे ॥२२॥",
      "sourceLineId": "100792",
      "sourceShabadId": "9291",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਮਨੁ ਰਾਜਾ ਕੋ ਰਾਜ ਸਮਾਪਤੰ ॥੧॥੫॥",
      "transliteration": "eit sree bachitr naaTake man raajaa ko raaj samaapata(n) ||1||5||",
      "translation": "End of the description of the rule of king Manu in Bachitar Natak.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਦੇ ਮਨੁ ਰਾਜੇ ਦੇ ਰਾਜ ਦੀ ਸਮਾਪਤੀ ॥੧॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटके मनु राजा को राज समापतं ॥१॥५॥",
      "sourceLineId": "100793",
      "sourceShabadId": "9291",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਥ ਪ੍ਰਿਥੁ ਰਾਜਾ ਕੋ ਰਾਜ ਕਥਨੰ ॥",
      "transliteration": "ath pirath raajaa ko raaj kathana(n) ||",
      "translation": "Now begins the description of the rule of king Prithu.",
      "punjabiViakhya": "ਹੁਣ ਪ੍ਰਿਥੁ ਰਾਜਾ ਦੇ ਰਾਜ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "अथ पृथु राजा को राज कथनं ॥",
      "sourceLineId": "100794",
      "sourceShabadId": "9292",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤੋਟਕ ਛੰਦ ॥",
      "transliteration": "toTak chha(n)dh ||",
      "translation": "TOTAK STANZA",
      "punjabiViakhya": "ਤੋਟਕ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "तोटक छंद ॥",
      "sourceLineId": "100795",
      "sourceShabadId": "9292",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਹੰ ਲਾਗ ਗਨੋ ਨ੍ਰਿਪ ਜੌਨ ਭਏ ॥",
      "transliteration": "kaha(n) laag gano nirap jauan bhe ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਤਨੇ ਰਾਜੇ ਹੋਏ, ਉਨ੍ਰਹਾ ਨੂੰ ਕਿਥੋਂ ਤਕ ਗਿਣਾ?",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "कहं लाग गनो नृप जौन भए ॥",
      "sourceLineId": "100796",
      "sourceShabadId": "9292",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪ੍ਰਭੁ ਜੋਤਹਿ ਜੋਤਿ ਮਿਲਾਇ ਲਏ ॥",
      "transliteration": "prabh joteh jot milai le ||",
      "translation": "How many kings were there and how many of them were merged by the Lord in his light? To what extent should I describe them.",
      "punjabiViakhya": "ਪ੍ਰਭੂ ਨੇ (ਉਨ੍ਰਹਾ ਦੀ) ਜੋਤਿ ਆਪਣੀ ਜੋਤਿ ਵਿਚ ਮਿਲਾ ਲਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "प्रभु जोतहि जोति मिलाइ लए ॥",
      "sourceLineId": "100797",
      "sourceShabadId": "9292",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪੁਨਿ ਸ੍ਰੀ ਪ੍ਰਿਥਰਾਜ ਪ੍ਰਿਥੀਸ ਭਯੋ ॥",
      "transliteration": "pun sree piratharaaj pirathees bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਪ੍ਰਿਥਵੀ ਦਾ ਪ੍ਰਿਥੁ ਰਾਜਾ ਹੋਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "पुनि स्री पृथराज पृथीस भयो ॥",
      "sourceLineId": "100798",
      "sourceShabadId": "9292",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਨਿ ਬਿਪਨ ਦਾਨ ਦੁਰੰਤ ਦਯੋ ॥੨੩॥",
      "transliteration": "jin bipan dhaan dhura(n)t dhayo ||23||",
      "translation": "Then there was Prithu, the Lord of the earth, who donated enormous gifts to the Brahmins.23.",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਬ੍ਰਾਹਮਣਾ ਨੂੰ ਬੇਅੰਤ ਦਾਨ ਦਿੱਤਾ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "जिनि बिपन दान दुरंत दयो ॥२३॥",
      "sourceLineId": "100799",
      "sourceShabadId": "9292",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦਲੁ ਲੈ ਦਿਨ ਏਕ ਸਿਕਾਰ ਚੜੇ ॥",
      "transliteration": "dhal lai dhin ek sikaar chaRe ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ) ਸੈਨਾ ਦਲ ਲੈ ਕੇ ਇਕ ਦਿਨ ਸ਼ਿਕਾਰ ਚੜ੍ਰਹਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "दलु लै दिन एक सिकार चड़े ॥",
      "sourceLineId": "100800",
      "sourceShabadId": "9292",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਨਿ ਨਿਰਜਨ ਮੋ ਲਖਿ ਬਾਘ ਬੜੇ ॥",
      "transliteration": "ban nirajan mo lakh baagh baRe ||",
      "translation": "One day, in a desolate forest, seeing huge lions, he went hunting, along with his army, in order to attack them",
      "punjabiViakhya": "ਅਤੇ ਨਿਰਜਨ ਬਨ ਵਿਚ ਵੱਡੇ ਵੱਡੇ ਬਾਘ ਵੇਖੇ।",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "बनि निरजन मो लखि बाघ बड़े ॥",
      "sourceLineId": "100801",
      "sourceShabadId": "9292",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਹ ਨਾਰਿ ਸੁਕੁੰਤਲ ਤੇਜ ਧਰੇ ॥",
      "transliteration": "teh naar suku(n)tal tej dhare ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਹੀ ਸ਼ਕੁੰਤਲਾ (ਨਾ ਵਾਲੀ) ਇਸਤਰੀ ਨੇ ਤੇਜ (ਸੁੰਦਰਤਾ) ਧਾਰਨ ਕੀਤਾ ਹੋਇਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "तह नारि सुकुँतल तेज धरे ॥",
      "sourceLineId": "100802",
      "sourceShabadId": "9292",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਸਿ ਸੂਰਜ ਕੀ ਲਖਿ ਕ੍ਰਾਤਿ ਹਰੇ ॥੨੪॥",
      "transliteration": "sas sooraj kee lakh kraat hare ||24||",
      "translation": "There a women named Shakuntala, whose light bedimmed even the luster of the sun.24.",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਸੂਰਜ ਅਤੇ ਚੰਦ੍ਰਮਾ ਦੀ ਚਮਕ ਵੀ ਮਾੜੀ ਪੈ ਜਾਦੀ ਸੀ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "ससि सूरज की लखि क्राति हरे ॥२४॥",
      "sourceLineId": "100803",
      "sourceShabadId": "9292",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਹਰਿ ਬੋਲ ਮਨਾ ਛੰਦ ॥",
      "transliteration": "har bol manaa chha(n)dh ||",
      "translation": "HARIBOLMANA STANZA",
      "punjabiViakhya": "ਹਰਿ ਬੋਲ ਮਨਾ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "हरि बोल मना छंद ॥",
      "sourceLineId": "100804",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਹ ਜਾਤ ਭਏ ॥",
      "transliteration": "teh jaat bhe ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ) ਉਥੇ ਚਲਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "तह जात भए ॥",
      "sourceLineId": "100805",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮ੍ਰਿਗ ਘਾਤ ਕਏ ॥",
      "transliteration": "mirag ghaat ke ||",
      "translation": "",
      "punjabiViakhya": "ਹਿਰਨਾ ਦਾ ਸ਼ਿਕਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "मृग घात कए ॥",
      "sourceLineId": "100806",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਕ ਦੇਖਿ ਕੁਟੀ ॥",
      "transliteration": "eik dhekh kuTee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ) ਇਕ ਕੁਟੀਆ ਵੇਖੀ,",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "इक देखि कुटी ॥",
      "sourceLineId": "100807",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਨੁ ਜੋਗ ਜੁਟੀ ॥੨੫॥",
      "transliteration": "jan jog juTee ||25||",
      "translation": "After killing a deer and seeing a desolate cottage, the king reached there.25.",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ) ਮਾਨੋ ਜੋਗ ਵਿਚ ਜੁੜੀ ਹੋਈ ਹੈ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "जनु जोग जुटी ॥२५॥",
      "sourceLineId": "100808",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਹ ਜਾਤ ਭਯੋ ॥",
      "transliteration": "teh jaat bhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ) ਉਸ (ਕੁਟੀਆ) ਵਿਚ ਚਲਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "तह जात भयो ॥",
      "sourceLineId": "100809",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0616_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੰਗ ਕੋ ਨ ਲਯੋ ॥",
      "transliteration": "sa(n)g ko na layo ||",
      "translation": "",
      "punjabiViakhya": "ਨਾਲ ਕਿਸੇ ਨੂੰ ਨਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 616,
      "hindi": "",
      "hindiTransliteration": "संग को न लयो ॥",
      "sourceLineId": "100810",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
