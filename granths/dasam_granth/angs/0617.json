      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0617_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੁਖ ਰਾਸਨ ਸੇ ॥੩੧॥",
      "transliteration": "sukh raasan se ||31||",
      "translation": "Being absorbed and dyed with love, they kept engrossed in sexual enjoinment many types of postures.31.",
      "punjabiViakhya": "ਜੋ ਸੁਖ ਦੀ ਰਾਸ (ਵਰਗੇ ਸਨ) ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 617,
      "hindi": "",
      "hindiTransliteration": "सुख रासन से ॥३१॥",
      "sourceLineId": "100832",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0617_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਲਲਤਾਸਨ ਲੈ ॥",
      "transliteration": "lalataasan lai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸਤਰੀ ਨੂੰ) ਲਲਿਤ ਆਸਨ ਵਿਚ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 617,
      "hindi": "",
      "hindiTransliteration": "ललतासन लै ॥",
      "sourceLineId": "100833",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
