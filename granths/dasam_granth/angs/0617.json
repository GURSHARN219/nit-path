    {
      "id": "dasam_ang_0617_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਲਖਿ ਨਾਰਿ ਖਰੀ ॥",
      "transliteration": "lakh naar kharee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਇਕ) ਇਸਤਰੀ ਖੜੋਤੀ ਹੋਈ ਵੇਖੀ",
      "source": "DASAM_GRANTH",
      "ang": 617,
      "hindi": "",
      "hindiTransliteration": "लखि नारि खरी ॥",
      "sourceLineId": "100811",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0617_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਸ ਰੀਤਿ ਭਰੀ ॥੨੬॥",
      "transliteration": "ras reet bharee ||26||",
      "translation": "He went there and there was none with him, he saw a very charming woman there.26.",
      "punjabiViakhya": "ਜੋ ਜੋਬਨ ਦੇ ਰਸ ਨਾਲ ਭਰੀ ਹੋਈ ਸੀ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 617,
      "hindi": "",
      "hindiTransliteration": "रस रीति भरी ॥२६॥",
      "sourceLineId": "100812",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0617_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਤਿ ਸੋਭਤ ਹੈ ॥",
      "transliteration": "at sobhat hai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬਹੁਤ ਸੋਭਾ ਵਾਲੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 617,
      "hindi": "",
      "hindiTransliteration": "अति सोभत है ॥",
      "sourceLineId": "100813",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0617_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਲਖਿ ਲੋਭਤ ਹੈ ॥",
      "transliteration": "lakh lobhat hai ||",
      "translation": "",
      "punjabiViakhya": "ਵੇਖਣ ਵਾਲੇ ਨੂੰ ਲੁਭਾ ਲੈਂਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 617,
      "hindi": "",
      "hindiTransliteration": "लखि लोभत है ॥",
      "sourceLineId": "100814",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0617_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨ੍ਰਿਪ ਪੇਖਿ ਜਬੈ ॥",
      "transliteration": "nirap pekh jabai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਰਾਜੇ ਨੇ ਜਦੋਂ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 617,
      "hindi": "",
      "hindiTransliteration": "नृप पेखि जबै ॥",
      "sourceLineId": "100815",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0617_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚਿਤਿ ਚਉਕ ਤਬੈ ॥੨੭॥",
      "transliteration": "chit chauk tabai ||27||",
      "translation": "Her glory coveted his mind, when the king saw her, his mind was startled.27.",
      "punjabiViakhya": "ਤਾ ਚਿਤ ਵਿਚ ਹੈਰਾਨ ਹੋ ਗਿਆ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 617,
      "hindi": "",
      "hindiTransliteration": "चिति चउक तबै ॥२७॥",
      "sourceLineId": "100816",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0617_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਇਹ ਕਉਨ ਜਈ ॥",
      "transliteration": "eeh kaun jiee ||",
      "translation": "",
      "punjabiViakhya": "(ਸੋਚੀਂ ਪੈ ਗਿਆ ਕਿ) ਇਹ ਕਿਸ ਦੀ ਪੁੱਤਰੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 617,
      "hindi": "",
      "hindiTransliteration": "इह कउन जई ॥",
      "sourceLineId": "100817",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0617_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਨੁ ਰੂਪ ਮਈ ॥",
      "transliteration": "jan roop miee ||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ) ਮਾਨੋ ਰੂਪਵਤੀ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 617,
      "hindi": "",
      "hindiTransliteration": "जनु रूप मई ॥",
      "sourceLineId": "100818",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0617_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਛਬਿ ਦੇਖਿ ਛਕ੍ਯੋ ॥",
      "transliteration": "chhab dhekh chhakayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਛਬੀ ਨੂੰ ਵੇਖ ਕੇ ਪ੍ਰਸੰਨ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 617,
      "hindi": "",
      "hindiTransliteration": "छबि देखि छक्यो ॥",
      "sourceLineId": "100819",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0617_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚਿਤ ਚਾਇ ਚਕ੍ਰਯੋ ॥੨੮॥",
      "transliteration": "chit chai chakrayo ||28||",
      "translation": "The king though as to whose daughter that beautiful woman was, seeing here beauty the king saw allured and his mind fell in love with her.28.",
      "punjabiViakhya": "ਅਤੇ ਚਿਤ ਵਿਚ ਚਾਉ ਪੈਦਾ ਹੋ ਗਿਆ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 617,
      "hindi": "",
      "hindiTransliteration": "चित चाइ चक्रयो ॥२८॥",
      "sourceLineId": "100820",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0617_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨ੍ਰਿਪ ਬਾਹ ਗਹੀ ॥",
      "transliteration": "nirap baeh gahee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ (ਉਸ ਦੀ) ਬਾਹ ਪਕੜ ਲਈ,",
      "source": "DASAM_GRANTH",
      "ang": 617,
      "hindi": "",
      "hindiTransliteration": "नृप बाह गही ॥",
      "sourceLineId": "100821",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0617_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤ੍ਰੀਅ ਮੋਨ ਰਹੀ ॥",
      "transliteration": "treea mon rahee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਚੁਪ ਰਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 617,
      "hindi": "",
      "hindiTransliteration": "त्रीअ मोन रही ॥",
      "sourceLineId": "100822",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0617_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਸ ਰੀਤਿ ਰਚ੍ਯੋ ॥",
      "transliteration": "ras reet rachayo ||",
