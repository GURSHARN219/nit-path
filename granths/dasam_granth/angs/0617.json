      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0617_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਲ ਕੇਲ ਮਚ੍ਯੋ ॥",
