      "punjabiViakhya": "ਅਤੇ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਕਾਮਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 617,
      "hindi": "",
      "hindiTransliteration": "कल केल मच्यो ॥",
      "sourceLineId": "100830",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0617_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਮਿਤਾਸਨ ਦੇ ॥",
      "transliteration": "amitaasan dhe ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਅਮਿਤ ਆਸਨ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 617,
