      "source": "DASAM_GRANTH",
      "ang": 617,
      "hindi": "",
      "hindiTransliteration": "करि काम कला ॥३२॥",
      "sourceLineId": "100836",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0617_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਰਿ ਕੇਲ ਉਠੀ ॥",
      "transliteration": "kar kel uThee ||",
      "translation": "",
      "punjabiViakhya": "(ਸ਼ਕੁੰਤਲਾ ਰਾਜੇ ਨਾਲ) ਕੱਖਾ ਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 617,
      "hindi": "",
      "hindiTransliteration": "करि केल उठी ॥",
      "sourceLineId": "100837",
      "sourceShabadId": "9293",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0617_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਧਿ ਪਰਨ ਕੁਟੀ ॥",
