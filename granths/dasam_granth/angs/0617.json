      "raag": ""
    },
    {
      "id": "dasam_ang_0617_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਲਲਨਾ ਰੁ ਲਲਾ ॥",
      "transliteration": "lalanaa r lalaa ||",
      "translation": "",
      "punjabiViakhya": "ਲਲਨਾ (ਪ੍ਰਿਯਾ) ਅਤੇ ਲਲਾ (ਪ੍ਰਿਯ) ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 617,
      "hindi": "",
      "hindiTransliteration": "ललना रु लला ॥",
      "sourceLineId": "100835",
