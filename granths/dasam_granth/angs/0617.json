      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0617_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਰਿ ਕਾਮ ਕਲਾ ॥੩੨॥",
      "transliteration": "kar kaam kalaa ||32||",
      "translation": "They enjoyment the relish of various types of postures and in the way, both of them established their sexual sport.32.",
