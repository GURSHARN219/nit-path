{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 620,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0620_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਖੋਦਿ ਕੈ ਬਹੁ ਭਾਤਿ ਪ੍ਰਿਥਵੀ ਪੂਜਿ ਅਰਧ ਦਿਸਾਨ ॥",
      "transliteration": "khodh kai bahu bhaat pirathavee pooj aradh dhisaan ||",
      "translation": "",
      "punjabiViakhya": "ਬਹਤੁ ਢੰਗਾ ਨਾਲ ਧਰਤੀ ਨੂੰ ਪੁਟ ਪੁਟ ਕੇ ਜਦ ਉਹ ਅੱਧੀ ਦਿਸ਼ਾ ਤਕ ਪਹੁੰਚ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "खोदि कै बहु भाति पृथवी पूजि अरध दिसान ॥",
      "sourceLineId": "101003",
      "sourceShabadId": "9298",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅੰਤਿ ਭੇਦ ਬਿਲੋਕੀਆ ਮੁਨਿ ਬੈਠਿ ਸੰਜੁਤ ਧ੍ਯਾਨ ॥",
      "transliteration": "a(n)t bhedh bilokeeaa mun baiTh sa(n)jut dhayaan ||",
      "translation": "While digging the earth in various ways, scanned all the directions, they ultimately saw the sage Kapila in medication",
      "punjabiViakhya": "(ਤਦ) ਆਖਿਰ ਉਨ੍ਰਹਾ ਨੇ ਭੇਦ ਪਾ ਲਿਆ ਕਿ (ਇਕ) ਮੁਨੀ ਧਿਆਨ ਵਿਚ ਜੁੜਿਆ ਬੈਠਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "अंति भेद बिलोकीआ मुनि बैठि संजुत ध्यान ॥",
      "sourceLineId": "101004",
      "sourceShabadId": "9298",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪ੍ਰਿਸਟ ਪਾਛ ਬਿਲੋਕ ਬਾਜ ਸਮਾਜ ਰੂਪ ਅਨੂਪ ॥",
      "transliteration": "pirasaT paachh bilok baaj samaaj roop anoop ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਪਿਠ ਪਿਛੇ ਪੂਰੀ ਸਾਜ ਸਜਾਵਟ ਨਾਲ ਘੋੜਾ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "पृसट पाछ बिलोक बाज समाज रूप अनूप ॥",
      "sourceLineId": "101005",
      "sourceShabadId": "9298",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਲਾਤ ਭੇ ਮੁਨਿ ਮਾਰਿਓ ਅਤਿ ਗਰਬ ਕੈ ਸੁਤ ਭੂਪ ॥੭੨॥",
      "transliteration": "laat bhe mun maario at garab kai sut bhoop ||72||",
      "translation": "They saw the horse behind him and those princes in their pride, hit the sage with the leg.72.",
      "punjabiViakhya": "ਰਾਜੇ (ਸਗਰ ਦੇ) ਪੁੱਤਰਾ ਨੇ ਬਹੁਤ ਹੰਕਾਰ ਨਾਲ ਮੁਨੀ ਨੂੰ ਲਤਾ ਮਾਰੀਆਂ ॥੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "लात भे मुनि मारिओ अति गरब कै सुत भूप ॥७२॥",
      "sourceLineId": "101006",
      "sourceShabadId": "9298",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਧ੍ਰਯਾਨ ਛੂਟ ਤਬੈ ਮੁਨੀ ਦ੍ਰਿਗ ਜ੍ਵਾਲ ਮਾਲ ਕਰਾਲ ॥",
      "transliteration": "dhrayaan chhooT tabai munee dhirag javaiaal maal karaal ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਮੁਨੀ ਦਾ ਧਿਆਨ ਛੁਟ ਗਿਆ ਅਤੇ (ਉਸ ਦੀਆਂ) ਅੱਖਾ ਵਿਚੋਂ ਅਗਨੀ ਦੀਆਂ ਭਿਆਨਕ ਲਾਟਾ ਨਿਕਲੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "ध्रयान छूट तबै मुनी दृग ज्वाल माल कराल ॥",
      "sourceLineId": "101007",
      "sourceShabadId": "9298",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿਨ ਸੋ ਉਠੀ ਜਨੁ ਸਿੰਧ ਅਗਨਿ ਬਿਸਾਲ ॥",
      "transliteration": "bhaat bhaatin so uThee jan si(n)dh agan bisaal ||",
      "translation": "The medication of the sage was broken and from within him arose various kinds of huge fires",
      "punjabiViakhya": "(ਉਹ ਅਗਨੀ) ਭਾਤ ਭਾਤ ਨਾਲ ਨਿਕਲੀ ਜਿਵੇਾਂ ਸਮੁੰਦਰ ਦੀ ਵਿਸ਼ਾਲ ਅੱਗ ਹੁੰਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "भाति भातिन सो उठी जनु सिंध अगनि बिसाल ॥",
      "sourceLineId": "101008",
      "sourceShabadId": "9298",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭਸਮਿ ਭੂਤ ਭਏ ਸਬੇ ਨ੍ਰਿਪ ਲਛ ਪੁਤ੍ਰ ਸੁ ਨੈਨ ॥",
      "transliteration": "bhasam bhoot bhe sabe nirap lachh putr su nain ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਨੈਨ (ਅਗਨੀ) ਨਾਲ (ਸਗਰ) ਰਾਜੇ ਦੇ ਲਖ ਪੁੱਤਰ ਭਸਮੀ ਭੂਤ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "भसमि भूत भए सबे नृप लछ पुत्र सु नैन ॥",
      "sourceLineId": "101009",
      "sourceShabadId": "9298",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਾਜ ਰਾਜ ਸੁ ਸੰਪਦਾ ਜੁਤ ਅਸਤ੍ਰ ਸਸਤ੍ਰ ਸੁ ਸੈਨ ॥੭੩॥",
      "transliteration": "baaj raaj su sa(n)padhaa jut asatr sasatr su sain ||73||",
      "translation": "In that fire, one-lakh sons of the king along with their horses, arms, weapons and forces were reduced to ashes.73.",
      "punjabiViakhya": "ਰਾਜ ਸਾਜ ਅਤੇ ਸੰਪਤੀ ਸਹਿਤ (ਉਹ) ਘੋੜਾ ਅਤੇ ਅਸਤ੍ਰ-ਸ਼ਸਤ੍ਰ ਤੇ ਸੈਨਾ (ਨਸ਼ਟ ਹੋ ਗਈ) ॥੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "बाज राज सु संपदा जुत असत्र ससत्र सु सैन ॥७३॥",
      "sourceLineId": "101010",
      "sourceShabadId": "9298",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਧੁਭਾਰ ਛੰਦ ॥",
      "transliteration": "madhubhaar chha(n)dh ||",
      "translation": "MADHUBHAAR SATAZA",
      "punjabiViakhya": "ਮਧੁਭਾਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "मधुभार छंद ॥",
      "sourceLineId": "101011",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਭਏ ਭਸਮਿ ਭੂਤ ॥",
      "transliteration": "bhe bhasam bhoot ||",
      "translation": "",
      "punjabiViakhya": "ਭਸਮ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "भए भसमि भूत ॥",
      "sourceLineId": "101012",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨ੍ਰਿਪ ਸਰਬ ਪੂਤ ॥",
      "transliteration": "nirap sarab poot ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ (ਸਗਰ) ਸਾਰੇ ਰਾਜ ਕੁਮਾਰ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "नृप सरब पूत ॥",
      "sourceLineId": "101013",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੁਤ ਸੁਭਟ ਸੈਨ ॥",
      "transliteration": "jut subhaT sain ||",
      "translation": "",
      "punjabiViakhya": "ਸੈਨਾ ਸਹਿਤ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "जुत सुभट सैन ॥",
      "sourceLineId": "101014",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੁੰਦਰ ਸੁਬੈਨ ॥੭੪॥",
      "transliteration": "su(n)dhar subain ||74||",
      "translation": "All the sons of the king were reduced to ashes and all his forces were destroyed while lamenting.74",
      "punjabiViakhya": "ਸੁੰਦਰ ਬੋਲਾ ਵਾਲੇ ॥੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "सुँदर सुबैन ॥७४॥",
      "sourceLineId": "101015",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੋਭਾ ਅਪਾਰ ॥",
      "transliteration": "sobhaa apaar ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਦੀ) ਸ਼ੋਭਾ ਅਪਾਰ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "सोभा अपार ॥",
      "sourceLineId": "101016",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੁੰਦਰ ਕੁਮਾਰ ॥",
      "transliteration": "su(n)dhar kumaar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜੋ ਬਹੁਤ ਸੁੰਦਰ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "सुँदर कुमार ॥",
      "sourceLineId": "101017",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਬ ਜਰੇ ਸਰਬ ॥",
      "transliteration": "jab jare sarab ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸਾਰੇ ਸੜ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "जब जरे सरब ॥",
      "sourceLineId": "101018",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਬ ਤਜਾ ਗਰਬ ॥੭੫॥",
      "transliteration": "tab tajaa garab ||75||",
      "translation": "When those prices of great glory were burnt down then the pride of all was smashed.75.",
      "punjabiViakhya": "ਤਦ (ਉਨ੍ਰਹਾ ਨੇ) ਹੰਕਾਰ ਛਡ ਦਿੱਤਾ ॥੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "तब तजा गरब ॥७५॥",
      "sourceLineId": "101019",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਾਹੂ ਅਜਾਨ ॥",
      "transliteration": "baahoo ajaan ||",
      "translation": "",
      "punjabiViakhya": "ਸੜਦਿਆਂ (ਵੇਖ ਕੇ) (ਨਾਲ ਗਏ) ਗੋਡਿਆਂ ਤਕ ਬਾਹਵਾ ਵਾਲੇ,",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "बाहू अजान ॥",
      "sourceLineId": "101020",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੋਭਾ ਮਹਾਨ ॥",
      "transliteration": "sobhaa mahaan ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾਨ ਸ਼ੋਭਾ ਵਾਲੇ,",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "सोभा महान ॥",
      "sourceLineId": "101021",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦਸ ਚਾਰਿ ਵੰਤ ॥",
      "transliteration": "dhas chaar va(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਦਾ ਗੁਣਾ ਵਾਲੇ,",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "दस चारि वंत ॥",
      "sourceLineId": "101022",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੂਰਾ ਦੁਰੰਤ ॥੭੬॥",
      "transliteration": "sooraa dhura(n)t ||76||",
      "translation": "That most powerful Lord is extremely Glorious and the warriors of all the four directions fear Him.76.",
      "punjabiViakhya": "ਬੇਅੰਤ ਸੂਰਮਿਆਂ ਨੂੰ ॥੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "सूरा दुरंत ॥७६॥",
      "sourceLineId": "101023",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਾਰਿ ਭਾਜੇ ਬੀਰ ॥",
      "transliteration": "jaar bhaaje beer ||",
      "translation": "",
      "punjabiViakhya": "ਸੜਦਿਆਂ ਵੇਖ ਕੇ (ਨਾਲ ਗਏ) ਯੋਧੇ ਚਿਤ ਵਿਚ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "जारि भाजे बीर ॥",
      "sourceLineId": "101024",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹੁਐ ਚਿਤਿ ਅਧੀਰ ॥",
      "transliteration": "huaai chit adheer ||",
      "translation": "",
      "punjabiViakhya": "ਅਧੀਰ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "हुऐ चिति अधीर ॥",
      "sourceLineId": "101025",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦਿਨੋ ਸੰਦੇਸ ॥",
      "transliteration": "dhino sa(n)dhes ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਾ ਕੇ (ਰਾਜਕੁਮਾਰਾ ਦੀ ਸਥਿਤੀ ਦਾ) ਸੰਦੇਸ਼ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "दिनो संदेस ॥",
      "sourceLineId": "101026",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਹ ਸਾਗਰ ਦੇਸ ॥੭੭॥",
      "transliteration": "jeh saagar dhes ||77||",
      "translation": "Some warriors who had been burnt, ran impatiently towards the king and they conveyed the whole thing to the king sagar.77.",
      "punjabiViakhya": "ਜਿਥੇ ਸਗਰ ਰਾਜਾ ਦੇਸ਼ (ਵਿਚ ਬੈਠਾ ਯੱਗ ਕਰ ਰਿਹਾ ਸੀ) ॥੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "जह सागर देस ॥७७॥",
      "sourceLineId": "101027",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਲਹਿ ਸਾਗਰ ਬੀਰ ॥",
      "transliteration": "leh saagar beer ||",
      "translation": "",
      "punjabiViakhya": "ਸਗਰ ਨੇ (ਉਨ੍ਰਹਾ) ਸੂਰਮਿਆਂ ਨੂੰ (ਪਛਾਣ) ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "लहि सागर बीर ॥",
      "sourceLineId": "101028",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹ੍ਵੈ ਚਿਤਿ ਅਧੀਰ ॥",
      "transliteration": "havai chit adheer ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਚਿਤ ਵਿਚ ਅਧੀਰ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "ह्वै चिति अधीर ॥",
      "sourceLineId": "101029",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪੁਛੇ ਸੰਦੇਸ ॥",
      "transliteration": "puchhe sa(n)dhes ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੁੱਤਰਾ ਦਾ ਹਾਲ ਚਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "पुछे संदेस ॥",
      "sourceLineId": "101030",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪੂਤਨ ਸੁਬੇਸ ॥੭੮॥",
      "transliteration": "pootan subes ||78||",
      "translation": "When the king sagar saw this, he impatiently asked the news about his sons.78.",
      "punjabiViakhya": "ਅਤੇ ਸੰਦੇਸ਼ ਪੁੱਛਣ ਲਗਾ ॥੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "पूतन सुबेस ॥७८॥",
      "sourceLineId": "101031",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਰਿ ਜੋਰਿ ਸਰਬ ॥",
      "transliteration": "kar jor sarab ||",
      "translation": "",
      "punjabiViakhya": "ਅਭਿਮਾਨ ਨੂੰ ਛਡ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "करि जोरि सरब ॥",
      "sourceLineId": "101032",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭਟ ਛੋਰਿ ਗਰਬ ॥",
      "transliteration": "bhaT chhor garab ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੱਥ ਜੋੜ ਕੇ (ਸੂਰਮਿਆਂ ਨੇ)",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "भट छोरि गरब ॥",
      "sourceLineId": "101033",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਉਚਰੇ ਬੈਨ ॥",
      "transliteration": "auchare bain ||",
      "translation": "",
      "punjabiViakhya": "ਬਚਨ ਉਚਾਰੇ (ਪਰ ਉਨ੍ਰਹਾ ਦੀਆਂ) ਅੱਖਾ ਵਿਚ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "उचरे बैन ॥",
      "sourceLineId": "101034",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਲ ਚੁਅਤ ਨੈਨ ॥੭੯॥",
      "transliteration": "jal chuat nain ||79||",
      "translation": "Then all of them talked about their strength and also said how the pried of those warriors was destroyed, the tears were flowing from their eyes while saying this.79.",
      "punjabiViakhya": "ਹੰਝੂ ਡਿਗਦੇ ਸਨ ॥੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "जल चुअत नैन ॥७९॥",
      "sourceLineId": "101035",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭੂਅ ਫੇਰਿ ਬਾਜ ॥",
      "transliteration": "bhooa fer baaj ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸ੍ਰੇਸ਼ਠ ਅਤੇ ਪ੍ਰਬੀਨ ਰਾਜੇ!",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "भूअ फेरि बाज ॥",
      "sourceLineId": "101036",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਿਣਿ ਸਰਬ ਰਾਜ ॥",
      "transliteration": "jin sarab raaj ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ ਸਾਰੀ) ਭੂਮੀ ਉਤੇ ਯੱਗ ਘੋੜਾ ਫਿਰਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "जिणि सरब राज ॥",
      "sourceLineId": "101037",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਬ ਸੰਗ ਲੀਨ ॥",
      "transliteration": "sab sa(n)g leen ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਰਾਜਿਆਂ ਨੂੰ ਜਿਤ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "सब संग लीन ॥",
      "sourceLineId": "101038",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨ੍ਰਿਪ ਬਰ ਪ੍ਰਬੀਨ ॥੮੦॥",
      "transliteration": "nirap bar prabeen ||80||",
      "translation": "The messengers told this that his sons, causing their horse to move on all the earth, had conquered all the kings and had taken them along with themselves.80.",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਨਾਲ ਮਿਲਾ ਲਿਆ ॥੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "नृप बर प्रबीन ॥८०॥",
      "sourceLineId": "101039",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹਯ ਗਯੋ ਪਯਾਰ ॥",
      "transliteration": "hay gayo payaar ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਘੋੜਾ ਪਾਤਾਲ ਚਲਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "हय गयो पयार ॥",
      "sourceLineId": "101040",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤੁਅ ਸੁਤ ਉਦਾਰ ॥",
      "transliteration": "tua sut udhaar ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਰੇ ਉਦਾਰ ਪੁੱਤਰਾ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "तुअ सुत उदार ॥",
      "sourceLineId": "101041",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭੂਅ ਖੋਦ ਸਰਬ ॥",
      "transliteration": "bhooa khodh sarab ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਧਰਤੀ ਨੂੰ ਪੁਟ ਸੁਟਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "भूअ खोद सरब ॥",
      "sourceLineId": "101042",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਤਿ ਬਢਾ ਗਰਬ ॥੮੧॥",
      "transliteration": "at baddaa garab ||81||",
      "translation": "Your sons, thinking that the horse had gone to the nether-world, had dug the whole of the earth and in this way, their pride had enormously increased.81.",
      "punjabiViakhya": "ਅਤੇ (ਉਨ੍ਰਹਾ ਦਾ) ਹੰਕਾਰ ਬਹੁਤ ਵਧ ਗਿਆ ॥੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "अति बढा गरब ॥८१॥",
      "sourceLineId": "101043",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਹੰ ਮੁਨਿ ਅਪਾਰ ॥",
      "transliteration": "taha(n) mun apaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ (ਇਕ) ਅਪਾਰ (ਸ਼ਕਤੀ ਵਾਲਾ) ਮੁਨੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "तहं मुनि अपार ॥",
      "sourceLineId": "101044",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗੁਨਿ ਗਨ ਉਦਾਰ ॥",
      "transliteration": "gun gan udhaar ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਉਦਾਰਤਾ ਵਾਲੇ ਗੁਣਾ ਨਾਲ ਵਰੁਸਾਇਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "गुनि गन उदार ॥",
      "sourceLineId": "101045",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਲਖਿ ਮਧ ਧ੍ਯਾਨ ॥",
      "transliteration": "lakh madh dhayaan ||",
      "translation": "",
      "punjabiViakhya": "ਧਿਆਨ ਵਿਚ ਮਗਨ ਜਾਣ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "लखि मध ध्यान ॥",
      "sourceLineId": "101046",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮੁਨਿ ਮਨਿ ਮਹਾਨ ॥੮੨॥",
      "transliteration": "mun man mahaan ||82||",
      "translation": "There all of them saw themost glorious sage (Kapila) absorbed in meditation.82.",
      "punjabiViakhya": "(ਉਸ) ਮਹਾਨ ਮਨ ਵਾਲੇ ਮੁਨੀ ਨੂੰ ॥੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "मुनि मनि महान ॥८२॥",
      "sourceLineId": "101047",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਵ ਪੁਤ੍ਰ ਕ੍ਰੋਧ ॥",
      "transliteration": "tav putr krodh ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਰੇ ਪੁੱਤਰਾ ਨੇ ਕ੍ਰੋਧ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "तव पुत्र क्रोध ॥",
      "sourceLineId": "101048",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਲੈ ਸੰਗਿ ਜੋਧ ॥",
      "transliteration": "lai sa(n)g jodh ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਯੋਧਿਆਂ ਨੂੰ ਨਾਲ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "लै संगि जोध ॥",
      "sourceLineId": "101049",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0620_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਲਤਾ ਪ੍ਰਹਾਰ ॥",
      "transliteration": "lataa prahaar ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਨੀ ਉਤੇ ਲਤਾ ਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 620,
      "hindi": "",
      "hindiTransliteration": "लता प्रहार ॥",
      "sourceLineId": "101050",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
