{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 621,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0621_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕੀਅ ਰਿਖਿ ਅਪਾਰ ॥੮੩॥",
      "transliteration": "keea rikh apaar ||83||",
      "translation": "Your sons, taking the warriors with them, hit that sage with their legs.83.",
      "punjabiViakhya": "ਬਹੁਤ ਮਾਰ ਕੀਤੀ ॥੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "कीअ रिखि अपार ॥८३॥",
      "sourceLineId": "101051",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਬ ਛੁਟਾ ਧ੍ਯਾਨ ॥",
      "transliteration": "tab chhuTaa dhayaan ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਮਹਾਨ ਮਨ ਵਾਲੇ ਮੁਨੀ ਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "तब छुटा ध्यान ॥",
      "sourceLineId": "101052",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮੁਨਿ ਮਨਿ ਮਹਾਨ ॥",
      "transliteration": "mun man mahaan ||",
      "translation": "",
      "punjabiViakhya": "ਧਿਆਨ ਛੁਟ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "मुनि मनि महान ॥",
      "sourceLineId": "101053",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਿਕਸੀ ਸੁ ਜ੍ਵਾਲ ॥",
      "transliteration": "nikasee su javaiaal ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਉਸ ਦੀਆਂ ਅੱਖਾ ਵਿਚੋਂ) ਜੁਆਲਾ ਨਿਕਲੀ",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "निकसी सु ज्वाल ॥",
      "sourceLineId": "101054",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦਾਵਾ ਬਿਸਾਲ ॥੮੪॥",
      "transliteration": "dhaavaa bisaal ||84||",
      "translation": "Then the meditation of that great sage was shattered and a huge fire came out of his eyes.84.",
      "punjabiViakhya": "ਜੋ ਜੰਗਲ ਦੀ ਵਿਸ਼ਾਲ ਅੱਗ ਵਰਗੀ ਸੀ ॥੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "दावा बिसाल ॥८४॥",
      "sourceLineId": "101055",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਰੰ ਜਰੇ ਪੂਤ ॥",
      "transliteration": "tara(n) jare poot ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਦੂਤ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "तरं जरे पूत ॥",
      "sourceLineId": "101056",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਹਿ ਐਸੇ ਦੂਤ ॥",
      "transliteration": "keh aaise dhoot ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਉਥੇ (ਤੁਹਾਡੇ) ਪੁੱਤਰ",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "कहि ऐसे दूत ॥",
      "sourceLineId": "101057",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੈਨਾ ਸਮੇਤ ॥",
      "transliteration": "sainaa samet ||",
      "translation": "",
      "punjabiViakhya": "ਸੈਨਾ ਸਮੇਤ ਸੜ ਗਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "सैना समेत ॥",
      "sourceLineId": "101058",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਾਚਾ ਨ ਏਕ ॥੮੫॥",
      "transliteration": "baachaa na ek ||85||",
      "translation": "The messenger told, “O king Sagar! in this way all your sons were burnt and reduced to ashes alongwith their army and not even one of them survived.”85.",
      "punjabiViakhya": "(ਕੋਈ) ਇਕ ਵੀ ਨਹੀਂ ਬਚਿਆ ਹੈ ॥੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "बाचा न एक ॥८५॥",
      "sourceLineId": "101059",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੁਨਿ ਪੁਤ੍ਰ ਨਾਸ ॥",
      "transliteration": "sun putr naas ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਪੁੱਤਰਾ ਦਾ ਨਾਸ਼ ਸੁਣ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "सुनि पुत्र नास ॥",
      "sourceLineId": "101060",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭਯੋ ਪੁਰਿ ਉਦਾਸ ॥",
      "transliteration": "bhayo pur udhaas ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਾ ਨਗਰ ਉਦਾਸ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "भयो पुरि उदास ॥",
      "sourceLineId": "101061",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਹ ਤਹ ਸੁ ਲੋਗ ॥",
      "transliteration": "jeh teh su log ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ (ਉਥੋਂ ਦੇ) ਲੋਕ (ਪ੍ਰਜਾ)",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "जह तह सु लोग ॥",
      "sourceLineId": "101062",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬੈਠੇ ਸੁ ਸੋਗ ॥੮੬॥",
      "transliteration": "baiThe su sog ||86||",
      "translation": "Hearing about the destruction of his sons, the whole city was steeped in sorrow and all the people here and there were filled with anguish.86.",
      "punjabiViakhya": "ਸੋਗ ਵਿਚ ਡੁਬੇ ਬੈਠੇ ਸਨ ॥੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "बैठे सु सोग ॥८६॥",
      "sourceLineId": "101063",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਿਵ ਸਿਮਰ ਬੈਣ ॥",
      "transliteration": "siv simar bain ||",
      "translation": "",
      "punjabiViakhya": "(ਅੰਤ ਵਿਚ ਸਗਰ ਰਾਜੇ ਨੇ) 'ਸ਼ਿਵ ਸ਼ਿਵ' ਬਚਨ ਸਿਮਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "सिव सिमर बैण ॥",
      "sourceLineId": "101064",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਲ ਥਾਪਿ ਨੈਣ ॥",
      "transliteration": "jal thaap nain ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅੱਖਾ ਦੇ ਹੰਝੂ ਰੋਕ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "जल थापि नैण ॥",
      "sourceLineId": "101065",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਰਿ ਧੀਰਜ ਚਿਤਿ ॥",
      "transliteration": "kar dheeraj chit ||",
      "translation": "",
      "punjabiViakhya": "ਚਿਤ ਵਿਚ ਧੀਰਜ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "करि धीरज चिति ॥",
      "sourceLineId": "101066",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੁਨਿ ਮਨਿ ਪਵਿਤ ॥੮੭॥",
      "transliteration": "mun man pavit ||87||",
      "translation": "All of them, remembering Shiva, withholding their tears assumed patience in their minds with the holy saying of the sages.87.",
      "punjabiViakhya": "ਅਤੇ ਮੁਨੀ ਵਾਗ ਮਨ ਨੂੰ ਪਵਿਤ੍ਰ ਕੀਤਾ ॥੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "मुनि मनि पवित ॥८७॥",
      "sourceLineId": "101067",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਿਨ ਮ੍ਰਿਤਕ ਕਰਮ ॥",
      "transliteration": "tin mritak karam ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਉਨ੍ਰਹਾ (ਪੁੱਤਰਾ ਦੇ)",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "तिन मृतक करम ॥",
      "sourceLineId": "101068",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨ੍ਰਿਪ ਕਰਮ ਧਰਮ ॥",
      "transliteration": "nirap karam dharam ||",
      "translation": "",
      "punjabiViakhya": "ਮ੍ਰਿਤਕ ਕਰਮ",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "नृप करम धरम ॥",
      "sourceLineId": "101069",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਹੁ ਬੇਦ ਰੀਤਿ ॥",
      "transliteration": "bahu bedh reet ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵੇਦ ਰੀਤ ਅਨੁਸਾਰ",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "बहु बेद रीति ॥",
      "sourceLineId": "101070",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਿਨੀ ਸੁ ਪ੍ਰੀਤਿ ॥੮੮॥",
      "transliteration": "kinee su preet ||88||",
      "translation": "Then the king performed the last funeral rites of all affectionately according to Vedic injunctions.88.",
      "punjabiViakhya": "ਹੋਰ ਧਰਮਕਰਮ ਬੜੀ ਪ੍ਰੀਤ ਨਾਲ ਕੀਤੇ ॥੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "किनी सु प्रीति ॥८८॥",
      "sourceLineId": "101071",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨ੍ਰਿਪ ਪੁਤ੍ਰ ਸੋਗ ॥",
      "transliteration": "nirap putr sog ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਪੁੱਤਰਾ ਦੇ ਸੋਗ ਵਿਚ ਹੀ",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "नृप पुत्र सोग ॥",
      "sourceLineId": "101072",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗਯੇ ਸੁਰਗ ਲੋਗਿ ॥",
      "transliteration": "gaye surag log ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਸਵਰਗ ਲੋਕ ਨੂੰ ਚਲਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "गये सुरग लोगि ॥",
      "sourceLineId": "101073",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨ੍ਰਿਪ ਭੇ ਸੁ ਜੌਨ ॥",
      "transliteration": "nirap bhe su jauan ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਪ੍ਰਕਾਰ ਦੇ) ਜਿਹੜੇ (ਹੋਰ) ਰਾਜੇ ਹੋਏ,",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "नृप भे सु जौन ॥",
      "sourceLineId": "101074",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਥਿ ਸਕੈ ਕੌਨ ॥੮੯॥",
      "transliteration": "kath sakai kauan ||89||",
      "translation": "In his extreme sorrow on the demise of his sons, the king left for heaven and after him, there were several other kings, who can describe them?89.",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦਾ) ਕਥਨ ਕੌਣ ਕਰ ਸਕਦਾ ਹੈ? ॥੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "कथि सकै कौन ॥८९॥",
      "sourceLineId": "101075",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਇਤਿ ਰਾਜਾ ਸਾਗਰ ਕੋ ਰਾਜ ਸਮਾਪਤੰ ॥੪॥੫॥",
      "transliteration": "eit raajaa saagar ko raaj samaapata(n) ||4||5||",
      "translation": "End of the description of Vyas, the incrnation of Brahma and the rule of king Prithu in Bachittar Natak.",
      "punjabiViakhya": "ਇਥੇ ਰਾਜਾ ਸਗਰ ਦੇ ਰਾਜ ਦੀ ਸਮਾਪਤੀ। ਹੁਣ ਜੁਜਾਤਿ ਰਾਜੇ ਦੇ ਰਾਜ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "इति राजा सागर को राज समापतं ॥४॥५॥",
      "sourceLineId": "101076",
      "sourceShabadId": "9299",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਥ ਜੁਜਾਤਿ ਰਾਜਾ ਕੋ ਰਾਜ ਕਥਨੰ",
      "transliteration": "ath jujaat raajaa ko raaj kathana(n)",
      "translation": "Now begins the description about king Yayati",
      "punjabiViakhya": "ਹੁਣ ਜੁਜਾਤਿ ਦੇ ਰਾਜ ਦਾ ਕਥਨ:",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "अथ जुजाति राजा को राज कथनं",
      "sourceLineId": "101077",
      "sourceShabadId": "9300",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਧੁਭਾਰ ਛੰਦ ॥",
      "transliteration": "madhubhaar chha(n)dh ||",
      "translation": "MADHUBHAAR STANZA",
      "punjabiViakhya": "ਮਧੁਭਾਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "मधुभार छंद ॥",
      "sourceLineId": "101078",
      "sourceShabadId": "9300",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪੁਨਿ ਭਯੋ ਜੁਜਾਤਿ ॥",
