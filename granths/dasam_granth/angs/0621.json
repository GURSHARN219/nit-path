      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "सोभत सुधार ॥९१॥",
      "sourceLineId": "101086",
      "sourceShabadId": "9300",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0621_line_0037",
