      "transliteration": "sobhaa apaar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਹ ਰਾਜਕੁਮਾਰ ਅਪਾਰ",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "सोभा अपार ॥",
      "sourceLineId": "101097",
      "sourceShabadId": "9300",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
