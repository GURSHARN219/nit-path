      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "क्रोधी प्रचंड ॥९६॥",
      "sourceLineId": "101106",
      "sourceShabadId": "9300",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
