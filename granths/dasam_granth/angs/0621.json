      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "सोभंत भूप ॥",
      "sourceLineId": "101088",
      "sourceShabadId": "9300",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
