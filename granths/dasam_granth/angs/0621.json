      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "खूनी सु खग ॥",
      "sourceLineId": "101103",
      "sourceShabadId": "9300",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
