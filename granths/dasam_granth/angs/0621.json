      "punjabiViakhya": "(ਉਹ) ਚੌਦਾ ਵਿਦਿਆਵਾ ਦਾ ਗਿਆਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "दस चारवंत ॥",
      "sourceLineId": "101089",
