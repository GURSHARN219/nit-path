      "source": "DASAM_GRANTH",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": "नृप भयो बेन ॥",
      "sourceLineId": "101101",
      "sourceShabadId": "9300",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
