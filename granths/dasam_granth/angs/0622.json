{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 622,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0622_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚਚਕਤ ਚੰਦ ॥",
      "transliteration": "chachakat cha(n)dh ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਰਾਜੇ ਨੂੰ ਵੇਖ ਕੇ) ਚੰਦ੍ਰਮਾ ਚਕਾ-ਚੌਂਧ ਮੰਨਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "चचकत चंद ॥",
      "sourceLineId": "101123",
      "sourceShabadId": "9300",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਧਧਕਤ ਇੰਦ ॥",
      "transliteration": "dhadhakat i(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਇੰਦਰ (ਦਾ ਹਿਰਦਾ) ਧੜਕਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "धधकत इंद ॥",
      "sourceLineId": "101124",
      "sourceShabadId": "9300",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਫਨਿਮਨ ਫਟੰਤ ॥",
      "transliteration": "faniman faTa(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੇਸ਼ਨਾਗ ਫਣਾ ਨੂੰ (ਧਰਤੀ ਉਤੇ) ਪਟਕਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "फनिमन फटंत ॥",
      "sourceLineId": "101125",
      "sourceShabadId": "9300",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭੂਅਧਰ ਭਜੰਤ ॥੧੦੧॥",
      "transliteration": "bhooadhar bhaja(n)t ||101||",
      "translation": "The moon stood wonder-stuck in his presence, the heart of Indra throbbed violently, the ganas were destroyed and the mountains also fled away.101.",
      "punjabiViakhya": "ਅਤੇ ਪਰਬਤ (ਭੂਧਰ) ਨਸ ਰਹੇ ਸਨ ॥੧੦੧॥",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "भूअधर भजंत ॥१०१॥",
      "sourceLineId": "101126",
      "sourceShabadId": "9300",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੰਜੁਤਾ ਛੰਦ ॥",
      "transliteration": "sa(n)jutaa chha(n)dh ||",
      "translation": "SANYUKTA STANZA",
      "punjabiViakhya": "ਸੰਜੁਤਾ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "संजुता छंद ॥",
      "sourceLineId": "101127",
      "sourceShabadId": "9301",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਸ ਠੌਰ ਠੌਰ ਸਬੋ ਸੁਨ੍ਯੋ ॥",
      "transliteration": "jas Thauar Thauar sabo sunayo ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਨੇ ਥਾ ਥਾ (ਰਾਜੇ ਦਾ) ਯਸ਼ ਸੁਣ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "जस ठौर ठौर सबो सुन्यो ॥",
      "sourceLineId": "101128",
      "sourceShabadId": "9301",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਰਿ ਬ੍ਰਿੰਦ ਸੀਸ ਸਬੋ ਧੁਨ੍ਰਯੋ ॥",
      "transliteration": "ar bira(n)dh sees sabo dhunrayo ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਵੈਰੀਆਂ ਦੇ ਸਮੂਹਾ ਨੇ ਸਿਰ ਧੁਣ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "अरि बृंद सीस सबो धुन्रयो ॥",
      "sourceLineId": "101129",
      "sourceShabadId": "9301",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਗ ਜਗ ਸਾਜ ਭਲੇ ਕਰੇ ॥",
      "transliteration": "jag jag saaj bhale kare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਜਗਤ ਵਿਚ ਚੰਗੇ ਯੱਗਾ ਦੀ ਵਿਵਸਥਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "जग जग साज भले करे ॥",
      "sourceLineId": "101130",
      "sourceShabadId": "9301",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੁਖ ਪੁੰਜ ਦੀਨਨ ਕੇ ਹਰੇ ॥੧੦੨॥",
      "transliteration": "dhukh pu(n)j dheenan ke hare ||102||",
      "translation": "Everyone heard his praise at many places and the enemies, listening to his praises would become fearful and suffer mental agony, he removed the afficions of the poor by performing the Yajnas in a nice manner.102.",
      "punjabiViakhya": "ਅਤੇ ਦੀਨਾ (ਆਜਿਜ਼ਾ) ਦੇ ਦੁਖ ਹਰ ਲਏ ॥੧੦੨॥",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "दुख पुँज दीनन के हरे ॥१०२॥",
      "sourceLineId": "101131",
      "sourceShabadId": "9301",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਤਿ ਜੁਜਾਤਿ ਰਾਜਾ ਮ੍ਰਿਤ ਬਸਿ ਹੋਤ ਭਏ ॥੫॥੫॥",
      "transliteration": "eit jujaat raajaa mirat bas hot bhe ||5||5||",
      "translation": "End of the description about king Yayati and his death.",
      "punjabiViakhya": "ਇਥੇ ਜੁਜਾਤਿ ਰਾਜਾ ਮ੍ਰਿਤੂ ਦੇ ਵਸ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "इति जुजाति राजा मृत बसि होत भए ॥५॥५॥",
      "sourceLineId": "101132",
      "sourceShabadId": "9301",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਥ ਬੇਨ ਰਾਜੇ ਕੋ ਰਾਜ ਕਥਨੰ ॥",
      "transliteration": "ath ben raaje ko raaj kathana(n) ||",
      "translation": "Now begins the description about the rule of king Ben",
      "punjabiViakhya": "ਸੰਜੁਤਾ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "अथ बेन राजे को राज कथनं ॥",
      "sourceLineId": "101133",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੰਜੁਤਾ ਛੰਦ ॥",
      "transliteration": "sa(n)jutaa chha(n)dh ||",
      "translation": "SANYUKTA STANZA",
      "punjabiViakhya": "ਹੁਣ ਬੇਨ ਦੇ ਰਾਜ ਦਾ ਕਥਨ:",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "संजुता छंद ॥",
      "sourceLineId": "101134",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪੁਨਿ ਬੇਣੁ ਰਾਜ ਮਹੇਸ ਭਯੋ ॥",
      "transliteration": "pun ben raaj mahes bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਬੇਨੁ ਧਰਤੀ ਦਾ ਰਾਜਾ ਬਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "पुनि बेणु राज महेस भयो ॥",
      "sourceLineId": "101135",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਿਜਿ ਡੰਡ ਕਾਹੂੰ ਤੇ ਨ ਲਯੋ ॥",
      "transliteration": "nij dda(n)dd kaahoo(n) te na layo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਆਪ ਕਿਸੇ ਤੋਂ ਦੰਡ ਨਹੀਂ ਲਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "निजि डंड काहूँ ते न लयो ॥",
      "sourceLineId": "101136",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜੀਅ ਭਾਤਿ ਭਾਤਿ ਸੁਖੀ ਨਰਾ ॥",
      "transliteration": "jeea bhaat bhaat sukhee naraa ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦੇ ਜੀਵ ਅਤੇ ਮਨੁੱਖ ਸੁਖੀ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "जीअ भाति भाति सुखी नरा ॥",
      "sourceLineId": "101137",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਤਿ ਗਰਬ ਸ੍ਰਬ ਛੁਟਿਓ ਧਰਾ ॥੧੦੩॥",
      "transliteration": "at garab srab chhuTio dharaa ||103||",
      "translation": "Then Ben became the king of the earth, he never charged tax from anyone, the beings were happy in various ways and none had any pride in him.103.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਨੇ ਮਨ ਤੋਂ ਹੰਕਾਰ ਨੂੰ ਕੱਢ ਦਿੱਤਾ ਸੀ ॥੧੦੩॥",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "अति गरब स्रब छुटिओ धरा ॥१०३॥",
      "sourceLineId": "101138",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਸਬ ਦਿਖਿਯਤ ਸੁਖੀ ॥",
      "transliteration": "jeea ja(n)t sab dhikhiyat sukhee ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਜੀਵ ਜੰਤ ਸੁਖੀ ਦਿਸਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "जीअ जंत सब दिखियत सुखी ॥",
      "sourceLineId": "101139",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਰਿ ਦ੍ਰਿਸਟਿ ਆਵਤ ਨ ਦੁਖੀ ॥",
      "transliteration": "tar dhirasaT aavat na dhukhee ||",
      "translation": "",
      "punjabiViakhya": "ਕੋਈ ਵੀ ਦੁਖੀ ਨਜ਼ਰ ਨਹੀਂ ਸੀ ਆਉਾਂਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "तरि दृसटि आवत न दुखी ॥",
      "sourceLineId": "101140",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਬ ਠੌਰ ਠੌਰ ਪ੍ਰਿਥੀ ਬਸੀ ॥",
      "transliteration": "sab Thauar Thauar pirathee basee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਧਰਤੀ ਥਾ ਥਾ ਤੇ ਚੰਗੀ ਤਰ੍ਰਹਾ ਵਸ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "सब ठौर ठौर पृथी बसी ॥",
      "sourceLineId": "101141",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਨੁ ਭੂਮਿ ਰਾਜ ਸਿਰੀ ਲਸੀ ॥੧੦੪॥",
      "transliteration": "jan bhoom raaj siree lasee ||104||",
      "translation": "The beings were happy in various ways and even the trees did not seem to have any suffering, there was praise of the king everywhere on the earth.104.",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਭੂਮੀ ਉਤੇ ਰਾਜ ਲਕਸ਼ਮੀ ਪ੍ਰਕਾਸ਼ਿਤ ਹੋ ਰਹੀ ਹੋਵੇ ॥੧੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "जनु भूमि राज सिरी लसी ॥१०४॥",
      "sourceLineId": "101142",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਰਾਜ ਕਮਾਇ ਕੈ ॥",
      "transliteration": "eeh bhaat raaj kamai kai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਰਾਜ ਕਮਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "इह भाति राज कमाइ कै ॥",
      "sourceLineId": "101143",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੁਖ ਦੇਸ ਸਰਬ ਬਸਾਇ ਕੈ ॥",
      "transliteration": "sukh dhes sarab basai kai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਦੇਸ਼ ਨੂੰ ਸੁਖ ਪੂਰਵਕ ਵਸਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "सुख देस सरब बसाइ कै ॥",
      "sourceLineId": "101144",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਹੁ ਦੋਖ ਦੀਨਨ ਕੇ ਦਹੇ ॥",
      "transliteration": "bahu dhokh dheenan ke dhahe ||",
      "translation": "",
      "punjabiViakhya": "ਦੀਨ (ਅਜਿਜ਼) ਲੋਕਾ ਦੇ ਬਹੁਤ ਦੁਖ ਨਸ਼ਟ ਕਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "बहु दोख दीनन के दहे ॥",
      "sourceLineId": "101145",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੁਨਿ ਥਕਤ ਦੇਵ ਸਮਸਤ ਭਏ ॥੧੦੫॥",
      "transliteration": "sun thakat dhev samasat bhe ||105||",
      "translation": "In this way, keeping all his country happy, the king removed many afflictions of the lowly and seeing his splendour, all the gods also appreciated him.105.",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ) ਸੁਣ ਕੇ ਸਾਰੇ ਦੇਵਤੇ ਥਕ ਗਏ ॥੧੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "सुनि थकत देव समसत भए ॥१०५॥",
      "sourceLineId": "101146",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਹੁ ਰਾਜ ਸਾਜ ਕਮਾਇ ਕੈ ॥",
      "transliteration": "bahu raaj saaj kamai kai ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਸਮੇਾਂ ਤਕ ਰਾਜ ਸਮਾਜ ਕਮਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "बहु राज साज कमाइ कै ॥",
      "sourceLineId": "101147",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਿਰਿ ਅਤ੍ਰਪਤ੍ਰ ਫਿਰਾਇ ਕੈ ॥",
      "transliteration": "sir atrapatr firai kai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਿਰ ਉਤੇ ਛਤ੍ਰ ਫਿਰਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "सिरि अत्रपत्र फिराइ कै ॥",
      "sourceLineId": "101148",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪੁਨਿ ਜੋਤਿ ਜੋਤਿ ਬਿਖੈ ਮਿਲੀ ॥",
      "transliteration": "pun jot jot bikhai milee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਜੋਤਿ (ਪਰਮਸੱਤਾ ਦੀ) ਜੋਤਿ ਵਿਚ ਮਿਲ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "पुनि जोति जोति बिखै मिली ॥",
      "sourceLineId": "101149",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਰਿ ਛੈਨੁ ਬੇਨੁ ਮਹਾਬਲੀ ॥੧੦੬॥",
      "transliteration": "ar chhain ben mahaabalee ||106||",
      "translation": "Ruling for a very long time and getting the canopy swung over his head, the light of the soul of that mighty king Ben merged in the Supreme Light of the Lord.106.",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਵੈਰੀਆਂ ਦਾ ਨਾਸ਼ ਕਰਨ ਵਾਲਾ ਮਹਾਨ ਬਲੀ ਰਾਜਾ ਬੇਨ (ਹੋਇਆ) ॥੧੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "अरि छैनु बेनु महाबली ॥१०६॥",
      "sourceLineId": "101150",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਬਿਕਾਰ ਭੂਪ ਜਿਤੇ ਭਏ ॥",
      "transliteration": "abikaar bhoop jite bhe ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਕਾਰਾ ਤੋਂ ਰਹਿਤ ਜਿਤਨੇ ਵੀ ਰਾਜੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "अबिकार भूप जिते भए ॥",
      "sourceLineId": "101151",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਰਿ ਰਾਜ ਅੰਤ ਸਮੈ ਗਏ ॥",
      "transliteration": "kar raaj a(n)t samai ge ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਰਾਜ ਕਰ ਕੇ ਅੰਤ ਨੂੰ (ਪਰਮਾਤਮਾ ਵਿਚ) ਸਮਾ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "करि राज अंत समै गए ॥",
      "sourceLineId": "101152",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਬਿ ਕੌਨ ਨਾਮ ਤਿਨੈ ਗਨੈ ॥",
      "transliteration": "kab kauan naam tinai ganai ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਨਾ ਕਿਹੜਾ ਕਵੀ ਗਿਣ ਸਕਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "कबि कौन नाम तिनै गनै ॥",
      "sourceLineId": "101153",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੰਕੇਤ ਕਰਿ ਇਤੇ ਭਨੈ ॥੧੦੭॥",
      "transliteration": "sa(n)ket kar ite bhanai ||107||",
      "translation": "All the immaculate kings ultimately merged in the Lord after their rule, which poet can enumerate their names? Therefore, I have only hinted about them.107.",
      "punjabiViakhya": "ਸੰਕੇਤ ਮਾਤਰ ਇਥੇ ਕਹਿ ਦਿੱਤੇ ਹਨ ॥੧੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "संकेत करि इते भनै ॥१०७॥",
      "sourceLineId": "101154",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਇਤਿ ਬੇਨੁ ਰਾਜਾ ਮ੍ਰਿਤ ਬਸ ਹੋਤ ਭਏ ॥੬॥੫॥",
      "transliteration": "eit ben raajaa mirat bas hot bhe ||6||5||",
      "translation": "End of the description about the king Ben and his death.",
      "punjabiViakhya": "ਇਥੇ ਬੇਨੁ ਰਾਜਾ ਮ੍ਰਿਤੂ ਦੇ ਵਸ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "इति बेनु राजा मृत बस होत भए ॥६॥५॥",
      "sourceLineId": "101155",
      "sourceShabadId": "9302",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਥ ਮਾਨਧਾਤਾ ਕੋ ਰਾਜੁ ਕਥਨੰ",
      "transliteration": "ath maanadhaataa ko raaj kathana(n)",
      "translation": "Now beings the description about the rule of Mandhata",
      "punjabiViakhya": "ਹੁਣ ਮਾਨਧਾਤਾ ਦੇ ਰਾਜ ਦਾ ਕਥਨ:",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "अथ मानधाता को राजु कथनं",
      "sourceLineId": "101156",
      "sourceShabadId": "9303",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੋਧਕ ਛੰਦ ॥",
      "transliteration": "dhodhak chha(n)dh ||",
      "translation": "DODHAK STANZA",
      "punjabiViakhya": "ਦੋਧਕ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "दोधक छंद ॥",
      "sourceLineId": "101157",
      "sourceShabadId": "9303",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜੇਤਕ ਭੂਪ ਭਏ ਅਵਨੀ ਪਰ ॥",
      "transliteration": "jetak bhoop bhe avanee par ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ ਉਤੇ ਜਿਤਨੇ ਕੁ ਰਾਜੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "जेतक भूप भए अवनी पर ॥",
      "sourceLineId": "101158",
      "sourceShabadId": "9303",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਮ ਸਕੈ ਤਿਨ ਕੇ ਕਵਿ ਕੋ ਧਰਿ ॥",
      "transliteration": "naam sakai tin ke kav ko dhar ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਨਾ ਕਿਹੜਾ ਕਵੀ ਗਿਣ ਸਕਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "नाम सकै तिन के कवि को धरि ॥",
      "sourceLineId": "101159",
      "sourceShabadId": "9303",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਾਮ ਜਥਾਮਤਿ ਭਾਖਿ ਸੁਨਾਊ ॥",
      "transliteration": "naam jathaamat bhaakh sunaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੀ ਬੁੱਧੀ ਦੇ ਬਲ ਤੇ (ਉਨ੍ਰਹਾ ਦੇ) ਨਾ ਸੁਣਾਉਾਂਦਾ ਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "नाम जथामति भाखि सुनाऊ ॥",
      "sourceLineId": "101160",
      "sourceShabadId": "9303",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚਿਤ ਤਊ ਅਪਨੇ ਡਰ ਪਾਊ ॥੧੦੮॥",
      "transliteration": "chit tuoo apane ddar paauoo ||108||",
      "translation": "All the kings who have ruled over the earth, which poet can describe their names? I fear the increase of this volume by narrating their names.108.",
      "punjabiViakhya": "(ਪਰ ਫਿਰ ਵੀ) ਆਪਣੇ ਮਨ ਵਿਚ ਡਰ ਮੰਨਦਾ ਹਾ ॥੧੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "चित तऊ अपने डर पाऊ ॥१०८॥",
      "sourceLineId": "101161",
      "sourceShabadId": "9303",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬੇਨੁ ਗਏ ਜਗ ਤੇ ਨ੍ਰਿਪਤਾ ਕਰਿ ॥",
      "transliteration": "ben ge jag te nirapataa kar ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਬੇਨ ਜਗਤ ਉਤੇ ਰਾਜ ਕਰ ਕੇ ਚਲਿਆ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "बेनु गए जग ते नृपता करि ॥",
      "sourceLineId": "101162",
      "sourceShabadId": "9303",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮਾਨਧਾਤ ਭਏ ਬਸੁਧਾ ਧਰਿ ॥",
      "transliteration": "maanadhaat bhe basudhaa dhar ||",
      "translation": "After the rule of Ben, Mandhata became the king",
      "punjabiViakhya": "(ਤਦ) ਧਰਤੀ ਨੂੰ ਧਾਰਨ ਕਰਨ ਲਈ ਮਾਨਧਾਤਾ (ਰਾਜਾ) ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "मानधात भए बसुधा धरि ॥",
      "sourceLineId": "101163",
      "sourceShabadId": "9303",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਾਸਵ ਲੋਗ ਗਏ ਜਬ ਹੀ ਵਹ ॥",
      "transliteration": "baasav log ge jab hee veh ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਇੰਦਰ ('ਬਾਸਵ') ਲੋਕ ਵਿਚ ਵਿਚਰਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "बासव लोग गए जब ही वह ॥",
      "sourceLineId": "101164",
      "sourceShabadId": "9303",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਉਠਿ ਦਯੋ ਅਰਧਾਸਨ ਬਾਸਵ ਤਿਹ ॥੧੦੯॥",
      "transliteration": "auTh dhayo aradhaasan baasav teh ||109||",
      "translation": "When he went to the country of Indra, Indra gave him half his seat.109.",
      "punjabiViakhya": "(ਤਦ) ਉਸ ਨੂੰ ਇੰਦਰ ਨੇ ਉਠ ਕੇ ਅੱਧਾ ਆਸਣ ਦਿੱਤਾ ॥੧੦੯॥",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "उठि दयो अरधासन बासव तिह ॥१०९॥",
      "sourceLineId": "101165",
      "sourceShabadId": "9303",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰੋਸ ਭਰ੍ਯੋ ਤਬ ਮਾਨ ਮਹੀਧਰ ॥",
      "transliteration": "ros bharayo tab maan maheedhar ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਮਾਨਧਾਤਾ ਰਾਜੇ ਦੇ (ਮਨ ਵਿਚ) ਕ੍ਰੋਧ ਭਰ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "रोस भर्यो तब मान महीधर ॥",
      "sourceLineId": "101166",
      "sourceShabadId": "9303",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹਾਕਿ ਗਹ੍ਰਯੋ ਕਰਿ ਖਗ ਭਯੰਕਰ ॥",
      "transliteration": "haak gahrayo kar khag bhaya(n)kar ||",
      "translation": "The king Mandhata was filled with rage and challenging him, held his dagger in his hand",
      "punjabiViakhya": "ਅਤੇ ਲਲਕਾਰਾ ਮਾਰ ਕੇ ਹੱਥ ਵਿਚ ਖੰਡਾ ਧਾਰਨ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "हाकि गह्रयो करि खग भयंकर ॥",
      "sourceLineId": "101167",
      "sourceShabadId": "9303",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਾਰਨ ਲਾਗ ਜਬੈ ਰਿਸ ਇੰਦ੍ਰਹਿ ॥",
      "transliteration": "maaran laag jabai ris i(n)dhreh ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਕ੍ਰੋਧ ਨਾਲ ਇੰਦਰ ਨੂੰ ਮਾਰਨ ਲਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "मारन लाग जबै रिस इंद्रहि ॥",
      "sourceLineId": "101168",
      "sourceShabadId": "9303",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਾਹ ਗਹੀ ਤਤਕਾਲ ਦਿਜਿੰਦ੍ਰਹਿ ॥੧੧੦॥",
      "transliteration": "baeh gahee tatakaal dhiji(n)dhreh ||110||",
      "translation": "When, in his fury, he was about to strike Indra, then Brihaspati immediately caught his hand.110.",
      "punjabiViakhya": "ਤਦ ਬ੍ਰਹਸਪਤੀ ('ਦਿਜਿੰਦ੍ਰ') ਨੇ ਉਸ ਦੀ ਬਾਹ ਪਕੜ ਲਈ ॥੧੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "बाह गही ततकाल दिजिंद्रहि ॥११०॥",
      "sourceLineId": "101169",
      "sourceShabadId": "9303",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0622_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਾਸ ਕਰੋ ਜਿਨਿ ਬਾਸਵ ਕੋ ਨ੍ਰਿਪ ॥",
      "transliteration": "naas karo jin baasav ko nirap ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ) ਹੇ ਰਾਜਨ! ਇੰਦਰ ਨੂੰ ਨਸ਼ਟ ਨਾ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": "नास करो जिनि बासव को नृप ॥",
      "sourceLineId": "101170",
      "sourceShabadId": "9303",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
