{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 624,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0624_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜੋਤਿਵੰਤ ਦਸ ਚਾਰਿ ਨਿਧਾਨਾ ॥੧੨੭॥",
      "transliteration": "jotiva(n)t dhas chaar nidhaanaa ||127||",
      "translation": "He had complete knowledge of Kok Shastra nd Smrities and he was expert in fourteen sciences.127.",
      "punjabiViakhya": "ਜੋਤਿਵਾਨ ਅਤੇ ਚੌਦਾ ਵਿਦਿਆਵਾ ਦਾ ਖ਼ਜ਼ਾਨਾ ਸੀ ॥੧੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "जोतिवंत दस चारि निधाना ॥१२७॥",
      "sourceLineId": "101243",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਹਾ ਕ੍ਰਮਠੀ ਮਹਾ ਸੁਜਾਨੂ ॥",
      "transliteration": "mahaa kramaThee mahaa sujaanoo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬਹੁਤ ਕਰਮਠ ਅਤੇ ਸੂਝਵਾਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "महा क्रमठी महा सुजानू ॥",
      "sourceLineId": "101244",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਹਾ ਜੋਤਿ ਦਸ ਚਾਰਿ ਨਿਧਾਨੂ ॥",
      "transliteration": "mahaa jot dhas chaar nidhaanoo ||",
      "translation": "He was a great hero and superb intellectual, he was the store of fourteen sciences",
      "punjabiViakhya": "ਬਹੁਤ ਤੇਜ ਵਾਲਾ ਅਤੇ ਚੌਦਾ ਵਿਦਿਆਵਾ ਦਾ ਨਿਧੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "महा जोति दस चारि निधानू ॥",
      "sourceLineId": "101245",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਤਿ ਸਰੂਪ ਅਰੁ ਅਮਿਤ ਪ੍ਰਭਾਸਾ ॥",
      "transliteration": "at saroop ar amit prabhaasaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਅਤਿਅੰਤਿ (ਸੁੰਦਰ) ਸਰੂਪ ਵਾਲਾ ਅਤੇ ਅਮਿਤ ਪ੍ਰਕਾਸ਼ ਵਾਲਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "अति सरूप अरु अमित प्रभासा ॥",
      "sourceLineId": "101246",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਹਾ ਮਾਨ ਅਰੁ ਮਹਾ ਉਦਾਸਾ ॥੧੨੮॥",
      "transliteration": "mahaa maan ar mahaa udhaasaa ||128||",
      "translation": "He was extremely charming and enormously glorious, he was also very proud and alongwith it, he was greatly deatched from the world.128.",
      "punjabiViakhya": "(ਉਹ) ਬਹੁਤ ਮਾਣ ਮਰਯਾਦਾ ਵਾਲਾ ਅਤੇ ਬਹੁਤ ਨਿਰਲਿਪਤ ਸੁਭਾ ਵਾਲਾ ਸੀ ॥੧੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "महा मान अरु महा उदासा ॥१२८॥",
      "sourceLineId": "101247",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬੇਦ ਅੰਗ ਖਟ ਸਾਸਤ੍ਰ ਪ੍ਰਬੀਨਾ ॥",
      "transliteration": "bedh a(n)g khaT saasatr prabeenaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਵੇਦਾ ਦੇ ਛੇ ਅੰਗ ਮੰਨੇ ਜਾਣ ਵਾਲੇ ਸ਼ਾਸਤ੍ਰਾ ਵਿਚ ਪ੍ਰਬੀਨ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "बेद अंग खट सासत्र प्रबीना ॥",
      "sourceLineId": "101248",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਧਨੁਰਬੇਦ ਪ੍ਰਭ ਕੇ ਰਸ ਲੀਨਾ ॥",
      "transliteration": "dhanurabedh prabh ke ras leenaa ||",
      "translation": "The king was expert in all Vedangs and six Shastras, he was the knower of the secret of Dhanurveda and also remained absorbed in the love of the Lord",
      "punjabiViakhya": "ਅਤੇ ਧਨੁਰ ਵੇਦ ਅਤੇ ਪ੍ਰਭੂ ਦੇ ਰਸ ਵਿਚ ਮਗਨ ਰਹਿਣ ਵਾਲਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "धनुरबेद प्रभ के रस लीना ॥",
      "sourceLineId": "101249",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਖੜਗਨ ਈਸ੍ਵਰ ਪੁਨਿ ਅਤੁਲ ਬਲ ॥",
      "transliteration": "khaRagan ieesavair pun atul bal ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਤਲਵਾਰ ਦਾ ਸੁਆਮੀ ਅਤੇ ਅਤੁਲ ਬਲ ਵਾਲਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "खड़गन ईस्वर पुनि अतुल बल ॥",
      "sourceLineId": "101250",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਰਿ ਅਨੇਕ ਜੀਤੇ ਜਿਨਿ ਦਲਿ ਮਲਿ ॥੧੨੯॥",
      "transliteration": "ar anek jeete jin dhal mal ||129||",
      "translation": "He had many qualities and was unlimited like the virtues and strength of the Lord, he had conquered man",
      "punjabiViakhya": "ਅਤੇ ਜਿਸ ਨੇ ਅਨੇਕ ਵੈਰੀਆਂ ਨੂੰ ਮਸਲ ਦਿੱਤਾ ਸੀ ॥੧੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "अरि अनेक जीते जिनि दलि मलि ॥१२९॥",
      "sourceLineId": "101251",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਖੰਡ ਅਖੰਡ ਜੀਤਿ ਬਡ ਰਾਜਾ ॥",
      "transliteration": "kha(n)dd akha(n)dd jeet badd raajaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਨਾ ਜਿਤੇ ਜਾ ਸਕਣ ਵਾਲੇ ਵੱਡੇ ਰਾਜੇ ਜਿਤ ਲਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "खंड अखंड जीति बड राजा ॥",
      "sourceLineId": "101252",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਆਨਿ ਸਮਾਨ ਨ ਆਪੁ ਬਿਰਾਜਾ ॥",
      "transliteration": "aan samaan na aap biraajaa ||",
      "translation": "He had conquered many kings of undivided territories and there was none like him",
      "punjabiViakhya": "ਉਸ ਦੇ ਸਮਾਨ ਹੋਰ ਕੋਈ ਆ ਕੇ ਨਹੀਂ ਬਿਰਾਜਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "आनि समान न आपु बिराजा ॥",
      "sourceLineId": "101253",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਤਿ ਬਲਿਸਟ ਅਸਿ ਤੇਜ ਪ੍ਰਚੰਡਾ ॥",
      "transliteration": "at balisaT as tej pracha(n)ddaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਅਤਿ ਬਲਵਾਨ ਅਤੇ ਪ੍ਰਚੰਡ ਤੇਜ ਵਾਲਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "अति बलिसट असि तेज प्रचंडा ॥",
      "sourceLineId": "101254",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਰਿ ਅਨੇਕ ਜਿਨਿ ਸਾਧਿ ਉਦੰਡਾ ॥੧੩੦॥",
      "transliteration": "ar anek jin saadh udha(n)ddaa ||130||",
      "translation": "He was extremely powerful and glorious and was very modest in the presence of the saints.130.",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਅਨੇਕ ਉਦੰਡ ਵੈਰੀਆਂ ਨੂੰ ਜਿਤ ਲਿਆ ਸੀ ॥੧੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "अरि अनेक जिनि साधि उदंडा ॥१३०॥",
      "sourceLineId": "101255",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੇਸ ਬਿਦੇਸ ਅਧਿਕ ਜਿਹ ਜੀਤਾ ॥",
      "transliteration": "dhes bidhes adhik jeh jeetaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਬਹੁਤ ਸਾਰੇ ਦੇਸ਼ਾ ਵਿਦੇਸ਼ਾ ਨੂੰ ਜਿਤ ਲਿਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "देस बिदेस अधिक जिह जीता ॥",
      "sourceLineId": "101256",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਹ ਤਹ ਚਲੀ ਰਾਜ ਕੀ ਨੀਤਾ ॥",
      "transliteration": "jeh teh chalee raaj kee neetaa ||",
      "translation": "He conquered many countries far and near and his rule was discussed everywhere",
      "punjabiViakhya": "ਅਤੇ ਜਿਥੇ ਕਿਥੇ (ਉਸ ਦੇ) ਰਾਜ ਦੀ ਮਰਯਾਦਾ ਚਲ ਪਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "जह तह चली राज की नीता ॥",
      "sourceLineId": "101257",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਸਿਰਿ ਛਤ੍ਰ ਬਿਰਾਜਾ ॥",
      "transliteration": "bhaat bhaat sir chhatr biraajaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਸਿਰ ਉਤੇ ਤਰ੍ਰਹਾ ਤਰ੍ਰਹਾ ਦੇ ਛਤ੍ਰ ਸ਼ੋਭਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "भाति भाति सिरि छत्र बिराजा ॥",
      "sourceLineId": "101258",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਜਿ ਹਠ ਚਰਨਿ ਲਗੇ ਬਡ ਰਾਜਾ ॥੧੩੧॥",
      "transliteration": "taj haTh charan lage badd raajaa ||131||",
      "translation": "He assumed many types of canopies and many great kings fell at his feet leaving their persistence.131.",
      "punjabiViakhya": "ਅਤੇ ਹਠ ਨੂੰ ਛਡ ਕੇ ਵੱਡੇ ਵੱਡੇ ਰਾਜੇ ਉਸ ਦੀ ਚਰਨੀਂ ਲਗ ਗਏ ਸਨ ॥੧੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "तजि हठ चरनि लगे बड राजा ॥१३१॥",
      "sourceLineId": "101259",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਹ ਤਹ ਹੋਤ ਧਰਮ ਕੀ ਰੀਤਾ ॥",
      "transliteration": "jeh teh hot dharam kee reetaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਧਰਮ ਦੀ ਰੀਤ ਹੋਣ ਲਗ ਗਈ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "जह तह होत धरम की रीता ॥",
      "sourceLineId": "101260",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਹੂੰ ਨ ਪਾਵਤਿ ਹੋਨਿ ਅਨੀਤਾ ॥",
      "transliteration": "kahoo(n) na paavat hon aneetaa ||",
      "translation": "The traditions of Dharma became prevalent in all directions and there was no misconduct anywhere",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਵੀ ਅਨੀਤੀ ਨਹੀਂ ਹੋ ਸਕਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "कहूँ न पावति होनि अनीता ॥",
      "sourceLineId": "101261",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦਾਨ ਨਿਸਾਨ ਚਹੂੰ ਚਕ ਬਾਜਾ ॥",
      "transliteration": "dhaan nisaan chahoo(n) chak baajaa ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ ਚੱਕਾ ਵਿਚ ਦਾਨ ਦੇਣ ਦਾ ਧੌਂਸਾ ਵਜਦਾ ਸੀ (ਅਰਥਾਤ ਦਾਨ ਦੇਣ ਦੀਆਂ ਧੁੰਮਾ ਪੈ ਗਈਆਂ ਸਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "दान निसान चहूँ चक बाजा ॥",
      "sourceLineId": "101262",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਰਨ ਕੁਬੇਰ ਬੇਣੁ ਬਲਿ ਰਾਜਾ ॥੧੩੨॥",
      "transliteration": "karan kuber ben bal raajaa ||132||",
      "translation": "He became famous in bestowing charities like the king Varuna, Kuber, Ben, and Bali.132.",
      "punjabiViakhya": "ਕਰਨ, ਕੁਬੇਰ, ਬੇਣ ਅਤੇ ਬਲਿ ਰਾਜਿਆਂ (ਵਾਗ ਉਸ ਦੀ ਪ੍ਰਸਿੱਧੀ ਹੋ ਗਈ ਸੀ) ॥੧੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "करन कुबेर बेणु बलि राजा ॥१३२॥",
      "sourceLineId": "101263",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਰਾਜ ਕਮਾਈ ॥",
      "transliteration": "bhaat bhaat tan raaj kamaiee ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦਾ ਰਾਜ ਕਮਾਉਣ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन राज कमाई ॥",
      "sourceLineId": "101264",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਆ ਸਮੁਦ੍ਰ ਲੌ ਫਿਰੀ ਦੁਹਾਈ ॥",
      "transliteration": "aa samudhr lau firee dhuhaiee ||",
      "translation": "He ruled in various ways and his drum sounded upto the ocean",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਦੁਹਾਈ ਸਮੁੰਦਰ ਤਕ ਆ ਪਸਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "आ समुद्र लौ फिरी दुहाई ॥",
      "sourceLineId": "101265",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਹ ਤਹ ਕਰਮ ਪਾਪ ਭਯੋ ਦੂਰਾ ॥",
      "transliteration": "jeh teh karam paap bhayo dhooraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਪਾਪਾਚਾਰ ਅਤੇ ਭੈ ਖ਼ਤਮ ਹੋ ਗਿਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "जह तह करम पाप भयो दूरा ॥",
      "sourceLineId": "101266",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਧਰਮ ਕਰਮ ਸਭ ਕਰਤ ਹਜੂਰਾ ॥੧੩੩॥",
      "transliteration": "dharam karam sabh karat hajooraa ||133||",
      "translation": "The voice and fear were nowhere observed and all performed the religious actions in his presence.133.",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਦੇ ਸਨਮੁਖ ਰਹਿਣ ਵਾਲੇ ਸਾਰੇ ਲੋਕ ਧਰਮ ਕਰਮ ਕਰਦੇ ਸਨ ॥੧੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "धरम करम सभ करत हजूरा ॥१३३॥",
      "sourceLineId": "101267",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਹ ਤਹ ਪਾਪ ਛਪਾ ਸਬ ਦੇਸਾ ॥",
      "transliteration": "jeh teh paap chhapaa sab dhesaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਸਾਰੇ ਦੇਸ ਵਿਚੋਂ ਪਾਪ ਛਿਪ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "जह तह पाप छपा सब देसा ॥",
      "sourceLineId": "101268",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਧਰਮ ਕਰਮ ਉਠਿ ਲਾਗਿ ਨਰੇਸਾ ॥",
      "transliteration": "dharam karam uTh laag naresaa ||",
      "translation": "All the countries became sinless and all the kings observed the religious injunctions",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਰਾਜੇ ਤਤਪਰ ਹੋ ਕੇ ਧਰਮ ਕਰਮ ਵਿਚ ਲਗ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "धरम करम उठि लागि नरेसा ॥",
      "sourceLineId": "101269",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਆ ਸਮੁਦ੍ਰ ਲੌ ਫਿਰੀ ਦੁਹਾਈ ॥",
      "transliteration": "aa samudhr lau firee dhuhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਸਮੁੰਦਰ ਤਕ (ਉਸ ਦੀ) ਦੁਹਾਈ ਫਿਰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "आ समुद्र लौ फिरी दुहाई ॥",
      "sourceLineId": "101270",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਕਰੀ ਦਿਲੀਪ ਰਜਾਈ ॥੧੩੪॥",
      "transliteration": "eeh bidh karee dhileep rajaiee ||134||",
      "translation": "The discussion about the rule of Dileep extended upto the ocean.134.",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦਲੀਪ ਰਾਜਾ ਨੇ ਬਾਦਸ਼ਾਹੀ ਕੀਤੀ ॥੧੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "इह बिधि करी दिलीप रजाई ॥१३४॥",
      "sourceLineId": "101271",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਤਿ ਦਲੀਪ ਰਾਜ ਸਮਾਪਤੰ ॥੮॥੫॥",
      "transliteration": "eit dhaleep raaj samaapata(n) ||8||5||",
      "translation": "End of the description of the rule of Dileep and his departure for heaven.",
      "punjabiViakhya": "ਇਥੇ ਦਲੀਪ ਰਾਜੇ ਦੇ ਰਾਜ ਦੀ ਸਮਾਪਤੀ ॥੮॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "इति दलीप राज समापतं ॥८॥५॥",
      "sourceLineId": "101272",
      "sourceShabadId": "9307",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਥ ਰਘੁ ਰਾਜਾ ਕੋ ਰਾਜ ਕਥਨੰ ॥",
      "transliteration": "ath ragh raajaa ko raaj kathana(n) ||",
      "translation": "Now begins the description of he rule of the king Raghu",
      "punjabiViakhya": "ਹੁਣ ਰਘੁ ਰਾਜਾ ਦੇ ਰਾਜ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "अथ रघु राजा को राज कथनं ॥",
      "sourceLineId": "101273",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "101274",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਹੁਰ ਜੋਤਿ ਸੋ ਜੋਤਿ ਮਿਲਾਨੀ ॥",
      "transliteration": "bahur jot so jot milaanee ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ (ਦਲੀਪ ਰਾਜੇ ਦੀ) ਜੋਤਿ (ਪਰਮਾਤਮਾ ਦੀ) ਜੋਤਿ ਨਾਲ ਮਿਲ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "बहुर जोति सो जोति मिलानी ॥",
      "sourceLineId": "101275",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਬ ਜਗ ਐਸ ਕ੍ਰਿਆ ਪਹਿਚਾਨੀ ॥",
      "transliteration": "sab jag aais kriaa pahichaanee ||",
      "translation": "The light of everyone merged in supreme light, and this activity continued in the world",
      "punjabiViakhya": "ਇਸ ਕ੍ਰਿਆ ਨੂੰ ਸਾਰੇ ਜਗਤ ਨੇ ਜਾਣ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "सब जग ऐस कृआ पहिचानी ॥",
      "sourceLineId": "101276",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸ੍ਰੀ ਰਘੁਰਾਜ ਰਾਜੁ ਜਗਿ ਕੀਨਾ ॥",
      "transliteration": "sree raghuraaj raaj jag keenaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਪਿਛੋਂ) ਰਘੁਰਾਜ ਨੇ ਜਗਤ ਵਿਚ ਰਾਜ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "स्री रघुराज राजु जगि कीना ॥",
      "sourceLineId": "101277",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਤ੍ਰਪਤ੍ਰ ਸਿਰਿ ਢਾਰਿ ਨਵੀਨਾ ॥੧੩੫॥",
      "transliteration": "atrapatr sir ddaar naveenaa ||135||",
      "translation": "The king Rahghu ruled over the world and wore new arms, weapons and canopies.135.",
      "punjabiViakhya": "ਅਤੇ (ਆਪਣੇ) ਸਿਰ ਉਤੇ ਨਵੇਾਂ ਰਾਜਸੀ ਛਤ੍ਰ ਅਤੇ ਚਿੰਨ੍ਰਹ ਧਾਰਨ ਕਰ ਲਏ ॥੧੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "अत्रपत्र सिरि ढारि नवीना ॥१३५॥",
      "sourceLineId": "101278",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਹੁਤੁ ਭਾਤਿ ਕਰਿ ਜਗਿ ਪ੍ਰਕਾਰਾ ॥",
      "transliteration": "bahut bhaat kar jag prakaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਪ੍ਰਕਾਰ ਦੇ ਯੱਗ ਬਹੁਤ ਢੰਗਾ ਨਾਲ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "बहुतु भाति करि जगि प्रकारा ॥",
      "sourceLineId": "101279",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦੇਸ ਦੇਸ ਮਹਿ ਧਰਮ ਬਿਥਾਰਾ ॥",
      "transliteration": "dhes dhes meh dharam bithaaraa ||",
      "translation": "He performed several types of Yajnas and spread the religion in all the countires",
      "punjabiViakhya": "ਅਤੇ ਦੇਸ ਦੇਸਾਤਰਾ ਵਿਚ ਧਰਮ ਦਾ ਵਿਸਤਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "देस देस महि धरम बिथारा ॥",
      "sourceLineId": "101280",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪਾਪੀ ਕੋਈ ਨਿਕਟਿ ਨ ਰਾਖਾ ॥",
      "transliteration": "paapee koiee nikaT na raakhaa ||",
      "translation": "",
      "punjabiViakhya": "ਕੋਈ ਪਾਪੀ ਨੇੜੇ ਨਾ ਰਹਿਣ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "पापी कोई निकटि न राखा ॥",
      "sourceLineId": "101281",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਝੂਠ ਬੈਨ ਕਿਹੂੰ ਭੂਲਿ ਨ ਭਾਖਾ ॥੧੩੬॥",
      "transliteration": "jhooTh bain kihoo(n) bhool na bhaakhaa ||136||",
      "translation": "He did not allow any sinner to stay with him and never uttered falsehood, even through oversight.136.",
      "punjabiViakhya": "ਕੋਈ ਭੁਲ ਕੇ ਵੀ ਝੂਠਾ ਬੋਲ ਨਾ ਬੋਲਦਾ ॥੧੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "झूठ बैन किहूँ भूलि न भाखा ॥१३६॥",
      "sourceLineId": "101282",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਿਸਾ ਤਾਸੁ ਨਿਸ ਨਾਥ ਪਛਾਨਾ ॥",
      "transliteration": "nisaa taas nis naath pachhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਨੇ ਉਸ ਨੂੰ ਚੰਦ੍ਰਮਾ (ਦੇ ਰੂਪ) ਵਜੋਂ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "निसा तासु निस नाथ पछाना ॥",
      "sourceLineId": "101283",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦਿਨਕਰ ਤਾਹਿ ਦਿਵਸ ਅਨੁਮਾਨਾ ॥",
      "transliteration": "dhinakar taeh dhivas anumaanaa ||",
      "translation": "The nigh considered him as moon and the day as sun",
      "punjabiViakhya": "ਅਤੇ ਦਿਨ ਨੇ ਉਸ ਨੂੰ ਸੂਰਜ ਦੇ ਰੂਪ ਵਿਚ ਅਨੁਮਾਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "दिनकर ताहि दिवस अनुमाना ॥",
      "sourceLineId": "101284",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬੇਦਨ ਤਾਹਿ ਬ੍ਰਹਮ ਕਰਿ ਲੇਖਾ ॥",
      "transliteration": "bedhan taeh braham kar lekhaa ||",
      "translation": "",
      "punjabiViakhya": "ਵੇਦਾ ਨੇ ਉਸ ਨੂੰ ਬ੍ਰਹਮਾ ਕਰ ਕੇ ਜਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "बेदन ताहि ब्रहम करि लेखा ॥",
      "sourceLineId": "101285",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦੇਵਨ ਇੰਦ੍ਰ ਰੂਪ ਅਵਿਰੇਖਾ ॥੧੩੭॥",
      "transliteration": "dhevan i(n)dhr roop avirekhaa ||137||",
      "translation": "The Vedas considered him as “Brahm” and the gods visualized him as Indra.137.",
      "punjabiViakhya": "ਅਤੇ ਦੇਵਤਿਆਂ ਨੇ ਇੰਦਰ ਰੂਪ ਵਿਚ ਵਿਚਾਰਿਆ ('ਅਵਰੇਖਾ') ॥੧੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "देवन इंद्र रूप अविरेखा ॥१३७॥",
      "sourceLineId": "101286",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਿਪਨ ਸਬਨ ਬ੍ਰਹਸਪਤਿ ਦੇਖ੍ਯੋ ॥",
      "transliteration": "bipan saban brahasapat dhekhayo ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਬ੍ਰਾਹਮਣਾ ਨੇ ਬ੍ਰਹਸਪਤੀ ਵਜੋਂ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "बिपन सबन ब्रहसपति देख्यो ॥",
      "sourceLineId": "101287",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੈਤਨ ਗੁਰੂ ਸੁਕ੍ਰ ਕਰਿ ਪੇਖ੍ਯੋ ॥",
      "transliteration": "dhaitan guroo sukr kar pekhayo ||",
      "translation": "All the Brahmins saw in him the god Brihaspati and the demons as Shukracharya",
      "punjabiViakhya": "ਅਤੇ ਦੈਂਤਾ ਨੇ ਸ਼ੁਕ੍ਰ ਗੁਰੂ ਵਜੋਂ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "दैतन गुरू सुक्र करि पेख्यो ॥",
      "sourceLineId": "101288",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰੋਗਨ ਤਾਹਿ ਅਉਖਧੀ ਮਾਨਾ ॥",
      "transliteration": "rogan taeh aaukhadhee maanaa ||",
      "translation": "",
      "punjabiViakhya": "ਰੋਗੀਆਂ ਨੇ ਉਸ ਨੂੰ ਦਵਾਈ ਦੇ ਰੂਪ ਵਿਚ ਮੰਨਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "रोगन ताहि अउखधी माना ॥",
      "sourceLineId": "101289",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜੋਗਿਨ ਪਰਮ ਤਤ ਪਹਿਚਾਨਾ ॥੧੩੮॥",
      "transliteration": "jogin param tat pahichaanaa ||138||",
      "translation": "The ailments looked at him as medicine and the Yogis visulised in him the supreme essence.138.",
      "punjabiViakhya": "ਅਤੇ ਜੋਗੀਆਂ ਨੇ ਉਸ ਨੂੰ ਪਰਮਤੱਤ ਦੇ ਰੂਪ ਵਿਚ ਪਛਾਣਿਆ ॥੧੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "जोगिन परम तत पहिचाना ॥१३८॥",
      "sourceLineId": "101290",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਬਾਲਨ ਬਾਲ ਰੂਪ ਅਵਿਰੇਖ੍ਰਯੋ ॥",
      "transliteration": "baalan baal roop avirekhrayo ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਲਕਾ ਨੇ (ਉਸ ਨੂੰ) ਬਾਲਕ ਰੂਪ ਵਿਚ ਜਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "बालन बाल रूप अविरेख्रयो ॥",
      "sourceLineId": "101291",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜੋਗਨ ਮਹਾ ਜੋਗ ਕਰਿ ਦੇਖ੍ਯੋ ॥",
      "transliteration": "jogan mahaa jog kar dhekhayo ||",
      "translation": "The children saw him as a child and the Yogis as the supreme Yogi",
      "punjabiViakhya": "ਅਤੇ ਜੋਗੀਆਂ ਨੇ ਮਹਾਨ ਜੋਗ ਕਰ ਕੇ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "जोगन महा जोग करि देख्यो ॥",
      "sourceLineId": "101292",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਦਾਤਨ ਮਹਾਦਾਨਿ ਕਰਿ ਮਾਨ੍ਯੋ ॥",
      "transliteration": "dhaatan mahaadhaan kar maanayo ||",
      "translation": "",
      "punjabiViakhya": "ਦਾਤਿਆਂ ਨੇ ਮਹਾਦਾਨ ਦੇ ਰੂਪ ਵਿਚ ਮੰਨਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "दातन महादानि करि मान्यो ॥",
      "sourceLineId": "101293",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਭੋਗਨ ਭੋਗ ਰੂਪ ਪਹਚਾਨ੍ਯੋ ॥੧੩੯॥",
      "transliteration": "bhogan bhog roop pahachaanayo ||139||",
      "translation": "The donors saw in him the supreme Donor and the pleasure seeking persons considered him as a Supreme Yogi.139.",
      "punjabiViakhya": "ਅਤੇ ਭੋਗੀਆਂ ਨੇ ਭੋਗ ਰੂਪ ਵਜੋਂ ਪਛਾਣਿਆ ॥੧੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "भोगन भोग रूप पहचान्यो ॥१३९॥",
      "sourceLineId": "101294",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸੰਨਿਆਸਨ ਦਤ ਰੂਪ ਕਰਿ ਜਾਨ੍ਯੋ ॥",
      "transliteration": "sa(n)niaasan dhat roop kar jaanayo ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਨਿਆਸੀਆਂ ਨੇ ਦੱਤ ਰੂਪ ਕਰ ਕੇ ਜਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "संनिआसन दत रूप करि जान्यो ॥",
      "sourceLineId": "101295",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜੋਗਨ ਗੁਰ ਗੋਰਖ ਕਰਿ ਮਾਨ੍ਯੋ ॥",
      "transliteration": "jogan gur gorakh kar maanayo ||",
      "translation": "The Sannyasis considered him as Dattatreya and the Yogis as Guru Gorakhnath",
      "punjabiViakhya": "ਅਤੇ ਜੋਗੀਆਂ ਨੇ ਗੁਰੂ ਗੋਰਖ ਕਰ ਕੇ ਮੰਨਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "जोगन गुर गोरख करि मान्यो ॥",
      "sourceLineId": "101296",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਰਾਮਾਨੰਦ ਬੈਰਾਗਿਨ ਜਾਨਾ ॥",
      "transliteration": "raamaana(n)dh bairaagin jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਬੈਰਾਗੀਆਂ ਨੇ ਰਾਮਾਨੰਦ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "रामानंद बैरागिन जाना ॥",
      "sourceLineId": "101297",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਮਹਾਦੀਨ ਤੁਰਕਨ ਪਹਚਾਨਾ ॥੧੪੦॥",
      "transliteration": "mahaadheen turakan pahachaanaa ||140||",
      "translation": "The Bairagis considered him as Ramanand and the Muslims as Muhammad.140. (This is a period-error).",
      "punjabiViakhya": "ਅਤੇ ਮੁਸਲਮਾਨਾ ਨੇ ਹਜ਼ਰਤ ਮੁਹੰਮਦ ('ਮਹਾਦੀਨ') ਕਰ ਕੇ ਜਾਣਿਆ ॥੧੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "महादीन तुरकन पहचाना ॥१४०॥",
      "sourceLineId": "101298",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਦੇਵਨ ਇੰਦ੍ਰ ਰੂਪ ਕਰਿ ਲੇਖਾ ॥",
      "transliteration": "dhevan i(n)dhr roop kar lekhaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤਿਆਂ ਨੇ ਇੰਦਰ ਰੂਪ ਕਰ ਕੇ ਪਛਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "देवन इंद्र रूप करि लेखा ॥",
      "sourceLineId": "101299",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਦੈਤਨ ਸੁੰਭ ਰਾਜਾ ਕਰਿ ਪੇਖਾ ॥",
      "transliteration": "dhaitan su(n)bh raajaa kar pekhaa ||",
      "translation": "The gods considered him as Indra and the demons as Shmbh",
      "punjabiViakhya": "ਅਤੇ ਦੈਂਤਾ ਨੇ ਰਾਜਾ ਸੁੰਭ ਕਰ ਕੇ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "दैतन सुँभ राजा करि पेखा ॥",
      "sourceLineId": "101300",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਜਛਨ ਜਛ ਰਾਜ ਕਰਿ ਮਾਨਾ ॥",
      "transliteration": "jachhan jachh raaj kar maanaa ||",
      "translation": "",
      "punjabiViakhya": "ਯਕਸ਼ਾ ਨੇ ਯਕਸ਼ ਰਾਜਾ (ਕੁਬੇਰ) ਵਜੋਂ ਮੰਨਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "जछन जछ राज करि माना ॥",
      "sourceLineId": "101301",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਕਿਨ੍ਰਨ ਕਿਨ੍ਰਦੇਵ ਪਹਚਾਨਾ ॥੧੪੧॥",
      "transliteration": "kinran kinradhev pahachaanaa ||141||",
      "translation": "The Yakshas and Kinnar thought of him as their king.141.",
      "punjabiViakhya": "ਅਤੇ ਕਿੰਨਰਾ ਨੇ ਕਿੰਨਰ ਰਾਜਾ ਦੇ ਰੂਪ ਵਿਚ ਪਛਾਣਿਆ ॥੧੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "किन्रन किन्रदेव पहचाना ॥१४१॥",
      "sourceLineId": "101302",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਕਾਮਿਨ ਕਾਮ ਰੂਪ ਕਰਿ ਦੇਖ੍ਯੋ ॥",
      "transliteration": "kaamin kaam roop kar dhekhayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮਨੀਆਂ ਨੇ ਕਾਮ ਰੂਪ ਵਜੋਂ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "कामिन काम रूप करि देख्यो ॥",
      "sourceLineId": "101303",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਰੋਗਨ ਰੂਪ ਧਨੰਤਰ ਪੇਖ੍ਯੋ ॥",
      "transliteration": "rogan roop dhana(n)tar pekhayo ||",
      "translation": "The lustful women considered him as the god of love and the diseases thought of him as the incarnation of Dhanvantri",
      "punjabiViakhya": "ਰੋਗੀਆਂ ਨੇ ਧਨੰਤਰੀ ਰੂਪ ਵਜੋਂ ਜਾਣਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "रोगन रूप धनंतर पेख्यो ॥",
      "sourceLineId": "101304",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਰਾਜਨ ਲਖ੍ਯੋ ਰਾਜ ਅਧਿਕਾਰੀ ॥",
      "transliteration": "raajan lakhayo raaj adhikaaree ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਿਆਂ ਨੇ (ਉਸ ਨੂੰ) ਰਾਜ ਦਾ ਅਧਿਕਾਰੀ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "राजन लख्यो राज अधिकारी ॥",
      "sourceLineId": "101305",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਜੋਗਨ ਲਖ੍ਯੋ ਜੋਗੀਸਰ ਭਾਰੀ ॥੧੪੨॥",
      "transliteration": "jogan lakhayo jogeesar bhaaree ||142||",
      "translation": "The kings considered him as the Sovereign and the Yogis thought of him s the Supreme Yogi.142.",
      "punjabiViakhya": "ਅਤੇ ਜੋਗੀਆਂ ਨੇ ਵੱਡਾ ਜੋਗੀਸ਼੍ਵਰ ਮੰਨਿਆ ॥੧੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "जोगन लख्यो जोगीसर भारी ॥१४२॥",
      "sourceLineId": "101306",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਛਤ੍ਰਨ ਬਡੋ ਛਤ੍ਰਪਤਿ ਜਾਨਾ ॥",
      "transliteration": "chhatran baddo chhatrapat jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਛਤ੍ਰੀਆਂ ਨੇ ਵੱਡਾ ਛਤ੍ਰਪਤੀ ਜਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "छत्रन बडो छत्रपति जाना ॥",
      "sourceLineId": "101307",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਅਤ੍ਰਿਨ ਮਹਾ ਸਸਤ੍ਰਧਰ ਮਾਨਾ ॥",
      "transliteration": "atiran mahaa sasatradhar maanaa ||",
      "translation": "The Kshatriyas considered him the great canopied king and the wielders of arms and weapons thought of him as the great and powerful warrior",
      "punjabiViakhya": "ਅਤੇ ਯੋਧਿਆਂ ('ਅਤ੍ਰਿਨ') ਨੇ ਮਹਾਨ ਸ਼ਸਤ੍ਰਧਾਰੀ ਰੂਪ ਵਿਚ ਪਛਾਣਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "अतृन महा ससत्रधर माना ॥",
      "sourceLineId": "101308",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਰਜਨੀ ਤਾਸੁ ਚੰਦ੍ਰ ਕਰਿ ਲੇਖਾ ॥",
      "transliteration": "rajanee taas cha(n)dhr kar lekhaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਨੇ ਉਸ ਨੂੰ ਚੰਦ੍ਰਮਾ ਕਰ ਕੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "रजनी तासु चंद्र करि लेखा ॥",
      "sourceLineId": "101309",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਦਿਨੀਅਰ ਕਰਿ ਤਿਹ ਦਿਨ ਅਵਿਰੇਖਾ ॥੧੪੩॥",
      "transliteration": "dhineear kar teh dhin avirekhaa ||143||",
      "translation": "The night considered him as moon and the day as sun.143.",
      "punjabiViakhya": "ਅਤੇ ਦਿਨ ਨੇ ਉਸ ਨੂੰ ਸੂਰਜ ਦੇ ਰੂਪ ਵਿਚ ਵਿਚਾਰਿਆ ॥੧੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "दिनीअर करि तिह दिन अविरेखा ॥१४३॥",
      "sourceLineId": "101310",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਸੰਤਨ ਸਾਤਿ ਰੂਪ ਕਰਿ ਜਾਨ੍ਯੋ ॥",
      "transliteration": "sa(n)tan saat roop kar jaanayo ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਤਾ ਨੇ ਉਸ ਨੂੰ ਸਾਤ ਰੂਪ ਕਰ ਕੇ ਜਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "संतन साति रूप करि जान्यो ॥",
      "sourceLineId": "101311",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0624_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਪਾਵਕ ਤੇਜ ਰੂਪ ਅਨੁਮਾਨ੍ਰਯੋ ॥",
      "transliteration": "paavak tej roop anumaanrayo ||",
      "translation": "The saints thought of him as manifestation of peace and the fire thought of him as effulgence",
      "punjabiViakhya": "ਅਤੇ ਅਗਨੀ ਨੇ ਉਸ ਨੂੰ ਤੇਜ ਵਜੋਂ ਅਨੁਮਾਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 624,
      "hindi": "",
      "hindiTransliteration": "पावक तेज रूप अनुमान्रयो ॥",
      "sourceLineId": "101312",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
