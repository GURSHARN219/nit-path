{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 625,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0625_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਛਤ੍ਰਿਨ ਤਾ ਸਬੁ ਛਤ੍ਰਿਪਤਿ ਸੂਝਾ ॥",
      "transliteration": "chhatiran taa sab chhatirapat soojhaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਛਤ੍ਰੀਆਂ ਨੂੰ ਉਹ ਛਤ੍ਰਪਤੀ ਦੇ ਰੂਪ ਵਿਚ ਸੁਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "छतृन ता सबु छतृपति सूझा ॥",
      "sourceLineId": "101315",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜੋਗਿਨ ਮਹਾ ਜੋਗ ਕਰ ਬੂਝਾ ॥",
      "transliteration": "jogin mahaa jog kar boojhaa ||",
      "translation": "He appeared to the kshatris as Soverign and to the Yogis as Supreme Yogi",
      "punjabiViakhya": "ਅਤੇ ਜੋਗੀਆਂ ਨੇ ਮਹਾਨ ਜੋਗੀ ਵਜੋਂ ਬੁਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "जोगिन महा जोग कर बूझा ॥",
      "sourceLineId": "101316",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਿਮਧਰ ਤਾਹਿ ਹਿਮਾਲਯ ਜਾਨਾ ॥",
      "transliteration": "himadhar taeh himaalay jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਰਫੀਲੇ ਪਰਬਤਾ (ਅਰਥਾਤਰ-ਚੰਦ੍ਰਮਾ) ਨੇ ਉਸ ਨੂੰ ਹਿਮਾਲਾ ਵਜੋਂ ਜਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "हिमधर ताहि हिमालय जाना ॥",
      "sourceLineId": "101317",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦਿਨਕਰ ਅੰਧਕਾਰਿ ਅਨੁਮਾਨਾ ॥੧੪੫॥",
      "transliteration": "dhinakar a(n)dhakaar anumaanaa ||145||",
      "translation": "The mountains considered him as Himalaya and the darkness thought of him as the effulgence of the sun.145.",
      "punjabiViakhya": "ਅਤੇ ਹਨੇਰੇ ਨੇ ਸੂਰਜ ਕਰ ਕੇ ਅਨੁਮਾਨ ਕੀਤਾ ॥੧੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "दिनकर अंधकारि अनुमाना ॥१४५॥",
      "sourceLineId": "101318",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਲ ਸਰੂਪ ਜਲ ਤਾਸੁ ਪਛਾਨਾ ॥",
      "transliteration": "jal saroop jal taas pachhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਲ ਨੇ ਉਸ ਨੂੰ 'ਜਲ ਸਰੂਪ' ਵਜੋਂ ਪਛਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "जल सरूप जल तासु पछाना ॥",
      "sourceLineId": "101319",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮੇਘਨ ਇੰਦ੍ਰਦੇਵ ਕਰ ਮਾਨਾ ॥",
      "transliteration": "meghan i(n)dhradhev kar maanaa ||",
      "translation": "The water thought of him as the sea and the cloud considered him as Indra",
      "punjabiViakhya": "ਅਤੇ ਬਦਲਾ ਨੇ ਉਸ ਨੂੰ ਇੰਦਰ ਦੇਵ ਵਜੋਂ ਅਨੁਮਾਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "मेघन इंद्रदेव कर माना ॥",
      "sourceLineId": "101320",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬੇਦਨ ਬ੍ਰਹਮ ਰੂਪ ਕਰ ਦੇਖਾ ॥",
      "transliteration": "bedhan braham roop kar dhekhaa ||",
      "translation": "",
      "punjabiViakhya": "ਵੇਦਾ ਨੇ ਉਸ ਨੂੰ ਬ੍ਰਹਮ ਰੂਪ ਕਰ ਕੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "बेदन ब्रहम रूप कर देखा ॥",
      "sourceLineId": "101321",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਿਪਨ ਬ੍ਯਾਸ ਜਾਨਿ ਅਵਿਰੇਖਾ ॥੧੪੬॥",
      "transliteration": "bipan bayaas jaan avirekhaa ||146||",
      "translation": "The Vedas considered him as Brahman and the Brahmins imagined him as the sage Vyas.146.",
      "punjabiViakhya": "ਅਤੇ ਬ੍ਰਾਹਮਣਾ ਨੇ ਬਿਆਸ ਕਰ ਕੇ ਵਿਚਾਰਿਆ ॥੧੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "बिपन ब्यास जानि अविरेखा ॥१४६॥",
      "sourceLineId": "101322",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਲਖਮੀ ਤਾਹਿ ਬਿਸਨੁ ਕਰਿ ਮਾਨ੍ਯੋ ॥",
      "transliteration": "lakhamee taeh bisan kar maanayo ||",
      "translation": "",
      "punjabiViakhya": "ਲੱਛਮੀ ਨੇ ਉਸ ਨੂੰ ਵਿਸ਼ਣੂ ਕਰ ਕੇ ਮੰਨਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "लखमी ताहि बिसनु करि मान्यो ॥",
      "sourceLineId": "101323",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਾਸਵ ਦੇਵ ਬਾਸਵੀ ਜਾਨ੍ਯੋ ॥",
      "transliteration": "baasav dhev baasavee jaanayo ||",
      "translation": "Lakshmi considered him as Vishnu and Indrani as Indra",
      "punjabiViakhya": "ਅਤੇ ਇੰਦਰਾਣੀ ('ਬਾਸਵੀ') ਨੇ ਇੰਦਰ ਰੂਪ ਵਿਚ ਜਾਣਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "बासव देव बासवी जान्यो ॥",
      "sourceLineId": "101324",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੰਤਨ ਸਾਤਿ ਰੂਪ ਕਰਿ ਦੇਖਾ ॥",
      "transliteration": "sa(n)tan saat roop kar dhekhaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਤਾ ਨੇ (ਉਸ ਨੂੰ) ਸ਼ਾਤ ਰੂਪ ਵਿਚ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "संतन साति रूप करि देखा ॥",
      "sourceLineId": "101325",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਤ੍ਰਨ ਕਲਹ ਸਰੂਪ ਬਿਸੇਖਾ ॥੧੪੭॥",
      "transliteration": "satran kaleh saroop bisekhaa ||147||",
      "translation": "The saints saw him s peace-personified and the enemies as the clash-personified.147.",
      "punjabiViakhya": "ਅਤੇ ਵੈਰੀਆਂ ਨੇ ਝਗੜੇ ('ਕਲਹ') ਦੇ ਰੂਪ ਵਿਚ ਵੇਖਿਆ ॥੧੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "सत्रन कलह सरूप बिसेखा ॥१४७॥",
      "sourceLineId": "101326",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰੋਗਨ ਤਾਹਿ ਅਉਖਧੀ ਸੂਝਾ ॥",
      "transliteration": "rogan taeh aaukhadhee soojhaa ||",
      "translation": "",
      "punjabiViakhya": "ਰੋਗੀਆਂ ਨੂੰ ਉਹ ਦਵਾਈ ਰੂਪ ਲਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "रोगन ताहि अउखधी सूझा ॥",
      "sourceLineId": "101327",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਭਾਮਿਨ ਭੋਗ ਰੂਪ ਕਰਿ ਬੂਝਾ ॥",
      "transliteration": "bhaamin bhog roop kar boojhaa ||",
      "translation": "The ailments saw him as medicine and the women as lust",
      "punjabiViakhya": "ਅਤੇ ਇਸਤਰੀਆਂ ਨੇ ਭੋਗ ਰੂਪ ਵਿਚ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "भामिन भोग रूप करि बूझा ॥",
      "sourceLineId": "101328",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਿਤ੍ਰਨ ਮਹਾ ਮਿਤ੍ਰ ਕਰਿ ਜਾਨਾ ॥",
      "transliteration": "mitran mahaa mitr kar jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਿਤਰਾ ਨੇ ਮਹਾਨ ਮਿਤਰ ਕਰ ਕੇ ਮੰਨਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "मित्रन महा मित्र करि जाना ॥",
      "sourceLineId": "101329",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜੋਗਿਨ ਪਰਮ ਤਤੁ ਪਹਚਾਨਾ ॥੧੪੮॥",
      "transliteration": "jogin param tat pahachaanaa ||148||",
      "translation": "The friends considered him as great friend and the Yogis as Supreme essence.148.",
      "punjabiViakhya": "ਅਤੇ ਜੋਗੀਆਂ ਨੇ ਪਰਮਤੱਤ ਵਜੋਂ ਪਛਾਣਿਆ ॥੧੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "जोगिन परम ततु पहचाना ॥१४८॥",
      "sourceLineId": "101330",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੋਰਨ ਮਹਾ ਮੇਘ ਕਰਿ ਮਾਨਿਆ ॥",
      "transliteration": "moran mahaa megh kar maaniaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੋਰਾ ਨੇ ਘਨਘੋਰ ਬਦਲ ਵਜੋਂ ਮੰਨਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "मोरन महा मेघ करि मानिआ ॥",
      "sourceLineId": "101331",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦਿਨਕਰ ਚਿਤ ਚਕਵੀ ਜਾਨਿਆ ॥",
      "transliteration": "dhinakar chit chakavee jaaniaa ||",
      "translation": "The peacocks thought of him as cloud and the Chakvi (Brahmani duck) as sun",
      "punjabiViakhya": "ਅਤੇ ਚਕਵੀ ਨੇ ਚਿਤ ਵਿਚ ਸੂਰਜ ਕਰ ਕੇ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "दिनकर चित चकवी जानिआ ॥",
      "sourceLineId": "101332",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚੰਦ ਸਰੂਪ ਚਕੋਰਨ ਸੂਝਾ ॥",
      "transliteration": "cha(n)dh saroop chakoran soojhaa ||",
      "translation": "",
      "punjabiViakhya": "ਚਕੋਰਾ ਨੇ ਚੰਦ੍ਰਮਾ ਦਾ ਸਰੂਪ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "चंद सरूप चकोरन सूझा ॥",
      "sourceLineId": "101333",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸ੍ਵਾਤਿ ਬੂੰਦ ਸੀਪਨ ਕਰਿ ਬੂਝਾ ॥੧੪੯॥",
      "transliteration": "savaiaat boo(n)dh seepan kar boojhaa ||149||",
      "translation": "The female partridge viewed him as moon and the shell as rain-drop.149.",
      "punjabiViakhya": "ਅਤੇ ਸਿੱਪੀਆਂ ਨੇ ਸ੍ਵਾਤੀ ਬੂੰਦ ਕਰ ਕੇ ਬੁਝਿਆ ॥੧੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "स्वाति बूँद सीपन करि बूझा ॥१४९॥",
      "sourceLineId": "101334",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਾਸ ਬਸੰਤ ਕੋਕਿਲਾ ਜਾਨਾ ॥",
      "transliteration": "maas basa(n)t kokilaa jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਕੋਇਲ ਨੇ ਬਸੰਤ ਦਾ ਮਹੀਨਾ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "मास बसंत कोकिला जाना ॥",
      "sourceLineId": "101335",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸ੍ਵਾਤਿ ਬੂੰਦ ਚਾਤ੍ਰਕ ਅਨੁਮਾਨਾ ॥",
      "transliteration": "savaiaat boo(n)dh chaatrak anumaanaa ||",
      "translation": "The nightingale saw him as spring and the rain-bird as the rain-drop",
      "punjabiViakhya": "ਅਤੇ ਚਾਤ੍ਰਿਕ ਨੇ ਸ੍ਵਾਤੀ ਬੂੰਦ ਵਜੋਂ ਅਨੁਮਾਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "स्वाति बूँद चात्रक अनुमाना ॥",
      "sourceLineId": "101336",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਾਧਨ ਸਿਧਿ ਰੂਪ ਕਰਿ ਦੇਖਾ ॥",
      "transliteration": "saadhan sidh roop kar dhekhaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਧਾ ਨੇ ਸਿੱਧ ਰੂਪ ਕਰ ਕੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "साधन सिधि रूप करि देखा ॥",
      "sourceLineId": "101337",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਾਜਨ ਮਹਾਰਾਜ ਅਵਿਰੇਖਾ ॥੧੫੦॥",
      "transliteration": "raajan mahaaraaj avirekhaa ||150||",
      "translation": "The Sadhus (saints) viewed him s Siddh (an adept) and the kings as Sovereign.150.",
      "punjabiViakhya": "ਅਤੇ ਰਾਜਿਆਂ ਨੇ ਮਹਾਰਾਜਾ ਵਜੋਂ ਵਿਚਾਰਿਆ ॥੧੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "राजन महाराज अविरेखा ॥१५०॥",
      "sourceLineId": "101338",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦਾਨ ਸਰੂਪ ਭਿਛਕਨ ਜਾਨਾ ॥",
      "transliteration": "dhaan saroop bhichhakan jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਭਿਖਾਰੀਆਂ ਨੇ ਦਾਨ ਰੂਪ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "दान सरूप भिछकन जाना ॥",
      "sourceLineId": "101339",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਾਲ ਸਰੂਪ ਸਤ੍ਰੁ ਅਨੁਮਾਨਾ ॥",
      "transliteration": "kaal saroop satr anumaanaa ||",
      "translation": "The beggars saw him as the Donor and the enemies as KAL (death)",
      "punjabiViakhya": "ਅਤੇ ਵੈਰੀਆਂ ਨੇ ਕਾਲ ਸਰੂਪ ਅਨੁਮਾਨਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "काल सरूप सत्रु अनुमाना ॥",
      "sourceLineId": "101340",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਾਸਤ੍ਰ ਸਰੂਪ ਸਿਮ੍ਰਿਤਨ ਦੇਖਾ ॥",
      "transliteration": "saasatr saroop simritan dhekhaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਿਮ੍ਰਿਤੀਆਂ ਨੇ ਸ਼ਾਸਤ੍ਰ ਵਜੋਂ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "सासत्र सरूप सिमृतन देखा ॥",
      "sourceLineId": "101341",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਤਿ ਸਰੂਪ ਸਾਧ ਅਵਿਰੇਖਾ ॥੧੫੧॥",
      "transliteration": "sat saroop saadh avirekhaa ||151||",
      "translation": "The Smritis considered him as the knowledge of Shastras and the saints as Truth.151.",
      "punjabiViakhya": "ਅਤੇ ਸਾਧਾ ਨੇ ਸਤਿ ਸਰੂਪ ਵਿਚ ਵਿਚਾਰਿਆ ॥੧੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "सति सरूप साध अविरेखा ॥१५१॥",
      "sourceLineId": "101342",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੀਲ ਰੂਪ ਸਾਧਵਿਨ ਚੀਨਾ ॥",
      "transliteration": "seel roop saadhavin cheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਧੂ ਰੁਚੀ ਵਾਲਿਆਂ ਨੇ ਸ਼ੁੱਧ ਚਲਨ ('ਸ਼ੀਲ') ਵਾਲਾ ਪਛਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "सील रूप साधविन चीना ॥",
      "sourceLineId": "101343",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦਿਆਲ ਸਰੂਪ ਦਇਆ ਚਿਤਿ ਕੀਨਾ ॥",
      "transliteration": "dhiaal saroop dhiaa chit keenaa ||",
      "translation": "The saints viewed him as the personification of good conduct and absorbed his kindness in their mind",
      "punjabiViakhya": "ਅਤੇ ਦਇਆ ਨੇ ਦਿਆਲੂ ਵਜੋਂ ਚਿਤ ਵਿਚ ਵਿਚਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "दिआल सरूप दइआ चिति कीना ॥",
      "sourceLineId": "101344",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮੋਰਨ ਮੇਘ ਰੂਪ ਪਹਿਚਾਨਾ ॥",
      "transliteration": "moran megh roop pahichaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੋਰਾ ਨੇ ਬਦਲ ਰੂਪ ਵਿਚ ਪਛਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "मोरन मेघ रूप पहिचाना ॥",
      "sourceLineId": "101345",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚੋਰਨ ਤਾਹਿ ਭੋਰ ਕਰਿ ਜਾਨਾ ॥੧੫੨॥",
      "transliteration": "choran taeh bhor kar jaanaa ||152||",
      "translation": "The peacocks thought of him as cloud and the thieves as day dawn.152.",
      "punjabiViakhya": "ਅਤੇ ਚੋਰਾ ਨੇ ਉਸ ਨੂੰ ਪ੍ਰਭਾਤ ਵੇਲਾ ਕਰ ਕੇ ਜਾਣਿਆ ॥੧੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "चोरन ताहि भोर करि जाना ॥१५२॥",
      "sourceLineId": "101346",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਾਮਿਨ ਕੇਲ ਰੂਪ ਕਰਿ ਸੂਝਾ ॥",
      "transliteration": "kaamin kel roop kar soojhaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮਨੀਆਂ ਨੂੰ ਕਾਮ-ਕੇਲ ਵਜੋਂ ਸੁਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "कामिन केल रूप करि सूझा ॥",
      "sourceLineId": "101347",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਾਧਨ ਸਿਧਿ ਰੂਪ ਤਿਹ ਬੂਝਾ ॥",
      "transliteration": "saadhan sidh roop teh boojhaa ||",
      "translation": "The women considered him s the incarnation of lust and the saints saw him s adept",
      "punjabiViakhya": "ਅਤੇ ਸਾਧਾ ਨੇ ਉਸ ਨੂੰ ਸਿੱਧ ਰੂਪ ਵਿਚ ਵਿਚਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "साधन सिधि रूप तिह बूझा ॥",
      "sourceLineId": "101348",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਫਣਪਤੇਸ ਫਣੀਅਰ ਕਰਿ ਜਾਨ੍ਯੋ ॥",
      "transliteration": "fanapates faneear kar jaanayo ||",
      "translation": "",
      "punjabiViakhya": "ਨਾਗਾ ('ਫਣੀਅਰ') ਨੇ (ਉਸ ਨੂੰ) ਸ਼ੇਸ਼ਨਾਗ ਕਰ ਕੇ ਜਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "फणपतेस फणीअर करि जान्यो ॥",
      "sourceLineId": "101349",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਰੂਪ ਦੇਵਤਨ ਮਾਨ੍ਯੋ ॥੧੫੩॥",
      "transliteration": "a(n)mirat roop dhevatan maanayo ||153||",
      "translation": "The serpents considered him as Sheshnaga and the gods believed him to be ambrosia.153.",
      "punjabiViakhya": "ਅਤੇ ਦੇਵਤਿਆਂ ਨੇ ਅੰਮ੍ਰਿਤ ਰੂਪ ਕਰ ਕੇ ਮੰਨਿਆ ॥੧੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "अंमृत रूप देवतन मान्यो ॥१५३॥",
      "sourceLineId": "101350",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਣਿ ਸਮਾਨ ਫਣੀਅਰ ਕਰਿ ਸੂਝਾ ॥",
      "transliteration": "man samaan faneear kar soojhaa ||",
      "translation": "",
      "punjabiViakhya": "ਨਾਗਾ ('ਫਣੀਅਰ') ਨੂੰ ਮਣੀ ਕਰ ਕੇ ਸੁਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "मणि समान फणीअर करि सूझा ॥",
      "sourceLineId": "101351",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪ੍ਰਾਣਿਨ ਪ੍ਰਾਨ ਰੂਪ ਕਰਿ ਬੂਝਾ ॥",
      "transliteration": "praanin praan roop kar boojhaa ||",
      "translation": "He seemed to be like jewel in the serpent and the creatures saw him as prana (life-force)",
      "punjabiViakhya": "ਅਤੇ ਪ੍ਰਾਣੀਆਂ ਨੇ ਪ੍ਰਾਣ ਰੂਪ ਕਰ ਕੇ ਬੁਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "प्राणिन प्रान रूप करि बूझा ॥",
      "sourceLineId": "101352",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਘੁ ਬੰਸੀਅਨ ਰਘੁਰਾਜ ਪ੍ਰਮਾਨ੍ਰਯੋ ॥",
      "transliteration": "ragh ba(n)seean raghuraaj pramaanrayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਘੂਬੰਸੀਆਂ ਨੇ ਰਘੁ ਰਾਜ ਵਜੋਂ ਪ੍ਰਮਾਣਿਤ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "रघु बंसीअन रघुराज प्रमान्रयो ॥",
      "sourceLineId": "101353",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕੇਵਲ ਕ੍ਰਿਸਨ ਜਾਦਵਨ ਜਾਨ੍ਯੋ ॥੧੫੪॥",
      "transliteration": "keval kirasan jaadhavan jaanayo ||154||",
      "translation": "In the whole Raghu clan, he was authenticated s raghhu clan, he was authenticated as Raghuraj, the king Raghu and the Yadavas considered him like Krishna.154.",
      "punjabiViakhya": "ਅਤੇ ਯਾਦਵਾ ਨੇ ਕੇਵਲ ਕ੍ਰਿਸ਼ਨ ਕਰ ਕੇ ਜਾਣਿਆ ॥੧੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "केवल कृसन जादवन जान्यो ॥१५४॥",
      "sourceLineId": "101354",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਿਪਤਿ ਹਰਨ ਬਿਪਤਹਿ ਕਰਿ ਜਾਨਾ ॥",
      "transliteration": "bipat haran bipateh kar jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਪਤਾ ਵਿਚ ਗ੍ਰਸਿਆਂ ਨੇ ਉਸ ਨੂੰ ਬਿਪਤਾ ਦੇ ਵਿਨਾਸ਼ਕ ਵਜੋਂ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "बिपति हरन बिपतहि करि जाना ॥",
      "sourceLineId": "101355",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਲਿ ਮਹੀਪ ਬਾਵਨ ਪਹਚਾਨਾ ॥",
      "transliteration": "bal maheep baavan pahachaanaa ||",
      "translation": "The affliction saw him as the destroyer of suffering and Bali saw him as Vaman",
      "punjabiViakhya": "ਅਤੇ ਬਲੀ ਰਾਜੇ ਨੇ ਬਾਵਨ (ਅਵਤਾਰ) ਵਜੋਂ ਪਛਾਣ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "बलि महीप बावन पहचाना ॥",
      "sourceLineId": "101356",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਿਵ ਸਰੂਪ ਸਿਵ ਸੰਤਨ ਪੇਖਾ ॥",
      "transliteration": "siv saroop siv sa(n)tan pekhaa ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਦੇ ਉਪਾਸਕਾ ਨੇ ਸ਼ਿਵ ਰੂਪ ਵਿਚ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "सिव सरूप सिव संतन पेखा ॥",
      "sourceLineId": "101357",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬ੍ਯਾਸ ਪਰਾਸੁਰ ਤੁਲ ਬਸੇਖਾ ॥੧੫੫॥",
      "transliteration": "bayaas paraasur tul basekhaa ||155||",
      "translation": "The devotees of Shiva considered him as Shiva and also as Vyas and Parashar.155.",
      "punjabiViakhya": "ਅਤੇ ਬਿਆਸ ਨੇ ਪਰਾਸ਼ਰ ਦੇ ਸਮਾਨ ਸਮਝਿਆ ॥੧੫੫॥",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "ब्यास परासुर तुल बसेखा ॥१५५॥",
      "sourceLineId": "101358",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਿਪ੍ਰਨ ਬੇਦ ਸਰੂਪ ਬਖਾਨਾ ॥",
      "transliteration": "bipran bedh saroop bakhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਾਹਮਣਾ ਨੇ ਵੇਦ ਸਰੂਪ ਕਰ ਕੇ ਵਰਣਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "बिप्रन बेद सरूप बखाना ॥",
      "sourceLineId": "101359",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਛਤ੍ਰਿ ਜੁਧ ਰੂਪ ਕਰਿ ਜਾਨਾ ॥",
      "transliteration": "chhatr judh roop kar jaanaa ||",
      "translation": "The Brahmins considered him as Veda and Kshatriyas as war",
      "punjabiViakhya": "ਅਤੇ ਛਤ੍ਰੀਆਂ ਨੇ ਯੁੱਧ ਰੂਪ ਕਰ ਕੇ ਜਾਣਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "छतृ जुध रूप करि जाना ॥",
      "sourceLineId": "101360",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਉਨ ਜਉਨ ਜਿਹ ਭਾਤਿ ਬਿਚਾਰਾ ॥",
      "transliteration": "jaun jaun jeh bhaat bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਜੋ ਜਿਸ ਤਰ੍ਰਹਾ ਨਾਲ ਵਿਚਾਰ ਕਰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": "जउन जउन जिह भाति बिचारा ॥",
      "sourceLineId": "101361",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0625_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਉਨੈ ਕਾਛਿ ਕਾਛਿ ਅਨੁਹਾਰਾ ॥੧੫੬॥",
      "transliteration": "taunai kaachh kaachh anuhaaraa ||156||",
      "translation": "The person who thought of him in any manner, he presented himself in accordance with his desire.156.",
