{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 626,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0626_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਿਨਿ ਕੀਨੋ ਰਾਜਾ ॥",
      "transliteration": "bhaat bhaat tin keeno raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਤਰ੍ਰਹਾ ਤਰ੍ਰਹਾ ਦਾ ਰਾਜ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तिनि कीनो राजा ॥",
      "sourceLineId": "101363",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੇਸ ਦੇਸ ਕੇ ਜੀਤਿ ਸਮਾਜਾ ॥",
      "transliteration": "dhes dhes ke jeet samaajaa ||",
      "translation": "He ruled in various ways after conquering various countries far and near",
      "punjabiViakhya": "ਅਤੇ ਦੇਸ ਦੇਸਾਤਰਾ ਦੇ (ਰਾਜ) ਸਮਾਜ ਨੂੰ ਜਿਤ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "देस देस के जीति समाजा ॥",
      "sourceLineId": "101364",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਦੇਸ ਛਿਨਾਏ ॥",
      "transliteration": "bhaat bhaat ke dhes chhinaae ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਭਾਤ ਭਾਤ ਦੇ ਦੇਸ਼ ਖੋਹ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के देस छिनाए ॥",
      "sourceLineId": "101365",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪੈਗ ਪੈਗ ਪਰ ਜਗਿ ਕਰਾਏ ॥੧੫੭॥",
      "transliteration": "paig paig par jag karaae ||157||",
      "translation": "Seizing various countries, he performed Yajnas after short intervals.157.",
      "punjabiViakhya": "ਅਤੇ ਕਦਮ ਕਦਮ ਉਤੇ ਯੱਗ ਕਰਵਾਏ ॥੧੫੭॥",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "पैग पैग पर जगि कराए ॥१५७॥",
      "sourceLineId": "101366",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪਗ ਪਗ ਜਗਿ ਖੰਭ ਕਹੁ ਗਾਡਾ ॥",
      "transliteration": "pag pag jag kha(n)bh kahu gaaddaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਦਮ ਕਦਮ ਉਤੇ ਯੱਗ ਦੇ ਖੰਭਿਆਂ ਨੂੰ ਗਡਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "पग पग जगि खंभ कहु गाडा ॥",
      "sourceLineId": "101367",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਡਗ ਡਗ ਹੋਮ ਮੰਤ੍ਰ ਕਰਿ ਛਾਡਾ ॥",
      "transliteration": "ddag ddag hom ma(n)tr kar chhaaddaa ||",
      "translation": "He got planted the columns of Yajnas at short distances and performed heaven at various places by reciting mantras",
      "punjabiViakhya": "ਅਤੇ ਪੈਰ ਪੈਰ ਉਤੇ ਮੰਤਰਾ ਸਹਿਤ ਹੋਮ ਕਰਵਾ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "डग डग होम मंत्र करि छाडा ॥",
      "sourceLineId": "101368",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਐਸੀ ਧਰਾ ਨ ਦਿਖੀਅਤ ਕੋਈ ॥",
      "transliteration": "aaisee dharaa na dhikheeat koiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਜਿਹੀ ਕੋਈ ਵੀ ਧਰਤੀ ਨਹੀਂ ਦਿਖਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "ऐसी धरा न दिखीअत कोई ॥",
      "sourceLineId": "101369",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਗਿ ਖੰਭ ਜਿਹ ਠਉਰ ਨ ਹੋਈ ॥੧੫੮॥",
      "transliteration": "jag kha(n)bh jeh Thaur na hoiee ||158||",
      "translation": "No part of the earth was visible, where no columns of Yajnas were seen.158.",
      "punjabiViakhya": "ਜਿਥੇ ਯੱਗ ਦਾ ਖੰਭਾ ਨਾ ਗਡਿਆ ਗਿਆ ਹੋਵੇ ॥੧੫੮॥",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "जगि खंभ जिह ठउर न होई ॥१५८॥",
      "sourceLineId": "101370",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗਵਾਲੰਭ ਬਹੁ ਜਗ ਕਰੇ ਬਰ ॥",
      "transliteration": "gavaala(n)bh bahu jag kare bar ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਸਾਰੇ ਸ੍ਰੇਸ਼ਠ ਗੋਮੇਧ ('ਗਵਾਲੰਭ') ਯੱਗ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "गवालंभ बहु जग करे बर ॥",
      "sourceLineId": "101371",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬ੍ਰਹਮਣ ਬੋਲਿ ਬਿਸੇਖ ਧਰਮਧਰ ॥",
      "transliteration": "brahaman bol bisekh dharamadhar ||",
      "translation": "Inviting superb Brahmins, he performed many Gomedh Yajnas",
      "punjabiViakhya": "ਅਤੇ ਵਿਸ਼ੇਸ਼ ਧਰਮਧਾਰੀ (ਬ੍ਰਾਹਮਣ) ਬੁਲਾ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "ब्रहमण बोलि बिसेख धरमधर ॥",
      "sourceLineId": "101372",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਾਜਮੇਧ ਬਹੁ ਬਾਰਨ ਕੀਨੇ ॥",
      "transliteration": "baajamedh bahu baaran keene ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਵਾਰ ਅਸ਼੍ਵਮੇਧ ਯੱਗ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "बाजमेध बहु बारन कीने ॥",
      "sourceLineId": "101373",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਭੂਯ ਕੇ ਰਸ ਲੀਨੇ ॥੧੫੯॥",
      "transliteration": "bhaat bhaat bhooy ke ras leene ||159||",
      "translation": "Enjoying various types of the luxuries of the earth, he also performed Ashvamedh Yajnas many times.159.",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦੇ ਭੂਮੀ ਦੇ ਰਸ ਮਾਣੇ ॥੧੫੯॥",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "भाति भाति भूय के रस लीने ॥१५९॥",
      "sourceLineId": "101374",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗਜਾ ਮੇਧ ਬਹੁ ਕਰੇ ਜਗਿ ਤਿਹ ॥",
      "transliteration": "gajaa medh bahu kare jag teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਬਹੁਤ ਵਾਰ ਗਜ-ਮੇਧ ਯੱਗ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "गजा मेध बहु करे जगि तिह ॥",
      "sourceLineId": "101375",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਜਾ ਮੇਧ ਤੇ ਸਕੈ ਨ ਗਨ ਕਿਹ ॥",
      "transliteration": "ajaa medh te sakai na gan keh ||",
      "translation": "He also performed Gajmedh Yajnas and he performed Ajaamedh Yajnas so many times that they cannot be enumerated",
      "punjabiViakhya": "ਅਤੇ ਅਜਾ-ਮੇਧ (ਬਕਰੇ ਦੀ ਬਲੀ ਵਾਲੇ) ਯੱਗ ਕਿਤਨੇ ਕੀਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "अजा मेध ते सकै न गन किह ॥",
      "sourceLineId": "101376",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗਵਾਲੰਭ ਕਰਿ ਬਿਧਿ ਪ੍ਰਕਾਰੰ ॥",
      "transliteration": "gavaala(n)bh kar bidh prakaara(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੀ) ਗਿਣਤੀ ਨਹੀਂ ਹੋ ਸਕਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "गवालंभ करि बिधि प्रकारं ॥",
      "sourceLineId": "101377",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪਸੁ ਅਨੇਕ ਮਾਰੇ ਤਿਹ ਬਾਰੰ ॥੧੬੦॥",
      "transliteration": "pas anek maare teh baara(n) ||160||",
      "translation": "Performing Gomedh Yajnas in various ways, he sacrificed many animals.160.",
      "punjabiViakhya": "ਅਨੇਕ ਤਰ੍ਰਹਾ ਦੇ ਗੋਮੇਧ ਯੱਗ ਕੀਤੇ ਅਤੇ ਉਨ੍ਰਹਾ ਅਵਸਰਾ ਉਤੇ ਬਹੁਤ ਪਸ਼ੂ ਮਾਰੇ ਗਏ ॥੧੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "पसु अनेक मारे तिह बारं ॥१६०॥",
      "sourceLineId": "101378",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਾਜਸੂਅ ਕਰਿ ਬਿਬਿਧ ਪ੍ਰਕਾਰੰ ॥",
      "transliteration": "raajasooa kar bibidh prakaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੇਕ ਤਰ੍ਰਹਾ ਦੇ ਰਾਜਸੂ ਯੱਗ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "राजसूअ करि बिबिध प्रकारं ॥",
      "sourceLineId": "101379",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦੁਤੀਆ ਇੰਦ੍ਰ ਰਘੁ ਰਾਜ ਅਪਾਰੰ ॥",
      "transliteration": "dhuteeaa i(n)dhr ragh raaj apaara(n) ||",
      "translation": "Performing many Raajsu Yajnas, the king Raghu seemed like a second Indra",
      "punjabiViakhya": "(ਜਿਸ ਦੇ ਫਲਸਰੂਪ) ਮਹਾਨ ਰਘੁਰਾਜ ਨੂੰ ਦੂਜਾ ਇੰਦਰ ਮੰਨਿਆ ਜਾਣ ਲਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "दुतीआ इंद्र रघु राज अपारं ॥",
      "sourceLineId": "101380",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਬਿਧਵਤ ਦਾਨਾ ॥",
      "transliteration": "bhaat bhaat ke bidhavat dhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦੇ ਵਿਧੀ ਪੂਰਵਕ ਦਾਨ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के बिधवत दाना ॥",
      "sourceLineId": "101381",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕਰ ਤੀਰਥ ਨਾਨਾ ॥੧੬੧॥",
      "transliteration": "bhaat bhaat kar teerath naanaa ||161||",
      "translation": "After taking baths at different pilgrim-stations, he bestowed various types of charities according to Vedic injunctions.161.",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦੇ ਤੀਰਥ ਇਸ਼ਨਾਨ ਕੀਤੇ ॥੧੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "भाति भाति कर तीरथ नाना ॥१६१॥",
      "sourceLineId": "101382",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਰਬ ਤੀਰਥ ਪਰਿ ਪਾਵਰ ਬਾਧਾ ॥",
      "transliteration": "sarab teerath par paavar baadhaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਤੀਰਥਾ ਉਤੇ ਪੱਕੀਆਂ ਪੌੜੀਆਂ ('ਪਾਵਰ') ਬਣਵਾਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "सरब तीरथ परि पावर बाधा ॥",
      "sourceLineId": "101383",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅੰਨ ਛੇਤ੍ਰ ਘਰਿ ਘਰਿ ਮੈ ਸਾਧਾ ॥",
      "transliteration": "a(n)n chhetr ghar ghar mai saadhaa ||",
      "translation": "He got built places for drinking water at all the pilgrim-stations and stores of corn in every home,",
      "punjabiViakhya": "ਅਤੇ ਘਰ ਘਰ ਵਿਚ ਅੰਨ ਦਾ ਛੇਤਰ ਬਣਾ ਦਿੱਤਾ (ਅਰਥਾਤ ਅੰਨ ਦੇ ਭੰਡਾਰ ਭਰ ਦਿੱਤੇ)।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "अंन छेत्र घरि घरि मै साधा ॥",
      "sourceLineId": "101384",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਆਸਾਵੰਤ ਕਹੂੰ ਕੋਈ ਆਵੈ ॥",
      "transliteration": "aasaava(n)t kahoo(n) koiee aavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਕੋਈ ਆਸਾਵੰਤ ਕਿਧਰੋਂ ਆਉਾਂਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "आसावंत कहूँ कोई आवै ॥",
      "sourceLineId": "101385",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਤਛਿਨ ਮੁਖ ਮੰਗੈ ਸੋ ਪਾਵੈ ॥੧੬੨॥",
      "transliteration": "tatachhin mukh ma(n)gai so paavai ||162||",
      "translation": "So that if anyone comes with any desire, he may be able to obtain the desired thing.162.",
      "punjabiViakhya": "ਤਾ ਉਸੇ ਵੇਲੇ ਉਹ ਮੂੰਹ ਮੰਗਿਆ (ਪਦਾਰਥ) ਪ੍ਰਾਪਤ ਕਰਦਾ ॥੧੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "ततछिन मुख मंगै सो पावै ॥१६२॥",
      "sourceLineId": "101386",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭੂਖ ਨਾਗ ਕੋਈ ਰਹਨ ਨ ਪਾਵੈ ॥",
      "transliteration": "bhookh naag koiee rahan na paavai ||",
      "translation": "",
      "punjabiViakhya": "ਭੁਖਾ ਅਤੇ ਨੰਗਾ ਕੋਈ ਰਿਹਾ ਨਹੀਂ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "भूख नाग कोई रहन न पावै ॥",
      "sourceLineId": "101387",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭੂਪਤਿ ਹੁਐ ਕਰਿ ਰੰਕ ਸਿਧਾਵੈ ॥",
      "transliteration": "bhoopat huaai kar ra(n)k sidhaavai ||",
      "translation": "Nobody should remain hungry or naked and any beggar who came, may return like a king",
      "punjabiViakhya": "ਅਤੇ ਭਿਖਾਰੀ ਵੀ ਰਾਜਾ ਬਣ ਕੇ ਪਰਤਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "भूपति हुऐ करि रंक सिधावै ॥",
      "sourceLineId": "101388",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਹੁਰ ਦਾਨ ਕਹ ਕਰ ਨ ਪਸਾਰਾ ॥",
      "transliteration": "bahur dhaan keh kar na pasaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ (ਉਸ ਨੇ) ਕਿਸੇ ਅਗੇ ਦਾਨ ਮੰਗਣ ਲਈ ਹੱਥ ਨਹੀਂ ਪਸਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "बहुर दान कह कर न पसारा ॥",
      "sourceLineId": "101389",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਏਕ ਬਾਰਿ ਰਘੁ ਰਾਜ ਨਿਹਾਰਾ ॥੧੬੩॥",
      "transliteration": "ek baar ragh raaj nihaaraa ||163||",
      "translation": "The king Raghu had such administration that anyone, who would see him once, he would become able to bestow charities himself on others.163.",
      "punjabiViakhya": "(ਜਿਸ ਨੇ) ਇਕ ਵਾਰ ਰਘੂਰਾਜ ਦੇ ਦਰਸ਼ਨ ਕਰ ਲਏ ॥੧੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "एक बारि रघु राज निहारा ॥१६३॥",
      "sourceLineId": "101390",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸ੍ਵਰਣ ਦਾਨ ਦੇ ਬਿਬਿਧ ਪ੍ਰਕਾਰਾ ॥",
      "transliteration": "savairan dhaan dhe bibidh prakaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੇਕ ਤਰ੍ਰਹਾ ਨਾਲ ਸੋਨੇ ਦਾ ਦਾਨ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "स्वरण दान दे बिबिध प्रकारा ॥",
      "sourceLineId": "101391",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰੁਕਮ ਦਾਨ ਨਹੀ ਪਾਯਤ ਪਾਰਾ ॥",
      "transliteration": "rukam dhaan nahee paayat paaraa ||",
      "translation": "He gave gifts of gold and silver in various ways",
      "punjabiViakhya": "ਅਤੇ ਚਾਦੀ ਦੇ ਦਾਨ ਦਾ ਤਾ ਕੋਈ ਅੰਤ ਹੀ ਨਹੀਂ ਪਾਇਆ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "रुकम दान नही पायत पारा ॥",
      "sourceLineId": "101392",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਾਜਿ ਸਾਜਿ ਬਹੁ ਦੀਨੇ ਬਾਜਾ ॥",
      "transliteration": "saaj saaj bahu dheene baajaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਜਾ ਸਜਾ ਕੇ ਬਹੁਤ ਸਾਰੇ ਘੋੜੇ (ਦਾਨ ਦਿੱਤੇ)।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "साजि साजि बहु दीने बाजा ॥",
      "sourceLineId": "101393",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਨ ਸਭ ਕਰੇ ਰੰਕ ਰਘੁ ਰਾਜਾ ॥੧੬੪॥",
      "transliteration": "jan sabh kare ra(n)k ragh raajaa ||164||",
      "translation": "He gave so much to everyone that the recipient became like a king form the status of poor.164.",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ) ਮਾਨੋ ਰਘੂ ਨੇ ਸਭ ਰੰਕਾ ਨੂੰ ਰਾਜਾ ਬਣਾ ਦਿੱਤਾ ਹੋਵੇ ॥੧੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "जन सभ करे रंक रघु राजा ॥१६४॥",
      "sourceLineId": "101394",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਸਤ ਦਾਨ ਅਰ ਉਸਟਨ ਦਾਨਾ ॥",
      "transliteration": "hasat dhaan ar usaTan dhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਥੀਆਂ ਦਾ ਦਾਨ, ਊਠਾ ਦਾ ਦਾਨ,",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "हसत दान अर उसटन दाना ॥",
      "sourceLineId": "101395",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗਊ ਦਾਨ ਬਿਧਿਵਤ ਇਸਨਾਨਾ ॥",
      "transliteration": "guoo dhaan bidhivat isanaanaa ||",
      "translation": "He would take bath according to Shastric injunctions and then give gifts of elephants, camels and cows",
      "punjabiViakhya": "ਗਊਆਂ ਦਾ ਦਾਨ ਅਤੇ ਮਰਯਾਦਾ ਅਨੁਸਾਰ ਇਸ਼ਨਾਨ,",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "गऊ दान बिधिवत इसनाना ॥",
      "sourceLineId": "101396",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹੀਰ ਚੀਰ ਦੇ ਦਾਨ ਅਪਾਰਾ ॥",
      "transliteration": "heer cheer dhe dhaan apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਹੀਰਿਆਂ ਅਤੇ ਬਸਤ੍ਰਾ ਦੇ ਅਪਾਰ ਦਾਨ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "हीर चीर दे दान अपारा ॥",
      "sourceLineId": "101397",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮੋਹ ਸਬੈ ਮਹਿ ਮੰਡਲ ਡਾਰਾ ॥੧੬੫॥",
      "transliteration": "moh sabai meh ma(n)ddal ddaaraa ||165||",
      "translation": "By bestowing gifts of various types of garments, he had fascinated the whole earth.165.",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ ਕਰ ਕੇ ਰਘੂਰਾਜੇ ਨੇ) ਪ੍ਰਿਥਵੀ ਮੰਡਲ ਵਿਚ ਰਹਿਣ ਵਾਲਿਆਂ ਸਾਰਿਆਂ ਨੂੰ ਮੋਹ ਲਿਆ ॥੧੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "मोह सबै महि मंडल डारा ॥१६५॥",
      "sourceLineId": "101398",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਾਜੀ ਦੇਤ ਗਜਨ ਕੇ ਦਾਨਾ ॥",
      "transliteration": "baajee dhet gajan ke dhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜਿਆਂ ਅਤੇ ਹਾਥੀਆਂ ਦਾ ਦਾਨ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "बाजी देत गजन के दाना ॥",
      "sourceLineId": "101399",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਦੀਨਨ ਸਨਮਾਨਾ ॥",
      "transliteration": "bhaat bhaat dheenan sanamaanaa ||",
      "translation": "By honouring various types of the lowly, he gave horses and elephants in charity",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦਾ ਦੀਨਾ ਦੁਖੀਆਂ ਦਾ ਸਨਮਾਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "भाति भाति दीनन सनमाना ॥",
      "sourceLineId": "101400",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੂਖ ਭੂਖ ਕਾਹੂੰ ਨ ਸੰਤਾਵੈ ॥",
      "transliteration": "dhookh bhookh kaahoo(n) na sa(n)taavai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੂੰ ਵੀ ਭੁਖ ਦਾ ਦੁਖ ਨਹੀਂ ਸਤਾਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "दूख भूख काहूँ न संतावै ॥",
      "sourceLineId": "101401",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜੋ ਮੁਖ ਮਾਗੈ ਵਹ ਬਰੁ ਪਾਵੈ ॥੧੬੬॥",
      "transliteration": "jo mukh maagai veh bar paavai ||166||",
      "translation": "None was afflicted with suffering and hunger and whosoever asked with suffering and hunger and whosoever asked for anything, he obtained the same.166.",
      "punjabiViakhya": "ਮੂੰਹੋਂ ਜੋ ਕੁਝ ਵੀ ਕੋਈ ਮੰਗਦਾ ਸੀ, ਉਹੀ ਵਰ ਪ੍ਰਾਪਤ ਕਰ ਲੈਂਦਾ ਸੀ ॥੧੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "जो मुख मागै वह बरु पावै ॥१६६॥",
      "sourceLineId": "101402",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦਾਨ ਸੀਲ ਕੋ ਜਾਨ ਪਹਾਰਾ ॥",
      "transliteration": "dhaan seel ko jaan pahaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਰਘੁਰਾਜ ਦਾਨ ਅਤੇ ਚੰਗੇ ਸੁਭਾ ਦਾ ਪਹਾੜ ਜਾਣਿਆ ਜਾਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "दान सील को जान पहारा ॥",
      "sourceLineId": "101403",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦਇਆ ਸਿੰਧ ਰਘੁ ਰਾਜ ਭੁਆਰਾ ॥",
      "transliteration": "dhiaa si(n)dh ragh raaj bhuaaraa ||",
      "translation": "The king Raghu was the abode of charity and gentleness and an ocean of mercy on this earth",
      "punjabiViakhya": "ਅਤੇ ਦਇਆ ਦਾ ਸਮੁੰਦਰ (ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ)।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "दइआ सिंध रघु राज भुआरा ॥",
      "sourceLineId": "101404",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੁੰਦਰ ਮਹਾ ਧਨੁਖ ਧਰ ਆਛਾ ॥",
      "transliteration": "su(n)dhar mahaa dhanukh dhar aachhaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬਹੁਤ ਸੁੰਦਰ ਅਤੇ ਸ੍ਰੇਸ਼ਠ ਧਨੁਸ਼ਧਾਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "सुँदर महा धनुख धर आछा ॥",
      "sourceLineId": "101405",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਨੁ ਅਲਿਪਨਚ ਕਾਛ ਤਨ ਕਾਛਾ ॥੧੬੭॥",
      "transliteration": "jan alipanach kaachh tan kaachhaa ||167||",
      "translation": "He was a great and expert archer and a glorious king, always remaining detached.167.",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਕਾਮ ਦੇਵ ('ਅਲਿਪਨਚ') ਨੇ ਹੀ ਸੁੰਦਰ ਰੂਪ ਬਣਾਇਆ ਹੋਵੇ ॥੧੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "जनु अलिपनच काछ तन काछा ॥१६७॥",
      "sourceLineId": "101406",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਿਤਿ ਉਠਿ ਕਰਤ ਦੇਵ ਕੀ ਪੂਜਾ ॥",
      "transliteration": "nit uTh karat dhev kee poojaa ||",
      "translation": "",
      "punjabiViakhya": "ਨਿੱਤ ਉਠ ਕੇ ਕੇਵੜੇ ਅਤੇ ਗੁਲਾਬ ਦੇ ਫੁਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "निति उठि करत देव की पूजा ॥",
      "sourceLineId": "101407",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਫੂਲ ਗੁਲਾਬ ਕੇਵੜਾ ਕੂਜਾ ॥",
      "transliteration": "fool gulaab kevaRaa koojaa ||",
      "translation": "He always worshipped the goddess with roses, pandanus and sugar-candyy",
      "punjabiViakhya": "ਅਤੇ ਮਿਸ਼ਰੀ ਨਾਲ ਦੇਵ-ਪੂਜਾ ਕਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "फूल गुलाब केवड़ा कूजा ॥",
      "sourceLineId": "101408",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਨਿਤਿ ਸੀਸ ਲਗਾਵੈ ॥",
      "transliteration": "charan kamal nit sees lagaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਦੇਵੀ ਦੇ) ਚਰਨ ਕਮਲਾ ਉਤੇ ਸੀਸ ਲਗਾਉਾਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "चरन कमल निति सीस लगावै ॥",
      "sourceLineId": "101409",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪੂਜਨ ਨਿਤ ਚੰਡਿਕਾ ਆਵੈ ॥੧੬੮॥",
      "transliteration": "poojan nit cha(n)ddikaa aavai ||168||",
      "translation": "And while worshipping, he touched her lotus-feet with his head.168.",
      "punjabiViakhya": "ਅਤੇ ਨਿੱਤ ਚੰਡੀ ਦੀ ਪੂਜਾ ਕਰਨ ਲਈ (ਮੰਦਿਰ ਵਿਚ) ਆਉਾਂਦਾ ਸੀ ॥੧੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "पूजन नित चंडिका आवै ॥१६८॥",
      "sourceLineId": "101410",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਧਰਮ ਰੀਤਿ ਸਬ ਠੌਰ ਚਲਾਈ ॥",
      "transliteration": "dharam reet sab Thauar chalaiee ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਥਾ (ਉਸ ਨੇ) ਧਰਮ ਦੀ ਰੀਤ ਚਲਾਈ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "धरम रीति सब ठौर चलाई ॥",
      "sourceLineId": "101411",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਤ੍ਰ ਤਤ੍ਰ ਸੁਖ ਬਸੀ ਲੁਗਾਈ ॥",
      "transliteration": "jatr tatr sukh basee lugaiee ||",
      "translation": "He introduced the religious traditions at all places and all the people lived peacefully everywhere",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਪ੍ਰਜਾ ਸੁਖ ਨਾਲ ਵਸਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "जत्र तत्र सुख बसी लुगाई ॥",
      "sourceLineId": "101412",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਭੂਖ ਨਾਗ ਕੋਈ ਕਹੂੰ ਨ ਦੇਖਾ ॥",
      "transliteration": "bhookh naag koiee kahoo(n) na dhekhaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਕੋਈ ਭੁਖਾ ਨੰਗਾ ਨਹੀਂ ਦਿਸਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "भूख नाग कोई कहूँ न देखा ॥",
      "sourceLineId": "101413",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਊਚ ਨੀਚ ਸਬ ਧਨੀ ਬਿਸੇਖਾ ॥੧੬੯॥",
      "transliteration": "uooch neech sab dhanee bisekhaa ||169||",
      "translation": "There did not seem to be any hungry and naked, high and low and everyone seemed to be a self-sufficient person.169.",
      "punjabiViakhya": "ਊਚ ਅਤੇ ਨੀਚ ਵਿਸ਼ੇਸ਼ ਰੂਪ ਵਿਚ ਧਨਵਾਨ ਸਨ ॥੧੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "ऊच नीच सब धनी बिसेखा ॥१६९॥",
      "sourceLineId": "101414",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਹ ਤਹ ਧਰਮ ਧੁਜਾ ਫਹਰਾਈ ॥",
      "transliteration": "jeh teh dharam dhujaa faharaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਧਰਮ ਧੁਜਾਵਾ ਝੂਲਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "जह तह धरम धुजा फहराई ॥",
      "sourceLineId": "101415",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਚੋਰ ਜਾਰ ਨਹ ਦੇਤ ਦਿਖਾਈ ॥",
      "transliteration": "chor jaar neh dhet dhikhaiee ||",
      "translation": "The religious banners fluttered everywhere and there seemed to be no thief or Thug anywhere",
      "punjabiViakhya": "ਚੋਰ ਅਤੇ ਯਾਰ (ਕਿਤੇ ਵੀ) ਵਿਖਾਈ ਨਹੀਂ ਦਿੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "चोर जार नह देत दिखाई ॥",
      "sourceLineId": "101416",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਹ ਤਹ ਯਾਰ ਚੋਰ ਚੁਨਿ ਮਾਰਾ ॥",
      "transliteration": "jeh teh yaar chor chun maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਚੁਣ ਚੁਣ ਕੇ ਚੋਰ ਅਤੇ ਯਾਰ ਮਾਰ ਦਿੱਤੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "जह तह यार चोर चुनि मारा ॥",
      "sourceLineId": "101417",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਏਕ ਦੇਸਿ ਕਹੂੰ ਰਹੈ ਨ ਪਾਰਾ ॥੧੭੦॥",
      "transliteration": "ek dhes kahoo(n) rahai na paaraa ||170||",
      "translation": "He had picked up and killed all the thieves and Thugs and had established one-canopy kingdom.170.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਦੇਸ਼ ਵਿਚ ਕਿਤੇ ਕੋਈ ਇਕ ਵੀ ਰਹਿ ਨਹੀਂ ਪਾਇਆ ਸੀ ॥੧੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "एक देसि कहूँ रहै न पारा ॥१७०॥",
      "sourceLineId": "101418",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਸਾਧ ਓਰਿ ਕੋਈ ਦਿਸਟਿ ਨ ਪੇਖਾ ॥",
      "transliteration": "saadh or koiee dhisaT na pekhaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਧ (ਲੋਕਾ) ਵਲ ਕੋਈ ਅੱਖ ਚੁਕ ਕੇ ਨਹੀਂ ਵੇਖਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "साध ओरि कोई दिसटि न पेखा ॥",
      "sourceLineId": "101419",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਐਸ ਰਾਜ ਰਘੁ ਰਾਜ ਬਿਸੇਖਵਾ ॥",
      "transliteration": "aais raaj ragh raaj bisekhavaa ||",
      "translation": "The kingdom of king Raghu was such that the differentiation of a saint and a thief did not exist there and all were saits",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਰਘੂਰਾਜ ਦਾ ਵਿਸ਼ੇਸ਼ ਰਾਜ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "ऐस राज रघु राज बिसेखवा ॥",
      "sourceLineId": "101420",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਚਾਰੋ ਦਿਸਾ ਚਕ੍ਰ ਫਹਰਾਵੈ ॥",
      "transliteration": "chaaro dhisaa chakr faharaavai ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ ਪਾਸੇ (ਉਸ ਦੇ ਸ਼ਾਸਨ ਦਾ) ਚੱਕਰ ਫਿਰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "चारो दिसा चक्र फहरावै ॥",
      "sourceLineId": "101421",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਪਾਪਿਨ ਕਾਟਿ ਮੂੰਡ ਫਿਰਿ ਆਵੈ ॥੧੭੧॥",
      "transliteration": "paapin kaaT moo(n)dd fir aavai ||171||",
      "translation": "His discus fluttered in all the four directions, which returned only on cutting the heads of the sinners.171.",
      "punjabiViakhya": "ਜੋ ਪਾਪੀਆਂ ਦੇ ਸਿਰ ਕਟ ਕੇ ਪਰਤ ਆਉਾਂਦਾ ਸੀ ॥੧੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "पापिन काटि मूँड फिरि आवै ॥१७१॥",
      "sourceLineId": "101422",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਗਾਇ ਸਿੰਘ ਕਹੁ ਦੂਧ ਪਿਲਾਵੈ ॥",
      "transliteration": "gai si(n)gh kahu dhoodh pilaavai ||",
      "translation": "",
      "punjabiViakhya": "ਗਊ ਸ਼ੇਰ (ਦੇ ਬੱਚੇ) ਨੂੰ ਦੁੱਧ ਚੁੰਘਾਉਾਂਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "गाइ सिंघ कहु दूध पिलावै ॥",
      "sourceLineId": "101423",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਸਿੰਘ ਗਊ ਕਹ ਘਾਸੁ ਚੁਗਾਵੈ ॥",
      "transliteration": "si(n)gh guoo keh ghaas chugaavai ||",
      "translation": "The cow caused the lion to drink milk and the lion supervised the cow while grazing",
      "punjabiViakhya": "ਅਤੇ ਸ਼ੇਰ ਗਊ ਨੂੰ ਘਾਹ ਚਰਾਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "सिंघ गऊ कह घासु चुगावै ॥",
      "sourceLineId": "101424",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਚੋਰ ਕਰਤ ਧਨ ਕੀ ਰਖਵਾਰਾ ॥",
      "transliteration": "chor karat dhan kee rakhavaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਚੋਰ ਧਨ ਦੀ ਰਾਖੀ ਕਰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "चोर करत धन की रखवारा ॥",
      "sourceLineId": "101425",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਤ੍ਰਾਸ ਮਾਰਿ ਕੋਈ ਹਾਥੁ ਨ ਡਾਰਾ ॥੧੭੨॥",
      "transliteration": "traas maar koiee haath na ddaaraa ||172||",
      "translation": "The persons considered to be thieves now protected the wealth and none committed any wrong act because of the fear of punishment.172.",
      "punjabiViakhya": "ਅਤੇ ਸਜ਼ਾ ਦੇ ਡਰ ਕਰ ਕੇ ਕੋਈ (ਕਿਸੇ ਦੇ ਧਨ ਨੂੰ) ਹੱਥ ਨਹੀਂ ਸੀ ਪਾਉਾਂਦਾ ॥੧੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "त्रास मारि कोई हाथु न डारा ॥१७२॥",
      "sourceLineId": "101426",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਨਾਰਿ ਪੁਰਖ ਸੋਵਤ ਇਕ ਸੇਜਾ ॥",
      "transliteration": "naar purakh sovat ik sejaa ||",
      "translation": "",
      "punjabiViakhya": "ਨਾਰੀ ਅਤੇ ਪੁਰਸ਼ ਇਕ ਸੇਜ ਉਤੇ ਸੌਂਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "नारि पुरख सोवत इक सेजा ॥",
      "sourceLineId": "101427",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਹਾਥ ਪਸਾਰ ਨ ਸਾਕਤ ਰੇਜਾ ॥",
      "transliteration": "haath pasaar na saakat rejaa ||",
      "translation": "The men and women slept peacefully in their beds and none begged for anything from others",
      "punjabiViakhya": "ਪਰ (ਬਿਨਾ ਇਸਤਰੀ ਦੀ ਇੱਛਾ ਦੇ ਪੁਰਸ਼) ਜ਼ਰਾ ਜਿੰਨਾ ਵੀ ਹੱਥ ਨਹੀਂ ਪਸਾਰ ਸਕਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "हाथ पसार न साकत रेजा ॥",
      "sourceLineId": "101428",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਪਾਵਕ ਘ੍ਰਿਤ ਇਕ ਠਉਰ ਰਖਾਏ ॥",
      "transliteration": "paavak ghirat ik Thaur rakhaae ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਗ ਅਤੇ ਘਿਉ ਨੂੰ ਇਕ ਥਾ ਰਖਿਆ ਜਾਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "पावक घृत इक ठउर रखाए ॥",
      "sourceLineId": "101429",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਰਾਜ ਤ੍ਰਾਸ ਤੇ ਢਰੈ ਨ ਪਾਏ ॥੧੭੩॥",
      "transliteration": "raaj traas te ddarai na paae ||173||",
      "translation": "The ghee and fire lived at the same places, and did not damage each other because of the fear of the king.173.",
      "punjabiViakhya": "ਪਰ ਰਾਜੇ ਦੇ ਡਰ ਕਰ ਕੇ (ਘਿਉ) ਪੰਘਰਦਾ ਨਹੀਂ ਸੀ ॥੧੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "राज त्रास ते ढरै न पाए ॥१७३॥",
      "sourceLineId": "101430",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਚੋਰ ਸਾਧ ਮਗ ਏਕ ਸਿਧਾਰੈ ॥",
      "transliteration": "chor saadh mag ek sidhaarai ||",
      "translation": "",
      "punjabiViakhya": "ਚੋਰ ਅਤੇ ਸਾਧ ਇਕੋ ਰਸਤੇ ਉਤੇ ਚਲਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": "चोर साध मग एक सिधारै ॥",
      "sourceLineId": "101431",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0626_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਤ੍ਰਾਸ ਤ੍ਰਸਤ ਕਰੁ ਕੋਈ ਨ ਡਾਰੈ ॥",
      "transliteration": "traas trasat kar koiee na ddaarai ||",
      "translation": "The thief and saints moved together and none frightened any fear because of the fear of the administration",
      "punjabiViakhya": "(ਪਰ ਰਾਜੇ ਦੇ) ਪ੍ਰਕੋਪ ਤੋਂ ਡਰਦਿਆਂ ਕੋਈ ਹੱਥ ਨਹੀਂ ਸੀ ਪਾਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 626,
