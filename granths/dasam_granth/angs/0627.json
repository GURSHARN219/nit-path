{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 627,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0627_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਰਾਜੁ ਕਰ੍ਯੋ ਰਘੁ ਰਾਜਾ ॥",
      "transliteration": "eeh bidh raaj karayo ragh raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਰਘੂਰਾਜ ਨੇ ਰਾਜ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "इह बिधि राजु कर्यो रघु राजा ॥",
      "sourceLineId": "101435",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦਾਨ ਨਿਸਾਨ ਚਹੂੰ ਦਿਸ ਬਾਜਾ ॥",
      "transliteration": "dhaan nisaan chahoo(n) dhis baajaa ||",
      "translation": "The king Raghu ruled in this way and the fame of his charity spread in all the four directions",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੀ ਦਾਨਸ਼ੀਲਤਾ ਦਾ ਧੌਂਸਾ ਚੌਹਾ ਪਾਸੇ ਵਜਦਾ ਰਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "दान निसान चहूँ दिस बाजा ॥",
      "sourceLineId": "101436",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚਾਰੋ ਦਿਸਾ ਬੈਠ ਰਖਵਾਰੇ ॥",
      "transliteration": "chaaro dhisaa baiTh rakhavaare ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ ਪਾਸਿਆਂ ਵਲ ਰਖਵਾਲੇ ਬੈਠੇ ਹੋਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "चारो दिसा बैठ रखवारे ॥",
      "sourceLineId": "101437",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਹਾਬੀਰ ਅਰੁ ਰੂਪ ਉਜਿਆਰੇ ॥੧੭੫॥",
      "transliteration": "mahaabeer ar roop ujiaare ||175||",
      "translation": "The mighty and elegant warriors protected him in all the four directions.175.",
      "punjabiViakhya": "ਜੋ ਬਹੁਤ ਬਲਵਾਨ ਅਤੇ ਓਜਸਵੀ ਸਰੂਪ ਵਾਲੇ ਸਨ ॥੧੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "महाबीर अरु रूप उजिआरे ॥१७५॥",
      "sourceLineId": "101438",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬੀਸ ਸਹੰਸ੍ਰ ਬਰਖ ਪਰਮਾਨਾ ॥",
      "transliteration": "bees saha(n)sr barakh paramaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਵੀਹ ਹਜ਼ਾਰ ਸਾਲਾ ਤਕ",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "बीस सहंस्र बरख परमाना ॥",
      "sourceLineId": "101439",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਾਜੁ ਕਰਾ ਦਸ ਚਾਰ ਨਿਧਾਨਾ ॥",
      "transliteration": "raaj karaa dhas chaar nidhaanaa ||",
      "translation": "That king, skilful in fourteen sciences, ruled for twenty thousand years",
      "punjabiViakhya": "ਚੌਦਾ ਵਿਦਿਆਵਾ ਦੇ ਖ਼ਜ਼ਾਨੇ (ਰਘੂਰਾਜ) ਨੇ ਰਾਜ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "राजु करा दस चार निधाना ॥",
      "sourceLineId": "101440",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭਾਤਿ ਅਨੇਕ ਕਰੇ ਨਿਤਿ ਧਰਮਾ ॥",
      "transliteration": "bhaat anek kare nit dharamaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਅਨੇਕ ਤਰ੍ਰਹਾ ਦੇ ਨਿੱਤ ਧਰਮ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "भाति अनेक करे निति धरमा ॥",
      "sourceLineId": "101441",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਔਰ ਨ ਸਕੈ ਐਸ ਕਰ ਕਰਮਾ ॥੧੭੬॥",
      "transliteration": "aauar na sakai aais kar karamaa ||176||",
      "translation": "He always performed the religious acts of this kind, which none other could perform.176.",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦੇ ਕਰਮ ਹੋਰ ਕੋਈ ਵੀ ਕਰ ਨਹੀਂ ਸਕਦਾ ਸੀ ॥੧੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "और न सकै ऐस कर करमा ॥१७६॥",
      "sourceLineId": "101442",
      "sourceShabadId": "9308",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪਾਧੜੀ ਛੰਦ ॥",
      "transliteration": "paadhaRee chha(n)dh ||",
      "translation": "PAADHARI STANZA",
      "punjabiViakhya": "ਪਾਧੜੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "पाधड़ी छंद ॥",
      "sourceLineId": "101443",
      "sourceShabadId": "9309",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਹੁ ਭਾਤਿ ਰਾਜੁ ਰਘੁਰਾਜ ਕੀਨ ॥",
      "transliteration": "eih bhaat raaj raghuraaj keen ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਰਘੂਰਾਜ ਨੇ ਰਾਜ ਕੀਤਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "इहु भाति राजु रघुराज कीन ॥",
      "sourceLineId": "101444",
      "sourceShabadId": "9309",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗਜ ਬਾਜ ਸਾਜ ਦੀਨਾਨ ਦੀਨ ॥",
      "transliteration": "gaj baaj saaj dheenaan dheen ||",
      "translation": "The king Raghu ruled in this way and gave in charity the elephants and horses to the poor",
      "punjabiViakhya": "ਅਤੇ ਘੋੜੇ ਤੇ ਹਾਥੀ ਸਜਾ ਕੇ ਦੀਨਾ ਅਨਾਥਾ ਨੂੰ ਦਾਨ ਦਿੱਤੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "गज बाज साज दीनान दीन ॥",
      "sourceLineId": "101445",
      "sourceShabadId": "9309",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨ੍ਰਿਪ ਜੀਤਿ ਜੀਤਿ ਲਿਨੇ ਅਪਾਰ ॥",
      "transliteration": "nirap jeet jeet line apaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਬੇਸ਼ੁਮਾਰ ਰਾਜੇ ਜਿਤ ਲਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "नृप जीति जीति लिने अपार ॥",
      "sourceLineId": "101446",
      "sourceShabadId": "9309",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਰਿ ਖੰਡ ਖੰਡ ਖੰਡੇ ਗੜਵਾਰ ॥੧੭੭॥",
      "transliteration": "kar kha(n)dd kha(n)dd kha(n)dde gaRavaar ||177||",
      "translation": "He conquered many kings and shattered many forts.177.",
      "punjabiViakhya": "ਅਤੇ ਕਿਲ੍ਰਹਿਆਂ ਵਾਲਿਆਂ ਰਾਜਿਆਂ ਨੂੰ ਖੰਡੇ ਨਾਲ ਖੰਡ ਖੰਡ ਕਰ ਦਿੱਤਾ ਸੀ ॥੧੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "करि खंड खंड खंडे गड़वार ॥१७७॥",
      "sourceLineId": "101447",
      "sourceShabadId": "9309",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਤਿ ਰਘੁ ਰਾਜ ਸਮਾਪਤਹਿ ॥੯॥੫॥",
      "transliteration": "eit ragh raaj samaapateh ||9||5||",
      "translation": "End of “The Rule of king Raghu.”",
      "punjabiViakhya": "ਇਥੇ ਰਘੂ ਦੇ ਰਾਜ ਦੀ ਸਮਾਪਤੀ ॥੯॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "इति रघु राज समापतहि ॥९॥५॥",
      "sourceLineId": "101448",
      "sourceShabadId": "9309",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਥ ਅਜ ਰਾਜਾ ਕੋ ਰਾਜ ਕਥਨੰ ॥",
      "transliteration": "ath aj raajaa ko raaj kathana(n) ||",
      "translation": "Now begins the description of the rule of king Aj",
      "punjabiViakhya": "ਹੁਣ ਅਜ ਰਾਜਾ ਦੇ ਰਾਜ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "अथ अज राजा को राज कथनं ॥",
      "sourceLineId": "101449",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪਾਧੜੀ ਛੰਦ ॥",
      "transliteration": "paadhaRee chha(n)dh ||",
      "translation": "PAADHARI STANZA",
      "punjabiViakhya": "ਪਾਧੜੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "पाधड़ी छंद ॥",
      "sourceLineId": "101450",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਫੁਨਿ ਭਏ ਰਾਜ ਅਜਰਾਜ ਬੀਰ ॥",
      "transliteration": "fun bhe raaj ajaraaj beer ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਅਜਰਾਜ ਸੂਰਬੀਰ ਰਾਜਾ ਬਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "फुनि भए राज अजराज बीर ॥",
      "sourceLineId": "101451",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਿਨਿ ਭਾਤਿ ਭਾਤਿ ਜਿਤੇ ਪ੍ਰਬੀਰ ॥",
      "transliteration": "jin bhaat bhaat jite prabeer ||",
      "translation": "Then there ruled the great and powerful king Aj, who destroyed several clans after conquering many heroes",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਭਾਤ ਭਾਤ ਦੇ ਬਹੁਤ ਬਲਵਾਨ ਵੀਰ ਜਿਤ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "जिनि भाति भाति जिते प्रबीर ॥",
      "sourceLineId": "101452",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਿਨੇ ਖਰਾਬ ਖਾਨੇ ਖਵਾਸ ॥",
      "transliteration": "kine kharaab khaane khavaas ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਕਿਤਨਿਆਂ ਦੇ ਰਣਵਾਸ ਅਤੇ ਖ਼ਾਨਦਾਨ ਨਸ਼ਟ ਕਰ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "किने खराब खाने खवास ॥",
      "sourceLineId": "101453",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਿਤੇ ਮਹੀਪ ਤੋਰੇ ਮਵਾਸ ॥੧॥",
      "transliteration": "jite maheep tore mavaas ||1||",
      "translation": "He also conquered the rebellious kings.1.",
      "punjabiViakhya": "ਅਤੇ ਰਾਜਿਆਂ ਨੂੰ ਜਿਤ ਕੇ ਘਮੰਡ ਤੋੜ ਦਿੱਤੇ (ਜਾ ਆਕੀ ਅਧੀਨ ਕਰ ਲਏ) ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "जिते महीप तोरे मवास ॥१॥",
      "sourceLineId": "101454",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਿਤੇ ਅਜੀਤ ਮੁੰਡੇ ਅਮੁੰਡ ॥",
      "transliteration": "jite ajeet mu(n)dde amu(n)dd ||",
      "translation": "",
      "punjabiViakhya": "ਨ ਜਿਤੇ ਜਾ ਸਕਣ ਵਾਲਿਆਂ ਨੂੰ ਜਿਤ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "जिते अजीत मुँडे अमुँड ॥",
      "sourceLineId": "101455",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਖੰਡੇ ਅਖੰਡ ਕਿਨੇ ਘਮੰਡ ॥",
      "transliteration": "kha(n)dde akha(n)dd kine ghama(n)dd ||",
      "translation": "He conquered many invincible kings and shattered the pride of many egoistic kings",
      "punjabiViakhya": "ਅਤੇ ਸਿਰਲਥ (ਸੂਰਬੀਰਾ) ਦੇ ਸਿਰ ਲਾਹ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "खंडे अखंड किने घमंड ॥",
      "sourceLineId": "101456",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦਸ ਚਾਰਿ ਚਾਰਿ ਬਿਦਿਆ ਨਿਧਾਨ ॥",
      "transliteration": "dhas chaar chaar bidhiaa nidhaan ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੇ ਨਾ ਖੰਡੇ ਜਾ ਸਕਣ ਕਾਰਨ ਘਮੰਡ ਕੀਤਾ ਹੋਇਆ ਸੀ, (ਉਨ੍ਰਹਾ ਨੂੰ) ਖੰਡਿਤ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "दस चारि चारि बिदिआ निधान ॥",
      "sourceLineId": "101457",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਜਰਾਜ ਰਾਜ ਰਾਜਾ ਮਹਾਨ ॥੨॥",
      "transliteration": "ajaraaj raaj raajaa mahaan ||2||",
      "translation": "The great king Aj was the ocean of fourteen sciences.2.",
      "punjabiViakhya": "ਅਠਾਰ੍ਰਹਾ ਵਿਦਿਆਵਾ ਦਾ ਖ਼ਜ਼ਾਨਾ ਅਜਰਾਜ ਬਹੁਤ ਵੱਡਾ ਰਾਜਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "अजराज राज राजा महान ॥२॥",
      "sourceLineId": "101458",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੂਰਾ ਸੁਬਾਹ ਜੋਧਾ ਪ੍ਰਚੰਡ ॥",
      "transliteration": "sooraa subaeh jodhaa pracha(n)dd ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬਲਵਾਨ ਸੂਰਮਾ ਅਤੇ ਪ੍ਰਚੰਡ ਯੋਧਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "सूरा सुबाह जोधा प्रचंड ॥",
      "sourceLineId": "101459",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸ੍ਰੁਤਿ ਸਰਬ ਸਾਸਤ੍ਰ ਬਿਦਿਆ ਉਦੰਡ ॥",
      "transliteration": "srut sarab saasatr bidhiaa udha(n)dd ||",
      "translation": "That king was a powerful warrior and expert in the study of Shrutis (Vedas) and Shastras",
      "punjabiViakhya": "ਵੇਦਾ ('ਸ੍ਰੁਤਿ') ਅਤੇ ਸਾਰਿਆਂ ਸ਼ਾਸਤ੍ਰਾ ਅਤੇ ਵਿਦਿਆਵਾ ਦਾ ਪ੍ਰਕਾਡ ਵਿਦਵਾਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "स्रुति सरब सासत्र बिदिआ उदंड ॥",
      "sourceLineId": "101460",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਾਨੀ ਮਹਾਨ ਸੁੰਦਰ ਸਰੂਪ ॥",
      "transliteration": "maanee mahaan su(n)dhar saroop ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬਹੁਤ ਮਾਣ (ਅਥਵਾ ਮੌਨ ਸੁਭਾ ਵਾਲਾ) ਅਤੇ ਬਹੁਤ ਸੁੰਦਰ ਸਰੂਪ ਵਾਲਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "मानी महान सुँदर सरूप ॥",
      "sourceLineId": "101461",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਵਿਲੋਕਿ ਜਾਸੁ ਲਾਜੰਤ ਭੂਪ ॥੩॥",
      "transliteration": "avilok jaas laaja(n)t bhoop ||3||",
      "translation": "That great king was full of self-pride and had a very charming face, seeing which all the kings felt shy.3.",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਰਾਜੇ ਲਜਿਤ ਹੁੰਦੇ ਸਨ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "अविलोकि जासु लाजंत भूप ॥३॥",
      "sourceLineId": "101462",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਰਾਜਾਨ ਰਾਜ ਰਾਜਾਧਿਰਾਜ ॥",
      "transliteration": "raajaan raaj raajaadhiraaj ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰਾਜਿਆਂ ਦੇ ਰਾਜਿਆਂ ਦਾ ਵੀ ਮਹਾਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "राजान राज राजाधिराज ॥",
      "sourceLineId": "101463",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗ੍ਰਿਹ ਭਰੇ ਸਰਬ ਸੰਪਤਿ ਸਮਾਜ ॥",
      "transliteration": "gireh bhare sarab sa(n)pat samaaj ||",
      "translation": "That Sovereign was king of kings and in his kingdom, all the houses were full of wealth",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਘਰ (ਰਾਜ) ਸਮਾਜ ਦੀ ਸੰਪੱਤੀ ਨਾਲ ਭਰੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "गृह भरे सरब संपति समाज ॥",
      "sourceLineId": "101464",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਵਿਲੋਕ ਰੂਪ ਰੀਝੰਤ ਨਾਰਿ ॥",
      "transliteration": "avilok roop reejha(n)t naar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਰੂਪ ਨੂੰ ਵੇਖ ਕੇ ਇਸਤਰੀਆਂ ਰੀਝ ਜਾਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "अविलोक रूप रीझंत नारि ॥",
      "sourceLineId": "101465",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸ੍ਰੁਤਿ ਦਾਨ ਸੀਲ ਬਿਦਿਆ ਉਦਾਰ ॥੪॥",
      "transliteration": "srut dhaan seel bidhiaa udhaar ||4||",
      "translation": "The women were allured on seeing his beauty and he was the knower of the mysteries of the Vedas he was a great donor, skilful in sciences and a very gentle king.4.",
      "punjabiViakhya": "(ਉਹ) ਵੇਦ (ਅਧਿਐਨ) ਦਾਨ (ਧਰਮ) ਸ਼ੀਲ ਅਤੇ ਵਿਦਿਆ ਵਿਚ ਬਹੁਤ ਉਦਾਰ ਸੁਭਾ ਵਾਲਾ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "स्रुति दान सील बिदिआ उदार ॥४॥",
      "sourceLineId": "101466",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜੌ ਕਹੋ ਕਥਾ ਬਾਢੰਤ ਗ੍ਰੰਥ ॥",
      "transliteration": "jau kaho kathaa baadda(n)t gra(n)th ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਕਰ (ਉਸ ਦੀ ਸਾਰੀ) ਕਥਾ ਕਹਾ ਤਾ ਗ੍ਰੰਥ ਵੱਡਾ ਹੋ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "जौ कहो कथा बाढंत ग्रंथ ॥",
      "sourceLineId": "101467",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੁਣਿ ਲੇਹੁ ਮਿਤ੍ਰ ਸੰਛੇਪ ਕੰਥ ॥",
      "transliteration": "sun leh mitr sa(n)chhep ka(n)th ||",
      "translation": "If I relate the whole story, I fear the Granth to become voluminous",
      "punjabiViakhya": "(ਇਸ ਲਈ ਹੇ) ਮਿਤਰੋ! ਸੰਖੇਪ ਵਿਚ ਹੀ ਕਥਾ ਸੁਣ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "सुणि लेहु मित्र संछेप कंथ ॥",
      "sourceLineId": "101468",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬੈਦਰਭ ਦੇਸਿ ਰਾਜਾ ਸੁਬਾਹ ॥",
      "transliteration": "baidharabh dhes raajaa subaeh ||",
      "translation": "",
      "punjabiViakhya": "ਬੈਦਰਭ ਦੇਸ ਦਾ ਇਕ ਸੂਰਬੀਰ (ਅਥਵਾ 'ਸੁਬਾਹੂ' ਨਾ ਦਾ) ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "बैदरभ देसि राजा सुबाह ॥",
      "sourceLineId": "101469",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚੰਪਾਵਤੀ ਸੁ ਗ੍ਰਿਹ ਨਾਰਿ ਤਾਹਿ ॥੫॥",
      "transliteration": "cha(n)paavatee su gireh naar taeh ||5||",
      "translation": "Therefore, O friend! listen this story only in brief there was a king named Subahu in Vidrabha country, the name of whose queen was Champavati.5.",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਘਰ ਚੰਪਾਵਤੀ ਨਾ ਵਾਲੀ ਇਸਤਰੀ ਸੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "चंपावती सु गृह नारि ताहि ॥५॥",
      "sourceLineId": "101470",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਿਹ ਜਈ ਏਕ ਕੰਨਿਆ ਅਪਾਰ ॥",
      "transliteration": "teh jiee ek ka(n)niaa apaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਇਕ ਅਪਾਰ ਰੂਪ ਵਾਲੀ ਕੰਨਿਆ ਨੂੰ ਜਨਮ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "तिह जई एक कंनिआ अपार ॥",
      "sourceLineId": "101471",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਿਹ ਮਤੀਇੰਦ੍ਰ ਨਾਮਾ ਉਦਾਰ ॥",
      "transliteration": "teh mateei(n)dhr naamaa udhaar ||",
      "translation": "She gave birth to a daughter, whose name was Indumati",
      "punjabiViakhya": "ਉਸ ਦਾ ਬਹੁਤ ਸ੍ਰੇਸ਼ਠ ਇੰਦਰਮਤੀ ਨਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "तिह मतीइंद्र नामा उदार ॥",
      "sourceLineId": "101472",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਬ ਭਈ ਜੋਗ ਬਰ ਕੇ ਕੁਮਾਰਿ ॥",
      "transliteration": "jab bhiee jog bar ke kumaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਕੁਮਾਰੀ ਵਰ ਦੇ ਯੋਗ ਹੋਈ,",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "जब भई जोग बर के कुमारि ॥",
      "sourceLineId": "101473",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਬ ਕੀਨ ਬੈਠਿ ਰਾਜਾ ਬਿਚਾਰਿ ॥੬॥",
      "transliteration": "tab keen baiTh raajaa bichaar ||6||",
      "translation": "When she attained the marriageable age, the king then consulted his ministers.6.",
      "punjabiViakhya": "ਤਦ ਰਾਜੇ ਨੇ ਬੈਠ ਕੇ ਵਿਚਾਰ ਕੀਤਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "तब कीन बैठि राजा बिचारि ॥६॥",
      "sourceLineId": "101474",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਲਿਨੇ ਬੁਲਾਇ ਨ੍ਰਿਪ ਸਰਬ ਦੇਸ ॥",
      "transliteration": "line bulai nirap sarab dhes ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਦੇਸਾ ਦੇ ਰਾਜੇ ਬੁਲਾ ਲਏ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "लिने बुलाइ नृप सरब देस ॥",
      "sourceLineId": "101475",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਧਾਏ ਸੁਬਾਹ ਲੈ ਦਲ ਅਸੇਸ ॥",
      "transliteration": "dhaae subaeh lai dhal ases ||",
      "translation": "The king invited the kings of all the countries, who came to the kingdom of Subahu with their armies",
      "punjabiViakhya": "(ਸਾਰੇ) ਸੂਰਬੀਰ ਬੇਸ਼ੁਮਾਰ ਸੈਨਾ ਲੈ ਕੇ ਚਲ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "धाए सुबाह लै दल असेस ॥",
      "sourceLineId": "101476",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮੁਖ ਭਈ ਆਨਿ ਸਰਸ੍ਵਤੀ ਆਪੁ ॥",
      "transliteration": "mukh bhiee aan sarasavaitee aap ||",
      "translation": "",
      "punjabiViakhya": "(ਸਾਰਿਆਂ) ਦੇ ਮੁਖ ਵਿਚ ਸਰਸਵਤੀ ਆਪ ਆਣ ਬਿਰਾਜੀ",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "मुख भई आनि सरस्वती आपु ॥",
      "sourceLineId": "101477",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਹਿ ਜਪਤ ਲੋਗ ਮਿਲਿ ਸਰਬ ਜਾਪੁ ॥੭॥",
      "transliteration": "jeh japat log mil sarab jaap ||7||",
      "translation": "The adorable goddess Sarasvati came to reside in the mouths of all them and all of them with the desire of marrying that girl, offered prayers alongwith",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਜਾਪ ਨੂੰ ਸਾਰੇ ਲੋਕ ਮਿਲ ਕੇ ਜਪਦੇ ਹਨ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "जिहि जपत लोग मिलि सरब जापु ॥७॥",
      "sourceLineId": "101478",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਬ ਦੇਸ ਦੇਸ ਕੇ ਭੂਪ ਆਨਿ ॥",
      "transliteration": "tab dhes dhes ke bhoop aan ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦੇਸ ਦੇਸਾਤਰਾ ਦੇ ਰਾਜਿਆਂ ਨੇ ਆ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "तब देस देस के भूप आनि ॥",
      "sourceLineId": "101479",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਿਨੋ ਪ੍ਰਣਾਮ ਰਾਜਾ ਮਹਾਨਿ ॥",
      "transliteration": "kino pranaam raajaa mahaan ||",
      "translation": "All the kings of various countries came and bowed before that king Subahu nad sat in the assembly",
      "punjabiViakhya": "(ਉਸ) ਮਹਾਨ ਰਾਜੇ ਨੂੰ ਪ੍ਰਨਾਮ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "किनो प्रणाम राजा महानि ॥",
      "sourceLineId": "101480",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਹ ਬੈਠਿ ਰਾਜ ਸੋਭੰਤ ਐਸੁ ॥",
      "transliteration": "teh baiTh raaj sobha(n)t aais ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਬੈਠ ਕੇ ਰਾਜੇ ਇਸ ਤਰ੍ਰਹਾ ਸ਼ੋਭਾ ਪਾ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": "तह बैठि राज सोभंत ऐसु ॥",
      "sourceLineId": "101481",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0627_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਨ ਦੇਵ ਮੰਡਲੀ ਸਮ ਨ ਤੈਸੁ ॥੮॥",
      "transliteration": "jan dhev ma(n)ddalee sam na tais ||8||",
