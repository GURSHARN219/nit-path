    {
      "id": "dasam_ang_0628_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਅਦਭੁਤ ਰੂਪਾ ॥",
      "transliteration": "adhabhut roopaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਦਭੁਤ ਰੂਪ ਵਾਲੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "अदभुत रूपा ॥",
      "sourceLineId": "101541",
      "sourceShabadId": "9312",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਕਾਮਿਣ ਕੂਪਾ ॥",
      "transliteration": "kaamin koopaa ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਵਾ ਭਾਵਾ ਦੀਆਂ ਖੂਹ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "कामिण कूपा ॥",
      "sourceLineId": "101542",
      "sourceShabadId": "9312",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਚਾਰੁ ਪ੍ਰਹਾਸੰ ॥",
      "transliteration": "chaar prahaasa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਹਾਸੇ ਵਾਲੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "चारु प्रहासं ॥",
      "sourceLineId": "101543",
      "sourceShabadId": "9312",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਉਨਤਿ ਨਾਸੰ ॥੨੩॥",
      "transliteration": "aunat naasa(n) ||23||",
      "translation": "These women had marvelous figures, full of desires, with bewitching smiles and long nostrils.23.",
      "punjabiViakhya": "ਉੱਚੇ ਨਕਾ ਵਾਲੀਆਂ ਸਨ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "उनति नासं ॥२३॥",
      "sourceLineId": "101544",
      "sourceShabadId": "9312",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਲਖਿ ਦੁਤਿ ਰਾਣੀ ॥",
      "transliteration": "lakh dhut raanee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀਆਂ ਦੀ ਸੁੰਦਰਤਾ ਨੂੰ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "लखि दुति राणी ॥",
      "sourceLineId": "101545",
      "sourceShabadId": "9312",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਲਜਿਤ ਇੰਦ੍ਰਾਣੀ ॥",
      "transliteration": "lajit i(n)dhraanee ||",
      "translation": "Seeing the beauty of the queens, the wife of Indra also felt shy",
      "punjabiViakhya": "ਇੰਦ੍ਰਾਣੀ ਵੀ ਲਜਿਤ ਹੋ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "लजित इंद्राणी ॥",
      "sourceLineId": "101546",
      "sourceShabadId": "9312",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਸੋਹਤ ਬਾਲਾ ॥",
      "transliteration": "sohat baalaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਸਤਰੀਆਂ ਇਸ ਤਰ੍ਰਹਾ ਸ਼ੋਭਾਇਮਾਨ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "सोहत बाला ॥",
      "sourceLineId": "101547",
      "sourceShabadId": "9312",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਰਾਗਣ ਮਾਲਾ ॥੨੪॥",
      "transliteration": "raagan maalaa ||24||",
      "translation": "These heavenly maidens were like the rosary of musical modes.24.",
      "punjabiViakhya": "ਮਾਨੋ ਰਾਗਾ ਦੀ ਮਾਲਾ ਹੋਣ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "रागण माला ॥२४॥",
      "sourceLineId": "101548",
      "sourceShabadId": "9312",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਮੋਹਣੀ ਛੰਦ ॥",
      "transliteration": "mohanee chha(n)dh ||",
      "translation": "MOHINI STANZA",
      "punjabiViakhya": "ਮੋਹਣੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "मोहणी छंद ॥",
      "sourceLineId": "101549",
      "sourceShabadId": "9313",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਗਉਰ ਸਰੂਪ ਮਹਾ ਛਬਿ ਸੋਹਤ ॥",
      "transliteration": "gaur saroop mahaa chhab sohat ||",
      "translation": "",
      "punjabiViakhya": "ਗੌਰੀ (ਪਾਰਬਤੀ) ਦੇ ਸਰੂਪ ਵਾਲੀਆਂ ਦੀ ਛਬੀ ਬਹੁਤ ਸ਼ੋਭਾਸ਼ਾਲੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "गउर सरूप महा छबि सोहत ॥",
      "sourceLineId": "101550",
      "sourceShabadId": "9313",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਦੇਖਤ ਸੁਰ ਨਰ ਕੋ ਮਨ ਮੋਹਤ ॥",
      "transliteration": "dhekhat sur nar ko man mohat ||",
      "translation": "These whit-complexioned elegant women were fascinating the mind of gods and men",
      "punjabiViakhya": "ਵੇਖਣ 'ਤੇ ਦੇਵਤਿਆਂ ਅਤੇ ਮਨੁੱਖਾ ਦੇ ਮਨ ਨੂੰ ਮੋਹ ਲੈਂਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "देखत सुर नर को मन मोहत ॥",
      "sourceLineId": "101551",
      "sourceShabadId": "9313",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਰੀਝਤ ਤਾਕਿ ਬਡੇ ਨ੍ਰਿਪ ਐਸੇ ॥",
      "transliteration": "reejhat taak badde nirap aaise ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੂੰ) ਵੇਖ ਕੇ ਵੱਡੇ ਰਾਜੇ ਇਸ ਤਰ੍ਰਹਾ ਰੀਝ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "रीझत ताकि बडे नृप ऐसे ॥",
      "sourceLineId": "101552",
      "sourceShabadId": "9313",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਸੋਭਹਿੰ ਕਉਨ ਸਕੈ ਕਹਿ ਤੈਸੇ ॥੨੫॥",
      "transliteration": "sobhahi(n) kaun sakai keh taise ||25||",
      "translation": "Seeing them, the great kings got pleased what more description can be given of their glory?.25.",
      "punjabiViakhya": "ਕਿ ਉਨ੍ਰਹਾ ਦੀ ਸ਼ੋਭਾ ਦਾ ਵਰਣਨ ਭਲਾ ਕੌਣ ਕਰ ਸਕਦਾ ਹੈ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "सोभहिं कउन सकै कहि तैसे ॥२५॥",
      "sourceLineId": "101553",
      "sourceShabadId": "9313",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਸੁੰਦਰ ਰੂਪ ਮਹਾ ਦੁਤਿ ਬਾਲੀਯ ॥",
      "transliteration": "su(n)dhar roop mahaa dhut baaleey ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਸਤਰੀਆਂ ਮਹਾਨ ਸਰੂਪ ਅਤੇ ਚਮਕ ਵਾਲੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "सुँदर रूप महा दुति बालीय ॥",
      "sourceLineId": "101554",
      "sourceShabadId": "9313",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
