{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 628,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0628_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਾਜੰਤ ਢੋਲ ਦੁੰਦਭਿ ਅਪਾਰ ॥",
      "transliteration": "baaja(n)t ddol dhu(n)dhabh apaar ||",
      "translation": "",
      "punjabiViakhya": "ਬੇਸ਼ੁਮਾਰ ਢੋਲ ਅਤੇ ਧੌਂਸੇ ਵਜਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "बाजंत ढोल दुँदभि अपार ॥",
      "sourceLineId": "101483",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਾਜੰਤ ਤੂਰ ਝਨਕੰਤ ਤਾਰ ॥",
      "transliteration": "baaja(n)t toor jhanaka(n)t taar ||",
      "translation": "The small and big drums were resounding",
      "punjabiViakhya": "ਤੁਰੀਆਂ (ਬੀਨਾ) ਵਜਦੀਆਂ ਸਨ ਅਤੇ ਤਾਰਾ ਝਣਕਾਰ ਕਰਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "बाजंत तूर झनकंत तार ॥",
      "sourceLineId": "101484",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੋਭਾ ਅਪਾਰ ਬਰਨੀ ਨ ਜਾਇ ॥",
      "transliteration": "sobhaa apaar baranee na jai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਅਪਾਰ ਸ਼ੋਭਾ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "सोभा अपार बरनी न जाइ ॥",
      "sourceLineId": "101485",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਨੁ ਬੈਠਿ ਇੰਦ੍ਰ ਆਭਾ ਬਨਾਇ ॥੯॥",
      "transliteration": "jan baiTh i(n)dhr aabhaa banai ||9||",
      "translation": "The glory of that place is indescribable all of them appeared to be like Indra.9.",
      "punjabiViakhya": "ਮਾਨੋ ਇੰਦਰ ਹੀ ਫਬਿਆ ਬੈਠਾ ਹੋਵੇ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "जनु बैठि इंद्र आभा बनाइ ॥९॥",
      "sourceLineId": "101486",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਰਾਜ ਮੰਡਲੀ ਬੈਠਿ ॥",
      "transliteration": "eeh bhaat raaj ma(n)ddalee baiTh ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਨਾਲ ਰਾਜ ਮੰਡਲੀ ਬੈਠੀ ਹੋਈ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "इह भाति राज मंडली बैठि ॥",
      "sourceLineId": "101487",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਵਿਲੋਕਿ ਇੰਦ੍ਰ ਜਹ ਨਾਕ ਐਠਿ ॥",
      "transliteration": "avilok i(n)dhr jeh naak aaiTh ||",
      "translation": "That royal assembly was such that seeing it, Indra shrunk his nose, who should describe its glory?",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਇੰਦਰ (ਦ੍ਵੈਸ਼ ਵਸ) ਨਕ ਚੜ੍ਰਹਾਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "अविलोकि इंद्र जह नाक ऐठि ॥",
      "sourceLineId": "101488",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਆਭਾ ਅਪਾਰ ਬਰਨੇ ਸੁ ਕਉਨ ॥",
      "transliteration": "aabhaa apaar barane su kaun ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਅਪਾਰ ਸ਼ੋਭਾ ਦਾ ਕੌਣ ਵਰਣਨ ਕਰ ਸਕਦਾ ਹੈ?",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "आभा अपार बरने सु कउन ॥",
      "sourceLineId": "101489",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹ੍ਵੈ ਰਹੇ ਜਛ ਗੰਧ੍ਰਬ ਮਉਨ ॥੧੦॥",
      "transliteration": "havai rahe jachh ga(n)dhrab maun ||10||",
      "translation": "The Gandharvas and Yakshas kept silent on seeing it.10.",
      "punjabiViakhya": "(ਉਸ ਨੂੰ ਵੇਖ ਕੇ) ਯਕਸ਼ ਅਤੇ ਗੰਧਰਬ ਵੀ ਚੁਪ ਕਰ ਕੇ ਰਹਿ ਜਾਦੇ ਹਨ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "ह्वै रहे जछ गंध्रब मउन ॥१०॥",
      "sourceLineId": "101490",
      "sourceShabadId": "9310",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਰਧ ਪਾਧੜੀ ਛੰਦ ॥",
      "transliteration": "aradh paadhaRee chha(n)dh ||",
      "translation": "ARDH PAADHARI STANZA",
      "punjabiViakhya": "ਅਰਧ ਪਾਧੜੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "अरध पाधड़ी छंद ॥",
      "sourceLineId": "101491",
      "sourceShabadId": "9311",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੋਭੰਤ ਸੂਰ ॥",
      "transliteration": "sobha(n)t soor ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਸ਼ੋਭਾਇਮਾਨ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "सोभंत सूर ॥",
      "sourceLineId": "101492",
      "sourceShabadId": "9311",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਲੋਭੰਤ ਹੂਰ ॥",
      "transliteration": "lobha(n)t hoor ||",
      "translation": "The warriors looked splendid, seeing whom the heavenly damsels got allured",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਉਤੇ) ਹੂਰਾ ਲੋਭਾਇਮਾਨ ਹੋ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "लोभंत हूर ॥",
      "sourceLineId": "101493",
      "sourceShabadId": "9311",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਛ੍ਰੀ ਅਪਾਰ ॥",
      "transliteration": "achhree apaar ||",
      "translation": "",
      "punjabiViakhya": "ਅਪਾਰ ਅਪੱਛਰਾਵਾ ਰੀਝ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "अछ्री अपार ॥",
      "sourceLineId": "101494",
      "sourceShabadId": "9311",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਿਝੀ ਸੁ ਧਾਰ ॥੧੧॥",
      "transliteration": "rijhee su dhaar ||11||",
      "translation": "There were innumerable heavenly damsels.11.",
      "punjabiViakhya": "(ਮਨ ਵਿਚ ਉਨ੍ਰਹਾ ਨੂੰ) ਧਾਰਨ ਕਰ ਰਹੀਆਂ ਸਨ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "रिझी सु धार ॥११॥",
      "sourceLineId": "101495",
      "sourceShabadId": "9311",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਗਾਵੰਤ ਗੀਤ ॥",
      "transliteration": "gaava(n)t geet ||",
      "translation": "",
      "punjabiViakhya": "ਗੀਤ ਗਾਉਾਂਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "गावंत गीत ॥",
      "sourceLineId": "101496",
      "sourceShabadId": "9311",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮੋਹੰਤ ਚੀਤ ॥",
      "transliteration": "moha(n)t cheet ||",
      "translation": "",
      "punjabiViakhya": "ਚਿਤ ਨੂੰ ਮੋਹ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "मोहंत चीत ॥",
      "sourceLineId": "101497",
      "sourceShabadId": "9311",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਿਲਿ ਦੇ ਅਸੀਸ ॥",
      "transliteration": "mil dhe asees ||",
      "translation": "",
      "punjabiViakhya": "ਮਿਲ ਕੇ ਅਸੀਸ ਦਿੰਦੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "मिलि दे असीस ॥",
      "sourceLineId": "101498",
      "sourceShabadId": "9311",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜੁਗ ਚਾਰਿ ਜੀਸ ॥੧੨॥",
      "transliteration": "jug chaar jees ||12||",
      "translation": "They were singing fascinating songs, in which they were blessing together for their long like till the end of four ages.12.",
      "punjabiViakhya": "ਕਿ ਚਾਰ ਯੁਗਾ ਤਕ ਜੀਉਾਂਦੇ ਰਹੋ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "जुग चारि जीस ॥१२॥",
      "sourceLineId": "101499",
      "sourceShabadId": "9311",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਾਜੰਤ ਤਾਰ ॥",
      "transliteration": "baaja(n)t taar ||",
      "translation": "",
      "punjabiViakhya": "ਤਾਲੀਆਂ ਵਜਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "बाजंत तार ॥",
      "sourceLineId": "101500",
      "sourceShabadId": "9311",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਡਾਰੈ ਧਮਾਰ ॥",
      "transliteration": "ddaarai dhamaar ||",
      "translation": "",
      "punjabiViakhya": "ਧਮਾਰ ਪਾਏ ਜਾ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "डारै धमार ॥",
      "sourceLineId": "101501",
      "sourceShabadId": "9311",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦੇਵਾਨ ਨਾਰਿ ॥",
      "transliteration": "dhevaan naar ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤਿਆਂ ਦੀਆਂ ਬੇਸ਼ੁਮਾਰ ਇਸਤਰੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "देवान नारि ॥",
      "sourceLineId": "101502",
      "sourceShabadId": "9311",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪੇਖਤ ਅਪਾਰ ॥੧੩॥",
      "transliteration": "pekhat apaar ||13||",
      "translation": "The knocking on the instruments were being heard and many heavenly damsels were being seen.13.",
      "punjabiViakhya": "ਵੇਖ ਰਹੀਆਂ ਸਨ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "पेखत अपार ॥१३॥",
      "sourceLineId": "101503",
      "sourceShabadId": "9311",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕੈ ਬੇਦ ਰੀਤਿ ॥",
      "transliteration": "kai bedh reet ||",
      "translation": "",
      "punjabiViakhya": "ਵੇਦ ਦੀ ਰੀਤ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "कै बेद रीति ॥",
      "sourceLineId": "101504",
      "sourceShabadId": "9311",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗਾਵੰਤ ਗੀਤ ॥",
      "transliteration": "gaava(n)t geet ||",
      "translation": "",
      "punjabiViakhya": "ਗੀਤ ਗਾ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "गावंत गीत ॥",
      "sourceLineId": "101505",
      "sourceShabadId": "9311",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੋਭਾ ਅਨੂਪ ॥",
      "transliteration": "sobhaa anoop ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੂਪਮ ਸ਼ੋਭਾ ਵਾਲੇ",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "सोभा अनूप ॥",
      "sourceLineId": "101506",
      "sourceShabadId": "9311",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੋਭੰਤ ਭੂਪ ॥੧੪॥",
      "transliteration": "sobha(n)t bhoop ||14||",
      "translation": "The songs were being sung according to Vedic rites and the kings of unique glory looked magnificent.14.",
      "punjabiViakhya": "ਰਾਜੇ ਸ਼ੋਭਾਇਮਾਨ ਸਨ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "सोभंत भूप ॥१४॥",
      "sourceLineId": "101507",
      "sourceShabadId": "9311",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਾਜੰਤ ਤਾਰ ॥",
      "transliteration": "baaja(n)t taar ||",
      "translation": "",
      "punjabiViakhya": "ਤਾਲੀਆਂ ਵਜਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "बाजंत तार ॥",
      "sourceLineId": "101508",
      "sourceShabadId": "9311",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰੀਝੰਤ ਨਾਰਿ ॥",
      "transliteration": "reejha(n)t naar ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀਆਂ ਪ੍ਰਸੰਨ ਹੋ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "रीझंत नारि ॥",
      "sourceLineId": "101509",
      "sourceShabadId": "9311",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0628_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗਾਵੰਤ ਗੀਤ ॥",
      "transliteration": "gaava(n)t geet ||",
      "translation": "",
      "punjabiViakhya": "ਗੀਤ ਗਾ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": "गावंत गीत ॥",
      "sourceLineId": "101510",
      "sourceShabadId": "9311",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
