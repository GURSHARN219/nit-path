{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 630,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0630_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਗਮ ਬਸੰਤ ਜਨੁ ਭਇਓ ਆਜ ॥",
      "transliteration": "aagam basa(n)t jan bhio aaj ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੋਂ ਦੀ ਸ਼ੋਭਾ ਨੂੰ ਵੇਖ ਕੇ ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ) ਮਾਨੋ ਅਜ ਬਸੰਤ ਦਾ ਆਗਮਨ ਹੋ ਗਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "आगम बसंत जनु भइओ आज ॥",
      "sourceLineId": "101603",
      "sourceShabadId": "9314",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਸਰਬ ਦੇਖੈ ਸਮਾਜ ॥",
      "transliteration": "eeh bhaat sarab dhekhai samaaj ||",
      "translation": "It seemed that this was the first day of spring",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਨਾਲ ਰਾਜਿਆਂ ਦਾ ਸਮਾਜ ਵੇਖਿਆ ਜਾ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "इह भाति सरब देखै समाज ॥",
      "sourceLineId": "101604",
      "sourceShabadId": "9314",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਾਜਾਧਿਰਾਜ ਬਨਿ ਬੈਠ ਐਸ ॥",
      "transliteration": "raajaadhiraaj ban baiTh aais ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਮਹਾਰਾਜੇ ਇਸ ਤਰ੍ਰਹਾ ਬਣ ਠਣ ਕੇ ਬੈਠੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "राजाधिराज बनि बैठ ऐस ॥",
      "sourceLineId": "101605",
      "sourceShabadId": "9314",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਿਨ ਕੇ ਸਮਾਨ ਨਹੀ ਇੰਦ੍ਰ ਹੈਸ ॥੩੮॥",
      "transliteration": "tin ke samaan nahee i(n)dhr hais ||38||",
      "translation": "In this way, seeing the whole assembly, all the kings sat down there in their glory as if they excelled even Indra.38.",
      "punjabiViakhya": "ਕਿ ਇੰਦਰ ਵੀ ਉਨ੍ਰਹਾ ਵਰਗਾ ਨਹੀਂ ਹੈ ॥੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "तिन के समान नही इंद्र हैस ॥३८॥",
      "sourceLineId": "101606",
      "sourceShabadId": "9314",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਇਕ ਮਾਸ ਲਾਗ ਤਹ ਭਇਓ ਨਾਚ ॥",
      "transliteration": "eik maas laag teh bhio naach ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਮਹੀਨੇ ਤਕ ਉਥੇ ਨਾਚ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "इक मास लाग तह भइओ नाच ॥",
      "sourceLineId": "101607",
      "sourceShabadId": "9314",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਿਨ ਪੀਐ ਕੈਫ ਕੋਊ ਨ ਬਾਚ ॥",
      "transliteration": "bin peeaai kaif kouoo na baach ||",
      "translation": "In this, way, the dancing continued there for one month and no one could save himself from drinking the wine of that dance",
      "punjabiViakhya": "ਸ਼ਰਾਬ ਪੀਣ ਤੋਂ ਬਿਨਾ ਕੋਈ ਵੀ ਬਚ ਨਹੀਂ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "बिन पीऐ कैफ कोऊ न बाच ॥",
      "sourceLineId": "101608",
      "sourceShabadId": "9314",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਹ ਜਹ ਬਿਲੋਕਿ ਆਭਾ ਅਪਾਰ ॥",
      "transliteration": "jeh jeh bilok aabhaa apaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਜਿਥੇ ਅਪਾਰ ਸ਼ੋਭਾ ਵੇਖੀ ਜਾਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "जह जह बिलोकि आभा अपार ॥",
      "sourceLineId": "101609",
      "sourceShabadId": "9314",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਹ ਤਹ ਸੁ ਰਾਜ ਰਾਜਨ ਕੁਮਾਰ ॥੩੯॥",
      "transliteration": "teh teh su raaj raajan kumaar ||39||",
      "translation": "Here, there and everywhere the beauty of the kings and princes was seen.39.",
      "punjabiViakhya": "ਉਥੇ ਉਥੇ ਰਾਜੇ ਅਤੇ ਰਾਜ ਕੁਮਾਰ ਸੁਸਜਿਤ ਹੋ ਕੇ ਬੈਠੇ ਸਨ ॥੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "तह तह सु राज राजन कुमार ॥३९॥",
      "sourceLineId": "101610",
      "sourceShabadId": "9314",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਲੈ ਸੰਗ ਤਾਸ ਸਾਰਸ੍ਵਤਿ ਆਪ ॥",
      "transliteration": "lai sa(n)g taas saarasavait aap ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਸਰਸਵਤੀ ਨੂੰ ਸਾਰਾ ਜਗਤ ਜਪਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "लै संग तास सारस्वति आप ॥",
      "sourceLineId": "101611",
      "sourceShabadId": "9314",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਿਹ ਕੋ ਜਪੰਤ ਸਭ ਜਗਤ ਜਾਪ ॥",
      "transliteration": "jeh ko japa(n)t sabh jagat jaap ||",
      "translation": "Sarasvati, the goddess worshipped by the world, said to the princess,",
      "punjabiViakhya": "ਉਹ ਉਸ (ਰਾਜ ਕੁਮਾਰੀ) ਨੂੰ ਆਪ ਨਾਲ ਲੈ ਕੇ (ਰਾਜ ਸਭਾ ਵਿਚ ਆਈ)।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "जिह को जपंत सभ जगत जाप ॥",
      "sourceLineId": "101612",
      "sourceShabadId": "9314",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਿਰਖੋ ਕੁਮਾਰ ਇਹ ਸਿੰਧ ਰਾਜ ॥",
      "transliteration": "nirakho kumaar ieh si(n)dh raaj ||",
      "translation": "",
      "punjabiViakhya": "(ਹੇ ਰਾਜ ਕੁਮਾਰੀ!) ਵੇਖੋ, ਇਹ ਸਿੰਧ ਰਾਜ ਦਾ ਕੁਮਾਰ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "निरखो कुमार इह सिंध राज ॥",
      "sourceLineId": "101613",
      "sourceShabadId": "9314",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਾ ਕੀ ਸਮਾਨ ਨਹੀ ਇੰਦ੍ਰ ਸਾਜ ॥੪੦॥",
      "transliteration": "jaa kee samaan nahee i(n)dhr saaj ||40||",
      "translation": "“O princess! Look at these princes, who even excel Indra.”40.",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਸਜਾਵਟ ਵਰਗਾ ਇੰਦਰ ਵੀ ਨਹੀਂ ॥੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "जा की समान नही इंद्र साज ॥४०॥",
      "sourceLineId": "101614",
      "sourceShabadId": "9314",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਵਿਲੋਕ ਸਿੰਧ ਰਾਜਾ ਕੁਮਾਰ ॥",
      "transliteration": "avilok si(n)dh raajaa kumaar ||",
      "translation": "",
      "punjabiViakhya": "ਸਿੰਧ ਦੇ ਰਾਜ ਕੁਮਾਰ ਨੂੰ ਵੇਖ ਕੇ (ਰਾਜ ਕੁਮਾਰੀ ਨੇ)",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "अविलोक सिंध राजा कुमार ॥",
      "sourceLineId": "101615",
      "sourceShabadId": "9314",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਹੀ ਤਾਸ ਚਿਤ ਕਿਨੋ ਸੁਮਾਰ ॥",
      "transliteration": "nahee taas chit kino sumaar ||",
      "translation": "The princess looked towards the group of princes and did not even like the prince of Sindhu-kingdom",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਮਨ ਵਿਚ ਕੋਈ ਮਹਤਵ ਨਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "नही तास चित किनो सुमार ॥",
      "sourceLineId": "101616",
      "sourceShabadId": "9314",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਿਹ ਛਾਡਿ ਪਾਛ ਆਗੈ ਚਲੀਸੁ ॥",
      "transliteration": "teh chhaadd paachh aagai chalees ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਪਿਛੇ ਛਡ ਕੇ ਅਗੇ ਨੂੰ ਚਲੀ",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "तिह छाडि पाछ आगै चलीसु ॥",
      "sourceLineId": "101617",
      "sourceShabadId": "9314",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਨੁ ਸਰਬ ਸੋਭ ਕਹੁ ਲੀਲ ਲੀਸੁ ॥੪੧॥",
      "transliteration": "jan sarab sobh kahu leel lees ||41||",
      "translation": "Leaving him, absorbing all the glory within herself, she moved further.41.",
      "punjabiViakhya": "ਮਾਨੋ ਸਾਰੀ ਸਭਾ ਨੂੰ (ਉਸ ਨੇ) ਨਿਗਲ ਲਿਆ ਹੋਵੇ ॥੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "जनु सरब सोभ कहु लील लीसु ॥४१॥",
      "sourceLineId": "101618",
      "sourceShabadId": "9314",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪੁਨਿ ਕਹੈ ਤਾਸ ਸਾਰਸ੍ਵਤੀ ਬੈਨ ॥",
      "transliteration": "pun kahai taas saarasavaitee bain ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਸਰਸਵਤੀ ਨੇ ਉਸ ਨੂੰ ਬਚਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "पुनि कहै तास सारस्वती बैन ॥",
      "sourceLineId": "101619",
      "sourceShabadId": "9314",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਇਹ ਪਸਚਮੇਸ ਅਬ ਦੇਖ ਨੈਨਿ ॥",
      "transliteration": "eeh pasachames ab dhekh nain ||",
      "translation": "Sarasvati said to her again, “Here is a king of the West, you may see him",
      "punjabiViakhya": "ਕਿ ਹੁਣ ਪੱਛਮ ਦੇ ਰਾਜ (ਕੁਮਾਰ) ਨੂੰ ਅੱਖਾ ਨਾਲ ਵੇਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "इह पसचमेस अब देख नैनि ॥",
      "sourceLineId": "101620",
      "sourceShabadId": "9314",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਵਿਲੋਕਿ ਰੂਪ ਤਾ ਕੋ ਅਪਾਰ ॥",
      "transliteration": "avilok roop taa ko apaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅਪਾਰ ਰੂਪ ਨੂੰ ਵੇਖ ਕੇ (ਰਾਜ ਕੁਮਾਰੀ ਨੇ)",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "अविलोकि रूप ता को अपार ॥",
      "sourceLineId": "101621",
      "sourceShabadId": "9314",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਹੀ ਮਧਿ ਚਿਤਿ ਆਨਿਓ ਕੁਮਾਰ ॥੪੨॥",
      "transliteration": "nahee madh chit aanio kumaar ||42||",
      "translation": "The princess saw his natural features, but she did not like him also.42.",
      "punjabiViakhya": "ਉਸ ਰਾਜ ਕੁਮਾਰ ਨੂੰ ਚਿਤ ਵਿਚ ਨਾ ਲਿਆਂਦਾ ॥੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "नही मधि चिति आनिओ कुमार ॥४२॥",
      "sourceLineId": "101622",
      "sourceShabadId": "9314",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਧੁਭਾਰ ਛੰਦ ॥",
      "transliteration": "madhubhaar chha(n)dh ||",
      "translation": "MADHUBHAAR STANZA",
      "punjabiViakhya": "ਮਧੁਭਾਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "मधुभार छंद ॥",
      "sourceLineId": "101623",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦੇਖੋ ਕੁਮਾਰ ॥",
      "transliteration": "dhekho kumaar ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ) ਰਾਜ ਕੁਮਾਰ ਨੂੰ ਵੇਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "देखो कुमार ॥",
      "sourceLineId": "101624",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਾਜਾ ਜੁਝਾਰ ॥",
      "transliteration": "raajaa jujhaar ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਬਹੁਤ ਸੂਰਮਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "राजा जुझार ॥",
      "sourceLineId": "101625",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੁਭ ਵਾਰ ਦੇਸ ॥",
      "transliteration": "subh vaar dhes ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੁਭ ਦੇਸ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "सुभ वार देस ॥",
      "sourceLineId": "101626",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੁੰਦਰ ਸੁਬੇਸ ॥੪੩॥",
      "transliteration": "su(n)dhar subes ||43||",
      "translation": "“O princess! Look towards these elegantly dressed warrior-kings of the countery.”43.",
      "punjabiViakhya": "ਇਸ ਦਾ ਵੇਸ ਬਹੁਤ ਸੁੰਦਰ ਹੈ ॥੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "सुँदर सुबेस ॥४३॥",
      "sourceLineId": "101627",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੇਖਿਓ ਬਿਚਾਰ ॥",
      "transliteration": "dhekhio bichaar ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਚਾਰ ਪੂਰਵਕ (ਰਾਜ ਕੁਮਾਰੀ ਨੇ) ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "देखिओ बिचार ॥",
      "sourceLineId": "101628",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰਾਜਾ ਅਪਾਰ ॥",
      "transliteration": "raajaa apaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬਹੁਤ ਸ੍ਰੇਸ਼ਠ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "राजा अपार ॥",
      "sourceLineId": "101629",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਆਨਾ ਨ ਚਿਤ ॥",
      "transliteration": "aanaa na chit ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ ਰਾਜ ਕੁਮਾਰੀ) ਨੇ ਚਿਤ ਵਿਚ ਨਾ ਲਿਆਂਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "आना न चित ॥",
      "sourceLineId": "101630",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪਰਮੰ ਪਵਿਤ ॥੪੪॥",
      "transliteration": "parama(n) pavit ||44||",
      "translation": "The princess saw towards the natural features of many kings thoughtfully and that supremely immaculate damsel even did not like the king of the West.44.",
      "punjabiViakhya": "(ਭਾਵੇਾਂ ਉਹ) ਪਰਮ ਪਵਿਤ੍ਰ ਸੀ ॥੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "परमं पवित ॥४४॥",
      "sourceLineId": "101631",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਬ ਆਗਿ ਚਾਲ ॥",
      "transliteration": "tab aag chaal ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਹ ਸੁੰਦਰ ਰਾਜ ਕੁਮਾਰੀ",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "तब आगि चाल ॥",
      "sourceLineId": "101632",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੁੰਦਰ ਸੁ ਬਾਲ ॥",
      "transliteration": "su(n)dhar su baal ||",
      "translation": "",
      "punjabiViakhya": "ਅਗੇ ਨੂੰ ਚਲ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "सुँदर सु बाल ॥",
      "sourceLineId": "101633",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮੁਸਕਿਆਤ ਐਸ ॥",
      "transliteration": "musakiaat aais ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਸ ਤਰ੍ਰਹਾ ਮੁਸਕਰਾ ਰਹੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "मुसकिआत ऐस ॥",
      "sourceLineId": "101634",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਘਨਿ ਬੀਜ ਜੈਸ ॥੪੫॥",
      "transliteration": "ghan beej jais ||45||",
      "translation": "Then that girl moved forward and began to smile like the flash of lightning amongst the clouds.45.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਬਦਲ ਵਿਚ ਬਿਜਲੀ ਲਿਸ਼ਕਦੀ ਹੈ ॥੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "घनि बीज जैस ॥४५॥",
      "sourceLineId": "101635",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨ੍ਰਿਪ ਪੇਖਿ ਰੀਝ ॥",
      "transliteration": "nirap pekh reejh ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ (ਉਸ ਨੂੰ) ਵੇਖ ਕੇ ਰੀਝ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "नृप पेखि रीझ ॥",
      "sourceLineId": "101636",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੁਰ ਨਾਰ ਖੀਝ ॥",
      "transliteration": "sur naar kheejh ||",
      "translation": "The kings were getting allured on seeing her and the heavenly damsels were getting angry",
      "punjabiViakhya": "ਦੇਵਤਿਆਂ ਦੀਆਂ ਇਸਤਰੀਆਂ ਖਿਝਦੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "सुर नार खीझ ॥",
      "sourceLineId": "101637",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਢਿ ਤਾਸ ਜਾਨ ॥",
      "transliteration": "badd taas jaan ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ) ਉਸ ਨੂੰ ਸ੍ਰੇਸ਼ਠ ਸਮਝ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "बढि तास जान ॥",
      "sourceLineId": "101638",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਘਟ ਆਪ ਮਾਨ ॥੪੬॥",
      "transliteration": "ghaT aap maan ||46||",
      "translation": "They were enraged because they found the princess more beautiful than themselves.46.",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਆਪ ਨੂੰ ਘਟੀਆ ਵਿਚਾਰ ਕੇ ॥੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "घट आप मान ॥४६॥",
      "sourceLineId": "101639",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੁੰਦਰ ਸਰੂਪ ॥",
      "transliteration": "su(n)dhar saroop ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਸਰੂਪ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "सुँदर सरूप ॥",
      "sourceLineId": "101640",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੌਂਦਰਜੁ ਭੂਪ ॥",
      "transliteration": "saua(n)dharaj bhoop ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੌਂਦਰਯ ਯੁਕਤ ਰਾਜਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "सौंदरजु भूप ॥",
      "sourceLineId": "101641",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੋਭਾ ਅਪਾਰ ॥",
      "transliteration": "sobhaa apaar ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਅਪਾਰ ਸ਼ੋਭਾ ਵਾਲਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "सोभा अपार ॥",
      "sourceLineId": "101642",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੋਭੈ ਸੁ ਧਾਰ ॥੪੭॥",
      "transliteration": "sobhai su dhaar ||47||",
      "translation": "The kings of charming forms and apparently beauty-incarnate and of supreme glory were there.47.",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਫਬ ਰਿਹਾ ਹੈ ॥੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "सोभै सु धार ॥४७॥",
      "sourceLineId": "101643",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੇਖੋ ਨਰੇਾਂਦ੍ਰ ॥",
      "transliteration": "dhekho nareaa(n)dhr ||",
      "translation": "",
      "punjabiViakhya": "(ਹੇ ਰਾਜ ਕੁਮਾਰੀ! ਇਸ) ਰਾਜੇ ਨੂੰ ਵੇਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "देखो नरेाँद्र ॥",
      "sourceLineId": "101644",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਡਾਢੇ ਮਹੇਾਂਦ੍ਰ ॥",
      "transliteration": "ddaadde maheaa(n)dhr ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਬਹੁਤ ਵੱਡਾ ਰਾਜਾ ਖੜੋਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "डाढे महेाँद्र ॥",
      "sourceLineId": "101645",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮੁਲਤਾਨ ਰਾਜ ॥",
      "transliteration": "mulataan raaj ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਮੁਲਤਾਨ ਦਾ ਰਾਜਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "मुलतान राज ॥",
      "sourceLineId": "101646",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰਾਜਾਨ ਰਾਜ ॥੪੮॥",
      "transliteration": "raajaan raaj ||48||",
      "translation": "The princess saw the kings standing there and also saw amongst them the sovereign of Mulatan.48.",
      "punjabiViakhya": "ਅਤੇ ਰਾਜਿਆਂ ਦਾ ਵੀ ਰਾਜਾ ਹੈ ॥੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "राजान राज ॥४८॥",
      "sourceLineId": "101647",
      "sourceShabadId": "9315",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "BHUJANG PRAYAAT STANZA",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "101648",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਚਲੀ ਛੋਡਿ ਤਾ ਕੌ ਤ੍ਰੀਆ ਰਾਜ ਐਸੇ ॥",
      "transliteration": "chalee chhodd taa kau treeaa raaj aaise ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਰਾਜ ਕੁਮਾਰੀ ਉਸ ਨੂੰ ਛਡ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਚਲੀ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "चली छोडि ता कौ त्रीआ राज ऐसे ॥",
      "sourceLineId": "101649",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮਨੋ ਪਾਡੁ ਪੁਤ੍ਰੰ ਸਿਰੀ ਰਾਜ ਜੈਸੇ ॥",
      "transliteration": "mano paadd putra(n) siree raaj jaise ||",
      "translation": "Leaving all of them, the princess moved forward like the Pandavas, the sons of Pandu, moving away after leaving their kingdom etc.",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਮਾਨੋ ਪਾਡੂ ਪੁੱਤਰਾ ਨੂੰ ਰਾਜ ਲੱਛਮੀ (ਛਡ ਗਈ ਹੋਵੇ)।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "मनो पाडु पुत्रं सिरी राज जैसे ॥",
      "sourceLineId": "101650",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਖਰੀ ਮਧਿ ਰਾਜਿਸਥਲੀ ਐਸ ਸੋਹੈ ॥",
      "transliteration": "kharee madh raajisathalee aais sohai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਿਆਂ ਦੀ ਮਜਲਸ ਵਿਚ ਖੜੋਤੀ ਇਸ ਤਰ੍ਰਹਾ ਸ਼ੋਭ ਰਹੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "खरी मधि राजिसथली ऐस सोहै ॥",
      "sourceLineId": "101651",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਮਨੋ ਜ੍ਵਾਲ ਮਾਲਾ ਮਹਾ ਮੋਨਿ ਮੋਹੈ ॥੪੯॥",
      "transliteration": "mano javaiaal maalaa mahaa mon mohai ||49||",
      "translation": "Standing in the royal court, she appeared like the fascinating fire-flame.49.",
      "punjabiViakhya": "ਮਾਨੋ ਜਵਾਲਮਾਲਾ (ਦੀਪਕ ਮਾਲਾ) ਮੁਨੀਆਂ ਦੇ ਮਨ ਨੂੰ ਮੋਹ ਰਹੀ ਹੋਵੇ ॥੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "मनो ज्वाल माला महा मोनि मोहै ॥४९॥",
      "sourceLineId": "101652",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸੁਭੇ ਰਾਜਿਸਥਲੀ ਠਾਢਿ ਐਸੇ ॥",
      "transliteration": "subhe raajisathalee Thaadd aaise ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਿਆਂ ਦੀ ਸਭਾ ਵਿਚ ਖੜੋਤੀ ਇਸ ਤਰ੍ਰਹਾ ਸ਼ੋਭਾ ਪਾ ਰਹੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "सुभे राजिसथली ठाढि ऐसे ॥",
      "sourceLineId": "101653",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮਨੋ ਚਿਤ੍ਰਕਾਰੀ ਲਿਖੀ ਚਿਤ੍ਰ ਜੈਸੇ ॥",
      "transliteration": "mano chitrakaaree likhee chitr jaise ||",
      "translation": "Standing in the royal court she appeared like the portrait of painter",
      "punjabiViakhya": "ਮਾਨੋ ਚਿਤਰਕਾਰ ਨੇ ਚਿਤਰ ਬਣਾ ਦਿੱਤਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "मनो चित्रकारी लिखी चित्र जैसे ॥",
      "sourceLineId": "101654",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਬਧੇ ਸ੍ਵਰਣ ਕੀ ਕਿੰਕਣੀ ਲਾਲ ਮਾਲੰ ॥",
      "transliteration": "badhe savairan kee ki(n)kanee laal maala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੋਨੇ ਦੀ ਮਾਲਾ ਨਾਲ ਲਾਲ ਘੁੰਗਰੀਆਂ ਬੱਧੀਆਂ ਹੋਈਆਂ (ਇੰਜ ਲਗ ਸਰਹੀਆਂ ਸਨ)",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "बधे स्वरण की किंकणी लाल मालं ॥",
      "sourceLineId": "101655",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਿਖਾ ਜਾਨ ਸੋਭੇ ਨ੍ਰਿਪੰ ਜਗਿ ਜ੍ਵਾਲੰ ॥੫੦॥",
      "transliteration": "sikhaa jaan sobhe nirapa(n) jag javaiaala(n) ||50||",
      "translation": "She was wearing a golden ornament (Kinkini) fitted with wreath of gems the pigtail of her hair was apparently like fire for the kings.50.",
      "punjabiViakhya": "ਮਾਨੋ ਰਾਜਿਆਂ ਰੂਪੀ ਯੱਗ ਵਿਚ ਅਗਨੀ ਦੀ ਲਾਟ ਸ਼ੋਭ ਰਹੀ ਹੋਵੇ ॥੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "सिखा जान सोभे नृपं जगि ज्वालं ॥५०॥",
      "sourceLineId": "101656",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕਹੇ ਬੈਨ ਸਾਰਸ੍ਵਤੀ ਪੇਖਿ ਬਾਲਾ ॥",
      "transliteration": "kahe bain saarasavaitee pekh baalaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਰਸਵਤੀ ਨੇ ਬਚਨ ਕੀਤਾ, ਹੇ ਰਾਜ ਕੁਮਾਰੀ!",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "कहे बैन सारस्वती पेखि बाला ॥",
      "sourceLineId": "101657",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਲਖੋ ਨੈਨਿ ਠਾਢੇ ਸਭੈ ਭੂਪ ਆਲਾ ॥",
      "transliteration": "lakho nain Thaadde sabhai bhoop aalaa ||",
      "translation": "Sarasvati, seeing the damsel said to her again, “O princess! See these superb kings",
      "punjabiViakhya": "ਅੱਖਾ ਨਾਲ ਵੇਖੋ, ਸਭ ਚੰਗੇ ਤੋਂ ਚੰਗੇ ਰਾਜੇ ਖੜੋਤੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "लखो नैनि ठाढे सभै भूप आला ॥",
      "sourceLineId": "101658",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਰੁਚੈ ਚਿਤ ਜਉਨੈ ਸੁਈ ਨਾਥ ਕੀਜੈ ॥",
      "transliteration": "ruchai chit jaunai suiee naath keejai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਨ੍ਰਹਾ ਵਿਚੋਂ) ਜਿਹੜਾ ਤੇਰੇ ਚਿਤ ਨੂੰ ਚੰਗਾ ਲਗਦਾ ਹੋਵੇ, ਉਸੇ ਨੂੰ (ਆਪਣਾ) ਸੁਆਮੀ ਬਣਾ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "रुचै चित जउनै सुई नाथ कीजै ॥",
      "sourceLineId": "101659",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਸੁਨੋ ਪ੍ਰਾਨ ਪਿਆਰੀ ਇਹੈ ਮਾਨਿ ਲੀਜੈ ॥੫੧॥",
      "transliteration": "suno praan piaaree ihai maan leejai ||51||",
      "translation": "O my beloved! Obey my saying wed him, whom you consider worthy in your mind.51.",
      "punjabiViakhya": "ਹੇ ਪ੍ਰਾਣ ਪਿਆਰੀ! ਮੇਰੀ ਇਹ (ਗੱਲ) ਮਨ ਲਵੋ ॥੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "सुनो प्रान पिआरी इहै मानि लीजै ॥५१॥",
      "sourceLineId": "101660",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਬਡੀ ਬਾਹਨੀ ਸੰਗਿ ਜਾ ਕੇ ਬਿਰਾਜੈ ॥",
      "transliteration": "baddee baahanee sa(n)g jaa ke biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਬਹੁਤ ਵੱਡੀ ਸੈਨਾ ਬਿਰਾਜ ਰਹੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "बडी बाहनी संगि जा के बिराजै ॥",
      "sourceLineId": "101661",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਘੁਰੈ ਸੰਗ ਭੇਰੀ ਮਹਾ ਨਾਦ ਬਾਜੈ ॥",
      "transliteration": "ghurai sa(n)g bheree mahaa naadh baajai ||",
      "translation": "“He, with whom there is a large army and the conches, battledrums and the war-horns are being played, see this great king",
      "punjabiViakhya": "ਅਤੇ ਸੰਖ ਤੇ ਭੇਰੀਆਂ ਗੂੰਜ ਰਹੀਆਂ ਹਨ ਅਤੇ ਮਹਾਨ ਨਾਦ ਵਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "घुरै संग भेरी महा नाद बाजै ॥",
      "sourceLineId": "101662",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਲਖੋ ਰੂਪ ਬੇਸੰ ਨਰੇਸੰ ਮਹਾਨੰ ॥",
      "transliteration": "lakho roop besa(n) naresa(n) mahaana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ) ਵੱਡੇ ਅਤੇ ਮਹਾਨ ਰਾਜੇ ਦੇ ਰੂਪ ਨੂੰ ਵੇਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "लखो रूप बेसं नरेसं महानं ॥",
      "sourceLineId": "101663",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਦਿਨੰ ਰੈਣ ਜਾਪੈ ਸਹੰਸ੍ਰ ਭੁਜਾਨੰ ॥੫੨॥",
      "transliteration": "dhina(n) rain jaapai saha(n)sr bhujaana(n) ||52||",
      "translation": "Whose thousand arms make the day appear as night.52.",
      "punjabiViakhya": "(ਇਹ) ਦਿਨ ਰਾਤ ਸਹਸ੍ਰਬਾਹੂ (ਹਜ਼ਾਰ ਭੁਜਾਵਾ ਵਾਲਾ) ਜਾਪਦਾ ਹੈ ॥੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "दिनं रैण जापै सहंस्र भुजानं ॥५२॥",
      "sourceLineId": "101664",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਧੁਜਾ ਮਧਿ ਜਾ ਕੇ ਬਡੋ ਸਿੰਘ ਰਾਜੈ ॥",
      "transliteration": "dhujaa madh jaa ke baddo si(n)gh raajai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਝੰਡੇ ਉਤੇ ਵੱਡੇ ਸ਼ੇਰ ਦਾ ਚਿੰਨ੍ਰਹ ਬਿਰਾਜ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "धुजा मधि जा के बडो सिंघ राजै ॥",
      "sourceLineId": "101665",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਸੁਨੇ ਨਾਦ ਤਾ ਕੋ ਮਹਾ ਪਾਪ ਭਾਜੈ ॥",
      "transliteration": "sune naadh taa ko mahaa paap bhaajai ||",
      "translation": "“In whose banner, there is seated a huge lion and hearing whose voice, the great sins are eliminated",
      "punjabiViakhya": "ਉਸ ਦੇ ਸਿੰਘ-ਨਾਦ ਨੂੰ ਸੁਣ ਕੇ ਮਹਾਨ ਪਾਪ ਵੀ ਭਜ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "सुने नाद ता को महा पाप भाजै ॥",
      "sourceLineId": "101666",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਲਖੋ ਪੂਰਬੀਸੰ ਛਿਤੀਸੰ ਮਹਾਨੰ ॥",
      "transliteration": "lakho poorabeesa(n) chhiteesa(n) mahaana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਪੂਰਬ ਦਾ ਮਹਾਨ ਰਾਜਾ ਜਾਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "लखो पूरबीसं छितीसं महानं ॥",
      "sourceLineId": "101667",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਸੁਨੋ ਬੈਨ ਬਾਲਾ ਸੁਰੂਪੰ ਸੁ ਭਾਨੰ ॥੫੩॥",
      "transliteration": "suno bain baalaa suroopa(n) su bhaana(n) ||53||",
      "translation": "O princess! See that sun-faced great king of the East.53.",
      "punjabiViakhya": "ਹੇ ਰਾਜ ਕੁਮਾਰੀ! ਸੁਣੋ, (ਇਸ ਦਾ) ਸਰੂਪ ਸੂਰਜ ਵਰਗਾ ਹੈ ॥੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "सुनो बैन बाला सुरूपं सु भानं ॥५३॥",
      "sourceLineId": "101668",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਘੁਰੈ ਦੁੰਦਭੀ ਸੰਖ ਭੇਰੀ ਅਪਾਰੰ ॥",
      "transliteration": "ghurai dhu(n)dhabhee sa(n)kh bheree apaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਪਾਰ ਭੇਰੀਆਂ, ਸੰਖ ਅਤੇ ਨਗਾਰੇ ਗੂੰਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "घुरै दुँदभी संख भेरी अपारं ॥",
      "sourceLineId": "101669",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਬਜੈ ਦਛਨੀ ਸਰਬ ਬਾਜੰਤ੍ਰ ਸਾਰੰ ॥",
      "transliteration": "bajai dhachhanee sarab baaja(n)tr saara(n) ||",
      "translation": "“Here the kettledrums, conches and drums are being played",
      "punjabiViakhya": "ਦੱਖਣ ਦੇਸ ਦੇ ਸਭ ਪ੍ਰਕਾਰ ਦੇ ਉੱਤਮ ਵਾਜੇ ਵਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "बजै दछनी सरब बाजंत्र सारं ॥",
      "sourceLineId": "101670",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਤੁਰੀ ਕਾਨਰੇ ਤੂਰ ਤਾਨੰ ਤਰੰਗੰ ॥",
      "transliteration": "turee kaanare toor taana(n) tara(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਰੀ, ਕਾਨਰਾ, ਤੂਰ, ਤਰੰਗ,",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "तुरी कानरे तूर तानं तरंगं ॥",
      "sourceLineId": "101671",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਮੁਚੰ ਝਾਝਰੰ ਨਾਇ ਨਾਦੰ ਮ੍ਰਿਦੰਗੰ ॥੫੪॥",
      "transliteration": "mucha(n) jhaajhara(n) nai naadha(n) miradha(n)ga(n) ||54||",
      "translation": "The tones and tunes of many other instruments are being heard also the drums, anklets etc. are being played.54.",
      "punjabiViakhya": "ਮੁਚੰਗ, ਝਾਝ, ਸ਼ਹਨਾਈ, ਮ੍ਰਿਦੰਗ ਦੇ ਨਾਦ ਹੁੰਦੇ ਹਨ ॥੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "मुचं झाझरं नाइ नादं मृदंगं ॥५४॥",
      "sourceLineId": "101672",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਬਧੇ ਹੀਰ ਚੀਰੰ ਸੁ ਬੀਰੰ ਸੁਬਾਹੰ ॥",
      "transliteration": "badhe heer cheera(n) su beera(n) subaaha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਬਸਤ੍ਰ ਉਤੇ ਹੀਰੇ ਬੰਨ੍ਰਹੇ ਹੋਏ ਹਨ, ਉਹ ਬਲਵਾਨ ਸੂਰਮਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "बधे हीर चीरं सु बीरं सुबाहं ॥",
      "sourceLineId": "101673",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0630_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਬਡੋ ਛਤ੍ਰਧਾਰੀ ਸੋ ਸੋਭਿਓ ਸਿਪਾਹੰ ॥",
      "transliteration": "baddo chhatradhaaree so sobhio sipaaha(n) ||",
      "translation": "The warriors are wearing beautiful garments",
      "punjabiViakhya": "(ਉਹ) ਬਹੁਤ ਵੱਡਾ ਛਤ੍ਰਧਾਰੀ ਹੈ ਅਤੇ (ਉਸ ਨਾਲ) ਸੈਨਾ ਸ਼ੋਭ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 630,
      "hindi": "",
      "hindiTransliteration": "बडो छत्रधारी सो सोभिओ सिपाहं ॥",
      "sourceLineId": "101674",
      "sourceShabadId": "9316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
