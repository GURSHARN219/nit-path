{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 634,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0634_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚਿਤ ਸੋ ਚੁਰਾਵਤ ਭੂਪ ॥੯੬॥",
      "transliteration": "chit so churaavat bhoop ||96||",
      "translation": "Hundreds of kings evaded him, seeing the moonlike beauty of his face.96.",
      "punjabiViakhya": "(ਉਹ) ਰਾਜਾ ਚਿਤ ਨੂੰ ਚੁਰਾ ਲੈਂਦਾ ਹੈ ॥੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "चित सो चुरावत भूप ॥९६॥",
      "sourceLineId": "101843",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਕੈ ਬਡ ਰਾਜ ॥",
      "transliteration": "eeh bhaat kai badd raaj ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਉਸ ਨੇ ਬਹੁਤ ਵੱਡਾ ਰਾਜ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "इह भाति कै बड राज ॥",
      "sourceLineId": "101844",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਹੁ ਜਗ ਧਰਮ ਸਮਾਜ ॥",
      "transliteration": "bahu jag dharam samaaj ||",
      "translation": "In this way, the king ruled like a great sovereign in the world doing religious and social services and performing Yajnas",
      "punjabiViakhya": "ਅਤੇ ਧਰਮ ਦੇ ਸਮਾਜ ਸਹਿਤ ਬਹੁਤ ਸਾਰੇ ਯੱਗ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "बहु जग धरम समाज ॥",
      "sourceLineId": "101845",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਉ ਕਹੋ ਸਰਬ ਬਿਚਾਰ ॥",
      "transliteration": "jau kaho sarab bichaar ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਸਾਰਾ ਪ੍ਰਸੰਗ ਵਿਚਾਰ ਪੂਰਵਕ ਕਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जउ कहो सरब बिचार ॥",
      "sourceLineId": "101846",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਇਕ ਹੋਤ ਕਥਾ ਪਸਾਰ ॥੯੭॥",
      "transliteration": "eik hot kathaa pasaar ||97||",
      "translation": "If I narrate all the things associated with him, the story will be greatly increased.97.",
      "punjabiViakhya": "ਤਾ (ਇਸ) ਇਕ ਕਥਾ ਦਾ ਬਹੁਤ ਵਿਸਤਾਰ ਹੋ ਜਾਵੇਗਾ ॥੯੭॥",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "इक होत कथा पसार ॥९७॥",
      "sourceLineId": "101847",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਿਹ ਤੇ ਸੁ ਥੋਰੀਐ ਬਾਤ ॥",
      "transliteration": "teh te su thoreeaai baat ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਥੋੜੀ ਹੀ ਗੱਲ (ਕਹਿੰਦਾ ਹਾ)।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "तिह ते सु थोरीऐ बात ॥",
      "sourceLineId": "101848",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੁਨਿ ਲੇਹੁ ਭਾਖੋ ਭ੍ਰਾਤ ॥",
      "transliteration": "sun leh bhaakho bhraat ||",
      "translation": "Therefore, I say in brief, O brothers! listen to it",
      "punjabiViakhya": "ਹੇ ਭਰਾਓ! (ਧਿਆਨ ਨਾਲ) ਸੁਣ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "सुनि लेहु भाखो भ्रात ॥",
      "sourceLineId": "101849",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਹੁ ਜਗ ਧਰਮ ਸਮਾਜ ॥",
      "transliteration": "bahu jag dharam samaaj ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਧਰਮ ਤੇ ਸਮਾਜ ਸਹਿਤ ਬਹੁਤ ਯੱਗ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "बहु जग धरम समाज ॥",
      "sourceLineId": "101850",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਕੈ ਅਜਿ ਰਾਜ ॥੯੮॥",
      "transliteration": "eeh bhaat kai aj raaj ||98||",
      "translation": "The king Aj ruled in this way in various ways in religions and society.98.",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਅਜ ਰਾਜਾ ਨੇ (ਰਾਜ) ਕੀਤਾ ॥੯੮॥",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "इह भाति कै अजि राज ॥९८॥",
      "sourceLineId": "101851",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਗ ਆਪਨੋ ਅਜਿ ਮਾਨ ॥",
      "transliteration": "jag aapano aj maan ||",
      "translation": "",
      "punjabiViakhya": "ਅਜ ਰਾਜਾ ਨੇ ਜਗਤ ਨੂੰ ਆਪਣਾ ਕਰ ਕੇ ਮੰਨ ਲਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जग आपनो अजि मान ॥",
      "sourceLineId": "101852",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਰਿ ਆਖ ਆਨ ਨ ਆਨ ॥",
      "transliteration": "tar aakh aan na aan ||",
      "translation": "He abandoned the idea of considering the whole world as his own and did not care for anyone",
      "punjabiViakhya": "ਹੋਰ ਕਿਸੇ ਨੂੰ ਅੱਖ ਥਲੇ ਨਹੀਂ ਲਿਆਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "तरि आख आन न आन ॥",
      "sourceLineId": "101853",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਬ ਕਾਲ ਕੋਪ ਕ੍ਰਵਾਲ ॥",
      "transliteration": "tab kaal kop kravaal ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਕਾਲ ਦੇ ਕ੍ਰੋਧ ਦੀ ਤਲਵਾਰ ('ਕ੍ਰਵਾਲ') (ਪ੍ਰਗਟ ਹੋਈ)",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "तब काल कोप क्रवाल ॥",
      "sourceLineId": "101854",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਜਿ ਜਾਰੀਆ ਮਧਿ ਜ੍ਵਾਲ ॥੯੯॥",
      "transliteration": "aj jaareeaa madh javaiaal ||99||",
      "translation": "Then the great Death, in great rage, reduced king Aj to ashes in his fire.99.",
      "punjabiViakhya": "ਅਤੇ ਅਜ ਰਾਜੇ ਨੂੰ ਅਗਨੀ ਵਿਚ ਸਾੜ ਦਿੱਤਾ ॥੯੯॥",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "अजि जारीआ मधि ज्वाल ॥९९॥",
      "sourceLineId": "101855",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਜਿ ਜੋਤਿ ਜੋਤਿ ਮਿਲਾਨ ॥",
      "transliteration": "aj jot jot milaan ||",
      "translation": "",
      "punjabiViakhya": "ਅਜ ਰਾਜੇ ਦੀ ਜੋਤਿ (ਮਹਾਨ) ਜੋਤਿ ਵਿਚ ਮਿਲ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "अजि जोति जोति मिलान ॥",
      "sourceLineId": "101856",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਬ ਸਰਬ ਦੇਖਿ ਡਰਾਨ ॥",
      "transliteration": "tab sarab dhekh ddaraan ||",
      "translation": "Seeing the king Aj merging in the supreme Light, all the people became fearful like the passengers of a boat without the sailor",
      "punjabiViakhya": "ਤਦ ਸਭ ਲੋਕ ਵੇਖ ਕੇ ਡਰ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "तब सरब देखि डरान ॥",
      "sourceLineId": "101857",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਿਮ ਨਾਵ ਖੇਵਟ ਹੀਨ ॥",
      "transliteration": "jim naav khevaT heen ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੀ ਸਥਿਤੀ ਇਸ ਪ੍ਰਕਾਰ ਸੀ) ਜਿਸ ਤਰ੍ਰਹਾ ਨੌਕਾ ਮਲਾਹ ਤੋਂ ਬਿਨਾ ਹੁੰਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम नाव खेवट हीन ॥",
      "sourceLineId": "101858",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਿਮ ਦੇਹ ਅਰਬਲ ਛੀਨ ॥੧੦੦॥",
      "transliteration": "jim dheh arabal chheen ||100||",
      "translation": "The people became weak like the individual becoming helpless with the loss of physical strength.100.",
      "punjabiViakhya": "ਅਤੇ ਜਿਵੇਾਂ ਦੇਹੀ ਉਮਰ ('ਅਰਬਲ') ਦੇ ਖ਼ਤਮ ਹੋਣ ਤੇ ਹੋ ਜਾਦੀ ਹੈ ॥੧੦੦॥",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम देह अरबल छीन ॥१००॥",
      "sourceLineId": "101859",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਿਮ ਗਾਵ ਰਾਵ ਬਿਹੀਨ ॥",
      "transliteration": "jim gaav raav biheen ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਰਾਓ (ਚੌਧਰੀ) ਤੋਂ ਬਿਨਾ ਪਿੰਡ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम गाव राव बिहीन ॥",
      "sourceLineId": "101860",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਿਮ ਉਰਬਰਾ ਕ੍ਰਿਸ ਛੀਨ ॥",
      "transliteration": "jim urabaraa kiras chheen ||",
      "translation": "Just as a village becomes helpless without a headman, the earth becomes meaningless without fertility,",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਖੇਤੀ ਦੇ ਕਟੇ ਜਾਣ ਤੋਂ ਬਿਨਾ ਉਪਜਾਊ ਧਰਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम उरबरा कृस छीन ॥",
      "sourceLineId": "101861",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਿਮ ਦਿਰਬ ਹੀਣ ਭੰਡਾਰ ॥",
      "transliteration": "jim dhirab heen bha(n)ddaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਧਨ ਤੋਂ ਬਿਨਾ ਖ਼ਜ਼ਾਨਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम दिरब हीण भंडार ॥",
      "sourceLineId": "101862",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਿਮ ਸਾਹਿ ਹੀਣ ਬਿਪਾਰ ॥੧੦੧॥",
      "transliteration": "jim saeh heen bipaar ||101||",
      "translation": "The treasure loses charm without wealth and the trader becomes in low spirit without the trade.101.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਸ਼ਾਹ ਤੋਂ ਬਿਨਾ ਬਪਾਰ ਹੈ ॥੧੦੧॥",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम साहि हीण बिपार ॥१०१॥",
      "sourceLineId": "101863",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਮ ਅਰਥ ਹੀਣ ਕਬਿਤ ॥",
      "transliteration": "jim arath heen kabit ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਅਰਥ ਤੋਂ ਵਿਛੁੰਨੀ ਕਵਿਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम अरथ हीण कबित ॥",
      "sourceLineId": "101864",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਿਨੁ ਪ੍ਰੇਮ ਕੇ ਜਿਮ ਮਿਤ ॥",
      "transliteration": "bin prem ke jim mit ||",
      "translation": "Without the king, the people became like poetry without meaning, friend without love,",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਪ੍ਰੇਮ ਤੋਂ ਬਿਨਾ ਮਿਤਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "बिनु प्रेम के जिम मित ॥",
      "sourceLineId": "101865",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਿਮ ਰਾਜ ਹੀਣ ਸੁ ਦੇਸ ॥",
      "transliteration": "jim raaj heen su dhes ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਰਾਜੇ ਤੋਂ ਬਿਨਾ ਕੋਈ ਦੇਸ਼ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम राज हीण सु देस ॥",
      "sourceLineId": "101866",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਿਮ ਸੈਣ ਹੀਨ ਨਰੇਸ ॥੧੦੨॥",
      "transliteration": "jim sain heen nares ||102||",
      "translation": "The country without the king and as the army becomes helpless without the general.102.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਸੈਨਾ ਤੋਂ ਬਿਨਾ ਰਾਜਾ ਹੈ ॥੧੦੨॥",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम सैण हीन नरेस ॥१०२॥",
      "sourceLineId": "101867",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਿਮ ਗਿਆਨ ਹੀਣ ਜੁਗੇਾਂਦ੍ਰ ॥",
      "transliteration": "jim giaan heen jugeaa(n)dhr ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਗਿਆਨ ਤੋਂ ਬਿਨਾ ਜੋਗੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम गिआन हीण जुगेाँद्र ॥",
      "sourceLineId": "101868",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਿਮ ਭੂਮ ਹੀਣ ਮਹੇਾਂਦ੍ਰ ॥",
      "transliteration": "jim bhoom heen maheaa(n)dhr ||",
      "translation": "That state becomes like a Yogi without knowledge, a king without kingdom,",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਭੂਮੀ ਤੋਂ ਬਿਨਾ ਰਾਜਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम भूम हीण महेाँद्र ॥",
      "sourceLineId": "101869",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਿਮ ਅਰਥ ਹੀਣ ਬਿਚਾਰ ॥",
      "transliteration": "jim arath heen bichaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਅਰਥ ਤੋਂ ਬਿਨਾ ਵਿਚਾਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम अरथ हीण बिचार ॥",
      "sourceLineId": "101870",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਿਮ ਦਰਬ ਹੀਣ ਉਦਾਰ ॥੧੦੩॥",
      "transliteration": "jim dharab heen udhaar ||103||",
      "translation": "The idea without the meaning and the donor without the material.103.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਧਨ ਤੋਂ ਬਿਨਾ ਕੋਈ ਉਦਾਰ ਵਿਅਕਤੀ ਹੈ ॥੧੦੩॥",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम दरब हीण उदार ॥१०३॥",
      "sourceLineId": "101871",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਿਮ ਅੰਕੁਸ ਹੀਣ ਗਜੇਸ ॥",
      "transliteration": "jim a(n)kus heen gajes ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਅੰਕੁਸ਼ ਤੋਂ ਬਿਨਾ ਵੱਡਾ ਹਾਥੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम अंकुस हीण गजेस ॥",
      "sourceLineId": "101872",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਿਮ ਸੈਣ ਹੀਣ ਨਰੇਸ ॥",
      "transliteration": "jim sain heen nares ||",
      "translation": "The people became like an elephant without a goad, the king without the army,",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਸੈਨਾ ਤੋਂ ਬਿਨਾ ਰਾਜਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम सैण हीण नरेस ॥",
      "sourceLineId": "101873",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਿਮ ਸਸਤ੍ਰ ਹੀਣ ਲੁਝਾਰ ॥",
      "transliteration": "jim sasatr heen lujhaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਸ਼ਸਤ੍ਰ ਤੋਂ ਬਿਨਾ ਯੋਧਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम ससत्र हीण लुझार ॥",
      "sourceLineId": "101874",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਿਮ ਬੁਧਿ ਬਾਝ ਬਿਚਾਰ ॥੧੦੪॥",
      "transliteration": "jim budh baajh bichaar ||104||",
      "translation": "The warrior without weapons and the ideas without wiseom.104.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਬੁੱਧੀ ਤੋਂ ਬਿਨਾ ਕੋਈ ਵਿਚਾਰ ਹੈ ॥੧੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम बुधि बाझ बिचार ॥१०४॥",
      "sourceLineId": "101875",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਿਮ ਨਾਰਿ ਹੀਣ ਭਤਾਰ ॥",
      "transliteration": "jim naar heen bhataar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਨਾਰੀ ਤੋਂ ਬਿਨਾ ਪਤੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम नारि हीण भतार ॥",
      "sourceLineId": "101876",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਿਮ ਕੰਤ ਹੀਣ ਸੁ ਨਾਰ ॥",
      "transliteration": "jim ka(n)t heen su naar ||",
      "translation": "They are just like the wife without husband, the woman without beloved,",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕੰਤ ਤੋਂ ਬਿਨਾ ਨਾਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम कंत हीण सु नार ॥",
      "sourceLineId": "101877",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਿਮ ਬੁਧਿ ਹੀਣ ਕਬਿਤ ॥",
      "transliteration": "jim budh heen kabit ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਬੁੱਧੀ ਤੋਂ ਹੀਣੀ ਕਬਿੱਤ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम बुधि हीण कबित ॥",
      "sourceLineId": "101878",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਮ ਪ੍ਰੇਮ ਹੀਣ ਸੁ ਮਿਤ ॥੧੦੫॥",
      "transliteration": "jim prem heen su mit ||105||",
      "translation": "The poetry without wisdom and the friend without love.105.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਪ੍ਰੇਮ ਤੋਂ ਸਖਣਾ ਮਿਤਰ ਹੈ ॥੧੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम प्रेम हीण सु मित ॥१०५॥",
      "sourceLineId": "101879",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਿਮ ਦੇਸ ਭੂਪ ਬਿਹੀਨ ॥",
      "transliteration": "jim dhes bhoop biheen ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਦੇਸ ਤੋਂ ਬਿਨਾ ਰਾਜਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम देस भूप बिहीन ॥",
      "sourceLineId": "101880",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਿਨੁ ਕੰਤ ਨਾਰਿ ਅਧੀਨ ॥",
      "transliteration": "bin ka(n)t naar adheen ||",
      "translation": "They are just like the country becoming desolate, the women losing their husbands,",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਪਤੀ ਤੋਂ ਬਿਨਾ ਨਾਰੀ ਅਧੀਨ ਹੁੰਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "बिनु कंत नारि अधीन ॥",
      "sourceLineId": "101881",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਿਹ ਭਾਤਿ ਬਿਪ੍ਰ ਅਬਿਦਿ ॥",
      "transliteration": "jeh bhaat bipr abidh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਅਨਪੜ੍ਰਹ ਬ੍ਰਾਹਮਣ ਹੁੰਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिह भाति बिप्र अबिदि ॥",
      "sourceLineId": "101882",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਿਮ ਅਰਥ ਹੀਣ ਸਬਿਦਿ ॥੧੦੬॥",
      "transliteration": "jim arath heen sabidh ||106||",
      "translation": "The Brahmins without learning or the men without wealth.106.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਅਰਥ (ਗਿਆਨ) ਤੋਂ ਬਿਨਾ ਵਿਦਵਾਨ ਹੈ ॥੧੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिम अरथ हीण सबिदि ॥१०६॥",
      "sourceLineId": "101883",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤੇ ਕਹੇ ਸਰਬ ਨਰੇਸ ॥",
      "transliteration": "te kahe sarab nares ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸਾਰੇ ਰਾਜੇ ਕਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "ते कहे सरब नरेस ॥",
      "sourceLineId": "101884",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜੇ ਆ ਗਏ ਇਹ ਦੇਸਿ ॥",
      "transliteration": "je aa ge ieh dhes ||",
      "translation": "In this way, the kings, who ruled over this country, how can they be described?",
      "punjabiViakhya": "ਜੋ ਇਸ ਦੇਸ ਵਿਚ ਪੈਦਾ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जे आ गए इह देसि ॥",
      "sourceLineId": "101885",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਰਿ ਅਸਟ ਦਸ੍ਰਯ ਪੁਰਾਨਿ ॥",
      "transliteration": "kar asaT dhasray puraan ||",
      "translation": "",
      "punjabiViakhya": "(ਬਿਆਸ ਨੇ) ਅਠਾਰ੍ਰਹਾ ਪੁਰਾਣ ਬਣਾਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "करि असट दस्रय पुरानि ॥",
      "sourceLineId": "101886",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਦਿਜ ਬਿਆਸ ਬੇਦ ਨਿਧਾਨ ॥੧੦੭॥",
      "transliteration": "dhij biaas bedh nidhaan ||107||",
      "translation": "Vyas, the store of Vedic learning, composed eighteen Puranas.107.",
      "punjabiViakhya": "ਬਿਆਸ ਪੰਡਿਤ ਵੇਦਾ ਦਾ ਖ਼ਜ਼ਾਨਾ ਹੈ ॥੧੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "दिज बिआस बेद निधान ॥१०७॥",
      "sourceLineId": "101887",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕੀਨੇ ਅਠਾਰਹ ਪਰਬ ॥",
      "transliteration": "keene aThaareh parab ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਸ ਨੇ (ਮਹਾਭਾਰਤ) ਦੇ ਅਠਾਰ੍ਰਹਾ ਪਰਬ ਬਣਾਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "कीने अठारह परब ॥",
      "sourceLineId": "101888",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਗ ਰੀਝੀਆ ਸੁਨਿ ਸਰਬ ॥",
      "transliteration": "jag reejheeaa sun sarab ||",
      "translation": "He composed eighteen parvas (parts of Mahabharata), listening which th whole world was pleased",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨੂੰ) ਸੁਣ ਕ ਸਾਰਾ ਜਗਤ ਰੀਝ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जग रीझीआ सुनि सरब ॥",
      "sourceLineId": "101889",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਇਹ ਬਿਆਸ ਬ੍ਰਹਮ ਵਤਾਰ ॥",
      "transliteration": "eeh biaas braham vataar ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਬਿਆਸ ਬ੍ਰਹਮਾ ਦਾ ਅਵਤਾਰ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "इह बिआस ब्रहम वतार ॥",
      "sourceLineId": "101890",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਭਏ ਪੰਚਮੋ ਮੁਖ ਚਾਰ ॥੧੦੮॥",
      "transliteration": "bhe pa(n)chamo mukh chaar ||108||",
      "translation": "In this way Vyas was the fifth incarnation of Brahma.108.",
      "punjabiViakhya": "ਇਹ ਬ੍ਰਹਮਾ ਦਾ ਪੰਜਵਾ ਅਵਤਾਰ ਹੈ ॥੧੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "भए पंचमो मुख चार ॥१०८॥",
      "sourceLineId": "101891",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਪੰਚਮੋਵਤਾਰ ਬ੍ਰਹਮਾ ਬਿਆਸ ਰਾਜਾ ਅਜ ਕੋ ਰਾਜ ਸਮਾਪਤੰ ॥੧੦॥੫॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the pa(n)chamovataar brahamaa biaas raajaa aj ko raaj samaapata(n) ||10||5||",
      "translation": "End of the description of Vyas the fifth incarnation of Brahma and the rule of king Aj in Bachittar Natak.5.",
      "punjabiViakhya": "ਇਥੇ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ ਪੰਜਵੇਾਂ ਅਵਤਾਰ ਬ੍ਰਹਮਾ ਬਿਆਸ, ਅਜ ਰਾਜਾ ਦੇ ਰਾਜ ਦੀ ਸਮਾਪਤੀ ॥੧੦॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे पंचमोवतार ब्रहमा बिआस राजा अज को राज समापतं ॥१०॥५॥",
      "sourceLineId": "101892",
      "sourceShabadId": "9321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅਥ ਬ੍ਰਹਮਾਵਤਾਰ ਖਟ ਰਿਖਿ ਕਥਨੰ ॥",
      "transliteration": "ath brahamaavataar khaT rikh kathana(n) ||",
      "translation": "Now begins the description of six sages, the sixth incarnation of Brahma",
      "punjabiViakhya": "ਹੁਣ ਬ੍ਰਹਮਾਵਤਾਰ ਖਟ ਰਿਖਿ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "अथ ब्रहमावतार खट रिखि कथनं ॥",
      "sourceLineId": "101893",
      "sourceShabadId": "9322",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਤੋਮਰ ਛੰਦ ॥",
      "transliteration": "tomar chha(n)dh ||",
      "translation": "TOMAR STANZA",
      "punjabiViakhya": "ਤੋਮਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "तोमर छंद ॥",
      "sourceLineId": "101894",
      "sourceShabadId": "9322",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜੁਗ ਆਗਲੇ ਇਹ ਬਿਆਸ ॥",
      "transliteration": "jug aagale ieh biaas ||",
      "translation": "",
      "punjabiViakhya": "ਅਗਲੇ ਯੁਗ ਵਿਚ ਬਿਆਸ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जुग आगले इह बिआस ॥",
      "sourceLineId": "101895",
      "sourceShabadId": "9322",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਗਿ ਕੀਅ ਪੁਰਾਣ ਪ੍ਰਕਾਸ ॥",
      "transliteration": "jag keea puraan prakaas ||",
      "translation": "In this next Age, Vyas composed Puranas in the world and in doing this his prie was also increased",
      "punjabiViakhya": "ਜਗਤ ਵਿਚ ਪੁਰਾਣਾ ਦਾ ਪ੍ਰਕਾਸ਼ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जगि कीअ पुराण प्रकास ॥",
      "sourceLineId": "101896",
      "sourceShabadId": "9322",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਤਬ ਬਾਢਿਆ ਤਿਹ ਗਰਬ ॥",
      "transliteration": "tab baaddiaa teh garab ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਦਾ ਹੰਕਾਰ ਵਧ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "तब बाढिआ तिह गरब ॥",
      "sourceLineId": "101897",
      "sourceShabadId": "9322",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਰ ਆਪ ਜਾਨਿ ਨ ਸਰਬ ॥੧॥",
      "transliteration": "sar aap jaan na sarab ||1||",
      "translation": "He also did not considered anyone equal to him.1.",
      "punjabiViakhya": "ਉਹ ਸਾਰਿਆਂ ਨੂੰ ਆਪਣੇ ਸਮਾਨ ਨਹੀਂ ਸਮਝਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "सर आप जानि न सरब ॥१॥",
      "sourceLineId": "101898",
      "sourceShabadId": "9322",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਤਬ ਕੋਪਿ ਕਾਲ ਕ੍ਰਵਾਲ ॥",
      "transliteration": "tab kop kaal kravaal ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਕਾਲ ਨੇ ਤਲਵਾਰ ਕਢ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "तब कोपि काल क्रवाल ॥",
      "sourceLineId": "101899",
      "sourceShabadId": "9322",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਜਿਹ ਜਾਲ ਜ੍ਵਾਲ ਬਿਸਾਲ ॥",
      "transliteration": "jeh jaal javaiaal bisaal ||",
      "translation": "Then the dreadful KAL (death) in his rage divided him into six parts with his great fires",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਅਗਨੀ ਦੀ ਲਾਟ ਬਹੁਤ ਪਸਰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "जिह जाल ज्वाल बिसाल ॥",
      "sourceLineId": "101900",
      "sourceShabadId": "9322",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਖਟ ਟੂਕ ਤਾ ਕਹ ਕੀਨ ॥",
      "transliteration": "khaT Took taa keh keen ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਬ੍ਰਹਮਾ ਦੇ ਛੇ ਟੋਟੇ ਕਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "खट टूक ता कह कीन ॥",
      "sourceLineId": "101901",
      "sourceShabadId": "9322",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਪੁਨਿ ਜਾਨ ਕੈ ਤਿਨਿ ਦੀਨ ॥੨॥",
      "transliteration": "pun jaan kai tin dheen ||2||",
      "translation": "Then they ware considered lowly.2.",
      "punjabiViakhya": "ਫਿਰ ਉਸ ਨੂੰ ਦੀਨ ਸਮਝ ਕੇ ਜਾਨ ਬੁਖਸ਼ ਦਿੱਤੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "पुनि जान कै तिनि दीन ॥२॥",
      "sourceLineId": "101902",
      "sourceShabadId": "9322",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਨਹੀ ਲੀਨ ਪ੍ਰਾਨ ਨਿਕਾਰ ॥",
      "transliteration": "nahee leen praan nikaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਪ੍ਰਾਣ ਨਹੀਂ ਕਢੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "नही लीन प्रान निकार ॥",
      "sourceLineId": "101903",
      "sourceShabadId": "9322",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਭਏ ਖਸਟ ਰਿਖੈ ਅਪਾਰ ॥",
      "transliteration": "bhe khasaT rikhai apaar ||",
      "translation": "His life-force was not terminated and form his six parts emerged six sages,",
      "punjabiViakhya": "ਫਿਰ ਛੇ (ਸ਼ਾਸਤ੍ਰਾ) ਵਾਲੇ ਅਪਾਰ ਰਿਸ਼ੀ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "भए खसट रिखै अपार ॥",
      "sourceLineId": "101904",
      "sourceShabadId": "9322",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਤਿਨ ਸਾਸਤ੍ਰਗ ਬਿਚਾਰ ॥",
      "transliteration": "tin saasatrag bichaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਸ਼ਾਸਤ੍ਰਾ ਦੇ ਗਿਆਨ ਉਤੇ ਵਿਚਾਰ ਕੀਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "तिन सासत्रग बिचार ॥",
      "sourceLineId": "101905",
      "sourceShabadId": "9322",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਖਟ ਸਾਸਤ੍ਰ ਨਾਮ ਸੁ ਡਾਰਿ ॥੩॥",
      "transliteration": "khaT saasatr naam su ddaar ||3||",
      "translation": "Who were the wupreme scholars of Shastras and they compsed six Shastras in their names.3.",
      "punjabiViakhya": "(ਜਿਸ ਕਰ ਕੇ) ਉਨ੍ਰਹਾ ਦਾ ਛੇ ਸ਼ਾਸਤ੍ਰ ਨਾ ਪ੍ਰਚਲਿਤ ਹੋ ਗਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "खट सासत्र नाम सु डारि ॥३॥",
      "sourceLineId": "101906",
      "sourceShabadId": "9322",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਖਟ ਸਾਸਤ੍ਰ ਕੀਨ ਪ੍ਰਕਾਸ ॥",
      "transliteration": "khaT saasatr keen prakaas ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਛੇ ਸ਼ਾਸਤ੍ਰਾ ਦਾ ਪ੍ਰਕਾਸ਼ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "खट सासत्र कीन प्रकास ॥",
      "sourceLineId": "101907",
      "sourceShabadId": "9322",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਮੁਖਚਾਰ ਬਿਆਸ ਸੁ ਭਾਸ ॥",
      "transliteration": "mukhachaar biaas su bhaas ||",
      "translation": "These six sages of the lustre of Brahma and Yyas, brought to light six Shastras and in this way,",
      "punjabiViakhya": "ਉਹ ਬਿਆਸ ਬ੍ਰਹਮਾ (ਦੇ ਅਵਤਾਰ ਰੂਪ ਵਿਚ) ਪ੍ਰਗਟ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "मुखचार बिआस सु भास ॥",
      "sourceLineId": "101908",
      "sourceShabadId": "9322",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਧਰਿ ਖਸਟਮੋ ਅਵਤਾਰ ॥",
      "transliteration": "dhar khasaTamo avataar ||",
      "translation": "",
      "punjabiViakhya": "ਛੇਵਾ ਅਵਤਾਰ ਧਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "धरि खसटमो अवतार ॥",
      "sourceLineId": "101909",
      "sourceShabadId": "9322",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਖਟ ਸਾਸਤ੍ਰ ਕੀਨ ਸੁਧਾਰਿ ॥੪॥",
      "transliteration": "khaT saasatr keen sudhaar ||4||",
      "translation": "Brahma assumed the sixth incarnation made ideological improvements over the earth through six Shastras.4.",
      "punjabiViakhya": "ਛੇ ਸ਼ਾਸਤ੍ਰਾ ਦਾ ਸੁਧਾਰ ਕੀਤਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "खट सासत्र कीन सुधारि ॥४॥",
      "sourceLineId": "101910",
      "sourceShabadId": "9322",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਖਸਟਮੋ ਅਵਤਾਰ ਬ੍ਰਹਮਾ ਖਸਟ ਰਿਖ ਸਮਾਪਤੰ ॥੬॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the khasaTamo avataar brahamaa khasaT rikh samaapata(n) ||6||",
      "translation": "End of the description about six sages, the sixth incarnation of Brahma in Bhachittar Natak.6.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ ਛੇਵੇਾਂ ਅਵਤਾਰ ਬ੍ਰਹਮਾ ਅਤੇ ਛੇ ਰਿਸ਼ੀ ਸਮਾਪਤ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे खसटमो अवतार ब्रहमा खसट रिख समापतं ॥६॥",
      "sourceLineId": "101911",
      "sourceShabadId": "9322",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਅਥ ਬ੍ਰਹਮਾਵਤਾਰ ਕਾਲਿਦਾਸ ਕਥਨੰ ॥",
      "transliteration": "ath brahamaavataar kaalidhaas kathana(n) ||",
      "translation": "Now begins the description of Kalidas Incarnation",
      "punjabiViakhya": "ਹੁਣ ਬ੍ਰਹਮਾਵਤਾਰ ਕਾਲਿਦਾਸ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "अथ ब्रहमावतार कालिदास कथनं ॥",
      "sourceLineId": "101912",
      "sourceShabadId": "9323",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਤੋਮਰ ਛੰਦ ॥",
      "transliteration": "tomar chha(n)dh ||",
      "translation": "TOMAR STANZA",
      "punjabiViakhya": "ਤੋਮਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "तोमर छंद ॥",
      "sourceLineId": "101913",
      "sourceShabadId": "9323",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0634_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਇਹ ਬ੍ਰਹਮ ਬੇਦ ਨਿਧਾਨ ॥",
      "transliteration": "eeh braham bedh nidhaan ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਬ੍ਰਹਮਾ ਵੇਦਾ ਦਾ ਜ਼ਖ਼ਾਨਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 634,
      "hindi": "",
      "hindiTransliteration": "इह ब्रहम बेद निधान ॥",
      "sourceLineId": "101914",
      "sourceShabadId": "9323",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
