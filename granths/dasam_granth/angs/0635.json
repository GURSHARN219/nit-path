{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 635,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0635_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦਸ ਅਸਟ ਸਾਸਤ੍ਰ ਪ੍ਰਮਾਨ ॥",
      "transliteration": "dhas asaT saasatr pramaan ||",
      "translation": "",
      "punjabiViakhya": "ਅਠਾਰ੍ਰਹਾ ਸ਼ਾਸਤ੍ਰਾ ਦਾ ਪ੍ਰਮਾਣਿਕ ਵਿਦਵਾਨ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "दस असट सासत्र प्रमान ॥",
      "sourceLineId": "101915",
      "sourceShabadId": "9323",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਲਿ ਜੁਗਿਯ ਲਾਗ ਨਿਹਾਰਿ ॥",
      "transliteration": "kal jugiy laag nihaar ||",
      "translation": "",
      "punjabiViakhya": "ਕਲਿਯੁਗ ਨੂੰ ਲਗੇ ਹੋਏ ਵਿਚਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "कलि जुगिय लाग निहारि ॥",
      "sourceLineId": "101916",
      "sourceShabadId": "9323",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭਏ ਕਾਲਿਦਾਸ ਅਬਿਚਾਰ ॥੧॥",
      "transliteration": "bhe kaalidhaas abichaar ||1||",
      "translation": "This Brahma, the ocean of Vedas, who was the authentic knower of eighteen Puranas and Shastras, began to scan the whole world in his incarnation named Kalidas in the Iron Age.1.",
      "punjabiViakhya": "ਬ੍ਰਹਮ ਆਪ ਕਾਲੀਦਾਸ ਰੂਪ ਹੋ ਗਿਆ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "भए कालिदास अबिचार ॥१॥",
      "sourceLineId": "101917",
      "sourceShabadId": "9323",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਲਖਿ ਰੀਝ ਬਿਕ੍ਰਮਜੀਤ ॥",
      "transliteration": "lakh reejh bikramajeet ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ ਵੇਖ ਕੇ) ਬਿਕ੍ਰਮਾਜੀਤ ਪ੍ਰਸੰਨ ਹੁੰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "लखि रीझ बिक्रमजीत ॥",
      "sourceLineId": "101918",
      "sourceShabadId": "9323",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਤਿ ਗਰਬਵੰਤ ਅਜੀਤ ॥",
      "transliteration": "at garabava(n)t ajeet ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ (ਆਪ) ਬਹੁਤ ਹੰਕਾਰੀ ਅਤੇ ਨਾ ਜਿਤੇ ਜਾ ਸਕਣ ਵਾਲਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "अति गरबवंत अजीत ॥",
      "sourceLineId": "101919",
      "sourceShabadId": "9323",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਤਿ ਗਿਆਨ ਮਾਨ ਗੁਨੈਨ ॥",
      "transliteration": "at giaan maan gunain ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬਹੁਤ ਗੰਭੀਰ ਗਿਆਨ ਵਾਲਾ, ਗੁਣਾ ਦਾ ਘਰ,",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "अति गिआन मान गुनैन ॥",
      "sourceLineId": "101920",
      "sourceShabadId": "9323",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੁਭ ਕ੍ਰਾਤਿ ਸੁੰਦਰ ਨੈਨ ॥੨॥",
      "transliteration": "subh kraat su(n)dhar nain ||2||",
      "translation": "The king Vikramaditya, who himself was glorious, unconquerable, scholar, full of virtues with auspicious brightness and charming eyes, remained pleased on seeing kalidas.2.",
      "punjabiViakhya": "ਸ਼ੁਭ ਕਾਤੀ ਵਾਲਾ ਅਤੇ ਸੁੰਦਰ ਨੈਣਾ ਵਾਲਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "सुभ क्राति सुँदर नैन ॥२॥",
      "sourceLineId": "101921",
      "sourceShabadId": "9323",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਘੁ ਕਾਬਿ ਕੀਨ ਸੁਧਾਰਿ ॥",
      "transliteration": "ragh kaab keen sudhaar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਬਹੁਤ ਸੁੰਦਰ ਢੰਗ ਨਾਲ 'ਰਘੁਬੰਸ' (ਨਾ ਦਾ) ਕਾਵਿ ਰਚਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "रघु काबि कीन सुधारि ॥",
      "sourceLineId": "101922",
      "sourceShabadId": "9323",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਰਿ ਕਾਲਿਦਾਸ ਵਤਾਰ ॥",
      "transliteration": "kar kaalidhaas vataar ||",
      "translation": "After his manifestation, Kalidas composed in chastened form his poem ‘Raghuvansh’",
      "punjabiViakhya": "ਕਾਲੀਦਾਸ ਦਾ ਅਵਤਾਰ ਧਾਰ ਕੇ (ਬ੍ਰਹਮਾ ਨੇ ਇਹ ਕੰਮ ਕੀਤਾ)।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "करि कालिदास वतार ॥",
      "sourceLineId": "101923",
      "sourceShabadId": "9323",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਹ ਲੌ ਬਖਾਨੋ ਤਉਨ ॥",
      "transliteration": "keh lau bakhaano taun ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦਾ ਕਿਥੋਂ ਤਕ ਬਖਾਨ ਕਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "कह लौ बखानो तउन ॥",
      "sourceLineId": "101924",
      "sourceShabadId": "9323",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੋ ਕਾਬਿ ਕੀਨੋ ਜਉਨ ॥੩॥",
      "transliteration": "jo kaab keeno jaun ||3||",
      "translation": "To what extent I should describe the number of poems that he composed?3.",
      "punjabiViakhya": "ਜੋ ਕਾਵਿ ਉਸ (ਕਾਲਿਦਾਸ) ਨੇ ਰਚੇ ਸਨ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "जो काबि कीनो जउन ॥३॥",
      "sourceLineId": "101925",
      "sourceShabadId": "9323",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਧਰਿ ਸਪਤ ਬ੍ਰਹਮ ਵਤਾਰ ॥",
      "transliteration": "dhar sapat braham vataar ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਪ੍ਰਕਾਰ) ਬ੍ਰਹਮਾ ਨੇ ਸੱਤ ਅਵਤਾਰ ਧਾਰਨ ਕੀਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "धरि सपत ब्रहम वतार ॥",
      "sourceLineId": "101926",
      "sourceShabadId": "9323",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਬ ਭਇਓ ਤਾਸੁ ਉਧਾਰ ॥",
      "transliteration": "tab bhio taas udhaar ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਜਾ ਕੇ ਉਸ ਦਾ ਉੱਧਾਰ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "तब भइओ तासु उधार ॥",
      "sourceLineId": "101927",
      "sourceShabadId": "9323",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਬ ਧਰਾ ਬ੍ਰਹਮ ਸਰੂਪ ॥",
      "transliteration": "tab dharaa braham saroop ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਉਸ ਨੇ) ਬ੍ਰਹਮਾ ਦਾ ਸਰੂਪ ਧਾਰਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "तब धरा ब्रहम सरूप ॥",
      "sourceLineId": "101928",
      "sourceShabadId": "9323",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮੁਖਚਾਰ ਰੂਪ ਅਨੂਪ ॥੪॥",
      "transliteration": "mukhachaar roop anoop ||4||",
      "translation": "He was the seventh incarnation of Brahma and when he was redeemed, then he assumed the form of fourheaded Brahma i.e. merged himself in Brahma.4.",
      "punjabiViakhya": "ਜੋ ਉਪਮਾ ਰਹਿਤ ਚੌਮੂੰਹਾ ਰੂਪ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "मुखचार रूप अनूप ॥४॥",
      "sourceLineId": "101929",
      "sourceShabadId": "9323",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਸਪਤਮੋ ਅਵਤਾਰ ਬ੍ਰਹਮਾ ਕਾਲਿਦਾਸ ਸਮਾਪਤਮ ॥੭॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the sapatamo avataar brahamaa kaalidhaas samaapatam ||7||",
      "translation": "End of the description of Kalidas, the seventh incarnation of Brahma in a Bachittar Natak.7.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ ਬ੍ਰਹਮਾ ਦੇ ਸੱਤਵੇਾਂ ਕਾਲਿਦਾਸ ਦੀ ਸਮਾਪਤੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे सपतमो अवतार ब्रहमा कालिदास समापतम ॥७॥",
      "sourceLineId": "101930",
      "sourceShabadId": "9323",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰੁਦ੍ਰ ਅਵਤਾਰ ॥",
      "transliteration": "rudhr avataar ||",
      "translation": "Rudra Avatar",
      "punjabiViakhya": "ਰੁਦ੍ਰ ਅਵਤਾਰ:",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "रुद्र अवतार ॥",
      "sourceLineId": "101931",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ੴ ਸਤਿਗੁਰਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satiguraprasaadh ||",
      "translation": "The Lord is One and He can be realized through the Grace of the True Guru.",
      "punjabiViakhya": "ੴ ਸਤਿਗੁਰਪ੍ਰਸਾਦਿ:",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "ੴ सतिगुरप्रसादि ॥",
      "sourceLineId": "101932",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ ॥",
      "transliteration": "sree bhagautee jee sahai ||",
      "translation": "The Lord is One and He can be realized through the Grace of the True Guru.",
      "punjabiViakhya": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ:",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "स्री भगउती जी सहाइ ॥",
      "sourceLineId": "101933",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਥ ਰੁਦ੍ਰ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "transliteration": "ath rudhr avataar kathana(n) ||",
      "translation": "Now begins the description of Rudra Incarnation",
      "punjabiViakhya": "ਹੁਣ ਰੁਦ੍ਰ ਅਵਤਾਰ ਦਾ ਕਥਨ:",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "अथ रुद्र अवतार कथनं ॥",
      "sourceLineId": "101934",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤੋਮਰ ਛੰਦ ॥",
      "transliteration": "tomar chha(n)dh ||",
      "translation": "TOMAR STANZA",
      "punjabiViakhya": "ਤੋਮਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "तोमर छंद ॥",
      "sourceLineId": "101935",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਬ ਕਹੋ ਤਉਨ ਸੁਧਾਰਿ ॥",
      "transliteration": "ab kaho taun sudhaar ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਉਸ ਨੂੰ ਸੁਧਾਰ ਕੇ ਕਹਿੰਦਾ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "अब कहो तउन सुधारि ॥",
      "sourceLineId": "101936",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜੇ ਧਰੇ ਰੁਦ੍ਰ ਅਵਤਾਰ ॥",
      "transliteration": "je dhare rudhr avataar ||",
      "translation": "Now I describe in chastened form those incarnations, which were assumed by Rudra",
      "punjabiViakhya": "ਜੋ ਰੁਦ੍ਰ ਨੇ ਅਵਤਾਰ ਧਾਰਨ ਕੀਤੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "जे धरे रुद्र अवतार ॥",
      "sourceLineId": "101937",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਤਿ ਜੋਗ ਸਾਧਨ ਕੀਨ ॥",
      "transliteration": "at jog saadhan keen ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਬਹੁਤ ਯੋਗ ਸਾਧਨਾ ਕੀਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "अति जोग साधन कीन ॥",
      "sourceLineId": "101938",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਬ ਗਰਬ ਕੇ ਰਸਿ ਭੀਨ ॥੧॥",
      "transliteration": "tab garab ke ras bheen ||1||",
      "translation": "Performing extreme austerities Rudra became egoistic.1.",
      "punjabiViakhya": "ਤਦ ਉਹ ਹੰਕਾਰ ਦੇ ਰਸ ਵਿਚ ਭਿਜ ਗਿਆ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "तब गरब के रसि भीन ॥१॥",
      "sourceLineId": "101939",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਰਿ ਆਪ ਜਾਨ ਨ ਅਉਰ ॥",
      "transliteration": "sar aap jaan na aaur ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਬਰਾਬਰ ਕਿਸੇ ਹੋਰ ਨੂੰ ਨਾ ਜਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "सरि आप जान न अउर ॥",
      "sourceLineId": "101940",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਬ ਦੇਸ ਮੋ ਸਬ ਠੌਰ ॥",
      "transliteration": "sab dhes mo sab Thauar ||",
      "translation": "He did not consider anyone equal to him in all place and countries, then Mahakal (the great death) in ire said to him thus",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਦੇਸਾ ਅਤੇ ਸਾਰਿਆਂ ਸਥਾਨਾ ਵਿਚ (ਉਸ ਨੇ)।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "सब देस मो सब ठौर ॥",
      "sourceLineId": "101941",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਬ ਕੋਪਿ ਕੈ ਇਮ ਕਾਲ ॥",
      "transliteration": "tab kop kai im kaal ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕਾਲ (ਪੁਰਖ) ਨੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਜਲਦੀ ਨਾਲ (ਰੁਦ੍ਰ ਪ੍ਰਤਿ)",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "तब कोपि कै इम काल ॥",
      "sourceLineId": "101942",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਇਮ ਭਾਖਿ ਬੈਣ ਉਤਾਲ ॥੨॥",
      "transliteration": "eim bhaakh bain utaal ||2||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਬਚਨ ਕੀਤਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "इम भाखि बैण उताल ॥२॥",
      "sourceLineId": "101943",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜੇ ਗਰਬ ਲੋਕ ਕਰੰਤ ॥",
      "transliteration": "je garab lok kara(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਲੋਗ ਹੰਕਾਰ ('ਗਰਬ') ਕਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "जे गरब लोक करंत ॥",
      "sourceLineId": "101944",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤੇ ਜਾਨ ਕੂਪ ਪਰੰਤ ॥",
      "transliteration": "te jaan koop para(n)t ||",
      "translation": "“Those who become proud, they deliberately perform the action of falling into a well",
      "punjabiViakhya": "ਉਹ ਜਾਣ ਬੁਝ ਕੇ ਖੂਹ ਵਿਚ ਪੈਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "ते जान कूप परंत ॥",
      "sourceLineId": "101945",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮੁਰ ਨਾਮ ਗਰਬ ਪ੍ਰਹਾਰ ॥",
      "transliteration": "mur naam garab prahaar ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰਾ ਨਾ ਗਰਬ ਪ੍ਰਹਾਰਕ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "मुर नाम गरब प्रहार ॥",
      "sourceLineId": "101946",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੁਨ ਲੇਹੁ ਰੁਦ੍ਰ ਬਿਚਾਰ ॥੩॥",
      "transliteration": "sun leh rudhr bichaar ||3||",
      "translation": "O Rudra! Listen to me attentively that my name is also the destroyer of ego.3.",
      "punjabiViakhya": "ਹੇ ਰੁਦ੍ਰ! ਵਿਚਾਰ ਪੂਰਵਕ ਸੁਣ ਲਵੋ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "सुन लेहु रुद्र बिचार ॥३॥",
      "sourceLineId": "101947",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕੀਅ ਗਰਬ ਕੋ ਮੁਖ ਚਾਰ ॥",
      "transliteration": "keea garab ko mukh chaar ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਹਮਾ ਨੇ ਹੰਕਾਰ ਕੀਤਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "कीअ गरब को मुख चार ॥",
      "sourceLineId": "101948",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਛੁ ਚਿਤ ਮੋ ਅਬਿਚਾਰਿ ॥",
      "transliteration": "kachh chit mo abichaar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਿਤ ਵਿਚ ਅਨੁਚਿਤ ਵਿਚਾਰ ਬਣਾਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "कछु चित मो अबिचारि ॥",
      "sourceLineId": "101949",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਬ ਧਰੇ ਤਿਨ ਤਨ ਸਾਤ ॥",
      "transliteration": "jab dhare tin tan saat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਜਦ ਸੱਤ ਰੂਪ ਧਾਰਨ ਕੀਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "जब धरे तिन तन सात ॥",
      "sourceLineId": "101950",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਬ ਬਨੀ ਤਾ ਕੀ ਬਾਤ ॥੪॥",
      "transliteration": "tab banee taa kee baat ||4||",
      "translation": "“Brahma had also become egoistic in his mind and the evil notions arose there, but when he took birth for seven times, he was then redeemed.4.",
      "punjabiViakhya": "ਤਦ ਉਸ ਦੀ ਗੱਲ ਬਣੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "तब बनी ता की बात ॥४॥",
      "sourceLineId": "101951",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਿਮ ਜਨਮੁ ਧਰੁ ਤੈ ਜਾਇ ॥",
      "transliteration": "tim janam dhar tai jai ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮੁਨੀ ਰਾਜ! ਚਿਤ ਦੇ ਕੇ ਸੁਣੋ",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "तिम जनमु धरु तै जाइ ॥",
      "sourceLineId": "101952",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚਿਤ ਦੇ ਸੁਨੋ ਮੁਨਿ ਰਾਇ ॥",
      "transliteration": "chit dhe suno mun rai ||",
      "translation": "“O the king of sages! listen to what I say and in the same way, you may go and take birth on the earth",
      "punjabiViakhya": "ਅਤੇ ਉਸੇ ਤਰ੍ਰਹਾ ਤੁਸੀਂ ਵੀ ਜਨਮ ਧਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "चित दे सुनो मुनि राइ ॥",
      "sourceLineId": "101953",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਹੀ ਐਸ ਹੋਇ ਉਧਾਰ ॥",
      "transliteration": "nahee aais hoi udhaar ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤੋਂ ਬਿਨਾ ਹੋਰ (ਕਿਸੇ ਢੰਗ ਨਾਲ) ਉੱਧਾਰ ਨਹੀਂ ਹੋਣਾ,",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "नही ऐस होइ उधार ॥",
      "sourceLineId": "101954",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੁਨ ਲੇਹੁ ਰੁਦ੍ਰ ਬਿਚਾਰ ॥੫॥",
      "transliteration": "sun leh rudhr bichaar ||5||",
      "translation": "Otherwise, O Rudra! You will not be redeemed in any other way.”5.",
      "punjabiViakhya": "ਹੇ ਰੁਦ੍ਰ! (ਇਸ) ਵਿਚਾਰ ਨੂੰ ਸੁਣ ਲਵੋ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "सुन लेहु रुद्र बिचार ॥५॥",
      "sourceLineId": "101955",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੁਨਿ ਸ੍ਰਵਨ ਏ ਸਿਵ ਬੈਨ ॥",
      "transliteration": "sun sravan e siv bain ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਨੇ ਕੰਨਾ ਨਾਲ ਇਹ ਬਚਨ ਸੁਣ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "सुनि स्रवन ए सिव बैन ॥",
      "sourceLineId": "101956",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹਠ ਛਾਡਿ ਸੁੰਦਰ ਨੈਨ ॥",
      "transliteration": "haTh chhaadd su(n)dhar nain ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ) ਸੁੰਦਰ ਨੈਣਾ ਵਾਲੇ ਨੇ ਹਠ ਛਡ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "हठ छाडि सुँदर नैन ॥",
      "sourceLineId": "101957",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਿਹ ਜਾਨਿ ਗਰਬ ਪ੍ਰਹਾਰ ॥",
      "transliteration": "teh jaan garab prahaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਕਾਲ ਪੁਰਖ) ਨੂੰ ਗਰਬ ਪ੍ਰਹਾਰਕ ਜਾਣ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "तिह जानि गरब प्रहार ॥",
      "sourceLineId": "101958",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਛਿਤਿ ਲੀਨ ਆਨਿ ਵਤਾਰ ॥੬॥",
      "transliteration": "chhit leen aan vataar ||6||",
      "translation": "Hearing this, Shiva, considering the Lord as the destroyer of ego, and leaving his persistence, incarnated on earth.6.",
      "punjabiViakhya": "(ਰੁਦ੍ਰ ਨੇ) ਧਰਤੀ ਉਤੇ ਆ ਕੇ ਅਵਤਾਰ ਲਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "छिति लीन आनि वतार ॥६॥",
      "sourceLineId": "101959",
      "sourceShabadId": "9324",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪਾਧਰੀ ਛੰਦ ॥",
      "transliteration": "paadharee chha(n)dh ||",
      "translation": "PAADHARI STANZA",
      "punjabiViakhya": "ਪਾਧਰੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "पाधरी छंद ॥",
      "sourceLineId": "101960",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਿਮ ਕਥੇ ਸਰਬ ਰਾਜਾਨ ਰਾਜ ॥",
      "transliteration": "jim kathe sarab raajaan raaj ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ (ਪਿਛੇ) ਸਾਰਿਆਂ ਰਾਜਿਆਂ ਦੇ ਰਾਜ (ਦਾ ਹਾਲ) ਕਥਨ ਕੀਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "जिम कथे सरब राजान राज ॥",
      "sourceLineId": "101961",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਿਮ ਕਹੇ ਰਿਖਿਨ ਸਬ ਹੀ ਸਮਾਜ ॥",
      "transliteration": "tim kahe rikhin sab hee samaaj ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤਰ੍ਰਹਾ (ਹੁਣ) ਸਾਰੇ ਰਿਸ਼ੀਆਂ ਦੇ ਸਮਾਜ (ਦਾ ਬ੍ਰਿੱਤਾਤ) ਕਹਿੰਦਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "तिम कहे रिखिन सब ही समाज ॥",
      "sourceLineId": "101962",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਿਹ ਜਿਹ ਪ੍ਰਕਾਰ ਤਿਹ ਕਰਮ ਕੀਨ ॥",
      "transliteration": "jeh jeh prakaar teh karam keen ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਜਿਸ ਤਰ੍ਰਹਾ ਦੇ ਉਨ੍ਰਹਾ ਨੇ ਕਰਮ ਕੀਤੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "जिह जिह प्रकार तिह करम कीन ॥",
      "sourceLineId": "101963",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਿਹ ਭਾਤਿ ਜੇਮਿ ਦਿਜ ਬਰਨ ਲੀਨ ॥੭॥",
      "transliteration": "jeh bhaat jem dhij baran leen ||7||",
      "translation": "The way, in which all the kings have been described, in the same way, the actions done by all the sages have been narrated as to how Rudra manifested himself in the castes of dvijas (twice born).7.",
      "punjabiViakhya": "ਅਤੇ ਜਿਵੇਾਂ ਤੇ ਜਿਸ ਤਰ੍ਰਹਾ ਬ੍ਰਾਹਮਣ ਵਰਣ ਪ੍ਰਾਪਤ ਕੀਤਾ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "जिह भाति जेमि दिज बरन लीन ॥७॥",
      "sourceLineId": "101964",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜੇ ਜੇ ਚਰਿਤ੍ਰ ਕਿਨੇ ਪ੍ਰਕਾਸ ॥",
      "transliteration": "je je charitr kine prakaas ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਜੋ ਚਰਿਤ੍ਰ ਪ੍ਰਗਟ ਕੀਤੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "जे जे चरित्र किने प्रकास ॥",
      "sourceLineId": "101965",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਤੇ ਤੇ ਚਰਿਤ੍ਰ ਭਾਖੋ ਸੁ ਬਾਸ ॥",
      "transliteration": "te te charitr bhaakho su baas ||",
      "translation": "Whatever deeds they brought to light, I relate them here",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਉਨ੍ਰਹਾ ਚਰਿਤ੍ਰਾ ਦਾ ਸੁੰਦਰ ਢੰਗ ਨਾਲ ਵਰਣਨ ਕਰਦਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "ते ते चरित्र भाखो सु बास ॥",
      "sourceLineId": "101966",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਰਿਖਿ ਪੁਤ੍ਰ ਏਸ ਭਏ ਰੁਦ੍ਰ ਦੇਵ ॥",
      "transliteration": "rikh putr es bhe rudhr dhev ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਰੁਦ੍ਰ ਦੇਵ ਰਿਸ਼ੀ ਪੁੱਤਰ ਦੇ ਰੂਪ ਵਿਚ ਪ੍ਰਗਟ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "रिखि पुत्र एस भए रुद्र देव ॥",
      "sourceLineId": "101967",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਮੋਨੀ ਮਹਾਨ ਮਾਨੀ ਅਭੇਵ ॥੮॥",
      "transliteration": "monee mahaan maanee abhev ||8||",
      "translation": "In this way, rudra became the sons of the sages, who adopted silence and attained recognition.8.",
      "punjabiViakhya": "ਜੋ ਮਹਾਨ ਮੋਨੀ, ਮਨਨਸ਼ੀਲ ਅਤੇ ਭੇਦ-ਰਹਿਤ ਸਨ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "मोनी महान मानी अभेव ॥८॥",
      "sourceLineId": "101968",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਪੁਨਿ ਭਏ ਅਤ੍ਰਿ ਰਿਖਿ ਮੁਨਿ ਮਹਾਨ ॥",
      "transliteration": "pun bhe atr rikh mun mahaan ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਮਹਾਨ ਮੁਨੀ ਅਤ੍ਰੀ ਰਿਸ਼ੀ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "पुनि भए अतृ रिखि मुनि महान ॥",
      "sourceLineId": "101969",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਦਸ ਚਾਰ ਚਾਰ ਬਿਦਿਆ ਨਿਧਾਨ ॥",
      "transliteration": "dhas chaar chaar bidhiaa nidhaan ||",
      "translation": "Then he incarnated himself as sage Atrl, who the store of eighteen sciences",
      "punjabiViakhya": "ਜੋ ਅਠਾਰ੍ਰਹਾ ਵਿਦਿਆਵਾ ਦੇ ਭੰਡਾਰ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "दस चार चार बिदिआ निधान ॥",
      "sourceLineId": "101970",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਲਿਨੇ ਸੁ ਜੋਗ ਤਜਿ ਰਾਜ ਆਨਿ ॥",
      "transliteration": "line su jog taj raaj aan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਰਾਜ ਛਡ ਕੇ ਯੋਗ ਨੂੰ ਧਾਰਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "लिने सु जोग तजि राज आनि ॥",
      "sourceLineId": "101971",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਸੇਵਿਆ ਰੁਦ੍ਰ ਸੰਪਤਿ ਨਿਧਾਨ ॥੯॥",
      "transliteration": "seviaa rudhr sa(n)pat nidhaan ||9||",
      "translation": "He abandoned everything else and adopted Yoga as his way of life and served Rudra, the store of all wealth.9.",
      "punjabiViakhya": "ਅਤੇ ਸੰਪੱਤੀ ਦੇ ਖ਼ਜ਼ਾਨੇ ਰੁਦ੍ਰ ਦੀ ਸੇਵਾ ਕੀਤੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "सेविआ रुद्र संपति निधान ॥९॥",
      "sourceLineId": "101972",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਕਿਨੋ ਸੁ ਯੋਗ ਬਹੁ ਦਿਨ ਪ੍ਰਮਾਨ ॥",
      "transliteration": "kino su yog bahu dhin pramaan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਬਹੁਤ ਦਿਨਾ ਤਕ ਯੋਗ ਸਾਧਨਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "किनो सु योग बहु दिन प्रमान ॥",
      "sourceLineId": "101973",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਰੀਝਿਓ ਰੁਦ੍ਰ ਤਾ ਪਰ ਨਿਦਾਨ ॥",
      "transliteration": "reejhio rudhr taa par nidhaan ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਤ ਵਿਚ ਰੁਦ੍ਰ ਉਸ ਉਤੇ ਪ੍ਰਸੰਨ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "रीझिओ रुद्र ता पर निदान ॥",
      "sourceLineId": "101974",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਬਰੁ ਮਾਗ ਪੁਤ੍ਰ ਜੋ ਰੁਚੈ ਤੋਹਿ ॥",
      "transliteration": "bar maag putr jo ruchai toh ||",
      "translation": "",
      "punjabiViakhya": "(ਰੁਦ੍ਰ ਨੇ ਕਿਹਾ) ਹੇ ਪੁੱਤਰ! ਜੋ ਤੈਨੂੰ ਚੰਗਾ ਲਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "बरु माग पुत्र जो रुचै तोहि ॥",
      "sourceLineId": "101975",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਬਰੁ ਦਾਨੁ ਤਉਨ ਮੈ ਦੇਉ ਤੋਹਿ ॥੧੦॥",
      "transliteration": "bar dhaan taun mai dheau toh ||10||",
      "translation": "He performed austerities for a long time, on which, Rudra got pleased and said, “You may ask for any boon which you like, I shall grant it to you.”10.",
      "punjabiViakhya": "ਉਹ ਵਰ ਮੰਗ ਲੈ, ਮੈਂ ਤੈਨੂੰ ਉਹੀ ਵਰਦਾਨ ਦਿਆਂਗਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "बरु दानु तउन मै देउ तोहि ॥१०॥",
      "sourceLineId": "101976",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਕਰਿ ਜੋਰਿ ਅਤ੍ਰਿ ਤਬ ਭਯੋ ਠਾਢ ॥",
      "transliteration": "kar jor atr tab bhayo Thaadd ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਅਤ੍ਰੀ ਮੁਨੀ ਹੱਥ ਜੋੜ ਕੇ ਖੜਾ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "करि जोरि अतृ तब भयो ठाढ ॥",
      "sourceLineId": "101977",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਉਠਿ ਭਾਗ ਆਨ ਅਨੁਰਾਗ ਬਾਢ ॥",
      "transliteration": "auTh bhaag aan anuraag baadd ||",
      "translation": "Then the sage Atri stood up with folded hands and his love for Rudra was further increased in his mind",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਭਾਗ ਜਾਗ ਪਏ ਅਤੇ ਪ੍ਰੇਮ ਵੱਧ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "उठि भाग आन अनुराग बाढ ॥",
      "sourceLineId": "101978",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਗਦ ਗਦ ਸੁ ਬੈਣ ਭਭਕੰਤ ਨੈਣ ॥",
      "transliteration": "gadh gadh su bain bhabhaka(n)t nain ||",
      "translation": "",
      "punjabiViakhya": "ਬੋਲ ਗਦ ਗਦ ਹੋ ਗਏ ਅਤੇ ਨੈਣਾ ਵਿਚੋਂ ਜਲ ਛਲਕਣ ਲਗ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "गद गद सु बैण भभकंत नैण ॥",
      "sourceLineId": "101979",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਰੋਮਾਨ ਹਰਖ ਉਚਰੇ ਸੁ ਬੈਣ ॥੧੧॥",
      "transliteration": "romaan harakh uchare su bain ||11||",
      "translation": "He became very happy the tears flowed form his eyes and his hair showed signs of jubilation, when he said11",
      "punjabiViakhya": "ਰੋਮਾਚਿਤ ਹੋ ਕੇ ਪ੍ਰਸੰਨਤਾ ਪੂਰਵਕ ਉਸ ਨੇ ਬੋਲ ਕਹੇ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "रोमान हरख उचरे सु बैण ॥११॥",
      "sourceLineId": "101980",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਜੋ ਦੇਤ ਰੁਦ੍ਰ ਬਰੁ ਰੀਝ ਮੋਹਿ ॥",
      "transliteration": "jo dhet rudhr bar reejh moh ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰੁਦ੍ਰ! ਜੇ ਰੀਝ ਕੇ ਮੈਨੂੰ ਵਰ ਦਿੰਦੇ ਹੋ,",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "जो देत रुद्र बरु रीझ मोहि ॥",
      "sourceLineId": "101981",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਗ੍ਰਿਹ ਹੋਇ ਪੁਤ੍ਰ ਸਮ ਤੁਲਿ ਤੋਹਿ ॥",
      "transliteration": "gireh hoi putr sam tul toh ||",
      "translation": "“O Rudra! if you want to grant me a boon, then give me a son like you",
      "punjabiViakhya": "ਤਾ ਤੁਹਾਡੇ ਸਮਾਨ ਮੇਰੇ ਘਰ ਪੁੱਤਰ ਜਨਮ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "गृह होइ पुत्र सम तुलि तोहि ॥",
      "sourceLineId": "101982",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਕਹਿ ਕੈ ਤਥਾਸਤੁ ਭਏ ਅੰਤ੍ਰ ਧਿਆਨ ॥",
      "transliteration": "keh kai tathaasat bhe a(n)tr dhiaan ||",
      "translation": "",
      "punjabiViakhya": "('ਰੁਦ੍ਰ') 'ਤਥਾਸਤੂ' (ਇੰਜ ਹੀ ਹੋਵੇ) ਕਹਿ ਕੇ ਅੰਤਰਧਿਆਨ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "कहि कै तथासतु भए अंत्र धिआन ॥",
      "sourceLineId": "101983",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਗ੍ਰਿਹ ਗਯੋ ਅਤ੍ਰਿ ਮੁਨਿ ਮਨਿ ਮਹਾਨ ॥੧੨॥",
      "transliteration": "gireh gayo atr mun man mahaan ||12||",
      "translation": "” Rudra saying “let it be”, disappeared and the sage came back to his home.12.",
      "punjabiViakhya": "ਮਹਾਨ ਮਨ ਵਾਲਾ ਅਤ੍ਰੀ ਮੁਨੀ ਵੀ ਘਰ ਨੂੰ ਪਰਤ ਗਿਆ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "गृह गयो अतृ मुनि मनि महान ॥१२॥",
      "sourceLineId": "101984",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਗ੍ਰਿਹਿ ਬਰੀ ਆਨਿ ਅਨਸੂਆ ਨਾਰਿ ॥",
      "transliteration": "gireh baree aan anasooaa naar ||",
      "translation": "",
      "punjabiViakhya": "ਘਰ ਆ ਕੇ (ਉਸ ਨੇ) ਅਨਸੂਆ (ਨਾ ਦੀ) ਇਸਤਰੀ ਨਾਲ ਵਿਆਹ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "गृहि बरी आनि अनसूआ नारि ॥",
      "sourceLineId": "101985",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0635_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਜਨੁ ਪਠਿਓ ਤਤੁ ਨਿਜ ਸਿਵ ਨਿਕਾਰਿ ॥",
      "transliteration": "jan paThio tat nij siv nikaar ||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ) ਮਾਨੋ ਸ਼ਿਵ ਨੇ ਆਪਣਾ ਮੂਲ ਤਤ੍ਵ ਕਢ ਕੇ (ਅਨਸੂਆ ਦੇ ਰੂਪ ਵਿਚ) ਭੇਜਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 635,
      "hindi": "",
      "hindiTransliteration": "जनु पठिओ ततु निज सिव निकारि ॥",
      "sourceLineId": "101986",
      "sourceShabadId": "9325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
