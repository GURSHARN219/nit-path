{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 637,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0637_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤੋਮਰ ਛੰਦ ॥",
      "transliteration": "tomar chha(n)dh ||",
      "translation": "TOMAR STANZA",
      "punjabiViakhya": "ਤੋਮਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "तोमर छंद ॥",
      "sourceLineId": "102035",
      "sourceShabadId": "9327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕੀਅ ਐਸ ਬ੍ਰਹਮਾ ਉਚਾਰ ॥",
      "transliteration": "keea aais brahamaa uchaar ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਹਮਾ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਉਚਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "कीअ ऐस ब्रहमा उचार ॥",
      "sourceLineId": "102036",
      "sourceShabadId": "9327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤੈ ਪੁਤ੍ਰ ਪਾਵਸ ਬਾਰ ॥",
      "transliteration": "tai putr paavas baar ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਹੇ ਇਸਤਰੀ! ਤੂੰ ਪੁੱਤਰ ਪ੍ਰਾਪਤ ਕਰੇਾਂ।",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "तै पुत्र पावस बार ॥",
      "sourceLineId": "102037",
      "sourceShabadId": "9327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਬਿ ਨਾਰਿ ਏ ਸੁਨ ਬੈਨ ॥",
      "transliteration": "tab naar e sun bain ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਹ ਬੋਲ ਸੁਣ ਕੇ (ਉਸ) ਇਸਤਰੀ ਦੀਆਂ ਅੱਖਾ ਵਿਚੋਂ",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "तबि नारि ए सुन बैन ॥",
      "sourceLineId": "102038",
      "sourceShabadId": "9327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਹੁ ਆਸੁ ਡਾਰਤ ਨੈਨ ॥੨੫॥",
      "transliteration": "bahu aas ddaarat nain ||25||",
      "translation": "When Brahma said this that the save would be blessed with a son, then listening to it, her eyes showed signs of anxiety.25.",
      "punjabiViakhya": "ਬਹੁਤ ਹੰਝੂ ਵਗਣ ਲਗੇ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "बहु आसु डारत नैन ॥२५॥",
      "sourceLineId": "102039",
      "sourceShabadId": "9327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਬ ਬਾਲ ਬਿਕਲ ਸਰੀਰ ॥",
      "transliteration": "tab baal bikal sareer ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਸਤਰੀ (ਅਨਸੂਆ) ਦਾ ਸ਼ਰੀਰ ਵਿਆਕੁਲ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "तब बाल बिकल सरीर ॥",
      "sourceLineId": "102040",
      "sourceShabadId": "9327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਲ ਸ੍ਰਵਤ ਨੈਨ ਅਧੀਰ ॥",
      "transliteration": "jal sravat nain adheer ||",
      "translation": "The body of that young lady became agitated and the tears flowed form her eyes",
      "punjabiViakhya": "(ਉਸ ਦੀਆਂ) ਅੱਖਾ ਵਿਚ ਜਲ ਵਗ ਰਿਹਾ ਸੀ ਅਤੇ (ਉਹ) ਅਧੀਰ ਹੋ ਗਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "जल स्रवत नैन अधीर ॥",
      "sourceLineId": "102041",
      "sourceShabadId": "9327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰੋਮਾਚਿ ਗਦ ਗਦ ਬੈਨ ॥",
      "transliteration": "romaach gadh gadh bain ||",
      "translation": "",
      "punjabiViakhya": "ਰੋਮਾਚਿਤ ਹੋਣ ਕਰ ਕੇ (ਉਸ ਦੇ) ਬੋਲ ਗਦ ਗਦ ਹੋ ਗਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "रोमाचि गद गद बैन ॥",
      "sourceLineId": "102042",
      "sourceShabadId": "9327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦਿਨ ਤੇ ਭਈ ਜਨੁ ਰੈਨ ॥੨੬॥",
      "transliteration": "dhin te bhiee jan rain ||26||",
      "translation": "She was filled with anxiety on hearing these words and she felt that the day had changed into night.26.",
      "punjabiViakhya": "(ਉਸ ਲਈ) ਦਿਨ ਨੂੰ ਹੀ ਰਾਤ ਹੋ ਗਈ ਸੀ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "दिन ते भई जनु रैन ॥२६॥",
      "sourceLineId": "102043",
      "sourceShabadId": "9327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰੋਮਾਚਿ ਬਿਕਲ ਸਰੀਰ ॥",
      "transliteration": "romaach bikal sareer ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਸ਼ਰੀਰ ਰੋਮਾਚਿਤ ਅਤੇ ਵਿਆਕੁਲ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "रोमाचि बिकल सरीर ॥",
      "sourceLineId": "102044",
      "sourceShabadId": "9327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਨ ਕੋਪ ਮਾਨ ਅਧੀਰ ॥",
      "transliteration": "tan kop maan adheer ||",
      "translation": "",
      "punjabiViakhya": "ਅਧੀਰ ਹੋ ਕੇ ਸ਼ਰੀਰ ਕ੍ਰੋਧਵਾਨ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "तन कोप मान अधीर ॥",
      "sourceLineId": "102045",
      "sourceShabadId": "9327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਫਰਕੰਤ ਉਸਟਰੁ ਨੈਨ ॥",
      "transliteration": "faraka(n)t usaTar nain ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀਆਂ ਅੱਖਾ ਅਤੇ ਹੋਂਠ ਫਰਕਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "फरकंत उसटरु नैन ॥",
      "sourceLineId": "102046",
      "sourceShabadId": "9327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਿਨੁ ਬੁਧ ਬੋਲਤ ਬੈਨ ॥੨੭॥",
      "transliteration": "bin budh bolat bain ||27||",
      "translation": "Her body was agitated with anxiety and she getting enraged, became impatient, lips and eyes quivered and she lamented.27.",
      "punjabiViakhya": "ਅਤੇ ਬੁੱਧੀ ਤੋਂ ਬਿਨਾ ਬਚਨ ਬੋਲਦੀ ਸੀ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "बिनु बुध बोलत बैन ॥२७॥",
      "sourceLineId": "102047",
      "sourceShabadId": "9327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੋਹਣ ਛੰਦ ॥",
      "transliteration": "mohan chha(n)dh ||",
      "translation": "MOHAN STANZA",
      "punjabiViakhya": "ਮੋਹਣ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "मोहण छंद ॥",
      "sourceLineId": "102048",
      "sourceShabadId": "9328",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੁਨਿ ਐਸ ਬੈਨ ॥",
      "transliteration": "sun aais bain ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦੇ ਬੋਲ ਸੁਣ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "सुनि ऐस बैन ॥",
      "sourceLineId": "102049",
      "sourceShabadId": "9328",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮ੍ਰਿਗੀਏਸ ਨੈਨ ॥",
      "transliteration": "mirage'ees nain ||",
      "translation": "",
      "punjabiViakhya": "ਹਿਰਨਾ ਵਰਗੀਆਂ ਅੱਖਾ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "मृगीएस नैन ॥",
      "sourceLineId": "102050",
      "sourceShabadId": "9328",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਤਿ ਰੂਪ ਧਾਮ ॥",
      "transliteration": "at roop dhaam ||",
      "translation": "",
      "punjabiViakhya": "ਅਤਿ ਅਧਿਕ ਰੂਪ ਦੀ ਘਰ",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "अति रूप धाम ॥",
      "sourceLineId": "102051",
      "sourceShabadId": "9328",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੁੰਦਰ ਸੁ ਬਾਮ ॥੨੮॥",
      "transliteration": "su(n)dhar su baam ||28||",
      "translation": "Hearing these words that doe-eyed and extremely beautiful lady (felt agitated).28.",
      "punjabiViakhya": "ਅਤੇ ਸੁੰਦਰ ਇਸਤਰੀ ਦਾ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "सुँदर सु बाम ॥२८॥",
      "sourceLineId": "102052",
      "sourceShabadId": "9328",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚਲ ਚਾਲ ਚਿਤ ॥",
      "transliteration": "chal chaal chit ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਮ ਪਵਿਤ੍ਰ ਹਿਰਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "चल चाल चित ॥",
      "sourceLineId": "102053",
      "sourceShabadId": "9328",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪਰਮੰ ਪਵਿਤ ॥",
      "transliteration": "parama(n) pavit ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਚਲਿਤ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "परमं पवित ॥",
      "sourceLineId": "102054",
      "sourceShabadId": "9328",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਤਿ ਕੋਪ ਵੰਤ ॥",
      "transliteration": "at kop va(n)t ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤ੍ਰੀ) ਮੁਨੀ ਦੀ ਇਸਤਰੀ ਬੇਅੰਤ ਗੁੱਸਾ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "अति कोप वंत ॥",
      "sourceLineId": "102055",
      "sourceShabadId": "9328",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮੁਨਿ ਤ੍ਰਿਅ ਬਿਅੰਤ ॥੨੯॥",
      "transliteration": "mun tria bia(n)t ||29||",
      "translation": "Her mind, which was immaculate, was filled with extreme rage alongwith other women of the sages.29.",
      "punjabiViakhya": "ਕ੍ਰੋਧਵਾਨ (ਹੋ ਗਈ) ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "मुनि तृअ बिअंत ॥२९॥",
      "sourceLineId": "102056",
      "sourceShabadId": "9328",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਉਪਟੰਤ ਕੇਸ ॥",
      "transliteration": "aupaTa(n)t kes ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਵਾਲ ਪੁਟਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "उपटंत केस ॥",
      "sourceLineId": "102057",
      "sourceShabadId": "9328",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮੁਨਿ ਤ੍ਰਿਅ ਸੁਦੇਸ ॥",
      "transliteration": "mun tria sudhes ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਸ਼ਰੀਰ ('ਸੁਦੇਸ') ਵਾਲੀ",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "मुनि तृअ सुदेस ॥",
      "sourceLineId": "102058",
      "sourceShabadId": "9328",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਤਿ ਕੋਪ ਅੰਗਿ ॥",
      "transliteration": "at kop a(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਨੀ ਦੀ ਇਸਤਰੀ ਬਹੁਤ ਕ੍ਰੋਧਵਾਨ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "अति कोप अंगि ॥",
      "sourceLineId": "102059",
      "sourceShabadId": "9328",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੁੰਦਰ ਸੁਰੰਗ ॥੩੦॥",
      "transliteration": "su(n)dhar sura(n)g ||30||",
      "translation": "The wife of the sage plucked her hair at that place and her comely limbs were filled with extreme ire.30.",
      "punjabiViakhya": "ਬਹੁਤ ਸੁੰਦਰ ਰੂਪ ਵਾਲੀ ਹੈ ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "सुँदर सुरंग ॥३०॥",
      "sourceLineId": "102060",
      "sourceShabadId": "9328",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੋਰੰਤ ਹਾਰ ॥",
      "transliteration": "tora(n)t haar ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਰ ਤੋੜ ਰਹੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "तोरंत हार ॥",
      "sourceLineId": "102061",
      "sourceShabadId": "9328",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਉਪਟੰਤ ਬਾਰ ॥",
      "transliteration": "aupaTa(n)t baar ||",
      "translation": "",
      "punjabiViakhya": "(ਸਿਰ ਦੇ) ਵਾਲਾ ਨੂੰ ਪੁਟਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "उपटंत बार ॥",
      "sourceLineId": "102062",
      "sourceShabadId": "9328",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਡਾਰੰਤ ਧੂਰਿ ॥",
      "transliteration": "ddaara(n)t dhoor ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਨ੍ਰਹਾ ਵਿਚ) ਮਿੱਟੀ ਪਾਉਾਂਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "डारंत धूरि ॥",
      "sourceLineId": "102063",
      "sourceShabadId": "9328",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰੋਖੰਤ ਪੂਰ ॥੩੧॥",
      "transliteration": "rokha(n)t poor ||31||",
      "translation": "Breaking her necklaces, she plucked her hair and began to put dust hr head.31.",
      "punjabiViakhya": "ਅਤੇ ਕ੍ਰੋਧ ਨਾਲ ਭਰੀ ਹੋਈ ਹੈ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "रोखंत पूर ॥३१॥",
      "sourceLineId": "102064",
      "sourceShabadId": "9328",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤੋਮਰ ਛੰਦ ॥",
      "transliteration": "tomar chha(n)dh ||",
      "translation": "TOMAR STANZA",
      "punjabiViakhya": "ਤੋਮਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "तोमर छंद ॥",
      "sourceLineId": "102065",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਲਖਿ ਕੋਪ ਭੀ ਮੁਨਿ ਨਾਰਿ ॥",
      "transliteration": "lakh kop bhee mun naar ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧਵਾਨ ਹੋਈ ਮੁਨੀ ਦੀ ਇਸਤਰੀ ਨੂੰ ਵੇਖ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "लखि कोप भी मुनि नारि ॥",
      "sourceLineId": "102066",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਉਠਿ ਭਾਜ ਬ੍ਰਹਮ ਉਦਾਰ ॥",
      "transliteration": "auTh bhaaj braham udhaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਦਾਰ ਬ੍ਰਹਮਾ ਉਠ ਕੇ ਭਜ ਚਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "उठि भाज ब्रहम उदार ॥",
      "sourceLineId": "102067",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਿਵ ਸੰਗਿ ਲੈ ਰਿਖ ਸਰਬ ॥",
      "transliteration": "siv sa(n)g lai rikh sarab ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਸਾਰੇ ਰਿਸ਼ੀਆਂ ਨੂੰ ਨਾਲ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "सिव संगि लै रिख सरब ॥",
      "sourceLineId": "102068",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭਯਮਾਨ ਹ੍ਵੈ ਤਜਿ ਗਰਬ ॥੩੨॥",
      "transliteration": "bhayamaan havai taj garab ||32||",
      "translation": "Seeing the wife of the sage in anger, getting fearful and forsaking his pride, and taking Shiva and other sages with him, Brahma fled.32.",
      "punjabiViakhya": "ਅਤੇ ਹੰਕਾਰ ਨੂੰ ਛਡ ਕੇ ਭੈਮਾਨ ਹੋ ਗਿਆ ॥੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "भयमान ह्वै तजि गरब ॥३२॥",
      "sourceLineId": "102069",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਬ ਕੋਪ ਕੈ ਮੁਨਿ ਨਾਰਿ ॥",
      "transliteration": "tab kop kai mun naar ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕ੍ਰੋਧ ਕਰ ਕੇ ਮੁਨੀ ਦੀ ਇਸਤਰੀ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "तब कोप कै मुनि नारि ॥",
      "sourceLineId": "102070",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਿਰ ਕੇਸ ਜਟਾ ਉਪਾਰਿ ॥",
      "transliteration": "sir kes jaTaa upaar ||",
      "translation": "",
      "punjabiViakhya": "ਸਿਰ ਤੋਂ ਵਾਲਾ ਦੀ ਜਟਾ ਪੁਟ ਸੁਟੀ।",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "सिर केस जटा उपारि ॥",
      "sourceLineId": "102071",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਰਿ ਸੌ ਜਬੈ ਕਰ ਮਾਰ ॥",
      "transliteration": "kar sau jabai kar maar ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਉਸ ਨੇ) ਹੱਥ ਉਤੇ ਹੱਥ ਮਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "करि सौ जबै कर मार ॥",
      "sourceLineId": "102072",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਬ ਲੀਨ ਦਤ ਅਵਤਾਰ ॥੩੩॥",
      "transliteration": "tab leen dhat avataar ||33||",
      "translation": "Then the wife of the sage, uprooting one of the matted lock of ther head in anger, strumck it on her hand, at that time Dattatreya was born.33.",
      "punjabiViakhya": "ਤਦ ਦੱਤ ਨੇ ਅਵਤਾਰ ਲਿਆ (ਭਾਵ-ਜਨਮ ਲਿਆ) ॥੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "तब लीन दत अवतार ॥३३॥",
      "sourceLineId": "102073",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਰ ਬਾਮ ਮਾਤ੍ਰ ਸਮਾਨ ॥",
      "transliteration": "kar baam maatr samaan ||",
      "translation": "",
      "punjabiViakhya": "ਖੱਬਾ ਹੱਥ ਮਾਤਾ ਦੇ ਸਮਾਨ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "कर बाम मात्र समान ॥",
      "sourceLineId": "102074",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਰੁ ਦਛਨਤ੍ਰਿ ਪ੍ਰਮਾਨ ॥",
      "transliteration": "kar dhachhanatr pramaan ||",
      "translation": "Considering Ansuya as his mother and keeping her on his right, he circumambulated around her and then saluted her",
      "punjabiViakhya": "ਅਤੇ ਸੱਜਾ ਹੱਥ ਪਿਤਾ (ਅਤ੍ਰੀ) ਰੂਪ ਵਿਚ ਮੰਨਣਾ ਚਾਹੀਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "करु दछनतृ प्रमान ॥",
      "sourceLineId": "102075",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕੀਆ ਪਾਨ ਭੋਗ ਬਿਚਾਰ ॥",
      "transliteration": "keeaa paan bhog bichaar ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ ਇਸਤਰੀ ਨੇ) ਹੱਥਾ ਦਾ ਭੋਗ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "कीआ पान भोग बिचार ॥",
      "sourceLineId": "102076",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਬ ਭਏ ਦਤ ਕੁਮਾਰ ॥੩੪॥",
      "transliteration": "tab bhe dhat kumaar ||34||",
      "translation": "In this way, thinking about the experience of sexual pleasure, Dutt Kumar was born.34.",
      "punjabiViakhya": "(ਅਰਥਾਤ-ਹੱਥ ਨਾਲ ਹੱਥ ਰਗੜਿਆ) ਤਾ ਦੱਤ ਪੁੱਤਰ ਪੈਦਾ ਹੋਇਆ ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "तब भए दत कुमार ॥३४॥",
      "sourceLineId": "102077",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਨਭੂਤ ਉਤਮ ਗਾਤ ॥",
      "transliteration": "anabhoot utam gaat ||",
      "translation": "",
      "punjabiViakhya": "ਅਦਭੁਤ ਅਤੇ ਉਤਮ ਸ਼ਰੀਰ ਵਾਲਾ (ਦੱਤ)",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "अनभूत उतम गात ॥",
      "sourceLineId": "102078",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਉਚਰੰਤ ਸਿੰਮ੍ਰਿਤ ਸਾਤ ॥",
      "transliteration": "auchara(n)t si(n)mirat saat ||",
      "translation": "His body was charming and he was reciting seven Smrities",
      "punjabiViakhya": "ਸੱਤਾ ਸਮ੍ਰਿਤੀਆਂ ਦਾ ਉਚਾਰਨ ਕਰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "उचरंत सिंमृत सात ॥",
      "sourceLineId": "102079",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮੁਖਿ ਬੇਦ ਚਾਰ ਰੜੰਤ ॥",
      "transliteration": "mukh bedh chaar raRa(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਮੂੰਹ ਨਾਲ ਚਾਰੇ ਵੇਦ ਰਟਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "मुखि बेद चार रड़ंत ॥",
      "sourceLineId": "102080",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਉਪਜੋ ਸੁ ਦਤ ਮਹੰਤ ॥੩੫॥",
      "transliteration": "aupajo su dhat maha(n)t ||35||",
      "translation": "The great Dutt was reciting all the four Vedas.35.",
      "punjabiViakhya": "(ਇਸ ਪ੍ਰਕਾਰ) ਮਹਾਨ ਦੱਤ ਪੈਦਾ ਹੋਇਆ ਹੈ ॥੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "उपजो सु दत महंत ॥३५॥",
      "sourceLineId": "102081",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0637_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਿਵ ਸਿਮਰਿ ਪੂਰਬਲ ਸ੍ਰਾਪ ॥",
      "transliteration": "siv simar poorabal sraap ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਨੇ ਪੂਰਬਲਾ ਸਰਾਪ ਯਾਦ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 637,
      "hindi": "",
      "hindiTransliteration": "सिव सिमरि पूरबल स्राप ॥",
      "sourceLineId": "102082",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
