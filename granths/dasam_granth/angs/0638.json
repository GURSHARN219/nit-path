{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 638,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0638_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਪੁ ਦਤ ਕੋ ਧਰਿ ਆਪ ॥",
      "transliteration": "bap dhat ko dhar aap ||",
      "translation": "Shiva, remembering the earlier curse assumed himself the body of Dutt and",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਨੇ) ਆਪ ਆ ਕੇ ਦੱਤ ਦਾ ਸ਼ਰੀਰ ਧਾਰਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "बपु दत को धरि आप ॥",
      "sourceLineId": "102083",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਉਪਜਿਓ ਨਿਸੂਆ ਧਾਮਿ ॥",
      "transliteration": "aupajio nisooaa dhaam ||",
      "translation": "",
      "punjabiViakhya": "ਅਨਸੂਆ ਦੇ ਘਰ ਪੈਦਾ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "उपजिओ निसूआ धामि ॥",
      "sourceLineId": "102084",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਵਤਾਰ ਪ੍ਰਿਥਮ ਸੁ ਤਾਮ ॥੩੬॥",
      "transliteration": "avataar piratham su taam ||36||",
      "translation": "Took birth in the home of Ansuya this was his first incarnation.36.",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਇਹ ਪਹਿਲਾ ਅਵਤਾਰ ਹੋਇਆ ॥੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "अवतार पृथम सु ताम ॥३६॥",
      "sourceLineId": "102085",
      "sourceShabadId": "9329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਾਧਰੀ ਛੰਦ ॥",
      "transliteration": "paadharee chha(n)dh ||",
      "translation": "PAADHARI STANZA",
      "punjabiViakhya": "ਪਾਧਰੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "पाधरी छंद ॥",
      "sourceLineId": "102086",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਉਪਜਿਓ ਸੁ ਦਤ ਮੋਨੀ ਮਹਾਨ ॥",
      "transliteration": "aupajio su dhat monee mahaan ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਮੋਨੀ ਸਰੂਪ ਵਾਲਾ ਦੱਤ ਪੈਦਾ ਹੋਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "उपजिओ सु दत मोनी महान ॥",
      "sourceLineId": "102087",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਦਸ ਚਾਰ ਚਾਰ ਬਿਦਿਆ ਨਿਧਾਨ ॥",
      "transliteration": "dhas chaar chaar bidhiaa nidhaan ||",
      "translation": "The loving Dutt, the store of eighteen sciences was born",
      "punjabiViakhya": "ਜੋ ਅਠਾਰ੍ਰਹਾ ਵਿਦਿਆਵਾ ਦਾ ਖ਼ਜ਼ਾਨਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "दस चार चार बिदिआ निधान ॥",
      "sourceLineId": "102088",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਾਸਤ੍ਰਗਿ ਸੁਧ ਸੁੰਦਰ ਸਰੂਪ ॥",
      "transliteration": "saasatrag sudh su(n)dhar saroop ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸ਼ਾਸਤ੍ਰਾ ਦਾ ਗਿਆਤਾ ਅਤੇ ਸ਼ੁੱਧ ਸੁੰਦਰ ਸਰੂਪ ਵਾਲਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "सासत्रगि सुध सुँदर सरूप ॥",
      "sourceLineId": "102089",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਵਧੂਤ ਰੂਪ ਗਣ ਸਰਬ ਭੂਪ ॥੩੭॥",
      "transliteration": "avadhoot roop gan sarab bhoop ||37||",
      "translation": "He was the knower of Shastras and had a charming figure he was Yogi king of all the ganas.37.",
      "punjabiViakhya": "ਅਤੇ ਅਵਧੂਤ ਰੂਪ ਵਾਲਾ ਅਤੇ ਸਾਰਿਆਂ ਗਣਾ ਦਾ ਰਾਜਾ ਸੀ ॥੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "अवधूत रूप गण सरब भूप ॥३७॥",
      "sourceLineId": "102090",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੰਨਿਆਸ ਜੋਗ ਕਿਨੋ ਪ੍ਰਕਾਸ ॥",
      "transliteration": "sa(n)niaas jog kino prakaas ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸੰਨਿਆਸ ਅਤੇ ਯੋਗ ਦਾ ਪ੍ਰਕਾਸ਼ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "संनिआस जोग किनो प्रकास ॥",
      "sourceLineId": "102091",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪਾਵਨ ਪਵਿਤ ਸਰਬਤ੍ਰ ਦਾਸ ॥",
      "transliteration": "paavan pavit sarabatr dhaas ||",
      "translation": "He spread the cults of Sannyas and Yoga and he was totally spotless and servitor of all",
      "punjabiViakhya": "(ਉਹ) ਪਾਵਨ, ਪਵਿਤ੍ਰ ਅਤੇ ਸਭ ਦਾ ਦਾਸ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "पावन पवित सरबत्र दास ॥",
      "sourceLineId": "102092",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਨ ਧਰਿਓ ਆਨਿ ਬਪੁ ਸਰਬ ਜੋਗ ॥",
      "transliteration": "jan dhario aan bap sarab jog ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸਾਰਿਆਂ ਯੋਗਾ ਨੇ ਆ ਕੇ ਸ਼ਰੀਰ ਧਾਰਨ ਕੀਤਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "जन धरिओ आनि बपु सरब जोग ॥",
      "sourceLineId": "102093",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਜਿ ਰਾਜ ਸਾਜ ਅਰੁ ਤਿਆਗ ਭੋਗ ॥੩੮॥",
      "transliteration": "taj raaj saaj ar tiaag bhog ||38||",
      "translation": "He was the apparent manifestation of Yoga, who abandoned the path of royal pleasure.38.",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਰਾਜ ਸਾਜ ਅਤੇ ਭੋਗ ਤਿਆਗ ਦਿੱਤੇ ਸਨ ॥੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "तजि राज साज अरु तिआग भोग ॥३८॥",
      "sourceLineId": "102094",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਛਿਜ ਰੂਪ ਮਹਿਮਾ ਮਹਾਨ ॥",
      "transliteration": "aachhij roop mahimaa mahaan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਨਾ ਨਸ਼ਟ ਹੋਣ ਵਾਲੇ ਰੂਪ ਵਾਲਾ, ਮਹਾਨ ਮਹਿਮਾ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "आछिज रूप महिमा महान ॥",
      "sourceLineId": "102095",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦਸ ਚਾਰਵੰਤ ਸੋਭਾ ਨਿਧਾਨ ॥",
      "transliteration": "dhas chaarava(n)t sobhaa nidhaan ||",
      "translation": "He was greatly praiseworthy, had a charming personality and also the store-house of Grace",
      "punjabiViakhya": "ਚੌਦਾ (ਵਿਦਿਆਵਾ) ਵਾਲਾ ਅਤੇ ਸ਼ੋਭਾ ਦਾ ਖ਼ਜ਼ਾਨਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "दस चारवंत सोभा निधान ॥",
      "sourceLineId": "102096",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਵਿ ਅਨਿਲ ਤੇਜ ਜਲ ਸੋ ਸੁਭਾਵ ॥",
      "transliteration": "rav anil tej jal so subhaav ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਜ, ਵਾਯੂ, ਅਗਨੀ ਅਤੇ ਜਲ ਦੇ ਸੁਭਾ ਵਾਲਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "रवि अनिल तेज जल सो सुभाव ॥",
      "sourceLineId": "102097",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਉਪਜਿਆ ਜਗਤ ਸੰਨ੍ਯਾਸ ਰਾਵ ॥੩੯॥",
      "transliteration": "aupajiaa jagat sa(n)nayaas raav ||39||",
      "translation": "His disposition was radiant like sun and fire and had cool temperament like water he manifested himself as the king of Yogis in the world.39.",
      "punjabiViakhya": "(ਉਹ) 'ਸੰਨਿਆਸ-ਰਾਜ' ਵਜੋਂ ਜਗਤ ਵਿਚ ਪੈਦਾ ਹੋਇਆ ॥੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "उपजिआ जगत संन्यास राव ॥३९॥",
      "sourceLineId": "102098",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੰਨ੍ਯਾਸ ਰਾਜ ਭਏ ਦਤ ਦੇਵ ॥",
      "transliteration": "sa(n)nayaas raaj bhe dhat dhev ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਤ ਸੰਨਿਆਸ-ਰਾਜ ਦੇ ਰੂਪ ਵਿਚ ਪੈਦਾ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "संन्यास राज भए दत देव ॥",
      "sourceLineId": "102099",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰੁਦ੍ਰਾਵਤਾਰ ਸੁੰਦਰ ਅਜੇਵ ॥",
      "transliteration": "rudhraavataar su(n)dhar ajev ||",
      "translation": "Dutt Dev was superior to all in Sannyas Ashrama (monastic order) and was becoming incarnation of Rudra",
      "punjabiViakhya": "(ਜੋ) ਨਾ ਜਿਤੇ ਜਾ ਸਕਣ ਵਾਲੇ ਰੁਦ੍ਰ ਦਾ ਅਵਤਾਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "रुद्रावतार सुँदर अजेव ॥",
      "sourceLineId": "102100",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪਾਵਕ ਸਮਾਨ ਭਯੇ ਤੇਜ ਜਾਸੁ ॥",
      "transliteration": "paavak samaan bhaye tej jaas ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਤੇਜ ਅਗਨੀ ਵਰਗਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "पावक समान भये तेज जासु ॥",
      "sourceLineId": "102101",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਸੁਧਾ ਸਮਾਨ ਧੀਰਜ ਸੁ ਤਾਸੁ ॥੪੦॥",
      "transliteration": "basudhaa samaan dheeraj su taas ||40||",
      "translation": "His radiance was like fire and power of Rudra his radiance was like fire and power endurance like earth.40.",
      "punjabiViakhya": "ਉਸ ਦਾ ਧੀਰਜ ਧਰਤੀ ਵਰਗਾ ਸੀ ॥੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "बसुधा समान धीरज सु तासु ॥४०॥",
      "sourceLineId": "102102",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪਰਮੰ ਪਵਿਤ੍ਰ ਭਏ ਦੇਵ ਦਤ ॥",
      "transliteration": "parama(n) pavitr bhe dhev dhat ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਤ ਦੇਵ ਪਰਮ ਪਵਿਤ੍ਰ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "परमं पवित्र भए देव दत ॥",
      "sourceLineId": "102103",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਆਛਿਜ ਤੇਜ ਅਰੁ ਬਿਮਲ ਮਤਿ ॥",
      "transliteration": "aachhij tej ar bimal mat ||",
      "translation": "Dutt was a person of purity, indestructible splendour and pure intellect",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਤੇਜ ਅਣਛਿਜ ਸੀ ਅਤੇ ਬੁੱਧੀ ਨਿਰਮਲ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "आछिज तेज अरु बिमल मति ॥",
      "sourceLineId": "102104",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੋਵਰਣ ਦੇਖਿ ਲਾਜੰਤ ਅੰਗ ॥",
      "transliteration": "sovaran dhekh laaja(n)t a(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਦਾ) ਸ਼ਰੀਰ ਵੇਖ ਕੇ ਸੋਨਾ ਲਜਿਤ ਹੁੰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "सोवरण देखि लाजंत अंग ॥",
      "sourceLineId": "102105",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੋਭੰਤ ਸੀਸ ਗੰਗਾ ਤਰੰਗ ॥੪੧॥",
      "transliteration": "sobha(n)t sees ga(n)gaa tara(n)g ||41||",
      "translation": "Even the gold feel shy before him and the waves of the Ganges seemed to surge over his head.41.",
      "punjabiViakhya": "ਅਤੇ ਸਿਰ ਉਤੇ ਗੰਗਾ ਦੀਆਂ ਲਹਿਰਾ ਵਾਗ (ਜਟਾਵਾ) ਸ਼ੋਭਦੀਆਂ ਸਨ ॥੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "सोभंत सीस गंगा तरंग ॥४१॥",
      "sourceLineId": "102106",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਜਾਨ ਬਾਹੁ ਅਲਿਪਤ ਰੂਪ ॥",
      "transliteration": "aajaan baahu alipat roop ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀਆਂ) ਗੋਡਿਆਂ ਤਕ ਬਾਹਵਾ ਸਨ ਅਤੇ ਨਿਰਲਿਪਤ ਰੂਪ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "आजान बाहु अलिपत रूप ॥",
      "sourceLineId": "102107",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਆਦਗ ਜੋਗ ਸੁੰਦਰ ਸਰੂਪ ॥",
      "transliteration": "aadhag jog su(n)dhar saroop ||",
      "translation": "He had long arms and charming body and was a detached supreme Yogi",
      "punjabiViakhya": "ਪ੍ਰਚੰਡ ਯੋਗ ਵਾਲਾ ਅਤੇ ਸੁੰਦਰ ਸਰੂਪ ਵਾਲਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "आदग जोग सुँदर सरूप ॥",
      "sourceLineId": "102108",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਿਭੂਤ ਅੰਗ ਉਜਲ ਸੁ ਬਾਸ ॥",
      "transliteration": "bibhoot a(n)g ujal su baas ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਗਾ ਉਪਰ ਲਗੀ ਵਿਭੂਤੀ ਤੋਂ ਉਜਲੀ ਵਾਸਨਾ ਆਉਾਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "बिभूत अंग उजल सु बास ॥",
      "sourceLineId": "102109",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੰਨਿਆਸ ਜੋਗ ਕਿਨੋ ਪ੍ਰਕਾਸ ॥੪੨॥",
      "transliteration": "sa(n)niaas jog kino prakaas ||42||",
      "translation": "When he applied the ashes to his limbs, he fragranced everyone around him and he brought to light Sannyas and Yoga in the world.42.",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸੰਨਿਆਸ ਯੋਗ ਦਾ ਪ੍ਰਕਾਸ਼ ਕੀਤਾ ਸੀ ॥੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "संनिआस जोग किनो प्रकास ॥४२॥",
      "sourceLineId": "102110",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਵਿਲੋਕਿ ਅੰਗ ਮਹਿਮਾ ਅਪਾਰ ॥",
      "transliteration": "avilok a(n)g mahimaa apaar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਅੰਗਾ ਦੀ ਮਹਿਮਾ ਅਪਰ ਅਪਾਰ ਦਿਸਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "अविलोकि अंग महिमा अपार ॥",
      "sourceLineId": "102111",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੰਨਿਆਸ ਰਾਜ ਉਪਜਾ ਉਦਾਰ ॥",
      "transliteration": "sa(n)niaas raaj upajaa udhaar ||",
      "translation": "The praise of his limbs seemed boundless and he manifested himself as a generous king of the Yogis",
      "punjabiViakhya": "(ਇਸ ਪ੍ਰਕਾਰ) ਸੰਨਿਆਸ ਰਾਜ ਪੈਦਾ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "संनिआस राज उपजा उदार ॥",
      "sourceLineId": "102112",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਨਭੂਤ ਗਾਤ ਆਭਾ ਅਨੰਤ ॥",
      "transliteration": "anabhoot gaat aabhaa ana(n)t ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਸ਼ਰੀਰ ਅਦਭੁਤ ਸੀ ਅਤੇ ਅਨੰਤ ਚਮਕ ਦਮਕ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "अनभूत गात आभा अनंत ॥",
      "sourceLineId": "102113",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮੋਨੀ ਮਹਾਨ ਸੋਭਾ ਲਸੰਤ ॥੪੩॥",
      "transliteration": "monee mahaan sobhaa lasa(n)t ||43||",
      "translation": "The brilliance of his body was infinite and from his great personality, he appeared to be a silence-observing ascetic and eminently glorious.43.",
      "punjabiViakhya": "(ਉਹ) ਮਹਾਨ ਮੋਨੀ ਸੀ (ਅਤੇ ਉਸ ਦੀ) ਸ਼ੋਭਾ ਚਮਕਦੀ ਸੀ ॥੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "मोनी महान सोभा लसंत ॥४३॥",
      "sourceLineId": "102114",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਆਭਾ ਅਪਾਰ ਮਹਿਮਾ ਅਨੰਤ ॥",
      "transliteration": "aabhaa apaar mahimaa ana(n)t ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਅਪਾਰ ਕਾਤੀ ਅਤੇ ਬੇਅੰਤ ਮਹਿਮਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "आभा अपार महिमा अनंत ॥",
      "sourceLineId": "102115",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੰਨ੍ਯਾਸ ਰਾਜ ਕਿਨੋ ਬਿਅੰਤ ॥",
      "transliteration": "sa(n)nayaas raaj kino bia(n)t ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸੰਨਿਆਸ ਰਾਜ ਬੇਅੰਤ (ਸ਼ਕਤੀ ਵਾਲਾ) ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "संन्यास राज किनो बिअंत ॥",
      "sourceLineId": "102116",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਾਪਿਆ ਕਪਟੁ ਤਿਹ ਉਦੇ ਹੋਤ ॥",
      "transliteration": "kaapiaa kapaT teh udhe hot ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਜਨਮ ਲੈਂਦਿਆਂ ਹੀ ਕਪਟ ਕੰਬਣ ਲਗ ਗਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "कापिआ कपटु तिह उदे होत ॥",
      "sourceLineId": "102117",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਤਛਿਨ ਅਕਪਟ ਕਿਨੋ ਉਦੋਤ ॥੪੪॥",
      "transliteration": "tatachhin akapaT kino udhot ||44||",
      "translation": "That king of the Yogis spread his infinite greatness and glory and on his manifestation, the fraudulent tendencies trembled and he made them stingless in an instant.44.",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਉਸੇ ਵੇਲੇ 'ਅਕਪਟ' ਨੂੰ ਪ੍ਰਗਟ ਕਰ ਦਿੱਤਾ ॥੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "ततछिन अकपट किनो उदोत ॥४४॥",
      "sourceLineId": "102118",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਹਿਮਾ ਅਛਿਜ ਅਨਭੂਤ ਗਾਤ ॥",
      "transliteration": "mahimaa achhij anabhoot gaat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਮਹਿਮਾ ਨਾ ਛਿਜਣ ਵਾਲੀ ਸੀ ਅਤੇ ਸ਼ਰੀਰ ਅਦਭੁਤ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "महिमा अछिज अनभूत गात ॥",
      "sourceLineId": "102119",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਵਿਲੋਕਿ ਪੁਤ੍ਰ ਚਕਿ ਰਹੀ ਮਾਤ ॥",
      "transliteration": "aavilok putr chak rahee maat ||",
      "translation": "Seeing his indestructible greatness and unique body, the mother remained wonder-struck",
      "punjabiViakhya": "(ਅਜਿਹੇ) ਪੁੱਤਰ ਨੂੰ ਵੇਖ ਕੇ ਮਾਤਾ ਹੈਰਾਨ ਰਹਿ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "आविलोकि पुत्र चकि रही मात ॥",
      "sourceLineId": "102120",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੇਸਨ ਬਿਦੇਸ ਚਕਿ ਰਹੀ ਸਰਬ ॥",
      "transliteration": "dhesan bidhes chak rahee sarab ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਸਾ ਵਿਦੇਸਾ ਵਿਚ ਸਭ ਲੋਕ ਹੈਰਾਨ ਹੋ ਗਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "देसन बिदेस चकि रही सरब ॥",
      "sourceLineId": "102121",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੁਨਿ ਸਰਬ ਰਿਖਿਨ ਤਜਿ ਦੀਨ ਗਰਬ ॥੪੫॥",
      "transliteration": "sun sarab rikhin taj dheen garab ||45||",
      "translation": "All the people in counties far and near also marveled to see him and all of them abandoned their pride on listening to his greatness.45.",
      "punjabiViakhya": "(ਦੱਤ ਦੀ ਆਮਦ) ਸੁਣ ਕੇ ਸਾਰਿਆਂ ਰਿਸ਼ੀਆਂ ਨੇ ਹੰਕਾਰ ਛਡ ਦਿੱਤਾ ਸੀ ॥੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "सुनि सरब रिखिन तजि दीन गरब ॥४५॥",
      "sourceLineId": "102122",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਰਬਤ੍ਰ ਪ੍ਰਯਾਲ ਸਰਬਤ੍ਰ ਅਕਾਸ ॥",
      "transliteration": "sarabatr prayaal sarabatr akaas ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਪਾਤਾਲਾ ਅਤੇ ਸਾਰਿਆਂ ਆਕਾਸ਼ਾ ਵਿਚ",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "सरबत्र प्रयाल सरबत्र अकास ॥",
      "sourceLineId": "102123",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚਲ ਚਾਲ ਚਿਤੁ ਸੁੰਦਰ ਸੁ ਬਾਸ ॥",
      "transliteration": "chal chaal chit su(n)dhar su baas ||",
      "translation": "The whole nether-world and sky had the feeling about his comeliness which made all the creatures full of joy",
      "punjabiViakhya": "ਅਤੇ ਸੁੰਦਰ ਨਿਵਾਸਾ (ਵਿਚ ਵਸਣ ਵਾਲਿਆਂ ਦੇ) ਚਿਤ ਵਿਚ ਹਲਚਲ ਮਚ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "चल चाल चितु सुँदर सु बास ॥",
      "sourceLineId": "102124",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕੰਪਾਇਮਾਨ ਹਰਖੰਤ ਰੋਮ ॥",
      "transliteration": "ka(n)paimaan harakha(n)t rom ||",
      "translation": "",
      "punjabiViakhya": "(ਸ਼ਰੀਰ) ਕੰਬਣ ਲਗੇ ਸਨ ਅਤੇ ਖੁਸ਼ੀ ਨਾਲ ਰੋਮ ਖੜੇ ਹੋ ਗਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "कंपाइमान हरखंत रोम ॥",
      "sourceLineId": "102125",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਆਨੰਦਮਾਨ ਸਭ ਭਈ ਭੋਮ ॥੪੬॥",
      "transliteration": "aana(n)dhamaan sabh bhiee bhom ||46||",
      "translation": "Because of him, the whole earth became blissful.46.",
      "punjabiViakhya": "ਸਾਰੀ ਭੂਮੀ ਆਨੰਦਮਈ ਹੋ ਗਈ ਸੀ ॥੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "आनंदमान सभ भई भोम ॥४६॥",
      "sourceLineId": "102126",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਥਰਹਰਤ ਭੂਮਿ ਆਕਾਸ ਸਰਬ ॥",
      "transliteration": "tharaharat bhoom aakaas sarab ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਾ ਆਕਾਸ਼ ਅਤੇ ਧਰਤੀ ਕੰਬ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "थरहरत भूमि आकास सरब ॥",
      "sourceLineId": "102127",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਹ ਤਹ ਰਿਖੀਨ ਤਜਿ ਦੀਨ ਗਰਬ ॥",
      "transliteration": "jeh teh rikheen taj dheen garab ||",
      "translation": "The sky and the earth all quivered and the sages here and there abandoned their pride",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਰਿਸ਼ੀਆਂ ਨੇ ਹੰਕਾਰ ਛਡ ਦਿੱਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "जह तह रिखीन तजि दीन गरब ॥",
      "sourceLineId": "102128",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਾਜੇ ਬਜੰਤ੍ਰ ਅਨੇਕ ਗੈਨ ॥",
      "transliteration": "baaje baja(n)tr anek gain ||",
      "translation": "",
      "punjabiViakhya": "ਆਕਾਸ਼ ਵਿਚ ਅਨੇਕ ਤਰ੍ਰਹਾ ਦੇ ਵਾਜੇ ਵਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 638,
      "hindi": "",
      "hindiTransliteration": "बाजे बजंत्र अनेक गैन ॥",
      "sourceLineId": "102129",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0638_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦਸ ਦਿਉਸ ਪਾਇ ਦਿਖੀ ਨ ਰੈਣ ॥੪੭॥",
      "transliteration": "dhas dhiaus pai dhikhee na rain ||47||",
      "translation": "On his manifestation, many instruments (musical) were played in the sky and for ten days, the presence o f night was not felt.47.",
      "punjabiViakhya": "ਦਸ ਦਿਨ ਰਾਤ ਪਈ ਦਿਖੀ ਹੀ ਨਹੀਂ ॥੪੭॥",
