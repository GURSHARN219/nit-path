{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 639,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0639_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਹ ਤਹ ਬਜੰਤ੍ਰ ਬਾਜੇ ਅਨੇਕ ॥",
      "transliteration": "jeh teh baja(n)tr baaje anek ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਅਨੇਕ ਤਰ੍ਰਹਾ ਦੇ ਵਾਜੇ ਵਜ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "जह तह बजंत्र बाजे अनेक ॥",
      "sourceLineId": "102131",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪ੍ਰਗਟਿਆ ਜਾਣੁ ਬਪੁ ਧਰਿ ਬਿਬੇਕ ॥",
      "transliteration": "pragaTiaa jaan bap dhar bibek ||",
      "translation": "Many musical instruments were played here and there and it appeared that the discriminating intellect had assumed a body itself",
      "punjabiViakhya": "ਮਾਨੋ ਵਿਵੇਕ ਨੂੰ ਧਾਰਨ ਵਾਲਾ ਸ਼ਰੀਰ ਪ੍ਰਗਟ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "प्रगटिआ जाणु बपु धरि बिबेक ॥",
      "sourceLineId": "102132",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੋਭਾ ਅਪਾਰ ਬਰਨੀ ਨ ਜਾਇ ॥",
      "transliteration": "sobhaa apaar baranee na jai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਅਪਾਰ ਸ਼ੋਭਾ ਹੈ (ਜਿਸ ਦਾ) ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "सोभा अपार बरनी न जाइ ॥",
      "sourceLineId": "102133",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਉਪਜਿਆ ਆਨ ਸੰਨ੍ਯਾਸ ਰਾਇ ॥੪੮॥",
      "transliteration": "aupajiaa aan sa(n)nayaas rai ||48||",
      "translation": "His glory is indescribable and he manifested himself as the king of ‘Sannyas’.48.",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਆ ਕੇ ਸੰਨਿਆਸ ਰਾਜ ਪੈਦਾ ਹੋਇਆ ਹੈ ॥੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "उपजिआ आन संन्यास राइ ॥४८॥",
      "sourceLineId": "102134",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਨਮੰਤ ਲਾਗਿ ਉਠ ਜੋਗ ਕਰਮ ॥",
      "transliteration": "janama(n)t laag uTh jog karam ||",
      "translation": "",
      "punjabiViakhya": "ਜੰਮਦਿਆਂ ਹੀ ਯੋਗ ਕਰਮ ਵਿਚ ਲਗ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "जनमंत लागि उठ जोग करम ॥",
      "sourceLineId": "102135",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਤਿ ਕੀਓ ਪਾਪ ਪਰਚੁਰਿਓ ਧਰਮ ॥",
      "transliteration": "hat keeo paap parachurio dharam ||",
      "translation": "Even on taking birth, he absorbed himself in actions of Yogs",
      "punjabiViakhya": "ਪਾਪਾ ਨੂੰ ਨਸ਼ਟ ਕਰ ਕੇ ਧਰਮ ਦਾ ਪ੍ਰਚਾਰ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "हति कीओ पाप परचुरिओ धरम ॥",
      "sourceLineId": "102136",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਾਜਾਧਿਰਾਜ ਬਡ ਲਾਗ ਚਰਨ ॥",
      "transliteration": "raajaadhiraaj badd laag charan ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਡੇ ਵੱਡੇ ਰਾਜੇ ਮਹਾਰਾਜੇ ਚਰਨੀਂ ਆ ਲਗੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "राजाधिराज बड लाग चरन ॥",
      "sourceLineId": "102137",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੰਨਿਆਸ ਜੋਗ ਉਠਿ ਲਾਗ ਕਰਨ ॥੪੯॥",
      "transliteration": "sa(n)niaas jog uTh laag karan ||49||",
      "translation": "And he, destroying sins, propagated Dharma the great Sovereign fell at his feet and getting up, they practiced Sannyas and Yoga.49.",
      "punjabiViakhya": "ਅਤੇ ਉਠ ਕੇ ਸੰਨਿਆਸ ਯੋਗ ਕਰਨ ਵਿਚ ਲੀਨ ਹੋ ਗਏ ਹਨ ॥੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "संनिआस जोग उठि लाग करन ॥४९॥",
      "sourceLineId": "102138",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਤਿਭੁਤਿ ਅਨੂਪ ਲਖਿ ਦਤ ਰਾਇ ॥",
      "transliteration": "atibhut anoop lakh dhat rai ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਤ ਰਾਜ ਅਦਭੁਤ ਅਤੇ ਅਨੁਪਮ (ਰੂਪ ਵਾਲਾ) ਦਿਖਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "अतिभुति अनूप लखि दत राइ ॥",
      "sourceLineId": "102139",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਉਠਿ ਲਗੇ ਪਾਇ ਨ੍ਰਿਪ ਸਰਬ ਆਇ ॥",
      "transliteration": "auTh lage pai nirap sarab aai ||",
      "translation": "Seeing the unique king Dutt, all the king bowed respectfully at his feet",
      "punjabiViakhya": "ਸਾਰੇ ਰਾਜੇ ਉਠ ਕੇ (ਉਸ ਦੀ) ਚਰਨੀਂ ਆ ਲਗੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "उठि लगे पाइ नृप सरब आइ ॥",
      "sourceLineId": "102140",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਵਿਲੋਕਿ ਦਤ ਮਹਿਮਾ ਮਹਾਨ ॥",
      "transliteration": "avilok dhat mahimaa mahaan ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾਨ ਮਹਿਮਾ ਵਾਲੇ ਦੱਤ ਨੂੰ ਵੇਖਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "अविलोकि दत महिमा महान ॥",
      "sourceLineId": "102141",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦਸ ਚਾਰ ਚਾਰ ਬਿਦਿਆ ਨਿਧਾਨ ॥੫੦॥",
      "transliteration": "dhas chaar chaar bidhiaa nidhaan ||50||",
      "translation": "Seeing the greatness of Dutt, it appeared that he was the store of eighteen sciences.50.",
      "punjabiViakhya": "ਜੋ ਅਠਾਰ੍ਰਹਾ ਵਿਦਿਆਵਾ ਦਾ ਗਿਆਤਾ ਹੈ ॥੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "दस चार चार बिदिआ निधान ॥५०॥",
      "sourceLineId": "102142",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੋਭੰਤ ਸੀਸ ਜਤ ਕੀ ਜਟਾਨ ॥",
      "transliteration": "sobha(n)t sees jat kee jaTaan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਸਿਰ ਉਤੇ ਜਤ ਦੀਆਂ ਜਟਾਵਾ ਸ਼ੋਭਦੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "सोभंत सीस जत की जटान ॥",
      "sourceLineId": "102143",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਖ ਨੇਮ ਕੇ ਸੁ ਬਢਏ ਮਹਾਨ ॥",
      "transliteration": "nakh nem ke su badde mahaan ||",
      "translation": "On his head, there were the matted locks of his celibacy and on his hands grew the nails of observances",
      "punjabiViakhya": "ਅਤੇ ਹੱਥ ਵਿਚ ਨਿਯਮ ਦੇ ਨੌਂਹ ਵਧਾਏ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "नख नेम के सु बढए महान ॥",
      "sourceLineId": "102144",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਿਭ੍ਰਮ ਬਿਭੂਤ ਉਜਲ ਸੋ ਸੋਹ ॥",
      "transliteration": "bibhram bibhoot ujal so soh ||",
      "translation": "",
      "punjabiViakhya": "ਭਰਮਾ ਤੋਂ ਰਹਿਤ ਹੋਣ ਦੀ ਅਵਸਥਾ ਹੀ (ਉਸ ਦੇ ਸ਼ਰੀਰ ਉਤੇ) ਉਜਲੀ ਵਿਭੂਤੀ ਸ਼ੋਭ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "बिभ्रम बिभूत उजल सो सोह ॥",
      "sourceLineId": "102145",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦਿਜ ਚਰਜ ਤੁਲਿ ਮ੍ਰਿਗ ਚਰਮ ਅਰੋਹ ॥੫੧॥",
      "transliteration": "dhij charaj tul mirag charam aroh ||51||",
      "translation": "The white ashes on his body were indicative of his state devoid of illusions his character like Brahm (Brahman) was his deer skin.51.",
      "punjabiViakhya": "ਬ੍ਰਾਹਮਣ ਕਰਮ ਹੀ ਮ੍ਰਿਗਛਾਲਾ ਉਪਰ ਬੈਠਣਾ ਹੈ ॥੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "दिज चरज तुलि मृग चरम अरोह ॥५१॥",
      "sourceLineId": "102146",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੁਖ ਸਿਤ ਬਿਭੂਤ ਲੰਗੋਟ ਬੰਦ ॥",
      "transliteration": "mukh sit bibhoot la(n)goT ba(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਖ ਦੀ ਉਜਲੀ ਵਿਭੂਤੀ ਮਾਨੋ ਲੰਗੋਟ ਬੰਦ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "मुख सित बिभूत लंगोट बंद ॥",
      "sourceLineId": "102147",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੰਨ੍ਯਾਸ ਚਰਜ ਤਜਿ ਛੰਦ ਬੰਦ ॥",
      "transliteration": "sa(n)nayaas charaj taj chha(n)dh ba(n)dh ||",
      "translation": "Having white ashes on his face and wearing loin-cloth, he was the possessor of Sannyas and conduct and relinquisher of deceit",
      "punjabiViakhya": "ਛਲ ਕਪਟ ਦਾ ਤਿਆਗ ਹੀ ਸੰਨਿਆਸ ਕਰਮ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "संन्यास चरज तजि छंद बंद ॥",
      "sourceLineId": "102148",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਆਸੁਨਕ ਸੁੰਨਿ ਅਨਵ੍ਰਯਕਤ ਅੰਗ ॥",
      "transliteration": "aasunak su(n)n anavrayakat a(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਨ ਸਮਾਧੀ ਹੀ (ਉਸ ਦਾ) ਆਸਨ ਹੈ ਅਤੇ ਮੋਹ ਤੋਂ ਵਿਰਕਤੀ ਹੀ (ਯੋਗ ਦੇ) ਅੰਗ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "आसुनक सुँनि अनव्रयकत अंग ॥",
      "sourceLineId": "102149",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਆਛਿਜ ਤੇਜ ਮਹਿਮਾ ਸੁਰੰਗ ॥੫੨॥",
      "transliteration": "aachhij tej mahimaa sura(n)g ||52||",
      "translation": "He remained absorbed in abstract meditation and his limbs were extremely charming his radiance was indestructible.52.",
      "punjabiViakhya": "ਨਾ ਛਿਜਣ ਵਾਲਾ ਤੇਜ ਹੀ (ਉਸ ਦੀ) ਸੁੰਦਰ ਮਹਿਮਾ ਹੈ ॥੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "आछिज तेज महिमा सुरंग ॥५२॥",
      "sourceLineId": "102150",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਕ ਆਸ ਚਿਤ ਤਜਿ ਸਰਬ ਆਸ ॥",
      "transliteration": "eik aas chit taj sarab aas ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਚਿਤ ਵਿਚ ਇਕੋ (ਸੰਨਿਆਸ ਯੋਗ ਦੀ) ਆਸ ਰਖ ਕੇ ਬਾਕੀ ਸਾਰੀਆਂ ਆਸਾ ਛਡ ਦਿੱਤੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "इक आस चित तजि सरब आस ॥",
      "sourceLineId": "102151",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਨਭੂਤ ਗਾਤ ਨਿਸ ਦਿਨ ਉਦਾਸ ॥",
      "transliteration": "anabhoot gaat nis dhin udhaas ||",
      "translation": "In his mind there was only one desire of Sannyas and Yoga and for this desire he had abandoned all other desires",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਅਦਭੁਤ ਸ਼ਰੀਰ ਸਦਾ ਉਦਾਸ (ਨਿਰਲਿਪਤ) ਰਹਿੰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "अनभूत गात निस दिन उदास ॥",
      "sourceLineId": "102152",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮੁਨਿ ਚਰਜ ਲੀਨ ਤਜਿ ਸਰਬ ਕਾਮ ॥",
      "transliteration": "mun charaj leen taj sarab kaam ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਕਾਮਨਾਵਾ ਦਾ ਤਿਆਗ ਹੀ (ਉਸ ਦਾ) ਮੁਨੀ ਕਰਮ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "मुनि चरज लीन तजि सरब काम ॥",
      "sourceLineId": "102153",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਰਕਤਿ ਨੇਤ੍ਰ ਜਨੁ ਧਰਮ ਧਾਮ ॥੫੩॥",
      "transliteration": "aarakat netr jan dharam dhaam ||53||",
      "translation": "His body was unique and during day and night, he remained detached from the deceits of the world leaving the desires of all kinds, he had adopted the character of sages his eyes were red and were the store of Dharma.53.",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਲਾਲੀ ਰਹਿਤ (ਆਰਕਤ) ਨੈਣ ਮਾਨੋ ਧਰਮ ਦਾ ਘਰ ਹਨ ॥੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "आरकति नेत्र जनु धरम धाम ॥५३॥",
      "sourceLineId": "102154",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਬਿਕਾਰ ਚਿਤ ਅਣਡੋਲ ਅੰਗ ॥",
      "transliteration": "abikaar chit anaddol a(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਵਿਕਾਰਾ ਤੋਂ ਰਹਿਤ ਚਿਤ ਹੀ ਮਾਨੋ ਸ਼ਰੀਰ ਦੇ ਅੰਗਾ ਨੂੰ ਅਡੋਲ ਰਖਣਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "अबिकार चित अणडोल अंग ॥",
      "sourceLineId": "102155",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੁਤ ਧਿਆਨ ਨੇਤ੍ਰ ਮਹਿਮਾ ਅਭੰਗ ॥",
      "transliteration": "jut dhiaan netr mahimaa abha(n)g ||",
      "translation": "He had a pure mind, devoid of vices, and he meditated with his non-mercurial eyes",
      "punjabiViakhya": "ਨਾ ਨਸ਼ਟ ਹੋਣ ਵਾਲੀ ਮਹਿਮਾ ਵਾਲੇ ਧਿਆਨ ਯੁਕਤ ਨੇਤਰ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "जुत धिआन नेत्र महिमा अभंग ॥",
      "sourceLineId": "102156",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਧਰਿ ਏਕ ਆਸ ਅਉਦਾਸ ਚਿਤ ॥",
      "transliteration": "dhar ek aas aaudhaas chit ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਆਸ ਧਰ ਕੇ ਚਿਤ ਨੂੰ ਉਦਾਸ (ਨਿਰਲਿਪਤ) ਰਖਿਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "धरि एक आस अउदास चित ॥",
      "sourceLineId": "102157",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੰਨਿਯਾਸ ਦੇਵ ਪਰਮੰ ਪਵਿਤ ॥੫੪॥",
      "transliteration": "sa(n)niyaas dhev parama(n) pavit ||54||",
      "translation": "His praise was infinite having only one desire in his mind of adopting Sannyas from all sides he was the greatest among the immaculate Sannyasis.54.",
      "punjabiViakhya": "(ਉਹ) ਪਰਮ ਪਵਿਤ੍ਰ ਸੰਨਿਆਸ ਦੇਵ ਹੈ ॥੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "संनियास देव परमं पवित ॥५४॥",
      "sourceLineId": "102158",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਵਧੂਤ ਗਾਤ ਮਹਿਮਾ ਅਪਾਰ ॥",
      "transliteration": "avadhoot gaat mahimaa apaar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਸ਼ਰੀਰ ਪਾਪ ਰਹਿਤ ਹੈ ਅਤੇ ਅਪਾਰ ਮਹਿਮਾ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "अवधूत गात महिमा अपार ॥",
      "sourceLineId": "102159",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸ੍ਰੁਤਿ ਗਿਆਨ ਸਿੰਧੁ ਬਿਦਿਆ ਉਦਾਰ ॥",
      "transliteration": "srut giaan si(n)dh bidhiaa udhaar ||",
      "translation": "He had a body of Yogis, whose greatness was infinite and he was the store of the knowledge of Shrutis (Vedas) and extremely generous",
      "punjabiViakhya": "ਵੇਦ-ਗਿਆਨ ਅਤੇ ਵਿਦਿਆਵਾ ਦਾ ਉਦਾਰ ਸਮੁੰਦਰ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "स्रुति गिआन सिंधु बिदिआ उदार ॥",
      "sourceLineId": "102160",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮੁਨਿ ਮਨਿ ਪ੍ਰਬੀਨ ਗੁਨਿ ਗਨ ਮਹਾਨ ॥",
      "transliteration": "mun man prabeen gun gan mahaan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਮੁਨੀ ਪ੍ਰਬੀਨ ਮਨ ਵਾਲਾ ਹੈ ਅਤੇ ਮਹਾਨ ਗੁਣਾ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "मुनि मनि प्रबीन गुनि गन महान ॥",
      "sourceLineId": "102161",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਨੁ ਭਯੋ ਪਰਮ ਗਿਆਨੀ ਮਹਾਨ ॥੫੫॥",
      "transliteration": "jan bhayo param giaanee mahaan ||55||",
      "translation": "Amongst the sages, he was most skilful and great and was supremely learned.55.",
      "punjabiViakhya": "ਮਾਨੋ ਬੜਾ ਵੱਡਾ ਗਿਆਨੀ ਪੈਦਾ ਹੋਇਆ ਹੈ ॥੫੫॥",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "जनु भयो परम गिआनी महान ॥५५॥",
      "sourceLineId": "102162",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਬਹੂੰ ਨ ਪਾਪ ਜਿਹ ਛੁਹਾ ਅੰਗ ॥",
      "transliteration": "kabahoo(n) na paap jeh chhuhaa a(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਸ਼ਰੀਰ ਨੂੰ ਕਦੇ ਪਾਪ ਨੇ ਛੋਹਿਆ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "कबहूँ न पाप जिह छुहा अंग ॥",
      "sourceLineId": "102163",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗੁਨਿ ਗਨ ਸੰਪੰਨ ਸੁੰਦਰ ਸੁਰੰਗ ॥",
      "transliteration": "gun gan sa(n)pa(n)n su(n)dhar sura(n)g ||",
      "translation": "The sin had not even touched him and he was elegant in virtues",
      "punjabiViakhya": "(ਉਹ) ਸਾਰਿਆਂ ਗੁਣਾ ਨਾਲ ਸੰਪੰਨ ਹੈ ਅਤੇ ਸੁੰਦਰ ਸ਼ਰੀਰ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "गुनि गन संपंन सुँदर सुरंग ॥",
      "sourceLineId": "102164",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਲੰਗੋਟਬੰਦ ਅਵਧੂਤ ਗਾਤ ॥",
      "transliteration": "la(n)goTaba(n)dh avadhoot gaat ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਲੰਗੋਟ ਧਾਰੀ ਪਵਿਤ੍ਰ ਸ਼ਰੀਰ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "लंगोटबंद अवधूत गात ॥",
      "sourceLineId": "102165",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚਕਿ ਰਹੀ ਚਿਤ ਅਵਲੋਕਿ ਮਾਤ ॥੫੬॥",
      "transliteration": "chak rahee chit avalok maat ||56||",
      "translation": "The Yogi Dutt wore loin-cloth and seeing him, mother was wonder-struck.56.",
      "punjabiViakhya": "ਮਾਤਾ (ਉਸ ਨੂੰ) ਵੇਖ ਕੇ ਚਕ੍ਰਿਤ ਹੋ ਰਹੀ ਹੈ ॥੫੬॥",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "चकि रही चित अवलोकि मात ॥५६॥",
      "sourceLineId": "102166",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੰਨਿਯਾਸ ਦੇਵ ਅਨਭੂਤ ਅੰਗ ॥",
      "transliteration": "sa(n)niyaas dhev anabhoot a(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਨਿਆਸ ਦੇਵ ਦਾ ਅਦਭੁਤ ਸ਼ਰੀਰ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "संनियास देव अनभूत अंग ॥",
      "sourceLineId": "102167",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਲਾਜੰਤ ਦੇਖਿ ਜਿਹ ਦੁਤਿ ਅਨੰਗ ॥",
      "transliteration": "laaja(n)t dhekh jeh dhut ana(n)g ||",
      "translation": "Seeing the greatest Sannyasi Dutt, having comely limbs, even the god of love felt shy",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਚਮਕ ਨੂੰ ਵੇਖ ਕੇ ਕਾਮਦੇਵ ਵੀ ਲਜਿਤ ਹੁੰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "लाजंत देखि जिह दुति अनंग ॥",
      "sourceLineId": "102168",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮੁਨਿ ਦਤ ਦੇਵ ਸੰਨ੍ਯਾਸ ਰਾਜ ॥",
      "transliteration": "mun dhat dhev sa(n)nayaas raaj ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਨੀ ਦੱਤ ਦੇਵ ਸੰਨਿਆਸ ਦਾ ਰਾਜਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "मुनि दत देव संन्यास राज ॥",
      "sourceLineId": "102169",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਿਹ ਸਧੇ ਸਰਬ ਸੰਨ੍ਯਾਸ ਸਾਜ ॥੫੭॥",
      "transliteration": "jeh sadhe sarab sa(n)nayaas saaj ||57||",
      "translation": "The sage Dutt was the king of Sannyasis and he had practiced all kinds of the activities of Sannyas.57.",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਸੰਨਿਆਸ ਦੇ ਸਾਰੇ ਸਾਜ ਸਾਧੇ ਹੋਏ ਹਨ ॥੫੭॥",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "जिह सधे सरब संन्यास साज ॥५७॥",
      "sourceLineId": "102170",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪਰਮੰ ਪਵਿਤ੍ਰ ਜਾ ਕੇ ਸਰੀਰ ॥",
      "transliteration": "parama(n) pavitr jaa ke sareer ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਸ਼ਰੀਰ ਪਰਮ ਪਵਿਤ੍ਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "परमं पवित्र जा के सरीर ॥",
      "sourceLineId": "102171",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਬਹੂੰ ਨ ਕਾਮ ਕਿਨੋ ਅਧੀਰ ॥",
      "transliteration": "kabahoo(n) na kaam kino adheer ||",
      "translation": "His body was immaculate, which had never been troubled by lust",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਕਾਮਨਾਵਾ ਨੇ ਕਦੇ ਆਧਾਰ ਨਹੀਂ ਬਣਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "कबहूँ न काम किनो अधीर ॥",
      "sourceLineId": "102172",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਟ ਜੋਗ ਜਾਸੁ ਸੋਭੰਤ ਸੀਸ ॥",
      "transliteration": "jaT jog jaas sobha(n)t sees ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਸਿਰ ਉਤੇ ਯੋਗ ਦੀਆਂ ਜਟਾਵਾ ਸ਼ੋਭਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "जट जोग जासु सोभंत सीस ॥",
      "sourceLineId": "102173",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਸ ਧਰਾ ਰੂਪ ਸੰਨਿਯਾਸ ਈਸ ॥੫੮॥",
      "transliteration": "as dharaa roop sa(n)niyaas iees ||58||",
      "translation": "On his head there was a tuft of matted locks such a form was adopted by Dutt, the incarnation of Rudra.58.",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਰੂਪ ਸੰਨਿਆਸ ਦੇ ਰਾਜੇ ਨੇ ਧਾਰਨ ਕੀਤਾ ਹੋਇਆ ਹੈ ॥੫੮॥",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "अस धरा रूप संनियास ईस ॥५८॥",
      "sourceLineId": "102174",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਆਭਾ ਅਪਾਰ ਕਥਿ ਸਕੈ ਕਉਨ ॥",
      "transliteration": "aabhaa apaar kath sakai kaun ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਆਭਾ ਅਪਾਰ ਹੈ, (ਉਸ ਆਭਾ ਦਾ) ਕੌਣ ਕਥਨ ਕਰ ਸਕਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "आभा अपार कथि सकै कउन ॥",
      "sourceLineId": "102175",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0639_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੁਨਿ ਰਹੈ ਜਛ ਗੰਧ੍ਰਬ ਮਉਨ ॥",
      "transliteration": "sun rahai jachh ga(n)dhrab maun ||",
      "translation": "Who can describe his fine glory ? And listening to his appreciation, the Yakshas and Gandharvas become silent",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ) ਸੁਣ ਕੇ ਯਕਸ਼ ਅਤੇ ਗੰਧ੍ਰਬ ਮੌਨ ਹੋ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 639,
      "hindi": "",
      "hindiTransliteration": "सुनि रहै जछ गंध्रब मउन ॥",
