{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 640,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0640_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਤਿ ਗਿਆਨਵੰਤ ਕਰਮਨ ਪ੍ਰਬੀਨ ॥",
      "transliteration": "at giaanava(n)t karaman prabeen ||",
      "translation": "",
      "punjabiViakhya": "ਅਤਿ ਗਿਆਨਵਾਨ ਹੈ ਅਤੇ ਕਰਮਾ ਵਿਚ ਪ੍ਰਬੀਨ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "अति गिआनवंत करमन प्रबीन ॥",
      "sourceLineId": "102179",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਨ ਆਸ ਗਾਤ ਹਰਿ ਕੋ ਅਧੀਨ ॥",
      "transliteration": "an aas gaat har ko adheen ||",
      "translation": "He was extremely learned, expert in actions, beyond the desires and obedient to the Lord",
      "punjabiViakhya": "ਕਿਸੇ ਦੀ ਆਸ ਤੋਂ ਰਹਿਤ ਅਤੇ ਹਰਿ ਦੇ ਅਧੀਨ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "अन आस गात हरि को अधीन ॥",
      "sourceLineId": "102180",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਛਬਿ ਦਿਪਤ ਕੋਟ ਸੂਰਜ ਪ੍ਰਮਾਨ ॥",
      "transliteration": "chhab dhipat koT sooraj pramaan ||",
      "translation": "",
      "punjabiViakhya": "ਕਰੋੜਾ ਸੂਰਜਾ ਦੇ ਸਮਾਨ ਜਿਸ ਦੀ ਛਬੀ ਦਾ ਪ੍ਰਕਾਸ਼ ਹੋ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "छबि दिपत कोट सूरज प्रमान ॥",
      "sourceLineId": "102181",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚਕ ਰਹਾ ਚੰਦ ਲਖਿ ਆਸਮਾਨ ॥੬੦॥",
      "transliteration": "chak rahaa cha(n)dh lakh aasamaan ||60||",
      "translation": "His elegance was like the crores of suns and the moon was also wonder-struck on seeing him.60.",
      "punjabiViakhya": "ਚੰਦ੍ਰਮਾ ਵੇਖ ਕੇ ਆਕਾਸ਼ ਵਿਚ ਹੈਰਾਨ ਹੋ ਰਿਹਾ ਹੈ ॥੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "चक रहा चंद लखि आसमान ॥६०॥",
      "sourceLineId": "102182",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਉਪਜਿਯਾ ਆਪ ਇਕ ਜੋਗ ਰੂਪ ॥",
      "transliteration": "aupajiyaa aap ik jog roop ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਆਪ ਹੀ 'ਇਕ' ਯੋਗ ਰੂਪ ਵਿਚ ਪੈਦਾ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "उपजिया आप इक जोग रूप ॥",
      "sourceLineId": "102183",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪੁਨਿ ਲਗੋ ਜੋਗ ਸਾਧਨ ਅਨੂਪ ॥",
      "transliteration": "pun lago jog saadhan anoop ||",
      "translation": "He had manifested as the apparent form of yoga and then had been absorbed in the practice of Yoga",
      "punjabiViakhya": "ਫਿਰ ਅਨੂਪਮ ਯੋਗ ਸਾਧਨਾ ਕਰਨ ਲਗਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "पुनि लगो जोग साधन अनूप ॥",
      "sourceLineId": "102184",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗ੍ਰਿਹ ਪ੍ਰਿਥਮ ਛਾਡਿ ਉਠਿ ਚਲਾ ਦਤ ॥",
      "transliteration": "gireh piratham chhaadd uTh chalaa dhat ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਤ ਪਹਿਲਾ ਘਰ ਨੂੰ ਛਡ ਕੇ ਉਠ ਚਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "गृह पृथम छाडि उठि चला दत ॥",
      "sourceLineId": "102185",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪਰਮੰ ਪਵਿਤ੍ਰ ਨਿਰਮਲੀ ਮਤਿ ॥੬੧॥",
      "transliteration": "parama(n) pavitr niramalee mat ||61||",
      "translation": "That immaculate Dutt of pure intellect did the first thing of leaving his home.61.",
      "punjabiViakhya": "(ਉਹ) ਪਰਮ ਪਵਿਤ੍ਰ ਅਤੇ ਨਿਰਮਲ ਬੁੱਧੀ ਵਾਲਾ ਹੈ ॥੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "परमं पवित्र निरमली मति ॥६१॥",
      "sourceLineId": "102186",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਬ ਕੀਨ ਜੋਗ ਬਹੁ ਦਿਨ ਪ੍ਰਮਾਨ ॥",
      "transliteration": "jab keen jog bahu dhin pramaan ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਨੇ ਬਹਤੁ ਦਿਨਾ ਤਕ ਯੋਗ ਕਰ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "जब कीन जोग बहु दिन प्रमान ॥",
      "sourceLineId": "102187",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਬ ਕਾਲ ਦੇਵ ਰੀਝੇ ਨਿਦਾਨ ॥",
      "transliteration": "tab kaal dhev reejhe nidhaan ||",
      "translation": "When he practiced Yoga for a long time, Kaldev (the Lord) was pleased with him",
      "punjabiViakhya": "ਤਦ ਅੰਤ ਵਿਚ ਕਾਲ ਦੇਵ ਉਸ ਉਤੇ ਪ੍ਰਸੰਨ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "तब काल देव रीझे निदान ॥",
      "sourceLineId": "102188",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਮਿ ਭਈ ਬਿਓਮ ਬਾਨੀ ਬਨਾਇ ॥",
      "transliteration": "eim bhiee biom baanee banai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦੀ ਆਕਾਸ਼ ਬਾਣੀ ਹੋਈ,",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "इमि भई बिओम बानी बनाइ ॥",
      "sourceLineId": "102189",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤੁਮ ਸੁਣਹੁ ਬੈਨ ਸੰਨ੍ਯਾਸ ਰਾਇ ॥੬੨॥",
      "transliteration": "tum sunahu bain sa(n)nayaas rai ||62||",
      "translation": "At that time, there was a heavenly voice “O king of Yogis! Listen to what I say.”62.",
      "punjabiViakhya": "ਹੇ ਸੰਨਿਆਸ ਰਾਜ! ਤੁਸੀਂ ਧਿਆਨ ਦੇ ਕੇ ਸੁਣੋ ॥੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "तुम सुणहु बैन संन्यास राइ ॥६२॥",
      "sourceLineId": "102190",
      "sourceShabadId": "9330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਕਾਸ ਬਾਨੀ ਬਾਚਿ ਦਤ ਪ੍ਰਤਿ ॥",
      "transliteration": "aakaas baanee baach dhat prat ||",
      "translation": "Voice from heaven addressed to Dutt :",
      "punjabiViakhya": "ਆਕਾਸ਼ ਬਾਣੀ ਨੇ ਦੱਤ ਪ੍ਰਤਿ ਕਿਹਾ -",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "आकास बानी बाचि दत प्रति ॥",
      "sourceLineId": "102191",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪਾਧੜੀ ਛੰਦ ॥",
      "transliteration": "paadhaRee chha(n)dh ||",
      "translation": "PAADHARI STANZA",
      "punjabiViakhya": "ਪਾਧੜੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "पाधड़ी छंद ॥",
      "sourceLineId": "102192",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਰ ਹੀਣ ਮੁਕਤਿ ਨਹੀ ਹੋਤ ਦਤ ॥",
      "transliteration": "gur heen mukat nahee hot dhat ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਦੱਤ! ਗੁਰੂ ਤੋਂ ਹੀਣ (ਅਵਸਥਾ ਵਿਚ) ਮੁਕਤੀ ਨਹੀਂ ਹੋਏਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "गुर हीण मुकति नही होत दत ॥",
      "sourceLineId": "102193",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤੁਹਿ ਕਹੋ ਬਾਤ ਸੁਨਿ ਬਿਮਲ ਮਤ ॥",
      "transliteration": "tuh kaho baat sun bimal mat ||",
      "translation": "“O Dutt! Listen to me with pure intellect",
      "punjabiViakhya": "ਹੇ ਨਿਰਮਲ ਬੁੱਧੀ ਵਾਲੇ! ਤੈਨੂੰ ਗੱਲ ਕਹਿੰਦਾ ਹਾ, (ਧਿਆਨ ਨਾਲ) ਸੁਣ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "तुहि कहो बात सुनि बिमल मत ॥",
      "sourceLineId": "102194",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗੁਰ ਕਰਹਿ ਪ੍ਰਿਥਮ ਤਬ ਹੋਗਿ ਮੁਕਤਿ ॥",
      "transliteration": "gur kareh piratham tab hog mukat ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਗੁਰੂ ਧਾਰਨ ਕਰ, ਤਦ ਮੁਕਤ ਹੋਵੇਾਂਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "गुर करहि पृथम तब होगि मुकति ॥",
      "sourceLineId": "102195",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਹਿ ਦੀਨ ਕਾਲ ਤਿਹ ਜੋਗ ਜੁਗਤ ॥੬੩॥",
      "transliteration": "keh dheen kaal teh jog jugat ||63||",
      "translation": "I say unto you that there can be no salvation without the Guru first of all, adopt a Guru, then you will be redeemed, in this way, KAL told the method of Yoga to Dutt.63.",
      "punjabiViakhya": "ਕਾਲਦੇਵ ਨੇ ਉਸ ਨੂੰ (ਇਹ) ਯੋਗ ਦੀ ਜੁਗਤ ਕਹਿ ਦਿੱਤੀ ॥੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "कहि दीन काल तिह जोग जुगत ॥६३॥",
      "sourceLineId": "102196",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਹੁ ਭਾਤਿ ਦਤ ਦੰਡਵਤ ਕੀਨ ॥",
      "transliteration": "bahu bhaat dhat dha(n)ddavat keen ||",
      "translation": "",
      "punjabiViakhya": "(ਆਕਾਸ਼ ਬਾਣੀ ਸੁਣ ਕੇ) ਦੱਤ ਨੇ ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਦੰਡਵਤ (ਪ੍ਰਨਾਮ) ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "बहु भाति दत दंडवत कीन ॥",
      "sourceLineId": "102197",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਆਸਾ ਬਿਰਹਤਿ ਹਰਿ ਕੋ ਅਧੀਨ ॥",
      "transliteration": "aasaa birahat har ko adheen ||",
      "translation": "Obedient to the Lord and abiding beyond the desires, Dutt prostrated before the Lord in various ways",
      "punjabiViakhya": "ਅਤੇ ਆਸ ਤੋਂ ਰਹਿਤ ਹਰਿ ਦੇ ਅਧੀਨ (ਹੋ ਗਿਆ)।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "आसा बिरहति हरि को अधीन ॥",
      "sourceLineId": "102198",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਹੁ ਭਾਤ ਜੋਗ ਸਾਧਨਾ ਸਾਧਿ ॥",
      "transliteration": "bahu bhaat jog saadhanaa saadh ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਬਹੁਤ ਤਰ੍ਰਹਾ ਦੀ ਯੋਗ ਸਾਧਨਾ ਕਰਨ ਲਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "बहु भात जोग साधना साधि ॥",
      "sourceLineId": "102199",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਆਦਗ ਜੋਗ ਮਹਿਮਾ ਅਗਾਧ ॥੬੪॥",
      "transliteration": "aadhag jog mahimaa agaadh ||64||",
      "translation": "He practiced Yoga in different ways and spread the exaltation of Yoga.64.",
      "punjabiViakhya": "(ਜੋ) ਯੋਗ ਕਲੰਕ ਤੋਂ ਮੁਕਤ ਅਗਾਧ ਮਹਿਮਾ ਵਾਲਾ ਹੈ ॥੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "आदग जोग महिमा अगाध ॥६४॥",
      "sourceLineId": "102200",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਬ ਨਮਸਕਾਰ ਕਰਿ ਦਤ ਦੇਵ ॥",
      "transliteration": "tab namasakaar kar dhat dhev ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦੱਤ ਦੇਵ ਨੇ ਨਮਸਕਾਰ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "तब नमसकार करि दत देव ॥",
      "sourceLineId": "102201",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਉਚਰੰਤ ਪਰਮ ਉਸਤਤਿ ਅਭੇਵ ॥",
      "transliteration": "auchara(n)t param usatat abhev ||",
      "translation": "Then Dutt, bowing before the Lord, eulogized the Unmanifested Brahman who is the Sovereign of Sovereigns,",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਪਰਮ ਦੇਵ ਅਤੇ ਅਭੇਵ ਦੀ ਉਸਤਤ ਉਚਾਰੀ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "उचरंत परम उसतति अभेव ॥",
      "sourceLineId": "102202",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜੋਗੀਨ ਜੋਗ ਰਾਜਾਨ ਰਾਜ ॥",
      "transliteration": "jogeen jog raajaan raaj ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਜੋਗੀਆਂ ਦਾ ਜੋਗੀ ਅਤੇ ਰਾਜਿਆਂ ਦਾ ਰਾਜਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "जोगीन जोग राजान राज ॥",
      "sourceLineId": "102203",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਨਭੂਤ ਅੰਗ ਜਹ ਤਹ ਬਿਰਾਜ ॥੬੫॥",
      "transliteration": "anabhoot a(n)g jeh teh biraaj ||65||",
      "translation": "The supreme Yogi and with unique limbs pervades everywhere.65",
      "punjabiViakhya": "ਅਤੇ ਤੱਤ੍ਵਰਹਿਤ ਸ਼ਰੀਰ ਜਿਥੇ ਕਿਥੇ ਬਿਰਾਜ ਰਿਹਾ ਹੈ ॥੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "अनभूत अंग जह तह बिराज ॥६५॥",
      "sourceLineId": "102204",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਲ ਥਲ ਬਿਯਾਪ ਜਿਹ ਤੇਜ ਏਕ ॥",
      "transliteration": "jal thal biyaap jeh tej ek ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਇਕ ਦਾ ਤੇਜ ਜਲ ਥਲ ਵਿਚ ਵਿਆਪ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "जल थल बियाप जिह तेज एक ॥",
      "sourceLineId": "102205",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗਾਵੰਤ ਜਾਸੁ ਮੁਨਿ ਗਨ ਅਨੇਕ ॥",
      "transliteration": "gaava(n)t jaas mun gan anek ||",
      "translation": "The splendour of that Lord Pervades in after an on plain and many sages sing His Praises",
      "punjabiViakhya": "ਜਿਸ ਦੇ (ਗੁਣਾ ਨੂੰ) ਅਨੇਕਾ ਮੁਨੀ ਲੋਗ ਗਾਉਾਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "गावंत जासु मुनि गन अनेक ॥",
      "sourceLineId": "102206",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਿਹ ਨੇਤਿ ਨੇਤਿ ਭਾਖੰਤ ਨਿਗਮ ॥",
      "transliteration": "jeh net net bhaakha(n)t nigam ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਦ ਨੇਤਿ ਨੇਤਿ ਕਹਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "जिह नेति नेति भाखंत निगम ॥",
      "sourceLineId": "102207",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤੇ ਆਦਿ ਅੰਤ ਮਧਹ ਅਗਮ ॥੬੬॥",
      "transliteration": "te aadh a(n)t madheh agam ||66||",
      "translation": "He, whom the Vedas etc. call “Neti, neti” (not this, not this), that Lord is eternal and Pervades in beginning, in the middle and at the end.66.",
      "punjabiViakhya": "ਉਹ ਆਦਿ, ਮੱਧ, ਅੰਤ ਅਤੇ ਪਹੁੰਚ ਤੋਂ ਪਰੇ ਹੈ ॥੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "ते आदि अंत मधह अगम ॥६६॥",
      "sourceLineId": "102208",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਿਹ ਏਕ ਰੂਪ ਕਿਨੇ ਅਨੇਕ ॥",
      "transliteration": "jeh ek roop kine anek ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਇਕ ਨੇ ਅਨੇਕ ਰੂਪ ਧਾਰਨ ਕੀਤੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "जिह एक रूप किने अनेक ॥",
      "sourceLineId": "102209",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪੁਹਮੀ ਅਕਾਸ ਕਿਨੇ ਬਿਬੇਕ ॥",
      "transliteration": "puhamee akaas kine bibek ||",
      "translation": "He who created many beings from one and with His Power of wisdom, created the earth and the sky",
      "punjabiViakhya": "(ਜਿਸ ਨੇ) ਵਿਵੇਕ ਪੂਰਵਕ ਆਕਾਸ਼ ਅਤੇ ਧਰਤੀ ਬਣਾਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "पुहमी अकास किने बिबेक ॥",
      "sourceLineId": "102210",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਲ ਬਾ ਥਲੇਸ ਸਬ ਠੌਰ ਜਾਨ ॥",
      "transliteration": "jal baa thales sab Thauar jaan ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਜਲ, ਥਲ ਵਿਚ ਸਭ ਥਾਵਾ ਉਤੇ ਜਾਣਿਆ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "जल बा थलेस सब ठौर जान ॥",
      "sourceLineId": "102211",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਨਭੈ ਅਜੋਨਿ ਅਨਿ ਆਸ ਮਾਨ ॥੬੭॥",
      "transliteration": "anabhai ajon an aas maan ||67||",
      "translation": "That fearless, birthless and beyond desires is there at all the places in water and on plain.67.",
      "punjabiViakhya": "ਜੋ ਭੈ ਰਹਿਤ, ਜੂਨ ਤੋਂ ਮੁਕਤ ਅਤੇ ਹੋਰ ਕਿਸੇ ਦੀ ਆਸ ਤੋਂ ਬਿਨਾ ਹੈ ॥੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "अनभै अजोनि अनि आस मान ॥६७॥",
      "sourceLineId": "102212",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪਾਵਨ ਪ੍ਰਸਿਧ ਪਰਮੰ ਪੁਨੀਤ ॥",
      "transliteration": "paavan prasidh parama(n) puneet ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਪ੍ਰਸਿੱਧ, ਪਵਿਤ੍ਰ ਅਤੇ ਪਰਮ ਪੁਨੀਤ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "पावन प्रसिध परमं पुनीत ॥",
      "sourceLineId": "102213",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਆਜਾਨ ਬਾਹ ਅਨਭਉ ਅਜੀਤ ॥",
      "transliteration": "aajaan baeh anabhau ajeet ||",
      "translation": "He is supremely immaculate, sacred, pure, long-armed, fearless and unconquerable",
      "punjabiViakhya": "(ਉਹ) ਗੋਡਿਆਂ ਤਕ ਲੰਬੀਆਂ ਬਾਹਵਾ ਵਾਲਾ, ਭੈ ਤੋਂ ਰਹਿਤ ਅਤੇ ਨਾ ਜਿਤੇ ਜਾ ਸਕਣ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "आजान बाह अनभउ अजीत ॥",
      "sourceLineId": "102214",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪਰਮੰ ਪ੍ਰਸਿਧ ਪੂਰਣ ਪੁਰਾਣ ॥",
      "transliteration": "parama(n) prasidh pooran puraan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਪਰਮ ਪ੍ਰਸਿੱਧ ਅਤੇ ਪੂਰਨ ਪੁਰਾਣ (ਪੁਰਸ਼) ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "परमं प्रसिध पूरण पुराण ॥",
      "sourceLineId": "102215",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਾਜਾਨ ਰਾਜ ਭੋਗੀ ਮਹਾਣ ॥੬੮॥",
      "transliteration": "raajaan raaj bhogee mahaan ||68||",
      "translation": "He is the supremely eminent Purusha, the Sovereign of Sovereign and the great enjoyer.68.",
      "punjabiViakhya": "(ਉਹ) ਰਾਜਿਆਂ ਦਾ ਰਾਜਾ ਅਤੇ ਮਹਾਨ ਭੋਗੀ ਹੈ ॥੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "राजान राज भोगी महाण ॥६८॥",
      "sourceLineId": "102216",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਨਛਿਜ ਤੇਜ ਅਨਭੈ ਪ੍ਰਕਾਸ ॥",
      "transliteration": "anachhij tej anabhai prakaas ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਨਾ ਛਿਜੇ ਜਾ ਸਕਣ ਵਾਲੇ ਤੇਜ ਵਾਲਾ ਅਤੇ ਸੁਤਹ ਸਿੱਧ ਪ੍ਰਕਾਸ਼ਿਤ ਹੋਣ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "अनछिज तेज अनभै प्रकास ॥",
      "sourceLineId": "102217",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਖੜਗਨ ਸਪੰਨ ਪਰਮੰ ਪ੍ਰਭਾਸ ॥",
      "transliteration": "khaRagan sapa(n)n parama(n) prabhaas ||",
      "translation": "That Lord has indestructible Lustre, Light-incarnation, Dagger-wielder and is eminent glorious",
      "punjabiViakhya": "(ਉਹ) ਤਲਵਾਰਾ (ਨੂੰ ਵਰਤਣ ਵਿਚ) ਮਾਹਿਰ ਹੈ (ਅਰਥਾਤਰ-ਛੇ ਗੁਣਾ ਨਾਲ ਭਰਪੂਰ ਹੈ) ਬਹੁਤ ਹੀ ਜਲਾਲ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "खड़गन सपंन परमं प्रभास ॥",
      "sourceLineId": "102218",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਆਭਾ ਅਨੰਤ ਬਰਨੀ ਨ ਜਾਇ ॥",
      "transliteration": "aabhaa ana(n)t baranee na jai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਆਭਾ ਅਨੰਤ ਹੈ, ਜੋ ਵਰਣਨ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "आभा अनंत बरनी न जाइ ॥",
      "sourceLineId": "102219",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਫਿਰ ਫਿਰੇ ਸਰਬ ਮਤਿ ਕੋ ਚਲਾਇ ॥੬੯॥",
      "transliteration": "fir fire sarab mat ko chalai ||69||",
      "translation": "His infinite glory is indescribable He Pervades in all the religions.69.",
      "punjabiViakhya": "ਫਿਰ ਉਹ ਸਾਰਿਆਂ ਮੱਤਾ ਨੂੰ ਚਲਾਉਾਂਦਾ ਫਿਰਦਾ ਹੈ ॥੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "फिर फिरे सरब मति को चलाइ ॥६९॥",
      "sourceLineId": "102220",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਬਹੂ ਬਖਾਨ ਜਿਹ ਨੇਤਿ ਨੇਤਿ ॥",
      "transliteration": "sabahoo bakhaan jeh net net ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਸਾਰੇ ਨੇਤਿ ਨੇਤਿ ਕਹਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "सबहू बखान जिह नेति नेति ॥",
      "sourceLineId": "102221",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਕਲੰਕ ਰੂਪ ਆਭਾ ਅਮੇਤ ॥",
      "transliteration": "akala(n)k roop aabhaa amet ||",
      "translation": "Whom all call “Neti, neti” (not this, not this), the powers of all kinds abide at the feet of that Blemishless and Beauty-incarnate Lord",
      "punjabiViakhya": "(ਉਹ) ਅਮਿਤ ਆਭਾ ਵਾਲਾ ਅਤੇ ਨਿਸ਼ਕਲੰਕ ਰੂਪ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "अकलंक रूप आभा अमेत ॥",
      "sourceLineId": "102222",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਰਬੰ ਸਮ੍ਰਿਧ ਜਿਹ ਪਾਨ ਲਾਗ ॥",
      "transliteration": "saraba(n) samiradh jeh paan laag ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਚਰਨਾ ਨਾਲ ਸਾਰੀਆਂ ਸਮ੍ਰਿਧੀਆਂ ਲਗੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "सरबं समृध जिह पान लाग ॥",
      "sourceLineId": "102223",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਿਹ ਨਾਮ ਲੇਤ ਸਬ ਪਾਪ ਭਾਗ ॥੭੦॥",
      "transliteration": "jeh naam let sab paap bhaag ||70||",
      "translation": "And all the sins fly away with the remembrance of His Name.70.",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਨਾ ਲੈਣ ਨਾਲ ਸਾਰੇ ਪਾਪ ਭਜ ਜਾਦੇ ਹਨ ॥੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "जिह नाम लेत सब पाप भाग ॥७०॥",
      "sourceLineId": "102224",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0640_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗੁਨ ਸੀਲ ਸਾਧੁ ਤਾ ਕੇ ਸੁਭਾਇ ॥",
      "transliteration": "gun seel saadh taa ke subhai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਸੁਭਾ ਗੁਣ, ਸੀਲ ਅਤੇ ਸਾਧੁਤਾ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 640,
      "hindi": "",
      "hindiTransliteration": "गुन सील साधु ता के सुभाइ ॥",
      "sourceLineId": "102225",
      "sourceShabadId": "9331",
