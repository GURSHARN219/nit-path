{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 641,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0641_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੀਨਨ ਉਧਾਰਣਿ ਜਾਸੁ ਬਾਨ ॥",
      "transliteration": "dheenan udhaaran jaas baan ||",
      "translation": "",
      "punjabiViakhya": "ਦੀਨਾ ਦਾ ਉੱਧਾਰ ਕਰਨਾ ਜਿਸ ਦੀ ਆਦਤ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "दीनन उधारणि जासु बान ॥",
      "sourceLineId": "102227",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕੋਊ ਕਹੈ ਕੈਸੇਈ ਲੇਤ ਮਾਨ ॥੭੧॥",
      "transliteration": "kouoo kahai kaiseiee let maan ||71||",
      "translation": "He acts for the redemption of the lowly and if anyone calls Him with any motive, He accepts his saying.7",
      "punjabiViakhya": "ਕੋਈ ਕਿਵੇਾਂ ਹੀ (ਉਸ ਦਾ ਨਾ) ਕਹਿੰਦਾ ਹੈ, (ਉਹ ਉਸੇ ਤਰ੍ਰਹਾ) ਮੰਨ ਲੈਂਦਾ ਹੈ ॥੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "कोऊ कहै कैसेई लेत मान ॥७१॥",
      "sourceLineId": "102228",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਕਲੰਕ ਰੂਪ ਅਨਛਿਜ ਤੇਜ ॥",
      "transliteration": "akala(n)k roop anachhij tej ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਕਲੰਕ ਤੋਂ ਰਹਿਤ ਅਤੇ ਨਾ ਛਿਜੇ ਜਾ ਸਕਣ ਵਾਲੇ ਤੇਜ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "अकलंक रूप अनछिज तेज ॥",
      "sourceLineId": "102229",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਆਸਨ ਅਡੋਲ ਸੁਭ ਸੁਭ੍ਰ ਸੇਜ ॥",
      "transliteration": "aasan addol subh subhr sej ||",
      "translation": "The enemies and friends all are allured to see Him, Who is blemishless, Who is eternally glorious, Who is seated on a stable seat and Who has infinite qualities.72.",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਆਸਨ ਅਡੋਲ ਹੈ ਅਤੇ ਸ਼ੁਭ ਸੁਖਦਾਇਕ ਸੇਜ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "आसन अडोल सुभ सुभ्र सेज ॥",
      "sourceLineId": "102230",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਨਗਨ ਜਾਸੁ ਗੁਨ ਮਧਿ ਸੋਭ ॥",
      "transliteration": "anagan jaas gun madh sobh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਿਚ ਅਣਗਿਣਤ ਗੁਣ ਸ਼ੋਭਾ ਪਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "अनगन जासु गुन मधि सोभ ॥",
      "sourceLineId": "102231",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਲਖਿ ਸਤ੍ਰ ਮਿਤ੍ਰ ਜਿਹ ਰਹਤ ਲੋਭ ॥੭੨॥",
      "transliteration": "lakh satr mitr jeh rahat lobh ||72||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ!) ਵੇਖ ਕੇ ਵੈਰੀ ਅਤੇ ਮਿਤਰ ਲਲਚਾਏ ਰਹਿੰਦੇ ਹਨ ॥੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "लखि सत्र मित्र जिह रहत लोभ ॥७२॥",
      "sourceLineId": "102232",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਿਹ ਸਤ੍ਰ ਮਿਤ੍ਰ ਸਮ ਏਕ ਜਾਨ ॥",
      "transliteration": "jeh satr mitr sam ek jaan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਵੈਰੀ ਅਤੇ ਮਿਤਰ ਨੂੰ ਇਕ ਸਮਾਨ ਸਮਝਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "जिह सत्र मित्र सम एक जान ॥",
      "sourceLineId": "102233",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਉਸਤਤੀ ਨਿੰਦ ਜਿਹ ਏਕ ਮਾਨ ॥",
      "transliteration": "ausatatee ni(n)dh jeh ek maan ||",
      "translation": "He considers enemies and friends alike, and also comprehends the praise and slander alike",
      "punjabiViakhya": "ਅਤੇ ਉਸਤਤ ਤੇ ਨਿੰਦਾ ਨੂੰ ਇਕੋ ਜਿਹਾ ਮੰਨਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "उसतती निंद जिह एक मान ॥",
      "sourceLineId": "102234",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਆਸਨ ਅਡੋਲ ਅਨਛਿਜ ਰੂਪ ॥",
      "transliteration": "aasan addol anachhij roop ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਦਾ) ਆਸਨ ਅਡੋਲ ਹੈ ਅਤੇ ਸਰੂਪ ਅਛਿਜ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "आसन अडोल अनछिज रूप ॥",
      "sourceLineId": "102235",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪਰਮੰ ਪਵਿਤ੍ਰ ਭੂਪਾਣ ਭੂਪ ॥੭੩॥",
      "transliteration": "parama(n) pavitr bhoopaan bhoop ||73||",
      "translation": "He is seated on a stable seat He is supremely Beauty-incranate and also immaculate He is the Sovereign of sovereigns.73.",
      "punjabiViakhya": "(ਉਹ) ਪਰਮ ਪਵਿਤ੍ਰ ਅਤੇ ਰਾਜਿਆਂ ਦਾ ਰਾਜਾ ਹੈ ॥੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "परमं पवित्र भूपाण भूप ॥७३॥",
      "sourceLineId": "102236",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਹਬਾ ਸੁਧਾਨ ਖਗ ਉਧ ਸੋਹਿ ॥",
      "transliteration": "jihabaa sudhaan khag udh soh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਜੀਭ ਅੰਮ੍ਰਿਤ (ਦੇ ਸਮਾਨ ਬੋਲਦੀ ਹੈ) ਤਲਵਾਰ (ਉਸ ਦੇ ਹੱਥ ਵਿਚ) ਉੱਚੀ ਸ਼ੋਭਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "जिहबा सुधान खग उध सोहि ॥",
      "sourceLineId": "102237",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਵਿਲੋਕ ਦਈਤ ਅਰੁ ਦੇਵ ਮੋਹਿ ॥",
      "transliteration": "avilok dhieet ar dhev moh ||",
      "translation": "His tongue showers ambrosia",
      "punjabiViakhya": "ਦੇਵਤੇ ਅਤੇ ਦੈਂਤ ਵੇਖ ਕੇ ਮੋਹਿਤ ਹੁੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "अविलोक दईत अरु देव मोहि ॥",
      "sourceLineId": "102238",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਿਨੁ ਬੈਰ ਰੂਪ ਅਨਭਵ ਪ੍ਰਕਾਸ ॥",
      "transliteration": "bin bair roop anabhav prakaas ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬਿਨਾ ਵੈਰ ਵਾਲਾ ਅਤੇ ਸੁਤਹ ਪ੍ਰਕਾਸ਼ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "बिनु बैर रूप अनभव प्रकास ॥",
      "sourceLineId": "102239",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਨਛਿਜ ਗਾਤ ਨਿਸਿ ਦਿਨ ਨਿਰਾਸ ॥੭੪॥",
      "transliteration": "anachhij gaat nis dhin niraas ||74||",
      "translation": "All the gods and demons are fascinated by Himp He is devoid of enmity and Light-incarnate His body is indestructible and is impartial all the time.74.",
      "punjabiViakhya": "(ਉਹ) ਨਾ ਛਿਜਣ ਵਾਲੇ ਸ਼ਰੀਰ ਵਾਲਾ ਅਤੇ ਰਾਤ ਦਿਨ ਆਸਾ ਤੋਂ ਰਹਿਤ ਹੈ ॥੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "अनछिज गात निसि दिन निरास ॥७४॥",
      "sourceLineId": "102240",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੁਤਿ ਆਦਿ ਅੰਤਿ ਏਕੈ ਸਮਾਨ ॥",
      "transliteration": "dhut aadh a(n)t ekai samaan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਜੋਤਿ ਆਦਿ ਤੋਂ ਅੰਤ ਤਕ ਇਕ ਸਮਾਨ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "दुति आदि अंति एकै समान ॥",
      "sourceLineId": "102241",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਖੜਗੰਨ ਸਪੰਨਿ ਸਬ ਬਿਧਿ ਨਿਧਾਨ ॥",
      "transliteration": "khaRaga(n)n sapa(n)n sab bidh nidhaan ||",
      "translation": "His Glory remains the same in the beginning and at the end and is accomplished with all kinds of powers",
      "punjabiViakhya": "(ਉਹ) ਛੇ ਅੰਗਾ ਨਾਲ ਭਰਪੂਰ ਅਤੇ ਸਾਰੀਆਂ ਵਿਧੀਆਂ ਦਾ ਖ਼ਜ਼ਾਨਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "खड़गंन सपंनि सब बिधि निधान ॥",
      "sourceLineId": "102242",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੋਭਾ ਸੁ ਬਹੁਤ ਤਨ ਜਾਸੁ ਸੋਭ ॥",
      "transliteration": "sobhaa su bahut tan jaas sobh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਤਨ ਦੀ ਸ਼ੋਭਾ ਬਹੁਤ ਸ਼ੋਭਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "सोभा सु बहुत तन जासु सोभ ॥",
      "sourceLineId": "102243",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦੁਤਿ ਦੇਖਿ ਜਛ ਗੰਧ੍ਰਬ ਲੋਭ ॥੭੫॥",
      "transliteration": "dhut dhekh jachh ga(n)dhrab lobh ||75||",
      "translation": "All the beauties are there in his body and seing his comeliness the Yakshas and Gandharvas are allured.75.",
      "punjabiViakhya": "(ਜਿਸ ਦੀ) ਜੋਤਿ ਨੂੰ ਵੇਖ ਕੇ ਯਕਸ਼ ਅਤੇ ਗੰਧਰਬ ਲੋਭਾਇਮਾਨ (ਹੋ ਰਹੇ ਹਨ) ॥੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "दुति देखि जछ गंध्रब लोभ ॥७५॥",
      "sourceLineId": "102244",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਨਭੰਗ ਅੰਗ ਅਨਭਵ ਪ੍ਰਕਾਸ ॥",
      "transliteration": "anabha(n)g a(n)g anabhav prakaas ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਸ਼ਰੀਰ ਭੰਗ ਨਹੀਂ ਹੁੰਦਾ ਅਤੇ ਅਨੁਭਵ ਦੁਆਰਾ ਪ੍ਰਕਾਸ਼ਿਤ (ਸੁਤਹ ਪ੍ਰਕਾਸ਼) ਹੁੰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "अनभंग अंग अनभव प्रकास ॥",
      "sourceLineId": "102245",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪਸਰੀ ਜਗਤਿ ਜਿਹ ਜੀਵ ਰਾਸਿ ॥",
      "transliteration": "pasaree jagat jeh jeev raas ||",
      "translation": "His limbs are indestructible",
      "punjabiViakhya": "ਉਸ ਦੀ ਜਗਤ ਦੇ ਜੀਵਾ ਵਿਚ ਰਾਸ (ਜੋਤਿ) ਪਸਰੀ ਹੋਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "पसरी जगति जिह जीव रासि ॥",
      "sourceLineId": "102246",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਿਨੇ ਸੁ ਜੀਵ ਜਲਿ ਥਲਿ ਅਨੇਕ ॥",
      "transliteration": "kine su jeev jal thal anek ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਜਲ ਥਲ ਵਿਚ ਅਨੇਕ ਜੀਵ ਕੀਤੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "किने सु जीव जलि थलि अनेक ॥",
      "sourceLineId": "102247",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅੰਤਹਿ ਸਮੇਯ ਫੁਨਿ ਰੂਪ ਏਕ ॥੭੬॥",
      "transliteration": "a(n)teh samey fun roop ek ||76||",
      "translation": "That Lord is the manifestation of cognition because of His Grave, the beings are scattered over the whole world He had created many beings in water and on plain and He ultimately merges everyone in His Form.76.",
      "punjabiViakhya": "ਪਰ ਅੰਤ ਵਿਚ (ਉਹ) ਸਭ ਫਿਰ ਇਕ ਰੂਪ ਹੀ ਹਨ ॥੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "अंतहि समेय फुनि रूप एक ॥७६॥",
      "sourceLineId": "102248",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਿਹ ਛੂਆ ਨੈਕੁ ਨਹੀ ਕਾਲ ਜਾਲੁ ॥",
      "transliteration": "jeh chhooaa naik nahee kaal jaal ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਕਾਲ ਦੇ ਜਾਲ ਨੇ ਜ਼ਰਾ ਜਿੰਨਾ ਵੀ ਛੋਹਿਆ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "जिह छूआ नैकु नही काल जालु ॥",
      "sourceLineId": "102249",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਛ੍ਵੈ ਸਕਾ ਪਾਪ ਨਹੀ ਕਉਨ ਕਾਲ ॥",
      "transliteration": "chhavai sakaa paap nahee kaun kaal ||",
      "translation": "The death and sin have not been able to touch Him at any time",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਪਾਪ ਕਿਸੇ ਸਮੇਾਂ ਵੀ ਛੋਹ ਨਹੀਂ ਸਕਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "छ्वै सका पाप नही कउन काल ॥",
      "sourceLineId": "102250",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਛਿਜ ਤੇਜ ਅਨਭੂਤ ਗਾਤ ॥",
      "transliteration": "aachhij tej anabhoot gaat ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਦਾ) ਤੇਜ ਅਣਛਿਜ ਰੂਪ ਵਾਲਾ ਹੈ ਅਤੇ ਤੱਤ੍ਵ-ਰਹਿਤ ਸ਼ਰੀਰ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "आछिज तेज अनभूत गात ॥",
      "sourceLineId": "102251",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਏਕੈ ਸਰੂਪ ਨਿਸ ਦਿਨ ਪ੍ਰਭਾਤ ॥੭੭॥",
      "transliteration": "ekai saroop nis dhin prabhaat ||77||",
      "translation": "The Lord of that indestructible Lustre and body remains the same at all times.77.",
      "punjabiViakhya": "(ਉਹ) ਰਾਤ, ਦਿਨ ਅਤੇ ਪ੍ਰਭਾਤ ਵੇਲੇ ਇਕ ਸਮਾਨ ਰੂਪ ਵਾਲਾ ਹੈ ॥੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "एकै सरूप निस दिन प्रभात ॥७७॥",
      "sourceLineId": "102252",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਦਤ ਅਸਤੋਤ੍ਰ ਪਾਠ ॥",
      "transliteration": "eeh bhaat dhat asatotr paaTh ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਸਤੋਤਰ ਪਾਠ ਦੱਤ ਨੇ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "इह भाति दत असतोत्र पाठ ॥",
      "sourceLineId": "102253",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮੁਖ ਪੜਤ ਅਛ੍ਰ ਗਯੋ ਪਾਪ ਨਾਠ ॥",
      "transliteration": "mukh paRat achhr gayo paap naaTh ||",
      "translation": "In this way, Dutt recited the eulogy and by this recitation, all the sins fled away",
      "punjabiViakhya": "(ਇਸ ਦੇ) ਅੱਖਰਾ ਨੂੰ ਪੜ੍ਰਹਦਿਆਂ ਪਾਪ ਨਸ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "मुख पड़त अछ्र गयो पाप नाठ ॥",
      "sourceLineId": "102254",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕੋ ਸਕੈ ਬਰਨ ਮਹਿਮਾ ਅਪਾਰ ॥",
      "transliteration": "ko sakai baran mahimaa apaar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਅਪਾਰ ਮਹਿਮਾ ਦਾ ਕੌਣ ਵਰਣਨ ਕਰ ਸਕਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "को सकै बरन महिमा अपार ॥",
      "sourceLineId": "102255",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੰਛੇਪ ਕੀਨ ਤਾ ਤੇ ਉਚਾਰ ॥੭੮॥",
      "transliteration": "sa(n)chhep keen taa te uchaar ||78||",
      "translation": "Who can describe his infinite greatness?, therefore I have said it in brief.78.",
      "punjabiViakhya": "ਇਸ ਲਈ ਸੰਖੇਪ ਵਿਚ ਹੀ ਵਰਣਨ ਕੀਤਾ ਹੈ ॥੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "संछेप कीन ता ते उचार ॥७८॥",
      "sourceLineId": "102256",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜੇ ਕਰੈ ਪਤ੍ਰ ਕਾਸਿਪੀ ਸਰਬ ॥",
      "transliteration": "je karai patr kaasipee sarab ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਸਾਰੀ ਧਰਤੀ ('ਕਾਸਿਪੀ') ਨੂੰ ਪੱਤਰ (ਕਾਗਜ਼) ਕਰ ਲਈਏ",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "जे करै पत्र कासिपी सरब ॥",
      "sourceLineId": "102257",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਲਿਖੇ ਗਣੇਸ ਕਰਿ ਕੈ ਸੁ ਗਰਬ ॥",
      "transliteration": "likhe ganes kar kai su garab ||",
      "translation": "If the whole earth becomes the paper and Ganesha is the proud writer",
      "punjabiViakhya": "ਅਤੇ ਹੰਕਾਰ ਕਰ ਕੇ ਗਣੇਸ਼ ਲਿਖਣ ਬੈਠੇ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "लिखे गणेस करि कै सु गरब ॥",
      "sourceLineId": "102258",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਸੁ ਸਰਬ ਸਿੰਧ ਲੇਖਕ ਬਨੇਸਿ ॥",
      "transliteration": "mas sarab si(n)dh lekhak banes ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਸਮੁੰਦਰ ਸਿਆਹੀ ਅਤੇ ਸਾਰੇ ਬਨ ਕਲਮਾ ਬਣ ਜਾਣ,",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "मसु सरब सिंध लेखक बनेसि ॥",
      "sourceLineId": "102259",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਹੀ ਤਦਿਪ ਅੰਤਿ ਕਹਿ ਸਕੈ ਸੇਸੁ ॥੭੯॥",
      "transliteration": "nahee tadhip a(n)t keh sakai ses ||79||",
      "translation": "All the oceans become the ink and all the forests become the pens and Sheshnaga makes a description of the Lord from his thousand mouths, then also he mystery of the Lord cannot be comprehended.79.",
      "punjabiViakhya": "ਤਦ ਵੀ ਸ਼ੇਸ਼ ਨਾਗ ਉਸ ਦਾ ਅੰਤ ਨਹੀਂ ਕਹਿ ਸਕਦਾ ॥੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "नही तदिप अंति कहि सकै सेसु ॥७९॥",
      "sourceLineId": "102260",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਉ ਕਰੈ ਬੈਠਿ ਬ੍ਰਹਮਾ ਉਚਾਰ ॥",
      "transliteration": "jau karai baiTh brahamaa uchaar ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਕਰ ਬ੍ਰਹਮਾ ਬੈਠ ਕੇ (ਉਸਤਤ ਦਾ) ਉਚਾਰਨ ਕਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "जउ करै बैठि ब्रहमा उचार ॥",
      "sourceLineId": "102261",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਹੀ ਤਦਿਪ ਤੇਜ ਪਾਯੰਤ ਪਾਰ ॥",
      "transliteration": "nahee tadhip tej paaya(n)t paar ||",
      "translation": "If Brahma also utters His Glory, then also His effulgence cannot be comprehended",
      "punjabiViakhya": "ਤਦ ਵੀ ਤੇਜ ਦਾ ਅੰਤ ਨਹੀਂ ਪਾ ਸਕੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "नही तदिप तेज पायंत पार ॥",
      "sourceLineId": "102262",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮੁਖ ਸਹੰਸ ਨਾਮ ਫਣ ਪਤਿ ਰੜੰਤ ॥",
      "transliteration": "mukh saha(n)s naam fan pat raRa(n)t ||",
      "translation": "",
      "punjabiViakhya": "(ਜੇ) ਹਜ਼ਾਰਾ ਮੂੰਹਾ ਵਾਲਾ ਸ਼ੇਸ਼ਨਾਗ ਬੋਲਦਾ ਰਹੇ,",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "मुख सहंस नाम फण पति रड़ंत ॥",
      "sourceLineId": "102263",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਹੀ ਤਦਿਪ ਤਾਸੁ ਪਾਯੰਤ ਅੰਤੁ ॥੮੦॥",
      "transliteration": "nahee tadhip taas paaya(n)t a(n)t ||80||",
      "translation": "If Sheshnaga also utters His Names from his thousand mouths, then also His end cannot be known.80.",
      "punjabiViakhya": "ਤਾ ਵੀ ਉਸ ਦਾ ਅੰਤ ਨਹੀਂ ਪਾ ਸਕਦਾ ॥੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "नही तदिप तासु पायंत अंतु ॥८०॥",
      "sourceLineId": "102264",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਿਸ ਦਿਨ ਜਪੰਤ ਸਨਕੰ ਸਨਾਤ ॥",
      "transliteration": "nis dhin japa(n)t sanaka(n) sanaat ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਸਨਕ ਅਤੇ ਸਨਾਤਨ ਰਾਤ ਦਿਨ ਜਪਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "निस दिन जपंत सनकं सनात ॥",
      "sourceLineId": "102265",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਹੀ ਤਦਿਪ ਤਾਸੁ ਸੋਭਾ ਨਿਰਾਤ ॥",
      "transliteration": "nahee tadhip taas sobhaa niraat ||",
      "translation": "If Sanak, Sunandan etc. remember Him continuously night and day, then also Hi Glory cannot be described",
      "punjabiViakhya": "ਤਾ ਵੀ ਉਸ ਦੀ ਸ਼ੋਭਾ ਸਪਸ਼ਟ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "नही तदिप तासु सोभा निरात ॥",
      "sourceLineId": "102266",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮੁਖ ਚਾਰ ਬੇਦ ਕਿਨੇ ਉਚਾਰ ॥",
      "transliteration": "mukh chaar bedh kine uchaar ||",
      "translation": "",
      "punjabiViakhya": "ਚਾਰ ਮੂੰਹਾ ਵਾਲੇ ਬ੍ਰਹਮਾ ਨੇ ਵੇਦਾ ਦਾ ਉਚਾਰਨ ਕੀਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "मुख चार बेद किने उचार ॥",
      "sourceLineId": "102267",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਜਿ ਗਰਬ ਨੇਤਿ ਨੇਤੈ ਬਿਚਾਰ ॥੮੧॥",
      "transliteration": "taj garab net netai bichaar ||81||",
      "translation": "Brahma crated all the four Vedas, but on reflecting about Him, he also talks of Him as “Neti, Neti” (no this, not this.)81.",
      "punjabiViakhya": "(ਪਰ ਫਿਰ ਵੀ) ਹੰਕਾਰ ਨੂੰ ਛਡ ਕੇ ਨੇਤਿ ਨੇਤਿ ਵਿਚਾਰਨ ਲਗਾ ਹੈ ॥੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "तजि गरब नेति नेतै बिचार ॥८१॥",
      "sourceLineId": "102268",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਿਵ ਸਹੰਸ੍ਰ ਬਰਖ ਲੌ ਜੋਗ ਕੀਨ ॥",
      "transliteration": "siv saha(n)sr barakh lau jog keen ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਨੇ ਹਜ਼ਾਰਾ ਸਾਲ ਯੋਗ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "सिव सहंस्र बरख लौ जोग कीन ॥",
      "sourceLineId": "102269",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਜਿ ਨੇਹ ਗੇਹ ਬਨ ਬਾਸ ਲੀਨ ॥",
      "transliteration": "taj neh geh ban baas leen ||",
      "translation": "Shiva practiced Yoga for thousands of years",
      "punjabiViakhya": "ਅਤੇ ਘਰ ਦਾ ਮੋਹ ਛਡ ਕੇ ਬਨਵਾਸ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "तजि नेह गेह बन बास लीन ॥",
      "sourceLineId": "102270",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਹੁ ਕੀਨ ਜੋਗ ਤਹ ਬਹੁ ਪ੍ਰਕਾਰ ॥",
      "transliteration": "bahu keen jog teh bahu prakaar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਬਹੁਤ ਤਰ੍ਰਹਾ ਬਹੁਤ ਯੋਗ ਕੀਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 641,
      "hindi": "",
      "hindiTransliteration": "बहु कीन जोग तह बहु प्रकार ॥",
      "sourceLineId": "102271",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0641_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਹੀ ਤਦਿਪ ਤਾਸੁ ਲਹਿ ਸਕਾ ਪਾਰ ॥੮੨॥",
      "transliteration": "nahee tadhip taas leh sakaa paar ||82||",
      "translation": "He left his home and all attachment and resided in the forest he also practiced Yoga in various ways, but still he could not know His end.82.",
      "punjabiViakhya": "ਪਰ ਤਾ ਵੀ ਉਸ ਦਾ ਪਾਰ ਨਹੀਂ ਪਾ ਸਕਿਆ ॥੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 641,
