{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 642,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0642_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਸਨ ਅਡੋਲ ਮਹਿਮਾ ਅਭੰਗ ॥",
      "transliteration": "aasan addol mahimaa abha(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਆਸਣ ਅਡੋਲ ਹੈ ਅਤੇ ਨਾ ਭੰਗ ਹੋਣ ਵਾਲੀ ਮਹਿਮਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "आसन अडोल महिमा अभंग ॥",
      "sourceLineId": "102275",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਨਭਵ ਪ੍ਰਕਾਸ ਸੋਭਾ ਸੁਰੰਗ ॥੮੩॥",
      "transliteration": "anabhav prakaas sobhaa sura(n)g ||83||",
      "translation": "His seat is permanent and He is praiseworthy, Lustrous and Glorrious.83.",
      "punjabiViakhya": "(ਉਹ) ਅਨੁਭਵ ਦੁਆਰਾ ਪ੍ਰਕਾਸ਼ਿਤ ਹੁੰਦਾ ਹੈ ਅਤੇ ਉਸ ਦੀ ਬਹੁਤ ਸੁੰਦਰ ਸ਼ੋਭਾ ਹੈ ॥੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "अनभव प्रकास सोभा सुरंग ॥८३॥",
      "sourceLineId": "102276",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਿਹ ਸਤ੍ਰੁ ਮਿਤ੍ਰ ਏਕੈ ਸਮਾਨ ॥",
      "transliteration": "jeh satr mitr ekai samaan ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਲਈ ਵੈਰੀ ਅਤੇ ਮਿਤਰ ਇਕ ਸਮਾਨ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "जिह सत्रु मित्र एकै समान ॥",
      "sourceLineId": "102277",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਬਿਯਕਤ ਤੇਜ ਮਹਿਮਾ ਮਹਾਨ ॥",
      "transliteration": "abiyakat tej mahimaa mahaan ||",
      "translation": "The enemies and friends are alike for Him and His invisible Lustre and Praise are Supreme",
      "punjabiViakhya": "(ਜਿਸ ਦਾ) ਤੇਜ ਪ੍ਰਗਟ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ ਅਤੇ (ਜਿਸ ਦੀ) ਮਹਿਮਾ ਮਹਾਨ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "अबियकत तेज महिमा महान ॥",
      "sourceLineId": "102278",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਿਹ ਆਦਿ ਅੰਤਿ ਏਕੈ ਸਰੂਪ ॥",
      "transliteration": "jeh aadh a(n)t ekai saroop ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਆਦਿ ਤੋਂ ਅੰਤ ਤਕ ਇਕੋ ਹੀ ਸਰੂਪ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "जिह आदि अंति एकै सरूप ॥",
      "sourceLineId": "102279",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੁੰਦਰ ਸੁਰੰਗ ਜਗ ਕਰਿ ਅਰੂਪ ॥੮੪॥",
      "transliteration": "su(n)dhar sura(n)g jag kar aroop ||84||",
      "translation": "He has the same form in the beginning and at the end and He is the Creator of this fascinating world.84.",
      "punjabiViakhya": "(ਉਸ) ਸੁੰਦਰ ਸਰੂਪ ਵਾਲੇ ਨੇ ਅਨੂਪਮ ਜਗਤ ਦੀ ਰਚਨਾ ਕੀਤੀ ਹੈ ॥੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "सुँदर सुरंग जग करि अरूप ॥८४॥",
      "sourceLineId": "102280",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਿਹ ਰਾਗ ਰੰਗ ਨਹੀ ਰੂਪ ਰੇਖ ॥",
      "transliteration": "jeh raag ra(n)g nahee roop rekh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਕੋਈ ਰਾਗ, ਰੰਗ, ਰੂਪ ਅਤੇ ਰੇਖਾ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "जिह राग रंग नही रूप रेख ॥",
      "sourceLineId": "102281",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਹੀ ਨਾਮ ਠਾਮ ਅਨਭਵ ਅਭੇਖ ॥",
      "transliteration": "nahee naam Thaam anabhav abhekh ||",
      "translation": "He has no form or line, no attachment or detachment",
      "punjabiViakhya": "(ਜਿਸ ਦਾ) ਕੋਈ ਨਾ ਅਤੇ ਥਾ ਨਹੀਂ ਹੈ ਅਤੇ ਜੋ ਸੁਤਹ ਪ੍ਰਮਾਣ ਅਤੇ ਭੇਖ ਰਹਿਤ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "नही नाम ठाम अनभव अभेख ॥",
      "sourceLineId": "102282",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਆਜਾਨ ਬਾਹਿ ਅਨਭਵ ਪ੍ਰਕਾਸ ॥",
      "transliteration": "aajaan baeh anabhav prakaas ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਗੋਡਿਆਂ ਤਕ ਲੰਬੀਆਂ ਬਾਹਵਾ ਵਾਲਾ ਹੈ ਅਤੇ ਅਨੁਭਵ ਦੁਆਰਾ ਪ੍ਰਕਾਸ਼ਿਤ ਹੁੰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "आजान बाहि अनभव प्रकास ॥",
      "sourceLineId": "102283",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਆਭਾ ਅਨੰਤ ਮਹਿਮਾ ਸੁ ਬਾਸ ॥੮੫॥",
      "transliteration": "aabhaa ana(n)t mahimaa su baas ||85||",
      "translation": "That Guiseless Lord had no special Name or Place that Long-armed and omnipotent Lord is the manifestation of cognition and His Comeliness and Greatness are infinite.85.",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਆਭਾ ਅਨੰਤ ਹੈ ਅਤੇ ਮਹਿਮਾ ਦੀ ਸੁੰਦਰ ਸੁਗੰਧ ਹੈ ॥੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "आभा अनंत महिमा सु बास ॥८५॥",
      "sourceLineId": "102284",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਈ ਕਲਪ ਜੋਗ ਜਿਨਿ ਕਰਤ ਬੀਤ ॥",
      "transliteration": "kiee kalap jog jin karat beet ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੂੰ ਯੋਗ ਸਾਧਨਾ ਕਰਦਿਆਂ ਕਈ ਕਲਪ (ਯੁਗ) ਬੀਤ ਗਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "कई कलप जोग जिनि करत बीत ॥",
      "sourceLineId": "102285",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਹੀ ਤਦਿਪ ਤਉਨ ਧਰਿ ਗਏ ਚੀਤ ॥",
      "transliteration": "nahee tadhip taun dhar ge cheet ||",
      "translation": "Even those who practiced Yoga for various Kalpas (ages) ccouldnot please His mind",
      "punjabiViakhya": "ਪਰ ਤਾ ਵੀ ਉਹ ਉਨ੍ਰਹਾ ਦੇ ਚਿਤ ਵਿਚ ਟਿਕਿਆ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "नही तदिप तउन धरि गए चीत ॥",
      "sourceLineId": "102286",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮੁਨਿ ਮਨ ਅਨੇਕ ਗੁਨਿ ਗਨ ਮਹਾਨ ॥",
      "transliteration": "mun man anek gun gan mahaan ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੇਕ ਮੁਨੀਆਂ ਨੇ ਮਨ ਵਿਚ ਮਹਾਨ ਗੁਣਾ ਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "मुनि मन अनेक गुनि गन महान ॥",
      "sourceLineId": "102287",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਹੁ ਕਸਟ ਕਰਤ ਨਹੀ ਧਰਤ ਧਿਆਨ ॥੮੬॥",
      "transliteration": "bahu kasaT karat nahee dharat dhiaan ||86||",
      "translation": "Many sags and virtuous people remember Him by the performance of many agonizing austerities, but that Lord does not even think of them.86.",
      "punjabiViakhya": "ਪੁੰਜ ਦਾ ਧਿਆਨ ਕਰਦਿਆਂ ਬਹੁਤ ਕਸ਼ਟ ਸਹੇ, ਪਰ (ਫਿਰ ਵੀ) ਧਿਆਨ ਵਿਚ ਨਹੀਂ ਧਾਰਿਆ ਜਾ ਸਕਿਆ ॥੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "बहु कसट करत नही धरत धिआन ॥८६॥",
      "sourceLineId": "102288",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਿਹ ਏਕ ਰੂਪ ਕਿਨੇ ਅਨੇਕ ॥",
      "transliteration": "jeh ek roop kine anek ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਇਕ ਰੂਪ ਤੋਂ ਅਨੇਕ ਰੂਪ ਕੀਤੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "जिह एक रूप किने अनेक ॥",
      "sourceLineId": "102289",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅੰਤਹਿ ਸਮੇਯ ਫੁਨਿ ਭਏ ਏਕ ॥",
      "transliteration": "a(n)teh samey fun bhe ek ||",
      "translation": "He is the only One, and creates many and ultimately merges the many created forms in His oneness",
      "punjabiViakhya": "ਅਤੇ ਅੰਤ ਵੇਲੇ ਜੋ ਫਿਰ ਇਕ ਰੂਪ ਹੋ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "अंतहि समेय फुनि भए एक ॥",
      "sourceLineId": "102290",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਜੰਤ ਜੀਵਨ ਉਪਾਇ ॥",
      "transliteration": "kiee koT ja(n)t jeevan upai ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੇ) ਕਈ ਕਰੋੜ ਜੀਵ ਜੰਤ ਪੈਦਾ ਕੀਤੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "कई कोटि जंत जीवन उपाइ ॥",
      "sourceLineId": "102291",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਫਿਰਿ ਅੰਤ ਲੇਤ ਆਪਹਿ ਮਿਲਾਇ ॥੮੭॥",
      "transliteration": "fir a(n)t let aapeh milai ||87||",
      "translation": "He is the life-force of millions of beings and ultimately He merges all within Him.87.",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਅੰਤ ਵਿਚ ਆਪਣੇ ਵਿਚ ਮਿਲਾ ਲੈਂਦਾ ਹੈ ॥੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "फिरि अंत लेत आपहि मिलाइ ॥८७॥",
      "sourceLineId": "102292",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਿਹ ਜਗਤ ਜੀਵ ਸਬ ਪਰੇ ਸਰਨਿ ॥",
      "transliteration": "jeh jagat jeev sab pare saran ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਸ਼ਰਨ ਵਿਚ ਸਾਰੇ ਜਗਤ ਦੇ ਜੀਵ ਪਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "जिह जगत जीव सब परे सरनि ॥",
      "sourceLineId": "102293",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮੁਨ ਮਨਿ ਅਨੇਕ ਜਿਹ ਜਪਤ ਚਰਨ ॥",
      "transliteration": "mun man anek jeh japat charan ||",
      "translation": "All the beings of the world are under His shelter and many sages meditate on His feet",
      "punjabiViakhya": "ਅਤੇ ਜਿਸ ਦੇ ਚਰਨ ਅਨੇਕ ਮੁਨੀ ਮਨ ਵਿਚ ਜਪ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "मुन मनि अनेक जिह जपत चरन ॥",
      "sourceLineId": "102294",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਈ ਕਲਪ ਤਿਹੰ ਕਰਤ ਧਿਆਨ ॥",
      "transliteration": "kiee kalap tiha(n) karat dhiaan ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਧਿਆਨ ਧਰਦਿਆਂ ਕਈ ਕਲਪ (ਯੁਗ) ਬੀਤ ਗਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "कई कलप तिहं करत धिआन ॥",
      "sourceLineId": "102295",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਹੂੰ ਨ ਦੇਖਿ ਤਿਹ ਬਿਦਿਮਾਨ ॥੮੮॥",
      "transliteration": "kahoo(n) na dhekh teh bidhimaan ||88||",
      "translation": "That all-pervading Lord does not even scan those who mediate on Him fore many kalpas (ages).88.",
      "punjabiViakhya": "ਪਰ ਉਸ ਨੂੰ ਕਿਸੇ ਨੇ ਵੀ ਕਿਤੇ ਵਿਦਮਾਨ ਨਹੀਂ ਵੇਖਿਆ ॥੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "कहूँ न देखि तिह बिदिमान ॥८८॥",
      "sourceLineId": "102296",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਆਭਾ ਅਨੰਤ ਮਹਿਮਾ ਅਪਾਰ ॥",
      "transliteration": "aabhaa ana(n)t mahimaa apaar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਆਭਾ ਅਨੰਤ ਹੈ ਅਤੇ ਮਹਿਮਾ ਅਪਾਰ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "आभा अनंत महिमा अपार ॥",
      "sourceLineId": "102297",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮੁਨ ਮਨਿ ਮਹਾਨ ਅਤ ਹੀ ਉਦਾਰ ॥",
      "transliteration": "mun man mahaan at hee udhaar ||",
      "translation": "His Greatness and Glory are infinite",
      "punjabiViakhya": "(ਉਹ) ਅਤਿਅੰਤ ਉਦਾਰ ਅਤੇ ਮੁਨੀਆਂ ਦੇ ਮਨ (ਵਿਚ ਵਸਣ ਵਾਲਾ) ਮਹਾਨ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "मुन मनि महान अत ही उदार ॥",
      "sourceLineId": "102298",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਛਿਜ ਤੇਜ ਸੂਰਤਿ ਅਪਾਰ ॥",
      "transliteration": "aachhij tej soorat apaar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਤੇਜ ਅਣਛਿਜ ਹੈ ਅਤੇ ਸੂਰਵੀਰਤਾ ਅਪਾਰ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "आछिज तेज सूरति अपार ॥",
      "sourceLineId": "102299",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਹੀ ਸਕਤ ਬੁਧ ਕਰਿ ਕੈ ਬਿਚਾਰ ॥੮੯॥",
      "transliteration": "nahee sakat budh kar kai bichaar ||89||",
      "translation": "He is the Greatest amongst the sages and is extremely Generous His effulgence is eternal and form Most Beautiful the human intellect cannot reflect on Him.89.",
      "punjabiViakhya": "ਬੁੱਧੀ (ਉਸ ਦਾ) ਵਿਚਾਰ ਨਹੀਂ ਕਰ ਸਕਦੀ ॥੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "नही सकत बुध करि कै बिचार ॥८९॥",
      "sourceLineId": "102300",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਿਹ ਆਦਿ ਅੰਤਿ ਏਕਹਿ ਸਰੂਪ ॥",
      "transliteration": "jeh aadh a(n)t ekeh saroop ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਆਦਿ ਤੋਂ ਅੰਤ ਤਕ ਇਕੋ ਜਿਹਾ ਸਰੂਪ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "जिह आदि अंति एकहि सरूप ॥",
      "sourceLineId": "102301",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੋਭਾ ਅਭੰਗ ਮਹਿਮਾ ਅਨੂਪ ॥",
      "transliteration": "sobhaa abha(n)g mahimaa anoop ||",
      "translation": "He, the Lord of Unique Greatness and Glory, remains the same in the beginning and at the end",
      "punjabiViakhya": "(ਜਿਸ ਦੀ) ਸ਼ੋਭਾ ਭੰਗ ਹੋਣ ਵਾਲੀ ਨਹੀਂ ਅਤੇ ਜਿਸ ਦੀ ਮਹਿਮਾ ਅਨੂਪਮ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "सोभा अभंग महिमा अनूप ॥",
      "sourceLineId": "102302",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਿਹ ਕੀਨ ਜੋਤਿ ਉਦੋਤ ਸਰਬ ॥",
      "transliteration": "jeh keen jot udhot sarab ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਸਾਰੀਆਂ ਜੋਤਾ ਨੂੰ ਪ੍ਰਗਟ ਕੀਤਾ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "जिह कीन जोति उदोत सरब ॥",
      "sourceLineId": "102303",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਿਹ ਹਤ੍ਰਯੋ ਸਰਬ ਗਰਬੀਨ ਗਰਬ ॥੯੦॥",
      "transliteration": "jeh hatrayo sarab garabeen garab ||90||",
      "translation": "He, who has instilled His Light in all the beings, He has also smashed the pride of the egoists.90.",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਸਾਰਿਆਂ ਹੰਕਾਰੀਆਂ ਦਾ ਗਰਬ ਨਸ਼ਟ ਕੀਤਾ ਹੋਇਆ ਹੈ ॥੯੦॥",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "जिह हत्रयो सरब गरबीन गरब ॥९०॥",
      "sourceLineId": "102304",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਿਹ ਗਰਬਵੰਤ ਏਕੈ ਨ ਰਾਖ ॥",
      "transliteration": "jeh garabava(n)t ekai na raakh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਇਕ ਵੀ ਹੰਕਾਰੀ ਨਹੀਂ ਰਹਿਣ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "जिह गरबवंत एकै न राख ॥",
      "sourceLineId": "102305",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਫਿਰਿ ਕਹੋ ਬੈਣ ਨਹੀ ਬੈਣ ਭਾਖ ॥",
      "transliteration": "fir kaho bain nahee bain bhaakh ||",
      "translation": "He, who has not left untouched even one egoist, He cannot be described in words",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਕਦੇ ਬਚਨ ਕਹਿ ਕੇ ਫਿਰ ਬਚਨ ਨਹੀਂ ਕਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "फिरि कहो बैण नही बैण भाख ॥",
      "sourceLineId": "102306",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਇਕ ਬਾਰ ਮਾਰਿ ਮਾਰ੍ਯੋ ਨ ਸਤ੍ਰੁ ॥",
      "transliteration": "eik baar maar maarayo na satr ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਵੈਰੀ ਨੂੰ ਇਕ ਵਾਰ ਮਾਰ ਕੇ ਫਿਰ ਨਹੀਂ ਮਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "इक बार मारि मार्यो न सत्रु ॥",
      "sourceLineId": "102307",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਇਕ ਬਾਰ ਡਾਰਿ ਡਾਰਿਓ ਨ ਅਤ੍ਰ ॥੯੧॥",
      "transliteration": "eik baar ddaar ddaario na atr ||91||",
      "translation": "He kills the enemy with a single blow.91.",
      "punjabiViakhya": "(ਜਿਸ ਨੇ) ਇਕ ਵਾਰ ਤੀਰ ('ਅਤ੍ਰ') ਛਡਿਆ, ਫਿਰ ਨਹੀਂ ਛਡਿਆ ॥੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "इक बार डारि डारिओ न अत्र ॥९१॥",
      "sourceLineId": "102308",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੇਵਕ ਥਾਪਿ ਨਹੀ ਦੂਰ ਕੀਨ ॥",
      "transliteration": "sevak thaap nahee dhoor keen ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸੇਵਕਾ ਨੂੰ ਥਾਪ ਕੇ (ਫਿਰ) ਦੂਰ ਨਹੀਂ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "सेवक थापि नही दूर कीन ॥",
      "sourceLineId": "102309",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਲਖਿ ਭਈ ਭੂਲ ਮੁਖਿ ਬਿਹਸ ਦੀਨ ॥",
      "transliteration": "lakh bhiee bhool mukh bihas dheen ||",
      "translation": "He never keep His devotees away from Him and just smiles even on his erratic doings",
      "punjabiViakhya": "(ਜੇ ਉਸ ਦੀ) ਭੁਲ ਵੇਖ ਲਈ ਤਾ ਮੂੰਹ ਤੋਂ ਹਸ ਕੇ (ਬਖ਼ਸ਼) ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "लखि भई भूल मुखि बिहस दीन ॥",
      "sourceLineId": "102310",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਹ ਗਹੀ ਬਾਹਿਾਂ ਕਿਨੋ ਨਿਬਾਹ ॥",
      "transliteration": "jeh gahee baahiaa(n) kino nibaeh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਬਾਹ ਪਕੜੀ, ਉਸ ਨੂੰ (ਅੰਤ ਤਕ) ਨਿਭਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "जिह गही बाहिाँ किनो निबाह ॥",
      "sourceLineId": "102311",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤ੍ਰੀਯਾ ਏਕ ਬ੍ਯਾਹਿ ਨਹੀ ਕੀਨ ਬ੍ਯਾਹ ॥੯੨॥",
      "transliteration": "treeyaa ek bayaeh nahee keen bayaeh ||92||",
      "translation": "He, who comes under His Grace, his objectives are fulfilled by Him ultimately through He has not married, even then maya is His spouse.92.",
      "punjabiViakhya": "ਇਕ ਇਸਤਰੀ ਵਿਆਹੀ, ਤਾ (ਫਿਰ ਦੂਜਾ) ਵਿਆਹ ਨਹੀਂ ਕੀਤਾ ॥੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "त्रीया एक ब्याहि नही कीन ब्याह ॥९२॥",
      "sourceLineId": "102312",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰੀਝੰਤ ਕੋਟਿ ਨਹੀ ਕਸਟ ਕੀਨ ॥",
      "transliteration": "reejha(n)t koT nahee kasaT keen ||",
      "translation": "",
      "punjabiViakhya": "ਕਰੋੜਾ ਕਸ਼ਟਾ (ਤਪਾ) ਦੇ ਕਰਨ ਨਾਲ ਵੀ ਨਹੀਂ ਰੀਝਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "रीझंत कोटि नही कसट कीन ॥",
      "sourceLineId": "102313",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੀਝੰਤ ਏਕ ਹੀ ਨਾਮ ਲੀਨ ॥",
      "transliteration": "seejha(n)t ek hee naam leen ||",
      "translation": "Millions are getting pleased with Him and some are getting pleased only by remembering His name",
      "punjabiViakhya": "ਪਰ ਇਕ ਨਾਮ ਲੈਣ ਨਾਲ ਹੀ ਮੁਕਤੀ ('ਸੀਝੰਤ') ਹੋ ਜਾਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "सीझंत एक ही नाम लीन ॥",
      "sourceLineId": "102314",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਨਕਪਟ ਰੂਪ ਅਨਭਉ ਪ੍ਰਕਾਸ ॥",
      "transliteration": "anakapaT roop anabhau prakaas ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਕਪਟ ਰਹਿਤ ਰੂਪ ਵਾਲਾ ਹੈ ਅਤੇ ਅਨੁਭਵ ਦੁਆਰਾ ਪ੍ਰਕਾਸ਼ਿਤ ਹੁੰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "अनकपट रूप अनभउ प्रकास ॥",
      "sourceLineId": "102315",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਖੜਗਨ ਸਪੰਨਿ ਨਿਸ ਦਿਨ ਨਿਰਾਸ ॥੯੩॥",
      "transliteration": "khaRagan sapa(n)n nis dhin niraas ||93||",
      "translation": "He is devoid of deceit and is the manifestation o of cognition He is Omnipotent and ever remains without desires.93.",
      "punjabiViakhya": "(ਉਹ) ਛੇ ਗੁਣਾ ਨਾਲ ਪਰਿਪੂਰਣ ਹੈ ਅਤੇ ਰਾਤ ਦਿਨ ਆਸਾ ਤੋਂ ਮੁਕਤ ਰਹਿੰਦਾ ਹੈ ॥੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "खड़गन सपंनि निस दिन निरास ॥९३॥",
      "sourceLineId": "102316",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪਰਮੰ ਪਵਿਤ੍ਰ ਪੂਰਣ ਪੁਰਾਣ ॥",
      "transliteration": "parama(n) pavitr pooran puraan ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਪਰਮ ਪਵਿਤ੍ਰ ਅਤੇ ਪੂਰੀ ਤਰ੍ਰਹਾ ਪੁਰਾਣ (ਪੁਰਸ਼) ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "परमं पवित्र पूरण पुराण ॥",
      "sourceLineId": "102317",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮਹਿਮਾ ਅਭੰਗ ਸੋਭਾ ਨਿਧਾਨ ॥",
      "transliteration": "mahimaa abha(n)g sobhaa nidhaan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਮਹਿਮਾ ਅਭੰਗ ਹੈ ਅਤੇ ਸ਼ੋਭਾ ਦਾ ਖ਼ਜ਼ਾਨਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "महिमा अभंग सोभा निधान ॥",
      "sourceLineId": "102318",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪਾਵਨ ਪ੍ਰਸਿਧ ਪਰਮੰ ਪੁਨੀਤ ॥",
      "transliteration": "paavan prasidh parama(n) puneet ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਪਵਿਤ੍ਰ, ਪ੍ਰਸਿੱਧ ਅਤੇ ਪਰਮ ਪੁਨੀਤ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "पावन प्रसिध परमं पुनीत ॥",
      "sourceLineId": "102319",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਆਜਾਨ ਬਾਹੁ ਅਨਭੈ ਅਜੀਤ ॥੯੪॥",
      "transliteration": "aajaan baahu anabhai ajeet ||94||",
      "translation": "He is Immaculate, Perfect, Store of Eternal Glory, Indestructible, Praiseworthy, Holy Illustrious, Omnipotent, Fearless and Unconquerable.94.",
      "punjabiViakhya": "(ਉਸ ਦੀਆਂ) ਬਾਹਵਾ ਗੋਡਿਆਂ ਤਕ ਲੰਬੀਆਂ ਹਨ, ਭੈ ਰਹਿਤ ਹੈ ਅਤੇ ਜਿਤਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ ॥੯੪॥",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "आजान बाहु अनभै अजीत ॥९४॥",
      "sourceLineId": "102320",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਇੰਦ੍ਰ ਜਿਹ ਪਾਨਿਹਾਰ ॥",
      "transliteration": "kiee koT i(n)dhr jeh paanihaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਕਈ ਕਰੋੜ ਇੰਦਰ ਪਾਣੀ ਭਰਨ ਵਾਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "कई कोटि इंद्र जिह पानिहार ॥",
      "sourceLineId": "102321",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਈ ਚੰਦ ਸੂਰ ਕ੍ਰਿਸਨਾਵਤਾਰ ॥",
      "transliteration": "kiee cha(n)dh soor kirasanaavataar ||",
      "translation": "Millions of Indras, Chandras, Suryas and Krishans serve Him",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਚੰਦ੍ਰਮਾ, ਸੂਰਜ ਅਤੇ ਕ੍ਰਿਸ਼ਨ ਅਵਤਾਰ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "कई चंद सूर कृसनावतार ॥",
      "sourceLineId": "102322",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਈ ਬਿਸਨ ਰੁਦ੍ਰ ਰਾਮਾ ਰਸੂਲ ॥",
      "transliteration": "kiee bisan rudhr raamaa rasool ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਵਿਸ਼ਣੂ, ਰੁਦ੍ਰ, ਰਾਮ ਅਤੇ ਰਸੂਲ (ਮੁਹੰਮਦ) ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "कई बिसन रुद्र रामा रसूल ॥",
      "sourceLineId": "102323",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਬਿਨੁ ਭਗਤਿ ਯੌ ਨ ਕੋਈ ਕਬੂਲ ॥੯੫॥",
      "transliteration": "bin bhagat yau na koiee kabool ||95||",
      "translation": "Many Vishnus, Rudras, Rams, Muhammadas etc. mediate on Him, but He accepts none without true devotion.95.",
      "punjabiViakhya": "ਪਰ (ਸੱਚੀ) ਭਗਤੀ ਤੋਂ ਬਿਨਾ ਕੋਈ ਵੀ ਪ੍ਰਵਾਨ ਨਹੀਂ ਹੈ ॥੯੫॥",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "बिनु भगति यौ न कोई कबूल ॥९५॥",
      "sourceLineId": "102324",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਈ ਦਤ ਸਤ ਗੋਰਖ ਦੇਵ ॥",
      "transliteration": "kiee dhat sat gorakh dhev ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਦੱਤ, ਸੱਤ (ਵਾਦੀ) ਗੋਰਖ ਦੇਵ,",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "कई दत सत गोरख देव ॥",
      "sourceLineId": "102325",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮੁਨਮਨਿ ਮਛਿੰਦ੍ਰ ਨਹੀ ਲਖਤ ਭੇਵ ॥",
      "transliteration": "munaman machhi(n)dhr nahee lakhat bhev ||",
      "translation": "There are many truthful persons like Dutt, many Yogis like Gorakh, Machhindar and other sages, but none has been able to comprehend His mystery",
      "punjabiViakhya": "ਮਨਨਸ਼ੀਲ ਮੁਨੀ ਅਤੇ ਮਛਿੰਦ੍ਰ ਵੀ (ਜਿਸ ਦਾ) ਭੇਦ ਨਹੀਂ ਪਾ ਸਕਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "मुनमनि मछिंद्र नही लखत भेव ॥",
      "sourceLineId": "102326",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਬਹੁ ਭਾਤਿ ਮੰਤ੍ਰ ਮਤ ਕੈ ਪ੍ਰਕਾਸ ॥",
      "transliteration": "bahu bhaat ma(n)tr mat kai prakaas ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬਹੁਤ ਤਰ੍ਰਹਾ ਦੇ ਮੰਤਰਾ ਦੁਆਰਾ (ਆਪਣੇ) ਮਤ ਦਾ ਪ੍ਰਕਾਸ਼ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "बहु भाति मंत्र मत कै प्रकास ॥",
      "sourceLineId": "102327",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਬਿਨੁ ਏਕ ਆਸ ਸਭ ਹੀ ਨਿਰਾਸ ॥੯੬॥",
      "transliteration": "bin ek aas sabh hee niraas ||96||",
      "translation": "Various types of Mantras in various religions the faith of One Lord.96.",
      "punjabiViakhya": "ਪਰੰਤੂ ਇਕ ਦੀ ਆਸ ਤੋਂ ਬਿਨਾ ਸਭ ਨਿਰਾਸ ਹੀ ਰਹਿੰਦੇ ਹਨ ॥੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "बिनु एक आस सभ ही निरास ॥९६॥",
      "sourceLineId": "102328",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਿਹ ਨੇਤਿ ਨੇਤਿ ਭਾਖਤ ਨਿਗਮ ॥",
      "transliteration": "jeh net net bhaakhat nigam ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਦ ਨੇਤਿ ਨੇਤਿ ਕਹਿੰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "जिह नेति नेति भाखत निगम ॥",
      "sourceLineId": "102329",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕਰਤਾਰ ਸਰਬ ਕਾਰਣ ਅਗਮ ॥",
      "transliteration": "karataar sarab kaaran agam ||",
      "translation": "Vedas speak of Him as “Neti, Neti” (not this, not this) and that creator is the cause of all cause and unapproachable",
      "punjabiViakhya": "(ਜੋ) ਕਰਤਾਰ ਸਾਰੇ ਕਾਰਨਾ ਦੀ ਪਹੁੰਚ ਤੋਂ ਪਰੇ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "करतार सरब कारण अगम ॥",
      "sourceLineId": "102330",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜਿਹ ਲਖਤ ਕੋਈ ਨਹੀ ਕਉਨ ਜਾਤਿ ॥",
      "transliteration": "jeh lakhat koiee nahee kaun jaat ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਕੋਈ ਨਹੀਂ ਜਾਣਦਾ ਕਿ ਕਿਸ ਜਾਤਿ ਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "जिह लखत कोई नही कउन जाति ॥",
      "sourceLineId": "102331",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਜਿਹ ਨਾਹਿ ਪਿਤਾ ਭ੍ਰਿਤ ਤਾਤ ਮਾਤ ॥੯੭॥",
      "transliteration": "jeh naeh pitaa bhirat taat maat ||97||",
      "translation": "He is casteless and without father, mother and servents.97.",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਕੋਈ ਪਿਤਾ, ਭਰਾ, ਪੁੱਤਰ ਅਤੇ ਮਾਤਾ ਨਹੀਂ ਹੈ ॥੯੭॥",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "जिह नाहि पिता भृत तात मात ॥९७॥",
      "sourceLineId": "102332",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਜਾਨੀ ਨ ਜਾਤ ਜਿਹ ਰੰਗ ਰੂਪ ॥",
      "transliteration": "jaanee na jaat jeh ra(n)g roop ||",
      "translation": "His form and colour cannot be known",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਰੰਗ ਰੂਪ ਨਹੀਂ ਜਾਣਿਆ ਜਾਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "जानी न जात जिह रंग रूप ॥",
      "sourceLineId": "102333",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਸਾਹਾਨ ਸਾਹਿ ਭੂਪਾਨ ਭੂਪ ॥",
      "transliteration": "saahaan saeh bhoopaan bhoop ||",
      "translation": "He is the king of kings and Sovereign of sovereigns",
      "punjabiViakhya": "ਜੋ ਸ਼ਾਹਾ ਦਾ ਸ਼ਾਹ ਅਤੇ ਰਾਜਿਆਂ ਦਾ ਰਾਜਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "साहान साहि भूपान भूप ॥",
      "sourceLineId": "102334",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਜਿਹ ਬਰਣ ਜਾਤਿ ਨਹੀ ਕ੍ਰਿਤ ਅਨੰਤ ॥",
      "transliteration": "jeh baran jaat nahee kirat ana(n)t ||",
      "translation": "He is the king of kings and Sovereign of sovereigns",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਵਰਣ ਅਤੇ ਜਾਤਿ ਨਹੀਂ ਹੈ ਅਤੇ ਜਿਸ ਦੀ ਕ੍ਰਿਤ (ਕੀਰਤੀ) ਅਨੰਤ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "जिह बरण जाति नही कृत अनंत ॥",
      "sourceLineId": "102335",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਆਦੋ ਅਪਾਰ ਨਿਰਬਿਖ ਬਿਅੰਤ ॥੯੮॥",
      "transliteration": "aadho apaar nirabikh bia(n)t ||98||",
      "translation": "He is the Primal cause of the world and is Infinite.98.",
      "punjabiViakhya": "ਜੋ ਸ਼ੁਰੂ ਤੋਂ ਹੀ ਅਪਾਰ, ਬੇਅੰਤ ਅਤੇ ਵਿਸ਼ਿਆਂ ਤੋਂ ਮੁਕਤ ਹੈ ॥੯੮॥",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "आदो अपार निरबिख बिअंत ॥९८॥",
      "sourceLineId": "102336",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਬਰਣੀ ਨ ਜਾਤਿ ਜਿਹ ਰੰਗ ਰੇਖ ॥",
      "transliteration": "baranee na jaat jeh ra(n)g rekh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਰੰਗ ਅਤੇ ਰੇਖ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "बरणी न जाति जिह रंग रेख ॥",
      "sourceLineId": "102337",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਅਤਭੁਤ ਅਨੰਤ ਅਤਿ ਬਲ ਅਭੇਖ ॥",
      "transliteration": "atabhut ana(n)t at bal abhekh ||",
      "translation": "His colour and Line are indescribable and the power of that Guiseless Lord is endless",
      "punjabiViakhya": "(ਜੋ) ਅਦਭੁਤ, ਅਨੰਤ, ਅਤਿ ਬਲਵਾਨ ਅਤੇ ਭੇਖ ਤੋਂ ਰਹਿਤ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "अतभुत अनंत अति बल अभेख ॥",
      "sourceLineId": "102338",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਅਨਖੰਡ ਚਿਤ ਅਬਿਕਾਰ ਰੂਪ ॥",
      "transliteration": "anakha(n)dd chit abikaar roop ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਅਖੰਡ ਚਿਤ ਵਾਲਾ ਅਤੇ ਵਿਕਾਰਾ ਤੋਂ ਰਹਿਤ ਰੂਪ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "अनखंड चित अबिकार रूप ॥",
      "sourceLineId": "102339",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਦੇਵਾਨ ਦੇਵ ਮਹਿਮਾ ਅਨੂਪ ॥੯੯॥",
      "transliteration": "dhevaan dhev mahimaa anoop ||99||",
      "translation": "He is Vice-less, indivisible, God of gods and unique.99.",
      "punjabiViakhya": "(ਜੋ) ਦੇਵਤਿਆਂ ਦਾ ਦੇਵਤਾ ਅਤੇ ਅਨੂਪਮ ਮਹਿਮਾ ਵਾਲਾ ਹੈ ॥੯੯॥",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "देवान देव महिमा अनूप ॥९९॥",
      "sourceLineId": "102340",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਉਸਤਤੀ ਨਿੰਦ ਜਿਹ ਇਕ ਸਮਾਨ ॥",
      "transliteration": "ausatatee ni(n)dh jeh ik samaan ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਉਸਤਤ ਅਤੇ ਨਿੰਦਿਆ ਇਕ ਸਮਾਨ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "उसतती निंद जिह इक समान ॥",
      "sourceLineId": "102341",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0642_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਆਭਾ ਅਖੰਡ ਮਹਿਮਾ ਮਹਾਨ ॥",
      "transliteration": "aabhaa akha(n)dd mahimaa mahaan ||",
      "translation": "The praise and slander are alike for Him and the beauty of that Great Praiseworthy Lord is perfect",
      "punjabiViakhya": "(ਜਿਸ ਦੀ) ਆਭਾ ਅਖੰਡ ਹੈ ਅਤੇ ਮਹਿਮਾ ਮਹਾਨ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 642,
      "hindi": "",
      "hindiTransliteration": "आभा अखंड महिमा महान ॥",
      "sourceLineId": "102342",
      "sourceShabadId": "9331",
      "sourceUpdated": "2022-12-24 02:22:37",
