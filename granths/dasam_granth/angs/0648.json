{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 648,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0648_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕੇਈ ਸੁਨਤ ਪਾਠ ਪਰਮੰ ਪੁਨੀਤ ॥",
      "transliteration": "keiee sunat paaTh parama(n) puneet ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਪਰਮ ਪਵਿਤ੍ਰ ਪਾਠ ਨੂੰ ਸੁਣਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "केई सुनत पाठ परमं पुनीत ॥",
      "sourceLineId": "102587",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਹੀ ਮੁਰਤ ਕਲਪ ਬਹੁਤ ਜਾਤ ਬੀਤ ॥੧੫੮॥",
      "transliteration": "nahee murat kalap bahut jaat beet ||158||",
      "translation": "Many are listening to the recitation of the holy religious texts, while sitting and many do not look back even for many Kalpas (ages).158.",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਕਲਪ (ਯੁਗ) ਬੀਤ ਜਾਣ ਤੇ ਵੀ (ਇਹ ਕੰਮ ਕਰਨੋਂ) ਮੁੜਦੇ ਨਹੀਂ ਹਨ ॥੧੫੮॥",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "नही मुरत कलप बहुत जात बीत ॥१५८॥",
      "sourceLineId": "102588",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕੇਈ ਬੈਠ ਕਰਤ ਜਲਿ ਕੋ ਅਹਾਰ ॥",
      "transliteration": "keiee baiTh karat jal ko ahaar ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਬੈਠ ਕੇ ਜਲ ਦਾ ਆਹਾਰ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "केई बैठ करत जलि को अहार ॥",
      "sourceLineId": "102589",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕੇਈ ਭ੍ਰਮਤ ਦੇਸ ਦੇਸਨ ਪਹਾਰ ॥",
      "transliteration": "keiee bhramat dhes dhesan pahaar ||",
      "translation": "Many, being seated, are drinking water and many are roaming on the mountains and countries far and near",
      "punjabiViakhya": "ਕਈ ਦੇਸ ਦੇਸਾਤਰਾ ਦੇ ਪਰਬਤਾ ਵਿਚ ਭਰਮਦੇ ਫਿਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "केई भ्रमत देस देसन पहार ॥",
      "sourceLineId": "102590",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕੇਈ ਜਪਤ ਮਧ ਕੰਦਰੀ ਦੀਹ ॥",
      "transliteration": "keiee japat madh ka(n)dharee dheeh ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਵੱਡੀਆਂ ਕੰਦਰਾ (ਗੁਫਾਵਾ) ਵਿਚ (ਬੈਠ ਕੇ) ਜਪ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "केई जपत मध कंदरी दीह ॥",
      "sourceLineId": "102591",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕੇਈ ਬ੍ਰਹਮਚਰਜ ਸਰਤਾ ਮਝੀਹ ॥੧੫੯॥",
      "transliteration": "keiee brahamacharaj sarataa majheeh ||159||",
      "translation": "Many are sitting in the caves and repeating the Name of the Lord and many celibates are moving in the streams.159.",
      "punjabiViakhya": "ਕਈ ਬ੍ਰਹਮਚਰਯ ਰੂਪ ਨਦੀ ਵਿਚ (ਟੁਬੀਆਂ ਲਾਉਾਂਦੇ ਹਨ) ॥੧੫੯॥",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "केई ब्रहमचरज सरता मझीह ॥१५९॥",
      "sourceLineId": "102592",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕੇਈ ਰਹਤ ਬੈਠਿ ਮਧ ਨੀਰ ਜਾਇ ॥",
      "transliteration": "keiee rahat baiTh madh neer jai ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਪਾਣੀ ਵਿਚ ਜਾ ਕੇ ਬੈਠੇ ਰਹਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "केई रहत बैठि मध नीर जाइ ॥",
      "sourceLineId": "102593",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕੇਈ ਅਗਨ ਜਾਰਿ ਤਾਪਤ ਬਨਾਇ ॥",
      "transliteration": "keiee agan jaar taapat banai ||",
      "translation": "Many are sitting in water and many are warming themselves by burning the fire",
      "punjabiViakhya": "ਕਈ ਅੱਗ ਬਾਲ ਕੇ ਚੰਗੀ ਤਰ੍ਰਹਾ ਸੇਕਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "केई अगन जारि तापत बनाइ ॥",
      "sourceLineId": "102594",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕੇਈ ਰਹਤ ਸਿਧਿ ਮੁਖ ਮੋਨ ਠਾਨ ॥",
      "transliteration": "keiee rahat sidh mukh mon Thaan ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਸਿੱਧ ਲੋਕ ਮੂੰਹ ਉਤੇ ਚੁਪ ਸਾਧੀ ਰਖਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "केई रहत सिधि मुख मोन ठान ॥",
      "sourceLineId": "102595",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਨਿ ਆਸ ਚਿਤ ਇਕ ਆਸ ਮਾਨ ॥੧੬੦॥",
      "transliteration": "an aas chit ik aas maan ||160||",
      "translation": "Many adepts observing silence, are remembering the Lord and many are absorbed in concentration on the sky in their mind.160.",
      "punjabiViakhya": "(ਕਈ) ਹੋਰਾ ਆਸਾ ਨੂੰ ਛਡ ਕੇ ਇਕ ਆਸ ਨੂੰ ਚਿਤ ਵਿਚ ਵਸਾ ਰਖਦੇ ਹਨ ॥੧੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "अनि आस चित इक आस मान ॥१६०॥",
      "sourceLineId": "102596",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਨਡੋਲ ਗਾਤ ਅਬਿਕਾਰ ਅੰਗ ॥",
      "transliteration": "anaddol gaat abikaar a(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈਆਂ ਦੇ) ਸ਼ਰੀਰ ਡੋਲਦੇ ਨਹੀਂ ਅਤੇ ਨਾ ਹੀ ਅੰਗਾ ਵਿਚ ਵਿਕਾਰ ਆਉਾਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "अनडोल गात अबिकार अंग ॥",
      "sourceLineId": "102597",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮਹਿਮਾ ਮਹਾਨ ਆਭਾ ਅਭੰਗ ॥",
      "transliteration": "mahimaa mahaan aabhaa abha(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੀ) ਮਹਿਮਾ ਮਹਾਨ ਹੈ ਅਤੇ ਆਭਾ ਅਭੰਗ (ਨਾਸ ਰਹਿਤ) ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "महिमा महान आभा अभंग ॥",
      "sourceLineId": "102598",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਨਭੈ ਸਰੂਪ ਅਨਭਵ ਪ੍ਰਕਾਸ ॥",
      "transliteration": "anabhai saroop anabhav prakaas ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਭੈ ਰਹਿਤ ਸਰੂਪ ਵਾਲੇ ਅਤੇ ਅਨੁਭਵ ਦੁਆਰਾ ਪ੍ਰਕਾਸ਼ਿਤ ਹੋਣ ਵਾਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "अनभै सरूप अनभव प्रकास ॥",
      "sourceLineId": "102599",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਬਯਕਤ ਤੇਜ ਨਿਸ ਦਿਨ ਉਦਾਸ ॥੧੬੧॥",
      "transliteration": "abayakat tej nis dhin udhaas ||161||",
      "translation": "Many are absorbed in meditation on that stable and vice less Lord, Who is Supreme and praiseworthy, Whose glory is Unique, Who is cognition-incarnate and Lightt-incarnate, Whose Splendour is unmanifested and Who is Unattached.161.",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦਾ) ਤੇਜ ਪ੍ਰਗਟਾਇਆ ਨਹੀਂ ਜਾ ਸਕਦਾ ਅਤੇ ਰਾਤ ਦਿਨ ਉਦਾਸ ਰਹਿੰਦੇ ਹਨ ॥੧੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "अबयकत तेज निस दिन उदास ॥१६१॥",
      "sourceLineId": "102600",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਜੋਗਿ ਕੀਨੇ ਅਪਾਰ ॥",
      "transliteration": "eeh bhaat jog keene apaar ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ (ਅਨੇਕਾ ਨੇ) ਅਪਾਰ ਯੋਗ ਕੀਤੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "इह भाति जोगि कीने अपार ॥",
      "sourceLineId": "102601",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੁਰ ਬਾਝ ਯੌ ਨ ਹੋਵੈ ਉਧਾਰ ॥",
      "transliteration": "gur baajh yau na hovai udhaar ||",
      "translation": "In this way, he practiced Yoga in various ways, but the salvation is not attained without the Guru",
      "punjabiViakhya": "ਪਰ ਗੁਰੂ ਤੋਂ ਬਿਨਾ ਇੰਜ (ਉਨ੍ਰਹਾ ਦਾ) ਉੱਧਾਰ ਨਹੀਂ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "गुर बाझ यौ न होवै उधार ॥",
      "sourceLineId": "102602",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਬ ਪਰੇ ਦਤ ਕੇ ਚਰਨਿ ਆਨਿ ॥",
      "transliteration": "tab pare dhat ke charan aan ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਉਹ) ਆ ਕੇ ਦੱਤ ਦੇ ਚਰਨੀਂ ਪੈ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "तब परे दत के चरनि आनि ॥",
      "sourceLineId": "102603",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਹਿ ਦੇਹਿ ਜੋਗ ਕੇ ਗੁਰ ਬਿਧਾਨ ॥੧੬੨॥",
      "transliteration": "keh dheh jog ke gur bidhaan ||162||",
      "translation": "Then they all fell at the feet of Dutt and requested him to instruct them in the method of Yoga.162.",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿਣ ਲਗੇ) ਹੇ ਗੁਰੂਦੇਵ! ਯੋਗ ਦੀ ਵਿਧੀ ਦਸ ਦਿਓ ॥੧੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "कहि देहि जोग के गुर बिधान ॥१६२॥",
      "sourceLineId": "102604",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਲ ਮਧਿ ਜੌਨ ਮੁੰਡੇ ਅਪਾਰ ॥",
      "transliteration": "jal madh jauan mu(n)dde apaar ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਅਪਾਰ (ਚੇਲੇ) ਜਲ ਵਿਚ ਮੁੰਨੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "जल मधि जौन मुँडे अपार ॥",
      "sourceLineId": "102605",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਨ ਨਾਮ ਤਉਨ ਹ੍ਵੈਗੇ ਕੁਮਾਰ ॥",
      "transliteration": "ban naam taun havaige kumaar ||",
      "translation": "Those who were subjected to tonsure ceremony in water, all those princes (boys) are under your refuge",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਚੇਲਿਆ ਦਾ ਨਾ 'ਬਨ' (ਬਨੀ) ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "बन नाम तउन ह्वैगे कुमार ॥",
      "sourceLineId": "102606",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗਿਰਿ ਮਧਿ ਸਿਖ ਕਿਨੇ ਅਨੇਕ ॥",
      "transliteration": "gir madh sikh kine anek ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਅਨੇਕਾ ਸਿੱਖ ਪਹਾੜਾ ਵਿਚ ਕੀਤੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "गिरि मधि सिख किने अनेक ॥",
      "sourceLineId": "102607",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗਿਰਿ ਭੇਸ ਸਹਤਿ ਸਮਝੋ ਬਿਬੇਕ ॥੧੬੩॥",
      "transliteration": "gir bhes sahat samajho bibek ||163||",
      "translation": "Those who were initiated as disciples in the mountains, they were known by the name Girl.163.",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦਾ ਨਾ) ਭੇਖ ਸਹਿਤ 'ਗਿਰਿ' ਸਮਝੋ ॥੧੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "गिरि भेस सहति समझो बिबेक ॥१६३॥",
      "sourceLineId": "102608",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭਾਰਥ ਭਣੰਤ ਜੇ ਭੇ ਦੁਰੰਤ ॥",
      "transliteration": "bhaarath bhana(n)t je bhe dhura(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਰਥ ਦਾ ਵਰਣਨ ਕਰਦਿਆਂ ਜੋ ਬੇਅੰਤ (ਚੇਲੇ) ਬਣੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "भारथ भणंत जे भे दुरंत ॥",
      "sourceLineId": "102609",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭਾਰਥੀ ਨਾਮ ਤਾ ਕੇ ਭਣੰਤ ॥",
      "transliteration": "bhaarathee naam taa ke bhana(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦਾ ਨਾ 'ਭਾਰਥੀ' ਕਿਹਾ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "भारथी नाम ता के भणंत ॥",
      "sourceLineId": "102610",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪੁਰਿ ਜਾਸ ਸਿਖ ਕੀਨੇ ਅਪਾਰ ॥",
      "transliteration": "pur jaas sikh keene apaar ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਅਪਾਰ ਚੇਲੇ ਸ਼ਹਿਰਾ ਵਿਚ ਕੀਤੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "पुरि जास सिख कीने अपार ॥",
      "sourceLineId": "102611",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪੁਰੀ ਨਾਮ ਤਉਨ ਜਾਨ ਬਿਚਾਰ ॥੧੬੪॥",
      "transliteration": "puree naam taun jaan bichaar ||164||",
      "translation": "He wandered in the cities and made Barat, Parath, Puri etc. as Sannyasis.164.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦਾ ਨਾਮ 'ਪੁਰੀ' ਵਿਚਾਰ ਲਿਆ ਜਾਵੇ ॥੧੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "पुरी नाम तउन जान बिचार ॥१६४॥",
      "sourceLineId": "102612",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪਰਬਤ ਬਿਖੈ ਸਜੇ ਸਿਖ ਕੀਨ ॥",
      "transliteration": "parabat bikhai saje sikh keen ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਬਤਾ ਵਿਚ ਜਿਹੜੇ ਚੇਲੇ ਸਜਾਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "परबत बिखै सजे सिख कीन ॥",
      "sourceLineId": "102613",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪਰਬਤਿ ਸੁ ਨਾਮ ਲੈ ਤਾਹਿ ਦੀਨ ॥",
      "transliteration": "parabat su naam lai taeh dheen ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦਾ ਨਾਮ 'ਪਰਬਤਿ' ਦੇ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "परबति सु नाम लै ताहि दीन ॥",
      "sourceLineId": "102614",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਉਚਰਿ ਕਰਿ ਪੰਚ ਨਾਮ ॥",
      "transliteration": "eeh bhaat uchar kar pa(n)ch naam ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਨਾਲ ਪੰਜ ਨਾਵਾ ਦਾ ਉਚਾਰਨ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "इह भाति उचरि करि पंच नाम ॥",
      "sourceLineId": "102615",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਬ ਦਤ ਦੇਵ ਕਿੰਨੇ ਬਿਸ੍ਰਾਮ ॥੧੬੫॥",
      "transliteration": "tab dhat dhev ki(n)ne bisraam ||165||",
      "translation": "Those who were made disciples on the mountains, they were named ‘Parvat’ and in this way uttering the five names, Dutt took rest.165.",
      "punjabiViakhya": "ਤਦ ਦੱਤ ਦੇਵ ਨੇ ਬਿਸਰਾਮ ਕੀਤਾ ॥੧੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "तब दत देव किंने बिस्राम ॥१६५॥",
      "sourceLineId": "102616",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਾਗਰ ਮੰਝਾਰ ਜੇ ਸਿਖ ਕੀਨ ॥",
      "transliteration": "saagar ma(n)jhaar je sikh keen ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਗਰ ਵਿਚ ਜਿਹੜੇ ਚੇਲੇ ਬਣਾਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "सागर मंझार जे सिख कीन ॥",
      "sourceLineId": "102617",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਾਗਰਿ ਸੁ ਨਾਮ ਤਿਨ ਕੇ ਪ੍ਰਬੀਨ ॥",
      "transliteration": "saagar su naam tin ke prabeen ||",
      "translation": "Those were initiated as disciples in the sea, they were named as ‘Sagar’ and",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਪ੍ਰਬੀਨਾ ਦਾ ਨਾ 'ਸਾਗਰਿ' ਵਜੋਂ ਪ੍ਰਸਿੱਧ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "सागरि सु नाम तिन के प्रबीन ॥",
      "sourceLineId": "102618",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਾਰਸੁਤਿ ਤੀਰ ਜੇ ਕੀਨ ਚੇਲ ॥",
      "transliteration": "saarasut teer je keen chel ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸਰਸਵਤੀ ਦੇ ਕੰਢੇ ਦੇ ਚੇਲੇ ਕੀਤੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "सारसुति तीर जे कीन चेल ॥",
      "sourceLineId": "102619",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਾਰਸੁਤੀ ਨਾਮ ਤਿਨ ਨਾਮ ਮੇਲ ॥੧੬੬॥",
      "transliteration": "saarasutee naam tin naam mel ||166||",
      "translation": "Those who were made disciples on the bank of river Sarasvati, they were named as ‘Sarasvati’.166.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਨਾ ਨਾਲ 'ਸਰਸਵਤੀ' ਨਾਮ ਮਿਲਾ ਦਿੱਤਾ ॥੧੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "सारसुती नाम तिन नाम मेल ॥१६६॥",
      "sourceLineId": "102620",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤੀਰਥਨ ਬੀਚ ਜੇ ਸਿਖ ਕੀਨ ॥",
      "transliteration": "teerathan beech je sikh keen ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰਥਾ ਵਿਚ ਜੋ ਸੇਵਕ ਕੀਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "तीरथन बीच जे सिख कीन ॥",
      "sourceLineId": "102621",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤੀਰਥਿ ਸੁ ਨਾਮ ਤਿਨ ਕੋ ਪ੍ਰਬੀਨ ॥",
      "transliteration": "teerath su naam tin ko prabeen ||",
      "translation": "Those who were made were made disciples at pilgrim-stations, those skilful disciples were named as ‘Tirath’",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਪ੍ਰਬੀਨਾ ਦੇ ਨਾ ਨਾਲ 'ਤੀਰਥਿ' ਨਾਮ ਜੋੜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "तीरथि सु नाम तिन को प्रबीन ॥",
      "sourceLineId": "102622",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਨ ਚਰਨ ਦਤ ਕੇ ਗਹੇ ਆਨਿ ॥",
      "transliteration": "jin charan dhat ke gahe aan ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੇ ਦੱਤ ਦੇ ਚਰਨ ਆ ਫੜੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "जिन चरन दत के गहे आनि ॥",
      "sourceLineId": "102623",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤੇ ਭਏ ਸਰਬ ਬਿਦਿਆ ਨਿਧਾਨ ॥੧੬੭॥",
      "transliteration": "te bhe sarab bidhiaa nidhaan ||167||",
      "translation": "Those who came and caught the feet of Dutt, they all became the treasure of learning.167.",
      "punjabiViakhya": "ਉਹ ਸਾਰੇ ਵਿਦਿਆ ਨਿਧਾਨ ਹੋ ਗਏ ॥੧੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "ते भए सरब बिदिआ निधान ॥१६७॥",
      "sourceLineId": "102624",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਮਿ ਕਰਤ ਸਿਖ ਜਹ ਤਹ ਬਿਹਾਰਿ ॥",
      "transliteration": "eim karat sikh jeh teh bihaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੜੇ ਜਿਥੇ ਕਿਥੇ ਵਿਚਰਦਿਆਂ ਚੇਲੇ ਕੀਤੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "इमि करत सिख जह तह बिहारि ॥",
      "sourceLineId": "102625",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਆਸ੍ਰਮਨ ਬੀਚ ਜੋ ਜੋ ਨਿਹਾਰਿ ॥",
      "transliteration": "aasraman beech jo jo nihaar ||",
      "translation": "In this way, wherever the disciples lived and wherever any disciple did anything,",
      "punjabiViakhya": "ਅਤੇ ਆਸ਼੍ਰਮਾ ਵਿਚ ਜੋ ਜੋ ਵੇਖੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "आस्रमन बीच जो जो निहारि ॥",
      "sourceLineId": "102626",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਹ ਤਹੀ ਸਿਖ ਜੋ ਕੀਨ ਜਾਇ ॥",
      "transliteration": "teh tahee sikh jo keen jai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਥੇ ਜਾ ਕੇ ਉਨ੍ਰਹਾ ਨੂੰ ਸੇਵਕ ਬਣਾਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "तह तही सिख जो कीन जाइ ॥",
      "sourceLineId": "102627",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਆਸ੍ਰਮਿ ਸੁ ਨਾਮ ਕੋ ਤਿਨ ਸੁਹਾਇ ॥੧੬੮॥",
      "transliteration": "aasram su naam ko tin suhai ||168||",
      "translation": "The hermitage was established there in his name.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ 'ਆਸ਼੍ਰਮਿ' ਨਾ ਨਾਲ ਸ਼ੋਭਾਸ਼ਾਲੀ ਕਰ ਦਿੱਤਾ ॥੧੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "आस्रमि सु नाम को तिन सुहाइ ॥१६८॥",
      "sourceLineId": "102628",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਆਰੰਨ ਬੀਚ ਜੇਅ ਭੇ ਦਤ ॥",
      "transliteration": "aara(n)n beech jea bhe dhat ||",
      "translation": "",
      "punjabiViakhya": "ਬਨ ('ਆਰੰਨ') ਵਿਚ ਜਿਹੜੇ ਦੱਤ ਦੇ ਚੇਲੇ ਹੋਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "आरंन बीच जेअ भे दत ॥",
      "sourceLineId": "102629",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੰਨ੍ਯਾਸ ਰਾਜ ਅਤਿ ਬਿਮਲ ਮਤਿ ॥",
      "transliteration": "sa(n)nayaas raaj at bimal mat ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੰਨਿਆਸ ਸ਼ਿਰੋਮਣੀ ਅਤੇ ਬਹੁਤ ਨਿਰਮਲ ਬੁੱਧੀ ਵਾਲੇ (ਦੱਤ ਨੇ)",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "संन्यास राज अति बिमल मति ॥",
      "sourceLineId": "102630",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਹ ਤਹ ਸੁ ਕੀਨ ਜੇ ਸਿਖ ਜਾਇ ॥",
      "transliteration": "teh teh su keen je sikh jai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਉਥੇ ਜਾ ਕੇ ਜੋ ਚੇਲੇ ਬਣਾਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "तह तह सु कीन जे सिख जाइ ॥",
      "sourceLineId": "102631",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਰਿੰਨਿ ਨਾਮ ਤਿਨ ਕੋ ਰਖਾਇ ॥੧੬੯॥",
      "transliteration": "ari(n)n naam tin ko rakhai ||169||",
      "translation": "That fearless Purusha Dutt made several disciples in the Aranyaks (forets), they were named `Aranayaks`.169.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦਾ ਨਾ 'ਆਰਿੰਨਿ' ਰਖ ਦਿੱਤਾ ॥੧੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "अरिंनि नाम तिन को रखाइ ॥१६९॥",
      "sourceLineId": "102632",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਦਤ ਮਹਾਤਮੇ ਅਨਭਉ ਪ੍ਰਕਾਸੇ ਦਸ ਨਾਮ ਧ੍ਰਯਾਯ ਸੰਪੂਰਣ ॥",
      "transliteration": "eit sree bachitr naaTak gra(n)the dhat mahaatame anabhau prakaase dhas naam dhrayaay sa(n)pooran ||",
      "translation": "End of the chapter entitled \"The ten names of Cognition-Incarnate disciples of th sage Dutt\" in Bachittar Natak.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥ ਦੇ ਦੱਤ ਮਹਾਤਮ 'ਅਨਭਉ ਪ੍ਰਕਾਸ ਦਸ ਨਾਮ' ਵਾਲਾ ਅਧਿਆਇ ਸੰਪੂਰਨ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "इति स्री बचित्र नाटक ग्रंथे दत महातमे अनभउ प्रकासे दस नाम ध्रयाय संपूरण ॥",
      "sourceLineId": "102633",
      "sourceShabadId": "9340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪਾਧੜੀ ਛੰਦ ॥",
      "transliteration": "paadhaRee chha(n)dh ||",
      "translation": "(Now begins the description of making mind as the Second Guru) PAADHARI STANZA",
      "punjabiViakhya": "ਪਾਧੜੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "पाधड़ी छंद ॥",
      "sourceLineId": "102634",
      "sourceShabadId": "9341",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਆਜਾਨ ਬਾਹੁ ਅਤਿਸੈ ਪ੍ਰਭਾਵ ॥",
      "transliteration": "aajaan baahu atisai prabhaav ||",
      "translation": "",
      "punjabiViakhya": "ਗੋਡਿਆਂ ਤਕ ਬਾਹਵਾ ਵਾਲਾ ਅਤੇ ਬਹੁਤ ਵੱਡੇ ਪ੍ਰਭਾਵ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "आजान बाहु अतिसै प्रभाव ॥",
      "sourceLineId": "102635",
      "sourceShabadId": "9341",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਅਬਿਯਕਤ ਤੇਜ ਸੰਨ੍ਯਾਸ ਰਾਵ ॥",
      "transliteration": "abiyakat tej sa(n)nayaas raav ||",
      "translation": "The glory of that king of Sannyasis was indescribable and the impact of his long arms was enormous",
      "punjabiViakhya": "ਅਤੇ ਅਵਿਅਕਤ ਤੇਜ ਵਾਲਾ ਸੰਨਿਆਸ ਰਾਜ ਦੱਤ ਮੁਨੀ",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "अबियकत तेज संन्यास राव ॥",
      "sourceLineId": "102636",
      "sourceShabadId": "9341",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜਹ ਜਹ ਬਿਹਾਰ ਮੁਨਿ ਕਰਤ ਦਤ ॥",
      "transliteration": "jeh jeh bihaar mun karat dhat ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਵਿਚਰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "जह जह बिहार मुनि करत दत ॥",
      "sourceLineId": "102637",
      "sourceShabadId": "9341",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਨਭਉ ਪ੍ਰਕਾਸ ਅਰੁ ਬਿਮਲ ਮਤ ॥੧੭੦॥",
      "transliteration": "anabhau prakaas ar bimal mat ||170||",
      "translation": "Wherever the sage Dutt went, there also the effulgence glistened and the pure intellect extended.170.",
      "punjabiViakhya": "(ਉਥੇ ਉਥੇ) ਅਨਭਉ ਪ੍ਰਕਾਸ਼ ਅਤੇ ਨਿਰਮਲ ਬੁੱਧੀ ਹੁੰਦੀ ਜਾਦੀ ਸੀ ॥੧੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "अनभउ प्रकास अरु बिमल मत ॥१७०॥",
      "sourceLineId": "102638",
      "sourceShabadId": "9341",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜੇ ਹੁਤੇ ਦੇਸ ਦੇਸਨ ਨ੍ਰਿਪਾਲ ॥",
      "transliteration": "je hute dhes dhesan nirapaal ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੜੇ ਦੇਸਾ ਦੇਸਾਤਰਾ ਦੇ ਰਾਜੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "जे हुते देस देसन नृपाल ॥",
      "sourceLineId": "102639",
      "sourceShabadId": "9341",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤਜਿ ਗਰਬ ਪਾਨ ਲਾਗੇ ਸੁ ਢਾਲ ॥",
      "transliteration": "taj garab paan laage su ddaal ||",
      "translation": "The kings of the countries far and near, forsaking their pride came and fell at his feet",
      "punjabiViakhya": "ਉਹ ਹੰਕਾਰ ਛਡ ਕੇ ਅਤੇ (ਮਨ ਨੂੰ) ਢਾਲ ਕੇ (ਦੱਤ ਦੇ) ਚਰਨੀਂ ਆ ਲਗੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "तजि गरब पान लागे सु ढाल ॥",
      "sourceLineId": "102640",
      "sourceShabadId": "9341",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਤਜਿ ਦੀਨ ਅਉਰ ਝੂਠੇ ਉਪਾਇ ॥",
      "transliteration": "taj dheen aaur jhooThe upai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਹੋਰ ਕੂੜਿਆਂ ਉਪਾਵਾ ਨੂੰ ਛਡ ਦਿੱਤਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "तजि दीन अउर झूठे उपाइ ॥",
      "sourceLineId": "102641",
      "sourceShabadId": "9341",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਦ੍ਰਿੜ ਗਹਿਓ ਏਕ ਸੰਨ੍ਯਾਸ ਰਾਇ ॥੧੭੧॥",
      "transliteration": "dhiraR gahio ek sa(n)nayaas rai ||171||",
      "translation": "They abandoned all the false measures and with determination, made Dutt, the king ofYogis, as their base.171.",
      "punjabiViakhya": "ਅਤੇ ਕੇਵਲ ਇਕ ਸੰਨਿਆਸ ਰਾਜ (ਦੱਤ ਦੇ ਪੈਰ) ਪਕੜ ਲਏ ਸਨ ॥੧੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "दृड़ गहिओ एक संन्यास राइ ॥१७१॥",
      "sourceLineId": "102642",
      "sourceShabadId": "9341",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਤਜਿ ਸਰਬ ਆਸ ਇਕ ਆਸ ਚਿਤ ॥",
      "transliteration": "taj sarab aas ik aas chit ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ ਸਾਰੀਆਂ ਆਸਾ ਛਡ ਕੇ ਇਕ ਆਸ ਚਿਤ ਵਿਚ (ਧਾਰ ਲਈ ਸੀ)",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "तजि सरब आस इक आस चित ॥",
      "sourceLineId": "102643",
      "sourceShabadId": "9341",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਅਬਿਕਾਰ ਚਿਤ ਪਰਮੰ ਪਵਿਤ ॥",
      "transliteration": "abikaar chit parama(n) pavit ||",
      "translation": "Relinquishing all other desires, only one desire of meeting the Lord remained in their heart and",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਦਾ ਚਿਤ ਵਿਕਾਰਾ ਤੋਂ ਰਹਿਤ ਅਤੇ ਪਰਮ ਪਵਿਤ੍ਰ ਹੋ ਗਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "अबिकार चित परमं पवित ॥",
      "sourceLineId": "102644",
      "sourceShabadId": "9341",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਜਹ ਕਰਤ ਦੇਸ ਦੇਸਨ ਬਿਹਾਰ ॥",
      "transliteration": "jeh karat dhes dhesan bihaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਵੀ ਦੇਸਾ ਦੇਸਾਤਰਾ ਵਿਚ (ਦੱਤ) ਵਿਚਰਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "जह करत देस देसन बिहार ॥",
      "sourceLineId": "102645",
      "sourceShabadId": "9341",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਉਠਿ ਚਲਤ ਸਰਬ ਰਾਜਾ ਅਪਾਰ ॥੧੭੨॥",
      "transliteration": "auTh chalat sarab raajaa apaar ||172||",
      "translation": "The mind of all of them was supremely pure and without any vice to whichever country Dutt went, the king of that place fell t his feet.172.",
      "punjabiViakhya": "ਉਥੋਂ ਦੇ ਸਾਰੇ ਅਪਾਰ ਰਾਜੇ ਉਠ ਕੇ ਨਾਲ ਤੁਰ ਪੈਂਦੇ ਸਨ ॥੧੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "उठि चलत सरब राजा अपार ॥१७२॥",
      "sourceLineId": "102646",
      "sourceShabadId": "9341",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "102647",
      "sourceShabadId": "9342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਗਵਨ ਕਰਤ ਜਿਹਾਂ ਜਿਹਾਂ ਦਿਸਾ ਮੁਨਿ ਮਨ ਦਤ ਅਪਾਰ ॥",
      "transliteration": "gavan karat jihaa(n) jihaa(n) dhisaa mun man dhat apaar ||",
      "translation": "",
      "punjabiViakhya": "ਅਪਾਰ ਮਨ ਵਾਲਾ ਮੁਨੀ ਦੱਤ ਜਿਸ ਜਿਸ ਪਾਸੇ ਵਲ ਗਮਨ ਕਰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "गवन करत जिहाँ जिहाँ दिसा मुनि मन दत अपार ॥",
      "sourceLineId": "102648",
      "sourceShabadId": "9342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਸੰਗਿ ਚਲਤ ਉਠਿ ਸਬ ਪ੍ਰਜਾ ਤਜ ਘਰ ਬਾਰ ਪਹਾਰ ॥੧੭੩॥",
      "transliteration": "sa(n)g chalat uTh sab prajaa taj ghar baar pahaar ||173||",
      "translation": "To whichever direction, Dutt went, the subjects of those places left their homes and accompanied him.173.",
      "punjabiViakhya": "(ਉਥੋਂ ਉਥੋਂ ਦੀ) ਸਾਰੀ ਪ੍ਰਜਾ ਘਰ, ਬਾਰ ਛਡ ਕੇ ਪਹਾੜ ਵਲ ਨਾਲ ਚਲ ਪੈਂਦੀ ਸੀ ॥੧੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "संगि चलत उठि सब प्रजा तज घर बार पहार ॥१७३॥",
      "sourceLineId": "102649",
      "sourceShabadId": "9342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "102650",
      "sourceShabadId": "9343",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਜਿਹ ਜਿਹ ਦੇਸ ਮੁਨੀਸਰ ਗਏ ॥",
      "transliteration": "jeh jeh dhes muneesar ge ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਜਿਸ ਦੇਸ ਵਿਚ ਸ੍ਰੇਸ਼ਠ ਮੁਨੀ (ਦੱਤ) ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "जिह जिह देस मुनीसर गए ॥",
      "sourceLineId": "102651",
      "sourceShabadId": "9343",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਊਚ ਨੀਚ ਸਬ ਹੀ ਸੰਗਿ ਭਏ ॥",
      "transliteration": "uooch neech sab hee sa(n)g bhe ||",
      "translation": "To whichever country, the great sage Dutt went, all the elders and minors accompanied him",
      "punjabiViakhya": "(ਉਥੋਂ ਦੇ ਸਾਰੇ) ਊਚ ਨੀਚ ਉਨ੍ਰਹਾ ਦੇ ਸੰਗ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "ऊच नीच सब ही संगि भए ॥",
      "sourceLineId": "102652",
      "sourceShabadId": "9343",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਏਕ ਜੋਗ ਅਰੁ ਰੂਪ ਅਪਾਰਾ ॥",
      "transliteration": "ek jog ar roop apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਯੋਗ ਅਤੇ ਦੂਜਾ ਅਪਾਰ ਰੂਪ,",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "एक जोग अरु रूप अपारा ॥",
      "sourceLineId": "102653",
      "sourceShabadId": "9343",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਕਉਨ ਨ ਮੋਹੈ ਕਹੋ ਬਿਚਾਰਾ ॥੧੭੪॥",
      "transliteration": "kaun na mohai kaho bichaaraa ||174||",
      "translation": "Whereas he was a Yogi, he was also extremely beautiful, then who would there be without allurement.174.",
      "punjabiViakhya": "ਭਲਾ ਵਿਚਾਰ ਕਰ ਕੇ ਦਸੋ, ਕਿਹੜਾ ਮੋਹਿਤ ਨਾ ਹੁੰਦਾ ॥੧੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "कउन न मोहै कहो बिचारा ॥१७४॥",
      "sourceLineId": "102654",
      "sourceShabadId": "9343",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਜਹ ਤਹ ਚਲਾ ਜੋਗੁ ਸੰਨ੍ਯਾਸਾ ॥",
      "transliteration": "jeh teh chalaa jog sa(n)nayaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਸੰਨਿਆਸ ਯੋਗ ਚਲ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
      "hindiTransliteration": "जह तह चला जोगु संन्यासा ॥",
      "sourceLineId": "102655",
      "sourceShabadId": "9343",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0648_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਰਾਜ ਪਾਟ ਤਜ ਭਏ ਉਦਾਸਾ ॥",
      "transliteration": "raaj paaT taj bhe udhaasaa ||",
      "translation": "Wherever the impact of his Yoga and Sannyas reached, the people left all their paraphernalia and became unattached",
      "punjabiViakhya": "(ਰਾਜੇ) ਰਾਜਸੀ ਠਾਠ ਬਾਠ ਨੂੰ ਛਡ ਕੇ ਵਿਰਕਤ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 648,
      "hindi": "",
