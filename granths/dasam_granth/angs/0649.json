{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 649,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0649_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਇਤਿ ਮਨ ਨੂੰ ਗੁਰੂ ਦੂਸਰ ਠਹਰਾਇਆ ਸਮਾਪਤੰ ॥੨॥",
      "transliteration": "eit man noo(n) guroo dhoosar Thaharaiaa samaapata(n) ||2||",
      "translation": "End of the adoption of Man (mind) as the second Guru.",
      "punjabiViakhya": "ਇਥੇ ਮਨ ਨੂੰ ਦੂਜਾ ਗੁਰੂ ਧਾਰਨ ਕਰਨ ਦਾ ਪ੍ਰਸੰਗ ਸਮਾਪਤ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "इति मन नूँ गुरू दूसर ठहराइआ समापतं ॥२॥",
      "sourceLineId": "102659",
      "sourceShabadId": "9343",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਥ ਤ੍ਰਿਤੀ ਗੁਰੂ ਮਕਰਕਾ ਕਥਨੰ ॥",
      "transliteration": "ath tiratee guroo makarakaa kathana(n) ||",
      "translation": "Now begins the description of adopting Spider as the Third Guru",
      "punjabiViakhya": "ਹੁਣ ਤੀਜੇ ਗੁਰੂ ਮਕਰਕਾ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "अथ तृती गुरू मकरका कथनं ॥",
      "sourceLineId": "102660",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "102661",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚਉਬੀਸ ਗੁਰੂ ਕੀਨ ਜਿਹਾ ਭਾਤਾ ॥",
      "transliteration": "chaubees guroo keen jihaa bhaataa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਨਾਲ (ਦੱਤ ਨੇ) ਚੌਬੀਸ ਗੁਰੂ ਧਾਰਨ ਕੀਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "चउबीस गुरू कीन जिहा भाता ॥",
      "sourceLineId": "102662",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਬ ਸੁਨ ਲੇਹੁ ਕਹੋ ਇਹ ਬਾਤਾ ॥",
      "transliteration": "ab sun leh kaho ieh baataa ||",
      "translation": "Listen not to the manner in which Dutt adopted twenty-four Gurus",
      "punjabiViakhya": "ਹੁਣ ਇਹ ਗੱਲ ਦਸਦਾ ਹਾ, ਸੁਣ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "अब सुन लेहु कहो इह बाता ॥",
      "sourceLineId": "102663",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਏਕ ਮਕਰਕਾ ਦਤ ਨਿਹਾਰੀ ॥",
      "transliteration": "ek makarakaa dhat nihaaree ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਤ ਨੇ ਇਕ ਮਕੜੀ ('ਮਕਰਕਾ') ਵੇਖੀ",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "एक मकरका दत निहारी ॥",
      "sourceLineId": "102664",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਐਸ ਹ੍ਰਿਦੇ ਅਨੁਮਾਨ ਬਿਚਾਰੀ ॥੧੭੬॥",
      "transliteration": "aais hiradhe anumaan bichaaree ||176||",
      "translation": "He saw a spider and reflected in his mind.176.",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਮਨ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਵਿਚਾਰ ਕੀਤਾ ॥੧੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "ऐस हृदे अनुमान बिचारी ॥१७६॥",
      "sourceLineId": "102665",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਆਪਨ ਹੀਐ ਐਸ ਅਨੁਮਾਨਾ ॥",
      "transliteration": "aapan heeaai aais anumaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਮਨ ਵਿਚ ਅਜਿਹੇ ਵਿਚਾਰ ਨੂੰ ਬਣਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "आपन हीऐ ऐस अनुमाना ॥",
      "sourceLineId": "102666",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤੀਸਰ ਗੁਰੁ ਯਾਹਿ ਹਮ ਮਾਨਾ ॥",
      "transliteration": "teesar gur yaeh ham maanaa ||",
      "translation": "Contemplating in his mind, he said this, “I consider it my third Guru",
      "punjabiViakhya": "ਕਿ ਮੈਂ ਇਸ ਨੂੰ ਤੀਜਾ ਗੁਰੂ ਮੰਨਆ।",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "तीसर गुरु याहि हम माना ॥",
      "sourceLineId": "102667",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪ੍ਰੇਮ ਸੂਤ ਕੀ ਡੋਰਿ ਬਢਾਵੈ ॥",
      "transliteration": "prem soot kee ddor baddaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਮਕੜੀ ਵਾਗ ਜਦ) ਪ੍ਰੇਮ ਦੇ ਸੂਤਰ ਦੀ ਡੋਰ ਵਧਾਈ ਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "प्रेम सूत की डोरि बढावै ॥",
      "sourceLineId": "102668",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਬ ਹੀ ਨਾਥ ਨਿਰੰਜਨ ਪਾਵੈ ॥੧੭੭॥",
      "transliteration": "tab hee naath nira(n)jan paavai ||177||",
      "translation": "When the thread of love will extend, then only the Lord (Nath Niranjan-the unmanifested Brahman) will be realized.”177.",
      "punjabiViakhya": "ਤਦ ਹੀ ਨਿਰੰਜਨ ਸੁਆਮੀ ਨੂੰ ਪਾਇਆ ਜਾ ਸਕੇਗਾ ॥੧੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "तब ही नाथ निरंजन पावै ॥१७७॥",
      "sourceLineId": "102669",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਆਪਨ ਆਪੁ ਆਪ ਮੋ ਦਰਸੈ ॥",
      "transliteration": "aapan aap aap mo dharasai ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ ਮਕੜੀ ਆਪਣੇ ਆਪ ਨੂੰ ਜਾਲ ਵਿਚ ਵੇਖਦੀ ਹੈ) ਉਸੇ ਤਰ੍ਰਹਾ ਜਦ (ਜਿਗਿਆਸੂ) ਆਪਣੇ (ਅੰਦਰ) ਆਪਣੇ ਆਪ ਨੂੰ ਵੇਖਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "आपन आपु आप मो दरसै ॥",
      "sourceLineId": "102670",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅੰਤਰਿ ਗੁਰੂ ਆਤਮਾ ਪਰਸੈ ॥",
      "transliteration": "a(n)tar guroo aatamaa parasai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਅੰਦਰੋਂ ਹੀ ਆਤਮਾ ਰੂਪ ਗੁਰੂ ਦੇ ਦਰਸ਼ਨ ਹੋ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "अंतरि गुरू आतमा परसै ॥",
      "sourceLineId": "102671",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਏਕ ਛਾਡਿ ਕੈ ਅਨਤ ਨ ਧਾਵੈ ॥",
      "transliteration": "ek chhaadd kai anat na dhaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ ਉਸ) ਇਕ ਨੂੰ ਛਡ ਕੇ (ਮਨ) ਹੋਰ ਕਿਤੇ ਵਲ ਨਹੀਂ ਭਜੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "एक छाडि कै अनत न धावै ॥",
      "sourceLineId": "102672",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਬ ਹੀ ਪਰਮ ਤਤੁ ਕੋ ਪਾਵੈ ॥੧੭੮॥",
      "transliteration": "tab hee param tat ko paavai ||178||",
      "translation": "When the self will be visualized and within oneself the soul-Guru will be touched and the mind will not go anywhere else, leaving the ONE, then only the Supreme Essence will be realized.178.",
      "punjabiViakhya": "ਤਦ ਹੀ ਪਰਮ-ਤੱਤ੍ਵ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰ ਸਕੇਗਾ ॥੧੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "तब ही परम ततु को पावै ॥१७८॥",
      "sourceLineId": "102673",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਏਕ ਸਰੂਪ ਏਕ ਕਰਿ ਦੇਖੈ ॥",
      "transliteration": "ek saroop ek kar dhekhai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਸਰੂਪ ਨੂੰ ਇਕੋ ਕਰ ਕੇ ਮੰਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "एक सरूप एक करि देखै ॥",
      "sourceLineId": "102674",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਆਨ ਭਾਵ ਕੋ ਭਾਵ ਨੇ ਪੇਖੈ ॥",
      "transliteration": "aan bhaav ko bhaav ne pekhai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦ੍ਵੈਤ ਭਾਵ ਦਾ ਪ੍ਰੇਮ ਨਾ ਵੇਖੇ।",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "आन भाव को भाव ने पेखै ॥",
      "sourceLineId": "102675",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਏਕ ਆਸ ਤਜਿ ਅਨਤ ਨ ਧਾਵੈ ॥",
      "transliteration": "ek aas taj anat na dhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦੀ ਇੱਛਾ ਨੂੰ ਛਡ ਕੇ ਕਿਸੇ ਹੋਰ ਵਲ ਨਾ ਭਜੇ,",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "एक आस तजि अनत न धावै ॥",
      "sourceLineId": "102676",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਬ ਹੀ ਨਾਥ ਨਿਰੰਜਨ ਪਾਵੈ ॥੧੭੯॥",
      "transliteration": "tab hee naath nira(n)jan paavai ||179||",
      "translation": "When the form of one will be considered and seen as One and no other thought will come into the mind and keeping one objective before oneself, the mind will not run anywhere else, then the Lord (Nath Niranjan---the unmanifested Brahman).179.",
      "punjabiViakhya": "ਤਦ ਹੀ ਉਹ ਨਾਥ ਨਿਰੰਜਨ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰ ਸਕੇਗਾ ॥੧੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "तब ही नाथ निरंजन पावै ॥१७९॥",
      "sourceLineId": "102677",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕੇਵਲ ਅੰਗ ਰੰਗ ਤਿਹ ਰਾਚੈ ॥",
      "transliteration": "keval a(n)g ra(n)g teh raachai ||",
      "translation": "",
      "punjabiViakhya": "ਕੇਵਲ ਉਸ ਦੇ ਸਰੂਪ (ਅੰਗ) ਵਿਚ ਆਪਣੇ ਸਰੂਪ ਨੂੰ ਲੀਨ ਕਰੇ।",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "केवल अंग रंग तिह राचै ॥",
      "sourceLineId": "102678",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਏਕ ਛਾਡਿ ਰਸ ਨੇਕ ਨ ਮਾਚੈ ॥",
      "transliteration": "ek chhaadd ras nek na maachai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਰਸ ਨੂੰ ਛਡ ਕੇ ਹੋਰਨਾ (ਰਸਾ) ਵਿਚ ਮਗਨ ਨਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "एक छाडि रस नेक न माचै ॥",
      "sourceLineId": "102679",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪਰਮ ਤਤੁ ਕੋ ਧਿਆਨ ਲਗਾਵੈ ॥",
      "transliteration": "param tat ko dhiaan lagaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਪਰਮ ਤੱਤ੍ਵ ਵਿਚ (ਆਪਣਾ) ਧਿਆਨ ਲਗਾਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "परम ततु को धिआन लगावै ॥",
      "sourceLineId": "102680",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਬ ਹੀ ਨਾਥ ਨਿਰੰਜਨ ਪਾਵੈ ॥੧੮੦॥",
      "transliteration": "tab hee naath nira(n)jan paavai ||180||",
      "translation": "When the merger will be in only one and the mind will not be obsurbed in anyone else accept the ONE and meditate only on the supreme esselce, then it will realise the lord ( Nath Niranjan-the Unmanifasted brahman) 180",
      "punjabiViakhya": "ਤਦ ਹੀ ਨਿਰੰਜਨ ਸੁਆਮੀ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰ ਸਕੇਗਾ ॥੧੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "तब ही नाथ निरंजन पावै ॥१८०॥",
      "sourceLineId": "102681",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤੀਸਰ ਗੁਰੂ ਮਕਰਿਕਾ ਠਾਨੀ ॥",
      "transliteration": "teesar guroo makarikaa Thaanee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਪ੍ਰਕਾਰ) ਤੀਜਾ ਗੁਰੂ ਮਕਰਕਾ ਨੂੰ ਮੰਨ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "तीसर गुरू मकरिका ठानी ॥",
      "sourceLineId": "102682",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਗੇ ਚਲਾ ਦਤ ਅਭਿਮਾਨੀ ॥",
      "transliteration": "aage chalaa dhat abhimaanee ||",
      "translation": "Accepting the spider as the third Guru, the glorious Dutt moved further",
      "punjabiViakhya": "ਅਤੇ ਅਭਿਮਾਨੀ ਦੱਤ ਅਗੇ ਨੂੰ ਚਲ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "आगे चला दत अभिमानी ॥",
      "sourceLineId": "102683",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਾ ਕਰ ਭਾਵ ਹ੍ਰਿਦੇ ਮਹਿ ਲੀਨਾ ॥",
      "transliteration": "taa kar bhaav hiradhe meh leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਮਕੜੀ) ਦਾ ਭਾਵ (ਜਦ) ਇਸ ਤਰ੍ਰਹਾ ਹਿਰਦੇ ਵਿਚ ਧਾਰਨ ਕਰ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "ता कर भाव हृदे महि लीना ॥",
      "sourceLineId": "102684",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹਰਖਵੰਤ ਤਬ ਚਲਾ ਪ੍ਰਬੀਨਾ ॥੧੮੧॥",
      "transliteration": "harakhava(n)t tab chalaa prabeenaa ||181||",
      "translation": "Getting greatly pleased, he moved forward, adopting their connotation in his heart.181.",
      "punjabiViakhya": "ਤਦ ਪ੍ਰਸੰਨ ਚਿਤ ਹੋ ਕੇ ਪ੍ਰਬੀਨ (ਦੱਤ) ਅਗੇ ਚਲ ਪਿਆ ॥੧੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "हरखवंत तब चला प्रबीना ॥१८१॥",
      "sourceLineId": "102685",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਤਿ ਤ੍ਰਿਤੀ ਗੁਰੂ ਮਕਰਕਾ ਸਮਾਪਤੰ ॥੩॥",
      "transliteration": "eit tiratee guroo makarakaa samaapata(n) ||3||",
      "translation": "End of the adoption of Spider as the third Guru.",
      "punjabiViakhya": "ਇਥੇ ਤੀਜੇ ਗੁਰੂ ਮਕਰਕਾ ਦਾ ਪ੍ਰਸੰਗ ਸਮਾਪਤ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "इति तृती गुरू मकरका समापतं ॥३॥",
      "sourceLineId": "102686",
      "sourceShabadId": "9344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਥ ਬਕ ਚਤਰਥ ਗੁਰੂ ਕਥਨੰ ॥",
      "transliteration": "ath bak chatarath guroo kathana(n) ||",
      "translation": "Now begins the description of the fourth Guru Crane.",
      "punjabiViakhya": "ਹੁਣ ਬਕ (ਬਗੁਲਾ ਪੰਛੀ) ਚੌਥੇ ਗੁਰੂ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "अथ बक चतरथ गुरू कथनं ॥",
      "sourceLineId": "102687",
      "sourceShabadId": "9345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "102688",
      "sourceShabadId": "9345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਬੈ ਦਤ ਗੁਰੁ ਅਗੈ ਸਿਧਾਰਾ ॥",
      "transliteration": "jabai dhat gur agai sidhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਦੱਤ ਗੁਰੂ ਅਗੇ ਨੂੰ ਤੁਰ ਪਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "जबै दत गुरु अगै सिधारा ॥",
      "sourceLineId": "102689",
      "sourceShabadId": "9345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਛ ਰਾਸਕਰ ਬੈਠਿ ਨਿਹਾਰਾ ॥",
      "transliteration": "machh raasakar baiTh nihaaraa ||",
      "translation": "When Dutt moved forward, then after seeing the swarm of fish, he saw towards the meditating crane",
      "punjabiViakhya": "(ਤਦੋਂ) ਮੱਛੀਆਂ ਖਾਣ ਵਾਲਾ ('ਰਾਸਕਰ') ਬੈਠਿਆ ਹੋਇਆ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "मछ रासकर बैठि निहारा ॥",
      "sourceLineId": "102690",
      "sourceShabadId": "9345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਉਜਲ ਅੰਗ ਅਤਿ ਧਿਆਨ ਲਗਾਵੈ ॥",
      "transliteration": "aujal a(n)g at dhiaan lagaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਸਫ਼ੈਦ ਰੰਗ ਹੈ ਅਤੇ ਬਹੁਤ ਹੀ ਧਿਆਨ ਲਗਾਉਾਂਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "उजल अंग अति धिआन लगावै ॥",
      "sourceLineId": "102691",
      "sourceShabadId": "9345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮੋਨੀ ਸਰਬ ਬਿਲੋਕਿ ਲਜਾਵੈ ॥੧੮੨॥",
      "transliteration": "monee sarab bilok lajaavai ||182||",
      "translation": "His limbs were extremely white and seeing him all the silence-observing creatures felt shy.182.",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਸਾਰੇ ਮੋਨੀ ਸ਼ਰਮਸਾਰ ਹੋ ਜਾਦੇ ਹਨ ॥੧੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "मोनी सरब बिलोकि लजावै ॥१८२॥",
      "sourceLineId": "102692",
      "sourceShabadId": "9345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜੈਸਕ ਧਿਆਨ ਮਛ ਕੇ ਕਾਜਾ ॥",
      "transliteration": "jaisak dhiaan machh ke kaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਮੱਛੀ ਨੂੰ (ਪਕੜਨ ਲਈ ਬਗੁਲਾ) ਧਿਆਨ ਲਗਾਉਾਂਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "जैसक धिआन मछ के काजा ॥",
      "sourceLineId": "102693",
      "sourceShabadId": "9345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਲਾਵਤ ਬਕ ਨਾਵੈ ਨਿਰਲਾਜਾ ॥",
      "transliteration": "laavat bak naavai niralaajaa ||",
      "translation": "The meditation that was being observed by the crane, made his name shameful because of his meditativeness for fish",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ ਮਾੜਾ ਕਰਮ ਕਰਨ ਕਰ ਕੇ ਉਹ) ਬਗੁਲਾ ਆਪਣੇ ਨਾਮ ਨੂੰ ਲਾਜ ਲਗਾਉਾਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "लावत बक नावै निरलाजा ॥",
      "sourceLineId": "102694",
      "sourceShabadId": "9345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭਲੀ ਭਾਤਿ ਇਹ ਧਿਆਨ ਲਗਾਵੈ ॥",
      "transliteration": "bhalee bhaat ieh dhiaan lagaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਉਹ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਧਿਆਨ ਲਗਾਉਾਂਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "भली भाति इह धिआन लगावै ॥",
      "sourceLineId": "102695",
      "sourceShabadId": "9345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭਾਵ ਤਾਸ ਕੋ ਮੁਨਿ ਮਨ ਭਾਵੈ ॥੧੮੩॥",
      "transliteration": "bhaav taas ko mun man bhaavai ||183||",
      "translation": "He was observing meditation very nicely and with his silence, he was pleasing the sages.183.",
      "punjabiViakhya": "ਉਸ ਦਾ ਭਾਵ ਮੁਨੀ (ਦੱਤ) ਦੇ ਮਨ ਨੂੰ ਚੰਗਾ ਲਗਾ ਹੈ ॥੧੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "भाव तास को मुनि मन भावै ॥१८३॥",
      "sourceLineId": "102696",
      "sourceShabadId": "9345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਐਸੋ ਧਿਆਨ ਨਾਥ ਹਿਤ ਲਈਐ ॥",
      "transliteration": "aaiso dhiaan naath hit lieeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਜੇ) ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਧਿਆਨ ਪਰਮਾਤਮਾ (ਨੂੰ ਪ੍ਰਾਪਤ ਕਰਨ) ਲਈ ਲਗਾਈਏ,",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "ऐसो धिआन नाथ हित लईऐ ॥",
      "sourceLineId": "102697",
      "sourceShabadId": "9345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਬ ਹੀ ਪਰਮ ਪੁਰਖ ਕਹੁ ਪਈਐ ॥",
      "transliteration": "tab hee param purakh kahu pieeaai ||",
      "translation": "If such a medittativeness is observed for the sake of that Lord, He is realized in that way",
      "punjabiViakhya": "ਤਦ ਹੀ ਪਰਮ ਪੁਰਖ ਨੂੰ ਪਾ ਸਕੀਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "तब ही परम पुरख कहु पईऐ ॥",
      "sourceLineId": "102698",
      "sourceShabadId": "9345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮਛਾਤਕ ਲਖਿ ਦਤ ਲੁਭਾਨਾ ॥",
      "transliteration": "machhaatak lakh dhat lubhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੱਛੀਆਂ ਨੂੰ ਪਕੜਨ ਵਾਲੇ (ਬਗੁਲੇ) ਨੂੰ ਵੇਖ ਕੇ ਦੱਤ ਦਾ ਮਨ ਲੋਭਾਇਮਾਨ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "मछातक लखि दत लुभाना ॥",
      "sourceLineId": "102699",
      "sourceShabadId": "9345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚਤਰਥ ਗੁਰੂ ਤਾਸ ਅਨੁਮਾਨਾ ॥੧੮੪॥",
      "transliteration": "chatarath guroo taas anumaanaa ||184||",
      "translation": "Seeing the crane, Dutt was allured towards him and he accepted him as his fourth Guru.184.",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਚੌਥਾ ਗੁਰੂ ਮੰਨ ਲਿਆ ॥੧੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "चतरथ गुरू तास अनुमाना ॥१८४॥",
      "sourceLineId": "102700",
      "sourceShabadId": "9345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਤਿ ਮਛਾਤਕ ਚਤੁਰਥ ਗੁਰੂ ਸਮਾਪਤੰ ॥੪॥",
      "transliteration": "eit machhaatak chaturath guroo samaapata(n) ||4||",
      "translation": "End of the description of the adoption of Crane as the fourth Guru.",
      "punjabiViakhya": "ਇਥੇ 'ਮਛਾਤਕ' ਚੌਥੇ ਗੁਰੂ ਦਾ ਪ੍ਰਸੰਗ ਸਮਾਪਤ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "इति मछातक चतुरथ गुरू समापतं ॥४॥",
      "sourceLineId": "102701",
      "sourceShabadId": "9345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਥ ਬਿੜਾਲ ਪੰਚਮ ਗੁਰੂ ਨਾਮ ॥",
      "transliteration": "ath biRaal pa(n)cham guroo naam ||",
      "translation": "Now begins the description of the fifth Guru Tom Cat",
      "punjabiViakhya": "ਹੁਣ ਬਿੜਾਲ ਨਾ ਦੇ ਪੰਜਵੇਾਂ ਗੁਰੂ (ਦਾ ਕਥਨ)",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "अथ बिड़ाल पंचम गुरू नाम ॥",
      "sourceLineId": "102702",
      "sourceShabadId": "9346",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "102703",
      "sourceShabadId": "9346",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਆਗੇ ਚਲਾ ਦਤ ਮੁਨਿ ਰਾਈ ॥",
      "transliteration": "aage chalaa dhat mun raiee ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੇਸ਼ਠ ਮੁਨੀ ਦੱਤ ਅਗੇ ਚਲ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "आगे चला दत मुनि राई ॥",
      "sourceLineId": "102704",
      "sourceShabadId": "9346",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੀਸ ਜਟਾ ਕਹ ਜੂਟ ਛਕਾਈ ॥",
      "transliteration": "sees jaTaa keh jooT chhakaiee ||",
      "translation": "Dutt, the king of sages, having matted locks on his head, moved further",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਸਿਰ ਉਤੇ ਜਟਾਵਾ ਦਾ ਜੂੜਾ ਸ਼ੋਭਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 649,
      "hindi": "",
      "hindiTransliteration": "सीस जटा कह जूट छकाई ॥",
      "sourceLineId": "102705",
      "sourceShabadId": "9346",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0649_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦੇਖਾ ਏਕ ਬਿੜਾਲ ਜੁ ਆਗੇ ॥",
      "transliteration": "dhekhaa ek biRaal ju aage ||",
      "translation": "",
      "punjabiViakhya": "ਅਗੇ ਜਾ ਕੇ ਜੋ ਇਕ ਬਿਲਾ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
