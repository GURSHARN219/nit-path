{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 650,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0650_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਧਿਆਨ ਲਾਇ ਮੁਨਿ ਨਿਰਖਨ ਲਾਗੈ ॥੧੮੫॥",
      "transliteration": "dhiaan lai mun nirakhan laagai ||185||",
      "translation": "There he saw a Tom Cat, whom he continued ot scan attentively.185.",
      "punjabiViakhya": "ਤਾ ਮੁਨੀ ਧਿਆਨ ਪੂਰਵਕ ਉਸ ਨੂੰ ਵੇਖਣ ਲਗਾ ॥੧੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "धिआन लाइ मुनि निरखन लागै ॥१८५॥",
      "sourceLineId": "102707",
      "sourceShabadId": "9346",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮੂਸ ਕਾਜ ਜਸ ਲਾਵਤ ਧਿਆਨੂ ॥",
      "transliteration": "moos kaaj jas laavat dhiaanoo ||",
      "translation": "",
      "punjabiViakhya": "ਚੂਹੇ ਨੂੰ ਪਕੜਨ ਲਈ (ਜੋ ਇਹ) ਧਿਆਨ ਲਗਾਉਾਂਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "मूस काज जस लावत धिआनू ॥",
      "sourceLineId": "102708",
      "sourceShabadId": "9346",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਲਾਜਤ ਦੇਖਿ ਮਹੰਤ ਮਹਾਨੂੰ ॥",
      "transliteration": "laajat dhekh maha(n)t mahaanoo(n) ||",
      "translation": "Seeing his miditativeness for the rats, even the great hermits felt shy",
      "punjabiViakhya": "(ਉਸ ਧਿਆਨ ਨੂੰ) ਵੇਖ ਕੇ ਮਹਾਨ ਮਹੰਤ ਵੀ ਲਜਾ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "लाजत देखि महंत महानूँ ॥",
      "sourceLineId": "102709",
      "sourceShabadId": "9346",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਐਸ ਧਿਆਨ ਹਰਿ ਹੇਤ ਲਗਈਐ ॥",
      "transliteration": "aais dhiaan har het lagieeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਜੇ) ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਧਿਆਨ ਹਰਿ (ਦੀ ਪ੍ਰਾਪਤੀ) ਲਈ ਲਗਾਈਐ,",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "ऐस धिआन हरि हेत लगईऐ ॥",
      "sourceLineId": "102710",
      "sourceShabadId": "9346",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਬ ਹੀ ਨਾਥ ਨਿਰੰਜਨ ਪਈਐ ॥੧੮੬॥",
      "transliteration": "tab hee naath nira(n)jan pieeaai ||186||",
      "translation": "If such meditativeness is observed for the sake of the Lord, only then that unmanifested Brahman can be realized.186.",
      "punjabiViakhya": "ਤਦ ਹੀ ਨਿਰੰਜਨ ਸੁਆਮੀ ਦੀ ਪ੍ਰਾਪਤੀ ਹੋ ਸਕਦੀ ਹੈ ॥੧੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "तब ही नाथ निरंजन पईऐ ॥१८६॥",
      "sourceLineId": "102711",
      "sourceShabadId": "9346",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪੰਚਮ ਗੁਰੂ ਯਾਹਿ ਹਮ ਜਾਨਾ ॥",
      "transliteration": "pa(n)cham guroo yaeh ham jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਅਸੀਂ (ਆਪਣਾ) ਪੰਜਵਾ ਗੁਰੂ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "पंचम गुरू याहि हम जाना ॥",
      "sourceLineId": "102712",
      "sourceShabadId": "9346",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਯਾ ਕਹੁ ਭਾਵ ਹੀਐ ਅਨੁਮਾਨਾ ॥",
      "transliteration": "yaa kahu bhaav heeaai anumaanaa ||",
      "translation": "I shall consider him my fifth Guru, such a thought came to the mind of Dutt, the king of sages",
      "punjabiViakhya": "ਇਹ ਕਹਿ ਕੇ ਹਿਰਦੇ ਵਿਚ (ਇਹ) ਭਾਵ ਵਿਚਾਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "या कहु भाव हीऐ अनुमाना ॥",
      "sourceLineId": "102713",
      "sourceShabadId": "9346",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਐਸੀ ਭਾਤਿ ਧਿਆਨ ਜੋ ਲਾਵੈ ॥",
      "transliteration": "aaisee bhaat dhiaan jo laavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਜੋ ਧਿਆਨ ਲਗਾਵੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "ऐसी भाति धिआन जो लावै ॥",
      "sourceLineId": "102714",
      "sourceShabadId": "9346",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੋ ਨਿਹਚੈ ਸਾਹਿਬ ਕੋ ਪਾਵੈ ॥੧੮੭॥",
      "transliteration": "so nihachai saahib ko paavai ||187||",
      "translation": "He, who will meditate in such a way, he will assuredly realise the Lord.187.",
      "punjabiViakhya": "ਉਹ ਨਿਸਚੇ ਹੀ ਪ੍ਰਭੂ ('ਸਾਹਿਬ') ਨੂੰ ਪ੍ਰਾਪਤ ਕਰ ਲਵੇਗਾ ॥੧੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "सो निहचै साहिब को पावै ॥१८७॥",
      "sourceLineId": "102715",
      "sourceShabadId": "9346",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਤਿ ਬਿੜਾਲ ਪੰਚਮੋ ਗੁਰੂ ਸਮਾਪਤੰ ॥੫॥",
      "transliteration": "eit biRaal pa(n)chamo guroo samaapata(n) ||5||",
      "translation": "End of the description of the adoption of Tom Cat as the fifth Guru.",
      "punjabiViakhya": "ਇਥੇ 'ਬਿੜਾਲ' ਨਾ ਦੇ ਪੰਜਵੇਾਂ ਗੁਰੂ ਦਾ ਪ੍ਰਸੰਗ ਸਮਾਪਤ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "इति बिड़ाल पंचमो गुरू समापतं ॥५॥",
      "sourceLineId": "102716",
      "sourceShabadId": "9346",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਥ ਧੁਨੀਆ ਗੁਰੂ ਕਥਨੰ ॥",
      "transliteration": "ath dhuneeaa guroo kathana(n) ||",
      "translation": "Now begins the description of the Cotton Carder as the Guru",
      "punjabiViakhya": "ਹੁਣ ਧੁਨੀਆ ਗੁਰੂ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "अथ धुनीआ गुरू कथनं ॥",
      "sourceLineId": "102717",
      "sourceShabadId": "9347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "102718",
      "sourceShabadId": "9347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਗੇ ਚਲਾ ਰਾਜ ਸੰਨ੍ਯਾਸਾ ॥",
      "transliteration": "aage chalaa raaj sa(n)nayaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਨਿਆਸ ਰਾਜ (ਦੱਤ) ਅਗੇ ਤੁਰ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "आगे चला राज संन्यासा ॥",
      "sourceLineId": "102719",
      "sourceShabadId": "9347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਏਕ ਆਸ ਗਹਿ ਐਸ ਅਨਾਸਾ ॥",
      "transliteration": "ek aas geh aais anaasaa ||",
      "translation": "Leaving all other desires and keeping only one thought in his mind, Dutt, the king of Yogis moved further",
      "punjabiViakhya": "(ਜਿਸ ਨੇ) ਇਕ ਆਸ ਫੜ ਕੇ ਹੋਰ ਆਸਾ ਛਡ ਦਿੱਤੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "एक आस गहि ऐस अनासा ॥",
      "sourceLineId": "102720",
      "sourceShabadId": "9347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਹ ਇਕ ਰੂਮ ਧੁਨਖਤੋ ਲਹਾ ॥",
      "transliteration": "teh ik room dhunakhato lahaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਉਸ ਨੇ) ਇਕ 'ਰੂਮ' (ਪੇਾਂਜਾ) ਰੂੰ ਪਿੰਜਦਾ ਹੋਇਆ ਵੇਖਿਆ (ਜਿਸ ਨੇ ਕੋਲੋਂ ਸੈਨਾ ਲੰਘ ਜਾਣ ਤੇ ਵੀ ਕੰਮ ਵਲੋਂ ਧਿਆਨ ਨਹੀਂ ਹਟਾਇਆ)",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "तह इक रूम धुनखतो लहा ॥",
      "sourceLineId": "102721",
      "sourceShabadId": "9347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਐਸ ਭਾਤਿ ਮਨ ਸੌ ਮੁਨਿ ਕਹਾ ॥੧੮੮॥",
      "transliteration": "aais bhaat man sau mun kahaa ||188||",
      "translation": "There he saw a carder carding cotton and said thus in hiss mind188",
      "punjabiViakhya": "ਅਤੇ ਮੁਨੀ ਨੇ ਮਨ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਵਿਚਾਰਿਆ ॥੧੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "ऐस भाति मन सौ मुनि कहा ॥१८८॥",
      "sourceLineId": "102722",
      "sourceShabadId": "9347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਭੂਪ ਸੈਨ ਇਹ ਜਾਤ ਨ ਲਹੀ ॥",
      "transliteration": "bhoop sain ieh jaat na lahee ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿ ਇਸ ਪੇਾਂਜੇ) ਨੇ ਰਾਜੇ ਦੀ ਸੈਨਾ ਨੂੰ ਜਾਦਿਆਂ ਵੇਖਿਆ ਤਕ ਨਹੀਂ,",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "भूप सैन इह जात न लही ॥",
      "sourceLineId": "102723",
      "sourceShabadId": "9347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗ੍ਰੀਵਾ ਨੀਚ ਨੀਚ ਹੀ ਰਹੀ ॥",
      "transliteration": "greevaa neech neech hee rahee ||",
      "translation": "“This man has not seen all the army passing in front of him and his neck remained bowed",
      "punjabiViakhya": "(ਕੰਮ ਵਿਚ ਲਗੇ ਦੀ) ਗਰਦਨ ਨੀਵੀਂ ਦੀ ਨੀਵੀਂ ਹੀ ਰਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "ग्रीवा नीच नीच ही रही ॥",
      "sourceLineId": "102724",
      "sourceShabadId": "9347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਗਲ ਸੈਨ ਵਾਹੀ ਮਗ ਗਈ ॥",
      "transliteration": "sagal sain vaahee mag giee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਫੌਜ ਉਸ ਰਾਹ ਤੋਂ ਲੰਘ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "सगल सैन वाही मग गई ॥",
      "sourceLineId": "102725",
      "sourceShabadId": "9347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਾ ਕੌ ਨੈਕੁ ਖਬਰ ਨਹੀ ਭਈ ॥੧੮੯॥",
      "transliteration": "taa kau naik khabar nahee bhiee ||189||",
      "translation": "The whole army went on this path, but he was not conscious of that.”189.",
      "punjabiViakhya": "(ਪਰ) ਉਸ ਨੂੰ ਜ਼ਰਾ ਜਿੰਨੀ ਖ਼ਬਰ ਨਹੀਂ ਹੋਈ ॥੧੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "ता कौ नैकु खबर नही भई ॥१८९॥",
      "sourceLineId": "102726",
      "sourceShabadId": "9347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰੂਈ ਧੁਨਖਤੋ ਫਿਰਿ ਨ ਨਿਹਾਰਾ ॥",
      "transliteration": "rooiee dhunakhato fir na nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਰੂੰ ਪਿੰਜਦੇ ਹੋਇਆਂ ਫਿਰ ਕੇ ਵੇਖਿਆ ਹੀ ਨਹੀਂ,",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "रूई धुनखतो फिरि न निहारा ॥",
      "sourceLineId": "102727",
      "sourceShabadId": "9347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨੀਚ ਹੀ ਗ੍ਰੀਵਾ ਰਹਾ ਬਿਚਾਰਾ ॥",
      "transliteration": "neech hee greevaa rahaa bichaaraa ||",
      "translation": "While carding the cotton, he did not look back and this lowly person kept his neck bowed",
      "punjabiViakhya": "(ਉਸ) ਵਿਚਾਰੇ ਦੀ ਗਰਦਨ ਨੀਵੀਂ ਹੀ ਰਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "नीच ही ग्रीवा रहा बिचारा ॥",
      "sourceLineId": "102728",
      "sourceShabadId": "9347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦਤ ਬਿਲੋਕਿ ਹੀਏ ਮੁਸਕਾਨਾ ॥",
      "transliteration": "dhat bilok he'ee musakaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਵੇਖ ਕੇ ਦੱਤ ਹਿਰਦੇ ਵਿਚ ਮੁਸਕਰਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "दत बिलोकि हीए मुसकाना ॥",
      "sourceLineId": "102729",
      "sourceShabadId": "9347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਖਸਟਮ ਗੁਰੂ ਤਿਸੀ ਕਹੁ ਜਾਨਾ ॥੧੯੦॥",
      "transliteration": "khasaTam guroo tisee kahu jaanaa ||190||",
      "translation": "Seeing him, Dutt smiled in his mind and said, “I accept him as my sixth Guru.”190.",
      "punjabiViakhya": "ਉਸੇ ਨੂੰ ਛੇਵਾ ਗੁਰੂ ਜਾਣ ਲਿਆ ॥੧੯੦॥",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "खसटम गुरू तिसी कहु जाना ॥१९०॥",
      "sourceLineId": "102730",
      "sourceShabadId": "9347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਰੂਮ ਹੇਤ ਇਹ ਜਿਮ ਚਿਤੁ ਲਾਯੋ ॥",
      "transliteration": "room het ieh jim chit laayo ||",
      "translation": "",
      "punjabiViakhya": "ਰੂੰ (ਪਿੰਜਣ) ਲਈ ਇਸ ਨੇ ਜਿਵੇਾਂ ਚਿਤ ਲਾਇਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "रूम हेत इह जिम चितु लायो ॥",
      "sourceLineId": "102731",
      "sourceShabadId": "9347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੈਨ ਗਈ ਪਰੁ ਸਿਰ ਨ ਉਚਾਯੋ ॥",
      "transliteration": "sain giee par sir na uchaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੈਨਾ ਲੰਘ ਗਈ, ਪਰ (ਇਸ ਨੇ) ਸਿਰ ਨਹੀਂ ਚੁਕਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "सैन गई परु सिर न उचायो ॥",
      "sourceLineId": "102732",
      "sourceShabadId": "9347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੈਸੀਏ ਪ੍ਰਭ ਸੌ ਪ੍ਰੀਤਿ ਲਗਈਐ ॥",
      "transliteration": "taise'ee prabh sau preet lagieeaai ||",
      "translation": "",
      "punjabiViakhya": "ਅਜਿਹੀ ਹੀ ਪ੍ਰੀਤ ਪ੍ਰਭੂ ਨਾਲ ਲਾਣੀ ਚਾਹੀਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "तैसीए प्रभ सौ प्रीति लगईऐ ॥",
      "sourceLineId": "102733",
      "sourceShabadId": "9347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਬ ਹੀ ਪੁਰਖ ਪੁਰਾਤਨ ਪਈਐ ॥੧੯੧॥",
      "transliteration": "tab hee purakh puraatan pieeaai ||191||",
      "translation": "The way in which he absorbed his mind in cotton and the army passed away and he did not raise his head, in the same way, when the Lord will be loved, then that ancient Purusha i.e. the Lord will be realized.191.",
      "punjabiViakhya": "ਤਦ ਹੀ (ਉਸ) ਪੁਰਾਤਨ ਪੁਰਖ ਨੂੰ ਪਾਈਦਾ ਹੈ ॥੧੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "तब ही पुरख पुरातन पईऐ ॥१९१॥",
      "sourceLineId": "102734",
      "sourceShabadId": "9347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਇਤਿ ਰੂਈ ਧੁਨਖਤਾ ਪੇਾਂਜਾ ਖਸਟਮੋ ਗੁਰੂ ਸਮਾਪਤੰ ॥੬॥",
      "transliteration": "eit rooiee dhunakhataa peaa(n)jaa khasaTamo guroo samaapata(n) ||6||",
      "translation": "End of the description of the adoption of Carder as the sixth Guru.",
      "punjabiViakhya": "ਇਥੇ ਰੂੰ ਧੁੰਨਦੇ ਪੇਾਂਜੇ ਛੇਵੇਾਂ ਗੁਰੂ ਦਾ ਪ੍ਰਸੰਗ ਸਮਾਪਤ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "इति रूई धुनखता पेाँजा खसटमो गुरू समापतं ॥६॥",
      "sourceLineId": "102735",
      "sourceShabadId": "9347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਥ ਮਾਛੀ ਸਪਤਮੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "transliteration": "ath maachhee sapatamo guroo kathana(n) ||",
      "translation": "Now begins the description of Fisherman as the Seventh Guru",
      "punjabiViakhya": "ਹੁਣ ਮਾਛੀ ਸੱਤਵੇਾਂ ਗੁਰੂ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "अथ माछी सपतमो गुरू कथनं ॥",
      "sourceLineId": "102736",
      "sourceShabadId": "9348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "102737",
      "sourceShabadId": "9348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਆਗੇ ਚਲਾ ਰਾਜ ਸੰਨ੍ਯਾਸਾ ॥",
      "transliteration": "aage chalaa raaj sa(n)nayaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਨਿਆਸ ਰਾਜ (ਦੱਤ) ਅਗੇ ਨੂੰ ਤੁਰ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "आगे चला राज संन्यासा ॥",
      "sourceLineId": "102738",
      "sourceShabadId": "9348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਹਾ ਬਿਮਲ ਮਨ ਭਯੋ ਉਦਾਸਾ ॥",
      "transliteration": "mahaa bimal man bhayo udhaasaa ||",
      "translation": "That great ascetic Dutt, of the pure mind moved further",
      "punjabiViakhya": "(ਜਿਸ ਦੀ ਬੁੱਧੀ) ਮਹਾਨ ਨਿਰਮਲ ਹੈ ਅਤੇ ਮਨ ਵਿਰਕਤ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "महा बिमल मन भयो उदासा ॥",
      "sourceLineId": "102739",
      "sourceShabadId": "9348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਿਰਖਾ ਤਹਾ ਏਕ ਮਛਹਾ ॥",
      "transliteration": "nirakhaa tahaa ek machhahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਕ ਮਾਛੀ (ਮੱਛੀਆਂ ਪਕੜਨ ਵਾਲਾ) ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "निरखा तहा एक मछहा ॥",
      "sourceLineId": "102740",
      "sourceShabadId": "9348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਲਏ ਜਾਰ ਕਰਿ ਜਾਤ ਨ ਕਹਾ ॥੧੯੨॥",
      "transliteration": "le jaar kar jaat na kahaa ||192||",
      "translation": "There he saw a Fisherman going with his net.192.",
      "punjabiViakhya": "(ਜੋ) ਹੱਥ ਵਿਚ ਜਾਲ ਲਈ ਜਾ ਰਿਹਾ ਸੀ (ਜਿਸ ਦਾ) ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ ॥੧੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "लए जार करि जात न कहा ॥१९२॥",
      "sourceLineId": "102741",
      "sourceShabadId": "9348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਿਨਛੀ ਏਕ ਹਾਥ ਮੋ ਧਾਰੇ ॥",
      "transliteration": "binachhee ek haath mo dhaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਹੱਥ ਵਿਚ ਇਕ ਕੁੰਡੀ ਵਾਲੀ ਸੋਟੀ ('ਬਿਨਛੀ') ਪਕੜੀ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "बिनछी एक हाथ मो धारे ॥",
      "sourceLineId": "102742",
      "sourceShabadId": "9348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਰੀਆ ਅੰਧ ਕੰਧ ਪਰ ਡਾਰੇ ॥",
      "transliteration": "jareeaa a(n)dh ka(n)dh par ddaare ||",
      "translation": "He was holding his lance in one of his hands and was carrying the net on one shoulder",
      "punjabiViakhya": "ਉਸ ਨੇ ਮੋਢਿਆਂ ਉਤੇ ਜਾਲੀਆਂ ਧਰੀਆਂ ਹੋਈਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "जरीआ अंध कंध पर डारे ॥",
      "sourceLineId": "102743",
      "sourceShabadId": "9348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਇਸਥਿਤ ਏਕ ਮਛਿ ਕੀ ਆਸਾ ॥",
      "transliteration": "eisathit ek machh kee aasaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਮੱਛੀ ਦੇ ਸ਼ਿਕਾਰ ਵਿਚ ਮਗਨ) ਅੰਨ੍ਰਹਿਆਂ ਵਾਗ (ਚਲਦਾ ਜਾ ਰਿਹਾ ਸੀ)। ਉਹ ਇਕ ਮੱਛੀ ਦੀ ਆਸ ਵਿਚ ਸਥਿਤ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "इसथित एक मछि की आसा ॥",
      "sourceLineId": "102744",
      "sourceShabadId": "9348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਾਨੁਕ ਵਾ ਕੇ ਮਧ ਨ ਸਾਸਾ ॥੧੯੩॥",
      "transliteration": "jaanuk vaa ke madh na saasaa ||193||",
      "translation": "He was standing there for the sake of the fish in such a way as if his body had become breathless.193.",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਉਸ ਵਿਚ ਸਾਹ ਹੀ ਨਹੀਂ ਹੈ ॥੧੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "जानुक वा के मध न सासा ॥१९३॥",
      "sourceLineId": "102745",
      "sourceShabadId": "9348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਏਕਸੁ ਠਾਢ ਮਛ ਕੀ ਆਸੂ ॥",
      "transliteration": "ekas Thaadd machh kee aasoo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਇਕ ਮੱਛੀ ਦੀ ਆਸ ਵਿਚ ਖੜੋਤਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "एकसु ठाढ मछ की आसू ॥",
      "sourceLineId": "102746",
      "sourceShabadId": "9348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰਾਜ ਪਾਟ ਤੇ ਜਾਨ ਉਦਾਸੂ ॥",
      "transliteration": "raaj paaT te jaan udhaasoo ||",
      "translation": "He was standing with the desire of catching one fish in such a way as if someone standing with patience and detached from all his paraphernalia",
      "punjabiViakhya": "ਮਾਨੋ ਰਾਜ ਪਾਟ ਤੋਂ ਵੀ ਉਹ ਵਿਰਕਤ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "राज पाट ते जान उदासू ॥",
      "sourceLineId": "102747",
      "sourceShabadId": "9348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਨੇਹ ਨਾਥ ਸੌ ਲਈਐ ॥",
      "transliteration": "eeh bidh neh naath sau lieeaai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਨਾਲ ਪ੍ਰਭੂ ਨਾਲ ਪ੍ਰੇਮ ਲਾਈਏ,",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "इह बिधि नेह नाथ सौ लईऐ ॥",
      "sourceLineId": "102748",
      "sourceShabadId": "9348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਬ ਹੀ ਪੂਰਨ ਪੁਰਖ ਕਹ ਪਈਐ ॥੧੯੪॥",
      "transliteration": "tab hee pooran purakh keh pieeaai ||194||",
      "translation": "Dutt thought that if such a love was observed for the sake of the Lord, then that perfect Purusha i.e. the Lo",
      "punjabiViakhya": "ਤਦ ਹੀ ਪਰਮ ਪੁਰਖ ਨੂੰ ਪਾਇਆ ਜਾ ਸਕੀਦਾ ਹੈ ॥੧੯੪॥",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "तब ही पूरन पुरख कह पईऐ ॥१९४॥",
      "sourceLineId": "102749",
      "sourceShabadId": "9348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇਤਿ ਮਾਛੀ ਗੁਰੂ ਸਪਤਮੋ ਸਮਾਪਤੰ ॥੭॥",
      "transliteration": "eit maachhee guroo sapatamo samaapata(n) ||7||",
      "translation": "End of the description of the adoption of Fisherman as the seventh Guru.",
      "punjabiViakhya": "ਇਥੇ ਮਾਛੀ ਸੱਤਵੇਾਂ ਗੁਰੂ ਦਾ ਪ੍ਰਸੰਗ ਸਮਾਪਤ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "इति माछी गुरू सपतमो समापतं ॥७॥",
      "sourceLineId": "102750",
      "sourceShabadId": "9348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਥ ਚੇਰੀ ਅਸਟਮੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "transliteration": "ath cheree asaTamo guroo kathana(n) ||",
      "translation": "Now begins the description of he adopt of Maid-servant as the Eighth Guru",
      "punjabiViakhya": "ਹੁਣ ਚੇਰੀ (ਦਾਸੀ) ਅੱਠਵੇਾਂ ਗੁਰੂ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "अथ चेरी असटमो गुरू कथनं ॥",
      "sourceLineId": "102751",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "102752",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਰਖਤ ਅੰਗ ਸੰਗ ਸੈਨਾ ਸੁਨਿ ॥",
      "transliteration": "harakhat a(n)g sa(n)g sainaa sun ||",
      "translation": "",
      "punjabiViakhya": "ਦਕਸ਼ ਪ੍ਰਜਾਪਤੀ (ਦੇ ਘਰ) ਮੁਨੀ (ਦੱਤ) ਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 650,
      "hindi": "",
      "hindiTransliteration": "हरखत अंग संग सैना सुनि ॥",
      "sourceLineId": "102753",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0650_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਆਯੋ ਦਛ ਪ੍ਰਜਾਪਤਿ ਕੇ ਮੁਨਿ ॥",
      "transliteration": "aayo dhachh prajaapat ke mun ||",
      "translation": "When the sage Dutt reached the abode of Daksha Prajapati, he was greatly pleased alongwith his army",
