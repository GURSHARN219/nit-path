{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 651,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0651_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਹਾ ਏਕ ਚੇਰਕਾ ਨਿਹਾਰੀ ॥",
      "transliteration": "tahaa ek cherakaa nihaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ ਦੱਤ ਨੇ) ਉਥੇ ਇਕ ਦਾਸੀ ਵੇਖੀ",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "तहा एक चेरका निहारी ॥",
      "sourceLineId": "102755",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚੰਦਨ ਘਸਤ ਮਨੋ ਮਤਵਾਰੀ ॥੧੯੫॥",
      "transliteration": "cha(n)dhan ghasat mano matavaaree ||195||",
      "translation": "There the sage Dutt saw a maid-servant, who, being intoxicated, was rubbing the sandalwood.195.",
      "punjabiViakhya": "ਜੋ ਚੰਦਨ ਘਿਸ ਰਹੀ ਸੀ, ਮਾਨੋ ਮਤਵਾਲੀ ਹੋਵੇ ॥੧੯੫॥",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "चंदन घसत मनो मतवारी ॥१९५॥",
      "sourceLineId": "102756",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚੰਦਨ ਘਸਤ ਨਾਰਿ ਸੁਭ ਧਰਮਾ ॥",
      "transliteration": "cha(n)dhan ghasat naar subh dharamaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸ਼ੁਭ ਆਚਾਰ ਵਾਲੀ ਇਸਤਰੀ",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "चंदन घसत नारि सुभ धरमा ॥",
      "sourceLineId": "102757",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਏਕ ਚਿਤ ਹ੍ਵੈ ਆਪਨ ਘਰ ਮਾ ॥",
      "transliteration": "ek chit havai aapan ghar maa ||",
      "translation": "That lady of good conduct was grinding sandalwood single-mindedly in her home",
      "punjabiViakhya": "ਇਕ ਮਨ ਹੋ ਕੇ ਘਰ ਵਿਚ ਚੰਦਨ ਘਸ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "एक चित ह्वै आपन घर मा ॥",
      "sourceLineId": "102758",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਏਕ ਚਿਤ ਨਹੀ ਚਿਤ ਚਲਾਵੈ ॥",
      "transliteration": "ek chit nahee chit chalaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਇਕਾਗਰ ਚਿਤ ਸੀ ਅਤੇ ਚਿਤ ਨੂੰ ਚੰਚਲ ਨਹੀਂ ਹੋਣ ਦੇ ਰਹੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "एक चित नही चित चलावै ॥",
      "sourceLineId": "102759",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪ੍ਰਿਤਮਾ ਚਿਤ੍ਰ ਬਿਲੋਕਿ ਲਜਾਵੈ ॥੧੯੬॥",
      "transliteration": "piratamaa chitr bilok lajaavai ||196||",
      "translation": "She had concentrated her mind and seeing her even the portrait was getting shy.196.",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਕਾਗ਼ਜ਼ ਉਤੇ ਬਣੀ ਤਸਵੀਰ ਵੀ ਸ਼ਰਮਿੰਦੀ ਹੁੰਦੀ ਸੀ ॥੧੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "पृतमा चित्र बिलोकि लजावै ॥१९६॥",
      "sourceLineId": "102760",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦਤ ਲਏ ਸੰਨ੍ਯਾਸਨ ਸੰਗਾ ॥",
      "transliteration": "dhat le sa(n)nayaasan sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਤ ਸੰਨਿਆਸੀਆਂ ਨੂੰ ਨਾਲ ਲੈ ਕੇ ਉਸ ਕੋਲੋਂ,",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "दत लए संन्यासन संगा ॥",
      "sourceLineId": "102761",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਾਤ ਭਯੋ ਤਹ ਭੇਟਤ ਅੰਗਾ ॥",
      "transliteration": "jaat bhayo teh bheTat a(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਸ਼ਰੀਰ ਛੋਂਦੇ ਹੋਇਆਂ ਲੰਘ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "जात भयो तह भेटत अंगा ॥",
      "sourceLineId": "102762",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੀਸ ਉਚਾਇ ਨ ਤਾਸ ਨਿਹਾਰਾ ॥",
      "transliteration": "sees uchai na taas nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ) ਉਸ ਨੇ ਸਿਰ ਚੁਕ ਕੇ ਨਹੀਂ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "सीस उचाइ न तास निहारा ॥",
      "sourceLineId": "102763",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰਾਵ ਰੰਕ ਕੋ ਜਾਤ ਬਿਚਾਰਾ ॥੧੯੭॥",
      "transliteration": "raav ra(n)k ko jaat bichaaraa ||197||",
      "translation": "Dutt went that way alongwith the Sannyasis in order to meet her, but she did not raise her head and see whether some king or some pauper was going.197.",
      "punjabiViakhya": "ਕਿ ਕੌਣ ਰਾਜਾ ਜਾ ਰੰਕ ਵਿਚਾਰਾ ਕੋਲੋਂ ਲੰਘਿਆ ਹੈ ॥੧੯੭॥",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "राव रंक को जात बिचारा ॥१९७॥",
      "sourceLineId": "102764",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਾ ਕੋ ਦਤ ਬਿਲੋਕਿ ਪ੍ਰਭਾਵਾ ॥",
      "transliteration": "taa ko dhat bilok prabhaavaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਦੱਤ ਪ੍ਰਭਾਵਿਤ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "ता को दत बिलोकि प्रभावा ॥",
      "sourceLineId": "102765",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਸਟਮ ਗੁਰੂ ਤਾਹਿ ਠਹਰਾਵਾ ॥",
      "transliteration": "asaTam guroo taeh Thaharaavaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਅੱਠਵਾ ਗੁਰੂ ਮੰਨ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "असटम गुरू ताहि ठहरावा ॥",
      "sourceLineId": "102766",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਧੰਨਿ ਧੰਨਿ ਇਹ ਚੇਰਕਾ ਸਭਾਗੀ ॥",
      "transliteration": "dha(n)n dha(n)n ieh cherakaa sabhaagee ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਭਾਗਵਾਨ ਦਾਸੀ ਧੰਨ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "धंनि धंनि इह चेरका सभागी ॥",
      "sourceLineId": "102767",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਾ ਕੀ ਪ੍ਰੀਤਿ ਨਾਥ ਸੰਗਿ ਲਾਗੀ ॥੧੯੮॥",
      "transliteration": "jaa kee preet naath sa(n)g laagee ||198||",
      "translation": "Seeing her impact, Dutt accepted her as the eighth Guru and said, “Blessed is this maid-servant, who is absorbed in love with that Lord.”198.",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਪ੍ਰੀਤ ਸੁਆਮੀ ਨਾਲ ਲਗੀ ਹੋਈ ਹੈ ॥੧੯੮॥",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "जा की प्रीति नाथ संगि लागी ॥१९८॥",
      "sourceLineId": "102768",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਐਸ ਪ੍ਰੀਤਿ ਹਰਿ ਹੇਤ ਲਗਇਯੈ ॥",
      "transliteration": "aais preet har het lagiyai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦੀ ਪ੍ਰੀਤ ਪਰਮਾਤਮਾ ਨਾਲ ਲਗਾਈਏ,",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "ऐस प्रीति हरि हेत लगइयै ॥",
      "sourceLineId": "102769",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਬ ਹੀ ਨਾਥ ਨਿਰੰਜਨ ਪਇਯੈ ॥",
      "transliteration": "tab hee naath nira(n)jan piyai ||",
      "translation": "When such a love is observed with that Lord, then He is realized",
      "punjabiViakhya": "ਤਦ ਹੀ ਨਿਰੰਜਨ ਸੁਆਮੀ ਨੂੰ ਪ੍ਰਾਪਤ ਕੀਤਾ ਜਾ ਸਕਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "तब ही नाथ निरंजन पइयै ॥",
      "sourceLineId": "102770",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਿਨੁ ਚਿਤਿ ਦੀਨ ਹਾਥਿ ਨਹੀ ਆਵੈ ॥",
      "transliteration": "bin chit dheen haath nahee aavai ||",
      "translation": "",
      "punjabiViakhya": "(ਪ੍ਰੇਮ ਵਿਚ) ਬਿਨਾ ਚਿਤ ਦਿੱਤਿਆਂ (ਪ੍ਰਭੂ) ਹੱਥ ਨਹੀਂ ਆਉਾਂਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "बिनु चिति दीन हाथि नही आवै ॥",
      "sourceLineId": "102771",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚਾਰ ਬੇਦ ਇਮਿ ਭੇਦ ਬਤਾਵੈ ॥੧੯੯॥",
      "transliteration": "chaar bedh im bhedh bataavai ||199||",
      "translation": "He is not achieved without bringing humility in the mind and all the four Vedas tell this.199.",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦੀ ਭੇਦ (ਭਰੀ ਗੱਲ) ਚਾਰੇ ਵੇਦ ਦਸਦੇ ਹਨ ॥੧੯੯॥",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "चार बेद इमि भेद बतावै ॥१९९॥",
      "sourceLineId": "102772",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਇਤਿ ਚੇਰਕਾ ਅਸਟਮੋ ਗੁਰੂ ਸਮਾਪਤੰ ॥੮॥",
      "transliteration": "eit cherakaa asaTamo guroo samaapata(n) ||8||",
      "translation": "End of the description of the adoption of Maid-servant as the eighth Guru.",
      "punjabiViakhya": "ਇਥੇ ਦਾਸੀ ਅੱਠਵੇਾਂ ਗੁਰੂ ਦਾ ਪ੍ਰਸੰਗ ਸਮਾਪਤ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "इति चेरका असटमो गुरू समापतं ॥८॥",
      "sourceLineId": "102773",
      "sourceShabadId": "9349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਥ ਬਨਜਾਰਾ ਨਵਮੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "transliteration": "ath banajaaraa navamo guroo kathana(n) ||",
      "translation": "Now begins the description of the adoption of the Trader as the Ninth Guru.",
      "punjabiViakhya": "ਹੁਣ ਬਨਜਾਰਾ ਨੌਵੇਾਂ ਗੁਰੂ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "अथ बनजारा नवमो गुरू कथनं ॥",
      "sourceLineId": "102774",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "102775",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਆਗੇ ਚਲਾ ਜੋਗ ਜਟ ਧਾਰੀ ॥",
      "transliteration": "aage chalaa jog jaT dhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਗ ਅਤੇ ਜਟਾ ਨੂੰ ਧਾਰਨ ਕਰਨ ਵਲਾ (ਮੁਨੀ) ਅਗੇ ਚਲ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "आगे चला जोग जट धारी ॥",
      "sourceLineId": "102776",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਲਏ ਸੰਗਿ ਚੇਲਕਾ ਅਪਾਰੀ ॥",
      "transliteration": "le sa(n)g chelakaa apaaree ||",
      "translation": "Then taking his disciples alongwith him, Dutt, the Yogi with matted locks, moved further",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਬੇਅੰਤ ਚੇਲੇ ਨਾਲ ਲਏ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "लए संगि चेलका अपारी ॥",
      "sourceLineId": "102777",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੇਖਤ ਬਨਖੰਡ ਨਗਰ ਪਹਾਰਾ ॥",
      "transliteration": "dhekhat banakha(n)dd nagar pahaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬਨ-ਖੰਡਾ, ਨਗਰਾ ਅਤੇ ਪਹਾੜਾ ਨੂੰ ਵੇਖਦਾ ਚਲਾ ਜਾ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "देखत बनखंड नगर पहारा ॥",
      "sourceLineId": "102778",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਵਤ ਲਖਾ ਏਕ ਬਨਜਾਰਾ ॥੨੦੦॥",
      "transliteration": "aavat lakhaa ek banajaaraa ||200||",
      "translation": "When, passing through the forests, cities and mountains, they went forward, there they saw a trader coming.200.",
      "punjabiViakhya": "ਤਦ ਉਸ ਨੇ ਇਕ ਬਨਜਾਰਾ ਆਉਾਂਦਾ ਹੋਇਆ ਵੇਖਿਆ ॥੨੦੦॥",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "आवत लखा एक बनजारा ॥२००॥",
      "sourceLineId": "102779",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਧਨ ਕਰ ਭਰੇ ਸਬੈ ਭੰਡਾਰਾ ॥",
      "transliteration": "dhan kar bhare sabai bha(n)ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਧਨ ਨਾਲ ਜਿਸ ਦੇ ਸਾਰੇ ਭੰਡਾਰ ਭਰੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "धन कर भरे सबै भंडारा ॥",
      "sourceLineId": "102780",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚਲਾ ਸੰਗ ਲੈ ਟਾਡ ਅਪਾਰਾ ॥",
      "transliteration": "chalaa sa(n)g lai Taadd apaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬਹੁਤ ਸਾਰੇ (ਸਮਾਨ ਦੇ ਲਦੇ) ਬਲਦਾ ਦਾ ਝੁੰਡ ਨਾਲ ਲੈ ਕੇ ਚਲਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "चला संग लै टाड अपारा ॥",
      "sourceLineId": "102781",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਮਿਤ ਗਾਵ ਲਵੰਗਨ ਕੇ ਭਰੇ ॥",
      "transliteration": "amit gaav lava(n)gan ke bhare ||",
      "translation": "",
      "punjabiViakhya": "ਬੇਅੰਤ ਬੋਰੀਆਂ ('ਗਾਵ') ਲੌਂਗਾ ਦੀਆਂ ਭਰੀਆਂ ਹੋਈਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "अमित गाव लवंगन के भरे ॥",
      "sourceLineId": "102782",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਿਧਨਾ ਤੇ ਨਹੀ ਜਾਤ ਬਿਚਰੇ ॥੨੦੧॥",
      "transliteration": "bidhanaa te nahee jaat bichare ||201||",
      "translation": "His coffers were full of money and he was moving with a good deal of merchandise, he had many bags full of cloves and no one could enumerate them.201.",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦਾ) ਵਿਚਾਰ ਬ੍ਰਹਮਾ ਵੀ ਨਹੀਂ ਕਰ ਸਕਦਾ ਸੀ ॥੨੦੧॥",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "बिधना ते नही जात बिचरे ॥२०१॥",
      "sourceLineId": "102783",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰਾਤਿ ਦਿਵਸ ਤਿਨ ਦ੍ਰਬ ਕੀ ਆਸਾ ॥",
      "transliteration": "raat dhivas tin dhrab kee aasaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਰਾਤ ਦਿਨ ਧਨ ਦੀ ਇੱਛਾ ਰਹਿੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "राति दिवस तिन द्रब की आसा ॥",
      "sourceLineId": "102784",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬੇਚਨ ਚਲਾ ਛਾਡਿ ਘਰ ਵਾਸਾ ॥",
      "transliteration": "bechan chalaa chhaadd ghar vaasaa ||",
      "translation": "He desired for more wealth day and night and he had left his home for selling his articles",
      "punjabiViakhya": "(ਇਸ ਲਈ ਸੌਦੇ ਨੂੰ) ਵੇਚਣ ਲਈ ਘਰ ਦਾ ਵਾਸਾ ਛਡ ਕੇ ਚਲਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "बेचन चला छाडि घर वासा ॥",
      "sourceLineId": "102785",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਔਰ ਆਸ ਦੂਸਰ ਨਹੀ ਕੋਈ ॥",
      "transliteration": "aauar aas dhoosar nahee koiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਹੋਰ ਕੋਈ ਦੂਜੀ ਆਸ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "और आस दूसर नही कोई ॥",
      "sourceLineId": "102786",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਏਕੈ ਆਸ ਬਨਜ ਕੀ ਹੋਈ ॥੨੦੨॥",
      "transliteration": "ekai aas banaj kee hoiee ||202||",
      "translation": "He had no other desire except his trade.202.",
      "punjabiViakhya": "ਇਕੋ ਵਪਾਰ ਕਰਨ ਦੀ ਆਸ ਪਾਲੀ ਹੋਈ ਸੀ ॥੨੦੨॥",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "एकै आस बनज की होई ॥२०२॥",
      "sourceLineId": "102787",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਛਾਹ ਧੂਪ ਕੋ ਤ੍ਰਾਸ ਨ ਮਾਨੈ ॥",
      "transliteration": "chhaeh dhoop ko traas na maanai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਧੁਪ ਛਾ ਦਾ ਡਰ ਨਹੀਂ ਮੰਨਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "छाह धूप को त्रास न मानै ॥",
      "sourceLineId": "102788",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰਾਤਿ ਅਉ ਦਿਵਸ ਗਵਨ ਈ ਠਾਨੈ ॥",
      "transliteration": "raat aau dhivas gavan iee Thaanai ||",
      "translation": "He had no fear of sunshine and shade and he was always musing of moving forward day and night",
      "punjabiViakhya": "ਅਤੇ ਰਾਤ ਦਿਨ (ਬਸ) ਚਲਦਾ ਹੀ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "राति अउ दिवस गवन ई ठानै ॥",
      "sourceLineId": "102789",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪਾਪ ਪੁੰਨ ਕੀ ਅਉਰ ਨ ਬਾਤਾ ॥",
      "transliteration": "paap pu(n)n kee aaur na baataa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਪਾਪ ਪੁੰਨ ਦੀ ਕੋਈ ਹੋਰ ਗੱਲ ਨਹੀਂ ਜਾਣਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "पाप पुँन की अउर न बाता ॥",
      "sourceLineId": "102790",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਏਕੈ ਰਸ ਮਾਤ੍ਰਾ ਕੇ ਰਾਤਾ ॥੨੦੩॥",
      "transliteration": "ekai ras maatraa ke raataa ||203||",
      "translation": "He had no concern for virtue and vice and he was only absorbed in the relish of trade.203.",
      "punjabiViakhya": "(ਬਸ) ਇਕ ਮਾਇਆ ਦੇ ਰਸ ਵਿਚ ਮਗਨ ਸੀ ॥੨੦੩॥",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "एकै रस मात्रा के राता ॥२०३॥",
      "sourceLineId": "102791",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਾ ਕਹ ਦੇਖਿ ਦਤ ਹਰਿ ਭਗਤੂ ॥",
      "transliteration": "taa keh dhekh dhat har bhagatoo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਹਰਿ ਦੇ ਭਗਤ ਦੱਤ ਨੇ (ਵਿਚਾਰਿਆ)",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "ता कह देखि दत हरि भगतू ॥",
      "sourceLineId": "102792",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਾ ਕਰ ਰੂਪ ਜਗਤਿ ਜਗ ਮਗਤੂ ॥",
      "transliteration": "jaa kar roop jagat jag magatoo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜਿਸ ਹਰਿ ਦਾ ਰੂਪ ਜਗਤ ਵਿਚ ਜਗਮਗ ਕਰ ਰਿਹਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "जा कर रूप जगति जग मगतू ॥",
      "sourceLineId": "102793",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਐਸ ਭਾਤਿ ਜੋ ਸਾਹਿਬ ਧਿਆਈਐ ॥",
      "transliteration": "aais bhaat jo saahib dhiaaieeaai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਇਸ ਤਰ੍ਰਹਾ (ਮਗਨਤਾ ਨਾਲ) ਹਰਿ ਦੀ ਆਰਾਧਨਾ ਕਰੀਏ,",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "ऐस भाति जो साहिब धिआईऐ ॥",
      "sourceLineId": "102794",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਬ ਹੀ ਪੁਰਖ ਪੁਰਾਤਨ ਪਾਈਐ ॥੨੦੪॥",
      "transliteration": "tab hee purakh puraatan paieeaai ||204||",
      "translation": "Seeing him, Dutt, the devotee of the Lord, whose person was revered throughout the world, thought in his mind that in such manner the Lord be remembered, only then that Supreme Purusha i.e. the Lord can be realized.204.",
      "punjabiViakhya": "ਤਦ ਹੀ ਪਰਮ ਪੁਰਖ ਦੀ ਪ੍ਰਾਪਤੀ ਹੋ ਸਕਦੀ ਹੈ ॥੨੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "तब ही पुरख पुरातन पाईऐ ॥२०४॥",
      "sourceLineId": "102795",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਇਤਿ ਬਨਜਾਰਾ ਨਉਮੋ ਗੁਰੂ ਸਮਾਪਤੰ ॥੯॥",
      "transliteration": "eit banajaaraa naumo guroo samaapata(n) ||9||",
      "translation": "End of the description of the adoption of he Trader as the Ninth Guru.",
      "punjabiViakhya": "ਇਥੇ 'ਬਨਜਾਰਾ' ਨੌਵੇ ਗੁਰੂ ਦਾ ਪ੍ਰਸੰਗ ਸਮਾਪਤ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "इति बनजारा नउमो गुरू समापतं ॥९॥",
      "sourceLineId": "102796",
      "sourceShabadId": "9350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਥ ਕਾਛਨ ਦਸਮੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "transliteration": "ath kaachhan dhasamo guroo kathana(n) ||",
      "translation": "Now begins the description of the adoption of the Lady-Gardener as the Tenth Guru.",
      "punjabiViakhya": "ਹੁਣ ਦਸਵੇਾਂ ਗੁਰੂ 'ਕਾਛਨ' ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "अथ काछन दसमो गुरू कथनं ॥",
      "sourceLineId": "102797",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "102798",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚਲਾ ਮੁਨੀ ਤਜਿ ਪਰਹਰਿ ਆਸਾ ॥",
      "transliteration": "chalaa munee taj parahar aasaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੋਂ) ਮੁਨੀ ਦੱਤ ਤਿਆਗਣ ਯੋਗ ਆਸ਼ਾ ਨੂੰ ਛਡ ਕੇ ਚਲ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "चला मुनी तजि परहरि आसा ॥",
      "sourceLineId": "102799",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਹਾ ਮੋਨਿ ਅਰੁ ਮਹਾ ਉਦਾਸਾ ॥",
      "transliteration": "mahaa mon ar mahaa udhaasaa ||",
      "translation": "The sage forsaking all desires and observing great silence moved further in a state of apathy",
      "punjabiViakhya": "(ਜੋ) ਮਹਾਨ ਮੋਨੀ ਅਤੇ ਮਹਾਨ ਉਦਾਸੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "महा मोनि अरु महा उदासा ॥",
      "sourceLineId": "102800",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪਰਮ ਤਤ ਬੇਤਾ ਬਡਭਾਗੀ ॥",
      "transliteration": "param tat betaa baddabhaagee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਪਰਮ ਤੱਤ੍ਵ ਨੂੰ ਜਾਣਨ ਵਾਲਾ ਵਡਭਾਗੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "परम तत बेता बडभागी ॥",
      "sourceLineId": "102801",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0651_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮਹਾ ਮੋਨ ਹਰਿ ਕੋ ਅਨੁਰਾਗੀ ॥੨੦੫॥",
      "transliteration": "mahaa mon har ko anuraagee ||205||",
      "translation": "He was a great knower of the Essence, a silence-observer and a lover of the Lord.205.",
      "punjabiViakhya": "(ਉਹ) ਮਹਾ ਮੋਨ ਧਾਰੀ ਹਰਿ ਦਾ ਪ੍ਰੇਮੀ ਹੈ ॥੨੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 651,
      "hindi": "",
      "hindiTransliteration": "महा मोन हरि को अनुरागी ॥२०५॥",
      "sourceLineId": "102802",
      "sourceShabadId": "9351",
