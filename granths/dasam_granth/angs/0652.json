{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 652,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0652_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪਰਮ ਪੁਰਖ ਪੂਰੋ ਬਡਭਾਗੀ ॥",
      "transliteration": "param purakh pooro baddabhaagee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਪਰਮ ਪੁਰਖ ਅਤੇ ਪੂਰਾ ਵਡਭਾਗੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "परम पुरख पूरो बडभागी ॥",
      "sourceLineId": "102803",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਹਾ ਮੁਨੀ ਹਰਿ ਕੇ ਰਸ ਪਾਗੀ ॥",
      "transliteration": "mahaa munee har ke ras paagee ||",
      "translation": "He was a great sage, absorbed in the love of he Supreme Purusha i.e. the Lord",
      "punjabiViakhya": "ਅਤੇ (ਉਹ) ਮਹਾ ਮੁਨੀ ਹਰਿ ਦੇ ਰਸ ਵਿਚ (ਪੂਰੀ ਤਰ੍ਰਹਾ) ਭਿਜਿਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "महा मुनी हरि के रस पागी ॥",
      "sourceLineId": "102804",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬ੍ਰਹਮ ਭਗਤ ਖਟ ਗੁਨ ਰਸ ਲੀਨਾ ॥",
      "transliteration": "braham bhagat khaT gun ras leenaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬ੍ਰਹਮ ਦੀ ਭਗਤੀ ਦੇ ਰਸ ਅਤੇ ਛੇ ਗੁਣਾ ਵਿਚ ਲੀਨ ਹੋ ਚੁਕਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "ब्रहम भगत खट गुन रस लीना ॥",
      "sourceLineId": "102805",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਏਕ ਨਾਮ ਕੇ ਰਸ ਸਉ ਭੀਨਾ ॥੨੦੬॥",
      "transliteration": "ek naam ke ras sau bheenaa ||206||",
      "translation": "He was a devotee of Brahman, the knower of he philosophies of the six Shastras and the one who remained absorbed in the Name of the Lord.206.",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਨਾਮ ਦੇ ਰਸ ਵਿਚ ਭਿਜਿਆ ਹੋਇਆ ਹੈ ॥੨੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "एक नाम के रस सउ भीना ॥२०६॥",
      "sourceLineId": "102806",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਉਜਲ ਗਾਤ ਮਹਾ ਮੁਨਿ ਸੋਹੈ ॥",
      "transliteration": "aujal gaat mahaa mun sohai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਮਹਾਮੁਨੀ ਦਾ ਸਫ਼ੈਦ ਸ਼ਰੀਰ ਸੋਭ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "उजल गात महा मुनि सोहै ॥",
      "sourceLineId": "102807",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੁਰ ਨਰ ਮੁਨਿ ਸਭ ਕੋ ਮਨ ਮੋਹੈ ॥",
      "transliteration": "sur nar mun sabh ko man mohai ||",
      "translation": "The white body of the great sage was alluring the gods, men and sages",
      "punjabiViakhya": "ਜੋ ਦੇਵਤਿਆਂ, ਮਨੁੱਖਾ ਅਤੇ ਮੁਨੀਆਂ ਸਭ ਦੇ ਮਨ ਨੂੰ ਮੋਹ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "सुर नर मुनि सभ को मन मोहै ॥",
      "sourceLineId": "102808",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਹ ਜਹ ਜਾਇ ਦਤ ਸੁਭ ਕਰਮਾ ॥",
      "transliteration": "jeh jeh jai dhat subh karamaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਜਿਸ ਥਾ ਤੇ ਸ਼ੁਭ ਕਰਮਾ ਵਾਲਾ ਦੱਤ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "जह जह जाइ दत सुभ करमा ॥",
      "sourceLineId": "102809",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਹ ਤਹ ਹੋਤ ਸਭੈ ਨਿਹਕਰਮਾ ॥੨੦੭॥",
      "transliteration": "teh teh hot sabhai nihakaramaa ||207||",
      "translation": "Wherever Dutt, the sage performing good actions went, all those who resided there, achieved passivity.207.",
      "punjabiViakhya": "ਉਥੇ ਉਥੇ ਸਾਰੇ ਨਿਸ਼ਕਰਮ (ਕਰਮਾ ਦੇ ਬੰਧਨ ਤੋਂ ਮੁਕਤ) ਹੋ ਗਏ ॥੨੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "तह तह होत सभै निहकरमा ॥२०७॥",
      "sourceLineId": "102810",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭਰਮ ਮੋਹ ਤਿਹ ਦੇਖਤ ਭਾਗੈ ॥",
      "transliteration": "bharam moh teh dhekhat bhaagai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਭਰਮ ਅਤੇ ਮੋਹ ਭਜ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "भरम मोह तिह देखत भागै ॥",
      "sourceLineId": "102811",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰਾਮ ਭਗਤਿ ਸਭ ਹੀ ਉਠਿ ਲਾਗੈ ॥",
      "transliteration": "raam bhagat sabh hee uTh laagai ||",
      "translation": "Seeing him, all the illusions, attachment etc, fled away and all were absorbed in the devotion of the Lord",
      "punjabiViakhya": "ਸਾਰੇ ਉਠ ਕੇ ਰਾਮ ਭਗਤੀ ਵਿਚ ਲਗ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "राम भगति सभ ही उठि लागै ॥",
      "sourceLineId": "102812",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪਾਪ ਤਾਪ ਸਭ ਦੂਰ ਪਰਾਈ ॥",
      "transliteration": "paap taap sabh dhoor paraiee ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਪਾਪ ਅਤੇ ਤਾਪ ਦੂਰ ਭਜ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "पाप ताप सभ दूर पराई ॥",
      "sourceLineId": "102813",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਿਸਿ ਦਿਨ ਰਹੈ ਏਕ ਲਿਵ ਲਾਈ ॥੨੦੮॥",
      "transliteration": "nis dhin rahai ek liv laiee ||208||",
      "translation": "The sins and ailments of all were destroyed, all remained engrossed in the meditation of one Lord.208.",
      "punjabiViakhya": "ਰਾਤ ਦਿਨ (ਨਾਮ ਸਿਮਰਨ ਵਿਚ) ਲਿਵ ਲਗਾਈ ਰਖਦੇ ਹਨ ॥੨੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "निसि दिन रहै एक लिव लाई ॥२०८॥",
      "sourceLineId": "102814",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਾਛਨ ਏਕ ਤਹਾ ਮਿਲ ਗਈ ॥",
      "transliteration": "kaachhan ek tahaa mil giee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ (ਉਸ ਨੂੰ) ਇਕ ਕਾਛਨ (ਕੱਛ ਦੇਸ ਦੀ ਅਰਾਇਨ) ਮਿਲ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "काछन एक तहा मिल गई ॥",
      "sourceLineId": "102815",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੋਆ ਚੂਕ ਪੁਕਾਰਤ ਭਈ ॥",
      "transliteration": "soaa chook pukaarat bhiee ||",
      "translation": "The sage met a lady-gardener there, who was shouting continuously",
      "punjabiViakhya": "ਜੋ 'ਸੌਣ ਵਾਲਾ ਚੁਕ ਗਿਆ' (ਜੋ ਕਿਸਾਨ ਸੌਂ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "सोआ चूक पुकारत भई ॥",
      "sourceLineId": "102816",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਾਵ ਯਾਹਿ ਮਨ ਮਾਹਿ ਨਿਹਾਰਾ ॥",
      "transliteration": "bhaav yaeh man maeh nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦਾ ਖੇਤ ਨਸ਼ਟ ਹੋ ਗਿਆ) ਦਾ ਹੋਕਾ ਦੇ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "भाव याहि मन माहि निहारा ॥",
      "sourceLineId": "102817",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦਸਵੋ ਗੁਰੂ ਤਾਹਿ ਬੀਚਾਰਾ ॥੨੦੯॥",
      "transliteration": "dhasavo guroo taeh beechaaraa ||209||",
      "translation": "The sage feeling the notion of her shouts in his mind, adopted her the tenth Guru.209.",
      "punjabiViakhya": "ਇਸ ਭਾਵ ਨੂੰ ਮੁਨੀ ਨੇ ਮਨ ਵਿਚ ਵਿਚਾਰਿਆ ਅਤੇ ਉਸ ਨੂੰ ਦਸਵਾ ਗੁਰੂ ਧਾਰਨ ਕੀਤਾ ॥੨੦੯॥",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "दसवो गुरू ताहि बीचारा ॥२०९॥",
      "sourceLineId": "102818",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜੋ ਸੋਵੈ ਸੋ ਮੂਲੁ ਗਵਾਵੈ ॥",
      "transliteration": "jo sovai so mool gavaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸੌਵੇਾਂਗਾ, (ਉਹ) ਮੂਲ ਨੂੰ ਗੰਵਾ ਲਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "जो सोवै सो मूलु गवावै ॥",
      "sourceLineId": "102819",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜੋ ਜਾਗੈ ਹਰਿ ਹ੍ਰਿਦੈ ਬਸਾਵੈ ॥",
      "transliteration": "jo jaagai har hiradhai basaavai ||",
      "translation": "He, who will serve the Lord, he will destroy the ego, which is the origin of the world",
      "punjabiViakhya": "ਜੋ ਜਾਗਦਾ ਰਹੇਗਾ, (ਉਹ) ਹਰਿ ਨੂੰ ਹਿਰਦੇ ਵਿਚ ਵਸਾ ਲਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "जो जागै हरि हृदै बसावै ॥",
      "sourceLineId": "102820",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਤਿ ਬੋਲਿ ਯਾ ਕੀ ਹਮ ਮਾਨੀ ॥",
      "transliteration": "sat bol yaa kee ham maanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਸਾ ਇਸ ਦੀ ਬੋਲੀ ਸੱਚੀ ਮਨ ਲਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "सति बोलि या की हम मानी ॥",
      "sourceLineId": "102821",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੋਗ ਧਿਆਨ ਜਾਗੈ ਤੇ ਜਾਨੀ ॥੨੧੦॥",
      "transliteration": "jog dhiaan jaagai te jaanee ||210||",
      "translation": "Who will actually be awakened from the sleep of maya, he will enshrine the Lord the sleep of maya, he will enshrine the Lord in hi heart the sage accepted the voice of the lady-gardener as true and as the power of kindling the knowledge of Yoga.210.",
      "punjabiViakhya": "ਜੋ ਯੋਗ ਦੇ ਧਿਆਨ ਵਿਚ ਲਗੇ ਹੋਏ ਹਨ, ਉਹੀ ਇਸ (ਗੱਲ) ਨੂੰ ਜਾਣ ਸਕਦੇ ਹਨ ॥੨੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "जोग धिआन जागै ते जानी ॥२१०॥",
      "sourceLineId": "102822",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਤਿ ਕਾਛਨ ਗੁਰੂ ਦਸਵੋ ਸਮਾਪਤੰ ॥੧੦॥",
      "transliteration": "eit kaachhan guroo dhasavo samaapata(n) ||10||",
      "translation": "End of the description of the adoption of the Lady-Gradener as the Tenth Guru.",
      "punjabiViakhya": "ਇਥੇ 'ਕਾਛਨ' ਦਸਵੇਾਂ ਗੁਰੂ ਦਾ ਪ੍ਰਸੰਗ ਸਮਾਪਤ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "इति काछन गुरू दसवो समापतं ॥१०॥",
      "sourceLineId": "102823",
      "sourceShabadId": "9351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਥ ਸੁਰਥ ਯਾਰਮੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "transliteration": "ath surath yaaramo guroo kathana(n) ||",
      "translation": "Now begins the description of the adoption of Surath as the Eleventh Guru",
      "punjabiViakhya": "ਹੁਣ ਸੁਰਥ ਯਾਰ੍ਰਹਵੇਾਂ ਗੁਰੂ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "अथ सुरथ यारमो गुरू कथनं ॥",
      "sourceLineId": "102824",
      "sourceShabadId": "9352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "102825",
      "sourceShabadId": "9352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਗੇ ਦਤ ਦੇਵ ਤਬ ਚਲਾ ॥",
      "transliteration": "aage dhat dhev tab chalaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਤ ਦੇਵ ਤਦ ਅਗੇ ਚਲ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "आगे दत देव तब चला ॥",
      "sourceLineId": "102826",
      "sourceShabadId": "9352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਾਧੇ ਸਰਬ ਜੋਗ ਕੀ ਕਲਾ ॥",
      "transliteration": "saadhe sarab jog kee kalaa ||",
      "translation": "Then the sage Dutt, practising all the arts of Yoga, moved forward",
      "punjabiViakhya": "(ਜਿਸ ਨੇ) ਯੋਗ ਦੀ ਸਾਰੀ ਕਲਾ ਨੂੰ ਸਾਧਿਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "साधे सरब जोग की कला ॥",
      "sourceLineId": "102827",
      "sourceShabadId": "9352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਮਿਤ ਤੇਜ ਅਰੁ ਉਜਲ ਪ੍ਰਭਾਉ ॥",
      "transliteration": "amit tej ar ujal prabhaau ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਅਮਿਤ ਤੇਜ ਅਤੇ ਉਜਲਾ ਪ੍ਰਭਾਵ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "अमित तेज अरु उजल प्रभाउ ॥",
      "sourceLineId": "102828",
      "sourceShabadId": "9352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਾਨੁਕ ਬਨਾ ਦੂਸਰ ਹਰਿ ਰਾਉ ॥੨੧੧॥",
      "transliteration": "jaanuk banaa dhoosar har raau ||211||",
      "translation": "His glory was infinite and he seemed to be the second God.211.",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ) ਮਾਨੋ ਦੂਜਾ ਹਰਿ ਰਾਜਾ ਬਣਿਆ ਹੋਇਆ ਹੋਵੇ ॥੨੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "जानुक बना दूसर हरि राउ ॥२११॥",
      "sourceLineId": "102829",
      "sourceShabadId": "9352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਭ ਹੀ ਕਲਾ ਜੋਗ ਕੀ ਸਾਧੀ ॥",
      "transliteration": "sabh hee kalaa jog kee saadhee ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੇ) ਯੋਗ ਦੀ ਸਾਰੀ ਕਲਾ ਸਾਧੀ ਹੋਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "सभ ही कला जोग की साधी ॥",
      "sourceLineId": "102830",
      "sourceShabadId": "9352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਹਾ ਸਿਧਿ ਮੋਨੀ ਮਨਿ ਲਾਧੀ ॥",
      "transliteration": "mahaa sidh monee man laadhee ||",
      "translation": "That great adept and the silence-observing purusha practiced all the skill of Yoga",
      "punjabiViakhya": "(ਉਸ) ਸ਼ਿਰੋਮਣੀ ਮੋਨੀ (ਦੱਤ) ਨੇ ਮਨ ਵਿਚੋਂ ਹੀ ਸਿੱਧੀ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "महा सिधि मोनी मनि लाधी ॥",
      "sourceLineId": "102831",
      "sourceShabadId": "9352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਧਿਕ ਤੇਜ ਅਰੁ ਅਧਿਕ ਪ੍ਰਭਾਵਾ ॥",
      "transliteration": "adhik tej ar adhik prabhaavaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਬਹੁਤ ਅਧਿਕ ਤੇਜ ਅਤੇ ਪ੍ਰਭਾਵ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "अधिक तेज अरु अधिक प्रभावा ॥",
      "sourceLineId": "102832",
      "sourceShabadId": "9352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਾ ਲਖਿ ਇੰਦ੍ਰਾਸਨ ਥਹਰਾਵਾ ॥੨੧੨॥",
      "transliteration": "jaa lakh i(n)dhraasan thaharaavaa ||212||",
      "translation": "Seeing his extreme glory and impact, the seat of Indra also trembled.212.",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਇੰਦਰ ਦਾ ਆਸਣ ਡੋਲ ਗਿਆ ਹੈ ॥੨੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "जा लखि इंद्रासन थहरावा ॥२१२॥",
      "sourceLineId": "102833",
      "sourceShabadId": "9352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਧੁਭਾਰ ਛੰਦ ॥ ਤ੍ਵਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "madhubhaar chha(n)dh || tavaiprasaadh ||",
      "translation": "MADHUBHAAR STANZA BY THY GRACE",
      "punjabiViakhya": "ਮਧਭਾਰ ਛੰਦ: ਤੇਰੀ ਕ੍ਰਿਪਾ ਨਾਲ:",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "मधुभार छंद ॥ त्वप्रसादि ॥",
      "sourceLineId": "102834",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮੁਨਿ ਮਨਿ ਉਦਾਰ ॥",
      "transliteration": "mun man udhaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਦਾਰ ਮਨ ਵਾਲਾ ਮੁਨੀ",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "मुनि मनि उदार ॥",
      "sourceLineId": "102835",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗੁਨ ਗਨ ਅਪਾਰ ॥",
      "transliteration": "gun gan apaar ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਵਿਚ) ਅਪਾਰ ਗੁਣ-ਸਮੂਹ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "गुन गन अपार ॥",
      "sourceLineId": "102836",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਰਿ ਭਗਤਿ ਲੀਨ ॥",
      "transliteration": "har bhagat leen ||",
      "translation": "",
      "punjabiViakhya": "ਹਰਿ ਭਗਤੀ ਵਿਚ ਲੀਨ",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "हरि भगति लीन ॥",
      "sourceLineId": "102837",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹਰਿ ਕੋ ਅਧੀਨ ॥੨੧੩॥",
      "transliteration": "har ko adheen ||213||",
      "translation": "The generous sage, full of innumerable attributes, was absorbed in the devotion of the Lord and was under the submission of the Lord.213.",
      "punjabiViakhya": "ਅਤੇ ਹਰਿ ਦੇ ਅਧੀਨ ਹੈ ॥੨੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "हरि को अधीन ॥२१३॥",
      "sourceLineId": "102838",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਜਿ ਰਾਜ ਭੋਗ ॥",
      "transliteration": "taj raaj bhog ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਭੋਗ ਨੂੰ ਛਡ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "तजि राज भोग ॥",
      "sourceLineId": "102839",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੰਨ੍ਯਾਸ ਜੋਗ ॥",
      "transliteration": "sa(n)nayaas jog ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਨਿਆਸ ਯੋਗ (ਲੈ ਕੇ)",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "संन्यास जोग ॥",
      "sourceLineId": "102840",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੰਨ੍ਯਾਸ ਰਾਇ ॥",
      "transliteration": "sa(n)nayaas rai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੰਨਿਆਸ ਰਾਜ ਬਣ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "संन्यास राइ ॥",
      "sourceLineId": "102841",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹਰਿ ਭਗਤ ਭਾਇ ॥੨੧੪॥",
      "transliteration": "har bhagat bhai ||214||",
      "translation": "Forsaking the royal enjoyments that king of Yogis had adopted Sannyas and Yoga for the devotion and desire of meeting the Lord.214.",
      "punjabiViakhya": "ਹਰਿ ਭਗਤੀ ਨਾਲ ਪ੍ਰੇਮ ਪਾ ਲਿਆ ਹੈ ॥੨੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "हरि भगत भाइ ॥२१४॥",
      "sourceLineId": "102842",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮੁਖ ਛਬਿ ਅਪਾਰ ॥",
      "transliteration": "mukh chhab apaar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਮੁਖ ਉਤੇ ਅਪਾਰ ਛਬੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "मुख छबि अपार ॥",
      "sourceLineId": "102843",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪੂਰਣ ਵਤਾਰ ॥",
      "transliteration": "pooran vataar ||",
      "translation": "The beauty of the face of that perfect incarnation was enormous",
      "punjabiViakhya": "(ਮਾਨੋ ਹਰਿ ਦਾ) ਪੂਰਨ ਅਵਤਾਰ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "पूरण वतार ॥",
      "sourceLineId": "102844",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਖੜਗੰ ਅਸੇਖ ॥",
      "transliteration": "khaRaga(n) asekh ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਖੜਗ ਵਾਗ ਪੂਰੀ ਤਰ੍ਰਹਾ (ਕੁਸ਼ਾਗ੍ਰ ਬੁੱਧੀ ਵਾਲਾ)",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "खड़गं असेख ॥",
      "sourceLineId": "102845",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਿਦਿਆ ਬਿਸੇਖ ॥੨੧੫॥",
      "transliteration": "bidhiaa bisekh ||215||",
      "translation": "He was sharp like dagger and was also skilful in many prominent sciences.215.",
      "punjabiViakhya": "ਅਤੇ ਵਿਸ਼ੇਸ਼ ਵਿਦਿਆ ਨੂੰ ਜਾਣਨ ਵਾਲਾ ਹੈ ॥੨੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "बिदिआ बिसेख ॥२१५॥",
      "sourceLineId": "102846",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੁੰਦਰ ਸਰੂਪ ॥",
      "transliteration": "su(n)dhar saroop ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਸਰੂਪ ਸੁੰਦਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "सुँदर सरूप ॥",
      "sourceLineId": "102847",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਹਿਮਾ ਅਨੂਪ ॥",
      "transliteration": "mahimaa anoop ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਿਮਾ ਉਪਮਾ ਤੋਂ ਰਹਿਤ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "महिमा अनूप ॥",
      "sourceLineId": "102848",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਆਭਾ ਅਪਾਰ ॥",
      "transliteration": "aabhaa apaar ||",
      "translation": "",
      "punjabiViakhya": "ਅਪਾਰ ਆਭਾ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "आभा अपार ॥",
      "sourceLineId": "102849",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0652_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮੁਨਿ ਮਨਿ ਉਦਾਰ ॥੨੧੬॥",
      "transliteration": "mun man udhaar ||216||",
      "translation": "That charming sage had unique greatness, unlimited glory and generous mind.216.",
      "punjabiViakhya": "(ਦੱਤ) ਮੁਨੀ ਉਦਾਰ ਮਨ ਵਾਲਾ ਹੈ ॥੨੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 652,
      "hindi": "",
      "hindiTransliteration": "मुनि मनि उदार ॥२१६॥",
      "sourceLineId": "102850",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
