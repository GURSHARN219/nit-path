{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 653,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0653_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੰਨਯਾਸ ਦੇਵ ॥",
      "transliteration": "sa(n)nayaas dhev ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸੰਨਿਆਸ ਦੇਵ ਗੁਣਾ ਦਾ ਸਮੂਹ",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "संनयास देव ॥",
      "sourceLineId": "102851",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗੁਨ ਗਨ ਅਭੇਵ ॥",
      "transliteration": "gun gan abhev ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੇਦ ਰਹਿਤ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "गुन गन अभेव ॥",
      "sourceLineId": "102852",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਬਿਯਕਤ ਰੂਪ ॥",
      "transliteration": "abiyakat roop ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਸਰੂਪ ਅਵਿਅਕਤ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "अबियकत रूप ॥",
      "sourceLineId": "102853",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਹਿਮਾ ਅਨੂਪ ॥੨੧੭॥",
      "transliteration": "mahimaa anoop ||217||",
      "translation": "He was a god for Sannyasis and for the virtuous people he was mysterious, unmanifested and of unparalleled greatness.217.",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਮਹਿਮਾ ਅਨੂਪਮ ਹੈ ॥੨੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "महिमा अनूप ॥२१७॥",
      "sourceLineId": "102854",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਭ ਸੁਭ ਸੁਭਾਵ ॥",
      "transliteration": "sabh subh subhaav ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਸਾਰੇ ਸੁਭਾ ਸ਼ੁਭ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "सभ सुभ सुभाव ॥",
      "sourceLineId": "102855",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਤਿਭੁਤ ਪ੍ਰਭਾਵ ॥",
      "transliteration": "atibhut prabhaav ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਭਾਵ ਅਦਭੁਤ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "अतिभुत प्रभाव ॥",
      "sourceLineId": "102856",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਹਿਮਾ ਅਪਾਰ ॥",
      "transliteration": "mahimaa apaar ||",
      "translation": "",
      "punjabiViakhya": "ਅਪਾਰ ਮਹਿਮਾ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "महिमा अपार ॥",
      "sourceLineId": "102857",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗੁਨ ਗਨ ਉਦਾਰ ॥੨੧੮॥",
      "transliteration": "gun gan udhaar ||218||",
      "translation": "His temperament was auspicious, the impact marvelous and the greatness unlimited.218.",
      "punjabiViakhya": "ਉਦਾਰ ਗੁਣਾ ਦਾ ਸਮੁੱਚ ਹੈ ॥੨੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "गुन गन उदार ॥२१८॥",
      "sourceLineId": "102858",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਹ ਸੁਰਥ ਰਾਜ ॥",
      "transliteration": "teh surath raaj ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸੁਰਥ ਨਾ ਦਾ ਰਾਜਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "तह सुरथ राज ॥",
      "sourceLineId": "102859",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੰਪਤਿ ਸਮਾਜ ॥",
      "transliteration": "sa(n)pat samaaj ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਸੰਪੱਤੀ ਅਤੇ ਸਮਾਜ ਵਾਲਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "संपति समाज ॥",
      "sourceLineId": "102860",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪੂਜੰਤ ਚੰਡਿ ॥",
      "transliteration": "pooja(n)t cha(n)dd ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੰਡੀ ਨੂੰ ਪੂਜਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "पूजंत चंडि ॥",
      "sourceLineId": "102861",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਿਸਿ ਦਿਨ ਅਖੰਡ ॥੨੧੯॥",
      "transliteration": "nis dhin akha(n)dd ||219||",
      "translation": "There was a king name Surath there who was attached with his assets and society who worshipped Chandi uninterruptedly.219.",
      "punjabiViakhya": "ਰਾਤ ਦਿਨ ਨਿਰੰਤਰ ॥੨੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "निसि दिन अखंड ॥२१९॥",
      "sourceLineId": "102862",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨ੍ਰਿਪ ਅਤਿ ਪ੍ਰਚੰਡ ॥",
      "transliteration": "nirap at pracha(n)dd ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਅਤਿ ਪ੍ਰਚੰਡ (ਤੇਜ ਵਾਲਾ) ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "नृप अति प्रचंड ॥",
      "sourceLineId": "102863",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਭ ਬਿਧਿ ਅਖੰਡ ॥",
      "transliteration": "sabh bidh akha(n)dd ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਸਰੂਪ ਸਭ ਢੰਗਾ ਨਾਲ ਅਖੰਡ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "सभ बिधि अखंड ॥",
      "sourceLineId": "102864",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਿਲਸਿਤ ਪ੍ਰਬੀਨ ॥",
      "transliteration": "silasit prabeen ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰ ਵਿਦਿਆ ਵਿਚ ਪ੍ਰਬੀਨ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "सिलसित प्रबीन ॥",
      "sourceLineId": "102865",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੇਵੀ ਅਧੀਨ ॥੨੨੦॥",
      "transliteration": "dhevee adheen ||220||",
      "translation": "The king, who was extremely powerful and had complete control of his kingdom, was skilful in all the sciences and was under the submission of the goddess.220.",
      "punjabiViakhya": "ਅਤੇ ਦੇਵੀ ਦੇ ਅਧੀਨ ਸੀ ॥੨੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "देवी अधीन ॥२२०॥",
      "sourceLineId": "102866",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਿਸਦਿਨ ਭਵਾਨਿ ॥",
      "transliteration": "nisadhin bhavaan ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਦਿਨ ਮਹਾਨ ਰੂਪ ਵਾਲੀ",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "निसदिन भवानि ॥",
      "sourceLineId": "102867",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੇਵਤ ਨਿਧਾਨ ॥",
      "transliteration": "sevat nidhaan ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਡੀ ਦੀ ਸੇਵਾ ਕਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "सेवत निधान ॥",
      "sourceLineId": "102868",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਰਿ ਏਕ ਆਸ ॥",
      "transliteration": "kar ek aas ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਉਸ) ਇਕ ਦੀ ਆਸ ਰਖਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "करि एक आस ॥",
      "sourceLineId": "102869",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਿਸਿ ਦਿਨ ਉਦਾਸ ॥੨੨੧॥",
      "transliteration": "nis dhin udhaas ||221||",
      "translation": "He served the goddess Bhavani night and day and remained unattached with only one desire in his mind.221.",
      "punjabiViakhya": "ਅਤੇ ਰਾਤ ਦਿਨ ਉਦਾਸ ਰਹਿੰਦਾ ਸੀ ॥੨੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "निसि दिन उदास ॥२२१॥",
      "sourceLineId": "102870",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦੁਰਗਾ ਪੁਜੰਤ ॥",
      "transliteration": "dhuragaa puja(n)t ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਨਿੱਤ-ਪ੍ਰਤਿ ਸ੍ਰੇਸ਼ਠ ਪੁਜਾਰੀ ਵਾਗ",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "दुरगा पुजंत ॥",
      "sourceLineId": "102871",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਿਤਪ੍ਰਤਿ ਮਹੰਤ ॥",
      "transliteration": "nitaprat maha(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਦੁਰਗਾ ਨੂੰ ਪੂਜਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "नितप्रति महंत ॥",
      "sourceLineId": "102872",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਪ੍ਰਕਾਰ ॥",
      "transliteration": "bahu bidh prakaar ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि प्रकार ॥",
      "sourceLineId": "102873",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੇਵਤ ਸਵਾਰ ॥੨੨੨॥",
      "transliteration": "sevat savaar ||222||",
      "translation": "He used to worship Durga always in various ways and made offerings.222.",
      "punjabiViakhya": "ਚੰਗੀ ਸੇਵਾ ਕਰਦਾ ਰਹਿੰਦਾ ਸੀ ॥੨੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "सेवत सवार ॥२२२॥",
      "sourceLineId": "102874",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਤਿ ਗੁਨ ਨਿਧਾਨ ॥",
      "transliteration": "at gun nidhaan ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬਹੁਤ ਗੁਣਾ ਦਾ ਖ਼ਜ਼ਾਨਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "अति गुन निधान ॥",
      "sourceLineId": "102875",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਹਿਮਾ ਮਹਾਨ ॥",
      "transliteration": "mahimaa mahaan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਮਹਾਨ ਮਹਿਮਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "महिमा महान ॥",
      "sourceLineId": "102876",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਤਿ ਬਿਮਲ ਅੰਗ ॥",
      "transliteration": "at bimal a(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਸ਼ਰੀਰ ਬਹੁਤ ਨਿਰਮਲ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "अति बिमल अंग ॥",
      "sourceLineId": "102877",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਲਖਿ ਲਜਤ ਗੰਗ ॥੨੨੩॥",
      "transliteration": "lakh lajat ga(n)g ||223||",
      "translation": "That king was enromusly praiseworthy, treasure of virtues and had such a pure body that on seeing him, even the ganges felt shy.223.",
      "punjabiViakhya": "(ਜਿਸ ਦੀ ਨਿਰਮਲਤਾ ਨੂੰ) ਵੇਖ ਕੇ ਗੰਗਾ ਵੀ ਲਜਾਉਾਂਦੀ ਸੀ ॥੨੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "लखि लजत गंग ॥२२३॥",
      "sourceLineId": "102878",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਿਹ ਨਿਰਖ ਦਤ ॥",
      "transliteration": "teh nirakh dhat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਦੱਤ ਨੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "तिह निरख दत ॥",
      "sourceLineId": "102879",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਤਿ ਬਿਮਲ ਮਤਿ ॥",
      "transliteration": "at bimal mat ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਬਹੁਤ ਨਿਰਮਲ ਬੁੱਧੀ ਵਾਲਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "अति बिमल मति ॥",
      "sourceLineId": "102880",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਨਖੰਡ ਜੋਤਿ ॥",
      "transliteration": "anakha(n)dd jot ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਜੋਤਿ ਅਖੰਡ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "अनखंड जोति ॥",
      "sourceLineId": "102881",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਨੁ ਭਿਓ ਉਦੋਤ ॥੨੨੪॥",
      "transliteration": "jan bhio udhot ||224||",
      "translation": "Seeing him, Dutt became extremely pure in intellect and completely lustrous.224.",
      "punjabiViakhya": "ਮਾਨੋ (ਜੋਤਿ) ਪ੍ਰਗਟ ਹੋਈ ਹੋਵੇ ॥੨੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "जनु भिओ उदोत ॥२२४॥",
      "sourceLineId": "102882",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਝਮਕੰਤ ਅੰਗ ॥",
      "transliteration": "jhamaka(n)t a(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਅੰਗ ਚਮਕਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "झमकंत अंग ॥",
      "sourceLineId": "102883",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਲਖਿ ਲਜਤ ਗੰਗ ॥",
      "transliteration": "lakh lajat ga(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਚਮਕ ਨੂੰ ਵੇਖ ਕੇ) ਗੰਗਾ ਸ਼ਰਮਾਉਾਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "लखि लजत गंग ॥",
      "sourceLineId": "102884",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਤਿ ਗੁਨ ਨਿਧਾਨ ॥",
      "transliteration": "at gun nidhaan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਗੁਣਾ ਦਾ ਖ਼ਜ਼ਾਨਾ",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "अति गुन निधान ॥",
      "sourceLineId": "102885",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮਹਿਮਾ ਮਹਾਨ ॥੨੨੫॥",
      "transliteration": "mahimaa mahaan ||225||",
      "translation": "Seeing his limbs, even Ganges became shy, because he was enormously praiseworthy and a treasure of virtues.225.",
      "punjabiViakhya": "ਅਤੇ ਮਹਾਨ ਮਹਿਮਾ ਵਾਲਾ ਸੀ ॥੨੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "महिमा महान ॥२२५॥",
      "sourceLineId": "102886",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਨਭਵ ਪ੍ਰਕਾਸ ॥",
      "transliteration": "anabhav prakaas ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਅਨੁਭਵ ਦਾ ਪ੍ਰਕਾਸ਼ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "अनभव प्रकास ॥",
      "sourceLineId": "102887",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਿਸ ਦਿਨ ਉਦਾਸ ॥",
      "transliteration": "nis dhin udhaas ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਦਿਨ ਉਦਾਸ (ਵਿਰਕਤ) ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "निस दिन उदास ॥",
      "sourceLineId": "102888",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਤਿਭੁਤ ਸੁਭਾਵ ॥",
      "transliteration": "atibhut subhaav ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਅਦਭੁਤ ਸੁਭਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "अतिभुत सुभाव ॥",
      "sourceLineId": "102889",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੰਨ੍ਯਾਸ ਰਾਵ ॥੨੨੬॥",
      "transliteration": "sa(n)nayaas raav ||226||",
      "translation": "The sage saw that he was bright like light, ever unattached and a king of Sannyasis with marvelous temperament.226.",
      "punjabiViakhya": "(ਉਹ) ਸੰਨਿਆਸ ਰਾਜ ਸੀ ॥੨੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "संन्यास राव ॥२२६॥",
      "sourceLineId": "102890",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਲਖਿ ਤਾਸੁ ਸੇਵ ॥",
      "transliteration": "lakh taas sev ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੇਵਾ ਨੂੰ ਵੇਖ ਕੇ ਸੰਨਿਆਸ ਦੇਵ (ਦੱਤ)",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "लखि तासु सेव ॥",
      "sourceLineId": "102891",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੰਨ੍ਯਾਸ ਦੇਵ ॥",
      "transliteration": "sa(n)nayaas dhev ||",
      "translation": "",
      "punjabiViakhya": "ਮਨ ਵਿਚ ਬਹੁਤ ਰੀਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "संन्यास देव ॥",
      "sourceLineId": "102892",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਤਿ ਚਿਤ ਰੀਝ ॥",
      "transliteration": "at chit reejh ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਦੀ ਸੇਵਾ ਭਗਤੀ ਨੂੰ ਵੇਖ ਕੇ)",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "अति चित रीझ ॥",
      "sourceLineId": "102893",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਿਹ ਫਾਸਿ ਬੀਝ ॥੨੨੭॥",
      "transliteration": "teh faas beejh ||227||",
      "translation": "Dutt saw his serving nature and he was extremely pleased in his mind.227.",
      "punjabiViakhya": "ਮੋਹ ਦੀ ਫਾਹੀ ਵਿਚ ਫਸ ਗਿਆ ॥੨੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "तिह फासि बीझ ॥२२७॥",
      "sourceLineId": "102894",
      "sourceShabadId": "9353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸ੍ਰੀ ਭਗਵਤੀ ਛੰਦ ॥",
      "transliteration": "sree bhagavatee chha(n)dh ||",
      "translation": "DHRI BHAGVATI STANZA",
      "punjabiViakhya": "ਸ੍ਰੀ ਭਗਵਤੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "स्री भगवती छंद ॥",
      "sourceLineId": "102895",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਿ ਦਿਖਿਓਤ ਦਤੰ ॥",
      "transliteration": "k dhikhiot dhata(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਤ ਨੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "कि दिखिओत दतं ॥",
      "sourceLineId": "102896",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਿ ਪਰਮੰਤਿ ਮਤੰ ॥",
      "transliteration": "k parama(n)t mata(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ (ਉਹ ਰਾਜਾ) ਪਰਮ ਪਵਿਤ੍ਰ ਮੱਤ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "कि परमंति मतं ॥",
      "sourceLineId": "102897",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0653_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੁ ਸਰਬਤ੍ਰ ਸਾਜਾ ॥",
      "transliteration": "s sarabatr saajaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸਾਰਿਆਂ ਸਾਜਾ ਸਹਿਤ",
      "source": "DASAM_GRANTH",
      "ang": 653,
      "hindi": "",
      "hindiTransliteration": "सु सरबत्र साजा ॥",
      "sourceLineId": "102898",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
