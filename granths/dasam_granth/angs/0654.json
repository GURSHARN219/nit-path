{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 654,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0654_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਿ ਦਿਖਿਓਤ ਰਾਜਾ ॥੨੨੮॥",
      "transliteration": "k dhikhiot raajaa ||228||",
      "translation": "He seemed to Dutt as a king of supreme intellect, bedecked with all the accomplishments.228.",
      "punjabiViakhya": "ਰਾਜਾ ਵੇਖਿਆ ਗਿਆ ਹੈ ॥੨੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि दिखिओत राजा ॥२२८॥",
      "sourceLineId": "102899",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਿ ਆਲੋਕ ਕਰਮੰ ॥",
      "transliteration": "k aalok karama(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਅਦੁੱਤੀ ਕਰਮਾ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि आलोक करमं ॥",
      "sourceLineId": "102900",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਿ ਸਰਬਤ੍ਰ ਪਰਮੰ ॥",
      "transliteration": "k sarabatr parama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਧਰਮਾ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्र परमं ॥",
      "sourceLineId": "102901",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਿ ਆਜਿਤ ਭੂਪੰ ॥",
      "transliteration": "k aajit bhoopa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨਾ ਜਿਤਿਆ ਜਾ ਸਕਣ ਵਾਲਾ ਰਾਜਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि आजित भूपं ॥",
      "sourceLineId": "102902",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਿ ਰਤੇਸ ਰੂਪੰ ॥੨੨੯॥",
      "transliteration": "k rates roopa(n) ||229||",
      "translation": "That king was unconquerable, illustrious, elegant and respectful for all religions.229.",
      "punjabiViakhya": "ਅਤੇ ਕਾਮ ਦੇਵ ਦੇ ਰੂਪ ਵਾਲਾ ਹੈ ॥੨੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि रतेस रूपं ॥२२९॥",
      "sourceLineId": "102903",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਿ ਆਜਾਨ ਬਾਹ ॥",
      "transliteration": "k aajaan baeh ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਗੋਡਿਆਂ ਤਕ ਲੰਬੀਆਂ ਬਾਹਵਾ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि आजान बाह ॥",
      "sourceLineId": "102904",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਿ ਸਰਬਤ੍ਰ ਸਾਹ ॥",
      "transliteration": "k sarabatr saeh ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਦਾ ਸ਼ਾਹ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्र साह ॥",
      "sourceLineId": "102905",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਿ ਧਰਮੰ ਸਰੂਪੰ ॥",
      "transliteration": "k dharama(n) saroopa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਮ ਦਾ ਸਰੂਪ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि धरमं सरूपं ॥",
      "sourceLineId": "102906",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਿ ਸਰਬਤ੍ਰ ਭੂਪੰ ॥੨੩੦॥",
      "transliteration": "k sarabatr bhoopa(n) ||230||",
      "translation": "That long-armed king was virtuous and cared for all his subjects.230.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਦਾ ਰਾਜਾ ਹੈ ॥੨੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्र भूपं ॥२३०॥",
      "sourceLineId": "102907",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਿ ਸਾਹਾਨ ਸਾਹੰ ॥",
      "transliteration": "k saahaan saaha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸ਼ਾਹਾ ਦਾ ਸ਼ਾਹ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि साहान साहं ॥",
      "sourceLineId": "102908",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਿ ਆਜਾਨੁ ਬਾਹੰ ॥",
      "transliteration": "k aajaan baaha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਗੋਡਿਆਂ ਤਕ ਲੰਬੀਆਂ ਬਾਹਵਾ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि आजानु बाहं ॥",
      "sourceLineId": "102909",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਿ ਜੋਗੇਾਂਦ੍ਰ ਗਾਮੀ ॥",
      "transliteration": "k jogeaa(n)dhr gaamee ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ('ਜੋਗੇਾਂਦ੍ਰ') ਤਕ ਪਹੁੰਚ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि जोगेाँद्र गामी ॥",
      "sourceLineId": "102910",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਿ ਧਰਮੇਾਂਦ੍ਰ ਧਾਮੀ ॥੨੩੧॥",
      "transliteration": "k dharameaa(n)dhr dhaamee ||231||",
      "translation": "That long-armed king was a great Sovereign, a great Yogi and a monarch of Dharma.231.",
      "punjabiViakhya": "ਧਰਮ ਦਾ ਰਾਜਾ ਅਥਵਾ ਘਰ ਹੈ ॥੨੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि धरमेाँद्र धामी ॥२३१॥",
      "sourceLineId": "102911",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਿ ਰੁਦ੍ਰਾਰਿ ਰੂਪੰ ॥",
      "transliteration": "k rudhraar roopa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਕਾਮ ਦੇਵ ('ਰੁਦ੍ਰਾਰਿ') ਦੇ ਰੂਪ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि रुद्रारि रूपं ॥",
      "sourceLineId": "102912",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਿ ਭੂਪਾਨ ਭੂਪੰ ॥",
      "transliteration": "k bhoopaan bhoopa(n) ||",
      "translation": "That king of kings resembled the figure of Rudra",
      "punjabiViakhya": "ਰਾਜਿਆਂ ਦਾ ਰਾਜਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि भूपान भूपं ॥",
      "sourceLineId": "102913",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਿ ਆਦਗ ਜੋਗੰ ॥",
      "transliteration": "k aadhag joga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਲਾਲੀ ਯੋਗ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि आदग जोगं ॥",
      "sourceLineId": "102914",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਿ ਤਿਆਗੰਤ ਸੋਗੰ ॥੨੩੨॥",
      "transliteration": "k tiaaga(n)t soga(n) ||232||",
      "translation": "He was free from anxieties and remained absorbed in Yoga.232.",
      "punjabiViakhya": "ਸੋਗ ਨੂੰ ਤਿਆਗਣ ਵਾਲਾ ਹੈ ॥੨੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि तिआगंत सोगं ॥२३२॥",
      "sourceLineId": "102915",
      "sourceShabadId": "9354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਧੁਭਾਰ ਛੰਦ ॥",
      "transliteration": "madhubhaar chha(n)dh ||",
      "translation": "MADHUBHAAR STANZA",
      "punjabiViakhya": "ਮਧੁਭਾਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "मधुभार छंद ॥",
      "sourceLineId": "102916",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਿਮੋਹਿਯੋਤ ਦੇਖੀ ॥",
      "transliteration": "bimohiyot dhekhee ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਉਤੇ ਦੁਨੀਆ) ਮੋਹਿਤ ਹੋਈ ਦਿਖਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "बिमोहियोत देखी ॥",
      "sourceLineId": "102917",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਿ ਰਾਵਲ ਭੇਖੀ ॥",
      "transliteration": "k raaval bhekhee ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਗ ਦੇ ਭੇਸ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि रावल भेखी ॥",
      "sourceLineId": "102918",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਿ ਸੰਨ੍ਯਾਸ ਰਾਜਾ ॥",
      "transliteration": "k sa(n)nayaas raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਨਿਆਸ ਦਾ ਰਾਜਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि संन्यास राजा ॥",
      "sourceLineId": "102919",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਿ ਸਰਬਤ੍ਰ ਸਾਜਾ ॥੨੩੩॥",
      "transliteration": "k sarabatr saajaa ||233||",
      "translation": "Seeing him, Dutt, the king of Yogis, who was in the garb of a Rawal, and who was theking of Sannyasis, and respectable for all, he was allured towards him.233.",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਸਾਜ਼ਾ ਵਾਲਾ ਹੈ ॥੨੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्र साजा ॥२३३॥",
      "sourceLineId": "102920",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਿ ਸੰਭਾਲ ਦੇਖਾ ॥",
      "transliteration": "k sa(n)bhaal dhekhaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸੰਭਲ ਕੇ ਵੇਖਿਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि संभाल देखा ॥",
      "sourceLineId": "102921",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਿ ਸੁਧ ਚੰਦ੍ਰ ਪੇਖਾ ॥",
      "transliteration": "k sudh cha(n)dhr pekhaa ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੁੱਧ ਚੰਦ੍ਰਮਾ ਵਰਗਾ ਦਿਖਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि सुध चंद्र पेखा ॥",
      "sourceLineId": "102922",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਿ ਪਾਵਿਤ੍ਰ ਕਰਮੰ ॥",
      "transliteration": "k paavitr karama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਪਵਿਤ੍ਰ ਕਰਮਾ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि पावित्र करमं ॥",
      "sourceLineId": "102923",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਿ ਸੰਨਿਆਸ ਧਰਮੰ ॥੨੩੪॥",
      "transliteration": "k sa(n)niaas dharama(n) ||234||",
      "translation": "He saw him like pure moon and found him that his actions were immaculate and in accordance with Yoga.234.",
      "punjabiViakhya": "ਸੰਨਿਆਸ ਧਰਮ ਵਾਲਾ ਹੈ ॥੨੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि संनिआस धरमं ॥२३४॥",
      "sourceLineId": "102924",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਿ ਸੰਨਿਆਸ ਭੇਖੀ ॥",
      "transliteration": "k sa(n)niaas bhekhee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸੰਨਿਆਸ ਦੇ ਭੇਖ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि संनिआस भेखी ॥",
      "sourceLineId": "102925",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਿ ਆਧਰਮ ਦ੍ਵੈਖੀ ॥",
      "transliteration": "k aadharam dhavaikhee ||",
      "translation": "",
      "punjabiViakhya": "ਅਧਰਮ ਦਾ ਦ੍ਵੈਖੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि आधरम द्वैखी ॥",
      "sourceLineId": "102926",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਿ ਸਰਬਤ੍ਰ ਗਾਮੀ ॥",
      "transliteration": "k sarabatr gaamee ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਥਾ (ਜਿਸ ਦੀ) ਪਹੁੰਚ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्र गामी ॥",
      "sourceLineId": "102927",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਿ ਧਰਮੇਸ ਧਾਮੀ ॥੨੩੫॥",
      "transliteration": "k dharames dhaamee ||235||",
      "translation": "That Sannyasi king was the destroyer of impiety, he went everywhere in his kingdom and was the abode of Dharma.235.",
      "punjabiViakhya": "ਸ੍ਰੇਸ਼ਠ ਧਰਮ ਧਾਮ ਵਾਲਾ ਹੈ ॥੨੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि धरमेस धामी ॥२३५॥",
      "sourceLineId": "102928",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਿ ਆਛਿਜ ਜੋਗੰ ॥",
      "transliteration": "k aachhij joga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਨਾ ਛਿਜਣ ਵਾਲੇ ਯੋਗ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि आछिज जोगं ॥",
      "sourceLineId": "102929",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਿ ਆਗੰਮ ਲੋਗੰ ॥",
      "transliteration": "k aaga(n)m loga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਲੋਕਾ ਦੀ ਪਹੁੰਚ ਤੋਂ ਪਰੇ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि आगंम लोगं ॥",
      "sourceLineId": "102930",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਿ ਲੰਗੋਟ ਬੰਧੰ ॥",
      "transliteration": "k la(n)goT ba(n)dha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਲੰਗੋਟ ਨੂੰ ਬੰਨ੍ਰਹਣ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि लंगोट बंधं ॥",
      "sourceLineId": "102931",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਿ ਸਰਬਤ੍ਰ ਮੰਧੰ ॥੨੩੬॥",
      "transliteration": "k sarabatr ma(n)dha(n) ||236||",
      "translation": "His Yoga was indestructible and wearing his loin-cloth, he moved everywhere in his kingdom.236.",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਦੇ ਵਿਚ ਵਸਦਾ ਹੈ ॥੨੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्र मंधं ॥२३६॥",
      "sourceLineId": "102932",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਿ ਆਛਿਜ ਕਰਮਾ ॥",
      "transliteration": "k aachhij karamaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਨਾ ਛਿਜਣ ਵਾਲੇ ਕਰਮਾ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि आछिज करमा ॥",
      "sourceLineId": "102933",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਿ ਆਲੋਕ ਧਰਮਾ ॥",
      "transliteration": "k aalok dharamaa ||",
      "translation": "His action and duties were illustrious and not liable to decay",
      "punjabiViakhya": "ਅਦੁੱਤੀ ਧਰਮ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि आलोक धरमा ॥",
      "sourceLineId": "102934",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਿ ਆਦੇਸ ਕਰਤਾ ॥",
      "transliteration": "k aadhes karataa ||",
      "translation": "",
      "punjabiViakhya": "ਆਦੇਸ਼ ਕਰਨ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि आदेस करता ॥",
      "sourceLineId": "102935",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਿ ਸੰਨ੍ਯਾਸ ਸਰਤਾ ॥੨੩੭॥",
      "transliteration": "k sa(n)nayaas sarataa ||237||",
      "translation": "He was the commander of all and was like a stream of Sannyas.237.",
      "punjabiViakhya": "ਸੰਨਿਆਸ ਦਾ ਦਰਿਆ ਹੈ ॥੨੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि संन्यास सरता ॥२३७॥",
      "sourceLineId": "102936",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਿ ਅਗਿਆਨ ਹੰਤਾ ॥",
      "transliteration": "k agiaan ha(n)taa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਅਗਿਆਨ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि अगिआन हंता ॥",
      "sourceLineId": "102937",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਿ ਪਾਰੰਗ ਗੰਤਾ ॥",
      "transliteration": "k paara(n)g ga(n)taa ||",
      "translation": "",
      "punjabiViakhya": "(ਸੰਸਾਰ ਤੋਂ) ਪਾਰ ਦੀ ਜਾਣਨ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि पारंग गंता ॥",
      "sourceLineId": "102938",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਿ ਆਧਰਮ ਹੰਤਾ ॥",
      "transliteration": "k aadharam ha(n)taa ||",
      "translation": "",
      "punjabiViakhya": "ਅਧਰਮ ਨੂੰ ਖ਼ਤਮ ਕਰਨ ਵਾਲਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि आधरम हंता ॥",
      "sourceLineId": "102939",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਿ ਸੰਨ੍ਯਾਸ ਭਕਤਾ ॥੨੩੮॥",
      "transliteration": "k sa(n)nayaas bhakataa ||238||",
      "translation": "He was the destroyer of ignorance, skilful in sciences, the destroyer of impiety and a devotee of Sannyasis.238.",
      "punjabiViakhya": "ਅਤੇ ਸੰਨਿਆਸ ਦਾ ਭਗਤ ਹੈ ॥੨੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि संन्यास भकता ॥२३८॥",
      "sourceLineId": "102940",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਿ ਖੰਕਾਲ ਦਾਸੰ ॥",
      "transliteration": "k kha(n)kaal dhaasa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਖੰਕਾਲ (ਭੈਰੋ) ਦਾ ਦਾਸ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि खंकाल दासं ॥",
      "sourceLineId": "102941",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਿ ਸਰਬਤ੍ਰ ਭਾਸੰ ॥",
      "transliteration": "k sarabatr bhaasa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਵਿਚ ਭਾਸਦਾ (ਪ੍ਰਤੀਤ ਹੁੰਦਾ) ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्र भासं ॥",
      "sourceLineId": "102942",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਿ ਸੰਨ੍ਯਾਸ ਰਾਜੰ ॥",
      "transliteration": "k sa(n)nayaas raaja(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਨਿਆਸ ਦਾ ਰਾਜਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि संन्यास राजं ॥",
      "sourceLineId": "102943",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਿ ਸਰਬਤ੍ਰ ਸਾਜੰ ॥੨੩੯॥",
      "transliteration": "k sarabatr saaja(n) ||239||",
      "translation": "He was the servitor of the Lord, he was felt everywhere by his subjects, a king in Sannyas and he was embellished with all learnings.239.",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਸਾਜਣ ਵਾਲਾ ਹੈ ॥੨੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्र साजं ॥२३९॥",
      "sourceLineId": "102944",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਿ ਪਾਰੰਗ ਗੰਤਾ ॥",
      "transliteration": "k paara(n)g ga(n)taa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ (ਸੰਸਾਰ ਤੋਂ) ਪਾਰ ਦੀ ਜਾਣਨ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि पारंग गंता ॥",
      "sourceLineId": "102945",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਿ ਆਧਰਮ ਹੰਤਾ ॥",
      "transliteration": "k aadharam ha(n)taa ||",
      "translation": "",
      "punjabiViakhya": "ਅਧਰਮ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि आधरम हंता ॥",
      "sourceLineId": "102946",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਿ ਸੰਨਿਆਸ ਭਕਤਾ ॥",
      "transliteration": "k sa(n)niaas bhakataa ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਨਿਆਸ ਦਾ ਭਗਤ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि संनिआस भकता ॥",
      "sourceLineId": "102947",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਿ ਸਾਜੋਜ ਮੁਕਤਾ ॥੨੪੦॥",
      "transliteration": "k saajoj mukataa ||240||",
      "translation": "He was the destroyer of impiety, a devotee of the path of Sannyas, of Jivan-mukta (redeemed while living) and was skilful in all learnings.240.",
      "punjabiViakhya": "ਅਤੇ ਸਾਯੁਜ ਮੁਕਤੀ ਵਾਲਾ ਹੈ ॥੨੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि साजोज मुकता ॥२४०॥",
      "sourceLineId": "102948",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਿ ਆਸਕਤ ਕਰਮੰ ॥",
      "transliteration": "k aasakat karama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਕਰਮਾ ਵਿਚ ਲੀਨ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि आसकत करमं ॥",
      "sourceLineId": "102949",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਿ ਅਬਿਯਕਤ ਧਰਮੰ ॥",
      "transliteration": "k abiyakat dharama(n) ||",
      "translation": "He was absorbed in good deeds, an unattached Yogi",
      "punjabiViakhya": "ਅਵਿਅਕਤ ਧਰਮ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि अबियकत धरमं ॥",
      "sourceLineId": "102950",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਿ ਅਤੇਵ ਜੋਗੀ ॥",
      "transliteration": "k atev jogee ||",
      "translation": "",
      "punjabiViakhya": "ਉਚੇ ਦਰਜੇ ਦਾ ਯੋਗੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि अतेव जोगी ॥",
      "sourceLineId": "102951",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਿ ਅੰਗੰ ਅਰੋਗੀ ॥੨੪੧॥",
      "transliteration": "k a(n)ga(n) arogee ||241||",
      "translation": "He was like unmanifested Dharma devoid of Yoga his limbs were healthy.241.",
      "punjabiViakhya": "ਸ਼ਰੀਰ ਵਜੋਂ ਰੋਗ ਰਹਿਤ ਹੈ ॥੨੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि अंगं अरोगी ॥२४१॥",
      "sourceLineId": "102952",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕਿ ਸੁਧੰ ਸੁਰੋਸੰ ॥",
      "transliteration": "k sudha(n) surosa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸ਼ੁੱਧ (ਅਣਖੀਲੇ) ਰੋਸ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि सुधं सुरोसं ॥",
      "sourceLineId": "102953",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਨ ਨੈਕੁ ਅੰਗ ਰੋਸੰ ॥",
      "transliteration": "n naik a(n)g rosa(n) ||",
      "translation": "He was never in ire, even slightly",
      "punjabiViakhya": "ਸ਼ਰੀਰ ਵਿਚ ਜ਼ਰਾ ਜਿੰਨਾ ਰੋਸ ਨਾ ਰਖਣ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "न नैकु अंग रोसं ॥",
      "sourceLineId": "102954",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਨ ਕੁਕਰਮ ਕਰਤਾ ॥",
      "transliteration": "n kukaram karataa ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਕਰਮ ਨਾ ਕਰਨ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "न कुकरम करता ॥",
      "sourceLineId": "102955",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਕਿ ਧਰਮੰ ਸੁ ਸਰਤਾ ॥੨੪੨॥",
      "transliteration": "k dharama(n) su sarataa ||242||",
      "translation": "No vice touched him and he ever flowed like the river of Dharma.242.",
      "punjabiViakhya": "ਅਤੇ ਧਰਮ ਦਾ ਦਰਿਆ ਹੈ ॥੨੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि धरमं सु सरता ॥२४२॥",
      "sourceLineId": "102956",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਕਿ ਜੋਗਾਧਿਕਾਰੀ ॥",
      "transliteration": "k jogaadhikaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਯੋਗ ਦਾ ਅਧਿਕਾਰੀ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि जोगाधिकारी ॥",
      "sourceLineId": "102957",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਕਿ ਸੰਨ੍ਯਾਸ ਧਾਰੀ ॥",
      "transliteration": "k sa(n)nayaas dhaaree ||",
      "translation": "He adopted Sannyas and was the supreme authority of Yoga",
      "punjabiViakhya": "ਸੰਨਿਆਸ ਧਾਰਨ ਕਰਨ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि संन्यास धारी ॥",
      "sourceLineId": "102958",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਕਿ ਬ੍ਰਹਮੰ ਸੁ ਭਗਤਾ ॥",
      "transliteration": "k brahama(n) su bhagataa ||",
      "translation": "",
      "punjabiViakhya": "ਜਗਤ ਨੂੰ ਸਿਰਜਨ ਵਾਲੇ",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि ब्रहमं सु भगता ॥",
      "sourceLineId": "102959",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਕਿ ਆਰੰਭ ਜਗਤਾ ॥੨੪੩॥",
      "transliteration": "k aara(n)bh jagataa ||243||",
      "translation": "He was the devotee of Brahman, the originator of the world.243.",
      "punjabiViakhya": "ਬ੍ਰਹਮਾ ਦਾ ਭਗਤ ਹੈ ॥੨੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि आरंभ जगता ॥२४३॥",
      "sourceLineId": "102960",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਕਿ ਜਾਟਾਨ ਜੂਟੰ ॥",
      "transliteration": "k jaaTaan jooTa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਜਟਾਵਾ ਦੇ ਜੂੜੇ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि जाटान जूटं ॥",
      "sourceLineId": "102961",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਕਿ ਨਿਧਿਆਨ ਛੂਟੰ ॥",
      "transliteration": "k nidhiaan chhooTa(n) ||",
      "translation": "That king wearing matted locks, had abandoned all the stores of materials",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਨਿਧੀਆਂ ਨੂੰ ਛਡਣ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि निधिआन छूटं ॥",
      "sourceLineId": "102962",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਕਿ ਅਬਿਯਕਤ ਅੰਗੰ ॥",
      "transliteration": "k abiyakat a(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਵਿਅਕਤ ਸ਼ਰੀਰ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि अबियकत अंगं ॥",
      "sourceLineId": "102963",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਕਿ ਕੈ ਪਾਨ ਭੰਗੰ ॥੨੪੪॥",
      "transliteration": "k kai paan bha(n)ga(n) ||244||",
      "translation": "And he wore waist-cloth.24.",
      "punjabiViakhya": "ਅਤੇ ਭੰਗ ਦਾ ਸੇਵਨ ਕਰਨ ਵਾਲਾ ਹੈ ॥੨੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि कै पान भंगं ॥२४४॥",
      "sourceLineId": "102964",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਕਿ ਸੰਨ੍ਯਾਸ ਕਰਮੀ ॥",
      "transliteration": "k sa(n)nayaas karamee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸੰਨਿਆਸ ਕਰਮ ਨੂੰ ਕਰਨ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि संन्यास करमी ॥",
      "sourceLineId": "102965",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਕਿ ਰਾਵਲ ਧਰਮੀ ॥",
      "transliteration": "k raaval dharamee ||",
      "translation": "He performed actions of Sannyas and adopted Rawal religion",
      "punjabiViakhya": "ਯੋਗ ਧਰਮ ਧਾਰਨ ਕਰਨ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि रावल धरमी ॥",
      "sourceLineId": "102966",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਕਿ ਤ੍ਰਿਕਾਲ ਕੁਸਲੀ ॥",
      "transliteration": "k tirakaal kusalee ||",
      "translation": "",
      "punjabiViakhya": "ਤਿੰਨ ਕਾਲ ਆਨੰਦਿਤ ਰਹਿਣ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि तृकाल कुसली ॥",
      "sourceLineId": "102967",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਕਿ ਕਾਮਾਦਿ ਦੁਸਲੀ ॥੨੪੫॥",
      "transliteration": "k kaamaadh dhusalee ||245||",
      "translation": "He always remained in bliss and was the destroyer of lust etc.245.",
      "punjabiViakhya": "ਅਤੇ ਕਾਮ ਆਦਿ (ਵਿਕਾਰਾ ਨੂੰ) ਕੁਚਲਣ ਵਾਲਾ ਹੈ ॥੨੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि कामादि दुसली ॥२४५॥",
      "sourceLineId": "102968",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਕਿ ਡਾਮਾਰ ਬਾਜੈ ॥",
      "transliteration": "k ddaamaar baajai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਡਮਰੂ ਵਜਾਉਣ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि डामार बाजै ॥",
      "sourceLineId": "102969",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0654_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਕਿ ਸਬ ਪਾਪ ਭਾਜੈ ॥",
      "transliteration": "k sab paap bhaajai ||",
      "translation": "The tabors were being played, hearing which all the sins had fled away",
      "punjabiViakhya": "ਸਾਰੇ ਪਾਪ ਭਜ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 654,
      "hindi": "",
      "hindiTransliteration": "कि सब पाप भाजै ॥",
      "sourceLineId": "102970",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
