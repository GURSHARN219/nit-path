{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 655,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0655_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਿ ਬਿਭੂਤ ਸੋਹੈ ॥",
      "transliteration": "k bibhoot sohai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਵਿਭੂਤੀ ਨਾਲ ਸ਼ੋਭਾ ਪਾ ਰਿਹਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि बिभूत सोहै ॥",
      "sourceLineId": "102971",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਿ ਸਰਬਤ੍ਰ ਮੋਹੈ ॥੨੪੬॥",
      "transliteration": "k sarabatr mohai ||246||",
      "translation": "His body had been smeared with ashes and all were getting allured towards him.246.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਨੂੰ ਮੋਹ ਰਿਹਾ ਹੈ ॥੨੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्र मोहै ॥२४६॥",
      "sourceLineId": "102972",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਿ ਲੰਗੋਟ ਬੰਦੀ ॥",
      "transliteration": "k la(n)goT ba(n)dhee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਲੰਗੋਟ ਨੂੰ ਬੰਨ੍ਰਹਣ ਵਾਲਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि लंगोट बंदी ॥",
      "sourceLineId": "102973",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਿ ਏਕਾਦਿ ਛੰਦੀ ॥",
      "transliteration": "k ekaadh chha(n)dhee ||",
      "translation": "He wore loin-cloth and spoke occasionally",
      "punjabiViakhya": "ਅਤੇ (ਜਿਸ ਨੂੰ) ਇਕ ਆਦਿ (ਕਾਲ ਤੋਂ ਮੌਜੂਦ ਦੀ) ਹੀ ਇੱਛਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि एकादि छंदी ॥",
      "sourceLineId": "102974",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਿ ਧਰਮਾਨ ਧਰਤਾ ॥",
      "transliteration": "k dharamaan dharataa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਧਰਮ ਨੂੰ ਧਾਰਨ ਕਰਨ ਵਾਲਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि धरमान धरता ॥",
      "sourceLineId": "102975",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਿ ਪਾਪਾਨ ਹਰਤਾ ॥੨੪੭॥",
      "transliteration": "k paapaan harataa ||247||",
      "translation": "He was the adopter of piety and destroyer of sin.247.",
      "punjabiViakhya": "ਅਤੇ ਪਾਪਾ ਨੂੰ ਹਰਨ ਵਾਲਾ ਹੈ ॥੨੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि पापान हरता ॥२४७॥",
      "sourceLineId": "102976",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਿ ਨਿਨਾਦਿ ਬਾਜੈ ॥",
      "transliteration": "k ninaadh baajai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਨਿਰੰਤਰ ਨਾਦ ਵਜ ਰਿਹਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि निनादि बाजै ॥",
      "sourceLineId": "102977",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਿ ਪੰਪਾਪ ਭਾਜੈ ॥",
      "transliteration": "k pa(n)paap bhaajai ||",
      "translation": "The horn was being blown and the sins were running away",
      "punjabiViakhya": "(ਜਿਸ ਕਰ ਕੇ) ਘੋਰ ਪਾਪ ਭਜ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि पंपाप भाजै ॥",
      "sourceLineId": "102978",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਿ ਆਦੇਸ ਬੁਲੈ ॥",
      "transliteration": "k aadhes bulai ||",
      "translation": "",
      "punjabiViakhya": "ਆਦੇਸ ਆਦੇਸ ਬੋਲਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि आदेस बुलै ॥",
      "sourceLineId": "102979",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਿ ਲੈ ਗ੍ਰੰਥ ਖੁਲੈ ॥੨੪੮॥",
      "transliteration": "k lai gra(n)th khulai ||248||",
      "translation": "The orders were given there that the religious texts be read.248.",
      "punjabiViakhya": "ਅਤੇ (ਮਨ ਦੀਆਂ) ਗੰਢਾ (ਗ੍ਰੰਥੀਆਂ) ਨੂੰ ਖੋਲ੍ਰਹਦੇ ਹਨ ॥੨੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि लै ग्रंथ खुलै ॥२४८॥",
      "sourceLineId": "102980",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਿ ਪਾਵਿਤ੍ਰ ਦੇਸੀ ॥",
      "transliteration": "k paavitr dhesee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਪਵਿਤ੍ਰ ਦੇਸ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि पावित्र देसी ॥",
      "sourceLineId": "102981",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਿ ਧਰਮੇਾਂਦ੍ਰ ਭੇਸੀ ॥",
      "transliteration": "k dharameaa(n)dhr bhesee ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਮ ਰਾਜ ਦੇ ਸਰੂਪ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि धरमेाँद्र भेसी ॥",
      "sourceLineId": "102982",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਿ ਲੰਗੋਟ ਬੰਦੰ ॥",
      "transliteration": "k la(n)goT ba(n)dha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਲੰਗੋਟ ਬੰਨ੍ਰਹਣ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि लंगोट बंदं ॥",
      "sourceLineId": "102983",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਿ ਆਜੋਤਿ ਵੰਦੰ ॥੨੪੯॥",
      "transliteration": "k aajot va(n)dha(n) ||249||",
      "translation": "In that holy country, assuming the religious garb, the prayer was being held, thinking of that one wearing the lion-cloth as effulgence.249.",
      "punjabiViakhya": "ਅਖੰਡ ਜੋਤਿ ਦੀ ਬੰਦਨਾ ਕਰਨ ਵਾਲਾ ਹੈ ॥੨੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि आजोति वंदं ॥२४९॥",
      "sourceLineId": "102984",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਿ ਆਨਰਥ ਰਹਿਤਾ ॥",
      "transliteration": "k aanarath rahitaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਅਨਰਥ ਤੋਂ ਰਹਿਤ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि आनरथ रहिता ॥",
      "sourceLineId": "102985",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਿ ਸੰਨ੍ਯਾਸ ਸਹਿਤਾ ॥",
      "transliteration": "k sa(n)nayaas sahitaa ||",
      "translation": "He was devoid of misfortune and attached to Sannyas",
      "punjabiViakhya": "ਸੰਨਿਆਸ ਸਹਿਤ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि संन्यास सहिता ॥",
      "sourceLineId": "102986",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਿ ਪਰਮੰ ਪੁਨੀਤੰ ॥",
      "transliteration": "k parama(n) puneeta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਮ ਅਤੇ ਪੁਨੀਤ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि परमं पुनीतं ॥",
      "sourceLineId": "102987",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਿ ਸਰਬਤ੍ਰ ਮੀਤੰ ॥੨੫੦॥",
      "transliteration": "k sarabatr meeta(n) ||250||",
      "translation": "He was supremely immaculate and friend of all.250.",
      "punjabiViakhya": "ਸਭ ਦਾ ਮਿਤਰ ਹੈ ॥੨੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्र मीतं ॥२५०॥",
      "sourceLineId": "102988",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਿ ਅਚਾਚਲ ਅੰਗੰ ॥",
      "transliteration": "k achaachal a(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਅਚੰਚਲ ਅੰਗ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि अचाचल अंगं ॥",
      "sourceLineId": "102989",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਿ ਜੋਗੰ ਅਭੰਗੰ ॥",
      "transliteration": "k joga(n) abha(n)ga(n) ||",
      "translation": "He was absorbed in yoga, having indescribable form",
      "punjabiViakhya": "ਨਾ ਭੰਗ ਹੋਣ ਵਾਲੇ ਯੋਗ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि जोगं अभंगं ॥",
      "sourceLineId": "102990",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਿ ਅਬਿਯਕਤ ਰੂਪੰ ॥",
      "transliteration": "k abiyakat roopa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਵਿਅਕਤ ਰੂਪ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि अबियकत रूपं ॥",
      "sourceLineId": "102991",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਿ ਸੰਨਿਆਸ ਭੂਪੰ ॥੨੫੧॥",
      "transliteration": "k sa(n)niaas bhoopa(n) ||251||",
      "translation": "He was a Sannyasi king.251.",
      "punjabiViakhya": "ਅਤੇ ਸੰਨਿਆਸ ਦਾ ਰਾਜਾ ਹੈ ॥੨੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि संनिआस भूपं ॥२५१॥",
      "sourceLineId": "102992",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਿ ਬੀਰਾਨ ਰਾਧੀ ॥",
      "transliteration": "k beeraan raadhee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ (ਬਵੰਜਾ) ਬੀਰਾ ਦੀ ਅਰਾਧਨਾ ਕਰਨ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि बीरान राधी ॥",
      "sourceLineId": "102993",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਿ ਸਰਬਤ੍ਰ ਸਾਧੀ ॥",
      "transliteration": "k sarabatr saadhee ||",
      "translation": "He was the hero of heroes and practiser of all the disciplines",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਸਾਧਣ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्र साधी ॥",
      "sourceLineId": "102994",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਿ ਪਾਵਿਤ੍ਰ ਕਰਮਾ ॥",
      "transliteration": "k paavitr karamaa ||",
      "translation": "",
      "punjabiViakhya": "ਪਵਿਤ੍ਰ ਕਰਮਾ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि पावित्र करमा ॥",
      "sourceLineId": "102995",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਿ ਸੰਨ੍ਯਾਸ ਧਰਮਾ ॥੨੫੨॥",
      "transliteration": "k sa(n)nayaas dharamaa ||252||",
      "translation": "He was a Sannyasi, performing underrfiled actions.252.",
      "punjabiViakhya": "ਅਤੇ ਸੰਨਿਆਸ ਧਰਮ ਵਾਲਾ ਹੈ ॥੨੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि संन्यास धरमा ॥२५२॥",
      "sourceLineId": "102996",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਪਾਖੰਡ ਰੰਗੰ ॥",
      "transliteration": "apaakha(n)dd ra(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਪਾਖੰਡ ਰਹਿਤ (ਅਰਥਾਤਰ- ਅਖੰਡ) ਤੋਂ ਰਹਿਤ,",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "अपाखंड रंगं ॥",
      "sourceLineId": "102997",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਿ ਆਛਿਜ ਅੰਗੰ ॥",
      "transliteration": "k aachhij a(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨਾ ਛਿਜਣ ਵਾਲੇ ਅੰਗ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि आछिज अंगं ॥",
      "sourceLineId": "102998",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਿ ਅੰਨਿਆਇ ਹਰਤਾ ॥",
      "transliteration": "k a(n)niaai harataa ||",
      "translation": "",
      "punjabiViakhya": "ਅਨਿਆਂ ਨੂੰ ਦੂਰ ਕਰਨ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि अंनिआइ हरता ॥",
      "sourceLineId": "102999",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਿ ਸੁ ਨ੍ਯਾਇ ਕਰਤਾ ॥੨੫੩॥",
      "transliteration": "k su nayai karataa ||253||",
      "translation": "He was like that Lord, who is imperishable, and just, the remover of injustice.253.",
      "punjabiViakhya": "ਅਤੇ ਨਿਆਂ ਕਰਨ ਵਾਲਾ ਹੈ ॥੨੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि सु न्याइ करता ॥२५३॥",
      "sourceLineId": "103000",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਿ ਕਰਮੰ ਪ੍ਰਨਾਸੀ ॥",
      "transliteration": "k karama(n) pranaasee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਕਰਮਾ ਦਾ ਨਾਸ਼ ਕਰਨ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि करमं प्रनासी ॥",
      "sourceLineId": "103001",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਿ ਸਰਬਤ੍ਰ ਦਾਸੀ ॥",
      "transliteration": "k sarabatr dhaasee ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਦਾ ਦਾਸ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्र दासी ॥",
      "sourceLineId": "103002",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਿ ਅਲਿਪਤ ਅੰਗੀ ॥",
      "transliteration": "k alipat a(n)gee ||",
      "translation": "",
      "punjabiViakhya": "ਨਿਰਲਿਪਤ ਸ਼ਰੀਰ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि अलिपत अंगी ॥",
      "sourceLineId": "103003",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਿ ਆਭਾ ਅਭੰਗੀ ॥੨੫੪॥",
      "transliteration": "k aabhaa abha(n)gee ||254||",
      "translation": "He was the destroyer of Karmas, the servitor of all, everywhere, unattached and glorious.254.",
      "punjabiViakhya": "ਅਤੇ ਅਭੰਗ ਆਭਾ ਵਾਲਾ ਹੈ ॥੨੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि आभा अभंगी ॥२५४॥",
      "sourceLineId": "103004",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਿ ਸਰਬਤ੍ਰ ਗੰਤਾ ॥",
      "transliteration": "k sarabatr ga(n)taa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸਭ ਵਿਚ ਗਮਨ ਕਰਨ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि सरबत्र गंता ॥",
      "sourceLineId": "103005",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਿ ਪਾਪਾਨ ਹੰਤਾ ॥",
      "transliteration": "k paapaan ha(n)taa ||",
      "translation": "",
      "punjabiViakhya": "ਪਾਪਾ ਨੂੰ ਨਾਸ਼ ਕਰਨ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि पापान हंता ॥",
      "sourceLineId": "103006",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਿ ਸਾਸਧ ਜੋਗੰ ॥",
      "transliteration": "k saasadh joga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਗ ਨੂੰ ਸਾਧਣ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कि सासध जोगं ॥",
      "sourceLineId": "103007",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਿਤੰ ਤਿਆਗ ਰੋਗੰ ॥੨੫੫॥",
      "transliteration": "kita(n) tiaag roga(n) ||255||",
      "translation": "He was the goer to all the places, the remover of sins, beyond all ailments and the one who remained a pure Yogi.255.",
      "punjabiViakhya": "ਅਤੇ ਰੋਗਾ ਨੂੰ ਤਿਆਗਣ ਵਾਲਾ ਹੈ ॥੨੫੫॥",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "कितं तिआग रोगं ॥२५५॥",
      "sourceLineId": "103008",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਤਿ ਸੁਰਥ ਰਾਜਾ ਯਾਰ੍ਰਹਮੋ ਗੁਰੂ ਬਰਨਨੰ ਸਮਾਪਤੰ ॥੧੧॥",
      "transliteration": "eit surath raajaa yaarrahamo guroo baranana(n) samaapata(n) ||11||",
      "translation": "End of the description of the Elventh Guru, the king Surath.",
      "punjabiViakhya": "ਇਥੇ ਸੁਰਥ ਰਾਜਾ ਯਾਰ੍ਰਹਵੇਾਂ ਗੁਰੂ ਦਾ ਵਰਣਨ ਸਮਾਪਤ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "इति सुरथ राजा यार्रहमो गुरू बरननं समापतं ॥११॥",
      "sourceLineId": "103009",
      "sourceShabadId": "9355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਥ ਬਾਲੀ ਦੁਆਦਸਮੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "transliteration": "ath baalee dhuaadhasamo guroo kathana(n) ||",
      "translation": "Now begins the description of the adoption of a Girl as the Twelfth Guru",
      "punjabiViakhya": "ਹੁਣ 'ਬਾਲੀ' ਬਾਰ੍ਰਹਵੇਾਂ ਗੁਰੂ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "अथ बाली दुआदसमो गुरू कथनं ॥",
      "sourceLineId": "103010",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "103011",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚਲਾ ਦਤ ਆਗੇ ॥",
      "transliteration": "chalaa dhat aage ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਤ ਅਗੇ ਚਲ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "चला दत आगे ॥",
      "sourceLineId": "103012",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਲਖੇ ਪਾਪ ਭਾਗੇ ॥",
      "transliteration": "lakhe paap bhaage ||",
      "translation": "Then Dutt moved further seeing him, the sins fled away",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਪਾਪ ਭਜ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "लखे पाप भागे ॥",
      "sourceLineId": "103013",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਜੈ ਘੰਟ ਘੋਰੰ ॥",
      "transliteration": "bajai gha(n)T ghora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਘੋਰ ਘੰਟੇ ਵਜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "बजै घंट घोरं ॥",
      "sourceLineId": "103014",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਣੰ ਜਾਣੁ ਮੋਰੰ ॥੨੫੬॥",
      "transliteration": "bana(n) jaan mora(n) ||256||",
      "translation": "The thunderous sound of the songs continued like the song of the peacocks in the forest.256.",
      "punjabiViakhya": "ਮਾਨੋ ਬਨ ਵਿਚ ਮੋਰ ਬੋਲਦੇ ਹੋਣ ॥੨੫੬॥",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "बणं जाणु मोरं ॥२५६॥",
      "sourceLineId": "103015",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਵੰ ਨਾਦ ਬਾਜੈ ॥",
      "transliteration": "nava(n) naadh baajai ||",
      "translation": "",
      "punjabiViakhya": "ਨਵੇਾਂ ਨਾਦ ਵਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "नवं नाद बाजै ॥",
      "sourceLineId": "103016",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਧਰਾ ਪਾਪ ਭਾਜੈ ॥",
      "transliteration": "dharaa paap bhaajai ||",
      "translation": "The horns were sounded in the sky and the sins of the earth ran away",
      "punjabiViakhya": "ਧਰਤੀ ਦੇ ਪਾਪ ਭਜ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "धरा पाप भाजै ॥",
      "sourceLineId": "103017",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0655_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਰੈ ਦੇਬ੍ਰਯ ਅਰਚਾ ॥",
      "transliteration": "karai dhebray arachaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵੀ ਦੀ ਪੂਜਾ ਕਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": "करै देब्रय अरचा ॥",
      "sourceLineId": "103018",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
