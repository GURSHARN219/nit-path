{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 656,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0656_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚਤੁਰ ਬੇਦ ਚਰਚਾ ॥੨੫੭॥",
      "transliteration": "chatur bedh charachaa ||257||",
      "translation": "He made offerings to the goddess and there was the discussion about the four Vedas.257.",
      "punjabiViakhya": "ਚੌਹਾ ਵੇਦਾ ਦੀ ਚਰਚਾ ਹੁੰਦੀ ਹੈ ॥੨੫੭॥",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "चतुर बेद चरचा ॥२५७॥",
      "sourceLineId": "103019",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸ੍ਰੁਤੰ ਸਰਬ ਪਾਠੰ ॥",
      "transliteration": "sruta(n) sarab paaTha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਵੇਦਾ ਦਾ ਪਾਠ ਕਰਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "स्रुतं सरब पाठं ॥",
      "sourceLineId": "103020",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੁ ਸੰਨ੍ਯਾਸ ਰਾਠੰ ॥",
      "transliteration": "s sa(n)nayaas raaTha(n) ||",
      "translation": "Recitation of all the Shrutis was performed for that Sannyas at the suitable place",
      "punjabiViakhya": "ਉਹ ਸੰਨਿਆਸ ਦਾ ਰਾਠ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "सु संन्यास राठं ॥",
      "sourceLineId": "103021",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਹਾਜੋਗ ਨ੍ਯਾਸੰ ॥",
      "transliteration": "mahaajog nayaasa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾਨ ਯੋਗ ਦਾ ਅਭਿਆਸ ਕਰਨ ਵਾਲਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "महाजोग न्यासं ॥",
      "sourceLineId": "103022",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਦਾਈ ਉਦਾਸੰ ॥੨੫੮॥",
      "transliteration": "sadhaiee udhaasa(n) ||258||",
      "translation": "The great practices of Yoga were held and there was atmosphere of detachment.258.",
      "punjabiViakhya": "ਅਤੇ ਸਦਾ ਉਦਾਸ ਰਹਿਣ ਵਾਲਾ ਹੈ ॥੨੫੮॥",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "सदाई उदासं ॥२५८॥",
      "sourceLineId": "103023",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਖਟੰ ਸਾਸਤ੍ਰ ਚਰਚਾ ॥",
      "transliteration": "khaTa(n) saasatr charachaa ||",
      "translation": "",
      "punjabiViakhya": "ਛੇਆਂ ਸ਼ਾਸਤ੍ਰਾ ਦੀ ਚਰਚਾ ਹੁੰਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "खटं सासत्र चरचा ॥",
      "sourceLineId": "103024",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਟੈ ਬੇਦ ਅਰਚਾ ॥",
      "transliteration": "raTai bedh arachaa ||",
      "translation": "",
      "punjabiViakhya": "ਵੇਦਾ ਨੂੰ ਰਟਦੇ ਅਤੇ ਪੂਜਾ ਕਰਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "रटै बेद अरचा ॥",
      "sourceLineId": "103025",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮਹਾ ਮੋਨ ਮਾਨੀ ॥",
      "transliteration": "mahaa mon maanee ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾਨ ਮੌਨ ਦੇ ਮਾਣ ਵਾਲਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "महा मोन मानी ॥",
      "sourceLineId": "103026",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਿ ਸੰਨ੍ਯਾਸ ਧਾਨੀ ॥੨੫੯॥",
      "transliteration": "k sa(n)nayaas dhaanee ||259||",
      "translation": "There was discussion of six Shastras and the recitation of the Vedas and the Sannyasis observed great silence.259.",
      "punjabiViakhya": "ਅਤੇ ਸੰਨਿਆਸ ਨੂੰ ਧਾਰਨ ਕਰਨ ਵਾਲਾ ਹੈ ॥੨੫੯॥",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "कि संन्यास धानी ॥२५९॥",
      "sourceLineId": "103027",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚਲਾ ਦਤ ਆਗੈ ॥",
      "transliteration": "chalaa dhat aagai ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਤ ਅਗੇ ਤੁਰ ਪਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "चला दत आगै ॥",
      "sourceLineId": "103028",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਲਖੇ ਪਾਪ ਭਾਗੈ ॥",
      "transliteration": "lakhe paap bhaagai ||",
      "translation": "Then Dutt move still further and seeing him, the sins fled away",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ) ਵੇਖ ਕੇ ਪਾਪ ਭਜ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "लखे पाप भागै ॥",
      "sourceLineId": "103029",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਲਖੀ ਏਕ ਕੰਨਿਆ ॥",
      "transliteration": "lakhee ek ka(n)niaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਕੰਨਿਆ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "लखी एक कंनिआ ॥",
      "sourceLineId": "103030",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਿਹੂੰ ਲੋਗ ਧੰਨਿਆ ॥੨੬੦॥",
      "transliteration": "tihoo(n) log dha(n)niaa ||260||",
      "translation": "There he was a girl, making the three worlds blessed ones.260.",
      "punjabiViakhya": "ਜੋ ਤਿੰਨਾ ਲੋਕਾ ਵਿਚ ਧੰਨ ਹੈ ॥੨੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "तिहूँ लोग धंनिआ ॥२६०॥",
      "sourceLineId": "103031",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਹਾ ਬ੍ਰਹਮਚਾਰੀ ॥",
      "transliteration": "mahaa brahamachaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਦੱਤ) ਵੱਡਾ ਬ੍ਰਹਮਚਾਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "महा ब्रहमचारी ॥",
      "sourceLineId": "103032",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੁ ਧਰਮਾਧਿਕਾਰੀ ॥",
      "transliteration": "s dharamaadhikaaree ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੇਸ਼ਠ ਧਰਮ ਦਾ ਅਧਿਕਾਰੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "सु धरमाधिकारी ॥",
      "sourceLineId": "103033",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਲਖੀ ਪਾਨਿ ਵਾ ਕੇ ॥",
      "transliteration": "lakhee paan vaa ke ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਬਾਲਿਕਾ ਦੇ) ਹੱਥ ਵਿਚ",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "लखी पानि वा के ॥",
      "sourceLineId": "103034",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗੁਡੀ ਬਾਲਿ ਤਾ ਕੇ ॥੨੬੧॥",
      "transliteration": "guddee baal taa ke ||261||",
      "translation": "This authority of Dharma and the great celibate saw a doll in her hand.261.",
      "punjabiViakhya": "ਇਕ ਗੁੱਡੀ ਵੇਖੀ ਹੈ ॥੨੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "गुडी बालि ता के ॥२६१॥",
      "sourceLineId": "103035",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਖਿਲੈ ਖੇਲ ਤਾ ਸੋ ॥",
      "transliteration": "khilai khel taa so ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਉਸ ਨਾਲ ਖੇਡਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "खिलै खेल ता सो ॥",
      "sourceLineId": "103036",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਇਸੋ ਹੇਤ ਵਾ ਸੋ ॥",
      "transliteration": "eiso het vaa so ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨਾਲ) ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਹਿਤ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "इसो हेत वा सो ॥",
      "sourceLineId": "103037",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪੀਐ ਪਾਨਿ ਨ ਆਵੈ ॥",
      "transliteration": "peeaai paan na aavai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ (ਉਹ) ਪਾਣੀ ਪੀਣ ਲਈ ਨਹੀਂ ਆਉਾਂਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "पीऐ पानि न आवै ॥",
      "sourceLineId": "103038",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਸੋ ਖੇਲ ਭਾਵੈ ॥੨੬੨॥",
      "transliteration": "eiso khel bhaavai ||262||",
      "translation": "She was playing with it and she loved it so much that she drank water and continued to play with it.262.",
      "punjabiViakhya": "ਅਤੇ ਇਸੇ (ਗੁੱਡੀ ਦੀ) ਖੇਡ (ਉਸ ਨੂੰ) ਚੰਗੀ ਲਗਦੀ ਹੈ ॥੨੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "इसो खेल भावै ॥२६२॥",
      "sourceLineId": "103039",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗਏ ਮੋਨਿ ਮਾਨੀ ॥",
      "transliteration": "ge mon maanee ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾਨ ਮੌਨ ਵਾਲਾ (ਦੱਤ) ਉਥੇ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "गए मोनि मानी ॥",
      "sourceLineId": "103040",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਰੈ ਦਿਸਟ ਆਨੀ ॥",
      "transliteration": "tarai dhisaT aanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਬਾਲਕਾ ਨੂੰ) ਨਜ਼ਰ ਹੇਠ ਲਿਆਂਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "तरै दिसट आनी ॥",
      "sourceLineId": "103041",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨ ਬਾਲਾ ਨਿਹਾਰ੍ਯੋ ॥",
      "transliteration": "n baalaa nihaarayo ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ ਉਸ) ਬਾਲਕਾ ਨੇ (ਇਸ ਵਲ) ਨਾ ਵੇਖਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "न बाला निहार्यो ॥",
      "sourceLineId": "103042",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨ ਖੇਲੰ ਬਿਸਾਰ੍ਯੋ ॥੨੬੩॥",
      "transliteration": "n khela(n) bisaarayo ||263||",
      "translation": "All those silence-observing Yogis went to that side and they saw her, but that girl did not see them and did not stop playing,263.",
      "punjabiViakhya": "ਅਤੇ ਨਾ ਹੀ ਖੇਡ ਨੂੰ ਵਿਸਾਰਿਆ ਹੈ ॥੨੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "न खेलं बिसार्यो ॥२६३॥",
      "sourceLineId": "103043",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਲਖੀ ਦਤ ਬਾਲਾ ॥",
      "transliteration": "lakhee dhat baalaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਤ ਨੇ (ਉਹ) ਕੁੜੀ ਵੇਖੀ,",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "लखी दत बाला ॥",
      "sourceLineId": "103044",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਨੋ ਰਾਗਮਾਲਾ ॥",
      "transliteration": "mano raagamaalaa ||",
      "translation": "The teeth the girl were like the garland of flowers",
      "punjabiViakhya": "ਮਾਨੋ ਰਾਗ ਮਾਲਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "मनो रागमाला ॥",
      "sourceLineId": "103045",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰੰਗੀ ਰੰਗਿ ਖੇਲੰ ॥",
      "transliteration": "ra(n)gee ra(n)g khela(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਖੇਡ ਵਿਚ ਪੂਰੀ ਤਰ੍ਰਹਾ ਮਗਨ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "रंगी रंगि खेलं ॥",
      "sourceLineId": "103046",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਨੋ ਨਾਗ੍ਰ ਬੇਲੰ ॥੨੬੪॥",
      "transliteration": "mano naagr bela(n) ||264||",
      "translation": "She was absorbed in frolic like the creeper clinging to the tree.264.",
      "punjabiViakhya": "ਮਾਨੋ ਪਾਨ ਦੀ ਬੇਲ (ਵਾਗ ਕੋਮਲ) ਹੋਵੇ ॥੨੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "मनो नाग्र बेलं ॥२६४॥",
      "sourceLineId": "103047",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਬੈ ਦਤ ਰਾਯੰ ॥",
      "transliteration": "tabai dhat raaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦੱਤ ਰਾਜ ਨੇ ਉਸ ਨੂੰ ਜਾ ਕੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "तबै दत रायं ॥",
      "sourceLineId": "103048",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਲਖੇ ਤਾਸ ਜਾਯੰ ॥",
      "transliteration": "lakhe taas jaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਗੁਰੂ ਧਾਰਨ ਕੀਤਾ (ਅਤੇ ਕਿਹਾ ਕਿ)",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "लखे तास जायं ॥",
      "sourceLineId": "103049",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੁਰੂ ਤਾਸ ਕੀਨਾ ॥",
      "transliteration": "guroo taas keenaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਮੰਤ੍ਰ ਵਿਚ (ਇੰਜ) ਭਿਜ ਜਾਣਾ ਚਾਹੀਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "गुरू तास कीना ॥",
      "sourceLineId": "103050",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਹਾ ਮੰਤ੍ਰ ਭੀਨਾ ॥੨੬੫॥",
      "transliteration": "mahaa ma(n)tr bheenaa ||265||",
      "translation": "Then Dutt, seeing her, eulogized her and accepting her as his Guru, he was absorbed in his great mantra.265.",
      "punjabiViakhya": "(ਜਿਹੋ ਜਿਹੀ ਇਹ ਬਾਲਕਾ ਖੇਡ ਵਿਚ ਭਿਜੀ ਹੋਈ ਹੈ) ॥੨੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "महा मंत्र भीना ॥२६५॥",
      "sourceLineId": "103051",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗੁਰੂ ਤਾਸ ਜਾਨ੍ਯੋ ॥",
      "transliteration": "guroo taas jaanayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਗੁਰੂ ਜਾਣ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "गुरू तास जान्यो ॥",
      "sourceLineId": "103052",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਇਮੰ ਮੰਤ੍ਰ ਠਾਨ੍ਰਯੋ ॥",
      "transliteration": "eima(n) ma(n)tr Thaanrayo ||",
      "translation": "He accepted her as his Guru and in this way, adopted the mantra",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਮੰਤ੍ਰ ਦ੍ਰਿੜ੍ਰਹ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "इमं मंत्र ठान्रयो ॥",
      "sourceLineId": "103053",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦਸੰ ਦ੍ਵੈ ਨਿਧਾਨੰ ॥",
      "transliteration": "dhasa(n) dhavai nidhaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਰ੍ਰਹਵਾ ਖ਼ਜ਼ਾਨਾ ਰੂਪ ਗੁਰੂ",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "दसं द्वै निधानं ॥",
      "sourceLineId": "103054",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗੁਰੂ ਦਤ ਜਾਨੰ ॥੨੬੬॥",
      "transliteration": "guroo dhat jaana(n) ||266||",
      "translation": "In this way, Dutt adopted his twelfth Guru.266.",
      "punjabiViakhya": "ਦੱਤ ਨੇ (ਉਸ ਨੂੰ) ਜਾਣ ਲਿਆ ॥੨੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "गुरू दत जानं ॥२६६॥",
      "sourceLineId": "103055",
      "sourceShabadId": "9356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰੁਣਝੁਣ ਛੰਦ ॥",
      "transliteration": "runajhun chha(n)dh ||",
      "translation": "RUNJHUN STANZA",
      "punjabiViakhya": "ਰੁਣਝੁਣ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "रुणझुण छंद ॥",
      "sourceLineId": "103056",
      "sourceShabadId": "9357",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਲਖਿ ਛਬਿ ਬਾਲੀ ॥",
      "transliteration": "lakh chhab baalee ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਲਕਾ ਦੀ ਛਬੀ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "लखि छबि बाली ॥",
      "sourceLineId": "103057",
      "sourceShabadId": "9357",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਤਿ ਦੁਤਿ ਵਾਲੀ ॥",
      "transliteration": "at dhut vaalee ||",
      "translation": "The beauty of that girl was unique and marvelous",
      "punjabiViakhya": "ਜੋ ਬਹੁਤ ਅਧਿਕ ਜੋਤਿ ਵਾਲੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "अति दुति वाली ॥",
      "sourceLineId": "103058",
      "sourceShabadId": "9357",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਤਿਭੁਤ ਰੂਪੰ ॥",
      "transliteration": "atibhut roopa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਅਦਭੁਤ ਰੂਪ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "अतिभुत रूपं ॥",
      "sourceLineId": "103059",
      "sourceShabadId": "9357",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਣੁ ਬੁਧਿ ਕੂਪੰ ॥੨੬੭॥",
      "transliteration": "jan budh koopa(n) ||267||",
      "translation": "She appeared to be a store of intellect the sage saw her.267.",
      "punjabiViakhya": "ਮਾਨੋ ਬੁੱਧੀ ਦਾ ਖੂਹ ਹੋਵੇ ॥੨੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "जणु बुधि कूपं ॥२६७॥",
      "sourceLineId": "103060",
      "sourceShabadId": "9357",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਫਿਰ ਫਿਰ ਪੇਖਾ ॥",
      "transliteration": "fir fir pekhaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਮੁੜ ਮੁੜ ਕੇ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "फिर फिर पेखा ॥",
      "sourceLineId": "103061",
      "sourceShabadId": "9357",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਲੇਖਾ ॥",
      "transliteration": "bahu bidh lekhaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਜਾਣਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि लेखा ॥",
      "sourceLineId": "103062",
      "sourceShabadId": "9357",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਨ ਮਨ ਜਾਨਾ ॥",
      "transliteration": "tan man jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਨ ਮਨ ਕਰ ਕੇ ਜਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "तन मन जाना ॥",
      "sourceLineId": "103063",
      "sourceShabadId": "9357",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਨ ਗਨ ਮਾਨਾ ॥੨੬੮॥",
      "transliteration": "gun gan maanaa ||268||",
      "translation": "Then he saw her again and again in various ways and accepted her quality in his mind and body.268.",
      "punjabiViakhya": "ਅਤੇ ਗੁਣਾ ਦੇ ਸਮੁੱਚ ਵਜੋਂ ਮੰਨਿਆ ॥੨੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "गुन गन माना ॥२६८॥",
      "sourceLineId": "103064",
      "sourceShabadId": "9357",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਿਹ ਗੁਰ ਕੀਨਾ ॥",
      "transliteration": "teh gur keenaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਗੁਰੂ ਬਣਾਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "तिह गुर कीना ॥",
      "sourceLineId": "103065",
      "sourceShabadId": "9357",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0656_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਤਿ ਜਸੁ ਲੀਨਾ ॥",
      "transliteration": "at jas leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਅਧਿਕ ਜਸ ਪ੍ਰਾਪਤ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": "अति जसु लीना ॥",
      "sourceLineId": "103066",
      "sourceShabadId": "9357",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
