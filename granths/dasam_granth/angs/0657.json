{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 657,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0657_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਗਿ ਤਬ ਚਾਲਾ ॥",
      "transliteration": "ag tab chaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਤ ਅਗੇ ਚਲ ਪਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "अगि तब चाला ॥",
      "sourceLineId": "103067",
      "sourceShabadId": "9357",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਨੁ ਮਨਿ ਜ੍ਵਾਲਾ ॥੨੬੯॥",
      "transliteration": "jan man javaiaalaa ||269||",
      "translation": "After adopting he as his Guru, he offered her approbation and then moved further like the flame of fire.269.",
      "punjabiViakhya": "ਮਾਨੋ ਅੱਗ ਦੀ ਮਣੀ ਹੋਵੇ ॥੨੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "जनु मनि ज्वाला ॥२६९॥",
      "sourceLineId": "103068",
      "sourceShabadId": "9357",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਇਤਿ ਦੁਆਦਸ ਗੁਰੂ ਲੜਕੀ ਗੁਡੀ ਖੇਡਤੀ ਸਮਾਪਤੰ ॥੧੨॥",
      "transliteration": "eit dhuaadhas guroo laRakee guddee kheddatee samaapata(n) ||12||",
      "translation": "End of the description of the adoption of a girl playing with her doll as his twelfth Guru.",
      "punjabiViakhya": "ਇਥੇ ਬਾਰ੍ਰਹਵਾ ਗੁਰੂ 'ਲੜਕੀ ਗੁਡੀ ਖੇਡਦੀ' ਪ੍ਰਸੰਗ ਸਮਾਪਤ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "इति दुआदस गुरू लड़की गुडी खेडती समापतं ॥१२॥",
      "sourceLineId": "103069",
      "sourceShabadId": "9357",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਥ ਭ੍ਰਿਤ ਤ੍ਰੋਦਸਮੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "transliteration": "ath bhirat trodhasamo guroo kathana(n) ||",
      "translation": "Now begins the description of an Orderly as the Thirteenth Guru",
      "punjabiViakhya": "ਹੁਣ ਦਾਸ ਰੂਪ ਤੇਰ੍ਰਹਵੇਾਂ ਗੁਰੂ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "अथ भृत त्रोदसमो गुरू कथनं ॥",
      "sourceLineId": "103070",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤੋਮਰ ਛੰਦ ॥",
      "transliteration": "tomar chha(n)dh ||",
      "translation": "TOMAR STANZA",
      "punjabiViakhya": "ਤੋਮਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "तोमर छंद ॥",
      "sourceLineId": "103071",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਬ ਦਤ ਦੇਵ ਮਹਾਨ ॥",
      "transliteration": "tab dhat dhev mahaan ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਮਹਾਨ ਦੱਤ ਦੇਵ",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "तब दत देव महान ॥",
      "sourceLineId": "103072",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦਸ ਚਾਰ ਚਾਰ ਨਿਧਾਨ ॥",
      "transliteration": "dhas chaar chaar nidhaan ||",
      "translation": "Then the great Dutt, who was a treasure in eighteen sciences and",
      "punjabiViakhya": "ਜੋ ਅਠਾਰ੍ਰਹਾ ਵਿਦਿਆਵਾ ਦਾ ਖ਼ਜ਼ਾਨਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "दस चार चार निधान ॥",
      "sourceLineId": "103073",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਤਿਭੁਤ ਉਤਮ ਗਾਤ ॥",
      "transliteration": "atibhut utam gaat ||",
      "translation": "",
      "punjabiViakhya": "ਅਦਭੁਤ ਉੱਤਮ ਸ਼ਰੀਰ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "अतिभुत उतम गात ॥",
      "sourceLineId": "103074",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹਰਿ ਨਾਮੁ ਲੇਤ ਪ੍ਰਭਾਤ ॥੨੭੦॥",
      "transliteration": "har naam let prabhaat ||270||",
      "translation": "Had a fine physique, used to remember the Name of the Lord at day-dawn.270.",
      "punjabiViakhya": "ਪ੍ਰਭਾਤ ਵੇਲੇ ਹਰਿ ਨਾਮ ਲੈਂਦਾ ਹੈ ॥੨੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "हरि नामु लेत प्रभात ॥२७०॥",
      "sourceLineId": "103075",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਕਲੰਕ ਉਜਲ ਅੰਗ ॥",
      "transliteration": "akala(n)k ujal a(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਕਲੰਕ ਰਹਿਤ ਉਜਲੇ ਸ਼ਰੀਰ ਨੂੰ ਵੇਖ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "अकलंक उजल अंग ॥",
      "sourceLineId": "103076",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਲਖਿ ਲਾਜ ਗੰਗ ਤਰੰਗ ॥",
      "transliteration": "lakh laaj ga(n)g tara(n)g ||",
      "translation": "Seeing his bright and blemishless limbs, the waves of Ganges felt shy",
      "punjabiViakhya": "ਗੰਗਾ ਦੀਆਂ ਲਹਿਰਾ ਲਜਾ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "लखि लाज गंग तरंग ॥",
      "sourceLineId": "103077",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਨਭੈ ਅਭੂਤ ਸਰੂਪ ॥",
      "transliteration": "anabhai abhoot saroop ||",
      "translation": "",
      "punjabiViakhya": "ਭੈ ਤੋਂ ਰਹਿਤ, (ਪੰਜ) ਭੂਤਾ ਤੋਂ ਬਿਨਾ",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "अनभै अभूत सरूप ॥",
      "sourceLineId": "103078",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਲਖਿ ਜੋਤਿ ਲਾਜਤ ਭੂਪ ॥੨੭੧॥",
      "transliteration": "lakh jot laajat bhoop ||271||",
      "translation": "Looking at his marvelous figure, the kings became shyful.271.",
      "punjabiViakhya": "(ਦੱਤ ਦੀ) ਜੋਤਿ ਨੂੰ ਵੇਖ ਕੇ ਰਾਜੇ ਮਹਾਰਾਜੇ ਸ਼ਰਮਿੰਦੇ ਹੁੰਦੇ ਹਨ ॥੨੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "लखि जोति लाजत भूप ॥२७१॥",
      "sourceLineId": "103079",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਵਲੋਕਿ ਸੁ ਭ੍ਰਿਤ ਏਕ ॥",
      "transliteration": "avalok su bhirat ek ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਸੇਵਕ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "अवलोकि सु भृत एक ॥",
      "sourceLineId": "103080",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਨ ਮਧਿ ਜਾਸੁ ਅਨੇਕ ॥",
      "transliteration": "gun madh jaas anek ||",
      "translation": "He saw an orderly, who had many qualities, even at midnight, he was standing at the gate",
      "punjabiViakhya": "ਜਿਸ ਵਿਚ ਅਨੇਕਾ ਗੁਣ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "गुन मधि जासु अनेक ॥",
      "sourceLineId": "103081",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਧਿ ਰਾਤਿ ਠਾਢਿ ਦੁਆਰਿ ॥",
      "transliteration": "adh raat Thaadd dhuaar ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਧ ਰਾਤ ਵੇਲੇ ਦੁਆਰ ਉਤੇ ਖੜੋਤਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "अधि राति ठाढि दुआरि ॥",
      "sourceLineId": "103082",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਹੁ ਬਰਖ ਮੇਘ ਫੁਹਾਰ ॥੨੭੨॥",
      "transliteration": "bahu barakh megh fuhaar ||272||",
      "translation": "In this way, during the rainfall, he stood firmly without caring for the rain.272.",
      "punjabiViakhya": "(ਉਸ ਵੇਲੇ) ਬਦਲਾ ਵਿਚੋਂ ਮੀਂਹ ਵਰ੍ਰਹ ਰਿਹਾ ਸੀ ॥੨੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "बहु बरख मेघ फुहार ॥२७२॥",
      "sourceLineId": "103083",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਧਿ ਰਾਤਿ ਦਤ ਨਿਹਾਰਿ ॥",
      "transliteration": "adh raat dhat nihaar ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਧੀ ਰਾਤ ਵੇਲੇ ਦੱਤ ਨੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "अधि राति दत निहारि ॥",
      "sourceLineId": "103084",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗੁਣਵੰਤ ਬਿਕ੍ਰਮ ਅਪਾਰ ॥",
      "transliteration": "gunava(n)t bikram apaar ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਅਪਾਰ ਗੁਣਵਾਨ ਅਤੇ ਬਲਵਾਨ (ਸੇਵਕ ਖੜੋਤਾ ਹੈ)",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "गुणवंत बिक्रम अपार ॥",
      "sourceLineId": "103085",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਲ ਮੁਸਲਧਾਰ ਪਰੰਤ ॥",
      "transliteration": "jal musaladhaar para(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੂਸਲਾਧਾਰ ਬਾਰਸ਼ ਪੈ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "जल मुसलधार परंत ॥",
      "sourceLineId": "103086",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਿਜ ਨੈਨ ਦੇਖਿ ਮਹੰਤ ॥੨੭੩॥",
      "transliteration": "nij nain dhekh maha(n)t ||273||",
      "translation": "Dutt saw that Vikram-like individual full of qualities at midnight and he also saw that it was greatly pleased in his mind.273.",
      "punjabiViakhya": "ਦੱਤ ('ਮਹੰਤ') ਨੇ ਆਪਣੀਆਂ ਅੱਖਾ ਨਾਲ ਵੇਖ ਲਿਆ ॥੨੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "निज नैन देखि महंत ॥२७३॥",
      "sourceLineId": "103087",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਇਕ ਚਿਤ ਠਾਢ ਸੁ ਐਸ ॥",
      "transliteration": "eik chit Thaadd su aais ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਇਸ ਤਰ੍ਰਹਾ ਇਕ-ਚਿਤ ਹੋ ਕੇ ਖੜੋਤਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "इक चित ठाढ सु ऐस ॥",
      "sourceLineId": "103088",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੋਵਰਨ ਮੂਰਤਿ ਜੈਸ ॥",
      "transliteration": "sovaran moorat jais ||",
      "translation": "He seemed standing like a golden statue single-mindedly",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕੋਈ ਸੋਨੇ ਦੀ ਮੂਰਤੀ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "सोवरन मूरति जैस ॥",
      "sourceLineId": "103089",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦ੍ਰਿੜ ਦੇਖਿ ਤਾ ਕੀ ਮਤਿ ॥",
      "transliteration": "dhiraR dhekh taa kee mat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਦ੍ਰਿੜ੍ਰਹ ਮਤ ਵੇਖ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "दृड़ देखि ता की मति ॥",
      "sourceLineId": "103090",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਤਿ ਮਨਹਿ ਰੀਝੇ ਦਤ ॥੨੭੪॥",
      "transliteration": "at maneh reejhe dhat ||274||",
      "translation": "Seeing his concerntration, Dutt was greatly pleased in his mind. 274.",
      "punjabiViakhya": "ਦੱਤ ਮਨ ਵਿਚ ਬਹੁਤ ਪ੍ਰਸੰਨ ਹੋਇਆ ॥੨੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "अति मनहि रीझे दत ॥२७४॥",
      "sourceLineId": "103091",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਹੀ ਸੀਤ ਮਾਨਤ ਘਾਮ ॥",
      "transliteration": "nahee seet maanat ghaam ||",
      "translation": "",
      "punjabiViakhya": "ਠੰਡ ਅਤੇ ਧੁਪ ਨੂੰ ਨਹੀਂ ਮੰਨਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "नही सीत मानत घाम ॥",
      "sourceLineId": "103092",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਹੀ ਚਿਤ ਲ੍ਯਾਵਤ ਛਾਮ ॥",
      "transliteration": "nahee chit layaavat chhaam ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਾ ਹੀ ਛਾ ਵਿਚ (ਖੜੋਣ ਦਾ) ਮਨ ਵਿਚ ਧਿਆਨ ਲਿਆਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "नही चित ल्यावत छाम ॥",
      "sourceLineId": "103093",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਹੀ ਨੈਕੁ ਮੋਰਤ ਅੰਗ ॥",
      "transliteration": "nahee naik morat a(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਕਰਤੱਵ ਤੋਂ) ਬਿਲਕੁਲ ਅੰਗ ਨਹੀਂ ਮੋੜਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "नही नैकु मोरत अंग ॥",
      "sourceLineId": "103094",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਇਕ ਪਾਇ ਠਾਢ ਅਭੰਗ ॥੨੭੫॥",
      "transliteration": "eik pai Thaadd abha(n)g ||275||",
      "translation": "He thought that this man was not caring for cold or hot weather and there is no desire of some shade in his mind he was standing on one foot without even slightly turning his limbs.275.",
      "punjabiViakhya": "(ਉਹ) ਅਭੰਗ (ਸਰੂਪ ਵਾਲਾ) ਇਕ ਪੈਰ ਉਤੇ ਖੜੋਤਾ ਹੈ ॥੨੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "इक पाइ ठाढ अभंग ॥२७५॥",
      "sourceLineId": "103095",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਢਿਗ ਦਤ ਤਾ ਕੇ ਜਾਇ ॥",
      "transliteration": "ddig dhat taa ke jai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਕੋਲ ਜਾ ਕੇ ਦੱਤ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "ढिग दत ता के जाइ ॥",
      "sourceLineId": "103096",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਵਿਲੋਕਿ ਤਾਸੁ ਬਨਾਏ ॥",
      "transliteration": "avilok taas banaae ||",
      "translation": "Dutt went near him and looked down upon him, learning. a bit",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਵੇਖਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "अविलोकि तासु बनाए ॥",
      "sourceLineId": "103097",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਧਿ ਰਾਤ੍ਰਿ ਨਿਰਜਨ ਤ੍ਰਾਸ ॥",
      "transliteration": "adh raatr nirajan traas ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਨਿਰਜਨ ਅਤੇ ਡਰਾਉਣੀ ਅੱਧੀ ਰਾਤ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "अधि रातृ निरजन त्रास ॥",
      "sourceLineId": "103098",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਸਿ ਲੀਨ ਠਾਢ ਉਦਾਸ ॥੨੭੬॥",
      "transliteration": "as leen Thaadd udhaas ||276||",
      "translation": "He was standing detachedly in that desolate atmosphere at midnighgt.276.",
      "punjabiViakhya": "ਤਲਵਾਰ ਲੈ ਕੇ ਨਿਰਲਿਪਤ ਖੜਾ ਹੈ ॥੨੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "असि लीन ठाढ उदास ॥२७६॥",
      "sourceLineId": "103099",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਰਖੰਤ ਮੇਘ ਮਹਾਨ ॥",
      "transliteration": "barakha(n)t megh mahaan ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਜ਼ਿਆਦਾ ਬਾਰਸ਼ ਹੋ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "बरखंत मेघ महान ॥",
      "sourceLineId": "103100",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭਾਜੰਤ ਭੂਮਿ ਨਿਧਾਨ ॥",
      "transliteration": "bhaaja(n)t bhoom nidhaan ||",
      "translation": "It was raining and the water was spreading on the earth",
      "punjabiViakhya": "ਭੂਮੀ ਅਤੇ ਖ਼ਜ਼ਾਨੇ ਵਾਲੇ ਵੀ ਭਿਜ ਰਹੇ ਹਨ (ਅਰਥਾਤਰ-ਭਜ ਰਹੇ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "भाजंत भूमि निधान ॥",
      "sourceLineId": "103101",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਗਿ ਜੀਵ ਸਰਬ ਸੁ ਭਾਸ ॥",
      "transliteration": "jag jeev sarab su bhaas ||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ) ਆਭਾਸ ਹੁੰਦਾ ਹੈ ਕਿ ਜਗਤ ਦੇ ਸਾਰੇ ਜੀਵ",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "जगि जीव सरब सु भास ॥",
      "sourceLineId": "103102",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਉਠਿ ਭਾਜ ਤ੍ਰਾਸ ਉਦਾਸ ॥੨੭੭॥",
      "transliteration": "auTh bhaaj traas udhaas ||277||",
      "translation": "All the beings of the world ran away in fear.277.",
      "punjabiViakhya": "(ਬਾਰਸ਼ ਵਿਚ ਭਿਜਣ ਤੋਂ) ਡਰਦੇ ਹੋਏ ਉਠ ਕੇ ਭਜ ਗਏ ਹਨ ॥੨੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "उठि भाज त्रास उदास ॥२७७॥",
      "sourceLineId": "103103",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਇਹ ਠਾਢ ਭੂਪਤਿ ਪਉਰ ॥",
      "transliteration": "eeh Thaadd bhoopat paur ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ) ਇਹ (ਸੇਵਕ) ਰਾਜੇ ਦੇ ਦੁਆਰ ਉਤੇ ਖੜੋਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "इह ठाढ भूपति पउर ॥",
      "sourceLineId": "103104",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮਨ ਜਾਪ ਜਾਪਤ ਗਉਰ ॥",
      "transliteration": "man jaap jaapat gaur ||",
      "translation": "This orderly was standing at the gate of the king like this and was repeating the name of the goddess Gauri-Parvati in his mind",
      "punjabiViakhya": "ਅਤੇ ਮਨ ਵਿਚ ਗ਼ੌਰ (ਧਿਆਨ) ਨਾਲ ਜਾਪ ਜਪਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "मन जाप जापत गउर ॥",
      "sourceLineId": "103105",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਹੀ ਨੈਕੁ ਮੋਰਤ ਅੰਗ ॥",
      "transliteration": "nahee naik morat a(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਕਰਤੱਵ ਪਾਲਣ ਤੋਂ) ਜ਼ਰਾ ਵੀ ਅੰਗ ਨਹੀਂ ਮੋੜਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "नही नैकु मोरत अंग ॥",
      "sourceLineId": "103106",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਇਕ ਪਾਵ ਠਾਢ ਅਭੰਗ ॥੨੭੮॥",
      "transliteration": "eik paav Thaadd abha(n)g ||278||",
      "translation": "He was standing on one foot, without even slightly turning his limbs.278.",
      "punjabiViakhya": "(ਉਹ) ਅਭੰਗ (ਸਰੂਪ ਵਾਲਾ) ਇਕ ਪੈਰ ਉਤੇ ਖੜੋਤਾ ਹੈ ॥੨੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "इक पाव ठाढ अभंग ॥२७८॥",
      "sourceLineId": "103107",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਸਿ ਲੀਨ ਪਾਨਿ ਕਰਾਲ ॥",
      "transliteration": "as leen paan karaal ||",
      "translation": "",
      "punjabiViakhya": "ਹੱਥ ਵਿਚ ਭਿਆਨਕ ਤਲਵਾਰ ਲਈ ਹੋਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "असि लीन पानि कराल ॥",
      "sourceLineId": "103108",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਚਮਕੰਤ ਉਜਲ ਜ੍ਵਾਲ ॥",
      "transliteration": "chamaka(n)t ujal javaiaal ||",
      "translation": "A dreadful sword was shining in his hand like a flame of fire and",
      "punjabiViakhya": "(ਉਹ ਤਲਵਾਰ) ਅਗਨੀ ਵਾਗ ਉਜਲੇ ਰੂਪ ਨਾਲ ਚਮਕ ਰਹੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "चमकंत उजल ज्वाल ॥",
      "sourceLineId": "103109",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਨ ਕਾਹੂ ਕੋ ਨਹੀ ਮਿਤ੍ਰ ॥",
      "transliteration": "jan kaahoo ko nahee mitr ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਉਹ ਕਿਸੇ ਦਾ ਵੀ ਮਿਤਰ ਨਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "जन काहू को नही मित्र ॥",
      "sourceLineId": "103110",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਪਰਮ ਪਵਿਤ੍ਰ ॥੨੭੯॥",
      "transliteration": "eeh bhaat param pavitr ||279||",
      "translation": "He was standing solemnly without seeming to have friendliness for anyone.279.",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ (ਉਹ) ਪਰਮ ਪਵਿਤ੍ਰ ਹੈ ॥੨੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "इह भाति परम पवित्र ॥२७९॥",
      "sourceLineId": "103111",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਹੀ ਨੈਕੁ ਉਚਾਵਤ ਪਾਉ ॥",
      "transliteration": "nahee naik uchaavat paau ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਜ਼ਰਾ ਜਿੰਨਾ ਵੀ ਪੈਰ ਨਹੀਂ ਚੁਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "नही नैकु उचावत पाउ ॥",
      "sourceLineId": "103112",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਹੁ ਭਾਤਿ ਸਾਧਤ ਦਾਉ ॥",
      "transliteration": "bahu bhaat saadhat dhaau ||",
      "translation": "He was not even raising his foot slightly and he was in the posture of playing trick in many ways",
      "punjabiViakhya": "ਬਹੁਤ ਢੰਗਾ ਨਾਲ ਕਰਤੱਵ ਨਿਭਾ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "बहु भाति साधत दाउ ॥",
      "sourceLineId": "103113",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0657_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਨਆਸ ਭੂਪਤਿ ਭਗਤ ॥",
      "transliteration": "anaas bhoopat bhagat ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਨਾ ਕਿਸੇ ਆਸ ਦੇ ਰਾਜੇ ਦਾ ਭਗਤ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": "अनआस भूपति भगत ॥",
      "sourceLineId": "103114",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
