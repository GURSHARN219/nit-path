{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 658,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0658_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪ੍ਰਭ ਏਕ ਹੀ ਰਸ ਪਗਤ ॥੨੮੦॥",
      "transliteration": "prabh ek hee ras pagat ||280||",
      "translation": "He was a devotee of the king dyed unswervingly in the love of the Lord.280.",
      "punjabiViakhya": "ਉਹ ਸੁਆਮੀ ('ਪ੍ਰਭ') ਦੇ ਪ੍ਰੇਮ ਵਿਚ ਹੀ ਮਗਨ ਹੈ ॥੨੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "प्रभ एक ही रस पगत ॥२८०॥",
      "sourceLineId": "103115",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਲ ਪਰਤ ਮੂਸਲਧਾਰ ॥",
      "transliteration": "jal parat moosaladhaar ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਸਲਾਧਾਰ ਬਾਰਸ਼ ਹੋ ਰਹੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "जल परत मूसलधार ॥",
      "sourceLineId": "103116",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗ੍ਰਿਹ ਲੇ ਨ ਓਟਿ ਦੁਆਰ ॥",
      "transliteration": "gireh le na oT dhuaar ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ ਫਿਰ ਵੀ ਉਹ) ਘਰ ਦੇ ਦਰਵਾਜ਼ੇ ਦੀ ਓਟ ਨਹੀਂ ਲੈਂਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "गृह ले न ओटि दुआर ॥",
      "sourceLineId": "103117",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਸੁ ਪਛ ਸਰਬਿ ਦਿਸਾਨ ॥",
      "transliteration": "pas pachh sarab dhisaan ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਦਿਸ਼ਾਵਾ ਦੇ ਪਸ਼ੂ ਅਤੇ ਪੰਛੀ",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "पसु पछ सरबि दिसान ॥",
      "sourceLineId": "103118",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਭ ਦੇਸ ਦੇਸ ਸਿਧਾਨ ॥੨੮੧॥",
      "transliteration": "sabh dhes dhes sidhaan ||281||",
      "translation": "Because of heavy rain, all the animals and birds were going from various directions to their homes in order to take shelter.281.",
      "punjabiViakhya": "ਆਪਣੇ ਆਪਣੇ ਦੇਸਾ (ਭਾਵ ਠਿਕਾਣਿਆਂ) ਨੂੰ ਚਲੇ ਗਏ ਹਨ ॥੨੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "सभ देस देस सिधान ॥२८१॥",
      "sourceLineId": "103119",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਇਹ ਠਾਢ ਹੈ ਇਕ ਆਸ ॥",
      "transliteration": "eeh Thaadd hai ik aas ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਇਕ ਆਸ ਉਤੇ ਖੜੋਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "इह ठाढ है इक आस ॥",
      "sourceLineId": "103120",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਇਕ ਪਾਨ ਜਾਨ ਉਦਾਸ ॥",
      "transliteration": "eik paan jaan udhaas ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਪੈਰ (ਉਤੇ) ਵਿਰਕਤ (ਭਾਵ ਨਾਲ ਖੜੋਤਾ ਹੈ)।",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "इक पान जान उदास ॥",
      "sourceLineId": "103121",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਸਿ ਲੀਨ ਪਾਨਿ ਪ੍ਰਚੰਡ ॥",
      "transliteration": "as leen paan pracha(n)dd ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਹੱਥ ਵਿਚ ਤਲਵਾਰ ਲਈ ਹੋਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "असि लीन पानि प्रचंड ॥",
      "sourceLineId": "103122",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਤਿ ਤੇਜਵੰਤ ਅਖੰਡ ॥੨੮੨॥",
      "transliteration": "at tejava(n)t akha(n)dd ||282||",
      "translation": "He was standing detachedly on one foot and taking his sword in one of his hands, he was looking extremely lustrous.282.",
      "punjabiViakhya": "(ਜੋ) ਬਹੁਤ ਸ਼ਕਤੀਸ਼ਾਲੀ ਅਤੇ ਨਾ ਟੁਟਣ ਵਾਲੀ ਹੈ ॥੨੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "अति तेजवंत अखंड ॥२८२॥",
      "sourceLineId": "103123",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਨਿ ਆਨਿ ਕੋ ਨਹੀ ਭਾਵ ॥",
      "transliteration": "man aan ko nahee bhaav ||",
      "translation": "",
      "punjabiViakhya": "ਮਨ ਵਿਚ ਕਿਸੇ ਹੋਰ ਦਾ ਭਾਵ ਨਹੀਂ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "मनि आनि को नही भाव ॥",
      "sourceLineId": "103124",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਕ ਦੇਵ ਕੋ ਚਿਤ ਚਾਵ ॥",
      "transliteration": "eik dhev ko chit chaav ||",
      "translation": "",
      "punjabiViakhya": "ਬਸ ਇਕ ਦੇਵ (ਸੁਆਮੀ) ਦਾ ਹੀ ਚਿਤ ਵਿਚ ਚਾਉ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "इक देव को चित चाव ॥",
      "sourceLineId": "103125",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਇਕ ਪਾਵ ਐਸੇ ਠਾਢ ॥",
      "transliteration": "eik paav aaise Thaadd ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਪੈਰ ਉਤੇ ਇਸ ਤਰ੍ਰਹਾ ਖੜੋਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "इक पाव ऐसे ठाढ ॥",
      "sourceLineId": "103126",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਨ ਖੰਭ ਜਾਨੁਕ ਗਾਡ ॥੨੮੩॥",
      "transliteration": "ran kha(n)bh jaanuk gaadd ||283||",
      "translation": "There was no other idea in his mind except his master and he was standing on one foot like a column standing in the battlefield.283.",
      "punjabiViakhya": "ਮਾਨੋ ਰਣ-ਭੂਮੀ ਵਿਚ ਖੰਭਾ ਗਡਿਆ ਹੋਵੇ ॥੨੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "रन खंभ जानुक गाड ॥२८३॥",
      "sourceLineId": "103127",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਿਹ ਭੂਮਿ ਧਾਰਸ ਪਾਵ ॥",
      "transliteration": "jeh bhoom dhaaras paav ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਭੂਮੀ ਉਤੇ (ਉਸ ਨੇ) ਪੈਰ ਧਰਿਆ ਹੋਇਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "जिह भूमि धारस पाव ॥",
      "sourceLineId": "103128",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਹੀ ਨੈਕੁ ਫੇਰਿ ਉਚਾਵ ॥",
      "transliteration": "nahee naik fer uchaav ||",
      "translation": "Wherever he placed his foot, he firmly fixed it there",
      "punjabiViakhya": "(ਉਸ ਥਾ ਤੋਂ) ਫਿਰ ਜ਼ਰਾ ਜਿੰਨਾ ਵੀ ਚੁਕਿਆ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "नही नैकु फेरि उचाव ॥",
      "sourceLineId": "103129",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਹੀ ਠਾਮ ਭੀਜਸ ਤਉਨ ॥",
      "transliteration": "nahee Thaam bheejas taun ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸਥਾਨ ਭਿਜ ਨਹੀਂ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "नही ठाम भीजस तउन ॥",
      "sourceLineId": "103130",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਵਲੋਕ ਭਇਓ ਮੁਨਿ ਮਉਨ ॥੨੮੪॥",
      "transliteration": "avalok bhio mun maun ||284||",
      "translation": "At his place, he was not getting wet and seeing him the sage Dutt kept silent.284.",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਵੇਖ ਕੇ ਮੁਨੀ (ਦੱਤ) ਚੁਪ ਹੋ ਗਿਆ ॥੨੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "अवलोक भइओ मुनि मउन ॥२८४॥",
      "sourceLineId": "103131",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਵਲੋਕਿ ਤਾਸੁ ਮੁਨੇਸ ॥",
      "transliteration": "avalok taas munes ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਰੋਮਣੀ ਮੁਨੀ ਨੇ ਉਸ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "अवलोकि तासु मुनेस ॥",
      "sourceLineId": "103132",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਕਲੰਕ ਭਾਗਵਿ ਭੇਸ ॥",
      "transliteration": "akala(n)k bhaagav bhes ||",
      "translation": "The sage saw him and he seemed to him like a part of a blemishless moon",
      "punjabiViakhya": "ਜੋ ਨਿਸ਼-ਕਲੰਕ ਭਗਵੇ ਭੇਸ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "अकलंक भागवि भेस ॥",
      "sourceLineId": "103133",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗੁਰੁ ਜਾਨਿ ਪਰੀਆ ਪਾਇ ॥",
      "transliteration": "gur jaan pareeaa pai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਸੇਵਕ ਨੂੰ) ਗੁਰੂ ਜਾਣ ਕੇ ਉਸ ਦੇ ਪੈਰੀਂ ਪੈ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "गुरु जानि परीआ पाइ ॥",
      "sourceLineId": "103134",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਜਿ ਲਾਜ ਸਾਜ ਸਚਾਇ ॥੨੮੫॥",
      "transliteration": "taj laaj saaj sachai ||285||",
      "translation": "The sage abandoning his shyness and accepting him as his Guru, fell at his feet.285.",
      "punjabiViakhya": "ਅਤੇ ਚਾਉ ਨਾਲ ਲਾਜ ਅਤੇ ਸਾਜ ਸਭ ਨੂੰ ਛਡ ਦਿੱਤਾ ॥੨੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "तजि लाज साज सचाइ ॥२८५॥",
      "sourceLineId": "103135",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਿਹ ਜਾਨ ਕੈ ਗੁਰਦੇਵ ॥",
      "transliteration": "teh jaan kai gurdhev ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਗੁਰੂਦੇਵ ਜਾਣ ਕੇ ਕਲੰਕ ਰਹਿਤ",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "तिह जान कै गुरदेव ॥",
      "sourceLineId": "103136",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਕਲੰਕ ਦਤ ਅਭੇਵ ॥",
      "transliteration": "akala(n)k dhat abhev ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਭੇਵ ਦੱਤ ਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "अकलंक दत अभेव ॥",
      "sourceLineId": "103137",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚਿਤ ਤਾਸ ਕੇ ਰਸ ਭੀਨ ॥",
      "transliteration": "chit taas ke ras bheen ||",
      "translation": "",
      "punjabiViakhya": "ਚਿੱਤ ਉਸ ਦੇ ਰਸ ਵਿਚ ਭਿਜ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "चित तास के रस भीन ॥",
      "sourceLineId": "103138",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗੁਰੁ ਤ੍ਰਉਦਸਮੋ ਤਿਹ ਕੀਨ ॥੨੮੬॥",
      "transliteration": "gur traudhasamo teh keen ||286||",
      "translation": "The blemishless Dutt, accepting him as his Guru, absorbed his mind in his love and in this way adopted him as the Thirteenth Guru.286.",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਤੇਰ੍ਰਹਵਾ ਗੁਰੂ ਧਾਰਨ ਕੀਤਾ ॥੨੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "गुरु त्रउदसमो तिह कीन ॥२८६॥",
      "sourceLineId": "103139",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਇਤਿ ਤ੍ਰਉਦਸਮੋ ਗੁਰੂ ਭ੍ਰਿਤ ਸਮਾਪਤੰ ॥੧੩॥",
      "transliteration": "eit traudhasamo guroo bhirat samaapata(n) ||13||",
      "translation": "End of the description of the Thirteenth Guru.",
      "punjabiViakhya": "ਇਥੇ ਤੇਰ੍ਰਹਵਾ ਗੁਰੂ 'ਸੇਵਕ' ਦਾ ਪ੍ਰਸੰਗ ਸਮਾਪਤ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "इति त्रउदसमो गुरू भृत समापतं ॥१३॥",
      "sourceLineId": "103140",
      "sourceShabadId": "9358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਥ ਚਤੁਰਦਸਮੋ ਗੁਰ ਨਾਮ ॥",
      "transliteration": "ath chaturadhasamo gur naam ||",
      "translation": "Now begins the description of the Fourteenth Guru",
      "punjabiViakhya": "ਹੁਣ ਚੌਦਵੇਾਂ ਗੁਰੂ ਦੇ ਨਾਮ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "अथ चतुरदसमो गुर नाम ॥",
      "sourceLineId": "103141",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰਸਾਵਲ ਛੰਦ ॥",
      "transliteration": "rasaaval chha(n)dh ||",
      "translation": "RASAAVAL STANZA",
      "punjabiViakhya": "ਰਸਾਵਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "रसावल छंद ॥",
      "sourceLineId": "103142",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਚਲ੍ਯੋ ਦਤ ਰਾਜੰ ॥",
      "transliteration": "chalayo dhat raaja(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਤ ਰਾਜਾ ਅਗੇ ਨੂੰ ਚਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "चल्यो दत राजं ॥",
      "sourceLineId": "103143",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਲਖੇ ਪਾਪ ਭਾਜੰ ॥",
      "transliteration": "lakhe paap bhaaja(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ) ਵੇਖ ਕੇ ਪਾਪ ਭਜੀ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "लखे पाप भाजं ॥",
      "sourceLineId": "103144",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਿਨੈ ਨੈਕੁ ਪੇਖਾ ॥",
      "transliteration": "jinai naik pekhaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਜ਼ਰਾ ਜਿੰਨਾ ਵੀ (ਉਸ ਨੂੰ) ਵੇਖ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "जिनै नैकु पेखा ॥",
      "sourceLineId": "103145",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੁਰੂ ਤੁਲਿ ਲੇਖਾ ॥੨੮੭॥",
      "transliteration": "guroo tul lekhaa ||287||",
      "translation": "Dutt moved further, seeing whom the sins ran away whosover saw him he saw him as his Guru.287.",
      "punjabiViakhya": "ਉਸ ਨੇ (ਉਸ ਨੂੰ) ਗੁਰੂ ਦੇ ਸਮਾਨ ਜਾਣਿਆ ॥੨੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "गुरू तुलि लेखा ॥२८७॥",
      "sourceLineId": "103146",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਹਾ ਜੋਤਿ ਰਾਜੈ ॥",
      "transliteration": "mahaa jot raajai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਮੁਖ ਉਤੇ ਮਹਾਨ ਜੋਤਿ ਬਿਰਾਜ ਰਹੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "महा जोति राजै ॥",
      "sourceLineId": "103147",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਲਖੈ ਪਾਪ ਭਾਜੈ ॥",
      "transliteration": "lakhai paap bhaajai ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ) ਵੇਖ ਕੇ ਪਾਪ ਭਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "लखै पाप भाजै ॥",
      "sourceLineId": "103148",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਹਾ ਤੇਜ ਸੋਹੈ ॥",
      "transliteration": "mahaa tej sohai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ ਮੂੰਹ ਉਤੇ) ਮਹਾਨ ਤੇਜ ਸ਼ੋਭ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "महा तेज सोहै ॥",
      "sourceLineId": "103149",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਿਵਊ ਤੁਲਿ ਕੋ ਹੈ ॥੨੮੮॥",
      "transliteration": "sivuoo tul ko hai ||288||",
      "translation": "Seeing that lustrous and glorious sage, the sins ran away and if there was anyone like the grat Shiva, it was only Dutt.288.",
      "punjabiViakhya": "(ਜਿਸ ਦੇ) ਸਮਾਨ ਸ਼ਿਵ ਵੀ ਕੌਣ ਹੈ ॥੨੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "सिवऊ तुलि को है ॥२८८॥",
      "sourceLineId": "103150",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਨੈ ਨੈਕੁ ਪੇਖਾ ॥",
      "transliteration": "jinai naik pekhaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਥੋੜਾ ਜਿੰਨਾ ਵੀ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "जिनै नैकु पेखा ॥",
      "sourceLineId": "103151",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਨੋ ਮੈਨ ਦੇਖਾ ॥",
      "transliteration": "mano main dhekhaa ||",
      "translation": "Whosoever saw him, saw the god of love in him",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਮਾਨੋ ਕਾਮਦੇਵ ਨੂੰ ਹੀ ਵੇਖਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "मनो मैन देखा ॥",
      "sourceLineId": "103152",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਹੀ ਬ੍ਰਹਮ ਜਾਨਾ ॥",
      "transliteration": "sahee braham jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸਹੀ ਰੂਪ ਵਿਚ ਬ੍ਰਹਮ ਜਾਣਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "सही ब्रहम जाना ॥",
      "sourceLineId": "103153",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨ ਦ੍ਵੈ ਭਾਵ ਆਨਾ ॥੨੮੯॥",
      "transliteration": "n dhavai bhaav aanaa ||289||",
      "translation": "He considered him like Brahman and destroyed his duality.289.",
      "punjabiViakhya": "ਅਤੇ ਮਨ ਵਿਚ ਦ੍ਵੈਤ ਭਾਵ ਨਹੀਂ ਲਿਆਂਦਾ ਹੈ ॥੨੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "न द्वै भाव आना ॥२८९॥",
      "sourceLineId": "103154",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰਿਝੀ ਸਰਬ ਨਾਰੀ ॥",
      "transliteration": "rijhee sarab naaree ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆ ਇਸਤਰੀਆਂ (ਉਸ ਉਤੇ) ਰੀਝ ਰਹੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "रिझी सरब नारी ॥",
      "sourceLineId": "103155",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮਹਾ ਤੇਜ ਧਾਰੀ ॥",
      "transliteration": "mahaa tej dhaaree ||",
      "translation": "All the women were allured by that great and illustrious Dutt and",
      "punjabiViakhya": "ਜੋ ਮਹਾਨ ਤੇਜ ਨੂੰ ਧਾਰਨ ਕਰਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "महा तेज धारी ॥",
      "sourceLineId": "103156",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨ ਹਾਰੰ ਸੰਭਾਰੈ ॥",
      "transliteration": "n haara(n) sa(n)bhaarai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਨਾ ਹਾਰਾ ਨੂੰ ਸੰਭਾਲਦੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "न हारं संभारै ॥",
      "sourceLineId": "103157",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨ ਚੀਰਊ ਚਿਤਾਰੈ ॥੨੯੦॥",
      "transliteration": "n cheeruoo chitaarai ||290||",
      "translation": "They were not anxious about garments and ornaments.290.",
      "punjabiViakhya": "ਅਤੇ ਨਾ ਬਸਤ੍ਰਾ ਦੀ ਸੋਚ ਕਰਦੀਆਂ ਹਨ ॥੨੯੦॥",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "न चीरऊ चितारै ॥२९०॥",
      "sourceLineId": "103158",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚਲੀ ਧਾਇ ਐਸੇ ॥",
      "transliteration": "chalee dhai aaise ||",
      "translation": "",
      "punjabiViakhya": "(ਦੱਤ ਦੇ ਦਰਸ਼ਨ ਲਈ) ਉਹ ਇਸ ਤਰ੍ਰਹਾ ਭਜ ਕੇ ਚਲੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "चली धाइ ऐसे ॥",
      "sourceLineId": "103159",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਦੀ ਨਾਵ ਜੈਸੇ ॥",
      "transliteration": "nadhee naav jaise ||",
      "translation": "They were running like the boat moving forward in the stream",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਨਦੀ ਵਿਚ ਬੇੜੀ ਜਾਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "नदी नाव जैसे ॥",
      "sourceLineId": "103160",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜੁਵਾ ਬ੍ਰਿਧ ਬਾਲੈ ॥",
      "transliteration": "juvaa biradh baalai ||",
      "translation": "",
      "punjabiViakhya": "ਜਵਾਨ, ਬਿਰਧ ਅਤੇ ਬਾਲਿਕਾਵਾ (ਇਨ੍ਰਹਾ ਵਿਚੋਂ)",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "जुवा बृध बालै ॥",
      "sourceLineId": "103161",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0658_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਹੀ ਕੌ ਨ ਆਲੈ ॥੨੯੧॥",
      "transliteration": "rahee kau na aalai ||291||",
      "translation": "None of the young, old and minors remained behind.291.",
      "punjabiViakhya": "ਕੋਈ ਵੀ ਘਰ ('ਆਲੈ') ਨਹੀਂ ਰਹੀ ਹੈ ॥੨੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 658,
      "hindi": "",
      "hindiTransliteration": "रही कौ न आलै ॥२९१॥",
      "sourceLineId": "103162",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
