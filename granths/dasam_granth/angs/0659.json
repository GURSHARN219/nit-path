{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 659,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0659_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਲਹੀ ਏਕ ਨਾਰੀ ॥",
      "transliteration": "lahee ek naaree ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ) ਇਕ ਇਸਤਰੀ ਵੇਖੀ",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "लही एक नारी ॥",
      "sourceLineId": "103163",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੁ ਧਰਮਾਧਿਕਾਰੀ ॥",
      "transliteration": "s dharamaadhikaaree ||",
      "translation": "The sage, the authority on Dharma, saw a women,",
      "punjabiViakhya": "ਜੋ (ਸੱਚੇ) ਧਰਮ ਦੀ ਅਧਿਕਾਰੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "सु धरमाधिकारी ॥",
      "sourceLineId": "103164",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਿਧੌ ਪਾਰਬਤੀ ਛੈ ॥",
      "transliteration": "kidhau paarabatee chhai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਜਾ ਤਾ ਪਾਰਬਤੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "किधौ पारबती छै ॥",
      "sourceLineId": "103165",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਨੋ ਬਾਸਵੀ ਹੈ ॥੨੯੨॥",
      "transliteration": "mano baasavee hai ||292||",
      "translation": "Who looked like Parvati or Indrani.292.",
      "punjabiViakhya": "(ਜਾ) ਮਾਨੋ ਇੰਦਰਾਣੀ ਹੋਵੇ ॥੨੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "मनो बासवी है ॥२९२॥",
      "sourceLineId": "103166",
      "sourceShabadId": "9359",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸ੍ਰੀ ਭਗਵਤੀ ਛੰਦ ॥",
      "transliteration": "sree bhagavatee chha(n)dh ||",
      "translation": "SHRI BHAGVATI STANZA",
      "punjabiViakhya": "ਸ੍ਰੀ ਭਗਵਤੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "स्री भगवती छंद ॥",
      "sourceLineId": "103167",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਿ ਰਾਜਾ ਸ੍ਰੀ ਛੈ ॥",
      "transliteration": "k raajaa sree chhai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰਾਜ ਲੱਛਮੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि राजा स्री छै ॥",
      "sourceLineId": "103168",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਿ ਬਿਦੁਲਤਾ ਛੈ ॥",
      "transliteration": "k bidhulataa chhai ||",
      "translation": "She was looking like the Lakshmi of the kings",
      "punjabiViakhya": "ਜਾ ਬਿਦੁਲਤਾ (ਦੇਵੀ) ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि बिदुलता छै ॥",
      "sourceLineId": "103169",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਿ ਹਈਮਾਦ੍ਰਜਾ ਹੈ ॥",
      "transliteration": "k hieemaadhrajaa hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਹਿਮਾਲੇ (ਪਰਬਤ) ਦੀ ਪੁੱਤਰੀ (ਪਾਰਬਤੀ) ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि हईमाद्रजा है ॥",
      "sourceLineId": "103170",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਿ ਪਰਮੰ ਪ੍ਰਭਾ ਹੈ ॥੨੯੩॥",
      "transliteration": "k parama(n) prabhaa hai ||293||",
      "translation": "She was glorious like the beautiful damsels of Madra Desha.293.",
      "punjabiViakhya": "ਜਾ ਪਰਮ ਪ੍ਰਭਾ ਹੈ ॥੨੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि परमं प्रभा है ॥२९३॥",
      "sourceLineId": "103171",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਿ ਰਾਮੰ ਤ੍ਰੀਆ ਹੈ ॥",
      "transliteration": "k raama(n) treeaa hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਰਾਮ ਦੀ ਇਸਤਰੀ (ਸੀਤਾ) ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि रामं त्रीआ है ॥",
      "sourceLineId": "103172",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਿ ਰਾਜੰ ਪ੍ਰਭਾ ਹੈ ॥",
      "transliteration": "k raaja(n) prabhaa hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਰਾਜ ਦੀ ਪ੍ਰਭੁਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि राजं प्रभा है ॥",
      "sourceLineId": "103173",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਿ ਰਾਜੇਸ੍ਵਰੀ ਛੈ ॥",
      "transliteration": "k raajesavairee chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਰਾਜੇਸ਼ਵਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि राजेस्वरी छै ॥",
      "sourceLineId": "103174",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਿ ਰਾਮਾਨੁਜਾ ਛੈ ॥੨੯੪॥",
      "transliteration": "k raamaanujaa chhai ||294||",
      "translation": "She might be Sita, or the prowess of the kings, or the chief queen of some king or the moving figure behind Ram.294.",
      "punjabiViakhya": "ਜਾ ਬਲਰਾਮ ਦੀ ਭੈਣ ('ਰਾਮਾਨੁਜਾ') (ਭਾਵ ਸੁਭਦ੍ਰਾ) ਹੈ ॥੨੯੪॥",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि रामानुजा छै ॥२९४॥",
      "sourceLineId": "103175",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਿ ਕਾਲਿੰਦ੍ਰ ਕਾ ਛੈ ॥",
      "transliteration": "k kaali(n)dhr kaa chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਜਮਨਾ ਨਦੀ ('ਕਾਲਿੰਦ੍ਰਕਾ) ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि कालिंद्र का छै ॥",
      "sourceLineId": "103176",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਿ ਕਾਮੰ ਪ੍ਰਭਾ ਛੈ ॥",
      "transliteration": "k kaama(n) prabhaa chhai ||",
      "translation": "She might be Yamuna, united with the glory of the god of love",
      "punjabiViakhya": "ਜਾ ਕਾਮ ਦੀ ਪ੍ਰਭਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि कामं प्रभा छै ॥",
      "sourceLineId": "103177",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਿ ਦੇਵਾਨੁਜਾ ਹੈ ॥",
      "transliteration": "k dhevaanujaa hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਦੇਵਤਿਆਂ ਦੀ ਭੈਣ (ਅਪੱਛਰਾ) ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि देवानुजा है ॥",
      "sourceLineId": "103178",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਿ ਦਈਤੇਸੁਰਾ ਹੈ ॥੨੯੫॥",
      "transliteration": "k dhieetesuraa hai ||295||",
      "translation": "She was like the goddess of the goddesses and the heavenly damsel of the demons.295.",
      "punjabiViakhya": "ਜਾ ਦੈਂਤਾ (ਦੇ ਗੁਰੂ ਦੀ) ਇਸਤਰੀ (ਅਥਵਾ ਰਾਣੀ) ਹੈ ॥੨੯੫॥",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि दईतेसुरा है ॥२९५॥",
      "sourceLineId": "103179",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਿ ਸਾਵਿਤ੍ਰਕਾ ਛੈ ॥",
      "transliteration": "k saavitrakaa chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਸਾਵਿਤ੍ਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि सावित्रका छै ॥",
      "sourceLineId": "103180",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਿ ਗਾਇਤ੍ਰੀ ਆਛੈ ॥",
      "transliteration": "k gaitree aachhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਗਾਇਤ੍ਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि गाइत्री आछै ॥",
      "sourceLineId": "103181",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਿ ਦੇਵੇਸ੍ਵਰੀ ਹੈ ॥",
      "transliteration": "k dhevesavairee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਦੇਵਤਿਆਂ ਦੀ ਸੁਆਮਨੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि देवेस्वरी है ॥",
      "sourceLineId": "103182",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਿ ਰਾਜੇਸ੍ਵਰੀ ਛੈ ॥੨੯੬॥",
      "transliteration": "k raajesavairee chhai ||296||",
      "translation": "She was looking like Savitri, Gayatri, the supreme goddess amongst the goddesses and the chief queen amongst the queens.296.",
      "punjabiViakhya": "ਜਾ ਰਾਮੇਸ਼ਵਰੀ ਹੈ ॥੨੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि राजेस्वरी छै ॥२९६॥",
      "sourceLineId": "103183",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਿ ਮੰਤ੍ਰਾਵਲੀ ਹੈ ॥",
      "transliteration": "k ma(n)traavalee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਮੰਤ੍ਰਾ ਦੀ ਲੜੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि मंत्रावली है ॥",
      "sourceLineId": "103184",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਿ ਤੰਤ੍ਰਾਲਕਾ ਛੈ ॥",
      "transliteration": "k ta(n)traalakaa chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਤੰਤ੍ਰਾ ਦੀ ਮਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि तंत्रालका छै ॥",
      "sourceLineId": "103185",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਿ ਹਈਮਾਦ੍ਰਜਾ ਛੈ ॥",
      "transliteration": "k hieemaadhrajaa chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਹਿਮਾਲਾ ਦੀ ਪੁੱਤਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि हईमाद्रजा छै ॥",
      "sourceLineId": "103186",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਿ ਹੰਸੇਸੁਰੀ ਹੈ ॥੨੯੭॥",
      "transliteration": "k ha(n)sesuree hai ||297||",
      "translation": "She was a princess skilful in mantras and tantras and seemed like Hansani (a female swan).297.",
      "punjabiViakhya": "ਜਾ ਸਰਸਵਤੀ ਹੈ ॥੨੯੭॥",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि हंसेसुरी है ॥२९७॥",
      "sourceLineId": "103187",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਿ ਜਾਜੁਲਿਕਾ ਛੈ ॥",
      "transliteration": "k jaajulikaa chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਬਿਜਲੀ ਦੀ ਚਮਕ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि जाजुलिका छै ॥",
      "sourceLineId": "103188",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੁਵਰਨ ਆਦਿਜਾ ਛੈ ॥",
      "transliteration": "suvaran aadhijaa chhai ||",
      "translation": "Looking like the heated gold in fife, she seemed like Shachi, the wife of Indra",
      "punjabiViakhya": "ਜਾ ਸੋਨੇ ਦੀ ਲਿਸ਼ਕ ਪੈਦਾ ਹੋਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "सुवरन आदिजा छै ॥",
      "sourceLineId": "103189",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਿ ਸੁਧੰ ਸਚੀ ਹੈ ॥",
      "transliteration": "k sudha(n) sachee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਸਹੀ ਰੂਪ ਵਿਚ 'ਸ਼ਚੀ' (ਇੰਦਰਾਣੀ) ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि सुधं सची है ॥",
      "sourceLineId": "103190",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਿ ਬ੍ਰਹਮਾ ਰਚੀ ਹੈ ॥੨੯੮॥",
      "transliteration": "k brahamaa rachee hai ||298||",
      "translation": "It seemed that Brahma had himself created her.298.",
      "punjabiViakhya": "ਜਾ ਬ੍ਰਹਮਾ ਦੀ ਬਣਾਈ ਹੋਈ ਹੈ ॥੨੯੮॥",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि ब्रहमा रची है ॥२९८॥",
      "sourceLineId": "103191",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਿ ਪਰਮੇਸੁਰਜਾ ਹੈ ॥",
      "transliteration": "k paramesurajaa hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਪਰਮ ਐਸ਼ਵਰਜਾ ('ਭਵਾਨੀ') ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि परमेसुरजा है ॥",
      "sourceLineId": "103192",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਿ ਪਰਮੰ ਪ੍ਰਭਾ ਹੈ ॥",
      "transliteration": "k parama(n) prabhaa hai ||",
      "translation": "She was like Lakshmi and supremely glorious",
      "punjabiViakhya": "ਜਾ ਪਰਮ ਪ੍ਰਭਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि परमं प्रभा है ॥",
      "sourceLineId": "103193",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਿ ਪਾਵਿਤ੍ਰਤਾ ਛੈ ॥",
      "transliteration": "k paavitrataa chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਪਵਿਤ੍ਰਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि पावित्रता छै ॥",
      "sourceLineId": "103194",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
