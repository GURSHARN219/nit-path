      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि टोडीज आछै ॥",
      "sourceLineId": "103205",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
