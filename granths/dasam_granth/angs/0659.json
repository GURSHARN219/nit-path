      "translation": "",
      "punjabiViakhya": "ਜਾ ਮਹਾ ਗੌੜੀ (ਰਾਗਨੀ) ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि गउरी महा है ॥",
      "sourceLineId": "103202",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਿ ਟੋਡੀ ਪ੍ਰਭਾ ਹੈ ॥੩੦੧॥",
