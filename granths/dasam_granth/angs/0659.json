      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਿ ਰਾਜੇਸ੍ਵਰੀ ਹੈ ॥੩੦੦॥",
      "transliteration": "k raajesavairee hai ||300||",
      "translation": "She was looking splendid like Rajeshwari or was like a specially like Gauri-Parvati.301.",
