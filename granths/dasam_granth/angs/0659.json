      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि टोडी प्रभा है ॥३०१॥",
      "sourceLineId": "103203",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਿ ਭੂਪਾਲਕਾ ਛੈ ॥",
