      "source": "DASAM_GRANTH",
      "ang": 659,
      "hindi": "",
      "hindiTransliteration": "कि राजेस्वरी है ॥३००॥",
      "sourceLineId": "103199",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0659_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਿ ਰਾਜਹਿ ਸਿਰੀ ਹੈ ॥",
      "transliteration": "k raajeh siree hai ||",
