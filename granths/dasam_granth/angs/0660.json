{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 660,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0660_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਿ ਆਕਾਸ ਉਤਰੀ ॥੩੦੩॥",
      "transliteration": "k aakaas utaree ||303||",
      "translation": "She looked like Megh-Malhar, or Gauri Dhamar or the daughter of Hindol, descending from the sky.303.",
      "punjabiViakhya": "ਜਾ ਆਕਾਸ਼ ਤੋਂ ਉਤਰੀ ਹੋਈ (ਪਰੀ) ਹੈ ॥੩੦੩॥",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि आकास उतरी ॥३०३॥",
      "sourceLineId": "103211",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੁ ਸਊਹਾਗ ਵੰਤੀ ॥",
      "transliteration": "s suoohaag va(n)tee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸੁਹਾਗਵੰਤੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "सु सऊहाग वंती ॥",
      "sourceLineId": "103212",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਿ ਪਾਰੰਗ ਗੰਤੀ ॥",
      "transliteration": "k paara(n)g ga(n)tee ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਪਾਰ ਦੀ ਜਾਣਨ ਵਾਲੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि पारंग गंती ॥",
      "sourceLineId": "103213",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਿ ਖਟ ਸਾਸਤ੍ਰ ਬਕਤਾ ॥",
      "transliteration": "k khaT saasatr bakataa ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਛੇ ਸ਼ਾਸਤ੍ਰਾ ਦਾ ਕਥਨ ਕਰਨ ਵਾਲੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि खट सासत्र बकता ॥",
      "sourceLineId": "103214",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਿ ਨਿਜ ਨਾਹ ਭਗਤਾ ॥੩੦੪॥",
      "transliteration": "k nij naeh bhagataa ||304||",
      "translation": "That fortunate woman was engrossed in arts and absorbed in Shastras she was the devotee of her Lord.304.",
      "punjabiViakhya": "ਜਾ ਆਪਣੇ ਪਤੀ ਦੀ ਭਗਤੀ ਕਰਨ ਵਾਲੀ ਹੈ ॥੩੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि निज नाह भगता ॥३०४॥",
      "sourceLineId": "103215",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਿ ਰੰਭਾ ਸਚੀ ਹੈ ॥",
      "transliteration": "k ra(n)bhaa sachee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਰੰਭਾ ਹੈ, ਜਾ ਸਚੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि रंभा सची है ॥",
      "sourceLineId": "103216",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਿ ਬ੍ਰਹਮਾ ਰਚੀ ਹੈ ॥",
      "transliteration": "k brahamaa rachee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਬ੍ਰਹਮਾ ਦੀ ਰਚੀ ਹੋਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि ब्रहमा रची है ॥",
      "sourceLineId": "103217",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਿ ਗੰਧ੍ਰਬਣੀ ਛੈ ॥",
      "transliteration": "k ga(n)dhrabanee chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਗੰਧਰਬ ਇਸਤਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि गंध्रबणी छै ॥",
      "sourceLineId": "103218",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਿ ਬਿਦਿਆਧਰੀ ਛੈ ॥੩੦੫॥",
      "transliteration": "k bidhiaadharee chhai ||305||",
      "translation": "She was looking like Rambha, Shachi, the special creation of Brahma, Gandharva woman or the daughter of Vidyadhars.305.",
      "punjabiViakhya": "ਜਾ ਵਿਦਿਆਧਰ (ਦੇਵਤਿਆਂ ਵਿਚੋਂ ਕਿਸੇ ਦੀ) ਧੀ-ਭੈਣ ਜਾ ਇਸਤਰੀ ਹੈ ॥੩੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि बिदिआधरी छै ॥३०५॥",
      "sourceLineId": "103219",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਿ ਰੰਭਾ ਉਰਬਸੀ ਛੈ ॥",
      "transliteration": "k ra(n)bhaa urabasee chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਰੰਭਾ ਜਾ ਉਰਬਸੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि रंभा उरबसी छै ॥",
      "sourceLineId": "103220",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਿ ਸੁਧੰ ਸਚੀ ਛੈ ॥",
      "transliteration": "k sudha(n) sachee chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਸਹੀ ਸਚੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि सुधं सची छै ॥",
      "sourceLineId": "103221",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਿ ਹੰਸ ਏਸ੍ਵਰੀ ਹੈ ॥",
      "transliteration": "k ha(n)s esavairee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਹੰਸ ਦੀ ਸੁਆਮਨੀ (ਭਾਵ ਸਰਸਵਤੀ) ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि हंस एस्वरी है ॥",
      "sourceLineId": "103222",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਿ ਹਿੰਡੋਲਕਾ ਛੈ ॥੩੦੬॥",
      "transliteration": "k hi(n)ddolakaa chhai ||306||",
      "translation": "She, seemed swinging like Rambha, Urvashi and Shachi.306.",
      "punjabiViakhya": "ਜਾ ਹਿੰਡੋਲ ਰਾਗ ਦੀ ਰਾਗਨੀ ਹੈ ॥੩੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि हिंडोलका छै ॥३०६॥",
      "sourceLineId": "103223",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਿ ਗੰਧ੍ਰਬਣੀ ਹੈ ॥",
      "transliteration": "k ga(n)dhrabanee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਗੰਧਰਬ ਇਸਤਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि गंध्रबणी है ॥",
      "sourceLineId": "103224",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਿ ਬਿਦਿਆਧਰੀ ਹੈ ॥",
      "transliteration": "k bidhiaadharee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਵਿਦਿਆਧਰੀ (ਦੇਵਤਿਆਂ ਵਿਚੋਂ ਕਿਸੇ ਦੀ) ਧੀ, ਭੈਣ ਜਾ ਇਸਤਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि बिदिआधरी है ॥",
      "sourceLineId": "103225",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਿ ਰਾਜਹਿ ਸਿਰੀ ਛੈ ॥",
      "transliteration": "k raajeh siree chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਰਾਜੇਸ਼ਵਰੀ (ਲੱਛਮੀ) ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि राजहि सिरी छै ॥",
      "sourceLineId": "103226",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਿ ਰਾਜਹਿ ਪ੍ਰਭਾ ਛੈ ॥੩੦੭॥",
      "transliteration": "k raajeh prabhaa chhai ||307||",
      "translation": "She looked like a Gandharva woman, like the daughter of Vidyadhars or the queen combined with royal glory.307.",
      "punjabiViakhya": "ਜਾ ਪ੍ਰਭਾ ਹੀ ਬਿਰਾਜਮਾਨ ਹੈ ॥੩੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि राजहि प्रभा छै ॥३०७॥",
      "sourceLineId": "103227",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਿ ਰਾਜਾਨਜਾ ਹੈ ॥",
      "transliteration": "k raajaanajaa hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਰਾਜ-ਪੁੱਤਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि राजानजा है ॥",
      "sourceLineId": "103228",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਿ ਰੁਦ੍ਰੰ ਪ੍ਰਿਆ ਹੈ ॥",
      "transliteration": "k rudhra(n) priaa hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਸ਼ਿਵ ਦੀ ਪਿਆਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि रुद्रं पृआ है ॥",
      "sourceLineId": "103229",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਿ ਸੰਭਾਲਕਾ ਛੈ ॥",
      "transliteration": "k sa(n)bhaalakaa chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਵਿਭੂਤੀ ਵਾਲੀ ('ਸੰਭਲਕਾ') ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि संभालका छै ॥",
      "sourceLineId": "103230",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਿ ਸੁਧੰ ਪ੍ਰਭਾ ਛੈ ॥੩੦੮॥",
      "transliteration": "k sudha(n) prabhaa chhai ||308||",
      "translation": "She seemed like a princes or like Parvati, the beloved of Rudra and seemed like pure light-incarnate.308.",
      "punjabiViakhya": "ਜਾ ਨਿਰੋਲ ਪ੍ਰਭਾ ਹੈ ॥੩੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि सुधं प्रभा छै ॥३०८॥",
      "sourceLineId": "103231",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਿ ਅੰਬਾਲਿਕਾ ਛੈ ॥",
      "transliteration": "k a(n)baalikaa chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਅੰਬਾਲਿਕਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि अंबालिका छै ॥",
      "sourceLineId": "103232",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਿ ਆਕਰਖਣੀ ਛੈ ॥",
      "transliteration": "k aakarakhanee chhai ||",
      "translation": "She was a fascinating beautiful woman",
      "punjabiViakhya": "ਜਾ ਆਕਰਸ਼ਣ ਕਰਨ ਵਾਲੀ ਸ਼ਕਤੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि आकरखणी छै ॥",
      "sourceLineId": "103233",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਿ ਚੰਚਾਲਕ ਛੈ ॥",
      "transliteration": "k cha(n)chaalak chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਚੰਚਲਤਾ ਦੀ ਸ਼ਕਤੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि चंचालक छै ॥",
      "sourceLineId": "103234",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਿ ਚਿਤ੍ਰੰ ਪ੍ਰਭਾ ਹੈ ॥੩੦੯॥",
      "transliteration": "k chitra(n) prabhaa hai ||309||",
      "translation": "She appeared like a mercurial woman, portrait-like and glorious.309.",
      "punjabiViakhya": "ਜਾ ਪ੍ਰਭਾ ਦੀ ਮੂਰਤੀ ਹੈ ॥੩੦੯॥",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि चित्रं प्रभा है ॥३०९॥",
      "sourceLineId": "103235",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਿ ਕਾਲਿੰਦ੍ਰਕਾ ਛੈ ॥",
      "transliteration": "k kaali(n)dhrakaa chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਜਮਨਾ (ਕਾਲਿੰਦ੍ਰਕਾ) ਨਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि कालिंद्रका छै ॥",
      "sourceLineId": "103236",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਿ ਸਾਰਸ੍ਵਤੀ ਹੈ ॥",
      "transliteration": "k saarasavaitee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਸਰਸਵਤੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि सारस्वती है ॥",
      "sourceLineId": "103237",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਿਧੌ ਜਾਨ੍ਰਹਵੀ ਹੈ ॥",
      "transliteration": "kidhau jaanrahavee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਜਾਨ੍ਰਹਵੀ (ਗੰਗਾ) ਨਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "किधौ जान्रहवी है ॥",
      "sourceLineId": "103238",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਿਧੌ ਦੁਆਰਕਾ ਛੈ ॥੩੧੦॥",
      "transliteration": "kidhau dhuaarakaa chhai ||310||",
      "translation": "She was looking beautiful like the rivers, Ganges, Yamuna and Sarasvati or the city of Dwarka.310.",
      "punjabiViakhya": "ਜਾ ਦੁਆਰਕਾ (ਪੁਰੀ) ਹੈ ॥੩੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "किधौ दुआरका छै ॥३१०॥",
      "sourceLineId": "103239",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਿ ਕਾਲਿੰਦ੍ਰਜਾ ਛੈ ॥",
      "transliteration": "k kaali(n)dhrajaa chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਜਮਨਾ ਦੀ ਪੁੱਤਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि कालिंद्रजा छै ॥",
      "sourceLineId": "103240",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਿ ਕਾਮੰ ਪ੍ਰਭਾ ਛੈ ॥",
      "transliteration": "k kaama(n) prabhaa chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਕਾਮ ਦੀ ਸੁੰਦਰਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि कामं प्रभा छै ॥",
      "sourceLineId": "103241",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਿ ਕਾਮਏਸਵਰੀ ਹੈ ॥",
      "transliteration": "k kaamesavaree hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਕਾਮ ਦੀ ਰਾਣੀ (ਰਤੀ) ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि कामएसवरी है ॥",
      "sourceLineId": "103242",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਿ ਇੰਦ੍ਰਾਨੁਜਾ ਹੈ ॥੩੧੧॥",
      "transliteration": "k i(n)dhraanujaa hai ||311||",
      "translation": "She was looking like Yamuna, Kankala, Kameshwari and Indrani.311.",
      "punjabiViakhya": "ਜਾ ਇੰਦ੍ਰਾ (ਲੱਛਮੀ ਦੀ ਭੈਣ) ਹੈ ॥੩੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि इंद्रानुजा है ॥३११॥",
      "sourceLineId": "103243",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਿ ਭੈ ਖੰਡਣੀ ਛੈ ॥",
      "transliteration": "k bhai kha(n)ddanee chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਡਰ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि भै खंडणी छै ॥",
      "sourceLineId": "103244",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਿ ਖੰਭਾਵਤੀ ਹੈ ॥",
      "transliteration": "k kha(n)bhaavatee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਖੰਭਾਵਤੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि खंभावती है ॥",
      "sourceLineId": "103245",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਿ ਬਾਸੰਤ ਨਾਰੀ ॥",
      "transliteration": "k baasa(n)t naaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਬਸੰਤ ਰੂਪ ਇਸਤਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि बासंत नारी ॥",
      "sourceLineId": "103246",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਿ ਧਰਮਾਧਿਕਾਰੀ ॥੩੧੨॥",
      "transliteration": "k dharamaadhikaaree ||312||",
      "translation": "She was the destroyer of fear, a pillar-like damsel, a spring-lady or an authoritative woman.312.",
      "punjabiViakhya": "ਜਾ ਧਰਮ ਦੀ ਅਧਿਕਾਰੀ ਇਸਤਰੀ ਹੈ ॥੩੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि धरमाधिकारी ॥३१२॥",
      "sourceLineId": "103247",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਿ ਪਰਮਹ ਪ੍ਰਭਾ ਛੈ ॥",
      "transliteration": "k parameh prabhaa chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਬਹੁਤ ਵੱਡੀ ਪ੍ਰਭਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि परमह प्रभा छै ॥",
      "sourceLineId": "103248",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਿ ਪਾਵਿਤ੍ਰਤਾ ਛੈ ॥",
      "transliteration": "k paavitrataa chhai ||",
      "translation": "She was illustrious, pure and like enlightning effulgence",
      "punjabiViakhya": "ਜਾ ਪਵਿਤ੍ਰਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि पावित्रता छै ॥",
      "sourceLineId": "103249",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਿ ਆਲੋਕਣੀ ਹੈ ॥",
      "transliteration": "k aalokanee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਆਲੋਕਿਤ (ਪ੍ਰਕਾਸ਼ਿਤ) ਕਰਨ ਵਾਲੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि आलोकणी है ॥",
      "sourceLineId": "103250",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਿ ਆਭਾ ਪਰੀ ਹੈ ॥੩੧੩॥",
      "transliteration": "k aabhaa paree hai ||313||",
      "translation": "She was a glorious fairy.313.",
      "punjabiViakhya": "ਜਾ ਆਭਾਯੁਕਤ ਪੁਰੀ ਹੈ ॥੩੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि आभा परी है ॥३१३॥",
      "sourceLineId": "103251",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਿ ਚੰਦ੍ਰਾ ਮੁਖੀ ਛੈ ॥",
      "transliteration": "k cha(n)dhraa mukhee chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਚੰਦ੍ਰਮੁਖੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि चंद्रा मुखी छै ॥",
      "sourceLineId": "103252",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਿ ਸੂਰੰ ਪ੍ਰਭਾ ਛੈ ॥",
      "transliteration": "k soora(n) prabhaa chhai ||",
      "translation": "She was glorious like the moon and the sun",
      "punjabiViakhya": "ਜਾ ਸੂਰਜ ਦੀ ਪ੍ਰਭਾ ਵਾਲੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि सूरं प्रभा छै ॥",
      "sourceLineId": "103253",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਿ ਪਾਵਿਤ੍ਰਤਾ ਹੈ ॥",
      "transliteration": "k paavitrataa hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਪਵਿਤ੍ਰਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि पावित्रता है ॥",
      "sourceLineId": "103254",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਿ ਪਰਮੰ ਪ੍ਰਭਾ ਹੈ ॥੩੧੪॥",
      "transliteration": "k parama(n) prabhaa hai ||314||",
      "translation": "She was supremely immaculate and radiant.314,",
      "punjabiViakhya": "ਜਾ ਬਹੁਤ ਚਮਕ ਦਮਕ ਵਾਲੀ ਹੈ ॥੩੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि परमं प्रभा है ॥३१४॥",
      "sourceLineId": "103255",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਿ ਸਰਪੰ ਲਟੀ ਹੈ ॥",
      "transliteration": "k sarapa(n) laTee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਨਾਗਨ ਵਰਗੀਆਂ ਜ਼ੁਲਫ਼ਾ ਵਾਲੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि सरपं लटी है ॥",
      "sourceLineId": "103256",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਿ ਦੁਖੰ ਕਟੀ ਹੈ ॥",
      "transliteration": "k dhukha(n) kaTee hai ||",
      "translation": "She was a Naga-girl and the destroyer of all sufferings",
      "punjabiViakhya": "ਜਾ ਦੁਖਾ ਨੂੰ ਕਟਣ ਵਾਲੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि दुखं कटी है ॥",
      "sourceLineId": "103257",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਿ ਚੰਚਾਲਕਾ ਛੈ ॥",
      "transliteration": "k cha(n)chaalakaa chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਬਿਜਲੀ ਦੀ ਚਮਕ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि चंचालका छै ॥",
      "sourceLineId": "103258",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਿ ਚੰਦ੍ਰੰ ਪ੍ਰਭਾ ਛੈ ॥੩੧੫॥",
      "transliteration": "k cha(n)dhra(n) prabhaa chhai ||315||",
      "translation": "She was mercurial and glorious.315.",
      "punjabiViakhya": "ਜਾ ਚੰਦ੍ਰਮਾ ਦੀ ਪ੍ਰਭਾ ਹੈ ॥੩੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि चंद्रं प्रभा छै ॥३१५॥",
      "sourceLineId": "103259",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਿ ਬੁਧੰ ਧਰੀ ਹੈ ॥",
      "transliteration": "k budha(n) dharee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਬੁੱਧੀ ਨੂੰ ਧਾਰਨ ਕਰਨ ਵਾਲੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि बुधं धरी है ॥",
      "sourceLineId": "103260",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਿ ਕ੍ਰੁਧੰ ਹਰੀ ਹੈ ॥",
      "transliteration": "k krudha(n) haree hai ||",
      "translation": "She was Sarasvati-incarnate, destroyer of anger, having long hair",
      "punjabiViakhya": "ਜਾ ਕ੍ਰੋਧ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि क्रुधं हरी है ॥",
      "sourceLineId": "103261",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਿ ਛਤ੍ਰਾਲਕਾ ਛੈ ॥",
      "transliteration": "k chhatraalakaa chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਛਤ੍ਰਾਣੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि छत्रालका छै ॥",
      "sourceLineId": "103262",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਿ ਬਿਜੰ ਛਟਾ ਹੈ ॥੩੧੬॥",
      "transliteration": "k bija(n) chhaTaa hai ||316||",
      "translation": "She was like the flash of lighning.316.",
      "punjabiViakhya": "ਜਾ ਬਿਜਲੀ ਦੀ ਚਮਕ ਹੈ ॥੩੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि बिजं छटा है ॥३१६॥",
      "sourceLineId": "103263",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਿ ਛਤ੍ਰਾਣਵੀ ਹੈ ॥",
      "transliteration": "k chhatraanavee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਛਾਤ੍ਰ-ਬਿਰਤੀ ਵਾਲੀ (ਪ੍ਰਚੰਡ ਇਸਤਰੀ) ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि छत्राणवी है ॥",
      "sourceLineId": "103264",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕਿ ਛਤ੍ਰੰਧਰੀ ਹੈ ॥",
      "transliteration": "k chhatra(n)dharee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਛਤ੍ਰ ਨੂੰ ਧਾਰਨ ਕਰਨ ਵਾਲੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि छत्रंधरी है ॥",
      "sourceLineId": "103265",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕਿ ਛਤ੍ਰੰ ਪ੍ਰਭਾ ਹੈ ॥",
      "transliteration": "k chhatra(n) prabhaa hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਛਤ੍ਰੀਆਂ ਦੀ ਪ੍ਰਭਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि छत्रं प्रभा है ॥",
      "sourceLineId": "103266",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਕਿ ਛਤ੍ਰੰ ਛਟਾ ਹੈ ॥੩੧੭॥",
      "transliteration": "k chhatra(n) chhaTaa hai ||317||",
      "translation": "She was a Kshatriya woman, a canopied queen and a glorious and beautiful damsel like the canopy.317.",
      "punjabiViakhya": "ਜਾ ਛਤ੍ਰੀਆਂ ਦੀ ਚਮਕ ਹੈ ॥੩੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि छत्रं छटा है ॥३१७॥",
      "sourceLineId": "103267",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਕਿ ਬਾਨੰ ਦ੍ਰਿਗੀ ਹੈ ॥",
      "transliteration": "k baana(n) dhiragee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਤੀਰਾ ਵਰਗੀਆਂ ਅੱਖਾ ਵਾਲੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि बानं दृगी है ॥",
      "sourceLineId": "103268",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਨੇਤ੍ਰੰ ਮ੍ਰਿਗੀ ਹੈ ॥",
      "transliteration": "netra(n) miragee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਹਿਰਨ ਵਰਗੀਆਂ ਅੱਖਾ ਵਾਲੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "नेत्रं मृगी है ॥",
      "sourceLineId": "103269",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਕਿ ਕਉਲਾ ਪ੍ਰਭਾ ਹੈ ॥",
      "transliteration": "k kaulaa prabhaa hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਕਮਲ ਫੁਲ ਦੀ ਪ੍ਰਭੁਤਾ ਵਾਲੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि कउला प्रभा है ॥",
      "sourceLineId": "103270",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਨਿਸੇਸਾਨਨੀ ਛੈ ॥੩੧੮॥",
      "transliteration": "nisesaananee chhai ||318||",
      "translation": "Her doe-like eyes worked like arrows and she was pretty like the radiance of lotus or the moonbeams.318.",
      "punjabiViakhya": "ਜਾ ਚੰਦ੍ਰਮਾ ਵਰਗੇ ਮੁਖ ਵਾਲੀ ਹੈ ॥੩੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "निसेसाननी छै ॥३१८॥",
      "sourceLineId": "103271",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਕਿ ਗੰਧ੍ਰਬਣੀ ਹੈ ॥",
      "transliteration": "k ga(n)dhrabanee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਗੰਧਰਬ ਇਸਤਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि गंध्रबणी है ॥",
      "sourceLineId": "103272",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਕਿ ਬਿਦਿਆਧਰੀ ਛੈ ॥",
      "transliteration": "k bidhiaadharee chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਵਿਦਿਆਧਰ (ਦੇਵਤਿਆਂ ਦੀ) ਪੁੱਤਰੀ, ਭੈਣ ਜਾ ਇਸਤਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि बिदिआधरी छै ॥",
      "sourceLineId": "103273",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਕਿ ਬਾਸੰਤ ਨਾਰੀ ॥",
      "transliteration": "k baasa(n)t naaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਬਸੰਤ ਰਾਗ ਦੀ ਰਾਗਨੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि बासंत नारी ॥",
      "sourceLineId": "103274",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਕਿ ਭੂਤੇਸ ਪਿਆਰੀ ॥੩੧੯॥",
      "transliteration": "k bhootes piaaree ||319||",
      "translation": "She was a Gandharva woman or a Vidyadhar girl or the spring like lady or a beloved of all the people.319.",
      "punjabiViakhya": "ਜਾ ਸ਼ਿਵ ਦੀ ਪਿਆਰੀ ਹੈ ॥੩੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि भूतेस पिआरी ॥३१९॥",
      "sourceLineId": "103275",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਕਿ ਜਾਦ੍ਵੇਸ ਨਾਰੀ ॥",
      "transliteration": "k jaadhavaies naaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਜਾਦਵ-ਪਤੀ (ਕ੍ਰਿਸ਼ਨ) ਦੀ ਇਸਤਰੀ (ਰਾਧਾ) ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि जाद्वेस नारी ॥",
      "sourceLineId": "103276",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਕਿ ਪੰਚਾਲ ਬਾਰੀ ॥",
      "transliteration": "k pa(n)chaal baaree ||",
      "translation": "She was the beloved of Yadveshwar (Krishna) and a charming woman like Draupadi",
      "punjabiViakhya": "ਜਾ ਪੰਚਾਲ ਦੇਸ਼ ਦੀ ਬਾਲਕਾ (ਦ੍ਰੋਪਦੀ) ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि पंचाल बारी ॥",
      "sourceLineId": "103277",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਕਿ ਹਿੰਡੋਲਕਾ ਛੈ ॥",
      "transliteration": "k hi(n)ddolakaa chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਹਿੰਡੋਲ ਰਾਗ ਦੀ ਰਾਗਨੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि हिंडोलका छै ॥",
      "sourceLineId": "103278",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਕਿ ਰਾਜਹ ਸਿਰੀ ਹੈ ॥੩੨੦॥",
      "transliteration": "k raajeh siree hai ||320||",
      "translation": "She appeared like the chief queen swinging in a swing.320.",
      "punjabiViakhya": "ਜਾ ਰਾਜ ਲੱਛਮੀ ਹੈ ॥੩੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि राजह सिरी है ॥३२०॥",
      "sourceLineId": "103279",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਕਿ ਸੋਵਰਣ ਪੁਤ੍ਰੀ ॥",
      "transliteration": "k sovaran putree ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਸੋਨੇ ਦੀ ਪੁਤਲੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि सोवरण पुत्री ॥",
      "sourceLineId": "103280",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਕਿ ਆਕਾਸ ਉਤ੍ਰੀ ॥",
      "transliteration": "k aakaas utree ||",
      "translation": "She, being studded with gold, seemed to be descending from the sky",
      "punjabiViakhya": "ਜਾ ਆਕਾਸ਼ ਤੋਂ ਹੇਠਾ ਉਤਰੀ ਹੋਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि आकास उत्री ॥",
      "sourceLineId": "103281",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0660_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਕਿ ਸ੍ਵਰਣੀ ਪ੍ਰਿਤਾ ਹੈ ॥",
      "transliteration": "k savairanee pirataa hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਸੋਨੇ ਦੀ ਮੂਰਤੀ (ਪ੍ਰਿਤਮਾ) ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 660,
      "hindi": "",
      "hindiTransliteration": "कि स्वरणी पृता है ॥",
      "sourceLineId": "103282",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
