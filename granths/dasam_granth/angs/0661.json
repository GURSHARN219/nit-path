{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 661,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0661_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਿ ਸੁਵ੍ਰਣੰ ਪ੍ਰਭਾ ਹੈ ॥੩੨੧॥",
      "transliteration": "k suvrana(n) prabhaa hai ||321||",
      "translation": "She was like a portrait of gold with the golden effulgence.321.",
      "punjabiViakhya": "ਜਾ ਸੋਨੇ ਦੀ ਸੁੰਦਰਤਾ ਹੈ ॥੩੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "कि सुव्रणं प्रभा है ॥३२१॥",
      "sourceLineId": "103283",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਿ ਪਦਮੰ ਦ੍ਰਿਗੀ ਹੈ ॥",
      "transliteration": "k padhama(n) dhiragee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਕਮਲ ਨੈਨੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "कि पदमं दृगी है ॥",
      "sourceLineId": "103284",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਿ ਪਰਮੰ ਪ੍ਰਭੀ ਹੈ ॥",
      "transliteration": "k parama(n) prabhee hai ||",
      "translation": "She was lotus-eyed with supreme radiance",
      "punjabiViakhya": "ਜਾ ਬੜੀ ਪ੍ਰਭੁਤਾ ਵਾਲੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "कि परमं प्रभी है ॥",
      "sourceLineId": "103285",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਿ ਬੀਰਾਬਰਾ ਹੈ ॥",
      "transliteration": "k beeraabaraa hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਸ੍ਰੇਸ਼ਠ ਵੀਰਾਗਨਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "कि बीराबरा है ॥",
      "sourceLineId": "103286",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਿ ਸਸਿ ਕੀ ਸੁਭਾ ਹੈ ॥੩੨੨॥",
      "transliteration": "k sas kee subhaa hai ||322||",
      "translation": "She was a heroine with moon-like temperament spreading coolness.322.",
      "punjabiViakhya": "ਜਾ ਚੰਦ੍ਰਮਾ ਦੀ ਸ਼ੋਭਾ ਹੈ ॥੩੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "कि ससि की सुभा है ॥३२२॥",
      "sourceLineId": "103287",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਿ ਨਾਗੇਸਜਾ ਹੈ ॥",
      "transliteration": "k naagesajaa hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਸ਼ੇਸ਼ਨਾਗ ਦੀ ਪੁੱਤਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "कि नागेसजा है ॥",
      "sourceLineId": "103288",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਾਗਨ ਪ੍ਰਭਾ ਹੈ ॥",
      "transliteration": "naagan prabhaa hai ||",
      "translation": "She was radiant like the queen of Nagas",
      "punjabiViakhya": "ਜਾ ਨਾਗਾ ਦੀ ਪ੍ਰਭਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "नागन प्रभा है ॥",
      "sourceLineId": "103289",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਿ ਨਲਨੰ ਦ੍ਰਿਗੀ ਹੈ ॥",
      "transliteration": "k nalana(n) dhiragee hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਕਮਲ ਵਰਗੀਆਂ ਅੱਖਾ ਵਾਲੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "कि नलनं दृगी है ॥",
      "sourceLineId": "103290",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਿ ਮਲਿਨੀ ਮ੍ਰਿਗੀ ਹੈ ॥੩੨੩॥",
      "transliteration": "k malinee miragee hai ||323||",
      "translation": "Her eyes were like those of a doe or lotus.323.",
      "punjabiViakhya": "ਜਾ ਹਿਰਨੀ ਦੀਆਂ (ਅੱਖਾ ਦੇ ਮਾਣ ਨੂੰ) ਮਸਲਣ ਵਾਲੀ ਹੈ ॥੩੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "कि मलिनी मृगी है ॥३२३॥",
      "sourceLineId": "103291",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਿ ਅਮਿਤੰ ਪ੍ਰਭਾ ਹੈ ॥",
      "transliteration": "k amita(n) prabhaa hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਅਮਿਤ ਪ੍ਰਭਾ ਵਾਲੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "कि अमितं प्रभा है ॥",
      "sourceLineId": "103292",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਿ ਅਮਿਤੋਤਮਾ ਹੈ ॥",
      "transliteration": "k amitotamaa hai ||",
      "translation": "She was a unique one with infinite radiance",
      "punjabiViakhya": "ਜਾ ਅਮਿਤ ਉਤਮ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "कि अमितोतमा है ॥",
      "sourceLineId": "103293",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਿ ਅਕਲੰਕ ਰੂਪੰ ॥",
      "transliteration": "k akala(n)k roopa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਕਲੰਕ ਤੋਂ ਰਹਿਤ ਰੂਪ ਵਾਲੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "कि अकलंक रूपं ॥",
      "sourceLineId": "103294",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਿ ਸਭ ਜਗਤ ਭੂਪੰ ॥੩੨੪॥",
      "transliteration": "k sabh jagat bhoopa(n) ||324||",
      "translation": "Her unblemished beauty was the king of all the kings.324.",
      "punjabiViakhya": "ਜਾ ਜਗਤ ਦੀ ਰਾਜਾ ਹੈ ॥੩੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "कि सभ जगत भूपं ॥३२४॥",
      "sourceLineId": "103295",
      "sourceShabadId": "9360",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੋਹਣੀ ਛੰਦ ॥",
      "transliteration": "mohanee chha(n)dh ||",
      "translation": "MOHANI STANZA",
      "punjabiViakhya": "ਮੋਹਣੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "मोहणी छंद ॥",
      "sourceLineId": "103296",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜੁਬਣਮਯ ਮੰਤੀ ਸੁ ਬਾਲੀ ॥",
      "transliteration": "jubanamay ma(n)tee su baalee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਇਸਤਰੀ ਜੋਬਨ ਵਿਚ ਮਸਤੀ ਹੋਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "जुबणमय मंती सु बाली ॥",
      "sourceLineId": "103297",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮੁਖ ਨੂਰੰ ਪੂਰੰ ਉਜਾਲੀ ॥",
      "transliteration": "mukh noora(n) poora(n) ujaalee ||",
      "translation": "There was radiant glory on the face of that youthful woman",
      "punjabiViakhya": "ਮੁਖ ਉਤੇ ਨੂਰ ਦਾ ਪੂਰਾ ਉਜਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "मुख नूरं पूरं उजाली ॥",
      "sourceLineId": "103298",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮ੍ਰਿਗ ਨੈਣੀ ਬੈਣੀ ਕੋਕਿਲਾ ॥",
      "transliteration": "mirag nainee bainee kokilaa ||",
      "translation": "",
      "punjabiViakhya": "ਹਿਰਨ ਵਰਗੀਆਂ ਅੱਖਾ ਵਾਲੀ ਹੈ, ਕੋਇਲ ਦੇ ਸਮਾਨ ਬੋਲਾ ਵਾਲੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "मृग नैणी बैणी कोकिला ॥",
      "sourceLineId": "103299",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਸਿ ਆਭਾ ਸੋਭਾ ਚੰਚਲਾ ॥੩੨੫॥",
      "transliteration": "sas aabhaa sobhaa cha(n)chalaa ||325||",
      "translation": "Her eyes were like a doe and the speech like a nightingale she was mercurial, youth and moon-faced.325.",
      "punjabiViakhya": "ਚੰਦ੍ਰਮਾ ਵਰਗੀ ਆਭਾ ਅਤੇ ਬਿਜਲੀ ਜਿਹੀ ਸ਼ੋਭਾ ਵਾਲੀ ਹੈ ॥੩੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "ससि आभा सोभा चंचला ॥३२५॥",
      "sourceLineId": "103300",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਘਣਿ ਮੰਝੈ ਜੈ ਹੈ ਚੰਚਾਲੀ ॥",
      "transliteration": "ghan ma(n)jhai jai hai cha(n)chaalee ||",
      "translation": "",
      "punjabiViakhya": "ਬਦਲ ਵਿਚ ਬਿਜਲੀ ਜਿਹੋ ਜਿਹਾ ਲਿਸ਼ਕਾਰਾ ਮਾਰਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "घणि मंझै जै है चंचाली ॥",
      "sourceLineId": "103301",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮ੍ਰਿਦੁਹਾਸਾ ਨਾਸਾ ਖੰਕਾਲੀ ॥",
      "transliteration": "miradhuhaasaa naasaa kha(n)kaalee ||",
      "translation": "Her laughter was like lightning amongst the clouds and her nostril was extremely glorious",
      "punjabiViakhya": "(ਉਸੇ ਤਰ੍ਰਹਾ ਉਸ ਦਾ) ਕੋਮਲ ਹਾਸਾ ਹੈ, ਉਸ ਦਾ ਨਕ ਭੈਰਵੀ ਸ਼ਕਤੀ ਰਖਣ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "मृदुहासा नासा खंकाली ॥",
      "sourceLineId": "103302",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚਖੁ ਚਾਰੰ ਹਾਰੰ ਕੰਠਾਯੰ ॥",
      "transliteration": "chakh chaara(n) haara(n) ka(n)Thaaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਅੱਖਾ ('ਚਖ') ਹਨ, ਗਲੇ ਵਿਚ ਹਾਰ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "चखु चारं हारं कंठायं ॥",
      "sourceLineId": "103303",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮ੍ਰਿਗ ਨੈਣੀ ਬੇਣੀ ਮੰਡਾਯੰ ॥੩੨੬॥",
      "transliteration": "mirag nainee benee ma(n)ddaaya(n) ||326||",
      "translation": "She was wearing. Pretty necklaces and doe-eyed one had embellished her wrist nicely.326.",
      "punjabiViakhya": "ਹਿਰਨ ਵਰਗੀਆਂ ਅੱਖਾ ਵਾਲੀ ਹੈ ਅਤੇ ਬੇਣੀ ਸੁੰਦਰ ਢੰਗ ਨਾਲ ਗੁੰਦੀ ਹੋਈ ਹੈ ॥੩੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "मृग नैणी बेणी मंडायं ॥३२६॥",
      "sourceLineId": "103304",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗਜ ਗਾਮੰ ਬਾਮੰ ਸੁ ਗੈਣੀ ॥",
      "transliteration": "gaj gaama(n) baama(n) su gainee ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਥੀ ਦੀ ਤੋਰ ਵਾਲੀ ਅਤੇ ਆਕਾਸ਼ ਵਰਗੀ ਸੁੰਦਰ ਇਸਤਰੀ (ਪਰੀ) ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "गज गामं बामं सु गैणी ॥",
      "sourceLineId": "103305",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮ੍ਰਿਦਹਾਸੰ ਬਾਸੰ ਬਿਧ ਬੈਣੀ ॥",
      "transliteration": "miradhahaasa(n) baasa(n) bidh bainee ||",
      "translation": "That woman of elephant-gait was like a fascinating heavenly damsel and that sweetly smiling lady uttered very sweet words",
      "punjabiViakhya": "ਉਸ ਦੀ ਕੋਮਲ ਹਾਸੀ ਹੈ ਅਤੇ ਕੋਇਲ ਵਰਗੇ ਬੋਲਾ ਵਾਲੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "मृदहासं बासं बिध बैणी ॥",
      "sourceLineId": "103306",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚਖੁ ਚਾਰੰ ਹਾਰੰ ਨਿਰਮਲਾ ॥",
      "transliteration": "chakh chaara(n) haara(n) niramalaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਅੱਖਾ ਹਨ, ਨਿਰਮਲ ਹਾਰ (ਪਾਇਆ ਹੋਇਆ ਹੈ)।",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "चखु चारं हारं निरमला ॥",
      "sourceLineId": "103307",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਲਖਿ ਆਭਾ ਲਜੀ ਚੰਚਲਾ ॥੩੨੭॥",
      "transliteration": "lakh aabhaa lajee cha(n)chalaa ||327||",
      "translation": "Seeing her pure diamond necklaces, the lightning was feeling shy.327.",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਆਭਾ ਨੂੰ ਵੇਖ ਕੇ ਬਿਜਲੀ ਸ਼ਰਮਸਾਰ ਹੁੰਦੀ ਹੈ ॥੩੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "लखि आभा लजी चंचला ॥३२७॥",
      "sourceLineId": "103308",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦ੍ਰਿੜ ਧਰਮਾ ਕਰਮਾ ਸੁਕਰਮੰ ॥",
      "transliteration": "dhiraR dharamaa karamaa sukarama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਮ-ਕਰਮਾ ਅਤੇ ਸ਼ੁਭ ਕਰਮਾ ਵਿਚ ਦ੍ਰਿੜ੍ਰਹ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "दृड़ धरमा करमा सुकरमं ॥",
      "sourceLineId": "103309",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੁਖ ਹਰਤਾ ਸਰਤਾ ਜਾਣੁ ਧਰਮੰ ॥",
      "transliteration": "dhukh harataa sarataa jaan dharama(n) ||",
      "translation": "She was firm in her religion and performed good actions",
      "punjabiViakhya": "ਦੁਖਾ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲੀ ਹੈ ਅਤੇ ਧਰਮ ਦੀ ਮਾਨੋ ਨਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "दुख हरता सरता जाणु धरमं ॥",
      "sourceLineId": "103310",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮੁਖ ਨੂਰੰ ਭੂਰੰ ਸੁ ਬਾਸਾ ॥",
      "transliteration": "mukh noora(n) bhoora(n) su baasaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਖ ਉਤੇ ਪੂਰੀ ਤਰ੍ਰਹਾ ਨੂਰ ਵਸ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "मुख नूरं भूरं सु बासा ॥",
      "sourceLineId": "103311",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚਖੁ ਚਾਰੀ ਬਾਰੀ ਅੰਨਾਸਾ ॥੩੨੮॥",
      "transliteration": "chakh chaaree baaree a(n)naasaa ||328||",
      "translation": "She appeared as the remover of suffering in the way as if she was a stream of piety there was brilliance on her face and her body was completely healthy.328.",
      "punjabiViakhya": "(ਉਸ) ਬਾਲਿਕਾ ਦੀਆਂ ਅੱਖਾ ਸੁੰਦਰ ਹਨ ਅਤੇ ਆਸ ਤੋਂ ਰਹਿਤ ਹੈ ॥੩੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "चखु चारी बारी अंनासा ॥३२८॥",
      "sourceLineId": "103312",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚਖੁ ਚਾਰੰ ਬਾਰੰ ਚੰਚਾਲੀ ॥",
      "transliteration": "chakh chaara(n) baara(n) cha(n)chaalee ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਜਲੀ ਵਰਗੀਆਂ ਸੁੰਦਰ ਅੱਖਾ ਵਾਲੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "चखु चारं बारं चंचाली ॥",
      "sourceLineId": "103313",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਤ ਧਰਮਾ ਕਰਮਾ ਸੰਚਾਲੀ ॥",
      "transliteration": "sat dharamaa karamaa sa(n)chaalee ||",
      "translation": "Dutt saw that beautiful and mercurial woman, who according to her actions was observing Sati Dharma (the conduct of truth)",
      "punjabiViakhya": "ਸਤਿ ਧਰਮ ਅਤੇ ਕਰਮ ਨੂੰ ਸੰਚਾਲਿਤ ਕੀਤਾ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "सत धरमा करमा संचाली ॥",
      "sourceLineId": "103314",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦੁਖ ਹਰਣੀ ਦਰਣੀ ਦੁਖ ਦ੍ਵੰਦੰ ॥",
      "transliteration": "dhukh haranee dharanee dhukh dhavai(n)dha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦੁਖ ਨਸ਼ਟ ਕਰਨ ਵਾਲੀ ਹੈ, ਦੁਅੰਦ ਦੇ ਦੁਖ ਨੂੰ ਦਲ ਸੁਟਣ ਵਾਲੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "दुख हरणी दरणी दुख द्वंदं ॥",
      "sourceLineId": "103315",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪ੍ਰਿਯਾ ਭਕਤਾ ਬਕਤਾ ਹਰਿ ਛੰਦੰ ॥੩੨੯॥",
      "transliteration": "pirayaa bhakataa bakataa har chha(n)dha(n) ||329||",
      "translation": "She was the remover of suffering and was loved by his beloved she composed and uttered the poetic stanxas.329.",
      "punjabiViakhya": "ਪਿਆਰੀ ਭਗਤਣੀ ਹੈ ਅਤੇ ਹਰਿ (ਦੇ ਯਸ਼) ਦੇ ਛੰਦਾ ਨੂੰ ਬੋਲਣ ਅਥਵਾ ਗਾਣ ਵਾਲੀ ਹੈ ॥੩੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "पृया भकता बकता हरि छंदं ॥३२९॥",
      "sourceLineId": "103316",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰੰਭਾ ਉਰਬਸੀਆ ਘ੍ਰਿਤਾਚੀ ॥",
      "transliteration": "ra(n)bhaa urabaseeaa ghirataachee ||",
      "translation": "",
      "punjabiViakhya": "ਰੰਭਾ, ਉਰਬਸੀ, ਘ੍ਰਿਤਾਚੀ ਆਦਿ (ਵਰਗੀ ਸੁੰਦਰ) ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "रंभा उरबसीआ घृताची ॥",
      "sourceLineId": "103317",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਛੈ ਮੋਹਣੀ ਆਜੇ ਰਾਚੀ ॥",
      "transliteration": "achhai mohanee aaje raachee ||",
      "translation": "",
      "punjabiViakhya": "ਮਨ ਨੂੰ ਮੋਹਣ ਵਾਲੀ ਹੈ, ਹੁਣੇ ਹੀ ਰਚੀ ਹੋਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "अछै मोहणी आजे राची ॥",
      "sourceLineId": "103318",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਲਖਿ ਸਰਬੰ ਗਰਬੰ ਪਰਹਾਰੀ ॥",
      "transliteration": "lakh saraba(n) garaba(n) parahaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਵੇਖ ਕੇ ਸਾਰੀਆਂ ਨੇ ਹੰਕਾਰ ਨੂੰ ਖ਼ਤਮ ਕਰਨ ਵਾਲੀ ਸਮਝ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "लखि सरबं गरबं परहारी ॥",
      "sourceLineId": "103319",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮੁਖਿ ਨੀਚੇ ਧਾਮੰ ਸਿਧਾਰੀ ॥੩੩੦॥",
      "transliteration": "mukh neeche dhaama(n) sidhaaree ||330||",
      "translation": "She was fascinating like the heavenly damsels like Rambha, Urvashi, Mohinin etc. and these heavely damsels, seeing her, bowed their faces and feeling shy, they went back to their homes.330.",
      "punjabiViakhya": "ਅਤੇ ਮੁਖ ਨੀਵੇਾਂ ਕਰ ਕੇ ਘਰਾ ਨੂੰ ਚਲੀਆਂ ਗਈਆਂ ਹਨ ॥੩੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "मुखि नीचे धामं सिधारी ॥३३०॥",
      "sourceLineId": "103320",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੰਧਰਬੰ ਸਰਬੰ ਦੇਵਾਣੀ ॥",
      "transliteration": "ga(n)dharaba(n) saraba(n) dhevaanee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਗੰਧਰਬ ਇਸਤਰੀਆਂ, ਦੇਵਤਿਆਂ ਦੀਆਂ ਇਸਤਰੀਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "गंधरबं सरबं देवाणी ॥",
      "sourceLineId": "103321",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗਿਰਜਾ ਗਾਇਤ੍ਰੀ ਲੰਕਾਣੀ ॥",
      "transliteration": "girajaa gaitree la(n)kaanee ||",
      "translation": "",
      "punjabiViakhya": "ਗਿਰਜਾ, ਗਾਇਤ੍ਰੀ, ਮੰਦੋਦਰੀ ('ਲੰਕਾਣੀ')",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "गिरजा गाइत्री लंकाणी ॥",
      "sourceLineId": "103322",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਾਵਿਤ੍ਰੀ ਚੰਦ੍ਰੀ ਇੰਦ੍ਰਾਣੀ ॥",
      "transliteration": "saavitree cha(n)dhree i(n)dhraanee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਵਿਤ੍ਰੀ, ਚੰਦ੍ਰ-ਸ਼ਕਤੀ, ਸਚੀ, ਸੂਰਜ-ਸ਼ਕਤੀ ਆਦਿ",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "सावित्री चंद्री इंद्राणी ॥",
      "sourceLineId": "103323",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਲਖਿ ਲਜੀ ਸੋਭਾ ਸੂਰਜਾਣੀ ॥੩੩੧॥",
      "transliteration": "lakh lajee sobhaa soorajaanee ||331||",
      "translation": "The beautiful ladies like Ganddharva women, goddesses, Girja, Gayatri, Mandoddari, Savitri, Shachi etc. seeing her glory felt shy.331.",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਸ਼ੋਭਾ ਨੂੰ ਵੇਖ ਕੇ ਸ਼ਰਮਿੰਦੀਆਂ ਹੋ ਰਹੀਆਂ ਹਨ ॥੩੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "लखि लजी सोभा सूरजाणी ॥३३१॥",
      "sourceLineId": "103324",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਾਗਣੀਆ ਨ੍ਰਿਤਿਆ ਜਛਾਣੀ ॥",
      "transliteration": "naaganeeaa niratiaa jachhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਨਾਗ-ਕੰਨਿਆਵਾ, ਕਿੰਨਰਾ ਅਤੇ ਯਕਸ਼ਾ ਦੀਆਂ ਕੰਨਿਆਵਾ,",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "नागणीआ नृतिआ जछाणी ॥",
      "sourceLineId": "103325",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪਾਪਾ ਪਾਵਿਤ੍ਰੀ ਪਬਾਣੀ ॥",
      "transliteration": "paapaa paavitree pabaanee ||",
      "translation": "",
      "punjabiViakhya": "ਪਾਪਾ ਤੋਂ ਪਵਿਤ੍ਰ ਪਾਰਬਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "पापा पावित्री पबाणी ॥",
      "sourceLineId": "103326",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪਈਸਾਚ ਪ੍ਰੇਤੀ ਭੂਤੇਸੀ ॥",
      "transliteration": "pieesaach pretee bhootesee ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਸਾਚ, ਪ੍ਰੇਤ, ਭੂਤ ਸ਼ਕਤੀਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "पईसाच प्रेती भूतेसी ॥",
      "sourceLineId": "103327",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭਿੰਭਰੀਆ ਭਾਮਾ ਭੂਪੇਸੀ ॥੩੩੨॥",
      "transliteration": "bhi(n)bhareeaa bhaamaa bhoopesee ||332||",
      "translation": "The Naga-girls,, the Yaksha women, the ghost, fiends, and Gana Women all were devoid of radiance before her.332.",
      "punjabiViakhya": "ਭਿੰਬਰੀ, ਭਾਮਾ ਅਤੇ ਰਾਜ ਸ਼ਕਤੀਆਂ (ਉਸ ਦੇ ਸਾਹਮਣੇ ਫਿਕੀਆਂ ਹਨ) ॥੩੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "भिंभरीआ भामा भूपेसी ॥३३२॥",
      "sourceLineId": "103328",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਰ ਬਰਣੀ ਹਰਣੀ ਸਬ ਦੁਖੰ ॥",
      "transliteration": "bar baranee haranee sab dhukha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੇਸ਼ਠ ਵਰ ਦੇਣ ਵਾਲੀ, ਸਾਰਿਆਂ ਦੁਖਾ ਨੂੰ ਹਰਨ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "बर बरणी हरणी सब दुखं ॥",
      "sourceLineId": "103329",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0661_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੁਖ ਕਰਨੀ ਤਰੁਣੀ ਸਸਿ ਮੁਖੰ ॥",
      "transliteration": "sukh karanee tarunee sas mukha(n) ||",
      "translation": "That comely lady was the remover of all sufferings, giver of happiness and moon-faced",
      "punjabiViakhya": "ਸੁਖਾ ਨੂੰ ਕਰਨ ਵਾਲੀ, ਚੰਦ੍ਰਮੁਖੀ ਮੁਟਿਆਰ,",
      "source": "DASAM_GRANTH",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": "सुख करनी तरुणी ससि मुखं ॥",
      "sourceLineId": "103330",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
