{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 662,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0662_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਉਰਗੀ ਗੰਧ੍ਰਬੀ ਜਛਾਨੀ ॥",
      "transliteration": "auragee ga(n)dhrabee jachhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਸਰਪ-ਸ਼ਕਤੀ, ਗੰਧਰਬ-ਸ਼ਕਤੀ, ਯਕਸ਼-ਸ਼ਕਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "उरगी गंध्रबी जछानी ॥",
      "sourceLineId": "103331",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਲੰਕੇਸੀ ਭੇਸੀ ਇੰਦ੍ਰਾਣੀ ॥੩੩੩॥",
      "transliteration": "la(n)kesee bhesee i(n)dhraanee ||333||",
      "translation": "Even in the garb of Naga-girls, Gandharva-women, Yaksha-women and Indrani, she looked an extremely charming woman.333.",
      "punjabiViakhya": "ਮੰਦੋਦਰੀ ('ਲੰਕੇਸੀ') ਅਤੇ ਸਚੀ ਵਰਗੇ ਸਰੂਪ ਵਾਲੀ ਹੈ ॥੩੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "लंकेसी भेसी इंद्राणी ॥३३३॥",
      "sourceLineId": "103332",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦ੍ਰਿਗ ਬਾਨੰ ਤਾਨੰ ਮਦਮਤੀ ॥",
      "transliteration": "dhirag baana(n) taana(n) madhamatee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਮਦ-ਮਾਤੀ ਦੀਆਂ ਅੱਖਾ ਤੀਰਾ ਵਾਗ ਖਿਚੀਆਂ ਹੋਈਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "दृग बानं तानं मदमती ॥",
      "sourceLineId": "103333",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੁਬਨ ਜਗਮਗਣੀ ਸੁਭਵੰਤੀ ॥",
      "transliteration": "juban jagamaganee subhava(n)tee ||",
      "translation": "The eyes of that intoxicated youthful woman were tightened like the arrows and she was glistening with the radiance of youth",
      "punjabiViakhya": "ਜਗਮਗਾਉਾਂਦੇ ਜੋਬਨ ਵਾਲੀ ਹੈ, ਸ਼ੋਭਾਵੰਤੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "जुबन जगमगणी सुभवंती ॥",
      "sourceLineId": "103334",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਉਰਿ ਧਾਰੰ ਹਾਰੰ ਬਨਿ ਮਾਲੰ ॥",
      "transliteration": "aur dhaara(n) haara(n) ban maala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਗਲੇ ਵਿਚ ਬਨ-ਮਾਲਾ ਪਾਈ ਹੋਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "उरि धारं हारं बनि मालं ॥",
      "sourceLineId": "103335",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮੁਖਿ ਸੋਭਾ ਸਿਖਿਰੰ ਜਨ ਜ੍ਵਾਲੰ ॥੩੩੪॥",
      "transliteration": "mukh sobhaa sikhira(n) jan javaiaala(n) ||334||",
      "translation": "She had worn a rosary around her neck and the glory of her face seemed like the gleaming fire.334.",
      "punjabiViakhya": "ਮੁਖ ਦੀ ਸ਼ੋਭਾ ਮਾਨੋ ਅਗਨੀ ਦੀ ਲਾਟ ਹੋਵੇ ॥੩੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "मुखि सोभा सिखिरं जन ज्वालं ॥३३४॥",
      "sourceLineId": "103336",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਛਤਪਤ੍ਰੀ ਛਤ੍ਰੀ ਛਤ੍ਰਾਲੀ ॥",
      "transliteration": "chhatapatree chhatree chhatraalee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਸਿੰਘਾਸਨ ਵਾਲੀ ('ਛਤ੍ਰਪਤੀ') ਛਤ੍ਰਾਣੀ, ਛਤ੍ਰ ਵਾਲੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "छतपत्री छत्री छत्राली ॥",
      "sourceLineId": "103337",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਿਧੁ ਬੈਣੀ ਨੈਣੀ ਨ੍ਰਿਮਾਲੀ ॥",
      "transliteration": "bidh bainee nainee niramaalee ||",
      "translation": "That queen of the earth was a canopied goddess and her eyes and words were pure",
      "punjabiViakhya": "ਕੋਇਲ ('ਬਿਧੁ') ਵਰਗੇ ਬੋਲਾ ਵਾਲੀ ਅਤੇ ਨਿਰਮਲ ਨੈਣਾ ਵਾਲੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "बिधु बैणी नैणी नृमाली ॥",
      "sourceLineId": "103338",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਸਿ ਉਪਾਸੀ ਦਾਸੀ ਨਿਰਲੇਪੰ ॥",
      "transliteration": "as upaasee dhaasee niralepa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰ (ਅਥਵਾ ਅਜਿਹੀ) ਉਪਾਸਨਾ ਕਰਨ ਵਾਲੀ ਨਿਰਲੇਪ ਦਾਸੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "असि उपासी दासी निरलेपं ॥",
      "sourceLineId": "103339",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬੁਧਿ ਖਾਨੰ ਮਾਨੰ ਸੰਛੇਪੰ ॥੩੩੫॥",
      "transliteration": "budh khaana(n) maana(n) sa(n)chhepa(n) ||335||",
      "translation": "She was capable of alluring the demons, but she was the mine of learning and honour and lived unattached.335.",
      "punjabiViakhya": "ਬੁੱਧੀ ਦੀ ਖਾਣ ਅਤੇ ਮਾਣ ਨੂੰ ਸਮੇਟਣ ਵਾਲੀ ਹੈ ॥੩੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "बुधि खानं मानं संछेपं ॥३३५॥",
      "sourceLineId": "103340",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੁਭ ਸੀਲੰ ਡੀਲੰ ਸੁਖ ਥਾਨੰ ॥",
      "transliteration": "subh seela(n) ddeela(n) sukh thaana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੁਭ ਸੁਭਾ ਅਤੇ ਡੀਲ ਡੌਲ ਵਾਲੀ ਹੈ, ਸੁਖ ਦਾ ਸਥਾਨ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "सुभ सीलं डीलं सुख थानं ॥",
      "sourceLineId": "103341",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮੁਖ ਹਾਸੰ ਰਾਸੰ ਨਿਰਬਾਨੰ ॥",
      "transliteration": "mukh haasa(n) raasa(n) nirabaana(n) ||",
      "translation": "She was good, gentle and a lady of fine features she was giver of comfort she smiled mildly",
      "punjabiViakhya": "ਮੁਖ ਪ੍ਰਸੰਨਤਾ ਦੀ ਰਾਸ ਵਾਗ ਅਤੇ ਨਿਰਬਾਨ ਸਰੂਪ ਵਾਲੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "मुख हासं रासं निरबानं ॥",
      "sourceLineId": "103342",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪ੍ਰਿਯਾ ਭਕਤਾ ਬਕਤਾ ਹਰਿ ਨਾਮੰ ॥",
      "transliteration": "pirayaa bhakataa bakataa har naama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਆਰੀ ਭਗਤਨੀ ਅਤੇ ਹਰਿ ਨਾਮ ਨੂੰ ਉਚਾਰਨ ਵਾਲੀ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "पृया भकता बकता हरि नामं ॥",
      "sourceLineId": "103343",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚਿਤ ਲੈਣੀ ਦੈਣੀ ਆਰਾਮੰ ॥੩੩੬॥",
      "transliteration": "chit lainee dhainee aaraama(n) ||336||",
      "translation": "She was the devotee of her beloved she remembered the Name of the Lord she was alluring and pleasing.336.",
      "punjabiViakhya": "ਚਿਤ (ਦੀ ਚਿੰਤਾ) ਨੂੰ ਹਰਨ ਵਾਲੀ ਅਤੇ ਆਰਾਮ ਦੇਣ ਵਾਲੀ ਹੈ ॥੩੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "चित लैणी दैणी आरामं ॥३३६॥",
      "sourceLineId": "103344",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪ੍ਰਿਯ ਭਕਤਾ ਠਾਢੀ ਏਕੰਗੀ ॥",
      "transliteration": "piray bhakataa Thaaddee eka(n)gee ||",
      "translation": "",
      "punjabiViakhya": "ਕੇਵਲ ਇਕ ਪਤੀ ('ਪ੍ਰਿਯ') ਦੀ ਭਗਤੀ ਕਰਨ ਲਈ ਸਥਿਤ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "पृय भकता ठाढी एकंगी ॥",
      "sourceLineId": "103345",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰੰਗ ਏਕੈ ਰੰਗੈ ਸੋ ਰੰਗੀ ॥",
      "transliteration": "ra(n)g ekai ra(n)gai so ra(n)gee ||",
      "translation": "She was the devotee of her beloved and standing alone she was dyed in only one dye",
      "punjabiViakhya": "ਇਕੋ ਹੀ ਰੰਗ ਵਿਚ ਰੰਗੀ ਹੋਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "रंग एकै रंगै सो रंगी ॥",
      "sourceLineId": "103346",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਿਰ ਬਾਸਾ ਆਸਾ ਏਕਾਤੰ ॥",
      "transliteration": "nir baasaa aasaa ekaata(n) ||",
      "translation": "",
      "punjabiViakhya": "ਆਸ ਤੋਂ ਮੁਕਤ ਇਕਾਤ ਰਹਿਣ ਵਾਲੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "निर बासा आसा एकातं ॥",
      "sourceLineId": "103347",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪਤਿ ਦਾਸੀ ਭਾਸੀ ਪਰਭਾਤੰ ॥੩੩੭॥",
      "transliteration": "pat dhaasee bhaasee parabhaata(n) ||337||",
      "translation": "She had no desire whatsoever and she was absorbed in the memory of her husband.337.",
      "punjabiViakhya": "ਪਤੀ ਦੀ ਦਾਸੀ ਅਤੇ ਪ੍ਰਭਾਤ ਵਰਗੀ ਭਾਸਦੀ ਹੈ ॥੩੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "पति दासी भासी परभातं ॥३३७॥",
      "sourceLineId": "103348",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਨਿ ਨਿੰਦ੍ਰ ਅਨਿੰਦਾ ਨਿਰਹਾਰੀ ॥",
      "transliteration": "an ni(n)dhr ani(n)dhaa nirahaaree ||",
      "translation": "",
      "punjabiViakhya": "ਨਿੰਦਰਾ ਤੋਂ ਰਹਿਤ, ਨਿੰਦਿਆ ਤੋਂ ਰਹਿਤ ਅਤੇ ਆਹਾਰ ਤੋਂ ਰਹਿਤ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "अनि निंद्र अनिंदा निरहारी ॥",
      "sourceLineId": "103349",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪ੍ਰਿਯ ਭਕਤਾ ਬਕਤਾ ਬ੍ਰਤਚਾਰੀ ॥",
      "transliteration": "piray bhakataa bakataa bratachaaree ||",
      "translation": "She neither slept nor ate food she was devotee of her beloved and a vow-observing lady",
      "punjabiViakhya": "ਪਤੀ ਦੀ ਭਗਤੀ ਕਰਨ ਵਾਲੀ ਅਤੇ ਬ੍ਰਤ-ਆਚਾਰ ਦਾ ਕਥਨ ਕਰਨ ਵਾਲੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "पृय भकता बकता ब्रतचारी ॥",
      "sourceLineId": "103350",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਾਸੰਤੀ ਟੋਡੀ ਗਉਡੀ ਹੈ ॥",
      "transliteration": "baasa(n)tee Toddee gauddee hai ||",
      "translation": "",
      "punjabiViakhya": "ਬਸੰਤ, ਟੋਡੀ, ਗੌੜੀ,",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "बासंती टोडी गउडी है ॥",
      "sourceLineId": "103351",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਭੁਪਾਲੀ ਸਾਰੰਗ ਗਉਰੀ ਛੈ ॥੩੩੮॥",
      "transliteration": "bhupaalee saara(n)g gauree chhai ||338||",
      "translation": "She was beautiful like Vasanti, Todi, Gauri, Bhupali, Sarang etc.338.",
      "punjabiViakhya": "ਭੂਪਾਲੀ, ਸਾਰੰਗੀ, ਗੌਰੀ (ਆਦਿ) ਹੈ ॥੩੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "भुपाली सारंग गउरी छै ॥३३८॥",
      "sourceLineId": "103352",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਿੰਡੋਲੀ ਮੇਘ ਮਲਾਰੀ ਹੈ ॥",
      "transliteration": "hi(n)ddolee megh malaaree hai ||",
      "translation": "",
      "punjabiViakhya": "ਹਿੰਡੋਲੀ, ਮੇਘ-ਮਲ੍ਰਹਾਰੀ,",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "हिंडोली मेघ मलारी है ॥",
      "sourceLineId": "103353",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜੈਜਾਵੰਤੀ ਗੌਡ ਮਲਾਰੀ ਛੈ ॥",
      "transliteration": "jaijaava(n)tee gauadd malaaree chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜੈਜਾਵੰਤੀ, ਗੌਡ-ਮਲ੍ਰਹਾਰੀ (ਰਾਗਨੀ) ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "जैजावंती गौड मलारी छै ॥",
      "sourceLineId": "103354",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬੰਗਲੀਆ ਰਾਗੁ ਬਸੰਤੀ ਛੈ ॥",
      "transliteration": "ba(n)galeeaa raag basa(n)tee chhai ||",
      "translation": "",
      "punjabiViakhya": "ਬੰਗਲੀਆ ਜਾ ਬਸੰਤ ਰਾਗਨੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "बंगलीआ रागु बसंती छै ॥",
      "sourceLineId": "103355",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬੈਰਾਰੀ ਸੋਭਾਵੰਤੀ ਹੈ ॥੩੩੯॥",
      "transliteration": "bairaaree sobhaava(n)tee hai ||339||",
      "translation": "She was glorious like Hindol, Megh, Malhar, Jaijavanti, Gaur, Basant, Bairagi etc.339.",
      "punjabiViakhya": "(ਜਾ) ਸ਼ੋਭਾਵਾਨ ਬੈਰਾੜੀ ਹੈ ॥੩੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "बैरारी सोभावंती है ॥३३९॥",
      "sourceLineId": "103356",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੋਰਠਿ ਸਾਰੰਗ ਬੈਰਾਰੀ ਛੈ ॥",
      "transliteration": "soraTh saara(n)g bairaaree chhai ||",
      "translation": "",
      "punjabiViakhya": "ਸੋਰਠ ਜਾ ਸਾਰੰਗ (ਰਾਗਨੀ) ਜਾ ਬੈਰਾੜੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "सोरठि सारंग बैरारी छै ॥",
      "sourceLineId": "103357",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪਰਜ ਕਿ ਸੁਧ ਮਲਾਰੀ ਛੈ ॥",
      "transliteration": "paraj k sudh malaaree chhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਪਰਜ ਅਥਵਾ ਸ਼ੁੱਧ ਮਲ੍ਰਹਾਰੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "परज कि सुध मलारी छै ॥",
      "sourceLineId": "103358",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਿੰਡੋਲੀ ਕਾਫੀ ਤੈਲੰਗੀ ॥",
      "transliteration": "hi(n)ddolee kaafee taila(n)gee ||",
      "translation": "",
      "punjabiViakhya": "ਹਿੰਡੋਲੀ, ਕਾਫੀ ਜਾ ਤੈਲੰਗੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "हिंडोली काफी तैलंगी ॥",
      "sourceLineId": "103359",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭੈਰਵੀ ਦੀਪਕੀ ਸੁਭੰਗੀ ॥੩੪੦॥",
      "transliteration": "bhairavee dheepakee subha(n)gee ||340||",
      "translation": "She was emotional like Sorath, Sarang, Bairai, Malhar, Hindol, Tailangi, Bhairavi and Deepak.340.",
      "punjabiViakhya": "ਭੈਰਵੀ, ਦੀਪਕੀ ਜਾ ਸ਼ੁਭ ਅੰਗਾ ਵਾਲੀ ਹੈ ॥੩੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "भैरवी दीपकी सुभंगी ॥३४०॥",
      "sourceLineId": "103360",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਰਬੇਵੰ ਰਾਗੰ ਨਿਰਬਾਣੀ ॥",
      "transliteration": "sarabeva(n) raaga(n) nirabaanee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਰਾਗਾ ਦੇ ਰੂਪ ਵਾਲੀ, ਅਤੇ ਬੰਧਨਾ ਤੋਂ ਰਹਿਤ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "सरबेवं रागं निरबाणी ॥",
      "sourceLineId": "103361",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਲਖਿ ਲੋਭੀ ਆਭਾ ਗਰਬਾਣੀ ॥",
      "transliteration": "lakh lobhee aabhaa garabaanee ||",
      "translation": "She was expert in all musical modes and the beauty itself was getting allured on seeing her",
      "punjabiViakhya": "ਹੰਕਾਰੀ ਸੁੰਦਰਤਾ ਵੀ (ਉਸ ਨੂੰ) ਵੇਖ ਕੇ ਲੋਭਾਇਮਾਨ ਹੋ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "लखि लोभी आभा गरबाणी ॥",
      "sourceLineId": "103362",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਉ ਕਥਉ ਸੋਭਾ ਸਰਬਾਣੰ ॥",
      "transliteration": "jau kathau sobhaa sarabaana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਜੇ) ਉਸ ਦੀ ਸਾਰੀ ਸ਼ੋਭਾ ਦਾ ਵਰਣਨ ਕਰਾ,",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "जउ कथउ सोभा सरबाणं ॥",
      "sourceLineId": "103363",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਉ ਬਾਢੇ ਏਕੰ ਗ੍ਰੰਥਾਣੰ ॥੩੪੧॥",
      "transliteration": "tau baadde eka(n) gra(n)thaana(n) ||341||",
      "translation": "If I describe her glory of all types, then there will be an extension of another volume.341.",
      "punjabiViakhya": "ਤਾ ਇਕ ਗ੍ਰੰਥ ਵਧ ਜਾਦਾ ਹੈ ॥੩੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "तउ बाढे एकं ग्रंथाणं ॥३४१॥",
      "sourceLineId": "103364",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਲਖਿ ਤਾਮ ਦਤੰ ਬ੍ਰਤਚਾਰੀ ॥",
      "transliteration": "lakh taam dhata(n) bratachaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਬ੍ਰਤ ਅਤੇ ਆਚਾਰ ਨੂੰ ਵੇਖ ਕੇ ਦੱਤ",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "लखि ताम दतं ब्रतचारी ॥",
      "sourceLineId": "103365",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਬ ਲਗੇ ਪਾਨੰ ਜਟਧਾਰੀ ॥",
      "transliteration": "sab lage paana(n) jaTadhaaree ||",
      "translation": "That great vow-observing Dutt saw vow-observing lady and touched her feet alongwith other hermits with matted locks",
      "punjabiViakhya": "ਅਤੇ ਹੋਰ ਸਾਰੇ ਜਟਾ-ਧਾਰੀ (ਉਸ ਦੇ) ਚਰਨੀਂ ਲਗ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "सब लगे पानं जटधारी ॥",
      "sourceLineId": "103366",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਨ ਮਨ ਭਰਤਾ ਕਰ ਰਸ ਭੀਨਾ ॥",
      "transliteration": "tan man bharataa kar ras bheenaa ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ) ਉਸ ਦਾ ਤਨ ਮਨ ਪਤੀ ਦੇ (ਪ੍ਰੇਮ) ਰਸ ਵਿਚ ਭਿਜਿਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "तन मन भरता कर रस भीना ॥",
      "sourceLineId": "103367",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਚਵ ਦਸਵੋ ਤਾ ਕੌ ਗੁਰੁ ਕੀਨਾ ॥੩੪੨॥",
      "transliteration": "chav dhasavo taa kau gur keenaa ||342||",
      "translation": "He accepted that lady, being absorbed in the love of her husband with her body and mind, as his fourteenth Guru.342.",
      "punjabiViakhya": "ਉਸ ਨੂੰ (ਦੱਤ ਨੇ) ਚੌਦਵਾ ਗੁਰੂ ਕੀਤਾ ॥੩੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "चव दसवो ता कौ गुरु कीना ॥३४२॥",
      "sourceLineId": "103368",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਤਿ ਪ੍ਰਿਯ ਭਗਤ ਇਸਤ੍ਰੀ ਚਤੁਰਦਸਵਾ ਗੁਰੂ ਸਮਾਪਤੰ ॥੧੪॥",
      "transliteration": "eit piray bhagat isatree chaturadhasavaa guroo samaapata(n) ||14||",
      "translation": "End of the description of the adoption of the fully-devoted lady as his fourteenth Guru.",
      "punjabiViakhya": "ਇਥੇ 'ਪਤੀ ਦੀ ਭਗਤ' ਇਸਤਰੀ ਚੌਦਵੇਾਂ ਗੁਰੂ ਦਾ ਪ੍ਰਸੰਗ ਸਮਾਪਤ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "इति पृय भगत इसत्री चतुरदसवा गुरू समापतं ॥१४॥",
      "sourceLineId": "103369",
      "sourceShabadId": "9361",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਥ ਬਾਨਗਰ ਪੰਧਰਵੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "transliteration": "ath baanagar pa(n)dharavo guroo kathana(n) ||",
      "translation": "Now beings the description of the adoption of the Arrow-maker as his Fifteenth Guru",
      "punjabiViakhya": "ਹੁਣ ਬਾਨ-ਗਰ ਪੰਦ੍ਰਹਵੇਾਂ ਗੁਰੂ ਦੇ ਪ੍ਰਸੰਗ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "अथ बानगर पंधरवो गुरू कथनं ॥",
      "sourceLineId": "103370",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤੋਟਕ ਛੰਦ ॥",
      "transliteration": "toTak chha(n)dh ||",
      "translation": "TOTAK STANZA",
      "punjabiViakhya": "ਤੋਟਕ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "तोटक छंद ॥",
      "sourceLineId": "103371",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਰਿ ਚਉਦਸਵੋਂ ਗੁਰੁ ਦਤ ਮੁਨੰ ॥",
      "transliteration": "kar chaudhasavo(n) gur dhat muna(n) ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਦਵਾ ਗੁਰੂ ਕਰ ਕੇ ਮੁਨੀ ਦੱਤ,",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "करि चउदसवों गुरु दत मुनं ॥",
      "sourceLineId": "103372",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮਗ ਲਗੀਆ ਪੂਰਤ ਨਾਦ ਧੁਨੰ ॥",
      "transliteration": "mag lageeaa poorat naadh dhuna(n) ||",
      "translation": "Adopting the fourteenth Guru, the sage Dutt, blowing his conch, moved further",
      "punjabiViakhya": "(ਸੰਖ) ਨਾਦ ਕਰਦਾ ਹੋਇਆ ਰਾਹੇ ਪੈ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "मग लगीआ पूरत नाद धुनं ॥",
      "sourceLineId": "103373",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਭ੍ਰਮ ਪੂਰਬ ਪਛਮ ਉਤ੍ਰ ਦਿਸੰ ॥",
      "transliteration": "bhram poorab pachham utr dhisa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਪੂਰਬ, ਪੱਛਮ ਅਤੇ ਉੱਤਰ ਦਿਸ਼ਾਵਾ ਨੂੰ ਘੁੰਮ ਫਿਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "भ्रम पूरब पछम उत्र दिसं ॥",
      "sourceLineId": "103374",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਕਿ ਚਲੀਆ ਦਛਨ ਮੋਨ ਇਸੰ ॥੩੪੩॥",
      "transliteration": "tak chaleeaa dhachhan mon isa(n) ||343||",
      "translation": "After wandering through the East, West and North and observing silence, he moved towards the Southern direction.343.",
      "punjabiViakhya": "ਮਹਾ ਮੁਨੀ ਦੱਖਣ ਦਿਸ਼ਾ ਨੂੰ ਵੇਖਣ ਲਈ ਚਲ ਪਿਆ ਹੈ ॥੩੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "तकि चलीआ दछन मोन इसं ॥३४३॥",
      "sourceLineId": "103375",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਵਿਲੋਕਿ ਤਹਾ ਇਕ ਚਿਤ੍ਰ ਪੁਰੰ ॥",
      "transliteration": "avilok tahaa ik chitr pura(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ (ਉਸ ਨੇ) ਚਿਤ੍ਰ ਨਾ ਦਾ ਇਕ ਨਗਰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "अविलोकि तहा इक चित्र पुरं ॥",
      "sourceLineId": "103376",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0662_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਨੁ ਕ੍ਰਾਤਿ ਦਿਵਾਲਯ ਸਰਬ ਹਰੰ ॥",
      "transliteration": "jan kraat dhivaalay sarab hara(n) ||",
      "translation": "There he saw a city of portraits, where there were temples everywhere",
      "punjabiViakhya": "ਮਾਨੋ ਉਹ ਸਵਰਗ ('ਦਿਵਾਲਯ') ਦੀ ਚਮਕ ਦਮਕ ਨੂੰ ਹਰ ਰਿਹਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": "जनु क्राति दिवालय सरब हरं ॥",
      "sourceLineId": "103377",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
