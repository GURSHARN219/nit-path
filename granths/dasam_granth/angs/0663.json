{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 663,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0663_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਬ ਸਿੰਘ ਮ੍ਰਿਗੀਪਤਿ ਘਾਇ ਖਗੰ ॥੩੪੪॥",
      "transliteration": "sab si(n)gh mirageepat ghai khaga(n) ||344||",
      "translation": "The king of that place had killed many deer and lions with his dagger.344.",
      "punjabiViakhya": "ਸ਼ੇਰ, ਕਾਲੇ ਹਿਰਨ ('ਮ੍ਰਿਗੀਪਤਿ') ਅਤੇ ਸਭ ਤਰ੍ਰਹਾ ਦੇ ਪੰਛੀਆਂ ਦਾ ਸ਼ਿਕਾਰ ਕੀਤਾ ਹੋਇਆ ਹੈ ॥੩੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "सब सिंघ मृगीपति घाइ खगं ॥३४४॥",
      "sourceLineId": "103379",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚਤੁਰੰ ਲਏ ਨ੍ਰਿਪ ਸੰਗਿ ਘਨੀ ॥",
      "transliteration": "chatura(n) le nirap sa(n)g ghanee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਆਪਣੇ ਨਾਲ ਬਹੁਤ ਸਾਰੀ ਚਤੁਰੰਗਨੀ ਸੈਨਾ ਲਈ ਹੋਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "चतुरं लए नृप संगि घनी ॥",
      "sourceLineId": "103380",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਥਹਰੰਤ ਧੁਜਾ ਚਮਕੰਤ ਅਨੀ ॥",
      "transliteration": "thahara(n)t dhujaa chamaka(n)t anee ||",
      "translation": "The king took the four division of his army with him",
      "punjabiViakhya": "ਝੰਡੇ ਝੁਲ ਰਹੇ ਹਨ ਅਤੇ ਤਿਖੀਆਂ ਤਲਵਾਰਾ ਚਮਕ ਰਹੀਆਂ ਹਨ (ਜਾ ਝੰਡਿਆਂ ਉਤੇ ਲਗੀਆਂ ਨੋਕਾ ਚਮਕ ਰਹੀਆਂ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "थहरंत धुजा चमकंत अनी ॥",
      "sourceLineId": "103381",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਹੁ ਭੂਖਨ ਚੀਰ ਜਰਾਵ ਜਰੀ ॥",
      "transliteration": "bahu bhookhan cheer jaraav jaree ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਤਰ੍ਰਹਾ ਦੇ ਜ਼ੇਵਰ, ਜ਼ਰੀ ਦੇ ਜੜ੍ਰਹੇ ਹੋਏ ਬਸਤ੍ਰ (ਦਮਕ ਰਹੇ ਹਨ)",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "बहु भूखन चीर जराव जरी ॥",
      "sourceLineId": "103382",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤ੍ਰਿਦਸਾਲਯ ਕੀ ਜਨੁ ਕ੍ਰਾਤਿ ਹਰੀ ॥੩੪੫॥",
      "transliteration": "tiradhasaalay kee jan kraat haree ||345||",
      "translation": "The banners of the army were fluttering and the studded garments were worn by all the warriors the beauty of all of them was making the beauty of all other places shyful.345.",
      "punjabiViakhya": "ਮਾਨੋ ਦੇਵਤਿਆਂ ('ਤ੍ਰਿਦਸ') ਦੇ ਘਰ (ਸਵਰਗ) ਦੀ ਕਾਤੀ ਹਰ ਲਈ ਹੋਵੇ ॥੩੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "तृदसालय की जनु क्राति हरी ॥३४५॥",
      "sourceLineId": "103383",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਹ ਬੈਠ ਹੁਤੋ ਇਕ ਬਾਣਗਰੰ ॥",
      "transliteration": "teh baiTh huto ik baanagara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਤੀਰ ਬਣਾਉਣ ਵਾਲਾ ('ਬਾਣਗਰ') ਬੈਠਾ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "तह बैठ हुतो इक बाणगरं ॥",
      "sourceLineId": "103384",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਿਨੁ ਪ੍ਰਾਣ ਕਿਧੌ ਨਹੀ ਬੈਨੁਚਰੰ ॥",
      "transliteration": "bin praan kidhau nahee bainuchara(n) ||",
      "translation": "An arrow-maker was sitting there, and appeared to be lifeless",
      "punjabiViakhya": "(ਉਹ) ਪ੍ਰਾਣਾ ਤੋਂ ਬਿਨਾ ਲਗਦਾ ਸੀ, ਜਾ ਬੋਲਦਾ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "बिनु प्राण किधौ नही बैनुचरं ॥",
      "sourceLineId": "103385",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਹ ਬਾਜਤ ਬਾਜ ਮ੍ਰਿਦੰਗ ਗਣੰ ॥",
      "transliteration": "teh baajat baaj miradha(n)g gana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਬਹੁਤ ਸਾਰੇ ਵਾਜਿਆਂ ਦੇ ਵਜਣ ਨਾਲ ਧੁੰਨ ਹੋ ਰਹੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "तह बाजत बाज मृदंग गणं ॥",
      "sourceLineId": "103386",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਡਫ ਢੋਲਕ ਝਾਝ ਮੁਚੰਗ ਭਣੰ ॥੩੪੬॥",
      "transliteration": "ddaf ddolak jhaajh mucha(n)g bhana(n) ||346||",
      "translation": "The small and big drums and the tabors etc. resounded.346.",
      "punjabiViakhya": "ਡਫ, ਢੋਲ, ਝਾਝ, ਮੁਚੰਗ, ਮ੍ਰਿਦੰਗ ਆਦਿ ॥੩੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "डफ ढोलक झाझ मुचंग भणं ॥३४६॥",
      "sourceLineId": "103387",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦਲ ਨਾਥ ਲਏ ਬਹੁ ਸੰਗਿ ਦਲੰ ॥",
      "transliteration": "dhal naath le bahu sa(n)g dhala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੈਨਾ ਵਾਲਾ ਰਾਜਾ ਬਹੁਤ ਸਾਰੀ ਫੌਜ ਲੈ ਕੇ (ਉਥੋਂ ਲੰਘ ਰਿਹਾ ਸੀ)",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "दल नाथ लए बहु संगि दलं ॥",
      "sourceLineId": "103388",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਲ ਬਾਰਿਧ ਜਾਨੁ ਪ੍ਰਲੈ ਉਛਲੰ ॥",
      "transliteration": "jal baaridh jaan pralai uchhala(n) ||",
      "translation": "The king was with his army and that army was rushing forth like the clouds of doomsday",
      "punjabiViakhya": "ਮਾਨੋ ਪਰਲੋ ਦਾ ਸਮੁੰਦਰ ਹੀ ਉਛਲਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "जल बारिध जानु प्रलै उछलं ॥",
      "sourceLineId": "103389",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਯ ਹਿੰਸਤ ਚਿੰਸਤ ਗੂੜ ਗਜੰ ॥",
      "transliteration": "hay hi(n)sat chi(n)sat gooR gaja(n) ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜੇ ਹਿਣਕਦੇ ਸਨ ਅਤੇ ਹਾਥੀ ਚਿੰਘਾੜਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "हय हिंसत चिंसत गूड़ गजं ॥",
      "sourceLineId": "103390",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗਲ ਗਜਤ ਲਜਤ ਸੁੰਡ ਲਜੰ ॥੩੪੭॥",
      "transliteration": "gal gajat lajat su(n)dd laja(n) ||347||",
      "translation": "The horses were neighing and the elephants were trumpeting hearing the roaring of the elephants, the clouds were feeling shy.347.",
      "punjabiViakhya": "ਗਲਾ ਵਿਚ ਪਏ ਹੋਏ (ਟਲ) ਗਜਦੇ ਸਨ ਜਿਸ (ਦੀ ਗਰਜ ਨਾਲ) ਸੁੰਡ ਵਾਲੇ (ਹਾਥੀ ਖੁਦ) ਵੀ ਸ਼ਰਮਾਦੇ ਸਨ ॥੩੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "गल गजत लजत सुँड लजं ॥३४७॥",
      "sourceLineId": "103391",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦ੍ਰੁਮ ਢਾਹਤ ਗਾਹਤ ਗੂੜ ਦਲੰ ॥",
      "transliteration": "dhrum ddaahat gaahat gooR dhala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਡੇ ਹਾਥੀ ਦਲ ਦਰਖ਼ਤਾ ਨੂੰ ਢਾਈ ਅਤੇ ਗਾਹੀ ਜਾ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "द्रुम ढाहत गाहत गूड़ दलं ॥",
      "sourceLineId": "103392",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਰ ਖੀਚਤ ਸੀਚਤ ਧਾਰ ਜਲੰ ॥",
      "transliteration": "kar kheechat seechat dhaar jala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਲ-ਧਾਰਾਵਾ ਤੋਂ ਪਾਣੀ ਖਿਚਦੇ ਅਤੇ ਰਾਹ ਉਤੇ ਛਿੜਕੀ ਜਾ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "कर खीचत सीचत धार जलं ॥",
      "sourceLineId": "103393",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੁਖ ਪਾਵਤ ਧਾਵਤ ਪੇਖਿ ਪ੍ਰਭੈ ॥",
      "transliteration": "sukh paavat dhaavat pekh prabhai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦੀ ਚਮਕ ਦਮਕ ਨੂੰ ਵੇਖਣ ਲਈ (ਲੋਕੀਂ) ਭਜੀ ਆ ਰਹੇ ਸਨ ਅਤੇ ਸੁਖ ਪ੍ਰਾਪਤ ਕਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "सुख पावत धावत पेखि प्रभै ॥",
      "sourceLineId": "103394",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਵਲੋਕਿ ਬਿਮੋਹਤ ਰਾਜ ਸੁਭੈ ॥੩੪੮॥",
      "transliteration": "avalok bimohat raaj subhai ||348||",
      "translation": "That army was moving peacefully, while felling the trees and drinking the water from the water-currents, seeing which all were getting allured.348.",
      "punjabiViakhya": "ਰਾਜੇ ਦੀ ਸ਼ੋਭਾ ਨੂੰ ਵੇਖ ਕੇ (ਪ੍ਰਜਾ) ਮੋਹਿਤ ਹੋ ਰਹੀ ਸੀ ॥੩੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "अवलोकि बिमोहत राज सुभै ॥३४८॥",
      "sourceLineId": "103395",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚਪਿ ਡਾਰਤ ਚਾਚਰ ਭਾਨੁ ਸੂਅੰ ॥",
      "transliteration": "chap ddaarat chaachar bhaan sooa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਲੋਕੀਂ) ਸੂਰਜ ਦੀਆਂ ਕਿਰਨਾ (ਵਾਗ ਸੁਸ਼ੋਭਿਤ ਰਾਜੇ ਉਤੇ) ਪ੍ਰਸੰਨ ਹੋ ਕੇ ਹੋਲੀ ਵਾਗ ਰੰਗ ਸੁਟ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "चपि डारत चाचर भानु सूअं ॥",
      "sourceLineId": "103396",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੁਖ ਪਾਵਤ ਦੇਖ ਨਰੇਸ ਭੂਅੰ ॥",
      "transliteration": "sukh paavat dhekh nares bhooa(n) ||",
      "translation": "The sun and the moon were frightened from that army and seeing that king, all other kings of the earth were feeling happy",
      "punjabiViakhya": "ਅਤੇ ਧਰਤੀ ਦੇ ਰਾਜੇ ਨੂੰ ਵੇਖ ਕੇ ਸੁਖ ਪ੍ਰਾਪਤ ਕਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "सुख पावत देख नरेस भूअं ॥",
      "sourceLineId": "103397",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗਲ ਗਜਤ ਢੋਲ ਮ੍ਰਿਦੰਗ ਸੁਰੰ ॥",
      "transliteration": "gal gajat ddol miradha(n)g sura(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਹਾਥੀਆਂ ਦੇ) ਗਲਾ ਦੇ ਟਲ, ਢੋਲ ਅਤੇ ਮ੍ਰਿਦੰਗ ਦੀ ਸੁਰ ਨਾਲ ਗਜ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "गल गजत ढोल मृदंग सुरं ॥",
      "sourceLineId": "103398",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਹੁ ਬਾਜਤ ਨਾਦ ਨਯੰ ਮੁਰਜੰ ॥੩੪੯॥",
      "transliteration": "bahu baajat naadh naya(n) muraja(n) ||349||",
      "translation": "Various kinds of musical instruments including the drums resounded.349.",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਸਾਰੇ ਸੰਖ, ਸ਼ਹਨਾਈਆਂ ਅਤੇ ਤੁਰਮ ਵਜ ਰਹੇ ਸਨ ॥੩੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "बहु बाजत नाद नयं मुरजं ॥३४९॥",
      "sourceLineId": "103399",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਲਿ ਕਿੰਕਣਿ ਭੂਖਤ ਅੰਗਿ ਬਰੰ ॥",
      "transliteration": "kal ki(n)kan bhookhat a(n)g bara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਤੜਾਗੀਆਂ (ਵਜਦੀਆਂ) ਸਨ ਅਤੇ ਅੰਗ ਗਹਿਣਿਆਂ ਨਾਲ ਸਜੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "कलि किंकणि भूखत अंगि बरं ॥",
      "sourceLineId": "103400",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਨ ਲੇਪਤ ਚੰਦਨ ਚਾਰ ਪ੍ਰਭੰ ॥",
      "transliteration": "tan lepat cha(n)dhan chaar prabha(n) ||",
      "translation": "Various kinds of colourful ornaments including Noopar and Kinkini looked splendid and there was the plastering of sandal on all the faces",
      "punjabiViakhya": "ਸ਼ਰੀਰ ਉਤੇ ਚੰਦਨ ਦਾ ਸੁੰਦਰ ਲੇਪ ਕੀਤਾ ਹੋਇਆ ਸੀ ਜਿਸ ਕਰ ਕੇ ਸੁੰਦਰ ਚਮਕ ਦਮਕ ਹੋ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "तन लेपत चंदन चार प्रभं ॥",
      "sourceLineId": "103401",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮ੍ਰਿਦੁ ਡੋਲਤ ਬੋਲਤ ਬਾਤ ਮੁਖੰ ॥",
      "transliteration": "miradh ddolat bolat baat mukha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੌਲੀ ਹੌਲੀ ਟੁਰ ਰਹੇ ਸਨ ਅਤੇ ਮੂੰਹ ਤੋਂ ਮਿਠੇ ਬੋਲ ਬੋਲ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "मृदु डोलत बोलत बात मुखं ॥",
      "sourceLineId": "103402",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗ੍ਰਿਹਿ ਆਵਤ ਖੇਲ ਅਖੇਟ ਸੁਖੰ ॥੩੫੦॥",
      "transliteration": "gireh aavat khel akheT sukha(n) ||350||",
      "translation": "All of them were moving an talking happily and were returning to their homes happily.350.",
      "punjabiViakhya": "(ਰਾਜਾ) ਸ਼ਿਕਾਰ ਖੇਡ ਕੇ ਘਰ ਆ ਰਿਹਾ ਸੀ ॥੩੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "गृहि आवत खेल अखेट सुखं ॥३५०॥",
      "sourceLineId": "103403",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੁਖ ਪੋਛ ਗੁਲਾਬ ਫੁਲੇਲ ਸੁਭੰ ॥",
      "transliteration": "mukh pochh gulaab fulel subha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਗੁਲਾਬ (ਦੀ ਸੁਗੰਧੀ) ਅਤੇ ਉਤਮ ਫੁਲੇਲ ਨਾਲ ਮੂੰਹ ਚੋਪੜਿਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "मुख पोछ गुलाब फुलेल सुभं ॥",
      "sourceLineId": "103404",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਲਿ ਕਜਲ ਸੋਹਤ ਚਾਰੁ ਚਖੰ ॥",
      "transliteration": "kal kajal sohat chaar chakha(n) ||",
      "translation": "They were wiping the essences of rose and otto from their faces and there was comely antimony in their eyes",
      "punjabiViakhya": "ਸੁੰਦਰ ਅੱਖਾ ਵਿਚ ਵਧੀਆ ਸੁਰਮਾ ਸ਼ੋਭ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "कलि कजल सोहत चारु चखं ॥",
      "sourceLineId": "103405",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮੁਖ ਉਜਲ ਚੰਦ ਸਮਾਨ ਸੁਭੰ ॥",
      "transliteration": "mukh ujal cha(n)dh samaan subha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਖ ਚੰਦ੍ਰਮਾ ਵਾਗ ਸ਼ੋਭ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "मुख उजल चंद समान सुभं ॥",
      "sourceLineId": "103406",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਵਿਲੋਕਿ ਛਕੇ ਗਣ ਗੰਧ੍ਰਬਿਸੰ ॥੩੫੧॥",
      "transliteration": "avilok chhake gan ga(n)dhrabisa(n) ||351||",
      "translation": "The pretty faces of al looked fine like ivory and even Ganas and Gandharvas were pleased to see them.351.",
      "punjabiViakhya": "ਗਣਾ ਅਤੇ ਗੰਧਰਬਾ ਦੇ ਸੁਆਮੀ (ਉਸ ਨੂੰ) ਵੇਖ ਕੇ ਪ੍ਰਸੰਨ ਹੋ ਰਹੇ ਹਨ ॥੩੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "अविलोकि छके गण गंध्रबिसं ॥३५१॥",
      "sourceLineId": "103407",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੁਭ ਸੋਭਤ ਹਾਰ ਅਪਾਰ ਉਰੰ ॥",
      "transliteration": "subh sobhat haar apaar ura(n) ||",
      "translation": "",
      "punjabiViakhya": "ਗਲ ਵਿਚ ਪਾਏ ਬਹੁਤ ਸਾਰੇ ਹਾਰ ਸ਼ੁਭਾਇਮਾਨ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "सुभ सोभत हार अपार उरं ॥",
      "sourceLineId": "103408",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਿਲਕੰ ਦੁਤਿ ਕੇਸਰ ਚਾਰੁ ਪ੍ਰਭੰ ॥",
      "transliteration": "tilaka(n) dhut kesar chaar prabha(n) ||",
      "translation": "There were pretty necklaces around the necks of all and there were frontal marks of saffron on the foreheads of all",
      "punjabiViakhya": "(ਮੱਥੇ ਉਤੇ ਲਗਿਆ) ਕੇਸਰ ਦਾ ਤਿਲਕ ਬਹੁਤ ਸੁੰਦਰ ਸਜ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "तिलकं दुति केसर चारु प्रभं ॥",
      "sourceLineId": "103409",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਨਸੰਖ ਅਛੂਹਨ ਸੰਗ ਦਲੰ ॥",
      "transliteration": "anasa(n)kh achhoohan sa(n)g dhala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਣਗਿਣਤ ਫ਼ੌਜਾ ਨਾਲ ਲੈ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "अनसंख अछूहन संग दलं ॥",
      "sourceLineId": "103410",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਿਹ ਜਾਤ ਭਏ ਸਨ ਸੈਨ ਮਗੰ ॥੩੫੨॥",
      "transliteration": "teh jaat bhe san sain maga(n) ||352||",
      "translation": "This enormous army was moving on that path.352.",
      "punjabiViakhya": "ਰਾਜਾ ਉਸ ਮਾਰਗ ਤੋਂ ਲੰਘ ਰਿਹਾ ਸੀ ॥੩੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "तिह जात भए सन सैन मगं ॥३५२॥",
      "sourceLineId": "103411",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਫਿਰਿ ਆਇ ਗਏ ਤਿਹ ਪੈਂਡ ਮੁਨੰ ॥",
      "transliteration": "fir aai ge teh pai(n)dd muna(n) ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਉਸ ਰਸਤੇ ਉਤੇ ਮੁਨੀ (ਦੱਤ) ਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "फिरि आइ गए तिह पैंड मुनं ॥",
      "sourceLineId": "103412",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਲਿ ਬਾਜਤ ਸੰਖਨ ਨਾਦ ਧੁਨੰ ॥",
      "transliteration": "kal baajat sa(n)khan naadh dhuna(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਸੰਖ ਅਤੇ ਰਣਸਿੰਗੇ ਦੀ ਆਵਾਜ਼ ਹੋ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "कलि बाजत संखन नाद धुनं ॥",
      "sourceLineId": "103413",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਵਿਲੋਕਿ ਤਹਾ ਇਕ ਬਾਨ ਗਰੰ ॥",
      "transliteration": "avilok tahaa ik baan gara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਤੀਰ ਬਣਾਉਣ ਵਾਲਾ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "अविलोकि तहा इक बान गरं ॥",
      "sourceLineId": "103414",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਿਰ ਨੀਚ ਮਨੋ ਲਿਖ ਚਿਤ੍ਰ ਧਰੰ ॥੩੫੩॥",
      "transliteration": "sir neech mano likh chitr dhara(n) ||353||",
      "translation": "The sage Dutt, blowing his conch reached on that path were he saw an arrow-maker with his bowed head, sitting like a portrait.353.",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸਿਰ ਨੀਵਾ ਕੀਤਾ ਹੋਇਆ ਸੀ ਮਾਨੋ ਕਿਸੇ ਨੇ ਚਿਤਰ ਬਣਾ ਕੇ ਧਰਿਆ ਹੋਵੇ ॥੩੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "सिर नीच मनो लिख चित्र धरं ॥३५३॥",
      "sourceLineId": "103415",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਵਿਲੋਕ ਰਿਖੀਸਰ ਤੀਰ ਗਰੰ ॥",
      "transliteration": "avilok rikheesar teer gara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਨੀ ਨੇ ਨੀਵੀਂ ਪਾਈ (ਉਸ) ਪੁਰਸ਼ ਨੂੰ ਵੇਖ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "अविलोक रिखीसर तीर गरं ॥",
      "sourceLineId": "103416",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹਸਿ ਬੈਨ ਸੁ ਭਾਤਿ ਇਮੰ ਉਚਰੰ ॥",
      "transliteration": "has bain su bhaat ima(n) uchara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹਸਦੇ ਹੋਇਆਂ ਇਸ ਤਰ੍ਰਹਾ ਬੋਲ ਉਚਾਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "हसि बैन सु भाति इमं उचरं ॥",
      "sourceLineId": "103417",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਹੁ ਭੂਪ ਗਏ ਲੀਏ ਸੰਗਿ ਦਲੰ ॥",
      "transliteration": "kahu bhoop ge le'ee sa(n)g dhala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਫੌਜ ਨੂੰ ਨਾਲ ਲੈ ਕੇ ਰਾਜਾ ਕਿਧਰ ਨੂੰ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "कहु भूप गए लीए संगि दलं ॥",
      "sourceLineId": "103418",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਹਿਓ ਸੋ ਨ ਗੁਰੂ ਅਵਿਲੋਕ ਦ੍ਰਿਗੰ ॥੩੫੪॥",
      "transliteration": "kahio so na guroo avilok dhiraga(n) ||354||",
      "translation": "The great sage, seeing him, said this, “Where had the king gone with his army?” That arrow-maker replied, “I have not seen anyone with my eyes.”354.",
      "punjabiViakhya": "(ਉਸ ਨੇ ਉੱਤਰ ਵਿਚ) ਕਿਹਾ ਕਿ ਹੇ ਗੁਰੂ! ਮੈਂ ਅੱਖਾ ਨਾਲ ਉਸ ਨੂੰ ਨਹੀਂ ਵੇਖਿਆ ॥੩੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "कहिओ सो न गुरू अविलोक दृगं ॥३५४॥",
      "sourceLineId": "103419",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚਕਿ ਚਿਤ ਰਹੇ ਅਚਿਤ ਮੁਨੰ ॥",
      "transliteration": "chak chit rahe achit muna(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ ਗੱਲ) ਸੁਣ ਕੇ ਮੁਨੀ ਦਾ ਚੰਚਲ ਚਿਤ ਹੈਰਾਨ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "चकि चित रहे अचित मुनं ॥",
      "sourceLineId": "103420",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਨਖੰਡ ਤਪੀ ਨਹੀ ਜੋਗ ਡੁਲੰ ॥",
      "transliteration": "anakha(n)dd tapee nahee jog ddula(n) ||",
      "translation": "The sage, seeing his stable mind, was wonder-struck",
      "punjabiViakhya": "ਇਹ ਅਖੰਡ ਤਪਸਵੀ ਹੈ, (ਇਸ ਦਾ) ਯੋਗ ਅਡੋਲ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "अनखंड तपी नही जोग डुलं ॥",
      "sourceLineId": "103421",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0663_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਨਆਸ ਅਭੰਗ ਉਦਾਸ ਮਨੰ ॥",
      "transliteration": "anaas abha(n)g udhaas mana(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ) ਆਸ ਤੋਂ ਰਹਿਤ ਹੈ ਅਤੇ (ਇਸ ਦਾ) ਨਾ ਭੰਗ ਹੋਣ ਵਾਲਾ ਮਨ ਵਿਰਕਤ ('ਉਦਾਸ') ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 663,
      "hindi": "",
      "hindiTransliteration": "अनआस अभंग उदास मनं ॥",
      "sourceLineId": "103422",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
