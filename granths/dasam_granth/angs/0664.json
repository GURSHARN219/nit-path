{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 664,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0664_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਠਵੰਤ ਬ੍ਰਤੀ ਰਿਖਿ ਅਤ੍ਰ ਸੂਅੰ ॥੩੫੬॥",
      "transliteration": "haThava(n)t bratee rikh atr sooa(n) ||356||",
      "translation": "His now was perfect and the body distinctive he was persistent, vow-observing and like the son of sage Atri.356.",
      "punjabiViakhya": "ਹਠ ਵਾਲੇ, ਬ੍ਰਤ ਧਾਰਨ ਕਰਨ ਵਾਲੇ ਅਤੇ ਅਤ੍ਰੀ ਰਿਸ਼ੀ ਦੇ ਪੁੱਤਰ ਨੇ (ਅਜਿਹਾ ਵਿਚਾਰ ਕੀਤਾ ਹੈ) ॥੩੫੬॥",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "हठवंत ब्रती रिखि अत्र सूअं ॥३५६॥",
      "sourceLineId": "103427",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਵਿਲੋਕਿ ਸਰੰ ਕਰਿ ਧਿਆਨ ਜੁਤੰ ॥",
      "transliteration": "avilok sara(n) kar dhiaan juta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਬਾਣ ਬਣਾਉਣ ਵਾਲੇ ਨੂੰ ਜਟਾ ਵਾਲੇ ਹਠੀ",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "अविलोकि सरं करि धिआन जुतं ॥",
      "sourceLineId": "103428",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਹਿ ਰੀਝ ਜਟੀ ਹਠਵੰਤ ਬ੍ਰਤੰ ॥",
      "transliteration": "reh reejh jaTee haThava(n)t brata(n) ||",
      "translation": "The sage Dutt seeing his arrows and meditation, was greatly pleased",
      "punjabiViakhya": "ਅਤੇ ਬ੍ਰਤ ਧਾਰੀ (ਦੱਤ ਮੁਨੀ) ਵੇਖ ਕੇ ਰੀਝ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "रहि रीझ जटी हठवंत ब्रतं ॥",
      "sourceLineId": "103429",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਰੁ ਮਾਨਿਸ ਪੰਚਦਸ੍ਵੋ ਪ੍ਰਬਲੰ ॥",
      "transliteration": "gur maanis pa(n)chadhasavaio prabala(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਮਨ ਵਿਚ ਪੰਦ੍ਰਵਾ ਮਹਾਨ ਗੁਰੂ ਮੰਨ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "गुरु मानिस पंचदस्वो प्रबलं ॥",
      "sourceLineId": "103430",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹਠ ਛਾਡਿ ਸਬੈ ਤਿਨ ਪਾਨ ਪਰੰ ॥੩੫੭॥",
      "transliteration": "haTh chhaadd sabai tin paan para(n) ||357||",
      "translation": "Adopting him his fifteenth Guru and leaving all his persistence he accepted him as his redeemer.357.",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਹਠ ਛਡ ਕੇ ਸਾਰਿਆਂ ਸਮੇਤ ਪੈਰੀ ਪੌਣਾ ਕੀਤਾ ॥੩੫੭॥",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "हठ छाडि सबै तिन पान परं ॥३५७॥",
      "sourceLineId": "103431",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਇਮਿ ਨਾਹ ਸੌ ਜੋ ਨਰ ਨੇਹ ਕਰੈ ॥",
      "transliteration": "eim naeh sau jo nar neh karai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਕੋਈ ਇਸ ਤਰ੍ਰਹਾ ਪਰਮਾਤਮਾ ('ਨਾਹ') ਨਾਲ ਪ੍ਰੇਮ ਕਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "इमि नाह सौ जो नर नेह करै ॥",
      "sourceLineId": "103432",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭਵ ਧਾਰ ਅਪਾਰਹਿ ਪਾਰ ਪਰੈ ॥",
      "transliteration": "bhav dhaar apaareh paar parai ||",
      "translation": "In this way, whosoever loves the Lord, he crosses this infinite ocean of existence",
      "punjabiViakhya": "ਤਾ ਸੰਸਾਰ ਸਾਗਰ ਦੀ ਅਥਾਹ ਧਾਰ ਤੋਂ ਪਾਰ ਹੋ ਜਾਏਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "भव धार अपारहि पार परै ॥",
      "sourceLineId": "103433",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਨ ਕੇ ਮਨ ਕੇ ਭ੍ਰਮ ਪਾਸਿ ਧਰੇ ॥",
      "transliteration": "tan ke man ke bhram paas dhare ||",
      "translation": "",
      "punjabiViakhya": "ਤਨ ਅਤੇ ਮਨ ਦੇ ਭਰਮਾ ਨੂੰ ਪਾਸੇ ਰਖ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "तन के मन के भ्रम पासि धरे ॥",
      "sourceLineId": "103434",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਰਿ ਪੰਦ੍ਰਸਵੋ ਗੁਰੁ ਪਾਨ ਪਰੇ ॥੩੫੮॥",
      "transliteration": "kar pa(n)dhrasavo gur paan pare ||358||",
      "translation": "Removing the illusions of his body ad mind, Dutt fell down at the feet of his Fifteenth Guru in this way.358.",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਪੰਦ੍ਰਵਾ ਗੁਰੂ ਧਾਰਨ ਕਰ ਕੇ ਪੈਰੀਂ ਪਏ ॥੩੫੮॥",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "करि पंद्रसवो गुरु पान परे ॥३५८॥",
      "sourceLineId": "103435",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਤਿ ਪੰਦ੍ਰਸਵ ਗੁਰੂ ਬਾਨਗਰ ਸਮਾਪਤੰ ॥੧੫॥",
      "transliteration": "eit pa(n)dhrasav guroo baanagar samaapata(n) ||15||",
      "translation": "End of the description of the adoption of an Arrow-maker as the Fifteenth Guru.",
      "punjabiViakhya": "ਇਥੇ ਪੰਦ੍ਰਵੇਾਂ ਗੁਰੂ 'ਬਾਨਗਰ' ਦਾ ਪ੍ਰਸੰਗ ਸਮਾਪਤ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "इति पंद्रसव गुरू बानगर समापतं ॥१५॥",
      "sourceLineId": "103436",
      "sourceShabadId": "9362",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਥ ਚਾਵਡਿ ਸੋਰਵੋ ਗੁਰੁ ਕਥਨੰ ॥",
      "transliteration": "ath chaavadd soravo gur kathana(n) ||",
      "translation": "Now begins the description of the adoption of a vulture as the Sixteenth Guru",
      "punjabiViakhya": "ਹੁਣ ਚਾਵਡ ਨਾ ਦੇ ਸੋਲ੍ਰਹਵੇਾਂ ਗੁਰੂ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "अथ चावडि सोरवो गुरु कथनं ॥",
      "sourceLineId": "103437",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤੋਟਕ ਛੰਦ ॥",
      "transliteration": "toTak chha(n)dh ||",
      "translation": "TOTAK STANZA",
      "punjabiViakhya": "ਤੋਟਕ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "तोटक छंद ॥",
      "sourceLineId": "103438",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮੁਖ ਬਿਭੂਤ ਭਗਵੇ ਭੇਸ ਬਰੰ ॥",
      "transliteration": "mukh bibhoot bhagave bhes bara(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਦੱਤ ਨੇ) ਮੁਖ ਉਤੇ ਵਿਭੂਤੀ (ਮਲੀ ਹੋਈ ਹੈ)",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "मुख बिभूत भगवे भेस बरं ॥",
      "sourceLineId": "103439",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੁਭ ਸੋਭਤ ਚੇਲਕ ਸੰਗ ਨਰੰ ॥",
      "transliteration": "subh sobhat chelak sa(n)g nara(n) ||",
      "translation": "The sage was alongwith his disciples having smeared his face with ashes and wearing the ochre-coloured clothes",
      "punjabiViakhya": "ਅਤੇ ਸੁੰਦਰ ਭਗਵਾ ਭੇਸ ਧਾਰਨ ਕੀਤਾ ਹੋਇਆ ਹੈ। ਉਸ ਦੇ ਨਾਲ ਚੇਲਿਆਂ ਦਾ ਸ਼ੁਭ ਸਾਥ ਸੋਭ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "सुभ सोभत चेलक संग नरं ॥",
      "sourceLineId": "103440",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਨ ਗਾਵਤ ਗੋਬਿੰਦ ਏਕ ਮੁਖੰ ॥",
      "transliteration": "gun gaavat gobi(n)dh ek mukha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮੂੰਹ ਨਾਲ ਇਕ ਗੋਬਿੰਦ ਦੇ ਗੁਣ ਗਾਉਾਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "गुन गावत गोबिंद एक मुखं ॥",
      "sourceLineId": "103441",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਨ ਡੋਲਤ ਆਸ ਉਦਾਸ ਸੁਖੰ ॥੩੫੯॥",
      "transliteration": "ban ddolat aas udhaas sukha(n) ||359||",
      "translation": "He was singing the praises of the Lord with his mouth and was moving unattached with all kind of desires.359.",
      "punjabiViakhya": "ਬਨ ਵਿਚ ਸੁਖ ਦੀ ਆਸ ਤੋਂ ਵਿਰਕਤ ਡੋਲ ਰਹੇ ਹਨ ॥੩੫੯॥",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "बन डोलत आस उदास सुखं ॥३५९॥",
      "sourceLineId": "103442",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੁਭ ਸੂਰਤਿ ਪੂਰਤ ਨਾਦ ਨਵੰ ॥",
      "transliteration": "subh soorat poorat naadh nava(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਸਰੂਪ ਵਾਲਾ (ਦੱਤ) ਰਿਸ਼ੀ ਨਾਦ ਪੂਰਦਾ ਜਾ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "सुभ सूरति पूरत नाद नवं ॥",
      "sourceLineId": "103443",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਤਿ ਉਜਲ ਅੰਗ ਬਿਭੂਤ ਰਿਖੰ ॥",
      "transliteration": "at ujal a(n)g bibhoot rikha(n) ||",
      "translation": "Various sounds were created with the mouth and the sage Dutt’s body was allied with many types of magnificence",
      "punjabiViakhya": "ਅੰਗਾ ਉਤੇ ਰਿਸ਼ੀ ਨੇ ਅਤਿ ਉਜਲੀ ਵਿਭੂਤੀ ਮਲੀ ਹੋਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "अति उजल अंग बिभूत रिखं ॥",
      "sourceLineId": "103444",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਹੀ ਬੋਲਤ ਡੋਲਤ ਦੇਸ ਦਿਸੰ ॥",
      "transliteration": "nahee bolat ddolat dhes dhisa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਮੁਖ ਤੋਂ ਕੁਝ) ਨਹੀਂ ਬੋਲਦਾ, ਦੇਸਾ ਦੇਸਾ ਵਿਚ ਫਿਰ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "नही बोलत डोलत देस दिसं ॥",
      "sourceLineId": "103445",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗੁਨ ਚਾਰਤ ਧਾਰਤ ਧ੍ਯਾਨ ਹਰੰ ॥੩੬੦॥",
      "transliteration": "gun chaarat dhaarat dhayaan hara(n) ||360||",
      "translation": "He was moving silently in various countries far and near and was meditating on the Lord in his mind.360.",
      "punjabiViakhya": "ਹਰਿ-ਗੁਣ ਗਾਉਾਂਦਾ ਹੈ ਅਤੇ ਹਰਿ ਦਾ ਧਿਆਨ ਧਾਰਦਾ ਹੈ ॥੩੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "गुन चारत धारत ध्यान हरं ॥३६०॥",
      "sourceLineId": "103446",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਵਿਲੋਕਯ ਚਾਵੰਡਿ ਚਾਰੁ ਪ੍ਰਭੰ ॥",
      "transliteration": "avilokay chaava(n)dd chaar prabha(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਸੁੰਦਰ ਪ੍ਰਭਾ ਵਾਲੀ ਇਲ (ਚਾਵਡ) ਵੇਖੀ",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "अविलोकय चावंडि चारु प्रभं ॥",
      "sourceLineId": "103447",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗ੍ਰਿਹਿ ਜਾਤ ਉਡੀ ਗਹਿ ਮਾਸੁ ਮੁਖੰ ॥",
      "transliteration": "gireh jaat uddee geh maas mukha(n) ||",
      "translation": "There he saw a vulture, who was holding a piece of flesh in his mouth and flying",
      "punjabiViakhya": "(ਜੋ) ਮੂੰਹ ਵਿਚ ਮਾਸ ਪਾਈ ਘਰ ਵਲ ਉਡੀ ਜਾ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "गृहि जात उडी गहि मासु मुखं ॥",
      "sourceLineId": "103448",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਲਖਿ ਕੈ ਪਲ ਚਾਵੰਡਿ ਚਾਰ ਚਲੀ ॥",
      "transliteration": "lakh kai pal chaava(n)dd chaar chalee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਸੁੰਦਰ ਇਲ ਨੂੰ ਇਕ ਹੋਰ ਨੇ ਮਾਸ ਦਾ ਟੁਕੜਾ ਲੈ ਜਾਦਿਆਂ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "लखि कै पल चावंडि चार चली ॥",
      "sourceLineId": "103449",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਿਹ ਤੇ ਅਤਿ ਪੁਸਟ ਪ੍ਰਮਾਥ ਬਲੀ ॥੩੬੧॥",
      "transliteration": "teh te at pusaT pramaath balee ||361||",
      "translation": "Seeing it, more powerful four vultures moved forward.361.",
      "punjabiViakhya": "(ਜੋ) ਉਸ ਤੋਂ ਜ਼ਿਆਦਾ ਤਕੜੀ ਅਤੇ ਬਲਵਾਨ ਸੀ ॥੩੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "तिह ते अति पुसट प्रमाथ बली ॥३६१॥",
      "sourceLineId": "103450",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਵਿਲੋਕਿਸ ਮਾਸ ਅਕਾਸ ਉਡੀ ॥",
      "transliteration": "avilokis maas akaas uddee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਮਾਸ ਦਾ ਟੁਕੜਾ ਲਏ ਹੋਇਆਂ ਆਕਾਸ਼ ਵਿਚ ਉਡੀ ਜਾਦੀ ਵੇਖ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "अविलोकिस मास अकास उडी ॥",
      "sourceLineId": "103451",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਤਿ ਜੁਧੁ ਤਹੀ ਤਿਹੰ ਸੰਗ ਮੰਡੀ ॥",
      "transliteration": "at judh tahee tiha(n) sa(n)g ma(n)ddee ||",
      "translation": "They flew in the sky and there they began to fight with that vulture",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਉਸ ਨਾਲ ਉਥੇ ਹੀ ਯੁੱਧ ਮਚਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "अति जुधु तही तिहं संग मंडी ॥",
      "sourceLineId": "103452",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਜਿ ਮਾਸੁ ਚੜਾ ਉਡਿ ਆਪ ਚਲੀ ॥",
      "transliteration": "taj maas chaRaa udd aap chalee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਨੂੰ ਬਲਵਾਨ ਜਾਣ ਕੇ ਸੁੰਦਰ ਇਲ ('ਚੜਾ') ਮਾਸ ਦੇ ਟੁਕੜੇ ਨੂੰ ਛਡ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "तजि मासु चड़ा उडि आप चली ॥",
      "sourceLineId": "103453",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਲਹਿ ਕੈ ਚਿਤ ਚਾਵੰਡਿ ਚਾਰ ਬਲੀ ॥੩੬੨॥",
      "transliteration": "leh kai chit chaava(n)dd chaar balee ||362||",
      "translation": "Whe dropped the pieced of flesh on seeing these powerful vultures and flew away.362.",
      "punjabiViakhya": "ਆਕਾਸ਼ ਨੂੰ ਉਡ ਕੇ ਚਲੀ ਗਈ ॥੩੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "लहि कै चित चावंडि चार बली ॥३६२॥",
      "sourceLineId": "103454",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਵਿਲੋਕਿ ਸੁ ਚਾਵੰਡਿ ਚਾਰ ਪਲੰ ॥",
      "transliteration": "avilok su chaava(n)dd chaar pala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮਾਸ ('ਪਲੰ') ਦੇ ਸੁੰਦਰ ਟੁਕੜੇ ਨੂੰ ਵੇਖ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "अविलोकि सु चावंडि चार पलं ॥",
      "sourceLineId": "103455",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਜਿ ਤ੍ਰਾਸ ਭਾਈ ਥਿਰ ਭੂਮਿ ਥਲੰ ॥",
      "transliteration": "taj traas bhaiee thir bhoom thala(n) ||",
      "translation": "Seeing those four vulture, even the earth below became stable out of fear seeing them,",
      "punjabiViakhya": "ਡਰ ਨੂੰ ਛਡ ਕੇ ਧਰਤੀ ਉਤੇ ਸਥਿਰ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "तजि त्रास भाई थिर भूमि थलं ॥",
      "sourceLineId": "103456",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਲਖਿ ਤਾਸੁ ਮਨੰ ਮੁਨਿ ਚਉਕ ਰਹ੍ਯੋ ॥",
      "transliteration": "lakh taas mana(n) mun chauk rahayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਮੁਨੀ (ਦੱਤ) ਮਨ ਵਿਚ ਹੈਰਾਨ ਹੋ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "लखि तासु मनं मुनि चउक रह्यो ॥",
      "sourceLineId": "103457",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚਿਤ ਸੋਰ੍ਰਹਸਵੇ ਗੁਰੁ ਤਾਸੁ ਕਹ੍ਯੋ ॥੩੬੩॥",
      "transliteration": "chit sorrahasave gur taas kahayo ||363||",
      "translation": "The sage was startled and adopted them (it) as the Sixteeth Guru.363.",
      "punjabiViakhya": "(ਫਿਰ) ਚਿਤ ਵਿਚ ਉਸ ਨੂੰ ਸੋਲ੍ਰਹਵਾ ਗੁਰੂ ਕਹਿ ਦਿੱਤਾ ਹੈ ॥੩੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "चित सोर्रहसवे गुरु तासु कह्यो ॥३६३॥",
      "sourceLineId": "103458",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕੋਊ ਐਸ ਤਜੈ ਜਬ ਸਰਬ ਧਨੰ ॥",
      "transliteration": "kouoo aais tajai jab sarab dhana(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਕੋਈ ਇਸ ਤਰ੍ਰਹਾ (ਦੁਖ ਦਾ ਕਾਰਨ ਸਮਝ ਕੇ) ਸਾਰੇ ਧਨ ਨੂੰ ਛਡ ਦਿੰਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "कोऊ ऐस तजै जब सरब धनं ॥",
      "sourceLineId": "103459",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਰਿ ਕੈ ਬਿਨੁ ਆਸ ਉਦਾਸ ਮਨੰ ॥",
      "transliteration": "kar kai bin aas udhaas mana(n) ||",
      "translation": "If anyone getting unattached with all the desires, forsakes all the assets",
      "punjabiViakhya": "ਅਤੇ ਮਨ ਨੂੰ ਆਸ ਤੋਂ ਬਿਨਾ ਉਦਾਸ (ਵਿਰਕਤ) ਕਰ ਲੈਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "करि कै बिनु आस उदास मनं ॥",
      "sourceLineId": "103460",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਬ ਪਾਚਉ ਇੰਦ੍ਰੀ ਤਿਆਗ ਰਹੈ ॥",
      "transliteration": "tab paachau i(n)dhree tiaag rahai ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਪੰਜੇ ਇੰਦਰੀਆਂ (ਵਿਸ਼ਿਆਂ ਨੂੰ) ਤਿਆਗ ਕੇ ਅਚਲ ਹੋ ਜਾਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "तब पाचउ इंद्री तिआग रहै ॥",
      "sourceLineId": "103461",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਨ ਚੀਲਨ ਜਿਉ ਸ੍ਰੁਤ ਐਸ ਕਹੈ ॥੩੬੪॥",
      "transliteration": "ein cheelan jiau srut aais kahai ||364||",
      "translation": "Then only he can be considered an ascetic make his understanding like these vultures.364.",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਇਲਾ ਵਾਗ ਵੇਦ ਵੀ ਇਸੇ ਤਰ੍ਰਹਾ ਕਹਿੰਦੇ ਹਨ ॥੩੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "इन चीलन जिउ स्रुत ऐस कहै ॥३६४॥",
      "sourceLineId": "103462",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਇਤਿ ਸੋਰ੍ਰਹਵੋ ਗੁਰੂ ਚਾਵੰਡਿ ਸਮਾਪਤੰ ॥੧੬॥",
      "transliteration": "eit sorrahavo guroo chaava(n)dd samaapata(n) ||16||",
      "translation": "End of the description of the adoption of a Vulture as Sidxteenth Guru.",
      "punjabiViakhya": "ਇਥੇ ਸੋਲ੍ਰਹਵੇਾਂ ਗੁਰੂ 'ਚਾਵਡ' ਦਾ ਪ੍ਰਸੰਗ ਸਮਾਪਤ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "इति सोर्रहवो गुरू चावंडि समापतं ॥१६॥",
      "sourceLineId": "103463",
      "sourceShabadId": "9363",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਥ ਦੁਧੀਰਾ ਸਤਾਰਵੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "transliteration": "ath dhudheeraa sataaravo guroo kathana(n) ||",
      "translation": "Now begins the description of the adoption of a Fishing Bird as the Seventeenth Guru",
      "punjabiViakhya": "ਹੁਣ 'ਦੁਧੀਰਾ' ਸਤਾਰ੍ਰਹਵੇਾਂ ਗੁਰੂ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "अथ दुधीरा सतारवो गुरू कथनं ॥",
      "sourceLineId": "103464",
      "sourceShabadId": "9364",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤੋਟਕ ਛੰਦ ॥",
      "transliteration": "toTak chha(n)dh ||",
      "translation": "TOTAK STANZA",
      "punjabiViakhya": "ਤੋਟਕ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "तोटक छंद ॥",
      "sourceLineId": "103465",
      "sourceShabadId": "9364",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਰਿ ਸੋਰਸਵੋ ਰਿਖਿ ਤਾਸੁ ਗੁਰੰ ॥",
      "transliteration": "kar sorasavo rikh taas gura(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸੋਲ੍ਰਹਵਾ ਗੁਰੂ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "करि सोरसवो रिखि तासु गुरं ॥",
      "sourceLineId": "103466",
      "sourceShabadId": "9364",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਉਠਿ ਚਲੀਆ ਬਾਟ ਉਦਾਸ ਚਿਤੰ ॥",
      "transliteration": "auTh chaleeaa baaT udhaas chita(n) ||",
      "translation": "After adopting the vulture as the seventeenth Guru with unattached mind, Dutt proceeded again on his path",
      "punjabiViakhya": "(ਦੱਤ) ਰਿਸ਼ੀ ਉਦਾਸ ਚਿਤ ਨਾਲ ਰਾਹ ਉਤੇ ਤੁਰ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "उठि चलीआ बाट उदास चितं ॥",
      "sourceLineId": "103467",
      "sourceShabadId": "9364",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮੁਖਿ ਪੂਰਤ ਨਾਦਿ ਨਿਨਾਦ ਧੁਨੰ ॥",
      "transliteration": "mukh poorat naadh ninaadh dhuna(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਮੂੰਹ ਸ਼ਬਦਾ ਦੀ ਨਿਰੰਤਰ ਧੁਨ ਨਾਲ ਭਰਿਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "मुखि पूरत नादि निनाद धुनं ॥",
      "sourceLineId": "103468",
      "sourceShabadId": "9364",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੁਨਿ ਰੀਝਤ ਗੰਧ੍ਰਬ ਦੇਵ ਨਰੰ ॥੩੬੫॥",
      "transliteration": "sun reejhat ga(n)dhrab dhev nara(n) ||365||",
      "translation": "He was producing various types of sounds form his mouth and hearing the same, the gods, Gandharvas, men and women, all were getting pleased.365.",
      "punjabiViakhya": "(ਇਹ ਗੱਲ) ਸੁਣ ਕੇ ਦੇਵਤੇ, ਗੰਧਰਬ ਅਤੇ ਮਨੁੱਖ ਮੋਹਿਤ ਹੋ ਰਹੇ ਸਨ ॥੩੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "सुनि रीझत गंध्रब देव नरं ॥३६५॥",
      "sourceLineId": "103469",
      "sourceShabadId": "9364",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚਲਿ ਜਾਤ ਭਏ ਸਰਿਤਾ ਨਿਕਟੰ ॥",
      "transliteration": "chal jaat bhe saritaa nikaTa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਾਦੇ ਜਾਦੇ ਨਦੀ ਦੇ ਕੰਢੇ ਨੇੜੇ ਜਾ ਪਹੁੰਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "चलि जात भए सरिता निकटं ॥",
      "sourceLineId": "103470",
      "sourceShabadId": "9364",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹਠਵੰਤ ਰਿਖੰ ਤਪਸਾ ਬਿਕਟ ॥",
      "transliteration": "haThava(n)t rikha(n) tapasaa bikaT ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਹਠ ਵਾਲਾ ਅਤੇ ਕਠੋਰ ਤਪਸਵੀ ਰਿਸ਼ੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": "हठवंत रिखं तपसा बिकट ॥",
      "sourceLineId": "103471",
      "sourceShabadId": "9364",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0664_line_0046",
