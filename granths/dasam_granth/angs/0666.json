{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 666,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0666_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਘਨ ਮੈ ਜਿਮ ਬਿਦੁਲਤਾ ਝਮਕੈ ॥",
      "transliteration": "ghan mai jim bidhulataa jhamakai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਬਦਲ ਵਿਚ ਬਿਜਲੀ ਚਮਕਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "घन मै जिम बिदुलता झमकै ॥",
      "sourceLineId": "103523",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਿਖਿ ਮੋ ਗੁਨ ਤਾਸ ਸਬੈ ਦਮਕੈ ॥੩੭੮॥",
      "transliteration": "rikh mo gun taas sabai dhamakai ||378||",
      "translation": "All the qualities of these sages flashed like lightning amongst the clouds.378.",
      "punjabiViakhya": "ਉਸੇ ਤਰ੍ਰਹਾ ਰਿਸ਼ੀ ਵਿਚ ਸਾਰੇ ਗੁਣ ਚਮਕਾ ਮਾਰ ਰਹੇ ਹਨ ॥੩੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "रिखि मो गुन तास सबै दमकै ॥३७८॥",
      "sourceLineId": "103524",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਸ ਛਾਡਤ ਭਾਨੁ ਅਨੰਤ ਛਟਾ ॥",
      "transliteration": "jas chhaaddat bhaan ana(n)t chhaTaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਸੂਰਜ ਅਨੰਤ ਕਿਰਨਾ ਛਡਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "जस छाडत भानु अनंत छटा ॥",
      "sourceLineId": "103525",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਿਖਿ ਕੇ ਤਿਮ ਸੋਭਤ ਜੋਗ ਜਟਾ ॥",
      "transliteration": "rikh ke tim sobhat jog jaTaa ||",
      "translation": "The matted locks waved on the heads of the Yogis like the rays coming out of the sun",
      "punjabiViakhya": "ਉਸੇ ਤਰ੍ਰਹਾ ਰਿਸ਼ੀ ਦੇ ਸਿਰ ਤੋਂ ਜਟਾਵਾ ਸ਼ੋਭ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "रिखि के तिम सोभत जोग जटा ॥",
      "sourceLineId": "103526",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਿਨ ਕੀ ਦੁਖ ਫਾਸ ਕਹੂੰ ਨ ਕਟੀ ॥",
      "transliteration": "jin kee dhukh faas kahoo(n) na kaTee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦੇ ਦੁਖ ਦੀ ਫਾਸੀ ਕਿਤੇ ਵੀ ਨਹੀਂ ਕਟੀ ਗਈ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "जिन की दुख फास कहूँ न कटी ॥",
      "sourceLineId": "103527",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਿਖਿ ਭੇਟਤ ਤਾਸੁ ਛਟਾਕ ਛੁਟੀ ॥੩੭੯॥",
      "transliteration": "rikh bheTat taas chhaTaak chhuTee ||379||",
      "translation": "Those whose suffering ended on seeing these sges.379.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੀ ਰਿਸ਼ੀ ਨੂੰ ਮਿਲਣ ਨਾਲ ਹੀ ਚਟਾਖ ਕਰ ਕੇ ਟੁਟ ਗਈ ਹੈ ॥੩੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "रिखि भेटत तासु छटाक छुटी ॥३७९॥",
      "sourceLineId": "103528",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਰ ਜੋ ਨਹੀ ਨਰਕਨ ਤੇ ਨਿਵਰੈ ॥",
      "transliteration": "nar jo nahee narakan te nivarai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਪੁਰਸ਼ ਨਰਕਾ ਦੇ ਦੁਖ ਤੋਂ ਖਲਾਸ ਨਹੀਂ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "नर जो नही नरकन ते निवरै ॥",
      "sourceLineId": "103529",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਿਖਿ ਭੇਟਤ ਤਉਨ ਤਰਾਕ ਤਰੈ ॥",
      "transliteration": "rikh bheTat taun taraak tarai ||",
      "translation": "Those men and women, who had been cast in hell, they were redeemed on seeing these sages",
      "punjabiViakhya": "ਰਿਸ਼ੀ ਨੂੰ ਮਿਲਦਿਆਂ ਹੀ ਉਹ ਝਟਪਟ (ਦੁਖ ਦੇ ਸਾਗਰ ਨੂੰ) ਤਰ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "रिखि भेटत तउन तराक तरै ॥",
      "sourceLineId": "103530",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਿਨ ਕੇ ਸਮਤਾ ਕਹੂੰ ਨਾਹਿ ਠਟੀ ॥",
      "transliteration": "jin ke samataa kahoo(n) naeh ThaTee ||",
      "translation": "",
      "punjabiViakhya": "(ਪਾਪਾ ਕਾਰਨ) ਜਿਨ੍ਰਹਾ ਦੀ ਸਮਤਾ ਕਿਸੇ ਨਾਲ ਵੀ ਨਹੀਂ ਬੈਠਦੀ ਸੀ (ਅਰਥਾਤ ਪਰਮੇਸ਼ਰ ਨਾਲ ਮੇਲ ਨਹੀਂ ਹੋ ਰਿਹਾ ਸੀ)",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "जिन के समता कहूँ नाहि ठटी ॥",
      "sourceLineId": "103531",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰਿਖਿ ਪੂਜਿ ਘਟੀ ਸਬ ਪਾਪ ਘਟੀ ॥੩੮੦॥",
      "transliteration": "rikh pooj ghaTee sab paap ghaTee ||380||",
      "translation": "Those who had any sin within them, their sinful life endeed on worshipping these sages.380.",
      "punjabiViakhya": "ਰਿਸ਼ੀ ਦੀ ਘੜੀ ਭਰ ਪੂਜਾ ਕਰਦਿਆਂ ਹੀ (ਉਨ੍ਰਹਾ ਦੇ) ਪਾਪ ਘਟ ਗਏ ਹਨ ॥੩੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "रिखि पूजि घटी सब पाप घटी ॥३८०॥",
      "sourceLineId": "103532",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਤ ਬਧਿ ਤਉਨ ਬਿਠੋ ਮ੍ਰਿਗਹਾ ॥",
      "transliteration": "eit badh taun biTho miragahaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਧਰ ਉਹ ਸ਼ਿਕਾਰੀ (ਸ਼ਿਕਾਰ ਦੀ) ਟੋਹ ਵਿਚ ਬੈਠਾ ਹੋਇਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "इत बधि तउन बिठो मृगहा ॥",
      "sourceLineId": "103533",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਸ ਹੇਰਤ ਛੇਰਿਨਿ ਭੀਮ ਭਿਡਹਾ ॥",
      "transliteration": "jas herat chherin bheem bhiddahaa ||",
      "translation": "On this side, this hunter was sitting, on seeing whom, the animals used to run away",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਭੇਡਾ ਨੂੰ ਮਾਰਨ ਵਾਲਾ ਭਿਆਨਕ (ਬਘਿਆੜ) ਛੇਲੀਆਂ ਵਲ ਵੇਖ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "जस हेरत छेरिनि भीम भिडहा ॥",
      "sourceLineId": "103534",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਿਹ ਜਾਨ ਰਿਖੀਨ ਹੀ ਸਾਸ ਸਸ੍ਰਯੋ ॥",
      "transliteration": "teh jaan rikheen hee saas sasrayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਰਿਸ਼ੀ ਨੂੰ ਹਿਰਨ ਸਮਝ ਕੇ ਸਾਹ ਰੋਕ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "तिह जान रिखीन ही सास सस्रयो ॥",
      "sourceLineId": "103535",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮ੍ਰਿਗ ਜਾਨ ਮੁਨੀ ਕਹੁ ਬਾਨ ਕਸ੍ਰਯੋ ॥੩੮੧॥",
      "transliteration": "mirag jaan munee kahu baan kasrayo ||381||",
      "translation": "He did not recognize the sage and condidering him a deer, he aimed his arrow at him.381.",
      "punjabiViakhya": "ਅਤੇ ਮੁਨੀ ਨੂੰ ਮਾਰਨ ਲਈ ਤੀਰ ਖਿਚ ਲਿਆ ॥੩੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "मृग जान मुनी कहु बान कस्रयो ॥३८१॥",
      "sourceLineId": "103536",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਰ ਪੇਖ ਸਬੈ ਤਿਹ ਸਾਧ ਕਹੈ ॥",
      "transliteration": "sar pekh sabai teh saadh kahai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਸਾਧਾ ਨੇ ਕਸੇ ਹੋਏ ਤੀਰ ਨੂੰ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "सर पेख सबै तिह साध कहै ॥",
      "sourceLineId": "103537",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮ੍ਰਿਗ ਹੋਇ ਨ ਰੇ ਮੁਨਿ ਰਾਜ ਇਹੈ ॥",
      "transliteration": "mirag hoi na re mun raaj ihai ||",
      "translation": "All the ascetics saw the arrow and also saw that the sage was seated like a deer",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਕਿਹਾ ਕਿ ਇਹ ਹਿਰਨ ਨਹੀਂ, ਮੁਨੀ ਰਾਜ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "मृग होइ न रे मुनि राज इहै ॥",
      "sourceLineId": "103538",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਹ ਬਾਨ ਸਰਾਸਨ ਪਾਨ ਤਜੇ ॥",
      "transliteration": "neh baan saraasan paan taje ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ) ਉਸ ਨੇ ਹੱਥ ਵਿਚੋਂ ਧਨੁਸ਼ ਬਾਣ ਨਾ ਛਡਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "नह बान सरासन पान तजे ॥",
      "sourceLineId": "103539",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਸ ਦੇਖਿ ਦ੍ਰਿੜੰ ਮੁਨਿ ਰਾਜ ਲਜੇ ॥੩੮੨॥",
      "transliteration": "as dhekh dhiraRa(n) mun raaj laje ||382||",
      "translation": "That person his bow and arrows from his hand and felt ashamed on seeing the resoluteness of the sage.382.",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਅਜਿਹੀ ਦ੍ਰਿੜ੍ਰਹਤਾ ਵੇਖ ਕੇ ਮੁਨੀ ਰਾਜ ਸ਼ਰਮਸਾਰ ਹੋ ਗਏ ॥੩੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "अस देखि दृड़ं मुनि राज लजे ॥३८२॥",
      "sourceLineId": "103540",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਹੁਤੇ ਚਿਰ ਜਿਉ ਤਿਹ ਧ੍ਯਾਨ ਛੁਟਾ ॥",
      "transliteration": "bahute chir jiau teh dhayaan chhuTaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਚਿਰ ਬਾਦ ਜਦੋਂ ਉਸ ਦਾ ਧਿਆਨ ਛੁਟਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "बहुते चिर जिउ तिह ध्यान छुटा ॥",
      "sourceLineId": "103541",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਵਿਲੋਕ ਧਰੇ ਰਿਖਿ ਪਾਲ ਜਟਾ ॥",
      "transliteration": "avilok dhare rikh paal jaTaa ||",
      "translation": "After a long time, when his attention was broken, then he saw the great sage with matted locks",
      "punjabiViakhya": "ਤਾ ਵੇਖਿਆ (ਕਿ ਇਹ) ਜਟਾਵਾ ਦੀ ਪੰਗਤੀ ਵਾਲਾ ਰਿਸ਼ੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "अविलोक धरे रिखि पाल जटा ॥",
      "sourceLineId": "103542",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਸ ਆਵਤ ਹੋ ਡਰੁ ਡਾਰਿ ਅਬੈ ॥",
      "transliteration": "kas aavat ho ddar ddaar abai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਕਿਹਾ, ਤੁਸੀਂ) ਹੁਣ ਡਰ ਨੂੰ ਛਡ ਕੇ ਕਿਸ ਵਾਸਤੇ ਲਗੇ ਆਉਾਂਦੇ ਹੋ;",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "कस आवत हो डरु डारि अबै ॥",
      "sourceLineId": "103543",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮੁਹਿ ਲਾਗਤ ਹੋ ਮ੍ਰਿਗ ਰੂਪ ਸਬੈ ॥੩੮੩॥",
      "transliteration": "muh laagat ho mirag roop sabai ||383||",
      "translation": "He said. “How al of you have come here after relinquishing your fear? I am seeing only the deer everywhere.”383.",
      "punjabiViakhya": "ਮੈਨੂੰ ਤਾ (ਤੁਸੀਂ) ਸਾਰੇ ਹਿਰਨ ਰੂਪ ਹੀ ਲਗਦੇ ਹੋ ॥੩੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "मुहि लागत हो मृग रूप सबै ॥३८३॥",
      "sourceLineId": "103544",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਿਖ ਪਾਲ ਬਿਲੋਕਿ ਤਿਸੈ ਦਿੜਤਾ ॥",
      "transliteration": "rikh paal bilok tisai dhiRataa ||",
      "translation": "",
      "punjabiViakhya": "ਰਿਸ਼ੀਆਂ ਦੇ ਪਾਲਕ (ਦੱਤ) ਨੇ ਉਸ ਦੀ ਇਸ ਦ੍ਰਿੜ੍ਰਹਤਾ ਨੂੰ ਵੇਖ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "रिख पाल बिलोकि तिसै दिड़ता ॥",
      "sourceLineId": "103545",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗੁਰੁ ਮਾਨ ਕਰੀ ਬਹੁਤੈ ਉਪਮਾ ॥",
      "transliteration": "gur maan karee bahutai upamaa ||",
      "translation": "The sage, seeing his resoluteness, and accepting him as his Guru, praised him and said,",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਗੁਰੂ ਮੰਨ ਕੇ ਬਹੁਤ ਸਾਰੀ ਉਪਮਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "गुरु मान करी बहुतै उपमा ॥",
      "sourceLineId": "103546",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮ੍ਰਿਗ ਸੋ ਜਿਹ ਕੋ ਚਿਤ ਐਸ ਲਗ੍ਯੋ ॥",
      "transliteration": "mirag so jeh ko chit aais lagayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਚਿਤ ਹਿਰਨ ਨਾਲ ਇਸ ਤਰ੍ਰਹਾ ਲਗਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "मृग सो जिह को चित ऐस लग्यो ॥",
      "sourceLineId": "103547",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਰਮੇਸਰ ਕੈ ਰਸ ਜਾਨ ਪਗ੍ਰਯੋ ॥੩੮੪॥",
      "transliteration": "paramesar kai ras jaan pagrayo ||384||",
      "translation": "“He, who is so much attentive towards the deer, then think that he is absorbed in the love of the Lord.”384.",
      "punjabiViakhya": "ਮਾਨੋ ਪਰਮੇਸ਼ਵਰ ਦੇ ਪ੍ਰੇਮ ਰਸ ਵਿਚ ਮਗਨ ਹੋਵੇ ॥੩੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "परमेसर कै रस जान पग्रयो ॥३८४॥",
      "sourceLineId": "103548",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮੁਨ ਕੋ ਤਬ ਪ੍ਰੇਮ ਪ੍ਰਸੀਜ ਹੀਆ ॥",
      "transliteration": "mun ko tab prem praseej heeaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਮੁਨੀ ਦਾ ਹਿਰਦਾ ਪ੍ਰੇਮ ਨਾਲ ਪਸੀਜ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "मुन को तब प्रेम प्रसीज हीआ ॥",
      "sourceLineId": "103549",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗੁਰ ਠਾਰਸਮੋ ਮ੍ਰਿਗ ਨਾਸ ਕੀਆ ॥",
      "transliteration": "gur Thaarasamo mirag naas keeaa ||",
      "translation": "The sage accepted him as his eighteenth Guru with his melted heart",
      "punjabiViakhya": "ਅਤੇ ਹਿਰਨ ਨੂੰ ਮਾਰਨ ਵਾਲੇ ਨੂੰ ਅਠਾਰ੍ਰਹਵਾ ਗੁਰੂ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "गुर ठारसमो मृग नास कीआ ॥",
      "sourceLineId": "103550",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਨ ਮੋ ਤਬ ਦਤ ਬੀਚਾਰ ਕੀਆ ॥",
      "transliteration": "man mo tab dhat beechaar keeaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦੱਤ ਨੇ ਮਨ ਵਿਚ ਵਿਚਾਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "मन मो तब दत बीचार कीआ ॥",
      "sourceLineId": "103551",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗੁਨ ਮ੍ਰਿਗਹਾ ਕੋ ਚਿਤ ਬੀਚ ਲੀਆ ॥੩੮੫॥",
      "transliteration": "gun miragahaa ko chit beech leeaa ||385||",
      "translation": "The sage Dutt thoughtfully adopted the qualities of that hunter in his mind.385.",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਿਕਾਰੀ ਦੇ ਗੁਣਾ ਨੂੰ ਮਨ ਵਿਚ ਵਸਾ ਲਿਆ ॥੩੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "गुन मृगहा को चित बीच लीआ ॥३८५॥",
      "sourceLineId": "103552",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹਰਿ ਸੋ ਹਿਤੁ ਜੋ ਇਹ ਭਾਤਿ ਕਰੈ ॥",
      "transliteration": "har so hit jo ieh bhaat karai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਕੋਈ ਹਰਿ ਨਾਲ ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਪ੍ਰੇਮ ਕਰੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "हरि सो हितु जो इह भाति करै ॥",
      "sourceLineId": "103553",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਵ ਭਾਰ ਅਪਾਰਹ ਪਾਰ ਪਰੈ ॥",
      "transliteration": "bhav bhaar apaareh paar parai ||",
      "translation": "He, who will love the Lord in this way, he will ferry across the ocean of existence",
      "punjabiViakhya": "(ਤਾ ਉਹ) ਦੁਸਤਰ ਸੰਸਾਰ ਸਾਗਰ ਨੂੰ ਪਾਰ ਕਰ ਲਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "भव भार अपारह पार परै ॥",
      "sourceLineId": "103554",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਲ ਅੰਤਰਿ ਯਾਹੀ ਇਸਨਾਨ ਕਟੈ ॥",
      "transliteration": "mal a(n)tar yaahee isanaan kaTai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਇਸ਼ਨਾਨ ਨਾਲ ਮਨ ਦੀ ਮੈਲ ਕਟ ਜਾਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "मल अंतरि याही इसनान कटै ॥",
      "sourceLineId": "103555",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਗ ਤੇ ਫਿਰਿ ਆਵਨ ਜਾਨ ਮਿਟੈ ॥੩੮੬॥",
      "transliteration": "jag te fir aavan jaan miTai ||386||",
      "translation": "His dirt will be removed with the inner bath and his transmigration will end in the world.386.",
      "punjabiViakhya": "ਅਤੇ ਸੰਸਾਰ ਵਿਚ ਆਣਾ ਜਾਣਾ ਸਮਾਪਤ ਹੋ ਜਾਦਾ ਹੈ ॥੩੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "जग ते फिरि आवन जान मिटै ॥३८६॥",
      "sourceLineId": "103556",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗੁਰੁ ਜਾਨ ਤਬੈ ਤਿਹ ਪਾਇ ਪਰਾ ॥",
      "transliteration": "gur jaan tabai teh pai paraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਉਸ ਨੂੰ ਗੁਰੂ ਜਾਣ ਕੇ (ਰਿਸ਼ੀ) ਪੈਰੀਂ ਪੈ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "गुरु जान तबै तिह पाइ परा ॥",
      "sourceLineId": "103557",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਵ ਭਾਰ ਅਪਾਰ ਸੁ ਪਾਰ ਤਰਾ ॥",
      "transliteration": "bhav bhaar apaar su paar taraa ||",
      "translation": "Accepting him as his Guru, he fell at his feet and ferried across the dreadful ocean of existence",
      "punjabiViakhya": "ਅਤੇ ਅਪਾਰ ਸੰਸਾਰ ਰੂਪ ਭਾਰੇ ਸਮੁੰਦਰ ਨੂੰ ਪਾਰ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "भव भार अपार सु पार तरा ॥",
      "sourceLineId": "103558",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦਸ ਅਸਟਸਮੋ ਗੁਰੁ ਤਾਸੁ ਕੀਯੋ ॥",
      "transliteration": "dhas asaTasamo gur taas keeyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਅਠਾਰ੍ਰਹਵਾ ਗੁਰੂ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "दस असटसमो गुरु तासु कीयो ॥",
      "sourceLineId": "103559",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਬਿ ਬਾਧਿ ਕਬਿਤਨ ਮਧਿ ਲੀਯੋ ॥੩੮੭॥",
      "transliteration": "kab baadh kabitan madh leeyo ||387||",
      "translation": "He adopted him as his eighteenth Guru and in tthis way, the poet has mentioned the save in verse-form.387.",
      "punjabiViakhya": "ਅਤੇ ਕਵੀ ਨੇ (ਇਸ ਨੂੰ) ਕਬਿੱਤਾ ਵਿਚ ਬੰਨ੍ਰਹ ਲਿਆ ॥੩੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "कबि बाधि कबितन मधि लीयो ॥३८७॥",
      "sourceLineId": "103560",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਬ ਹੀ ਸਿਖ ਸੰਜੁਤਿ ਪਾਨ ਗਹੇ ॥",
      "transliteration": "sab hee sikh sa(n)jut paan gahe ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਹੀ ਸੇਵਕਾ ਸਮੇਤ (ਉਸ ਦੇ) ਪੈਰ ਪਕੜ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "सब ही सिख संजुति पान गहे ॥",
      "sourceLineId": "103561",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਵਿਲੋਕਿ ਚਰਾਚਰਿ ਚਉਧ ਰਹੇ ॥",
      "transliteration": "avilok charaachar chaudh rahe ||",
      "translation": "All the disciples gathered and caught his feet, seeing which all the animate and inanimate beings were startled",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ) ਵੇਖ ਕੇ ਜੜ ਚੇਤਨ ਸਭ ਹੈਰਾਨ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "अविलोकि चराचरि चउध रहे ॥",
      "sourceLineId": "103562",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪਸੁ ਪਛ ਚਰਾਚਰ ਜੀਵ ਸਬੈ ॥",
      "transliteration": "pas pachh charaachar jeev sabai ||",
      "translation": "",
      "punjabiViakhya": "ਪਸ਼ੂ-ਪੰਛੀ ਅਤੇ ਚਰ, ਅਚਰ,",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "पसु पछ चराचर जीव सबै ॥",
      "sourceLineId": "103563",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗਣ ਗੰਧ੍ਰਬ ਭੂਤ ਪਿਸਾਚ ਤਬੈ ॥੩੮੮॥",
      "transliteration": "gan ga(n)dhrab bhoot pisaach tabai ||388||",
      "translation": "All the animals, birds, gandharvas, ghosts, fiends etc. were wonder-struck.388.",
      "punjabiViakhya": "ਗਣ, ਗੰਧਰਬ, ਭੂਤ, ਪਿਸ਼ਾਚ ਆਦਿ ਸਾਰੇ ਜੀਵ ਉਸ ਵੇਲੇ (ਹੈਰਾਨੀ ਦੀ ਅਵਸਥਾ ਵਿਚ ਹੋ ਗਏ) ॥੩੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "गण गंध्रब भूत पिसाच तबै ॥३८८॥",
      "sourceLineId": "103564",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਤਿ ਅਠਦਸਵੋ ਗੁਰੂ ਮ੍ਰਿਗਹਾ ਸਮਾਪਤੰ ॥੧੮॥",
      "transliteration": "eit aThadhasavo guroo miragahaa samaapata(n) ||18||",
      "translation": "End of the description of the adoption of a Hunter as the Eighteenth Guru.",
      "punjabiViakhya": "ਇਥੇ ਅਠਾਰ੍ਰਹਵੇਾਂ ਗੁਰੂ ਸ਼ਿਕਾਰੀ ('ਮ੍ਰਿਗਹਾ') ਦਾ ਪ੍ਰਸੰਗ ਸਮਾਪਤ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "इति अठदसवो गुरू मृगहा समापतं ॥१८॥",
      "sourceLineId": "103565",
      "sourceShabadId": "9365",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਥ ਨਲਨੀ ਸੁਕ ਉਨੀਵੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "transliteration": "ath nalanee suk uneevo guroo kathana(n) ||",
      "translation": "Now begins the description of the adoption of the Parrot as the Ninteenth Guru",
      "punjabiViakhya": "ਹੁਣ ਨਲਨੀ ਸੁਕ ਉਨ੍ਰਹੀਵੇਾਂ ਗੁਰੂ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "अथ नलनी सुक उनीवो गुरू कथनं ॥",
      "sourceLineId": "103566",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕ੍ਰਿਪਾਣ ਕ੍ਰਿਤ ਛੰਦ ॥",
      "transliteration": "kirapaan kirat chha(n)dh ||",
      "translation": "KRIPAN KRIT STANZA",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਣ ਕ੍ਰਿਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "कृपाण कृत छंद ॥",
      "sourceLineId": "103567",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮੁਨਿ ਅਤਿ ਅਪਾਰ ॥",
      "transliteration": "mun at apaar ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਅਪਾਰ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "मुनि अति अपार ॥",
      "sourceLineId": "103568",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗੁਣ ਗਣ ਉਦਾਰ ॥",
      "transliteration": "gun gan udhaar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਦਾਰਤਾ ਦੇ ਗੁਣਾ ਦੇ ਸਮੂਹ ਨੂੰ ਧਾਰਨ ਕਰਨ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "गुण गण उदार ॥",
      "sourceLineId": "103569",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬਿਦਿਆ ਬਿਚਾਰ ॥",
      "transliteration": "bidhiaa bichaar ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਨੀ ਵਿਦਿਆ ਸੰਬੰਧੀ ਨਿੱਤ ਚੰਗੀ ਤਰ੍ਰਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "बिदिआ बिचार ॥",
      "sourceLineId": "103570",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਿਤ ਕਰਤ ਚਾਰ ॥੩੮੯॥",
      "transliteration": "nit karat chaar ||389||",
      "translation": "The sage, benevolent in qualities, was a thinker about learning and always practiced his learning.389.",
      "punjabiViakhya": "ਵਿਚਾਰ ਕਰਦਾ ਹੈ ॥੩੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "नित करत चार ॥३८९॥",
      "sourceLineId": "103571",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਲਖਿ ਛਬਿ ਸੁਰੰਗ ॥",
      "transliteration": "lakh chhab sura(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਸੁੰਦਰ ਛਬੀ ਨੂੰ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "लखि छबि सुरंग ॥",
      "sourceLineId": "103572",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਲਾਜਤ ਅਨੰਗ ॥",
      "transliteration": "laajat ana(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮਦੇਵ ਵੀ ਸ਼ਰਮਿੰਦਾ ਹੋ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "लाजत अनंग ॥",
      "sourceLineId": "103573",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਪਿਖਿ ਬਿਮਲ ਅੰਗ ॥",
      "transliteration": "pikh bimal a(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਸ਼ਰੀਰ ਦੀ ਨਿਰਮਲਤਾ ਨੂੰ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "पिखि बिमल अंग ॥",
      "sourceLineId": "103574",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਚਕਿ ਰਹਤ ਗੰਗ ॥੩੯੦॥",
      "transliteration": "chak rahat ga(n)g ||390||",
      "translation": "Seeing his beauty, the god of love felt shy and seeing the purity of his limabs, the Ganges was wonder-struck.390.",
      "punjabiViakhya": "ਗੰਗਾ ਵੀ ਹੈਰਾਨ ਸੀ ॥੩੯੦॥",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "चकि रहत गंग ॥३९०॥",
      "sourceLineId": "103575",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਲਖਿ ਦੁਤਿ ਅਪਾਰ ॥",
      "transliteration": "lakh dhut apaar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਅਪਾਰ ਚਮਕ ਨੂੰ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "लखि दुति अपार ॥",
      "sourceLineId": "103576",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਰੀਝਤ ਕੁਮਾਰ ॥",
      "transliteration": "reejhat kumaar ||",
      "translation": "Seeing his comeliness all the princes felt pleased,",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰ ਵੀ ਰੀਝ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "रीझत कुमार ॥",
      "sourceLineId": "103577",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਗ੍ਯਾਨੀ ਅਪਾਰ ॥",
      "transliteration": "gayaanee apaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਅਪਾਰ ਗਿਆਨਵਾਨ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "ग्यानी अपार ॥",
      "sourceLineId": "103578",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਗੁਨ ਗਨ ਉਦਾਰ ॥੩੯੧॥",
      "transliteration": "gun gan udhaar ||391||",
      "translation": "Because he was the greatest scholar and generous and accomplished person.391.",
      "punjabiViakhya": "ਅਤੇ ਉਦਾਰਤਾ ਜਿਹੇ ਗੁਣ ਦਾ ਸਮੁੱਚ ਸੀ ॥੩੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "गुन गन उदार ॥३९१॥",
      "sourceLineId": "103579",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਅਬਯਕਤ ਅੰਗ ॥",
      "transliteration": "abayakat a(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਅਪ੍ਰਤੱਖ ਸ਼ਰੀਰ ਦੀ ਚਮਕ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "अबयकत अंग ॥",
      "sourceLineId": "103580",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਆਭਾ ਅਭੰਗ ॥",
      "transliteration": "aabhaa abha(n)g ||",
      "translation": "The glory of his limbs was indescribable",
      "punjabiViakhya": "ਕਦੇ ਭੰਗ ਹੋਣ ਵਾਲੀ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "आभा अभंग ॥",
      "sourceLineId": "103581",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਸੋਭਾ ਸੁਰੰਗ ॥",
      "transliteration": "sobhaa sura(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸ਼ੋਭਾ ਬਹੁਤ ਸੁੰਦਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "सोभा सुरंग ॥",
      "sourceLineId": "103582",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਤਨ ਜਨੁ ਅਨੰਗ ॥੩੯੨॥",
      "transliteration": "tan jan ana(n)g ||392||",
      "translation": "He was pretty like the god of love.392.",
      "punjabiViakhya": "ਮਾਨੋ ਕਾਮਦੇਵ ਨੇ ਹੀ ਸ਼ਰੀਰ ਧਾਰਨ ਕੀਤਾ ਹੋਵੇ ॥੩੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "तन जनु अनंग ॥३९२॥",
      "sourceLineId": "103583",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਬਹੁ ਕਰਤ ਨ੍ਯਾਸ ॥",
      "transliteration": "bahu karat nayaas ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਯੋਗ ਸਾਧਨਾ ਕਰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "बहु करत न्यास ॥",
      "sourceLineId": "103584",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਨਿਸਿ ਦਿਨ ਉਦਾਸ ॥",
      "transliteration": "nis dhin udhaas ||",
      "translation": "He performed many practices detachedly night and day and",
      "punjabiViakhya": "ਦਿਨ ਰਾਤ ਉਦਾਸ (ਨਿਰਲਿਪਤ) ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "निसि दिन उदास ॥",
      "sourceLineId": "103585",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਤਜਿ ਸਰਬ ਆਸ ॥",
      "transliteration": "taj sarab aas ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਆਸ਼ਾਵਾ ਨੂੰ ਛਡ ਦੇਣ ਨਾਲ (ਉਸ ਦੀ) ਬੁੱਧੀ ਵਿਚ ਗਿਆਨ ਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "तजि सरब आस ॥",
      "sourceLineId": "103586",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਅਤਿ ਬੁਧਿ ਪ੍ਰਕਾਸ ॥੩੯੩॥",
      "transliteration": "at budh prakaas ||393||",
      "translation": "Had relinquished all the desires because of the unfoldment of knowledge.393.",
      "punjabiViakhya": "ਬਹੁਤ ਅਧਿਕ ਪ੍ਰਕਾਸ਼ ਹੋ ਗਿਆ ਸੀ ॥੩੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "अति बुधि प्रकास ॥३९३॥",
      "sourceLineId": "103587",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਤਨਿ ਸਹਤ ਧੂਪ ॥",
      "transliteration": "tan sahat dhoop ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਨਿਆਸੀਆਂ ਦਾ ਰਾਜਾ (ਦੱਤ) ਆਪਣੇ ਉਪਰ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "तनि सहत धूप ॥",
      "sourceLineId": "103588",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਸੰਨ੍ਯਾਸ ਭੂਪ ॥",
      "transliteration": "sa(n)nayaas bhoop ||",
      "translation": "The sage Dutt, the king of Sannyas looked very beautiful like Shiva,",
      "punjabiViakhya": "ਧੁਪ ਨੂੰ ਸਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "संन्यास भूप ॥",
      "sourceLineId": "103589",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਤਨਿ ਛਬਿ ਅਨੂਪ ॥",
      "transliteration": "tan chhab anoop ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਸ਼ਰੀਰ ਦੀ ਛਬੀ ਬਹੁਤ ਅਨੂਪ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "तनि छबि अनूप ॥",
      "sourceLineId": "103590",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਜਨੁ ਸਿਵ ਸਰੂਪ ॥੩੯੪॥",
      "transliteration": "jan siv saroop ||394||",
      "translation": "While enduring the sunshine on his body, allied with unique comeliness.394.",
      "punjabiViakhya": "ਮਾਨੋ ਸ਼ਿਵ ਦਾ ਹੀ ਸਰੂਪ ਹੋਵੇ ॥੩੯੪॥",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "जनु सिव सरूप ॥३९४॥",
      "sourceLineId": "103591",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਮੁਖ ਛਬਿ ਪ੍ਰਚੰਡ ॥",
      "transliteration": "mukh chhab pracha(n)dd ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਮੁਖ ਉਤੇ ਪ੍ਰਚੰਡ ਛਬੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "मुख छबि प्रचंड ॥",
      "sourceLineId": "103592",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਆਭਾ ਅਭੰਗ ॥",
      "transliteration": "aabhaa abha(n)g ||",
      "translation": "The beauty of his limbs and face was perfect and",
      "punjabiViakhya": "ਅਤੇ ਨਾ ਭੰਗ ਹੋਣ ਵਾਲੀ ਆਭਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "आभा अभंग ॥",
      "sourceLineId": "103593",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0666_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਜੁਟਿ ਜੋਗ ਜੰਗ ॥",
      "transliteration": "juT jog ja(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਗ-ਸਾਧਨਾ ('ਜੰਗ') ਵਿਚ ਜੁਟਿਆ ਹੋਇਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 666,
      "hindi": "",
      "hindiTransliteration": "जुटि जोग जंग ॥",
      "sourceLineId": "103594",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
