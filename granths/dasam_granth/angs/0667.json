{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 667,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0667_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਹੀ ਮੁਰਤ ਅੰਗ ॥੩੯੫॥",
      "transliteration": "nahee murat a(n)g ||395||",
      "translation": "Powerful his limbs, practising Yoga, did not bend.395.",
      "punjabiViakhya": "ਅਤੇ (ਇਸ ਕਰਮਾਚਾਰ ਤੋਂ) ਅੰਗ ਨਹੀਂ ਮੋੜਦਾ ਸੀ ॥੩੯੫॥",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "नही मुरत अंग ॥३९५॥",
      "sourceLineId": "103595",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਤਿ ਛਬਿ ਪ੍ਰਕਾਸ ॥",
      "transliteration": "at chhab prakaas ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਛਬੀ ਦਾ ਬਹੁਤ ਪ੍ਰਕਾਸ਼ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "अति छबि प्रकास ॥",
      "sourceLineId": "103596",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਿਸਿ ਦਿਨ ਨਿਰਾਸ ॥",
      "transliteration": "nis dhin niraas ||",
      "translation": "Through extremely comely, he remained desireless night and day",
      "punjabiViakhya": "ਰਾਤ ਦਿਨ ਆਸ ਤੋਂ ਪਰੇ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "निसि दिन निरास ॥",
      "sourceLineId": "103597",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮੁਨਿ ਮਨ ਸੁਬਾਸ ॥",
      "transliteration": "mun man subaas ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਨੀ ਦਾ ਮਨ ਸੁਗੰਧ ਯੁਕਤ ਸੀ (ਅਰਥਾਤ ਚੰਗੀ ਭਾਵਨਾ ਵਾਲਾ ਸੀ)।",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "मुनि मन सुबास ॥",
      "sourceLineId": "103598",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗੁਨ ਗਨ ਉਦਾਸ ॥੩੯੬॥",
      "transliteration": "gun gan udhaas ||396||",
      "translation": "And adopting the qualities, the sage lived detachedly.396.",
      "punjabiViakhya": "ਉਹ ਵੈਰਾਗ ('ਉਦਾਸ') ਦਾ ਪੁੰਜ ਸੀ ॥੩੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "गुन गन उदास ॥३९६॥",
      "sourceLineId": "103599",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਬਯਕਤ ਜੋਗ ॥",
      "transliteration": "abayakat jog ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਯੋਗ ਅਕਥਨੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "अबयकत जोग ॥",
      "sourceLineId": "103600",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਹੀ ਕਉਨ ਸੋਗ ॥",
      "transliteration": "nahee kaun sog ||",
      "translation": "Being absorbed in unexpressible Yoga, he was far away from all foundnesses",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਕੋਈ ਵੀ ਸੋਗ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "नही कउन सोग ॥",
      "sourceLineId": "103601",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਿਤਪ੍ਰਤਿ ਅਰੋਗ ॥",
      "transliteration": "nitaprat arog ||",
      "translation": "",
      "punjabiViakhya": "ਨਿੱਤ ਪ੍ਰਤਿ ਰੋਗ ਤੋਂ ਰਹਿਤ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "नितप्रति अरोग ॥",
      "sourceLineId": "103602",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਜਿ ਰਾਜ ਭੋਗ ॥੩੯੭॥",
      "transliteration": "taj raaj bhog ||397||",
      "translation": "Even on forsaking all the royal luxuries, he always remained healthy.397.",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ-ਭੋਗ ਨੂੰ ਛੱਡ ਦਿੱਤਾ ਸੀ ॥੩੯੭॥",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "तजि राज भोग ॥३९७॥",
      "sourceLineId": "103603",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮੁਨ ਮਨਿ ਕ੍ਰਿਪਾਲ ॥",
      "transliteration": "mun man kirapaal ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਨੀ ਕ੍ਰਿਪਾਲੂ ਮਨ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "मुन मनि कृपाल ॥",
      "sourceLineId": "103604",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗੁਨ ਗਨ ਦਿਆਲ ॥",
      "transliteration": "gun gan dhiaal ||",
      "translation": "That kind sage, was allied with qualities",
      "punjabiViakhya": "ਅਤੇ ਦਿਆਲਤਾ ਦੇ ਗੁਣਾ ਦੇ ਸਮੂਹ ਵਾਲਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "गुन गन दिआल ॥",
      "sourceLineId": "103605",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੁਭਿ ਮਤਿ ਸੁਢਾਲ ॥",
      "transliteration": "subh mat suddaal ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਅਤੇ ਸ਼ੁਭ ਮਤ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "सुभि मति सुढाल ॥",
      "sourceLineId": "103606",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦ੍ਰਿੜ ਬ੍ਰਿਤ ਕਰਾਲ ॥੩੯੮॥",
      "transliteration": "dhiraR birat karaal ||398||",
      "translation": "He was a man of good intellect, a resolute vow-observer and merciful.398.",
      "punjabiViakhya": "ਅਤੇ ਦ੍ਰਿੜ੍ਰਹ ਅਤੇ ਕਠੋਰ ਬਿਰਤੀ ਵਾਲਾ ਸੀ ॥੩੯੮॥",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "दृड़ बृत कराल ॥३९८॥",
      "sourceLineId": "103607",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਨ ਸਹਤ ਸੀਤ ॥",
      "transliteration": "tan sahat seet ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸ਼ਰੀਰ ਉਤੇ ਠੰਡ ਸਹਾਰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "तन सहत सीत ॥",
      "sourceLineId": "103608",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਹੀ ਮੁਰਤ ਚੀਤ ॥",
      "transliteration": "nahee murat cheet ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਅਜਿਹਾ ਕਰਨ ਤੋਂ) ਉਸ ਦਾ ਮਨ ਮੁੜਦਾ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "नही मुरत चीत ॥",
      "sourceLineId": "103609",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਹੁ ਬਰਖ ਬੀਤ ॥",
      "transliteration": "bahu barakh beet ||",
      "translation": "",
      "punjabiViakhya": "(ਅਜਿਹਾ ਕਰਦਿਆਂ) ਬਹੁਤ ਵਰ੍ਰਹੇ ਬੀਤ ਗਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "बहु बरख बीत ॥",
      "sourceLineId": "103610",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਨੁ ਜੋਗ ਜੀਤ ॥੩੯੯॥",
      "transliteration": "jan jog jeet ||399||",
      "translation": "Enduring coldness on his body, his mind never got impaired and in this way after many years, he had been victorious in Yogs.399.",
      "punjabiViakhya": "ਮਾਨੋ ਉਸ ਨੇ ਯੋਗ ਨੂੰ ਹੀ ਜਿਤ ਲਿਆ ਹੋਵੇ ॥੩੯੯॥",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "जनु जोग जीत ॥३९९॥",
      "sourceLineId": "103611",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚਾਲੰਤ ਬਾਤ ॥",
      "transliteration": "chaala(n)t baat ||",
      "translation": "",
      "punjabiViakhya": "ਹਵਾ ਦੇ ਚਲਣ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "चालंत बात ॥",
      "sourceLineId": "103612",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਥਰਕੰਤ ਪਾਤ ॥",
      "transliteration": "tharaka(n)t paat ||",
      "translation": "When that Yogi talked, the leaves of the trees swerved",
      "punjabiViakhya": "ਪੱਤਰ ਥਰ ਥਰ ਕੰਬਣ ਲਗਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "थरकंत पात ॥",
      "sourceLineId": "103613",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪੀਅਰਾਤ ਗਾਤ ॥",
      "transliteration": "peearaat gaat ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਰੀਰ ਪੀਲਾ ਪੈ ਗਿਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "पीअरात गात ॥",
      "sourceLineId": "103614",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਹੀ ਬਦਤ ਬਾਤ ॥੪੦੦॥",
      "transliteration": "nahee badhat baat ||400||",
      "translation": "And knowing the attributes of the Lord, he did not disclose anything to others.400.",
      "punjabiViakhya": "(ਮੂੰਹੋਂ) ਗੱਲ ਕਹੀ ਨਹੀਂ ਜਾ ਸਕਦੀ ਸੀ ॥੪੦੦॥",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "नही बदत बात ॥४००॥",
      "sourceLineId": "103615",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਭੰਗੰ ਭਛੰਤ ॥",
      "transliteration": "bha(n)ga(n) bhachha(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਭੰਗ ਖਾਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "भंगं भछंत ॥",
      "sourceLineId": "103616",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਾਛੀ ਕਛੰਤ ॥",
      "transliteration": "kaachhee kachha(n)t ||",
      "translation": "He used to drink hemp, roamed here and there blew his horn and",
      "punjabiViakhya": "(ਯੋਗ ਦੇ) ਭੇਸ ਧਾਰਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "काछी कछंत ॥",
      "sourceLineId": "103617",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਿੰਗ੍ਰੀ ਬਜੰਤ ॥",
      "transliteration": "ki(n)gree baja(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਕਿੰਗਰੀ ਵਜਾਉਾਂਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "किंग्री बजंत ॥",
      "sourceLineId": "103618",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭਗਵਤ ਭਨੰਤ ॥੪੦੧॥",
      "transliteration": "bhagavat bhana(n)t ||401||",
      "translation": "Remained absorbed in the meditation of the Lord.401.",
      "punjabiViakhya": "ਭਗਵਾਨ ਦੇ ਗੁਣ ਗਾਉਾਂਦੇ ਸਨ ॥੪੦੧॥",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "भगवत भनंत ॥४०१॥",
      "sourceLineId": "103619",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਹੀ ਡੁਲਤ ਅੰਗ ॥",
      "transliteration": "nahee ddulat a(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਮੁਨੀ ਦਾ) ਸ਼ਰੀਰ ਡੋਲਦਾ ਨਹੀਂ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "नही डुलत अंग ॥",
      "sourceLineId": "103620",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮੁਨਿ ਮਨ ਅਭੰਗ ॥",
      "transliteration": "mun man abha(n)g ||",
      "translation": "His limbs and mind both remained stable",
      "punjabiViakhya": "ਮੁਨੀ ਦਾ ਮਨ ਭੰਗ ਹੋਣ ਵਾਲਾ ਨਹੀਂ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "मुनि मन अभंग ॥",
      "sourceLineId": "103621",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜੁਟਿ ਜੋਗ ਜੰਗ ॥",
      "transliteration": "juT jog ja(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਗ ਦੀ ਜੰਗ ਵਿਚ ਜੁਟਿਆ ਹੋਇਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "जुटि जोग जंग ॥",
      "sourceLineId": "103622",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਿਮਿ ਉਡਤ ਚੰਗ ॥੪੦੨॥",
      "transliteration": "jim uddat cha(n)g ||402||",
      "translation": "Absorbed in meditation, he remained engrossed in the practice of Yoga.402.",
      "punjabiViakhya": "ਜਿਵੇਾਂ (ਆਕਾਸ਼ ਅੰਦਰ) ਗੁਡੀ ਉਡਦੀ ਹੈ ॥੪੦੨॥",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "जिमि उडत चंग ॥४०२॥",
      "sourceLineId": "103623",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਹੀ ਕਰਤ ਹਾਇ ॥",
      "transliteration": "nahee karat hai ||",
      "translation": "",
      "punjabiViakhya": "ਤਪ ਨੂੰ ਚਾਉ ਨਾਲ ਕਰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "नही करत हाइ ॥",
      "sourceLineId": "103624",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਪ ਕਰਤ ਚਾਇ ॥",
      "transliteration": "tap karat chai ||",
      "translation": "While performing austerities, he never felt any suffering",
      "punjabiViakhya": "(ਤਪ ਦੇ ਔਖ ਕਾਰਨ ਕਦੇ) ਹਾਇ ਤਕ ਨਹੀਂ ਉਚਾਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "तप करत चाइ ॥",
      "sourceLineId": "103625",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਿਤਪ੍ਰਤਿ ਬਨਾਇ ॥",
      "transliteration": "nitaprat banai ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਪ੍ਰੇਮ ਨਾਲ ਹਰ ਰੋਜ਼",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "नितप्रति बनाइ ॥",
      "sourceLineId": "103626",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਹੁ ਭਗਤ ਭਾਇ ॥੪੦੩॥",
      "transliteration": "bahu bhagat bhai ||403||",
      "translation": "And being absorbed in various types of devotional ideas, he always remained engrossed in devotion.403.",
      "punjabiViakhya": "ਭਗਤੀ ਕਰਦਾ ਸੀ ॥੪੦੩॥",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "बहु भगत भाइ ॥४०३॥",
      "sourceLineId": "103627",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮੁਖ ਭਛਤ ਪਉਨ ॥",
      "transliteration": "mukh bhachhat paun ||",
      "translation": "",
      "punjabiViakhya": "ਮੂੰਹ ਨਾਲ ਹਵਾ ਭਖਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "मुख भछत पउन ॥",
      "sourceLineId": "103628",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਜਿ ਧਾਮ ਗਉਨ ॥",
      "transliteration": "taj dhaam gaun ||",
      "translation": "These sages, who relinquished their homes,",
      "punjabiViakhya": "ਘਰ ਨੂੰ ਜਾਣਾ ਛਡ ਦਿੱਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "तजि धाम गउन ॥",
      "sourceLineId": "103629",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮੁਨਿ ਰਹਤ ਮਉਨ ॥",
      "transliteration": "mun rahat maun ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਨੀ ਚੁਪ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "मुनि रहत मउन ॥",
      "sourceLineId": "103630",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੁਭ ਰਾਜ ਭਉਨ ॥੪੦੪॥",
      "transliteration": "subh raaj bhaun ||404||",
      "translation": "Subsisted on air and remained silent.404.",
      "punjabiViakhya": "(ਇਹੀ ਉਸ ਦਾ) ਸ਼ੁਭ ਰਾਜ ਭਵਨ ਸੀ ॥੪੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "सुभ राज भउन ॥४०४॥",
      "sourceLineId": "103631",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੰਨ੍ਯਾਸ ਦੇਵ ॥",
      "transliteration": "sa(n)nayaas dhev ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਸੰਨਿਆਸ ਦੇਵ ਮੁਨੀ ਦੇ ਮਨ ਦਾ ਭੇਦ",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "संन्यास देव ॥",
      "sourceLineId": "103632",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮੁਨਿ ਮਨ ਅਭੇਵ ॥",
      "transliteration": "mun man abhev ||",
      "translation": "These sages, supreme amongst Sannyasis understood the internal mysteries",
      "punjabiViakhya": "ਨਹੀਂ ਪਾਇਆ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "मुनि मन अभेव ॥",
      "sourceLineId": "103633",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਨਜੁਰਿ ਅਜੇਵ ॥",
      "transliteration": "anajur ajev ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬੁਢਾਪੇ ਤੋਂ ਰਹਿਤ ਅਤੇ ਨਾ ਜਿਤੇ ਜਾ ਸਕਣ ਵਾਲਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "अनजुरि अजेव ॥",
      "sourceLineId": "103634",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅੰਤਰਿ ਅਤੇਵ ॥੪੦੫॥",
      "transliteration": "a(n)tar atev ||405||",
      "translation": "They were the age with mysterious mind.405.",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਹਿਰਦਾ ਬਹੁਤ ਵੱਡਾ ਹੈ (ਅਥਵਾ ਅਡੋਲ ਸੀ) ॥੪੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "अंतरि अतेव ॥४०५॥",
      "sourceLineId": "103635",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਨਭੂ ਪ੍ਰਕਾਸ ॥",
      "transliteration": "anabhoo prakaas ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੁਭਵ ਦੁਆਰਾ ਪ੍ਰਕਾਸ਼ਮਾਨ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "अनभू प्रकास ॥",
      "sourceLineId": "103636",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਿਤਪ੍ਰਤਿ ਉਦਾਸ ॥",
      "transliteration": "nitaprat udhaas ||",
      "translation": "They felt the inner Light and remained detached",
      "punjabiViakhya": "ਸਦਾ ਉਦਾਸ (ਵਿਰਕਤ) ਰਹਿੰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "नितप्रति उदास ॥",
      "sourceLineId": "103637",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗੁਨ ਅਧਿਕ ਜਾਸ ॥",
      "transliteration": "gun adhik jaas ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਵਿਚ) ਬਹੁਤ ਅਧਿਕ ਗੁਣ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "गुन अधिक जास ॥",
      "sourceLineId": "103638",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਲਖਿ ਲਜਤ ਅਨਾਸ ॥੪੦੬॥",
      "transliteration": "lakh lajat anaas ||406||",
      "translation": "They were full of virues and were no prone to destruction.406.",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਵੇਖ ਕੇ ਆਸ ਮੁਕਤ ਵੀ ਸ਼ਰਮਸਾਰ ਹੁੰਦਾ ਸੀ ॥੪੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "लखि लजत अनास ॥४०६॥",
      "sourceLineId": "103639",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬ੍ਰਹਮੰਨ ਦੇਵ ॥",
      "transliteration": "brahama(n)n dhev ||",
      "translation": "",
      "punjabiViakhya": "ਰਿਸ਼ੀਆਂ ਦਾ ਮੁਖੀ (ਦੱਤ) ਸਮੂਹ ਗੁਣਾ ਵਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "ब्रहमंन देव ॥",
      "sourceLineId": "103640",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗੁਨ ਗਨ ਅਭੇਵ ॥",
      "transliteration": "gun gan abhev ||",
      "translation": "They were adorable for Brahmins, and masters of mysterious qualities",
      "punjabiViakhya": "ਅਤੇ ਭੇਦ ਤੋਂ ਪਰੇ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "गुन गन अभेव ॥",
      "sourceLineId": "103641",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0667_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦੇਵਾਨ ਦੇਵ ॥",
      "transliteration": "dhevaan dhev ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਦੇਵਤਿਆਂ ਦਾ ਵੀ ਦੇਵਤਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 667,
      "hindi": "",
      "hindiTransliteration": "देवान देव ॥",
      "sourceLineId": "103642",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
