{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 668,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0668_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਨਭਿਖ ਅਜੇਵ ॥੪੦੭॥",
      "transliteration": "anabhikh ajev ||407||",
      "translation": "They were god of gods, who never begged alms etc.407.",
      "punjabiViakhya": "ਅਤੇ ਭੇਖ ਤੋਂ ਰਹਿਤ ਅਤੇ ਅਜਿਤ ਸੀ ॥੪੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "अनभिख अजेव ॥४०७॥",
      "sourceLineId": "103643",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੰਨਿਆਸ ਨਾਥ ॥",
      "transliteration": "sa(n)niaas naath ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਨਿਆਸ ਦਾ ਸੁਆਮੀ,",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "संनिआस नाथ ॥",
      "sourceLineId": "103644",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਨਧਰ ਪ੍ਰਮਾਥ ॥",
      "transliteration": "anadhar pramaath ||",
      "translation": "They were masters of Sannyasis and supremely mighty people",
      "punjabiViakhya": "ਆਧਾਰ ਰਹਿਤ ਅਤੇ ਮਿਧਣ ਵਾਲਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "अनधर प्रमाथ ॥",
      "sourceLineId": "103645",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਕ ਰਟਤ ਗਾਥ ॥",
      "transliteration": "eik raTat gaath ||",
      "translation": "",
      "punjabiViakhya": "ਇਕੋ ਵਾਰਤਾ ਰਟਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "इक रटत गाथ ॥",
      "sourceLineId": "103646",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਟਕ ਏਕ ਸਾਥ ॥੪੦੮॥",
      "transliteration": "Tak ek saath ||408||",
      "translation": "Someone talked about their story and someone walked with them.408.",
      "punjabiViakhya": "ਇਕ ਟਕ ਵੇਖਦਾ ਸੀ ॥੪੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "टक एक साथ ॥४०८॥",
      "sourceLineId": "103647",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗੁਨ ਗਨਿ ਅਪਾਰ ॥",
      "transliteration": "gun gan apaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਦਾਰ ਮਨ ਵਾਲਾ ਮੁਨੀ",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "गुन गनि अपार ॥",
      "sourceLineId": "103648",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮੁਨਿ ਮਨਿ ਉਦਾਰ ॥",
      "transliteration": "mun man udhaar ||",
      "translation": "These gentle sages were masters of infinite qualities",
      "punjabiViakhya": "ਗੁਣਾ ਦੇ ਸਮੂਹ ਵਾਲਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "मुनि मनि उदार ॥",
      "sourceLineId": "103649",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੁਭ ਮਤਿ ਸੁਢਾਰ ॥",
      "transliteration": "subh mat suddaar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਬੁੱਧੀ ਸੁੰਦਰ ਸਰੂਪ ਵਾਲੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "सुभ मति सुढार ॥",
      "sourceLineId": "103650",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬੁਧਿ ਕੋ ਪਹਾਰ ॥੪੦੯॥",
      "transliteration": "budh ko pahaar ||409||",
      "translation": "They were persons of good intellect and stores of wisdom..409.",
      "punjabiViakhya": "(ਮਾਨੋ) ਬੁੱਧੀ ਦਾ ਪਹਾੜ ਹੋਵੇ ॥੪੦੯॥",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "बुधि को पहार ॥४०९॥",
      "sourceLineId": "103651",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੰਨਿਆਸ ਭੇਖ ॥",
      "transliteration": "sa(n)niaas bhekh ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਨਿਆਸ ਭੇਖ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "संनिआस भेख ॥",
      "sourceLineId": "103652",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਨਿਬਿਖ ਅਦ੍ਵੈਖ ॥",
      "transliteration": "anibikh adhavaikh ||",
      "translation": "These sages in the garb of Sannyasis, were without malice and",
      "punjabiViakhya": "ਵਿਸ਼ਿਆਂ ਤੋਂ ਰਹਿਤ ਅਤੇ ਦ੍ਵੈਸ਼ਭਾਵ ਤੋਂ ਮੁਕਤ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "अनिबिख अद्वैख ॥",
      "sourceLineId": "103653",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਾਪਤ ਅਭੇਖ ॥",
      "transliteration": "jaapat abhekh ||",
      "translation": "",
      "punjabiViakhya": "ਭੇਖ ਤੋਂ ਰਹਿਤ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "जापत अभेख ॥",
      "sourceLineId": "103654",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬ੍ਰਿਧ ਬੁਧਿ ਅਲੇਖ ॥੪੧੦॥",
      "transliteration": "biradh budh alekh ||410||",
      "translation": "Remembering that Lord, were merged (absorbed) in that Great, wise and unrealizable Lord.410.",
      "punjabiViakhya": "ਵੱਡੀ ਬੁੱਧੀ ਵਾਲਾ ਲੇਖੇ ਤੋਂ ਬਾਹਰ ਸੀ ॥੪੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "बृध बुधि अलेख ॥४१०॥",
      "sourceLineId": "103655",
      "sourceShabadId": "9366",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕੁਲਕ ਛੰਦ ॥",
      "transliteration": "kulak chha(n)dh ||",
      "translation": "KULAK STANZA",
      "punjabiViakhya": "ਕੁਲਕ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "कुलक छंद ॥",
      "sourceLineId": "103656",
      "sourceShabadId": "9367",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਧੰ ਧਕਿਤ ਇੰਦ ॥",
      "transliteration": "dha(n) dhakit i(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਇੰਦਰ (ਦਾ ਹਿਰਦਾ) ਧੜਕਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "धं धकित इंद ॥",
      "sourceLineId": "103657",
      "sourceShabadId": "9367",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚੰ ਚਕਿਤ ਚੰਦ ॥",
      "transliteration": "cha(n) chakit cha(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਦ੍ਰਮਾ ਹੈਰਾਨ ਹੁੰਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "चं चकित चंद ॥",
      "sourceLineId": "103658",
      "sourceShabadId": "9367",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਥੰ ਥਕਤ ਪਉਨ ॥",
      "transliteration": "tha(n) thakat paun ||",
      "translation": "",
      "punjabiViakhya": "ਹਵਾ ਥਕ ਰਹੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "थं थकत पउन ॥",
      "sourceLineId": "103659",
      "sourceShabadId": "9367",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਭੰ ਭਜਤ ਮਉਨ ॥੪੧੧॥",
      "transliteration": "bha(n) bhajat maun ||411||",
      "translation": "Indra, moon-god and wind-god silently remembered the Lord.411.",
      "punjabiViakhya": "(ਇਸ ਲਈ) ਚੁਪ ਕਰ ਰਹੀ ਹੈ ॥੪੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "भं भजत मउन ॥४११॥",
      "sourceLineId": "103660",
      "sourceShabadId": "9367",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜੰ ਜਕਿਤ ਜਛ ॥",
      "transliteration": "ja(n) jakit jachh ||",
      "translation": "",
      "punjabiViakhya": "ਯਕਸ਼ ਠਠੰਬਰ ਗਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "जं जकित जछ ॥",
      "sourceLineId": "103661",
      "sourceShabadId": "9367",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪੰ ਪਚਤ ਪਛ ॥",
      "transliteration": "pa(n) pachat pachh ||",
      "translation": "",
      "punjabiViakhya": "ਪੰਛੀ ਖਪਤ ('ਪਚਤ') ਹੋ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "पं पचत पछ ॥",
      "sourceLineId": "103662",
      "sourceShabadId": "9367",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਧੰ ਧਕਤ ਸਿੰਧੁ ॥",
      "transliteration": "dha(n) dhakat si(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਸਮੁੰਦਰ ਧੜਕ ਰਿਹਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "धं धकत सिंधु ॥",
      "sourceLineId": "103663",
      "sourceShabadId": "9367",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬੰ ਬਕਤ ਬਿੰਧ ॥੪੧੨॥",
      "transliteration": "ba(n) bakat bi(n)dh ||412||",
      "translation": "The Yakshas, birds and oceans wer raising tumult in astonishment.412.",
      "punjabiViakhya": "ਵਿੰਧਿਆਚਲ ਸ਼ੋਰ ਪਾ ਰਿਹਾ ਹੈ ॥੪੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "बं बकत बिंध ॥४१२॥",
      "sourceLineId": "103664",
      "sourceShabadId": "9367",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੰ ਸਕਤ ਸਿੰਧੁ ॥",
      "transliteration": "sa(n) sakat si(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਸਮੁੰਦਰ ਸੁਕੜ ਗਿਆ ਹੈ (ਅਥਵਾ ਸੰਸੇ ਵਿਚ ਪੈ ਗਿਆ ਹੈ)",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "सं सकत सिंधु ॥",
      "sourceLineId": "103665",
      "sourceShabadId": "9367",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗੰ ਗਕਤ ਗਿੰਧ ॥",
      "transliteration": "ga(n) gakat gi(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਦਿਗਜ ਹਾਥੀ ('ਗਿੰਧ') ਚਿੰਘਾੜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "गं गकत गिंध ॥",
      "sourceLineId": "103666",
      "sourceShabadId": "9367",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤੰ ਤਕਤ ਦੇਵ ॥",
      "transliteration": "ta(n) takat dhev ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤੇ ਇਕ-ਟਕ ਵੇਖਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "तं तकत देव ॥",
      "sourceLineId": "103667",
      "sourceShabadId": "9367",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅੰ ਅਕਤ ਭੇਵ ॥੪੧੩॥",
      "transliteration": "a(n) akat bhev ||413||",
      "translation": "The sea alongwith his powers was visualizing that God of gods and mysterious Lord.413.",
      "punjabiViakhya": "ਭੇਦ ਨਾ ਮਿਲਣ ਕਾਰਨ ਅਕ ਗਏ ਹਨ ॥੪੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "अं अकत भेव ॥४१३॥",
      "sourceLineId": "103668",
      "sourceShabadId": "9367",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਲੰ ਲਖਤ ਜੋਗਿ ॥",
      "transliteration": "la(n) lakhat jog ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਗ ਨੂੰ ਵੇਖ ਕੇ ਭੋਗ ਕਰਨ ਵਾਲੇ (ਸੰਸਾਰੀ ਲੋਗ)",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "लं लखत जोगि ॥",
      "sourceLineId": "103669",
      "sourceShabadId": "9367",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭੰ ਭ੍ਰਮਤ ਭੋਗਿ ॥",
      "transliteration": "bha(n) bhramat bhog ||",
      "translation": "",
      "punjabiViakhya": "ਹੈਰਾਨ ਹੋ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "भं भ्रमत भोगि ॥",
      "sourceLineId": "103670",
      "sourceShabadId": "9367",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬੰ ਬਕਤ ਬੈਨ ॥",
      "transliteration": "ba(n) bakat bain ||",
      "translation": "",
      "punjabiViakhya": "ਬਚਨ ਬੋਲਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 668,
      "hindi": "",
      "hindiTransliteration": "बं बकत बैन ॥",
      "sourceLineId": "103671",
      "sourceShabadId": "9367",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0668_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚੰ ਚਕਤ ਨੈਨ ॥੪੧੪॥",
