{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 669,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0669_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦਲਿਤੰ ਭੋਗੰ ॥",
      "transliteration": "dhalita(n) bhoga(n) ||",
      "translation": "These Yogis who had been immersed in Yoga and who had withdrawn from all enjoyments,",
      "punjabiViakhya": "ਭੋਗਾ ਨੂੰ ਦਲ ਸੁਟਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "दलितं भोगं ॥",
      "sourceLineId": "103691",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਭਗਿਵੇ ਭੇਸੰ ॥",
      "transliteration": "bhagive bhesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭਗਵੇ ਬਸਤ੍ਰ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "भगिवे भेसं ॥",
      "sourceLineId": "103692",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੁਫਿਲੇ ਦੇਸੰ ॥੪੧੯॥",
      "transliteration": "sufile dhesa(n) ||419||",
      "translation": "Had been wearing the ochre-colored clothes of various countries. 419.",
      "punjabiViakhya": "ਸਫਲ ਸ਼ਰੀਰ ਵਾਲਾ ਹੈ ॥੪੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "सुफिले देसं ॥४१९॥",
      "sourceLineId": "103693",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਚਲ ਧਰਮੰ ॥",
      "transliteration": "achal dharama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਮ ਵਿਚ ਅਚਲ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "अचल धरमं ॥",
      "sourceLineId": "103694",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਖਿਲ ਕਰਮੰ ॥",
      "transliteration": "akhil karama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਮੂਹ ਕਰਮਾ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "अखिल करमं ॥",
      "sourceLineId": "103695",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਮਿਤ ਜੋਗੰ ॥",
      "transliteration": "amit joga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਮਿਤ ਯੋਗ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "अमित जोगं ॥",
      "sourceLineId": "103696",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਜਿਤ ਭੋਗੰ ॥੪੨੦॥",
      "transliteration": "tajit bhoga(n) ||420||",
      "translation": "These Yogis of firm conduct and sinless Karmas had abandoned all enjoyments.420.",
      "punjabiViakhya": "ਭੋਗਾ ਨੂੰ ਤਿਆਗ ਚੁਕਾ ਹੈ ॥੪੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "तजित भोगं ॥४२०॥",
      "sourceLineId": "103697",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੁਫਲ ਕਰਮੰ ॥",
      "transliteration": "sufal karama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਰਮਾ ਵਿਚ ਸਫਲ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "सुफल करमं ॥",
      "sourceLineId": "103698",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੁਬ੍ਰਿਤ ਧਰਮੰ ॥",
      "transliteration": "subirat dharama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਮ ਵਾਲੀ ਸ੍ਰੇਸ਼ਠ ਬਿਰਤੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "सुबृत धरमं ॥",
      "sourceLineId": "103699",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕੁਕ੍ਰਿਤ ਹੰਤਾ ॥",
      "transliteration": "kukirat ha(n)taa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾੜੇ ਕੰਮਾ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "कुकृत हंता ॥",
      "sourceLineId": "103700",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੁਗਤੰ ਗੰਤਾ ॥੪੨੧॥",
      "transliteration": "sugata(n) ga(n)taa ||421||",
      "translation": "These vow-observing Yogis of good conduct and sinless Karmas had given up all evil actions.421.",
      "punjabiViakhya": "ਚੰਗੀ ਚਾਲ ਅਥਵਾ ਮਰਯਾਦਾ ਵਾਲਾ ਹੈ ॥੪੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "सुगतं गंता ॥४२१॥",
      "sourceLineId": "103701",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦਲਿਤੰ ਦ੍ਰੋਹੰ ॥",
      "transliteration": "dhalita(n) dhroha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦ੍ਰੋਹ ਨੂੰ ਦਲਣ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "दलितं द्रोहं ॥",
      "sourceLineId": "103702",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਲਿਤੰ ਮੋਹੰ ॥",
      "transliteration": "malita(n) moha(n) ||",
      "translation": "These were the people who had destroyed attachment and deceit and",
      "punjabiViakhya": "ਮੋਹ ਨੂੰ ਮਲ ਸੁਟਣ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "मलितं मोहं ॥",
      "sourceLineId": "103703",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਲਿਤੰ ਸਾਰੰ ॥",
      "transliteration": "salita(n) saara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰ ਤੱਤ੍ਵ ਦੀ ਨਦੀ ('ਸਲਿਤੰ') ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "सलितं सारं ॥",
      "sourceLineId": "103704",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੁਕ੍ਰਿਤ ਚਾਰੰ ॥੪੨੨॥",
      "transliteration": "sukirat chaara(n) ||422||",
      "translation": "Performers of good actions like the waters of all the sacred rivers.422.",
      "punjabiViakhya": "ਸ੍ਰੇਸ਼ਠ ਕਰਮਾ ਵਾਲਾ ਹੈ ॥੪੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "सुकृत चारं ॥४२२॥",
      "sourceLineId": "103705",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭਗਵੇ ਭੇਸੰ ॥",
      "transliteration": "bhagave bhesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭਗਵੇ ਭੇਸ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "भगवे भेसं ॥",
      "sourceLineId": "103706",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੁਫਲੰ ਦੇਸੰ ॥",
      "transliteration": "sufala(n) dhesa(n) ||",
      "translation": "They were kind-hearted people, wearing ochre-coloured clothes,",
      "punjabiViakhya": "ਸੁਫਲ ਦੇਸ਼ ਵਾਲਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "सुफलं देसं ॥",
      "sourceLineId": "103707",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੁਹ੍ਰਿਦੰ ਸਰਤਾ ॥",
      "transliteration": "suhiradha(n) sarataa ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਹਿਰਦਤਾ ਦੀ ਨਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "सुहृदं सरता ॥",
      "sourceLineId": "103708",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕੁਕ੍ਰਿਤੰ ਹਰਤਾ ॥੪੨੩॥",
      "transliteration": "kukirata(n) harataa ||423||",
      "translation": "Purifying all the countries far and near were the destroyers of evil actions.423.",
      "punjabiViakhya": "ਮਾੜੇ ਕਰਮਾ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲਾ ਹੈ ॥੪੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "कुकृतं हरता ॥४२३॥",
      "sourceLineId": "103709",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚਕ੍ਰਿਤੰ ਸੂਰੰ ॥",
      "transliteration": "chakirata(n) soora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤੇ ('ਸੁਰੰ') ਹੈਰਾਨ ਹੋ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "चकृतं सूरं ॥",
      "sourceLineId": "103710",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਮਤੰ ਨੂਰੰ ॥",
      "transliteration": "bamata(n) noora(n) ||",
      "translation": "Seeing their radiance even the sun was wonder-struck",
      "punjabiViakhya": "ਨੂਰ ਨੂੰ ਉਗਲ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "बमतं नूरं ॥",
      "sourceLineId": "103711",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਏਕੰ ਜਪਿਤੰ ॥",
      "transliteration": "eka(n) japita(n) ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ (ਪਰਮਾਤਮਾ) ਨੂੰ ਜਪ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "एकं जपितं ॥",
      "sourceLineId": "103712",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਏਕੋ ਥਪਿਤੰ ॥੪੨੪॥",
      "transliteration": "eko thapita(n) ||424||",
      "translation": "And someone out of them was repeating the Name of the Lord, and someone was singing the Praises of the Lord.424.",
      "punjabiViakhya": "ਇਕ ਦੀ ਹੀ ਸਥਾਪਨਾ ਕਰ ਰਹੇ ਹਨ ॥੪੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "एको थपितं ॥४२४॥",
      "sourceLineId": "103713",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਾਜੰ ਤਜਿਤ੍ਵੰ ॥",
      "transliteration": "raaja(n) tajitavai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਨੂੰ ਤਿਆਗ ਦਿੱਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "राजं तजित्वं ॥",
      "sourceLineId": "103714",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਈਸੰ ਭਵਿਤ੍ਵੰ ॥",
      "transliteration": "e'eesa(n) bhavitavai(n) ||",
      "translation": "While remembering and repeating the Name of the Lord,",
      "punjabiViakhya": "ਈਸ਼ਵਰ ਦਾ ਭਜਨ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "ईसं भवित्वं ॥",
      "sourceLineId": "103715",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਪੰ ਜਪਿਤ੍ਵੰ ॥",
      "transliteration": "japa(n) japitavai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ (ਪਰਮ ਸੱਤਾ) ਦੇ ਜਾਪ ਜਪਣ ਵਿਚ",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "जपं जपित्वं ॥",
      "sourceLineId": "103716",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਏਕੰ ਥਪਿਤ੍ਵੰ ॥੪੨੫॥",
      "transliteration": "eka(n) thapitavai(n) ||425||",
      "translation": "They were firmly establishing the Lord in their mind.425.",
      "punjabiViakhya": "(ਮਨ) ਸਥਿਰ ਕਰ ਚੁਕੇ ਹਨ ॥੪੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "एकं थपित्वं ॥४२५॥",
      "sourceLineId": "103717",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਜਤੰ ਨਾਦੰ ॥",
      "transliteration": "bajata(n) naadha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨਾਦ ਵਜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "बजतं नादं ॥",
      "sourceLineId": "103718",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਿਦਿਤੰ ਰਾਗੰ ॥",
      "transliteration": "bidhita(n) raaga(n) ||",
      "translation": "The horns were being sounded and there was the singing of Ragas (musical modes)",
      "punjabiViakhya": "ਰਾਗ ਪ੍ਰਗਟ ਹੋ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "बिदितं रागं ॥",
      "sourceLineId": "103719",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਪਤੰ ਜਾਪੰ ॥",
      "transliteration": "japata(n) jaapa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਾਪ ਨੂੰ ਜਪਣ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "जपतं जापं ॥",
      "sourceLineId": "103720",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤ੍ਰਸਿਤੰ ਤਾਪੰ ॥੪੨੬॥",
      "transliteration": "trasita(n) taapa(n) ||426||",
      "translation": "The Name of the Lord was being repeated, which had frightened the sins.426.",
      "punjabiViakhya": "ਤਾਪ (ਦੁਖ) ਭਜ ਰਹੇ ਹਨ ॥੪੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "त्रसितं तापं ॥४२६॥",
      "sourceLineId": "103721",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚਕਿਤੰ ਚੰਦੰ ॥",
      "transliteration": "chakita(n) cha(n)dha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਦ੍ਰਮਾ ਹੈਰਾਨ ਹੋ ਰਿਹਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "चकितं चंदं ॥",
      "sourceLineId": "103722",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਧਕਤੰ ਇੰਦੰ ॥",
      "transliteration": "dhakata(n) i(n)dha(n) ||",
      "translation": "The moon was wondering and Indra, seeing their devotion, had been fearful",
      "punjabiViakhya": "ਇੰਦਰ (ਦਾ ਹਿਰਦਾ) ਧੜਕ ਰਿਹਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "धकतं इंदं ॥",
      "sourceLineId": "103723",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਕਤੰ ਦੇਵੰ ॥",
      "transliteration": "takata(n) dheva(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤੇ ਤਕ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "तकतं देवं ॥",
      "sourceLineId": "103724",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭਗਤੰ ਭੇਵੰ ॥੪੨੭॥",
      "transliteration": "bhagata(n) bheva(n) ||427||",
      "translation": "All the gods were looking at them.427.",
      "punjabiViakhya": "(ਦੱਤ ਦੇ) ਭਗਤ ਬਣ ਗਏ ਹਨ ॥੪੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "भगतं भेवं ॥४२७॥",
      "sourceLineId": "103725",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭ੍ਰਮਤੰ ਭੂਤੰ ॥",
      "transliteration": "bhramata(n) bhoota(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭੂਤ ਫਿਰ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "भ्रमतं भूतं ॥",
      "sourceLineId": "103726",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਲਖਿਤੰ ਰੂਪੰ ॥",
      "transliteration": "lakhita(n) roopa(n) ||",
      "translation": "The ghosts, fiends and ganas, seeing their beauty were wonder-struck",
      "punjabiViakhya": "ਰੂਪ ਨੂੰ ਵੇਖ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "लखितं रूपं ॥",
      "sourceLineId": "103727",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਚਕ੍ਰਤੰ ਚਾਰੰ ॥",
      "transliteration": "chakrata(n) chaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਚਾਰੇ (ਪਾਸੇ) ਹੈਰਾਨ ਹੋ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "चक्रतं चारं ॥",
      "sourceLineId": "103728",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੁਹ੍ਰਿਦੰ ਸਾਰੰ ॥੪੨੮॥",
      "transliteration": "suhiradha(n) saara(n) ||428||",
      "translation": "And all were thinking about them with sincerity.428.",
      "punjabiViakhya": "(ਮੁਨੀ) ਸੁਹਿਰਦਤਾ ਦਾ ਸਾਰ ਹਨ ॥੪੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "सुहृदं सारं ॥४२८॥",
      "sourceLineId": "103729",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਲਿਨੰ ਸੂਅੰ ॥",
      "transliteration": "nalina(n) sooa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨਲਕੀ ਉਤੇ ਬੈਠਾ ਤੋਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "नलिनं सूअं ॥",
      "sourceLineId": "103730",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਲਖਿ ਅਉਧੂਅੰ ॥",
      "transliteration": "lakh aaudhooa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਵਧੂਤ (ਦੱਤ) ਨੇ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "लखि अउधूअं ॥",
      "sourceLineId": "103731",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚਟ ਦੇ ਛਟਾ ॥",
      "transliteration": "chaT dhe chhaTaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਤੋਤੇ ਨੂੰ ਪਿੰਜਰੇ ਵਿਚੋਂ ਕਢ ਦਿੱਤਾ ਅਤੇ) ਉਹ ਝਟਪਟ ਉਡ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "चट दे छटा ॥",
      "sourceLineId": "103732",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭ੍ਰਮ ਤੇ ਜਟਾ ॥੪੨੯॥",
      "transliteration": "bhram te jaTaa ||429||",
      "translation": "The Yogi Dut saw there a parrot, who was released from bondage and immediately flew away.429.",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਆਤਮਾ ਵੀ ਭਰਮ ਵਿਚ ਜੁਟੀ ਹੋਈ ਹੈ ॥੪੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "भ्रम ते जटा ॥४२९॥",
      "sourceLineId": "103733",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਕਿਤੰ ਦੇਵੰ ॥",
      "transliteration": "takita(n) dheva(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਭੇਦ ਨੂੰ) ਵੇਖਦੇ ਹੋਇਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "तकितं देवं ॥",
      "sourceLineId": "103734",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਕਿਤੰ ਭੇਵੰ ॥",
      "transliteration": "bakita(n) bheva(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਤ ਦੇਵ ਨੇ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "बकितं भेवं ॥",
      "sourceLineId": "103735",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦਸ ਨਵ ਸੀਸੰ ॥",
      "transliteration": "dhas nav seesa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਹ ਮੇਰਾ ਉਨ੍ਰਹੀਵਾ ਗੁਰੂ ('ਸੀਸੰ') ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "दस नव सीसं ॥",
      "sourceLineId": "103736",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਰਮਕ ਦੀਸੰ ॥੪੩੦॥",
      "transliteration": "karamak dheesa(n) ||430||",
      "translation": "As soon as the pious Dutt saw him, he flew away and made known to Dutt this secret that the action-prone man with ten senses and none doors was superior amongst beings.430.",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ ਇਹ) ਸ੍ਰੇਸ਼ਠ ('ਕਰਮਕ') ਦਿਸਦਾ ਹੈ ॥੪੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "करमक दीसं ॥४३०॥",
      "sourceLineId": "103737",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0669_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬੁਧਿਤੰ ਧਾਮੰ ॥",
      "transliteration": "budhita(n) dhaama(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਮਨੁੱਖ) ਅਕਲ ਦਾ ਘਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 669,
      "hindi": "",
      "hindiTransliteration": "बुधितं धामं ॥",
      "sourceLineId": "103738",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
