{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 670,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0670_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗ੍ਰਿਹਿਤੰ ਬਾਮੰ ॥",
      "transliteration": "girahita(n) baama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਘਰ ਵਿਚ ਇਸਤਰੀ ਨਾਲ (ਲੀਨ ਹੈ)",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "गृहितं बामं ॥",
      "sourceLineId": "103739",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਭ੍ਰਮਤੰ ਮੋਹੰ ॥",
      "transliteration": "bhramata(n) moha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮਮਤਾ ਦੇ ਮੋਹ ਵਿਚ",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "भ्रमतं मोहं ॥",
      "sourceLineId": "103740",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਮਤੰ ਮੋਹੰ ॥੪੩੧॥",
      "transliteration": "mamata(n) moha(n) ||431||",
      "translation": "He is the abode of wisdom, but falling in the attachment of his wife etc. he remains in illusion.431.",
      "punjabiViakhya": "ਭਰਮਦਾ ਰਹਿੰਦਾ ਹੈ ॥੪੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "ममतं मोहं ॥४३१॥",
      "sourceLineId": "103741",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਮਤਾ ਬੁਧੰ ॥",
      "transliteration": "mamataa budha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮਮਤਾ ਦੀ ਬੁੱਧੀ ਵਾਲੇ",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "ममता बुधं ॥",
      "sourceLineId": "103742",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸ੍ਰਿਹਤੰ ਲੋਗੰ ॥",
      "transliteration": "sirahata(n) loga(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸਾਰੇ) ਲੋਕ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "सृहतं लोगं ॥",
      "sourceLineId": "103743",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਹਿਤਾ ਧਰਮੰ ॥",
      "transliteration": "ahitaa dharama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹਿਤ ਰਹਿਤ ਧਰਮ ਵਾਲੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "अहिता धरमं ॥",
      "sourceLineId": "103744",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਲਹਿਤਹ ਭੋਗੰ ॥੪੩੨॥",
      "transliteration": "lahiteh bhoga(n) ||432||",
      "translation": "The individual entrapped in the key of wisdom and mildness, he is absorbed in pleasure and is removed far away from Dharma.432.",
      "punjabiViakhya": "ਭੋਗਾ ਵਿਚ ਮਗਨ ਹਨ ॥੪੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "लहितह भोगं ॥४३२॥",
      "sourceLineId": "103745",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗ੍ਰਿਸਤੰ ਬੁਧੰ ॥",
      "transliteration": "girasata(n) budha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬੁੱਧੀ ਜਕੜੀ ਹੋਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "गृसतं बुधं ॥",
      "sourceLineId": "103746",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਮਤਾ ਮਾਤੰ ॥",
      "transliteration": "mamataa maata(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਤਾ ਦੀ ਮਮਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "ममता मातं ॥",
      "sourceLineId": "103747",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਸਤ੍ਰੀ ਨੇਹੰ ॥",
      "transliteration": "eisatree neha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ,",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "इसत्री नेहं ॥",
      "sourceLineId": "103748",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪੁਤ੍ਰੰ ਭ੍ਰਾਤੰ ॥੪੩੩॥",
      "transliteration": "putra(n) bhraata(n) ||433||",
      "translation": "His wisdom seized by the attachment of mother, wife, sons and brothers.433.",
      "punjabiViakhya": "ਪੁੱਤਰ ਅਤੇ ਭਰਾ ਦੇ ਮੋਹ ਕਰ ਕੇ ॥੪੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "पुत्रं भ्रातं ॥४३३॥",
      "sourceLineId": "103749",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗ੍ਰਸਤੰ ਮੋਹੰ ॥",
      "transliteration": "grasata(n) moha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮੋਹ ਵਿਚ ਗ੍ਰਸਿਆ ਹੋਇਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "ग्रसतं मोहं ॥",
      "sourceLineId": "103750",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਧਰਿਤੰ ਕਾਮੰ ॥",
      "transliteration": "dharita(n) kaama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮਨਾਵਾ ਨੂੰ ਧਾਰਨ ਕਰਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "धरितं कामं ॥",
      "sourceLineId": "103751",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਲਤੰ ਕ੍ਰੋਧੰ ॥",
      "transliteration": "jalata(n) krodha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਵਿਚ ਸੜਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "जलतं क्रोधं ॥",
      "sourceLineId": "103752",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪਲਿਤੰ ਦਾਮੰ ॥੪੩੪॥",
      "transliteration": "palita(n) dhaama(n) ||434||",
      "translation": "Engrossed in lust, he is absorbed in attachments and burning in the fire of anger, he is occupied in the collection of wealth.434.",
      "punjabiViakhya": "ਦਾਮ' (ਮਾਇਆ) ਵਿਚ ਫਸਿਆ ਹੋਇਆ ਹੈ ॥੪੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "पलितं दामं ॥४३४॥",
      "sourceLineId": "103753",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦਲਤੰ ਬਿਯੋਧੰ ॥",
      "transliteration": "dhalata(n) biyodha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਆਧੀ ਨੇ ਦਲਿਆ ਹੋਇਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "दलतं बियोधं ॥",
      "sourceLineId": "103754",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਕਿਤੰ ਦਾਵੰ ॥",
      "transliteration": "takita(n) dhaava(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮੌਕੇ ਨੂੰ ਤਕਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "तकितं दावं ॥",
      "sourceLineId": "103755",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅੰਤਹ ਨਰਕੰ ॥",
      "transliteration": "a(n)teh naraka(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਤ ਵਿਚ ਜਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "अंतह नरकं ॥",
      "sourceLineId": "103756",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗੰਤਹ ਪਾਵੰ ॥੪੩੫॥",
      "transliteration": "ga(n)teh paava(n) ||435||",
      "translation": "On getting an opportunity, he destroys the great warriors for his self-interest and in this way, he falls into hell.435.",
      "punjabiViakhya": "ਨਰਕ ਵਿਚ ਪੈ ਜਾਵੇਗਾ ॥੪੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "गंतह पावं ॥४३५॥",
      "sourceLineId": "103757",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਜਿਤੰ ਸਰਬੰ ॥",
      "transliteration": "tajita(n) saraba(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਨੂੰ ਤਿਆਗ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "तजितं सरबं ॥",
      "sourceLineId": "103758",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗ੍ਰਹਿਤੰ ਏਕੰ ॥",
      "transliteration": "grahita(n) eka(n) ||",
      "translation": "",
      "punjabiViakhya": "ਇਕੋ (ਪ੍ਰਭੂ) ਨੂੰ ਫੜ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "ग्रहितं एकं ॥",
      "sourceLineId": "103759",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪ੍ਰਭਤੰ ਭਾਵੰ ॥",
      "transliteration": "prabhata(n) bhaava(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਪ੍ਰਭੂ ਨੂੰ ਚੰਗਾ ਲਗਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "प्रभतं भावं ॥",
      "sourceLineId": "103760",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਜਿਤੰ ਦ੍ਵੈਖੰ ॥੪੩੬॥",
      "transliteration": "tajita(n) dhavaikha(n) ||436||",
      "translation": "If forsaking all, the Lord is adored with sincerity, and then all the sufferings and malice come to an end.436.",
      "punjabiViakhya": "ਜਦ ਦ੍ਵੈਖ ਨੂੰ ਛਡਦਾ ਹੈ ॥੪੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "तजितं द्वैखं ॥४३६॥",
      "sourceLineId": "103761",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਲਿਨੀ ਸੁਕਿ ਜਯੰ ॥",
      "transliteration": "nalinee suk jaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਨਲਨੀ ਸੁਕ ਵਾਗ",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "नलिनी सुकि जयं ॥",
      "sourceLineId": "103762",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਜਿਤੰ ਦਿਰਬੰ ॥",
      "transliteration": "tajita(n) dhiraba(n) ||",
      "translation": "",
      "punjabiViakhya": "ਧਨ ਦੌਲਤ ਨੂੰ ਛਡ ਦਿੰਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "तजितं दिरबं ॥",
      "sourceLineId": "103763",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਫਲੀ ਕਰਮੰ ॥",
      "transliteration": "safalee karama(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ ਉਹ) ਕਰਮਾ ਵਿਚ ਸਫਲ ਹੋ ਜਾਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "सफली करमं ॥",
      "sourceLineId": "103764",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਲਹਿਤੰ ਸਰਬੰ ॥੪੩੭॥",
      "transliteration": "lahita(n) saraba(n) ||437||",
      "translation": "If the being relinquishes all like the abandonment of the cage by parrot, then all his actions can bear fruit and he achieves the position of superiority.437.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ (ਸੁਖ) ਪ੍ਰਾਪਤ ਕਰ ਲੈਂਦਾ ਹੈ ॥੪੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "लहितं सरबं ॥४३७॥",
      "sourceLineId": "103765",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਤਿ ਨਲਿਨੀ ਸੁਕ ਉਨੀਸਵੋ ਗੁਰੂ ਬਰਨਨੰ ॥੧੯॥",
      "transliteration": "eit nalinee suk uneesavo guroo baranana(n) ||19||",
      "translation": "End of the description of the adoption of the Parrot as the Nineteenth Guru.",
      "punjabiViakhya": "ਇਥੇ 'ਨਲਨੀ ਸੁਕ' ਉਨ੍ਰਹੀਵੇਾਂ ਗੁਰੂ ਦਾ ਵਰਣਨ ਸਮਾਪਤ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "इति नलिनी सुक उनीसवो गुरू बरननं ॥१९॥",
      "sourceLineId": "103766",
      "sourceShabadId": "9368",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਥ ਸਾਹ ਬੀਸਵੋ ਗੁਰੁ ਕਥਨੰ ॥",
      "transliteration": "ath saeh beesavo gur kathana(n) ||",
      "translation": "Now begins the description of the adoption of a Trader as the Twentieth Guru",
      "punjabiViakhya": "ਹੁਣ 'ਸ਼ਾਹ' ਵੀਹਵੇਾਂ ਗੁਰੂ ਦਾ ਕਥਨ",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "अथ साह बीसवो गुरु कथनं ॥",
      "sourceLineId": "103767",
      "sourceShabadId": "9369",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "103768",
      "sourceShabadId": "9369",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਆਗੇ ਚਲਾ ਦਤ ਜਟ ਧਾਰੀ ॥",
      "transliteration": "aage chalaa dhat jaT dhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਟਾਧਾਰੀ ਦੱਤ ਅਗੇ ਨੂੰ ਤੁਰ ਚਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "आगे चला दत जट धारी ॥",
      "sourceLineId": "103769",
      "sourceShabadId": "9369",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬੇਜਤ ਬੇਣ ਬਿਖਾਨ ਅਪਾਰੀ ॥",
      "transliteration": "bejat ben bikhaan apaaree ||",
      "translation": "Then Dutt, the wearer of matted locks moved further",
      "punjabiViakhya": "(ਜਿਸ ਨਾਲ) ਅਪਾਰ ਰਣਸਿੰਗੇ ਅਤੇ ਵਾਜੇ ਵਜਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "बेजत बेण बिखान अपारी ॥",
      "sourceLineId": "103770",
      "sourceShabadId": "9369",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਸਥਾਵਰ ਲਖਿ ਚੇਤਨ ਭਏ ॥",
      "transliteration": "asathaavar lakh chetan bhe ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਸਥਿਤੀ ਅਥਵਾ ਦ੍ਰਿਸ਼ ਨੂੰ) ਵੇਖ ਕੇ ਜੜ ਚੇਤਨ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "असथावर लखि चेतन भए ॥",
      "sourceLineId": "103771",
      "sourceShabadId": "9369",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਚੇਤਨ ਦੇਖ ਚਕ੍ਰਿਤ ਹ੍ਵੈ ਗਏ ॥੪੩੮॥",
      "transliteration": "chetan dhekh chakirat havai ge ||438||",
      "translation": "The musical instruments were being played seeing Dutt. The inanimate things were becoming animate and the animate were wonder-struck.438.",
      "punjabiViakhya": "ਅਤੇ ਚੇਤਨ ਵੇਖ ਕੇ ਹੈਰਾਨ ਹੋ ਗਏ ॥੪੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "चेतन देख चकृत ह्वै गए ॥४३८॥",
      "sourceLineId": "103772",
      "sourceShabadId": "9369",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਹਾ ਰੂਪ ਕਛੁ ਕਹਾ ਨ ਜਾਈ ॥",
      "transliteration": "mahaa roop kachh kahaa na jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾਨ ਰੂਪ ਹੈ, ਕੁਝ ਕਿਹਾ ਨਹੀਂ ਜਾਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "महा रूप कछु कहा न जाई ॥",
      "sourceLineId": "103773",
      "sourceShabadId": "9369",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਿਰਖਿ ਚਕ੍ਰਿਤ ਰਹੀ ਸਕਲ ਲੁਕਾਈ ॥",
      "transliteration": "nirakh chakirat rahee sakal lukaiee ||",
      "translation": "His great beauty was indescribable, seeing which all the world was in astonishment",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ) ਵੇਖ ਕੇ ਸਾਰੀ ਲੁਕਾਈ ਹੈਰਾਨ ਹੋ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "निरखि चकृत रही सकल लुकाई ॥",
      "sourceLineId": "103774",
      "sourceShabadId": "9369",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਤ ਜਿਤ ਜਾਤ ਪਥਹਿ ਰਿਖਿ ਗ੍ਯੋ ॥",
      "transliteration": "jit jit jaat patheh rikh gayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਜਿਸ ਮਾਰਗ ਉਤੇ ਰਿਸ਼ੀ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "जित जित जात पथहि रिखि ग्यो ॥",
      "sourceLineId": "103775",
      "sourceShabadId": "9369",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਾਨੁਕ ਪ੍ਰੇਮ ਮੇਘ ਬਰਖ੍ਰਯੋ ॥੪੩੯॥",
      "transliteration": "jaanuk prem megh barakhrayo ||439||",
      "translation": "The paths on which the sage went, it appeared that the cloud of love was raining.439.",
      "punjabiViakhya": "(ਉਥੇ) ਮਾਨੋ ਪ੍ਰੇਮ ਦਾ ਬਦਲ ਵਰ੍ਰਹ ਪਿਆ ॥੪੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "जानुक प्रेम मेघ बरख्रयो ॥४३९॥",
      "sourceLineId": "103776",
      "sourceShabadId": "9369",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਹ ਇਕ ਲਖਾ ਸਾਹ ਧਨਵਾਨਾ ॥",
      "transliteration": "teh ik lakhaa saeh dhanavaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ (ਉਸ ਨੇ) ਇਕ ਧਨਵਾਨ ਸ਼ਾਹ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "तह इक लखा साह धनवाना ॥",
      "sourceLineId": "103777",
      "sourceShabadId": "9369",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਹਾ ਰੂਪ ਧਰਿ ਦਿਰਬ ਨਿਧਾਨਾ ॥",
      "transliteration": "mahaa roop dhar dhirab nidhaanaa ||",
      "translation": "There he saw a wealthy trader, was extremely comely and treasure of money and materials",
      "punjabiViakhya": "(ਜੋ) ਮਹਾਨ ਰੂਪ ਵਾਲਾ ਅਤੇ ਦੌਲਤ ਦੇ ਖ਼ਜ਼ਾਨੇ ਵਾਲਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "महा रूप धरि दिरब निधाना ॥",
      "sourceLineId": "103778",
      "sourceShabadId": "9369",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮਹਾ ਜੋਤਿ ਅਰੁ ਤੇਜ ਅਪਾਰੂ ॥",
      "transliteration": "mahaa jot ar tej apaaroo ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਦੇ ਮੁਖ ਤੇ) ਮਹਾਨ ਜੋਤਿ ਅਤੇ ਅਪਾਰ ਤੇਜ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "महा जोति अरु तेज अपारू ॥",
      "sourceLineId": "103779",
      "sourceShabadId": "9369",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਆਪ ਘੜਾ ਜਾਨੁਕ ਮੁਖਿ ਚਾਰੂ ॥੪੪੦॥",
      "transliteration": "aap ghaRaa jaanuk mukh chaaroo ||440||",
      "translation": "He was supremely splendid and it appeared that Brahma himself had created him.440.",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਬ੍ਰਹਮਾ ਨੇ ਆਪ ਘੜਿਆ ਹੋਵੇ ॥੪੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "आप घड़ा जानुक मुखि चारू ॥४४०॥",
      "sourceLineId": "103780",
      "sourceShabadId": "9369",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਿਕ੍ਰਿਅ ਬੀਚ ਅਧਿਕ ਸਵਧਾਨਾ ॥",
      "transliteration": "bikria beech adhik savadhaanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਸੌਦਾ) ਵੇਚਣ ਵਿਚ ਬਹੁਤ ਸਾਵਧਾਨ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "बिकृअ बीच अधिक सवधाना ॥",
      "sourceLineId": "103781",
      "sourceShabadId": "9369",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਿਨੁ ਬਿਪਾਰ ਜਿਨ ਅਉਰ ਨ ਜਾਨਾ ॥",
      "transliteration": "bin bipaar jin aaur na jaanaa ||",
      "translation": "He was extremely conscious about his sale and it seemed that he did not know anything else except trade",
      "punjabiViakhya": "ਉਹ ਬਪਾਰ ਤੋਂ ਭਿੰਨ ਹੋਰ ਕੋਈ ਗੱਲ ਨਹੀਂ ਜਾਣਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "बिनु बिपार जिन अउर न जाना ॥",
      "sourceLineId": "103782",
      "sourceShabadId": "9369",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਆਸ ਅਨੁਰਕਤ ਤਾਸੁ ਬ੍ਰਿਤ ਲਾਗਾ ॥",
      "transliteration": "aas anurakat taas birat laagaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਬਿਰਤੀ ਆਸ਼ਾ ਵਿਚ ਪੂਰੀ ਤਰ੍ਰਹਾ ਲਗੀ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "आस अनुरकत तासु बृत लागा ॥",
      "sourceLineId": "103783",
      "sourceShabadId": "9369",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਾਨਹੁ ਮਹਾ ਜੋਗ ਅਨੁਰਾਗਾ ॥੪੪੧॥",
      "transliteration": "maanahu mahaa jog anuraagaa ||441||",
      "translation": "Absorbed in desires his attention was solely engrossed in trade and he was looking like a great Yogi.441.",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਉਹ ਯੋਗ ਦੀ ਅਤਿ ਲਗਨ ਵਾਲਾ ਹੋਵੇ ॥੪੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "मानहु महा जोग अनुरागा ॥४४१॥",
      "sourceLineId": "103784",
      "sourceShabadId": "9369",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਹਾ ਰਿਖਿ ਗਏ ਸੰਗਿ ਸੰਨ੍ਯਾਸਨ ॥",
      "transliteration": "tahaa rikh ge sa(n)g sa(n)nayaasan ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਨਿਆਸੀਆਂ ਨੂੰ ਨਾਲ ਲਈ ਰਿਸ਼ੀ ਉਥੇ ਜਾ ਪਹੁੰਚਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "तहा रिखि गए संगि संन्यासन ॥",
      "sourceLineId": "103785",
      "sourceShabadId": "9369",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0670_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਈ ਛੋਹਨੀ ਜਾਤ ਨਹੀ ਗਨਿ ॥",
      "transliteration": "kiee chhohanee jaat nahee gan ||",
      "translation": "The sage reached there alongwith Sannyasis and innumerable disciples",
      "punjabiViakhya": "(ਉਸ ਨਾਲ ਸੰਨਿਆਸੀਆਂ) ਦੀਆਂ ਕਈ ਛੋਹਣੀਆਂ ਸਨ, (ਉਨ੍ਰਹਾ ਦੀ) ਗਿਣਤੀ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 670,
      "hindi": "",
      "hindiTransliteration": "कई छोहनी जात नही गनि ॥",
      "sourceLineId": "103786",
      "sourceShabadId": "9369",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
