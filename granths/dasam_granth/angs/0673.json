{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 673,
  "lineCount": 52,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0673_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੰਗੀਤ ਕਰਤ ਬਿਚਾਰ ॥੪੬੮॥",
      "transliteration": "sa(n)geet karat bichaar ||468||",
      "translation": "She was the abode of happiness and her eyes were charming she was thoughtfully singing her musical modes.468.",
      "punjabiViakhya": "ਅਤੇ (ਉਹ) ਸੰਗੀਤ ਦਾ ਵਿਚਾਰ ਕਰ ਰਹੀ ਸੀ ॥੪੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "संगीत करत बिचार ॥४६८॥",
      "sourceLineId": "103903",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੁਤਿ ਮਾਨ ਰੂਪ ਅਪਾਰ ॥",
      "transliteration": "dhut maan roop apaar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਰੂਪ ਅਪਾਰ ਚਮਕ ਦਮਕ ਵਾਲਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "दुति मान रूप अपार ॥",
      "sourceLineId": "103904",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗੁਣਵੰਤ ਸੀਲ ਉਦਾਰ ॥",
      "transliteration": "gunava(n)t seel udhaar ||",
      "translation": "She was pretty, gentle and generous",
      "punjabiViakhya": "(ਉਹ) ਸ਼ੀਲ ਅਤੇ ਉਦਾਰ ਗੁਣ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "गुणवंत सील उदार ॥",
      "sourceLineId": "103905",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੁਖ ਸਿੰਧੁ ਰਾਗ ਨਿਧਾਨ ॥",
      "transliteration": "sukh si(n)dh raag nidhaan ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਖ ਦਾ ਸਮੁੰਦਰ ਅਤੇ ਰਾਗਾ ਦਾ ਖ਼ਜ਼ਾਨਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "सुख सिंधु राग निधान ॥",
      "sourceLineId": "103906",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹਰਿ ਲੇਤ ਹੇਰਤਿ ਪ੍ਰਾਨ ॥੪੬੯॥",
      "transliteration": "har let herat praan ||469||",
      "translation": "That lady, the treasure of music, to whichever direction she viewed, she allured everyone.469.",
      "punjabiViakhya": "ਅਤੇ ਵੇਖਣ ਨਾਲ ਹੀ ਪ੍ਰਾਣ ਹਰ ਲੈਂਦੀ ਸੀ ॥੪੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "हरि लेत हेरति प्रान ॥४६९॥",
      "sourceLineId": "103907",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਕਲੰਕ ਜੁਬਨ ਮਾਨ ॥",
      "transliteration": "akala(n)k juban maan ||",
      "translation": "",
      "punjabiViakhya": "ਕਲੰਕ ਤੋਂ ਰਹਿਤ ਜੋਬਨ ਵਾਲੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "अकलंक जुबन मान ॥",
      "sourceLineId": "103908",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੁਖ ਸਿੰਧੁ ਸੁੰਦਰਿ ਥਾਨ ॥",
      "transliteration": "sukh si(n)dh su(n)dhar thaan ||",
      "translation": "That blemishless and honourable lady was an ocean of happiness",
      "punjabiViakhya": "(ਉਹ) ਸੁੰਦਰੀ ਸੁਖ ਦਾ ਸਮੁੰਦਰ ਬਣੀ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "सुख सिंधु सुँदरि थान ॥",
      "sourceLineId": "103909",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਇਕ ਚਿਤ ਗਾਵਤ ਰਾਗ ॥",
      "transliteration": "eik chit gaavat raag ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਚਿਤ ਹੋ ਕੇ ਰਾਗ ਗਾਉਾਂਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "इक चित गावत राग ॥",
      "sourceLineId": "103910",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਉਫਟੰਤ ਜਾਨੁ ਸੁਹਾਗ ॥੪੭੦॥",
      "transliteration": "aufaTa(n)t jaan suhaag ||470||",
      "translation": "She was singing with full concentration of mind and the auspicious songs seemed to be springing out from her very interior.470.",
      "punjabiViakhya": "ਮਾਨੋ ਸੁਹਾਗ ਫੁਟ ਫੁਟ ਕੇ ਬਾਹਰ ਨਿਕਲਦਾ ਹੋਵੇ ॥੪੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "उफटंत जानु सुहाग ॥४७०॥",
      "sourceLineId": "103911",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਿਹ ਪੇਖ ਕੈ ਜਟਿ ਰਾਜ ॥",
      "transliteration": "teh pekh kai jaT raaj ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਜਟਾਧਾਰੀ ਯੋਗੀ ਰਾਜ (ਦੱਤ)",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "तिह पेख कै जटि राज ॥",
      "sourceLineId": "103912",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੰਗ ਲੀਨ ਜੋਗ ਸਮਾਜ ॥",
      "transliteration": "sa(n)g leen jog samaaj ||",
      "translation": "Seeing her, the king of Yogis gathered all his Yogis and",
      "punjabiViakhya": "ਆਪਣੇ ਨਾਲ ਯੋਗੀਆਂ ਦੀ ਮੰਡਲੀ ਲਏ ਹੋਇਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "संग लीन जोग समाज ॥",
      "sourceLineId": "103913",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਹਿ ਰੀਝ ਆਪਨ ਚਿਤ ॥",
      "transliteration": "reh reejh aapan chit ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਚਿਤ ਵਿਚ ਪ੍ਰਸੰਨ ਹੋ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "रहि रीझ आपन चित ॥",
      "sourceLineId": "103914",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੁਗ ਰਾਜ ਜੋਗ ਪਵਿਤ ॥੪੭੧॥",
      "transliteration": "jug raaj jog pavit ||471||",
      "translation": "All of them were pleased to see that pure Yogin.471.",
      "punjabiViakhya": "ਜੋ ਯੋਗ ਰਾਜ (ਦੱਤ) ਯੋਗ ਵਿਚ ਪਵਿਤ੍ਰ ਸੀ ॥੪੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "जुग राज जोग पवित ॥४७१॥",
      "sourceLineId": "103915",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਜੋ ਹਰਿ ਸੰਗ ॥",
      "transliteration": "eeh bhaat jo har sa(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਜੋ ਹਰਿ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "इह भाति जो हरि संग ॥",
      "sourceLineId": "103916",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਹਿਤ ਕੀਜੀਐ ਅਨਭੰਗ ॥",
      "transliteration": "hit keejeeaai anabha(n)g ||",
      "translation": "The king of Yogis thought that if in this way, detaching oneself from all other sides,",
      "punjabiViakhya": "ਅਟੁਟ ਪ੍ਰੇਮ ਕਰੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "हित कीजीऐ अनभंग ॥",
      "sourceLineId": "103917",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਬ ਪਾਈਐ ਹਰਿ ਲੋਕ ॥",
      "transliteration": "tab paieeaai har lok ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਉਹ) ਜ਼ਰੂਰ ਹਰਿ-ਲੋਕ ਪ੍ਰਾਪਤ ਕਰ ਲਏਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "तब पाईऐ हरि लोक ॥",
      "sourceLineId": "103918",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਇਹ ਬਾਤ ਮੈ ਨਹੀ ਸੋਕ ॥੪੭੨॥",
      "transliteration": "eeh baat mai nahee sok ||472||",
      "translation": "The mind is concentrated on the Lord, then the Lord can be realized without any apprehension.472.",
      "punjabiViakhya": "ਇਸ ਗੱਲ ਵਿਚ (ਜ਼ਰਾ ਜਿੰਨਾ ਵੀ) ਸ਼ਕ ਨਹੀਂ ਹੈ ॥੪੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "इह बात मै नही सोक ॥४७२॥",
      "sourceLineId": "103919",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚਿਤ ਚਉਪ ਸੋ ਭਰ ਚਾਇ ॥",
      "transliteration": "chit chaup so bhar chai ||",
      "translation": "",
      "punjabiViakhya": "ਚਾਉ ਅਤੇ ਸ਼ੌਕ ਨਾਲ (ਦੱਤ ਦਾ) ਚਿਤ ਭਰ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "चित चउप सो भर चाइ ॥",
      "sourceLineId": "103920",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗੁਰ ਜਾਨਿ ਕੈ ਪਰਿ ਪਾਇ ॥",
      "transliteration": "gur jaan kai par pai ||",
      "translation": "The enthusiastic sage, accepted her as his Guru, fell at her feet",
      "punjabiViakhya": "ਅਤੇ ਗੁਰੂ ਜਾਣ ਕੇ ਪੈਰੀਂ ਪੈ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "गुर जानि कै परि पाइ ॥",
      "sourceLineId": "103921",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚਿਤ ਤਊਨ ਕੇ ਰਸ ਭੀਨ ॥",
      "transliteration": "chit tuoon ke ras bheen ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਪ੍ਰੇਮ ਰਸ ਵਿਚ ਚਿਤ ਭਿਜ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "चित तऊन के रस भीन ॥",
      "sourceLineId": "103922",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗੁਰੁ ਤੇਈਸਵੋ ਤਿਹ ਕੀਨ ॥੪੭੩॥",
      "transliteration": "gur teieesavo teh keen ||473||",
      "translation": "Getting absorbed in her love, the king of the sages, adopted her as his Twenty-Third Guru.473.",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਤੇਈਵਾ ਗੁਰੂ ਕਰ ਲਿਆ ॥੪੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "गुरु तेईसवो तिह कीन ॥४७३॥",
      "sourceLineId": "103923",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਇਤਿ ਜਛਣੀ ਨਾਰਿ ਰਾਗ ਗਾਵਤੀ ਗੁਰੂ ਤੇਈਸਵੋ ਸਮਾਪਤੰ ॥੨੩॥",
      "transliteration": "eit jachhanee naar raag gaavatee guroo teieesavo samaapata(n) ||23||",
      "translation": "End of the description of the adoption of a Yaksha woman-singer as the twenty-Third Guru.",
      "punjabiViakhya": "ਇਥੇ 'ਜਛਣੀ ਨਾਰ ਰਾਗ ਗਾਉਾਂਦੀ ਹੋਈ' ਤੇਈਵੇਾਂ ਗੁਰੂ ਦਾ ਪ੍ਰਸੰਗ ਸਮਾਪਤ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "इति जछणी नारि राग गावती गुरू तेईसवो समापतं ॥२३॥",
      "sourceLineId": "103924",
      "sourceShabadId": "9374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤੋਮਰ ਛੰਦ ॥",
      "transliteration": "tomar chha(n)dh ||",
      "translation": "(Now begins the description of the adoption of the Twenty-fourth Guru [carnation])",
      "punjabiViakhya": "ਤੋਮਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "तोमर छंद ॥",
      "sourceLineId": "103925",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਬ ਬਹੁਤ ਬਰਖ ਪ੍ਰਮਾਨ ॥",
      "transliteration": "tab bahut barakh pramaan ||",
      "translation": "TOMAR STANZA",
      "punjabiViakhya": "ਤਦ ਬਹੁਤ ਵਰਿਆਂ ਤਕ,",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "तब बहुत बरख प्रमान ॥",
      "sourceLineId": "103926",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚੜਿ ਮੇਰ ਸ੍ਰਿੰਗ ਮਹਾਨ ॥",
      "transliteration": "chaR mer sira(n)g mahaan ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਮੇਰ ਪਰਬਤ ਦੀ ਮਹਾਨ ਚੋਟੀ ਉਤੇ ਚੜ੍ਰਹ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "चड़ि मेर सृंग महान ॥",
      "sourceLineId": "103927",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕੀਅ ਘੋਰ ਤਪਸਾ ਉਗ੍ਰ ॥",
      "transliteration": "keea ghor tapasaa ugr ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਘੋਰ ਤਪਸਿਆ ਕੀਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "कीअ घोर तपसा उग्र ॥",
      "sourceLineId": "103928",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਬ ਰੀਝਏ ਕਛੁ ਸੁਗ੍ਰ ॥੪੭੪॥",
      "transliteration": "tab reejhe kachh sugr ||474||",
      "translation": "Then ascending the Sumeru mountain the sage performed great austerities for many years and felt pleased as the essence-finder.474.",
      "punjabiViakhya": "ਤਦ ਸੁਘੜ (ਪਰਮਾਤਮਾ) ਕੁਛ ਪ੍ਰਸੰਨ ਹੋਏ ॥੪੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "तब रीझए कछु सुग्र ॥४७४॥",
      "sourceLineId": "103929",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਗ ਦੇਖ ਕੇ ਬਿਵਹਾਰ ॥",
      "transliteration": "jag dhekh ke bivahaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਗਤ ਦਾ ਵਿਵਹਾਰ ਵੇਖ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "जग देख के बिवहार ॥",
      "sourceLineId": "103930",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮੁਨਿ ਰਾਜ ਕੀਨ ਬਿਚਾਰ ॥",
      "transliteration": "mun raaj keen bichaar ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਨੀ ਰਾਜ ਨੇ ਵਿਚਾਰ ਕੀਤਾ ਕਿ",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "मुनि राज कीन बिचार ॥",
      "sourceLineId": "103931",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਨ ਕਉਨ ਸੋ ਉਪਜਾਇ ॥",
      "transliteration": "ein kaun so upajai ||",
      "translation": "",
      "punjabiViakhya": "(ਜਗਤ ਵਾਲਿਆਂ ਨੂੰ) ਕੌਣ ਪੈਦਾ ਕਰਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "इन कउन सो उपजाइ ॥",
      "sourceLineId": "103932",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਫਿਰਿ ਲੇਤਿ ਆਪਿ ਮਿਲਾਇ ॥੪੭੫॥",
      "transliteration": "fir let aap milai ||475||",
      "translation": "Seeing the practice of the world, the sage thought as to who is He, who creates the world and then merges it within Himself?475.",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਆਪਣੇ ਵਿਚ ਮਿਲਾ ਲੈਂਦਾ ਹੈ ॥੪੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "फिरि लेति आपि मिलाइ ॥४७५॥",
      "sourceLineId": "103933",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਿਹ ਚੀਨੀਐ ਕਰਿ ਗਿਆਨ ॥",
      "transliteration": "teh cheeneeaai kar giaan ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਗਿਆਨ ਪੂਰਵਕ ਸਮਝਣਾ ਚਾਹੀਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "तिह चीनीऐ करि गिआन ॥",
      "sourceLineId": "103934",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਬ ਹੋਇ ਪੂਰਣ ਧ੍ਯਾਨ ॥",
      "transliteration": "tab hoi pooran dhayaan ||",
      "translation": "When He is recognized through the knowledge, then the adoration will be complete",
      "punjabiViakhya": "ਤਦ ਪੂਰਨ ਧਿਆਨ ਦੀ ਅਵਸਥਾ ਪ੍ਰਾਪਤ ਹੋਵੇਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "तब होइ पूरण ध्यान ॥",
      "sourceLineId": "103935",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਿਹ ਜਾਣੀਐ ਜਤ ਜੋਗ ॥",
      "transliteration": "teh jaaneeaai jat jog ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜਤ (ਇੰਦਰੀਆਂ ਉਪਰ ਕਾਬੂ ਪਾਣ ਵਾਲਾ) ਯੋਗ ਦੁਆਰਾ ਜਾਣਨਾ ਚਾਹੀਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "तिह जाणीऐ जत जोग ॥",
      "sourceLineId": "103936",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਬ ਹੋਇ ਦੇਹ ਅਰੋਗ ॥੪੭੬॥",
      "transliteration": "tab hoi dheh arog ||476||",
      "translation": "If He is comprehended through the medium off Yoga, only then the body (and the mind) will be completely healthy.476.",
      "punjabiViakhya": "ਤਦ ਜਾ ਕੇ ਦੇਹ ਅਰੋਗ ਹੋਵੇਗੀ ॥੪੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "तब होइ देह अरोग ॥४७६॥",
      "sourceLineId": "103937",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਬ ਏਕ ਪੁਰਖ ਪਛਾਨ ॥",
      "transliteration": "tab ek purakh pachhaan ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਕ ਪੁਰਖ ਦੀ ਪਛਾਣ (ਹੋਵੇਗੀ)",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "तब एक पुरख पछान ॥",
      "sourceLineId": "103938",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਗ ਨਾਸ ਜਾਹਿਨ ਜਾਨ ॥",
      "transliteration": "jag naas jaahin jaan ||",
      "translation": "Then the supreme essence will be known (when it will be realized) that He is also the destroyer of the world",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਜਗਤ ਦੇ ਨਾਸ਼ ਦਾ ਕਾਰਨ ਜਾਣਨਾ ਚਾਹੀਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "जग नास जाहिन जान ॥",
      "sourceLineId": "103939",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਬ ਜਗਤ ਕੋ ਪਤਿ ਦੇਖਿ ॥",
      "transliteration": "sab jagat ko pat dhekh ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਸਾਰੇ ਜਗਤ ਦਾ ਸੁਆਮੀ ਦੇਖਿਆ ਜਾਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "सब जगत को पति देखि ॥",
      "sourceLineId": "103940",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਨਭਉ ਅਨੰਤ ਅਭੇਖ ॥੪੭੭॥",
      "transliteration": "anabhau ana(n)t abhekh ||477||",
      "translation": "That master of the world is real and Lord is supremely absorbed and He is also beyond all forms.477.",
      "punjabiViakhya": "(ਉਹ) ਡਰ ਤੋਂ ਰਹਿਤ, ਅਨੰਤ ਅਤੇ ਅਭੇਖ ਹੈ ॥੪੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "अनभउ अनंत अभेख ॥४७७॥",
      "sourceLineId": "103941",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਿਨ ਏਕ ਨਾਹਿਨ ਸਾਤਿ ॥",
      "transliteration": "bin ek naahin saat ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਇਕ ਨੂੰ ਜਾਣੇ ਬਿਨਾ ਸ਼ਾਤੀ ਨਹੀਂ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "बिन एक नाहिन साति ॥",
      "sourceLineId": "103942",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਭ ਤੀਰਥ ਕਿਯੁੰ ਨ ਅਨਾਤ ॥",
      "transliteration": "sabh teerath kiyu(n) na anaat ||",
      "translation": "There will be no peace without that one Lord  the bath at all the pilgrim-stations will be fruitless",
      "punjabiViakhya": "(ਭਾਵੇਾਂ) ਸਾਰਿਆਂ ਤੀਰਥਾ ਦਾ ਇਸ਼ਨਾਨ ਕਿਉਾਂ ਨਾ ਕਰ ਲਈਏ।",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "सभ तीरथ कियुँ न अनात ॥",
      "sourceLineId": "103943",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਬ ਸੇਵਿਹੋ ਇਕਿ ਨਾਮ ॥",
      "transliteration": "jab seviho ik naam ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਇਕ ਨਾਮ ਨੂੰ ਸਿਮਰੋਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "जब सेविहो इकि नाम ॥",
      "sourceLineId": "103944",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਬ ਹੋਇ ਪੂਰਣ ਕਾਮ ॥੪੭੮॥",
      "transliteration": "tab hoi pooran kaam ||478||",
      "translation": "When service will be rendered to him and His Name will be remembered, then all the desires will be fulfilled.478.",
      "punjabiViakhya": "ਤਦ ਸਾਰੀਆਂ ਕਾਮਨਾਵਾ ਪੂਰੀਆਂ ਹੋਣਗੀਆਂ ॥੪੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "तब होइ पूरण काम ॥४७८॥",
      "sourceLineId": "103945",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਿਨੁ ਏਕ ਚੌਬਿਸ ਫੋਕ ॥",
      "transliteration": "bin ek chauabis fok ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਇਕ ਤੋਂ ਬਿਨਾ ਚੌਵੀ (ਗੁਰੂਆਂ ਦੀ ਸਿਖਿਆ) ਫੋਕੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "बिनु एक चौबिस फोक ॥",
      "sourceLineId": "103946",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਬ ਹੀ ਧਰਾ ਸਬ ਲੋਕ ॥",
      "transliteration": "sab hee dharaa sab lok ||",
      "translation": "Without that One Lord, all the twenty-four incarnation and all others are meaningless",
      "punjabiViakhya": "ਸਾਰੀ ਧਰਤੀ ਅਤੇ ਸਾਰੇ ਲੋਕ (ਵਿਅਰਥ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "सब ही धरा सब लोक ॥",
      "sourceLineId": "103947",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਿਨਿ ਏਕ ਕਉ ਪਹਿਚਾਨ ॥",
      "transliteration": "jin ek kau pahichaan ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੇ ਇਕ ਨੂੰ ਪਛਾਣ ਲਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "जिनि एक कउ पहिचान ॥",
      "sourceLineId": "103948",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਿਨ ਚਉਬਿਸੋ ਰਸ ਮਾਨ ॥੪੭੯॥",
      "transliteration": "tin chaubiso ras maan ||479||",
      "translation": "He, who recognizes the One Lord, he will remain jubilant even on adoring all the twenty-four incarnations.479.",
      "punjabiViakhya": "ਉਹ ਚੌਵੀਆਂ ਦਾ ਹੀ ਰਸ ਮਾਣਦਾ ਹੈ ॥੪੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "तिन चउबिसो रस मान ॥४७९॥",
      "sourceLineId": "103949",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜੇ ਏਕ ਕੇ ਰਸ ਭੀਨ ॥",
      "transliteration": "je ek ke ras bheen ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਇਕ ਦੇ ਰਸ (ਪ੍ਰੇਮ) ਵਿਚ ਭਿਜੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "जे एक के रस भीन ॥",
      "sourceLineId": "103950",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਤਿਨਿ ਚਉਬਿਸੋ ਰਸਿ ਲੀਨ ॥",
      "transliteration": "tin chaubiso ras leen ||",
      "translation": "He, who falls in love with the One Lord, he will feel happy in knowing about the wonderful works of all the twenty-four incarnations",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਚੌਵੀਆਂ ਦਾ ਰਸ ਲੈ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "तिनि चउबिसो रसि लीन ॥",
      "sourceLineId": "103951",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਿਨ ਏਕ ਕੋ ਨਹੀ ਬੂਝ ॥",
      "transliteration": "jin ek ko nahee boojh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੇ ਇਕ ਨੂੰ ਨਹੀਂ ਬੁਝਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "जिन एक को नही बूझ ॥",
      "sourceLineId": "103952",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਤਿਹ ਚਉਬਿਸੈ ਨਹੀ ਸੂਝ ॥੪੮੦॥",
      "transliteration": "teh chaubisai nahee soojh ||480||",
      "translation": "He, who does not recognize the One Lord, he cannot know the mysteries of the twenty-four incarnations.480.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਚੌਵੀਆਂ ਦੀ ਸੂਝ ਵੀ ਨਹੀਂ ਹੈ ॥੪੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 673,
      "hindi": "",
      "hindiTransliteration": "तिह चउबिसै नही सूझ ॥४८०॥",
      "sourceLineId": "103953",
      "sourceShabadId": "9375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0673_line_0052",
