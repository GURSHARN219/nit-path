{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 679,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0679_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਤ ਦੇਸ ਦੇਸ ਰਾਜਾ ਕਰੋਰ ॥",
      "transliteration": "mat dhes dhes raajaa karor ||",
      "translation": "In this way, Parasnath gathered together many brave fighters and kings of various countries far and near",
      "punjabiViakhya": "ਅਤੇ ਦੇਸ ਦੇਸ ਦੇ ਕਰੋੜਾ ਮਤਾ ਵਾਲੇ ਰਾਜੇ (ਬੁਲਾ ਲਏ)।",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "मत देस देस राजा करोर ॥",
      "sourceLineId": "104195",
      "sourceShabadId": "9383",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੇ ਹੀਰ ਚੀਰ ਬਹੁ ਦਿਰਬ ਸਾਜ ॥",
      "transliteration": "dhe heer cheer bahu dhirab saaj ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਹੀਰੇ, ਬਸਤ੍ਰ, ਧਨ, ਪਦਾਰਥ ਅਤੇ ਸਾਜ਼ ਸਾਮਾਨ",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "दे हीर चीर बहु दिरब साज ॥",
      "sourceLineId": "104196",
      "sourceShabadId": "9383",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਨਮਾਨ ਦਾਨ ਬਹੁ ਭਾਤਿ ਰਾਜ ॥੪੦॥",
      "transliteration": "sanamaan dhaan bahu bhaat raaj ||40||",
      "translation": "And honoured all of them donating wealth and garments to them.40.",
      "punjabiViakhya": "ਦਾਨ ਦੇ ਕੇ ਰਾਜੇ ਨੇ ਬਹੁਤ ਸਨਮਾਨ ਕੀਤਾ ॥੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "सनमान दान बहु भाति राज ॥४०॥",
      "sourceLineId": "104197",
      "sourceShabadId": "9383",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਨਭੈ ਅਭੰਗ ਅਵਧੂਤ ਛਤ੍ਰ ॥",
      "transliteration": "anabhai abha(n)g avadhoot chhatr ||",
      "translation": "",
      "punjabiViakhya": "ਡਰ ਤੋਂ ਰਹਿਤ, ਭੰਗ ਹੋਣ ਤੋਂ ਮੁਕਤ, ਅਵਧੂਤ, ਛਤ੍ਰਧਾਰੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "अनभै अभंग अवधूत छत्र ॥",
      "sourceLineId": "104198",
      "sourceShabadId": "9383",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਨਜੀਤ ਜੁਧ ਬੇਤਾ ਅਤਿ ਅਤ੍ਰ ॥",
      "transliteration": "anajeet judh betaa at atr ||",
      "translation": "There many canopied and fearless Yogis there",
      "punjabiViakhya": "ਨਾ ਜਿਤੇ ਜਾ ਸਕਣ ਵਾਲੇ, ਯੁੱਧ ਵਿਚ ਪ੍ਰਬੀਨ ਅਤੇ ਅਤਿ ਅਧਿਕ ਅਸਤ੍ਰਾ ਦੀ ਵਰਤੋਂ ਜਾਣਨ ਵਾਲੇ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "अनजीत जुध बेता अति अत्र ॥",
      "sourceLineId": "104199",
      "sourceShabadId": "9383",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਨਗੰਜ ਸੂਰ ਅਬਿਚਲ ਜੁਝਾਰ ॥",
      "transliteration": "anaga(n)j soor abichal jujhaar ||",
      "translation": "",
      "punjabiViakhya": "ਨਾ ਗੰਜੇ ਜਾ ਸਕਣ ਵਾਲੇ ਸੂਰਮੇ ਅਤੇ ਅਚਲ ਲੜਾਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "अनगंज सूर अबिचल जुझार ॥",
      "sourceLineId": "104200",
      "sourceShabadId": "9383",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਣ ਰੰਗ ਅਭੰਗ ਜਿਤੇ ਹਜਾਰ ॥੪੧॥",
      "transliteration": "ran ra(n)g abha(n)g jite hajaar ||41||",
      "translation": "There were seated there unconquerable warriors, experts in arms and weapons, indestructible fighters, many mighty heroes, who had conquered thousand of wars.41.",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਹਜ਼ਾਰਾ ਅਭੰਗ ਯੋਧੇ ਜਿਤੇ ਹੋਏ ਸਨ ॥੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "रण रंग अभंग जिते हजार ॥४१॥",
      "sourceLineId": "104201",
      "sourceShabadId": "9383",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਬ ਦੇਸ ਦੇਸ ਕੇ ਜੀਤ ਰਾਵ ॥",
      "transliteration": "sab dhes dhes ke jeet raav ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਦੇਸਾ ਦੇਸਾਤਰਾ ਦੇ ਰਾਜੇ ਜਿਤ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "सब देस देस के जीत राव ॥",
      "sourceLineId": "104202",
      "sourceShabadId": "9383",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਰ ਕ੍ਰੁਧ ਜੁਧ ਨਾਨਾ ਉਪਾਵ ॥",
      "transliteration": "kar krudh judh naanaa upaav ||",
      "translation": "Parasnath had taken various kinds of measures, had conquered the kings of various countries in wars",
      "punjabiViakhya": "ਅਤੇ ਕ੍ਰੋਧ ਕਰ ਕੇ ਅਨੇਕ ਉਪਾਵਾ ਵਾਲੇ ਯੁੱਧ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "कर क्रुध जुध नाना उपाव ॥",
      "sourceLineId": "104203",
      "sourceShabadId": "9383",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕੈ ਸਾਮ ਦਾਮ ਅਰੁ ਦੰਡ ਭੇਦ ॥",
      "transliteration": "kai saam dhaam ar dha(n)dd bhedh ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਮ, ਦਾਨ, ਦੰਡ ਅਤੇ ਭੇਦ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "कै साम दाम अरु दंड भेद ॥",
      "sourceLineId": "104204",
      "sourceShabadId": "9383",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਵਨੀਪ ਸਰਬ ਜੋਰੇ ਅਛੇਦ ॥੪੨॥",
      "transliteration": "avaneep sarab jore achhedh ||42||",
      "translation": "On the strength of Saam Daam, Dand and Bhed, he brought all together and brought them his control.42.",
      "punjabiViakhya": "ਨਾ ਛੇਦੇ ਜਾ ਸਕਣ ਵਾਲੇ ਰਾਜੇ ('ਅਵਨੀਪ') ਜੋੜ ਲਏ ਸਨ ॥੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "अवनीप सरब जोरे अछेद ॥४२॥",
      "sourceLineId": "104205",
      "sourceShabadId": "9383",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਬ ਸਰਬ ਭੂਪ ਜੋਰੇ ਮਹਾਨ ॥",
      "transliteration": "jab sarab bhoop jore mahaan ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸਾਰੇ ਮਹਾਨ ਰਾਜੇ ਇਕੱਠੇ ਕਰ ਲਏ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "जब सरब भूप जोरे महान ॥",
      "sourceLineId": "104206",
      "sourceShabadId": "9383",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੈ ਜੀਤ ਪਤ੍ਰ ਦਿਨੋ ਨਿਸਾਨ ॥",
      "transliteration": "jai jeet patr dhino nisaan ||",
      "translation": "When all the kings were brought together by the great Parasnath and al of them gave him the letter of victory,",
      "punjabiViakhya": "(ਤਦ) ਜਿਤ ਦਾ ਪੱਤਰ ਜਾਰੀ ਕਰ ਕੇ ਧੌਂਸਾ ਵਜਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "जै जीत पत्र दिनो निसान ॥",
      "sourceLineId": "104207",
      "sourceShabadId": "9383",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੈ ਹੀਰ ਚੀਰ ਅਨਭੰਗ ਦਿਰਬ ॥",
      "transliteration": "dhai heer cheer anabha(n)g dhirab ||",
      "translation": "",
      "punjabiViakhya": "ਹੀਰੇ, ਬਸਤ੍ਰ, ਅਮੁਕ ਧਨ ਦੇ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "दै हीर चीर अनभंग दिरब ॥",
      "sourceLineId": "104208",
      "sourceShabadId": "9383",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਹਿਪਾਲ ਮੋਹਿ ਡਾਰੇ ਸੁ ਸਰਬ ॥੪੩॥",
      "transliteration": "mahipaal moh ddaare su sarab ||43||",
      "translation": "Then Parasnath gave unlimited wealth and garments to them and allured them.43.",
      "punjabiViakhya": "ਸਾਰੇ ਰਾਜੇ ਮੋਹ ਲਏ ॥੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "महिपाल मोहि डारे सु सरब ॥४३॥",
      "sourceLineId": "104209",
      "sourceShabadId": "9383",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਇਕ ਦਯੋਸ ਬੀਤ ਪਾਰਸ੍ਵ ਰਾਇ ॥",
      "transliteration": "eik dhayos beet paarasavai rai ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਇਕ ਦਿਨ ਬੀਤ ਗਿਆ ਤਾ ਪਾਰਸ ਨਾਥ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "इक दयोस बीत पारस्व राइ ॥",
      "sourceLineId": "104210",
      "sourceShabadId": "9383",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਉਤਿਸਟ ਦੇਵਿ ਪੂਜੰਤ ਜਾਇ ॥",
      "transliteration": "autisaT dhev pooja(n)t jai ||",
      "translation": "One day, Parasnath went for the worship of the goddess",
      "punjabiViakhya": "ਸ੍ਰੇਸ਼ਠ ਇਸ਼ਟ ਦੇਵੀ ਦੀ ਜਾ ਕੇ ਪੂਜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "उतिसट देवि पूजंत जाइ ॥",
      "sourceLineId": "104211",
      "sourceShabadId": "9383",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਉਸਤਤਿ ਕਿਨ ਬਹੁ ਬਿਧਿ ਪ੍ਰਕਾਰ ॥",
      "transliteration": "ausatat kin bahu bidh prakaar ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਉਸਤਤ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "उसतति किन बहु बिधि प्रकार ॥",
      "sourceLineId": "104212",
      "sourceShabadId": "9383",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੋ ਕਹੋ ਛੰਦ ਮੋਹਣਿ ਮਝਾਰ ॥੪੪॥",
      "transliteration": "so kaho chha(n)dh mohan majhaar ||44||",
      "translation": "He adored her in various ways, whose description here I have composed in Mohani Stanza.44.",
      "punjabiViakhya": "ਉਸ ਨੂੰ (ਮੈਂ) ਮੋਹਣੀ ਛੰਦ ਵਿਚ ਕਹਿੰਦਾ ਹਾ ॥੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "सो कहो छंद मोहणि मझार ॥४४॥",
      "sourceLineId": "104213",
      "sourceShabadId": "9383",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮੋਹਣੀ ਛੰਦ ॥",
      "transliteration": "mohanee chha(n)dh ||",
      "translation": "MOHANI STANZA",
      "punjabiViakhya": "ਮੋਹਣੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "मोहणी छंद ॥",
      "sourceLineId": "104214",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜੈ ਦੇਵੀ ਭੇਵੀ ਭਾਵਾਣੀ ॥",
      "transliteration": "jai dhevee bhevee bhaavaanee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਭੇਦ ਤੋਂ ਬਿਨਾ ਭਵਾਨੀ ਦੇਵੀ! ਤੇਰੀ ਜੈ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "जै देवी भेवी भावाणी ॥",
      "sourceLineId": "104215",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਭਉ ਖੰਡੀ ਦੁਰਗਾ ਸਰਬਾਣੀ ॥",
      "transliteration": "bhau kha(n)ddee dhuragaa sarabaanee ||",
      "translation": "“Hail, O Bhairavi, Durga, You are the destroyer of fear, You ferry across the ocean of existence,",
      "punjabiViakhya": "(ਤੂੰ) ਸਾਰਿਆਂ ਦਾ ਭੈ ਖੰਡਣ ਵਾਲੀ ਦੁਰਗਾ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "भउ खंडी दुरगा सरबाणी ॥",
      "sourceLineId": "104216",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕੇਸਰੀਆ ਬਾਹੀ ਕਊਮਾਰੀ ॥",
      "transliteration": "kesareeaa baahee kuoomaaree ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੇਰ ਦੀ ਸਵਾਰੀ ਕਰਨ ਵਾਲੀ ਅਤੇ ਸਦਾ ਕੰਵਾਰੀ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "केसरीआ बाही कऊमारी ॥",
      "sourceLineId": "104217",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭੈਖੰਡੀ ਭੈਰਵਿ ਉਧਾਰੀ ॥੪੫॥",
      "transliteration": "bhaikha(n)ddee bhairav udhaaree ||45||",
      "translation": "the rider of the lion, the destroyer of fear and generous Creator!45.",
      "punjabiViakhya": "ਭੈ ਨੂੰ ਖੰਡਣ ਵਾਲੀ, ਭੈਰਵੀ ਅਤੇ ਉੱਧਾਰ ਕਰਨ ਵਾਲੀ ਹੈਂ ॥੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "भैखंडी भैरवि उधारी ॥४५॥",
      "sourceLineId": "104218",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਕਲੰਕਾ ਅਤ੍ਰੀ ਛਤ੍ਰਾਣੀ ॥",
      "transliteration": "akala(n)kaa atree chhatraanee ||",
      "translation": "",
      "punjabiViakhya": "ਕਲੰਕ ਤੋਂ ਰਹਿਤ, ਅਸਤ੍ਰਾ ਵਾਲੀ, ਛਤ੍ਰਾਣੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "अकलंका अत्री छत्राणी ॥",
      "sourceLineId": "104219",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੋਹਣੀਅੰ ਸਰਬੰ ਲੋਕਾਣੀ ॥",
      "transliteration": "mohaneea(n) saraba(n) lokaanee ||",
      "translation": "“You are blemishless, adopter of arms, the fascinator of all the worlds, the Kshatriya goddess",
      "punjabiViakhya": "ਸਭ ਲੋਕਾ ਨੂੰ ਮੋਹ ਲੈਣ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "मोहणीअं सरबं लोकाणी ॥",
      "sourceLineId": "104220",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰਕਤਾਗੀ ਸਾਗੀ ਸਾਵਿਤ੍ਰੀ ॥",
      "transliteration": "rakataagee saagee saavitree ||",
      "translation": "",
      "punjabiViakhya": "ਲਾਲ ਸ਼ਰੀਰ ਵਾਲੀ, ਸਾਗ ਧਾਰਨ ਕਰਨ ਵਾਲੀ, ਸਾਵਿਤ੍ਰੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "रकतागी सागी सावित्री ॥",
      "sourceLineId": "104221",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪਰਮੇਸ੍ਰੀ ਪਰਮਾ ਪਾਵਿਤ੍ਰੀ ॥੪੬॥",
      "transliteration": "paramesree paramaa paavitree ||46||",
      "translation": "You are Sati Savitri with blood-saturated limbs and the Supremely Immaculate Parmeshwari.46.",
      "punjabiViakhya": "ਪਰਮੇਸ਼੍ਵਰੀ, ਅਤੇ ਪਰਮ ਪਵਿਤ੍ਰ ਦੇਵੀ ਹੈਂ ॥੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "परमेस्री परमा पावित्री ॥४६॥",
      "sourceLineId": "104222",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤੋਤਲੀਆ ਜਿਹਬਾ ਕਊਮਾਰੀ ॥",
      "transliteration": "totaleeaa jihabaa kuoomaaree ||",
      "translation": "“You are the youthful goddess of sweet words",
      "punjabiViakhya": "ਤੋਤਲੀ ਜ਼ਬਾਨ ਵਾਲੀ ਅਤੇ (ਸਦੀਵੀ) ਕੁਮਾਰੀ (ਕੰਵਾਰੀ)",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "तोतलीआ जिहबा कऊमारी ॥",
      "sourceLineId": "104223",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭਵ ਭਰਣੀ ਹਰਣੀ ਉਧਾਰੀ ॥",
      "transliteration": "bhav bharanee haranee udhaaree ||",
      "translation": "You are the destroyer of worldly sufferings and redeemer of all",
      "punjabiViakhya": "ਸੰਸਾਰ ਨੂੰ ਭਰਨ ਵਾਲੀ, ਹਰਨ ਵਾਲੀ (ਨਸ਼ਟ ਕਰਨ ਵਾਲੀ) ਅਤੇ ਉੱਧਾਰ ਕਰਨ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "भव भरणी हरणी उधारी ॥",
      "sourceLineId": "104224",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮ੍ਰਿਦੁ ਰੂਪਾ ਭੂਪਾ ਬੁਧਾਣੀ ॥",
      "transliteration": "miradh roopaa bhoopaa budhaanee ||",
      "translation": "You are Rajeshwari full of beauty and wisdom",
      "punjabiViakhya": "ਕੋਮਲ ਰੂਪ ਵਾਲੀ, ਸ਼ਿਰੋਮਣੀ ਬੁੱਧੀ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "मृदु रूपा भूपा बुधाणी ॥",
      "sourceLineId": "104225",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜੈ ਜੰਪੈ ਸੁਧੰ ਸਿਧਾਣੀ ॥੪੭॥",
      "transliteration": "jai ja(n)pai sudha(n) sidhaanee ||47||",
      "translation": "I hail you, O the attainer of all powers.47.",
      "punjabiViakhya": "ਸ਼ੁੱਧ ਸਿੱਧੀਆਂ ਵਾਲੀ (ਹੇ ਦੇਵੀ! ਤੇਰੀ) ਜੈ ਜੈ ਜਪਦੇ ਹਾ ॥੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "जै जंपै सुधं सिधाणी ॥४७॥",
      "sourceLineId": "104226",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਗ ਧਾਰੀ ਭਾਰੀ ਭਗਤਾਯੰ ॥",
      "transliteration": "jag dhaaree bhaaree bhagataaya(n) ||",
      "translation": "“O supporter of the world! You are superb for the devotees",
      "punjabiViakhya": "ਜਗਤ ਨੂੰ ਧਾਰਨ ਕਰਨ ਵਾਲੀ, ਭਗਤਾ ਦੀ ਭਾਰੀ (ਚਿੰਤਾ ਕਰਨ ਵਾਲੀ)",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "जग धारी भारी भगतायं ॥",
      "sourceLineId": "104227",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਰਿ ਧਾਰੀ ਭਾਰੀ ਮੁਕਤਾਯੰ ॥",
      "transliteration": "kar dhaaree bhaaree mukataaya(n) ||",
      "translation": "Holding the arms and weapons in your hands",
      "punjabiViakhya": "ਅਤੇ ਹੱਥ ਵਿਚ ਭਾਰੀ ਮੁਕਤੀ ਨੂੰ ਧਾਰਨ ਕਰਨ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "करि धारी भारी मुकतायं ॥",
      "sourceLineId": "104228",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੁੰਦਰ ਗੋਫਣੀਆ ਗੁਰਜਾਣੀ ॥",
      "transliteration": "su(n)dhar gofaneeaa gurajaanee ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਗੋਫਣੀ (ਵੱਡੀ ਗੁਲੇਲ) ਅਤੇ ਗੁਰਜ ਧਾਰਨ ਕਰਨ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "सुँदर गोफणीआ गुरजाणी ॥",
      "sourceLineId": "104229",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤੇ ਬਰਣੀ ਹਰਣੀ ਭਾਮਾਣੀ ॥੪੮॥",
      "transliteration": "te baranee haranee bhaamaanee ||48||",
      "translation": "You have the revolving maces in your hand and on their strength, You appear to be Supreme.48.",
      "punjabiViakhya": "ਵਰ ਦੇਣ ਵਾਲੀ ਅਤੇ ਫਿਰ ਹਰਨ ਵਾਲੀ ਇਸਤਰੀ ਹੈਂ ॥੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "ते बरणी हरणी भामाणी ॥४८॥",
      "sourceLineId": "104230",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭਿੰਭਰੀਆ ਜਛੰ ਸਰਬਾਣੀ ॥",
      "transliteration": "bhi(n)bhareeaa jachha(n) sarabaanee ||",
      "translation": "“You are superb amongst Yakshas and Kinnars",
      "punjabiViakhya": "ਭੈ ਨਾਲ ਭਰਨ ਵਾਲੀ ('ਭਿੰਭਰੀਆ') ਸਾਰਿਆਂ ਰੂਪਾ ਵਾਲੀ ਯਕਸ਼ਣੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "भिंभरीआ जछं सरबाणी ॥",
      "sourceLineId": "104231",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਗੰਧਰਬੀ ਸਿਧੰ ਚਾਰਾਣੀ ॥",
      "transliteration": "ga(n)dharabee sidha(n) chaaraanee ||",
      "translation": "The Gandharvas and Siddhas (adepts) remain present at your feet",
      "punjabiViakhya": "ਗੰਧਰਬਣੀ, ਸਿੱਧਣੀ, ਚਾਰਣੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "गंधरबी सिधं चाराणी ॥",
      "sourceLineId": "104232",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਕਲੰਕ ਸਰੂਪੰ ਨਿਰਮਲੀਅੰ ॥",
      "transliteration": "akala(n)k saroopa(n) niramaleea(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਲੰਕ ਰਹਿਤ ਅਤੇ ਨਿਰਮਲ ਸਰੂਪ ਵਾਲੀ",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "अकलंक सरूपं निरमलीअं ॥",
      "sourceLineId": "104233",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਘਣ ਮਧੇ ਮਾਨੋ ਚੰਚਲੀਅੰ ॥੪੯॥",
      "transliteration": "ghan madhe maano cha(n)chaleea(n) ||49||",
      "translation": "Your figure is pure like the lightning in clouds.49.",
      "punjabiViakhya": "ਅਤੇ ਮਾਨੋ ਬਦਲਾ ਵਿਚ ਬਿਜਲੀ ਵਾਗ ਹੈ ॥੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "घण मधे मानो चंचलीअं ॥४९॥",
      "sourceLineId": "104234",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਸਿਪਾਣੰ ਮਾਣੰ ਲੋਕਾਯੰ ॥",
      "transliteration": "asipaana(n) maana(n) lokaaya(n) ||",
      "translation": "“Holding the sword in your hand, You honour the saints,",
      "punjabiViakhya": "ਹੱਥ ਵਿਚ ਤਲਵਾਰ ਧਾਰਨ ਕਰਨ ਵਾਲੀ ਅਤੇ ਲੋਕਾ ਦੇ ਮਾਣ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "असिपाणं माणं लोकायं ॥",
      "sourceLineId": "104235",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੁਖ ਕਰਣੀ ਹਰਣੀ ਸੋਕਾਯੰ ॥",
      "transliteration": "sukh karanee haranee sokaaya(n) ||",
      "translation": "The giver of comfort and destroyer of sorrow",
      "punjabiViakhya": "ਸੁਖ ਦੇਣ ਵਾਲੀ ਅਤੇ ਸ਼ੋਕ ਨੂੰ ਦੂਰ ਕਰਨ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "सुख करणी हरणी सोकायं ॥",
      "sourceLineId": "104236",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦੁਸਟ ਹੰਤੀ ਸੰਤੰ ਉਧਾਰੀ ॥",
      "transliteration": "dhusaT ha(n)tee sa(n)ta(n) udhaaree ||",
      "translation": "You are the destroyer of tyrants, redeemer of the saints",
      "punjabiViakhya": "ਦੁਸ਼ਟਾ ਨੂੰ ਮਾਰਨ ਵਾਲੀ, ਸੰਤਾ ਦਾ ਉੱਧਾਰ ਕਰਨ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "दुसट हंती संतं उधारी ॥",
      "sourceLineId": "104237",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਨਛੇਦਾਭੇਦਾ ਕਉਮਾਰੀ ॥੫੦॥",
      "transliteration": "anachhedhaabhedhaa kaumaaree ||50||",
      "translation": "You are invincible and treasure of Virtues.50.",
      "punjabiViakhya": "ਨਾ ਛੇਦੇ ਜਾ ਸਕਣ ਵਾਲੀ, ਭੇਦ ਰਹਿਤ ਕੁਮਾਰੀ ॥੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "अनछेदाभेदा कउमारी ॥५०॥",
      "sourceLineId": "104238",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਆਨੰਦੀ ਗਿਰਜਾ ਕਉਮਾਰੀ ॥",
      "transliteration": "aana(n)dhee girajaa kaumaaree ||",
      "translation": "“You are he bliss-giving girija Kumari",
      "punjabiViakhya": "ਆਨੰਦ ਦੇਣ ਵਾਲੀ, ਪਾਰਬਤੀ, ਕੁਮਾਰੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "आनंदी गिरजा कउमारी ॥",
      "sourceLineId": "104239",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਨਛੇਦਾਭੇਦਾ ਉਧਾਰੀ ॥",
      "transliteration": "anachhedhaabhedhaa udhaaree ||",
      "translation": "You are indestructible, the destroyer of all and the redeemer of all",
      "punjabiViakhya": "ਨਾ ਛੇਦੇ ਜਾ ਸਕਣ ਵਾਲੀ, ਨਾ ਭੇਦੇ ਜਾ ਸਕਣ ਵਾਲੀ, ਉੱਧਾਰ ਕਰਨ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "अनछेदाभेदा उधारी ॥",
      "sourceLineId": "104240",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਨਗੰਜ ਅਭੰਜਾ ਖੰਕਾਲੀ ॥",
      "transliteration": "anaga(n)j abha(n)jaa kha(n)kaalee ||",
      "translation": "You are the eternal goddess Kali, but alongwith it,",
      "punjabiViakhya": "ਨਾ ਗੰਜੇ ਜਾ ਸਕਣ ਵਾਲੀ, ਨਾ ਭੰਨੇ ਜਾ ਸਕਣ ਵਾਲੀ, ਭਿਆਨਕ ਰੂਪ ਵਾਲੀ ('ਖੰਕਾਲੀ')",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "अनगंज अभंजा खंकाली ॥",
      "sourceLineId": "104241",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮ੍ਰਿਗਨੈਣੀ ਰੂਪੰ ਉਜਾਲੀ ॥੫੧॥",
      "transliteration": "miraganainee roopa(n) ujaalee ||51||",
      "translation": "You are the doe-eyed most beautiful goddess.51.",
      "punjabiViakhya": "ਹਿਰਨ ਵਰਗੀਆਂ ਅੱਖਾ ਵਾਲੀ ਅਤੇ ਉਜਲੇ ਰੂਪ ਵਾਲੀ ਹੈਂ ॥੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "मृगनैणी रूपं उजाली ॥५१॥",
      "sourceLineId": "104242",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਰਕਤਾਗੀ ਰੁਦ੍ਰਾ ਪਿੰਗਾਛੀ ॥",
      "transliteration": "rakataagee rudhraa pi(n)gaachhee ||",
      "translation": "“You are the wife of Rudra with blood-saturated limbs",
      "punjabiViakhya": "ਲਾਲ ਰੰਗ ਦੇ ਸ਼ਰੀਰ ਵਾਲੀ, ਰੁਦ੍ਰ ਦੀ ਸ਼ਕਤੀ, ਭੂਰੀਆਂ ਅੱਖਾ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "रकतागी रुद्रा पिंगाछी ॥",
      "sourceLineId": "104243",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਟਿ ਕਛੀ ਸ੍ਵਛੀ ਹੁਲਾਸੀ ॥",
      "transliteration": "kaT kachhee savaichhee hulaasee ||",
      "translation": "You are the chopper of all, but You are also Pure and Bliss-giving goddess",
      "punjabiViakhya": "ਲਕ ਤੇ ਕਛਨੀ ਪਹਿਨਣ ਵਾਲੀ, ਨਿਰਮਲ ਰੂਪ ਵਾਲੀ, ਹੁਲਾਸ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "कटि कछी स्वछी हुलासी ॥",
      "sourceLineId": "104244",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਰਕਤਾਲੀ ਰਾਮਾ ਧਉਲਾਲੀ ॥",
      "transliteration": "rakataalee raamaa dhaulaalee ||",
      "translation": "You are the mistress of activity and harmony",
      "punjabiViakhya": "ਲਾਲ ਰੰਗ ਵਾਲੀ, ਰਾਮ ਦੀ ਸ਼ਕਤੀ, ਸਫੈਦ ਸਰੂਪ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "रकताली रामा धउलाली ॥",
      "sourceLineId": "104245",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮੋਹਣੀਆ ਮਾਈ ਖੰਕਾਲੀ ॥੫੨॥",
      "transliteration": "mohaneeaa maiee kha(n)kaalee ||52||",
      "translation": "You are the alluring deity and the sword-bearing Kali.52.",
      "punjabiViakhya": "ਮੋਹਿਤ ਕਰਨ ਵਾਲੀ ਅਤੇ ਭਿਆਨਕ ਰੂਪ ਵਾਲੀ ਮਾਤਾ ਹੈਂ ॥੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "मोहणीआ माई खंकाली ॥५२॥",
      "sourceLineId": "104246",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਗਦਾਨੀ ਮਾਨੀ ਭਾਵਾਣੀ ॥",
      "transliteration": "jagadhaanee maanee bhaavaanee ||",
      "translation": "",
      "punjabiViakhya": "ਜਗਤ ਨੂੰ ਦਾਨ ਅਤੇ ਮਾਣ ਦੇਣ ਵਾਲੀ ਸ਼ਿਵ ਦੀ ਸ਼ਕਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "जगदानी मानी भावाणी ॥",
      "sourceLineId": "104247",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਭਵਖੰਡੀ ਦੁਰਗਾ ਦੇਵਾਣੀ ॥",
      "transliteration": "bhavakha(n)ddee dhuragaa dhevaanee ||",
      "translation": "“You are the Donor of gifts and the destroyer of the world, the goddess Durga!",
      "punjabiViakhya": "ਸੰਸਾਰ ਦੇ ਭੈ ਨੂੰ ਖੰਡਨ ਕਰਨ ਵਾਲੀ, ਦੁਰਗ ਦੈਂਤ ਨੂੰ ਮਾਰਨ ਵਾਲੀ ਅਤੇ ਦੇਵਤਿਆਂ ਦੀ ਸ਼ਕਤੀ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "भवखंडी दुरगा देवाणी ॥",
      "sourceLineId": "104248",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਰੁਦ੍ਰਾਗੀ ਰੁਦ੍ਰਾ ਰਕਤਾਗੀ ॥",
      "transliteration": "rudhraagee rudhraa rakataagee ||",
      "translation": "You sit on the left limb of Rudra, the blood-coloured goddess",
      "punjabiViakhya": "ਰੁਦ੍ਰ ਦੇ ਅੱਧੇ ਸ਼ਰੀਰ ਵਾਲੀ, ਰੁਦ੍ਰ ਦੀ ਸ਼ਕਤੀ ਅਤੇ ਲਾਲ ਰੰਗ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "रुद्रागी रुद्रा रकतागी ॥",
      "sourceLineId": "104249",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਪਰਮੇਸਰੀ ਮਾਈ ਧਰਮਾਗੀ ॥੫੩॥",
      "transliteration": "paramesaree maiee dharamaagee ||53||",
      "translation": "You are Parmeshwari and the Piety-adopting Mother.53.",
      "punjabiViakhya": "ਪਰਮ ਐਸ਼ਵਰਜ ਵਾਲੀ, ਧਰਮ ਦੇ ਸਰੂਪ ਵਾਲੀ ਮਾਤਾ ਹੈਂ ॥੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "परमेसरी माई धरमागी ॥५३॥",
      "sourceLineId": "104250",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਮਹਿਖਾਸੁਰ ਦਰਣੀ ਮਹਿਪਾਲੀ ॥",
      "transliteration": "mahikhaasur dharanee mahipaalee ||",
      "translation": "“You are the killer of Mahishasura You are kali,",
      "punjabiViakhya": "ਮਹਿਖਾਸੁਰ ਦੈਂਤ ਨੂੰ ਦਲਣ ਵਾਲੀ, ਧਰਤੀ ਦੀ ਪਾਲਣਾ ਕਰਨ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "महिखासुर दरणी महिपाली ॥",
      "sourceLineId": "104251",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਚਿਛੁਰਾਸਰ ਹੰਤੀ ਖੰਕਾਲੀ ॥",
      "transliteration": "chichhuraasar ha(n)tee kha(n)kaalee ||",
      "translation": "The destroyer of Chachhasura and also the Sustainer of the earth",
      "punjabiViakhya": "ਚਿਛੁਰ ਦੈਂਤ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲੀ, ਭਿਆਨਕ ਰੂਪ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "चिछुरासर हंती खंकाली ॥",
      "sourceLineId": "104252",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਅਸਿ ਪਾਣੀ ਮਾਣੀ ਦੇਵਾਣੀ ॥",
      "transliteration": "as paanee maanee dhevaanee ||",
      "translation": "You are the pride of he goddesses,",
      "punjabiViakhya": "ਹੱਥ ਵਿਚ ਤਲਵਾਰ ਧਾਰਨ ਕਰਨ ਵਾਲੀ, ਮਾਣ ਪ੍ਰਾਪਤ ਕਰਾਉਣ ਵਾਲੀ, ਦੇਵਤਿਆਂ ਦੀ ਸ਼ਕਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "असि पाणी माणी देवाणी ॥",
      "sourceLineId": "104253",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਜੈ ਦਾਤੀ ਦੁਰਗਾ ਭਾਵਾਣੀ ॥੫੪॥",
      "transliteration": "jai dhaatee dhuragaa bhaavaanee ||54||",
      "translation": "The carrier of sword in the hand and Durga, the Giver of Victory.54.",
      "punjabiViakhya": "ਜੈ ਦੇਣ ਵਾਲੀ, ਦੁਰਗ ਦੈਂਤ ਨੂੰ ਮਾਰਨ ਵਾਲੀ ਭਵਾਨੀ ਹੈਂ ॥੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "जै दाती दुरगा भावाणी ॥५४॥",
      "sourceLineId": "104254",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਪਿੰਗਾਛੀ ਪਰਮਾ ਪਾਵਿਤ੍ਰੀ ॥",
      "transliteration": "pi(n)gaachhee paramaa paavitree ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਭੂਰੀਆਂ ਅੱਖਾ ਵਾਲੀ ਪਰਮ ਅਤੇ ਪਵਿਤ੍ਰ ਰੂਪ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "पिंगाछी परमा पावित्री ॥",
      "sourceLineId": "104255",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਸਾਵਿਤ੍ਰੀ ਸੰਧਿਆ ਗਾਇਤ੍ਰੀ ॥",
      "transliteration": "saavitree sa(n)dhiaa gaitree ||",
      "translation": "“You are the brown-eyed immaculate Parvati, Savitri and Gayatri",
      "punjabiViakhya": "ਸਾਵਿਤ੍ਰੀ, ਸੰਧਿਆ, ਗਾਇਤ੍ਰੀ, ਭੈ ਨੂੰ ਦੂਰ ਕਰਨ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "सावित्री संधिआ गाइत्री ॥",
      "sourceLineId": "104256",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਭੈ ਹਰਣੀ ਭੀਮਾ ਭਾਮਾਣੀ ॥",
      "transliteration": "bhai haranee bheemaa bhaamaanee ||",
      "translation": "You are the remover of fear, the mighty goddess Durga",
      "punjabiViakhya": "ਭਿਆਨਕ ਰੂਪ ਵਾਲੀ, ਇਸਤਰੀ ਸਰੂਪ ਵਾਲੀ (ਅਰਥਾਤਰ-ਪ੍ਰੇਮ ਕਰਨ ਵਾਲੀ) ਦੁਰਗ ਦੈਂਤ ਨੂੰ ਮਾਰਨ ਵਾਲੀ",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "भै हरणी भीमा भामाणी ॥",
      "sourceLineId": "104257",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਜੈ ਦੇਵੀ ਦੁਰਗਾ ਦੇਵਾਣੀ ॥੫੫॥",
      "transliteration": "jai dhevee dhuragaa dhevaanee ||55||",
      "translation": "Hail, hail to Thee.55.",
      "punjabiViakhya": "ਅਤੇ ਦੇਵਤਿਆਂ ਦੀ ਸ਼ਕਤੀ ਰੂਪ ਦੇਵੀ! ਤੇਰੀ ਜੈ ਹੋਵੇ ॥੫੫॥",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "जै देवी दुरगा देवाणी ॥५५॥",
      "sourceLineId": "104258",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਦੁਰਗਾ ਦਲ ਗਾਹੀ ਦੇਵਾਣੀ ॥",
      "transliteration": "dhuragaa dhal gaahee dhevaanee ||",
      "translation": "You are the mother Durga,",
      "punjabiViakhya": "ਹੇ ਦਲਾ ਨੂੰ ਗਾਹਣ ਵਾਲੀ ਦੁਰਗਾ ਅਤੇ ਦੇਵਤਿਆਂ ਦੀ ਸ਼ਕਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "दुरगा दल गाही देवाणी ॥",
      "sourceLineId": "104259",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਭੈ ਖੰਡੀ ਸਰਬੰ ਭੂਤਾਣੀ ॥",
      "transliteration": "bhai kha(n)ddee saraba(n) bhootaanee ||",
      "translation": "“You are the destroyer of armies in the war, the perisher of the fear of all",
      "punjabiViakhya": "ਸਾਰੇ ਜੀਵਾ ਦੇ ਭੈ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "भै खंडी सरबं भूताणी ॥",
      "sourceLineId": "104260",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਜੈ ਚੰਡੀ ਮੁੰਡੀ ਸਤ੍ਰੁ ਹੰਤੀ ॥",
      "transliteration": "jai cha(n)ddee mu(n)ddee satr ha(n)tee ||",
      "translation": "The killer of the enemies like Chand and Mund,",
      "punjabiViakhya": "ਚੰਡ ਅਤੇ ਮੁੰਡ ਨੂੰ ਮਾਰਨ ਵਾਲੀ, ਵੈਰੀਆਂ ਦਾ ਨਾਸ਼ ਕਰਨ ਵਾਲੀ (ਤੇਰੀ) ਜੈ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "जै चंडी मुँडी सत्रु हंती ॥",
      "sourceLineId": "104261",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਜੈ ਦਾਤੀ ਮਾਤਾ ਜੈਅੰਤੀ ॥੫੬॥",
      "transliteration": "jai dhaatee maataa jaia(n)tee ||56||",
      "translation": "Hail, O goddess, the giver of victory.56.",
      "punjabiViakhya": "ਹੇ ਅੰਤ ਵਿਚ ਜੈ ਦੇਣ ਵਾਲੀ ਮਾਤਾ! (ਤੇਰੀ) ਜੈ ਹੋਵੇ ॥੫੬॥",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "जै दाती माता जैअंती ॥५६॥",
      "sourceLineId": "104262",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਸੰਸਰਣੀ ਤਰਾਣੀ ਲੋਕਾਣੀ ॥",
      "transliteration": "sa(n)saranee taraanee lokaanee ||",
      "translation": "“You are the one who ferries across the ocean of the world",
      "punjabiViakhya": "ਹੇ ਸੰਸੇ (ਨਾਲ ਭਰੇ ਹੋਏ ਸੰਸਾਰ) ਤੋਂ ਲੋਕਾ ਨੂੰ ਤਾਰਨ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 679,
      "hindi": "",
      "hindiTransliteration": "संसरणी तराणी लोकाणी ॥",
      "sourceLineId": "104263",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0679_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਭਿੰਭਰਾਣੀ ਦਰਣੀ ਦਈਤਾਣੀ ॥",
      "transliteration": "bhi(n)bharaanee dharanee dhieetaanee ||",
      "translation": "You are the one who roams and crushes everyone",
