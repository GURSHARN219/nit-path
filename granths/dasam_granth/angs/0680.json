{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 680,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0680_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੁੰਭ ਹੰਤੀ ਜਯੰਤੀ ਖੰਕਾਲੀ ॥",
      "transliteration": "su(n)bh ha(n)tee jaya(n)tee kha(n)kaalee ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੁੰਭ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲੀ, ਜੈ ਕਰਨ ਵਾਲੀ, ਭਿਆਨਕ ਰੂਪ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "सुँभ हंती जयंती खंकाली ॥",
      "sourceLineId": "104267",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕੰਕੜੀਆ ਰੂਪਾ ਰਕਤਾਲੀ ॥",
      "transliteration": "ka(n)kaReeaa roopaa rakataalee ||",
      "translation": "",
      "punjabiViakhya": "ਭੈਰਵ ਰੂਪ ਵਾਲੀ, ਲਾਲ ਰੰਗ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "कंकड़ीआ रूपा रकताली ॥",
      "sourceLineId": "104268",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤੋਤਲੀਆ ਜਿਹਵਾ ਸਿੰਧੁਲੀਆ ॥",
      "transliteration": "totaleeaa jihavaa si(n)dhuleeaa ||",
      "translation": "",
      "punjabiViakhya": "ਤੋਤਲੀ ਜੀਭ ਵਾਲੀ, ਸਮੁੰਦਰ ਵਿਚ ਵਿਆਪਤ ਰੂਪ ਵਾਲੀ (ਬੜਵਾਨਲ)",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "तोतलीआ जिहवा सिंधुलीआ ॥",
      "sourceLineId": "104269",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹਿੰਗਲੀਆ ਮਾਤਾ ਪਿੰਗਲੀਆ ॥੫੮॥",
      "transliteration": "hi(n)galeeaa maataa pi(n)galeeaa ||58||",
      "translation": "",
      "punjabiViakhya": "ਹਿੰਗਲਾਜੀ ਅਤੇ ਭੂਰੀਆਂ ਅੱਖਾ ਵਾਲੀ ਮਾਤਾ ॥੫੮॥",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "हिंगलीआ माता पिंगलीआ ॥५८॥",
      "sourceLineId": "104270",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚੰਚਾਲੀ ਚਿਤ੍ਰਾ ਚਿਤ੍ਰਾਗੀ ॥",
      "transliteration": "cha(n)chaalee chitraa chitraagee ||",
      "translation": "“You have the portrait like beautiful limbs and your plays are extensive",
      "punjabiViakhya": "ਚੰਚਲਾ (ਆਸਮਾਨੀ ਬਿਜਲੀ) ਰੂਪ ਵਾਲੀ, ਚਿਤਰੇ ਦੀ ਸਵਾਰੀ ਕਰਨ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "चंचाली चित्रा चित्रागी ॥",
      "sourceLineId": "104271",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭਿੰਭਰੀਆ ਭੀਮਾ ਸਰਬਾਗੀ ॥",
      "transliteration": "bhi(n)bhareeaa bheemaa sarabaagee ||",
      "translation": "You are the store of wisdom and the well of glory",
      "punjabiViakhya": "ਚਿਤਕਬਰੇ ਅੰਗਾ ਵਾਲੀ, ਸਾਰਿਆਂ ਅੰਗਾ ਕਰ ਕੇ ਭਿਆਨਕ ਅਤੇ ਡਰਾਵਣੇ ਅੰਗਾ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "भिंभरीआ भीमा सरबागी ॥",
      "sourceLineId": "104272",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬੁਧਿ ਭੂਪਾ ਕੂਪਾ ਜੁਜ੍ਵਾਲੀ ॥",
      "transliteration": "budh bhoopaa koopaa jujavaiaalee ||",
      "translation": "",
      "punjabiViakhya": "ਬੁੱਧੀ ਦੀ ਰਾਣੀ ਅਤੇ ਅਗਨੀ ਦੇ ਕੁੰਡ ਸਰੂਪ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "बुधि भूपा कूपा जुज्वाली ॥",
      "sourceLineId": "104273",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਕਲੰਕਾ ਮਾਈ ਨ੍ਰਿਮਾਲੀ ॥੫੯॥",
      "transliteration": "akala(n)kaa maiee niramaalee ||59||",
      "translation": "O mother! You are modest and blemishless.59",
      "punjabiViakhya": "ਕਲੰਕ ਰਹਿਤ ਅਤੇ ਨਿਰਮਲ ਰੂਪ ਵਾਲੀ ਮਾਤਾ ॥੫੯॥",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "अकलंका माई नृमाली ॥५९॥",
      "sourceLineId": "104274",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਉਛਲੈ ਲੰਕੁੜੀਆ ਛਤ੍ਰਾਲਾ ॥",
      "transliteration": "auchhalai la(n)kuReeaa chhatraalaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਛਤ੍ਰ ਵਾਲੇ ਹਨੂਮਾਨ ('ਲੰਕੜੀਆ') (ਨੂੰ ਅਗੇ) ਉਛਾਲਣ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "उछलै लंकुड़ीआ छत्राला ॥",
      "sourceLineId": "104275",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਭਿੰਭਰੀਆ ਭੈਰੋ ਭਉਹਾਲਾ ॥",
      "transliteration": "bhi(n)bhareeaa bhairo bhauhaalaa ||",
      "translation": "“Hanuman and Bairava jump and wander with your strength",
      "punjabiViakhya": "ਡਰਾਉਣੇ ਅਤੇ ਭਿਆਨਕ ਭੈਰੋ ਰੂਪ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "भिंभरीआ भैरो भउहाला ॥",
      "sourceLineId": "104276",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੈ ਦਾਤਾ ਮਾਤਾ ਜੈਦਾਣੀ ॥",
      "transliteration": "jai dhaataa maataa jaidhaanee ||",
      "translation": "O mother! you are the Donor of Victory",
      "punjabiViakhya": "ਜੈ ਦੇਣ ਵਾਲੀ, ਦਾਤਾ ਦੇਣ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "जै दाता माता जैदाणी ॥",
      "sourceLineId": "104277",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਲੋਕੇਸੀ ਦੁਰਗਾ ਭਾਵਾਣੀ ॥੬੦॥",
      "transliteration": "lokesee dhuragaa bhaavaanee ||60||",
      "translation": "You are the mistress of al the worlds and You are Durga, who ferries across the cycle of existence.60.",
      "punjabiViakhya": "ਲੋਕਾ ਦੀ ਸੁਆਮਿਨੀ, ਦੁਰਗਾ, ਭਵਾਨੀ ਮਾਤਾ! (ਤੇਰੀ) ਜੈ ਹੋਵੇ ॥੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "लोकेसी दुरगा भावाणी ॥६०॥",
      "sourceLineId": "104278",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੰਮੋਹੀ ਸਰਬੰ ਜਗਤਾਯੰ ॥",
      "transliteration": "sa(n)mohee saraba(n) jagataaya(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸਾਰੇ ਜਗਤ ਨੂੰ ਮੋਹ ਲੈਣ ਵਾਲੀ!",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "संमोही सरबं जगतायं ॥",
      "sourceLineId": "104279",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਿੰਦ੍ਰਾ ਛੁਧ੍ਰਯਾ ਪਿਪਾਸਾਯੰ ॥",
      "transliteration": "ni(n)dhraa chhudhrayaa pipaasaaya(n) ||",
      "translation": "“O goddess! You have engrossed all the world in sleep, hunger and thirst",
      "punjabiViakhya": "(ਤੂੰ ਹੀ) ਨੀਂਦਰ, ਭੁਖ, ਪਿਆਸ ਰੂਪ ਵਾਲੀ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "निंद्रा छुध्रया पिपासायं ॥",
      "sourceLineId": "104280",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜੈ ਕਾਲੰ ਰਾਤੀ ਸਕ੍ਰਾਣੀ ॥",
      "transliteration": "jai kaala(n) raatee sakraanee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਕਾਲ-ਰਾਤ੍ਰੀ, ਇੰਦਰ ਦੀ ਸ਼ਕਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "जै कालं राती सक्राणी ॥",
      "sourceLineId": "104281",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਉਧਾਰੀ ਭਾਰੀ ਭਗਤਾਣੀ ॥੬੧॥",
      "transliteration": "audhaaree bhaaree bhagataanee ||61||",
      "translation": "O KAL! You are the goddess like Ratri and Indrani and the redeemer of the devotees.61.",
      "punjabiViakhya": "ਭਗਤਾ ਦਾ ਭਾਰੀ ਉੱਧਾਰ ਕਰਨ ਵਾਲੀ! (ਤੇਰੀ) ਜੈ ਹੋਵੇ ॥੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "उधारी भारी भगताणी ॥६१॥",
      "sourceLineId": "104282",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜੈ ਮਾਈ ਗਾਈ ਬੇਦਾਣੀ ॥",
      "transliteration": "jai maiee gaiee bedhaanee ||",
      "translation": "“O Mother! the Vedas have also sung the Praises of your victory",
      "punjabiViakhya": "ਹੇ ਮਾਤਾ! ਵੇਦਾ ਨੇ ਤੇਰੀ ਕੀਰਤੀ ਗਾਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "जै माई गाई बेदाणी ॥",
      "sourceLineId": "104283",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਨਛਿਜ ਅਭਿਦਾ ਅਖਿਦਾਣੀ ॥",
      "transliteration": "anachhij abhidhaa akhidhaanee ||",
      "translation": "You are Indiscriminate and Indestructible",
      "punjabiViakhya": "(ਤੂੰ) ਨਾ ਛਿਜਣ ਵਾਲੀ, ਨਾ ਭੇਦੇ ਜਾ ਸਕਣ ਵਾਲੀ ਅਤੇ ਨਾ ਦੁਖੀ ਹੋਣ ਵਾਲੀ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "अनछिज अभिदा अखिदाणी ॥",
      "sourceLineId": "104284",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭੈ ਹਰਣੀ ਸਰਬੰ ਸੰਤਾਣੀ ॥",
      "transliteration": "bhai haranee saraba(n) sa(n)taanee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਸੰਤਾ ਦਾ ਡਰ ਹਰਨ ਵਾਲੀ",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "भै हरणी सरबं संताणी ॥",
      "sourceLineId": "104285",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੈ ਦਾਤਾ ਮਾਤਾ ਕ੍ਰਿਪਾਣੀ ॥੬੨॥",
      "transliteration": "jai dhaataa maataa kirapaanee ||62||",
      "translation": "You are the remover of the fear of the saints, the giver of victory and sword-wielder.”62.",
      "punjabiViakhya": "ਅਤੇ ਕ੍ਰਿਪਾਨ ਪ੍ਰਦਾਨ ਕਰਨ ਵਾਲੀ ਹੇ ਮਾਤਾ! (ਤੇਰੀ) ਜੈ ਹੋਵੇ ॥੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "जै दाता माता कृपाणी ॥६२॥",
      "sourceLineId": "104286",
      "sourceShabadId": "9384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਚਕੜਾ ਛੰਦ ॥ ਤ੍ਵਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "achakaRaa chha(n)dh || tavaiprasaadh ||",
      "translation": "ACHKARA STANZA BY THY GRACE",
      "punjabiViakhya": "ਅਚਕੜਾ ਛੰਦ: ਤੇਰੀ ਕ੍ਰਿਪਾ ਨਾਲ:",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "अचकड़ा छंद ॥ त्वप्रसादि ॥",
      "sourceLineId": "104287",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅੰਬਿਕਾ ਤੋਤਲਾ ਸੀਤਲਾ ਸਾਕਣੀ ॥",
      "transliteration": "a(n)bikaa totalaa seetalaa saakanee ||",
      "translation": "“O Goddess! You are Ambika and Shitala being intoxicated, you may falter",
      "punjabiViakhya": "ਹੇ ਅੰਬਿਕਾ, ਤੋਤਲਾ, ਸੀਤਲਾ, ਸਾਕਣੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "अंबिका तोतला सीतला साकणी ॥",
      "sourceLineId": "104288",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਿੰਧੁਰੀ ਸੁਪ੍ਰਭਾ ਸੁਭ੍ਰਮਾ ਡਾਕਣੀ ॥",
      "transliteration": "si(n)dhuree suprabhaa subhramaa ddaakanee ||",
      "translation": "You are influential like the ocean You are also Dakini",
      "punjabiViakhya": "ਸੁੰਦਰ ਪ੍ਰਭਾ ਵਾਲੀ ਸਿੰਧੁਰੀ, ਸੁੰਦਰ ਭ੍ਰਮਣ ਕਰਨ ਵਾਲੀ, ਡਾਕਣੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "सिंधुरी सुप्रभा सुभ्रमा डाकणी ॥",
      "sourceLineId": "104289",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਾਵਜਾ ਸੰਭਿਰੀ ਸਿੰਧੁਲਾ ਦੁਖਹਰੀ ॥",
      "transliteration": "saavajaa sa(n)bhiree si(n)dhulaa dhukhaharee ||",
      "translation": "“You are the performer of Sambhavi Mudra (a kind of osture) and the remover of suffering",
      "punjabiViakhya": "ਹਾਥੀ ਦੀ ਸ਼ਕਤੀ ਵਾਲੀ, ਚੰਗੀ ਤਰ੍ਰਹਾ ਭਿੜਨ ਵਾਲੀ, ਸਿੰਧੁ ਦੇਸ਼ ਵਾਲੀ, ਦੁਖਾ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "सावजा संभिरी सिंधुला दुखहरी ॥",
      "sourceLineId": "104290",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੁੰਮਿਲਾ ਸੰਭਿਲਾ ਸੁਪ੍ਰਭਾ ਦੁਧਰੀ ॥੬੩॥",
      "transliteration": "su(n)milaa sa(n)bhilaa suprabhaa dhudharee ||63||",
      "translation": "You are absorbed in all, doer of good to all, greatly glorious and the destroyer of all.63.",
      "punjabiViakhya": "ਸੁੰਦਰ ਮੇਲ ਵਾਲੀ, ਸੰਭਲ ਦੇਸ਼ ਵਾਲੀ, ਸੁੰਦਰ ਪ੍ਰਭਾ ਵਾਲੀ, ਦੋ ਧਾਰੇ ਖੰਡੇ ਵਾਲੀ ॥੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "सुँमिला संभिला सुप्रभा दुधरी ॥६३॥",
      "sourceLineId": "104291",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭਾਵਨਾ ਭੈ ਹਰੀ ਭੂਤਿਲੀ ਭੈਹਰਾ ॥",
      "transliteration": "bhaavanaa bhai haree bhootilee bhaiharaa ||",
      "translation": "“You manifest yourself in accordance with everyone’s emotion  You are the fear-remover of the world",
      "punjabiViakhya": "ਹੇ ਭਾਵਨਾ ਪੂਰੀ ਕਰਨ ਵਾਲੀ, ਭੈ ਹਰਨ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "भावना भै हरी भूतिली भैहरा ॥",
      "sourceLineId": "104292",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਟਾਕਣੀ ਝਾਕਣੀ ਸਾਕਣੀ ਸਿੰਧੁਲਾ ॥",
      "transliteration": "Taakanee jhaakanee saakanee si(n)dhulaa ||",
      "translation": "You are the chopper of everyone and associated with them, you are profound and serene like the sea",
      "punjabiViakhya": "ਧਰਤੀ ਉਤੇ ਵਿਚਰਨ ਵਾਲੀ, ਡਰ ਨੂੰ ਦੂਰ ਕਰਨ ਵਾਲੀ, (ਵੈਰੀਆਂ ਨੂੰ) ਠਲ੍ਰਹਣ ਵਾਲੀ, (ਦੂਰੋਂ) ਝਾਕਣ ਵਾਲੀ, ਸਾਕਣੀ, ਸਿੰਧੁ ਦੇਸ਼ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "टाकणी झाकणी साकणी सिंधुला ॥",
      "sourceLineId": "104293",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੁਧਰਾ ਦ੍ਰੁਮੁਖਾ ਦ੍ਰੁਕਟਾ ਦੁਧਰੀ ॥",
      "transliteration": "dhudharaa dhrumukhaa dhrukaTaa dhudharee ||",
      "translation": "“You are the double-edged sword and double-faced Durga  you are invincible",
      "punjabiViakhya": "ਦੋ ਧਾਰਾ ਖੰਡਾ ਧਾਰਨ ਕਰਨ ਵਾਲੀ, ਭਿਆਨਕ ਮੂੰਹ ਵਾਲੀ, ਬੁਰਾਈ ਨੂੰ ਕਟਣ ਵਾਲੀ, ਦੋ ਪਾਸੀ ਮਾਰ ਕਰਨ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "दुधरा द्रुमुखा द्रुकटा दुधरी ॥",
      "sourceLineId": "104294",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕੰਪਿਲਾ ਜੰਪਿਲਾ ਹਿੰਗੁਲਾ ਭੈਹਰੀ ॥੬੪॥",
      "transliteration": "ka(n)pilaa ja(n)pilaa hi(n)gulaa bhaiharee ||64||",
      "translation": "You are Hinglaj, the remover of the fear of all and all remember Thy Name.64.",
      "punjabiViakhya": "ਦੁਸ਼ਟਾ ਨੂੰ ਕੰਬਾਉਣ ਵਾਲੀ, ਜਪੇ ਜਾਣ ਵਾਲੀ, ਹਿੰਗਲਾਜ ਦੇ ਰਹਿਣ ਵਾਲੀ, ਭੈ ਨੂੰ ਹਰਨ ਵਾਲੀ ॥੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "कंपिला जंपिला हिंगुला भैहरी ॥६४॥",
      "sourceLineId": "104295",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚਿਤ੍ਰਣੀ ਚਾਪਣੀ ਚਾਰਣੀ ਚਛਣੀ ॥",
      "transliteration": "chitranee chaapanee chaaranee chachhanee ||",
      "translation": "You are the rider of lion; you have charming eyes;",
      "punjabiViakhya": "ਹੇ ਚਿਤਰੇ ਦੀ ਸਵਾਰੀ ਕਰਨ ਵਾਲੀ, ਧਨੁਸ਼ ਧਾਰਨ ਕਰਨ ਵਾਲੀ, ਚਾਰਣਾ ਦੁਆਰਾ ਵਡਿਆਏ ਜਾਣ ਵਾਲੀ, ਚੱਛਰ ਦੈਂਤ ਨੂੰ ਮਾਰਨ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "चित्रणी चापणी चारणी चछणी ॥",
      "sourceLineId": "104296",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹਿੰਗੁਲਾ ਪਿੰਗੁਲਾ ਗੰਧ੍ਰਬਾ ਜਛਣੀ ॥",
      "transliteration": "hi(n)gulaa pi(n)gulaa ga(n)dhrabaa jachhanee ||",
      "translation": "You are Hinglaj, Pinglaj, a Gandharva woman and a Yaksha woman;",
      "punjabiViakhya": "ਹਿੰਗਲਾ, ਪਿੰਗਲਾ, ਗੰਧਰਬ ਅਤੇ ਯਕਸ਼ ਸ਼ਕਤੀ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "हिंगुला पिंगुला गंध्रबा जछणी ॥",
      "sourceLineId": "104297",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਰਮਣੀ ਚਰਮਣੀ ਪਰਘਣੀ ਪਾਸਣੀ ॥",
      "transliteration": "baramanee charamanee paraghanee paasanee ||",
      "translation": "“You are the destroyer of armours",
      "punjabiViakhya": "ਕਵਚ ਵਾਲੀ, ਢਾਲ ਧਾਰਨ ਕਰਨ ਵਾਲੀ, ਪਰਘ (ਕੁਹਾੜਾ) ਧਾਰਨ ਕਰਨ ਵਾਲੀ, ਪਾਸ (ਫਾਹੀ) ਧਾਰਨ ਕਰਨ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "बरमणी चरमणी परघणी पासणी ॥",
      "sourceLineId": "104298",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਖੜਗਣੀ ਗੜਗਣੀ ਸੈਥਣੀ ਸਾਪਣੀ ॥੬੫॥",
      "transliteration": "khaRaganee gaRaganee saithanee saapanee ||65||",
      "translation": "You are the sword-wielder and thundering goddess and you are the lance like a female serpent.65.",
      "punjabiViakhya": "ਖੜਗ ਧਾਰਨ ਕਰਨ ਵਾਲੀ, ਭਾਲਾ ਧਾਰਨ ਕਰਨ ਵਾਲੀ, ਸੈਹਥੀ ਅਤੇ ਸੱਪਾ ਨੂੰ ਧਾਰਨ ਕਰਨ ਵਾਲੀ ॥੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "खड़गणी गड़गणी सैथणी सापणी ॥६५॥",
      "sourceLineId": "104299",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭੀਮੜਾ ਸਮਦੜਾ ਹਿੰਗੁਲਾ ਕਾਰਤਕੀ ॥",
      "transliteration": "bheemaRaa samadhaRaa hi(n)gulaa kaaratakee ||",
      "translation": "“You are renowned for your large body",
      "punjabiViakhya": "ਹੇ ਮੁਰਦੇ ਦੀ ਸਵਾਰੀ ਕਰਨ ਵਾਲੀ ('ਭੀਮੜਾ') ਮਦਮਸਤ ('ਸਮਦੜਾ') ਰਹਿਣ ਵਾਲੀ, ਹਿੰਗਲਾਜ ਦੇਸ਼ ਦੀ ਰਹਿਣ ਵਾਲੀ ਅਤੇ ਕਾਰਤਿਕੇਯ ਦੀ ਸ਼ਕਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "भीमड़ा समदड़ा हिंगुला कारतकी ॥",
      "sourceLineId": "104300",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੁਪ੍ਰਭਾ ਅਛਿਦਾ ਅਧਿਰਾ ਮਾਰਤਕੀ ॥",
      "transliteration": "suprabhaa achhidhaa adhiraa maaratakee ||",
      "translation": "You are Hinglaj and the goddess Kartikeyi You are glorious and indestructible and the base of all deaths",
      "punjabiViakhya": "ਸੁੰਦਰ ਸ਼ੋਭਾ ਵਾਲੀ, ਨਾ ਛੇਦੇ ਜਾ ਸਕਣ ਵਾਲੀ, ਆਸਰੇ ਤੋਂ ਮੁਕਤ ਰੂਪ ਵਾਲੀ, ਪਵਣ ਦੇਵਤਾ ਦੀ ਸ਼ਕਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "सुप्रभा अछिदा अधिरा मारतकी ॥",
      "sourceLineId": "104301",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗਿੰਗਲੀ ਹਿੰਗੁਲੀ ਠਿੰਗੁਲੀ ਪਿੰਗੁਲਾ ॥",
      "transliteration": "gi(n)galee hi(n)gulee Thi(n)gulee pi(n)gulaa ||",
      "translation": "“Your various names are Ginglaj, Hinglaj, Thinglaj, Pinglaj",
      "punjabiViakhya": "ਗਿੰਗਲੀ (ਮੱਥੇ ਉਤੇ ਚੰਦ੍ਰ ਧਾਰਨ ਕਰਨ ਵਾਲੀ) ਹਿੰਗਲੀ, ਠਿੰਗਲੀ, ਪਿੰਗਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "गिंगली हिंगुली ठिंगुली पिंगुला ॥",
      "sourceLineId": "104302",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਚਿਕਣੀ ਚਰਕਟਾ ਚਰਪਟਾ ਚਾਵਡਾ ॥੬੬॥",
      "transliteration": "chikanee charakaTaa charapaTaa chaavaddaa ||66||",
      "translation": "You are Chamunda of tricky speed.66.",
      "punjabiViakhya": "ਚਿਕਨੇ ਕੇਸਾ ਵਾਲੀ, ਕੱਟਣ ਵੱਢਣ ਵਾਲੀ, ਚਰਪਟਾ, ਚਾਵਡਾ (ਮਾਤਾ! ਤੇਰੀ ਜੈ ਹੋਵੇ) ॥੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "चिकणी चरकटा चरपटा चावडा ॥६६॥",
      "sourceLineId": "104303",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਛਿਦਾ ਅਭਿਦਾ ਅਸਿਤਾ ਅਧਰੀ ॥",
      "transliteration": "achhidhaa abhidhaa asitaa adharee ||",
      "translation": "“O Goddess! You are invincible, indiscriminate, non-white and base of all",
      "punjabiViakhya": "ਹੇ ਨਾ ਛਿਦਣ ਵਾਲੀ, ਨਾ ਭੇਦੇ ਜਾ ਸਕਣ ਵਾਲੀ, ਕਾਲੇ ਰੂਪ ਵਾਲੀ, ਆਸਰਾ ਦੇਣ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "अछिदा अभिदा असिता अधरी ॥",
      "sourceLineId": "104304",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਕਟਾ ਅਖੰਡਾ ਅਛਟਾ ਦੁਧਰੀ ॥",
      "transliteration": "akaTaa akha(n)ddaa achhaTaa dhudharee ||",
      "translation": "You are unchopable and beyond all splendours",
      "punjabiViakhya": "ਨਾ ਕਟੇ ਜਾ ਸਕਣ ਵਾਲੀ, ਨਾ ਖੰਡੇ ਜਾ ਸਕਣ ਵਾਲੀ, ਕਿਸੇ ਪ੍ਰਕਾਰ ਦੀ ਛਟਾ ਤੋਂ ਹੀਨ, ਦੋਵੇਾਂ ਪਾਸੇ ਮਾਰ ਕਰਨ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "अकटा अखंडा अछटा दुधरी ॥",
      "sourceLineId": "104305",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅੰਜਨੀ ਅੰਬਿਕਾ ਅਸਤ੍ਰਣੀ ਧਾਰਣੀ ॥",
      "transliteration": "a(n)janee a(n)bikaa asatranee dhaaranee ||",
      "translation": "“You are also Anjani, the mother of Hanuman  you are Ambika, who holds the weapons",
      "punjabiViakhya": "ਅੰਜਨੀ, ਅੰਬਿਕਾ, ਅਸਤ੍ਰ ਧਾਰਨ ਕਰਨ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "अंजनी अंबिका असत्रणी धारणी ॥",
      "sourceLineId": "104306",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਭਰੰ ਅਧਰਾ ਜਗਤਿ ਉਧਾਰਣੀ ॥੬੭॥",
      "transliteration": "abhara(n) adharaa jagat udhaaranee ||67||",
      "translation": "You are imperishable, support of all and the redeemer of the world.67.",
      "punjabiViakhya": "ਨਾ ਭਰੇ ਜਾ ਸਕਣ ਵਾਲੀ, ਨਾ ਧਰੇ ਜਾ ਸਕਣ ਵਾਲੀ, ਜਗਤ ਦਾ ਉੱਧਾਰ ਕਰਨ ਵਾਲੀ ॥੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "अभरं अधरा जगति उधारणी ॥६७॥",
      "sourceLineId": "104307",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅੰਜਨੀ ਗੰਜਨੀ ਸਾਕੜੀ ਸੀਤਲਾ ॥",
      "transliteration": "a(n)janee ga(n)janee saakaRee seetalaa ||",
      "translation": "“You are Anjani, you are Shitala, the destroyer of all",
      "punjabiViakhya": "ਹੇ ਅੰਜਨੀ, ਗੰਜਨੀ, ਸਾਕੜੀ, ਸੀਤਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "अंजनी गंजनी साकड़ी सीतला ॥",
      "sourceLineId": "104308",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਿਧਰੀ ਸੁਪ੍ਰਭਾ ਸਾਮਲਾ ਤੋਤਲਾ ॥",
      "transliteration": "sidharee suprabhaa saamalaa totalaa ||",
      "translation": "You are serene like the sea and always remain absorbed",
      "punjabiViakhya": "ਸਿਧਰੀ (ਸਿੱਧੀ ਦੇਣ ਵਾਲੀ) ਸੁੰਦਰ ਪ੍ਰਭਾ ਵਾਲੀ, ਸਾਵਲੇ ਰੰਗ ਵਾਲੀ, ਤੋਤਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "सिधरी सुप्रभा सामला तोतला ॥",
      "sourceLineId": "104309",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੰਭਰੀ ਗੰਭਰੀ ਅੰਭਰੀ ਅਕਟਾ ॥",
      "transliteration": "sa(n)bharee ga(n)bharee a(n)bharee akaTaa ||",
      "translation": "“You are alert, serene  you are large and invincible like the sky",
      "punjabiViakhya": "ਚੰਗੀ ਤਰ੍ਰਹਾ ਭਰਨ ਵਾਲੀ, ਗੰਭੀਰ ਰੂਪ ਵਾਲੀ, ਨਾ ਭਰੇ ਜਾ ਸਕਣ ਵਾਲੀ, ਨਾ ਕਟੇ ਜਾ ਸਕਣ ਵਾਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "संभरी गंभरी अंभरी अकटा ॥",
      "sourceLineId": "104310",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਦੁਸਲਾ ਦ੍ਰੁਭਿਖਾ ਦ੍ਰੁਕਟਾ ਅਮਿਟਾ ॥੬੮॥",
      "transliteration": "dhusalaa dhrubhikhaa dhrukaTaa amiTaa ||68||",
      "translation": "You have enwrapped all the world within yourself and you yourself are ineffaceable and destroyer of all.68.",
      "punjabiViakhya": "ਨਾ ਸਲ੍ਰਹੀ ਜਾ ਸਕਣ ਵਾਲੀ, ਸੋਕੜਾ ਕਰਨ ਵਾਲੀ, ਭੈੜਾ ਨੂੰ ਕੱਟਣ ਵਾਲੀ, ਨਾ ਮਿਟ ਸਕਣ ਵਾਲੀ ॥੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "दुसला द्रुभिखा द्रुकटा अमिटा ॥६८॥",
      "sourceLineId": "104311",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭੈਰਵੀ ਭੈਹਰੀ ਭੂਚਰਾ ਭਾਨਵੀ ॥",
      "transliteration": "bhairavee bhaiharee bhoocharaa bhaanavee ||",
      "translation": "“O Goddess! you are Bhairavi, the remover of fear and the mover in the world in the world",
      "punjabiViakhya": "ਹੇ ਭੈਰਵੀ, ਭੈ-ਹਰੀ, ਭੂਚਰੀ, ਭਾਨਵੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "भैरवी भैहरी भूचरा भानवी ॥",
      "sourceLineId": "104312",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤ੍ਰਿਕੁਟਾ ਚਰਪਟਾ ਚਾਵਡਾ ਮਾਨਵੀ ॥",
      "transliteration": "tirakuTaa charapaTaa chaavaddaa maanavee ||",
      "translation": "You are the Trikuti, Yogini, Chamunda and Manavi in practice",
      "punjabiViakhya": "ਤ੍ਰਿਕੁਟਾ, ਚਰਪਟਾ, ਚਾਵਡਾ, ਮਾਨਵੀ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "तृकुटा चरपटा चावडा मानवी ॥",
      "sourceLineId": "104313",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0680_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜੋਬਨਾ ਜੈਕਰੀ ਜੰਭਹਰੀ ਜਾਲਪਾ ॥",
      "transliteration": "jobanaa jaikaree ja(n)bhaharee jaalapaa ||",
      "translation": "“You are youthful, the killer of the demon Jambh",
      "punjabiViakhya": "ਜੋਬਨਾ, ਜੈ-ਕਰੀ, ਜੰਭ-ਹਰੀ, ਜਾਲਪਾ,",
      "source": "DASAM_GRANTH",
      "ang": 680,
      "hindi": "",
      "hindiTransliteration": "जोबना जैकरी जंभहरी जालपा ॥",
      "sourceLineId": "104314",
      "sourceShabadId": "9385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
