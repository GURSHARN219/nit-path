{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 702,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0702_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬੇਰਕਤਤਾ ਇਕ ਆਨ ॥",
      "transliteration": "berakatataa ik aan ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਹੋਰ 'ਬੇਰਕਤਤਾ' (ਨਾਮ ਵਾਲਾ ਸੂਰਮਾ) ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "बेरकतता इक आन ॥",
      "sourceLineId": "105395",
      "sourceShabadId": "9441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਿਹ ਸੋ ਨ ਆਨ ਪ੍ਰਧਾਨ ॥੨੬੩॥",
      "transliteration": "jeh so na aan pradhaan ||263||",
      "translation": "In the same way, there is none like Virakt (unattached).36.263.",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਹੋਰ (ਕੋਈ) ਪ੍ਰਧਾਨ (ਯੋਧਾ) ਨਹੀਂ ਹੈ ॥੨੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "जिह सो न आन प्रधान ॥२६३॥",
      "sourceLineId": "105396",
      "sourceShabadId": "9441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਤਸੰਗ ਅਉਰ ਸੁਬਾਹ ॥",
      "transliteration": "satasa(n)g aaur subaeh ||",
      "translation": "",
      "punjabiViakhya": "(ਇਕ) ਹੋਰ 'ਸਤਸੰਗ' (ਨਾਮ ਵਾਲਾ) ਯੋਧਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "सतसंग अउर सुबाह ॥",
      "sourceLineId": "105397",
      "sourceShabadId": "9441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਿਹ ਦੇਖ ਜੁਧ ਉਛਾਹ ॥",
      "transliteration": "jeh dhekh judh uchhaeh ||",
      "translation": "Seeing Satsang (good company) and Bal (power), the enthusiasm for fighting is increased and",
      "punjabiViakhya": "ਜਿਸ ਵਿਚ ਯੁੱਧ ਲਈ ਉਤਸਾਹ ਵੇਖਿਆ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "जिह देख जुध उछाह ॥",
      "sourceLineId": "105398",
      "sourceShabadId": "9441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭਟ ਨੇਹ ਨਾਮ ਅਪਾਰ ॥",
      "transliteration": "bhaT neh naam apaar ||",
      "translation": "",
      "punjabiViakhya": "(ਇਕ ਹੋਰ) 'ਨੇਮ' ਨਾਮ ਵਾਲਾ ਅਪਾਰ ਯੋਧਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "भट नेह नाम अपार ॥",
      "sourceLineId": "105399",
      "sourceShabadId": "9441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਲ ਜਉਨ ਕੋ ਬਿਕਰਾਰ ॥੨੬੪॥",
      "transliteration": "bal jaun ko bikaraar ||264||",
      "translation": "In the same way, the warrior named Saneh (love) is terribly powerful.37.264.",
      "punjabiViakhya": "ਜਿਸ ਵਿਚ ਭਿਆਨਕ ਬਲ ਹੈ ॥੨੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "बल जउन को बिकरार ॥२६४॥",
      "sourceLineId": "105400",
      "sourceShabadId": "9441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਇਕ ਪ੍ਰੀਤਿ ਅਰੁ ਹਰਿ ਭਗਤਿ ॥",
      "transliteration": "eik preet ar har bhagat ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ 'ਪ੍ਰੀਤਿ' ਅਤੇ (ਦੂਜਾ) 'ਹਰਿ-ਭਗਤਿ' (ਨਾਮ ਵਾਲੇ ਯੋਧੇ ਹਨ)",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "इक प्रीति अरु हरि भगति ॥",
      "sourceLineId": "105401",
      "sourceShabadId": "9441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਿਹ ਜੋਤਿ ਜਗਮਗ ਜਗਤਿ ॥",
      "transliteration": "jeh jot jagamag jagat ||",
      "translation": "There are also Har-Bhakti (devotion with the Lord) and Preet (love) with whose light, the whole world is enlightened",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦੀ ਜੋਤਿ ਜਗਤ ਵਿਚ ਜਗ ਮਗ ਕਰ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "जिह जोति जगमग जगति ॥",
      "sourceLineId": "105402",
      "sourceShabadId": "9441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭਟ ਦਤ ਮਤ ਮਹਾਨ ॥",
      "transliteration": "bhaT dhat mat mahaan ||",
      "translation": "",
      "punjabiViakhya": "(ਇਕ ਹੋਰ) ਮਹਾਨ ਮਤ ਵਾਲਾ 'ਦਤਮਤ' (ਨਾਮ ਵਾਲਾ ਯੋਧਾ ਹੈ)",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "भट दत मत महान ॥",
      "sourceLineId": "105403",
      "sourceShabadId": "9441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਬ ਠਉਰ ਮੈ ਪਰਧਾਨ ॥੨੬੫॥",
      "transliteration": "sab Thaur mai paradhaan ||265||",
      "translation": "The path of Yoga of Dutt is also superb and is considered superior at all the places.38.265.",
      "punjabiViakhya": "ਜੋ ਸਭ ਥਾਵਾ ਵਿਚ ਪ੍ਰਧਾਨ ਹੈ ॥੨੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "सब ठउर मै परधान ॥२६५॥",
      "sourceLineId": "105404",
      "sourceShabadId": "9441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਕ ਅਕ੍ਰੁਧ ਅਉਰ ਪ੍ਰਬੋਧ ॥",
      "transliteration": "eik akrudh aaur prabodh ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ 'ਅਕ੍ਰੁਧ' ਅਤੇ ਦੂਜਾ 'ਪ੍ਰਬੋਧ' (ਨਾਮ ਵਾਲੇ ਯੋਧੇ ਹਨ)",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "इक अक्रुध अउर प्रबोध ॥",
      "sourceLineId": "105405",
      "sourceShabadId": "9441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਣ ਦੇਖਿ ਕੈ ਜਿਹ ਕ੍ਰੋਧ ॥",
      "transliteration": "ran dhekh kai jeh krodh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੂੰ ਰਣ-ਭੂਮੀ ਵੇਖ ਕੇ ਕ੍ਰੋਧ ਚੜ੍ਰਹ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "रण देखि कै जिह क्रोध ॥",
      "sourceLineId": "105406",
      "sourceShabadId": "9441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਇਹ ਭਾਤਿ ਸੈਨ ਬਨਾਇ ॥",
      "transliteration": "eeh bhaat sain banai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦੀ ਸੈਨਾ ਬਣਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "इह भाति सैन बनाइ ॥",
      "sourceLineId": "105407",
      "sourceShabadId": "9441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੁਹੁ ਦਿਸਿ ਨਿਸਾਨ ਬਜਾਇ ॥੨੬੬॥",
      "transliteration": "dhuh dhis nisaan bajai ||266||",
      "translation": "Seeing the war, Krodh (anger) and Prabodh (knowledge), in their fury, souding their trumpets, marched for attack after decorating their forces.39.266.",
      "punjabiViakhya": "ਦੋਹਾ ਪਾਸੇ ਧੌਂਸੇ ਵਜਣ ਲਗੇ ਹਨ ॥੨੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "दुहु दिसि निसान बजाइ ॥२६६॥",
      "sourceLineId": "105408",
      "sourceShabadId": "9441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "105409",
      "sourceShabadId": "9442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਸੈਨ ਬਨਾਇ ਕੈ ਚੜੇ ਨਿਸਾਨ ਬਜਾਇ ॥",
      "transliteration": "eeh bidh sain banai kai chaRe nisaan bajai ||",
      "translation": "In this way, arranging their forces and sounding their trumpets, the attack was made",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਸੈਨਾ ਤਿਆਰ ਕਰ ਕੇ ਧੌਂਸੇ ਵਜਾ ਕੇ ਚੜ੍ਰਹ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "इह बिधि सैन बनाइ कै चड़े निसान बजाइ ॥",
      "sourceLineId": "105410",
      "sourceShabadId": "9442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਿਹ ਜਿਹ ਬਿਧਿ ਆਹਵ ਮਚ੍ਯੋ ਸੋ ਸੋ ਕਹਤ ਸੁਨਾਇ ॥੨੬੭॥",
      "transliteration": "jeh jeh bidh aahav machayo so so kahat sunai ||267||",
      "translation": "The way, in which the war was fought, it presents its description.40.267.",
      "punjabiViakhya": "ਜਿਸ ਜਿਸ ਤਰ੍ਰਹਾ ਦਾ ਯੁੱਧ ਹੋਇਆ ਹੈ, ਉਹ ਉਹ ਕਹਿ ਕੇ ਸੁਣਾਉਾਂਦਾ ਹਾ ॥੨੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "जिह जिह बिधि आहव मच्यो सो सो कहत सुनाइ ॥२६७॥",
      "sourceLineId": "105411",
      "sourceShabadId": "9442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸ੍ਰੀ ਭਗਵਤੀ ਛੰਦ ॥",
      "transliteration": "sree bhagavatee chha(n)dh ||",
      "translation": "SHRI BHAGVATI STANZA",
      "punjabiViakhya": "ਸ੍ਰੀ ਭਗਵਤੀ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "स्री भगवती छंद ॥",
      "sourceLineId": "105412",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਿ ਸੰਬਾਹ ਉਠੇ ॥",
      "transliteration": "k sa(n)baeh uThe ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧੇ ਉਠ ਪਏ ਹਨ (ਅਰਥਾਤਰ-ਵਿਵਾਦ ਛਿੜ ਪਿਆ ਹੈ)",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि संबाह उठे ॥",
      "sourceLineId": "105413",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਿ ਸਾਵੰਤ ਜੁਟੇ ॥",
      "transliteration": "k saava(n)t juTe ||",
      "translation": "The arms arose, the warriors fought",
      "punjabiViakhya": "ਬਲਵਾਨ ਸੂਰਮੇ (ਯੁੱਧ ਵਿਚ) ਜੁਟ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि सावंत जुटे ॥",
      "sourceLineId": "105414",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਿ ਨੀਸਾਣ ਹੁਕੇ ॥",
      "transliteration": "k neesaan huke ||",
      "translation": "",
      "punjabiViakhya": "ਧੌਂਸੇ ਗੂੰਜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि नीसाण हुके ॥",
      "sourceLineId": "105415",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਿ ਬਾਜੰਤ੍ਰ ਧੁਕੇ ॥੨੬੮॥",
      "transliteration": "k baaja(n)tr dhuke ||268||",
      "translation": "The trumpets and other musical instruments were played.41.268.",
      "punjabiViakhya": "ਵਾਜੇ ਧੁਕ ਧੁਕ ਕਰਦੇ ਹਨ ॥੨੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि बाजंत्र धुके ॥२६८॥",
      "sourceLineId": "105416",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਿ ਬੰਬਾਲ ਨੇਜੇ ॥",
      "transliteration": "k ba(n)baal neje ||",
      "translation": "",
      "punjabiViakhya": "ਨੇਜ਼ਿਆਂ ਦੇ ਬੰਬਲ (ਅਰਥਾਤ ਝਾਲਰਾ)",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि बंबाल नेजे ॥",
      "sourceLineId": "105417",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਿ ਜੰਜ੍ਵਾਲ ਤੇਜੇ ॥",
      "transliteration": "k ja(n)javaiaal teje ||",
      "translation": "The lances with tassels were lustrous like fire-flames",
      "punjabiViakhya": "ਅੱਗ ਦੀਆਂ ਪ੍ਰਚੰਡ ਲਾਟਾ (ਮਾਲੂਮ ਹੁੰਦੀਆਂ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि जंज्वाल तेजे ॥",
      "sourceLineId": "105418",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਿ ਸਾਵੰਤ ਢੂਕੇ ॥",
      "transliteration": "k saava(n)t ddooke ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ (ਇਕ ਦੂਜੇ ਦੇ ਨੇੜੇ) ਢੁਕ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि सावंत ढूके ॥",
      "sourceLineId": "105419",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਿ ਹਾ ਹਾਇ ਕੂਕੇ ॥੨੬੯॥",
      "transliteration": "k haa hai kooke ||269||",
      "translation": "The warriors taking them began to fight with one another and there was lamentation.42.269.",
      "punjabiViakhya": "ਅਤੇ (ਮੂੰਹ ਤੋਂ) 'ਹਾ ਹਾਇ' ਕੂਕ ਰਹੇ ਹਨ ॥੨੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि हा हाइ कूके ॥२६९॥",
      "sourceLineId": "105420",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਿ ਸਿੰਧੂਰ ਗਜੇ ॥",
      "transliteration": "k si(n)dhoor gaje ||",
      "translation": "",
      "punjabiViakhya": "ਸਿੰਧੂਰੇ ਹੋਏ (ਹਾਥੀ) ਗਜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि सिंधूर गजे ॥",
      "sourceLineId": "105421",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਿ ਤੰਦੂਰ ਬਜੇ ॥",
      "transliteration": "k ta(n)dhoor baje ||",
      "translation": "The elephants trumpetted, the musical instruments were played",
      "punjabiViakhya": "ਛੋਟੇ ਢੋਲ ਵਜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि तंदूर बजे ॥",
      "sourceLineId": "105422",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਿ ਸੰਬਾਹ ਜੁਟੇ ॥",
      "transliteration": "k sa(n)baeh juTe ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧੇ (ਆਪਸ ਵਿਚ) ਜੁਟ ਗਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि संबाह जुटे ॥",
      "sourceLineId": "105423",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਿ ਸੰਨਾਹ ਫੁਟੇ ॥੨੭੦॥",
      "transliteration": "k sa(n)naeh fuTe ||270||",
      "translation": "The warriors fought and the armours werr torn.43.270.",
      "punjabiViakhya": "ਕਵਚ ਫੁਟ ਰਹੇ ਹਨ ॥੨੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि संनाह फुटे ॥२७०॥",
      "sourceLineId": "105424",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਿ ਡਾਕੰਤ ਡਉਰੂ ॥",
      "transliteration": "k ddaaka(n)t ddauroo ||",
      "translation": "",
      "punjabiViakhya": "ਡੌਰੇ ਡਕ ਡਕ ਕਰ ਕੇ ਬੋਲਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि डाकंत डउरू ॥",
      "sourceLineId": "105425",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਿ ਭ੍ਰਾਮੰਤ ਭਉਰੂ ॥",
      "transliteration": "k bhraama(n)t bhauroo ||",
      "translation": "The tabors were played  the Bhairavas wandered in the battlefield",
      "punjabiViakhya": "ਘੋੜੇ ('ਭਉਰੂ') ਭਰਮਦੇ ਫਿਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि भ्रामंत भउरू ॥",
      "sourceLineId": "105426",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਿ ਆਹਾੜਿ ਡਿਗੇ ॥",
      "transliteration": "k aahaaR ddige ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧਭੂਮੀ ਵਿਚ (ਸੂਰਮੇ) ਡਿਗ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि आहाड़ि डिगे ॥",
      "sourceLineId": "105427",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਿ ਰਾਕਤ੍ਰ ਭਿਗੇ ॥੨੭੧॥",
      "transliteration": "k raakatr bhige ||271||",
      "translation": "And the warriors saturated with blood fell in the fighting.44.271.",
      "punjabiViakhya": "ਲਹੂ ਨਾਲ ਭਿਜੇ ਹੋਏ ਹਨ ॥੨੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि राकत्र भिगे ॥२७१॥",
      "sourceLineId": "105428",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਿ ਚਾਮੁੰਡ ਚਰਮੰ ॥",
      "transliteration": "k chaamu(n)dd charama(n) ||",
      "translation": "",
      "punjabiViakhya": "ਚਾਮੁੰਡਾ (ਦੇਵੀ ਨੂੰ) ਢਾਲ ਬਣਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि चामुँड चरमं ॥",
      "sourceLineId": "105429",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਿ ਸਾਵੰਤ ਧਰਮੰ ॥",
      "transliteration": "k saava(n)t dharama(n) ||",
      "translation": "Decorated with arms and weapons,",
      "punjabiViakhya": "(ਅਰਥਾਤ ਉਸ ਦੀ ਸਰਪ੍ਰਸਤੀ ਪ੍ਰਾਪਤ ਕਰ ਕੇ) ਸ਼ੂਰਵੀਰ ਆਪਣਾ ਧਰਮ (ਨਿਭਾਉਾਂਦੇ ਹਨ)",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि सावंत धरमं ॥",
      "sourceLineId": "105430",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਿ ਆਵੰਤ ਜੁਧੰ ॥",
      "transliteration": "k aava(n)t judha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰ ਸਜਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि आवंत जुधं ॥",
      "sourceLineId": "105431",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਿ ਸਾਨਧ ਬਧੰ ॥੨੭੨॥",
      "transliteration": "k saanadh badha(n) ||272||",
      "translation": "The warriors like Chamuda came to the war-arena.45.272.",
      "punjabiViakhya": "ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਆਉਾਂਦੇ ਹਨ ॥੨੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि सानध बधं ॥२७२॥",
      "sourceLineId": "105432",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਿ ਸਾਵੰਤ ਸਜੇ ॥",
      "transliteration": "k saava(n)t saje ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾਨ ਯੋਧੇ (ਸ਼ਸਤ੍ਰਾ ਨਾਲ ਪੂਰੀ ਤਰ੍ਰਹਾ) ਸਜੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि सावंत सजे ॥",
      "sourceLineId": "105433",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਿ ਨੀਸਾਣ ਬਜੇ ॥",
      "transliteration": "k neesaan baje ||",
      "translation": "The warriors were decorated and the trumpets were sounded",
      "punjabiViakhya": "ਨਗਾਰੇ ਵਜਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि नीसाण बजे ॥",
      "sourceLineId": "105434",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਿ ਜੰਜ੍ਵਾਲ ਕ੍ਰੋਧੰ ॥",
      "transliteration": "k ja(n)javaiaal krodha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਰੂਪ ਜਵਾਲਾ (ਦੀਆਂ ਲਪਟਾ ਨਿਕਲਦੀਆਂ ਹਨ)",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि जंज्वाल क्रोधं ॥",
      "sourceLineId": "105435",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਿ ਬਿਸਾਰਿ ਬੋਧੰ ॥੨੭੩॥",
      "transliteration": "k bisaar bodha(n) ||273||",
      "translation": "The fighters were enraged like fire and they were not even slightly in senses.46.273.",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਅਕਲ ਗਵਾਚ ਜਾਦੀ ਹੈ ॥੨੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि बिसारि बोधं ॥२७३॥",
      "sourceLineId": "105436",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਿ ਆਹਾੜ ਮਾਨੀ ॥",
      "transliteration": "k aahaaR maanee ||",
      "translation": "",
      "punjabiViakhya": "(ਯੋਧੇ) ਯੁੱਧ ਨੂੰ (ਇੰਜ) ਮੰਨਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि आहाड़ मानी ॥",
      "sourceLineId": "105437",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਿ ਜ੍ਯੋਂ ਮਛ ਪਾਨੀ ॥",
      "transliteration": "k jayo(n) machh paanee ||",
      "translation": "The warriors were pleased in the war like the fish in water",
      "punjabiViakhya": "ਜਿਉਾਂ ਮੱਛੀ ਪਾਣੀ (ਨੂੰ ਮੰਨਦੀ ਹੈ)।",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि ज्यों मछ पानी ॥",
      "sourceLineId": "105438",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਿ ਸਸਤ੍ਰਾਸਤ੍ਰ ਬਾਹੈ ॥",
      "transliteration": "k sasatraasatr baahai ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰ ਅਤੇ ਅਸਤ੍ਰ ਚਲਾਉਾਂਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि ससत्रासत्र बाहै ॥",
      "sourceLineId": "105439",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਿ ਜ੍ਯੋਂ ਜੀਤ ਚਾਹੈ ॥੨੭੪॥",
      "transliteration": "k jayo(n) jeet chaahai ||274||",
      "translation": "They were striking blows with their arms and weapons, desirous of getting victorious.47.274.",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕਿ ਜਿਤ ਚਾਹੁੰਦੇ ਹਨ ॥੨੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि ज्यों जीत चाहै ॥२७४॥",
      "sourceLineId": "105440",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਿ ਸਾਵੰਤ ਸੋਹੇ ॥",
      "transliteration": "k saava(n)t sohe ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਵੀਰ (ਇਸ ਤਰ੍ਰਹਾ) ਸ਼ੋਭਾ ਪਾ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि सावंत सोहे ॥",
      "sourceLineId": "105441",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0702_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਿ ਸਾਰੰਗ ਰੋਹੇ ॥",
      "transliteration": "k saara(n)g rohe ||",
      "translation": "The bows are infuriated",
      "punjabiViakhya": "(ਮਾਨੋ) ਸ਼ੇਰ ਗੁੱਸੇ ਵਿਚ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 702,
      "hindi": "",
      "hindiTransliteration": "कि सारंग रोहे ॥",
      "sourceLineId": "105442",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
