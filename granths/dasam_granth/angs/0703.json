{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 703,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0703_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਿ ਸਸਤ੍ਰਾਸਤ੍ਰ ਬਾਹੇ ॥",
      "transliteration": "k sasatraasatr baahe ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰ ਅਤੇ ਅਸਤ੍ਰ ਚਲਾਉਾਂਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि ससत्रासत्र बाहे ॥",
      "sourceLineId": "105443",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਭਲੇ ਸੈਣ ਗਾਹੇ ॥੨੭੫॥",
      "transliteration": "bhale sain gaahe ||275||",
      "translation": "The warriors are looking splendid and they are destroying the army.48.275.",
      "punjabiViakhya": "ਅਤੇ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਸੈਨਾ ਨੂੰ ਗਾਹ ਰਹੇ ਹਨ ॥੨੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "भले सैण गाहे ॥२७५॥",
      "sourceLineId": "105444",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਿ ਭੈਰਉ ਭਭਕੈ ॥",
      "transliteration": "k bhairau bhabhakai ||",
      "translation": "",
      "punjabiViakhya": "ਭੈਰੋਂ ਭਭਕ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि भैरउ भभकै ॥",
      "sourceLineId": "105445",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਿ ਕਾਲੀ ਕੁਹਕੈ ॥",
      "transliteration": "k kaalee kuhakai ||",
      "translation": "The goddess Kali is laughing, the Bhairavas are thundering and holding their vassels in the hands,",
      "punjabiViakhya": "ਕਾਲੀ ਕਿਲਕਾਰੀਆਂ ਮਾਰਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि काली कुहकै ॥",
      "sourceLineId": "105446",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਿ ਜੋਗਨ ਜੁਟੀ ॥",
      "transliteration": "k jogan juTee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋਗਣਾ ਜੁਟੀਆਂ ਹੋਈਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि जोगन जुटी ॥",
      "sourceLineId": "105447",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਿ ਲੈ ਪਤ੍ਰ ਟੁਟੀ ॥੨੭੬॥",
      "transliteration": "k lai patr TuTee ||276||",
      "translation": "The Yoginis have gathered together for drinking blood.49.276.",
      "punjabiViakhya": "ਅਤੇ (ਖੋਪਰੀਆਂ ਦੇ) ਬਰਤਨ ਨਾਲ ਟੁਟ ਕੇ ਪੈ ਗਈਆਂ ਹਨ ॥੨੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि लै पत्र टुटी ॥२७६॥",
      "sourceLineId": "105448",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਿ ਦੇਵੀ ਦਮਕੇ ॥",
      "transliteration": "k dhevee dhamake ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵੀ ਲਿਸ਼ਕਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि देवी दमके ॥",
      "sourceLineId": "105449",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਿ ਕਾਲੀ ਕੁਹਕੇ ॥",
      "transliteration": "k kaalee kuhake ||",
      "translation": "The goddess is resplendent and the goddess Kali is shouting,",
      "punjabiViakhya": "ਕਾਲੀ ਕਿਲਕਾਰੀਆਂ ਮਾਰਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि काली कुहके ॥",
      "sourceLineId": "105450",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਿ ਭੈਰੋ ਭਕਾਰੈ ॥",
      "transliteration": "k bhairo bhakaarai ||",
      "translation": "",
      "punjabiViakhya": "ਭੈਰੋਂ ਲਲਕਾਰ ਰਹੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि भैरो भकारै ॥",
      "sourceLineId": "105451",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਿ ਡਉਰੂ ਡਕਾਰੈ ॥੨੭੭॥",
      "transliteration": "k ddauroo ddakaarai ||277||",
      "translation": "The Bhairvas are thundering and are sounding their tabors.50.277.",
      "punjabiViakhya": "ਡੌਰੂ ਡੁਕ ਡੁਕ ਕਰ ਕੇ ਵਜ ਰਹੇ ਹਨ ॥੨੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि डउरू डकारै ॥२७७॥",
      "sourceLineId": "105452",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਿ ਬਹੁ ਸਸਤ੍ਰ ਬਰਖੇ ॥",
      "transliteration": "k bahu sasatr barakhe ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਸ਼ਸਤ੍ਰਾ ਦੀ ਬਰਖਾ ਹੋ ਰਹੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि बहु ससत्र बरखे ॥",
      "sourceLineId": "105453",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਿ ਪਰਮਾਸਤ੍ਰ ਕਰਖੇ ॥",
      "transliteration": "k paramaasatr karakhe ||",
      "translation": "There is shower of weapons and the dreadful arms are crackling",
      "punjabiViakhya": "ਪਰਮ ਅਸਤ੍ਰ (ਧਨੁਸ਼ ਬਾਣ) ਖਿਚੇ ਜਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि परमासत्र करखे ॥",
      "sourceLineId": "105454",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਿ ਦਈਤਾਸਤ੍ਰ ਛੁਟੇ ॥",
      "transliteration": "k dhieetaasatr chhuTe ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤ ਅਸਤ੍ਰ ਚਲ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि दईतासत्र छुटे ॥",
      "sourceLineId": "105455",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੇਵਾਸਤ੍ਰ ਮੁਕੇ ॥੨੭੮॥",
      "transliteration": "dhevaasatr muke ||278||",
      "translation": "The arms of the demons are being discharged from one side and the arms of gods are being used form the other side.51.278.",
      "punjabiViakhya": "ਦੇਵ ਅਸਤ੍ਰ ਮੁਕ ਗਏ ਹਨ ॥੨੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "देवासत्र मुके ॥२७८॥",
      "sourceLineId": "105456",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਿ ਸੈਲਾਸਤ੍ਰ ਸਾਜੇ ॥",
      "transliteration": "k sailaasatr saaje ||",
      "translation": "",
      "punjabiViakhya": "(ਸੂਰਮਿਆਂ ਨੇ) ਸੈਲ (ਪੱਥਰ) ਅਸਤ੍ਰ ਸਜਾ ਲਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि सैलासत्र साजे ॥",
      "sourceLineId": "105457",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਿ ਪਉਨਾਸਤ੍ਰ ਬਾਜੇ ॥",
      "transliteration": "k paunaasatr baaje ||",
      "translation": "",
      "punjabiViakhya": "ਹਵਾ ਦੇ ਅਸਤ੍ਰ ਚਲ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि पउनासत्र बाजे ॥",
      "sourceLineId": "105458",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਿ ਮੇਘਾਸਤ੍ਰ ਬਰਖੇ ॥",
      "transliteration": "k meghaasatr barakhe ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਘ ਅਸਤ੍ਰ ਵਰ੍ਰਹ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि मेघासत्र बरखे ॥",
      "sourceLineId": "105459",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਿ ਅਗਨਾਸਤ੍ਰ ਕਰਖੇ ॥੨੭੯॥",
      "transliteration": "k aganaasatr karakhe ||279||",
      "translation": "The Shailastras, Pavanastras and Meghastras are being showered and the fire-arms are crackling.52.279.",
      "punjabiViakhya": "ਅਗਨ ਅਸਤ੍ਰਾ ਨੂੰ ਖਿਚਿਆ ਜਾ ਰਿਹਾ ਹੈ ॥੨੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि अगनासत्र करखे ॥२७९॥",
      "sourceLineId": "105460",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਿ ਹੰਸਾਸਤ੍ਰ ਛੁਟੇ ॥",
      "transliteration": "k ha(n)saasatr chhuTe ||",
      "translation": "",
      "punjabiViakhya": "ਹੰਸ ਅਸਤ੍ਰ ਛੁਟ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि हंसासत्र छुटे ॥",
      "sourceLineId": "105461",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਿ ਕਾਕਸਤ੍ਰ ਤੁਟੇ ॥",
      "transliteration": "k kaakasatr tuTe ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਕ ਅਸਤ੍ਰ ਟੁਟ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि काकसत्र तुटे ॥",
      "sourceLineId": "105462",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਿ ਮੇਘਾਸਤ੍ਰ ਬਰਖੇ ॥",
      "transliteration": "k meghaasatr barakhe ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਘ ਅਸਤ੍ਰ ਵਰ੍ਰਹ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि मेघासत्र बरखे ॥",
      "sourceLineId": "105463",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਿ ਸੂਕ੍ਰਾਸਤ੍ਰੁ ਕਰਖੇ ॥੨੮੦॥",
      "transliteration": "k sookraasatr karakhe ||280||",
      "translation": "The Hansastras, Kakastras and Meghastras are being showered and the Shukarastras are crackling.53.280.",
      "punjabiViakhya": "ਸੂਕ੍ਰ ਅਸਤ੍ਰ ਖਿਚੇ ਜਾ ਰਹੇ ਹਨ ॥੨੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि सूक्रासत्रु करखे ॥२८०॥",
      "sourceLineId": "105464",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਿ ਸਾਵੰਤ੍ਰ ਸਜੇ ॥",
      "transliteration": "k saava(n)tr saje ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਵੰਤ ਸਜੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि सावंत्र सजे ॥",
      "sourceLineId": "105465",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਿ ਬ੍ਰਯੋਮਾਸਤ੍ਰ ਗਜੇ ॥",
      "transliteration": "k brayomaasatr gaje ||",
      "translation": "",
      "punjabiViakhya": "ਆਕਾਸ਼ ਵਿਚ ਅਸਤ੍ਰ ਗਜ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि ब्रयोमासत्र गजे ॥",
      "sourceLineId": "105466",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਿ ਜਛਾਸਤ੍ਰ ਛੁਟੇ ॥",
      "transliteration": "k jachhaasatr chhuTe ||",
      "translation": "",
      "punjabiViakhya": "ਯਕਸ਼ ਅਸਤ੍ਰ ਚਲ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि जछासत्र छुटे ॥",
      "sourceLineId": "105467",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਿ ਕਿੰਨ੍ਰਾਸਤ੍ਰ ਮੁਕੇ ॥੨੮੧॥",
      "transliteration": "k ki(n)nraasatr muke ||281||",
      "translation": "The warriors are bedecked, the Vyomastras are thundering the Yakshastras are being discharged and the Kinnarastras are getting exhausted.54.281.",
      "punjabiViakhya": "ਕਿੰਨਰ ਅਸਤ੍ਰ ਮੁਕ ਗਏ ਹਨ ॥੨੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि किंन्रासत्र मुके ॥२८१॥",
      "sourceLineId": "105468",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਿ ਗੰਧ੍ਰਾਬਸਾਤ੍ਰ ਬਾਹੈ ॥",
      "transliteration": "k ga(n)dhraabasaatr baahai ||",
      "translation": "",
      "punjabiViakhya": "ਗੰਧਰਬ ਅਸਤ੍ਰ ਚਲਾਏ ਜਾ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि गंध्राबसात्र बाहै ॥",
      "sourceLineId": "105469",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਿ ਨਰ ਅਸਤ੍ਰ ਗਾਹੈ ॥",
      "transliteration": "k nar asatr gaahai ||",
      "translation": "The Gandharvastras are being discharged and the Narastras are also being used",
      "punjabiViakhya": "ਨਰ ਅਸਤ੍ਰਾ ਨੂੰ ਗਾਹਿਆ ਜਾ ਰਿਹਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि नर असत्र गाहै ॥",
      "sourceLineId": "105470",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਿ ਚੰਚਾਲ ਨੈਣੰ ॥",
      "transliteration": "k cha(n)chaal naina(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਯੋਧਿਆਂ ਦੀਆਂ) ਅੱਖਾ ਚੰਚਲ ਹੋ ਰਹੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि चंचाल नैणं ॥",
      "sourceLineId": "105471",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਿ ਮੈਮਤ ਬੈਣੰ ॥੨੮੨॥",
      "transliteration": "k maimat baina(n) ||282||",
      "translation": "The eyes of all the warriors are restless and all are uttering,”I”.55.282.",
      "punjabiViakhya": "ਸ਼ਰਾਬ ਦੇ ਨਸ਼ੇ ਵਿਚ ਬੋਲ ਰਹੇ ਹਨ ॥੨੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि मैमत बैणं ॥२८२॥",
      "sourceLineId": "105472",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਿ ਆਹਾੜਿ ਡਿਗੈ ॥",
      "transliteration": "k aahaaR ddigai ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ (ਸੂਰਮੇ) ਡਿਗ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि आहाड़ि डिगै ॥",
      "sourceLineId": "105473",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਿ ਆਰਕਤ ਭਿਗੈ ॥",
      "transliteration": "k aarakat bhigai ||",
      "translation": "",
      "punjabiViakhya": "(ਲਹੂ ਦੀ) ਲਾਲੀ ਨਾਲ ਗੜੁਚ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि आरकत भिगै ॥",
      "sourceLineId": "105474",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਿ ਸਸਤ੍ਰਾਸਤ੍ਰ ਬਜੇ ॥",
      "transliteration": "k sasatraasatr baje ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰ ਅਤੇ ਅਸਤ੍ਰ (ਆਪਸ ਵਿਚ) ਵਜ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि ससत्रासत्र बजे ॥",
      "sourceLineId": "105475",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਿ ਸਾਵੰਤ ਗਜੇ ॥੨੮੩॥",
      "transliteration": "k saava(n)t gaje ||283||",
      "translation": "The warriors saturated with blood have fallen in the war-arena and with the sounds of arms weapons, the warriors are also thundering.56.283.",
      "punjabiViakhya": "ਸੂਰਮੇ ਗਜ ਰਹੇ ਹਨ ॥੨੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि सावंत गजे ॥२८३॥",
      "sourceLineId": "105476",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਿ ਆਵਰਤ ਹੂਰੰ ॥",
      "transliteration": "k aavarat hoora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੂਰਾ (ਯੋਧਿਆਂ ਨੂੰ) ਘੇਰਾ ਪਾ ਰਹੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि आवरत हूरं ॥",
      "sourceLineId": "105477",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਿ ਸਾਵਰਤ ਪੂਰੰ ॥",
      "transliteration": "k saavarat poora(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਤਲਗਾਹ ('ਸਾਵਰਤ') ਭਰ ਗਈ ਹੈ, (ਅਰਥਾਤਰ: ਸੂਰਮਿਆਂ ਨੂੰ ਪੂਰੀ ਤਰ੍ਰਹਾ ਹੂਰਾ ਨੇ ਘੇਰ ਲਿਆ ਹੈ)",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि सावरत पूरं ॥",
      "sourceLineId": "105478",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਫਿਰੀ ਐਣ ਗੈਣੰ ॥",
      "transliteration": "firee aain gaina(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਹੂਰਾ) ਸਾਰੇ ਆਕਾਸ਼ ਵਿਚ ਘੁੰਮ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "फिरी ऐण गैणं ॥",
      "sourceLineId": "105479",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਿ ਆਰਕਤ ਨੈਣੰ ॥੨੮੪॥",
      "transliteration": "k aarakat naina(n) ||284||",
      "translation": "The groups of the red-eyed heavenly damsels are roaming in the sky for the warriors.57.284.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੀਆਂ ਅੱਖਾ (ਪ੍ਰੇਮ ਰੰਗ ਵਿਚ) ਲਾਲ ਹਨ ॥੨੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि आरकत नैणं ॥२८४॥",
      "sourceLineId": "105480",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਿ ਪਾਵੰਗ ਪੁਲੇ ॥",
      "transliteration": "k paava(n)g pule ||",
      "translation": "",
      "punjabiViakhya": "ਪੌਣ ਦੀ ਗਤੀ ਵਾਲੇ ਘੋੜੇ ('ਪਾਵੰਗ') ਕੁਦ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि पावंग पुले ॥",
      "sourceLineId": "105481",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਿ ਸਰਬਾਸਤ੍ਰ ਖੁਲੇ ॥",
      "transliteration": "k sarabaasatr khule ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਅਸਤ੍ਰ ਖੁਲ੍ਰਹ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि सरबासत्र खुले ॥",
      "sourceLineId": "105482",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਿ ਹੰਕਾਰਿ ਬਾਹੈ ॥",
      "transliteration": "k ha(n)kaar baahai ||",
      "translation": "",
      "punjabiViakhya": "ਹੰਕਾਰ ਨਾਲ ਭਰੇ ਹੋਏ (ਸੂਰਮੇ) ਚਲਾਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि हंकारि बाहै ॥",
      "sourceLineId": "105483",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਧੰ ਅਧਿ ਲਾਹੈ ॥੨੮੫॥",
      "transliteration": "adha(n) adh laahai ||285||",
      "translation": "The horses in flocks are roaming hither and thither and the warriors in their anger, are segmenting them.58.285.",
      "punjabiViakhya": "(ਦੁਸ਼ਮਨ ਨੂੰ) ਅਧੋ ਅਧ ਵਢ ਸੁਟਦੇ ਹਨ ॥੨੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "अधं अधि लाहै ॥२८५॥",
      "sourceLineId": "105484",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਛੁਟੀ ਈਸ ਤਾਰੀ ॥",
      "transliteration": "chhuTee iees taaree ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਦੀ ਸਮਾਧੀ ਖੁਲ੍ਰਹ ਗਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "छुटी ईस तारी ॥",
      "sourceLineId": "105485",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਿ ਸੰਨ੍ਯਾਸ ਧਾਰੀ ॥",
      "transliteration": "k sa(n)nayaas dhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਸੰਨਿਆਸ ਧਾਰਨ ਕੀਤਾ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि संन्यास धारी ॥",
      "sourceLineId": "105486",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਿ ਗੰਧਰਬ ਗਜੇ ॥",
      "transliteration": "k ga(n)dharab gaje ||",
      "translation": "",
      "punjabiViakhya": "ਗੰਧਰਬ ਗਜ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि गंधरब गजे ॥",
      "sourceLineId": "105487",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਿ ਬਾਦ੍ਰਿਤ ਬਜੇ ॥੨੮੬॥",
      "transliteration": "k baadhirat baje ||286||",
      "translation": "The meditation of the great Sannyasi Shiva has been broken and even he is listening to the thundering of Gandharvas and the playing of the musical instruments.59.286.",
      "punjabiViakhya": "ਵਾਜੇ ਵਜ ਰਹੇ ਹਨ ॥੨੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि बादृत बजे ॥२८६॥",
      "sourceLineId": "105488",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਿ ਪਾਪਾਸਤ੍ਰ ਬਰਖੇ ॥",
      "transliteration": "k paapaasatr barakhe ||",
      "translation": "",
      "punjabiViakhya": "ਪਾਪ ਅਸਤ੍ਰਾ ਦੀ ਬਰਖਾ ਹੋ ਰਹੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि पापासत्र बरखे ॥",
      "sourceLineId": "105489",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਿ ਧਰਮਾਸਤ੍ਰ ਕਰਖੇ ॥",
      "transliteration": "k dharamaasatr karakhe ||",
      "translation": "The voice of the shower of Papastras (the sinful arms) and the crackling of Dharmastras (the arms of Dharma) is being heard",
      "punjabiViakhya": "ਧਰਮ ਅਸਤ੍ਰ ਕਸੇ ਜਾ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि धरमासत्र करखे ॥",
      "sourceLineId": "105490",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅਰੋਗਾਸਤ੍ਰ ਛੁਟੇ ॥",
      "transliteration": "arogaasatr chhuTe ||",
      "translation": "",
      "punjabiViakhya": "ਅਰੋਗ ਅਸਤ੍ਰ ਛੁਟ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "अरोगासत्र छुटे ॥",
      "sourceLineId": "105491",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸੁ ਭੋਗਾਸਤ੍ਰ ਸੁਟੇ ॥੨੮੭॥",
      "transliteration": "s bhogaasatr suTe ||287||",
      "translation": "Arogastras (the health arms) and Bhogastras (the pleasure arms) are also being discharged.60.287.",
      "punjabiViakhya": "ਭੋਗ ਅਸਤ੍ਰਾ ਨੂੰ (ਵੈਰੀ ਸੈਨਾ ਉਤੇ) ਸੁਟਿਆ ਜਾ ਰਿਹਾ ਹੈ ॥੨੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "सु भोगासत्र सुटे ॥२८७॥",
      "sourceLineId": "105492",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬਿਬਾਦਾਸਤ੍ਰ ਸਜੇ ॥",
      "transliteration": "bibaadhaasatr saje ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਬਾਦ ਅਸਤ੍ਰ ਸਜ ਗਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "बिबादासत्र सजे ॥",
      "sourceLineId": "105493",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਬਿਰੋਧਾਸਤ੍ਰ ਬਜੇ ॥",
      "transliteration": "birodhaasatr baje ||",
      "translation": "Vivadastras (arms of dispute) and Virodhastras (arms of opposition),",
      "punjabiViakhya": "ਬਿਰੋਧ ਅਸਤ੍ਰ ਵਜ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "बिरोधासत्र बजे ॥",
      "sourceLineId": "105494",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕੁਮੰਤ੍ਰਾਸਤ੍ਰ ਛੁਟੇ ॥",
      "transliteration": "kuma(n)traasatr chhuTe ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਮੰਤ੍ਰ ਅਸਤ੍ਰ ਛੁਟ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कुमंत्रासत्र छुटे ॥",
      "sourceLineId": "105495",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਮੁੰਤ੍ਰਾਸਤ੍ਰ ਟੁਟੇ ॥੨੮੮॥",
      "transliteration": "samu(n)traasatr TuTe ||288||",
      "translation": "Kumantrastra (arms of bad spells and Sumantrastras (arms of auspicious spells were shot and then burst.61.288.",
      "punjabiViakhya": "ਸੁਮੰਤ੍ਰ ਅਸਤ੍ਰ ਟੁਟ ਰਹੇ ਹਨ ॥੨੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "समुँत्रासत्र टुटे ॥२८८॥",
      "sourceLineId": "105496",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕਿ ਕਾਮਾਸਤ੍ਰ ਛੁਟੇ ॥",
      "transliteration": "k kaamaasatr chhuTe ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮ ਅਸਤ੍ਰ ਛੁਟ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि कामासत्र छुटे ॥",
      "sourceLineId": "105497",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕਰੋਧਾਸਤ੍ਰ ਤੁਟੇ ॥",
      "transliteration": "karodhaasatr tuTe ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਅਸਤ੍ਰ ਟੁਟ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "करोधासत्र तुटे ॥",
      "sourceLineId": "105498",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਬਿਰੋਧਾਸਤ੍ਰ ਬਰਖੇ ॥",
      "transliteration": "birodhaasatr barakhe ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਰੋਧ ਅਸਤ੍ਰ ਵਰ੍ਰਹ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "बिरोधासत्र बरखे ॥",
      "sourceLineId": "105499",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਬਿਮੋਹਾਸਤ੍ਰ ਕਰਖੇ ॥੨੮੯॥",
      "transliteration": "bimohaasatr karakhe ||289||",
      "translation": "Kamastras (arms of lust), Karodhastras (the arms of anger) and Virodhastras (arms of opposition) were shwered and Vimohastras (arms of detachment) crackled.62.289.",
      "punjabiViakhya": "ਬਿਮੋਹ ਅਸਤ੍ਰ ਕਸੇ ਜਾ ਰਹੇ ਹਨ ॥੨੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "बिमोहासत्र करखे ॥२८९॥",
      "sourceLineId": "105500",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਚਰਿਤ੍ਰਾਸਤ੍ਰ ਛੁਟੇ ॥",
      "transliteration": "charitraasatr chhuTe ||",
      "translation": "",
      "punjabiViakhya": "ਚਰਿਤ੍ਰ ਅਸਤ੍ਰ ਛੁਟ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "चरित्रासत्र छुटे ॥",
      "sourceLineId": "105501",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਕਿ ਮੋਹਾਸਤ੍ਰ ਜੁਟੇ ॥",
      "transliteration": "k mohaasatr juTe ||",
      "translation": "Charitrastras (arms of conduct) were shot, the Mogastrass (the arms of attachment) collided,",
      "punjabiViakhya": "ਮੋਹ ਅਸਤ੍ਰ ਜੁਟੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि मोहासत्र जुटे ॥",
      "sourceLineId": "105502",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਕਿ ਤ੍ਰਾਸਾਸਤ੍ਰ ਬਰਖੇ ॥",
      "transliteration": "k traasaasatr barakhe ||",
      "translation": "",
      "punjabiViakhya": "ਤ੍ਰਾਸ ਅਸਤ੍ਰਾ ਦੀ ਬਰਖਾ ਹੋ ਰਹੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि त्रासासत्र बरखे ॥",
      "sourceLineId": "105503",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਕਿ ਕ੍ਰੋਧਾਸਤ੍ਰ ਕਰਖੇ ॥੨੯੦॥",
      "transliteration": "k krodhaasatr karakhe ||290||",
      "translation": "The Trasastras (the arms of fear) rained and Krodhastras (arms of anger) crackled.63.290.",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਅਸਤ੍ਰ ਖਿਚੇ ਜਾ ਰਹੇ ਹਨ ॥੨੯੦॥",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "कि क्रोधासत्र करखे ॥२९०॥",
      "sourceLineId": "105504",
      "sourceShabadId": "9443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਚੌਪਈ ਛੰਦ ॥",
      "transliteration": "chauapiee chha(n)dh ||",
      "translation": "CHAUPAI STANZA",
      "punjabiViakhya": "ਚੌਪਈ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "चौपई छंद ॥",
      "sourceLineId": "105505",
      "sourceShabadId": "9444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਬਹੁ ਛੋਰੇ ॥",
      "transliteration": "eeh bidh sasatr asatr bahu chhore ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਨਾਲ ਬਹੁਤ ਅਸਤ੍ਰ ਅਤੇ ਸ਼ਸਤ੍ਰ ਛਡੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "इह बिधि ससत्र असत्र बहु छोरे ॥",
      "sourceLineId": "105506",
      "sourceShabadId": "9444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਨ੍ਰਿਪ ਬਿਬੇਕ ਕੇ ਭਟ ਝਕਝੋਰੇ ॥",
      "transliteration": "nirap bibek ke bhaT jhakajhore ||",
      "translation": "In this way, many warriors of king Vivek were given a jerk and they left their arms and weapons",
      "punjabiViakhya": "ਬਿਬੇਕ ਰਾਜੇ ਦੇ ਯੋਧੇ ਝੰਝੋੜ ਦਿੱਤੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "नृप बिबेक के भट झकझोरे ॥",
      "sourceLineId": "105507",
      "sourceShabadId": "9444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਆਪਨ ਚਲਾ ਨਿਸਰਿ ਤਬ ਰਾਜਾ ॥",
      "transliteration": "aapan chalaa nisar tab raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜਾ ਆਪ (ਯੁੱਧ ਲਈ) ਨਿਕਲ ਕੇ ਚਲ ਪਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "आपन चला निसरि तब राजा ॥",
      "sourceLineId": "105508",
      "sourceShabadId": "9444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਬਾਜਨ ਬਾਜਾ ॥੨੯੧॥",
      "transliteration": "bhaat bhaat ke baajan baajaa ||291||",
      "translation": "Then the king himself moved and many types of musical instruments were played.64.291.",
      "punjabiViakhya": "(ਉਦੋਂ) ਤਰ੍ਰਹਾ ਤਰ੍ਰਹਾ ਦੇ ਵਾਜੇ ਵਜਣ ਲਗ ਗਏ ਹਨ ॥੨੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के बाजन बाजा ॥२९१॥",
      "sourceLineId": "105509",
      "sourceShabadId": "9444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਦੁਹੁ ਦਿਸਿ ਪੜਾ ਨਿਸਾਨੈ ਘਾਤਾ ॥",
      "transliteration": "dhuh dhis paRaa nisaanai ghaataa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਧਿਰਾ ਵਿਚ ਧੌਂਸਿਆਂ ਉਤੇ ਡਗੇ ਵਜੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "दुहु दिसि पड़ा निसानै घाता ॥",
      "sourceLineId": "105510",
      "sourceShabadId": "9444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਮਹਾ ਸਬਦ ਧੁਨਿ ਉਠੀ ਅਘਾਤਾ ॥",
      "transliteration": "mahaa sabadh dhun uThee aghaataa ||",
      "translation": "The trumpets sounded form both the sides and there were thundering noises",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੀ) ਚੋਟ ਨਾਲ ਬਹੁਤ ਭਾਰੀ ਧੁਨ ਉਠੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "महा सबद धुनि उठी अघाता ॥",
      "sourceLineId": "105511",
      "sourceShabadId": "9444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਬਰਖਾ ਬਾਣ ਗਗਨ ਗਯੋ ਛਾਈ ॥",
      "transliteration": "barakhaa baan gagan gayo chhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣਾ ਦੀ ਬਰਖਾ ਆਕਾਸ਼ ਵਿਚ ਛਾ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "बरखा बाण गगन गयो छाई ॥",
      "sourceLineId": "105512",
      "sourceShabadId": "9444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਭੂਤਿ ਪਿਸਾਚ ਰਹੇ ਉਰਝਾਈ ॥੨੯੨॥",
      "transliteration": "bhoot pisaach rahe urajhaiee ||292||",
      "translation": "The rain of arrows spread on the whole sky and the ghosts and fiends also got entangled.65.292.",
      "punjabiViakhya": "ਭੂਤ ਅਤੇ ਪਿਸ਼ਾਚ ਉਲਝ ਗਏ ਹਨ ॥੨੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "भूति पिसाच रहे उरझाई ॥२९२॥",
      "sourceLineId": "105513",
      "sourceShabadId": "9444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0703_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਝਿਮਿ ਝਿਮਿ ਸਾਰੁ ਗਗਨ ਤੇ ਬਰਖਾ ॥",
      "transliteration": "jhim jhim saar gagan te barakhaa ||",
      "translation": "",
      "punjabiViakhya": "ਆਕਾਸ਼ ਤੋਂ ਝਿੰਮ ਝਿੰਮ ਕਰਦਾ ਲੋਹਾ (ਲੋਹੇ ਦੇ ਬਾਣ) ਵਰ੍ਰਹਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 703,
      "hindi": "",
      "hindiTransliteration": "झिमि झिमि सारु गगन ते बरखा ॥",
      "sourceLineId": "105514",
      "sourceShabadId": "9444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
