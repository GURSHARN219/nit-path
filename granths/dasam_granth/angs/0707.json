{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 707,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0707_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭਯੋ ਬੀਰਖੇਤੰ ਕਥੈ ਕਉਣ ਖੰਤੰ ॥੩੨੬॥",
      "transliteration": "bhayo beerakheta(n) kathai kaun kha(n)ta(n) ||326||",
      "translation": "The war continued for the years of ten lakh ages and innumerable warriors died.99.326.",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਯੁੱਧ ਹੁੰਦਾ ਰਿਹਾ। (ਭਲਾ ਇਸ ਦਾ) ਕੌਣ ਕਥਨ ਕਰ ਸਕਦਾ ਹੈ ॥੩੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "भयो बीरखेतं कथै कउण खंतं ॥३२६॥",
      "sourceLineId": "105659",
      "sourceShabadId": "9452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤੇਰੇ ਜੋਰ ਸੰਗ ਕਹਤਾ ॥",
      "transliteration": "tere jor sa(n)g kahataa ||",
      "translation": "I UTTER WITH YOUR POWER :",
      "punjabiViakhya": "ਤੇਰੇ ਬਲ ਨਾਲ ਕਹਿੰਦਾ ਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "तेरे जोर संग कहता ॥",
      "sourceLineId": "105660",
      "sourceShabadId": "9453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭਈ ਅੰਧ ਧੁੰਧੰ ਮਚ੍ਯੋ ਬੀਰ ਖੇਤੰ ॥",
      "transliteration": "bhiee a(n)dh dhu(n)dha(n) machayo beer kheta(n) ||",
      "translation": "There was blind and rash destruction in war",
      "punjabiViakhya": "ਭਾਰੀ ਯੁੱਧ ਮਚਿਆ ਹੈ ਅਤੇ ਅੰਧਾ ਧੁੰਧ ਹੋ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "भई अंध धुँधं मच्यो बीर खेतं ॥",
      "sourceLineId": "105661",
      "sourceShabadId": "9453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਚੀ ਜੁਗਣੀ ਚਾਰੁ ਚਉਸਠ ਪ੍ਰੇਤੰ ॥",
      "transliteration": "nachee juganee chaar chausaTh preta(n) ||",
      "translation": "The sixty-four Yoginis and the fiends danced",
      "punjabiViakhya": "ਚੌਂਸਠ ਜੋਗਣਾ ਅਤੇ ਪ੍ਰੇਤ (ਆ ਕੇ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ) ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਚੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "नची जुगणी चारु चउसठ प्रेतं ॥",
      "sourceLineId": "105662",
      "sourceShabadId": "9453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਚੀ ਕਾਲਕਾ ਸ੍ਰੀ ਕਮਖ੍ਰਯਾ ਕਰਾਲੰ ॥",
      "transliteration": "nachee kaalakaa sree kamakhrayaa karaala(n) ||",
      "translation": "",
      "punjabiViakhya": "ਭਿਆਨਕ ਕਾਲਿਕਾ ਅਤੇ ਕਮਖ੍ਰਯਾ ਵੀ ਨਚੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "नची कालका स्री कमख्रया करालं ॥",
      "sourceLineId": "105663",
      "sourceShabadId": "9453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਡਕੰ ਡਾਕਣੀ ਜੋਧ ਜਾਗੰਤ ਜ੍ਵਾਲੰ ॥੩੨੭॥",
      "transliteration": "ddaka(n) ddaakanee jodh jaaga(n)t javaiaala(n) ||327||",
      "translation": "The dreadful Kamakkhya like Kali danced and the Dakinis (Vampires) belched like flames.100.327.",
      "punjabiViakhya": "ਡਾਕਣੀਆਂ ਡਕਾਰ ਰਹੀਆਂ ਹਨ ਅਤੇ ਯੁੱਧ ਵਿਚ ਅੱਗ ਨੂੰ ਮਚਾਦੀਆਂ ਹਨ ॥੩੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "डकं डाकणी जोध जागंत ज्वालं ॥३२७॥",
      "sourceLineId": "105664",
      "sourceShabadId": "9453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤੇਰਾ ਜੋਰੁ ॥",
      "transliteration": "teraa jor ||",
      "translation": "Thy Power",
      "punjabiViakhya": "ਤੇਰਾ ਜੋਰ:",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "तेरा जोरु ॥",
      "sourceLineId": "105665",
      "sourceShabadId": "9454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮਚ੍ਯੋ ਜੋਰ ਜੁਧੰ ਹਟ੍ਰਯੋ ਨਾਹਿ ਕੋਊ ॥",
      "transliteration": "machayo jor judha(n) haTrayo naeh kouoo ||",
      "translation": "There was terrible war and no one retraced his steps",
      "punjabiViakhya": "ਬਹੁਤ ਤਕੜਾ ਯੁੱਧ ਮਚਿਆ ਹੈ ਅਤੇ ਕੋਈ ਵੀ ਹਟਿਆ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "मच्यो जोर जुधं हट्रयो नाहि कोऊ ॥",
      "sourceLineId": "105666",
      "sourceShabadId": "9454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਡੇ ਛਤ੍ਰਧਾਰੀ ਪਤੀ ਛਤ੍ਰ ਦੋਊ ॥",
      "transliteration": "badde chhatradhaaree patee chhatr dhouoo ||",
      "translation": "There were many great warriors and Sovereigns there",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਹੀ ਬਹੁਤ ਛਤ੍ਰਧਾਰੀ ਅਤੇ ਛਤ੍ਰਪਤੀ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "बडे छत्रधारी पती छत्र दोऊ ॥",
      "sourceLineId": "105667",
      "sourceShabadId": "9454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਖਪ੍ਯੋ ਸਰਬ ਲੋਕੰ ਅਲੋਕੰ ਅਪਾਰੰ ॥",
      "transliteration": "khapayo sarab loka(n) aloka(n) apaara(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਲੋਕਾ ਅਤੇ (ਅਣਦਿਸਦੇ) ਅਪਾਰ ਅਲੋਕਾ ਨੂੰ ਖਪਾ ਦਿੱਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "खप्यो सरब लोकं अलोकं अपारं ॥",
      "sourceLineId": "105668",
      "sourceShabadId": "9454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਿਟੇ ਜੁਧ ਤੇ ਏ ਨ ਜੋਧਾ ਜੁਝਾਰੰ ॥੩੨੮॥",
      "transliteration": "miTe judh te e na jodhaa jujhaara(n) ||328||",
      "translation": "This war continued in all the worlds and then warriors were not finished even in this dreadful war.101.328.",
      "punjabiViakhya": "(ਪਰ) ਇਹ ਜੁਝਾਰੂ ਯੋਧੇ ਯੁੱਧ ਤੋਂ ਮਿਟੇ ਨਹੀਂ ਹਨ ॥੩੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "मिटे जुध ते ए न जोधा जुझारं ॥३२८॥",
      "sourceLineId": "105669",
      "sourceShabadId": "9454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤੇਰਾ ਜੋਰ ॥",
      "transliteration": "teraa jor ||",
      "translation": "Thy Power",
      "punjabiViakhya": "ਤੇਰਾ ਜੋਰ:",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "तेरा जोर ॥",
      "sourceLineId": "105670",
      "sourceShabadId": "9455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "105671",
      "sourceShabadId": "9455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚਟਪਟ ਸੁਭਟ ਬਿਕਟ ਕਟੇ ਝਟਪਟ ਭਈ ਅਭੰਗ ॥",
      "transliteration": "chaTapaT subhaT bikaT kaTe jhaTapaT bhiee abha(n)g ||",
      "translation": "In that fierce fight the great warriors were chopped quickly",
      "punjabiViakhya": "ਝਟਪਟ ਹੀ ਨਾ ਕਟੇ ਜਾ ਸਕਣ ਵਾਲੇ ਯੋਧੇ ਕਟੇ ਗਏ ਹਨ ਅਤੇ ਨਾ ਭੰਗ ਹੋਣ ਵਾਲੇ ਵੀ ਝਟਪਟ (ਭੰਗ) ਹੋ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "चटपट सुभट बिकट कटे झटपट भई अभंग ॥",
      "sourceLineId": "105672",
      "sourceShabadId": "9455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਲਟਿ ਭਟ ਹਟੇ ਨ ਰਨ ਘਟ੍ਰਯੋ ਅਟਪਟ ਮਿਟ੍ਰਯੋ ਨ ਜੰਗ ॥੩੨੯॥",
      "transliteration": "laT bhaT haTe na ran ghaTrayo aTapaT miTrayo na ja(n)g ||329||",
      "translation": "No warrior ran and retraced his steps and this war did not end.102.329.",
      "punjabiViakhya": "ਨਾ ਸੂਰਮੇ ਟਲੇ ਹਨ ਅਤੇ ਨਾ ਹਟੇ ਹਨ; ਨਾ ਲੜਾਈ ਘਟੀ ਹੈ ਅਤੇ ਨਾ ਹੀ ਇਸ ਅਟਪਟੀ ਅਵਸਥਾ ਵਿਚ ਯੁੱਧ ਮਿਟਿਆ ਹੈ ॥੩੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "लटि भट हटे न रन घट्रयो अटपट मिट्रयो न जंग ॥३२९॥",
      "sourceLineId": "105673",
      "sourceShabadId": "9455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤੇਰੇ ਜੋਰਿ ॥",
      "transliteration": "tere jor ||",
      "translation": "Thy Power",
      "punjabiViakhya": "ਤੇਰਾ ਜੋਰ:",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "तेरे जोरि ॥",
      "sourceLineId": "105674",
      "sourceShabadId": "9456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "105675",
      "sourceShabadId": "9456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬੀਸ ਲਛ ਜੁਗ ਐਤੁ ਪ੍ਰਮਾਨਾ ॥",
      "transliteration": "bees lachh jug aait pramaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਵੀਹ ਲਖ ਯੁਗ ਅਤੇ ਵੀਹ ਹਜ਼ਾਰ ('ਐਤੁ') ਤਕ ਦੋਵੇਾਂ ਲੜਦੇ ਰਹੇ,",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "बीस लछ जुग ऐतु प्रमाना ॥",
      "sourceLineId": "105676",
      "sourceShabadId": "9456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਲਰੇ ਦੋਊ ਭਈ ਕਿਸ ਨ ਹਾਨਾ ॥",
      "transliteration": "lare dhouoo bhiee kis na haanaa ||",
      "translation": "The war continued from both sides for twenty lakh ages, but no one was defeated",
      "punjabiViakhya": "ਪਰ ਕਿਸੇ ਦਾ ਵੀ ਨਾਸ਼ ਨਾ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "लरे दोऊ भई किस न हाना ॥",
      "sourceLineId": "105677",
      "sourceShabadId": "9456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਬ ਰਾਜਾ ਜੀਅ ਮੈ ਅਕੁਲਾਯੋ ॥",
      "transliteration": "tab raajaa jeea mai akulaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜਾ (ਪਾਰਸ ਨਾਥ) ਮਨ ਵਿਚ ਵਿਆਕੁਲ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "तब राजा जीअ मै अकुलायो ॥",
      "sourceLineId": "105678",
      "sourceShabadId": "9456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਾਕ ਚਢੇ ਮਛਿੰਦ੍ਰ ਪੈ ਆਯੋ ॥੩੩੦॥",
      "transliteration": "naak chadde machhi(n)dhr pai aayo ||330||",
      "translation": "Then the king got agitated and came to Matsyendra.103.330.",
      "punjabiViakhya": "ਨਕ ਚੜ੍ਰਹਾ ਕੇ ਮਛਿੰਦ੍ਰ ਕੋਲ ਆਇਆ ॥੩੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "नाक चढे मछिंद्र पै आयो ॥३३०॥",
      "sourceLineId": "105679",
      "sourceShabadId": "9456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਹਿ ਮੁਨਿ ਬਰਿ ਸਭ ਮੋਹਿ ਬਿਚਾਰਾ ॥",
      "transliteration": "keh mun bar sabh moh bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿਣ ਲਗਿਆ) ਹੇ ਸ੍ਰੇਸ਼ਠ ਮੁਨੀ! ਮੈਨੂੰ ਸਾਰਾ ਵਿਚਾਰ ਕਹਿ ਕੇ ਦਸ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "कहि मुनि बरि सभ मोहि बिचारा ॥",
      "sourceLineId": "105680",
      "sourceShabadId": "9456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਏ ਦੋਊ ਬੀਰ ਬਡੇ ਬਰਿਆਰਾ ॥",
      "transliteration": "e dhouoo beer badde bariaaraa ||",
      "translation": "(The king said), “O superb sage! instruct me  both of them are great warriors",
      "punjabiViakhya": "ਇਹ ਦੋਵੇਾਂ ਸੂਰਮੇ ਬਹੁਤ ਬਲਵਾਨ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "ए दोऊ बीर बडे बरिआरा ॥",
      "sourceLineId": "105681",
      "sourceShabadId": "9456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਇਨ ਕਾ ਬਿਰੁਧ ਨਿਵਰਤ ਨ ਭਯਾ ॥",
      "transliteration": "ein kaa birudh nivarat na bhayaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਦਾ (ਆਪਸੀ) ਵਿਰੋਧ ਨਿਵ੍ਰਿਤ ਨਹੀਂ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "इन का बिरुध निवरत न भया ॥",
      "sourceLineId": "105682",
      "sourceShabadId": "9456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਇਨੋ ਛਡਾਵਤ ਸਭ ਜਗੁ ਗਯਾ ॥੩੩੧॥",
      "transliteration": "eino chhaddaavat sabh jag gayaa ||331||",
      "translation": "Their opposition does not end and with the desire to get release from them, the whole world is going to end.104.331.",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਨੂੰ ਛੁਡਾਦਿਆਂ ਛੁਡਾਦਿਆਂ ਸਾਰਾ ਜਗਤ (ਨਸ਼ਟ ਹੋ) ਗਿਆ ਹੈ ॥੩੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "इनो छडावत सभ जगु गया ॥३३१॥",
      "sourceLineId": "105683",
      "sourceShabadId": "9456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਇਨੈ ਜੁਝਾਵਤ ਸਬ ਕੋਈ ਜੂਝਾ ॥",
      "transliteration": "einai jujhaavat sab koiee joojhaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਨੂੰ ਲੜਾਉਾਂਦੇ ਹੋਇਆਂ ਹਰ ਕੋਈ ਜੂਝ ਮਰਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "इनै जुझावत सब कोई जूझा ॥",
      "sourceLineId": "105684",
      "sourceShabadId": "9456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਇਨ ਕਾ ਅੰਤ ਨ ਕਾਹੂ ਸੂਝਾ ॥",
      "transliteration": "ein kaa a(n)t na kaahoo soojhaa ||",
      "translation": "The whole world fought and fell on trying to kill them, but it could not know their end",
      "punjabiViakhya": "(ਪਰ) ਇਨ੍ਰਹਾ ਦਾ ਅੰਤ ਕਿਸੇ ਨੇ ਵੀ ਨਹੀਂ ਜਾਣਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "इन का अंत न काहू सूझा ॥",
      "sourceLineId": "105685",
      "sourceShabadId": "9456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਏ ਹੈ ਆਦਿ ਹਠੀ ਬਰਿਆਰਾ ॥",
      "transliteration": "e hai aadh haThee bariaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਸਭ ਤੋਂ ਮੁਢਲੇ ਹਠੀ ਅਤੇ ਬਲਵਾਨ ਹਨ;",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "ए है आदि हठी बरिआरा ॥",
      "sourceLineId": "105686",
      "sourceShabadId": "9456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਹਾਰਥੀ ਅਉ ਮਹਾ ਭਯਾਰਾ ॥੩੩੨॥",
      "transliteration": "mahaarathee aau mahaa bhayaaraa ||332||",
      "translation": "These dreadful warriors are greatly persistent, greatly heroic and greatly terrible.105.332.",
      "punjabiViakhya": "ਮਹਾਰਥੀ ਅਤੇ ਬਹੁਤ ਭਿਆਨਕ ਹਨ ॥੩੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "महारथी अउ महा भयारा ॥३३२॥",
      "sourceLineId": "105687",
      "sourceShabadId": "9456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਚਨੁ ਮਛਿੰਦ੍ਰ ਸੁਨਤ ਚੁਪ ਰਹਾ ॥",
      "transliteration": "bachan machhi(n)dhr sunat chup rahaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਛਿੰਦ੍ਰ (ਰਾਜੇ ਦੇ) ਬਚਨ ਸੁਣ ਕੇ ਚੁਪ ਹੀ ਰਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "बचनु मछिंद्र सुनत चुप रहा ॥",
      "sourceLineId": "105688",
      "sourceShabadId": "9456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਧਰਾ ਨਾਥ ਸਬਨਨ ਤਨ ਕਹਾ ॥",
      "transliteration": "dharaa naath sabanan tan kahaa ||",
      "translation": "Hearing this Matsyendra remained silent and Parasnath etc. all of them said their things to him",
      "punjabiViakhya": "(ਫਿਰ) ਰਾਜੇ (ਪਾਰਸ ਨਾਥ) ਨੇ ਸਭ ਨੂੰ ਕਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "धरा नाथ सबनन तन कहा ॥",
      "sourceLineId": "105689",
      "sourceShabadId": "9456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚਕ੍ਰਿਤ ਚਿਤ ਚਟਪਟ ਹ੍ਵੈ ਦਿਖਸਾ ॥",
      "transliteration": "chakirat chit chaTapaT havai dhikhasaa ||",
      "translation": "",
      "punjabiViakhya": "(ਮਛਿੰਦ੍ਰ ਨੇ) ਚਿਤ ਵਿਚ ਹੈਰਾਨ ਹੋ ਕੇ ਝਟਪਟ (ਪਾਰਸ ਨਾਥ ਵਲ) ਤਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "चकृत चित चटपट ह्वै दिखसा ॥",
      "sourceLineId": "105690",
      "sourceShabadId": "9456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚਰਪਟ ਨਾਥ ਤਦਿਨ ਤੇ ਨਿਕਸਾ ॥੩੩੩॥",
      "transliteration": "charapaT naath tadhin te nikasaa ||333||",
      "translation": "There then occurred a miracle, marvelous for all and on the same day Charpatnath appeared.106.333.",
      "punjabiViakhya": "ਉਸ ਦਿਨ ਤੋਂ ਚਰਪਟ ਨਾਥ ਪ੍ਰਗਟ ਹੋ ਗਿਆ ॥੩੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "चरपट नाथ तदिन ते निकसा ॥३३३॥",
      "sourceLineId": "105691",
      "sourceShabadId": "9456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਇਤਿ ਚਰਪਟ ਨਾਥ ਪ੍ਰਗਟਣੋ ਨਾਮਹ ॥",
      "transliteration": "eit charapaT naath pragaTano naameh ||",
      "translation": "Now begins the description of the Praise of Primal Purusha",
      "punjabiViakhya": "ਇਥੇ ਚਰਪਟ ਨਾਥ ਨਾਮ ਵਾਲਾ (ਜੋਗੀ) ਪ੍ਰਗਟ ਹੋਇਆ:",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "इति चरपट नाथ प्रगटणो नामह ॥",
      "sourceLineId": "105692",
      "sourceShabadId": "9456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "105693",
      "sourceShabadId": "9457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੁਨਿ ਰਾਜਾ ਤੁਹਿ ਕਹੈ ਬਿਬੇਕਾ ॥",
      "transliteration": "sun raajaa tuh kahai bibekaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਸੁਣੋ, ਤੁਹਾਨੂੰ ਬਿਬੇਕ ਦਾ (ਬ੍ਰਿੱਤਾਤ) ਕਹਿੰਦਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "सुनि राजा तुहि कहै बिबेका ॥",
      "sourceLineId": "105694",
      "sourceShabadId": "9457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਇਨ ਕਹ ਦ੍ਵੈ ਜਾਨਹੁ ਜਿਨਿ ਏਕਾ ॥",
      "transliteration": "ein keh dhavai jaanahu jin ekaa ||",
      "translation": "“O king! listen, I speak to you a thing of knowledge",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਦੋਹਾ ਨੂੰ ਦੋ ਨਾ ਸਮਝੋ, ਇਕ ਹੀ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "इन कह द्वै जानहु जिनि एका ॥",
      "sourceLineId": "105695",
      "sourceShabadId": "9457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਏ ਅਬਿਕਾਰ ਪੁਰਖ ਅਵਤਾਰੀ ॥",
      "transliteration": "e abikaar purakh avataaree ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਵਿਕਾਰ ਰਹਿਤ ਅਵਤਾਰੀ ਪੁਰਸ਼ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "ए अबिकार पुरख अवतारी ॥",
      "sourceLineId": "105696",
      "sourceShabadId": "9457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਡੇ ਧਨੁਰਧਰ ਬਡੇ ਜੁਝਾਰੀ ॥੩੩੪॥",
      "transliteration": "badde dhanuradhar badde jujhaaree ||334||",
      "translation": "You should not consider both as one   these vice-less persons are great archers and brace fighters.107.334.",
      "punjabiViakhya": "ਵੱਡੇ ਧਨੁਸ਼ਧਾਰੀ ਅਤੇ ਬਹੁਤ ਲੜਾਕੇ ਹਨ ॥੩੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "बडे धनुरधर बडे जुझारी ॥३३४॥",
      "sourceLineId": "105697",
      "sourceShabadId": "9457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਆਦਿ ਪੁਰਖ ਜਬ ਆਪ ਸੰਭਾਰਾ ॥",
      "transliteration": "aadh purakh jab aap sa(n)bhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਆਦਿ ਪੁਰਖ ਨੇ ਜਦ ਆਪਣੇ ਆਪ ਨੂੰ ਸੰਭਾਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "आदि पुरख जब आप संभारा ॥",
      "sourceLineId": "105698",
      "sourceShabadId": "9457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਆਪ ਰੂਪ ਮੈ ਆਪ ਨਿਹਾਰਾ ॥",
      "transliteration": "aap roop mai aap nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ) ਆਪਣੇ ਰੂਪ ਵਿਚ ਆਪਣੇ ਆਪ ਨੂੰ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "आप रूप मै आप निहारा ॥",
      "sourceLineId": "105699",
      "sourceShabadId": "9457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਓਅੰਕਾਰ ਕਹ ਇਕਦਾ ਕਹਾ ॥",
      "transliteration": "oa(n)kaar keh ikadhaa kahaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਵਾਰ 'ਓਅੰਕਾਰ' (ਸ਼ਬਦ) ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "ओअंकार कह इकदा कहा ॥",
      "sourceLineId": "105700",
      "sourceShabadId": "9457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭੂਮਿ ਅਕਾਸ ਸਕਲ ਬਨਿ ਰਹਾ ॥੩੩੫॥",
      "transliteration": "bhoom akaas sakal ban rahaa ||335||",
      "translation": "When Primal Purusha, the Lord reflected within Himself and visualized his own form himself, He uttered the world AUMKARA, because of which the earth, the sky and the whole world was created.108.335.",
      "punjabiViakhya": "(ਤਦ) ਸਾਰੀ ਭੂਮੀ ਅਤੇ ਆਕਾਸ਼ ਬਣ ਕੇ ਸਥਿਤ ਹੋ ਗਿਆ ॥੩੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "भूमि अकास सकल बनि रहा ॥३३५॥",
      "sourceLineId": "105701",
      "sourceShabadId": "9457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦਾਹਨ ਦਿਸ ਤੇ ਸਤਿ ਉਪਜਾਵਾ ॥",
      "transliteration": "dhaahan dhis te sat upajaavaa ||",
      "translation": "He created truth from the right side and",
      "punjabiViakhya": "ਸੱਜੇ ਪਾਸੇ ਤੋਂ 'ਸਤਿ' ਨੂੰ ਪੈਦਾ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "दाहन दिस ते सति उपजावा ॥",
      "sourceLineId": "105702",
      "sourceShabadId": "9457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਾਮ ਪਰਸ ਤੇ ਝੂਠ ਬਨਾਵਾ ॥",
      "transliteration": "baam paras te jhooTh banaavaa ||",
      "translation": "Made falsehood on the left",
      "punjabiViakhya": "ਅਤੇ ਖਬੇ ਪਾਸੇ ਤੋਂ 'ਝੂਠ' ਨੂੰ ਉਤਪੰਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "बाम परस ते झूठ बनावा ॥",
      "sourceLineId": "105703",
      "sourceShabadId": "9457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਉਪਜਤ ਹੀ ਉਠਿ ਜੁਝੇ ਜੁਝਾਰਾ ॥",
      "transliteration": "aupajat hee uTh jujhe jujhaaraa ||",
      "translation": "On taking birth both these warriors began to fight and",
      "punjabiViakhya": "ਪੈਦਾ ਹੁੰਦਿਆਂ ਹੀ (ਇਹ ਦੋਵੇਾਂ) ਸੂਰਮੇ ਲੜਨ ਲਗ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "उपजत ही उठि जुझे जुझारा ॥",
      "sourceLineId": "105704",
      "sourceShabadId": "9457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਬ ਤੇ ਕਰਤ ਜਗਤ ਮੈ ਰਾਰਾ ॥੩੩੬॥",
      "transliteration": "tab te karat jagat mai raaraa ||336||",
      "translation": "Since that time, they are opposing each other in the world.109.336.",
      "punjabiViakhya": "ਤਦ ਤੋਂ (ਇਹ) ਜਗਤ ਵਿਚ ਲੜਾਈ ਕਰਦੇ ਆ ਰਹੇ ਹਨ ॥੩੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 707,
      "hindi": "",
      "hindiTransliteration": "तब ते करत जगत मै रारा ॥३३६॥",
      "sourceLineId": "105705",
      "sourceShabadId": "9457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0707_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਹੰਸ ਬਰਖ ਜੋ ਆਯੁ ਬਢਾਵੈ ॥",
      "transliteration": "saha(n)s barakh jo aay baddaavai ||",
