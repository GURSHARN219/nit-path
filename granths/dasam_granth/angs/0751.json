  "lines": [
    {
      "id": "dasam_ang_0751_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਧਰਾ ਸਬਦ ਕੋ ਆਦਿ ਭਨੀਜੈ ॥",
      "transliteration": "dharaa sabadh ko aadh bhaneejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਧਰਾ' ਸ਼ਬਦ ਨੂੰ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "धरा सबद को आदि भनीजै ॥",
      "sourceLineId": "107531",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇੰਦ੍ਰ ਸਬਦ ਤਾ ਪਾਛੇ ਦੀਜੈ ॥",
      "transliteration": "ei(n)dhr sabadh taa paachhe dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਬਾਦ 'ਇੰਦ੍ਰ' (ਬ੍ਰਿਛ) ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "इंद्र सबद ता पाछे दीजै ॥",
      "sourceLineId": "107532",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪ੍ਰਿਸਠਨਿ ਪਦ ਕੋ ਬਹੁਰਿ ਉਚਾਰੋ ॥",
      "transliteration": "pirasaThan padh ko bahur uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਪ੍ਰਿਸਠਨਿ' ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "पृसठनि पद को बहुरि उचारो ॥",
      "sourceLineId": "107533",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਬੀਚਾਰੋ ॥੭੦੬॥",
      "transliteration": "sakal tupak ke naam beechaaro ||706||",
      "translation": "Saying the word “Dharaa” in the beginning and then “Indra” and afterwards adding the word “Prashthani”, all the names of Tupak are comprehended.706.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦੇ ਨਾਮ ਸਮਝੋ ॥੭੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम बीचारो ॥७०६॥",
      "sourceLineId": "107534",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਧਰਾ ਸਬਦ ਕੋ ਆਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "dharaa sabadh ko aadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਾ' ਸ਼ਬਦ ਨੂੰ ਪਹਿਲਾ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "धरा सबद को आदि उचरीऐ ॥",
      "sourceLineId": "107535",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪਾਲਕ ਸਬਦ ਸੁ ਅੰਤਿ ਬਿਚਰੀਐ ॥",
      "transliteration": "paalak sabadh su a(n)t bichareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਾਲਕ' ਸ਼ਬਦ ਨੂੰ ਅੰਤ ਵਿਚ ਵਿਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "पालक सबद सु अंति बिचरीऐ ॥",
      "sourceLineId": "107536",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪ੍ਰਿਸਠਨਿ ਪਦ ਕੋ ਬਹੁਰਿ ਬਖਾਨੋ ॥",
      "transliteration": "pirasaThan padh ko bahur bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਪਿਛੋ 'ਪ੍ਰਿਸਠਨਿ' ਪਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "पृसठनि पद को बहुरि बखानो ॥",
      "sourceLineId": "107537",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਭ ਹੀ ਨਾਮ ਤੁਪਕ ਕੇ ਜਾਨੋ ॥੭੦੭॥",
      "transliteration": "sabh hee naam tupak ke jaano ||707||",
      "translation": "Saying firstly the word “Dharaa”, then adding the word “Paalak” and then uttering the word “Paalak” and then uttering the word “Prashthani”, all the names of Tupak are known.707.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੭੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "सभ ही नाम तुपक के जानो ॥७०७॥",
      "sourceLineId": "107538",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਰੁਜ ਸਬਦ ਕੋ ਆਦਿ ਬਖਾਨੋ ॥",
      "transliteration": "taruj sabadh ko aadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਤਰੁਜ' (ਬ੍ਰਿਛ ਤੋਂ ਪੈਦਾ ਹੋਇਆ ਕਾਠ) ਸ਼ਬਦ ਨੂੰ ਪਹਿਲਾ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "तरुज सबद को आदि बखानो ॥",
      "sourceLineId": "107539",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਾਥ ਸਬਦ ਤਿਹ ਅੰਤਿ ਪ੍ਰਮਾਨੋ ॥",
      "transliteration": "naath sabadh teh a(n)t pramaano ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਨਾਥ' ਸ਼ਬਦ ਰਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "नाथ सबद तिह अंति प्रमानो ॥",
      "sourceLineId": "107540",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪ੍ਰਿਸਠਨਿ ਸਬਦ ਸੁ ਬਹੁਰਿ ਭਨੀਜੈ ॥",
      "transliteration": "pirasaThan sabadh su bahur bhaneejai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਪ੍ਰਿਸਠਨਿ' ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "पृसठनि सबद सु बहुरि भनीजै ॥",
      "sourceLineId": "107541",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਮ ਜਾਨ ਤੁਪਕ ਕੋ ਲੀਜੈ ॥੭੦੮॥",
      "transliteration": "naam jaan tupak ko leejai ||708||",
      "translation": "Saying the word “Taruj” in the beginning and adding the word “Naath” and then uttering the word “Prashthani”, comprehend the names of Tupak.708.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ ॥੭੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "नाम जान तुपक को लीजै ॥७०८॥",
      "sourceLineId": "107542",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦ੍ਰੁਮਜ ਸਬਦ ਕੋ ਆਦਿ ਸੁ ਦੀਜੈ ॥",
      "transliteration": "dhrumaj sabadh ko aadh su dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਦ੍ਰੁਮਜ' ਸ਼ਬਦ ਨੂੰ ਪਹਿਲਾ ਰਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "द्रुमज सबद को आदि सु दीजै ॥",
      "sourceLineId": "107543",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਇਕ ਪਦ ਕੋ ਬਹੁਰਿ ਭਨੀਜੈ ॥",
      "transliteration": "naik padh ko bahur bhaneejai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਨਾਇਕ' ਪਦ ਸ਼ਾਮਲ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "नाइक पद को बहुरि भनीजै ॥",
      "sourceLineId": "107544",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪ੍ਰਿਸਠਨਿ ਸਬਦ ਸੁ ਅੰਤਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "pirasaThan sabadh su a(n)t bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਅਖੀਰ ਉਤੇ 'ਪ੍ਰਿਸਠਨਿ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "पृसठनि सबद सु अंति बखानहु ॥",
      "sourceLineId": "107545",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਭ ਹੀ ਨਾਮ ਤੁਪਕ ਕੇ ਮਾਨਹੁ ॥੭੦੯॥",
      "transliteration": "sabh hee naam tupak ke maanahu ||709||",
      "translation": "Putting the word “Drumaj” in the beginning, then adding the word “Naayak” and then adding the word “Prashthani” at the end, all the names of Tupak are comprehended.709.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਾਰੇ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੭੦੯॥",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "सभ ही नाम तुपक के मानहु ॥७०९॥",
      "sourceLineId": "107546",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਫਲ ਪਦ ਆਦਿ ਉਚਾਰਨ ਕੀਜੈ ॥",
      "transliteration": "fal padh aadh uchaaran keejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਫਲ' ਪਦ ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "फल पद आदि उचारन कीजै ॥",
      "sourceLineId": "107547",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਨਾਇਕ ਪਦ ਦੀਜੈ ॥",
      "transliteration": "taa paachhe naik padh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਿਛੋਂ 'ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "ता पाछे नाइक पद दीजै ॥",
      "sourceLineId": "107548",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪੁਨਿ ਪ੍ਰਿਸਠਨਿ ਤੁਮ ਸਬਦ ਉਚਾਰੋ ॥",
      "transliteration": "pun pirasaThan tum sabadh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਤੁਸੀਂ 'ਪ੍ਰਿਸਠਨਿ' ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "पुनि पृसठनि तुम सबद उचारो ॥",
      "sourceLineId": "107549",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਬਿਚਾਰੋ ॥੭੧੦॥",
      "transliteration": "naam tupak ke sakal bichaaro ||710||",
      "translation": "Uttering firstly the word “Phal”, then the word “Naayak” and then saying the word “Prashthani”, all the names of Tupak are comprehended.710.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਲੋਗ ਤੁਪਕ ਦੇ ਨਾਮ ਸਮਝੋ ॥੭੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल बिचारो ॥७१०॥",
      "sourceLineId": "107550",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਰੁਜ ਸਬਦ ਕੋ ਆਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "taruj sabadh ko aadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਤਰੁਜ' (ਬ੍ਰਿਛ ਤੋਂ ਜਨਮਿਆ ਕਾਠ) ਨੂੰ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "तरुज सबद को आदि उचरीऐ ॥",
      "sourceLineId": "107551",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰਾਜ ਸਬਦ ਕੋ ਬਹੁਰਿ ਸੁ ਧਰੀਐ ॥",
      "transliteration": "raaj sabadh ko bahur su dhareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਰਾਜ' ਸ਼ਬਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "राज सबद को बहुरि सु धरीऐ ॥",
      "sourceLineId": "107552",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਪ੍ਰਿਸਠਨਿ ਪਦ ਦੀਜੈ ॥",
      "transliteration": "taa paachhe pirasaThan padh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਪਿਛੋਂ 'ਪ੍ਰਿਸਠਨਿ' ਸ਼ਬਦ ਨੂੰ ਰਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "ता पाछे पृसठनि पद दीजै ॥",
      "sourceLineId": "107553",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾਮ ਤੁਫੰਗ ਜਾਨ ਜੀਅ ਲੀਜੈ ॥੭੧੧॥",
      "transliteration": "naam tufa(n)g jaan jeea leejai ||711||",
      "translation": "Saying the word “Taruj” in the beginning and then adding the words “Raaj” and “Prashthani”, the names of Tupak (Tuphang) are known in the mind.711.",
      "punjabiViakhya": "(ਇਸ ਦਾ) ਮਨ ਵਿਚ ਤੁਫੰਗ (ਤੁਪਕ) ਨਾਮ ਜਾਣ ਲਵੋ ॥੭੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "नाम तुफंग जान जीअ लीजै ॥७११॥",
      "sourceLineId": "107554",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਧਰਨੀਜਾ ਪਦ ਆਦਿ ਭਨਿਜੈ ॥",
      "transliteration": "dharaneejaa padh aadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਧਰਨੀਜਾ' (ਧਰਤੀ ਤੋਂ ਪੈਦਾ ਹੋਇਆ ਬ੍ਰਿਛ) ਪਦ ਆਰੰਭ ਵਿਚ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "धरनीजा पद आदि भनिजै ॥",
      "sourceLineId": "107555",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਾਟ ਸਬਦ ਤਾ ਪਾਛੇ ਦਿਜੈ ॥",
      "transliteration": "raaT sabadh taa paachhe dhijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਿਛੋਂ 'ਰਾਟ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "राट सबद ता पाछे दिजै ॥",
      "sourceLineId": "107556",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪ੍ਰਿਸਠਨਿ ਪਦ ਕੋ ਅੰਤਿ ਬਖਾਨੋ ॥",
      "transliteration": "pirasaThan padh ko a(n)t bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਤ ਉਤੇ 'ਪ੍ਰਿਸਠਨਿ' ਪਦ ਨੂੰ ਰਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "पृसठनि पद को अंति बखानो ॥",
      "sourceLineId": "107557",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਸਭ ਭੇਦ ਨ ਮਾਨੋ ॥੭੧੨॥",
      "transliteration": "naam tupak sabh bhedh na maano ||712||",
      "translation": "Saying the words “Dharni Jaa”, then adding the word “Raat” and afterwards adding the words “Prashthani” , comprehend all the names of Tupak.712.",
      "punjabiViakhya": "(ਇਹ) ਤੁਪਕ ਦਾ ਨਾਮ ਹੈ, ਸਾਰੇ ਲੋਗ ਕੋਈ ਸੰਸਾ ਨਾ ਕਰੋ ॥੭੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक सभ भेद न मानो ॥७१२॥",
      "sourceLineId": "107558",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬ੍ਰਿਛਜ ਸਬਦ ਕੋ ਆਦਿ ਭਨੀਜੈ ॥",
      "transliteration": "birachhaj sabadh ko aadh bhaneejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬ੍ਰਿਛਜ' ਸ਼ਬਦ ਦਾ ਵਰਣਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "बृछज सबद को आदि भनीजै ॥",
      "sourceLineId": "107559",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਾ ਪਾਛੈ ਰਾਜਾ ਪਦ ਦੀਜੈ ॥",
      "transliteration": "taa paachhai raajaa padh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਿਛੋਂ ਰਾਜਾ ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "ता पाछै राजा पद दीजै ॥",
      "sourceLineId": "107560",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪ੍ਰਿਸਠਨਿ ਸਬਦ ਸੁ ਅੰਤਿ ਉਚਾਰੋ ॥",
      "transliteration": "pirasaThan sabadh su a(n)t uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਤ ਉਤੇ 'ਪ੍ਰਿਸਠਨਿ' ਸ਼ਬਦ ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "पृसठनि सबद सु अंति उचारो ॥",
      "sourceLineId": "107561",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਬਿਚਾਰੋ ॥੭੧੩॥",
      "transliteration": "naam tupak ke sakal bichaaro ||713||",
      "translation": "Saying the word “Vrakshaj” in the beginning and then adding the words “Raajaa” and “Prashthani”, comprehend all the names of Tupak.713.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਾਰੇ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੭੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल बिचारो ॥७१३॥",
      "sourceLineId": "107562",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਰੁ ਰੁਹ ਅਨੁਜ ਆਦਿ ਪਦ ਦੀਜੈ ॥",
      "transliteration": "tar ruh anuj aadh padh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਤਰੁ ਰੁਹ ਅਨੁਜ' ਪਦ ਰਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "तरु रुह अनुज आदि पद दीजै ॥",
      "sourceLineId": "107563",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਇਕ ਪਦ ਕੋ ਬਹੁਰਿ ਭਨੀਜੈ ॥",
      "transliteration": "naik padh ko bahur bhaneejai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਨਾਇਕ' ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "नाइक पद को बहुरि भनीजै ॥",
      "sourceLineId": "107564",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪ੍ਰਿਸਠਨਿ ਸਬਦ ਅੰਤ ਕੋ ਦੀਨੇ ॥",
      "transliteration": "pirasaThan sabadh a(n)t ko dheene ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਿਸਠਨਿ' ਸ਼ਬਦ ਅੰਤ ਉਤੇ ਰਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "पृसठनि सबद अंत को दीने ॥",
      "sourceLineId": "107565",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਹੋਹਿੰ ਨਵੀਨੇ ॥੭੧੪॥",
      "transliteration": "naam tupak ke hohi(n) naveene ||714||",
      "translation": "Saying the words “Taru-ruha-anuj” in the beginning and then adding the words “Naayak” and “Prashthani”, new names of Tupak are evolved.714.",
      "punjabiViakhya": "(ਇਹ) ਤੁਪਕ ਦਾ ਨਵਾ ਨਾਮ ਹੋ ਜਾਏਗਾ ॥੭੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के होहिं नवीने ॥७१४॥",
      "sourceLineId": "107566",
      "sourceShabadId": "9495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "107567",
      "sourceShabadId": "9496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਰੁ ਰੁਹ ਪ੍ਰਿਸਠਨਿ ਪ੍ਰਥਮ ਹੀ ਮੁਖ ਤੇ ਕਰੌ ਉਚਾਰ ॥",
      "transliteration": "tar ruh pirasaThan pratham hee mukh te karau uchaar ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਤਰੁ ਰੁਹ ਪ੍ਰਿਸਠਨਿ' (ਸ਼ਬਦਾ) ਨੂੰ ਮੂੰਹ ਤੋਂ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "तरु रुह पृसठनि प्रथम ही मुख ते करौ उचार ॥",
      "sourceLineId": "107568",
      "sourceShabadId": "9496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਹੋਤ ਹੈ ਚੀਨਿ ਚਤੁਰ ਨਿਰਧਾਰ ॥੭੧੫॥",
      "transliteration": "naam tupak ke hot hai cheen chatur niradhaar ||715||",
      "translation": "Saying the words “Taru-ruha-prashthani”, O wise men! the names of Tupak may be comprehended.715.",
      "punjabiViakhya": "(ਇਹ) ਨਾਮ ਤੁਪਕ ਦਾ ਹੁੰਦਾ ਹੈ। ਇਸ ਨੂੰ ਚਤਰੋ! ਨਿਸਚੈ ਕਰ ਲਵੋ ॥੭੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के होत है चीनि चतुर निरधार ॥७१५॥",
      "sourceLineId": "107569",
      "sourceShabadId": "9496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੁਕਬਿ ਬਕਤ੍ਰ ਤੇ ਕੁੰਦਣੀ ਪ੍ਰਥਮੈ ਕਰੋ ਉਚਾਰ ॥",
      "transliteration": "sukab bakatr te ku(n)dhanee prathamai karo uchaar ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਕਵੀਓ! ਪਹਿਲਾ ਮੂੰਹੋਂ 'ਕੁੰਦਣੀ' ਸ਼ਬਦ ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "सुकबि बकत्र ते कुँदणी प्रथमै करो उचार ॥",
      "sourceLineId": "107570",
      "sourceShabadId": "9496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਹੋਤ ਹੈ ਲੀਜਹੁ ਸੁਮਤਿ ਸਵਾਰ ॥੭੧੬॥",
      "transliteration": "naam tupak ke hot hai leejahu sumat savaar ||716||",
      "translation": "O good poet, utter the word “Kundani” from your mouth, from which the names of Tupak are formed correctly.716.",
      "punjabiViakhya": "(ਇਹ) ਤੁਪਕ ਦਾ ਨਾਮ ਹੈ। ਸਾਰੇ ਸਿਆਣੇ ਵਿਚਾਰ ਕਰ ਲਵੋ ॥੭੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के होत है लीजहु सुमति सवार ॥७१६॥",
      "sourceLineId": "107571",
      "sourceShabadId": "9496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "107572",
      "sourceShabadId": "9497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਾਸਟ ਕੁੰਦਨੀ ਆਦਿ ਉਚਾਰਨ ਕੀਜੀਐ ॥",
      "transliteration": "kaasaT ku(n)dhanee aadh uchaaran keejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਕਾਸਟ ਕੁੰਦਨੀ' ਸ਼ਬਦ ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "कासट कुँदनी आदि उचारन कीजीऐ ॥",
      "sourceLineId": "107573",
      "sourceShabadId": "9497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਚੀਨ ਚਤੁਰ ਚਿਤ ਲੀਜੀਐ ॥",
      "transliteration": "naam tupak ke cheen chatur chit leejeeaai ||",
      "translation": "The names of Tupak are recognized by uttering the words “Kaashth-Kundani”",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਕੇ ਚਿਤ ਵਿਚ ਰਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के चीन चतुर चित लीजीऐ ॥",
      "sourceLineId": "107574",
      "sourceShabadId": "9497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬ੍ਰਿਛਜ ਬਾਸਨੀ ਸਬਦ ਬਕਤ੍ਰ ਤੇ ਭਾਖੀਐ ॥",
      "transliteration": "birachhaj baasanee sabadh bakatr te bhaakheeaai ||",
      "translation": "",
      "punjabiViakhya": "ਮੂੰਹ ਤੋਂ 'ਬ੍ਰਿਛਜ ਬਾਸਨੀ' ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "बृछज बासनी सबद बकत्र ते भाखीऐ ॥",
      "sourceLineId": "107575",
      "sourceShabadId": "9497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹੋ ਨਾਮ ਤੁਪਕ ਕੇ ਜਾਨਿ ਹ੍ਰਿਦੈ ਮੈ ਰਾਖੀਐ ॥੭੧੭॥",
      "transliteration": "ho naam tupak ke jaan hiradhai mai raakheeaai ||717||",
      "translation": "Saying the words “Vraksh-jawaasini” from the mouth, the names of Tupak are know in the heart.717.",
      "punjabiViakhya": "(ਇਹ) ਨਾਮ ਤੁਪਕ ਦਾ ਹੈ, ਹਿਰਦੇ ਵਿਚ ਵਸਾ ਲਵੋ ॥੭੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "हो नाम तुपक के जानि हृदै मै राखीऐ ॥७१७॥",
      "sourceLineId": "107576",
      "sourceShabadId": "9497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਧਰਏਸ ਰਜਾ ਸਬਦ ਸੁ ਅੰਤਿ ਬਖਾਨੀਐ ॥",
      "transliteration": "dhares rajaa sabadh su a(n)t bakhaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਧਰਏਸ' ਅਤੇ ਅੰਤ ਉਤੇ 'ਰਜਾ' ਨੂੰ ਬਖਾਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 751,
      "hindi": "",
      "hindiTransliteration": "धरएस रजा सबद सु अंति बखानीऐ ॥",
      "sourceLineId": "107577",
      "sourceShabadId": "9497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0751_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਕੁੰਦਨੀ ਬਹੁਰਿ ਪਦ ਠਾਨੀਐ ॥",
      "transliteration": "taa paachhe ku(n)dhanee bahur padh Thaaneeaai ||",
      "translation": "Saying the words “Dhar-Ishwarjaa” and then adding the word “Kundani” after it,",
