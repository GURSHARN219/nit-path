{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 753,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0753_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਊਫੰਗ ਨਾਮ ਪਛਾਨ ॥",
      "transliteration": "tuoofa(n)g naam pachhaan ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਤੁਫੰਗ ਦਾ ਨਾਮ ਵਿਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "तऊफंग नाम पछान ॥",
      "sourceLineId": "107627",
      "sourceShabadId": "9501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਹੀ ਭੇਦ ਯਾ ਮਹਿ ਮਾਨ ॥੭੨੯॥",
      "transliteration": "nahee bhedh yaa meh maan ||729||",
      "translation": "Recognise the names of Tupak (Tuphang) without any discrimination by firstly uttering the word “Maragraaj” and then adding the word “Ari”.729.",
      "punjabiViakhya": "ਇਸ ਵਿਚ ਕੋਈ ਭੇਦ ਨਾ ਸਮਝੋ ॥੭੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "नही भेद या महि मान ॥७२९॥",
      "sourceLineId": "107628",
      "sourceShabadId": "9501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "107629",
      "sourceShabadId": "9502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਆਦਿ ਸਬਦ ਮ੍ਰਿਗਰਾਜ ਉਚਾਰੋ ॥",
      "transliteration": "aadh sabadh miragaraaj uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਮ੍ਰਿਗਰਾਜ' ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "आदि सबद मृगराज उचारो ॥",
      "sourceLineId": "107630",
      "sourceShabadId": "9502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਰਿਪੁ ਪਦ ਦੈ ਡਾਰੋ ॥",
      "transliteration": "taa paachhe rip padh dhai ddaaro ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਪਿਤੋਂ 'ਰਿਪੁ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "ता पाछे रिपु पद दै डारो ॥",
      "sourceLineId": "107631",
      "sourceShabadId": "9502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਪਛਾਨੋ ॥",
      "transliteration": "naam tupak ke sakal pachhaano ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ (ਇਸ ਨੂੰ) ਤੁਪਕ ਦੇ ਨਾਮ ਵਜੋਂ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल पछानो ॥",
      "sourceLineId": "107632",
      "sourceShabadId": "9502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਯਾ ਮੈ ਕਛੂ ਭੇਦ ਨਹੀ ਜਾਨੋ ॥੭੩੦॥",
      "transliteration": "yaa mai kachhoo bhedh nahee jaano ||730||",
      "translation": "Comprehend all the names of Tupak by adding the word “Ripu” with the word “Mragraaj” and do not consider any mystery in it.730.",
      "punjabiViakhya": "ਇਸ ਵਿਚ ਕੋਈ ਭੇਦ ਨਾ ਸਮਝੋ ॥੭੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "या मै कछू भेद नही जानो ॥७३०॥",
      "sourceLineId": "107633",
      "sourceShabadId": "9502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪਸੁ ਪਤੇਸ ਪਦ ਪ੍ਰਥਮ ਭਨਿਜੈ ॥",
      "transliteration": "pas pates padh pratham bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਪਸੁ ਪਤੇਸ' (ਹਾਥੀਆਂ ਦਾ ਰਾਜਾ, ਸ਼ੇਰ) ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "पसु पतेस पद प्रथम भनिजै ॥",
      "sourceLineId": "107634",
      "sourceShabadId": "9502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਾ ਪਾਛੈ ਅਰਿ ਪਦ ਕੋ ਦਿਜੈ ॥",
      "transliteration": "taa paachhai ar padh ko dhijai ||",
      "translation": "Comprehend all the names of Tupak by firstly uttering “Pashupatesh”",
      "punjabiViakhya": "ਫਿਰ 'ਅਰਿ' ਪਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "ता पाछै अरि पद को दिजै ॥",
      "sourceLineId": "107635",
      "sourceShabadId": "9502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਜੀਅ ਜਾਨੋ ॥",
      "transliteration": "naam tupak ke sabh jeea jaano ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ जीअ जानो ॥",
      "sourceLineId": "107636",
      "sourceShabadId": "9502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਯਾ ਮੈ ਕਛੂ ਭੇਦ ਨਹੀ ਮਾਨੋ ॥੭੩੧॥",
      "transliteration": "yaa mai kachhoo bhedh nahee maano ||731||",
      "translation": "And then adding the word “Ari”  do not consider any mystery in it.731.",
      "punjabiViakhya": "ਇਸ ਵਿਚ ਕੋਈ ਫਰਕ ਨਾ ਸਮਝੋ ॥੭੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "या मै कछू भेद नही मानो ॥७३१॥",
      "sourceLineId": "107637",
      "sourceShabadId": "9502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "107638",
      "sourceShabadId": "9503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਕਲ ਪਸੁਨ ਕੇ ਨਾਮ ਲੈ ਸਤ੍ਰੁ ਸਬਦ ਕਹਿ ਅੰਤਿ ॥",
      "transliteration": "sakal pasun ke naam lai satr sabadh keh a(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਪਸ਼ੂਆਂ ਦਾ ਨਾਮ ਲੈ ਕੇ, ਅੰਤ ਵਿਚ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "सकल पसुन के नाम लै सत्रु सबद कहि अंति ॥",
      "sourceLineId": "107639",
      "sourceShabadId": "9503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਭ ਹੀ ਨਾਮ ਤੁਫੰਗ ਕੇ ਨਿਕਸਤ ਚਲਤ ਅਨੰਤ ॥੭੩੨॥",
      "transliteration": "sabh hee naam tufa(n)g ke nikasat chalat ana(n)t ||732||",
      "translation": "Naming all the animals and then adding the word “Shatru” at the end, all the names of Tupak continue to be evolved.732.",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਸਾਰੇ ਤੁਪਕ ਦੇ ਨਾਮ ਬਣਦੇ ਚਲੇ ਜਾਣਗੇ ॥੭੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "सभ ही नाम तुफंग के निकसत चलत अनंत ॥७३२॥",
      "sourceLineId": "107640",
      "sourceShabadId": "9503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮ੍ਰਿਗ ਪਦ ਆਦਿ ਬਖਾਨਿ ਕੈ ਪਤਿ ਪਦ ਬਹੁਰਿ ਉਚਾਰ ॥",
      "transliteration": "mirag padh aadh bakhaan kai pat padh bahur uchaar ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਮ੍ਰਿਗ' (ਪਸ਼ੁ) ਸ਼ਬਦ ਕਹਿ ਕੇ ਫਿਰ 'ਪਤਿ' ਪਦ ਰਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "मृग पद आदि बखानि कै पति पद बहुरि उचार ॥",
      "sourceLineId": "107641",
      "sourceShabadId": "9503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਰਿ ਕਹਿ ਨਾਮ ਤੁਫੰਗ ਕੇ ਲੀਜੈ ਸੁਕਬਿ ਸੁ ਧਾਰ ॥੭੩੩॥",
      "transliteration": "ar keh naam tufa(n)g ke leejai sukab su dhaar ||733||",
      "translation": "Saying the word “Mrag” in the beginning and then uttering the word “Pati” and afterwards adding the word “Ari”, comprehend the names of Tupak (Tuphang) correctly.733.",
      "punjabiViakhya": "ਫਿਰ 'ਅਰਿ' ਸ਼ਬਦ ਕਹੋ। (ਇਹ) ਨਾਮ ਤੁਫੰਗ ਦਾ ਹੈ। ਕਵੀਓ! ਵਿਚਾਰ ਲਵੋ ॥੭੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "अरि कहि नाम तुफंग के लीजै सुकबि सु धार ॥७३३॥",
      "sourceLineId": "107642",
      "sourceShabadId": "9503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਛੰਦ ॥",
      "transliteration": "chha(n)dh ||",
      "translation": "CHHAND",
      "punjabiViakhya": "ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "छंद ॥",
      "sourceLineId": "107643",
      "sourceShabadId": "9504",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮ੍ਰਿਗ ਸਬਦ ਆਦਿ ਬਖਾਨ ॥",
      "transliteration": "mirag sabadh aadh bakhaan ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੁਰੂ ਵਿਚ 'ਮ੍ਰਿਗ' ਸ਼ਬਦ ਬਖਾਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "मृग सबद आदि बखान ॥",
      "sourceLineId": "107644",
      "sourceShabadId": "9504",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪਾਛੈ ਸੁ ਪਤਿ ਪਦ ਠਾਨ ॥",
      "transliteration": "paachhai su pat padh Thaan ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਿਛੋਂ 'ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "पाछै सु पति पद ठान ॥",
      "sourceLineId": "107645",
      "sourceShabadId": "9504",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਿਪੁ ਸਬਦ ਬਹੁਰਿ ਉਚਾਰ ॥",
      "transliteration": "rip sabadh bahur uchaar ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਰਿਪੁ' ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "रिपु सबद बहुरि उचार ॥",
      "sourceLineId": "107646",
      "sourceShabadId": "9504",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਭ ਨਾਮ ਤੁਪਕ ਬਿਚਾਰ ॥੭੩੪॥",
      "transliteration": "sabh naam tupak bichaar ||734||",
      "translation": "Saying firstly the word “Mrag” and then uttering the words “Pati” and “Ripu”, all the names of Tupak are comprehended.734.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਵਿਚਾਰੋ ॥੭੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "सभ नाम तुपक बिचार ॥७३४॥",
      "sourceLineId": "107647",
      "sourceShabadId": "9504",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਿੰਗੀ ਪ੍ਰਿਥਮ ਪਦ ਭਾਖੁ ॥",
      "transliteration": "si(n)gee piratham padh bhaakh ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸਿੰਗੀ' ਪਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "सिंगी पृथम पद भाखु ॥",
      "sourceLineId": "107648",
      "sourceShabadId": "9504",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਰਿ ਸਬਦ ਕਹਿ ਲਖਿ ਰਾਖੁ ॥",
      "transliteration": "ar sabadh keh lakh raakh ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਅਰਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "अरि सबद कहि लखि राखु ॥",
      "sourceLineId": "107649",
      "sourceShabadId": "9504",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਰਿ ਸਬਦ ਬਹੁਰਿ ਬਖਾਨ ॥",
      "transliteration": "ar sabadh bahur bakhaan ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਅਰਿ' ਸ਼ਬਦ ਰਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "अरि सबद बहुरि बखान ॥",
      "sourceLineId": "107650",
      "sourceShabadId": "9504",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਭ ਨਾਮ ਤੁਪਕ ਪਛਾਨ ॥੭੩੫॥",
      "transliteration": "sabh naam tupak pachhaan ||735||",
      "translation": "The names of Tupak are recognized by uttering firstly the word “Sharangi” (deer) and then adding the words “Ari” and Ari”.735.",
      "punjabiViakhya": "ਸਭ ਨਾਮ ਤੁਪਕ ਦੇ ਹੋ ਜਾਦੇ ਹਨ ॥੭੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "सभ नाम तुपक पछान ॥७३५॥",
      "sourceLineId": "107651",
      "sourceShabadId": "9504",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਛੰਦ ਵਡਾ ॥",
      "transliteration": "chha(n)dh vaddaa ||",
      "translation": "CHHAND BARAA",
      "punjabiViakhya": "ਛੰਦ ਵੱਡਾ",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "छंद वडा ॥",
      "sourceLineId": "107652",
      "sourceShabadId": "9505",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪਤਿ ਸਬਦ ਆਦਿ ਉਚਾਰਿ ਕੈ ਮ੍ਰਿਗ ਸਬਦ ਬਹੁਰਿ ਬਖਾਨੀਐ ॥",
      "transliteration": "pat sabadh aadh uchaar kai mirag sabadh bahur bakhaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਪਤਿ' ਸ਼ਬਦ ਉਚਾਰ ਕੇ ਫਿਰ 'ਮ੍ਰਿਗ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "पति सबद आदि उचारि कै मृग सबद बहुरि बखानीऐ ॥",
      "sourceLineId": "107653",
      "sourceShabadId": "9505",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਰਿ ਸਬਦ ਬਹੁਰਿ ਉਚਾਰ ਕੈ ਨਾਮ ਤੁਪਕ ਪਹਿਚਾਨੀਐ ॥",
      "transliteration": "ar sabadh bahur uchaar kai naam tupak pahichaaneeaai ||",
      "translation": "Utter primarily the word “Pati” and then word “Mrag” and afterwards adding the word “Ari”, recognize the names of Tupak",
      "punjabiViakhya": "ਫਿਰ 'ਅਰਿ' ਸ਼ਬਦ ਉਚਾਰ ਕੇ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "अरि सबद बहुरि उचार कै नाम तुपक पहिचानीऐ ॥",
      "sourceLineId": "107654",
      "sourceShabadId": "9505",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਹੀ ਭੇਦ ਯਾ ਮੈ ਨੈਕੁ ਹੈ ਸਭ ਸੁਕਬਿ ਮਾਨਹੁ ਚਿਤ ਮੈ ॥",
      "transliteration": "nahee bhedh yaa mai naik hai sabh sukab maanahu chit mai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਵਿਚ ਕਿਸ ਪ੍ਰਕਾਰ ਦਾ ਕੋਈ ਸੰਸਾ ਨਹੀਂ ਹੈ, ਸਾਰੇ ਕਵੀ ਮਨ ਵਿਚ ਵਿਚਾਰ ਕਰ ਲੈਣ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "नही भेद या मै नैकु है सभ सुकबि मानहु चित मै ॥",
      "sourceLineId": "107655",
      "sourceShabadId": "9505",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਹ ਜਾਨੀਐ ਤਹ ਦੀਜੀਐ ਪਦ ਅਉਰ ਛੰਦ ਕਬਿਤ ਮੈ ॥੭੩੬॥",
      "transliteration": "jeh jaaneeaai teh dheejeeaai padh aaur chha(n)dh kabit mai ||736||",
      "translation": "O good poets! there is no mystery in it and use this word anywhere in KABIT stanza.736.",
      "punjabiViakhya": "ਜਿਥੇ ਚਾਹੋ, ਪਦ ਜਾ ਕਬਿੱਤ ਜਾ ਛੰਦ ਵਿਚ ਜੋੜ ਦਿਓ ॥੭੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "जह जानीऐ तह दीजीऐ पद अउर छंद कबित मै ॥७३६॥",
      "sourceLineId": "107656",
      "sourceShabadId": "9505",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "107657",
      "sourceShabadId": "9506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਹਰਣ ਸਬਦ ਕੋ ਆਦਿ ਭਣਿਜੈ ॥",
      "transliteration": "haran sabadh ko aadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਹਰਣ' ਸ਼ਬਦ ਦਾ ਵਰਣਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "हरण सबद को आदि भणिजै ॥",
      "sourceLineId": "107658",
      "sourceShabadId": "9506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਪਤਿ ਪਦ ਕੋ ਦਿਜੈ ॥",
      "transliteration": "taa paachhe pat padh ko dhijai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "ता पाछे पति पद को दिजै ॥",
      "sourceLineId": "107659",
      "sourceShabadId": "9506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਅਰਿ ਸਬਦ ਉਚਾਰੋ ॥",
      "transliteration": "taa paachhe ar sabadh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਅਰਿ' ਸ਼ਬਦ ਦਾ ਉਚਾਰਣ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "ता पाछे अरि सबद उचारो ॥",
      "sourceLineId": "107660",
      "sourceShabadId": "9506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਬਿਚਾਰੋ ॥੭੩੭॥",
      "transliteration": "naam tupak ke sakal bichaaro ||737||",
      "translation": "Saying firstly the word “Hiran”, then the word “Pati” and after wards uttering the word “Ari”, think about all the names of Tupak.737.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਾਰੇ ਤੁਪਕ ਦਾ ਨਾਮ ਕਰ ਕੇ ਸਮਝੋ ॥੭੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल बिचारो ॥७३७॥",
      "sourceLineId": "107661",
      "sourceShabadId": "9506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਿੰਗੀ ਆਦਿ ਉਚਾਰਨ ਕੀਜੈ ॥",
      "transliteration": "si(n)gee aadh uchaaran keejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸਿੰਗੀ' ਸ਼ਬਦ ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "सिंगी आदि उचारन कीजै ॥",
      "sourceLineId": "107662",
      "sourceShabadId": "9506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਪਤਿ ਪਦ ਕਹੁ ਦੀਜੈ ॥",
      "transliteration": "taa paachhe pat padh kahu dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਪਿਛੋਂ 'ਪਤਿ' ਸ਼ਬਦ ਨੂੰ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "ता पाछे पति पद कहु दीजै ॥",
      "sourceLineId": "107663",
      "sourceShabadId": "9506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕਹੁ ਬਹੁਰਿ ਬਖਾਨੋ ॥",
      "transliteration": "satr sabadh kahu bahur bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਬਖਾਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद कहु बहुरि बखानो ॥",
      "sourceLineId": "107664",
      "sourceShabadId": "9506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਪਛਾਨੋ ॥੭੩੮॥",
      "transliteration": "naam tupak ke sakal pachhaano ||738||",
      "translation": "Recognise all the names of Tupak by uttering the words “Shrangi” and then adding the words “Pati” and “Shatru”.738.",
      "punjabiViakhya": "ਸਭ ਲੋਗ (ਇਸ ਨੂੰ) ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੭੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल पछानो ॥७३८॥",
      "sourceLineId": "107665",
      "sourceShabadId": "9506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕ੍ਰਿਸਨਾਜਿਨ ਪਦ ਆਦਿ ਉਚਾਰੋ ॥",
      "transliteration": "kirasanaajin padh aadh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਕ੍ਰਿਸਨਾਜਿਨ' (ਕਾਲਾ ਚਿੱਟਾ ਹਿਰਨ) ਪਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "कृसनाजिन पद आदि उचारो ॥",
      "sourceLineId": "107666",
      "sourceShabadId": "9506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਪਤਿ ਪਦ ਦੈ ਡਾਰੋ ॥",
      "transliteration": "taa paachhe pat padh dhai ddaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "ता पाछे पति पद दै डारो ॥",
      "sourceLineId": "107667",
      "sourceShabadId": "9506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਪਹਿਚਾਨੋ ॥",
      "transliteration": "naam tupak ke sabh pahichaano ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਸਾਰੇ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ पहिचानो ॥",
      "sourceLineId": "107668",
      "sourceShabadId": "9506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਯਾ ਮੈ ਭੇਦ ਨ ਕੋਊ ਜਾਨੋ ॥੭੩੯॥",
      "transliteration": "yaa mai bhedh na kouoo jaano ||739||",
      "translation": "After uttering the word “Krishan-Arjun”, add the word “Pati”  then recognize the names of Tupak without any difference.739.",
      "punjabiViakhya": "ਇਸ ਵਿਚ ਕੋਈ ਅੰਤਰ ਨਾ ਮੰਨੋ ॥੭੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "या मै भेद न कोऊ जानो ॥७३९॥",
      "sourceLineId": "107669",
      "sourceShabadId": "9506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "107670",
      "sourceShabadId": "9507",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨੈਨੋਤਮ ਪਦ ਬਕਤ੍ਰ ਤੇ ਪ੍ਰਥਮੈ ਕਰੋ ਉਚਾਰ ॥",
      "transliteration": "nainotam padh bakatr te prathamai karo uchaar ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਮੂੰਹ ਤੋਂ 'ਨੈਨੋਤਮ' (ਉਤਮ ਨੈਣਾ ਵਾਲਾ ਹਿਰਨ) ਸ਼ਬਦ ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "नैनोतम पद बकत्र ते प्रथमै करो उचार ॥",
      "sourceLineId": "107671",
      "sourceShabadId": "9507",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪਤਿ ਅਰਿ ਕਹਿ ਕਰ ਤੁਪਕ ਕੇ ਲੀਜੋ ਨਾਮ ਸੁ ਧਾਰ ॥੭੪੦॥",
      "transliteration": "pat ar keh kar tupak ke leejo naam su dhaar ||740||",
      "translation": "Utter firstly from your mouth the word “Nayanotam” and then saying the words “Pati Ari”, comprehend all the names of Tupak.740.",
      "punjabiViakhya": "ਫਿਰ 'ਪਤਿ' ਅਤੇ 'ਅਰਿ' ਸ਼ਬਦ ਕਹਿ ਕੇ ਤੁਪਕ ਦਾ ਨਾਮ ਯਾਦ ਰਖ ਲਵੋ ॥੭੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "पति अरि कहि कर तुपक के लीजो नाम सु धार ॥७४०॥",
      "sourceLineId": "107672",
      "sourceShabadId": "9507",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "107673",
      "sourceShabadId": "9508",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0753_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸ੍ਵੇਤਾਸ੍ਵੇਤ ਤਨਿ ਆਦਿ ਉਚਾਰੋ ॥",
      "transliteration": "savaietaasavaiet tan aadh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸ੍ਵੇਤਾਸ੍ਵੇਤ ਤਨਿ' (ਕਾਲੇ ਚਿੱਟੇ ਰੰਗ ਵਾਲਾ, ਹਿਰਨ) ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 753,
      "hindi": "",
      "hindiTransliteration": "स्वेतास्वेत तनि आदि उचारो ॥",
      "sourceLineId": "107674",
      "sourceShabadId": "9508",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
