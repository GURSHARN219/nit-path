  "lines": [
    {
      "id": "dasam_ang_0755_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਮ ਤੁਫੰਗ ਚੀਨ ਚਿਤਿ ਲੀਜੈ ॥੭੪੬॥",
      "transliteration": "naam tufa(n)g cheen chit leejai ||746||",
      "translation": "And in this way recognize the names of Tupak in your mind.746.",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਚਿਤ ਵਿਚ ਤੁਫੰਗ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ ॥੭੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 755,
      "hindi": "",
      "hindiTransliteration": "नाम तुफंग चीन चिति लीजै ॥७४६॥",
      "sourceLineId": "107699",
      "sourceShabadId": "9510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0755_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨੈਨੋਤਮ ਪਦ ਆਦਿ ਉਚਾਰੋ ॥",
      "transliteration": "nainotam padh aadh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਨੈਨੋਤਮ' (ਉਤਮ ਨੈਣਾ ਵਾਲਾ ਹਿਰਨ) ਪਦ ਸ਼ੁਰੂ ਵਿਚ ਰਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 755,
      "hindi": "",
      "hindiTransliteration": "नैनोतम पद आदि उचारो ॥",
      "sourceLineId": "107700",
      "sourceShabadId": "9510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0755_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਾਇਕ ਪਦ ਪਾਛੇ ਦੇ ਡਾਰੋ ॥",
      "transliteration": "naik padh paachhe dhe ddaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 755,
      "hindi": "",
      "hindiTransliteration": "नाइक पद पाछे दे डारो ॥",
      "sourceLineId": "107701",
      "sourceShabadId": "9510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0755_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕਹੁ ਬਹੁਰਿ ਬਖਾਨੋ ॥",
      "transliteration": "satr sabadh kahu bahur bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਬਖਾਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 755,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद कहु बहुरि बखानो ॥",
      "sourceLineId": "107702",
      "sourceShabadId": "9510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0755_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਜੀਅ ਜਾਨੋ ॥੭੪੭॥",
      "transliteration": "naam tupak ke sabh jeea jaano ||747||",
      "translation": "Saying the word “Nayanotam”, add the words “Nayak” and “Shatru”, then recognize the names of Tupak in your mind.747.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੭੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 755,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ जीअ जानो ॥७४७॥",
      "sourceLineId": "107703",
      "sourceShabadId": "9510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0755_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਦ੍ਰਿਗੀ ਸਬਦ ਕੋ ਆਦਿ ਬਖਾਨੋ ॥",
      "transliteration": "dhiragee sabadh ko aadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਦ੍ਰਿਗੀ' (ਸੁੰਦਰ ਅੱਖਾ ਵਾਲਾ ਹਿਰਨ) ਨੂੰ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 755,
      "hindi": "",
      "hindiTransliteration": "दृगी सबद को आदि बखानो ॥",
      "sourceLineId": "107704",
      "sourceShabadId": "9510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0755_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਨਾਇਕ ਪਦ ਠਾਨੋ ॥",
      "transliteration": "taa paachhe naik padh Thaano ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਿਛੋਂ 'ਨਾਇਕ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 755,
      "hindi": "",
      "hindiTransliteration": "ता पाछे नाइक पद ठानो ॥",
      "sourceLineId": "107705",
      "sourceShabadId": "9510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0755_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕਹੁ ਬਹੁਰੋ ਦੀਜੈ ॥",
      "transliteration": "satr sabadh kahu bahuro dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਰਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 755,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद कहु बहुरो दीजै ॥",
      "sourceLineId": "107706",
      "sourceShabadId": "9510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0755_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਮ ਤੁਫੰਗ ਚੀਨ ਚਿਤਿ ਲੀਜੈ ॥੭੪੮॥",
      "transliteration": "naam tufa(n)g cheen chit leejai ||748||",
      "translation": "Saying firstly the word “Mrigi”, then add the words “Nayak” and “Shatru”, then recognize the names of Tupak in your mind.748.",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ ॥੭੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 755,
      "hindi": "",
      "hindiTransliteration": "नाम तुफंग चीन चिति लीजै ॥७४८॥",
      "sourceLineId": "107707",
      "sourceShabadId": "9510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0755_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚਖੀ ਸਬਦ ਕੋ ਆਦਿ ਉਚਾਰੋ ॥",
      "transliteration": "chakhee sabadh ko aadh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਚਖੀ' (ਸੋਹਣੀਆਂ ਅੱਖਾ ਵਾਲਾ ਹਿਰਨ) ਸ਼ਬਦ ਦਾ ਪਹਿਲਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 755,
      "hindi": "",
      "hindiTransliteration": "चखी सबद को आदि उचारो ॥",
      "sourceLineId": "107708",
      "sourceShabadId": "9510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0755_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਪਤਿ ਪਦ ਦੇ ਡਾਰੋ ॥",
      "transliteration": "taa paachhe pat padh dhe ddaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 755,
      "hindi": "",
      "hindiTransliteration": "ता पाछे पति पद दे डारो ॥",
      "sourceLineId": "107709",
      "sourceShabadId": "9510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0755_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਬਖਾਨੋ ॥",
      "transliteration": "satr sabadh ko bahur bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਬਖਾਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 755,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि बखानो ॥",
      "sourceLineId": "107710",
      "sourceShabadId": "9510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0755_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਕੇ ਜਾਨੋ ॥੭੪੯॥",
      "transliteration": "sabh sree naam tupak ke jaano ||749||",
      "translation": "Comprehend the names of Tupak by firstly saying the word “Chakkhi” and then adding the words “Ripu” and “Shatru”.749.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੭੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 755,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक के जानो ॥७४९॥",
      "sourceLineId": "107711",
      "sourceShabadId": "9510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0755_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮ੍ਰਿਗੀ ਅਧਿਪ ਕੋ ਆਦਿ ਉਚਾਰੋ ॥",
      "transliteration": "miragee adhip ko aadh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਮ੍ਰਿਗੀ ਅਧਿਪ' (ਹਿਰਨੀ ਦਾ ਪਤੀ, ਹਿਰਨ) ਨੂੰ ਪਹਿਲਾ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 755,
      "hindi": "",
      "hindiTransliteration": "मृगी अधिप को आदि उचारो ॥",
      "sourceLineId": "107712",
      "sourceShabadId": "9510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0755_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਪਤਿ ਪਦ ਦੇ ਡਾਰੋ ॥",
      "transliteration": "taa paachhe pat padh dhe ddaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਪਤਿ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 755,
      "hindi": "",
      "hindiTransliteration": "ता पाछे पति पद दे डारो ॥",
      "sourceLineId": "107713",
