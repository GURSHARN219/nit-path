  "lines": [
    {
      "id": "dasam_ang_0757_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤ੍ਰਿਣਰਿਪੁ ਆਦਿ ਉਚਾਰਿ ਕੈ ਪਤਿ ਰਿਪੁ ਅੰਤਿ ਉਚਾਰ ॥",
      "transliteration": "tiranarip aadh uchaar kai pat rip a(n)t uchaar ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਤ੍ਰਿਣਰਿਪੁ' ਪਦ ਕਹਿ ਕੇ, (ਫਿਰ) ਅੰਤ ਉਤੇ 'ਪਤਿ ਰਿਪੁ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "तृणरिपु आदि उचारि कै पति रिपु अंति उचार ॥",
      "sourceLineId": "107795",
      "sourceShabadId": "9517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਭ ਹੀ ਨਾਮ ਤੁਫੰਗ ਕੇ ਲੀਜਹੁ ਸੁਘਰ ਸੁਧਾਰ ॥੭੭੦॥",
      "transliteration": "sabh hee naam tufa(n)g ke leejahu sughar sudhaar ||770||",
      "translation": "Saying “Tran-ripu” and adding “Pati-ripu” at the end, comprehend correctly all the names of Tupak.770.",
      "punjabiViakhya": "(ਇਹ) ਨਾਮ ਤੁਫੰਗ ਦਾ ਹੈ, ਸਭ ਸਮਝਦਾਰੋ! ਵਿਚਾਰ ਲਵੋ ॥੭੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "सभ ही नाम तुफंग के लीजहु सुघर सुधार ॥७७०॥",
      "sourceLineId": "107796",
      "sourceShabadId": "9517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "107797",
      "sourceShabadId": "9518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤ੍ਰਿਣਰਿਪੁ ਆਦਿ ਉਚਾਰਨ ਕੀਜੈ ॥",
      "transliteration": "tiranarip aadh uchaaran keejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਤ੍ਰਿਣਰਿਪੁ' ਸ਼ਬਦ ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "तृणरिपु आदि उचारन कीजै ॥",
      "sourceLineId": "107798",
      "sourceShabadId": "9518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਨਾਇਕ ਪਦ ਦੀਜੈ ॥",
      "transliteration": "taa paachhe naik padh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਪਿਛੋਂ 'ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "ता पाछे नाइक पद दीजै ॥",
      "sourceLineId": "107799",
      "sourceShabadId": "9518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਉਚਾਰੋ ॥",
      "transliteration": "satr sabadh ko bahur uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि उचारो ॥",
      "sourceLineId": "107800",
      "sourceShabadId": "9518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਬਿਚਾਰੋ ॥੭੭੧॥",
      "transliteration": "naam tupak ke sakal bichaaro ||771||",
      "translation": "Utter firstly “Tran-ripu” and then add the word “Nayak” and “Shatru”, and in this way consider all the names of Tupak.771.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ ॥੭੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल बिचारो ॥७७१॥",
      "sourceLineId": "107801",
      "sourceShabadId": "9518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭੂਜਾਤਕ ਸਬਦਾਦਿ ਉਚਾਰੋ ॥",
      "transliteration": "bhoojaatak sabadhaadh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਭੂਜਾਤਕ' (ਘਾਹ ਨੂੰ ਖ਼ਤਮ ਕਰਨ ਵਾਲਾ, ਹਿਰਨ) ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "भूजातक सबदादि उचारो ॥",
      "sourceLineId": "107802",
      "sourceShabadId": "9518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਇਕ ਤਾ ਪਾਛੇ ਪਦ ਡਾਰੋ ॥",
      "transliteration": "naik taa paachhe padh ddaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "नाइक ता पाछे पद डारो ॥",
      "sourceLineId": "107803",
      "sourceShabadId": "9518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਭਣਿਜੈ ॥",
      "transliteration": "satr sabadh ko bahur bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि भणिजै ॥",
      "sourceLineId": "107804",
      "sourceShabadId": "9518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਮ ਤੁਫੰਗ ਚੀਨ ਚਿਤਿ ਲਿਜੈ ॥੭੭੨॥",
      "transliteration": "naam tufa(n)g cheen chit lijai ||772||",
      "translation": "Saying firstly the word “Bhujantak” and then adding the words “Nayak” and “Shatru”, recognize the names of Tupak in your mind.772.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਮਨ ਵਿਚ ਤੁਫੰਗ ਦਾ ਨਾਮ ਵਿਚਾਰ ਲਵੋ ॥੭੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "नाम तुफंग चीन चिति लिजै ॥७७२॥",
      "sourceLineId": "107805",
      "sourceShabadId": "9518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪ੍ਰਿਥੀਜ ਅਰਿ ਸਬਦਾਦਿ ਉਚਾਰੋ ॥",
      "transliteration": "piratheej ar sabadhaadh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਪ੍ਰਿਥੀਜ ਅਰਿ' (ਘਾਹ ਦਾ ਵੈਰੀ ਹਿਰਨ) ਸ਼ਬਦ ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "पृथीज अरि सबदादि उचारो ॥",
      "sourceLineId": "107806",
      "sourceShabadId": "9518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਨਾਇਕ ਪਦ ਡਾਰੋ ॥",
      "transliteration": "taa paachhe naik padh ddaaro ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਿਛੋਂ 'ਨਾਇਕ' ਸ਼ਬਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "ता पाछे नाइक पद डारो ॥",
      "sourceLineId": "107807",
      "sourceShabadId": "9518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਬਖਾਨੋ ॥",
      "transliteration": "satr sabadh ko bahur bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि बखानो ॥",
      "sourceLineId": "107808",
      "sourceShabadId": "9518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਪਹਿਚਾਨੋ ॥੭੭੩॥",
      "transliteration": "naam tupak ke sabh pahichaano ||773||",
      "translation": "Saying firstly the word “Prathvi-jaa-ari” and then uttering the words “Nayak” and “Shatru”, recognize all the names of Tupak.773.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਾਰੇ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੭੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ पहिचानो ॥७७३॥",
      "sourceLineId": "107809",
      "sourceShabadId": "9518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "107810",
      "sourceShabadId": "9519",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਭੂ ਸੁਤ ਰਿਪੁ ਸਬਦਾਦਿ ਬਖਾਨਨ ਕੀਜੀਐ ॥",
      "transliteration": "bhoo sut rip sabadhaadh bakhaanan keejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਭੂ ਸੁਤ ਰਿਪੁ' (ਭੂਮੀ ਦੇ ਪੈਦਾ ਕੀਤੇ ਘਾਹ ਦਾ ਵੈਰੀ, ਹਿਰਨ) ਸ਼ਬਦ ਨੂੰ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "भू सुत रिपु सबदादि बखानन कीजीऐ ॥",
      "sourceLineId": "107811",
      "sourceShabadId": "9519",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾ ਕੇ ਪਾਛੇ ਬਹੁਰਿ ਨਾਥ ਪਦ ਦੀਜੀਐ ॥",
      "transliteration": "taa ke paachhe bahur naath padh dheejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਉਸ ਪਿਛੋਂ 'ਨਾਥ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "ता के पाछे बहुरि नाथ पद दीजीऐ ॥",
      "sourceLineId": "107812",
      "sourceShabadId": "9519",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਤਾ ਕੇ ਅੰਤਿ ਉਚਾਰੀਐ ॥",
      "transliteration": "satr sabadh ko taa ke a(n)t uchaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਵਿਚ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को ता के अंति उचारीऐ ॥",
      "sourceLineId": "107813",
      "sourceShabadId": "9519",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹੋ ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪ੍ਰਬੀਨ ਬਿਚਾਰੀਐ ॥੭੭੪॥",
      "transliteration": "ho sakal tupak ke naam prabeen bichaareeaai ||774||",
      "translation": "Comprehend all the names of Tupak by saying the word “Bhu-sut-rup” and then adding the words “Naath Shatru”.774.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਾਰੇ ਪ੍ਰਬੀਨ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲੈਣ ॥੭੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "हो सकल तुपक के नाम प्रबीन बिचारीऐ ॥७७४॥",
      "sourceLineId": "107814",
      "sourceShabadId": "9519",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "107815",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਉਰਵਿਜ ਸਬਦ ਸੁ ਆਦਿ ਉਚਾਰੋ ॥",
      "transliteration": "auravij sabadh su aadh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਉਰਵਿਜ' (ਧਰਤੀ ਦਾ ਪੁੱਤਰ, ਘਾਹ) ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "उरविज सबद सु आदि उचारो ॥",
      "sourceLineId": "107816",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਿਪੁ ਨਾਇਕ ਪਾਛੇ ਪਦ ਡਾਰੋ ॥",
      "transliteration": "rip naik paachhe padh ddaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਰਿਪੁ ਨਾਇਕ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "रिपु नाइक पाछे पद डारो ॥",
      "sourceLineId": "107817",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਭਣਿਜੈ ॥",
      "transliteration": "satr sabadh ko bahur bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਵਰਣਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि भणिजै ॥",
      "sourceLineId": "107818",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਾਮ ਤੁਫੰਗ ਚੀਨ ਚਿਤਿ ਲਿਜੈ ॥੭੭੫॥",
      "transliteration": "naam tufa(n)g cheen chit lijai ||775||",
      "translation": "Utter the word “Urvij” and then add “Ripu-nayak”, then speak the word “Shatru” and recognize the names of Tupak.775.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਤੁਫੰਗ ਦਾ ਨਾਮ ਮਨ ਵਿਚ ਵਿਚਾਰ ਲਵੋ ॥੭੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "नाम तुफंग चीन चिति लिजै ॥७७५॥",
      "sourceLineId": "107819",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬੈਸੁੰਧਰਜਾ ਸਤ੍ਰੁ ਉਚਾਰੋ ॥",
      "transliteration": "baisu(n)dharajaa satr uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬੈਸੁੰਧਰਜਾ' (ਧਰਤੀ ਦਾ ਪੁੱਤਰ, ਘਾਹ) ਅਤੇ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "बैसुँधरजा सत्रु उचारो ॥",
      "sourceLineId": "107820",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਇਕ ਸਬਦ ਅੰਤਿ ਦੇ ਡਾਰੋ ॥",
      "transliteration": "nik sabadh a(n)t dhe ddaaro ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਤ ਵਿਚ 'ਨਾਇਕ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "नइक सबद अंति दे डारो ॥",
      "sourceLineId": "107821",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਉਚਰੀਐ ॥",
      "transliteration": "satr sabadh ko bahur uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि उचरीऐ ॥",
      "sourceLineId": "107822",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾਮ ਬੰਦੂਕ ਚਿਤ ਮੈ ਧਰੀਐ ॥੭੭੬॥",
      "transliteration": "naam ba(n)dhook chit mai dhareeaai ||776||",
      "translation": "Utter the word “Vasundraa-jaa-Shatru”, then add the words “Nayak” and “Shatru”, know in this way the names of Tupak (Bandook) in your mind.776.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਮਨ ਵਿਚ ਬੰਦੂਕ ਦਾ ਨਾਮ ਧਾਰਨ ਕਰੋ ॥੭੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "नाम बंदूक चित मै धरीऐ ॥७७६॥",
      "sourceLineId": "107823",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪੂਰਨਿ ਆਦਿ ਉਚਾਰਨ ਕੀਜੈ ॥",
      "transliteration": "pooran aadh uchaaran keejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਪੂਰਨਿ' (ਧਰਤੀ) ਸ਼ਬਦ ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "पूरनि आदि उचारन कीजै ॥",
      "sourceLineId": "107824",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਾ ਰਿਪੁ ਪਦ ਕੋ ਪਾਛੈ ਦੀਜੈ ॥",
      "transliteration": "jaa rip padh ko paachhai dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਿਛੋਂ 'ਜਾ ਰਿਪੁ' ਪਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "जा रिपु पद को पाछै दीजै ॥",
      "sourceLineId": "107825",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਬਖਾਨੋ ॥",
      "transliteration": "satr sabadh ko bahur bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਵਰਣਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि बखानो ॥",
      "sourceLineId": "107826",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਪਛਾਨੋ ॥੭੭੭॥",
      "transliteration": "naam tupak ke sakal pachhaano ||777||",
      "translation": "Saying the word “Purni”, add the words “Jaa, Ripu and Shatru” and recognize all the names of Tupak.777.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਪਛਾਣੋ ॥੭੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल पछानो ॥७७७॥",
      "sourceLineId": "107827",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦ੍ਵੀਪਨਿ ਆਦਿ ਸਬਦ ਕੋ ਦਿਜੈ ॥",
      "transliteration": "dhavaieepan aadh sabadh ko dhijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਦ੍ਵੀਪਨਿ' (ਸੱਤਾ ਦ੍ਵੀਪਾ ਵਾਲੀ ਧਰਤੀ) ਸ਼ਬਦ ਰਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "द्वीपनि आदि सबद को दिजै ॥",
      "sourceLineId": "107828",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਾ ਪਾਛੇ ਚਰ ਸਬਦ ਭਨਿਜੈ ॥",
      "transliteration": "jaa paachhe char sabadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਿਛੋਂ 'ਜਾ ਚਰ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "जा पाछे चर सबद भनिजै ॥",
      "sourceLineId": "107829",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਉਚਾਰੋ ॥",
      "transliteration": "satr sabadh ko bahur uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि उचारो ॥",
      "sourceLineId": "107830",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਸਵਾਰੋ ॥੭੭੮॥",
      "transliteration": "naam tupak ke sakal savaaro ||778||",
      "translation": "Saying firstly the word “Dvipani”, then utter the words “Char” and “Shatru”, and comprehend all the names of Tupak.778.",
      "punjabiViakhya": "ਸਭ (ਇਸ ਨੂੰ) ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੭੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल सवारो ॥७७८॥",
      "sourceLineId": "107831",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਿਸਟਨਿ ਪਦ ਕੋ ਆਦਿ ਉਚਾਰੋ ॥",
      "transliteration": "sisaTan padh ko aadh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸਿਸਟਨਿ' (ਸ੍ਰਿਸ਼ਟੀ) ਪਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "सिसटनि पद को आदि उचारो ॥",
      "sourceLineId": "107832",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਾ ਕਹਿ ਚਰ ਪਾਛੇ ਦੇ ਡਾਰੋ ॥",
      "transliteration": "jaa keh char paachhe dhe ddaaro ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਿਛੋਂ 'ਜਾ ਚਰ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "जा कहि चर पाछे दे डारो ॥",
      "sourceLineId": "107833",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਭਣਿਜੈ ॥",
      "transliteration": "satr sabadh ko bahur bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि भणिजै ॥",
      "sourceLineId": "107834",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਮ ਤੁਫੰਗ ਚੀਨ ਚਿਤ ਲਿਜੈ ॥੭੭੯॥",
      "transliteration": "naam tufa(n)g cheen chit lijai ||779||",
      "translation": "Saying firstly the word “Srishtani”, then add the words “Jaa” and “Shatru” and in this way recognize the names of Tupak in your mind.779.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਚਿਤ ਵਿਚ ਤੁਫੰਗ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ ॥੭੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "नाम तुफंग चीन चित लिजै ॥७७९॥",
      "sourceLineId": "107835",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਧਰਨਿ ਸਬਦ ਕੋ ਆਦਿ ਉਚਾਰੋ ॥",
      "transliteration": "dharan sabadh ko aadh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਧਰਨਿ' ਸ਼ਬਦ ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "धरनि सबद को आदि उचारो ॥",
      "sourceLineId": "107836",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਾ ਚਰ ਪਦ ਪਾਛੇ ਤਿਹਿ ਡਾਰੋ ॥",
      "transliteration": "jaa char padh paachhe teh ddaaro ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਛੋਂ 'ਜਾ ਚਰ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "जा चर पद पाछे तिहि डारो ॥",
      "sourceLineId": "107837",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "satr sabadh ko bahur bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि बखानहु ॥",
      "sourceLineId": "107838",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਕੇ ਜਾਨਹੁ ॥੭੮੦॥",
      "transliteration": "sabh sree naam tupak ke jaanahu ||780||",
      "translation": "Saying firstly the word “Dharni”, then add the words “Jaa”, “Char” and “Shatru” and in this way comprehend all the names of Tupak.780.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਲੋਗ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੭੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक के जानहु ॥७८०॥",
      "sourceLineId": "107839",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਧਰਾ ਸਬਦ ਕੋ ਆਦਿ ਬਖਾਨੋ ॥",
      "transliteration": "dharaa sabadh ko aadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਧਰਾ' ਸ਼ਬਦ ਨੂੰ ਸ਼ੁਰੂ ਵਿਚ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "धरा सबद को आदि बखानो ॥",
      "sourceLineId": "107840",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਾ ਚਰ ਪਦ ਪਾਛੇ ਤਿਹ ਠਾਨੋ ॥",
      "transliteration": "jaa char padh paachhe teh Thaano ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਿਛੋਂ 'ਜਾ ਚਰ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "जा चर पद पाछे तिह ठानो ॥",
      "sourceLineId": "107841",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0757_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਉਚਾਰੋ ॥",
      "transliteration": "satr sabadh ko bahur uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 757,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि उचारो ॥",
      "sourceLineId": "107842",
      "sourceShabadId": "9520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
