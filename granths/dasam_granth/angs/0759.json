  "lines": [
    {
      "id": "dasam_ang_0759_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਲ ਰਾਸਨਨੀ ਆਦਿ ਉਚਾਰਨ ਕੀਜੀਐ ॥",
      "transliteration": "jal raasananee aadh uchaaran keejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਜਲ ਰਾਸਨਨੀ' ਸ਼ਬਦ ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 759,
      "hindi": "",
      "hindiTransliteration": "जल रासननी आदि उचारन कीजीऐ ॥",
      "sourceLineId": "107891",
      "sourceShabadId": "9527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0759_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਾ ਚਰ ਨਾਇਕ ਪਦ ਤਿਹ ਪਾਛੇ ਦੀਜੀਐ ॥",
      "transliteration": "jaa char naik padh teh paachhe dheejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਿਛੋਂ 'ਜਾ ਚਰ ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 759,
      "hindi": "",
      "hindiTransliteration": "जा चर नाइक पद तिह पाछे दीजीऐ ॥",
      "sourceLineId": "107892",
      "sourceShabadId": "9527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0759_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਤ੍ਰੁ ਪਦ ਕੋ ਤਾ ਕੇ ਅੰਤਿ ਉਚਾਰੀਐ ॥",
      "transliteration": "satr padh ko taa ke a(n)t uchaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਅੰਤ ਉਤੇ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 759,
      "hindi": "",
      "hindiTransliteration": "सत्रु पद को ता के अंति उचारीऐ ॥",
      "sourceLineId": "107893",
      "sourceShabadId": "9527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0759_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹੋ ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਸੁਕਬਿ ਬਿਚਾਰੀਐ ॥੭੯੩॥",
      "transliteration": "ho sakal tupak ke naam sukab bichaareeaai ||793||",
      "translation": "Utter firstly the word “Jalraashinani”, then say the words “Jaa-char-nayak-shatru”  in this way consider all the names of Tupak.793.",
      "punjabiViakhya": "(ਇਹ) ਸਾਰਾ ਤੁਪਕ ਦਾ ਨਾਮ ਬਣਦਾ ਹੈ, ਕਵੀ ਲੋਗ ਵਿਚਾਰ ਲੈਣ ॥੭੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 759,
      "hindi": "",
      "hindiTransliteration": "हो सकल तुपक के नाम सुकबि बिचारीऐ ॥७९३॥",
      "sourceLineId": "107894",
      "sourceShabadId": "9527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0759_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 759,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "107895",
      "sourceShabadId": "9528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0759_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕੰਨਿਧਨੀ ਸਬਦਾਦਿ ਭਣਿਜੇ ॥",
      "transliteration": "ka(n)nidhanee sabadhaadh bhanije ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਕੰਨਿਧਨੀ' (ਜਲ ਵਾਲੀ ਧਰਤੀ) ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 759,
      "hindi": "",
      "hindiTransliteration": "कंनिधनी सबदादि भणिजे ॥",
      "sourceLineId": "107896",
      "sourceShabadId": "9528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0759_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਦਿਜੇ ॥",
      "transliteration": "jaa char keh naik padh dhije ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਜਾ ਚਰ ਨਾਇਕ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 759,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि नाइक पद दिजे ॥",
      "sourceLineId": "107897",
      "sourceShabadId": "9528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0759_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਅੰਤਿ ਉਚਾਰੋ ॥",
      "transliteration": "satr sabadh ko a(n)t uchaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਅੰਤ ਉਤੇ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 759,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को अंति उचारो ॥",
      "sourceLineId": "107898",
      "sourceShabadId": "9528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0759_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਬਿਚਾਰੋ ॥੭੯੪॥",
      "transliteration": "naam tupak ke sakal bichaaro ||794||",
      "translation": "Utter firstly “Kanidhani” and after “Jaa-char-nayak-shatu” and comprehend all the names of Tupak.794.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਾਰੇ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੭੯੪॥",
      "source": "DASAM_GRANTH",
      "ang": 759,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल बिचारो ॥७९४॥",
      "sourceLineId": "107899",
      "sourceShabadId": "9528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0759_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅੰਬੁਜਨੀ ਸਬਦਾਦਿ ਬਖਾਨੋ ॥",
      "transliteration": "a(n)bujanee sabadhaadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਅੰਬੁਜਨੀ' (ਧਰਤੀ) ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 759,
      "hindi": "",
      "hindiTransliteration": "अंबुजनी सबदादि बखानो ॥",
      "sourceLineId": "107900",
      "sourceShabadId": "9528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0759_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਠਾਨੋ ॥",
      "transliteration": "jaa char keh naik padh Thaano ||",
      "translation": "",
      "punjabiViakhya": "(ਅੰਤ ਉਤੇ) 'ਜਾ ਚਰ ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 759,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि नाइक पद ठानो ॥",
      "sourceLineId": "107901",
      "sourceShabadId": "9528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0759_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਭਣਿਜੈ ॥",
      "transliteration": "satr sabadh ko bahur bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 759,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि भणिजै ॥",
      "sourceLineId": "107902",
      "sourceShabadId": "9528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0759_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾਮ ਤੁਫੰਗ ਚੀਨ ਚਿਤਿ ਲਿਜੈ ॥੭੯੫॥",
      "transliteration": "naam tufa(n)g cheen chit lijai ||795||",
      "translation": "Utter firstly the word “Ambujanani”, then add “Jaa-char-nayak-shatru” and in this way comprehend the names of Tupak.795.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਤੁਫੰਗ ਦੇ ਨਾਮ ਵਜੋਂ ਮਨ ਵਿਚ ਸਮਝ ਲਵੋ ॥੭੯੫॥",
      "source": "DASAM_GRANTH",
      "ang": 759,
      "hindi": "",
      "hindiTransliteration": "नाम तुफंग चीन चिति लिजै ॥७९५॥",
      "sourceLineId": "107903",
      "sourceShabadId": "9528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0759_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਲਨੀ ਆਦਿ ਬਖਾਨਨ ਕੀਜੈ ॥",
      "transliteration": "jalanee aadh bakhaanan keejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਜਲਨੀ' (ਧਰਤੀ) ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 759,
      "hindi": "",
      "hindiTransliteration": "जलनी आदि बखानन कीजै ॥",
      "sourceLineId": "107904",
      "sourceShabadId": "9528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0759_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਾ ਚਰ ਪਤਿ ਪਾਛੈ ਪਦ ਦੀਜੈ ॥",
      "transliteration": "jaa char pat paachhai padh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਿਛੋਂ 'ਜਾ ਚਰ ਪਤਿ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 759,
      "hindi": "",
      "hindiTransliteration": "जा चर पति पाछै पद दीजै ॥",
