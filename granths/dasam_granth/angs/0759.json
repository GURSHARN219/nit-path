    },
    {
      "id": "dasam_ang_0759_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਪਛਾਨੋ ॥੭੯੬॥",
      "transliteration": "naam tupak ke sakal pachhaano ||796||",
      "translation": "Utter firstly the word “Jalni”, then add “Jaa-char-pati” and then add the word “Shatru” and recognize all the names of Tupak.796.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਲੋਗ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੭੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 759,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल पछानो ॥७९६॥",
      "sourceLineId": "107907",
      "sourceShabadId": "9528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
