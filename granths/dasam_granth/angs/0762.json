  "lines": [
    {
      "id": "dasam_ang_0762_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭਾਗੀਰਥਨੀ ਪਦ ਕੋ ਆਦਿ ਬਖਾਨੀਐ ॥",
      "transliteration": "bhaageerathanee padh ko aadh bakhaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਭਾਗੀਰਥਨੀ' (ਭਗੀਰਥ ਦੁਆਰਾ ਲਿਆਂਦੀ ਨਦੀ ਗੰਗਾ ਵਾਲੀ ਧਰਤੀ) ਪਦ ਨੂੰ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "भागीरथनी पद को आदि बखानीऐ ॥",
      "sourceLineId": "108011",
      "sourceShabadId": "9537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਬਹੁਰੋ ਠਾਨੀਐ ॥",
      "transliteration": "jaa char keh naik padh bahuro Thaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਜਾ ਚਰ ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि नाइक पद बहुरो ठानीऐ ॥",
      "sourceLineId": "108012",
      "sourceShabadId": "9537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਤਾ ਕੇ ਅੰਤਿ ਉਚਾਰੀਐ ॥",
      "transliteration": "satr sabadh ko taa ke a(n)t uchaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਸਤ੍ਰੁ' ਪਦ ਨੂੰ ਉਸ ਦੇ ਅੰਤ ਉਤੇ ਵਿਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को ता के अंति उचारीऐ ॥",
      "sourceLineId": "108013",
      "sourceShabadId": "9537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹੋ ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪ੍ਰਬੀਨ ਬਿਚਾਰੀਐ ॥੮੨੨॥",
      "transliteration": "ho sakal tupak ke naam prabeen bichaareeaai ||822||",
      "translation": "After firstly uttering the word “Bhaagirthani” and then saying words Jaachar-nayak and shatru at the end, and comprehend all the names of Tupak thoughtfully.822.",
      "punjabiViakhya": "(ਇਹ) ਤੁਪਕ ਦਾ ਨਾਮ ਬਣਦਾ ਹੈ। ਸਭ ਪ੍ਰਬੀਨੋ! ਵਿਚਾਰ ਲਵੋ ॥੮੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "हो सकल तुपक के नाम प्रबीन बिचारीऐ ॥८२२॥",
      "sourceLineId": "108014",
      "sourceShabadId": "9537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "108015",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਟਨਿਨਿ ਪਦ ਕੋ ਆਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "jaTanin padh ko aadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਜਟਨਿਨਿ' (ਜਟਾ ਤੋਂ ਨਿਕਲਣ ਵਾਲੀ ਨਦੀ ਗੰਗਾ ਵਾਲੀ ਧਰਤੀ) (ਸ਼ਬਦ) ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "जटनिनि पद को आदि उचरीऐ ॥",
      "sourceLineId": "108016",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਧਰੀਐ ॥",
      "transliteration": "jaa char keh naik padh dhareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਿਛੋਂ 'ਜਾ ਚਰ ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि नाइक पद धरीऐ ॥",
      "sourceLineId": "108017",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਬਖਾਨੋ ॥",
      "transliteration": "satr sabadh ko bahur bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि बखानो ॥",
      "sourceLineId": "108018",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਪ੍ਰਮਾਨੋ ॥੮੨੩॥",
      "transliteration": "naam tupak ke sakal pramaano ||823||",
      "translation": "Utter the words “Jaachar-nayak-shatru” after saying firstly the word “Jatnin” and know all the names of Tupak.823.",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਸਭ ਲੋਗ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੮੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल प्रमानो ॥८२३॥",
      "sourceLineId": "108019",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਦੀ ਰਾਟਨਿਨਿ ਆਦਿ ਬਖਾਨੋ ॥",
      "transliteration": "nadhee raaTanin aadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਨਦੀ ਰਾਟਨਿਨਿ' (ਸ਼ਬਦ) ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "नदी राटनिनि आदि बखानो ॥",
      "sourceLineId": "108020",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਪ੍ਰਮਾਨੋ ॥",
      "transliteration": "jaa char keh pat sabadh pramaano ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਜਾ ਚਰ ਨਾਇਕ' ਸ਼ਬਦ ਰਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति सबद प्रमानो ॥",
      "sourceLineId": "108021",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕਹੁ ਬਹੁਰਿ ਭਣੀਜੈ ॥",
      "transliteration": "satr sabadh kahu bahur bhaneejai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਨੂੰ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद कहु बहुरि भणीजै ॥",
      "sourceLineId": "108022",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾਮ ਤੁਫੰਗ ਜਾਨ ਜੀਅ ਲੀਜੈ ॥੮੨੪॥",
      "transliteration": "naam tufa(n)g jaan jeea leejai ||824||",
      "translation": "Saying firstly the word “Nadi-raatnin”, utter the words “Jaachar-pati an shatru” and know the names of Tupak.824.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਤੁਫੰਗ ਦਾ ਨਾਮ ਮਨ ਵਿਚ ਸਮਝ ਲਵੋ ॥੮੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "नाम तुफंग जान जीअ लीजै ॥८२४॥",
      "sourceLineId": "108023",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਭੀਖਮ ਜਨਨਿਨਿ ਆਦਿ ਬਖਾਨੋ ॥",
      "transliteration": "bheekham jananin aadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਭੀਖਮ ਜਨਨਿਨਿ' (ਗੰਗਾ ਵਾਲੀ ਧਰਤੀ) ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "भीखम जननिनि आदि बखानो ॥",
      "sourceLineId": "108024",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਪ੍ਰਮਾਨੋ ॥",
      "transliteration": "jaa char keh pat sabadh pramaano ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਜਾ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति सबद प्रमानो ॥",
      "sourceLineId": "108025",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਹੀ ਲਹੀਐ ॥",
      "transliteration": "naam tupak ke sabh hee laheeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ ही लहीऐ ॥",
      "sourceLineId": "108026",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਯਾ ਮੈ ਕਛੂ ਭੇਦ ਨਹੀ ਕਹੀਐ ॥੮੨੫॥",
      "transliteration": "yaa mai kachhoo bhedh nahee kaheeaai ||825||",
      "translation": "Saying firstly the word “Bhisham-janani” and then adding the words “Jaachar-pati”, know all the names of Tupak without any discrimination.825.",
      "punjabiViakhya": "ਇਸ ਵਿਚ ਕੋਈ ਭੇਦ ਦੀ ਗੱਲ ਨਾ ਕਹੋ ॥੮੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "या मै कछू भेद नही कहीऐ ॥८२५॥",
      "sourceLineId": "108027",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਦੀ ਈਸ੍ਰਨਿਨਿ ਆਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "nadhee ieesranin aadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਨਦੀ ਈਸ੍ਰਨਿਨਿ' (ਗੰਗਾ ਵਾਲੀ ਧਰਤੀ) ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "नदी ईस्रनिनि आदि उचरीऐ ॥",
      "sourceLineId": "108028",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਡਰੀਐ ॥",
      "transliteration": "jaa char keh naik padh ddareeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि नाइक पद डरीऐ ॥",
      "sourceLineId": "108029",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਬਖਾਨੋ ॥",
      "transliteration": "satr sabadh ko bahur bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि बखानो ॥",
      "sourceLineId": "108030",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਪਛਾਨੋ ॥੮੨੬॥",
      "transliteration": "naam tupak ke sakal pachhaano ||826||",
      "translation": "Utter firstly the word “Nadi-ishvarni” and then add “Jaachar-nayak-shatru”, then recognize all the names of Tupak.826.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਾਰੇ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ ॥੮੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल पछानो ॥८२६॥",
      "sourceLineId": "108031",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਦੀ ਰਾਜਨਿਨਿ ਆਦਿ ਬਖਾਨੋ ॥",
      "transliteration": "nadhee raajanin aadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਨਦੀ ਰਾਜਨਿਨਿ' (ਗੰਗਾ ਵਾਲੀ ਧਰਤੀ) ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "नदी राजनिनि आदि बखानो ॥",
      "sourceLineId": "108032",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਪ੍ਰਮਾਨੋ ॥",
      "transliteration": "jaa char keh pat sabadh pramaano ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਨਾਇਕ' ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति सबद प्रमानो ॥",
      "sourceLineId": "108033",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਬਹੁਰੋ ਮੁਖਿ ਭਾਖੁ ॥",
      "transliteration": "satr sabadh bahuro mukh bhaakh ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਮੁਖ ਤੋਂ ਬੋਲੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद बहुरो मुखि भाखु ॥",
      "sourceLineId": "108034",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਾਮ ਤੁਫੰਗ ਚੀਨਿ ਚਿਤਿ ਰਾਖੁ ॥੮੨੭॥",
      "transliteration": "naam tufa(n)g cheen chit raakh ||827||",
      "translation": "Utter the words “Jaachar-shatru” after saying the word “Nadiraajanani” and recognize the names of Tupak (Tuphang) in you mind.827.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਚਿਤ ਵਿਚ ਤੁਫੰਗ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ ॥੮੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "नाम तुफंग चीनि चिति राखु ॥८२७॥",
      "sourceLineId": "108035",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਦਿ ਨਾਇਕਨਿਨਿ ਆਦਿ ਬਖਾਨੋ ॥",
      "transliteration": "nadh naikanin aadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਨਦਿਨਾਇਕਨਿਨਿ' (ਨਦੀਆਂ ਦੀ ਨਾਇਕਾ ਗੰਗਾ ਵਾਲੀ ਧਰਤੀ) ਪਦ ਬਖਾਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "नदि नाइकनिनि आदि बखानो ॥",
      "sourceLineId": "108036",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਪ੍ਰਮਾਨੋ ॥",
      "transliteration": "jaa char keh pat sabadh pramaano ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति सबद प्रमानो ॥",
      "sourceLineId": "108037",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਬਹੁਰੋ ਤਿਹ ਦੀਜੈ ॥",
      "transliteration": "satr sabadh bahuro teh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਿਚ ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद बहुरो तिह दीजै ॥",
      "sourceLineId": "108038",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾਮ ਤੁਫੰਗ ਚੀਨਿ ਚਿਤਿ ਲੀਜੈ ॥੮੨੮॥",
      "transliteration": "naam tufa(n)g cheen chit leejai ||828||",
      "translation": "Add the words “Jaachar-pati-shatru” after firstly saying the word ‘Nad-naayakni” and know the names of Tupak in your mind.828.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਮਨ ਵਿਚ ਤੁਫੰਗ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ ॥੮੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "नाम तुफंग चीनि चिति लीजै ॥८२८॥",
      "sourceLineId": "108039",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਰਿਤੇਸ੍ਰਨਿਨਿ ਆਦਿ ਭਣਿਜੈ ॥",
      "transliteration": "saritesranin aadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸਰਿਤੇਸ੍ਰਨਿਨਿ' (ਨਦੀਆਂ ਦੀ ਸੁਆਮਨੀ ਗੰਗਾ ਵਾਲੀ ਧਰਤੀ) ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "सरितेस्रनिनि आदि भणिजै ॥",
      "sourceLineId": "108040",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਦਿਜੈ ॥",
      "transliteration": "jaa char keh naik padh dhijai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਵਿਚ) 'ਜਾ ਚਰ ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि नाइक पद दिजै ॥",
      "sourceLineId": "108041",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਬਖਾਨੋ ॥",
      "transliteration": "satr sabadh ko bahur bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਨੂੰ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि बखानो ॥",
      "sourceLineId": "108042",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਪਛਾਨੋ ॥੮੨੯॥",
      "transliteration": "naam tupak ke sakal pachhaano ||829||",
      "translation": "Utter the words “Jaachar-nayak-shatru” after firstly saying the word “Sariteshvarni” and recognize the names of Tupak.829.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਲੋਗ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੮੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल पछानो ॥८२९॥",
      "sourceLineId": "108043",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਰਿਤਾ ਬਰਨਿਨਿ ਆਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "saritaa baranin aadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸਰਿਤਾ ਬਰਨਿਨਿ' (ਗੰਗਾ ਨਦੀ ਵਾਲੀ ਧਰਤੀ) ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "सरिता बरनिनि आदि उचरीऐ ॥",
      "sourceLineId": "108044",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਡਰੀਐ ॥",
      "transliteration": "jaa char keh naik padh ddareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਜਾ ਚਰ ਨਾਇਕ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि नाइक पद डरीऐ ॥",
      "sourceLineId": "108045",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਬਖਾਨੋ ॥",
      "transliteration": "satr sabadh ko bahur bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि बखानो ॥",
      "sourceLineId": "108046",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਪਹਿਚਾਨੋ ॥੮੩੦॥",
      "transliteration": "naam tupak ke sabh pahichaano ||830||",
      "translation": "Add the words “Jaachar-nayak-shatru” after firstly saying the word “Saritaavarni” and recognize all the names of Tupak.830.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਲੋਗ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੮੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ पहिचानो ॥८३०॥",
      "sourceLineId": "108047",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਰਿਤੇਦ੍ਰਨਿਨਿ ਆਦਿ ਉਚਾਰੋ ॥",
      "transliteration": "saritedhranin aadh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸਰਿਤੇਦ੍ਰਨਿਨਿ' (ਗੰਗਾ ਵਾਲੀ ਨਦੀ) ਪਦ ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "सरितेद्रनिनि आदि उचारो ॥",
      "sourceLineId": "108048",
      "sourceShabadId": "9538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0762_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਪਦ ਦੇ ਡਾਰੋ ॥",
      "transliteration": "jaa char keh pat padh dhe ddaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਪਤਿ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 762,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति पद दे डारो ॥",
