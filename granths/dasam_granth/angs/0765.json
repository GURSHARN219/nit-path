  "lines": [
    {
      "id": "dasam_ang_0765_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੁਆਰਕੇਾਂਦ੍ਰਨਿਨਿ ਆਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "dhuaarakeaa(n)dhranin aadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਦੁਆਰਕੇਾਂਦ੍ਰਨਿਨਿ' (ਜਮਨਾ ਨਦੀ ਵਾਲੀ ਧਰਤੀ) ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "दुआरकेाँद्रनिनि आदि उचरीऐ ॥",
      "sourceLineId": "108155",
      "sourceShabadId": "9547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਸੁ ਧਰੀਐ ॥",
      "transliteration": "jaa char keh pat sabadh su dhareeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਪਤਿ' ਸ਼ਬਦਾ ਨੂੰ ਨਾਲ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति सबद सु धरीऐ ॥",
      "sourceLineId": "108156",
      "sourceShabadId": "9547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੇ ਅੰਤਿ ਬਖਾਨੋ ॥",
      "transliteration": "satr sabadh ke a(n)t bakhaano ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਅੰਤ ਉਤੇ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਨੂੰ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद के अंति बखानो ॥",
      "sourceLineId": "108157",
      "sourceShabadId": "9547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਕੇ ਮਾਨੋ ॥੮੫੬॥",
      "transliteration": "sabh sree naam tupak ke maano ||856||",
      "translation": "Saying firstly the word “Dvarkendrani”, then “Jaachar-pati and shatru” and know all the names of Tupak.856.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਮਨ ਲਵੋ ॥੮੫੬॥",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक के मानो ॥८५६॥",
      "sourceLineId": "108158",
      "sourceShabadId": "9547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੁਆਰਾਵਤੇਸ੍ਰਨਿ ਆਦਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "dhuaaraavatesran aadh bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਦੁਆਰਾਵਤੇਸ੍ਰਨਿ' (ਜਮਨਾ ਨਦੀ ਵਾਲੀ ਧਰਤੀ) ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "दुआरावतेस्रनि आदि बखानहु ॥",
      "sourceLineId": "108159",
      "sourceShabadId": "9547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਸੁ ਠਾਨਹੁ ॥",
      "transliteration": "jaa char keh pat sabadh su Thaanahu ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਪਤਿ' ਸ਼ਬਦਾ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति सबद सु ठानहु ॥",
      "sourceLineId": "108160",
      "sourceShabadId": "9547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਉਚਰੀਐ ॥",
      "transliteration": "satr sabadh ko bahur uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि उचरीऐ ॥",
      "sourceLineId": "108161",
      "sourceShabadId": "9547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਕੇ ਧਰੀਐ ॥੮੫੭॥",
      "transliteration": "sabh sree naam tupak ke dhareeaai ||857||",
      "translation": "Saying the word “Dvaarvtesh-varni” and then utter “Jaachar-pati-shatru” and know all the names of Tupak.857.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੮੫੭॥",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक के धरीऐ ॥८५७॥",
      "sourceLineId": "108162",
      "sourceShabadId": "9547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਦ੍ਵੇਸਨਿ ਆਦਿ ਉਚਾਰਨ ਕੀਜੈ ॥",
      "transliteration": "jadhavaiesan aadh uchaaran keejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਜਦ੍ਵੇਸਨਿ' (ਜਮਨਾ ਨਦੀ ਵਾਲੀ ਧਰਤੀ) ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "जद्वेसनि आदि उचारन कीजै ॥",
      "sourceLineId": "108163",
      "sourceShabadId": "9547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਦੀਜੈ ॥",
      "transliteration": "jaa char keh naik padh dheejai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਨਾਇਕ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि नाइक पद दीजै ॥",
      "sourceLineId": "108164",
      "sourceShabadId": "9547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "satr sabadh ko bahur bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि बखानहु ॥",
      "sourceLineId": "108165",
      "sourceShabadId": "9547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਪਹਿਚਾਨੋ ॥੮੫੮॥",
      "transliteration": "sabh sree naam tupak pahichaano ||858||",
      "translation": "Saying firstly the word “Yaadveshni”, then add “Jaachar-nayak-shatru” and recognize all the names of Tupak.858.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੮੫੮॥",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक पहिचानो ॥८५८॥",
      "sourceLineId": "108166",
      "sourceShabadId": "9547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦੁਆਰਾਵਤੀ ਨਾਇਕਨਿਨਿ ਭਾਖਹੁ ॥",
      "transliteration": "dhuaaraavatee naikanin bhaakhahu ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਦੁਆਰਾਵਤੀ ਨਾਇਕਨਿਨਿ' (ਸ਼ਬਦ) ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "दुआरावती नाइकनिनि भाखहु ॥",
      "sourceLineId": "108167",
      "sourceShabadId": "9547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਪਦ ਕਹੁ ਰਾਖਹੁ ॥",
      "transliteration": "jaa char keh pat padh kahu raakhahu ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਪਤਿ' ਪਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति पद कहु राखहु ॥",
      "sourceLineId": "108168",
      "sourceShabadId": "9547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "satr sabadh ko bahur bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਨੂੰ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि बखानहु ॥",
      "sourceLineId": "108169",
