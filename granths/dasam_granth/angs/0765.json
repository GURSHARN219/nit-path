    {
      "id": "dasam_ang_0765_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "108175",
      "sourceShabadId": "9548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਨਿਕ ਦੁੰਦਭਜਾ ਬਲਭਨਿ ਆਦਿ ਬਖਾਨੀਐ ॥",
      "transliteration": "anik dhu(n)dhabhajaa balabhan aadh bakhaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਅਨਕ ਦੁੰਦਭਜਾ ਬਲਭਨਿ' (ਕ੍ਰਿਸ਼ਨ ਦੀ ਪਿਆਰੀ ਜਮਨਾ ਵਾਲੀ ਧਰਤੀ) (ਪਦ) ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "अनिक दुँदभजा बलभनि आदि बखानीऐ ॥",
      "sourceLineId": "108176",
      "sourceShabadId": "9548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਬਹੁਰਿ ਪ੍ਰਮਾਨੀਐ ॥",
      "transliteration": "jaa char keh naik padh bahur pramaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਜਾ ਚਰ ਨਾਇਕ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि नाइक पद बहुरि प्रमानीऐ ॥",
      "sourceLineId": "108177",
      "sourceShabadId": "9548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਤਾ ਕੇ ਅੰਤਿ ਉਚਾਰੀਐ ॥",
      "transliteration": "satr sabadh ko taa ke a(n)t uchaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को ता के अंति उचारीऐ ॥",
      "sourceLineId": "108178",
      "sourceShabadId": "9548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹੋ ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਸੁਮੰਤ੍ਰ ਬਿਚਾਰੀਐ ॥੮੬੧॥",
      "transliteration": "ho sakal tupak ke naam suma(n)tr bichaareeaai ||861||",
      "translation": "Saying firstly the words “Anik-dundbhijaa-vallabhni” and then uttering the words “Jaachar-nayak-shatru”, know all the names of Tupak.861.",
      "punjabiViakhya": "ਸਭ ਮਿਤ੍ਰੋ! ਇਸ ਨੂੰ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ ॥੮੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "हो सकल तुपक के नाम सुमंत्र बिचारीऐ ॥८६१॥",
      "sourceLineId": "108179",
      "sourceShabadId": "9548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹਲੀ ਭ੍ਰਾਤਨਿਨਿ ਆਦਿ ਬਖਾਨਨਿ ਕੀਜੀਐ ॥",
      "transliteration": "halee bhraatanin aadh bakhaanan keejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਹਲੀ ਭ੍ਰਾਤਨਿਨਿ' (ਸ਼ਬਦ) ਦਾ ਬਖਾਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "हली भ्रातनिनि आदि बखाननि कीजीऐ ॥",
      "sourceLineId": "108180",
      "sourceShabadId": "9548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਕੈ ਪੁਨਿ ਨਾਇਕ ਪਦ ਦੀਜੀਐ ॥",
      "transliteration": "jaa char keh kai pun naik padh dheejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਜਾ ਚਰ ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि कै पुनि नाइक पद दीजीऐ ॥",
      "sourceLineId": "108181",
      "sourceShabadId": "9548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਤਾ ਕੇ ਅੰਤਿ ਬਖਾਨੀਐ ॥",
      "transliteration": "satr sabadh ko taa ke a(n)t bakhaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਨੂੰ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को ता के अंति बखानीऐ ॥",
      "sourceLineId": "108182",
      "sourceShabadId": "9548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹੋ ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਸੁਬੁਧਿ ਪ੍ਰਮਾਨੀਐ ॥੮੬੨॥",
      "transliteration": "ho sakal tupak ke naam subudh pramaaneeaai ||862||",
      "translation": "Uttering firstly the word “Halibhraatinani” and then saying “Jaachar” and adding “nayak-shatru” and know wisely all the names of Tupak.862.",
      "punjabiViakhya": "(ਇਹ) ਤੁਪਕ ਦਾ ਨਾਮ ਹੋ ਜਾਏਗਾ, ਸਭ ਬੁੱਧਮਾਨ ਵਿਚਾਰ ਕਰ ਲੈਣ ॥੮੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "हो सकल तुपक के नाम सुबुधि प्रमानीऐ ॥८६२॥",
      "sourceLineId": "108183",
      "sourceShabadId": "9548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "108184",
      "sourceShabadId": "9549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਲਿ ਆਨੁਜਨਿਨਿ ਆਦਿ ਬਖਾਨੋ ॥",
      "transliteration": "bal aanujanin aadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬਲੀ ਆਨੁਜਨਿਨਿ' (ਬਲਦੇਵ ਦੇ ਛੋਟੇ ਭਰਾ ਦੀ ਰਾਣੀ ਜਮਨਾ ਨਦੀ ਦੀ ਧਰਤੀ) ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "बलि आनुजनिनि आदि बखानो ॥",
      "sourceLineId": "108185",
      "sourceShabadId": "9549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਪ੍ਰਮਾਨੋ ॥",
      "transliteration": "jaa char keh pat sabadh pramaano ||",
      "translation": "",
      "punjabiViakhya": "(ਬਾਦ ਵਿਚ) 'ਜਾ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति सबद प्रमानो ॥",
      "sourceLineId": "108186",
      "sourceShabadId": "9549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕਹੁ ਬਹੁਰਿ ਭਣਿਜੈ ॥",
      "transliteration": "satr sabadh kahu bahur bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद कहु बहुरि भणिजै ॥",
      "sourceLineId": "108187",
      "sourceShabadId": "9549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਮ ਤੁਫੰਗ ਚੀਨ ਚਿਤਿ ਲਿਜੈ ॥੮੬੩॥",
      "transliteration": "naam tufa(n)g cheen chit lijai ||863||",
      "translation": "Saying word “Bal-anu-janani” in the beginning, then add the words “Jaachar-pati-shatru” and recognize the names of Tupak.863.",
      "punjabiViakhya": "(ਇਹ) ਤੁਫੰਗ ਦਾ ਨਾਮ ਹੈ, ਚਿਤ ਵਿਚ ਵਿਚਾਰ ਲਵੋ ॥੮੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "नाम तुफंग चीन चिति लिजै ॥८६३॥",
      "sourceLineId": "108188",
      "sourceShabadId": "9549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਲਿ ਭਈਅਨਨੀ ਆਦਿ ਬਖਾਨੋ ॥",
      "transliteration": "bal bhieeananee aadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬਲਿ ਭਈਅਨਨੀ' ਸ਼ਬਦ ਸ਼ੁਰੂ ਵਿਚ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "बलि भईअननी आदि बखानो ॥",
      "sourceLineId": "108189",
      "sourceShabadId": "9549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਪ੍ਰਮਾਨੋ ॥",
      "transliteration": "jaa char keh pat sabadh pramaano ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति सबद प्रमानो ॥",
      "sourceLineId": "108190",
      "sourceShabadId": "9549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰੋ ਕਹੀਯੋ ॥",
      "transliteration": "satr sabadh ko bahuro kaheeyo ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਨੂੰ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरो कहीयो ॥",
      "sourceLineId": "108191",
      "sourceShabadId": "9549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਕੇ ਲਹੀਯੋ ॥੮੬੪॥",
      "transliteration": "sabh sree naam tupak ke laheeyo ||864||",
      "translation": "Add the words “Jaachar-pati-shatru” after firstly saying “Balbhai-anani” and know the names of Tupak.864.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ ॥੮੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक के लहीयो ॥८६४॥",
      "sourceLineId": "108192",
      "sourceShabadId": "9549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਉਹਣੇਅ ਭ੍ਰਾਤਨਨਿ ਭਾਖੁ ॥",
      "transliteration": "rauhanea bhraatanan bhaakh ||",
      "translation": "",
      "punjabiViakhya": "(ਪਹਿਲਾ) 'ਰਉਹਣੇਅ ਭਰਾਤਨਨੀ' (ਰੋਹਿਣੀ ਦੇ ਪਤੀ ਬਲਦੇਵ ਦੇ ਭਰਾ ਦੀ ਪਤਨੀ ਜਮਨਾ ਨਾ ਦੀ ਨਦੀ ਵਾਲੀ ਧਰਤੀ) ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "रउहणेअ भ्रातननि भाखु ॥",
      "sourceLineId": "108193",
      "sourceShabadId": "9549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਰਾਖੁ ॥",
      "transliteration": "jaa char keh naik padh raakh ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि नाइक पद राखु ॥",
      "sourceLineId": "108194",
      "sourceShabadId": "9549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਭਣਿਜੈ ॥",
      "transliteration": "satr sabadh ko bahur bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਨੂੰ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि भणिजै ॥",
      "sourceLineId": "108195",
      "sourceShabadId": "9549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਲਹਿ ਲਿਜੈ ॥੮੬੫॥",
      "transliteration": "sabh sree naam tupak leh lijai ||865||",
      "translation": "Say the words “Jaachar-pati-shatru” after firstly uttering the word “Rohineya-bhraatinani” and know the names of Tupak.865.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਾਰੇ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੮੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक लहि लिजै ॥८६५॥",
      "sourceLineId": "108196",
      "sourceShabadId": "9549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਲਭਦ੍ਰ ਭ੍ਰਾਤਨਿਨਿ ਆਦਿ ਉਚਾਰੋ ॥",
      "transliteration": "balabhadhr bhraatanin aadh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬਲਭਦ੍ਰ ਭ੍ਰਾਤਨਿਨਿ' (ਸ਼ਬਦ) ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "बलभद्र भ्रातनिनि आदि उचारो ॥",
      "sourceLineId": "108197",
      "sourceShabadId": "9549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਡਾਰੋ ॥",
      "transliteration": "jaa char keh naik padh ddaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਨਾਇਕ' ਪਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि नाइक पद डारो ॥",
      "sourceLineId": "108198",
      "sourceShabadId": "9549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਬਖਾਨੋ ॥",
      "transliteration": "satr sabadh ko bahur bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਨੂੰ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि बखानो ॥",
      "sourceLineId": "108199",
      "sourceShabadId": "9549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਕੇ ਜਾਨੋ ॥੮੬੬॥",
      "transliteration": "sabh sree naam tupak ke jaano ||866||",
      "translation": "Utter firstly the words “Balbhadar-bhraatinani”, then add the words “Jaachar, nayak and shatru” and in this way know all the names of Tupak.866.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਕਰ ਕੇ ਜਾਣੋ ॥੮੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक के जानो ॥८६६॥",
      "sourceLineId": "108200",
      "sourceShabadId": "9549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 765,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "108201",
      "sourceShabadId": "9550",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0765_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪ੍ਰਲੰਬਘਨੁ ਅਨੁਜਨਨੀ ਆਦਿ ਬਖਾਨੀਐ ॥",
