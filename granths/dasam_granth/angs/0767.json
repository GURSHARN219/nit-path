  "lines": [
    {
      "id": "dasam_ang_0767_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹੋ ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਸੁਗਿਆਨ ਪਛਾਨੀਐ ॥੮੭੮॥",
      "transliteration": "ho sakal tupak ke naam sugiaan pachhaaneeaai ||878||",
      "translation": "Saying firstly the word “Shaktasur-hananan” then add the words “Jaachar-nayak-shatru” and recognize all the names of Tupak.878.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਾਰੇ ਗਿਆਨੀ ਲੋਗ ਤੁਪਕ ਦਾ ਨਾਮ ਕਰਕੇ ਸਮਝ ਲੈਣ ॥੮੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 767,
      "hindi": "",
      "hindiTransliteration": "हो सकल तुपक के नाम सुगिआन पछानीऐ ॥८७८॥",
      "sourceLineId": "108251",
      "sourceShabadId": "9552",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0767_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 767,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "108252",
      "sourceShabadId": "9553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0767_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮੁਰਅਰਿਨਿਨਿ ਸਬਦਾਦਿ ਭਣਿਜੈ ॥",
      "transliteration": "murarinin sabadhaadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸੁਰ ਅਰਨਿਨਿ' (ਮੁਰ ਦੈਂਤ ਦੇ ਵੈਰੀ ਕ੍ਰਿਸ਼ਨ ਦੀ ਪਤਨੀ ਜਮਨਾ ਨਦੀ ਵਾਲੀ ਧਰਤੀ) ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 767,
      "hindi": "",
      "hindiTransliteration": "मुरअरिनिनि सबदादि भणिजै ॥",
      "sourceLineId": "108253",
      "sourceShabadId": "9553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0767_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਦਿਜੈ ॥",
      "transliteration": "jaa char keh naik padh dhijai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 767,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि नाइक पद दिजै ॥",
      "sourceLineId": "108254",
      "sourceShabadId": "9553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0767_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "satr sabadh ko bahur bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਨੂੰ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 767,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि बखानहु ॥",
      "sourceLineId": "108255",
      "sourceShabadId": "9553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0767_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਕੇ ਜਾਨਹੁ ॥੮੭੯॥",
      "transliteration": "sabh sree naam tupak ke jaanahu ||879||",
      "translation": "Mention the words “Jaachar-nayak-shatru” after firstly uttering the word “Mur-arinin” and know all the names of Tupak.879.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੮੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 767,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक के जानहु ॥८७९॥",
      "sourceLineId": "108256",
      "sourceShabadId": "9553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0767_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਰਕਾਤਕਨਿਨਿ ਆਦਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "narakaatakanin aadh bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਨਰਕਾਤਕਨਿਨਿ' (ਨਰਕਾਸੁਰ ਦਾ ਅੰਤ ਕਰਨ ਵਾਲੇ ਕ੍ਰਿਸ਼ਨ ਦੀ ਪਤਨੀ ਜਮਨਾ ਨਦੀ ਵਾਲੀ ਧਰਤੀ) ਬਖਾਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 767,
      "hindi": "",
      "hindiTransliteration": "नरकातकनिनि आदि बखानहु ॥",
      "sourceLineId": "108257",
      "sourceShabadId": "9553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0767_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਪ੍ਰਮਾਨਹੁ ॥",
      "transliteration": "jaa char keh pat sabadh pramaanahu ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 767,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति सबद प्रमानहु ॥",
      "sourceLineId": "108258",
      "sourceShabadId": "9553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0767_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਭਣਿਜੈ ॥",
      "transliteration": "satr sabadh ko bahur bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 767,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि भणिजै ॥",
      "sourceLineId": "108259",
      "sourceShabadId": "9553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0767_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਕਹਿਜੈ ॥੮੮੦॥",
      "transliteration": "sakal tupak ke naam kahijai ||880||",
      "translation": "Uttering the word “Narkaantaknin” the beginning and then say ‘jaachar-pati-shatru” and in this way all the names of Tupak are spoken.880.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਕਹੋ ॥੮੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 767,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम कहिजै ॥८८०॥",
      "sourceLineId": "108260",
      "sourceShabadId": "9553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0767_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਆਦਿ ਨਰਕਹਾਨਿਨਿ ਪਦ ਭਾਖੋ ॥",
      "transliteration": "aadh narakahaanin padh bhaakho ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਨਰਕ ਹਾਰਨਿਨਿ' (ਨਰਕਾਸੁਰ ਨੂੰ ਮਾਰਨ ਵਾਲੇ ਕ੍ਰਿਸ਼ਨ ਦੀ ਪਤਨੀ ਜਮਨਾ ਨਦੀ ਵਾਲੀ ਧਰਤੀ) ਪਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 767,
      "hindi": "",
      "hindiTransliteration": "आदि नरकहानिनि पद भाखो ॥",
      "sourceLineId": "108261",
      "sourceShabadId": "9553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0767_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਰਾਖੋ ॥",
      "transliteration": "jaa char keh naik padh raakho ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਨਾਇਕ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 767,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि नाइक पद राखो ॥",
      "sourceLineId": "108262",
      "sourceShabadId": "9553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0767_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "satr sabadh ko bahur bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਬਖਾਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 767,
