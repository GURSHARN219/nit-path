    {
      "id": "dasam_ang_0767_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਕੇ ਜਾਨਹੁ ॥੮੮੧॥",
      "transliteration": "sabh sree naam tupak ke jaanahu ||881||",
      "translation": "Saying firstly the word “Narak-haanin”, then add the words “Jaachar-nayak-shatru” and know the names of Tupak.881.",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੮੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 767,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक के जानहु ॥८८१॥",
      "sourceLineId": "108264",
      "sourceShabadId": "9553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0767_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਤ੍ਰੁ ਘਾਇਨਨਿ ਆਦਿ ਭਣਿਜੈ ॥",
      "transliteration": "satr ghainan aadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸਤ੍ਰੁ ਘਾਇਨਨਿ' (ਵੈਰੀਆਂ ਨੂੰ ਮਾਰਨ ਵਾਲੇ ਕ੍ਰਿਸ਼ਨ ਦੀ ਪਤਨੀ ਜਮਨਾ ਵਾਲੀ ਧਰਤੀ) ਨੂੰ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 767,
      "hindi": "",
      "hindiTransliteration": "सत्रु घाइननि आदि भणिजै ॥",
      "sourceLineId": "108265",
      "sourceShabadId": "9553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
