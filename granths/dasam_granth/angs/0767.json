    },
    {
      "id": "dasam_ang_0767_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਪਹਿਚਾਨਹੁ ॥੮੮੨॥",
      "transliteration": "sabh sree naam tupak pahichaanahu ||882||",
      "translation": "Utter firstly the word “Shatru-ghayanin”, then add “Jaachar-nayak” and after wards add the word “Shatru” and in this way know the names of Tupak.882.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਕਰ ਕੇ ਪਛਾਣੋ ॥੮੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 767,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक पहिचानहु ॥८८२॥",
      "sourceLineId": "108268",
      "sourceShabadId": "9553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0767_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 767,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "108269",
      "sourceShabadId": "9554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0767_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮੁਰ ਮਰਦਨਿਨਿ ਆਦਿ ਉਚਾਰਨ ਕੀਜੀਐ ॥",
      "transliteration": "mur maradhanin aadh uchaaran keejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਮੁਰ ਮਰਦਨਿਨਿ' (ਮੁਰ ਰਾਖਸ਼ ਨੂੰ ਮਾਰਨ ਵਾਲੇ ਸ੍ਰੀ ਕ੍ਰਿਸ਼ਨ ਦੀ ਪਤਨੀ ਜਮਨਾ ਨਦੀ ਵਾਲੀ ਧਰਤੀ) ਸ਼ਬਦ ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 767,
      "hindi": "",
      "hindiTransliteration": "मुर मरदनिनि आदि उचारन कीजीऐ ॥",
      "sourceLineId": "108270",
      "sourceShabadId": "9554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0767_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਕੇ ਪੁਨਿ ਨਾਇਕ ਪਦ ਦੀਜੀਐ ॥",
      "transliteration": "jaa char keh ke pun naik padh dheejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਜਾ ਚਰ ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 767,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि के पुनि नाइक पद दीजीऐ ॥",
      "sourceLineId": "108271",
      "sourceShabadId": "9554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0767_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਤਾ ਕੇ ਅੰਤਿ ਭਣੀਜੀਐ ॥",
      "transliteration": "satr sabadh ko taa ke a(n)t bhaneejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਬਾਦ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਨੂੰ ਅੰਤ ਉਤੇ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 767,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को ता के अंति भणीजीऐ ॥",
      "sourceLineId": "108272",
      "sourceShabadId": "9554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0767_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹੋ ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਚਤੁਰ ਲਹਿ ਲੀਜੀਐ ॥੮੮੩॥",
      "transliteration": "ho sakal tupak ke naam chatur leh leejeeaai ||883||",
      "translation": "Saying fiestly the word “Murmardanin” and then adding the words “Jaachar-nayak-shatru”, know all the names of Tupak.883.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਾਰੇ ਚਤੁਰ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲੈਣ ॥੮੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 767,
      "hindi": "",
      "hindiTransliteration": "हो सकल तुपक के नाम चतुर लहि लीजीऐ ॥८८३॥",
      "sourceLineId": "108273",
