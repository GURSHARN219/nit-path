    {
      "id": "dasam_ang_0770_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹੋ ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪ੍ਰਬੀਨ ਬਿਚਾਰੀਐ ॥੯੦੬॥",
      "transliteration": "ho sakal tupak ke naam prabeen bichaareeaai ||906||",
      "translation": "Saying firstly the word “Meghjanin”, then add the words “Jaachar, naath and shatru” and consider all the names of Tupak.906.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਾਰੇ ਪ੍ਰਬੀਨ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝਣ ॥੯੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 770,
      "hindi": "",
      "hindiTransliteration": "हो सकल तुपक के नाम प्रबीन बिचारीऐ ॥९०६॥",
      "sourceLineId": "108371",
      "sourceShabadId": "9560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0770_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 770,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "108372",
      "sourceShabadId": "9561",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0770_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਾਰਸੁਤੀ ਸਬਦਾਦਿ ਉਚਾਰੋ ॥",
      "transliteration": "saarasutee sabadhaadh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸਾਰਸੁਤੀ' ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 770,
      "hindi": "",
      "hindiTransliteration": "सारसुती सबदादि उचारो ॥",
      "sourceLineId": "108373",
      "sourceShabadId": "9561",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0770_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਡਾਰੋ ॥",
      "transliteration": "jaa char keh naik padh ddaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਜਾ ਚਰ ਨਾਇਕ' ਪਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 770,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि नाइक पद डारो ॥",
      "sourceLineId": "108374",
      "sourceShabadId": "9561",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0770_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕਹੁ ਬਹੁਰਿ ਭਣਿਜੈ ॥",
      "transliteration": "satr sabadh kahu bahur bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 770,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद कहु बहुरि भणिजै ॥",
      "sourceLineId": "108375",
      "sourceShabadId": "9561",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0770_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਲਹਿ ਲਿਜੈ ॥੯੦੭॥",
      "transliteration": "naam tupak ke sabh leh lijai ||907||",
      "translation": "Utter firstly the word “Sarasvati” and then speak the words “Jaachar-nayak-shatru” and in this way speak all the names of Tupak.907.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੯੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 770,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ लहि लिजै ॥९०७॥",
      "sourceLineId": "108376",
      "sourceShabadId": "9561",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0770_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੰਗ ਭੇਟਨੀ ਆਦਿ ਉਚਾਰੋ ॥",
      "transliteration": "ga(n)g bheTanee aadh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਗੰਗ ਭੇਟਨੀ' ਸ਼ਬਦ ਨੂੰ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 770,
      "hindi": "",
      "hindiTransliteration": "गंग भेटनी आदि उचारो ॥",
      "sourceLineId": "108377",
      "sourceShabadId": "9561",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
