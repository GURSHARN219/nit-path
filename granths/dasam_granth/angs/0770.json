      "raag": ""
    },
    {
      "id": "dasam_ang_0770_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਠਾਨਹੁ ॥",
