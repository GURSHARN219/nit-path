    {
      "id": "dasam_ang_0770_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਰੁਣਿ ਬਾਰਨਿਨਿ ਆਦਿ ਬਖਾਨਹੁ ॥",
