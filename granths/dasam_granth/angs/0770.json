    {
      "id": "dasam_ang_0770_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਕਹਿਜੈ ॥੯੦੮॥",
      "transliteration": "naam tupak ke sakal kahijai ||908||",
      "translation": "Say firstly the word “Gang-bhetani” and then utter the words “Jaachar-nayak-shatru” and in this way speak all the names of Tupak.908.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਕਹੋ ॥੯੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 770,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल कहिजै ॥९०८॥",
      "sourceLineId": "108380",
