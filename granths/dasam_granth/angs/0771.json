  "lines": [
    {
      "id": "dasam_ang_0771_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਤਦ੍ਰਵਨਿਨੀ ਪ੍ਰਿਥਮ ਪ੍ਰਕਾਸੋ ॥",
      "transliteration": "satadhravaninee piratham prakaaso ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸਤਦ੍ਰਵਨਿਨੀ' (ਸੈਂਕੜੇ ਧਾਰਾ ਬਣਾ ਕੇ ਵਗਣ ਵਾਲੀ ਨਦੀ) (ਸ਼ਬਦ) ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 771,
      "hindi": "",
      "hindiTransliteration": "सतद्रवनिनी पृथम प्रकासो ॥",
      "sourceLineId": "108419",
      "sourceShabadId": "9563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0771_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਰਾਖੋ ॥",
      "transliteration": "jaa char keh naik padh raakho ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 771,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि नाइक पद राखो ॥",
      "sourceLineId": "108420",
      "sourceShabadId": "9563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0771_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਰਿ ਪਦ ਤਾ ਕੇ ਅੰਤਿ ਉਚਰੀਐ ॥",
      "transliteration": "ar padh taa ke a(n)t uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਤੇ 'ਅਰਿ' ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 771,
      "hindi": "",
      "hindiTransliteration": "अरि पद ता के अंति उचरीऐ ॥",
      "sourceLineId": "108421",
      "sourceShabadId": "9563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0771_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਬਿਚਰੀਐ ॥੯੧੮॥",
      "transliteration": "sakal tupak ke naam bichareeaai ||918||",
      "translation": "Saying firstly the word “Shatdravani” (Sutlej), add the words “Jaachar-nayak-ari” and know all the names of Tupak.918.",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੯੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 771,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम बिचरीऐ ॥९१८॥",
      "sourceLineId": "108422",
      "sourceShabadId": "9563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0771_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਤ ਪ੍ਰਵਾਹਨਿਨਿ ਆਦਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "sat pravaahanin aadh bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸਤ ਪ੍ਰਵਾਹਨਿਨਿ' (ਸ਼ਬਦ) ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 771,
      "hindi": "",
      "hindiTransliteration": "सत प्रवाहनिनि आदि बखानहु ॥",
      "sourceLineId": "108423",
      "sourceShabadId": "9563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0771_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਠਾਨਹੁ ॥",
      "transliteration": "jaa char keh naik padh Thaanahu ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 771,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि नाइक पद ठानहु ॥",
      "sourceLineId": "108424",
      "sourceShabadId": "9563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0771_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕਹੁ ਬਹੁਰਿ ਉਚਾਰੋ ॥",
      "transliteration": "satr sabadh kahu bahur uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਨੂੰ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 771,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद कहु बहुरि उचारो ॥",
      "sourceLineId": "108425",
      "sourceShabadId": "9563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0771_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਬਿਚਾਰੋ ॥੯੧੯॥",
      "transliteration": "naam tupak ke sakal bichaaro ||919||",
      "translation": "Saying firstly the word “Sat-pravaahinin”, add the words “Jaachar-nayak-shatru” and know all the names of Tupak.919.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੯੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 771,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल बिचारो ॥९१९॥",
      "sourceLineId": "108426",
      "sourceShabadId": "9563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0771_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਹਸ ਨਾਰਨਿਨਿ ਆਦਿ ਬਖਾਨੋ ॥",
      "transliteration": "sahas naaranin aadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸਹਸ ਨਾਰਨਿਨਿ' ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 771,
      "hindi": "",
      "hindiTransliteration": "सहस नारनिनि आदि बखानो ॥",
      "sourceLineId": "108427",
      "sourceShabadId": "9563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0771_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਪ੍ਰਮਾਨੋ ॥",
      "transliteration": "jaa char keh pat sabadh pramaano ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 771,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति सबद प्रमानो ॥",
      "sourceLineId": "108428",
      "sourceShabadId": "9563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0771_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੇ ਬਹੁਰਿ ਭਣਿਜੈ ॥",
      "transliteration": "satr sabadh ke bahur bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 771,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद के बहुरि भणिजै ॥",
      "sourceLineId": "108429",
      "sourceShabadId": "9563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0771_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਲਹਿ ਲਿਜੈ ॥੯੨੦॥",
      "transliteration": "naam tupak ke sabh leh lijai ||920||",
      "translation": "Saying firstly the word “Sahasar-narinin”, add the words “Jaachar-pati-shatru” and know all the names of Tupak.920.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ ॥੯੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 771,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ लहि लिजै ॥९२०॥",
      "sourceLineId": "108430",
      "sourceShabadId": "9563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0771_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 771,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "108431",
      "sourceShabadId": "9564",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0771_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਤ ਦ੍ਰਵਨਨਿਨਿ ਆਦਿ ਉਚਾਰਨ ਕੀਜੀਐ ॥",
      "transliteration": "sat dhravananin aadh uchaaran keejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸਤ ਦ੍ਰਵਨਨਿਨਿ' (ਸ਼ਬਦ) ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 771,
      "hindi": "",
      "hindiTransliteration": "सत द्रवननिनि आदि उचारन कीजीऐ ॥",
      "sourceLineId": "108432",
      "sourceShabadId": "9564",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0771_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਕੈ ਨਾਥ ਸਬਦ ਕਹੁ ਦੀਜੀਐ ॥",
      "transliteration": "jaa char keh kai naath sabadh kahu dheejeeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਨਾਥ' (ਸ਼ਬਦ) ਕਹਿ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 771,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि कै नाथ सबद कहु दीजीऐ ॥",
      "sourceLineId": "108433",
      "sourceShabadId": "9564",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0771_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰਿਪੁ ਪਦ ਕੋ ਤਾ ਕੇ ਪੁਨਿ ਅੰਤਿ ਬਖਾਨੀਐ ॥",
      "transliteration": "rip padh ko taa ke pun a(n)t bakhaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਰਿਪੁ' ਪਦ ਨੂੰ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 771,
      "hindi": "",
      "hindiTransliteration": "रिपु पद को ता के पुनि अंति बखानीऐ ॥",
      "sourceLineId": "108434",
      "sourceShabadId": "9564",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0771_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹੋ ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਸੁਬੁਧਿ ਪਛਾਨੀਐ ॥੯੨੧॥",
      "transliteration": "ho sakal tupak ke naam subudh pachhaaneeaai ||921||",
      "translation": "Saying firstly the word “Satyadravananini”, add the words “Jaachar-naath-ripu” and recognize thoughtfully all the names of Tupak.921.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਾਰੇ ਬੁੱਧੀਮਾਨ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੯੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 771,
      "hindi": "",
      "hindiTransliteration": "हो सकल तुपक के नाम सुबुधि पछानीऐ ॥९२१॥",
      "sourceLineId": "108435",
      "sourceShabadId": "9564",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0771_line_0018",
      "lineIndex": 18,
