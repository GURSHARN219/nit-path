      "ang": 772,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ लहि लिजै ॥९३६॥",
      "sourceLineId": "108498",
      "sourceShabadId": "9567",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0772_line_0033",
