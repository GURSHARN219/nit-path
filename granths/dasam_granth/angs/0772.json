      "sourceShabadId": "9568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0772_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹੋ ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਸੁਬੁਧਿ ਪ੍ਰਮਾਨੀਐ ॥੯੩੮॥",
