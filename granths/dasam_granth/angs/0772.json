      "source": "DASAM_GRANTH",
      "ang": 772,
      "hindi": "",
      "hindiTransliteration": "चंद्रनुजनिनि आदि बखानहु ॥",
      "sourceLineId": "108499",
      "sourceShabadId": "9567",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0772_line_0034",
      "lineIndex": 34,
