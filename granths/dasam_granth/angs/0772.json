      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸਸਿ ਅਨੁਜਨਿਨੀ' (ਸ਼ਬਦ) ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 772,
      "hindi": "",
      "hindiTransliteration": "ससि अनुजनिनी आदि उचारन कीजीऐ ॥",
      "sourceLineId": "108504",
      "sourceShabadId": "9568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0772_line_0039",
