    {
      "id": "dasam_ang_0772_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚੰਦ੍ਰ ਭਗਨਿਨਿ ਆਦਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "cha(n)dhr bhaganin aadh bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਚੰਦ੍ਰ ਭਗਨਿਨਿ' (ਝਨਾ ਨਦੀ ਨੂੰ ਧਾਰਨ ਕਰਨ ਵਾਲੀ ਧਰਤੀ) (ਸ਼ਬਦ) ਨੂੰ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 772,
      "hindi": "",
      "hindiTransliteration": "चंद्र भगनिनि आदि बखानहु ॥",
      "sourceLineId": "108491",
      "sourceShabadId": "9567",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0772_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਪ੍ਰਮਾਨਹੁ ॥",
      "transliteration": "jaa char keh pat sabadh pramaanahu ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 772,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति सबद प्रमानहु ॥",
      "sourceLineId": "108492",
      "sourceShabadId": "9567",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0772_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕਹੁ ਬਹੁਰਿ ਉਚਾਰਹੁ ॥",
      "transliteration": "satr sabadh kahu bahur uchaarahu ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 772,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद कहु बहुरि उचारहु ॥",
      "sourceLineId": "108493",
      "sourceShabadId": "9567",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0772_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਬਿਚਾਰਹੁ ॥੯੩੫॥",
      "transliteration": "naam tupak ke sakal bichaarahu ||935||",
      "translation": "Saying firstly the word “Chandra-bhaaganani”, add the words “Jaachar-pati-shatru” and know all the names of Tupak.935.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਵਿਚਾਰੋ ॥੯੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 772,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल बिचारहु ॥९३५॥",
      "sourceLineId": "108494",
      "sourceShabadId": "9567",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0772_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਸਿ ਭਗਨਿਨਿ ਸਬਦਾਦਿ ਬਖਾਨੋ ॥",
      "transliteration": "sas bhaganin sabadhaadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸਸਿ ਭਗਨਿਨਿ' ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 772,
      "hindi": "",
      "hindiTransliteration": "ससि भगनिनि सबदादि बखानो ॥",
      "sourceLineId": "108495",
      "sourceShabadId": "9567",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
