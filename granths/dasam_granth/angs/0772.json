      "ang": 772,
      "hindi": "",
      "hindiTransliteration": "हो सकल तुपक के नाम सुबीर पछानीऐ ॥९३३॥",
      "sourceLineId": "108485",
      "sourceShabadId": "9566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
