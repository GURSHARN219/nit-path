    {
      "id": "dasam_ang_0773_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਜੀਅ ਜਾਨਹੁ ॥੯੪੫॥",
