  "lines": [
    {
      "id": "dasam_ang_0773_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਕਰਿ ਨਾਥ ਸਬਦ ਕਹੁ ਠਾਨੀਐ ॥",
      "transliteration": "jaa char keh kar naath sabadh kahu Thaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਨਾਥ' ਸ਼ਬਦ ਨੂੰ ਕਹਿ ਕੇ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि करि नाथ सबद कहु ठानीऐ ॥",
      "sourceLineId": "108515",
      "sourceShabadId": "9570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕਹੁ ਤਾ ਕੇ ਅੰਤਿ ਭਣੀਜੀਐ ॥",
      "transliteration": "satr sabadh kahu taa ke a(n)t bhaneejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद कहु ता के अंति भणीजीऐ ॥",
      "sourceLineId": "108516",
      "sourceShabadId": "9570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹੋ ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਸੁਕਬਿ ਲਹਿ ਲੀਜੀਐ ॥੯੪੦॥",
      "transliteration": "ho sakal tupak ke naam sukab leh leejeeaai ||940||",
      "translation": "Saying firstly the word “Mayank-sahodarnani”, add the words “Jaachar-naath-shatru” at the end, and in this way O good poets! know all the names of Tupak.940.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਕਵੀ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ ॥੯੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "हो सकल तुपक के नाम सुकबि लहि लीजीऐ ॥९४०॥",
      "sourceLineId": "108517",
      "sourceShabadId": "9570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "108518",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਜ ਅਨੁਜਨਨਿਨਿ ਆਦਿ ਕਹਿਜੈ ॥",
      "transliteration": "aj anujananin aadh kahijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਅਜ (ਚੰਦ੍ਰਮਾ) ਅਨੁਜਨਨਿਨਿ' (ਸ਼ਬਦ) ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "अज अनुजननिनि आदि कहिजै ॥",
      "sourceLineId": "108519",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਭਣਿਜੈ ॥",
      "transliteration": "jaa char keh pat sabadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति सबद भणिजै ॥",
      "sourceLineId": "108520",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕਹੁ ਅੰਤਿ ਉਚਾਰਹੁ ॥",
      "transliteration": "satr sabadh kahu a(n)t uchaarahu ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਅੰਤ ਉਤੇ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद कहु अंति उचारहु ॥",
      "sourceLineId": "108521",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਬਿਚਾਰਹੁ ॥੯੪੧॥",
      "transliteration": "sakal tupak ke naam bichaarahu ||941||",
      "translation": "Saying firstly the word “Ar-anujananani”, add the words “Jaachar-pati-shatu” at the end, and consider all the names of Tupak.941.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਾਰੇ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੯੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम बिचारहु ॥९४१॥",
      "sourceLineId": "108522",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਿਸਿਸ ਅਨੁਜਨਨਿਨਿ ਆਦਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "nisis anujananin aadh bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਨਿਸਿਸ (ਚੰਦ੍ਰਮਾ) ਅਨੁਜਨਨਿਨਿ' (ਸ਼ਬਦ) ਦਾ ਬਖਾਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "निसिस अनुजननिनि आदि बखानहु ॥",
      "sourceLineId": "108523",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦਿ ਪ੍ਰਮਾਨਹੁ ॥",
      "transliteration": "jaa char keh pat sabadh pramaanahu ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति सबदि प्रमानहु ॥",
      "sourceLineId": "108524",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਉਚਰੀਐ ॥",
      "transliteration": "satr sabadh ko bahur uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि उचरीऐ ॥",
      "sourceLineId": "108525",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਬਿਚਰੀਐ ॥੯੪੨॥",
      "transliteration": "sakal tupak ke naam bichareeaai ||942||",
      "translation": "Saying firstly the word “Nishish-anujjananani”, add the words “Jaachar-pati-shatru”, and know all the names of Tupak.942.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਲੋਗ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝਣ ॥੯੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम बिचरीऐ ॥९४२॥",
      "sourceLineId": "108526",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਿਸਿ ਇਸਰਨਨਿਨਿ ਆਦਿ ਕਹਿਜੈ ॥",
      "transliteration": "nis isarananin aadh kahijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਨਿਸਿ ਇਸਰਨਨਿਨਿ' (ਰਾਤ ਦੇ ਈਸ਼ਵਰ ਚੰਦ੍ਰਮਾ ਦੀ ਛੋਟੀ ਭੈਣ ਚੰਨ੍ਰਹਾ ਨਦੀ ਵਾਲੀ ਧਰਤੀ) (ਸ਼ਬਦ) ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "निसि इसरननिनि आदि कहिजै ॥",
      "sourceLineId": "108527",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਭਣਿਜੈ ॥",
      "transliteration": "jaa char keh pat sabadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਬੋਲੋ।",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति सबद भणिजै ॥",
      "sourceLineId": "108528",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕਹੁ ਬਹੁਰਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "satr sabadh kahu bahur bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਬਖਾਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद कहु बहुरि बखानहु ॥",
      "sourceLineId": "108529",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪਛਾਨਹੁ ॥੯੪੩॥",
      "transliteration": "sakal tupak ke naam pachhaanahu ||943||",
      "translation": "Saying firstly the word “Nishi-Ishvarananin”, add the words “Jaachar-pati-shatru” and recognize all the names of Tupak.943.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਾਰੇ ਤੁਪਕ ਦੇ ਨਾਮ ਵਜੋਂ ਪਛਾਣੋ ॥੯੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम पछानहु ॥९४३॥",
      "sourceLineId": "108530",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰੈਨਾਧਿਪਨੀ ਆਦਿ ਬਖਾਨੋ ॥",
      "transliteration": "rainaadhipanee aadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਰੈਨਾਧਿਪਨੀ' (ਰਾਤੇ ਦੇ ਸੁਆਮੀ ਚੰਦ੍ਰਮਾ ਨਾਲ ਸੰਬੰਧ ਰਖਣ ਵਾਲੀ ਨਦੀ ਚੰਨ੍ਰਹਾ) (ਸ਼ਬਦ) ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "रैनाधिपनी आदि बखानो ॥",
      "sourceLineId": "108531",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਠਾਨੋ ॥",
      "transliteration": "jaa char keh naik padh Thaano ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਨਾਇਕ' ਪਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि नाइक पद ठानो ॥",
      "sourceLineId": "108532",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕਹੁ ਬਹੁਰਿ ਭਣਿਜੈ ॥",
      "transliteration": "satr sabadh kahu bahur bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਵਰਣਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद कहु बहुरि भणिजै ॥",
      "sourceLineId": "108533",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਲਖਿ ਲਿਜੈ ॥੯੪੪॥",
      "transliteration": "naam tupak ke sabh lakh lijai ||944||",
      "translation": "Saying firstly the word “Rainaadhipni”, add the words “Jaachar-nayak-shatru”, and know all the names of Tupak.944.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ ॥੯੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ लखि लिजै ॥९४४॥",
      "sourceLineId": "108534",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰੈਨ ਰਾਟਨਿਨਿ ਆਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "rain raaTanin aadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਰੈਨ ਰਾਟਨਿਨਿ' (ਸ਼ਬਦ) ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "रैन राटनिनि आदि उचरीऐ ॥",
      "sourceLineId": "108535",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0773_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਧਰੀਐ ॥",
      "transliteration": "jaa char keh naik padh dhareeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਨਾਇਕ' ਪਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 773,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि नाइक पद धरीऐ ॥",
