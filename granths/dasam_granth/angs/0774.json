  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0774_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰੈਨਰਾਜਨੀ ਆਦਿ ਕਹਿਜੈ ॥",
      "transliteration": "rainaraajanee aadh kahijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਰੈਨਰਾਜਨੀ' (ਰਾਤ ਦੇ ਰਾਜੇ ਚੰਦ੍ਰਮਾ ਨਾਲ ਸੰਬੰਧਿਤ ਚੰਨ੍ਰਹਾ ਨਦੀ) (ਸ਼ਬਦ) ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "रैनराजनी आदि कहिजै ॥",
      "sourceLineId": "108539",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਭਣਿਜੈ ॥",
      "transliteration": "jaa char keh pat sabadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति सबद भणिजै ॥",
      "sourceLineId": "108540",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਾ ਕੇ ਅੰਤਿ ਸਤ੍ਰੁ ਪਦ ਕਹੀਐ ॥",
      "transliteration": "taa ke a(n)t satr padh kaheeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਸਤ੍ਰੁ' ਪਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "ता के अंति सत्रु पद कहीऐ ॥",
      "sourceLineId": "108541",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਜੀਅ ਲਹੀਐ ॥੯੪੬॥",
      "transliteration": "naam tupak ke sabh jeea laheeaai ||946||",
      "translation": "Saying the word “Rain-raajani” and then utter the words “Jaachar-pati-shatru” and know all the names of Tupak.946.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੯੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ जीअ लहीऐ ॥९४६॥",
      "sourceLineId": "108542",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਿਸ ਨਾਇਕਨਿਨਿ ਆਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "nis naikanin aadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਨਿਸ ਨਾਇਕਨਿਨਿ' (ਸ਼ਬਦ) ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "निस नाइकनिनि आदि उचरीऐ ॥",
      "sourceLineId": "108543",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੂਨ ਉਚਰਿ ਚਰ ਪਤਿ ਪਦ ਡਰੀਐ ॥",
      "transliteration": "soon uchar char pat padh ddareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸੂਨ' (ਪੁੱਤਰ) ਸ਼ਬਦ ਉਚਾਰ ਕੇ 'ਚਰ ਪਤਿ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सून उचरि चर पति पद डरीऐ ॥",
      "sourceLineId": "108544",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਰਿ ਪਦ ਤਾ ਕੇ ਅੰਤਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "ar padh taa ke a(n)t bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "अरि पद ता के अंति बखानहु ॥",
      "sourceLineId": "108545",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪ੍ਰਮਾਨਹੁ ॥੯੪੭॥",
      "transliteration": "sakal tupak ke naam pramaanahu ||947||",
      "translation": "Saying the word “Nishi-nayaknani”, add the words “Shunya-char-pati”, then also “ari” and know all the names of Tupak.947.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੯੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम प्रमानहु ॥९४७॥",
      "sourceLineId": "108546",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਿਸਿਇਸਨੀ ਸਬਦਾਦਿ ਬਖਾਨੋ ॥",
      "transliteration": "nisiisanee sabadhaadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਨਿਸਿਇਸਨੀ' (ਚੰਦ੍ਰਮਾ ਨਾਮ ਵਾਲੀ ਨਦੀ) ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "निसिइसनी सबदादि बखानो ॥",
      "sourceLineId": "108547",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਠਾਨੋ ॥",
      "transliteration": "jaa char keh naik padh Thaano ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि नाइक पद ठानो ॥",
      "sourceLineId": "108548",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕਹੁ ਬਹੁਰਿ ਉਚਾਰਹੁ ॥",
      "transliteration": "satr sabadh kahu bahur uchaarahu ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਨੂੰ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद कहु बहुरि उचारहु ॥",
      "sourceLineId": "108549",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੁਕਬਿ ਤੁਪਕ ਕੇ ਨਾਮ ਬਿਚਾਰਹੁ ॥੯੪੮॥",
      "transliteration": "sukab tupak ke naam bichaarahu ||948||",
      "translation": "Saying the word “Nishi-Ishani”, add the words “Jaachar-nayak-shatru” and know the names of Tupak.948.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਕਵੀ ਜਨ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝਣ ॥੯੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सुकबि तुपक के नाम बिचारहु ॥९४८॥",
      "sourceLineId": "108550",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਿਸਿ ਪਤਿਨਿਨਿ ਸਬਦਾਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "nis patinin sabadhaadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਨਿਸਿ ਪਤਿਨਿਨਿ' ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "निसि पतिनिनि सबदादि उचरीऐ ॥",
      "sourceLineId": "108551",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੁਤ ਚਰ ਅਰਿ ਅੰਤਹਿ ਪਦ ਧਰੀਐ ॥",
      "transliteration": "sut char ar a(n)teh padh dhareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਤ ਉਤੇ 'ਸੁਤ ਚਰ ਅਰਿ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सुत चर अरि अंतहि पद धरीऐ ॥",
      "sourceLineId": "108552",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕਹੁ ਅੰਤਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "satr sabadh kahu a(n)t bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद कहु अंति बखानहु ॥",
      "sourceLineId": "108553",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੁਕਬਿ ਤੁਪਕ ਕੇ ਨਾਮ ਪਛਾਨਹੁ ॥੯੪੯॥",
      "transliteration": "sukab tupak ke naam pachhaanahu ||949||",
      "translation": "Saying firstly the word “Nishi-patnani”, add the words “Sat-char-ari-shatru” at the end know the names of Tupak.949.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਕਵੀ ਜਨੋ, ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੯੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सुकबि तुपक के नाम पछानहु ॥९४९॥",
      "sourceLineId": "108554",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਿਸ ਧਨਿਨੀ ਸਬਦਾਦਿ ਕਹਿਜੈ ॥",
      "transliteration": "nis dhaninee sabadhaadh kahijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਨਿਸ ਧਨਿਨੀ' (ਰਾਤ ਦੇ ਸੁਆਮੀ ਚੰਦ੍ਰਮਾ ਨਾਲ ਸੰਬੰਧਿਤ) ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "निस धनिनी सबदादि कहिजै ॥",
      "sourceLineId": "108555",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਅਰਿ ਪਦਹਿ ਭਣਿਜੈ ॥",
      "transliteration": "jaa char keh ar padheh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਅਰਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि अरि पदहि भणिजै ॥",
      "sourceLineId": "108556",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕਹੁ ਬਹੁਰਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "satr sabadh kahu bahur bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਨੂੰ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद कहु बहुरि बखानहु ॥",
      "sourceLineId": "108557",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਜੀਅ ਜਾਨਹੁ ॥੯੫੦॥",
      "transliteration": "naam tupak ke sabh jeea jaanahu ||950||",
      "translation": "Saying firstly the word “Nishi-shanani”, add the words “Jaachar, ari and shatru” and know the names of Tupak in your mind.950.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਆਪਣੇ ਮਨ ਵਿਚ ਤੁਪਕ ਦਾ ਨਾਮ ਜਾਣੋ ॥੯੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ जीअ जानहु ॥९५०॥",
      "sourceLineId": "108558",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰੈਨ ਨਾਇਕਨਿ ਆਦਿ ਸੁ ਕਹੀਐ ॥",
      "transliteration": "rain naikan aadh su kaheeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਰੈਨ ਨਾਇਕਨਿ' ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "रैन नाइकनि आदि सु कहीऐ ॥",
      "sourceLineId": "108559",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਪਦ ਦੈ ਰਹੀਐ ॥",
      "transliteration": "jaa char keh pat padh dhai raheeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति पद दै रहीऐ ॥",
      "sourceLineId": "108560",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਾ ਕੇ ਅੰਤਿ ਸਤ੍ਰੁ ਪਦ ਭਾਖਹੁ ॥",
      "transliteration": "taa ke a(n)t satr padh bhaakhahu ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਵਿਚ 'ਸਤ੍ਰੁ' ਪਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "ता के अंति सत्रु पद भाखहु ॥",
      "sourceLineId": "108561",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਲਖਿ ਰਾਖਹੁ ॥੯੫੧॥",
      "transliteration": "naam tupak ke sabh lakh raakhahu ||951||",
      "translation": "Saying firstly the word “Rain-nayakni”, add the words “Jaachar-pati-shatru” and know the names of Tupak.951.",
      "punjabiViakhya": "(ਇਸ) ਨੂੰ ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ ॥੯੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ लखि राखहु ॥९५१॥",
      "sourceLineId": "108562",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਿਸ ਚਰਨਿਨਿ ਪ੍ਰਥਮੈ ਪਦ ਭਾਖਹੁ ॥",
      "transliteration": "nis charanin prathamai padh bhaakhahu ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਨਿਸ ਚਰਨਿਨਿ' (ਰਾਤ ਨੂੰ ਫਿਰਨ ਵਾਲੇ ਚੰਦ੍ਰਮਾ ਨਾਲ ਸੰਬੰਧਿਤ) ਪਦ ਨੂੰ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "निस चरनिनि प्रथमै पद भाखहु ॥",
      "sourceLineId": "108563",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੁਤ ਚਰ ਕਹਿ ਨਾਇਕ ਪੁਨਿ ਰਾਖਹੁ ॥",
      "transliteration": "sut char keh naik pun raakhahu ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸੁਤ ਚਰ ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सुत चर कहि नाइक पुनि राखहु ॥",
      "sourceLineId": "108564",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕਹੁ ਬਹੁਰਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "satr sabadh kahu bahur bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਹਿ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद कहु बहुरि बखानहु ॥",
      "sourceLineId": "108565",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪਛਾਨਹੁ ॥੯੫੨॥",
      "transliteration": "sakal tupak ke naam pachhaanahu ||952||",
      "translation": "Saying firstly the word “Nishi-charnan”, add the words “Satchar-nayak-shatru” and recognize the names of Tupak.952.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੯੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम पछानहु ॥९५२॥",
      "sourceLineId": "108566",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਆਦਿ ਨਿਸਾਚਰਿਨਨਿ ਕਹੁ ਭਾਖੋ ॥",
      "transliteration": "aadh nisaacharinan kahu bhaakho ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਨਿਸਾਚਰਿਨਨਿ' (ਰਾਤ ਨੂੰ ਚਲਣ ਵਾਲੇ ਚੰਦ੍ਰਮਾ ਨਾਲ ਸੰਬੰਧਿਤ) (ਸ਼ਬਦ) ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "आदि निसाचरिननि कहु भाखो ॥",
      "sourceLineId": "108567",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੁਤ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਰਾਖੋ ॥",
      "transliteration": "sut char keh naik padh raakho ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਸੁਤ ਚਰ ਨਾਇਕ' ਪਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सुत चर कहि नाइक पद राखो ॥",
      "sourceLineId": "108568",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕਹੁ ਬਹੁਰਿ ਭਣਿਜੈ ॥",
      "transliteration": "satr sabadh kahu bahur bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद कहु बहुरि भणिजै ॥",
      "sourceLineId": "108569",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਕਹਿਜੈ ॥੯੫੩॥",
      "transliteration": "sakal tupak ke naam kahijai ||953||",
      "translation": "Saying the word “Nishaa-charnan”, add the words “Satchar-nayak-shatru” and know all then the names of Tupak.953.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਕਹੋ ॥੯੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम कहिजै ॥९५३॥",
      "sourceLineId": "108570",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਰੈਨ ਰਮਨਿ ਸਬਦਾਦਿ ਭਣਿਜੈ ॥",
      "transliteration": "rain raman sabadhaadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਰੈਨ ਰਮਨਿ' ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "रैन रमनि सबदादि भणिजै ॥",
      "sourceLineId": "108571",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੁਤ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਕਹਿਜੈ ॥",
      "transliteration": "sut char keh pat sabadh kahijai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਸੁਤ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सुत चर कहि पति सबद कहिजै ॥",
      "sourceLineId": "108572",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਅੰਤਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "satr sabadh ko a(n)t bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਤ ਵਿਚ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को अंति बखानहु ॥",
      "sourceLineId": "108573",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪ੍ਰਮਾਨਹੁ ॥੯੫੪॥",
      "transliteration": "sakal tupak ke naam pramaanahu ||954||",
      "translation": "Saying firstly the word “Rain-raman”, add the words “Satchar-pati-shatru” and know all the names of Tupak.954.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਪਛਾਣੋ ॥੯੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम प्रमानहु ॥९५४॥",
      "sourceLineId": "108574",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਰੈਨ ਰਾਜਨਿਨਿ ਪ੍ਰਥਮ ਉਚਾਰੋ ॥",
      "transliteration": "rain raajanin pratham uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਰੈਨ ਰਾਜਨਿਨਿ' (ਸ਼ਬਦ) ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "रैन राजनिनि प्रथम उचारो ॥",
      "sourceLineId": "108575",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੁਤ ਚਰ ਕਹਿ ਪਤਿ ਪਦਹਿ ਸਵਾਰੋ ॥",
      "transliteration": "sut char keh pat padheh savaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਸੁਤ ਚਰ ਪਤਿ' ਪਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सुत चर कहि पति पदहि सवारो ॥",
      "sourceLineId": "108576",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਾ ਕੇ ਅੰਤਿ ਸਤ੍ਰੁ ਪਦ ਕਹੀਐ ॥",
      "transliteration": "taa ke a(n)t satr padh kaheeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਸਤ੍ਰੁ' ਪਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "ता के अंति सत्रु पद कहीऐ ॥",
      "sourceLineId": "108577",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਹੀ ਲਹੀਐ ॥੯੫੫॥",
      "transliteration": "naam tupak ke sabh hee laheeaai ||955||",
      "translation": "Saying firstly the word “Rain-raajnan”, add the words “Satchar, Pati and Shatru” and in this way know all the names of Tupak.955.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਹੀ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੯੫੫॥",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ ही लहीऐ ॥९५५॥",
      "sourceLineId": "108578",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਿਸਾਰਵਨਿਨਿ ਆਦਿ ਭਣਿਜੈ ॥",
      "transliteration": "nisaaravanin aadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਨਿਸਾਰਵਨਿਨਿ' (ਰਾਤ ਨੂੰ ਰਮਣ ਕਰਨ ਵਾਲੇ ਚੰਦ੍ਰਮਾ ਨਾਲ ਸੰਬੰਧਿਤ) (ਸ਼ਬਦ) ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "निसारवनिनि आदि भणिजै ॥",
      "sourceLineId": "108579",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੁਤ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਧਰਿਜੈ ॥",
      "transliteration": "sut char keh pat sabadh dharijai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਸੁਤ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सुत चर कहि पति सबद धरिजै ॥",
      "sourceLineId": "108580",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਤਾ ਪਾਛੇ ਕਹੀਐ ॥",
      "transliteration": "satr sabadh taa paachhe kaheeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਿਛੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद ता पाछे कहीऐ ॥",
      "sourceLineId": "108581",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਕੇ ਲਹੀਐ ॥੯੫੬॥",
      "transliteration": "sabh sree naam tupak ke laheeaai ||956||",
      "translation": "Saying firstly the word “Nishaa-ramanin” utter the words “Satchar-pati-shatru” and know all the names of Tupak.956.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੯੫੬॥",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक के लहीऐ ॥९५६॥",
      "sourceLineId": "108582",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਦਿਨ ਅਰਿ ਰਵਨਿਨਿ ਆਦਿ ਉਚਾਰੋ ॥",
      "transliteration": "dhin ar ravanin aadh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਦਿਨ ਅਰਿ ਰਵਨਿਨਿ' (ਸ਼ਬਦ) ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "दिन अरि रवनिनि आदि उचारो ॥",
      "sourceLineId": "108583",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੁਤ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਬਿਚਾਰੋ ॥",
      "transliteration": "sut char keh pat sabadh bichaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਸੁਤ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਵਿਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "सुत चर कहि पति सबद बिचारो ॥",
      "sourceLineId": "108584",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਾ ਕੇ ਅੰਤਿ ਸਤ੍ਰੁ ਪਦ ਭਾਖੋ ॥",
      "transliteration": "taa ke a(n)t satr padh bhaakho ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਸਤ੍ਰੁ' ਪਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 774,
      "hindi": "",
      "hindiTransliteration": "ता के अंति सत्रु पद भाखो ॥",
      "sourceLineId": "108585",
      "sourceShabadId": "9571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0774_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਜੂ ਕੇ ਲਖਿ ਰਾਖੋ ॥੯੫੭॥",
      "transliteration": "naam tupak joo ke lakh raakho ||957||",
      "translation": "Saying firstly the word “Din-ari-ramnan”, add the words “Satchar-pati-shatru” and know the names of Tupak.957.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਜੀ ਦਾ ਨਾਮ ਸਮਝੋ ॥੯੫੭॥",
      "source": "DASAM_GRANTH",
