      "ang": 776,
      "hindi": "",
      "hindiTransliteration": "निस इस भगनी आदि बखानहु ॥",
      "sourceLineId": "108641",
      "sourceShabadId": "9573",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0776_line_0008",
