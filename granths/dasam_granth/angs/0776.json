    {
      "id": "dasam_ang_0776_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕਹੁ ਬਹੁਰਿ ਭਣਿਜੈ ॥",
      "transliteration": "satr sabadh kahu bahur bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਨੂੰ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 776,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद कहु बहुरि भणिजै ॥",
      "sourceLineId": "108635",
      "sourceShabadId": "9573",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0776_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਪਤਿਜੈ ॥੯੬੯॥",
      "transliteration": "naam tupak ke sakal patijai ||969||",
      "translation": "Saying firstly the word “Chandrayonini”, utter the words “Jaachar-nayak-shatru” and know the names of Tupak.969.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦੇ ਨਾਮ ਸਮਝੋ ॥੯੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 776,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल पतिजै ॥९६९॥",
      "sourceLineId": "108636",
      "sourceShabadId": "9573",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0776_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਸਿ ਉਪਸਖਿਨੀ ਆਦਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "sas upasakhinee aadh bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸਸਿ ਉਪਸਖਿਨੀ' (ਚੰਨ੍ਰਹਾ ਨਦੀ) ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 776,
      "hindi": "",
      "hindiTransliteration": "ससि उपसखिनी आदि बखानहु ॥",
      "sourceLineId": "108637",
      "sourceShabadId": "9573",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0776_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਪ੍ਰਮਾਨਹੁ ॥",
      "transliteration": "jaa char keh pat sabadh pramaanahu ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 776,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति सबद प्रमानहु ॥",
      "sourceLineId": "108638",
      "sourceShabadId": "9573",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0776_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਬਖਾਨੋ ॥",
      "transliteration": "satr sabadh ko bahur bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 776,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि बखानो ॥",
      "sourceLineId": "108639",
      "sourceShabadId": "9573",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0776_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਕੇ ਜਾਨੋ ॥੯੭੦॥",
      "transliteration": "sabh sree naam tupak ke jaano ||970||",
      "translation": "Saying firstly the word “Shashi-up-Sakhani”, add the words “Jaachar-pati-shatru” and know all the names of Tupak.970.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੯੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 776,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक के जानो ॥९७०॥",
      "sourceLineId": "108640",
      "sourceShabadId": "9573",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0776_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਿਸ ਇਸ ਭਗਨੀ ਆਦਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "nis is bhaganee aadh bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਨਿਸ ਇਸ ਭਗਨੀ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
