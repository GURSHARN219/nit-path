      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮ੍ਰਿਗ ਨਾਥ ਭਗਣਣਿ ਭਾਖੁ ॥",
      "transliteration": "mirag naath bhaganan bhaakh ||",
      "translation": "",
      "punjabiViakhya": "(ਪਹਿਲਾ) 'ਮ੍ਰਿਗ ਨਾਥ ਭਗਣਣਿ' ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "मृग नाथ भगणणि भाखु ॥",
