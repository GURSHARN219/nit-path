      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਤਿਹ ਅੰਤਿ ਉਚਾਰੋ ॥",
      "transliteration": "satr sabadh teh a(n)t uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਪਰ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद तिह अंति उचारो ॥",
