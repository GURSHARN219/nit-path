  "lines": [
    {
      "id": "dasam_ang_0777_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਉਨ ਕਰਣ ਕਹਿ ਭਗਣਿ ਬਖਾਨੋ ॥",
      "transliteration": "jaun karan keh bhagan bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਜਉਨ (ਚਾਦਨੀ) ਕਰਣ ਭਗਣਿ' (ਸ਼ਬਦ) ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "जउन करण कहि भगणि बखानो ॥",
      "sourceLineId": "108683",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਠਾਨੋ ॥",
      "transliteration": "jaa char keh naik padh Thaano ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि नाइक पद ठानो ॥",
      "sourceLineId": "108684",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਭਣਿਜੈ ॥",
      "transliteration": "satr sabadh ko bahur bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि भणिजै ॥",
      "sourceLineId": "108685",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਲਹਿ ਲੀਜੈ ॥੯੮੧॥",
      "transliteration": "naam tupak ke sabh leh leejai ||981||",
      "translation": "Saying “Jaunkaran”, utter the word “Bhagan”, then add the words “Jaachar-nayak-shatru” and know the names of Tupak.981.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੯੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ लहि लीजै ॥९८१॥",
      "sourceLineId": "108686",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਿਰਣ ਧਰਣ ਕਹਿ ਭਗਣਿ ਕਹੀਜੈ ॥",
      "transliteration": "kiran dharan keh bhagan kaheejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਕਿਰਣ ਧਰਣ ਭਗਣਿ' ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "किरण धरण कहि भगणि कहीजै ॥",
      "sourceLineId": "108687",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੁਤ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਧਰੀਜੈ ॥",
      "transliteration": "sut char keh pat sabadh dhareejai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਸੁਤ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "सुत चर कहि पति सबद धरीजै ॥",
      "sourceLineId": "108688",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕਹੁ ਬਹੁਰਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "satr sabadh kahu bahur bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद कहु बहुरि बखानहु ॥",
      "sourceLineId": "108689",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਅਨੁਮਾਨਹੁ ॥੯੮੨॥",
      "transliteration": "naam tupak ke sabh anumaanahu ||982||",
      "translation": "Saying the word “Kirandharan”, then speak the word “Bhagini”, then utter the words “Satchar-pati-shatru” and determine all the names of Tupak.982.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੯੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ अनुमानहु ॥९८२॥",
      "sourceLineId": "108690",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਯੰਕ ਸਬਦ ਕਹਿ ਭਗਣਿ ਭਣਿਜੈ ॥",
      "transliteration": "maya(n)k sabadh keh bhagan bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਮਯੰਕ (ਚੰਦ੍ਰਮਾ) ਭਗਣਿ' ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "मयंक सबद कहि भगणि भणिजै ॥",
      "sourceLineId": "108691",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਤੁ ਚਰ ਕਹਿ ਪਦ ਨਾਥ ਧਰਿਜੈ ॥",
      "transliteration": "sat char keh padh naath dharijai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਸੁਤ ਚਰ ਨਾਥ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "सतु चर कहि पद नाथ धरिजै ॥",
      "sourceLineId": "108692",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਉਚਰੀਐ ॥",
      "transliteration": "satr sabadh ko bahur uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि उचरीऐ ॥",
      "sourceLineId": "108693",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਸੁ ਧਰੀਐ ॥੯੮੩॥",
      "transliteration": "naam tupak ke sakal su dhareeaai ||983||",
      "translation": "Saying the word “Mayank”, speak the word “Bhagini”, then utter the words “Satchar-naath-shatru” and know correctly all the names of Tupak.983.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਧਰ ਦਿਓ ॥੯੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल सु धरीऐ ॥९८३॥",
      "sourceLineId": "108694",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮ੍ਰਿਗ ਬਾਹਨਿ ਕਹਿ ਭਗਣਿ ਬਖਾਨੋ ॥",
      "transliteration": "mirag baahan keh bhagan bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਮ੍ਰਿਗ ਬਾਹਨਿ (ਚੰਦ੍ਰਮਾ) ਭਗਣਿ' ਦਾ ਬਖਾਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "मृग बाहनि कहि भगणि बखानो ॥",
      "sourceLineId": "108695",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੁਤ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਪ੍ਰਮਾਨੋ ॥",
      "transliteration": "sut char keh pat sabadh pramaano ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਸੁਤ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "सुत चर कहि पति सबद प्रमानो ॥",
      "sourceLineId": "108696",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਤਿਹ ਅੰਤਿ ਉਚਾਰਹੁ ॥",
      "transliteration": "satr sabadh teh a(n)t uchaarahu ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद तिह अंति उचारहु ॥",
      "sourceLineId": "108697",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਚਿਤਿ ਧਾਰਹੁ ॥੯੮੪॥",
      "transliteration": "sabh sree naam tupak chit dhaarahu ||984||",
      "translation": "Saying the word “Mrig-vahan” and then “Bhagini”, then utter the words “Satchar-pati-shatru” and adopt all the names of Tupak in your mind.984.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਚਿਤ ਵਿਚ ਧਾਰਨ ਕਰੋ ॥੯੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक चिति धारहु ॥९८४॥",
      "sourceLineId": "108698",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਿਰਣ ਰਾਟ ਕਹਿ ਭਗਣਿ ਉਚਾਰਹੁ ॥",
      "transliteration": "hiran raaT keh bhagan uchaarahu ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਹਿਰਣ ਰਾਟ ਭਗਣਿ' (ਸ਼ਬਦ) ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "हिरण राट कहि भगणि उचारहु ॥",
      "sourceLineId": "108699",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੁਤ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਡਾਰਹੁ ॥",
      "transliteration": "sut char keh naik padh ddaarahu ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਸੁਤ ਚਰ ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "सुत चर कहि नाइक पद डारहु ॥",
      "sourceLineId": "108700",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਭਣਿਜੈ ॥",
      "transliteration": "satr sabadh ko bahur bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਨੂੰ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि भणिजै ॥",
      "sourceLineId": "108701",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਲਹਿਜੈ ॥੯੮੫॥",
      "transliteration": "naam tupak ke sakal lahijai ||985||",
      "translation": "Saying “hiran-raat”, utter the word “Bhagini”, then speak the words “Satchar-nayak-shatru” and in this way know all the names of Tupak.985.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੯੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल लहिजै ॥९८५॥",
      "sourceLineId": "108702",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸ੍ਰਿੰਗ ਬਾਹਣੀ ਭਗਾ ਭਣਿਜੈ ॥",
      "transliteration": "sira(n)g baahanee bhagaa bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸ੍ਰਿੰਗ ਬਾਹਣੀ (ਚੰਦ੍ਰ) ਭਗਾ' ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "सृंग बाहणी भगा भणिजै ॥",
      "sourceLineId": "108703",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਧਰਿਜੈ ॥",
      "transliteration": "jaa char keh pat sabadh dharijai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਜਾ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਨੂੰ ਧਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति सबद धरिजै ॥",
      "sourceLineId": "108704",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "satr sabadh ko bahur bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि बखानहु ॥",
      "sourceLineId": "108705",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਕੇ ਜਾਨਹੁ ॥੯੮੬॥",
      "transliteration": "sabh sree naam tupak ke jaanahu ||986||",
      "translation": "Saying “Shrang-vahani-bhagga”, add the words “Jaachar-pati-shatru” and know all the names of Tupak.986.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੯੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक के जानहु ॥९८६॥",
      "sourceLineId": "108706",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮ੍ਰਿਗ ਪਤਿਣੀ ਕਹਿ ਭਗਣਿ ਭਣਿਜੈ ॥",
      "transliteration": "mirag patinee keh bhagan bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਮ੍ਰਿਗ ਪਤਿਣੀ ਭਗਣਿ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "मृग पतिणी कहि भगणि भणिजै ॥",
      "sourceLineId": "108707",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਾ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਧਰਿਜੈ ॥",
      "transliteration": "jaa char keh pat sabadh dharijai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਜਾ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "जा चर कहि पति सबद धरिजै ॥",
      "sourceLineId": "108708",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "satr sabadh ko bahur bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਬਖਾਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि बखानहु ॥",
      "sourceLineId": "108709",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪ੍ਰਮਾਨਹੁ ॥੯੮੭॥",
      "transliteration": "sakal tupak ke naam pramaanahu ||987||",
      "translation": "Saying “Mrig-patini”, then speak the word “Bhagini” then utter the words “Jaachar-pati-shatru” and know all the names of Tupak.987.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੯੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम प्रमानहु ॥९८७॥",
      "sourceLineId": "108710",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪ੍ਰਜਾਪਤਿ ਕਹਿ ਭਗਣਿ ਭਣਿਜੈ ॥",
      "transliteration": "prajaapat keh bhagan bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਪ੍ਰਜਾ ਪਤਿ (ਚੰਦ੍ਰਮਾ) ਭਗਣਿ' ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "प्रजापति कहि भगणि भणिजै ॥",
      "sourceLineId": "108711",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੁਤ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਧਰਿਜੈ ॥",
      "transliteration": "sut char keh pat sabadh dharijai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਸੁਤ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "सुत चर कहि पति सबद धरिजै ॥",
      "sourceLineId": "108712",
      "sourceShabadId": "9575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "satr sabadh ko bahur bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਦਾ ਬਖਾਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि बखानहु ॥",
      "sourceLineId": "108713",
