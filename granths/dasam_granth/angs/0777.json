      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪ੍ਰਮਾਨਹੁ ॥੯੮੮॥",
      "transliteration": "sakal tupak ke naam pramaanahu ||988||",
      "translation": "Saying “Prajaapati”, add “Bhagini” and then mentioning the words “satchar-pati-shatru” and know all the names of Tupak.988.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਵਿਚਾਰੋ ॥੯੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम प्रमानहु ॥९८८॥",
      "sourceLineId": "108714",
