      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰਿਪੁ ਸਬਦ ਬਹੁਰਿ ਬਖਾਨ ॥",
      "transliteration": "rip sabadh bahur bakhaan ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਰਿਪੁ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "रिपु सबद बहुरि बखान ॥",
      "sourceLineId": "108718",
      "sourceShabadId": "9576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਭ ਨਾਮ ਤੁਪਕ ਪ੍ਰਮਾਨ ॥੯੮੯॥",
      "transliteration": "sabh naam tupak pramaan ||989||",
      "translation": "Saying the words “Mrignaath bhaginini”, utter the words “Ripu-naath-char-pati-ripu” and in this way know all the names of Tupak.989.",
