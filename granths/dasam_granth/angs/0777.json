      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ जीअ धारो ॥९९१॥",
      "sourceLineId": "108728",
      "sourceShabadId": "9577",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਦੀ ਰਾਟ ਸੁਤ ਭਗਣਿ ਉਚਾਰੋ ॥",
      "transliteration": "nadhee raaT sut bhagan uchaaro ||",
