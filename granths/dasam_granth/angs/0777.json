      "source": "DASAM_GRANTH",
      "ang": 777,
      "hindi": "",
      "hindiTransliteration": "सभ नाम तुपक प्रमान ॥९८९॥",
      "sourceLineId": "108719",
      "sourceShabadId": "9576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0777_line_0038",
      "lineIndex": 38,
