    {
      "id": "dasam_ang_0779_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਪ੍ਰਮਾਨਹੁ ॥੧੦੦੯॥",
      "transliteration": "naam tupak ke sakal pramaanahu ||1009||",
      "translation": "Saying the word “Timir-yaant”, speak “Bhagnin”, then add the word “Satchar-nayak-shatru” at the end and in this way know all the names of Tupak.1009.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ॥੧੦੦੯॥",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल प्रमानहु ॥१००९॥",
