  "lines": [
    {
      "id": "dasam_ang_0779_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਿਮਰ ਨਾਸ ਕਰਿ ਭਗਣਨਿ ਭਾਖੋ ॥",
      "transliteration": "timar naas kar bhaganan bhaakho ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਤਿਮਰ ਨਾਸ ਕਰਿ ਭਗਣਨਿ' ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "तिमर नास करि भगणनि भाखो ॥",
      "sourceLineId": "108779",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0779_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੁਤ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਰਾਖੋ ॥",
      "transliteration": "sut char keh naik padh raakho ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਸੁਤ ਚਰ ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "सुत चर कहि नाइक पद राखो ॥",
      "sourceLineId": "108780",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0779_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "satr sabadh ko bahur bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਬਖਾਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि बखानहु ॥",
      "sourceLineId": "108781",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0779_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪ੍ਰਮਾਨਹੁ ॥੧੦੦੪॥",
      "transliteration": "sakal tupak ke naam pramaanahu ||1004||",
      "translation": "Saying the words “Timir-naashkar-bhagnani”, utter the words “Satchar-nayak-shatru” and know all the names of Tupak.1004.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦੇ ਨਾਮ ਸਮਝੋ ॥੧੦੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम प्रमानहु ॥१००४॥",
      "sourceLineId": "108782",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0779_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਿਮਰ ਰਦਨ ਭਗਣਨੀ ਬਖਾਨੋ ॥",
      "transliteration": "timar radhan bhagananee bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਤਿਮਰ ਰਦਨ (ਨਸ਼ਟ ਕਰਨ ਵਾਲਾ) ਭਗਣਨੀ' ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "तिमर रदन भगणनी बखानो ॥",
      "sourceLineId": "108783",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0779_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੁਤ ਚਰ ਕਹਿ ਨਾਇਕ ਪਦ ਠਾਨੋ ॥",
      "transliteration": "sut char keh naik padh Thaano ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਸੁਤ ਚਰ ਨਾਇਕ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "सुत चर कहि नाइक पद ठानो ॥",
      "sourceLineId": "108784",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0779_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕਹੁ ਬਹੁਰਿ ਭਣੀਜੈ ॥",
      "transliteration": "satr sabadh kahu bahur bhaneejai ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद कहु बहुरि भणीजै ॥",
      "sourceLineId": "108785",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0779_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਲਹਿ ਲੀਜੈ ॥੧੦੦੫॥",
      "transliteration": "naam tupak ke sabh leh leejai ||1005||",
      "translation": "Saying the words “Timir-radan-bhagnani”, utter the words “Satchar-nayak-shatru” and know all the names of Tupak.1005.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ ॥੧੦੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ लहि लीजै ॥१००५॥",
      "sourceLineId": "108786",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0779_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਿਮਰ ਉਚਰਿ ਹਾ ਭਗਣ ਬਖਾਨਹੁ ॥",
      "transliteration": "timar uchar haa bhagan bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਤਿਮਰ ਹਾ ਭਗਣਿ' (ਸ਼ਬਦ) ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "तिमर उचरि हा भगण बखानहु ॥",
      "sourceLineId": "108787",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0779_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੁਤ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਪ੍ਰਮਾਨਹੁ ॥",
      "transliteration": "sut char keh pat sabadh pramaanahu ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਸੁਤ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "सुत चर कहि पति सबद प्रमानहु ॥",
      "sourceLineId": "108788",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0779_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਤਿਹ ਅੰਤਿ ਭਣੀਜੈ ॥",
      "transliteration": "satr sabadh teh a(n)t bhaneejai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਸਤ੍ਰੁ' ਪਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद तिह अंति भणीजै ॥",
      "sourceLineId": "108789",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0779_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਲਹਿ ਲੀਜੈ ॥੧੦੦੬॥",
      "transliteration": "naam tupak ke sabh leh leejai ||1006||",
      "translation": "Saying “Rimir”, add the words “Haa-bhagani”, then add the words “Satchar-pati-shatru” and in this way know all the names of Tupak.1006.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ ॥੧੦੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ लहि लीजै ॥१००६॥",
      "sourceLineId": "108790",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0779_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਿਮਰ ਨਿਕੰਦਨਿ ਆਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "timar nika(n)dhan aadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਤਿਮਰ ਨਿਕੰਦਨਿ' (ਸ਼ਬਦ) ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "तिमर निकंदनि आदि उचरीऐ ॥",
      "sourceLineId": "108791",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0779_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਭਗਣਿਨਿ ਸੁਤ ਚਰ ਪੁਨਿ ਪਤਿ ਧਰੀਐ ॥",
      "transliteration": "bhaganin sut char pun pat dhareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਭਗਣਿਨਿ ਸੁਤ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "भगणिनि सुत चर पुनि पति धरीऐ ॥",
      "sourceLineId": "108792",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0779_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਤਿਹ ਅੰਤਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "satr sabadh teh a(n)t bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਸਤ੍ਰੁ' ਪਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद तिह अंति बखानहु ॥",
      "sourceLineId": "108793",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0779_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪ੍ਰਮਾਨਹੁ ॥੧੦੦੭॥",
      "transliteration": "sakal tupak ke naam pramaanahu ||1007||",
      "translation": "Saying the words “Timir-nikandan”, add the words “Bhagnin satchar” and then uttering the word “shatru”, know the names of Tupak.1007.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ ॥੧੦੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम प्रमानहु ॥१००७॥",
      "sourceLineId": "108794",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0779_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਿਮਰਮੰਦ ਭਗਣਿਨੀ ਭਣਿਜੈ ॥",
      "transliteration": "timarama(n)dh bhaganinee bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਤਿਮਰ ਮੰਦ (ਹਨੇਰੇ ਨੂੰ ਘਟਾਉਣ ਵਾਲਾ) ਭਗਣਿਨੀ' (ਸ਼ਬਦ) ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "तिमरमंद भगणिनी भणिजै ॥",
      "sourceLineId": "108795",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0779_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੁਤ ਚਰ ਕਹਿ ਪਤਿ ਸਬਦ ਧਰਿਜੈ ॥",
      "transliteration": "sut char keh pat sabadh dharijai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਸੁਤ ਚਰ ਪਤਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "सुत चर कहि पति सबद धरिजै ॥",
      "sourceLineId": "108796",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0779_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਤਿਹ ਅੰਤਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "satr sabadh teh a(n)t bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਵਿਚ 'ਸਤ੍ਰੁ' ਪਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद तिह अंति बखानहु ॥",
      "sourceLineId": "108797",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0779_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਅਨੁਮਾਨਹੁ ॥੧੦੦੮॥",
      "transliteration": "sakal tupak ke naam anumaanahu ||1008||",
      "translation": "Saying “Timir-mand-bhagnini”, add the words “Satchar-pati-shatru” and know all the names of Tupak.1008.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਅਨੁਮਾਨ ਕਰੋ ॥੧੦੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम अनुमानहु ॥१००८॥",
      "sourceLineId": "108798",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0779_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਿਮਰਯਾਤ ਕਹਿ ਭਗਣਿਨਿ ਭਾਖੋ ॥",
      "transliteration": "timarayaat keh bhaganin bhaakho ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਤਿਮਰਯਾਤ ਭਗਣਿਨਿ' ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "तिमरयात कहि भगणिनि भाखो ॥",
      "sourceLineId": "108799",
      "sourceShabadId": "9579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
