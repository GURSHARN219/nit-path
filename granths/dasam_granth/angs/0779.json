      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਤਿਹ ਅੰਤਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "satr sabadh teh a(n)t bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਵਿਚ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਬਖਾਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 779,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद तिह अंति बखानहु ॥",
