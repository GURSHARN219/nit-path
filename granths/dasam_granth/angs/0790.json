  "lines": [
    {
      "id": "dasam_ang_0790_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਦਿ ਧਨੁਖਨੀ ਸਬਦ ਉਚਾਰਨ ਕੀਜੀਐ ॥",
      "transliteration": "aadh dhanukhanee sabadh uchaaran keejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਧਨੁਖਨੀ' ਸ਼ਬਦ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "आदि धनुखनी सबद उचारन कीजीऐ ॥",
      "sourceLineId": "109259",
      "sourceShabadId": "9611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਅੰਤਿ ਤਵਨ ਕੇ ਦੀਜੀਐ ॥",
      "transliteration": "satr sabadh ko a(n)t tavan ke dheejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को अंति तवन के दीजीऐ ॥",
      "sourceLineId": "109260",
      "sourceShabadId": "9611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਚਤੁਰ ਜੀਅ ਜਾਨੀਐ ॥",
      "transliteration": "sakal tupak ke naam chatur jeea jaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਾਰੇ ਚਤੁਰ ਲੋਗ ਮਨ ਵਿਚ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝਣ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम चतुर जीअ जानीऐ ॥",
      "sourceLineId": "109261",
      "sourceShabadId": "9611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹੋ ਯਾ ਕੇ ਭੀਤਰ ਭੇਦ ਨ ਨੈਕੁ ਪ੍ਰਮਾਨੀਐ ॥੧੧੨੩॥",
      "transliteration": "ho yaa ke bheetar bhedh na naik pramaaneeaai ||1123||",
      "translation": "Saying the word “Dhanushani”, add the word “Shatru” and know all the names of Tupak without any discrimination.1123.",
      "punjabiViakhya": "ਇਸ ਵਿਚ ਬਿਲਕੁਲ ਕੋਈ ਭੇਦ ਨਾ ਸੋਚਣ ॥੧੧੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "हो या के भीतर भेद न नैकु प्रमानीऐ ॥११२३॥",
      "sourceLineId": "109262",
      "sourceShabadId": "9611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕੋਵੰਡਨੀ ਸਬਦ ਕੋ ਆਦਿ ਉਚਾਰੀਐ ॥",
      "transliteration": "kova(n)ddanee sabadh ko aadh uchaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਕੋਵੰਡਨੀ' (ਧਨੁਸ਼ਧਾਰੀ ਸੈਨਾ) ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "कोवंडनी सबद को आदि उचारीऐ ॥",
      "sourceLineId": "109263",
      "sourceShabadId": "9611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਰਿਣੀ ਤਾ ਕੇ ਅੰਤਿ ਸਬਦ ਕੋ ਡਾਰੀਐ ॥",
      "transliteration": "arinee taa ke a(n)t sabadh ko ddaareeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "अरिणी ता के अंति सबद को डारीऐ ॥",
      "sourceLineId": "109264",
      "sourceShabadId": "9611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੋ ਨਾਮ ਜਾਨ ਜੀਅ ਲੀਜੀਐ ॥",
      "transliteration": "sakal tupak ko naam jaan jeea leejeeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਮਨ ਵਿਚ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक को नाम जान जीअ लीजीऐ ॥",
      "sourceLineId": "109265",
      "sourceShabadId": "9611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹੋ ਜਹਾ ਸਬਦ ਏ ਚਹੋ ਤਹੀ ਤੇ ਦੀਜੀਐ ॥੧੧੨੪॥",
      "transliteration": "ho jahaa sabadh e chaho tahee te dheejeeaai ||1124||",
      "translation": "Saying the word “Kovandani”, add the word “Arini” at the end and know all the names of Tupak.1124.",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਥੇ ਲੋੜ ਸਮਝੋ, ਇਹ ਸ਼ਬਦ ਵਰਤ ਲਵੋ ॥੧੧੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "हो जहा सबद ए चहो तही ते दीजीऐ ॥११२४॥",
      "sourceLineId": "109266",
      "sourceShabadId": "9611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "109267",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਖੁਆਸਨੀ ਪਦਾਦਿ ਭਨੀਜੈ ॥",
      "transliteration": "eikhuaasanee padhaadh bhaneejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਇਖੁਆਸਨੀ' (ਧਨੁਸ਼ਧਾਰੀ ਸੈਨਾ) ਪਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "इखुआसनी पदादि भनीजै ॥",
      "sourceLineId": "109268",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਰਿਣੀ ਅੰਤਿ ਸਬਦ ਤਿਹ ਦੀਜੈ ॥",
      "transliteration": "arinee a(n)t sabadh teh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਇਸ ਦੇ ਅੰਤ ਉਤੇ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "अरिणी अंति सबद तिह दीजै ॥",
      "sourceLineId": "109269",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਲਹਿਜਹਿ ॥",
      "transliteration": "sakal tupak ke naam lahijeh ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम लहिजहि ॥",
      "sourceLineId": "109270",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਹ ਚਾਹੋ ਤਿਹ ਠਵਰ ਭਣਿਜਹਿ ॥੧੧੨੫॥",
      "transliteration": "jeh chaaho teh Thavar bhanijeh ||1125||",
      "translation": "Saying word “Ikshu (arrow) aasani” and adding the word “arini” at the end, know all the names of Tupak and use them according to your need.1125.",
      "punjabiViakhya": "ਜਿਥੇ ਚਾਹੋ, ਉਥੇ ਇਸ ਦੀ ਵਰਤੋਂ ਕਰੋ ॥੧੧੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "जह चाहो तिह ठवर भणिजहि ॥११२५॥",
      "sourceLineId": "109271",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਾਰਮੁਕਨੀ ਸਬਦਾਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "kaaramukanee sabadhaadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਕਾਰਮੁਕਨੀ' (ਬਾਸ ਦੇ ਬਣੇ ਧਨੁਸ਼ ਵਾਲੀ ਸੈਨਾ) ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "कारमुकनी सबदादि उचरीऐ ॥",
      "sourceLineId": "109272",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਰਿਣੀ ਸਬਦ ਅੰਤਿ ਤਿਹ ਧਰੀਐ ॥",
      "transliteration": "arinee sabadh a(n)t teh dhareeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਸ ਦੇ ਅੰਤ ਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "अरिणी सबद अंति तिह धरीऐ ॥",
      "sourceLineId": "109273",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪਛਾਨੋ ॥",
      "transliteration": "sakal tupak ke naam pachhaano ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम पछानो ॥",
      "sourceLineId": "109274",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਹ ਚਾਹੋ ਤਿਹ ਠਵਰ ਬਖਾਨੋ ॥੧੧੨੬॥",
      "transliteration": "jeh chaaho teh Thavar bakhaano ||1126||",
      "translation": "Saying firstly the word “Kaarmukani”, add the word “arini” at the end and recognize all the names of Tupak.1126.",
      "punjabiViakhya": "ਜਿਥੇ ਚਾਹੋ, ਉਥੇ ਕਥਨ ਕਰੋ ॥੧੧੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "जह चाहो तिह ठवर बखानो ॥११२६॥",
      "sourceLineId": "109275",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰਿਪੁ ਸੰਤਾਪਨਿ ਆਦਿ ਬਖਾਨੋ ॥",
      "transliteration": "rip sa(n)taapan aadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਰਿਪੁ ਸੰਤਾਪਨਿ' (ਸ਼ਬਦ) ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "रिपु संतापनि आदि बखानो ॥",
      "sourceLineId": "109276",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਰਿਣੀ ਸਬਦ ਅੰਤਿ ਤਿਹ ਠਾਨੋ ॥",
      "transliteration": "arinee sabadh a(n)t teh Thaano ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "अरिणी सबद अंति तिह ठानो ॥",
      "sourceLineId": "109277",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਲਹੀਜੈ ॥",
      "transliteration": "sakal tupak ke naam laheejai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦੇ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम लहीजै ॥",
      "sourceLineId": "109278",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਯਾ ਮੈ ਭੇਦ ਨੈਕੁ ਨਹੀ ਕੀਜੈ ॥੧੧੨੭॥",
      "transliteration": "yaa mai bhedh naik nahee keejai ||1127||",
      "translation": "Saying firstly the word “Ripusntaapini”, add the word “arini” at the end and know all the names of Tupak without any discrimination.1127.",
      "punjabiViakhya": "ਇਸ ਵਿਚ ਕੋਈ ਭੇਦ ਨਾ ਸਮਝੋ ॥੧੧੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "या मै भेद नैकु नही कीजै ॥११२७॥",
      "sourceLineId": "109279",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰਿਪੁ ਖੰਡਣਨੀ ਆਦਿ ਭਣਿਜੈ ॥",
      "transliteration": "rip kha(n)ddananee aadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਰਿਪੁ ਖੰਡਣਨੀ' (ਸ਼ਬਦ) ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "रिपु खंडणनी आदि भणिजै ॥",
      "sourceLineId": "109280",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਰਿਣੀ ਸਬਦ ਅੰਤਿ ਤਿਹ ਦਿਜੈ ॥",
      "transliteration": "arinee sabadh a(n)t teh dhijai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "अरिणी सबद अंति तिह दिजै ॥",
      "sourceLineId": "109281",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
