      "id": "dasam_ang_0790_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪਛਾਨੋ ॥",
      "transliteration": "sakal tupak ke naam pachhaano ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम पछानो ॥",
      "sourceLineId": "109282",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਹ ਤਹ ਮਿਲਿ ਸੁਘਰੁਚ ਬਖਾਨੋ ॥੧੧੨੮॥",
      "transliteration": "jeh teh mil sugharuch bakhaano ||1128||",
      "translation": "Saying the word “Ripukhandanani”, add the word “arini” at the end and know all the names of Tupak.1128.",
      "punjabiViakhya": "ਸੁਘੜੋ! ਜਿਥੇ ਠੀਕ ਹੋਵੇ, ਉਥੇ ਵਰਤੋਂ ਵਿਚ ਲਿਆਓ ॥੧੧੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "जह तह मिलि सुघरुच बखानो ॥११२८॥",
      "sourceLineId": "109283",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੁਸਟ ਦਾਹਨੀ ਆਦਿ ਭਨੀਜੈ ॥",
      "transliteration": "dhusaT dhaahanee aadh bhaneejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਦੁਸਟ ਦਾਹਨੀ' (ਸ਼ਬਦ) ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "दुसट दाहनी आदि भनीजै ॥",
      "sourceLineId": "109284",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਰਿਣੀ ਸਬਦ ਅੰਤਿ ਤਿਹ ਦੀਜੈ ॥",
      "transliteration": "arinee sabadh a(n)t teh dheejai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "अरिणी सबद अंति तिह दीजै ॥",
      "sourceLineId": "109285",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਤੁਮ ਲਖਿ ਪਾਵਹੁ ॥",
      "transliteration": "naam tupak ke tum lakh paavahu ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਤੁਸੀਂ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के तुम लखि पावहु ॥",
      "sourceLineId": "109286",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਹ ਚਾਹੋ ਤਿਹ ਠਵਰ ਬਤਾਵਹੁ ॥੧੧੨੯॥",
      "transliteration": "jeh chaaho teh Thavar bataavahu ||1129||",
      "translation": "Saying firstly the word “Dusht-daahani”, add the word “arini” at the end and know all the names of Tupak.1129.",
      "punjabiViakhya": "ਜਿਥੇ ਚਾਹੋ, ਉਥੇ ਕਥਨ ਕਰੋ ॥੧੧੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "जह चाहो तिह ठवर बतावहु ॥११२९॥",
      "sourceLineId": "109287",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰਿਪੁ ਘਾਇਨੀ ਪਦਾਦਿ ਬਖਾਨੋ ॥",
      "transliteration": "rip ghainee padhaadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਰਿਪੁ ਘਾਇਨੀ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "रिपु घाइनी पदादि बखानो ॥",
      "sourceLineId": "109288",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਰਿਣੀ ਸਬਦ ਅੰਤਿ ਤਿਹ ਠਾਨੋ ॥",
      "transliteration": "arinee sabadh a(n)t teh Thaano ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "अरिणी सबद अंति तिह ठानो ॥",
      "sourceLineId": "109289",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਲਹੀਜੈ ॥",
      "transliteration": "naam tupak ke sakal laheejai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल लहीजै ॥",
      "sourceLineId": "109290",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਉਨ ਠਵਰ ਚਹੀਐ ਤਹ ਦੀਜੈ ॥੧੧੩੦॥",
      "transliteration": "jaun Thavar chaheeaai teh dheejai ||1130||",
      "translation": "Saying firstly the word “Ripu-ghayani”, add the word “arini” at the end and know all the names of Tupak for using them as desired.1130.",
      "punjabiViakhya": "ਜਿਸ ਜਗ੍ਰਹਾ ਚਾਹੋ, ਉਥੇ ਵਰਤ ਲਵੋ ॥੧੧੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "जउन ठवर चहीऐ तह दीजै ॥११३०॥",
      "sourceLineId": "109291",
      "sourceShabadId": "9612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "109292",
      "sourceShabadId": "9613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਦਿ ਚਾਪਣੀ ਸਬਦ ਉਚਾਰਨ ਕੀਜੀਐ ॥",
      "transliteration": "aadh chaapanee sabadh uchaaran keejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਚਾਪਣੀ' (ਧਨੁਸ਼ਧਾਰੀ ਸੈਨਾ) ਸ਼ਬਦ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "आदि चापणी सबद उचारन कीजीऐ ॥",
      "sourceLineId": "109293",
      "sourceShabadId": "9613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਰਿਣੀ ਤਾ ਕੇ ਅੰਤਿ ਸਬਦ ਕੋ ਦੀਜੀਐ ॥",
      "transliteration": "arinee taa ke a(n)t sabadh ko dheejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "अरिणी ता के अंति सबद को दीजीऐ ॥",
      "sourceLineId": "109294",
      "sourceShabadId": "9613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਸੁਘਰ ਲਹਿ ਲੀਜੀਐ ॥",
      "transliteration": "sakal tupak ke naam sughar leh leejeeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਸੂਝਵਾਨੋ! ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम सुघर लहि लीजीऐ ॥",
      "sourceLineId": "109295",
      "sourceShabadId": "9613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹੋ ਜਹਾ ਚਾਹੀਐ ਸਬਦ ਸੁ ਤਹ ਤਹ ਦੀਜੀਐ ॥੧੧੩੧॥",
      "transliteration": "ho jahaa chaaheeaai sabadh su teh teh dheejeeaai ||1131||",
      "translation": "Saying firstly the word “Chaapani”, add the word “arini” at the end and know all the names of Tupak.1131.",
      "punjabiViakhya": "ਜਿਥੇ ਜਿਥੇ ਲੋੜ ਹੋਵੇ, ਉਥੇ ਉਥੇ ਇਸ ਦੀ ਵਰਤੋਂ ਕਰ ਲਵੋ ॥੧੧੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "हो जहा चाहीऐ सबद सु तह तह दीजीऐ ॥११३१॥",
      "sourceLineId": "109296",
      "sourceShabadId": "9613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪ੍ਰਤੰਚਨੀ ਸਬਦ ਕੋ ਆਦਿ ਬਖਾਨੀਐ ॥",
      "transliteration": "prata(n)chanee sabadh ko aadh bakhaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਪ੍ਰਤੰਚਨੀ' (ਧਨੁਸ਼ ਵਾਲੀ ਸੈਨਾ) ਸ਼ਬਦ ਨੂੰ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "प्रतंचनी सबद को आदि बखानीऐ ॥",
      "sourceLineId": "109297",
      "sourceShabadId": "9613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਰਿਣੀ ਤਾ ਕੇ ਅੰਤਿ ਸਬਦ ਕੋ ਠਾਨੀਐ ॥",
      "transliteration": "arinee taa ke a(n)t sabadh ko Thaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "अरिणी ता के अंति सबद को ठानीऐ ॥",
      "sourceLineId": "109298",
      "sourceShabadId": "9613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਜਾਨ ਜੀਅ ਲੀਜੀਐ ॥",
      "transliteration": "sakal tupak ke naam jaan jeea leejeeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਾਰੇ ਮਨ ਵਿਚ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम जान जीअ लीजीऐ ॥",
      "sourceLineId": "109299",
      "sourceShabadId": "9613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਹੋ ਕਹੋ ਨਿਸੰਕ ਸਭ ਠਉਰ ਨ ਗਨਤੀ ਕੀਜੀਐ ॥੧੧੩੨॥",
      "transliteration": "ho kaho nisa(n)k sabh Thaur na ganatee keejeeaai ||1132||",
      "translation": "Saying firstly the word “Pratyanchani”, add the word “arini” at the end and know all the names of Tupak.1132.",
      "punjabiViakhya": "ਬਿਨਾ ਵਿਚਾਰੇ ਸਭ ਥਾਵਾ ਤੇ ਨਿਸੰਗ ਹੋ ਕੇ ਵਰਤੋ ॥੧੧੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "हो कहो निसंक सभ ठउर न गनती कीजीऐ ॥११३२॥",
      "sourceLineId": "109300",
      "sourceShabadId": "9613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਰੂਆਮਲ ਛੰਦ ॥",
      "transliteration": "rooaamal chha(n)dh ||",
      "translation": "STANZA ROOAAMAL",
      "punjabiViakhya": "ਰੂਆਮਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "रूआमल छंद ॥",
      "sourceLineId": "109301",
      "sourceShabadId": "9614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਤ੍ਰੁ ਭੰਜਣਿ ਆਦਿ ਬਖਾਨ ॥",
      "transliteration": "satr bha(n)jan aadh bakhaan ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸਤ੍ਰੁ' ਭੰਜਣਿ (ਸ਼ਬਦ) ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "सत्रु भंजणि आदि बखान ॥",
      "sourceLineId": "109302",
      "sourceShabadId": "9614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰਿਪੁ ਸਬਦੁ ਬਹੁਰਿ ਪ੍ਰਮਾਨ ॥",
      "transliteration": "rip sabadh bahur pramaan ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਰਿਪੁ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "रिपु सबदु बहुरि प्रमान ॥",
      "sourceLineId": "109303",
      "sourceShabadId": "9614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਭ ਨਾਮ ਤੁਪਕ ਪਛਾਨ ॥",
      "transliteration": "sabh naam tupak pachhaan ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "सभ नाम तुपक पछान ॥",
      "sourceLineId": "109304",
      "sourceShabadId": "9614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਹਿ ਭੇਦ ਯਾ ਮਹਿ ਜਾਨ ॥੧੧੩੩॥",
      "transliteration": "neh bhedh yaa meh jaan ||1133||",
      "translation": "Saying firstly the word “Shatru-bhanjani”, add the word “Ripu” and know all the names of Tupak without any discrimination.1133.",
      "punjabiViakhya": "ਇਸ ਵਿਚ ਕੋਈ ਭੇਦ ਨਾ ਸਮਝੋ ॥੧੧੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "नहि भेद या महि जान ॥११३३॥",
      "sourceLineId": "109305",
      "sourceShabadId": "9614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0790_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 790,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "109306",
      "sourceShabadId": "9615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
