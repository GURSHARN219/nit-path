  "lineCount": 24,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0791_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਰਿ ਸਕਤਣਿ ਪਦ ਆਣਿ ਭਣਿਜੈ ॥",
      "transliteration": "har sakatan padh aan bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਹਰਿ ਸਕਤਣਿ' (ਸ਼ੇਰ ਦੀ ਤਾਕਤ ਵਾਲੀ ਸੈਨਾ) ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "हरि सकतणि पद आणि भणिजै ॥",
      "sourceLineId": "109307",
      "sourceShabadId": "9615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਰਿਣੀ ਸਬਦ ਅੰਤਿ ਤਿਹ ਦਿਜੈ ॥",
      "transliteration": "arinee sabadh a(n)t teh dhijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "अरिणी सबद अंति तिह दिजै ॥",
      "sourceLineId": "109308",
      "sourceShabadId": "9615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਲਹੀਜੈ ॥",
      "transliteration": "naam tupak ke sakal laheejai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल लहीजै ॥",
      "sourceLineId": "109309",
      "sourceShabadId": "9615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਹੀ ਠਵਰ ਚਹੀਐ ਤਹ ਦੀਜੈ ॥੧੧੩੪॥",
      "transliteration": "jahee Thavar chaheeaai teh dheejai ||1134||",
      "translation": "Saying firstly the word “Harishkitni”, add the word “arnini” at the end and know all the names of Tupak for using them as desired.1134.",
      "punjabiViakhya": "ਜਿਥੇ ਲੋੜ ਹੋਵੇ, ਉਥੇ ਵਰਤ ਲਵੋ ॥੧੧੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "जही ठवर चहीऐ तह दीजै ॥११३४॥",
      "sourceLineId": "109310",
      "sourceShabadId": "9615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "109311",
      "sourceShabadId": "9616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਿਸਿਖ ਬਰਸਣੀ ਆਦਿ ਉਚਾਰਣ ਕੀਜੀਐ ॥",
      "transliteration": "bisikh barasanee aadh uchaaran keejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬਿਸਿਖ (ਬਾਣ) ਬਰਸਣੀ' (ਸ਼ਬਦ) ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "बिसिख बरसणी आदि उचारण कीजीऐ ॥",
      "sourceLineId": "109312",
      "sourceShabadId": "9616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਰਿਣੀ ਤਾ ਕੇ ਅੰਤਿ ਸਬਦ ਕੋ ਦੀਜੀਐ ॥",
      "transliteration": "arinee taa ke a(n)t sabadh ko dheejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਵਿਚ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "अरिणी ता के अंति सबद को दीजीऐ ॥",
      "sourceLineId": "109313",
      "sourceShabadId": "9616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਚਤੁਰ ਜੀਅ ਜਾਨੀਐ ॥",
      "transliteration": "sakal tupak ke naam chatur jeea jaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਸਿਆਣੇ ਲੋਗ ਤੁਪਕ ਦਾ ਨਾਮ ਮਨ ਵਿਚ ਸਮਝਣ।",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम चतुर जीअ जानीऐ ॥",
      "sourceLineId": "109314",
      "sourceShabadId": "9616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹੋ ਕਾਬਿ ਕਬਿਤ ਕੇ ਭੀਤਰ ਸਦਾ ਪ੍ਰਮਾਨੀਐ ॥੧੧੩੫॥",
      "transliteration": "ho kaab kabit ke bheetar sadhaa pramaaneeaai ||1135||",
      "translation": "Saying firstly the word “Vishkh-varshani”, add the word “arini” at the end and know all the names of Tupak in your mind.1135.",
      "punjabiViakhya": "ਕਵੀ ਲੋਗ ਇਸ ਨੂੰ ਸਦਾ ਕਬਿੱਤਾ ਵਿਚ ਵਰਤਣ ॥੧੧੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "हो काबि कबित के भीतर सदा प्रमानीऐ ॥११३५॥",
      "sourceLineId": "109315",
      "sourceShabadId": "9616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "109316",
      "sourceShabadId": "9617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਾਨ ਬਰਖਣੀ ਆਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "baan barakhanee aadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬਾਨ ਬਰਖਣੀ' (ਸ਼ਬਦ) ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "बान बरखणी आदि उचरीऐ ॥",
      "sourceLineId": "109317",
      "sourceShabadId": "9617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਰਿਣੀ ਸਬਦ ਅੰਤਿ ਤਿਹ ਧਰੀਐ ॥",
      "transliteration": "arinee sabadh a(n)t teh dhareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਤੇ 'ਅਰਿਣੀ' (ਸ਼ਬਦ) ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "अरिणी सबद अंति तिह धरीऐ ॥",
      "sourceLineId": "109318",
      "sourceShabadId": "9617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਲਹੀਜੈ ॥",
      "transliteration": "sakal tupak ke naam laheejai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਗ੍ਰਹਿਣ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम लहीजै ॥",
      "sourceLineId": "109319",
      "sourceShabadId": "9617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਿਹ ਚਾਹੋ ਤਿਹ ਠਵਰ ਭਣੀਜੈ ॥੧੧੩੬॥",
      "transliteration": "jeh chaaho teh Thavar bhaneejai ||1136||",
      "translation": "Saying firstly the word “Baan-varshani”, add the word “arini” at the end and know all the names of Tupak.1136.",
      "punjabiViakhya": "ਜਿਥੇ ਚਾਹੋ, ਉਥੇ ਕਥਨ ਕਰ ਦਿਓ ॥੧੧੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "जिह चाहो तिह ठवर भणीजै ॥११३६॥",
      "sourceLineId": "109320",
      "sourceShabadId": "9617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "109321",
      "sourceShabadId": "9618",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਆਦਿ ਬਾਨਨੀ ਸਬਦਹਿ ਅਭੂਲਿ ਬਖਾਨੀਐ ॥",
      "transliteration": "aadh baananee sabadheh abhool bakhaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬਾਨਨੀ' ਸ਼ਬਦ ਬਿਨਾ ਭੁਲੇ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "आदि बाननी सबदहि अभूलि बखानीऐ ॥",
      "sourceLineId": "109322",
      "sourceShabadId": "9618",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਰਿਣੀ ਤਾ ਕੇ ਅੰਤਿ ਸਬਦ ਕੋ ਠਾਨੀਐ ॥",
      "transliteration": "arinee taa ke a(n)t sabadh ko Thaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "अरिणी ता के अंति सबद को ठानीऐ ॥",
      "sourceLineId": "109323",
      "sourceShabadId": "9618",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਜਾਨ ਜੀਅ ਲੀਜੀਐ ॥",
      "transliteration": "naam tupak ke sakal jaan jeea leejeeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਮਨ ਵਿਚ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल जान जीअ लीजीऐ ॥",
      "sourceLineId": "109324",
      "sourceShabadId": "9618",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹੋ ਜਹ ਚਾਹੋ ਤਹ ਸਬਦ ਤਹੀ ਤੇ ਦੀਜੀਐ ॥੧੧੩੭॥",
      "transliteration": "ho jeh chaaho teh sabadh tahee te dheejeeaai ||1137||",
      "translation": "Saying firstly the wood “Baanani”, add the word “arini” at the end and know all the names of Tupak in your mind.1137.",
      "punjabiViakhya": "ਜਿਥੇ ਚਾਹੋ, ਇਸ ਸ਼ਬਦ ਨੂੰ ਵਰਤ ਲਵੋ ॥੧੧੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "हो जह चाहो तह सबद तही ते दीजीऐ ॥११३७॥",
      "sourceLineId": "109325",
      "sourceShabadId": "9618",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "109326",
      "sourceShabadId": "9619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਆਦਿ ਪਨਚਨੀ ਸਬਦ ਬਖਾਨੋ ॥",
      "transliteration": "aadh panachanee sabadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਪਨਚਨੀ' (ਧਨੁਸ਼ਧਾਰੀ ਸੈਨਾ) ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "आदि पनचनी सबद बखानो ॥",
      "sourceLineId": "109327",
      "sourceShabadId": "9619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਥਣੀ ਸਬਦ ਅੰਤਿ ਤਿਹ ਠਾਨੋ ॥",
      "transliteration": "mathanee sabadh a(n)t teh Thaano ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "मथणी सबद अंति तिह ठानो ॥",
      "sourceLineId": "109328",
      "sourceShabadId": "9619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਕੇ ਲਹੀਐ ॥",
      "transliteration": "sabh sree naam tupak ke laheeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक के लहीऐ ॥",
      "sourceLineId": "109329",
      "sourceShabadId": "9619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0791_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰੁਚਿ ਜੈ ਜਹੀ ਤਹੀ ਤੇ ਕਹੀਐ ॥੧੧੩੮॥",
      "transliteration": "ruch jai jahee tahee te kaheeaai ||1138||",
      "translation": "Saying the word “Panchani”, add the word “Mathani” at the end and know all the names of Tupak for speaking them according to your inclination.1138.",
      "punjabiViakhya": "ਜਿਥੇ ਰੁਚੀ ਹੋਵੇ, ਉਥੇ ਹੀ ਕਹੋ ॥੧੧੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 791,
      "hindi": "",
      "hindiTransliteration": "रुचि जै जही तही ते कहीऐ ॥११३८॥",
      "sourceLineId": "109330",
      "sourceShabadId": "9619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
