{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 792,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0792_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕੋਵੰਡਜਨੀ ਆਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "kova(n)ddajanee aadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਕੋਵੰਡਜਨੀ' (ਧਨੁਸ਼ ਬਾਣ ਧਾਰੀ ਸੈਨਾ) (ਸ਼ਬਦ) ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "कोवंडजनी आदि उचरीऐ ॥",
      "sourceLineId": "109331",
      "sourceShabadId": "9619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਥਨੀ ਅੰਤਿ ਸਬਦ ਤਿਹ ਧਰੀਐ ॥",
      "transliteration": "mathanee a(n)t sabadh teh dhareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਮਥਨੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "मथनी अंति सबद तिह धरीऐ ॥",
      "sourceLineId": "109332",
      "sourceShabadId": "9619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਕੇ ਜਾਨਹੁ ॥",
      "transliteration": "sabh sree naam tupak ke jaanahu ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक के जानहु ॥",
      "sourceLineId": "109333",
      "sourceShabadId": "9619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਹਾ ਰੁਚੈ ਤੇ ਤਹੀ ਬਖਾਨਹੁ ॥੧੧੩੯॥",
      "transliteration": "jahaa ruchai te tahee bakhaanahu ||1139||",
      "translation": "Saying the word “Kovandjani” speak the word “mathani” at the end and know all the names of Tupak.1139.",
      "punjabiViakhya": "ਜਿਥੇ ਚਿਤ ਕਰੇ, ਉਥੇ ਕਥਨ ਕਰੋ ॥੧੧੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "जहा रुचै ते तही बखानहु ॥११३९॥",
      "sourceLineId": "109334",
      "sourceShabadId": "9619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਇਖੁਆਸਜਨੀ ਆਦਿ ਭਣੀਜੈ ॥",
      "transliteration": "eikhuaasajanee aadh bhaneejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਇਖੁਆਸਜਨੀ' (ਤੀਰ-ਕਮਾਨ ਵਾਲੀ ਸੈਨਾ) (ਸ਼ਬਦ) ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "इखुआसजनी आदि भणीजै ॥",
      "sourceLineId": "109335",
      "sourceShabadId": "9619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਥਣੀ ਅੰਤਿ ਸਬਦ ਤਿਹ ਦੀਜੈ ॥",
      "transliteration": "mathanee a(n)t sabadh teh dheejai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "मथणी अंति सबद तिह दीजै ॥",
      "sourceLineId": "109336",
      "sourceShabadId": "9619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਲਹਿਜੈ ॥",
      "transliteration": "sakal tupak ke naam lahijai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम लहिजै ॥",
      "sourceLineId": "109337",
      "sourceShabadId": "9619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਵਨ ਠਵਰ ਚਹੀਐ ਤਹ ਦਿਜੈ ॥੧੧੪੦॥",
      "transliteration": "javan Thavar chaheeaai teh dhijai ||1140||",
      "translation": "Saying firstly the word “Ikshu-aasjani”, add the word “mathani” at the end and know all the names of Tupak for using them as desired.1140.",
      "punjabiViakhya": "ਜਿਥੇ ਚਿਤ ਕਰੇ, ਉਥੇ ਹੀ ਵਰਤੋ ॥੧੧੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "जवन ठवर चहीऐ तह दिजै ॥११४०॥",
      "sourceLineId": "109338",
      "sourceShabadId": "9619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "109339",
      "sourceShabadId": "9620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਾਰਮੁਕਜਨੀ ਪਦ ਕੋ ਪ੍ਰਿਥਮ ਉਚਾਰੀਐ ॥",
      "transliteration": "kaaramukajanee padh ko piratham uchaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਕਾਰਮੁਕਜਨੀ' (ਧਨੁਸ਼ ਬਾਣ ਵਾਲੀ ਸੈਨਾ) ਪਦ ਨੂੰ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "कारमुकजनी पद को पृथम उचारीऐ ॥",
      "sourceLineId": "109340",
      "sourceShabadId": "9620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਰਿਣੀ ਤਾ ਕੇ ਅੰਤਿ ਸਬਦ ਕੋ ਡਾਰੀਐ ॥",
      "transliteration": "arinee taa ke a(n)t sabadh ko ddaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "अरिणी ता के अंति सबद को डारीऐ ॥",
      "sourceLineId": "109341",
      "sourceShabadId": "9620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਸੁਘਰ ਲਹਿ ਲੀਜੀਐ ॥",
      "transliteration": "sakal tupak ke naam sughar leh leejeeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਸੂਝਵਾਨੋ! ਤੁਪਕ ਦੇ ਨਾਮ ਵਜੋਂ ਜਾਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम सुघर लहि लीजीऐ ॥",
      "sourceLineId": "109342",
      "sourceShabadId": "9620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹੋ ਕਬਿਤ ਕਾਬਿ ਮੈ ਚਹੋ ਤਹਾ ਤੇ ਦੀਜੀਐ ॥੧੧੪੧॥",
      "transliteration": "ho kabit kaab mai chaho tahaa te dheejeeaai ||1141||",
      "translation": "Saying firstly the word “Kaarmukjani”, add the word “arini” at the end and know all the names of Tupak.1141.",
      "punjabiViakhya": "ਜਿਸ ਕਬਿੱਤਾ ਵਿਚ ਕਵੀਓ! ਚਾਹੋ, ਉਥੇ ਵਰਤੋ ॥੧੧੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "हो कबित काबि मै चहो तहा ते दीजीऐ ॥११४१॥",
      "sourceLineId": "109343",
      "sourceShabadId": "9620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਿਪੁ ਤਾਪਣੀ ਸਬਦਹਿ ਆਦਿ ਉਚਾਰੀਐ ॥",
      "transliteration": "rip taapanee sabadheh aadh uchaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਰਿਪੁ ਤਾਪਣੀ' ਸ਼ਬਦ ਨੂੰ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "रिपु तापणी सबदहि आदि उचारीऐ ॥",
      "sourceLineId": "109344",
      "sourceShabadId": "9620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਰਿਣੀ ਤਾ ਕੇ ਅੰਤਿ ਸੁ ਪਦ ਕੋ ਡਾਰੀਐ ॥",
      "transliteration": "arinee taa ke a(n)t su padh ko ddaareeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "अरिणी ता के अंति सु पद को डारीऐ ॥",
      "sourceLineId": "109345",
      "sourceShabadId": "9620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਸੁਬੁਧਿ ਪਛਾਨੀਐ ॥",
      "transliteration": "sakal tupak ke naam subudh pachhaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਬੁੱਧੀਮਾਨੋ! ਤੁਪਕ ਦਾ ਨਾਮ ਪਛਾਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम सुबुधि पछानीऐ ॥",
      "sourceLineId": "109346",
      "sourceShabadId": "9620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹੋ ਜਹਾ ਚਹੋ ਤਹ ਦੇਹੁ ਨ ਸੰਕਾ ਮਾਨੀਐ ॥੧੧੪੨॥",
      "transliteration": "ho jahaa chaho teh dheh na sa(n)kaa maaneeaai ||1142||",
      "translation": "Saying firstly the word “Riputaapini”, add the word “arini” at the end and O wise men! recognize the names of Tupak for using the, unhesitatingly.1142.",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਜਿਥੇ ਕਿਥੇ ਚਾਹੋ, ਨਿਸੰਗ ਹੋ ਕੇ ਵਰਤੋ ॥੧੧੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "हो जहा चहो तह देहु न संका मानीऐ ॥११४२॥",
      "sourceLineId": "109347",
      "sourceShabadId": "9620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਆਦਿ ਚਾਪਣੀ ਮੁਖ ਤੇ ਸਬਦ ਬਖਾਨੀਐ ॥",
      "transliteration": "aadh chaapanee mukh te sabadh bakhaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਚਾਪਣੀ' ਸ਼ਬਦ ਮੂੰਹ ਤੋਂ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "आदि चापणी मुख ते सबद बखानीऐ ॥",
      "sourceLineId": "109348",
      "sourceShabadId": "9620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਥਣੀ ਤਾ ਕੇ ਅੰਤਿ ਸਬਦ ਕੋ ਠਾਨੀਐ ॥",
      "transliteration": "mathanee taa ke a(n)t sabadh ko Thaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "मथणी ता के अंति सबद को ठानीऐ ॥",
      "sourceLineId": "109349",
      "sourceShabadId": "9620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਸੁਬੁਧਿ ਲਹਿ ਲੀਜੀਐ ॥",
      "transliteration": "sakal tupak ke naam subudh leh leejeeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਬੁੱਧੀਮਾਨੋ! ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम सुबुधि लहि लीजीऐ ॥",
      "sourceLineId": "109350",
      "sourceShabadId": "9620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹੋ ਜਹ ਚਾਹੋ ਤਿਹ ਠਵਰ ਉਚਾਰਨ ਕੀਜੀਐ ॥੧੧੪੩॥",
      "transliteration": "ho jeh chaaho teh Thavar uchaaran keejeeaai ||1143||",
      "translation": "Utter the word “Chaapani” from you mouth, add the word “mathani” t the end and know the names of Tupak.1143.",
      "punjabiViakhya": "ਜਿਥੇ ਚਾਹੋ, ਇਸ ਦਾ ਉਚਾਰਨ ਕਰੋ ॥੧੧੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "हो जह चाहो तिह ठवर उचारन कीजीऐ ॥११४३॥",
      "sourceLineId": "109351",
      "sourceShabadId": "9620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪਨਚ ਧਰਨਨੀ ਆਦਿ ਉਚਾਰਨ ਕੀਜੀਐ ॥",
      "transliteration": "panach dharananee aadh uchaaran keejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਪਨਚ ਧਰਨਨੀ' ਸ਼ਬਦ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "पनच धरननी आदि उचारन कीजीऐ ॥",
      "sourceLineId": "109352",
      "sourceShabadId": "9620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਥਣੀ ਤਾ ਕੇ ਅੰਤਿ ਸਬਦ ਕੋ ਦੀਜੀਐ ॥",
      "transliteration": "mathanee taa ke a(n)t sabadh ko dheejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਵਰਤੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "मथणी ता के अंति सबद को दीजीऐ ॥",
      "sourceLineId": "109353",
      "sourceShabadId": "9620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਸੁਬੁਧਿ ਪਛਾਨੀਐ ॥",
      "transliteration": "sakal tupak ke naam subudh pachhaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਾਰੇ ਬੁੱਧੀਮਾਨੋ! ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम सुबुधि पछानीऐ ॥",
      "sourceLineId": "109354",
      "sourceShabadId": "9620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹੋ ਯਾ ਕੇ ਭੀਤਰ ਭੇਦ ਨੈਕੁ ਨਹੀ ਮਾਨੀਐ ॥੧੧੪੪॥",
      "transliteration": "ho yaa ke bheetar bhedh naik nahee maaneeaai ||1144||",
      "translation": "Saying firstly the word “Panach-dharnani”, add the word “mathani” at the end and recognize all the names of Tupak.1144.",
      "punjabiViakhya": "ਇਸ ਵਿਚ ਕਿਸੇ ਕਿਸਮ ਦਾ ਭੇਦ ਨਾ ਸਮਝੋ ॥੧੧੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "हो या के भीतर भेद नैकु नही मानीऐ ॥११४४॥",
      "sourceLineId": "109355",
      "sourceShabadId": "9620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "109356",
      "sourceShabadId": "9621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਆਦਿ ਸੁਹ੍ਰਿਦਣੀ ਸਬਦ ਬਖਾਨੋ ॥",
      "transliteration": "aadh suhiradhanee sabadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸੁਹ੍ਰਿਦਣੀ' (ਸੈਨਾ) ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "आदि सुहृदणी सबद बखानो ॥",
      "sourceLineId": "109357",
      "sourceShabadId": "9621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਥਣੀ ਸਬਦ ਅੰਤਿ ਤਿਹ ਠਾਨੋ ॥",
      "transliteration": "mathanee sabadh a(n)t teh Thaano ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "मथणी सबद अंति तिह ठानो ॥",
      "sourceLineId": "109358",
      "sourceShabadId": "9621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਕੇ ਲਹੀਐ ॥",
      "transliteration": "sabh sree naam tupak ke laheeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक के लहीऐ ॥",
      "sourceLineId": "109359",
      "sourceShabadId": "9621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਿਹ ਠਾ ਰੁਚੈ ਤਹੀ ਤੇ ਕਹੀਐ ॥੧੧੪੫॥",
      "transliteration": "jeh Thaa ruchai tahee te kaheeaai ||1145||",
      "translation": "Saying firstly the word “Suhirdayani”, add the word “Mathani” at the end and know all the names of Tupak for using them according to your inclination.1145.",
      "punjabiViakhya": "ਜਿਥੇ ਚੰਗਾ ਲਗੇ, ਉਥੇ ਕਹੋ ॥੧੧੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "जिह ठा रुचै तही ते कहीऐ ॥११४५॥",
      "sourceLineId": "109360",
      "sourceShabadId": "9621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "109361",
      "sourceShabadId": "9622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਲਭਣੀ ਸਬਦਾਦਿ ਬਖਾਨਨ ਕੀਜੀਐ ॥",
      "transliteration": "balabhanee sabadhaadh bakhaanan keejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬਲਭਣੀ' (ਸੈਨਾ) ਸ਼ਬਦ ਦਾ ਬਖਾਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "बलभणी सबदादि बखानन कीजीऐ ॥",
      "sourceLineId": "109362",
      "sourceShabadId": "9622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਰਿਣੀ ਤਾ ਕੇ ਅੰਤਿ ਸਬਦ ਕੋ ਦੀਜੀਐ ॥",
      "transliteration": "arinee taa ke a(n)t sabadh ko dheejeeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "अरिणी ता के अंति सबद को दीजीऐ ॥",
      "sourceLineId": "109363",
      "sourceShabadId": "9622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਚਤੁਰ ਚਿਤਿ ਜਾਨੀਐ ॥",
      "transliteration": "sakal tupak ke naam chatur chit jaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਸੂਝਵਾਨੋ! ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम चतुर चिति जानीऐ ॥",
      "sourceLineId": "109364",
      "sourceShabadId": "9622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹੋ ਯਾ ਕੇ ਭੀਤਰ ਭੇਦ ਨ ਨੈਕੁ ਪ੍ਰਮਾਨੀਐ ॥੧੧੪੬॥",
      "transliteration": "ho yaa ke bheetar bhedh na naik pramaaneeaai ||1146||",
      "translation": "Saying the word “Vallabhani” and the word “arini” at the end and know all the names of Tupak in your mind.1146.",
      "punjabiViakhya": "ਇਸ ਵਿਚ ਕਿਸੇ ਪ੍ਰਕਾਰ ਦਾ ਫਰਕ ਨਾ ਜਾਣੋ ॥੧੧੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "हो या के भीतर भेद न नैकु प्रमानीऐ ॥११४६॥",
      "sourceLineId": "109365",
      "sourceShabadId": "9622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "109366",
      "sourceShabadId": "9623",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਾਖਾਇਨਣੀ ਆਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "saakhainanee aadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸਾਖਾਇਨਣੀ' (ਸੈਨਾ) ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "साखाइनणी आदि उचरीऐ ॥",
      "sourceLineId": "109367",
      "sourceShabadId": "9623",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਰਿਣੀ ਸਬਦ ਅੰਤਿ ਤਿਹ ਧਰੀਐ ॥",
      "transliteration": "arinee sabadh a(n)t teh dhareeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "अरिणी सबद अंति तिह धरीऐ ॥",
      "sourceLineId": "109368",
      "sourceShabadId": "9623",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਲਹਿਜੈ ॥",
      "transliteration": "naam tupak ke sakal lahijai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल लहिजै ॥",
      "sourceLineId": "109369",
      "sourceShabadId": "9623",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਿਹ ਚਹੀਐ ਤਿਹ ਠਵਰ ਭਣਿਜੈ ॥੧੧੪੭॥",
      "transliteration": "jeh chaheeaai teh Thavar bhanijai ||1147||",
      "translation": "Saying firstly the wood “Shaakhaainani” and the word “Dharani” at the end and know all the names of Tupak.1147.",
      "punjabiViakhya": "ਜਿਥੇ ਚਾਹੋ, ਉਥੇ ਹੀ ਕਥਨ ਕਰੋ ॥੧੧੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "जिह चहीऐ तिह ठवर भणिजै ॥११४७॥",
      "sourceLineId": "109370",
      "sourceShabadId": "9623",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪ੍ਰੀਤਮਣੀ ਪਦ ਆਦਿ ਬਖਾਨੀਐ ॥",
      "transliteration": "preetamanee padh aadh bakhaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਪ੍ਰੀਤਮਣੀ' (ਸੈਨਾ) ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "प्रीतमणी पद आदि बखानीऐ ॥",
      "sourceLineId": "109371",
      "sourceShabadId": "9623",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮਥਣੀ ਅੰਤਿ ਤਵਨ ਕੇ ਠਾਨੀਐ ॥",
      "transliteration": "mathanee a(n)t tavan ke Thaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "मथणी अंति तवन के ठानीऐ ॥",
      "sourceLineId": "109372",
      "sourceShabadId": "9623",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪਛਾਨੋ ॥",
      "transliteration": "sakal tupak ke naam pachhaano ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम पछानो ॥",
      "sourceLineId": "109373",
      "sourceShabadId": "9623",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਯਾ ਮੈ ਨੈਕੁ ਨ ਮਿਥਿਆ ਜਾਨੋ ॥੧੧੪੮॥",
      "transliteration": "yaa mai naik na mithiaa jaano ||1148||",
      "translation": "Saying firstly the word “Priyatamani” add the word “mathani” at the end and know all the names of Tupak  there is no falsehood in it.1148.",
      "punjabiViakhya": "ਇਸ ਵਿਚ ਕੁਝ ਵੀ ਝੂਠ ਨਾ ਮੰਨੋ ॥੧੧੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "या मै नैकु न मिथिआ जानो ॥११४८॥",
      "sourceLineId": "109374",
      "sourceShabadId": "9623",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "109375",
      "sourceShabadId": "9624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਆਦਿ ਸੁਜਨਨੀ ਸਬਦ ਉਚਾਰਨ ਕੀਜੀਐ ॥",
      "transliteration": "aadh sujananee sabadh uchaaran keejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸੁਜਨਨੀ' (ਸੈਨਾ) ਪਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "आदि सुजननी सबद उचारन कीजीऐ ॥",
      "sourceLineId": "109376",
      "sourceShabadId": "9624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮਥਣੀ ਤਾ ਕੇ ਅੰਤਿ ਸਬਦ ਕੋ ਦੀਜੀਐ ॥",
      "transliteration": "mathanee taa ke a(n)t sabadh ko dheejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "मथणी ता के अंति सबद को दीजीऐ ॥",
      "sourceLineId": "109377",
      "sourceShabadId": "9624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0792_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਸੁਬੁਧਿ ਜੀਅ ਜਾਨੀਐ ॥",
      "transliteration": "sakal tupak ke naam subudh jeea jaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਬੁੱਧੀਮਾਨੋ! ਮਨ ਵਿਚ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम सुबुधि जीअ जानीऐ ॥",
      "sourceLineId": "109378",
      "sourceShabadId": "9624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
