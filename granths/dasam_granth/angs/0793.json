  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0793_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹੋ ਯਾ ਕੇ ਭੀਤਰ ਭੇਦ ਤਨਕ ਨਹੀ ਮਾਨੀਐ ॥੧੧੪੯॥",
      "transliteration": "ho yaa ke bheetar bhedh tanak nahee maaneeaai ||1149||",
      "translation": "Uttering firstly the word “Janani” add the word “mathani” at the end and know all the names of Tupak in your mind without any discrimination.1149.",
      "punjabiViakhya": "ਇਸ ਗੱਲ ਵਿਚ ਜ਼ਰਾ ਜਿੰਨਾ ਭੇਦ ਨਾ ਮੰਨੋ ॥੧੧੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "हो या के भीतर भेद तनक नही मानीऐ ॥११४९॥",
      "sourceLineId": "109379",
      "sourceShabadId": "9624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪ੍ਰਿਥਮ ਸੁਹਿਰਦਿਨੀ ਮੁਖ ਤੇ ਸਬਦ ਉਚਾਰੀਐ ॥",
      "transliteration": "piratham suhiradhinee mukh te sabadh uchaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸੁਹਿਰਦਿਨੀ' ਸ਼ਬਦ ਨੂੰ ਮੁਖ ਵਿਚੋਂ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "पृथम सुहिरदिनी मुख ते सबद उचारीऐ ॥",
      "sourceLineId": "109380",
      "sourceShabadId": "9624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਰਿਣੀ ਤਾ ਕੇ ਅੰਤਿ ਬਹੁਰਿ ਪਦ ਡਾਰੀਐ ॥",
      "transliteration": "arinee taa ke a(n)t bahur padh ddaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "अरिणी ता के अंति बहुरि पद डारीऐ ॥",
      "sourceLineId": "109381",
      "sourceShabadId": "9624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਚਤੁਰ ਚਿਤ ਮਾਝ ਲਹੁ ॥",
      "transliteration": "sakal tupak ke naam chatur chit maajh lahu ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਚਤੁਰ ਲੋਗ ਮਨ ਵਿਚ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝਣ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम चतुर चित माझ लहु ॥",
      "sourceLineId": "109382",
      "sourceShabadId": "9624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹੋ ਕਬਿਤ ਕਾਬਿ ਮੈ ਰੁਚੈ ਤਹੀ ਤੇ ਨਾਮ ਕਹੁ ॥੧੧੫੦॥",
      "transliteration": "ho kabit kaab mai ruchai tahee te naam kahu ||1150||",
      "translation": "Saying firstly the word “Suhirdyani” add the word “arini” at the end and know all the names to Tupak cleverly and use them in poetry according to your inclination.1150.",
      "punjabiViakhya": "ਜਿਥੇ ਕਵੀ ਕਬਿੱਤਾ ਰਚਣ, ਉਥੇ ਵਰਤ ਲੈਣ ॥੧੧੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "हो कबित काबि मै रुचै तही ते नाम कहु ॥११५०॥",
      "sourceLineId": "109383",
      "sourceShabadId": "9624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "109384",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਾਨੁਖਨੀ ਸਬਦਾਦਿ ਭਣੀਜੈ ॥",
      "transliteration": "maanukhanee sabadhaadh bhaneejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਮਾਨੁਖਨੀ' (ਸੈਨਾ) ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "मानुखनी सबदादि भणीजै ॥",
      "sourceLineId": "109385",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਰਿਣੀ ਅੰਤਿ ਸਬਦ ਤਿਹ ਦੀਜੈ ॥",
      "transliteration": "arinee a(n)t sabadh teh dheejai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਵਰਤੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "अरिणी अंति सबद तिह दीजै ॥",
      "sourceLineId": "109386",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪਛਾਨਹੁ ॥",
      "transliteration": "sakal tupak ke naam pachhaanahu ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम पछानहु ॥",
      "sourceLineId": "109387",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚਹੋ ਜਹਾ ਸਭ ਠਵਰ ਬਖਾਨਹੁ ॥੧੧੫੧॥",
      "transliteration": "chaho jahaa sabh Thavar bakhaanahu ||1151||",
      "translation": "Saying firstly the word “Manushyani” add the word “arini” at the end and know all the names of Tupak and use them as desired.1151.",
      "punjabiViakhya": "ਜਿਥੇ ਚਾਹੋ, ਸਭ ਥਾਵਾ ਤੇ ਵਰਤੋ ॥੧੧੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "चहो जहा सभ ठवर बखानहु ॥११५१॥",
      "sourceLineId": "109388",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਆਦਿ ਮਰਤਣੀ ਸਬਦ ਬਖਾਨੋ ॥",
      "transliteration": "aadh maratanee sabadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਮਰਤਣੀ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "आदि मरतणी सबद बखानो ॥",
      "sourceLineId": "109389",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅੰਤਕ ਸਬਦ ਅੰਤਿ ਤਿਹ ਠਾਨੋ ॥",
      "transliteration": "a(n)tak sabadh a(n)t teh Thaano ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅੰਤਕ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "अंतक सबद अंति तिह ठानो ॥",
      "sourceLineId": "109390",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਲਹਿ ਲੀਜੈ ॥",
      "transliteration": "naam tupak ke sabh leh leejai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ लहि लीजै ॥",
      "sourceLineId": "109391",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਿਹ ਚਾਹੋ ਤਿਹ ਠਵਰ ਭਣੀਜੈ ॥੧੧੫੨॥",
      "transliteration": "jeh chaaho teh Thavar bhaneejai ||1152||",
      "translation": "Saying the word “Mratyani” add the word “arini” at the end and know all the names of Tupak  you may mention them anywhere as desired.1152.",
      "punjabiViakhya": "ਜਿਥੇ ਚਾਹੋ, ਉਥੇ ਕਥਨ ਕਰੋ ॥੧੧੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "जिह चाहो तिह ठवर भणीजै ॥११५२॥",
      "sourceLineId": "109392",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਆਦਿ ਮਾਨੁਖਨੀ ਸਬਦ ਬਖਾਨੋ ॥",
      "transliteration": "aadh maanukhanee sabadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਮਾਨੁਖਨੀ' (ਮਨੁੱਖ ਦੇ ਸਮੂਹ ਵਾਲੀ ਸੈਨਾ) ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "आदि मानुखनी सबद बखानो ॥",
      "sourceLineId": "109393",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਾ ਕੇ ਮਥਣੀ ਅੰਤਿ ਸੁ ਠਾਨੋ ॥",
      "transliteration": "taa ke mathanee a(n)t su Thaano ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਵਰਤੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "ता के मथणी अंति सु ठानो ॥",
      "sourceLineId": "109394",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਲਹਿ ਲਿਜੈ ॥",
      "transliteration": "naam tupak ke sabh leh lijai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ लहि लिजै ॥",
      "sourceLineId": "109395",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਿਹ ਚਾਹੋ ਤਿਹ ਠਵਰ ਭਣਿਜੈ ॥੧੧੫੩॥",
      "transliteration": "jeh chaaho teh Thavar bhanijai ||1153||",
      "translation": "Saying the word “Manini” add the word “mathani” and know all the names of Tupak for using them as desired.1153.",
      "punjabiViakhya": "ਜਿਥੇ ਲੋੜ ਸਮਝੋ, ਉਥੇ ਕਥਨ ਕਰੋ ॥੧੧੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "जिह चाहो तिह ठवर भणिजै ॥११५३॥",
      "sourceLineId": "109396",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਾਨਿਖਯਨੀ ਪਦਾਦਿ ਭਣੀਜੈ ॥",
      "transliteration": "maanikhayanee padhaadh bhaneejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਮਾਨਿਖਯਨੀ' (ਪੈਦਲ ਸੈਨਾ) ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "मानिखयनी पदादि भणीजै ॥",
      "sourceLineId": "109397",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅੰਤਿ ਸਬਦ ਮਥਣੀ ਤਿਹ ਦੀਜੈ ॥",
      "transliteration": "a(n)t sabadh mathanee teh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਵਰਤੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "अंति सबद मथणी तिह दीजै ॥",
      "sourceLineId": "109398",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਲਹਿਜੈ ॥",
      "transliteration": "naam tupak ke sakal lahijai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल लहिजै ॥",
      "sourceLineId": "109399",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰੁਚੈ ਜਹਾ ਤਿਹ ਠਵਰ ਭਣਿਜੈ ॥੧੧੫੪॥",
      "transliteration": "ruchai jahaa teh Thavar bhanijai ||1154||",
      "translation": "Saying the word “Manushyani” in the beginning, add the word “mathani” at the end and know all the names of Tupak.1154.",
      "punjabiViakhya": "ਜਿਥੇ ਚਿਤ ਕਰੇ, ਉਥੇ ਵਰਤੋ ॥੧੧੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "रुचै जहा तिह ठवर भणिजै ॥११५४॥",
      "sourceLineId": "109400",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਰਣੀ ਆਦਿ ਉਚਾਰਣ ਕੀਜੈ ॥",
      "transliteration": "naranee aadh uchaaran keejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਨਰਣੀ' ਸ਼ਬਦ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "नरणी आदि उचारण कीजै ॥",
      "sourceLineId": "109401",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਰਿਣੀ ਅੰਤਿ ਸਬਦ ਤਿਹ ਦੀਜੈ ॥",
      "transliteration": "arinee a(n)t sabadh teh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "अरिणी अंति सबद तिह दीजै ॥",
      "sourceLineId": "109402",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਕੇ ਜਾਨਹੁ ॥",
      "transliteration": "sabh sree naam tupak ke jaanahu ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक के जानहु ॥",
      "sourceLineId": "109403",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਯਾ ਮੈ ਭੇਦ ਨ ਨੈਕੁ ਪ੍ਰਮਾਨਹੁ ॥੧੧੫੫॥",
      "transliteration": "yaa mai bhedh na naik pramaanahu ||1155||",
      "translation": "Saying firstly the word “Narni”, add the word “arini” and know all the names of Tupak without any discrimination.1155.",
      "punjabiViakhya": "ਇਸ ਵਿਚ ਕਿਸੇ ਪ੍ਰਕਾਰ ਦਾ ਕੋਈ ਭੇਦ ਨਾ ਸਮਝੋ ॥੧੧੫੫॥",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "या मै भेद न नैकु प्रमानहु ॥११५५॥",
      "sourceLineId": "109404",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਾਨਵਨੀ ਸਬਦਾਦਿ ਭਣਿਜੈ ॥",
      "transliteration": "maanavanee sabadhaadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਮਾਨਵਨੀ' ਪਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "मानवनी सबदादि भणिजै ॥",
      "sourceLineId": "109405",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਾ ਕੇ ਅੰਤਿ ਸਤ੍ਰੁ ਪਦ ਦਿਜੈ ॥",
      "transliteration": "taa ke a(n)t satr padh dhijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਸਤ੍ਰੁ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "ता के अंति सत्रु पद दिजै ॥",
      "sourceLineId": "109406",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਲਹੀਜੈ ॥",
      "transliteration": "naam tupak ke sakal laheejai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल लहीजै ॥",
      "sourceLineId": "109407",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਭਾ ਮਧਿ ਬਿਨੁ ਸੰਕ ਕਹੀਜੈ ॥੧੧੫੬॥",
      "transliteration": "sabhaa madh bin sa(n)k kaheejai ||1156||",
      "translation": "Saying firstly the word “manavni”, add the word “Shatru” at the end and know all the names of Tupak without any doubt.1156.",
      "punjabiViakhya": "ਸਭਾ ਵਿਚ ਬਿਨਾ ਸੰਗ ਕਹਿ ਦਿਓ ॥੧੧੫੬॥",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "सभा मधि बिनु संक कहीजै ॥११५६॥",
      "sourceLineId": "109408",
      "sourceShabadId": "9625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "109409",
      "sourceShabadId": "9626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪ੍ਰਿਥੀਰਾਟਨੀ ਆਦਿ ਉਚਾਰਨ ਕੀਜੀਐ ॥",
      "transliteration": "piratheeraaTanee aadh uchaaran keejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਪ੍ਰਿਥੀਰਾਟਨੀ' (ਰਾਜੇ ਦੀ ਸੈਨਾ) (ਸ਼ਬਦ) ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "पृथीराटनी आदि उचारन कीजीऐ ॥",
      "sourceLineId": "109410",
      "sourceShabadId": "9626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਰਿਣੀ ਤਾ ਕੇ ਅੰਤ ਸਬਦ ਕੋ ਦੀਜੀਐ ॥",
      "transliteration": "arinee taa ke a(n)t sabadh ko dheejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "अरिणी ता के अंत सबद को दीजीऐ ॥",
      "sourceLineId": "109411",
      "sourceShabadId": "9626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਜਾਨ ਜੀਅ ਲੀਜੀਐ ॥",
      "transliteration": "sakal tupak ke naam jaan jeea leejeeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਮਨ ਵਿਚ ਤੁਪਕ ਦਾ ਨਾਮ ਜਾਣ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम जान जीअ लीजीऐ ॥",
      "sourceLineId": "109412",
      "sourceShabadId": "9626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹੋ ਇਨ ਕੇ ਕਹਤ ਨ ਸੰਕਾ ਮਨ ਮੈ ਕੀਜੀਐ ॥੧੧੫੭॥",
      "transliteration": "ho in ke kahat na sa(n)kaa man mai keejeeaai ||1157||",
      "translation": "Saying firstly the word “Prithi-raatnani”, add the word “arini” at the end and know all the names of Tupak without any doubt.1157.",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਕਹਿਣ ਲਈ ਮਨ ਵਿਚ ਸੰਸਾ ਨਾ ਕਰੋ ॥੧੧੫੭॥",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "हो इन के कहत न संका मन मै कीजीऐ ॥११५७॥",
      "sourceLineId": "109413",
      "sourceShabadId": "9626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "109414",
      "sourceShabadId": "9627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਛਿਤਣੀਸਣੀ ਪਦਾਦਿ ਭਣਿਜੈ ॥",
      "transliteration": "chhitaneesanee padhaadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਛਿਤਣੀਸਣੀ' ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "छितणीसणी पदादि भणिजै ॥",
      "sourceLineId": "109415",
      "sourceShabadId": "9627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਰਿਣੀ ਪਦ ਕੋ ਬਹੁਰਿ ਕਹਿਜੈ ॥",
      "transliteration": "arinee padh ko bahur kahijai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਅਰਣੀ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "अरिणी पद को बहुरि कहिजै ॥",
      "sourceLineId": "109416",
      "sourceShabadId": "9627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਬਖਾਨਹੁ ॥",
      "transliteration": "naam tupak ke sakal bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल बखानहु ॥",
      "sourceLineId": "109417",
      "sourceShabadId": "9627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਕਲ ਸਭਾ ਮੈ ਪ੍ਰਗਟ ਪ੍ਰਮਾਨਹੁ ॥੧੧੫੮॥",
      "transliteration": "sakal sabhaa mai pragaT pramaanahu ||1158||",
      "translation": "Saying the word “Kshiti-neeshani”, utter the word “arini” and speak all the names of Tupak.1158.",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਸਾਰੀ ਸਭਾ ਵਿਚ ਡਟ ਕੇ ਕਹੋ ॥੧੧੫੮॥",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "सकल सभा मै प्रगट प्रमानहु ॥११५८॥",
      "sourceLineId": "109418",
      "sourceShabadId": "9627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਛਤ੍ਰਿਸਣੀ ਸਬਦਾਦਿ ਭਣਿਜੈ ॥",
      "transliteration": "chhatirasanee sabadhaadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਛਤ੍ਰਿਸਣੀ' (ਰਾਜ ਸੈਨਾ) ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "छतृसणी सबदादि भणिजै ॥",
      "sourceLineId": "109419",
      "sourceShabadId": "9627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅੰਤਿ ਸਬਦ ਮਥਣੀ ਤਿਹ ਦਿਜੈ ॥",
      "transliteration": "a(n)t sabadh mathanee teh dhijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "अंति सबद मथणी तिह दिजै ॥",
      "sourceLineId": "109420",
      "sourceShabadId": "9627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪਛਾਨਹੁ ॥",
      "transliteration": "sakal tupak ke naam pachhaanahu ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਪਛਾਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम पछानहु ॥",
      "sourceLineId": "109421",
      "sourceShabadId": "9627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਯਾ ਮੈ ਭੇਦ ਨੈਕੁ ਨਹੀ ਜਾਨਹੁ ॥੧੧੫੯॥",
      "transliteration": "yaa mai bhedh naik nahee jaanahu ||1159||",
      "translation": "Saying firstly the word “Kshatriyeshani”, add the word “mathani” at the end and recognize all the names of Tapak without any discrimination.1159.",
      "punjabiViakhya": "ਇਸ ਵਿਚ ਰਤਾ ਜਿੰਨਾ ਵੀ ਅੰਤਰ ਨਾ ਸਮਝੋ ॥੧੧੫੯॥",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "या मै भेद नैकु नही जानहु ॥११५९॥",
      "sourceLineId": "109422",
      "sourceShabadId": "9627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਛਮਿ ਇਸਣੀ ਸਬਦਾਦਿ ਉਚਾਰੋ ॥",
      "transliteration": "chham isanee sabadhaadh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਛਮਿ ਇਸਣੀ' (ਰਾਜੇ ਦੀ ਸੈਨਾ) ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "छमि इसणी सबदादि उचारो ॥",
      "sourceLineId": "109423",
      "sourceShabadId": "9627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਥਣੀ ਸਬਦ ਅੰਤਿ ਤਿਹ ਡਾਰੋ ॥",
      "transliteration": "mathanee sabadh a(n)t teh ddaaro ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "मथणी सबद अंति तिह डारो ॥",
      "sourceLineId": "109424",
      "sourceShabadId": "9627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਲਹਿ ਲੀਜੈ ॥",
      "transliteration": "naam tupak ke sabh leh leejai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ लहि लीजै ॥",
      "sourceLineId": "109425",
      "sourceShabadId": "9627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0793_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਦਾ ਸੁਨਤ ਬੁਧਿਜਨਨ ਭਣੀਜੈ ॥੧੧੬੦॥",
      "transliteration": "sadhaa sunat budhijanan bhaneejai ||1160||",
      "translation": "Saying the word “Kshmeshani”, add the word “mathani” and know the names of Tupak for causing the wise men to listen to them.1160.",
      "punjabiViakhya": "ਬੁੱਧੀਮਾਨਾ ਵਿਚ ਸੁਣਾ ਕੇ ਕਹਿ ਦਿਓ ॥੧੧੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 793,
      "hindi": "",
      "hindiTransliteration": "सदा सुनत बुधिजनन भणीजै ॥११६०॥",
      "sourceLineId": "109426",
      "sourceShabadId": "9627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
