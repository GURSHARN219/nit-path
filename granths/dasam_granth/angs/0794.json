  "lines": [
    {
      "id": "dasam_ang_0794_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰੂਆਮਲ ਛੰਦ ॥",
      "transliteration": "rooaamal chha(n)dh ||",
      "translation": "ROOAMAL STANZA",
      "punjabiViakhya": "ਰੂਆਮਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "रूआमल छंद ॥",
      "sourceLineId": "109427",
      "sourceShabadId": "9628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਧਰਤੀਸਣਿ ਆਦਿ ਬਖਾਨ ॥",
      "transliteration": "dharateesan aadh bakhaan ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਧਰਤੀਸਣਿ' (ਸ਼ਬਦ) ਬਖਾਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "धरतीसणि आदि बखान ॥",
      "sourceLineId": "109428",
      "sourceShabadId": "9628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਰਿ ਸਬਦ ਅੰਤਿ ਪ੍ਰਮਾਨ ॥",
      "transliteration": "ar sabadh a(n)t pramaan ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "अरि सबद अंति प्रमान ॥",
      "sourceLineId": "109429",
      "sourceShabadId": "9628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਭ ਚੀਨ ਨਾਮ ਤੁਫੰਗ ॥",
      "transliteration": "sabh cheen naam tufa(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਫੰਗ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "सभ चीन नाम तुफंग ॥",
      "sourceLineId": "109430",
      "sourceShabadId": "9628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਭ ਠਵਰ ਭਨਹੁ ਨਿਸੰਗ ॥੧੧੬੧॥",
      "transliteration": "sabh Thavar bhanahu nisa(n)g ||1161||",
      "translation": "Saying the word “Dharneeshani”, add the word “ari” at the end and recognize the names of Tupak.1161.",
      "punjabiViakhya": "ਸਭ ਥਾ ਨਿਸੰਗ ਹੋ ਕੇ ਕਹਿ ਦਿਓ ॥੧੧੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "सभ ठवर भनहु निसंग ॥११६१॥",
      "sourceLineId": "109431",
      "sourceShabadId": "9628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "109432",
      "sourceShabadId": "9629",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਧਵਲ ਧਰਿਸਣੀ ਪਦ ਕੋ ਪ੍ਰਿਥਮ ਉਚਾਰੀਐ ॥",
      "transliteration": "dhaval dharisanee padh ko piratham uchaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਧਵਲ ਧਰਿਸਣੀ' (ਰਾਜੇ ਦੀ ਸੈਨਾ) ਪਦ ਨੂੰ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "धवल धरिसणी पद को पृथम उचारीऐ ॥",
      "sourceLineId": "109433",
      "sourceShabadId": "9629",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਰਿਣੀ ਤਾ ਕੇ ਅੰਤਿ ਸਬਦ ਕੋ ਡਾਰੀਐ ॥",
      "transliteration": "arinee taa ke a(n)t sabadh ko ddaareeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "अरिणी ता के अंति सबद को डारीऐ ॥",
      "sourceLineId": "109434",
      "sourceShabadId": "9629",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਮਿਤ ਤੁਪਕ ਕੇ ਨਾਮ ਚਤੁਰ ਲਹਿ ਲੀਜੀਐ ॥",
      "transliteration": "amit tupak ke naam chatur leh leejeeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਚਤੁਰ ਲੋਗੋ! ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "अमित तुपक के नाम चतुर लहि लीजीऐ ॥",
      "sourceLineId": "109435",
      "sourceShabadId": "9629",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਹੋ ਸਕਲ ਬੁਧਿਜਨ ਸੁਨਤ ਉਚਾਰਨ ਕੀਜੀਐ ॥੧੧੬੨॥",
      "transliteration": "ho sakal budhijan sunat uchaaran keejeeaai ||1162||",
      "translation": "Saying firstly the word “Dhaval-Dhareeshani”, add the word “arini” at the end and know cleverly the innumerable names of Tupak.1162.",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਸਾਰੇ ਬੁੱਧੀਜਨਾ ਦੇ ਸੁਣਦੇ ਹੋਇਆਂ ਉਚਾਰਨ ਕਰੋ ॥੧੧੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "हो सकल बुधिजन सुनत उचारन कीजीऐ ॥११६२॥",
      "sourceLineId": "109436",
      "sourceShabadId": "9629",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "109437",
      "sourceShabadId": "9630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬ੍ਰਿਖਭ ਧਰਿਸਣੀ ਆਦਿ ਬਖਾਨੋ ॥",
      "transliteration": "birakhabh dharisanee aadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬ੍ਰਿਖਭ ਧਰਿਸਣੀ' (ਰਾਜੇ ਦੀ ਸੈਨਾ) (ਸ਼ਬਦ) ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "बृखभ धरिसणी आदि बखानो ॥",
      "sourceLineId": "109438",
      "sourceShabadId": "9630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਰਿ ਪਦ ਅੰਤਿ ਤਵਨ ਕੇ ਠਾਨੋ ॥",
      "transliteration": "ar padh a(n)t tavan ke Thaano ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿ' ਪਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "अरि पद अंति तवन के ठानो ॥",
      "sourceLineId": "109439",
      "sourceShabadId": "9630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਲਹਿ ਲਿਜੈ ॥",
      "transliteration": "naam tupak ke sabh leh lijai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ लहि लिजै ॥",
      "sourceLineId": "109440",
      "sourceShabadId": "9630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਕਲ ਸਭਾ ਤੇ ਸੁਣਤ ਭਣਿਜੈ ॥੧੧੬੩॥",
      "transliteration": "sakal sabhaa te sunat bhanijai ||1163||",
      "translation": "Saying firstly the word “Vrashabh-Dhareeshani”, add the word “ari” at the end and know all the names of Tupak.1163.",
      "punjabiViakhya": "ਸਭ ਇਸ ਨੂੰ ਨਿਸੰਗ ਹੋ ਕੇ ਸਭਾ ਵਿਚ ਕਹੋ ॥੧੧੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "सकल सभा ते सुणत भणिजै ॥११६३॥",
      "sourceLineId": "109441",
      "sourceShabadId": "9630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਧਾਵਲੇਸਣੀ ਆਦਿ ਬਖਾਨੋ ॥",
      "transliteration": "dhaavalesanee aadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਧਾਵਲੇਸਣੀ' (ਸ਼ਬਦ) ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "धावलेसणी आदि बखानो ॥",
      "sourceLineId": "109442",
      "sourceShabadId": "9630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਥਣੀ ਸਬਦ ਅੰਤਿ ਤਿਹ ਠਾਨੋ ॥",
      "transliteration": "mathanee sabadh a(n)t teh Thaano ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "मथणी सबद अंति तिह ठानो ॥",
      "sourceLineId": "109443",
      "sourceShabadId": "9630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਪਛਾਨੀਐ ॥",
      "transliteration": "naam tupak ke sakal pachhaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल पछानीऐ ॥",
      "sourceLineId": "109444",
      "sourceShabadId": "9630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਕਲ ਬੁਧਿਜਨ ਸੁਨਤ ਬਖਾਨੀਐ ॥੧੧੬੪॥",
      "transliteration": "sakal budhijan sunat bakhaaneeaai ||1164||",
      "translation": "Saying firstly the word “Dhaavleshani”, add the word “mathani” at the end and know all the names of Tupak.1164.",
      "punjabiViakhya": "ਸਾਰੇ ਬੁੱਧੀਮਾਨਾ ਦੇ ਸੁਣਦੇ ਹੋਇਆਂ ਬਖਾਨ ਕਰੋ ॥੧੧੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "सकल बुधिजन सुनत बखानीऐ ॥११६४॥",
      "sourceLineId": "109445",
      "sourceShabadId": "9630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "109446",
      "sourceShabadId": "9631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਆਦਿ ਧਵਲਇਸਣੀ ਸਬਦਾਦਿ ਬਖਾਨੀਐ ॥",
      "transliteration": "aadh dhavalisanee sabadhaadh bakhaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਧਵਲ ਇਸਣੀ' ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "आदि धवलइसणी सबदादि बखानीऐ ॥",
      "sourceLineId": "109447",
      "sourceShabadId": "9631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਾ ਕੇ ਅਰਿਣੀ ਅੰਤਿ ਸਬਦ ਕੋ ਠਾਨੀਐ ॥",
      "transliteration": "taa ke arinee a(n)t sabadh ko Thaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "ता के अरिणी अंति सबद को ठानीऐ ॥",
      "sourceLineId": "109448",
      "sourceShabadId": "9631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਚਤੁਰ ਲਹਿ ਲੀਜੀਐ ॥",
      "transliteration": "sakal tupak ke naam chatur leh leejeeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਚਤੁਰ ਲੋਗੋ! ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम चतुर लहि लीजीऐ ॥",
      "sourceLineId": "109449",
      "sourceShabadId": "9631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹੋ ਗੁਨੀਜਨਨ ਕੀ ਸਭਾ ਉਚਾਰਨ ਕੀਜੀਐ ॥੧੧੬੫॥",
      "transliteration": "ho guneejanan kee sabhaa uchaaran keejeeaai ||1165||",
      "translation": "Saying firstly the word “Dhaval-ishani”, add the word “arini” at the end and know all the names of Tupak for pronouncing before the talented persons.1165.",
      "punjabiViakhya": "ਇਸ ਦਾ ਗੁਣੀ-ਲੋਕਾ ਦੀ ਸਭਾ ਵਿਚ ਉਚਾਰਨ ਕਰੋ ॥੧੧੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "हो गुनीजनन की सभा उचारन कीजीऐ ॥११६५॥",
      "sourceLineId": "109450",
      "sourceShabadId": "9631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪ੍ਰਿਥਮ ਬ੍ਰਿਖਭਣੀਇਸਣੀ ਸਬਦ ਉਚਾਰੀਐ ॥",
      "transliteration": "piratham birakhabhaneeisanee sabadh uchaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬ੍ਰਿਖਭਣੀ ਇਸਣੀ' (ਸੈਨਾ) ਸ਼ਬਦ ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "पृथम बृखभणीइसणी सबद उचारीऐ ॥",
      "sourceLineId": "109451",
      "sourceShabadId": "9631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਥਣੀ ਤਾ ਕੇ ਅੰਤਿ ਸਬਦ ਕੋ ਡਾਰੀਐ ॥",
      "transliteration": "mathanee taa ke a(n)t sabadh ko ddaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "मथणी ता के अंति सबद को डारीऐ ॥",
      "sourceLineId": "109452",
      "sourceShabadId": "9631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਚੀਨ ਲੈ ਚਤੁਰ ਚਿਤ ॥",
      "transliteration": "sakal tupak ke naam cheen lai chatur chit ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਚਤੁਰ ਲੋਗੋ! ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम चीन लै चतुर चित ॥",
      "sourceLineId": "109453",
      "sourceShabadId": "9631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਹੋ ਕਾਬਿ ਕਥਾ ਮੈ ਦੀਜੈ ਅਉ ਭੀਤਰ ਕਬਿਤ ॥੧੧੬੬॥",
      "transliteration": "ho kaab kathaa mai dheejai aau bheetar kabit ||1166||",
      "translation": "Saying the word “Vrashabhani-Ishani”, add the word “mathani” at the end and know all names of Tupak in your mind1166.",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਕਾਵਿ ਕਥਾ ਜਾ ਕਬਿੱਤਾ ਵਿਚ ਵਰਤੋ ॥੧੧੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "हो काबि कथा मै दीजै अउ भीतर कबित ॥११६६॥",
      "sourceLineId": "109454",
      "sourceShabadId": "9631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗਾਵਿਸਇਸਣੀ ਸਬਦਹਿ ਆਦਿ ਉਚਾਰੀਐ ॥",
      "transliteration": "gaavisisanee sabadheh aadh uchaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਗਾਵਿਸ ਇਸਣੀ' ਸ਼ਬਦ ਨੂੰ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "गाविसइसणी सबदहि आदि उचारीऐ ॥",
      "sourceLineId": "109455",
      "sourceShabadId": "9631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਰਿਣੀ ਤਾ ਕੇ ਅੰਤਿ ਸਬਦ ਕੋ ਡਾਰੀਐ ॥",
      "transliteration": "arinee taa ke a(n)t sabadh ko ddaareeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਸ ਦੇ ਅੰਤ ਵਿਚ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "अरिणी ता के अंति सबद को डारीऐ ॥",
      "sourceLineId": "109456",
      "sourceShabadId": "9631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਸੁਘਰ ਲਹਿ ਲੀਜੀਅਹਿ ॥",
      "transliteration": "sakal tupak ke naam sughar leh leeje'eeh ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम सुघर लहि लीजीअहि ॥",
      "sourceLineId": "109457",
      "sourceShabadId": "9631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਹੋ ਕਬਿਤ ਕਾਬਿ ਕੇ ਬੀਚ ਨਿਡਰ ਹੁਇ ਦੀਜੀਅਹਿ ॥੧੧੬੭॥",
      "transliteration": "ho kabit kaab ke beech niddar hui dheeje'eeh ||1167||",
      "translation": "Saying firstly the word “Gaavis-Ishani”, add the word “arini” at the end and know the names of Tupak for using them in potry.1167.",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਕਬਿੱਤਾ ਅਤੇ ਕਬਿੱਤਾ ਵਿਚ ਨਿਸੰਗ ਹੋ ਕੇ ਵਰਤੋ ॥੧੧੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "हो कबित काबि के बीच निडर हुइ दीजीअहि ॥११६७॥",
      "sourceLineId": "109458",
      "sourceShabadId": "9631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭੁਵਿਸਣੀ ਪਦ ਪ੍ਰਿਥਮ ਉਚਾਰਨ ਕੀਜੀਐ ॥",
      "transliteration": "bhuvisanee padh piratham uchaaran keejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਭੁਵਿਸਣੀ' (ਰਾਜ ਸੈਨਾ) ਸ਼ਬਦ ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "भुविसणी पद पृथम उचारन कीजीऐ ॥",
      "sourceLineId": "109459",
      "sourceShabadId": "9631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮਥਣੀ ਤਾ ਕੇ ਅੰਤਿ ਸਬਦ ਕਹੁ ਦੀਜੀਐ ॥",
      "transliteration": "mathanee taa ke a(n)t sabadh kahu dheejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "मथणी ता के अंति सबद कहु दीजीऐ ॥",
      "sourceLineId": "109460",
      "sourceShabadId": "9631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਜਾਨ ਜੀਯ ਲੀਜੀਐ ॥",
      "transliteration": "sakal tupak ke naam jaan jeey leejeeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਮਨ ਵਿਚ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम जान जीय लीजीऐ ॥",
      "sourceLineId": "109461",
      "sourceShabadId": "9631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹੋ ਜਵਨ ਠਵਰ ਮੈ ਚਹੀਐ ਤਹ ਤੇ ਦੀਜੀਐ ॥੧੧੬੮॥",
      "transliteration": "ho javan Thavar mai chaheeaai teh te dheejeeaai ||1168||",
      "translation": "Saying firstly the word “Bhoomishani”, add the word “mathani” at the end and know all the names of Tupak for using as desired.1168.",
      "punjabiViakhya": "ਜਿਥੇ ਜੀ ਕਰੇ, ਇਸ ਦੀ ਵਰਤੋਂ ਕਰੋ ॥੧੧੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "हो जवन ठवर मै चहीऐ तह ते दीजीऐ ॥११६८॥",
      "sourceLineId": "109462",
      "sourceShabadId": "9631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "109463",
      "sourceShabadId": "9632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਉਰਵਿਸਣੀ ਸਬਦਾਦਿ ਭਣਿਜੈ ॥",
      "transliteration": "auravisanee sabadhaadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਉਰਵਿਸਣੀ' (ਰਾਜੇ ਦੀ ਸੈਨਾ) ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "उरविसणी सबदादि भणिजै ॥",
      "sourceLineId": "109464",
      "sourceShabadId": "9632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮਥਣੀ ਅੰਤਿ ਸਬਦ ਤਿਹ ਦਿਜੈ ॥",
      "transliteration": "mathanee a(n)t sabadh teh dhijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "मथणी अंति सबद तिह दिजै ॥",
      "sourceLineId": "109465",
      "sourceShabadId": "9632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਲਹਿਜਹਿ ॥",
      "transliteration": "sakal tupak ke naam lahijeh ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम लहिजहि ॥",
      "sourceLineId": "109466",
      "sourceShabadId": "9632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਰਬ ਠਵਰ ਬਿਨੁ ਸੰਕ ਭਣਿਜਹਿ ॥੧੧੬੯॥",
      "transliteration": "sarab Thavar bin sa(n)k bhanijeh ||1169||",
      "translation": "Saying firstly the word “Urvishani”, add the word “mathani” at the and know all the names of Tupak.1169.",
      "punjabiViakhya": "ਬਿਨਾ ਸੰਗ ਸਭ ਥਾਵਾ ਉਤੇ ਵਰਣਨ ਕਰੋ ॥੧੧੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "सरब ठवर बिनु संक भणिजहि ॥११६९॥",
      "sourceLineId": "109467",
      "sourceShabadId": "9632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਗਤੀਸਣੀ ਪਦਾਦਿ ਬਖਾਨੋ ॥",
      "transliteration": "jagateesanee padhaadh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਜਗਤੀਸਣੀ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "जगतीसणी पदादि बखानो ॥",
      "sourceLineId": "109468",
      "sourceShabadId": "9632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅੰਤਿ ਸਬਦ ਮਥਣੀ ਤਿਹ ਠਾਨੋ ॥",
      "transliteration": "a(n)t sabadh mathanee teh Thaano ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "अंति सबद मथणी तिह ठानो ॥",
      "sourceLineId": "109469",
      "sourceShabadId": "9632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪਛਾਨਹੁ ॥",
      "transliteration": "sakal tupak ke naam pachhaanahu ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਲੋਗ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम पछानहु ॥",
      "sourceLineId": "109470",
      "sourceShabadId": "9632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਯਾ ਮੈ ਭੇਦ ਰਤੀ ਨ ਪ੍ਰਮਾਨਹੁ ॥੧੧੭੦॥",
      "transliteration": "yaa mai bhedh ratee na pramaanahu ||1170||",
      "translation": "Saying firstly the word “Jagtaashani”, add the word “mathani” at the end and know the names of Tupak without any discrimination.1170.",
      "punjabiViakhya": "ਇਸ ਵਿਚ ਰਤਾ ਜਿੰਨਾ ਭੇਦ ਨਾ ਸਮਝੋ ॥੧੧੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "या मै भेद रती न प्रमानहु ॥११७०॥",
      "sourceLineId": "109471",
      "sourceShabadId": "9632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬਸੁਮਤੇਸਣੀ ਆਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "basumatesanee aadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬਸੁਮਤੇਸਣੀ' (ਰਾਜੇ ਦੀ ਸੈਨਾ) ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "बसुमतेसणी आदि उचरीऐ ॥",
      "sourceLineId": "109472",
      "sourceShabadId": "9632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਰਿਣੀ ਸਬਦ ਅੰਤਿ ਤਿਹ ਧਰੀਐ ॥",
      "transliteration": "arinee sabadh a(n)t teh dhareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "अरिणी सबद अंति तिह धरीऐ ॥",
      "sourceLineId": "109473",
      "sourceShabadId": "9632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0794_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਲਹਿ ਲਿਜਹਿ ॥",
      "transliteration": "naam tupak ke sabh leh lijeh ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 794,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ लहि लिजहि ॥",
      "sourceLineId": "109474",
      "sourceShabadId": "9632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
