{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 795,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0795_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਭਨ ਸੁਨਤ ਬਿਨੁ ਸੰਕ ਭਣਿਜਹਿ ॥੧੧੭੧॥",
      "transliteration": "sabhan sunat bin sa(n)k bhanijeh ||1171||",
      "translation": "Saying firstly the word “Vasumanteshani”, add the word ‘arini” at the and know all the names of Tupak.1171.",
      "punjabiViakhya": "ਸਭ ਦੇ ਸੁਣਦਿਆਂ ਨਿਸੰਗ ਹੋ ਕੇ ਕਹੋ ॥੧੧੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "सभन सुनत बिनु संक भणिजहि ॥११७१॥",
      "sourceLineId": "109475",
      "sourceShabadId": "9632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "109476",
      "sourceShabadId": "9633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਸੁਧੇਸਣੀ ਸਬਦ ਕੋ ਆਦਿ ਉਚਾਰੀਐ ॥",
      "transliteration": "basudhesanee sabadh ko aadh uchaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬਸੁਧੇਸਣੀ' (ਰਾਜ ਸੈਨਾ) ਸ਼ਬਦ ਨੂੰ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "बसुधेसणी सबद को आदि उचारीऐ ॥",
      "sourceLineId": "109477",
      "sourceShabadId": "9633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਾ ਕੇ ਮਥਣੀ ਅੰਤਿ ਸਬਦ ਕੋ ਡਾਰੀਐ ॥",
      "transliteration": "taa ke mathanee a(n)t sabadh ko ddaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "ता के मथणी अंति सबद को डारीऐ ॥",
      "sourceLineId": "109478",
      "sourceShabadId": "9633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਚਤੁਰ ਚਿਤ ਚੀਨ ਲੈ ॥",
      "transliteration": "sakal tupak ke naam chatur chit cheen lai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਾਰੇ ਚਤੁਰ ਜਨ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम चतुर चित चीन लै ॥",
      "sourceLineId": "109479",
      "sourceShabadId": "9633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹੋ ਜਵਨ ਠਵਰ ਮੈ ਚਹੋ ਤਹੀ ਤੇ ਸਬਦ ਦੈ ॥੧੧੭੨॥",
      "transliteration": "ho javan Thavar mai chaho tahee te sabadh dhai ||1172||",
      "translation": "Uttering the word “Vasundheshani”, add the word “mathani” at the end and know all the names of Tupak.1172.",
      "punjabiViakhya": "ਜਿਥੇ ਚਾਹੋ, ਉਥੇ ਹੀ ਇਸ ਦੀ ਵਰਤੋਂ ਕਰੋ ॥੧੧੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "हो जवन ठवर मै चहो तही ते सबद दै ॥११७२॥",
      "sourceLineId": "109480",
      "sourceShabadId": "9633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬੈਸੁੰਧੁਰਾਏਸਨੀ ਆਦਿ ਬਖਾਨੀਐ ॥",
      "transliteration": "baisu(n)dhuraaesanee aadh bakhaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬੈਸੁੰਧਰਾਏਸਣੀ' (ਰਾਜੇ ਦੀ ਸੈਨਾ) (ਸ਼ਬਦ) ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "बैसुँधुराएसनी आदि बखानीऐ ॥",
      "sourceLineId": "109481",
      "sourceShabadId": "9633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਰਿਣੀ ਤਾ ਕੇ ਅੰਤਿ ਸਬਦ ਕੋ ਠਾਨੀਐ ॥",
      "transliteration": "arinee taa ke a(n)t sabadh ko Thaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "अरिणी ता के अंति सबद को ठानीऐ ॥",
      "sourceLineId": "109482",
      "sourceShabadId": "9633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਜਾਨ ਚਤੁਰ ਜੀਅ ਲੀਜੀਅਹਿ ॥",
      "transliteration": "naam tupak ke jaan chatur jeea leeje'eeh ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਚਤੁਰ ਜਨ ਮਨ ਵਿਚ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝਣ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के जान चतुर जीअ लीजीअहि ॥",
      "sourceLineId": "109483",
      "sourceShabadId": "9633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਹੋ ਜਵਨ ਠਵਰ ਮੋ ਚਹੋ ਤਹੀ ਤੇ ਦੀਜੀਅਹਿ ॥੧੧੭੩॥",
      "transliteration": "ho javan Thavar mo chaho tahee te dheeje'eeh ||1173||",
      "translation": "Saying firstly the word “Vasundhreshani” add the word, “arini” at the end and know all the names of Tupak cleverly in your mind.1173.",
      "punjabiViakhya": "ਜਿਥੇ ਚਾਹੁਣ, ਉਥੇ ਹੀ ਇਸ ਦਾ ਕਥਨ ਕਰਨ ॥੧੧੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "हो जवन ठवर मो चहो तही ते दीजीअहि ॥११७३॥",
      "sourceLineId": "109484",
      "sourceShabadId": "9633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਸੁਮਤੇਸਣੀ ਪ੍ਰਿਥਮ ਸਬਦ ਕੋ ਭਾਖੀਐ ॥",
      "transliteration": "basumatesanee piratham sabadh ko bhaakheeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬਸੁਮਤੇਸਣੀ' (ਰਾਜ ਸੈਨਾ) ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "बसुमतेसणी पृथम सबद को भाखीऐ ॥",
      "sourceLineId": "109485",
      "sourceShabadId": "9633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਰਿਣੀ ਤਾ ਕੇ ਅੰਤਿ ਬਹੁਰਿ ਪਦ ਰਾਖੀਐ ॥",
      "transliteration": "arinee taa ke a(n)t bahur padh raakheeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "अरिणी ता के अंति बहुरि पद राखीऐ ॥",
      "sourceLineId": "109486",
      "sourceShabadId": "9633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਚਤੁਰ ਸਕਲ ਜੀਅ ਜਾਨੀਐ ॥",
      "transliteration": "naam tupak ke chatur sakal jeea jaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਸਿਆਣਿਓ! ਤੁਪਕ ਦਾ ਨਾਮ ਹਿਰਦੇ ਵਿਚ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के चतुर सकल जीअ जानीऐ ॥",
      "sourceLineId": "109487",
      "sourceShabadId": "9633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹੋ ਜਹਾ ਜਹਾ ਚਹੀਐ ਪਦ ਤਹੀ ਬਖਾਨੀਐ ॥੧੧੭੪॥",
      "transliteration": "ho jahaa jahaa chaheeaai padh tahee bakhaaneeaai ||1174||",
      "translation": "Saying firstly the word “Vasumteshani”, add the word “arini” at the end and know all the names of Tupak.1174.",
      "punjabiViakhya": "ਜਿਥੇ ਜਿਥੇ ਚਾਹੋ ਇਸ ਸ਼ਬਦ ਨੂੰ ਉਥੇ ਹੀ ਵਰਤੋ ॥੧੧੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "हो जहा जहा चहीऐ पद तही बखानीऐ ॥११७४॥",
      "sourceLineId": "109488",
      "sourceShabadId": "9633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "109489",
      "sourceShabadId": "9634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਾਮੁੰਦ੍ਰਣੀ ਏਸਣੀ ਕਹੀਐ ॥",
      "transliteration": "saamu(n)dhranee esanee kaheeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਪਹਿਲਾ) 'ਸਾਮੁੰਦ੍ਰਣੀ ਏਸਣੀ' (ਸ਼ਬਦ) ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "सामुँद्रणी एसणी कहीऐ ॥",
      "sourceLineId": "109490",
      "sourceShabadId": "9634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਰਿਣੀ ਅੰਤਿ ਸਬਦ ਕਹੁ ਗਹੀਐ ॥",
      "transliteration": "arinee a(n)t sabadh kahu gaheeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "अरिणी अंति सबद कहु गहीऐ ॥",
      "sourceLineId": "109491",
      "sourceShabadId": "9634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਲੇਹੁ ਸੁਜਨ ਜਨ ॥",
      "transliteration": "naam tupak ke leh sujan jan ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਸੁਜਾਨ ਪੁਰਸ਼ ਆਪਣੇ ਆਪਣੇ ਮਨ ਵਿਚ",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के लेहु सुजन जन ॥",
      "sourceLineId": "109492",
      "sourceShabadId": "9634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਪਨੇ ਅਪਨੇ ਬੀਚ ਸਕਲ ਮਨਿ ॥੧੧੭੫॥",
      "transliteration": "apane apane beech sakal man ||1175||",
      "translation": "Saying firstly the word “Samundra-neeshani”, speak the word “arini” and O good men! know the names of Tupak in your mind.1175",
      "punjabiViakhya": "ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲੈਣ ॥੧੧੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "अपने अपने बीच सकल मनि ॥११७५॥",
      "sourceLineId": "109493",
      "sourceShabadId": "9634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਾਮੁੰਦ੍ਰਣੀਏਸਣੀ ਭਾਖੋ ॥",
      "transliteration": "saamu(n)dhrane'eesanee bhaakho ||",
      "translation": "",
      "punjabiViakhya": "(ਪਹਿਲਾ) 'ਸਾਮੁੰਦ੍ਰਣੀ ਏਸਣੀ' (ਸ਼ਬਦ) ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "सामुँद्रणीएसणी भाखो ॥",
      "sourceLineId": "109494",
      "sourceShabadId": "9634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਰਿਣੀ ਸਬਦ ਅੰਤਿ ਤਿਹ ਰਾਖੋ ॥",
      "transliteration": "arinee sabadh a(n)t teh raakho ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "अरिणी सबद अंति तिह राखो ॥",
      "sourceLineId": "109495",
      "sourceShabadId": "9634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਲਹਿਜੈ ॥",
      "transliteration": "naam tupak ke sakal lahijai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਲੋਗ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल लहिजै ॥",
      "sourceLineId": "109496",
      "sourceShabadId": "9634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਕਲ ਸੁਕਬਿ ਜਨ ਸੁਨਤ ਭਣਿਜੈ ॥੧੧੭੬॥",
      "transliteration": "sakal sukab jan sunat bhanijai ||1176||",
      "translation": "Saying the word “Samundra-neeshani”, add the word “arini” and know all the names of Tupak.1176.",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਸਾਰੇ ਕਵੀਓ! ਸੁਣਾ ਕੇ ਵਰਤੋਂ ਵਿਚ ਲਿਆਓ ॥੧੧੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "सकल सुकबि जन सुनत भणिजै ॥११७६॥",
      "sourceLineId": "109497",
      "sourceShabadId": "9634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਚਲਾਇਸਣੀ ਆਦਿ ਭਣਿਜੈ ॥",
      "transliteration": "achalaisanee aadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਅਚਲਾ ਇਸਣੀ' (ਸੈਨਾ) (ਪਦ) ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "अचलाइसणी आदि भणिजै ॥",
      "sourceLineId": "109498",
      "sourceShabadId": "9634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਥਣੀ ਸਬਦ ਅੰਤਿ ਤਿਹ ਦਿਜੈ ॥",
      "transliteration": "mathanee sabadh a(n)t teh dhijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "मथणी सबद अंति तिह दिजै ॥",
      "sourceLineId": "109499",
      "sourceShabadId": "9634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਲਹੀਜੈ ॥",
      "transliteration": "sakal tupak ke naam laheejai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦੇ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम लहीजै ॥",
      "sourceLineId": "109500",
      "sourceShabadId": "9634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਵਨ ਠਵਰ ਚਹੀਐ ਤਹ ਦੀਜੈ ॥੧੧੭੭॥",
      "transliteration": "javan Thavar chaheeaai teh dheejai ||1177||",
      "translation": "Saying firstly the word “Achleshni”, add the word “mathani” at the end and know the names of Tupak for using them as desired.1177.",
      "punjabiViakhya": "ਜਿਥੇ ਚਾਹੋ, ਇਸ ਦੀ ਵਰਤੋਂ ਕਰੋ ॥੧੧੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "जवन ठवर चहीऐ तह दीजै ॥११७७॥",
      "sourceLineId": "109501",
      "sourceShabadId": "9634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਵਿਪਲੀਸਿਣੀ ਪਦਾਦਿ ਉਚਾਰੋ ॥",
      "transliteration": "vipaleesinee padhaadh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਵਿਪਲੀਸਿਣੀ' (ਧਰਤੀ ਦੇ ਸੁਆਮੀ ਦੀ ਸੈਨਾ) ਪਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "विपलीसिणी पदादि उचारो ॥",
      "sourceLineId": "109502",
      "sourceShabadId": "9634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਰਿਣੀ ਸਬਦ ਅੰਤਿ ਤਿਹ ਧਾਰੋ ॥",
      "transliteration": "arinee sabadh a(n)t teh dhaaro ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "अरिणी सबद अंति तिह धारो ॥",
      "sourceLineId": "109503",
      "sourceShabadId": "9634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪਛਾਨੋ ॥",
      "transliteration": "sakal tupak ke naam pachhaano ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम पछानो ॥",
      "sourceLineId": "109504",
      "sourceShabadId": "9634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਯਾ ਮੈ ਭੇਦ ਨ ਰੰਚਕ ਜਾਨੋ ॥੧੧੭੮॥",
      "transliteration": "yaa mai bhedh na ra(n)chak jaano ||1178||",
      "translation": "Saying firstly the word “Vipleeshani”, add the word “arini” at the end and recognize all the names of Tupak without any discrimination1178.",
      "punjabiViakhya": "ਇਸ ਵਿਚ ਜ਼ਰਾ ਜਿੰਨਾ ਕੋਈ ਭੇਦ ਨਾ ਸਮਝੋ ॥੧੧੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "या मै भेद न रंचक जानो ॥११७८॥",
      "sourceLineId": "109505",
      "sourceShabadId": "9634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "109506",
      "sourceShabadId": "9635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਆਦਿ ਸਾਗਰਾ ਸਬਦ ਬਖਾਨਨ ਕੀਜੀਐ ॥",
      "transliteration": "aadh saagaraa sabadh bakhaanan keejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸਾਗਰਾ' (ਧਰਤੀ) ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "आदि सागरा सबद बखानन कीजीऐ ॥",
      "sourceLineId": "109507",
      "sourceShabadId": "9635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਏਸ ਦਰਰਨੀ ਅੰਤਿ ਤਵਨ ਕੋ ਦੀਜੀਐ ॥",
      "transliteration": "es dhararanee a(n)t tavan ko dheejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਏਸ ਦਰਰਨੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "एस दररनी अंति तवन को दीजीऐ ॥",
      "sourceLineId": "109508",
      "sourceShabadId": "9635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਸੁਘਰ ਲਹਿ ਲੀਜੀਅਹਿ ॥",
      "transliteration": "sakal tupak ke naam sughar leh leeje'eeh ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਸੁਘੜੋ! ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम सुघर लहि लीजीअहि ॥",
      "sourceLineId": "109509",
      "sourceShabadId": "9635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹੋ ਕਬਿਤ ਕਾਬਿ ਕੇ ਬੀਚ ਚਹੋ ਤਹ ਦੀਜੀਅਹਿ ॥੧੧੭੯॥",
      "transliteration": "ho kabit kaab ke beech chaho teh dheeje'eeh ||1179||",
      "translation": "Saying firstly the word “Saagraa”, add the word “Ish-dalanani” and know all the names of Tupak for using them in poetry.1179.",
      "punjabiViakhya": "ਜਿਥੇ ਚਾਹੋ, ਕਬਿੱਤਾ ਅਤੇ ਕਾਵਿ ਵਿਚ ਵਰਤੋ ॥੧੧੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "हो कबित काबि के बीच चहो तह दीजीअहि ॥११७९॥",
      "sourceLineId": "109510",
      "sourceShabadId": "9635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਹਾਅਰਣਵੀ ਸਬਦਹਿ ਆਦਿ ਉਚਾਰੀਐ ॥",
      "transliteration": "mahaaranavee sabadheh aadh uchaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਮਹਾਅਰਣਵੀ' ਸ਼ਬਦ ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "महाअरणवी सबदहि आदि उचारीऐ ॥",
      "sourceLineId": "109511",
      "sourceShabadId": "9635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪਤਿ ਮਰਦਨਨੀਹ ਅੰਤਿ ਸਬਦ ਕਹੁ ਡਾਰੀਐ ॥",
      "transliteration": "pat maradhananeeh a(n)t sabadh kahu ddaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਤੇ 'ਪਤਿ ਮਰਦਨਨੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "पति मरदननीह अंति सबद कहु डारीऐ ॥",
      "sourceLineId": "109512",
      "sourceShabadId": "9635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਜਾਨ ਜੀਯ ਰਾਖਅਹਿ ॥",
      "transliteration": "naam tupak ke sakal jaan jeey raakheh ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਕੇ ਹਿਰਦੇ ਵਿਚ ਰਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल जान जीय राखअहि ॥",
      "sourceLineId": "109513",
      "sourceShabadId": "9635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹੋ ਸਕਲ ਸੁਜਨ ਜਨ ਸੁਨਤ ਨਿਡਰ ਹੁਇ ਭਾਖੀਅਹਿ ॥੧੧੮੦॥",
      "transliteration": "ho sakal sujan jan sunat niddar hui bhaakhe'eeh ||1180||",
      "translation": "Saying firstly the word “Mahaa-ranavi”, add the word “Pat-mardanani” at eh end and fearlessly know all the names of Tupak.1180.",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਸੁਜਾਨਾ ਦੀ ਸਭਾ ਵਿਚ ਨਿਸੰਗ ਹੋ ਕੇ ਕਹੋ ॥੧੧੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "हो सकल सुजन जन सुनत निडर हुइ भाखीअहि ॥११८०॥",
      "sourceLineId": "109514",
      "sourceShabadId": "9635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "109515",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਆਦਿ ਸਿੰਧੁਣੀ ਸਬਦ ਭਣੀਜੈ ॥",
      "transliteration": "aadh si(n)dhunee sabadh bhaneejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸਿੰਧਣੀ' (ਧਰਤੀ) ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "आदि सिंधुणी सबद भणीजै ॥",
      "sourceLineId": "109516",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪਤਿ ਅਰਦਨੀ ਪਦਾਤ ਕਹੀਜੈ ॥",
      "transliteration": "pat aradhanee padhaat kaheejai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਅੰਤ ਉਤੇ 'ਪਤਿ ਅਰਦਨੀ' ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "पति अरदनी पदात कहीजै ॥",
      "sourceLineId": "109517",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਕੇ ਲਹੋ ॥",
      "transliteration": "sabh sree naam tupak ke laho ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਲੋਗ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक के लहो ॥",
      "sourceLineId": "109518",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਕਲ ਸੁਜਨ ਜਨ ਸੁਨਤੇ ਕਹੋ ॥੧੧੮੧॥",
      "transliteration": "sakal sujan jan sunate kaho ||1181||",
      "translation": "Saying firstly the word “Sindhuni”, add the word “ardani” afterwards and know all the names of Tupak.1181.",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਸਾਰੇ ਵਿਦਵਾਨਾ ਨੂੰ ਸੁਣਾ ਕੇ ਕਥਨ ਕਰੋ ॥੧੧੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "सकल सुजन जन सुनते कहो ॥११८१॥",
      "sourceLineId": "109519",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨੀਰਾਲਯਨੀ ਆਦਿ ਉਚਰੋ ॥",
      "transliteration": "neeraalayanee aadh ucharo ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਨੀਰਾਲਯਨੀ' (ਧਰਤੀ) (ਸ਼ਬਦ) ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "नीरालयनी आदि उचरो ॥",
      "sourceLineId": "109520",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਾਇਕ ਅਰਿਣੀ ਪੁਨਿ ਪਦ ਧਰੋ ॥",
      "transliteration": "naik arinee pun padh dharo ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਨਾਇਕ ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 795,
      "hindi": "",
      "hindiTransliteration": "नाइक अरिणी पुनि पद धरो ॥",
      "sourceLineId": "109521",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0795_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪਛਾਨੋ ॥",
      "transliteration": "sakal tupak ke naam pachhaano ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
