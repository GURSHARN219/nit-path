{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 796,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0796_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਯਾ ਮੈ ਭੇਦ ਰਤੀਕੁ ਨ ਜਾਨੋ ॥੧੧੮੨॥",
      "transliteration": "yaa mai bhedh rateek na jaano ||1182||",
      "translation": "Saying the word “Neeraalayani”, add the word “Naasik-arini” and know all the names of Tupak without any discrimination.1182.",
      "punjabiViakhya": "ਇਸ ਵਿਚ ਇਕ ਰਤੀ ਜਿੰਨਾ ਭੇਦ ਨਾ ਮੰਨੋ ॥੧੧੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "या मै भेद रतीकु न जानो ॥११८२॥",
      "sourceLineId": "109523",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਆਦਿ ਜਲਾਲਯਣੀ ਪਦ ਦਿਜੈ ॥",
      "transliteration": "aadh jalaalayanee padh dhijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਜਲਾਲਯਣੀ' (ਧਰਤੀ) ਪਦ ਰਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "आदि जलालयणी पद दिजै ॥",
      "sourceLineId": "109524",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪਤਿ ਅਰਿਣੀ ਪਦ ਬਹੁਰਿ ਭਣਿਜੈ ॥",
      "transliteration": "pat arinee padh bahur bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਪਤਿ ਅਰਿਣੀ' ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "पति अरिणी पद बहुरि भणिजै ॥",
      "sourceLineId": "109525",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪਛਾਨਹੁ ॥",
      "transliteration": "sakal tupak ke naam pachhaanahu ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम पछानहु ॥",
      "sourceLineId": "109526",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਕਲ ਸੁਜਨ ਜਨ ਸੁਨਤ ਬਖਾਨਹੁ ॥੧੧੮੩॥",
      "transliteration": "sakal sujan jan sunat bakhaanahu ||1183||",
      "translation": "Saying firstly the word “Jaalayani” utter the words “Patiarini” and recognize all the names of Tupak.1183.",
      "punjabiViakhya": "ਸਾਰੇ ਸੁਜਾਨੋ! ਇਸ ਨੂੰ ਸੁਣ ਕੇ ਵਰਣਨ ਕਰੋ ॥੧੧੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "सकल सुजन जन सुनत बखानहु ॥११८३॥",
      "sourceLineId": "109527",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਾਰਿਧਣੀ ਸਬਦਾਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "baaridhanee sabadhaadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬਾਰਿਧਣੀ' (ਧਰਤੀ) ਸ਼ਬਦ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "बारिधणी सबदादि उचरीऐ ॥",
      "sourceLineId": "109528",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪਤਿ ਅਰਿ ਅੰਤਿ ਸਬਦ ਕੋ ਧਰੀਐ ॥",
      "transliteration": "pat ar a(n)t sabadh ko dhareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਤ ਉਤੇ 'ਪਤਿ ਅਰਿ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "पति अरि अंति सबद को धरीऐ ॥",
      "sourceLineId": "109529",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਕਹੀਜੈ ॥",
      "transliteration": "sakal tupak ke naam kaheejai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम कहीजै ॥",
      "sourceLineId": "109530",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਕਲ ਗੁਨਿਜਨਨ ਸੁਨਤ ਭਨੀਜੈ ॥੧੧੮੪॥",
      "transliteration": "sakal gunijanan sunat bhaneejai ||1184||",
      "translation": "Saying firstly the word “Vaaridhini”, add the word “Pati ari” and speak the names of Tupak for the talented people.1184.",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਸਾਰੇ ਗੁਣੀ ਜਨੋ! ਸੁਣ ਕੇ ਕਥਨ ਕਰੋ ॥੧੧੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "सकल गुनिजनन सुनत भनीजै ॥११८४॥",
      "sourceLineId": "109531",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਧਰਾਏਸਣੀ ਆਦਿ ਸਬਦ ਕਹਿ ॥",
      "transliteration": "dharaaesanee aadh sabadh keh ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਧਰਾਏਸਣੀ' ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "धराएसणी आदि सबद कहि ॥",
      "sourceLineId": "109532",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਥਣੀ ਅੰਤਿ ਤਵਨ ਕੇ ਪਦ ਗਹਿ ॥",
      "transliteration": "mathanee a(n)t tavan ke padh geh ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "मथणी अंति तवन के पद गहि ॥",
      "sourceLineId": "109533",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਲਹਿਜੈ ॥",
      "transliteration": "sakal tupak ke naam lahijai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम लहिजै ॥",
      "sourceLineId": "109534",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੰਕ ਛੋਰਿ ਬਿਨ ਸੰਕ ਭਣਿਜੈ ॥੧੧੮੫॥",
      "transliteration": "sa(n)k chhor bin sa(n)k bhanijai ||1185||",
      "translation": "Saying the word “Dhareshani” add the word “Mathani” at the end and know all the names of Tupak without any doubt.1185.",
      "punjabiViakhya": "ਸੰਗ ਛਡ ਕੇ ਨਿਸੰਗ ਹੋ ਕੇ ਕਥਨ ਕਰੋ ॥੧੧੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "संक छोरि बिन संक भणिजै ॥११८५॥",
      "sourceLineId": "109535",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਲੋਰਭਰੇਸਣੀ ਆਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "lorabharesanee aadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਉਰਬਰੇਸਣੀ' (ਰਾਜੇ ਦੀ ਸੈਨਾ) ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "लोरभरेसणी आदि उचरीऐ ॥",
      "sourceLineId": "109536",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅੰਤਿ ਸਬਦ ਮਥਣੀ ਕਹੁ ਧਰੀਐ ॥",
      "transliteration": "a(n)t sabadh mathanee kahu dhareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "अंति सबद मथणी कहु धरीऐ ॥",
      "sourceLineId": "109537",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਪਛਾਨਹੁ ॥",
      "transliteration": "sakal tupak ke naam pachhaanahu ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम पछानहु ॥",
      "sourceLineId": "109538",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੰਕ ਛੋਰਿ ਬਿਨੁ ਸੰਕ ਬਖਾਨਹੁ ॥੧੧੮੬॥",
      "transliteration": "sa(n)k chhor bin sa(n)k bakhaanahu ||1186||",
      "translation": "Saying the word “Lorbhareshani”, add the word “mathani” and recognize all the names of Tupak.1186.",
      "punjabiViakhya": "ਸ਼ੰਕਾ ਛਡ ਕੇ ਨਿਸੰਗ ਹੋ ਕੇ ਇਸ ਦਾ ਬਖਾਨ ਕਰੋ ॥੧੧੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "संक छोरि बिनु संक बखानहु ॥११८६॥",
      "sourceLineId": "109539",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੋਰਾ ਆਦਿ ਉਚਾਰਨ ਕੀਜੈ ॥",
      "transliteration": "goraa aadh uchaaran keejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਗੋਰਾ' (ਪ੍ਰਿਥਵੀ) (ਸ਼ਬਦ) ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "गोरा आदि उचारन कीजै ॥",
      "sourceLineId": "109540",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਏਸ ਅੰਤਕਣੀ ਅੰਤਿ ਭਣੀਜੈ ॥",
      "transliteration": "es a(n)takanee a(n)t bhaneejai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਅੰਤ ਉਤੇ 'ਏਸ ਅੰਤਕਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "एस अंतकणी अंति भणीजै ॥",
      "sourceLineId": "109541",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਪਛਾਨੋ ॥",
      "transliteration": "naam tupak ke sakal pachhaano ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ (ਇਸ ਨੂੰ) ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल पछानो ॥",
      "sourceLineId": "109542",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਹਾ ਰੁਚੈ ਤਿਹ ਠਵਰ ਪ੍ਰਮਾਨੋ ॥੧੧੮੭॥",
      "transliteration": "jahaa ruchai teh Thavar pramaano ||1187||",
      "translation": "Uttering the word “Goraa”, add the words “Ish-antakni” at the end and recognize all the names of Tupak.1187.",
      "punjabiViakhya": "ਜਿਥੇ ਜੀ ਕਰੇ, ਉਥੇ ਵਰਤੋ ॥੧੧੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "जहा रुचै तिह ठवर प्रमानो ॥११८७॥",
      "sourceLineId": "109543",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਵਨੇਸਣੀ ਪਦਾਦਿ ਕਹੀਜੈ ॥",
      "transliteration": "avanesanee padhaadh kaheejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਅਵਨੇਸਣੀ' (ਰਾਜ ਸੈਨਾ) ਸ਼ਬਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "अवनेसणी पदादि कहीजै ॥",
      "sourceLineId": "109544",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਥਣੀ ਸਬਦ ਅੰਤਿ ਤਿਹ ਦੀਜੈ ॥",
      "transliteration": "mathanee sabadh a(n)t teh dheejai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "मथणी सबद अंति तिह दीजै ॥",
      "sourceLineId": "109545",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਕੇ ਲਹੀਐ ॥",
      "transliteration": "sabh sree naam tupak ke laheeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक के लहीऐ ॥",
      "sourceLineId": "109546",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭੈ ਨਿਵਾਰਿ ਨਿਰਭੈ ਹੁਇ ਕਹੀਐ ॥੧੧੮੮॥",
      "transliteration": "bhai nivaar nirabhai hui kaheeaai ||1188||",
      "translation": "Saying the word “Avneeshani”, add the word “mathani” and know fearlessly all the names of Tupak.1188.",
      "punjabiViakhya": "ਭੈ ਨੂੰ ਤਿਆਗ ਕੇ ਨਿਡਰ ਹੋ ਕੇ ਡਟ ਕੇ ਕਹੋ ॥੧੧੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "भै निवारि निरभै हुइ कहीऐ ॥११८८॥",
      "sourceLineId": "109547",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦਿਗਜਨੀ ਸਬਦਾਦਿ ਭਣਿਜੈ ॥",
      "transliteration": "dhigajanee sabadhaadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਦਿਗਜਨੀ' (ਧਰਤੀ) ਸ਼ਬਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "दिगजनी सबदादि भणिजै ॥",
      "sourceLineId": "109548",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਏਸਾਰਦਨੀ ਅੰਤਿ ਕਹਿਜੈ ॥",
      "transliteration": "esaaradhanee a(n)t kahijai ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਤ ਉਤੇ 'ਏਸਾਰਦਨੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "एसारदनी अंति कहिजै ॥",
      "sourceLineId": "109549",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਕਲ ਸੁ ਨਾਮ ਤੁਪਕ ਕੇ ਚੀਨਹੁ ॥",
      "transliteration": "sakal su naam tupak ke cheenahu ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "सकल सु नाम तुपक के चीनहु ॥",
      "sourceLineId": "109550",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਹ ਚਾਹੋ ਤਹ ਕਹੋ ਪ੍ਰੀਬਨਹੁ ॥੧੧੮੯॥",
      "transliteration": "jeh chaaho teh kaho preebanahu ||1189||",
      "translation": "Saying firstly the word “Diggajani”, speak the word “Ishhaaradani” at the end and recognize the names of Tupak for using them according to your inclination.1189.",
      "punjabiViakhya": "ਜਿਥੇ ਚਾਹੋ, ਪ੍ਰਬੀਨੋ! ਉਥੇ ਵਰਤੋ ॥੧੧੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "जह चाहो तह कहो प्रीबनहु ॥११८९॥",
      "sourceLineId": "109551",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕੁੰਭਿਨੇਸਨੀ ਆਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "ku(n)bhinesanee aadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਕੁੰਭਿਨੇਸਨੀ' ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "कुँभिनेसनी आदि उचरीऐ ॥",
      "sourceLineId": "109552",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਰਿਣੀ ਅੰਤਿ ਸਬਦ ਕਹੁ ਧਰੀਐ ॥",
      "transliteration": "arinee a(n)t sabadh kahu dhareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "अरिणी अंति सबद कहु धरीऐ ॥",
      "sourceLineId": "109553",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਭੈ ਤੁਪਕ ਕੇ ਨਾਮ ਪਛਾਨੋ ॥",
      "transliteration": "sabhai tupak ke naam pachhaano ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "सभै तुपक के नाम पछानो ॥",
      "sourceLineId": "109554",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਯਾ ਮਹਿ ਝੂਠ ਨੈਕ ਨਹੀ ਜਾਨੋ ॥੧੧੯੦॥",
      "transliteration": "yaa meh jhooTh naik nahee jaano ||1190||",
      "translation": "Saying firstly the word “Kumbhaashini”, add the word “arini” at the end and recognize all the names of Tupak.1190.",
      "punjabiViakhya": "ਇਸ ਵਿਚ ਕੋਈ ਝੂਠ ਨਾ ਸਮਝੋ ॥੧੧੯੦॥",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "या महि झूठ नैक नही जानो ॥११९०॥",
      "sourceLineId": "109555",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮਹਿਏਸਣੀ ਪਦਾਦਿ ਭਣਿਜੈ ॥",
      "transliteration": "mahiesanee padhaadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਮਹਿ ਏਸਣੀ' (ਰਾਜ ਸੈਨਾ) ਸ਼ਬਦ ਦੀ ਵਰਤੋਂ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "महिएसणी पदादि भणिजै ॥",
      "sourceLineId": "109556",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਰਿਣੀ ਸਬਦ ਅੰਤਿ ਮਹਿ ਦਿਜੈ ॥",
      "transliteration": "arinee sabadh a(n)t meh dhijai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਅੰਤ ਵਿਚ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "अरिणी सबद अंति महि दिजै ॥",
      "sourceLineId": "109557",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਕਹੀਜੈ ॥",
      "transliteration": "sakal tupak ke naam kaheejai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम कहीजै ॥",
      "sourceLineId": "109558",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਹ ਹੀ ਚਹੋ ਤਹੀ ਲੈ ਦੀਜੈ ॥੧੧੯੧॥",
      "transliteration": "jeh hee chaho tahee lai dheejai ||1191||",
      "translation": "Saying firstly the word “Maheeshani”, add the word “arini” at the end and know all the names of Tupak.1191.",
      "punjabiViakhya": "ਜਿਥੇ ਚਾਹੋ ਉਥੇ ਹੀ ਵਰਤ ਲਵੋ ॥੧੧੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "जह ही चहो तही लै दीजै ॥११९१॥",
      "sourceLineId": "109559",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮੇਦਣੇਸਣੀ ਆਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "medhanesanee aadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਮੈਦਏਸਣੀ' ਸ਼ਬਦ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "मेदणेसणी आदि उचरीऐ ॥",
      "sourceLineId": "109560",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਘਾਰੀ ਅੰਤਿ ਸਬਦ ਕਹੁ ਧਰੀਐ ॥",
      "transliteration": "ghaaree a(n)t sabadh kahu dhareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਤ ਉਤੇ 'ਘਾਰੀ' (ਨਾਸ਼ਕ) ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "घारी अंति सबद कहु धरीऐ ॥",
      "sourceLineId": "109561",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਾਮ ਸੁ ਜਾਨ ਤੁਪਕ ਕੇ ਸਭ ਹੀ ॥",
      "transliteration": "naam su jaan tupak ke sabh hee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "नाम सु जान तुपक के सभ ही ॥",
      "sourceLineId": "109562",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚਾਹੋ ਜਹਾ ਉਚਰਹੁ ਤਬ ਹੀ ॥੧੧੯੨॥",
      "transliteration": "chaaho jahaa ucharahu tab hee ||1192||",
      "translation": "Placing firstly the word “Meneeshani”, add the word “Ghaayak” at the end and recognize all the names of Tupak.1192.",
      "punjabiViakhya": "ਜਿਥੇ ਚਾਹੋ, ਉਥੇ ਹੀ ਤਦ ਉਚਾਰ ਦਿਓ ॥੧੧੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "चाहो जहा उचरहु तब ही ॥११९२॥",
      "sourceLineId": "109563",
      "sourceShabadId": "9636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "109564",
      "sourceShabadId": "9637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਸੁੰਧਰੇਸਣੀ ਆਦਿ ਉਚਾਰਨ ਕੀਜੀਐ ॥",
      "transliteration": "basu(n)dharesanee aadh uchaaran keejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬਸੁੰਧਰੇਸਣੀ' (ਪ੍ਰਿਥਵੀ ਪਤੀ ਦੀ ਸੈਨਾ) (ਸ਼ਬਦ) ਨੂੰ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "बसुँधरेसणी आदि उचारन कीजीऐ ॥",
      "sourceLineId": "109565",
      "sourceShabadId": "9637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਬਦ ਦਾਹਨੀ ਅੰਤਿ ਤਵਨ ਕੇ ਦੀਜੀਐ ॥",
      "transliteration": "sabadh dhaahanee a(n)t tavan ke dheejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਦਾਹਨੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "सबद दाहनी अंति तवन के दीजीऐ ॥",
      "sourceLineId": "109566",
      "sourceShabadId": "9637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਜਾਨ ਜੀਯ ਲੀਜੀਅਹਿ ॥",
      "transliteration": "sakal tupak ke naam jaan jeey leeje'eeh ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਚਿਤ ਵਿਚ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम जान जीय लीजीअहि ॥",
      "sourceLineId": "109567",
      "sourceShabadId": "9637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹੋ ਪ੍ਰਗਟ ਸਭਾ ਕੇ ਮਾਝ ਉਚਾਰਨ ਕੀਜੀਅਹਿ ॥੧੧੯੩॥",
      "transliteration": "ho pragaT sabhaa ke maajh uchaaran keeje'eeh ||1193||",
      "translation": "Saying firstly the word “Vasundhreshani”, add the word “Daahni” and know all the names of Tupak in your mind.1193.",
      "punjabiViakhya": "ਸਭਾ ਵਿਚ ਪ੍ਰਗਟ ਰੂਪ ਵਿਚ ਇਸ ਦਾ ਕਥਨ ਕਰੋ ॥੧੧੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "हो प्रगट सभा के माझ उचारन कीजीअहि ॥११९३॥",
      "sourceLineId": "109568",
      "sourceShabadId": "9637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "109569",
      "sourceShabadId": "9638",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0796_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੁੰਧਰੇਸਣੀ ਆਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "su(n)dharesanee aadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬਸੁੰਧਰੇਸਣੀ' (ਸ਼ਬਦ) ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 796,
      "hindi": "",
      "hindiTransliteration": "सुँधरेसणी आदि उचरीऐ ॥",
      "sourceLineId": "109570",
      "sourceShabadId": "9638",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
