{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 799,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0799_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "109643",
      "sourceShabadId": "9644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਚੀਪਤਿਸਣੀ ਇਸਣੀ ਭਾਖੋ ॥",
      "transliteration": "sacheepatisanee isanee bhaakho ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸਚੀ ਪਤਿਸਣੀ ਇਸਣੀ' (ਇੰਦਰ ਦੇ ਪਿਤਾ ਕਸ਼੍ਰਯਪ ਦੀ ਧਰਤੀ) (ਸ਼ਬਦ) ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "सचीपतिसणी इसणी भाखो ॥",
      "sourceLineId": "109644",
      "sourceShabadId": "9644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਥਣੀ ਸਬਦ ਅੰਤ ਕੋ ਰਾਖੋ ॥",
      "transliteration": "mathanee sabadh a(n)t ko raakho ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਤ ਵਿਚ 'ਮਥਣੀ' ਸ਼ਬਦ ਰਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "मथणी सबद अंत को राखो ॥",
      "sourceLineId": "109645",
      "sourceShabadId": "9644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਲਹੀਜੈ ॥",
      "transliteration": "sakal tupak ke naam laheejai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम लहीजै ॥",
      "sourceLineId": "109646",
      "sourceShabadId": "9644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੇਸ ਦੇਸ ਕਰਿ ਪ੍ਰਗਟ ਭਨੀਜੈ ॥੧੨੧੧॥",
      "transliteration": "dhes dhes kar pragaT bhaneejai ||1211||",
      "translation": "Saying firstly the words “Shachi Pateeshani Ishani”, add the word “mathani” at end and know all the names of Tupak.1211.",
      "punjabiViakhya": "ਦੇਸ ਦੇਸਾਤਰ ਵਿਚ (ਇਸ ਦਾ) ਪ੍ਰਗਟ ਰੂਪ ਵਿਚ ਕਥਨ ਕਰੋ ॥੧੨੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "देस देस करि प्रगट भनीजै ॥१२११॥",
      "sourceLineId": "109647",
      "sourceShabadId": "9644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "109648",
      "sourceShabadId": "9645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਕੰਦ੍ਰਨ ਤਾਤਣੀ ਏਸਣੀ ਭਾਖੀਐ ॥",
      "transliteration": "saka(n)dhran taatanee esanee bhaakheeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਪਹਿਲਾ) 'ਸਕੰਦ੍ਰਨ (ਇੰਦਰ) ਤਾਤਣੀ ਏਸਣੀ' (ਸ਼ਬਦ) ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "सकंद्रन तातणी एसणी भाखीऐ ॥",
      "sourceLineId": "109649",
      "sourceShabadId": "9645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮਥਣੀ ਤਾ ਕੇ ਅੰਤਿ ਸਬਦ ਕੋ ਰਾਖੀਐ ॥",
      "transliteration": "mathanee taa ke a(n)t sabadh ko raakheeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਰਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "मथणी ता के अंति सबद को राखीऐ ॥",
      "sourceLineId": "109650",
      "sourceShabadId": "9645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਚਿਤ ਮੈ ਚਤਰ ਪਛਾਨੀਐ ॥",
      "transliteration": "naam tupak ke chit mai chatar pachhaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਚਤੁਰ ਲੋਗ ਤੁਪਕ ਦੇ ਨਾਮ ਵਜੋਂ ਧਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के चित मै चतर पछानीऐ ॥",
      "sourceLineId": "109651",
      "sourceShabadId": "9645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਹੋ ਬਿਨਾ ਕਪਟ ਤਿਨ ਲਖੋ ਨ ਕਪਟ ਪ੍ਰਮਾਨੀਐ ॥੧੨੧੨॥",
      "transliteration": "ho binaa kapaT tin lakho na kapaT pramaaneeaai ||1212||",
      "translation": "Saying the words “Sakrandan-taatani Ishani”, add the word “mathani” at the end and recognize the names of Tupak cleverly and guilessly.1212.",
      "punjabiViakhya": "(ਇਸ ਦਾ) ਨਿਸ਼ਕਪਟ ਹੋ ਕੇ ਪ੍ਰਮਾਣਿਕ ਪ੍ਰਯੋਗ ਕਰੋ ॥੧੨੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "हो बिना कपट तिन लखो न कपट प्रमानीऐ ॥१२१२॥",
      "sourceLineId": "109652",
      "sourceShabadId": "9645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਊਸਕੇਸਣੀ ਇਸਣੀ ਪ੍ਰਿਥਮ ਬਖਾਨਿ ਕੈ ॥",
      "transliteration": "kuoosakesanee isanee piratham bakhaan kai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਕਊਸਕੇਸਣੀ ਇਸਣੀ' (ਇੰਦਰ ਦੇ ਸੁਆਮੀ ਦੀ ਸੈਨਾ) ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "कऊसकेसणी इसणी पृथम बखानि कै ॥",
      "sourceLineId": "109653",
      "sourceShabadId": "9645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮਥਣੀ ਤਾ ਕੇ ਅੰਤ ਸਬਦ ਕੋ ਠਾਨਿ ਕੈ ॥",
      "transliteration": "mathanee taa ke a(n)t sabadh ko Thaan kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਮਥਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "मथणी ता के अंत सबद को ठानि कै ॥",
      "sourceLineId": "109654",
      "sourceShabadId": "9645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਚਤੁਰ ਪਹਿਚਾਨੀਐ ॥",
      "transliteration": "sakal tupak ke naam chatur pahichaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਚਤੁਰ ਲੋਗੋ! ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम चतुर पहिचानीऐ ॥",
      "sourceLineId": "109655",
      "sourceShabadId": "9645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹੋ ਕਹੇ ਹਮਾਰੇ ਬਚਨ ਸਤਿ ਕਰਿ ਮਾਨੀਐ ॥੧੨੧੩॥",
      "transliteration": "ho kahe hamaare bachan sat kar maaneeaai ||1213||",
      "translation": "Saying the word “Kauskeshani Ishani”, add the word “mathani” at the end and know all the names of Tupak considering them as true.1213.",
      "punjabiViakhya": "ਮੇਰੇ ਕਹੇ ਬਚਨ ਨੂੰ ਸਚ ਕਰ ਕੇ ਮੰਨੋ ॥੧੨੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "हो कहे हमारे बचन सति करि मानीऐ ॥१२१३॥",
      "sourceLineId": "109656",
      "sourceShabadId": "9645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "109657",
      "sourceShabadId": "9646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਾਸਵੇਸਣੀ ਆਦਿ ਭਣਿਜੈ ॥",
      "transliteration": "baasavesanee aadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬਾਸਵੇਸਣੀ' (ਇੰਦਰ ਦੇ ਸੁਆਮੀ ਦੀ ਧਰਤੀ) (ਸ਼ਬਦ) ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "बासवेसणी आदि भणिजै ॥",
      "sourceLineId": "109658",
      "sourceShabadId": "9646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅੰਤਿ ਸਬਦ ਅਰਿਣੀ ਤਿਹ ਦਿਜੈ ॥",
      "transliteration": "a(n)t sabadh arinee teh dhijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "अंति सबद अरिणी तिह दिजै ॥",
      "sourceLineId": "109659",
      "sourceShabadId": "9646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਭ ਜੀਯ ਜਾਨੋ ॥",
      "transliteration": "naam tupak ke sabh jeey jaano ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦੇ ਨਾਮ ਵਜੋਂ ਹਿਰਦੇ ਵਿਚ ਧਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सभ जीय जानो ॥",
      "sourceLineId": "109660",
      "sourceShabadId": "9646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੰਕ ਤਿਆਗ ਨਿਰਸੰਕ ਬਖਾਨੋ ॥੧੨੧੪॥",
      "transliteration": "sa(n)k tiaag nirasa(n)k bakhaano ||1214||",
      "translation": "Saying the words “Vaasav-Ishani”, add the word “arini” at the end and know the names of Tupak unhesitatingly.1214.",
      "punjabiViakhya": "ਸ਼ੰਕਾ ਨੂੰ ਤਿਆਗ ਕੇ ਨਿਸੰਗ ਹੋ ਕੇ ਬਖਾਨ ਕਰੋ ॥੧੨੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "संक तिआग निरसंक बखानो ॥१२१४॥",
      "sourceLineId": "109661",
      "sourceShabadId": "9646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "109662",
      "sourceShabadId": "9647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਰਹਾ ਇਸਣੀ ਅਰਿਣੀ ਆਦਿ ਬਖਾਨੀਐ ॥",
      "transliteration": "barahaa isanee arinee aadh bakhaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬਰਹਾ (ਇੰਦਰ) ਇਸਣੀ ਅਰਿਣੀ' ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "बरहा इसणी अरिणी आदि बखानीऐ ॥",
      "sourceLineId": "109663",
      "sourceShabadId": "9647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਸੁ ਚਿਤ ਮੈ ਜਾਨੀਐ ॥",
      "transliteration": "sakal tupak ke naam su chit mai jaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦੇ ਨਾਮ ਵਜੋਂ ਚਿਤ ਵਿਚ ਜਾਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम सु चित मै जानीऐ ॥",
      "sourceLineId": "109664",
      "sourceShabadId": "9647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੰਕ ਤਿਆਗਿ ਨਿਰਸੰਕ ਉਚਾਰਨ ਕੀਜੀਐ ॥",
      "transliteration": "sa(n)k tiaag nirasa(n)k uchaaran keejeeaai ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੰਕਾ ਨੂੰ ਤਿਆਗ ਕੇ ਨਿਸੰਗ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "संक तिआगि निरसंक उचारन कीजीऐ ॥",
      "sourceLineId": "109665",
      "sourceShabadId": "9647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹੋ ਸਤਿ ਸੁ ਬਚਨ ਹਮਾਰੇ ਮਾਨੇ ਲੀਜੀਐ ॥੧੨੧੫॥",
      "transliteration": "ho sat su bachan hamaare maane leejeeaai ||1215||",
      "translation": "Saying the word “Varhaaishani arini”, speak all the nnames of Tupak inn your mind and I say truly, use these names unhesitatingly.1215.",
      "punjabiViakhya": "ਮੇਰੇ ਇਹ ਬਚਨ ਸਚ ਕਰ ਕੇ ਮੰਨੋ ॥੧੨੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "हो सति सु बचन हमारे माने लीजीऐ ॥१२१५॥",
      "sourceLineId": "109666",
      "sourceShabadId": "9647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "DOHRA",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "109667",
      "sourceShabadId": "9648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਘਵੇਸਰਣੀ ਇਸਰਣੀ ਪ੍ਰਿਥਮੈ ਪਦਹਿ ਉਚਾਰ ॥",
      "transliteration": "maghavesaranee isaranee pirathamai padheh uchaar ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਮਘਵੇਸਣਣੀ ਇਸਰਣੀ' ਸ਼ਬਦ ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "मघवेसरणी इसरणी पृथमै पदहि उचार ॥",
      "sourceLineId": "109668",
      "sourceShabadId": "9648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਹੋਤ ਹੈਂ ਲੀਜੈ ਸੁਕਬਿ ਸੁ ਧਾਰ ॥੧੨੧੬॥",
      "transliteration": "naam tupak ke hot hai(n) leejai sukab su dhaar ||1216||",
      "translation": "By uttering the words “Mathveshani Ishvarni”, the names of Tupak are formed correctly.1216.",
      "punjabiViakhya": "(ਇਹ) ਤੁਪਕ ਦਾ ਨਾਮ ਬਣਦਾ ਹੈ, ਸਭ ਕਵੀ (ਮਨ ਵਿਚ) ਧਾਰਨ ਕਰ ਲੈਣ ॥੧੨੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के होत हैं लीजै सुकबि सु धार ॥१२१६॥",
      "sourceLineId": "109669",
      "sourceShabadId": "9648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਾਤਲੇਸਣੀ ਏਸਣੀ ਮਥਣੀ ਅੰਤਿ ਉਚਾਰ ॥",
      "transliteration": "maatalesanee esanee mathanee a(n)t uchaar ||",
      "translation": "",
      "punjabiViakhya": "(ਪਹਿਲਾ) 'ਮਾਤਲੇਸਣੀ' (ਮਾਤਲ ਦੇ ਸੁਆਮੀ ਇੰਦਰ ਦੀ ਧਰਤੀ) ਸ਼ਬਦ ਕਹੋ, (ਫਿਰ) ਅੰਤ ਤੇ 'ਏਸਣੀ ਮਥਣੀ' (ਸ਼ਬਦ) ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "मातलेसणी एसणी मथणी अंति उचार ॥",
      "sourceLineId": "109670",
      "sourceShabadId": "9648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਹੋਤ ਹੈ ਲੀਜਹਿ ਸੁਕਬਿ ਸੁ ਧਾਰ ॥੧੨੧੭॥",
      "transliteration": "naam tupak ke hot hai leejeh sukab su dhaar ||1217||",
      "translation": "By uttering the words “Matuleshani Ishani Mathani”, the names of Tupak are formed, which the poet may improve.1217.",
      "punjabiViakhya": "(ਇਹ) ਤੁਪਕ ਦਾ ਨਾਮ ਬਣਦਾ ਹੈ। ਕਵੀਓ! (ਇਸ ਨੂੰ) ਧਾਰਨ ਕਰ ਲਵੋ ॥੧੨੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के होत है लीजहि सुकबि सु धार ॥१२१७॥",
      "sourceLineId": "109671",
      "sourceShabadId": "9648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "109672",
      "sourceShabadId": "9649",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਿਸਨਏਸਣੀ ਆਦਿ ਭਣਿਜੈ ॥",
      "transliteration": "jisanesanee aadh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਜਿਸਨ (ਇੰਦਰ) ਏਸਣੀ' (ਸ਼ਬਦ) ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "जिसनएसणी आदि भणिजै ॥",
      "sourceLineId": "109673",
      "sourceShabadId": "9649",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਇਸਣੀ ਮਥਣੀ ਅੰਤਿ ਕਹਿਜੈ ॥",
      "transliteration": "eisanee mathanee a(n)t kahijai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਅੰਤ ਉਤੇ 'ਇਸਣੀ ਮਥਣੀ' (ਸ਼ਬਦ) ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "इसणी मथणी अंति कहिजै ॥",
      "sourceLineId": "109674",
      "sourceShabadId": "9649",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਕੇ ਲਹੀਐ ॥",
      "transliteration": "sabh sree naam tupak ke laheeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक के लहीऐ ॥",
      "sourceLineId": "109675",
      "sourceShabadId": "9649",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦੀਜੈ ਤਵਨ ਠਵਰ ਜਹ ਚਹੀਐ ॥੧੨੧੮॥",
      "transliteration": "dheejai tavan Thavar jeh chaheeaai ||1218||",
      "translation": "Saying firstly the word “Jisneshani”, add the words “Ishani mathani” at the end and know the names of Tupak for using them at the desired place.1218.",
      "punjabiViakhya": "ਜਿਥੇ ਲੋੜ ਹੋਵੇ, ਉਥੇ ਵਰਤੋ ॥੧੨੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "दीजै तवन ठवर जह चहीऐ ॥१२१८॥",
      "sourceLineId": "109676",
      "sourceShabadId": "9649",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "109677",
      "sourceShabadId": "9650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪ੍ਰਿਥਮ ਪੁਰੰਦਰ ਇਸਣੀ ਸਬਦ ਬਖਾਨੀਐ ॥",
      "transliteration": "piratham pura(n)dhar isanee sabadh bakhaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਪੁਰੰਦਰ (ਇੰਦਰ) ਇਸਣੀ' ਸ਼ਬਦ ਬਖਾਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "पृथम पुरंदर इसणी सबद बखानीऐ ॥",
      "sourceLineId": "109678",
      "sourceShabadId": "9650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਇਸਣੀ ਮਥਣੀ ਪਦ ਕੋ ਬਹੁਰਿ ਪ੍ਰਮਾਨੀਐ ॥",
      "transliteration": "eisanee mathanee padh ko bahur pramaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਇਸਣੀ ਮਥਣੀ' ਪਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "इसणी मथणी पद को बहुरि प्रमानीऐ ॥",
      "sourceLineId": "109679",
      "sourceShabadId": "9650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਜਾਨ ਜੀਯ ਲੀਜੀਅਹਿ ॥",
      "transliteration": "naam tupak ke sakal jaan jeey leeje'eeh ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਮਨ ਵਿਚ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल जान जीय लीजीअहि ॥",
      "sourceLineId": "109680",
      "sourceShabadId": "9650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹੋ ਸੰਕ ਤਿਆਗ ਨਿਰਸੰਕ ਉਚਾਰਨ ਕੀਜੀਅਹਿ ॥੧੨੧੯॥",
      "transliteration": "ho sa(n)k tiaag nirasa(n)k uchaaran keeje'eeh ||1219||",
      "translation": "Saying the words “Durandar-Ishani”, add the words “Ishani mathani” and know all the names of Tupak, uttering them unhestitatingly.1219.",
      "punjabiViakhya": "ਸ਼ੰਕਾ ਨੂੰ ਤਿਆਗ ਕੇ ਨਿਸੰਗ ਉਚਾਰਨ ਕਰੋ ॥੧੨੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "हो संक तिआग निरसंक उचारन कीजीअहि ॥१२१९॥",
      "sourceLineId": "109681",
      "sourceShabadId": "9650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਜ੍ਰਧਰਿਸਣੀ ਅਰਿਣੀ ਆਦਿ ਉਚਾਰੀਐ ॥",
      "transliteration": "bajradharisanee arinee aadh uchaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬਜ੍ਰ ਧਰਿਸਣੀ ਅਰਿਣੀ' (ਸ਼ਬਦ) ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "बज्रधरिसणी अरिणी आदि उचारीऐ ॥",
      "sourceLineId": "109682",
      "sourceShabadId": "9650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਚਿਤ ਮੈ ਚਤੁਰ ਬਿਚਾਰੀਐ ॥",
      "transliteration": "naam tupak ke chit mai chatur bichaareeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਾਰੇ ਸੂਝਵਾਨ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के चित मै चतुर बिचारीऐ ॥",
      "sourceLineId": "109683",
      "sourceShabadId": "9650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੰਕ ਤਯਾਗ ਨਿਰਸੰਕ ਹੁਇ ਸਬਦ ਬਖਾਨੀਐ ॥",
      "transliteration": "sa(n)k tayaag nirasa(n)k hui sabadh bakhaaneeaai ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਕਾ ਨੂੰ ਤਿਆਗ ਕੇ ਨਿਸੰਗ ਇਸ ਸ਼ਬਦ ਨੂੰ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "संक तयाग निरसंक हुइ सबद बखानीऐ ॥",
      "sourceLineId": "109684",
      "sourceShabadId": "9650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹੋ ਕਿਸੀ ਸੁਕਬਿ ਕੀ ਕਾਨ ਨ ਮਨ ਮੈ ਆਨੀਐ ॥੧੨੨੦॥",
      "transliteration": "ho kisee sukab kee kaan na man mai aaneeaai ||1220||",
      "translation": "Saying firstly the words “Vajarbhareshani arini”, know thoughtfully the names of Tupak in your mind, use them without caring for any poet.1220.",
      "punjabiViakhya": "ਕਿਸੇ ਕਵੀ ਵਲੋਂ ਨੁਕਸ ਕਢਣ ਦੀ ਪਰਵਾਹ ਨਾ ਕਰੋ ॥੧੨੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "हो किसी सुकबि की कान न मन मै आनीऐ ॥१२२०॥",
      "sourceLineId": "109685",
      "sourceShabadId": "9650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤੁਰਾਖਾੜ ਪਿਤਣੀ ਇਸਣੀ ਪਦ ਭਾਖੀਐ ॥",
      "transliteration": "turaakhaaR pitanee isanee padh bhaakheeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਤੁਰਾਖਾੜ (ਇੰਦਰ) ਪਿਤਣੀ ਇਸਣੀ' ਪਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "तुराखाड़ पितणी इसणी पद भाखीऐ ॥",
      "sourceLineId": "109686",
      "sourceShabadId": "9650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਰਿਣੀ ਤਾ ਕੇ ਅੰਤਿ ਸਬਦ ਕੋ ਰਾਖੀਐ ॥",
      "transliteration": "arinee taa ke a(n)t sabadh ko raakheeaai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿਣੀ' ਸ਼ਬਦ ਰਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "अरिणी ता के अंति सबद को राखीऐ ॥",
      "sourceLineId": "109687",
      "sourceShabadId": "9650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਕਲ ਤੁਪਕ ਕੇ ਨਾਮ ਹੀਯੈ ਪਹਿਚਾਨੀਅਹਿ ॥",
      "transliteration": "sakal tupak ke naam heeyai pahichaane'eeh ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦੇ ਨਾਮ ਵਜੋਂ ਹਿਰਦੇ ਵਿਚ ਧਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "सकल तुपक के नाम हीयै पहिचानीअहि ॥",
      "sourceLineId": "109688",
      "sourceShabadId": "9650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0799_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹੋ ਚਤੁਰ ਸਭਾ ਕੇ ਬੀਚ ਨਿਸੰਕ ਬਖਾਨੀਅਹਿ ॥੧੨੨੧॥",
      "transliteration": "ho chatur sabhaa ke beech nisa(n)k bakhaane'eeh ||1221||",
      "translation": "Saying the words “Tukhaar Pitani Ishani”, add the word “arini” at the end and recognize all the names of Tupak in your mind.1221.",
      "punjabiViakhya": "(ਇਸ ਦਾ) ਵਿਦਵਾਨਾ ਦੀ ਸਭਾ ਵਿਚ ਨਿਸੰਗ ਹੋ ਕੇ ਬਖਾਨ ਕਰੋ ॥੧੨੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 799,
      "hindi": "",
      "hindiTransliteration": "हो चतुर सभा के बीच निसंक बखानीअहि ॥१२२१॥",
