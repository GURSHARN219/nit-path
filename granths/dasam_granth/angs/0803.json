  "lines": [
    {
      "id": "dasam_ang_0803_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੇਵ ਸਬਦ ਕਹੁ ਆਦਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "dhev sabadh kahu aadh bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਦੇਵ' ਸ਼ਬਦ ਨੂੰ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "देव सबद कहु आदि बखानहु ॥",
      "sourceLineId": "109835",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨ੍ਰਿਪ ਪਦ ਤੀਨ ਬਾਰ ਪੁਨਿ ਠਾਨਹੁ ॥",
      "transliteration": "nirap padh teen baar pun Thaanahu ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਵਿਚ) ਫਿਰ ਤਿੰਨ ਵਾਰ 'ਨ੍ਰਿਪ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "नृप पद तीन बार पुनि ठानहु ॥",
      "sourceLineId": "109836",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਭਣਿਜੈ ॥",
      "transliteration": "satr sabadh ko bahur bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ 'ਸਤ੍ਰੁ' ਸ਼ਬਦ ਨੂੰ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "सत्रु सबद को बहुरि भणिजै ॥",
      "sourceLineId": "109837",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਲਹਿਜੈ ॥੧੨੫੭॥",
      "transliteration": "naam tupak ke sakal lahijai ||1257||",
      "translation": "Saying the word “Dev” and adding the word “Nrip” three times, utter the word “Dhatru” and know all the names of Tupak.1257.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦੇ ਨਾਮ ਵਜੋਂ ਸਮਝੋ ॥੧੨੫੭॥",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल लहिजै ॥१२५७॥",
      "sourceLineId": "109838",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਮਰ ਸਬਦ ਕਹੁ ਆਦਿ ਉਚਾਰਹੁ ॥",
      "transliteration": "amar sabadh kahu aadh uchaarahu ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਅਮਰ' ਸ਼ਬਦ ਦਾ ਉਚਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "अमर सबद कहु आदि उचारहु ॥",
      "sourceLineId": "109839",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨ੍ਰਿਪ ਪਦ ਤੀਨ ਬਾਰ ਪੁਨਿ ਡਾਰਹੁ ॥",
      "transliteration": "nirap padh teen baar pun ddaarahu ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਤਿੰਨ ਵਾਰ 'ਨ੍ਰਿਪ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "नृप पद तीन बार पुनि डारहु ॥",
      "sourceLineId": "109840",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਰਿ ਕਹਿ ਨਾਮ ਤੁਪਕ ਕੇ ਲੀਜੈ ॥",
      "transliteration": "ar keh naam tupak ke leejai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਅਰਿ' ਸ਼ਬਦ ਸ਼ਾਮਲ ਕਰਨ ਨਾਲ ਤੁਪਕ ਦਾ ਨਾਮ ਬਣ ਜਾਏਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "अरि कहि नाम तुपक के लीजै ॥",
      "sourceLineId": "109841",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਬਿਤ ਕਾਬਿ ਕੇ ਭੀਤਰ ਦੀਜੈ ॥੧੨੫੮॥",
      "transliteration": "kabit kaab ke bheetar dheejai ||1258||",
      "translation": "Saying the word “Amar”, add the word “Nrip” three times and them adding the word “ari”, know the names of TUpak.1258.",
      "punjabiViakhya": "ਇਸ ਦੀ ਵਰਤੋਂ ਕਬਿੱਤਾ ਅਤੇ ਕਾਵਿ ਵਿਚ ਕਰੋ ॥੧੨੫੮॥",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "कबित काबि के भीतर दीजै ॥१२५८॥",
      "sourceLineId": "109842",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨ੍ਰਿਜਰ ਸਬਦ ਕੋ ਆਦਿ ਉਚਰੀਐ ॥",
      "transliteration": "nirajar sabadh ko aadh uchareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਨ੍ਰਿਜਰ' (ਦੇਵਤਾ) ਸ਼ਬਦ ਨੂੰ ਉਚਾਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "नृजर सबद को आदि उचरीऐ ॥",
      "sourceLineId": "109843",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨ੍ਰਿਪ ਪਦ ਤੀਨ ਬਾਰ ਪੁਨਿ ਧਰੀਐ ॥",
      "transliteration": "nirap padh teen baar pun dhareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਤਿੰਨ ਵਾਰ 'ਨ੍ਰਿਪ' ਪਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "नृप पद तीन बार पुनि धरीऐ ॥",
      "sourceLineId": "109844",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਰਿ ਕਹਿ ਨਾਮ ਤੁਪਕ ਕੇ ਜਾਨਹੁ ॥",
      "transliteration": "ar keh naam tupak ke jaanahu ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) 'ਅਰਿ' ਸ਼ਬਦ ਕਹਿ ਕੇ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "अरि कहि नाम तुपक के जानहु ॥",
      "sourceLineId": "109845",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੰਕ ਛਾਡਿ ਨਿਰਸੰਕ ਬਖਾਨਹੁ ॥੧੨੫੯॥",
      "transliteration": "sa(n)k chhaadd nirasa(n)k bakhaanahu ||1259||",
      "translation": "Saying the word “Nirajar”, add the word “Nrip” three times and then uttering the word “ari”, know the names of Tupak unhesitatingly.1259.",
      "punjabiViakhya": "ਸ਼ੰਕਾ ਛਡ ਕੇ ਨਿਸੰਗ ਹੋ ਕੇ ਇਸ ਦਾ ਬਖਾਨ ਕਰੋ ॥੧੨੫੯॥",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "संक छाडि निरसंक बखानहु ॥१२५९॥",
      "sourceLineId": "109846",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਿਬੁਧ ਸਬਦ ਕੋ ਆਦਿ ਭਣੀਜੈ ॥",
      "transliteration": "bibudh sabadh ko aadh bhaneejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਬਿਬੁਧ' (ਦੇਵਤਾ) ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "बिबुध सबद को आदि भणीजै ॥",
      "sourceLineId": "109847",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤੀਨ ਬਾਰ ਨ੍ਰਿਪ ਸਬਦ ਧਰੀਜੈ ॥",
      "transliteration": "teen baar nirap sabadh dhareejai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਤਿੰਨ ਵਾਰ 'ਨ੍ਰਿਪ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "तीन बार नृप सबद धरीजै ॥",
      "sourceLineId": "109848",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਿਪੁ ਕਹਿ ਨਾਮ ਤੁਪਕ ਕੇ ਲਹੀਅਹਿ ॥",
      "transliteration": "rip keh naam tupak ke lahe'eeh ||",
      "translation": "",
      "punjabiViakhya": "(ਮਗਰੋਂ) 'ਰਿਪੁ' ਸ਼ਬਦ ਕਹਿ ਕੇ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "रिपु कहि नाम तुपक के लहीअहि ॥",
      "sourceLineId": "109849",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੰਕਾ ਤਿਆਗਿ ਸਭਾ ਮੈ ਕਹੀਅਹਿ ॥੧੨੬੦॥",
      "transliteration": "sa(n)kaa tiaag sabhaa mai kahe'eeh ||1260||",
      "translation": "Saying firstly the word “Vibuddh”, add the word “Nrip” three times and thenn adding the word “Ripu”, know the names of Tupak without any hesitation.1260.",
      "punjabiViakhya": "ਸੰਕਾ ਨੂੰ ਤਿਆਗ ਕੇ ਸਭਾ ਵਿਚ ਕਹੋ ॥੧੨੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "संका तिआगि सभा मै कहीअहि ॥१२६०॥",
      "sourceLineId": "109850",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੁਰ ਪਦ ਆਦਿ ਸਬਦ ਕੋ ਧਾਰੀਐ ॥",
      "transliteration": "sur padh aadh sabadh ko dhaareeaai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸੁਰ' ਸ਼ਬਦ ਨੂੰ ਰਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "सुर पद आदि सबद को धारीऐ ॥",
      "sourceLineId": "109851",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤੀਨ ਬਾਰ ਨ੍ਰਿਪ ਪਦ ਕਹੁ ਡਾਰੀਐ ॥",
      "transliteration": "teen baar nirap padh kahu ddaareeaai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਸ ਨਾਲ ਤਿੰਨ ਵਾਰ 'ਨ੍ਰਿਪ' ਸ਼ਬਦ ਨੂੰ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "तीन बार नृप पद कहु डारीऐ ॥",
      "sourceLineId": "109852",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਰਿ ਪਦ ਤਾ ਕੇ ਅੰਤਿ ਬਖਾਨੋ ॥",
      "transliteration": "ar padh taa ke a(n)t bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿ' ਪਦ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "अरि पद ता के अंति बखानो ॥",
      "sourceLineId": "109853",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਕੇ ਜਾਨੋ ॥੧੨੬੧॥",
      "transliteration": "sabh sree naam tupak ke jaano ||1261||",
      "translation": "Saying firstly the word “Sur”, add the word “Nrip” three times and then adding the word “ari” at the end know all the names of Tupak.1261.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੧੨੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "सभ स्री नाम तुपक के जानो ॥१२६१॥",
      "sourceLineId": "109854",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੁਮਨ ਸਬਦ ਕੋ ਆਦਿ ਬਖਾਨਹੁ ॥",
      "transliteration": "suman sabadh ko aadh bakhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ 'ਸੁਮਨ' (ਦੇਵਤਾ) ਸ਼ਬਦ ਦਾ ਕਥਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "सुमन सबद को आदि बखानहु ॥",
      "sourceLineId": "109855",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤੀਨ ਬਾਰ ਨਾਇਕ ਪਦ ਠਾਨਹੁ ॥",
      "transliteration": "teen baar naik padh Thaanahu ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਤਿੰਨ ਵਾਰ 'ਨਾਇਕ' ਸ਼ਬਦ ਜੋੜੋ।",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "तीन बार नाइक पद ठानहु ॥",
      "sourceLineId": "109856",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਰਿ ਪਦ ਤਾ ਕੇ ਅੰਤਿ ਭਣਿਜੈ ॥",
      "transliteration": "ar padh taa ke a(n)t bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਤ ਉਤੇ 'ਅਰਿ' ਪਦ ਕਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "अरि पद ता के अंति भणिजै ॥",
      "sourceLineId": "109857",
      "sourceShabadId": "9655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0803_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਲਹਿਜੈ ॥੧੨੬੨॥",
      "transliteration": "naam tupak ke sakal lahijai ||1262||",
      "translation": "Saying the word “Suman”, add the word “naayak” three times and then adding the word “ari” at the end know all the names of Tupak.1262.",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਸਭ ਤੁਪਕ ਦਾ ਨਾਮ ਸਮਝੋ ॥੧੨੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 803,
      "hindi": "",
      "hindiTransliteration": "नाम तुपक के सकल लहिजै ॥१२६२॥",
