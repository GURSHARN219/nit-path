{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 857,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0857_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੁਨਿ ਬਾਲਾ ਮੈ ਬੈਨ ਤਿਹਾਰੋ ॥",
      "transliteration": "sun baalaa mai bain tihaaro ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਇਸਤਰੀ! ਮੈਂ ਤੇਰੇ ਬੋਲ ਸੁਣੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "सुनि बाला मै बैन तिहारो ॥",
      "sourceLineId": "112571",
      "sourceShabadId": "10032",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਬ ਪੌਰਖ ਤੈ ਦੇਖੁ ਹਮਾਰੋ ॥",
      "transliteration": "ab pauarakh tai dhekh hamaaro ||",
      "translation": "‘You listen to us now and watch our attainments.",
      "punjabiViakhya": "ਹੁਣ ਤੂੰ ਸਾਡੀ ਸ਼ਕਤੀ ਨੂੰ ਵੇਖ।",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "अब पौरख तै देखु हमारो ॥",
      "sourceLineId": "112572",
      "sourceShabadId": "10032",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਧਿਕ ਬੀਰਜ ਜਾ ਮੈ ਜਿਯ ਧਰਿ ਹੈ ॥",
      "transliteration": "adhik beeraj jaa mai jiy dhar hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਜੀਅ (ਭਾਵ ਸ਼ਰੀਰ) ਵਿਚ ਜ਼ਿਆਦਾ ਬਲ ਹੋਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "अधिक बीरज जा मै जिय धरि है ॥",
      "sourceLineId": "112573",
      "sourceShabadId": "10032",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਾਹੀ ਕਹ ਅਪਨੋ ਪਤਿ ਕਰਿ ਹੈ ॥੧੧॥",
      "transliteration": "taahee keh apano pat kar hai ||11||",
      "translation": "‘The one who displayed an higher aptitude through his semen, you declare him as your husband.’(11)",
      "punjabiViakhya": "ਉਸੇ ਨੂੰ ਆਪਣਾ ਪਤੀ ਮੰਨ ਲੈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "ताही कह अपनो पति करि है ॥११॥",
      "sourceLineId": "112574",
      "sourceShabadId": "10032",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਠਗ ਬਚ ਭਾਖਿ ਨਗਰ ਮਹਿ ਗਯੋ ॥",
      "transliteration": "Thag bach bhaakh nagar meh gayo ||",
      "translation": "‘The one who displayed an higher aptitude through his semen, you declare him as your husband.’(11)",
      "punjabiViakhya": "ਠਗ ਬਚਨ ਬੋਲ ਕੇ ਨਗਰ ਵਿਚ ਚਲਾ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "ठग बच भाखि नगर महि गयो ॥",
      "sourceLineId": "112575",
      "sourceShabadId": "10032",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਇਸਥਿਤ ਏਕ ਹਾਟ ਪਰ ਭਯੋ ॥",
      "transliteration": "eisathit ek haaT par bhayo ||",
      "translation": "After announcing this, swindler went to the town and approached a shop.",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਦੁਕਾਨ ਵਿਚ ਜਾ ਕੇ ਬੈਠ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "इसथित एक हाट पर भयो ॥",
      "sourceLineId": "112576",
      "sourceShabadId": "10032",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮੁਹਰੈ ਸਕਲ ਦ੍ਰਿਸਟਿ ਤਹ ਧਰੀ ॥",
      "transliteration": "muharai sakal dhirasaT teh dharee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ (ਦੁਕਾਨ ਵਿਚਲੀਆਂ) ਸਾਰੀਆਂ ਮੋਹਰਾ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "मुहरै सकल दृसटि तह धरी ॥",
      "sourceLineId": "112577",
      "sourceShabadId": "10032",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਾਹੁ ਭਏ ਇਹ ਭਾਤਿ ਉਚਰੀ ॥੧੨॥",
      "transliteration": "saahu bhe ieh bhaat ucharee ||12||",
      "translation": "He saw a heap of gold-coins there and addressed the Shah.(12)",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਾਹੂਕਾਰ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿਣ ਲਗਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "साहु भए इह भाति उचरी ॥१२॥",
      "sourceLineId": "112578",
      "sourceShabadId": "10032",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "112579",
      "sourceShabadId": "10033",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਐਸ ਭਾਤਿ ਉਚਰਤ ਭਯਾ ਹ੍ਵੈ ਢੀਲੋ ਸਰਬੰਗ ॥",
      "transliteration": "aais bhaat ucharat bhayaa havai ddeelo saraba(n)g ||",
      "translation": "He spoke very Politely and said ‘Oh My Shah",
      "punjabiViakhya": "ਹਰ ਪ੍ਰਕਾਰ ਦੀ ਸ਼ਾਲੀਨਤਾ ਸਹਿਤ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿਣ ਲਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "ऐस भाति उचरत भया ह्वै ढीलो सरबंग ॥",
      "sourceLineId": "112580",
      "sourceShabadId": "10033",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮੁਹਰਨ ਕੋ ਸੌਦਾ ਕਰੌ ਸਾਹੁ ਤਿਹਾਰੇ ਸੰਗ ॥੧੩॥",
      "transliteration": "muharan ko sauadhaa karau saahu tihaare sa(n)g ||13||",
      "translation": "‘Do you want to trade these gold coin with me?’ (13)",
      "punjabiViakhya": "ਕਿ ਹੇ ਸ਼ਾਹੂਕਾਰ! ਮੈਂ ਤੁਹਾਡੇ ਨਾਲ ਮੋਹਰਾ ਦਾ ਸੌਦਾ ਕਰਨਾ ਚਾਹੁੰਦਾ ਹਾ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "मुहरन को सौदा करौ साहु तिहारे संग ॥१३॥",
      "sourceLineId": "112581",
      "sourceShabadId": "10033",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮਦਨ ਰਾਇ ਠਗ ਇਮ ਕਹੀ ਮਨ ਮੈ ਮੰਤ੍ਰ ਬਿਚਾਰਿ ॥",
      "transliteration": "madhan rai Thag im kahee man mai ma(n)tr bichaar ||",
      "translation": "Madan Rai, the swindler, had said this after careful reflection,",
      "punjabiViakhya": "ਮਦਨ ਰਾਇ ਠਗ ਨੇ ਮਨ ਵਿਚ ਵਿਚਾਰ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "मदन राइ ठग इम कही मन मै मंत्र बिचारि ॥",
      "sourceLineId": "112582",
      "sourceShabadId": "10033",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਲੈ ਮੁਹਰੈ ਰੁਪਯਾ ਦੇਵੌ ਤੁਮ ਕਹ ਸਾਹ ਸੁਧਾਰਿ ॥੧੪॥",
      "transliteration": "lai muharai rupayaa dhevau tum keh saeh sudhaar ||14||",
      "translation": "‘Let us do a deal. You give me Gold coins in exchange of coins rupees.’(I4)",
      "punjabiViakhya": "ਕਿ ਹੇ ਸ਼ਾਹੂਕਾਰ! (ਮੈਂ) ਤੁਹਾਨੂੰ ਮੋਹਰਾ ਲੈ ਕੇ ਰੁਪਏ ਦਿੰਦਾ ਹਾ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "लै मुहरै रुपया देवौ तुम कह साह सुधारि ॥१४॥",
      "sourceLineId": "112583",
      "sourceShabadId": "10033",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "112584",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਯੌ ਜਬ ਸਾਹ ਬੈਨਿ ਸੁਨ ਪਾਯੋ ॥",
      "transliteration": "yau jab saeh bain sun paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸ਼ਾਹੂਕਾਰ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਗੱਲ ਸੁਣੀ",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "यौ जब साह बैनि सुन पायो ॥",
      "sourceLineId": "112585",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਾਢਿ ਅਸਰਫੀ ਧਨੀ ਕਹਾਯੋ ॥",
      "transliteration": "kaadd asarafee dhanee kahaayo ||",
      "translation": "When the Shah listened to the preposition, he brought out the coin",
      "punjabiViakhya": "ਤਾ ਅਸ਼ਰਫੀਆਂ ਕਢ ਕੇ ਆਪਣੇ ਧਨੀ ਹੋਣ ਨੂੰ ਜਣਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "काढि असरफी धनी कहायो ॥",
      "sourceLineId": "112586",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਠਗ ਕੀ ਦ੍ਰਿਸਟਿ ਜਬੈ ਤੇ ਪਰੀ ॥",
      "transliteration": "Thag kee dhirasaT jabai te paree ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਠਗ ਦੀ ਦ੍ਰਿਸ਼ਟੀ ਉਨ੍ਰਹਾ ਉਤੇ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "ठग की दृसटि जबै ते परी ॥",
      "sourceLineId": "112587",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਭ ਸਨ ਕੀ ਮਨ ਭੀਤਰਿ ਧਰੀ ॥੧੫॥",
      "transliteration": "sabh san kee man bheetar dharee ||15||",
      "translation": "The swindler looked at the coins and checked the dates of minting. (15)",
      "punjabiViakhya": "ਤਾ ਸਾਰੀਆਂ ਦੇ ਸੰਨ ਮਨ ਵਿਚ ਰਖ ਲਏ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "सभ सन की मन भीतरि धरी ॥१५॥",
      "sourceLineId": "112588",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮੁਹਿਰੈ ਡਾਰਿ ਗੁਥਰਿਯਹਿ ਲਈ ॥",
      "transliteration": "muhirai ddaar guthariyeh liee ||",
      "translation": "",
      "punjabiViakhya": "ਮੋਹਰਾ ਨੂੰ ਗੁੱਥੀ ਵਿਚ ਪਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "मुहिरै डारि गुथरियहि लई ॥",
      "sourceLineId": "112589",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਧਿਕ ਮਾਰਿ ਬਨਿਯਾ ਕਹ ਦਈ ॥",
      "transliteration": "adhik maar baniyaa keh dhiee ||",
      "translation": "He left the coins there, picked up the bag, started to beat the Shah.",
      "punjabiViakhya": "ਅਤੇ ਬਨੀਏ ਦੀ ਬਹੁਤ ਮਾਰ ਕੁਟਾਈ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "अधिक मारि बनिया कह दई ॥",
      "sourceLineId": "112590",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਊਚੇ ਸੋਰ ਕਰਾ ਪੁਰ ਮਾਹੀ ॥",
      "transliteration": "uooche sor karaa pur maahee ||",
      "translation": "",
      "punjabiViakhya": "(ਠਗ ਨੇ) ਨਗਰ ਵਿਚ ਬਹੁਤ ਰੌਲਾ ਪਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "ऊचे सोर करा पुर माही ॥",
      "sourceLineId": "112591",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮੈ ਮੁਹਰਨ ਕਹ ਬੇਚਤ ਨਾਹੀ ॥੧੬॥",
      "transliteration": "mai muharan keh bechat naahee ||16||",
      "translation": "And began to shout very loud, ‘I do not want to sell the coins.’(l6)",
      "punjabiViakhya": "ਕਿ ਮੈਂ ਮੋਹਰਾ ਨਹੀਂ ਵੇਚਣੀਆਂ ਹਨ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "मै मुहरन कह बेचत नाही ॥१६॥",
      "sourceLineId": "112592",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੋਰ ਸੁਨਤ ਪੁਰ ਜਨ ਸਭ ਧਾਏ ॥",
      "transliteration": "sor sunat pur jan sabh dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੋਰ ਸੁਣ ਕੇ ਸਾਰੇ ਨਗਰ ਵਾਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "सोर सुनत पुर जन सभ धाए ॥",
      "sourceLineId": "112593",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਵਾ ਬਨਿਯਾ ਠਗ ਕੇ ਢਿਗ ਆਏ ॥",
      "transliteration": "vaa baniyaa Thag ke ddig aae ||",
      "translation": "People gathered around and saw them in altercation.",
      "punjabiViakhya": "ਉਸ ਬਨੀਏ ਅਤੇ ਠਗ ਕੋਲ ਆ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "वा बनिया ठग के ढिग आए ॥",
      "sourceLineId": "112594",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮੁਸਟ ਜੁਧ ਨਿਰਖਤ ਅਨੁਰਾਗੇ ॥",
      "transliteration": "musaT judh nirakhat anuraage ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਕਿਆਂ ਦਾ ਯੁੱਧ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "मुसट जुध निरखत अनुरागे ॥",
      "sourceLineId": "112595",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਿਹ ਦੁਹੂੰਅਨ ਕਹ ਪੂਛਨ ਲਾਗੇ ॥੧੭॥",
      "transliteration": "teh dhuhoo(n)an keh poochhan laage ||17||",
      "translation": "They were surprised to see them in scuffle and asked the reason.(17)",
      "punjabiViakhya": "ਪ੍ਰੇਮ ਪੂਰਵਕ ਦੋਹਾ ਨੂੰ ਪੁਛਣ ਲਗੇ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "तिह दुहूँअन कह पूछन लागे ॥१७॥",
      "sourceLineId": "112596",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੁਮ ਕ੍ਯੋ ਜੁਧ ਕਰਤ ਹੋ ਭਾਈ ॥",
      "transliteration": "tum kayo judh karat ho bhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਭਰਾਵੋ! ਤੁਸੀਂ ਕਿਉਾਂ ਲੜ ਰਹੇ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "तुम क्यो जुध करत हो भाई ॥",
      "sourceLineId": "112597",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਹਮੈ ਕਹਹੁ ਸਭ ਬ੍ਰਿਥਾ ਸੁਨਾਈ ॥",
      "transliteration": "hamai kahahu sabh birathaa sunaiee ||",
      "translation": "‘Why are you fighting, tell us the whole story.’",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਸਾਨੂੰ ਆਪਣੀ ਸਾਰੀ ਗੱਲ ਦਸੋ।",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "हमै कहहु सभ बृथा सुनाई ॥",
      "sourceLineId": "112598",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੁਹੂੰਅਨ ਕਹ ਅਬ ਹੀ ਗਹਿ ਲੈਹੈ ॥",
      "transliteration": "dhuhoo(n)an keh ab hee geh laihai ||",
      "translation": "",
      "punjabiViakhya": "(ਤੁਹਾਨੂੰ) ਦੋਹਾ ਨੂੰ ਫੜ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "दुहूँअन कह अब ही गहि लैहै ॥",
      "sourceLineId": "112599",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਲੈ ਕਾਜੀ ਪੈ ਨ੍ਯਾਇ ਚੁਕੈਹੈ ॥੧੮॥",
      "transliteration": "lai kaajee pai nayai chukaihai ||18||",
      "translation": "They caught hold of them both and told them to go to the Quazi, the priest arbitrator.(18)",
      "punjabiViakhya": "ਹੁਣ ਕਾਜ਼ੀ ਪਾਸ ਲੈ ਜਾ ਕੇ ਇਨਸਾਫ਼ ਕਰਾਉਾਂਦੇ ਹਾ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "लै काजी पै न्याइ चुकैहै ॥१८॥",
      "sourceLineId": "112600",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੁਨਤ ਬਚਨ ਉਦਿਤ ਠਗ ਭਯੋ ॥",
      "transliteration": "sunat bachan udhit Thag bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਗੱਲ ਸੁਣਦਿਆਂ ਹੀ ਠਗ ਤਿਆਰ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "सुनत बचन उदित ठग भयो ॥",
      "sourceLineId": "112601",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਾ ਕਹ ਲੈ ਕਾਜੀ ਪਹ ਗਯੋ ॥",
      "transliteration": "taa keh lai kaajee peh gayo ||",
      "translation": "The swindler readily agreed and taking the Shah with him left for the Quazi.",
      "punjabiViakhya": "ਅਤੇ ਉਸ (ਬਨੀਏ) ਨੂੰ ਲੈ ਕੇ ਕਾਜ਼ੀ ਪਾਸ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "ता कह लै काजी पह गयो ॥",
      "sourceLineId": "112602",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਧਿਕ ਦੁਖਿਤ ਹ੍ਵੈ ਦੀਨ ਪੁਕਾਰੋ ॥",
      "transliteration": "adhik dhukhit havai dheen pukaaro ||",
      "translation": "",
      "punjabiViakhya": "ਅਤਿ ਅਧਿਕ ਦੁਖੀ ਅਤੇ ਨਿਮਰਤਾਵਾਨ ਹੋ ਕੇ ਕਹਿਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "अधिक दुखित ह्वै दीन पुकारो ॥",
      "sourceLineId": "112603",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਰਿ ਕਾਜੀ ਤੈ ਨ੍ਯਾਇ ਹਮਾਰੋ ॥੧੯॥",
      "transliteration": "kar kaajee tai nayai hamaaro ||19||",
      "translation": "With great distress he requested the Quazi to do the justice.(19)",
      "punjabiViakhya": "ਹੇ ਕਾਜ਼ੀ! ਤੁਸੀਂ ਸਾਡਾ ਇਨਸਾਫ਼ ਕਰੋ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "करि काजी तै न्याइ हमारो ॥१९॥",
      "sourceLineId": "112604",
      "sourceShabadId": "10034",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "112605",
      "sourceShabadId": "10035",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਬ ਲਗਿ ਬਨਿਯਾ ਹ੍ਵੈ ਦੁਖੀ ਇਮਿ ਕਾਜੀ ਸੋ ਬੈਨ ॥",
      "transliteration": "tab lag baniyaa havai dhukhee im kaajee so bain ||",
      "translation": "The Shah too, in agony begged the Quazi,",
      "punjabiViakhya": "ਉਦੋਂ ਤਕ ਬਨੀਆ ਵੀ ਦੁਖੀ ਹੋ ਕੇ ਕਾਜ਼ੀ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿਣ ਲਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "तब लगि बनिया ह्वै दुखी इमि काजी सो बैन ॥",
      "sourceLineId": "112606",
      "sourceShabadId": "10035",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਹਮਰੌ ਕਰੌ ਨਿਯਾਇ ਤੁਮ ਕਹਿਯੋ ਸ੍ਰਵਤ ਜਲ ਨੈਨ ॥੨੦॥",
      "transliteration": "hamarau karau niyai tum kahiyo sravat jal nain ||20||",
      "translation": "And asked him to do full justice.(20)",
      "punjabiViakhya": "ਅਤੇ ਅੱਖਾ ਵਿਚੋਂ ਹੰਝੂ ਕੇਰਦਾ ਹੋਇਆ ਬੋਲਿਆ ਕਿ ਤੁਸੀਂ ਸਾਡਾ ਨਿਆਂ ਕਰ ਦਿਓ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "हमरौ करौ नियाइ तुम कहियो स्रवत जल नैन ॥२०॥",
      "sourceLineId": "112607",
      "sourceShabadId": "10035",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "112608",
      "sourceShabadId": "10036",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੁਨੁ ਕਾਜੀ ਜੂ ਬਚਨ ਹਮਾਰੇ ॥",
      "transliteration": "sun kaajee joo bachan hamaare ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਕਾਜੀ ਜੀ! ਸਾਡੀ ਗੱਲ ਸੁਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "सुनु काजी जू बचन हमारे ॥",
      "sourceLineId": "112609",
      "sourceShabadId": "10036",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਲਾਮੁਲਾ ਕੀ ਆਨਿ ਤਿਹਾਰੇ ॥",
      "transliteration": "kalaamulaa kee aan tihaare ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਹਾਨੂੰ 'ਕਲਾਮੁਲਾ' (ਖ਼ੁਦਾ ਦੇ ਕਲਾਮ, ਭਾਵ ਕੁਰਾਨ) ਦੀ ਕਸਮ।",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "कलामुला की आनि तिहारे ॥",
      "sourceLineId": "112610",
      "sourceShabadId": "10036",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਖੁਦਾਇ ਸੁਨੌਗੇ ਦਾਦ ਹਮਾਰੋ ॥",
      "transliteration": "khudhai sunauage dhaadh hamaaro ||",
      "translation": "",
      "punjabiViakhya": "ਖ਼ੁਦਾ ਸਾਡੀ ਫ਼ਰਿਆਦ ਸੁਣੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "खुदाइ सुनौगे दाद हमारो ॥",
      "sourceLineId": "112611",
      "sourceShabadId": "10036",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਹ੍ਵੈਹੌ ਦਾਵਨਗੀਰ ਤੁਹਾਰੋ ॥੨੧॥",
      "transliteration": "havaihau dhaavanageer tuhaaro ||21||",
      "translation": "",
      "punjabiViakhya": "ਅਸੀਂ ਤੁਹਾਡਾ ਲੜ ਫੜਿਆ ਹੈ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "ह्वैहौ दावनगीर तुहारो ॥२१॥",
      "sourceLineId": "112612",
      "sourceShabadId": "10036",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "112613",
      "sourceShabadId": "10037",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਧਿਕ ਦੀਨ ਹ੍ਵੈ ਠਗ ਕਹਿਯੋ ਸੁਨੁ ਕਾਜਿਨ ਕੇ ਰਾਇ ॥",
      "transliteration": "adhik dheen havai Thag kahiyo sun kaajin ke rai ||",
      "translation": "‘Listen Quazi; listen to our accounts, keeping in mind the honour of Allah.",
      "punjabiViakhya": "ਬਹੁਤ ਨਿਮਾਣਾ ਹੋ ਕੇ ਠਗ ਨੇ ਕਿਹਾ, ਹੇ ਕਾਜ਼ੀਆਂ ਦੇ ਸ਼ਿਰੋਮਣੀ!",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "अधिक दीन ह्वै ठग कहियो सुनु काजिन के राइ ॥",
      "sourceLineId": "112614",
      "sourceShabadId": "10037",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹਮ ਪੁਕਾਰ ਤੁਮ ਪੈ ਕਰੀ ਹਮਰੋ ਕਰੋ ਨ੍ਯਾਇ ॥੨੨॥",
      "transliteration": "ham pukaar tum pai karee hamaro karo nayai ||22||",
      "translation": "‘God, Almighty is all perceptive and hope He will facilitate us.(22)",
      "punjabiViakhya": "ਅਸੀਂ ਤੁਹਾਡੇ ਕੋਲ ਪੁਕਾਰ ਕੀਤੀ ਹੈ, ਸਾਡਾ ਨਿਆਂ ਕਰੋ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "हम पुकार तुम पै करी हमरो करो न्याइ ॥२२॥",
      "sourceLineId": "112615",
      "sourceShabadId": "10037",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "112616",
      "sourceShabadId": "10038",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਬ ਕਾਜੀ ਜਿਯ ਨ੍ਯਾਇ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "tab kaajee jiy nayai bichaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕਾਜ਼ੀ ਨੇ ਮਨ ਵਿਚ ਨਿਆਂ (ਕਰਨ ਬਾਰੇ) ਸੋਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "तब काजी जिय न्याइ बिचारियो ॥",
      "sourceLineId": "112617",
      "sourceShabadId": "10038",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0857_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪ੍ਰਗਟ ਸਭਾ ਮੈ ਦੁਹੂੰ ਉਚਾਰਿਯੋ ॥",
      "transliteration": "pragaT sabhaa mai dhuhoo(n) uchaariyo ||",
      "translation": "Then the Quazi pondered over and addressed both in the gathering.",
      "punjabiViakhya": "(ਅਤੇ ਫਿਰ) ਸਭਾ ਵਿਚ ਦੋਹਾ ਨੂੰ ਸਾਫ਼ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 857,
      "hindi": "",
      "hindiTransliteration": "प्रगट सभा मै दुहूँ उचारियो ॥",
      "sourceLineId": "112618",
      "sourceShabadId": "10038",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
