{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 871,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0871_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "113291",
      "sourceShabadId": "10147",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਬ ਕੰਨ੍ਯਾ ਐਸੇ ਕਹੇ ਸਕਲ ਸਖਿਨ ਸੋ ਬੈਨ ॥",
      "transliteration": "tab ka(n)nayaa aaise kahe sakal sakhin so bain ||",
      "translation": "Then the damsel told all her friends like this,",
      "punjabiViakhya": "ਤਦ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਸਾਰੀਆਂ ਸਖੀਆਂ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਬੋਲ ਕਹੇ।",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "तब कंन्या ऐसे कहे सकल सखिन सो बैन ॥",
      "sourceLineId": "113292",
      "sourceShabadId": "10147",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਿਕਟ ਕਟਕ ਕੇ ਸੁਭਟ ਭਟ ਪਠਵੋ ਜਮ ਕੇ ਐਨ ॥੨੦॥",
      "transliteration": "bikaT kaTak ke subhaT bhaT paThavo jam ke aain ||20||",
      "translation": "‘I will send all those invincible warriors to the hell today.’(20)",
      "punjabiViakhya": "ਅਜ ਮੈਂ ਵਿਕਟ ਅਤੇ ਸ੍ਰੇਸ਼ਠ ਸੂਰਮਿਆਂ ਨੂੰ ਯਮਲੋਕ ਭੇਜ ਦਿਆਂਗੀ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "बिकट कटक के सुभट भट पठवो जम के ऐन ॥२०॥",
      "sourceLineId": "113293",
      "sourceShabadId": "10147",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਕਲ ਸਖਿਨ ਕੋ ਸਸਤ੍ਰ ਦੈ ਅਵਰ ਕਵਚ ਪਹਿਰਾਇ ॥",
      "transliteration": "sakal sakhin ko sasatr dhai avar kavach pahirai ||",
      "translation": "She gave arms to all the friends and put arm ours on them,",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਸਖੀਆਂ ਨੂੰ ਸ਼ਸਤ੍ਰ ਦੇ ਕੇ ਅਤੇ ਕਵਚ ਪਵਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "सकल सखिन को ससत्र दै अवर कवच पहिराइ ॥",
      "sourceLineId": "113294",
      "sourceShabadId": "10147",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਿਕਸਿ ਆਪੁ ਠਾਢੀ ਭਈ ਜੈ ਦੁੰਦਭੀ ਬਜਾਇ ॥੨੧॥",
      "transliteration": "nikas aap Thaaddee bhiee jai dhu(n)dhabhee bajai ||21||",
      "translation": "And beating the drum, herself, she came and stood there.(21)",
      "punjabiViakhya": "ਆਪ ਨਿਕਲ ਕੇ ਡਟ ਗਈ ਅਤੇ ਜਿੱਤ ਦਾ ਨਗਾਰਾ ਵਜਾ ਦਿੱਤਾ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "निकसि आपु ठाढी भई जै दुँदभी बजाइ ॥२१॥",
      "sourceLineId": "113295",
      "sourceShabadId": "10147",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "113296",
      "sourceShabadId": "10148",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕੰਨ੍ਯਾ ਰਥ ਆਰੂੜਿਤ ਭਈ ॥",
      "transliteration": "ka(n)nayaa rath aarooRit bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਕੰਨਿਆ ਰਥ ਉਤੇ ਸਵਾਰ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "कंन्या रथ आरूड़ित भई ॥",
      "sourceLineId": "113297",
      "sourceShabadId": "10148",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੁਧਿ ਸਮਗ੍ਰੀ ਸਭਿਯਨ ਦਈ ॥",
      "transliteration": "judh samagree sabhiyan dhiee ||",
      "translation": "She climbed on a chariot and distributed the warfare arms to all.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੀਆਂ ਨੂੰ ਯੁੱਧ ਦਾ ਸਾਮਾਨ ਦੇ ਦਿੱਤਾ (ਅਰਥਾਤ ਹਥਿਆਰ ਵੰਡ ਦਿੱਤੇ)।",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "जुधि समग्री सभियन दई ॥",
      "sourceLineId": "113298",
      "sourceShabadId": "10148",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਫਾਜੰਗ ਮਹਿ ਤੁਰੈ ਨਚਾਏ ॥",
      "transliteration": "safaaja(n)g meh turai nachaae ||",
      "translation": "",
      "punjabiViakhya": "ਸੈਨਾ ਦੀਆਂ ਕਤਾਰਾ ਵਿਚ ਘੋੜੇ ਨਚਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "सफाजंग महि तुरै नचाए ॥",
      "sourceLineId": "113299",
      "sourceShabadId": "10148",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੁਰ ਸੁਰਪਤਿ ਦੇਖਨ ਰਨ ਆਏ ॥੨੨॥",
      "transliteration": "sur surapat dhekhan ran aae ||22||",
      "translation": "She made the horses to dance in the field and, even, the gods came to observe.(22)",
      "punjabiViakhya": "ਅਤੇ ਦੇਵਤੇ ਤੇ ਇੰਦਰ ਵੀ (ਉਸ) ਲੜਾਈ ਨੂੰ ਵੇਖਣ ਆਏ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "सुर सुरपति देखन रन आए ॥२२॥",
      "sourceLineId": "113300",
      "sourceShabadId": "10148",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "113301",
      "sourceShabadId": "10149",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਉਮਡੇ ਅਮਿਤ ਅਨੇਕ ਦਲ ਬਾਰਦ ਬੂੰਦ ਸਮਾਨ ॥",
      "transliteration": "aumadde amit anek dhal baaradh boo(n)dh samaan ||",
      "translation": "Like the black clouds, armies appeared.",
      "punjabiViakhya": "(ਉਥੇ) ਅਨੇਕ ਸੈਨਾ ਦਲ ਜਲ ਦੀਆਂ ਬੂੰਦਾ ਵਾਗ ਉਮਡ ਪਏ",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "उमडे अमित अनेक दल बारद बूँद समान ॥",
      "sourceLineId": "113302",
      "sourceShabadId": "10149",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਨਿ ਬਨਿ ਨ੍ਰਿਪ ਆਵਤ ਭਏ ਸਮਰ ਸੁਯੰਬਰ ਜਾਨ ॥੨੩॥",
      "transliteration": "ban ban nirap aavat bhe samar suya(n)bar jaan ||23||",
      "translation": "Hearing the news of swayamber for the selection of the bridegroom, fully adorned, the princess arrived.(23)",
      "punjabiViakhya": "ਅਤੇ ਯੁੱਧ ਸੁਅੰਬਰ ਦੀ ਗੱਲ ਸੁਣ ਕੇ ਰਾਜੇ ਸਜ ਧਜ ਕੇ ਆਉਣ ਲਗੇ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "बनि बनि नृप आवत भए समर सुयंबर जान ॥२३॥",
      "sourceLineId": "113303",
      "sourceShabadId": "10149",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "113304",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਚਿਯੌ ਤੁਮਲ ਜੁਧ ਤਹ ਭਾਰੀ ॥",
      "transliteration": "machiyau tumal judh teh bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਬਹੁਤ ਘਮਸਾਨ ਯੁੱਧ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "मचियौ तुमल जुध तह भारी ॥",
      "sourceLineId": "113305",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਚੇ ਸੂਰਬੀਰ ਹੰਕਾਰੀ ॥",
      "transliteration": "naache soorabeer ha(n)kaaree ||",
      "translation": "The ruinous war was ensued and the braves enacted the war dance.",
      "punjabiViakhya": "ਅਭਿਮਾਨੀ ਸੂਰਮੇ ਨਚਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "नाचे सूरबीर हंकारी ॥",
      "sourceLineId": "113306",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਾਨਿ ਧਨੁਹਿਯਨ ਬਿਸਿਖ ਚਲਾਵਤ ॥",
      "transliteration": "taan dhanuhiyan bisikh chalaavat ||",
      "translation": "",
      "punjabiViakhya": "(ਦ੍ਰਿੜ੍ਰਹਤਾ ਪੂਰਵਕ) ਧਨੁਸ਼ ਖਿਚ ਕੇ ਤੀਰ ਚਲਾਉਾਂਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "तानि धनुहियन बिसिख चलावत ॥",
      "sourceLineId": "113307",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਾਇ ਮਰੇ ਪਦ ਕੂਕਿ ਸੁਨਾਵਤ ॥੨੪॥",
      "transliteration": "mai mare padh kook sunaavat ||24||",
      "translation": "With fully stretched bows, they came into action and dying braves yelled for their mothers.(24)",
      "punjabiViakhya": "ਅਤੇ 'ਹਾਇ ਮਾ ਮਰ ਗਏ' ਸ਼ਬਦ ਕੂਕ ਕੇ ਸੁਣਾਉਾਂਦੇ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "माइ मरे पद कूकि सुनावत ॥२४॥",
      "sourceLineId": "113308",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਿਹ ਬਚਿਤ੍ਰ ਦੇ ਬਾਨ ਲਗਾਵੈ ॥",
      "transliteration": "jeh bachitr dhe baan lagaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਬਚਿਤ੍ਰ ਦੇਈ (ਰਾਜ ਕੁਮਾਰੀ) ਬਾਣ ਮਾਰਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "जिह बचित्र दे बान लगावै ॥",
      "sourceLineId": "113309",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਵਹੈ ਸੁਭਟ ਮ੍ਰਿਤੁ ਲੋਕ ਸਿਧਾਵੈ ॥",
      "transliteration": "vahai subhaT mrit lok sidhaavai ||",
      "translation": "When an arrow hit some one, that brave departed for heavens.",
      "punjabiViakhya": "ਉਹ ਯੋਧਾ ਮ੍ਰਿਤ ਲੋਕ ਨੂੰ ਚਲਾ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "वहै सुभट मृतु लोक सिधावै ॥",
      "sourceLineId": "113310",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਾ ਪਰ ਤਮਕਿ ਤੇਗ ਕੀ ਝਾਰੈ ॥",
      "transliteration": "jaa par tamak teg kee jhaarai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਉਤੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਤਲਵਾਰ ਦਾ ਵਾਰ ਕਰਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "जा पर तमकि तेग की झारै ॥",
      "sourceLineId": "113311",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਾ ਕੋ ਮੂੰਡ ਕਾਟਿ ਹੀ ਡਾਰੈ ॥੨੫॥",
      "transliteration": "taa ko moo(n)dd kaaT hee ddaarai ||25||",
      "translation": "When some one received the stroke of sword, he got his head severed.(25)",
      "punjabiViakhya": "ਉਸ ਦਾ ਸਿਰ ਕਟ ਕੇ ਸੁਟ ਦਿੰਦੀ ਹੈ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "ता को मूँड काटि ही डारै ॥२५॥",
      "sourceLineId": "113312",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਾਹੂ ਸਿਮਟਿ ਸੈਹਥੀ ਹਨੈ ॥",
      "transliteration": "kaahoo simaT saihathee hanai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੂੰ ਸੈਹਥੀ ਸੰਭਾਲ ਕੇ ਮਾਰ ਦਿੰਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "काहू सिमटि सैहथी हनै ॥",
      "sourceLineId": "113313",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਏਕ ਸੁਭਟ ਮਨ ਮਾਹਿ ਨ ਗਨੈ ॥",
      "transliteration": "ek subhaT man maeh na ganai ||",
      "translation": "Some became the victims of her dagger as she did not consider anyone of them credit worthy.",
      "punjabiViakhya": "ਅਤੇ (ਕਿਸੇ) ਇਕ ਸੂਰਮੇ ਨੂੰ ਵੀ ਮਨ ਵਿਚ ਨਹੀਂ ਗਿਣਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "एक सुभट मन माहि न गनै ॥",
      "sourceLineId": "113314",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦੇਖੈ ਸੁਰ ਬਿਬਾਨ ਚੜਿ ਸਾਰੇ ॥",
      "transliteration": "dhekhai sur bibaan chaR saare ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਦੇਵਤੇ ਬਿਮਾਨਾ ਉਤੇ ਚੜ੍ਰਹ ਕੇ ਵੇਖ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "देखै सुर बिबान चड़ि सारे ॥",
      "sourceLineId": "113315",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਚਟਿਪਟ ਸੁਭਟ ਬਿਕਟ ਕਟਿ ਡਾਰੇ ॥੨੬॥",
      "transliteration": "chaTipaT subhaT bikaT kaT ddaare ||26||",
      "translation": "All the gods were watching from their aero-chariots, how rapidly the intrepid were annihilated.(26)",
      "punjabiViakhya": "ਕਿ ਕਿਵੇਾਂ ਵਿਕਟ ਸੂਰਮੇ ਝਟਪਟ ਕਟੇ ਜਾ ਰਹੇ ਹਨ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "चटिपट सुभट बिकट कटि डारे ॥२६॥",
      "sourceLineId": "113316",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗੀਧਨ ਕੋ ਮਨ ਭਯੋ ਅਨੰਦੰ ॥",
      "transliteration": "geedhan ko man bhayo ana(n)dha(n) ||",
      "translation": "",
      "punjabiViakhya": "ਗਿਰਝਾ ਦੇ ਮਨ ਆਨੰਦਿਤ ਹੋ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "गीधन को मन भयो अनंदं ॥",
      "sourceLineId": "113317",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਆਜੁ ਭਖੈ ਮਾਨਸ ਕੇ ਅੰਗੰ ॥",
      "transliteration": "aaj bhakhai maanas ke a(n)ga(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਅਜ ਮਨੁੱਖਾ ਦਾ ਮਾਸ ਖਾਣ ਨੂੰ ਮਿਲੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "आजु भखै मानस के अंगं ॥",
      "sourceLineId": "113318",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦਹਿਨੇ ਬਾਏ ਜੋਗਿਨਿ ਖੜੀ ॥",
      "transliteration": "dhahine baae jogin khaRee ||",
      "translation": "",
      "punjabiViakhya": "ਸੱਜੇ ਖੱਬੇ ਲਹੂ ਦੇ ਬਰਤਨ",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "दहिने बाए जोगिनि खड़ी ॥",
      "sourceLineId": "113319",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਲੈ ਪਾਤਰ ਸ੍ਰੋਨਤ ਕਹ ਅੜੀ ॥੨੭॥",
      "transliteration": "lai paatar sronat keh aRee ||27||",
      "translation": "",
      "punjabiViakhya": "(ਖਪਰ) ਲੈ ਕੇ ਜੋਗਣਾ ਖੜੋਤੀਆਂ ਹਨ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "लै पातर स्रोनत कह अड़ी ॥२७॥",
      "sourceLineId": "113320",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮਾਰੂ ਦੁਹੂੰ ਦਿਸਨ ਮੈ ਬਾਜੈ ॥",
      "transliteration": "maaroo dhuhoo(n) dhisan mai baajai ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਪਾਸਿਆਂ ਤੋਂ ਮਾਰੂ ਵਾਜੇ ਵਜਣ ਲਗੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "मारू दुहूँ दिसन मै बाजै ॥",
      "sourceLineId": "113321",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੁਹੂੰ ਓਰ ਸਸਤ੍ਰਨ ਭਟ ਸਾਜੈ ॥",
      "transliteration": "dhuhoo(n) or sasatran bhaT saajai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਹਾ ਪਾਸਿਆਂ ਤੋਂ ਸੂਰਮੇ ਸ਼ਸਤ੍ਰਾ ਨਾਲ ਸਜੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "दुहूँ ओर ससत्रन भट साजै ॥",
      "sourceLineId": "113322",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਊਪਰ ਗਿਧ ਸਾਲ ਮੰਡਰਾਹੀ ॥",
      "transliteration": "uoopar gidh saal ma(n)ddaraahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਪਰ ਗਿਰਝਾ ਅਤੇ ਅਪੱਛਰਾਵਾ ('ਸਾਲ' ਸ਼ਾਵਲ੍ਰਯਾ) ਮੰਡਰਾ ਰਹੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "ऊपर गिध साल मंडराही ॥",
      "sourceLineId": "113323",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਰੈ ਸੂਰਮਾ ਜੁਧ ਮਚਾਹੀ ॥੨੮॥",
      "transliteration": "tarai sooramaa judh machaahee ||28||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੇਠਾ ਸੂਰਮਿਆਂ ਨੇ ਯੁੱਧ ਮਚਾਇਆ ਹੋਇਆ ਹੈ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "तरै सूरमा जुध मचाही ॥२८॥",
      "sourceLineId": "113324",
      "sourceShabadId": "10150",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਵੈਯਾ ॥",
      "transliteration": "savaiyaa ||",
      "translation": "Savaiyya",
      "punjabiViakhya": "ਸਵੈਯਾ:",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "सवैया ॥",
      "sourceLineId": "113325",
      "sourceShabadId": "10151",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਾਲ ਕੋ ਰੂਪ ਅਨੂਪਮ ਹੇਰਿ ਚਹੂੰ ਦਿਸਿ ਤੇ ਨ੍ਰਿਪ ਚੌਪਿ ਚਲੇ ॥",
      "transliteration": "baal ko roop anoopam her chahoo(n) dhis te nirap chauap chale ||",
      "translation": "Admiring the beauty of the princess, the braves swarmed the place from all the sides.",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਦੇ ਅਨੂਪਮ ਰੂਪ ਨੂੰ ਵੇਖ ਕੇ ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ ਰਾਜੇ ਉਤਸਾਹ ਨਾਲ ਅਗੇ ਵਧ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "बाल को रूप अनूपम हेरि चहूँ दिसि ते नृप चौपि चले ॥",
      "sourceLineId": "113326",
      "sourceShabadId": "10151",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗਜਰਾਜਨ ਬਾਜਨ ਕੇ ਅਸਵਾਰ ਰਥੀ ਰਥ ਪਾਇਕ ਜੋਰਿ ਭਲੇ ॥",
      "transliteration": "gajaraajan baajan ke asavaar rathee rath paik jor bhale ||",
      "translation": "The valiant ones on the horsebacks and elephants marched ahead.",
      "punjabiViakhya": "ਹਾਥੀਆਂ ਅਤੇ ਘੋੜਿਆਂ ਦੇ ਸਵਾਰ, ਰਥਾ ਵਾਲੇ ਅਤੇ ਪੈਦਲ ਇਕੱਠੇ ਹੋ ਕੇ (ਚਲ ਪਏ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "गजराजन बाजन के असवार रथी रथ पाइक जोरि भले ॥",
      "sourceLineId": "113327",
      "sourceShabadId": "10151",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਬ ਰਾਇ ਬਚਿਤ੍ਰ ਕ੍ਰਿਪਾਨ ਗਹੀ ਤਜਿ ਲਾਜ ਹਠੀ ਯੌ ਰਨ ਬਿਚਲੇ ॥",
      "transliteration": "jab rai bachitr kirapaan gahee taj laaj haThee yau ran bichale ||",
      "translation": "When the Raja drew his sword, some of them, to protect their honours, jumped forward,",
      "punjabiViakhya": "ਜਦੋਂ ਰਾਜੇ ਦੀ ਪੁੱਤਰੀ ਬਚਿਤ੍ਰ ਦੇਵੀ ਨੇ ਕ੍ਰਿਪਾਨ ਧਾਰਨ ਕਰ ਲਈ ਤਾ ਲਾਜ ਮਰਯਾਦਾ ਛਡ ਕੇ (ਸਾਰੇ ਰਾਜੇ) ਰਣ ਵਿਚ ਅਜਿਹੇ ਵਿਚਲਿਤ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "जब राइ बचित्र कृपान गही तजि लाज हठी यौ रन बिचले ॥",
      "sourceLineId": "113328",
      "sourceShabadId": "10151",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮਨੋ ਰਾਮ ਕੇ ਨਾਮ ਕਹੇ ਮੁਖ ਤੇ ਅਘ ਓਘਨ ਕੇ ਤ੍ਰਸਿ ਬ੍ਰਿੰਦ ਟਲੇ ॥੨੯॥",
      "transliteration": "mano raam ke naam kahe mukh te agh oghan ke tras bira(n)dh Tale ||29||",
      "translation": "Like the devotees of Rama proceeded to get rid oftheir vices.(29)",
      "punjabiViakhya": "ਮਾਨੋ ਰਾਮ ਦਾ ਨਾਮ ਲੈਣ ਨਾਲ ਪਾਪਾ ਦੇ ਸਮੂਹ ਡਰ ਦੇ ਮਾਰੇ ਭਜ ਗਏ ਹੋਣ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "मनो राम के नाम कहे मुख ते अघ ओघन के त्रसि बृंद टले ॥२९॥",
      "sourceLineId": "113329",
      "sourceShabadId": "10151",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕੋਪ ਪ੍ਰਚੰਡ ਭਰੇ ਮਨ ਮੈ ਭਟ ਚੌਪਿ ਚੜੇ ਚਹੂੰ ਘਾ ਚਪਿ ਧਾਏ ॥",
      "transliteration": "kop pracha(n)dd bhare man mai bhaT chauap chaRe chahoo(n) ghaa chap dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਗੁੱਸੇ ਨਾਲ ਭਰ ਕੇ ਅਤੇ ਮਨ ਵਿਚ ਉਤਸਾਹਿਤ ਹੋ ਕੇ ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ ਟੁਟ ਕੇ ਪੈ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "कोप प्रचंड भरे मन मै भट चौपि चड़े चहूँ घा चपि धाए ॥",
      "sourceLineId": "113330",
      "sourceShabadId": "10151",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਾਢਿ ਕ੍ਰਿਪਾਨ ਲਈ ਬਲਵਾਨਨ ਤਾਨਿ ਕਮਾਨਨ ਬਾਨ ਚਲਾਏ ॥",
      "transliteration": "kaadd kirapaan liee balavaanan taan kamaanan baan chalaae ||",
      "translation": "",
      "punjabiViakhya": "ਬਲਵਾਨਾ ਨੇ ਕ੍ਰਿਪਾਨਾ ਕਢ ਲਈਆਂ ਹਨ ਅਤੇ ਕਮਾਨਾ ਨੂੰ ਖਿਚ ਕੇ ਬਾਣ ਚਲਾਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "काढि कृपान लई बलवानन तानि कमानन बान चलाए ॥",
      "sourceLineId": "113331",
      "sourceShabadId": "10151",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬੂੰਦਨ ਜ੍ਯੋ ਬਰਖੇ ਚਹੂੰ ਓਰਨ ਬੇਧਿ ਸਨਾਹਨ ਪਾਰ ਪਰਾਏ ॥",
      "transliteration": "boo(n)dhan jayo barakhe chahoo(n) oran bedh sanaahan paar paraae ||",
      "translation": "",
      "punjabiViakhya": "(ਤੀਰ) ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ ਬਰਖਾ ਦੀਆਂ ਬੂੰਦਾ ਵਾਗ ਵਰ੍ਰਹਦੇ ਹਨ ਅਤੇ ਕਵਚਾ ('ਸਨਾਹਨ') ਨੂੰ ਵਿੰਨ੍ਰਹ ਕੇ ਪਾਰ ਹੁੰਦੇ ਜਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "बूँदन ज्यो बरखे चहूँ ओरन बेधि सनाहन पार पराए ॥",
      "sourceLineId": "113332",
      "sourceShabadId": "10151",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬੀਰਨ ਚੀਰ ਬਿਦੀਰਨ ਭੂਮਿ ਕੋ ਬਾਰਿ ਕੋ ਫਾਰਿ ਪਤਾਰ ਸਿਧਾਏ ॥੩੦॥",
      "transliteration": "beeran cheer bidheeran bhoom ko baar ko faar pataar sidhaae ||30||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਨੂੰ ਚੀਰ ਕੇ ਅਤੇ ਧਰਤੀ ਨੂੰ ਪਾੜ ਕੇ ਅਤੇ ਜਲ ਨੂੰ ਫਾੜ ਕੇ ਪਤਾਲ ਪਹੁੰਚ ਗਏ ਹਨ ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "बीरन चीर बिदीरन भूमि को बारि को फारि पतार सिधाए ॥३०॥",
      "sourceLineId": "113333",
      "sourceShabadId": "10151",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "113334",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚਟਪਟ ਸੁਭਟ ਬਿਕਟ ਕਟਿ ਗਏ ॥",
      "transliteration": "chaTapaT subhaT bikaT kaT ge ||",
      "translation": "",
      "punjabiViakhya": "ਝਟਪਟ ਵਿਕਟ ਸੂਰਮੇ ਕਟੇ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": "चटपट सुभट बिकट कटि गए ॥",
      "sourceLineId": "113335",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0871_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕੇਤੇ ਕਰੀ ਕਰਨ ਬਿਨੁ ਭਏ ॥",
      "transliteration": "kete karee karan bin bhe ||",
      "translation": "",
