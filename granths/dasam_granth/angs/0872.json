{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 872,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0872_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮੁਨਿ ਨਾਰਦ ਕਹੂੰ ਬੇਨੁ ਬਜਾਵੈ ॥",
      "transliteration": "mun naaradh kahoo(n) ben bajaavai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਨਾਰਦ ਮੁਨੀ ਬੀਨ ਵਜਾ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "मुनि नारद कहूँ बेनु बजावै ॥",
      "sourceLineId": "113339",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਹੂੰ ਰੁਦ੍ਰ ਡਮਰੂ ਡਮਕਾਵੈ ॥",
      "transliteration": "kahoo(n) rudhr ddamaroo ddamakaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਰੁਦ੍ਰ ਡਮਰੂ ਡਮਕਾ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "कहूँ रुद्र डमरू डमकावै ॥",
      "sourceLineId": "113340",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰੁਧਿਰ ਖਪਰ ਜੁਗਿਨ ਭਰਿ ਭਾਰੀ ॥",
      "transliteration": "rudhir khapar jugin bhar bhaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਤੇ) ਜੋਗਣਾ ਨੇ ਲਹੂ ਨਾਲ ਵੱਡੇ ਖੱਪਰ ਭਰੇ ਹੋਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "रुधिर खपर जुगिन भरि भारी ॥",
      "sourceLineId": "113341",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਾਰਹਿ ਭੂਤ ਪ੍ਰੇਤ ਕਿਲਕਾਰੀ ॥੩੨॥",
      "transliteration": "maareh bhoot pret kilakaaree ||32||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਕਿਤੇ) ਭੂਤ ਅਤੇ ਪ੍ਰੇਤ ਕਿਲਕਾਰੀਆਂ ਮਾਰ ਰਹੇ ਸਨ ॥੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "मारहि भूत प्रेत किलकारी ॥३२॥",
      "sourceLineId": "113342",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰਨ ਅਗੰਮ ਕੋਊ ਜਾਨ ਨ ਪਾਵੈ ॥",
      "transliteration": "ran aga(n)m kouoo jaan na paavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਗੰਮੀ ਯੁੱਧ ਨੂੰ ਕੋਈ ਸਮਝ ਨਹੀਂ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "रन अगंम कोऊ जान न पावै ॥",
      "sourceLineId": "113343",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਡਹ ਡਹ ਡਹ ਸਿਵ ਡਮਰੁ ਬਜਾਵੈ ॥",
      "transliteration": "ddeh ddeh ddeh siv ddamar bajaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਿਵ ਡਹਿ ਡਹਿ ਕਰਦਾ ਡਮਰੂ ਵਜਾ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "डह डह डह सिव डमरु बजावै ॥",
      "sourceLineId": "113344",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਹ ਕਹ ਕਹੂੰ ਕਾਲਿਕਾ ਕਹਕੈ ॥",
      "transliteration": "keh keh kahoo(n) kaalikaa kahakai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਕਾਲਿਕਾ ਕਹ ਕਹ ਕਰ ਕੇ ਬੋਲ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "कह कह कहूँ कालिका कहकै ॥",
      "sourceLineId": "113345",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਾਨੁਕ ਧੁਜਾ ਕਾਲ ਕੀ ਲਹਕੈ ॥੩੩॥",
      "transliteration": "jaanuk dhujaa kaal kee lahakai ||33||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਕਾਲ ਦਾ ਝੰਡਾ ਲਹਿਰਾ ਰਿਹਾ ਹੋਵੇ ॥੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "जानुक धुजा काल की लहकै ॥३३॥",
      "sourceLineId": "113346",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹਸਤ ਪਾਰਬਤੀ ਨੈਨ ਬਿਸਾਲਾ ॥",
      "transliteration": "hasat paarabatee nain bisaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਵਡਿਆਂ ਨੈਣਾ ਵਾਲੀ ਪਾਰਬਤੀ ਹਸ ਰਹੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "हसत पारबती नैन बिसाला ॥",
      "sourceLineId": "113347",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਾਚਤ ਭੂਪ ਪ੍ਰੇਤ ਬੈਤਾਲਾ ॥",
      "transliteration": "naachat bhoop pret baitaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੂਤ, ਪ੍ਰੇਤ ਤੇ ਬੈਤਾਲ ਨਚ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "नाचत भूप प्रेत बैताला ॥",
      "sourceLineId": "113348",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਹ ਕਹਾਟ ਕਹੂੰ ਕਾਲ ਸੁਨਾਵੈ ॥",
      "transliteration": "keh kahaaT kahoo(n) kaal sunaavai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਕਾਲੀ 'ਕਹ ਕਹਾਟ' ਸ਼ਬਦ ਸੁਣਾਉਾਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "कह कहाट कहूँ काल सुनावै ॥",
      "sourceLineId": "113349",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭੀਖਨ ਸੁਨੇ ਨਾਦ ਭੈ ਆਵੈ ॥੩੪॥",
      "transliteration": "bheekhan sune naadh bhai aavai ||34||",
      "translation": "",
      "punjabiViakhya": "ਭਿਆਨਕ ਨਾਦ ਨੂੰ ਸੁਣ ਕੇ ਡਰ ਲਗਦਾ ਸੀ ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "भीखन सुने नाद भै आवै ॥३४॥",
      "sourceLineId": "113350",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਿਨੁ ਸੀਸਨ ਕੇਤਿਕ ਭਟ ਡੋਲਹਿ ॥",
      "transliteration": "bin seesan ketik bhaT ddoleh ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਸੂਰਮੇ ਬਿਨਾ ਸਿਰਾ ਦੇ ਘੁੰਮ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "बिनु सीसन केतिक भट डोलहि ॥",
      "sourceLineId": "113351",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕੇਤਿਨ ਮਾਰਿ ਮਾਰਿ ਕਰਿ ਬੋਲਹਿ ॥",
      "transliteration": "ketin maar maar kar boleh ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤਨੇ 'ਮਾਰੋ-ਮਾਰੋ' ਪੁਕਾਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "केतिन मारि मारि करि बोलहि ॥",
      "sourceLineId": "113352",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਿਤੇ ਤਮਕਿ ਰਨ ਤੁਰੈ ਨਚਾਵੈ ॥",
      "transliteration": "kite tamak ran turai nachaavai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਘੋੜੇ ਨਚਾ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "किते तमकि रन तुरै नचावै ॥",
      "sourceLineId": "113353",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜੂਝਿ ਕਿਤਕ ਜਮ ਲੋਕ ਸਿਧਾਵੈ ॥੩੫॥",
      "transliteration": "joojh kitak jam lok sidhaavai ||35||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤਨੇ ਹੀ ਜੂਝ ਕੇ ਯਮ-ਲੋਕ ਸਿਧਾਰ ਗਏ ਸਨ ॥੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "जूझि कितक जम लोक सिधावै ॥३५॥",
      "sourceLineId": "113354",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਟਿ ਕਟਿ ਪਰੇ ਸੁਭਟ ਛਿਤ ਭਾਰੇ ॥",
      "transliteration": "kaT kaT pare subhaT chhit bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਵੱਡੇ ਸੂਰਮੇ ਕਟ ਕਟ ਕੇ ਧਰਤੀ ਉਤੇ ਡਿਗ ਪਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "कटि कटि परे सुभट छित भारे ॥",
      "sourceLineId": "113355",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਭੂਪ ਸੁਤਾ ਕਰਿ ਕੋਪ ਪਛਾਰੇ ॥",
      "transliteration": "bhoop sutaa kar kop pachhaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਕਈਆਂ ਨੂੰ) ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਪਛਾੜ ਦਿੱਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "भूप सुता करि कोप पछारे ॥",
      "sourceLineId": "113356",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਿਨ ਕੇ ਪਰੀ ਹਾਥ ਨਹਿ ਪ੍ਯਾਰੀ ॥",
      "transliteration": "jin ke paree haath neh payaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦੇ ਹੱਥ ਰਾਜ ਕੁਮਾਰੀ ਨਹੀਂ ਲਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "जिन के परी हाथ नहि प्यारी ॥",
      "sourceLineId": "113357",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਿਨੁ ਮਾਰੇ ਹਨਿ ਮਰੇ ਕਟਾਰੀ ॥੩੬॥",
      "transliteration": "bin maare han mare kaTaaree ||36||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬਿਨਾ ਮਾਰਿਆਂ ਹੀ ਕਟਾਰ ਮਾਰ ਕੇ ਮਰ ਗਏ ॥੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "बिनु मारे हनि मरे कटारी ॥३६॥",
      "sourceLineId": "113358",
      "sourceShabadId": "10152",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "113359",
      "sourceShabadId": "10153",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮੋੜਤੇਸ ਅੰਬੇਰ ਪਤਿ ਅਮਿਤ ਸੈਨ ਲੈ ਸਾਥ ॥",
      "transliteration": "moRates a(n)ber pat amit sain lai saath ||",
      "translation": "",
      "punjabiViakhya": "(ਹੁਣ) ਮੋੜ (ਮੇੜਤਾ) ਅਤੇ ਆਮੇਰ ਦੇ ਰਾਜੇ ਅਮਿਤ ਸੈਨਾ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "मोड़तेस अंबेर पति अमित सैन लै साथ ॥",
      "sourceLineId": "113360",
      "sourceShabadId": "10153",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਾਲ ਨਿਮਿਤਿ ਆਵਤ ਭਏ ਗਹੇ ਬਰਛਿਯੈ ਹਾਥ ॥੩੭॥",
      "transliteration": "baal nimit aavat bhe gahe barachhiyai haath ||37||",
      "translation": "",
      "punjabiViakhya": "ਹੱਥਾ ਵਿਚ ਬਰਛੇ ਪਕੜੇ ਹੋਏ ਰਾਜ ਕੁਮਾਰੀ (ਨੂੰ ਪ੍ਰਾਪਤ ਕਰਨ ਲਈ) ਆ ਪਹੁੰਚੇ ਸਨ ॥੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "बाल निमिति आवत भए गहे बरछियै हाथ ॥३७॥",
      "sourceLineId": "113361",
      "sourceShabadId": "10153",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਿਕਟ ਸਿੰਘ ਅੰਬੇਰ ਪਤਿ ਅਮਿਟ ਸਿੰਘ ਤਿਹ ਨਾਮ ॥",
      "transliteration": "bikaT si(n)gh a(n)ber pat amiT si(n)gh teh naam ||",
      "translation": "",
      "punjabiViakhya": "(ਮੋੜਤਾ ਦੇ ਰਾਜੇ ਦਾ ਨਾ) ਬਿਕਟ ਸਿੰਘ ਅਤੇ ਆਮੇਰ ਦੇ ਰਾਜੇ ਦਾ ਨਾ ਅਮਿਟ ਸਿੰਘ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "बिकट सिंघ अंबेर पति अमिट सिंघ तिह नाम ॥",
      "sourceLineId": "113362",
      "sourceShabadId": "10153",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਬਹੂੰ ਦਈ ਨ ਪੀਠ ਰਨ ਜੀਤੇ ਬਹੁ ਸੰਗ੍ਰਾਮ ॥੩੮॥",
      "transliteration": "kabahoo(n) dhiee na peeTh ran jeete bahu sa(n)graam ||38||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਬਹੁਤ ਯੁੱਧ ਜਿਤੇ ਸਨ ਅਤੇ ਰਣ ਵਿਚ ਕਦੇ ਪਿਠ ਨਹੀਂ ਵਿਖਾਈ ਸੀ ॥੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "कबहूँ दई न पीठ रन जीते बहु संग्राम ॥३८॥",
      "sourceLineId": "113363",
      "sourceShabadId": "10153",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "113364",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੇ ਨ੍ਰਿਪ ਜੋਰਿ ਸੈਨ ਦ੍ਵੈ ਧਾਏ ॥",
      "transliteration": "te nirap jor sain dhavai dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦੋਵੇਾਂ ਰਾਜੇ ਸੈਨਾ ਇਕੱਠੀ ਕਰ ਕੇ ਤੁਰ ਪਏ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "ते नृप जोरि सैन द्वै धाए ॥",
      "sourceLineId": "113365",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਬਾਜਿਤ੍ਰ ਬਜਾਏ ॥",
      "transliteration": "bhaat bhaat baajitr bajaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਤਰ੍ਰਹਾ ਦੇ (ਜੰਗੀ) ਵਾਜੇ ਵਜਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "भाति भाति बाजित्र बजाए ॥",
      "sourceLineId": "113366",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਜਬ ਨੈਨ ਨਿਹਾਰੇ ॥",
      "transliteration": "raaj sutaa jab nain nihaare ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਉਨ੍ਰਹਾ ਨੂੰ ਅੱਖਾ ਨਾਲ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "राज सुता जब नैन निहारे ॥",
      "sourceLineId": "113367",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੈਨਾ ਸਹਿਤ ਮਾਰ ਹੀ ਡਾਰੇ ॥੩੯॥",
      "transliteration": "sainaa sahit maar hee ddaare ||39||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸੈਨਾ ਸਮੇਤ ਉਨ੍ਰਹਾ ਨੂੰ ਮਾਰ ਹੀ ਸੁਟਿਆ ॥੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "सैना सहित मार ही डारे ॥३९॥",
      "sourceLineId": "113368",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਬ ਅਬਲਾ ਨ੍ਰਿਪ ਦੋਊ ਸੰਘਾਰੇ ॥",
      "transliteration": "jab abalaa nirap dhouoo sa(n)ghaare ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਦੋਵੇਾਂ ਰਾਜੇ ਮਾਰ ਦਿੱਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "जब अबला नृप दोऊ संघारे ॥",
      "sourceLineId": "113369",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਠਟਕੇ ਸੁਭਟ ਸਕਲ ਤਬ ਭਾਰੇ ॥",
      "transliteration": "ThaTake subhaT sakal tab bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਸਾਰੇ ਵੱਡੇ ਰਾਜੇ ਚੁਪ ਕਰ ਕੇ ਖੜੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "ठटके सुभट सकल तब भारे ॥",
      "sourceLineId": "113370",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਖੇਤ ਛਾਡਿ ਯਹ ਤਰੁਨਿ ਨ ਟਰਿਹੈ ॥",
      "transliteration": "khet chhaadd yeh tarun na Tarihai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਮਨ ਵਿਚ ਸੋਚਣ ਲਗੇ) ਕਿ ਯੁੱਧ-ਭੂਮੀ ਨੂੰ ਛਡ ਕੇ ਇਹ ਰਾਜ ਕੁਮਾਰੀ ਨਹੀਂ ਟਲੇਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "खेत छाडि यह तरुनि न टरिहै ॥",
      "sourceLineId": "113371",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਭਹਿਨ ਕੋ ਪ੍ਰਾਨਨ ਬਿਨੁ ਕਰਿ ਹੈ ॥੪੦॥",
      "transliteration": "sabhahin ko praanan bin kar hai ||40||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਨੂੰ ਪ੍ਰਾਣਾ ਤੋਂ ਬਿਨਾ ਕਰ ਦੇਵੇਗੀ ॥੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "सभहिन को प्रानन बिनु करि है ॥४०॥",
      "sourceLineId": "113372",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬੂੰਦੀ ਨਾਥ ਰਣੁਤ ਕਟ ਧਾਯੋ ॥",
      "transliteration": "boo(n)dhee naath ranut kaT dhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਬੂੰਦੀ (ਰਿਆਸਤ) ਦਾ ਰਾਜਾ ਰਣੁਤ ਕਟ ਚਲ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "बूँदी नाथ रणुत कट धायो ॥",
      "sourceLineId": "113373",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਧਿਕ ਮਦੁਤ ਕਟ ਸਿੰਘ ਰਿਸਾਯੋ ॥",
      "transliteration": "adhik madhut kaT si(n)gh risaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਦੁਤ ਕਟ ਸਿੰਘ ਵੀ ਬਹੁਤ ਕ੍ਰੋਧਿਤ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "अधिक मदुत कट सिंघ रिसायो ॥",
      "sourceLineId": "113374",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਥ ਉਜੈਨ ਜਿਸੇ ਜਗ ਕਹਈ ॥",
      "transliteration": "naath ujain jise jag kahiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਲੋਕੀਂ ਉਜੈਨ ਦਾ ਰਾਜਾ ਕਹਿੰਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "नाथ उजैन जिसे जग कहई ॥",
      "sourceLineId": "113375",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਵਾ ਕਹਿ ਜੀਤੈ ਜਗ ਕੋ ਰਹਈ ॥੪੧॥",
      "transliteration": "vaa keh jeetai jag ko rahiee ||41||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜਿਤੇ ਬਿਨਾ ਜਗਤ ਵਿਚ ਕੌਣ ਰਹਿ ਸਕਦਾ ਸੀ ॥੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "वा कहि जीतै जग को रहई ॥४१॥",
      "sourceLineId": "113376",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਬ ਅਬਲਾ ਆਵਤ ਵਹੁ ਲਹੇ ॥",
      "transliteration": "jab abalaa aavat vahu lahe ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਉਨ੍ਰਹਾ ਨੂੰ ਆਉਾਂਦਿਆਂ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "जब अबला आवत वहु लहे ॥",
      "sourceLineId": "113377",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹਾਥ ਹਥਯਾਰ ਆਪਨੇ ਗਹੇ ॥",
      "transliteration": "haath hathayaar aapane gahe ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਉਸ ਨੇ) ਆਪਣੇ ਹੱਥਾ ਵਿਚ ਹਥਿਆਰ ਪਕੜ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "हाथ हथयार आपने गहे ॥",
      "sourceLineId": "113378",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਧਿਕ ਕੋਪ ਕਰਿ ਕੁਵਤਿ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "adhik kop kar kuvat prahaare ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜ ਕੁਮਾਰੀ ਨੇ) ਅਧਿਕ ਕ੍ਰੋਧ ਕਰ ਕੇ ਬਲ ਪੂਰਵਕ ('ਕੁਵਤਿ') ਚਲਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "अधिक कोप करि कुवति प्रहारे ॥",
      "sourceLineId": "113379",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਛਿਨਿਕ ਬਿਖੈ ਦਲ ਸਹਿਤ ਸੰਘਾਰੇ ॥੪੨॥",
      "transliteration": "chhinik bikhai dhal sahit sa(n)ghaare ||42||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਛਿਣ ਭਰ ਵਿਚ (ਉਨ੍ਰਹਾ ਨੂੰ) ਦਲ ਸਹਿਤ ਮਾਰ ਦਿੱਤਾ ॥੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "छिनिक बिखै दल सहित संघारे ॥४२॥",
      "sourceLineId": "113380",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗੰਗਾਦ੍ਰੀ ਜਮੁਨਾਦ੍ਰੀ ਹਠੇ ॥",
      "transliteration": "ga(n)gaadhree jamunaadhree haThe ||",
      "translation": "",
      "punjabiViakhya": "ਗੰਗਾ ਵਾਲੇ ਪਹਾੜੀ ਰਾਜੇ ਅਤੇ ਯਮੁਨਾ ਦੇ ਪਹਾੜ ਵਿਚ ਰਹਿਣ ਵਾਲੇ ਰਾਜੇ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "गंगाद्री जमुनाद्री हठे ॥",
      "sourceLineId": "113381",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਾਰਸ੍ਵਤੀ ਹ੍ਵੈ ਚਲੇ ਇਕਠੇ ॥",
      "transliteration": "saarasavaitee havai chale ikaThe ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਸਵਤੀ ਵਾਲੇ ਰਾਜੇ ਹਠ ਪੂਰਵਕ ਇਕੱਠੇ ਹੋ ਕੇ ਚਲੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "सारस्वती ह्वै चले इकठे ॥",
      "sourceLineId": "113382",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਤੁਦ੍ਰਵਾਦਿ ਅਤਿ ਦ੍ਰਿੜ ਪਗ ਰੋਪੇ ॥",
      "transliteration": "satudhravaadh at dhiraR pag rope ||",
      "translation": "",
      "punjabiViakhya": "ਸਤਲੁਜ ਅਤੇ ਬਿਆਸ ਆਦਿ ਦੇ ਰਾਜਿਆਂ ਨੇ ਆਪਣੇ ਪੈਰ ਜਮਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "सतुद्रवादि अति दृड़ पग रोपे ॥",
      "sourceLineId": "113383",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬ੍ਰਯਾਹਾਦ੍ਰੀ ਸਿਗਰੇ ਮਿਲਿ ਕੋਪੇ ॥੪੩॥",
      "transliteration": "brayaahaadhree sigare mil kope ||43||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਮਿਲ ਕੇ ਕ੍ਰੋਧਿਤ ਹੋ ਗਏ ॥੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "ब्रयाहाद्री सिगरे मिलि कोपे ॥४३॥",
      "sourceLineId": "113384",
      "sourceShabadId": "10154",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "113385",
      "sourceShabadId": "10155",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪਰਮ ਸਿੰਘ ਪੂਰੋ ਪੁਰਖ ਕਰਮ ਸਿੰਘ ਸੁਰ ਗ੍ਯਾਨ ॥",
      "transliteration": "param si(n)gh pooro purakh karam si(n)gh sur gayaan ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਮ ਸਿੰਘ ਪੂਰਨ ਪੁਰਸ਼ ਸੀ ਅਤੇ ਕਰਮ ਸਿੰਘ ਦੇਵਤਿਆਂ ਵਾਗ ਗਿਆਨਵਾਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "परम सिंघ पूरो पुरख करम सिंघ सुर ग्यान ॥",
      "sourceLineId": "113386",
      "sourceShabadId": "10155",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਧਰਮ ਸਿੰਘ ਹਾਠੋ ਹਠੀ ਅਮਿਤ ਜੁਧ ਕੀ ਖਾਨ ॥੪੪॥",
      "transliteration": "dharam si(n)gh haaTho haThee amit judh kee khaan ||44||",
      "translation": "",
      "punjabiViakhya": "ਧਰਮ ਸਿੰਘ ਬਹੁਤ ਹਠੀ ਸੀ ਅਤੇ ਅਮਿਤ ਯੁੱਧ ਦੀ ਖਾਣ ਸੀ ॥੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "धरम सिंघ हाठो हठी अमित जुध की खान ॥४४॥",
      "sourceLineId": "113387",
      "sourceShabadId": "10155",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਅਮਰ ਸਿੰਘ ਅਰੁ ਅਚਲ ਸਿੰਘ ਮਨ ਮੈ ਕੋਪ ਬਢਾਇ ॥",
      "transliteration": "amar si(n)gh ar achal si(n)gh man mai kop baddai ||",
      "translation": "",
      "punjabiViakhya": "ਅਮਰ ਸਿੰਘ ਅਤੇ ਅਚਲ ਸਿੰਘ ਮਨ ਵਿਚ ਬਹੁਤ ਕ੍ਰੋਧਿਤ ਹੋਏ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "अमर सिंघ अरु अचल सिंघ मन मै कोप बढाइ ॥",
      "sourceLineId": "113388",
      "sourceShabadId": "10155",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਪਾਚੌ ਭੂਪ ਪਹਾਰਿਯੈ ਸਨਮੁਖਿ ਪਹੁਚੇ ਆਇ ॥੪੫॥",
      "transliteration": "paachau bhoop pahaariyai sanamukh pahuche aai ||45||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਪੰਜੇ ਪਹਾੜੀ ਰਾਜੇ (ਰਾਜ ਕੁਮਾਰੀ ਨਾਲ ਯੁੱਧ ਕਰਨ ਲਈ) ਸਾਹਮਣੇ ਆ ਗਏ ॥੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "पाचौ भूप पहारियै सनमुखि पहुचे आइ ॥४५॥",
      "sourceLineId": "113389",
      "sourceShabadId": "10155",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "113390",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਪਰਬਤੀਸ ਪਾਚੋ ਨ੍ਰਿਪ ਧਾਏ ॥",
      "transliteration": "parabatees paacho nirap dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਪੰਜੇ ਪਹਾੜੀ ਰਾਜੇ (ਯੁੱਧ ਲਈ) ਤੁਰ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "परबतीस पाचो नृप धाए ॥",
      "sourceLineId": "113391",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਖਸੀਯਾ ਅਧਿਕ ਸੰਗ ਲੈ ਆਏ ॥",
      "transliteration": "khaseeyaa adhik sa(n)g lai aae ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਸਾਰੇ ਬਕਰੇ ਨਾਲ ਲੈ ਕੇ ਆਏ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "खसीया अधिक संग लै आए ॥",
      "sourceLineId": "113392",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਪਾਹਨ ਬ੍ਰਿਸਟਿ ਕੋਪ ਕਰਿ ਕਰੀ ॥",
      "transliteration": "paahan birasaT kop kar karee ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਗੁੱਸੇ ਨਾਲ ਪੱਥਰਾ ਦੀ ਬਰਖਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "पाहन बृसटि कोप करि करी ॥",
      "sourceLineId": "113393",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਮਾਰਿ ਮਾਰਿ ਮੁਖ ਤੇ ਉਚਰੀ ॥੪੬॥",
      "transliteration": "maar maar mukh te ucharee ||46||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੂੰਹ ਤੋਂ 'ਮਾਰੋ ਮਾਰੋ' ਦਾ ਉਚਾਰਨ ਕੀਤਾ ॥੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "मारि मारि मुख ते उचरी ॥४६॥",
      "sourceLineId": "113394",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਦੁੰਦਭ ਢੋਲ ਦੁਹੂੰ ਦਿਸਿ ਬਾਜੇ ॥",
      "transliteration": "dhu(n)dhabh ddol dhuhoo(n) dhis baaje ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਪਾਸਿਓਾਂ ਢੋਲ ਅਤੇ ਨਗਾਰੇ ਵਜੇ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "दुँदभ ढोल दुहूँ दिसि बाजे ॥",
      "sourceLineId": "113395",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਸਾਜੇ ਸਸਤ੍ਰ ਸੂਰਮਾ ਗਾਜੇ ॥",
      "transliteration": "saaje sasatr sooramaa gaaje ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਸਤ੍ਰ ਨਾਲ ਸਜੇ ਹੋਏ ਸੂਰਮੇ ਗਜੇ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "साजे ससत्र सूरमा गाजे ॥",
      "sourceLineId": "113396",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਕੁਪਿ ਕੁਪਿ ਅਧਿਕ ਹ੍ਰਿਦਨ ਮੈ ਲਰੇ ॥",
      "transliteration": "kup kup adhik hiradhan mai lare ||",
      "translation": "",
      "punjabiViakhya": "ਹਿਰਦਿਆਂ ਵਿਚ ਬਹੁਤ ਗੁੱਸੇ ਹੋ ਹੋ ਕੇ ਲੜੇ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "कुपि कुपि अधिक हृदन मै लरे ॥",
      "sourceLineId": "113397",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਕਟਿ ਕਟਿ ਮਰੇ ਬਰੰਗਨਿ ਬਰੇ ॥੪੭॥",
      "transliteration": "kaT kaT mare bara(n)gan bare ||47||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਟ ਕਟ ਕੇ ਮਰਦੇ ਹੋਏ ਅਪੱਛਰਾਵਾ ਨੂੰ ਵਰਨ ਲਗੇ ॥੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "कटि कटि मरे बरंगनि बरे ॥४७॥",
      "sourceLineId": "113398",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਭੂਪ ਪਾਚਉ ਬਾਨ ਚਲਾਵੈਂ ॥",
      "transliteration": "bhoop paachau baan chalaavai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਪੰਜੇ ਰਾਜੇ ਬਾਣ ਚਲਾ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "भूप पाचउ बान चलावैं ॥",
      "sourceLineId": "113399",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਬਾਧੇ ਗੋਲ ਸਾਮੁਹੇ ਆਵੈਂ ॥",
      "transliteration": "baadhe gol saamuhe aavai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਗੋਲ ਘੇਰੇ ਬੰਨ੍ਰਹ ਕੇ ਸਾਹਮਣੇ ਆ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "बाधे गोल सामुहे आवैं ॥",
      "sourceLineId": "113400",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਤਬ ਬਚਿਤ੍ਰ ਦੇ ਸਸਤ੍ਰ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "tab bachitr dhe sasatr prahaare ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਬਚਿਤ੍ਰ ਦੇਈ ਨੇ ਸ਼ਸਤ੍ਰਾ ਦਾ ਪ੍ਰਹਾਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "तब बचित्र दे ससत्र प्रहारे ॥",
      "sourceLineId": "113401",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਛਿਨਿਕ ਬਿਖੈ ਸਕਲੇ ਹਨਿ ਡਾਰੇ ॥੪੮॥",
      "transliteration": "chhinik bikhai sakale han ddaare ||48||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਛਿਣ ਭਰ ਵਿਚ ਸਾਰੇ ਮਾਰ ਸੁਟੇ ॥੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "छिनिक बिखै सकले हनि डारे ॥४८॥",
      "sourceLineId": "113402",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਦੇਇ ਬਚਿਤ੍ਰ ਪਾਚ ਨ੍ਰਿਪ ਮਾਰੇ ॥",
      "transliteration": "dhei bachitr paach nirap maare ||",
      "translation": "",
      "punjabiViakhya": "ਬਚਿਤ੍ਰ ਦੇਈ ਨੇ ਪੰਜ ਰਾਜਿਆਂ ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "देइ बचित्र पाच नृप मारे ॥",
      "sourceLineId": "113403",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਔਰ ਸੁਭਟ ਚੁਨਿ ਚੁਨਿ ਹਨਿ ਡਾਰੇ ॥",
      "transliteration": "aauar subhaT chun chun han ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੋਰ ਵੀ ਸੂਰਮੇ ਚੁਣ ਚੁਣ ਕੇ ਸੰਘਾਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "और सुभट चुनि चुनि हनि डारे ॥",
      "sourceLineId": "113404",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਸਾਤ ਨ੍ਰਿਪਤਿ ਅਵਰੈ ਤਬ ਚਲੇ ॥",
      "transliteration": "saat nirapat avarai tab chale ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਸੱਤ ਰਾਜੇ ਹੋਰ ਚਲ ਪਏ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "सात नृपति अवरै तब चले ॥",
      "sourceLineId": "113405",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਜੋਧਾ ਜੋਰ ਜੁਧ ਕਰਿ ਭਲੇ ॥੪੯॥",
      "transliteration": "jodhaa jor judh kar bhale ||49||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਯੁੱਧ ਕਰਨ ਵਿਚ ਬਹੁਤ ਸ਼ਕਤੀਸ਼ਾਲੀ ਸਨ ॥੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "जोधा जोर जुध करि भले ॥४९॥",
      "sourceLineId": "113406",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਕਾਸਿ ਰਾਜ ਮਘਧੇਸ੍ਵਰ ਕੋਪੇ ॥",
      "transliteration": "kaas raaj maghadhesavair kope ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਸ਼ੀ ਅਤੇ ਮਗਧ ਦੇ ਰਾਜੇ ਕ੍ਰੋਧਿਤ ਹੋਏ ਅਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "कासि राज मघधेस्वर कोपे ॥",
      "sourceLineId": "113407",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਅੰਗ ਬੰਗ ਰਾਜਨ ਪਗ ਰੋਪੇ ॥",
      "transliteration": "a(n)g ba(n)g raajan pag rope ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਗ ਤੇ ਬੰਗ (ਬੰਗਾਲ) ਦੇ ਰਾਜਿਆਂ ਨੇ ਪੈਰ ਗਡ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "अंग बंग राजन पग रोपे ॥",
      "sourceLineId": "113408",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਔਰ ਕੁਲਿੰਗ ਦੇਸ ਪਤਿ ਧਾਯੋ ॥",
      "transliteration": "aauar kuli(n)g dhes pat dhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤੋਂ ਇਲਾਵਾ ਕੁਲਿੰਗ ਦੇਸ ਦਾ ਰਾਜਾ ਵੀ ਤੁਰ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "और कुलिंग देस पति धायो ॥",
      "sourceLineId": "113409",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0872_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਤ੍ਰਿਗਤਿ ਦੇਸ ਏਸ੍ਵਰ ਹੂੰ ਆਯੋ ॥੫੦॥",
      "transliteration": "tiragat dhes esavair hoo(n) aayo ||50||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤ੍ਰਿਗਤਿ ਦੇਸ ਦਾ ਰਾਜਾ ਵੀ ਆ ਪਹੁੰਚਿਆ ॥੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": "तृगति देस एस्वर हूँ आयो ॥५०॥",
      "sourceLineId": "113410",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
