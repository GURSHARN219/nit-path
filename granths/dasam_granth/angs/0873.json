{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 873,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0873_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਜਾ ਕਾਮਰੂਪ ਕੋ ਧਾਯੋ ॥",
      "transliteration": "raajaa kaamaroop ko dhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮਰੂਪ ਦਾ ਰਾਜਾ",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "राजा कामरूप को धायो ॥",
      "sourceLineId": "113411",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਮਿਤ ਕਟਕ ਲੀਨੇ ਸੰਗ ਆਯੋ ॥",
      "transliteration": "amit kaTak leene sa(n)g aayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਮਿਤ ਸੈਨਾ ਨਾਲ ਲੈ ਕੇ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "अमित कटक लीने संग आयो ॥",
      "sourceLineId": "113412",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦਾਰੁਣ ਰਣ ਸੂਰਣ ਤਹ ਕਰਿਯੋ ॥",
      "transliteration": "dhaarun ran sooran teh kariyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਸੂਰਮਿਆਂ ਨੇ ਉਥੇ ਭਿਆਨਕ ਯੁੱਧ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "दारुण रण सूरण तह करियो ॥",
      "sourceLineId": "113413",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਵਿ ਸਸਿ ਚਕ੍ਰਯੋ ਇੰਦ੍ਰ ਥਰਹਰਿਯੋ ॥੫੧॥",
      "transliteration": "rav sas chakrayo i(n)dhr tharahariyo ||51||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ) ਸੂਰਜ ਅਤੇ ਚੰਦ੍ਰਮਾ ਹੈਰਾਨ ਹੋ ਗਏ ਅਤੇ ਇੰਦਰ ਕੰਬਣ ਲਗ ਗਿਆ ॥੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "रवि ससि चक्रयो इंद्र थरहरियो ॥५१॥",
      "sourceLineId": "113414",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅੰਗ ਕਟੇ ਤਰਫੈ ਕਹੂੰ ਅੰਗਰੀ ॥",
      "transliteration": "a(n)g kaTe tarafai kahoo(n) a(n)garee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਕਟੇ ਹੋਏ ਅੰਗ ਅਤੇ ਕਿਤੇ ਉਾਂਗਲੀਆਂ ਤੜਪ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "अंग कटे तरफै कहूँ अंगरी ॥",
      "sourceLineId": "113415",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬੀਰ ਪਰੇ ਉਛਰਤ ਕਹੂੰ ਟੰਗਰੀ ॥",
      "transliteration": "beer pare uchharat kahoo(n) Ta(n)garee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸੂਰਮੇ ਪਏ ਹਨ ਅਤੇ ਕਿਤੇ (ਉਨ੍ਰਹਾ ਦੀਆਂ) ਟੰਗਾ ਤੜਪ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "बीर परे उछरत कहूँ टंगरी ॥",
      "sourceLineId": "113416",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਠਿ ਹਠਿ ਭਿਰੇ ਸੁਭਟ ਰਨ ਮਾਹੀ ॥",
      "transliteration": "haTh haTh bhire subhaT ran maahee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸੂਰਮੇ ਹਠ ਪੂਰਵਕ ਯੁੱਧ ਵਿਚ ਲੜ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "हठि हठि भिरे सुभट रन माही ॥",
      "sourceLineId": "113417",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੰਬਕ ਗੀਧ ਮਾਸੁ ਲੈ ਜਾਹੀ ॥੫੨॥",
      "transliteration": "ja(n)bak geedh maas lai jaahee ||52||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਗਿਦੜ ਅਤੇ ਗਿਰਝਾ ਮਾਸ ਲੈ ਕੇ ਜਾ ਰਹੀਆਂ ਹਨ ॥੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "जंबक गीध मासु लै जाही ॥५२॥",
      "sourceLineId": "113418",
      "sourceShabadId": "10156",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "113419",
      "sourceShabadId": "10157",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਾਲ ਸੂਰਮਾ ਮਾਰੇ ਕੋਪ ਬਢਾਇ ਕੈ ॥",
      "transliteration": "baal sooramaa maare kop baddai kai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਸੂਰਮਿਆਂ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "बाल सूरमा मारे कोप बढाइ कै ॥",
      "sourceLineId": "113420",
      "sourceShabadId": "10157",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੋ ਚਿਤੁ ਚਹੈ ਸੰਘਾਰੇ ਰਥਹਿ ਧਵਾਇ ਕੈ ॥",
      "transliteration": "jo chit chahai sa(n)ghaare ratheh dhavai kai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੀ ਮਾਰਨਾ ਚਾਹਿਆ, ਰਥ ਭਜਾ ਕੇ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "जो चितु चहै संघारे रथहि धवाइ कै ॥",
      "sourceLineId": "113421",
      "sourceShabadId": "10157",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪੈਦਲ ਅਮਿਤ ਬਿਦਾਰੇ ਅਤਿ ਚਿਤ ਕੋਪ ਕਰਿ ॥",
      "transliteration": "paidhal amit bidhaare at chit kop kar ||",
      "translation": "",
      "punjabiViakhya": "ਮਨ ਵਿਚ ਬਹੁਤ ਕ੍ਰੋਧ ਕਰ ਕੇ ਅਣਗਿਣਤ ਪੈਦਲ ਮਾਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "पैदल अमित बिदारे अति चित कोप करि ॥",
      "sourceLineId": "113422",
      "sourceShabadId": "10157",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹੋ ਰਥੀ ਗਜੀ ਹਨਿ ਡਾਰੇ ਸਸਤ੍ਰ ਅਨਿਕ ਪ੍ਰਹਰਿ ॥੫੩॥",
      "transliteration": "ho rathee gajee han ddaare sasatr anik prahar ||53||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰਾ ਦੇ ਅਨੇਕ ਪ੍ਰਹਾਰ ਕਰ ਕੇ ਰਥਾ ਅਤੇ ਹਾਥੀਆਂ ਵਾਲਿਆਂ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ॥੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "हो रथी गजी हनि डारे ससत्र अनिक प्रहरि ॥५३॥",
      "sourceLineId": "113423",
      "sourceShabadId": "10157",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "113424",
      "sourceShabadId": "10158",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਪਤਾਵਤ ਨ੍ਰਿਪ ਬਾਲ ਨਿਹਾਰੇ ॥",
      "transliteration": "sapataavat nirap baal nihaare ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਸੱਤਾ ਰਾਜਿਆਂ ਨੂੰ ਆਉਾਂਦਿਆਂ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "सपतावत नृप बाल निहारे ॥",
      "sourceLineId": "113425",
      "sourceShabadId": "10158",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਮਿਤ ਕੋਪ ਕਰਿ ਬਿਸਿਖ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "amit kop kar bisikh prahaare ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਉਨ੍ਰਹਾ ਉਤੇ ਤੀਰ ਚਲਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "अमित कोप करि बिसिख प्रहारे ॥",
      "sourceLineId": "113426",
      "sourceShabadId": "10158",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸ੍ਯੰਦਨ ਸਹਿਤ ਸੂਤ ਸਭ ਘਾਏ ॥",
      "transliteration": "saya(n)dhan sahit soot sabh ghaae ||",
      "translation": "",
      "punjabiViakhya": "ਰਥਾ ਸਮੇਤ ਸਾਰਿਆਂ ਰਥਵਾਨਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "स्यंदन सहित सूत सभ घाए ॥",
      "sourceLineId": "113427",
      "sourceShabadId": "10158",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੈਨ ਸਹਿਤ ਮ੍ਰਿਤ ਲੋਕ ਪਠਾਏ ॥੫੪॥",
      "transliteration": "sain sahit mirat lok paThaae ||54||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੈਨਾ ਸਹਿਤ ਮ੍ਰਿਤੂ-ਲੋਕ ਨੂੰ ਭੇਜ ਦਿੱਤਾ ॥੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "सैन सहित मृत लोक पठाए ॥५४॥",
      "sourceLineId": "113428",
      "sourceShabadId": "10158",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਵਰ ਨ੍ਰਿਪਤ ਤਬ ਹੀ ਉਠਿ ਧਾਏ ॥",
      "transliteration": "avar nirapat tab hee uTh dhaae ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ ਉਪਰੰਤ) ਹੋਰ ਰਾਜੇ ਉਠ ਕੇ ਚਲ ਪਏ",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "अवर नृपत तब ही उठि धाए ॥",
      "sourceLineId": "113429",
      "sourceShabadId": "10158",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਾਧੇ ਗੋਲ ਸਾਮੁਹੇ ਆਏ ॥",
      "transliteration": "baadhe gol saamuhe aae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਝੁੰਡ ਬਣਾ ਕੇ (ਰਾਜ ਕੁਮਰੀ ਦੇ) ਸਾਹਮਣੇ ਆਏ।",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "बाधे गोल सामुहे आए ॥",
      "sourceLineId": "113430",
      "sourceShabadId": "10158",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦਸੌ ਦਿਸਨ ਕ੍ਰੁਧਿਤ ਹ੍ਵੈ ਢੂਕੇ ॥",
      "transliteration": "dhasau dhisan krudhit havai ddooke ||",
      "translation": "",
      "punjabiViakhya": "ਦਸਾ ਦਿਸ਼ਾਵਾ ਤੋਂ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਢੁਕ ਪਏ",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "दसौ दिसन क्रुधित ह्वै ढूके ॥",
      "sourceLineId": "113431",
      "sourceShabadId": "10158",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਾਰੈ ਮਾਰ ਬਕ੍ਰ ਤੇ ਕੂਕੇ ॥੫੫॥",
      "transliteration": "maarai maar bakr te kooke ||55||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੂੰਹ ਤੋਂ 'ਮਾਰੋ ਮਾਰੋ' ਕੂਕਣ ਲਗੇ ॥੫੫॥",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "मारै मार बक्र ते कूके ॥५५॥",
      "sourceLineId": "113432",
      "sourceShabadId": "10158",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "113433",
      "sourceShabadId": "10159",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬੀਰ ਕੇਤੁ ਬਾਕੋ ਰਥੀ ਚਿਤ੍ਰ ਕੇਤੁ ਸੁਰ ਗ੍ਯਾਨ ॥",
      "transliteration": "beer ket baako rathee chitr ket sur gayaan ||",
      "translation": "",
      "punjabiViakhya": "ਬੀਰ ਕੇਤੁ ਰਥ ਵਾਲਾ ਬਾਕਾ ਸੂਰਮਾ ਸੀ ਅਤੇ ਚਿਤ੍ਰ ਕੇਤੁ ਦੇਵਤਿਆਂ ਵਰਗਾ ਸਿਆਣਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "बीर केतु बाको रथी चित्र केतु सुर ग्यान ॥",
      "sourceLineId": "113434",
      "sourceShabadId": "10159",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਛਤ੍ਰ ਕੇਤੁ ਛਤ੍ਰੀ ਅਮਿਟ ਬਿਕਟ ਕੇਤੁ ਬਲਵਾਨ ॥੫੬॥",
      "transliteration": "chhatr ket chhatree amiT bikaT ket balavaan ||56||",
      "translation": "",
      "punjabiViakhya": "ਛਤ੍ਰ ਕੇਤੁ ਬਹਾਦੁਰ ਛਤ੍ਰੀ ਸੀ ਅਤੇ ਬਿਕਟ ਕੇਤੁ ਬਹੁਤ ਬਲਵਾਨ ਸੀ ॥੫੬॥",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "छत्र केतु छत्री अमिट बिकट केतु बलवान ॥५६॥",
      "sourceLineId": "113435",
      "sourceShabadId": "10159",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਇੰਦ੍ਰ ਕੇਤੁ ਉਪਇੰਦ੍ਰ ਧੁਜ ਚਿਤ ਅਤਿ ਕੋਪ ਬਢਾਇ ॥",
      "transliteration": "ei(n)dhr ket upi(n)dhr dhuj chit at kop baddai ||",
      "translation": "",
      "punjabiViakhya": "ਇੰਦ੍ਰ ਕੇਤੁ ਅਤੇ ਉਪਇੰਦ੍ਰ ਧੁਜ ਮਨ ਵਿਚ ਬਹੁਤ ਕ੍ਰੋਧ ਵਧਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "इंद्र केतु उपइंद्र धुज चित अति कोप बढाइ ॥",
      "sourceLineId": "113436",
      "sourceShabadId": "10159",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗੀਧ ਕੇਤੁ ਦਾਨਵ ਸਹਿਤ ਤਹਾ ਪਹੂੰਚੇ ਆਇ ॥੫੭॥",
      "transliteration": "geedh ket dhaanav sahit tahaa pahoo(n)che aai ||57||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਗੀਧ ਕੇਤੁ ਦਾਨਵ ਸਹਿਤ ਉਥੇ ਆ ਪਹੁੰਚੇ ॥੫੭॥",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "गीध केतु दानव सहित तहा पहूँचे आइ ॥५७॥",
      "sourceLineId": "113437",
      "sourceShabadId": "10159",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਪਤ ਨ੍ਰਿਪਤਿ ਆਯੁਧ ਧਰੇ ਅਮਿਤ ਸੈਨ ਲੈ ਸਾਥ ॥",
      "transliteration": "sapat nirapat aayudh dhare amit sain lai saath ||",
      "translation": "",
      "punjabiViakhya": "ਸੱਤੇ ਰਾਜੇ ਸ਼ਸਤ੍ਰ ਧਾਰਨ ਕਰ ਕੇ ਅਤੇ ਅਮਿਤ ਸੈਨਾ ਨਾਲ ਲੈ ਕੇ ਟੁਟ ਕੇ ਪੈ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "सपत नृपति आयुध धरे अमित सैन लै साथ ॥",
      "sourceLineId": "113438",
      "sourceShabadId": "10159",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਧਾਇ ਪਰੇ ਨਾਹਿਨ ਡਰੇ ਕਢੇ ਬਢਾਰੀ ਹਾਥ ॥੫੮॥",
      "transliteration": "dhai pare naahin ddare kadde baddaaree haath ||58||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਿਲਕੁਲ ਨਾ ਡਰੇ। (ਉਨ੍ਰਹਾ ਨੇ) ਹੱਥਾ ਵਿਚ ਤਲਵਾਰਾ ਧਾਰਨ ਕੀਤੀਆਂ ਹੋਈਆਂ ਸਨ ॥੫੮॥",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "धाइ परे नाहिन डरे कढे बढारी हाथ ॥५८॥",
      "sourceLineId": "113439",
      "sourceShabadId": "10159",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "113440",
      "sourceShabadId": "10160",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਸਤ੍ਰ ਸੰਭਾਰਿ ਸੂਰਮਾ ਧਾਏ ॥",
      "transliteration": "sasatr sa(n)bhaar sooramaa dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰਾ ਨੂੰ ਸੰਭਾਲ ਕੇ ਸੂਰਮੇ ਤੁਰ ਪਏ",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "ससत्र संभारि सूरमा धाए ॥",
      "sourceLineId": "113441",
      "sourceShabadId": "10160",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜੋਰੇ ਸੈਨ ਕੁਅਰਿ ਢਿਗ ਆਏ ॥",
      "transliteration": "jore sain kuar ddig aae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੈਨਾ ਸਜਾ ਕੇ ਰਾਜ ਕੁਮਾਰੀ ਦੇ ਕੋਲ ਆ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "जोरे सैन कुअरि ढिग आए ॥",
      "sourceLineId": "113442",
      "sourceShabadId": "10160",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਆਯੁਧ ਹਾਥ ਬਚਿਤ੍ਰ ਧਰੇ ॥",
      "transliteration": "aayudh haath bachitr dhare ||",
      "translation": "",
      "punjabiViakhya": "ਬਚਿਤ੍ਰ ਦੇਈ ਨੇ ਹੱਥ ਵਿਚ ਸ਼ਸਤ੍ਰ ਲੈ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "आयुध हाथ बचित्र धरे ॥",
      "sourceLineId": "113443",
      "sourceShabadId": "10160",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਮਿਤ ਸੁਭਟ ਪ੍ਰਾਨਨ ਬਿਨੁ ਕਰੇ ॥੫੯॥",
      "transliteration": "amit subhaT praanan bin kare ||59||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬੇਹਿਸਾਬ ਸੂਰਮਿਆਂ ਨੂੰ ਪ੍ਰਾਣਾ ਤੋਂ ਬਿਨਾ ਕਰ ਦਿੱਤਾ ॥੫੯॥",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "अमित सुभट प्रानन बिनु करे ॥५९॥",
      "sourceLineId": "113444",
      "sourceShabadId": "10160",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬੀਰ ਕੇਤੁ ਕੋ ਮੂੰਡ ਉਤਾਰਿਯੋ ॥",
      "transliteration": "beer ket ko moo(n)dd utaariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜ ਕੁਮਾਰੀ ਨੇ) ਬੀਰ ਕੇਤੁ ਦਾ ਸਿਰ ਕਟ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "बीर केतु को मूँड उतारियो ॥",
      "sourceLineId": "113445",
      "sourceShabadId": "10160",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚਿਤ੍ਰ ਕੇਤੁ ਕਟਿ ਤੇ ਕਟ ਡਾਰਿਯੋ ॥",
      "transliteration": "chitr ket kaT te kaT ddaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਿਤ੍ਰ ਕੇਤੁ ਨੂੰ ਲਕ ਤੋਂ ਵਢ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "चित्र केतु कटि ते कट डारियो ॥",
      "sourceLineId": "113446",
      "sourceShabadId": "10160",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਛਤ੍ਰ ਕੇਤੁ ਛਤ੍ਰੀ ਪੁਨਿ ਘਾਯੋ ॥",
      "transliteration": "chhatr ket chhatree pun ghaayo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਛਤ੍ਰ ਕੇਤੁ ਛਤ੍ਰੀ ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "छत्र केतु छत्री पुनि घायो ॥",
      "sourceLineId": "113447",
      "sourceShabadId": "10160",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਿਕਟ ਕੇਤੁ ਮ੍ਰਿਤ ਲੋਕ ਪਠਾਯੋ ॥੬੦॥",
      "transliteration": "bikaT ket mirat lok paThaayo ||60||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਿਕਟ ਕੇਤੁ ਨੂੰ ਮ੍ਰਿਤੂ-ਲੋਕ ਵਲ ਭੇਜ ਦਿੱਤਾ ॥੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "बिकट केतु मृत लोक पठायो ॥६०॥",
      "sourceLineId": "113448",
      "sourceShabadId": "10160",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "113449",
      "sourceShabadId": "10161",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਇੰਦ੍ਰ ਕੇਤੁ ਉਪਇੰਦ੍ਰ ਧੁਜ ਦੋਨੋ ਹਨੇ ਰਿਸਾਇ ॥",
      "transliteration": "ei(n)dhr ket upi(n)dhr dhuj dhono hane risai ||",
      "translation": "",
      "punjabiViakhya": "ਇੰਦ੍ਰ ਕੇਤੁ ਅਤੇ ਉਪਇੰਦ੍ਰ ਧੁਜ ਦੋਹਾ ਨੂੰ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "इंद्र केतु उपइंद्र धुज दोनो हने रिसाइ ॥",
      "sourceLineId": "113450",
      "sourceShabadId": "10161",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗੀਧ ਕੇਤੁ ਦਾਨਵ ਦਿਯੈ ਜਮਪੁਰਿ ਬਹੁਰਿ ਪਠਾਇ ॥੬੧॥",
      "transliteration": "geedh ket dhaanav dhiyai jamapur bahur paThai ||61||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਗੀਧ ਕੇਤੁ ਦਾਨਵ ਨੂੰ ਯਮ ਲੋਕ ਭੇਜ ਦਿੱਤਾ ॥੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "गीध केतु दानव दियै जमपुरि बहुरि पठाइ ॥६१॥",
      "sourceLineId": "113451",
      "sourceShabadId": "10161",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੈਨਾ ਸਤਹੂੰ ਨ੍ਰਿਪਨ ਕੀ ਕੋਪਿ ਭਰੀ ਅਰਰਾਇ ॥",
      "transliteration": "sainaa satahoo(n) nirapan kee kop bharee ararai ||",
      "translation": "",
      "punjabiViakhya": "ਸੱਤਾ ਰਾਜਿਆਂ ਦੀ ਸੈਨਾ ਕ੍ਰੋਧ ਨਾਲ ਭਰ ਕੇ ਅਰੜਾ ਕੇ ਪੈ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "सैना सतहूँ नृपन की कोपि भरी अरराइ ॥",
      "sourceLineId": "113452",
      "sourceShabadId": "10161",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤੇ ਬਾਲਾ ਤਬ ਹੀ ਦਏ ਮ੍ਰਿਤੁ ਕੇ ਲੋਕ ਪਠਾਇ ॥੬੨॥",
      "transliteration": "te baalaa tab hee dhe mrit ke lok paThai ||62||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਤਦ ਸਭ ਨੂੰ ਮ੍ਰਿਤੂ ਲੋਕ ਭੇਜ ਦਿੱਤਾ ॥੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "ते बाला तब ही दए मृतु के लोक पठाइ ॥६२॥",
      "sourceLineId": "113453",
      "sourceShabadId": "10161",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੁਮਤ ਕੇਤੁ ਸੂਰਾ ਬਡੋ ਸਮਰ ਸਿੰਘ ਲੈ ਸੰਗ ॥",
      "transliteration": "sumat ket sooraa baddo samar si(n)gh lai sa(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਮਤ ਕੇਤੁ ਇਕ ਵੱਡਾ ਸੂਰਮਾ ਸੀ। ਉਸ ਨੇ ਸਮਰ ਸਿੰਘ ਨੂੰ ਨਾਲ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "सुमत केतु सूरा बडो समर सिंघ लै संग ॥",
      "sourceLineId": "113454",
      "sourceShabadId": "10161",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬ੍ਰਹਮ ਕੇਤੁ ਲੈ ਦਲ ਚਲਾ ਉਮਡਿ ਚਲੀ ਜਨੁ ਗੰਗ ॥੬੩॥",
      "transliteration": "braham ket lai dhal chalaa umadd chalee jan ga(n)g ||63||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬ੍ਰਹਮ ਕੇਤੁ ਵੀ ਆਪਣਾ ਦਲ ਲੈ ਕੇ ਇੰਜ ਚਲੇ ਮਾਨੋ ਗੰਗਾ ਉਮਡ ਪਈ ਹੋਵੇ ॥੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "ब्रहम केतु लै दल चला उमडि चली जनु गंग ॥६३॥",
      "sourceLineId": "113455",
      "sourceShabadId": "10161",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਾਲ ਕੇਤੁ ਖਟਬਕ੍ਰ ਧੁਜ ਜੋਧਾ ਹੁਤੇ ਬਿਸੇਖ ॥",
      "transliteration": "taal ket khaTabakr dhuj jodhaa hute bisekh ||",
      "translation": "",
      "punjabiViakhya": "ਤਾਲ ਕੇਤੁ ਅਤੇ ਖਟਬਕ੍ਰ ਧੁਜ (ਦੋ) ਵਿਸ਼ੇਸ਼ ਯੋਧੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": "ताल केतु खटबक्र धुज जोधा हुते बिसेख ॥",
      "sourceLineId": "113456",
      "sourceShabadId": "10161",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0873_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੋ ਯਾ ਪਰ ਆਵਤ ਭਏ ਕਿਯੈ ਕਾਲ ਕੋ ਭੇਖ ॥੬੪॥",
      "transliteration": "so yaa par aavat bhe kiyai kaal ko bhekh ||64||",
      "translation": "",
