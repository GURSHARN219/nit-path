{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 874,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0874_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦਾਨਵ ਗੀਧ ਕੇਤੁ ਕੋ ਭ੍ਰਾਤਾ ॥",
      "transliteration": "dhaanav geedh ket ko bhraataa ||",
      "translation": "",
      "punjabiViakhya": "ਗੀਧ ਕੇਤੁ ਦਾਨਵ ਦਾ ਭਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "दानव गीध केतु को भ्राता ॥",
      "sourceLineId": "113459",
      "sourceShabadId": "10162",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਾਕ ਕੇਤੁ ਤਿਹੂੰ ਲੋਕ ਬਿਖ੍ਯਾਤਾ ॥",
      "transliteration": "kaak ket tihoo(n) lok bikhayaataa ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਕ ਕੇਤੁ ਤਿੰਨਾ ਲੋਕਾ ਵਿਚ ਪ੍ਰਸਿੱਧ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "काक केतु तिहूँ लोक बिख्याता ॥",
      "sourceLineId": "113460",
      "sourceShabadId": "10162",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕ੍ਰੂਰ ਕੇਤੁ ਦਾਨਵ ਇਕ ਧਾਯੋ ॥",
      "transliteration": "kraoor ket dhaanav ik dhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਕ੍ਰੂਰ ਕੇਤੁ ਨਾ ਦਾ ਦਾਨਵ ਆਪਣੇ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "क्रूर केतु दानव इक धायो ॥",
      "sourceLineId": "113461",
      "sourceShabadId": "10162",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਲੀਨੇ ਅਮਿਤ ਦੈਤ ਦਲ ਆਯੋ ॥੬੫॥",
      "transliteration": "leene amit dhait dhal aayo ||65||",
      "translation": "",
      "punjabiViakhya": "ਬੇਹਿਸਾਬ ਦਲ ਲੈ ਕੇ ਆਗਿਆ ॥੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "लीने अमित दैत दल आयो ॥६५॥",
      "sourceLineId": "113462",
      "sourceShabadId": "10162",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਵੈਯਾ ॥",
      "transliteration": "savaiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੈਯਾ:",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "सवैया ॥",
      "sourceLineId": "113463",
      "sourceShabadId": "10163",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਾਕ ਧੁਜਾ ਕਰਿ ਕੋਪ ਤਹੀ ਛਿਨ ਆਨਿ ਪਰਿਯੋ ਕਰਵਾਰ ਨਿਕਾਰੇ ॥",
      "transliteration": "kaak dhujaa kar kop tahee chhin aan pariyo karavaar nikaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਕ ਧੁਜ ਕ੍ਰੋਧ ਕਰ ਕੇ ਉਸੇ ਵੇਲੇ ਤਲਵਾਰ ਖਿਚ ਕੇ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "काक धुजा करि कोप तही छिन आनि परियो करवार निकारे ॥",
      "sourceLineId": "113464",
      "sourceShabadId": "10163",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਿੰਘ ਸਲਾ ਸਰਦੂਲ ਸਿਲੀਮੁਖ ਸਾਲ ਤਮਾਲ ਹਨੇ ਅਹਿ ਕਾਰੇ ॥",
      "transliteration": "si(n)gh salaa saradhool sileemukh saal tamaal hane eh kaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸ਼ੇਰ, ਸ਼ਿਲਾ, ਸ਼ਾਰਦੂਲ, ਤੀਰ ਵਰਗੇ ਮੂੰਹ ਵਾਲਾ, ਸਾਲ ਅਤੇ ਤਮਾਲ ਵਰਗੇ ਅਤੇ ਕਾਲੇ ਸੱਪ ਵਰਗੇ ਮਾਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "सिंघ सला सरदूल सिलीमुख साल तमाल हने अहि कारे ॥",
      "sourceLineId": "113465",
      "sourceShabadId": "10163",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸ੍ਵਾਨ ਸ੍ਰਿੰਗਾਲ ਸੁਰਾਤਕ ਸੀਸ ਧੁਜਾ ਰਥ ਨਾਗ ਧਰਾਧਰ ਭਾਰੇ ॥",
      "transliteration": "savaiaan sira(n)gaal suraatak sees dhujaa rath naag dharaadhar bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਕੁੱਤੇ, ਗਿਦੜ, ਦੈਂਤ ('ਸੁਰਾਤਕ') ਸਿਰ, ਧੁਜਾ, ਰਥ, ਨਾਗ ਅਤੇ ਵੱਡੇ ਭਾਰੇ ਪਹਾੜ।",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "स्वान सृंगाल सुरातक सीस धुजा रथ नाग धराधर भारे ॥",
      "sourceLineId": "113466",
      "sourceShabadId": "10163",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਯੌ ਬਰਖੇ ਨਭ ਤੇ ਹਰਖੇ ਰਿਪੁ ਆਨਿ ਦਸੋ ਦਿਸਿ ਤੇ ਭਭਕਾਰੇ ॥੬੬॥",
      "transliteration": "yau barakhe nabh te harakhe rip aan dhaso dhis te bhabhakaare ||66||",
      "translation": "",
      "punjabiViakhya": "ਆਕਾਸ਼ ਤੋਂ ਵਰ੍ਰਹ ਰਹੇ ਸਨ ਅਤੇ ਵੈਰੀ ਖੁਸ਼ ਹੋ ਕੇ ਕਿਲਕਾਰੀਆਂ ਮਾਰਦੇ ਹੋਏ ਚੌਹਾ ਦਿਸ਼ਾਵਾ ਤੋਂ ਆ ਗਏ ਸਨ ॥੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "यौ बरखे नभ ते हरखे रिपु आनि दसो दिसि ते भभकारे ॥६६॥",
      "sourceLineId": "113467",
      "sourceShabadId": "10163",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "113468",
      "sourceShabadId": "10164",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਾਯਾ ਦੈਤ ਪਸਾਰਿ ਕੈ ਪੁਨਿ ਬੋਲਾ ਇਮਿ ਬੈਨ ॥",
      "transliteration": "maayaa dhait pasaar kai pun bolaa im bain ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤ ਮਾਯਾਵੀ ਸ਼ਕਤੀ ਦਾ ਪ੍ਰਸਾਰ ਕਰ ਕੇ ਫਿਰ ਇਸ ਤਰ੍ਰਹਾ ਬੋਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "माया दैत पसारि कै पुनि बोला इमि बैन ॥",
      "sourceLineId": "113469",
      "sourceShabadId": "10164",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੁਧੁ ਸੁਯੰਬਰ ਜੀਤਿ ਤੁਹਿ ਲੈ ਜੈਹੌ ਨਿਜੁ ਐਨ ॥੬੭॥",
      "transliteration": "judh suya(n)bar jeet tuh lai jaihau nij aain ||67||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਯੁੱਧ ਦੇ ਸੁਅੰਬਰ ਵਿਚ ਜਿੱਤ ਕੇ (ਮੈਂ) ਤੈਨੂੰ ਆਪਣੇ ਘਰ ਲੈ ਜਾਵਾਗਾ ॥੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "जुधु सुयंबर जीति तुहि लै जैहौ निजु ऐन ॥६७॥",
      "sourceLineId": "113470",
      "sourceShabadId": "10164",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਵੈਯਾ ॥",
      "transliteration": "savaiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੈਯਾ:",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "सवैया ॥",
      "sourceLineId": "113471",
      "sourceShabadId": "10165",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਕਰਿ ਕੋਪ ਤਿਹੀ ਛਿਨ ਸਾਮੁਹਿ ਹ੍ਵੈ ਹਥਿਯਾਰ ਗਹੇ ॥",
      "transliteration": "raaj sutaa kar kop tihee chhin saamuh havai hathiyaar gahe ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਹੱਥ ਵਿਚ ਹਥਿਆਰ ਪਕੜ ਕੇ ਉਸੇ ਵੇਲੇ ਸਾਹਮਣੇ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "राज सुता करि कोप तिही छिन सामुहि ह्वै हथियार गहे ॥",
      "sourceLineId": "113472",
      "sourceShabadId": "10165",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਲਵਾਨ ਕਮਾਨ ਕੋ ਤਾਨਿ ਹਨੇ ਕਬਿ ਰਾਮ ਭਨੈ ਚਿਤ ਮੈ ਜੁ ਚਹੇ ॥",
      "transliteration": "balavaan kamaan ko taan hane kab raam bhanai chit mai ju chahe ||",
      "translation": "",
      "punjabiViakhya": "ਕਵੀ ਰਾਮ ਕਹਿੰਦੇ ਹਨ ਕਿ (ਰਾਜ ਕੁਮਾਰੀ ਨੇ) ਮਜ਼ਬੂਤ ਕਮਾਨ ਖਿਚ ਕੇ ਜਿਸ ਨੂੰ ਚਾਹਿਆ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "बलवान कमान को तानि हने कबि राम भनै चित मै जु चहे ॥",
      "sourceLineId": "113473",
      "sourceShabadId": "10165",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਰ ਸੂਰ ਦਇੰਤਨ ਕੇ ਤਨ ਮੈ ਇਹ ਭਾਤਿ ਲਗੇ ਨਹਿ ਜਾਤ ਕਹੇ ॥",
      "transliteration": "sar soor dhi(n)tan ke tan mai ieh bhaat lage neh jaat kahe ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਅਤੇ ਦੈਂਤਾ ਦੇ ਤਨ ਵਿਚ ਤੀਰ ਇਸ ਤਰ੍ਰਹਾ ਲਗੇ, ਜਿਨ੍ਰਹਾ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "सर सूर दइंतन के तन मै इह भाति लगे नहि जात कहे ॥",
      "sourceLineId": "113474",
      "sourceShabadId": "10165",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਨੋ ਇੰਦ੍ਰ ਕੇ ਬਾਗ ਅਸੋਕ ਬਿਖੈ ਫੁਲਵਾਰਿਨ ਕੇ ਫਲ ਫੂਲ ਰਹੇ ॥੬੮॥",
      "transliteration": "mano i(n)dhr ke baag asok bikhai fulavaarin ke fal fool rahe ||68||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ) ਮਾਨੋ ਇੰਦਰ ਦੇ ਅਸ਼ੋਕ ਬਾਗ਼ ਦੀਆਂ ਫੁਲਵਾੜੀਆਂ ਵਿਚ ਫੁਲ ਅਤੇ ਫਲ ਲਗੇ ਹੋਣ ॥੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "मनो इंद्र के बाग असोक बिखै फुलवारिन के फल फूल रहे ॥६८॥",
      "sourceLineId": "113475",
      "sourceShabadId": "10165",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਾਢਿ ਕ੍ਰਿਪਾਨ ਮਹਾ ਕੁਪਿ ਕੈ ਭਟ ਕੂਦਿ ਪਰੇ ਸਰਦਾਰ ਕਰੋਰੇ ॥",
      "transliteration": "kaadd kirapaan mahaa kup kai bhaT koodh pare saradhaar karore ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਨਾ ਕਢ ਕੇ ਅਤੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਕ੍ਰੋੜਾ ਸੈਨਿਕਾ ਦੇ ਸਰਦਾਰ ਯੁੱਧ ਵਿਚ ਕੁਦ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "काढि कृपान महा कुपि कै भट कूदि परे सरदार करोरे ॥",
      "sourceLineId": "113476",
      "sourceShabadId": "10165",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਾਲ ਹਨੇ ਬਲਵਾਨ ਘਨੇ ਇਕ ਫਾਸਿਨ ਸੌ ਗਹਿ ਕੈ ਝਕਝੋਰੇ ॥",
      "transliteration": "baal hane balavaan ghane ik faasin sau geh kai jhakajhore ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਇਕ ਫਾਸ ਨਾਲ ਬਹੁਤ ਸਾਰੇ ਬਲਵਾਨ ਸੂਰਮੇ ਪਕੜ ਕੇ ਝੰਝੋੜ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "बाल हने बलवान घने इक फासिन सौ गहि कै झकझोरे ॥",
      "sourceLineId": "113477",
      "sourceShabadId": "10165",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਾਜ ਪਰੇ ਕਹੂੰ ਤਾਜ ਗਿਰੇ ਗਜਰਾਜ ਗਿਰੇ ਛਿਤ ਪੈ ਸਿਰ ਤੋਰੇ ॥",
      "transliteration": "saaj pare kahoo(n) taaj gire gajaraaj gire chhit pai sir tore ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸਾਜ ਪਏ ਹਨ, ਕਿਤੇ ਤਾਜ ਡਿਗੇ ਪਏ ਹਨ, ਕਿਤੇ ਹਾਥੀ ਧਰਤੀ ਉਤੇ ਡਿਗੇ ਹੋਏ ਸਿਰ ਛਟਪਟਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "साज परे कहूँ ताज गिरे गजराज गिरे छित पै सिर तोरे ॥",
      "sourceLineId": "113478",
      "sourceShabadId": "10165",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਲੁਟੇ ਰਥੀ ਰਥ ਫੂਟੇ ਕਹੂੰ ਬਿਨੁ ਸ੍ਵਾਰ ਫਿਰੈ ਹਿਨਨਾਵਤ ਘੋਰੇ ॥੬੯॥",
      "transliteration": "luTe rathee rath fooTe kahoo(n) bin savaiaar firai hinanaavat ghore ||69||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਰਥਾ ਵਾਲੇ ਲੁੜ੍ਰਹਕੇ ਪਏ ਹਨ, ਕਿਤੇ ਰਥ ਟੁੱਟੇ ਪਏ ਹਨ ਅਤੇ ਕਿਤੇ ਬਿਨਾ ਸਵਾਰਾ ਦੇ ਘੋੜੇ ਹਿਣਕਦੇ ਫਿਰਦੇ ਹਨ ॥੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "लुटे रथी रथ फूटे कहूँ बिनु स्वार फिरै हिननावत घोरे ॥६९॥",
      "sourceLineId": "113479",
      "sourceShabadId": "10165",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "113480",
      "sourceShabadId": "10166",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜੇ ਭਟ ਅਮਿਤ ਕੋਪ ਕਰਿ ਧਾਏ ॥",
      "transliteration": "je bhaT amit kop kar dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਤਨੇ ਵੀ ਸੂਰਮੇ ਬਹੁਤ ਅਧਿਕ ਕ੍ਰੋਧ ਕਰ ਕੇ ਆਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "जे भट अमित कोप करि धाए ॥",
      "sourceLineId": "113481",
      "sourceShabadId": "10166",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤੇ ਬਿਨੁ ਤਨ ਹ੍ਵੈ ਸੁਰਗ ਸਿਧਾਏ ॥",
      "transliteration": "te bin tan havai surag sidhaae ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸਾਰੇ ਤਨ-ਹੀਨ ਹੋ ਕੇ ਸਵਰਗ ਨੂੰ ਸਿਧਾਰ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "ते बिनु तन ह्वै सुरग सिधाए ॥",
      "sourceLineId": "113482",
      "sourceShabadId": "10166",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚਟਪਟ ਬਿਕਟ ਪਲਟਿ ਜੇ ਲਰੇ ॥",
      "transliteration": "chaTapaT bikaT palaT je lare ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਕੜੀਅਲ ਯੋਧੇ ਜਲਦੀ ਨਾਲ ਪਲਟ ਕੇ ਲੜੇ,",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "चटपट बिकट पलटि जे लरे ॥",
      "sourceLineId": "113483",
      "sourceShabadId": "10166",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਟਿ ਕਟਿ ਮਰੇ ਬਰੰਗਨਿਨ ਬਰੇ ॥੭੦॥",
      "transliteration": "kaT kaT mare bara(n)ganin bare ||70||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਕਟ ਕਟ ਕੇ ਮਾਰੇ ਗਏ ਅਤੇ ਅਪੱਛਰਾਵਾ ਨੇ ਵਰ ਲਏ ॥੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "कटि कटि मरे बरंगनिन बरे ॥७०॥",
      "sourceLineId": "113484",
      "sourceShabadId": "10166",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੇ ਭਟ ਬਿਮੁਖਾਹਵ ਹ੍ਵੈ ਮੂਏ ॥",
      "transliteration": "je bhaT bimukhaahav havai mooe ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਯੋਧੇ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਬੇਮੁਖ ਹੋ ਕੇ ਮਰ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "जे भट बिमुखाहव ह्वै मूए ॥",
      "sourceLineId": "113485",
      "sourceShabadId": "10166",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਤ ਕੇ ਭਏ ਨ ਉਤ ਕੇ ਹੂਏ ॥",
      "transliteration": "eit ke bhe na ut ke hooe ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਨਾ ਇਥੋਂ ਦੇ ਰਹੇ ਅਤੇ ਨਾ ਹੀ ਉਥੋਂ (ਪਰਲੋਕ) ਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "इत के भए न उत के हूए ॥",
      "sourceLineId": "113486",
      "sourceShabadId": "10166",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗਰਜਿ ਪ੍ਰਾਨ ਬੀਰਨ ਜਿਨ ਦਏ ॥",
      "transliteration": "garaj praan beeran jin dhe ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੇ ਗਜ ਵਜ ਕੇ ਸੂਰਮਿਆਂ ਵਾਗ ਪ੍ਰਾਣ ਦੇ ਦਿੱਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "गरजि प्रान बीरन जिन दए ॥",
      "sourceLineId": "113487",
      "sourceShabadId": "10166",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦੈ ਦੁੰਦਭੀ ਸ੍ਵਰਗ ਜਨੁ ਗਏ ॥੭੧॥",
      "transliteration": "dhai dhu(n)dhabhee savairag jan ge ||71||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮਾਨੋ ਧੌਂਸੇ ਵਜਾ ਕੇ ਸਵਰਗ ਨੂੰ ਚਲੇ ਗਏ ॥੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "दै दुँदभी स्वरग जनु गए ॥७१॥",
      "sourceLineId": "113488",
      "sourceShabadId": "10166",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "113489",
      "sourceShabadId": "10167",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਿਨ ਇਸਤ੍ਰਿਨ ਜਰਿ ਅਗਨਿ ਮੈ ਪ੍ਰਾਨ ਆਪਨੇ ਦੀਨ ॥",
      "transliteration": "jin isatiran jar agan mai praan aapane dheen ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਇਸਤਰੀਆਂ ਨੇ ਅੱਗ ਵਿਚ ਸੜ ਕੇ (ਅਰਥਾਤ ਸਤੀ ਹੋ ਕੇ) ਆਪਣੇ ਪ੍ਰਾਣ ਦਿੱਤੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "जिन इसतृन जरि अगनि मै प्रान आपने दीन ॥",
      "sourceLineId": "113490",
      "sourceShabadId": "10167",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਝਗਰਿ ਬਰੰਗਨਿਨ ਤੇ ਤਹਾ ਛੀਨਿ ਪਤਿਨ ਕਹ ਲੀਨ ॥੭੨॥",
      "transliteration": "jhagar bara(n)ganin te tahaa chheen patin keh leen ||72||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਉਥੇ ਅਪੱਛਰਾਵਾ ਨਾਲ ਝਗੜ ਕੇ ਆਪਣੇ ਪਤੀ ਖੋਹ ਲਏ ਹਨ ॥੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "झगरि बरंगनिन ते तहा छीनि पतिन कह लीन ॥७२॥",
      "sourceLineId": "113491",
      "sourceShabadId": "10167",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "113492",
      "sourceShabadId": "10168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਐਸੇ ਬਾਲ ਬੀਰ ਬਹੁ ਮਾਰੇ ॥",
      "transliteration": "aaise baal beer bahu maare ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ (ਉਸ) ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਬਹੁਤ ਸਾਰੇ ਸੂਰਮੇ ਮਾਰ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "ऐसे बाल बीर बहु मारे ॥",
      "sourceLineId": "113493",
      "sourceShabadId": "10168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੁਮਤਿ ਸਿੰਘ ਆਦਿਕ ਹਨਿ ਡਾਰੇ ॥",
      "transliteration": "sumat si(n)gh aadhik han ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੁਮਤਿ ਸਿੰਘ ਆਦਿਕ ਵੀ ਮਾਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "सुमति सिंघ आदिक हनि डारे ॥",
      "sourceLineId": "113494",
      "sourceShabadId": "10168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਮਰ ਸੈਨ ਰਾਜਾ ਪੁਨਿ ਹਯੋ ॥",
      "transliteration": "samar sain raajaa pun hayo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਸਮਰ ਸੈਨ ਰਾਜੇ ਨੂੰ ਮਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "समर सैन राजा पुनि हयो ॥",
      "sourceLineId": "113495",
      "sourceShabadId": "10168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਾਲ ਕੇਤੁ ਮ੍ਰਿਤ ਲੋਕ ਪਠਯੋ ॥੭੩॥",
      "transliteration": "taal ket mirat lok paThayo ||73||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤਾਲ ਕੇਤੁ ਨੂੰ ਮ੍ਰਿਤੂ-ਲੋਕ ਵਿਚ ਭੇਜਿਆ ॥੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "ताल केतु मृत लोक पठयो ॥७३॥",
      "sourceLineId": "113496",
      "sourceShabadId": "10168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬ੍ਰਹਮ ਕੇਤੁ ਕਹ ਪੁਨਿ ਹਨਿ ਦੀਨੋ ॥",
      "transliteration": "braham ket keh pun han dheeno ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ (ਉਸ ਨੇ) ਬ੍ਰਹਮ ਕੇਤੁ ਦੇ ਪ੍ਰਾਣ ਹਰ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "ब्रहम केतु कह पुनि हनि दीनो ॥",
      "sourceLineId": "113497",
      "sourceShabadId": "10168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਾਰਤਿਕੇਯ ਧੁਜ ਕੋ ਬਧ ਕੀਨੋ ॥",
      "transliteration": "kaaratikey dhuj ko badh keeno ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਾਰਤਿਕੇਯ ਧੁਜ ਦਾ ਬਧ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "कारतिकेय धुज को बध कीनो ॥",
      "sourceLineId": "113498",
      "sourceShabadId": "10168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕ੍ਰੂਰ ਕੇਤੁ ਦਾਨਵ ਤਬ ਧਾਯੋ ॥",
      "transliteration": "kraoor ket dhaanav tab dhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕ੍ਰੂਰ ਕੇਤੁ ਦੈਂਤ ਆ ਪਹੁੰਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "क्रूर केतु दानव तब धायो ॥",
      "sourceLineId": "113499",
      "sourceShabadId": "10168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤੁਮਲ ਜੁਧ ਤਿਹ ਠੌਰ ਮਚਾਯੋ ॥੭੪॥",
      "transliteration": "tumal judh teh Thauar machaayo ||74||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਥਾ ਤੇ ਘਮਸਾਨ ਯੁੱਧ ਮਚਾ ਦਿੱਤਾ ॥੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "तुमल जुध तिह ठौर मचायो ॥७४॥",
      "sourceLineId": "113500",
      "sourceShabadId": "10168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕੌਲ ਕੇਤੁ ਦਾਨਵ ਉਠਿ ਧਾਯੋ ॥",
      "transliteration": "kaual ket dhaanav uTh dhaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਕੌਲ ਕੇਤੁ ਦੈਂਤ ਉਠ ਕੇ ਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "कौल केतु दानव उठि धायो ॥",
      "sourceLineId": "113501",
      "sourceShabadId": "10168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਮਠ ਕੇਤੁ ਚਿਤ ਅਧਿਕ ਰਿਸਾਯੋ ॥",
      "transliteration": "kamaTh ket chit adhik risaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਮਠ ਕੇਤੁ (ਆਪਣੇ) ਮਨ ਵਿਚ ਬਹੁਤ ਕ੍ਰੋਧਵਾਨ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": "कमठ केतु चित अधिक रिसायो ॥",
      "sourceLineId": "113502",
      "sourceShabadId": "10168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0874_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕੇਤੁ ਉਲੂਕ ਚਲਾ ਦਲ ਲੈ ਕੈ ॥",
      "transliteration": "ket ulook chalaa dhal lai kai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਲੂਕ ਕੇਤੁ ਦਲ ਲੈ ਕੇ ਚਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 874,
