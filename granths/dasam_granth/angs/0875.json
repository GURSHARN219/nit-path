{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 875,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0875_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਛਪ ਕੇਤੁ ਗਦਾ ਗਹਿ ਘਾਯੋ ॥",
      "transliteration": "kachhap ket gadhaa geh ghaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਕਛਪ ਕੇਤੁ ਗਦਾ ਲੈ ਕੇ ਮਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "कछप केतु गदा गहि घायो ॥",
      "sourceLineId": "113507",
      "sourceShabadId": "10168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕੇਤੁ ਲੂਕ ਮ੍ਰਿਤ ਲੋਕ ਪਠਾਯੋ ॥੭੬॥",
      "transliteration": "ket look mirat lok paThaayo ||76||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲੂਕ ਕੇਤੁ ਨੂੰ ਮ੍ਰਿਤੂ-ਲੋਕ ਵਲ ਭੇਜ ਦਿੱਤਾ ॥੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "केतु लूक मृत लोक पठायो ॥७६॥",
      "sourceLineId": "113508",
      "sourceShabadId": "10168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਾ ਤਨ ਬਾਲ ਗਦਾ ਕੀ ਮਾਰੈ ॥",
      "transliteration": "jaa tan baal gadhaa kee maarai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਸ਼ਰੀਰ ਉਤੇ ਰਾਜ ਕੁਮਾਰੀ ਗਦਾ ਦਾ ਵਾਰ ਕਰਦੀ,",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "जा तन बाल गदा की मारै ॥",
      "sourceLineId": "113509",
      "sourceShabadId": "10168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਏਕੈ ਘਾਇ ਚੌਥਿ ਸਿਰ ਡਾਰੈ ॥",
      "transliteration": "ekai ghai chauath sir ddaarai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕੋ ਸਟ ਨਾਲ (ਉਸ ਦਾ) ਸਿਰ ਫੇਹ ਦਿੰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "एकै घाइ चौथि सिर डारै ॥",
      "sourceLineId": "113510",
      "sourceShabadId": "10168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਾ ਕੇਤਕਿ ਮਾਰ ਤਨ ਬਾਨਾ ॥",
      "transliteration": "jaa ketak maar tan baanaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਹੀ ਸੂਰਮਿਆਂ ਦੇ ਸ਼ਰੀਰਾ ਵਿਚ ਤੀਰ ਮਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "जा केतकि मार तन बाना ॥",
      "sourceLineId": "113511",
      "sourceShabadId": "10168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਰੈ ਬੀਰ ਜਮਪੁਰੀ ਪਯਾਨਾ ॥੭੭॥",
      "transliteration": "karai beer jamapuree payaanaa ||77||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਜਮਪੁਰੀ ਭੇਜ ਦਿੱਤਾ ॥੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "करै बीर जमपुरी पयाना ॥७७॥",
      "sourceLineId": "113512",
      "sourceShabadId": "10168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "113513",
      "sourceShabadId": "10169",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਾ ਕੋ ਜੁਧੁ ਬਿਲੋਕਿ ਕਰਿ ਕਵਨ ਸੁਭਟ ਠਹਰਾਇ ॥",
      "transliteration": "taa ko judh bilok kar kavan subhaT Thaharai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਯੁੱਧ ਨੂੰ ਵੇਖ ਕੇ ਕਿਹੜਾ ਸੂਰਮਾ ਟਿਕ ਸਕਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "ता को जुधु बिलोकि करि कवन सुभट ठहराइ ॥",
      "sourceLineId": "113514",
      "sourceShabadId": "10169",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੋ ਸਮੁਹੈ ਆਵਤ ਭਯਾ ਜਮਪੁਰ ਦਿਯਾ ਪਠਾਇ ॥੭੮॥",
      "transliteration": "jo samuhai aavat bhayaa jamapur dhiyaa paThai ||78||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਵੀ ਸਾਹਮਣੇ ਆ ਗਿਆ, ਉਸ ਨੂੰ ਯਮਪੁਰ ਵਿਚ ਭੇਜ ਦਿੱਤਾ ॥੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "जो समुहै आवत भया जमपुर दिया पठाइ ॥७८॥",
      "sourceLineId": "113515",
      "sourceShabadId": "10169",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਵੈਯਾ ॥",
      "transliteration": "savaiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੈਯਾ:",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "सवैया ॥",
      "sourceLineId": "113516",
      "sourceShabadId": "10170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕੋਪ ਅਨੇਕ ਭਰੇ ਅਮਰਾਰਦਨ ਆਨਿ ਪਰੈ ਕਰਵਾਰਿ ਉਘਾਰੇ ॥",
      "transliteration": "kop anek bhare amaraaradhan aan parai karavaar ughaare ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤਿਆਂ ਦੇ ਅਨੇਕ ਵੈਰੀ (ਦੈਂਤ) ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਤਲਵਾਰਾ ਕਢ ਕੇ ਆ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "कोप अनेक भरे अमरारदन आनि परै करवारि उघारे ॥",
      "sourceLineId": "113517",
      "sourceShabadId": "10170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪਟਿਸ ਲੋਹਹਥੀ ਪਰਸੇ ਅਮਿਤਾਯੁਧ ਲੈ ਕਰਿ ਕੋਪ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "paTis lohahathee parase amitaayudh lai kar kop prahaare ||",
      "translation": "",
      "punjabiViakhya": "ਪੇਟੀਆਂ, ਲੋਹ-ਹਥੀਆਂ ਅਤੇ ਪਰਸੇ ਅਤੇ ਹੋਰ ਬਹਤੁ ਸਾਰੇ ਸ਼ਸਤ੍ਰ ਲੈ ਕੇ ਕ੍ਰੋਧ ਕਰ ਕੇ ਆ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "पटिस लोहहथी परसे अमितायुध लै करि कोप प्रहारे ॥",
      "sourceLineId": "113518",
      "sourceShabadId": "10170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾਰਿ ਸੰਭਾਰਿ ਹਥਯਾਰ ਸੁਰਾਰਿ ਹਕਾਰਿ ਹਨੇ ਨਹਿ ਜਾਤ ਬਿਚਾਰੇ ॥",
      "transliteration": "naar sa(n)bhaar hathayaar suraar hakaar hane neh jaat bichaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਹਥਿਆਰ ਲੈ ਕੇ ਦੇਵਤਿਆਂ ਦੇ ਵੈਰੀਆਂ ਨੂੰ ਲਲਕਾਰ ਕੇ ਮਾਰ ਦਿੱਤਾ, ਜਿਨ੍ਰਹਾ ਦੀ ਗਿਣਤੀ ਹੀ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "नारि संभारि हथयार सुरारि हकारि हने नहि जात बिचारे ॥",
      "sourceLineId": "113519",
      "sourceShabadId": "10170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਖੇਲਿ ਬਸੰਤ ਬਡੇ ਖਿਲਵਾਰ ਮਨੋ ਮਦ ਚਾਖਿ ਗਿਰੇ ਮਤਵਾਰੇ ॥੭੯॥",
      "transliteration": "khel basa(n)t badde khilavaar mano madh chaakh gire matavaare ||79||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਇਸ ਤਰ੍ਰਹਾ ਡਿਗ ਪਏ) ਮਾਨੋ ਫਾਗ ਖੇਡ ਕੇ ਅਤੇ ਸ਼ਰਾਬ ਪੀ ਕੇ ਮਤਵਾਲੇ ਡਿਗੇ ਪਏ ਹੋਣ ॥੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "खेलि बसंत बडे खिलवार मनो मद चाखि गिरे मतवारे ॥७९॥",
      "sourceLineId": "113520",
      "sourceShabadId": "10170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "113521",
      "sourceShabadId": "10171",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹੈ ਗੈ ਰਥੀ ਬਾਜੀ ਘਨੇ ਜੋਧਾ ਹਨੇ ਅਨੇਕ ॥",
      "transliteration": "hai gai rathee baajee ghane jodhaa hane anek ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜਿਆਂ, ਹਾਥੀਆਂ, ਰਥਾ ਵਾਲਿਆਂ (ਅਤੇ ਉਨ੍ਰਹਾ ਨਾਲ ਜੁਤੇ ਹੋਏ) ਘੋੜਿਆਂ ਤੇ ਬਹੁਤ ਸਾਰੇ ਯੋਧਿਆਂ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "है गै रथी बाजी घने जोधा हने अनेक ॥",
      "sourceLineId": "113522",
      "sourceShabadId": "10171",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜੀਤਿ ਸੁਯੰਬਰ ਰਨ ਰਹੀ ਭੂਪਤਿ ਬਚਾ ਨ ਏਕ ॥੮੦॥",
      "transliteration": "jeet suya(n)bar ran rahee bhoopat bachaa na ek ||80||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਰਾਜ ਕੁਮਾਰੀ) ਸੁਅੰਬਰ ਜਿਤ ਕੇ ਜੰਗ ਦੇ ਮੈਦਾਨ ਵਿਚ ਰਹਿ ਗਈ ਅਤੇ ਕੋਈ ਵੀ ਰਾਜਾ (ਬਾਕੀ) ਨਾ ਬਚਿਆ ॥੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "जीति सुयंबर रन रही भूपति बचा न एक ॥८०॥",
      "sourceLineId": "113523",
      "sourceShabadId": "10171",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਾਜਨ ਕੀ ਬਾਜੀ ਪਰੀ ਬਾਜਨ ਬਜੇ ਅਨੇਕ ॥",
      "transliteration": "baajan kee baajee paree baajan baje anek ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜਿਆਂ ਦੀ ਬਾਜ਼ੀ ਲਗ ਗਈ ਅਤੇ ਅਨੇਕ ਤਰ੍ਰਹਾ ਦੇ ਵਾਜੇ ਵਜੇ।",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "बाजन की बाजी परी बाजन बजे अनेक ॥",
      "sourceLineId": "113524",
      "sourceShabadId": "10171",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਿਸਿਖ ਬਹੁਤ ਬਰਸੇ ਤਹਾ ਬਚਾ ਨ ਬਾਜੀ ਏਕ ॥੮੧॥",
      "transliteration": "bisikh bahut barase tahaa bachaa na baajee ek ||81||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਬਹੁਤ ਸਾਰੇ ਬਾਣ ਚਲੇ ਅਤੇ ਇਕ ਵੀ ਘੋੜਾ ਨਾ ਬਚਿਆ ॥੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "बिसिख बहुत बरसे तहा बचा न बाजी एक ॥८१॥",
      "sourceLineId": "113525",
      "sourceShabadId": "10171",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "113526",
      "sourceShabadId": "10172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦੈਤ ਦਏ ਜਮ ਧਾਮ ਪਠਾਈ ॥",
      "transliteration": "dhait dhe jam dhaam paThaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦੋਂ) ਦੈਂਤਾ ਨੂੰ ਯਮ ਲੋਕ ਭੇਜ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "दैत दए जम धाम पठाई ॥",
      "sourceLineId": "113527",
      "sourceShabadId": "10172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਾਰੀ ਸੁਭਟ ਸਿੰਘ ਕੀ ਆਈ ॥",
      "transliteration": "baaree subhaT si(n)gh kee aaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦੋਂ) ਸੁਭਟ ਸਿੰਘ ਦੀ ਵਾਰੀ ਆ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "बारी सुभट सिंघ की आई ॥",
      "sourceLineId": "113528",
      "sourceShabadId": "10172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਿਹ ਤ੍ਰਿਯ ਕਹਾ ਆਇ ਤੁਮ ਲਰੋ ॥",
      "transliteration": "teh tiray kahaa aai tum laro ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਕਿਹਾ ਜਾ ਤਾ ਮੇਰੇ ਨਾਲ ਲੜੋ",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "तिह तृय कहा आइ तुम लरो ॥",
      "sourceLineId": "113529",
      "sourceShabadId": "10172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕੈ ਅਬ ਹਾਰਿ ਮਾਨ ਮੁਹਿ ਬਰੋ ॥੮੨॥",
      "transliteration": "kai ab haar maan muh baro ||82||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਹਾਰ ਮੰਨ ਕੇ ਮੇਰੇ ਨਾਲ ਵਿਆਹ ਕਰੋ ॥੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "कै अब हारि मान मुहि बरो ॥८२॥",
      "sourceLineId": "113530",
      "sourceShabadId": "10172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੁਭਟ ਸਿੰਘ ਜਬ ਯੌ ਸੁਨਿ ਪਾਯੋ ॥",
      "transliteration": "subhaT si(n)gh jab yau sun paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸੁਭਟ ਸਿੰਘ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "सुभट सिंघ जब यौ सुनि पायो ॥",
      "sourceLineId": "113531",
      "sourceShabadId": "10172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਧਿਕ ਚਿਤ ਮੈ ਕੋਪ ਬਢਾਯੋ ॥",
      "transliteration": "adhik chit mai kop baddaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮਨ ਵਿਚ ਬਹੁਤ ਕ੍ਰੋਧ ਵਧਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "अधिक चित मै कोप बढायो ॥",
      "sourceLineId": "113532",
      "sourceShabadId": "10172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮੈ ਕਾ ਜੁਧ ਤ੍ਰਿਯਾ ਤੇ ਡਰਿਹੋ ॥",
      "transliteration": "mai kaa judh tirayaa te ddariho ||",
      "translation": "",
      "punjabiViakhya": "ਕੀ ਮੈਂ ਇਸਤਰੀ ਨਾਲ ਯੁੱਧ ਕਰਨੋਂ ਡਰਦਾ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "मै का जुध तृया ते डरिहो ॥",
      "sourceLineId": "113533",
      "sourceShabadId": "10172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਯਾ ਕੋ ਤ੍ਰਾਸ ਮਾਨਿ ਯਹ ਬਰਿਹੋ ॥੮੩॥",
      "transliteration": "yaa ko traas maan yeh bariho ||83||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਦਾ ਡਰ ਮੰਨ ਕੇ ਇਸ ਨੂੰ ਵਰ ਲਵਾ ॥੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "या को त्रास मानि यह बरिहो ॥८३॥",
      "sourceLineId": "113534",
      "sourceShabadId": "10172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਹੂੰ ਮਤਿ ਗੈਵਰ ਗਰਜਾਹੀ ॥",
      "transliteration": "kahoo(n) mat gaivar garajaahee ||",
      "translation": "",
      "punjabiViakhya": "ਕਈਆਂ (ਸੂਰਮਿਆਂ ਨੇ) ਮਸਤ ਹਾਥੀਆਂ ਨੂੰ ਗਰਜਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "कहूँ मति गैवर गरजाही ॥",
      "sourceLineId": "113535",
      "sourceShabadId": "10172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਹੂੰ ਪਾਖਰੇ ਹੈ ਹਿਾਂਹਨਾਹੀ ॥",
      "transliteration": "kahoo(n) paakhare hai hiaa(n)hanaahee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈਆਂ ਨੇ (ਘੋੜਿਆਂ ਉਤੇ) ਕਾਠੀਆਂ ਪਾ ਕੇ (ਉਨ੍ਰਹਾ ਨੂੰ) ਹਿਣਕਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "कहूँ पाखरे है हिाँहनाही ॥",
      "sourceLineId": "113536",
      "sourceShabadId": "10172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਸਤ੍ਰ ਕਵਚ ਸੂਰਾ ਕਹੂੰ ਕਸੈ ॥",
      "transliteration": "sasatr kavach sooraa kahoo(n) kasai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸੂਰਮੇ ਸ਼ਸਤ੍ਰ ਅਤੇ ਕਵਚ ਕਸ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "ससत्र कवच सूरा कहूँ कसै ॥",
      "sourceLineId": "113537",
      "sourceShabadId": "10172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜੁਗਿਨ ਰੁਧਿਰ ਖਪਰ ਭਰ ਹਸੈ ॥੮੪॥",
      "transliteration": "jugin rudhir khapar bhar hasai ||84||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਕਿਤੇ) ਜੋਗਣਾ ਲਹੂ ਦੇ ਖੱਪਰ ਭਰ ਕੇ ਹਸ ਰਹੀਆਂ ਸਨ ॥੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "जुगिन रुधिर खपर भर हसै ॥८४॥",
      "sourceLineId": "113538",
      "sourceShabadId": "10172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਵੈਯਾ ॥",
      "transliteration": "savaiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੈਯਾ:",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "सवैया ॥",
      "sourceLineId": "113539",
      "sourceShabadId": "10173",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸ੍ਰੀ ਸੁਭਟੇਸ ਬਡੋ ਦਲੁ ਲੈ ਉਮਡਿਯੋ ਗਹਿ ਕੈ ਕਰਿ ਆਯੁਧ ਬਾਕੇ ॥",
      "transliteration": "sree subhaTes baddo dhal lai umaddiyo geh kai kar aayudh baake ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਭਟ ਸਿੰਘ ਹੱਥ ਵਿਚ ਸੁੰਦਰ ਸ਼ਸਤ੍ਰ ਲੈ ਕੇ ਅਤੇ ਬਹੁਤ ਵੱਡਾ ਦਲ ਲੈ ਕੇ ਉਮਡ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "स्री सुभटेस बडो दलु लै उमडियो गहि कै करि आयुध बाके ॥",
      "sourceLineId": "113540",
      "sourceShabadId": "10173",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬੀਰ ਹਠੀ ਕਵਚੀ ਖੜਗੀ ਪਰਸੀਸ ਭਈ ਸਰਦਾਰ ਨਿਸਾਕੇ ॥",
      "transliteration": "beer haThee kavachee khaRagee parasees bhiee saradhaar nisaake ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੈਨਾ ਵਿਚ ਹਠੀ, ਕਵਚਧਾਰੀ, ਖੜਗਧਾਰੀ ਅਤੇ ਕੁਹਾੜਿਆਂ ਵਾਲੇ (ਸਭ ਦੀ) ਨਿਸ਼ਾ ਕਰਾ ਦੇਣ ਵਾਲੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "बीर हठी कवची खड़गी परसीस भई सरदार निसाके ॥",
      "sourceLineId": "113541",
      "sourceShabadId": "10173",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਏਕ ਟਰੇ ਇਕ ਆਨ ਅਰੇ ਇਕ ਜੂਝਿ ਗਿਰੇ ਬ੍ਰਿਣ ਖਾਇ ਤ੍ਰਿਯਾ ਕੇ ॥",
      "transliteration": "ek Tare ik aan are ik joojh gire biran khai tirayaa ke ||",
      "translation": "",
      "punjabiViakhya": "ਕੋਈ ਟਲ ਜਾਦਾ ਸੀ, ਇਕ ਆ ਕੇ ਅੜ ਜਾਦਾ ਸੀ ਅਤੇ ਕੋਈ ਰਾਜ ਕੁਮਾਰੀ ਤੋਂ ਜ਼ਖਮ ਖਾ ਕੇ ਜੂਝ ਕੇ ਡਿਗ ਪੈਂਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "एक टरे इक आन अरे इक जूझि गिरे बृण खाइ तृया के ॥",
      "sourceLineId": "113542",
      "sourceShabadId": "10173",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਛਾਰ ਚੜਾਇ ਕੈ ਅੰਗ ਮਲੰਗ ਰਹੇ ਮਨੌ ਸੋਇ ਪਿਯੇ ਬਿਜਯਾ ਕੇ ॥੮੫॥",
      "transliteration": "chhaar chaRai kai a(n)g mala(n)g rahe manau soi piye bijayaa ke ||85||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸ਼ਰੀਰ ਉਤੇ ਵਿਭੂਤੀ ਮਲ ਕੇ ਮਲੰਗ ਲੋਕ ਭੰਗ ਪੀ ਕੇ ਸੁੱਤੇ ਪਏ ਹੋਣ ॥੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "छार चड़ाइ कै अंग मलंग रहे मनौ सोइ पिये बिजया के ॥८५॥",
      "sourceLineId": "113543",
      "sourceShabadId": "10173",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "113544",
      "sourceShabadId": "10174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਐਸੋ ਬੀਰ ਖੇਤ ਤਹ ਪਰਿਯੋ ॥",
      "transliteration": "aaiso beer khet teh pariyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਅਜਿਹਾ ਤਕੜਾ ਯੁੱਧ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "ऐसो बीर खेत तह परियो ॥",
      "sourceLineId": "113545",
      "sourceShabadId": "10174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਏਕ ਸੁਭਟ ਜੀਵਤ ਨ ਉਬਰਿਯੋ ॥",
      "transliteration": "ek subhaT jeevat na ubariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਵੀ ਸੂਰਮਾ ਜੀਉਾਂਦਾ ਨਾ ਬਚਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "एक सुभट जीवत न उबरियो ॥",
      "sourceLineId": "113546",
      "sourceShabadId": "10174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦਸ ਹਜਾਰ ਮਾਤੇ ਗਜ ਮਾਰੇ ॥",
      "transliteration": "dhas hajaar maate gaj maare ||",
      "translation": "",
      "punjabiViakhya": "ਦਸ ਹਜ਼ਾਰ ਮਸਤ ਹਾਥੀ ਮਾਰੇ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "दस हजार माते गज मारे ॥",
      "sourceLineId": "113547",
      "sourceShabadId": "10174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬੀਸ ਹਜਾਰ ਬਰ ਬਾਜ ਬਿਦਾਰੇ ॥੮੬॥",
      "transliteration": "bees hajaar bar baaj bidhaare ||86||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵੀਹ ਹਜ਼ਾਰ ਸੁੰਦਰ ਘੋੜੇ ਮਾਰ ਦਿੱਤੇ ਗਏ ॥੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "बीस हजार बर बाज बिदारे ॥८६॥",
      "sourceLineId": "113548",
      "sourceShabadId": "10174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤੀਸ ਐਤ ਪੈਦਲ ਕਹ ਮਾਰਿਯੋ ॥",
      "transliteration": "tees aait paidhal keh maariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਿੰਨ ਲਖ (ਤੀਹ ਦਸ ਹਜ਼ਾਰ) ਪੈਦਲਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "तीस ऐत पैदल कह मारियो ॥",
      "sourceLineId": "113549",
      "sourceShabadId": "10174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤੇਇਸ ਲਛ ਰਥ ਹਨਿ ਡਾਰਿਯੋ ॥",
      "transliteration": "teis lachh rath han ddaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੇਈ ਲਖ ਰਥ ਨਸ਼ਟ ਕਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "तेइस लछ रथ हनि डारियो ॥",
      "sourceLineId": "113550",
      "sourceShabadId": "10174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਦ੍ਵਾਦਸ ਲਛ ਰਥੀ ਅਤਿ ਮਾਰਿਸ ॥",
      "transliteration": "dhavaiaadhas lachh rathee at maaris ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਰ੍ਰਹਾ ਲਖ ਅਤਿ (ਵਿਕਟ) ਰਥਾ ਵਾਲੇ",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "द्वादस लछ रथी अति मारिस ॥",
      "sourceLineId": "113551",
      "sourceShabadId": "10174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਹਾਰਥੀ ਅਨਗਨਤ ਸੰਘਾਰਸਿ ॥੮੭॥",
      "transliteration": "mahaarathee anaganat sa(n)ghaaras ||87||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਣਗਿਣਤ ਮਹਾ ਰਥੀ ਮਾਰ ਦਿੱਤੇ ॥੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "महारथी अनगनत संघारसि ॥८७॥",
      "sourceLineId": "113552",
      "sourceShabadId": "10174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0875_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "113553",
      "sourceShabadId": "10175",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
