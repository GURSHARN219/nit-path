{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 876,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0876_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹੈ ਗੈ ਰਥ ਬਾਜੀ ਘਨੇ ਰਥ ਕਟਿ ਗਏ ਅਨੇਕ ॥੮੮॥",
      "transliteration": "hai gai rath baajee ghane rath kaT ge anek ||88||",
      "translation": "",
      "punjabiViakhya": "ਹਾਥੀ, ਘੋੜੇ, ਰਥ ਅਤੇ ਰਥਾ ਨਾਲ ਜੁਤੇ ਬਹੁਤ ਘੋੜੇ ਕਟ ਕੇ ਡਿਗੇ ਪਏ ਸਨ ॥੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "है गै रथ बाजी घने रथ कटि गए अनेक ॥८८॥",
      "sourceLineId": "113555",
      "sourceShabadId": "10175",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "113556",
      "sourceShabadId": "10176",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੁੰਦ ਜੁਧ ਤ੍ਰਿਯ ਪਤਿਹ ਮਚਾਯੋ ॥",
      "transliteration": "dhu(n)dh judh tiray pateh machaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ (ਰਾਜ ਕੁਮਾਰੀ) ਨੇ ਪਤੀ ਨਾਲ ਦੁਅੰਦ ਯੁੱਧ ਮਚਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "दुँद जुध तृय पतिह मचायो ॥",
      "sourceLineId": "113557",
      "sourceShabadId": "10176",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਿਰਖਨ ਦਿਨਿਸ ਨਿਸਿਸ ਰਨ ਆਯੋ ॥",
      "transliteration": "nirakhan dhinis nisis ran aayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖਣ ਲਈ ਸੂਰਜ ਅਤੇ ਚੰਦ੍ਰਮਾ ਵੀ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਆਏ।",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "निरखन दिनिस निसिस रन आयो ॥",
      "sourceLineId": "113558",
      "sourceShabadId": "10176",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬ੍ਰਹਮਾ ਚੜੇ ਹੰਸ ਪਰ ਆਏ ॥",
      "transliteration": "brahamaa chaRe ha(n)s par aae ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਹਮਾ ਹੰਸ ਉਤੇ ਚੜ੍ਰਹ ਕੇ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "ब्रहमा चड़े हंस पर आए ॥",
      "sourceLineId": "113559",
      "sourceShabadId": "10176",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪੰਚ ਬਦਨ ਹੂੰ ਤਹਾ ਸੁਹਾਏ ॥੮੯॥",
      "transliteration": "pa(n)ch badhan hoo(n) tahaa suhaae ||89||",
      "translation": "",
      "punjabiViakhya": "ਪੰਜ ਮੂੰਹਾ ਵਾਲਾ ਸ਼ਿਵ ਵੀ ਉਥੇ ਆਇਆ ॥੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "पंच बदन हूँ तहा सुहाए ॥८९॥",
      "sourceLineId": "113560",
      "sourceShabadId": "10176",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤ੍ਰਿਯ ਕੋਮਲ ਪਿਯ ਬਾਨ ਪ੍ਰਹਾਰੈ ॥",
      "transliteration": "tiray komal piy baan prahaarai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਪ੍ਰੀਤਮ ਨੂੰ ਕੋਮਲ ਬਾਣ ਮਾਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "तृय कोमल पिय बान प्रहारै ॥",
      "sourceLineId": "113561",
      "sourceShabadId": "10176",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਿਯ ਤੇ ਤਾਹਿ ਮਾਰਿ ਨਹਿ ਡਾਰੈ ॥",
      "transliteration": "jiy te taeh maar neh ddaarai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਉਾਂਕਿ ਉਸ ਨੂੰ ਜਾਨ ਤੋਂ ਮਾਰਨਾ ਨਹੀਂ ਚਾਹੁੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "जिय ते ताहि मारि नहि डारै ॥",
      "sourceLineId": "113562",
      "sourceShabadId": "10176",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਲਗੇ ਬਿਸਿਖ ਕੇ ਜਿਨ ਪਤਿ ਮਰੈ ॥",
      "transliteration": "lage bisikh ke jin pat marai ||",
      "translation": "",
      "punjabiViakhya": "(ਡਰਦੀ ਸੀ ਕਿ) ਕਿਤੇ ਬਾਣ ਲਗਣ ਨਾਲ ਪਤੀ ਮਰ ਨਾ ਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "लगे बिसिख के जिन पति मरै ॥",
      "sourceLineId": "113563",
      "sourceShabadId": "10176",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮੁਹਿ ਪੈਠਬ ਪਾਵਕ ਮਹਿ ਪਰੈ ॥੯੦॥",
      "transliteration": "muh paiThab paavak meh parai ||90||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੈਨੂੰ ਅੱਗ ਵਿਚ ਵੜਨਾ ਪਵੇ ॥੯੦॥",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "मुहि पैठब पावक महि परै ॥९०॥",
      "sourceLineId": "113564",
      "sourceShabadId": "10176",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚਾਰ ਪਹਰ ਨਿਜ ਪਤਿ ਸੋ ਲਰੀ ॥",
      "transliteration": "chaar pahar nij pat so laree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਚਾਰ ਪਹਿਰ ਤਕ ਆਪਣੇ ਪਤੀ ਨਾਲ ਲੜੀ।",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "चार पहर निज पति सो लरी ॥",
      "sourceLineId": "113565",
      "sourceShabadId": "10176",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦੁਹੂੰਅਨ ਬਿਸਿਖ ਬ੍ਰਿਸਟਿ ਬਹੁ ਕਰੀ ॥",
      "transliteration": "dhuhoo(n)an bisikh birasaT bahu karee ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੇ ਬਾਣਾ ਦੀ ਬਹੁਤ ਬਰਖਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "दुहूँअन बिसिख बृसटि बहु करी ॥",
      "sourceLineId": "113566",
      "sourceShabadId": "10176",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਬ ਲੋ ਸੂਰ ਅਸਤ ਹ੍ਵੈ ਗਯੋ ॥",
      "transliteration": "tab lo soor asat havai gayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਸੂਰਜ ਡੁਬ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "तब लो सूर असत ह्वै गयो ॥",
      "sourceLineId": "113567",
      "sourceShabadId": "10176",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪ੍ਰਾਚੀ ਦਿਸਾ ਚੰਦ੍ਰ ਪ੍ਰਗਟ੍ਯੋ ॥੯੧॥",
      "transliteration": "praachee dhisaa cha(n)dhr pragaTayo ||91||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੂਰਬ ਵਲੋਂ ਚੰਦ੍ਰਮਾ ਪ੍ਰਗਟ ਹੋ ਗਿਆ ॥੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "प्राची दिसा चंद्र प्रगट्यो ॥९१॥",
      "sourceLineId": "113568",
      "sourceShabadId": "10176",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "113569",
      "sourceShabadId": "10177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹਕਾਹਕੀ ਆਹਵ ਭਯੋ ਰਹਿਯੋ ਸੁਭਟ ਕੋਊ ਨਾਹਿ ॥",
      "transliteration": "hakaahakee aahav bhayo rahiyo subhaT kouoo naeh ||",
      "translation": "",
      "punjabiViakhya": "ਵੰਗਾਰ ਵੰਗਾਰ ਕੇ ਯੁੱਧ ਹੋਇਆ ਅਤੇ ਕੋਈ ਵੀ ਸੂਰਮਾ ਜੀਉਾਂਦਾ ਨਾ ਬਚਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "हकाहकी आहव भयो रहियो सुभट कोऊ नाहि ॥",
      "sourceLineId": "113570",
      "sourceShabadId": "10177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜੁਧ ਕਰਤ ਅਤਿ ਥਕਤ ਭੇ ਰਹਤ ਭਏ ਰਨ ਮਾਹਿ ॥੯੨॥",
      "transliteration": "judh karat at thakat bhe rahat bhe ran maeh ||92||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਕਰ ਕੇ ਬਹੁਤ ਥਕ ਗਏ ਅਤੇ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਹੀ ਲੰਬੇ ਪੈ ਗਏ ॥੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "जुध करत अति थकत भे रहत भए रन माहि ॥९२॥",
      "sourceLineId": "113571",
      "sourceShabadId": "10177",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "113572",
      "sourceShabadId": "10178",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਲਗੇ ਬ੍ਰਿਨਨ ਕੇ ਘਾਇਲ ਭਏ ॥",
      "transliteration": "lage biranan ke ghail bhe ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਜ਼ਖ਼ਮਾ ਦੇ ਲਗਣ ਨਾਲ ਘਾਇਲ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "लगे बृनन के घाइल भए ॥",
      "sourceLineId": "113573",
      "sourceShabadId": "10178",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਤਿ ਲਰਿ ਅਧਿਕ ਸ੍ਰਮਤ ਹ੍ਵੈ ਗਏ ॥",
      "transliteration": "at lar adhik sramat havai ge ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਅਧਿਕ ਲੜਾਈ ਕਰ ਕੇ ਥਕ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "अति लरि अधिक स्रमत ह्वै गए ॥",
      "sourceLineId": "113574",
      "sourceShabadId": "10178",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਆਹਵ ਬਿਖੈ ਗਿਰੇ ਬਿਸੰਭਾਰੀ ॥",
      "transliteration": "aahav bikhai gire bisa(n)bhaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਦੋਵੇਾਂ) ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਬੇਸੁਧ ਹੋ ਕੇ ਡਿਗ ਪਏ,",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "आहव बिखै गिरे बिसंभारी ॥",
      "sourceLineId": "113575",
      "sourceShabadId": "10178",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਰ ਤੇ ਕਿਨਹੂੰ ਕ੍ਰਿਪਾਨ ਨ ਡਾਰੀ ॥੯੩॥",
      "transliteration": "kar te kinahoo(n) kirapaan na ddaaree ||93||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਹੱਥ ਵਿਚੋਂ ਕਿਸੇ ਨੇ ਵੀ ਕ੍ਰਿਪਾਨ ਨਾ ਛਡੀ ॥੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "कर ते किनहूँ कृपान न डारी ॥९३॥",
      "sourceLineId": "113576",
      "sourceShabadId": "10178",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "113577",
      "sourceShabadId": "10179",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪ੍ਰੇਤ ਨਚਹਿ ਜੁਗਨਿ ਹਸਹਿ ਜੰਬੁਕ ਗੀਧ ਫਿਰਾਹਿ ॥",
      "transliteration": "pret nacheh jugan haseh ja(n)buk geedh firaeh ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰੇਤ ਨਚ ਰਹੇ ਸਨ, ਜੋਗਣਾ ਹਸ ਰਹੀਆਂ ਸਨ ਅਤੇ ਗਿਦੜ ਅਤੇ ਗਿਰਝਾ ਫਿਰ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "प्रेत नचहि जुगनि हसहि जंबुक गीध फिराहि ॥",
      "sourceLineId": "113578",
      "sourceShabadId": "10179",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਿਸਿ ਸਿਗਰੀ ਮੁਰਛਿਤ ਰਹੇ ਦੁਹੂੰ ਰਹੀ ਸੁਧਿ ਨਾਹਿ ॥੯੪॥",
      "transliteration": "nis sigaree murachhit rahe dhuhoo(n) rahee sudh naeh ||94||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦੋਵੇਾਂ ਸਾਰੀ ਰਾਤ ਬੇਹੋਸ਼ ਰਹੇ ਅਤੇ ਕੋਈ ਸੁਧ ਨਾ ਰਹੀ ॥੯੪॥",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "निसि सिगरी मुरछित रहे दुहूँ रही सुधि नाहि ॥९४॥",
      "sourceLineId": "113579",
      "sourceShabadId": "10179",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪ੍ਰਾਚੀ ਦਿਸਿ ਰਵਿ ਪ੍ਰਗਟਿਯਾ ਭਈ ਚੰਦ੍ਰ ਕੀ ਹਾਨ ॥",
      "transliteration": "praachee dhis rav pragaTiyaa bhiee cha(n)dhr kee haan ||",
      "translation": "",
      "punjabiViakhya": "ਪੂਰਬ ਦਿਸ਼ਾ ਵਿਚ ਸੂਰਜ ਪ੍ਰਗਟ ਹੋਇਆ ਅਤੇ ਚੰਦ੍ਰਮਾ ਛਿਪ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "प्राची दिसि रवि प्रगटिया भई चंद्र की हान ॥",
      "sourceLineId": "113580",
      "sourceShabadId": "10179",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪੁਨਿ ਪਤਿ ਤ੍ਰਿਯ ਰਨ ਕੋ ਉਠੇ ਅਧਿਕ ਕੋਪ ਮਨ ਠਾਨਿ ॥੯੫॥",
      "transliteration": "pun pat tiray ran ko uThe adhik kop man Thaan ||95||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਪਤੀ ਅਤੇ ਇਸਤਰੀ ਮਨ ਵਿਚ ਬਹੁਤ ਕ੍ਰੋਧ ਵਧਾ ਕੇ ਯੁੱਧ ਕਰਨ ਲਈ ਉਠੇ ॥੯੫॥",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "पुनि पति तृय रन को उठे अधिक कोप मन ठानि ॥९५॥",
      "sourceLineId": "113581",
      "sourceShabadId": "10179",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "113582",
      "sourceShabadId": "10180",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਆਠ ਜਾਮ ਦੋਊ ਉਠਿ ਕਰਿ ਲਰੇ ॥",
      "transliteration": "aaTh jaam dhouoo uTh kar lare ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਉਠ ਕੇ ਅੱਠ ਪਹਿਰ ਤਕ ਲੜੇ।",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "आठ जाम दोऊ उठि करि लरे ॥",
      "sourceLineId": "113583",
      "sourceShabadId": "10180",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਟੂਕਤ ਤਨੁਤ੍ਰਾਣਨ ਕੇ ਝਰੇ ॥",
      "transliteration": "Tookat tanutraanan ke jhare ||",
      "translation": "",
      "punjabiViakhya": "ਕਵਚਾ ਨੇ ਟੋਟੇ ਟੋਟੇ ਹੋ ਕੇ ਝੜ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "टूकत तनुत्राणन के झरे ॥",
      "sourceLineId": "113584",
      "sourceShabadId": "10180",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਧਿਕ ਲਰਾਈ ਦੁਹੂੰ ਮਚਈ ॥",
      "transliteration": "adhik laraiee dhuhoo(n) machiee ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੇ ਬਹੁਤ ਲੜਾਈ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "अधिक लराई दुहूँ मचई ॥",
      "sourceLineId": "113585",
      "sourceShabadId": "10180",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਥ੍ਰਯੋ ਸੂਰ ਰੈਨ ਹ੍ਵੈ ਗਈ ॥੯੬॥",
      "transliteration": "athrayo soor rain havai giee ||96||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਜ ਡੁਬ ਗਿਆ ਅਤੇ ਰਾਤ ਹੋ ਗਈ ॥੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "अथ्रयो सूर रैन ह्वै गई ॥९६॥",
      "sourceLineId": "113586",
      "sourceShabadId": "10180",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚਾਰਿ ਬਾਜ ਬਿਸਿਖਨ ਤ੍ਰਿਯ ਮਾਰੇ ॥",
      "transliteration": "chaar baaj bisikhan tiray maare ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਬਾਣਾ ਨਾਲ ਚਾਰ ਘੋੜੇ ਮਾਰ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "चारि बाज बिसिखन तृय मारे ॥",
      "sourceLineId": "113587",
      "sourceShabadId": "10180",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰਥ ਕੇ ਕਾਟਿ ਦੋਊ ਚਕ ਡਾਰੇ ॥",
      "transliteration": "rath ke kaaT dhouoo chak ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਥ ਦੇ ਦੋਵੇਾਂ ਚਕ (ਪਹੀਏ) ਕਟ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "रथ के काटि दोऊ चक डारे ॥",
      "sourceLineId": "113588",
      "sourceShabadId": "10180",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਥ ਧੁਜਾ ਕਟਿ ਭੂਮਿ ਗਿਰਾਈ ॥",
      "transliteration": "naath dhujaa kaT bhoom giraiee ||",
      "translation": "",
      "punjabiViakhya": "ਪਤੀ ਦੇ ਝੰਡੇ ਨੂੰ ਕਟ ਕੇ ਧਰਤੀ ਉਤੇ ਸੁਟ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "नाथ धुजा कटि भूमि गिराई ॥",
      "sourceLineId": "113589",
      "sourceShabadId": "10180",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੂਤਿ ਦਿਯਾ ਜਮਲੋਕ ਪਠਾਈ ॥੯੭॥",
      "transliteration": "soot dhiyaa jamalok paThaiee ||97||",
      "translation": "She cut off the husbands flag and threw it on the ground and sent the chariot-driver to the hell as well.(97)",
      "punjabiViakhya": "ਅਤੇ ਰਥਵਾਨ ਨੂੰ ਯਮ ਲੋਕ ਵਿਚ ਭੇਜ ਦਿੱਤਾ ॥੯੭॥",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "सूति दिया जमलोक पठाई ॥९७॥",
      "sourceLineId": "113590",
      "sourceShabadId": "10180",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੁਭਟ ਸਿੰਘ ਕਹ ਪੁਨਿ ਸਰ ਮਾਰਿਯੋ ॥",
      "transliteration": "subhaT si(n)gh keh pun sar maariyo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਸੁਭਟ ਸਿੰਘ ਨੂੰ ਤੀਰ ਮਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "सुभट सिंघ कह पुनि सर मारियो ॥",
      "sourceLineId": "113591",
      "sourceShabadId": "10180",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮੂਰਛਿਤ ਕਰਿ ਪ੍ਰਿਥਵੀ ਪਰ ਡਾਰਿਯੋ ॥",
      "transliteration": "moorachhit kar pirathavee par ddaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਨੂੰ) ਬੇਹੋਸ਼ ਕਰ ਕੇ ਧਰਤੀ ਉਤੇ ਸੁਟ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "मूरछित करि पृथवी पर डारियो ॥",
      "sourceLineId": "113592",
      "sourceShabadId": "10180",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਿਨੁ ਸੁਧਿ ਭਏ ਤਾਹਿ ਲਖ ਲੀਨੋ ॥",
      "transliteration": "bin sudh bhe taeh lakh leeno ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਉਸ ਨੂੰ ਬੇਹੋਸ਼ ਹੋਇਆ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "बिनु सुधि भए ताहि लख लीनो ॥",
      "sourceLineId": "113593",
      "sourceShabadId": "10180",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਆਪੁ ਬੇਖਿ ਤਿਹ ਤ੍ਰਿਯ ਕੋ ਕੀਨੋ ॥੯੮॥",
      "transliteration": "aap bekh teh tiray ko keeno ||98||",
      "translation": "Then she hit Subhat Singh with an arrow and made him to faint and disguised herself as his wife.(98)",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੇ ਆਪ ਇਸਤਰੀ ਦਾ ਰੂਪ ਧਾਰਨ ਕੀਤਾ ॥੯੮॥",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "आपु बेखि तिह तृय को कीनो ॥९८॥",
      "sourceLineId": "113594",
      "sourceShabadId": "10180",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰਥ ਤੇ ਉਤਰਿ ਬਾਰਿ ਲੈ ਆਈ ॥",
      "transliteration": "rath te utar baar lai aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਥ ਤੋਂ ਉਤਰ ਕੇ ਪਾਣੀ ਲੈ ਆਈ",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "रथ ते उतरि बारि लै आई ॥",
      "sourceLineId": "113595",
      "sourceShabadId": "10180",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਾਨ ਲਾਗ ਕਰਿ ਬਾਤ ਸੁਨਾਈ ॥",
      "transliteration": "kaan laag kar baat sunaiee ||",
      "translation": "She climbed down the chariot and brought water and said in his ears",
      "punjabiViakhya": "ਅਤੇ ਕੰਨਾ ਦੇ ਨੇੜੇ ਹੋ ਕੇ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "कान लाग करि बात सुनाई ॥",
      "sourceLineId": "113596",
      "sourceShabadId": "10180",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੁਨੋ ਨਾਥ ਮੈ ਤ੍ਰਿਯ ਤਿਹਾਰੀ ॥",
      "transliteration": "suno naath mai tiray tihaaree ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਨਾਥ! ਸੁਣੋ, ਮੈਂ ਤੁਹਾਡੀ ਪਤਨੀ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "सुनो नाथ मै तृय तिहारी ॥",
      "sourceLineId": "113597",
      "sourceShabadId": "10180",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤੁਮ ਕੋ ਜੋ ਪ੍ਰਾਨਨ ਤੇ ਪ੍ਯਾਰੀ ॥੯੯॥",
      "transliteration": "tum ko jo praanan te payaaree ||99||",
      "translation": "‘Listen my Master, I am your wife, and love you more than my life.’(99)",
      "punjabiViakhya": "ਤੁਹਾਨੂੰ ਜੋ ਪ੍ਰਾਣਾ ਤੋਂ ਪਿਆਰੀ ਹੈ ॥੯੯॥",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "तुम को जो प्रानन ते प्यारी ॥९९॥",
      "sourceLineId": "113598",
      "sourceShabadId": "10180",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "113599",
      "sourceShabadId": "10181",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਲ ਸੀਚੇ ਜਾਗਤਿ ਭਯੋ ਅਤਿ ਤਨ ਲਾਗੇ ਘਾਇ ॥",
      "transliteration": "jal seeche jaagat bhayo at tan laage ghai ||",
      "translation": "With sprinkling of water Subhat Singh regained consciousness,",
      "punjabiViakhya": "ਜਲ ਛਿੜਕਣ ਨਾਲ (ਉਹ) ਜਾਗ ਪਿਆ। ਉਸ ਦੇ ਸ਼ਰੀਰ ਉਤੇ ਬਹੁਤ ਜ਼ਖ਼ਮ ਲਗੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "जल सीचे जागति भयो अति तन लागे घाइ ॥",
      "sourceLineId": "113600",
      "sourceShabadId": "10181",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭਲੋ ਬੁਰੋ ਖਲ ਅਖਲ ਕੋ ਕਛੂ ਨ ਚੀਨਾ ਜਾਇ ॥੧੦੦॥",
      "transliteration": "bhalo buro khal akhal ko kachhoo na cheenaa jai ||100||",
      "translation": "But he could not perceive, who was his foe and who the friend,(100)",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਮਾੜੇ ਚੰਗੇ, ਦੁਸ਼ਟ ਅਤੇ ਸਜਨ ਦੀ ਕੋਈ ਪਛਾਣ ਨਾ ਰਹੀ ॥੧੦੦॥",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "भलो बुरो खल अखल को कछू न चीना जाइ ॥१००॥",
      "sourceLineId": "113601",
      "sourceShabadId": "10181",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0876_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 876,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "113602",
      "sourceShabadId": "10182",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
