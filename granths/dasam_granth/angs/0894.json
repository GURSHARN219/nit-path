{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 894,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0894_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਹਾ ਰੋਗ ਤੇ ਲੇਹੁ ਉਬਾਰੀ ॥੩੩॥",
      "transliteration": "mahaa rog te leh ubaaree ||33||",
      "translation": "‘All our people have committed some mistakes, but now please save us from this heinous malady.’(33)",
      "punjabiViakhya": "(ਇਨ੍ਰਹਾ ਨੂੰ ਇਸ) ਮਹਾ ਰੋਗ ਤੋਂ ਬਚਾ ਲਵੋ ॥੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "महा रोग ते लेहु उबारी ॥३३॥",
      "sourceLineId": "114491",
      "sourceShabadId": "10316",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਾਹ ਸੁਤ ਬਾਚ ॥",
      "transliteration": "saeh sut baach ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਾਹ ਦੇ ਪੁੱਤਰ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "साह सुत बाच ॥",
      "sourceLineId": "114492",
      "sourceShabadId": "10317",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "114493",
      "sourceShabadId": "10317",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਕਲ ਕਥਾ ਤਿਨ ਭਾਖਿ ਸੁਨਾਈ ॥",
      "transliteration": "sakal kathaa tin bhaakh sunaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਸਾਰੀ ਗੱਲ ਦਸ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "सकल कथा तिन भाखि सुनाई ॥",
      "sourceLineId": "114494",
      "sourceShabadId": "10317",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪੁਰ ਲੋਗਨ ਸਭਹੂੰ ਸੁਨਿ ਪਾਈ ॥",
      "transliteration": "pur logan sabhahoo(n) sun paiee ||",
      "translation": "Then he narrated the entire story, which people listened attentively.",
      "punjabiViakhya": "ਅਤੇ ਪਿੰਡ ਦੇ ਸਾਰੇ ਲੋਕਾ ਨੇ ਸੁਣ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "पुर लोगन सभहूँ सुनि पाई ॥",
      "sourceLineId": "114495",
      "sourceShabadId": "10317",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਲੈ ਦੂਜੀ ਕੰਨ੍ਯਾ ਤਿਹ ਦੀਨੀ ॥",
      "transliteration": "lai dhoojee ka(n)nayaa teh dheenee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਦੂਜੀ ਕੰਨਿਆ ਦੇ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "लै दूजी कंन्या तिह दीनी ॥",
      "sourceLineId": "114496",
      "sourceShabadId": "10317",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਉਸਤਤਿ ਮਿਲ ਕੀਨੀ ॥੩੪॥",
      "transliteration": "bhaat bhaat usatat mil keenee ||34||",
      "translation": "They gave him another damsel and praised him in various ways.(34)",
      "punjabiViakhya": "ਅਤੇ ਮਿਲ ਕੇ ਭਾਤ ਭਾਤ ਦੀ ਉਸਤਤ ਕੀਤੀ ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "भाति भाति उसतति मिल कीनी ॥३४॥",
      "sourceLineId": "114497",
      "sourceShabadId": "10317",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਔਰ ਸਕਲ ਪੁਰ ਛੋਰਿ ਉਬਾਰਿਯੋ ॥",
      "transliteration": "aauar sakal pur chhor ubaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਸਾਰੇ ਪਿੰਡ ਨੂੰ ਮੁਕਤ ਕਰ ਕੇ (ਉਨ੍ਰਹਾ ਨੂੰ) ਉਬਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "और सकल पुर छोरि उबारियो ॥",
      "sourceLineId": "114498",
      "sourceShabadId": "10317",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਊਆ ਸੁਤ ਚਿਮਟਿਯੋ ਹੀ ਮਾਰਿਯੋ ॥",
      "transliteration": "nuooaa sut chimaTiyo hee maariyo ||",
      "translation": "Then the Shah’s son emancipated the whole village.",
      "punjabiViakhya": "ਅਤੇ ਨਾਈ ਦੇ ਪੁੱਤਰ ਨੂੰ ਚਿਮਟਿਆ ਹੋਇਆ ਹੀ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "नऊआ सुत चिमटियो ही मारियो ॥",
      "sourceLineId": "114499",
      "sourceShabadId": "10317",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬ੍ਯਾਹ ਦੂਸਰੋ ਅਪਨੋ ਕੀਨੋ ॥",
      "transliteration": "bayaeh dhoosaro apano keeno ||",
      "translation": "",
      "punjabiViakhya": "ਆਪ ਦੂਜਾ ਵਿਆਹ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "ब्याह दूसरो अपनो कीनो ॥",
      "sourceLineId": "114500",
      "sourceShabadId": "10317",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਿਜੁ ਪੁਰ ਕੋ ਬਹੁਰੋ ਮਗੁ ਲੀਨੋ ॥੩੫॥",
      "transliteration": "nij pur ko bahuro mag leeno ||35||",
      "translation": "He married second time and took the way to his village.(35)(1)",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਆਪਣੇ ਨਗਰ ਦਾ ਰਾਹ ਪਕੜਿਆ ॥੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "निजु पुर को बहुरो मगु लीनो ॥३५॥",
      "sourceLineId": "114501",
      "sourceShabadId": "10317",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਪੁਰਖ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਅਠਾਸਠਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੬੮॥੧੨੨੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane purakh charitre ma(n)tree bhoop sa(n)baadhe aThaasaThavo charitr samaapatam sat subham sat ||68||1222||afajoo(n)||",
      "translation": "Sixty-eighth Parable of Auspicious Chritars Conversation of the Raja and the Minister, Completed with Benediction. (68)(1220)",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਪੁਰਖ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੬੮ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੬੮॥੧੨੨੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने पुरख चरित्रे मंत्री भूप संबादे अठासठवो चरित्र समापतम सतु सुभम सतु ॥६८॥१२२२॥अफजूँ॥",
      "sourceLineId": "114502",
      "sourceShabadId": "10317",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "114503",
      "sourceShabadId": "10318",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚਪਲ ਸਿੰਘ ਰਾਜਾ ਬਡੋ ਰਾਜ ਕਲਾ ਤਿਹ ਨਾਰਿ ॥",
      "transliteration": "chapal si(n)gh raajaa baddo raaj kalaa teh naar ||",
      "translation": "There was once a great Raja and Raj Kala was his wife.",
      "punjabiViakhya": "ਚਪਲ ਸਿੰਘ ਨਾ ਦਾ ਇਕ ਵੱਡਾ ਰਾਜਾ ਸੀ ਅਤੇ ਰਾਜ ਕਲਾ (ਨਾ ਦੀ ਉਸ ਦੀ) ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "चपल सिंघ राजा बडो राज कला तिह नारि ॥",
      "sourceLineId": "114504",
      "sourceShabadId": "10318",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਇੰਦ੍ਰ ਦੇਵ ਰੀਝੇ ਰਹੈ ਜਾਨਿ ਸਚੀ ਅਨੁਹਾਰਿ ॥੧॥",
      "transliteration": "ei(n)dhr dhev reejhe rahai jaan sachee anuhaar ||1||",
      "translation": "There was none like her; even, the god Indra fancied her.(l)",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸਚੀ ਵਰਗੀ ਸਮਝ ਕੇ ਇੰਦਰ ਵੀ ਬਹੁਤ ਰੀਝਿਆ ਰਹਿੰਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "इंद्र देव रीझे रहै जानि सची अनुहारि ॥१॥",
      "sourceLineId": "114505",
      "sourceShabadId": "10318",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੋ ਰਾਨੀ ਇਕ ਚੋਰ ਸੋ ਰਮ੍ਯੋ ਕਰਤ ਦਿਨੁ ਰੈਨਿ ॥",
      "transliteration": "so raanee ik chor so ramayo karat dhin rain ||",
      "translation": "That Rani, day in and day out, used to make love with a thief.",
      "punjabiViakhya": "ਉਹ ਰਾਣੀ ਇਕ ਚੋਰ ਨਾਲ ਦਿਨ ਰਾਤ ਰਮਣ ਕਰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "सो रानी इक चोर सो रम्यो करत दिनु रैनि ॥",
      "sourceLineId": "114506",
      "sourceShabadId": "10318",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਾਹਿ ਬੁਲਾਵੈ ਨਿਜੁ ਸਦਨ ਆਪੁ ਜਾਇ ਤਿਹ ਐਨ ॥੨॥",
      "transliteration": "taeh bulaavai nij sadhan aap jai teh aain ||2||",
      "translation": "She used to call him at her house, and, herself, often went to his residence as well.(2)",
      "punjabiViakhya": "ਉਸ ਨੂੰ (ਕਦੇ) ਆਪਣੇ ਘਰ ਬੁਲਾ ਲੈਂਦੀ ਅਤੇ (ਕਦੇ) ਉਸ ਦੇ ਘਰ ਚਲੀ ਜਾਦੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "ताहि बुलावै निजु सदन आपु जाइ तिह ऐन ॥२॥",
      "sourceLineId": "114507",
      "sourceShabadId": "10318",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਆਵਤ ਸਦਨ ਨ੍ਰਿਪ ਬਰ ਲਖਿਯੋ ਬਨਾਇ ॥",
      "transliteration": "ek dhivas aavat sadhan nirap bar lakhiyo banai ||",
      "translation": "One day Raja, when he was proceeding to her house, he saw him.",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਰਾਜੇ ਨੇ (ਚੋਰ ਨੂੰ) ਘਰ ਆਉਾਂਦਿਆਂ ਵੇਖ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "एक दिवस आवत सदन नृप बर लखियो बनाइ ॥",
      "sourceLineId": "114508",
      "sourceShabadId": "10318",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਲੂਟਿ ਕੂਟਿ ਤਸਕਰ ਲਯੋ ਸੂਰੀ ਦਿਯੋ ਚਰਾਇ ॥੩॥",
      "transliteration": "looT kooT tasakar layo sooree dhiyo charai ||3||",
      "translation": "He beat the thief severely and ordered him to be hanged.(3)",
      "punjabiViakhya": "(ਉਸ) ਚੋਰ ਨੂੰ ਮਾਰ ਕੁਟ ਕੇ ਸੂਲੀ ਉਤੇ ਚੜ੍ਰਹਾ ਦਿੱਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "लूटि कूटि तसकर लयो सूरी दियो चराइ ॥३॥",
      "sourceLineId": "114509",
      "sourceShabadId": "10318",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਬ ਸ੍ਰੋਨਤ ਭਭਕੋ ਉਠਤ ਤਬ ਆਖੈ ਖੁਲਿ ਜਾਹਿ ॥",
      "transliteration": "jab sronat bhabhako uThat tab aakhai khul jaeh ||",
      "translation": "Whenever the pain pinched him, he regained awareness.",
      "punjabiViakhya": "ਜਦ (ਉਸ ਦੇ ਅੰਦਰ) ਲਹੂ ਦਾ ਭਭਕਾਰ ਉਠਦਾ (ਅਰਥਾਤ ਉਪਰ ਨੂੰ ਚਲਦਾ) ਤਦ (ਉਸ ਦੀਆਂ) ਅੱਖਾ ਖੁਲ੍ਰਹ ਜਾਦੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "जब स्रोनत भभको उठत तब आखै खुलि जाहि ॥",
      "sourceLineId": "114510",
      "sourceShabadId": "10318",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਬੈ ਸ੍ਵਾਸ ਤਰ ਕੋ ਰਮੈ ਕਛੂ ਰਹੈ ਸੁਧਿ ਨਾਹਿ ॥੪॥",
      "transliteration": "jabai savaiaas tar ko ramai kachhoo rahai sudh naeh ||4||",
      "translation": "But after a few breaths he would become unconscious again.(4)",
      "punjabiViakhya": "ਜਦ ਸੁਆਸ ਹੇਠਾ ਨੂੰ ਚਲਦਾ ਤਾ ਕੁਝ ਸੁੱਧ ਬੁੱਧ ਨਾ ਰਹਿੰਦੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "जबै स्वास तर को रमै कछू रहै सुधि नाहि ॥४॥",
      "sourceLineId": "114511",
      "sourceShabadId": "10318",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "114512",
      "sourceShabadId": "10319",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਾਨੀ ਜਬ ਬਤਿਯਾ ਸੁਨ ਪਾਈ ॥",
      "transliteration": "raanee jab batiyaa sun paiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਣੀ ਨੇ ਇਹ ਗੱਲ ਸੁਣੀ",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "रानी जब बतिया सुन पाई ॥",
      "sourceLineId": "114513",
      "sourceShabadId": "10319",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਸਕਰ ਕੇ ਮਿਲਬੇ ਕਹ ਧਾਈ ॥",
      "transliteration": "tasakar ke milabe keh dhaiee ||",
      "translation": "When the Rani heard this she immediately ran out to see him.",
      "punjabiViakhya": "ਤਾ ਚੋਰ ਨੂੰ ਮਿਲਣ ਲਈ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "तसकर के मिलबे कह धाई ॥",
      "sourceLineId": "114514",
      "sourceShabadId": "10319",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਬ ਸ੍ਰੋਨਤ ਊਰਧ ਤਿਹ ਆਯੋ ॥",
      "transliteration": "jab sronat uooradh teh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਉਸ ਦਾ ਲਹੂ ਉਪਰ ਵਲ ਚਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "जब स्रोनत ऊरध तिह आयो ॥",
      "sourceLineId": "114515",
      "sourceShabadId": "10319",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਛੁਟੀ ਆਖਿ ਦਰਸਨ ਤ੍ਰਿਯੁ ਪਾਯੋ ॥੫॥",
      "transliteration": "chhuTee aakh dharasan tiray paayo ||5||",
      "translation": "When the blood spurted out and h~ regained consciousness, he saw the woman.(5)",
      "punjabiViakhya": "ਤਾ ਉਸ ਦੀ ਅੱਖ ਖੁਲ੍ਰਹੀ ਅਤੇ (ਉਸ ਨੇ) ਇਸਤਰੀ ਦਾ ਦਰਸ਼ਨ ਕੀਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "छुटी आखि दरसन तृयु पायो ॥५॥",
      "sourceLineId": "114516",
      "sourceShabadId": "10319",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਤਿਹ ਬਚਨ ਉਚਾਰੇ ॥",
      "transliteration": "tab raanee teh bachan uchaare ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਨੇ ਉਸ ਪ੍ਰਤਿ ਬਚਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "तब रानी तिह बचन उचारे ॥",
      "sourceLineId": "114517",
      "sourceShabadId": "10319",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੁਨੁ ਤਸਕਰ ਮਮ ਬੈਨ ਪ੍ਯਾਰੇ ॥",
      "transliteration": "sun tasakar mam bain payaare ||",
      "translation": "Then she said, ‘Listen thief, I say it you with love,",
      "punjabiViakhya": "ਹੇ ਪਿਆਰੇ ਚੋਰ! ਮੇਰੀ ਗੱਲ ਸੁਣ।",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "सुनु तसकर मम बैन प्यारे ॥",
      "sourceLineId": "114518",
      "sourceShabadId": "10319",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜੋ ਕਛੁ ਆਗ੍ਯਾ ਦੇਹੁ ਸੁ ਕਰੋ ॥",
      "transliteration": "jo kachh aagayaa dhehu su karo ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ (ਮੈਨੂੰ) ਆਗਿਆ ਦੇਵੇਾਂਗਾ, ਉਹੀ ਮੈ ਕਰਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "जो कछु आग्या देहु सु करो ॥",
      "sourceLineId": "114519",
      "sourceShabadId": "10319",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤੁਮ ਬਿਨ ਮਾਰ ਕਟਾਰੀ ਮਰੋ ॥੬॥",
      "transliteration": "tum bin maar kaTaaree maro ||6||",
      "translation": "‘That I could not live. Without you, I will kill myself.’(6)",
      "punjabiViakhya": "ਤੇਰੇ ਬਿਨਾ ਕਟਾਰ ਮਾਰ ਕੇ ਮਰ ਜਾਵਾਗੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "तुम बिन मार कटारी मरो ॥६॥",
      "sourceLineId": "114520",
      "sourceShabadId": "10319",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਬ ਤਸਕਰ ਯੌ ਬੈਨ ਉਚਾਰੇ ॥",
      "transliteration": "tab tasakar yau bain uchaare ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਚੋਰ ਨੇ ਇਹ ਬਚਨ ਕਹੇ",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "तब तसकर यौ बैन उचारे ॥",
      "sourceLineId": "114521",
      "sourceShabadId": "10319",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਯਹੈ ਹੋਸ ਮਨ ਰਹੀ ਹਮਾਰੇ ॥",
      "transliteration": "yahai hos man rahee hamaare ||",
      "translation": "Then the thief spoke, ‘I have a desire in my heart,",
      "punjabiViakhya": "ਕਿ ਮੇਰੇ ਮਨ ਵਿਚ ਇਹੀ ਹਵਸ ('ਹੋਸ') ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "यहै होस मन रही हमारे ॥",
      "sourceLineId": "114522",
      "sourceShabadId": "10319",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਰਤ ਸਮੈ ਚੁੰਬਨ ਤਵ ਕਰੋ ॥",
      "transliteration": "marat samai chu(n)ban tav karo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮਰਨ ਵੇਲੇ ਤੇਰਾ ਚੁੰਮਣ ਲਵਾ,",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "मरत समै चुँबन तव करो ॥",
      "sourceLineId": "114523",
      "sourceShabadId": "10319",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਹੁਰੋ ਯਾ ਸੂਰੀ ਪਰ ਮਰੋ ॥੭॥",
      "transliteration": "bahuro yaa sooree par maro ||7||",
      "translation": "‘That I may kiss you and then go up for hanging.’(7)",
      "punjabiViakhya": "ਫਿਰ ਇਸ ਸੂਲੀ ਉਤੇ ਚੜ੍ਰਹ ਕੇ ਮਰਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "बहुरो या सूरी पर मरो ॥७॥",
      "sourceLineId": "114524",
      "sourceShabadId": "10319",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਬ ਰਾਨੀ ਚੁੰਬਨ ਤਿਹ ਦੀਨੋ ॥",
      "transliteration": "jab raanee chu(n)ban teh dheeno ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਣੀ ਨੇ ਉਸ ਨੂੰ ਚੁੰਬਣ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "जब रानी चुँबन तिह दीनो ॥",
      "sourceLineId": "114525",
      "sourceShabadId": "10319",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸ੍ਰੋਨ ਭਭਾਕੈ ਤਸਕਰ ਕੀਨੋ ॥",
      "transliteration": "sron bhabhaakai tasakar keeno ||",
      "translation": "When Rani kissed him, a stream of blood gushed out of the nose.",
      "punjabiViakhya": "(ਤਾ) ਚੋਰ ਨੇ ਲਹੂ ਦਾ ਭਭਾਕਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "स्रोन भभाकै तसकर कीनो ॥",
      "sourceLineId": "114526",
      "sourceShabadId": "10319",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਬ ਤਸਕਰ ਕੋ ਮੁਖਿ ਜੁਰਿ ਗਯੋ ॥",
      "transliteration": "tab tasakar ko mukh jur gayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਚੋਰ ਦਾ ਮੂੰਹ ਜੁੜ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "तब तसकर को मुखि जुरि गयो ॥",
      "sourceLineId": "114527",
      "sourceShabadId": "10319",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਾਕ ਕਾਟ ਰਾਨੀ ਕੋ ਲਯੋ ॥੮॥",
      "transliteration": "naak kaaT raanee ko layo ||8||",
      "translation": "The thief’s mouth shut (with force) and the Rani’s nose was cut.(8)",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਦਾ ਨਕ ਕਟ ਲਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "नाक काट रानी को लयो ॥८॥",
      "sourceLineId": "114528",
      "sourceShabadId": "10319",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "114529",
      "sourceShabadId": "10320",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਬ ਤਸਕਰ ਚੁੰਬਨ ਕਰਿਯੋ ਪ੍ਰਾਨ ਤਜੇ ਤਤਕਾਲ ॥",
      "transliteration": "jab tasakar chu(n)ban kariyo praan taje tatakaal ||",
      "translation": "Immediately after taking the kiss, his soul departed for heavens.",
      "punjabiViakhya": "ਜਦ ਚੋਰ ਨੇ ਚੁੰਬਣ ਲਿਆ ਤਾ ਉਸੇ ਵੇਲੇ ਪ੍ਰਾਣ ਵੀ ਤਿਆਗ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "जब तसकर चुँबन करियो प्रान तजे ततकाल ॥",
      "sourceLineId": "114530",
      "sourceShabadId": "10320",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਕ ਕਟਿਯੋ ਮੁਖ ਮੈ ਰਹਿਯੋ ਰਾਨੀ ਭਈ ਬਿਹਾਲ ॥੯॥",
      "transliteration": "naak kaTiyo mukh mai rahiyo raanee bhiee bihaal ||9||",
      "translation": "The cut (piece) of the (Rani’s) nose remained in his mouth, and the Rani became desperate.(9)",
      "punjabiViakhya": "(ਰਾਣੀ ਦਾ) ਕਟਿਆ ਹੋਇਆ ਨਕ ਉਸ ਦੇ ਮੂੰਹ ਵਿਚ ਹੀ ਰਿਹਾ ਅਤੇ ਰਾਣੀ ਬੇਹਾਲ ਹੋ ਗਈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "नाक कटियो मुख मै रहियो रानी भई बिहाल ॥९॥",
      "sourceLineId": "114531",
      "sourceShabadId": "10320",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "114532",
      "sourceShabadId": "10321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਾਕ ਕਟਾਇ ਤ੍ਰਿਯਾ ਘਰ ਆਈ ॥",
      "transliteration": "naak kaTai tirayaa ghar aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਨਕ ਕਟਵਾ ਕੇ ਰਾਣੀ ਘਰ ਆ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "नाक कटाइ तृया घर आई ॥",
      "sourceLineId": "114533",
      "sourceShabadId": "10321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜੋਰਿ ਨ੍ਰਿਪਤਿ ਕੋ ਬਾਤ ਸੁਨਾਈ ॥",
      "transliteration": "jor nirapat ko baat sunaiee ||",
      "translation": "With the nose cut, the woman came home.",
      "punjabiViakhya": "ਅਤੇ ਗੱਲ ਬਣਾ ਕੇ ਰਾਜੇ ਨੂੰ ਦਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "जोरि नृपति को बात सुनाई ॥",
      "sourceLineId": "114534",
      "sourceShabadId": "10321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਾਟ ਨਾਕ ਸਿਵ ਭੋਜਨ ਚਰਾਯੋ ॥",
      "transliteration": "kaaT naak siv bhojan charaayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮੈਂ ਨਕ ਕਟ ਕੇ ਸ਼ਿਵ ਨੂੰ ਭੋਜਨ (ਦੇ ਰੂਪ ਵਿਚ) ਚੜ੍ਰਹਾਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "काट नाक सिव भोजन चरायो ॥",
      "sourceLineId": "114535",
      "sourceShabadId": "10321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੋ ਨਹਿ ਲਗ੍ਯੋ ਰੁਦ੍ਰ ਯੌ ਭਾਯੋ ॥੧੦॥",
      "transliteration": "so neh lagayo rudhr yau bhaayo ||10||",
      "translation": "She told the Raja that, ‘I cut my nose to present to (Lord) Shiva, because it pleased (Lord) Shiva immensely.’",
      "punjabiViakhya": "ਉਹ ਸ਼ਿਵ ਨੂੰ ਚੰਗੀ ਨਹੀਂ ਲਗੀ ਹੈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "सो नहि लग्यो रुद्र यौ भायो ॥१०॥",
      "sourceLineId": "114536",
      "sourceShabadId": "10321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪੁਨ ਸਿਵਜੂ ਯੌ ਬਚਨ ਉਚਾਰੋ ॥",
      "transliteration": "pun sivajoo yau bachan uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਸ਼ਿਵ ਨੇ ਇਹ ਬਚਨ ਕਹੇ",
      "source": "DASAM_GRANTH",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": "पुन सिवजू यौ बचन उचारो ॥",
      "sourceLineId": "114537",
      "sourceShabadId": "10321",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0894_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚੋਰ ਬਕ੍ਰ ਮੈ ਨਾਕ ਤਿਹਾਰੋ ॥",
