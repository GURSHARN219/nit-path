{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 914,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0914_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਹਾਰਾਸਟ੍ਰ ਪਤਿ ਨਗਰ ਮੈ ਗਯੋ ਅਥਿਤ ਕੇ ਭੇਸ ॥੩॥",
      "transliteration": "mahaaraasaTr pat nagar mai gayo athit ke bhes ||3||",
      "translation": "He came to Maharashtra disguised as a mendicant.(3)",
      "punjabiViakhya": "ਮਹਾਰਾਸ਼ਟਰ ਪਤੀ ਦੇ ਨਗਰ ਵਿਚ ਜੋਗੀ ('ਅਥਿਤ') ਦੇ ਭੇਸ ਵਿਚ ਗਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "महारासट्र पति नगर मै गयो अथित के भेस ॥३॥",
      "sourceLineId": "115523",
      "sourceShabadId": "10500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "115524",
      "sourceShabadId": "10501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਬ ਰਾਨੀ ਤਿਹ ਓਰ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "jab raanee teh or nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਣੀ ਨੇ ਉਸ ਵਲ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "जब रानी तिह ओर निहारियो ॥",
      "sourceLineId": "115525",
      "sourceShabadId": "10501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਯਹੈ ਆਪਨੇ ਹ੍ਰਿਦੈ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "yahai aapane hiradhai bichaariyo ||",
      "translation": "When the Rani saw him, she contemplated in her mind,",
      "punjabiViakhya": "ਤਾ ਆਪਣੇ ਮਨ ਵਿਚ ਵਿਚਾਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "यहै आपने हृदै बिचारियो ॥",
      "sourceLineId": "115526",
      "sourceShabadId": "10501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜੋਗਿਨ ਯਹ ਰਾਜਾ ਸੋ ਲਹਿਯੈ ॥",
      "transliteration": "jogin yeh raajaa so lahiyai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਰਾਜੇ ਤੋਂ ਇਹ ਜੋਗੀ ਲੈ ਲੈਣਾ ਚਾਹੀਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "जोगिन यह राजा सो लहियै ॥",
      "sourceLineId": "115527",
      "sourceShabadId": "10501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭੇਜਿ ਮਾਨੁਖਨ ਯਾ ਕੌ ਗਹਿਯੈ ॥੪॥",
      "transliteration": "bhej maanukhan yaa kau gahiyai ||4||",
      "translation": "That she would ask Raja to fetch the mendicant.(4)",
      "punjabiViakhya": "ਅਤੇ ਬੰਦੇ ਭੇਜ ਕੇ ਇਸ ਨੂੰ ਪਕੜਵਾ ਲੈਣਾ ਚਾਹੀਦਾ ਹੈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "भेजि मानुखन या कौ गहियै ॥४॥",
      "sourceLineId": "115528",
      "sourceShabadId": "10501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "115529",
      "sourceShabadId": "10502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭੇਜਿ ਮਾਨੁਖਨ ਗਹਿ ਲਯੋ ਲੀਨੋ ਧਾਮ ਬੁਲਾਇ ॥",
      "transliteration": "bhej maanukhan geh layo leeno dhaam bulai ||",
      "translation": "She sent some people to catch him and bring him to her house.",
      "punjabiViakhya": "ਬੰਦਿਆਂ ਨੂੰ ਭੇਜ ਕੇ (ਉਸ ਨੂੰ) ਪਕੜਵਾ ਲਿਆ ਅਤੇ ਘਰ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "भेजि मानुखन गहि लयो लीनो धाम बुलाइ ॥",
      "sourceLineId": "115530",
      "sourceShabadId": "10502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੁਹਿਤਾ ਦਈ ਬਿਵਾਹਿ ਕੈ ਜਾਨਿ ਦੇਸ ਕੌ ਰਾਇ ॥੫॥",
      "transliteration": "dhuhitaa dhiee bivaeh kai jaan dhes kau rai ||5||",
      "translation": "Considering him as the Raja of a country she (decided) to marry her daughter to him.(5)",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) (ਕਿਸੇ) ਦੇਸ ਦਾ ਰਾਜਾ ਸਮਝ ਕੇ ਆਪਣੀ ਲੜਕੀ ਵਿਆਹ ਦਿੱਤੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "दुहिता दई बिवाहि कै जानि देस कौ राइ ॥५॥",
      "sourceLineId": "115531",
      "sourceShabadId": "10502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਚਨ ਸੁਨਤ ਨ੍ਰਿਪ ਰਿਸਿ ਭਰਿਯੋ ਛੋਡਿ ਰਾਮ ਕੋ ਜਾਪ ॥",
      "transliteration": "bachan sunat nirap ris bhariyo chhodd raam ko jaap ||",
      "translation": "On learning this, the Raja abandoned the meditation of Rama,",
      "punjabiViakhya": "ਇਹ ਗੱਲ ਸੁਣ ਕੇ ਰਾਜਾ ਰਾਮ ਨਾਮ ਦਾ ਜਾਪ ਛਡ ਕੇ ਕ੍ਰੋਧ ਨਾਲ ਭਰ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "बचन सुनत नृप रिसि भरियो छोडि राम को जाप ॥",
      "sourceLineId": "115532",
      "sourceShabadId": "10502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦੁਹਿਤਾ ਦਈ ਬਿਵਾਹਿ ਤਿਹ ਜਾ ਕੈ ਮਾਇ ਨ ਬਾਪ ॥੬॥",
      "transliteration": "dhuhitaa dhiee bivaeh teh jaa kai mai na baap ||6||",
      "translation": "And flew into a rage, why had she married the daughter to the man who has no father or mother.(6)",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿਣ ਲਗਾ ਕਿ ਉਸ ਨੂੰ) ਲੜਕੀ ਵਿਆਹ ਦਿੱਤੀ ਹੈ ਜਿਸ ਦੀ ਨਾ ਕੋਈ ਮਾ ਹੈ ਅਤੇ ਨਾ ਪਿਓ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "दुहिता दई बिवाहि तिह जा कै माइ न बाप ॥६॥",
      "sourceLineId": "115533",
      "sourceShabadId": "10502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਾਜਾ ਬਾਚ ॥",
      "transliteration": "raajaa baach ||",
      "translation": "Raja’s Talk",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "राजा बाच ॥",
      "sourceLineId": "115534",
      "sourceShabadId": "10503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "115535",
      "sourceShabadId": "10503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਾਇ ਨ ਬਾਪ ਜਾਨਿਯਤ ਜਾ ਕੌ ॥",
      "transliteration": "mai na baap jaaniyat jaa kau ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਮਾ ਪਿਓ ਦਾ ਪਤਾ ਨਹੀਂ,",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "माइ न बाप जानियत जा कौ ॥",
      "sourceLineId": "115536",
      "sourceShabadId": "10503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੁਹਿਤਾ ਕਹੂ ਦੀਜਿਯਤ ਤਾ ਕੌ ॥",
      "transliteration": "dhuhitaa kahoo dheejiyat taa kau ||",
      "translation": "‘Who has no father or mother, why did she marry the daughter to him?",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਕਿਸ ਲਈ ਆਪਣੀ ਲੜਕੀ ਵਿਆਹ ਰਹੀ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "दुहिता कहू दीजियत ता कौ ॥",
      "sourceLineId": "115537",
      "sourceShabadId": "10503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਯਾ ਕੌ ਅਬੈ ਬਾਧਿ ਕਰਿ ਮਾਰੋ ॥",
      "transliteration": "yaa kau abai baadh kar maaro ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ (ਜੋਗੀ) ਨੂੰ ਹੁਣ ਬੰਨ੍ਰਹ ਕੇ ਮਾਰ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "या कौ अबै बाधि करि मारो ॥",
      "sourceLineId": "115538",
      "sourceShabadId": "10503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਾਨੀ ਦੁਹਤਾ ਸਹਿਤ ਸੰਘਾਰੋ ॥੭॥",
      "transliteration": "raanee dhuhataa sahit sa(n)ghaaro ||7||",
      "translation": "‘Now tie him, kill him and also terminate the Rani and the daughter.’(7)",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਨੂੰ ਲੜਕੀ ਸਹਿਤ ਖ਼ਤਮ ਕਰ ਦਿਓ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "रानी दुहता सहित संघारो ॥७॥",
      "sourceLineId": "115539",
      "sourceShabadId": "10503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰਾਨੀ ਬਚਨ ਸੁਨਤ ਡਰਿ ਗਈ ॥",
      "transliteration": "raanee bachan sunat ddar giee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਇਹ ਬੋਲ ਸੁਣ ਕੇ ਡਰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "रानी बचन सुनत डरि गई ॥",
      "sourceLineId": "115540",
      "sourceShabadId": "10503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚੀਨਤ ਕਛੂ ਉਪਾਇ ਨ ਭਈ ॥",
      "transliteration": "cheenat kachhoo upai na bhiee ||",
      "translation": "She was dreaded hearing the order and she could think nothing more",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਕੋਈ ਉਪਾ ਸੁਝ ਨਹੀਂ ਸੀ ਰਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "चीनत कछू उपाइ न भई ॥",
      "sourceLineId": "115541",
      "sourceShabadId": "10503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਾ ਤੇ ਜਾਮਾਤਾ ਨਹਿ ਮਰਿਯੈ ॥",
      "transliteration": "jaa te jaamaataa neh mariyai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ (ਉਪਾ) ਨਾਲ ਜਵਾਈ ਨੂੰ ਨਾ ਮਾਰਿਆ ਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "जा ते जामाता नहि मरियै ॥",
      "sourceLineId": "115542",
      "sourceShabadId": "10503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੁਤਾ ਸਹਿਤ ਇਹ ਜਿਯਤ ਨਿਕਰਿਯੈ ॥੮॥",
      "transliteration": "sutaa sahit ieh jiyat nikariyai ||8||",
      "translation": "Than the means to save the son-in-law from death, and contemplated an escape for him and her daughter.(8)",
      "punjabiViakhya": "ਅਤੇ ਲੜਕੀ ਸਮੇਤ ਇਹ ਜੀਉਾਂਦਾ ਨਿਕਲ ਜਾਏ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "सुता सहित इह जियत निकरियै ॥८॥",
      "sourceLineId": "115543",
      "sourceShabadId": "10503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰਾਨੀ ਏਕ ਮੰਗਾਇ ਪਿਟਾਰੋ ॥",
      "transliteration": "raanee ek ma(n)gai piTaaro ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਇਕ ਪਿਟਾਰਾ ਮੰਗਵਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "रानी एक मंगाइ पिटारो ॥",
      "sourceLineId": "115544",
      "sourceShabadId": "10503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦੁਹੂੰਅਨ ਦੁਹੂੰ ਕਨਾਰੇ ਡਾਰੋ ॥",
      "transliteration": "dhuhoo(n)an dhuhoo(n) kanaare ddaaro ||",
      "translation": "She brought a big basket and asked them both to sit in there.",
      "punjabiViakhya": "ਅਤੇ ਦੋਹਾ ਨੂੰ ਦੋਹਾ ਸਿਰਿਆਂ ਉਤੇ ਬਿਠਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "दुहूँअन दुहूँ कनारे डारो ॥",
      "sourceLineId": "115545",
      "sourceShabadId": "10503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਏਕ ਪਿਟਾਰੋ ਔਰ ਮੰਗਾਯੋ ॥",
      "transliteration": "ek piTaaro aauar ma(n)gaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਪਿਟਾਰਾ ਹੋਰ ਮੰਗਵਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "एक पिटारो और मंगायो ॥",
      "sourceLineId": "115546",
      "sourceShabadId": "10503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਵਹ ਪਿਟਾਰ ਤਿਹ ਭੀਤਰ ਪਾਯੋ ॥੯॥",
      "transliteration": "veh piTaar teh bheetar paayo ||9||",
      "translation": "Then, she brought another large basket and placed the first one inside it.(9)",
      "punjabiViakhya": "ਅਤੇ ਉਹ ਪਿਟਾਰਾ ਉਸ ਪਿਟਾਰੇ ਵਿਚ ਰਖਵਾ ਦਿੱਤਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "वह पिटार तिह भीतर पायो ॥९॥",
      "sourceLineId": "115547",
      "sourceShabadId": "10503",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "115548",
      "sourceShabadId": "10504",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅੰਤਰ ਹੂੰ ਕੇ ਪਿਟਾਰ ਮੈ ਡਾਰੇ ਰਤਨ ਅਪਾਰ ॥",
      "transliteration": "a(n)tar hoo(n) ke piTaar mai ddaare ratan apaar ||",
      "translation": "In the first inner basket, she put lot of precious stones,",
      "punjabiViakhya": "ਅੰਦਰਲੇ ਪਿਟਾਰੇ ਵਿਚ ਬਹੁਤ ਸਾਰੇ ਰਤਨ ਪਾ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "अंतर हूँ के पिटार मै डारे रतन अपार ॥",
      "sourceLineId": "115549",
      "sourceShabadId": "10504",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਿਹ ਢਕਨੌ ਦੈ ਦੁਤਿਯ ਮੈ ਦਈ ਮਿਠਾਈ ਡਾਰਿ ॥੧੦॥",
      "transliteration": "teh ddakanau dhai dhutiy mai dhiee miThaiee ddaar ||10||",
      "translation": "And in the second one she placed a great number of sweetmeats.(l0)",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਢਕਣਾ ਦੇ ਕੇ ਦੂਜੇ ਵਿਚ ਮਠਿਆਈ ਪਾ ਦਿੱਤੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "तिह ढकनौ दै दुतिय मै दई मिठाई डारि ॥१०॥",
      "sourceLineId": "115550",
      "sourceShabadId": "10504",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "115551",
      "sourceShabadId": "10505",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦੁਤਿਯ ਪਿਟਾਰ ਮਿਠਾਈ ਡਾਰੀ ॥",
      "transliteration": "dhutiy piTaar miThaiee ddaaree ||",
      "translation": "",
      "punjabiViakhya": "ਦੂਜੇ ਪਿਟਾਰੇ ਵਿਚ ਮਠਿਆਈ ਪਾ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "दुतिय पिटार मिठाई डारी ॥",
      "sourceLineId": "115552",
      "sourceShabadId": "10505",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਵਹ ਪਿਟਾਰ ਨਹਿ ਦੇਤ ਦਿਖਾਰੀ ॥",
      "transliteration": "veh piTaar neh dhet dhikhaaree ||",
      "translation": "‘The second basket in which she had put sweetmeats, nothing else was visible.",
      "punjabiViakhya": "(ਜਿਸ ਕਰ ਕੇ) ਉਹ (ਅੰਦਰਲਾ) ਪਿਟਾਰਾ ਵਿਖਾਈ ਨਹੀਂ ਦਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "वह पिटार नहि देत दिखारी ॥",
      "sourceLineId": "115553",
      "sourceShabadId": "10505",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਭ ਕੋ ਦ੍ਰਿਸਟਿ ਸਿਰੀਨੀ ਆਵੈ ॥",
      "transliteration": "sabh ko dhirasaT sireenee aavai ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਮਠਿਆਈ ਹੀ ਨਜ਼ਰ ਆਉਾਂਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "सभ को दृसटि सिरीनी आवै ॥",
      "sourceLineId": "115554",
      "sourceShabadId": "10505",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਾ ਕੋ ਭੇਦ ਨ ਕੋਉ ਪਾਵੈ ॥੧੧॥",
      "transliteration": "taa ko bhedh na koau paavai ||11||",
      "translation": "Every body thought it was full of sweetmeats and no body knew the secret.(11)",
      "punjabiViakhya": "ਉਸ ਦੇ ਭੇਦ ਨੂੰ ਕੋਈ ਨਾ ਸਮਝ ਸਕਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "ता को भेद न कोउ पावै ॥११॥",
      "sourceLineId": "115555",
      "sourceShabadId": "10505",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪਠੇ ਚੇਰਿ ਯਹ ਨ੍ਰਿਪਤਿ ਬੁਲਾਯੋ ॥",
      "transliteration": "paThe cher yeh nirapat bulaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਰਾਣੀ) ਨੇ ਦਾਸੀ ਭੇਜ ਕੇ ਰਾਜੇ ਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "पठे चेरि यह नृपति बुलायो ॥",
      "sourceLineId": "115556",
      "sourceShabadId": "10505",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗਹਿ ਬਹਿਯਾ ਸਭ ਸਦਨ ਦਿਖਾਯੋ ॥",
      "transliteration": "geh bahiyaa sabh sadhan dhikhaayo ||",
      "translation": "Now she sent a maid to call Raja. Leading him, she took him around the whole household (and said),",
      "punjabiViakhya": "ਅਤੇ ਬਾਹ ਪਕੜ ਕੇ ਸਾਰਾ ਮਹੱਲ ਵਿਖਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "गहि बहिया सभ सदन दिखायो ॥",
      "sourceLineId": "115557",
      "sourceShabadId": "10505",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹਮ ਕਾ ਤੁਮ ਤੇ ਨੈਕ ਨ ਡਰਿ ਹੈ ॥",
      "transliteration": "ham kaa tum te naik na ddar hai ||",
      "translation": "",
      "punjabiViakhya": "ਕੀ ਸਾਨੂੰ ਤੁਹਾਡਾ ਜ਼ਰਾ ਜਿੰਨਾ ਵੀ ਡਰ ਨਹੀਂ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "हम का तुम ते नैक न डरि है ॥",
      "sourceLineId": "115558",
      "sourceShabadId": "10505",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਿਨੁ ਤਵ ਕਹੇ ਸਗਾਈ ਕਰਿ ਹੈ ॥੧੨॥",
      "transliteration": "bin tav kahe sagaiee kar hai ||12||",
      "translation": "‘Aren’t we afraid of you? How could we arrange their engagement without your consent?’(12)",
      "punjabiViakhya": "ਕਿ ਤੁਹਾਡੇ ਕਹੇ ਬਿਨਾ (ਅਸੀਂ) ਮੰਗਣੀ ਕਰ ਦਿੱਤੀ ਹੈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "बिनु तव कहे सगाई करि है ॥१२॥",
      "sourceLineId": "115559",
      "sourceShabadId": "10505",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਾਨੀ ਬਾਚ ॥",
      "transliteration": "raanee baach ||",
      "translation": "Rani Talk",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "रानी बाच ॥",
      "sourceLineId": "115560",
      "sourceShabadId": "10506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "115561",
      "sourceShabadId": "10506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚਿਤ ਕੋ ਸੋਕ ਨਿਵਾਰਿ ਕੈ ਰਾਵ ਕਚਹਿਰੀ ਜਾਹੁ ॥",
      "transliteration": "chit ko sok nivaar kai raav kachahiree jaahu ||",
      "translation": "‘Now, Oh my Raja, dislodge all the doubts from your mind and go to the Court.",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਮਨ ਦਾ ਦੁਖ ਦੂਰ ਕਰ ਕੇ ਕਚਹਿਰੀ (ਦਰਬਾਰ) ਵਿਚ ਜਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "चित को सोक निवारि कै राव कचहिरी जाहु ॥",
      "sourceLineId": "115562",
      "sourceShabadId": "10506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਵ ਹਿਤ ਧਰੀ ਬਨਾਇ ਕੈ ਚਲਹੁ ਮਿਠਾਈ ਖਾਹੁ ॥੧੩॥",
      "transliteration": "tav hit dharee banai kai chalahu miThaiee khaahu ||13||",
      "translation": "‘I have prepared sweetmeats for you, come and relish some.’(13)",
      "punjabiViakhya": "(ਮੈਂ) ਤੁਹਾਡੇ ਲਈ ਮਠਿਆਈ ਬਣਾਈ ਹੈ, ਚਲ ਕੇ ਉਸ ਨੂੰ ਖਾਓ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "तव हित धरी बनाइ कै चलहु मिठाई खाहु ॥१३॥",
      "sourceLineId": "115563",
      "sourceShabadId": "10506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "115564",
      "sourceShabadId": "10507",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਛੋਰਿ ਪਿਟਾਰਿ ਪਕਵਾਨ ਖਵਾਯੋ ॥",
      "transliteration": "chhor piTaar pakavaan khavaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਪਿਟਾਰਾ ਖੋਲ ਕੇ ਪਕਵਾਨ (ਮਠਿਆਈ) ਖਵਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "छोरि पिटारि पकवान खवायो ॥",
      "sourceLineId": "115565",
      "sourceShabadId": "10507",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਵਹ ਕਛੁ ਭੇਦ ਰਾਇ ਨਹਿ ਪਾਯੋ ॥",
      "transliteration": "veh kachh bhedh rai neh paayo ||",
      "translation": "After opening the basket she served him viands but he could not comprehend the secret.",
      "punjabiViakhya": "ਉਸ ਦੇ ਭੇਦ ਨੂੰ ਰਾਜੇ ਨੇ ਕੁਝ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "वह कछु भेद राइ नहि पायो ॥",
      "sourceLineId": "115566",
      "sourceShabadId": "10507",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪੁਨਿ ਇਹ ਕਹਿਯੋ ਦਾਨ ਕਰਿ ਦੀਜੈ ॥",
      "transliteration": "pun ieh kahiyo dhaan kar dheejai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ) ਫਿਰ ਇਹ ਕਿਹਾ, ਹੇ ਰਾਜਨ!",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "पुनि इह कहियो दान करि दीजै ॥",
      "sourceLineId": "115567",
      "sourceShabadId": "10507",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮੇਰੋ ਕਹਿਯੋ ਮਾਨ ਨ੍ਰਿਪ ਲੀਜੈ ॥੧੪॥",
      "transliteration": "mero kahiyo maan nirap leejai ||14||",
      "translation": "‘Now, my Raja, acquiescing to my request, you give out this with blessings.’(14)",
      "punjabiViakhya": "ਮੇਰਾ ਕਿਹਾ ਮੰਨ ਕੇ ਇਸ (ਮਠਿਆਈ) ਨੂੰ ਦਾਨ ਕਰ ਦਿਓ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "मेरो कहियो मान नृप लीजै ॥१४॥",
      "sourceLineId": "115568",
      "sourceShabadId": "10507",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਬ ਪਿਟਾਰ ਤਿਹ ਛੋਰਿ ਦਿਖਾਯੋ ॥",
      "transliteration": "jab piTaar teh chhor dhikhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਨੇ ਪਿਟਾਰਾ ਖੋਲ ਕੇ ਦਿਖਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "जब पिटार तिह छोरि दिखायो ॥",
      "sourceLineId": "115569",
      "sourceShabadId": "10507",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0914_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਤਿ ਡਰ ਜਾਮਾਤਾ ਮਨ ਆਯੋ ॥",
      "transliteration": "at ddar jaamaataa man aayo ||",
      "translation": "When she opened the basket, the son-in-law was terrified,",
      "punjabiViakhya": "ਤਾ ਜਵਾਈ ਦੇ ਮਨ ਵਿਚ ਬਹੁਤ ਡਰ ਪੈਦਾ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": "अति डर जामाता मन आयो ॥",
      "sourceLineId": "115570",
      "sourceShabadId": "10507",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
