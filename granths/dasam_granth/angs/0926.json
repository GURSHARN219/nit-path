{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 926,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0926_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭਲਾ ਭਯੋ ਯੌ ਮੂੜ ਪੁਕਾਰਿਯੋ ॥",
      "transliteration": "bhalaa bhayo yau mooR pukaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਗਾ ਹੋਇਆ ਉਸ ਮੂਰਖ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "भला भयो यौ मूड़ पुकारियो ॥",
      "sourceLineId": "116147",
      "sourceShabadId": "10593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਾਹਿ ਸੁਨ੍ਯੋ ਤਾਹੀ ਗਹਿ ਮਾਰਿਯੋ ॥੧੨॥",
      "transliteration": "jaeh sunayo taahee geh maariyo ||12||",
      "translation": "The fool said, “It is God’s blessing”, and when the people heart this they beat him up.(12)",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਸੁਣਿਆ, ਉਸੇ ਨੇ ਪਕੜ ਕੇ ਕੁਟਾਪਾ ਚੜ੍ਰਹਾ ਦਿੱਤਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "जाहि सुन्यो ताही गहि मारियो ॥१२॥",
      "sourceLineId": "116148",
      "sourceShabadId": "10593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "116149",
      "sourceShabadId": "10594",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦਸ ਹਜਾਰ ਪਨਹੀਨ ਕੀ ਸਹੀ ਜੁਲਾਹੇ ਮਾਰਿ ॥",
      "transliteration": "dhas hajaar panaheen kee sahee julaahe maar ||",
      "translation": "After getting the beating of more than ten thousand shoes,",
      "punjabiViakhya": "ਦਸ ਹਜ਼ਾਰ ਜੁਤੀਆਂ ਦੀ ਮਾਰ ਜੁਲਾਹੇ ਨੇ ਖਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "दस हजार पनहीन की सही जुलाहे मारि ॥",
      "sourceLineId": "116150",
      "sourceShabadId": "10594",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਾ ਪਾਛੈ ਪਹੁਚਤ ਭਯੋ ਜਹਾ ਹੁਤੀ ਸਸੁਰਾਰਿ ॥੧੩॥",
      "transliteration": "taa paachhai pahuchat bhayo jahaa hutee sasuraar ||13||",
      "translation": "The weaver reached the house of his in-laws.(13)",
      "punjabiViakhya": "ਇਸ ਪਿਛੋਂ ਉਥੇ ਜਾ ਪਹੁੰਚਿਆ ਜਿਥੇ ਉਸ ਦਾ ਸੌਹਰਾ ਘਰ ਸੀ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "ता पाछै पहुचत भयो जहा हुती ससुरारि ॥१३॥",
      "sourceLineId": "116151",
      "sourceShabadId": "10594",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116152",
      "sourceShabadId": "10595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗ੍ਰਿਹ ਜਨ ਕਹਾ ਖਾਹੁ ਨਹਿ ਖਾਵੈ ॥",
      "transliteration": "gireh jan kahaa khaahu neh khaavai ||",
      "translation": "",
      "punjabiViakhya": "ਘਰ ਵਾਲਿਆਂ ਨੇ ਕਿਹਾ ਕਿ ਖਾਣਾ ਖਾਓ, ਪਰ (ਉਸ ਨੇ) ਨਾ ਖਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "गृह जन कहा खाहु नहि खावै ॥",
      "sourceLineId": "116153",
      "sourceShabadId": "10595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭੂਖਨ ਮਰਤ ਨ ਲਜਤ ਬਤਾਵੈ ॥",
      "transliteration": "bhookhan marat na lajat bataavai ||",
      "translation": "‘The house people offered him food but he did not eat and went to sleep empty stomach.",
      "punjabiViakhya": "ਭੁਖਾ ਮਰਦਾ ਰਿਹਾ ਪਰ ਸ਼ਰਮ ਦੇ ਮਾਰੇ ਨੇ ਨਾ ਦਸਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "भूखन मरत न लजत बतावै ॥",
      "sourceLineId": "116154",
      "sourceShabadId": "10595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਆਧੀ ਰੈਨਿ ਬੀਤ ਜਬ ਗਈ ॥",
      "transliteration": "aadhee rain beet jab giee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਅੱਧੀ ਰਾਤ ਬੀਤ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "आधी रैनि बीत जब गई ॥",
      "sourceLineId": "116155",
      "sourceShabadId": "10595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਲਾਗਤੁ ਅਧਿਕ ਛੁਧਾ ਤਿਹ ਭਈ ॥੧੪॥",
      "transliteration": "laagat adhik chhudhaa teh bhiee ||14||",
      "translation": "When half the night had passed, the hunger tormented him.(l4)",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੂੰ ਅਧਿਕ ਭੁਖ ਲਗੀ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "लागतु अधिक छुधा तिह भई ॥१४॥",
      "sourceLineId": "116156",
      "sourceShabadId": "10595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਲਕਰੀ ਭਏ ਤੇਲ ਘਟ ਫੋਰਿਯੋ ॥",
      "transliteration": "lakaree bhe tel ghaT foriyo ||",
      "translation": "",
      "punjabiViakhya": "ਲਕੜੀ ਲੈ ਕੇ ਤੇਲ ਦੇ ਘੜੇ ਨੂੰ ਤੋੜ ਦਿੱਤਾ (ਭਾਵ ਮੋਰੀ ਕਰ ਲਈ)",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "लकरी भए तेल घट फोरियो ॥",
      "sourceLineId": "116157",
      "sourceShabadId": "10595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪੀਨੋ ਸਕਲ ਨੈਕ ਨਹਿ ਛੋਰਿਯੋ ॥",
      "transliteration": "peeno sakal naik neh chhoriyo ||",
      "translation": "Bolding a stick he broke the pitcher and drank all the water.",
      "punjabiViakhya": "ਸਾਰਾ (ਤੇਲ) ਪੀ ਲਿਆ, ਜ਼ਰਾ ਜਿੰਨਾ ਵੀ ਨਾ ਛਡਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "पीनो सकल नैक नहि छोरियो ॥",
      "sourceLineId": "116158",
      "sourceShabadId": "10595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੂਰਜ ਚੜਿਯੋ ਉਡਗ ਛਪਿ ਗਏ ॥",
      "transliteration": "sooraj chaRiyo uddag chhap ge ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਜ ਚੜ੍ਰਹਿਆ ਅਤੇ ਤਾਰੇ ਛਿਪ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "सूरज चड़ियो उडग छपि गए ॥",
      "sourceLineId": "116159",
      "sourceShabadId": "10595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਫਾੱਸਿ ਪਾਨ ਸੋ ਕਊਆ ਲਏ ॥੧੫॥",
      "transliteration": "faa's paan so kuooaa le ||15||",
      "translation": "The Sun rose, the stars went away and he took in his hands the weavers’ wefts.(15)",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਹੱਥ ਵਿਚ ਤਾਣੀ ('ਫਾਸਿ') ਦੇ ਕਾਨੇ ਲੈ ਲਏ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "फास्सि पान सो कऊआ लए ॥१५॥",
      "sourceLineId": "116160",
      "sourceShabadId": "10595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "116161",
      "sourceShabadId": "10596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਾਨੀ ਬੇਚਿ ਕ੍ਰਿਪਾਨ ਲੀ ਚਲਿਯੋ ਚਾਕਰੀ ਧਾਇ ॥",
      "transliteration": "taanee bech kirapaan lee chaliyo chaakaree dhai ||",
      "translation": "Be bartered the wefts, acquired a sword and marched again.",
      "punjabiViakhya": "ਤਾਣੀ ਵੇਚ ਕੇ ਕ੍ਰਿਪਾਨ ਲੈ ਲਈ ਅਤੇ ਨੌਕਰੀ ਲਈ ਜਲਦੀ ਜਲਦੀ ਚਲ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "तानी बेचि कृपान ली चलियो चाकरी धाइ ॥",
      "sourceLineId": "116162",
      "sourceShabadId": "10596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਾਰਤ ਮਾਰਗ ਸਿੰਘ ਜਹ ਤਿਹ ਠਾ ਪਹੁਚ੍ਯੋ ਜਾਇ ॥੧੬॥",
      "transliteration": "maarat maarag si(n)gh jeh teh Thaa pahuchayo jai ||16||",
      "translation": "Be reached the place where a lion used to plunder the people and eat them.(16)",
      "punjabiViakhya": "ਜਿਥੇ ਰਸਤੇ ਵਿਚ ਸ਼ੇਰ (ਲੋਕਾ ਨੂੰ) ਮਾਰਦਾ ਸੀ, ਉਸ ਥਾ ਉਤੇ ਜਾ ਪਹੁੰਚਿਆ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "मारत मारग सिंघ जह तिह ठा पहुच्यो जाइ ॥१६॥",
      "sourceLineId": "116163",
      "sourceShabadId": "10596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤ੍ਰਸਿਤ ਜੁਲਾਹੋ ਦ੍ਰੁਮ ਚੜ੍ਯੋ ਗਹੈ ਸੈਹਥੀ ਹਾਥ ॥",
      "transliteration": "trasit julaaho dhrum chaRayo gahai saihathee haath ||",
      "translation": "Being afraid, holding the sword in his hand, he went up the tree.",
      "punjabiViakhya": "ਡਰ ਦਾ ਮਾਰਿਆ ਜੁਲਾਹਾ ਹੱਥ ਵਿਚ ਸੈਹਥੀ ਫੜ ਕੇ ਬ੍ਰਿਛ ਉਤੇ ਚੜ੍ਰਹ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "त्रसित जुलाहो द्रुम चड़्यो गहै सैहथी हाथ ॥",
      "sourceLineId": "116164",
      "sourceShabadId": "10596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਰੇ ਆਨਿ ਠਾਢੋ ਭਯੋ ਸਿੰਘ ਰੋਸ ਕੇ ਸਾਥ ॥੧੭॥",
      "transliteration": "tare aan Thaaddo bhayo si(n)gh ros ke saath ||17||",
      "translation": "And down there the lion, which was right furious, took his place.(l7)",
      "punjabiViakhya": "ਸ਼ੇਰ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ (ਬ੍ਰਿਛ ਦੇ) ਹੇਠਾ ਆ ਕੇ ਖੜੋ ਗਿਆ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "तरे आनि ठाढो भयो सिंघ रोस के साथ ॥१७॥",
      "sourceLineId": "116165",
      "sourceShabadId": "10596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116166",
      "sourceShabadId": "10597",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਿੰਘਹਿ ਦ੍ਰਿਸਟਿ ਜੁਲਾਹੇ ਪਰੀ ॥",
      "transliteration": "si(n)gheh dhirasaT julaahe paree ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਸ਼ੇਰ ਦੀ ਨਜ਼ਰ ਜੁਲਾਹੇ ਉਤੇ ਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "सिंघहि दृसटि जुलाहे परी ॥",
      "sourceLineId": "116167",
      "sourceShabadId": "10597",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਰਛੀ ਕੰਪਤ ਹਾਥ ਤੇ ਝਰੀ ॥",
      "transliteration": "barachhee ka(n)pat haath te jharee ||",
      "translation": "When the lion looked up at the weaver, he trembled and the sword fell from his hands.",
      "punjabiViakhya": "ਤਾ ਕੰਬਦੇ ਹੋਏ ਹੱਥਾ ਵਿਚੋਂ ਬਰਛੀ ਡਿਗ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "बरछी कंपत हाथ ते झरी ॥",
      "sourceLineId": "116168",
      "sourceShabadId": "10597",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮੁਖ ਮੈ ਲਗੀ ਪਿਸਟਿ ਤਰ ਨਿਕਸੀ ॥",
      "transliteration": "mukh mai lagee pisaT tar nikasee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਸ਼ੇਰ ਦੇ) ਮੂੰਹ ਵਿਚ ਲਗੀ ਅਤੇ ਪਿਠ ਹੇਠੋਂ ਨਿਕਲ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "मुख मै लगी पिसटि तर निकसी ॥",
      "sourceLineId": "116169",
      "sourceShabadId": "10597",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਨ ਕਰਿ ਕੰਜਕਲੀ ਸੀ ਬਿਗਸੀ ॥੧੮॥",
      "transliteration": "jan kar ka(n)jakalee see bigasee ||18||",
      "translation": "It went right into the mOUth of the lion and came out ofthe stomach.(18)",
      "punjabiViakhya": "ਮਾਨੋ ਕਮਲ ਦੇ ਫੁਲ ਦੀ ਕਲੀ (ਡੋਡੀ) ਖਿੜੀ ਹੋਵੇ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "जन करि कंजकली सी बिगसी ॥१८॥",
      "sourceLineId": "116170",
      "sourceShabadId": "10597",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਾਨ੍ਯੋ ਸਾਚੁ ਸਿੰਘ ਮਰਿ ਗਯੋ ॥",
      "transliteration": "jaanayo saach si(n)gh mar gayo ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦੋਂ ਉਸ ਨੇ) ਜਾਣ ਲਿਆ ਕਿ ਸ਼ੇਰ ਸਚਮੁਚ ਮਰ ਗਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "जान्यो साचु सिंघ मरि गयो ॥",
      "sourceLineId": "116171",
      "sourceShabadId": "10597",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਉਤਰਿਯੋ ਪੂਛਿ ਕਾਨ ਕਟਿ ਲਯੋ ॥",
      "transliteration": "autariyo poochh kaan kaT layo ||",
      "translation": "When he observed that the lion was dead,",
      "punjabiViakhya": "(ਤਾ ਬ੍ਰਿਛ ਤੋਂ) ਉਤਰ ਕੇ (ਸ਼ੇਰ ਦੇ) ਕੰਨ ਅਤੇ ਪੂਛਲ ਕਟ ਲਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "उतरियो पूछि कान कटि लयो ॥",
      "sourceLineId": "116172",
      "sourceShabadId": "10597",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਾਇ ਨ੍ਰਿਪਤਿ ਕੌ ਤਾਹਿ ਦਿਖਾਯੋ ॥",
      "transliteration": "jai nirapat kau taeh dhikhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਕੇ ਉਹ ਰਾਜੇ ਨੂੰ ਵਿਖਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "जाइ नृपति कौ ताहि दिखायो ॥",
      "sourceLineId": "116173",
      "sourceShabadId": "10597",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਧਿਕ ਮਹੀਨੋ ਅਪਨ ਕਰਾਯੋ ॥੧੯॥",
      "transliteration": "adhik maheeno apan karaayo ||19||",
      "translation": "He came down, cut the ear and the tail and showed to the Raja to claim more wages.(l9)",
      "punjabiViakhya": "ਅਤੇ ਆਪਣਾ ਬਹੁਤ ਸਾਰਾ ਮਹੀਨਾ ਕਰਵਾ ਲਿਆ (ਅਰਥਾਤ ਚੰਗੀ ਤਨਖਾਹ ਲਗਵਾ ਲਈ) ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "अधिक महीनो अपन करायो ॥१९॥",
      "sourceLineId": "116174",
      "sourceShabadId": "10597",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "116175",
      "sourceShabadId": "10598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਏਕ ਸਤ੍ਰੁ ਤਾ ਕੋ ਹੁਤੋ ਚੜਿਯੋ ਅਨੀ ਬਨਾਇ ॥",
      "transliteration": "ek satr taa ko huto chaRiyo anee banai ||",
      "translation": "The Raja had an enemy, who had raided him.",
      "punjabiViakhya": "ਉਸ (ਰਾਜੇ) ਦਾ ਇਕ ਵੈਰੀ ਸੀ। ਉਹ ਫ਼ੌਜ ਲੈ ਕੇ ਚੜ੍ਰਹ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "एक सत्रु ता को हुतो चड़ियो अनी बनाइ ॥",
      "sourceLineId": "116176",
      "sourceShabadId": "10598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੈਨਾਪਤਿ ਪਚਮਾਰ ਕੈ ਇਹ ਨ੍ਰਿਪ ਦਿਯੋ ਪਠਾਇ ॥੨੦॥",
      "transliteration": "sainaapat pachamaar kai ieh nirap dhiyo paThai ||20||",
      "translation": "Reflecting on his bravery Raja appointed him as the supreme commander.(20)",
      "punjabiViakhya": "ਤਾ ਰਾਜੇ ਨੇ ਸ਼ੇਰ ਨੂੰ ਮਾਰਨ ਵਾਲੇ ('ਪਚਮਾਰ') ਨੂੰ ਸੈਨਾਪਤੀ ਬਣਾ ਕੇ ਭੇਜ ਦਿੱਤਾ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "सैनापति पचमार कै इह नृप दियो पठाइ ॥२०॥",
      "sourceLineId": "116177",
      "sourceShabadId": "10598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116178",
      "sourceShabadId": "10599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਯਹ ਪਚਮਾਰ ਖਬਰਿ ਸੁਨ ਪਾਈ ॥",
      "transliteration": "yeh pachamaar khabar sun paiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਪਚਮਾਰ ਨੇ ਇਹ ਖ਼ਬਰ ਸੁਣੀ",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "यह पचमार खबरि सुन पाई ॥",
      "sourceLineId": "116179",
      "sourceShabadId": "10599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਰਿ ਜੁਲਾਹੀ ਹੁਤੀ ਬੁਲਾਈ ॥",
      "transliteration": "naar julaahee hutee bulaiee ||",
      "translation": "When the weaver heard this news, he called his wife.",
      "punjabiViakhya": "ਤਾ ਆਪਣੀ ਜੁਲਾਹੀ ਨਾਰ ਨੂੰ ਬੁਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "नारि जुलाही हुती बुलाई ॥",
      "sourceLineId": "116180",
      "sourceShabadId": "10599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚਿਤ ਮੈ ਅਧਿਕ ਦੁਹੂੰ ਡਰ ਕੀਨੋ ॥",
      "transliteration": "chit mai adhik dhuhoo(n) ddar keeno ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੇ ਚਿਤ ਵਿਚ ਬਹੁਤ ਡਰ ਮੰਨਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "चित मै अधिक दुहूँ डर कीनो ॥",
      "sourceLineId": "116181",
      "sourceShabadId": "10599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਰਧ ਰਾਤਿ ਬਨ ਕੋ ਮਗੁ ਲੀਨੋ ॥੨੧॥",
      "transliteration": "aradh raat ban ko mag leeno ||21||",
      "translation": "Both were terror stricken and, at the pitch of the night, took their way to the jungle.(21)",
      "punjabiViakhya": "ਅਤੇ ਅੱਧੀ ਰਾਤ ਨੂੰ ਜੰਗਲ ਦਾ ਰਾਹ ਫੜਿਆ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "अरध राति बन को मगु लीनो ॥२१॥",
      "sourceLineId": "116182",
      "sourceShabadId": "10599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਬ ਤ੍ਰਿਯ ਸਹਿਤ ਜੁਲਾਹੋ ਭਾਜ੍ਯੋ ॥",
      "transliteration": "jab tiray sahit julaaho bhaajayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਇਸਤਰੀ ਸਹਿਤ ਜੁਲਾਹਾ ਭਜ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "जब तृय सहित जुलाहो भाज्यो ॥",
      "sourceLineId": "116183",
      "sourceShabadId": "10599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਬ ਹੀ ਘੋਰ ਘਟਾ ਘਨ ਗਾਜ੍ਰਯੋ ॥",
      "transliteration": "tab hee ghor ghaTaa ghan gaajrayo ||",
      "translation": "When the weaver and his wife were running away, the thunder storm approached,",
      "punjabiViakhya": "ਤਾ ਉਸ ਵੇਲੇ ਭਿਆਨਕ ਬਦਲ ਗੱਜਣ ਲਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "तब ही घोर घटा घन गाज्रयो ॥",
      "sourceLineId": "116184",
      "sourceShabadId": "10599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਬਹੂੰ ਚਮਿਕਿ ਬਿਜੁਰਿਯਾ ਜਾਵੈ ॥",
      "transliteration": "kabahoo(n) chamik bijuriyaa jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਕਦੇ ਕਦੇ ਬਿਜਲੀ ਚਮਕ ਪੈਂਦੀ,",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "कबहूँ चमिकि बिजुरिया जावै ॥",
      "sourceLineId": "116185",
      "sourceShabadId": "10599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਬ ਮਾਰਗ ਕੋ ਚੀਨਨ ਆਵੈ ॥੨੨॥",
      "transliteration": "tab maarag ko cheenan aavai ||22||",
      "translation": "And amidst the severe lightning, they lost their way.(22)",
      "punjabiViakhya": "ਤਦ ਕਿਤੇ ਮਾਰਗ ਦਿਸ ਪੈਂਦਾ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "तब मारग को चीनन आवै ॥२२॥",
      "sourceLineId": "116186",
      "sourceShabadId": "10599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮਗ ਤੈ ਭੂਲਿ ਤਿਸੀ ਮਗੁ ਪਰਿਯੋ ॥",
      "transliteration": "mag tai bhool tisee mag pariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਰਸਤਾ ਭੁਲ ਕੇ, ਉਸ ਮਾਰਗ ਉਤੇ ਪੈ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "मग तै भूलि तिसी मगु परियो ॥",
      "sourceLineId": "116187",
      "sourceShabadId": "10599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਹ ਨ੍ਰਿਪ ਅਰਿ ਕੋ ਲਸਕਰ ਢਰਿਯੋ ॥",
      "transliteration": "jeh nirap ar ko lasakar ddariyo ||",
      "translation": "Losing their way they came to the place where the Raja’s enemy were encamping.",
      "punjabiViakhya": "ਜਿਥੇ ਰਾਜੇ ਦੇ ਵੈਰੀ ਦਾ ਲਸ਼ਕਰ ਪਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "जह नृप अरि को लसकर ढरियो ॥",
      "sourceLineId": "116188",
      "sourceShabadId": "10599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕੂੰਈ ਹੁਤੀ ਦ੍ਰਿਸਟਿ ਨਹਿ ਆਈ ॥",
      "transliteration": "koo(n)iee hutee dhirasaT neh aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਖੂਹੀ ਸੀ, (ਜੋ ਉਸ ਦੀ) ਨਜ਼ਰ ਨਾ ਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "कूँई हुती दृसटि नहि आई ॥",
      "sourceLineId": "116189",
      "sourceShabadId": "10599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਾ ਮੌ ਪਰਿਯੋ ਜੁਲਾਹੋ ਜਾਈ ॥੨੩॥",
      "transliteration": "taa mau pariyo julaaho jaiee ||23||",
      "translation": "There was a, well which was not visible to them and the weaver fell in it.(23)",
      "punjabiViakhya": "ਅਤੇ ਜੁਲਾਹਾ ਵਿਚ ਜਾ ਡਿਗਿਆ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "ता मौ परियो जुलाहो जाई ॥२३॥",
      "sourceLineId": "116190",
      "sourceShabadId": "10599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "116191",
      "sourceShabadId": "10600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਬ ਤਾਹੀ ਕੂੰਈ ਬਿਖੈ ਜਾਇ ਪਰਿਯੋ ਬਿਸੰਭਾਰ ॥",
      "transliteration": "jab taahee koo(n)iee bikhai jai pariyo bisa(n)bhaar ||",
      "translation": "When he fell in the well, became unconscious,",
      "punjabiViakhya": "ਜਦ ਉਹ ਖੂਹੀ ਵਿਚ ਜਾ ਪਿਆ ਅਤੇ ਬੇਹੋਸ਼ (ਹੋ ਗਿਆ)",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "जब ताही कूँई बिखै जाइ परियो बिसंभार ॥",
      "sourceLineId": "116192",
      "sourceShabadId": "10600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਬ ਐਸੇ ਤ੍ਰਿਯ ਕਹਿ ਉਠੀ ਆਨਿ ਪਰਿਯੋ ਪਚਮਾਰ ॥੨੪॥",
      "transliteration": "tab aaise tiray keh uThee aan pariyo pachamaar ||24||",
      "translation": "Then the woman shoUted, ‘My dear lion killer has fallen there.’(24)",
      "punjabiViakhya": "ਤਾ ਜੁਲਾਹੀ ਇਸ ਤਰ੍ਰਹਾ ਪੁਕਾਰ ਉਠੀ ਕਿ ਸ਼ੇਰ-ਮਾਰ (ਖੂਹੀ ਵਿਚ) ਆ ਡਿਗਿਆ ਹੈ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "तब ऐसे तृय कहि उठी आनि परियो पचमार ॥२४॥",
      "sourceLineId": "116193",
      "sourceShabadId": "10600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0926_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "Arril",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 926,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "116194",
      "sourceShabadId": "10601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
