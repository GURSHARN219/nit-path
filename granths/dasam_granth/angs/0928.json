{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 928,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0928_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116267",
      "sourceShabadId": "10611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੂਤ ਤਬੈ ਬੈਰਮ ਪਹਿ ਆਯੋ ॥",
      "transliteration": "dhoot tabai bairam peh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦੂਤ ਬੈਰਮ ਖਾ ਕੋਲ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "दूत तबै बैरम पहि आयो ॥",
      "sourceLineId": "116268",
      "sourceShabadId": "10611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਾ ਕੋ ਅਧਿਕ ਰੋਸ ਉਪਜਾਯੋ ॥",
      "transliteration": "taa ko adhik ros upajaayo ||",
      "translation": "The emissary came to Bairam and demonstrated his anger.",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਬਹੁਤ ਕ੍ਰੋਧਵਾਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "ता को अधिक रोस उपजायो ॥",
      "sourceLineId": "116269",
      "sourceShabadId": "10611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬੈਠਿਯੋ ਕਹਾ ਦੈਵ ਕੇ ਖੋਏ ॥",
      "transliteration": "baiThiyo kahaa dhaiv ke khoe ||",
      "translation": "",
      "punjabiViakhya": "(ਦੂਤ ਨੇ ਕਿਹਾ) ਹੇ ਰੱਬ ਦੇ ਮਾਰਿਓ! ਕਿਵੇਾਂ ਬੈਠੇ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "बैठियो कहा दैव के खोए ॥",
      "sourceLineId": "116270",
      "sourceShabadId": "10611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤੋ ਪੈ ਕਰੇ ਆਰਬਿਨ ਢੋਏ ॥੪॥",
      "transliteration": "to pai kare aarabin ddoe ||4||",
      "translation": "‘You, the unlucky one, are sitting idle and the enemy is here with his guns.’(4)",
      "punjabiViakhya": "ਤੁਹਾਡੇ ਉਤੇ ਅਰਬ ਦੇਸ ਵਾਲਿਆਂ ਨੇ ਹਮਲਾ ਕੀਤਾ ਹੈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "तो पै करे आरबिन ढोए ॥४॥",
      "sourceLineId": "116271",
      "sourceShabadId": "10611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬੈਰਮ ਅਧਿਕ ਬਚਨ ਸੁਨਿ ਡਰਿਯੋ ॥",
      "transliteration": "bairam adhik bachan sun ddariyo ||",
      "translation": "",
      "punjabiViakhya": "ਬੈਰਮ ਖਾ ਇਹ ਗੱਲ ਸੁਣ ਕੇ ਬਹੁਤ ਡਰ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "बैरम अधिक बचन सुनि डरियो ॥",
      "sourceLineId": "116272",
      "sourceShabadId": "10611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਆਪੁ ਭਜਨ ਕੋ ਸਾਮੋ ਕਰਿਯੋ ॥",
      "transliteration": "aap bhajan ko saamo kariyo ||",
      "translation": "Bairam was scared and decided to run away,",
      "punjabiViakhya": "ਅਤੇ ਆਪ ਦੌੜਨ ਦੀ ਵਿਉਾਂਤ ਬਣਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "आपु भजन को सामो करियो ॥",
      "sourceLineId": "116273",
      "sourceShabadId": "10611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਦ ਚਲਿ ਤੀਰ ਪਠਾਨੀ ਆਈ ॥",
      "transliteration": "tadh chal teer paThaanee aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਪਠਾਣੀ ਉਸ ਕੋਲ ਚਲ ਕੇ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "तद चलि तीर पठानी आई ॥",
      "sourceLineId": "116274",
      "sourceShabadId": "10611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਾ ਸੋ ਕਹਿਯੋ ਸੁ ਚਹੌ ਸੁਨਾਈ ॥੫॥",
      "transliteration": "taa so kahiyo su chahau sunaiee ||5||",
      "translation": "Then the Pathani came forward and said to him,(5)",
      "punjabiViakhya": "ਜੋ ਉਸ ਨੇ ਆ ਕੇ ਕਿਹਾ, ਉਹ ਮੈਂ ਸੁਣਾਉਣਾ ਚਾਹੁੰਦਾ ਹਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "ता सो कहियो सु चहौ सुनाई ॥५॥",
      "sourceLineId": "116275",
      "sourceShabadId": "10611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "116276",
      "sourceShabadId": "10612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤੋਰ ਪਿਤਾ ਐਸੋ ਹੁਤੋ ਜਾ ਕੋ ਜਗ ਮੈ ਨਾਮ ॥",
      "transliteration": "tor pitaa aaiso huto jaa ko jag mai naam ||",
      "translation": "‘Your father was renowned all over the world,",
      "punjabiViakhya": "ਤੇਰੇ ਪਿਤਾ ਅਜਿਹੇ ਸਨ ਕਿ ਜਿੰਨਾ ਦਾ ਜਗਤ ਵਿਚ ਨਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "तोर पिता ऐसो हुतो जा को जग मै नाम ॥",
      "sourceLineId": "116277",
      "sourceShabadId": "10612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤੂ ਕਾਤਰ ਐਸੋ ਭਯੋ ਛਾਡਿ ਚਲਿਯੋ ਸੰਗ੍ਰਾਮ ॥੬॥",
      "transliteration": "too kaatar aaiso bhayo chhaadd chaliyo sa(n)graam ||6||",
      "translation": "‘But you are so coward that you are running away from fight.’(6)",
      "punjabiViakhya": "ਤੂੰ ਅਜਿਹਾ ਡਰਪੋਕ ਹੈਂ ਕਿ ਜੰਗ ਨੂੰ ਛਡ ਕੇ ਭਜ ਚਲਿਆ ਹੈਂ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "तू कातर ऐसो भयो छाडि चलियो संग्राम ॥६॥",
      "sourceLineId": "116278",
      "sourceShabadId": "10612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116279",
      "sourceShabadId": "10613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਪਨੀ ਪਗਿਯਾ ਮੋ ਕਹ ਦੀਜੈ ॥",
      "transliteration": "apanee pagiyaa mo keh dheejai ||",
      "translation": "",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਆਪਣੀ ਪੱਗ ਮੈਨੂੰ ਦੇ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "अपनी पगिया मो कह दीजै ॥",
      "sourceLineId": "116280",
      "sourceShabadId": "10613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮੇਰੀ ਪਹਿਰ ਇਜਾਰਹਿ ਲੀਜੈ ॥",
      "transliteration": "meree pahir ijaareh leejai ||",
      "translation": "‘Give me your turban and take my shalwar, the trousers. ‘When I",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੀ ਸਲਵਾਰ ਪਾ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "मेरी पहिर इजारहि लीजै ॥",
      "sourceLineId": "116281",
      "sourceShabadId": "10613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਬ ਮੈ ਸਸਤ੍ਰ ਤਿਹਾਰੋ ਧਰਿਹੌ ॥",
      "transliteration": "jab mai sasatr tihaaro dharihau ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਮੈਂ ਤੁਹਾਡੇ ਸ਼ਸਤ੍ਰ ਧਾਰਨ ਕਰਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "जब मै ससत्र तिहारो धरिहौ ॥",
      "sourceLineId": "116282",
      "sourceShabadId": "10613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਟੂਕ ਟੂਕ ਬੈਰਿਨ ਕੇ ਕਰਿਹੌ ॥੭॥",
      "transliteration": "Took Took bairin ke karihau ||7||",
      "translation": "Wear your clothes, I will cut the enemy off’(7)",
      "punjabiViakhya": "ਤਾ ਵੈਰੀਆਂ ਦੇ ਟੋਟੇ ਟੋਟੇ ਕਰ ਦਿਆਂਗੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "टूक टूक बैरिन के करिहौ ॥७॥",
      "sourceLineId": "116283",
      "sourceShabadId": "10613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਯੌ ਕਹਿ ਪਤਿਹਿ ਭੋਹਰੇ ਦੀਨੋ ॥",
      "transliteration": "yau keh pateh bhohare dheeno ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਕਹਿ ਕੇ ਪਤੀ ਨੂੰ ਭੋਰੇ ਵਿਚ ਪਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "यौ कहि पतिहि भोहरे दीनो ॥",
      "sourceLineId": "116284",
      "sourceShabadId": "10613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਾ ਕੈ ਛੀਨਿ ਆਯੁਧਨ ਲੀਨੋ ॥",
      "transliteration": "taa kai chheen aayudhan leeno ||",
      "translation": "After declaring as such, she put her husband in the dungeon.",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੇ ਸਾਰੇ ਹਥਿਆਰ ਖੋਹ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "ता कै छीनि आयुधन लीनो ॥",
      "sourceLineId": "116285",
      "sourceShabadId": "10613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਸਤ੍ਰ ਬਾਧਿ ਨਰ ਭੇਖ ਬਨਾਯੋ ॥",
      "transliteration": "sasatr baadh nar bhekh banaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਪਠਾਣੀ ਨੇ) ਸ਼ਸਤ੍ਰ ਬੰਨ੍ਰਹ ਕੇ ਪੁਰਸ਼ ਦਾ ਭੇਸ ਬਣਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "ससत्र बाधि नर भेख बनायो ॥",
      "sourceLineId": "116286",
      "sourceShabadId": "10613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪਹਿਰਿ ਕਵਚ ਦੁੰਦਭੀ ਬਜਾਯੋ ॥੮॥",
      "transliteration": "pahir kavach dhu(n)dhabhee bajaayo ||8||",
      "translation": "She armed herself, disguised as a man and wearing arm our she beat the war-drums.(8)",
      "punjabiViakhya": "ਅਤੇ ਕਵਚ ਪਾ ਕੇ ਨਗਾਰਾ ਵਜਾਇਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "पहिरि कवच दुँदभी बजायो ॥८॥",
      "sourceLineId": "116287",
      "sourceShabadId": "10613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "116288",
      "sourceShabadId": "10614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੈਨ ਸਕਲ ਲੈ ਕੈ ਚੜੀ ਸੂਰਨ ਸਕਲ ਜਤਾਇ ॥",
      "transliteration": "sain sakal lai kai chaRee sooran sakal jatai ||",
      "translation": "With the army, she raised, she displayed her power and declared,",
      "punjabiViakhya": "ਸਾਰੀ ਸੈਨਾ ਲੈ ਕੇ (ਪਠਾਣੀ) ਚੜ੍ਰਹ ਪਈ ਅਤੇ ਸੂਰਮਿਆਂ ਨੂੰ ਦਸਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "सैन सकल लै कै चड़ी सूरन सकल जताइ ॥",
      "sourceLineId": "116289",
      "sourceShabadId": "10614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬੈਰਮ ਖਾ ਮੁਹਿ ਭ੍ਰਿਤ ਕੌ ਬੀਰਾ ਦਯੋ ਬੁਲਾਇ ॥੯॥",
      "transliteration": "bairam khaa muh bhirat kau beeraa dhayo bulai ||9||",
      "translation": "‘Bairam Khan has deputed me to fight for him.’(9)",
      "punjabiViakhya": "ਕਿ ਬੈਰਮ ਖਾ ਨੇ ਮੈਨੂੰ ਦਾਸੀ ਨੂੰ ਬੁਲਾ ਕੇ (ਇਸ ਜੰਗ ਨੂੰ ਲੜਨ ਦਾ) ਬੀੜਾ ਦਿੱਤਾ ਹੈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "बैरम खा मुहि भृत कौ बीरा दयो बुलाइ ॥९॥",
      "sourceLineId": "116290",
      "sourceShabadId": "10614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116291",
      "sourceShabadId": "10615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੈਨਾ ਸਕਲ ਸੰਗ ਲੈ ਧਾਈ ॥",
      "transliteration": "sainaa sakal sa(n)g lai dhaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸਾਰੀ ਸੈਨਾ ਨੂੰ ਨਾਲ ਲੈ ਕੇ ਚੜ੍ਰਹ ਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "सैना सकल संग लै धाई ॥",
      "sourceLineId": "116292",
      "sourceShabadId": "10615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਾਧੇ ਗੋਲ ਸਾਮੁਹੇ ਆਈ ॥",
      "transliteration": "baadhe gol saamuhe aaiee ||",
      "translation": "She raided through her army and rounded the enemy forces.",
      "punjabiViakhya": "ਅਤੇ ਗੋਲ ਘੇਰਾ (ਵਿਯੂਹ) ਬਣਾ ਕੇ ਸਾਹਮਣੇ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "बाधे गोल सामुहे आई ॥",
      "sourceLineId": "116293",
      "sourceShabadId": "10615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬੈਰਮ ਖਾ ਇਕ ਭ੍ਰਿਤ ਪਠਾਯੋ ॥",
      "transliteration": "bairam khaa ik bhirat paThaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਵੈਰੀ ਦਲ ਨੂੰ ਕਹਿਣ ਲਗੀ ਕਿ) ਬੈਰਮ ਖਾ ਨੇ ਇਕ ਦਾਸ ਨੂੰ (ਜੰਗ ਕਰਨ ਲਈ) ਭੇਜਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "बैरम खा इक भृत पठायो ॥",
      "sourceLineId": "116294",
      "sourceShabadId": "10615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮੋ ਕਹ ਜੀਤਿ ਤਬ ਆਗੇ ਜਾਯੋ ॥੧੦॥",
      "transliteration": "mo keh jeet tab aage jaayo ||10||",
      "translation": "And (she disguised as) Bairam Khan senta massager, ‘First win me before you proceed further.’(10)",
      "punjabiViakhya": "ਮੈਨੂੰ ਜਿਤ ਕੇ ਹੀ ਅਗੇ ਜਾ ਸਕਦੇ ਹੋ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "मो कह जीति तब आगे जायो ॥१०॥",
      "sourceLineId": "116295",
      "sourceShabadId": "10615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਯੌ ਸੁਨਿ ਸੂਰ ਸਕਲ ਰਿਸ ਭਰੇ ॥",
      "transliteration": "yau sun soor sakal ris bhare ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਗੱਲ ਸੁਣ ਕੇ ਸਾਰੇ ਸੂਰਮੇ ਗੁੱਸੇ ਨਾਲ ਭਰ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "यौ सुनि सूर सकल रिस भरे ॥",
      "sourceLineId": "116296",
      "sourceShabadId": "10615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੈ ਆਯੁਧੁ ਧਰੇ ॥",
      "transliteration": "bhaat bhaat kai aayudh dhare ||",
      "translation": "Hearing this, all the soldiers flew into the rage,",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦੇ ਹਥਿਆਰ ਧਾਰਨ ਕਰ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "भाति भाति कै आयुधु धरे ॥",
      "sourceLineId": "116297",
      "sourceShabadId": "10615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਾ ਕੋ ਘੇਰਿ ਦਸੌ ਦਿਸਿ ਆਏ ॥",
      "transliteration": "taa ko gher dhasau dhis aae ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਦਸਾ ਦਿਸ਼ਾਵਾ (ਭਾਵ ਸਭ ਪਾਸਿਓਾਂ) ਘੇਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "ता को घेरि दसौ दिसि आए ॥",
      "sourceLineId": "116298",
      "sourceShabadId": "10615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਾਨਿ ਕਮਾਨਨ ਬਾਨ ਚਲਾਏ ॥੧੧॥",
      "transliteration": "taan kamaanan baan chalaae ||11||",
      "translation": "And they encircled with arrows in their bows.(11)",
      "punjabiViakhya": "ਅਤੇ ਕਮਾਣਾ ਖਿਚ ਕੇ ਬਾਣ ਚਲਾਏ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "तानि कमानन बान चलाए ॥११॥",
      "sourceLineId": "116299",
      "sourceShabadId": "10615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "116300",
      "sourceShabadId": "10616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਸਿ ਫਾਸੀ ਧਰਿ ਸਿਪਰ ਲੈ ਗੁਰਜ ਗੁਫਨ ਲੈ ਹਾਥ ॥",
      "transliteration": "as faasee dhar sipar lai guraj gufan lai haath ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰ, ਫਾਸ, ਢਾਲ, ਗੁਰਜ, ਗੋਫਨਾ ਆਦਿ ਹੱਥ ਵਿਚ ਧਾਰਨ ਕਰ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "असि फासी धरि सिपर लै गुरज गुफन लै हाथ ॥",
      "sourceLineId": "116301",
      "sourceShabadId": "10616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗਿਰਿ ਗਿਰਿ ਗੇ ਜੋਧਾ ਧਰਨਿ ਬਿਧੈ ਬਰਛਿਯਨ ਸਾਥ ॥੧੨॥",
      "transliteration": "gir gir ge jodhaa dharan bidhai barachhiyan saath ||12||",
      "translation": "",
      "punjabiViakhya": "ਜੋਧੇ ਬਰਛੀਆਂ ਨਾਲ ਵਿੰਨ੍ਰਹੇ ਹੋਏ ਧਰਤੀ ਉਤੇ ਡਿਗ-ਡਿਗ ਪਏ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "गिरि गिरि गे जोधा धरनि बिधै बरछियन साथ ॥१२॥",
      "sourceLineId": "116302",
      "sourceShabadId": "10616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭੁਜੰਗ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g chha(n)dh ||",
      "translation": "Bhujang Chhand",
      "punjabiViakhya": "ਭੁਜੰਗ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "भुजंग छंद ॥",
      "sourceLineId": "116303",
      "sourceShabadId": "10617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਲਏ ਹਾਥ ਸੈਥੀ ਅਰਬ ਖਰਬ ਧਾਏ ॥",
      "transliteration": "le haath saithee arab kharab dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਹੱਥ ਵਿਚ ਸੈਹਥੀਆਂ ਲੈ ਕੇ ਅਰਬਾ ਖਰਬਾ ਸੂਰਮੇ ਚੜ੍ਰਹ ਆਏ",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "लए हाथ सैथी अरब खरब धाए ॥",
      "sourceLineId": "116304",
      "sourceShabadId": "10617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬੰਧੇ ਗੋਲ ਹਾਠੇ ਹਠੀ ਖੇਤ ਆਏ ॥",
      "transliteration": "ba(n)dhe gol haaThe haThee khet aae ||",
      "translation": "The spears in the hands, they came and rounded the enemy.",
      "punjabiViakhya": "ਅਤੇ ਹਠੀ ਸੂਰਮੇ ਗੋਲ ਘੇਰਾ ਬੰਨ੍ਰਹ ਕੇ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਆ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "बंधे गोल हाठे हठी खेत आए ॥",
      "sourceLineId": "116305",
      "sourceShabadId": "10617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਹਾ ਕੋਪ ਕੈ ਬਾਲ ਕੇ ਤੀਰ ਢੂਕੇ ॥",
      "transliteration": "mahaa kop kai baal ke teer ddooke ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬਹੁਤ ਅਧਿਕ ਕ੍ਰੋਧ ਕਰ ਕੇ ਇਸਤਰੀ ਦੇ ਕੋਲ ਢੁਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "महा कोप कै बाल के तीर ढूके ॥",
      "sourceLineId": "116306",
      "sourceShabadId": "10617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੁਹੂੰ ਓਰ ਤੇ ਮਾਰ ਹੀ ਮਾਰਿ ਕੂਕੇ ॥੧੩॥",
      "transliteration": "dhuhoo(n) or te maar hee maar kooke ||13||",
      "translation": "In fury they showered arrows on the lady, and the killing spread in every direction.(13)",
      "punjabiViakhya": "ਅਤੇ ਦੋਹਾ ਪਾਸਿਆਂ ਤੋਂ 'ਮਾਰੋ-ਮਾਰੋ' ਦੀਆਂ ਆਵਾਜ਼ਾ ਆਉਣ ਲਗੀਆਂ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "दुहूँ ओर ते मार ही मारि कूके ॥१३॥",
      "sourceLineId": "116307",
      "sourceShabadId": "10617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਵੈਯਾ ॥",
      "transliteration": "savaiyaa ||",
      "translation": "Savaiyya",
      "punjabiViakhya": "ਸਵੈਯਾ:",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "सवैया ॥",
      "sourceLineId": "116308",
      "sourceShabadId": "10618",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਛੋਰਿ ਨਿਸਾਸਨ ਕੇ ਫਰਰੇ ਭਟ ਢੋਲ ਢਮਾਕਨ ਦੈ ਕਰਿ ਢੂਕੇ ॥",
      "transliteration": "chhor nisaasan ke farare bhaT ddol ddamaakan dhai kar ddooke ||",
      "translation": "Waving the flags, they followed the drum beats.",
      "punjabiViakhya": "ਝੰਡਿਆਂ ਦੇ ਫਰਰਿਆਂ ਨੂੰ ਝੁਲਾ ਕੇ ਸੂਰਮੇ ਢੋਲਾ ਉਤੇ ਡਗੇ ਮਾਰ ਕੇ ਢੁਕੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "छोरि निसासन के फररे भट ढोल ढमाकन दै करि ढूके ॥",
      "sourceLineId": "116309",
      "sourceShabadId": "10618",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਢਾਲਨ ਕੌ ਗਹਿ ਕੈ ਕਰ ਭੀਤਰ ਮਾਰ ਹੀ ਮਾਰਿ ਦਸੌ ਦਿਸਿ ਕੂਕੇ ॥",
      "transliteration": "ddaalan kau geh kai kar bheetar maar hee maar dhasau dhis kooke ||",
      "translation": "Bolding shields they shouted, ‘Kill them, kill them.’",
      "punjabiViakhya": "ਢਾਲਾ ਨੂੰ ਹੱਥਾ ਵਿਚ ਪਕੜ ਕੇ ਹਰ ਪਾਸਿਓਾਂ 'ਮਾਰੋ-ਮਾਰੋ' ਕੂਕਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "ढालन कौ गहि कै कर भीतर मार ही मारि दसौ दिसि कूके ॥",
      "sourceLineId": "116310",
      "sourceShabadId": "10618",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਵਾਰ ਅਪਾਰ ਬਹੇ ਕਈ ਬਾਰ ਗਏ ਛੁਟਿ ਕੰਚਨ ਕੋਟਿ ਕਨੂਕੇ ॥",
      "transliteration": "vaar apaar bahe kiee baar ge chhuT ka(n)chan koT kanooke ||",
      "translation": "Raids after raids, produced fire sparks,",
      "punjabiViakhya": "ਕਈ ਵਾਰ ਅਣਗਿਣਤ ਪ੍ਰਹਾਰ ਹੋਏ ਹਨ ਅਤੇ ਸੋਨੇ (ਵਰਗੇ ਸੂਰਮਿਆਂ ਦੇ ਸ਼ਰੀਰ) ਚਿੰਗਾਰੇ ਬਣ ਕੇ ਉਡ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "वार अपार बहे कई बार गए छुटि कंचन कोटि कनूके ॥",
      "sourceLineId": "116311",
      "sourceShabadId": "10618",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਲੋਹ ਲੁਹਾਰ ਗੜੈ ਜਨੁ ਜਾਰਿ ਉਠੈ ਇਕ ਬਾਰਿ ਤ੍ਰਿਨਾਰਿ ਭਭੂਕੇ ॥੧੪॥",
      "transliteration": "loh luhaar gaRai jan jaar uThai ik baar tiranaar bhabhooke ||14||",
      "translation": "Like the ones produced at the battering (of hot iron) at the ironsmith.(14)",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਲੋਹਾਰ ਦੁਆਰਾ ਲੋਹੇ ਨੂੰ ਸਾੜ ਕੇ (ਲਾਲ ਕਰ ਕੇ) ਕੁਟਣ ਵੇਲੇ ਇਕੋ ਵਾਰ ਅੱਗ ('ਤ੍ਰਿਨਾਰ' ਤ੍ਰਿਨ-ਅਰਿ) ਵਿਚੋਂ ਚਿਣਗਾ ਉਠੀਆਂ ਹੋਣ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "लोह लुहार गड़ै जनु जारि उठै इक बारि तृनारि भभूके ॥१४॥",
      "sourceLineId": "116312",
      "sourceShabadId": "10618",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭੁਜੰਗ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g chha(n)dh ||",
      "translation": "Bhujang Chhand",
      "punjabiViakhya": "ਭੁਜੰਗ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "भुजंग छंद ॥",
      "sourceLineId": "116313",
      "sourceShabadId": "10619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0928_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗੁਰਿਏ ਖੇਲ ਮਹਮੰਦਿਲੇ ਜਾਕ ਧਾਏ ॥",
      "transliteration": "gurie khel mahama(n)dhile jaak dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਗੁਰਿਏ, ਖੇਲ, ਮਹਮੰਦਿਲੇ,",
      "source": "DASAM_GRANTH",
      "ang": 928,
      "hindi": "",
      "hindiTransliteration": "गुरिए खेल महमंदिले जाक धाए ॥",
      "sourceLineId": "116314",
      "sourceShabadId": "10619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
