{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 929,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0929_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦਓਜਈ ਅਫਰੀਦੀਏ ਕੋਪਿ ਆਏ ॥",
      "transliteration": "dhojiee afareedhe'ee kop aae ||",
      "translation": "Guiyes, Muhamadees, Dyojis and Afreedis came forward with extreme fury.",
      "punjabiViakhya": "ਦਓਜਈ, ਅਫਰੀਦੀਏ (ਆਦਿ ਜਾਤਾ ਦੇ ਸੂਰਮੇ) ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਆ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "दओजई अफरीदीए कोपि आए ॥",
      "sourceLineId": "116315",
      "sourceShabadId": "10619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਹਠੇ ਸੂਰ ਲੋਦੀ ਮਹਾ ਕੋਪ ਕੈ ਕੈ ॥",
      "transliteration": "haThe soor lodhee mahaa kop kai kai ||",
      "translation": "",
      "punjabiViakhya": "ਹਠੀ ਲੋਦੀ ਸੂਰਮੇ ਬਹੁਤ ਕ੍ਰੋਧ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "हठे सूर लोदी महा कोप कै कै ॥",
      "sourceLineId": "116316",
      "sourceShabadId": "10619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪਰੇ ਆਨਿ ਕੈ ਬਾਢਵਾਰੀਨ ਲੈ ਕੈ ॥੧੫॥",
      "transliteration": "pare aan kai baaddavaareen lai kai ||15||",
      "translation": "Brave Lodhis were awfully enraged and fell upon, brandishing their swords.(15)",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਲੈ ਕੇ ਟੁਟ ਕੇ ਆ ਪਏ ਹਨ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "परे आनि कै बाढवारीन लै कै ॥१५॥",
      "sourceLineId": "116317",
      "sourceShabadId": "10619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116318",
      "sourceShabadId": "10620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪਰੀ ਬਾਢਵਾਰੀਨ ਕੀ ਮਾਰਿ ਭਾਰੀ ॥",
      "transliteration": "paree baaddavaareen kee maar bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਾ ਦੀ ਭਾਰੀ ਮਾਰ ਪਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "परी बाढवारीन की मारि भारी ॥",
      "sourceLineId": "116319",
      "sourceShabadId": "10620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗਏ ਜੂਝਿ ਜੋਧਾ ਬਡੇਈ ਹੰਕਾਰੀ ॥",
      "transliteration": "ge joojh jodhaa baddeiee ha(n)kaaree ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਡੇ ਵੱਡੇ ਹੰਕਾਰੀ ਜੋਧੇ ਮਾਰੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "गए जूझि जोधा बडेई हंकारी ॥",
      "sourceLineId": "116320",
      "sourceShabadId": "10620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਹਾ ਮਾਰਿ ਬਾਨਨ ਕੀ ਗਾੜ ਐਸੀ ॥",
      "transliteration": "mahaa maar baanan kee gaaR aaisee ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣਾ ਦੀ ਅਜਿਹੀ ਤਕੜੀ ਮਾਰ ਪਈ,",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "महा मारि बानन की गाड़ ऐसी ॥",
      "sourceLineId": "116321",
      "sourceShabadId": "10620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮਨੌ ਕੁਆਰ ਕੇ ਮੇਘ ਕੀ ਬ੍ਰਿਸਟਿ ਜੈਸੀ ॥੧੬॥",
      "transliteration": "manau kuaar ke megh kee birasaT jaisee ||16||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਅਸੂ ਦੇ ਮਹੀਨੇ ਵਰਗੀ ਬਰਖਾ ਹੋ ਰਹੀ ਹੋਵੇ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "मनौ कुआर के मेघ की बृसटि जैसी ॥१६॥",
      "sourceLineId": "116322",
      "sourceShabadId": "10620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪਰੇ ਆਨਿ ਜੋਧਾ ਚਹੂੰ ਓਰ ਭਾਰੇ ॥",
      "transliteration": "pare aan jodhaa chahoo(n) or bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ ਬਹੁਤ ਅਧਿਕ ਯੋਧੇ ਆ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "परे आनि जोधा चहूँ ओर भारे ॥",
      "sourceLineId": "116323",
      "sourceShabadId": "10620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਹਾ ਮਾਰ ਹੀ ਮਾਰਿ ਐਸੇ ਪੁਕਾਰੇ ॥",
      "transliteration": "mahaa maar hee maar aaise pukaare ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਰੋ-ਮਾਰੋ' ਇਸ ਤਰ੍ਰਹਾ (ਕਹਿ ਕੇ ਬਹੁਤ) ਰੌਲਾ ਪਾ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "महा मार ही मारि ऐसे पुकारे ॥",
      "sourceLineId": "116324",
      "sourceShabadId": "10620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹਟੇ ਨਾਹਿ ਛਤ੍ਰੀ ਛਕੇ ਛੋਭ ਐਸੇ ॥",
      "transliteration": "haTe naeh chhatree chhake chhobh aaise ||",
      "translation": "",
      "punjabiViakhya": "ਛਤ੍ਰੀ ਯੁੱਧ ਵਿਚੋਂ ਹਟਦੇ ਨਹੀਂ ਹਨ, ਉਨ੍ਰਹਾ ਨੂੰ ਅਜਿਹਾ ਜੋਸ਼ ਚੜ੍ਰਹਿਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "हटे नाहि छत्री छके छोभ ऐसे ॥",
      "sourceLineId": "116325",
      "sourceShabadId": "10620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮਨੋ ਸਾਚ ਸ੍ਰੀ ਕਾਲ ਕੀ ਜ੍ਵਾਲ ਜੈਸੇ ॥੧੭॥",
      "transliteration": "mano saach sree kaal kee javaiaal jaise ||17||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸਚੀ ਮੁਚੀ (ਪਰਲੋ) ਕਾਲ ਦੀ ਜਵਾਲਾ ਹੋਵੇ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "मनो साच स्री काल की ज्वाल जैसे ॥१७॥",
      "sourceLineId": "116326",
      "sourceShabadId": "10620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਧਏ ਅਰਬ ਆਛੇ ਮਹਾ ਸੂਰ ਭਾਰੀ ॥",
      "transliteration": "dhe arab aachhe mahaa soor bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਰਬ ਦੇਸ ਦੇ ਚੰਗੇ ਅਤੇ ਮਹਾਨ ਸੂਰਮੇ ਤੁਰ ਪਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "धए अरब आछे महा सूर भारी ॥",
      "sourceLineId": "116327",
      "sourceShabadId": "10620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਰੈ ਤੀਨਹੂੰ ਲੋਕ ਜਿਨ ਕੌ ਜੁਹਾਰੀ ॥",
      "transliteration": "karai teenahoo(n) lok jin kau juhaaree ||",
      "translation": "The great Arabian soldiers, who had commendation in all the three domains, came forward’.",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੂੰ ਤਿੰਨੋ ਲੋਕ ਪ੍ਰਨਾਮ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "करै तीनहूँ लोक जिन कौ जुहारी ॥",
      "sourceLineId": "116328",
      "sourceShabadId": "10620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਲਏ ਹਾਥ ਤਿਰਸੂਲ ਐਸੋ ਭ੍ਰਮਾਵੈ ॥",
      "transliteration": "le haath tirasool aaiso bhramaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਹੱਥ ਵਿਚ ਤ੍ਰਿਸ਼ੂਲ ਲੈ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਘੁੰਮਾਉਾਂਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "लए हाथ तिरसूल ऐसो भ्रमावै ॥",
      "sourceLineId": "116329",
      "sourceShabadId": "10620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਨੋ ਮੇਘ ਮੈ ਦਾਮਨੀ ਦਮਕਿ ਜਾਵੈ ॥੧੮॥",
      "transliteration": "mano megh mai dhaamanee dhamak jaavai ||18||",
      "translation": "They wielded their sp’ears like the lightning in the clouds.(18)",
      "punjabiViakhya": "ਮਾਨੋ ਬਦਲਾ ਵਿਚ ਬਿਜਲੀ ਚਮਕ ਜਾਦੀ ਹੋਵੇ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "मनो मेघ मै दामनी दमकि जावै ॥१८॥",
      "sourceLineId": "116330",
      "sourceShabadId": "10620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116331",
      "sourceShabadId": "10621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਧਾਏ ਬੀਰ ਜੋਰਿ ਦਲ ਭਾਰੀ ॥",
      "transliteration": "dhaae beer jor dhal bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਡਾ ਦਲ ਬਣਾ ਕੇ ਸੂਰਮੇ ਧਾ ਕੇ ਪੈ ਗਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "धाए बीर जोरि दल भारी ॥",
      "sourceLineId": "116332",
      "sourceShabadId": "10621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਾਨਾ ਬਧੇ ਬਡੇ ਹੰਕਾਰੀ ॥",
      "transliteration": "baanaa badhe badde ha(n)kaaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵੱਡੇ ਹੰਕਾਰੀ (ਸੂਰਮਿਆਂ) ਨੂੰ ਬਾਣਾ ਨਾਲ ਵਿੰਨ੍ਰਹ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "बाना बधे बडे हंकारी ॥",
      "sourceLineId": "116333",
      "sourceShabadId": "10621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਾਨ ਧਨੁਹਿਯਨ ਬਾਨ ਚਲਾਵੈ ॥",
      "transliteration": "taan dhanuhiyan baan chalaavai ||",
      "translation": "",
      "punjabiViakhya": "ਧਨੁਸ਼ਾ ਨੂੰ ਖਿਚ ਕੇ ਬਾਣ ਚਲਾਉਾਂਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "तान धनुहियन बान चलावै ॥",
      "sourceLineId": "116334",
      "sourceShabadId": "10621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਾਧੇ ਗੋਲ ਸਾਮੁਹੇ ਆਵੈ ॥੧੯॥",
      "transliteration": "baadhe gol saamuhe aavai ||19||",
      "translation": "",
      "punjabiViakhya": "ਗੋਲ ਘੇਰਾ ਬੰਨ੍ਰਹ ਕੇ ਸਾਹਮਣੇ ਆਉਾਂਦੇ ਹਨ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "बाधे गोल सामुहे आवै ॥१९॥",
      "sourceLineId": "116335",
      "sourceShabadId": "10621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਬ ਅਬਲਾ ਵਹ ਨੈਨ ਨਿਹਾਰੇ ॥",
      "transliteration": "jab abalaa veh nain nihaare ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਪਠਾਣੀ ਉਨ੍ਰਹਾ ਨੂੰ ਅੱਖਾ ਨਾਲ ਵੇਖਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "जब अबला वह नैन निहारे ॥",
      "sourceLineId": "116336",
      "sourceShabadId": "10621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਸਸਤ੍ਰ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "bhaat bhaat ke sasatr prahaare ||",
      "translation": "When the lady faced them, she used different types of weapons.",
      "punjabiViakhya": "(ਤਾ) ਭਾਤ ਭਾਤ ਦੇ ਸ਼ਸਤ੍ਰਾ ਦਾ ਪ੍ਰਹਾਰ ਕਰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के ससत्र प्रहारे ॥",
      "sourceLineId": "116337",
      "sourceShabadId": "10621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮੂੰਡ ਜੰਘ ਬਾਹਨ ਬਿਨੁ ਕੀਨੇ ॥",
      "transliteration": "moo(n)dd ja(n)gh baahan bin keene ||",
      "translation": "She would cut their faces, arms and legs,",
      "punjabiViakhya": "(ਉਹ) ਉਨ੍ਰਹਾ ਨੂੰ ਟੰਗਾ, ਬਾਹਵਾ ਅਤੇ ਸਿਰ ਤੋਂ ਬਿਨਾ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "मूँड जंघ बाहन बिनु कीने ॥",
      "sourceLineId": "116338",
      "sourceShabadId": "10621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪਠੈ ਧਾਮ ਜਮ ਕੇ ਸੋ ਦੀਨੇ ॥੨੦॥",
      "transliteration": "paThai dhaam jam ke so dheene ||20||",
      "translation": "And send them straight to the domain of death.(20)",
      "punjabiViakhya": "ਜਮਲੋਕ ਭੇਜ ਦਿੰਦੀ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "पठै धाम जम के सो दीने ॥२०॥",
      "sourceLineId": "116339",
      "sourceShabadId": "10621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੂਝਿ ਅਨੇਕ ਸੁਭਟ ਰਨ ਗਏ ॥",
      "transliteration": "joojh anek subhaT ran ge ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੇਕਾ ਸੂਰਮੇ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਜੂਝ ਮਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "जूझि अनेक सुभट रन गए ॥",
      "sourceLineId": "116340",
      "sourceShabadId": "10621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹੈ ਗੈ ਰਥੀ ਬਿਨਾ ਅਸਿ ਭਏ ॥",
      "transliteration": "hai gai rathee binaa as bhe ||",
      "translation": "Numerous braves lost their lives and were made to relinquish their chariots, horses and elephants.",
      "punjabiViakhya": "ਅਤੇ ਹਾਥੀਆਂ, ਘੋੜਿਆਂ, ਰਥਾ ਅਤੇ ਤਲਵਾਰਾ ਤੋਂ ਬਿਨਾ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "है गै रथी बिना असि भए ॥",
      "sourceLineId": "116341",
      "sourceShabadId": "10621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜੂਝੈ ਬੀਰ ਖੇਤ ਭਟ ਭਾਰੀ ॥",
      "transliteration": "joojhai beer khet bhaT bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਡੇ ਸੂਰਮੇ ਯੁੱਧ-ਖੇਤਰ ਵਿਚ ਜੂਝ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "जूझै बीर खेत भट भारी ॥",
      "sourceLineId": "116342",
      "sourceShabadId": "10621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾਚੇ ਸੂਰ ਬੀਰ ਹੰਕਾਰੀ ॥੨੧॥",
      "transliteration": "naache soor beer ha(n)kaaree ||21||",
      "translation": "A great number lost their lives and the egoist (alive) ories commenced dancing.(21)",
      "punjabiViakhya": "ਅਤੇ ਹੰਕਾਰੀ ਸੂਰਮੇ ਨੱਚਣ ਲਗੇ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "नाचे सूर बीर हंकारी ॥२१॥",
      "sourceLineId": "116343",
      "sourceShabadId": "10621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "116344",
      "sourceShabadId": "10622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਲਗੇ ਬ੍ਰਿਣਨ ਕੇ ਸੂਰਮਾ ਪਰੇ ਧਰਨਿ ਪੈ ਆਇ ॥",
      "transliteration": "lage biranan ke sooramaa pare dharan pai aai ||",
      "translation": "",
      "punjabiViakhya": "ਜ਼ਖ਼ਮ ਦੇ ਲਗਣ ਕਰ ਕੇ ਸੂਰਮੇਾਂ ਧਰਤੀ ਉਤੇ ਆਣ ਡਿਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "लगे बृणन के सूरमा परे धरनि पै आइ ॥",
      "sourceLineId": "116345",
      "sourceShabadId": "10622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗਿਰ ਪਰੇ ਉਠਿ ਪੁਨਿ ਲਰੇ ਅਧਿਕ ਹ੍ਰਿਦੈ ਕਰਿ ਚਾਇ ॥੨੨॥",
      "transliteration": "gir pare uTh pun lare adhik hiradhai kar chai ||22||",
      "translation": "",
      "punjabiViakhya": "ਡਿਗ ਕੇ ਫਿਰ ਉਠੇ ਅਤੇ ਹਿਰਦੇ ਵਿਚ ਉਤਸਾਹ ਭਰ ਕੇ ਲੜਨ ਲਗੇ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "गिर परे उठि पुनि लरे अधिक हृदै करि चाइ ॥२२॥",
      "sourceLineId": "116346",
      "sourceShabadId": "10622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭੁਜੰਗ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g chha(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਭੁਜੰਗ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "भुजंग छंद ॥",
      "sourceLineId": "116347",
      "sourceShabadId": "10623",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਿਤੇ ਗੋਫਨੈ ਗੁਰਜ ਗੋਲੇ ਉਭਾਰੈ ॥",
      "transliteration": "kite gofanai guraj gole ubhaarai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਧਰੇ ਗੋਫਨੇ, ਗੁਰਜ ਅਤੇ ਗੋਲੇ ਉਭਾਰਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "किते गोफनै गुरज गोले उभारै ॥",
      "sourceLineId": "116348",
      "sourceShabadId": "10623",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਿਤੇ ਚੰਦ੍ਰ ਤ੍ਰਿਸੂਲ ਸੈਥੀ ਸੰਭਾਰੈ ॥",
      "transliteration": "kite cha(n)dhr tirasool saithee sa(n)bhaarai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਧਰੇ ਚੰਦ੍ਰ ਮੁਖੀ ਵਾਲੇ ਤੀਰ, ਤ੍ਰਿਸ਼ੂਲ ਅਤੇ ਸੈਹੱਥੀਆਂ ਸੰਭਾਲਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "किते चंद्र तृसूल सैथी संभारै ॥",
      "sourceLineId": "116349",
      "sourceShabadId": "10623",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਿਤੇ ਪਰਘ ਫਾਸੀ ਲਏ ਹਾਥ ਡੋਲੈ ॥",
      "transliteration": "kite paragh faasee le haath ddolai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਧਰੇ ਪਰਘ, ਫਾਸ (ਆਦਿ ਸ਼ਸਤ੍ਰ) ਹੱਥਾ ਵਿਚ ਲਈ ਫਿਰਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "किते परघ फासी लए हाथ डोलै ॥",
      "sourceLineId": "116350",
      "sourceShabadId": "10623",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਿਤੇ ਮਾਰ ਹੀ ਮਾਰਿ ਕੈ ਬੀਰ ਬੋਲੈ ॥੨੩॥",
      "transliteration": "kite maar hee maar kai beer bolai ||23||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਧਰੇ ਸੂਰਮੇ 'ਮਾਰੋ-ਮਾਰੋ' ਪੁਕਾਰਦੇ ਹਨ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "किते मार ही मारि कै बीर बोलै ॥२३॥",
      "sourceLineId": "116351",
      "sourceShabadId": "10623",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "116352",
      "sourceShabadId": "10624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਤਿ ਚਿਤ ਕੋਪ ਬਢਾਇ ਕੈ ਸੂਰਨ ਸਕਲਨ ਘਾਇ ॥",
      "transliteration": "at chit kop baddai kai sooran sakalan ghai ||",
      "translation": "With extreme acrimony in their minds and after killing many fearless ones,",
      "punjabiViakhya": "(ਆਪਣੇ) ਮਨ ਵਿਚ ਬਹੁਤ ਕ੍ਰੋਧ ਵਧਾ ਕੇ ਅਤੇ ਸਾਰਿਆਂ ਸੂਰਮਿਆਂ ਨੂੰ ਮਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "अति चित कोप बढाइ कै सूरन सकलन घाइ ॥",
      "sourceLineId": "116353",
      "sourceShabadId": "10624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਹਾ ਬਾਲਿ ਠਾਢੀ ਹੁਤੀ ਤਹਾ ਪਰਤ ਭੇ ਆਇ ॥੨੪॥",
      "transliteration": "jahaa baal Thaaddee hutee tahaa parat bhe aai ||24||",
      "translation": "They (enemy) reached there, where the woman was standing.(24)",
      "punjabiViakhya": "ਉਥੇ ਪਰਤ ਆਏ ਹਨ ਜਿਥੇ ਪਠਾਣੀ ਖੜੋਤੀ ਸੀ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "जहा बालि ठाढी हुती तहा परत भे आइ ॥२४॥",
      "sourceLineId": "116354",
      "sourceShabadId": "10624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116355",
      "sourceShabadId": "10625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਿਚਪਚਾਇ ਜੋਧਾ ਸਮੁਹਾਵੈ ॥",
      "transliteration": "kichapachai jodhaa samuhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਕਚੀਚੀਆਂ ਵਟ ਕੇ ਯੋਧੇ ਸਾਹਮਣੇ ਆਉਾਂਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "किचपचाइ जोधा समुहावै ॥",
      "sourceLineId": "116356",
      "sourceShabadId": "10625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਚਟਪਟ ਸੁਭਟ ਬਿਕਟ ਕਟਿ ਜਾਵੈ ॥",
      "transliteration": "chaTapaT subhaT bikaT kaT jaavai ||",
      "translation": "The enraged gallant ones came ahead but were cut instantly.",
      "punjabiViakhya": "ਅਤੇ ਝਟਪਟ ਕਠੋਰ ਸੂਰਮੇ ਕਟੇ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "चटपट सुभट बिकट कटि जावै ॥",
      "sourceLineId": "116357",
      "sourceShabadId": "10625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜੂਝਿ ਪ੍ਰਾਨ ਸਨਮੁਖ ਜੇ ਦੇਹੀ ॥",
      "transliteration": "joojh praan sanamukh je dhehee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸਨਮੁਖ ਹੋ ਕੇ ਪ੍ਰਾਣ ਛਡਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "जूझि प्रान सनमुख जे देही ॥",
      "sourceLineId": "116358",
      "sourceShabadId": "10625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਡਾਰਿ ਬਿਵਾਨ ਬਰੰਗਨਿ ਲੇਹੀ ॥੨੫॥",
      "transliteration": "ddaar bivaan bara(n)gan lehee ||25||",
      "translation": "They relinquished their souls and were taken away by the fairies in the palanquins (of death).(25)",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੂੰ) ਅਪੱਛਰਾਵਾ ਬਿਮਾਨਾ ਵਿਚ ਪਾ ਲੈਂਦੀਆਂ ਹਨ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "डारि बिवान बरंगनि लेही ॥२५॥",
      "sourceLineId": "116359",
      "sourceShabadId": "10625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "116360",
      "sourceShabadId": "10626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜੇ ਭਟ ਆਨਿ ਅਪਛਰਨਿ ਲਏ ਬਿਵਾਨ ਚੜਾਇ ॥",
      "transliteration": "je bhaT aan apachharan le bivaan chaRai ||",
      "translation": "When the enemies were cut and taken away, the woman girded up her lions.",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਸੂਰਮਿਆਂ ਨੂੰ ਅਪੱਛਰਾਵਾ ਨੇ ਬਿਮਾਨਾ ਉਤੇ ਚੜ੍ਰਹਾ ਲਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "जे भट आनि अपछरनि लए बिवान चड़ाइ ॥",
      "sourceLineId": "116361",
      "sourceShabadId": "10626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0929_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਿਨਿ ਪ੍ਰਤਿ ਔਰ ਨਿਹਾਰਿ ਕੈ ਲਰਤੁ ਸੂਰ ਸਮੁਹਾਇ ॥੨੬॥",
      "transliteration": "tin prat aauar nihaar kai larat soor samuhai ||26||",
      "translation": "With single stroke she annihilated many enemies.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਵੇਖ ਕੇ ਹੋਰ ਸੂਰਮੇ ਸਨਮੁਖ ਹੋ ਕੇ ਲੜਦੇ ਹਨ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 929,
      "hindi": "",
      "hindiTransliteration": "तिनि प्रति और निहारि कै लरतु सूर समुहाइ ॥२६॥",
      "sourceLineId": "116362",
      "sourceShabadId": "10626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
