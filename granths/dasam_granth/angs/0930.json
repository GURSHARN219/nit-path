{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 930,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0930_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭੁਜੰਗ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g chha(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਭੁਜੰਗ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "भुजंग छंद ॥",
      "sourceLineId": "116363",
      "sourceShabadId": "10627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚਹੂੰ ਓਰ ਤੇ ਚਾਵਡੈ ਚੀਤਕਾਰੀ ॥",
      "transliteration": "chahoo(n) or te chaavaddai cheetakaaree ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ ਇਲਾ ਚੀਕਾ ਮਾਰਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "चहूँ ओर ते चावडै चीतकारी ॥",
      "sourceLineId": "116364",
      "sourceShabadId": "10627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਹੇ ਗਿਧ ਆਕਾਸ ਮੰਡਰਾਇ ਭਾਰੀ ॥",
      "transliteration": "rahe gidh aakaas ma(n)ddarai bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਆਕਾਸ਼ ਵਿਚ ਵੱਡੀਆਂ ਗਿਧਾ ਮੰਡਰਾ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "रहे गिध आकास मंडराइ भारी ॥",
      "sourceLineId": "116365",
      "sourceShabadId": "10627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਲਗੇ ਘਾਇ ਜੋਧਾ ਗਿਰੇ ਭੂਮਿ ਭਾਰੇ ॥",
      "transliteration": "lage ghai jodhaa gire bhoom bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਡੇ ਯੋਧੇ ਘਾਓ ਲਗਣ ਤੇ ਭੂਮੀ ਉਤੇ ਡਿਗੇ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "लगे घाइ जोधा गिरे भूमि भारे ॥",
      "sourceLineId": "116366",
      "sourceShabadId": "10627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਐਸੀ ਭਾਤਿ ਝੂਮੇ ਮਨੌ ਮਤਵਾਰੇ ॥੨੭॥",
      "transliteration": "aaisee bhaat jhoome manau matavaare ||27||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਝੂਮਦੇ ਹਨ, ਮਾਨੋ ਬਹੁਤ ਹੀ ਮਸਤੀ ਵਿਚ ਹੋਣ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "ऐसी भाति झूमे मनौ मतवारे ॥२७॥",
      "sourceLineId": "116367",
      "sourceShabadId": "10627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪਰੀ ਬਾਨ ਗੋਲਾਨ ਕੀ ਭੀਰ ਭਾਰੀ ॥",
      "transliteration": "paree baan golaan kee bheer bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਗੋਲਿਆਂ ਅਤੇ ਬਾਣਾ ਦੀ ਭਾਰੀ (ਬਰਖਾ) ਹੋ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "परी बान गोलान की भीर भारी ॥",
      "sourceLineId": "116368",
      "sourceShabadId": "10627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਹੈ ਤੀਰ ਤਰਵਾਰਿ ਕਾਤੀ ਕਟਾਰੀ ॥",
      "transliteration": "bahai teer taravaar kaatee kaTaaree ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰਾ, ਛੁਰੀਆਂ, ਕਟਾਰਾ ਅਤੇ ਤੀਰ ਚਲ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "बहै तीर तरवारि काती कटारी ॥",
      "sourceLineId": "116369",
      "sourceShabadId": "10627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹਠੈ ਐਠਿਯਾਰੇ ਮਹਾਬੀਰ ਧਾਏ ॥",
      "transliteration": "haThai aaiThiyaare mahaabeer dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਡੇ ਹਠੀ ਅਤੇ ਹੈਂਕੜਬਾਜ਼ ਸੂਰਮੇ ਪੈ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "हठै ऐठियारे महाबीर धाए ॥",
      "sourceLineId": "116370",
      "sourceShabadId": "10627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਧੇ ਗੋਲ ਗਾੜੇ ਚਲੇ ਖੇਤ ਆਏ ॥੨੮॥",
      "transliteration": "badhe gol gaaRe chale khet aae ||28||",
      "translation": "",
      "punjabiViakhya": "ਗੋਲ ਪਰ੍ਰਹੇ ਬਣਾ ਕੇ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਆ ਗਏ ਹਨ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "बधे गोल गाड़े चले खेत आए ॥२८॥",
      "sourceLineId": "116371",
      "sourceShabadId": "10627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗੁਰਿਯਾ ਖੇਲ ਮਹਮੰਦਿ ਲੇਜਾਕ ਮਾਰੇ ॥",
      "transliteration": "guriyaa khel mahama(n)dh lejaak maare ||",
      "translation": "",
      "punjabiViakhya": "ਗੁਰਿਯਾ ਖੇਲ (ਗੁਰੇਖੇਲ) ਮਹਮੰਦਿ, ਲੇਜਾਕ,",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "गुरिया खेल महमंदि लेजाक मारे ॥",
      "sourceLineId": "116372",
      "sourceShabadId": "10627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦਓਜਈ ਅਫਰੀਤਿ ਲੋਦੀ ਸੰਘਾਰੇ ॥",
      "transliteration": "dhojiee afareet lodhee sa(n)ghaare ||",
      "translation": "",
      "punjabiViakhya": "ਦਓਜਈ, ਅਫਰੀਦੀ ਅਤੇ ਲੋਦੀ ਜਾਤਾ ਵਾਲੇ ਮਾਰੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "दओजई अफरीति लोदी संघारे ॥",
      "sourceLineId": "116373",
      "sourceShabadId": "10627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਲੀ ਸੂਰ ਨ੍ਰਯਾਜੀ ਐਸੀ ਭਾਤਿ ਕੂਟੇ ॥",
      "transliteration": "balee soor nrayaajee aaisee bhaat kooTe ||",
      "translation": "",
      "punjabiViakhya": "ਬਲਵਾਨ ਨਿਆਜ਼ੀ ਸੂਰਮੇ ਇਸ ਤਰ੍ਰਹਾ ਕੁਟੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "बली सूर न्रयाजी ऐसी भाति कूटे ॥",
      "sourceLineId": "116374",
      "sourceShabadId": "10627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚਲੇ ਭਾਜ ਜੋਧਾ ਸਭੈ ਸੀਸ ਫੂਟੇ ॥੨੯॥",
      "transliteration": "chale bhaaj jodhaa sabhai sees fooTe ||29||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਦੇ) ਸਿਰ ਪਾਟ ਗਏ ਹਨ, ਉਹ ਸਭ ਸੂਰਮੇ ਭਜ ਚਲੇ ਹਨ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "चले भाज जोधा सभै सीस फूटे ॥२९॥",
      "sourceLineId": "116375",
      "sourceShabadId": "10627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਵੈਯਾ ॥",
      "transliteration": "savaiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੈਯਾ:",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "सवैया ॥",
      "sourceLineId": "116376",
      "sourceShabadId": "10628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੂਰ ਗਏ ਕਟਿ ਕੈ ਝਟ ਦੈ ਤਬ ਬਾਲ ਕੁਪੀ ਹਥਿਆਰ ਸੰਭਾਰੇ ॥",
      "transliteration": "soor ge kaT kai jhaT dhai tab baal kupee hathiaar sa(n)bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਸੂਰਮੇ ਕਟ ਕੇ ਜਲਦੀ ਨਾਲ ਚਲੇ ਗਏ ਤਾ ਪਠਾਣੀ ਹਥਿਆਰ ਸੰਭਾਲ ਕੇ ਬਹੁਤ ਗੁੱਸੇ ਵਿਚ ਆ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "सूर गए कटि कै झट दै तब बाल कुपी हथिआर संभारे ॥",
      "sourceLineId": "116377",
      "sourceShabadId": "10628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪਟਿਸ ਲੋਹ ਹਥੀ ਪਰਸੇ ਇਕ ਬਾਰ ਹੀ ਬੈਰਨਿ ਕੇ ਤਨ ਝਾਰੇ ॥",
      "transliteration": "paTis loh hathee parase ik baar hee bairan ke tan jhaare ||",
      "translation": "Some had tried to fight, some died of dread and those who were saved were as good as dead.",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕੋ ਵਾਰ ਪਟਿਸ, ਲੋਹ-ਹਥੀਆਂ ਅਤੇ ਪਰਸੇ ਵੈਰੀਆਂ ਦੇ ਸ਼ਰੀਰ ਉਤੇ ਮਾਰੇ।",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "पटिस लोह हथी परसे इक बार ही बैरनि के तन झारे ॥",
      "sourceLineId": "116378",
      "sourceShabadId": "10628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਏਕ ਲਰੇ ਇਕ ਹਾਰਿ ਟਰੇ ਇਕ ਦੇਖਿ ਡਰੇ ਮਰਿ ਗੇ ਬਿਨੁ ਮਾਰੇ ॥",
      "transliteration": "ek lare ik haar Tare ik dhekh ddare mar ge bin maare ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਲੜਦੇ ਹਨ, ਇਕ ਹਾਰ ਕੇ ਟਲ ਜਾਦੇ ਹਨ, ਇਕ ਵੇਖ ਕੇ ਡਰ ਗਏ ਹਨ ਅਤੇ ਇਕ ਮਾਰੇ ਬਿਨਾ ਹੀ ਮਾਰੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "एक लरे इक हारि टरे इक देखि डरे मरि गे बिनु मारे ॥",
      "sourceLineId": "116379",
      "sourceShabadId": "10628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬੀਰ ਕਰੋਰਿ ਸਰਾਸਨ ਛੋਰਿ ਤ੍ਰਿਣਾਨ ਕੌ ਤੋਰਿ ਸੁ ਆਨਨ ਡਾਰੇ ॥੩੦॥",
      "transliteration": "beer karor saraasan chhor tiranaan kau tor su aanan ddaare ||30||",
      "translation": "And thousands threw their bows and accepted defeat.(30)",
      "punjabiViakhya": "ਕ੍ਰੋੜਾ ਸੂਰਮਿਆਂ ਨੇ ਕਮਾਨਾ ਨੂੰ ਛਡ ਕੇ ਅਤੇ ਤੀਲਿਆਂ ਨੂੰ ਤੋੜ ਕੇ ਮੂੰਹ ਵਿਚ ਪਾਇਆ ਹੋਇਆ ਹੈ। (ਅਰਥਾਤ ਹਾਰ ਮੰਨੀ ਹੋਈ ਹੈ) ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "बीर करोरि सरासन छोरि तृणान कौ तोरि सु आनन डारे ॥३०॥",
      "sourceLineId": "116380",
      "sourceShabadId": "10628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116381",
      "sourceShabadId": "10629",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕੋਪੇ ਅਰਿ ਬਿਲੋਕਿ ਤਬ ਭਾਰੇ ॥",
      "transliteration": "kope ar bilok tab bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਵੈਰੀ ਇਹ ਵੇਖ ਕੇ ਬਹੁਤ ਕ੍ਰੋਧਵਾਨ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "कोपे अरि बिलोकि तब भारे ॥",
      "sourceLineId": "116382",
      "sourceShabadId": "10629",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦੁੰਦਭ ਚਲੇ ਬਜਾਇ ਨਗਾਰੇ ॥",
      "transliteration": "dhu(n)dhabh chale bajai nagaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਗਾਰੇ ਅਤੇ ਦੁੰਦਭੀਆਂ ਵਜਾ ਕੇ ਚਲ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "दुँदभ चले बजाइ नगारे ॥",
      "sourceLineId": "116383",
      "sourceShabadId": "10629",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਟੂਟੇ ਚਹੂੰ ਓਰ ਰਿਸਿ ਕੈ ਕੈ ॥",
      "transliteration": "TooTe chahoo(n) or ris kai kai ||",
      "translation": "",
      "punjabiViakhya": "(ਵੈਰੀ ਸੈਨਿਕ) ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "टूटे चहूँ ओर रिसि कै कै ॥",
      "sourceLineId": "116384",
      "sourceShabadId": "10629",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਆਯੁਧੁ ਲੈ ਕੈ ॥੩੧॥",
      "transliteration": "bhaat bhaat ke aayudh lai kai ||31||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦੇ ਹਥਿਆਰ ਲੈ ਕੇ ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ ਟੁਟ ਕੇ ਪੈ ਗਏ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के आयुधु लै कै ॥३१॥",
      "sourceLineId": "116385",
      "sourceShabadId": "10629",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "116386",
      "sourceShabadId": "10630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਜ੍ਰਬਾਨ ਬਿਛੂਆ ਬਿਸਿਖ ਬਰਸਿਯੋ ਸਾਰ ਅਪਾਰ ॥",
      "transliteration": "bajrabaan bichhooaa bisikh barasiyo saar apaar ||",
      "translation": "",
      "punjabiViakhya": "ਬਜ੍ਰਬਾਨ, ਬਿਛੂਆ, ਤੀਰ ਆਦਿ ਦੇ ਰੂਪ ਵਿਚ ਬਹੁਤ ਲੋਹਾ ਵਰ੍ਰਹਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "बज्रबान बिछूआ बिसिख बरसियो सार अपार ॥",
      "sourceLineId": "116387",
      "sourceShabadId": "10630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਊਚ ਨੀਚ ਕਾਯਰ ਸੁਭਟ ਸਭ ਕੀਨੇ ਇਕ ਸਾਰ ॥੩੨॥",
      "transliteration": "uooch neech kaayar subhaT sabh keene ik saar ||32||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਉੱਚੇ ਨੀਵੇਾਂ, ਕਾਇਰ ਅਤੇ ਸੂਰਮੇ ਸਭ ਨੂੰ ਇਕ ਸਮਾਨ ਕਰ ਦਿੱਤਾ ॥੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "ऊच नीच कायर सुभट सभ कीने इक सार ॥३२॥",
      "sourceLineId": "116388",
      "sourceShabadId": "10630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116389",
      "sourceShabadId": "10631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਐਸੀ ਭਾਤਿ ਖੇਤ ਜਬ ਪਰਿਯੋ ॥",
      "transliteration": "aaisee bhaat khet jab pariyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਜਦੋਂ ਯੁੱਧ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "ऐसी भाति खेत जब परियो ॥",
      "sourceLineId": "116390",
      "sourceShabadId": "10631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਰਬ ਰਾਇ ਕੁਪਿ ਬਚਨ ਉਚਰਿਯੋ ॥",
      "transliteration": "arab rai kup bachan uchariyo ||",
      "translation": "When such a situation arose, Arth Rai (the enemy) said aloud,",
      "punjabiViakhya": "ਤਾ ਅਰਬ ਦੇਸ਼ ਦੇ ਰਾਜੇ ਨੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "अरब राइ कुपि बचन उचरियो ॥",
      "sourceLineId": "116391",
      "sourceShabadId": "10631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਯਾ ਕੋ ਜਿਯਤ ਜਾਨ ਨਹੀ ਦੀਜੈ ॥",
      "transliteration": "yaa ko jiyat jaan nahee dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਨੂੰ ਜੀਉਾਂਦੇ ਜਾਣ ਨਹੀਂ ਦੇਣਾ",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "या को जियत जान नही दीजै ॥",
      "sourceLineId": "116392",
      "sourceShabadId": "10631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਘੇਰਿ ਦਸੋ ਦਿਸਿ ਤੇ ਬਧੁ ਕੀਜੈ ॥੩੩॥",
      "transliteration": "gher dhaso dhis te badh keejai ||33||",
      "translation": "‘Don’t let them go, surround them and give tough fight.’(33)",
      "punjabiViakhya": "ਅਤੇ ਹਰ ਪਾਸਿਓਾਂ ਘੇਰ ਕੇ ਮਾਰ ਦੇਣਾ ਹੈ ॥੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "घेरि दसो दिसि ते बधु कीजै ॥३३॥",
      "sourceLineId": "116393",
      "sourceShabadId": "10631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਰਬ ਰਾਇ ਕੁਪਿ ਬਚਨ ਉਚਾਰੇ ॥",
      "transliteration": "arab rai kup bachan uchaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਰਬ ਦੇ ਰਾਜੇ ਨੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਬਚਨ ਉਚਾਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "अरब राइ कुपि बचन उचारे ॥",
      "sourceLineId": "116394",
      "sourceShabadId": "10631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕੋਪੇ ਸੂਰਬੀਰ ਐਠ੍ਰਯਾਰੇ ॥",
      "transliteration": "kope soorabeer aaiThrayaare ||",
      "translation": "Listening to his spirited talk, his egoist ones got ready.",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨੂੰ ਸੁਣ ਕੇ) ਹੰਕਾਰੀ ਸੂਰਮੇ ਕ੍ਰੋਧਵਾਨ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "कोपे सूरबीर ऐठ्रयारे ॥",
      "sourceLineId": "116395",
      "sourceShabadId": "10631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਾਨਿ ਕਮਾਨਨ ਬਾਨ ਚਲਾਏ ॥",
      "transliteration": "taan kamaanan baan chalaae ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਕਮਾਨਾ ਕਸ ਕੇ ਬਾਣ ਚਲਾਏ,",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "तानि कमानन बान चलाए ॥",
      "sourceLineId": "116396",
      "sourceShabadId": "10631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬੇਧਿ ਬਾਲ ਕੋ ਪਾਰ ਪਰਾਏ ॥੩੪॥",
      "transliteration": "bedh baal ko paar paraae ||34||",
      "translation": "They shot the arrows from their bows and hit through the lady.(34)",
      "punjabiViakhya": "ਜੋ ਉਸ ਇਸਤਰੀ (ਪਠਾਣੀ) ਨੂੰ ਵਿੰਨ ਕੇ ਪਾਰ ਹੋ ਗਏ ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "बेधि बाल को पार पराए ॥३४॥",
      "sourceLineId": "116397",
      "sourceShabadId": "10631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "116398",
      "sourceShabadId": "10632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬੇਧਿ ਬਾਨ ਜਬ ਤਨ ਗਏ ਤਬ ਤ੍ਰਿਯ ਕੋਪ ਬਢਾਇ ॥",
      "transliteration": "bedh baan jab tan ge tab tiray kop baddai ||",
      "translation": "When her body was struck with arrows, she became wrathful.",
      "punjabiViakhya": "ਜਦੋਂ ਬਾਣ ਇਸਤਰੀ ਦਾ ਸ਼ਰੀਰ ਵਿੰਨ੍ਰਹ ਗਏ (ਤਦ ਉਸ ਨੇ ਆਪਣੇ ਮਨ ਵਿਚ) ਬਹੁਤ ਗੁੱਸਾ ਵਧਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "बेधि बान जब तन गए तब तृय कोप बढाइ ॥",
      "sourceLineId": "116399",
      "sourceShabadId": "10632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਮਿਤ ਜੁਧ ਤਿਹ ਠਾ ਕਿਯੋ ਸੋ ਮੈ ਕਹਤ ਬਨਾਇ ॥੩੫॥",
      "transliteration": "amit judh teh Thaa kiyo so mai kahat banai ||35||",
      "translation": "The frightful fighting, which she ensued, I am, now, going to relate that,(35)",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਉਥੇ ਬੇਹਦ ਯੁੱਧ ਕੀਤਾ। (ਹੁਣ) ਉਸ ਦਾ ਮੈਂ ਵਰਣਨ ਕਰਦਾ ਹਾ ॥੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "अमित जुध तिह ठा कियो सो मै कहत बनाइ ॥३५॥",
      "sourceLineId": "116400",
      "sourceShabadId": "10632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116401",
      "sourceShabadId": "10633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਲਗੇ ਦੇਹ ਤੇ ਬਾਨ ਨਿਕਾਰੇ ॥",
      "transliteration": "lage dheh te baan nikaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਸ਼ਰੀਰ ਵਿਚ ਲਗੇ ਬਾਣ ਕੱਢੇ",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "लगे देह ते बान निकारे ॥",
      "sourceLineId": "116402",
      "sourceShabadId": "10633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਨ ਪੁਨਿ ਵਹੈ ਬੈਰਿਯਨ ਮਾਰੇ ॥",
      "transliteration": "tan pun vahai bairiyan maare ||",
      "translation": "The arrows, which had pierced through, she plucked them",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਉਹੀ ਖਿਚ ਕੇ ਵੈਰੀਆਂ ਨੂੰ ਮਾਰੇ।",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "तन पुनि वहै बैरियन मारे ॥",
      "sourceLineId": "116403",
      "sourceShabadId": "10633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਿਨ ਕੀ ਦੇਹ ਘਾਵ ਦਿੜ ਲਾਗੇ ॥",
      "transliteration": "jin kee dheh ghaav dhiR laage ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦੇ ਸ਼ਰੀਰ ਉਤੇ ਵੱਡੇ ਜ਼ਖ਼ਮ ਲਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "जिन की देह घाव दिड़ लागे ॥",
      "sourceLineId": "116404",
      "sourceShabadId": "10633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤੁਰਤ ਬਰੰਗਨਿਨ ਸੋ ਅਨੁਰਾਗੇ ॥੩੬॥",
      "transliteration": "turat bara(n)ganin so anuraage ||36||",
      "translation": "Out, and threw the same back on the enemy.(36)",
      "punjabiViakhya": "ਉਹ ਤੁਰਤ ਅਪੱਛਰਾਵਾ ਦੇ ਪ੍ਰੇਮੀ ਬਣ ਗਏ (ਅਰਥਾਤ ਉਨ੍ਰਹਾ ਨੂੰ ਵਰ ਲਿਆ) ॥੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "तुरत बरंगनिन सो अनुरागे ॥३६॥",
      "sourceLineId": "116405",
      "sourceShabadId": "10633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਐਸੀ ਭਾਤਿ ਬੀਰ ਬਹੁ ਮਾਰੇ ॥",
      "transliteration": "aaisee bhaat beer bahu maare ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਬਹੁਤ ਸੂਰਮੇ ਮਾਰੇ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "ऐसी भाति बीर बहु मारे ॥",
      "sourceLineId": "116406",
      "sourceShabadId": "10633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਾਜੀ ਕਰੀ ਰਥੀ ਹਨਿ ਡਾਰੇ ॥",
      "transliteration": "baajee karee rathee han ddaare ||",
      "translation": "Whom so ever those arrows hit, they were taken away by the fairies",
      "punjabiViakhya": "ਹਾਥੀ ('ਕਰੀ') ਘੋੜੇ ਅਤੇ ਰਥਾ ਵਾਲੇ ਮਾਰੇ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "बाजी करी रथी हनि डारे ॥",
      "sourceLineId": "116407",
      "sourceShabadId": "10633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤੁਮਲ ਜੁਧ ਤਿਹ ਠਾ ਅਤਿ ਮਚਿਯੋ ॥",
      "transliteration": "tumal judh teh Thaa at machiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਥਾ ਬਹੁਤ ਘਮਸਾਨ ਯੁੱਧ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "तुमल जुध तिह ठा अति मचियो ॥",
      "sourceLineId": "116408",
      "sourceShabadId": "10633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਏਕ ਸੂਰ ਜੀਯਤ ਨਹ ਬਚਿਯੋ ॥੩੭॥",
      "transliteration": "ek soor jeeyat neh bachiyo ||37||",
      "translation": "Of death and none was spared the life.(37)",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਸੂਰਮਾ ਵੀ ਜੀਉਾਂਦਾ ਨਾ ਬਚਿਆ ॥੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 930,
      "hindi": "",
      "hindiTransliteration": "एक सूर जीयत नह बचियो ॥३७॥",
      "sourceLineId": "116409",
      "sourceShabadId": "10633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0930_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਰਬ ਰਾਇ ਆਪਨ ਤਬ ਧਾਯੋ ॥",
      "transliteration": "arab rai aapan tab dhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਅਰਬ ਦਾ ਰਾਜਾ ਆਪ ਅਗੇ ਵਧਿਆ",
      "source": "DASAM_GRANTH",
