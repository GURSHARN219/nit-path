{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 932,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0932_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਹਾ ਲੌ ਗਨੌ ਮੈ ਨਹੀ ਜਾਤ ਬੂਝੇ ॥੯॥",
      "transliteration": "kahaa lau ganau mai nahee jaat boojhe ||9||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਕਿਥੋਂ ਤਕ ਗਿਣਾ, (ਮੈਥੋਂ) ਗਿਣੇ ਨਹੀਂ ਜਾਦੇ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "कहा लौ गनौ मै नही जात बूझे ॥९॥",
      "sourceLineId": "116459",
      "sourceShabadId": "10642",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰੂਆਲ ਛੰਦ ॥",
      "transliteration": "rooaal chha(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਰੂਆਲ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "रूआल छंद ॥",
      "sourceLineId": "116460",
      "sourceShabadId": "10643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਮਿਤ ਸੈਨਾ ਲੈ ਚਲਿਯੋ ਤਹ ਆਪੁ ਰਾਜਾ ਸੰਗ ॥",
      "transliteration": "amit sainaa lai chaliyo teh aap raajaa sa(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜਾ ਬਹੁਤ ਸਾਰੀ ਸੈਨਾ ਆਪਣੇ ਨਾਲ ਲੈ ਕੇ ਚਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "अमित सैना लै चलियो तह आपु राजा संग ॥",
      "sourceLineId": "116461",
      "sourceShabadId": "10643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੋਰਿ ਕੋਰਿ ਸੁ ਬੀਰ ਮੰਤ੍ਰੀ ਸਸਤ੍ਰ ਧਾਰਿ ਸੁਰੰਗਿ ॥",
      "transliteration": "jor kor su beer ma(n)tree sasatr dhaar sura(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਿਚ ਕ੍ਰੋੜਾ ਸੂਰਮੇ ਅਤੇ ਮੰਤ੍ਰੀ ਇਕੱਠੇ ਕਰ ਕੇ ਅਤੇ ਸੁੰਦਰ ਸ਼ਸਤ੍ਰ ਸਜਾ ਕੇ (ਸ਼ਾਮਲ ਹੋ ਗਏ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "जोरि कोरि सु बीर मंत्री ससत्र धारि सुरंगि ॥",
      "sourceLineId": "116462",
      "sourceShabadId": "10643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੂਲ ਸੈਥਿਨ ਕੇ ਲਗੇ ਅਰੁ ਬੇਧਿ ਬਾਨਨ ਸਾਥ ॥",
      "transliteration": "sool saithin ke lage ar bedh baanan saath ||",
      "translation": "",
      "punjabiViakhya": "ਤ੍ਰਿਸੂਲਾ, ਸੈਹੱਥੀਆਂ ਦੇ ਲਗਣ ਨਾਲ ਅਤੇ ਬਾਣਾ ਨਾਲ ਵਿੰਨ੍ਰਹੇ ਜਾਣ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "सूल सैथिन के लगे अरु बेधि बानन साथ ॥",
      "sourceLineId": "116463",
      "sourceShabadId": "10643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜੂਝਿ ਜੂਝਿ ਗਏ ਤਹਾ ਰਨ ਭੂਮਿ ਮਧਿ ਪ੍ਰਮਾਥ ॥੧੦॥",
      "transliteration": "joojh joojh ge tahaa ran bhoom madh pramaath ||10||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਜੂਝ ਜੂਝ ਕੇ ਯੋਧੇ ਮਾਰੇ ਗਏ ਹਨ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "जूझि जूझि गए तहा रन भूमि मधि प्रमाथ ॥१०॥",
      "sourceLineId": "116464",
      "sourceShabadId": "10643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭੁਜੰਗ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g chha(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਭੁਜੰਗ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "भुजंग छंद ॥",
      "sourceLineId": "116465",
      "sourceShabadId": "10644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਗੇ ਜੰਗ ਜੋਧਾ ਗਏ ਜੂਝਿ ਭਾਰੇ ॥",
      "transliteration": "jage ja(n)g jodhaa ge joojh bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਜੰਗ ਦੇ ਸ਼ੁਰੂ ਹੋ ਜਾਣ ਨਾਲ ਬਹੁਤ ਯੋਧੇ ਮਾਰੇ ਗਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "जगे जंग जोधा गए जूझि भारे ॥",
      "sourceLineId": "116466",
      "sourceShabadId": "10644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਿਤੇ ਭੂਮਿ ਘੂਮੈ ਸੁ ਮਨੋ ਮਤਵਾਰੇ ॥",
      "transliteration": "kite bhoom ghoomai su mano matavaare ||",
      "translation": "In the heavy fighting they moved like adherents",
      "punjabiViakhya": "ਅਤੇ ਕਿਤਨੇ ਭੂਮੀ ਵਿਚ ਮਦ-ਮਸਤਾ ਵਾਗ ਭਵਾਟਣੀਆਂ ਖਾ ਕੇ ਡਿਗੇ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "किते भूमि घूमै सु मनो मतवारे ॥",
      "sourceLineId": "116467",
      "sourceShabadId": "10644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਿਤੇ ਮਾਰ ਹੀ ਮਾਰਿ ਐਸੇ ਪੁਕਾਰੈ ॥",
      "transliteration": "kite maar hee maar aaise pukaarai ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ 'ਮਾਰੋ-ਮਾਰੋ' ਇਸ ਤਰ੍ਰਹਾ ਪੁਕਾਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "किते मार ही मारि ऐसे पुकारै ॥",
      "sourceLineId": "116468",
      "sourceShabadId": "10644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਿਤੇ ਸਸਤ੍ਰ ਛੋਰੈ ਤ੍ਰਿਯਾ ਭੇਖ ਧਾਰੈ ॥੧੧॥",
      "transliteration": "kite sasatr chhorai tirayaa bhekh dhaarai ||11||",
      "translation": "At some places they were inflicted death and at some they relaxed like women.(11)",
      "punjabiViakhya": "ਕਈਆਂ ਨੇ ਸ਼ਸਤ੍ਰ ਛਡ ਕੇ ਇਸਤਰੀ ਦਾ ਭੇਸ ਧਾਰ ਲਿਆ ਹੈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "किते ससत्र छोरै तृया भेख धारै ॥११॥",
      "sourceLineId": "116469",
      "sourceShabadId": "10644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਬੈ ਆਨਿ ਜੋਧਾ ਚਹੂੰ ਘਾਤ ਗਜੇ ॥",
      "transliteration": "jabai aan jodhaa chahoo(n) ghaat gaje ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ ਯੋਧੇ ਆ ਕੇ ਗੱਜੇ।",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "जबै आनि जोधा चहूँ घात गजे ॥",
      "sourceLineId": "116470",
      "sourceShabadId": "10644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਹਾ ਸੰਖ ਔ ਦੁੰਦਭੀ ਨਾਦ ਵਜੇ ॥",
      "transliteration": "mahaa sa(n)kh aau dhu(n)dhabhee naadh vaje ||",
      "translation": "When the braves from both the sides bellowed, the trumpets and conch-shells started to blow.",
      "punjabiViakhya": "ਵੱਡੇ ਸੰਖਾ ਅਤੇ ਨਗਾਰਿਆਂ ਦੇ ਨਾਦ ਹੋਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "महा संख औ दुँदभी नाद वजे ॥",
      "sourceLineId": "116471",
      "sourceShabadId": "10644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪਰੀ ਜੌ ਅਭੀਤਾਨ ਕੀ ਭੀਰ ਭਾਰੀ ॥",
      "transliteration": "paree jau abheetaan kee bheer bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਨਿਡਰ ਸੂਰਮਿਆਂ ('ਅਭੀਤਾਨ') ਦੀ ਭੀੜ ਵਧ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "परी जौ अभीतान की भीर भारी ॥",
      "sourceLineId": "116472",
      "sourceShabadId": "10644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਬੈ ਆਪੁ ਸ੍ਰੀ ਕਾਲਿਕਾ ਕਿਲਕਾਰੀ ॥੧੨॥",
      "transliteration": "tabai aap sree kaalikaa kilakaaree ||12||",
      "translation": "When the crowds of the fighters amalgamated, the goddess came in shrieking.(12) shrieking.(12)",
      "punjabiViakhya": "ਤਦ ਆਪ ਕਾਲਿਕਾ ਨੇ ਕਿਲਕਾਰੀਆਂ ਮਾਰੀਆਂ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "तबै आपु स्री कालिका किलकारी ॥१२॥",
      "sourceLineId": "116473",
      "sourceShabadId": "10644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਹਾ ਆਪੁ ਲੈ ਰੁਦ੍ਰ ਡੌਰੂ ਬਜਾਯੋ ॥",
      "transliteration": "tahaa aap lai rudhr ddauaroo bajaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਆਪ ਸ਼ਿਵ ਨੇ ਡੌਰੂ ਲੈ ਕੇ ਵਜਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "तहा आपु लै रुद्र डौरू बजायो ॥",
      "sourceLineId": "116474",
      "sourceShabadId": "10644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚਤਰ ਸਾਠਿ ਮਿਲਿ ਜੋਗਨੀ ਗੀਤ ਗਾਯੋ ॥",
      "transliteration": "chatar saaTh mil joganee geet gaayo ||",
      "translation": "Shiva beat his drum too and all the sixty-four female yogis, began their singing.",
      "punjabiViakhya": "ਅਤੇ ਚੌਂਹਠ ਜੋਗਣਾ ਨੇ ਮਿਲ ਕੇ ਗੀਤ ਗਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "चतर साठि मिलि जोगनी गीत गायो ॥",
      "sourceLineId": "116475",
      "sourceShabadId": "10644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਹੂੰ ਕੋਪਿ ਕੈ ਡਾਕਨੀ ਹਾਕ ਮਾਰੈ ॥",
      "transliteration": "kahoo(n) kop kai ddaakanee haak maarai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਡਾਕਣੀਆਂ ਹੁੰਕਾਰਦੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "कहूँ कोपि कै डाकनी हाक मारै ॥",
      "sourceLineId": "116476",
      "sourceShabadId": "10644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਹੂੰ ਭੂਤ ਔ ਪ੍ਰੇਤ ਨਾਗੇ ਬਿਹਾਰੈ ॥੧੩॥",
      "transliteration": "kahoo(n) bhoot aau pret naage bihaarai ||13||",
      "translation": "The witches honked here and the ghosts performed naked dances.(13)",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਭੂਤ ਅਤੇ ਪ੍ਰੇਤ ਨੰਗੇ ਵਿਚਰ ਰਹੇ ਸਨ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "कहूँ भूत औ प्रेत नागे बिहारै ॥१३॥",
      "sourceLineId": "116477",
      "sourceShabadId": "10644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤੋਮਰ ਛੰਦ ॥",
      "transliteration": "tomar chha(n)dh ||",
      "translation": "Tomar Chhand",
      "punjabiViakhya": "ਤੋਮਰ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "तोमर छंद ॥",
      "sourceLineId": "116478",
      "sourceShabadId": "10645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਬ ਬਿਕ੍ਰਮੈ ਰਿਸਿ ਖਾਇ ॥",
      "transliteration": "tab bikramai ris khai ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਬਿਕ੍ਰਮ ਨੇ ਗੁੱਸਾ ਖਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "तब बिक्रमै रिसि खाइ ॥",
      "sourceLineId": "116479",
      "sourceShabadId": "10645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਭਟ ਭਾਤਿ ਭਾਤਿ ਬੁਲਾਇ ॥",
      "transliteration": "bhaT bhaat bhaat bulai ||",
      "translation": "Bikrim flew into the rage, and called every body in.",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦੇ ਯੋਧੇ ਬੁਲਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "भट भाति भाति बुलाइ ॥",
      "sourceLineId": "116480",
      "sourceShabadId": "10645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚਿਤ ਮੈ ਅਧਿਕ ਹਠ ਠਾਨਿ ॥",
      "transliteration": "chit mai adhik haTh Thaan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਚਿਤ ਵਿਚ ਅਧਿਕ ਹਠ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "चित मै अधिक हठ ठानि ॥",
      "sourceLineId": "116481",
      "sourceShabadId": "10645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਿਹ ਠਾ ਪਰਤ ਭੇ ਆਨਿ ॥੧੪॥",
      "transliteration": "teh Thaa parat bhe aan ||14||",
      "translation": "With great determination they gathered there,(14)",
      "punjabiViakhya": "ਉਸ ਥਾ ਤੇ ਆ ਕੇ ਇਕੱਠੇ ਹੋ ਗਏ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "तिह ठा परत भे आनि ॥१४॥",
      "sourceLineId": "116482",
      "sourceShabadId": "10645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਤਿ ਤਹ ਸੁ ਜੋਧਾ ਆਨਿ ॥",
      "transliteration": "at teh su jodhaa aan ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਬਹੁਤ ਅਧਿਕ ਯੋਧੇ ਆ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "अति तह सु जोधा आनि ॥",
      "sourceLineId": "116483",
      "sourceShabadId": "10645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਲਰਿ ਮਰਤ ਭੇ ਤਜਿ ਕਾਨਿ ॥",
      "transliteration": "lar marat bhe taj kaan ||",
      "translation": "Many bravt ones marched forward to sacrifice their lives.",
      "punjabiViakhya": "(ਕਿਸੇ ਦੀ) ਪਰਵਾਹ ਛਡ ਕੇ ਲੜਨ ਮਰਨ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "लरि मरत भे तजि कानि ॥",
      "sourceLineId": "116484",
      "sourceShabadId": "10645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਾਜੰਤ੍ਰ ਕੋਟਿ ਬਜਾਇ ॥",
      "transliteration": "baaja(n)tr koT bajai ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੇਕਾ ਵਾਜੇ ਵਜਣ ਲਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "बाजंत्र कोटि बजाइ ॥",
      "sourceLineId": "116485",
      "sourceShabadId": "10645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰਨ ਰਾਗ ਮਾਰੂ ਗਾਇ ॥੧੫॥",
      "transliteration": "ran raag maaroo gai ||15||",
      "translation": "Under recitation ofthe songs of death, the fighting was enhanced.(15)",
      "punjabiViakhya": "ਅਤੇ ਰਣ ਵਿਚ ਮਾਰੂ ਰਾਗ ਗਾਇਆ ਜਾਣ ਲਗਿਆ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "रन राग मारू गाइ ॥१५॥",
      "sourceLineId": "116486",
      "sourceShabadId": "10645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116487",
      "sourceShabadId": "10646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਆਨਿ ਪਰੇ ਤੇ ਸਕਲ ਨਿਬੇਰੇ ॥",
      "transliteration": "aan pare te sakal nibere ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ (ਉਥੇ) ਆ ਕੇ ਪਏ, ਉਹ ਸਾਰੇ ਨਿਬੇੜ ਦਿੱਤੇ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "आनि परे ते सकल निबेरे ॥",
      "sourceLineId": "116488",
      "sourceShabadId": "10646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਉਮਡੇ ਔਰ ਕਾਲ ਕੇ ਪ੍ਰੇਰੇ ॥",
      "transliteration": "aumadde aauar kaal ke prere ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ) ਕਾਲ ਦੇ ਪ੍ਰੇਰੇ ਹੋਏ ਹੋਰ ਉਮਡ ਕੇ ਪੈ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "उमडे और काल के प्रेरे ॥",
      "sourceLineId": "116489",
      "sourceShabadId": "10646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜੇ ਚਲਿ ਦਲ ਰਨ ਮੰਡਲ ਆਏ ॥",
      "transliteration": "je chal dhal ran ma(n)ddal aae ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਚਲ ਕੇ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਆ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "जे चलि दल रन मंडल आए ॥",
      "sourceLineId": "116490",
      "sourceShabadId": "10646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਲਰਿ ਮਰਿ ਕੈ ਸਭ ਸ੍ਵਰਗ ਸਿਧਾਏ ॥੧੬॥",
      "transliteration": "lar mar kai sabh savairag sidhaae ||16||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸਾਰੇ ਲੜ ਮਰੇ ਅਤੇ ਸਵਰਗ ਨੂੰ ਚਲੇ ਗਏ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "लरि मरि कै सभ स्वरग सिधाए ॥१६॥",
      "sourceLineId": "116491",
      "sourceShabadId": "10646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਐਸੀ ਭਾਤਿ ਸੈਨ ਜਬ ਲਰਿਯੋ ॥",
      "transliteration": "aaisee bhaat sain jab lariyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਜਦ ਸੈਨਾ ਲੜੀ",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "ऐसी भाति सैन जब लरियो ॥",
      "sourceLineId": "116492",
      "sourceShabadId": "10646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਏਕ ਬੀਰ ਜੀਯਤ ਨ ਉਬਰਿਯੋ ॥",
      "transliteration": "ek beer jeeyat na ubariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਕ ਸੂਰਮਾ ਵੀ ਜੀਉਾਂਦਾ ਨਾ ਬਚਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "एक बीर जीयत न उबरियो ॥",
      "sourceLineId": "116493",
      "sourceShabadId": "10646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਬ ਹਠਿ ਰਾਵ ਆਪਿ ਦੋਊ ਧਾਏ ॥",
      "transliteration": "tab haTh raav aap dhouoo dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦੋਵੇਾਂ ਰਾਜੇ ਹਠ ਪੂਰਵਕ ਆਪ ਚਲ ਪਏ",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "तब हठि राव आपि दोऊ धाए ॥",
      "sourceLineId": "116494",
      "sourceShabadId": "10646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਬਾਦਿਤ੍ਰ ਬਜਾਏ ॥੧੭॥",
      "transliteration": "bhaat bhaat baadhitr bajaae ||17||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦੇ ਵਾਜੇ ਵਜਾਏ ਗਏ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "भाति भाति बादित्र बजाए ॥१७॥",
      "sourceLineId": "116495",
      "sourceShabadId": "10646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤੁਰਹੀ ਨਾਦ ਨਫੀਰੀ ਬਾਜੀ ॥",
      "transliteration": "turahee naadh nafeeree baajee ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਰਹੀਆਂ, ਨਾਦ, ਨਫ਼ੀਰੀਆਂ ਵਜੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "तुरही नाद नफीरी बाजी ॥",
      "sourceLineId": "116496",
      "sourceShabadId": "10646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੰਖ ਢੋਲ ਕਰਨਾਏ ਗਾਜੀ ॥",
      "transliteration": "sa(n)kh ddol karanaae gaajee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੰਖ, ਢੋਲ ਅਤੇ ਰਣ-ਸਿੰਘੇ ਗੱਜੇ।",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "संख ढोल करनाए गाजी ॥",
      "sourceLineId": "116497",
      "sourceShabadId": "10646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਮੋ ਘੁਰੇ ਨਗਾਰੇ ॥",
      "transliteration": "bhaat bhaat mo ghure nagaare ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦੇ ਨਗਾਰੇ ਵਜੇ",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "भाति भाति मो घुरे नगारे ॥",
      "sourceLineId": "116498",
      "sourceShabadId": "10646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੇਖਤ ਸੁਰ ਬਿਵਾਨ ਚੜਿ ਸਾਰੇ ॥੧੮॥",
      "transliteration": "dhekhat sur bivaan chaR saare ||18||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵੇਖਣ ਲਈ ਸਾਰੇ ਦੇਵਤੇ ਬਿਮਾਨਾ ਉਤੇ ਚੜ੍ਰਹ ਕੇ ਆਏ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "देखत सुर बिवान चड़ि सारे ॥१८॥",
      "sourceLineId": "116499",
      "sourceShabadId": "10646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜੋ ਬਿਕ੍ਰਮਾ ਤਿਹ ਘਾਇ ਚਲਾਵੈ ॥",
      "transliteration": "jo bikramaa teh ghai chalaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਵੀ ਬਿਕ੍ਰਮ ਉਸ ਉਤੇ ਵਾਰ ਕਰਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "जो बिक्रमा तिह घाइ चलावै ॥",
      "sourceLineId": "116500",
      "sourceShabadId": "10646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਆਪਿ ਆਨਿ ਸ੍ਰੀ ਚੰਡਿ ਬਚਾਵੈ ॥",
      "transliteration": "aap aan sree cha(n)dd bachaavai ||",
      "translation": "Any action Bikrim took, Shri Chandika came and negated it.",
      "punjabiViakhya": "ਚੰਡਿਕਾ ਆਪ ਆ ਕੇ ਬਚਾ ਲੈਂਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "आपि आनि स्री चंडि बचावै ॥",
      "sourceLineId": "116501",
      "sourceShabadId": "10646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਿਹ ਬ੍ਰਿਣ ਏਕ ਲਗਨ ਨਹਿ ਦੇਵੈ ॥",
      "transliteration": "teh biran ek lagan neh dhevai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਇਕ ਵੀ ਘਾਓ ਲਗਣ ਨਾ ਦਿੰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "तिह बृण एक लगन नहि देवै ॥",
      "sourceLineId": "116502",
      "sourceShabadId": "10646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੇਵਕ ਜਾਨਿ ਰਾਖਿ ਕੈ ਲੇਵੈ ॥੧੯॥",
      "transliteration": "sevak jaan raakh kai levai ||19||",
      "translation": "She would let him hit and, considering him (Raja Salwan) as her devotee, always saved him.(19)",
      "punjabiViakhya": "(ਆਪਣਾ) ਸੇਵਕ ਸਮਝ ਕੇ ਉਸ ਦੀ ਰਖਿਆ ਕਰਦੀ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "सेवक जानि राखि कै लेवै ॥१९॥",
      "sourceLineId": "116503",
      "sourceShabadId": "10646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "116504",
      "sourceShabadId": "10647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦੇਵੀ ਭਗਤ ਪਛਾਨਿ ਤਿਹ ਲਗਨ ਨ ਦੀਨੇ ਘਾਇ ॥",
      "transliteration": "dhevee bhagat pachhaan teh lagan na dheene ghai ||",
      "translation": "Expecting him as the zealot ofthe goddess, she did not let him get hurt,",
      "punjabiViakhya": "ਦੇਵੀ ਨੇ ਆਪਣਾ ਭਗਤ ਜਾਣ ਕੇ ਉਸ (ਰਾਜੇ) ਨੂੰ ਘਾਓ ਲਗਣ ਨਾ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "देवी भगत पछानि तिह लगन न दीने घाइ ॥",
      "sourceLineId": "116505",
      "sourceShabadId": "10647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0932_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬਜ੍ਰ ਬਾਨ ਬਰਛੀਨ ਕੋ ਬਿਕ੍ਰਮ ਰਹਿਯੋ ਚਲਾਇ ॥੨੦॥",
      "transliteration": "bajr baan barachheen ko bikram rahiyo chalai ||20||",
      "translation": "In spite of god Brij Bhan’s spears and the arrows thrown by Bikrim.(20)",
      "punjabiViakhya": "(ਭਾਵੇਾਂ) ਬਿਕ੍ਰਮ ਬਜ੍ਰ ਦੇ ਸਮਾਨ ਬਰਛੀਆਂ ਅਤੇ ਤੀਰ ਚਲਾਉਾਂਦਾ ਰਿਹਾ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": "बज्र बान बरछीन को बिक्रम रहियो चलाइ ॥२०॥",
      "sourceLineId": "116506",
      "sourceShabadId": "10647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
