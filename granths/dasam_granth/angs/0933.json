{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 933,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0933_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116507",
      "sourceShabadId": "10648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਾਲਬਾਹਨ ਕੀ ਇਕ ਪਟਰਾਨੀ ॥",
      "transliteration": "saalabaahan kee ik paTaraanee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਲਬਾਹਨ ਦੀ ਇਕ ਪਟਰਾਣੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "सालबाहन की इक पटरानी ॥",
      "sourceLineId": "116508",
      "sourceShabadId": "10648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੋ ਰਨ ਹੇਰਿ ਅਧਿਕ ਡਰਪਾਨੀ ॥",
      "transliteration": "so ran her adhik ddarapaanee ||",
      "translation": "Salwan’s principal Rani was dreaded markedly.",
      "punjabiViakhya": "ਜੋ ਜੰਗ ਨੂੰ ਵੇਖ ਕੇ ਬਹੁਤ ਡਰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "सो रन हेरि अधिक डरपानी ॥",
      "sourceLineId": "116509",
      "sourceShabadId": "10648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪੂਜਿ ਗੌਰਜਾ ਤਾਹਿ ਮਨਾਈ ॥",
      "transliteration": "pooj gauarajaa taeh manaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਗੌਰਜਾ ਦੀ ਪੂਜਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "पूजि गौरजा ताहि मनाई ॥",
      "sourceLineId": "116510",
      "sourceShabadId": "10648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭੂਤ ਭਵਿਖ੍ਯ ਵਹੈ ਠਹਿਰਾਈ ॥੨੧॥",
      "transliteration": "bhoot bhavikhay vahai Thahiraiee ||21||",
      "translation": "She used to pray to the goddess Gorja, appraising her as her future saviour.(21)",
      "punjabiViakhya": "ਅਤੇ ਭੂਤ ਤੇ ਭਵਿਖ ਵਿਚ ਉਸੇ ਨੂੰ (ਆਪਣਾ ਰਖਿਅਕ) ਮੰਨਿਆ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "भूत भविख्य वहै ठहिराई ॥२१॥",
      "sourceLineId": "116511",
      "sourceShabadId": "10648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਬ ਤਿਹ ਦਰਸੁ ਗੌਰਜਾ ਦਯੋ ॥",
      "transliteration": "tab teh dharas gauarajaa dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਨੂੰ ਗੌਰਜਾ ਨੇ ਦਰਸ਼ਨ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "तब तिह दरसु गौरजा दयो ॥",
      "sourceLineId": "116512",
      "sourceShabadId": "10648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਉਠਿ ਰਾਣੀ ਤਿਹ ਸੀਸ ਝੁਕਯੋ ॥",
      "transliteration": "auTh raanee teh sees jhukayo ||",
      "translation": "Gorja appeared and the Rani came forward and paid her obeisance.",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਉਠ ਕੇ ਉਸ (ਦੇਵੀ) ਨੂੰ ਸੀਸ ਝੁਕਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "उठि राणी तिह सीस झुकयो ॥",
      "sourceLineId": "116513",
      "sourceShabadId": "10648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਜਗ ਮਾਤ ਮਨਾਯੋ ॥",
      "transliteration": "bhaat bhaat jag maat manaayo ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਨਾਲ ਜਗ ਮਾਤ ਦੀ ਉਸਤਤ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "भाति भाति जग मात मनायो ॥",
      "sourceLineId": "116514",
      "sourceShabadId": "10648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੀਤ ਹੋਇ ਹਮਰੀ ਬਰੁ ਪਾਯੋ ॥੨੨॥",
      "transliteration": "jeet hoi hamaree bar paayo ||22||",
      "translation": "She performed various penances and begged for her victory.(22)",
      "punjabiViakhya": "ਅਤੇ 'ਸਾਡੀ ਜਿਤ ਹੋਏ' ਇਹ ਵਰ ਪ੍ਰਾਪਤ ਕੀਤਾ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "जीत होइ हमरी बरु पायो ॥२२॥",
      "sourceLineId": "116515",
      "sourceShabadId": "10648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "116516",
      "sourceShabadId": "10649",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਾਲਬਾਹਨ ਬਿਕ੍ਰਮ ਭਏ ਬਾਜਿਯੋ ਲੋਹ ਅਪਾਰ ॥",
      "transliteration": "saalabaahan bikram bhe baajiyo loh apaar ||",
      "translation": "Salwan and Bikrim entered the combat,",
      "punjabiViakhya": "ਸਾਲਬਾਹਨ ਅਤੇ ਬਿਕ੍ਰਮ ਵਿਚਕਾਰ ਬਹੁਤ ਲੋਹਾ ਵਜਣ ਲਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "सालबाहन बिक्रम भए बाजियो लोह अपार ॥",
      "sourceLineId": "116517",
      "sourceShabadId": "10649",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਆਠ ਜਾਮ ਆਹਵ ਬਿਖੈ ਜੁਧ ਭਯੋ ਬਿਕਰਾਰ ॥੨੩॥",
      "transliteration": "aaTh jaam aahav bikhai judh bhayo bikaraar ||23||",
      "translation": "And for eight hours there was horrific fighting.(23)",
      "punjabiViakhya": "ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਅੱਠ ਪਹਿਰ ਤਕ ਬਹੁਤ ਭਿਆਨਕ ਯੁੱਧ ਹੋਇਆ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "आठ जाम आहव बिखै जुध भयो बिकरार ॥२३॥",
      "sourceLineId": "116518",
      "sourceShabadId": "10649",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116519",
      "sourceShabadId": "10650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸ੍ਯਾਲਕੋਟਿ ਨਾਯਕ ਰਿਸਿ ਭਰਿਯੋ ॥",
      "transliteration": "sayaalakoT naayak ris bhariyo ||",
      "translation": "",
      "punjabiViakhya": "ਸਿਆਲ ਕੋਟ ਦਾ ਰਾਜਾ (ਸਾਲਬਾਹਨ) ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਚਾਉ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "स्यालकोटि नायक रिसि भरियो ॥",
      "sourceLineId": "116520",
      "sourceShabadId": "10650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚਿਤ੍ਰ ਬਚਿਤ੍ਰ ਚੌਪਿ ਰਨ ਕਰਿਯੋ ॥",
      "transliteration": "chitr bachitr chauap ran kariyo ||",
      "translation": "The ruler of Sialkote became furious and, engulfed in rage, eventuated the skirmishes.",
      "punjabiViakhya": "ਕਈ ਪ੍ਰਕਾਰ ਦਾ ਵਿਚਿਤ੍ਰ ਅਤੇ ਅਦਭੁਤ ਯੁੱਧ ਕਰਨ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "चित्र बचित्र चौपि रन करियो ॥",
      "sourceLineId": "116521",
      "sourceShabadId": "10650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਨਿ ਧਨ ਬਾਨ ਬਜ੍ਰ ਸੇ ਮਾਰੇ ॥",
      "transliteration": "tan dhan baan bajr se maare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਕਮਾਨ ਨੂੰ ਕਸ ਕੇ ਬਜ੍ਰ ਦੇ ਸਮਾਨ ਬਾਣ ਮਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "तनि धन बान बज्र से मारे ॥",
      "sourceLineId": "116522",
      "sourceShabadId": "10650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਾਵ ਬਿਕ੍ਰਮਾ ਸ੍ਵਰਗ ਸਿਧਾਰੇ ॥੨੪॥",
      "transliteration": "raav bikramaa savairag sidhaare ||24||",
      "translation": "Stretching tightly he threw Braj arrows, which made Raja Bikrim to head for the domain of death.(24)",
      "punjabiViakhya": "(ਜਿਸ ਦੇ ਲਗਣ ਨਾਲ) ਬਿਕ੍ਰਮਾ ਰਾਇ ਸਵਰਗ ਸਿਧਾਰ ਗਿਆ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "राव बिक्रमा स्वरग सिधारे ॥२४॥",
      "sourceLineId": "116523",
      "sourceShabadId": "10650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "116524",
      "sourceShabadId": "10651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜੀਤਿ ਬਿਕ੍ਰਮਾਜੀਤ ਕੋ ਚਿਤ ਮੈ ਹਰਖ ਬਢਾਇ ॥",
      "transliteration": "jeet bikramaajeet ko chit mai harakh baddai ||",
      "translation": "By winning over Bikrimajeet he felt relieved.",
      "punjabiViakhya": "ਬਿਕ੍ਰਮਾਜੀਤ ਨੂੰ ਜਿਤ ਦੇ ਅਤੇ ਮਨ ਵਿਚ ਖ਼ੁਸ਼ੀ ਵਧਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "जीति बिक्रमाजीत को चित मै हरख बढाइ ॥",
      "sourceLineId": "116525",
      "sourceShabadId": "10651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅੰਤਹ ਪੁਰ ਆਵਤ ਭਯੋ ਅਧਿਕ ਹ੍ਰਿਦੈ ਸੁਖੁ ਪਾਇ ॥੨੫॥",
      "transliteration": "a(n)teh pur aavat bhayo adhik hiradhai sukh pai ||25||",
      "translation": "And, at last, he felt blissful.(25)",
      "punjabiViakhya": "(ਸਾਲਬਾਹਨ) ਅੰਤਹਪੁਰ ਵਿਚ ਆ ਗਿਆ ਅਤੇ ਹਿਰਦੇ ਵਿਚ ਬਹੁਤ ਸੁਖ ਪਾਇਆ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "अंतह पुर आवत भयो अधिक हृदै सुखु पाइ ॥२५॥",
      "sourceLineId": "116526",
      "sourceShabadId": "10651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116527",
      "sourceShabadId": "10652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਬ ਰਾਜਾ ਅੰਤਹ ਪੁਰ ਆਯੋ ॥",
      "transliteration": "jab raajaa a(n)teh pur aayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜਾ ਅੰਤਹਪੁਰ ਵਿਚ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "जब राजा अंतह पुर आयो ॥",
      "sourceLineId": "116528",
      "sourceShabadId": "10652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੁਨ੍ਯੋ ਜੁ ਬਰੁ ਰਾਨੀ ਜੂ ਪਾਯੋ ॥",
      "transliteration": "sunayo ju bar raanee joo paayo ||",
      "translation": "When the Raja returned, he came to know the boon, which the Rani had been granted.",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੇ ਰਾਣੀ ਦੁਆਰਾ ਪ੍ਰਾਪਤ ਕੀਤੇ ਵਰਦਾਨ ਦੀ (ਗੱਲ) ਸੁਣੀ,",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "सुन्यो जु बरु रानी जू पायो ॥",
      "sourceLineId": "116529",
      "sourceShabadId": "10652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮੋ ਕੌ ਕਹਿਯੋ ਜੀਤਿ ਇਹ ਦਈ ॥",
      "transliteration": "mo kau kahiyo jeet ieh dhiee ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਰਾਜਾ) ਕਹਿਣ ਲਗਿਆ ਕਿ ਮੈਨੂੰ ਇਸੇ ਨੇ ਹੀ ਜਿਤ ਪ੍ਰਦਾਨ ਕੀਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "मो कौ कहियो जीति इह दई ॥",
      "sourceLineId": "116530",
      "sourceShabadId": "10652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਾ ਸੌ ਪ੍ਰੀਤਿ ਅਧਿਕ ਹ੍ਵੈ ਗਈ ॥੨੬॥",
      "transliteration": "taa sau preet adhik havai giee ||26||",
      "translation": "He thought, ‘she has made the victory possible, therefore, I must love her more.’(26)",
      "punjabiViakhya": "ਇਸ ਲਈ ਰਾਜੇ ਦੀ ਰਾਣੀ ਨਾਲ ਪ੍ਰੀਤ ਹੋਰ ਜ਼ਿਆਦਾ ਹੋ ਗਈ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "ता सौ प्रीति अधिक ह्वै गई ॥२६॥",
      "sourceLineId": "116531",
      "sourceShabadId": "10652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "116532",
      "sourceShabadId": "10653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹਮਰੇ ਹਿਤ ਇਹ ਰਾਨਿਯੈ ਲੀਨੀ ਗੌਰਿ ਮਨਾਇ ॥",
      "transliteration": "hamare hit ieh raaniyai leenee gauar manai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਡੇ ਹਿਤ ਲਈ ਇਸ ਰਾਣੀ ਨੇ ਗੌਰਜਾ ਨੂੰ ਮੰਨਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "हमरे हित इह रानियै लीनी गौरि मनाइ ॥",
      "sourceLineId": "116533",
      "sourceShabadId": "10653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰੀਝਿ ਭਗੌਤੀ ਬਰੁ ਦਯੋ ਤਬ ਹਮ ਜਿਤੇ ਬਨਾਇ ॥੨੭॥",
      "transliteration": "reejh bhagauatee bar dhayo tab ham jite banai ||27||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਗਵਤੀ ਨੇ ਪ੍ਰਸੰਨ ਹੋ ਕੇ ਵਰ ਦਿੱਤਾ, ਤਦ ਸਾਡੀ ਜਿਤ ਹੋਈ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "रीझि भगौती बरु दयो तब हम जिते बनाइ ॥२७॥",
      "sourceLineId": "116534",
      "sourceShabadId": "10653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116535",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਿਸ ਦਿਨ ਰਹੈ ਤਵਨ ਕੇ ਡੇਰੈ ॥",
      "transliteration": "nis dhin rahai tavan ke dderai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰਾਤ ਦਿਨ ਉਸ (ਰਾਣੀ) ਦੇ ਡੇਰੇ ਹੀ ਰਹਿੰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "निस दिन रहै तवन के डेरै ॥",
      "sourceLineId": "116536",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਔਰ ਰਾਨਿਯਨ ਓਰ ਨ ਹੇਰੈ ॥",
      "transliteration": "aauar raaniyan or na herai ||",
      "translation": "Every day Raja started to stay with her and abandoned going to other Ranis.",
      "punjabiViakhya": "ਅਤੇ ਹੋਰ ਰਾਣੀਆਂ ਵਲ ਵੇਖਦਾ ਤਕ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "और रानियन ओर न हेरै ॥",
      "sourceLineId": "116537",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਹੁਤ ਮਾਸ ਰਹਤੇ ਜਬ ਭਯੋ ॥",
      "transliteration": "bahut maas rahate jab bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਉਸ ਨਾਲ) ਰਹਿੰਦਿਆਂ ਬਹੁਤ ਮਹੀਨੇ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "बहुत मास रहते जब भयो ॥",
      "sourceLineId": "116538",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦੇਬੀ ਪੂਤ ਏਕ ਤਿਹ ਦਯੋ ॥੨੮॥",
      "transliteration": "dhebee poot ek teh dhayo ||28||",
      "translation": "When many months have gone by the goddess granted him a son.(28)",
      "punjabiViakhya": "ਤਾ ਦੇਵੀ ਨੇ ਉਸ ਨੂੰ ਇਕ ਪੁੱਤਰ ਦਿੱਤਾ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "देबी पूत एक तिह दयो ॥२८॥",
      "sourceLineId": "116539",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਾ ਕੋ ਨਾਮ ਰਿਸਾਲੂ ਰਾਖਿਯੋ ॥",
      "transliteration": "taa ko naam risaaloo raakhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਾ ਰਿਸਾਲੂ ਰਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "ता को नाम रिसालू राखियो ॥",
      "sourceLineId": "116540",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਐਸੋ ਬਚਨ ਚੰਡਿਕਾ ਭਾਖਿਯੋ ॥",
      "transliteration": "aaiso bachan cha(n)ddikaa bhaakhiyo ||",
      "translation": "Be was given the name of Rasaloo and the goddess Chandika willed,",
      "punjabiViakhya": "ਚੰਡਿਕਾ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "ऐसो बचन चंडिका भाखियो ॥",
      "sourceLineId": "116541",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮਹਾ ਜਤੀ ਜੋਧਾ ਇਹ ਹੋਈ ॥",
      "transliteration": "mahaa jatee jodhaa ieh hoiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਹ ਮਹਾਨ ਜਤੀ ਜੋਧਾ ਹੋਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "महा जती जोधा इह होई ॥",
      "sourceLineId": "116542",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਾ ਸਮ ਔਰ ਨ ਜਗ ਮੈ ਕੋਈ ॥੨੯॥",
      "transliteration": "jaa sam aauar na jag mai koiee ||29||",
      "translation": "‘Be will be a great celibate and gallant person and there will not be any like him in the world.’(29)",
      "punjabiViakhya": "ਇਸ ਵਰਗਾ ਜਗਤ ਵਿਚ ਹੋਰ ਕੋਈ ਨਹੀਂ ਹੈ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "जा सम और न जग मै कोई ॥२९॥",
      "sourceLineId": "116543",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜ੍ਯੋ ਜ੍ਯੋ ਬਢਤ ਰਿਸਾਲੂ ਜਾਵੈ ॥",
      "transliteration": "jayo jayo baddat risaaloo jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਉਾਂ ਜਿਉਾਂ ਰਿਸਾਲੂ ਵੱਡਾ ਹੋਣ ਲਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "ज्यो ज्यो बढत रिसालू जावै ॥",
      "sourceLineId": "116544",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਿਤਿ ਅਖੇਟ ਕਰੈ ਮ੍ਰਿਗ ਘਾਵੈ ॥",
      "transliteration": "nit akheT karai mirag ghaavai ||",
      "translation": "As he grew, he commenced going on hunting and killing many deer.",
      "punjabiViakhya": "ਤਾ ਉਹ ਨਿੱਤ ਸ਼ਿਕਾਰ ਕਰ ਕੇ ਹਿਰਨ (ਆਦਿ ਜੰਗਲੀ ਪਸ਼ੂ) ਮਾਰਨ ਲਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "निति अखेट करै मृग घावै ॥",
      "sourceLineId": "116545",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੈਰ ਦੇਸ ਦੇਸਨ ਕੋ ਕਰੈ ॥",
      "transliteration": "sair dhes dhesan ko karai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਦੇਸ ਦੇਸਾਤਰਾ ਦੀ ਸੈਰ ਕਰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "सैर देस देसन को करै ॥",
      "sourceLineId": "116546",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਿਸਹੂ ਰਾਜਾ ਤੇ ਨਹਿ ਡਰੈ ॥੩੦॥",
      "transliteration": "kisahoo raajaa te neh ddarai ||30||",
      "translation": "He travelled all the countries and never dreaded any body.(30)",
      "punjabiViakhya": "ਅਤੇ ਕਿਸੇ ਵੀ ਰਾਜੇ ਤੋਂ ਡਰਦਾ ਨਹੀਂ ਸੀ ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "किसहू राजा ते नहि डरै ॥३०॥",
      "sourceLineId": "116547",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਖੇਲ ਅਖੇਟਕ ਜਬ ਗ੍ਰਿਹ ਆਵੈ ॥",
      "transliteration": "khel akheTak jab gireh aavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਸ਼ਿਕਾਰ ਖੇਡ ਕੇ ਘਰ ਪਰਤਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "खेल अखेटक जब गृह आवै ॥",
      "sourceLineId": "116548",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਬ ਚੌਪਰ ਕੀ ਖੇਲਿ ਮਚਾਵੈ ॥",
      "transliteration": "tab chauapar kee khel machaavai ||",
      "translation": "Coming back after hunting, he would sit down to play chess.",
      "punjabiViakhya": "ਤਾ ਚੌਪੜ ਦੀ ਖੇਡ ਰਚਾ ਲੈਂਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "तब चौपर की खेलि मचावै ॥",
      "sourceLineId": "116549",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜੀਤਿ ਚੀਤਿ ਰਾਜਨ ਕੌ ਲੇਈ ॥",
      "transliteration": "jeet cheet raajan kau leiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰਾਜਿਆਂ ਦੇ ਚਿਤ ਨੂੰ ਜਿਤ ਲੈਂਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "जीति चीति राजन कौ लेई ॥",
      "sourceLineId": "116550",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਛੋਰਿ ਛੋਰਿ ਚਿਤ੍ਰ ਕਰਿ ਦੇਈ ॥੩੧॥",
      "transliteration": "chhor chhor chitr kar dheiee ||31||",
      "translation": "He would win over many other Rajas and feel delighted.(31)",
      "punjabiViakhya": "ਅਤੇ ਕੋਈ ਚਿੰਨ੍ਰਹ ਲਗਾ-ਲਗਾ ਕੇ ਛਡ ਦਿੰਦਾ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "छोरि छोरि चित्र करि देई ॥३१॥",
      "sourceLineId": "116551",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਏਕ ਡੋਮ ਤਾ ਕੋ ਗ੍ਰਿਹ ਆਯੋ ॥",
      "transliteration": "ek ddom taa ko gireh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਇਕ ਡੂਮ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "एक डोम ता को गृह आयो ॥",
      "sourceLineId": "116552",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਖੇਲ ਰਿਸਾਲੂ ਸਾਥ ਰਚਾਯੋ ॥",
      "transliteration": "khel risaaloo saath rachaayo ||",
      "translation": "Once a bard came to him and started to play with Rasaloo.",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੇ ਰਿਸਾਲੂ ਨਾਲ (ਸ਼ਤਰੰਜ) ਦੀ ਖੇਡ ਰਚਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "खेल रिसालू साथ रचायो ॥",
      "sourceLineId": "116553",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0933_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪਗਿਯਾ ਬਸਤ੍ਰ ਅਸ੍ਵ ਜਬ ਹਾਰੇ ॥",
      "transliteration": "pagiyaa basatr asavai jab haare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਡੂਮ) ਜਦ ਬਸਤ੍ਰ, ਪਗੜੀ ਅਤੇ ਘੋੜਾ ਹਾਰ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": "पगिया बसत्र अस्व जब हारे ॥",
      "sourceLineId": "116554",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
