{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 934,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0934_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚਿਤ੍ਰ ਚਿਤ ਯੌ ਬਚਨ ਉਚਾਰੇ ॥੩੨॥",
      "transliteration": "chitr chit yau bachan uchaare ||32||",
      "translation": "Mter losing all his belongings and horses, that clever man said,(32)",
      "punjabiViakhya": "ਤਾ ਚਿੰਨ੍ਰਹ ਚਿਤਰਨ ਵੇਲੇ ਉਸ ਨੇ (ਰਿਸਾਲੂ ਨੂੰ) ਕਿਹਾ ॥੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "चित्र चित यौ बचन उचारे ॥३२॥",
      "sourceLineId": "116555",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚੌਪਰ ਬਾਜ ਤੋਹਿ ਤਬ ਜਾਨੋ ॥",
      "transliteration": "chauapar baaj toh tab jaano ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਤੈਨੂੰ ਚੌਪੜਬਾਜ਼ ਉਦੋਂ ਸਮਝਾਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "चौपर बाज तोहि तब जानो ॥",
      "sourceLineId": "116556",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮੇਰੋ ਕਹਿਯੋ ਏਕ ਤੁਮ ਮਾਨੋ ॥",
      "transliteration": "mero kahiyo ek tum maano ||",
      "translation": "‘I will accept you as a chess-master only if you do what I say.",
      "punjabiViakhya": "ਜੇ ਤੂੰ ਮੇਰਾ ਇਕ ਕਿਹਾ ਮੰਨੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "मेरो कहियो एक तुम मानो ॥",
      "sourceLineId": "116557",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਿਰਕਪ ਕੇ ਸੰਗ ਖੇਲ ਰਚਾਵੋ ॥",
      "transliteration": "sirakap ke sa(n)g khel rachaavo ||",
      "translation": "",
      "punjabiViakhya": "ਸਿਰਕਪ (ਰਾਜੇ ਨਾਲ ਸ਼ਤਰੰਜ ਦੀ) ਖੇਡ ਰਚਾਏਾਂਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "सिरकप के संग खेल रचावो ॥",
      "sourceLineId": "116558",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਬ ਇਹ ਖੇਲ ਜੀਤਿ ਗ੍ਰਿਹ ਆਵੋ ॥੩੩॥",
      "transliteration": "tab ieh khel jeet gireh aavo ||33||",
      "translation": "‘You play the game with the killer-Raja and come back home alive.’(33)",
      "punjabiViakhya": "ਅਤੇ ਤਦ ਇਹ ਖੇਡ ਜਿਤ ਕੇ ਘਰ ਨੂੰ ਆਵੇਾਂਗਾ ॥੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "तब इह खेल जीति गृह आवो ॥३३॥",
      "sourceLineId": "116559",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਯੌ ਸੁਣ ਬਚਨ ਰਿਸਾਲੂ ਧਾਯੋ ॥",
      "transliteration": "yau sun bachan risaaloo dhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਬੋਲ ਸੁਣ ਕੇ ਰਿਸਾਲੂ ਘੋੜੇ ਉਤੇ ਚੜ੍ਰਹ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "यौ सुण बचन रिसालू धायो ॥",
      "sourceLineId": "116560",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚੜਿ ਘੋਰਾ ਪੈ ਤਹੀ ਸਿਧਾਯੋ ॥",
      "transliteration": "chaR ghoraa pai tahee sidhaayo ||",
      "translation": "Harking to this, Rasaloo mounted his horse started his journey.",
      "punjabiViakhya": "ਉਸ ਵਲ ਚਲ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "चड़ि घोरा पै तही सिधायो ॥",
      "sourceLineId": "116561",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਿਰਕਪ ਕੇ ਦੇਸੰਤਰ ਆਯੋ ॥",
      "transliteration": "sirakap ke dhesa(n)tar aayo ||",
      "translation": "",
      "punjabiViakhya": "ਸਿਰਕਪ ਦੇ ਦੇਸ ਵਿਚ ਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "सिरकप के देसंतर आयो ॥",
      "sourceLineId": "116562",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਆਨਿ ਰਾਵ ਸੌ ਖੇਲ ਰਚਾਯੋ ॥੩੪॥",
      "transliteration": "aan raav sau khel rachaayo ||34||",
      "translation": "He came to the country of killer-Raja, and started to play with that Raja.(34)",
      "punjabiViakhya": "ਅਤੇ ਆ ਕੇ ਰਾਜੇ ਨਾਲ ਖੇਡਣਾ ਸ਼ੁਰੂ ਕੀਤਾ ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "आनि राव सौ खेल रचायो ॥३४॥",
      "sourceLineId": "116563",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਬ ਸਿਰਕਪ ਛਲ ਅਧਿਕ ਸੁ ਧਾਰੇ ॥",
      "transliteration": "tab sirakap chhal adhik su dhaare ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਸਿਰਕਪ ਨੇ ਬਹੁਤ ਛਲ ਕਪਟ ਕੀਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "तब सिरकप छल अधिक सु धारे ॥",
      "sourceLineId": "116564",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਬਸਤ੍ਰਨ ਜੁਤ ਹਾਰੇ ॥",
      "transliteration": "sasatr asatr basatran jut haare ||",
      "translation": "In spite of all his cleverness, the killer-Raja lost all his arms, clothes and belongings.",
      "punjabiViakhya": "(ਪਰ) ਸ਼ਸਤ੍ਰ, ਅਸਤ੍ਰ ਅਤੇ ਬਸਤ੍ਰ ਸਮੇਤ (ਸਭ ਕੁਝ) ਹਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "ससत्र असत्र बसत्रन जुत हारे ॥",
      "sourceLineId": "116565",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਧਨ ਹਰਾਇ ਸਿਰ ਬਾਜੀ ਲਾਗੀ ॥",
      "transliteration": "dhan harai sir baajee laagee ||",
      "translation": "",
      "punjabiViakhya": "ਧਨ ਹਾਰ ਕੇ ਉਸ ਨੇ ਸਿਰ ਦੀ ਬਾਜ਼ੀ ਲਗਾ ਦਿੱਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "धन हराइ सिर बाजी लागी ॥",
      "sourceLineId": "116566",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੋਊ ਜੀਤਿ ਲਈ ਬਡਭਾਗੀ ॥੩੫॥",
      "transliteration": "souoo jeet liee baddabhaagee ||35||",
      "translation": "After losing all his wealth he bet his head and that too the lucky Rasaloo won over.(35)",
      "punjabiViakhya": "ਉਹ ਵੀ ਵਡਭਾਗੀ (ਰਿਸਾਲੂ) ਨੇ ਜਿੱਤ ਲਈ ॥੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "सोऊ जीति लई बडभागी ॥३५॥",
      "sourceLineId": "116567",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜੀਤਿ ਤਾਹਿ ਮਾਰਨ ਲੈ ਧਾਯੋ ॥",
      "transliteration": "jeet taeh maaran lai dhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜਿਤ ਕੇ (ਉਹ) ਮਾਰਨ ਨੂੰ ਤੁਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "जीति ताहि मारन लै धायो ॥",
      "sourceLineId": "116568",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਯੌ ਸੁਨਿ ਕੈ ਰਨਿਵਾਸਹਿ ਪਾਯੋ ॥",
      "transliteration": "yau sun kai ranivaaseh paayo ||",
      "translation": "After winning over when he was taking him to kill, he heard this from the direction of the Rani.",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਰਣਵਾਸ ਤੋਂ ਇਹ ਸੁਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "यौ सुनि कै रनिवासहि पायो ॥",
      "sourceLineId": "116569",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਯਾ ਕੀ ਸੁਤਾ ਕੋਕਿਲਾ ਲੀਜੈ ॥",
      "transliteration": "yaa kee sutaa kokilaa leejai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਸ ਦੀ ਪੁੱਤਰੀ ਕੋਕਿਲਾ ਲੈ ਲਵੋ,",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "या की सुता कोकिला लीजै ॥",
      "sourceLineId": "116570",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਿਯ ਤੇ ਬਧ ਯਾ ਕੌ ਨਹਿ ਕੀਜੈ ॥੩੬॥",
      "transliteration": "jiy te badh yaa kau neh keejai ||36||",
      "translation": "‘Let us get his daughter Kokila and do not kill him.’(36)",
      "punjabiViakhya": "ਪਰ ਇਸ ਨੂੰ ਜਾਨ ਤੋਂ ਨਾ ਮਾਰੋ ॥੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "जिय ते बध या कौ नहि कीजै ॥३६॥",
      "sourceLineId": "116571",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਬ ਤਿਹ ਜਾਨ ਮਾਫ ਕੈ ਦਈ ॥",
      "transliteration": "tab teh jaan maaf kai dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਨੇ (ਸਿਰਕਪ ਦੀ) ਜਾਨ ਮਾਫ਼ ਕਰ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "तब तिह जान माफ कै दई ॥",
      "sourceLineId": "116572",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਾ ਕੀ ਸੁਤਾ ਕੋਕਿਲਾ ਲਈ ॥",
      "transliteration": "taa kee sutaa kokilaa liee ||",
      "translation": "Then he pardoned his life and took his daughter Kokila.",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੀ ਪੁੱਤਰੀ ਕੋਕਿਲਾ ਲੈ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "ता की सुता कोकिला लई ॥",
      "sourceLineId": "116573",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦੰਡਕਾਰ ਮੈ ਸਦਨ ਸਵਾਰਿਯੋ ॥",
      "transliteration": "dha(n)ddakaar mai sadhan savaariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਦੰਡਕਾਰ (ਦੰਡਕ ਬਨ) ਵਿਚ ਮਹੱਲ ਬਣਵਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "दंडकार मै सदन सवारियो ॥",
      "sourceLineId": "116574",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਾ ਕੇ ਬੀਚ ਰਾਖ ਤਿਹ ਧਾਰਿਯੋ ॥੩੭॥",
      "transliteration": "taa ke beech raakh teh dhaariyo ||37||",
      "translation": "In the wilderness he built a house and he kept her there.(37)",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਵਿਚ ਉਸ ਨੂੰ ਟਿਕਾ ਦਿੱਤਾ ॥੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "ता के बीच राख तिह धारियो ॥३७॥",
      "sourceLineId": "116575",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਾ ਕੌ ਲਰਿਕਾਪਨ ਜਬ ਗਯੋ ॥",
      "transliteration": "taa kau larikaapan jab gayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਦਾ ਬਚਪਨ ਖ਼ਤਮ ਹੋਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "ता कौ लरिकापन जब गयो ॥",
      "sourceLineId": "116576",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜੋਬਨ ਆਨਿ ਦਮਾਮੋ ਦਯੋ ॥",
      "transliteration": "joban aan dhamaamo dhayo ||",
      "translation": "Although her childhood had gone past and .the youth has taken over,",
      "punjabiViakhya": "(ਤਦ) ਜਵਾਨੀ ਨੇ ਆ ਕੇ ਨਗਾਰਾ ਵਜਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "जोबन आनि दमामो दयो ॥",
      "sourceLineId": "116577",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਾਜਾ ਨਿਕਟ ਨ ਤਾ ਕੇ ਆਵੈ ॥",
      "transliteration": "raajaa nikaT na taa ke aavai ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ) ਰਾਜਾ ਉਸ ਦੇ ਨੇੜੇ ਨਹੀਂ ਜਾਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "राजा निकट न ता के आवै ॥",
      "sourceLineId": "116578",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਯਾ ਤੇ ਅਤਿ ਰਾਨੀ ਦੁਖੁ ਪਾਵੇ ॥੩੮॥",
      "transliteration": "yaa te at raanee dhukh paave ||38||",
      "translation": "Raja would not come to see (that) Rani and the Rani would get very upset.(38)",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਰਾਣੀ ਬਹੁਤ ਦੁਖੀ ਹੁੰਦੀ ਸੀ ॥੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "या ते अति रानी दुखु पावे ॥३८॥",
      "sourceLineId": "116579",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਰਾਜਾ ਜਬ ਆਯੋ ॥",
      "transliteration": "ek dhivas raajaa jab aayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਜਦ ਰਾਜਾ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "एक दिवस राजा जब आयो ॥",
      "sourceLineId": "116580",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਯੌ ਬਚਨ ਸੁਨਾਯੋ ॥",
      "transliteration": "tab raanee yau bachan sunaayo ||",
      "translation": "One day when Raja passed by, the Rani said,",
      "punjabiViakhya": "ਤਾ ਰਾਣੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿ ਕੇ ਸੁਣਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "तब रानी यौ बचन सुनायो ॥",
      "sourceLineId": "116581",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਹਮ ਕੋ ਲੈ ਤੁਮ ਸੰਗ ਸਿਧਾਰੌ ॥",
      "transliteration": "ham ko lai tum sa(n)g sidhaarau ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਮੈਨੂੰ ਨਾਲ ਲੈ ਕੇ (ਉਥੇ) ਚਲੋ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "हम को लै तुम संग सिधारौ ॥",
      "sourceLineId": "116582",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਨ ਮੈ ਜਹਾ ਮ੍ਰਿਗਨ ਕੌ ਮਾਰੌ ॥੩੯॥",
      "transliteration": "ban mai jahaa miragan kau maarau ||39||",
      "translation": "‘Please take me with you to place where you go for deer hunting.’(39)",
      "punjabiViakhya": "ਜਿਥੇ (ਤੁਸੀਂ) ਜੰਗਲ ਵਿਚ ਹਿਰਨਾ (ਜੰਗਲੀ ਪਸ਼ੂਆਂ) ਨੂੰ ਮਾਰਦੇ ਹੋ ॥੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "बन मै जहा मृगन कौ मारौ ॥३९॥",
      "sourceLineId": "116583",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਲੈ ਰਾਜਾ ਤਿਹ ਸੰਗ ਸਿਧਾਯੋ ॥",
      "transliteration": "lai raajaa teh sa(n)g sidhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਉਸ ਨੂੰ ਨਾਲ ਲੈ ਕੇ ਉਥੇ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "लै राजा तिह संग सिधायो ॥",
      "sourceLineId": "116584",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਹ ਮ੍ਰਿਗ ਹਨਤ ਹੇਤ ਤਹ ਆਯੋ ॥",
      "transliteration": "jeh mirag hanat het teh aayo ||",
      "translation": "Raja took her with him where he was going for hunting the deer.",
      "punjabiViakhya": "ਜਿਥੇ ਉਹ ਹਿਰਨਾ ਨੂੰ ਮਾਰਨ ਲਈ ਆਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "जह मृग हनत हेत तह आयो ॥",
      "sourceLineId": "116585",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੈ ਫੇਰਾ ਸਰ ਸੌ ਮ੍ਰਿਗ ਮਾਰਿਯੋ ॥",
      "transliteration": "dhai feraa sar sau mirag maariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਹਿਰਨ ਨੂੰ ਫੇਰਾ ਦੇ ਕੇ (ਅਰਥਾਤ ਭਜਾ ਕੇ) ਬਾਣ ਨਾਲ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "दै फेरा सर सौ मृग मारियो ॥",
      "sourceLineId": "116586",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਯਹ ਕੌਤਕ ਕੋਕਿਲਾ ਨਿਹਾਰਿਯੋ ॥੪੦॥",
      "transliteration": "yeh kauatak kokilaa nihaariyo ||40||",
      "translation": "Raja killed the deer with his own arrows and she witnessed the whole scene.(40)",
      "punjabiViakhya": "ਇਹ ਕੌਤਕ ਕੋਕਿਲਾ ਨੇ ਵੇਖਿਆ ॥੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "यह कौतक कोकिला निहारियो ॥४०॥",
      "sourceLineId": "116587",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਯੌ ਬਚਨ ਉਚਾਰੇ ॥",
      "transliteration": "tab raanee yau bachan uchaare ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "तब रानी यौ बचन उचारे ॥",
      "sourceLineId": "116588",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੁਨੋ ਬਾਤ ਨ੍ਰਿਪ ਨਾਥ ਹਮਾਰੇ ॥",
      "transliteration": "suno baat nirap naath hamaare ||",
      "translation": "Then the Rani said, ‘Listen my Raja, ‘I can kill the deer with the sharp arrows of my eyes.",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਮੇਰੀ ਇਕ ਗੱਲ ਸੁਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "सुनो बात नृप नाथ हमारे ॥",
      "sourceLineId": "116589",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦ੍ਰਿਗ ਸਰ ਸੋ ਮ੍ਰਿਗ ਕੋ ਹੌ ਮਾਰੌ ॥",
      "transliteration": "dhirag sar so mirag ko hau maarau ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਨੈਣਾ ਦੇ ਬਾਣਾ ਨਾਲ ਹੀ ਹਿਰਨ ਨੂੰ ਮਾਰ ਦੇਵਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "दृग सर सो मृग को हौ मारौ ॥",
      "sourceLineId": "116590",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤੁਮ ਠਾਢੇ ਯਹ ਚਰਿਤ ਨਿਹਾਰੋ ॥੪੧॥",
      "transliteration": "tum Thaadde yeh charit nihaaro ||41||",
      "translation": "You stay here and watch all the episode.(41)",
      "punjabiViakhya": "ਤੁਸੀਂ (ਇਥੇ) ਖੜੋਤੇ ਇਹ ਚਰਿਤ੍ਰ ਵੇਖੋ ॥੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "तुम ठाढे यह चरित निहारो ॥४१॥",
      "sourceLineId": "116591",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਘੂੰਘਟ ਛੋਰਿ ਕੋਕਿਲਾ ਧਾਈ ॥",
      "transliteration": "ghoo(n)ghaT chhor kokilaa dhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਘੁੰਘਟ ਨੂੰ ਛਡ ਕੇ ਕੋਕਿਲਾ ਭਜਦੀ ਹੋਈ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "घूँघट छोरि कोकिला धाई ॥",
      "sourceLineId": "116592",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮ੍ਰਿਗ ਲਖਿ ਤਾਹਿ ਗਯੋ ਉਰਝਾਈ ॥",
      "transliteration": "mirag lakh taeh gayo urajhaiee ||",
      "translation": "Unveiling her face, Kokila came forward and the deer was dazed to her.",
      "punjabiViakhya": "ਹਿਰਨ ਉਸ (ਦੇ ਰੂਪ) ਨੂੰ ਵੇਖ ਕੇ ਉਲਝ ਗਿਆ (ਅਰਥਾਤ ਚਕਰਾ ਗਿਆ)।",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "मृग लखि ताहि गयो उरझाई ॥",
      "sourceLineId": "116593",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਮਿਤ ਰੂਪ ਜਬ ਤਾਹਿ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "amit roop jab taeh nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਦੀ ਅਸੀਮ ਸੁੰਦਰਤਾ ਵੇਖੀ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "अमित रूप जब ताहि निहारियो ॥",
      "sourceLineId": "116594",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਠਾਢਿ ਰਹਿਯੋ ਨਹਿ ਸੰਕ ਪਧਾਰਿਯੋ ॥੪੨॥",
      "transliteration": "Thaadd rahiyo neh sa(n)k padhaariyo ||42||",
      "translation": "On seeing her extreme beauty, it kept standing there and did not run away.(42)",
      "punjabiViakhya": "ਤਾ ਉਥੇ ਨਿਸੰਗ ਖੜੋਤਾ ਰਿਹਾ ਅਤੇ ਨਾ ਦੌੜਿਆ ॥੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "ठाढि रहियो नहि संक पधारियो ॥४२॥",
      "sourceLineId": "116595",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਰ ਸੌ ਮ੍ਰਿਗ ਰਾਨੀ ਜਬ ਗਹਿਯੋ ॥",
      "transliteration": "kar sau mirag raanee jab gahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਣੀ ਨੇ ਹੱਥ ਨਾਲ ਹਿਰਨ ਪਕੜ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "कर सौ मृग रानी जब गहियो ॥",
      "sourceLineId": "116596",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਯਹ ਕੌਤਕ ਰੀਸਾਲੂ ਲਹਿਯੋ ॥",
      "transliteration": "yeh kauatak reesaaloo lahiyo ||",
      "translation": "Rasaloo saw her holding the deer with her hands and he was astonished to see this miracle.",
      "punjabiViakhya": "ਅਤੇ ਰਿਸਾਲੂ ਨੇ ਇਹ ਕੌਤਕ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "यह कौतक रीसालू लहियो ॥",
      "sourceLineId": "116597",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਬ ਚਿਤ ਭੀਤਰ ਅਧਿਕ ਰਿਸਾਯੋ ॥",
      "transliteration": "tab chit bheetar adhik risaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਹ ਮਨ ਵਿਚ ਬਹੁਤ ਕ੍ਰੋਧਿਤ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "तब चित भीतर अधिक रिसायो ॥",
      "sourceLineId": "116598",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਾਨ ਕਾਟ ਕੈ ਤਾਹਿ ਪਠਾਯੋ ॥੪੩॥",
      "transliteration": "kaan kaaT kai taeh paThaayo ||43||",
      "translation": "He felt humiliated and cut the ears of the deer and made it to run away.(43)",
      "punjabiViakhya": "ਅਤੇ ਕੰਨ ਕਟ ਕੇ ਉਸ ਨੂੰ ਭਜਾ ਦਿੱਤਾ ॥੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "कान काट कै ताहि पठायो ॥४३॥",
      "sourceLineId": "116599",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਾਨ ਕਟਿਯੋ ਮ੍ਰਿਗ ਲਖਿ ਜਬ ਪਾਯੋ ॥",
      "transliteration": "kaan kaTiyo mirag lakh jab paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਹਿਰਨ ਨੇ ਕੰਨ ਕਟੇ ਹੋਏ ਵੇਖੇ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "कान कटियो मृग लखि जब पायो ॥",
      "sourceLineId": "116600",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੋ ਹੋਡੀ ਮਹਲਨ ਤਰ ਆਯੋ ॥",
      "transliteration": "so hoddee mahalan tar aayo ||",
      "translation": "When its ears were cut off, it came running under the palace,",
      "punjabiViakhya": "(ਤਾ) ਉਹ ਹੋਡੀ ਦੇ ਮਹੱਲ ਹੇਠਾ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "सो होडी महलन तर आयो ॥",
      "sourceLineId": "116601",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਿੰਧ ਦੇਸ ਏਸ੍ਵਰ ਗਹਿ ਲਯੋ ॥",
      "transliteration": "si(n)dh dhes esavair geh layo ||",
      "translation": "",
      "punjabiViakhya": "ਸਿੰਧ ਦੇਸ ਦੇ ਰਾਜੇ ਨੇ (ਜਦ) ਉਸ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "सिंध देस एस्वर गहि लयो ॥",
      "sourceLineId": "116602",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਚੜਿ ਘੋੜਾ ਪੈ ਪਾਛੇ ਧਯੋ ॥੪੪॥",
      "transliteration": "chaR ghoRaa pai paachhe dhayo ||44||",
      "translation": "Where the Raja of the country of Eeswari chased him it on his horse.(44)",
      "punjabiViakhya": "(ਤਾ) ਉਹ ਘੋੜੇ ਉਤੇ ਚੜ੍ਰਹ ਕੇ ਉਸ ਦੇ ਪਿਛੇ ਦੌੜਿਆ ॥੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "चड़ि घोड़ा पै पाछे धयो ॥४४॥",
      "sourceLineId": "116603",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤਬ ਆਗੇ ਤਾ ਕੇ ਮ੍ਰਿਗ ਧਾਯੋ ॥",
      "transliteration": "tab aage taa ke mirag dhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਦੇ ਅਗੇ ਹਿਰਨ ਦੌੜਦਾ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "तब आगे ता के मृग धायो ॥",
      "sourceLineId": "116604",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮਹਲ ਕੋਕਿਲਾ ਕੇ ਤਰ ਆਯੋ ॥",
      "transliteration": "mahal kokilaa ke tar aayo ||",
      "translation": "",
      "punjabiViakhya": "ਕੋਕਿਲਾ ਦੇ ਮਹੱਲ ਹੇਠਾ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "महल कोकिला के तर आयो ॥",
      "sourceLineId": "116605",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਹੋਡੀ ਤਾ ਕੋ ਰੂਪ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "hoddee taa ko roop nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਡੀ (ਰਾਜੇ) ਨੇ ਉਸ (ਕੋਕਿਲਾ) ਦਾ ਰੂਪ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "होडी ता को रूप निहारियो ॥",
      "sourceLineId": "116606",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਹਰਿ ਅਰਿ ਸਰ ਤਾ ਕੌ ਤਨੁ ਮਾਰਿਯੋ ॥੪੫॥",
      "transliteration": "har ar sar taa kau tan maariyo ||45||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਕਾਮ ਦੇਵ ('ਹਰਿ-ਅਰਿ') ਨੇ ਉਸ ਦੇ ਸ਼ਰੀਰ ਵਿਚ ਤੀਰ ਮਾਰਿਆ ॥੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "हरि अरि सर ता कौ तनु मारियो ॥४५॥",
      "sourceLineId": "116607",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਹੋਡੀ ਜਬ ਕੋਕਿਲਾ ਨਿਹਾਰੀ ॥",
      "transliteration": "hoddee jab kokilaa nihaaree ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਡੀ ਨੂੰ ਜਦ ਕੋਕਿਲਾ ਨੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "होडी जब कोकिला निहारी ॥",
      "sourceLineId": "116608",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਬਿਹਸਿ ਬਾਤ ਇਹ ਭਾਤਿ ਉਚਾਰੀ ॥",
      "transliteration": "bihas baat ieh bhaat uchaaree ||",
      "translation": "When he came across Kokila, he said to her,",
      "punjabiViakhya": "ਤਾ ਹਸ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਗੱਲ ਕਹੀ,",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "बिहसि बात इह भाति उचारी ॥",
      "sourceLineId": "116609",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਹਮ ਤੁਮ ਆਉ ਬਿਰਾਜਹਿੰ ਦੋਊ ॥",
      "transliteration": "ham tum aau biraajahi(n) dhouoo ||",
      "translation": "",
      "punjabiViakhya": "ਆਓ, ਮੈਂ ਤੇ ਤੁਸੀਂ ਇਕੱਠੇ ਬਹੀਏ,",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "हम तुम आउ बिराजहिं दोऊ ॥",
      "sourceLineId": "116610",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜਾ ਕੋ ਭੇਦ ਨ ਪਾਵਤ ਕੋਊ ॥੪੬॥",
      "transliteration": "jaa ko bhedh na paavat kouoo ||46||",
      "translation": "‘Let you and me stay here, so that no body could know.’(46)",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਭੇਦ ਕਿਸੇ ਨੂੰ ਪਤਾ ਨਹੀਂ ਲਗੇਗਾ ॥੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "जा को भेद न पावत कोऊ ॥४६॥",
      "sourceLineId": "116611",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਹੈ ਤੇ ਉਤਰ ਭਵਨ ਪਗ ਧਾਰਿਯੋ ॥",
      "transliteration": "hai te utar bhavan pag dhaariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ ਹੋਡੀ) ਘੋੜੇ ਤੋਂ ਉਤਰ ਕੇ ਮਹੱਲ ਵਿਚ ਦਾਖ਼ਲ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "है ते उतर भवन पग धारियो ॥",
      "sourceLineId": "116612",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਆਨਿ ਕੋਕਿਲਾ ਸਾਥ ਬਿਹਾਰਿਯੋ ॥",
      "transliteration": "aan kokilaa saath bihaariyo ||",
      "translation": "Dismounting the horse he came in his palace and took Kokila with him.",
      "punjabiViakhya": "ਅਤੇ ਆ ਕੇ ਕੋਕਿਲਾ ਨਾਲ ਸਹਿਵਾਸ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "आनि कोकिला साथ बिहारियो ॥",
      "sourceLineId": "116613",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਭੋਗ ਕਮਾਇ ਬਹੁਰਿ ਉਠ ਗਯੋ ॥",
      "transliteration": "bhog kamai bahur uTh gayo ||",
      "translation": "",
      "punjabiViakhya": "ਭੋਗ ਕਰ ਕੇ ਫਿਰ ਉਠ (ਕੇ ਚਲਾ) ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "भोग कमाइ बहुरि उठ गयो ॥",
      "sourceLineId": "116614",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਦੁਤਯ ਦਿਵਸ ਪੁਨਿ ਆਵਤ ਭਯੋ ॥੪੭॥",
      "transliteration": "dhutay dhivas pun aavat bhayo ||47||",
      "translation": "After making love with her, he left the place and next day, again, he came back,(47)",
      "punjabiViakhya": "ਅਤੇ ਦੂਜੇ ਦਿਨ ਫਿਰ ਆ ਗਿਆ ॥੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "दुतय दिवस पुनि आवत भयो ॥४७॥",
      "sourceLineId": "116615",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਤਬ ਮੈਨਾ ਯਹ ਭਾਤਿ ਬਖਾਨੀ ॥",
      "transliteration": "tab mainaa yeh bhaat bakhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਮੈਨਾ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "तब मैना यह भाति बखानी ॥",
      "sourceLineId": "116616",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਕਾ ਕੋਕਿਲਾ ਤੂ ਭਈ ਅਯਾਨੀ ॥",
      "transliteration": "kaa kokilaa too bhiee ayaanee ||",
      "translation": "Then the Mynah (bird) told, ‘Kokila why are you behaving foolishly.’",
      "punjabiViakhya": "ਕੀ ਕੋਕਿਲਾ ਤੂੰ ਇਆਣੀ ਹੋ ਗਈ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "का कोकिला तू भई अयानी ॥",
      "sourceLineId": "116617",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਯੌ ਸੁਨਿ ਬੈਨ ਤਾਹਿ ਹਨਿ ਡਾਰਿਯੋ ॥",
      "transliteration": "yau sun bain taeh han ddaariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਇਸ ਤਰ੍ਰਹਾ ਦੇ ਬੋਲ ਸੁਣ ਕੇ ਉਸ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "यौ सुनि बैन ताहि हनि डारियो ॥",
      "sourceLineId": "116618",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਤਬ ਸੁਕ ਤਿਹ ਇਹ ਭਾਤਿ ਉਚਾਰਿਯੋ ॥੪੮॥",
      "transliteration": "tab suk teh ieh bhaat uchaariyo ||48||",
      "translation": "Hearing this she killed her and, then, the parrot said,(48)",
      "punjabiViakhya": "ਤਦ ਤੋਤੇ ਨੇ ਉਸ ਪ੍ਰਤਿ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ॥੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "तब सुक तिह इह भाति उचारियो ॥४८॥",
      "sourceLineId": "116619",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਭਲੋ ਕਰਿਯੋ ਮੈਨਾ ਤੈ ਮਾਰੀ ॥",
      "transliteration": "bhalo kariyo mainaa tai maaree ||",
      "translation": "",
      "punjabiViakhya": "ਤੂੰ ਚੰਗਾ ਕੀਤਾ ਕਿ ਮੈਨਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "भलो करियो मैना तै मारी ॥",
      "sourceLineId": "116620",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਸਿੰਧ ਏਸ ਕੇ ਸਾਥ ਬਿਹਾਰੀ ॥",
      "transliteration": "si(n)dh es ke saath bihaaree ||",
      "translation": "‘It is good you have killed Mynah as she loved the Raja of Sindh.",
      "punjabiViakhya": "ਅਤੇ ਸਿੰਧ ਦੇਸ ਦੇ ਰਾਜੇ ਨਾਲ ਸਹਿਵਾਸ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "सिंध एस के साथ बिहारी ॥",
      "sourceLineId": "116621",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਮੋਕਹ ਕਾਢਿ ਹਾਥ ਪੈ ਲੀਜੈ ॥",
      "transliteration": "mokeh kaadd haath pai leejai ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ (ਪਿੰਜਰੇ ਵਿਚੋਂ) ਕਢ ਕੇ ਹੱਥ ਉਤੇ ਧਰ ਲਵੋ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "मोकह काढि हाथ पै लीजै ॥",
      "sourceLineId": "116622",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਬੀਚ ਪਿੰਜਰਾ ਰਹਨ ਨ ਦੀਜੈ ॥੪੯॥",
      "transliteration": "beech pi(n)jaraa rahan na dheejai ||49||",
      "translation": "‘Now you take me in your hands and don’t let me remain in the cage.’(49)",
      "punjabiViakhya": "ਅਤੇ ਪਿੰਜਰੇ ਵਿਚ ਰਹਿਣ ਨਾ ਦਿਓ ॥੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "बीच पिंजरा रहन न दीजै ॥४९॥",
      "sourceLineId": "116623",
      "sourceShabadId": "10654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਸੋਰਠਾ ॥",
      "transliteration": "soraThaa ||",
      "translation": "Sortha",
      "punjabiViakhya": "ਸੋਰਠਾ:",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "सोरठा ॥",
      "sourceLineId": "116624",
      "sourceShabadId": "10655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਜਿਨਿ ਰੀਸਾਲੂ ਧਾਇ ਇਹ ਠਾ ਪਹੁੰਚੈ ਆਇ ਕੈ ॥",
      "transliteration": "jin reesaaloo dhai ieh Thaa pahu(n)chai aai kai ||",
      "translation": "‘Lest, Raja Rasaloo comes here,",
      "punjabiViakhya": "ਮਤਾ ਰਿਸਾਲੂ ਇਸ ਸਥਾਨ ਉਤੇ ਆ ਪਹੁੰਚੇ",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "जिनि रीसालू धाइ इह ठा पहुँचै आइ कै ॥",
      "sourceLineId": "116625",
      "sourceShabadId": "10655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0934_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਮੁਹਿ ਤੁਹਿ ਸਿੰਧੁ ਬਹਾਇ ਜਮਪੁਰ ਦੇਇ ਪਠਾਇ ਲਖਿ ॥੫੦॥",
      "transliteration": "muh tuh si(n)dh bahai jamapur dhei paThai lakh ||50||",
      "translation": "‘Throws us in (the river) Sindh and despatches us to the domain of death.’(50)",
      "punjabiViakhya": "ਅਤੇ ਮੈਨੂੰ ਅਤੇ ਤੈਨੂੰ ਵੇਖ ਕੇ ਸਿੰਧ ਨਦੀ ਵਿਚ ਵਹਾ ਕੇ ਜਮਲੋਕ ਭੇਜ ਦੇਵੇ ॥੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 934,
      "hindi": "",
      "hindiTransliteration": "मुहि तुहि सिंधु बहाइ जमपुर देइ पठाइ लखि ॥५०॥",
      "sourceLineId": "116626",
      "sourceShabadId": "10655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
