{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 935,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0935_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116627",
      "sourceShabadId": "10656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਬ ਤਿਹ ਕਾਢਿ ਹਾਥ ਪੈ ਲਯੋ ॥",
      "transliteration": "tab teh kaadd haath pai layo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਕੋਕਿਲਾ ਨੇ) ਉਸ ਤੋਤੇ ਨੂੰ ਕਢ ਕੇ ਹੱਥ ਉਤੇ ਧਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "तब तिह काढि हाथ पै लयो ॥",
      "sourceLineId": "116628",
      "sourceShabadId": "10656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦ੍ਰਿਸਟਿ ਚੁਕਾਇ ਸੂਆ ਉਡਿ ਗਯੋ ॥",
      "transliteration": "dhirasaT chukai sooaa udd gayo ||",
      "translation": "Then she took it (the parrot) out and sat it on her hand but, escaping her looks, it flew away,",
      "punjabiViakhya": "ਨਜ਼ਰ ਬਚਾ ਕੇ ਤੋਤਾ (ਉਥੋਂ) ਉਡ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "दृसटि चुकाइ सूआ उडि गयो ॥",
      "sourceLineId": "116629",
      "sourceShabadId": "10656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਾਇ ਰਿਸਾਲੂ ਸਾਥ ਜਤਾਯੋ ॥",
      "transliteration": "jai risaaloo saath jataayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਜਾ ਕੇ ਰਿਸਾਲੂ ਨੂੰ ਦਸਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "जाइ रिसालू साथ जतायो ॥",
      "sourceLineId": "116630",
      "sourceShabadId": "10656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਖੇਲਤ ਕਹਾ ਚੋਰ ਗ੍ਰਿਹ ਆਯੋ ॥੫੧॥",
      "transliteration": "khelat kahaa chor gireh aayo ||51||",
      "translation": "And went to Rasaloo and told, ‘A thief had come to your house.’(51)",
      "punjabiViakhya": "ਕਿ ਤੂੰ ਕਿਥੇ (ਸ਼ਿਕਾਰ) ਖੇਡ ਰਿਹਾ ਹੈਂ, (ਤੇਰੇ) ਘਰ ਚੋਰ ਆ ਗਿਆ ਹੈ ॥੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "खेलत कहा चोर गृह आयो ॥५१॥",
      "sourceLineId": "116631",
      "sourceShabadId": "10656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਯੌ ਸੁਨਿ ਬੈਨਿ ਰਿਸਾਲੂ ਧਾਯੋ ॥",
      "transliteration": "yau sun bain risaaloo dhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਬੋਲ ਸੁਣ ਕੇ (ਰਾਜਾ) ਰਿਸਾਲੂ ਦੌੜ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "यौ सुनि बैनि रिसालू धायो ॥",
      "sourceLineId": "116632",
      "sourceShabadId": "10656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤੁਰਤੁ ਧੌਲਹਰ ਕੇ ਤਟ ਆਯੋ ॥",
      "transliteration": "turat dhaualahar ke taT aayo ||",
      "translation": "Learning this Rasaloo walked fast and reached the palace immediately.",
      "punjabiViakhya": "ਅਤੇ ਤੁਰਤ ਮਹੱਲ ਦੇ ਨੇੜੇ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "तुरतु धौलहर के तट आयो ॥",
      "sourceLineId": "116633",
      "sourceShabadId": "10656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭੇਦ ਕੋਕਿਲਾ ਜਬ ਲਖਿ ਪਾਯੋ ॥",
      "transliteration": "bhedh kokilaa jab lakh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਕੋਕਿਲਾ ਨੂੰ ਇਸ ਭੇਦ ਦਾ ਪਤਾ ਲਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "भेद कोकिला जब लखि पायो ॥",
      "sourceLineId": "116634",
      "sourceShabadId": "10656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਫ ਕੇ ਬਿਖੈ ਲਪੇਟਿ ਦੁਰਾਯੋ ॥੫੨॥",
      "transliteration": "saf ke bikhai lapeT dhuraayo ||52||",
      "translation": "When Kokila learnt this, she wrapped around (the other Raja) a mat and hid him away.(52)",
      "punjabiViakhya": "(ਤਾ ਉਸ ਨੇ ਰਾਜਾ ਹੋਡੀ ਨੂੰ) ਚਟਾਈ ਵਿਚ ਲਪੇਟ ਕੇ ਛੁਪਾ ਦਿੱਤਾ ॥੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "सफ के बिखै लपेटि दुरायो ॥५२॥",
      "sourceLineId": "116635",
      "sourceShabadId": "10656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਹਿਯੋ ਬਕਤ੍ਰ ਫੀਕੌ ਕਿਯੋ ਭਯੋ ॥",
      "transliteration": "kahiyo bakatr feekau kiyo bhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ ਰਿਸਾਲੂ ਨੇ ਕੋਕਿਲਾ ਨੂੰ) ਕਿਹਾ (ਤੇਰਾ) ਮੂੰਹ ਫਿੱਕਾ ਕਿਉਾਂ ਪੈ ਗਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "कहियो बकत्र फीकौ कियो भयो ॥",
      "sourceLineId": "116636",
      "sourceShabadId": "10656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਨੁ ਕਰਿ ਰਾਹੁ ਲੂਟਿ ਸਸਿ ਲਯੋ ॥",
      "transliteration": "jan kar raahu looT sas layo ||",
      "translation": "‘Why is your face getting pale, as if god Rahu has squeezed light out of Moon?",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ) ਮਾਨੋ ਰਾਹੂ ਨੇ ਚੰਦ੍ਰਮਾ ਨੂੰ ਲੁਟ (ਗ੍ਰਸ) ਲਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "जनु करि राहु लूटि ससि लयो ॥",
      "sourceLineId": "116637",
      "sourceShabadId": "10656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅੰਬੁਯਨ ਕੀ ਅੰਬਿਆ ਕਿਨ ਹਰੀ ॥",
      "transliteration": "a(n)buyan kee a(n)biaa kin haree ||",
      "translation": "",
      "punjabiViakhya": "ਕਮਲ ਵਰਗੇ ਮੁਖੜੇ ('ਅੰਬੁਯਨ') ਦੀ ਚਮਕ ('ਅੰਬਿਆ') ਕਿਸ ਨੇ ਹਰ ਲਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "अंबुयन की अंबिआ किन हरी ॥",
      "sourceLineId": "116638",
      "sourceShabadId": "10656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਢੀਲੀ ਸੇਜ ਕਹੋ ਕਿਹ ਕਰੀ ॥੫੩॥",
      "transliteration": "ddeelee sej kaho keh karee ||53||",
      "translation": "‘Where has gone the pinkish sparkle of your eyes? Why is your bedding become slack?’(53)",
      "punjabiViakhya": "ਅਤੇ (ਇਹ ਵੀ) ਦਸ ਕਿ ਸੇਜ ਨੂੰ ਢਿਲਾ ਕਿਸ ਕੀਤਾ ਹੈ ॥੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "ढीली सेज कहो किह करी ॥५३॥",
      "sourceLineId": "116639",
      "sourceShabadId": "10656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "116640",
      "sourceShabadId": "10657",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਬ ਤੇ ਗਏ ਅਖੇਟ ਤੁਮ ਤਬ ਤੇ ਮੈ ਦੁਖ ਪਾਇ ॥",
      "transliteration": "jab te ge akheT tum tab te mai dhukh pai ||",
      "translation": "(She replied) Since the time you went out on hunting, I have been living in adversity.",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ ਉੱਤਰ ਦਿੱਤਾ) ਜਿਸ ਵੇਲੇ ਦੇ ਤੁਸੀਂ ਸ਼ਿਕਾਰ ਗਏ ਹੋ ਤਦ ਦਾ ਮੈਂ ਬਹੁਤ ਦੁਖ ਪਾ ਰਹੀ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "जब ते गए अखेट तुम तब ते मै दुख पाइ ॥",
      "sourceLineId": "116641",
      "sourceShabadId": "10657",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਘਾਯਲ ਜ੍ਯੋ ਘੂੰਮਤ ਰਹੀ ਬਿਨਾ ਤਿਹਾਰੇ ਰਾਇ ॥੫੪॥",
      "transliteration": "ghaayal jayo ghoo(n)mat rahee binaa tihaare rai ||54||",
      "translation": "‘I have been rolling around like an injured person.(54)",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਤੇਰੇ ਬਿਨਾ ਮੈਂ ਘਾਇਲ ਵਾਗ ਘੁੰਮਦੀ ਫਿਰਦੀ ਹਾ ॥੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "घायल ज्यो घूँमत रही बिना तिहारे राइ ॥५४॥",
      "sourceLineId": "116642",
      "sourceShabadId": "10657",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116643",
      "sourceShabadId": "10658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਾਤ ਬਹੀ ਅੰਬਿਯਨ ਲੈ ਗਈ ॥",
      "transliteration": "baat bahee a(n)biyan lai giee ||",
      "translation": "",
      "punjabiViakhya": "ਹਵਾ ਚਲੀ, (ਤਾ ਮੇਰੇ) ਕਮਲ ਵਰਗੇ ਮੁਖੜੇ ਦੀ ਚਮਕ ਲੈ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "बात बही अंबियन लै गई ॥",
      "sourceLineId": "116644",
      "sourceShabadId": "10658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮੋ ਤਨ ਮੈਨੁਪਜਾਵਤਿ ਭਈ ॥",
      "transliteration": "mo tan mainupajaavat bhiee ||",
      "translation": "‘Such a wind blew that slipped my mattress out and put in me an urge for love-making.",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੇ ਤਨ ਵਿਚ ਕਾਮ ਦੀ ਭਾਵਨਾ ਪੈਦਾ ਕਰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "मो तन मैनुपजावति भई ॥",
      "sourceLineId": "116645",
      "sourceShabadId": "10658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਬ ਮੈ ਲਏ ਅਧਿਕ ਪਸਵਾਰੇ ॥",
      "transliteration": "tab mai le adhik pasavaare ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਮੈਂ ਬਹੁਤ ਕਰਵਟਾ ਲਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "तब मै लए अधिक पसवारे ॥",
      "sourceLineId": "116646",
      "sourceShabadId": "10658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜੈਸੇ ਮ੍ਰਿਗ ਸਾਯਕ ਕੇ ਮਾਰੇ ॥੫੫॥",
      "transliteration": "jaise mirag saayak ke maare ||55||",
      "translation": "‘I whirl around like an injured baby of a deer.(55)",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਤੀਰ ਦੇ ਵਜਿਆਂ ਹਿਰਨ (ਲੈਂਦਾ ਹੈ) ॥੫੫॥",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "जैसे मृग सायक के मारे ॥५५॥",
      "sourceLineId": "116647",
      "sourceShabadId": "10658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਾ ਤੇ ਲਰੀ ਮੋਤਿਯਨ ਛੂਟੀ ॥",
      "transliteration": "taa te laree motiyan chhooTee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਕਰ ਕੇ ਮੋਤੀਆਂ ਦੀ ਲੜੀ ਟੁਟ ਗਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "ता ते लरी मोतियन छूटी ॥",
      "sourceLineId": "116648",
      "sourceShabadId": "10658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਉਡਗ ਸਹਿਤ ਨਿਸਿ ਜਨੁ ਰਵਿ ਟੂਟੀ ॥",
      "transliteration": "auddag sahit nis jan rav TooTee ||",
      "translation": "‘My pearly necklace is broken. The Moonlit night is destroyed by the Sun rays.",
      "punjabiViakhya": "ਮਾਨੋ ਤਾਰਿਆਂ ਸਮੇਤ ਰਾਤ ਨੂੰ ਸੂਰਜ ਨੇ ਦੂਰ ਕਰ ਦਿੱਤਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "उडग सहित निसि जनु रवि टूटी ॥",
      "sourceLineId": "116649",
      "sourceShabadId": "10658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹੌ ਅਤਿ ਦਖਿਤ ਮੈਨ ਸੌ ਭਈ ॥",
      "transliteration": "hau at dhakhit main sau bhiee ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਕਾਮ ਕਰ ਕੇ ਬਹੁਤ ਦੁਖੀ ਹੋ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "हौ अति दखित मैन सौ भई ॥",
      "sourceLineId": "116650",
      "sourceShabadId": "10658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਯਾ ਤੇ ਸੇਜ ਢੀਲ ਹ੍ਵੈ ਗਈ ॥੫੬॥",
      "transliteration": "yaa te sej ddeel havai giee ||56||",
      "translation": "‘Without making love 1 am distressed and, consequently, my bed is slackened.(56)",
      "punjabiViakhya": "ਇਸ ਕਰ ਕੇ ਸੇਜ ਢਿਲੀ ਹੋ ਗਈ ॥੫੬॥",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "या ते सेज ढील ह्वै गई ॥५६॥",
      "sourceLineId": "116651",
      "sourceShabadId": "10658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "116652",
      "sourceShabadId": "10659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਵ ਦਰਸਨ ਲਖਿ ਚਿਤ ਕੋ ਮਿਟਿ ਗਯੋ ਸੋਕ ਅਪਾਰ ॥",
      "transliteration": "tav dharasan lakh chit ko miT gayo sok apaar ||",
      "translation": "‘Seeing you, now, all my anxiety has diminished,",
      "punjabiViakhya": "(ਹੇ ਰਾਜਨ!) ਤੇਰਾ ਦਰਸ਼ਨ ਕਰ ਕੇ ਮੇਰੇ ਚਿਤ ਦਾ ਅਪਾਰ ਦੁਖ ਮਿਟ ਗਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "तव दरसन लखि चित को मिटि गयो सोक अपार ॥",
      "sourceLineId": "116653",
      "sourceShabadId": "10659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜ੍ਯੋ ਚਕਵੀ ਪਤਿ ਆਪਨੇ ਦਿਵਕਰ ਨੈਨ ਨਿਹਾਰ ॥੫੭॥",
      "transliteration": "jayo chakavee pat aapane dhivakar nain nihaar ||57||",
      "translation": "‘And I am beholding you the way the bird chakvi gets absorbed in the Moon.’(57)",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਚਕਵੀ ਆਪਣੇ ਪਤੀ ਸੂਰਜ ਨੂੰ ਅੱਖੀਂ ਵੇਖ ਕੇ (ਪ੍ਰਸੰਨ ਹੋ ਜਾਦੀ ਹੈ) ॥੫੭॥",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "ज्यो चकवी पति आपने दिवकर नैन निहार ॥५७॥",
      "sourceLineId": "116654",
      "sourceShabadId": "10659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116655",
      "sourceShabadId": "10660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਯੌ ਰਾਜਾ ਰਾਨੀ ਬਰਮਾਯੋ ॥",
      "transliteration": "yau raajaa raanee baramaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਰਾਣੀ ਨੇ ਰਾਜੇ ਨੂੰ ਭਰਮਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "यौ राजा रानी बरमायो ॥",
      "sourceLineId": "116656",
      "sourceShabadId": "10660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਘਰੀਕ ਬਾਤਨ ਸੋ ਉਰਝਾਯੋ ॥",
      "transliteration": "ghareek baatan so urajhaayo ||",
      "translation": "Thus Rani cajoled Raja with domestic sweet-talk,",
      "punjabiViakhya": "ਅਤੇ ਘੜੀ ਕੁ ਗੱਲਾ ਵਿਚ ਉਲਝਾਈ ਰਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "घरीक बातन सो उरझायो ॥",
      "sourceLineId": "116657",
      "sourceShabadId": "10660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪੁਨਿ ਤਾ ਸੌ ਇਹ ਭਾਤਿ ਉਚਾਰੋ ॥",
      "transliteration": "pun taa sau ieh bhaat uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਉਸ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "पुनि ता सौ इह भाति उचारो ॥",
      "sourceLineId": "116658",
      "sourceShabadId": "10660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੁਨੋ ਰਾਵ ਜੂ ਬਚਨ ਹਮਾਰੋ ॥੫੮॥",
      "transliteration": "suno raav joo bachan hamaaro ||58||",
      "translation": "And then said, ‘Listen to me my Raja,(58)",
      "punjabiViakhya": "ਕਿ ਹੇ ਰਾਜਨ! ਮੇਰੀ ਗੱਲ ਸੁਣੋ ॥੫੮॥",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "सुनो राव जू बचन हमारो ॥५८॥",
      "sourceLineId": "116659",
      "sourceShabadId": "10660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਹਮ ਤੁਮ ਕਰ ਮੇਵਾ ਦੋਊ ਲੇਹੀ ॥",
      "transliteration": "ham tum kar mevaa dhouoo lehee ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਤੇ ਤੁਸੀਂ ਦੋਵੇ ਹੱਥਾ ਵਿਚ ਮੇਵਾ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "हम तुम कर मेवा दोऊ लेही ॥",
      "sourceLineId": "116660",
      "sourceShabadId": "10660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਡਾਰਿ ਡਾਰਿ ਯਾ ਸਫ ਮੈ ਦੇਹੀ ॥",
      "transliteration": "ddaar ddaar yaa saf mai dhehee ||",
      "translation": "‘We both will eat the sultanas and then throw them towards the mat.",
      "punjabiViakhya": "ਚਟਾਈ ਵਿਚ ਸੁਟਾਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "डारि डारि या सफ मै देही ॥",
      "sourceLineId": "116661",
      "sourceShabadId": "10660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹਮ ਦੋਊ ਦਾਵ ਇਹੈ ਬਦ ਡਾਰੈ ॥",
      "transliteration": "ham dhouoo dhaav ihai badh ddaarai ||",
      "translation": "",
      "punjabiViakhya": "ਅਸੀਂ ਦੋਵੇਾਂ ਇਹ ਦਾਉ ਲਗਾਵਾਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "हम दोऊ दाव इहै बद डारै ॥",
      "sourceLineId": "116662",
      "sourceShabadId": "10660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੋ ਹਾਰੈ ਜਿਹ ਪਰੈ ਕਿਨਾਰੈ ॥੫੯॥",
      "transliteration": "so haarai jeh parai kinaarai ||59||",
      "translation": "‘We both will aim at the centre and one who hits the edge will lose.’(59)",
      "punjabiViakhya": "ਉਹ ਹਾਰੇਗਾ ਜਿਸ ਦਾ (ਨਿਸ਼ਾਨਾ) ਕੰਢੇ ਉਤੇ ਲਗੇਗਾ ॥੫੯॥",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "सो हारै जिह परै किनारै ॥५९॥",
      "sourceLineId": "116663",
      "sourceShabadId": "10660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "116664",
      "sourceShabadId": "10661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਬ ਦੁਹੂੰਅਨ ਮੇਵਾ ਲਯੋ ਐਸੇ ਬੈਨ ਬਖਾਨਿ ॥",
      "transliteration": "tab dhuhoo(n)an mevaa layo aaise bain bakhaan ||",
      "translation": "Deciding upon this, they took sultanas.",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਗੱਲ ਕਰ ਕੇ ਤਦ ਦੋਹਾ ਨੇ ਮੇਵਾ ਲੈ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "तब दुहूँअन मेवा लयो ऐसे बैन बखानि ॥",
      "sourceLineId": "116665",
      "sourceShabadId": "10661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚਤੁਰਿ ਨ੍ਰਿਪਤਿ ਅਤਿ ਚਿਤ ਹੁਤੋ ਇਹੀ ਬੀਚ ਗਯੋ ਜਾਨਿ ॥੬੦॥",
      "transliteration": "chatur nirapat at chit huto ihee beech gayo jaan ||60||",
      "translation": "Raja was very intelligent and he had envisaged the secret,(60)",
      "punjabiViakhya": "ਰਾਜਾ ਬਹੁਤ ਸਿਆਣਾ ਸੀ, ਇਸ (ਗੱਲ ਨੂੰ) ਚਿਤ ਵਿਚ ਜਲਦੀ ਸਮਝ ਗਿਆ ॥੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "चतुरि नृपति अति चित हुतो इही बीच गयो जानि ॥६०॥",
      "sourceLineId": "116666",
      "sourceShabadId": "10661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116667",
      "sourceShabadId": "10662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਬ ਰਾਜੈ ਇਹ ਬਚਨ ਉਚਾਰੀ ॥",
      "transliteration": "tab raajai ieh bachan uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜੇ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "तब राजै इह बचन उचारी ॥",
      "sourceLineId": "116668",
      "sourceShabadId": "10662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੁਨੁ ਰਾਨੀ ਕੋਕਿਲਾ ਪਿਆਰੀ ॥",
      "transliteration": "sun raanee kokilaa piaaree ||",
      "translation": "And he said, ‘Listen, my beloved Kokila Rani,",
      "punjabiViakhya": "ਹੇ ਪਿਆਰੀ ਕੋਕਿਲਾ ਰਾਣੀ! ਸੁਣ,",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "सुनु रानी कोकिला पिआरी ॥",
      "sourceLineId": "116669",
      "sourceShabadId": "10662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਏਕ ਹਰਾਇ ਮ੍ਰਿਗਹਿ ਮੈ ਆਯੋ ॥",
      "transliteration": "ek harai mirageh mai aayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਇਕ ਹਿਰਨ ਹਰਾ ਕੇ ਆਇਆ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "एक हराइ मृगहि मै आयो ॥",
      "sourceLineId": "116670",
      "sourceShabadId": "10662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕੰਪਤ ਬੂਟ ਮੈ ਦੁਰਿਯੋ ਡਰਾਯੋ ॥੬੧॥",
      "transliteration": "ka(n)pat booT mai dhuriyo ddaraayo ||61||",
      "translation": "‘I have just defeated a deer and, dreaded, it is hiding in the bushes.’(61)",
      "punjabiViakhya": "ਉਹ ਡਰ ਦਾ ਮਾਰਿਆ ਕੰਬਦਾ ਹੋਇਆ ਬੂਟਿਆਂ ਵਿਚ ਆ ਲੁਕਿਆ ਹੈ ॥੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "कंपत बूट मै दुरियो डरायो ॥६१॥",
      "sourceLineId": "116671",
      "sourceShabadId": "10662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹੌਡੀ ਬਾਤ ਮੂੰਡ ਇਹ ਆਨੀ ॥",
      "transliteration": "hauaddee baat moo(n)dd ieh aanee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ ਰਿਸਾਲੂ ਨੇ) ਇਹ ਗੱਲ ਹੋਡੀ ਰਾਜੇ ਦੇ ਸਿਰ ਉਤੇ ਟਿਕਾਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "हौडी बात मूँड इह आनी ॥",
      "sourceLineId": "116672",
      "sourceShabadId": "10662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮ੍ਰਿਗ ਪੈ ਕਰਿ ਕੋਕਿਲਾ ਪਛਾਨੀ ॥",
      "transliteration": "mirag pai kar kokilaa pachhaanee ||",
      "translation": "When Raja told her this, she accepted that Raja was really talking about the deer.",
      "punjabiViakhya": "ਪਰ ਕੋਕਿਲਾ ਨੇ ਹਿਰਨ ਉਤੇ ਸਮਝੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "मृग पै करि कोकिला पछानी ॥",
      "sourceLineId": "116673",
      "sourceShabadId": "10662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0935_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਹੇ ਤੌ ਤੁਰਤ ਤਾਹਿ ਹਨਿ ਲ੍ਯਾਊ ॥",
      "transliteration": "kahe tau turat taeh han layaauoo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ ਕਿਹਾ) ਜੇ ਕਹੇਾਂ ਤਾ ਤੁਰਤ ਉਸ ਨੂੰ ਮਾਰ ਲਿਆਵਾ",
      "source": "DASAM_GRANTH",
      "ang": 935,
      "hindi": "",
      "hindiTransliteration": "कहे तौ तुरत ताहि हनि ल्याऊ ॥",
      "sourceLineId": "116674",
      "sourceShabadId": "10662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
