{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 937,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0937_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਨੁ ਸਾਵਕ ਸਾਯਕ ਕੇ ਮਾਰੇ ॥",
      "transliteration": "jan saavak saayak ke maare ||",
      "translation": "His looks had luring effect like the sight of a deer for the hunter.",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ) ਮਾਨੋ ਹਿਰਨ ਦਾ ਬੱਚਾ ਤੀਰ ਦੇ ਮਾਰੇ ਜਾਣ ਤੇ (ਡਿਗ ਪੈਂਦਾ ਹੋਵੇ)।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "जनु सावक सायक के मारे ॥",
      "sourceLineId": "116723",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚਿਤ ਮੈ ਅਧਿਕ ਰੀਝ ਕੇ ਰਹੈ ॥",
      "transliteration": "chit mai adhik reejh ke rahai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਚਿਤ ਵਿਚ ਅਧਿਕ ਪ੍ਰਸੰਨ ਹੋ ਕੇ ਰਹਿੰਦੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "चित मै अधिक रीझ के रहै ॥",
      "sourceLineId": "116724",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਾਝਨ ਰਾਝਨ ਮੁਖ ਤੇ ਕਹੈ ॥੨॥",
      "transliteration": "raajhan raajhan mukh te kahai ||2||",
      "translation": "They would yearn for him, and always recited ‘Ranjha, Ranjha.’(2)",
      "punjabiViakhya": "ਅਤੇ ਮੂੰਹ ਤੋਂ 'ਰਾਝਾ ਰਾਝਾ' ਕਹਿੰਦੀਆਂ ਹਨ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "राझन राझन मुख ते कहै ॥२॥",
      "sourceLineId": "116725",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਰਮ ਕਾਲ ਤਹ ਐਸੋ ਭਯੋ ॥",
      "transliteration": "karam kaal teh aaiso bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਦਾ ਅਜਿਹਾ ਚਕਰ ਚਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "करम काल तह ऐसो भयो ॥",
      "sourceLineId": "116726",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤੌਨੇ ਦੇਸ ਕਾਲ ਪਰ ਗਯੋ ॥",
      "transliteration": "tauane dhes kaal par gayo ||",
      "translation": "There was time when the famine had spread over the country.",
      "punjabiViakhya": "ਕਿ ਉਸ ਦੇ ਦੇਸ਼ ਵਿਚ ਕਾਲ ਪੈ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "तौने देस काल पर गयो ॥",
      "sourceLineId": "116727",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਿਯਤ ਨ ਕੌ ਨਰ ਬਚਿਯੋ ਨਗਰ ਮੈ ॥",
      "transliteration": "jiyat na kau nar bachiyo nagar mai ||",
      "translation": "",
      "punjabiViakhya": "ਕੋਈ ਵੀ ਬੰਦਾ ਜੀਉਾਂਦਾ ਨਗਰ ਵਿਚ ਨਾ ਬਚਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "जियत न कौ नर बचियो नगर मै ॥",
      "sourceLineId": "116728",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੋ ਉਬਰਿਯੋ ਜਾ ਕੇ ਧਨੁ ਘਰ ਮੈ ॥੩॥",
      "transliteration": "so ubariyo jaa ke dhan ghar mai ||3||",
      "translation": "Lot of people did not escape death and the only ones who were wealthy survived.(3)",
      "punjabiViakhya": "ਉਹੀ ਬਚਿਆ ਜਿਸ ਦੇ ਘਰ ਵਿਚ ਧਨ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "सो उबरियो जा के धनु घर मै ॥३॥",
      "sourceLineId": "116729",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਚਿਤ੍ਰ ਦੇਵਿ ਇਕ ਰਾਨਿ ਨਗਰ ਮੈ ॥",
      "transliteration": "chitr dhev ik raan nagar mai ||",
      "translation": "",
      "punjabiViakhya": "ਨਗਰ ਵਿਚ ਚਿਤ੍ਰ ਦੇਵੀ ਨਾ ਦੀ ਇਕ ਰਾਣੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "चित्र देवि इक रानि नगर मै ॥",
      "sourceLineId": "116730",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰਾਝਾ ਏਕ ਪੂਤ ਤਿਹ ਘਰ ਮੈ ॥",
      "transliteration": "raajhaa ek poot teh ghar mai ||",
      "translation": "In the city a Rani named Chitardevi, there used to live who had this son named Ranjah.",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਰਾਝਾ ਨਾ ਦਾ ਇਕ ਪੁੱਤਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "राझा एक पूत तिह घर मै ॥",
      "sourceLineId": "116731",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਾ ਕੇ ਔਰ ਨ ਬਚਿਯੋ ਕੋਈ ॥",
      "transliteration": "taa ke aauar na bachiyo koiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦਾ ਹੋਰ ਕੋਈ ਵੀ ਨਾ ਬਚਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "ता के और न बचियो कोई ॥",
      "sourceLineId": "116732",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਾਇ ਪੂਤ ਵੈ ਬਾਚੇ ਦੋਈ ॥੪॥",
      "transliteration": "mai poot vai baache dhoiee ||4||",
      "translation": "Except those two, the mother and the son, none had survived.(4)",
      "punjabiViakhya": "ਉਹ ਮਾਤਾ ਅਤੇ ਪੁੱਤਰ ਦੋਵੇਾਂ ਬਚੇ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "माइ पूत वै बाचे दोई ॥४॥",
      "sourceLineId": "116733",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਨਿਯਹਿ ਭੂਖ ਅਧਿਕ ਜਬ ਜਾਗੀ ॥",
      "transliteration": "raniyeh bhookh adhik jab jaagee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੂੰ ਜਦੋਂ ਭੁਖ ਨੇ ਅਧਿਕ ਸਤਾਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "रनियहि भूख अधिक जब जागी ॥",
      "sourceLineId": "116734",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਾ ਕੌ ਬੇਚਿ ਮੇਖਲਾ ਸਾਜੀ ॥",
      "transliteration": "taa kau bech mekhalaa saajee ||",
      "translation": "When the hunger tormented the woman, she thought of a plan.",
      "punjabiViakhya": "ਤਾ (ਉਸ ਨੇ) ਪੁੱਤਰ ਨੂੰ ਵੇਚ ਕੇ ਗੋਦੜੀ ਧਾਰਨ ਕਰ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "ता कौ बेचि मेखला साजी ॥",
      "sourceLineId": "116735",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਿਤਿ ਪੀਸਨ ਪਰ ਦ੍ਵਾਰੇ ਜਾਵੈ ॥",
      "transliteration": "nit peesan par dhavaiaare jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਨਿੱਤ ਹੋਰਨਾ ਦੇ ਦੁਆਰ ਤੇ (ਅੰਨ) ਪੀਹਣ ਲਈ ਜਾਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "निति पीसन पर द्वारे जावै ॥",
      "sourceLineId": "116736",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜੂਠ ਚੂਨ ਚੌਕਾ ਚੁਨਿ ਖਾਵੈ ॥੫॥",
      "transliteration": "jooTh choon chauakaa chun khaavai ||5||",
      "translation": "She would go to other houses to grind flour, and the left-over there, she would bring home to eat.(5)",
      "punjabiViakhya": "ਅਤੇ ਚੌਕੇ ਤੋਂ ਜੂਠ ਅਤੇ ਆਟਾ ਚੁਕ ਕੇ ਖਾਦੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "जूठ चून चौका चुनि खावै ॥५॥",
      "sourceLineId": "116737",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਐਸੇ ਹੀ ਭੂਖਨ ਮਰਿ ਗਈ ॥",
      "transliteration": "aaise hee bhookhan mar giee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਇਸ ਤਰ੍ਰਹਾ ਭੁਖਿਆਂ ਹੀ ਮਰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "ऐसे ही भूखन मरि गई ॥",
      "sourceLineId": "116738",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪੁਨਿ ਬਿਧਿ ਤਹਾ ਬ੍ਰਿਸਟਿ ਅਤਿ ਦਈ ॥",
      "transliteration": "pun bidh tahaa birasaT at dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਵਿਧਾਤਾ ਨੇ ਉਥੇ ਬਹੁਤ ਬਰਖਾ ਕਰ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "पुनि बिधि तहा बृसटि अति दई ॥",
      "sourceLineId": "116739",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੂਕੇ ਭਏ ਹਰੇ ਜਨੁ ਸਾਰੇ ॥",
      "transliteration": "sooke bhe hare jan saare ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸਾਰੇ ਸੁਕੇ ਹੋਏ ਹਰੇ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "सूके भए हरे जनु सारे ॥",
      "sourceLineId": "116740",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਹੁਰਿ ਜੀਤ ਕੇ ਬਜੇ ਨਗਾਰੇ ॥੬॥",
      "transliteration": "bahur jeet ke baje nagaare ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਜਿਤ ਦੇ ਨਗਾਰੇ ਵਜਣ ਲਗੇ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "बहुरि जीत के बजे नगारे ॥६॥",
      "sourceLineId": "116741",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਹਾ ਏਕ ਰਾਝਾ ਹੀ ਉਬਰਿਯੋ ॥",
      "transliteration": "tahaa ek raajhaa hee ubariyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਰਾਝਾ ਹੀ ਬਚਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "तहा एक राझा ही उबरियो ॥",
      "sourceLineId": "116742",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਔਰ ਲੋਗ ਸਭ ਤਹ ਕੋ ਮਰਿਯੋ ॥",
      "transliteration": "aauar log sabh teh ko mariyo ||",
      "translation": "This way she eliminated her hunger and, then, suddenly, Almighty",
      "punjabiViakhya": "ਉਸ ਦੇ ਹੋਰ ਸਾਰੇ ਲੋਕ ਮਰ ਗਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "और लोग सभ तह को मरियो ॥",
      "sourceLineId": "116743",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰਾਝੋ ਜਾਟ ਹੇਤ ਤਿਨ ਪਾਰਿਯੋ ॥",
      "transliteration": "raajho jaaT het tin paariyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਝੇ ਨੂੰ (ਖਰੀਦਣ ਵਾਲੇ) ਜੱਟ ਨੇ ਹਿਤ ਨਾਲ ਪਾਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "राझो जाट हेत तिन पारियो ॥",
      "sourceLineId": "116744",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪੂਤ ਭਾਵ ਤੇ ਤਾਹਿ ਜਿਯਾਰਿਯੋ ॥੭॥",
      "transliteration": "poot bhaav te taeh jiyaariyo ||7||",
      "translation": "Had a benevolent observation; all that was dry became green(7)",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਪੁੱਤਰਾ ਵਾਗ ਜਿਵਾਇਆ (ਭਾਵ ਵੱਡਾ ਕੀਤਾ) ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "पूत भाव ते ताहि जियारियो ॥७॥",
      "sourceLineId": "116745",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪੂਤ ਜਾਟ ਕੋ ਸਭ ਕੋ ਜਾਨੈ ॥",
      "transliteration": "poot jaaT ko sabh ko jaanai ||",
      "translation": "",
      "punjabiViakhya": "(ਹੁਣ) ਸਭ ਕੋਈ (ਉਸ ਨੂੰ) ਜੱਟ ਦਾ ਪੁੱਤਰ ਸਮਝਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "पूत जाट को सभ को जानै ॥",
      "sourceLineId": "116746",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਿਸ ਤੇ ਕੋਊ ਨ ਰਹਿਯੋ ਪਛਾਨੈ ॥",
      "transliteration": "tis te kouoo na rahiyo pachhaanai ||",
      "translation": "All, now, realised that he (Ranjha) was the son of a Jat and no one realised his real identity (that he was the son of a Rani).",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਕੋਈ ਪਛਾਣਨ ਵਾਲਾ ਨਾ ਰਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "तिस ते कोऊ न रहियो पछानै ॥",
      "sourceLineId": "116747",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਐਸੇ ਕਾਲ ਬੀਤ ਕੈ ਗਯੋ ॥",
      "transliteration": "aaise kaal beet kai gayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਸਮਾ ਬੀਤਦਾ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "ऐसे काल बीत कै गयो ॥",
      "sourceLineId": "116748",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਾ ਮੈ ਮਦਨ ਦਮਾਮੋ ਦਯੋ ॥੮॥",
      "transliteration": "taa mai madhan dhamaamo dhayo ||8||",
      "translation": "The famine subsided and the age of sensuality over powered.(8)",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਵਿਚ ਕਾਮ ਦੇਵ ਨੇ ਨਗਾਰਾ ਵਜਾ ਦਿੱਤਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "ता मै मदन दमामो दयो ॥८॥",
      "sourceLineId": "116749",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਹਿਖੀ ਚਾਰਿ ਨਿਤਿ ਗ੍ਰਿਹ ਆਵੈ ॥",
      "transliteration": "mahikhee chaar nit gireh aavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮੱਝਾ ਚਰਾ ਕੇ ਰੋਜ਼ ਘਰ ਆਉਾਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "महिखी चारि निति गृह आवै ॥",
      "sourceLineId": "116750",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਰਾਝਾ ਅਪਨੋ ਨਾਮ ਸਦਾਵੈ ॥",
      "transliteration": "raajhaa apano naam sadhaavai ||",
      "translation": "He used to come back in the evening after grazing the cattle and became known as Ranjah.",
      "punjabiViakhya": "ਅਤੇ ਆਪਣਾ ਨਾ ਰਾਝਾ ਅਖਵਾਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "राझा अपनो नाम सदावै ॥",
      "sourceLineId": "116751",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪੂਤ ਜਾਟ ਕੋ ਤਿਹ ਸਭ ਜਾਨੈ ॥",
      "transliteration": "poot jaaT ko teh sabh jaanai ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਉਸ ਨੂੰ ਜਟ ਦਾ ਪੁੱਤਰ ਸਮਝਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "पूत जाट को तिह सभ जानै ॥",
      "sourceLineId": "116752",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਜਪੂਤੁ ਕੈ ਕੋ ਪਹਿਚਾਨੈ ॥੯॥",
      "transliteration": "raajapoot kai ko pahichaanai ||9||",
      "translation": "Every body thought him to be the son of a Jat and none acknowledged him as the son of a Raja.(9)",
      "punjabiViakhya": "ਅਤੇ ਰਾਜਪੂਤ ਵਜੋਂ ਪਛਾਣਦੇ ਸਨ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "राजपूतु कै को पहिचानै ॥९॥",
      "sourceLineId": "116753",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਇਤੀ ਬਾਤ ਰਾਝਾ ਕੀ ਕਹੀ ॥",
      "transliteration": "eitee baat raajhaa kee kahee ||",
      "translation": "",
      "punjabiViakhya": "ਇੰਨੀ ਗੱਲ ਰਾਝੇ ਬਾਰੇ ਕਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "इती बात राझा की कही ॥",
      "sourceLineId": "116754",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਬ ਚਲਿ ਬਾਤ ਹੀਰ ਪੈ ਰਹੀ ॥",
      "transliteration": "ab chal baat heer pai rahee ||",
      "translation": "Thus far we have talked about Ranjha, now we consider Heer.",
      "punjabiViakhya": "ਹੁਣ ਗੱਲ ਹੀਰ ਵਲ ਮੁੜਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "अब चलि बात हीर पै रही ॥",
      "sourceLineId": "116755",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤੁਮ ਕੌ ਤਾ ਕੀ ਕਥਾ ਸੁਨਾਊ ॥",
      "transliteration": "tum kau taa kee kathaa sunaauoo ||",
      "translation": "",
      "punjabiViakhya": "(ਹੁਣ) ਤੁਹਾਨੂੰ ਉਸ ਦੀ ਕਥਾ ਸੁਣਾਉਾਂਦਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "तुम कौ ता की कथा सुनाऊ ॥",
      "sourceLineId": "116756",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਾ ਤੇ ਤੁਮਰੋ ਹ੍ਰਿਦੈ ਸਿਰਾਊ ॥੧੦॥",
      "transliteration": "taa te tumaro hiradhai siraauoo ||10||",
      "translation": "I will narrate you their story to delight your mind.(10)",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਤੁਹਾਡਾ ਮਨ ਪ੍ਰਸੰਨ ਕਰਦਾ ਹਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "ता ते तुमरो हृदै सिराऊ ॥१०॥",
      "sourceLineId": "116757",
      "sourceShabadId": "10667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "Arril",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "116758",
      "sourceShabadId": "10668",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਇੰਦ੍ਰ ਰਾਇ ਕੇ ਨਗਰ ਅਪਸਰਾ ਇਕ ਰਹੈ ॥",
      "transliteration": "ei(n)dhr rai ke nagar apasaraa ik rahai ||",
      "translation": "In the city of Inder Rai, a damsel lived,",
      "punjabiViakhya": "ਇੰਦਰ ਰਾਇ ਦੇ ਨਗਰ (ਇੰਦਰਪੁਰੀ) ਵਿਚ ਇਕ ਅਪੱਛਰਾ ਰਹਿੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "इंद्र राइ के नगर अपसरा इक रहै ॥",
      "sourceLineId": "116759",
      "sourceShabadId": "10668",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮੈਨ ਕਲਾ ਤਿਹ ਨਾਮ ਸਕਲ ਜਗ ਯੌ ਕਹੈ ॥",
      "transliteration": "main kalaa teh naam sakal jag yau kahai ||",
      "translation": "Her name was known all over the world.",
      "punjabiViakhya": "ਸਾਰਾ ਜਗਤ ਉਸ ਦਾ ਨਾ ਮੈਨ ਕਲਾ ਕਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "मैन कला तिह नाम सकल जग यौ कहै ॥",
      "sourceLineId": "116760",
      "sourceShabadId": "10668",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਾ ਕੌ ਰੂਪ ਨਰੇਸ ਜੋ ਕੋਊ ਨਿਹਾਰਹੀ ॥",
      "transliteration": "taa kau roop nares jo kouoo nihaarahee ||",
      "translation": "Any Raja who saw her would be overcome with lust.",
      "punjabiViakhya": "ਉਸ ਦਾ ਰੂਪ ਜੋ ਕੋਈ ਰਾਜਾ ਵੇਖਦਾ ਉਹ ਕਾਮ ਦੇ ਬਾਣ ਦਾ ਵਿੰਨ੍ਰਹਿਆ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "ता कौ रूप नरेस जो कोऊ निहारही ॥",
      "sourceLineId": "116761",
      "sourceShabadId": "10668",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹੋ ਗਿਰੈ ਧਰਨਿ ਪਰ ਝੂਮਿ ਮੈਨ ਸਰ ਮਾਰਹੀ ॥੧੧॥",
      "transliteration": "ho girai dharan par jhoom main sar maarahee ||11||",
      "translation": "After reeling and spinning, they would fall flat on the ground. ||11||",
      "punjabiViakhya": "ਭਵਾਟਣੀ ਖਾ ਕੇ ਧਰਤੀ ਉਤੇ ਡਿਗ ਪੈਂਦਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "हो गिरै धरनि पर झूमि मैन सर मारही ॥११॥",
      "sourceLineId": "116762",
      "sourceShabadId": "10668",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "116763",
      "sourceShabadId": "10669",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤੌਨੇ ਸਭਾ ਕਪਿਲ ਮੁਨਿ ਆਯੋ ॥",
      "transliteration": "tauane sabhaa kapil mun aayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸਭਾ ਵਿਚ ਕਪਿਲ ਮੁਨੀ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "तौने सभा कपिल मुनि आयो ॥",
      "sourceLineId": "116764",
      "sourceShabadId": "10669",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਔਸਰ ਜਹਾ ਮੈਨਕਾ ਪਾਯੋ ॥",
      "transliteration": "aauasar jahaa mainakaa paayo ||",
      "translation": "At that place, once the ascetic Kapil Munni had come and seen (the damsel) Maneka,",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਉਥੇ ਮੈਨਕਾ ਨੂੰ (ਵੇਖਣ ਦਾ ਅਵਸਰ) ਮਿਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "औसर जहा मैनका पायो ॥",
      "sourceLineId": "116765",
      "sourceShabadId": "10669",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਿਹ ਲਖਿ ਮੁਨਿ ਬੀਰਜ ਗਿਰਿ ਗਯੋ ॥",
      "transliteration": "teh lakh mun beeraj gir gayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਮੁਨੀ ਦਾ ਵੀਰਜ ਡਿਗ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "तिह लखि मुनि बीरज गिरि गयो ॥",
      "sourceLineId": "116766",
      "sourceShabadId": "10669",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚਪਿ ਚਿਤ ਮੈ ਸ੍ਰਾਪਤ ਤਿਹ ਭਯੋ ॥੧੨॥",
      "transliteration": "chap chit mai sraapat teh bhayo ||12||",
      "translation": "On her sight, his semen dripped down and he pronounced a curse,(12)",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਚਿਤ ਵਿਚ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਉਸ ਨੂੰ ਸਰਾਪ ਦਿੱਤਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "चपि चित मै स्रापत तिह भयो ॥१२॥",
      "sourceLineId": "116767",
      "sourceShabadId": "10669",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤੁਮ ਗਿਰਿ ਮਿਰਤ ਲੋਕ ਮੈ ਪਰੋ ॥",
      "transliteration": "tum gir mirat lok mai paro ||",
      "translation": "",
      "punjabiViakhya": "ਤੂੰ ਡਿਗ ਕੇ ਮਿਰਤ ਲੋਕ ਵਿਚ ਜਾ ਪੈ",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "तुम गिरि मिरत लोक मै परो ॥",
      "sourceLineId": "116768",
      "sourceShabadId": "10669",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜੂਨਿ ਸਯਾਲ ਜਾਟ ਕੀ ਧਰੋ ॥",
      "transliteration": "joon sayaal jaaT kee dharo ||",
      "translation": "‘You go to the domain of humanity and take birth into the family of Sial Jat.’",
      "punjabiViakhya": "ਅਤੇ ਸਿਆਲ ਜੱਟ ਦੀ ਜੂਨ ਧਾਰਨ ਕਰ।",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "जूनि सयाल जाट की धरो ॥",
      "sourceLineId": "116769",
      "sourceShabadId": "10669",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0937_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਹੀਰ ਆਪਨੋ ਨਾਮ ਸਦਾਵੋ ॥",
      "transliteration": "heer aapano naam sadhaavo ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣਾ ਨਾਮ ਹੀਰ ਸਦਵਾ",
      "source": "DASAM_GRANTH",
      "ang": 937,
      "hindi": "",
      "hindiTransliteration": "हीर आपनो नाम सदावो ॥",
      "sourceLineId": "116770",
      "sourceShabadId": "10669",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
