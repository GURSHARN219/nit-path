{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 947,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0947_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਾਨਕ ਰੰਕ ਨਵੋ ਨਿਧਿ ਪਾਈ ॥",
      "transliteration": "jaanak ra(n)k navo nidh paiee ||",
      "translation": "destitute had gained nine treasurers (of Kuber).",
      "punjabiViakhya": "ਮਾਨੋ ਕਿਸੇ ਨਿਰਧਨ ਨੇ ਨੌ ਨਿਧੀਆਂ ਪ੍ਰਾਪਤ ਕਰ ਲਈਆਂ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "जानक रंक नवो निधि पाई ॥",
      "sourceLineId": "117251",
      "sourceShabadId": "10726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਐਸੀ ਬਸਿ ਤਰੁਨੀ ਹ੍ਵੈ ਗਈ ॥",
      "transliteration": "aaisee bas tarunee havai giee ||",
      "translation": "She was immersed so intensively (in his thought) that she felt as if",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ (ਉਹ) ਮੁਟਿਆਰ ਵਸ ਵਿਚ ਹੋ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "ऐसी बसि तरुनी ह्वै गई ॥",
      "sourceLineId": "117252",
      "sourceShabadId": "10726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਾਨਹੁ ਸਾਹ ਜਲਾਲੈ ਭਈ ॥੩੪॥",
      "transliteration": "maanahu saeh jalaalai bhiee ||34||",
      "translation": "she herself had become Jallaal Shah.(34)",
      "punjabiViakhya": "ਮਾਨੋ ਸ਼ਾਹ ਜਲਾਲ ਹੀ ਹੋ ਗਈ ਹੋਵੇ ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "मानहु साह जलालै भई ॥३४॥",
      "sourceLineId": "117253",
      "sourceShabadId": "10726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "117254",
      "sourceShabadId": "10727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਰੁਨ ਬਸਤ੍ਰ ਅਤਿ ਕ੍ਰਾਤ ਤਿਹ ਤਰੁਨਿ ਤਰੁਨ ਕੋ ਪਾਇ ॥",
      "transliteration": "arun basatr at kraat teh tarun tarun ko pai ||",
      "translation": "Both, the man and the woman, put on multifarious red garments,",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਨੇ ਲਾਲ ਰੰਗ ਦੇ ਬਹੁਤ ਚਮਕੀਲੇ ਬਸਤ੍ਰ ਆਪਣੇ ਪ੍ਰੇਮੀ ਨੂੰ ਪਵਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "अरुन बसत्र अति क्रात तिह तरुनि तरुन को पाइ ॥",
      "sourceLineId": "117255",
      "sourceShabadId": "10727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਭੋਗਨ ਭਯੋ ਤਾਹਿ ਗਰੇ ਸੌ ਲਾਇ ॥੩੫॥",
      "transliteration": "bhaat bhaat bhogan bhayo taeh gare sau lai ||35||",
      "translation": "Embraced each other, and made love in various manners.(35)",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਗਲੇ ਨਾਲ ਲਾ ਕੇ ਭਾਤ ਭਾਤ ਦੀ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ ॥੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "भाति भाति भोगन भयो ताहि गरे सौ लाइ ॥३५॥",
      "sourceLineId": "117256",
      "sourceShabadId": "10727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "117257",
      "sourceShabadId": "10728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਐਸੀ ਪ੍ਰੀਤਿ ਦੁਹੂ ਕੀ ਲਾਗੀ ॥",
      "transliteration": "aaisee preet dhuhoo kee laagee ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੋਹਾ ਦੀ ਅਜਿਹੀ ਪ੍ਰੀਤ ਲਗੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "ऐसी प्रीति दुहू की लागी ॥",
      "sourceLineId": "117258",
      "sourceShabadId": "10728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਾ ਕੋ ਸਭ ਗਾਵਤ ਅਨੁਰਾਗੀ ॥",
      "transliteration": "jaa ko sabh gaavat anuraagee ||",
      "translation": "Both fell in love so much that all and Sundry began to shower praises.",
      "punjabiViakhya": "ਕਿ ਉਸ ਨੂੰ ਸਾਰੇ ਪ੍ਰੇਮ ਪੂਰਵਕ ਗਾਉਾਂਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "जा को सभ गावत अनुरागी ॥",
      "sourceLineId": "117259",
      "sourceShabadId": "10728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੋਤ ਜਗਤ ਡੋਲਤ ਹੀ ਮਗ ਮੈ ॥",
      "transliteration": "sot jagat ddolat hee mag mai ||",
      "translation": "Their stOry of affection initiated love-recitations among travellers",
      "punjabiViakhya": "ਉਹ (ਉਸ ਪ੍ਰੇਮ ਕਥਾ ਨੂੰ) ਸੁਤਿਆਂ, ਜਾਗਦਿਆਂ ਅਤੇ ਰਸਤਿਆਂ ਵਿਚ ਗਾਉਾਂਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "सोत जगत डोलत ही मग मै ॥",
      "sourceLineId": "117260",
      "sourceShabadId": "10728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਾਹਿਰ ਭਈ ਸਗਲ ਹੀ ਜਗ ਮੈ ॥੩੬॥",
      "transliteration": "jaahir bhiee sagal hee jag mai ||36||",
      "translation": "and, then, became legendry through out the world.(36)",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ ਇਹ ਕਥਾ) ਸਾਰੇ ਸੰਸਾਰ ਪ੍ਰਗਟ ਹੋ ਗਈ ਹੈ ॥੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "जाहिर भई सगल ही जग मै ॥३६॥",
      "sourceLineId": "117261",
      "sourceShabadId": "10728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਤਿੰਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੦੩॥੧੯੩੫॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau ti(n)n charitr samaapatam sat subham sat ||103||1935||afajoo(n)||",
      "translation": "103rd Parable of Auspicious Chritars Conversation of the Raja and the Minister, Completed With Benediction. (103)(1933)",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਯਾ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ਇਕ ਸੌ ਤਿੰਨ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੦੩॥੧੯੩੫॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ तिंन चरित्र समापतम सतु सुभम सतु ॥१०३॥१९३५॥अफजूँ॥",
      "sourceLineId": "117262",
      "sourceShabadId": "10728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "117263",
      "sourceShabadId": "10729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਕ ਅਬਲਾ ਥੀ ਜਾਟ ਕੀ ਤਸਕਰ ਸੋ ਤਿਹ ਨੇਹ ॥",
      "transliteration": "eik abalaa thee jaaT kee tasakar so teh neh ||",
      "translation": "There was the wife of a Jat, the peasant, who fell in love with a thief.",
      "punjabiViakhya": "ਇਕ ਜੱਟ ਦੀ ਇਸਤਰੀ ਸੀ ਜਿਸ ਦਾ (ਇਕ) ਚੋਰ ਨਾਲ ਪ੍ਰੇਮ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "इक अबला थी जाट की तसकर सो तिह नेह ॥",
      "sourceLineId": "117264",
      "sourceShabadId": "10729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕੇਲ ਕਮਾਵਤ ਤੌਨ ਸੋ ਨਿਤਿ ਬੁਲਾਵਤ ਗ੍ਰੇਹ ॥੧॥",
      "transliteration": "kel kamaavat tauan so nit bulaavat greh ||1||",
      "translation": "She would call him at her house and have sex with him.(1)",
      "punjabiViakhya": "(ਉਹ) ਉਸ ਨੂੰ ਨਿੱਤ ਘਰ ਬੁਲਾ ਕੇ ਕੇਲ ਕਰਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "केल कमावत तौन सो निति बुलावत ग्रेह ॥१॥",
      "sourceLineId": "117265",
      "sourceShabadId": "10729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "117266",
      "sourceShabadId": "10730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਤਸਕਰ ਗ੍ਰਿਹ ਆਯੋ ॥",
      "transliteration": "ek dhivas tasakar gireh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ (ਜਦ) ਚੋਰ ਘਰ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "एक दिवस तसकर गृह आयो ॥",
      "sourceLineId": "117267",
      "sourceShabadId": "10730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਹਸਿ ਨਾਰਿ ਯੌ ਬਚਨ ਸੁਨਾਯੋ ॥",
      "transliteration": "bahas naar yau bachan sunaayo ||",
      "translation": "One day when the thief came to her house, she jovially said,",
      "punjabiViakhya": "(ਤਾ) ਇਸਤਰੀ ਨੇ ਹਸ ਕੇ ਉਸ ਪ੍ਰਤਿ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "बहसि नारि यौ बचन सुनायो ॥",
      "sourceLineId": "117268",
      "sourceShabadId": "10730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਹਾ ਚੋਰ ਤੁਮ ਦਰਬੁ ਚੁਰਾਵਤ ॥",
      "transliteration": "kahaa chor tum dharab churaavat ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਚੋਰ! ਤੂੰ ਕੀ ਧਨ ਚੁਰਾਉਾਂਦਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "कहा चोर तुम दरबु चुरावत ॥",
      "sourceLineId": "117269",
      "sourceShabadId": "10730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੁ ਤੁਮ ਨਿਜੁ ਧਨ ਹਿਰਿ ਲੈ ਜਾਵਤ ॥੨॥",
      "transliteration": "s tum nij dhan hir lai jaavat ||2||",
      "translation": "‘What type of thief are you? You steel the goods, which are your own wealth.(2)",
      "punjabiViakhya": "ਉਹ ਤਾ ਤੂੰ ਆਪਣਾ ਧਨ ਹੀ ਲੁਟ ਕੇ ਲੈ ਜਾਦਾ ਹੈਂ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "सु तुम निजु धन हिरि लै जावत ॥२॥",
      "sourceLineId": "117270",
      "sourceShabadId": "10730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "117271",
      "sourceShabadId": "10731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਾਪਤ ਹੋ ਚਿਤ ਮੈ ਅਧਿਕ ਨੈਕੁ ਨਿਹਾਰਤ ਭੋਰ ॥",
      "transliteration": "kaapat ho chit mai adhik naik nihaarat bhor ||",
      "translation": "‘When the day just breaks, you start trembling,",
      "punjabiViakhya": "ਜ਼ਰਾ ਜਿਹੀ ਵੀ ਸਵੇਰ ਹੋਈ ਵੇਖਦਾ ਹੈਂ ਤਾ ਚਿਤ ਵਿਚ ਬਹੁਤ ਕੰਬਦਾ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "कापत हो चित मै अधिक नैकु निहारत भोर ॥",
      "sourceLineId": "117272",
      "sourceShabadId": "10731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭਜਤ ਸੰਧਿ ਕੋ ਤਜਿ ਸਦਨ ਚਿਤ ਚੁਰਾਵੋ ਚੋਰ ॥੩॥",
      "transliteration": "bhajat sa(n)dh ko taj sadhan chit churaavo chor ||3||",
      "translation": "‘You just steal the heart and run away without committing the theft.’(3)",
      "punjabiViakhya": "ਚਿਤ ਨੂੰ ਚੁਰਾ ਕੇ ਘਰ ਦੀ ਸੰਨ੍ਰਹ ਨੂੰ ਛਡ ਕੇ ਭਜ ਜਾਦਾ ਹੈਂ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "भजत संधि को तजि सदन चित चुरावो चोर ॥३॥",
      "sourceLineId": "117273",
      "sourceShabadId": "10731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "117274",
      "sourceShabadId": "10732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪ੍ਰਥਮ ਸਾਧਿ ਦੈ ਦਰਬੁ ਚੁਰਾਵੈ ॥",
      "transliteration": "pratham saadh dhai dharab churaavai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ (ਤੂੰ) ਸੰਨ੍ਰਹ ਲਾ ਕੇ ਧਨ ਚੁਰਾ ਲੈ।",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "प्रथम साधि दै दरबु चुरावै ॥",
      "sourceLineId": "117275",
      "sourceShabadId": "10732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪੁਨਿ ਅਪੁਨੇ ਪਤਿ ਕੌ ਦਿਖਰਾਵੈ ॥",
      "transliteration": "pun apune pat kau dhikharaavai ||",
      "translation": "(She presented a scheme) ‘First of all I will break the house-wall and then burgle the wealth.",
      "punjabiViakhya": "ਫਿਰ ਮੈਂ ਆਪਣੇ ਪਤੀ ਨੂੰ ਦਿਖਾਵਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "पुनि अपुने पति कौ दिखरावै ॥",
      "sourceLineId": "117276",
      "sourceShabadId": "10732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਾਜੀ ਮੁਫਤੀ ਸਕਲ ਨਿਹਾਰੈ ॥",
      "transliteration": "kaajee mufatee sakal nihaarai ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਜ਼ੀ ਅਤੇ ਮੁਫ਼ਤੀ ਸਭ ਵੇਖਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "काजी मुफती सकल निहारै ॥",
      "sourceLineId": "117277",
      "sourceShabadId": "10732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੋ ਤਸਕਰ ਤਿਹ ਰਾਹ ਪਧਾਰੈ ॥੪॥",
      "transliteration": "so tasakar teh raeh padhaarai ||4||",
      "translation": "‘I will show the place to the Quazi, the justice and his writers.",
      "punjabiViakhya": "ਕਿ ਚੋਰ (ਸੰਨ੍ਰਹ ਲਾ ਕੇ) ਉਸ ਰਸਤੇ ਭਜ ਗਿਆ ਹੈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "सो तसकर तिह राह पधारै ॥४॥",
      "sourceLineId": "117278",
      "sourceShabadId": "10732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "117279",
      "sourceShabadId": "10733",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਧਨ ਤਸਕਰ ਕੌ ਅਮਿਤ ਦੇ ਘਰ ਤੇ ਦਯੋ ਪਠਾਇ ॥",
      "transliteration": "dhan tasakar kau amit dhe ghar te dhayo paThai ||",
      "translation": "‘I will handover to you, the thief, all the wealth and make you to run away.",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਚੋਰ ਨੂੰ ਬਹੁਤ ਧਨ ਦੇ ਕੇ ਘਰੋਂ ਭਜਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "धन तसकर कौ अमित दे घर ते दयो पठाइ ॥",
      "sourceLineId": "117280",
      "sourceShabadId": "10733",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕੋਟਵਾਰ ਕੋ ਖਬਰਿ ਕਰਿ ਹੌ ਮਿਲਿਹੌ ਤੁਹਿ ਆਇ ॥੫॥",
      "transliteration": "koTavaar ko khabar kar hau milihau tuh aai ||5||",
      "translation": "‘I will go to the city chief of police and after informing him I will come back and meet you.’(5)",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ ਕਿ) ਕੋਤਵਾਲ ਨੂੰ ਖ਼ਬਰ ਕਰ ਕੇ ਮੈਂ ਵੀ ਤੈਨੂੰ ਆ ਮਿਲਾਗੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "कोटवार को खबरि करि हौ मिलिहौ तुहि आइ ॥५॥",
      "sourceLineId": "117281",
      "sourceShabadId": "10733",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "117282",
      "sourceShabadId": "10734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਮਿਤ ਦਰਬੁ ਦੈ ਚੋਰ ਨਿਕਾਰਿਯੋ ॥",
      "transliteration": "amit dharab dhai chor nikaariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਬਹੁਤ ਧਨ ਦੇ ਕੇ ਚੋਰ ਨੂੰ ਭਜਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "अमित दरबु दै चोर निकारियो ॥",
      "sourceLineId": "117283",
      "sourceShabadId": "10734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦੈ ਸਾਧਹਿ ਇਹ ਭਾਤਿ ਪੁਕਾਰਿਯੋ ॥",
      "transliteration": "dhai saadheh ieh bhaat pukaariyo ||",
      "translation": "She broke in the house, gave the thief a lot of money and, then, raised the alarm.",
      "punjabiViakhya": "ਅਤੇ ਸੰਨ੍ਰਹ ਲਾ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਰੌਲਾ ਪਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "दै साधहि इह भाति पुकारियो ॥",
      "sourceLineId": "117284",
      "sourceShabadId": "10734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪਤਿਹਿ ਜਗਾਇ ਕਹਿਯੋ ਧਨ ਹਰਿਯੋ ॥",
      "transliteration": "pateh jagai kahiyo dhan hariyo ||",
      "translation": "She woke her husband and shouted, ‘Our wealth has been robbed.",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਪਤੀ ਨੂੰ ਜਗਾ ਕੇ ਕਿਹਾ ਕਿ ਧਨ ਲੁਟਿਆ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "पतिहि जगाइ कहियो धन हरियो ॥",
      "sourceLineId": "117285",
      "sourceShabadId": "10734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਹ ਦੇਸੇਸ ਨ੍ਯਾਇ ਨਹਿ ਕਰਿਯੋ ॥੬॥",
      "transliteration": "eeh dheses nayai neh kariyo ||6||",
      "translation": "The Ruler of the country has done injustice (for not providing security).’(6)",
      "punjabiViakhya": "ਇਸ ਦੇਸ ਦੇ ਸੁਆਮੀ ਨੇ ਨਿਆਂ ਨਹੀਂ ਕੀਤਾ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "इह देसेस न्याइ नहि करियो ॥६॥",
      "sourceLineId": "117286",
      "sourceShabadId": "10734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤ੍ਰਿਯੋ ਬਾਚ ॥",
      "transliteration": "tirayo baach ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "तृयो बाच ॥",
      "sourceLineId": "117287",
      "sourceShabadId": "10735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕੋਟਵਾਰ ਪੈ ਜਾਇ ਪੁਕਾਰਿਯੋ ॥",
      "transliteration": "koTavaar pai jai pukaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਕੋਤਵਾਲ ਪਾਸ ਜਾ ਕੇ ਪੁਕਾਰ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "कोटवार पै जाइ पुकारियो ॥",
      "sourceLineId": "117288",
      "sourceShabadId": "10735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਿਨੀ ਚੋਰ ਧਨ ਹਰਿਯੋ ਹਮਾਰਿਯੋ ॥",
      "transliteration": "kinee chor dhan hariyo hamaariyo ||",
      "translation": "She raised hue and cry in the police station, ‘A thief had robbed all our wealth.",
      "punjabiViakhya": "ਕਿ ਕਿਸੇ ਚੋਰ ਨੇ ਸਾਡਾ ਧਨ ਲੁਟ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "किनी चोर धन हरियो हमारियो ॥",
      "sourceLineId": "117289",
      "sourceShabadId": "10735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਕਲ ਲੋਕ ਤਿਹ ਠਾ ਪਗ ਧਰਿਯੈ ॥",
      "transliteration": "sakal lok teh Thaa pag dhariyai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਲੋਕ ਉਥੇ ਪਹੁੰਚਣ",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "सकल लोक तिह ठा पग धरियै ॥",
      "sourceLineId": "117290",
      "sourceShabadId": "10735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਮਰੋ ਕਛੁਕ ਨ੍ਯਾਇ ਬਿਚਰਿਯੈ ॥੭॥",
      "transliteration": "hamaro kachhuk nayai bichariyai ||7||",
      "translation": "‘You all people come with me and do justice to us.’(7)",
      "punjabiViakhya": "ਅਤੇ ਸਾਡਾ ਕੁਝ ਨਿਆਂ ਵਿਚਾਰਨ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "हमरो कछुक न्याइ बिचरियै ॥७॥",
      "sourceLineId": "117291",
      "sourceShabadId": "10735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਾਜੀ ਕੋਟਵਾਰ ਕੌ ਲ੍ਯਾਈ ॥",
      "transliteration": "kaajee koTavaar kau layaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਇਸਤਰੀ) ਕਾਜ਼ੀ ਅਤੇ ਕੋਤਵਾਲ ਨੂੰ ਲੈ ਆਈ",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "काजी कोटवार कौ ल्याई ॥",
      "sourceLineId": "117292",
      "sourceShabadId": "10735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਭ ਲੋਗਨ ਕੋ ਸਾਧਿ ਦਿਖਾਈ ॥",
      "transliteration": "sabh logan ko saadh dhikhaiee ||",
      "translation": "She brough t the Quazi and the chief of the police and showed the place of break-in.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਲੋਕਾ ਨੂੰ ਸੰਨ੍ਰਹ ਵਿਖਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "सभ लोगन को साधि दिखाई ॥",
      "sourceLineId": "117293",
      "sourceShabadId": "10735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਾ ਕੌ ਹੇਰਿ ਅਧਿਕ ਪਤਿ ਰੋਯੋ ॥",
      "transliteration": "taa kau her adhik pat royo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਸੰਨ੍ਰਹ) ਨੂੰ ਵੇਖ ਕੇ ਪਤੀ ਵੀ ਬਹੁਤ ਰੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "ता कौ हेरि अधिक पति रोयो ॥",
      "sourceLineId": "117294",
      "sourceShabadId": "10735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੋਰਨ ਮੋਰ ਸਕਲ ਧਨੁ ਖੋਯੋ ॥੮॥",
      "transliteration": "choran mor sakal dhan khoyo ||8||",
      "translation": "Her husband cried abundantly, ‘The thief has taken our everything.’(8)",
      "punjabiViakhya": "ਕਿ ਚੋਰਾ ਨੇ ਮੇਰਾ ਸਾਰਾ ਧਨ ਲੁਟ ਲਿਆ ਹੈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "चोरन मोर सकल धनु खोयो ॥८॥",
      "sourceLineId": "117295",
      "sourceShabadId": "10735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੇਖਤ ਤਿਨੈ ਮੂੰਦ ਵਹ ਲਈ ॥",
      "transliteration": "dhekhat tinai moo(n)dh veh liee ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਵੇਖਦਿਆਂ (ਉਸ ਨੇ) ਉਹ (ਸੰਨ੍ਰਹ) ਬੰਦ ਕਰ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "देखत तिनै मूँद वह लई ॥",
      "sourceLineId": "117296",
      "sourceShabadId": "10735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰਹਨ ਤੈਸਿਯੈ ਅੰਤਰ ਦਈ ॥",
      "transliteration": "rahan taisiyai a(n)tar dhiee ||",
      "translation": "After displaying the place, she got the wall repaired spuriously.",
      "punjabiViakhya": "ਪਰ ਅੰਦਰੋਂ ਉਸੇ ਤਰ੍ਰਹਾ ਰਹਿਣ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "रहन तैसियै अंतर दई ॥",
      "sourceLineId": "117297",
      "sourceShabadId": "10735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0947_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦਿਨ ਬੀਤਯੋ ਰਜਨੀ ਹ੍ਵੈ ਆਈ ॥",
      "transliteration": "dhin beetayo rajanee havai aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਦਿਨ ਬੀਤ ਗਿਆ ਅਤੇ ਰਾਤ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 947,
      "hindi": "",
      "hindiTransliteration": "दिन बीतयो रजनी ह्वै आई ॥",
      "sourceLineId": "117298",
      "sourceShabadId": "10735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
