{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 948,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0948_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਿਸੀ ਪੈਂਡ ਹ੍ਵੈ ਆਪੁ ਸਿਧਾਈ ॥੯॥",
      "transliteration": "tisee pai(n)dd havai aap sidhaiee ||9||",
      "translation": "When the day had gone by, the lady left the place through the same way.(9)",
      "punjabiViakhya": "ਉਸੇ (ਸੰਨ੍ਰਹ ਦੇ) ਰਸਤੇ ਆਪ ਵੀ ਭਜ ਗਈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "तिसी पैंड ह्वै आपु सिधाई ॥९॥",
      "sourceLineId": "117299",
      "sourceShabadId": "10735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "117300",
      "sourceShabadId": "10736",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਾਜੀ ਔ ਕੁਟਵਾਰ ਪੈ ਨਿਜੁ ਪਤਿ ਸਾਧਿ ਦਿਖਾਇ ॥",
      "transliteration": "kaajee aau kuTavaar pai nij pat saadh dhikhai ||",
      "translation": "She had convinced the Quazi, the police-chief and her husband and,",
      "punjabiViakhya": "ਕਾਜ਼ੀ, ਕੋਤਵਾਲ ਅਤੇ ਆਪਣੇ ਪਤੀ ਨੂੰ ਸੰਨ੍ਰਹ ਵਿਖਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "काजी औ कुटवार पै निजु पति साधि दिखाइ ॥",
      "sourceLineId": "117301",
      "sourceShabadId": "10736",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪ੍ਰਥਮੈ ਧਨੁ ਪਹੁਚਾਇ ਕੈ ਬਹੁਰਿ ਮਿਲੀ ਤਿਹ ਜਾਇ ॥੧੦॥",
      "transliteration": "prathamai dhan pahuchai kai bahur milee teh jai ||10||",
      "translation": "Then, she left for (the thief) with whom she had entrusted all the fortune.(10)",
      "punjabiViakhya": "ਅਤੇ ਪਹਿਲਾ ਧਨ ਪਹੁੰਚਾ ਕੇ ਫਿਰ ਆਪ ਵੀ ਉਸ (ਪ੍ਰੇਮੀ) ਨੂੰ ਜਾ ਮਿਲੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "प्रथमै धनु पहुचाइ कै बहुरि मिली तिह जाइ ॥१०॥",
      "sourceLineId": "117302",
      "sourceShabadId": "10736",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "117303",
      "sourceShabadId": "10737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਭ ਕੋਊ ਐਸੀ ਭਾਤਿ ਬਖਾਨੈ ॥",
      "transliteration": "sabh kouoo aaisee bhaat bakhaanai ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਕੋਈ ਇਹੀ ਕਹਿੰਦੇ ਸਨ ਅਤੇ ਮੰਨਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "सभ कोऊ ऐसी भाति बखानै ॥",
      "sourceLineId": "117304",
      "sourceShabadId": "10737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨ੍ਯਾਇ ਨ ਭਯੋ ਤਾਹਿ ਕਰ ਮਾਨੈ ॥",
      "transliteration": "nayai na bhayo taeh kar maanai ||",
      "translation": "All the people understood that, for not getting the justice and losing",
      "punjabiViakhya": "ਕਿ ਉਸ ਨੂੰ ਇਨਸਾਫ਼ ਨਹੀਂ ਮਿਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "न्याइ न भयो ताहि कर मानै ॥",
      "sourceLineId": "117305",
      "sourceShabadId": "10737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਧਨੁ ਬਿਨੁ ਨਾਰਿ ਝਖਤ ਅਤਿ ਭਈ ॥",
      "transliteration": "dhan bin naar jhakhat at bhiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਸਤਰੀ ਧਨ ਤੋਂ ਬਿਨਾ ਬਹੁਤ ਝਖਦੀ ਰਹੀ",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "धनु बिनु नारि झखत अति भई ॥",
      "sourceLineId": "117306",
      "sourceShabadId": "10737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹ੍ਵੈ ਜੋਗਨ ਬਨ ਮਾਝ ਸਿਧਈ ॥੧੧॥",
      "transliteration": "havai jogan ban maajh sidhiee ||11||",
      "translation": "all the wealth, she had gone to the jungle and become an ascetic.(11)",
      "punjabiViakhya": "ਅਤੇ ਜੋਗਣ ਬਣ ਕੇ ਬਨ ਨੂੰ ਚਲੀ ਗਈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "ह्वै जोगन बन माझ सिधई ॥११॥",
      "sourceLineId": "117307",
      "sourceShabadId": "10737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਚਾਰ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੦੪॥੧੯੪੬॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau chaar charitr samaapatam sat subham sat ||104||1946||afajoo(n)||",
      "translation": "104th Parable of Auspicious Chritars Conversation of the Raja and the Minister, Completed With Benediction. (104)(1944)",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਯਾ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ਇਕ ਸੌ ਚਾਰ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੦੪॥੧੯੪੬॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ चार चरित्र समापतम सतु सुभम सतु ॥१०४॥१९४६॥अफजूँ॥",
      "sourceLineId": "117308",
      "sourceShabadId": "10737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "117309",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਲਿਮਰਦਾ ਕੌ ਸੁਤ ਇਕ ਰਹੈ ॥",
      "transliteration": "alimaradhaa kau sut ik rahai ||",
      "translation": "",
      "punjabiViakhya": "ਅਲਿਮਰਦਾ ਦਾ ਇਕ ਪੁੱਤਰ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "अलिमरदा कौ सुत इक रहै ॥",
      "sourceLineId": "117310",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਾਸ ਬੇਗ ਨਾਮਾ ਜਗ ਕਹੈ ॥",
      "transliteration": "taas beg naamaa jag kahai ||",
      "translation": "Alimardan (a king) had a son whom the world knew as Taas Beg.",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਲੋਕ ਤਾਸ ਬੇਗ ਕਰ ਕੇ ਜਾਣਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "तास बेग नामा जग कहै ॥",
      "sourceLineId": "117311",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਚਾ ਜੌਹਰੀ ਕੋ ਤਿਨ ਹੇਰਿਯੋ ॥",
      "transliteration": "bachaa jauaharee ko tin heriyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਇਕ ਵਾਰ) ਇਕ ਜੌਹਰੀ ਦਾ ਬੱਚਾ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "बचा जौहरी को तिन हेरियो ॥",
      "sourceLineId": "117312",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਹਾ ਰੁਦ੍ਰ ਰਿਪੁ ਤਾ ਕੌ ਘੇਰਿਯੋ ॥੧॥",
      "transliteration": "mahaa rudhr rip taa kau gheriyo ||1||",
      "translation": "He (Beg) came across the son of a jeweller and he was overpowered by the god of love.(1)",
      "punjabiViakhya": "ਤਾ ਮਹਾ ਰੁਦ੍ਰ ਦੇ ਵੈਰੀ (ਕਾਮ ਦੇਵ) ਨੇ ਉਸ ਨੂੰ ਘੇਰ ਲਿਆ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "महा रुद्र रिपु ता कौ घेरियो ॥१॥",
      "sourceLineId": "117313",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਾ ਕੇ ਦ੍ਵਾਰੇ ਦੇਖਨ ਜਾਵੈ ॥",
      "transliteration": "taa ke dhavaiaare dhekhan jaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਉਸ ਦੇ ਘਰ (ਉਸ ਨੂੰ) ਵੇਖਣ ਜਾਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "ता के द्वारे देखन जावै ॥",
      "sourceLineId": "117314",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰੂਪ ਨਿਹਾਰਿ ਹ੍ਰਿਦੈ ਸੁਖੁ ਪਾਵੈ ॥",
      "transliteration": "roop nihaar hiradhai sukh paavai ||",
      "translation": "He would everyday go to his house and find solace by seeing him.",
      "punjabiViakhya": "(ਅਤੇ ਉਸ ਦਾ) ਰੂਪ ਵੇਖ ਕੇ ਮਨ ਵਿਚ ਪ੍ਰਸੰਨ ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "रूप निहारि हृदै सुखु पावै ॥",
      "sourceLineId": "117315",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕੇਲ ਕਰੋ ਯਾ ਸੋ ਚਿਤ ਭਾਯੋ ॥",
      "transliteration": "kel karo yaa so chit bhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ 'ਕੇਲ' (ਕਾਮ-ਕ੍ਰੀੜਾ) ਕਰਨ ਲਈ (ਉਸ ਦਾ) ਚਿਤ ਕਰਨ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "केल करो या सो चित भायो ॥",
      "sourceLineId": "117316",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤੁਰਤੁ ਦੂਤ ਗ੍ਰਿਹ ਤਾਹਿ ਪਠਾਯੋ ॥੨॥",
      "transliteration": "turat dhoot gireh taeh paThaayo ||2||",
      "translation": "As he felt to make love with him to seek comfort, he immediately sent him his emissary.(2)",
      "punjabiViakhya": "ਤੁਰਤ ਉਸ ਨੇ ਦੂਤ ਨੂੰ ਉਸ ਦੇ ਘਰ ਭੇਜਿਆ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "तुरतु दूत गृह ताहि पठायो ॥२॥",
      "sourceLineId": "117317",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦੂਤ ਅਨੇਕ ਉਪਚਾਰ ਬਨਾਵੈ ॥",
      "transliteration": "dhoot anek upachaar banaavai ||",
      "translation": "",
      "punjabiViakhya": "ਦੂਤ ਬਹੁਤ ਤਰ੍ਰਹਾ ਦੇ ਉਪਾ ਕਰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "दूत अनेक उपचार बनावै ॥",
      "sourceLineId": "117318",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮੋਹਨ ਰਾਇ ਹਾਥ ਨਹਿ ਆਵੈ ॥",
      "transliteration": "mohan rai haath neh aavai ||",
      "translation": "The emissary tried hard but Mohan Raae (the boy) would not consent.",
      "punjabiViakhya": "ਪਰ ਮੋਹਨ ਰਾਇ ਹੱਥ ਵਿਚ ਨਹੀਂ ਆਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "मोहन राइ हाथ नहि आवै ॥",
      "sourceLineId": "117319",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਿਹ ਤਾ ਸੋ ਇਹ ਭਾਤਿ ਉਚਾਰਿਯੋ ॥",
      "transliteration": "teh taa so ieh bhaat uchaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਤਾਸ ਬੇਗ ਨੂੰ ਜਾ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "तिह ता सो इह भाति उचारियो ॥",
      "sourceLineId": "117320",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਾਸ ਬੇਗ ਤਾ ਸੌ ਖਿਝਿ ਮਾਰਿਯੋ ॥੩॥",
      "transliteration": "taas beg taa sau khijh maariyo ||3||",
      "translation": "When he conveyed the decision to him (Beg), he was perturbed and beat him up.(3)",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੇ ਖਿਝ ਕੇ ਉਸ ਨੂੰ ਮਾਰਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "तास बेग ता सौ खिझि मारियो ॥३॥",
      "sourceLineId": "117321",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚੋਟਨ ਲਗੇ ਦੂਤ ਰਿਸਿ ਭਰਿਯੋ ॥",
      "transliteration": "choTan lage dhoot ris bhariyo ||",
      "translation": "",
      "punjabiViakhya": "ਸੱਟਾ ਖਾ ਕੇ ਦੂਤ ਕ੍ਰੋਧ ਨਾਲ ਭਰ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "चोटन लगे दूत रिसि भरियो ॥",
      "sourceLineId": "117322",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮੂਰਖ ਜਾਨਿ ਜਤਨ ਤਿਹ ਕਰਿਯੋ ॥",
      "transliteration": "moorakh jaan jatan teh kariyo ||",
      "translation": "The emissary became furious on receiving the retribution and,",
      "punjabiViakhya": "ਅਤੇ ਉਸ (ਤਾਸ ਬੇਗ) ਨੂੰ ਮੂਰਖ ਜਾਣ ਕੇ ਇਹ ਯਤਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "मूरख जानि जतन तिह करियो ॥",
      "sourceLineId": "117323",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੋਹਨ ਆਜੁ ਕਹਿਯੋ ਮੈ ਐਹੋ ॥",
      "transliteration": "mohan aaj kahiyo mai aaiho ||",
      "translation": "considering him to be an idiotic, decided to do something.",
      "punjabiViakhya": "(ਅਤੇ ਦਸਿਆ) ਮੋਹਨ ਨੇ ਕਿਹਾ ਹੈ ਕਿ ਅਜ ਮੈਂ ਆਵਾਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "मोहन आजु कहियो मै ऐहो ॥",
      "sourceLineId": "117324",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਾ ਕੌ ਤਾਸ ਬੇਗ ਤੂ ਪੈਹੋ ॥੪॥",
      "transliteration": "taa kau taas beg too paiho ||4||",
      "translation": "He told Taas Beg, ‘Mohan has consented to come today.’(4)",
      "punjabiViakhya": "ਹੇ ਤਾਸ ਬੇਗ! ਤੂੰ ਅਜ ਉਸ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰੇਾਂਗਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "ता कौ तास बेग तू पैहो ॥४॥",
      "sourceLineId": "117325",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਯਹ ਸੁਨਿ ਬੈਨ ਫੂਲਿ ਜੜ ਗਯੋ ॥",
      "transliteration": "yeh sun bain fool jaR gayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਗੱਲ ਸੁਣ ਕੇ ਮੂਰਖ ਫੁਲ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "यह सुनि बैन फूलि जड़ गयो ॥",
      "sourceLineId": "117326",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਾਚ ਬਾਤ ਚੀਨਤ ਚਿਤ ਭਯੋ ॥",
      "transliteration": "saach baat cheenat chit bhayo ||",
      "translation": "Hearing this, his joy knew no bounds, as he took it to be true.",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਗੱਲ ਨੂੰ ਮਨ ਵਿਚ ਸੱਚਾ ਸਮਝ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "साच बात चीनत चित भयो ॥",
      "sourceLineId": "117327",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਲੋਗ ਉਠਾਇ ਪਾਨ ਮਦ ਕਰਿਯੋ ॥",
      "transliteration": "log uThai paan madh kariyo ||",
      "translation": "He sent away the people and started to drink wine.",
      "punjabiViakhya": "ਲੋਕਾ ਨੂੰ ਉਠਾ ਕੇ (ਭਾਵ ਭੇਜ ਕੇ) ਸ਼ਰਾਬ ਪੀ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "लोग उठाइ पान मद करियो ॥",
      "sourceLineId": "117328",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮਾਨੁਖ ਹੁਤੋ ਜੋਨਿ ਪਸੁ ਪਰਿਯੋ ॥੫॥",
      "transliteration": "maanukh huto jon pas pariyo ||5||",
      "translation": "Although human being, he had embraced the life of an animal.(5)",
      "punjabiViakhya": "ਮਨੁੱਖ ਹੁੰਦੇ ਹੋਇਆ ਪਸ਼ੂ ਜੂਨ ਪ੍ਰਾਪਤ ਕਰ ਲਈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "मानुख हुतो जोनि पसु परियो ॥५॥",
      "sourceLineId": "117329",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮੋ ਮਨ ਮੋਲ ਮੋਹਨਹਿ ਲਯੋ ॥",
      "transliteration": "mo man mol mohaneh layo ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ ਦਾ) ਮੇਰਾ ਮਨ ਮੋਹਨ ਨੇ ਖ਼ਰੀਦ ਲਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "मो मन मोल मोहनहि लयो ॥",
      "sourceLineId": "117330",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਬ ਤੇ ਮੈ ਚੇਰੋ ਹ੍ਵੈ ਗਯੋ ॥",
      "transliteration": "tab te mai chero havai gayo ||",
      "translation": "(He thought,) ‘My heart is already in the hands of Mohan and I have become his slave since (I saw him).",
      "punjabiViakhya": "ਤਦ ਦਾ ਮੈਂ ਉਸ ਦਾ ਦਾਸ ਹੋ ਗਿਆ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "तब ते मै चेरो ह्वै गयो ॥",
      "sourceLineId": "117331",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਏਕ ਬਾਰ ਜੌ ਤਾਹਿ ਨਿਹਾਰੋ ॥",
      "transliteration": "ek baar jau taeh nihaaro ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਵਾਰ ਜੇ ਉਸ ਨੂੰ (ਮੈਂ) ਵੇਖ ਲਵਾ",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "एक बार जौ ताहि निहारो ॥",
      "sourceLineId": "117332",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਨੁ ਮਨੁ ਧਨ ਤਾ ਪੈ ਸਭ ਵਾਰੋ ॥੬॥",
      "transliteration": "tan man dhan taa pai sabh vaaro ||6||",
      "translation": "‘Who-so-ever has a glimpse of him, sacrifices his own life over him.’(6)",
      "punjabiViakhya": "ਤਾ ਤਨ, ਮਨ ਅਤੇ ਧਨ ਉਸ ਉਤੋਂ ਵਾਰ ਦਿਆਂ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "तनु मनु धन ता पै सभ वारो ॥६॥",
      "sourceLineId": "117333",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਿਨੁ ਸੁਧਿ ਭਏ ਦੂਤ ਤਿਹ ਚੀਨੋ ॥",
      "transliteration": "bin sudh bhe dhoot teh cheeno ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਦੂਤ ਨੇ (ਸ਼ਰਾਬ ਦੇ ਨਸ਼ੇ ਕਾਰਨ ਉਸ ਨੂੰ) ਬੇਸੁਧ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "बिनु सुधि भए दूत तिह चीनो ॥",
      "sourceLineId": "117334",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅੰਡ ਫੋਰਿ ਆਸਨ ਪਰ ਦੀਨੋ ॥",
      "transliteration": "a(n)dd for aasan par dheeno ||",
      "translation": "When the emissary judged he was totally intoxicated with wine, he broke an egg and spread it on his bed.",
      "punjabiViakhya": "ਤਾ ਉਸ ਦੇ ਗੁਪਤ ਖੇਤਰ ਉਤੇ (ਇਕ) ਅੰਡਾ ਭੰਨ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "अंड फोरि आसन पर दीनो ॥",
      "sourceLineId": "117335",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭੂਖਨ ਬਸਤ੍ਰ ਪਾਗ ਤਿਹ ਹਰੀ ॥",
      "transliteration": "bhookhan basatr paag teh haree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪਗੜੀ, ਬਸਤ੍ਰ ਅਤੇ ਜ਼ੇਵਰ ਚੁਰਾ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "भूखन बसत्र पाग तिह हरी ॥",
      "sourceLineId": "117336",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮੂਰਖ ਕੌ ਸੁਧਿ ਕਛੂ ਨ ਪਰੀ ॥੭॥",
      "transliteration": "moorakh kau sudh kachhoo na paree ||7||",
      "translation": "He took away his ornaments, the clothes and the turban, and the fool remained unaware.(7)",
      "punjabiViakhya": "ਉਸ ਮੂਰਖ ਨੂੰ ਕੁਝ ਵੀ ਪਤਾ ਨਾ ਲਗਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "मूरख कौ सुधि कछू न परी ॥७॥",
      "sourceLineId": "117337",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਦਰਾ ਕੀ ਅਤਿ ਭਈ ਖੁਮਾਰੀ ॥",
      "transliteration": "madharaa kee at bhiee khumaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮੂਰਖ ਨੂੰ ਸ਼ਰਾਬ ਦੀ ਬਹੁਤ ਖ਼ੁਮਾਰੀ ਚੜ੍ਰਹ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "मदरा की अति भई खुमारी ॥",
      "sourceLineId": "117338",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪ੍ਰਾਤ ਲਗੇ ਜੜ ਬੁਧਿ ਨ ਸੰਭਾਰੀ ॥",
      "transliteration": "praat lage jaR budh na sa(n)bhaaree ||",
      "translation": "The intoxication through wine was so intense that, till morning, he did not regain consciousness.",
      "punjabiViakhya": "ਅਤੇ ਸਵੇਰ ਤਕ ਹੋਸ਼ ਨਾ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "प्रात लगे जड़ बुधि न संभारी ॥",
      "sourceLineId": "117339",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬੀਤੀ ਰੈਨਿ ਭਯੋ ਉਜਿਯਾਰੋ ॥",
      "transliteration": "beetee rain bhayo ujiyaaro ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਬੀਤ ਗਈ ਅਤੇ ਸਵੇਰ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "बीती रैनि भयो उजियारो ॥",
      "sourceLineId": "117340",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਨ ਮਨ ਅਪਨੇ ਆਪ ਸੰਭਾਰੋ ॥੮॥",
      "transliteration": "tan man apane aap sa(n)bhaaro ||8||",
      "translation": "When the night had lapsed and the day broke, he managed to control his mind and body.(8)",
      "punjabiViakhya": "(ਤਦ ਉਸ ਨੇ) ਆਪਣਾ ਤਨ ਮਨ ਅਤੇ ਆਪਣਾ ਆਪ ਸੰਭਾਲਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "तन मन अपने आप संभारो ॥८॥",
      "sourceLineId": "117341",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਾਥ ਜਾਇ ਆਸਨ ਪਰ ਪਰਿਯੋ ॥",
      "transliteration": "haath jai aasan par pariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਉਸ ਦਾ ਹੱਥ ਆਸਨ (ਗੁਪਤ ਖੇਤਰ) ਉਤੇ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "हाथ जाइ आसन पर परियो ॥",
      "sourceLineId": "117342",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੌਕਿ ਬਚਨ ਤਬ ਮੂੜ ਉਚਰਿਯੋ ॥",
      "transliteration": "chauak bachan tab mooR uchariyo ||",
      "translation": "When his hand fell over his bed, the idiot thought over,",
      "punjabiViakhya": "ਤਾ ਚੌਂਕ ਕੇ ਮੂਰਖ ਬੋਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "चौकि बचन तब मूड़ उचरियो ॥",
      "sourceLineId": "117343",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਿਕਟ ਆਪਨੋ ਦੂਤ ਬੁਲਾਯੋ ॥",
      "transliteration": "nikaT aapano dhoot bulaayo ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਕੋਲ ਦੂਤ (ਨੌਕਰ) ਨੂੰ ਬੁਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "निकट आपनो दूत बुलायो ॥",
      "sourceLineId": "117344",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਿਨ ਕਹਿ ਭੇਦ ਸਕਲ ਸਮੁਝਾਯੋ ॥੯॥",
      "transliteration": "tin keh bhedh sakal samujhaayo ||9||",
      "translation": "And called over his emissary, who on query made him to understand thus,(9)",
      "punjabiViakhya": "ਉਸ ਨੇ (ਉਸ ਨੂੰ) ਸਾਰਾ ਭੇਦ ਕਹਿ ਕੇ ਸਮਝਾ ਦਿੱਤਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
      "hindiTransliteration": "तिन कहि भेद सकल समुझायो ॥९॥",
      "sourceLineId": "117345",
      "sourceShabadId": "10738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0948_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 948,
      "hindi": "",
