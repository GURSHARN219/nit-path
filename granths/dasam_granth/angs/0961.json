{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 961,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0961_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "117971",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਬ ਵਹੁ ਨ੍ਰਿਪਤਿ ਅਖੇਟਕ ਆਵੈ ॥",
      "transliteration": "jab vahu nirapat akheTak aavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਰਾਜਾ ਸ਼ਿਕਾਰ ਚੜ੍ਰਹਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "जब वहु नृपति अखेटक आवै ॥",
      "sourceLineId": "117972",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸ੍ਵਾਨਨ ਤੇ ਬਹੁਤ ਮ੍ਰਿਗਨ ਗਹਾਵੈ ॥",
      "transliteration": "savaiaanan te bahut miragan gahaavai ||",
      "translation": "When the Raja would go for hunting, he would get many deer killed through his dogs.",
      "punjabiViakhya": "ਤਾ ਕੁਤਿਆਂ ਤੋਂ ਬਹੁਤ ਹਿਰਨ ਪਕੜਵਾਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "स्वानन ते बहुत मृगन गहावै ॥",
      "sourceLineId": "117973",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਾਜਨ ਸਾਥ ਆਬਿਯਨ ਲੇਹੀ ॥",
      "transliteration": "baajan saath aabiyan lehee ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਜ਼ਾ ਤੋਂ ਮੁਰਗ਼ਾਬੀਆਂ ਫੜਵਾਉਾਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "बाजन साथ आबियन लेही ॥",
      "sourceLineId": "117974",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਮਿਤ ਦਰਬੁ ਹੁਸਨਾਕਨ ਦੇਹੀ ॥੩॥",
      "transliteration": "amit dharab husanaakan dhehee ||3||",
      "translation": "He would use his hawks to prey on water-fouls and distribute lot of wealth among the pretty people.(3)",
      "punjabiViakhya": "ਅਤੇ ਹੁਸੀਨਾ ਨੂੰ ਬਹੁਤ ਧਨ ਦਿੰਦਾ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "अमित दरबु हुसनाकन देही ॥३॥",
      "sourceLineId": "117975",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਿਤਿਪ੍ਰਤਿ ਅਧਿਕ ਮ੍ਰਿਗਨ ਕੌ ਮਾਰੈ ॥",
      "transliteration": "nitiprat adhik miragan kau maarai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਹਰ ਰੋਜ਼ ਬਹੁਤ ਹਿਰਨਾ ਨੂੰ ਮਾਰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "नितिप्रति अधिक मृगन कौ मारै ॥",
      "sourceLineId": "117976",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਦਾ ਸੁ ਬਨ ਕੇ ਬੀਚ ਬਿਹਾਰੈ ॥",
      "transliteration": "sadhaa su ban ke beech bihaarai ||",
      "translation": "Remaining always in the jungle, he used to kill many deer.",
      "punjabiViakhya": "ਅਤੇ ਸਦਾ ਬਨ ਵਿਚ ਹੀ ਘੁੰਮਦਾ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "सदा सु बन के बीच बिहारै ॥",
      "sourceLineId": "117977",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੁਹੂ ਹਾਥ ਸੌ ਤੀਰ ਚਲਾਵੈ ॥",
      "transliteration": "dhuhoo haath sau teer chalaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦੋਹਾ ਹੱਥਾ ਨਾਲ ਤੀਰ ਚਲਾਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "दुहू हाथ सौ तीर चलावै ॥",
      "sourceLineId": "117978",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਾ ਤੇ ਕਹਾ ਜਾਨ ਪਸੁ ਪਾਵੈ ॥੪॥",
      "transliteration": "taa te kahaa jaan pas paavai ||4||",
      "translation": "Throwing arrows with both the hands, he would not let any animal escape.(4)",
      "punjabiViakhya": "ਉਸ ਤੋਂ (ਭਲਾ) ਕਿਹੜਾ ਪਸ਼ੂ ਬਚ ਸਕਦਾ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "ता ते कहा जान पसु पावै ॥४॥",
      "sourceLineId": "117979",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਨ੍ਰਿਪ ਅਖਿਟ ਸਿਧਾਯੋ ॥",
      "transliteration": "ek dhivas nirap akhiT sidhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਰਾਜਾ ਸ਼ਿਕਾਰ ਖੇਡਣ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "एक दिवस नृप अखिट सिधायो ॥",
      "sourceLineId": "117980",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਾਰੋ ਹਰਿਨ ਹੇਰਿ ਲਲਚਾਯੋ ॥",
      "transliteration": "kaaro harin her lalachaayo ||",
      "translation": "One day when he was on hunting spree, he became rapacious finding a black deer.",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਕਾਲਾ ਹਿਰਨ ਵੇਖ ਕੇ ਲਲਚਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "कारो हरिन हेरि ललचायो ॥",
      "sourceLineId": "117981",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੀਂਗਨ ਤੇ ਜੀਯਤ ਗਹਿ ਲੈਹੌ ॥",
      "transliteration": "see(n)gan te jeeyat geh laihau ||",
      "translation": "",
      "punjabiViakhya": "(ਚਾਹੁੰਦਾ ਸੀ ਕਿ ਉਸ ਨੂੰ) ਸਿੰਗਾ ਤੋਂ ਜੀਉਾਂਦਾ ਫੜ ਲਵਾ",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "सींगन ते जीयत गहि लैहौ ॥",
      "sourceLineId": "117982",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਯਾ ਕੌ ਘਾਇ ਨ ਲਾਗਨ ਦੈਹੌ ॥੫॥",
      "transliteration": "yaa kau ghai na laagan dhaihau ||5||",
      "translation": "He thought, he would catch him alive and inflict no injury on his body.(5)",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਜ਼ਖ਼ਮੀ ਨਾ ਹੋਣ ਦਿਆਂ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "या कौ घाइ न लागन दैहौ ॥५॥",
      "sourceLineId": "117983",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹੇਰਿ ਹਰਿਨ ਕਹ ਤੁਰੈ ਧਵਾਯੋ ॥",
      "transliteration": "her harin keh turai dhavaayo ||",
      "translation": "",
      "punjabiViakhya": "ਹਿਰਨ ਨੂੰ ਵੇਖ ਕੇ (ਉਸ ਨੇ) ਘੋੜੇ ਨੂੰ ਭਜਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "हेरि हरिन कह तुरै धवायो ॥",
      "sourceLineId": "117984",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪਾਛੋ ਚਲਿਯੋ ਤਵਨ ਕੋ ਆਯੋ ॥",
      "transliteration": "paachho chaliyo tavan ko aayo ||",
      "translation": "On seeing him he sprinted his horse and chased him.",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੇ ਪਿਛੇ ਚਲਦਾ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "पाछो चलियो तवन को आयो ॥",
      "sourceLineId": "117985",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਬ ਪਰਦੇਸ ਗਯੋ ਚਲਿ ਸੋਈ ॥",
      "transliteration": "jab paradhes gayo chal soiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ (ਹਿਰਨ) ਪਰਦੇਸ (ਗ਼ੈਰ ਇਲਾਕੇ) ਵਿਚ ਪਹੁੰਚ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "जब परदेस गयो चलि सोई ॥",
      "sourceLineId": "117986",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚਾਕਰ ਤਹਾ ਨ ਪਹੂੰਚ੍ਯੋ ਕੋਈ ॥੬॥",
      "transliteration": "chaakar tahaa na pahoo(n)chayo koiee ||6||",
      "translation": "When he entered another territory, no servant was left with him.(6)",
      "punjabiViakhya": "ਤਾ ਕੋਈ ਨੌਕਰ ਉਥੇ ਨਾ ਪਹੁੰਚ ਸਕਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "चाकर तहा न पहूँच्यो कोई ॥६॥",
      "sourceLineId": "117987",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰਾਜ ਪ੍ਰਭਾ ਇਕ ਰਾਜ ਦੁਲਾਰੀ ॥",
      "transliteration": "raaj prabhaa ik raaj dhulaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ) ਰਾਜ ਪ੍ਰਭਾ ਨਾ ਦੀ ਇਕ ਰਾਜ ਕੁਮਾਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "राज प्रभा इक राज दुलारी ॥",
      "sourceLineId": "117988",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਾਜਾ ਕੋ ਪ੍ਰਾਨਨ ਤੇ ਪ੍ਯਾਰੀ ॥",
      "transliteration": "raajaa ko praanan te payaaree ||",
      "translation": "There was a princess named Raj Prabha, who loved Raja more than her soul.",
      "punjabiViakhya": "ਜੋ ਰਾਜੇ ਨੂੰ ਪ੍ਰਾਣਾ ਤੋਂ ਪਿਆਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "राजा को प्रानन ते प्यारी ॥",
      "sourceLineId": "117989",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਧੌਲਰ ਊਚ ਤਵਨ ਕੌ ਰਾਜੈ ॥",
      "transliteration": "dhaualar uooch tavan kau raajai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਉੱਚਾ ਮਹੱਲ ਸ਼ੋਭਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "धौलर ऊच तवन कौ राजै ॥",
      "sourceLineId": "117990",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਨੋ ਚੰਦ੍ਰਮਾ ਕੋਲ ਬਿਰਾਜੈ ॥੭॥",
      "transliteration": "mano cha(n)dhramaa kol biraajai ||7||",
      "translation": "Her sovereign palace would surmount the heights ofthe Moon.(7)",
      "punjabiViakhya": "ਜੋ ਮਾਨੋ ਚੰਦ੍ਰਮਾ ਜਿੰਨਾ ਉੱਚਾ ਸੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "मनो चंद्रमा कोल बिराजै ॥७॥",
      "sourceLineId": "117991",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਪਤੀ ਨਦੀ ਤੀਰ ਤਿਹ ਬਹੈ ॥",
      "transliteration": "tapatee nadhee teer teh bahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਨੇੜੇ ਤਪਤੀ ਨਦੀ ਵਗਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "तपती नदी तीर तिह बहै ॥",
      "sourceLineId": "117992",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੂਰਜ ਸੁਤਾ ਤਾਹਿ ਜਗ ਕਹੈ ॥",
      "transliteration": "sooraj sutaa taeh jag kahai ||",
      "translation": "An over gushing river used to flow nearby whose name was Jamuna.",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜਗਤ ਵਾਲੇ ਸੂਰਜ ਦੀ ਪੁੱਤਰੀ ਕਹਿੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "सूरज सुता ताहि जग कहै ॥",
      "sourceLineId": "117993",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪੰਛੀ ਤਹਾ ਚੁਗਤ ਅਤਿ ਸੋਹੈ ॥",
      "transliteration": "pa(n)chhee tahaa chugat at sohai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਪੰਛੀ ਚੁਗਦੇ ਹੋਏ ਬਹੁਤ ਸ਼ੋਭਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "पंछी तहा चुगत अति सोहै ॥",
      "sourceLineId": "117994",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹੇਰਨਿਹਾਰਨ ਕੋ ਮਨੁ ਮੋਹੈ ॥੮॥",
      "transliteration": "heranihaaran ko man mohai ||8||",
      "translation": "Around there, the birds picking up the seeds, always looked charming.(8)",
      "punjabiViakhya": "ਵੇਖਣ ਵਾਲਿਆਂ ਦੇ ਮਨ ਮੋਹ ਲੈਂਦੇ ਸਨ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "हेरनिहारन को मनु मोहै ॥८॥",
      "sourceLineId": "117995",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੁੰਦਰ ਤਾਹਿ ਝਰੋਖੇ ਜਹਾ ॥",
      "transliteration": "su(n)dhar taeh jharokhe jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ (ਮਹੱਲ ਦੇ) ਸੁੰਦਰ ਝਰੋਖੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "सुँदर ताहि झरोखे जहा ॥",
      "sourceLineId": "117996",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਾਢ੍ਯੋ ਆਨਿ ਰਾਇ ਮ੍ਰਿਗ ਤਹਾ ॥",
      "transliteration": "kaaddayo aan rai mirag tahaa ||",
      "translation": "In the palace, which had beautiful windows, the deer brought the Raja there.",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਹਿਰਨ ਨੂੰ ਉਥੇ ਜਾ ਕਢਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "काढ्यो आनि राइ मृग तहा ॥",
      "sourceLineId": "117997",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤੁਰੈ ਧਵਾਇ ਸ੍ਰਮਿਤ ਤਿਹ ਕੀਨੋ ॥",
      "transliteration": "turai dhavai sramit teh keeno ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜਾ ਭਜਾ ਕੇ ਰਾਜੇ ਨੇ ਉਸ ਨੂੰ ਥਕਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "तुरै धवाइ स्रमित तिह कीनो ॥",
      "sourceLineId": "117998",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸ੍ਰਿੰਗਨ ਤੇ ਸ੍ਰਿੰਗੀ ਗਹਿ ਲੀਨੋ ॥੯॥",
      "transliteration": "sira(n)gan te sira(n)gee geh leeno ||9||",
      "translation": "The Raja had made the deer tired and caught it by holding it from the horns.(9)",
      "punjabiViakhya": "ਅਤੇ ਹਿਰਨ ਨੂੰ ਸਿੰਗਾ ਤੋਂ ਫੜ ਲਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "सृंगन ते सृंगी गहि लीनो ॥९॥",
      "sourceLineId": "117999",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਯਹ ਕੌਤਕ ਨ੍ਰਿਪ ਸੁਤਾ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "yeh kauatak nirap sutaa nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਕੌਤਕ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "यह कौतक नृप सुता निहारियो ॥",
      "sourceLineId": "118000",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਯਹੈ ਆਪਨੇ ਹ੍ਰਿਦੈ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "yahai aapane hiradhai bichaariyo ||",
      "translation": "Raj Kumari observed this scene and thought in her mind.",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਹਿਰਦੇ ਵਿਚ ਇਹ ਵਿਚਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "यहै आपने हृदै बिचारियो ॥",
      "sourceLineId": "118001",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮੈ ਅਬ ਹੀ ਇਹ ਨ੍ਰਿਪ ਕੌ ਬਰੌ ॥",
      "transliteration": "mai ab hee ieh nirap kau barau ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਹੁਣ ਹੀ ਇਸ ਰਾਜੇ ਨੂੰ ਵਿਆਹਾਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "मै अब ही इह नृप कौ बरौ ॥",
      "sourceLineId": "118002",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਾਤਰ ਮਾਰਿ ਕਟਾਰੀ ਮਰੌ ॥੧੦॥",
      "transliteration": "naatar maar kaTaaree marau ||10||",
      "translation": "‘I will marry only this Raja otherwise I will finish myself with a dagger.(10)",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਕਟਾਰ ਮਾਰ ਕੇ ਮਰ ਜਾਵਾਗੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "नातर मारि कटारी मरौ ॥१०॥",
      "sourceLineId": "118003",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਐਸੀ ਪ੍ਰੀਤਿ ਰਾਇ ਸੌ ਜੋਰੀ ॥",
      "transliteration": "aaisee preet rai sau joree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਰਾਜੇ ਨਾਲ ਅਜਿਹੀ ਪ੍ਰੀਤ ਜੋੜ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "ऐसी प्रीति राइ सौ जोरी ॥",
      "sourceLineId": "118004",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਾਹੂ ਪਾਸ ਜਾਤ ਨਹਿ ਤੋਰੀ ॥",
      "transliteration": "kaahoo paas jaat neh toree ||",
      "translation": "She showered such a love that could not be shattered.",
      "punjabiViakhya": "ਜੋ ਕਿਸੇ ਕੋਲੋਂ ਤੋੜੀ ਨਹੀਂ ਜਾ ਸਕਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "काहू पास जात नहि तोरी ॥",
      "sourceLineId": "118005",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨੈਨ ਸੈਨ ਦੈ ਤਾਹਿ ਬਲਾਯੋ ॥",
      "transliteration": "nain sain dhai taeh balaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਖ ਦੇ ਇਸ਼ਾਰੇ ਨਾਲ ਰਾਜੇ ਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "नैन सैन दै ताहि बलायो ॥",
      "sourceLineId": "118006",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮੈਨ ਭੋਗ ਤਹਿ ਸਾਥ ਕਮਾਯੋ ॥੧੧॥",
      "transliteration": "main bhog teh saath kamaayo ||11||",
      "translation": "Through her charming looks, she invited Raja and made love with him.(11)",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "मैन भोग तहि साथ कमायो ॥११॥",
      "sourceLineId": "118007",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਐਸੀ ਫਬਤ ਦੁਹੂੰਨ ਕੀ ਜੋਰੀ ॥",
      "transliteration": "aaisee fabat dhuhoo(n)n kee joree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ) ਦੋਹਾ ਦੀ ਜੋੜੀ ਇਸ ਤਰ੍ਰਹਾ ਫਬੀ,",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "ऐसी फबत दुहूँन की जोरी ॥",
      "sourceLineId": "118008",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਨੁਕ ਕ੍ਰਿਸਨ ਬ੍ਰਿਖਭਾਨ ਕਿਸੋਰੀ ॥",
      "transliteration": "januk kirasan birakhabhaan kisoree ||",
      "translation": "The couple befitted so much that they seemed as the epitome of Krishna and Radha.",
      "punjabiViakhya": "ਮਾਨੋ ਰਾਧਾ ਅਤੇ ਕ੍ਰਿਸ਼ਨ (ਦੀ ਜੋੜੀ) ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "जनुक कृसन बृखभान किसोरी ॥",
      "sourceLineId": "118009",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੁਹੂੰ ਹਾਥ ਤਿਹ ਕੁਚਨ ਮਰੋਰੈ ॥",
      "transliteration": "dhuhoo(n) haath teh kuchan marorai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਉਸ ਦੇ ਦੋਹਾ ਹੱਥਾ ਨਾਲ ਕੁਚ ਮਰੋੜ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "दुहूँ हाथ तिह कुचन मरोरै ॥",
      "sourceLineId": "118010",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਨੁ ਖੋਯੋ ਨਿਧਨੀ ਧਨੁ ਟੋਰੈ ॥੧੨॥",
      "transliteration": "jan khoyo nidhanee dhan Torai ||12||",
      "translation": "They honnobbed their hands like a poor man who tried to move his hands searching for his last wealth.(12)",
      "punjabiViakhya": "ਮਾਨੋ ਕੋਈ ਨਿਰਧਨ ਗਵਾਚੇ ਹੋਏ ਧਨ ਨੂੰ ਲਭ ਰਿਹਾ ਹੋਵੇ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "जनु खोयो निधनी धनु टोरै ॥१२॥",
      "sourceLineId": "118011",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਾਰ ਬਾਰ ਤਿਹ ਗਰੇ ਲਗਾਵੈ ॥",
      "transliteration": "baar baar teh gare lagaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ) ਉਸ ਨੂੰ ਬਾਰ ਬਾਰ ਗਲੇ ਲਗਾਉਾਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "बार बार तिह गरे लगावै ॥",
      "sourceLineId": "118012",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਨੁ ਕੰਦ੍ਰਪ ਕੋ ਦ੍ਰਪੁ ਮਿਟਾਵੈ ॥",
      "transliteration": "jan ka(n)dhrap ko dhrap miTaavai ||",
      "translation": "He cuddled her again and again as if trying to ravage the pride of the Cupid.",
      "punjabiViakhya": "ਮਾਨੋ ਕਾਮਦੇਵ ਦਾ ਹੰਕਾਰ ਮਿਟਾ ਰਿਹਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "जनु कंद्रप को द्रपु मिटावै ॥",
      "sourceLineId": "118013",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਭੋਗਤ ਤਾਹਿ ਜੰਘ ਲੈ ਕਾਧੇ ॥",
      "transliteration": "bhogat taeh ja(n)gh lai kaadhe ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀਆਂ) ਟੰਗਾ ਨੂੰ ਮੋਢਿਆਂ ਤੇ ਰਖ ਕੇ ਉਸ ਨੂੰ (ਇਸ ਪ੍ਰਕਾਰ ਭੋਗਦਾ ਸੀ)",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "भोगत ताहि जंघ लै काधे ॥",
      "sourceLineId": "118014",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਨੁ ਦ੍ਵੈ ਮੈਨ ਤਰਕਸਨ ਬਾਧੇ ॥੧੩॥",
      "transliteration": "jan dhavai main tarakasan baadhe ||13||",
      "translation": "Making love by keeping her legs on the shoulder, he looked like the Cupid charging an arrow in the bow.(13)",
      "punjabiViakhya": "ਮਾਨੋ ਕਾਮ ਦੇਵ ਨੇ ਦੋ ਭੱਥੇ ਬੰਨ੍ਰਹੇ ਹੋਣ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "जनु द्वै मैन तरकसन बाधे ॥१३॥",
      "sourceLineId": "118015",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਸੌ ਚੁੰਬਨ ਕੀਨੇ ॥",
      "transliteration": "bhaat bhaat sau chu(n)ban keene ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਤਰ੍ਰਹਾ ਦੇ ਚੁੰਬਨ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "भाति भाति सौ चुँबन कीने ॥",
      "sourceLineId": "118016",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਆਸਨ ਤ੍ਰਿਯ ਦੀਨੇ ॥",
      "transliteration": "bhaat bhaat aasan tiray dheene ||",
      "translation": "He kissed her in many ways and endowed her many types of postures.",
      "punjabiViakhya": "ਅਤੇ ਇਸਤਰੀ ਨੇ ਭਾਤ ਭਾਤ ਦੇ ਆਸਨ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "भाति भाति आसन तृय दीने ॥",
      "sourceLineId": "118017",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0961_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗਹਿ ਗਹਿ ਤਾ ਸੋ ਗਰੇ ਲਗਾਈ ॥",
      "transliteration": "geh geh taa so gare lagaiee ||",
      "translation": "",
      "punjabiViakhya": "ਪਕੜ ਪਕੜ ਕੇ ਉਸ ਨੂੰ ਗਲੇ ਲਗਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 961,
      "hindi": "",
      "hindiTransliteration": "गहि गहि ता सो गरे लगाई ॥",
      "sourceLineId": "118018",
      "sourceShabadId": "10820",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
