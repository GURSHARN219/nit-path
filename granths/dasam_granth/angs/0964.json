{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 964,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0964_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "118115",
      "sourceShabadId": "10836",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਿਹਸਿ ਕੁਅਰ ਯੌ ਬਚਨ ਉਚਾਰੋ ॥",
      "transliteration": "bihas kuar yau bachan uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਹੱਸ ਕੇ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "बिहसि कुअर यौ बचन उचारो ॥",
      "sourceLineId": "118116",
      "sourceShabadId": "10836",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੋਕ ਕਰੋ ਨਹਿ ਬਾਲ ਹਮਾਰੋ ॥",
      "transliteration": "sok karo neh baal hamaaro ||",
      "translation": "But Kumar said jovially, ‘Don’t worry about me.",
      "punjabiViakhya": "ਕਿ ਹੇ ਇਸਤਰੀ! ਤੂੰ ਮੇਰੀ ਚਿੰਤਾ ਨਾ ਕਰ।",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "सोक करो नहि बाल हमारो ॥",
      "sourceLineId": "118117",
      "sourceShabadId": "10836",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹੌ ਅਬ ਏਕ ਉਪਾਯਹਿ ਕਰਿਹੋ ॥",
      "transliteration": "hau ab ek upaayeh kariho ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਹੁਣ ਇਕ ਉਪਾ ਕਰਦਾ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "हौ अब एक उपायहि करिहो ॥",
      "sourceLineId": "118118",
      "sourceShabadId": "10836",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਾ ਤੇ ਤੁਮਰੋ ਸੋਕ ਨਿਵਰਿਹੋ ॥੪੦॥",
      "transliteration": "jaa te tumaro sok nivariho ||40||",
      "translation": "‘I will find a way which will eradicate your affliction.’(40)",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਤੇਰਾ ਦੁਖ ਦੂਰ ਹੋ ਜਾਏਗਾ ॥੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "जा ते तुमरो सोक निवरिहो ॥४०॥",
      "sourceLineId": "118119",
      "sourceShabadId": "10836",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਮਰੋ ਕਛੂ ਸੋਕ ਨਹਿ ਕੀਜੈ ॥",
      "transliteration": "hamaro kachhoo sok neh keejai ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੀ ਚਿੰਤਾ ਬਿਲਕੁਲ ਨਾ ਕਰ",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "हमरो कछू सोक नहि कीजै ॥",
      "sourceLineId": "118120",
      "sourceShabadId": "10836",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤੀਰ ਕਮਾਨ ਆਨਿ ਮੁਹਿ ਦੀਜੈ ॥",
      "transliteration": "teer kamaan aan muh dheejai ||",
      "translation": "‘Please don’t worry about me,just get me a bow and arrow.",
      "punjabiViakhya": "ਅਤੇ ਮੈਨੂੰ ਤੀਰ ਕਮਾਨ ਲਿਆ ਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "तीर कमान आनि मुहि दीजै ॥",
      "sourceLineId": "118121",
      "sourceShabadId": "10836",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮੁਹਕਮ ਕੈ ਦਰਵਾਜੋ ਦ੍ਰਯਾਵਹੁ ॥",
      "transliteration": "muhakam kai dharavaajo dhrayaavahu ||",
      "translation": "",
      "punjabiViakhya": "ਮਜ਼ਬੂਤੀ ਨਾਲ ਦਰਵਾਜ਼ਾ ਬੰਦ ਕਰ ਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "मुहकम कै दरवाजो द्रयावहु ॥",
      "sourceLineId": "118122",
      "sourceShabadId": "10836",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਯਾ ਆਂਗਨ ਮਹਿ ਸੇਜ ਬਿਛਾਵਹੁ ॥੪੧॥",
      "transliteration": "yaa aa(n)gan meh sej bichhaavahu ||41||",
      "translation": "‘Close the door tightly and lay down a bed in the courtyard.’(41)",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਆਂਗਨ ਵਿਚ ਸੇਜ ਵਿਛਾ ਦੇ ॥੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "या आँगन महि सेज बिछावहु ॥४१॥",
      "sourceLineId": "118123",
      "sourceShabadId": "10836",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਵਹੈ ਕਾਮ ਅਬਲਾ ਤਿਨ ਕਿਯੋ ॥",
      "transliteration": "vahai kaam abalaa tin kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਉਹੀ ਕੰਮ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "वहै काम अबला तिन कियो ॥",
      "sourceLineId": "118124",
      "sourceShabadId": "10836",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤੀਰ ਕਮਾਨਿ ਆਨਿ ਤਿਹ ਦਿਯੋ ॥",
      "transliteration": "teer kamaan aan teh dhiyo ||",
      "translation": "The woman abided by accordingly and brought him a bow and arrow.",
      "punjabiViakhya": "ਅਤੇ ਤੀਰ ਕਮਾਨ ਲਿਆ ਕੇ ਉਸ ਨੂੰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "तीर कमानि आनि तिह दियो ॥",
      "sourceLineId": "118125",
      "sourceShabadId": "10836",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਲੀ ਭਾਤਿ ਸੌ ਸੇਜ ਬਿਛਾਈ ॥",
      "transliteration": "bhalee bhaat sau sej bichhaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਚੰਗੀ ਤਰ੍ਰਹਾ ਸੇਜ ਵਿਛਾ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "भली भाति सौ सेज बिछाई ॥",
      "sourceLineId": "118126",
      "sourceShabadId": "10836",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਾ ਪਰ ਮੀਤ ਲਯੋ ਬੈਠਾਈ ॥੪੨॥",
      "transliteration": "taa par meet layo baiThaiee ||42||",
      "translation": "Elegantly she bedecked a bed and over it made the lover to sit.(42)",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਉਪਰ ਮਿਤਰ ਨੂੰ ਬਿਠਾ ਲਿਆ ॥੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "ता पर मीत लयो बैठाई ॥४२॥",
      "sourceLineId": "118127",
      "sourceShabadId": "10836",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "118128",
      "sourceShabadId": "10837",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਬ ਅਬਲਾ ਚਿੰਤਾ ਕਰੀ ਜਿਯ ਤੇ ਭਈ ਨਿਰਾਸ ॥",
      "transliteration": "tab abalaa chi(n)taa karee jiy te bhiee niraas ||",
      "translation": "Contemplating thus, she thought in her mind,",
      "punjabiViakhya": "ਤਦ ਇਸਤਰੀ ਨੇ ਮਨ ਵਿਚ ਫ਼ਿਕਰ ਕੀਤਾ ਅਤੇ ਮਨ ਵਿਚ ਉਦਾਸ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "तब अबला चिंता करी जिय ते भई निरास ॥",
      "sourceLineId": "118129",
      "sourceShabadId": "10837",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜੀਯੋ ਤ ਪਿਯ ਕੇ ਸਹਿਤ ਹੀ ਮਰੌ ਤ ਪਤਿ ਕੇ ਪਾਸ ॥੪੩॥",
      "transliteration": "jeeyo ta piy ke sahit hee marau ta pat ke paas ||43||",
      "translation": "‘I will live or die with my lover.’(43)",
      "punjabiViakhya": "(ਫਿਰ ਸੋਚਣ ਲਗੀ ਕਿ) ਜੇ ਜੀਵਾਗੀ ਤਾ ਪ੍ਰੀਤਮ ਦੇ ਨਾਲ ਅਤੇ ਜੇ ਮਰਾਗੀ ਤਾ ਵੀ ਪ੍ਰੀਤਮ ਦੇ ਕੋਲ (ਹੀ ਮਰਾਗੀ) ॥੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "जीयो त पिय के सहित ही मरौ त पति के पास ॥४३॥",
      "sourceLineId": "118130",
      "sourceShabadId": "10837",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "118131",
      "sourceShabadId": "10838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪਲਕਾ ਪਰ ਮੀਤਹਿ ਬੈਠਾਯੋ ॥",
      "transliteration": "palakaa par meeteh baiThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਮਿਤਰ ਨੂੰ ਪਲੰਘ ('ਪਲਕਾ') ਉਤੇ ਬਿਠਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "पलका पर मीतहि बैठायो ॥",
      "sourceLineId": "118132",
      "sourceShabadId": "10838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਸੌ ਕੇਲ ਕਮਾਯੋ ॥",
      "transliteration": "bhaat bhaat sau kel kamaayo ||",
      "translation": "She gave him loving looks and made love in various manners.",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦੀ ਕਾਮਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "भाति भाति सौ केल कमायो ॥",
      "sourceLineId": "118133",
      "sourceShabadId": "10838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਭੋਗਨ ਭਰਹੀ ॥",
      "transliteration": "bhaat bhaat ke bhogan bharahee ||",
      "translation": "",
      "punjabiViakhya": "ਤਰ੍ਰਹਾ ਤਰ੍ਰਹਾ ਦੇ (ਜੀ) ਭਰ ਕੇ ਭੋਗ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के भोगन भरही ॥",
      "sourceLineId": "118134",
      "sourceShabadId": "10838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਿਯ ਅਪਨੇ ਕੋ ਤ੍ਰਾਸ ਨ ਕਰਹੀ ॥੪੪॥",
      "transliteration": "jiy apane ko traas na karahee ||44||",
      "translation": "While gratifying themselves with love-making, they dreaded not at all.(44)",
      "punjabiViakhya": "ਅਤੇ ਹਿਰਦੇ ਵਿਚ ਜ਼ਰਾ ਜਿੰਨੇ ਵੀ ਨਹੀਂ ਡਰੇ ॥੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "जिय अपने को त्रास न करही ॥४४॥",
      "sourceLineId": "118135",
      "sourceShabadId": "10838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਬ ਲੌ ਚਕ੍ਰਵਾਕ ਦੋ ਆਏ ॥",
      "transliteration": "tab lau chakravaak dho aae ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਦੋ ਚਕਵੇ (ਚਕਵਿਆਂ ਦੀ ਜੋੜੀ) ਆਏ।",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "तब लौ चक्रवाक दो आए ॥",
      "sourceLineId": "118136",
      "sourceShabadId": "10838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਾਜ ਕੁਮਾਰ ਦ੍ਰਿਗਨ ਲਖਿ ਪਾਏ ॥",
      "transliteration": "raaj kumaar dhiragan lakh paae ||",
      "translation": "There appeared two ruddy sheldrakes (very big birds) that were seen by Raj Kumar.",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰ ਨੇ (ਉਨ੍ਰਹਾ ਨੂੰ) ਅੱਖਾ ਨਾਲ ਵੇਖ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "राज कुमार दृगन लखि पाए ॥",
      "sourceLineId": "118137",
      "sourceShabadId": "10838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਏਕ ਧਨੁ ਤਾਨਿ ਬਾਨ ਸੌ ਮਾਰਿਯੋ ॥",
      "transliteration": "ek dhan taan baan sau maariyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਨੂੰ ਧਨੁਸ਼ ਖਿਚ ਕੇ ਬਾਣ ਨਾਲ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "एक धनु तानि बान सौ मारियो ॥",
      "sourceLineId": "118138",
      "sourceShabadId": "10838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦੁਤਿਯਾ ਹਾਥ ਸਰ ਦੁਤਿਯ ਪ੍ਰਹਾਰਿਯੋ ॥੪੫॥",
      "transliteration": "dhutiyaa haath sar dhutiy prahaariyo ||45||",
      "translation": "One he killed with the bow, and the other, he finished with an arrow held in his hands.(45)",
      "punjabiViakhya": "ਦੂਜੇ ਹੱਥ ਨਾਲ ਤੀਰ ਚਲਾ ਕੇ ਦੂਜੇ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ॥੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "दुतिया हाथ सर दुतिय प्रहारियो ॥४५॥",
      "sourceLineId": "118139",
      "sourceShabadId": "10838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੁਹੂੰ ਸਰਨ ਦੁਹੂੰਅਨ ਬਧ ਕੀਨੋ ॥",
      "transliteration": "dhuhoo(n) saran dhuhoo(n)an badh keeno ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਬਾਣਾ ਨਾਲ ਦੋਹਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "दुहूँ सरन दुहूँअन बध कीनो ॥",
      "sourceLineId": "118140",
      "sourceShabadId": "10838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੁਹੂੰਅਨ ਭੂੰਨਿ ਛਿਨਿਕ ਮਹਿ ਲੀਨੋ ॥",
      "transliteration": "dhuhoo(n)an bhoo(n)n chhinik meh leeno ||",
      "translation": "With two arrows he destroyed both and they roasted them immediately.",
      "punjabiViakhya": "ਦੋਹਾ ਨੂੰ ਛਿਣ ਭਰ ਵਿਚ ਭੁੰਨ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "दुहूँअन भूँनि छिनिक महि लीनो ॥",
      "sourceLineId": "118141",
      "sourceShabadId": "10838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਿਨ ਦੁਹੂੰਅਨ ਦੁਹੂੰਅਨ ਕੋ ਖਾਯੋ ॥",
      "transliteration": "tin dhuhoo(n)an dhuhoo(n)an ko khaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੋਹਾ ਨੇ ਦੋਹਾ ਨੂੰ ਖਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "तिन दुहूँअन दुहूँअन को खायो ॥",
      "sourceLineId": "118142",
      "sourceShabadId": "10838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੰਕ ਛੋਰਿ ਪੁਨ ਕੇਲ ਕਮਾਯੋ ॥੪੬॥",
      "transliteration": "sa(n)k chhor pun kel kamaayo ||46||",
      "translation": "They both ate both of them, then, fearlessly enjoyed the sex.(46)",
      "punjabiViakhya": "ਅਤੇ ਨਿਸੰਗ ਹੋ ਕੇ ਫਿਰ ਕੇਲ-ਕ੍ਰੀੜਾ ਕਰਨ ਲਗ ਗਏ ॥੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "संक छोरि पुन केल कमायो ॥४६॥",
      "sourceLineId": "118143",
      "sourceShabadId": "10838",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "118144",
      "sourceShabadId": "10839",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਿਨ ਕੋ ਭਛਨ ਕਰਿ ਦੁਹਨ ਲੀਨੋ ਚਰਮ ਉਤਾਰਿ ॥",
      "transliteration": "tin ko bhachhan kar dhuhan leeno charam utaar ||",
      "translation": "After relishing them they took off their skins.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ (ਚਕਵਿਆਂ) ਨੂੰ ਖਾ ਕੇ ਉਨ੍ਰਹਾ ਦੀ ਖਲੜੀ ਉਤਾਰ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "तिन को भछन करि दुहन लीनो चरम उतारि ॥",
      "sourceLineId": "118145",
      "sourceShabadId": "10839",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪਹਿਰਿ ਦੁਹੁਨ ਸਿਰ ਪੈ ਲਯੋ ਪੈਠੇ ਨਦੀ ਮਝਾਰਿ ॥੪੭॥",
      "transliteration": "pahir dhuhun sir pai layo paiThe nadhee majhaar ||47||",
      "translation": "Putting those on their heads, they jumped into the river.(47)",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਸਿਰ ਤੇ ਪਾ ਕੇ ਦੋਵੇਾਂ ਨਦੀ ਵਿਚ ਠਿਲ੍ਰਹ ਪਏ ॥੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "पहिरि दुहुन सिर पै लयो पैठे नदी मझारि ॥४७॥",
      "sourceLineId": "118146",
      "sourceShabadId": "10839",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "118147",
      "sourceShabadId": "10840",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਚਕ੍ਰਵਾਰ ਸਭ ਕੋ ਤਿਨ ਜਾਨੈ ॥",
      "transliteration": "chakravaar sabh ko tin jaanai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸਭ ਨੂੰ ਚਕਵੇ ਲਗਣ ਲਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "चक्रवार सभ को तिन जानै ॥",
      "sourceLineId": "118148",
      "sourceShabadId": "10840",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਾਨੁਖ ਕੈ ਨ ਕੋਊ ਪਹਿਚਾਨੈ ॥",
      "transliteration": "maanukh kai na kouoo pahichaanai ||",
      "translation": "Every body took them as birds and never thought they could be humans.",
      "punjabiViakhya": "ਮਨੁੱਖ ਵਜੋਂ ਕੋਈ ਪਛਾਣਦਾ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "मानुख कै न कोऊ पहिचानै ॥",
      "sourceLineId": "118149",
      "sourceShabadId": "10840",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪੈਰਤ ਬਹੁ ਕੋਸਨ ਲਗਿ ਗਏ ॥",
      "transliteration": "pairat bahu kosan lag ge ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਤਰਦੇ ਤਰਦੇ ਕਈ ਕੋਹਾ ਤਕ ਚਲੇ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "पैरत बहु कोसन लगि गए ॥",
      "sourceLineId": "118150",
      "sourceShabadId": "10840",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਲਾਗਤ ਏਕ ਕਿਨਾਰੇ ਭਏ ॥੪੮॥",
      "transliteration": "laagat ek kinaare bhe ||48||",
      "translation": "Swimming and swirling they went a long way and touched the bank.(48)",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਥਾ ਕੰਢੇ ਜਾ ਲਗੇ ॥੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "लागत एक किनारे भए ॥४८॥",
      "sourceLineId": "118151",
      "sourceShabadId": "10840",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦੋ ਹੈ ਦੋਊ ਅਰੂੜਿਤ ਭਏ ॥",
      "transliteration": "dho hai dhouoo arooRit bhe ||",
      "translation": "",
      "punjabiViakhya": "ਦੋ ਘੋੜਿਆਂ ਉਤੇ ਦੋਵੇਾਂ ਸਵਾਰ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "दो है दोऊ अरूड़ित भए ॥",
      "sourceLineId": "118152",
      "sourceShabadId": "10840",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚਲਿ ਕਰਿ ਦੇਸ ਆਪਨੇ ਗਏ ॥",
      "transliteration": "chal kar dhes aapane ge ||",
      "translation": "They engaged two horses and travelled to their country.",
      "punjabiViakhya": "ਅਤੇ ਚਲ ਕੇ ਆਪਣੇ ਦੇਸ ਜਾ ਪਹੁੰਚੇ।",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "चलि करि देस आपने गए ॥",
      "sourceLineId": "118153",
      "sourceShabadId": "10840",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਾ ਕੌ ਲੈ ਪਟਰਾਨੀ ਕੀਨੋ ॥",
      "transliteration": "taa kau lai paTaraanee keeno ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ (ਰਾਜੇ ਨੇ) ਪਟਰਾਣੀ ਬਣਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "ता कौ लै पटरानी कीनो ॥",
      "sourceLineId": "118154",
      "sourceShabadId": "10840",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚਿਤ ਕੋ ਸੋਕ ਦੂਰਿ ਕਰਿ ਦੀਨੋ ॥੪੯॥",
      "transliteration": "chit ko sok dhoor kar dheeno ||49||",
      "translation": "Retaining her as his principal Rani, he obliterated all his agonies.(49)",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਦੇ) ਚਿਤ ਦਾ ਦੁਖ ਦੂਰ ਕਰ ਦਿੱਤਾ ॥੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "चित को सोक दूरि करि दीनो ॥४९॥",
      "sourceLineId": "118155",
      "sourceShabadId": "10840",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "118156",
      "sourceShabadId": "10841",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪੰਛਿਯਨ ਕੋ ਪੋਸਤ ਧਰੇ ਪਿਤੁ ਕੀ ਦ੍ਰਿਸਟਿ ਬਚਾਇ ॥",
      "transliteration": "pa(n)chhiyan ko posat dhare pit kee dhirasaT bachai ||",
      "translation": "Wearing the skins of birds, they had escaped the looks of her father.",
      "punjabiViakhya": "ਪੰਛੀਆਂ ਦੀ ਖਲੜੀ (ਪਾ ਕੇ) ਅਤੇ ਪਿਤਾ ਦੀ ਨਜ਼ਰ ਬਚਾ ਕੇ (ਉਹ ਨਿਕਲ ਗਏ)।",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "पंछियन को पोसत धरे पितु की दृसटि बचाइ ॥",
      "sourceLineId": "118157",
      "sourceShabadId": "10841",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪੰਖੀ ਹੀ ਸਭ ਕੋ ਲਖੈ ਮਾਨੁਖ ਲਖ੍ਯੋ ਨ ਜਾਇ ॥੫੦॥",
      "transliteration": "pa(n)khee hee sabh ko lakhai maanukh lakhayo na jai ||50||",
      "translation": "Every body considered them as the birds and none could guess that they were humans.(50)",
      "punjabiViakhya": "(ਉਹ) ਸਾਰਿਆਂ ਨੂੰ ਪੰਛੀ ਹੀ ਲਗੇ, ਮਨੁੱਖ ਵਜੋਂ ਨਾ ਸਮਝੇ ਗਏ ॥੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "पंखी ही सभ को लखै मानुख लख्यो न जाइ ॥५०॥",
      "sourceLineId": "118158",
      "sourceShabadId": "10841",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਦੇਸ ਆਨਿ ਅਪਨੇ ਬਸੇ ਤਿਯ ਕੋ ਸਦਨ ਬਨਾਇ ॥",
      "transliteration": "dhes aan apane base tiy ko sadhan banai ||",
      "translation": "‘They had come to their own country now,",
      "punjabiViakhya": "ਆਪਣੇ ਦੇਸ ਵਿਚ ਆ ਕੇ ਵਸ ਗਏ ਅਤੇ ਰਾਣੀ ਨੂੰ ਨਵਾ ਮਹੱਲ ਬਣਵਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "देस आनि अपने बसे तिय को सदन बनाइ ॥",
      "sourceLineId": "118159",
      "sourceShabadId": "10841",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਾ ਸੋ ਰਮੈ ਨਿਸੁ ਦਿਨ ਮੋਦ ਬਢਾਇ ॥੫੧॥",
      "transliteration": "bhaat bhaat taa so ramai nis dhin modh baddai ||51||",
      "translation": "And day and night blissfully enjoyed love-making.(51)(1)",
      "punjabiViakhya": "ਰਾਤ ਦਿਨ ਆਨੰਦ ਵਧਾ ਕੇ ਤਰ੍ਰਹਾ ਤਰ੍ਰਹਾ ਨਾਲ (ਉਸ ਨਾਲ) (ਰਾਜਾ) ਰਮਣ ਕਰਦਾ ॥੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "भाति भाति ता सो रमै निसु दिन मोद बढाइ ॥५१॥",
      "sourceLineId": "118160",
      "sourceShabadId": "10841",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਗਿਆਰਹ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੧੧॥੨੧੫੭॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau giaareh charitr samaapatam sat subham sat ||111||2157||afajoo(n)||",
      "translation": "111th Parable of Auspicious Chritars Conversation of the Raja and the Minister, Completed With Benediction. (111)(2155)",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ਇਕ ਸੌ ਯਾਰ੍ਰਹਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੧੧॥੨੧੫੭॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ गिआरह चरित्र समापतम सतु सुभम सतु ॥१११॥२१५७॥अफजूँ॥",
      "sourceLineId": "118161",
      "sourceShabadId": "10841",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0964_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 964,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "118162",
      "sourceShabadId": "10842",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
