{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 977,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0977_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਿਦਾ ਅਮਿਤ ਧਨ ਦੈ ਕਰੋ ਯਾ ਕੌ ਅਧਿਕ ਰਿਝਾਇ ॥੧੧॥",
      "transliteration": "bidhaa amit dhan dhai karo yaa kau adhik rijhai ||11||",
      "translation": "‘Now you give her a send-off with lot of riches.’(11)",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਖ਼ੁਸ਼ ਕਰਦੇ ਹੋਇਆਂ ਬਹੁਤ ਸਾਰਾ ਧਨ ਦੇ ਕੇ ਵਿਦਾ ਕਰ ਦਿਓ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "बिदा अमित धन दै करो या कौ अधिक रिझाइ ॥११॥",
      "sourceLineId": "118787",
      "sourceShabadId": "10921",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "118788",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਬ ਇਹ ਬਾਤ ਨ੍ਰਿਪਤਿ ਸੁਨਿ ਪਾਈ ॥",
      "transliteration": "jab ieh baat nirapat sun paiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਇਹ ਗੱਲ ਰਾਜੇ ਨੇ ਸੁਣੀ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "जब इह बात नृपति सुनि पाई ॥",
      "sourceLineId": "118789",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਾਨ੍ਯੋ ਮੋਰਿ ਧਰਮਜਾ ਆਈ ॥",
      "transliteration": "jaanayo mor dharamajaa aaiee ||",
      "translation": "When he came to know of the fact that his righteous-daughter had come,",
      "punjabiViakhya": "ਕਿ ਮੇਰੀ ਧਰਮ-ਪੁੱਤਰੀ ਆਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "जान्यो मोरि धरमजा आई ॥",
      "sourceLineId": "118790",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਛੋਰਿ ਭੰਡਾਰ ਅਮਿਤ ਧਨ ਦਿਯੋ ॥",
      "transliteration": "chhor bha(n)ddaar amit dhan dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਖ਼ਜ਼ਾਨਾ ਖੋਲ੍ਰਹ ਕੇ ਬਹੁਤ ਧਨ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "छोरि भंडार अमित धन दियो ॥",
      "sourceLineId": "118791",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਦੁਹਿਤਾ ਹੇਤ ਬਿਦਾ ਤਿਹ ਕਿਯੋ ॥੧੨॥",
      "transliteration": "dhuhitaa het bidhaa teh kiyo ||12||",
      "translation": "He opened up the all his repositories and gave her a send-off befitting a real daughter.(12)",
      "punjabiViakhya": "ਅਤੇ ਪੁੱਤਰੀ ਦੇ ਹਿਤ ਨਾਲ ਉਸ ਨੂੰ ਵਿਦਾ ਕੀਤਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "दुहिता हेत बिदा तिह कियो ॥१२॥",
      "sourceLineId": "118792",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮੰਤ੍ਰ ਕਲਾ ਪਿਤੁ ਤੀਰ ਉਚਾਰੀ ॥",
      "transliteration": "ma(n)tr kalaa pit teer uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਮੰਤ੍ਰ ਕਲਾ ਨੇ ਪਿਤਾ ਕੋਲ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "मंत्र कला पितु तीर उचारी ॥",
      "sourceLineId": "118793",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਧਰਮ ਬਹਿਨ ਮੋ ਕੌ ਅਤਿ ਪ੍ਯਾਰੀ ॥",
      "transliteration": "dharam bahin mo kau at payaaree ||",
      "translation": "Mantar Kala said to her father, ‘The righteous-sister is too dear to me.",
      "punjabiViakhya": "ਕਿ ਧਰਮ-ਭੈਣ ਮੈਨੂੰ ਬਹੁਤ ਪਿਆਰੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "धरम बहिन मो कौ अति प्यारी ॥",
      "sourceLineId": "118794",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮੈ ਯਹ ਅਜੁ ਸੰਗ ਲੈ ਜੈਹੌ ॥",
      "transliteration": "mai yeh aj sa(n)g lai jaihau ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਅਜ ਇਸ ਨੂੰ ਨਾਲ ਲੈ ਜਾਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "मै यह अजु संग लै जैहौ ॥",
      "sourceLineId": "118795",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਨ ਉਪਬਨ ਕੇ ਚਰਿਤ੍ਰ ਦਿਖੈਹੌ ॥੧੩॥",
      "transliteration": "ban upaban ke charitr dhikhaihau ||13||",
      "translation": "‘’Today, I will take her with me and will entertain her in our gardens.(13)",
      "punjabiViakhya": "ਅਤੇ ਬਨਾ ਉਪਬਨਾ ਦੇ ਕਈ ਪ੍ਰਕਾਰ ਦੇ ਨਜ਼ਾਰੇ ('ਚਰਿਤ੍ਰ') ਵਿਖਾਵਾਗੀ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "बन उपबन के चरित्र दिखैहौ ॥१३॥",
      "sourceLineId": "118796",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਯੌ ਕਹਿ ਪਲਟਿ ਧਾਮ ਨਿਜੁ ਆਈ ॥",
      "transliteration": "yau keh palaT dhaam nij aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਕਹਿ ਕੇ ਉਹ ਮਹੱਲ ਵਿਚ ਪਰਤ ਆਈ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "यौ कहि पलटि धाम निजु आई ॥",
      "sourceLineId": "118797",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪਿਯ ਸੌ ਕਹੀ ਬਾਤ ਮੁਸਕਾਈ ॥",
      "transliteration": "piy sau kahee baat musakaiee ||",
      "translation": "‘Then while taking her to her palace happily, she said,",
      "punjabiViakhya": "ਅਤੇ ਪ੍ਰੀਤਮ ਨੂੰ ਹੱਸ ਕੇ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "पिय सौ कही बात मुसकाई ॥",
      "sourceLineId": "118798",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਧਰਮ ਭਗਨਿ ਮੁਹਿ ਤੂ ਅਤਿ ਪ੍ਯਾਰੀ ॥",
      "transliteration": "dharam bhagan muh too at payaaree ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਧਰਮ-ਭੈਣ! ਤੂੰ ਮੈਨੂੰ ਬਹੁਤ ਪਿਆਰੀ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "धरम भगनि मुहि तू अति प्यारी ॥",
      "sourceLineId": "118799",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਸੀ ਪਾਲਕੀ ਚਰ੍ਰਹੋ ਹਮਾਰੀ ॥੧੪॥",
      "transliteration": "eisee paalakee charraho hamaaree ||14||",
      "translation": "‘As you are very dear to me, you can come into my palanquin.(14)",
      "punjabiViakhya": "(ਇਸ ਲਈ) ਇਸੇ ਮੇਰੇ ਵਾਲੀ ਪਾਲਕੀ ਵਿਚ ਬੈਠ ਜਾ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "इसी पालकी चर्रहो हमारी ॥१४॥",
      "sourceLineId": "118800",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਾਤ ਕਹਤ ਦੋਊ ਹਮ ਜੈਹੈ ॥",
      "transliteration": "baat kahat dhouoo ham jaihai ||",
      "translation": "",
      "punjabiViakhya": "ਅਸੀਂ ਦੋਵੇਾਂ ਗੱਲਾ ਕਰਦੀਆਂ ਜਾਵਾਗੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "बात कहत दोऊ हम जैहै ॥",
      "sourceLineId": "118801",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚਿਤ ਕੈ ਸੋਕ ਦੂਰਿ ਕਰਿ ਦੈਹੈ ॥",
      "transliteration": "chit kai sok dhoor kar dhaihai ||",
      "translation": "‘We both will go talking, and eradicate our afflictions.’",
      "punjabiViakhya": "ਅਤੇ ਚਿਤ ਦੇ ਦੁਖ ਦੂਰ ਕਰ ਦਿਆਂਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "चित कै सोक दूरि करि दैहै ॥",
      "sourceLineId": "118802",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਾਹਿ ਪਾਲਕੀ ਲਯੋ ਚਰ੍ਰਹਾਈ ॥",
      "transliteration": "taeh paalakee layo charrahaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਪਾਲਕੀ ਵਿਚ ਚੜ੍ਰਹਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "ताहि पालकी लयो चर्रहाई ॥",
      "sourceLineId": "118803",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਨ ਉਪਬਨ ਬਿਹਰਨ ਕੌ ਆਈ ॥੧੫॥",
      "transliteration": "ban upaban biharan kau aaiee ||15||",
      "translation": "‘Then they climbed the same palanquin and came to thejungle.(15)",
      "punjabiViakhya": "ਅਤੇ ਬਨ ਉਪਬਨ ਵਿਚ ਫਿਰਨ ਲਈ ਆ ਗਈ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "बन उपबन बिहरन कौ आई ॥१५॥",
      "sourceLineId": "118804",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬੀਚ ਬਜਾਰ ਪਾਲਕੀ ਗਈ ॥",
      "transliteration": "beech bajaar paalakee giee ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦੋਂ) ਪਾਲਕੀ ਬਾਜ਼ਾਰ ਵਿਚੋਂ ਲੰਘੀ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "बीच बजार पालकी गई ॥",
      "sourceLineId": "118805",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪਰਦਨ ਪਾਤਿ ਛੋਰਿ ਕੈ ਦਈ ॥",
      "transliteration": "paradhan paat chhor kai dhiee ||",
      "translation": "When the palanquin was passing through the city, the people gave them the way.",
      "punjabiViakhya": "ਤਾ ਪਰਦਿਆਂ ਦੇ ਪੱਲੇ ਖੋਲ੍ਰਹ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "परदन पाति छोरि कै दई ॥",
      "sourceLineId": "118806",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤੇ ਕਾਹੂ ਕੌ ਦ੍ਰਿਸਟਿ ਨ ਆਵੈ ॥",
      "transliteration": "te kaahoo kau dhirasaT na aavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਕਰ ਕੇ (ਉਹ) ਕਿਸੇ ਨੂੰ ਦਿਸ ਨਹੀਂ ਰਹੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "ते काहू कौ दृसटि न आवै ॥",
      "sourceLineId": "118807",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕੇਲ ਕਮਾਤ ਚਲੇ ਦੋਊ ਜਾਵੈ ॥੧੬॥",
      "transliteration": "kel kamaat chale dhouoo jaavai ||16||",
      "translation": "They were not visible and were involved in making love.(16)",
      "punjabiViakhya": "ਅਤੇ ਦੋਵੇਾਂ ਕੇਲ ਕਰਦੀਆਂ ਹੋਈਆਂ ਜਾ ਰਹੀਆਂ ਸਨ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "केल कमात चले दोऊ जावै ॥१६॥",
      "sourceLineId": "118808",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਨ ਭਾਵਤ ਕੋ ਭੋਗ ਕਮਾਏ ॥",
      "transliteration": "man bhaavat ko bhog kamaae ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮਨ ਭਾਉਾਂਦੇ ਭੋਗ ਕਰ ਰਹੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "मन भावत को भोग कमाए ॥",
      "sourceLineId": "118809",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦਿਨ ਬਜਾਰ ਮਹਿ ਕਿਨੂੰ ਨ ਪਾਏ ॥",
      "transliteration": "dhin bajaar meh kinoo(n) na paae ||",
      "translation": "In spite of their indulgence in lovemaking, no body noticed them through the market.",
      "punjabiViakhya": "ਅਤੇ ਦਿਨ ਵਿਚ ਵੀ ਬਾਜ਼ਾਰ ਵਿਚ ਕੋਈ ਵੇਖ ਨਹੀਂ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "दिन बजार महि किनूँ न पाए ॥",
      "sourceLineId": "118810",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਸਟ ਕਹਾਰਨ ਕੇ ਕੰਧ ਊਪਰ ॥",
      "transliteration": "asaT kahaaran ke ka(n)dh uoopar ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਠਾ ਕਹਾਰਾ ਦੁਆਰਾ ਚੁਕੀ ਹੋਈ ਪਾਲਕੀ ਵਿਚ ਮਿਤਰ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "असट कहारन के कंध ऊपर ॥",
      "sourceLineId": "118811",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਾਘੈ ਲਈ ਮੀਤ ਭੁਜ ਦੂਪਰ ॥੧੭॥",
      "transliteration": "jaaghai liee meet bhuj dhoopar ||17||",
      "translation": "On the shoulders of eight bearers, the lover was holding beloved’s legs in his arms.(17)",
      "punjabiViakhya": "(ਰਾਜ ਕੁਮਾਰੀ ਦੀਆਂ) ਦੋਵੇਾਂ ਟੰਗਾ ਦੋਹਾ ਬਾਹਵਾ ਉਪਰ ਲਈਆਂ ਹੋਈਆਂ ਸਨ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "जाघै लई मीत भुज दूपर ॥१७॥",
      "sourceLineId": "118812",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜ੍ਯੋਂ ਜ੍ਯੋਂ ਚਲੀ ਪਾਲਕੀ ਜਾਵੈ ॥",
      "transliteration": "jayo(n) jayo(n) chalee paalakee jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਉਾਂ ਜਿਉਾਂ ਪਾਲਕੀ ਚਲਦੀ ਜਾ ਰਹੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "ज्यों ज्यों चली पालकी जावै ॥",
      "sourceLineId": "118813",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤ੍ਯੋਂ ਪ੍ਰੀਤਮ ਚਟਕੇ ਚਟਕਾਵੈ ॥",
      "transliteration": "tayo(n) preetam chaTake chaTakaavai ||",
      "translation": "As the palanquin was moving, the lover was enjoying the swings.",
      "punjabiViakhya": "ਤਿਵੇਾਂ ਪ੍ਰੀਤਮ ਚਟਕਾਰੇ ਮਾਰ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "त्यों प्रीतम चटके चटकावै ॥",
      "sourceLineId": "118814",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਲਹੈਂ ਕਹਾਰ ਪਾਲਕੀ ਚਰਿ ਕੈ ॥",
      "transliteration": "lahai(n) kahaar paalakee char kai ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਉਾਂ ਜਿਉਾਂ) ਕਹਾਰ ਪਾਲਕੀ ਵਿਚੋਂ 'ਚੀਕੂੰ ਚੀਕੂੰ' ਦੀ ਆਵਾਜ਼ ਸੁਣਦੇ,",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "लहैं कहार पालकी चरि कै ॥",
      "sourceLineId": "118815",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤ੍ਯੋਂ ਤ੍ਯੋਂ ਗਹੈ ਕੰਧ ਦ੍ਰਿੜ ਕਰਿ ਕੈ ॥੧੮॥",
      "transliteration": "tayo(n) tayo(n) gahai ka(n)dh dhiraR kar kai ||18||",
      "translation": "As the bearers swung the palanquin while walking, she clung to the lover’s shoulders.(18)",
      "punjabiViakhya": "ਤਿਉਾਂ ਤਿਉਾਂ ਉਹ ਮੋਢੇ ਨਾਲ ਘੁਟ ਕੇ ਪਕੜ ਲੈਂਦੇ ਸਨ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "त्यों त्यों गहै कंध दृड़ करि कै ॥१८॥",
      "sourceLineId": "118816",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਨ ਮੈ ਜਾਇ ਪਾਲਕੀ ਧਰੀ ॥",
      "transliteration": "ban mai jai paalakee dharee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਜਾ ਕੇ ਬਨ ਵਿਚ ਪਾਲਕੀ ਧਰ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "बन मै जाइ पालकी धरी ॥",
      "sourceLineId": "118817",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਸੇਤੀ ਰਤਿ ਕਰੀ ॥",
      "transliteration": "bhaat bhaat setee rat karee ||",
      "translation": "The palanquin was placed in the jungle and they relished in lovemaking invariably.",
      "punjabiViakhya": "ਅਤੇ (ਉਨ੍ਰਹਾ ਨੇ) ਭਾਤ ਭਾਤ ਦੀ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "भाति भाति सेती रति करी ॥",
      "sourceLineId": "118818",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਮਿਤ ਦਰਬੁ ਚਾਹਿਯੋ ਸੋ ਲਯੋ ॥",
      "transliteration": "amit dharab chaahiyo so layo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਜੋ ਚਾਹਿਆ, ਅਮਿਤ ਧਨ ਲੈ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "अमित दरबु चाहियो सो लयो ॥",
      "sourceLineId": "118819",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤ੍ਰਿਯ ਕਰਿ ਤਾਹਿ ਦੇਸ ਲੈ ਗਯੋ ॥੧੯॥",
      "transliteration": "tiray kar taeh dhes lai gayo ||19||",
      "translation": "He had received untold amount of money and, as a result of this, took woman to his country.(19)",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ (ਆਪਣੀ) ਇਸਤਰੀ ਬਣਾ ਕੇ ਦੇਸ਼ ਲੈ ਗਿਆ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "तृय करि ताहि देस लै गयो ॥१९॥",
      "sourceLineId": "118820",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਲਿਖਿ ਪਤਿਯਾ ਡੋਰੀ ਮਹਿ ਧਰੀ ॥",
      "transliteration": "likh patiyaa ddoree meh dharee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਇਕ ਪੱਤਰ ਲਿਖ ਕੇ ਪਾਲਕੀ ਵਿਚ ਰਖ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "लिखि पतिया डोरी महि धरी ॥",
      "sourceLineId": "118821",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮਾਤ ਪਿਤਾ ਤਨ ਇਹੈ ਉਚਰੀ ॥",
      "transliteration": "maat pitaa tan ihai ucharee ||",
      "translation": "The girl wrote a letter and left in the palanquin and told her parents that,",
      "punjabiViakhya": "ਅਤੇ ਮਾਤਾ ਪਿਤਾ ਪ੍ਰਤਿ ਇਹ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "मात पिता तन इहै उचरी ॥",
      "sourceLineId": "118822",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਰ ਸੁੰਦਰ ਮੋ ਕਹ ਯਹ ਭਾਯੋ ॥",
      "transliteration": "nar su(n)dhar mo keh yeh bhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਹ ਵਿਅਕਤੀ ਮੈਨੂੰ ਬਹੁਤ ਚੰਗਾ ਲਗਿਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "नर सुँदर मो कह यह भायो ॥",
      "sourceLineId": "118823",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਾ ਤੇ ਮੈ ਯਹ ਚਰਿਤ ਬਨਾਯੋ ॥੨੦॥",
      "transliteration": "taa te mai yeh charit banaayo ||20||",
      "translation": "‘I liked this handsome man and for that I played afl this game.’(20)",
      "punjabiViakhya": "ਇਸ ਲਈ ਮੈਂ ਇਹ ਚਰਿਤ੍ਰ ਬਣਾਇਆ ਸੀ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "ता ते मै यह चरित बनायो ॥२०॥",
      "sourceLineId": "118824",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਵਹ ਧ੍ਰਮਜਾ ਨਹਿ ਹੋਇ ਤਿਹਾਰੀ ॥",
      "transliteration": "veh dhramajaa neh hoi tihaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਤੁਹਾਡੀ ਧਰਮ-ਪੁੱਤਰੀ ਨਹੀਂ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "वह ध्रमजा नहि होइ तिहारी ॥",
      "sourceLineId": "118825",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜੋ ਮੈ ਪਕਰਿ ਪਾਲਕੀ ਡਾਰੀ ॥",
      "transliteration": "jo mai pakar paalakee ddaaree ||",
      "translation": "‘She was not your righteous daughter, which I had taken in the palanquin with me.",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਪਕੜ ਕੇ ਮੈਂ ਪਾਲਕੀ ਵਿਚ ਬਿਠਾਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "जो मै पकरि पालकी डारी ॥",
      "sourceLineId": "118826",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਚ ਅਰਿ ਲਏ ਦੂਰਿ ਕਚ ਕਏ ॥",
      "transliteration": "kach ar le dhoor kach ke ||",
      "translation": "",
      "punjabiViakhya": "ਰੋਮਨਾਸਨੀ ('ਕਚਅਰਿ') ਲੈ ਕੇ (ਮੈਂ ਉਸ ਦੇ) ਵਾਲ ਦੂਰ ਕਰ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "कच अरि लए दूरि कच कए ॥",
      "sourceLineId": "118827",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭੂਖਨ ਬਸਤ੍ਰ ਬਾਲ ਕੇ ਦਏ ॥੨੧॥",
      "transliteration": "bhookhan basatr baal ke dhe ||21||",
      "translation": "‘His hair had been removed with a medicine and he had put on women clothes and ornaments.(21)",
      "punjabiViakhya": "ਅਤੇ ਇਸਤਰੀ ਦੇ ਬਸਤ੍ਰ ਅਤੇ ਗਹਿਣੇ ਦੇ ਦਿੱਤੇ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "भूखन बसत्र बाल के दए ॥२१॥",
      "sourceLineId": "118828",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜੋ ਧਨ ਚਹਿਯੋ ਸੋਊ ਸਭ ਲੀਨੋ ॥",
      "transliteration": "jo dhan chahiyo souoo sabh leeno ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਧਨ ਚਾਹੀਦਾ ਸੀ, ਉਹ ਲੈ ਲਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "जो धन चहियो सोऊ सभ लीनो ॥",
      "sourceLineId": "118829",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਾਤ ਮਾਤ ਕੋ ਦਰਸਨ ਕੀਨੋ ॥",
      "transliteration": "taat maat ko dharasan keeno ||",
      "translation": "‘We have had lot of riches and I have met his parents.",
      "punjabiViakhya": "ਅਤੇ ਮਾਤਾ ਪਿਤਾ ਦੇ ਦਰਸ਼ਨ ਕਰ ਲਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "तात मात को दरसन कीनो ॥",
      "sourceLineId": "118830",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤੁਮ ਤੇ ਜਬ ਲੈ ਬਿਦਾ ਸਿਧਾਈ ॥",
      "transliteration": "tum te jab lai bidhaa sidhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵੇਲੇ ਤੋਂ ਤੁਹਾਡੇ ਤੋਂ ਵਿਦਾ ਹੋਈ ਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "तुम ते जब लै बिदा सिधाई ॥",
      "sourceLineId": "118831",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਯਾ ਕੇ ਸੰਗ ਤਬੈ ਉਠਿ ਆਈ ॥੨੨॥",
      "transliteration": "yaa ke sa(n)g tabai uTh aaiee ||22||",
      "translation": "‘Since the time I left you, I have relished living with him.(22)",
      "punjabiViakhya": "ਤਦੋਂ ਇਸ ਨਾਲ ਉਠ ਕੇ ਆ ਗਈ ਹਾ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "या के संग तबै उठि आई ॥२२॥",
      "sourceLineId": "118832",
      "sourceShabadId": "10922",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "118833",
      "sourceShabadId": "10923",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦੇਸ ਸੁਖੀ ਤੁਮਰੋ ਬਸੋ ਸੁਖੀ ਰਹਹੁ ਤੁਮ ਤਾਤ ॥",
      "transliteration": "dhes sukhee tumaro baso sukhee rahahu tum taat ||",
      "translation": "‘Oh my father, may your country flourish and you live blissfully,",
      "punjabiViakhya": "ਹੇ ਪਿਤਾ ਜੀ! ਤੁਸੀਂ ਸੁਖੀ ਰਹੋ ਅਤੇ ਤੁਹਾਡਾ ਦੇਸ਼ ਸੁਖੀ ਵਸੇ।",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "देस सुखी तुमरो बसो सुखी रहहु तुम तात ॥",
      "sourceLineId": "118834",
      "sourceShabadId": "10923",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸੁਖੀ ਦੋਊ ਹਮਹੂੰ ਬਸੈ ਚਿਰ ਜੀਵੋ ਤੁਮ ਮਾਤ ॥੨੩॥",
      "transliteration": "sukhee dhouoo hamahoo(n) basai chir jeevo tum maat ||23||",
      "translation": "‘And bless us, too, to live happily here onward.’(23)(1)",
      "punjabiViakhya": "ਅਸੀਂ ਵੀ ਦੋਵੇਾਂ ਸੁਖੀ ਵਸੀਏ ਅਤੇ ਹੇ ਮਾਤਾ ਜੀ! ਤੁਸੀਂ ਚਿਰਾ ਤਕ ਜੀਓ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "सुखी दोऊ हमहूँ बसै चिर जीवो तुम मात ॥२३॥",
      "sourceLineId": "118835",
      "sourceShabadId": "10923",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਉਨੀਸਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੧੯॥੨੩੩੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau uneesavo charitr samaapatam sat subham sat ||119||2332||afajoo(n)||",
      "translation": "119th Parable of Auspicious Chritars Conversation of the Raja and the Minister, Completed With Benediction. (119)(2330)",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੧੯ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੧੯॥੨੩੩੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ उनीसवो चरित्र समापतम सतु सुभम सतु ॥११९॥२३३२॥अफजूँ॥",
      "sourceLineId": "118836",
      "sourceShabadId": "10923",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "118837",
      "sourceShabadId": "10924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਸ੍ਰੀ ਇੰਦ੍ਰ ਜੂ ਹਰ ਘਰ ਕਿਯੋ ਪਿਯਾਨ ॥",
      "transliteration": "ek dhivas sree i(n)dhr joo har ghar kiyo piyaan ||",
      "translation": "One day Lord lndra decided to go to the house of Shiva.",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਸ੍ਰੀ ਇੰਦਰ ਜੀ ਸ਼ਿਵ ਦੇ ਘਰ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "एक दिवस स्री इंद्र जू हर घर कियो पियान ॥",
      "sourceLineId": "118838",
      "sourceShabadId": "10924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮਹਾ ਰੁਦ੍ਰ ਕਉ ਰੁਦ੍ਰ ਲਖਿ ਚਿੰਤ ਬਢੀ ਅਪ੍ਰਮਾਨ ॥੧॥",
      "transliteration": "mahaa rudhr kau rudhr lakh chi(n)t baddee apramaan ||1||",
      "translation": "Seeing god Ruder in disturbing situation, he got worried.(1)",
      "punjabiViakhya": "ਮਹਾ ਰੁਦ੍ਰ ਨੂੰ ਭਿਆਨਕ ਰੂਪ ਵਿਚ ਵੇਖ ਕੇ ਬਹੁਤ ਚਿੰਤਾ ਹੋਈ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "महा रुद्र कउ रुद्र लखि चिंत बढी अप्रमान ॥१॥",
      "sourceLineId": "118839",
      "sourceShabadId": "10924",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "118840",
      "sourceShabadId": "10925",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਦੇਵਤੇਸ ਜਬ ਰੁਦ੍ਰ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "dhevates jab rudhr nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਇੰਦਰ ('ਦੇਵਤੇਸ') ਨੇ ਰੁਦ੍ਰ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "देवतेस जब रुद्र निहारियो ॥",
      "sourceLineId": "118841",
      "sourceShabadId": "10925",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਮਹਾ ਕੋਪ ਕਰਿ ਬਜ੍ਰ ਪ੍ਰਹਾਰਿਯੋ ॥",
      "transliteration": "mahaa kop kar bajr prahaariyo ||",
      "translation": "When Ruder saw him, he flew into a rage and hit him with a stone.",
      "punjabiViakhya": "ਤਾ ਬਹੁਤ ਗੁੱਸੇ ਹੋ ਕੇ ਬਜ੍ਰ ਦਾ ਵਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "महा कोप करि बज्र प्रहारियो ॥",
      "sourceLineId": "118842",
      "sourceShabadId": "10925",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਤਾ ਤੇ ਅਮਿਤ ਕੋਪ ਤਬ ਤਯੋ ॥",
      "transliteration": "taa te amit kop tab tayo ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਰੁਦ੍ਰ ਦਾ) ਗੁੱਸਾ ਹੋਰ ਭੜਕ ਉਠਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "ता ते अमित कोप तब तयो ॥",
      "sourceLineId": "118843",
      "sourceShabadId": "10925",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਛਾਡਤ ਜ੍ਵਾਲ ਬਕਤ੍ਰ ਤੇ ਭਯੋ ॥੨॥",
      "transliteration": "chhaaddat javaiaal bakatr te bhayo ||2||",
      "translation": "Being infuriated, leaving apart every thing, he threw fire from his mouth.(2)",
      "punjabiViakhya": "ਅਤੇ ਮੂੰਹ ਤੋਂ ਅਗਨੀ ਕੱਢਣ ਲਗਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "छाडत ज्वाल बकत्र ते भयो ॥२॥",
      "sourceLineId": "118844",
      "sourceShabadId": "10925",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਪਸਰਿ ਜ੍ਵਾਲ ਸਭ ਜਗ ਮਹਿ ਗਈ ॥",
      "transliteration": "pasar javaiaal sabh jag meh giee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਸੰਸਾਰ ਵਿਚ ਅਗਨੀ ਪਸਰ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "पसरि ज्वाल सभ जग महि गई ॥",
      "sourceLineId": "118845",
      "sourceShabadId": "10925",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਦਾਹਤ ਤੀਨਿ ਭਵਨ ਕਹ ਭਈ ॥",
      "transliteration": "dhaahat teen bhavan keh bhiee ||",
      "translation": "The fire then flared all over and started to burn all the three domains.",
      "punjabiViakhya": "ਅਤੇ ਤਿੰਨਾ ਲੋਕਾ ਨੂੰ ਸਾੜਨ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "दाहत तीनि भवन कह भई ॥",
      "sourceLineId": "118846",
      "sourceShabadId": "10925",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਦੇਵ ਦੈਤ ਸਭ ਹੀ ਡਰ ਪਾਏ ॥",
      "transliteration": "dhev dhait sabh hee ddar paae ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤੇ ਅਤੇ ਦੈਂਤ ਸਾਰੇ ਡਰ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "देव दैत सभ ही डर पाए ॥",
      "sourceLineId": "118847",
      "sourceShabadId": "10925",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਮਿਲਿ ਕਰਿ ਮਹਾ ਰੁਦ੍ਰ ਪਹਿ ਆਏ ॥੩॥",
      "transliteration": "mil kar mahaa rudhr peh aae ||3||",
      "translation": "The god and devils, all were dreaded and got together to go to see Ruder.(3)",
      "punjabiViakhya": "ਅਤੇ ਮਿਲ ਕੇ ਮਹਾ ਰੁਦ੍ਰ ਕੋਲ ਪਹੁੰਚੇ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "मिलि करि महा रुद्र पहि आए ॥३॥",
      "sourceLineId": "118848",
      "sourceShabadId": "10925",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਮਹਾ ਰੁਦ੍ਰ ਤਬ ਕੋਪ ਨਿਵਾਰਿਯੋ ॥",
      "transliteration": "mahaa rudhr tab kop nivaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਮਹਾ ਰੁਦ੍ਰ ਨੇ ਕ੍ਰੋਧ ਨੂੰ ਛਡ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "महा रुद्र तब कोप निवारियो ॥",
      "sourceLineId": "118849",
      "sourceShabadId": "10925",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਬਾਰਿਧ ਮੈ ਪਾਵਕ ਕੋ ਡਾਰਿਯੋ ॥",
      "transliteration": "baaridh mai paavak ko ddaariyo ||",
      "translation": "The great Ruder then calmed down and threw fire into the sea.",
      "punjabiViakhya": "ਅਤੇ ਅਗਨੀ ਨੂੰ ਸਮੁੰਦਰ ਵਿਚ ਸੁਟ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "बारिध मै पावक को डारियो ॥",
      "sourceLineId": "118850",
      "sourceShabadId": "10925",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਸਕਲ ਤੇਜ ਇਕਠੋ ਹ੍ਵੈ ਗਯੋ ॥",
      "transliteration": "sakal tej ikaTho havai gayo ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਾ ਤੇਜ ਇਕੱਠਾ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "सकल तेज इकठो ह्वै गयो ॥",
      "sourceLineId": "118851",
      "sourceShabadId": "10925",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਤਾ ਤੇ ਦੈਤ ਜਲੰਧਰ ਭਯੋ ॥੪॥",
      "transliteration": "taa te dhait jala(n)dhar bhayo ||4||",
      "translation": "All the radiance was condensed and through that, great devils Jalandhar was produced.(4)",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਜਲੰਧਰ ਦੈਂਤ ਪੈਦਾ ਹੋਇਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "ता ते दैत जलंधर भयो ॥४॥",
      "sourceLineId": "118852",
      "sourceShabadId": "10925",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਬ੍ਰਿੰਦਾ ਨਾਮ ਤ੍ਰਿਯਾ ਤਿਨ ਕੀਨੀ ॥",
      "transliteration": "bira(n)dhaa naam tirayaa tin keenee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਬ੍ਰਿੰਦਾ ਨਾ ਦੀ ਇਸਤਰੀ ਨੂੰ ਗ੍ਰਹਿਣ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "बृंदा नाम तृया तिन कीनी ॥",
      "sourceLineId": "118853",
      "sourceShabadId": "10925",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਅਤਿ ਪਤਿਬ੍ਰਤਾ ਜਗਤ ਮੈ ਚੀਨੀ ॥",
      "transliteration": "at patibrataa jagat mai cheenee ||",
      "translation": "He adopted the woman called Brinda, who was exalted as virtuous wife.",
      "punjabiViakhya": "ਜੋ ਜਗਤ ਵਿਚ ਅਤਿ ਪਤਿਬ੍ਰਤਾ ਮੰਨੀ ਜਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "अति पतिब्रता जगत मै चीनी ॥",
      "sourceLineId": "118854",
      "sourceShabadId": "10925",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਤਿਹ ਪ੍ਰਸਾਦਿ ਪਤਿ ਰਾਜ ਕਮਾਵੈ ॥",
      "transliteration": "teh prasaadh pat raaj kamaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਦੀ ਕ੍ਰਿਪਾ ਕਰ ਕੇ ਪਤੀ ਰਾਜ ਕਮਾਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "तिह प्रसादि पति राज कमावै ॥",
      "sourceLineId": "118855",
      "sourceShabadId": "10925",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਤਾ ਕੌ ਦੁਸਟ ਨ ਦੇਖਨ ਪਾਵੈ ॥੫॥",
      "transliteration": "taa kau dhusaT na dhekhan paavai ||5||",
      "translation": "Through her benevolence he started his reign bUt the enemies could not bear.(5)",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਕੋਈ ਦੁਸ਼ਟ ਵੇਖ ਵੀ ਨਹੀਂ ਸਕਦਾ ਸੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "ता कौ दुसट न देखन पावै ॥५॥",
      "sourceLineId": "118856",
      "sourceShabadId": "10925",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਦੇਵ ਅਦੇਵ ਜੀਤਿ ਤਿਨ ਲਏ ॥",
      "transliteration": "dhev adhev jeet tin le ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ (ਸਾਰੇ) ਦੇਵਤੇ ਅਤੇ ਦੈਂਤ ਜਿਤ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 977,
      "hindi": "",
      "hindiTransliteration": "देव अदेव जीति तिन लए ॥",
      "sourceLineId": "118857",
      "sourceShabadId": "10925",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0977_line_0072",
      "lineIndex": 72,
