{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 981,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0981_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਾਇ ਰਾਵ ਪ੍ਰਤਿ ਯਹੈ ਉਚਾਰੋ ॥",
      "transliteration": "jai raav prat yahai uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਕੇ ਰਾਜੇ ਨੂੰ (ਸਾਡੇ ਵਲੋਂ) ਇਹ ਕਹੋ",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "जाइ राव प्रति यहै उचारो ॥",
      "sourceLineId": "119003",
      "sourceShabadId": "10942",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਵ ਦੇਖਨ ਕੌ ਹਿਯੋ ਹਮਾਰੋ ॥੪॥",
      "transliteration": "tav dhekhan kau hiyo hamaaro ||4||",
      "translation": "‘Go and tell the Raja that we wan ted to have the pleasure of meeting him.( 4)",
      "punjabiViakhya": "ਕਿ ਤੁਹਾਨੂੰ ਦੇਖਣ ਤੇ ਸਾਡਾ ਮਨ ਕਰਦਾ ਹੈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "तव देखन कौ हियो हमारो ॥४॥",
      "sourceLineId": "119004",
      "sourceShabadId": "10942",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਯੌ ਸੁਨਿ ਬਚਨ ਰਾਵ ਤਿਹ ਆਯੋ ॥",
      "transliteration": "yau sun bachan raav teh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਬੋਲ ਸੁਣ ਕੇ ਰਾਜਾ ਉਥੇ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "यौ सुनि बचन राव तिह आयो ॥",
      "sourceLineId": "119005",
      "sourceShabadId": "10942",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚਾਰਿ ਚਾਰਿ ਭੀਤਰਿ ਬੈਠਾਯੋ ॥",
      "transliteration": "chaar chaar bheetar baiThaayo ||",
      "translation": "Getting such communication he came over, but on his way, he established the posts of four persons each.",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਚਾਰ ਚਾਰ ਦੀਆਂ ਚੌਕੀਆਂ ਵਿਚ ਬਿਠਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "चारि चारि भीतरि बैठायो ॥",
      "sourceLineId": "119006",
      "sourceShabadId": "10942",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਿਨ ਆਯੁਧ ਦੇਖਨ ਕੌ ਲਏ ॥",
      "transliteration": "tin aayudh dhekhan kau le ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਹਥਿਆਰ ਵੇਖਣ ਲਈ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "तिन आयुध देखन कौ लए ॥",
      "sourceLineId": "119007",
      "sourceShabadId": "10942",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਾਥੋ ਹਾਥ ਕਾਢਿ ਕੈ ਦਏ ॥੫॥",
      "transliteration": "haatho haath kaadd kai dhe ||5||",
      "translation": "Then he requested Raja to show him his arms, and he readily agreed.(5)",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਹੱਥੋਂ ਹੱਥ ਕਢ ਕੇ ਦੇ ਦਿੱਤੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "हाथो हाथ काढि कै दए ॥५॥",
      "sourceLineId": "119008",
      "sourceShabadId": "10942",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਆਯੁਧੁ ਕਾਢਿ ਐਸ ਬਿਧਿ ਦਏ ॥",
      "transliteration": "aayudh kaadd aais bidh dhe ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਸ਼ਸਤ੍ਰ ਕਢ ਕੇ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "आयुधु काढि ऐस बिधि दए ॥",
      "sourceLineId": "119009",
      "sourceShabadId": "10942",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੋਰੇ ਏਕ ਬਨਾਵਤ ਭਏ ॥",
      "transliteration": "jore ek banaavat bhe ||",
      "translation": "He gave in all those and, then, ordered new clothes them.",
      "punjabiViakhya": "ਕਿ (ਉਨ੍ਰਹਾ ਦੇ) ਜੋੜੇ ਬਣਾਉਣ ਲਗ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "जोरे एक बनावत भए ॥",
      "sourceLineId": "119010",
      "sourceShabadId": "10942",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਾ ਕੀ ਬਾਹ ਸੀਵਿ ਦੋਊ ਲੀਨੀ ॥",
      "transliteration": "jaa kee baeh seev dhouoo leenee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀਆਂ ਦੋਵੇਾਂ ਬਾਹਵਾ ਇਸ ਤਰ੍ਰਹਾ ਸੀ ਲਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "जा की बाह सीवि दोऊ लीनी ॥",
      "sourceLineId": "119011",
      "sourceShabadId": "10942",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਿਨੁ ਬਾਧੋ ਮੁਸਕੈ ਜਨ ਦੀਨੀ ॥੬॥",
      "transliteration": "bin baadho musakai jan dheenee ||6||",
      "translation": "The sleeves of those were prepared such that, without tying even, the arms could not be moved.(6)",
      "punjabiViakhya": "ਮਾਨੋ ਬਿਨਾ ਬੰਨ੍ਰਹਿਆਂ ਹੀ ਮੁਸ਼ਕਾ ਕਸ ਦਿੱਤੀਆਂ ਹੋਣ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "बिनु बाधो मुसकै जन दीनी ॥६॥",
      "sourceLineId": "119012",
      "sourceShabadId": "10942",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਏਕ ਭਾਟ ਕੌ ਭੇਦ ਬਤਾਯੋ ॥",
      "transliteration": "ek bhaaT kau bhedh bataayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਭਾਟ ਨੂੰ ਭੇਦ ਦਸ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "एक भाट कौ भेद बतायो ॥",
      "sourceLineId": "119013",
      "sourceShabadId": "10942",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਾਜਾ ਕੇ ਮੁਖ ਪੈ ਕਹਾਯੋ ॥",
      "transliteration": "raajaa ke mukh pai kahaayo ||",
      "translation": "He trained a bard to say to Raja at his face,",
      "punjabiViakhya": "ਰਾਜੇ ਦੇ ਮੁਖ ਉਤੇ ਇਹ ਅਖਵਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "राजा के मुख पै कहायो ॥",
      "sourceLineId": "119014",
      "sourceShabadId": "10942",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੋ ਸਭ ਸਸਤ੍ਰ ਦੈ ਮੁਝ ਡਾਰੇ ॥",
      "transliteration": "jo sabh sasatr dhai mujh ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜੇ ਤੁਸੀਂ ਸਾਰੇ ਸ਼ਸਤ੍ਰ ਮੈਨੂੰ ਦੇ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "जो सभ ससत्र दै मुझ डारे ॥",
      "sourceLineId": "119015",
      "sourceShabadId": "10942",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤੌ ਦਾਤਾ ਤੂ ਜਾਨ ਹਮਾਰੈ ॥੭॥",
      "transliteration": "tau dhaataa too jaan hamaarai ||7||",
      "translation": "‘If you give me all your arms, only then I will consider you benevolent person.’(7)",
      "punjabiViakhya": "ਤਾ ਤੁਸੀਂ (ਆਪਣੇ ਆਪ ਨੂੰ) ਸਾਡਾ ਦਾਤਾ ਸਮਝੋ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "तौ दाता तू जान हमारै ॥७॥",
      "sourceLineId": "119016",
      "sourceShabadId": "10942",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਯਹ ਸੁਨਿ ਨ੍ਰਿਪਤਿ ਸਸਤ੍ਰ ਦੈ ਡਾਰੇ ॥",
      "transliteration": "yeh sun nirapat sasatr dhai ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਸੁਣ ਕੇ ਰਾਜੇ ਨੇ ਸ਼ਸਤ੍ਰ ਦੇ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "यह सुनि नृपति ससत्र दै डारे ॥",
      "sourceLineId": "119017",
      "sourceShabadId": "10942",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹੋਰ ਰਹੇ ਮੰਤ੍ਰੀਨ ਨਿਵਾਰੇ ॥",
      "transliteration": "hor rahe ma(n)treen nivaare ||",
      "translation": "Acquiescing to the request, the Raja handed over the arms in spite of the warning of his ministers;",
      "punjabiViakhya": "ਮੰਤ੍ਰੀ ਹੋੜਦੇ ਰਹੇ, ਪਰ (ਉਹ ਦੇਣੋ) ਨਾ ਟਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "होर रहे मंत्रीन निवारे ॥",
      "sourceLineId": "119018",
      "sourceShabadId": "10942",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਾਨ੍ਯੋ ਨ੍ਰਿਪਤਿ ਨਿਰਾਯੁਧ ਭਯੋ ॥",
      "transliteration": "jaanayo nirapat niraayudh bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਰਾਜਾ ਸ਼ਸਤ੍ਰ-ਹੀਨ ਹੋਇਆ ਜਾਣ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "जान्यो नृपति निरायुध भयो ॥",
      "sourceLineId": "119019",
      "sourceShabadId": "10942",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਾਗੋ ਆਨਿ ਤਾਹਿ ਪਹਿਰਯੋ ॥੮॥",
      "transliteration": "baago aan taeh pahirayo ||8||",
      "translation": "They had envisaged the fact, that the Raja could not use his arms now, as he was going to wear white clothes.(8)",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੂੰ ਬਸਤ੍ਰ (ਚੋਗ਼ਾ) ਪਵਾ ਦਿੱਤੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "बागो आनि ताहि पहिरयो ॥८॥",
      "sourceLineId": "119020",
      "sourceShabadId": "10942",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "119021",
      "sourceShabadId": "10943",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੋ ਬਾਗੋ ਪਹਿਰਿਯੋ ਨ੍ਰਿਪਤਿ ਬਾਹ ਕਢੀ ਨਹਿ ਜਾਹਿ ॥",
      "transliteration": "so baago pahiriyo nirapat baeh kaddee neh jaeh ||",
      "translation": "Raja put that gown on, through which arms could not be taken out.",
      "punjabiViakhya": "ਉਸ ਚੋਗ਼ੇ ਨੂੰ ਪਾ ਕੇ ਰਾਜੇ ਤੋਂ ਬਾਹਵਾ ਬਾਹਰ ਕੱਢੀਆਂ ਨਹੀਂ ਜਾ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "सो बागो पहिरियो नृपति बाह कढी नहि जाहि ॥",
      "sourceLineId": "119022",
      "sourceShabadId": "10943",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤੀਰ ਖਾਨ ਠਾਢੋ ਹੁਤੋ ਮੁਸਕੈ ਲਈ ਚਰਾਇ ॥੯॥",
      "transliteration": "teer khaan Thaaddo huto musakai liee charai ||9||",
      "translation": "Teer Khan, who was standing there, tied up his arms.(9)",
      "punjabiViakhya": "ਖ਼ਾਨ ਕੋਲ ਖੜੋਤਾ ਸੀ, ਉਸ ਨੇ ਮੁਸ਼ਕਾ ਕਸ ਦਿੱਤੀਆਂ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "तीर खान ठाढो हुतो मुसकै लई चराइ ॥९॥",
      "sourceLineId": "119023",
      "sourceShabadId": "10943",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "119024",
      "sourceShabadId": "10944",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੁੰਦਰ ਰਾਜ ਪੁਤ੍ਰ ਤਹ ਭਾਰੋ ॥",
      "transliteration": "su(n)dhar raaj putr teh bhaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਖ਼ਾਨ ਨੇ ਰਾਜੇ ਨੂੰ ਕਿਹਾ) ਤੁਸੀਂ ਸੁੰਦਰ ਰਾਜ ਪੁੱਤਰ ਹੋ,",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "सुँदर राज पुत्र तह भारो ॥",
      "sourceLineId": "119025",
      "sourceShabadId": "10944",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤੁਰਤ ਤੇਗ ਕਹ ਤਾਹਿ ਸੰਭਾਰੋ ॥",
      "transliteration": "turat teg keh taeh sa(n)bhaaro ||",
      "translation": "(He said,) ‘You are a prince, come quick and strike a blow.’",
      "punjabiViakhya": "ਇਸ ਲਈ ਤੁਰਤ ਤਲਵਾਰ ਦਾ ਵਾਰ ਸੰਭਾਲੋ।",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "तुरत तेग कह ताहि संभारो ॥",
      "sourceLineId": "119026",
      "sourceShabadId": "10944",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਮਕਿ ਵਾਰ ਤਾ ਤੁਰਕਹਿ ਕਿਯੋ ॥",
      "transliteration": "tamak vaar taa turakeh kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਤੁਰਕ ਨੇ ਕ੍ਰੋਧ ਨਾਲ ਵਾਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "तमकि वार ता तुरकहि कियो ॥",
      "sourceLineId": "119027",
      "sourceShabadId": "10944",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਾਹਨ ਦੁਹੂੰ ਦੁਧਾ ਕਰਿ ਦਿਯੋ ॥੧੦॥",
      "transliteration": "baahan dhuhoo(n) dhudhaa kar dhiyo ||10||",
      "translation": "(As he could not,) Then the Turk struck and cut his both the arms.(10)",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਦੀਆਂ) ਦੋਵੇਾਂ ਬਾਹਵਾ ਦੋ ਦੋ ਟੋਟੇ ਕਰ ਦਿੱਤੀਆਂ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "बाहन दुहूँ दुधा करि दियो ॥१०॥",
      "sourceLineId": "119028",
      "sourceShabadId": "10944",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "119029",
      "sourceShabadId": "10945",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਏਕ ਰਾਵ ਅਗਨਿਤ ਤੁਰਕ ਕਹ ਲਗਿ ਲਰੈ ਰਸਾਇ ॥",
      "transliteration": "ek raav aganit turak keh lag larai rasai ||",
      "translation": "Raja was all alone, but the Turks were in great number.",
      "punjabiViakhya": "ਰਾਜਾ ਇਕ ਇਕੱਲਾ ਸੀ ਅਤੇ ਤੁਰਕ ਅਣਗਿਣਤ ਸਨ, (ਉਹ) ਗੁੱਸੇ ਵਿਚ ਹੋ ਕੇ ਕਦ ਤਕ ਲੜਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "एक राव अगनित तुरक कह लगि लरै रसाइ ॥",
      "sourceLineId": "119030",
      "sourceShabadId": "10945",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੁੰਦਰ ਕੌ ਰਾਜਾ ਭਏ ਮਾਰਤ ਭਏ ਬਜਾਇ ॥੧੧॥",
      "transliteration": "su(n)dhar kau raajaa bhe maarat bhe bajai ||11||",
      "translation": "The handsome Raja was killed after challenges.(11)",
      "punjabiViakhya": "ਸੁੰਦਰ ਰਾਜੇ ਨੂੰ ਲਲਕਾਰ ਲਲਕਾਰ ਕੇ ਮਾਰ ਦਿੱਤਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "सुँदर कौ राजा भए मारत भए बजाइ ॥११॥",
      "sourceLineId": "119031",
      "sourceShabadId": "10945",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "119032",
      "sourceShabadId": "10946",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਲ ਕੇ ਅਸ੍ਵ ਅਸ੍ਵ ਇਕ ਜਾਯੋ ॥",
      "transliteration": "jal ke asavai asavai ik jaayo ||",
      "translation": "",
      "punjabiViakhya": "ਦਰੀਆਈ ਘੋੜੇ ਤੋਂ ਪੈਦਾ ਹੋਇਆ ਇਕ ਘੋੜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "जल के अस्व अस्व इक जायो ॥",
      "sourceLineId": "119033",
      "sourceShabadId": "10946",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੋ ਬਾਗਾ ਰਾਜੇ ਕੇ ਆਯੋ ॥",
      "transliteration": "so baagaa raaje ke aayo ||",
      "translation": "There was one (humanoid) horse, which was of good breed, it came near Raja.",
      "punjabiViakhya": "ਉਹ ਰਾਜੇ ਦਾ ਚੋਗ਼ਾ ਲੈ ਕੇ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "सो बागा राजे के आयो ॥",
      "sourceLineId": "119034",
      "sourceShabadId": "10946",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚਰਵੇਦਾਰ ਤਾਹਿ ਲੈ ਗਯੋ ॥",
      "transliteration": "charavedhaar taeh lai gayo ||",
      "translation": "",
      "punjabiViakhya": "ਚਰਵਾਹੇ ਉਸ ਨੂੰ ਉਥੇ (ਰਾਜ ਮਹੱਲ ਵਿਚ) ਲੈ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "चरवेदार ताहि लै गयो ॥",
      "sourceLineId": "119035",
      "sourceShabadId": "10946",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭੇਦ ਰਾਨਿਯਨ ਕੌ ਲੈ ਦਯੋ ॥੧੨॥",
      "transliteration": "bhedh raaniyan kau lai dhayo ||12||",
      "translation": "He took the Raja’s one garment and disclosed everything to the Ranis.(12)",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀਆਂ ਨੂੰ ਰਾਜੇ ਦੀ ਸਥਿਤੀ ਦਾ ਭੇਦ ਦਸ ਦਿੱਤਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "भेद रानियन कौ लै दयो ॥१२॥",
      "sourceLineId": "119036",
      "sourceShabadId": "10946",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "119037",
      "sourceShabadId": "10947",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕੁੰਕਮ ਦੇ ਘਨਸਾਰ ਦੇ ਯੌ ਸ੍ਰਵਨਨ ਸੁਨਿ ਪਾਇ ॥",
      "transliteration": "ku(n)kam dhe ghanasaar dhe yau sravanan sun pai ||",
      "translation": "Kookum and Ghansaar, both the Ranis, when heard this,",
      "punjabiViakhya": "ਕੁੰਕਮ ਦੇਵੀ ਅਤੇ ਘਨਸਾਰ ਦੇਵੀ ਨੇ (ਸਾਰੀ ਗੱਲ) ਕੰਨਾ ਨਾਲ ਸੁਣ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "कुँकम दे घनसार दे यौ स्रवनन सुनि पाइ ॥",
      "sourceLineId": "119038",
      "sourceShabadId": "10947",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਤੋ ਬੈਠਿ ਦੁਹੂੰਅਨ ਕਿਯੋ ਜੂਝਿ ਮਰਨ ਕੇ ਭਾਇ ॥੧੩॥",
      "transliteration": "mato baiTh dhuhoo(n)an kiyo joojh maran ke bhai ||13||",
      "translation": "They both decided to kill themselves fighting.(13)",
      "punjabiViakhya": "ਦੋਹਾ ਨੇ ਲੜਾਈ ਵਿਚ ਜੂਝ ਮਰਨ ਦਾ ਮਤਾ ਪਕਾਇਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "मतो बैठि दुहूँअन कियो जूझि मरन के भाइ ॥१३॥",
      "sourceLineId": "119039",
      "sourceShabadId": "10947",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੌ ਹਮਰੇ ਪਤਿ ਲਰਿ ਮਰੇ ਸਮੁਹ ਬਦਨ ਬ੍ਰਿਣ ਖਾਇ ॥",
      "transliteration": "jau hamare pat lar mare samuh badhan biran khai ||",
      "translation": "‘If our husband has succumbed to the injuries inflicted to his body,",
      "punjabiViakhya": "ਜੇ ਸਾਡਾ ਪਤੀ ਸਾਹਮਣੇ ਜ਼ਖ਼ਮ ਖਾ ਕੇ ਲੜ ਮਰਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "जौ हमरे पति लरि मरे समुह बदन बृण खाइ ॥",
      "sourceLineId": "119040",
      "sourceShabadId": "10947",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤੌ ਹਮ ਹੂੰ ਸਭ ਲਰਿ ਮਰੈ ਨਰ ਕੋ ਭੇਖ ਬਨਾਇ ॥੧੪॥",
      "transliteration": "tau ham hoo(n) sabh lar marai nar ko bhekh banai ||14||",
      "translation": "‘Then we all will die fighting disguised as men.’(14)",
      "punjabiViakhya": "ਤਾ ਅਸੀਂ ਵੀ ਮਰਦਾਵਾ ਭੇਸ ਬਣਾ ਕੇ ਲੜ ਮਰਾਗੀਆਂ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "तौ हम हूँ सभ लरि मरै नर को भेख बनाइ ॥१४॥",
      "sourceLineId": "119041",
      "sourceShabadId": "10947",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "119042",
      "sourceShabadId": "10948",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਯਹੈ ਮੰਤ੍ਰ ਸਭਹੂੰਨ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "yahai ma(n)tr sabhahoo(n)n bichaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਵਿਉਾਂਤ ਸਭ ਨੇ ਵਿਚਾਰੀ।",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "यहै मंत्र सभहूँन बिचारियो ॥",
      "sourceLineId": "119043",
      "sourceShabadId": "10948",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਭ ਹੂੰ ਭੇਖ ਪੁਰਖ ਕੋ ਧਾਰਿਯੋ ॥",
      "transliteration": "sabh hoo(n) bhekh purakh ko dhaariyo ||",
      "translation": "After scheming like this, they all disguised themselves as men,",
      "punjabiViakhya": "ਸਭ ਨੇ ਮਰਦਾਵਾ ਭੇਸ ਬਣਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "सभ हूँ भेख पुरख को धारियो ॥",
      "sourceLineId": "119044",
      "sourceShabadId": "10948",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਏਕ ਦਿਸਾ ਕੁੰਕਮ ਦੇ ਗਈ ॥",
      "transliteration": "ek dhisaa ku(n)kam dhe giee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਸ਼ਾ ਵਲ ਕੁੰਕਮ ਦੇਈ ਚਲੀ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "एक दिसा कुँकम दे गई ॥",
      "sourceLineId": "119045",
      "sourceShabadId": "10948",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦੇ ਘਨਸਾਰ ਦੂਜ ਦਿਸਿ ਭਈ ॥੧੫॥",
      "transliteration": "dhe ghanasaar dhooj dhis bhiee ||15||",
      "translation": "And planned Kookum to raid from one side and ,Ghansaar from the other.(15)",
      "punjabiViakhya": "ਅਤੇ ਘਨਸਾਰ ਦੇਈ ਦੂਜੇ ਪਾਸੇ ਵਲ ਚਲ ਪਈ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "दे घनसार दूज दिसि भई ॥१५॥",
      "sourceLineId": "119046",
      "sourceShabadId": "10948",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "119047",
      "sourceShabadId": "10949",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕੁੰਕਮ ਦੇ ਘਨਸਾਰ ਦੇ ਦੋਊ ਅਨੀ ਬਨਾਇ ॥",
      "transliteration": "ku(n)kam dhe ghanasaar dhe dhouoo anee banai ||",
      "translation": "They all agreed to the plan and all of them put the clothes of men.",
      "punjabiViakhya": "ਕੁੰਕਮ ਦੇਈ ਅਤੇ ਘਨਸਾਰ ਦੇਈ ਨੇ ਆਪਣੀ ਸੈਨਾ ਤਿਆਰ ਕਰ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "कुँकम दे घनसार दे दोऊ अनी बनाइ ॥",
      "sourceLineId": "119048",
      "sourceShabadId": "10949",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦੁਹੂੰ ਓਰ ਠਾਢੀ ਭਈ ਜੁਧ ਕਰਨ ਕੇ ਭਾਇ ॥੧੬॥",
      "transliteration": "dhuhoo(n) or Thaaddee bhiee judh karan ke bhai ||16||",
      "translation": "From one side Kookum started and from the other Ghansaar.(l6)",
      "punjabiViakhya": "ਯੁੱਧ ਕਰਨ ਲਈ ਦੋਹਾ ਪਾਸਿਆਂ ਤੇ ਡਟ ਗਈਆਂ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "दुहूँ ओर ठाढी भई जुध करन के भाइ ॥१६॥",
      "sourceLineId": "119049",
      "sourceShabadId": "10949",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0981_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 981,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "119050",
      "sourceShabadId": "10950",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
