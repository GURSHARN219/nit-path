{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 994,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0994_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤੁਰਤੁ ਏਕ ਤਹ ਸਖੀ ਪਠਾਈ ॥੧੭॥",
      "transliteration": "turat ek teh sakhee paThaiee ||17||",
      "translation": "soon reached the place (of Sahiban.(17)",
      "punjabiViakhya": "ਤਾ ਝਟ ਇਕ ਸਖੀ ਉਸ ਪਾਸ ਭੇਜ ਦਿੱਤੀ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "तुरतु एक तह सखी पठाई ॥१७॥",
      "sourceLineId": "119675",
      "sourceShabadId": "11037",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "119676",
      "sourceShabadId": "11038",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੁਨੋ ਮਿਤ੍ਰ ਬਿਨੁ ਨਿਸਿ ਭਈ ਹ੍ਯਾਂ ਨ ਪਹੂਚਹੁ ਆਇ ॥",
      "transliteration": "suno mitr bin nis bhiee hayaa(n) na pahoochahu aai ||",
      "translation": "‘Listen my friend; don’t come here before the night falls.",
      "punjabiViakhya": "ਹੇ ਮਿਤਰ! ਰਾਤ ਪਏ ਬਿਨਾ ਇਥੇ ਨਹੀਂ ਆਉਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "सुनो मित्र बिनु निसि भई ह्याँ न पहूचहु आइ ॥",
      "sourceLineId": "119677",
      "sourceShabadId": "11038",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਿਨ ਕੋਊ ਸੋਧਿ ਪਛਾਨਿ ਕੈ ਤਿਨ ਪ੍ਰਤਿ ਕਹੈ ਨ ਜਾਇ ॥੧੮॥",
      "transliteration": "jin kouoo sodh pachhaan kai tin prat kahai na jai ||18||",
      "translation": "‘Some body may recognise you and may go to tell my parents.(18)",
      "punjabiViakhya": "ਕਿਤੇ ਕੋਈ ਤੈਨੂੰ ਲਭ ਕੇ ਅਤੇ ਪਛਾਣ ਕੇ ਉਨ੍ਰਹਾ (ਮਾਪਿਆਂ ਜਾ ਬਰਾਤੀਆਂ) ਨੂੰ ਜਾ ਕੇ ਨਾ ਕਹਿ ਦੇਵੇ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "जिन कोऊ सोधि पछानि कै तिन प्रति कहै न जाइ ॥१८॥",
      "sourceLineId": "119678",
      "sourceShabadId": "11038",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "119679",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਹੁਰਿ ਸਖੀ ਤਿਹ ਆਨਿ ਜਤਾਯੋ ॥",
      "transliteration": "bahur sakhee teh aan jataayo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਸਖੀ ਨੇ ਆ ਕੇ ਉਸ ਨੂੰ ਸਮਝਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "बहुरि सखी तिह आनि जतायो ॥",
      "sourceLineId": "119680",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬੈਠਿ ਬਾਗ ਮੈ ਦਿਵਸ ਬਿਤਾਯੋ ॥",
      "transliteration": "baiTh baag mai dhivas bitaayo ||",
      "translation": "The friend came, made him to understand and then by sitting in the garden, he spent the day.",
      "punjabiViakhya": "ਉਸ ਨੇ ਬਾਗ਼ ਵਿਚ ਬੈਠ ਕੇ ਦਿਨ ਗੁਜ਼ਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "बैठि बाग मै दिवस बितायो ॥",
      "sourceLineId": "119681",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੂਰਜ ਛਪਿਯੋ ਰੈਨਿ ਜਬ ਭਈ ॥",
      "transliteration": "sooraj chhapiyo rain jab bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਸੂਰਜ ਡੁਬਿਆ ਅਤੇ ਰਾਤ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "सूरज छपियो रैनि जब भई ॥",
      "sourceLineId": "119682",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਾਟ ਗਾਵ ਤਾ ਕੇ ਕੀ ਲਈ ॥੧੯॥",
      "transliteration": "baaT gaav taa ke kee liee ||19||",
      "translation": "When the Sun was set, it became dark, he took to his way to her village.(19)",
      "punjabiViakhya": "ਤਾ ਉਸ ਸਾਹਿਬਾ ਦੇ ਪਿੰਡ ਦਾ ਰਾਹ ਫੜਿਆ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "बाट गाव ता के की लई ॥१९॥",
      "sourceLineId": "119683",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰੈਨਿ ਭਈ ਤਾ ਕੇ ਤਬ ਗਯੋ ॥",
      "transliteration": "rain bhiee taa ke tab gayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਪਈ, ਤਾ ਸਾਹਿਬਾ ਕੋਲ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "रैनि भई ता के तब गयो ॥",
      "sourceLineId": "119684",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਡਾਰਤ ਬਾਜ ਪ੍ਰਿਸਟਿ ਤਿਹ ਭਯੋ ॥",
      "transliteration": "ddaarat baaj pirasaT teh bhayo ||",
      "translation": "When it was total dark, he went to her and took her on the back of his horse.",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਘੋੜੇ ਦੀ ਪਿਠ ਉਤੇ ਚੜ੍ਰਹਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "डारत बाज पृसटि तिह भयो ॥",
      "sourceLineId": "119685",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਰਿ ਤਾ ਕੋ ਦੇਸੌਰ ਸਿਧਾਰਿਯੋ ॥",
      "transliteration": "har taa ko dhesauar sidhaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਹਰ ਕੇ ਆਪਣੇ ਦੇਸ ਵਲ ਚਲ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "हरि ता को देसौर सिधारियो ॥",
      "sourceLineId": "119686",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੋ ਪਹੁਚਿਯੋ ਤਾ ਕੋ ਸਰ ਮਾਰਿਯੋ ॥੨੦॥",
      "transliteration": "jo pahuchiyo taa ko sar maariyo ||20||",
      "translation": "After taking her away he started to go to another country and who so ever followed he killed him with the arrows.(20)",
      "punjabiViakhya": "ਜੋ ਵੀ (ਪਿਛਾ ਕਰ ਕੇ) ਪਹੁੰਚਿਆ, ਉਸ ਨੂੰ ਤੀਰ ਮਾਰ ਦਿੱਤਾ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "जो पहुचियो ता को सर मारियो ॥२०॥",
      "sourceLineId": "119687",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰੈਨਿ ਸਕਲ ਤਾ ਕੋ ਲੈ ਗਯੋ ॥",
      "transliteration": "rain sakal taa ko lai gayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਉਸ ਨੂੰ ਲੈ ਜਾ ਕੇ ਸਾਰੀ ਰਾਤ (ਘੋੜੇ ਉਤੇ ਚੜ੍ਰਹਾਈ ਰਖਿਆ)",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "रैनि सकल ता को लै गयो ॥",
      "sourceLineId": "119688",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਉਤਰਤ ਚੜੇ ਦਿਵਸ ਕੇ ਭਯੋ ॥",
      "transliteration": "autarat chaRe dhivas ke bhayo ||",
      "translation": "He kept on travelling whole night and when day broke he dismounted.",
      "punjabiViakhya": "ਅਤੇ ਦਿਨ ਦੇ ਚੜ੍ਰਹਨ ਤੇ ਉਤਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "उतरत चड़े दिवस के भयो ॥",
      "sourceLineId": "119689",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਥੋ ਸੁ ਕੁਮਾਰ ਅਧਿਕ ਤਨ ਹਾਰਿਯੋ ॥",
      "transliteration": "tho su kumaar adhik tan haariyo ||",
      "translation": "Himself he was tired and he was carrying with him Sahiban as well,",
      "punjabiViakhya": "ਅਜੇ ਸੋਹਲ ਨੌਜਵਾਨ ਸੀ, ਇਸ ਲਈ ਸ਼ਰੀਰ ਬਹੁਤ ਥਕ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "थो सु कुमार अधिक तन हारियो ॥",
      "sourceLineId": "119690",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਔਰ ਸਾਹਿਬਾ ਸਾਥ ਬਿਹਾਰਿਯੋ ॥੨੧॥",
      "transliteration": "aauar saahibaa saath bihaariyo ||21||",
      "translation": "He felt exhausted and went to sleep and, on the other side, her all the relatives realised.(21)",
      "punjabiViakhya": "ਅਤੇ ਸਾਹਿਬਾ ਨਾਲ ਵੀ ਪ੍ਰੇਮ ਕਰਨ ਲਗਾ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "और साहिबा साथ बिहारियो ॥२१॥",
      "sourceLineId": "119691",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸ੍ਰਮਤ ਭਯੋ ਤਹ ਕਛੁ ਸ੍ਵੈ ਰਹਿਯੋ ॥",
      "transliteration": "sramat bhayo teh kachh savai rahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਥਕ ਜਾਣ ਕਰ ਕੇ ਕੁਝ ਸੌਂ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "स्रमत भयो तह कछु स्वै रहियो ॥",
      "sourceLineId": "119692",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਬ ਲੌ ਸਭ ਸਮਧਿਨ ਸੁਨਿ ਲਯੋ ॥",
      "transliteration": "tab lau sabh samadhin sun layo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ (ਸਾਹਿਬਾ ਦੇ) ਸਾਰੇ ਸੰਬੰਧੀਆਂ ਨੇ ਸੁਣ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "तब लौ सभ समधिन सुनि लयो ॥",
      "sourceLineId": "119693",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚੜੇ ਤੁਰੈ ਸਭ ਸੂਰ ਰਿਸਾਏ ॥",
      "transliteration": "chaRe turai sabh soor risaae ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਸੂਰਮੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਘੋੜਿਆਂ ਉਤੇ ਚੜ੍ਰਹ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "चड़े तुरै सभ सूर रिसाए ॥",
      "sourceLineId": "119694",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਾਧੇ ਗੋਲ ਤਹਾ ਕਹ ਧਾਏ ॥੨੨॥",
      "transliteration": "baadhe gol tahaa keh dhaae ||22||",
      "translation": "Infuriated, they set up teams and marched tOwards that direction.(22)",
      "punjabiViakhya": "ਦਲ ਬਣਾ ਕੇ ਉਧਰ ਵਲ ਤੁਰ ਪਏ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "बाधे गोल तहा कह धाए ॥२२॥",
      "sourceLineId": "119695",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਬ ਸਾਹਿਬਾ ਦ੍ਰਿਗ ਛੋਰਿ ਨਿਹਾਰਾ ॥",
      "transliteration": "tab saahibaa dhirag chhor nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਸਾਹਿਬਾ ਨੇ ਅੱਖ ਖੋਲ੍ਰਹ ਕੇ ਤਕਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "तब साहिबा दृग छोरि निहारा ॥",
      "sourceLineId": "119696",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹੇਰੈ ਚਹੂੰ ਓਰ ਅਸਵਾਰਾ ॥",
      "transliteration": "herai chahoo(n) or asavaaraa ||",
      "translation": "When Sahiban opened her eyes, she saw the riders on all sides.",
      "punjabiViakhya": "ਤਾ ਚੌਹਾ ਪਾਸੇ ਸਵਾਰ ਵੇਖੇ।",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "हेरै चहूँ ओर असवारा ॥",
      "sourceLineId": "119697",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੰਗ ਭਾਈ ਦੋਊ ਤਾਹਿ ਨਿਹਾਰੇ ॥",
      "transliteration": "sa(n)g bhaiee dhouoo taeh nihaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨਾਲ ਆਪਣੇ ਦੋ ਭਰਾ ਵੀ ਵੇਖੇ",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "संग भाई दोऊ ताहि निहारे ॥",
      "sourceLineId": "119698",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਰੁਣਾ ਬਹੇ ਨੈਨ ਕਜਰਾਰੇ ॥੨੩॥",
      "transliteration": "karunaa bahe nain kajaraare ||23||",
      "translation": "With them, when she saw her two brothers, she could not help her tears.(23)",
      "punjabiViakhya": "ਅਤੇ ਕਰੁਣਾ ਕਰ ਕੇ ਕਜਲਾਖੀਆਂ ਅੱਖਾ ਵਗ ਪਈਆਂ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "करुणा बहे नैन कजरारे ॥२३॥",
      "sourceLineId": "119699",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੌ ਹਮਰੇ ਪਤਿ ਇਨੇ ਨਿਹਰਿ ਹੈ ॥",
      "transliteration": "jau hamare pat ine nihar hai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਮੇਰਾ ਪਤੀ (ਮਿਰਜ਼ਾ) ਇਨ੍ਰਹਾ (ਦੋਹਾ ਭਰਾਵਾ) ਨੂੰ ਵੇਖੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "जौ हमरे पति इने निहरि है ॥",
      "sourceLineId": "119700",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੁਹੂੰ ਬਾਨ ਦੁਹੂਅਨੰ ਕਹ ਹਰਿ ਹੈ ॥",
      "transliteration": "dhuhoo(n) baan dhuhooana(n) keh har hai ||",
      "translation": "‘If my husband saw them, he will kill them both with two arrows.",
      "punjabiViakhya": "ਤਾ ਦੋ ਬਾਣਾ ਨਾਲ ਦੋਹਾ ਨੂੰ ਮਾਰ ਦੇਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "दुहूँ बान दुहूअनं कह हरि है ॥",
      "sourceLineId": "119701",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਾ ਤੇ ਕਛੂ ਜਤਨ ਅਬ ਕੀਜੈ ॥",
      "transliteration": "taa te kachhoo jatan ab keejai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਕੋਈ ਯਤਨ ਕਰਨਾ ਚਾਹੀਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "ता ते कछू जतन अब कीजै ॥",
      "sourceLineId": "119702",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਾ ਤੇ ਰਾਖਿ ਭਾਇਯਨ ਲੀਜੈ ॥੨੪॥",
      "transliteration": "jaa te raakh bhaiyan leejai ||24||",
      "translation": "‘Something must be done, so that my brothers are spared.’(24)",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਦੋਵੇਾਂ ਭਰਾ ਬਚਾਏ ਜਾ ਸਕਣ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "जा ते राखि भाइयन लीजै ॥२४॥",
      "sourceLineId": "119703",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੋਵਤ ਹੁਤੋ ਮੀਤ ਨ ਜਗਾਯੋ ॥",
      "transliteration": "sovat huto meet na jagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਸੁੱਤੇ ਹੋਏ ਮਿਤਰ (ਮਿਰਜ਼ੇ) ਨੂੰ ਨਾ ਜਗਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "सोवत हुतो मीत न जगायो ॥",
      "sourceLineId": "119704",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਾਡ ਭਏ ਤਰਕਸ ਅਟਕਾਯੋ ॥",
      "transliteration": "jaadd bhe tarakas aTakaayo ||",
      "translation": "She did not wake her friend up but took his quiver and hung it Over the tree.",
      "punjabiViakhya": "ਅਤੇ ਜੰਡ ਨਾਲ ਤਰਕਸ (ਭੱਥਾ) ਟੰਗ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "जाड भए तरकस अटकायो ॥",
      "sourceLineId": "119705",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਔਰ ਸਸਤ੍ਰ ਲੈ ਕਹੂੰ ਦੁਰਾਏ ॥",
      "transliteration": "aauar sasatr lai kahoo(n) dhuraae ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ ਸ਼ਸਤ੍ਰਾ ਨੂੰ ਵੀ ਲੈ ਕੇ ਕਿਤੇ ਲੁਕਾ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "और ससत्र लै कहूँ दुराए ॥",
      "sourceLineId": "119706",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਖੋਜੇ ਹੁਤੇ ਜਾਤ ਨਹਿ ਪਾਏ ॥੨੫॥",
      "transliteration": "khoje hute jaat neh paae ||25||",
      "translation": "Also she hid away his other weapons so that he could not find them.(25)",
      "punjabiViakhya": "ਖੋਜਣ ਤੇ ਵੀ ਲਭੇ ਨਹੀਂ ਜਾ ਸਕਦੇ ਸਨ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "खोजे हुते जात नहि पाए ॥२५॥",
      "sourceLineId": "119707",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਬ ਲੌ ਆਇ ਸੂਰ ਸਭ ਗਏ ॥",
      "transliteration": "tab lau aai soor sabh ge ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਸਾਰੇ ਸੂਰਮੇ ਆ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "तब लौ आइ सूर सभ गए ॥",
      "sourceLineId": "119708",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਾਰੋ ਮਾਰ ਪੁਕਾਰਤ ਭਏ ॥",
      "transliteration": "maaro maar pukaarat bhe ||",
      "translation": "In the meantime, all the gallant ones came and shoUted ‘kill him, kill him’.",
      "punjabiViakhya": "ਅਤੇ ਮਾਰੋ-ਮਾਰੋ ਪੁਕਾਰਨ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "मारो मार पुकारत भए ॥",
      "sourceLineId": "119709",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਬ ਮਿਰਜਾ ਜੂ ਨੈਨ ਉਘਾਰੇ ॥",
      "transliteration": "tab mirajaa joo nain ughaare ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਮਿਰਜ਼ੇ ਨੇ ਅੱਖਾ ਖੋਲ੍ਰਹੀਆਂ (ਅਤੇ ਕਹਿਣਾ ਲਗਾ)",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "तब मिरजा जू नैन उघारे ॥",
      "sourceLineId": "119710",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਹਾ ਗਏ ਹਥਿਯਾਰ ਹਮਾਰੇ ॥੨੬॥",
      "transliteration": "kahaa ge hathiyaar hamaare ||26||",
      "translation": "Then Mirza opened his eyes and asked where were his weapons.(26)",
      "punjabiViakhya": "ਮੇਰੇ ਹਥਿਆਰ ਕਿਥੇ ਗਏ ਹਨ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "कहा गए हथियार हमारे ॥२६॥",
      "sourceLineId": "119711",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭੌਡੀ ਰਾਡ ਕਹਿਯੋ ਕ੍ਯਾ ਕਰਿਯੋ ॥",
      "transliteration": "bhauaddee raadd kahiyo kayaa kariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਹਿਣ ਲਗਾ, ਹੇ ਨੀਚ ਔਰਤ! (ਇਹ ਤੂੰ) ਕੀ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "भौडी राड कहियो क्या करियो ॥",
      "sourceLineId": "119712",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਰਕਸ ਟਾਗਿ ਜਾਡ ਪੈ ਧਰਿਯੋ ॥",
      "transliteration": "tarakas Taag jaadd pai dhariyo ||",
      "translation": "‘Oh, you the mean woman, why have you. done this and hung my quiver on the tree?",
      "punjabiViakhya": "(ਤੂੰ ਮੇਰਾ) ਤਰਕਸ ਜੰਡ ਨਾਲ ਟੰਗ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "तरकस टागि जाड पै धरियो ॥",
      "sourceLineId": "119713",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪਹੁਚੇ ਆਨਿ ਪਖਰਿਯਾ ਭਾਰੇ ॥",
      "transliteration": "pahuche aan pakhariyaa bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਤਕੜੇ ਘੋੜ-ਸਵਾਰ ਆਣ ਪਹੁੰਚੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "पहुचे आनि पखरिया भारे ॥",
      "sourceLineId": "119714",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਹਾ ਧਰੇ ਤੇ ਸਸਤ੍ਰ ਹਮਾਰੇ ॥੨੭॥",
      "transliteration": "kahaa dhare te sasatr hamaare ||27||",
      "translation": "‘The riders have come nearer, where have you put my weapons?(27)",
      "punjabiViakhya": "ਤੂੰ ਮੇਰੇ ਹਥਿਆਰ ਕਿਥੇ ਧਰ ਦਿੱਤੇ ਹਨ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "कहा धरे ते ससत्र हमारे ॥२७॥",
      "sourceLineId": "119715",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਸਤ੍ਰਨ ਬਿਨਾ ਕਹੋ ਕਿਹ ਮਾਰੋ ॥",
      "transliteration": "sasatran binaa kaho keh maaro ||",
      "translation": "",
      "punjabiViakhya": "ਹਥਿਆਰਾ ਤੋਂ ਬਿਨਾ (ਮੈਨੂੰ) ਦਸ ਕਿ (ਮੈਂ) ਕਿਵੇਾਂ ਮਾਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "ससत्रन बिना कहो किह मारो ॥",
      "sourceLineId": "119716",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਹੁ ਨਾਰੀ ਕ੍ਯਾ ਮੰਤ੍ਰ ਬਿਚਾਰੋ ॥",
      "transliteration": "kahu naaree kayaa ma(n)tr bichaaro ||",
      "translation": "‘Say something woman, withoUt weapons, how can kill them?",
      "punjabiViakhya": "ਅਤੇ ਹੇ ਇਸਤਰੀ! ਕੀ ਵਿਚਾਰ ਕਰਾ?",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "कहु नारी क्या मंत्र बिचारो ॥",
      "sourceLineId": "119717",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਾਥੀ ਕੋਊ ਸੰਗ ਮੈ ਨਾਹੀ ॥",
      "transliteration": "saathee kouoo sa(n)g mai naahee ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਨਾਲ ਮੇਰਾ ਕੋਈ ਸਾਥੀ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "साथी कोऊ संग मै नाही ॥",
      "sourceLineId": "119718",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚਿੰਤਾ ਅਧਿਕ ਇਹੈ ਚਿਤ ਮਾਹੀ ॥੨੮॥",
      "transliteration": "chi(n)taa adhik ihai chit maahee ||28||",
      "translation": "‘Afraid, I have no friend of mine with me.’(28)",
      "punjabiViakhya": "ਇਹੀ (ਮੇਰੇ) ਮਨ ਵਿਚ ਵੱਡੀ ਚਿੰਤਾ ਹੈ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "चिंता अधिक इहै चित माही ॥२८॥",
      "sourceLineId": "119719",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹੇਰ ਰਹਿਯੋ ਆਯੁਧ ਨਹਿ ਪਾਏ ॥",
      "transliteration": "her rahiyo aayudh neh paae ||",
      "translation": "",
      "punjabiViakhya": "ਲਭ ਥਕਿਆ, (ਪਰ ਕਿਤੇ) ਹਥਿਆਰ ਨਹੀਂ ਮਿਲੇ।",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "हेर रहियो आयुध नहि पाए ॥",
      "sourceLineId": "119720",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਬ ਲਗ ਘੇਰ ਦੁਬਹਿਯਾ ਆਏ ॥",
      "transliteration": "tab lag gher dhubahiyaa aae ||",
      "translation": "In spite of searching hard, he could not find his weapons;",
      "punjabiViakhya": "ਤਦ ਤਕ ਸਵਾਰਾ ਨੇ ਘੇਰਾ ਪਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "तब लग घेर दुबहिया आए ॥",
      "sourceLineId": "119721",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0994_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤ੍ਰਿਯ ਕੋ ਬਾਜ ਪ੍ਰਿਸਟਿ ਪਰ ਡਾਰਿਯੋ ॥",
      "transliteration": "tiray ko baaj pirasaT par ddaariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ ਭਰਾ ਨੇ) ਇਸਤਰੀ ਨੂੰ ਘੋੜੇ ਦੀ ਪਿਠ ਉਤੇ ਸੁਟਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 994,
      "hindi": "",
      "hindiTransliteration": "तृय को बाज पृसटि पर डारियो ॥",
      "sourceLineId": "119722",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
