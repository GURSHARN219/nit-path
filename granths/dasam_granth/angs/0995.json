{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 995,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0995_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਗਰ ਆਪਨੇ ਓਰ ਸਿਧਾਰਿਯੋ ॥੨੯॥",
      "transliteration": "nagar aapane or sidhaariyo ||29||",
      "translation": "in the meantime they had surrounded him.(29)",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਨਗਰ ਵਲ ਚਲ ਪਿਆ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "नगर आपने ओर सिधारियो ॥२९॥",
      "sourceLineId": "119723",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਿਨੁ ਆਯੁਧ ਭਜਿ ਚਲਿਯੋ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "bin aayudh bhaj chaliyo nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਨਾ ਹਥਿਆਰਾ ਦੇ ਮਿਰਜ਼ੇ ਨੂੰ ਭਜਿਆ ਜਾਦਾ (ਸਾਰਿਆ ਨੇ) ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "बिनु आयुध भजि चलियो निहारियो ॥",
      "sourceLineId": "119724",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਿਰਭੈ ਹ੍ਵੈ ਸਭਹੂੰਨ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "nirabhai havai sabhahoo(n)n bichaariyo ||",
      "translation": "They had intended to put the woman on the saddle of a horse",
      "punjabiViakhya": "ਸਭ ਨੇ ਨਿਰਭੈ ਹੋ ਕੇ ਵਿਚਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "निरभै ह्वै सभहूँन बिचारियो ॥",
      "sourceLineId": "119725",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਨ ਦੁਹੂੰਅਨ ਕੌ ਜਾਨ ਨ ਦੈਹੌ ॥",
      "transliteration": "ein dhuhoo(n)an kau jaan na dhaihau ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਦੋਹਾ ਨੂੰ ਅਜ ਜਾਣ ਨਹੀਂ ਦੇਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "इन दुहूँअन कौ जान न दैहौ ॥",
      "sourceLineId": "119726",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਯਾ ਕੌ ਮਾਰਿ ਆਜੁ ਹੀ ਲੈਹੈ ॥੩੦॥",
      "transliteration": "yaa kau maar aaj hee laihai ||30||",
      "translation": "and ran away to the town.(30)",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਨੂੰ ਅਜ ਹੀ ਮਾਰ ਲਵਾਗੇ ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "या कौ मारि आजु ही लैहै ॥३०॥",
      "sourceLineId": "119727",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕੋਊ ਪਕਰਿ ਸੈਹਥੀ ਧਾਯੋ ॥",
      "transliteration": "kouoo pakar saihathee dhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਕੋਈ ਸੈਹੱਥੀ ਲੈ ਕੇ ਪਿਛੇ ਲਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "कोऊ पकरि सैहथी धायो ॥",
      "sourceLineId": "119728",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਿਨੂੰ ਕਾਢਿ ਕਰ ਖੜਗ ਨਚਾਯੋ ॥",
      "transliteration": "kinoo(n) kaadd kar khaRag nachaayo ||",
      "translation": "Some raided with daggers and some brandished swords.",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਤਲਵਾਰ ਖਿਚ ਕੇ ਘੁੰਮਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "किनूँ काढि कर खड़ग नचायो ॥",
      "sourceLineId": "119729",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਿਨੂੰ ਮਾਰਿ ਬਾਨਨ ਕੀ ਕਰੀ ॥",
      "transliteration": "kinoo(n) maar baanan kee karee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਤੀਰਾ ਦੀ ਮਾਰ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "किनूँ मारि बानन की करी ॥",
      "sourceLineId": "119730",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪਾਗ ਉਤਰਿ ਮਿਰਜਾ ਕੀ ਪਰੀ ॥੩੧॥",
      "transliteration": "paag utar mirajaa kee paree ||31||",
      "translation": "Some shot arrows and Mirza’s turban was toppled over.(31)",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਮਿਰਜ਼ੇ ਦੀ ਪਗ ਉਤਰ ਕੇ ਡਿਗ ਪਈ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "पाग उतरि मिरजा की परी ॥३१॥",
      "sourceLineId": "119731",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪਾਗ ਉਤਰਿ ਤਾ ਕੀ ਜਬ ਗਈ ॥",
      "transliteration": "paag utar taa kee jab giee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਦੀ ਪਗੜੀ ਉਤਰ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "पाग उतरि ता की जब गई ॥",
      "sourceLineId": "119732",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮੂੰਡੀ ਹੋਤਿ ਨਾਗ ਤਿਹ ਭਈ ॥",
      "transliteration": "moo(n)ddee hot naag teh bhiee ||",
      "translation": "With turban off, his head became bare,",
      "punjabiViakhya": "ਤਾ ਉਸ ਦਾ ਸਿਰ ਨੰਗਾ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "मूँडी होति नाग तिह भई ॥",
      "sourceLineId": "119733",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੁੰਦਰ ਅਧਿਕ ਕੇਸ ਤਿਹ ਛੂਟੇ ॥",
      "transliteration": "su(n)dhar adhik kes teh chhooTe ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਬਹੁਤ ਸੁੰਦਰ ਵਾਲ ਖਿਲਰ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "सुँदर अधिक केस तिह छूटे ॥",
      "sourceLineId": "119734",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਬ ਹੀ ਸੂਰ ਜੁਧ ਕਹ ਜੂਟੇ ॥੩੨॥",
      "transliteration": "jab hee soor judh keh jooTe ||32||",
      "translation": "And his beaUtiful hair flared when the raiders started the fight.(32)",
      "punjabiViakhya": "ਜਦੋਂ ਉਸ ਨਾਲ ਸੂਰਮੇ ਯੁੱਧ ਕਰਨ ਲਈ ਜੁਟੇ ॥੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "जब ही सूर जुध कह जूटे ॥३२॥",
      "sourceLineId": "119735",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਿਨੀ ਬਿਸਿਖ ਕਸਿ ਤਾਹਿ ਪ੍ਰਹਾਰਿਯੋ ॥",
      "transliteration": "kinee bisikh kas taeh prahaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ (ਉਸ ਨੂੰ) ਬਾਣ ਕਸ ਕੇ ਮਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "किनी बिसिख कसि ताहि प्रहारियो ॥",
      "sourceLineId": "119736",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਿਨਹੂੰ ਖੜਗ ਕਾਢਿ ਤਿਹ ਮਾਰਿਯੋ ॥",
      "transliteration": "kinahoo(n) khaRag kaadd teh maariyo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਖੜਗ ਕਢ ਕੇ ਉਸ ਨੂੰ ਮਾਰੀ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "किनहूँ खड़ग काढि तिह मारियो ॥",
      "sourceLineId": "119737",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਿਨਹੂੰ ਵਾਰਿ ਗੁਰਜ ਕੋ ਕੀਨੋ ॥",
      "transliteration": "kinahoo(n) vaar guraj ko keeno ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਗੁਰਜ ਦਾ ਵਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "किनहूँ वारि गुरज को कीनो ॥",
      "sourceLineId": "119738",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਖੇਤ ਮਾਰਿ ਮਿਰਜਾ ਕੌ ਲੀਨੋ ॥੩੩॥",
      "transliteration": "khet maar mirajaa kau leeno ||33||",
      "translation": "",
      "punjabiViakhya": "ਮਿਰਜ਼ੇ ਨੂੰ ਰਣ ਖੇਤਰ ਵਿਚ ਹੀ ਮਾਰ ਦਿੱਤਾ ॥੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "खेत मारि मिरजा कौ लीनो ॥३३॥",
      "sourceLineId": "119739",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪ੍ਰਿਥਮ ਨਾਸ ਮਿਰਜਾ ਕੌ ਕਰਿਯੋ ॥",
      "transliteration": "piratham naas mirajaa kau kariyo ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਮਿਰਜ਼ੇ ਨੂੰ ਮਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "पृथम नास मिरजा कौ करियो ॥",
      "sourceLineId": "119740",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਹੁਰੌ ਜਾਇ ਸਾਹਿਬਹਿ ਧਰਿਯੋ ॥",
      "transliteration": "bahurau jai saahibeh dhariyo ||",
      "translation": "First they killed Mirza and then, some went and grasped Sahiban.",
      "punjabiViakhya": "ਫਿਰ ਜਾ ਕੇ ਸਾਹਿਬਾ ਨੂੰ ਧਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "बहुरौ जाइ साहिबहि धरियो ॥",
      "sourceLineId": "119741",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬੈਠੇ ਤਿਸੀ ਬਿਰਛ ਤਰ ਆਈ ॥",
      "transliteration": "baiThe tisee birachh tar aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਉਸ ਬ੍ਰਿਛ ਹੇਠਾ ਆ ਬੈਠੇ",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "बैठे तिसी बिरछ तर आई ॥",
      "sourceLineId": "119742",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਹ ਤਿਨ ਦੁਹੂੰਅਨ ਰੈਨਿ ਬਿਤਾਈ ॥੩੪॥",
      "transliteration": "jeh tin dhuhoo(n)an rain bitaiee ||34||",
      "translation": "She ran to the tree, under which they had spent the night.(34)",
      "punjabiViakhya": "ਜਿਥੇ ਉਨ੍ਰਹਾ ਦੋਹਾ ਨੇ ਰਾਤ ਬਤੀਤ ਕੀਤੀ ਸੀ ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "जह तिन दुहूँअन रैनि बिताई ॥३४॥",
      "sourceLineId": "119743",
      "sourceShabadId": "11039",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "119744",
      "sourceShabadId": "11040",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਮਰ ਭਰਾਤ ਕੇ ਕੀ ਤੁਰਤੁ ਜਮਧਰ ਲਈ ਨਿਕਾਰਿ ॥",
      "transliteration": "kamar bharaat ke kee turat jamadhar liee nikaar ||",
      "translation": "She withdrew the dagger from the waist of her brother,",
      "punjabiViakhya": "ਤਦ (ਉਸ ਨੇ) ਆਪਣੇ ਭਰਾ ਦੇ ਕਮਰਕੱਸੇ ਵਿਚੋਂ ਕਟਾਰ ਕਢ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "कमर भरात के की तुरतु जमधर लई निकारि ॥",
      "sourceLineId": "119745",
      "sourceShabadId": "11040",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਿਯੋ ਪਯਾਨੌ ਮੀਤ ਪਹਿ ਉਦਰ ਕਟਾਰੀ ਮਾਰ ॥੩੫॥",
      "transliteration": "kiyo payaanau meet peh udhar kaTaaree maar ||35||",
      "translation": "And thrust it into her own abdomen and fell near’the friend.(35)",
      "punjabiViakhya": "ਆਪਣੇ ਪੇਟ ਵਿਚ ਮਾਰ ਕੇ ਯਾਰ ਦੇ ਪਾਸ ਚਲੀ ਗਈ ॥੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "कियो पयानौ मीत पहि उदर कटारी मार ॥३५॥",
      "sourceLineId": "119746",
      "sourceShabadId": "11040",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "119747",
      "sourceShabadId": "11041",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪ੍ਰਥਮ ਮੀਤ ਤਹ ਤੇ ਨਿਕਰਾਯੋ ॥",
      "transliteration": "pratham meet teh te nikaraayo ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਉਥੋਂ (ਉਸ ਨੂੰ) ਮਿਤਰ ਨੂੰ ਕਢਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "प्रथम मीत तह ते निकरायो ॥",
      "sourceLineId": "119748",
      "sourceShabadId": "11041",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਹੁਰਿ ਬਿਰਛ ਤਰ ਆਨਿ ਸੁਵਾਯੋ ॥",
      "transliteration": "bahur birachh tar aan suvaayo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਬ੍ਰਿਛ ਦੇ ਹੇਠਾ ਆਣ ਸਵਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "बहुरि बिरछ तर आनि सुवायो ॥",
      "sourceLineId": "119749",
      "sourceShabadId": "11041",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭ੍ਰਾਤਨ ਮੋਹ ਬਹੁਰਿ ਲਖਿ ਕਿਯੋ ॥",
      "transliteration": "bhraatan moh bahur lakh kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਭਰਾਵਾ ਨੂੰ ਵੇਖ ਕੇ (ਉਨ੍ਰਹਾ ਦੇ) ਮੋਹ ਵਿਚ ਪੈ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "भ्रातन मोह बहुरि लखि कियो ॥",
      "sourceLineId": "119750",
      "sourceShabadId": "11041",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਸਤ੍ਰਨ ਟਾਗਿ ਜਾਡ ਪਰ ਦਿਯੋ ॥੩੬॥",
      "transliteration": "sasatran Taag jaadd par dhiyo ||36||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਸਤ੍ਰਾ ਨੂੰ ਜੰਡ ਉਤੇ ਟੰਗ ਦਿੱਤਾ ॥੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "ससत्रन टागि जाड पर दियो ॥३६॥",
      "sourceLineId": "119751",
      "sourceShabadId": "11041",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪ੍ਰਥਮੈ ਰੂਪ ਹੇਰਿ ਤਿਹ ਬਿਗਸੀ ॥",
      "transliteration": "prathamai roop her teh bigasee ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ (ਮਿਰਜ਼ੇ ਦਾ) ਰੂਪ ਵੇਖ ਕੇ ਆਨੰਦਿਤ ਹੋਈ",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "प्रथमै रूप हेरि तिह बिगसी ॥",
      "sourceLineId": "119752",
      "sourceShabadId": "11041",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਿਜੁ ਪਤਿ ਕੈ ਤਾ ਕੌ ਲੈ ਨਿਕਸੀ ॥",
      "transliteration": "nij pat kai taa kau lai nikasee ||",
      "translation": "First she had run away with the friend, then made him to sleep under the tree.",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਆਪਣਾ ਪਤੀ ਬਣਾ ਕੇ ਨਿਕਲ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "निजु पति कै ता कौ लै निकसी ॥",
      "sourceLineId": "119753",
      "sourceShabadId": "11041",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭ੍ਰਾਤਿਨ ਹੇਰਿ ਮੋਹ ਮਨ ਆਯੋ ॥",
      "transliteration": "bhraatin her moh man aayo ||",
      "translation": "",
      "punjabiViakhya": "ਭਰਾਵਾ ਨੂੰ ਵੇਖ ਕੇ ਮਨ ਵਿਚ ਮੋਹ ਜਾਗ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "भ्रातिन हेरि मोह मन आयो ॥",
      "sourceLineId": "119754",
      "sourceShabadId": "11041",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਿਜੁ ਪ੍ਰੀਤਮ ਕੋ ਨਾਸ ਕਰਾਯੋ ॥੩੭॥",
      "transliteration": "nij preetam ko naas karaayo ||37||",
      "translation": "Then she was over taken by the love for her brothers and got her lover annihilated.(37)",
      "punjabiViakhya": "ਆਪਣੇ ਪ੍ਰੀਤਮ ਦਾ ਨਾਸ਼ ਕਰਵਾ ਦਿੱਤਾ ॥੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "निजु प्रीतम को नास करायो ॥३७॥",
      "sourceLineId": "119755",
      "sourceShabadId": "11041",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਵਹ ਤ੍ਰਿਯ ਪੀਰ ਪਿਯਾ ਕੇ ਬਰੀ ॥",
      "transliteration": "veh tiray peer piyaa ke baree ||",
      "translation": "",
      "punjabiViakhya": "(ਪਹਿਲਾ) ਉਹ ਇਸਤਰੀ ਪ੍ਰੀਤਮ ਦੇ ਵਿਯੋਗ ਦੀ ਪੀੜ ਵਿਚ ਸੜੀ",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "वह तृय पीर पिया के बरी ॥",
      "sourceLineId": "119756",
      "sourceShabadId": "11041",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਪਹੁ ਮਾਰਿ ਕਟਾਰੀ ਮਰੀ ॥",
      "transliteration": "aapahu maar kaTaaree maree ||",
      "translation": "The woman, then, thought of her lover and killed herself with a dagger.",
      "punjabiViakhya": "ਅਤੇ ਆਪ ਕਟਾਰ ਮਾਰ ਕੇ ਮਰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "आपहु मारि कटारी मरी ॥",
      "sourceLineId": "119757",
      "sourceShabadId": "11041",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜੋ ਤ੍ਰਿਯ ਚਰਿਤ ਚਹੈ ਸੁ ਬਨਾਵੈ ॥",
      "transliteration": "jo tiray charit chahai su banaavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਜਿਸ ਤਰ੍ਰਹਾ ਚਾਹੇ ਚਰਿਤ੍ਰ ਬਣਾ ਲੈਂਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "जो तृय चरित चहै सु बनावै ॥",
      "sourceLineId": "119758",
      "sourceShabadId": "11041",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੇਵ ਅਦੇਵ ਭੇਵ ਨਹਿ ਪਾਵੈ ॥੩੮॥",
      "transliteration": "dhev adhev bhev neh paavai ||38||",
      "translation": "Whatever the way a woman desires, she beguiles and, not even the gods and devils can understand her strategy.(38)",
      "punjabiViakhya": "ਦੇਵਤੇ ਤੇ ਦੈਂਤ (ਇਸ ਦਾ) ਭੇਦ ਨਹੀਂ ਪਾ ਸਕਦੇ ਹਨ ॥੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "देव अदेव भेव नहि पावै ॥३८॥",
      "sourceLineId": "119759",
      "sourceShabadId": "11041",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "119760",
      "sourceShabadId": "11042",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪ੍ਰਥਮ ਤਹਾ ਤੇ ਕਾਢਿ ਕੈ ਪੁਨਿ ਨਿਜੁ ਮੀਤ ਹਨਾਇ ॥",
      "transliteration": "pratham tahaa te kaadd kai pun nij meet hanai ||",
      "translation": "First she had absconded and then got him killed,",
      "punjabiViakhya": "ਪਹਿਲਾ ਉਥੋਂ ਕਢ ਕੇ ਫਿਰ ਆਪਣੇ ਮਿਤਰ ਨੂੰ ਮਰਵਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "प्रथम तहा ते काढि कै पुनि निजु मीत हनाइ ॥",
      "sourceLineId": "119761",
      "sourceShabadId": "11042",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪੁਨਿ ਜਮਧਰ ਉਰ ਹਨਿ ਮਰੀ ਭ੍ਰਾਤ ਮੋਹ ਕੇ ਭਾਇ ॥੩੯॥",
      "transliteration": "pun jamadhar ur han maree bhraat moh ke bhai ||39||",
      "translation": "And, for sake of her love for her brothers, she killed herself with a dagger.(39)",
      "punjabiViakhya": "ਫਿਰ ਭਰਾਵਾ ਦੇ ਮੋਹ ਕਾਰਨ (ਆਪ) ਛਾਤੀ ਵਿਚ ਕਟਾਰ ਮਾਰ ਕੇ ਮਰ ਗਈ ॥੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "पुनि जमधर उर हनि मरी भ्रात मोह के भाइ ॥३९॥",
      "sourceLineId": "119762",
      "sourceShabadId": "11042",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭੂਤ ਭਵਿਖ ਭਵਾਨ ਮੈ ਸੁਨਿਯਤ ਸਦਾ ਬਨਾਇ ॥",
      "transliteration": "bhoot bhavikh bhavaan mai suniyat sadhaa banai ||",
      "translation": "This will remain prevalent in the present and the future that,",
      "punjabiViakhya": "ਭੂਤ, ਭਵਿਖਤ ਅਤੇ ਵਰਤਮਾਨ ਵਿਚ ਇਹ ਗੱਲਾ ਸੁਣੀਆਂ ਜਾਦੀਆਂ ਰਹਿਣਗੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "भूत भविख भवान मै सुनियत सदा बनाइ ॥",
      "sourceLineId": "119763",
      "sourceShabadId": "11042",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚਤੁਰਿ ਚਰਿਤ੍ਰਨ ਕੌ ਸਦਾ ਭੇਵ ਨ ਪਾਯੋ ਜਾਇ ॥੪੦॥",
      "transliteration": "chatur charitran kau sadhaa bhev na paayo jai ||40||",
      "translation": "The secrets of the delusions of a clever woman cannot be conceived.(40)(1)",
      "punjabiViakhya": "ਕਿ ਚਤੁਰ ਇਸਤਰੀ ਦੇ ਚਰਿਤ੍ਰਾ ਦਾ ਭੇਦ ਕਿਸੇ ਤੋਂ ਵੀ ਪਾਇਆ ਨਹੀਂ ਜਾ ਸਕਦਾ ॥੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "चतुरि चरित्रन कौ सदा भेव न पायो जाइ ॥४०॥",
      "sourceLineId": "119764",
      "sourceShabadId": "11042",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਉਨਤੀਸਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੨੯॥੨੫੬੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau unateesavo charitr samaapatam sat subham sat ||129||2563||afajoo(n)||",
      "translation": "129th Parable of Auspicious Chritars Conversation of the Raja and the Minister, Completed With Benediction. (129)(2561)",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਦੇ ਸੰਵਾਦ ਦੇ ੧੨੯ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੨੯॥੨੫੬੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ उनतीसवो चरित्र समापतम सतु सुभम सतु ॥१२९॥२५६३॥अफजूँ॥",
      "sourceLineId": "119765",
      "sourceShabadId": "11042",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "119766",
      "sourceShabadId": "11043",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੁਮਤਿ ਕੁਅਰਿ ਰਾਨੀ ਇਕ ਸੁਨੀ ॥",
      "transliteration": "sumat kuar raanee ik sunee ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਮਤਿ ਕੁਅਰਿ ਨਾ ਦੀ ਇਕ ਰਾਣੀ ਸੁਣੀਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "सुमति कुअरि रानी इक सुनी ॥",
      "sourceLineId": "119767",
      "sourceShabadId": "11043",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬੇਦ ਪੁਰਾਨ ਬਿਖੈ ਅਤਿ ਗੁਨੀ ॥",
      "transliteration": "bedh puraan bikhai at gunee ||",
      "translation": "There had been a Rani called Sumat Kumari who was adept in Vedas and Puranas.",
      "punjabiViakhya": "(ਉਹ) ਵੇਦਾ ਅਤੇ ਪੁਰਾਣਾ ਵਿਚ ਬਹੁਤ ਗੁੜ੍ਰਹੀ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "बेद पुरान बिखै अति गुनी ॥",
      "sourceLineId": "119768",
      "sourceShabadId": "11043",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਿਵ ਕੀ ਅਧਿਕ ਉਪਾਸਕ ਰਹੈ ॥",
      "transliteration": "siv kee adhik upaasak rahai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸ਼ਿਵ ਦੀ ਬਹੁਤ ਉਪਾਸ਼ਕ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 995,
      "hindi": "",
      "hindiTransliteration": "सिव की अधिक उपासक रहै ॥",
      "sourceLineId": "119769",
      "sourceShabadId": "11043",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0995_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਹਰ ਹਰ ਸਦਾ ਬਕਤ੍ਰ ਤੇ ਕਹੈ ॥੧॥",
      "transliteration": "har har sadhaa bakatr te kahai ||1||",
      "translation": "She worshipped god Shiva and all the time meditated on his name.(1)",
