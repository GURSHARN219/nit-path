{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 999,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_0999_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਾ ਪਰ ਏਕ ਤਵਾ ਕੌ ਡਾਰਿਯੋ ॥",
      "transliteration": "taa par ek tavaa kau ddaariyo ||",
      "translation": "In another cauldron, she asked her friend to sit in and covered it with an iron plate.",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਉਤੇ ਇਕ ਤਵਾ (ਢੱਕਣ) ਦੇ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "ता पर एक तवा कौ डारियो ॥",
      "sourceLineId": "119939",
      "sourceShabadId": "11062",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਖਨੀ ਲੈ ਘੇਇਯਾ ਤਿਹ ਕਰਿਯੋ ॥",
      "transliteration": "makhanee lai gheiyaa teh kariyo ||",
      "translation": "",
      "punjabiViakhya": "ਮੱਖਣ ਦੀ ਪਿੰਨੀ ਲੈ ਕੇ ਉਸ ਨੂੰ ਥਿੰਧਾ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "मखनी लै घेइया तिह करियो ॥",
      "sourceLineId": "119940",
      "sourceShabadId": "11062",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਪਤ ਮਿਟਾਇ ਤਵਨ ਪਰ ਧਰਿਯੋ ॥੧੪॥",
      "transliteration": "tapat miTai tavan par dhariyo ||14||",
      "translation": "She had laced it with butter and when cold, had put it on the top side.(14)",
      "punjabiViakhya": "ਤਪਸ਼ ਨੂੰ ਘਟਾ ਕੇ ਉਸ ਉਤੇ ਰਖ ਦਿੱਤਾ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "तपत मिटाइ तवन पर धरियो ॥१४॥",
      "sourceLineId": "119941",
      "sourceShabadId": "11062",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "119942",
      "sourceShabadId": "11063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਵਾ ਸੁ ਜਰਿ ਕੈ ਤਾਸੁ ਪੈ ਘੇਇਯਾ ਧਰਿਯੋ ਬਨਾਇ ॥",
      "transliteration": "tavaa su jar kai taas pai gheiyaa dhariyo banai ||",
      "translation": "",
      "punjabiViakhya": "ਤਵੇ ਨੂੰ ਘਿਓ ਨਾਲ ਥਿੰਦਾ ਕਰ ਕੇ (ਉਸ ਉਤੇ) ਜੜ੍ਰਹ ਦਿੱਤਾ (ਭਾਵ ਰਖ ਦਿੱਤਾ)।",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "तवा सु जरि कै तासु पै घेइया धरियो बनाइ ॥",
      "sourceLineId": "119943",
      "sourceShabadId": "11063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਲੀਪਿ ਮ੍ਰਿਤਕਾ ਸੌ ਲਿਯੋ ਦੀਨੀ ਆਗਿ ਜਰਾਇ ॥੧੫॥",
      "transliteration": "leep mritakaa sau liyo dheenee aag jarai ||15||",
      "translation": "",
      "punjabiViakhya": "ਮਿਟੀ ਨਾਲ ਲਿੰਬ ਕੇ ਅੱਗ ਬਾਲ ਦਿੱਤੀ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "लीपि मृतका सौ लियो दीनी आगि जराइ ॥१५॥",
      "sourceLineId": "119944",
      "sourceShabadId": "11063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਖੀਰ ਭਰੀ ਜਹ ਦੇਗ ਥੀ ਤਹੀ ਧਰੀ ਲੈ ਸੋਇ ॥",
      "transliteration": "kheer bharee jeh dheg thee tahee dharee lai soi ||",
      "translation": "Where other cauldrons, full of milk pudding, were lying,",
      "punjabiViakhya": "ਜਿਥੇ ਖੀਰ ਦੀ ਭਰੀ ਹੋਈ ਦੇਗ ਪਈ ਸੀ, ਉਸ ਨੂੰ ਵੀ ਉਥੇ ਲਿਆ ਕੇ ਰਖ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "खीर भरी जह देग थी तही धरी लै सोइ ॥",
      "sourceLineId": "119945",
      "sourceShabadId": "11063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੁਗਧ ਫੇਨ ਸੋ ਜਾਨਿਯੈ ਜਾਰ ਨ ਚੀਨੈ ਕੋਇ ॥੧੬॥",
      "transliteration": "dhugadh fen so jaaniyai jaar na cheenai koi ||16||",
      "translation": "She placed it there too and, with lather (on the plate) it looked the s and the friend was not visible to any one.(16)",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸਾਰੇ ਦੁੱਧ ਦੀ ਝਗ ਸਮਝਦੇ ਸਨ, (ਉਸ ਨੂੰ) ਕੋਈ ਵੀ ਯਾਰ ਨਹੀਂ ਸਮਝਦਾ ਸੀ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "दुगध फेन सो जानियै जार न चीनै कोइ ॥१६॥",
      "sourceLineId": "119946",
      "sourceShabadId": "11063",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "119947",
      "sourceShabadId": "11064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਟਰਿ ਆਵਤ ਰਾਜ ਗੈ ਲੀਨੋ ॥",
      "transliteration": "Tar aavat raaj gai leeno ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਅਗੇ ਵੱਧ ਕੇ ਰਾਜੇ ਦਾ ਸੁਆਗਤ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "टरि आवत राज गै लीनो ॥",
      "sourceLineId": "119948",
      "sourceShabadId": "11064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਸੋ ਆਦਰੁ ਕੀਨੋ ॥",
      "transliteration": "bhaat bhaat so aadhar keeno ||",
      "translation": "She went forward and welcomed Raja with great honours.",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਨਾਲ ਆਦਰ ਮਾਣ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "भाति भाति सो आदरु कीनो ॥",
      "sourceLineId": "119949",
      "sourceShabadId": "11064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਏ ਮਹਲ ਜੇ ਹਮੈ ਸਵਾਰੇ ॥",
      "transliteration": "ne mahal je hamai savaare ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਨਵੇਾਂ ਮਹੱਲ ਮੈਂ ਬਣਵਾਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "नए महल जे हमै सवारे ॥",
      "sourceLineId": "119950",
      "sourceShabadId": "11064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤੇ ਤੁਮ ਰਾਇ ਦ੍ਰਿਸਟਿ ਨਹਿ ਡਾਰੇ ॥੧੭॥",
      "transliteration": "te tum rai dhirasaT neh ddaare ||17||",
      "translation": "‘Since the time you built this palace for me, my Raja, you never cam here.’(17)",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਉਨ੍ਰਹਾ ਉਤੇ ਤੁਸੀਂ ਨਜ਼ਰ ਨਹੀਂ ਪਾਈ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "ते तुम राइ दृसटि नहि डारे ॥१७॥",
      "sourceLineId": "119951",
      "sourceShabadId": "11064",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "119952",
      "sourceShabadId": "11065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਟਰਿ ਆਗੇ ਪਤਿ ਕੌ ਲਿਯੋ ਰਹੀ ਚਰਨ ਸੌ ਲਾਗਿ ॥",
      "transliteration": "Tar aage pat kau liyo rahee charan sau laag ||",
      "translation": "She leapt forward, fell on his feet,",
      "punjabiViakhya": "ਅਗੇ ਵੱਧ ਕੇ (ਉਸ ਨੇ) ਪਤੀ ਦਾ ਸੁਆਗਤ ਕੀਤਾ ਅਤੇ ਚਰਨਾ ਨਾਲ ਲਿਪਟ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "टरि आगे पति कौ लियो रही चरन सौ लागि ॥",
      "sourceLineId": "119953",
      "sourceShabadId": "11065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਹੁਤ ਦਿਨਨ ਆਏ ਨ੍ਰਿਪਤਿ ਧੰਨ੍ਯ ਹਮਾਰੇ ਭਾਗ ॥੧੮॥",
      "transliteration": "bahut dhinan aae nirapat dha(n)nay hamaare bhaag ||18||",
      "translation": "‘You have come after a long time, it is my good luck.’(18)",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿਣ ਲਗੀ) ਹੇ ਰਾਜਨ! ਬਹੁਤ ਦਿਨਾ ਬਾਦ ਤੁਸੀਂ ਆਏ ਹੋ, ਸਾਡਾ ਧੰਨ ਭਾਗ ਹੈ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "बहुत दिनन आए नृपति धंन्य हमारे भाग ॥१८॥",
      "sourceLineId": "119954",
      "sourceShabadId": "11065",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "119955",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜੋ ਚਿਤ ਚਿੰਤ ਰਾਵ ਜੂ ਆਯੋ ॥",
      "transliteration": "jo chit chi(n)t raav joo aayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਗੱਲ ਦੀ ਚਿੰਤਾ ਕਰ ਕੇ ਰਾਜਾ ਆਇਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "जो चित चिंत राव जू आयो ॥",
      "sourceLineId": "119956",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੋ ਆਗੇ ਤ੍ਰਿਯ ਭਾਖਿ ਸੁਨਾਯੋ ॥",
      "transliteration": "so aage tiray bhaakh sunaayo ||",
      "translation": "Whatever there was in Raja’s mind, he divulged to her.",
      "punjabiViakhya": "ਉਹ ਰਾਣੀ ਨੂੰ ਦਸ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "सो आगे तृय भाखि सुनायो ॥",
      "sourceLineId": "119957",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮੈ ਸਭ ਸਦਨ ਦ੍ਰਿਸਟਿ ਮੈ ਕੈ ਹੌ ॥",
      "transliteration": "mai sabh sadhan dhirasaT mai kai hau ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਆਪ ਸਾਰਾ ਮਹੱਲ ਵੇਖਾਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "मै सभ सदन दृसटि मै कै हौ ॥",
      "sourceLineId": "119958",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਾਰਿ ਪਕਰਿ ਜਮ ਧਾਮ ਪਠੈ ਹੌ ॥੧੯॥",
      "transliteration": "jaar pakar jam dhaam paThai hau ||19||",
      "translation": "‘I will search the palace myself, catch the paramour and send him to the death cell.’(19)",
      "punjabiViakhya": "ਅਤੇ ਯਾਰ ਨੂੰ ਪਕੜ ਕੇ ਯਮਲੋਕ ਭੇਜਾਗਾ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "जारि पकरि जम धाम पठै हौ ॥१९॥",
      "sourceLineId": "119959",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਕਲ ਸਦਨ ਫਿਰਿ ਨ੍ਰਿਪਹਿ ਦਿਖਾਏ ॥",
      "transliteration": "sakal sadhan fir nirapeh dhikhaae ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਫਿਰ ਕੇ ਸਾਰਾ ਮਹੱਲ ਰਾਜੇ ਨੂੰ ਵਿਖਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "सकल सदन फिरि नृपहि दिखाए ॥",
      "sourceLineId": "119960",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਹਿਯੋ ਬਿਲੋਕਿ ਚੋਰ ਨਹਿ ਪਾਏ ॥",
      "transliteration": "rahiyo bilok chor neh paae ||",
      "translation": "She took Raja to the whole palace but no thief was found.",
      "punjabiViakhya": "ਵੇਖ ਹਟੇ, ਪਰ ਚੋਰ ਨਜ਼ਰ ਨਾ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "रहियो बिलोकि चोर नहि पाए ॥",
      "sourceLineId": "119961",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਹਾ ਦੇਗ ਮੈ ਜਾਰਹਿ ਡਾਰਿਯੋ ॥",
      "transliteration": "jahaa dheg mai jaareh ddaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਦੇਗ ਵਿਚ ਯਾਰ ਨੂੰ ਪਾਇਆ ਹੋਇਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "जहा देग मै जारहि डारियो ॥",
      "sourceLineId": "119962",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਹੀ ਆਨਿ ਪਤਿ ਕੌ ਬੈਠਾਰਿਯੋ ॥੨੦॥",
      "transliteration": "tahee aan pat kau baiThaariyo ||20||",
      "translation": "She brought her husband there where the cauldrons were lying.(20)",
      "punjabiViakhya": "ਉਥੇ ਆ ਕੇ ਪਤੀ ਨੂੰ ਬਿਠਾ ਦਿੱਤਾ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "तही आनि पति कौ बैठारियो ॥२०॥",
      "sourceLineId": "119963",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਬ ਰਾਜਾ ਆਵਤ ਸੁਨਿ ਪਾਏ ॥",
      "transliteration": "jab raajaa aavat sun paae ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿਣ ਲਗੀ) ਜਦ ਮੈਂ ਸੁਣਿਆ ਕਿ ਰਾਜਾ ਜੀ ਆ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "जब राजा आवत सुनि पाए ॥",
      "sourceLineId": "119964",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮੋਦ ਭਯੋ ਮਨ ਸੋਕ ਮਿਟਾਏ ॥",
      "transliteration": "modh bhayo man sok miTaae ||",
      "translation": "‘When 1 heard that my Raja was coming, 1 was very much appeased.",
      "punjabiViakhya": "(ਤਾ) ਪ੍ਰਸੰਨ ਹੋ ਗਈ ਅਤੇ ਦੁਖ ਮਿਟ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "मोद भयो मन सोक मिटाए ॥",
      "sourceLineId": "119965",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਯਹ ਸਭ ਖਾਨ ਪਕ੍ਵਾਏ ਤਬ ਹੀ ॥",
      "transliteration": "yeh sabh khaan pakavaiaae tab hee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਮੈਂ ਇਹ ਭੋਜਨ ਤਿਆਰ ਕਰਵਾਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "यह सभ खान पक्वाए तब ही ॥",
      "sourceLineId": "119966",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭੇਟਤ ਸੁਨੇ ਪਿਯਾਰੇ ਜਬ ਹੀ ॥੨੧॥",
      "transliteration": "bheTat sune piyaare jab hee ||21||",
      "translation": "‘I got all these cooking prepared, as I had realised that my lover w coming.’(21)",
      "punjabiViakhya": "ਜਦੋਂ ਇਹ ਸੁਣਿਆ ਕਿ ਤੁਸੀਂ ਮਿਲਣ ਆਏ ਹੋ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "भेटत सुने पियारे जब ही ॥२१॥",
      "sourceLineId": "119967",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਵਨ ਦੇਗ ਕੋ ਢਾਪਨੁਤਾਰਿਯੋ ॥",
      "transliteration": "tavan dheg ko ddaapanutaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇਗ ਦਾ ਢੱਕਣ ਉਤਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "तवन देग को ढापनुतारियो ॥",
      "sourceLineId": "119968",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪ੍ਰਥਮ ਦੂਧ ਪ੍ਯਾਰੇ ਕੋ ਪ੍ਰਯਾਰਿਯੋ ॥",
      "transliteration": "pratham dhoodh payaare ko prayaariyo ||",
      "translation": "She lifted the lid from the one and offered milk to her lover (the Raja).",
      "punjabiViakhya": "ਅਤੇ ਪਹਿਲਾ ਆਪਣੇ ਪਿਆਰੇ (ਰਾਜੇ) ਨੂੰ ਦੁੱਧ ਪਿਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "प्रथम दूध प्यारे को प्रयारियो ॥",
      "sourceLineId": "119969",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਹੁਰਿ ਬਾਟਿ ਲੋਗਨ ਕੌ ਦੀਨੋ ॥",
      "transliteration": "bahur baaT logan kau dheeno ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਲੋਕਾ ਵਿਚ ਵੰਡ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "बहुरि बाटि लोगन कौ दीनो ॥",
      "sourceLineId": "119970",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮੂਰਖ ਰਾਵ ਭੇਦ ਨਹਿ ਚੀਨੋ ॥੨੨॥",
      "transliteration": "moorakh raav bhedh neh cheeno ||22||",
      "translation": "Then she distributed among the others but the foolish Raja could no com prehend.(22)",
      "punjabiViakhya": "ਪਰ ਮੂਰਖ ਰਾਜੇ ਨੇ ਭੇਦ ਨੂੰ ਨਹੀਂ ਪਾਇਆ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "मूरख राव भेद नहि चीनो ॥२२॥",
      "sourceLineId": "119971",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਏਕ ਦੇਗ ਅਤਿਥਾਨ ਪਠਾਈ ॥",
      "transliteration": "ek dheg atithaan paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦੇਗ ਜੋਗੀਆਂ ਵਲ ਭੇਜ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "एक देग अतिथान पठाई ॥",
      "sourceLineId": "119972",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੂਜੀ ਬੈਰਾਗਿਨ ਕੇ ਦ੍ਰਯਾਈ ॥",
      "transliteration": "dhoojee bairaagin ke dhrayaiee ||",
      "translation": "One cauldron, she sent to the poor and the second one to the sages.",
      "punjabiViakhya": "ਅਤੇ ਦੂਜੀ ਬੈਰਾਗੀਆਂ ਨੂੰ ਦੇ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "दूजी बैरागिन के द्रयाई ॥",
      "sourceLineId": "119973",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤੀਜੀ ਦੇਗ ਸੰਨ੍ਯਾਸਨ ਦਈ ॥",
      "transliteration": "teejee dheg sa(n)nayaasan dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਜੀ ਦੇਗ ਸੰਨਿਆਸੀਆਂ ਨੂੰ ਭੇਜੀ",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "तीजी देग संन्यासन दई ॥",
      "sourceLineId": "119974",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਚੌਥੀ ਬ੍ਰਹਮਚਾਰਿਯਨ ਲਈ ॥੨੩॥",
      "transliteration": "chauathee brahamachaariyan liee ||23||",
      "translation": "The third one she sent to the ascetics and the fourth one to the celibates.(23)",
      "punjabiViakhya": "ਅਤੇ ਚੌਥੀ ਬ੍ਰਹਮਚਾਰੀਆਂ ਨੇ ਲਈ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "चौथी ब्रहमचारियन लई ॥२३॥",
      "sourceLineId": "119975",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪੰਚਈ ਦੇਗ ਚਾਕਰਨ ਦੀਨੀ ॥",
      "transliteration": "pa(n)chiee dheg chaakaran dheenee ||",
      "translation": "",
      "punjabiViakhya": "ਪੰਜਵੀਂ ਦੇਗ ਨੌਕਰਾ ਨੂੰ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "पंचई देग चाकरन दीनी ॥",
      "sourceLineId": "119976",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਛਟਈ ਦੇਗ ਪਿਯਾਦਨ ਲੀਨੀ ॥",
      "transliteration": "chhaTiee dheg piyaadhan leenee ||",
      "translation": "She gave fifth cauldron to the servants and sixth one to the footmen.",
      "punjabiViakhya": "ਅਤੇ ਛੇਵੀਂ ਦੇਗ ਪਿਆਦਿਆਂ (ਸਿਪਾਹੀਆਂ) ਨੇ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "छटई देग पियादन लीनी ॥",
      "sourceLineId": "119977",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੇਗ ਸਪਤਈ ਤਾਹਿ ਡਰਾਯੋ ॥",
      "transliteration": "dheg sapatiee taeh ddaraayo ||",
      "translation": "",
      "punjabiViakhya": "ਸੱਤਵੀਂ ਦੇਗ ਵਿਚ ਉਸ ਨੂੰ ਪਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "देग सपतई ताहि डरायो ॥",
      "sourceLineId": "119978",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਖੀ ਸੰਗ ਦੈ ਘਰੁ ਪਹਚਾਯੋ ॥੨੪॥",
      "transliteration": "sakhee sa(n)g dhai ghar pahachaayo ||24||",
      "translation": "The seventh cauldron, she gave to her lady-friends and through this, she sent him to the proper place.(24)",
      "punjabiViakhya": "ਸਖੀ ਨੂੰ ਨਾਲ ਭੇਜ ਕੇ ਘਰ ਪਹੁੰਚਾਇਆ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "सखी संग दै घरु पहचायो ॥२४॥",
      "sourceLineId": "119979",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੇਖਤ ਨ੍ਰਿਪ ਕੇ ਜਾਰ ਨਿਕਾਰਿਯੋ ॥",
      "transliteration": "dhekhat nirap ke jaar nikaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦੇ ਵੇਖਦਿਆਂ ਵੇਖਦਿਆਂ (ਉਥੋਂ) ਯਾਰ ਨੂੰ ਕਢ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "देखत नृप के जार निकारियो ॥",
      "sourceLineId": "119980",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮੂੜ ਰਾਵ ਕਛੁ ਸੋ ਨ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "mooR raav kachh so na bichaariyo ||",
      "translation": "Right {n front of Raja’s eyes she made the paramour to escape an",
      "punjabiViakhya": "ਪਰ ਮੂਰਖ ਰਾਜਾ ਇਸ ਬਾਰੇ ਕੁਝ ਵੀ ਸਮਝ ਨਾ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "मूड़ राव कछु सो न बिचारियो ॥",
      "sourceLineId": "119981",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਧਿਕ ਚਿਤ ਰਾਨੀ ਮੈ ਦੀਨੌ ॥",
      "transliteration": "adhik chit raanee mai dheenau ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਰਾਣੀ ਵਿਚ ਹੋਰ ਜ਼ਿਆਦਾ ਰੁਚੀ ਲੈਣ ਲਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "अधिक चित रानी मै दीनौ ॥",
      "sourceLineId": "119982",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮੋਰੈ ਹਿਤਨ ਬਧਾਵੌ ਕੀਨੌ ॥੨੫॥",
      "transliteration": "morai hitan badhaavau keenau ||25||",
      "translation": "imprudent Raja could not discern, rather, he loved her more.(25)",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ) ਉਸ ਨੇ ਮੇਰੇ ਲਈ ਮੰਗਲ-ਕਾਰਜ ਕੀਤਾ ਹੈ (ਅਰਥਾਤ ਖੁਸ਼ੀ ਮਨਾਈ ਹੈ) ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "मोरै हितन बधावौ कीनौ ॥२५॥",
      "sourceLineId": "119983",
      "sourceShabadId": "11066",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "119984",
      "sourceShabadId": "11067",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮੁਖੁ ਦਿਸਿ ਜੜ ਦੇਖਤ ਰਹਿਯੋ ਤ੍ਰਿਯ ਸੋ ਨੇਹੁਪਜਾਇ ॥",
      "transliteration": "mukh dhis jaR dhekhat rahiyo tiray so nehupajai ||",
      "translation": "While making love her, he kept on looking at her face,",
      "punjabiViakhya": "ਉਹ ਮੂਰਖ (ਰਾਜਾ) ਪਿਆਰ ਵਧਾ ਕੇ ਰਾਣੀ ਦੇ ਮੂੰਹ ਵਲ ਵੇਖਦਾ ਰਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "मुखु दिसि जड़ देखत रहियो तृय सो नेहुपजाइ ॥",
      "sourceLineId": "119985",
      "sourceShabadId": "11067",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_0999_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦੇਗ ਡਾਰਿ ਰਾਨੀ ਤੁਰਤ ਜਾਰਹਿ ਦਯੋ ਲੰਘਾਇ ॥੨੬॥",
      "transliteration": "dheg ddaar raanee turat jaareh dhayo la(n)ghai ||26||",
      "translation": "And the by putting him in the cauldron, she swiftly let him go free.(26)",
      "punjabiViakhya": "(ਯਾਰ ਨੂੰ) ਦੇਗ ਵਿਚ ਪਾ ਕੇ ਰਾਣੀ ਨੇ ਯਾਰ ਨੂੰ ਬਾਹਰ ਕਢ ਦਿੱਤਾ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 999,
      "hindi": "",
      "hindiTransliteration": "देग डारि रानी तुरत जारहि दयो लंघाइ ॥२६॥",
      "sourceLineId": "119986",
      "sourceShabadId": "11067",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
