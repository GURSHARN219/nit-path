{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1000,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1000_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "119987",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮੂਰਖ ਰਾਵ ਬਾਇ ਮੁਖ ਰਹਿਯੋ ॥",
      "transliteration": "moorakh raav bai mukh rahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਰਾਜਾ ਮੂੰਹ ਅਡੀ ਰਹਿ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "मूरख राव बाइ मुख रहियो ॥",
      "sourceLineId": "119988",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੇਖਤ ਰਹਿਯੋ ਜਾਰ ਨਹਿੰ ਗਹਿਯੋ ॥",
      "transliteration": "dhekhat rahiyo jaar nahi(n) gahiyo ||",
      "translation": "Raja kept his head hanging and looking down while the paramour taken away.",
      "punjabiViakhya": "ਅਤੇ ਵੇਖਦਾ ਹੀ ਰਹਿ ਗਿਆ ਪਰ ਯਾਰ ਪਕੜਿਆ ਨਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "देखत रहियो जार नहिं गहियो ॥",
      "sourceLineId": "119989",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਾਹਰੂਨ ਜੋ ਖੀਰ ਪਠਾਈ ॥",
      "transliteration": "paaharoon jo kheer paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਰੇਦਾਰਾ ਨੂੰ ਜੋ ਖੀਰ ਭੇਜੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "पाहरून जो खीर पठाई ॥",
      "sourceLineId": "119990",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਖਾਨ ਲਗੇ ਗ੍ਰੀਵਾ ਨਿਹੁਰਾਈ ॥੨੭॥",
      "transliteration": "khaan lage greevaa nihuraiee ||27||",
      "translation": "The rice-pudding, which was given to the guards, they kept on eating with their eyes dug down.(27)",
      "punjabiViakhya": "ਉਹ ਗਰਦਨ ਨੀਵੀਂ ਕਰ ਕੇ ਖਾਣ ਲਗ ਪਏ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "खान लगे ग्रीवा निहुराई ॥२७॥",
      "sourceLineId": "119991",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਿਯਤ ਜਾਰ ਤ੍ਰਿਯ ਘਰ ਪਹੁਚਾਯੋ ॥",
      "transliteration": "jiyat jaar tiray ghar pahuchaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਇਸਤਰੀ ਨੇ ਪ੍ਰੇਮੀ ਨੂੰ ਜੀਉਾਂਦਾ ਹੋਇਆ ਘਰ ਪਹੁੰਚਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "जियत जार तृय घर पहुचायो ॥",
      "sourceLineId": "119992",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪਾਹਰੂ ਨ ਰਾਜਾ ਲਖ ਪਾਯੋ ॥",
      "transliteration": "paaharoo na raajaa lakh paayo ||",
      "translation": "She delivered her lover alive at his house, which neither Raja nor guards could detect.",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਰਾਜਾ ਅਤੇ ਪਹਿਰੇਦਾਰ ਨਾ ਵੇਖ ਸਕੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "पाहरू न राजा लख पायो ॥",
      "sourceLineId": "119993",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਿਹ ਪਹੁਚਾਇ ਸਖੀ ਜਬ ਆਈ ॥",
      "transliteration": "teh pahuchai sakhee jab aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਪਹੁੰਚਾ ਕੇ ਜਦ ਸਖੀ ਪਰਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "तिह पहुचाइ सखी जब आई ॥",
      "sourceLineId": "119994",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਅਤਿ ਹੀ ਹਰਖਾਈ ॥੨੮॥",
      "transliteration": "tab raanee at hee harakhaiee ||28||",
      "translation": "After leaving him, when her friends returned, Rani felt a sigh of relief.(28)",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਬਹੁਤ ਹੀ ਖ਼ੁਸ਼ ਹੋਈ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "तब रानी अति ही हरखाई ॥२८॥",
      "sourceLineId": "119995",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਹੁਰਿ ਰਾਵ ਰਾਨੀ ਰਤਿ ਕੀਨੀ ॥",
      "transliteration": "bahur raav raanee rat keenee ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਰਾਜੇ ਨੇ ਰਾਣੀ ਨਾਲ ਪ੍ਰੇਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "बहुरि राव रानी रति कीनी ॥",
      "sourceLineId": "119996",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚਿਤ ਕੀ ਬਾਤ ਤਾਹਿ ਕਹਿ ਦੀਨੀ ॥",
      "transliteration": "chit kee baat taeh keh dheenee ||",
      "translation": "Raja made love with Rani and, then, told her the secret,",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਮਨ ਦੀ ਗੱਲ ਉਸ ਨੂੰ ਦਸ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "चित की बात ताहि कहि दीनी ॥",
      "sourceLineId": "119997",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਿਨਹੂੰ ਭ੍ਰਮ ਮੋਰੇ ਚਿਤ ਪਾਯੋ ॥",
      "transliteration": "kinahoo(n) bhram more chit paayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਕਿਸੇ ਨੇ ਮੇਰੇ ਚਿਤ ਵਿਚ ਭਰਮ ਪਾਇਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "किनहूँ भ्रम मोरे चित पायो ॥",
      "sourceLineId": "119998",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਾ ਤੇ ਮੈ ਦੇਖਨਿ ਗ੍ਰਿਹ ਆਯੋ ॥੨੯॥",
      "transliteration": "taa te mai dhekhan gireh aayo ||29||",
      "translation": "‘Some body had put a bad notion in my mind, and that is why I have come today.(29)",
      "punjabiViakhya": "ਤਾ ਹੀ ਮੈਂ ਵੇਖਣ ਲਈ ਘਰ ਆਇਆ ਸਾ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "ता ते मै देखनि गृह आयो ॥२९॥",
      "sourceLineId": "119999",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪੁਨਿ ਰਾਨੀ ਯਹ ਭਾਤਿ ਉਚਾਰੋ ॥",
      "transliteration": "pun raanee yeh bhaat uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਰਾਣੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "पुनि रानी यह भाति उचारो ॥",
      "sourceLineId": "120000",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੁਨੋ ਨ੍ਰਿਪਤਿ ਤੁਮ ਬਚਨ ਹਮਾਰੋ ॥",
      "transliteration": "suno nirapat tum bachan hamaaro ||",
      "translation": "‘Please, my Raja, the person who had misguided you,",
      "punjabiViakhya": "ਕਿ ਹੇ ਰਾਜਨ! ਤੁਸੀਂ ਮੇਰੀ ਗੱਲ ਸੁਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "सुनो नृपति तुम बचन हमारो ॥",
      "sourceLineId": "120001",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਿਨ ਤੁਹਿ ਕਹਿਯੋ ਸੁ ਮੁਹਿ ਕਹਿ ਦੀਜੈ ॥",
      "transliteration": "jin tuh kahiyo su muh keh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ (ਮੇਰੇ ਬਾਰੇ) ਤੁਹਾਨੂੰ ਕਿਹਾ ਹੈ, ਉਹ ਮੈਨੂੰ ਦਸ ਦਿਓ,",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "जिन तुहि कहियो सु मुहि कहि दीजै ॥",
      "sourceLineId": "120002",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਾਤਰ ਆਸ ਨ ਹਮਰੀ ਕੀਜੈ ॥੩੦॥",
      "transliteration": "naatar aas na hamaree keejai ||30||",
      "translation": "‘You must disclose it to me otherwise you forget my love.’(30)",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਮੇਰੀ ਆਸ ਛਡ ਦਿਓ। (ਭਾਵ ਮੈਂ ਮਰ ਜਾਵਾਗੀ) ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "नातर आस न हमरी कीजै ॥३०॥",
      "sourceLineId": "120003",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਬ ਰਾਨੀ ਇਹ ਭਾਤਿ ਸੁਨਾਈ ॥",
      "transliteration": "jab raanee ieh bhaat sunaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਣੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "जब रानी इह भाति सुनाई ॥",
      "sourceLineId": "120004",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਬ ਰਾਜੇ ਸੋ ਸਖੀ ਬਤਾਈ ॥",
      "transliteration": "tab raaje so sakhee bataiee ||",
      "translation": "When Rani insisted, then Raja told her the name of the maid.",
      "punjabiViakhya": "ਤਦ ਰਾਜੇ ਨੇ ਉਹ ਸਖੀ ਦਸ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "तब राजे सो सखी बताई ॥",
      "sourceLineId": "120005",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੋ ਤੁਮ ਕਹਿਯੋ ਸਾਚੀ ਪਹੁਚਾਵੋ ॥",
      "transliteration": "jo tum kahiyo saachee pahuchaavo ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਰਾਣੀ ਨੇ ਉਸ ਸਖੀ ਨੂੰ ਬੁਲਾ ਕੇ ਕਿਹਾ) ਜੋ ਤੂੰ (ਰਾਜੇ ਨੂੰ) ਕਿਹਾ ਹੈ, ਉਸ ਨੂੰ ਸੱਚਾ ਸਿੱਧ ਕਰ,",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "जो तुम कहियो साची पहुचावो ॥",
      "sourceLineId": "120006",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਾਤਰ ਧਾਮ ਮ੍ਰਿਤੁ ਕੇ ਜਾਵੋ ॥੩੧॥",
      "transliteration": "naatar dhaam mrit ke jaavo ||31||",
      "translation": "‘You believe her to be true, if so then, I pray, I should be killed.(31)",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਮੌਤ ਦੇ ਘਰ ਨੂੰ ਜਾ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "नातर धाम मृतु के जावो ॥३१॥",
      "sourceLineId": "120007",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰਾਨਿਨ ਕੋ ਕੋਊ ਦੋਸ ਲਗਾਵੈ ॥",
      "transliteration": "raanin ko kouoo dhos lagaavai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀਆਂ ਨੂੰ ਵੀ ਕੋਈ ਦੋਸ਼ ਲਗਾਉਾਂਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "रानिन को कोऊ दोस लगावै ॥",
      "sourceLineId": "120008",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਿਨ ਕੌ ਜਗਤ ਸੀਸ ਨਿਹੁਰਾਵੈ ॥",
      "transliteration": "jin kau jagat sees nihuraavai ||",
      "translation": "‘Who can doubt a Rani, to whom whole word pays obeisance.’",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੂੰ ਜਗਤ ਸਿਰ ਨਿਵਾਉਾਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "जिन कौ जगत सीस निहुरावै ॥",
      "sourceLineId": "120009",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਝੂਠੀ ਸਖੀ ਜਾਨਿ ਬਧ ਕੀਨੋ ॥",
      "transliteration": "jhooThee sakhee jaan badh keeno ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ) ਸਖੀ ਨੂੰ ਝੂਠਾ ਜਾਣ ਕੇ ਮਰਵਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "झूठी सखी जानि बध कीनो ॥",
      "sourceLineId": "120010",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮੂਰਖ ਰਾਵ ਭੇਦ ਨਹਿ ਚੀਨੋ ॥੩੨॥",
      "transliteration": "moorakh raav bhedh neh cheeno ||32||",
      "translation": "Thinking her to be liar, the maid was killed and the foolish Raja did not discover the truth.(32)",
      "punjabiViakhya": "ਮੂਰਖ ਰਾਜਾ ਭੇਦ ਨਾ ਪਾ ਸਕਿਆ ॥੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "मूरख राव भेद नहि चीनो ॥३२॥",
      "sourceLineId": "120011",
      "sourceShabadId": "11068",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "120012",
      "sourceShabadId": "11069",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰਾਜਾ ਕੌ ਕਰਿ ਬਸਿ ਲਿਯੋ ਦੀਨੋ ਜਾਰ ਨਿਕਾਰਿ ॥",
      "transliteration": "raajaa kau kar bas liyo dheeno jaar nikaar ||",
      "translation": "After getting the paramour to escape, she had won over the Raja,",
      "punjabiViakhya": "ਉਸ ਨੇ ਰਾਜੇ ਨੂੰ ਵਸ ਵਿਚ ਕਰ ਲਿਆ ਅਤੇ ਯਾਰ ਨੂੰ ਕੱਢ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "राजा कौ करि बसि लियो दीनो जार निकारि ॥",
      "sourceLineId": "120013",
      "sourceShabadId": "11069",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਖਿਯਨ ਮੈ ਸਾਚੀ ਭਈ ਤੌਨੈ ਸਖੀ ਸੰਘਾਰਿ ॥੩੩॥",
      "transliteration": "sakhiyan mai saachee bhiee tauanai sakhee sa(n)ghaar ||33||",
      "translation": "And by killing the maid, she established her honesty as well.(33)(1)",
      "punjabiViakhya": "ਉਸ ਸਖੀ ਨੂੰ ਮਾਰ ਕੇ (ਹੋਰਨਾ) ਸਖੀਆਂ ਵਿਚ ਸੱਚੀ ਹੋ ਗਈ ॥੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "सखियन मै साची भई तौनै सखी संघारि ॥३३॥",
      "sourceLineId": "120014",
      "sourceShabadId": "11069",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਬਤੀਸਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੩੨॥੨੬੨੪॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau bateesavo charitr samaapatam sat subham sat ||132||2624||afajoo(n)||",
      "translation": "132nd Parable of Auspicious Chritars Conversation of the Raja and the Minister, Completed With Benediction. (132)(2622)",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੩੨ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੩੨॥੨੬੨੪॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ बतीसवो चरित्र समापतम सतु सुभम सतु ॥१३२॥२६२४॥अफजूँ॥",
      "sourceLineId": "120015",
      "sourceShabadId": "11069",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "120016",
      "sourceShabadId": "11070",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹੁਗਲੀ ਬੰਦਰ ਕੋ ਹੁਤੋ ਹਿੰਮਤ ਸਿੰਘ ਨ੍ਰਿਪ ਏਕ ॥",
      "transliteration": "hugalee ba(n)dhar ko huto hi(n)mat si(n)gh nirap ek ||",
      "translation": "At the piers of Hoogly, there was a Raja named Himant Singh. There,",
      "punjabiViakhya": "ਹੁਗਲੀ ਬੰਦਰਗਾਹ ਦਾ ਇਕ ਹਿੰਮਤ ਸਿੰਘ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "हुगली बंदर को हुतो हिंमत सिंघ नृप एक ॥",
      "sourceLineId": "120017",
      "sourceShabadId": "11070",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਹਾ ਜਹਾਜ ਜਹਾਨ ਕੇ ਲਾਗਹਿ ਆਨਿ ਅਨੇਕ ॥੧॥",
      "transliteration": "tahaa jahaaj jahaan ke laageh aan anek ||1||",
      "translation": "the ships from all over the world used to come.(1)",
      "punjabiViakhya": "ਉਥੇ ਸੰਸਾਰ ਦੇ ਅਨੇਕ ਜਹਾਜ਼ ਆ ਕੇ ਲਗਦੇ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "तहा जहाज जहान के लागहि आनि अनेक ॥१॥",
      "sourceLineId": "120018",
      "sourceShabadId": "11070",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "120019",
      "sourceShabadId": "11071",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੁਜਨਿ ਕੁਅਰਿ ਤਾ ਕੀ ਬਰ ਨਾਰੀ ॥",
      "transliteration": "sujan kuar taa kee bar naaree ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਜਨਿ ਕੁਅਰਿ ਉਸ ਦੀ ਸੁੰਦਰ ਨਾਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "सुजनि कुअरि ता की बर नारी ॥",
      "sourceLineId": "120020",
      "sourceShabadId": "11071",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਨੁਕ ਚੰਦ੍ਰ ਮੌ ਚੀਰਿ ਨਿਕਾਰੀ ॥",
      "transliteration": "januk cha(n)dhr mau cheer nikaaree ||",
      "translation": "Sujjan Kumari was his beautiful wife; she appeared to have beentaken out of the Moon.",
      "punjabiViakhya": "ਮਾਨੋ ਚੰਦ੍ਰਮਾ ਨੂੰ ਚੀਰ ਕੇ ਕਢੀ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "जनुक चंद्र मौ चीरि निकारी ॥",
      "sourceLineId": "120021",
      "sourceShabadId": "11071",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜੋਬਨ ਜੇਬ ਅਧਿਕ ਤਿਹ ਸੋਹੈ ॥",
      "transliteration": "joban jeb adhik teh sohai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਜੋਬਨ ਅਤੇ ਸਾਜ ਸਜਾਵਟ ਬਹੁਤ ਫਬਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "जोबन जेब अधिक तिह सोहै ॥",
      "sourceLineId": "120022",
      "sourceShabadId": "11071",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੁਰ ਨਰ ਨਾਗ ਅਸੁਰ ਮਨ ਮੋਹੈ ॥੨॥",
      "transliteration": "sur nar naag asur man mohai ||2||",
      "translation": "Her youth knew no bounds and, even, the gods, the devils, the humansand the reptiles were enchanted on her sight.(2)",
      "punjabiViakhya": "(ਉਸ ਨੂੰ ਵੇਖ ਕੇ) ਦੇਵਤਿਆਂ, ਮਨੁੱਖਾ, ਨਾਗਾ, ਦੈਂਤਾ ਦਾ ਮਨ ਮੋਹਿਆ ਜਾਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "सुर नर नाग असुर मन मोहै ॥२॥",
      "sourceLineId": "120023",
      "sourceShabadId": "11071",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪਰਮ ਸਿੰਘ ਰਾਜਾ ਅਤਿ ਭਾਰੋ ॥",
      "transliteration": "param si(n)gh raajaa at bhaaro ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਮ ਸਿੰਘ ਨਾ ਦਾ ਇਕ ਬਹੁਤ ਵੱਡਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "परम सिंघ राजा अति भारो ॥",
      "sourceLineId": "120024",
      "sourceShabadId": "11071",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪਰਮ ਪੁਰਖ ਜਗ ਮਹਿ ਉਜਿਯਾਰੋ ॥",
      "transliteration": "param purakh jag meh ujiyaaro ||",
      "translation": "Parm Singh was a great king. He was considered as a magnanimous",
      "punjabiViakhya": "ਸਾਰੇ ਜਗਤ ਵਿਚ ਉਹ ਪਰਮ ਪੁਰਖ ਵਜੋਂ ਪ੍ਰਸਿੱਧ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "परम पुरख जग महि उजियारो ॥",
      "sourceLineId": "120025",
      "sourceShabadId": "11071",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਾ ਕੀ ਦੇਹ ਰੂਪ ਅਤਿ ਝਮਕੈ ॥",
      "transliteration": "taa kee dheh roop at jhamakai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਸ਼ਰੀਰ ਦਾ ਰੂਪ ਲਿਸ਼ਕਾਰੇ ਮਾਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "ता की देह रूप अति झमकै ॥",
      "sourceLineId": "120026",
      "sourceShabadId": "11071",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮਾਨਹੁ ਦਿਪਤ ਦਾਮਨੀ ਦਮਕੈ ॥੩॥",
      "transliteration": "maanahu dhipat dhaamanee dhamakai ||3||",
      "translation": "person. His posture was the epitome of the lightning in the sky.(3)",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਬਿਜਲੀ ਚਮਕ ਰਹੀ ਹੋਵੇ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "मानहु दिपत दामनी दमकै ॥३॥",
      "sourceLineId": "120027",
      "sourceShabadId": "11071",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "120028",
      "sourceShabadId": "11072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੁਜਨਿ ਕੁਅਰਿ ਤਾ ਕੋ ਮਹਾ ਰੀਝੀ ਰੂਪ ਨਿਹਾਰਿ ॥",
      "transliteration": "sujan kuar taa ko mahaa reejhee roop nihaar ||",
      "translation": "Sujjan Kumari fell so much for his handsomeness,",
      "punjabiViakhya": "(ਇਕ ਦਿਨ) ਸੁਜਨਿ ਕੁਅਰਿ ਉਸ ਦਾ ਰੂਪ ਵੇਖ ਕੇ ਬਹੁਤ ਰੀਝ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "सुजनि कुअरि ता को महा रीझी रूप निहारि ॥",
      "sourceLineId": "120029",
      "sourceShabadId": "11072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗਿਰੀ ਮੂਰਛਨਾ ਹ੍ਵੈ ਧਰਨਿ ਮਾਰ ਕਰੀ ਬਿਸੰਭਾਰਿ ॥੪॥",
      "transliteration": "giree moorachhanaa havai dharan maar karee bisa(n)bhaar ||4||",
      "translation": "That she lost her consciousness and fell flat on the ground.(4)",
      "punjabiViakhya": "ਬੇਹੋਸ਼ ਹੋ ਕੇ ਧਰਤੀ ਉਤੇ ਡਿਗ ਪਈ ਅਤੇ ਕਾਮ ਦੇਵ ('ਮਾਰ') ਨੇ ਬੇਸੁੱਧ ਕਰ ਦਿੱਤੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "गिरी मूरछना ह्वै धरनि मार करी बिसंभारि ॥४॥",
      "sourceLineId": "120030",
      "sourceShabadId": "11072",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "Arril",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "120031",
      "sourceShabadId": "11073",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪਠੇ ਸਹਚਰੀ ਲੀਨੌ ਤਾਹਿ ਬੁਲਾਇ ਕੈ ॥",
      "transliteration": "paThe sahacharee leenau taeh bulai kai ||",
      "translation": "She sent her maid and called him over.",
      "punjabiViakhya": "ਸਖੀ ਨੂੰ ਭੇਜ ਕੇ (ਰਾਣੀ ਨੇ) ਉਸ ਨੂੰ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "पठे सहचरी लीनौ ताहि बुलाइ कै ॥",
      "sourceLineId": "120032",
      "sourceShabadId": "11073",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰਤਿ ਮਾਨੀ ਤਿਹ ਸੰਗ ਸੁ ਮੋਦ ਬਢਾਇ ਕੈ ॥",
      "transliteration": "rat maanee teh sa(n)g su modh baddai kai ||",
      "translation": "She enjoyed lovemaking with him,",
      "punjabiViakhya": "ਆਨੰਦ ਵਧਾ ਕੇ ਉਸ ਨਾਲ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1000,
      "hindi": "",
      "hindiTransliteration": "रति मानी तिह संग सु मोद बढाइ कै ॥",
      "sourceLineId": "120033",
      "sourceShabadId": "11073",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1000_line_0048",
      "lineIndex": 48,
