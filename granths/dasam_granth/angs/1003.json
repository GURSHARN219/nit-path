{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1003,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1003_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਵਹੈ ਬਾਤ ਹਮਰੇ ਜਿਯ ਭਾਵੈ ॥੬॥",
      "transliteration": "vahai baat hamare jiy bhaavai ||6||",
      "translation": "‘Whatever action provides enjoyment to Raja, I honour it.’(6)",
      "punjabiViakhya": "ਉਹੀ ਗੱਲ ਮੇਰੇ ਚਿਤ ਨੂੰ ਚੰਗੀ ਲਗਦੀ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "वहै बात हमरे जिय भावै ॥६॥",
      "sourceLineId": "120155",
      "sourceShabadId": "11084",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਲੀ ਏਕ ਸੁੰਦਰ ਲਖਿ ਪਾਯੋ ॥",
      "transliteration": "balee ek su(n)dhar lakh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਇਕ ਸੁੰਦਰ ਬਲਵਾਨ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "बली एक सुँदर लखि पायो ॥",
      "sourceLineId": "120156",
      "sourceShabadId": "11084",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪ੍ਰਥਮ ਤਵਨ ਕੀ ਤ੍ਰਿਯਹਿ ਭਿਟਾਯੋ ॥",
      "transliteration": "pratham tavan kee tirayeh bhiTaayo ||",
      "translation": "Once the Rani met a handsome man whose wife she introduced tothe Raja.",
      "punjabiViakhya": "ਪਹਿਲਾ ਉਸ ਦੀ ਇਸਤਰੀ ਨੂੰ ਰਾਜੇ ਨਾਲ ਮਿਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "प्रथम तवन की तृयहि भिटायो ॥",
      "sourceLineId": "120157",
      "sourceShabadId": "11084",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਬ ਵਹੁ ਪੁਰਖ ਅਧਿਕ ਰਿਸਿ ਭਰਿਯੋ ॥",
      "transliteration": "jab vahu purakh adhik ris bhariyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਪੁਰਸ਼ ਗੁੱਸੇ ਨਾਲ ਭਰ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "जब वहु पुरख अधिक रिसि भरियो ॥",
      "sourceLineId": "120158",
      "sourceShabadId": "11084",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਬ ਤਾ ਸੋ ਯੌ ਬਚਨ ਉਚਰਿਯੋ ॥੭॥",
      "transliteration": "tab taa so yau bachan uchariyo ||7||",
      "translation": "Then she incited the man that his wife was revelling with the Raja,and taunted him of having no shame.(7)",
      "punjabiViakhya": "ਤਦ ਉਸ ਨਾਲ ਰਾਣੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਗੱਲ ਕੀਤੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "तब ता सो यौ बचन उचरियो ॥७॥",
      "sourceLineId": "120159",
      "sourceShabadId": "11084",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "120160",
      "sourceShabadId": "11085",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਾਮ ਕੇਲ ਤਾ ਸੌ ਕਰਿਯੋ ਰਾਨੀ ਅਤਿ ਸੁਖ ਪਾਇ ॥",
      "transliteration": "kaam kel taa sau kariyo raanee at sukh pai ||",
      "translation": "Herself, she made love with him and felt relieved.",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਉਸ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ ਅਤੇ ਬਹੁਤ ਸੁਖ ਪ੍ਰਾਪਤ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "काम केल ता सौ करियो रानी अति सुख पाइ ॥",
      "sourceLineId": "120161",
      "sourceShabadId": "11085",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਹੁਰਿ ਬਚਨ ਤਿਹ ਪੁਰਖ ਸੋ ਐਸੋ ਕਹਿਯੋ ਸੁਨਾਇ ॥੮॥",
      "transliteration": "bahur bachan teh purakh so aaiso kahiyo sunai ||8||",
      "translation": "Then she talked to that man like this,(8)",
      "punjabiViakhya": "ਫਿਰ ਉਸ ਪੁਰਸ਼ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣਾ ਕੇ ਕਿਹਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "बहुरि बचन तिह पुरख सो ऐसो कहियो सुनाइ ॥८॥",
      "sourceLineId": "120162",
      "sourceShabadId": "11085",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "120163",
      "sourceShabadId": "11086",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤੁਮਰੀ ਪ੍ਰਭਾ ਕਹੋ ਕਾ ਰਹੀ ॥",
      "transliteration": "tumaree prabhaa kaho kaa rahee ||",
      "translation": "",
      "punjabiViakhya": "(ਹੇ ਮਿਤਰ!) ਦਸ, ਤੇਰੀ ਸ਼ੋਭਾ ਕੀ ਰਹਿ ਗਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "तुमरी प्रभा कहो का रही ॥",
      "sourceLineId": "120164",
      "sourceShabadId": "11086",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਿਜ ਨਾਰੀ ਰਾਜੈ ਜੋ ਚਹੀ ॥",
      "transliteration": "nij naaree raajai jo chahee ||",
      "translation": "‘What has happened to your honour? Your wife goes to Raja.",
      "punjabiViakhya": "ਜੇ ਰਾਜਾ ਤੇਰੀ ਇਸਤਰੀ ਨੂੰ ਚਾਹੁੰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "निज नारी राजै जो चही ॥",
      "sourceLineId": "120165",
      "sourceShabadId": "11086",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਾ ਕੀ ਤ੍ਰਿਯ ਸੋ ਔਰ ਬਿਹਾਰੈ ॥",
      "transliteration": "jaa kee tiray so aauar bihaarai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਇਸਤਰੀ ਨਾਲ ਕੋਈ ਹੋਰ ਰਮਣ ਕਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "जा की तृय सो और बिहारै ॥",
      "sourceLineId": "120166",
      "sourceShabadId": "11086",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਧ੍ਰਿਗ ਤਾ ਕੋ ਸਭ ਜਗਤ ਉਚਾਰੈ ॥੯॥",
      "transliteration": "dhirag taa ko sabh jagat uchaarai ||9||",
      "translation": "‘The wife, who revels in sex with another man, is reproved.’(9)",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸਾਰਾ ਸੰਸਾਰ ਧਿਕਾਰਦਾ ਹੈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "धृग ता को सभ जगत उचारै ॥९॥",
      "sourceLineId": "120167",
      "sourceShabadId": "11086",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "120168",
      "sourceShabadId": "11087",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪ੍ਰਥਮ ਭੋਗ ਮਨ ਭਾਵਤੋ ਰਾਨੀ ਕਿਯੋ ਬਨਾਇ ॥",
      "transliteration": "pratham bhog man bhaavato raanee kiyo banai ||",
      "translation": "First she had made love with him to her full satisfaction,",
      "punjabiViakhya": "ਪਹਿਲਾ ਰਾਣੀ ਨੇ ਉਸ ਨਾਲ ਮਨ ਭਾਉਾਂਦਾ ਭੋਗ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "प्रथम भोग मन भावतो रानी कियो बनाइ ॥",
      "sourceLineId": "120169",
      "sourceShabadId": "11087",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਹੁਰਿ ਬਚਨ ਤਾ ਸੌ ਕਹਿਯੋ ਐਸੇ ਰਿਸ ਉਪਜਾਇ ॥੧੦॥",
      "transliteration": "bahur bachan taa sau kahiyo aaise ris upajai ||10||",
      "translation": "And then, to infuriate him, she spoke thus,(10)",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਇਸ ਤਰ੍ਰਹਾ ਬਚਨ ਕਹਿ ਕੇ ਉਸ ਦਾ ਗੁੱਸਾ ਭੜਕਾਇਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "बहुरि बचन ता सौ कहियो ऐसे रिस उपजाइ ॥१०॥",
      "sourceLineId": "120170",
      "sourceShabadId": "11087",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "120171",
      "sourceShabadId": "11088",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤੁਮਰੀ ਤ੍ਰਿਯ ਕੌ ਰਾਵ ਬੁਲਾਵੈ ॥",
      "transliteration": "tumaree tiray kau raav bulaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ) ਤੇਰੀ ਇਸਤਰੀ ਨੂੰ ਰਾਜਾ ਬੁਲਾਉਾਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "तुमरी तृय कौ राव बुलावै ॥",
      "sourceLineId": "120172",
      "sourceShabadId": "11088",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਿਹ ਸਾਥ ਕਮਾਵੈ ॥",
      "transliteration": "kaam bhog teh saath kamaavai ||",
      "translation": "‘Raja invited your wife and, then, sexually relished sex with her.",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਕਾਮ-ਭੋਗ ਕਰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "काम भोग तिह साथ कमावै ॥",
      "sourceLineId": "120173",
      "sourceShabadId": "11088",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤੂ ਨਹਿ ਮਰਿਯੋ ਲਾਜ ਕੋ ਮਰਈ ॥",
      "transliteration": "too neh mariyo laaj ko mariee ||",
      "translation": "",
      "punjabiViakhya": "ਤੂੰ ਲਾਜ ਦਾ ਮਾਰਿਆ ਮਰਦਾ ਕਿਉਾਂ ਨਹੀਂ",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "तू नहि मरियो लाज को मरई ॥",
      "sourceLineId": "120174",
      "sourceShabadId": "11088",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪਾਵਕ ਬਿਖੈ ਜਾਇ ਨਹਿ ਜਰਈ ॥੧੧॥",
      "transliteration": "paavak bikhai jai neh jariee ||11||",
      "translation": "‘You should die in shame or why don’t you burn yourself for thisignominy.’(11)",
      "punjabiViakhya": "ਜਾ ਅੱਗ ਵਿਚ ਜਾ ਕੇ ਸੜਦਾ ਕਿਉਾਂ ਨਹੀਂ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "पावक बिखै जाइ नहि जरई ॥११॥",
      "sourceLineId": "120175",
      "sourceShabadId": "11088",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "120176",
      "sourceShabadId": "11089",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕੈ ਯਹ ਮੂਰਖ ਰਾਵ ਤੇ ਬਦਲੋ ਲੇਹਿ ਬਨਾਇ ॥",
      "transliteration": "kai yeh moorakh raav te badhalo leh banai ||",
      "translation": "‘Either you take revenge from the Raja,",
      "punjabiViakhya": "ਜਾ ਤਾ ਇਸ ਮੂਰਖ ਰਾਜੇ ਤੋਂ ਚੰਗੀ ਤਰ੍ਰਹਾ ਬਦਲਾ ਲੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "कै यह मूरख राव ते बदलो लेहि बनाइ ॥",
      "sourceLineId": "120177",
      "sourceShabadId": "11089",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾਤਰ ਬਦ੍ਰਿਕਾਸ੍ਰਮ ਬਿਖੈ ਗਰੌ ਹਿਮਾਚਲ ਜਾਇ ॥੧੨॥",
      "transliteration": "naatar badhirakaasram bikhai garau himaachal jai ||12||",
      "translation": "‘Or you run away to the mountains and bury yourself in snow.’(12)",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਬਦ੍ਰਿਕਾਸ਼੍ਰਮ (ਬਦਰੀਨਾਥ) ਜਾ ਕੇ ਹਿਮਾਲੇ ਵਿਚ ਗਲ ਜਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "नातर बदृकास्रम बिखै गरौ हिमाचल जाइ ॥१२॥",
      "sourceLineId": "120178",
      "sourceShabadId": "11089",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "120179",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੋ ਤ੍ਰਿਯ ਕਹੋ ਮੋਹਿ ਸੋ ਕਰੌ ॥",
      "transliteration": "jo tiray kaho moh so karau ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਪੁਰਸ਼ ਨੇ ਕਿਹਾ) ਹੇ ਰਾਣੀ! ਜੋ ਤੂੰ ਕਹੇਾਂਗੀ, ਉਹੀ ਮੈਂ ਕਰਾਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "जो तृय कहो मोहि सो करौ ॥",
      "sourceLineId": "120180",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਬਕ ਸਿੰਘ ਤੇ ਨੈਕ ਨ ਡਰੌ ॥",
      "transliteration": "sabak si(n)gh te naik na ddarau ||",
      "translation": "‘Dear Rani, whatever you say, I will abide by and I will not dreadSabhak Singh.",
      "punjabiViakhya": "(ਮੈਂ) ਸਬਕ ਸਿੰਘ ਤੋਂ ਜ਼ਰਾ ਵੀ ਨਹੀਂ ਡਰਾਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "सबक सिंघ ते नैक न डरौ ॥",
      "sourceLineId": "120181",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਨ ਕੀਨੋ ਗ੍ਰਿਹ ਖ੍ਵਾਰ ਹਮਾਰੋ ॥",
      "transliteration": "ein keeno gireh khavaiaar hamaaro ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨੇ ਮੇਰਾ ਘਰ ਬਰਬਾਦ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "इन कीनो गृह ख्वार हमारो ॥",
      "sourceLineId": "120182",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮੈਹੂੰ ਤਿਹ ਤ੍ਰਿਯ ਸੰਗ ਬਿਹਾਰੋ ॥੧੩॥",
      "transliteration": "maihoo(n) teh tiray sa(n)g bihaaro ||13||",
      "translation": "‘He has disrupted my house, I will make love with his wife too.(13)",
      "punjabiViakhya": "ਮੈਂ ਵੀ ਉਸ ਦੀ ਇਸਤਰੀ ਨਾਲ ਰਮਣ ਕਰਾਗਾ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "मैहूँ तिह तृय संग बिहारो ॥१३॥",
      "sourceLineId": "120183",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰੋਮਾਤਕ ਤੁਮ ਪ੍ਰਥਮ ਲਗਾਵੋ ॥",
      "transliteration": "romaatak tum pratham lagaavo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ ਉਸ ਨੂੰ ਸਮਝਾਇਆ ਕਿ) ਤੂੰ ਪਹਿਲਾ ਰੋਮ-ਨਾਸਨੀ ਲਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "रोमातक तुम प्रथम लगावो ॥",
      "sourceLineId": "120184",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਕਲ ਤ੍ਰਿਯਾ ਕੌ ਭੇਸ ਛਕਾਵੋ ॥",
      "transliteration": "sakal tirayaa kau bhes chhakaavo ||",
      "translation": "(Rani)‘You bring in some hair-removing powder and then disguise yourselfas a woman.",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਾ ਇਸਤਰੀ ਦਾ ਸਰੂਪ ਬਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "सकल तृया कौ भेस छकावो ॥",
      "sourceLineId": "120185",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਬ ਤੁਮ ਕੌ ਰਾਜਾ ਲਖਿ ਪੈ ਹੈ ॥",
      "transliteration": "jab tum kau raajaa lakh pai hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜਾ ਤੈਨੂੰ (ਇਸਤਰੀ ਰੂਪ) ਵਿਚ ਵੇਖ ਲਏਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "जब तुम कौ राजा लखि पै है ॥",
      "sourceLineId": "120186",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤੁਰਤੁ ਮਦਨ ਕੇ ਬਸਿ ਹ੍ਵੈ ਜੈ ਹੈ ॥੧੪॥",
      "transliteration": "turat madhan ke bas havai jai hai ||14||",
      "translation": "‘When Raja will see you, he will surely be taken over by theCupid.’(14)",
      "punjabiViakhya": "ਤਾ ਤੁਰਤ ਕਾਮ ਦੇ ਵਸ ਵਿਚ ਹੋ ਜਾਏਗਾ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "तुरतु मदन के बसि ह्वै जै है ॥१४॥",
      "sourceLineId": "120187",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਾਰ ਕੇਸ ਸਭ ਦੂਰਿ ਕਰਾਏ ॥",
      "transliteration": "jaar kes sabh dhoor karaae ||",
      "translation": "",
      "punjabiViakhya": "ਯਾਰ ਨੇ ਸਾਰੇ ਵਾਲ ਸਾਫ਼ ਕਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "जार केस सभ दूरि कराए ॥",
      "sourceLineId": "120188",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭੂਖਨ ਅੰਗ ਅਨੂਪ ਸੁਹਾਏ ॥",
      "transliteration": "bhookhan a(n)g anoop suhaae ||",
      "translation": "The powder removed all his hair and the he adorned ornaments.",
      "punjabiViakhya": "ਸ਼ਰੀਰ ਉਤੇ ਅਨੂਪਮ ਗਹਿਣੇ ਸਜਾ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "भूखन अंग अनूप सुहाए ॥",
      "sourceLineId": "120189",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਾਇ ਦਰਸ ਰਾਜਾ ਕੋ ਦਿਯੋ ॥",
      "transliteration": "jai dharas raajaa ko dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਕੇ ਰਾਜੇ ਨੂੰ ਵਿਖਾਲੀ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "जाइ दरस राजा को दियो ॥",
      "sourceLineId": "120190",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨ੍ਰਿਪ ਕੋ ਮੋਹਿ ਆਤਮਾ ਲਿਯੋ ॥੧੫॥",
      "transliteration": "nirap ko moh aatamaa liyo ||15||",
      "translation": "He went, showed himself to the Raja, and he was totally infatualed.(15)",
      "punjabiViakhya": "ਰਾਜੇ ਦੀ ਆਤਮਾ ਨੂੰ ਮੋਹ ਲਿਆ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "नृप को मोहि आतमा लियो ॥१५॥",
      "sourceLineId": "120191",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਬ ਰਾਜੈ ਤਾ ਕੋ ਲਖਿ ਪਾਯੋ ॥",
      "transliteration": "jab raajai taa ko lakh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਉਸ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "जब राजै ता को लखि पायो ॥",
      "sourceLineId": "120192",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੌਰਿ ਸਦਨ ਰਾਨੀ ਕੇ ਆਯੋ ॥",
      "transliteration": "dhauar sadhan raanee ke aayo ||",
      "translation": "As soon as he saw him, he came running to the Rani’s palace,",
      "punjabiViakhya": "ਤਾ ਦੌੜ ਕੇ ਰਾਣੀ ਦੇ ਮਹੱਲ ਵਿਚ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "दौरि सदन रानी के आयो ॥",
      "sourceLineId": "120193",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹੇ ਸੁੰਦਰਿ ਮੈ ਤ੍ਰਿਯਿਕ ਨਿਹਾਰੀ ॥",
      "transliteration": "he su(n)dhar mai tirayik nihaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗਾ) ਹੇ ਸੁੰਦਰੀ! ਮੈਂ ਇਕ ਇਸਤਰੀ ਵੇਖੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "हे सुँदरि मै तृयिक निहारी ॥",
      "sourceLineId": "120194",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਾਨੁਕ ਮਹਾ ਰੁਦ੍ਰ ਕੀ ਪ੍ਯਾਰੀ ॥੧੬॥",
      "transliteration": "jaanuk mahaa rudhr kee payaaree ||16||",
      "translation": "And said, ‘I have seen here a woman, as pretty as goddess Parbati.(I6)",
      "punjabiViakhya": "ਮਾਨੋ ਮਹਾ ਰੁਦ੍ਰ ਦੀ ਪਿਆਰੀ (ਪਾਰਬਤੀ) ਹੋਵੇ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "जानुक महा रुद्र की प्यारी ॥१६॥",
      "sourceLineId": "120195",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜੋ ਮੁਹਿ ਤਿਹ ਤੂ ਆਜ ਮਿਲਾਵੈਂ ॥",
      "transliteration": "jo muh teh too aaj milaavai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੂੰ ਮੈਨੂੰ ਉਹ ਅਜ ਮਿਲਾ ਦੇਵੇਾਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "जो मुहि तिह तू आज मिलावैं ॥",
      "sourceLineId": "120196",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜੋ ਮਾਗੈ ਮੁਖ ਤੇ ਸੋ ਪਾਵੈਂ ॥",
      "transliteration": "jo maagai mukh te so paavai(n) ||",
      "translation": "‘If you let her meet me, I will do for you whatever you say.’",
      "punjabiViakhya": "ਜੋ ਮੂੰਹੋਂ ਮੰਗੇਗੀ, ਉਹੀ ਪ੍ਰਾਪਤ ਕਰ ਲਵੇਾਂਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "जो मागै मुख ते सो पावैं ॥",
      "sourceLineId": "120197",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰਾਨੀ ਫੂਲਿ ਬਚਨ ਸੁਨਿ ਗਈ ॥",
      "transliteration": "raanee fool bachan sun giee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਬਚਨ ਸੁਣ ਕੇ ਫੁਲ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "रानी फूलि बचन सुनि गई ॥",
      "sourceLineId": "120198",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜੋ ਮੈ ਚਾਹਤ ਥੀ ਸੋਊ ਭਈ ॥੧੭॥",
      "transliteration": "jo mai chaahat thee souoo bhiee ||17||",
      "translation": "Rani was overjoyed to hear that she would get whatever she wanted. (17)",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ) ਜੋ ਮੈਂ ਚਾਹੁੰਦੀ ਸਾ, ਉਹੀ ਹੋ ਗਿਆ ਹੈ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "जो मै चाहत थी सोऊ भई ॥१७॥",
      "sourceLineId": "120199",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੁਨਤ ਬਚਨ ਰਾਨੀ ਗ੍ਰਿਹ ਆਈ ॥",
      "transliteration": "sunat bachan raanee gireh aaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ) ਬਚਨ ਸੁਣ ਕੇ ਰਾਣੀ ਘਰ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "सुनत बचन रानी गृह आई ॥",
      "sourceLineId": "120200",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤੌਨ ਜਾਰ ਕੋ ਦਯੋ ਭਿਟਾਈ ॥",
      "transliteration": "tauan jaar ko dhayo bhiTaiee ||",
      "translation": "Rani came to her chambers and introduced her friend to Raja.",
      "punjabiViakhya": "ਉਸ ਯਾਰ ਨੂੰ ਮਿਲਵਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "तौन जार को दयो भिटाई ॥",
      "sourceLineId": "120201",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1003_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਬ ਤਾ ਕੋ ਨ੍ਰਿਪ ਹਾਥ ਚਲਾਯੋ ॥",
      "transliteration": "jab taa ko nirap haath chalaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਉਸ ਪ੍ਰਤਿ ਹੱਥ ਵਧਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1003,
      "hindi": "",
      "hindiTransliteration": "जब ता को नृप हाथ चलायो ॥",
      "sourceLineId": "120202",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
