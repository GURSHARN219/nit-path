{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1004,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1004_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪਕਰਿ ਰਾਵ ਕੋ ਤਰੇ ਦਬਾਯੋ ॥੧੮॥",
      "transliteration": "pakar raav ko tare dhabaayo ||18||",
      "translation": "When Raja commenced caressing him, he clutched him and nabbedhim down.(I8)",
      "punjabiViakhya": "ਉਸ ਨੇ ਪਕੜ ਕੇ ਰਾਜੇ ਨੂੰ ਦਬੋਚ ਲਿਆ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "पकरि राव को तरे दबायो ॥१८॥",
      "sourceLineId": "120203",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨ੍ਰਿਪ ਕੋ ਪਕਰਿ ਭੁਜਨ ਤੇ ਲਿਯੋ ॥",
      "transliteration": "nirap ko pakar bhujan te liyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਬਾਹਵਾ ਤੋਂ ਪਕੜ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "नृप को पकरि भुजन ते लियो ॥",
      "sourceLineId": "120204",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗੁਦਾ ਭੋਗ ਤਾ ਕੋ ਦ੍ਰਿੜ ਕਿਯੋ ॥",
      "transliteration": "gudhaa bhog taa ko dhiraR kiyo ||",
      "translation": "Holding him by his arms, he ravaged him with annul sex.",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਚੰਗੀ ਤਰ੍ਰਹਾ ਗੁਦਾ-ਭੋਗ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "गुदा भोग ता को दृड़ कियो ॥",
      "sourceLineId": "120205",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤੋਰਿ ਤਾਰਿ ਤਨ ਰੁਧਿਰ ਚਲਾਯੋ ॥",
      "transliteration": "tor taar tan rudhir chalaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤੋੜ ਤਾੜ ਕੇ ਰਾਜੇ ਦੇ ਸ਼ਰੀਰ (ਭਾਵ ਗੁਦਾ) ਤੋਂ ਲਹੂ ਵਗਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "तोरि तारि तन रुधिर चलायो ॥",
      "sourceLineId": "120206",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਧਿਕ ਰਾਵ ਮਨ ਮਾਝ ਲਜਾਯੋ ॥੧੯॥",
      "transliteration": "adhik raav man maajh lajaayo ||19||",
      "translation": "He tore him to bleed and the Raja felt extremely ashamed ofhimself.(19)",
      "punjabiViakhya": "ਰਾਜਾ (ਇਸ ਕਰ ਕੇ) ਮਨ ਵਿਚ ਬਹੁਤ ਲਜਿਤ ਹੋਇਆ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "अधिक राव मन माझ लजायो ॥१९॥",
      "sourceLineId": "120207",
      "sourceShabadId": "11090",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "120208",
      "sourceShabadId": "11091",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੁਦਾ ਭੋਗ ਭੇ ਤੇ ਨ੍ਰਿਪਤਿ ਮਨ ਮਹਿ ਰਹਿਯੋ ਲਜਾਇ ॥",
      "transliteration": "gudhaa bhog bhe te nirapat man meh rahiyo lajai ||",
      "translation": "With annul sex; Raja had felt himself much humiliated,",
      "punjabiViakhya": "ਗੁਦਾ-ਭੋਗ ਕਰ ਕੇ ਰਾਜਾ ਮਨ ਵਿਚ ਬਹੁਤ ਲਜਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "गुदा भोग भे ते नृपति मन महि रहियो लजाइ ॥",
      "sourceLineId": "120209",
      "sourceShabadId": "11091",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਾ ਦਿਨ ਤੇ ਕਾਹੂੰ ਤ੍ਰਿਯਹਿ ਲਯੋ ਨ ਨਿਕਟਿ ਬੁਲਾਇ ॥੨੦॥",
      "transliteration": "taa dhin te kaahoo(n) tirayeh layo na nikaT bulai ||20||",
      "translation": "And from then on abandoned ruining the virtuosity of other’swomen.(20)(1)",
      "punjabiViakhya": "ਉਸ ਦਿਨ ਤੋਂ ਕਿਸੇ ਵੀ ਇਸਤਰੀ ਨੂੰ (ਰਾਜੇ ਨੇ ਆਪਣੇ) ਨੇੜੇ ਨਾ ਬੁਲਾਇਆ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "ता दिन ते काहूँ तृयहि लयो न निकटि बुलाइ ॥२०॥",
      "sourceLineId": "120210",
      "sourceShabadId": "11091",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਚੌਤੀਸਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੩੪॥੨੬੭੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau chauateesavo charitr samaapatam sat subham sat ||134||2672||afajoo(n)||",
      "translation": "134th Parable of Auspicious ChritarsConversation of the Raja and the Minister,Completed With Benediction. (134)(2670)",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੩੪ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੩੪॥੨੬੭੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ चौतीसवो चरित्र समापतम सतु सुभम सतु ॥१३४॥२६७२॥अफजूँ॥",
      "sourceLineId": "120211",
      "sourceShabadId": "11091",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "120212",
      "sourceShabadId": "11092",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦੁਹਿਤਾ ਸਾਹੁ ਫਿਰੰਗ ਕੀ ਜਾ ਕੋ ਰੂਪ ਅਪਾਰ ॥",
      "transliteration": "dhuhitaa saahu fira(n)g kee jaa ko roop apaar ||",
      "translation": "Shah Farangh had a daughter, who was extremely pretty.",
      "punjabiViakhya": "ਫਿਰੰਗ ਸ਼ਾਹ ਦੀ ਇਕ ਪੁੱਤਰੀ ਦਾ ਬਹੁਤ ਸੁੰਦਰ ਰੂਪ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "दुहिता साहु फिरंग की जा को रूप अपार ॥",
      "sourceLineId": "120213",
      "sourceShabadId": "11092",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤੀਨਿ ਭਵਨ ਭੀਤਰ ਕਹੂੰ ਤਾ ਸਮ ਔਰ ਨ ਨਾਰਿ ॥੧॥",
      "transliteration": "teen bhavan bheetar kahoo(n) taa sam aauar na naar ||1||",
      "translation": "In all the three domains, none was comparable to her.(1)",
      "punjabiViakhya": "ਤਿੰਨਾ ਲੋਕਾ ਵਿਚ ਉਸ ਸਮਾਨ ਕੋਈ ਸੁੰਦਰ ਇਸਤਰੀ ਨਹੀਂ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "तीनि भवन भीतर कहूँ ता सम और न नारि ॥१॥",
      "sourceLineId": "120214",
      "sourceShabadId": "11092",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "120215",
      "sourceShabadId": "11093",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਬਦੁਲ ਨਾਮ ਮੁਲਾਨਾ ਭਾਰੋ ॥",
      "transliteration": "abadhul naam mulaanaa bhaaro ||",
      "translation": "",
      "punjabiViakhya": "ਅਬਦੁਲ ਨਾ ਦਾ ਇਕ ਵੱਡਾ ਮੁਲਾਣਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "अबदुल नाम मुलाना भारो ॥",
      "sourceLineId": "120216",
      "sourceShabadId": "11093",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਹਿਰ ਜਹਾਨਾਬਾਦਿ ਉਜਿਯਾਰੋ ॥",
      "transliteration": "sahir jahaanaabaadh ujiyaaro ||",
      "translation": "There was one Maulana (Muslim) priest named Abdul, who lived inthe city of Jehanbad.",
      "punjabiViakhya": "(ਉਹ) ਜਹਾਨਾਬਾਦ ਸ਼ਹਿਰ ਵਿਚ ਬਹੁਤ ਪ੍ਰਸਿੱਧ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "सहिर जहानाबादि उजियारो ॥",
      "sourceLineId": "120217",
      "sourceShabadId": "11093",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹਾਜਰਾਤਿ ਜਬ ਬੈਠਿ ਮੰਗਾਵੈ ॥",
      "transliteration": "haajaraat jab baiTh ma(n)gaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਬੈਠ ਕੇ 'ਹਾਜਰਾਤਿ' (ਜਿੰਨ ਭੂਤ) ਮੰਗਵਾਉਣ (ਦੀ ਕ੍ਰਿਆ) ਕਰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "हाजराति जब बैठि मंगावै ॥",
      "sourceLineId": "120218",
      "sourceShabadId": "11093",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੇਵ ਭੂਤ ਜਿਨਾਨ ਬੁਲਾਵੈ ॥੨॥",
      "transliteration": "dhev bhoot jinaan bulaavai ||2||",
      "translation": "When in meditation, he would call devils, demons and ghosts.(2)",
      "punjabiViakhya": "ਤਾ ਦੇਓ, ਭੂਤ ਅਤੇ ਜਿੰਨਾ ਨੂੰ ਬੁਲਾ ਲੈਂਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "देव भूत जिनान बुलावै ॥२॥",
      "sourceLineId": "120219",
      "sourceShabadId": "11093",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "120220",
      "sourceShabadId": "11094",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦੇਵ ਭੂਤ ਜਿਨਾਤ ਕਹ ਲੇਵੈ ਨਿਕਟ ਬੁਲਾਇ ॥",
      "transliteration": "dhev bhoot jinaat keh levai nikaT bulai ||",
      "translation": "He would tell the devils, demons and ghosts to come closer to him’",
      "punjabiViakhya": "(ਉਹ) ਦੇਓਆਂ, ਭੂਤਾ ਅਤੇ ਜਿੰਨਾ ਨੂੰ ਆਪਣੇ ਕੋਲ ਬੁਲਾ ਲੈਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "देव भूत जिनात कह लेवै निकट बुलाइ ॥",
      "sourceLineId": "120221",
      "sourceShabadId": "11094",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੌਨ ਬਾਤ ਚਿਤ ਮੈ ਰੁਚੈ ਤਿਨ ਤੇ ਲੇਤ ਮੰਗਾਇ ॥੩॥",
      "transliteration": "jauan baat chit mai ruchai tin te let ma(n)gai ||3||",
      "translation": "And whatever he planned, he would get them to execute.(3)",
      "punjabiViakhya": "ਜੋ ਵੀ ਗੱਲ (ਭਾਵ ਵਸਤੂ) ਉਸ ਦੇ ਚਿਤ ਵਿਚ ਚੰਗੀ ਲਗਦੀ, ਉਨ੍ਰਹਾ ਰਾਹੀਂ ਮੰਗਵਾ ਲੈਂਦਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "जौन बात चित मै रुचै तिन ते लेत मंगाइ ॥३॥",
      "sourceLineId": "120222",
      "sourceShabadId": "11094",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "120223",
      "sourceShabadId": "11095",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਾ ਪੈ ਪਰੀ ਬਹੁਤ ਚਲਿ ਆਵੈ ॥",
      "transliteration": "taa pai paree bahut chal aavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਕੋਲ ਬਹੁਤ ਸਾਰੀਆਂ ਪਰੀਆਂ ਚਲ ਕੇ ਆਉਾਂਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "ता पै परी बहुत चलि आवै ॥",
      "sourceLineId": "120224",
      "sourceShabadId": "11095",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕੋਊ ਨਾਚਿ ਉਠ ਕੋਊ ਗਾਵੈ ॥",
      "transliteration": "kouoo naach uTh kouoo gaavai ||",
      "translation": "A number off airy used to come to him; some sang and some dancedfor him.",
      "punjabiViakhya": "ਕੋਈ ਉਠ ਕੇ ਨਚਦੀ ਸੀ ਅਤੇ ਕੋਈ ਗਾਉਾਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "कोऊ नाचि उठ कोऊ गावै ॥",
      "sourceLineId": "120225",
      "sourceShabadId": "11095",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਭਾਵ ਦਿਖਾਵਹਿ ॥",
      "transliteration": "bhaat bhaat ke bhaav dhikhaaveh ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦੇ ਹਾਵ-ਭਾਵ ਦਿਖਾਉਾਂਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के भाव दिखावहि ॥",
      "sourceLineId": "120226",
      "sourceShabadId": "11095",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦੇਖਨਹਾਰ ਸਭੇ ਬਲਿ ਜਾਵਹਿ ॥੪॥",
      "transliteration": "dhekhanahaar sabhe bal jaaveh ||4||",
      "translation": "They displayed coquetry, which was admired by the spectators.(4)",
      "punjabiViakhya": "ਸਾਰੇ ਦੇਖਣ ਵਾਲੇ ਬਲਿਹਾਰੇ ਜਾਦੇ ਸਨ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "देखनहार सभे बलि जावहि ॥४॥",
      "sourceLineId": "120227",
      "sourceShabadId": "11095",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਲਾਲ ਪਰੀ ਇਕ ਬਚਨ ਉਚਾਰੋ ॥",
      "transliteration": "laal paree ik bachan uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਲਾਲ ਪਰੀ ਨੇ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "लाल परी इक बचन उचारो ॥",
      "sourceLineId": "120228",
      "sourceShabadId": "11095",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਾਹ ਪਰੀ ਸੁਨੁ ਬੈਨ ਹਮਾਰੋ ॥",
      "transliteration": "saeh paree sun bain hamaaro ||",
      "translation": "Once the Red-fairy expounded and Black-fairy responded.",
      "punjabiViakhya": "ਕਿ ਸ਼ਾਹ ਪਰੀ! ਤੂੰ ਮੇਰੀ ਇਕ ਗੱਲ ਸੁਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "साह परी सुनु बैन हमारो ॥",
      "sourceLineId": "120229",
      "sourceShabadId": "11095",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੁੰਦਰਿ ਕਲਾ ਕੁਅਰਿ ਇਕ ਭਾਰੀ ॥",
      "transliteration": "su(n)dhar kalaa kuar ik bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਕਲਾ ਕੁਅਰਿ ਨਾ ਦੀ ਬਹੁਤ ਸੁੰਦਰ ਇਸਤਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "सुँदरि कला कुअरि इक भारी ॥",
      "sourceLineId": "120230",
      "sourceShabadId": "11095",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਨੁਕ ਰੂਪ ਕੀ ਰਾਸਿ ਸਵਾਰੀ ॥੫॥",
      "transliteration": "januk roop kee raas savaaree ||5||",
      "translation": "‘Kala Kunwar is a pretty damsel, as if she is the mine of magnificence.(5)",
      "punjabiViakhya": "ਮਾਨੋ ਰੂਪ ਦੀ ਖਾਣ ਬਣਾਈ ਗਈ ਹੋਵੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "जनुक रूप की रासि सवारी ॥५॥",
      "sourceLineId": "120231",
      "sourceShabadId": "11095",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "Dohira",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "120232",
      "sourceShabadId": "11096",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਾਹੀ ਤੇ ਬਿਧਿ ਰੂਪ ਲੈ ਕੀਨੇ ਰੂਪ ਅਨੇਕ ॥",
      "transliteration": "taahee te bidh roop lai keene roop anek ||",
      "translation": "‘Borrowing charm from her, Brahma has created many lovelies.",
      "punjabiViakhya": "ਉਸੇ ਤੋਂ ਵਿਧਾਤਾ ਨੇ ਰੂਪ ਲੈ ਕੇ ਅਨੇਕ ਰੂਪ ਤਿਆਰ ਕੀਤੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "ताही ते बिधि रूप लै कीने रूप अनेक ॥",
      "sourceLineId": "120233",
      "sourceShabadId": "11096",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਰੀਝਿ ਰਹੀ ਮੈ ਨਿਰਖਿ ਛਬਿ ਮਨ ਕ੍ਰਮ ਸਹਿਤ ਬਿਬੇਕ ॥੬॥",
      "transliteration": "reejh rahee mai nirakh chhab man kram sahit bibek ||6||",
      "translation": "‘Looking at her, through both, the body and the soul, I am gettingsatiated.( 6)",
      "punjabiViakhya": "ਉਸ ਦੀ ਛਬੀ ਨੂੰ ਵੇਖ ਕੇ ਮੈਂ ਮਨ, ਕਰਮ ਅਤੇ ਵਿਵੇਕ ਕਰ ਕੇ ਰੀਝ ਗਈ ਹਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "रीझि रही मै निरखि छबि मन क्रम सहित बिबेक ॥६॥",
      "sourceLineId": "120234",
      "sourceShabadId": "11096",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupaee",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "120235",
      "sourceShabadId": "11097",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਾ ਕੀ ਪ੍ਰਭਾ ਜਾਤ ਨਹਿ ਕਹੀ ॥",
      "transliteration": "taa kee prabhaa jaat neh kahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "ता की प्रभा जात नहि कही ॥",
      "sourceLineId": "120236",
      "sourceShabadId": "11097",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਾਨੁਕ ਫੂਲਿ ਮਾਲਿਤੀ ਰਹੀ ॥",
      "transliteration": "jaanuk fool maalitee rahee ||",
      "translation": "‘She is above adoration and appears to be the favourite of flower girls.",
      "punjabiViakhya": "ਮਾਨੋ ਮਾਲਤੀ ਦਾ ਫੁਲ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "जानुक फूलि मालिती रही ॥",
      "sourceLineId": "120237",
      "sourceShabadId": "11097",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਵਨ ਸੁ ਕਬਿ ਤਿਹ ਪ੍ਰਭਾ ਉਚਾਰੈ ॥",
      "transliteration": "kavan su kab teh prabhaa uchaarai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਹੜਾ ਕਵੀ ਉਸ ਦੀ ਪ੍ਰਭਾ ਦਾ ਬਖਾਨ ਕਰ ਸਕਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "कवन सु कबि तिह प्रभा उचारै ॥",
      "sourceLineId": "120238",
      "sourceShabadId": "11097",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕੋਟਿ ਸੂਰ ਜਨੁ ਚੜੇ ਸਵਾਰੇ ॥੭॥",
      "transliteration": "koT soor jan chaRe savaare ||7||",
      "translation": "‘Who can relate her qualities as she epitomises thousands of Suns?’(7)",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ) ਮਾਨੋ ਕਰੋੜਾ ਸੂਰਜ ਸੰਵਰ ਕੇ ਚੜ੍ਰਹ ਪਏ ਹੋਣ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "कोटि सूर जनु चड़े सवारे ॥७॥",
      "sourceLineId": "120239",
      "sourceShabadId": "11097",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮੁਲਾ ਬਾਤ ਸ੍ਰਵਨ ਯਹ ਸੁਨੀ ॥",
      "transliteration": "mulaa baat sravan yeh sunee ||",
      "translation": "",
      "punjabiViakhya": "ਮੁੱਲਾ ਨੇ ਜਦ ਕੰਨਾ ਨਾਲ ਸਭ ਕੁਝ ਸੁਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "मुला बात स्रवन यह सुनी ॥",
      "sourceLineId": "120240",
      "sourceShabadId": "11097",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਿਰਹ ਬਿਕਲ ਹ੍ਵੈ ਮੂੰਡੀ ਧੁਨੀ ॥",
      "transliteration": "bireh bikal havai moo(n)ddee dhunee ||",
      "translation": "When Maulana heard such verbalisation, he became hysterical.",
      "punjabiViakhya": "ਤਾ ਬਿਰਹੋਂ ਨਾਲ ਵਿਆਕੁਲ ਹੋ ਕੇ ਸਿਰ ਹਿਲਾਉਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "बिरह बिकल ह्वै मूँडी धुनी ॥",
      "sourceLineId": "120241",
      "sourceShabadId": "11097",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਏਕ ਦੇਵ ਭੇਜਾ ਤਹ ਜਾਈ ॥",
      "transliteration": "ek dhev bhejaa teh jaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਦੇਓ ਉਥੇ ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "एक देव भेजा तह जाई ॥",
      "sourceLineId": "120242",
      "sourceShabadId": "11097",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਾ ਕੀ ਖਾਟ ਉਠਾਇ ਮੰਗਾਈ ॥੮॥",
      "transliteration": "taa kee khaaT uThai ma(n)gaiee ||8||",
      "translation": "He sent one demon to her and got her bed transported.(8)",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੀ ਮੰਜੀ ਚੁਕਵਾ ਕੇ ਮੰਗਵਾ ਲਈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "ता की खाट उठाइ मंगाई ॥८॥",
      "sourceLineId": "120243",
      "sourceShabadId": "11097",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਵਾ ਸੁੰਦਰਿ ਕੋ ਕਛੁ ਨ ਬਸਾਯੋ ॥",
      "transliteration": "vaa su(n)dhar ko kachh na basaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਸੁੰਦਰੀ ਦਾ ਕੋਈ ਵਸ ਨਾ ਚਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "वा सुँदरि को कछु न बसायो ॥",
      "sourceLineId": "120244",
      "sourceShabadId": "11097",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮੁਲਾ ਕੇ ਸੰਗ ਭੋਗ ਕਮਾਯੋ ॥",
      "transliteration": "mulaa ke sa(n)g bhog kamaayo ||",
      "translation": "She was defenceless and she had to make love with Maulana.",
      "punjabiViakhya": "ਅਤੇ ਮੁੱਲਾ ਨਾਲ (ਉਸ ਨੇ) ਭੋਗ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "मुला के संग भोग कमायो ॥",
      "sourceLineId": "120245",
      "sourceShabadId": "11097",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬੀਤੀ ਰੈਨਿ ਭੋਰ ਜਬ ਭਯੋ ॥",
      "transliteration": "beetee rain bhor jab bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਤ ਬੀਤ ਗਈ ਅਤੇ ਸਵੇਰ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "बीती रैनि भोर जब भयो ॥",
      "sourceLineId": "120246",
      "sourceShabadId": "11097",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਿਹ ਪਹੁਚਾਇ ਤਹੀ ਤਿਨ ਦਯੋ ॥੯॥",
      "transliteration": "teh pahuchai tahee tin dhayo ||9||",
      "translation": "When the night had gone past, she was ferried back.(9)",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੂੰ ਉਥੇ ਹੀ ਪਹੁੰਚਾ ਦਿੱਤਾ ਗਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "तिह पहुचाइ तही तिन दयो ॥९॥",
      "sourceLineId": "120247",
      "sourceShabadId": "11097",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਐਸੀ ਬਿਧਿ ਤਿਹ ਰੋਜ ਬੁਲਾਵੈ ॥",
      "transliteration": "aaisee bidh teh roj bulaavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਨਾਲ (ਮੁੱਲਾ) ਉਸ ਨੂੰ ਰੋਜ਼ ਬੁਲਾਉਾਂਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "ऐसी बिधि तिह रोज बुलावै ॥",
      "sourceLineId": "120248",
      "sourceShabadId": "11097",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹੋਤ ਉਦੋਤ ਫਿਰੰਗ ਪਠਾਵੈ ॥",
      "transliteration": "hot udhot fira(n)g paThaavai ||",
      "translation": "The same way, he would get her every night and then return her toFarangh Shah.",
      "punjabiViakhya": "ਅਤੇ ਸਵੇਰ ਹੋਣ ਤੇ ਫਿਰੰਗ (ਸ਼ਾਹ) ਕੋਲ ਭੇਜ ਦਿੰਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": "होत उदोत फिरंग पठावै ॥",
      "sourceLineId": "120249",
      "sourceShabadId": "11097",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1004_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮਨ ਮਾਨਤ ਕੇ ਕੇਲਨ ਕਰੈ ॥",
      "transliteration": "man maanat ke kelan karai ||",
      "translation": "",
      "punjabiViakhya": "ਮਨ ਭਾਉਾਂਦੀ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਦਾ",
