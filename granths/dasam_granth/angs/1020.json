{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1020,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1020_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "121019",
      "sourceShabadId": "11225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੁਨਿਹੋ ਪ੍ਰੀਤਮ ਰਾਜ ਕਾਜ ਮੁਰ ਕੀਜਿਯੈ ॥",
      "transliteration": "suniho preetam raaj kaaj mur keejiyai ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮੇਰੇ ਪ੍ਰੀਤਮ ਰਾਜਨ! ਸੁਣੋ, ਮੇਰਾ (ਇਕ) ਕੰਮ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "सुनिहो प्रीतम राज काज मुर कीजियै ॥",
      "sourceLineId": "121020",
      "sourceShabadId": "11225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਛੁ ਧਨ ਛੋਰਿ ਭੰਡਾਰ ਹਮਾਰੋ ਲੀਜਿਯੈ ॥",
      "transliteration": "kachh dhan chhor bha(n)ddaar hamaaro leejiyai ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਝ ਧਨ ਛਡ ਕੇ ਮੇਰਾ ਸਾਰਾ ਖ਼ਜ਼ਾਨਾ ਲੈ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "कछु धन छोरि भंडार हमारो लीजियै ॥",
      "sourceLineId": "121021",
      "sourceShabadId": "11225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਖੋਦਿ ਭੂਮਿ ਤਰ ਮੰਡਪ ਏਕ ਬਨਾਇਯੈ ॥",
      "transliteration": "khodh bhoom tar ma(n)ddap ek banaiyai ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ ਨੂੰ ਪੁਟ ਕੇ ਹੇਠਾ ਇਕ ਮਠ ('ਮੰਡਪ') ਬਣਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "खोदि भूमि तर मंडप एक बनाइयै ॥",
      "sourceLineId": "121022",
      "sourceShabadId": "11225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹੋ ਮੰਡਪ ਲਖਿਯੋ ਨ ਜਾਇ ਭੂਮਿ ਲਹਿ ਜਾਇਯੈ ॥੭॥",
      "transliteration": "ho ma(n)ddap lakhiyo na jai bhoom leh jaiyai ||7||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਮਠ (ਉਪਰੋਂ) ਵੇਖਿਆ ਨਾ ਜਾ ਸਕੇ, ਬਸ ਭੂਮੀ ਦਾ ਹੀ ਪਤਾ ਲਗੇ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "हो मंडप लखियो न जाइ भूमि लहि जाइयै ॥७॥",
      "sourceLineId": "121023",
      "sourceShabadId": "11225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਬ ਤਿਨ ਛੋਰਿ ਭੰਡਾਰ ਅਮਿਤ ਧਨ ਕੋ ਲਿਯੋ ॥",
      "transliteration": "tab tin chhor bha(n)ddaar amit dhan ko liyo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਉਸ ਨੇ (ਕੁਝ) ਭੰਡਾਰ ਛਡ ਕੇ ਅਮਿਤ ਧਨ ਨੂੰ ਲੈ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "तब तिन छोरि भंडार अमित धन को लियो ॥",
      "sourceLineId": "121024",
      "sourceShabadId": "11225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਖੋਦਿ ਭੂਮਿ ਕੇ ਤਰੇ ਬਨਾਵਤ ਮਟ ਭਯੋ ॥",
      "transliteration": "khodh bhoom ke tare banaavat maT bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਭੂਮੀ ਨੂੰ ਪੁਟ ਕੇ ਹੇਠਾ ਮਠ ਬਣਵਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "खोदि भूमि के तरे बनावत मट भयो ॥",
      "sourceLineId": "121025",
      "sourceShabadId": "11225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕੈ ਸੋਈ ਸ੍ਯਾਨੋ ਲਖੈ ਨ ਦੇਵਲ ਪਾਇਯੈ ॥",
      "transliteration": "kai soiee sayaano lakhai na dheval paiyai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮਠ ਨੂੰ ਕੋਈ ਵੀ ਸਿਆਣਾ ਵੇਖ ਨਹੀਂ ਸਕਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "कै सोई स्यानो लखै न देवल पाइयै ॥",
      "sourceLineId": "121026",
      "sourceShabadId": "11225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹੋ ਔਰ ਭੂਮਿ ਸੀ ਸੋ ਭੂਅ ਚਿਤ ਮੈ ਲ੍ਯਾਇਯੈ ॥੮॥",
      "transliteration": "ho aauar bhoom see so bhooa chit mai layaiyai ||8||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬਾਕੀ ਧਰਤੀ ਵਾਗ ਹੀ ਮਨ ਨੂੰ ਲਗਦੀ ਸੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "हो और भूमि सी सो भूअ चित मै ल्याइयै ॥८॥",
      "sourceLineId": "121027",
      "sourceShabadId": "11225",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "121028",
      "sourceShabadId": "11226",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਾਜਹਿ ਰਾਨੀ ਰੋਜ ਬੁਲਾਵੈ ॥",
      "transliteration": "raajeh raanee roj bulaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਰਾਜੇ ਨੂੰ ਰਾਣੀ ਰੋਜ਼ ਬੁਲਾਉਾਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "राजहि रानी रोज बुलावै ॥",
      "sourceLineId": "121029",
      "sourceShabadId": "11226",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਕੇਲ ਕਮਾਵੈ ॥",
      "transliteration": "bhaat bhaat ke kel kamaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨਾਲ) ਭਾਤ ਭਾਤ ਦੀ ਕੇਲਕ੍ਰੀੜਾ ਕਰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के केल कमावै ॥",
      "sourceLineId": "121030",
      "sourceShabadId": "11226",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਤਿ ਸਨੇਹ ਤਾ ਸੌ ਉਪਜਾਯੋ ॥",
      "transliteration": "at saneh taa sau upajaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਉਸ ਨਾਲ ਬਹੁਤ ਪ੍ਰੇਮ ਪਾਲ ਲਿਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "अति सनेह ता सौ उपजायो ॥",
      "sourceLineId": "121031",
      "sourceShabadId": "11226",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਨੁਕ ਸਾਤ ਫੇਰਨ ਕੋ ਪਾਯੋ ॥੯॥",
      "transliteration": "januk saat feran ko paayo ||9||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸੱਤ ਫੇਰੇ ਲੈ ਕੇ ਪ੍ਰਾਪਤ ਕੀਤਾ ਹੋਵੇ (ਅਰਥਾਤ ਵਿਆਹ ਕੀਤਾ ਹੋਵੇ) ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "जनुक सात फेरन को पायो ॥९॥",
      "sourceLineId": "121032",
      "sourceShabadId": "11226",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕੇਲ ਕਮਾਇ ਰਾਜ ਜਬ ਜਾਵੈ ॥",
      "transliteration": "kel kamai raaj jab jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜਾ ਕਾਮ-ਕਲਾ ਕਰ ਕੇ ਚਲਾ ਜਾਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "केल कमाइ राज जब जावै ॥",
      "sourceLineId": "121033",
      "sourceShabadId": "11226",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਜੋਗਿਯਹਿ ਬੁਲਾਵੈ ॥",
      "transliteration": "tab raanee jogiyeh bulaavai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਾਣੀ ਜੋਗੀ ਨੂੰ ਬੁਲਾ ਲੈਂਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "तब रानी जोगियहि बुलावै ॥",
      "sourceLineId": "121034",
      "sourceShabadId": "11226",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚਿਮਟਿ ਚਿਮਟਿ ਤਾ ਸੌ ਰਤਿ ਮਾਨੈ ॥",
      "transliteration": "chimaT chimaT taa sau rat maanai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਲਿਪਟ ਲਿਪਟ ਕੇ ਰਤੀ ਮਨਾਉਾਂਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "चिमटि चिमटि ता सौ रति मानै ॥",
      "sourceLineId": "121035",
      "sourceShabadId": "11226",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮੂਰਖ ਰਾਵ ਭੇਦ ਨਹਿ ਜਾਨੈ ॥੧੦॥",
      "transliteration": "moorakh raav bhedh neh jaanai ||10||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਮੂਰਖ ਰਾਜਾ ਇਸ ਭੇਦ ਨੂੰ ਨਹੀਂ ਸਮਝ ਸਕਦਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "मूरख राव भेद नहि जानै ॥१०॥",
      "sourceLineId": "121036",
      "sourceShabadId": "11226",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਾਮ ਅਧਿਕ ਦਿਨ ਰਾਜ ਸੰਤਾਯੋ ॥",
      "transliteration": "kaam adhik dhin raaj sa(n)taayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਰਾਜੇ (ਭੂਧਰ ਸਿੰਘ) ਨੂੰ ਕਾਮ ਨੇ ਬਹੁਤ ਸਤਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "काम अधिक दिन राज संतायो ॥",
      "sourceLineId": "121037",
      "sourceShabadId": "11226",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਿਨੁ ਬੋਲੇ ਰਾਨੀ ਕੇ ਆਯੋ ॥",
      "transliteration": "bin bole raanee ke aayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਦੇ ਬਿਨਾ ਬੁਲਾਇਆਂ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "बिनु बोले रानी के आयो ॥",
      "sourceLineId": "121038",
      "sourceShabadId": "11226",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕੇਲ ਕਰਤ ਸੋ ਤ੍ਰਿਯ ਲਖਿ ਪਾਈ ॥",
      "transliteration": "kel karat so tiray lakh paiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਉਸ ਇਸਤਰੀ ਨੂੰ ਕਾਮ ਕਰਦਿਆਂ ਵੇਖ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "केल करत सो तृय लखि पाई ॥",
      "sourceLineId": "121039",
      "sourceShabadId": "11226",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਾ ਕੇ ਕੋਪ ਜਗ੍ਯੋ ਜਿਯ ਆਈ ॥੧੧॥",
      "transliteration": "taa ke kop jagayo jiy aaiee ||11||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ) ਉਸ ਦੇ ਮਨ ਵਿਚ ਬਹੁਤ ਕ੍ਰੋਧ ਪੈਦਾ ਹੋ ਗਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "ता के कोप जग्यो जिय आई ॥११॥",
      "sourceLineId": "121040",
      "sourceShabadId": "11226",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "121041",
      "sourceShabadId": "11227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕੇਲ ਕਰਤ ਰਾਨੀ ਤਿਹ ਲਖਿਯੋ ਬਨਾਇ ਕੈ ॥",
      "transliteration": "kel karat raanee teh lakhiyo banai kai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਧਰ) ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਦੀ ਰਾਣੀ ਨੇ ਵੀ ਉਸ ਨੂੰ ਵੇਖ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "केल करत रानी तिह लखियो बनाइ कै ॥",
      "sourceLineId": "121042",
      "sourceShabadId": "11227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਾਧਿ ਰਸਰਿਯਨ ਲਿਯੋ ਸੁ ਦਿਯੋ ਜਰਾਇ ਕੈ ॥",
      "transliteration": "baadh rasariyan liyo su dhiyo jarai kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਰੱਸੀਆਂ ਨਾਲ ਬੰਨ੍ਰਹ ਕੇ ਸਾੜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "बाधि रसरियन लियो सु दियो जराइ कै ॥",
      "sourceLineId": "121043",
      "sourceShabadId": "11227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਨਾਥ ਕੇ ਸਾਥ ਕਹਿਯੋ ਯੌ ਜਾਇ ਕਰਿ ॥",
      "transliteration": "kirapaa naath ke saath kahiyo yau jai kar ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਕ੍ਰਿਪਾ ਨਾਥ (ਜੋਗੀ) ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "कृपा नाथ के साथ कहियो यौ जाइ करि ॥",
      "sourceLineId": "121044",
      "sourceShabadId": "11227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹੋ ਜੋ ਮੈ ਕਹੋ ਚਰਿਤ੍ਰ ਸੁ ਕਰਿਯੈ ਨਾਥ ਬਰ ॥੧੨॥",
      "transliteration": "ho jo mai kaho charitr su kariyai naath bar ||12||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸ੍ਰੇਸ਼ਠ ਨਾਥ! ਜੋ ਮੈਂ ਚਰਿਤ੍ਰ ਕਹਾ, ਉਹੀ ਤੁਸੀਂ ਕਰੋ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "हो जो मै कहो चरित्र सु करियै नाथ बर ॥१२॥",
      "sourceLineId": "121045",
      "sourceShabadId": "11227",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "121046",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਖਾਨ ਪਾਨ ਆਗੇ ਤਵ ਧਰਿਹੌ ॥",
      "transliteration": "khaan paan aage tav dharihau ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਖਾਣ ਪੀਣ (ਦੀ ਸਾਮਗ੍ਰੀ) ਤੁਹਾਡੇ ਅਗੇ ਧਰ ਦੇਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "खान पान आगे तव धरिहौ ॥",
      "sourceLineId": "121047",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮੁੰਦ੍ਰਿਤ ਮਠ ਕੋ ਦ੍ਵਾਰਨਿ ਕਰਿਹੌ ॥",
      "transliteration": "mu(n)dhirat maTh ko dhavaiaaran karihau ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਠ ਦੇ ਦਰਵਾਜ਼ੇ ਬੰਦ ਕਰ ਦੇਵਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "मुँदृत मठ को द्वारनि करिहौ ॥",
      "sourceLineId": "121048",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਖੋਦਿ ਭੂਮਿ ਇਕ ਚਰਿਤ੍ਰ ਦਿਖੈਹੌ ॥",
      "transliteration": "khodh bhoom ik charitr dhikhaihau ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਭੂਮੀ ਪੁਟ ਕੇ ਇਕ ਹੋਰ ਚਰਿਤ੍ਰ ਵਿਖਾਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "खोदि भूमि इक चरित्र दिखैहौ ॥",
      "sourceLineId": "121049",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਵ ਚਰਨਨ ਤਰ ਰਾਵ ਝੁਕੈਹੌ ॥੧੩॥",
      "transliteration": "tav charanan tar raav jhukaihau ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੁਹਾਡੇ ਚਰਨਾ ਉਤੇ ਰਾਜੇ (ਬਿਕ੍ਰਮ ਸਿੰਘ) ਨੂੰ ਪਾ ਦਿਆਂਗੀ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "तव चरनन तर राव झुकैहौ ॥१३॥",
      "sourceLineId": "121050",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਯੌ ਕਹਿ ਮੂੰਦਿ ਦੁਆਰਨ ਲਿਯੋ ॥",
      "transliteration": "yau keh moo(n)dh dhuaaran liyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਕਹਿ ਕੇ (ਉਸ ਨੇ) ਦਰਵਾਜ਼ਾ ਬੰਦ ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "यौ कहि मूँदि दुआरन लियो ॥",
      "sourceLineId": "121051",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਆਗੇ ਢੇਰ ਭਸਮ ਤਿਹ ਕਿਯੋ ॥",
      "transliteration": "aage dder bhasam teh kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਅਗੇ ਭਸਮ (ਵਿਭੂਤੀ) ਦਾ ਢੇਰ ਲਗਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "आगे ढेर भसम तिह कियो ॥",
      "sourceLineId": "121052",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਪੁ ਰਾਵ ਸੌ ਜਾਇ ਜਤਾਯੋ ॥",
      "transliteration": "aap raav sau jai jataayo ||",
      "translation": "",
      "punjabiViakhya": "ਆਪ ਜਾ ਕੇ ਰਾਜੇ ਨੂੰ ਦਸਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "आपु राव सौ जाइ जतायो ॥",
      "sourceLineId": "121053",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੋਵਤ ਸਮੈ ਸੁਪਨ ਮੈ ਪਾਯੋ ॥੧੪॥",
      "transliteration": "sovat samai supan mai paayo ||14||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਸੁੱਤੀ ਹੋਈ ਨੇ ਮੈਂ ਸੁਪਨਾ ਵੇਖਿਆ ਹੈ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "सोवत समै सुपन मै पायो ॥१४॥",
      "sourceLineId": "121054",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਇਕ ਜੋਗੀ ਸੁਪਨੇ ਮੈ ਲਹਿਯੋ ॥",
      "transliteration": "eik jogee supane mai lahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਪਨੇ ਵਿਚ (ਮੈਂ) ਇਕ ਜੋਗੀ ਵੇਖਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "इक जोगी सुपने मै लहियो ॥",
      "sourceLineId": "121055",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਿਹ ਮੋ ਸੋ ਐਸੇ ਜਨੁ ਕਹਿਯੋ ॥",
      "transliteration": "teh mo so aaise jan kahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਮੈਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "तिह मो सो ऐसे जनु कहियो ॥",
      "sourceLineId": "121056",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਖੋਦਿ ਭੂਮਿ ਤੁਮ ਮੋਹਿ ਨਿਕਾਰੋ ॥",
      "transliteration": "khodh bhoom tum moh nikaaro ||",
      "translation": "",
      "punjabiViakhya": "ਭੂਮੀ ਪੁਟ ਕੇ ਮੈਨੂੰ (ਬਾਹਰ) ਕਢੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "खोदि भूमि तुम मोहि निकारो ॥",
      "sourceLineId": "121057",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹ੍ਵੈ ਬਡੋ ਪ੍ਰਤਾਪ ਤਿਹਾਰੋ ॥੧੫॥",
      "transliteration": "havai baddo prataap tihaaro ||15||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਕਰ ਕੇ) ਤੁਹਾਡਾ ਬਹੁਤ ਪ੍ਰਤਾਪ ਹੋਵੇਗਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "ह्वै बडो प्रताप तिहारो ॥१५॥",
      "sourceLineId": "121058",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭੂਧਰ ਰਾਜ ਖੋਦਬੋ ਲਾਯੋ ॥",
      "transliteration": "bhoodhar raaj khodhabo laayo ||",
      "translation": "",
      "punjabiViakhya": "ਭੂਧਰ ਰਾਜੇ ਨੂੰ ਵੀ ਪੁਟਣ ਲਈ ਲਗਾਇਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "भूधर राज खोदबो लायो ॥",
      "sourceLineId": "121059",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮੈ ਤੁਮ ਸੋ ਯੌ ਆਨਿ ਸੁਨਾਯੋ ॥",
      "transliteration": "mai tum so yau aan sunaayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ (ਇਹ ਵੇਖ ਕੇ) ਤੁਹਾਨੂੰ ਆ ਕੇ ਦਸਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "मै तुम सो यौ आनि सुनायो ॥",
      "sourceLineId": "121060",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤੁਮਹੂੰ ਚਲੇ ਸੰਗ ਹ੍ਵੈ ਤਹਾ ॥",
      "transliteration": "tumahoo(n) chale sa(n)g havai tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਮੇਰੇ ਨਾਲ ਉਥੇ ਚਲੋ (ਅਤੇ ਵੇਖੋ)",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "तुमहूँ चले संग ह्वै तहा ॥",
      "sourceLineId": "121061",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਹਾ ਚਰਿਤ੍ਰ ਹ੍ਵੈ ਹੈ ਧੌ ਉਹਾ ॥੧੬॥",
      "transliteration": "kahaa charitr havai hai dhau uhaa ||16||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਕੀ ਵਾਪਰ ਰਿਹਾ ਹੈ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "कहा चरित्र ह्वै है धौ उहा ॥१६॥",
      "sourceLineId": "121062",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਯੌ ਕਹਿ ਨ੍ਰਿਪਤਿ ਸੰਗ ਲੈ ਆਈ ॥",
      "transliteration": "yau keh nirapat sa(n)g lai aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਕਹਿ ਕੇ (ਉਹ) ਰਾਜੇ ਨੂੰ ਨਾਲ ਲੈ ਆਈ",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "यौ कहि नृपति संग लै आई ॥",
      "sourceLineId": "121063",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭੂਅ ਖੋਦਨ ਤ੍ਰਿਯ ਦਯੋ ਲਗਾਈ ॥",
      "transliteration": "bhooa khodhan tiray dhayo lagaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸਤਰੀਆਂ (ਗੋਲੀਆਂ) ਨੂੰ ਧਰਤੀ ਪੁਟਣ ਤੇ ਲਗਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "भूअ खोदन तृय दयो लगाई ॥",
      "sourceLineId": "121064",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮੰਡਪ ਤਹਾ ਏਕ ਜਬ ਲਹਿਯੋ ॥",
      "transliteration": "ma(n)ddap tahaa ek jab lahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਥੇ (ਰਾਜੇ ਨੇ) ਇਕ ਮਠ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "मंडप तहा एक जब लहियो ॥",
      "sourceLineId": "121065",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਧੰਨ੍ਯ ਧੰਨ੍ਯ ਪਤਿ ਤ੍ਰਿਯ ਸੋ ਕਹਿਯੋ ॥੧੭॥",
      "transliteration": "dha(n)nay dha(n)nay pat tiray so kahiyo ||17||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਪਤੀ ਨੇ ਇਸਤਰੀ ਨੂੰ ਧੰਨ ਧੰਨ ਕਿਹਾ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "धंन्य धंन्य पति तृय सो कहियो ॥१७॥",
      "sourceLineId": "121066",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜੋਗੀ ਨਿਰਖਿ ਸਖੀ ਭਜਿ ਆਈ ॥",
      "transliteration": "jogee nirakh sakhee bhaj aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋਗੀ ਨੂੰ ਵੇਖ ਕੇ (ਇਕ) ਸਖੀ ਭਜ ਕੇ ਆਈ",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "जोगी निरखि सखी भजि आई ॥",
      "sourceLineId": "121067",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਦੌਰਿ ਨ੍ਰਿਪਤਿ ਚਰਨਨ ਲਪਟਾਈ ॥",
      "transliteration": "dhauar nirapat charanan lapaTaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਦੇ ਚਰਨਾ ਨਾਲ ਲਿਪਟ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "दौरि नृपति चरनन लपटाई ॥",
      "sourceLineId": "121068",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਹਿਯੋ ਸੁ ਜਬ ਖੋਲਤ ਦ੍ਰਿਗ ਭਯੋ ॥",
      "transliteration": "kahiyo su jab kholat dhirag bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਹਿਣ ਲਗੀ ਕਿ ਜਦ (ਜੋਗੀ ਨੇ) ਅੱਖਾ ਖੋਲ੍ਰਹੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "कहियो सु जब खोलत दृग भयो ॥",
      "sourceLineId": "121069",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਤਬ ਹੀ ਰਾਜ ਭਸਮ ਹ੍ਵੈ ਗਯੋ ॥੧੮॥",
      "transliteration": "tab hee raaj bhasam havai gayo ||18||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਦੋਂ ਹੀ ਰਾਜਾ (ਭੂਧਰ) ਭਸਮ ਹੋ ਗਿਆ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "तब ही राज भसम ह्वै गयो ॥१८॥",
      "sourceLineId": "121070",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਯੌ ਬਚਨ ਉਚਾਰੇ ॥",
      "transliteration": "tab raanee yau bachan uchaare ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "तब रानी यौ बचन उचारे ॥",
      "sourceLineId": "121071",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸੁਨਹੋ ਰਾਵ ਪ੍ਰਾਨ ਤੇ ਪ੍ਯਾਰੇ ॥",
      "transliteration": "sunaho raav praan te payaare ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮੇਰੇ ਪ੍ਰਾਣਾ ਤੋਂ ਪਿਆਰੇ ਰਾਜਨ! ਸੁਣੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "सुनहो राव प्रान ते प्यारे ॥",
      "sourceLineId": "121072",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਮੋ ਕੋ ਜਾਨ ਪ੍ਰਥਮ ਤਹ ਦੀਜੈ ॥",
      "transliteration": "mo ko jaan pratham teh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ (ਤੁਸੀਂ) ਮੈਨੂੰ ਪਹਿਲਾ ਜਾਣ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "मो को जान प्रथम तह दीजै ॥",
      "sourceLineId": "121073",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਬਹੁਰੋ ਆਪੁ ਪਯਾਨੋ ਕੀਜੈ ॥੧੯॥",
      "transliteration": "bahuro aap payaano keejai ||19||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ ਤੁਸੀਂ ਆਪ ਆਉਣਾ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "बहुरो आपु पयानो कीजै ॥१९॥",
      "sourceLineId": "121074",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਯੌ ਕਹਿ ਕੈ ਅਬਲਾ ਤਹ ਗਈ ॥",
      "transliteration": "yau keh kai abalaa teh giee ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਕਹਿ ਕੇ ਰਾਣੀ ਉਥੇ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "यौ कहि कै अबला तह गई ॥",
      "sourceLineId": "121075",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਤਾ ਸੋ ਕੇਲ ਕਮਾਵਤ ਭਈ ॥",
      "transliteration": "taa so kel kamaavat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ (ਜੋਗੀ) ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "ता सो केल कमावत भई ॥",
      "sourceLineId": "121076",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਨ੍ਰਿਪ ਕੋ ਤਹ ਲ੍ਯਾਈ ॥",
      "transliteration": "taa paachhe nirap ko teh layaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਿਛੋਂ ਰਾਜੇ ਨੂੰ ਉਥੇ ਲਿਆਈ",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "ता पाछे नृप को तह ल्याई ॥",
      "sourceLineId": "121077",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਜੋਗੀ ਕੀ ਝਾਈ ਦਿਖਰਾਈ ॥੨੦॥",
      "transliteration": "jogee kee jhaiee dhikharaiee ||20||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜੋਗੀ ਦੀ ਪਰਛਾਈ ਵਿਖਾਈ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "जोगी की झाई दिखराई ॥२०॥",
      "sourceLineId": "121078",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਤਬ ਜੋਗੀ ਯੌ ਬਚਨ ਉਚਾਰੇ ॥",
      "transliteration": "tab jogee yau bachan uchaare ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਜੋਗੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "तब जोगी यौ बचन उचारे ॥",
      "sourceLineId": "121079",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਬਹਤ ਜਾਨ੍ਰਹਵੀ ਅਬਿ ਲਗਿ ਥਾਰੇ ॥",
      "transliteration": "bahat jaanrahavee ab lag thaare ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਹਾਡੇ ਨੇੜੇ ਹੁਣ ਗੰਗਾ ਵਗਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "बहत जान्रहवी अबि लगि थारे ॥",
      "sourceLineId": "121080",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਤਾ ਕੋ ਹਮ ਕੋ ਨੀਰ ਦਿਖਰਿਯੈ ॥",
      "transliteration": "taa ko ham ko neer dhikhariyai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਮੈਨੂੰ ਜਲ ਵਿਖਾਓ",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "ता को हम को नीर दिखरियै ॥",
      "sourceLineId": "121081",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਹਮ ਕੋ ਸੋਕ ਨਿਵਾਰਨ ਕਰਿਯੈ ॥੨੧॥",
      "transliteration": "ham ko sok nivaaran kariyai ||21||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰਾ ਦੁਖ ਦੂਰ ਕਰੋ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "हम को सोक निवारन करियै ॥२१॥",
      "sourceLineId": "121082",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਜਬ ਰਾਜੈ ਐਸੇ ਸੁਨਿ ਪਾਯੋ ॥",
      "transliteration": "jab raajai aaise sun paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "जब राजै ऐसे सुनि पायो ॥",
      "sourceLineId": "121083",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਭਰਿ ਗਾਗਰਿ ਗੰਗਾ ਜਲ ਲ੍ਯਾਯੋ ॥",
      "transliteration": "bhar gaagar ga(n)gaa jal layaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਗੰਗਾ-ਜਲ ਦੀ ਗਾਗਰ ਭਰ ਲਿਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "भरि गागरि गंगा जल ल्यायो ॥",
      "sourceLineId": "121084",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਆਇ ਸੁ ਨੀਰ ਬਿਲੋਕਿਯੋ ਜਬ ਹੀ ॥",
      "transliteration": "aai su neer bilokiyo jab hee ||",
      "translation": "",
      "punjabiViakhya": "ਲਿਆਉਾਂਦੇ ਹੋਏ ਜਲ ਨੂੰ ਜਦ (ਜੋਗੀ ਨੇ) ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "आइ सु नीर बिलोकियो जब ही ॥",
      "sourceLineId": "121085",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਐਸੇ ਬਚਨ ਉਚਾਰੇ ਤਬ ਹੀ ॥੨੨॥",
      "transliteration": "aaise bachan uchaare tab hee ||22||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਸ ਤਰ੍ਰਹਾ ਬਚਨ ਕੀਤਾ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "ऐसे बचन उचारे तब ही ॥२२॥",
      "sourceLineId": "121086",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਨਿਜੁ ਤੂੰਬਾ ਤੇ ਦੂਧ ਦਿਖਾਯੋ ॥",
      "transliteration": "nij too(n)baa te dhoodh dhikhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਤੂੰਬੇ (ਵਿਚ ਪਿਆ) ਦੁੱਧ (ਜੋਗੀ ਨੇ) ਵਿਖਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "निजु तूँबा ते दूध दिखायो ॥",
      "sourceLineId": "121087",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਗੰਗੋਦਕ ਤਹਿ ਕੋ ਠਹਰਾਯੋ ॥",
      "transliteration": "ga(n)godhak teh ko Thaharaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਗੰਗਾ-ਜਲ ਦਸਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "गंगोदक तहि को ठहरायो ॥",
      "sourceLineId": "121088",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਕਹਿਯੋ ਜਾਨ੍ਰਹਵੀ ਕੋ ਕਾ ਭਯੋ ॥",
      "transliteration": "kahiyo jaanrahavee ko kaa bhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਕਹਿਣ ਲਗਾ (ਪਤਾ ਨਹੀਂ) ਗੰਗਾ ਨੂੰ ਕੀ ਹੋ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "कहियो जान्रहवी को का भयो ॥",
      "sourceLineId": "121089",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1020_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਤਬ ਪੈ ਥੋ ਅਬ ਜਲ ਹ੍ਵੈ ਗਯੋ ॥੨੩॥",
      "transliteration": "tab pai tho ab jal havai gayo ||23||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਇਹ ਦੁੱਧ ('ਪੈ') ਸੀ, ਹੁਣ ਪਾਣੀ ਹੋ ਗਿਆ ਹੈ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1020,
      "hindi": "",
      "hindiTransliteration": "तब पै थो अब जल ह्वै गयो ॥२३॥",
      "sourceLineId": "121090",
      "sourceShabadId": "11228",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
