{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1021,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1021_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "121091",
      "sourceShabadId": "11229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਤਿਜੁਗ ਕੇ ਜੁਗ ਮੈ ਹਮੋ ਯਾ ਮੈ ਕਿਯੋ ਨਿਵਾਸ ॥",
      "transliteration": "satijug ke jug mai hamo yaa mai kiyo nivaas ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਸਤਿਯੁਗ ਵਿਚ ਇਥੇ ਨਿਵਾਸ ਕੀਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "सतिजुग के जुग मै हमो या मै कियो निवास ॥",
      "sourceLineId": "121092",
      "sourceShabadId": "11229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਬ ਬਰਤਤ ਜੁਗ ਕੌਨ ਸੋ ਸੋ ਤੁਮ ਕਹਹੁ ਪ੍ਰਕਾਸ ॥੨੪॥",
      "transliteration": "ab baratat jug kauan so so tum kahahu prakaas ||24||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਮੈਨੂੰ ਦਸੋ ਕਿ ਹੁਣ ਕਿਹੜਾ ਯੁਗ ਚਲ ਰਿਹਾ ਹੈ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "अब बरतत जुग कौन सो सो तुम कहहु प्रकास ॥२४॥",
      "sourceLineId": "121093",
      "sourceShabadId": "11229",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "121094",
      "sourceShabadId": "11230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਤਿਜੁਗ ਬੀਤੇ ਤ੍ਰੇਤਾ ਭਯੋ ॥",
      "transliteration": "satijug beete tretaa bhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ ਦਸਿਆ ਗਿਆ ਕਿ) ਸਤਿਯੁਗ ਬੀਤਣ ਤੋਂ ਬਾਦ ਤ੍ਰੇਤਾ ਗੁਜ਼ਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "सतिजुग बीते त्रेता भयो ॥",
      "sourceLineId": "121095",
      "sourceShabadId": "11230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਦ੍ਵਾਪਰ ਬਰਤਯੋ ॥",
      "transliteration": "taa paachhe dhavaiaapar baratayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਪਿਛੋਂ ਦ੍ਵਾਪਰ ਵੀ ਵਰਤ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "ता पाछे द्वापर बरतयो ॥",
      "sourceLineId": "121096",
      "sourceShabadId": "11230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਬ ਤੇ ਸੁਨੁ ਕਲਜੁਗ ਅਬ ਆਯੋ ॥",
      "transliteration": "tab te sun kalajug ab aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤੋਂ ਸੁਣਿਆ ਹੈ, ਹੁਣ ਕਲਿਯੁਗ ਆ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "तब ते सुनु कलजुग अब आयो ॥",
      "sourceLineId": "121097",
      "sourceShabadId": "11230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੁ ਤੁਹਿ ਕਹ ਹਮ ਪ੍ਰਗਟ ਸੁਨਾਯੋ ॥੨੫॥",
      "transliteration": "s tuh keh ham pragaT sunaayo ||25||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਅਸੀਂ ਸਪਸ਼ਟ ਰੂਪ ਵਿਚ ਤੁਹਾਨੂੰ ਦਸ ਦਿੱਤਾ ਹੈ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "सु तुहि कह हम प्रगट सुनायो ॥२५॥",
      "sourceLineId": "121098",
      "sourceShabadId": "11230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਲਜੁਗ ਨਾਮ ਜਬੈ ਸੁਨਿ ਲਯੋ ॥",
      "transliteration": "kalajug naam jabai sun layo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਜੋਗੀ ਨੇ) ਕਲਿਯੁਗ ਦਾ ਨਾ ਸੁਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "कलजुग नाम जबै सुनि लयो ॥",
      "sourceLineId": "121099",
      "sourceShabadId": "11230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਹਾਹਾ ਸਬਦ ਉਚਾਰਤ ਭਯੋ ॥",
      "transliteration": "haahaa sabadh uchaarat bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ 'ਹਾਇ ਹਾਇ' ਸ਼ਬਦ ਬੋਲਣ ਲਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "हाहा सबद उचारत भयो ॥",
      "sourceLineId": "121100",
      "sourceShabadId": "11230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਿਹਿ ਮੁਹਿ ਬਾਤ ਲਗਨ ਨਹਿ ਦੀਜੈ ॥",
      "transliteration": "teh muh baat lagan neh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਮੈਨੂੰ ਹਵਾ ('ਬਾਤ') ਨਾ ਲਗਣ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "तिहि मुहि बात लगन नहि दीजै ॥",
      "sourceLineId": "121101",
      "sourceShabadId": "11230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਹੁਰੋ ਮੂੰਦਿ ਦੁਆਰਨ ਲੀਜੈ ॥੨੬॥",
      "transliteration": "bahuro moo(n)dh dhuaaran leejai ||26||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦਰਵਾਜ਼ੇ ਨੂੰ ਦੋਬਾਰਾ ਬੰਦ ਕਰ ਲਓ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "बहुरो मूँदि दुआरन लीजै ॥२६॥",
      "sourceLineId": "121102",
      "sourceShabadId": "11230",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਾਨੀ ਬਾਚ ॥",
      "transliteration": "raanee baach ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "रानी बाच ॥",
      "sourceLineId": "121103",
      "sourceShabadId": "11231",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੈ ਸੇਵਾ ਤੁਮਰੀ ਪ੍ਰਭੁ ਕਰਿਹੋ ॥",
      "transliteration": "mai sevaa tumaree prabh kariho ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪ੍ਰਭੂ! ਮੈਂ ਤੁਹਾਡੀ ਸੇਵਾ ਕਰਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "मै सेवा तुमरी प्रभु करिहो ॥",
      "sourceLineId": "121104",
      "sourceShabadId": "11231",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਏਕ ਪਾਇ ਠਾਢੀ ਜਲ ਭਰਿਹੋ ॥",
      "transliteration": "ek pai Thaaddee jal bhariho ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਪੈਰ ਉਤੇ ਖੜੋ ਕੇ (ਤੁਹਾਡੇ ਲਈ) ਪਾਣੀ ਭਰਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "एक पाइ ठाढी जल भरिहो ॥",
      "sourceLineId": "121105",
      "sourceShabadId": "11231",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮੂੰਦਿਨ ਦ੍ਵਾਰਨ ਕੋ ਕ੍ਯੋਨ ਲੀਜੈ ॥",
      "transliteration": "moo(n)dhin dhavaiaaran ko kayon leejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਦਰਵਾਜ਼ੇ ਨੂੰ ਕਿਉਾਂ ਬੰਦ ਕਰਦੇ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "मूँदिन द्वारन को क्योन लीजै ॥",
      "sourceLineId": "121106",
      "sourceShabadId": "11231",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਮ ਪਰ ਨਾਥ ਅਨੁਗ੍ਰਹੁ ਕੀਜੈ ॥੨੭॥",
      "transliteration": "ham par naath anugrahu keejai ||27||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਨਾਥ! ਸਾਡੇ ਉਤੇ ਕ੍ਰਿਪਾ ਕਰੋ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "हम पर नाथ अनुग्रहु कीजै ॥२७॥",
      "sourceLineId": "121107",
      "sourceShabadId": "11231",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪੁਨਿ ਰਾਜੈ ਯੌ ਬਚਨ ਉਚਾਰੋ ॥",
      "transliteration": "pun raajai yau bachan uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਰਾਜੇ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "पुनि राजै यौ बचन उचारो ॥",
      "sourceLineId": "121108",
      "sourceShabadId": "11231",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਕਰਹੁ ਮੈ ਦਾਸ ਤਿਹਾਰੋ ॥",
      "transliteration": "kirapaa karahu mai dhaas tihaaro ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਨਾਥ! ਕ੍ਰਿਪਾ ਕਰੋ, ਮੈਂ ਤੁਹਾਡਾ ਦਾਸ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "कृपा करहु मै दास तिहारो ॥",
      "sourceLineId": "121109",
      "sourceShabadId": "11231",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਯਹ ਰਾਨੀ ਸੇਵਾ ਕਹ ਲੀਜੈ ॥",
      "transliteration": "yeh raanee sevaa keh leejai ||",
      "translation": "",
      "punjabiViakhya": "(ਮੇਰੀ) ਇਹ ਰਾਣੀ ਸੇਵਾ ਲਈ ਪ੍ਰਵਾਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "यह रानी सेवा कह लीजै ॥",
      "sourceLineId": "121110",
      "sourceShabadId": "11231",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮੋ ਪਰ ਨਾਥ ਅਨੁਗ੍ਰਹੁ ਕੀਜੈ ॥੨੮॥",
      "transliteration": "mo par naath anugrahu keejai ||28||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਉਤੇ ਮਿਹਰ ਦੀ ਦ੍ਰਿਸ਼ਟੀ ਕਰੋ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "मो पर नाथ अनुग्रहु कीजै ॥२८॥",
      "sourceLineId": "121111",
      "sourceShabadId": "11231",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "121112",
      "sourceShabadId": "11232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੇਵਾ ਕਹ ਰਾਨੀ ਦਈ ਯੌ ਰਾਜੈ ਸੁਖ ਪਾਇ ॥",
      "transliteration": "sevaa keh raanee dhiee yau raajai sukh pai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਸੁਖ ਪੂਰਵਕ ਰਾਣੀ ਸੇਵਾ ਲਈ ਦੇ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "सेवा कह रानी दई यौ राजै सुख पाइ ॥",
      "sourceLineId": "121113",
      "sourceShabadId": "11232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦ੍ਵਾਰਨ ਮੂੰਦਿਨ ਨ ਦਯੋ ਰਹਿਯੋ ਚਰਨ ਲਪਟਾਇ ॥੨੯॥",
      "transliteration": "dhavaiaaran moo(n)dhin na dhayo rahiyo charan lapaTai ||29||",
      "translation": "",
      "punjabiViakhya": "ਦਰਵਾਜ਼ੇ ਨੂੰ ਬੰਦ ਨਾ ਹੋਣ ਦਿੱਤਾ ਅਤੇ ਚਰਨਾ ਨਾਲ ਲਿਪਟ ਗਿਆ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "द्वारन मूँदिन न दयो रहियो चरन लपटाइ ॥२९॥",
      "sourceLineId": "121114",
      "sourceShabadId": "11232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮੂੜ ਰਾਵ ਪ੍ਰਫੁਲਿਤ ਭਯੋ ਸਕਿਯੋ ਨ ਛਲ ਕਛੁ ਪਾਇ ॥",
      "transliteration": "mooR raav prafulit bhayo sakiyo na chhal kachh pai ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਰਾਜਾ ਖ਼ੁਸ਼ ਹੋ ਗਿਆ ਪਰ ਛਲ ਨੂੰ ਕੁਝ ਨਾ ਸਮਝ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "मूड़ राव प्रफुलित भयो सकियो न छल कछु पाइ ॥",
      "sourceLineId": "121115",
      "sourceShabadId": "11232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੇਵਾ ਕੋ ਰਾਨੀ ਦਈ ਤਾਹਿ ਸਿਧ ਠਹਰਾਇ ॥੩੦॥",
      "transliteration": "sevaa ko raanee dhiee taeh sidh Thaharai ||30||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸਿੱਧ (ਜੋਗੀ) ਸਮਝ ਕੇ ਸੇਵਾ ਲਈ ਰਾਣੀ ਦੇ ਦਿੱਤੀ ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "सेवा को रानी दई ताहि सिध ठहराइ ॥३०॥",
      "sourceLineId": "121116",
      "sourceShabadId": "11232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰਾਜ ਮਾਰਿ ਰਾਜਾ ਛਲਿਯੋ ਰਤਿ ਜੋਗੀ ਸੋ ਕੀਨ ॥",
      "transliteration": "raaj maar raajaa chhaliyo rat jogee so keen ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ (ਭੂਧਰ ਸਿੰਘ) ਨੂੰ ਮਾਰ ਕੇ ਰਾਜੇ (ਬਿਭ੍ਰਮ ਦੇਵ) ਨੂੰ ਛਲਿਆ ਅਤੇ ਜੋਗੀ ਨਾਲ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "राज मारि राजा छलियो रति जोगी सो कीन ॥",
      "sourceLineId": "121117",
      "sourceShabadId": "11232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਤਭੁਤ ਚਰਿਤ੍ਰ ਤ੍ਰਿਯਾਨ ਕੌ ਸਕਤ ਨ ਕੋਊ ਚੀਨ ॥੩੧॥",
      "transliteration": "atabhut charitr tirayaan kau sakat na kouoo cheen ||31||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀਆਂ ਦੇ ਅਜੀਬ ਚਰਿਤ੍ਰ ਹਨ, ਉਨ੍ਰਹਾ ਨੂੰ ਕੋਈ ਸਮਝ ਨਹੀਂ ਸਕਦਾ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "अतभुत चरित्र तृयान कौ सकत न कोऊ चीन ॥३१॥",
      "sourceLineId": "121118",
      "sourceShabadId": "11232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਤੈਤਾਲੀਸਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੪੩॥੨੯੦੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau taitaaleesavo charitr samaapatam sat subham sat ||143||2903||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੪੩ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੪੩॥੨੯੦੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ तैतालीसवो चरित्र समापतम सतु सुभम सतु ॥१४३॥२९०३॥अफजूँ॥",
      "sourceLineId": "121119",
      "sourceShabadId": "11232",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "121120",
      "sourceShabadId": "11233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬੀਕਾਨੇਰ ਰਾਵ ਇਕ ਭਾਰੋ ॥",
      "transliteration": "beekaaner raav ik bhaaro ||",
      "translation": "",
      "punjabiViakhya": "ਬੀਕਾਨੇਰ ਵਿਚ ਇਕ ਵੱਡਾ ਰਾਜਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "बीकानेर राव इक भारो ॥",
      "sourceLineId": "121121",
      "sourceShabadId": "11233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤੀਨ ਭਵਨ ਭੀਤਰ ਉਜਿਯਾਰੋ ॥",
      "transliteration": "teen bhavan bheetar ujiyaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਦਾ) ਯਸ਼ ਤਿੰਨਾ ਲੋਕਾ ਵਿਚ ਪਸਰਿਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "तीन भवन भीतर उजियारो ॥",
      "sourceLineId": "121122",
      "sourceShabadId": "11233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਵਤੀ ਸਿੰਗਾਰ ਰਾਵ ਕੀ ਰਾਨੀ ॥",
      "transliteration": "vatee si(n)gaar raav kee raanee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਰਾਜੇ ਦੀ ਸ਼ਿੰਗਾਰ ਵਤੀ ਨਾ ਦੀ ਰਾਣੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "वती सिंगार राव की रानी ॥",
      "sourceLineId": "121123",
      "sourceShabadId": "11233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੁੰਦਰਿ ਭਵਨ ਚੌਦਹੂੰ ਜਾਨੀ ॥੧॥",
      "transliteration": "su(n)dhar bhavan chauadhahoo(n) jaanee ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਚੌਦਾ ਲੋਕਾ ਵਿਚ ਸੁੰਦਰ ਜਾਣਿਆ ਜਾਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "सुँदरि भवन चौदहूँ जानी ॥१॥",
      "sourceLineId": "121124",
      "sourceShabadId": "11233",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "121125",
      "sourceShabadId": "11234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਹਾ ਰਾਇ ਮਹਤਾਬ ਸੁਦਾਗਰ ਆਇਯੋ ॥",
      "transliteration": "tahaa rai mahataab sudhaagar aaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਮਹਤਾਬ ਰਾਇ ਨਾ ਦਾ ਸੌਦਾਗਰ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "तहा राइ महताब सुदागर आइयो ॥",
      "sourceLineId": "121126",
      "sourceShabadId": "11234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਲਖਿ ਰਾਨੀ ਕੋ ਰੂਪ ਹਿਯੋ ਲਲਚਾਇਯੋ ॥",
      "transliteration": "lakh raanee ko roop hiyo lalachaiyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਰੂਪ ਨੂੰ ਵੇਖ ਕੇ ਰਾਣੀ ਦਾ ਮਨ ਲਲਚਾਇਆ (ਅਰਥਾਤ-ਮੋਹਿਤ ਹੋ ਗਈ)।",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "लखि रानी को रूप हियो ललचाइयो ॥",
      "sourceLineId": "121127",
      "sourceShabadId": "11234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭੇਜਿ ਸਹਚਰੀ ਤਿਹ ਗ੍ਰਿਹ ਲਯੋ ਬੁਲਾਇ ਕੈ ॥",
      "transliteration": "bhej sahacharee teh gireh layo bulai kai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ) ਇਕ ਦਾਸੀ ਭੇਜ ਕੇ ਉਸ ਨੂੰ ਘਰ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "भेजि सहचरी तिह गृह लयो बुलाइ कै ॥",
      "sourceLineId": "121128",
      "sourceShabadId": "11234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹੋ ਮਨ ਮਾਨਤ ਰਤਿ ਕਰੀ ਅਧਿਕ ਸੁਖ ਪਾਇ ਕੈ ॥੨॥",
      "transliteration": "ho man maanat rat karee adhik sukh pai kai ||2||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨਾਲ) ਸੁਖ ਪੂਰਵਕ ਮਨ ਇਛਿਤ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "हो मन मानत रति करी अधिक सुख पाइ कै ॥२॥",
      "sourceLineId": "121129",
      "sourceShabadId": "11234",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "121130",
      "sourceShabadId": "11235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਿਤਪ੍ਰਤਿ ਰਾਨੀ ਤਾਹਿ ਬੁਲਾਵੈ ॥",
      "transliteration": "nitaprat raanee taeh bulaavai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਉਸ ਨੂੰ ਹਰ ਰੋਜ਼ ਬੁਲਾਉਾਂਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "नितप्रति रानी ताहि बुलावै ॥",
      "sourceLineId": "121131",
      "sourceShabadId": "11235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਸੋ ਭੋਗ ਕਮਾਵੈ ॥",
      "transliteration": "bhaat bhaat so bhog kamaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਨਾਲ) ਭਾਤ ਭਾਤ ਦੇ ਭੋਗ ਕਰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "भाति भाति सो भोग कमावै ॥",
      "sourceLineId": "121132",
      "sourceShabadId": "11235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਾਨਤ ਰੈਨਿ ਅੰਤ ਜਬ ਆਈ ॥",
      "transliteration": "jaanat rain a(n)t jab aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਵੇਖਦੀ ਕਿ ਰਾਤ ਖ਼ਤਮ ਹੋਣ ਵਾਲੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "जानत रैनि अंत जब आई ॥",
      "sourceLineId": "121133",
      "sourceShabadId": "11235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਾਹਿ ਦੇਤ ਨਿਜੁ ਧਾਮ ਪਠਾਈ ॥੩॥",
      "transliteration": "taeh dhet nij dhaam paThaiee ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੂੰ ਆਪਣੇ ਘਰ ਭੇਜ ਦਿੰਦੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "ताहि देत निजु धाम पठाई ॥३॥",
      "sourceLineId": "121134",
      "sourceShabadId": "11235",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "121135",
      "sourceShabadId": "11236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੁਨਿ ਚੁਨਿ ਭਲੀ ਮਤਾਹ ਸੁਦਾਗਰ ਲ੍ਯਾਵਈ ॥",
      "transliteration": "chun chun bhalee mataeh sudhaagar layaaviee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸੌਦਾਗਰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਚੁਣ ਚੁਣ ਕੇ ਵਪਾਰ ਦਾ ਸਾਮਾਨ ('ਮਤਾਹ') ਲਿਆਉਾਂਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "चुनि चुनि भली मताह सुदागर ल्यावई ॥",
      "sourceLineId": "121136",
      "sourceShabadId": "11236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰਾਨੀ ਤਾ ਕੌ ਪਾਇ ਘਨੋ ਸੁਖ ਪਾਵਈ ॥",
      "transliteration": "raanee taa kau pai ghano sukh paaviee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰ ਕੇ ਰਾਣੀ ਬਹੁਤ ਸੁਖ ਪ੍ਰਾਪਤ ਕਰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "रानी ता कौ पाइ घनो सुख पावई ॥",
      "sourceLineId": "121137",
      "sourceShabadId": "11236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1021_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਤਿ ਧਨ ਛੋਰਿ ਭੰਡਾਰ ਦੇਤ ਤਹਿ ਨਿਤ੍ਯ ਪ੍ਰਤਿ ॥",
      "transliteration": "at dhan chhor bha(n)ddaar dhet teh nitay prat ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਵੀ) ਸੌਦਾਗਰ ਨੂੰ ਖ਼ਜ਼ਾਨਾ ਖੋਲ੍ਰਹ ਕੇ ਰੋਜ਼ ਬਹੁਤ ਧਨ ਦਿੰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1021,
      "hindi": "",
      "hindiTransliteration": "अति धन छोरि भंडार देत तहि नित्य प्रति ॥",
      "sourceLineId": "121138",
      "sourceShabadId": "11236",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
