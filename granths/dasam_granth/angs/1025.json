{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1025,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1025_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰੋਸ ਕਿਯੋ ਤਾ ਪੈ ਹਜਰਤਿ ਅਤਿ ॥",
      "transliteration": "ros kiyo taa pai hajarat at ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਉਤੇ ਬਾਦਸ਼ਾਹ ਨੇ ਬਹੁਤ ਗੁੱਸਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "रोस कियो ता पै हजरति अति ॥",
      "sourceLineId": "121283",
      "sourceShabadId": "11250",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮੁਹਿੰਮ ਸੈਦ ਖਾ ਕਰੀ ਬਿਕਟ ਮਤਿ ॥",
      "transliteration": "muhi(n)m saidh khaa karee bikaT mat ||",
      "translation": "",
      "punjabiViakhya": "ਕਠੋਰ ਮਤ ਵਾਲੇ ਸੈਦ ਖ਼ਾਨ ਨੂੰ (ਉਸ ਨੂੰ ਪਕੜਨ ਲਈ) ਮੁਹਿੰਮ ਉਤੇ ਚੜ੍ਰਹਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "मुहिंम सैद खा करी बिकट मति ॥",
      "sourceLineId": "121284",
      "sourceShabadId": "11250",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਾਹਿ ਮਿਲਾਇ ਬਹੁਰਿ ਗਹਿ ਲੀਨੋ ॥",
      "transliteration": "taeh milai bahur geh leeno ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਮਿਲ ਕੇ ਫਿਰ ਪਕੜ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "ताहि मिलाइ बहुरि गहि लीनो ॥",
      "sourceLineId": "121285",
      "sourceShabadId": "11250",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮੁਲਤਾਨ ਓਰ ਪਯਾਨੋ ਕੀਨੋ ॥੨॥",
      "transliteration": "mulataan or payaano keeno ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੁਲਤਾਨ ਵਲ ਚਲ ਪਿਆ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "मुलतान ओर पयानो कीनो ॥२॥",
      "sourceLineId": "121286",
      "sourceShabadId": "11250",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬੰਧ੍ਰਯੋ ਰਾਵ ਬਾਲਨ ਸੁਨਿ ਪਾਯੋ ॥",
      "transliteration": "ba(n)dhrayo raav baalan sun paayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਪਕੜ ਲਿਆ ਗਿਆ ਹੈ, (ਇਹ ਗੱਲ) ਇਸਤਰੀਆਂ ਨੇ ਸੁਣ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "बंध्रयो राव बालन सुनि पायो ॥",
      "sourceLineId": "121287",
      "sourceShabadId": "11250",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਕਲ ਪੁਰਖ ਕੋ ਭੇਖ ਬਨਾਯੋ ॥",
      "transliteration": "sakal purakh ko bhekh banaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਸਾਰਾ ਮਰਦਾਵਾ ਭੇਸ ਬਣਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "सकल पुरख को भेख बनायो ॥",
      "sourceLineId": "121288",
      "sourceShabadId": "11250",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਾਲੋਚੀ ਸੈਨਾ ਸਭ ਜੋਰੀ ॥",
      "transliteration": "baalochee sainaa sabh joree ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਬਲੋਚੀ ਸੈਨਾ ਨੂੰ ਇਕੱਠਾ ਕਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "बालोची सैना सभ जोरी ॥",
      "sourceLineId": "121289",
      "sourceShabadId": "11250",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਅਰਿ ਪ੍ਰਤਿਨਾ ਤੋਰੀ ॥੩॥",
      "transliteration": "bhaat bhaat ar pratinaa toree ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਨਾਲ ਵੈਰੀ ਦੀ ਸੈਨਾ ਨੂੰ ਤੋੜ ਦਿੱਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "भाति भाति अरि प्रतिना तोरी ॥३॥",
      "sourceLineId": "121290",
      "sourceShabadId": "11250",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "121291",
      "sourceShabadId": "11251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਘੇਰਿ ਸੈਦ ਖਾ ਕੌ ਤ੍ਰਿਯਨ ਐਸੇ ਕਹਿਯੋ ਸੁਨਾਇ ॥",
      "transliteration": "gher saidh khaa kau tirayan aaise kahiyo sunai ||",
      "translation": "",
      "punjabiViakhya": "ਸੈਦ ਖ਼ਾਨ ਨੂੰ ਘੇਰ ਕੇ ਇਸਤਰੀਆਂ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣਾ ਕੇ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "घेरि सैद खा कौ तृयन ऐसे कहियो सुनाइ ॥",
      "sourceLineId": "121292",
      "sourceShabadId": "11251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕੈ ਹਮਰੋ ਪਤਿ ਛੋਰਿਯੈ ਕੈ ਲਰਿਯੈ ਸਮੁਹਾਇ ॥੪॥",
      "transliteration": "kai hamaro pat chhoriyai kai lariyai samuhai ||4||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਤਾ ਸਾਡਾ ਪਤੀ ਛਡ ਦੇ ਜਾ ਫਿਰ ਸਾਡੇ ਨਾਲ ਸਾਹਮਣੇ ਹੋ ਕੇ ਲੜ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "कै हमरो पति छोरियै कै लरियै समुहाइ ॥४॥",
      "sourceLineId": "121293",
      "sourceShabadId": "11251",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "121294",
      "sourceShabadId": "11252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੈਦ ਖਾਨ ਐਸੇ ਬਚਨਨ ਸੁਨਿ ਪਾਇ ਕੈ ॥",
      "transliteration": "saidh khaan aaise bachanan sun pai kai ||",
      "translation": "",
      "punjabiViakhya": "ਸੈਦ ਖ਼ਾਨ ਅਜਿਹੇ ਬਚਨ ਸੁਣ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "सैद खान ऐसे बचनन सुनि पाइ कै ॥",
      "sourceLineId": "121295",
      "sourceShabadId": "11252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚੜਿਯੋ ਜੋਰਿ ਦਲੁ ਪ੍ਰਬਲ ਸੁ ਕੋਪ ਬਢਾਇ ਕੈ ॥",
      "transliteration": "chaRiyo jor dhal prabal su kop baddai kai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਬਹੁਤ ਸਾਰੀ ਸੈਨਾ ਇਕੱਠੀ ਕਰ ਕੇ ਚਲ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "चड़ियो जोरि दलु प्रबल सु कोप बढाइ कै ॥",
      "sourceLineId": "121296",
      "sourceShabadId": "11252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਹੈ ਗੈ ਪੈਦਲ ਬਹੁ ਬਿਧਿ ਦਏ ਸੰਘਾਰਿ ਕੈ ॥",
      "transliteration": "hai gai paidhal bahu bidh dhe sa(n)ghaar kai ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਥੀ, ਘੋੜੇ, ਪੈਦਲ ਆਦਿ ਨੂੰ ਸੰਘਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "है गै पैदल बहु बिधि दए संघारि कै ॥",
      "sourceLineId": "121297",
      "sourceShabadId": "11252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹੋ ਸੂਰਬੀਰ ਬਾਕਨ ਕੌ ਬਾਨ ਪ੍ਰਹਾਰਿ ਕੈ ॥੫॥",
      "transliteration": "ho soorabeer baakan kau baan prahaar kai ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਾਕੇ ਯੋਧਿਆਂ ਨੂੰ ਤੀਰ ਮਾਰ ਕੇ (ਕਈ ਤਰ੍ਰਹਾ ਦਾ ਯੁੱਧ ਕੀਤਾ) ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "हो सूरबीर बाकन कौ बान प्रहारि कै ॥५॥",
      "sourceLineId": "121298",
      "sourceShabadId": "11252",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਭੁਜੰਗ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g chha(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਭੁਜੰਗ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "भुजंग छंद ॥",
      "sourceLineId": "121299",
      "sourceShabadId": "11253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਜੀ ਭੇਰ ਭਾਰੀ ਮਹਾ ਸੂਰ ਗਾਜੇ ॥",
      "transliteration": "bajee bher bhaaree mahaa soor gaaje ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਰੀ ਭੇਰੀ ਵਜੀ ਹੈ ਅਤੇ ਮਹਾਨ ਸੂਰਮੇ ਗੱਜਣ ਲਗੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "बजी भेर भारी महा सूर गाजे ॥",
      "sourceLineId": "121300",
      "sourceShabadId": "11253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬੰਧੇ ਬੀਰ ਬਾਨਾਨ ਬਾਕੇ ਬਿਰਾਜੇ ॥",
      "transliteration": "ba(n)dhe beer baanaan baake biraaje ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਸੂਰਮੇ ਬਾਣਾ ਨੂੰ ਬੰਨ੍ਰਹ ਕੇ ਆ ਬਿਰਾਜੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "बंधे बीर बानान बाके बिराजे ॥",
      "sourceLineId": "121301",
      "sourceShabadId": "11253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਿਤੇ ਸੂਲ ਸੈਥੀਨ ਕੇ ਘਾਇ ਘਾਏ ॥",
      "transliteration": "kite sool saitheen ke ghai ghaae ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਤ੍ਰਿਸ਼ੂਲਾ ਅਤੇ ਸੈਹਥੀਆਂ ਦੇ ਘਾਓ ਲਗੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "किते सूल सैथीन के घाइ घाए ॥",
      "sourceLineId": "121302",
      "sourceShabadId": "11253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਰੇ ਜੂਝਿ ਜਾਹਾਨ ਮਾਨੋ ਨ ਆਏ ॥੬॥",
      "transliteration": "mare joojh jaahaan maano na aae ||6||",
      "translation": "",
      "punjabiViakhya": "ਜੋ (ਯੁੱਧਭੂਮੀ ਵਿਚ) ਜੂਝ ਮਰੇ ਹਨ, ਉਹ ਮਾਨੋ ਇਸ ਸੰਸਾਰ ਵਿਚ ਆਏ ਹੀ ਨਾ ਹੋਣ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "मरे जूझि जाहान मानो न आए ॥६॥",
      "sourceLineId": "121303",
      "sourceShabadId": "11253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗਜੈ ਰਾਜ ਜੂਝੈ ਕਿਤੇ ਬਾਜ ਮਾਰੇ ॥",
      "transliteration": "gajai raaj joojhai kite baaj maare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਹਾਥੀ ਮਾਰੇ ਗਏ ਹਨ ਅਤੇ ਕਿਤੇ ਘੋੜੇ ਮਾਰੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "गजै राज जूझै किते बाज मारे ॥",
      "sourceLineId": "121304",
      "sourceShabadId": "11253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਹੂੰ ਰਾਜ ਘੂਮੈ ਕਹੂੰ ਤਾਜ ਡਾਰੇ ॥",
      "transliteration": "kahoo(n) raaj ghoomai kahoo(n) taaj ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਰਾਜੇ ਘੁੰਮ ਰਹੇ ਹਨ ਅਤੇ ਕਿਤੇ ਤਾਜ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "कहूँ राज घूमै कहूँ ताज डारे ॥",
      "sourceLineId": "121305",
      "sourceShabadId": "11253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਿਤੇ ਪਾਕ ਸਾਹੀਦ ਮੈਦਾਨ ਹੂਏ ॥",
      "transliteration": "kite paak saaheedh maidhaan hooe ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਸ਼ਹੀਦ ਹੋ ਕੇ ਪਵਿਤ੍ਰ ਹੋ ਗਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "किते पाक साहीद मैदान हूए ॥",
      "sourceLineId": "121306",
      "sourceShabadId": "11253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਸੇ ਸ੍ਵਰਗ ਮੋ ਜਾਇ ਮਾਨੋ ਨ ਮੂਏ ॥੭॥",
      "transliteration": "base savairag mo jai maano na mooe ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਵਰਗ ਵਿਚ ਜਾ ਵਸੇ ਹਨ ਮਾਨੋ ਮੋਏ ਹੀ ਨਾ ਹੋਣ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "बसे स्वरग मो जाइ मानो न मूए ॥७॥",
      "sourceLineId": "121307",
      "sourceShabadId": "11253",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "121308",
      "sourceShabadId": "11254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਖੈਰੀ ਜਾਹਿ ਖਗ ਗਹਿ ਮਾਰੈ ॥",
      "transliteration": "khairee jaeh khag geh maarai ||",
      "translation": "",
      "punjabiViakhya": "ਖੈਰੀ ਤਲਵਾਰ ਪਕੜ ਕੇ ਜਿਨ੍ਰਹਾ ਨੂੰ ਮਾਰਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "खैरी जाहि खग गहि मारै ॥",
      "sourceLineId": "121309",
      "sourceShabadId": "11254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗਿਰੈ ਭੂਮਿ ਨ ਰਤੀਕ ਸੰਭਾਰੈ ॥",
      "transliteration": "girai bhoom na rateek sa(n)bhaarai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਧਰਤੀ ਉਤੇ ਡਿਗ ਪੈਂਦੇ ਸਨ ਅਤੇ ਰਤੀ ਭਰ ਵੀ ਨਹੀਂ ਸੰਭਲਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "गिरै भूमि न रतीक संभारै ॥",
      "sourceLineId": "121310",
      "sourceShabadId": "11254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੰਮੀ ਨਿਰਖਿ ਜਾਹਿ ਸਰ ਛੋਰੈ ॥",
      "transliteration": "sa(n)mee nirakh jaeh sar chhorai ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਮੀ ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਬਾਣ ਛਡਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "संमी निरखि जाहि सर छोरै ॥",
      "sourceLineId": "121311",
      "sourceShabadId": "11254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਏਕੈ ਬਾਨ ਮੂੰਡ ਅਰਿ ਤੋਰੈ ॥੮॥",
      "transliteration": "ekai baan moo(n)dd ar torai ||8||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਕੋ ਬਾਣ ਨਾਲ ਵੈਰੀ ਦਾ ਸਿਰ ਪਾੜ ਦਿੰਦੀ ਸੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "एकै बान मूँड अरि तोरै ॥८॥",
      "sourceLineId": "121312",
      "sourceShabadId": "11254",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਵੈਯਾ ॥",
      "transliteration": "savaiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੈਯਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "सवैया ॥",
      "sourceLineId": "121313",
      "sourceShabadId": "11255",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਖਗ ਪਰੇ ਕਹੂੰ ਖੋਲ ਝਰੇ ਕਹੂੰ ਟੂਕ ਗਿਰੇ ਛਿਤ ਤਾਜਨ ਕੇ ॥",
      "transliteration": "khag pare kahoo(n) khol jhare kahoo(n) Took gire chhit taajan ke ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਤਲਵਾਰਾ ਪਈਆਂ ਹਨ ਕਿਤੇ ਮਿਆਨ ਪਏ ਹਨ, ਕਿਤੇ ਧਰਤੀ ਉਤੇ ਤਾਜਾ ਦੇ ਟੁਕੜੇ ਡਿਗੇ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "खग परे कहूँ खोल झरे कहूँ टूक गिरे छित ताजन के ॥",
      "sourceLineId": "121314",
      "sourceShabadId": "11255",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਰੁ ਬਾਨ ਕਹੂੰ ਬਰਛੀ ਕਤਹੂੰ ਕਹੂੰ ਅੰਗ ਕਟੇ ਬਰ ਬਾਜਨ ਕੇ ॥",
      "transliteration": "ar baan kahoo(n) barachhee katahoo(n) kahoo(n) a(n)g kaTe bar baajan ke ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਬਾਣ, ਕਿਤੇ ਬਰਛੀਆਂ ਅਤੇ ਕਿਤੇ ਘੋੜਿਆਂ ਦੇ ਅੰਗ ਕਟੇ ਹੋਏ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "अरु बान कहूँ बरछी कतहूँ कहूँ अंग कटे बर बाजन के ॥",
      "sourceLineId": "121315",
      "sourceShabadId": "11255",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਹੂੰ ਬੀਰ ਪਰੈ ਕਹੂੰ ਚੀਰ ਦਿਪੈ ਕਹੂੰ ਸੂੰਡ ਗਿਰੇ ਗਜਰਾਜਨ ਕੇ ॥",
      "transliteration": "kahoo(n) beer parai kahoo(n) cheer dhipai kahoo(n) soo(n)dd gire gajaraajan ke ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸੂਰਮੇ ਪਏ ਹਨ ਕਿਤੇ ਬਸਤ੍ਰ ਸ਼ੋਭ ਰਹੇ ਹਨ ਅਤੇ ਕਿਤੇ ਹਾਥੀਆਂ ਦੇ ਸੁੰਡ ਡਿਗੇ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "कहूँ बीर परै कहूँ चीर दिपै कहूँ सूँड गिरे गजराजन के ॥",
      "sourceLineId": "121316",
      "sourceShabadId": "11255",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਤਿ ਮਾਰਿ ਪਰੀ ਨ ਸੰਭਾਰਿ ਰਹੀ ਸਭ ਭਾਜਿ ਚਲੇ ਸੁਤ ਰਾਜਨ ਕੇ ॥੯॥",
      "transliteration": "at maar paree na sa(n)bhaar rahee sabh bhaaj chale sut raajan ke ||9||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਅਧਿਕ ਮਾਰ ਪਈ ਹੈ, (ਕਿਸੇ ਨੂੰ ਕੋਈ) ਸੰਭਾਲ ਨਹੀਂ ਰਹੀ ਹੈ ਅਤੇ ਸਭ ਰਾਜ ਕੁਮਾਰ ਭਜ ਚਲੇ ਹਨ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "अति मारि परी न संभारि रही सभ भाजि चले सुत राजन के ॥९॥",
      "sourceLineId": "121317",
      "sourceShabadId": "11255",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "121318",
      "sourceShabadId": "11256",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕੇਤੇ ਬਿਕਟ ਸੁਭਟ ਕਟਿ ਡਾਰੇ ॥",
      "transliteration": "kete bikaT subhaT kaT ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਭਿਆਨਕ ਸੂਰਮੇ ਕਟ ਦਿੱਤੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "केते बिकट सुभट कटि डारे ॥",
      "sourceLineId": "121319",
      "sourceShabadId": "11256",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕੇਤੇ ਕਰੀ ਹਨੇ ਮਤਵਾਰੇ ॥",
      "transliteration": "kete karee hane matavaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਮਸਤ ਹਾਥੀ ਮਾਰੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "केते करी हने मतवारे ॥",
      "sourceLineId": "121320",
      "sourceShabadId": "11256",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦਲ ਪੈਦਲ ਕੇਤੇ ਰਨ ਘਾਏ ॥",
      "transliteration": "dhal paidhal kete ran ghaae ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਪੈਦਲ ਰਣ ਵਿਚ ਮਾਰੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "दल पैदल केते रन घाए ॥",
      "sourceLineId": "121321",
      "sourceShabadId": "11256",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਿਯਤ ਬਚੇ ਲੈ ਪ੍ਰਾਨ ਪਰਾਏ ॥੧੦॥",
      "transliteration": "jiyat bache lai praan paraae ||10||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਜੀਉਾਂਦੇ ਬਚ ਗਏ ਹਨ, ਉਹ ਪ੍ਰਾਣ ਬਚਾ ਕੇ ਭਜ ਗਏ ਹਨ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "जियत बचे लै प्रान पराए ॥१०॥",
      "sourceLineId": "121322",
      "sourceShabadId": "11256",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਖੈਰੀ ਸੰਮੀ ਜਾਤ ਭਈ ਤਹਾ ॥",
      "transliteration": "khairee sa(n)mee jaat bhiee tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਖੈਰੀ ਅਤੇ ਸੰਮੀ ਉਥੇ ਜਾ ਪਹੁੰਚੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "खैरी संमी जात भई तहा ॥",
      "sourceLineId": "121323",
      "sourceShabadId": "11256",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਠਾਢੋ ਸੈਦ ਖਾਨ ਥੋ ਜਹਾ ॥",
      "transliteration": "Thaaddo saidh khaan tho jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਸੈਦ ਖ਼ਾਨ ਖੜੋਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "ठाढो सैद खान थो जहा ॥",
      "sourceLineId": "121324",
      "sourceShabadId": "11256",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਿਜੁ ਹਥਿਯਹਿ ਜੰਜੀਰਹਿ ਡਾਰੇ ॥",
      "transliteration": "nij hathiyeh ja(n)jeereh ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਹਾਥੀਆਂ ਦੀਆਂ ਜ਼ੰਜੀਰਾ (ਧਰਤੀ ਉਤੇ) ਸੁਟ ਦਿੱਤੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "निजु हथियहि जंजीरहि डारे ॥",
      "sourceLineId": "121325",
      "sourceShabadId": "11256",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਹੀ ਜਾਇ ਝਾਰੀ ਤਰਵਾਰੈ ॥੧੧॥",
      "transliteration": "tahee jai jhaaree taravaarai ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਥੇ ਜਾ ਕੇ ਤਲਵਾਰਾ ਝਾੜੀਆਂ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "तही जाइ झारी तरवारै ॥११॥",
      "sourceLineId": "121326",
      "sourceShabadId": "11256",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਖੁਨਸਿ ਖਗ ਖਤ੍ਰਿਯਹਿ ਪ੍ਰਹਾਰਿਯੋ ॥",
      "transliteration": "khunas khag khatirayeh prahaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਖੁਣਸ ਖਾ ਕੇ ਛਤ੍ਰੀ ਸੂਰਮੇ ਉਤੇ ਤਲਵਾਰ ਦਾ ਵਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "खुनसि खग खतृयहि प्रहारियो ॥",
      "sourceLineId": "121327",
      "sourceShabadId": "11256",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪ੍ਰਥਮ ਕਰੀ ਕਰ ਕੌ ਕਟਿ ਡਾਰਿਯੋ ॥",
      "transliteration": "pratham karee kar kau kaT ddaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਹਾਥੀ ਦੀ ਸੁੰਡ ਕਟ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "प्रथम करी कर कौ कटि डारियो ॥",
      "sourceLineId": "121328",
      "sourceShabadId": "11256",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਹੁਰਿ ਖਾਨ ਕੌ ਤੇਗ ਚਲਾਈ ॥",
      "transliteration": "bahur khaan kau teg chalaiee ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਖ਼ਾਨ ਉਤੇ ਖੜਗ ਦਾ ਹਮਲਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "बहुरि खान कौ तेग चलाई ॥",
      "sourceLineId": "121329",
      "sourceShabadId": "11256",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1025_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗ੍ਰੀਵਾ ਬਚੀ ਨਾਕ ਪਰ ਆਈ ॥੧੨॥",
      "transliteration": "greevaa bachee naak par aaiee ||12||",
      "translation": "",
      "punjabiViakhya": "ਗਰਦਨ ਤਾ ਬਚ ਗਈ, ਪਰ ਨੱਕ ਉਤੇ ਆ ਵਜੀ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1025,
      "hindi": "",
      "hindiTransliteration": "ग्रीवा बची नाक पर आई ॥१२॥",
      "sourceLineId": "121330",
      "sourceShabadId": "11256",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
