{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1028,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1028_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਏਕ ਪੁਕਾਰਤ ਊਚ ਚਲੀ ਕੋਸਕ ਗਈ ॥",
      "transliteration": "ek pukaarat uooch chalee kosak giee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਉੱਚੀ ਰੌਲਾ ਪਾਦੀ ਹੋਈ ਇਕ ਕੋਹ ਦੂਰ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "एक पुकारत ऊच चली कोसक गई ॥",
      "sourceLineId": "121451",
      "sourceShabadId": "11273",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਹੁ ਲੋਗਨ ਕੌ ਲ੍ਯਾਇ ਸੁ ਉਨ ਕੌ ਘਾਇ ਕੈ ॥",
      "transliteration": "bahu logan kau layai su un kau ghai kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ (ਰਾਹੀਆਂ ਨੂੰ) ਮਾਰ ਕੇ ਬਹੁਤ ਸਾਰੇ ਲੋਕਾ ਨੂੰ ਲੈ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "बहु लोगन कौ ल्याइ सु उन कौ घाइ कै ॥",
      "sourceLineId": "121452",
      "sourceShabadId": "11273",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹੋ ਕਹਿ ਫਾਸਿਨ ਪਤਿ ਹਨੇ ਦਏ ਦਿਖਰਾਇ ਕੈ ॥੮॥",
      "transliteration": "ho keh faasin pat hane dhe dhikharai kai ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵਿਖਾ ਦਿੱਤਾ ਕਿ ਸਾਡੇ ਪਤੀਆਂ ਨੂੰ ਫਾਹੀਆਂ ਪਾ ਕੇ ਮਾਰ ਦਿੱਤਾ ਗਿਆ ਹੈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "हो कहि फासिन पति हने दए दिखराइ कै ॥८॥",
      "sourceLineId": "121453",
      "sourceShabadId": "11273",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "121454",
      "sourceShabadId": "11274",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪੰਚ ਇਸਤ੍ਰੀ ਤਿਨ ਜੁਤ ਆਈ ॥",
      "transliteration": "pa(n)ch isatree tin jut aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਪੰਜੇ ਇਸਤਰੀਆਂ ਉਨ੍ਰਹਾ (ਲੋਕਾ) ਕੋਲ ਆਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "पंच इसत्री तिन जुत आई ॥",
      "sourceLineId": "121455",
      "sourceShabadId": "11274",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਧਨਵੰਤੀ ਅਤਿ ਠਗਨ ਤਕਾਈ ॥",
      "transliteration": "dhanava(n)tee at Thagan takaiee ||",
      "translation": "",
      "punjabiViakhya": "ਠਗਾ ਨੂੰ (ਇਹ) ਬਹੁਤ ਧਨਵਾਨ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "धनवंती अति ठगन तकाई ॥",
      "sourceLineId": "121456",
      "sourceShabadId": "11274",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪੰਚਨ ਕੇ ਫਾਸੀ ਗਹਿ ਡਾਰੀ ॥",
      "transliteration": "pa(n)chan ke faasee geh ddaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਲੁਟੇਰਿਆਂ ਨੇ ਸਾਡੇ) ਪੰਜ ਪਤੀਆਂ ਨੂੰ ਫਾਸੀ ਲਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "पंचन के फासी गहि डारी ॥",
      "sourceLineId": "121457",
      "sourceShabadId": "11274",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹਮ ਪਾਚੋ ਰਹਿ ਗਈ ਬਿਚਾਰੀ ॥੯॥",
      "transliteration": "ham paacho reh giee bichaaree ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਹੁਣ) ਅਸੀਂ ਪੰਜ ਵਿਚਾਰੀਆਂ ਰਹਿ ਗਈਆਂ ਹਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "हम पाचो रहि गई बिचारी ॥९॥",
      "sourceLineId": "121458",
      "sourceShabadId": "11274",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "121459",
      "sourceShabadId": "11275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪਤਿ ਮਾਰੇ ਫਾਸਿਨ ਠਗਨ ਸਾਥੀ ਰਹਿਯੋ ਨ ਕੋਇ ॥",
      "transliteration": "pat maare faasin Thagan saathee rahiyo na koi ||",
      "translation": "",
      "punjabiViakhya": "ਫਾਸੀ ਲਗਾ ਕੇ ਸਾਡੇ ਪਤੀਆਂ ਨੂੰ ਠਗਾ ਨੇ ਮਾਰ ਦਿੱਤਾ ਹੈ (ਅਤੇ ਸਾਡਾ) ਕੋਈ ਸਾਥੀ ਨਹੀਂ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "पति मारे फासिन ठगन साथी रहियो न कोइ ॥",
      "sourceLineId": "121460",
      "sourceShabadId": "11275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹਮ ਬਨ ਮੈ ਏਕਲ ਤ੍ਰਿਯਾ ਦੈਵ ਕਹਾ ਗਤਿ ਹੋਇ ॥੧੦॥",
      "transliteration": "ham ban mai ekal tirayaa dhaiv kahaa gat hoi ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਸੀਂ ਬਨ ਵਿਚ ਇਕਲੀਆਂ ਇਸਤਰੀਆਂ ਹਾ। ਪਰਮਾਤਮਾ ਜਾਣੇ, ਹੁਣ ਸਾਡਾ ਕੀ ਹਾਲ ਹੋਵੇਗਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "हम बन मै एकल तृया दैव कहा गति होइ ॥१०॥",
      "sourceLineId": "121461",
      "sourceShabadId": "11275",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "121462",
      "sourceShabadId": "11276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਾਜੀ ਕੋਟਵਾਰ ਤਹ ਆਏ ॥",
      "transliteration": "kaajee koTavaar teh aae ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਜ਼ੀ ਅਤੇ ਕੋਤਵਾਲ ਉਥੇ ਆਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "काजी कोटवार तह आए ॥",
      "sourceLineId": "121463",
      "sourceShabadId": "11276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਨਸਿੰਗੇ ਰਨ ਨਾਦ ਬਜਾਏ ॥",
      "transliteration": "ranasi(n)ge ran naadh bajaae ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਸਿੰਘੇ ਅਤੇ ਨਗਾਰੇ ਵਜਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "रनसिंगे रन नाद बजाए ॥",
      "sourceLineId": "121464",
      "sourceShabadId": "11276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕੋਪ ਠਾਨ ਯੌ ਬਚਨ ਉਚਾਰੇ ॥",
      "transliteration": "kop Thaan yau bachan uchaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਰੋਹ ਵਿਚ ਆ ਕੇ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "कोप ठान यौ बचन उचारे ॥",
      "sourceLineId": "121465",
      "sourceShabadId": "11276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹਮ ਸਾਥੀ ਇਹ ਠਾਉ ਤਿਹਾਰੇ ॥੧੧॥",
      "transliteration": "ham saathee ieh Thaau tihaare ||11||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਥੇ ਅਸੀਂ ਤੁਹਾਡੇ ਸਾਥੀ ਹਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "हम साथी इह ठाउ तिहारे ॥११॥",
      "sourceLineId": "121466",
      "sourceShabadId": "11276",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "121467",
      "sourceShabadId": "11277",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚਾਰਿ ਊਟ ਮੁਹਰਨ ਭਰੇ ਆਠ ਰੁਪੈਯਨ ਸਾਥ ॥",
      "transliteration": "chaar uooT muharan bhare aaTh rupaiyan saath ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਕਹਿਣ ਲਗੀਆਂ ਕਿ) ਚਾਰ ਊਠ ਮੋਹਰਾ ਨਾਲ ਲਦੇ ਹੋਏ ਹਨ ਅਤੇ ਅੱਠ ਰੁਪੈਯਾ ਨਾਲ (ਲਦੇ ਹੋਏ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "चारि ऊट मुहरन भरे आठ रुपैयन साथ ॥",
      "sourceLineId": "121468",
      "sourceShabadId": "11277",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪਤਿ ਮੂਏ ਏਊ ਗਏ ਤੌ ਹਮ ਭਈ ਅਨਾਥ ॥੧੨॥",
      "transliteration": "pat mooe euoo ge tau ham bhiee anaath ||12||",
      "translation": "",
      "punjabiViakhya": "ਪਤੀ ਇਸ ਤਰ੍ਰਹਾ ਮਰ ਗਏ ਹਨ ਅਤੇ ਅਸੀਂ ਅਨਾਥ ਹੋ ਗਈਆਂ ਹਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "पति मूए एऊ गए तौ हम भई अनाथ ॥१२॥",
      "sourceLineId": "121469",
      "sourceShabadId": "11277",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "121470",
      "sourceShabadId": "11278",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਬ ਕਾਜੀ ਇਹ ਭਾਤਿ ਉਚਾਰੋ ॥",
      "transliteration": "tab kaajee ieh bhaat uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕਾਜ਼ੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "तब काजी इह भाति उचारो ॥",
      "sourceLineId": "121471",
      "sourceShabadId": "11278",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤ੍ਰਿਯਾ ਕਛੂ ਜਿਨਿ ਸੋਕ ਬਿਚਾਰੋ ॥",
      "transliteration": "tirayaa kachhoo jin sok bichaaro ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਇਸਤਰੀਓ! (ਤੁਸੀਂ) ਕੁਝ ਵੀ ਦੁਖ ਨਾ ਮਨਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "तृया कछू जिनि सोक बिचारो ॥",
      "sourceLineId": "121472",
      "sourceShabadId": "11278",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਮ ਕੌ ਫਾਰਖਤੀ ਲਿਖ ਦੀਜੈ ॥",
      "transliteration": "ham kau faarakhatee likh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਨੂੰ ਫ਼ਾਰਖ਼ਤੀ (ਬੇਬਾਕੀ ਦੀ ਚਿੱਠੀ ਪਤਰੀ) ਲਿਖ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "हम कौ फारखती लिख दीजै ॥",
      "sourceLineId": "121473",
      "sourceShabadId": "11278",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦ੍ਵਾਦਸ ਊਟ ਆਪਨੇ ਲੀਜੈ ॥੧੩॥",
      "transliteration": "dhavaiaadhas uooT aapane leejai ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਬਾਰ੍ਰਹਾ ਊਠ ਲੈ ਜਾਓ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "द्वादस ऊट आपने लीजै ॥१३॥",
      "sourceLineId": "121474",
      "sourceShabadId": "11278",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "121475",
      "sourceShabadId": "11279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੀਨਨ ਕੀ ਰਛਾ ਕਰੀ ਕੌਡੀ ਗਨੀ ਕੁਪਾਇ ॥",
      "transliteration": "dheenan kee rachhaa karee kauaddee ganee kupai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸਤਰੀਆਂ ਨੇ ਕਿਹਾ, ਤੁਸੀਂ) ਅਸਾ ਅਨਾਥਾ ਦੀ ਰਖਿਆ ਕੀਤੀ ਹੈ ਅਤੇ ਇਕ ਕੌਡੀ ਪ੍ਰਾਪਤ ਕਰਨਾ ਮਾੜਾ ਸਮਝਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "दीनन की रछा करी कौडी गनी कुपाइ ॥",
      "sourceLineId": "121476",
      "sourceShabadId": "11279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਭ ਹੀ ਦਯੋ ਬਹੋਰਿ ਧਨ ਧੰਨ ਕਾਜਿਨ ਕੇ ਰਾਇ ॥੧੪॥",
      "transliteration": "sabh hee dhayo bahor dhan dha(n)n kaajin ke rai ||14||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਤੁਸੀਂ ਸਾਰਾ ਧਨ ਦੇ ਦਿੱਤਾ ਹੈ। ਹੇ ਕਾਜ਼ੀਆਂ ਦੇ ਸੁਆਮੀ! (ਤੁਸੀਂ) ਧੰਨ ਹੋ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "सभ ही दयो बहोरि धन धंन काजिन के राइ ॥१४॥",
      "sourceLineId": "121477",
      "sourceShabadId": "11279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੁਸਟ ਅਰਿਸਟ ਨਿਵਾਰਿ ਕੈ ਲੀਨੋ ਪਤਹ ਬਚਾਇ ॥",
      "transliteration": "dhusaT arisaT nivaar kai leeno pateh bachai ||",
      "translation": "",
      "punjabiViakhya": "ਦੁਸ਼ਟਾ ਅਤੇ ਦੁੱਖਾ ਨੂੰ ਹਟਾ ਕੇ ਪਤੀ ਨੂੰ ਬਚਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "दुसट अरिसट निवारि कै लीनो पतह बचाइ ॥",
      "sourceLineId": "121478",
      "sourceShabadId": "11279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਸੇਵਾ ਕਰੀ ਹੀਏ ਹਰਖ ਉਪਜਾਇ ॥੧੫॥",
      "transliteration": "bhaat bhaat sevaa karee he'ee harakh upajai ||15||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਨ ਵਿਚ ਪ੍ਰਸੰਨ ਹੋ ਕੇ ਉਸ ਦੀ ਕਈ ਤਰ੍ਰਹਾ ਨਾਲ ਸੇਵਾ ਕੀਤੀ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "भाति भाति सेवा करी हीए हरख उपजाइ ॥१५॥",
      "sourceLineId": "121479",
      "sourceShabadId": "11279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਉਨਵਿੰਜਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੪੯॥੨੯੮੯॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau unavi(n)javo charitr samaapatam sat subham sat ||149||2989||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੧੪੯ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੪੯॥੨੯੮੯॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ उनविंजवो चरित्र समापतम सतु सुभम सतु ॥१४९॥२९८९॥अफजूँ॥",
      "sourceLineId": "121480",
      "sourceShabadId": "11279",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "121481",
      "sourceShabadId": "11280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਰਾਨੀ ਏਕ ਨਗੌਰੇ ਰਹੈ ॥",
      "transliteration": "raanee ek nagauare rahai ||",
      "translation": "",
      "punjabiViakhya": "ਨਗੌਰ ਨਗਰ ਵਿਚ ਇਕ ਰਾਣੀ ਰਹਿੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "रानी एक नगौरे रहै ॥",
      "sourceLineId": "121482",
      "sourceShabadId": "11280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗਰਭਵਤੀ ਤਾ ਕੌ ਜਗ ਕਹੈ ॥",
      "transliteration": "garabhavatee taa kau jag kahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜਗਤ ਵਾਲੇ ਗਰਭਵਤੀ ਕਹਿੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "गरभवती ता कौ जग कहै ॥",
      "sourceLineId": "121483",
      "sourceShabadId": "11280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪੂਤ ਰਾਵ ਕੇ ਗ੍ਰਿਹ ਕੋਊ ਨਾਹੀ ॥",
      "transliteration": "poot raav ke gireh kouoo naahee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦੇ ਘਰ ਕੋਈ ਪੁੱਤਰ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "पूत राव के गृह कोऊ नाही ॥",
      "sourceLineId": "121484",
      "sourceShabadId": "11280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚਿੰਤਾ ਇਹੇ ਤਾਹਿ ਮਨ ਮਾਹੀ ॥੧॥",
      "transliteration": "chi(n)taa ihe taeh man maahee ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਮਨ ਵਿਚ ਇਹੀ ਚਿੰਤਾ ਰਹਿੰਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "चिंता इहे ताहि मन माही ॥१॥",
      "sourceLineId": "121485",
      "sourceShabadId": "11280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗਰਭਵਤੀ ਆਪਹਿ ਠਹਿਰਾਯੋ ॥",
      "transliteration": "garabhavatee aapeh Thahiraayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਆਪਣੇ ਆਪ ਨੂੰ ਗਰਭਵਤੀ ਠਹਿਰਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "गरभवती आपहि ठहिरायो ॥",
      "sourceLineId": "121486",
      "sourceShabadId": "11280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪੂਤ ਆਨ ਕੋ ਆਨ ਜਿਵਾਯੋ ॥",
      "transliteration": "poot aan ko aan jivaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਸੇ ਹੋਰ ਦਾ ਪੁੱਤਰ (ਆਪਣੇ ਘਰ ਵਿਚ) ਆ ਜਮਵਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "पूत आन को आन जिवायो ॥",
      "sourceLineId": "121487",
      "sourceShabadId": "11280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਭ ਕੋਊ ਪੂਤ ਰਾਵ ਕੋ ਮਾਨੈ ॥",
      "transliteration": "sabh kouoo poot raav ko maanai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਉਸ ਨੂੰ ਰਾਜੇ ਦਾ ਪੁੱਤਰ ਸਮਝਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "सभ कोऊ पूत राव को मानै ॥",
      "sourceLineId": "121488",
      "sourceShabadId": "11280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਾ ਕੌ ਭੇਦ ਨ ਕੋਊ ਜਾਨੈ ॥੨॥",
      "transliteration": "taa kau bhedh na kouoo jaanai ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਅਸਲ ਭੇਦ ਕੋਈ ਨਹੀਂ ਸਮਝਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "ता कौ भेद न कोऊ जानै ॥२॥",
      "sourceLineId": "121489",
      "sourceShabadId": "11280",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "121490",
      "sourceShabadId": "11281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੋਇ ਪੁਤ੍ਰ ਜਬ ਤਾਹਿ ਬਿਧਾਤੈ ਪੁਨ ਦਏ ॥",
      "transliteration": "dhoi putr jab taeh bidhaatai pun dhe ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਫਿਰ ਪਰਮਾਤਮਾ ਨੇ ਉਸ ਨੂੰ ਦੋ ਪੁੱਤਰ ਦਿੱਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "दोइ पुत्र जब ताहि बिधातै पुन दए ॥",
      "sourceLineId": "121491",
      "sourceShabadId": "11281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰੂਪਵੰਤ ਸੁਭ ਸੀਲ ਜਤ ਬ੍ਰਤ ਹੋਤ ਭੇ ॥",
      "transliteration": "roopava(n)t subh seel jat brat hot bhe ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬਹੁਤ ਰੂਪਵਾਨ, ਸੁਘੜ ਜਤ ਬ੍ਰਤ ਵਾਲੇ ਅਤੇ ਸ਼ੀਲਵਾਨ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "रूपवंत सुभ सील जत ब्रत होत भे ॥",
      "sourceLineId": "121492",
      "sourceShabadId": "11281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਬ ਉਨ ਦੁਹੂੰ ਪਾਲਕਨ ਲੈ ਕੈ ਬਿਖੁ ਦਈ ॥",
      "transliteration": "tab un dhuhoo(n) paalakan lai kai bikh dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਨ੍ਰਹਾ ਦੋਹਾ ਨੇ ਪਾਲੇ ਹੋਏ ਪੁੱਤਰ ਨੂੰ ਵਿਸ਼ ਦੇ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "तब उन दुहूँ पालकन लै कै बिखु दई ॥",
      "sourceLineId": "121493",
      "sourceShabadId": "11281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹੋ ਨਿਜੁ ਪੂਤਨ ਕਹ ਰਾਜ ਪਕਾਵਤ ਤਹ ਭਈ ॥੩॥",
      "transliteration": "ho nij pootan keh raaj pakaavat teh bhiee ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਰਾਣੀ) ਆਪਣੇ ਪੁੱਤਰਾ ਨੂੰ ਰਾਜ ਭਾਗ ਦੇਣ ਦੀ ਸੋਚਣ ਲਗੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "हो निजु पूतन कह राज पकावत तह भई ॥३॥",
      "sourceLineId": "121494",
      "sourceShabadId": "11281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਸੌ ਰੋਦਨ ਕਿਯੋ ਪੁਕਾਰਿ ਕੈ ॥",
      "transliteration": "bhaat bhaat sau rodhan kiyo pukaar kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਭਾਤ ਭਾਤ ਨਾਲ ਕੁਰਲਾ ਕੇ ਰੋਣ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "भाति भाति सौ रोदन कियो पुकारि कै ॥",
      "sourceLineId": "121495",
      "sourceShabadId": "11281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਿਰਖਾ ਤਿਨ ਕੀ ਓਰ ਸਿਰੋਕਚੁਪਾਰਿ ਕੈ ॥",
      "transliteration": "nirakhaa tin kee or sirokachupaar kai ||",
      "translation": "",
      "punjabiViakhya": "ਸਿਰ ਦੇ ਵਾਲ ਪੁਟਦੀ ਹੋਈ ਉਸ ਵਲ ਵੇਖਣ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "निरखा तिन की ओर सिरोकचुपारि कै ॥",
      "sourceLineId": "121496",
      "sourceShabadId": "11281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪ੍ਰਾਨਨਾਥ ਊ ਆਏ ਕਹਿਯੋ ਨ ਸੋਕ ਕਰਿ ॥",
      "transliteration": "praananaath uoo aae kahiyo na sok kar ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਾਣਨਾਥ (ਰਾਜਾ) ਆਇਆ ਅਤੇ ਕਹਿਣ ਲਗਾ, ਦੁਖੀ ਨਾ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1028,
      "hindi": "",
      "hindiTransliteration": "प्राननाथ ऊ आए कहियो न सोक करि ॥",
      "sourceLineId": "121497",
      "sourceShabadId": "11281",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1028_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਹੋ ਅਕਥ ਕਥਾ ਕੀ ਕਥਾ ਜਾਨਿ ਜਿਯ ਧੀਰ ਧਰਿ ॥੪॥",
      "transliteration": "ho akath kathaa kee kathaa jaan jiy dheer dhar ||4||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਅਕਥਨੀ ਪਰਮਾਤਮਾ ਦੀ ਕਥਾ ਜਾਣ ਅਤੇ ਧੀਰਜ ਧਾਰਨ ਕਰ ॥੪॥",
      "source": "DASAM_GRANTH",
