{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1039,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1039_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹੋ ਭਾਤਿ ਭਾਤਿ ਬਾਦਿਤ੍ਰ ਅਨੇਕ ਬਜਾਇ ਕੈ ॥੨੧॥",
      "transliteration": "ho bhaat bhaat baadhitr anek bajai kai ||21||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਨੇਕ ਤਰ੍ਰਹਾ ਦੇ ਵਾਜੇ ਵਜਾ ਕੇ (ਵਿਧੀ ਪੂਰਵਕ) ਵਿਆਹ ਕਰ ਲਿਆ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "हो भाति भाति बादित्र अनेक बजाइ कै ॥२१॥",
      "sourceLineId": "122003",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਧਰਿ ਪੁਹਕਰਿ ਕੋ ਰੂਪ ਤਹਾ ਕਲਿਜੁਗ ਗਯੋ ॥",
      "transliteration": "dhar puhakar ko roop tahaa kalijug gayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਲਿਯੁਗ (ਨਲ ਦੇ ਭਰਾ) ਪੁਹਕਰਿ (ਪੁਸ਼ਕਰ) ਦਾ ਰੂਪ ਧਾਰ ਕੇ ਉਥੇ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "धरि पुहकरि को रूप तहा कलिजुग गयो ॥",
      "sourceLineId": "122004",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਬ ਤਾ ਕੌ ਨਲ ਬ੍ਯਾਹਿ ਸਦਨ ਲ੍ਯਾਵਤ ਭਯੋ ॥",
      "transliteration": "jab taa kau nal bayaeh sadhan layaavat bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਨਾਲ ਦਮਵੰਤੀ ਨੂੰ ਵਿਆਹ ਕੇ ਘਰ ਲਿਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "जब ता कौ नल ब्याहि सदन ल्यावत भयो ॥",
      "sourceLineId": "122005",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਖੇਲਿ ਜੂਪ ਬਹੁ ਭਾਤਿਨ ਤਾਹਿ ਹਰਾਇਯੋ ॥",
      "transliteration": "khel joop bahu bhaatin taeh haraiyo ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਪ੍ਰਕਾਰ ਨਾਲ ਜੂਆ ('ਜੂਪ') ਖੇਡ ਕੇ ਨਲ ਨੂੰ ਹਰਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "खेलि जूप बहु भातिन ताहि हराइयो ॥",
      "sourceLineId": "122006",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹੋ ਰਾਜ ਪਾਟ ਨਲ ਬਨ ਕੌ ਜੀਤਿ ਪਠਾਇਯੋ ॥੨੨॥",
      "transliteration": "ho raaj paaT nal ban kau jeet paThaiyo ||22||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਾ ਰਾਜ ਅਤੇ ਠਾਠ-ਬਾਠ ਜਿਤ ਕੇ ਨਲ ਨੂੰ ਬਨ ਵਿਚ ਭੇਜ ਦਿੱਤਾ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "हो राज पाट नल बन कौ जीति पठाइयो ॥२२॥",
      "sourceLineId": "122007",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਾਜ ਪਾਟ ਨਲ ਜਬ ਇਹ ਭਾਤਿ ਹਰਾਇਯੋ ॥",
      "transliteration": "raaj paaT nal jab ieh bhaat haraiyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਨਲ ਰਾਜ-ਸਾਜ ਇਸ ਤਰ੍ਰਹਾ ਹਾਰ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "राज पाट नल जब इह भाति हराइयो ॥",
      "sourceLineId": "122008",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਨ ਮੈ ਅਤਿ ਦੁਖੁ ਪਾਇ ਅਜੁਧਿਆ ਆਇਯੋ ॥",
      "transliteration": "ban mai at dhukh pai ajudhiaa aaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਬਨ ਵਿਚ ਬਹੁਤ ਦੁਖ ਪ੍ਰਾਪਤ ਕਰ ਕੇ ਅਯੁਧਿਆ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "बन मै अति दुखु पाइ अजुधिआ आइयो ॥",
      "sourceLineId": "122009",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਿਛਰੇ ਪਤਿ ਕੇ ਭੀਮਸੁਤਾ ਬਿਰਹਿਨ ਭਈ ॥",
      "transliteration": "bichhare pat ke bheemasutaa birahin bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਪਤੀ ਦੇ ਵਿਛੜਨ ਕਰ ਕੇ ਦਮਵੰਤੀ ਵਿਯੋਗਨ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "बिछरे पति के भीमसुता बिरहिन भई ॥",
      "sourceLineId": "122010",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੋ ਜਿਹ ਮਾਰਗ ਗੇ ਨਾਥ ਤਿਸੀ ਮਾਰਗ ਗਈ ॥੨੩॥",
      "transliteration": "jo jeh maarag ge naath tisee maarag giee ||23||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਸ ਰਾਹ ਉਤੇ ਪਤੀ ਗਿਆ, ਉਸੇ ਰਸਤੇ ਉਤੇ ਪੈ ਗਈ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "जो जिह मारग गे नाथ तिसी मारग गई ॥२३॥",
      "sourceLineId": "122011",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਭੀਮ ਸੁਤਾ ਬਿਨ ਨਾਥ ਅਧਿਕ ਦੁਖ ਪਾਇਯੋ ॥",
      "transliteration": "bheem sutaa bin naath adhik dhukh paiyo ||",
      "translation": "",
      "punjabiViakhya": "ਦਮਵੰਤੀ ਨੇ ਵੀ ਪਤੀ ਤੋਂ ਬਿਨਾ ਬਹੁਤ ਅਧਿਕ ਦੁਖ ਪਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "भीम सुता बिन नाथ अधिक दुख पाइयो ॥",
      "sourceLineId": "122012",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਹ ਲਗਿ ਕਰੌ ਬਖ੍ਯਾਨ ਨ ਜਾਤ ਬਤਾਇਯੋ ॥",
      "transliteration": "keh lag karau bakhayaan na jaat bataiyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੁਖ ਦਾ) ਕਿਥੋਂ ਤਕ ਵਰਣਨ ਕਰਾ, ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "कह लगि करौ बख्यान न जात बताइयो ॥",
      "sourceLineId": "122013",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਲ ਰਾਜ ਕੇ ਬਿਰਹਿ ਬਾਲ ਬਿਰਹਿਨਿ ਭਈ ॥",
      "transliteration": "nal raaj ke bireh baal birahin bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਨਲ ਰਾਜੇ ਦੇ ਬਿਰਹੋਂ ਵਿਚ ਵਿਯੋਗਣ ਹੋਈ",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "नल राज के बिरहि बाल बिरहिनि भई ॥",
      "sourceLineId": "122014",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹੋ ਸਹਰਿ ਚੰਦੇਰੀ ਮਾਝ ਵਹੈ ਆਵਤ ਭਈ ॥੨੪॥",
      "transliteration": "ho sahar cha(n)dheree maajh vahai aavat bhiee ||24||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਇਸਤਰੀ ਚੰਦੇਰੀ ਨਗਰ ਵਿਚ ਆ ਗਈ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "हो सहरि चंदेरी माझ वहै आवत भई ॥२४॥",
      "sourceLineId": "122015",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਭੀਮਸੈਨ ਤਿਨ ਹਿਤ ਜਨ ਬਹੁ ਪਠਵਤ ਭਏ ॥",
      "transliteration": "bheemasain tin hit jan bahu paThavat bhe ||",
      "translation": "",
      "punjabiViakhya": "ਭੀਮਸੈਨ ਨੇ ਉਸ (ਨੂੰ ਲਭਣ) ਲਈ ਬਹੁਤ ਬੰਦੇ ਭੇਜੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "भीमसैन तिन हित जन बहु पठवत भए ॥",
      "sourceLineId": "122016",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦਮਵੰਤੀ ਕਹ ਖੋਜਿ ਬਹੁਰਿ ਗ੍ਰਿਹ ਲੈ ਗਏ ॥",
      "transliteration": "dhamava(n)tee keh khoj bahur gireh lai ge ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਦਮਵੰਤੀ ਨੂੰ ਲਭ ਕੇ ਫਿਰ ਘਰ ਲੈ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "दमवंती कह खोजि बहुरि गृह लै गए ॥",
      "sourceLineId": "122017",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਵਹੈ ਜੁ ਇਹ ਲੈ ਗਯੋ ਦਿਜ ਬਹੁਰਿ ਪਠਾਇਯੋ ॥",
      "transliteration": "vahai ju ieh lai gayo dhij bahur paThaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ (ਦਮਵੰਤੀ ਨੂੰ) ਲਭ ਲਿਆਏ ਸਨ ਉਨ੍ਰਹਾ ਬ੍ਰਾਹਮਣਾ ਨੂੰ ਫਿਰ (ਨਲ ਨੂੰ ਲਭਣ ਲਈ) ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "वहै जु इह लै गयो दिज बहुरि पठाइयो ॥",
      "sourceLineId": "122018",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹੋ ਖੋਜਤ ਖੋਜਤ ਦੇਸ ਅਜੁਧ੍ਰਯਾ ਆਇਯੋ ॥੨੫॥",
      "transliteration": "ho khojat khojat dhes ajudhrayaa aaiyo ||25||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਹ ਖੋਜਦੇ ਖੋਜਦੇ ਆਯੁਧਿਆ ਆ ਪਹੁੰਚੇ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "हो खोजत खोजत देस अजुध्रया आइयो ॥२५॥",
      "sourceLineId": "122019",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਹੇਰਿ ਹੇਰਿ ਬਹੁ ਲੋਗ ਸੁ ਯਾਹਿ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "her her bahu log su yaeh nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਸਾਰੇ ਲੋਕਾ ਨੂੰ ਵੇਖ ਵੇਖ ਕੇ ਫਿਰ ਉਸ (ਨਲ) ਨੂੰ ਤਕਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "हेरि हेरि बहु लोग सु याहि निहारियो ॥",
      "sourceLineId": "122020",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦਮਵੰਤੀ ਕੋ ਮੁਖ ਤੇ ਨਾਮ ਉਚਾਰਿਯੋ ॥",
      "transliteration": "dhamava(n)tee ko mukh te naam uchaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦਮਵੰਤੀ ਦਾ ਨਾ ਮੂੰਹੋਂ ਉਚਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "दमवंती को मुख ते नाम उचारियो ॥",
      "sourceLineId": "122021",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕੁਸਲ ਤਾਹਿ ਇਹ ਪੂਛਿਯੋ ਨੈਨਨ ਨੀਰ ਭਰਿ ॥",
      "transliteration": "kusal taeh ieh poochhiyo nainan neer bhar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਅੱਖਾ ਵਿਚ ਜਲ ਭਰ ਕੇ ਉਸ (ਦਮਵੰਤੀ) ਦੀ ਸੁਖ ਸਾਦ ਪੁਛੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "कुसल ताहि इह पूछियो नैनन नीर भरि ॥",
      "sourceLineId": "122022",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹੋ ਤਬ ਦਿਜ ਗਯੋ ਪਛਾਨਿ ਇਹੈ ਨਲ ਨ੍ਰਿਪਤਿ ਬਰ ॥੨੬॥",
      "transliteration": "ho tab dhij gayo pachhaan ihai nal nirapat bar ||26||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਬ੍ਰਾਹਮਣ ਪਛਾਣ ਗਏ ਕਿ ਇਹੀ ਨਲ ਰਾਜਾ ਹੈ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "हो तब दिज गयो पछानि इहै नल नृपति बर ॥२६॥",
      "sourceLineId": "122023",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਾਇ ਤਿਨੈ ਸੁਧਿ ਦਈ ਨ੍ਰਿਪਤਿ ਨਲ ਪਾਇਯੋ ॥",
      "transliteration": "jai tinai sudh dhiee nirapat nal paiyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਨ੍ਰਹਾ ਨੇ ਜਾ ਕੇ ਸੂਚਨਾ ਦਿੱਤੀ ਕਿ ਨਲ ਰਾਜਾ ਮਿਲ ਗਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "जाइ तिनै सुधि दई नृपति नल पाइयो ॥",
      "sourceLineId": "122024",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਬ ਦਮਵੰਤੀ ਬਹੁਰਿ ਸੁਯੰਬ੍ਰ ਬਨਾਇਯੋ ॥",
      "transliteration": "tab dhamava(n)tee bahur suya(n)br banaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦਮਵੰਤੀ ਨੇ ਦੋਬਾਰਾ ਸੁਅੰਬਰ ਦੀ ਵਿਵਸਥਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "तब दमवंती बहुरि सुयंब्र बनाइयो ॥",
      "sourceLineId": "122025",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੁਨਿ ਰਾਜਾ ਏ ਬੈਨ ਸਕਲ ਚਲਿ ਤਹ ਗਏ ॥",
      "transliteration": "sun raajaa e bain sakal chal teh ge ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ (ਭੀਮਸੈਨ) ਦੇ ਬੋਲ ਸੁਣ ਕੇ ਸਾਰੇ (ਰਾਜੇ) ਚਲ ਕੇ ਉਥੇ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "सुनि राजा ए बैन सकल चलि तह गए ॥",
      "sourceLineId": "122026",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹੋ ਰਥ ਪੈ ਚੜਿ ਨਲ ਰਾਜ ਤਹਾ ਆਵਤ ਭਏ ॥੨੭॥",
      "transliteration": "ho rath pai chaR nal raaj tahaa aavat bhe ||27||",
      "translation": "",
      "punjabiViakhya": "ਨਲ ਰਾਜਾ ਵੀ ਰਥ ਉਤੇ ਚੜ੍ਰਹ ਕੇ ਉਥੇ ਆ ਗਿਆ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "हो रथ पै चड़ि नल राज तहा आवत भए ॥२७॥",
      "sourceLineId": "122027",
      "sourceShabadId": "11348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122028",
      "sourceShabadId": "11349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨ੍ਰਿਪ ਨਲ ਕੌ ਰਥ ਪੈ ਚੜੇ ਸਭ ਜਨ ਗਏ ਪਛਾਨਿ ॥",
      "transliteration": "nirap nal kau rath pai chaRe sabh jan ge pachhaan ||",
      "translation": "",
      "punjabiViakhya": "ਨਲ ਰਾਜੇ ਨੂੰ ਰਥ ਉਤੇ ਚੜ੍ਰਹੇ ਹੋਇਆਂ (ਵੇਖ ਕੇ) ਸਭ ਲੋਕ ਪਛਾਣ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "नृप नल कौ रथ पै चड़े सभ जन गए पछानि ॥",
      "sourceLineId": "122029",
      "sourceShabadId": "11349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦਮਵੰਤੀ ਪੁਨਿ ਤਿਹ ਬਰਿਯੋ ਇਹ ਚਰਿਤ੍ਰ ਕਹ ਠਾਨਿ ॥੨੮॥",
      "transliteration": "dhamava(n)tee pun teh bariyo ieh charitr keh Thaan ||28||",
      "translation": "",
      "punjabiViakhya": "ਦਮਵੰਤੀ ਨੇ ਇਹ ਚਰਿਤ੍ਰ ਕਰ ਕੇ ਉਸ ਨੂੰ ਫਿਰ ਵਿਆਹ ਲਿਆ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "दमवंती पुनि तिह बरियो इह चरित्र कह ठानि ॥२८॥",
      "sourceLineId": "122030",
      "sourceShabadId": "11349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122031",
      "sourceShabadId": "11350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਲੈ ਤਾ ਕੋ ਰਾਜਾ ਘਰ ਆਏ ॥",
      "transliteration": "lai taa ko raajaa ghar aae ||",
      "translation": "",
      "punjabiViakhya": "ਦਮਵੰਤੀ ਨੂੰ ਲੈ ਕੇ ਰਾਜਾ ਨਲ ਘਰ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "लै ता को राजा घर आए ॥",
      "sourceLineId": "122032",
      "sourceShabadId": "11350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਖੇਲਿ ਜੂਪ ਪੁਨਿ ਸਤ੍ਰੁ ਹਰਾਏ ॥",
      "transliteration": "khel joop pun satr haraae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਜੂਆ ਖੇਡ ਕੇ ਵੈਰੀਆਂ ਨੂੰ ਹਰਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "खेलि जूप पुनि सत्रु हराए ॥",
      "sourceLineId": "122033",
      "sourceShabadId": "11350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜੀਤਿ ਰਾਜ ਆਪਨੌ ਪੁਨਿ ਲੀਨੋ ॥",
      "transliteration": "jeet raaj aapanau pun leeno ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਦੋਬਾਰਾ ਆਪਣਾ ਰਾਜ ਜਿਤ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "जीति राज आपनौ पुनि लीनो ॥",
      "sourceLineId": "122034",
      "sourceShabadId": "11350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਦੁਹੂੰਅਨ ਸੁਖ ਕੀਨੋ ॥੨੯॥",
      "transliteration": "bhaat bhaat dhuhoo(n)an sukh keeno ||29||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੇ ਭਾਤ ਭਾਤ ਦਾ ਸੁਖ ਪ੍ਰਾਪਤ ਕੀਤਾ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "भाति भाति दुहूँअन सुख कीनो ॥२९॥",
      "sourceLineId": "122035",
      "sourceShabadId": "11350",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122036",
      "sourceShabadId": "11351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮੈ ਜੁ ਕਥਾ ਸੰਛੇਪਤੇ ਯਾ ਕੀ ਕਹੀ ਬਨਾਇ ॥",
      "transliteration": "mai ju kathaa sa(n)chhepate yaa kee kahee banai ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਉਸ ਦੀ ਇਹ ਕਥਾ ਸੰਖੇਪ ਨਾਲ ਬਣਾ ਕੇ ਕਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "मै जु कथा संछेपते या की कही बनाइ ॥",
      "sourceLineId": "122037",
      "sourceShabadId": "11351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਯਾ ਤੇ ਕਿਯ ਬਿਸਥਾਰ ਨਹਿ ਮਤਿ ਪੁਸਤਕ ਬਢ ਜਾਇ ॥੩੦॥",
      "transliteration": "yaa te kiy bisathaar neh mat pusatak badd jai ||30||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਵਿਸਤਾਰ ਨਹੀਂ ਕੀਤਾ ਮਤਾ ਪੁਸਤਕ ਵਧ ਜਾਏ ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "या ते किय बिसथार नहि मति पुसतक बढ जाइ ॥३०॥",
      "sourceLineId": "122038",
      "sourceShabadId": "11351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦਮਵੰਤੀ ਇਹ ਚਰਿਤ ਸੋ ਪੁਨਿ ਪਤਿ ਬਰਿਯੋ ਬਨਾਇ ॥",
      "transliteration": "dhamava(n)tee ieh charit so pun pat bariyo banai ||",
      "translation": "",
      "punjabiViakhya": "ਦਮਵੰਤੀ ਨੇ ਇਹ ਚਰਿਤ੍ਰ ਕਰ ਕੇ ਫਿਰ (ਰਾਜਾ ਨਲ ਨਾਲ) ਵਿਆਹ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "दमवंती इह चरित सो पुनि पति बरियो बनाइ ॥",
      "sourceLineId": "122039",
      "sourceShabadId": "11351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਭ ਤੇ ਜਗ ਜੂਆ ਬੁਰੋ ਕੋਊ ਨ ਖੇਲਹੁ ਰਾਇ ॥੩੧॥",
      "transliteration": "sabh te jag jooaa buro kouoo na khelahu rai ||31||",
      "translation": "",
      "punjabiViakhya": "ਜਗਤ ਵਿਚ ਸਭ ਤੋਂ ਮਾੜਾ ਜੂਆ ਹੈ, ਕੋਈ ਵੀ ਰਾਜਾ ਇਸ ਨੂੰ ਨਾ ਖੇਡੇ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "सभ ते जग जूआ बुरो कोऊ न खेलहु राइ ॥३१॥",
      "sourceLineId": "122040",
      "sourceShabadId": "11351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਸਤਾਵਨੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੫੭॥੩੧੨੯॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau sataavano charitr samaapatam sat subham sat ||157||3129||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੫੭ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੫੭॥੩੧੨੯॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ सतावनो चरित्र समापतम सतु सुभम सतु ॥१५७॥३१२९॥अफजूँ॥",
      "sourceLineId": "122041",
      "sourceShabadId": "11351",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122042",
      "sourceShabadId": "11352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚੌੜ ਭਰਥ ਸੰਨ੍ਯਾਸੀ ਰਹੈ ॥",
      "transliteration": "chauaR bharath sa(n)nayaasee rahai ||",
      "translation": "",
      "punjabiViakhya": "ਚੌੜ ਭਰਤ ਨਾ ਦਾ ਇਕ ਸੰਨਿਆਸੀ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "चौड़ भरथ संन्यासी रहै ॥",
      "sourceLineId": "122043",
      "sourceShabadId": "11352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰੰਡੀਗਿਰ ਦੁਤਿਯੈ ਜਗ ਕਹੈ ॥",
      "transliteration": "ra(n)ddeegir dhutiyai jag kahai ||",
      "translation": "",
      "punjabiViakhya": "ਦੂਜੇ ਨੂੰ ਲੋਕੀਂ ਰੰਡੀਗਿਰ ਕਹਿੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "रंडीगिर दुतियै जग कहै ॥",
      "sourceLineId": "122044",
      "sourceShabadId": "11352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਾਲਕ ਰਾਮ ਏਕ ਬੈਰਾਗੀ ॥",
      "transliteration": "baalak raam ek bairaagee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਬਾਲਕ ਰਾਮ ਨਾ ਦਾ ਬੈਰਾਗੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "बालक राम एक बैरागी ॥",
      "sourceLineId": "122045",
      "sourceShabadId": "11352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਿਨ ਸੌ ਰਹੈ ਸਪਰਧਾ ਲਾਗੀ ॥੧॥",
      "transliteration": "tin sau rahai saparadhaa laagee ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਪ੍ਰਤਿ ਉਸ ਦੀ ਖ਼ਾਰਬਾਜ਼ੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "तिन सौ रहै सपरधा लागी ॥१॥",
      "sourceLineId": "122046",
      "sourceShabadId": "11352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਤਿਨ ਪਰੀ ਲਰਾਈ ॥",
      "transliteration": "ek dhivas tin paree laraiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਉਨ੍ਰਹਾ ਵਿਚ ਲੜਾਈ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "एक दिवस तिन परी लराई ॥",
      "sourceLineId": "122047",
      "sourceShabadId": "11352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕੁਤਕਨ ਸੇਤੀ ਮਾਰਿ ਮਚਾਈ ॥",
      "transliteration": "kutakan setee maar machaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਡੰਡਿਆਂ ਨਾਲ ਖ਼ੂਬ ਮਾਰ ਮਚੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "कुतकन सेती मारि मचाई ॥",
      "sourceLineId": "122048",
      "sourceShabadId": "11352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕੰਠੀ ਕਹੂੰ ਜਟਨ ਕੇ ਜੂਟੇ ॥",
      "transliteration": "ka(n)Thee kahoo(n) jaTan ke jooTe ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਕੰਠੀਆਂ ਅਤੇ ਕਿਤੇ ਜਟਾਵਾ ਦੇ ਜੂੜੇ (ਖੁਲ੍ਰਹ ਗਏ)",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "कंठी कहूँ जटन के जूटे ॥",
      "sourceLineId": "122049",
      "sourceShabadId": "11352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਖਪਰ ਸੌ ਖਪਰ ਬਹੁ ਫੂਟੇ ॥੨॥",
      "transliteration": "khapar sau khapar bahu fooTe ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਖਪਰਾ ਉਤੇ ਖਪਰ (ਵਜ ਕੇ) ਬਹੁਤ ਅਧਿਕ ਟੁੱਟੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "खपर सौ खपर बहु फूटे ॥२॥",
      "sourceLineId": "122050",
      "sourceShabadId": "11352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਗਿਰਿ ਗਿਰਿ ਕਹੂੰ ਟੋਪਿਯੈ ਪਰੀ ॥",
      "transliteration": "gir gir kahoo(n) Topiyai paree ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਟੋਪੀਆਂ ਡਿਗ ਡਿਗ ਕੇ ਪਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "गिरि गिरि कहूँ टोपियै परी ॥",
      "sourceLineId": "122051",
      "sourceShabadId": "11352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਢੇਰ ਜਟਨ ਹ੍ਵੈ ਗਏ ਉਪਰੀ ॥",
      "transliteration": "dder jaTan havai ge uparee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਜਟਾਵਾ ਦੇ ਉੱਚੇ ਢੇਰ ਲਗ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "ढेर जटन ह्वै गए उपरी ॥",
      "sourceLineId": "122052",
      "sourceShabadId": "11352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਲਾਤ ਮੁਸਟ ਕੇ ਕਰੈ ਪ੍ਰਹਾਰਾ ॥",
      "transliteration": "laat musaT ke karai prahaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਇਕ ਦੂਜੇ ਉਤੇ) ਲੱਤਾ ਅਤੇ ਮੁਕਿਆਂ ਦਾ ਪ੍ਰਹਾਰ ਕਰਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "लात मुसट के करै प्रहारा ॥",
      "sourceLineId": "122053",
      "sourceShabadId": "11352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਨ ਕਰਿ ਚੋਟ ਪਰੈ ਘਰਿਯਾਰਾ ॥੩॥",
      "transliteration": "jan kar choT parai ghariyaaraa ||3||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਘੜੀਆਲ ਉਤੇ ਸਟਾ ਪੈਂਦੀਆਂ ਹੋਣ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "जन करि चोट परै घरियारा ॥३॥",
      "sourceLineId": "122054",
      "sourceShabadId": "11352",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122055",
      "sourceShabadId": "11353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਭ ਕਾਪੈ ਕੁਤਕਾ ਬਜੈ ਪਨਹੀ ਬਹੈ ਅਨੇਕ ॥",
      "transliteration": "sabh kaapai kutakaa bajai panahee bahai anek ||",
      "translation": "",
      "punjabiViakhya": "ਸੋਟੇ ਵਜਣ ਤੇ ਸਭ ਕੰਬ ਰਹੇ ਸਨ ਅਤੇ ਅਨੇਕ ਜੁਤੀਆਂ ਵਗਾਈਆਂ ਜਾ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "सभ कापै कुतका बजै पनही बहै अनेक ॥",
      "sourceLineId": "122056",
      "sourceShabadId": "11353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸਭ ਹੀ ਕੇ ਫੂਟੇ ਬਦਨ ਸਾਬਤ ਰਹਿਯੋ ਨ ਏਕ ॥੪॥",
      "transliteration": "sabh hee ke fooTe badhan saabat rahiyo na ek ||4||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਦੇ ਮੁਖ ('ਬਦਨ') ਫੁਟ ਗਏ ਸਨ, ਕੋਈ ਇਕ ਵੀ ਸਾਬਤ ਨਹੀਂ ਰਿਹਾ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "सभ ही के फूटे बदन साबत रहियो न एक ॥४॥",
      "sourceLineId": "122057",
      "sourceShabadId": "11353",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122058",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਕੰਠਨ ਕੀ ਕੰਠੀ ਬਹੁ ਟੂਟੀ ॥",
      "transliteration": "ka(n)Than kee ka(n)Thee bahu TooTee ||",
      "translation": "",
      "punjabiViakhya": "ਗਲਿਆਂ ਦੀਆਂ ਬਹੁਤ ਕੰਠੀਆਂ ਟੁਟ ਗਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "कंठन की कंठी बहु टूटी ॥",
      "sourceLineId": "122059",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਮਾਰੀ ਜਟਾ ਲਾਠਿਯਨ ਛੂਟੀ ॥",
      "transliteration": "maaree jaTaa laaThiyan chhooTee ||",
      "translation": "",
      "punjabiViakhya": "ਲਾਠੀਆਂ ਦੇ ਮਾਰਨ ਨਾਲ ਜਟਾਵਾ ਖੁਲ੍ਰਹ ਗਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "मारी जटा लाठियन छूटी ॥",
      "sourceLineId": "122060",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਕਿਸੀ ਨਖਨ ਕੇ ਘਾਇ ਬਿਰਾਜੈਂ ॥",
      "transliteration": "kisee nakhan ke ghai biraajai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ (ਦੇ ਮੁਖ ਉਤੇ) ਨਹੁੰ ਦਾ ਜ਼ਖ਼ਮ ਲਗਿਆ ਹੋਇਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "किसी नखन के घाइ बिराजैं ॥",
      "sourceLineId": "122061",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਜਨੁ ਕਰਿ ਚੜੇ ਚੰਦ੍ਰਮਾ ਰਾਜੈਂ ॥੫॥",
      "transliteration": "jan kar chaRe cha(n)dhramaa raajai(n) ||5||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਚੰਦ੍ਰਮਾ ਚੜ੍ਰਹਿਆ ਹੋਇਆ ਹੋਵੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "जनु करि चड़े चंद्रमा राजैं ॥५॥",
      "sourceLineId": "122062",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਕੇਸ ਅਕੇਸ ਹੋਤ ਕਹੀ ਭਏ ॥",
      "transliteration": "kes akes hot kahee bhe ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਕੇਸਾ (ਜਟਾਵਾ) ਵਾਲੇ ਬਿਨਾ ਕੇਸਾ ਦੇ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "केस अकेस होत कही भए ॥",
      "sourceLineId": "122063",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਕਿਤੇ ਹਨੇ ਨਸਿ ਕਿਨ ਮਰ ਗਏ ॥",
      "transliteration": "kite hane nas kin mar ge ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਮਾਰੇ ਗਏ, ਕਿਤਨੇ ਨਸ ਗਏ (ਅਤੇ ਕਿਤਨੇ) ਮਰ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "किते हने नसि किन मर गए ॥",
      "sourceLineId": "122064",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਕਾਟਿ ਕਾਟਿ ਦਾਤਨ ਕੋਊ ਖਾਹੀ ॥",
      "transliteration": "kaaT kaaT dhaatan kouoo khaahee ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਦੰਦਾ ਨਾਲ ਇਕ ਦੂਜੇ ਨੂੰ ਕਟ ਕੇ ਖਾਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "काटि काटि दातन कोऊ खाही ॥",
      "sourceLineId": "122065",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਐਸੋ ਕਹੂੰ ਜੁਧ ਭਯੋ ਨਾਹੀ ॥੬॥",
      "transliteration": "aaiso kahoo(n) judh bhayo naahee ||6||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਯੁੱਧ ਅਗੇ ਕਦੇ ਨਹੀਂ ਹੋਇਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "ऐसो कहूँ जुध भयो नाही ॥६॥",
      "sourceLineId": "122066",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਐਸੀ ਮਾਰਿ ਜੂਤਿਯਨ ਪਰੀ ॥",
      "transliteration": "aaisee maar jootiyan paree ||",
      "translation": "",
      "punjabiViakhya": "ਜੁਤੀਆਂ ਦੀ ਅਜਿਹੀ ਮਾਰ ਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "ऐसी मारि जूतियन परी ॥",
      "sourceLineId": "122067",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਜਟਾ ਨ ਕਿਸਹੂੰ ਸੀਸ ਉਬਰੀ ॥",
      "transliteration": "jaTaa na kisahoo(n) sees ubaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਕਿਸੇ ਦੇ ਸਿਰ ਉਤੇ ਜਟਾ ਨਾ ਰਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "जटा न किसहूँ सीस उबरी ॥",
      "sourceLineId": "122068",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਕਿਸੂ ਕੰਠ ਕੰਠੀ ਨਹਿ ਰਹੀ ॥",
      "transliteration": "kisoo ka(n)Th ka(n)Thee neh rahee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਦੇ ਗਲੇ ਵਿਚ ਕੰਠੀ ਨਾ ਰਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "किसू कंठ कंठी नहि रही ॥",
      "sourceLineId": "122069",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਬਾਲਕ ਰਾਮ ਪਨ੍ਰਹੀ ਤਬ ਗਹੀ ॥੭॥",
      "transliteration": "baalak raam panrahee tab gahee ||7||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਬਾਲਕ ਰਾਮ ਨੇ ਹੱਥ ਵਿਚ ਜੁਤੀ ਪਕੜ ਲਈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "बालक राम पन्रही तब गही ॥७॥",
      "sourceLineId": "122070",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਏਕ ਸੰਨ੍ਯਾਸੀ ਕੇ ਸਿਰ ਝਾਰੀ ॥",
      "transliteration": "ek sa(n)nayaasee ke sir jhaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਸੰਨਿਆਸੀ ਦੇ ਸਿਰ ਵਿਚ ਜੁਤੀ ਮਾਰੀ",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "एक संन्यासी के सिर झारी ॥",
      "sourceLineId": "122071",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਦੂਜੇ ਕੇ ਮੁਖ ਊਪਰ ਮਾਰੀ ॥",
      "transliteration": "dhooje ke mukh uoopar maaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੂਜੇ (ਸੰਨਿਆਸੀ) ਦੇ ਮੂੰਹ ਉਤੇ ਮਾਰੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1039,
      "hindi": "",
      "hindiTransliteration": "दूजे के मुख ऊपर मारी ॥",
      "sourceLineId": "122072",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1039_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਸ੍ਰੌਨਤ ਬਹਿਯੋ ਬਦਨ ਜਬ ਫੂਟਿਯੋ ॥",
