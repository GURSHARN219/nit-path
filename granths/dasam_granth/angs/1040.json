{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1040,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1040_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਬ ਸਭ ਹੀ ਸੰਨ੍ਯਾਸੀ ਧਾਏ ॥",
      "transliteration": "tab sabh hee sa(n)nayaasee dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਸਾਰੇ ਸੰਨਿਆਸੀ ਧਾ ਕੇ ਪੈ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "तब सभ ही संन्यासी धाए ॥",
      "sourceLineId": "122075",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗਹਿ ਗਹਿ ਹਾਥ ਜੂਤਿਯੈ ਆਏ ॥",
      "transliteration": "geh geh haath jootiyai aae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੱਥਾ ਵਿਚ ਜੁਤੀਆਂ ਫੜ ਫੜ ਕੇ ਆ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "गहि गहि हाथ जूतियै आए ॥",
      "sourceLineId": "122076",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚੌੜ ਭਰਥ ਰੰਡੀਗਿਰ ਦੌਰੇ ॥",
      "transliteration": "chauaR bharath ra(n)ddeegir dhauare ||",
      "translation": "",
      "punjabiViakhya": "ਚੌੜ ਭਰਥ ਅਤੇ ਰੰਡੀਗਿਰ ਵੀ ਦੌੜੇ",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "चौड़ भरथ रंडीगिर दौरे ॥",
      "sourceLineId": "122077",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਲੈ ਲੈ ਢੋਵ ਚੇਲਕਾ ਔਰੇ ॥੯॥",
      "transliteration": "lai lai ddov chelakaa aauare ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਸਾਰੇ ਚੇਲੇ ਇਕੱਠੇ ਕਰ ਲਿਆਏ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "लै लै ढोव चेलका औरे ॥९॥",
      "sourceLineId": "122078",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਾਲਕ ਰਾਮ ਘੇਰਿ ਕੈ ਲਿਯੋ ॥",
      "transliteration": "baalak raam gher kai liyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਬਾਲਕ ਰਾਮ ਨੂੰ ਘੇਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "बालक राम घेरि कै लियो ॥",
      "sourceLineId": "122079",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜੂਤਨ ਸਾਥ ਦਿਵਾਨੋ ਕਿਯੋ ॥",
      "transliteration": "jootan saath dhivaano kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜੁਤੀਆਂ ਮਾਰ ਮਾਰ ਕੇ ਹੋਸ਼ ਭੁਲਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "जूतन साथ दिवानो कियो ॥",
      "sourceLineId": "122080",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਘੂਮਿ ਭੂਮਿ ਕੇ ਊਪਰ ਛਰਿਯੋ ॥",
      "transliteration": "ghoom bhoom ke uoopar chhariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਭਵਾਟਣੀਆਂ ਖਾ ਖਾ ਕੇ ਧਰਤੀ ਉਤੇ ਡਿਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "घूमि भूमि के ऊपर छरियो ॥",
      "sourceLineId": "122081",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਨੁ ਕਰਿ ਬੀਜੁ ਮੁਨਾਰਾ ਪਰਿਯੋ ॥੧੦॥",
      "transliteration": "jan kar beej munaaraa pariyo ||10||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਬਿਜਲੀ ਦੇ ਪਿਆਂ ਮੁਨਾਰਾ ਡਿਗਿਆ ਹੋਵੇ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "जनु करि बीजु मुनारा परियो ॥१०॥",
      "sourceLineId": "122082",
      "sourceShabadId": "11354",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122083",
      "sourceShabadId": "11355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਭ ਮੁੰਡਿਯਾ ਕ੍ਰੁਧਿਤ ਭਏ ਭਾਜਤ ਭਯੋ ਨ ਏਕ ॥",
      "transliteration": "sabh mu(n)ddiyaa krudhit bhe bhaajat bhayo na ek ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਬੈਰਾਗੀ ਗੁੱਸੇ ਵਿਚ ਆ ਗਏ ਅਤੇ ਇਕ ਵੀ ਨਾ ਭਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "सभ मुँडिया क्रुधित भए भाजत भयो न एक ॥",
      "sourceLineId": "122084",
      "sourceShabadId": "11355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚੌੜ ਭਰਥ ਗਿਰ ਰਾਡ ਪੈ ਕੁਤਕਾ ਹਨੇ ਅਨੇਕ ॥੧੧॥",
      "transliteration": "chauaR bharath gir raadd pai kutakaa hane anek ||11||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਚੌੜ ਭਰਥ ਅਤੇ ਰੰਡੀਗਿਰ ਉਤੇ ਬਹੁਤ ਡੰਡੇ ਮਾਰੇ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "चौड़ भरथ गिर राड पै कुतका हने अनेक ॥११॥",
      "sourceLineId": "122085",
      "sourceShabadId": "11355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੰਨ੍ਯਾਸੀ ਕੋਪਿਤ ਭਏ ਲਗੇ ਮੁਤਹਰੀ ਘਾਇ ॥",
      "transliteration": "sa(n)nayaasee kopit bhe lage mutaharee ghai ||",
      "translation": "",
      "punjabiViakhya": "ਸੋਟਿਆਂ ਦੇ ਜ਼ਖ਼ਮ ਖਾ ਕੇ ਸੰਨਿਆਸੀ ਕ੍ਰੋਧ ਵਿਚ ਆ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "संन्यासी कोपित भए लगे मुतहरी घाइ ॥",
      "sourceLineId": "122086",
      "sourceShabadId": "11355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਲਾਤ ਮੁਸਟ ਜੂਤਿਨ ਭਏ ਮੁੰਡਿਯਾ ਦਏ ਗਿਰਾਇ ॥੧੨॥",
      "transliteration": "laat musaT jootin bhe mu(n)ddiyaa dhe girai ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜੁਤੀਆਂ, ਮੁਕਿਆਂ ਅਤੇ ਲੱਤਾ ਨਾਲ ਬੈਰਾਗੀਆਂ ਨੂੰ ਧਰਤੀ ਤੇ ਲੰਬਾ ਪਾ ਦਿੱਤਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "लात मुसट जूतिन भए मुँडिया दए गिराइ ॥१२॥",
      "sourceLineId": "122087",
      "sourceShabadId": "11355",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "122088",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪਕਰਿ ਮੁਤਹਰੀ ਪੁਨਿ ਸਕੋਪ ਮੁੰਡਿਯਾ ਭਏ ॥",
      "transliteration": "pakar mutaharee pun sakop mu(n)ddiyaa bhe ||",
      "translation": "",
      "punjabiViakhya": "ਸੋਟੇ ਪਕੜ ਕੇ ਫਿਰ ਬੈਰਾਗੀ ਰੋਹ ਵਿਚ ਆ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "पकरि मुतहरी पुनि सकोप मुँडिया भए ॥",
      "sourceLineId": "122089",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਫਰੂਆ ਲਾਠੀ ਸਭੇ ਲਏ ਉਦਿਤ ਭਏ ॥",
      "transliteration": "farooaa laaThee sabhe le udhit bhe ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਫਾਹੁੜੇ ਤੇ ਡਾਗਾ ਲੈ ਕੇ ਉਠ ਖੜੋਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "फरूआ लाठी सभे लए उदित भए ॥",
      "sourceLineId": "122090",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਾਟਿ ਕਾਟਿ ਕੈ ਅੰਗ ਸੰਨ੍ਯਾਸਿਨ ਖਾਵਹੀ ॥",
      "transliteration": "kaaT kaaT kai a(n)g sa(n)nayaasin khaavahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸੰਨਿਆਸੀਆਂ ਦੇ ਅੰਗ ਵਢ ਵਢ ਕੇ ਖਾਣ ਲਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "काटि काटि कै अंग संन्यासिन खावही ॥",
      "sourceLineId": "122091",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਹੋ ਦਸ ਨਾਮਨ ਕੋ ਲੈ ਲੈ ਨਾਮ ਗਿਰਾਵਹੀ ॥੧੩॥",
      "transliteration": "ho dhas naaman ko lai lai naam giraavahee ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦਸ ਨਾਮੀ (ਸੰਪ੍ਰਦਾਵਾ) ਦੇ ਨਾ ਲੈ ਲੈ ਕੇ ਡਿਗਾਉਣ ਲਗੇ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "हो दस नामन को लै लै नाम गिरावही ॥१३॥",
      "sourceLineId": "122092",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਬ ਸੰਨ੍ਯਾਸੀ ਧਾਇ ਧਾਇ ਤਿਨ ਕਾਟਹੀ ॥",
      "transliteration": "tab sa(n)nayaasee dhai dhai tin kaaTahee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਸੰਨਿਆਸੀ ਵੀ ਭਜ ਭਜ ਉਨ੍ਰਹਾ ਨੂੰ (ਦੰਦਾ ਨਾਲ) ਕਟਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "तब संन्यासी धाइ धाइ तिन काटही ॥",
      "sourceLineId": "122093",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤੋਰਿ ਤੋਰਿ ਕੰਠਿਨ ਤੇ ਕੰਠੀ ਸਾਟਹੀ ॥",
      "transliteration": "tor tor ka(n)Thin te ka(n)Thee saaTahee ||",
      "translation": "",
      "punjabiViakhya": "ਗਲਿਆਂ ਵਿਚੋਂ ਕੰਠੀਆਂ ਤੋੜ ਤੋੜ ਕੇ ਸੁਟਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "तोरि तोरि कंठिन ते कंठी साटही ॥",
      "sourceLineId": "122094",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਐਚ ਐਚ ਟਾਗਨ ਤੇ ਗਹ ਗਹ ਡਾਰਹੀ ॥",
      "transliteration": "aaich aaich Taagan te geh geh ddaarahee ||",
      "translation": "",
      "punjabiViakhya": "ਟੰਗਾ ਤੋਂ ਖਿਚ ਖਿਚ ਕੇ ਉਨ੍ਰਹਾ ਨੂੰ ਡਿਗਾਉਾਂਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "ऐच ऐच टागन ते गह गह डारही ॥",
      "sourceLineId": "122095",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦੋ ਦੁਹੂੰ ਹਾਥ ਭੇ ਖੈਂਚਿ ਮੁਤਹਰੀ ਮਾਰਹੀ ॥੧੪॥",
      "transliteration": "dho dhuhoo(n) haath bhe khai(n)ch mutaharee maarahee ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਹਾ ਹੱਥਾ ਨਾਲ ਖਿਚ ਕੇ ਮੁਗਦਰ ਮਾਰਦੇ ਸਨ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "दो दुहूँ हाथ भे खैंचि मुतहरी मारही ॥१४॥",
      "sourceLineId": "122096",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮੁੰਡਿਯਾ ਤਾਬ੍ਰ ਕਲਾ ਪੈ ਆਏ ॥",
      "transliteration": "mu(n)ddiyaa taabr kalaa pai aae ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਬੈਰਾਗੀ (ਰਾਣੀ) ਤਾਬ੍ਰ ਕਲਾ ਕੋਲ ਆਏ",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "मुँडिया ताब्र कला पै आए ॥",
      "sourceLineId": "122097",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹਮ ਸਭ ਸੰਨ੍ਯਾਸੀਨ ਦੁਖਾਏ ॥",
      "transliteration": "ham sabh sa(n)nayaaseen dhukhaae ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿਣ ਲਗੇ ਕਿ) ਸਾਨੂੰ ਸੰਨਿਆਸੀਆਂ ਨੇ ਬਹੁਤ ਦੁਖੀ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "हम सभ संन्यासीन दुखाए ॥",
      "sourceLineId": "122098",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਬ ਰਾਨੀ ਐਸੇ ਸੁਨ ਲਈ ॥",
      "transliteration": "jab raanee aaise sun liee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਣੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "जब रानी ऐसे सुन लई ॥",
      "sourceLineId": "122099",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦਤਾਤ੍ਰੈਨ ਬੁਲਾਵਤ ਭਈ ॥੧੫॥",
      "transliteration": "dhataatrain bulaavat bhiee ||15||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਦੱਤਾਤ੍ਰੇ ਨੂੰ ਬੁਲਾਇਆ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "दतात्रैन बुलावत भई ॥१५॥",
      "sourceLineId": "122100",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੰਨ੍ਯਾਸੀ ਦਤਾਤ੍ਰੈ ਮਾਨੈ ॥",
      "transliteration": "sa(n)nayaasee dhataatrai maanai ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਨਿਆਸੀ ਦੱਤਾਤ੍ਰੇ ਨੂੰ ਮੰਨਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "संन्यासी दतात्रै मानै ॥",
      "sourceLineId": "122101",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰਾਮਾਨੰਦ ਬੈਰਾਗ ਪ੍ਰਮਾਨੈ ॥",
      "transliteration": "raamaana(n)dh bairaag pramaanai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬੈਰਾਗੀ ਰਾਮਨੰਦ ਨੂੰ ਪੂਜਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "रामानंद बैराग प्रमानै ॥",
      "sourceLineId": "122102",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤੇ ਤੁਮ ਕਹੈ ਵਹੈ ਚਿਤ ਧਰਿਯਹੁ ॥",
      "transliteration": "te tum kahai vahai chit dhariyahu ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ ਉਨ੍ਰਹਾ ਨੂੰ ਕਿਹਾ) ਜੋ ਇਹ ਤੁਹਾਨੂੰ ਕਹਿਣ ਉਹੀ ਚਿਤ ਵਿਚ ਧਰੋ",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "ते तुम कहै वहै चित धरियहु ॥",
      "sourceLineId": "122103",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮੇਰੀ ਕਹੀ ਚਿਤ ਮੈ ਕਰਿਯਹੁ ॥੧੬॥",
      "transliteration": "meree kahee chit mai kariyahu ||16||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੀ ਕਹੀ ਹੋਈ ਗੱਲ ਨੂੰ ਚਿਤ ਵਿਚ ਧਾਰਨ ਕਰੋ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "मेरी कही चित मै करियहु ॥१६॥",
      "sourceLineId": "122104",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਹਮੇ ਗ੍ਰਿਹ ਸੋਵਹੁ ॥",
      "transliteration": "ek dhivas hame gireh sovahu ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਤੁਸੀਂ (ਦੋਵੇਾਂ) ਮੇਰੇ ਘਰ ਸੌਂ ਜਾਓ",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "एक दिवस हमे गृह सोवहु ॥",
      "sourceLineId": "122105",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਗਰੀ ਨਿਸਾ ਜਾਗਤਹਿ ਖੋਵਹੁ ॥",
      "transliteration": "sagaree nisaa jaagateh khovahu ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੀ ਰਾਤ ਜਾਗ ਕੇ ਲੰਘਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "सगरी निसा जागतहि खोवहु ॥",
      "sourceLineId": "122106",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜੋ ਤੁਮ ਕਹੈ ਲਰੌ ਤੌ ਲਰਿਯਹੁ ॥",
      "transliteration": "jo tum kahai larau tau lariyahu ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ (ਉਹ ਧਾਰਮਿਕ ਆਗੂ) ਤੁਹਾਨੂੰ ਕਹਿਣ ਕਿ ਲੜੋ, ਤਾ ਲੜੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "जो तुम कहै लरौ तौ लरियहु ॥",
      "sourceLineId": "122107",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਤਰ ਬੈਰ ਭਾਵ ਨਹਿ ਕਰਿਯਹੁ ॥੧੭॥",
      "transliteration": "naatar bair bhaav neh kariyahu ||17||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਵੈਰ ਭਾਵ ਨਾ ਕਰੋ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "नातर बैर भाव नहि करियहु ॥१७॥",
      "sourceLineId": "122108",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜੁਦਾ ਜੁਦਾ ਘਰ ਦੋਊ ਸੁਵਾਏ ॥",
      "transliteration": "judhaa judhaa ghar dhouoo suvaae ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੂੰ ਵਖਰੀ ਵਖਰੀ ਥਾ ਤੇ ਸਵਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "जुदा जुदा घर दोऊ सुवाए ॥",
      "sourceLineId": "122109",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਰਧ ਰਾਤ੍ਰਿ ਭੇ ਬੈਨ ਸੁਨਾਏ ॥",
      "transliteration": "aradh raatr bhe bain sunaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅੱਧੀ ਰਾਤ ਨੂੰ ਗੱਲ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "अरध रातृ भे बैन सुनाए ॥",
      "sourceLineId": "122110",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦਤ ਰਾਮਾਨੰਦ ਕਹੈ ਸੁ ਕਰਿਯਹੁ ॥",
      "transliteration": "dhat raamaana(n)dh kahai su kariyahu ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਤਾਤ੍ਰੇ ਅਤੇ ਰਾਮਾਨੰਦ ਜੋ ਕਹਿਣ ਉਹੀ ਕਰਨਾ",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "दत रामानंद कहै सु करियहु ॥",
      "sourceLineId": "122111",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਹੁਰੋ ਕੋਪ ਠਾਨਿ ਨਹਿ ਲਰਿਯਹੁ ॥੧੮॥",
      "transliteration": "bahuro kop Thaan neh lariyahu ||18||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਗੁੱਸੇ ਕਰ ਕੇ ਨਹੀਂ ਲੜਨਾ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "बहुरो कोप ठानि नहि लरियहु ॥१८॥",
      "sourceLineId": "122112",
      "sourceShabadId": "11356",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122113",
      "sourceShabadId": "11357",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਛਲਿ ਛੈਲੀ ਇਹ ਬਿਧਿ ਗਈ ਐਸੋ ਚਰਿਤ ਸਵਾਰਿ ॥",
      "transliteration": "chhal chhailee ieh bidh giee aaiso charit savaar ||",
      "translation": "",
      "punjabiViakhya": "ਅਜਿਹਾ ਚਰਿਤ੍ਰ ਕਰ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਇਸਤਰੀ (ਉਨ੍ਰਹਾ ਨੂੰ) ਛਲ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "छलि छैली इह बिधि गई ऐसो चरित सवारि ॥",
      "sourceLineId": "122114",
      "sourceShabadId": "11357",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਿਮਰਿ ਗੁਰਨ ਕੇ ਬਚਨ ਦ੍ਵੈ ਬਹੁਰਿ ਨ ਕੀਨੀ ਰਾਰਿ ॥੧੯॥",
      "transliteration": "simar guran ke bachan dhavai bahur na keenee raar ||19||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੇ ਆਪਣੇ ਗੁਰੂਆਂ ਦੇ ਬਚਨ ਯਾਦ ਕਰ ਕੇ ਫਿਰ ਲੜਾਈ ਨਹੀਂ ਕੀਤੀ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "सिमरि गुरन के बचन द्वै बहुरि न कीनी रारि ॥१९॥",
      "sourceLineId": "122115",
      "sourceShabadId": "11357",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਅਠਾਵਨੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੫੮॥੩੧੪੮॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau aThaavano charitr samaapatam sat subham sat ||158||3148||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੫੮ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੫੮॥੩੧੪੮॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ अठावनो चरित्र समापतम सतु सुभम सतु ॥१५८॥३१४८॥अफजूँ॥",
      "sourceLineId": "122116",
      "sourceShabadId": "11357",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122117",
      "sourceShabadId": "11358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰਾਜ ਸਿੰਘ ਰਾਜਾ ਇਕ ਰਹਈ ॥",
      "transliteration": "raaj si(n)gh raajaa ik rahiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਰਾਜ ਸਿੰਘ ਨਾ ਦਾ ਰਾਜਾ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "राज सिंघ राजा इक रहई ॥",
      "sourceLineId": "122118",
      "sourceShabadId": "11358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬੀਰ ਕਲਾ ਰਾਨੀ ਜਗ ਕਹਈ ॥",
      "transliteration": "beer kalaa raanee jag kahiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਰਾਣੀ ਨੂੰ ਸਾਰੇ ਬੀਰ ਕਲਾ ਕਹਿੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "बीर कला रानी जग कहई ॥",
      "sourceLineId": "122119",
      "sourceShabadId": "11358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਾ ਸੌ ਨੇਹ ਨ੍ਰਿਪਤਿ ਕੋ ਭਾਰੋ ॥",
      "transliteration": "taa sau neh nirapat ko bhaaro ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਰਾਜੇ ਦਾ ਬਹੁਤ ਸਨੇਹ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "ता सौ नेह नृपति को भारो ॥",
      "sourceLineId": "122120",
      "sourceShabadId": "11358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਾਨਤ ਭੇਦ ਦੇਸ ਇਹ ਸਾਰੋ ॥੧॥",
      "transliteration": "jaanat bhedh dhes ieh saaro ||1||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਾ ਦੇਸ ਇਹ ਭੇਦ ਜਾਣਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1040,
      "hindi": "",
      "hindiTransliteration": "जानत भेद देस इह सारो ॥१॥",
      "sourceLineId": "122121",
      "sourceShabadId": "11358",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1040_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
