{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1043,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1043_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੇਸ ਦੇਸ ਕੇ ਏਸ ਜਿਹ ਜਪਤ ਆਠਹੂੰ ਜਾਮ ॥੧॥",
      "transliteration": "dhes dhes ke es jeh japat aaThahoo(n) jaam ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ (ਦੇ ਨਾਮ) ਨੂੰ ਦੇਸ ਦੇਸ ਦੇ ਰਾਜੇ ਅੱਠੇ ਪਹਿਰ ਜਪਦੇ ਰਹਿੰਦੇ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "देस देस के एस जिह जपत आठहूँ जाम ॥१॥",
      "sourceLineId": "122219",
      "sourceShabadId": "11373",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122220",
      "sourceShabadId": "11374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸ੍ਵਰਨਮਤੀ ਤਾ ਕੀ ਬਰ ਨਾਰੀ ॥",
      "transliteration": "savairanamatee taa kee bar naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸ੍ਵਰਨਮਤੀ ਨਾ ਦੀ ਸੁੰਦਰ ਰਾਣੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "स्वरनमती ता की बर नारी ॥",
      "sourceLineId": "122221",
      "sourceShabadId": "11374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਨ ਸਮੁੰਦ੍ਰ ਮਥਿ ਸਾਤ ਨਿਕਾਰੀ ॥",
      "transliteration": "jan samu(n)dhr math saat nikaaree ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸਤ ਸਮੁੰਦਰ ਰਿੜਕ ਕੇ ਕਢੀ ਗਈ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "जन समुँद्र मथि सात निकारी ॥",
      "sourceLineId": "122222",
      "sourceShabadId": "11374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰੂਪ ਪ੍ਰਭਾ ਤਾ ਕੀ ਅਤਿ ਸੋ ਹੈ ॥",
      "transliteration": "roop prabhaa taa kee at so hai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਰੂਪ ਅਤਿ ਸੁੰਦਰ ਸ਼ੋਭਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "रूप प्रभा ता की अति सो है ॥",
      "sourceLineId": "122223",
      "sourceShabadId": "11374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਾ ਸਮ ਰੂਪਵਤੀ ਨਹਿ ਕੋ ਹੈ ॥੨॥",
      "transliteration": "jaa sam roopavatee neh ko hai ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ ਕੋਈ ਹੋਰ ਸੁੰਦਰੀ ਨਹੀਂ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "जा सम रूपवती नहि को है ॥२॥",
      "sourceLineId": "122224",
      "sourceShabadId": "11374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੁਨਿਯੋ ਜੋਤਕਿਨ ਗ੍ਰਹਨ ਲਗਾਯੋ ॥",
      "transliteration": "suniyo jotakin grahan lagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜੋਤਸ਼ੀਆਂ ਕੋਲੋਂ ਸੁਣ ਕੇ ਕਿ ਗ੍ਰਹਿਣ ਲਗਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "सुनियो जोतकिन ग्रहन लगायो ॥",
      "sourceLineId": "122225",
      "sourceShabadId": "11374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕੁਰੂਛੇਤ੍ਰ ਨਾਵਨ ਨ੍ਰਿਪ ਆਯੋ ॥",
      "transliteration": "kuroochhetr naavan nirap aayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਕੁਰੁਕੇਸ਼ਤ੍ਰ ਇਸ਼ਨਾਨ ਕਰਨ ਲਈ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "कुरूछेत्र नावन नृप आयो ॥",
      "sourceLineId": "122226",
      "sourceShabadId": "11374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰਾਨੀ ਸਕਲ ਸੰਗ ਕਰ ਲੀਨੀ ॥",
      "transliteration": "raanee sakal sa(n)g kar leenee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਸਾਰੀਆਂ ਰਾਣੀਆਂ ਨੂੰ ਨਾਲ ਲੈ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "रानी सकल संग कर लीनी ॥",
      "sourceLineId": "122227",
      "sourceShabadId": "11374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਹੁ ਦਛਿਨਾ ਬਿਪ੍ਰਨ ਕਹ ਦੀਨੀ ॥੩॥",
      "transliteration": "bahu dhachhinaa bipran keh dheenee ||3||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਾਹਮਣਾ ਨੂੰ ਬਹੁਤ ਦੱਛਣਾ ਦਿੱਤੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "बहु दछिना बिप्रन कह दीनी ॥३॥",
      "sourceLineId": "122228",
      "sourceShabadId": "11374",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122229",
      "sourceShabadId": "11375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸ੍ਵਰਨਮਤੀ ਗਰਭਿਤ ਹੁਤੀ ਸੋਊ ਸੰਗ ਕਰਿ ਲੀਨ ॥",
      "transliteration": "savairanamatee garabhit hutee souoo sa(n)g kar leen ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਵਰਨਮਤੀ ਗਰਭਿਤ ਸੀ, ਉਸ ਨੂੰ ਵੀ ਨਾਲ ਲੈ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "स्वरनमती गरभित हुती सोऊ संग करि लीन ॥",
      "sourceLineId": "122230",
      "sourceShabadId": "11375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਛੋਰਿ ਭੰਡਾਰ ਦਿਜਾਨ ਕੋ ਅਮਿਤ ਦਛਿਨਾ ਦੀਨ ॥੪॥",
      "transliteration": "chhor bha(n)ddaar dhijaan ko amit dhachhinaa dheen ||4||",
      "translation": "",
      "punjabiViakhya": "ਖ਼ਜ਼ਾਨੇ ਨੂੰ ਖੋਲ੍ਰਹ ਕੇ ਬ੍ਰਾਹਮਣਾ ਨੂੰ ਬਹੁਤ ਦੱਛਣਾ ਦਿੱਤੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "छोरि भंडार दिजान को अमित दछिना दीन ॥४॥",
      "sourceLineId": "122231",
      "sourceShabadId": "11375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਵਕੋਟੀ ਮਰਵਾਰ ਕੋ ਸੂਰ ਸੈਨ ਥੋ ਨਾਥ ॥",
      "transliteration": "navakoTee maravaar ko soor sain tho naath ||",
      "translation": "",
      "punjabiViakhya": "ਨਵਕੋਟੀ ਮਾਰਵਾੜ ਦਾ ਸੂਰ ਸੈਨ ਨਾ ਦਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "नवकोटी मरवार को सूर सैन थो नाथ ॥",
      "sourceLineId": "122232",
      "sourceShabadId": "11375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੋਊ ਤਹਾ ਆਵਤ ਭਯੋ ਸਭ ਰਨਿਯਨ ਲੈ ਸਾਥ ॥੫॥",
      "transliteration": "souoo tahaa aavat bhayo sabh raniyan lai saath ||5||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਵੀ ਸਾਰੀਆਂ ਰਾਣੀਆਂ ਸਹਿਤ ਉਥੇ ਆ ਗਿਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "सोऊ तहा आवत भयो सभ रनियन लै साथ ॥५॥",
      "sourceLineId": "122233",
      "sourceShabadId": "11375",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122234",
      "sourceShabadId": "11376",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬੀਰ ਕਲਾ ਤਾ ਕੀ ਬਰ ਨਾਰੀ ॥",
      "transliteration": "beer kalaa taa kee bar naaree ||",
      "translation": "",
      "punjabiViakhya": "ਬੀਰ ਕਲਾ ਉਸ ਦੀ ਸੁੰਦਰ ਰਾਣੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "बीर कला ता की बर नारी ॥",
      "sourceLineId": "122235",
      "sourceShabadId": "11376",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦੁਹੂੰ ਪਛ ਭੀਤਰ ਉਜਿਆਰੀ ॥",
      "transliteration": "dhuhoo(n) pachh bheetar ujiaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦੋਹਾ ਪੱਖਾ (ਸੌਹਰੇ ਅਤੇ ਪੇਕੇ) ਵਿਚ ਬਹੁਤ ਪ੍ਰਭਾਵਸ਼ਾਲੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "दुहूँ पछ भीतर उजिआरी ॥",
      "sourceLineId": "122236",
      "sourceShabadId": "11376",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਾ ਕੀ ਪ੍ਰਭਾ ਜਾਤ ਨਹਿ ਕਹੀ ॥",
      "transliteration": "taa kee prabhaa jaat neh kahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਛਬੀ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "ता की प्रभा जात नहि कही ॥",
      "sourceLineId": "122237",
      "sourceShabadId": "11376",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਾਨਹੁ ਫੂਲਿ ਚੰਬੇਲੀ ਰਹੀ ॥੬॥",
      "transliteration": "maanahu fool cha(n)belee rahee ||6||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਚੰਬੇਲੀ ਦਾ ਫੁਲ ਹੋਵੇ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "मानहु फूलि चंबेली रही ॥६॥",
      "sourceLineId": "122238",
      "sourceShabadId": "11376",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰਾਜਾ ਦੋਊ ਅਨੰਦਿਤ ਭਏ ॥",
      "transliteration": "raajaa dhouoo ana(n)dhit bhe ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਰਾਜੇ (ਇਕ ਦੂਜੇ ਨੂੰ ਮਿਲ ਕਿ) ਆਨੰਦਿਤ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "राजा दोऊ अनंदित भए ॥",
      "sourceLineId": "122239",
      "sourceShabadId": "11376",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅੰਕ ਭੁਜਨ ਦੋਊ ਭੇਟਤ ਭਏ ॥",
      "transliteration": "a(n)k bhujan dhouoo bheTat bhe ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਇਕ ਦੂਜੇ ਨੂੰ) ਜਫੀਆਂ ਭਰੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "अंक भुजन दोऊ भेटत भए ॥",
      "sourceLineId": "122240",
      "sourceShabadId": "11376",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਨਿਯਨ ਦੁਹੂ ਮਿਲਾਵੈ ਭਯੋ ॥",
      "transliteration": "raniyan dhuhoo milaavai bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਰਾਣੀਆਂ ਦਾ ਵੀ ਮੇਲ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "रनियन दुहू मिलावै भयो ॥",
      "sourceLineId": "122241",
      "sourceShabadId": "11376",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚਿਤ ਕੋ ਸੋਕ ਬਿਦਾ ਕਰਿ ਦਯੋ ॥੭॥",
      "transliteration": "chit ko sok bidhaa kar dhayo ||7||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਚਿਤ ਦਾ ਦੁਖ ਦੂਰ ਕਰ ਦਿੱਤਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "चित को सोक बिदा करि दयो ॥७॥",
      "sourceLineId": "122242",
      "sourceShabadId": "11376",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "122243",
      "sourceShabadId": "11377",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਿਜ ਦੇਸਨ ਕੀ ਕਥਾ ਬਖਾਨਤ ਸਭ ਭਈ ॥",
      "transliteration": "nij dhesan kee kathaa bakhaanat sabh bhiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਆਪਣੇ ਆਪਣੇ ਦੇਸ ਦੀਆਂ ਸਭ ਗੱਲਾ ਕਰਨ ਲਗੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "निज देसन की कथा बखानत सभ भई ॥",
      "sourceLineId": "122244",
      "sourceShabadId": "11377",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੁਹੂੰ ਆਪੁ ਮੈ ਕੁਸਲ ਕਥਾ ਕੀ ਸੁਧਿ ਲਈ ॥",
      "transliteration": "dhuhoo(n) aap mai kusal kathaa kee sudh liee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਹਾ ਨੇ ਇਕ ਦੂਜੀ ਦੀ ਸੁਖ ਸਾਦ ਪੁਛੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "दुहूँ आपु मै कुसल कथा की सुधि लई ॥",
      "sourceLineId": "122245",
      "sourceShabadId": "11377",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗਰਭ ਦੁਹੂੰਨ ਕੇ ਦੁਹੂੰਅਨ ਸੁਨੇ ਬਨਾਇ ਕੈ ॥",
      "transliteration": "garabh dhuhoo(n)n ke dhuhoo(n)an sune banai kai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਦੋਹਾ ਨੇ ਇਕ ਦੂਜੀ ਦੇ ਗਰਭਿਤ ਹੋਣ ਬਾਰੇ ਸੁਣਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "गरभ दुहूँन के दुहूँअन सुने बनाइ कै ॥",
      "sourceLineId": "122246",
      "sourceShabadId": "11377",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹੋ ਤਬ ਰਨਿਯਨ ਬਚ ਉਚਰੇ ਕਛੁ ਮੁਸਕਾਇ ਕੈ ॥੮॥",
      "transliteration": "ho tab raniyan bach uchare kachh musakai kai ||8||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਾਣੀਆਂ ਨੇ ਹਸ ਕੇ ਕਿਹਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "हो तब रनियन बच उचरे कछु मुसकाइ कै ॥८॥",
      "sourceLineId": "122247",
      "sourceShabadId": "11377",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜੌ ਦੁਹੂੰਅਨ ਹਰਿ ਦੈਹੈ ਪੂਤੁਪਜਾਇ ਕੈ ॥",
      "transliteration": "jau dhuhoo(n)an har dhaihai pootupajai kai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਦੋਹਾ ਦੇ ਘਰ ਪ੍ਰਭੂ ਪੁੱਤਰ ਪੈਦਾ ਕਰਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "जौ दुहूँअन हरि दैहै पूतुपजाइ कै ॥",
      "sourceLineId": "122248",
      "sourceShabadId": "11377",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਬ ਹਮ ਤੁਮ ਮਿਲਿ ਹੈਂ ਹ੍ਯਾਂ ਬਹੁਰੌ ਆਇ ਕੈ ॥",
      "transliteration": "tab ham tum mil hai(n) hayaa(n) bahurau aai kai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਅਸੀਂ ਇਕ ਦੂਜੀ ਨੂੰ ਇਥੇ ਆ ਕੇ ਮਿਲਾਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "तब हम तुम मिलि हैं ह्याँ बहुरौ आइ कै ॥",
      "sourceLineId": "122249",
      "sourceShabadId": "11377",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪੂਤ ਏਕ ਕੇ ਸੁਤਾ ਬਿਧਾਤਾ ਦੇਇ ਜੌ ॥",
      "transliteration": "poot ek ke sutaa bidhaataa dhei jau ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਵਿਧਾਤਾ ਇਕ ਨੂੰ ਪੁੱਤਰ ਅਤੇ ਇਕ ਨੂੰ ਧੀ ਦੇਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "पूत एक के सुता बिधाता देइ जौ ॥",
      "sourceLineId": "122250",
      "sourceShabadId": "11377",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹੋ ਆਪਸ ਬੀਚ ਸਗਾਈ ਤਿਨ ਕੀ ਕਰੈਂ ਤੌ ॥੯॥",
      "transliteration": "ho aapas beech sagaiee tin kee karai(n) tau ||9||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਆਪਸ ਵਿਚ ਉਨ੍ਰਹਾ ਦੀ ਮੰਗਣੀ ਕਰ ਦਿਆਂਗੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "हो आपस बीच सगाई तिन की करैं तौ ॥९॥",
      "sourceLineId": "122251",
      "sourceShabadId": "11377",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122252",
      "sourceShabadId": "11378",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਯੌ ਕਹਿ ਕੈ ਤ੍ਰਿਯ ਗ੍ਰਿਹ ਗਈ ਦ੍ਵੈਕਨ ਬੀਤੇ ਜਾਮ ॥",
      "transliteration": "yau keh kai tiray gireh giee dhavaikan beete jaam ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦੀ ਗੱਲ ਕਰ ਕੇ ਦੋਵੇਾਂ ਇਸਤਰੀਆਂ ਆਪਣੇ ਆਪਣੇ ਘਰ ਚਲੀਆਂ ਗਈਆਂ। ਜਦ ਦੋ ਕੁ ਪਹਿਰ ਬੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "यौ कहि कै तृय गृह गई द्वैकन बीते जाम ॥",
      "sourceLineId": "122253",
      "sourceShabadId": "11378",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੁਤਾ ਏਕ ਕੇ ਗ੍ਰਿਹ ਭਈ ਪੂਤ ਏਕ ਕੇ ਧਾਮ ॥੧੦॥",
      "transliteration": "sutaa ek ke gireh bhiee poot ek ke dhaam ||10||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ) ਇਕ ਦੇ ਘਰ ਲੜਕਾ ਅਤੇ ਇਕ ਦੇ ਘਰ ਲੜਕੀ ਪੈਦਾ ਹੋਈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "सुता एक के गृह भई पूत एक के धाम ॥१०॥",
      "sourceLineId": "122254",
      "sourceShabadId": "11378",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122255",
      "sourceShabadId": "11379",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੰਮਸ ਨਾਮ ਸੁਤਾ ਕੋ ਧਰਿਯੋ ॥",
      "transliteration": "sa(n)mas naam sutaa ko dhariyo ||",
      "translation": "",
      "punjabiViakhya": "ਲੜਕੀ ਦਾ ਨਾ ਸ਼ਮਸ ਰਖਿਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "संमस नाम सुता को धरियो ॥",
      "sourceLineId": "122256",
      "sourceShabadId": "11379",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਢੋਲਾ ਨਾਮ ਪੂਤ ਉਚਰਿਯੋ ॥",
      "transliteration": "ddolaa naam poot uchariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲੜਕੇ ਦਾ ਨਾ ਢੋਲਾ ਦਸਿਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "ढोला नाम पूत उचरियो ॥",
      "sourceLineId": "122257",
      "sourceShabadId": "11379",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਖਾਰਿਨ ਬੀਚ ਡਾਰਿ ਦੋਊ ਬ੍ਰਯਾਹੇ ॥",
      "transliteration": "khaarin beech ddaar dhouoo brayaahe ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੂੰ ਖਾਰਿਆਂ ਵਿਚ ਪਾ ਕੇ ਵਿਆਹਿਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "खारिन बीच डारि दोऊ ब्रयाहे ॥",
      "sourceLineId": "122258",
      "sourceShabadId": "11379",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਸੌ ਭਏ ਉਮਾਹੇ ॥੧੧॥",
      "transliteration": "bhaat bhaat sau bhe umaahe ||11||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਤਰ੍ਰਹਾ ਦੀਆਂ ਖ਼ੁਸ਼ੀਆਂ ਹੋਣ ਲਗੀਆਂ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "भाति भाति सौ भए उमाहे ॥११॥",
      "sourceLineId": "122259",
      "sourceShabadId": "11379",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122260",
      "sourceShabadId": "11380",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕੁਰੂਛੇਤ੍ਰ ਕੋ ਨ੍ਰਹਾਨ ਕਰਿ ਤਹ ਤੇ ਕਿਯੋ ਪਯਾਨ ॥",
      "transliteration": "kuroochhetr ko nrahaan kar teh te kiyo payaan ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਰੁਕਸ਼ੇਤ੍ਰ ਦਾ ਇਸ਼ਨਾਨ ਕਰ ਕੇ ਉਥੋ (ਦੋਵੇਾਂ ਪਰਿਵਾਰ) ਚਲ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "कुरूछेत्र को न्रहान करि तह ते कियो पयान ॥",
      "sourceLineId": "122261",
      "sourceShabadId": "11380",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਪਨੇ ਅਪਨੇ ਦੇਸ ਕੇ ਰਾਜ ਕਰਤ ਭੇ ਆਨਿ ॥੧੨॥",
      "transliteration": "apane apane dhes ke raaj karat bhe aan ||12||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਆਪਣੇ ਦੇਸ ਵਿਚ ਆ ਕੇ ਰਾਜ ਕਰਨ ਲਗੇ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "अपने अपने देस के राज करत भे आनि ॥१२॥",
      "sourceLineId": "122262",
      "sourceShabadId": "11380",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122263",
      "sourceShabadId": "11381",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਐਸੀ ਭਾਤਿਨ ਬਰਖ ਬਿਤਏ ॥",
      "transliteration": "aaisee bhaatin barakh bite ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਕਈ ਵਰ੍ਰਹੇ ਬੀਤ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "ऐसी भातिन बरख बितए ॥",
      "sourceLineId": "122264",
      "sourceShabadId": "11381",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਾਲਕ ਹੁਤੇ ਤਰੁਨ ਦੋਊ ਭਏ ॥",
      "transliteration": "baalak hute tarun dhouoo bhe ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਬਾਲਕ ਸਨ, (ਹੁਣ) ਜਵਾਨ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "बालक हुते तरुन दोऊ भए ॥",
      "sourceLineId": "122265",
      "sourceShabadId": "11381",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1043_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਬ ਅਪਨੋ ਤਿਨ ਰਾਜ ਸੰਭਾਰਿਯੋ ॥",
      "transliteration": "jab apano tin raaj sa(n)bhaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਢੋਲੇ ਨੇ ਆਪਣਾ ਰਾਜ ਭਾਗ ਸੰਭਾਲ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1043,
      "hindi": "",
      "hindiTransliteration": "जब अपनो तिन राज संभारियो ॥",
      "sourceLineId": "122266",
      "sourceShabadId": "11381",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
