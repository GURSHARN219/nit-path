{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1047,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1047_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਮ ਸਭ ਕੀ ਪ੍ਰਤਿਪਾਰਾ ਕੀਜੈ ॥੬॥",
      "transliteration": "ham sabh kee pratipaaraa keejai ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਸਾ ਸਾਰਿਆਂ ਦੀ ਪ੍ਰਤਿਪਾਲਨਾ ਕਰੋ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "हम सभ की प्रतिपारा कीजै ॥६॥",
      "sourceLineId": "122435",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪਤ੍ਰੀ ਬਾਚਿ ਫੂਲਿ ਜੜ ਗਏ ॥",
      "transliteration": "patree baach fool jaR ge ||",
      "translation": "",
      "punjabiViakhya": "ਚਿੱਠੀ ਪੜ੍ਰਹ ਕੇ (ਸਾਰੇ) ਮੂਰਖ ਫੁਲ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "पत्री बाचि फूलि जड़ गए ॥",
      "sourceLineId": "122436",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜੋਰਿ ਬਰਾਤਹਿ ਆਵਤ ਭਏ ॥",
      "transliteration": "jor baraateh aavat bhe ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਰਾਤ ਜੋੜ ਕੇ ਆ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "जोरि बरातहि आवत भए ॥",
      "sourceLineId": "122437",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਬ ਹੀ ਭਦ੍ਰ ਸੈਨ ਪੁਰ ਆਏ ॥",
      "transliteration": "jab hee bhadhr sain pur aae ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਭਦ੍ਰ ਸੈਨ ਦੇ ਨਗਰ ਵਿਚ ਆਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "जब ही भद्र सैन पुर आए ॥",
      "sourceLineId": "122438",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਯੌ ਬਚਨ ਸੁਨਾਏ ॥੭॥",
      "transliteration": "tab raanee yau bachan sunaae ||7||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "तब रानी यौ बचन सुनाए ॥७॥",
      "sourceLineId": "122439",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਏਕ ਏਕ ਸਾਊ ਹ੍ਯਾਂ ਆਵਹਿ ॥",
      "transliteration": "ek ek saauoo hayaa(n) aaveh ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਇਕ ਸਾਊ ਇਥੇ ਆਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "एक एक साऊ ह्याँ आवहि ॥",
      "sourceLineId": "122440",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਮ ਤੇ ਪਾਵ ਪੁਜਾਵਤ ਜਾਵਹਿ ॥",
      "transliteration": "ham te paav pujaavat jaaveh ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੇ ਕੋਲੋਂ (ਆਪਣੇ) ਪੈਰ ਪੁਜਵਾਉਾਂਦਾ ਜਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "हम ते पाव पुजावत जावहि ॥",
      "sourceLineId": "122441",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਆਪੁਨ ਨ੍ਰਿਪ ਆਵੈ ॥",
      "transliteration": "taa paachhe aapun nirap aavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਤੋਂ ਬਾਦ ਰਾਜਾ ਆਪ ਆਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "ता पाछे आपुन नृप आवै ॥",
      "sourceLineId": "122442",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੂਰਜ ਕਲਾ ਕੋ ਲੈ ਘਰ ਜਾਵੈ ॥੮॥",
      "transliteration": "sooraj kalaa ko lai ghar jaavai ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੂਰਜ ਕਲਾ ਨੂੰ ਲੈ ਕੇ ਘਰ ਜਾਵੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "सूरज कला को लै घर जावै ॥८॥",
      "sourceLineId": "122443",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਹਮਰੇ ਧਾਮ ਰੀਤਿ ਇਹ ਪਰੀ ॥",
      "transliteration": "hamare dhaam reet ieh paree ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਡੇ ਘਰ ਦੀ ਇਹ ਰੀਤ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "हमरे धाम रीति इह परी ॥",
      "sourceLineId": "122444",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਾ ਤੇ ਜਾਤ ਦੂਰਿ ਨਹਿ ਕਰੀ ॥",
      "transliteration": "taa te jaat dhoor neh karee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ (ਇਸ ਨੂੰ) ਦੂਰ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "ता ते जात दूरि नहि करी ॥",
      "sourceLineId": "122445",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਏਕ ਏਕ ਜੋਧਾ ਪ੍ਰਥਮਾਵਹਿ ॥",
      "transliteration": "ek ek jodhaa prathamaaveh ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਇਕ ਇਕ ਯੋਧਾ ਆਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "एक एक जोधा प्रथमावहि ॥",
      "sourceLineId": "122446",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਾ ਪਾਛੈ ਰਾਜਾ ਕੌ ਲ੍ਯਾਵਹਿ ॥੯॥",
      "transliteration": "taa paachhai raajaa kau layaaveh ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਤੋਂ ਬਾਦ ਰਾਜੇ ਨੂੰ ਲੈ ਕੇ ਆਉਣਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "ता पाछै राजा कौ ल्यावहि ॥९॥",
      "sourceLineId": "122447",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਏਕ ਏਕ ਸਾਊ ਤਹ ਆਯੋ ॥",
      "transliteration": "ek ek saauoo teh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਇਕ ਕਰ ਕੇ ਸਾਊ ਉਥੇ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "एक एक साऊ तह आयो ॥",
      "sourceLineId": "122448",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਡਾਰਿ ਡਾਰਿ ਫਾਸੀ ਤ੍ਰਿਯ ਘਾਯੋ ॥",
      "transliteration": "ddaar ddaar faasee tiray ghaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਫਾਹੀ ਪਾ ਪਾ ਕੇ ਇਸਤਰੀ ਨੇ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "डारि डारि फासी तृय घायो ॥",
      "sourceLineId": "122449",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਏਕ ਸੰਘਾਰਿ ਡਾਰਿ ਕਰਿ ਦੀਜੈ ॥",
      "transliteration": "ek sa(n)ghaar ddaar kar dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਨੂੰ ਮਾਰ ਕੇ ਸੁਟ ਦਿੰਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "एक संघारि डारि करि दीजै ॥",
      "sourceLineId": "122450",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੂਸਰ ਕੌ ਯੌ ਹੀ ਬਧ ਕੀਜੈ ॥੧੦॥",
      "transliteration": "dhoosar kau yau hee badh keejai ||10||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਫਿਰ) ਦੂਜੇ ਦਾ ਵੀ ਇਸੇ ਤਰ੍ਰਹਾ ਬਧ ਕਰ ਦਿੰਦੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "दूसर कौ यौ ही बध कीजै ॥१०॥",
      "sourceLineId": "122451",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਭ ਸੂਰਨ ਕੋ ਪ੍ਰਥਮ ਸੰਘਾਰਿਯੋ ॥",
      "transliteration": "sabh sooran ko pratham sa(n)ghaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਸੂਰਮਿਆਂ ਨੂੰ ਪਹਿਲਾ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "सभ सूरन को प्रथम संघारियो ॥",
      "sourceLineId": "122452",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਾਰਿ ਭੋਹਰਨ ਭੀਤਰਿ ਡਾਰਿਯੋ ॥",
      "transliteration": "maar bhoharan bheetar ddaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਾਰ ਕੇ ਭੋਰਿਆਂ ਵਿਚ ਸੁਟ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "मारि भोहरन भीतरि डारियो ॥",
      "sourceLineId": "122453",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਨ੍ਰਿਪ ਬੋਲ ਪਠਾਯੋ ॥",
      "transliteration": "taa paachhe nirap bol paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਤੋਂ ਬਾਦ ਰਾਜੇ ਨੂੰ ਬੁਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "ता पाछे नृप बोल पठायो ॥",
      "sourceLineId": "122454",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰਾਨੀ ਡਾਰਿ ਫਾਸ ਗਰ ਘਾਯੋ ॥੧੧॥",
      "transliteration": "raanee ddaar faas gar ghaayo ||11||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਉਸ ਦੇ ਗਲੇ ਵਿਚ ਫਾਹੀ ਪਾ ਕੇ ਮਾਰ ਦਿੱਤਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "रानी डारि फास गर घायो ॥११॥",
      "sourceLineId": "122455",
      "sourceShabadId": "11403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122456",
      "sourceShabadId": "11404",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਭ ਸੂਰਾ ਪ੍ਰਥਮੈ ਹਨੇ ਬਹੁਰਿ ਨ੍ਰਿਪਤਿ ਕੌ ਕੂਟਿ ॥",
      "transliteration": "sabh sooraa prathamai hane bahur nirapat kau kooT ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਸਾਰੇ ਸੂਰਮੇ ਮਾਰ ਦਿੱਤੇ ਅਤੇ ਫਿਰ ਰਾਜੇ ਨੂੰ ਕੁਟ ਸੁਟਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "सभ सूरा प्रथमै हने बहुरि नृपति कौ कूटि ॥",
      "sourceLineId": "122457",
      "sourceShabadId": "11404",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜੋ ਲਸਕਰ ਬਾਕੀ ਬਚਿਯੋ ਸੋ ਸਭ ਲੀਨੋ ਲੂਟਿ ॥੧੨॥",
      "transliteration": "jo lasakar baakee bachiyo so sabh leeno looT ||12||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਲਸ਼ਕਰ ਬਾਕੀ ਬਚਿਆ ਸੀ ਉਸ ਸਾਰੇ ਨੂੰ ਲੁਟ ਲਿਆ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "जो लसकर बाकी बचियो सो सभ लीनो लूटि ॥१२॥",
      "sourceLineId": "122458",
      "sourceShabadId": "11404",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਭ ਬੈਰਿਨ ਕੌ ਘਾਇ ਕੈ ਸੁਤ ਕੌ ਰਾਜ ਬੈਠਾਇ ॥",
      "transliteration": "sabh bairin kau ghai kai sut kau raaj baiThai ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਵੈਰੀਆਂ ਨੂੰ ਮਾਰ ਕੇ ਪੁੱਤਰ ਨੂੰ ਗੱਦੀ ਉਤੇ ਬਿਠਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "सभ बैरिन कौ घाइ कै सुत कौ राज बैठाइ ॥",
      "sourceLineId": "122459",
      "sourceShabadId": "11404",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪੁਨਿ ਪਤਿ ਕੇ ਫੈਂਟਾ ਭਏ ਜਰੀ ਮ੍ਰਿਦੰਗ ਬਜਾਇ ॥੧੩॥",
      "transliteration": "pun pat ke fai(n)Taa bhe jaree miradha(n)g bajai ||13||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਢੋਲ ਵਜਾ ਕੇ ਪਤੀ ਦੇ ਫੈਂਟੇ (ਸਿਰ ਲਪੇਟਣ ਦੇ ਬਸਤ੍ਰ) ਨਾਲ ਸੜ ਮੋਈ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "पुनि पति के फैंटा भए जरी मृदंग बजाइ ॥१३॥",
      "sourceLineId": "122460",
      "sourceShabadId": "11404",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਤ੍ਰਿਸਠਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੬੩॥੩੨੩੭॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau tirasaThavo charitr samaapatam sat subham sat ||163||3237||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੬੩ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੬੩॥੩੨੩੭॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ तृसठवो चरित्र समापतम सतु सुभम सतु ॥१६३॥३२३७॥अफजूँ॥",
      "sourceLineId": "122461",
      "sourceShabadId": "11404",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122462",
      "sourceShabadId": "11405",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਉਦੈ ਪੁਰੀ ਖੁਰਰਮ ਕੀ ਨਾਰੀ ॥",
      "transliteration": "audhai puree khuraram kee naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਦੈ ਪੁਰੀ (ਨਾਲ ਸੰਬੰਧ ਰਖਣ ਵਾਲੀ) ਖੁੱਰਮ (ਸ਼ਾਹਜਹਾਨ) ਦੀ ਇਸਤਰੀ",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "उदै पुरी खुररम की नारी ॥",
      "sourceLineId": "122463",
      "sourceShabadId": "11405",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹਜਰਤਿ ਕੌ ਪ੍ਰਾਨਨ ਤੇ ਪ੍ਯਾਰੀ ॥",
      "transliteration": "hajarat kau praanan te payaaree ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਦਸ਼ਾਹ ਨੂੰ ਪ੍ਰਾਣਾ ਤੋਂ ਵੀ ਪਿਆਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "हजरति कौ प्रानन ते प्यारी ॥",
      "sourceLineId": "122464",
      "sourceShabadId": "11405",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮੁਖ ਸੂਖਤ ਜੀ ਜੀ ਤਿਹ ਕਰਤੇ ॥",
      "transliteration": "mukh sookhat jee jee teh karate ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜੀ ਜੀ ਕਰਦਿਆਂ ਉਸ ਦਾ ਮੂੰਹ ਸੁਕਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "मुख सूखत जी जी तिह करते ॥",
      "sourceLineId": "122465",
      "sourceShabadId": "11405",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਨਤ ਨ ਲਖੇ ਤਵਨ ਕੇ ਡਰਤੇ ॥੧॥",
      "transliteration": "anat na lakhe tavan ke ddarate ||1||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਤੋਂ ਡਰਦਿਆਂ ਹੋਰ ਕਿਸੇ ਵਲ ਵੇਖਦਾ ਵੀ ਨਹੀਂ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "अनत न लखे तवन के डरते ॥१॥",
      "sourceLineId": "122466",
      "sourceShabadId": "11405",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬੇਗਮ ਬਾਗ ਏਕ ਦਿਨ ਚਲੀ ॥",
      "transliteration": "begam baag ek dhin chalee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਬੇਗਮ ਬਾਗ਼ ਵਲ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "बेगम बाग एक दिन चली ॥",
      "sourceLineId": "122467",
      "sourceShabadId": "11405",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੋਰਹ ਸਤ ਲੀਨੋ ਸੰਗ ਅਲੀ ॥",
      "transliteration": "soreh sat leeno sa(n)g alee ||",
      "translation": "",
      "punjabiViakhya": "ਸੋਲ੍ਰਹਾ ਸੌ ਸਹੇਲੀਆਂ ਨੂੰ ਨਾਲ ਲੈ ਕੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "सोरह सत लीनो संग अली ॥",
      "sourceLineId": "122468",
      "sourceShabadId": "11405",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੁੰਦਰ ਨਰ ਇਕ ਪੇਖਤ ਭਈ ॥",
      "transliteration": "su(n)dhar nar ik pekhat bhiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ) ਉਸ ਨੇ ਇਕ ਸੁੰਦਰ ਆਦਮੀ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "सुँदर नर इक पेखत भई ॥",
      "sourceLineId": "122469",
      "sourceShabadId": "11405",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤ੍ਰਿਯ ਕੌ ਭੂਲਿ ਸਕਲ ਸੁਧਿ ਗਈ ॥੨॥",
      "transliteration": "tiray kau bhool sakal sudh giee ||2||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਉਸ) ਇਸਤਰੀ ਨੂੰ ਸਾਰੀ ਸੁੱਧ ਬੁੱਧ ਭੁਲ ਗਈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "तृय कौ भूलि सकल सुधि गई ॥२॥",
      "sourceLineId": "122470",
      "sourceShabadId": "11405",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122471",
      "sourceShabadId": "11406",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੋਬਨ ਕੁਅਰਿ ਸਖੀ ਹੁਤੀ ਲੀਨੀ ਨਿਕਟ ਬੁਲਾਇ ॥",
      "transliteration": "joban kuar sakhee hutee leenee nikaT bulai ||",
      "translation": "",
      "punjabiViakhya": "(ਬੇਗਮ ਦੀ ਇਕ) ਜੋਬਨ ਕੁਅਰਿ ਨਾ ਦੀ ਸਖੀ ਸੀ, ਉਸ ਨੂੰ ਕੋਲ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "जोबन कुअरि सखी हुती लीनी निकट बुलाइ ॥",
      "sourceLineId": "122472",
      "sourceShabadId": "11406",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਉਦੈ ਪੁਰੀ ਤਾ ਸੌ ਸਕਲ ਭੇਦ ਕਹਿਯੋ ਸਮਝਾਇ ॥੩॥",
      "transliteration": "audhai puree taa sau sakal bhedh kahiyo samajhai ||3||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਉਦੈ ਪੁਰੀ (ਬੇਗਮ) ਨੇ ਸਾਰੀ ਗੱਲ ਸਮਝਾ ਦਿੱਤੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "उदै पुरी ता सौ सकल भेद कहियो समझाइ ॥३॥",
      "sourceLineId": "122473",
      "sourceShabadId": "11406",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਵੈਯਾ ॥",
      "transliteration": "savaiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੈਯਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "सवैया ॥",
      "sourceLineId": "122474",
      "sourceShabadId": "11407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਾਨਿ ਕਰੌ ਨਹਿ ਸਾਹਿਜਹਾਨ ਕੀ ਧਾਮ ਜਿਤੋ ਧਨ ਹੈ ਸੁ ਲੁਟਾਊਾਂ ॥",
      "transliteration": "kaan karau neh saahijahaan kee dhaam jito dhan hai su luTaauooaa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਤੂੰ) ਸ਼ਾਹਜਹਾਨ ਦੀ ਬਿਲਕੁਲ ਪਰਵਾਹ ਨਾ ਕਰੀਂ, (ਮੇਰੇ ਪਾਸ) ਜਿਤਨਾ ਧਨ ਹੈ, ਲੁਟਾ ਦਿਆਂਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "कानि करौ नहि साहिजहान की धाम जितो धन है सु लुटाऊाँ ॥",
      "sourceLineId": "122475",
      "sourceShabadId": "11407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅੰਬਰ ਫਾਰਿ ਦਿਗੰਬਰ ਹ੍ਵੈ ਕਰਿ ਚੰਦਨੁਤਾਰਿ ਬਿਭੂਤਿ ਚੜਾਊਾਂ ॥",
      "transliteration": "a(n)bar faar dhiga(n)bar havai kar cha(n)dhanutaar bibhoot chaRaauooaa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਸਤ੍ਰ ਫਾੜ ਕੇ ਅਤੇ ਨਿਰਬਸਤ੍ਰ ਹੋ ਕੇ ਚੰਦਨ (ਦੇ ਲੇਪ ਨੂੰ) ਉਤਾਰ ਕੇ ਬਿਭੂਤ ਮਲ ਲਵਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "अंबर फारि दिगंबर ह्वै करि चंदनुतारि बिभूति चड़ाऊाँ ॥",
      "sourceLineId": "122476",
      "sourceShabadId": "11407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਾ ਸੌ ਕਹੌ ਨਹਿ ਤੂ ਹਮਰੋ ਕੋਊ ਜੀ ਕੀ ਬ੍ਰਿਥਾ ਕਹਿ ਤਾਹਿ ਸੁਨਾਊਾਂ ॥",
      "transliteration": "kaa sau kahau neh too hamaro kouoo jee kee birathaa keh taeh sunaauooaa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸ ਨਾਲ ਗੱਲ ਕਰਾ, ਤੇਰੇ ਬਿਨਾ ਮੇਰਾ ਕੋਈ ਨਹੀਂ ਹੈ ਜਿਸ ਨੂੰ ਮਨ ਦੀ ਪੀੜ ਸੁਣਾ ਸਕਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "का सौ कहौ नहि तू हमरो कोऊ जी की बृथा कहि ताहि सुनाऊाँ ॥",
      "sourceLineId": "122477",
      "sourceShabadId": "11407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪੰਖ ਦਏ ਬਿਧਿ ਤੂ ਲਖਿ ਮੋ ਕਹ ਪ੍ਰੀਤਮ ਕੌ ਉਡਿ ਕੈ ਮਿਲਿ ਆਊਾਂ ॥੪॥",
      "transliteration": "pa(n)kh dhe bidh too lakh mo keh preetam kau udd kai mil aauooaa(n) ||4||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਰੱਬ ਨੇ ਮੈਨੂੰ ਖੰਭ ਲਗਾਏ ਹੁੰਦੇ, ਤਾ ਤੇਰੇ ਵੇਖਦਿਆਂ ਪ੍ਰੀਤਮ ਨੂੰ ਉਡ ਕੇ ਮਿਲ ਆਉਾਂਦੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "पंख दए बिधि तू लखि मो कह प्रीतम कौ उडि कै मिलि आऊाँ ॥४॥",
      "sourceLineId": "122478",
      "sourceShabadId": "11407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪ੍ਰੀਤਿ ਕਰੀ ਤਿਹ ਸੌ ਕਿਹ ਕਾਜ ਸੁ ਮੀਤ ਕੇ ਕਾਜ ਜੁ ਮੀਤ ਨ ਆਵੈ ॥",
      "transliteration": "preet karee teh sau keh kaaj su meet ke kaaj ju meet na aavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਕੀਤੀ ਪ੍ਰੀਤ ਕਿਸ ਕੰਮ ਦੀ, ਜੇ ਮਿਤਰ ਦੇ ਕੰਮ ਮਿਤਰ ਨਾ ਆਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "प्रीति करी तिह सौ किह काज सु मीत के काज जु मीत न आवै ॥",
      "sourceLineId": "122479",
      "sourceShabadId": "11407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1047_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪੀਰ ਕਹੈ ਅਪਨੇ ਚਿਤ ਮੈ ਉਹਿ ਪੀਰ ਕੌ ਪੀਰ ਕੇ ਨੀਰ ਬੁਝਾਵੈ ॥",
      "transliteration": "peer kahai apane chit mai uh peer kau peer ke neer bujhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਚਿਤ ਦੀ ਪੀੜ ਉਸ ਨਾਲ ਸਾਝੀ ਕਰੇ, ਉਸ ਪੀੜ ਨੂੰ (ਮਿਤਰ ਆਪਣੀ) ਪੀੜ ਸਮਝ ਕੇ (ਅੱਖਾ ਦੇ) ਜਲ ਨਾਲ ਬੁਝਾ ਦੇਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1047,
      "hindi": "",
      "hindiTransliteration": "पीर कहै अपने चित मै उहि पीर कौ पीर के नीर बुझावै ॥",
      "sourceLineId": "122480",
      "sourceShabadId": "11407",
