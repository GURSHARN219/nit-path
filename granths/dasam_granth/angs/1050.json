{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1050,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1050_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਾਤ ਪੂਤ ਹਨਿ ਪਤਹਿ ਸੰਘਾਰਿਯੋ ॥",
      "transliteration": "saat poot han pateh sa(n)ghaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਸੱਤ ਪੁੱਤਰਾ ਨੂੰ ਮਾਰ ਕੇ ਫਿਰ ਪਤੀ ਨੂੰ ਸੰਘਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "सात पूत हनि पतहि संघारियो ॥",
      "sourceLineId": "122579",
      "sourceShabadId": "11422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਹੁਰਿ ਮੂੰਡ ਅਪਨੋ ਕਟਿ ਡਾਰਿਯੋ ॥",
      "transliteration": "bahur moo(n)dd apano kaT ddaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਆਪਣਾ ਸਿਰ ਕਟ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "बहुरि मूँड अपनो कटि डारियो ॥",
      "sourceLineId": "122580",
      "sourceShabadId": "11422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਾਵ ਚਕ੍ਰਯੋ ਕੌਤਕ ਜਬ ਲਹਿਯੋ ॥",
      "transliteration": "raav chakrayo kauatak jab lahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਜਦ ਕੌਤਕ ਵੇਖਿਆ ਤਾ ਹੈਰਾਨ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "राव चक्रयो कौतक जब लहियो ॥",
      "sourceLineId": "122581",
      "sourceShabadId": "11422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੋਈ ਖੜਗ ਹਾਥ ਮੈ ਗਹਿਯੋ ॥੧੨॥",
      "transliteration": "soiee khaRag haath mai gahiyo ||12||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਉਹ ਤਲਵਾਰ ਹੱਥ ਵਿਚ ਪਕੜ ਲਈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "सोई खड़ग हाथ मै गहियो ॥१२॥",
      "sourceLineId": "122582",
      "sourceShabadId": "11422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਾਤ ਪੂਤ ਹਮਰੇ ਹਿਤ ਮਾਰੇ ॥",
      "transliteration": "saat poot hamare hit maare ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ ਕਿਹਾ ਕਿ ਇਸ ਇਸਤਰੀ ਨੇ) ਮੇਰੇ ਲਈ (ਪਹਿਲਾ) ਸੱਤ ਪੁੱਤਰ ਮਾਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "सात पूत हमरे हित मारे ॥",
      "sourceLineId": "122583",
      "sourceShabadId": "11422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਹੁਰਿ ਆਪੁਨੇ ਨਾਥ ਸੰਘਾਰੇ ॥",
      "transliteration": "bahur aapune naath sa(n)ghaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਆਪਣੇ ਨਾਥ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "बहुरि आपुने नाथ संघारे ॥",
      "sourceLineId": "122584",
      "sourceShabadId": "11422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪੁਨਿ ਇਨ ਦੇਹ ਨੇਹ ਮਮ ਦਿਯੋ ॥",
      "transliteration": "pun in dheh neh mam dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਮੇਰੇ ਪਿਆਰ ਲਈ ਆਪਣੀ ਦੇਹ ਵੀ ਕੁਰਬਾਨ ਕਰ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "पुनि इन देह नेह मम दियो ॥",
      "sourceLineId": "122585",
      "sourceShabadId": "11422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਧ੍ਰਿਗ ਇਹ ਰਾਜ ਹਮਾਰੋ ਕਿਯੋ ॥੧੩॥",
      "transliteration": "dhirag ieh raaj hamaaro kiyo ||13||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਰਾਜ ਕਰਨਾ ਮੇਰੇ ਲਈ ਧਿੱਕਾਰ ਹੈ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "धृग इह राज हमारो कियो ॥१३॥",
      "sourceLineId": "122586",
      "sourceShabadId": "11422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੋਈ ਖੜਗ ਕੰਠੀ ਪਰ ਧਰਿਯੋ ॥",
      "transliteration": "soiee khaRag ka(n)Thee par dhariyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹੀ ਤਲਵਾਰ (ਉਸ ਨੇ) ਆਪਣੇ ਗਲੇ ਉਤੇ ਧਰ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "सोई खड़ग कंठी पर धरियो ॥",
      "sourceLineId": "122587",
      "sourceShabadId": "11422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਾਰਨ ਅਪਨੋ ਆਪੁ ਬਿਚਰਿਯੋ ॥",
      "transliteration": "maaran apano aap bichariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਆਪ ਨੂੰ ਮਾਰਨ ਦਾ ਵਿਚਾਰ ਬਣਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "मारन अपनो आपु बिचरियो ॥",
      "sourceLineId": "122588",
      "sourceShabadId": "11422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਕਰੀ ਤਬ ਤਾਹਿ ਭਵਾਨੀ ॥",
      "transliteration": "kirapaa karee tab taeh bhavaanee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਭਵਾਨੀ ਨੇ ਉਸ ਉਤੇ ਕ੍ਰਿਪਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "कृपा करी तब ताहि भवानी ॥",
      "sourceLineId": "122589",
      "sourceShabadId": "11422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਐਸੀ ਭਾਤਿ ਬਖਾਨੀ ਬਾਨੀ ॥੧੪॥",
      "transliteration": "aaisee bhaat bakhaanee baanee ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਤਰ੍ਰਹਾ ਬਚਨ ਉਚਾਰੇ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "ऐसी भाति बखानी बानी ॥१४॥",
      "sourceLineId": "122590",
      "sourceShabadId": "11422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "122591",
      "sourceShabadId": "11423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਨ ਕੌ ਲੇਹੁ ਜਿਯਾਇ ਨ ਨਿਜੁ ਬਧ ਕੀਜਿਯੈ ॥",
      "transliteration": "ein kau leh jiyai na nij badh keejiyai ||",
      "translation": "",
      "punjabiViakhya": "(ਹੇ ਰਾਜਨ!) ਇਨ੍ਰਹਾ ਨੂੰ ਜਿਵਾ ਲਵੋ ਅਤੇ ਆਪਣਾ ਬਧ ਨਾ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "इन कौ लेहु जियाइ न निजु बध कीजियै ॥",
      "sourceLineId": "122592",
      "sourceShabadId": "11423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਾਜ ਬਰਿਸ ਬਹੁ ਕਰੌ ਬਹੁਤ ਦਿਨ ਜੀਜੀਯੈ ॥",
      "transliteration": "raaj baris bahu karau bahut dhin jeejeeyai ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਸਾਲ ਰਾਜ ਕਰੋ ਅਤੇ ਬਹੁਤ ਸਮੇਾਂ ਤਕ ਜੀਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "राज बरिस बहु करौ बहुत दिन जीजीयै ॥",
      "sourceLineId": "122593",
      "sourceShabadId": "11423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਬ ਦੁਰਗਾ ਤੈ ਸਭ ਹੀ ਦਏ ਜਿਯਾਇ ਕੈ ॥",
      "transliteration": "tab dhuragaa tai sabh hee dhe jiyai kai ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦੁਰਗਾ ਨੇ ਰਾਜੇ ਦੀ ਪ੍ਰੀਤ ਨੂੰ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "तब दुरगा तै सभ ही दए जियाइ कै ॥",
      "sourceLineId": "122594",
      "sourceShabadId": "11423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹੋ ਨਿਰਖਿ ਨ੍ਰਿਪਤਿ ਕੀ ਪ੍ਰੀਤਿ ਹਰਖ ਉਪਜਾਇ ਕੈ ॥੧੫॥",
      "transliteration": "ho nirakh nirapat kee preet harakh upajai kai ||15||",
      "translation": "",
      "punjabiViakhya": "ਖ਼ੁਸ਼ੀ ਖ਼ੁਸ਼ੀ ਸਭ ਨੂੰ ਜੀਵਿਤ ਕਰ ਦਿੱਤਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "हो निरखि नृपति की प्रीति हरख उपजाइ कै ॥१५॥",
      "sourceLineId": "122595",
      "sourceShabadId": "11423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122596",
      "sourceShabadId": "11424",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਐਸੋ ਢੀਠ ਤਵਨ ਤ੍ਰਿਯ ਕਰਿਯੋ ॥",
      "transliteration": "aaiso ddeeTh tavan tiray kariyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਪ੍ਰਕਾਰ ਦਾ ਉਸ ਇਸਤਰੀ ਨੇ ਨਿਧੜਕ ਹਠ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "ऐसो ढीठ तवन तृय करियो ॥",
      "sourceLineId": "122597",
      "sourceShabadId": "11424",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪਤਿ ਪੂਤਨ ਕੇ ਪ੍ਰਾਨਨ ਹਰਿਯੋ ॥",
      "transliteration": "pat pootan ke praanan hariyo ||",
      "translation": "",
      "punjabiViakhya": "ਪਤੀ ਅਤੇ ਪੁੱਤਰ ਦੇ ਪ੍ਰਾਣ ਹਰ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "पति पूतन के प्रानन हरियो ॥",
      "sourceLineId": "122598",
      "sourceShabadId": "11424",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਹੁਰੋ ਬਧ ਅਪਨੋ ਕਹੂੰ ਕੀਨੋ ॥",
      "transliteration": "bahuro badh apano kahoo(n) keeno ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਆਪਣੇ ਆਪ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "बहुरो बध अपनो कहूँ कीनो ॥",
      "sourceLineId": "122599",
      "sourceShabadId": "11424",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪ੍ਰਾਨ ਬਚਾਇ ਨ੍ਰਿਪਤਿ ਕੋ ਲੀਨੋ ॥੧੬॥",
      "transliteration": "praan bachai nirapat ko leeno ||16||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦੇ ਪ੍ਰਾਣ ਬਚਾ ਲਏ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "प्रान बचाइ नृपति को लीनो ॥१६॥",
      "sourceLineId": "122600",
      "sourceShabadId": "11424",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122601",
      "sourceShabadId": "11425",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਿਰਖਿ ਸਤਤਾ ਸਭਨ ਕੀ ਜਗ ਜਨਨੀ ਹਰਖਾਇ ॥",
      "transliteration": "nirakh satataa sabhan kee jag jananee harakhai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਦੀ ਸਤਿਅਤਾ ਵੇਖ ਕੇ ਜਗ ਜਨਨੀ (ਦੇਵੀ) ਨੇ ਪ੍ਰਸੰਨਤਾ ਪੂਰਵਕ",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "निरखि सतता सभन की जग जननी हरखाइ ॥",
      "sourceLineId": "122602",
      "sourceShabadId": "11425",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਾਤ ਪੂਤ ਪਤਿ ਕੇ ਸਹਿਤ ਤਿਹ ਜੁਤ ਦਏ ਜਿਯਾਇ ॥੧੭॥",
      "transliteration": "saat poot pat ke sahit teh jut dhe jiyai ||17||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਨੂੰ ਪਤੀ ਅਤੇ ਸੱਤ ਪੁੱਤਰਾ ਸਹਿਤ ਜੀਵਿਤ ਕਰ ਦਿੱਤਾ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "सात पूत पति के सहित तिह जुत दए जियाइ ॥१७॥",
      "sourceLineId": "122603",
      "sourceShabadId": "11425",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤ੍ਰਿਯ ਚਰਿਤ੍ਰ ਦੁਹਕਰਿ ਕਰਿਯੋ ਜੈਸੋ ਕਰੈ ਨ ਕੋਇ ॥",
      "transliteration": "tiray charitr dhuhakar kariyo jaiso karai na koi ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਨੇ ਬਹੁਤ ਔਖਾ ਚਰਿਤ੍ਰ ਕੀਤਾ ਜਿਹੋ ਜਿਹਾ ਕੋਈ ਵੀ ਨਹੀਂ ਕਰ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "तृय चरित्र दुहकरि करियो जैसो करै न कोइ ॥",
      "sourceLineId": "122604",
      "sourceShabadId": "11425",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪੁਰੀ ਚਤ੍ਰਦਸ ਕੇ ਬਿਖੈ ਧੰਨ੍ਯ ਧੰਨ੍ਯ ਤਿਹ ਹੋਇ ॥੧੮॥",
      "transliteration": "puree chatradhas ke bikhai dha(n)nay dha(n)nay teh hoi ||18||",
      "translation": "",
      "punjabiViakhya": "ਚੌਦਾ ਲੋਕਾ ਵਿਚ ਉਸ ਦੀ ਧੰਨ ਧੰਨ ਹੋਣ ਲਗ ਗਈ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "पुरी चत्रदस के बिखै धंन्य धंन्य तिह होइ ॥१८॥",
      "sourceLineId": "122605",
      "sourceShabadId": "11425",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122606",
      "sourceShabadId": "11426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਾਤ ਪੂਤ ਮੂਏ ਜਿਯਰਾਏ ॥",
      "transliteration": "saat poot mooe jiyaraae ||",
      "translation": "",
      "punjabiViakhya": "ਮੋਏ ਹੋਏ ਸੱਤ ਪੁੱਤਰ ਜਿਵਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "सात पूत मूए जियराए ॥",
      "sourceLineId": "122607",
      "sourceShabadId": "11426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਪਨੀ ਦੇਹ ਸਹਿਤ ਪਤਿ ਪਾਏ ॥",
      "transliteration": "apanee dheh sahit pat paae ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੀ ਦੇਹ ਸਮੇਤ ਪਤੀ ਨੂੰ ਪ੍ਰਾਪਤ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "अपनी देह सहित पति पाए ॥",
      "sourceLineId": "122608",
      "sourceShabadId": "11426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨ੍ਰਿਪ ਕੀ ਬਡੀ ਆਰਬਲ ਹੋਈ ॥",
      "transliteration": "nirap kee baddee aarabal hoiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦੀ ਆਯੂ ਲੰਬੀ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "नृप की बडी आरबल होई ॥",
      "sourceLineId": "122609",
      "sourceShabadId": "11426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਐਸੋ ਕਰਤ ਚਰਿਤ੍ਰ ਨ ਕੋਈ ॥੧੯॥",
      "transliteration": "aaiso karat charitr na koiee ||19||",
      "translation": "",
      "punjabiViakhya": "ਅਜਿਹਾ ਚਰਿਤ੍ਰ ਕੋਈ ਵੀ ਨਹੀਂ ਕਰ ਸਕਦਾ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "ऐसो करत चरित्र न कोई ॥१९॥",
      "sourceLineId": "122610",
      "sourceShabadId": "11426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਪੈਸਠਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੬੫॥੩੨੭੪॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau paisaThavo charitr samaapatam sat subham sat ||165||3274||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੬੫ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੬੫॥੩੨੭੪॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ पैसठवो चरित्र समापतम सतु सुभम सतु ॥१६५॥३२७४॥अफजूँ॥",
      "sourceLineId": "122611",
      "sourceShabadId": "11426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122612",
      "sourceShabadId": "11427",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੁਕ੍ਰਿਤ ਸਿੰਘ ਸੂਰੋ ਬਡੋ ਸੂਰਤਿ ਕੋ ਨਰਪਾਲ ॥",
      "transliteration": "sukirat si(n)gh sooro baddo soorat ko narapaal ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਤ (ਨਗਰ) ਦਾ ਸੁਕ੍ਰਿਤ ਸਿੰਘ ਨਾ ਦਾ ਵੱਡਾ ਸੂਰਮਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "सुकृत सिंघ सूरो बडो सूरति को नरपाल ॥",
      "sourceLineId": "122613",
      "sourceShabadId": "11427",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜੁਬਨ ਕਲਾ ਰਾਨੀ ਰਹੈ ਜਾ ਕੇ ਨੈਨ ਬਿਸਾਲ ॥੧॥",
      "transliteration": "juban kalaa raanee rahai jaa ke nain bisaal ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਰਾਣੀ ਜੁਬਨ ਕਲਾ ਸੀ ਜਿਸ ਦੇ ਵੱਡੇ ਨੇਤਰ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "जुबन कला रानी रहै जा के नैन बिसाल ॥१॥",
      "sourceLineId": "122614",
      "sourceShabadId": "11427",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122615",
      "sourceShabadId": "11428",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਾ ਕੇ ਏਕ ਪੂਤ ਗ੍ਰਿਹ ਭਯੋ ॥",
      "transliteration": "taa ke ek poot gireh bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਇਕ ਪੁੱਤਰ ਪੈਦਾ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "ता के एक पूत गृह भयो ॥",
      "sourceLineId": "122616",
      "sourceShabadId": "11428",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਵਤਿਨ ਡਾਰਿ ਸਿੰਧੁ ਮੈ ਦਯੋ ॥",
      "transliteration": "savatin ddaar si(n)dh mai dhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਸੌਂਕਣ ('ਸਵਤਿਨ') ਨੇ ਸਮੁੰਦਰ ਵਿਚ ਸੁਟ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "सवतिन डारि सिंधु मै दयो ॥",
      "sourceLineId": "122617",
      "sourceShabadId": "11428",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਹਿਯੋ ਕਿ ਇਹ ਭਿਰਟੀ ਲੈ ਗਈ ॥",
      "transliteration": "kahiyo k ieh bhiraTee lai giee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਹਾ ਕਿ ਉਸ ਨੂੰ ਬਘਿਆੜੀ ('ਭਿਰਟੀ') ਲੈ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "कहियो कि इह भिरटी लै गई ॥",
      "sourceLineId": "122618",
      "sourceShabadId": "11428",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਇਹੈ ਖਬਰਿ ਰਾਜਾ ਕਹ ਭਈ ॥੨॥",
      "transliteration": "eihai khabar raajaa keh bhiee ||2||",
      "translation": "",
      "punjabiViakhya": "ਇਹੀ ਖ਼ਬਰ (ਉਸ ਨੇ) ਰਾਜੇ ਨੂੰ ਵੀ ਕਹਿ ਦਿੱਤੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "इहै खबरि राजा कह भई ॥२॥",
      "sourceLineId": "122619",
      "sourceShabadId": "11428",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰਾਨੀ ਅਧਿਕ ਸੋਕ ਤਬ ਕੀਨੋ ॥",
      "transliteration": "raanee adhik sok tab keeno ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਤਦ ਬਹੁਤ ਦੁਖ ਮਨਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "रानी अधिक सोक तब कीनो ॥",
      "sourceLineId": "122620",
      "sourceShabadId": "11428",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮਾਥੋ ਫੋਰਿ ਭੂੰਮਿ ਤਨ ਦੀਨੋ ॥",
      "transliteration": "maatho for bhoo(n)m tan dheeno ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਧਰਤੀ ਨਾਲ ਮੱਥਾ ਮਾਰ ਕੇ ਫੋੜ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "माथो फोरि भूँमि तन दीनो ॥",
      "sourceLineId": "122621",
      "sourceShabadId": "11428",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਬ ਰਾਜਾ ਤਾ ਕੇ ਗ੍ਰਿਹ ਆਯੋ ॥",
      "transliteration": "tab raajaa taa ke gireh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜਾ ਉਸ ਦੇ ਮਹੱਲ ਵਿਚ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "तब राजा ता के गृह आयो ॥",
      "sourceLineId": "122622",
      "sourceShabadId": "11428",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਿਹ ਤਾਪ ਮਿਟਾਯੋ ॥੩॥",
      "transliteration": "bhaat bhaat teh taap miTaayo ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਤਰ੍ਰਹਾ ਨਾਲ ਉਸ ਦੇ ਦੁਖ ਨੂੰ ਦੂਰ ਕੀਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तिह ताप मिटायो ॥३॥",
      "sourceLineId": "122623",
      "sourceShabadId": "11428",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਰੀਤਿ ਕਾਲ ਕੀ ਕਿਨੂੰ ਨ ਜਾਨੀ ॥",
      "transliteration": "reet kaal kee kinoo(n) na jaanee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ ਕਿਹਾ) ਕਾਲ ਦੀ ਰੀਤ ਕਿਸੇ ਨੇ ਨਹੀਂ ਸਮਝੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "रीति काल की किनूँ न जानी ॥",
      "sourceLineId": "122624",
      "sourceShabadId": "11428",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਊਚ ਨੀਚ ਕੇ ਸੀਸ ਬਿਹਾਨੀ ॥",
      "transliteration": "uooch neech ke sees bihaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉੱਚੇ ਨੀਵੇਾਂ (ਸਭ) ਦੇ ਸਿਰ ਉਤੇ ਪੈਂਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "ऊच नीच के सीस बिहानी ॥",
      "sourceLineId": "122625",
      "sourceShabadId": "11428",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1050_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਏਕੈ ਬਚਤ ਕਾਲ ਸੇ ਸੋਊ ॥",
      "transliteration": "ekai bachat kaal se souoo ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਤੋਂ ਇਕੋ (ਪਰਮਾਤਮਾ) ਹੀ ਬਚਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1050,
      "hindi": "",
      "hindiTransliteration": "एकै बचत काल से सोऊ ॥",
      "sourceLineId": "122626",
      "sourceShabadId": "11428",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
