{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1051,
  "lineCount": 74,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1051_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਵ ਰੰਕ ਅਰੁ ਬਚਤ ਨ ਕੋਊ ॥੪॥",
      "transliteration": "raav ra(n)k ar bachat na kouoo ||4||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਰੰਕ ਅਤੇ ਹੋਰ ਕੋਈ ਵੀ ਨਹੀਂ ਬਚਦਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "राव रंक अरु बचत न कोऊ ॥४॥",
      "sourceLineId": "122627",
      "sourceShabadId": "11428",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122628",
      "sourceShabadId": "11429",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜੋ ਉਪਜਿਯੋ ਸੋ ਬਿਨਸਿਯੋ ਜਿਯਤ ਨ ਰਹਸੀ ਕੋਇ ॥",
      "transliteration": "jo upajiyo so binasiyo jiyat na rahasee koi ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਪੈਦਾ ਹੋਇਆ ਹੈ, ਉਹ (ਅਵੱਸ਼) ਨਸ਼ਟ ਹੋਏਗਾ, ਕੋਈ ਵੀ ਜੀਉਾਂਦਾ ਨਹੀਂ ਰਹੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "जो उपजियो सो बिनसियो जियत न रहसी कोइ ॥",
      "sourceLineId": "122629",
      "sourceShabadId": "11429",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਊਚ ਨੀਚ ਰਾਜਾ ਪ੍ਰਜਾ ਸੁਰ ਸੁਰਪਤਿ ਕੋਊ ਹੋਇ ॥੫॥",
      "transliteration": "uooch neech raajaa prajaa sur surapat kouoo hoi ||5||",
      "translation": "",
      "punjabiViakhya": "(ਭਾਵੇਾਂ) ਉੱਚਾ-ਨੀਵਾ, ਰਾਜਾ-ਪ੍ਰਜਾ, ਦੇਵਤੇ ਜਾ ਇੰਦਰ, ਕੋਈ ਵੀ (ਕਿਉਾਂ ਨ) ਹੋਵੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "ऊच नीच राजा प्रजा सुर सुरपति कोऊ होइ ॥५॥",
      "sourceLineId": "122630",
      "sourceShabadId": "11429",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122631",
      "sourceShabadId": "11430",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤੁਮ ਸੁੰਦਰਿ ਸਭ ਸੋਕ ਨਿਵਾਰਹੁ ॥",
      "transliteration": "tum su(n)dhar sabh sok nivaarahu ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ ਰਾਜੇ ਨੇ ਕਿਹਾ) ਹੇ ਸੁੰਦਰੀ! ਤੂੰ ਸਾਰੇ ਦੁਖ ਨੂੰ ਦੂਰ ਕਰ",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "तुम सुँदरि सभ सोक निवारहु ॥",
      "sourceLineId": "122632",
      "sourceShabadId": "11430",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸ੍ਰੀ ਜਦੁਪਤਿ ਕਹ ਹਿਯੈ ਸੰਭਾਰਹੁ ॥",
      "transliteration": "sree jadhupat keh hiyai sa(n)bhaarahu ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ੍ਰੀ ਕ੍ਰਿਸ਼ਨ ਦਾ ਮਨ ਵਿਚ ਸਿਮਰਨ ਕਰ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "स्री जदुपति कह हियै संभारहु ॥",
      "sourceLineId": "122633",
      "sourceShabadId": "11430",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਵਾ ਸੁਤ ਕੋ ਕਛੁ ਸੋਕ ਨ ਕੀਜੈ ॥",
      "transliteration": "vaa sut ko kachh sok na keejai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪੁੱਤਰ ਦਾ ਕੋਈ ਦੁਖ ਨਾ ਮਨਾ",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "वा सुत को कछु सोक न कीजै ॥",
      "sourceLineId": "122634",
      "sourceShabadId": "11430",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਔਰ ਮਾਗਿ ਪ੍ਰਭੁ ਤੇ ਸੁਤ ਲੀਜੈ ॥੬॥",
      "transliteration": "aauar maag prabh te sut leejai ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਰਮਾਤਮਾ ਕੋਲੋਂ ਹੋਰ ਪੁੱਤਰ ਮੰਗ ਲੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "और मागि प्रभु ते सुत लीजै ॥६॥",
      "sourceLineId": "122635",
      "sourceShabadId": "11430",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122636",
      "sourceShabadId": "11431",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਵਰ ਤੁਮਾਰੇ ਧਾਮ ਮੈ ਹ੍ਵੈ ਹੈ ਪੂਤ ਅਪਾਰ ॥",
      "transliteration": "avar tumaare dhaam mai havai hai poot apaar ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਕੋਮਲ ਸੁੰਦਰੀ! ਸੁਣ, ਤੇਰੇ ਘਰ ਹੋਰ ਕਈ ਪੁੱਤਰ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "अवर तुमारे धाम मै ह्वै है पूत अपार ॥",
      "sourceLineId": "122637",
      "sourceShabadId": "11431",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਵਾ ਕੋ ਸੋਕ ਨ ਕੀਜਿਯੈ ਸੁਨ ਸੁੰਦਰਿ ਸੁਕੁਮਾਰਿ ॥੭॥",
      "transliteration": "vaa ko sok na keejiyai sun su(n)dhar sukumaar ||7||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਉਸ ਦਾ ਬਹੁਤ ਦੁਖ ਨਾ ਮਨਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "वा को सोक न कीजियै सुन सुँदरि सुकुमारि ॥७॥",
      "sourceLineId": "122638",
      "sourceShabadId": "11431",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122639",
      "sourceShabadId": "11432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਬ ਰਾਜੈ ਯੌ ਤਿਹ ਸਮਝਾਯੋ ॥",
      "transliteration": "jab raajai yau teh samajhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਉਸ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਸਮਝਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "जब राजै यौ तिह समझायो ॥",
      "sourceLineId": "122640",
      "sourceShabadId": "11432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਸੁਤ ਸੋਕ ਮਿਟਾਯੋ ॥",
      "transliteration": "tab raanee sut sok miTaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਨੇ ਪੁੱਤਰ ਦਾ ਦੁਖ ਭੁਲਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "तब रानी सुत सोक मिटायो ॥",
      "sourceLineId": "122641",
      "sourceShabadId": "11432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਵਰ ਪੂਤ ਕੀ ਆਸਾ ਭਏ ॥",
      "transliteration": "avar poot kee aasaa bhe ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ ਪੁੱਤਰ ਦੀ ਆਸ ਕਰਨ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "अवर पूत की आसा भए ॥",
      "sourceLineId": "122642",
      "sourceShabadId": "11432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚੌਬਿਸ ਬਰਿਸ ਬੀਤਿ ਕਰਿ ਗਏ ॥੮॥",
      "transliteration": "chauabis baris beet kar ge ||8||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਆਸ ਵਿਚ ਹੀ) ਚੌਵੀ ਵਰ੍ਰਹੇ ਬੀਤ ਗਏ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "चौबिस बरिस बीति करि गए ॥८॥",
      "sourceLineId": "122643",
      "sourceShabadId": "11432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "122644",
      "sourceShabadId": "11433",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੁੰਦਰ ਨਰ ਇਕ ਪੇਖਤ ਤਬ ਅਬਲਾ ਭਈ ॥",
      "transliteration": "su(n)dhar nar ik pekhat tab abalaa bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਇਸਤਰੀ ਨੇ ਇਕ ਸੁੰਦਰ ਪੁਰਸ਼ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "सुँदर नर इक पेखत तब अबला भई ॥",
      "sourceLineId": "122645",
      "sourceShabadId": "11433",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗ੍ਰਿਹ ਕੀ ਸਭ ਸੁਧਿ ਬਿਸਰਿ ਤਾਹਿ ਤਬ ਹੀ ਗਈ ॥",
      "transliteration": "gireh kee sabh sudh bisar taeh tab hee giee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਵੇਲੇ ਉਸ ਨੂੰ ਘਰ ਦੀ ਸਾਰੀ ਸੁੱਧ ਬੁੱਧ ਵਿਸਰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "गृह की सभ सुधि बिसरि ताहि तब ही गई ॥",
      "sourceLineId": "122646",
      "sourceShabadId": "11433",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪਠੈ ਸਹਚਰੀ ਤਾ ਕੌ ਲਿਯੋ ਮੰਗਾਇ ਕੈ ॥",
      "transliteration": "paThai sahacharee taa kau liyo ma(n)gai kai ||",
      "translation": "",
      "punjabiViakhya": "ਦਾਸੀ ਨੂੰ ਭੇਜ ਕੇ ਉਸ ਨੂੰ ਬੁਲਵਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "पठै सहचरी ता कौ लियो मंगाइ कै ॥",
      "sourceLineId": "122647",
      "sourceShabadId": "11433",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਹੋ ਕਾਮ ਕੇਲ ਤਿਹ ਸੰਗ ਕਰਿਯੋ ਸੁਖ ਪਾਇ ਕੈ ॥੯॥",
      "transliteration": "ho kaam kel teh sa(n)g kariyo sukh pai kai ||9||",
      "translation": "",
      "punjabiViakhya": "ਸੁਖ ਸਹਿਤ ਉਸ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "हो काम केल तिह संग करियो सुख पाइ कै ॥९॥",
      "sourceLineId": "122648",
      "sourceShabadId": "11433",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122649",
      "sourceShabadId": "11434",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਯੌ ਹ੍ਰਿਦੈ ਬਿਚਾਰੀ ॥",
      "transliteration": "tab raanee yau hiradhai bichaaree ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਨੀ ਨੇ ਹਿਰਦੇ ਵਿਚ ਇਹ ਗੱਲ ਸੋਚੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "तब रानी यौ हृदै बिचारी ॥",
      "sourceLineId": "122650",
      "sourceShabadId": "11434",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬੋਲਿ ਜਾਰ ਪ੍ਰਤਿ ਸਕਲ ਸਿਖਾਰੀ ॥",
      "transliteration": "bol jaar prat sakal sikhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਯਾਰ ਨੂੰ ਸਾਰੀ ਗੱਲ ਬੋਲ ਕੇ ਸਿਖਾ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "बोलि जार प्रति सकल सिखारी ॥",
      "sourceLineId": "122651",
      "sourceShabadId": "11434",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਲਰਿਕਾ ਹੁਤੋ ਜੋਗ੍ਰਯਹ ਹਰਿਯੋ ॥",
      "transliteration": "larikaa huto jograyeh hariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿ ਜਦੋਂ ਮੈਂ) ਬਾਲਕ ਸਾ ਤਾ (ਇਕ) ਜੋਗੀ ਨੇ ਚੁਰਾ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "लरिका हुतो जोग्रयह हरियो ॥",
      "sourceLineId": "122652",
      "sourceShabadId": "11434",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੁੰਦਰ ਜਾਨਿ ਨ ਮੋ ਬਧਿ ਕਰਿਯੋ ॥੧੦॥",
      "transliteration": "su(n)dhar jaan na mo badh kariyo ||10||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਸੁੰਦਰ ਸਮਝ ਕੇ ਮੈਨੂੰ ਨਾ ਮਾਰਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "सुँदर जानि न मो बधि करियो ॥१०॥",
      "sourceLineId": "122653",
      "sourceShabadId": "11434",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122654",
      "sourceShabadId": "11435",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਥੋ ਬਾਲਕ ਜੋਗੀ ਹਰਿਯੋ ਹ੍ਵੈ ਭਿਰਟੀ ਕੇ ਭੇਸ ॥",
      "transliteration": "tho baalak jogee hariyo havai bhiraTee ke bhes ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਬਾਲਕ ਸਾ ਅਤੇ ਜੋਗੀ ਨੇ ਬਘਿਆੜੀ ਦਾ ਰੂਪ ਧਾਰ ਕੇ ਹਰ ਲਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "थो बालक जोगी हरियो ह्वै भिरटी के भेस ॥",
      "sourceLineId": "122655",
      "sourceShabadId": "11435",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮੈ ਜਾਨਤ ਨਹਿ ਕਵਨ ਸੁਤ ਬਸਤ ਕਵਨ ਸੇ ਦੇਸ ॥੧੧॥",
      "transliteration": "mai jaanat neh kavan sut basat kavan se dhes ||11||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਨਹੀਂ ਜਾਣਦਾ ਕਿ ਕਿਸ ਦਾ ਪੁੱਤਰ ਹਾ ਅਤੇ ਕਿਸ ਦੇਸ ਦੇ ਰਹਿਣ ਵਾਲਾ ਹਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "मै जानत नहि कवन सुत बसत कवन से देस ॥११॥",
      "sourceLineId": "122656",
      "sourceShabadId": "11435",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122657",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਾਰ ਸੰਗ ਇਹ ਭਾਤਿ ਸਿਖਾਈ ॥",
      "transliteration": "jaar sa(n)g ieh bhaat sikhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਯਾਰ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਸਿਖਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "जार संग इह भाति सिखाई ॥",
      "sourceLineId": "122658",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਆਪ ਰਾਵ ਸੋ ਜਾਇ ਜਤਾਈ ॥",
      "transliteration": "aap raav so jai jataiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪ ਜਾ ਕੇ ਰਾਜੇ ਨੂੰ ਦਸਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "आप राव सो जाइ जताई ॥",
      "sourceLineId": "122659",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜੋ ਬਾਲਕ ਮੈ ਪੂਤ ਗਵਾਯੋ ॥",
      "transliteration": "jo baalak mai poot gavaayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜਿਸ ਬਾਲਕ ਪੁੱਤਰ ਨੂੰ ਮੈਂ ਗੰਵਾ ਦਿੱਤਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "जो बालक मै पूत गवायो ॥",
      "sourceLineId": "122660",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੋ ਮੈ ਆਜੁ ਖੋਜ ਤੇ ਪਾਯੋ ॥੧੨॥",
      "transliteration": "so mai aaj khoj te paayo ||12||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮੈਂ ਅਜ ਖੋਜ ਕੇ ਪ੍ਰਾਪਤ ਕਰ ਲਿਆ ਹੈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "सो मै आजु खोज ते पायो ॥१२॥",
      "sourceLineId": "122661",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੁਨਿ ਨ੍ਰਿਪ ਬਚਨ ਅਨੰਦਿਤ ਭਯੋ ॥",
      "transliteration": "sun nirap bachan ana(n)dhit bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਇਹ ਬਚਨ ਸੁਣ ਕੇ ਆਨੰਦਿਤ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "सुनि नृप बचन अनंदित भयो ॥",
      "sourceLineId": "122662",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਾ ਕੋ ਬੋਲਿ ਨਿਕਟਿ ਤਬ ਲਯੋ ॥",
      "transliteration": "taa ko bol nikaT tab layo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਆਪਣੇ ਕੋਲ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "ता को बोलि निकटि तब लयो ॥",
      "sourceLineId": "122663",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਇਹ ਭਾਤਿ ਉਚਾਰੋ ॥",
      "transliteration": "tab raanee ieh bhaat uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "तब रानी इह भाति उचारो ॥",
      "sourceLineId": "122664",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੁਨੋ ਪੂਤ ਤੁਮ ਬਚਨ ਹਮਾਰੋ ॥੧੩॥",
      "transliteration": "suno poot tum bachan hamaaro ||13||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪੁੱਤਰ! ਤੂੰ ਸਾਡੀ ਗੱਲ ਸੁਣ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "सुनो पूत तुम बचन हमारो ॥१३॥",
      "sourceLineId": "122665",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਕਲ ਬ੍ਰਿਥਾ ਅਪਨੀ ਤੁਮ ਕਹੋ ॥",
      "transliteration": "sakal birathaa apanee tum kaho ||",
      "translation": "",
      "punjabiViakhya": "ਤੂੰ ਆਪਣੀ ਸਾਰੀ ਬੀਤੀ (ਸਾਨੂੰ) ਸੁਣਾ",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "सकल बृथा अपनी तुम कहो ॥",
      "sourceLineId": "122666",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਮਰੇ ਸਭ ਸੋਕਨ ਕਹ ਦਹੋ ॥",
      "transliteration": "hamare sabh sokan keh dhaho ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਡੇ ਸਾਰੇ ਦੁਖਾ ਨੂੰ ਸਾੜ ਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "हमरे सभ सोकन कह दहो ॥",
      "sourceLineId": "122667",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰਾਜਾ ਸੋਂ ਕਹਿ ਪ੍ਰਗਟ ਸੁਨਾਯੋ ॥",
      "transliteration": "raajaa so(n) keh pragaT sunaayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਸਾਫ਼ ਸਾਫ਼ ਦਸ",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "राजा सों कहि प्रगट सुनायो ॥",
      "sourceLineId": "122668",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਰਾਜਪੂਤ ਹ੍ਵੈ ਰਾਜ ਕਮਾਯੋ ॥੧੪॥",
      "transliteration": "raajapoot havai raaj kamaayo ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ ਪੁੱਤਰ ਹੋ ਕੇ ਰਾਜ ਕਰ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "राजपूत ह्वै राज कमायो ॥१४॥",
      "sourceLineId": "122669",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੁਨੁ ਰਾਨੀ ਮੈ ਕਹਾ ਬਖਾਨੋ ॥",
      "transliteration": "sun raanee mai kahaa bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਣੀ! ਸੁਣੋ, ਮੈਂ ਕੀ ਦਸਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "सुनु रानी मै कहा बखानो ॥",
      "sourceLineId": "122670",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਾਲਕ ਹੁਤੋ ਕਛੂ ਨਹਿ ਜਾਨੋ ॥",
      "transliteration": "baalak huto kachhoo neh jaano ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਬਾਲਕ ਸਾ ਅਤੇ ਕੁਝ ਨਹੀਂ ਜਾਣਦਾ ਸਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "बालक हुतो कछू नहि जानो ॥",
      "sourceLineId": "122671",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜੋਗੀ ਕਹਿਯੋ ਸੁ ਤੁਮ ਤਨ ਕਹਿਹੌ ॥",
      "transliteration": "jogee kahiyo su tum tan kahihau ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਜੋਗੀ ਨੇ ਕਿਹਾ ਸੀ, ਉਹੀ ਤੁਹਾਨੂੰ ਦਸਦਾ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "जोगी कहियो सु तुम तन कहिहौ ॥",
      "sourceLineId": "122672",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੋਕ ਸੰਤਾਪ ਤਿਹਾਰੋ ਦਹਿਹੌ ॥੧੫॥",
      "transliteration": "sok sa(n)taap tihaaro dhahihau ||15||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੁਹਾਡੇ ਦੁਖ ਅਤੇ ਸੰਤਾਪ ਨੂੰ ਦੂਰ ਕਰਦਾ ਹਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "सोक संताप तिहारो दहिहौ ॥१५॥",
      "sourceLineId": "122673",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਇਕ ਦਿਨ ਯੌ ਜੌਗੀਸ ਉਚਾਰਿਯੋ ॥",
      "transliteration": "eik dhin yau jauagees uchaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ (ਉਸ) ਜੋਗੀ ਨੇ (ਮੈਨੂੰ) ਇਸ ਤਰ੍ਰਹਾ ਦਸਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "इक दिन यौ जौगीस उचारियो ॥",
      "sourceLineId": "122674",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸੂਰਤਿ ਸਹਿਰ ਬਡੋ ਉਜਿਯਾਰਿਯੋ ॥",
      "transliteration": "soorat sahir baddo ujiyaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਕ ਵੱਡਾ ਸੁੰਦਰ 'ਸੂਰਤ' ਨਗਰ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "सूरति सहिर बडो उजियारियो ॥",
      "sourceLineId": "122675",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਹ੍ਵੈ ਭਿਰਟੀ ਮੈ ਤਹਾ ਸਿਧਾਯੋ ॥",
      "transliteration": "havai bhiraTee mai tahaa sidhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਬਘਿਆੜੀ ਬਣ ਕੇ ਉਥੇ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "ह्वै भिरटी मै तहा सिधायो ॥",
      "sourceLineId": "122676",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬਾਲਕ ਸੁਤ ਰਾਜਾ ਕੋ ਪਾਯੋ ॥੧੬॥",
      "transliteration": "baalak sut raajaa ko paayo ||16||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਦੇ ਬਾਲਕ ਪੁੱਤਰ ਨੂੰ ਪ੍ਰਾਪਤ ਕੀਤਾ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "बालक सुत राजा को पायो ॥१६॥",
      "sourceLineId": "122677",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਹ੍ਵੈ ਭਿਰਟੀ ਜਬ ਹੀ ਮੈ ਧਯੋ ॥",
      "transliteration": "havai bhiraTee jab hee mai dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਬਘਿਆੜੀ ਬਣ ਕੇ ਮੈਂ ਭਜਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "ह्वै भिरटी जब ही मै धयो ॥",
      "sourceLineId": "122678",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਭਾਜਿ ਲੋਗ ਆਗੇ ਤੇ ਗਯੋ ॥",
      "transliteration": "bhaaj log aage te gayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਲੋਕੀਂ ਅਗੋਂ ਦੌੜ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "भाजि लोग आगे ते गयो ॥",
      "sourceLineId": "122679",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤੋਹਿ ਡਾਰਿ ਬਗਲੀ ਮਹਿ ਲੀਨੋ ॥",
      "transliteration": "toh ddaar bagalee meh leeno ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਤੈਨੂੰ ਬਗਲੀ ਵਿਚ ਪਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "तोहि डारि बगली महि लीनो ॥",
      "sourceLineId": "122680",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਔਰੈ ਦੇਸ ਪਯਾਨੋ ਕੀਨੋ ॥੧੭॥",
      "transliteration": "aauarai dhes payaano keeno ||17||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੋਰ ਦੇਸ਼ ਵਲ ਚਲਾ ਗਿਆ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "औरै देस पयानो कीनो ॥१७॥",
      "sourceLineId": "122681",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਚੇਲਾ ਅਵਰ ਭਛ ਤਬ ਲ੍ਯਾਏ ॥",
      "transliteration": "chelaa avar bhachh tab layaae ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੋਰ ਚੇਲੇ ਖਾਣ ਲਈ (ਪਦਾਰਥ) ਲੈ ਆਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "चेला अवर भछ तब ल्याए ॥",
      "sourceLineId": "122682",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਤਾਹਿ ਖ੍ਵਾਇ ਕਰਿ ਨਾਥ ਰਿਝਾਏ ॥",
      "transliteration": "taeh khavaiai kar naath rijhaae ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਸੁਆਮੀ ਨੂੰ ਖਵਾ ਕੇ ਪ੍ਰਸੰਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "ताहि ख्वाइ करि नाथ रिझाए ॥",
      "sourceLineId": "122683",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਭਛਨ ਕਾਜਿ ਔਰ ਕੋਊ ਧਰਿਯੋ ॥",
      "transliteration": "bhachhan kaaj aauar kouoo dhariyo ||",
      "translation": "",
      "punjabiViakhya": "ਖਾਣ ਲਈ (ਉਨ੍ਰਹਾ ਨੇ) ਹੋਰ ਕੁਝ ਅਗੇ ਰਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "भछन काजि और कोऊ धरियो ॥",
      "sourceLineId": "122684",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਰਾਵ ਪੂਤ ਲਖਿ ਮੋਹਿ ਉਬਰਿਯੋ ॥੧੮॥",
      "transliteration": "raav poot lakh moh ubariyo ||18||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਦਾ ਪੁੱਤਰ ਸਮਝ ਕੇ ਮੈਨੂੰ ਛਡ ਦਿੱਤਾ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "राव पूत लखि मोहि उबरियो ॥१८॥",
      "sourceLineId": "122685",
      "sourceShabadId": "11436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122686",
      "sourceShabadId": "11437",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਸੁਨੁ ਰਾਨੀ ਐਸੇ ਬਚਨ ਨੈਨਨ ਨੀਰੁ ਬਹਾਇ ॥",
      "transliteration": "sun raanee aaise bachan nainan neer bahai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਇਹ ਗੱਲ ਸੁਣ ਕੇ ਅੱਖਾ ਵਿਚੋਂ ਹੰਝੂ ਵਗਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "सुनु रानी ऐसे बचन नैनन नीरु बहाइ ॥",
      "sourceLineId": "122687",
      "sourceShabadId": "11437",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਨ੍ਰਿਪ ਦੇਖਤ ਸੁਤ ਜਾਰ ਕਹਿ ਲਯੋ ਗਰੇ ਸੋ ਲਾਇ ॥੧੯॥",
      "transliteration": "nirap dhekhat sut jaar keh layo gare so lai ||19||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਦੇ ਵੇਖਦਿਆਂ ਯਾਰ ਨੂੰ ਪੁੱਤਰ ਕਹਿ ਕੇ ਗਲੇ ਨਾਲ ਲਗਾ ਲਿਆ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "नृप देखत सुत जार कहि लयो गरे सो लाइ ॥१९॥",
      "sourceLineId": "122688",
      "sourceShabadId": "11437",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122689",
      "sourceShabadId": "11438",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਬਾਲਕ ਹੁਤੋ ਪੂਤ ਤਬ ਹਰਿਯੋ ॥",
      "transliteration": "baalak huto poot tab hariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਪੁੱਤਰ ਬਾਲਕ ਹੁੰਦਾ ਸੀ, ਤਦ ਚੁਰਾ ਲਿਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "बालक हुतो पूत तब हरियो ॥",
      "sourceLineId": "122690",
      "sourceShabadId": "11438",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਮੋਰੇ ਭਾਗ ਸੁ ਜਿਯਤ ਉਬਰਿਯੋ ॥",
      "transliteration": "more bhaag su jiyat ubariyo ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਮੇਰੇ ਚੰਗੇ ਭਾਗਾ ਕਰ ਕੇ ਹੀ ਜੀਵਿਤ ਬਚਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "मोरे भाग सु जियत उबरियो ॥",
      "sourceLineId": "122691",
      "sourceShabadId": "11438",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਕੌਨਹੂੰ ਕਾਜ ਦੇਸ ਇਹ ਆਯੋ ॥",
      "transliteration": "kauanahoo(n) kaaj dhes ieh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਕਿਸੇ ਕੰਮ ਲਈ ਹੀ (ਇਸ) ਦੇਸ ਵਲ ਆਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "कौनहूँ काज देस इह आयो ॥",
      "sourceLineId": "122692",
      "sourceShabadId": "11438",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਸੋ ਹਮ ਆਜੁ ਖੋਜ ਤੇ ਪਾਯੋ ॥੨੦॥",
      "transliteration": "so ham aaj khoj te paayo ||20||",
      "translation": "",
      "punjabiViakhya": "ਸੋ ਅਜ ਮੈਂ ਖੋਜ ਕੇ ਪ੍ਰਾਪਤ ਕਰ ਲਿਆ ਹੈ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "सो हम आजु खोज ते पायो ॥२०॥",
      "sourceLineId": "122693",
      "sourceShabadId": "11438",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਗਹਿ ਗਹਿ ਤਾ ਕੋ ਗਰੇ ਲਗਾਵੈ ॥",
      "transliteration": "geh geh taa ko gare lagaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਫੜ ਫੜ ਕੇ ਗਲੇ ਲਗਾਉਾਂਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "गहि गहि ता को गरे लगावै ॥",
      "sourceLineId": "122694",
      "sourceShabadId": "11438",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਦੇਖਤ ਰਾਵ ਚੂੰਬਿ ਮੁਖ ਜਾਵੈ ॥",
      "transliteration": "dhekhat raav choo(n)b mukh jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਦੇ ਵੇਖਦਿਆਂ (ਉਸ ਦਾ) ਮੂੰਹ ਚੁੰਮ ਲੈਂਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "देखत राव चूँबि मुख जावै ॥",
      "sourceLineId": "122695",
      "sourceShabadId": "11438",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਅਪਨੇ ਧਾਮ ਸੇਜ ਡਸਵਾਈ ॥",
      "transliteration": "apane dhaam sej ddasavaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਆਪਣੇ ਘਰ ਵਿਚ ਸੇਜ ਵਿਛਵਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "अपने धाम सेज डसवाई ॥",
      "sourceLineId": "122696",
      "sourceShabadId": "11438",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਤਾ ਸੌ ਰੈਨਿ ਬਿਰਾਜਤ ਜਾਈ ॥੨੧॥",
      "transliteration": "taa sau rain biraajat jaiee ||21||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਤ ਨੂੰ ਉਸ ਨਾਲ ਬਿਰਾਜਣ ਲਗੀ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "ता सौ रैनि बिराजत जाई ॥२१॥",
      "sourceLineId": "122697",
      "sourceShabadId": "11438",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਆਠੋ ਜਾਮ ਧਾਮ ਤਿਹ ਰਾਖੈ ॥",
      "transliteration": "aaTho jaam dhaam teh raakhai ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਠੇ ਪਹਿਰ ਉਸ ਨੂੰ ਘਰ ਵਿਚ ਰਖਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "आठो जाम धाम तिह राखै ॥",
      "sourceLineId": "122698",
      "sourceShabadId": "11438",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0073",
      "lineIndex": 73,
      "gurmukhi": "ਪੂਤ ਪੂਤ ਮੁਖ ਤੇ ਤਿਹ ਭਾਖੈ ॥",
      "transliteration": "poot poot mukh te teh bhaakhai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਮੂੰਹੋਂ ਪੁੱਤਰ ਪੁੱਤਰ ਕਹਿੰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "पूत पूत मुख ते तिह भाखै ॥",
      "sourceLineId": "122699",
      "sourceShabadId": "11438",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1051_line_0074",
      "lineIndex": 74,
      "gurmukhi": "ਕਾਮ ਕੇਲ ਨਿਸਿ ਭਈ ਕਮਾਵੈ ॥",
      "transliteration": "kaam kel nis bhiee kamaavai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਦਿਨ ਉਸ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1051,
      "hindi": "",
      "hindiTransliteration": "काम केल निसि भई कमावै ॥",
      "sourceLineId": "122700",
      "sourceShabadId": "11438",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
