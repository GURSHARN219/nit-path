{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1052,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1052_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮੂਰਖ ਰਾਵ ਭੇਦ ਨਹਿ ਪਾਵੈ ॥੨੨॥",
      "transliteration": "moorakh raav bhedh neh paavai ||22||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਮੂਰਖ ਰਾਜਾ ਕੋਈ ਭੇਦ ਸਮਝ ਨਾ ਸਕਦਾ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "मूरख राव भेद नहि पावै ॥२२॥",
      "sourceLineId": "122701",
      "sourceShabadId": "11438",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਛਿਆਸਠਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੬੬॥੩੨੯੬॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau chhiaasaThavo charitr samaapatam sat subham sat ||166||3296||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੬੬ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੬੬॥੩੨੯੬॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ छिआसठवो चरित्र समापतम सतु सुभम सतु ॥१६६॥३२९६॥अफजूँ॥",
      "sourceLineId": "122702",
      "sourceShabadId": "11438",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122703",
      "sourceShabadId": "11439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਾਸ ਬਰੇਲੀ ਕੇ ਬਿਖੈ ਬੀਰ ਬਡੋ ਧਨ ਰਾਵ ॥",
      "transliteration": "baas barelee ke bikhai beer baddo dhan raav ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਸ ਬਰੇਲੀ ਵਿਚ ਧਨ ਰਾਵ ਨਾ ਦਾ ਬਹੁਤ ਵੱਡਾ ਸੂਰਮਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "बास बरेली के बिखै बीर बडो धन राव ॥",
      "sourceLineId": "122704",
      "sourceShabadId": "11439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਾਹ ਪਰੀ ਤਾ ਕੀ ਤ੍ਰਿਯਾ ਰਾਖਤ ਸਭ ਕੋ ਭਾਵ ॥੧॥",
      "transliteration": "saeh paree taa kee tirayaa raakhat sabh ko bhaav ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸ਼ਾਹ ਪਰੀ ਨਾ ਦੀ ਇਸਤਰੀ ਸਭ ਦਾ ਆਦਰ ਭਾਵ ਕਰਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "साह परी ता की तृया राखत सभ को भाव ॥१॥",
      "sourceLineId": "122705",
      "sourceShabadId": "11439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122706",
      "sourceShabadId": "11440",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਏਕ ਪਾਤ੍ਰ ਰਾਜਾ ਕੇ ਆਈ ॥",
      "transliteration": "ek paatr raajaa ke aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਵੇਸਵਾ ('ਪਾਤ੍ਰ') ਰਾਜੇ ਪਾਸ ਆਈ",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "एक पात्र राजा के आई ॥",
      "sourceLineId": "122707",
      "sourceShabadId": "11440",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭੂਖਨ ਬਸਤ੍ਰ ਅਨੂਪ ਸੁਹਾਈ ॥",
      "transliteration": "bhookhan basatr anoop suhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸੁੰਦਰ ਬਸਤ੍ਰਾ ਅਤੇ ਗਹਿਣਿਆਂ ਨਾਲ ਖ਼ੂਬ ਸਜੀ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "भूखन बसत्र अनूप सुहाई ॥",
      "sourceLineId": "122708",
      "sourceShabadId": "11440",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨ੍ਰਿਪ ਬਰ ਅਟਿਕ ਤਵਨ ਪਰ ਗਯੋ ॥",
      "transliteration": "nirap bar aTik tavan par gayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਉਸ ਉਤੇ ਮੋਹਿਤ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "नृप बर अटिक तवन पर गयो ॥",
      "sourceLineId": "122709",
      "sourceShabadId": "11440",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰਾਨਿਨ ਡਾਰਿ ਹ੍ਰਿਦੈ ਤੇ ਦਯੋ ॥੨॥",
      "transliteration": "raanin ddaar hiradhai te dhayo ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਨੂੰ ਮਨ ਤੋਂ ਵਿਸਾਰ ਦਿੱਤਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "रानिन डारि हृदै ते दयो ॥२॥",
      "sourceLineId": "122710",
      "sourceShabadId": "11440",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122711",
      "sourceShabadId": "11441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਏਕ ਭ੍ਰਾਤ ਨ੍ਰਿਪ ਕੋ ਹੁਤੋ ਜਾ ਕੋ ਰੂਪ ਅਪਾਰ ॥",
      "transliteration": "ek bhraat nirap ko huto jaa ko roop apaar ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦਾ ਇਕ ਭਰਾ ਹੁੰਦਾ ਸੀ ਜਿਸ ਦਾ ਰੂਪ ਅਪਾਰ ਸੁੰਦਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "एक भ्रात नृप को हुतो जा को रूप अपार ॥",
      "sourceLineId": "122712",
      "sourceShabadId": "11441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਾਹ ਪਰੀ ਤਾ ਸੌ ਬਿਧੀ ਰਾਜਾ ਕੋ ਡਰ ਡਾਰਿ ॥੩॥",
      "transliteration": "saeh paree taa sau bidhee raajaa ko ddar ddaar ||3||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਾਹ ਪਰੀ ਰਾਜੇ ਦਾ ਡਰ ਛਡ ਕੇ ਉਸ ਨਾਲ ਫਸ ਗਈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "साह परी ता सौ बिधी राजा को डर डारि ॥३॥",
      "sourceLineId": "122713",
      "sourceShabadId": "11441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122714",
      "sourceShabadId": "11442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਿਤਪ੍ਰਤਿ ਰਾਨੀ ਤਾਹਿ ਬੁਲਾਵੈ ॥",
      "transliteration": "nitaprat raanee taeh bulaavai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਉਸ ਨੂੰ ਰੋਜ ਬੁਲਾਉਣ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "नितप्रति रानी ताहि बुलावै ॥",
      "sourceLineId": "122715",
      "sourceShabadId": "11442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਿਹ ਸੰਗ ਕਮਾਵੈ ॥",
      "transliteration": "kaam bhog teh sa(n)g kamaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਨ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "काम भोग तिह संग कमावै ॥",
      "sourceLineId": "122716",
      "sourceShabadId": "11442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਾਜਾ ਕੌ ਹਿਯ ਤੇ ਬਿਸਰਾਯੋ ॥",
      "transliteration": "raajaa kau hiy te bisaraayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਰਾਜੇ ਨੂੰ ਹਿਰਦੇ ਤੋਂ ਭੁਲਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "राजा कौ हिय ते बिसरायो ॥",
      "sourceLineId": "122717",
      "sourceShabadId": "11442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾ ਕੌ ਰਾਜ ਦੇਉ ਠਹਰਾਯੋ ॥੪॥",
      "transliteration": "taa kau raaj dheau Thaharaayo ||4||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਮਨ ਵਿਚ) ਫੈਸਲਾ ਕਰ ਲਿਆ ਕਿ ਉਸ ਨੂੰ ਰਾਜ ਦਿਵਾਵਾਗੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "ता कौ राज देउ ठहरायो ॥४॥",
      "sourceLineId": "122718",
      "sourceShabadId": "11442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਬ ਮੈ ਰਾਜ ਦੇਤ ਹੌ ਤੋ ਕੌ ॥",
      "transliteration": "ab mai raaj dhet hau to kau ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੈਂ ਤੈਨੂੰ ਰਾਜ ਦਿਆਂਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "अब मै राज देत हौ तो कौ ॥",
      "sourceLineId": "122719",
      "sourceShabadId": "11442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਿਜੁ ਨਾਰੀ ਕਰਿਯਹੁ ਤੁਮ ਮੋ ਕੌ ॥",
      "transliteration": "nij naaree kariyahu tum mo kau ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੂੰ ਮੈਨੂੰ ਆਪਣੀ ਪਤਨੀ ਬਣਾ ਲਈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "निजु नारी करियहु तुम मो कौ ॥",
      "sourceLineId": "122720",
      "sourceShabadId": "11442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜੋ ਮੈ ਤੁਮੈ ਕਹੌਂ ਸੋ ਕਰਿਯਹੁ ॥",
      "transliteration": "jo mai tumai kahaua(n) so kariyahu ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਮੈਂ ਤੈਨੂੰ ਕਹਾਗੀ, ਉਹੀ ਕਰੀਂ",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "जो मै तुमै कहौं सो करियहु ॥",
      "sourceLineId": "122721",
      "sourceShabadId": "11442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਯਾ ਰਾਜਾ ਤੇ ਨੈਕ ਨ ਡਰਿਯਹੁ ॥੫॥",
      "transliteration": "yaa raajaa te naik na ddariyahu ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਰਾਜੇ ਤੋਂ ਜ਼ਰਾ ਜਿੰਨਾ ਵੀ ਨਾ ਡਰੀਂ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "या राजा ते नैक न डरियहु ॥५॥",
      "sourceLineId": "122722",
      "sourceShabadId": "11442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਨ ਬੀਸਕ ਇਕ ਬਿਸਹਿ ਮੰਗੈਯੈ ॥",
      "transliteration": "man beesak ik biseh ma(n)gaiyai ||",
      "translation": "",
      "punjabiViakhya": "ਵੀਹ ਕੁ ਮਣ ਇਕ ਜ਼ਹਿਰ ਮੰਗਵਾ",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "मन बीसक इक बिसहि मंगैयै ॥",
      "sourceLineId": "122723",
      "sourceShabadId": "11442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਭ ਭੋਜਨ ਕੇ ਬੀਚ ਡਰੈਯੈ ॥",
      "transliteration": "sabh bhojan ke beech ddaraiyai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਦੇ ਭੋਜਨ ਵਿਚ ਪਾ ਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "सभ भोजन के बीच डरैयै ॥",
      "sourceLineId": "122724",
      "sourceShabadId": "11442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਰਾਜਾ ਸਹਿਤ ਆਨ ਸਭ ਖੈ ਹੈ ॥",
      "transliteration": "raajaa sahit aan sabh khai hai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਸਮੇਤ ਸਾਰੇ ਆ ਕੇ ਖਾਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "राजा सहित आन सभ खै है ॥",
      "sourceLineId": "122725",
      "sourceShabadId": "11442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਛਿਨਕਿਕ ਬਿਖੈ ਮ੍ਰਿਤਕ ਹ੍ਵੈ ਜੈਹੈ ॥੬॥",
      "transliteration": "chhinakik bikhai mritak havai jaihai ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਛਿਣ ਵਿਚ ਸਾਰੇ ਮਰ ਜਾਣਗੇ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "छिनकिक बिखै मृतक ह्वै जैहै ॥६॥",
      "sourceLineId": "122726",
      "sourceShabadId": "11442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122727",
      "sourceShabadId": "11443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਿਨ ਕੌ ਪ੍ਰਥਮ ਸੰਘਾਰਿ ਕੈ ਲੀਜੈ ਰਾਜੁ ਛਿਨਾਇ ॥",
      "transliteration": "tin kau pratham sa(n)ghaar kai leejai raaj chhinai ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਪਹਿਲਾ ਮਾਰ ਕੇ (ਫਿਰ) ਰਾਜ ਖੋਹ ਲੈ",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "तिन कौ प्रथम संघारि कै लीजै राजु छिनाइ ॥",
      "sourceLineId": "122728",
      "sourceShabadId": "11443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਆਪ ਦੇਸ ਪਤਿ ਹੂਜਿਯੈ ਮੋਹਿ ਸਹਿਤ ਸੁਖ ਪਾਇ ॥੭॥",
      "transliteration": "aap dhes pat hoojiyai moh sahit sukh pai ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪ ਦੇਸ ਦਾ ਸੁਆਮੀ ਬਣ ਕੇ ਮੇਰੇ ਸਹਿਤ ਸੁਖ ਪ੍ਰਾਪਤ ਕਰ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "आप देस पति हूजियै मोहि सहित सुख पाइ ॥७॥",
      "sourceLineId": "122729",
      "sourceShabadId": "11443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122730",
      "sourceShabadId": "11444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਬ ਤਿਨ ਜਾਰ ਕਾਜ ਸੋਊ ਕਿਯੋ ॥",
      "transliteration": "tab tin jaar kaaj souoo kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਦੇ ਯਾਰ ਨੇ ਉਹੀ ਕੰਮ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "तब तिन जार काज सोऊ कियो ॥",
      "sourceLineId": "122731",
      "sourceShabadId": "11444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੈਨ ਸਹਿਤ ਨਿਵਤੋ ਨ੍ਰਿਪ ਦਿਯੋ ॥",
      "transliteration": "sain sahit nivato nirap dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੂੰ ਸੈਨਾ ਸਹਿਤ ਨਿਉਤਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "सैन सहित निवतो नृप दियो ॥",
      "sourceLineId": "122732",
      "sourceShabadId": "11444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਭ ਭੋਜਨ ਭੀਤਰ ਬਿਸੁ ਡਾਰੀ ॥",
      "transliteration": "sabh bhojan bheetar bis ddaaree ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਦੇ ਭੋਜਨ ਵਿਚ ਜ਼ਹਿਰ ਪਾ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "सभ भोजन भीतर बिसु डारी ॥",
      "sourceLineId": "122733",
      "sourceShabadId": "11444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਭਹਿਨ ਬੇਸ੍ਵਾ ਸਹਿਤ ਖਵਾਰੀ ॥੮॥",
      "transliteration": "sabhahin besavaiaa sahit khavaaree ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵੇਸਵਾ ਸਮੇਤ ਸਭ ਨੂੰ ਖਵਾ ਦਿੱਤੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "सभहिन बेस्वा सहित खवारी ॥८॥",
      "sourceLineId": "122734",
      "sourceShabadId": "11444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੈਨ ਸਹਿਤ ਭਛਤ ਨ੍ਰਿਪ ਭਏ ॥",
      "transliteration": "sain sahit bhachhat nirap bhe ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਸੈਨਾ ਸਹਿਤ ਭੋਜਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "सैन सहित भछत नृप भए ॥",
      "sourceLineId": "122735",
      "sourceShabadId": "11444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਘਰਿਕਿਕ ਬਿਖੈ ਮੌਤ ਮਰਿ ਗਏ ॥",
      "transliteration": "gharikik bikhai mauat mar ge ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਘੜੀ ਵਿਚ ਮੌਤ (ਆਣ ਤੇ) ਮਰ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "घरिकिक बिखै मौत मरि गए ॥",
      "sourceLineId": "122736",
      "sourceShabadId": "11444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਯਤ ਬਚੇ ਤੋ ਤਿਨ ਗਹਿ ਘਾਏ ॥",
      "transliteration": "jiyat bache to tin geh ghaae ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਜੀਉਾਂਦੇ ਬਚੇ ਸਨ, ਉਨ੍ਰਹਾ ਨੂੰ ਪਕੜ ਕੇ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "जियत बचे तो तिन गहि घाए ॥",
      "sourceLineId": "122737",
      "sourceShabadId": "11444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਿਨ ਤੇ ਏਕ ਜਾਨ ਨਹਿ ਪਾਏ ॥੯॥",
      "transliteration": "tin te ek jaan neh paae ||9||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਵਿਚੋਂ ਇਕ ਵੀ ਜੀਉਾਂਦਾ ਨਹੀਂ ਜਾ ਸਕਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "तिन ते एक जान नहि पाए ॥९॥",
      "sourceLineId": "122738",
      "sourceShabadId": "11444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਿਨ ਕੌ ਮਾਰਿ ਰਾਜ ਤਿਨ ਲਿਯੋ ॥",
      "transliteration": "tin kau maar raaj tin liyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਮਾਰ ਕੇ ਉਸ ਨੇ ਰਾਜ ਸੰਭਾਲ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "तिन कौ मारि राज तिन लियो ॥",
      "sourceLineId": "122739",
      "sourceShabadId": "11444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਾ ਕੌ ਨਿਜੁ ਨਾਰੀ ਲੈ ਕਿਯੋ ॥",
      "transliteration": "taa kau nij naaree lai kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਆਪਣੀ ਰਾਣੀ ਬਣਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "ता कौ निजु नारी लै कियो ॥",
      "sourceLineId": "122740",
      "sourceShabadId": "11444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਾਥ ਠਾਢ ਕੀਨੋ ਤਿਹ ਘਾਯੋ ॥",
      "transliteration": "haath Thaadd keeno teh ghaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਵੀ ਹੱਥ ਖੜਾ ਕੀਤਾ (ਭਾਵ-ਹਥਿਆਰ ਚੁਕਿਆ) ਉਸ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "हाथ ठाढ कीनो तिह घायो ॥",
      "sourceLineId": "122741",
      "sourceShabadId": "11444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪਾਇ ਪਰਿਯੋ ਤਿਹ ਆਨਿ ਮਿਲਾਯੋ ॥੧੦॥",
      "transliteration": "pai pariyo teh aan milaayo ||10||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਪੈਰੀਂ ਪੈ ਗਿਆ, ਉਸ ਨੂੰ ਨਾਲ ਮਿਲਾ ਲਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "पाइ परियो तिह आनि मिलायो ॥१०॥",
      "sourceLineId": "122742",
      "sourceShabadId": "11444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਐਸੋ ਚਰਿਤ ਚੰਚਲਾ ਕੀਨੋ ॥",
      "transliteration": "aaiso charit cha(n)chalaa keeno ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਚਰਿਤ੍ਰ ਇਸਤਰੀ ਨੇ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "ऐसो चरित चंचला कीनो ॥",
      "sourceLineId": "122743",
      "sourceShabadId": "11444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਿਜੁ ਨਾਯਕ ਕੌ ਬਧ ਕਰਿ ਦੀਨੋ ॥",
      "transliteration": "nij naayak kau badh kar dheeno ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਪਤੀ ਦਾ ਬਧ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "निजु नायक कौ बध करि दीनो ॥",
      "sourceLineId": "122744",
      "sourceShabadId": "11444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਔਰ ਸੂਰਮਨ ਕੌ ਬਧ ਕਿਯੋ ॥",
      "transliteration": "aauar sooraman kau badh kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ ਸੂਰਮਿਆਂ ਦਾ ਵੀ ਸੰਘਾਰ ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "और सूरमन कौ बध कियो ॥",
      "sourceLineId": "122745",
      "sourceShabadId": "11444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਰਾਜ ਜਾਰ ਅਪਨੈ ਕੋ ਦਿਯੋ ॥੧੧॥",
      "transliteration": "raaj jaar apanai ko dhiyo ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ ਆਪਣੇ ਯਾਰ ਨੂੰ ਦੇ ਦਿੱਤਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "राज जार अपनै को दियो ॥११॥",
      "sourceLineId": "122746",
      "sourceShabadId": "11444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122747",
      "sourceShabadId": "11445",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1052_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਸੌ ਚੰਚਲਾ ਨਿਜੁ ਨਾਯਕ ਕੋ ਮਾਰਿ ॥",
      "transliteration": "eeh charitr sau cha(n)chalaa nij naayak ko maar ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਚਰਿਤ੍ਰ ਨਾਲ ਇਸਤਰੀ ਨੇ ਆਪਣੇ ਸੁਆਮੀ ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1052,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र सौ चंचला निजु नायक को मारि ॥",
      "sourceLineId": "122748",
      "sourceShabadId": "11445",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
