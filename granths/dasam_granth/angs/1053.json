{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1053,
  "lineCount": 46,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1053_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਜ ਜਾਰ ਕੌ ਲੈ ਦਿਯੋ ਐਸੇ ਖੇਲਿ ਖਿਲਾਰਿ ॥੧੨॥",
      "transliteration": "raaj jaar kau lai dhiyo aaise khel khilaar ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ ਆਪਣੇ ਪ੍ਰੇਮੀ ਨੂੰ ਲੈ ਦਿੱਤਾ। ਇਸ ਤਰ੍ਰਹਾ ਦੀ ਖੇਡ ਖੇਡੀ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "राज जार कौ लै दियो ऐसे खेलि खिलारि ॥१२॥",
      "sourceLineId": "122749",
      "sourceShabadId": "11445",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਸਤਸਠਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੬੭॥੩੩੦੮॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau satasaThavo charitr samaapatam sat subham sat ||167||3308||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੬੭ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੬੭॥੩੩੦੮॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ सतसठवो चरित्र समापतम सतु सुभम सतु ॥१६७॥३३०८॥अफजूँ॥",
      "sourceLineId": "122750",
      "sourceShabadId": "11445",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122751",
      "sourceShabadId": "11446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਛਿਮ ਕੋ ਰਾਜਾ ਰਹੈ ਰਨ ਮੰਡਨ ਸਿੰਘ ਨਾਮ ॥",
      "transliteration": "pachhim ko raajaa rahai ran ma(n)ddan si(n)gh naam ||",
      "translation": "",
      "punjabiViakhya": "ਪੱਛਮ (ਦੇਸ਼) ਵਿਚ ਰਨ ਮੰਡਨ ਸਿੰਘ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "पछिम को राजा रहै रन मंडन सिंघ नाम ॥",
      "sourceLineId": "122752",
      "sourceShabadId": "11446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੇਸ ਦੇਸ ਕੇ ਏਸ ਜਿਹ ਪੂਜਤ ਆਠੋ ਜਾਮ ॥੧॥",
      "transliteration": "dhes dhes ke es jeh poojat aaTho jaam ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਦੇਸ ਦੇਸ ਦੇ ਰਾਜੇ ਅੱਠੇ ਪਹਿਰ ਪੂਜਦੇ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "देस देस के एस जिह पूजत आठो जाम ॥१॥",
      "sourceLineId": "122753",
      "sourceShabadId": "11446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਵਾ ਰਾਜਾ ਕੀ ਬਲਿਭਾ ਜੋਤਿ ਮਤੀ ਸੁਭ ਕਾਰਿ ॥",
      "transliteration": "vaa raajaa kee balibhaa jot matee subh kaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਰਾਜੇ ਦੀ ਜੋਤਿ ਮਤੀ ਨਾ ਦੀ ਸ਼ੁਭ ਕੰਮ ਕਰਨ ਵਾਲੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "वा राजा की बलिभा जोति मती सुभ कारि ॥",
      "sourceLineId": "122754",
      "sourceShabadId": "11446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤੀਨ ਭਵਨ ਭੀਤਰ ਨਹੀ ਜਾ ਸਮ ਰਾਜ ਕੁਮਾਰਿ ॥੨॥",
      "transliteration": "teen bhavan bheetar nahee jaa sam raaj kumaar ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ ਤਿੰਨਾ ਲੋਕਾ ਵਿਚ ਕੋਈ ਰਾਜ ਕੁਮਾਰੀ ਨਹੀਂ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "तीन भवन भीतर नही जा सम राज कुमारि ॥२॥",
      "sourceLineId": "122755",
      "sourceShabadId": "11446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122756",
      "sourceShabadId": "11447",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਏਕ ਪਾਤ੍ਰ ਰਾਜਾ ਪਹਿ ਆਈ ॥",
      "transliteration": "ek paatr raajaa peh aaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਕ ਵਾਰ) ਇਕ ਵੇਸਵਾ ('ਪਾਤ੍ਰ') ਰਾਜੇ ਕੋਲ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "एक पात्र राजा पहि आई ॥",
      "sourceLineId": "122757",
      "sourceShabadId": "11447",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਿਜੁ ਹਾਥਨ ਬਿਧਿ ਜਾਨੁ ਬਨਾਈ ॥",
      "transliteration": "nij haathan bidh jaan banaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਇਤਨੀ ਸੁੰਦਰ ਸੀ) ਮਾਨੋ ਵਿਧਾਤਾ ਨੇ ਆਪਣੇ ਹੱਥਾ ਨਾਲ ਉਸ ਨੂੰ ਬਣਾਇਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "निजु हाथन बिधि जानु बनाई ॥",
      "sourceLineId": "122758",
      "sourceShabadId": "11447",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਾ ਪਰ ਅਟਕ ਰਾਵ ਕੀ ਭਈ ॥",
      "transliteration": "taa par aTak raav kee bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਉਤੇ ਰਾਜਾ ਮੋਹਿਤ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "ता पर अटक राव की भई ॥",
      "sourceLineId": "122759",
      "sourceShabadId": "11447",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਾਨੀ ਬਿਸਰਿ ਹ੍ਰਿਦੈ ਤੈ ਗਈ ॥੩॥",
      "transliteration": "raanee bisar hiradhai tai giee ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਹਿਰਦੇ ਵਿਚੋਂ ਵਿਸਰ ਗਈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "रानी बिसरि हृदै तै गई ॥३॥",
      "sourceLineId": "122760",
      "sourceShabadId": "11447",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122761",
      "sourceShabadId": "11448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਚਿਤ ਕੇ ਬਿਖੈ ਰਹੀ ਅਧਿਕ ਹੀ ਖੀਝਿ ॥",
      "transliteration": "tab raanee chit ke bikhai rahee adhik hee kheejh ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਮਨ ਵਿਚ ਬਹੁਤ ਹੀ ਖਿਝੀ",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "तब रानी चित के बिखै रही अधिक ही खीझि ॥",
      "sourceLineId": "122762",
      "sourceShabadId": "11448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਵਾ ਬੇਸ੍ਵਾ ਪਰਿ ਰਾਵ ਕੀ ਸੁਨਿ ਸ੍ਰਵਨਨ ਅਤਿ ਰੀਝਿ ॥੪॥",
      "transliteration": "vaa besavaiaa par raav kee sun sravanan at reejh ||4||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਨੇ ਰਾਜੇ ਨੂੰ ਵੇਸਵਾ ਉਤੇ ਰੀਝਿਆ ਹੋਇਆ ਸੁਣਿਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "वा बेस्वा परि राव की सुनि स्रवनन अति रीझि ॥४॥",
      "sourceLineId": "122763",
      "sourceShabadId": "11448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122764",
      "sourceShabadId": "11449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੇਸ ਦੇਸ ਖਬਰੈ ਦੈ ਗਈ ॥",
      "transliteration": "dhes dhes khabarai dhai giee ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਸ ਦੇਸ ਵਿਚ ਖ਼ਬਰ ਪਹੁੰਚ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "देस देस खबरै दै गई ॥",
      "sourceLineId": "122765",
      "sourceShabadId": "11449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬੇਸ੍ਵਨ ਰੀਝਿ ਰਾਵ ਕੀ ਭਈ ॥",
      "transliteration": "besavain reejh raav kee bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਰਾਜਾ ਵੇਸਵਾ ਉਤੇ ਮੋਹਿਤ ਹੋ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "बेस्वन रीझि राव की भई ॥",
      "sourceLineId": "122766",
      "sourceShabadId": "11449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਬਲਾ ਦੇਸ ਦੇਸ ਤੇ ਆਈ ॥",
      "transliteration": "abalaa dhes dhes te aaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਦੇਸ ਦੇਸ ਤੋਂ ਇਸਤਰੀਆਂ ਆ ਗਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "अबला देस देस ते आई ॥",
      "sourceLineId": "122767",
      "sourceShabadId": "11449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਆਨਿ ਰਾਵ ਕੀ ਪੁਰੀ ਸੁਹਾਈ ॥੫॥",
      "transliteration": "aan raav kee puree suhaiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆ ਕੇ ਰਾਜੇ ਦੀ ਨਗਰੀ ਨੂੰ ਸੁਸ਼ੋਭਿਤ ਕਰਨ ਲਗੀਆਂ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "आनि राव की पुरी सुहाई ॥५॥",
      "sourceLineId": "122768",
      "sourceShabadId": "11449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122769",
      "sourceShabadId": "11450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਕ੍ਰੁਧਿਤ ਭਈ ਧਾਰਿ ਬਦਨ ਮੈ ਮੌਨ ॥",
      "transliteration": "tab raanee krudhit bhiee dhaar badhan mai mauan ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਮੁਖ ਵਿਚ ਚੁਪ ਧਾਰਨ ਕਰ ਲਈ (ਅਤੇ ਸੋਚਣ ਲਗੀ ਕਿ)",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "तब रानी क्रुधित भई धारि बदन मै मौन ॥",
      "sourceLineId": "122770",
      "sourceShabadId": "11450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨ੍ਰਿਪ ਅਟਕੇ ਬੇਸ੍ਵਨ ਭਏ ਹਮੈ ਸੰਭਰਿ ਹੈ ਕੌਨ ॥੬॥",
      "transliteration": "nirap aTake besavain bhe hamai sa(n)bhar hai kauan ||6||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਤਾ ਵੇਸਵਾਵਾ ਵਿਚ ਅਟਕ ਗਿਆ ਹੈ, (ਹੁਣ) ਸਾਡੀ ਸੰਭਾਲ ਕੌਣ ਕਰੇਗਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "नृप अटके बेस्वन भए हमै संभरि है कौन ॥६॥",
      "sourceLineId": "122771",
      "sourceShabadId": "11450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122772",
      "sourceShabadId": "11451",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਐਸੋ ਜਤਨ ਕਛੂ ਅਬ ਕਰਿਯੈ ॥",
      "transliteration": "aaiso jatan kachhoo ab kariyai ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਕੋਈ ਅਜਿਹਾ ਯਤਨ ਕੀਤਾ ਜਾਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "ऐसो जतन कछू अब करियै ॥",
      "sourceLineId": "122773",
      "sourceShabadId": "11451",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਾ ਤੇ ਇਨ ਬੇਸ੍ਵਨ ਕੌ ਮਰਿਯੈ ॥",
      "transliteration": "jaa te in besavain kau mariyai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਇਨ੍ਰਹਾ ਸਾਰੀਆਂ ਵੇਸਵਾਵਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ਜਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "जा ते इन बेस्वन कौ मरियै ॥",
      "sourceLineId": "122774",
      "sourceShabadId": "11451",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਲਖਤ ਰਾਵ ਕੇ ਪ੍ਰੀਤਿ ਜਨਾਊ ॥",
      "transliteration": "lakhat raav ke preet janaauoo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਵੇਸਵਾਵਾ ਨਾਲ) ਰਾਜੇ ਦੇ ਵੇਖਦਿਆਂ ਪ੍ਰੀਤ ਦਾ ਵਿਖਾਵਾ ਕਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "लखत राव के प्रीति जनाऊ ॥",
      "sourceLineId": "122775",
      "sourceShabadId": "11451",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਛਲਿ ਸੋ ਬਡੋ ਕਲੇਸ ਮਿਟਾਊ ॥੭॥",
      "transliteration": "chhal so baddo kales miTaauoo ||7||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਛਲ ਕਰ ਕੇ (ਇਨ੍ਰਹਾ ਦੀ ਮੌਜੂਦਗੀ ਦਾ) ਵੱਡਾ ਕਲੇਸ਼ ਮਿਟਾ ਦਿਆਂ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "छलि सो बडो कलेस मिटाऊ ॥७॥",
      "sourceLineId": "122776",
      "sourceShabadId": "11451",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਧਿਕ ਪ੍ਰੀਤ ਬੇਸ੍ਵਨ ਸੌ ਕੀਨੀ ॥",
      "transliteration": "adhik preet besavain sau keenee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਵੇਸਵਾਵਾ ਨਾਲ ਬਹੁਤ ਪ੍ਰੀਤ ਜਤਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "अधिक प्रीत बेस्वन सौ कीनी ॥",
      "sourceLineId": "122777",
      "sourceShabadId": "11451",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਲਛਮੀ ਬਹੁਤ ਸਭਨ ਕਹ ਦੀਨੀ ॥",
      "transliteration": "lachhamee bahut sabhan keh dheenee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਭ ਨੂੰ ਬਹੁਤ ਧਨ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "लछमी बहुत सभन कह दीनी ॥",
      "sourceLineId": "122778",
      "sourceShabadId": "11451",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪ੍ਰੀਤਿ ਕਰਤ ਜਿਹ ਨ੍ਰਿਪਤਿ ਹਮਾਰੋ ॥",
      "transliteration": "preet karat jeh nirapat hamaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਮੂੰਹੋਂ ਕਹਿੰਦੀ ਕਿ) ਜਿਸ ਨਾਲ ਸਾਡੇ ਰਾਜਾ ਜੀ ਪਿਆਰ ਕਰਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "प्रीति करत जिह नृपति हमारो ॥",
      "sourceLineId": "122779",
      "sourceShabadId": "11451",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੋ ਹਮ ਕੌ ਪ੍ਰਾਨਨ ਤੇ ਪ੍ਯਾਰੋ ॥੮॥",
      "transliteration": "so ham kau praanan te payaaro ||8||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸਾਨੂੰ ਪ੍ਰਾਣਾ ਨਾਲੋਂ ਵੀ ਅਧਿਕ ਪਿਆਰੀ ਹੈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "सो हम कौ प्रानन ते प्यारो ॥८॥",
      "sourceLineId": "122780",
      "sourceShabadId": "11451",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਇਹ ਸੁਨਿ ਬੈਨ ਫੂਲ ਨ੍ਰਿਪ ਗਯੋ ॥",
      "transliteration": "eeh sun bain fool nirap gayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਬੋਲ ਸੁਣ ਕੇ ਰਾਜਾ ਫੁਲ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "इह सुनि बैन फूल नृप गयो ॥",
      "sourceLineId": "122781",
      "sourceShabadId": "11451",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਪਾਵਤ ਭਯੋ ॥",
      "transliteration": "bhedh abhedh na paavat bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਕਿਸੇ ਪ੍ਰਕਾਰ ਦੇ) ਗੁਝੇ ਭੇਦ ਨੂੰ ਸਮਝ ਨਾ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न पावत भयो ॥",
      "sourceLineId": "122782",
      "sourceShabadId": "11451",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਯਾ ਸੌ ਕਰਤ ਪ੍ਰੀਤਿ ਮੈ ਭਾਰੀ ॥",
      "transliteration": "yaa sau karat preet mai bhaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਸਗੋਂ ਸੋਚਣ ਲਗਿਆ ਕਿ) ਜਿਨ੍ਰਹਾ ਨਾਲ ਮੈਂ ਬਹੁਤ ਪ੍ਰੇਮ ਕਰਦਾ ਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "या सौ करत प्रीति मै भारी ॥",
      "sourceLineId": "122783",
      "sourceShabadId": "11451",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰਾਨੀ ਕਰਤ ਤਾਹਿ ਰਖਵਾਰੀ ॥੯॥",
      "transliteration": "raanee karat taeh rakhavaaree ||9||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਉਨ੍ਰਹਾ ਦੀ ਰਾਖੀ ਕਰਦੀ ਹੈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "रानी करत ताहि रखवारी ॥९॥",
      "sourceLineId": "122784",
      "sourceShabadId": "11451",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122785",
      "sourceShabadId": "11452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਭ ਰਾਨੀ ਬੇਸ੍ਵਨ ਸਹਿਤ ਲੀਨੀ ਨਿਕਟਿ ਬੁਲਾਇ ॥",
      "transliteration": "sabh raanee besavain sahit leenee nikaT bulai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਸਾਰੀਆਂ ਰਾਣੀਆਂ ਨੂੰ ਵੇਸਵਾਵਾ ਸਮੇਤ ਆਪਣੇ ਕੋਲ ਬੁਲਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "सभ रानी बेस्वन सहित लीनी निकटि बुलाइ ॥",
      "sourceLineId": "122786",
      "sourceShabadId": "11452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਸੁਖ ਕਿਯੇ ਤਿਨ ਤੇ ਗੀਤ ਗਵਾਇ ॥੧੦॥",
      "transliteration": "bhaat bhaat ke sukh kiye tin te geet gavai ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਤੋਂ ਗੀਤ ਗਵਾ ਗਵਾ ਕੇ ਬਹੁਤ ਸੁਖ ਪ੍ਰਾਪਤ ਕੀਤਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के सुख किये तिन ते गीत गवाइ ॥१०॥",
      "sourceLineId": "122787",
      "sourceShabadId": "11452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122788",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਐਸੋ ਚਰਿਤ ਨਿਤ ਨ੍ਰਿਪ ਕਰਈ ॥",
      "transliteration": "aaiso charit nit nirap kariee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦੇ ਕੰਮ ਰਾਜਾ ਹਰ ਰੋਜ਼ ਕਰਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "ऐसो चरित नित नृप करई ॥",
      "sourceLineId": "122789",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਛੁ ਰਾਨਿਨ ਤੇ ਸੰਕ ਨ ਧਰਈ ॥",
      "transliteration": "kachh raanin te sa(n)k na dhariee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀਆਂ ਤੋਂ ਕੁਝ ਵੀ ਸੰਗ ਨਾ ਕਰਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "कछु रानिन ते संक न धरई ॥",
      "sourceLineId": "122790",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਭ ਬੇਸ੍ਵਨ ਤੇ ਧਾਮ ਲੁਟਾਵੈ ॥",
      "transliteration": "sabh besavain te dhaam luTaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ) ਸਾਰੀਆਂ ਵੇਸਵਾਵਾ ਉਤੇ ਘਰ ਲੁਟਾ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "सभ बेस्वन ते धाम लुटावै ॥",
      "sourceLineId": "122791",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜੋਤਿ ਮਤੀ ਜਿਯ ਮੈ ਪਛੁਤਾਵੈ ॥੧੧॥",
      "transliteration": "jot matee jiy mai pachhutaavai ||11||",
      "translation": "",
      "punjabiViakhya": "ਜੋਤਿ ਮਤੀ (ਰਾਣੀ) ਮਨ ਵਿਚ ਬਹੁਤ ਪਛਤਾਉਾਂਦੀ ਸੀ (ਭਾਵ ਦੁਖੀ ਹੁੰਦੀ ਸੀ) ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "जोति मती जिय मै पछुतावै ॥११॥",
      "sourceLineId": "122792",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਨ੍ਰਿਪ ਤੀਰ ਉਚਾਰੋ ॥",
      "transliteration": "tab raanee nirap teer uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਨੇ ਰਾਜੇ ਕੋਲ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "तब रानी नृप तीर उचारो ॥",
      "sourceLineId": "122793",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1053_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੁਨੋ ਨ੍ਰਿਪਤਿ ਜੂ ਬਚਨ ਹਮਾਰੋ ॥",
      "transliteration": "suno nirapat joo bachan hamaaro ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਾ ਜੀ! ਮੇਰੀ ਗੱਲ ਸੁਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1053,
      "hindi": "",
      "hindiTransliteration": "सुनो नृपति जू बचन हमारो ॥",
      "sourceLineId": "122794",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
