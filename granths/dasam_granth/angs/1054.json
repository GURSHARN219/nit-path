{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1054,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1054_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬੇਰੀ ਏਕ ਬੈਠਿ ਸੁਖ ਕੀਜੈ ॥",
      "transliteration": "beree ek baiTh sukh keejai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਬੇੜੀ ਵਿਚ (ਤੁਸੀਂ ਤੇ ਮੈਂ) ਬੈਠ ਕੇ ਸੁਖ ਮੰਨਾਈਏ",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "बेरी एक बैठि सुख कीजै ॥",
      "sourceLineId": "122795",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੂਜੀ ਨਾਵ ਬੇਸਵਨ ਦੀਜੈ ॥੧੨॥",
      "transliteration": "dhoojee naav besavan dheejai ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੂਜੀ ਬੇੜੀ ਵੇਸਵਾਵਾ ਨੂੰ ਦੇਈਏ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "दूजी नाव बेसवन दीजै ॥१२॥",
      "sourceLineId": "122796",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਮ ਤੁਮ ਬੈਠਿ ਨਾਵ ਸੁਖ ਕੈਹੈ ॥",
      "transliteration": "ham tum baiTh naav sukh kaihai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਕ) ਬੇੜੀ ਵਿਚ ਤੁਸੀਂ ਤੇ ਮੈਂ ਬੈਠ ਕੇ ਸੁਖ ਪ੍ਰਾਪਤ ਕਰੀਏ",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "हम तुम बैठि नाव सुख कैहै ॥",
      "sourceLineId": "122797",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਨ ਬੇਸ੍ਵਨ ਤੇ ਗੀਤਿ ਗਵੈਹੈ ॥",
      "transliteration": "ein besavain te geet gavaihai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਨ੍ਰਹਾ ਵੇਸਵਾਵਾ ਤੋਂ ਗੀਤ ਗਵਾਈਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "इन बेस्वन ते गीति गवैहै ॥",
      "sourceLineId": "122798",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜੋ ਸੁੰਦਰਿ ਇਨ ਤੇ ਲਖਿ ਲਿਜਿਯਹੁ ॥",
      "transliteration": "jo su(n)dhar in te lakh lijiyahu ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਵਿਚੋਂ ਜੋ (ਤੁਹਾਨੂੰ) ਸੁੰਦਰ ਲਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "जो सुँदरि इन ते लखि लिजियहु ॥",
      "sourceLineId": "122799",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਾ ਸੌ ਭੋਗ ਰਾਵ ਤੁਮ ਕਿਜਿਯਹੁ ॥੧੩॥",
      "transliteration": "taa sau bhog raav tum kijiyahu ||13||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਹੇ ਰਾਉ ਜੀ! ਤੁਸੀਂ ਭੋਗ ਕਰਨਾ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "ता सौ भोग राव तुम किजियहु ॥१३॥",
      "sourceLineId": "122800",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੋ ਸੁਨਿ ਰਾਵ ਅਨੰਦਿਤ ਭਯੋ ॥",
      "transliteration": "so sun raav ana(n)dhit bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਗੱਲ ਸੁਣ ਕੇ ਰਾਜਾ ਆਨੰਦਿਤ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "सो सुनि राव अनंदित भयो ॥",
      "sourceLineId": "122801",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤ੍ਰਿਯਨ ਸਹਿਤ ਬੇਸ੍ਵਨ ਲੈ ਗਯੋ ॥",
      "transliteration": "tirayan sahit besavain lai gayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀਆਂ ਸਮੇਤ ਵੇਸਵਾਵਾ ਨੂੰ ਉਥੇ ਲੈ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "तृयन सहित बेस्वन लै गयो ॥",
      "sourceLineId": "122802",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਆਮੂੰ ਜਹਾ ਬਹਿਤ ਨਦ ਭਾਰੋ ॥",
      "transliteration": "aamoo(n) jahaa bahit nadh bhaaro ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਆਮੂੰ ਨਾ ਦਾ ਵੱਡਾ ਦਰਿਆ ਵਗਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "आमूँ जहा बहित नद भारो ॥",
      "sourceLineId": "122803",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਨੁ ਬਿਧਿ ਅਸਟਮ ਸਿੰਧੁ ਸਵਾਰੋ ॥੧੪॥",
      "transliteration": "jan bidh asaTam si(n)dh savaaro ||14||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਵਿਧਾਤਾ ਨੇ ਅੱਠਵਾ ਸਮੁੰਦਰ ਬਣਾਇਆ ਹੋਵੇ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "जनु बिधि असटम सिंधु सवारो ॥१४॥",
      "sourceLineId": "122804",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨੀਕੀ ਨਾਵ ਰਾਨਿਯਨ ਲਈ ॥",
      "transliteration": "neekee naav raaniyan liee ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਗੀ ਬੇੜੀ ਰਾਣੀ ਨੇ ਆਪ ਰਖ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "नीकी नाव रानियन लई ॥",
      "sourceLineId": "122805",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬੇਰੀ ਬੁਰੀ ਬੇਸ੍ਵਨ ਦਈ ॥",
      "transliteration": "beree buree besavain dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨੁਕਸ ਵਾਲੀ ਬੇੜੀ ਵੇਸਵਾਵਾ ਨੂੰ ਦੇ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "बेरी बुरी बेस्वन दई ॥",
      "sourceLineId": "122806",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਪਨੇ ਰਾਵ ਤੀਰ ਬੈਠਾਰਿਯੋ ॥",
      "transliteration": "apane raav teer baiThaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਆਪਣੇ ਕੋਲ ਬਿਠਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "अपने राव तीर बैठारियो ॥",
      "sourceLineId": "122807",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੂਰਖ ਭੇਦ ਨ ਕਛੂ ਬਿਚਾਰਿਯੋ ॥੧੫॥",
      "transliteration": "moorakh bhedh na kachhoo bichaariyo ||15||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਮੂਰਖ ਇਸ ਭੇਦ ਨੂੰ ਨਾ ਸਮਝ ਸਕਿਆ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "मूरख भेद न कछू बिचारियो ॥१५॥",
      "sourceLineId": "122808",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਤਿਨ ਅਤਿ ਧਨੁ ਦੀਨੋ ॥",
      "transliteration": "tab raanee tin at dhan dheeno ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਨੇ ਮਲਾਹਾ ('ਬੇਰਿਯਾਰ') ਨੂੰ ਬਹੁਤ ਧਨ ਦੇ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "तब रानी तिन अति धनु दीनो ॥",
      "sourceLineId": "122809",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬੇਰਿਯਾਰ ਅਪਨੇ ਬਸਿ ਕੀਨੋ ॥",
      "transliteration": "beriyaar apane bas keeno ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ) ਮਲਾਹਾ ਨੂੰ ਆਪਣੇ ਵਸ ਵਿਚ ਕਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "बेरियार अपने बसि कीनो ॥",
      "sourceLineId": "122810",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਹਾ ਬਹਤ ਆਮੂੰ ਨਦ ਭਾਰੋ ॥",
      "transliteration": "jahaa bahat aamoo(n) nadh bhaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ) ਜਿਥੇ ਆਮੂੰ ਨਦੀ ਦਾ (ਤੇਜ਼) ਵਹਾ ਹੋਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "जहा बहत आमूँ नद भारो ॥",
      "sourceLineId": "122811",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬੇਸ੍ਵਨ ਤਹੀ ਬੋਰਿ ਤੁਮ ਡਾਰੋ ॥੧੬॥",
      "transliteration": "besavain tahee bor tum ddaaro ||16||",
      "translation": "",
      "punjabiViakhya": "ਵੇਸਵਾਵਾ ਨੂੰ ਉਥੇ ਡਬੋ ਦਿਓ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "बेस्वन तही बोरि तुम डारो ॥१६॥",
      "sourceLineId": "122812",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਰਧ ਨਦੀ ਨਵਕਾ ਜਬ ਗਈ ॥",
      "transliteration": "aradh nadhee navakaa jab giee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਨੌਕਾ ਨਦੀ ਦੇ ਅੱਧ ਵਿਚ ਪਹੁੰਚ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "अरध नदी नवका जब गई ॥",
      "sourceLineId": "122813",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਬ ਹੀ ਫੋਰਿ ਮਲਾਹਨ ਦਈ ॥",
      "transliteration": "tab hee for malaahan dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮਲਾਹਾ ਨੇ ਉਸ ਨੂੰ ਤੋੜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "तब ही फोरि मलाहन दई ॥",
      "sourceLineId": "122814",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਭ ਬੇਸ੍ਵਾ ਡੂਬਨ ਤਬ ਲਾਗੀ ॥",
      "transliteration": "sabh besavaiaa ddooban tab laagee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਸਭ ਵੇਸਵਾਵਾ ਡੁਬਣ ਲਗੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "सभ बेस्वा डूबन तब लागी ॥",
      "sourceLineId": "122815",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਭਰੂਵਨਿ ਦਸੋ ਦਿਸਨ ਕਹ ਭਾਗੀ ॥੧੭॥",
      "transliteration": "bharoovan dhaso dhisan keh bhaagee ||17||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਦਾਸੀਆਂ ('ਭਰੁਵਨਿ' ਭੜੂਈ ਦੀ ਇਸਤਰੀ) ਦਸਾ ਦਿਸ਼ਾਵਾ ਵਲ ਭਜਣ ਲਗੀਆਂ (ਅਰਥਾਤ ਇਧਰ ਉਧਰ ਭਜਣ ਲਗੀਆਂ) ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "भरूवनि दसो दिसन कह भागी ॥१७॥",
      "sourceLineId": "122816",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬੇਸ੍ਵਾ ਸਕਲ ਗੁਚਕਿਯਨ ਖਾਹੀ ॥",
      "transliteration": "besavaiaa sakal guchakiyan khaahee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਵੇਸਵਾਵਾ ਗ਼ੋਤੇ ਖਾਣ ਲਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "बेस्वा सकल गुचकियन खाही ॥",
      "sourceLineId": "122817",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਠੌਰ ਨ ਰਹੀ ਭਾਜਿ ਜਿਤ ਜਾਹੀ ॥",
      "transliteration": "Thauar na rahee bhaaj jit jaahee ||",
      "translation": "",
      "punjabiViakhya": "(ਨੇੜੇ) ਕੋਈ ਥਾ ਨਹੀਂ ਸੀ ਜਿਥੇ ਭਜ ਕੇ ਜਾਦੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "ठौर न रही भाजि जित जाही ॥",
      "sourceLineId": "122818",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹਾਇ ਹਾਇ ਰਾਨੀ ਤਬ ਕਰਈ ॥",
      "transliteration": "hai hai raanee tab kariee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਨੀ 'ਹਾਇ ਹਾਇ' ਕਰਨ ਲਗੀ (ਅਤੇ ਕਹਿਣ ਲਗੀ ਕਿ)",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "हाइ हाइ रानी तब करई ॥",
      "sourceLineId": "122819",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਇਨ ਮੂਏ ਰਾਜਾ ਇਹ ਮਰਈ ॥੧੮॥",
      "transliteration": "ein mooe raajaa ieh mariee ||18||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਦੇ ਮੋਇਆਂ ਇਹ ਰਾਜਾ ਵੀ ਮਰ ਜਾਏਗਾ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "इन मूए राजा इह मरई ॥१८॥",
      "sourceLineId": "122820",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰਾਵ ਸੁਨਤ ਇਨ ਕਹੈ ਨਿਕਾਰਹੁ ॥",
      "transliteration": "raav sunat in kahai nikaarahu ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਸੁਣਾਉਾਂਦੀ ਹੋਈ ਕਹਿੰਦੀ ਕਿ ਇਨ੍ਰਹਾ ਨੂੰ ਬਚਾਓ",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "राव सुनत इन कहै निकारहु ॥",
      "sourceLineId": "122821",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਖਿਯਨ ਕਹਿਯੋ ਬੋਰ ਗਹਿ ਡਾਰਹੁ ॥",
      "transliteration": "sakhiyan kahiyo bor geh ddaarahu ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਖੀਆਂ ਨੂੰ ਕਹਿੰਦੀ ਕਿ ਇਨ੍ਰਹਾ ਨੂੰ ਡਬੋ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "सखियन कहियो बोर गहि डारहु ॥",
      "sourceLineId": "122822",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਮਿਤ ਮ੍ਰਿਦੰਗ ਬਹਤ ਕਹੂੰ ਜਾਹੀ ॥",
      "transliteration": "amit miradha(n)g bahat kahoo(n) jaahee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਬੇਸ਼ੁਮਾਰ ਢੋਲਕੀਆਂ ਰੁੜ੍ਰਹੀ ਜਾ ਰਹੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "अमित मृदंग बहत कहूँ जाही ॥",
      "sourceLineId": "122823",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬੇਸ੍ਵਾ ਕਹੀ ਗੁਚਕਿਯਨ ਖਾਹੀ ॥੧੯॥",
      "transliteration": "besavaiaa kahee guchakiyan khaahee ||19||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਵੇਸਵਾਵਾ ਗ਼ੋਤੇ ਖਾ ਰਹੀਆਂ ਸਨ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "बेस्वा कही गुचकियन खाही ॥१९॥",
      "sourceLineId": "122824",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮੁਰਲੀ ਮੁਰਜ ਤੰਬੂਰਾ ਬਹੈ ॥",
      "transliteration": "muralee muraj ta(n)booraa bahai ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਰਲੀਆਂ, ਮੁਰਜ ਅਤੇ ਤੰਬੂਰੇ ਵਹਿ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "मुरली मुरज तंबूरा बहै ॥",
      "sourceLineId": "122825",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਰੂਆ ਬਹੇ ਜਾਤਿ ਨਹਿ ਕਹੇ ॥",
      "transliteration": "bharooaa bahe jaat neh kahe ||",
      "translation": "",
      "punjabiViakhya": "(ਅਨੇਕ) ਭੜੂਏ ਰੁੜ੍ਰਹ ਰਹੇ ਸਨ, (ਜਿਨ੍ਰਹਾ ਦਾ) ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "भरूआ बहे जाति नहि कहे ॥",
      "sourceLineId": "122826",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭਰੂਅਨਿ ਕਹੂੰ ਪੁਕਾਰਤ ਜਾਹੀ ॥",
      "transliteration": "bharooan kahoo(n) pukaarat jaahee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਭੜੂਇਆਂ ਦੀਆਂ ਇਸਤਰੀਆਂ ਪੁਕਾਰਦੀਆਂ ਜਾ ਰਹੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "भरूअनि कहूँ पुकारत जाही ॥",
      "sourceLineId": "122827",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬੇਸ੍ਵਨ ਰਹੀ ਕਛੂ ਸੁਧਿ ਨਾਹੀ ॥੨੦॥",
      "transliteration": "besavain rahee kachhoo sudh naahee ||20||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵੇਸਵਾਵਾ ਨੂੰ ਕੋਈ ਸੁੱਧ ਨਹੀਂ ਰਹੀ ਸੀ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "बेस्वन रही कछू सुधि नाही ॥२०॥",
      "sourceLineId": "122828",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਡੂਬਿ ਡੂਬਿ ਭਰੂਆ ਕਹੂੰ ਮਰੇ ॥",
      "transliteration": "ddoob ddoob bharooaa kahoo(n) mare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਭੜੂਏ ਡੁਬ ਡੁਬ ਕੇ ਮਰ ਗਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "डूबि डूबि भरूआ कहूँ मरे ॥",
      "sourceLineId": "122829",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਰੂਅਨਿ ਉਦਰ ਨੀਰ ਸੋ ਭਰੇ ॥",
      "transliteration": "bharooan udhar neer so bhare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਭੜੂਇਆਂ ਦੀਆਂ ਇਸਤਰੀਆਂ ਦੇ ਪੇਟ ਪਾਣੀ ਨਾਲ ਭਰ ਗਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "भरूअनि उदर नीर सो भरे ॥",
      "sourceLineId": "122830",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬੇਸ੍ਵਾ ਏਕ ਜਿਯਤ ਨਹਿ ਬਾਚੀ ॥",
      "transliteration": "besavaiaa ek jiyat neh baachee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਵੇਸਵਾ ਵੀ ਜੀਉਾਂਦੀ ਨਹੀਂ ਬਚੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "बेस्वा एक जियत नहि बाची ॥",
      "sourceLineId": "122831",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਐਸੀ ਮਾਰ ਕਿਰੀਚਕ ਮਾਚੀ ॥੨੧॥",
      "transliteration": "aaisee maar kireechak maachee ||21||",
      "translation": "",
      "punjabiViakhya": "ਅਜਿਹੀ ਮਾਰ ਮਚੀ (ਜਿਹੀ ਭੀਮ ਸੈਨ ਨੇ) ਕ੍ਰੀਚਕਾ (ਉਤੇ ਕੀਤੀ ਸੀ) ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "ऐसी मार किरीचक माची ॥२१॥",
      "sourceLineId": "122832",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਚਕਿ ਖਾਤ ਬੇਸ੍ਵਾ ਜੇ ਗਈ ॥",
      "transliteration": "guchak khaat besavaiaa je giee ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਗ਼ੋਤੇ ਖਾਦੀ ਕੋਈ ਵੇਸਵਾ (ਬਚ) ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "गुचकि खात बेस्वा जे गई ॥",
      "sourceLineId": "122833",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਟੰਗਰਨਿ ਪਕਰਿ ਬੋਰਿ ਸੋਊ ਦਈ ॥",
      "transliteration": "Ta(n)garan pakar bor souoo dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੂੰ ਟੰਗੋਂ ਪਕੜ ਕੇ ਡਬੋ ਦਿੱਤਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "टंगरनि पकरि बोरि सोऊ दई ॥",
      "sourceLineId": "122834",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਾਇ ਹਾਇ ਨ੍ਰਿਪ ਠਾਢ ਪੁਕਾਰੈ ॥",
      "transliteration": "hai hai nirap Thaadd pukaarai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਖੜੋਤਾ ਹੋਇਆ 'ਹਾਏ-ਹਾਏ' ਕਰਨ ਲਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "हाइ हाइ नृप ठाढ पुकारै ॥",
      "sourceLineId": "122835",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕੋ ਪਹੁਚੈ ਤਿਨ ਖੈਂਚਿ ਨਿਕਾਰੈ ॥੨੨॥",
      "transliteration": "ko pahuchai tin khai(n)ch nikaarai ||22||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿਣ ਲਗਾ ਕਿ) ਉਥੇ ਕੋਈ ਪਹੁੰਚੇ ਅਤੇ (ਉਨ੍ਰਹਾ ਨੂੰ) ਖਿਚ ਕੇ ਬਾਹਰ ਕਢੇ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "को पहुचै तिन खैंचि निकारै ॥२२॥",
      "sourceLineId": "122836",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜੋ ਬੇਸ੍ਵਾ ਕਾਢਨ ਕਹ ਗਯੋ ॥",
      "transliteration": "jo besavaiaa kaaddan keh gayo ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਵੀ ਵੇਸਵਾਵਾ ਨੂੰ ਕਢਣ ਲਈ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "जो बेस्वा काढन कह गयो ॥",
      "sourceLineId": "122837",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਡੂਬਤ ਵਹੂ ਨਦੀ ਮਹਿ ਭਯੋ ॥",
      "transliteration": "ddoobat vahoo nadhee meh bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਵੀ ਨਦੀ ਵਿਚ ਡੁਬ ਮੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "डूबत वहू नदी महि भयो ॥",
      "sourceLineId": "122838",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਧਾਰ ਧਾਰ ਭਰੁਅਨਿ ਇਕ ਕਰਹੀ ॥",
      "transliteration": "dhaar dhaar bharuan ik karahee ||",
      "translation": "",
      "punjabiViakhya": "ਭੜੂਇਆਂ ਦੀਆਂ ਇਸਤਰੀਆਂ (ਨਦੀ ਦੀ) ਧਾਰ ਨਾਲ ਧਾਰ ਹੋ ਗਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "धार धार भरुअनि इक करही ॥",
      "sourceLineId": "122839",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਡੂਬਿ ਡੂਬਿ ਸਰਿਤਾ ਮੋ ਮਰਹੀ ॥੨੩॥",
      "transliteration": "ddoob ddoob saritaa mo marahee ||23||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਦੀ ਵਿਚ ਡੁਬ ਡੁਬ ਕੇ ਮਰ ਗਈਆਂ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "डूबि डूबि सरिता मो मरही ॥२३॥",
      "sourceLineId": "122840",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕੂਕਿ ਕੂਕਿ ਬੇਸ੍ਵਾ ਸਭ ਹਾਰੀ ॥",
      "transliteration": "kook kook besavaiaa sabh haaree ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਵੇਸਵਾਵਾ ਚੀਖ਼ ਪੁਕਾਰ ਕਰ ਕਰ ਕੇ ਹਾਰ ਗਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "कूकि कूकि बेस्वा सभ हारी ॥",
      "sourceLineId": "122841",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1054_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਿਨਹੀ ਪੁਰਖ ਨ ਐਂਚਿ ਨਿਕਾਰੀ ॥",
      "transliteration": "kinahee purakh na aai(n)ch nikaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ) ਕਿਸੇ ਪੁਰਸ਼ ਨੇ ਉਨ੍ਰਹਾ ਨੂੰ ਖਿਚ ਕੇ ਨਾ ਕਢਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1054,
      "hindi": "",
      "hindiTransliteration": "किनही पुरख न ऐंचि निकारी ॥",
      "sourceLineId": "122842",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
