{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1055,
  "lineCount": 46,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1055_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭਰੂਆ ਮਰਿ ਭਰੂਅਨਿ ਜੁਤ ਰਹੇ ॥",
      "transliteration": "bharooaa mar bharooan jut rahe ||",
      "translation": "",
      "punjabiViakhya": "ਭੜੂਏ ਆਪਣੀਆਂ ਇਸਤਰੀਆਂ ਸਹਿਤ ਉਥੇ ਹੀ ਰਹੇ (ਭਾਵ ਡੁਬ ਗਏ)।",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "भरूआ मरि भरूअनि जुत रहे ॥",
      "sourceLineId": "122843",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਕ ਸੋ ਸਾਠਿ ਤਾਇਫੇ ਬਹੇ ॥੨੪॥",
      "transliteration": "eik so saaTh taife bahe ||24||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਸੌ ਸਠ ਵੇਸਵਾਵਾ ਰੁੜ੍ਰਹ ਗਈਆਂ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "इक सो साठि ताइफे बहे ॥२४॥",
      "sourceLineId": "122844",
      "sourceShabadId": "11453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122845",
      "sourceShabadId": "11454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦਸ ਦਸ ਮਨ ਤਿਲਕੈ ਭਈ ਖਟ ਮਨ ਭਈ ਇਜਾਰ ॥",
      "transliteration": "dhas dhas man tilakai bhiee khaT man bhiee ijaar ||",
      "translation": "",
      "punjabiViakhya": "ਪਾਣੀ ਨਾਲ ਭਿਜ ਕੇ (ਉਨ੍ਰਹਾ ਦੇ) ਜਾਮੇ ਦਸ ਦਸ ਮਣ ਦੇ ਹੋ ਗਏ ਅਤੇ ਛੇ ਛੇ ਮਣ ਦੀਆਂ ਸਲਵਾਰਾ ਹੋ ਗਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "दस दस मन तिलकै भई खट मन भई इजार ॥",
      "sourceLineId": "122846",
      "sourceShabadId": "11454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਡੂਬਿ ਮਰੀ ਬੇਸ੍ਵਾ ਸਕਲ ਕੋਊ ਨ ਸਕਿਯੋ ਨਿਕਾਰਿ ॥੨੫॥",
      "transliteration": "ddoob maree besavaiaa sakal kouoo na sakiyo nikaar ||25||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਵੇਸਵਾਵਾ ਡੁਬ ਮਰੀਆਂ, ਉਨ੍ਰਹਾ ਨੂੰ ਕੋਈ ਵੀ ਬਾਹਰ ਨਾ ਕਢ ਸਕਿਆ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "डूबि मरी बेस्वा सकल कोऊ न सकियो निकारि ॥२५॥",
      "sourceLineId": "122847",
      "sourceShabadId": "11454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122848",
      "sourceShabadId": "11455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਨ੍ਰਿਪ ਪੈ ਚਲਿ ਗਈ ॥",
      "transliteration": "tab raanee nirap pai chal giee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਰਾਜੇ ਕੋਲ ਚਲ ਕੇ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "तब रानी नृप पै चलि गई ॥",
      "sourceLineId": "122849",
      "sourceShabadId": "11455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਸਮੁਝਾਵਤ ਭਈ ॥",
      "transliteration": "bhaat bhaat samujhaavat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਢੰਗਾ ਨਾਲ ਸਮਝਾਉਣ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "भाति भाति समुझावत भई ॥",
      "sourceLineId": "122850",
      "sourceShabadId": "11455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪਤਿ ਤੁਮ ਕਛੂ ਸੋਕ ਨ ਬਿਚਾਰਹੁ ॥",
      "transliteration": "pat tum kachhoo sok na bichaarahu ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਤੀ ਦੇਵ! ਤੁਸੀਂ ਕੁਝ ਵੀ ਦੁਖ ਨਾ ਮਨਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "पति तुम कछू सोक न बिचारहु ॥",
      "sourceLineId": "122851",
      "sourceShabadId": "11455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਨ ਰਨਿਯਨ ਕੇ ਸੰਗ ਬਿਹਾਰਹੁ ॥੨੬॥",
      "transliteration": "ein raniyan ke sa(n)g bihaarahu ||26||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਰਾਣੀਆਂ ਨਾਲ ਵਿਹਾਰ ਕਰੋ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "इन रनियन के संग बिहारहु ॥२६॥",
      "sourceLineId": "122852",
      "sourceShabadId": "11455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਔਰ ਬੇਸ੍ਵਾ ਬੋਲਿ ਪਠੈਯਹੁ ॥",
      "transliteration": "aauar besavaiaa bol paThaiyahu ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ ਤੁਹਾਨੂੰ) ਹੋਰ ਵੇਸਵਾਵਾ ਬੁਲਾ ਦਿੰਦੀ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "और बेस्वा बोलि पठैयहु ॥",
      "sourceLineId": "122853",
      "sourceShabadId": "11455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਾਮ ਕੇਲ ਤਿਨ ਸੰਗ ਕਮੈਯਹੁ ॥",
      "transliteration": "kaam kel tin sa(n)g kamaiyahu ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਨਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "काम केल तिन संग कमैयहु ॥",
      "sourceLineId": "122854",
      "sourceShabadId": "11455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੌ ਤੁਮ ਕੌ ਰਾਖਿਯੋ ਕਰਤਾਰਾ ॥",
      "transliteration": "jau tum kau raakhiyo karataaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਤੁਹਾਨੂੰ ਕਰਤਾਰ ਨੇ ਰਖ ਲਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "जौ तुम कौ राखियो करतारा ॥",
      "sourceLineId": "122855",
      "sourceShabadId": "11455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹੋਇ ਸੁੰਦਰੀ ਕਈ ਹਜਾਰਾ ॥੨੭॥",
      "transliteration": "hoi su(n)dharee kiee hajaaraa ||27||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਫਿਰ) ਸੁੰਦਰੀਆਂ ਕਈ ਹਜ਼ਾਰ ਹੋਰ ਹੋ ਜਾਣਗੀਆਂ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "होइ सुँदरी कई हजारा ॥२७॥",
      "sourceLineId": "122856",
      "sourceShabadId": "11455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122857",
      "sourceShabadId": "11456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮੂੜ ਰਾਵ ਚੁਪ ਹ੍ਵੈ ਰਹਿਯੋ ਸਕਿਯੋ ਨ ਚਰਿਤ ਬਿਚਾਰਿ ॥",
      "transliteration": "mooR raav chup havai rahiyo sakiyo na charit bichaar ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਰਾਜਾ ਚੁਪ ਹੋ ਰਿਹਾ ਅਤੇ ਚਰਿਤ੍ਰ ਨੂੰ ਵਿਚਾਰ ਨਾ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "मूड़ राव चुप ह्वै रहियो सकियो न चरित बिचारि ॥",
      "sourceLineId": "122858",
      "sourceShabadId": "11456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪ੍ਰਗਟ ਅਖਾਰੇ ਸਾਠਿ ਸਤ ਰਾਨੀ ਦਏ ਸੰਘਾਰਿ ॥੨੮॥",
      "transliteration": "pragaT akhaare saaTh sat raanee dhe sa(n)ghaar ||28||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਦਿਨ ਦੀਵੀਂ ਇਕ ਸੌ ਸਠ ਵੇਸਵਾਵਾ ਦਾ ਅਖਾੜਾ ਸੰਘਾਰ ਦਿੱਤਾ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "प्रगट अखारे साठि सत रानी दए संघारि ॥२८॥",
      "sourceLineId": "122859",
      "sourceShabadId": "11456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਅਠਸਠਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੬੮॥੩੩੩੬॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau aThasaThavo charitr samaapatam sat subham sat ||168||3336||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੬੮ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੬੮॥੩੩੩੬॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ अठसठवो चरित्र समापतम सतु सुभम सतु ॥१६८॥३३३६॥अफजूँ॥",
      "sourceLineId": "122860",
      "sourceShabadId": "11456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122861",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬ੍ਰਿਜ ਮਹਿ ਏਕ ਅਹੀਰਨਿ ਰਹੈ ॥",
      "transliteration": "biraj meh ek aheeran rahai ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਜ ਦੇਸ਼ ਵਿਚ ਇਕ ਅਹੀਰਨ (ਗੁਜਰੀ) ਰਹਿੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "बृज महि एक अहीरनि रहै ॥",
      "sourceLineId": "122862",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਾਹ ਪਰੀ ਤਾ ਕੌ ਜਗ ਕਹੈ ॥",
      "transliteration": "saeh paree taa kau jag kahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸਾਰੇ ਸ਼ਾਹ ਪਰੀ ਕਹਿੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "साह परी ता कौ जग कहै ॥",
      "sourceLineId": "122863",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਤਿ ਉਤਮ ਤਿਹ ਅੰਗ ਬਿਰਾਜੈ ॥",
      "transliteration": "at utam teh a(n)g biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਸ਼ਰੀਰ ਬਹੁਤ ਸੁੰਦਰ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "अति उतम तिह अंग बिराजै ॥",
      "sourceLineId": "122864",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਾ ਕੌ ਨਿਰਖਿ ਚੰਦ੍ਰਮਾ ਲਾਜੈ ॥੧॥",
      "transliteration": "jaa kau nirakh cha(n)dhramaa laajai ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਚੰਦ੍ਰਮਾ ਸ਼ਰਮਿੰਦਾ ਹੁੰਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "जा कौ निरखि चंद्रमा लाजै ॥१॥",
      "sourceLineId": "122865",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰੰਗੀ ਰਾਮ ਅਹੀਰਿਕ ਤਹਾ ॥",
      "transliteration": "ra(n)gee raam aheerik tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਰੰਗੀ ਰਾਮ ਨਾ ਦਾ ਅਹੀਰ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "रंगी राम अहीरिक तहा ॥",
      "sourceLineId": "122866",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਲਾਗੀ ਲਗਨ ਤ੍ਰਿਯਾ ਕੀ ਉਹਾ ॥",
      "transliteration": "laagee lagan tirayaa kee uhaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਦੀ ਉਸ ਨਾਲ ਲਗਨ ਲਗ ਗਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "लागी लगन तृया की उहा ॥",
      "sourceLineId": "122867",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਬ ਸੋਯੋ ਅਪਨੋ ਪਤਿ ਜਾਨੈ ॥",
      "transliteration": "jab soyo apano pat jaanai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਆਪਣੇ ਪਤੀ ਨੂੰ ਸੁਤਾ ਹੋਇਆ ਸਮਝਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "जब सोयो अपनो पति जानै ॥",
      "sourceLineId": "122868",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਾਮ ਕੇਲ ਤਿਹ ਸੰਗ ਪ੍ਰਮਾਨੈ ॥੨॥",
      "transliteration": "kaam kel teh sa(n)g pramaanai ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ (ਅਹੀਰ) ਨਾਲ ਪ੍ਰੇਮ-ਕ੍ਰੀੜਾ ਕਰਦੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "काम केल तिह संग प्रमानै ॥२॥",
      "sourceLineId": "122869",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਤਾ ਸੋ ਪਤਿ ਸੋਯੋ ॥",
      "transliteration": "ek dhivas taa so pat soyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਉਸ ਦਾ ਪਤੀ ਸੁੱਤਾ ਹੋਇਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "एक दिवस ता सो पति सोयो ॥",
      "sourceLineId": "122870",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਾਮ ਕੇਲ ਕਰਿ ਅਤਿ ਦੁਖ ਖੋਯੋ ॥",
      "transliteration": "kaam kel kar at dhukh khoyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਕਾਮ-ਕੇਲ ਕਰ ਕੇ ਦੁਖ ਨੂੰ ਖ਼ਤਮ ਕਰ ਦਿੱਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "काम केल करि अति दुख खोयो ॥",
      "sourceLineId": "122871",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰੰਗੀ ਰਾਮ ਤਹਾ ਚਲਿ ਆਯੋ ॥",
      "transliteration": "ra(n)gee raam tahaa chal aayo ||",
      "translation": "",
      "punjabiViakhya": "ਰੰਗੀ ਰਾਮ ਵੀ ਉਥੇ ਆ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "रंगी राम तहा चलि आयो ॥",
      "sourceLineId": "122872",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਫਿਰਿ ਘਰ ਚਲਿਯੋ ਦਾਵ ਨਹਿ ਪਾਯੋ ॥੩॥",
      "transliteration": "fir ghar chaliyo dhaav neh paayo ||3||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਮੌਕਾ ਨਾ ਮਿਲਣ ਕਰ ਕੇ ਘਰ ਨੂੰ ਪਰਤ ਚਲਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "फिरि घर चलियो दाव नहि पायो ॥३॥",
      "sourceLineId": "122873",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਾਗਤ ਹੁਤੀ ਤ੍ਰਿਯਾ ਲਖਿ ਲੀਨੋ ॥",
      "transliteration": "jaagat hutee tirayaa lakh leeno ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਜਾਗਦੀ ਸੀ, (ਉਸ ਨੇ) ਵੇਖ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "जागत हुती तृया लखि लीनो ॥",
      "sourceLineId": "122874",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨੈਨਨ ਸੈਨ ਮਿਤ੍ਰ ਕਹ ਦੀਨੋ ॥",
      "transliteration": "nainan sain mitr keh dheeno ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਿਤਰ ਨੂੰ ਅੱਖ ਦਾ ਇਸ਼ਾਰਾ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "नैनन सैन मित्र कह दीनो ॥",
      "sourceLineId": "122875",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਖਾਰੀ ਹੁਤੀ ਸੁ ਐਂਚਿ ਮੰਗਾਈ ॥",
      "transliteration": "khaaree hutee su aai(n)ch ma(n)gaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਕਾਨਿਆਂ ਦੀ ਖਾਰੀ ਹੁੰਦੀ ਸੀ, (ਉਸ ਨੂੰ) ਖਿਚ ਕੇ ਮੰਗਵਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "खारी हुती सु ऐंचि मंगाई ॥",
      "sourceLineId": "122876",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਿਜੁ ਪਲਘਾ ਕੇ ਨਿਕਟਿ ਬਿਛਾਈ ॥੪॥",
      "transliteration": "nij palaghaa ke nikaT bichhaiee ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਪਲੰਘ ਦੇ ਨੇੜੇ ਰਖ ਦਿੱਤਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "निजु पलघा के निकटि बिछाई ॥४॥",
      "sourceLineId": "122877",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪਿਯ ਕੇ ਅੰਗ ਅਲਿੰਗਨ ਕਰਿਯੋ ॥",
      "transliteration": "piy ke a(n)g ali(n)gan kariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਪ੍ਰਿਯ ਦੇ ਸ਼ਰੀਰ ਨੂੰ ਜਫੀ ਪਾ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "पिय के अंग अलिंगन करियो ॥",
      "sourceLineId": "122878",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਆਸਨ ਤਿਹ ਖਾਰੀ ਪਰ ਧਰਿਯੋ ॥",
      "transliteration": "aasan teh khaaree par dhariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣਾ ਪੇਡੂ ਖਾਰੀ ਉਤੇ ਧਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "आसन तिह खारी पर धरियो ॥",
      "sourceLineId": "122879",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਨ ਮਾਨਤ ਕੋ ਭੋਗ ਕਮਾਯੋ ॥",
      "transliteration": "man maanat ko bhog kamaayo ||",
      "translation": "",
      "punjabiViakhya": "ਮਨ ਦੀ ਇੱਛਾ ਅਨੁਸਾਰ ਭੋਗ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "मन मानत को भोग कमायो ॥",
      "sourceLineId": "122880",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮੂਰਖ ਨਾਹ ਭੇਦ ਨਹਿ ਪਾਯੋ ॥੫॥",
      "transliteration": "moorakh naeh bhedh neh paayo ||5||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਪਤੀ ('ਨਾਹ') ਨੇ ਭੇਦ ਨਹੀਂ ਪਾਇਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "मूरख नाह भेद नहि पायो ॥५॥",
      "sourceLineId": "122881",
      "sourceShabadId": "11457",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "122882",
      "sourceShabadId": "11458",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚਿਮਟਿ ਚਿਮਟਿ ਕਰਿ ਭੋਗ ਅਧਿਕ ਤਾ ਸੌ ਕਿਯੋ ॥",
      "transliteration": "chimaT chimaT kar bhog adhik taa sau kiyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਉਸ ਨਾਲ ਚਿਮਟ ਚਿਮਟ ਕੇ ਬਹੁਤ ਭੋਗ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "चिमटि चिमटि करि भोग अधिक ता सौ कियो ॥",
      "sourceLineId": "122883",
      "sourceShabadId": "11458",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਧਰ ਪਾਨ ਕਰਿ ਕੈ ਕਰਿ ਜਾਰਿ ਬਿਦਾ ਦਿਯੋ ॥",
      "transliteration": "adhar paan kar kai kar jaar bidhaa dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬੁਲ੍ਰਹ ਚੂਸ ਕੇ ਯਾਰ ਨੂੰ ਵਿਦਾ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "अधर पान करि कै करि जारि बिदा दियो ॥",
      "sourceLineId": "122884",
      "sourceShabadId": "11458",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੋਤ ਰਹਿਯੋ ਮੂਰਖ ਕਛੁ ਭੇਦ ਨ ਪਾਇਯੋ ॥",
      "transliteration": "sot rahiyo moorakh kachh bhedh na paiyo ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਪਤੀ ਸੁੱਤਾ ਰਿਹਾ ਅਤੇ ਕੁਝ ਵੀ ਭੇਦ ਨਾ ਸਮਝ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "सोत रहियो मूरख कछु भेद न पाइयो ॥",
      "sourceLineId": "122885",
      "sourceShabadId": "11458",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹੋ ਧਰ ਖਾਰੀ ਪਰ ਕਸ ਇਨ ਕਰਮ ਕਮਾਇਯੋ ॥੬॥",
      "transliteration": "ho dhar khaaree par kas in karam kamaiyo ||6||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨੇ ਖਾਰੀ ਉਤੇ ਧਰ ਕੇ ਕਿਹੋ ਜਿਹਾ ਕਰਮ ਕੀਤਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "हो धर खारी पर कस इन करम कमाइयो ॥६॥",
      "sourceLineId": "122886",
      "sourceShabadId": "11458",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122887",
      "sourceShabadId": "11459",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1055_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਉਰ ਚਿਮਟਯੋ ਪਿਯ ਸੋ ਰਹਿਯੋ ਕੇਲ ਜਾਰ ਤਨ ਕੀਨ ॥",
      "transliteration": "aur chimaTayo piy so rahiyo kel jaar tan keen ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਛਾਤੀ ਤਾ ਪਤੀ ਨਾਲ ਲਗੀ ਰਹੀ ਅਤੇ ਯਾਰ ਨਾਲ ਕੇਲ-ਕ੍ਰੀੜਾ ਕਰਨ ਲਈ (ਪੇਡੂ ਖਾਰੀ ਵਲ) ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1055,
      "hindi": "",
      "hindiTransliteration": "उर चिमटयो पिय सो रहियो केल जार तन कीन ॥",
      "sourceLineId": "122888",
      "sourceShabadId": "11459",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
