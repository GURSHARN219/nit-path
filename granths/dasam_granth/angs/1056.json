{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1056,
  "lineCount": 50,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1056_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਖਾਰੀ ਦਈ ਉਠਾਇ ਪੁਨਿ ਜਾਰ ਬਿਦਾ ਕਰਿ ਦੀਨ ॥੭॥",
      "transliteration": "khaaree dhiee uThai pun jaar bidhaa kar dheen ||7||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਖਾਰੀ ਉਠਾ ਦਿੱਤੀ ਅਤੇ ਯਾਰ ਨੂੰ ਵਿਦਾ ਕਰ ਦਿੱਤਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "खारी दई उठाइ पुनि जार बिदा करि दीन ॥७॥",
      "sourceLineId": "122889",
      "sourceShabadId": "11459",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਉਨਤਰਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੬੯॥੩੩੪੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau unataravo charitr samaapatam sat subham sat ||169||3343||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੬੯ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੬੯॥੩੩੪੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ उनतरवो चरित्र समापतम सतु सुभम सतु ॥१६९॥३३४३॥अफजूँ॥",
      "sourceLineId": "122890",
      "sourceShabadId": "11459",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122891",
      "sourceShabadId": "11460",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਲਵਲ ਕੋ ਰਾਜਾ ਰਹੈ ਸਰਬ ਸਿੰਘ ਤਿਹ ਨਾਮ ॥",
      "transliteration": "palaval ko raajaa rahai sarab si(n)gh teh naam ||",
      "translation": "",
      "punjabiViakhya": "ਸਰਬ ਸਿੰਘ ਨਾ ਦਾ ਪਲਵਲ ਦਾ ਇਕ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "पलवल को राजा रहै सरब सिंघ तिह नाम ॥",
      "sourceLineId": "122892",
      "sourceShabadId": "11460",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੇਸ ਦੇਸ ਕੇ ਏਸ ਜਿਹ ਭਜਤ ਆਠਹੂੰ ਜਾਮ ॥੧॥",
      "transliteration": "dhes dhes ke es jeh bhajat aaThahoo(n) jaam ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਦੇਸ ਦੇਸ ਦੇ ਰਾਜੇ ਅੱਠੇ ਪਹਿਰ ਯਾਦ ਕਰਦੇ ਰਹਿੰਦੇ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "देस देस के एस जिह भजत आठहूँ जाम ॥१॥",
      "sourceLineId": "122893",
      "sourceShabadId": "11460",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122894",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਲਾ ਸੁ ਬੀਰ ਤਾਹਿ ਬਰ ਨਾਰੀ ॥",
      "transliteration": "kalaa su beer taeh bar naaree ||",
      "translation": "",
      "punjabiViakhya": "ਬੀਰ ਕਲਾ ਉਸ ਦੀ ਸੁੰਦਰ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "कला सु बीर ताहि बर नारी ॥",
      "sourceLineId": "122895",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮਥਿ ਸਮੁੰਦ੍ਰ ਜਨੁ ਸਾਤ ਨਿਕਾਰੀ ॥",
      "transliteration": "math samu(n)dhr jan saat nikaaree ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸੱਤ ਸਮੁੰਦਰਾ ਨੂੰ ਮਥ ਕੇ ਕਢਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "मथि समुँद्र जनु सात निकारी ॥",
      "sourceLineId": "122896",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੋਬਨ ਜੋਤਿ ਅਧਿਕ ਤਿਹ ਸੋਹੈ ॥",
      "transliteration": "joban jot adhik teh sohai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਉਤੇ ਜੋਬਨ ਦਾ ਬਹੁਤ ਰੰਗ ਚੜ੍ਰਹਿਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "जोबन जोति अधिक तिह सोहै ॥",
      "sourceLineId": "122897",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੇਵ ਅਦੇਵਨ ਕੋ ਮਨ ਮੋਹੈ ॥੨॥",
      "transliteration": "dhev adhevan ko man mohai ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦੇਵਤਿਆਂ ਅਤੇ ਦੈਂਤਾ ਦਾ ਮਨ ਮੋਹੰਦੀ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "देव अदेवन को मन मोहै ॥२॥",
      "sourceLineId": "122898",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਾਵਤ ਸਿੰਘ ਬਿਲੌਕਤ ਭਈ ॥",
      "transliteration": "raavat si(n)gh bilauakat bhiee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਕ ਦਿਨ ਰਾਣੀ ਨੇ) ਰਾਵਤ ਸਿੰਘ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "रावत सिंघ बिलौकत भई ॥",
      "sourceLineId": "122899",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਰਿ ਅਰਿ ਬਸਿ ਰਾਨੀ ਹ੍ਵੈ ਗਈ ॥",
      "transliteration": "har ar bas raanee havai giee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਸ਼ਿਵ ਦੇ ਵੈਰੀ (ਕਾਮ ਦੇਵ) ਦੇ ਵਸ ਵਿਚ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "हरि अरि बसि रानी ह्वै गई ॥",
      "sourceLineId": "122900",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਹਚਰਿ ਪਠੈ ਬੁਲਾਯੋ ਜਬੈ ॥",
      "transliteration": "sahachar paThai bulaayo jabai ||",
      "translation": "",
      "punjabiViakhya": "ਦਾਸੀ ਨੂੰ ਭੇਜ ਕੇ ਜਦ ਉਸ ਨੂੰ ਬੁਲਾਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "सहचरि पठै बुलायो जबै ॥",
      "sourceLineId": "122901",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਾਮ ਕੇਲ ਤਾ ਸੌ ਕਿਯ ਤਬੈ ॥੩॥",
      "transliteration": "kaam kel taa sau kiy tabai ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "काम केल ता सौ किय तबै ॥३॥",
      "sourceLineId": "122902",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਐਸੀ ਭਾਤਿ ਜਾਰ ਨਿਤਿ ਆਵੈ ॥",
      "transliteration": "aaisee bhaat jaar nit aavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਉਹ ਯਾਰ ਰੋਜ਼ ਆਉਾਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "ऐसी भाति जार निति आवै ॥",
      "sourceLineId": "122903",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਵਾ ਰਾਨੀ ਸੌ ਭੋਗ ਕਮਾਵੈ ॥",
      "transliteration": "vaa raanee sau bhog kamaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਰਾਣੀ ਨਾਲ ਭੋਗ ਕਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "वा रानी सौ भोग कमावै ॥",
      "sourceLineId": "122904",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦਾਸੀ ਏਕ ਤਹਾ ਚਲਿ ਆਈ ॥",
      "transliteration": "dhaasee ek tahaa chal aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਦਾਸੀ ਚਲ ਕੇ ਆ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "दासी एक तहा चलि आई ॥",
      "sourceLineId": "122905",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਿਰਖਿ ਮੀਤ ਤਿਹ ਰਹ੍ਯੋ ਲੁਭਾਈ ॥੪॥",
      "transliteration": "nirakh meet teh rahayo lubhaiee ||4||",
      "translation": "",
      "punjabiViakhya": "ਯਾਰ ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਲੁਭਾਇਮਾਨ ਹੋ ਗਿਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "निरखि मीत तिह रह्यो लुभाई ॥४॥",
      "sourceLineId": "122906",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕੇਲ ਕਮਾਇ ਜਾਰ ਜਬ ਆਯੋ ॥",
      "transliteration": "kel kamai jaar jab aayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਯਾਰ ਕੇਲ-ਕ੍ਰੀੜਾ ਕਰ ਕੇ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "केल कमाइ जार जब आयो ॥",
      "sourceLineId": "122907",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚੇਰੀ ਕੋ ਲਖਿ ਰੂਪ ਲੁਭਾਯੋ ॥",
      "transliteration": "cheree ko lakh roop lubhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਦਾਸੀ ਦੇ ਰੂਪ ਨੂੰ ਵੇਖ ਕੇ ਲਲਚਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "चेरी को लखि रूप लुभायो ॥",
      "sourceLineId": "122908",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰਨਿਯਹਿ ਡਾਰਿ ਹ੍ਰਿਦੈ ਤੇ ਦਯੋ ॥",
      "transliteration": "raniyeh ddaar hiradhai te dhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਰਾਣੀ ਨੂੰ ਹਿਰਦੇ ਤੋਂ ਭੁਲਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "रनियहि डारि हृदै ते दयो ॥",
      "sourceLineId": "122909",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਾ ਕੀ ਸੇਜ ਸੁਹਾਵਤ ਭਯੋ ॥੫॥",
      "transliteration": "taa kee sej suhaavat bhayo ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦਾਸੀ ਦੀ ਸੇਜ ਨੂੰ ਸੁਹਾਵਣਾ ਬਣਾਉਣ ਲਗਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "ता की सेज सुहावत भयो ॥५॥",
      "sourceLineId": "122910",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕੇਲ ਬਿਨਾ ਰਾਨੀ ਅਕੁਲਾਈ ॥",
      "transliteration": "kel binaa raanee akulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮ-ਕ੍ਰੀੜਾ ਤੋਂ ਬਿਨਾ ਰਾਣੀ ਵਿਆਕੁਲ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "केल बिना रानी अकुलाई ॥",
      "sourceLineId": "122911",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਾ ਕੌ ਪੈਂਡ ਬਿਲੋਕਨ ਆਈ ॥",
      "transliteration": "taa kau pai(n)dd bilokan aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਰਸਤਾ ਵੇਖਣ ਲਈ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "ता कौ पैंड बिलोकन आई ॥",
      "sourceLineId": "122912",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਹਾ ਰਹੇ ਪ੍ਰੀਤਮ ਨਹਿ ਆਏ ॥",
      "transliteration": "kahaa rahe preetam neh aae ||",
      "translation": "",
      "punjabiViakhya": "(ਸੋਚੀਂ ਪਈ ਸੀ ਕਿ) ਪ੍ਰੀਤਮ ਆਏ ਨਹੀਂ, ਕਿਥੇ ਰਹਿ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "कहा रहे प्रीतम नहि आए ॥",
      "sourceLineId": "122913",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਾਹੂ ਬੈਰਿਨਿ ਸੌ ਉਰਝਾਏ ॥੬॥",
      "transliteration": "kaahoo bairin sau urajhaae ||6||",
      "translation": "",
      "punjabiViakhya": "(ਸ਼ਾਇਦ) ਕਿਸੇ ਵੈਰਨ ਨਾਲ ਉਲਝ ਗਏ ਹੋਣ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "काहू बैरिनि सौ उरझाए ॥६॥",
      "sourceLineId": "122914",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੁਧਿ ਭੂਲੀ ਕਿਧੋ ਕਿਨੂੰ ਭੁਲਾਯੋ ॥",
      "transliteration": "sudh bhoolee kidho kinoo(n) bhulaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਯਾਦ ਨਹੀਂ ਰਿਹਾ ਜਾ ਕਿਸੇ ਨੇ ਭੁਲਾ ਦਿੱਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "सुधि भूली किधो किनूँ भुलायो ॥",
      "sourceLineId": "122915",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਖੋਜਤ ਰਹਿਯੋ ਪੈਂਡ ਨਹਿ ਪਾਯੋ ॥",
      "transliteration": "khojat rahiyo pai(n)dd neh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਖੋਜਦਾ ਰਿਹਾ ਹੈ, ਪਰ ਰਸਤਾ ਨਹੀਂ ਲਭਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "खोजत रहियो पैंड नहि पायो ॥",
      "sourceLineId": "122916",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤ੍ਰਾਸ ਦਿਯੋ ਕਿਨਹੂੰ ਤਿਹ ਆਈ ॥",
      "transliteration": "traas dhiyo kinahoo(n) teh aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਕਿਸੇ ਨੇ ਆ ਕੇ ਡਰਾਵਾ ਤਾ ਨਹੀਂ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "त्रास दियो किनहूँ तिह आई ॥",
      "sourceLineId": "122917",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭੇਟ ਭਈ ਕੋਊ ਭਾਮਿਨਿ ਭਾਈ ॥੭॥",
      "transliteration": "bheT bhiee kouoo bhaamin bhaiee ||7||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਕੋਈ ਚੰਗੀ ਲਗਣ ਵਾਲੀ ਇਸਤਰੀ ਤਾ ਨਹੀਂ ਮਿਲ ਗਈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "भेट भई कोऊ भामिनि भाई ॥७॥",
      "sourceLineId": "122918",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਆਵਤ ਹੈ ਕਿ ਆਇ ਕਰ ਗਏ ॥",
      "transliteration": "aavat hai k aai kar ge ||",
      "translation": "",
      "punjabiViakhya": "ਕੀ ਉਹ ਆ ਰਿਹਾ ਹੈ ਜਾ ਆ ਕੇ ਚਲਾ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "आवत है कि आइ कर गए ॥",
      "sourceLineId": "122919",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਆਵਹਿਗੇ ਕਿ ਰੂਠ ਕੇ ਗਏ ॥",
      "transliteration": "aavahige k rooTh ke ge ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਆਵੇਗਾ ਜਾ ਰੁਸ ਕੇ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "आवहिगे कि रूठ के गए ॥",
      "sourceLineId": "122920",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਿਲਿ ਹੈ ਯਾਰ ਆਇ ਸੁਖਦਾਈ ॥",
      "transliteration": "mil hai yaar aai sukhadhaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਨੂੰ) ਸੁਖਦਾਈ ਯਾਰ ਆ ਕੇ ਆਵੱਸ਼ ਮਿਲੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "मिलि है यार आइ सुखदाई ॥",
      "sourceLineId": "122921",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਡੀ ਬਾਰ ਲਗਿ ਬਾਰ ਲਗਾਈ ॥੮॥",
      "transliteration": "baddee baar lag baar lagaiee ||8||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ ਸੋਚਦੀ ਹੋਈ) ਉਹ ਬਹੁਤ ਦੇਰ ਤਕ ਦਰਵਾਜ਼ੇ ਵਲ ਵੇਖਦੀ ਰਹੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "बडी बार लगि बार लगाई ॥८॥",
      "sourceLineId": "122922",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਯੌ ਚਿਤ ਚਿੰਤ ਤਹਾ ਪਗੁ ਧਾਰਿਯੋ ॥",
      "transliteration": "yau chit chi(n)t tahaa pag dhaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਮਨ ਵਿਚ ਸੋਚਦਿਆਂ ਉਸ ਨੇ ਅਗੇ ਪੈਰ ਵਧਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "यौ चित चिंत तहा पगु धारियो ॥",
      "sourceLineId": "122923",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮੀਤ ਚੇਰਿਯਹਿ ਰਮਤ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "meet cheriyeh ramat nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਿਤਰ ਨੂੰ ਦਾਸੀ ਨਾਲ ਰਮਣ ਕਰਦਿਆਂ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "मीत चेरियहि रमत निहारियो ॥",
      "sourceLineId": "122924",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਿਰ ਪਗ ਲਗੇ ਕੋਪ ਤਬ ਭਈ ॥",
      "transliteration": "sir pag lage kop tab bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸਿਰ ਤੋਂ ਪੈਰਾ ਤਕ ਕ੍ਰੋਧ ਨਾਲ ਭਰ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "सिर पग लगे कोप तब भई ॥",
      "sourceLineId": "122925",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਾਹਿ ਖਬਰਿ ਰਾਜ ਤਨ ਦਈ ॥੯॥",
      "transliteration": "jaeh khabar raaj tan dhiee ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਾ ਕੇ ਰਾਜੇ ਨੂੰ ਖ਼ਬਰ ਕੀਤੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "जाहि खबरि राज तन दई ॥९॥",
      "sourceLineId": "122926",
      "sourceShabadId": "11461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122927",
      "sourceShabadId": "11462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਘਰ ਖੋਏ ਬੈਠਿਯੋ ਕਹਾ ਪਰੀ ਧਾਮ ਤਵ ਧਾਰ ॥",
      "transliteration": "ghar khoe baiThiyo kahaa paree dhaam tav dhaar ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗੀ, ਹੇ ਰਾਜਨ!) ਘਰ ਖੋਹਾ ਕੇ ਕਿਥੇ ਬੈਠੇ ਹੋ, ਤੁਹਾਡੇ ਘਰ ਵਿਚ ਧਾੜ ਪੈ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "घर खोए बैठियो कहा परी धाम तव धार ॥",
      "sourceLineId": "122928",
      "sourceShabadId": "11462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਖੜਗ ਹਾਥ ਗਹਿ ਦੇਖ ਚਲ ਆਂਖੈ ਦੋਊ ਪਸਾਰਿ ॥੧੦॥",
      "transliteration": "khaRag haath geh dhekh chal aa(n)khai dhouoo pasaar ||10||",
      "translation": "",
      "punjabiViakhya": "ਹੱਥ ਵਿਚ ਤਲਵਾਰ ਪਕੜ ਕੇ ਖ਼ੁਦ ਅੱਖਾ ਖੋਲ ਕੇ ਵੇਖੋ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "खड़ग हाथ गहि देख चल आँखै दोऊ पसारि ॥१०॥",
      "sourceLineId": "122929",
      "sourceShabadId": "11462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਬ ਰਾਜਾ ਚੇਰੀ ਭਏ ਤਾ ਕੌ ਰਮਤ ਨਿਹਾਰਿ ॥",
      "transliteration": "tab raajaa cheree bhe taa kau ramat nihaar ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜੇ ਨੇ ਦਾਸੀ (ਅਤੇ ਉਸ ਵਿਅਕਤੀ) ਨੂੰ ਰਮਣ ਕਰਦਿਆਂ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "तब राजा चेरी भए ता कौ रमत निहारि ॥",
      "sourceLineId": "122930",
      "sourceShabadId": "11462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦੁਹੂੰਅਨ ਕੌ ਮਾਰਤ ਭਯੋ ਸਕਿਯੋ ਨ ਮੂੜ ਬਿਚਾਰਿ ॥੧੧॥",
      "transliteration": "dhuhoo(n)an kau maarat bhayo sakiyo na mooR bichaar ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਹਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ, ਪਰ ਮੂਰਖ ਭੇਦ ਨੂੰ ਸਮਝ ਨਾ ਸਕਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "दुहूँअन कौ मारत भयो सकियो न मूड़ बिचारि ॥११॥",
      "sourceLineId": "122931",
      "sourceShabadId": "11462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਕੈ ਚੰਚਲਾ ਰਾਜਾ ਸੌ ਛਲ ਕੀਨ ॥",
      "transliteration": "eeh charitr kai cha(n)chalaa raajaa sau chhal keen ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਚਰਿਤ੍ਰ ਨਾਲ ਇਸਤਰੀ ਨੇ ਰਾਜੇ ਨੂੰ ਛਲ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र कै चंचला राजा सौ छल कीन ॥",
      "sourceLineId": "122932",
      "sourceShabadId": "11462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਾਰ ਤਵਨ ਚੇਰੀ ਸਹਿਤ ਪਠੈ ਧਾਮ ਜਮ ਦੀਨ ॥੧੨॥",
      "transliteration": "jaar tavan cheree sahit paThai dhaam jam dheen ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਯਾਰ ਨੂੰ ਦਾਸੀ ਸਮੇਤ ਯਮਲੋਕ ਭੇਜ ਦਿੱਤਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "जार तवन चेरी सहित पठै धाम जम दीन ॥१२॥",
      "sourceLineId": "122933",
      "sourceShabadId": "11462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਸਤਰਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੭੦॥੩੩੫੫॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau sataravo charitr samaapatam sat subham sat ||170||3355||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੭੦ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੭੦॥੩੩੫੫॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ सतरवो चरित्र समापतम सतु सुभम सतु ॥१७०॥३३५५॥अफजूँ॥",
      "sourceLineId": "122934",
      "sourceShabadId": "11462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1056_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1056,
      "hindi": "",
