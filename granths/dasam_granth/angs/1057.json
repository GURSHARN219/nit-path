{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1057,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1057_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਾਹਿ ਜਾਰਨੀ ਨਾਥ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "taeh jaaranee naath bichaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਯਾਰਨੀ (ਵਿਭਚਾਰਨ) ਇਸਤਰੀ ਦੇ ਪਤੀ ਨੇ ਵਿਚਾਰ ਪੂਰਵਕ",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "ताहि जारनी नाथ बिचारियो ॥",
      "sourceLineId": "122939",
      "sourceShabadId": "11464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਇਹ ਭਾਤਿ ਉਚਾਰਿਯੋ ॥",
      "transliteration": "ek dhivas ieh bhaat uchaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "एक दिवस इह भाति उचारियो ॥",
      "sourceLineId": "122940",
      "sourceShabadId": "11464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੇਸ ਛੋਰਿ ਪਰਦੇਸ ਸਿਧੈਹੌ ॥",
      "transliteration": "dhes chhor paradhes sidhaihau ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਦੇਸ ਛੋੜ ਕੇ ਵਿਦੇਸ ਜਾ ਰਿਹਾ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "देस छोरि परदेस सिधैहौ ॥",
      "sourceLineId": "122941",
      "sourceShabadId": "11464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਧਿਕ ਕਮਾਇ ਤੁਮੈ ਧਨ ਲ੍ਯੈਹੌ ॥੨॥",
      "transliteration": "adhik kamai tumai dhan layaihau ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੈਨੂੰ ਬਹੁਤ ਸਾਰਾ ਧਨ ਕਮਾ ਕੇ ਲਿਆ ਦੇਵਾਗਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "अधिक कमाइ तुमै धन ल्यैहौ ॥२॥",
      "sourceLineId": "122942",
      "sourceShabadId": "11464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਾਤ ਭਯੋ ਐਸੋ ਬਚ ਕਹਿਯੋ ॥",
      "transliteration": "jaat bhayo aaiso bach kahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਗੱਲ ਕਹਿ ਕੇ ਉਹ ਚਲਾ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "जात भयो ऐसो बच कहियो ॥",
      "sourceLineId": "122943",
      "sourceShabadId": "11464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਲਾਗਿ ਧਾਮ ਕੋਨੇ ਸੌ ਰਹਿਯੋ ॥",
      "transliteration": "laag dhaam kone sau rahiyo ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ ਅਸਲੋਂ) ਘਰ ਦੇ ਕੋਨੇ ਨਾਲ ਲਗ ਕੇ ਖੜੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "लागि धाम कोने सौ रहियो ॥",
      "sourceLineId": "122944",
      "sourceShabadId": "11464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਾਹਿਬ ਦੇ ਤਬ ਜਾਰ ਬੁਲਾਯੋ ॥",
      "transliteration": "saahib dhe tab jaar bulaayo ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਹਿਬ ਦੇਈ ਨੇ ਤਦ ਯਾਰ ਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "साहिब दे तब जार बुलायो ॥",
      "sourceLineId": "122945",
      "sourceShabadId": "11464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਿਹ ਸਾਥ ਕਮਾਯੋ ॥੩॥",
      "transliteration": "kaam bhog teh saath kamaayo ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਕਾਮ ਕੇਲ ਕੀਤੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "काम भोग तिह साथ कमायो ॥३॥",
      "sourceLineId": "122946",
      "sourceShabadId": "11464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗ੍ਰਿਹ ਕੋਨਾ ਸੌ ਪਤਿਹ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "gireh konaa sau pateh nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ ਉਸ ਇਸਤਰੀ ਨੇ) ਘਰ ਦੇ ਕੋਨੇ ਵਿਚ (ਖੜੋਤੇ) ਪਤੀ ਨੂੰ ਵੇਖ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "गृह कोना सौ पतिह निहारियो ॥",
      "sourceLineId": "122947",
      "sourceShabadId": "11464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਹੈ ਚੰਚਲਾ ਚਰਿਤ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "eihai cha(n)chalaa charit bichaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਇਸਤਰੀ ਨੇ ਇਹ ਚਰਿਤ੍ਰ ਖੇਡਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "इहै चंचला चरित बिचारियो ॥",
      "sourceLineId": "122948",
      "sourceShabadId": "11464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਲਪਟਿ ਲਪਟਿ ਆਸਨ ਸੌ ਜਾਵੈ ॥",
      "transliteration": "lapaT lapaT aasan sau jaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਯਾਰ ਨਾਲ ਲਿਪਟ ਲਿਪਟ ਕੇ ਆਸਣ ਕਰਦੀ ਰਹੀ",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "लपटि लपटि आसन सौ जावै ॥",
      "sourceLineId": "122949",
      "sourceShabadId": "11464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕੂਕਿ ਕੂਕਿ ਇਹ ਭਾਤਿ ਸੁਨਾਵੈ ॥੪॥",
      "transliteration": "kook kook ieh bhaat sunaavai ||4||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ ਪਤੀ ਨੂੰ) ਚੀਖ਼ ਚੀਖ਼ ਕੇ ਸੁਣਾਉਣ ਲਗੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "कूकि कूकि इह भाति सुनावै ॥४॥",
      "sourceLineId": "122950",
      "sourceShabadId": "11464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੋ ਪਤਿ ਹੋਤ ਆਜੁ ਘਰ ਮਾਹੀ ॥",
      "transliteration": "jo pat hot aaj ghar maahee ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਅਜ ਮੇਰਾ ਪਤੀ ਘਰ ਵਿਚ ਹੁੰਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "जो पति होत आजु घर माही ॥",
      "sourceLineId": "122951",
      "sourceShabadId": "11464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕ੍ਯੋ ਹੇਰਤ ਤੈ ਮਮ ਪਰਛਾਹੀ ॥",
      "transliteration": "kayo herat tai mam parachhaahee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਕਿਵੇਾਂ ਵੀ ਤੂੰ ਮੇਰੀ ਪਰਛਾਈ ਨਾ ਵੇਖ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "क्यो हेरत तै मम परछाही ॥",
      "sourceLineId": "122952",
      "sourceShabadId": "11464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪ੍ਰੀਤਮ ਨਹੀ ਆਜੁ ਹ੍ਯਾਂ ਮੇਰੋ ॥",
      "transliteration": "preetam nahee aaj hayaa(n) mero ||",
      "translation": "",
      "punjabiViakhya": "ਅਜ ਮੇਰਾ ਪ੍ਰੀਤਮ (ਪਤੀ) ਇਥੇ ਨਹੀਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "प्रीतम नही आजु ह्याँ मेरो ॥",
      "sourceLineId": "122953",
      "sourceShabadId": "11464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਬ ਹੀ ਸੀਸ ਫੋਰਤੋ ਤੇਰੋ ॥੫॥",
      "transliteration": "ab hee sees forato tero ||5||",
      "translation": "",
      "punjabiViakhya": "(ਨਹੀਂ ਤਾ) ਹੁਣੇ ਹੀ ਤੇਰਾ ਸਿਰ ਪਾੜ ਦਿੰਦਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "अब ही सीस फोरतो तेरो ॥५॥",
      "sourceLineId": "122954",
      "sourceShabadId": "11464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122955",
      "sourceShabadId": "11465",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਤਿ ਰਤਿ ਤਾ ਸੋ ਮਾਨਿ ਕੈ ਦੀਨੋ ਜਾਰ ਉਠਾਇ ॥",
      "transliteration": "at rat taa so maan kai dheeno jaar uThai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਬਹੁਤ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰ ਕੇ ਯਾਰ ਨੂੰ ਉਠਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "अति रति ता सो मानि कै दीनो जार उठाइ ॥",
      "sourceLineId": "122956",
      "sourceShabadId": "11465",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਆਪੁ ਅਧਿਕ ਪੀਟਤ ਭਈ ਹ੍ਰਿਦੈ ਸੋਕ ਉਪਜਾਇ ॥੬॥",
      "transliteration": "aap adhik peeTat bhiee hiradhai sok upajai ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪ ਦਿਲ ਵਿਚ ਦੁਖ ਮੰਨਾ ਕੇ ਪਿਟਣ ਲਗ ਗਈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "आपु अधिक पीटत भई हृदै सोक उपजाइ ॥६॥",
      "sourceLineId": "122957",
      "sourceShabadId": "11465",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122958",
      "sourceShabadId": "11466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮੇਰੋ ਆਜੁ ਧਰਮੁ ਇਨ ਖੋਯੋ ॥",
      "transliteration": "mero aaj dharam in khoyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨੇ ਅਜ ਮੇਰਾ ਧਰਮ ਨਸ਼ਟ ਕਰ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "मेरो आजु धरमु इन खोयो ॥",
      "sourceLineId": "122959",
      "sourceShabadId": "11466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪ੍ਰਾਨਨਾਥ ਗ੍ਰਿਹ ਮਾਝ ਨ ਹੋਯੋ ॥",
      "transliteration": "praananaath gireh maajh na hoyo ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰਾ ਪ੍ਰਾਣਨਾਥ ਘਰ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "प्राननाथ गृह माझ न होयो ॥",
      "sourceLineId": "122960",
      "sourceShabadId": "11466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਬ ਹੌ ਟੂਟਿ ਮਹਲ ਤੇ ਪਰਿਹੌ ॥",
      "transliteration": "ab hau TooT mahal te parihau ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਜਾ ਤਾ ਮਕਾਨ ਤੋਂ ਡਿਗ ਕੇ ਮਰ ਜਾਵਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "अब हौ टूटि महल ते परिहौ ॥",
      "sourceLineId": "122961",
      "sourceShabadId": "11466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾਤਰ ਮਾਰਿ ਕਟਾਰੀ ਮਰਿਹੌ ॥੭॥",
      "transliteration": "naatar maar kaTaaree marihau ||7||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਕਟਾਰ ਮਾਰ ਕੇ ਮਰ ਜਾਵਾਗੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "नातर मारि कटारी मरिहौ ॥७॥",
      "sourceLineId": "122962",
      "sourceShabadId": "11466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕੈਧੋ ਅੰਗ ਅਗਨਿ ਮੈ ਜਾਰੋ ॥",
      "transliteration": "kaidho a(n)g agan mai jaaro ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਤਾ ਮੈਂ ਸ਼ਰੀਰ ਅਗਨੀ ਵਿਚ ਸਾੜ ਦੇਵਾਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "कैधो अंग अगनि मै जारो ॥",
      "sourceLineId": "122963",
      "sourceShabadId": "11466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕੈਧੋ ਪਿਯ ਪੈ ਜਾਇ ਪੁਕਾਰੋ ॥",
      "transliteration": "kaidho piy pai jai pukaaro ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਪ੍ਰੀਤਮ ਕੋਲ ਜਾ ਕੇ ਪੁਕਾਰ ਕਰਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "कैधो पिय पै जाइ पुकारो ॥",
      "sourceLineId": "122964",
      "sourceShabadId": "11466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੋਰਾਵਰੀ ਜਾਰ ਭਜ ਗਯੋ ॥",
      "transliteration": "joraavaree jaar bhaj gayo ||",
      "translation": "",
      "punjabiViakhya": "ਜ਼ਬਰਦਸਤੀ ਕਰ ਕੇ ਯਾਰ ਰਮਣ ਕਰ ਗਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "जोरावरी जार भज गयो ॥",
      "sourceLineId": "122965",
      "sourceShabadId": "11466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮੋਰੋ ਧਰਮ ਲੋਪ ਸਭ ਭਯੋ ॥੮॥",
      "transliteration": "moro dharam lop sabh bhayo ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰਾ ਸਾਰਾ ਧਰਮ ਭ੍ਰਸ਼ਟ ਕਰ ਗਿਆ ਹੈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "मोरो धरम लोप सभ भयो ॥८॥",
      "sourceLineId": "122966",
      "sourceShabadId": "11466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122967",
      "sourceShabadId": "11467",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਯੌ ਕਹਿ ਕੈ ਮੁਖ ਤੇ ਬਚਨ ਜਮਧਰ ਲਈ ਉਠਾਇ ॥",
      "transliteration": "yau keh kai mukh te bachan jamadhar liee uThai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਮੁਖ ਤੋਂ ਬਚਨ ਕਹਿ ਕੇ ਕਟਾਰ ਉਠਾ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "यौ कहि कै मुख ते बचन जमधर लई उठाइ ॥",
      "sourceLineId": "122968",
      "sourceShabadId": "11467",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਉਦਰ ਬਿਖੈ ਮਾਰਨ ਲਗੀ ਨਿਜੁ ਪਤਿ ਕੋ ਦਿਖਰਾਇ ॥੯॥",
      "transliteration": "audhar bikhai maaran lagee nij pat ko dhikharai ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਪਤੀ ਨੂੰ ਵਿਖਾ ਕੇ ਪੇਟ ਵਿਚ ਮਾਰਨ ਲਗੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "उदर बिखै मारन लगी निजु पति को दिखराइ ॥९॥",
      "sourceLineId": "122969",
      "sourceShabadId": "11467",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122970",
      "sourceShabadId": "11468",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਐਸੇ ਨਿਰਖਿ ਤਵਨ ਪਤਿ ਧਯੋ ॥",
      "transliteration": "aaise nirakh tavan pat dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਵੇਖ ਕੇ ਉਸ ਦਾ ਪਤੀ ਭਜਿਆ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "ऐसे निरखि तवन पति धयो ॥",
      "sourceLineId": "122971",
      "sourceShabadId": "11468",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਮਧਰ ਛੀਨ ਹਾਥ ਤੇ ਲਯੋ ॥",
      "transliteration": "jamadhar chheen haath te layo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਦੇ) ਹੱਥ ਵਿਚੋਂ ਕਟਾਰ ਖੋਹ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "जमधर छीन हाथ ते लयो ॥",
      "sourceLineId": "122972",
      "sourceShabadId": "11468",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪ੍ਰਥਮ ਘਾਇ ਤੁਮ ਹਮੈ ਪ੍ਰਹਾਰੋ ॥",
      "transliteration": "pratham ghai tum hamai prahaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗਿਆ) ਪਹਿਲਾ ਤੂੰ ਮੈਨੂੰ (ਕਟਾਰ) ਮਾਰ",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "प्रथम घाइ तुम हमै प्रहारो ॥",
      "sourceLineId": "122973",
      "sourceShabadId": "11468",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਅਪਨੇ ਉਰ ਮਾਰੋ ॥੧੦॥",
      "transliteration": "taa paachhe apane ur maaro ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਪਿਛੋਂ ਆਪਣੇ ਹਿਰਦੇ ਵਿਚ ਮਾਰੀਂ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "ता पाछे अपने उर मारो ॥१०॥",
      "sourceLineId": "122974",
      "sourceShabadId": "11468",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤੇਰੌ ਧਰਮ ਲੋਪ ਨਹਿੰ ਭਯੋ ॥",
      "transliteration": "terau dharam lop nahi(n) bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਰਾ ਧਰਮ ਭ੍ਰਸ਼ਟ ਨਹੀਂ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "तेरौ धरम लोप नहिं भयो ॥",
      "sourceLineId": "122975",
      "sourceShabadId": "11468",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੋਰਾਵਰੀ ਜਾਰ ਭਜਿ ਗਯੋ ॥",
      "transliteration": "joraavaree jaar bhaj gayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਯਾਰ ਜ਼ਬਰਦਸਤੀ ਰਮਣ ਕਰ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "जोरावरी जार भजि गयो ॥",
      "sourceLineId": "122976",
      "sourceShabadId": "11468",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦਸਸਿਰ ਬਲ ਸੌ ਸਿਯ ਹਰਿ ਲੀਨੀ ॥",
      "transliteration": "dhasasir bal sau siy har leenee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਵਣ ਨੇ ਬਲ ਪੂਰਵਕ ਸੀਤਾ ਨੂੰ ਹਰ ਲਿਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "दससिर बल सौ सिय हरि लीनी ॥",
      "sourceLineId": "122977",
      "sourceShabadId": "11468",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸ੍ਰੀ ਰਘੁਨਾਥ ਤ੍ਯਾਗ ਨਹਿ ਦੀਨੀ ॥੧੧॥",
      "transliteration": "sree raghunaath tayaag neh dheenee ||11||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸ੍ਰੀ ਰਘੂਨਾਥ ਨੇ (ਸੀਤਾ ਨੂੰ) ਛਡ ਥੋੜਾ ਦਿੱਤਾ ਸੀ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "स्री रघुनाथ त्याग नहि दीनी ॥११॥",
      "sourceLineId": "122978",
      "sourceShabadId": "11468",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122979",
      "sourceShabadId": "11469",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੁਨੁ ਅਬਲਾ ਮੈ ਆਪਨੇ ਕਰਤ ਨ ਹਿਯ ਮੈ ਰੋਸੁ ॥",
      "transliteration": "sun abalaa mai aapane karat na hiy mai ros ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਇਸਤਰੀ! ਮੇਰੀ ਗੱਲ ਸੁਣ, (ਤੂੰ) ਆਪਣੇ ਚਿਤ ਵਿਚ (ਕਿਸੇ ਪ੍ਰਕਾਰ ਦਾ) ਰੋਸ ਨਾ ਕਰ।",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "सुनु अबला मै आपने करत न हिय मै रोसु ॥",
      "sourceLineId": "122980",
      "sourceShabadId": "11469",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਾਰ ਜੋਰ ਭਜਿ ਭਜ ਗਯੋ ਤੇਰੋ ਕਛੂ ਨ ਦੋਸ ॥੧੨॥",
      "transliteration": "jaar jor bhaj bhaj gayo tero kachhoo na dhos ||12||",
      "translation": "",
      "punjabiViakhya": "ਯਾਰ ਜਬਰ ਨਾਲ ਭੋਗ ਕਰ ਕੇ ਭਜ ਗਿਆ ਹੈ, ਇਸ ਵਿਚ ਤੇਰਾ ਕੋਈ ਦੋਸ਼ ਨਹੀਂ ਹੈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "जार जोर भजि भज गयो तेरो कछू न दोस ॥१२॥",
      "sourceLineId": "122981",
      "sourceShabadId": "11469",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਇਕਹਤਰੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੭੧॥੩੩੬੭॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau ikahataro charitr samaapatam sat subham sat ||171||3367||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੭੧ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੭੧॥੩੩੬੭॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ इकहतरो चरित्र समापतम सतु सुभम सतु ॥१७१॥३३६७॥अफजूँ॥",
      "sourceLineId": "122982",
      "sourceShabadId": "11469",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122983",
      "sourceShabadId": "11470",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਐਂਡੇ ਰਾਇਕ ਭਾਟ ਭਣਿਜੈ ॥",
      "transliteration": "aai(n)dde raik bhaaT bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਐਂਡੇ ਰਾਇ ਨਾ ਦਾ ਇਕ ਭਾਟ ਸੁਣੀਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "ऐंडे राइक भाट भणिजै ॥",
      "sourceLineId": "122984",
      "sourceShabadId": "11470",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗੀਤ ਕਲਾ ਤਿਹ ਤ੍ਰਿਯਾ ਕਹਿਜੈ ॥",
      "transliteration": "geet kalaa teh tirayaa kahijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਇਸਤਰੀ ਦਾ ਨਾ ਗੀਤ ਕਲਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "गीत कला तिह तृया कहिजै ॥",
      "sourceLineId": "122985",
      "sourceShabadId": "11470",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1057_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬੀਰਮ ਦੇ ਤਿਨ ਬੀਰ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "beeram dhe tin beer nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਨੇ ਬੀਰਮ ਦੇਵ ਨਾ ਦੇ ਸੂਰਮੇ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1057,
      "hindi": "",
      "hindiTransliteration": "बीरम दे तिन बीर निहारियो ॥",
      "sourceLineId": "122986",
      "sourceShabadId": "11470",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
