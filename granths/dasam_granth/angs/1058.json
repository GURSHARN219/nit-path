{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1058,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1058_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਬੈ ਚਿਤ ਤੇ ਭਾਟ ਬਿਸਾਰਿਯੋ ॥੧॥",
      "transliteration": "tabai chit te bhaaT bisaariyo ||1||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਚਿਤ ਤੋਂ ਭਾਟ ਨੂੰ ਵਿਸਾਰ ਦਿੱਤਾ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "तबै चित ते भाट बिसारियो ॥१॥",
      "sourceLineId": "122987",
      "sourceShabadId": "11470",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਾਰ ਬਾਚ ॥",
      "transliteration": "jaar baach ||",
      "translation": "",
      "punjabiViakhya": "ਯਾਰ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "जार बाच ॥",
      "sourceLineId": "122988",
      "sourceShabadId": "11471",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122989",
      "sourceShabadId": "11471",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਾਧਿ ਖਾਟੁ ਤਰ ਨਿਜੁ ਪਤਿਹਿ ਹਮ ਸੌ ਭੋਗ ਕਮਾਇ ॥",
      "transliteration": "baadh khaaT tar nij pateh ham sau bhog kamai ||",
      "translation": "",
      "punjabiViakhya": "(ਜੇ ਤੂੰ) ਆਪਣੇ ਪਤੀ ਨੂੰ ਮੰਜੀ ਹੇਠਾ ਬੰਨ੍ਰਹ ਕੇ ਮੇਰੇ ਨਾਲ ਕੇਲ ਕਰੇਾਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "बाधि खाटु तर निजु पतिहि हम सौ भोग कमाइ ॥",
      "sourceLineId": "122990",
      "sourceShabadId": "11471",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤੌ ਮੈ ਜਾਨੌ ਸਾਚੁ ਤੂ ਹਿਤੂ ਹਮਾਰੀ ਆਇ ॥੨॥",
      "transliteration": "tau mai jaanau saach too hitoo hamaaree aai ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮੈਂ ਜਾਣਾਗਾ ਕਿ ਤੂੰ ਸਚਮੁਚ ਮੇਰੀ ਹਿਤੂ ਹੈਂ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "तौ मै जानौ साचु तू हितू हमारी आइ ॥२॥",
      "sourceLineId": "122991",
      "sourceShabadId": "11471",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "122992",
      "sourceShabadId": "11472",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਐਂਡੇ ਰਾਇ ਏਕ ਦਿਨ ਆਯੋ ॥",
      "transliteration": "aai(n)dde rai ek dhin aayo ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਇਕ ਦਿਨ ਐਂਡੇ ਰਾਇ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "ऐंडे राइ एक दिन आयो ॥",
      "sourceLineId": "122993",
      "sourceShabadId": "11472",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੁਖਿਤ ਨਾਰਿ ਹ੍ਵੈ ਬਚਨ ਸੁਨਾਯੋ ॥",
      "transliteration": "dhukhit naar havai bachan sunaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਉਸ ਦੀ) ਇਸਤਰੀ ਨੇ ਦੁਖੀ ਹੋ ਕੇ ਬਚਨ ਸੁਣਾਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "दुखित नारि ह्वै बचन सुनायो ॥",
      "sourceLineId": "122994",
      "sourceShabadId": "11472",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤੁਮ ਕੌ ਰੋਗ ਨਾਥ ਇਕ ਭਾਰੋ ॥",
      "transliteration": "tum kau rog naath ik bhaaro ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਨਾਥ! ਤੈਨੂੰ ਇਕ ਵੱਡਾ ਰੋਗ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "तुम कौ रोग नाथ इक भारो ॥",
      "sourceLineId": "122995",
      "sourceShabadId": "11472",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਾ ਤੇ ਖੀਝਤ ਚਿਤ ਹਮਾਰੋ ॥੩॥",
      "transliteration": "taa te kheejhat chit hamaaro ||3||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਕਰ ਕੇ ਮੇਰਾ ਚਿਤ ਬਹੁਤ ਖਿਝਦਾ ਹੈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "ता ते खीझत चित हमारो ॥३॥",
      "sourceLineId": "122996",
      "sourceShabadId": "11472",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "122997",
      "sourceShabadId": "11473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਏਕ ਬੈਦ ਮੈ ਤਵ ਨਿਮਿਤ ਰਾਖ੍ਯੋ ਧਾਮ ਬੁਲਾਇ ॥",
      "transliteration": "ek baidh mai tav nimit raakhayo dhaam bulai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਵੈਦ ਮੈਂ ਤੇਰੇ ਲਈ ਬੁਲਾ ਕੇ ਘਰ ਵਿਚ ਰਖਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "एक बैद मै तव निमित राख्यो धाम बुलाइ ॥",
      "sourceLineId": "122998",
      "sourceShabadId": "11473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਾ ਤੇ ਤੁਰਤ ਕਰਾਇਯੈ ਅਪਨ ਇਲਾਜ ਬਨਾਇ ॥੪॥",
      "transliteration": "taa te turat karaiyai apan ilaaj banai ||4||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਉਸ ਤੋਂ ਤੁਸੀਂ ਤੁਰਤ ਆਪਣਾ ਇਲਾਜ ਕਰਵਾ ਲਵੋ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "ता ते तुरत कराइयै अपन इलाज बनाइ ॥४॥",
      "sourceLineId": "122999",
      "sourceShabadId": "11473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123000",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਐਂਡੇ ਰਾਇ ਤਬੈ ਯੌ ਕਯੋ ॥",
      "transliteration": "aai(n)dde rai tabai yau kayo ||",
      "translation": "",
      "punjabiViakhya": "ਐਂਡੇ ਰਾਇ ਨੇ ਤਦ ਹੀ ਇਉਾਂ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "ऐंडे राइ तबै यौ कयो ॥",
      "sourceLineId": "123001",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬੀਰਮ ਦੇਵ ਬੋਲਿ ਕਰਿ ਲਯੋ ॥",
      "transliteration": "beeram dhev bol kar layo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬੀਰਮ ਦੇਵ ਨੂੰ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "बीरम देव बोलि करि लयो ॥",
      "sourceLineId": "123002",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਯਾ ਗਦ ਕੌ ਗਦਹਾ ਕ੍ਯਾ ਕਰਿਯੈ ॥",
      "transliteration": "yaa gadh kau gadhahaa kayaa kariyai ||",
      "translation": "",
      "punjabiViakhya": "(ਹੇ ਵੈਦ ਜੀ!) ਇਸ ਰੋਗ ('ਗਦ') ਦਾ ਕੀ ਇਲਾਜ ਕਰੀਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "या गद कौ गदहा क्या करियै ॥",
      "sourceLineId": "123003",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਾ ਤੇ ਰੋਗ ਬਡੋ ਪਰਹਰਿਯੈ ॥੫॥",
      "transliteration": "jaa te rog baddo parahariyai ||5||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤੋਂ ਵੱਡਾ ਰੋਗ ਨਸ਼ਟ ਹੋ ਜਾਏ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "जा ते रोग बडो परहरियै ॥५॥",
      "sourceLineId": "123004",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬੈਦ ਤਬੈ ਯੌ ਬਚਨ ਉਚਾਰੇ ॥",
      "transliteration": "baidh tabai yau bachan uchaare ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਵੈਦ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "बैद तबै यौ बचन उचारे ॥",
      "sourceLineId": "123005",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਡੋ ਰੋਗ ਇਹ ਭਯੋ ਤਿਹਾਰੇ ॥",
      "transliteration": "baddo rog ieh bhayo tihaare ||",
      "translation": "",
      "punjabiViakhya": "ਤੈਨੂੰ ਤਾ ਬਹੁਤ ਵੱਡਾ ਰੋਗ ਲਗਿਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "बडो रोग इह भयो तिहारे ॥",
      "sourceLineId": "123006",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਯਾ ਕੌ ਜੰਤ੍ਰ ਮੰਤ੍ਰ ਨਹਿ ਕੋਈ ॥",
      "transliteration": "yaa kau ja(n)tr ma(n)tr neh koiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਜੰਤ੍ਰ ਮੰਤ੍ਰ ਦਾ ਕੋਈ (ਉਪਾ) ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "या कौ जंत्र मंत्र नहि कोई ॥",
      "sourceLineId": "123007",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਏਕ ਤੰਤ੍ਰ ਹੋਵੈ ਤੌ ਹੋਈ ॥੬॥",
      "transliteration": "ek ta(n)tr hovai tau hoiee ||6||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਤੰਤ੍ਰ ਹੈ, ਉਹੀ ਕੁਝ (ਅਸਰ ਕਰ) ਸਕਦਾ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "एक तंत्र होवै तौ होई ॥६॥",
      "sourceLineId": "123008",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਦਰਾ ਅਧਿਕ ਆਪੁ ਲੈ ਪੀਜੈ ॥",
      "transliteration": "madharaa adhik aap lai peejai ||",
      "translation": "",
      "punjabiViakhya": "(ਤੂੰ) ਆਪ ਬਹੁਤ ਸਾਰੀ ਸ਼ਰਾਬ ਪੀ ਲੈ",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "मदरा अधिक आपु लै पीजै ॥",
      "sourceLineId": "123009",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਔਰ ਆਪਨੀ ਤਿਯ ਕਹ ਦੀਜੈ ॥",
      "transliteration": "aauar aapanee tiy keh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੀ ਇਸਤਰੀ ਨੂੰ ਵੀ ਪਿਲਾ ਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "और आपनी तिय कह दीजै ॥",
      "sourceLineId": "123010",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਖਾਟ ਤਰੇ ਬਾਧ ਤੁਮ ਰਹੋ ॥",
      "transliteration": "khaaT tare baadh tum raho ||",
      "translation": "",
      "punjabiViakhya": "ਤੂੰ ਮੰਜੀ ਦੇ ਹੇਠਾ ਬੰਨ੍ਰਹਿਆ ਰਹਿ",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "खाट तरे बाध तुम रहो ॥",
      "sourceLineId": "123011",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੁਖ ਤੇ ਪਰੇ ਕਬਿਤਨ ਕਹੋ ॥੭॥",
      "transliteration": "mukh te pare kabitan kaho ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੁਖ ਤੋਂ ਕਬਿੱਤਾ ਪੜ੍ਰਹਦਾ ਰਹਿ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "मुख ते परे कबितन कहो ॥७॥",
      "sourceLineId": "123012",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਏਕ ਬੀਰ ਇਕ ਠੌਰ ਬੁਲੈਹੌ ॥",
      "transliteration": "ek beer ik Thauar bulaihau ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਕ 'ਬੀਰ' ਨੂੰ ਇਥੇ ਬੁਲਾ ਲੈਣਾ",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "एक बीर इक ठौर बुलैहौ ॥",
      "sourceLineId": "123013",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਸੀ ਖਾਟ ਊਪਰ ਬਠੈਹੌ ॥",
      "transliteration": "eisee khaaT uoopar baThaihau ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਮੰਜੀ ਉਤੇ ਬਿਠਾ ਦੇਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "इसी खाट ऊपर बठैहौ ॥",
      "sourceLineId": "123014",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਲ ਜੁਧ ਤਵ ਤ੍ਰਿਯ ਤਨ ਕਰਿਹੈ ॥",
      "transliteration": "mal judh tav tiray tan karihai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਤੇਰੀ ਇਸਤਰੀ ਨਾਲ ਮਲ ਯੁੱਧ ਕਰੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "मल जुध तव तृय तन करिहै ॥",
      "sourceLineId": "123015",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤੋ ਤਵ ਰੋਗ ਬਡੋ ਪਰਹਰਿ ਹੈ ॥੮॥",
      "transliteration": "to tav rog baddo parahar hai ||8||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤੇਰਾ ਇਹ ਰੋਗ ਦੂਰ ਹੋਵੇਗਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "तो तव रोग बडो परहरि है ॥८॥",
      "sourceLineId": "123016",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮੂੜ ਬਾਤ ਇਹ ਕਛੂ ਨ ਜਾਨੀ ॥",
      "transliteration": "mooR baat ieh kachhoo na jaanee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਮੂਰਖ ਨੇ ਇਹ ਗੱਲ ਨਾ ਸਮਝੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "मूड़ बात इह कछू न जानी ॥",
      "sourceLineId": "123017",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੇਹ ਅਰੋਗ ਸਰੋਗ ਪਛਾਨੀ ॥",
      "transliteration": "dheh arog sarog pachhaanee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਆਪਣੀ) ਅਰੋਗ ਦੇਹੀ ਨੂੰ ਰੋਗੀ ਸਮਝ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "देह अरोग सरोग पछानी ॥",
      "sourceLineId": "123018",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਆਪੁ ਮੰਗਾਇ ਮਦ੍ਰਯ ਤਬ ਪਿਯੋ ॥",
      "transliteration": "aap ma(n)gai madhray tab piyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਆਪ ਸ਼ਰਾਬ ਮੰਗਵਾ ਕੇ ਪੀ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "आपु मंगाइ मद्रय तब पियो ॥",
      "sourceLineId": "123019",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਾਰ ਸਹਿਤ ਅਬਲਾ ਕੋ ਦਿਯੋ ॥੯॥",
      "transliteration": "jaar sahit abalaa ko dhiyo ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਯਾਰ ਸਮੇਤ ਪਤਨੀ ਨੂੰ ਵੀ ਪਿਲਾਈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "जार सहित अबला को दियो ॥९॥",
      "sourceLineId": "123020",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਿਜੁ ਕਰ ਮੈ ਤਿਯ ਜਾਰ ਪਿਵਾਯੋ ॥",
      "transliteration": "nij kar mai tiy jaar pivaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਆਪਣੇ ਹੱਥਾ ਨਾਲ ਯਾਰ ਨੂੰ ਸ਼ਰਾਬ ਪਿਲਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "निजु कर मै तिय जार पिवायो ॥",
      "sourceLineId": "123021",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਪੁ ਔਧੋ ਤਰ ਖਾਟ ਬੰਧਾਯੋ ॥",
      "transliteration": "bap aauadho tar khaaT ba(n)dhaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਪਤੀ ਦੇ) ਸ਼ਰੀਰ ਨੂੰ ਮੰਜੀ ਹੇਠਾ ਉਲਟਾ ਬੰਨ੍ਰਹ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "बपु औधो तर खाट बंधायो ॥",
      "sourceLineId": "123022",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਆਖੈ ਦੋਊ ਮੂੰਦਿ ਕਰ ਲਈ ॥",
      "transliteration": "aakhai dhouoo moo(n)dh kar liee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀਆਂ) ਦੋਵੇਾਂ ਅੱਖਾ ਬੰਦ ਕਰ ਦਿੱਤੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "आखै दोऊ मूँदि कर लई ॥",
      "sourceLineId": "123023",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਾਰ ਤ੍ਰਿਯਾ ਆਰੂੜਿਤ ਭਈ ॥੧੦॥",
      "transliteration": "jaar tirayaa aarooRit bhiee ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਮੰਜੀ ਉਤੇ) ਯਾਰ ਅਤੇ ਇਸਤਰੀ ਬੈਠ ਗਏ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "जार तृया आरूड़ित भई ॥१०॥",
      "sourceLineId": "123024",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਭਾਟ ਪਰਿਯੋ ਤਰ ਕਬਿਤ ਉਚਾਰੈ ॥",
      "transliteration": "bhaaT pariyo tar kabit uchaarai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਭਾਟ ਮੰਜੀ ਹੇਠਾ ਪਿਆ ਹੋਇਆ ਕਬਿੱਤ ਉਚਾਰਨ ਲਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "भाट परियो तर कबित उचारै ॥",
      "sourceLineId": "123025",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਕਛੂ ਨ ਬਿਚਾਰੈ ॥",
      "transliteration": "bhedh abhedh kachhoo na bichaarai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੇਦ ਦੀ ਗੱਲ ਨੂੰ ਕੁਝ ਨਾ ਵਿਚਾਰ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद कछू न बिचारै ॥",
      "sourceLineId": "123026",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਵਹੈ ਤੰਤ੍ਰ ਜੌ ਬੈਦ ਬਨਾਯੋ ॥",
      "transliteration": "vahai ta(n)tr jau baidh banaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਸੋਚਦਾ ਸੀ ਕਿ) ਜੋ ਤੰਤ੍ਰ ਵੈਦ ਨੇ ਬਣਾਇਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "वहै तंत्र जौ बैद बनायो ॥",
      "sourceLineId": "123027",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਾ ਤੇ ਦੇਵ ਹਮਾਰੈ ਆਯੋ ॥੧੧॥",
      "transliteration": "taa te dhev hamaarai aayo ||11||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਕਰ ਕੇ ਸਾਡੇ (ਘਰ) ਦੇਵ (ਬੀਰ) ਆਇਆ ਹੈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "ता ते देव हमारै आयो ॥११॥",
      "sourceLineId": "123028",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭੋਗੁ ਜਾਰ ਅਬਲਾ ਸੌ ਕਿਯੋ ॥",
      "transliteration": "bhog jaar abalaa sau kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਯਾਰ ਨੇ ਇਸਤਰੀ ਨਾਲ ਭੋਗ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "भोगु जार अबला सौ कियो ॥",
      "sourceLineId": "123029",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਾ ਕੋ ਸੁਖ ਦਿਯੋ ॥",
      "transliteration": "bhaat bhaat taa ko sukh dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਭਾਤ ਭਾਤ ਦਾ ਸੁਖ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "भाति भाति ता को सुख दियो ॥",
      "sourceLineId": "123030",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਉਛਲ ਉਛਲ ਰਤਿ ਅਧਿਕ ਕਮਾਈ ॥",
      "transliteration": "auchhal uchhal rat adhik kamaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਛਲ ਉਛਲ ਕੇ ਬਹੁਤ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "उछल उछल रति अधिक कमाई ॥",
      "sourceLineId": "123031",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮੂਰਖ ਭਾਟ ਬਾਤ ਨਹਿ ਪਾਈ ॥੧੨॥",
      "transliteration": "moorakh bhaaT baat neh paiee ||12||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਮੂਰਖ ਭਾਟ ਗੱਲ ਨੂੰ ਸਮਝ ਨਾ ਸਕਿਆ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "मूरख भाट बात नहि पाई ॥१२॥",
      "sourceLineId": "123032",
      "sourceShabadId": "11474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123033",
      "sourceShabadId": "11475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਉਤਰਿ ਖਾਟਿ ਤੇ ਖੋਲਿ ਦ੍ਰਿਗ ਦਿਯੇ ਨ ਕੀਨੋ ਸੋਗੁ ॥",
      "transliteration": "autar khaaT te khol dhirag dhiye na keeno sog ||",
      "translation": "",
      "punjabiViakhya": "ਮੰਜੀ ਤੋਂ ਉਤਰ ਕੇ ਉਸ ਦੀਆਂ ਅੱਖਾ ਖੋਲ੍ਰਹ ਦਿੱਤੀਆਂ (ਅਤੇ ਭਾਟ ਨੇ ਵੀ ਮਨ ਵਿਚ) ਕੋਈ ਦੁਖ ਨਾ ਮਨਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "उतरि खाटि ते खोलि दृग दिये न कीनो सोगु ॥",
      "sourceLineId": "123034",
      "sourceShabadId": "11475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਭਾਟ ਪਛਾਨ੍ਯੋ ਸਾਚੁ ਜਿਯ ਅਬ ਮੈ ਭਯੋ ਅਰੋਗ ॥੧੩॥",
      "transliteration": "bhaaT pachhaanayo saach jiy ab mai bhayo arog ||13||",
      "translation": "",
      "punjabiViakhya": "ਭਾਟ ਨੇ (ਆਪਣੇ) ਮਨ ਵਿਚ ਸਚ ਸਮਝਿਆ ਕਿ ਹੁਣ ਮੈਂ ਅਰੋਗ ਹੋ ਗਿਆ ਹਾ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "भाट पछान्यो साचु जिय अब मै भयो अरोग ॥१३॥",
      "sourceLineId": "123035",
      "sourceShabadId": "11475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਬਾਧਿ ਖਾਟ ਤਰ ਭਾਟ ਕੌ ਤਾ ਕਰ ਤੇ ਮਦ ਪੀਯ ॥",
      "transliteration": "baadh khaaT tar bhaaT kau taa kar te madh peey ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਟ ਨੂੰ ਮੰਜੀ ਹੇਠਾ ਬੰਨ੍ਰਹ ਕੇ ਅਤੇ ਉਸ ਦੇ ਹੱਥ ਨਾਲ ਸ਼ਰਾਬ ਪੀ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "बाधि खाट तर भाट कौ ता कर ते मद पीय ॥",
      "sourceLineId": "123036",
      "sourceShabadId": "11475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਰਤਿ ਮਾਨੀ ਤ੍ਰਿਯ ਜਾਰ ਸੌ ਭੇਦ ਨ ਪਾਯੋ ਪੀਯ ॥੧੪॥",
      "transliteration": "rat maanee tiray jaar sau bhedh na paayo peey ||14||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਯਾਰ ਨਾਲ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ, (ਪਰ ਇਹ) ਭੇਦ ਪ੍ਰਿਯ (ਭਾਟ) ਨਾ ਪਾ ਸਕਿਆ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "रति मानी तृय जार सौ भेद न पायो पीय ॥१४॥",
      "sourceLineId": "123037",
      "sourceShabadId": "11475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਬਹਤਰਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੭੨॥੩੩੮੧॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau bahataravo charitr samaapatam sat subham sat ||172||3381||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੭੨ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੭੨॥੩੩੮੧॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ बहतरवो चरित्र समापतम सतु सुभम सतु ॥१७२॥३३८१॥अफजूँ॥",
      "sourceLineId": "123038",
      "sourceShabadId": "11475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123039",
      "sourceShabadId": "11476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਰਾਇ ਨਿਰੰਜਨ ਚੋਪਰੋ ਜਾ ਕੀ ਤ੍ਰਿਯਾ ਅਨੂਪ ॥",
      "transliteration": "rai nira(n)jan choparo jaa kee tirayaa anoop ||",
      "translation": "",
      "punjabiViakhya": "ਨਿਰੰਜਨ ਰਾਇ ਚੋਪੜਾ ਦੀ ਇਸਤਰੀ ਬਹੁਤ ਸੁੰਦਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "राइ निरंजन चोपरो जा की तृया अनूप ॥",
      "sourceLineId": "123040",
      "sourceShabadId": "11476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਲੋਕ ਸਕਲ ਨਿਰਖੈ ਤਿਸੈ ਰਤਿ ਕੌ ਜਾਨਿ ਸਰੂਪ ॥੧॥",
      "transliteration": "lok sakal nirakhai tisai rat kau jaan saroop ||1||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਲੋਕੀਂ ਉਸ ਨੂੰ ਰਤੀ ਦਾ ਸਰੂਪ ਸਮਝ ਕੇ ਵੇਖਦੇ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "लोक सकल निरखै तिसै रति कौ जानि सरूप ॥१॥",
      "sourceLineId": "123041",
      "sourceShabadId": "11476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਹਿਰ ਬਸੈ ਬਹਲੋਲ ਪੁਰ ਜਾ ਕੋ ਰੂਪ ਅਮੋਲ ॥",
      "transliteration": "sahir basai bahalol pur jaa ko roop amol ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਅਦੁੱਤੀ ਰੂਪ ਸੀ, (ਉਹ) ਬਹਲੋਲ ਪੁਰ ਵਿਚ ਵਸਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "सहिर बसै बहलोल पुर जा को रूप अमोल ॥",
      "sourceLineId": "123042",
      "sourceShabadId": "11476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਸੂਰਾ ਸਕਲ ਸਰਾਹਹੀ ਨਾਮ ਖਾਨ ਬਹਲੋਲ ॥੨॥",
      "transliteration": "sooraa sakal saraahahee naam khaan bahalol ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸਾਰੇ ਸੂਰਮੇ ਸਲਾਹੁੰਦੇ ਸਨ ਅਤੇ ਉਸ ਦਾ ਨਾਮ ਬਹਲੋਲ ਖ਼ਾਨ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "सूरा सकल सराहही नाम खान बहलोल ॥२॥",
      "sourceLineId": "123043",
      "sourceShabadId": "11476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਜਬ ਸੰਗੀਤ ਕਲਾ ਤ੍ਰਿਯਹਿ ਗਯੋ ਬਹਲੋਲ ਨਿਹਾਰਿ ॥",
      "transliteration": "jab sa(n)geet kalaa tirayeh gayo bahalol nihaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਬਹਲੋਲ ਨੇ ਸੰਗੀਤ ਕਲਾ ਇਸਤਰੀ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "जब संगीत कला तृयहि गयो बहलोल निहारि ॥",
      "sourceLineId": "123044",
      "sourceShabadId": "11476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਤਬ ਹੀ ਸਭ ਹੀ ਚਿਤ ਤੇ ਦਈ ਪਠਾਨੀ ਡਾਰਿ ॥੩॥",
      "transliteration": "tab hee sabh hee chit te dhiee paThaanee ddaar ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਉਸ ਨੇ ਆਪਣੇ ਚਿਤ ਤੋਂ ਸਾਰੀਆਂ ਪਠਾਣੀਆਂ ਨੂੰ ਕਢ ਦਿੱਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "तब ही सभ ही चित ते दई पठानी डारि ॥३॥",
      "sourceLineId": "123045",
      "sourceShabadId": "11476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਬਨਿਜ ਕਲਾ ਬਾਲਾ ਹੁਤੀ ਲੀਨੀ ਨਿਕਟ ਬੁਲਾਇ ॥",
      "transliteration": "banij kalaa baalaa hutee leenee nikaT bulai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਬਨਿਜ ਕਲਾ ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ, ਉਸ ਨੂੰ ਕੋਲ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "बनिज कला बाला हुती लीनी निकट बुलाइ ॥",
      "sourceLineId": "123046",
      "sourceShabadId": "11476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਅਮਿਤ ਦਰਬੁ ਤਾ ਕੌ ਦਿਯੋ ਵਾ ਪ੍ਰਤਿ ਦਈ ਪਠਾਇ ॥੪॥",
      "transliteration": "amit dharab taa kau dhiyo vaa prat dhiee paThai ||4||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਬੇਹਿਸਾਬ ਧਨ ਦੇ ਕੇ ਉਸ ਕੋਲ ਭੇਜ ਦਿੱਤਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "अमित दरबु ता कौ दियो वा प्रति दई पठाइ ॥४॥",
      "sourceLineId": "123047",
      "sourceShabadId": "11476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123048",
      "sourceShabadId": "11477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਬਨਿਜ ਕਲਾ ਚਲਿ ਕੈ ਤਿਤ ਆਈ ॥",
      "transliteration": "banij kalaa chal kai tit aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਬਨਿਜ ਕਲਾ ਉਥੇ ਚਲ ਕੇ ਆਈ",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "बनिज कला चलि कै तित आई ॥",
      "sourceLineId": "123049",
      "sourceShabadId": "11477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਜਹਾ ਕਲਾ ਸੰਗੀਤ ਸੁਹਾਈ ॥",
      "transliteration": "jahaa kalaa sa(n)geet suhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਸੰਗੀਤ ਕਲਾ ਸੁਸ਼ੋਭਿਤ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "जहा कला संगीत सुहाई ॥",
      "sourceLineId": "123050",
      "sourceShabadId": "11477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਜਬੈ ਖਾਨ ਕੀ ਉਪਮਾ ਕਰੀ ॥",
      "transliteration": "jabai khaan kee upamaa karee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਨੇ ਖ਼ਾਨ ਦੀ ਸਿਫ਼ਤ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "जबै खान की उपमा करी ॥",
      "sourceLineId": "123051",
      "sourceShabadId": "11477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਏ ਸੁਨਿ ਬਾਤ ਨਾਰਿ ਵਹ ਢਰੀ ॥੫॥",
      "transliteration": "e sun baat naar veh ddaree ||5||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਇਸਤਰੀ ਵੀ ਸੁਣ ਕੇ ਢਲ ਗਈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "ए सुनि बात नारि वह ढरी ॥५॥",
      "sourceLineId": "123052",
      "sourceShabadId": "11477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਇਨ ਬਾਤਨ ਅਬਲਾ ਉਰਝਾਈ ॥",
      "transliteration": "ein baatan abalaa urajhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਗੱਲਾ ਨਾਲ (ਉਸ ਨੇ) ਇਸਤਰੀ ਨੂੰ ਫਸਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "इन बातन अबला उरझाई ॥",
      "sourceLineId": "123053",
      "sourceShabadId": "11477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਇਹੈ ਬਾਤ ਪਿਯ ਸੁਨਤ ਸੁਹਾਈ ॥",
      "transliteration": "eihai baat piy sunat suhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਹੀ ਗੱਲ (ਉਸ ਦੇ) ਪ੍ਰਿਯ (ਪਤੀ) ਨੂੰ ਸੋਹਣੇ ਜਿਹੇ ਢੰਗ ਨਾਲ ਸੁਣਾ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "इहै बात पिय सुनत सुहाई ॥",
      "sourceLineId": "123054",
      "sourceShabadId": "11477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਮੈ ਇਕ ਬਾਗ ਬਨਾਯੋ ਭਲੋ ॥",
      "transliteration": "mai ik baag banaayo bhalo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮੈਂ ਇਕ ਸੁੰਦਰ ਬਾਗ਼ ਬਣਵਾਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "मै इक बाग बनायो भलो ॥",
      "sourceLineId": "123055",
      "sourceShabadId": "11477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਮੁਹਿ ਲੈ ਸੰਗ ਤਹਾ ਤੁਮ ਚਲੋ ॥੬॥",
      "transliteration": "muh lai sa(n)g tahaa tum chalo ||6||",
      "translation": "",
      "punjabiViakhya": "(ਪਤਨੀ ਨੇ ਪਤੀ ਨੂੰ ਕਿਹਾ ਕਿ) ਤੁਸੀਂ ਮੈਨੂੰ ਨਾਲ ਲੈ ਕੇ ਉਥੇ ਚਲੋ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "मुहि लै संग तहा तुम चलो ॥६॥",
      "sourceLineId": "123056",
      "sourceShabadId": "11477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਅਬ ਲੌ ਮੈ ਕਤਹੂੰ ਨਹਿ ਗਈ ॥",
      "transliteration": "ab lau mai katahoo(n) neh giee ||",
      "translation": "",
      "punjabiViakhya": "ਅਜ ਤਕ ਮੈਂ ਕਿਤੇ ਨਹੀਂ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "अब लौ मै कतहूँ नहि गई ॥",
      "sourceLineId": "123057",
      "sourceShabadId": "11477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1058_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਪੈਂਡ ਅਪੈਂਡ ਨ ਪਾਵਤ ਭਈ ॥",
      "transliteration": "pai(n)dd apai(n)dd na paavat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਪੈਂਡੇ ਕੁਪੈਂਡੇ ਪੈਰ ਨਹੀਂ ਰਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1058,
      "hindi": "",
      "hindiTransliteration": "पैंड अपैंड न पावत भई ॥",
      "sourceLineId": "123058",
      "sourceShabadId": "11477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
