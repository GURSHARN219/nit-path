{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1065,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1065_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹੋ ਜਲ ਜੀਵਨ ਕਹ ਐਸੇ ਚਰਿਤ੍ਰ ਦਿਖਾਇ ਕੈ ॥੭॥",
      "transliteration": "ho jal jeevan keh aaise charitr dhikhai kai ||7||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਜਲ ਜੀਵਾ ਨੂੰ ਚਰਿਤ੍ਰ ਵਿਖਾ ਕੇ (ਇਸਤਰੀ ਨੇ ਰਤਨ ਪ੍ਰਾਪਤ ਕਰ ਲਏ) ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "हो जल जीवन कह ऐसे चरित्र दिखाइ कै ॥७॥",
      "sourceLineId": "123371",
      "sourceShabadId": "11508",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123372",
      "sourceShabadId": "11509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕੋਟ ਦ੍ਵਾਰਿ ਕਰਿ ਮਤਸ ਦ੍ਰਿਗ ਬੰਧ੍ਰਯੋ ਅਪਨੋ ਗਾਉ ॥",
      "transliteration": "koT dhavaiaar kar matas dhirag ba(n)dhrayo apano gaau ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਆਪਣੀ ਨਗਰੀ ਬਣਵਾ ਕੇ ਕਿਲ੍ਰਹੇ ਦੇ ਦਰਵਾਜ਼ੇ ਉਤੇ ਮੱਛੀ ਦੀਆਂ ਅੱਖਾ ਬੰਨ੍ਰਹ ਦਿੱਤੀਆਂ (ਅਰਥਾਤ ਬਣਵਾ ਦਿੱਤੀਆਂ)।",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "कोट द्वारि करि मतस दृग बंध्रयो अपनो गाउ ॥",
      "sourceLineId": "123373",
      "sourceShabadId": "11509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਾ ਦਿਨ ਤੋ ਤਾ ਕੌ ਪਰਿਯੋ ਮਛਲੀ ਬੰਦਰ ਨਾਉ ॥੮॥",
      "transliteration": "taa dhin to taa kau pariyo machhalee ba(n)dhar naau ||8||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਿਨ ਤੋਂ ਉਸ ਦਾ ਨਾ 'ਮਛਲੀ ਬੰਦਰ' ਪੈ ਗਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "ता दिन तो ता कौ परियो मछली बंदर नाउ ॥८॥",
      "sourceLineId": "123374",
      "sourceShabadId": "11509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਖੋਜਿ ਖੋਜਿ ਤਿਹ ਭੂੰਮਿ ਤੇ ਕਾਢੇ ਰਤਨ ਅਨੇਕ ॥",
      "transliteration": "khoj khoj teh bhoo(n)m te kaadde ratan anek ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਖੋਜ ਖੋਜ ਕੇ ਭੂਮੀ ਤੋਂ ਅਨੇਕ ਰਤਨ ਕਢੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "खोजि खोजि तिह भूँमि ते काढे रतन अनेक ॥",
      "sourceLineId": "123375",
      "sourceShabadId": "11509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰੰਕ ਸਭੈ ਰਾਜਾ ਭਏ ਰਹਿਯੋ ਨ ਦੁਰਬਲ ਏਕ ॥੯॥",
      "transliteration": "ra(n)k sabhai raajaa bhe rahiyo na dhurabal ek ||9||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਨਿਰਧਨ ਰਾਜੇ ਬਣ ਗਏ ਅਤੇ ਇਕ ਵੀ ਦੁਰਬਲ (ਗ਼ਰੀਬ) ਨਾ ਰਿਹਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "रंक सभै राजा भए रहियो न दुरबल एक ॥९॥",
      "sourceLineId": "123376",
      "sourceShabadId": "11509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਸਤਹਤਰਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੭੭॥੩੪੬੫॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau satahataravo charitr samaapatam sat subham sat ||177||3465||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੭੭ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੭੭॥੩੪੬੫॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ सतहतरवो चरित्र समापतम सतु सुभम सतु ॥१७७॥३४६५॥अफजूँ॥",
      "sourceLineId": "123377",
      "sourceShabadId": "11509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123378",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਏਕ ਸੁਮੇਰ ਦੇਵਿ ਬਰ ਨਾਰੀ ॥",
      "transliteration": "ek sumer dhev bar naaree ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਮੇਰ ਦੇਵੀ ਨਾ ਦੀ ਇਕ ਸੁੰਦਰ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "एक सुमेर देवि बर नारी ॥",
      "sourceLineId": "123379",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਤਿ ਸੁੰਦਰ ਪ੍ਰਭੁ ਆਪੁ ਸਵਾਰੀ ॥",
      "transliteration": "at su(n)dhar prabh aap savaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬਹੁਤ ਸੁੰਦਰ ਸੀ ਜਿਵੇਾਂ ਪ੍ਰਭੂ ਨੇ ਆਪ ਸੰਵਾਰੀ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "अति सुँदर प्रभु आपु सवारी ॥",
      "sourceLineId": "123380",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੋਤਿ ਮਤੀ ਦੁਹਿਤਾ ਤਿਹ ਸੋਹੈ ॥",
      "transliteration": "jot matee dhuhitaa teh sohai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਜੋਤਿ ਮਤੀ ਨਾ ਦੀ (ਇਕ) ਪੁੱਤਰੀ ਸ਼ੋਭਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "जोति मती दुहिता तिह सोहै ॥",
      "sourceLineId": "123381",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦੇਵ ਅਦੇਵਨ ਕੋ ਮਨੁ ਮੋਹੈ ॥੧॥",
      "transliteration": "dhev adhevan ko man mohai ||1||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਦੇਵਤਿਆਂ ਅਤੇ ਦਾਨਵਾ ਦਾ ਮਨ ਮੋਹੰਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "देव अदेवन को मनु मोहै ॥१॥",
      "sourceLineId": "123382",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕੋਰਿ ਕੁਅਰਿ ਤਿਹ ਸਵਤਿ ਸੁਨਿਜੈ ॥",
      "transliteration": "kor kuar teh savat sunijai ||",
      "translation": "",
      "punjabiViakhya": "ਕੋਰਿ ਕੁਅਰਿ ਨਾ ਦੀ ਉਸ ਦੀ ਸੌਂਕਣ ਸੁਣੀਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "कोरि कुअरि तिह सवति सुनिजै ॥",
      "sourceLineId": "123383",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬੈਰ ਭਾਵ ਤਿਨ ਮਾਝ ਭਨਿਜੈ ॥",
      "transliteration": "bair bhaav tin maajh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਵਿਚ ਬਹੁਤ ਵੈਰ ਭਾਵ ਦਸਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "बैर भाव तिन माझ भनिजै ॥",
      "sourceLineId": "123384",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੋ ਰਾਨੀ ਕੋਊ ਘਾਤ ਨ ਪਾਵੈ ॥",
      "transliteration": "so raanee kouoo ghaat na paavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਰਾਣੀ ਨੂੰ ਕੋਈ ਦਾਓ ਨਹੀਂ ਸੀ ਮਿਲ ਰਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "सो रानी कोऊ घात न पावै ॥",
      "sourceLineId": "123385",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਿਹ ਛਲ ਸੋ ਤਿਹ ਸ੍ਵਰਗ ਪਠਾਵੈ ॥੨॥",
      "transliteration": "jeh chhal so teh savairag paThaavai ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਛਲ ਨਾਲ ਉਸ ਨੂੰ ਸਵਰਗ ਵਿਚ ਭੇਜ ਸਕੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "जिह छल सो तिह स्वरग पठावै ॥२॥",
      "sourceLineId": "123386",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੁਹਿਤਾ ਬੋਲਿ ਨਿਕਟ ਤਿਹ ਲਈ ॥",
      "transliteration": "dhuhitaa bol nikaT teh liee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਆਪਣੀ ਪੁੱਤਰੀ ਨੂੰ ਕੋਲ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "दुहिता बोलि निकट तिह लई ॥",
      "sourceLineId": "123387",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਿਛਾ ਇਹੈ ਸਿਖਾਵਤ ਭਈ ॥",
      "transliteration": "sichhaa ihai sikhaavat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਇਹ ਸਿਖਿਆ ਸਿਖਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "सिछा इहै सिखावत भई ॥",
      "sourceLineId": "123388",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਰਿਯਾ ਖੇਲਿ ਕੂਕ ਜਬ ਦੀਜੌ ॥",
      "transliteration": "jariyaa khel kook jab dheejau ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜਦੋਂ ਤੂੰ ਡਾਕਨੀ ਦੇਵੀ ('ਜਰਿਯਾ') ਦੀ ਖੇਡ ਨੂੰ ਖੇਡ ਕੇ ਜਦ ਚੀਕਾ ਮਾਰੇਾਂਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "जरिया खेलि कूक जब दीजौ ॥",
      "sourceLineId": "123389",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾਮ ਸਵਤਿ ਹਮਰੀ ਕੌ ਲੀਜੌ ॥੩॥",
      "transliteration": "naam savat hamaree kau leejau ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮੇਰੀ ਸੌਂਕਣ ਦਾ ਨਾ ਲਈਂ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "नाम सवति हमरी कौ लीजौ ॥३॥",
      "sourceLineId": "123390",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬੋਲਿ ਸਵਾਰੀ ਸੁਤਾ ਖਿਲਾਈ ॥",
      "transliteration": "bol savaaree sutaa khilaiee ||",
      "translation": "",
      "punjabiViakhya": "ਪੁੱਤਰੀ ਨੂੰ ਸਵੇਰੇ ਬੁਲਾ ਕੇ ਖਿਡਾਇਆ (ਅਰਥਾਤਰ- ਭੂਤ ਕਢਣ ਵਾਲੇ ਨੂੰ ਬੁਲਾ ਕੇ ਪੁੱਤਰੀ ਨੂੰ ਖਿਡਾਇਆ)",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "बोलि सवारी सुता खिलाई ॥",
      "sourceLineId": "123391",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕੋਰਿ ਕੁਅਰਿ ਪਰ ਕੂਕ ਦਿਰਾਈ ॥",
      "transliteration": "kor kuar par kook dhiraiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕੋਰਿ ਕੁਅਰਿ ਉਤੇ ਕੂਕ ਦਿਵਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "कोरि कुअरि पर कूक दिराई ॥",
      "sourceLineId": "123392",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਾਨੀ ਅਧਿਕ ਕੋਪ ਤਬ ਭਈ ॥",
      "transliteration": "raanee adhik kop tab bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਬਹੁਤ ਰੋਹ ਵਿਚ ਆ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "रानी अधिक कोप तब भई ॥",
      "sourceLineId": "123393",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚੜਿ ਝੰਪਾਨ ਮਾਰਨ ਤਿਨ ਗਈ ॥੪॥",
      "transliteration": "chaR jha(n)paan maaran tin giee ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਾਲਕੀ ('ਝੰਪਾਨ') ਵਿਚ ਚੜ੍ਰਹ ਕੇ ਉਸ ਨੂੰ ਮਾਰਨ ਲਈ ਗਈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "चड़ि झंपान मारन तिन गई ॥४॥",
      "sourceLineId": "123394",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਵਤਿਨ ਖਬਰਿ ਐਸ ਸੁਨਿ ਪਾਈ ॥",
      "transliteration": "savatin khabar aais sun paiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਸੌਂਕਣ ਨੂੰ ਪਤਾ ਲਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "सवतिन खबरि ऐस सुनि पाई ॥",
      "sourceLineId": "123395",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਚੜਿ ਰਾਨੀ ਹਮਰੇ ਪਰ ਆਈ ॥",
      "transliteration": "chaR raanee hamare par aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਰਾਣੀ ਮੇਰੇ ਉਪਰ ਚੜ੍ਰਹ ਕੇ ਆ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "चड़ि रानी हमरे पर आई ॥",
      "sourceLineId": "123396",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਿਜੁ ਕਰ ਗ੍ਰਿਹਨ ਆਗਿ ਲੈ ਦੀਨੀ ॥",
      "transliteration": "nij kar girahan aag lai dheenee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਆਪਣੇ ਹੱਥ ਨਾਲ ਘਰ ਨੂੰ ਅੱਗ ਲਾ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "निजु कर गृहन आगि लै दीनी ॥",
      "sourceLineId": "123397",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਰਿ ਬਰਿ ਬਾਟ ਸ੍ਵਰਗ ਕੀ ਲੀਨੀ ॥੫॥",
      "transliteration": "jar bar baaT savairag kee leenee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੜ ਬਲ ਕੇ ਸਵਰਗ ਦਾ ਰਸਤਾ ਪਕੜਿਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "जरि बरि बाट स्वरग की लीनी ॥५॥",
      "sourceLineId": "123398",
      "sourceShabadId": "11510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123399",
      "sourceShabadId": "11511",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਇਨ ਰਾਨਿਯਹਿ ਸਵਤਨਿ ਦਈ ਸੰਘਾਰਿ ॥",
      "transliteration": "eeh charitr in raaniyeh savatan dhiee sa(n)ghaar ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਰਾਣੀ ਨੇ ਇਹ ਚਰਿਤ੍ਰ ਖੇਡ ਕੇ ਸੌਂਕਣ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र इन रानियहि सवतनि दई संघारि ॥",
      "sourceLineId": "123400",
      "sourceShabadId": "11511",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਜ ਪਾਟ ਅਪਨੋ ਕਿਯੋ ਦੁਸਟ ਅਰਿਸਟ ਨਿਵਾਰਿ ॥੬॥",
      "transliteration": "raaj paaT apano kiyo dhusaT arisaT nivaar ||6||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਰਾਜ-ਪਾਟ ਆਪਣਾ ਕਰ ਲਿਆ ਅਤੇ ਦੁਸ਼ਟ ਤੇ ਵਿਘਨ-ਬਾਧਾ ਨੂੰ ਖ਼ਤਮ ਕਰ ਦਿੱਤਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "राज पाट अपनो कियो दुसट अरिसट निवारि ॥६॥",
      "sourceLineId": "123401",
      "sourceShabadId": "11511",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਅਠਤਰਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੭੮॥੩੪੭੧॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau aThataravo charitr samaapatam sat subham sat ||178||3471||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੭੮ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੭੮॥੩੪੭੧॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ अठतरवो चरित्र समापतम सतु सुभम सतु ॥१७८॥३४७१॥अफजूँ॥",
      "sourceLineId": "123402",
      "sourceShabadId": "11511",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123403",
      "sourceShabadId": "11512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਾਹ ਬਧੂ ਪਛਿਮ ਇਕ ਰਹੈ ॥",
      "transliteration": "saeh badhoo pachhim ik rahai ||",
      "translation": "",
      "punjabiViakhya": "ਪੱਛਮ ਵਿਚ ਇਕ ਸ਼ਾਹ ਦੀ ਪਤਨੀ ਰਹਿੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "साह बधू पछिम इक रहै ॥",
      "sourceLineId": "123404",
      "sourceShabadId": "11512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਾਮਵਤੀ ਤਾ ਕੌ ਜਗ ਕਹੈ ॥",
      "transliteration": "kaamavatee taa kau jag kahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜਗਤ ਵਾਲੇ ਕਾਮਵਤੀ ਕਹਿੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "कामवती ता कौ जग कहै ॥",
      "sourceLineId": "123405",
      "sourceShabadId": "11512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਾ ਕੌ ਪਤਿ ਪਰਦੇਸ ਸਿਧਾਰੋ ॥",
      "transliteration": "taa kau pat paradhes sidhaaro ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਪਤੀ ਪਰਦੇਸ ਚਲਿਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "ता कौ पति परदेस सिधारो ॥",
      "sourceLineId": "123406",
      "sourceShabadId": "11512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਰਖ ਬੀਤ ਗੇ ਗ੍ਰਿਹ ਨ ਸੰਭਾਰੋ ॥੧॥",
      "transliteration": "barakh beet ge gireh na sa(n)bhaaro ||1||",
      "translation": "",
      "punjabiViakhya": "(ਕਈ) ਵਰ੍ਰਹੇ ਬੀਤ ਗਏ, ਪਰ (ਉਹ) ਘਰ ਵਲ ਨਾ ਆਇਆ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "बरख बीत गे गृह न संभारो ॥१॥",
      "sourceLineId": "123407",
      "sourceShabadId": "11512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੁਧਿ ਪਤਿ ਕੀ ਅਬਲਾ ਤਜਿ ਦੀਨੀ ॥",
      "transliteration": "sudh pat kee abalaa taj dheenee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਨੇ ਪਤੀ ਦੀ ਖ਼ਬਰ ਸਾਰ ਛਡ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "सुधि पति की अबला तजि दीनी ॥",
      "sourceLineId": "123408",
      "sourceShabadId": "11512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਾਮਾਨਨਿ ਕੀ ਤਿਨ ਗਤਿ ਲੀਨੀ ॥",
      "transliteration": "saamaanan kee tin gat leenee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵੇਸਵਾਵਾ ('ਸਾਮਾਨਨਿ') ਦੀ ਚਾਲ ਫੜ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "सामाननि की तिन गति लीनी ॥",
      "sourceLineId": "123409",
      "sourceShabadId": "11512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਊਚ ਨੀਚ ਨਹਿ ਠੌਰ ਬਿਚਾਰੈ ॥",
      "transliteration": "uooch neech neh Thauar bichaarai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਉੱਚੇ ਨੀਵੇਾਂ ਸਥਾਨ ਦਾ ਵਿਚਾਰ ਕੀਤੇ ਬਿਨਾ",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "ऊच नीच नहि ठौर बिचारै ॥",
      "sourceLineId": "123410",
      "sourceShabadId": "11512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜੋ ਚਾਹੈ ਤਿਹ ਸਾਥ ਬਿਹਾਰੈ ॥੨॥",
      "transliteration": "jo chaahai teh saath bihaarai ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਚਾਹੁੰਦੀ, ਉਸ ਨਾਲ ਵਿਲਾਸ ਕਰਦੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "जो चाहै तिह साथ बिहारै ॥२॥",
      "sourceLineId": "123411",
      "sourceShabadId": "11512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਬ ਲੌ ਨਾਥ ਤਵਨ ਕੋ ਆਯੋ ॥",
      "transliteration": "tab lau naath tavan ko aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਉਸ ਦਾ ਪਤੀ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "तब लौ नाथ तवन को आयो ॥",
      "sourceLineId": "123412",
      "sourceShabadId": "11512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਏਕ ਦੂਤਿਯਹਿ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "transliteration": "ek dhootiyeh bol paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਕ ਦੂਤੀ ਨੂੰ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "एक दूतियहि बोलि पठायो ॥",
      "sourceLineId": "123413",
      "sourceShabadId": "11512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕੋਊ ਮਿਲਾਇ ਮੋਹਿ ਤ੍ਰਿਯ ਦੀਜੈ ॥",
      "transliteration": "kouoo milai moh tiray dheejai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ ਕਿਹਾ) ਕੋਈ ਮੈਨੂੰ ਇਸਤਰੀ ਮਿਲਾ ਦੇਏ",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "कोऊ मिलाइ मोहि तृय दीजै ॥",
      "sourceLineId": "123414",
      "sourceShabadId": "11512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜੋ ਚਾਹੈ ਚਿਤ ਮੈ ਸੋਊ ਲੀਜੈ ॥੩॥",
      "transliteration": "jo chaahai chit mai souoo leejai ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਿਤ ਵਿਚ ਜੋ ਚਾਹੇ, ਉਹੀ ਲੈ ਲਏ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "जो चाहै चित मै सोऊ लीजै ॥३॥",
      "sourceLineId": "123415",
      "sourceShabadId": "11512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਵਾ ਕੀ ਨਾਰਿ ਦੂਤਿਯਹਿ ਭਾਈ ॥",
      "transliteration": "vaa kee naar dhootiyeh bhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪਤਨੀ ਦੂਤੀ ਨੂੰ ਚੰਗੀ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1065,
      "hindi": "",
      "hindiTransliteration": "वा की नारि दूतियहि भाई ॥",
      "sourceLineId": "123416",
      "sourceShabadId": "11512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1065_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਆਨਿ ਸਾਹੁ ਕੋ ਤੁਰਤ ਮਿਲਾਈ ॥",
      "transliteration": "aan saahu ko turat milaiee ||",
      "translation": "",
