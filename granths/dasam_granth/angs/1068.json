{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1068,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1068_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123515",
      "sourceShabadId": "11522",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੁਨਿ ਰਾਨੀ ਸ੍ਯਾਨੀ ਬਚਨ ਸੀਸ ਰਹੀ ਨਿਹੁਰਾਇ ॥",
      "transliteration": "sun raanee sayaanee bachan sees rahee nihurai ||",
      "translation": "",
      "punjabiViakhya": "ਸਿਆਣੀ ਰਾਣੀ ਬਚਨ ਸੁਣ ਕੇ ਸਿਰ ਨੀਵਾ ਪਾਈ ਚੁਪ ਕਰ ਰਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "सुनि रानी स्यानी बचन सीस रही निहुराइ ॥",
      "sourceLineId": "123516",
      "sourceShabadId": "11522",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੁਘਰ ਹੋਇ ਸੋ ਜਾਨਈ ਜੜ ਕੋ ਕਹਾ ਉਪਾਇ ॥੧੩॥",
      "transliteration": "sughar hoi so jaaniee jaR ko kahaa upai ||13||",
      "translation": "",
      "punjabiViakhya": "ਸੁਘੜ ਹੋਵੇ, ਤਾ ਸਮਝ ਜਾਵੇ, ਮੂਰਖ ਨੂੰ ਸਮਝਾਣ ਦਾ ਕੀ ਉਪਾ ਹੋ ਸਕਦਾ ਹੈ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "सुघर होइ सो जानई जड़ को कहा उपाइ ॥१३॥",
      "sourceLineId": "123517",
      "sourceShabadId": "11522",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "123518",
      "sourceShabadId": "11523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜੋ ਚਤਰੋ ਨਰ ਹੋਇ ਸੁ ਭੇਵ ਪਛਾਨਈ ॥",
      "transliteration": "jo chataro nar hoi su bhev pachhaaniee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਪੁਰਸ਼ ਚਤੁਰ ਹੁੰਦਾ ਹੈ, ਉਹ ਭੇਦ ਨੂੰ ਪਛਾਣ ਲੈਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "जो चतरो नर होइ सु भेव पछानई ॥",
      "sourceLineId": "123519",
      "sourceShabadId": "11523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮੂਰਖ ਭੇਦ ਅਭੇਦ ਕਹਾ ਜਿਯ ਜਾਨਈ ॥",
      "transliteration": "moorakh bhedh abhedh kahaa jiy jaaniee ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਭੇਦ ਅਭੇਦ ਦੀ ਗੱਲ ਮਨ ਵਿਚ ਕਿਵੇਾਂ ਸਮਝ ਸਕਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "मूरख भेद अभेद कहा जिय जानई ॥",
      "sourceLineId": "123520",
      "sourceShabadId": "11523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਾ ਤੈ ਹੌਹੂੰ ਕਛੂ ਚਰਿਤ੍ਰ ਬਨਾਇ ਹੋ ॥",
      "transliteration": "taa tai hauahoo(n) kachhoo charitr banai ho ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਮੈਂ ਵੀ ਕੋਈ ਚਰਿਤ੍ਰ ਬਣਾਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "ता तै हौहूँ कछू चरित्र बनाइ हो ॥",
      "sourceLineId": "123521",
      "sourceShabadId": "11523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹੋ ਯਾ ਰਾਨੀ ਕੇ ਸਹਿਤ ਨ੍ਰਿਪਹਿ ਕੋ ਘਾਇ ਹੋ ॥੧੪॥",
      "transliteration": "ho yaa raanee ke sahit nirapeh ko ghai ho ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਸਹਿਤ ਰਾਜੇ ਨੂੰ ਮਾਰ ਦਿਆਂਗੀ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "हो या रानी के सहित नृपहि को घाइ हो ॥१४॥",
      "sourceLineId": "123522",
      "sourceShabadId": "11523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123523",
      "sourceShabadId": "11524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮੂਰਖ ਕਛੂ ਭੇਦ ਨਹਿ ਪਾਯੋ ॥",
      "transliteration": "moorakh kachhoo bhedh neh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਨੇ ਕੁਝ ਭੇਦ ਨਹੀਂ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "मूरख कछू भेद नहि पायो ॥",
      "sourceLineId": "123524",
      "sourceShabadId": "11524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਾਚੀ ਕੋ ਝੂਠੀ ਠਹਰਾਯੋ ॥",
      "transliteration": "saachee ko jhooThee Thaharaayo ||",
      "translation": "",
      "punjabiViakhya": "ਸੱਚੀ (ਇਸਤਰੀ) ਨੂੰ ਝੂਠਾ ਕਰ ਕੇ ਮੰਨਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "साची को झूठी ठहरायो ॥",
      "sourceLineId": "123525",
      "sourceShabadId": "11524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਝੂਠੀ ਕੋ ਸਾਚੀ ਕਰਿ ਮਾਨ੍ਯੋ ॥",
      "transliteration": "jhooThee ko saachee kar maanayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਝੂਠੀ ਨੂੰ ਸੱਚੀ ਕਰ ਕੇ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "झूठी को साची करि मान्यो ॥",
      "sourceLineId": "123526",
      "sourceShabadId": "11524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਕਛੂ ਨਹਿ ਜਾਨ੍ਯੋ ॥੧੫॥",
      "transliteration": "bhedh abhedh kachhoo neh jaanayo ||15||",
      "translation": "",
      "punjabiViakhya": "ਭੇਦ ਅਭੇਦ ਨੂੰ ਕੁਝ ਵੀ ਨਾ ਸਮਝਿਆ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद कछू नहि जान्यो ॥१५॥",
      "sourceLineId": "123527",
      "sourceShabadId": "11524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਇਕਾਸੀਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੮੧॥੩੫੦੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau ikaaseevo charitr samaapatam sat subham sat ||181||3500||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੮੧ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੮੧॥੩੫੦੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ इकासीवो चरित्र समापतम सतु सुभम सतु ॥१८१॥३५००॥अफजूँ॥",
      "sourceLineId": "123528",
      "sourceShabadId": "11524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123529",
      "sourceShabadId": "11525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਵਹੈ ਸਵਤਿ ਤਾ ਕੀ ਹੁਤੀ ਜਾ ਕੋ ਰੂਪ ਅਪਾਰ ॥",
      "transliteration": "vahai savat taa kee hutee jaa ko roop apaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੌਂਕਣ ਅਪਾਰ ਸੁੰਦਰਤਾ ਵਾਲੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "वहै सवति ता की हुती जा को रूप अपार ॥",
      "sourceLineId": "123530",
      "sourceShabadId": "11525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੁਰਪਤਿ ਸੇ ਨਿਰਖਤ ਸਦਾ ਮੁਖ ਛਬਿ ਭਾਨ ਕੁਮਾਰਿ ॥੧॥",
      "transliteration": "surapat se nirakhat sadhaa mukh chhab bhaan kumaar ||1||",
      "translation": "",
      "punjabiViakhya": "ਇੰਦਰ ਵਰਗੇ ਸਦਾ ਉਸ ਭਾਨ ਕੁਮਾਰੀ ਦੇ ਮੂੰਹ ਦੀ ਛਬੀ ਦੇਖਦੇ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "सुरपति से निरखत सदा मुख छबि भान कुमारि ॥१॥",
      "sourceLineId": "123531",
      "sourceShabadId": "11525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "123532",
      "sourceShabadId": "11526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭਾਨ ਕਲਾ ਐਸੇ ਬਹੁ ਬਰਖ ਬਿਤਾਇ ਕੈ ॥",
      "transliteration": "bhaan kalaa aaise bahu barakh bitai kai ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਨ ਕਲਾ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਬਹੁਤ ਸਾਲ ਬਿਤਾ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "भान कला ऐसे बहु बरख बिताइ कै ॥",
      "sourceLineId": "123533",
      "sourceShabadId": "11526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਿਸਿਸ ਪ੍ਰਭਾ ਕੀ ਬਾਤ ਗਈ ਜਿਯ ਆਇ ਕੈ ॥",
      "transliteration": "nisis prabhaa kee baat giee jiy aai kai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਕ ਦਿਨ) ਨਿਸਿਸ ਪ੍ਰਭਾ ਦੀ ਗੱਲ ਉਸ ਦੇ ਮਨ ਵਿਚ ਆ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "निसिस प्रभा की बात गई जिय आइ कै ॥",
      "sourceLineId": "123534",
      "sourceShabadId": "11526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੋਤ ਰਾਵ ਤਿਹ ਸੰਗ ਬਿਲੋਕ੍ਯੋ ਜਾਇ ਕੈ ॥",
      "transliteration": "sot raav teh sa(n)g bilokayo jai kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਰਾਜੇ ਨੂੰ ਉਸ ਨਾਲ ਸੁਤਾ ਹੋਇਆ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "सोत राव तिह संग बिलोक्यो जाइ कै ॥",
      "sourceLineId": "123535",
      "sourceShabadId": "11526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਹੋ ਫਿਰਿ ਆਈ ਘਰ ਮਾਝ ਦੁਹੁਨ ਕੋ ਘਾਇ ਕੈ ॥੨॥",
      "transliteration": "ho fir aaiee ghar maajh dhuhun ko ghai kai ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਹਾ ਨੂੰ ਮਾਰ ਕੇ ਆਪਣੇ ਘਰ ਵਿਚ ਆ ਗਈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "हो फिरि आई घर माझ दुहुन को घाइ कै ॥२॥",
      "sourceLineId": "123536",
      "sourceShabadId": "11526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123537",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਧਿਕ ਕੋਪ ਕਰਿ ਖੜਗ ਪ੍ਰਹਾਰਿਯੋ ॥",
      "transliteration": "adhik kop kar khaRag prahaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਬਹੁਤ ਕ੍ਰੋਧ ਕਰ ਕੇ ਖੜਗ ਦਾ ਵਾਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "अधिक कोप करि खड़ग प्रहारियो ॥",
      "sourceLineId": "123538",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦੁਹੂਅਨ ਚਾਰਿ ਟੂਕ ਕਰਿ ਡਾਰਿਯੋ ॥",
      "transliteration": "dhuhooan chaar Took kar ddaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਹਾ ਦੇ ਚਾਰ ਟੋਟੇ ਕਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "दुहूअन चारि टूक करि डारियो ॥",
      "sourceLineId": "123539",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੈ ਇਹ ਜੜ ਸੋ ਭੇਦ ਬਤਾਯੋ ॥",
      "transliteration": "mai ieh jaR so bhedh bataayo ||",
      "translation": "",
      "punjabiViakhya": "(ਮਨ ਵਿਚ ਕਹਿਣ ਲਗੀ) ਮੈਂ ਤਾ ਇਸ ਮੂਰਖ ਨੂੰ ਭੇਦ ਦਸਿਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "मै इह जड़ सो भेद बतायो ॥",
      "sourceLineId": "123540",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਇਹ ਮੋਹੁ ਝੂਠੀ ਠਹਰਾਯੋ ॥੩॥",
      "transliteration": "eeh moh jhooThee Thaharaayo ||3||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਇਸ ਨੇ ਮੈਨੂੰ ਹੀ ਝੂਠੀ ਬਣਾ ਦਿੱਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "इह मोहु झूठी ठहरायो ॥३॥",
      "sourceLineId": "123541",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਵਤਿ ਸਹਿਤ ਰਾਜਾ ਕੌ ਘਾਈ ॥",
      "transliteration": "savat sahit raajaa kau ghaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸੌਂਕਣ ਸਮੇਤ ਰਾਜੇ ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "सवति सहित राजा कौ घाई ॥",
      "sourceLineId": "123542",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪੌਛਿ ਖੜਗ ਬਹੁਰੋ ਘਰ ਆਈ ॥",
      "transliteration": "pauachh khaRag bahuro ghar aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤਲਵਾਰ ਪੂੰਝ ਕੇ ਘਰ ਪਰਤ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "पौछि खड़ग बहुरो घर आई ॥",
      "sourceLineId": "123543",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੋਇ ਰਹੀ ਮਨ ਮੈ ਸੁਖ ਪਾਯੋ ॥",
      "transliteration": "soi rahee man mai sukh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਮਨ ਵਿਚ ਸੁਖ ਪ੍ਰਾਪਤ ਕਰ ਕੇ ਸੌਂ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "सोइ रही मन मै सुख पायो ॥",
      "sourceLineId": "123544",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭਏ ਪ੍ਰਾਤ ਯੌ ਕੂਕਿ ਸੁਨਾਯੋ ॥੪॥",
      "transliteration": "bhe praat yau kook sunaayo ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਵੇਰ ਹੁੰਦਿਆਂ ਹੀ ਇਸ ਤਰ੍ਰਹਾ ਕੂਕ ਕੇ ਸੁਣਾਉਣ ਲਗੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "भए प्रात यौ कूकि सुनायो ॥४॥",
      "sourceLineId": "123545",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਰੋਇ ਪ੍ਰਾਤ ਭੇ ਬਚਨ ਉਚਾਰੇ ॥",
      "transliteration": "roi praat bhe bachan uchaare ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੇਰ ਹੋਣ ਤੇ ਰੋ ਕੇ ਕਹਿਣ ਲਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "रोइ प्रात भे बचन उचारे ॥",
      "sourceLineId": "123546",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬੈਠੇ ਕਹਾ ਰਾਵ ਜੂ ਮਾਰੇ ॥",
      "transliteration": "baiThe kahaa raav joo maare ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਲੋਕ ਬੈਠੇ ਕੀ ਕਰਦੇ ਹੋ, ਰਾਜਾ ਜੀ ਮਾਰੇ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "बैठे कहा राव जू मारे ॥",
      "sourceLineId": "123547",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਹਮਰੇ ਸੁਖ ਸਭ ਹੀ ਬਿਧਿ ਖੋਏ ॥",
      "transliteration": "hamare sukh sabh hee bidh khoe ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਧਾਤਾ ਨੇ ਸਾਡੇ ਸਾਰੇ ਸੁਖ ਖੋਹ ਲਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "हमरे सुख सभ ही बिधि खोए ॥",
      "sourceLineId": "123548",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਯੌ ਸੁਨਿ ਬੈਨ ਸਕਲ ਭ੍ਰਿਤ ਰੋਏ ॥੫॥",
      "transliteration": "yau sun bain sakal bhirat roe ||5||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਬੋਲ ਸੁਣ ਕੇ ਸਾਰੇ ਨੌਕਰ ਚਾਕਰ ਰੋਣ ਲਗੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "यौ सुनि बैन सकल भृत रोए ॥५॥",
      "sourceLineId": "123549",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮ੍ਰਿਤਕ ਰਾਵ ਤ੍ਰਿਯ ਸਹਿਤ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "mritak raav tiray sahit nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਮਰੇ ਹੋਏ ਰਾਜੇ ਨੂੰ ਇਸਤਰੀ ਸਹਿਤ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "मृतक राव तृय सहित निहारियो ॥",
      "sourceLineId": "123550",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਇਹ ਭਾਤਿ ਉਚਾਰਿਯੋ ॥",
      "transliteration": "tab raanee ieh bhaat uchaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "तब रानी इह भाति उचारियो ॥",
      "sourceLineId": "123551",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮੋ ਕਹ ਸਾਥ ਰਾਵ ਕੇ ਜਾਰਹੁ ॥",
      "transliteration": "mo keh saath raav ke jaarahu ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਰਾਜੇ ਦੇ ਨਾਲ ਹੀ ਸਾੜ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "मो कह साथ राव के जारहु ॥",
      "sourceLineId": "123552",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮੋਰੇ ਛਤ੍ਰ ਪੁਤ੍ਰ ਸਿਰ ਢਾਰਹੁ ॥੬॥",
      "transliteration": "more chhatr putr sir ddaarahu ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੇ ਪੁੱਤਰ ਦੇ ਸਿਰ ਉਤੇ ਛਤ੍ਰ ਸਜਾ ਦਿਓ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "मोरे छत्र पुत्र सिर ढारहु ॥६॥",
      "sourceLineId": "123553",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਬ ਤਾ ਪੈ ਮੰਤ੍ਰੀ ਸਭ ਆਏ ॥",
      "transliteration": "tab taa pai ma(n)tree sabh aae ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਕੋਲ ਸਾਰੇ ਮੰਤ੍ਰੀ ਆ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "तब ता पै मंत्री सभ आए ॥",
      "sourceLineId": "123554",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰੋਇ ਰੋਇ ਯੌ ਬਚਨ ਸੁਨਾਏ ॥",
      "transliteration": "roi roi yau bachan sunaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰੋ ਰੋ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿਣ ਲਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "रोइ रोइ यौ बचन सुनाए ॥",
      "sourceLineId": "123555",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਛਤ੍ਰ ਪੁਤ੍ਰ ਕੇ ਸਿਰ ਪਰ ਢਾਰੋ ॥",
      "transliteration": "chhatr putr ke sir par ddaaro ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਛਤ੍ਰ ਤਾ ਪੁੱਤਰ ਦੇ ਸਿਰ ਉਤੇ ਝੁਲਾ ਦਿਓ,",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "छत्र पुत्र के सिर पर ढारो ॥",
      "sourceLineId": "123556",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਆਜ ਉਚਿਤ ਨਹਿ ਜਰਨ ਤਿਹਾਰੋ ॥੭॥",
      "transliteration": "aaj uchit neh jaran tihaaro ||7||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਅਜ ਤੁਹਾਡਾ ਸੜਨਾ ਉਚਿਤ ਨਹੀਂ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "आज उचित नहि जरन तिहारो ॥७॥",
      "sourceLineId": "123557",
      "sourceShabadId": "11527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123558",
      "sourceShabadId": "11528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨ੍ਰਿਪਤਿ ਮਰਿਯੋ ਸਿਸੁ ਸੁਤ ਰਹਿਯੋ ਤੈ ਜਰਿ ਹੈ ਦੁਖ ਪਾਇ ॥",
      "transliteration": "nirapat mariyo sis sut rahiyo tai jar hai dhukh pai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਮਰ ਗਿਆ ਹੈ, ਪੁੱਤਰ ਅਜੇ ਬਾਲਕ ਹੈ ਅਤੇ ਤੂੰ (ਰਾਜੇ ਦੇ ਮਰਨ ਦੇ) ਦੁਖ ਕਰ ਕੇ ਸੜਨਾ ਚਾਹੁੰਦੀ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "नृपति मरियो सिसु सुत रहियो तै जरि है दुख पाइ ॥",
      "sourceLineId": "123559",
      "sourceShabadId": "11528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਿਨਿ ਐਸੋ ਹਠ ਕੀਜਿਯੈ ਰਾਜ ਬੰਸ ਤੇ ਜਾਇ ॥੮॥",
      "transliteration": "jin aaiso haTh keejiyai raaj ba(n)s te jai ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਜਿਹਾ ਹਠ ਨਾ ਕਰੋ, ਨਹੀਂ ਤਾ ਰਾਜ ਬੰਸ ਤੋਂ ਚਲਿਆ ਜਾਏਗਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "जिनि ऐसो हठ कीजियै राज बंस ते जाइ ॥८॥",
      "sourceLineId": "123560",
      "sourceShabadId": "11528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123561",
      "sourceShabadId": "11529",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1068_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਭਨ ਸੁਨਤ ਇਹ ਭਾਤਿ ਉਚਾਰੀ ॥",
      "transliteration": "sabhan sunat ieh bhaat uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਸਭ ਨੂੰ ਕਹਿੰਦਿਆਂ ਸੁਣ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1068,
      "hindi": "",
      "hindiTransliteration": "सभन सुनत इह भाति उचारी ॥",
      "sourceLineId": "123562",
      "sourceShabadId": "11529",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
