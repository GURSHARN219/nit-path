{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1069,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1069_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਰਨ ਨਿਮਿਤਿ ਉਠਿ ਤਬੈ ਸਿਧਾਰੀ ॥",
      "transliteration": "jaran nimit uTh tabai sidhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਸੜਨ ਲਈ ਤਦ ਤੁਰ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "जरन निमिति उठि तबै सिधारी ॥",
      "sourceLineId": "123563",
      "sourceShabadId": "11529",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਬ ਮੰਤ੍ਰਿਨ ਰਾਨੀ ਗਹਿ ਲਈ ॥",
      "transliteration": "tab ma(n)tiran raanee geh liee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਮੰਤ੍ਰੀਆਂ ਨੇ ਰਾਣੀ ਨੂੰ ਪਕੜ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "तब मंतृन रानी गहि लई ॥",
      "sourceLineId": "123564",
      "sourceShabadId": "11529",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਾਜ ਸਮਗ੍ਰੀ ਤਿਹ ਸੁਤ ਦਈ ॥੯॥",
      "transliteration": "raaj samagree teh sut dhiee ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ ਦੀ ਸਾਮਗ੍ਰੀ ਉਸ ਦੇ ਪੁੱਤਰ ਨੂੰ ਦੇ ਦਿੱਤੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "राज समग्री तिह सुत दई ॥९॥",
      "sourceLineId": "123565",
      "sourceShabadId": "11529",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123566",
      "sourceShabadId": "11530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚਰਿਤ ਚੰਚਲਾ ਐਸ ਕਰਿ ਤ੍ਰਿਯ ਜੁਤ ਨ੍ਰਿਪਤਿ ਸੰਘਾਰਿ ॥",
      "transliteration": "charit cha(n)chalaa aais kar tiray jut nirapat sa(n)ghaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਨੇ ਅਜਿਹਾ ਚਰਿਤ੍ਰ ਕੀਤਾ ਅਤੇ ਇਸਤਰੀ ਸਹਿਤ ਰਾਜੇ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "चरित चंचला ऐस करि तृय जुत नृपति संघारि ॥",
      "sourceLineId": "123567",
      "sourceShabadId": "11530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮੰਤ੍ਰਿਨ ਕੀ ਰਾਖੀ ਰਹੀ ਛਤ੍ਰ ਪੁਤ੍ਰ ਸਿਰ ਢਾਰ ॥੧੦॥",
      "transliteration": "ma(n)tiran kee raakhee rahee chhatr putr sir ddaar ||10||",
      "translation": "",
      "punjabiViakhya": "ਮੰਤ੍ਰੀਆਂ ਦੇ ਰਖਣ ਤੇ (ਸੜਨੋ) ਰਹਿ ਗਈ ਅਤੇ ਰਾਜ-ਛਤ੍ਰ ਪੁੱਤਰ ਦੇ ਸਿਰ ਉਤੇ ਰਖ ਦਿੱਤਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "मंतृन की राखी रही छत्र पुत्र सिर ढार ॥१०॥",
      "sourceLineId": "123568",
      "sourceShabadId": "11530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਬਿਆਸੀਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੮੨॥੩੫੧੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau biaaseevo charitr samaapatam sat subham sat ||182||3510||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੮੨ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੮੨॥੩੫੧੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ बिआसीवो चरित्र समापतम सतु सुभम सतु ॥१८२॥३५१०॥अफजूँ॥",
      "sourceLineId": "123569",
      "sourceShabadId": "11530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123570",
      "sourceShabadId": "11531",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਹਿਰ ਬਟਾਲਾ ਮੌ ਬਸੈ ਮੈਗਲ ਖਾਨ ਪਠਾਨ ॥",
      "transliteration": "sahir baTaalaa mau basai maigal khaan paThaan ||",
      "translation": "",
      "punjabiViakhya": "ਬਟਾਲਾ ਸ਼ਹਿਰ ਵਿਚ ਮੈਗਲ ਖ਼ਾਨ ਨਾ ਦਾ ਪਠਾਣ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "सहिर बटाला मौ बसै मैगल खान पठान ॥",
      "sourceLineId": "123571",
      "sourceShabadId": "11531",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਦ ਪੀਵਤ ਨਿਸੁ ਦਿਨ ਰਹੈ ਸਦਾ ਰਹਤ ਅਗ੍ਯਾਨ ॥੧॥",
      "transliteration": "madh peevat nis dhin rahai sadhaa rahat agayaan ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰਾਤ ਦਿਨ ਸ਼ਰਾਬ ਪੀਂਦੇ ਰਹਿਣ ਕਰ ਕੇ ਬੇਸੁਰਤ ਰਹਿੰਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "मद पीवत निसु दिन रहै सदा रहत अग्यान ॥१॥",
      "sourceLineId": "123572",
      "sourceShabadId": "11531",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123573",
      "sourceShabadId": "11532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਬ ਹੀ ਦਿਵਸ ਤੀਜ ਕੋ ਆਯੋ ॥",
      "transliteration": "tab hee dhivas teej ko aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਹੀ ਤੀਜ ਦੇ ਦਿਨ ਆ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "तब ही दिवस तीज को आयो ॥",
      "sourceLineId": "123574",
      "sourceShabadId": "11532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਭ ਅਬਲਨਿ ਆਨੰਦੁ ਬਢਾਯੋ ॥",
      "transliteration": "sabh abalan aana(n)dh baddaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਭ ਇਸਤਰੀਆਂ ਪ੍ਰਸੰਨ ਹੋ ਗਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "सभ अबलनि आनंदु बढायो ॥",
      "sourceLineId": "123575",
      "sourceShabadId": "11532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਝੂਲਤਿ ਗੀਤਿ ਮਧੁਰ ਧੁਨਿ ਗਾਵਹਿ ॥",
      "transliteration": "jhoolat geet madhur dhun gaaveh ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਪੀਂਘਾ ਝੂਟਦੀਆਂ ਅਤੇ ਮਧੁਰ ਧੁਨ ਨਾਲ ਗੀਤ ਗਾਉਾਂਦੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "झूलति गीति मधुर धुनि गावहि ॥",
      "sourceLineId": "123576",
      "sourceShabadId": "11532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੁਨਤ ਨਾਦ ਕੋਕਿਲਾ ਲਜਾਵਹਿ ॥੨॥",
      "transliteration": "sunat naadh kokilaa lajaaveh ||2||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੀ) ਆਵਾਜ਼ ਨੂੰ ਸੁਣ ਕੇ ਕੋਇਲ ਵੀ ਸ਼ਰਮਿੰਦੀ ਹੁੰਦੀ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "सुनत नाद कोकिला लजावहि ॥२॥",
      "sourceLineId": "123577",
      "sourceShabadId": "11532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਉਤ ਘਨਘੋਰ ਘਟਾ ਘੁਹਰਾਵੈ ॥",
      "transliteration": "aut ghanaghor ghaTaa ghuharaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਧਰ ਕਾਲੀ ਘਟਾ ਗਰਜਨਾ ਕਰਨ ਲਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "उत घनघोर घटा घुहरावै ॥",
      "sourceLineId": "123578",
      "sourceShabadId": "11532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਇਤਿ ਮਿਲਿ ਗੀਤ ਚੰਚਲਾ ਗਾਵੈ ॥",
      "transliteration": "eit mil geet cha(n)chalaa gaavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਧਰ ਇਸਤਰੀਆਂ ਮਿਲ ਕੇ ਗੀਤ ਗਾਣ ਲਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "इति मिलि गीत चंचला गावै ॥",
      "sourceLineId": "123579",
      "sourceShabadId": "11532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਉਤ ਤੇ ਦਿਪਤ ਦਾਮਿਨੀ ਦਮਕੈ ॥",
      "transliteration": "aut te dhipat dhaaminee dhamakai ||",
      "translation": "",
      "punjabiViakhya": "ਉਧਰ ਬਿਜਲੀ ਦੀ ਜੋਤਿ ਲਿਸ਼ਕਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "उत ते दिपत दामिनी दमकै ॥",
      "sourceLineId": "123580",
      "sourceShabadId": "11532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਇਤ ਇਨ ਦਸਨ ਕਾਮਨਿਨ ਝਮਕੈ ॥੩॥",
      "transliteration": "eit in dhasan kaamanin jhamakai ||3||",
      "translation": "",
      "punjabiViakhya": "ਇਧਰ ਇਸਤਰੀਆਂ ਦੇ ਮੋਤੀਆਂ ਵਰਗੇ ਦੰਦ ਚਮਕਦੇ ਸਨ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "इत इन दसन कामनिन झमकै ॥३॥",
      "sourceLineId": "123581",
      "sourceShabadId": "11532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਿਤੁ ਰਾਜ ਪ੍ਰਭਾ ਇਕ ਰਾਜ ਦੁਲਾਰਨਿ ॥",
      "transliteration": "rit raaj prabhaa ik raaj dhulaaran ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ) ਰਿਤੁ ਰਾਜ ਪ੍ਰਭਾ ਨਾ ਦੀ ਇਕ ਰਾਜ ਦੁਲਾਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "रितु राज प्रभा इक राज दुलारनि ॥",
      "sourceLineId": "123582",
      "sourceShabadId": "11532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਾਹਿ ਪ੍ਰਭਾ ਸਮ ਰਾਜ ਕੁਮਾਰਿ ਨ ॥",
      "transliteration": "jaeh prabhaa sam raaj kumaar na ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਕਿਸੇ ਰਾਜ ਕੁਮਾਰੀ ਦੀ ਪ੍ਰਭਾ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "जाहि प्रभा सम राज कुमारि न ॥",
      "sourceLineId": "123583",
      "sourceShabadId": "11532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਪ੍ਰਮਾਨ ਤਾ ਕੀ ਛਬਿ ਸੋਹੈ ॥",
      "transliteration": "apramaan taa kee chhab sohai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਅਤਿ ਅਧਿਕ ਸੁੰਦਰਤਾ ਸ਼ੋਭਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "अप्रमान ता की छबि सोहै ॥",
      "sourceLineId": "123584",
      "sourceShabadId": "11532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਖਗ ਮ੍ਰਿਗ ਰਾਜ ਭੁਜੰਗਨ ਮੋਹੈ ॥੪॥",
      "transliteration": "khag mirag raaj bhuja(n)gan mohai ||4||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ) ਪੰਛੀ, ਹਿਰਨ ਅਤੇ ਨਾਗ-ਰਾਜ ਮੋਹਿਤ ਹੁੰਦੇ ਸਨ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "खग मृग राज भुजंगन मोहै ॥४॥",
      "sourceLineId": "123585",
      "sourceShabadId": "11532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੋ ਝੂਲਤ ਤਿਨ ਖਾਨ ਨਿਹਾਰੀ ॥",
      "transliteration": "so jhoolat tin khaan nihaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਪੀਂਘ ਝੂਟਦਿਆਂ ਖ਼ਾਨ ਨੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "सो झूलत तिन खान निहारी ॥",
      "sourceLineId": "123586",
      "sourceShabadId": "11532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗਿਰਿਯੋ ਭੂਮਿ ਜਨੁ ਲਗੀ ਕਟਾਰੀ ॥",
      "transliteration": "giriyo bhoom jan lagee kaTaaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਧਰਤੀ ਉਤੇ ਡਿਗ ਪਿਆ ਮਾਨੋ ਕਟਾਰ ਲਗ ਗਈ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "गिरियो भूमि जनु लगी कटारी ॥",
      "sourceLineId": "123587",
      "sourceShabadId": "11532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕੁਟਨੀ ਏਕ ਬੁਲਾਇ ਮੰਗਾਈ ॥",
      "transliteration": "kuTanee ek bulai ma(n)gaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਕ ਫਫੇਕੁਟਣੀ ਨੂੰ ਬੁਲਵਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "कुटनी एक बुलाइ मंगाई ॥",
      "sourceLineId": "123588",
      "sourceShabadId": "11532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਕਲ ਬ੍ਰਿਥਾ ਤਿਹ ਭਾਖ ਸੁਨਾਈ ॥੫॥",
      "transliteration": "sakal birathaa teh bhaakh sunaiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਸਾਰੀ ਗੱਲ ਦਸ ਦਿੱਤੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "सकल बृथा तिह भाख सुनाई ॥५॥",
      "sourceLineId": "123589",
      "sourceShabadId": "11532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਬਿਤੁ ॥",
      "transliteration": "kabit ||",
      "translation": "",
      "punjabiViakhya": "ਕਬਿੱਤ:",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "कबितु ॥",
      "sourceLineId": "123590",
      "sourceShabadId": "11533",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਆਈ ਹੁਤੀ ਬਨਿ ਏਕ ਬਾਲਾ ਰਾਗ ਮਾਲਾ ਸਮ ਮੇਰੇ ਗ੍ਰਿਹ ਮਾਝ ਦੀਪਮਾਲਾ ਜਨੁ ਵੈ ਗਈ ॥",
      "transliteration": "aaiee hutee ban ek baalaa raag maalaa sam mere gireh maajh dheepamaalaa jan vai giee ||",
      "translation": "",
      "punjabiViakhya": "ਬਨ ਵਿਚ ਰਾਗ-ਮਾਲਾ ਵਰਗੀ ਇਕ ਇਸਤਰੀ ਆਈ ਹੋਈ ਹੈ, ਮਾਨੋ ਮੇਰੇ (ਮਨ ਰੂਪ) ਘਰ ਵਿਚ ਦੀਵਿਆਂ ਦੀ ਪੰਗਤੀ ਜਗਾ ਗਈ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "आई हुती बनि एक बाला राग माला सम मेरे गृह माझ दीपमाला जनु वै गई ॥",
      "sourceLineId": "123591",
      "sourceShabadId": "11533",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਿਛੂਆ ਕੀ ਬਿਝਕ ਸੋ ਬਿਛੂ ਸੋ ਡਸਾਇ ਮਾਨੋ ਚੇਟਕ ਚਲਾਇ ਨਿਜੁ ਚੇਰੋ ਮੋਹਿ ਕੈ ਗਈ ॥",
      "transliteration": "bichhooaa kee bijhak so bichhoo so ddasai maano cheTak chalai nij chero moh kai giee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਪਾਏ ਹੋਏ ਬਿਛੂਆ ਦੀ ਬਿੜਕ ਮਾਨੋ ਬਿਛੂਆਂ ਵਾਗ ਡੰਗ ਗਈ ਹੋਵੇ। (ਉਹ) ਜਾਦੂ ਚਲਾ ਕੇ ਮੈਨੂੰ ਆਪਣਾ ਮਰੀਦ ਬਣਾ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "बिछूआ की बिझक सो बिछू सो डसाइ मानो चेटक चलाइ निजु चेरो मोहि कै गई ॥",
      "sourceLineId": "123592",
      "sourceShabadId": "11533",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦਸਨ ਕੀ ਦਿਪਤ ਦਿਵਾਨੇ ਦੇਵ ਦਾਨੌ ਕੀਨੇ ਨੈਨਨ ਕੀ ਕੋਰ ਸੌ ਮਰੋਰਿ ਮਨੁ ਲੈ ਗਈ ॥",
      "transliteration": "dhasan kee dhipat dhivaane dhev dhaanau keene nainan kee kor sau maror man lai giee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਦੰਦਾ ਦੀ ਲਿਸ਼ਕ ਨੇ ਦੇਵਤਿਆਂ ਅਤੇ ਦੈਂਤਾ ਨੂੰ ਦੀਵਾਨਾ ਬਣਾ ਦਿੱਤਾ ਹੈ ਅਤੇ (ਉਸ ਦੀਆਂ) ਅੱਖਾ ਦੀਆਂ ਕੋਰਾ ਮੇਰਾ ਮਨ ਮਰੋੜ ਕੇ ਲੈ ਗਈਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "दसन की दिपत दिवाने देव दानौ कीने नैनन की कोर सौ मरोरि मनु लै गई ॥",
      "sourceLineId": "123593",
      "sourceShabadId": "11533",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕੰਚਨ ਸੇ ਗਾਤ ਰਵਿ ਥੋਰਿਕ ਚਿਲਚਿਲਾਤ ਦਾਮਨੀ ਸੀ ਕਾਮਨੀ ਦਿਖਾਈ ਆਨਿ ਦੈ ਗਈ ॥੬॥",
      "transliteration": "ka(n)chan se gaat rav thorik chilachilaat dhaamanee see kaamanee dhikhaiee aan dhai giee ||6||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਸੋਨੇ ਵਰਗੇ ਸ਼ਰੀਰ ਸਾਹਮਣੇ ਸੂਰਜ ਥੋੜਾ ਜਿੰਨਾ ਹੀ ਚਮਦਾ ਸੀ। (ਸਚਮੁਚ) ਬਿਜਲੀ ਵਰਗੀ ਇਸਤਰੀ ਮੈਨੂੰ ਵਿਖਾਲੀ ਦੇ ਗਈ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "कंचन से गात रवि थोरिक चिलचिलात दामनी सी कामनी दिखाई आनि दै गई ॥६॥",
      "sourceLineId": "123594",
      "sourceShabadId": "11533",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123595",
      "sourceShabadId": "11534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜੌ ਮੁਹਿ ਤਿਹ ਤੂ ਆਨਿ ਮਿਲਾਵੈ ॥",
      "transliteration": "jau muh teh too aan milaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਉਸ ਨੂੰ ਤੂੰ ਮੈਨੂੰ ਆਣ ਕੇ ਮਿਲਾ ਦੇਵੇਾਂ",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "जौ मुहि तिह तू आनि मिलावै ॥",
      "sourceLineId": "123596",
      "sourceShabadId": "11534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਪੁਨੇ ਮੁਖ ਮਾਗੇ ਸੌ ਪਾਵੈ ॥",
      "transliteration": "apune mukh maage sau paavai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਆਪਣੇ ਮੂੰਹ ਤੋਂ ਮੰਗਿਆ ਇਨਾਮ ਹਾਸਲ ਕਰੇਾਂਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "अपुने मुख मागे सौ पावै ॥",
      "sourceLineId": "123597",
      "sourceShabadId": "11534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰੁਤਿਸ ਪ੍ਰਭਾ ਤਨਿ ਕੈ ਰਤਿ ਕਰੌਂ ॥",
      "transliteration": "rutis prabhaa tan kai rat karaua(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰੁਤਿਸ ਪ੍ਰਭਾ ਨਾਲ (ਮੈਂ) ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਾਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "रुतिस प्रभा तनि कै रति करौं ॥",
      "sourceLineId": "123598",
      "sourceShabadId": "11534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਤਰ ਮਾਰਿ ਕਟਾਰੀ ਮਰੌਂ ॥੭॥",
      "transliteration": "naatar maar kaTaaree maraua(n) ||7||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਕਟਾਰ ਮਾਰ ਕੇ ਮਰ ਜਾਵਾਗਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "नातर मारि कटारी मरौं ॥७॥",
      "sourceLineId": "123599",
      "sourceShabadId": "11534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123600",
      "sourceShabadId": "11535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰੁਤਿਸ ਪ੍ਰਭਾ ਕੀ ਅਤਿ ਪ੍ਰਭਾ ਜਬ ਤੇ ਲਖੀ ਬਨਾਇ ॥",
      "transliteration": "rutis prabhaa kee at prabhaa jab te lakhee banai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਦਾ ਰੁਤਿਸ ਪ੍ਰਭਾ ਦੀ ਅਤਿ ਸੁੰਦਰਤਾ ਨੂੰ ਵੇਖਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "रुतिस प्रभा की अति प्रभा जब ते लखी बनाइ ॥",
      "sourceLineId": "123601",
      "sourceShabadId": "11535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚੁਭਿ ਚਿਤ ਕੇ ਭੀਤਰ ਰਹੀ ਮੁਖ ਤੇ ਕਹੀ ਨ ਜਾਇ ॥੮॥",
      "transliteration": "chubh chit ke bheetar rahee mukh te kahee na jai ||8||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮੇਰੇ ਚਿਤ ਵਿਚ ਚੁਭ ਗਈ ਹੈ, ਮੁਖ ਤੋਂ ਕੁਝ ਕਿਹਾ ਨਹੀਂ ਜਾ ਸਕਦਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "चुभि चित के भीतर रही मुख ते कही न जाइ ॥८॥",
      "sourceLineId": "123602",
      "sourceShabadId": "11535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮੋ ਤੋ ਛਬਿ ਨ ਕਹੀ ਪਰੈ ਸ੍ਰੀ ਰਿਤੁ ਰਾਜ ਕੁਮਾਰਿ ॥",
      "transliteration": "mo to chhab na kahee parai sree rit raaj kumaar ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਪਾਸੋਂ ਰਿਤੁ ਰਾਜ ਕੁਮਾਰੀ ਦੀ ਸੁੰਦਰਤਾ ਦਾ ਬਿਆਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "मो तो छबि न कही परै स्री रितु राज कुमारि ॥",
      "sourceLineId": "123603",
      "sourceShabadId": "11535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜੀਭਿ ਮਧੁਰ ਹ੍ਵੈ ਜਾਤ ਹੈ ਬਰਨਤ ਪ੍ਰਭਾ ਅਪਾਰ ॥੯॥",
      "transliteration": "jeebh madhur havai jaat hai baranat prabhaa apaar ||9||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਅਪਾਰ ਸੁੰਦਰਤਾ ਦਾ ਵਰਣਨ ਕਰਦਿਆਂ ਜੀਭ ਵੀ ਮਿਠੀ ਹੋ ਜਾਦੀ ਹੈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "जीभि मधुर ह्वै जात है बरनत प्रभा अपार ॥९॥",
      "sourceLineId": "123604",
      "sourceShabadId": "11535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਬਿਤੁ ॥",
      "transliteration": "kabit ||",
      "translation": "",
      "punjabiViakhya": "ਕਬਿੱਤ:",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "कबितु ॥",
      "sourceLineId": "123605",
      "sourceShabadId": "11536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਆਂਖਿ ਰਸ ਗਿਰਿਯੋ ਤਾ ਤੇ ਆਂਬ ਪ੍ਰਗਟਤ ਭਏ ਜਿਹਵਾ ਰਸ ਹੂ ਤੇ ਜਰਦਾਲੂ ਲਹਿਯਤੁ ਹੈ ॥",
      "transliteration": "aa(n)kh ras giriyo taa te aa(n)b pragaTat bhe jihavaa ras hoo te jaradhaaloo lahiyat hai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀਆਂ) ਅੱਖਾ ਦਾ ਰਸ ਡਿਗਿਆ ਤਾ ਅੰਬ ਪ੍ਰਗਟ ਹੋਇਆ, ਜੀਭ ਦੇ ਰਸ ਤੋਂ ਖ਼ੁਰਮਾਨੀਆਂ ('ਜਰਦਾਲੂ') ਬਣੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "आँखि रस गिरियो ता ते आँब प्रगटत भए जिहवा रस हू ते जरदालू लहियतु है ॥",
      "sourceLineId": "123606",
      "sourceShabadId": "11536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮੁਖ ਰਸ ਹੂ ਕੌ ਮਧੁ ਪਾਨ ਕੈ ਬਖਾਨਿਯਤ ਜਾ ਕੇ ਨੈਕ ਚਾਖੈ ਸਦਾ ਜੀਯਤ ਰਹਿਯਤੁ ਹੈ ॥",
      "transliteration": "mukh ras hoo kau madh paan kai bakhaaniyat jaa ke naik chaakhai sadhaa jeeyat rahiyat hai ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਖ ਦੇ ਰਸ ਤੋਂ ਅੰਮ੍ਰਿਤ ਬਣਿਆ ਹੈ ਜਿਸ ਨੂੰ ਚਖਣ ਨਾਲ ਸਦਾ ਜੀਉਾਂਦੇ ਰਹੀਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "मुख रस हू कौ मधु पान कै बखानियत जा के नैक चाखै सदा जीयत रहियतु है ॥",
      "sourceLineId": "123607",
      "sourceShabadId": "11536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਕ ਕੌ ਨਿਰਖਿ ਨਿਸਿਰਾਟ ਨਿਸਿ ਰਾਜਾ ਭਯੋ ਜਾ ਕੀ ਸਭ ਜਗਤ ਕੌ ਜੌਨ ਚਹਿਯਤੁ ਹੈ ॥",
      "transliteration": "naak kau nirakh nisiraaT nis raajaa bhayo jaa kee sabh jagat kau jauan chahiyat hai ||",
      "translation": "",
      "punjabiViakhya": "ਨਕ ਨੂੰ ਵੇਖ ਕੇ ਚੰਦ੍ਰਮਾ ਰਾਤ ਦਾ ਰਾਜਾ ਬਣਿਆ ਹੈ, ਜਿਸ ਦੀ ਚਾਦਨੀ ('ਜੌਨ') ਸਾਰੇ ਸੰਸਾਰ ਨੂੰ ਚਾਹੀਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "नाक कौ निरखि निसिराट निसि राजा भयो जा की सभ जगत कौ जौन चहियतु है ॥",
      "sourceLineId": "123608",
      "sourceShabadId": "11536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦਾਤਨ ਤੇ ਭਯੋ ਦਾਖ ਦਾਰਿਮ ਬਖਾਨਿਯਤ ਅਧਰ ਤੇ ਭਯੋ ਤਾਹਿ ਊਖ ਕਹਿਯਤੁ ਹੈ ॥੧੦॥",
      "transliteration": "dhaatan te bhayo dhaakh dhaarim bakhaaniyat adhar te bhayo taeh uookh kahiyat hai ||10||",
      "translation": "",
      "punjabiViakhya": "ਦੰਦਾ ਤੋਂ ਅੰਗੂਰ ਅਤੇ ਅਨਾਰ ਬਣੇ ਕਹੇ ਜਾਦੇ ਹਨ ਅਤੇ ਬੁਲ੍ਰਹਾ ਤੋਂ ਗੰਨਾ ਬਣਿਆ ਕਿਹਾ ਜਾਦਾ ਹੈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1069,
      "hindi": "",
      "hindiTransliteration": "दातन ते भयो दाख दारिम बखानियत अधर ते भयो ताहि ऊख कहियतु है ॥१०॥",
      "sourceLineId": "123609",
      "sourceShabadId": "11536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1069_line_0048",
      "lineIndex": 48,
