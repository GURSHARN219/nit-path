{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1070,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1070_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕੁਟਨੀ ਬਚਨ ਸੁਨਤ ਏ ਧਾਈ ॥",
      "transliteration": "kuTanee bachan sunat e dhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਫਫੇਕੁਟਣੀ ਇਹ ਬਚਨ ਸੁਣ ਕੇ ਚਲ ਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "कुटनी बचन सुनत ए धाई ॥",
      "sourceLineId": "123611",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਾਹਿ ਝੁਲਾਵਨ ਕੇ ਮਿਸੁ ਲ੍ਯਾਈ ॥",
      "transliteration": "taeh jhulaavan ke mis layaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ (ਪੀਂਘ) ਝੂਟਣ ਦੇ ਬਹਾਨੇ ਨਾਲ ਲੈ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "ताहि झुलावन के मिसु ल्याई ॥",
      "sourceLineId": "123612",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਬ ਤਿਹ ਆਨ ਖਾਨ ਗਹਿ ਲੀਨੋ ॥",
      "transliteration": "tab teh aan khaan geh leeno ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਨੂੰ ਖ਼ਾਨ ਨੇ ਆ ਕੇ ਪਕੜ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "तब तिह आन खान गहि लीनो ॥",
      "sourceLineId": "123613",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚਕਿਚਿਤ ਚਰਿਤ ਚੰਚਲਾ ਕੀਨੋ ॥੧੧॥",
      "transliteration": "chakichit charit cha(n)chalaa keeno ||11||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਇਸਤਰੀ ਨੇ ਹੈਰਾਨ ਕਰ ਦੇਣ ਵਾਲਾ ਚਰਿਤ੍ਰ ਕੀਤਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "चकिचित चरित चंचला कीनो ॥११॥",
      "sourceLineId": "123614",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤੁਮਰੇ ਇਹੀ ਨਿਮਿਤ ਮੈ ਆਈ ॥",
      "transliteration": "tumare ihee nimit mai aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਤਾ ਤੇਰੇ ਲਈ ਹੀ ਆਈ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "तुमरे इही निमित मै आई ॥",
      "sourceLineId": "123615",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਬ ਫੂਲਨ ਮੁਹਿ ਦਈ ਦਿਖਾਈ ॥",
      "transliteration": "ab foolan muh dhiee dhikhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਹੁਣ ਮੈਨੂੰ ਮਾਹਵਾਰੀ ('ਫੂਲਨ') ਸ਼ੁਰੂ ਹੋ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "अब फूलन मुहि दई दिखाई ॥",
      "sourceLineId": "123616",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਬ ਮੁਹਿ ਜਾਨ ਧਾਮ ਕੌ ਦੀਜੈ ॥",
      "transliteration": "ab muh jaan dhaam kau dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੈਨੂੰ ਘਰ ਜਾਣ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "अब मुहि जान धाम कौ दीजै ॥",
      "sourceLineId": "123617",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪਰਸੌਂ ਬੋਲਿ ਕਲੋਲ ਕਰੀਜੈ ॥੧੨॥",
      "transliteration": "parasaua(n) bol kalol kareejai ||12||",
      "translation": "",
      "punjabiViakhya": "ਪਰਸੋਂ ਬੁਲਾ ਕੇ ਕਲੋਲ ਕਰਨਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "परसौं बोलि कलोल करीजै ॥१२॥",
      "sourceLineId": "123618",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਤਿ ਮਦ ਪਾਨ ਖਾਨ ਤੁਮ ਕੀਜਹੁ ॥",
      "transliteration": "at madh paan khaan tum keejahu ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਿਨ) ਹੇ ਖ਼ਾਨ! ਤੁਸੀਂ ਬਹੁਤ ਸ਼ਰਾਬ ਪੀਣੀ",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "अति मद पान खान तुम कीजहु ॥",
      "sourceLineId": "123619",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਲਪਟਿ ਲਪਟਿ ਮੋ ਕਹੁ ਸੁਖ ਦੀਜਹੁ ॥",
      "transliteration": "lapaT lapaT mo kahu sukh dheejahu ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲਿਪਟ ਲਿਪਟ ਕੇ ਮੈਨੂੰ ਸੁਖ ਦੇਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "लपटि लपटि मो कहु सुख दीजहु ॥",
      "sourceLineId": "123620",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪਰਸੌਂ ਅਰਧ ਰਾਤ੍ਰਿ ਮੈ ਐਹੌ ॥",
      "transliteration": "parasaua(n) aradh raatr mai aaihau ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਸੋਂ ਮੈਂ ਅੱਧੀ ਰਾਤ ਨੂੰ ਆਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "परसौं अरध रातृ मै ऐहौ ॥",
      "sourceLineId": "123621",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤੁਮਰੀ ਦੁਹਿਤਾ ਕੇ ਢਿਗ ਸ੍ਵੈਹੌ ॥੧੩॥",
      "transliteration": "tumaree dhuhitaa ke ddig savaihau ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੁਹਾਡੀ ਪੁੱਤਰੀ ਦੇ ਨਾਲ ਸਵਾਗੀ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "तुमरी दुहिता के ढिग स्वैहौ ॥१३॥",
      "sourceLineId": "123622",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਯੌ ਕਰਿ ਬੋਲ ਖਾਨ ਤਜਿ ਦੀਨੀ ॥",
      "transliteration": "yau kar bol khaan taj dheenee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਜਦੋਂ ਇਸ ਤਰ੍ਰਹਾ ਗੱਲ ਕੀਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "यौ करि बोल खान तजि दीनी ॥",
      "sourceLineId": "123623",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪਰਸੌ ਕੀ ਚਿੰਤਾ ਚਿਤ ਕੀਨੀ ॥",
      "transliteration": "parasau kee chi(n)taa chit keenee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਖ਼ਾਨ ਨੇ ਛਡ ਦਿੱਤਾ ਅਤੇ ਮਨ ਵਿਚ ਪਰਸੋਂ ਬਾਰੇ ਸੋਚਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "परसौ की चिंता चित कीनी ॥",
      "sourceLineId": "123624",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਬ ਰਿਤੁ ਰਾਜ ਪ੍ਰਭਾ ਚਲਿ ਆਈ ॥",
      "transliteration": "tab rit raaj prabhaa chal aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਿਤੁ ਰਾਜ ਪ੍ਰਭਾ ਚਲ ਕੇ ਆ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "तब रितु राज प्रभा चलि आई ॥",
      "sourceLineId": "123625",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਵਾ ਦੁਹਿਤਾ ਢਿਗ ਸੇਜ ਬਿਛਾਈ ॥੧੪॥",
      "transliteration": "vaa dhuhitaa ddig sej bichhaiee ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੀ ਪੁੱਤਰੀ ਦੇ ਨੇੜੇ ਸੇਜ ਵਿਛਾ ਲਈ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "वा दुहिता ढिग सेज बिछाई ॥१४॥",
      "sourceLineId": "123626",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੋਏ ਲੋਗ ਧਾਮ ਉਠਿ ਗਈ ॥",
      "transliteration": "soe log dhaam uTh giee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਲੋਕੀਂ ਸੌਂ ਗਏ (ਤਾ ਉਹ) ਉਠ ਕੇ ਘਰ ਆ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "सोए लोग धाम उठि गई ॥",
      "sourceLineId": "123627",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਿਮਰਤ ਖਾਨ ਘਰੀ ਸੋ ਭਈ ॥",
      "transliteration": "simarat khaan gharee so bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਇਧਰ ਉਸ ਨੂੰ) ਯਾਦ ਕਰਦਿਆਂ ਖ਼ਾਨ ਦੀ ਇਕ ਘੜੀ ਬੀਤ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "सिमरत खान घरी सो भई ॥",
      "sourceLineId": "123628",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਿਸੁ ਸਿਗਰੀ ਤਿਹ ਕਹ ਜਗਵਾਯੋ ॥",
      "transliteration": "nis sigaree teh keh jagavaayo ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਰਾਤ ਉਸ ਨੂੰ ਜਗਾਈ ਰਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "निसु सिगरी तिह कह जगवायो ॥",
      "sourceLineId": "123629",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਖੋਜਤ ਤਾਹਿ ਸੁਤਾ ਢਿਗ ਆਯੋ ॥੧੫॥",
      "transliteration": "khojat taeh sutaa ddig aayo ||15||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਖਿਰ ਲਭਦਿਆਂ ਲਭਦਿਆਂ ਪੁੱਤਰੀ ਕੋਲ ਆਇਆ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "खोजत ताहि सुता ढिग आयो ॥१५॥",
      "sourceLineId": "123630",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰੁਤਿਸ ਪ੍ਰਭਾ ਦੁਹਿਤਾ ਲਖਿ ਧਰੀ ॥",
      "transliteration": "rutis prabhaa dhuhitaa lakh dharee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਪੁੱਤਰੀ ਨੂੰ ਰੁਤਿਸ ਪ੍ਰਭਾ ਸਮਝ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "रुतिस प्रभा दुहिता लखि धरी ॥",
      "sourceLineId": "123631",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦ੍ਰਿੜ ਗਹਿ ਜਾਘ ਦੋਊ ਰਤਿ ਕਰੀ ॥",
      "transliteration": "dhiraR geh jaagh dhouoo rat karee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਵੇਾਂ ਟੰਗਾ ਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਪਕੜ ਕੇ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "दृड़ गहि जाघ दोऊ रति करी ॥",
      "sourceLineId": "123632",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਾਇ ਹਾਇ ਕਰਿ ਰਹੀ ਪਠਾਨੀ ॥",
      "transliteration": "hai hai kar rahee paThaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਪਠਾਣੀ ਹਾਇ ਹਾਇ ਕਰਦੀ ਰਹੀ",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "हाइ हाइ करि रही पठानी ॥",
      "sourceLineId": "123633",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮਦ ਪੀਏ ਜੜ ਕਛੂ ਨ ਜਾਨੀ ॥੧੬॥",
      "transliteration": "madh pe'ee jaR kachhoo na jaanee ||16||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਰਾਬ ਪੀਣ ਕਰ ਕੇ ਮੂਰਖ ਨੇ ਕੁਝ ਨਾ ਸਮਝਿਆ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "मद पीए जड़ कछू न जानी ॥१६॥",
      "sourceLineId": "123634",
      "sourceShabadId": "11537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123635",
      "sourceShabadId": "11538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਲਪਟਿ ਲਪਟਿ ਤਾ ਸੌ ਰਮਿਯੋ ਰੁਤਿਸ ਪ੍ਰਭਾ ਤਿਹ ਜਾਨਿ ॥",
      "transliteration": "lapaT lapaT taa sau ramiyo rutis prabhaa teh jaan ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਰੁਤਿਸ ਪ੍ਰਭਾ ਸਮਝ ਕੇ ਉਸ ਨਾਲ ਲਿਪਟ ਲਿਪਟ ਕੇ ਰਮਣ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "लपटि लपटि ता सौ रमियो रुतिस प्रभा तिह जानि ॥",
      "sourceLineId": "123636",
      "sourceShabadId": "11538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਦ ਉਤਰੇ ਤਿਹ ਤਜਿ ਦਿਯੋ ਅਪਨੀ ਸੁਤਾ ਪਛਾਨਿ ॥੧੭॥",
      "transliteration": "madh utare teh taj dhiyo apanee sutaa pachhaan ||17||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਰਾਬ ਦੇ ਨਸ਼ੇ ਦੇ ਉਤਰਨ ਤੇ ਉਸ ਨੂੰ ਆਪਣੀ ਪੁੱਤਰੀ ਵਜੋਂ ਪਛਾਣ ਕੇ ਤਿਆਗ ਦਿੱਤਾ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "मद उतरे तिह तजि दियो अपनी सुता पछानि ॥१७॥",
      "sourceLineId": "123637",
      "sourceShabadId": "11538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਧੰਨ੍ਯ ਛਤ੍ਰਿ ਜਾ ਕੋ ਧਰਮ ਸ੍ਰੀ ਰਿਤੁ ਰਾਜਿ ਕੁਮਾਰਿ ॥",
      "transliteration": "dha(n)nay chhatr jaa ko dharam sree rit raaj kumaar ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਿਤੁ ਰਾਜ ਕੁਮਾਰੀ! ਤੇਰਾ ਛਤ੍ਰੀ ਧਰਮ ਧੰਨ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "धंन्य छतृ जा को धरम स्री रितु राजि कुमारि ॥",
      "sourceLineId": "123638",
      "sourceShabadId": "11538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੰਗ ਸੁਤਾ ਕੇ ਕੈ ਮੁਝੈ ਗੀ ਪਤਿਬ੍ਰਤਾ ਉਬਾਰਿ ॥੧੮॥",
      "transliteration": "sa(n)g sutaa ke kai mujhai gee patibrataa ubaar ||18||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਮੈਨੂੰ ਪੁੱਤਰੀ ਨਾਲ ਸਵਾ ਕੇ ਆਪਣੇ ਪਤੀਬ੍ਰਤਾ ਧਰਮ ਨੂੰ ਬਚਾ ਲਿਆ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "संग सुता के कै मुझै गी पतिब्रता उबारि ॥१८॥",
      "sourceLineId": "123639",
      "sourceShabadId": "11538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਏਕ ਮਦੀ ਦੂਜੈ ਤਰੁਨਿ ਤੀਜੇ ਅਤਿ ਧਨ ਧਾਮ ॥",
      "transliteration": "ek madhee dhoojai tarun teeje at dhan dhaam ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਸ਼ਰਾਬੀ, ਦੂਜਾ ਜਵਾਨ ਅਤੇ ਤੀਜਾ ਘਰ ਵਿਚ ਧਨ ਬਹੁਤ ਹੋਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "एक मदी दूजै तरुनि तीजे अति धन धाम ॥",
      "sourceLineId": "123640",
      "sourceShabadId": "11538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪਾਪ ਕਰੇ ਬਿਨ ਕ੍ਯੋਨ ਬਚੈ ਬਚੈ ਬਚਾਵੈ ਰਾਮ ॥੧੯॥",
      "transliteration": "paap kare bin kayon bachai bachai bachaavai raam ||19||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਪਾਪ ਕੀਤੇ ਬਿਨਾ ਕਿਵੇਾਂ ਬਚ ਸਕਦਾ ਹੈ, (ਤਦ ਹੀ) ਬਚ ਸਕਦਾ ਹੈ, ਜੇ ਰਾਮ ਬਚਾਏ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "पाप करे बिन क्योन बचै बचै बचावै राम ॥१९॥",
      "sourceLineId": "123641",
      "sourceShabadId": "11538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਤਿਰਾਸੀਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੮੩॥੩੫੨੯॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau tiraaseevo charitr samaapatam sat subham sat ||183||3529||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੮੩ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੮੩॥੩੫੨੯॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ तिरासीवो चरित्र समापतम सतु सुभम सतु ॥१८३॥३५२९॥अफजूँ॥",
      "sourceLineId": "123642",
      "sourceShabadId": "11538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123643",
      "sourceShabadId": "11539",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪਾਡਵ ਕੇ ਪਾਚੌ ਸੁਤ ਸੂਰੇ ॥",
      "transliteration": "paaddav ke paachau sut soore ||",
      "translation": "",
      "punjabiViakhya": "ਪੰਡੂ ਰਾਜੇ ਦੇ ਪੰਜੇ ਪੁੱਤਰ ਬਹੁਤ ਤਕੜੇ ਸੂਰਮੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "पाडव के पाचौ सुत सूरे ॥",
      "sourceLineId": "123644",
      "sourceShabadId": "11539",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਰਜੁਨ ਭੀਮ ਜੁਧਿਸਟਰ ਰੂਰੇ ॥",
      "transliteration": "arajun bheem judhisaTar roore ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸੁੰਦਰ ਅਰਜਨ, ਭੀਮ, ਯੁਧਿਸ਼ਟਰ,",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "अरजुन भीम जुधिसटर रूरे ॥",
      "sourceLineId": "123645",
      "sourceShabadId": "11539",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਕੁਲ ਅਵਰ ਸਹਦੇਵ ਭਨਿਜੈ ॥",
      "transliteration": "nakul avar sahadhev bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਨਕੁਲ ਅਤੇ ਸਹਿਦੇਵ ਕਹੇ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "नकुल अवर सहदेव भनिजै ॥",
      "sourceLineId": "123646",
      "sourceShabadId": "11539",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਾ ਸਮ ਉਪਜਿਯੋ ਕੌਨ ਕਹਿਜੈ ॥੧॥",
      "transliteration": "jaa sam upajiyo kauan kahijai ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਵਰਗਾ ਹੋਰ ਕਿਹੜਾ ਪੈਦਾ ਹੋਇਆ ਹੈ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "जा सम उपजियो कौन कहिजै ॥१॥",
      "sourceLineId": "123647",
      "sourceShabadId": "11539",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਾਰਹ ਬਰਖ ਬਨਬਾਸ ਬਿਤਾਯੋ ॥",
      "transliteration": "baareh barakh banabaas bitaayo ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਰ੍ਰਹਾ ਸਾਲ ਬਨਬਾਸ ਬਿਤਾਉਣ ਤੋਂ ਬਾਦ",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "बारह बरख बनबास बितायो ॥",
      "sourceLineId": "123648",
      "sourceShabadId": "11539",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੋਈ ਬਰਖ ਤ੍ਰੈਦਸੋ ਆਯੋ ॥",
      "transliteration": "soiee barakh traidhaso aayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਤੇਰ੍ਰਹਵਾ ਵਰ੍ਰਹਾ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "सोई बरख त्रैदसो आयो ॥",
      "sourceLineId": "123649",
      "sourceShabadId": "11539",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੇਸ ਬਿਰਾਟ ਰਾਜ ਕੇ ਗਏ ॥",
      "transliteration": "dhes biraaT raaj ke ge ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਵਿਰਾਟ ਦੇ ਰਾਜੇ ਕੋਲ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "देस बिराट राज के गए ॥",
      "sourceLineId": "123650",
      "sourceShabadId": "11539",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੋਊ ਬਰਖ ਬਿਤਾਵਤ ਭਏ ॥੨॥",
      "transliteration": "souoo barakh bitaavat bhe ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਹੀ (ਇਹ ਤੇਰ੍ਰਹਵਾ) ਸਾਲ ਬਤੀਤ ਕੀਤਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "सोऊ बरख बितावत भए ॥२॥",
      "sourceLineId": "123651",
      "sourceShabadId": "11539",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123652",
      "sourceShabadId": "11540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਬੈ ਕ੍ਰੀਚਕਹਿ ਦ੍ਰੁਪਦਜਾ ਦੇਖੀ ਨੈਨ ਪਸਾਰਿ ॥",
      "transliteration": "jabai kreechakeh dhrupadhajaa dhekhee nain pasaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਕ੍ਰੀਚਕ ਨੇ ਦ੍ਰੋਪਤੀ ਨੂੰ ਅੱਖਾ ਖੋਲ੍ਰਹ ਕੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "जबै क्रीचकहि द्रुपदजा देखी नैन पसारि ॥",
      "sourceLineId": "123653",
      "sourceShabadId": "11540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗਿਰਿਯੋ ਮੂਰਛਨਾ ਹ੍ਵੈ ਧਰਨਿ ਮਾਰਿ ਕਰਿਯੋ ਬਿਸੰਭਾਰ ॥੩॥",
      "transliteration": "giriyo moorachhanaa havai dharan maar kariyo bisa(n)bhaar ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮੂਰਛਿਤ ਹੋ ਕੇ ਧਰਤੀ ਉਤੇ ਡਿਗ ਪਿਆ, ਕਾਮ ਦੇਵ ('ਮਾਰ') ਨੇ ਉਸ ਨੂੰ ਬੇਸੁੱਧ ਕਰ ਦਿੱਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "गिरियो मूरछना ह्वै धरनि मारि करियो बिसंभार ॥३॥",
      "sourceLineId": "123654",
      "sourceShabadId": "11540",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123655",
      "sourceShabadId": "11541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪ੍ਰਗਟ ਭਗਨਿ ਤਨੁ ਭੇਦ ਜਤਾਯੋ ॥",
      "transliteration": "pragaT bhagan tan bhedh jataayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਕ੍ਰੀਚਕ) ਨੇ ਆਪਣੀ ਭੈਣ ਨੂੰ ਭੇਦ ਦੀ ਗੱਲ ਦਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "प्रगट भगनि तनु भेद जतायो ॥",
      "sourceLineId": "123656",
      "sourceShabadId": "11541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮਿਲਨ ਦ੍ਰੁਪਦਜਾ ਕੋ ਠਹਰਾਯੋ ॥",
      "transliteration": "milan dhrupadhajaa ko Thaharaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦ੍ਰੋਪਤੀ ਨੂੰ ਮਿਲਣ ਦੀ ਗੱਲ ਪਕੀ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "मिलन द्रुपदजा को ठहरायो ॥",
      "sourceLineId": "123657",
      "sourceShabadId": "11541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਾਨੀ ਪਠੈ ਸਦੇਸਨ ਦਈ ॥",
      "transliteration": "raanee paThai sadhesan dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ (ਦ੍ਰੋਪਤੀ) ਨੂੰ ਸੁਨੇਹਾ ਭੇਜ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "रानी पठै सदेसन दई ॥",
      "sourceLineId": "123658",
      "sourceShabadId": "11541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਰ ਤੇ ਪਕਰਿ ਕਰੀਚਕ ਲਈ ॥੪॥",
      "transliteration": "kar te pakar kareechak liee ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕ੍ਰੀਚਕ ਨੇ (ਉਸ ਨੂੰ) ਹੱਥ ਨਾਲ ਪਕੜ ਲਿਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "कर ते पकरि करीचक लई ॥४॥",
      "sourceLineId": "123659",
      "sourceShabadId": "11541",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123660",
      "sourceShabadId": "11542",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਰਿ ਕੈ ਕਰਿ ਕੋ ਅਧਿਕ ਬਲੁ ਅੰਚਰ ਗਈ ਛੁਰਾਇ ॥",
      "transliteration": "kar kai kar ko adhik bal a(n)char giee chhurai ||",
      "translation": "",
      "punjabiViakhya": "ਹੱਥ ਦਾ ਖ਼ੂਬ ਜ਼ੋਰ ਲਗਾ ਕੇ (ਦ੍ਰੋਪਤੀ) ਆਪਣਾ ਅੰਚਲ ਛੁੜਾ ਕੇ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "करि कै करि को अधिक बलु अंचर गई छुराइ ॥",
      "sourceLineId": "123661",
      "sourceShabadId": "11542",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਨੁ ਕਰਿ ਹੇਰੇ ਸ੍ਵਾਨ ਕੌ ਭਜਤ ਮ੍ਰਿਗੀ ਅਕੁਲਾਇ ॥੫॥",
      "transliteration": "jan kar here savaiaan kau bhajat miragee akulai ||5||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਕੁਤੇ ਨੂੰ ਵੇਖ ਕੇ ਹਿਰਨੀ ਵਿਆਕੁਲ ਹੋ ਕੇ ਭਜ ਜਾਦੀ ਹੋਵੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "जनु करि हेरे स्वान कौ भजत मृगी अकुलाइ ॥५॥",
      "sourceLineId": "123662",
      "sourceShabadId": "11542",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123663",
      "sourceShabadId": "11543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤਬ ਅਤਿ ਕੋਪ ਕਰੀਚਕ ਕਯੋ ॥",
      "transliteration": "tab at kop kareechak kayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕ੍ਰੀਚਕ ਨੇ ਬਹੁਤ ਕ੍ਰੋਧ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "तब अति कोप करीचक कयो ॥",
      "sourceLineId": "123664",
      "sourceShabadId": "11543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਰਾਜਾ ਹੁਤੋ ਜਹਾ ਤਹ ਅਯੋ ॥",
      "transliteration": "raajaa huto jahaa teh ayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਥੇ ਆਇਆ ਜਿਥੇ ਰਾਜਾ ਬੈਠਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "राजा हुतो जहा तह अयो ॥",
      "sourceLineId": "123665",
      "sourceShabadId": "11543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਪਾਦ ਪ੍ਰਹਾਰ ਦ੍ਰੁਪਦ ਯਹਿ ਕਿਯੋ ॥",
      "transliteration": "paadh prahaar dhrupadh yeh kiyo ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਦ੍ਰੋਪਤੀ ਉਤੇ ਉਸ ਨੇ ਪੈਰਾ ਦਾ ਵਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "पाद प्रहार द्रुपद यहि कियो ॥",
      "sourceLineId": "123666",
      "sourceShabadId": "11543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਪਾਚੋ ਨਿਰਖਿ ਪੰਡ ਜਨ ਲਿਯੋ ॥੬॥",
      "transliteration": "paacho nirakh pa(n)dd jan liyo ||6||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਪੰਜਾ ਪਾਡਵਾ ਨੇ ਵੇਖ ਲਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "पाचो निरखि पंड जन लियो ॥६॥",
      "sourceLineId": "123667",
      "sourceShabadId": "11543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਅਤਿ ਹੀ ਕੋਪ ਭੀਮ ਤਬ ਭਰਿਯੋ ॥",
      "transliteration": "at hee kop bheem tab bhariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਭੀਮ ਬਹੁਤ ਕ੍ਰੋਧ ਨਾਲ ਭਰ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "अति ही कोप भीम तब भरियो ॥",
      "sourceLineId": "123668",
      "sourceShabadId": "11543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਰਾਜੈ ਮਨੇ ਨੈਨ ਸੌ ਕਰਿਯੋ ॥",
      "transliteration": "raajai mane nain sau kariyo ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਰਾਜੇ (ਯੁਧਿਸ਼ਟਰ) ਨੇ ਅੱਖ ਦੇ ਇਸ਼ਾਰੇ ਨਾਲ ਰੋਕ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "राजै मने नैन सौ करियो ॥",
      "sourceLineId": "123669",
      "sourceShabadId": "11543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਬੋਲ ਦ੍ਰੁਪਦਜਾ ਨਿਕਟ ਸਿਖਾਈ ॥",
      "transliteration": "bol dhrupadhajaa nikaT sikhaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਦ੍ਰੋਪਤੀ ਨੂੰ ਕੋਲ ਬੁਲਾ ਕੇ ਸਿਖਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "बोल द्रुपदजा निकट सिखाई ॥",
      "sourceLineId": "123670",
      "sourceShabadId": "11543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਸੌ ਕ੍ਰੀਚਕ ਸੌ ਕਹੋ ਬਨਾਈ ॥੭॥",
      "transliteration": "sau kreechak sau kaho banaiee ||7||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੂੰ ਕ੍ਰੀਚਕ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "सौ क्रीचक सौ कहो बनाई ॥७॥",
      "sourceLineId": "123671",
      "sourceShabadId": "11543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123672",
      "sourceShabadId": "11544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਚਤੁਰਿ ਦ੍ਰੁਪਦਜਾ ਅਤਿ ਹੁਤੀ ਅਰੁ ਪਤਿ ਕਹਿਯੋ ਬਨਾਇ ॥",
      "transliteration": "chatur dhrupadhajaa at hutee ar pat kahiyo banai ||",
      "translation": "",
      "punjabiViakhya": "ਦ੍ਰੋਪਤੀ ਬਹੁਤ ਚਤੁਰ ਸੀ ਹੀ ਅਤੇ (ਫਿਰ) ਪਤੀ ਨੇ ਚੰਗੀ ਤਰ੍ਰਹਾ ਸਮਝਾ ਵੀ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "चतुरि द्रुपदजा अति हुती अरु पति कहियो बनाइ ॥",
      "sourceLineId": "123673",
      "sourceShabadId": "11544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਏਕ ਬਚਨ ਭਾਖਿਯੋ ਹੁਤੋ ਬੀਸਕ ਕਹੀ ਸੁਨਾਇ ॥੮॥",
      "transliteration": "ek bachan bhaakhiyo huto beesak kahee sunai ||8||",
      "translation": "",
      "punjabiViakhya": "(ਪਤੀ ਨੇ ਤਾ) ਇਕ ਗੱਲ ਕਹੀ ਸੀ, ਉਸ ਨੇ ਵੀਹ ਗੱਲਾ ਬਣਾ ਕੇ ਕਹਿ ਦਿੱਤੀਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "एक बचन भाखियो हुतो बीसक कही सुनाइ ॥८॥",
      "sourceLineId": "123674",
      "sourceShabadId": "11544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123675",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਦ੍ਰੁਪਦੀ ਯੌ ਕ੍ਰੀਚਕ ਸੌ ਕਹੀ ॥",
      "transliteration": "dhrupadhee yau kreechak sau kahee ||",
      "translation": "",
      "punjabiViakhya": "ਦ੍ਰੋਪਤੀ ਨੇ ਕ੍ਰੀਚਕ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "द्रुपदी यौ क्रीचक सौ कही ॥",
      "sourceLineId": "123676",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਤੁਮ ਪੈ ਅਨਿਕ ਰੀਝਿ ਮੈ ਰਹੀ ॥",
      "transliteration": "tum pai anik reejh mai rahee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮੈਂ ਤੇਰੇ ਉਤੇ ਬਹੁਤ ਰੀਝ ਗਈ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "तुम पै अनिक रीझि मै रही ॥",
      "sourceLineId": "123677",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਸੂੰਨਿਸਾਲ ਨਿਸਿ ਕੌ ਤੁਮ ਐਯਹੁ ॥",
      "transliteration": "soo(n)nisaal nis kau tum aaiyahu ||",
      "translation": "",
      "punjabiViakhya": "ਤੂੰ ਰਾਤ ਨੂੰ 'ਸੂੰਨਿਸਾਲ' (ਸੁੰਨੀ ਥਾ ਜਾ ਰਸੋਈ) ਵਿਚ ਆ ਜਾਈਂ",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "सूँनिसाल निसि कौ तुम ऐयहु ॥",
      "sourceLineId": "123678",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਮੁਹਿ ਸਾਥ ਕਮੈਯਹੁ ॥੯॥",
      "transliteration": "kaam bhog muh saath kamaiyahu ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੇ ਨਾਲ ਕਾਮ ਭੋਗ ਕਰੀਂ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "काम भोग मुहि साथ कमैयहु ॥९॥",
      "sourceLineId": "123679",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਸੂੰਨਿਸਾਲ ਭੀਮਹਿ ਬੈਠਾਯੋ ॥",
      "transliteration": "soo(n)nisaal bheemeh baiThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਸੂੰਨਿਸਾਲ ਵਿਚ ਉਸ ਨੇ ਭੀਮ ਨੂੰ ਬਿਠਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "सूँनिसाल भीमहि बैठायो ॥",
      "sourceLineId": "123680",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਕ੍ਰੀਚਕ ਅਰਧ ਰਾਤ੍ਰਿ ਗੈ ਆਯੋ ॥",
      "transliteration": "kreechak aradh raatr gai aayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ) ਅੱਧੀ ਰਾਤ ਨੂੰ ਕ੍ਰੀਚਕ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "क्रीचक अरध रातृ गै आयो ॥",
      "sourceLineId": "123681",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1070_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਤਬ ਹੀ ਪਕਰਿ ਟਾਗ ਤੇ ਲਿਯੋ ॥",
      "transliteration": "tab hee pakar Taag te liyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ (ਕ੍ਰੀਚਕ ਨੂੰ ਭੀਮ ਨੇ) ਟੰਗਾ ਤੋਂ ਪਕੜ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1070,
      "hindi": "",
      "hindiTransliteration": "तब ही पकरि टाग ते लियो ॥",
      "sourceLineId": "123682",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
