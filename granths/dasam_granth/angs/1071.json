{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1071,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1071_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਟੂਕ ਅਨੇਕ ਤਾਹਿ ਕਰਿ ਦਿਯੋ ॥੧੦॥",
      "transliteration": "Took anek taeh kar dhiyo ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਦੇ ਕਈ ਟੋਟੇ ਕਰ ਦਿੱਤੇ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "टूक अनेक ताहि करि दियो ॥१०॥",
      "sourceLineId": "123683",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪ੍ਰਾਤ ਸਮੈ ਕ੍ਰੀਚਕ ਰਿਸਿ ਭਰੇ ॥",
      "transliteration": "praat samai kreechak ris bhare ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੇਰ ਵੇਲੇ (ਸਾਰੇ) ਕ੍ਰੀਚਕ ਰੋਹ ਨਾਲ ਭਰ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "प्रात समै क्रीचक रिसि भरे ॥",
      "sourceLineId": "123684",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕੇਸ ਦ੍ਰੋਪਤੀ ਕੇ ਦ੍ਰਿੜ ਧਰੇ ॥",
      "transliteration": "kes dhropatee ke dhiraR dhare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦ੍ਰੋਪਤੀ ਦੇ ਵਾਲਾ ਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਪਕੜ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "केस द्रोपती के दृड़ धरे ॥",
      "sourceLineId": "123685",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਯਾਹਿ ਅਗਨਿ ਕੇ ਬੀਚ ਜਰੈ ਹੈ ॥",
      "transliteration": "yaeh agan ke beech jarai hai ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗੇ-) ਇਸ ਨੂੰ ਅਗਨੀ ਵਿਚ ਸਾੜਾਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "याहि अगनि के बीच जरै है ॥",
      "sourceLineId": "123686",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭ੍ਰਾਤ ਗਯੋ ਤਹ ਤੋਹਿ ਪਠੈ ਹੈ ॥੧੧॥",
      "transliteration": "bhraat gayo teh toh paThai hai ||11||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ (ਸਾਡਾ) ਭਰਾ ਗਿਆ ਹੈ, ਉਥੇ ਭੇਜ ਦਿਆਂਗੇ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "भ्रात गयो तह तोहि पठै है ॥११॥",
      "sourceLineId": "123687",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗਹਿ ਕੇ ਕੇਸ ਤਾਹਿ ਲੈ ਚਲੇ ॥",
      "transliteration": "geh ke kes taeh lai chale ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਵਾਲ ਪਕੜ ਕੇ ਉਥੇ ਲੈ ਚਲੇ",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "गहि के केस ताहि लै चले ॥",
      "sourceLineId": "123688",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕ੍ਰੀਚਕ ਬੀਰ ਸੂਰਮਾ ਭਲੇ ॥",
      "transliteration": "kreechak beer sooramaa bhale ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਬਾਕੇ ਕ੍ਰੀਚਕ ਸੂਰਮੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "क्रीचक बीर सूरमा भले ॥",
      "sourceLineId": "123689",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਬ ਹੀ ਕੋਪ ਭੀਮ ਅਤਿ ਭਰਿਯੋ ॥",
      "transliteration": "tab hee kop bheem at bhariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਭੀਮ ਕ੍ਰੋਧ ਨਾਲ ਭਰ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "तब ही कोप भीम अति भरियो ॥",
      "sourceLineId": "123690",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗਹਿ ਕੈ ਤਾਰ ਬ੍ਰਿਛ ਕਰਿ ਧਰਿਯੋ ॥੧੨॥",
      "transliteration": "geh kai taar birachh kar dhariyo ||12||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਤਾੜ ਦਾ ਬ੍ਰਿਛ ਹੱਥ ਵਿਚ ਧਾਰਨ ਕਰ ਲਿਆ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "गहि कै तार बृछ करि धरियो ॥१२॥",
      "sourceLineId": "123691",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਾ ਕੌ ਕੋਪਿ ਬ੍ਰਿਛ ਕੀ ਮਾਰੈ ॥",
      "transliteration": "jaa kau kop birachh kee maarai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਬ੍ਰਿਛ (ਦੀ ਸਟ) ਮਾਰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "जा कौ कोपि बृछ की मारै ॥",
      "sourceLineId": "123692",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਾ ਕੋ ਮੂੰਡ ਚੌਥਿ ਹੀ ਡਾਰੈ ॥",
      "transliteration": "taa ko moo(n)dd chauath hee ddaarai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਸਿਰ ਚਿਥ ਦਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "ता को मूँड चौथि ही डारै ॥",
      "sourceLineId": "123693",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਾਹੂੰ ਪਕਰਿ ਟਾਗ ਤੇ ਆਵੈ ॥",
      "transliteration": "kaahoo(n) pakar Taag te aavai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੂੰ ਟੰਗੋਂ ਪਕੜ ਕੇ ਮਾਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "काहूँ पकरि टाग ते आवै ॥",
      "sourceLineId": "123694",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਿਸੂ ਕੇਸ ਤੇ ਐਂਚਿ ਬਿਗਾਵੈ ॥੧੩॥",
      "transliteration": "kisoo kes te aai(n)ch bigaavai ||13||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੂੰ ਕੇਸਾ ਤੋਂ ਪਕੜ ਕੇ ਵਗਾ ਮਾਰਦਾ ਸੀ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "किसू केस ते ऐंचि बिगावै ॥१३॥",
      "sourceLineId": "123695",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਨਿਯਾ ਬਿਖੈ ਕ੍ਰੀਚਕਨ ਧਾਰੈ ॥",
      "transliteration": "kaniyaa bikhai kreechakan dhaarai ||",
      "translation": "",
      "punjabiViakhya": "ਕੱਛਾ ('ਕਨਿਯਾ') ਵਿਚ ਕ੍ਰੀਚਕਾ ਨੂੰ ਚੁਕ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "कनिया बिखै क्रीचकन धारै ॥",
      "sourceLineId": "123696",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਰਤ ਚਿਤਾ ਭੀਤਰ ਲੈ ਡਾਰੈ ॥",
      "transliteration": "barat chitaa bheetar lai ddaarai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਲਦੀ ਚਿਤਾ ਵਿਚ ਸੁਟ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "बरत चिता भीतर लै डारै ॥",
      "sourceLineId": "123697",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਹਸ ਪਾਚ ਕ੍ਰੀਚਕ ਸੰਗ ਮਾਰਿਯੋ ॥",
      "transliteration": "sahas paach kreechak sa(n)g maariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਇਕ) ਕ੍ਰੀਚਕ ਨਾਲ ਪੰਜ ਹਜ਼ਾਰ ਹੋਰ ਕ੍ਰੀਚਕ ਮਾਰੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "सहस पाच क्रीचक संग मारियो ॥",
      "sourceLineId": "123698",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਿਜੁ ਨਾਰੀ ਕੋ ਪ੍ਰਾਨ ਉਬਾਰਿਯੋ ॥੧੪॥",
      "transliteration": "nij naaree ko praan ubaariyo ||14||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਆਪਣੀ ਇਸਤਰੀ ਦੇ ਪ੍ਰਾਣ ਬਚਾਏ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "निजु नारी को प्रान उबारियो ॥१४॥",
      "sourceLineId": "123699",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਚੌਰਾਸੀਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੮੪॥੩੫੪੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau chauaraaseevo charitr samaapatam sat subham sat ||184||3543||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੮੪ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੮੪॥੩੫੪੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ चौरासीवो चरित्र समापतम सतु सुभम सतु ॥१८४॥३५४३॥अफजूँ॥",
      "sourceLineId": "123700",
      "sourceShabadId": "11545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123701",
      "sourceShabadId": "11546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਏਕ ਬਨਿਕ ਕੀ ਭਾਰਜਾ ਅਕਬਰਬਾਦ ਮੰਝਾਰ ॥",
      "transliteration": "ek banik kee bhaarajaa akabarabaadh ma(n)jhaar ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਬਾਨੀਏ ਦੀ ਇਸਤਰੀ ਅਕਬਰਾਬਾਦ ਵਿਚ (ਰਹਿੰਦੀ ਸੀ)।",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "एक बनिक की भारजा अकबरबाद मंझार ॥",
      "sourceLineId": "123702",
      "sourceShabadId": "11546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦੇਵ ਦੈਤ ਰੀਝੈ ਨਿਰਖਿ ਸ੍ਰੀ ਰਨ ਰੰਗ ਕੁਮਾਰਿ ॥੧॥",
      "transliteration": "dhev dhait reejhai nirakh sree ran ra(n)g kumaar ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਸ੍ਰੀ ਰਨ ਰੰਗ ਕੁਮਾਰੀ ਨੂੰ ਵੇਖ ਕੇ ਦੇਵਤੇ ਅਤੇ ਦੈਂਤ ਪ੍ਰਸੰਨ ਹੋ ਜਾਦੇ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "देव दैत रीझै निरखि स्री रन रंग कुमारि ॥१॥",
      "sourceLineId": "123703",
      "sourceShabadId": "11546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123704",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸ੍ਰੀ ਅਕਬਰ ਆਖੇਟ ਸਿਧਾਯੋ ॥",
      "transliteration": "sree akabar aakheT sidhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਅਕਬਰ ਸ਼ਿਕਾਰ ਖੇਡਣ ਚੜ੍ਰਹਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "स्री अकबर आखेट सिधायो ॥",
      "sourceLineId": "123705",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਾ ਕੋ ਰੂਪ ਨਿਰਖਿ ਬਿਰਮਾਯੋ ॥",
      "transliteration": "taa ko roop nirakh biramaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਰੂਪ ਵੇਖ ਕੇ ਮੋਹਿਤ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "ता को रूप निरखि बिरमायो ॥",
      "sourceLineId": "123706",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਖੀ ਏਕ ਤਿਹ ਤੀਰ ਪਠਾਈ ॥",
      "transliteration": "sakhee ek teh teer paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਾਸੀ ਨੂੰ ਉਸ ਕੋਲ ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "सखी एक तिह तीर पठाई ॥",
      "sourceLineId": "123707",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਾਹਿ ਆਨਿ ਮੁਹਿ ਦੇਹਿ ਮਿਲਾਈ ॥੨॥",
      "transliteration": "taeh aan muh dheh milaiee ||2||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਉਸ ਨੂੰ ਲਿਆ ਕੇ ਮੈਨੂੰ ਮਿਲਾ ਦੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "ताहि आनि मुहि देहि मिलाई ॥२॥",
      "sourceLineId": "123708",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਬ ਚਲ ਸਖੀ ਭਵਨ ਤਿਹ ਗਈ ॥",
      "transliteration": "tab chal sakhee bhavan teh giee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਸਖੀ ਚਲ ਕੇ ਉਸ ਦੇ ਘਰ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "तब चल सखी भवन तिह गई ॥",
      "sourceLineId": "123709",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਵਾ ਕੌ ਭੇਦ ਜਤਾਵਤ ਭਈ ॥",
      "transliteration": "vaa kau bhedh jataavat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਸਾਰੀ ਗੱਲ (ਚੰਗੀ ਤਰ੍ਰਹਾ) ਦਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "वा कौ भेद जतावत भई ॥",
      "sourceLineId": "123710",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੋ ਹਜਰਤਿ ਕੇ ਧਾਮ ਨ ਆਈ ॥",
      "transliteration": "so hajarat ke dhaam na aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬਾਦਸ਼ਾਹ ਦੇ ਘਰ ਨਾ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "सो हजरति के धाम न आई ॥",
      "sourceLineId": "123711",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹਜਰਤਿ ਜੂ ਗ੍ਰਿਹ ਲਏ ਬੁਲਾਈ ॥੩॥",
      "transliteration": "hajarat joo gireh le bulaiee ||3||",
      "translation": "",
      "punjabiViakhya": "ਸਗੋਂ ਬਾਦਸ਼ਾਹ ਨੂੰ (ਆਪਣੇ) ਘਰ ਬੁਲਾ ਲਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "हजरति जू गृह लए बुलाई ॥३॥",
      "sourceLineId": "123712",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹਜਰਤਿ ਜਬੈ ਭਵਨ ਤਿਹ ਆਯੋ ॥",
      "transliteration": "hajarat jabai bhavan teh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਬਾਦਸ਼ਾਹ ਉਸ ਦੇ ਘਰ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "हजरति जबै भवन तिह आयो ॥",
      "sourceLineId": "123713",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਾ ਅਬਲਾ ਕੀ ਸੇਜ ਸੁਹਾਯੋ ॥",
      "transliteration": "taa abalaa kee sej suhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਸਤਰੀ ਦੀ ਸੇਜ ਉਤੇ ਬੈਠਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "ता अबला की सेज सुहायो ॥",
      "sourceLineId": "123714",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਤਿਨ ਬਚਨ ਉਚਾਰੇ ॥",
      "transliteration": "tab raanee tin bachan uchaare ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ (ਇਸਤਰੀ) ਨੇ ਉਸ ਨੂੰ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "तब रानी तिन बचन उचारे ॥",
      "sourceLineId": "123715",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੁਨਹੁ ਸਾਹ ਪ੍ਰਾਨਨ ਤੇ ਪ੍ਯਾਰੇ ॥੪॥",
      "transliteration": "sunahu saeh praanan te payaare ||4||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪ੍ਰਾਣ ਪਿਆਰੇ ਬਾਦਸ਼ਾਹ! ਸੁਣੋ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "सुनहु साह प्रानन ते प्यारे ॥४॥",
      "sourceLineId": "123716",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਹੌ ਤੋ ਅਬੈ ਡਾਰਿ ਲਘੁ ਆਊ ॥",
      "transliteration": "kahau to abai ddaar lagh aauoo ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਆਗਿਆ ਦਿਓ ਤਾ ਮੈਂ ਲਘੂ ਸ਼ੰਕਾ (ਪਿਸ਼ਾਬ) ਕਰ ਆਵਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "कहौ तो अबै डारि लघु आऊ ॥",
      "sourceLineId": "123717",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਹੁਰਿ ਤਿਹਾਰੀ ਸੇਜ ਸੁਹਾਊ ॥",
      "transliteration": "bahur tihaaree sej suhaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਤੁਹਾਡੀ ਸੇਜ ਨੂੰ ਸੁਹਾਵਣਾ ਬਣਾਵਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "बहुरि तिहारी सेज सुहाऊ ॥",
      "sourceLineId": "123718",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਯੌ ਕਹਿ ਜਾਤ ਤਹਾ ਤੇ ਭਈ ॥",
      "transliteration": "yau keh jaat tahaa te bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਕਹਿ ਕੇ ਉਥੋਂ ਚਲੀ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "यौ कहि जात तहा ते भई ॥",
      "sourceLineId": "123719",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਗ੍ਰਿਹ ਕੀ ਐਂਚਿ ਕਿਵਰਿਯਾ ਦਈ ॥੫॥",
      "transliteration": "gireh kee aai(n)ch kivariyaa dhiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘਰ ਦੇ ਕਿਵਾੜ ਕਸ ਕੇ ਬੰਦ ਕਰ ਦਿੱਤੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "गृह की ऐंचि किवरिया दई ॥५॥",
      "sourceLineId": "123720",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪਤਿ ਕਹ ਜਾਇ ਸਕਲ ਸੁਧਿ ਦਈ ॥",
      "transliteration": "pat keh jai sakal sudh dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਪਤੀ ਨੂੰ ਜਾ ਕੇ ਸਾਰੀ ਗੱਲ ਦਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "पति कह जाइ सकल सुधि दई ॥",
      "sourceLineId": "123721",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੰਗ ਕਰਿ ਨਾਥੇ ਲ੍ਯਾਵਤ ਭਈ ॥",
      "transliteration": "sa(n)g kar naathe layaavat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਨਾਲ ਲੈ ਕੇ ਆ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "संग करि नाथे ल्यावत भई ॥",
      "sourceLineId": "123722",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਤਿ ਤਬ ਕੋਪ ਬਨਿਕ ਕੋ ਭਯੋ ॥",
      "transliteration": "at tab kop banik ko bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਬਾਨੀਏ ਨੇ ਬਹੁਤ ਕ੍ਰੋਧ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "अति तब कोप बनिक को भयो ॥",
      "sourceLineId": "123723",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਛਿਤ੍ਰ ਉਤਾਰਿ ਹਾਥ ਮੈ ਲਯੋ ॥੬॥",
      "transliteration": "chhitr utaar haath mai layo ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜੁਤੀ ਉਤਾਰ ਕੇ ਹੱਥ ਵਿਚ ਪਕੜ ਲਈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "छित्र उतारि हाथ मै लयो ॥६॥",
      "sourceLineId": "123724",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹਜਰਤਿ ਕੋ ਪਨਹੀ ਸਿਰ ਝਾਰੈ ॥",
      "transliteration": "hajarat ko panahee sir jhaarai ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਦਸ਼ਾਹ ਦੇ ਸਿਰ ਵਿਚ ਜੁਤੀਆਂ ('ਪਨਹੀ') ਮਾਰਨ ਲਗ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "हजरति को पनही सिर झारै ॥",
      "sourceLineId": "123725",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਲਜਤ ਸਾਹ ਨਹਿ ਬਚਨ ਉਚਾਰੈ ॥",
      "transliteration": "lajat saeh neh bachan uchaarai ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਰਮਿੰਦਾ ਹੋਇਆ ਬਾਦਸ਼ਾਹ ਬੋਲ ਨਾ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "लजत साह नहि बचन उचारै ॥",
      "sourceLineId": "123726",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜੂਤਨਿ ਮਾਰਿ ਭੋਹਰੇ ਦਿਯੋ ॥",
      "transliteration": "jootan maar bhohare dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਜੁਤੀਆਂ ਮਾਰ ਕੇ ਉਸ ਨੂੰ ਭੋਰੇ ਵਿਚ ਸੁਟ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "जूतनि मारि भोहरे दियो ॥",
      "sourceLineId": "123727",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਵੈਸਹਿ ਦੈ ਦਰਵਾਜੋ ਲਿਯੋ ॥੭॥",
      "transliteration": "vaiseh dhai dharavaajo liyo ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸੇ ਤਰ੍ਰਹਾ ਦਰਵਾਜ਼ਾ ਬੰਦ ਕਰ ਦਿੱਤਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "वैसहि दै दरवाजो लियो ॥७॥",
      "sourceLineId": "123728",
      "sourceShabadId": "11547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123729",
      "sourceShabadId": "11548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1071_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪ੍ਰਾਤ ਭਏ ਕੁਟਵਾਰ ਕੇ ਭਈ ਪੁਕਾਰੂ ਜਾਇ ॥",
      "transliteration": "praat bhe kuTavaar ke bhiee pukaaroo jai ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੇਰ ਹੁੰਦਿਆਂ ਹੀ ਕੋਤਵਾਲ ਕੋਲ ਜਾ ਕੇ ਪੁਕਾਰ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1071,
      "hindi": "",
      "hindiTransliteration": "प्रात भए कुटवार के भई पुकारू जाइ ॥",
      "sourceLineId": "123730",
      "sourceShabadId": "11548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
