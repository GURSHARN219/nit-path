{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1072,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1072_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਾਜੀ ਮੁਫਤੀ ਸੰਗ ਲੈ ਤਹਾ ਪਹੂਚੀ ਆਇ ॥੮॥",
      "transliteration": "kaajee mufatee sa(n)g lai tahaa pahoochee aai ||8||",
      "translation": "",
      "punjabiViakhya": "ਕਾਜ਼ੀ ਤੇ ਮੁਫ਼ਤੀ ਨੂੰ ਨਾਲ ਲੈ ਕੇ ਉਥੇ ਆ ਪਹੁੰਚੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "काजी मुफती संग लै तहा पहूची आइ ॥८॥",
      "sourceLineId": "123731",
      "sourceShabadId": "11548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚੋਰ ਜਾਰ ਕੈ ਸਾਧ ਕਉ ਸਾਹੁ ਕਿਧੋ ਪਾਤਿਸਾਹ ॥",
      "transliteration": "chor jaar kai saadh kau saahu kidho paatisaeh ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਕੋਈ ਚੋਰ ਹੈ, ਯਾਰ ਹੈ, ਸਾਧ ਹੈ, ਸ਼ਾਹ ਹੈ ਜਾ ਬਾਦਸ਼ਾਹ ਹੈ (ਮੈਨੂੰ ਪਤਾ ਨਹੀਂ)।",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "चोर जार कै साध कउ साहु किधो पातिसाह ॥",
      "sourceLineId": "123732",
      "sourceShabadId": "11548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਆਪਨ ਹੀ ਚਲਿ ਦੇਖਿਯੈ ਏ ਕਾਜਿਨ ਕੋ ਨਾਹ ॥੯॥",
      "transliteration": "aapan hee chal dhekhiyai e kaajin ko naeh ||9||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸ਼ਿਰੋਮਣੀ ਕਾਜ਼ੀ! ਤੁਸੀਂ ਆਪ ਹੀ ਚਲ ਕੇ ਵੇਖ ਲਵੋ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "आपन ही चलि देखियै ए काजिन को नाह ॥९॥",
      "sourceLineId": "123733",
      "sourceShabadId": "11548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123734",
      "sourceShabadId": "11549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪਤਿ ਤ੍ਰਿਯ ਬਚਨ ਭਾਖਿ ਭਜਿ ਗਏ ॥",
      "transliteration": "pat tiray bachan bhaakh bhaj ge ||",
      "translation": "",
      "punjabiViakhya": "ਪਤੀ ਅਤੇ ਪਤਨੀ ਗੱਲ ਕਹਿ ਕੇ ਭਜ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "पति तृय बचन भाखि भजि गए ॥",
      "sourceLineId": "123735",
      "sourceShabadId": "11549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹੇਰਤ ਤੇ ਅਕਬਰ ਕਹ ਭਏ ॥",
      "transliteration": "herat te akabar keh bhe ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਕਬਰ ਨੂੰ ਵੇਖਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "हेरत ते अकबर कह भए ॥",
      "sourceLineId": "123736",
      "sourceShabadId": "11549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਜਰਤਿ ਲਜਤ ਬਚਨ ਨਹਿ ਬੋਲੈ ॥",
      "transliteration": "hajarat lajat bachan neh bolai ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਦਸ਼ਾਹ ਸ਼ਰਮ ਦਾ ਮਾਰਿਆ ਬਚਨ ਬੋਲਦਾ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "हजरति लजत बचन नहि बोलै ॥",
      "sourceLineId": "123737",
      "sourceShabadId": "11549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨ੍ਯਾਇ ਰਹਿਯੋ ਸਿਰ ਆਂਖਿ ਨ ਖੋਲੈ ॥੧੦॥",
      "transliteration": "nayai rahiyo sir aa(n)kh na kholai ||10||",
      "translation": "",
      "punjabiViakhya": "ਸਿਰ ਨੀਵਾ ਕੀਤਾ ਹੋਇਆ ਸੀ ਅਤੇ ਅੱਖ ਖੋਲ੍ਰਹਦਾ ਨਹੀਂ ਸੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "न्याइ रहियो सिर आँखि न खोलै ॥१०॥",
      "sourceLineId": "123738",
      "sourceShabadId": "11549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੇ ਕੋਈ ਧਾਮ ਕਿਸੀ ਕੇ ਜਾਵੈ ॥",
      "transliteration": "je koiee dhaam kisee ke jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਕੋਈ (ਵਿਅਕਤੀ) ਕਿਸੇ ਦੇ ਘਰ (ਅਜਿਹੇ ਕੰਮ ਲਈ) ਜਾਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "जे कोई धाम किसी के जावै ॥",
      "sourceLineId": "123739",
      "sourceShabadId": "11549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕ੍ਯੋ ਨਹਿ ਐਸ ਤੁਰਤ ਫਲੁ ਪਾਵੈ ॥",
      "transliteration": "kayo neh aais turat fal paavai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਤੁਰਤ ਅਜਿਹਾ ਕਿਉਾਂ ਨਾ ਫਲ ਪਾਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "क्यो नहि ऐस तुरत फलु पावै ॥",
      "sourceLineId": "123740",
      "sourceShabadId": "11549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੇ ਕੋਊ ਪਰ ਨਾਰੀ ਸੋ ਪਾਗੈ ॥",
      "transliteration": "je kouoo par naaree so paagai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਕੋਈ ਪਰਾਈ ਇਸਤਰੀ ਵਿਚ ਮਗਨ ਹੋਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "जे कोऊ पर नारी सो पागै ॥",
      "sourceLineId": "123741",
      "sourceShabadId": "11549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪਨਹੀ ਇਹਾ ਨਰਕ ਤਿਹ ਆਗੈ ॥੧੧॥",
      "transliteration": "panahee ihaa narak teh aagai ||11||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਥੇ ਉਸ ਨੂੰ ਜੁਤੀਆਂ ਪੈਣ ਗੀਆਂ ਅਤੇ ਅਗੇ ਨਰਕ ਮਿਲੇਗੀ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "पनही इहा नरक तिह आगै ॥११॥",
      "sourceLineId": "123742",
      "sourceShabadId": "11549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਬ ਇਹ ਭਾਤਿ ਹਜਰਤਿਹਿ ਭਯੋ ॥",
      "transliteration": "jab ieh bhaat hajarateh bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਬਾਦਸ਼ਾਹ ਨਾਲ ਇਸ ਤਰ੍ਰਹਾ ਦੀ (ਘਟਨਾ) ਹੋਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "जब इह भाति हजरतिहि भयो ॥",
      "sourceLineId": "123743",
      "sourceShabadId": "11549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਹੁਰਿ ਕਿਸੂ ਕੇ ਧਾਮ ਨ ਗਯੋ ॥",
      "transliteration": "bahur kisoo ke dhaam na gayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਫਿਰ ਉਹ ਕਿਸੇ ਦੇ ਘਰ ਨਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "बहुरि किसू के धाम न गयो ॥",
      "sourceLineId": "123744",
      "sourceShabadId": "11549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜੈਸਾ ਕਿਯ ਤੈਸਾ ਫਲ ਪਾਯੋ ॥",
      "transliteration": "jaisaa kiy taisaa fal paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੋ ਜਿਹਾ ਕੀਤਾ ਸੀ, ਉਹੋ ਜਿਹਾ ਫਲ ਪ੍ਰਾਪਤ ਕਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "जैसा किय तैसा फल पायो ॥",
      "sourceLineId": "123745",
      "sourceShabadId": "11549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੁਰਾਚਾਰ ਚਿਤ ਤੇ ਬਿਸਰਾਯੋ ॥੧੨॥",
      "transliteration": "dhuraachaar chit te bisaraayo ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੁਰਾਚਾਰ ਨੂੰ ਮਨ ਵਿਚੋਂ ਵਿਸਾਰ ਦਿੱਤਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "दुराचार चित ते बिसरायो ॥१२॥",
      "sourceLineId": "123746",
      "sourceShabadId": "11549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਪਚਾਸੀਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੮੫॥੩੫੫੫॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau pachaaseevo charitr samaapatam sat subham sat ||185||3555||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੮੫ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੮੫॥੩੫੫੫॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ पचासीवो चरित्र समापतम सतु सुभम सतु ॥१८५॥३५५५॥अफजूँ॥",
      "sourceLineId": "123747",
      "sourceShabadId": "11549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123748",
      "sourceShabadId": "11550",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਦ੍ਰ ਦੇਸ ਇਕ ਛਤ੍ਰਜਾ ਅਚਲ ਕਲਾ ਤਿਹ ਨਾਉ ॥",
      "transliteration": "madhr dhes ik chhatrajaa achal kalaa teh naau ||",
      "translation": "",
      "punjabiViakhya": "ਮਦ੍ਰ ਦੇਸ਼ ਵਿਚ ਛਤ੍ਰੀ ਦੀ ਧੀ ਸੀ ਜਿਸ ਦਾ ਨਾਮ ਅਚਲ ਕਲਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "मद्र देस इक छत्रजा अचल कला तिह नाउ ॥",
      "sourceLineId": "123749",
      "sourceShabadId": "11550",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਧਿਕ ਦਰਬ ਤਾ ਕੇ ਰਹੈ ਬਸਤ ਦਯਾਲ ਪੁਰ ਗਾਉ ॥੧॥",
      "transliteration": "adhik dharab taa ke rahai basat dhayaal pur gaau ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਾਸ ਬਹੁਤ ਧਨ ਸੀ ਅਤੇ ਦਿਆਲਪੁਰ ਪਿੰਡ ਵਿਚ ਰਹਿੰਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "अधिक दरब ता के रहै बसत दयाल पुर गाउ ॥१॥",
      "sourceLineId": "123750",
      "sourceShabadId": "11550",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123751",
      "sourceShabadId": "11551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰਵਿ ਜਬ ਹੀ ਅਸਤਾਚਲ ਗਏ ॥",
      "transliteration": "rav jab hee asataachal ge ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਸੂਰਜ ਡੁਬ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "रवि जब ही असताचल गए ॥",
      "sourceLineId": "123752",
      "sourceShabadId": "11551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪ੍ਰਾਚੀ ਦਿਸਾ ਚੰਦ੍ਰ ਪ੍ਰਗਟਏ ॥",
      "transliteration": "praachee dhisaa cha(n)dhr pragaTe ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੂਰਬ ਦਿਸ਼ਾ ਵਲ ਚੰਦ੍ਰਮਾ ਚੜ੍ਰਹ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "प्राची दिसा चंद्र प्रगटए ॥",
      "sourceLineId": "123753",
      "sourceShabadId": "11551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਾਰਿ ਦੀਵਟੈ ਤਸਕਰ ਧਾਏ ॥",
      "transliteration": "jaar dheevaTai tasakar dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮਸ਼ਾਲਾ ('ਦੀਵਟੈ') ਜਗਾ ਕੇ ਚੋਰ ਚਲ ਪਏ",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "जारि दीवटै तसकर धाए ॥",
      "sourceLineId": "123754",
      "sourceShabadId": "11551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਾ ਕੇ ਤਾਕਿ ਭਵਨ ਕਹ ਆਏ ॥੨॥",
      "transliteration": "taa ke taak bhavan keh aae ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲਭ ਲਭਾ ਕੇ ਉਸ ਦੇ ਘਰ ਵਲ ਆਏ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "ता के ताकि भवन कह आए ॥२॥",
      "sourceLineId": "123755",
      "sourceShabadId": "11551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123756",
      "sourceShabadId": "11552",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਠਾਢਿ ਭਏ ਤਿਹ ਬਾਲ ਕੇ ਸਿਰ ਪਰ ਖੜਗ ਨਿਕਾਰਿ ॥",
      "transliteration": "Thaadd bhe teh baal ke sir par khaRag nikaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਤਲਵਾਰਾ ਕਢ ਕੇ ਉਸ ਇਸਤਰੀ ਦੇ ਸਿਰ ਉਤੇ ਆ ਖੜੋਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "ठाढि भए तिह बाल के सिर पर खड़ग निकारि ॥",
      "sourceLineId": "123757",
      "sourceShabadId": "11552",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕੈ ਧਨ ਦੇਹਿ ਬਤਾਇ ਕੈ ਨਹ ਤੁਹਿ ਦੇਹਿ ਸੰਘਾਰਿ ॥੩॥",
      "transliteration": "kai dhan dheh batai kai neh tuh dheh sa(n)ghaar ||3||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗੇ) ਜਾ ਤਾ ਧਨ ਦਸ ਦੇ, ਨਹੀਂ ਤਾ ਤੈਨੂੰ ਮਾਰ ਦੇਵਾਗੇ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "कै धन देहि बताइ कै नह तुहि देहि संघारि ॥३॥",
      "sourceLineId": "123758",
      "sourceShabadId": "11552",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123759",
      "sourceShabadId": "11553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਬ ਅਬਲਾ ਐਸੇ ਸੁਨਿ ਪਾਯੋ ॥",
      "transliteration": "jab abalaa aaise sun paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਇਸਤਰੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "जब अबला ऐसे सुनि पायो ॥",
      "sourceLineId": "123760",
      "sourceShabadId": "11553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਛੂਕ ਧਾਮ ਕੋ ਦਰਬੁ ਦਿਖਾਯੋ ॥",
      "transliteration": "kachhook dhaam ko dharab dhikhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਘਰ ਦਾ ਕੁਝ ਕੁ ਧਨ ਵਿਖਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "कछूक धाम को दरबु दिखायो ॥",
      "sourceLineId": "123761",
      "sourceShabadId": "11553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਹੁਰਿ ਕਹਿਯੋ ਮੈ ਦਰਬੁ ਦਿਖਾਊਾਂ ॥",
      "transliteration": "bahur kahiyo mai dharab dhikhaauooaa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਕਿਹਾ, ਮੈਂ ਹੋਰ ਧਨ ਵੀ ਵਿਖਾਉਾਂਦੀ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "बहुरि कहियो मै दरबु दिखाऊाँ ॥",
      "sourceLineId": "123762",
      "sourceShabadId": "11553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜੌ ਮੈ ਦਾਨ ਜੀਵ ਕੋ ਪਾਊਾਂ ॥੪॥",
      "transliteration": "jau mai dhaan jeev ko paauooaa(n) ||4||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਮੇਰੀ ਜਾਨ ਬਖ਼ਸ਼ੀ ਕਰ ਦਿਓ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "जौ मै दान जीव को पाऊाँ ॥४॥",
      "sourceLineId": "123763",
      "sourceShabadId": "11553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਵੈਯਾ ॥",
      "transliteration": "savaiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੈਯਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "सवैया ॥",
      "sourceLineId": "123764",
      "sourceShabadId": "11554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਾਹੇ ਕੌ ਆਜੁ ਸੰਘਾਰਤ ਮੋ ਕਹ ਸੰਗ ਚਲੋ ਬਹੁ ਮਾਲ ਬਤਾਊ ॥",
      "transliteration": "kaahe kau aaj sa(n)ghaarat mo keh sa(n)g chalo bahu maal bataauoo ||",
      "translation": "",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਮੈਨੂੰ ਅਜ ਕਿਉਾਂ ਮਾਰਦੇ ਹੋ, ਮੇਰੇ ਨਾਲ ਚਲੋ (ਮੈਂ ਤੁਹਾਨੂੰ) ਬਹੁਤ ਮਾਲ ਦਸਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "काहे कौ आजु संघारत मो कह संग चलो बहु माल बताऊ ॥",
      "sourceLineId": "123765",
      "sourceShabadId": "11554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰਾਖਿ ਮਹਾਬਤਿ ਖਾਨ ਗਏ ਸਭ ਹੀ ਇਕ ਬਾਰ ਸੁ ਤੇ ਹਰਿ ਲਯਾਊ ॥",
      "transliteration": "raakh mahaabat khaan ge sabh hee ik baar su te har layaauoo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਸਾਰੇ ਮਾਲ ਨੂੰ ਮਹਾਬਤਿ ਖ਼ਾਨ ਰਖ ਕੇ ਗਿਆ ਹੈ, ਉਸ (ਮਾਲ) ਨੂੰ ਇਕੋ ਵਾਰ ਹਰ ਲਿਆਵਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "राखि महाबति खान गए सभ ही इक बार सु ते हरि लयाऊ ॥",
      "sourceLineId": "123766",
      "sourceShabadId": "11554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪੂਤਨ ਪ੍ਰੋਤਨ ਲੌ ਸਭ ਕੋ ਛਿਨ ਭੀਤਰਿ ਆਜੁ ਦਰਦ੍ਰਿ ਬਹਾਊ ॥",
      "transliteration": "pootan protan lau sabh ko chhin bheetar aaj dharadhr bahaauoo ||",
      "translation": "",
      "punjabiViakhya": "(ਤੁਹਾਡੇ) ਪੁੱਤਰਾ ਪੋਤਰਿਆਂ ਤਕ ਸਭ ਦੀ ਗ਼ਰੀਬੀ ਅਜ ਛਿਣ ਭਰ ਵਿਚ ਦੂਰ ਕਰ ਦਿਆਂਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "पूतन प्रोतन लौ सभ को छिन भीतरि आजु दरदृ बहाऊ ॥",
      "sourceLineId": "123767",
      "sourceShabadId": "11554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਲੀਜਹੁ ਲੂਟਿ ਸਭੈ ਤੁਮ ਤਾ ਕਹ ਮੈ ਅਪਨੋ ਨਹਿ ਪਾਨ ਛੁਆਊ ॥੫॥",
      "transliteration": "leejahu looT sabhai tum taa keh mai apano neh paan chhuaauoo ||5||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਸਾਰੇ (ਮਾਲ) ਨੂੰ ਤੁਸੀਂ ਲੁਟ ਲਵੋ, ਮੈਂ ਉਸ ਨੂੰ ਆਪਣਾ ਹੱਥ ਤਕ ਨਹੀਂ ਲਗਾਵਾਗੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "लीजहु लूटि सभै तुम ता कह मै अपनो नहि पान छुआऊ ॥५॥",
      "sourceLineId": "123768",
      "sourceShabadId": "11554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123769",
      "sourceShabadId": "11555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੁਨਤ ਬਚਨ ਤਸਕਰ ਤੇ ਭਏ ॥",
      "transliteration": "sunat bachan tasakar te bhe ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸਤਰੀ ਦੇ) ਬੋਲ ਸੁਣ ਕੇ ਚੋਰ ਤਿਆਰ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "सुनत बचन तसकर ते भए ॥",
      "sourceLineId": "123770",
      "sourceShabadId": "11555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤ੍ਰਿਯ ਕੌ ਸੰਗ ਤਹਾ ਲੈ ਗਏ ॥",
      "transliteration": "tiray kau sa(n)g tahaa lai ge ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੂੰ ਉਥੇ ਨਾਲ ਲੈ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "तृय कौ संग तहा लै गए ॥",
      "sourceLineId": "123771",
      "sourceShabadId": "11555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਹ ਕੋਠਾ ਦਾਰੂ ਕੋ ਭਰਿਯੋ ॥",
      "transliteration": "jeh koThaa dhaaroo ko bhariyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਦਾਰੂ (ਬਾਰੂਦ) ਦਾ ਕੋਠਾ ਭਰਿਆ ਹੋਇਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "जह कोठा दारू को भरियो ॥",
      "sourceLineId": "123772",
      "sourceShabadId": "11555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਹੀ ਜਾਇ ਤਸਕਰਨ ਉਚਰਿਯੋ ॥੬॥",
      "transliteration": "tahee jai tasakaran uchariyo ||6||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਜਾ ਕੇ ਚੋਰਾ ਨੂੰ ਕਿਹਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "तही जाइ तसकरन उचरियो ॥६॥",
      "sourceLineId": "123773",
      "sourceShabadId": "11555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123774",
      "sourceShabadId": "11556",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਗਨਿ ਬਾਨ ਸੋ ਬਾਧਿ ਤ੍ਰਿਯ ਤਹ ਕੌ ਦਈ ਚਲਾਇ ॥",
      "transliteration": "agan baan so baadh tiray teh kau dhiee chalai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਬਾਣ ਨਾਲ ਅਗਨੀ ਬੰਨ੍ਰਹ ਕੇ ਉਧਰ ਨੂੰ ਛਡ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "अगनि बान सो बाधि तृय तह कौ दई चलाइ ॥",
      "sourceLineId": "123775",
      "sourceShabadId": "11556",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਾਲ ਸਭਨ ਤਿਨ ਕੋ ਹੁਤੋ ਪਰਿਯੋ ਤਹੀ ਸਰ ਜਾਇ ॥੭॥",
      "transliteration": "kaal sabhan tin ko huto pariyo tahee sar jai ||7||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਚੋਰਾ ਦਾ ਕਾਲ ਰੂਪ ਤੀਰ ਉਥੇ ਜਾ ਪਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "काल सभन तिन को हुतो परियो तही सर जाइ ॥७॥",
      "sourceLineId": "123776",
      "sourceShabadId": "11556",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123777",
      "sourceShabadId": "11557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1072_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਸਕਰ ਜਾਰਿ ਮਸਾਲੈ ਪਰੇ ॥",
      "transliteration": "tasakar jaar masaalai pare ||",
      "translation": "",
      "punjabiViakhya": "ਚੋਰ ਮਸਾਲਾ ਜਲਾ ਕੇ ਉਥੇ ਜਾ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1072,
      "hindi": "",
      "hindiTransliteration": "तसकर जारि मसालै परे ॥",
      "sourceLineId": "123778",
      "sourceShabadId": "11557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
