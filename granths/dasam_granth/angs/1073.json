{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1073,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1073_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦਾਰੂ ਬਿਖੈ ਅੰਗਾਰੇ ਝਰੇ ॥",
      "transliteration": "dhaaroo bikhai a(n)gaare jhare ||",
      "translation": "",
      "punjabiViakhya": "(ਮਿਸਾਲਾ ਤੋਂ) ਬਾਰੂਦ ਵਿਚ ਚੰਗਿਆੜੇ ਡਿਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "दारू बिखै अंगारे झरे ॥",
      "sourceLineId": "123779",
      "sourceShabadId": "11557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਭ ਤਸਕਰ ਤਬ ਹੀ ਉਡ ਗਏ ॥",
      "transliteration": "sabh tasakar tab hee udd ge ||",
      "translation": "",
      "punjabiViakhya": "(ਬਾਰੂਦ ਦੇ ਫਟਣ ਨਾਲ) ਤਦ ਹੀ ਸਾਰੇ ਚੋਰ ਉਡ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "सभ तसकर तब ही उड गए ॥",
      "sourceLineId": "123780",
      "sourceShabadId": "11557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭੂਚਰ ਤੇ ਖੇਚਰ ਸੋ ਭਏ ॥੮॥",
      "transliteration": "bhoochar te khechar so bhe ||8||",
      "translation": "",
      "punjabiViakhya": "ਭੂਮੀ ਉਤੇ ਚਲਣ ਵਾਲੇ ਆਕਾਸ਼-ਚਾਰੀ ਹੋ ਗਏ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "भूचर ते खेचर सो भए ॥८॥",
      "sourceLineId": "123781",
      "sourceShabadId": "11557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦਾਰੂ ਉਡਤ ਚੋਰਿ ਉਡਿ ਗਏ ॥",
      "transliteration": "dhaaroo uddat chor udd ge ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਰੂਦ ਦੇ ਉਡਣ ਨਾਲ ਚੋਰ ਉਡ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "दारू उडत चोरि उडि गए ॥",
      "sourceLineId": "123782",
      "sourceShabadId": "11557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਭ ਹੀ ਫਿਰਤ ਗਗਨ ਮੌ ਭਏ ॥",
      "transliteration": "sabh hee firat gagan mau bhe ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਆਕਾਸ਼ ਵਿਚ ਘੁੰਮਣ ਲਗ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "सभ ही फिरत गगन मौ भए ॥",
      "sourceLineId": "123783",
      "sourceShabadId": "11557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਦਸ ਦਸ ਕੋਸ ਜਾਇ ਕਰ ਪਰੇ ॥",
      "transliteration": "dhas dhas kos jai kar pare ||",
      "translation": "",
      "punjabiViakhya": "ਦਸ ਦਸ ਕੋਹ ਦੂਰ ਜਾ ਕੇ ਡਿਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "दस दस कोस जाइ कर परे ॥",
      "sourceLineId": "123784",
      "sourceShabadId": "11557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਾਡ ਗੋਡ ਨਹਿ ਮੂੰਡ ਉਬਰੇ ॥੯॥",
      "transliteration": "haadd godd neh moo(n)dd ubare ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹਡ ਗੋਡੇ ਅਤੇ ਸਿਰ (ਸਭ) ਖ਼ਤਮ ਹੋ ਗਏ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "हाड गोड नहि मूँड उबरे ॥९॥",
      "sourceLineId": "123785",
      "sourceShabadId": "11557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਏਕੈ ਬਾਰ ਚੋਰ ਉਡ ਗਏ ॥",
      "transliteration": "ekai baar chor udd ge ||",
      "translation": "",
      "punjabiViakhya": "ਇਕੋ ਹੀ ਵਾਰ ਚੋਰ (ਸਾਰੇ) ਉਡ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "एकै बार चोर उड गए ॥",
      "sourceLineId": "123786",
      "sourceShabadId": "11557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੀਵਤ ਏਕ ਨ ਬਾਚਤ ਭਏ ॥",
      "transliteration": "jeevat ek na baachat bhe ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਵਿਚੋਂ) ਇਕ ਵੀ ਜੀਉਾਂਦਾ ਨਾ ਬਚਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "जीवत एक न बाचत भए ॥",
      "sourceLineId": "123787",
      "sourceShabadId": "11557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਅਬਲਾ ਤਿਹ ਮਾਰਿਯੋ ॥",
      "transliteration": "eeh charitr abalaa teh maariyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਚਰਿਤ੍ਰ ਨਾਲ ਇਸਤਰੀ ਨੇ ਉਨ੍ਰਹਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र अबला तिह मारियो ॥",
      "sourceLineId": "123788",
      "sourceShabadId": "11557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਛਲ ਕੇ ਅਪਨੋ ਧਾਮ ਉਬਾਰਿਯੋ ॥੧੦॥",
      "transliteration": "chhal ke apano dhaam ubaariyo ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਛਲ ਨਾਲ ਆਪਣਾ ਘਰ ਬਚਾ ਲਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "छल के अपनो धाम उबारियो ॥१०॥",
      "sourceLineId": "123789",
      "sourceShabadId": "11557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਇਹ ਛਲ ਸਭ ਚੋਰਨ ਕਹ ਘਾਈ ॥",
      "transliteration": "eeh chhal sabh choran keh ghaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਸਾਰਿਆਂ ਚੋਰਾ ਨੂੰ ਮਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "इह छल सभ चोरन कह घाई ॥",
      "sourceLineId": "123790",
      "sourceShabadId": "11557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਹੁਰੈ ਧਾਮ ਆਪਨੋ ਆਈ ॥",
      "transliteration": "bahurai dhaam aapano aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਆਪਣੇ ਘਰ ਨੂੰ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "बहुरै धाम आपनो आई ॥",
      "sourceLineId": "123791",
      "sourceShabadId": "11557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇੰਦ੍ਰ ਬਿਸਨ ਬ੍ਰਹਮਾ ਸਿਵ ਹੋਈ ॥",
      "transliteration": "ei(n)dhr bisan brahamaa siv hoiee ||",
      "translation": "",
      "punjabiViakhya": "ਇੰਦਰ, ਵਿਸ਼ਣੂ, ਬ੍ਰਹਮਾ, ਸ਼ਿਵ (ਕੋਈ ਵੀ) ਹੋਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "इंद्र बिसन ब्रहमा सिव होई ॥",
      "sourceLineId": "123792",
      "sourceShabadId": "11557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤ੍ਰਿਯ ਚਰਿਤ੍ਰ ਤੇ ਬਚਤ ਨ ਕੋਈ ॥੧੧॥",
      "transliteration": "tiray charitr te bachat na koiee ||11||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਚਰਿਤ੍ਰ ਤੋਂ ਕੋਈ ਵੀ ਬਚ ਨਹੀਂ ਸਕਦਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "तृय चरित्र ते बचत न कोई ॥११॥",
      "sourceLineId": "123793",
      "sourceShabadId": "11557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਛਿਆਸੀਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੮੬॥੩੫੬੬॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau chhiaaseevo charitr samaapatam sat subham sat ||186||3566||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੮੬ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੮੬॥੩੫੬੬॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ छिआसीवो चरित्र समापतम सतु सुभम सतु ॥१८६॥३५६६॥अफजूँ॥",
      "sourceLineId": "123794",
      "sourceShabadId": "11557",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123795",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਾਮ ਕਲਾ ਕਾਮਨਿ ਇਕ ਸੁਨੀ ॥",
      "transliteration": "kaam kalaa kaaman ik sunee ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮ ਕਲਾ ਨਾ ਦੀ ਇਕ ਇਸਤਰੀ ਸੁਣੀਂਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "काम कला कामनि इक सुनी ॥",
      "sourceLineId": "123796",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬੇਦ ਸਾਸਤ੍ਰ ਭੀਤਰਿ ਅਤਿ ਗੁਨੀ ॥",
      "transliteration": "bedh saasatr bheetar at gunee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਵੇਦ ਸ਼ਾਸਤ੍ਰ ਵਿਚ ਬਹੁਤ ਗੁਣਵਾਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "बेद सासत्र भीतरि अति गुनी ॥",
      "sourceLineId": "123797",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਾ ਕੋ ਪੁਤ੍ਰ ਨ ਆਗ੍ਯਾ ਮਾਨੈ ॥",
      "transliteration": "taa ko putr na aagayaa maanai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਪੁੱਤਰ ਆਗਿਆ ਨਹੀਂ ਮੰਨਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "ता को पुत्र न आग्या मानै ॥",
      "sourceLineId": "123798",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਯਾ ਤੇ ਮਾਤ ਕੋਪ ਚਿਤ ਠਾਨੈ ॥੧॥",
      "transliteration": "yaa te maat kop chit Thaanai ||1||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਮਾਤਾ ਸਦਾ ਚਿਤ ਵਿਚ ਕ੍ਰੋਧਿਤ ਰਹਿੰਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "या ते मात कोप चित ठानै ॥१॥",
      "sourceLineId": "123799",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕੁਬੁਧਿ ਬਿਖੈ ਦਿਨੁ ਰੈਨਿ ਗਵਾਵੈ ॥",
      "transliteration": "kubudh bikhai dhin rain gavaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਪੁੱਤਰ) ਮਾੜੀ ਬੁੱਧੀ ਵਿਚ ਹੀ ਦਿਨ ਰਾਤ ਬਤੀਤ ਕਰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "कुबुधि बिखै दिनु रैनि गवावै ॥",
      "sourceLineId": "123800",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਾਤ ਪਿਤਾ ਕੋ ਦਰਬੁ ਲੁਟਾਵੈ ॥",
      "transliteration": "maat pitaa ko dharab luTaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਾਤਾ ਪਿਤਾ ਦੇ ਧਨ ਨੂੰ ਲੁਟਾਈ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "मात पिता को दरबु लुटावै ॥",
      "sourceLineId": "123801",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗੁੰਡਨ ਸਾਥ ਕਰੈ ਗੁਜਰਾਨਾ ॥",
      "transliteration": "gu(n)ddan saath karai gujaraanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਗੁੰਡਿਆਂ ਨਾਲ ਸਮਾ ਬਤੀਤ ਕਰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "गुँडन साथ करै गुजराना ॥",
      "sourceLineId": "123802",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਰਤ ਕੁਬਿਰਤਿ ਪਿਯਤ ਮਦ ਪਾਨਾ ॥੨॥",
      "transliteration": "karat kubirat piyat madh paanaa ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਰਾਬ ਪੀ ਕੇ ਮਾੜੇ ਕੰਮ ਕਰਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "करत कुबिरति पियत मद पाना ॥२॥",
      "sourceLineId": "123803",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਾ ਕੋ ਭ੍ਰਾਤ ਦੁਤਿਯ ਸੁਭ ਕਾਰੀ ॥",
      "transliteration": "taa ko bhraat dhutiy subh kaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਦੂਜਾ ਭਰਾ ਸ਼ੁਭ ਕਰਮ ਕਰਨ ਵਾਲਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "ता को भ्रात दुतिय सुभ कारी ॥",
      "sourceLineId": "123804",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੂਪ ਰਹਿਤ ਨ ਕਛੂ ਦੁਰਚਾਰੀ ॥",
      "transliteration": "joop rahit na kachhoo dhurachaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਜੂਏ ਤੋਂ ਰਹਿਤ ਸੀ ਅਤੇ ਕੁਝ ਵੀ ਦੁਰਾਚਾਰ ਨਹੀਂ (ਕਰਦਾ) ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "जूप रहित न कछू दुरचारी ॥",
      "sourceLineId": "123805",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਾ ਸੌ ਨੇਹ ਮਾਤ ਕੋ ਰਹੈ ॥",
      "transliteration": "taa sau neh maat ko rahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਮਾਤਾ ਨੂੰ ਪਿਆਰ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "ता सौ नेह मात को रहै ॥",
      "sourceLineId": "123806",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਯਾ ਕੌ ਬੇਗਿ ਸੰਘਾਰੋ ਚਹੈ ॥੩॥",
      "transliteration": "yaa kau beg sa(n)ghaaro chahai ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ (ਕੁਪੁੱਤਰ) ਨੂੰ ਮਾਰ ਦੇਣਾ ਚਾਹੁੰਦੀ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "या कौ बेगि संघारो चहै ॥३॥",
      "sourceLineId": "123807",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਜਬ ਸੋ ਘਰ ਆਯੋ ॥",
      "transliteration": "ek dhivas jab so ghar aayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਜਦ ਉਹ ਘਰ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "एक दिवस जब सो घर आयो ॥",
      "sourceLineId": "123808",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੋਤ ਛਾਪਰੀ ਮਾਝ ਤਕਾਯੋ ॥",
      "transliteration": "sot chhaaparee maajh takaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਛਪਰੀ ਵਿਚ ਸੁਤਾ ਹੋਇਆ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "सोत छापरी माझ तकायो ॥",
      "sourceLineId": "123809",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਟਟਿਆ ਦ੍ਵਾਰ ਆਗਿ ਦੈ ਦਈ ॥",
      "transliteration": "TaTiaa dhavaiaar aag dhai dhiee ||",
      "translation": "",
      "punjabiViakhya": "(ਛਪਰੀ ਦੇ) ਦੁਆਰ ਦੇ ਖਿੜਕੇ ਨੂੰ ਅੱਗ ਲਗਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "टटिआ द्वार आगि दै दई ॥",
      "sourceLineId": "123810",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੁਤ ਕੋ ਮਾਤ ਜਰਾਵਤ ਭਈ ॥੪॥",
      "transliteration": "sut ko maat jaraavat bhiee ||4||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਪੁੱਤਰ ਨੂੰ ਮਾ ਨੇ ਸਾੜ ਦਿੱਤਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "सुत को मात जरावत भई ॥४॥",
      "sourceLineId": "123811",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮਾਤ ਪੂਤ ਕੌ ਪ੍ਰਥਮ ਜਰਾਯੋ ॥",
      "transliteration": "maat poot kau pratham jaraayo ||",
      "translation": "",
      "punjabiViakhya": "ਮਾ ਨੇ ਪਹਿਲਾ ਪੁੱਤਰ ਨੂੰ ਸਾੜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "मात पूत कौ प्रथम जरायो ॥",
      "sourceLineId": "123812",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰੋਇ ਰੋਇ ਸਭ ਜਗਤ ਸੁਨਾਯੋ ॥",
      "transliteration": "roi roi sabh jagat sunaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਫਿਰ) ਰੋ ਰੋ ਕੇ ਸਾਰੇ ਜਗਤ ਨੂੰ ਸੁਣਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "रोइ रोइ सभ जगत सुनायो ॥",
      "sourceLineId": "123813",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਆਗਿ ਲਗਾਇ ਪਾਨਿ ਕੌ ਧਾਈ ॥",
      "transliteration": "aag lagai paan kau dhaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਛਪਰੀ ਨੂੰ) ਅਗ ਲਗਾ ਕੇ ਪਾਣੀ ਲੈਣ ਲਈ ਭਜੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "आगि लगाइ पानि कौ धाई ॥",
      "sourceLineId": "123814",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮੂਰਖ ਬਾਤ ਨ ਕਿਨਹੂੰ ਪਾਈ ॥੫॥",
      "transliteration": "moorakh baat na kinahoo(n) paiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਵੀ ਮੂਰਖ ਨੇ ਇਸ ਗੱਲ ਨੂੰ ਨਹੀਂ ਸਮਝਿਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "मूरख बात न किनहूँ पाई ॥५॥",
      "sourceLineId": "123815",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਸਤਾਸੀਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੮੭॥੩੫੭੧॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau sataaseevo charitr samaapatam sat subham sat ||187||3571||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੮੭ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੮੭॥੩੫੭੧॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ सतासीवो चरित्र समापतम सतु सुभम सतु ॥१८७॥३५७१॥अफजूँ॥",
      "sourceLineId": "123816",
      "sourceShabadId": "11558",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123817",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕੰਚਨ ਪ੍ਰਭਾ ਜਾਟਜਾ ਰਹੈ ॥",
      "transliteration": "ka(n)chan prabhaa jaaTajaa rahai ||",
      "translation": "",
      "punjabiViakhya": "ਕੰਚਨ ਪ੍ਰਭਾ ਨਾ ਦੀ ਇਕ ਜੱਟ ਦੀ ਧੀ ਰਹਿੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "कंचन प्रभा जाटजा रहै ॥",
      "sourceLineId": "123818",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਤਿ ਦੁਤਿਵਾਨ ਤਾਹਿ ਜਗ ਕਹੈ ॥",
      "transliteration": "at dhutivaan taeh jag kahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜਗਤ ਅਤਿ ਸੁੰਦਰ ਕਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "अति दुतिवान ताहि जग कहै ॥",
      "sourceLineId": "123819",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭਰਤਾ ਏਕ ਪ੍ਰਥਮ ਤਿਨ ਕਿਯੋ ॥",
      "transliteration": "bharataa ek pratham tin kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਪਹਿਲਾ ਇਕ ਪਤੀ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "भरता एक प्रथम तिन कियो ॥",
      "sourceLineId": "123820",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਰੁਚਿਯੋ ਨ ਡਾਰਿ ਫਾਸ ਹਨਿ ਦਿਯੋ ॥੧॥",
      "transliteration": "ruchiyo na ddaar faas han dhiyo ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਚੰਗਾ ਨਾ ਲਗਿਆ, ਫਾਹੀ ਪਾ ਕੇ ਮਾਰ ਦਿੱਤਾ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "रुचियो न डारि फास हनि दियो ॥१॥",
      "sourceLineId": "123821",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕੇਤਿਕ ਦਿਨਨ ਔਰ ਪਤਿ ਕਰਿਯੋ ॥",
      "transliteration": "ketik dhinan aauar pat kariyo ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਝ ਕੁ ਦਿਨਾ ਬਾਦ ਹੋਰ ਪਤੀ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "केतिक दिनन और पति करियो ॥",
      "sourceLineId": "123822",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੋਊ ਨ ਰੁਚਿਯੋ ਕਟਾਰੀ ਮਰਿਯੋ ॥",
      "transliteration": "souoo na ruchiyo kaTaaree mariyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਵੀ ਪਸੰਦ ਨਾ ਆਇਆ ਅਤੇ ਕਟਾਰੀ ਮਾਰ ਕੇ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "सोऊ न रुचियो कटारी मरियो ॥",
      "sourceLineId": "123823",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਾਸ ਬਿਖੈ ਔਰੈ ਪਤਿ ਪਾਯੋ ॥",
      "transliteration": "maas bikhai aauarai pat paayo ||",
      "translation": "",
      "punjabiViakhya": "(ਇਕ) ਮਹੀਨੇ ਬਾਦ ਹੋਰ ਪਤੀ ਪ੍ਰਾਪਤ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "मास बिखै औरै पति पायो ॥",
      "sourceLineId": "123824",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੋਊ ਦੈ ਕੈ ਬਿਖੁ ਤ੍ਰਿਯ ਘਾਯੋ ॥੨॥",
      "transliteration": "souoo dhai kai bikh tiray ghaayo ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੀ ਇਸਤਰੀ ਨੇ ਜ਼ਹਿਰ ਦੇ ਕੇ ਮਾਰ ਦਿੱਤਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "सोऊ दै कै बिखु तृय घायो ॥२॥",
      "sourceLineId": "123825",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1073_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚੌਥੇ ਨਾਥ ਨਾਇਕਾ ਕੀਨੋ ॥",
      "transliteration": "chauathe naath naikaa keeno ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਇਕਾ ਨੇ ਚੌਥਾ ਪਤੀ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1073,
      "hindi": "",
      "hindiTransliteration": "चौथे नाथ नाइका कीनो ॥",
      "sourceLineId": "123826",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
