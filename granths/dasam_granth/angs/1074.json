{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1074,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1074_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਾ ਕਹ ਹਨਿ ਪੰਚਮ ਕਹ ਲੀਨੋ ॥",
      "transliteration": "taa keh han pa(n)cham keh leeno ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਮਾਰ ਕੇ ਪੰਜਵਾ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "ता कह हनि पंचम कह लीनो ॥",
      "sourceLineId": "123827",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਛਠਵੇ ਮਾਰਿ ਸਪਤਮੋ ਘਾਯੋ ॥",
      "transliteration": "chhaThave maar sapatamo ghaayo ||",
      "translation": "",
      "punjabiViakhya": "ਛੇਵੇਾਂ ਨੂੰ ਮਾਰ ਕੇ (ਫਿਰ) ਸੱਤਵਾ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "छठवे मारि सपतमो घायो ॥",
      "sourceLineId": "123828",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਸਟਮ ਕੈ ਸੰਗ ਨੇਹ ਲਗਾਯੋ ॥੩॥",
      "transliteration": "asaTam kai sa(n)g neh lagaayo ||3||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਅੱਠਵੇਾਂ ਨਾਲ ਪ੍ਰੇਮ ਕਰਨ ਲਗੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "असटम कै संग नेह लगायो ॥३॥",
      "sourceLineId": "123829",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਰਮ ਕਾਲ ਸੋਊ ਨਹਿ ਭਾਯੋ ॥",
      "transliteration": "karam kaal souoo neh bhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਕਰਮ (ਵੇਖੋ) ਉਹ ਵੀ ਚੰਗਾ ਨਾ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "करम काल सोऊ नहि भायो ॥",
      "sourceLineId": "123830",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਮਧਰ ਭਏ ਤਾਹਿ ਤਿਨ ਘਾਯੋ ॥",
      "transliteration": "jamadhar bhe taeh tin ghaayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਟਾਰ ਮਾਰ ਕੇ ਉਸ ਨੂੰ ਵੀ ਉਸ ਨੇ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "जमधर भए ताहि तिन घायो ॥",
      "sourceLineId": "123831",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਧ੍ਰਿਗ ਧ੍ਰਿਗ ਜਾਨਿ ਜਗਤ ਤਿਹ ਕਰਿਯੋ ॥",
      "transliteration": "dhirag dhirag jaan jagat teh kariyo ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਜਗਤ ਨੇ ਇਹ ਜਾਣ ਕੇ ਉਸ ਨੂੰ ਧਿਕਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "धृग धृग जानि जगत तिह करियो ॥",
      "sourceLineId": "123832",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਾਹਾਕਾਰ ਸਭਨ ਉਚਰਿਯੋ ॥੪॥",
      "transliteration": "haahaakaar sabhan uchariyo ||4||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਲੋਕਾ ਨੇ ਹਾ-ਹਾ ਕਾਰ ਮਚਾਇਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "हाहाकार सभन उचरियो ॥४॥",
      "sourceLineId": "123833",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਬ ਇਹ ਭਾਤਿ ਸੁਨਤਿ ਤ੍ਰਿਯ ਭਈ ॥",
      "transliteration": "jab ieh bhaat sunat tiray bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਇਸਤਰੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "जब इह भाति सुनति तृय भई ॥",
      "sourceLineId": "123834",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਾਨੁਕ ਬਿਨ ਮਾਰੇ ਮਰ ਗਈ ॥",
      "transliteration": "jaanuk bin maare mar giee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮਾਨੋ ਬਿਨਾ ਮਾਰਿਆਂ ਹੀ ਮਰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "जानुक बिन मारे मर गई ॥",
      "sourceLineId": "123835",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਬ ਹੌ ਜਰੋ ਨਾਥ ਤਨ ਜਾਈ ॥",
      "transliteration": "ab hau jaro naath tan jaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਸੋਚਣ ਲਗੀ) ਹੁਣ ਮੈਂ ਆਪਣੇ ਪਤੀ ਨਾਲ ਹੀ ਸੜ ਮਰਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "अब हौ जरो नाथ तन जाई ॥",
      "sourceLineId": "123836",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਨ ਸਭਹੂੰਨ ਚਰਿਤ੍ਰ ਦਿਖਾਈ ॥੫॥",
      "transliteration": "ein sabhahoo(n)n charitr dhikhaiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਨ੍ਰਹਾ ਸਾਰਿਆਂ ਨੂੰ ਚਰਿਤ੍ਰ ਵਿਖਾਵਾਗੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "इन सभहूँन चरित्र दिखाई ॥५॥",
      "sourceLineId": "123837",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਰੁਨ ਬਸਤ੍ਰ ਧਰ ਪਾਨ ਚਬਾਏ ॥",
      "transliteration": "arun basatr dhar paan chabaae ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਲਾਲ ਬਸਤ੍ਰ ਧਾਰਨ ਕਰ ਕੇ ਪਾਨ ਚਬਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "अरुन बसत्र धर पान चबाए ॥",
      "sourceLineId": "123838",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਲੋਗ ਸਭਨ ਕੋ ਕੂਕ ਸੁਨਾਏ ॥",
      "transliteration": "log sabhan ko kook sunaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਲੋਕਾ ਨੂੰ ਕੂਕ ਕੂਕ ਕੇ ਸੁਣਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "लोग सभन को कूक सुनाए ॥",
      "sourceLineId": "123839",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਯੌ ਕਹਿ ਹਾਥਿ ਸਿਧੌਰੇ ਗਹਿਯੋ ॥",
      "transliteration": "yau keh haath sidhauare gahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਕਹਿ ਕੇ ਉਸ ਨੇ ਹੱਥ ਵਿਚ ਸੰਧੂਰ ਲੈ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "यौ कहि हाथि सिधौरे गहियो ॥",
      "sourceLineId": "123840",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਰਿਬੋ ਸਾਥ ਨਾਥ ਕੈ ਚਹਿਯੋ ॥੬॥",
      "transliteration": "jaribo saath naath kai chahiyo ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਤੀ ਨਾਲ ਸੜਨਾ ਚਾਹਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "जरिबो साथ नाथ कै चहियो ॥६॥",
      "sourceLineId": "123841",
      "sourceShabadId": "11559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123842",
      "sourceShabadId": "11560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਪਤ ਨਾਥ ਨਿਜ ਕਰਨ ਹਨਿ ਕਿਯੋ ਸਤੀ ਕੋ ਭੇਸ ॥",
      "transliteration": "sapat naath nij karan han kiyo satee ko bhes ||",
      "translation": "",
      "punjabiViakhya": "ਸੱਤ ਪਤੀਆਂ ਨੂੰ ਆਪਣੇ ਹੱਥਾ ਨਾਲ ਮਾਰ ਕੇ (ਹੁਣ) ਸਤੀ ਦਾ ਭੇਸ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "सपत नाथ निज करन हनि कियो सती को भेस ॥",
      "sourceLineId": "123843",
      "sourceShabadId": "11560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਊਚ ਨੀਚ ਦੇਖਤ ਤਰਨਿ ਪਾਵਕ ਕਿਯੋ ਪ੍ਰਵੇਸ ॥੭॥",
      "transliteration": "uooch neech dhekhat taran paavak kiyo praves ||7||",
      "translation": "",
      "punjabiViakhya": "ਉੱਚਿਆਂ ਨੀਵਿਆਂ ਦੇ ਵੇਖਦੇ ਹੋਇਆਂ ਇਸਤਰੀ ਨੇ ਅਗਨੀ (ਭਾਵ ਚਿਖਾ) ਵਿਚ ਪ੍ਰਵੇਸ਼ ਕਰ ਲਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "ऊच नीच देखत तरनि पावक कियो प्रवेस ॥७॥",
      "sourceLineId": "123844",
      "sourceShabadId": "11560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਪਤ ਨਾਥ ਨਿਜੁ ਹਾਥ ਹਨਿ ਅਸਟਮ ਕੌ ਗਰ ਲਾਇ ॥",
      "transliteration": "sapat naath nij haath han asaTam kau gar lai ||",
      "translation": "",
      "punjabiViakhya": "ਸੱਤ ਪਤੀਆਂ ਨੂੰ ਆਪਣੇ ਹੱਥਾ ਨਾਲ ਮਾਰ ਕੇ ਅਤੇ ਅੱਠਵੇਾਂ ਨੂੰ ਗਲ ਨਾਲ ਲਗਾ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "सपत नाथ निजु हाथ हनि असटम कौ गर लाइ ॥",
      "sourceLineId": "123845",
      "sourceShabadId": "11560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਭ ਲੋਗਨ ਦੇਖਤ ਜਰੀ ਢੋਲ ਮ੍ਰਿਦੰਗ ਬਜਾਇ ॥੮॥",
      "transliteration": "sabh logan dhekhat jaree ddol miradha(n)g bajai ||8||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਲੋਕਾ ਦੇ ਵੇਖਦੇ ਵੇਖਦੇ ਢੋਲ ਮ੍ਰਿਦੰਗਿ ਵਜਾਉਾਂਦੀ ਹੋਈ ਸੜ ਮੋਈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "सभ लोगन देखत जरी ढोल मृदंग बजाइ ॥८॥",
      "sourceLineId": "123846",
      "sourceShabadId": "11560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਅਠਾਸੀਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੮੮॥੩੫੭੯॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau aThaaseevo charitr samaapatam sat subham sat ||188||3579||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੮੮ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੮੮॥੩੫੭੯॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ अठासीवो चरित्र समापतम सतु सुभम सतु ॥१८८॥३५७९॥अफजूँ॥",
      "sourceLineId": "123847",
      "sourceShabadId": "11560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123848",
      "sourceShabadId": "11561",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭੂਪ ਕਲਾ ਨਾਮਾ ਰਹੈ ਸੁਤਾ ਸਾਹ ਕੀ ਏਕ ॥",
      "transliteration": "bhoop kalaa naamaa rahai sutaa saeh kee ek ||",
      "translation": "",
      "punjabiViakhya": "ਭੂਪ ਕਲਾ ਨਾ ਦੀ ਇਕ ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਰਹਿੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "भूप कला नामा रहै सुता साह की एक ॥",
      "sourceLineId": "123849",
      "sourceShabadId": "11561",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਧਿਕ ਦਰਬ ਤਾ ਕੇ ਰਹੈ ਦਾਸੀ ਰਹੈ ਅਨੇਕ ॥੧॥",
      "transliteration": "adhik dharab taa ke rahai dhaasee rahai anek ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਕੋਲ ਬਹੁਤ ਧਨ ਸੀ ਅਤੇ ਅਨੇਕ ਦਾਸੀਆਂ ਰਹਿੰਦੀਆਂ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "अधिक दरब ता के रहै दासी रहै अनेक ॥१॥",
      "sourceLineId": "123850",
      "sourceShabadId": "11561",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123851",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਿਸਰੀ ਕੋ ਹੀਰਾ ਤਿਨ ਲਿਯੋ ॥",
      "transliteration": "misaree ko heeraa tin liyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਮਿਸਰੀ ਦਾ ਇਕ ਹੀਰਾ (ਬਣਾ) ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "मिसरी को हीरा तिन लियो ॥",
      "sourceLineId": "123852",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਡਬਿਯਾ ਬਿਖੈ ਡਾਰਿ ਕਰਿ ਦਿਯੋ ॥",
      "transliteration": "ddabiyaa bikhai ddaar kar dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਡਬੀ ਵਿਚ ਬੰਦ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "डबिया बिखै डारि करि दियो ॥",
      "sourceLineId": "123853",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਾਹਜਹਾ ਜਹ ਸਭਾ ਬਨਾਈ ॥",
      "transliteration": "saahajahaa jeh sabhaa banaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਸ਼ਾਹਜਹਾਨ ਸਭਾ ਬਣਾ ਕੇ (ਬੈਠਾ ਸੀ)",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "साहजहा जह सभा बनाई ॥",
      "sourceLineId": "123854",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਹਲ ਬੈਠਿ ਤਿਹ ਓਰ ਸਿਧਾਈ ॥੨॥",
      "transliteration": "bahal baiTh teh or sidhaiee ||2||",
      "translation": "",
      "punjabiViakhya": "ਬਹਿਲ (ਬੈਲ-ਗੱਡੀ) ਵਿਚ ਬੈਠ ਕੇ ਉਧਰ ਨੂੰ ਚਲ ਪਈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "बहल बैठि तिह ओर सिधाई ॥२॥",
      "sourceLineId": "123855",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਰਧ ਬਜਾਰ ਬਿਖੈ ਜਬ ਗਈ ॥",
      "transliteration": "aradh bajaar bikhai jab giee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਬਾਜ਼ਾਰ ਦੇ ਅੱਧ ਵਿਚ ਪਹੁੰਚੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "अरध बजार बिखै जब गई ॥",
      "sourceLineId": "123856",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੁੰਦਰ ਨਰਿਕ ਬਿਲੋਕਤ ਭਈ ॥",
      "transliteration": "su(n)dhar narik bilokat bhiee ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਉਸ ਨੇ) ਇਕ ਸੁੰਦਰ ਪੁਰਸ਼ ਨੂੰ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "सुँदर नरिक बिलोकत भई ॥",
      "sourceLineId": "123857",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਧਿਕ ਦਰਬੁ ਦੈ ਨਿਕਟਿ ਬੁਲਾਯੋ ॥",
      "transliteration": "adhik dharab dhai nikaT bulaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਬਹੁਤ ਧਨ ਦੇ ਕੇ ਨੇੜੇ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "अधिक दरबु दै निकटि बुलायो ॥",
      "sourceLineId": "123858",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਿਜ ਗਾਡੀ ਕੇ ਸਾਥ ਲਗਾਯੋ ॥੩॥",
      "transliteration": "nij gaaddee ke saath lagaayo ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੀ ਬਹਿਲ ਦੇ ਨਾਲ ਨਾਲ ਤੋਰ ਲਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "निज गाडी के साथ लगायो ॥३॥",
      "sourceLineId": "123859",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਚਲਿਤ ਚਲਿਤ ਰਜਨੀ ਪਰਿ ਗਈ ॥",
      "transliteration": "chalit chalit rajanee par giee ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਰਦਿਆਂ ਤੁਰਦਿਆਂ ਰਾਤ ਪੈ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "चलित चलित रजनी परि गई ॥",
      "sourceLineId": "123860",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੂਰਜ ਛਪ੍ਯੋ ਚੰਦ੍ਰ ਦੁਤਿ ਭਈ ॥",
      "transliteration": "sooraj chhapayo cha(n)dhr dhut bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਜ ਡੁਬ ਗਿਆ ਅਤੇ ਚੰਨ ਦੀ ਚਾਨਣੀ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "सूरज छप्यो चंद्र दुति भई ॥",
      "sourceLineId": "123861",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਹਲ ਬਿਖੈ ਗਹਿ ਬਾਹ ਚੜਾਯੋ ॥",
      "transliteration": "bahal bikhai geh baeh chaRaayo ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਹ ਪਕੜ ਕੇ (ਉਸ ਪੁਰਸ਼ ਨੂੰ) ਬਹਿਲ ਵਿਚ ਚੜ੍ਰਹਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "बहल बिखै गहि बाह चड़ायो ॥",
      "sourceLineId": "123862",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਾਮ ਕੇਲ ਤਿਹ ਸੰਗ ਉਪਜਾਯੋ ॥੪॥",
      "transliteration": "kaam kel teh sa(n)g upajaayo ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਕਾਮਕ੍ਰੀੜਾ ਕੀਤੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "काम केल तिह संग उपजायो ॥४॥",
      "sourceLineId": "123863",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜ੍ਯੋ ਜ੍ਯੋ ਬਹਲ ਹਿਲੋਰੇ ਖਾਵੈ ॥",
      "transliteration": "jayo jayo bahal hilore khaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਉਾਂ ਜਿਉਾਂ ਬਹਿਲ ਹਿਲੋਰੇ (ਹਿਚਕੋਲੇ) ਖਾਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "ज्यो ज्यो बहल हिलोरे खावै ॥",
      "sourceLineId": "123864",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਉਛਰੇ ਬਿਨਾ ਕਾਜ ਹ੍ਵੈ ਜਾਵੈ ॥",
      "transliteration": "auchhare binaa kaaj havai jaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਉਨ੍ਰਹਾ ਦਾ) ਉਛਲਣ ਤੋਂ ਬਿਨਾ ਕੰਮ ਹੁੰਦਾ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "उछरे बिना काज ह्वै जावै ॥",
      "sourceLineId": "123865",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਲਖੈ ਲੋਗ ਗਾਡੀ ਕਰ ਮਾਰੈ ॥",
      "transliteration": "lakhai log gaaddee kar maarai ||",
      "translation": "",
      "punjabiViakhya": "ਲੋਕੀਂ ਸਮਝਦੇ ਕਿ ਬਹਿਲ 'ਚੀਕੂੰ ਚੀਕੂੰ' ਕਰਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "लखै लोग गाडी कर मारै ॥",
      "sourceLineId": "123866",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਕੋਊ ਬਿਚਾਰੈ ॥੫॥",
      "transliteration": "bhedh abhedh na kouoo bichaarai ||5||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਭੇਦ ਅਭੇਦ (ਦੀ ਗੱਲ) ਕੋਈ ਵੀ ਵਿਚਾਰਦਾ ਨਹੀਂ ਸੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न कोऊ बिचारै ॥५॥",
      "sourceLineId": "123867",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭਾਖਿ ਬੈਨ ਤੇ ਬਹਲ ਧਵਾਈ ॥",
      "transliteration": "bhaakh bain te bahal dhavaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਬੋਲ ਕੇ ਬਹਲ ਨੂੰ ਤੇਜ਼ ਚਲਵਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "भाखि बैन ते बहल धवाई ॥",
      "sourceLineId": "123868",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਾਮ ਰੀਤਿ ਕਰਿ ਪ੍ਰੀਤਿ ਉਪਜਾਈ ॥",
      "transliteration": "kaam reet kar preet upajaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪ੍ਰੇਮ ਪੂਰਵਕ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "काम रीति करि प्रीति उपजाई ॥",
      "sourceLineId": "123869",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਭਰਿ ਕਰਿ ਭੋਗ ਬਾਮ ਸੌ ਕੀਨੋ ॥",
      "transliteration": "bhar kar bhog baam sau keeno ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਜੀ ਭਰ ਕੇ ਇਸਤਰੀ ਨਾਲ ਕਾਮ-ਕੇਲ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "भरि करि भोग बाम सौ कीनो ॥",
      "sourceLineId": "123870",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬੀਚ ਬਜਾਰਨ ਕਿਨਹੂੰ ਚੀਨੋ ॥੬॥",
      "transliteration": "beech bajaaran kinahoo(n) cheeno ||6||",
      "translation": "",
      "punjabiViakhya": "ਬਾਜ਼ਾਰ ਵਿਚ ਕਿਸੇ ਨੇ ਵੀ ਨਾ ਸਮਝਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "बीच बजारन किनहूँ चीनो ॥६॥",
      "sourceLineId": "123871",
      "sourceShabadId": "11562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123872",
      "sourceShabadId": "11563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕੇਲ ਕਰਤ ਇਹ ਚੰਚਲਾ ਤਹਾ ਪਹੂਚੀ ਆਇ ॥",
      "transliteration": "kel karat ieh cha(n)chalaa tahaa pahoochee aai ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਦਿਆਂ ਉਹ ਇਸਤਰੀ ਉਥੇ ਆ ਪਹੁੰਚੀ",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "केल करत इह चंचला तहा पहूची आइ ॥",
      "sourceLineId": "123873",
      "sourceShabadId": "11563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1074_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਾਹਜਹਾ ਬੈਠੇ ਜਹਾ ਨੀਕੀ ਸਭਾ ਬਨਾਇ ॥੭॥",
      "transliteration": "saahajahaa baiThe jahaa neekee sabhaa banai ||7||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਸ਼ਾਹਜਹਾਨ ਚੰਗੀ ਤਰ੍ਰਹਾ ਸਭਾ ਲਗਾ ਕੇ ਬੈਠਾ ਸੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1074,
      "hindi": "",
      "hindiTransliteration": "साहजहा बैठे जहा नीकी सभा बनाइ ॥७॥",
      "sourceLineId": "123874",
      "sourceShabadId": "11563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
