{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1075,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1075_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123875",
      "sourceShabadId": "11564",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਿਸਰੀ ਕੇ ਹੀਰਾ ਕਰ ਲਿਯੋ ॥",
      "transliteration": "misaree ke heeraa kar liyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਮਿਸਰੀ ਦਾ ਹੀਰਾ ਹੱਥ ਵਿਚ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "मिसरी के हीरा कर लियो ॥",
      "sourceLineId": "123876",
      "sourceShabadId": "11564",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਲੈ ਹਜਰਤਿ ਕੇ ਹਾਜਰ ਕਿਯੋ ॥",
      "transliteration": "lai hajarat ke haajar kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲੈ ਕੇ ਬਾਦਸ਼ਾਹ ਦੇ ਹਾਜ਼ਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "लै हजरति के हाजर कियो ॥",
      "sourceLineId": "123877",
      "sourceShabadId": "11564",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਾਹਜਹਾ ਤਿਹ ਕਛੂ ਨ ਚੀਨੋ ॥",
      "transliteration": "saahajahaa teh kachhoo na cheeno ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਾਹਜਹਾਨ ਨੇ ਉਸ (ਹੀਰੇ) ਨੂੰ ਨਾ ਪਛਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "साहजहा तिह कछू न चीनो ॥",
      "sourceLineId": "123878",
      "sourceShabadId": "11564",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤੀਸ ਹਜਾਰ ਰੁਪੈਯਾ ਦੀਨੋ ॥੮॥",
      "transliteration": "tees hajaar rupaiyaa dheeno ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੀਹ ਹਜ਼ਾਰ ਰੁਪਇਆ ਦੇ ਦਿੱਤਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "तीस हजार रुपैया दीनो ॥८॥",
      "sourceLineId": "123879",
      "sourceShabadId": "11564",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਇਹ ਛਲ ਸੌ ਸਾਹਹਿ ਛਲਿ ਗਈ ॥",
      "transliteration": "eeh chhal sau saaheh chhal giee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ (ਉਹ ਇਸਤਰੀ) ਬਾਦਸ਼ਾਹ ਨੂੰ ਛਲ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "इह छल सौ साहहि छलि गई ॥",
      "sourceLineId": "123880",
      "sourceShabadId": "11564",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਉਠੀ ਸਭਾ ਆਵਤ ਸੋਊ ਭਈ ॥",
      "transliteration": "auThee sabhaa aavat souoo bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਭਾ ਤੋਂ ਉਠ ਕੇ ਆ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "उठी सभा आवत सोऊ भई ॥",
      "sourceLineId": "123881",
      "sourceShabadId": "11564",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪੰਦ੍ਰਹ ਸਹਸ੍ਰ ਆਪੁ ਤ੍ਰਿਯ ਲੀਨੋ ॥",
      "transliteration": "pa(n)dhreh sahasr aap tiray leeno ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਇਸਤਰੀ ਨੇ ਪੰਦ੍ਰਹਾ ਹਜ਼ਾਰ ਆਪ ਰਖ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "पंद्रह सहस्र आपु तृय लीनो ॥",
      "sourceLineId": "123882",
      "sourceShabadId": "11564",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪੰਦ੍ਰਹ ਸਹਸ੍ਰ ਮੀਤ ਕੋ ਦੀਨੋ ॥੯॥",
      "transliteration": "pa(n)dhreh sahasr meet ko dheeno ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੰਦ੍ਰਹਾ ਹਜ਼ਾਰ ਮਿਤਰ ਨੂੰ ਦੇ ਦਿੱਤੇ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "पंद्रह सहस्र मीत को दीनो ॥९॥",
      "sourceLineId": "123883",
      "sourceShabadId": "11564",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123884",
      "sourceShabadId": "11565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਾਹਜਹਾ ਛਲਿ ਮੀਤ ਸੌ ਕਾਮ ਕਲੋਲ ਕਮਾਇ ॥",
      "transliteration": "saahajahaa chhal meet sau kaam kalol kamai ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਾਹਜਹਾਨ ਨੂੰ ਛਲ ਕੇ ਅਤੇ ਮਿਤਰ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "साहजहा छलि मीत सौ काम कलोल कमाइ ॥",
      "sourceLineId": "123885",
      "sourceShabadId": "11565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਧਾਮ ਆਨਿ ਪਹੁਚਤ ਭਈ ਸਕਿਯੋ ਨ ਕੋਊ ਪਾਇ ॥੧੦॥",
      "transliteration": "dhaam aan pahuchat bhiee sakiyo na kouoo pai ||10||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਘਰ ਵਿਚ ਆ ਗਈ। ਕੋਈ ਵੀ (ਉਸ ਦੇ ਭੇਦ ਨੂੰ) ਨਾ ਪਾ ਸਕਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "धाम आनि पहुचत भई सकियो न कोऊ पाइ ॥१०॥",
      "sourceLineId": "123886",
      "sourceShabadId": "11565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਉਨਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੮੯॥੩੫੮੯॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau unaanavo charitr samaapatam sat subham sat ||189||3589||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੮੯ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੮੯॥੩੫੮੯॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ उनानवो चरित्र समापतम सतु सुभम सतु ॥१८९॥३५८९॥अफजूँ॥",
      "sourceLineId": "123887",
      "sourceShabadId": "11565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123888",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਇਕ ਦਿਨ ਬਾਗ ਚੰਚਲਾ ਗਈ ॥",
      "transliteration": "eik dhin baag cha(n)chalaa giee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਬਾਗ਼ ਵਿਚ ਇਸਤਰੀਆਂ ਗਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "इक दिन बाग चंचला गई ॥",
      "sourceLineId": "123889",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹਸਿ ਹਸਿ ਬਚਨ ਬਖਾਨਤ ਭਈ ॥",
      "transliteration": "has has bachan bakhaanat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹਸ ਹਸ ਕੇ ਗੱਲਾ ਕਰਨ ਲਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "हसि हसि बचन बखानत भई ॥",
      "sourceLineId": "123890",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸ੍ਰੀ ਨਿਸਿ ਰਾਜ ਪ੍ਰਭਾ ਤ੍ਰਿਯ ਤਹਾ ॥",
      "transliteration": "sree nis raaj prabhaa tiray tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਨਿਸਿ ਰਾਜ ਪ੍ਰਭਾ ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "स्री निसि राज प्रभा तृय तहा ॥",
      "sourceLineId": "123891",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਐਸੀ ਭਾਤਿ ਉਚਾਰਿਯੋ ਉਹਾ ॥੧॥",
      "transliteration": "aaisee bhaat uchaariyo uhaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਉਥੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "ऐसी भाति उचारियो उहा ॥१॥",
      "sourceLineId": "123892",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜੌ ਰਾਜੇ ਤੇ ਬਾਰਿ ਭਿਰਾਊ ॥",
      "transliteration": "jau raaje te baar bhiraauoo ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ (ਮੈਂ) ਰਾਜੇ ਤੋਂ ਪਾਣੀ ਭਰਵਾਵਾ",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "जौ राजे ते बारि भिराऊ ॥",
      "sourceLineId": "123893",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਪਨੀ ਝਾਟੈ ਸਭੈ ਮੁੰਡਾਊ ॥",
      "transliteration": "apanee jhaaTai sabhai mu(n)ddaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੀਆਂ ਸਾਰੀਆਂ ਝਾਟਾ ਉਸ ਤੋਂ ਮੁਨਵਾਵਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "अपनी झाटै सभै मुँडाऊ ॥",
      "sourceLineId": "123894",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਬ ਤ੍ਰਿਯ ਹੋਡ ਸਕਲ ਤੁਮ ਹਾਰਹੁ ॥",
      "transliteration": "tab tiray hodd sakal tum haarahu ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੇ ਇਸਤਰੀਓ! ਤੁਸੀਂ ਸਾਰੀਆਂ ਸ਼ਰਤ ਹਾਰ ਜਾਓਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "तब तृय होड सकल तुम हारहु ॥",
      "sourceLineId": "123895",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਿਜੁ ਨੈਨਨ ਇਹ ਚਰਿਤ ਨਿਹਾਰਹੁ ॥੨॥",
      "transliteration": "nij nainan ieh charit nihaarahu ||2||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੀਆਂ ਅੱਖਾ ਨਾਲ (ਮੇਰਾ) ਇਹ ਚਰਿਤ੍ਰ ਵੇਖਿਓ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "निजु नैनन इह चरित निहारहु ॥२॥",
      "sourceLineId": "123896",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਯੌ ਕਹਿ ਕੈ ਸੁਭ ਭੇਸ ਬਨਾਯੋ ॥",
      "transliteration": "yau keh kai subh bhes banaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਕਹਿ ਕੇ ਉਸ ਨੇ ਸੁੰਦਰ ਭੇਸ ਬਣਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "यौ कहि कै सुभ भेस बनायो ॥",
      "sourceLineId": "123897",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੇਵ ਅਦੇਵਨ ਕੋ ਬਿਰਮਾਯੋ ॥",
      "transliteration": "dhev adhevan ko biramaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੇਵਤਿਆਂ ਤੇ ਦੈਂਤਾ ਨੂੰ (ਆਪਣੀ ਸੁੰਦਰਤਾ ਨਾਲ) ਭਰਮਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "देव अदेवन को बिरमायो ॥",
      "sourceLineId": "123898",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚਰਿਤ੍ਰ ਸਿੰਘ ਰਾਜਾ ਜਬ ਆਯੋ ॥",
      "transliteration": "charitr si(n)gh raajaa jab aayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਚਰਿਤ੍ਰ ਸਿੰਘ ਰਾਜਾ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "चरित्र सिंघ राजा जब आयो ॥",
      "sourceLineId": "123899",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੁਨਿ ਇਹ ਬਚਨ ਚੰਚਲਾ ਪਾਯੋ ॥੩॥",
      "transliteration": "sun ieh bachan cha(n)chalaa paayo ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਸਤਰੀਆਂ ਨੇ ਇਹ ਗੱਲ ਸੁਣ ਲਈ (ਭਾਵ ਰਾਜੇ ਦੀ ਆਮਦ ਦਾ ਪਤਾ ਚਲ ਗਿਆ) ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "सुनि इह बचन चंचला पायो ॥३॥",
      "sourceLineId": "123900",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬੈਠ ਝਰੋਖਾ ਦਈ ਦਿਖਾਈ ॥",
      "transliteration": "baiTh jharokhaa dhiee dhikhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਝਰੋਖੇ ਵਿਚ ਬੈਠ ਕੇ ਰਾਜੇ ਨੂੰ ਵਿਖਾਲੀ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "बैठ झरोखा दई दिखाई ॥",
      "sourceLineId": "123901",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰਾਜਾ ਰਹੇ ਰੂਪ ਉਰਝਾਈ ॥",
      "transliteration": "raajaa rahe roop urajhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਉਸ ਦੇ ਰੂਪ ਉਤੇ ਮੋਹਿਤ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "राजा रहे रूप उरझाई ॥",
      "sourceLineId": "123902",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਏਕ ਬਾਰ ਇਹ ਕੌ ਜੌ ਪਾਊ ॥",
      "transliteration": "ek baar ieh kau jau paauoo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ ਮਨ ਵਿਚ ਸੋਚਣ ਲਗਾ ਕਿ) ਜੇ ਇਕ ਵਾਰ ਮੈਂ ਇਸ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰ ਲਵਾ",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "एक बार इह कौ जौ पाऊ ॥",
      "sourceLineId": "123903",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਨਮ ਸਹਸ੍ਰ ਲਗੇ ਬਲਿ ਜਾਊ ॥੪॥",
      "transliteration": "janam sahasr lage bal jaauoo ||4||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਹਜ਼ਾਰ ਜਨਮ ਤਕ (ਇਸ ਤੋਂ) ਵਾਰਨੇ ਜਾਵਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "जनम सहस्र लगे बलि जाऊ ॥४॥",
      "sourceLineId": "123904",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪਠੈ ਸਹਚਰੀ ਲਈ ਬੁਲਾਈ ॥",
      "transliteration": "paThai sahacharee liee bulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਦਾਸੀ ਭੇਜ ਕੇ ਉਸ ਨੂੰ ਬੁਲਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "पठै सहचरी लई बुलाई ॥",
      "sourceLineId": "123905",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪ੍ਰੀਤਿ ਸਹਿਤ ਰਸ ਰੀਤੁਪਜਾਈ ॥",
      "transliteration": "preet sahit ras reetupajaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪ੍ਰੀਤ ਸਹਿਤ ਰਤੀ ਰਸ ਨੂੰ ਪੈਦਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "प्रीति सहित रस रीतुपजाई ॥",
      "sourceLineId": "123906",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਬਲਾ ਤਬ ਮੁਰਛਿਤ ਹ੍ਵੈ ਗਈ ॥",
      "transliteration": "abalaa tab murachhit havai giee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਤਦ ਬੇਹੋਸ਼ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "अबला तब मुरछित ह्वै गई ॥",
      "sourceLineId": "123907",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪਾਨਿ ਪਾਨਿ ਉਚਰਤ ਮੁਖ ਭਈ ॥੫॥",
      "transliteration": "paan paan ucharat mukh bhiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੂੰਹੋਂ ਪਾਣੀ ਪਾਣੀ ਕਹਿਣ ਲਗੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "पानि पानि उचरत मुख भई ॥५॥",
      "sourceLineId": "123908",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਉਠ ਕਰਿ ਆਪੁ ਰਾਵ ਤਬ ਗਯੋ ॥",
      "transliteration": "auTh kar aap raav tab gayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜਾ ਆਪ ਉਠ ਕੇ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "उठ करि आपु राव तब गयो ॥",
      "sourceLineId": "123909",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਾ ਕਹ ਪਾਨਿ ਪਯਾਵਤ ਭਯੋ ॥",
      "transliteration": "taa keh paan payaavat bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਪਾਣੀ ਪਿਲਾਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "ता कह पानि पयावत भयो ॥",
      "sourceLineId": "123910",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪਾਨਿ ਪਿਏ ਬਹੁਰੇ ਸੁਧਿ ਭਈ ॥",
      "transliteration": "paan pie bahure sudh bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਪਾਣੀ ਪੀਣ ਨਾਲ ਫਿਰ ਉਸ ਨੂੰ ਹੋਸ਼ ਆਈ",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "पानि पिए बहुरे सुधि भई ॥",
      "sourceLineId": "123911",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਾਜੈ ਫਿਰਿ ਚੁੰਬਨ ਤਿਹ ਲਈ ॥੬॥",
      "transliteration": "raajai fir chu(n)ban teh liee ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੇ ਫਿਰ ਉਸ ਦਾ ਚੁੰਬਣ ਲਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "राजै फिरि चुँबन तिह लई ॥६॥",
      "sourceLineId": "123912",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਬ ਸੁਧਿ ਮੈ ਅਬਲਾ ਕਛੁ ਆਈ ॥",
      "transliteration": "jab sudh mai abalaa kachh aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਇਸਤਰੀ ਜ਼ਰਾ ਹੋਸ਼ ਵਿਚ ਆਈ",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "जब सुधि मै अबला कछु आई ॥",
      "sourceLineId": "123913",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਹੁਰਿ ਕਾਮ ਕੀ ਕੇਲ ਮਚਾਈ ॥",
      "transliteration": "bahur kaam kee kel machaiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਫਿਰ ਕਾਮ-ਕ੍ਰੀੜਾ ਸ਼ੁਰੂ ਕਰ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "बहुरि काम की केल मचाई ॥",
      "sourceLineId": "123914",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੋਊ ਤਰਨ ਨ ਕੋਊ ਹਾਰੈ ॥",
      "transliteration": "dhouoo taran na kouoo haarai ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਜਵਾਨ ਸਨ, ਕੋਈ ਹਾਰ ਨਹੀਂ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "दोऊ तरन न कोऊ हारै ॥",
      "sourceLineId": "123915",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਯੌ ਰਾਜਾ ਤਿਹ ਸਾਥ ਬਿਹਾਰੈ ॥੭॥",
      "transliteration": "yau raajaa teh saath bihaarai ||7||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਰਾਜਾ ਉਸ ਨਾਲ ਰਮਣ ਕਰ ਰਿਹਾ ਸੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "यौ राजा तिह साथ बिहारै ॥७॥",
      "sourceLineId": "123916",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਹੁਰਿ ਬਾਲ ਇਹ ਭਾਤਿ ਉਚਾਰੀ ॥",
      "transliteration": "bahur baal ieh bhaat uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਇਸਤਰੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "बहुरि बाल इह भाति उचारी ॥",
      "sourceLineId": "123917",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੁਨੋ ਰਾਵ ਤੁਮ ਬਾਤ ਹਮਾਰੀ ॥",
      "transliteration": "suno raav tum baat hamaaree ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਤੁਸੀਂ ਮੇਰੀ ਗੱਲ ਸੁਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "सुनो राव तुम बात हमारी ॥",
      "sourceLineId": "123918",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤ੍ਰਿਯ ਕੀ ਝਾਟਿ ਨ ਮੂੰਡੀ ਜਾਈ ॥",
      "transliteration": "tiray kee jhaaT na moo(n)ddee jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਵੇਦਾ ਪੁਰਾਣਾ ਵਿਚ ਸੁਣਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "तृय की झाटि न मूँडी जाई ॥",
      "sourceLineId": "123919",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬੇਦ ਪੁਰਾਨਨ ਮੈ ਸੁਨਿ ਪਾਈ ॥੮॥",
      "transliteration": "bedh puraanan mai sun paiee ||8||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਸਤਰੀ ਦੀ ਝਾਟ ਮੁੰਨੀ ਨਹੀਂ ਜਾਦੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "बेद पुरानन मै सुनि पाई ॥८॥",
      "sourceLineId": "123920",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਸਿ ਕਰਿ ਰਾਵ ਬਚਨ ਯੌ ਠਾਨ੍ਰਯੋ ॥",
      "transliteration": "has kar raav bachan yau Thaanrayo ||",
      "translation": "",
      "punjabiViakhya": "ਹਸ ਕੇ ਰਾਜੇ ਨੇ ਕਿਹਾ (ਕਿ ਇਸ ਗੱਲ ਨੂੰ)",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "हसि करि राव बचन यौ ठान्रयो ॥",
      "sourceLineId": "123921",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1075_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮੈ ਅਪੁਨੇ ਜਿਯ ਸਾਚ ਨ ਜਾਨ੍ਯੋ ॥",
      "transliteration": "mai apune jiy saach na jaanayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਆਪਣੇ ਮਨ ਵਿਚ ਸਚ ਨਹੀਂ ਮੰਨਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1075,
      "hindi": "",
      "hindiTransliteration": "मै अपुने जिय साच न जान्यो ॥",
      "sourceLineId": "123922",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
