{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1076,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1076_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤੈ ਤ੍ਰਿਯ ਹਮ ਸੋ ਝੂਠ ਉਚਾਰੀ ॥",
      "transliteration": "tai tiray ham so jhooTh uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਇਸਤਰੀ! ਤੂੰ ਮੈਨੂੰ ਝੂਠ ਕਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "तै तृय हम सो झूठ उचारी ॥",
      "sourceLineId": "123923",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਹਮ ਮੂੰਡੈਗੇ ਝਾਟਿ ਤਿਹਾਰੀ ॥੯॥",
      "transliteration": "ham moo(n)ddaige jhaaT tihaaree ||9||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਤੇਰੀ ਝਾਟ ਮੁੰਨਾਗਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "हम मूँडैगे झाटि तिहारी ॥९॥",
      "sourceLineId": "123924",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤੇਜ ਅਸਤੁਰਾ ਏਕ ਮੰਗਾਯੋ ॥",
      "transliteration": "tej asaturaa ek ma(n)gaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਇਕ ਤੇਜ਼ ਉਸਤਰਾ ਮੰਗਵਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "तेज असतुरा एक मंगायो ॥",
      "sourceLineId": "123925",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਿਜ ਕਰ ਗਹਿ ਕੈ ਰਾਵ ਚਲਾਯੋ ॥",
      "transliteration": "nij kar geh kai raav chalaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੇ ਆਪਣੇ ਹਥ ਵਿਚ ਲੈ ਕੇ ਚਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "निज कर गहि कै राव चलायो ॥",
      "sourceLineId": "123926",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਾ ਕੀ ਮੂੰਡਿ ਝਾਟਿ ਸਭ ਡਾਰੀ ॥",
      "transliteration": "taa kee moo(n)dd jhaaT sabh ddaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸਾਰੀ ਝਾਟ ਮੁੰਨ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "ता की मूँडि झाटि सभ डारी ॥",
      "sourceLineId": "123927",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਦੈ ਕੈ ਹਸੀ ਚੰਚਲਾ ਤਾਰੀ ॥੧੦॥",
      "transliteration": "dhai kai hasee cha(n)chalaa taaree ||10||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਤਾੜੀ ਵਜਾ ਕੇ ਹਸੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "दै कै हसी चंचला तारी ॥१०॥",
      "sourceLineId": "123928",
      "sourceShabadId": "11566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123929",
      "sourceShabadId": "11567",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪਾਨਿ ਭਰਾਯੋ ਰਾਵ ਤੇ ਨਿਜੁ ਕਰ ਝਾਟਿ ਮੁੰਡਾਇ ॥",
      "transliteration": "paan bharaayo raav te nij kar jhaaT mu(n)ddai ||",
      "translation": "",
      "punjabiViakhya": "(ਪਹਿਲਾ) ਰਾਜੇ ਤੋਂ ਪਾਣੀ ਭਰਵਾਇਆ (ਫਿਰ ਉਸ ਦੇ) ਹੱਥੋਂ ਝਾਟ ਮੁੰਨਵਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "पानि भरायो राव ते निजु कर झाटि मुँडाइ ॥",
      "sourceLineId": "123930",
      "sourceShabadId": "11567",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹੋਡ ਜੀਤ ਲੇਤੀ ਭਈ ਤਿਨ ਅਬਲਾਨ ਦਿਖਾਇ ॥੧੧॥",
      "transliteration": "hodd jeet letee bhiee tin abalaan dhikhai ||11||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਇਸਤਰੀਆਂ ਨੂੰ ਵਿਖਾ ਕੇ ਸ਼ਰਤ ਜਿਤ ਲਈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "होड जीत लेती भई तिन अबलान दिखाइ ॥११॥",
      "sourceLineId": "123931",
      "sourceShabadId": "11567",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਨਬਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੯੦॥੩੬੦੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau nabavo charitr samaapatam sat subham sat ||190||3600||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੯੦ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੯੦॥੩੬੦੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ नबवो चरित्र समापतम सतु सुभम सतु ॥१९०॥३६००॥अफजूँ॥",
      "sourceLineId": "123932",
      "sourceShabadId": "11567",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123933",
      "sourceShabadId": "11568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਏਕ ਲਹੌਰ ਛਤ੍ਰਿਜਾ ਰਹੈ ॥",
      "transliteration": "ek lahauar chhatirajaa rahai ||",
      "translation": "",
      "punjabiViakhya": "ਲਾਹੌਰ ਵਿਚ ਇਕ ਛਤ੍ਰੀ-ਪੁੱਤਰੀ ਰਹਿੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "एक लहौर छतृजा रहै ॥",
      "sourceLineId": "123934",
      "sourceShabadId": "11568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਾਇ ਪ੍ਰਬੀਨ ਤਾਹਿ ਜਗ ਕਹੈ ॥",
      "transliteration": "rai prabeen taeh jag kahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸਾਰੇ ਪ੍ਰਬੀਨ ਰਾਇ ਆਖਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "राइ प्रबीन ताहि जग कहै ॥",
      "sourceLineId": "123935",
      "sourceShabadId": "11568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਪ੍ਰਮਾਨ ਤਿਹ ਪ੍ਰਭਾ ਬਿਰਾਜੈ ॥",
      "transliteration": "apramaan teh prabhaa biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਬੇਹਿਸਾਬੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "अप्रमान तिह प्रभा बिराजै ॥",
      "sourceLineId": "123936",
      "sourceShabadId": "11568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੇਵ ਜਨਨਿ ਕੋ ਲਖਿ ਮਨੁ ਲਾਜੈ ॥੧॥",
      "transliteration": "dhev janan ko lakh man laajai ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਦੇਵਤਿਆਂ ਦੀਆਂ ਮਾਵਾ ਵੀ ਮਨ ਵਿਚ ਲਜਿਤ ਹੁੰਦੀਆਂ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "देव जननि को लखि मनु लाजै ॥१॥",
      "sourceLineId": "123937",
      "sourceShabadId": "11568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123938",
      "sourceShabadId": "11569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਏਕ ਮੁਗਲ ਤਿਹ ਨ੍ਰਹਾਤ ਕੈ ਰੀਝ੍ਯੋ ਅੰਗ ਨਿਹਾਰਿ ॥",
      "transliteration": "ek mugal teh nrahaat kai reejhayo a(n)g nihaar ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਮੁਗ਼ਲ ਉਸ ਦਾ ਨਹਾਣ ਵੇਲੇ ਸ਼ਰੀਰ ਵੇਖ ਕੇ ਮੋਹਿਤ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "एक मुगल तिह न्रहात कै रीझ्यो अंग निहारि ॥",
      "sourceLineId": "123939",
      "sourceShabadId": "11569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗਿਰਿਯੋ ਮੂਰਛਨਾ ਹ੍ਵੈ ਧਰਨਿ ਬਿਰਹਾ ਤਨ ਗਯੋ ਮਾਰਿ ॥੨॥",
      "transliteration": "giriyo moorachhanaa havai dharan birahaa tan gayo maar ||2||",
      "translation": "",
      "punjabiViakhya": "ਬਿਰਹੋਂ (ਦਾ ਬਾਣ) ਵਜਣ ਕਾਰਨ (ਉਹ) ਮੂਰਛਿਤ ਹੋ ਕੇ ਧਰਤੀ ਉਤੇ ਡਿਗ ਪਿਆ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "गिरियो मूरछना ह्वै धरनि बिरहा तन गयो मारि ॥२॥",
      "sourceLineId": "123940",
      "sourceShabadId": "11569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123941",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਧਾਮ ਆਨ ਇਕ ਸਖੀ ਬੁਲਾਈ ॥",
      "transliteration": "dhaam aan ik sakhee bulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਘਰ ਆ ਕੇ ਇਕ ਦਾਸੀ ('ਸਖੀ') ਬੁਲਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "धाम आन इक सखी बुलाई ॥",
      "sourceLineId": "123942",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਾਤ ਸਭੈ ਤਿਹ ਤੀਰ ਜਤਾਈ ॥",
      "transliteration": "baat sabhai teh teer jataiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਸਾਰੀ ਗੱਲ ਦਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "बात सभै तिह तीर जताई ॥",
      "sourceLineId": "123943",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜੌ ਮੋ ਕੌ ਤੂ ਤਾਹਿ ਮਿਲਾਵੈ ॥",
      "transliteration": "jau mo kau too taeh milaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੂੰ ਮੈਨੂੰ ਉਸ ਨਾਲ ਮਿਲਾ ਦੇਵੇਾਂ",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "जौ मो कौ तू ताहि मिलावै ॥",
      "sourceLineId": "123944",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਪੁਨੇ ਮੁਖ ਮਾਗੈ ਸੋ ਪਾਵੈ ॥੩॥",
      "transliteration": "apune mukh maagai so paavai ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਆਪਣੇ ਮੂੰਹ ਮੰਗਿਆ (ਇਨਾਮ) ਪ੍ਰਾਪਤ ਕਰੇਾਂ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "अपुने मुख मागै सो पावै ॥३॥",
      "sourceLineId": "123945",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਬ ਸੋ ਸਖੀ ਧਾਮ ਤਿਹ ਗਈ ॥",
      "transliteration": "tab so sakhee dhaam teh giee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਹ ਦਾਸੀ ਉਸ ਦੇ ਘਰ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "तब सो सखी धाम तिह गई ॥",
      "sourceLineId": "123946",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਐਸੋ ਬਚਨ ਬਖਾਨਤ ਭਈ ॥",
      "transliteration": "aaiso bachan bakhaanat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਤਰ੍ਰਹਾ ਗੱਲ ਕਰਨ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "ऐसो बचन बखानत भई ॥",
      "sourceLineId": "123947",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਾਤਾ ਤੋਰਿ ਬੁਲਾਵਤ ਤੋ ਕੌ ॥",
      "transliteration": "maataa tor bulaavat to kau ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਰੀ ਮਾ ਤੈਨੂੰ ਬੁਲਾਉਾਂਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "माता तोरि बुलावत तो कौ ॥",
      "sourceLineId": "123948",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਾ ਤੇ ਪਠੈ ਦਯੋ ਹ੍ਯਾਂ ਮੋ ਕੌ ॥੪॥",
      "transliteration": "taa te paThai dhayo hayaa(n) mo kau ||4||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਮੈਨੂੰ ਇਥੇ ਭੇਜਿਆ ਹੈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "ता ते पठै दयो ह्याँ मो कौ ॥४॥",
      "sourceLineId": "123949",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਯੌ ਜਬ ਬਚਨ ਤਾਹਿ ਤਿਹ ਕਹਿਯੋ ॥",
      "transliteration": "yau jab bachan taeh teh kahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਨੇ ਉਸ ਨੂੰ ਇਹ ਗੱਲ ਕਹੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "यौ जब बचन ताहि तिह कहियो ॥",
      "sourceLineId": "123950",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਿਲਬ ਸੁਤਾ ਮਾਤਾ ਸੌ ਚਹਿਯੋ ॥",
      "transliteration": "milab sutaa maataa sau chahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਪੁੱਤਰੀ ਨੇ ਵੀ ਮਾ ਨੂੰ ਮਿਲਣਾ ਚਾਹਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "मिलब सुता माता सौ चहियो ॥",
      "sourceLineId": "123951",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਡੋਰੀ ਬਿਖੈ ਤਾਹਿ ਬੈਠਾਰਿਯੋ ॥",
      "transliteration": "ddoree bikhai taeh baiThaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸੁਖਪਾਲ ਵਿਚ ਬਿਠਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "डोरी बिखै ताहि बैठारियो ॥",
      "sourceLineId": "123952",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦਰ ਪਰਦਨ ਦ੍ਰਿੜ ਐਚਿ ਸਵਾਰਿਯੋ ॥੫॥",
      "transliteration": "dhar paradhan dhiraR aaich savaariyo ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦਰਵਾਜ਼ੇ ਦੇ ਪਰਦਿਆਂ ਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਕਸ ਕੇ ਬੰਨ੍ਰਹ ਦਿੱਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "दर परदन दृड़ ऐचि सवारियो ॥५॥",
      "sourceLineId": "123953",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਾ ਕੌ ਦ੍ਰਿਸਟਿ ਕਛੂ ਨਹਿ ਆਵੈ ॥",
      "transliteration": "taa kau dhirasaT kachhoo neh aavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਕੁਝ ਵੀ ਨਜ਼ਰ ਨਹੀਂ ਆ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "ता कौ दृसटि कछू नहि आवै ॥",
      "sourceLineId": "123954",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕੁਟਨੀ ਚਹੈ ਜਹਾ ਲੈ ਜਾਵੈ ॥",
      "transliteration": "kuTanee chahai jahaa lai jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਫਫੇਕੁਟਣੀ ਭਾਵੇਾਂ ਉਸ ਨੂੰ ਜਿਥੇ ਚਾਹੇ ਲੈ ਜਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "कुटनी चहै जहा लै जावै ॥",
      "sourceLineId": "123955",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮਾਤ ਨਾਮ ਲੈ ਤਾਹਿ ਸਿਧਾਈ ॥",
      "transliteration": "maat naam lai taeh sidhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਮਾ ਦਾ ਨਾ ਲੈ ਕੇ ਉਸ ਨੂੰ ਲੈ ਚਲੀ",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "मात नाम लै ताहि सिधाई ॥",
      "sourceLineId": "123956",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਲੈ ਕੈ ਧਾਮ ਮੁਗਲ ਕੇ ਆਈ ॥੬॥",
      "transliteration": "lai kai dhaam mugal ke aaiee ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲੈ ਕੇ ਮੁਗ਼ਲ ਦੇ ਘਰ ਆ ਗਈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "लै कै धाम मुगल के आई ॥६॥",
      "sourceLineId": "123957",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪਰਦਾ ਤਹੀ ਉਘਾਰਾ ਜਾਈ ॥",
      "transliteration": "paradhaa tahee ughaaraa jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਜਾ ਕੇ ਪਰਦਾ ਚੁਕਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "परदा तही उघारा जाई ॥",
      "sourceLineId": "123958",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਾਸ ਬੇਗ ਜਹ ਸੇਜ ਸੁਹਾਈ ॥",
      "transliteration": "taas beg jeh sej suhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਤਾਸ ਬੇਗ ਸੇਜ ਉਤੇ ਡਟਿਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "तास बेग जह सेज सुहाई ॥",
      "sourceLineId": "123959",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਹਿਯਾ ਆਨਿ ਮੁਗਲ ਤਬ ਗਹੀ ॥",
      "transliteration": "bahiyaa aan mugal tab gahee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਮੁਗ਼ਲ ਨੇ ਆ ਕੇ (ਉਸ ਦੀ) ਬਾਹ ਪਕੜ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "बहिया आनि मुगल तब गही ॥",
      "sourceLineId": "123960",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚਿਤ ਮੈ ਚਕ੍ਰਿਤ ਚੰਚਲਾ ਰਹੀ ॥੭॥",
      "transliteration": "chit mai chakirat cha(n)chalaa rahee ||7||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਸਤਰੀ ਮਨ ਵਿਚ ਹੈਰਾਨ ਰਹਿ ਗਈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "चित मै चकृत चंचला रही ॥७॥",
      "sourceLineId": "123961",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮੇਰੇ ਧਰਮ ਲੋਪ ਅਬ ਭਯੋ ॥",
      "transliteration": "mere dharam lop ab bhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਸੋਚਣ ਲਗੀ ਕਿ) ਤੁਰਕ ਨੇ ਆਪਣੇ ਸ਼ਰੀਰ ਨਾਲ ਮੇਰਾ ਸ਼ਰੀਰ ਛੋਹ ਲਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "मेरे धरम लोप अब भयो ॥",
      "sourceLineId": "123962",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤੁਰਕ ਅੰਗ ਸੌ ਅੰਗ ਭਿਟਯੋ ॥",
      "transliteration": "turak a(n)g sau a(n)g bhiTayo ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਲਈ) ਹੁਣ ਮੇਰਾ ਧਰਮ ਭ੍ਰਸ਼ਟ ਹੋ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "तुरक अंग सौ अंग भिटयो ॥",
      "sourceLineId": "123963",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਾ ਤੇ ਕਛੂ ਚਰਿਤ੍ਰ ਬਨਾਊ ॥",
      "transliteration": "taa te kachhoo charitr banaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਕਰ ਕੇ ਕੋਈ ਚਰਿਤ੍ਰ ਖੇਡਾ",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "ता ते कछू चरित्र बनाऊ ॥",
      "sourceLineId": "123964",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਾ ਤੇ ਛੂਟਿ ਮੁਗਲ ਤੇ ਜਾਊ ॥੮॥",
      "transliteration": "jaa te chhooT mugal te jaauoo ||8||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਮੁਗ਼ਲ (ਦੇ ਸ਼ਿਕੰਜੇ ਤੋਂ) ਖ਼ਲਾਸ ਹੋ ਜਾਵਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "जा ते छूटि मुगल ते जाऊ ॥८॥",
      "sourceLineId": "123965",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਬ ਆਇਸੁ ਤੁਮਰੋ ਜੌ ਪਾਊ ॥",
      "transliteration": "ab aais tumaro jau paauoo ||",
      "translation": "",
      "punjabiViakhya": "(ਮੁਗ਼ਲ ਨੂੰ ਸੰਬੋਧਿਤ ਹੋ ਕੇ ਕਹਿਣ ਲਗੀ) ਜੇ ਹੁਣ ਤੁਹਾਡੀ ਆਗਿਆ ਹੋਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "अब आइसु तुमरो जौ पाऊ ॥",
      "sourceLineId": "123966",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਭ ਸੁੰਦਰ ਸਿੰਗਾਰ ਬਨਾਊ ॥",
      "transliteration": "sabh su(n)dhar si(n)gaar banaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮੈਂ ਸਭ ਤਰ੍ਰਹਾ ਦੇ ਸੁੰਦਰ ਸ਼ਿੰਗਾਰ ਕਰ ਲਵਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "सभ सुँदर सिंगार बनाऊ ॥",
      "sourceLineId": "123967",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬਹੁਰਿ ਆਇ ਤੁਮ ਸਾਥ ਬਿਹਾਰੋ ॥",
      "transliteration": "bahur aai tum saath bihaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਆ ਕੇ ਤੁਹਾਡੇ ਨਾਲ ਰਮਣ ਕਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "बहुरि आइ तुम साथ बिहारो ॥",
      "sourceLineId": "123968",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤੁਮਰੋ ਚਿਤ ਕੋ ਸੋਕ ਨਿਵਾਰੋ ॥੯॥",
      "transliteration": "tumaro chit ko sok nivaaro ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੁਹਾਡੇ ਚਿਤ ਦੇ ਦੁਖ ਨੂੰ ਦੂਰ ਕਰ ਦਿਆਂ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "तुमरो चित को सोक निवारो ॥९॥",
      "sourceLineId": "123969",
      "sourceShabadId": "11570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123970",
      "sourceShabadId": "11571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਹਾਰ ਸਿੰਗਾਰ ਬਨਾਇ ਕੈ ਕੇਲ ਕਰੌ ਤਵ ਸੰਗ ॥",
      "transliteration": "haar si(n)gaar banai kai kel karau tav sa(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਰ ਸ਼ਿੰਗਾਰ ਕਰ ਕੇ ਤੁਹਾਡੇ ਨਾਲ ਕੇਲ ਕਰਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "हार सिंगार बनाइ कै केल करौ तव संग ॥",
      "sourceLineId": "123971",
      "sourceShabadId": "11571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਬਹੁਰਿ ਤਿਹਾਰੇ ਗ੍ਰਿਹ ਬਸੌ ਹ੍ਵੈ ਤੁਮ ਤ੍ਰਿਯ ਅਰਧੰਗ ॥੧੦॥",
      "transliteration": "bahur tihaare gireh basau havai tum tiray aradha(n)g ||10||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਤੁਹਾਡੇ ਘਰ ਤੁਹਾਡੀ ਅਰਧੰਗਨੀ ਬਣ ਕੇ ਵਸਾਗੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "बहुरि तिहारे गृह बसौ ह्वै तुम तृय अरधंग ॥१०॥",
      "sourceLineId": "123972",
      "sourceShabadId": "11571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123973",
      "sourceShabadId": "11572",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਯੌ ਕਹਿ ਬਚਨ ਤਹਾ ਤੇ ਗਈ ॥",
      "transliteration": "yau keh bachan tahaa te giee ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਕਹਿ ਕੇ (ਉਹ) ਉਥੋਂ ਚਲੀ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "यौ कहि बचन तहा ते गई ॥",
      "sourceLineId": "123974",
      "sourceShabadId": "11572",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗ੍ਰਿਹ ਕੌ ਆਗਿ ਲਗਾਵਤ ਭਈ ॥",
      "transliteration": "gireh kau aag lagaavat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘਰ ਨੂੰ (ਬਾਹਰੋਂ) ਅੱਗ ਲਗਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "गृह कौ आगि लगावत भई ॥",
      "sourceLineId": "123975",
      "sourceShabadId": "11572",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕੁਟਨੀ ਸਹਿਤ ਮੁਗਲ ਕੌ ਜਾਰਿਯੋ ॥",
      "transliteration": "kuTanee sahit mugal kau jaariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਫਫੇਕੁਟਣੀ ਸਮੇਤ ਮੁਗ਼ਲ ਨੂੰ ਸਾੜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "कुटनी सहित मुगल कौ जारियो ॥",
      "sourceLineId": "123976",
      "sourceShabadId": "11572",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਬਾਲ ਆਪਨੋ ਧਰਮ ਉਬਾਰਿਯੋ ॥੧੧॥",
      "transliteration": "baal aapano dharam ubaariyo ||11||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਆਪਣੇ ਧਰਮ ਨੂੰ ਬਚਾ ਲਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "बाल आपनो धरम उबारियो ॥११॥",
      "sourceLineId": "123977",
      "sourceShabadId": "11572",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਇਕਯਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੯੧॥੩੬੧੧॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau ikayaanavo charitr samaapatam sat subham sat ||191||3611||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੯੧ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੯੧॥੩੬੧੧॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ इकयानवो चरित्र समापतम सतु सुभम सतु ॥१९१॥३६११॥अफजूँ॥",
      "sourceLineId": "123978",
      "sourceShabadId": "11572",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "123979",
      "sourceShabadId": "11573",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਤੇਜ ਸਿੰਘ ਰਾਜਾ ਬਡੋ ਅਪ੍ਰਮਾਨ ਜਿਹ ਰੂਪ ॥",
      "transliteration": "tej si(n)gh raajaa baddo apramaan jeh roop ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਜ ਸਿੰਘ ਨਾ ਦਾ ਇਕ ਵੱਡਾ ਰਾਜਾ ਸੀ ਜਿਸ ਦਾ ਰੂਪ ਅਤਿ ਸੁੰਦਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "तेज सिंघ राजा बडो अप्रमान जिह रूप ॥",
      "sourceLineId": "123980",
      "sourceShabadId": "11573",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਗਾਨ ਕਲਾ ਤਾ ਕੀ ਸਖੀ ਰਤਿ ਕੇ ਰਹੈ ਸਰੂਪ ॥੧॥",
      "transliteration": "gaan kalaa taa kee sakhee rat ke rahai saroop ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਗਾਨ ਕਲਾ ਨਾ ਦੀ ਇਕ ਦਾਸੀ ਸੀ ਜੋ ਰਤੀ (ਕਾਮ ਦੇਵ ਦੀ ਪਤਨੀ) ਵਾਗ ਸੁੰਦਰ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "गान कला ता की सखी रति के रहै सरूप ॥१॥",
      "sourceLineId": "123981",
      "sourceShabadId": "11573",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "123982",
      "sourceShabadId": "11574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਰਾਜਾ ਕੋ ਤਾ ਸੌ ਹਿਤ ਭਾਰੋ ॥",
      "transliteration": "raajaa ko taa sau hit bhaaro ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦਾ ਉਸ ਨਾਲ ਬਹੁਤ ਪ੍ਰੇਮ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "राजा को ता सौ हित भारो ॥",
      "sourceLineId": "123983",
      "sourceShabadId": "11574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਦਾਸੀ ਤੇ ਰਾਨੀ ਕਰਿ ਡਾਰੋ ॥",
      "transliteration": "dhaasee te raanee kar ddaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਕਰ ਕੇ ਉਸ ਨੂੰ) ਦਾਸੀ ਤੋਂ ਰਾਣੀ ਬਣਾ ਦਿੱਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "दासी ते रानी करि डारो ॥",
      "sourceLineId": "123984",
      "sourceShabadId": "11574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਜੈਸੇ ਕਰੈ ਰਸਾਇਨ ਕੋਈ ॥",
      "transliteration": "jaise karai rasain koiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕੋਈ ਕਿਸੇ ਰਸਾਇਣ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "जैसे करै रसाइन कोई ॥",
      "sourceLineId": "123985",
      "sourceShabadId": "11574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਤਾਬੈ ਸੌ ਸੋਨਾ ਸੋ ਹੋਈ ॥੨॥",
      "transliteration": "taabai sau sonaa so hoiee ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਾਬੇ ਨੂੰ ਸੋਨਾ ਬਣਾ ਦਿੰਦਾ ਹੈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "ताबै सौ सोना सो होई ॥२॥",
      "sourceLineId": "123986",
      "sourceShabadId": "11574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "123987",
      "sourceShabadId": "11575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਰੈਨਿ ਦਿਨਾ ਤਿਹ ਧਾਮ ਰਾਵ ਜੂ ਆਵਈ ॥",
      "transliteration": "rain dhinaa teh dhaam raav joo aaviee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਦਿਨ ਰਾਜਾ ਉਸ ਦੇ ਘਰ ਆਉਾਂਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "रैनि दिना तिह धाम राव जू आवई ॥",
      "sourceLineId": "123988",
      "sourceShabadId": "11575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਕਾਮ ਕੇਲ ਨਿਸ ਦਿਨ ਤਿਸ ਸੰਗ ਕਮਾਵਈ ॥",
      "transliteration": "kaam kel nis dhin tis sa(n)g kamaaviee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦਿਨ ਰਾਤ ਉਸ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "काम केल निस दिन तिस संग कमावई ॥",
      "sourceLineId": "123989",
      "sourceShabadId": "11575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਦਾਸ ਏਕ ਪਰ ਸੋ ਦਾਸੀ ਅਟਕਤਿ ਭਈ ॥",
      "transliteration": "dhaas ek par so dhaasee aTakat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਾਸ ਨਾਲ ਉਹ ਦਾਸੀ ਅਟਕ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "दास एक पर सो दासी अटकति भई ॥",
      "sourceLineId": "123990",
      "sourceShabadId": "11575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਹੋ ਪਤਿ ਕੀ ਪ੍ਰੀਤਿ ਬਿਸਾਰਿ ਤਬੈ ਚਿਤ ਤੇ ਦਈ ॥੩॥",
      "transliteration": "ho pat kee preet bisaar tabai chit te dhiee ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਤੀ (ਰਾਜੇ) ਦੀ ਪ੍ਰੀਤ ਨੂੰ ਤਦ ਦਿਲੋਂ ਭੁਲਾ ਦਿੱਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "हो पति की प्रीति बिसारि तबै चित ते दई ॥३॥",
      "sourceLineId": "123991",
      "sourceShabadId": "11575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਤਿਲ ਚੁਗਨਾ ਪਰ ਗਾਨ ਕਲਾ ਅਟਕਤ ਭਈ ॥",
      "transliteration": "til chuganaa par gaan kalaa aTakat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਿਲ ਚੁਗਨਾ (ਨਾ ਦੇ ਦਾਸ ਉਤੇ) ਗਾਨ ਕਲਾ ਮੋਹਿਤ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "तिल चुगना पर गान कला अटकत भई ॥",
      "sourceLineId": "123992",
      "sourceShabadId": "11575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਨ੍ਰਿਪ ਕੀ ਪ੍ਰੀਤਿ ਬਿਸਾਰਿ ਤੁਰਤ ਚਿਤ ਤੇ ਦਈ ॥",
      "transliteration": "nirap kee preet bisaar turat chit te dhiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਰਾਜੇ ਦੀ ਪ੍ਰੀਤ ਤੁਰਤ ਦਿਲੋਂ ਭੁਲਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "नृप की प्रीति बिसारि तुरत चित ते दई ॥",
      "sourceLineId": "123993",
      "sourceShabadId": "11575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1076_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਜੋ ਦਾਸੀ ਸੌ ਪ੍ਰੇਮ ਪੁਰਖੁ ਕੋਊ ਠਾਨਈ ॥",
      "transliteration": "jo dhaasee sau prem purakh kouoo Thaaniee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਕੋਈ ਮਰਦ ਦਾਸੀ ਨਾਲ ਪ੍ਰੇਮ ਪਾ ਲੈਂਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1076,
      "hindi": "",
      "hindiTransliteration": "जो दासी सौ प्रेम पुरखु कोऊ ठानई ॥",
      "sourceLineId": "123994",
      "sourceShabadId": "11575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
