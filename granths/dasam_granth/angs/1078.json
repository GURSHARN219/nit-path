{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1078,
  "lineCount": 49,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1078_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦਾਸਨਿ ਕੈ ਸੰਗ ਦੋਸਤੀ ਮਤਿ ਕਰਿਯਹੁ ਮਤਿਹੀਨ ॥੧੭॥",
      "transliteration": "dhaasan kai sa(n)g dhosatee mat kariyahu matiheen ||17||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਹੇ ਮਤਹੀਨੋ! ਦਾਸਾ ਨਾਲ ਦੋਸਤੀ ਨਾ ਕਰੋ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "दासनि कै संग दोसती मति करियहु मतिहीन ॥१७॥",
      "sourceLineId": "124043",
      "sourceShabadId": "11577",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਬਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੯੨॥੩੬੨੮॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau baanavo charitr samaapatam sat subham sat ||192||3628||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੯੨ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੯੨॥੩੬੨੮॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ बानवो चरित्र समापतम सतु सुभम सतु ॥१९२॥३६२८॥अफजूँ॥",
      "sourceLineId": "124044",
      "sourceShabadId": "11577",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "124045",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਿਰਦਸਿ ਕਲਾ ਏਕ ਬਰ ਨਾਰੀ ॥",
      "transliteration": "tiradhas kalaa ek bar naaree ||",
      "translation": "",
      "punjabiViakhya": "ਤਿਰਦਸ ਕਲਾ ਨਾ ਦੀ ਇਕ ਉਤਮ ਇਸਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "तिरदसि कला एक बर नारी ॥",
      "sourceLineId": "124046",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚੋਰਨ ਕੀ ਅਤਿ ਹੀ ਹਿਤਕਾਰੀ ॥",
      "transliteration": "choran kee at hee hitakaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਚੋਰਾ ਦੀ ਬਹੁਤ ਹਿਤਕਾਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "चोरन की अति ही हितकारी ॥",
      "sourceLineId": "124047",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਹਾ ਕਿਸੂ ਕਾ ਦਰਬੁ ਤਕਾਵੈ ॥",
      "transliteration": "jahaa kisoo kaa dharab takaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਿਸੇ ਦਾ ਧਨ ਵੇਖਦੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "जहा किसू का दरबु तकावै ॥",
      "sourceLineId": "124048",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹੀਂਗ ਲਗਾਇ ਤਹਾ ਉਠਿ ਆਵੈ ॥੧॥",
      "transliteration": "hee(n)g lagai tahaa uTh aavai ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਹਿੰਗ ਲਗਾ ਕੇ ਆ ਜਾਦੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "हींग लगाइ तहा उठि आवै ॥१॥",
      "sourceLineId": "124049",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹੀਂਗ ਬਾਸ ਤਸਕਰ ਜਹ ਪਾਵੈ ॥",
      "transliteration": "hee(n)g baas tasakar jeh paavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਹਿੰਗ ਦੀ ਵਾਸਨਾ ਚੋਰਾ ਨੂੰ ਮਿਲਦੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "हींग बास तसकर जह पावै ॥",
      "sourceLineId": "124050",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਿਸੀ ਠੌਰ ਕਹ ਸਾਧਿ ਲਗਾਵੈ ॥",
      "transliteration": "tisee Thauar keh saadh lagaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਆ ਕੇ ਸੰਨ੍ਰਹ ਲਗਾ ਲੈਂਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "तिसी ठौर कह साधि लगावै ॥",
      "sourceLineId": "124051",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਿਹ ਠਾ ਰਹੈ ਸਾਹੁ ਇਕ ਭਾਰੀ ॥",
      "transliteration": "teh Thaa rahai saahu ik bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਬਹੁਤ ਵੱਡਾ ਸ਼ਾਹ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "तिह ठा रहै साहु इक भारी ॥",
      "sourceLineId": "124052",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤ੍ਰਿਦਸਿ ਕਲਾ ਤਾਹੂ ਸੋ ਬਿਹਾਰੀ ॥੨॥",
      "transliteration": "tiradhas kalaa taahoo so bihaaree ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਿਰਦਸ ਕਲਾ ਉਸ ਨਾਲ ਰਮਣ ਕਰਦੀ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "तृदसि कला ताहू सो बिहारी ॥२॥",
      "sourceLineId": "124053",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹੀਂਗ ਲਗਾਇ ਤ੍ਰਿਯ ਚੋਰ ਲਗਾਏ ॥",
      "transliteration": "hee(n)g lagai tiray chor lagaae ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਸ਼ਾਹ ਦੇ ਘਰ) ਹਿੰਗ ਲਗਾ ਕੇ ਫਿਰ ਚੋਰ ਲਗਾ ਦਿੱਤੇ (ਭਾਵ ਚੋਰਾ ਤੋਂ ਸੰਨ੍ਰਹ ਮਰਵਾ ਦਿੱਤੀ)",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "हींग लगाइ तृय चोर लगाए ॥",
      "sourceLineId": "124054",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਰਤੇ ਕੇਲ ਸਾਹੁ ਚਿਤ ਆਏ ॥",
      "transliteration": "karate kel saahu chit aae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕੇਲ-ਕ੍ਰੀੜਾ ਕਰਦੀ ਨੂੰ ਸ਼ਾਹ ਦਾ ਧਿਆਨ ਆ ਗਿਆ (ਅਰਥਾਤ ਸ਼ਾਹ ਦੀ ਚੋਰੀ ਦਾ ਚੇਤਾ ਆ ਗਿਆ)।",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "करते केल साहु चित आए ॥",
      "sourceLineId": "124055",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਾ ਸੌ ਤੁਰਤ ਖਬਰਿ ਤ੍ਰਿਯ ਕਰੀ ॥",
      "transliteration": "taa sau turat khabar tiray karee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਝਟ ਖ਼ਬਰ ਕਰ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "ता सौ तुरत खबरि तृय करी ॥",
      "sourceLineId": "124056",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮੀਤ ਤਿਹਾਰੀ ਮਾਤ੍ਰਾ ਹਰੀ ॥੩॥",
      "transliteration": "meet tihaaree maatraa haree ||3||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਹੇ ਮਿਤਰ! ਤੇਰਾ ਧਨ ਲੁਟਿਆ ਗਿਆ ਹੈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "मीत तिहारी मात्रा हरी ॥३॥",
      "sourceLineId": "124057",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚੋਰ ਚੋਰ ਤਬ ਸਾਹੁ ਪੁਕਾਰਿਯੋ ॥",
      "transliteration": "chor chor tab saahu pukaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਸ਼ਾਹ ਨੇ 'ਚੋਰ ਚੋਰ' ਕਹਿ ਕੇ ਰੌਲਾ ਪਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "चोर चोर तब साहु पुकारियो ॥",
      "sourceLineId": "124058",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਰਧ ਆਪਨੋ ਦਰਬੁ ਉਚਾਰਿਯੋ ॥",
      "transliteration": "aradh aapano dharab uchaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਅੱਧੇ ਧਨ (ਦੇ ਬਚ ਜਾਣ ਦੀ ਗੱਲ ਵੀ) ਕਹਿ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "अरध आपनो दरबु उचारियो ॥",
      "sourceLineId": "124059",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦੁਹੂੰਅਨ ਤਾਹਿ ਹਿਤੂ ਕਰਿ ਮਾਨ੍ਯੋ ॥",
      "transliteration": "dhuhoo(n)an taeh hitoo kar maanayo ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੇ ਉਸ (ਇਸਤਰੀ) ਨੂੰ ਹਿਤੂ ਕਰ ਕੇ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "दुहूँअन ताहि हितू करि मान्यो ॥",
      "sourceLineId": "124060",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮੂਰਖ ਭੇਦ ਨ ਕਾਹੂ ਜਾਨ੍ਯੋ ॥੪॥",
      "transliteration": "moorakh bhedh na kaahoo jaanayo ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਸੇ ਮੂਰਖ ਨੇ ਭੇਦ ਨੂੰ ਨਹੀਂ ਸਮਝਿਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "मूरख भेद न काहू जान्यो ॥४॥",
      "sourceLineId": "124061",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਰਧ ਬਾਟਿ ਚੋਰਨ ਤਿਹ ਦੀਨੋ ॥",
      "transliteration": "aradh baaT choran teh dheeno ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਧਾ ਧਨ ਉਸ ਨੂੰ ਚੋਰਾ ਨੇ ਵੰਡਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "अरध बाटि चोरन तिह दीनो ॥",
      "sourceLineId": "124062",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਆਧੋ ਦਰਬੁ ਸਾਹੁ ਤੇ ਲੀਨੋ ॥",
      "transliteration": "aadho dharab saahu te leeno ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅੱਧਾ ਧਨ ਸ਼ਾਹ ਤੋਂ ਲੈ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "आधो दरबु साहु ते लीनो ॥",
      "sourceLineId": "124063",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦੁਹੂੰਅਨ ਤਾਹਿ ਲਖਿਯੋ ਹਿਤਕਾਰੀ ॥",
      "transliteration": "dhuhoo(n)an taeh lakhiyo hitakaaree ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੇ ਉਸ ਨੂੰ (ਆਪਣਾ) ਹਿਤਕਾਰੀ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "दुहूँअन ताहि लखियो हितकारी ॥",
      "sourceLineId": "124064",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮੂਰਖ ਕਿਨੂੰ ਨ ਬਾਤ ਬਿਚਾਰੀ ॥੫॥",
      "transliteration": "moorakh kinoo(n) na baat bichaaree ||5||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਮੂਰਖ ਨੇ ਗੱਲ ਨੂੰ ਨਾ ਸਮਝਿਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "मूरख किनूँ न बात बिचारी ॥५॥",
      "sourceLineId": "124065",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚੋਰ ਲਾਇ ਪਾਹਰੂ ਜਗਾਏ ॥",
      "transliteration": "chor lai paaharoo jagaae ||",
      "translation": "",
      "punjabiViakhya": "(ਪਹਿਲਾ ਸ਼ਾਹ ਦੇ ਘਰ) ਚੋਰ ਲਗਾ ਦਿੱਤੇ (ਅਤੇ ਫਿਰ) ਪਹਿਰੇਦਾਰ ਜਗਾ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "चोर लाइ पाहरू जगाए ॥",
      "sourceLineId": "124066",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਤੇ ਦੋਊ ਭੁਲਾਏ ॥",
      "transliteration": "eeh charitr te dhouoo bhulaae ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਚਰਿਤ੍ਰ ਨਾਲ ਦੋਵੇਾਂ ਭਰਮਾ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र ते दोऊ भुलाए ॥",
      "sourceLineId": "124067",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਸਕਰ ਕਹੈ ਹਮਾਰੀ ਨਾਰੀ ॥",
      "transliteration": "tasakar kahai hamaaree naaree ||",
      "translation": "",
      "punjabiViakhya": "ਚੋਰ ਕਹਿੰਦੇ ਸਨ ਕਿ ਇਹ ਸਾਡੀ ਇਸਤਰੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "तसकर कहै हमारी नारी ॥",
      "sourceLineId": "124068",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਾਹੁ ਲਖ੍ਯੋ ਮੋਰੀ ਹਿਤਕਾਰੀ ॥੬॥",
      "transliteration": "saahu lakhayo moree hitakaaree ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਾਹ ਸਮਝਦਾ ਸੀ ਕਿ ਮੇਰੀ ਖੈਰਖ਼੍ਵਾਹ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "साहु लख्यो मोरी हितकारी ॥६॥",
      "sourceLineId": "124069",
      "sourceShabadId": "11578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "124070",
      "sourceShabadId": "11579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਚੰਚਲਾਨ ਕੇ ਚਰਿਤ ਕੌ ਸਕਤ ਨ ਕੋਊ ਪਾਇ ॥",
      "transliteration": "cha(n)chalaan ke charit kau sakat na kouoo pai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀਆਂ ਦੇ ਚਰਿਤ੍ਰ ਨੂੰ ਕੋਈ ਵੀ ਪਾ ਨਹੀਂ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "चंचलान के चरित कौ सकत न कोऊ पाइ ॥",
      "sourceLineId": "124071",
      "sourceShabadId": "11579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਵਹ ਚਰਿਤ੍ਰ ਤਾ ਕੌ ਲਖੈ ਜਾ ਕੇ ਸ੍ਯਾਮ ਸਹਾਇ ॥੭॥",
      "transliteration": "veh charitr taa kau lakhai jaa ke sayaam sahai ||7||",
      "translation": "",
      "punjabiViakhya": "ਉਹੀ ਇਨ੍ਰਹਾ ਦੇ ਚਰਿਤ੍ਰ ਨੂੰ ਸਮਝ ਸਕਦਾ ਹੈ, ਜਿਸ ਦੇ ਪਰਮਾਤਮਾ ਸਹਾਇਕ ਹੋਣ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "वह चरित्र ता कौ लखै जा के स्याम सहाइ ॥७॥",
      "sourceLineId": "124072",
      "sourceShabadId": "11579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਤਿਰਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੯੩॥੩੬੩੫॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau tiraanavo charitr samaapatam sat subham sat ||193||3635||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੯੩ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੯੩॥੩੬੩੫॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ तिरानवो चरित्र समापतम सतु सुभम सतु ॥१९३॥३६३५॥अफजूँ॥",
      "sourceLineId": "124073",
      "sourceShabadId": "11579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "124074",
      "sourceShabadId": "11580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦੇਵਰਾਨ ਹੰਡੂਰ ਕੋ ਰਾਜਾ ਏਕ ਰਹੈ ॥",
      "transliteration": "dhevaraan ha(n)ddoor ko raajaa ek rahai ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਰਾਨ ਨਾ ਦਾ ਹੰਡੂਰ ਦਾ ਇਕ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "देवरान हंडूर को राजा एक रहै ॥",
      "sourceLineId": "124075",
      "sourceShabadId": "11580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਰਾ ਕੋ ਹੋਛਾ ਘਨੋ ਸਭ ਜਗ ਤਾਹਿ ਕਹੈ ॥੧॥",
      "transliteration": "naaraa ko hochhaa ghano sabh jag taeh kahai ||1||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਾ ਜਗਤ ਉਸ ਨੂੰ ਨਾੜੇ ਦਾ ਹੌਲਾ ਸਮਝਦਾ ਸੀ (ਭਾਵ ਕਾਮੀ ਰੁਚੀ ਵਾਲਾ ਹੀ ਸਮਝਦੇ ਸਨ) ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "नारा को होछा घनो सभ जग ताहि कहै ॥१॥",
      "sourceLineId": "124076",
      "sourceShabadId": "11580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਏਕ ਦਿਸਾਰਿਨ ਸੌ ਰਹੈ ਤਾ ਕੀ ਪ੍ਰੀਤਿ ਅਪਾਰ ॥",
      "transliteration": "ek dhisaarin sau rahai taa kee preet apaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਇਕ ਪਰਦੇਸਣ ਨਾਲ ਬਹੁਤ ਪ੍ਰੀਤ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "एक दिसारिन सौ रहै ता की प्रीति अपार ॥",
      "sourceLineId": "124077",
      "sourceShabadId": "11580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਿਨ ਨ ਬੁਲਾਯੋ ਧਾਮ ਕੋ ਆਪੁ ਗਯੋ ਬਿਸੰਭਾਰ ॥੨॥",
      "transliteration": "tin na bulaayo dhaam ko aap gayo bisa(n)bhaar ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਘਰ ਨਾ ਬੁਲਾਇਆ, ਸਗੋਂ ਆਪ ਹੀ ਬੇਸਮਝਾ ਵਾਗ (ਉਸ ਦੇ ਘਰ) ਚਲਾ ਗਿਆ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "तिन न बुलायो धाम को आपु गयो बिसंभार ॥२॥",
      "sourceLineId": "124078",
      "sourceShabadId": "11580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "124079",
      "sourceShabadId": "11581",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਬ ਆਯੋ ਨ੍ਰਿਪ ਧਾਮ ਦਿਸਾਰਿਨਿ ਜਾਨਿਯੋ ॥",
      "transliteration": "jab aayo nirap dhaam dhisaarin jaaniyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਪਰਦੇਸਨ ਨੇ ਰਾਜੇ ਨੂੰ ਘਰ ਆਇਆ ਜਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "जब आयो नृप धाम दिसारिनि जानियो ॥",
      "sourceLineId": "124080",
      "sourceShabadId": "11581",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਿਜੁ ਪਤਿ ਸੌ ਸਭ ਹੀ ਤਿਨ ਭੇਦ ਬਖਾਨਿਯੋ ॥",
      "transliteration": "nij pat sau sabh hee tin bhedh bakhaaniyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਆਪਣੇ ਪਤੀ ਨੂੰ ਸਾਰਾ ਭੇਦ ਦਸ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "निजु पति सौ सभ ही तिन भेद बखानियो ॥",
      "sourceLineId": "124081",
      "sourceShabadId": "11581",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਖਾਤ ਬਿਖੈ ਰਾਜਾ ਕੋ ਗਹਿ ਤਿਨ ਡਾਰਿਯੋ ॥",
      "transliteration": "khaat bikhai raajaa ko geh tin ddaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਰਾਜੇ ਨੂੰ ਫੜ ਕੇ ਟੋਏ ਵਿਚ ਸੁਟ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "खात बिखै राजा को गहि तिन डारियो ॥",
      "sourceLineId": "124082",
      "sourceShabadId": "11581",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹੋ ਪਕਰਿ ਪਾਨਹੀ ਹਾਥ ਬਹੁਤ ਬਿਧਿ ਮਾਰਿਯੋ ॥੩॥",
      "transliteration": "ho pakar paanahee haath bahut bidh maariyo ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੱਥ ਵਿਚ ਜੁਤੀ ਪਕੜ ਕੇ ਚੰਗੀ ਤਰ੍ਰਹਾ ਮਾਰਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "हो पकरि पानही हाथ बहुत बिधि मारियो ॥३॥",
      "sourceLineId": "124083",
      "sourceShabadId": "11581",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪ੍ਰਥਮ ਕੇਲ ਕਰਿ ਨ੍ਰਿਪ ਕੌ ਧਾਮ ਬੁਲਾਇਯੋ ॥",
      "transliteration": "pratham kel kar nirap kau dhaam bulaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਰਾਜੇ ਨਾਲ ਘਰ ਬੁਲਾ ਕੇ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "प्रथम केल करि नृप कौ धाम बुलाइयो ॥",
      "sourceLineId": "124084",
      "sourceShabadId": "11581",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਨੀ ਨ ਤਾ ਸੌ ਪਤਿ ਸੋ ਭੇਦ ਜਤਾਇਯੋ ॥",
      "transliteration": "banee na taa sau pat so bhedh jataiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ (ਕਿਸੇ ਗੱਲੋਂ) ਨਾ ਬਣੀ ਤਾ ਪਤੀ ਨੂੰ ਭੇਦ ਦਸ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "बनी न ता सौ पति सो भेद जताइयो ॥",
      "sourceLineId": "124085",
      "sourceShabadId": "11581",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪਨਿਨ ਮਾਰਿ ਖਤ ਡਾਰ ਉਪਰ ਕਾਟਾ ਦਏ ॥",
      "transliteration": "panin maar khat ddaar upar kaaTaa dhe ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਜੁਤੀਆਂ ਨਾਲ ਮਾਰ ਕੇ ਅਤੇ ਟੋਟੇ ਵਿਚ ਸੁਟ ਕੇ ਉਪਰ ਕੰਡੇ (ਕੰਡਿਆਂ ਵਾਲੇ ਛਾਪੇ) ਰਖ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "पनिन मारि खत डार उपर काटा दए ॥",
      "sourceLineId": "124086",
      "sourceShabadId": "11581",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹੋ ਚਿਤ ਮੌ ਤ੍ਰਾਸ ਬਿਚਾਰਿ ਪੁਰਖੁ ਤ੍ਰਿਯ ਭਜਿ ਗਏ ॥੪॥",
      "transliteration": "ho chit mau traas bichaar purakh tiray bhaj ge ||4||",
      "translation": "",
      "punjabiViakhya": "ਮਨ ਵਿਚ ਡਰੇ ਹੋਏ ਮਰਦ ਅਤੇ ਇਸਤਰੀ (ਦੋਵੇਾਂ) ਭਜ ਗਏ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
      "hindiTransliteration": "हो चित मौ त्रास बिचारि पुरखु तृय भजि गए ॥४॥",
      "sourceLineId": "124087",
      "sourceShabadId": "11581",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1078_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1078,
      "hindi": "",
