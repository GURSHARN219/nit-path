{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1079,
  "lineCount": 47,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1079_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਹ ਤੇ ਕਾਢਿ ਧਾਮ ਲੈ ਆਏ ॥੫॥",
      "transliteration": "teh te kaadd dhaam lai aae ||5||",
      "translation": "",
      "punjabiViakhya": "ਉਥੋਂ ਕਢ ਕੇ ਘਰ ਲੈ ਆਏ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "तह ते काढि धाम लै आए ॥५॥",
      "sourceLineId": "124092",
      "sourceShabadId": "11582",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਚੁਰਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੯੪॥੩੬੪੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau churaanavo charitr samaapatam sat subham sat ||194||3640||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੯੪ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੯੪॥੩੬੪੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ चुरानवो चरित्र समापतम सतु सुभम सतु ॥१९४॥३६४०॥अफजूँ॥",
      "sourceLineId": "124093",
      "sourceShabadId": "11582",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "124094",
      "sourceShabadId": "11583",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨੌਕੋਟੀ ਮਰਵਾਰ ਕੇ ਜਸਵੰਤ ਸਿੰਘ ਨਰੇਸ ॥",
      "transliteration": "nauakoTee maravaar ke jasava(n)t si(n)gh nares ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਰਵਾਰ ਨੌਕੋਟੀ ਦਾ ਜਸਵੰਤ ਸਿੰਘ ਨਾ ਦਾ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "नौकोटी मरवार के जसवंत सिंघ नरेस ॥",
      "sourceLineId": "124095",
      "sourceShabadId": "11583",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਾ ਕੀ ਮਾਨਤ ਆਨਿ ਸਭ ਰਘੁਬੰਸੀਸ੍ਵਰ ਦੇਸ ॥੧॥",
      "transliteration": "jaa kee maanat aan sabh raghuba(n)seesavair dhes ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਸਾਰੇ ਰਘੂਵੰਸ਼ੀ ਰਾਜੇ ਅਧੀਨਗੀ ਸਵੀਕਾਰ ਕਰਦੇ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "जा की मानत आनि सभ रघुबंसीस्वर देस ॥१॥",
      "sourceLineId": "124096",
      "sourceShabadId": "11583",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "124097",
      "sourceShabadId": "11584",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਾਨਮਤੀ ਤਿਹ ਕੀ ਬਰ ਨਾਰੀ ॥",
      "transliteration": "maanamatee teh kee bar naaree ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨਵਤੀ ਉਸ ਦੀ ਸੁੰਦਰ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "मानमती तिह की बर नारी ॥",
      "sourceLineId": "124098",
      "sourceShabadId": "11584",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਨੁਕ ਚੀਰ ਚੰਦ੍ਰਮਾ ਨਿਕਾਰੀ ॥",
      "transliteration": "januk cheer cha(n)dhramaa nikaaree ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਚੰਦ੍ਰਮਾ ਨੂੰ ਚੀਰ ਕੇ ਕਢੀ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "जनुक चीर चंद्रमा निकारी ॥",
      "sourceLineId": "124099",
      "sourceShabadId": "11584",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਿਤਨ ਪ੍ਰਭਾ ਦੂਜੀ ਤਿਹ ਰਾਨੀ ॥",
      "transliteration": "bitan prabhaa dhoojee teh raanee ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਤਨ ਪ੍ਰਭਾ ਨਾ ਦੀ ਉਸ ਦੀ ਦੂਜੀ ਰਾਣੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "बितन प्रभा दूजी तिह रानी ॥",
      "sourceLineId": "124100",
      "sourceShabadId": "11584",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਾ ਸਮ ਲਖੀ ਨ ਕਿਨੂੰ ਬਖਾਨੀ ॥੨॥",
      "transliteration": "jaa sam lakhee na kinoo(n) bakhaanee ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਹੋਰ ਕੋਈ ਨਾ ਵੇਖੀ ਗਈ ਸੀ, ਨਾ ਸੁਣੀ ਗਈ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "जा सम लखी न किनूँ बखानी ॥२॥",
      "sourceLineId": "124101",
      "sourceShabadId": "11584",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਾਬਲ ਦਰੋ ਬੰਦ ਜਬ ਭਯੋ ॥",
      "transliteration": "kaabal dharo ba(n)dh jab bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਕਾਬਲ ਦਾ ਦਰਾ (ਵੈਰੀਆਂ ਨੇ) ਬੰਦ ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "काबल दरो बंद जब भयो ॥",
      "sourceLineId": "124102",
      "sourceShabadId": "11584",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਲਿਖਿ ਐਸੇ ਖਾ ਮੀਰ ਪਠਯੋ ॥",
      "transliteration": "likh aaise khaa meer paThayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮੀਰ ਖ਼ਾਨ ਨੇ (ਬਾਦਸ਼ਾਹ ਨੂੰ) ਇਸ ਤਰ੍ਰਹਾ ਲਿਖ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "लिखि ऐसे खा मीर पठयो ॥",
      "sourceLineId": "124103",
      "sourceShabadId": "11584",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਵਰੰਗ ਬੋਲਿ ਜਸਵੰਤਹਿ ਲੀਨੋ ॥",
      "transliteration": "avara(n)g bol jasava(n)teh leeno ||",
      "translation": "",
      "punjabiViakhya": "ਔਰੰਗਜ਼ੇਬ ਨੇ ਜਸਵੰਤ ਸਿੰਘ ਨੂੰ ਬੁਲਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "अवरंग बोलि जसवंतहि लीनो ॥",
      "sourceLineId": "124104",
      "sourceShabadId": "11584",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਵਨੈ ਠੌਰ ਭੇਜਿ ਕੈ ਦੀਨੋ ॥੩॥",
      "transliteration": "tavanai Thauar bhej kai dheeno ||3||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਉਸ ਨੂੰ) ਉਸ ਜਗ੍ਰਹਾ ਵਲ ਭੇਜ ਦਿੱਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "तवनै ठौर भेजि कै दीनो ॥३॥",
      "sourceLineId": "124105",
      "sourceShabadId": "11584",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "124106",
      "sourceShabadId": "11585",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਛੋਰਿ ਜਹਾਨਾਬਾਦ ਤਹਾ ਜਸਵੰਤ ਗਯੋ ॥",
      "transliteration": "chhor jahaanaabaadh tahaa jasava(n)t gayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਸਵੰਤ ਸਿੰਘ ਜਹਾਨਾਬਾਦ ਨੂੰ ਛਡ ਕੇ ਉਧਰ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "छोरि जहानाबाद तहा जसवंत गयो ॥",
      "sourceLineId": "124107",
      "sourceShabadId": "11585",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜੋ ਕੋਊ ਯਾਕੀ ਭਯੋ ਸੰਘਾਰਤ ਤਿਹ ਭਯੋ ॥",
      "transliteration": "jo kouoo yaakee bhayo sa(n)ghaarat teh bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਵੀ ਕੋਈ ਬਾਗ਼ੀ ਹੋਇਆ, ਉਸ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "जो कोऊ याकी भयो संघारत तिह भयो ॥",
      "sourceLineId": "124108",
      "sourceShabadId": "11585",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਆਇ ਮਿਲਿਯੋ ਤਾ ਕੌ ਸੋ ਲਿਯੋ ਉਬਾਰਿ ਕੈ ॥",
      "transliteration": "aai miliyo taa kau so liyo ubaar kai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਉਸ ਨੂੰ ਅਗੋਂ (ਅਧੀਨਗੀ ਦੇ ਭਾਵ ਨਾਲ) ਆ ਕੇ ਮਿਲਦਾ, ਉਸ ਨੂੰ ਬਚਾ ਲੈਂਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "आइ मिलियो ता कौ सो लियो उबारि कै ॥",
      "sourceLineId": "124109",
      "sourceShabadId": "11585",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹੋ ਡੰਡਿਯਾ ਬੰਗਸਤਾਨ ਪਠਾਨ ਸੰਘਾਰਿ ਕੈ ॥੪॥",
      "transliteration": "ho dda(n)ddiyaa ba(n)gasataan paThaan sa(n)ghaar kai ||4||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਡੰਡੀਆ ਅਤੇ ਬੰਗਸਤਾਨ ਦੇ ਪਠਾਣਾ ਦੀ ਮਾਰ ਕੇ (ਸਫ਼ਾਈ ਕਰ ਦਿੱਤੀ) ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "हो डंडिया बंगसतान पठान संघारि कै ॥४॥",
      "sourceLineId": "124110",
      "sourceShabadId": "11585",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੀਵ ਅਨਮਨੋ ਕਿਤਕ ਦਿਨਨ ਤਾ ਕੋ ਭਯੋ ॥",
      "transliteration": "jeev anamano kitak dhinan taa ko bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਕਈ ਦਿਨ ਜੀ ਖ਼ਰਾਬ ਰਿਹਾ (ਅਰਥਾਤ ਬੀਮਾਰ ਰਿਹਾ)",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "जीव अनमनो कितक दिनन ता को भयो ॥",
      "sourceLineId": "124111",
      "sourceShabadId": "11585",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਾ ਤੇ ਜਸਵੰਤ ਸਿੰਘ ਨ੍ਰਿਪਤਿ ਸੁਰ ਪੁਰ ਗਯੋ ॥",
      "transliteration": "taa te jasava(n)t si(n)gh nirapat sur pur gayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਰਾਜਾ ਜਸਵੰਤ ਸਿੰਘ ਸਵਰਗ ਨੂੰ ਚਲਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "ता ते जसवंत सिंघ नृपति सुर पुर गयो ॥",
      "sourceLineId": "124112",
      "sourceShabadId": "11585",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦ੍ਰੁਮਤਿ ਦਹਨ ਅਧਤਮ ਪ੍ਰਭਾ ਤਹ ਆਇ ਕੈ ॥",
      "transliteration": "dhrumat dhahan adhatam prabhaa teh aai kai ||",
      "translation": "",
      "punjabiViakhya": "ਦ੍ਰੁਮਤਿ ਦਹਨ ਅਤੇ ਅਧਤਮ ਪ੍ਰਭਾ ਉਥੇ ਆ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "द्रुमति दहन अधतम प्रभा तह आइ कै ॥",
      "sourceLineId": "124113",
      "sourceShabadId": "11585",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹੋ ਤਰੁਨਿ ਇਤ੍ਰਯਾਦਿਕ ਤ੍ਰਿਯ ਸਭ ਜਰੀ ਬਨਾਇ ਕੈ ॥੫॥",
      "transliteration": "ho tarun itrayaadhik tiray sabh jaree banai kai ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੋਰ ਇਸਤਰੀਆਂ ਨਾਲ ਰਲ ਕੇ ਸਾਰੀਆਂ (ਰਾਜੇ ਨਾਲ) ਸਤੀ ਹੋ ਗਈਆਂ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "हो तरुनि इत्रयादिक तृय सभ जरी बनाइ कै ॥५॥",
      "sourceLineId": "124114",
      "sourceShabadId": "11585",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਡੀਕ ਅਗਨਿ ਕੀ ਉਠੀ ਰਾਨਿਯਨ ਯੌ ਕਿਯੋ ॥",
      "transliteration": "ddeek agan kee uThee raaniyan yau kiyo ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਅੱਗ ਦੀ ਲਾਟ ('ਡੀਕ') ਉਠੀ ਤਾ ਰਾਣੀਆਂ ਨੇ ਇੰਜ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "डीक अगनि की उठी रानियन यौ कियो ॥",
      "sourceLineId": "124115",
      "sourceShabadId": "11585",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਮਸਕਾਰ ਕਰਿ ਸਪਤ ਪ੍ਰਦਛਿਨ ਕੌ ਦਿਯੋ ॥",
      "transliteration": "namasakaar kar sapat pradhachhin kau dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਸੱਤ ਪ੍ਰਦੱਛਣਾ ਦੇ ਕੇ ਨਮਸਕਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "नमसकार करि सपत प्रदछिन कौ दियो ॥",
      "sourceLineId": "124116",
      "sourceShabadId": "11585",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕੂਦਿ ਕੂਦਿ ਕਰਿ ਪਰੀ ਨਰੇਰ ਨਚਾਇ ਕੈ ॥",
      "transliteration": "koodh koodh kar paree narer nachai kai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਹੱਥਾ ਵਿਚ ਨਾਰੀਅਲ ਉਛਾਲਦੀਆਂ ਹੋਈਆਂ (ਅਗਨੀ ਵਿਚ) ਕੁਦ ਕੁਦ ਕੇ ਜਾ ਪਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "कूदि कूदि करि परी नरेर नचाइ कै ॥",
      "sourceLineId": "124117",
      "sourceShabadId": "11585",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹੋ ਜਨੁਕ ਗੰਗ ਕੇ ਮਾਝ ਅਪਛਰਾ ਆਇ ਕੈ ॥੬॥",
      "transliteration": "ho januk ga(n)g ke maajh apachharaa aai kai ||6||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਅਪੱਛਰਾਵਾ ਨੇ ਗੰਗਾ ਵਿਚ ਛਾਲਾ ਮਾਰੀਆਂ ਹੋਣ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "हो जनुक गंग के माझ अपछरा आइ कै ॥६॥",
      "sourceLineId": "124118",
      "sourceShabadId": "11585",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "124119",
      "sourceShabadId": "11586",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਿਤਨ ਕਲਾ ਦੁਤਿਮਾਨ ਮਤਿ ਚਲੀ ਜਰਨ ਕੇ ਕਾਜ ॥",
      "transliteration": "bitan kalaa dhutimaan mat chalee jaran ke kaaj ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਤਨ ਕਲਾ ਅਤੇ ਦੁਤਿਮਾਨ ਮਤਿ ਵੀ ਸੜਨ ਲਈ ਚਲੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "बितन कला दुतिमान मति चली जरन के काज ॥",
      "sourceLineId": "124120",
      "sourceShabadId": "11586",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦੁਰਗ ਦਾਸ ਸੁਨਿ ਗਤਿ ਤਿਸੈ ਰਾਖਿਯੋ ਕੋਟਿ ਇਲਾਜ ॥੭॥",
      "transliteration": "dhurag dhaas sun gat tisai raakhiyo koT ilaaj ||7||",
      "translation": "",
      "punjabiViakhya": "ਦੁਰਗ ਦਾਸ ਨੇ ਇਹ ਸਥਿਤੀ ਸੁਣ ਕੇ ਬਹੁਤ ਯਤਨਾ ਨਾਲ ਉਨ੍ਰਹਾ ਨੂੰ ਰੋਕ ਲਿਆ (ਭਾਵ ਬਚਾ ਲਿਆ) ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "दुरग दास सुनि गति तिसै राखियो कोटि इलाज ॥७॥",
      "sourceLineId": "124121",
      "sourceShabadId": "11586",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮੇੜਤੇਸ ਥਾਰੇ ਉਦਰ ਸੁਨਿ ਰਾਨੀ ਮਮ ਬੈਨ ॥",
      "transliteration": "meRates thaare udhar sun raanee mam bain ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਣੀ! ਮੇਰੀ ਗੱਲ ਸੁਣੋ। ਮਾਰਵਾੜ ਦਾ (ਹੋਣ ਵਾਲਾ) ਰਾਜਾ ਤੁਹਾਡੇ ਪੇਟ ਵਿਚ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "मेड़तेस थारे उदर सुनि रानी मम बैन ॥",
      "sourceLineId": "124122",
      "sourceShabadId": "11586",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮੈ ਨ ਮਿਲੌ ਹਜਰਤਿ ਤਨੈ ਜਾਸਾ ਅਪਨੇ ਐਨ ॥੮॥",
      "transliteration": "mai na milau hajarat tanai jaasaa apane aain ||8||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਕਹਿਣ ਲਗੀ) ਮੈਂ ਬਾਦਸ਼ਾਹ ਨੂੰ ਨਹੀਂ ਮਿਲਾਗੀ ਅਤੇ ਆਪਣੇ ਘਰ ਜਾਵਾਗੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "मै न मिलौ हजरति तनै जासा अपने ऐन ॥८॥",
      "sourceLineId": "124123",
      "sourceShabadId": "11586",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "124124",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਬ ਹਾਡੀ ਪਤਿ ਸੌ ਨਹਿ ਜਰੀ ॥",
      "transliteration": "tab haaddee pat sau neh jaree ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹਾਡੀ (ਰਾਜਪੂਤ ਰਾਣੀ) ਪਤੀ ਨਾਲ ਨਾ ਸੜੀ",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "तब हाडी पति सौ नहि जरी ॥",
      "sourceLineId": "124125",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਲਰਿਕਨ ਕੀ ਆਸਾ ਜਿਯ ਧਰੀ ॥",
      "transliteration": "larikan kee aasaa jiy dharee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲੜਕਿਆਂ ਦੀ ਆਸ ਮਨ ਵਿਚ ਰਖ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "लरिकन की आसा जिय धरी ॥",
      "sourceLineId": "124126",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਛੋਰਿ ਪਿਸੌਰ ਦਿਲੀ ਕੌ ਆਏ ॥",
      "transliteration": "chhor pisauar dhilee kau aae ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਸ਼ਾਵਰ ਨੂੰ ਛਡ ਕੇ ਦਿੱਲੀ ਵਲ ਚਲ ਪਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "छोरि पिसौर दिली कौ आए ॥",
      "sourceLineId": "124127",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਹਿਰ ਲਹੌਰ ਪੂਤ ਦੋ ਜਾਏ ॥੯॥",
      "transliteration": "sahir lahauar poot dho jaae ||9||",
      "translation": "",
      "punjabiViakhya": "ਲਾਹੌਰ ਸ਼ਹਿਰ ਵਿਚ ਆ ਕੇ ਦੋ ਪੁੱਤਰਾ ਨੂੰ ਜਨਮ ਦਿੱਤਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "सहिर लहौर पूत दो जाए ॥९॥",
      "sourceLineId": "124128",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਬ ਰਾਨੀ ਦਿਲੀ ਮੌ ਗਈ ॥",
      "transliteration": "jab raanee dhilee mau giee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਣੀ ਦਿੱਲੀ ਪਹੁੰਚੀ",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "जब रानी दिली मौ गई ॥",
      "sourceLineId": "124129",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹਜਰਤਿ ਕੌ ਐਸੀ ਸੁਧਿ ਭਈ ॥",
      "transliteration": "hajarat kau aaisee sudh bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਬਾਦਸ਼ਾਹ ਨੂੰ ਇਸ ਦਾ ਪਤਾ ਲਗ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "हजरति कौ ऐसी सुधि भई ॥",
      "sourceLineId": "124130",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੋਊਅਨ ਕਹਿਯੋ ਇਨੈ ਮੁਹਿ ਦੀਜੈ ॥",
      "transliteration": "souooan kahiyo inai muh dheejai ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਬਾਦਸ਼ਾਹ ਨੇ) ਸਾਊਆਂ ਨੂੰ ਕਿਹਾ ਕਿ ਇਨ੍ਰਹਾ (ਰਾਣੀਆਂ) ਨੂੰ ਮੇਰੇ ਹਵਾਲੇ ਕਰ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "सोऊअन कहियो इनै मुहि दीजै ॥",
      "sourceLineId": "124131",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤੁਮ ਮਨਸਬ ਜਸਵੰਤ ਕੋ ਲੀਜੈ ॥੧੦॥",
      "transliteration": "tum manasab jasava(n)t ko leejai ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤਸੀਂ ਜਸਵੰਤ ਸਿੰਘ ਦਾ ਰੁਤਬਾ ਸੰਭਾਲ ਲਵੋ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "तुम मनसब जसवंत को लीजै ॥१०॥",
      "sourceLineId": "124132",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰਨਿਯਨ ਕੋ ਸਊਅਨ ਨਹਿ ਦਯੋ ॥",
      "transliteration": "raniyan ko suooan neh dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਊਆਂ ਨੇ ਰਾਣੀਆਂ ਨਾ ਦਿੱਤੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "रनियन को सऊअन नहि दयो ॥",
      "sourceLineId": "124133",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹਜਰਤਿ ਸੈਨ ਪਠਾਵਤ ਭਯੋ ॥",
      "transliteration": "hajarat sain paThaavat bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਬਾਦਸ਼ਾਹ ਨੇ (ਉਨ੍ਰਹਾ ਪਿਛੇ) ਸੈਨਾ ਚੜ੍ਰਹਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "हजरति सैन पठावत भयो ॥",
      "sourceLineId": "124134",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰਨਛੋਰੈ ਇਹ ਭਾਤਿ ਉਚਾਰੋ ॥",
      "transliteration": "ranachhorai ieh bhaat uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਰਣਛੋੜ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "रनछोरै इह भाति उचारो ॥",
      "sourceLineId": "124135",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਰ ਕੋ ਭੇਸ ਸਭੈ ਤੁਮ ਧਾਰੋ ॥੧੧॥",
      "transliteration": "nar ko bhes sabhai tum dhaaro ||11||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੁਸੀਂ ਸਾਰੀਆਂ ਮਰਦਾਵਾ ਭੇਸ ਧਾਰ ਲਵੋ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "नर को भेस सभै तुम धारो ॥११॥",
      "sourceLineId": "124136",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਖਾਨ ਪੁਲਾਦ ਜਬੈ ਚੜਿ ਆਏ ॥",
      "transliteration": "khaan pulaadh jabai chaR aae ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਪੁਲਾਦ ਖ਼ਾਨ ਚੜ੍ਰਹ ਕੇ ਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1079,
      "hindi": "",
      "hindiTransliteration": "खान पुलाद जबै चड़ि आए ॥",
      "sourceLineId": "124137",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1079_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਬ ਰਨਿਯਨ ਯੌ ਬਚਨ ਸੁਨਾਏ ॥",
      "transliteration": "tab raniyan yau bachan sunaae ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀਆਂ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਬਚਨ ਸੁਣਾਏ।",
      "source": "DASAM_GRANTH",
