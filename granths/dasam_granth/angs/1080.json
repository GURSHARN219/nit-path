{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1080,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1080_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਮੈ ਨਗਜ ਸੈਨਾ ਮੌ ਦੀਜੈ ॥",
      "transliteration": "hamai nagaj sainaa mau dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਨੂੰ ਨਗਜ (ਪਹਾੜੀ) ਸੈਨਾ ਦੇ ਹਵਾਲੇ ਕਰ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "हमै नगज सैना मौ दीजै ॥",
      "sourceLineId": "124139",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਹਿੰਦੂ ਧਰਮ ਰਾਖਿ ਕਰਿ ਲੀਜੈ ॥੧੨॥",
      "transliteration": "hi(n)dhoo dharam raakh kar leejai ||12||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਜੋ ਅਸੀਂ (ਆਪਣੇ) ਹਿੰਦੂ ਧਰਮ ਨੂੰ ਬਚਾ ਸਕੀਏ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "हिंदू धरम राखि करि लीजै ॥१२॥",
      "sourceLineId": "124140",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਾਵਨ ਕੌ ਸੁਭ ਵਾਰੋ ਦਿਯੋ ॥",
      "transliteration": "naavan kau subh vaaro dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ਼ਨਾਨ ਕਰਨ ਦਾ ਭੁਲਾਵਾ ਦੇ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "नावन कौ सुभ वारो दियो ॥",
      "sourceLineId": "124141",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਾਲਨ ਸਹਿਤ ਦੇਸ ਮਗੁ ਲਿਯੋ ॥",
      "transliteration": "baalan sahit dhes mag liyo ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਲਕਾ ਸਮੇਤ (ਉਨ੍ਰਹਾ ਨੇ ਆਪਣੇ) ਦੇਸ ਦਾ ਰਸਤਾ ਪਕੜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "बालन सहित देस मगु लियो ॥",
      "sourceLineId": "124142",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰਜਪੂਤਨ ਰੂਮਾਲ ਫਿਰਾਏ ॥",
      "transliteration": "rajapootan roomaal firaae ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜਪੂਤਨੀਆਂ ਨੇ ਰੁਮਾਲ ਫਿਰਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "रजपूतन रूमाल फिराए ॥",
      "sourceLineId": "124143",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਮ ਮਿਲਨੇ ਹਜਰਤਿ ਕੌ ਆਏ ॥੧੩॥",
      "transliteration": "ham milane hajarat kau aae ||13||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਅਸੀਂ ਬਾਦਸ਼ਾਹ ਨੂੰ ਮਿਲਣ ਲਈ ਆਈਆਂ ਹਾ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "हम मिलने हजरति कौ आए ॥१३॥",
      "sourceLineId": "124144",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਿਨ ਕੌ ਕਿਨੀ ਨ ਚੋਟਿ ਚਲਾਈ ॥",
      "transliteration": "tin kau kinee na choT chalaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਉਤੇ ਕਿਸੇ ਨੇ ਹਮਲਾ ਨਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "तिन कौ किनी न चोटि चलाई ॥",
      "sourceLineId": "124145",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਇਹ ਰਾਨੀ ਹਜਰਤਿ ਪਹ ਆਈ ॥",
      "transliteration": "eeh raanee hajarat peh aaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਸਮਝਿਆ ਕਿ) ਇਹ ਰਾਣੀ ਬਾਦਸ਼ਾਹ ਕੋਲ ਆਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "इह रानी हजरति पह आई ॥",
      "sourceLineId": "124146",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤੁਪਕ ਤਲੋ ਤੈ ਜਬੈ ਉਬਰੇ ॥",
      "transliteration": "tupak talo tai jabai ubare ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਇਹ ਬੰਦੂਕਾ ਦੀ ਮਾਰ ਤੋਂ ਨਿਕਲ ਆਈਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "तुपक तलो तै जबै उबरे ॥",
      "sourceLineId": "124147",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਬ ਹੀ ਕਾਢਿ ਕ੍ਰਿਪਾਨੈ ਪਰੇ ॥੧੪॥",
      "transliteration": "tab hee kaadd kirapaanai pare ||14||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਕ੍ਰਿਪਾਨਾ ਕਢ ਕੇ ਪੈ ਗਈਆਂ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "तब ही काढि कृपानै परे ॥१४॥",
      "sourceLineId": "124148",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੌਨੈ ਸੂਰ ਸਰੋਹੀ ਬਹੈ ॥",
      "transliteration": "jauanai soor sarohee bahai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵੀ ਸੂਰਮੇ ਉਤੇ ਤਲਵਾਰ ਚਲਾਉਾਂਦੀਆਂ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "जौनै सूर सरोही बहै ॥",
      "sourceLineId": "124149",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੈਬੋ ਟਿਕੈ ਨ ਬਖਤਰ ਰਹੈ ॥",
      "transliteration": "jaibo Tikai na bakhatar rahai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਨਾ ਲੋਹੇ ਦੇ ਕਫ ('ਜੈਬੋ') ਟਿਕਦੇ ਸਨ ਅਤੇ ਨਾ ਹੀ ਕਵਚ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "जैबो टिकै न बखतर रहै ॥",
      "sourceLineId": "124150",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਏਕੈ ਤੀਰ ਏਕ ਅਸਵਾਰਾ ॥",
      "transliteration": "ekai teer ek asavaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਸਵਾਰ ਲਈ ਇਕ ਤੀਰ",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "एकै तीर एक असवारा ॥",
      "sourceLineId": "124151",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਏਕੈ ਘਾਇ ਏਕ ਗਜ ਭਾਰਾ ॥੧੫॥",
      "transliteration": "ekai ghai ek gaj bhaaraa ||15||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਵੱਡੇ ਹਾਥੀ ਲਈ (ਕਿਰਪਾਨ ਦਾ) ਇਕ ਜ਼ਖ਼ਮ (ਕਾਫ਼ੀ ਸਨ) ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "एकै घाइ एक गज भारा ॥१५॥",
      "sourceLineId": "124152",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਾ ਪਰ ਪਰੈ ਖੜਗ ਕੀ ਧਾਰਾ ॥",
      "transliteration": "jaa par parai khaRag kee dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਉਤੇ ਵੀ ਤਲਵਾਰ ਦੀ ਧਾਰ ਪੈਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "जा पर परै खड़ग की धारा ॥",
      "sourceLineId": "124153",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਨੁਕ ਬਹੇ ਬਿਰਛ ਪਰ ਆਰਾ ॥",
      "transliteration": "januk bahe birachh par aaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਬ੍ਰਿਛ ਉਤੇ ਆਰਾ ਚਲ ਰਿਹਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "जनुक बहे बिरछ पर आरा ॥",
      "sourceLineId": "124154",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਟਿ ਕਟਿ ਸੁਭਟ ਧਰਨਿ ਪਰ ਪਰਹੀ ॥",
      "transliteration": "kaT kaT subhaT dharan par parahee ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਵੀਰ ਕਟ ਕਟ ਕੇ ਧਰਤੀ ਉਤੇ ਡਿਗ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "कटि कटि सुभट धरनि पर परही ॥",
      "sourceLineId": "124155",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚਟਪਟ ਆਨਿ ਅਪਛਰਾ ਬਰਹੀ ॥੧੬॥",
      "transliteration": "chaTapaT aan apachharaa barahee ||16||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਉਨ੍ਰਹਾ ਨੂੰ) ਝਟਪਟ ਆ ਕੇ ਅਪੱਛਰਾਵਾ ਵਰ ਰਹੀਆਂ ਸਨ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "चटपट आनि अपछरा बरही ॥१६॥",
      "sourceLineId": "124156",
      "sourceShabadId": "11587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "124157",
      "sourceShabadId": "11588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਨਛੋਰੈ ਰਘੁਨਾਥ ਸਿੰਘ ਕੀਨੋ ਕੋਪ ਅਪਾਰ ॥",
      "transliteration": "ranachhorai raghunaath si(n)gh keeno kop apaar ||",
      "translation": "",
      "punjabiViakhya": "ਰਣਛੋੜ ਅਤੇ ਰਘੁਨਾਥ ਸਿੰਘ ਨੇ ਬਹੁਤ ਕ੍ਰੋਧ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "रनछोरै रघुनाथ सिंघ कीनो कोप अपार ॥",
      "sourceLineId": "124158",
      "sourceShabadId": "11588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਾਹ ਝਰੋਖਾ ਕੇ ਤਰੇ ਬਾਹਤ ਭੇ ਹਥਿਯਾਰ ॥੧੭॥",
      "transliteration": "saeh jharokhaa ke tare baahat bhe hathiyaar ||17||",
      "translation": "",
      "punjabiViakhya": "ਬਾਦਸ਼ਾਹ ਦੇ ਝਰੋਖੇ ਹੇਠਾ ਹਥਿਆਰ ਚਲਾਉਣ ਲਗੇ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "साह झरोखा के तरे बाहत भे हथियार ॥१७॥",
      "sourceLineId": "124159",
      "sourceShabadId": "11588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਭੁਜੰਗ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g chha(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਭੁਜੰਗ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "भुजंग छंद ॥",
      "sourceLineId": "124160",
      "sourceShabadId": "11589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਹੂੰ ਧੋਪ ਬਾਕੈ ਕਹੂੰ ਬਾਨ ਛੂਟੈ ॥",
      "transliteration": "kahoo(n) dhop baakai kahoo(n) baan chhooTai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸੁੰਦਰ ਤਲਵਾਰਾ ਚਲਦੀਆਂ ਸਨ ਅਤੇ ਕਿਤੇ ਬਾਣ ਛੁਟਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "कहूँ धोप बाकै कहूँ बान छूटै ॥",
      "sourceLineId": "124161",
      "sourceShabadId": "11589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਹੂੰ ਬੀਰ ਬਾਨੀਨ ਕੇ ਬਕਤ੍ਰ ਟੂਟੈ ॥",
      "transliteration": "kahoo(n) beer baaneen ke bakatr TooTai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਬਾਣਾ ਵਾਲੇ ਸੂਰਮਿਆਂ ਦੇ ਕਵਚ ਟੁੱਟੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "कहूँ बीर बानीन के बकत्र टूटै ॥",
      "sourceLineId": "124162",
      "sourceShabadId": "11589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਹੂੰ ਬਾਜ ਮਾਰੇ ਗਜਾਰਾਜ ਜੂਝੈ ॥",
      "transliteration": "kahoo(n) baaj maare gajaaraaj joojhai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਘੋੜੇ ਮਾਰੇ ਗਏ ਸਨ ਅਤੇ ਕਿਤੇ ਵੱਡੇ ਹਾਥੀ ਜੂਝੇ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "कहूँ बाज मारे गजाराज जूझै ॥",
      "sourceLineId": "124163",
      "sourceShabadId": "11589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਟੇ ਕੋਟਿ ਜੋਧਾ ਨਹੀ ਜਾਤ ਬੂਝੇ ॥੧੮॥",
      "transliteration": "kaTe koT jodhaa nahee jaat boojhe ||18||",
      "translation": "",
      "punjabiViakhya": "ਬੇਸ਼ੁਮਾਰ ਯੋਧੇ ਕਟੇ ਪਏ ਸਨ, ਜਿਨ੍ਰਹਾ ਦੀ ਗਿਣਤੀ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕਦੀ ਸੀ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "कटे कोटि जोधा नही जात बूझे ॥१८॥",
      "sourceLineId": "124164",
      "sourceShabadId": "11589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "124165",
      "sourceShabadId": "11590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਖਾਇ ਟਾਕਿ ਆਫੂਐ ਰਾਜ ਸਭ ਰਿਸਿ ਭਰੇ ॥",
      "transliteration": "khai Taak aafooaai raaj sabh ris bhare ||",
      "translation": "",
      "punjabiViakhya": "ਚਾਰ ਮਾਸੇ ਅਫ਼ੀਮ ਖਾ ਕੇ ਸਾਰੇ ਰਾਜੇ ਕ੍ਰੋਧ ਵਿਚ ਆ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "खाइ टाकि आफूऐ राज सभ रिसि भरे ॥",
      "sourceLineId": "124166",
      "sourceShabadId": "11590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪੋਸਤ ਭਾਗ ਸਰਾਬ ਪਾਨ ਕਰਿ ਅਤਿ ਲਰੇ ॥",
      "transliteration": "posat bhaag saraab paan kar at lare ||",
      "translation": "",
      "punjabiViakhya": "ਪੋਸਤ, ਭੰਗ ਅਤੇ ਸ਼ਰਾਬ ਦਾ ਸੇਵਨ ਕਰ ਕੇ ਖ਼ੂਬ ਲੜੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "पोसत भाग सराब पान करि अति लरे ॥",
      "sourceLineId": "124167",
      "sourceShabadId": "11590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਾਹ ਝਰੋਖਾ ਤਰੈ ਚਰਿਤ੍ਰ ਦਿਖਾਇ ਕੈ ॥",
      "transliteration": "saeh jharokhaa tarai charitr dhikhai kai ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਦਸ਼ਾਹ ਦੇ ਝਰੋਖੇ ਹੇਠਾ ਚਰਿਤ੍ਰ ਵਿਖਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "साह झरोखा तरै चरित्र दिखाइ कै ॥",
      "sourceLineId": "124168",
      "sourceShabadId": "11590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹੋ ਰਨਛੋਰਾ ਸੁਰ ਲੋਕ ਗਏ ਸੁਖ ਪਾਇ ਕੈ ॥੧੯॥",
      "transliteration": "ho ranachhoraa sur lok ge sukh pai kai ||19||",
      "translation": "",
      "punjabiViakhya": "ਰਣਛੋੜ ਸੁਖ ਪੂਰਵਕ ਸਵਰਗ ਨੂੰ ਚਲਾ ਗਿਆ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "हो रनछोरा सुर लोक गए सुख पाइ कै ॥१९॥",
      "sourceLineId": "124169",
      "sourceShabadId": "11590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਰਨਛੋਰਹਿ ਰਘੁਨਾਥ ਨਿਰਖਿ ਕਰਿ ਰਿਸਿ ਭਰਿਯੋ ॥",
      "transliteration": "ranachhoreh raghunaath nirakh kar ris bhariyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਣਛੋੜ ਨੂੰ (ਮਰਿਆ) ਵੇਖ ਕੇ ਰਘੂਨਾਥ ਬਹੁਤ ਰੋਹ ਵਿਚ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "रनछोरहि रघुनाथ निरखि करि रिसि भरियो ॥",
      "sourceLineId": "124170",
      "sourceShabadId": "11590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਾ ਤੇ ਤੁਰੈ ਧਵਾਇ ਜਾਇ ਦਲ ਮੈ ਪਰਿਯੋ ॥",
      "transliteration": "taa te turai dhavai jai dhal mai pariyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਘੋੜੇ ਨੂੰ ਭਜਾ ਕੇ ਦਲ ਵਿਚ ਪਹੁੰਚ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "ता ते तुरै धवाइ जाइ दल मै परियो ॥",
      "sourceLineId": "124171",
      "sourceShabadId": "11590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਾ ਕੌ ਬਹੈ ਸਰੋਹੀ ਰਹੈ ਨ ਬਾਜ ਪਰ ॥",
      "transliteration": "jaa kau bahai sarohee rahai na baaj par ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਤਲਵਾਰ ਵਜਦੀ ਸੀ, ਉਹ ਘੋੜੇ ਉਤੇ ਸਵਾਰ ਨਹੀਂ ਰਹਿ ਸਕਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "जा कौ बहै सरोही रहै न बाज पर ॥",
      "sourceLineId": "124172",
      "sourceShabadId": "11590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹੋ ਗਿਰੈ ਮੂਰਛਨਾ ਖਾਇ ਤੁਰਤ ਸੋ ਭੂਮਿ ਪਰ ॥੨੦॥",
      "transliteration": "ho girai moorachhanaa khai turat so bhoom par ||20||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਤੁਰਤ ਮੂਰਛਿਤ ਹੋ ਕੇ ਧਰਤੀ ਉਤੇ ਡਿਗ ਪੈਂਦਾ ਸੀ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "हो गिरै मूरछना खाइ तुरत सो भूमि पर ॥२०॥",
      "sourceLineId": "124173",
      "sourceShabadId": "11590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਧਨਿ ਧਨਿ ਔਰੰਗਸਾਹ ਤਿਨੈ ਭਾਖਤ ਭਯੋ ॥",
      "transliteration": "dhan dhan aauara(n)gasaeh tinai bhaakhat bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਵੇਖ ਕੇ ਔਰੰਗਜ਼ੇਬ ਵੀ ਧੰਨ ਧੰਨ ਕਹਿਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "धनि धनि औरंगसाह तिनै भाखत भयो ॥",
      "sourceLineId": "124174",
      "sourceShabadId": "11590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਘੇਰਹੁ ਇਨ ਕੌ ਜਾਇ ਦਲਹਿ ਆਇਸ ਦਯੋ ॥",
      "transliteration": "gherahu in kau jai dhaleh aais dhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਆਪਣੀ) ਸੈਨਾ ਨੂੰ ਆਗਿਆ ਦਿੱਤੀ ਕਿ ਇਨ੍ਰਹਾ ਨੂੰ ਜਾ ਕੇ ਘੇਰ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "घेरहु इन कौ जाइ दलहि आइस दयो ॥",
      "sourceLineId": "124175",
      "sourceShabadId": "11590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੋ ਐਸੇ ਦੋ ਚਾਰ ਔਰ ਭਟ ਧਾਵਹੀ ॥",
      "transliteration": "jo aaise dho chaar aauar bhaT dhaavahee ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਇਹੋ ਜਿਹੇ ਦੋ ਚਾਰ ਸੂਰਮੇ ਆ ਪਏ",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "जो ऐसे दो चार और भट धावही ॥",
      "sourceLineId": "124176",
      "sourceShabadId": "11590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹੋ ਬੰਕ ਲੰਕ ਗੜ ਜੀਤਿ ਛਿਨਿਕ ਮੋ ਲ੍ਯਾਵਹੀ ॥੨੧॥",
      "transliteration": "ho ba(n)k la(n)k gaR jeet chhinik mo layaavahee ||21||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਲੰਕਾ ਦੇ ਸੁੰਦਰ ਕਿਲ੍ਰਹੇ ਨੂੰ ਵੀ ਛਿਣ ਵਿਚ ਜਿਤ ਲਿਆਉਣਗੇ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "हो बंक लंक गड़ जीति छिनिक मो ल्यावही ॥२१॥",
      "sourceLineId": "124177",
      "sourceShabadId": "11590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹਾਕਿ ਹਾਕਿ ਕਰਿ ਮਹਾ ਬੀਰ ਸੂਰਾ ਧਏ ॥",
      "transliteration": "haak haak kar mahaa beer sooraa dhe ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਲਲਕਾਰੇ ਮਾਰ ਮਾਰ ਕੇ ਅਗੇ ਵਧ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "हाकि हाकि करि महा बीर सूरा धए ॥",
      "sourceLineId": "124178",
      "sourceShabadId": "11590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਠਿਲਾ ਠਿਲੀ ਬਰਛਿਨ ਸੌ ਕਰਤ ਤਹਾ ਭਏ ॥",
      "transliteration": "Thilaa Thilee barachhin sau karat tahaa bhe ||",
      "translation": "",
      "punjabiViakhya": "ਬਰਛਿਆਂ ਨਾਲ ਉਥੇ ਧੱਕਮਧੱਕੀ ਕਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "ठिला ठिली बरछिन सौ करत तहा भए ॥",
      "sourceLineId": "124179",
      "sourceShabadId": "11590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕੜਾਕੜੀ ਮੈਦਾਨ ਮਚਾਯੋ ਆਇ ਕਰ ॥",
      "transliteration": "kaRaakaRee maidhaan machaayo aai kar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਆ ਕੇ ਕੜਾਕੇਦਾਰ ਯੁੱਧ ਮਚਾ ਦਿੱਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "कड़ाकड़ी मैदान मचायो आइ कर ॥",
      "sourceLineId": "124180",
      "sourceShabadId": "11590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹੋ ਭਾਤਿ ਭਾਤਿ ਬਾਦਿਤ੍ਰ ਅਨੇਕ ਬਜਾਇ ਕਰ ॥੨੨॥",
      "transliteration": "ho bhaat bhaat baadhitr anek bajai kar ||22||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦੇ ਅਨੇਕ ਵਾਜੇ ਵਜਾ ਦਿੱਤੇ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "हो भाति भाति बादित्र अनेक बजाइ कर ॥२२॥",
      "sourceLineId": "124181",
      "sourceShabadId": "11590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "124182",
      "sourceShabadId": "11591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤੁਮਲ ਜੁਧ ਮਚਤ ਤਹ ਭਯੋ ॥",
      "transliteration": "tumal judh machat teh bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਘਮਸਾਨ ਯੁੱਧ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "तुमल जुध मचत तह भयो ॥",
      "sourceLineId": "124183",
      "sourceShabadId": "11591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਲੈ ਰਘੁਨਾਥ ਸੈਨ ਸਮੁਹਯੋ ॥",
      "transliteration": "lai raghunaath sain samuhayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਘੂਨਾਥ ਸੈਨਾ ਲੈ ਕੇ ਸਾਹਮਣੇ ਆ ਡਟਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "लै रघुनाथ सैन समुहयो ॥",
      "sourceLineId": "124184",
      "sourceShabadId": "11591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਸੋ ਬਜੇ ਨਗਾਰੇ ॥",
      "transliteration": "bhaat bhaat so baje nagaare ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦੇ ਨਗਾਰੇ ਵਜੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "भाति भाति सो बजे नगारे ॥",
      "sourceLineId": "124185",
      "sourceShabadId": "11591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1080_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਖੇਤਿ ਮੰਡਿ ਸੂਰਮਾ ਹਕਾਰੇ ॥੨੩॥",
      "transliteration": "khet ma(n)dd sooramaa hakaare ||23||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਮਚਾ ਕੇ ਸੂਰਮੇ ਇਕ ਦੂਜੇ ਨੂੰ ਵੰਗਾਰਨ ਲਗੇ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1080,
      "hindi": "",
      "hindiTransliteration": "खेति मंडि सूरमा हकारे ॥२३॥",
      "sourceLineId": "124186",
      "sourceShabadId": "11591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
