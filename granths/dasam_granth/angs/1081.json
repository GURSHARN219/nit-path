{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1081,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1081_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗਹਿ ਗਹਿ ਸਸਤ੍ਰ ਸੂਰਮਾ ਧਾਏ ॥",
      "transliteration": "geh geh sasatr sooramaa dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰ ਪਕੜ ਪਕੜ ਕੇ ਸੂਰਮੇ (ਯੁੱਧ ਲਈ) ਦੌੜੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "गहि गहि ससत्र सूरमा धाए ॥",
      "sourceLineId": "124187",
      "sourceShabadId": "11591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੇਵ ਅਦੇਵ ਬਿਲੋਕਨ ਆਏ ॥",
      "transliteration": "dhev adhev bilokan aae ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤੇ ਅਤੇ ਦੈਂਤ (ਜੰਗ ਨੂੰ) ਵੇਖਣ ਲਈ ਆਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "देव अदेव बिलोकन आए ॥",
      "sourceLineId": "124188",
      "sourceShabadId": "11591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਾ ਪਰ ਦੋਇ ਕਰੰਧਰ ਧਰੈ ॥",
      "transliteration": "jaa par dhoi kara(n)dhar dharai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਉਤੇ ਦੋਹਾ ਹੱਥਾ ਵਿਚ ਧਾਰਨ ਕਰ ਕੇ (ਤਲਵਾਰ) ਮਾਰਦੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "जा पर दोइ करंधर धरै ॥",
      "sourceLineId": "124189",
      "sourceShabadId": "11591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਏਕ ਸੁਭਟ ਤੇ ਦੋ ਦੋ ਕਰੈ ॥੨੪॥",
      "transliteration": "ek subhaT te dho dho karai ||24||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਕ ਸੂਰਮੇ ਦੇ ਦੋ ਦੋ ਕਰ ਦਿੰਦੇ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "एक सुभट ते दो दो करै ॥२४॥",
      "sourceLineId": "124190",
      "sourceShabadId": "11591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਾ ਕੈ ਅੰਗ ਸਰੋਹੀ ਬਹੀ ॥",
      "transliteration": "jaa kai a(n)g sarohee bahee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਸ਼ਰੀਰ ਉਤੇ ਤਲਵਾਰ ਚਲ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "जा कै अंग सरोही बही ॥",
      "sourceLineId": "124191",
      "sourceShabadId": "11591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਾ ਕੀ ਗ੍ਰੀਵ ਸੰਗ ਨਹਿ ਰਹੀ ॥",
      "transliteration": "taa kee greev sa(n)g neh rahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਗਰਦਨ ਨਾਲ ਨਹੀਂ ਰਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "ता की ग्रीव संग नहि रही ॥",
      "sourceLineId": "124192",
      "sourceShabadId": "11591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਾ ਕੈ ਲਗਿਯੋ ਕੁਹਕਤੋ ਬਾਨਾ ॥",
      "transliteration": "jaa kai lagiyo kuhakato baanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਸ਼ੂਕਦਾ ਹੋਇਆ ਬਾਣ ਲਗਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "जा कै लगियो कुहकतो बाना ॥",
      "sourceLineId": "124193",
      "sourceShabadId": "11591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪਲਕ ਏਕ ਮੈ ਤਜੈ ਪਰਾਨਾ ॥੨੫॥",
      "transliteration": "palak ek mai tajai paraanaa ||25||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਇਕ ਪਲਕ ਵਿਚ ਪ੍ਰਾਣ ਛਡ ਜਾਦਾ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "पलक एक मै तजै पराना ॥२५॥",
      "sourceLineId": "124194",
      "sourceShabadId": "11591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਾ ਕੈ ਘਾਇ ਗੁਰਜ ਕੋ ਲਾਗਿਯੋ ॥",
      "transliteration": "jaa kai ghai guraj ko laagiyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਗੁਰਜ ਦਾ ਵਾਰ ਵਜਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "जा कै घाइ गुरज को लागियो ॥",
      "sourceLineId": "124195",
      "sourceShabadId": "11591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਾ ਕੋ ਪ੍ਰਾਨ ਦੇਹ ਤਜਿ ਭਾਗਿਯੋ ॥",
      "transliteration": "taa ko praan dheh taj bhaagiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਦੇਹ ਨੂੰ ਪ੍ਰਾਣ ਛਡ ਕੇ ਭਜ ਜਾਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "ता को प्रान देह तजि भागियो ॥",
      "sourceLineId": "124196",
      "sourceShabadId": "11591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹਾਹਾਕਾਰ ਪਖਰਿਯਾ ਕਰਹੀ ॥",
      "transliteration": "haahaakaar pakhariyaa karahee ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜ ਸਵਾਰ ਹਾਹਾ-ਕਾਰ ਮਚਾ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "हाहाकार पखरिया करही ॥",
      "sourceLineId": "124197",
      "sourceShabadId": "11591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਾਠੌਰਨ ਕੇ ਪਾਲੇ ਪਰਹੀ ॥੨੬॥",
      "transliteration": "raaThauaran ke paale parahee ||26||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦਾ) ਰਾਠੌਰ ਰਾਜਪੂਤਾ ਨਾਲ ਪਾਲਾ ਪੈ ਗਿਆ ਸੀ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "राठौरन के पाले परही ॥२६॥",
      "sourceLineId": "124198",
      "sourceShabadId": "11591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਵੈਯਾ ॥",
      "transliteration": "savaiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੈਯਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "सवैया ॥",
      "sourceLineId": "124199",
      "sourceShabadId": "11592",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਆਨਿ ਪਰੇ ਰਿਸਿ ਠਾਨਿ ਰਠੌਰ ਚਹੂੰ ਦਿਸ ਤੇ ਕਰ ਆਯੁਧ ਲੀਨੇ ॥",
      "transliteration": "aan pare ris Thaan raThauar chahoo(n) dhis te kar aayudh leene ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਠੌਰ ਹੱਥਾ ਵਿਚ ਹਥਿਆਰ ਲੈ ਕੇ ਅਤੇ ਰੋਹ ਨਾਲ ਭਰ ਕੇ ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ ਆ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "आनि परे रिसि ठानि रठौर चहूँ दिस ते कर आयुध लीने ॥",
      "sourceLineId": "124200",
      "sourceShabadId": "11592",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬੀਰ ਕਰੋਰਿਨ ਕੇ ਸਿਰ ਤੋਰਿ ਸੁ ਹਾਥਨ ਕੋ ਹਲਕਾਹਿਨ ਦੀਨੇ ॥",
      "transliteration": "beer karorin ke sir tor su haathan ko halakaahin dheene ||",
      "translation": "",
      "punjabiViakhya": "ਕਰੋੜਾ ਸੂਰਮਿਆਂ ਦੇ ਸਿਰ ਤੋੜ ਕੇ ਹਾਥੀਆਂ ਨੂੰ ਘੇਰ ('ਹਲਕਾਹਿਨ') ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "बीर करोरिन के सिर तोरि सु हाथन को हलकाहिन दीने ॥",
      "sourceLineId": "124201",
      "sourceShabadId": "11592",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰੁੰਡ ਪਰੇ ਕਹੂੰ ਤੁੰਡ ਨ੍ਰਿਪਾਨ ਕੇ ਝੁੰਡ ਹਯਾਨ ਕੇ ਜਾਤ ਨ ਚੀਨੇ ॥",
      "transliteration": "ru(n)dd pare kahoo(n) tu(n)dd nirapaan ke jhu(n)dd hayaan ke jaat na cheene ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਰਾਜਿਆਂ ਦੇ ਸਿਰ ਪਏ ਹਨ ਅਤੇ ਕਿਤੇ ਧੜ ਅਤੇ ਘੋੜਿਆਂ ਦੇ ਕਿਤੇ ਝੁੰਡ ਪਏ ਸਨ ਜਿਨ੍ਰਹਾ ਨੂੰ ਪਛਾਣਿਆ ਤਕ ਨਹੀਂ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "रुँड परे कहूँ तुँड नृपान के झुँड हयान के जात न चीने ॥",
      "sourceLineId": "124202",
      "sourceShabadId": "11592",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕੰਬਰ ਕੇ ਬਹੁ ਟੰਬਰ ਅੰਬਰ ਅੰਬਰ ਛੀਨਿ ਦਿਗੰਬਰ ਕੀਨੈ ॥੨੭॥",
      "transliteration": "ka(n)bar ke bahu Ta(n)bar a(n)bar a(n)bar chheen dhiga(n)bar keenai ||27||",
      "translation": "",
      "punjabiViakhya": "ਦੁਸ਼ਾਲਿਆਂ ('ਕੰਬਰ') ਦੇ ਬਣੇ ਸੈਨਿਕ ਬਸਤ੍ਰਾ ('ਟੰਬਰ ਅੰਬਰ') ਨੂੰ ਖੋਹ ਕੇ ਅੰਬਰ ਹੀਨ ('ਦਿਗੰਬਰ') ਕੀਤਾ ਜਾ ਰਿਹਾ ਸੀ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "कंबर के बहु टंबर अंबर अंबर छीनि दिगंबर कीनै ॥२७॥",
      "sourceLineId": "124203",
      "sourceShabadId": "11592",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "124204",
      "sourceShabadId": "11593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਐਸੀ ਭਾਤਿ ਸੁ ਭਟ ਬਹੁ ਮਾਰੇ ॥",
      "transliteration": "aaisee bhaat su bhaT bahu maare ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਬਹੁਤ ਸਾਰੇ ਸੂਰਮੇ ਮਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "ऐसी भाति सु भट बहु मारे ॥",
      "sourceLineId": "124205",
      "sourceShabadId": "11593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਘੁਨਾਥੋ ਸੁਰ ਲੋਕ ਸਿਧਾਰੇ ॥",
      "transliteration": "raghunaatho sur lok sidhaare ||",
      "translation": "",
      "punjabiViakhya": "ਰਘੂਨਾਥ ਸਿੰਘ ਸਵਰਗ ਨੂੰ ਚਲੇ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "रघुनाथो सुर लोक सिधारे ॥",
      "sourceLineId": "124206",
      "sourceShabadId": "11593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸ੍ਵਾਮਿ ਕਾਜ ਕੇ ਪ੍ਰਨਹਿ ਨਿਬਾਹਿਯੋ ॥",
      "transliteration": "savaiaam kaaj ke praneh nibaahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਆਮੀ ਦੇ ਕੰਮ ਦੇ ਪ੍ਰਣ ਨੂੰ ਨਿਭਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "स्वामि काज के प्रनहि निबाहियो ॥",
      "sourceLineId": "124207",
      "sourceShabadId": "11593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਹਡਿਯਹਿ ਪੁਰੇ ਜੋਧ ਪਹੁਚਾਯੋ ॥੨੮॥",
      "transliteration": "haddiyeh pure jodh pahuchaayo ||28||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜਪੂਤਣੀਆਂ ('ਹਡਿਯਹਿ') ਨੂੰ ਜੋਧਪੁਰ ਪਹੁੰਚਾ ਦਿੱਤਾ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "हडियहि पुरे जोध पहुचायो ॥२८॥",
      "sourceLineId": "124208",
      "sourceShabadId": "11593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "124209",
      "sourceShabadId": "11594",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਤਿ ਬਰਿ ਕੈ ਭਾਰੀ ਜੁਝ੍ਰਯੋ ਤਨਕ ਨ ਮੋਰਿਯੋ ਅੰਗ ॥",
      "transliteration": "at bar kai bhaaree jujhrayo tanak na moriyo a(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਬਲ ਪੂਰਵਕ ਵੱਡਾ (ਸੂਰਮਾ) ਜੂਝ ਮਰਿਆ ਅਤੇ ਜ਼ਰਾ ਵੀ (ਯੁੱਧ-ਭੂਮੀ ਵਿਚੋਂ) ਅੰਗ ਨਹੀਂ ਮੋੜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "अति बरि कै भारी जुझ्रयो तनक न मोरियो अंग ॥",
      "sourceLineId": "124210",
      "sourceShabadId": "11594",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੁ ਕਬਿ ਕਾਲ ਪੂਰਨ ਭਯੋ ਤਬ ਹੀ ਕਥਾ ਪ੍ਰਸੰਗ ॥੨੯॥",
      "transliteration": "s kab kaal pooran bhayo tab hee kathaa prasa(n)g ||29||",
      "translation": "",
      "punjabiViakhya": "ਕਵੀ ਕਾਲ (ਕਹਿੰਦਾ ਹੈ) (ਅਰਥਾਤਰ- ਕਵੀ ਅਨੁਸਾਰ) ਉਦੋਂ ਹੀ ਕਥਾ ਪ੍ਰਸੰਗ ਪੂਰਾ ਹੋ ਗਿਆ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "सु कबि काल पूरन भयो तब ही कथा प्रसंग ॥२९॥",
      "sourceLineId": "124211",
      "sourceShabadId": "11594",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਪਚਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤ ॥੧੯੫॥੩੬੬੯॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau pachaanavo charitr samaapatam sat subham sat ||195||3669||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੯੫ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੯੫॥੩੬੬੯॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ पचानवो चरित्र समापतम सतु सुभम सत ॥१९५॥३६६९॥अफजूँ॥",
      "sourceLineId": "124212",
      "sourceShabadId": "11594",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "124213",
      "sourceShabadId": "11595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚੰਦ੍ਰਪੁਰੀ ਨਗਰੀ ਇਕ ਸੁਨੀ ॥",
      "transliteration": "cha(n)dhrapuree nagaree ik sunee ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਦ੍ਰਪੁਰੀ ਨਾ ਦੀ ਇਕ ਨਗਰੀ ਸੁਣੀਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "चंद्रपुरी नगरी इक सुनी ॥",
      "sourceLineId": "124214",
      "sourceShabadId": "11595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਪ੍ਰਤਿਮ ਕਲਾ ਰਾਨੀ ਬਹੁ ਗੁਨੀ ॥",
      "transliteration": "apratim kalaa raanee bahu gunee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੋਂ ਦੀ) ਅਪ੍ਰਤਿਮ ਕਲਾ ਨਾ ਦੀ ਰਾਣੀ ਬਹੁਤ ਗੁਣਵਾਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "अप्रतिम कला रानी बहु गुनी ॥",
      "sourceLineId": "124215",
      "sourceShabadId": "11595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅੰਜਨ ਰਾਇ ਬਿਲੋਕ੍ਯੋ ਜਬ ਹੀ ॥",
      "transliteration": "a(n)jan rai bilokayo jab hee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਜਦੋਂ ਹੀ ਅੰਜਨ ਰਾਇ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "अंजन राइ बिलोक्यो जब ही ॥",
      "sourceLineId": "124216",
      "sourceShabadId": "11595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹਰਅਰਿ ਸਰ ਮਾਰਿਯੋ ਤਿਹ ਤਬ ਹੀ ॥੧॥",
      "transliteration": "harar sar maariyo teh tab hee ||1||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਹੀ ਉਸ ਨੂੰ ਸ਼ਿਵ ਦੇ ਵੈਰੀ (ਕਾਮ ਦੇਵ) ਨੇ ਤੀਰ ਮਾਰਿਆ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "हरअरि सर मारियो तिह तब ही ॥१॥",
      "sourceLineId": "124217",
      "sourceShabadId": "11595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਾ ਕੌ ਧਾਮ ਬੋਲਿ ਕਰਿ ਲਿਯੋ ॥",
      "transliteration": "taa kau dhaam bol kar liyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਘਰ ਬੁਲਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "ता कौ धाम बोलि करि लियो ॥",
      "sourceLineId": "124218",
      "sourceShabadId": "11595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਾਮ ਕੇਲ ਤਾ ਸੌ ਦ੍ਰਿੜ ਕਿਯੋ ॥",
      "transliteration": "kaam kel taa sau dhiraR kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਚੰਗੀ ਤਰ੍ਰਹਾ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "काम केल ता सौ दृड़ कियो ॥",
      "sourceLineId": "124219",
      "sourceShabadId": "11595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਹੁਰਿ ਜਾਰ ਇਹ ਭਾਤਿ ਉਚਾਰੋ ॥",
      "transliteration": "bahur jaar ieh bhaat uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਯਾਰ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "बहुरि जार इह भाति उचारो ॥",
      "sourceLineId": "124220",
      "sourceShabadId": "11595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਿਨਿ ਮਤਿ ਲਖਿ ਪਤਿ ਹਨੈ ਤੁਮਾਰੇ ॥੨॥",
      "transliteration": "jin mat lakh pat hanai tumaare ||2||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਕਿਤੇ ਤੇਰਾ ਪਤੀ ਮੈਨੂੰ ਵੇਖ ਕੇ ਮਾਰ ਨਾ ਦੇਵੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "जिनि मति लखि पति हनै तुमारे ॥२॥",
      "sourceLineId": "124221",
      "sourceShabadId": "11595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤ੍ਰਿਯੋ ਵਾਚ ॥",
      "transliteration": "tirayo vaach ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "तृयो वाच ॥",
      "sourceLineId": "124222",
      "sourceShabadId": "11596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤੁਮ ਚਿਤ ਮੈ ਨਹਿ ਤ੍ਰਾਸ ਬਢਾਵੋ ॥",
      "transliteration": "tum chit mai neh traas baddaavo ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਚਿਤ ਵਿਚ ਡਰ ਨਾ ਮੰਨੋ",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "तुम चित मै नहि त्रास बढावो ॥",
      "sourceLineId": "124223",
      "sourceShabadId": "11596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹਮ ਸੌ ਦ੍ਰਿੜ ਕਰਿ ਕੇਲ ਕਮਾਵੋ ॥",
      "transliteration": "ham sau dhiraR kar kel kamaavo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੇ ਨਾਲ ਚੰਗੀ ਤਰ੍ਰਹਾ ਰਤੀ-ਕ੍ਰੀੜਾ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "हम सौ दृड़ करि केल कमावो ॥",
      "sourceLineId": "124224",
      "sourceShabadId": "11596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮੈ ਤੁਹਿ ਏਕ ਚਰਿਤ੍ਰ ਦਿਖੈਹੌ ॥",
      "transliteration": "mai tuh ek charitr dhikhaihau ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਤੈਨੂੰ ਇਕ ਚਰਿਤ੍ਰ ਦਸਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "मै तुहि एक चरित्र दिखैहौ ॥",
      "sourceLineId": "124225",
      "sourceShabadId": "11596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਾ ਤੇ ਤੁਮਰੋ ਸੋਕ ਮਿਟੈਹੌ ॥੩॥",
      "transliteration": "taa te tumaro sok miTaihau ||3||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਤੁਹਾਡਾ ਦੁਖ ਦੂਰ ਕਰ ਦਿਆਂਗੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "ता ते तुमरो सोक मिटैहौ ॥३॥",
      "sourceLineId": "124226",
      "sourceShabadId": "11596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "124227",
      "sourceShabadId": "11597",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪਤਿ ਦੇਖਤ ਤੋ ਸੌ ਰਮੌ ਗ੍ਰਿਹ ਕੋ ਦਰਬੁ ਲੁਟਾਇ ॥",
      "transliteration": "pat dhekhat to sau ramau gireh ko dharab luTai ||",
      "translation": "",
      "punjabiViakhya": "ਪਤੀ ਦੇ ਵੇਖਦੇ ਹੋਇਆਂ ਤੇਰੇ ਨਾਲ ਰਮਣ ਕਰਾਗੀ ਅਤੇ ਘਰ ਦਾ ਧਨ ਲੁਟਾ ਦਿਆਂਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "पति देखत तो सौ रमौ गृह को दरबु लुटाइ ॥",
      "sourceLineId": "124228",
      "sourceShabadId": "11597",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨ੍ਰਿਪ ਕੋ ਸੀਸ ਝੁਕਾਇ ਹੌ ਪਗਨ ਤਿਹਾਰੇ ਲਾਇ ॥੪॥",
      "transliteration": "nirap ko sees jhukai hau pagan tihaare lai ||4||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਰਾਜੇ ਦਾ ਸਿਰ ਤੇਰੇ ਪੈਰਾ ਉਤੇ ਝੁਕਾਵਾਗੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "नृप को सीस झुकाइ हौ पगन तिहारे लाइ ॥४॥",
      "sourceLineId": "124229",
      "sourceShabadId": "11597",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "124230",
      "sourceShabadId": "11598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤੁਮ ਸਭ ਜੋਗ ਭੇਸ ਕੌ ਕਰੋ ॥",
      "transliteration": "tum sabh jog bhes kau karo ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਮੇਰੀ ਗੱਲ ਕੰਨ ਵਿਚ ਪਾਓ",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "तुम सभ जोग भेस कौ करो ॥",
      "sourceLineId": "124231",
      "sourceShabadId": "11598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮੋਰੀ ਕਹੀ ਕਾਨ ਮੈ ਧਰੋ ॥",
      "transliteration": "moree kahee kaan mai dharo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜੋਗ ਦਾ ਸਾਰਾ ਭੇਸ ਧਾਰ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "मोरी कही कान मै धरो ॥",
      "sourceLineId": "124232",
      "sourceShabadId": "11598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮੂਕ ਮੰਤ੍ਰ ਕਛੁ ਯਾਹਿ ਸਿਖਾਵਹੁ ॥",
      "transliteration": "mook ma(n)tr kachh yaeh sikhaavahu ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਝ ਕੁ ਗੁਪਤ ('ਮੂਕ') ਮੰਤਰ ਰਾਜੇ ਨੂੰ ਸਿਖਾ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1081,
      "hindi": "",
      "hindiTransliteration": "मूक मंत्र कछु याहि सिखावहु ॥",
      "sourceLineId": "124233",
      "sourceShabadId": "11598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1081_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਾ ਤੇ ਯਾ ਕੋ ਗੁਰੂ ਕਹਾਵਹੁ ॥੫॥",
      "transliteration": "jaa te yaa ko guroo kahaavahu ||5||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ (ਤੁਸੀਂ) ਉਸ ਦੇ ਗੁਰੂ ਅਖਵਾ ਸਕੋ ॥੫॥",
      "source": "DASAM_GRANTH",
