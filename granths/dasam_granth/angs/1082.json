{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1082,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1082_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਬ ਤਿਨ ਕਾਮ ਜਾਰ ਸੋਊ ਕਿਯੋ ॥",
      "transliteration": "tab tin kaam jaar souoo kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਯਾਰ ਨੇ ਉਹੀ ਕੰਮ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "तब तिन काम जार सोऊ कियो ॥",
      "sourceLineId": "124235",
      "sourceShabadId": "11598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮੂਕ ਮੰਤ੍ਰ ਰਾਜਾ ਕੋ ਦਿਯੋ ॥",
      "transliteration": "mook ma(n)tr raajaa ko dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੂੰ ਗੁਪਤ ਮੰਤਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "मूक मंत्र राजा को दियो ॥",
      "sourceLineId": "124236",
      "sourceShabadId": "11598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਆਪਨ ਤਾ ਕੌ ਗੁਰੂ ਕਹਾਯੋ ॥",
      "transliteration": "aapan taa kau guroo kahaayo ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਆਪ ਨੂੰ ਉਸ ਦਾ ਗੁਰੂ ਅਖਵਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "आपन ता कौ गुरू कहायो ॥",
      "sourceLineId": "124237",
      "sourceShabadId": "11598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਰਾਵ ਨਹਿ ਪਾਯੋ ॥੬॥",
      "transliteration": "bhedh abhedh raav neh paayo ||6||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਭੇਦ ਅਭੇਦ ਕੁਝ ਵੀ ਨਾ ਸਮਝ ਸਕਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद राव नहि पायो ॥६॥",
      "sourceLineId": "124238",
      "sourceShabadId": "11598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਬ ਰਾਜਾ ਅੰਤਹਪੁਰ ਆਏ ॥",
      "transliteration": "jab raajaa a(n)tahapur aae ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜਾ ਰਣਵਾਸ ਵਿਚ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "जब राजा अंतहपुर आए ॥",
      "sourceLineId": "124239",
      "sourceShabadId": "11598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਯੌ ਬਚਨ ਸੁਨਾਏ ॥",
      "transliteration": "tab raanee yau bachan sunaae ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "तब रानी यौ बचन सुनाए ॥",
      "sourceLineId": "124240",
      "sourceShabadId": "11598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੁਰ ਜੁ ਭ੍ਰਮਾਵੈ ਰਾਇ ਨ ਭ੍ਰਮਿਯੈ ॥",
      "transliteration": "gur ju bhramaavai rai na bhramiyai ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਜੇ ਗੁਰੂ ਕੁਝ ਭਰਮਾਉਣਾ ਚਾਹੇ, ਤਾ ਭਰਮਣਾ ਨਹੀਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "गुर जु भ्रमावै राइ न भ्रमियै ॥",
      "sourceLineId": "124241",
      "sourceShabadId": "11598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭਲੀ ਬੁਰੀ ਗੁਰ ਕਰੇ ਸੁ ਛਮਿਯੈ ॥੭॥",
      "transliteration": "bhalee buree gur kare su chhamiyai ||7||",
      "translation": "",
      "punjabiViakhya": "ਗੁਰੂ ਜੇ ਕੋਈ ਮਾੜੀ ਚੰਗੀ ਗੱਲ ਕਰੇ ਤਾ ਉਸ ਨੂੰ ਖਿਮਾ ਕਰ ਦੇਣਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "भली बुरी गुर करे सु छमियै ॥७॥",
      "sourceLineId": "124242",
      "sourceShabadId": "11598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੋ ਗੁਰ ਗ੍ਰਿਹ ਕੋ ਦਰਬੁ ਚੁਰਾਵੈ ॥",
      "transliteration": "jo gur gireh ko dharab churaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਗੁਰੂ ਘਰ ਦਾ ਧਨ ਚੁਰਾ ਲਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "जो गुर गृह को दरबु चुरावै ॥",
      "sourceLineId": "124243",
      "sourceShabadId": "11598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੌਕ ਤ੍ਰਿਯਾ ਤਨ ਕੇਲ ਕਮਾਵੈ ॥",
      "transliteration": "sauak tirayaa tan kel kamaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਜਾ) ਸ਼ੌਕ ਨਾਲ ਇਸਤਰੀ ਨਾਲ ਕੇਲ ਕਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "सौक तृया तन केल कमावै ॥",
      "sourceLineId": "124244",
      "sourceShabadId": "11598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੋ ਕੁਪਿ ਕਰੈ ਖੜਗ ਕੋ ਵਾਰਾ ॥",
      "transliteration": "jo kup karai khaRag ko vaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਜਾ) ਕ੍ਰੋਧ ਕਰ ਕੇ ਖੜਗ ਦਾ ਵਾਰ ਕਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "जो कुपि करै खड़ग को वारा ॥",
      "sourceLineId": "124245",
      "sourceShabadId": "11598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੋ ਸਿਖ ਭ੍ਰਮਤ ਲਹੈ ਸੋ ਮਾਰਾ ॥੮॥",
      "transliteration": "jo sikh bhramat lahai so maaraa ||8||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ) ਜੋ ਸਿੱਖ ਭਰਮਾ ਗਿਆ, ਸੋ ਮਾਰਿਆ ਗਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "जो सिख भ्रमत लहै सो मारा ॥८॥",
      "sourceLineId": "124246",
      "sourceShabadId": "11598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਿਨ ਨੈ ਮੰਤ੍ਰ ਕਛੂ ਜਿਹ ਦਯੋ ॥",
      "transliteration": "jin nai ma(n)tr kachhoo jeh dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਗੁਰੂ ਨੇ ਜੇ ਕੁਝ ਮੰਤਰ ਦਿੱਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "जिन नै मंत्र कछू जिह दयो ॥",
      "sourceLineId": "124247",
      "sourceShabadId": "11598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਿਨ ਗੁਰ ਮੋਲ ਸਿਖ ਕੋ ਲਯੋ ॥",
      "transliteration": "tin gur mol sikh ko layo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਸਿੱਖ ਨੂੰ ਗੁਰੂ ਨੇ ਮੁੱਲ ਲੈ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "तिन गुर मोल सिख को लयो ॥",
      "sourceLineId": "124248",
      "sourceShabadId": "11598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਗਨਿ ਮਾਤ ਜੌ ਰਮਤ ਨਿਹਰੀਯੈ ॥",
      "transliteration": "bhagan maat jau ramat nihareeyai ||",
      "translation": "",
      "punjabiViakhya": "(ਜੇ ਉਸ ਨੂੰ) ਮਾ ਭੈਣ ਨਾਲ ਭੋਗ ਕਰਦਿਆਂ ਵੇਖ ਲਈਏ",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "भगनि मात जौ रमत निहरीयै ॥",
      "sourceLineId": "124249",
      "sourceShabadId": "11598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੀਸ ਝੁਕਾਇ ਰੋਸ ਨਹਿ ਕਰੀਯੈ ॥੯॥",
      "transliteration": "sees jhukai ros neh kareeyai ||9||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸਿਰ ਨੀਵਾ ਕਰ ਕੇ ਰੋਸ ਨਾ ਕੀਤਾ ਜਾਏ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "सीस झुकाइ रोस नहि करीयै ॥९॥",
      "sourceLineId": "124250",
      "sourceShabadId": "11598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "124251",
      "sourceShabadId": "11599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਭਾ ਪਰਬ ਭੀਤਰ ਸੁਨੀ ਜਮ ਕੀ ਕਥਾ ਰਸਾਲ ॥",
      "transliteration": "sabhaa parab bheetar sunee jam kee kathaa rasaal ||",
      "translation": "",
      "punjabiViakhya": "('ਮਹਾਭਾਰਤ' ਦੇ) ਸਭਾ ਪਰਵ ਵਿਚ ਯਮ ਦੀ ਇਕ ਰੋਚਕ ਕਥਾ ਸੁਣੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "सभा परब भीतर सुनी जम की कथा रसाल ॥",
      "sourceLineId": "124252",
      "sourceShabadId": "11599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬ੍ਰਯਾਸਾਸਿਨ ਸੁਕ ਬਕਤ੍ਰ ਤੇ ਸੋ ਤੁਹਿ ਕਹੌ ਉਤਾਲ ॥੧੦॥",
      "transliteration": "brayaasaasin suk bakatr te so tuh kahau utaal ||10||",
      "translation": "",
      "punjabiViakhya": "(ਹੇ ਰਾਜਨ!) ਬਿਆਸ ਦੇ ਆਸਣ (ਉਤੇ ਬੈਠੇ) ਸੁਕਦੇਵ ਦੇ ਮੂੰਹ (ਤੋਂ ਸੁਣ ਕੇ) ਹੁਣ ਤੁਹਾਨੂੰ ਜਲਦੀ ਕਹਿੰਦੀ ਹਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "ब्रयासासिन सुक बकत्र ते सो तुहि कहौ उताल ॥१०॥",
      "sourceLineId": "124253",
      "sourceShabadId": "11599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਮ ਰਾਜਾ ਰਿਖਿ ਏਕ ਕੋ ਘਰ ਮੈ ਕਿਯੋ ਪਯਾਨ ॥",
      "transliteration": "jam raajaa rikh ek ko ghar mai kiyo payaan ||",
      "translation": "",
      "punjabiViakhya": "ਜਮ ਰਾਜਾ ਇਕ ਰਿਸ਼ੀ ਦੇ ਘਰ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "जम राजा रिखि एक को घर मै कियो पयान ॥",
      "sourceLineId": "124254",
      "sourceShabadId": "11599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਾਤ ਭਗਨਿ ਰਿਖਿ ਬਾਲ ਸੌ ਰਤਿ ਮਾਨੀ ਰੁਚਿ ਮਾਨ ॥੧੧॥",
      "transliteration": "maat bhagan rikh baal sau rat maanee ruch maan ||11||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਰਿਸ਼ੀ ਦੀ ਮਾ, ਭੈਣ ਅਤੇ ਇਸਤਰੀ ਨਾਲ ਰੁਚੀ ਪੂਰਵਕ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "मात भगनि रिखि बाल सौ रति मानी रुचि मान ॥११॥",
      "sourceLineId": "124255",
      "sourceShabadId": "11599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "124256",
      "sourceShabadId": "11600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਬ ਰਿਖਿ ਚਲਿ ਅਪੁਨੇ ਗ੍ਰਿਹ ਆਯੋ ॥",
      "transliteration": "jab rikh chal apune gireh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਿਸ਼ੀ (ਬਾਹਰੋਂ) ਚਲ ਕੇ ਆਪਣੇ ਘਰ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "जब रिखि चलि अपुने गृह आयो ॥",
      "sourceLineId": "124257",
      "sourceShabadId": "11600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤ੍ਰਿਯ ਸੌ ਰਮਤ ਪੁਰਖ ਲਖਿ ਪਾਯੋ ॥",
      "transliteration": "tiray sau ramat purakh lakh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ (ਆਪਣੀ) ਇਸਤਰੀ ਨਾਲ ਇਕ ਪੁਰਸ਼ ਨੂੰ ਭੋਗ ਕਰਦਿਆਂ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "तृय सौ रमत पुरख लखि पायो ॥",
      "sourceLineId": "124258",
      "sourceShabadId": "11600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਧਰਮ ਬਿਚਾਰ ਨ ਤਿਹ ਕਛੁ ਕਹਿਯੋ ॥",
      "transliteration": "dharam bichaar na teh kachh kahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਮ ਅਨੁਸਾਰ (ਅਤਿਥੀ ਦੀ ਸੇਵਾ ਕਰਨ ਦਾ ਕਰਤੱਵ) ਵਿਚਾਰ ਕੇ ਉਸ ਨੂੰ ਕੁਝ ਨਾ ਕਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "धरम बिचार न तिह कछु कहियो ॥",
      "sourceLineId": "124259",
      "sourceShabadId": "11600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਿਹ ਪਗ ਮਾਥ ਛੂਆਵਨ ਚਹਿਯੋ ॥੧੨॥",
      "transliteration": "teh pag maath chhooaavan chahiyo ||12||",
      "translation": "",
      "punjabiViakhya": "(ਸਗੋਂ) ਉਸ ਦੇ ਚਰਨਾ ਨਾਲ (ਆਪਣਾ) ਮੱਥਾ ਛੋਹਣਾ ਚਾਹਿਆ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "तिह पग माथ छूआवन चहियो ॥१२॥",
      "sourceLineId": "124260",
      "sourceShabadId": "11600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਿਰ ਮੌ ਚਰਨ ਛੁਅਤ ਧਰ ਰਹਿਯੋ ॥",
      "transliteration": "sir mau charan chhuat dhar rahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਸਿਰ ਵਿਚ (ਉਸ ਦੇ) ਚਰਨ ਛੋਹਾਈ ਰਖੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "सिर मौ चरन छुअत धर रहियो ॥",
      "sourceLineId": "124261",
      "sourceShabadId": "11600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਧੰਨ੍ਯ ਧੰਨ੍ਯ ਤਾ ਕੌ ਜਮ ਕਹਿਯੋ ॥",
      "transliteration": "dha(n)nay dha(n)nay taa kau jam kahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਮ ਨੇ ਉਸ ਨੂੰ ਧੰਨ ਧੰਨ ਕਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "धंन्य धंन्य ता कौ जम कहियो ॥",
      "sourceLineId": "124262",
      "sourceShabadId": "11600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮੈ ਹੌ ਕਾਲ ਜਗਤ ਜਿਹ ਘਾਯੋ ॥",
      "transliteration": "mai hau kaal jagat jeh ghaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਹੇ ਰਿਸ਼ੀ!) ਮੈਂ ਕਾਲ ਹਾ ਜਿਸ ਨੇ ਸਾਰੇ ਜਗਤ ਨੂੰ ਮਾਰਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "मै हौ काल जगत जिह घायो ॥",
      "sourceLineId": "124263",
      "sourceShabadId": "11600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤੇਰੋ ਧਰਮ ਬਿਲੋਕਨ ਆਯੋ ॥੧੩॥",
      "transliteration": "tero dharam bilokan aayo ||13||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ ਤਾ) ਤੇਰਾ ਧਰਮ ਵੇਖਣ ਆਇਆ ਸਾ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "तेरो धरम बिलोकन आयो ॥१३॥",
      "sourceLineId": "124264",
      "sourceShabadId": "11600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੁਨਤ ਹੁਤੌ ਤੈਸੋ ਤੁਹਿ ਦੇਖਿਯੋ ॥",
      "transliteration": "sunat hutau taiso tuh dhekhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਦਾ (ਮੈਂ ਤੈਨੂੰ) ਸੁਣਿਆ ਹੈ, ਉਸੇ ਤਰ੍ਰਹਾ ਦਾ ਹੀ ਵੇਖਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "सुनत हुतौ तैसो तुहि देखियो ॥",
      "sourceLineId": "124265",
      "sourceShabadId": "11600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਧਰਮ ਸਕਲ ਤੁਮਰੌ ਅਵਰੇਖਿਯੋ ॥",
      "transliteration": "dharam sakal tumarau avarekhiyo ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਤੇਰੇ ਸਾਰੇ ਧਰਮ ਨੂੰ ਅਨੁਮਾਨ ਕਰ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "धरम सकल तुमरौ अवरेखियो ॥",
      "sourceLineId": "124266",
      "sourceShabadId": "11600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤੋਰੇ ਬਿਖੈ ਕਪਟ ਕਛੁ ਨਾਹੀ ॥",
      "transliteration": "tore bikhai kapaT kachh naahee ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਰੇ ਵਿਚ ਕਿਸੇ ਕਿਸਮ ਦਾ ਕਪਟ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "तोरे बिखै कपट कछु नाही ॥",
      "sourceLineId": "124267",
      "sourceShabadId": "11600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਯੌ ਮੈ ਲਹਿਯੋ ਸਾਚੁ ਮਨ ਮਾਹੀ ॥੧੪॥",
      "transliteration": "yau mai lahiyo saach man maahee ||14||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਗੱਲ ਮੈਂ ਮਨ ਵਿਚ ਸਚ ਕਰ ਕੇ ਮੰਨ ਲਈ ਹੈ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "यौ मै लहियो साचु मन माही ॥१४॥",
      "sourceLineId": "124268",
      "sourceShabadId": "11600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "124269",
      "sourceShabadId": "11601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਿਰਖ ਸਤਤਾ ਬਿਪ੍ਰ ਕੀ ਮਨ ਮੈ ਮੋਦ ਬਢਾਇ ॥",
      "transliteration": "nirakh satataa bipr kee man mai modh baddai ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਾਹਮਣ (ਰਿਸ਼ੀ) ਦੀ ਸਚਾਈ ਵੇਖ ਕੇ ਅਤੇ ਮਨ ਵਿਚ ਪ੍ਰਸੰਨ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "निरख सतता बिप्र की मन मै मोद बढाइ ॥",
      "sourceLineId": "124270",
      "sourceShabadId": "11601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਯਨ ਮੁਕਤਿ ਤਾ ਕੌ ਦਿਯੋ ਕਾਲ ਦਾਨ ਬਰ ਦਾਇ ॥੧੫॥",
      "transliteration": "jiyan mukat taa kau dhiyo kaal dhaan bar dhai ||15||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਨੇ ਉਸ ਨੂੰ ਜੀਵਨ-ਮੁਕਤ ਹੋਣ ਦਾ ਵਰਦਾਨ ਦਿੱਤਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "जियन मुकति ता कौ दियो काल दान बर दाइ ॥१५॥",
      "sourceLineId": "124271",
      "sourceShabadId": "11601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨ੍ਰਿਪ ਕੌ ਪ੍ਰਥਮ ਪ੍ਰਬੋਧ ਕਰਿ ਜਾਰਹਿ ਲਯੋ ਬੁਲਾਇ ॥",
      "transliteration": "nirap kau pratham prabodh kar jaareh layo bulai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ) ਰਾਜੇ ਨੂੰ ਸਮਝਾ ਕੇ ਯਾਰ ਨੂੰ ਬੁਲਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "नृप कौ प्रथम प्रबोध करि जारहि लयो बुलाइ ॥",
      "sourceLineId": "124272",
      "sourceShabadId": "11601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪ੍ਰਗਟਿ ਖਾਟ ਡਸਵਾਇ ਕੈ ਭੋਗ ਕਿਯੋ ਸੁਖ ਪਾਇ ॥੧੬॥",
      "transliteration": "pragaT khaaT ddasavai kai bhog kiyo sukh pai ||16||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਭ ਦੇ ਸਾਹਮਣੇ ਮੰਜੀ ਵਿਛਵਾ ਕੇ (ਯਾਰ ਨਾਲ) ਸੁਖ ਪੂਰਵਕ ਭੋਗ ਕੀਤਾ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "प्रगटि खाट डसवाइ कै भोग कियो सुख पाइ ॥१६॥",
      "sourceLineId": "124273",
      "sourceShabadId": "11601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "124274",
      "sourceShabadId": "11602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਬ ਲੌ ਆਪ ਰਾਵ ਜੂ ਆਯੋ ॥",
      "transliteration": "tab lau aap raav joo aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਰਾਜਾ ਆਪ ਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "तब लौ आप राव जू आयो ॥",
      "sourceLineId": "124275",
      "sourceShabadId": "11602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤ੍ਰਿਯ ਸੌ ਰਮਤ ਜਾਰ ਲਖਿ ਪਾਯੋ ॥",
      "transliteration": "tiray sau ramat jaar lakh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸਤਰੀ ਨਾਲ ਯਾਰ ਨੂੰ ਰਮਣ ਕਰਦਿਆਂ ਵੇਖ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "तृय सौ रमत जार लखि पायो ॥",
      "sourceLineId": "124276",
      "sourceShabadId": "11602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਥਾ ਸੰਭਾਰਿ ਵਹੈ ਚੁਪ ਰਹਿਯੋ ॥",
      "transliteration": "kathaa sa(n)bhaar vahai chup rahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਕਥਾ ਨੂੰ ਯਾਦ ਕਰ ਕੇ ਉਹ ਚੁਪ ਰਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "कथा संभारि वहै चुप रहियो ॥",
      "sourceLineId": "124277",
      "sourceShabadId": "11602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਿਨ ਕੌ ਕੋਪ ਬਚਨ ਨਹਿ ਕਹਿਯੋ ॥੧੭॥",
      "transliteration": "tin kau kop bachan neh kahiyo ||17||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਕ੍ਰੋਧ ਵਾਲਾ ਕੋਈ ਸ਼ਬਦ ਨਾ ਕਿਹਾ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "तिन कौ कोप बचन नहि कहियो ॥१७॥",
      "sourceLineId": "124278",
      "sourceShabadId": "11602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚਰਨ ਛੁਅਨ ਤਾ ਕੇ ਚਿਤ ਚਹਿਯੋ ॥",
      "transliteration": "charan chhuan taa ke chit chahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਚਰਨਾ ਨੂੰ ਛੋਹਣ ਦੀ ਇੱਛਾ ਕਰਨ ਲਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "चरन छुअन ता के चित चहियो ॥",
      "sourceLineId": "124279",
      "sourceShabadId": "11602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਵੈਸਹਿ ਜਾਰ ਭਜਤ ਤ੍ਰਿਯ ਰਹਿਯੋ ॥",
      "transliteration": "vaiseh jaar bhajat tiray rahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਯਾਰ ਉਸੇ ਤਰ੍ਰਹਾ ਇਸਤਰੀ ਨਾਲ ਭੋਗ ਕਰਦਾ ਰਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "वैसहि जार भजत तृय रहियो ॥",
      "sourceLineId": "124280",
      "sourceShabadId": "11602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਬ ਯੌ ਜਾਰਿ ਕਾਢਿ ਕਰਿ ਦਿਯੋ ॥",
      "transliteration": "tab yau jaar kaadd kar dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਯਾਰ ਨੇ ਉਸ ਨੂੰ ਬਾਹਰ ਕਢ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "तब यौ जारि काढि करि दियो ॥",
      "sourceLineId": "124281",
      "sourceShabadId": "11602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮੂਰਖ ਸੀਸ ਨ੍ਯਾਇ ਕਰਿ ਗਯੋ ॥੧੮॥",
      "transliteration": "moorakh sees nayai kar gayo ||18||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਸਿਰ ਨਿਵਾ ਕੇ ਚਲਾ ਗਿਆ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "मूरख सीस न्याइ करि गयो ॥१८॥",
      "sourceLineId": "124282",
      "sourceShabadId": "11602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜੜ ਜਾਨ੍ਯੋ ਮੁਹਿ ਗੁਰੂ ਭ੍ਰਮਾਯੋ ॥",
      "transliteration": "jaR jaanayo muh guroo bhramaayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਨੇ ਸਮਝਿਆ ਕਿ ਮੈਨੂੰ ਗੁਰੂ ਨੇ ਭਰਮਾਇਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "जड़ जान्यो मुहि गुरू भ्रमायो ॥",
      "sourceLineId": "124283",
      "sourceShabadId": "11602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਕਛੂ ਨਹਿ ਪਾਯੋ ॥",
      "transliteration": "bhedh abhedh kachhoo neh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੇਦ ਅਭੇਦ ਨੂੰ ਕੁਝ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद कछू नहि पायो ॥",
      "sourceLineId": "124284",
      "sourceShabadId": "11602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਅਬਲਾ ਛਲਿ ਗਈ ॥",
      "transliteration": "eeh charitr abalaa chhal giee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਚਰਿਤ੍ਰ ਨਾਲ ਇਸਤਰੀ ਨੇ ਰਾਜੇ ਨੂੰ ਛਲ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र अबला छलि गई ॥",
      "sourceLineId": "124285",
      "sourceShabadId": "11602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਰਤਿ ਕਰਿ ਮਾਥ ਟਿਕਾਵਤ ਭਈ ॥੧੯॥",
      "transliteration": "rat kar maath Tikaavat bhiee ||19||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਤੀ-ਕ੍ਰੀੜਾ ਕਰ ਕੇ (ਉਸ ਤੋਂ) ਮੱਥਾ ਟਿਕਵਾ ਦਿੱਤਾ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "रति करि माथ टिकावत भई ॥१९॥",
      "sourceLineId": "124286",
      "sourceShabadId": "11602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "124287",
      "sourceShabadId": "11603",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਪਤਿ ਦੇਖਤ ਰਤਿ ਮਾਨਿ ਕੈ ਨ੍ਰਿਪ ਕੋ ਮਾਥ ਟਿਕਾਇ ॥",
      "transliteration": "pat dhekhat rat maan kai nirap ko maath Tikai ||",
      "translation": "",
      "punjabiViakhya": "ਪਤੀ ਦੇ ਵੇਖਦੇ ਹੋਇਆਂ (ਯਾਰ ਨਾਲ) ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰ ਕੇ ਰਾਜੇ ਤੋਂ ਮੱਥਾ ਟਿਕਵਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "पति देखत रति मानि कै नृप को माथ टिकाइ ॥",
      "sourceLineId": "124288",
      "sourceShabadId": "11603",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਧਨ ਦੀਨੋ ਸਭ ਪ੍ਰੀਤਮਹਿ ਐਸੇ ਚਰਿਤ ਦਿਖਾਇ ॥੨੦॥",
      "transliteration": "dhan dheeno sabh preetameh aaise charit dhikhai ||20||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਚਰਿਤ੍ਰ ਵਿਖਾ ਕੇ ਪ੍ਰੀਤਮ ਨੂੰ ਬਹੁਤ ਸਾਰਾ ਧਨ ਦਿੱਤਾ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "धन दीनो सभ प्रीतमहि ऐसे चरित दिखाइ ॥२०॥",
      "sourceLineId": "124289",
      "sourceShabadId": "11603",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਛਿਆਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੯੬॥੩੬੮੯॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau chhiaanavo charitr samaapatam sat subham sat ||196||3689||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੯੬ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੯੬॥੩੬੮੯॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ छिआनवो चरित्र समापतम सतु सुभम सतु ॥१९६॥३६८९॥अफजूँ॥",
      "sourceLineId": "124290",
      "sourceShabadId": "11603",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "124291",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਤ੍ਰਿਯ ਰਨਰੰਗ ਮਤੀ ਇਕ ਕਹਿਯੈ ॥",
      "transliteration": "tiray ranara(n)g matee ik kahiyai ||",
      "translation": "",
      "punjabiViakhya": "ਰਨਰੰਗ ਮਤੀ ਨਾ ਦੀ ਇਕ ਇਸਤਰੀ ਦਸੀਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "तृय रनरंग मती इक कहियै ॥",
      "sourceLineId": "124292",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਤਾ ਸਮ ਅਵਰ ਨ ਰਾਨੀ ਲਹਿਯੈ ॥",
      "transliteration": "taa sam avar na raanee lahiyai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ ਕੋਈ ਹੋਰ ਰਾਣੀ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "ता सम अवर न रानी लहियै ॥",
      "sourceLineId": "124293",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਅਪ੍ਰਮਾਨ ਤਿਹ ਪ੍ਰਭਾ ਬਿਰਾਜੈ ॥",
      "transliteration": "apramaan teh prabhaa biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਬਹੁਤ ਅਧਿਕ ਸੁੰਦਰਤਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "अप्रमान तिह प्रभा बिराजै ॥",
      "sourceLineId": "124294",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਜਾ ਕੋ ਨਿਰਖ ਚੰਦ੍ਰਮਾ ਲਾਜੈ ॥੧॥",
      "transliteration": "jaa ko nirakh cha(n)dhramaa laajai ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਚੰਦ੍ਰਮਾ ਵੀ ਲਜਾਉਾਂਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "जा को निरख चंद्रमा लाजै ॥१॥",
      "sourceLineId": "124295",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਏਕ ਦੁਰਗ ਤਿਨ ਬਡੌ ਤਕਾਯੋ ॥",
      "transliteration": "ek dhurag tin baddau takaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਕ ਬਹੁਤ ਵੱਡਾ ਕਿਲ੍ਰਹਾ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "एक दुरग तिन बडौ तकायो ॥",
      "sourceLineId": "124296",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਯਹੈ ਰਾਨਿਯਹਿ ਮੰਤ੍ਰਿ ਉਪਜਾਯੋ ॥",
      "transliteration": "yahai raaniyeh ma(n)tr upajaayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਦੇ (ਮਨ ਵਿਚ) ਇਹ ਵਿਚਾਰ ਪੈਦਾ ਹੋਇਆ (ਕਿ ਇਸ ਕਿਲ੍ਰਹੇ ਨੂੰ ਹਾਸਲ ਕੀਤਾ ਜਾਏ)।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "यहै रानियहि मंतृ उपजायो ॥",
      "sourceLineId": "124297",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਡੋਰਾ ਪਾਚ ਸਹੰਸ੍ਰ ਸਵਾਰੇ ॥",
      "transliteration": "ddoraa paach saha(n)sr savaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਪੰਜ ਹਜ਼ਾਰ ਡੋਲੇ ਤਿਆਰ ਕਰਵਾ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "डोरा पाच सहंस्र सवारे ॥",
      "sourceLineId": "124298",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਤਾ ਮੈ ਪੁਰਖ ਪਾਚ ਸੈ ਡਾਰੈ ॥੨॥",
      "transliteration": "taa mai purakh paach sai ddaarai ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਵਿਚ ਪੰਜ ਸੌ ਪੁਰਸ਼ (ਸਿਪਾਹੀ) ਬਿਠਾ ਦਿੱਤੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "ता मै पुरख पाच सै डारै ॥२॥",
      "sourceLineId": "124299",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਕਛੂ ਆਪ ਕੌ ਤ੍ਰਾਸ ਜਤਾਯੋ ॥",
      "transliteration": "kachhoo aap kau traas jataayo ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣਾ ਕੁਝ ਡਰ ਪ੍ਰਗਟ ਕਰਨ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "कछू आप कौ त्रास जतायो ॥",
      "sourceLineId": "124300",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਏਕ ਦੂਤ ਦ੍ਰੁਗ ਸਾਹਿ ਪਠਾਯੋ ॥",
      "transliteration": "ek dhoot dhrug saeh paThaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਦੂਤ ਕਿਲ੍ਰਹੇ ਦੇ ਸੁਆਮੀ ਪਾਸ ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "एक दूत द्रुग साहि पठायो ॥",
      "sourceLineId": "124301",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਠਉਰ ਕਬੀਲਨ ਕੌ ਹ੍ਯਾਂ ਪਾਊ ॥",
      "transliteration": "Thaur kabeelan kau hayaa(n) paauoo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜੇ ਮੇਰੇ ਕਬੀਲੇ ਨੂੰ ਇਥੇ ਠਹਿਰਨ ਦੀ ਥਾ ਪ੍ਰਾਪਤ ਹੋ ਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "ठउर कबीलन कौ ह्याँ पाऊ ॥",
      "sourceLineId": "124302",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਮੈ ਤੁਰਕਨ ਸੌ ਖੜਗ ਬਜਾਊ ॥੩॥",
      "transliteration": "mai turakan sau khaRag bajaauoo ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮੈਂ ਤੁਰਕਾ ਨਾਲ ਚੰਗੀ ਤਰ੍ਰਹਾ ਲੋਹਾ ਲੈ ਸਕਾਗੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "मै तुरकन सौ खड़ग बजाऊ ॥३॥",
      "sourceLineId": "124303",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਤੇ ਸੁਨਿ ਬੈਨ ਭੂਲਿ ਏ ਗਏ ॥",
      "transliteration": "te sun bain bhool e ge ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਗੱਲ ਸੁਣ ਕੇ ਇਹ ਭੁਲ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "ते सुनि बैन भूलि ए गए ॥",
      "sourceLineId": "124304",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਗੜ ਮੈ ਪੈਠਨ ਡੋਰਾ ਦਏ ॥",
      "transliteration": "gaR mai paiThan ddoraa dhe ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿ ਇਸ ਵਿਚ ਵੈਰੀ ਦੀ ਕੋਈ ਚਾਲ ਹੀ ਨਾ ਹੋਵੇ)। (ਉਨ੍ਰਹਾ ਨੇ) ਕਿਲ੍ਰਹੇ ਵਿਚ ਡੋਲਿਆਂ ਨੂੰ ਵੜਨ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1082,
      "hindi": "",
      "hindiTransliteration": "गड़ मै पैठन डोरा दए ॥",
      "sourceLineId": "124305",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1082_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਕੋਟ ਦ੍ਵਾਰ ਕੇ ਜਬੈ ਉਤਰੇ ॥",
      "transliteration": "koT dhavaiaar ke jabai utare ||",
      "translation": "",
