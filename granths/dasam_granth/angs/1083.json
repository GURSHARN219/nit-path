{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1083,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1083_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਬ ਹੀ ਕਾਢਿ ਕ੍ਰਿਪਾਨੈ ਪਰੇ ॥੪॥",
      "transliteration": "tab hee kaadd kirapaanai pare ||4||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਤਲਵਾਰਾ ਖਿਚ ਕੇ ਪੈ ਗਏ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "तब ही काढि कृपानै परे ॥४॥",
      "sourceLineId": "124307",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਮੁਹ ਭਯੋ ਤਿਨ ਸੈ ਸੋ ਮਾਰਿਯੋ ॥",
      "transliteration": "samuh bhayo tin sai so maariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ ਵੀ) ਸਾਹਮਣੇ ਆਇਆ, ਉਸ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "समुह भयो तिन सै सो मारियो ॥",
      "sourceLineId": "124308",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭਾਜਿ ਚਲਿਯੋ ਸੋ ਖੇਦਿ ਨਿਕਾਰਿਯੋ ॥",
      "transliteration": "bhaaj chaliyo so khedh nikaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਭਜ ਚਲਿਆ, ਉਸ ਨੂੰ ਖਦੇੜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "भाजि चलियो सो खेदि निकारियो ॥",
      "sourceLineId": "124309",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਦੁਰਗਤਿ ਦ੍ਰੁਗ ਲਿਯੋ ॥",
      "transliteration": "eeh charitr dhuragat dhrug liyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਚਰਿਤ੍ਰ ਕਰ ਕੇ ਧੋਖੇ ਨਾਲ ਕਿਲ੍ਰਹਾ ਲੈ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र दुरगति द्रुग लियो ॥",
      "sourceLineId": "124310",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਹ ਠਾ ਹੁਕਮ ਸੁ ਆਪਨੋ ਕਿਯੋ ॥੫॥",
      "transliteration": "teh Thaa hukam su aapano kiyo ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਥੇ ਆਪਣਾ ਹੁਕਮ ਚਲਾ ਦਿੱਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "तह ठा हुकम सु आपनो कियो ॥५॥",
      "sourceLineId": "124311",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਸਤਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੯੭॥੩੬੯੪॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau sataanavo charitr samaapatam sat subham sat ||197||3694||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੯੭ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੯੭॥੩੬੯੪॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ सतानवो चरित्र समापतम सतु सुभम सतु ॥१९७॥३६९४॥अफजूँ॥",
      "sourceLineId": "124312",
      "sourceShabadId": "11604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "124313",
      "sourceShabadId": "11605",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੰਖ ਕੁਅਰ ਸੁੰਦਰਿਕ ਭਨਿਜੈ ॥",
      "transliteration": "sa(n)kh kuar su(n)dharik bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਖ ਕੁਅਰਿ ਨਾ ਦੀ ਇਕ ਸੁੰਦਰੀ ਦਸੀ ਜਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "संख कुअर सुँदरिक भनिजै ॥",
      "sourceLineId": "124314",
      "sourceShabadId": "11605",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਏਕ ਰਾਵ ਕੇ ਸਾਥ ਰਹਿਜੈ ॥",
      "transliteration": "ek raav ke saath rahijai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਕ ਰਾਜੇ ਨਾਲ ਰਹਿੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "एक राव के साथ रहिजै ॥",
      "sourceLineId": "124315",
      "sourceShabadId": "11605",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਏਕ ਬੋਲਿ ਤਬ ਸਖੀ ਪਠਾਈ ॥",
      "transliteration": "ek bol tab sakhee paThaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਤਦ ਇਕ ਸਖੀ ਨੂੰ ਬੁਲਾ ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "एक बोलि तब सखी पठाई ॥",
      "sourceLineId": "124316",
      "sourceShabadId": "11605",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੋਤ ਨਾਥ ਸੋ ਜਾਤ ਜਗਾਈ ॥੧॥",
      "transliteration": "sot naath so jaat jagaiee ||1||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਪਤੀ ਨਾਲ ਸੁਤਿਆਂ ਉਸ ਨੂੰ ਜਾ ਜਗਾਇਆ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "सोत नाथ सो जात जगाई ॥१॥",
      "sourceLineId": "124317",
      "sourceShabadId": "11605",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਾਹਿ ਜਗਾਤ ਨਾਥ ਤਿਹ ਜਾਗਿਯੋ ॥",
      "transliteration": "taeh jagaat naath teh jaagiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜਗਾਣ ਕਰ ਕੇ ਉਸ ਦਾ ਪਤੀ ਵੀ ਜਾਗ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "ताहि जगात नाथ तिह जागियो ॥",
      "sourceLineId": "124318",
      "sourceShabadId": "11605",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪੂਛਨ ਤਵਨ ਦੂਤਿਯਹਿ ਲਾਗਿਯੋ ॥",
      "transliteration": "poochhan tavan dhootiyeh laagiyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਉਸ ਦੂਤੀ ਨੂੰ ਪੂਛਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "पूछन तवन दूतियहि लागियो ॥",
      "sourceLineId": "124319",
      "sourceShabadId": "11605",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਯਾਹਿ ਜਾਤ ਲੈ ਕਹਾ ਜਗਾਈ ॥",
      "transliteration": "yaeh jaat lai kahaa jagaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਜਗਾ ਕੇ ਕਿਥੇ ਲੈ ਜਾ ਰਹੀ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "याहि जात लै कहा जगाई ॥",
      "sourceLineId": "124320",
      "sourceShabadId": "11605",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਬ ਤਿਨ ਯੌ ਤਿਹ ਸਾਥ ਜਤਾਈ ॥੨॥",
      "transliteration": "tab tin yau teh saath jataiee ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਨੇ ਉਸ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "तब तिन यौ तिह साथ जताई ॥२॥",
      "sourceLineId": "124321",
      "sourceShabadId": "11605",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮੋਰੇ ਨਾਥ ਜਨਾਨੇ ਗਏ ॥",
      "transliteration": "more naath janaane ge ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰਾ ਪਤੀ ਜ਼ਨਾਨਖ਼ਾਨੇ ਵਿਚ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "मोरे नाथ जनाने गए ॥",
      "sourceLineId": "124322",
      "sourceShabadId": "11605",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚੌਕੀ ਹਿਤਹਿ ਬੁਲਾਵਤ ਭਏ ॥",
      "transliteration": "chauakee hiteh bulaavat bhe ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਕੀਦਾਰੀ ਲਈ ਬੁਲਾਇਆ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "चौकी हितहि बुलावत भए ॥",
      "sourceLineId": "124323",
      "sourceShabadId": "11605",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾ ਤੇ ਮੈ ਲੈਨੇ ਇਹ ਆਈ ॥",
      "transliteration": "taa te mai laine ieh aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਮੈਂ ਇਸ ਨੂੰ ਲੈਣ ਲਈ ਆਈ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "ता ते मै लैने इह आई ॥",
      "sourceLineId": "124324",
      "sourceShabadId": "11605",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੋ ਤੁਮ ਸੌ ਮੈ ਭਾਖਿ ਸੁਨਾਈ ॥੩॥",
      "transliteration": "so tum sau mai bhaakh sunaiee ||3||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਮੈਂ ਤੁਹਾਨੂੰ ਸਭ ਕੁਝ ਦਸ ਦਿੱਤਾ ਹੈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "सो तुम सौ मै भाखि सुनाई ॥३॥",
      "sourceLineId": "124325",
      "sourceShabadId": "11605",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "124326",
      "sourceShabadId": "11606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੋਤ ਜਗਾਯੋ ਨਾਥ ਤਿਹ ਭੁਜ ਤਾ ਕੀ ਗਹਿ ਲੀਨ ॥",
      "transliteration": "sot jagaayo naath teh bhuj taa kee geh leen ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਪਤੀ ਨੂੰ ਸੁਤੇ ਹੋਇਆਂ ਜਗਾ ਦਿੱਤਾ ਅਤੇ ਉਸ ਦੀ ਬਾਹ ਪਕੜ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "सोत जगायो नाथ तिह भुज ता की गहि लीन ॥",
      "sourceLineId": "124327",
      "sourceShabadId": "11606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਆਨਿ ਮਿਲਾਯੋ ਨ੍ਰਿਪਤ ਸੌ ਸਕਿਯੋ ਨ ਜੜ ਕਛੁ ਚੀਨ ॥੪॥",
      "transliteration": "aan milaayo nirapat sau sakiyo na jaR kachh cheen ||4||",
      "translation": "",
      "punjabiViakhya": "ਆ ਕੇ ਰਾਜੇ ਨਾਲ ਮਿਲਾ ਦਿੱਤਾ। ਉਹ ਮੂਰਖ ਕੁਝ ਵੀ ਸਮਝ ਨਾ ਸਕਿਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "आनि मिलायो नृपत सौ सकियो न जड़ कछु चीन ॥४॥",
      "sourceLineId": "124328",
      "sourceShabadId": "11606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਅਠਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੯੮॥੩੬੯੮॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau aThaanavo charitr samaapatam sat subham sat ||198||3698||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੯੮ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੯੮॥੩੬੯੮॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ अठानवो चरित्र समापतम सतु सुभम सतु ॥१९८॥३६९८॥अफजूँ॥",
      "sourceLineId": "124329",
      "sourceShabadId": "11606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "124330",
      "sourceShabadId": "11607",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਰਤਨ ਸੈਨ ਰਾਨਾ ਰਹੈ ਗੜਿ ਚਿਤੌਰ ਕੇ ਮਾਹਿ ॥",
      "transliteration": "ratan sain raanaa rahai gaR chitauar ke maeh ||",
      "translation": "",
      "punjabiViakhya": "ਚਿਤੌੜ ਗੜ ਵਿਚ ਰਤਨ ਸੈਨ ਰਾਣਾ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "रतन सैन राना रहै गड़ि चितौर के माहि ॥",
      "sourceLineId": "124331",
      "sourceShabadId": "11607",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰੂਪ ਸੀਲ ਸੁਚਿ ਬ੍ਰਤਨ ਮੈ ਜਾ ਸਮ ਕਹ ਜਗ ਨਾਹਿ ॥੧॥",
      "transliteration": "roop seel such bratan mai jaa sam keh jag naeh ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਜਿਹਾ ਸੁੰਦਰ, ਸ਼ੀਲਵਾਨ, ਵਿਵਹਾਰ ਵਿਚ ਸੁੱਚਾ ਜਗਤ ਵਿਚ ਕੋਈ ਨਹੀਂ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "रूप सील सुचि ब्रतन मै जा सम कह जग नाहि ॥१॥",
      "sourceLineId": "124332",
      "sourceShabadId": "11607",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "124333",
      "sourceShabadId": "11608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਧਿਕ ਸੂਆ ਤਿਨ ਏਕ ਪੜਾਯੋ ॥",
      "transliteration": "adhik sooaa tin ek paRaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਕ ਤੋਤੇ ਨੂੰ ਬਹੁਤ ਪੜ੍ਰਹਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "अधिक सूआ तिन एक पड़ायो ॥",
      "sourceLineId": "124334",
      "sourceShabadId": "11608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਾਹਿ ਸਿੰਗਲਾਦੀਪ ਪਠਾਯੋ ॥",
      "transliteration": "taeh si(n)galaadheep paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸਿੰਗਲਾਦੀਪ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "ताहि सिंगलादीप पठायो ॥",
      "sourceLineId": "124335",
      "sourceShabadId": "11608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਹ ਤੇ ਏਕ ਪਦਮਿਨੀ ਆਨੀ ॥",
      "transliteration": "teh te ek padhaminee aanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੋਂ (ਉਸ ਨੇ) ਇਕ ਪਦਮਨੀ ਇਸਤਰੀ ਲਿਆਂਦੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "तह ते एक पदमिनी आनी ॥",
      "sourceLineId": "124336",
      "sourceShabadId": "11608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਾ ਕੀ ਪ੍ਰਭਾ ਨ ਜਾਤ ਬਖਾਨੀ ॥੨॥",
      "transliteration": "jaa kee prabhaa na jaat bakhaanee ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਸੁੰਦਰਤਾ ਦਾ ਬਖਾਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "जा की प्रभा न जात बखानी ॥२॥",
      "sourceLineId": "124337",
      "sourceShabadId": "11608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਬ ਵਹ ਸੁੰਦਰਿ ਪਾਨ ਚਬਾਵੈ ॥",
      "transliteration": "jab veh su(n)dhar paan chabaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਉਹ ਸੁੰਦਰੀ ਪਾਨ ਚਬਾਉਾਂਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "जब वह सुँदरि पान चबावै ॥",
      "sourceLineId": "124338",
      "sourceShabadId": "11608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦੇਖੀ ਪੀਕ ਕੰਠ ਮੈ ਜਾਵੈ ॥",
      "transliteration": "dhekhee peek ka(n)Th mai jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਪੀਕ ਉਸ ਦੇ ਗਲੇ ਵਿਚੋਂ ਲੰਘਦੀ ਦਿਸ ਪੈਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "देखी पीक कंठ मै जावै ॥",
      "sourceLineId": "124339",
      "sourceShabadId": "11608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਊਪਰ ਭਵਰ ਭ੍ਰਮਹਿ ਮਤਵਾਰੇ ॥",
      "transliteration": "uoopar bhavar bhrameh matavaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਉਤੇ) ਭੌਰੇ ਮਤਵਾਲੇ ਹੋ ਕੇ ਭੌਂਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "ऊपर भवर भ्रमहि मतवारे ॥",
      "sourceLineId": "124340",
      "sourceShabadId": "11608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨੈਨ ਜਾਨ ਦੋਊ ਬਨੇ ਕਟਾਰੇ ॥੩॥",
      "transliteration": "nain jaan dhouoo bane kaTaare ||3||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਉਸ ਦੀਆਂ) ਅੱਖਾ ਮਾਨੋ ਕਟਾਰੀਆਂ ਬਣੀਆਂ ਹੋਈਆਂ ਸਨ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "नैन जान दोऊ बने कटारे ॥३॥",
      "sourceLineId": "124341",
      "sourceShabadId": "11608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਾ ਪਰ ਰਾਵ ਅਸਕਤਿ ਅਤਿ ਭਯੋ ॥",
      "transliteration": "taa par raav asakat at bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ (ਰਤਨ ਸੈਨ) ਉਸ ਉਤੇ ਬਹੁਤ ਮੋਹਿਤ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "ता पर राव असकति अति भयो ॥",
      "sourceLineId": "124342",
      "sourceShabadId": "11608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਰਾਜ ਕਾਜ ਸਭ ਹੀ ਤਜਿ ਦਯੋ ॥",
      "transliteration": "raaj kaaj sabh hee taj dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੇ ਰਾਜ ਦਾ ਸਭ ਕੰਮ ਕਾਜ ਛਡ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "राज काज सभ ही तजि दयो ॥",
      "sourceLineId": "124343",
      "sourceShabadId": "11608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਾ ਕੀ ਨਿਰਖਿ ਪ੍ਰਭਾ ਕੌ ਜੀਵੈ ॥",
      "transliteration": "taa kee nirakh prabhaa kau jeevai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਉਸ ਦੇ ਰੂਪ ਨੂੰ ਵੇਖ ਵੇਖ ਕੇ ਜੀਉਾਂਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "ता की निरखि प्रभा कौ जीवै ॥",
      "sourceLineId": "124344",
      "sourceShabadId": "11608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਿਨੁ ਹੇਰੇ ਤਿਹ ਪਾਨ ਨ ਪੀਵੈ ॥੪॥",
      "transliteration": "bin here teh paan na peevai ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਵੇਖੇ ਬਿਨਾ ਪਾਣੀ ਵੀ ਨਾ ਪੀਂਦਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "बिनु हेरे तिह पान न पीवै ॥४॥",
      "sourceLineId": "124345",
      "sourceShabadId": "11608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "124346",
      "sourceShabadId": "11609",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰਾਘੌ ਚੇਤਨਿ ਦੋ ਹੁਤੇ ਮੰਤ੍ਰੀ ਤਾਹਿ ਅਪਾਰ ॥",
      "transliteration": "raaghau chetan dho hute ma(n)tree taeh apaar ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਘੌ ਅਤੇ ਚੇਤਨ ਨਾ ਦੇ ਉਸ ਦੇ ਦੋ ਅਤਿ ਸੂਝਵਾਨ ਮੰਤਰੀ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "राघौ चेतनि दो हुते मंत्री ताहि अपार ॥",
      "sourceLineId": "124347",
      "sourceShabadId": "11609",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਿਰਖਿ ਰਾਵ ਤਿਹ ਬਸਿ ਭਯੋ ਐਸੋ ਕਿਯੋ ਬਿਚਾਰ ॥੫॥",
      "transliteration": "nirakh raav teh bas bhayo aaiso kiyo bichaar ||5||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਸੁੰਦਰੀ ਦੇ ਵਸ ਵਿਚ ਹੋਏ ਰਾਜੇ ਨੂੰ ਵੇਖ ਕੇ ਉਨ੍ਰਹਾ ਨੇ ਵਿਚਾਰ ਕੀਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "निरखि राव तिह बसि भयो ऐसो कियो बिचार ॥५॥",
      "sourceLineId": "124348",
      "sourceShabadId": "11609",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "124349",
      "sourceShabadId": "11610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਾ ਕੀ ਪ੍ਰਤਿਮਾ ਪ੍ਰਥਮ ਬਨਾਈ ॥",
      "transliteration": "taa kee pratimaa pratham banaiee ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਉਸ ਦੀ ਮੂਰਤੀ ਬਣਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "ता की प्रतिमा प्रथम बनाई ॥",
      "sourceLineId": "124350",
      "sourceShabadId": "11610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਾ ਸਮ ਦੇਵ ਅਦੇਵ ਨ ਜਾਈ ॥",
      "transliteration": "jaa sam dhev adhev na jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਦੇਵਤੇ ਅਤੇ ਦੈਂਤ ਦੀ ਪੁੱਤਰੀ ('ਜਾਈ') ਵੀ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "जा सम देव अदेव न जाई ॥",
      "sourceLineId": "124351",
      "sourceShabadId": "11610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜੰਘਹੁ ਤੇ ਤਿਲ ਤਿਹ ਲਿਖਿ ਡਰਿਯੋ ॥",
      "transliteration": "ja(n)ghahu te til teh likh ddariyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਜੰਘ ਉਤੇ ਇਕ ਤਿਲ ਅੰਕਿਤ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "जंघहु ते तिल तिह लिखि डरियो ॥",
      "sourceLineId": "124352",
      "sourceShabadId": "11610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਤਿਭੁਤ ਕਰਮ ਮੰਤ੍ਰਿਯਨ ਕਰਿਯੋ ॥੬॥",
      "transliteration": "atibhut karam ma(n)tirayan kariyo ||6||",
      "translation": "",
      "punjabiViakhya": "ਮੰਤਰੀਆਂ ਨੇ ਇਹ ਵਿਚਿਤ੍ਰ ਕੰਮ ਕੀਤਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1083,
      "hindi": "",
      "hindiTransliteration": "अतिभुत करम मंतृयन करियो ॥६॥",
      "sourceLineId": "124353",
      "sourceShabadId": "11610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1083_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਬ ਬਚਿਤ੍ਰ ਨ੍ਰਿਪ ਚਿਤ੍ਰ ਨਿਹਾਰੈ ॥",
      "transliteration": "jab bachitr nirap chitr nihaarai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਵਿਚਿਤ੍ਰ ਚਿਤਰ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1083,
