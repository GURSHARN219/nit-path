{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1085,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1085_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤੁਮ ਹਜਰਤਿ ਸੌ ਐਸ ਉਚਰੋ ॥੧੮॥",
      "transliteration": "tum hajarat sau aais ucharo ||18||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੁਸੀਂ ਬਾਦਸ਼ਾਹ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਹੋ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "तुम हजरति सौ ऐस उचरो ॥१८॥",
      "sourceLineId": "124403",
      "sourceShabadId": "11614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਏਕ ਬਸਤ੍ਰ ਹਮਰੋ ਤੁਮ ਲੀਜੈ ॥",
      "transliteration": "ek basatr hamaro tum leejai ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਮੇਰਾ ਇਕ ਬਸਤ੍ਰ ਲੈ ਲੈਣਾ",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "एक बसत्र हमरो तुम लीजै ॥",
      "sourceLineId": "124404",
      "sourceShabadId": "11614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪ੍ਰਥਮ ਪਾਲਕੀ ਮੈ ਧਰਿ ਦੀਜੈ ॥",
      "transliteration": "pratham paalakee mai dhar dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਨੂੰ) ਪਹਿਲੀ ਪਾਲਕੀ ਵਿਚ ਰਖ ਦੇਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "प्रथम पालकी मै धरि दीजै ॥",
      "sourceLineId": "124405",
      "sourceShabadId": "11614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਾ ਪਰ ਭਵਰ ਗੁੰਜਾਰਤ ਜੈ ਹੈ ॥",
      "transliteration": "taa par bhavar gu(n)jaarat jai hai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਉਤੇ ਭੌਰੇ ਗੂੰਜਦੇ ਜਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "ता पर भवर गुँजारत जै है ॥",
      "sourceLineId": "124406",
      "sourceShabadId": "11614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਲੋਕ ਨਹਿ ਪੈ ਹੈ ॥੧੯॥",
      "transliteration": "bhedh abhedh lok neh pai hai ||19||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਦਾ) ਭੇਦ ਅਭੇਦ ਲੋਕੀਂ ਨਹੀਂ ਸਮਝ ਸਕਣਗੇ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद लोक नहि पै है ॥१९॥",
      "sourceLineId": "124407",
      "sourceShabadId": "11614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਬ ਗੋਰੈ ਬਾਦਿਲ ਸੋਈ ਕਿਯੋ ॥",
      "transliteration": "tab gorai baadhil soiee kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਗੋਰੇ ਅਤੇ ਬਾਦਲ ਨੇ ਉਹੀ ਕੁਝ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "तब गोरै बादिल सोई कियो ॥",
      "sourceLineId": "124408",
      "sourceShabadId": "11614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਿਹ ਬਿਧਿ ਮੰਤ੍ਰ ਪਦੁਮਿਨੀ ਦਿਯੋ ॥",
      "transliteration": "jeh bidh ma(n)tr padhuminee dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਪ੍ਰਕਾਰ ਪਦਮਨੀ ਨੇ ਸਮਝਾਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "जिह बिधि मंत्र पदुमिनी दियो ॥",
      "sourceLineId": "124409",
      "sourceShabadId": "11614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗੜ ਕੇ ਲਹਤ ਡੋਰਿਕਾ ਧਰੀ ॥",
      "transliteration": "gaR ke lahat ddorikaa dharee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਲ੍ਰਹੇ ਕੋਲ ਪਹੁੰਚ ਕੇ ਪਾਲਕੀਆਂ ਰਖ ਦਿੱਤੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "गड़ के लहत डोरिका धरी ॥",
      "sourceLineId": "124410",
      "sourceShabadId": "11614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪਦੁਮਿਨਿ ਅਗ੍ਰ ਪਾਲਕੀ ਕਰੀ ॥੨੦॥",
      "transliteration": "padhumin agr paalakee karee ||20||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਦਮਨੀ ਦੀ (ਮਿਥਿਆ) ਪਾਲਕੀ ਅਗੇ ਕਰ ਦਿੱਤੀ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "पदुमिनि अग्र पालकी करी ॥२०॥",
      "sourceLineId": "124411",
      "sourceShabadId": "11614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "124412",
      "sourceShabadId": "11615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪਦਮਿਨਿ ਕੇ ਪਟ ਪਰ ਘਨੇ ਭਵਰ ਕਰੈ ਗੁੰਜਾਰ ॥",
      "transliteration": "padhamin ke paT par ghane bhavar karai gu(n)jaar ||",
      "translation": "",
      "punjabiViakhya": "ਪਦਮਨੀ ਦੇ ਬਸਤ੍ਰਾ ਤੇ ਬਹੁਤ ਸਾਰੇ ਭੌਰੇ ਗੁੰਜਾਰ ਕਰਨ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "पदमिनि के पट पर घने भवर करै गुँजार ॥",
      "sourceLineId": "124413",
      "sourceShabadId": "11615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਲੋਕ ਸਭੈ ਪਦੁਮਿਨਿ ਲਖੈ ਬਸਤ੍ਰ ਨ ਸਕੈ ਬਿਚਾਰਿ ॥੨੧॥",
      "transliteration": "lok sabhai padhumin lakhai basatr na sakai bichaar ||21||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਲੋਕ (ਉਸ ਨੂੰ) ਪਦਮਨੀ (ਦੀ ਪਾਲਕੀ) ਹੀ ਸਮਝਦੇ ਅਤੇ ਬਸਤ੍ਰ ਬਾਰੇ ਵਿਚਾਰ ਤਕ ਨਾ ਕਰ ਸਕੇ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "लोक सभै पदुमिनि लखै बसत्र न सकै बिचारि ॥२१॥",
      "sourceLineId": "124414",
      "sourceShabadId": "11615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "124415",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਾ ਮੈ ਡਾਰਿ ਲੁਹਾਰਿਕ ਲਯੌ ॥",
      "transliteration": "taa mai ddaar luhaarik layau ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਿਚ ਇਕ ਲੁਹਾਰ ਬਿਠਾਇਆ ਹੋਇਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "ता मै डारि लुहारिक लयौ ॥",
      "sourceLineId": "124416",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਾ ਕੌ ਬਸਤ੍ਰ ਤਵਨ ਪਰ ਦਯੌ ॥",
      "transliteration": "taa kau basatr tavan par dhayau ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਪਦਮਨੀ ਦੇ ਬਸਤ੍ਰ ਪਾਏ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "ता कौ बसत्र तवन पर दयौ ॥",
      "sourceLineId": "124417",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਛੈਨੀ ਔਰ ਹਥੌਰਾ ਲਏ ॥",
      "transliteration": "chhainee aauar hathauaraa le ||",
      "translation": "",
      "punjabiViakhya": "ਛੈਣੀ ਅਤੇ ਹਥੌੜਾ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "छैनी और हथौरा लए ॥",
      "sourceLineId": "124418",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਵਾ ਬਢਈ ਕੇ ਕਰ ਮੋ ਦਏ ॥੨੨॥",
      "transliteration": "vaa baddiee ke kar mo dhe ||22||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਲੁਹਾਰ ਦੇ ਹੱਥ ਵਿਚ ਦੇ ਦਿੱਤੇ ਸਨ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "वा बढई के कर मो दए ॥२२॥",
      "sourceLineId": "124419",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦੂਤ ਦਿਲੀਸਹਿ ਬਚਨ ਉਚਾਰੇ ॥",
      "transliteration": "dhoot dhileeseh bachan uchaare ||",
      "translation": "",
      "punjabiViakhya": "ਦਿੱਲੀ ਦੇ ਬਾਦਸ਼ਾਹ (ਅਲਾਉੱਦੀਨ) ਨੂੰ ਦੂਤ ਨੇ ਦਸਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "दूत दिलीसहि बचन उचारे ॥",
      "sourceLineId": "124420",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗ੍ਰਿਹ ਆਵਤ ਪਦੁਮਿਨਿ ਤਿਹਾਰੇ ॥",
      "transliteration": "gireh aavat padhumin tihaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਪਦਮਨੀ ਤੁਹਾਡੇ ਘਰ ਆ ਪਹੁੰਚੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "गृह आवत पदुमिनि तिहारे ॥",
      "sourceLineId": "124421",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਾਨਾ ਸਾਥ ਪ੍ਰਥਮ ਮਿਲਿ ਆਊ ॥",
      "transliteration": "raanaa saath pratham mil aauoo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਕਿਹਾ ਹੈ ਕਿ ਮੈਂ) ਪਹਿਲਾ ਰਾਣਾ ਨੂੰ ਮਿਲ ਆਵਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "राना साथ प्रथम मिलि आऊ ॥",
      "sourceLineId": "124422",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਹੁਰਿ ਤਿਹਾਰੀ ਸੇਜ ਸੁਹਾਊ ॥੨੩॥",
      "transliteration": "bahur tihaaree sej suhaauoo ||23||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਆ ਕੇ ਤੇਰੀ ਸੇਜ ਨੂੰ ਸੁਹਾਵਣਾ ਬਣਾਵਾਗੀ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "बहुरि तिहारी सेज सुहाऊ ॥२३॥",
      "sourceLineId": "124423",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਯੌ ਕਹਿ ਬਢੀ ਤਹਾ ਚਲਿ ਗਯੋ ॥",
      "transliteration": "yau keh baddee tahaa chal gayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਕਹਿ ਕੇ ਲੁਹਾਰ ਉਥੇ (ਰਾਜਾ ਰਤਨ ਸੈਨ ਪਾਸ) ਚਲਾ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "यौ कहि बढी तहा चलि गयो ॥",
      "sourceLineId": "124424",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਾ ਕੀ ਕਟਤ ਬੇਰਿਯੈ ਭਯੋ ॥",
      "transliteration": "taa kee kaTat beriyai bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੀਆਂ ਬੇੜੀਆਂ ਕਟਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "ता की कटत बेरियै भयो ॥",
      "sourceLineId": "124425",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਿਹ ਪਾਲਕੀ ਪ੍ਰਥਮ ਬੈਠਾਯੋ ॥",
      "transliteration": "teh paalakee pratham baiThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਪਹਿਲੀ ਪਾਲਕੀ ਵਿਚ ਬਿਠਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "तिह पालकी प्रथम बैठायो ॥",
      "sourceLineId": "124426",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਇਹ ਤੇ ਓਹਿ ਡੋਰੀ ਪਹੁਚਾਯੋ ॥੨੪॥",
      "transliteration": "eeh te oh ddoree pahuchaayo ||24||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤੋਂ ਉਸ ਨੂੰ (ਦੂਜੀ) ਪਾਲਕੀ (ਵਿਚ) ਪਹੁੰਚਾਇਆ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "इह ते ओहि डोरी पहुचायो ॥२४॥",
      "sourceLineId": "124427",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਇਕ ਤੇ ਨਿਕਰਿ ਅਵਰ ਮੋ ਗਯੋ ॥",
      "transliteration": "eik te nikar avar mo gayo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣਾ) ਇਕ (ਪਾਲਕੀ) ਤੋਂ ਬਾਦ",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "इक ते निकरि अवर मो गयो ॥",
      "sourceLineId": "124428",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਨਤ ਤਹਾ ਤੇ ਨਿਕਸਤ ਭਯੋ ॥",
      "transliteration": "anat tahaa te nikasat bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰਨਾ ਵਿਚੋਂ ਨਿਕਲਦਾ ਹੋਇਆ ਉਥੋਂ ਖਿਸਕ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "अनत तहा ते निकसत भयो ॥",
      "sourceLineId": "124429",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਹ ਛਲ ਤਹਾ ਪਹੂੰਚ੍ਯੋ ਜਾਈ ॥",
      "transliteration": "eeh chhal tahaa pahoo(n)chayo jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਉਥੇ (ਆਪਣੇ ਕਿਲ੍ਰਹੇ ਵਿਚ) ਜਾ ਪਹੁੰਚਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "इह छल तहा पहूँच्यो जाई ॥",
      "sourceLineId": "124430",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਬੈ ਦੁਰਗ ਮੈ ਬਜੀ ਬਧਾਈ ॥੨੫॥",
      "transliteration": "tabai dhurag mai bajee badhaiee ||25||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕਿਲ੍ਰਹੇ ਵਿਚ ਵਧਾਈ ਦੇ ਨਗਾਰੇ ਵਜਣ ਲਗੇ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "तबै दुरग मै बजी बधाई ॥२५॥",
      "sourceLineId": "124431",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗੜ ਪਰ ਜਬੈ ਬਧਾਈ ਭਈ ॥",
      "transliteration": "gaR par jabai badhaiee bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਲੇ ਉਤੇ ਜਦ ਵਧਾਈ ਦੇ ਨਗਾਰੇ ਵਜਣ ਲਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "गड़ पर जबै बधाई भई ॥",
      "sourceLineId": "124432",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਊਅਨ ਕਾਢਿ ਕ੍ਰਿਪਾਨੈ ਲਈ ॥",
      "transliteration": "suooan kaadd kirapaanai liee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸੂਰਮਿਆਂ ਨੇ ਕ੍ਰਿਪਾਨਾ ਕਢ ਲਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "सऊअन काढि कृपानै लई ॥",
      "sourceLineId": "124433",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਾ ਪਰ ਪਹੁਚਿ ਖੜਗ ਕਹ ਝਾਰਿਯੋ ॥",
      "transliteration": "jaa par pahuch khaRag keh jhaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਉਤੇ ਪਹੁੰਚ ਕੇ ਖੜਗ ਦਾ ਵਾਰ ਕੀਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "जा पर पहुचि खड़ग कह झारियो ॥",
      "sourceLineId": "124434",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਏਕੈ ਘਾਇ ਮਾਰ ਹੀ ਡਾਰਿਯੋ ॥੨੬॥",
      "transliteration": "ekai ghai maar hee ddaariyo ||26||",
      "translation": "",
      "punjabiViakhya": "ਇਕੋ ਹੀ ਵਾਰ ਨਾਲ ਮਾਰ ਹੀ ਦਿੱਤਾ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "एकै घाइ मार ही डारियो ॥२६॥",
      "sourceLineId": "124435",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਧੁਕਿ ਧੁਕਿ ਪਰੇ ਧਰਨਿ ਭਟ ਭਾਰੇ ॥",
      "transliteration": "dhuk dhuk pare dharan bhaT bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਧਮ ਧਮ ਕਰਦੇ ਵੱਡੇ ਸੂਰਮੇ ਧਰਤੀ ਉਤੇ ਡਿਗ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "धुकि धुकि परे धरनि भट भारे ॥",
      "sourceLineId": "124436",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਨੁਕ ਕਰਵਤਨ ਬਿਰਛ ਬਿਦਾਰੇ ॥",
      "transliteration": "januk karavatan birachh bidhaare ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਆਰਿਆਂ ਨਾਲ ਬ੍ਰਿਛ ਕਟ ਕੇ ਸੁਟੇ ਜਾਦੇ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "जनुक करवतन बिरछ बिदारे ॥",
      "sourceLineId": "124437",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜੁਝਿ ਜੁਝਿ ਮਰੈ ਅਧਿਕ ਰਿਸਿ ਭਰੇ ॥",
      "transliteration": "jujh jujh marai adhik ris bhare ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬਹੁਤ ਰੋਹ ਨਾਲ ਭਰੇ ਹੋਏ ਜੂਝ ਜੂਝ ਕੇ ਮਰ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "जुझि जुझि मरै अधिक रिसि भरे ॥",
      "sourceLineId": "124438",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਹੁਰਿ ਨ ਦਿਖਯਤ ਤਾਜਿਯਨ ਚਰੇ ॥੨੭॥",
      "transliteration": "bahur na dhikhayat taajiyan chare ||27||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਨੂੰ ਫਿਰ ਘੋੜਿਆਂ ਉਤੇ ਚੜ੍ਰਹਿਆ ਹੋਇਆ ਨਹੀਂ ਵੇਖਿਆ ਗਿਆ ਸੀ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "बहुरि न दिखयत ताजियन चरे ॥२७॥",
      "sourceLineId": "124439",
      "sourceShabadId": "11616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "124440",
      "sourceShabadId": "11617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜੈਨ ਲਾਵਦੀ ਸਾਹ ਕੌ ਤਬ ਹੀ ਦਯੋ ਭਜਾਇ ॥",
      "transliteration": "jain laavadhee saeh kau tab hee dhayo bhajai ||",
      "translation": "",
      "punjabiViakhya": "ਅਲਾਉਦੀਨ ਬਾਦਸ਼ਾਹ ਨੂੰ ਤਦ ਭਜਾ ਦਿੱਤਾ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "जैन लावदी साह कौ तब ही दयो भजाइ ॥",
      "sourceLineId": "124441",
      "sourceShabadId": "11617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰਤਨ ਸੈਨ ਰਾਨਾ ਗਏ ਗੜ ਇਹ ਚਰਿਤ ਦਿਖਾਇ ॥੨੮॥",
      "transliteration": "ratan sain raanaa ge gaR ieh charit dhikhai ||28||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਹ ਚਰਿਤ੍ਰ ਵਿਖਾ ਕੇ ਰਾਣਾ ਰਤਨ ਸੈਨ ਕਿਲ੍ਰਹੇ ਵਿਚ ਪਹੁੰਚ ਗਿਆ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "रतन सैन राना गए गड़ इह चरित दिखाइ ॥२८॥",
      "sourceLineId": "124442",
      "sourceShabadId": "11617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗੋਰਾ ਬਾਦਿਲ ਕੌ ਦਿਯੋ ਅਤਿ ਧਨ ਛੋਰਿ ਭੰਡਾਰ ॥",
      "transliteration": "goraa baadhil kau dhiyo at dhan chhor bha(n)ddaar ||",
      "translation": "",
      "punjabiViakhya": "ਖ਼ਜ਼ਾਨਾ ਖੋਲ੍ਰਹ ਕੇ ਗੋਰਾ ਅਤੇ ਬਾਦਲ ਨੂੰ ਬਹੁਤ ਧਨ ਦਿੱਤਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "गोरा बादिल कौ दियो अति धन छोरि भंडार ॥",
      "sourceLineId": "124443",
      "sourceShabadId": "11617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਾ ਦਿਨ ਤੈ ਪਦੁਮਿਨਿ ਭਏ ਬਾਢੀ ਪ੍ਰੀਤਿ ਅਪਾਰ ॥੨੯॥",
      "transliteration": "taa dhin tai padhumin bhe baaddee preet apaar ||29||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਿਨ ਤੋਂ ਪਦਮਨੀ ਨਾਲ (ਰਾਣੇ ਦੀ) ਪ੍ਰੀਤ ਬਹੁਤ ਵਧ ਗਈ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "ता दिन तै पदुमिनि भए बाढी प्रीति अपार ॥२९॥",
      "sourceLineId": "124444",
      "sourceShabadId": "11617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਨਿੰਨਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੯੯॥੩੭੨੭॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe ik sau ni(n)naanavo charitr samaapatam sat subham sat ||199||3727||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੧੯੯ ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੧੯੯॥੩੭੨੭॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे इक सौ निंनानवो चरित्र समापतम सतु सुभम सतु ॥१९९॥३७२७॥अफजूँ॥",
      "sourceLineId": "124445",
      "sourceShabadId": "11617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "124446",
      "sourceShabadId": "11618",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤ੍ਰਿਗਤਿ ਦੇਸ ਏਸ੍ਵਰ ਬਡੋ ਦ੍ਰੁਗਤਿ ਸਿੰਘ ਇਕ ਭੂਪ ॥",
      "transliteration": "tiragat dhes esavair baddo dhrugat si(n)gh ik bhoop ||",
      "translation": "",
      "punjabiViakhya": "ਤ੍ਰਿਗਤ ਦੇਸ ਦਾ ਦ੍ਰੁਗਤਿ ਸਿੰਘ ਨਾ ਦਾ ਇਕ ਵੱਡਾ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "तृगति देस एस्वर बडो द्रुगति सिंघ इक भूप ॥",
      "sourceLineId": "124447",
      "sourceShabadId": "11618",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੇਗ ਤੇਗ ਪੂਰੋ ਪੁਰਖ ਸੁੰਦਰ ਕਾਮ ਸਰੂਪ ॥੧॥",
      "transliteration": "dheg teg pooro purakh su(n)dhar kaam saroop ||1||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਦੇਗ ਅਤੇ ਤੇਗ (ਦੇ ਚਲਾਣ) ਵਿਚ ਨਿਪੁਣ ਸੀ ਅਤੇ ਕਾਮ ਦੇਵ ਵਰਗਾ ਸੁੰਦਰ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "देग तेग पूरो पुरख सुँदर काम सरूप ॥१॥",
      "sourceLineId": "124448",
      "sourceShabadId": "11618",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤੋਟਕ ਛੰਦ ॥",
      "transliteration": "toTak chha(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਤੋਟਕ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 1085,
      "hindi": "",
      "hindiTransliteration": "तोटक छंद ॥",
      "sourceLineId": "124449",
      "sourceShabadId": "11619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1085_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਉਡਗਿੰਦ੍ਰ ਪ੍ਰਭਾ ਇਕ ਤਾ ਕੀ ਤ੍ਰਿਯਾ ॥",
      "transliteration": "auddagi(n)dhr prabhaa ik taa kee tirayaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਉਡਗਿੰਦ੍ਰ ਪ੍ਰਭਾ ਨਾ ਦੀ ਇਕ ਇਸਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
