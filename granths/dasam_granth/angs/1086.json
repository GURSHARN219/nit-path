{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1086,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1086_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦਿਨ ਰੈਨਿ ਭਜੈ ਮੁਖ ਜਾਸੁ ਪਿਯਾ ॥",
      "transliteration": "dhin rain bhajai mukh jaas piyaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਦਿਨ ਰਾਤ ਆਪਣੇ ਪ੍ਰਿਯ (ਦਾ ਨਾਮ) ਮੁਖ ਤੋਂ ਜਪਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "दिन रैनि भजै मुख जासु पिया ॥",
      "sourceLineId": "124451",
      "sourceShabadId": "11619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਿਸੁਨਾਥ ਪ੍ਰਭਾ ਤ੍ਰਿਯ ਔਰ ਰਹੈ ॥",
      "transliteration": "bisunaath prabhaa tiray aauar rahai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਰਾਜੇ ਦੀ) ਬਿਸੁਨਾਥ ਪ੍ਰਭਾ ਨਾ ਦੀ ਇਕ ਹੋਰ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "बिसुनाथ प्रभा तृय और रहै ॥",
      "sourceLineId": "124452",
      "sourceShabadId": "11619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਤਿ ਸੁੰਦਰ ਤਾ ਕਹ ਜਗਤ ਕਹੈ ॥੨॥",
      "transliteration": "at su(n)dhar taa keh jagat kahai ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜਗਤ ਅਤਿ ਸੁੰਦਰ ਕਹਿੰਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "अति सुँदर ता कह जगत कहै ॥२॥",
      "sourceLineId": "124453",
      "sourceShabadId": "11619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਿਸੁਨਾਥ ਪ੍ਰਭਾ ਤਨ ਪ੍ਰੀਤਿ ਰਹੈ ॥",
      "transliteration": "bisunaath prabhaa tan preet rahai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਦੀ) ਬਿਸੁਨਾਥ ਨਾਲ ਬਹੁਤ ਪ੍ਰੀਤ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "बिसुनाथ प्रभा तन प्रीति रहै ॥",
      "sourceLineId": "124454",
      "sourceShabadId": "11619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਉਡਗਿੰਦ੍ਰ ਪ੍ਰਭਾ ਇਕ ਬੈਨ ਚਹੈ ॥",
      "transliteration": "auddagi(n)dhr prabhaa ik bain chahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਡਗਿੰਦ੍ਰ ਪ੍ਰਭਾ ਤਾ ਬਸ ਇਕ ਬੋਲ ਦੀ ਹੀ ਚਾਹਵਾਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "उडगिंद्र प्रभा इक बैन चहै ॥",
      "sourceLineId": "124455",
      "sourceShabadId": "11619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਦਿਨ ਰੈਨਿ ਬਿਤੀਤ ਕਰੈ ਇਹ ਕੇ ॥",
      "transliteration": "dhin rain biteet karai ieh ke ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦਿਨ ਰਾਤ ਇਸ ਨਾਲ ਗੁਜ਼ਾਰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "दिन रैनि बितीत करै इह के ॥",
      "sourceLineId": "124456",
      "sourceShabadId": "11619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਬਹੂੰ ਗ੍ਰਿਹ ਜਾਤ ਨਹੀ ਤਿਹ ਕੇ ॥੩॥",
      "transliteration": "kabahoo(n) gireh jaat nahee teh ke ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੇ ਘਰ ਜਾਦਾ ਤਕ ਨਹੀਂ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "कबहूँ गृह जात नही तिह के ॥३॥",
      "sourceLineId": "124457",
      "sourceShabadId": "11619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "124458",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਾ ਪਰ ਸਤ੍ਰੁ ਤਵਨ ਕੋ ਧਾਯੋ ॥",
      "transliteration": "taa par satr tavan ko dhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਉਤੇ ਉਸ ਦੇ ਵੈਰੀ ਨੇ ਧਾਵਾ ਬੋਲ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "ता पर सत्रु तवन को धायो ॥",
      "sourceLineId": "124459",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦ੍ਰੁਗਤਿ ਸਿੰਘ ਦਲੁ ਲੈ ਸਮੁਹਾਯੋ ॥",
      "transliteration": "dhrugat si(n)gh dhal lai samuhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਦ੍ਰੁਗਤਿ ਸਿੰਘ ਵੀ ਦਲ ਲੈ ਕੇ ਸਾਹਮਣੇ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "द्रुगति सिंघ दलु लै समुहायो ॥",
      "sourceLineId": "124460",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਚਿਯੋ ਜੁਧ ਅਤਿ ਬਜੇ ਨਗਾਰੇ ॥",
      "transliteration": "machiyo judh at baje nagaare ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਜ਼ਿਆਦਾ ਯੁੱਧ ਮਚ ਪਿਆ ਅਤੇ ਨਗਾਰੇ ਵਜਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "मचियो जुध अति बजे नगारे ॥",
      "sourceLineId": "124461",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦੇਵ ਅਦੇਵ ਬਿਲੋਕਤ ਸਾਰੇ ॥੪॥",
      "transliteration": "dhev adhev bilokat saare ||4||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਦੇਵਤੇ ਅਤੇ ਦੈਂਤ ਵੇਖਣ ਲਗ ਗਏ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "देव अदेव बिलोकत सारे ॥४॥",
      "sourceLineId": "124462",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਉਮਡੇ ਸੂਰ ਸਿੰਘ ਜਿਮਿ ਗਾਜਹਿ ॥",
      "transliteration": "aumadde soor si(n)gh jim gaajeh ||",
      "translation": "",
      "punjabiViakhya": "ਉਮਡੇ ਹੋਏ ਸੂਰਮੇ ਸ਼ੇਰਾ ਵਾਗ ਗਜਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "उमडे सूर सिंघ जिमि गाजहि ॥",
      "sourceLineId": "124463",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੋਊ ਦਿਸਨ ਜੁਝਊਆ ਬਾਜਹਿ ॥",
      "transliteration": "dhouoo dhisan jujhuooaa baajeh ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਪੱਖਾ ਤੋਂ ਮਾਰੂ ਵਾਜੇ ਵਜਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "दोऊ दिसन जुझऊआ बाजहि ॥",
      "sourceLineId": "124464",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੋਮੁਖ ਸੰਖ ਨਿਸਾਨ ਅਪਾਰਾ ॥",
      "transliteration": "gomukh sa(n)kh nisaan apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਗੋਮੁਖ, ਸੰਖ, ਧੌਂਸੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "गोमुख संख निसान अपारा ॥",
      "sourceLineId": "124465",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਢੋਲ ਮ੍ਰਿਦੰਗ ਮੁਚੰਗ ਨਗਾਰਾ ॥੫॥",
      "transliteration": "ddol miradha(n)g mucha(n)g nagaaraa ||5||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲ, ਮ੍ਰਿਦੰਗ, ਮੁਚੰਗ, ਨਗਾਰੇ ਆਦਿ ਬਹੁਤ ਵਜਦੇ ਸਨ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "ढोल मृदंग मुचंग नगारा ॥५॥",
      "sourceLineId": "124466",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤੁਰਹੀ ਨਾਦ ਨਫੀਰੀ ਬਾਜਹਿ ॥",
      "transliteration": "turahee naadh nafeeree baajeh ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਰਹੀ, ਨਾਦ, ਨਫੀਰੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "तुरही नाद नफीरी बाजहि ॥",
      "sourceLineId": "124467",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮੰਦਲ ਤੂਰ ਉਤੰਗ ਬਿਰਾਜਹਿ ॥",
      "transliteration": "ma(n)dhal toor uta(n)g biraajeh ||",
      "translation": "",
      "punjabiViakhya": "ਮੰਦਲ, ਤੂਰ, ਉਤੰਗ,",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "मंदल तूर उतंग बिराजहि ॥",
      "sourceLineId": "124468",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮੁਰਲੀ ਝਾਝ ਭੇਰ ਰਨ ਭਾਰੀ ॥",
      "transliteration": "muralee jhaajh bher ran bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਰਲੀ, ਝਾਝ, ਭੇਰ ਆਦਿ ਬਹੁਤ ਵਾਜੇ ਵਜਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "मुरली झाझ भेर रन भारी ॥",
      "sourceLineId": "124469",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੁਨਤ ਨਾਦ ਧੁਨਿ ਹਠੇ ਹਕਾਰੀ ॥੬॥",
      "transliteration": "sunat naadh dhun haThe hakaaree ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਨ੍ਰਹਾ ਦਾ) ਨਾਦ ਸੁਣ ਕੇ ਹਠੀਲੇ (ਸੂਰਮੇ) ਲਲਕਾਰੇ ਮਾਰਦੇ ਸਨ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "सुनत नाद धुनि हठे हकारी ॥६॥",
      "sourceLineId": "124470",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜੁਗਨਿ ਦੈਤ ਅਧਿਕ ਹਰਖਾਨੇ ॥",
      "transliteration": "jugan dhait adhik harakhaane ||",
      "translation": "",
      "punjabiViakhya": "ਜੋਗਣਾ ਅਤੇ ਦੈਂਤ ਬਹੁਤ ਖ਼ੁਸ਼ ਹੋ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "जुगनि दैत अधिक हरखाने ॥",
      "sourceLineId": "124471",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗੀਧ ਸਿਵਾ ਫਿਕਰਹਿ ਅਭਿਮਾਨੈ ॥",
      "transliteration": "geedh sivaa fikareh abhimaanai ||",
      "translation": "",
      "punjabiViakhya": "ਗਿਰਝਾ ਅਤੇ ਸਿਵਾ (ਗਿਦੜੀਆਂ) ਅਭਿਮਾਨ ਸਹਿਤ ਹੁੰਕਾਰ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "गीध सिवा फिकरहि अभिमानै ॥",
      "sourceLineId": "124472",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭੂਤ ਪ੍ਰੇਤ ਨਾਚਹਿ ਅਰੁ ਗਾਵਹਿ ॥",
      "transliteration": "bhoot pret naacheh ar gaaveh ||",
      "translation": "",
      "punjabiViakhya": "ਭੂਤ, ਪ੍ਰੇਤ ਨਚਦੇ ਅਤੇ ਗਾਉਾਂਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "भूत प्रेत नाचहि अरु गावहि ॥",
      "sourceLineId": "124473",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਹੂੰ ਰੁਦ੍ਰ ਡਮਰੂ ਡਮਕਾਵਹਿ ॥੭॥",
      "transliteration": "kahoo(n) rudhr ddamaroo ddamakaaveh ||7||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਰੁਦ੍ਰ ਡਮਰੂ ਨੂੰ ਵਜਾ ਰਿਹਾ ਸੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "कहूँ रुद्र डमरू डमकावहि ॥७॥",
      "sourceLineId": "124474",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਚਿ ਅਚਿ ਰੁਧਰ ਡਾਕਨੀ ਡਹਕਹਿ ॥",
      "transliteration": "ach ach rudhar ddaakanee ddahakeh ||",
      "translation": "",
      "punjabiViakhya": "ਡਾਕਣੀਆਂ ਲਹੂ ਪੀ ਪੀ ਕੇ ਡਕਾਰ ਰਹੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "अचि अचि रुधर डाकनी डहकहि ॥",
      "sourceLineId": "124475",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭਖਿ ਭਖਿ ਅਮਿਖ ਕਾਕ ਕਹੂੰ ਕਹਕਹਿ ॥",
      "transliteration": "bhakh bhakh amikh kaak kahoo(n) kahakeh ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਾ ਮਾਸ ਖਾ ਖਾ ਕੇ ਕਾ-ਕਾ ਕਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "भखि भखि अमिख काक कहूँ कहकहि ॥",
      "sourceLineId": "124476",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੰਬੁਕ ਗੀਧ ਮਾਸੁ ਲੈ ਜਾਹੀ ॥",
      "transliteration": "ja(n)buk geedh maas lai jaahee ||",
      "translation": "",
      "punjabiViakhya": "ਗਿਦੜ ਅਤੇ ਗਿੱਧਾ ਮਾਸ ਲੈ ਜਾ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "जंबुक गीध मासु लै जाही ॥",
      "sourceLineId": "124477",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਛੁ ਕਛੁ ਸਬਦ ਬਿਤਾਲ ਸੁਨਾਹੀ ॥੮॥",
      "transliteration": "kachh kachh sabadh bitaal sunaahee ||8||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਕਿਤੇ ਬਿਤਾਲਾ ਦੇ ਸ਼ਬਦ ਸੁਣਾਈ ਪੈਂਦੇ ਸਨ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "कछु कछु सबद बिताल सुनाही ॥८॥",
      "sourceLineId": "124478",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਝਮਕੈ ਕਹੂੰ ਅਸਿਨ ਕੀ ਧਾਰਾ ॥",
      "transliteration": "jhamakai kahoo(n) asin kee dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਤਲਵਾਰਾ ਦੀਆਂ ਧਾਰਾ ਲਿਸ਼ਕ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "झमकै कहूँ असिन की धारा ॥",
      "sourceLineId": "124479",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭਭਕਹਿ ਰੁੰਡ ਮੁੰਡ ਬਿਕਰਾਰਾ ॥",
      "transliteration": "bhabhakeh ru(n)dd mu(n)dd bikaraaraa ||",
      "translation": "",
      "punjabiViakhya": "ਭਿਆਨਕ ਸਿਰ ਅਤੇ ਧੜ ਭਕ ਭਕ ਕਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "भभकहि रुँड मुँड बिकरारा ॥",
      "sourceLineId": "124480",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਧੁਕਿ ਧੁਕਿ ਪਰੇ ਧਰਨਿ ਭਟ ਭਾਰੇ ॥",
      "transliteration": "dhuk dhuk pare dharan bhaT bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਧੁਕ ਧੁਕ ਕਰਦੇ ਵੱਡੇ ਸੂਰਮੇ ਧਰਤੀ ਉਤੇ ਡਿਗ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "धुकि धुकि परे धरनि भट भारे ॥",
      "sourceLineId": "124481",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਝੁਕਿ ਝੁਕਿ ਬਡੇ ਪਖਰਿਯਾ ਮਾਰੇ ॥੯॥",
      "transliteration": "jhuk jhuk badde pakhariyaa maare ||9||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਸਾਰੇ ਘੋੜ ਸਵਾਰਾ ਨੂੰ ਝੁਕ ਝੁਕ ਕੇ ਮਾਰਿਆ ਜਾ ਰਿਹਾ ਸੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "झुकि झुकि बडे पखरिया मारे ॥९॥",
      "sourceLineId": "124482",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਠਿਲਾ ਠਿਲੀ ਬਰਛਨਿ ਸੌ ਮਾਚੀ ॥",
      "transliteration": "Thilaa Thilee barachhan sau maachee ||",
      "translation": "",
      "punjabiViakhya": "ਬਰਛਿਆਂ ਦੀ ਠੇਲ ਠਾਲ ਹੋ ਰਹੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "ठिला ठिली बरछनि सौ माची ॥",
      "sourceLineId": "124483",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਢਾ ਕਢੀ ਕਰਵਾਰਿਨ ਰਾਚੀ ॥",
      "transliteration": "kaddaa kaddee karavaarin raachee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤਲਵਾਰਾ ਕਢ ਕਢ ਕੇ ਚਲਾਈਆਂ ਜਾ ਰਹੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "कढा कढी करवारिन राची ॥",
      "sourceLineId": "124484",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਟਾ ਕਟੀ ਕਹੂੰ ਭਈ ਕਟਾਰੀ ॥",
      "transliteration": "kaTaa kaTee kahoo(n) bhiee kaTaaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਕਟਾਰਾ ਨਾਲ ਕਟਾ ਕਟੀ (ਇਤਨੀ) ਹੋਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "कटा कटी कहूँ भई कटारी ॥",
      "sourceLineId": "124485",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਧਰਨੀ ਅਰੁਨ ਭੇਸ ਭਈ ਸਾਰੀ ॥੧੦॥",
      "transliteration": "dharanee arun bhes bhiee saaree ||10||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਸਾਰੀ ਧਰਤੀ ਲਾਲ ਰੰਗ ਦੀ ਹੋ ਗਈ ਹੈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "धरनी अरुन भेस भई सारी ॥१०॥",
      "sourceLineId": "124486",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਾਢੇ ਦੈਤ ਦਾਤ ਕਹੂੰ ਫਿਰੈਂ ॥",
      "transliteration": "kaadde dhait dhaat kahoo(n) firai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਦੈਂਤ ਦੰਦ ਕਢ ਕੇ ਫਿਰ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "काढे दैत दात कहूँ फिरैं ॥",
      "sourceLineId": "124487",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਰਿ ਬਰਿ ਕਹੂੰ ਬਰੰਗਨ ਬਰੈਂ ॥",
      "transliteration": "bar bar kahoo(n) bara(n)gan barai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਅਪੱਛਰਾਵਾ ਚੰਗੇ ਸੂਰਮਿਆਂ ਨੂੰ ਵਰ ਰਹੀਆ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "बरि बरि कहूँ बरंगन बरैं ॥",
      "sourceLineId": "124488",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਭੀਖਨ ਭਏ ਨਾਦ ਕਹੂੰ ਭਾਰੇ ॥",
      "transliteration": "bheekhan bhe naadh kahoo(n) bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਭਿਆਨਕ ਨਾਦ ਹੋ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "भीखन भए नाद कहूँ भारे ॥",
      "sourceLineId": "124489",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭੈਰਵਾਦਿ ਛਬਿ ਲਖਨ ਸਿਧਾਰੇ ॥੧੧॥",
      "transliteration": "bhairavaadh chhab lakhan sidhaare ||11||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਭੈਰੋਂ ਆਦਿ (ਯੁੱਧ ਦੀ) ਛਬੀ ਵੇਖਣ ਲਈ ਆ ਪਹੁੰਚੇ ਹਨ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "भैरवादि छबि लखन सिधारे ॥११॥",
      "sourceLineId": "124490",
      "sourceShabadId": "11620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "124491",
      "sourceShabadId": "11621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭਕਭਕਾਹਿ ਘਾਯਲ ਕਹੂੰ ਕਹਕੈ ਅਮਿਤ ਮਸਾਨ ॥",
      "transliteration": "bhakabhakaeh ghaayal kahoo(n) kahakai amit masaan ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਘਾਇਲਾ (ਦੇ ਜ਼ਖ਼ਮ) ਭਕ ਭਕ ਕਰ ਰਹੇ ਹਨ ਅਤੇ ਕਿਤੇ ਬੇਸ਼ੁਮਾਰ ਮਸਾਣ (ਪ੍ਰੇਤ) ਕਹਿਕੇ ਮਾਰ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "भकभकाहि घायल कहूँ कहकै अमित मसान ॥",
      "sourceLineId": "124492",
      "sourceShabadId": "11621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਿਕਟਿ ਸੁਭਟ ਚਟਪਟ ਕਟੇ ਤਨ ਬ੍ਰਿਨ ਬਹੈ ਕ੍ਰਿਪਾਨ ॥੧੨॥",
      "transliteration": "bikaT subhaT chaTapaT kaTe tan biran bahai kirapaan ||12||",
      "translation": "",
      "punjabiViakhya": "ਕਠੋਰ ਸੂਰਮੇ ਝਟਪਟ ਕ੍ਰਿਪਾਨਾ ਨਾਲ ਸ਼ਰੀਰ ਕਟ ਰਹੇ ਹਨ ਅਤੇ ਜ਼ਖ਼ਮਾ (ਵਿਚੋਂ ਲਹੂ) ਵਗ ਰਿਹਾ ਹੈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "बिकटि सुभट चटपट कटे तन बृन बहै कृपान ॥१२॥",
      "sourceLineId": "124493",
      "sourceShabadId": "11621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "124494",
      "sourceShabadId": "11622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭੈਰਵ ਕਹੂੰ ਅਧਿਕ ਭਵਕਾਰੈ ॥",
      "transliteration": "bhairav kahoo(n) adhik bhavakaarai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਭੈਰੋ ਬਹੁਤ ਭਭਕਾ ਮਾਰ ਰਹੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "भैरव कहूँ अधिक भवकारै ॥",
      "sourceLineId": "124495",
      "sourceShabadId": "11622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਹੂੰ ਮਸਾਨ ਕਿਲਕਟੀ ਮਾਰੈ ॥",
      "transliteration": "kahoo(n) masaan kilakaTee maarai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਮਸਾਣ ਕਿਲਕਾਰੀਆਂ ਮਾਰ ਰਹੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "कहूँ मसान किलकटी मारै ॥",
      "sourceLineId": "124496",
      "sourceShabadId": "11622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭਾ ਭਾ ਬਜੇ ਭੇਰ ਕਹੂੰ ਭੀਖਨ ॥",
      "transliteration": "bhaa bhaa baje bher kahoo(n) bheekhan ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਭਿਆਨਕ ਭੇਰੀਆਂ ਭਾ ਭਾ ਕਰ ਕੇ ਵਜਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "भा भा बजे भेर कहूँ भीखन ॥",
      "sourceLineId": "124497",
      "sourceShabadId": "11622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1086_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਨਿ ਧਨੁ ਤਜਹਿ ਸੁਭਟ ਸਰ ਤੀਖਨ ॥੧੩॥",
      "transliteration": "tan dhan tajeh subhaT sar teekhan ||13||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸੂਰਮੇ ਧਨੁਸ਼ ਖਿਚ ਕੇ ਤਿਖੇ ਤੀਰ ਛਡ ਰਹੇ ਹਨ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1086,
      "hindi": "",
      "hindiTransliteration": "तनि धनु तजहि सुभट सर तीखन ॥१३॥",
      "sourceLineId": "124498",
      "sourceShabadId": "11622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
