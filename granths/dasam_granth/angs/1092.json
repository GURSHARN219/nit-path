{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1092,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1092_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "124763",
      "sourceShabadId": "11658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਰਾਕਸੁਰ ਰਾਜਾ ਬਡੋ ਗੂਆਹਟੀ ਕੋ ਰਾਇ ॥",
      "transliteration": "naraakasur raajaa baddo gooaahaTee ko rai ||",
      "translation": "",
      "punjabiViakhya": "ਨਰਕਾਸੁਰ ਨਾ ਦਾ ਗੁਹਾਟੀ ਦਾ ਵੱਡਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "नराकसुर राजा बडो गूआहटी को राइ ॥",
      "sourceLineId": "124764",
      "sourceShabadId": "11658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜੀਤਿ ਜੀਤਿ ਰਾਜਾਨ ਕੀ ਦੁਹਿਤਾ ਲੇਤ ਛਿਨਾਇ ॥੧॥",
      "transliteration": "jeet jeet raajaan kee dhuhitaa let chhinai ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰਾਜਿਆਂ ਨੂੰ ਜਿਤ ਜਿਤ ਕੇ ਉਨ੍ਰਹਾ ਦੀਆਂ ਪੁੱਤਰੀਆਂ ਨੂੰ ਖੋਹ ਲੈਂਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "जीति जीति राजान की दुहिता लेत छिनाइ ॥१॥",
      "sourceLineId": "124765",
      "sourceShabadId": "11658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "124766",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਿਨ ਇਕ ਬਿਵਤ ਜਗ੍ਯ ਕੋ ਕੀਨੋ ॥",
      "transliteration": "tin ik bivat jagay ko keeno ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਕ ਯੱਗ ਦੀ ਵਿਉਾਂਤ ਬਣਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "तिन इक बिवत जग्य को कीनो ॥",
      "sourceLineId": "124767",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਏਕ ਲਛ ਰਾਜਾ ਗਹਿ ਲੀਨੋ ॥",
      "transliteration": "ek lachh raajaa geh leeno ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਲੱਖ ਰਾਜਿਆਂ ਨੂੰ ਫੜ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "एक लछ राजा गहि लीनो ॥",
      "sourceLineId": "124768",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜੌ ਇਕ ਔਰ ਬੰਦ ਨ੍ਰਿਪ ਪਰੈ ॥",
      "transliteration": "jau ik aauar ba(n)dh nirap parai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਇਕ ਹੋਰ ਰਾਜਾ ਪਕੜਿਆ ਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "जौ इक और बंद नृप परै ॥",
      "sourceLineId": "124769",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਿਨ ਨ੍ਰਿਪ ਮੇਧ ਜਗ੍ਯ ਕਰਿ ਬਰੈ ॥੨॥",
      "transliteration": "tin nirap medh jagay kar barai ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਵੱਡਾ ਨ੍ਰਿਪ-ਮੇਧ ਯਗ ਕਰੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "तिन नृप मेध जग्य करि बरै ॥२॥",
      "sourceLineId": "124770",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪ੍ਰਥਮ ਕੋਟ ਲੋਹਾ ਕੋ ਰਾਜੈ ॥",
      "transliteration": "pratham koT lohaa ko raajai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਪਹਿਲਾ ਕਿਲ੍ਰਹਾ ਲੋਹੇ ਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "प्रथम कोट लोहा को राजै ॥",
      "sourceLineId": "124771",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੁਤਿਯ ਤਾਬ੍ਰ ਕੇ ਦੁਰਗ ਬਿਰਾਜੈ ॥",
      "transliteration": "dhutiy taabr ke dhurag biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਦੂਜਾ ਤਾਬੇ ਦਾ ਦੁਰਗ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "दुतिय ताब्र के दुरग बिराजै ॥",
      "sourceLineId": "124772",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤੀਜੋ ਅਸਟ ਧਾਮ ਗੜ ਸੋਹੈ ॥",
      "transliteration": "teejo asaT dhaam gaR sohai ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਜਾ ਅੱਠ ਧਾਤਾ ਦਾ ਬਣਿਆ ਹੋਇਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "तीजो असट धाम गड़ सोहै ॥",
      "sourceLineId": "124773",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਚੌਥ ਸਿਕਾ ਕੋ ਕਿਲੋ ਕਰੋਹੈ ॥੩॥",
      "transliteration": "chauath sikaa ko kilo karohai ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੌਥਾ ਕਿਲ੍ਰਹਾ ਸਿਕੇ ਦਾ ਬਣਿਆ ਹੋਇਆ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "चौथ सिका को किलो करोहै ॥३॥",
      "sourceLineId": "124774",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਹੁਰਿ ਫਟਕ ਕੋ ਕੋਟ ਬਨਾਯੋ ॥",
      "transliteration": "bahur faTak ko koT banaayo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਉਸ ਨੇ ਸਫਟਿਕ ਦਾ ਕਿਲ੍ਰਹਾ ਬਣਵਾਇਆ ਹੋਇਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "बहुरि फटक को कोट बनायो ॥",
      "sourceLineId": "124775",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਿਹ ਲਖਿ ਰੁਦ੍ਰਾਚਲ ਸਿਰ ਨ੍ਯਾਯੋ ॥",
      "transliteration": "jeh lakh rudhraachal sir nayaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਕੈਲਾਸ਼ ਪਰਬਤ ('ਰੁਦ੍ਰਾਚਲ') ਵੀ ਸਿਰ ਨਿਵਾਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "जिह लखि रुद्राचल सिर न्यायो ॥",
      "sourceLineId": "124776",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਖਸਟਮ ਦੁਰਗ ਰੁਕਮ ਕੋ ਸੋਹੈ ॥",
      "transliteration": "khasaTam dhurag rukam ko sohai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਛੇਵਾ ਕਿਲ੍ਰਹਾ ਚਾਦੀ ਦਾ ਸ਼ੋਭਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "खसटम दुरग रुकम को सोहै ॥",
      "sourceLineId": "124777",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਾ ਕੇ ਤੀਰ ਬ੍ਰਹਮਪੁਰ ਕੋਹੈ ॥੪॥",
      "transliteration": "jaa ke teer brahamapur kohai ||4||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਸਾਹਮਣੇ ਬ੍ਰਹਮਪੁਰੀ ਵੀ ਕੋਈ ਚੀਜ਼ ਨਹੀਂ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "जा के तीर ब्रहमपुर कोहै ॥४॥",
      "sourceLineId": "124778",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਪਤਮ ਗੜ ਸੋਨਾ ਕੋ ਰਾਜੈ ॥",
      "transliteration": "sapatam gaR sonaa ko raajai ||",
      "translation": "",
      "punjabiViakhya": "ਸੱਤਵਾ ਕਿਲ੍ਰਹਾ ਸੋਨੇ ਦਾ ਸੀ ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "सपतम गड़ सोना को राजै ॥",
      "sourceLineId": "124779",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਾ ਕੋ ਲੰਕ ਬੰਕ ਲਖਿ ਲਾਜੈ ॥",
      "transliteration": "jaa ko la(n)k ba(n)k lakh laajai ||",
      "translation": "",
      "punjabiViakhya": "ਲੰਕਾ ਦਾ ਸੁੰਦਰ ਕਿਲ੍ਰਹਾ ਵੀ ਲਜਾਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "जा को लंक बंक लखि लाजै ॥",
      "sourceLineId": "124780",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਾ ਕੇ ਮਧ੍ਯ ਆਪੁ ਨ੍ਰਿਪ ਰਹੈ ॥",
      "transliteration": "taa ke madhay aap nirap rahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਿਚ ਰਾਜਾ ਆਪ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "ता के मध्य आपु नृप रहै ॥",
      "sourceLineId": "124781",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਆਨਿ ਨ ਮਾਨੈ ਜੋ ਤਿਹ ਗਹੈ ॥੫॥",
      "transliteration": "aan na maanai jo teh gahai ||5||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਉਸ ਦੀ ਈਨ ਨਹੀਂ ਮੰਨਦਾ ਸੀ, ਉਸ ਨੂੰ ਪਕੜ ਲੈਂਦਾ ਸੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "आनि न मानै जो तिह गहै ॥५॥",
      "sourceLineId": "124782",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜੌ ਨ੍ਰਿਪ ਔਰ ਹਾਥ ਤਿਹ ਆਵੈ ॥",
      "transliteration": "jau nirap aauar haath teh aavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਉਸ ਦੇ ਹੱਥ ਕੋਈ ਇਕ ਹੋਰ ਰਾਜਾ ਚੜ੍ਰਹ ਜਾਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "जौ नृप और हाथ तिह आवै ॥",
      "sourceLineId": "124783",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਬ ਵਹੁ ਸਭ ਰਾਜਾ ਕਹ ਘਾਵੈ ॥",
      "transliteration": "tab vahu sabh raajaa keh ghaavai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਸਾਰਿਆਂ ਰਾਜਿਆਂ ਨੂੰ ਮਾਰ ਕੇ (ਯੱਗ ਕਰੇ)।",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "तब वहु सभ राजा कह घावै ॥",
      "sourceLineId": "124784",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੋਰਹ ਸਹਸ ਰਾਨਿਯਨ ਬਰੈ ॥",
      "transliteration": "soreh sahas raaniyan barai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਹ ਸੋਲਹਾ ਹਜ਼ਾਰ ਰਾਣੀਆਂ ਨਾਲ ਵਿਆਹ ਕਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "सोरह सहस रानियन बरै ॥",
      "sourceLineId": "124785",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਰਾਮੇਧ ਨ੍ਰਿਪ ਪੂਰਨ ਕਰੈ ॥੬॥",
      "transliteration": "naraamedh nirap pooran karai ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ 'ਨਰਮੇਧ ਯੱਗ' ਪੂਰਾ ਕਰੇ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "नरामेध नृप पूरन करै ॥६॥",
      "sourceLineId": "124786",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਇਕ ਰਾਨੀ ਯੌ ਬਚਨ ਉਚਾਰਾ ॥",
      "transliteration": "eik raanee yau bachan uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਰਾਣੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "इक रानी यौ बचन उचारा ॥",
      "sourceLineId": "124787",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦ੍ਵਾਰਾਵਤਿ ਉਗ੍ਰੇਸੁਜਿਆਰਾ ॥",
      "transliteration": "dhavaiaaraavat ugresujiaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਦ੍ਵਾਰਾਵਤੀ ਵਿਚ ਇਕ ਉਗ੍ਰਸੈਨ ('ਉਗ੍ਰੇਸ') ਨਾ ਦਾ ਪ੍ਰਤਾਪੀ ਰਾਜਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "द्वारावति उग्रेसुजिआरा ॥",
      "sourceLineId": "124788",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੌ ਤੂ ਤਾਹਿ ਜੀਤਿ ਕੈ ਲ੍ਯਾਵੈ ॥",
      "transliteration": "jau too taeh jeet kai layaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੂੰ ਉਸ ਨੂੰ ਜਿੱਤ ਕੇ ਲਿਆਵੇਾਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "जौ तू ताहि जीति कै ल्यावै ॥",
      "sourceLineId": "124789",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਬ ਯਹ ਹੋਮ ਜਗ੍ਯ ਨ੍ਰਿਪ ਪਾਵੈ ॥੭॥",
      "transliteration": "tab yeh hom jagay nirap paavai ||7||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਹ ਨ੍ਰਿਪ-ਯੱਗ ਪੂਰਾ ਹੋਵੇਗਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "तब यह होम जग्य नृप पावै ॥७॥",
      "sourceLineId": "124790",
      "sourceShabadId": "11659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "124791",
      "sourceShabadId": "11660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਯੌ ਕਹਿ ਕੈ ਰਾਜਾ ਭਏ ਪਤਿਯਾ ਲਿਖੀ ਬਨਾਇ ॥",
      "transliteration": "yau keh kai raajaa bhe patiyaa likhee banai ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਕਹਿ ਕੇ ਰਾਜੇ ਵਲੋਂ (ਉਸ ਨੂੰ) ਚਿੱਠੀ ਲਿਖ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "यौ कहि कै राजा भए पतिया लिखी बनाइ ॥",
      "sourceLineId": "124792",
      "sourceShabadId": "11660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਹਾ ਕ੍ਰਿਸਨ ਬੈਠੇ ਹੁਤੇ ਦੀਨੀ ਤਹਾ ਪਠਾਇ ॥੮॥",
      "transliteration": "jahaa kirasan baiThe hute dheenee tahaa paThai ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਥੇ ਕ੍ਰਿਸ਼ਨ ਬੈਠੇ ਸਨ, ਉਥੇ ਭੇਜ ਦਿੱਤੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "जहा कृसन बैठे हुते दीनी तहा पठाइ ॥८॥",
      "sourceLineId": "124793",
      "sourceShabadId": "11660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "124794",
      "sourceShabadId": "11661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬੈਠੇ ਕਹਾ ਕ੍ਰਿਸਨ ਬਡਭਾਗੀ ॥",
      "transliteration": "baiThe kahaa kirasan baddabhaagee ||",
      "translation": "",
      "punjabiViakhya": "(ਚਿੱਠੀ ਵਿਚ ਲਿਖਿਆ) ਹੇ ਵਡਭਾਗੀ ਕ੍ਰਿਸ਼ਨ ਜੀ! (ਤੁਸੀਂ) ਕਿਥੇ ਬੈਠ ਰਹੇ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "बैठे कहा कृसन बडभागी ॥",
      "sourceLineId": "124795",
      "sourceShabadId": "11661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤੁਮ ਸੌ ਡੀਠਿ ਹਮਾਰੀ ਲਾਗੀ ॥",
      "transliteration": "tum sau ddeeTh hamaaree laagee ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਹਾਡੇ ਵਲ ਸਾਡੀ ਨਜ਼ਰ ਟਿੱਕੀ ਹੋਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "तुम सौ डीठि हमारी लागी ॥",
      "sourceLineId": "124796",
      "sourceShabadId": "11661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਇਹ ਨ੍ਰਿਪ ਘਾਇ ਨ੍ਰਿਪਾਨ ਛੁਰੈਯੈ ॥",
      "transliteration": "eeh nirap ghai nirapaan chhuraiyai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਰਾਜੇ ਨੂੰ ਮਾਰ ਕੇ (ਹੋਰਨਾ) ਰਾਜਿਆਂ ਨੂੰ ਛੁੜਵਾਓ",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "इह नृप घाइ नृपान छुरैयै ॥",
      "sourceLineId": "124797",
      "sourceShabadId": "11661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹਮ ਸਭਹਿਨਿ ਬਰਿ ਘਰ ਲੈ ਜੈਯੈ ॥੯॥",
      "transliteration": "ham sabhahin bar ghar lai jaiyai ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਸਾ ਸਾਰੀਆਂ ਨੂੰ ਵਰ ਕੇ ਘਰ ਲੈ ਜਾਓ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "हम सभहिनि बरि घर लै जैयै ॥९॥",
      "sourceLineId": "124798",
      "sourceShabadId": "11661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜੌ ਜਬ ਬੈਨ ਕ੍ਰਿਸਨ ਸੁਨਿ ਪਾਯੋ ॥",
      "transliteration": "jau jab bain kirasan sun paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਚਿੱਠੀ ਵਿਚ ਲਿਖੇ) ਬੋਲ ਕ੍ਰਿਸ਼ਨ ਨੇ ਸੁਣੇ",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "जौ जब बैन कृसन सुनि पायो ॥",
      "sourceLineId": "124799",
      "sourceShabadId": "11661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਗਰੁੜ ਚੜੇ ਗਰੁੜਾਧ੍ਵਜ ਆਯੋ ॥",
      "transliteration": "garuR chaRe garuRaadhavaij aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਗਰੁੜ ਦੀ ਸਵਾਰੀ ਕਰਨ ਵਾਲੇ (ਭਗਵਾਨ) ਗਰੁੜ ਉਤੇ ਚੜ੍ਰਹ ਕੇ ਆ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "गरुड़ चड़े गरुड़ाध्वज आयो ॥",
      "sourceLineId": "124800",
      "sourceShabadId": "11661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪ੍ਰਥਮ ਕੋਟ ਲੋਹਾ ਕੇ ਤੋਰਿਯੋ ॥",
      "transliteration": "pratham koT lohaa ke toriyo ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ (ਉਨ੍ਰਹਾ ਨੇ) ਲੋਹੇ ਦਾ ਕਿਲ੍ਰਹਾ ਤੋੜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "प्रथम कोट लोहा के तोरियो ॥",
      "sourceLineId": "124801",
      "sourceShabadId": "11661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਮੁਹਿ ਭਏ ਤਾ ਕੋ ਸਿਰ ਫੋਰਿਯੋ ॥੧੦॥",
      "transliteration": "samuh bhe taa ko sir foriyo ||10||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸਾਹਮਣੇ ਆਇਆ ਉਸ ਦਾ ਸਿਰ ਪਾੜ ਦਿੱਤਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "समुहि भए ता को सिर फोरियो ॥१०॥",
      "sourceLineId": "124802",
      "sourceShabadId": "11661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਹੁਰੌ ਦੁਰਗ ਤਾਬ੍ਰ ਕੋ ਲੀਨੋ ॥",
      "transliteration": "bahurau dhurag taabr ko leeno ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਤਾਬੇ ਦਾ ਕਿਲ੍ਰਹਾ ਜਿਤਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "बहुरौ दुरग ताब्र को लीनो ॥",
      "sourceLineId": "124803",
      "sourceShabadId": "11661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਸਟ ਧਾਤਿ ਪੁਨਿ ਗੜ ਬਸਿ ਕੀਨੋ ॥",
      "transliteration": "asaT dhaat pun gaR bas keeno ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ ਅੱਠਾ ਧਾਤਾ ਵਾਲਾ ਕਿਲ੍ਰਹਾ ਆਪਣੇ ਅਧੀਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "असट धाति पुनि गड़ बसि कीनो ॥",
      "sourceLineId": "124804",
      "sourceShabadId": "11661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਹੁਰਿ ਸਿਕਾ ਕੋ ਕੋਟ ਛਿਨਾਯੋ ॥",
      "transliteration": "bahur sikaa ko koT chhinaayo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਸਿਕੇ ਦਾ ਕਿਲ੍ਰਹਾ ਜਿਤਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "बहुरि सिका को कोट छिनायो ॥",
      "sourceLineId": "124805",
      "sourceShabadId": "11661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਹੁਰਿ ਫਟਕ ਕੋ ਕਿਲੋ ਗਿਰਾਯੋ ॥੧੧॥",
      "transliteration": "bahur faTak ko kilo giraayo ||11||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤੋਂ ਬਾਦ ਸਫਟਿਕ ਦਾ ਕਿਲ੍ਰਹਾ ਢਾਹ ਢੇਰੀ ਕਰ ਦਿੱਤਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "बहुरि फटक को किलो गिरायो ॥११॥",
      "sourceLineId": "124806",
      "sourceShabadId": "11661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਬ ਹੀ ਰੁਕਮ ਕੋਟ ਕੌ ਲਾਗਿਯੋ ॥",
      "transliteration": "jab hee rukam koT kau laagiyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਚਾਦੀ ਦੇ ਕਿਲ੍ਰਹੇ ਨੂੰ ਲਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "जब ही रुकम कोट कौ लागियो ॥",
      "sourceLineId": "124807",
      "sourceShabadId": "11661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਬ ਨ੍ਰਿਪ ਸਕਲ ਸਸਤ੍ਰ ਗਹਿ ਜਾਗਿਯੋ ॥",
      "transliteration": "tab nirap sakal sasatr geh jaagiyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਾਜੇ ਨੇ ਜਾਗ ਕੇ ਸਾਰੇ ਸ਼ਸਤ੍ਰ ਧਾਰਨ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "तब नृप सकल ससत्र गहि जागियो ॥",
      "sourceLineId": "124808",
      "sourceShabadId": "11661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਕਲ ਸੈਨ ਲੀਨੇ ਸੰਗ ਆਯੋ ॥",
      "transliteration": "sakal sain leene sa(n)g aayo ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਸੈਨਾ ਨਾਲ ਲੈ ਕੇ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "सकल सैन लीने संग आयो ॥",
      "sourceLineId": "124809",
      "sourceShabadId": "11661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1092_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮਹਾ ਕੋਪ ਕਰਿ ਨਾਦਿ ਬਜਾਯੋ ॥੧੨॥",
      "transliteration": "mahaa kop kar naadh bajaayo ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਨਾਦ ਵਜਾਇਆ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1092,
      "hindi": "",
      "hindiTransliteration": "महा कोप करि नादि बजायो ॥१२॥",
      "sourceLineId": "124810",
      "sourceShabadId": "11661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
