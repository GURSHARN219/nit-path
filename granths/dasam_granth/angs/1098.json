{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1098,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1098_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਛਾਡਿ ਕੈ ਸੋਕ ਤ੍ਰਿਲੋਕੀ ਕੇ ਲੋਕ ਬਿਲੋਕਿ ਪ੍ਰਭਾ ਸਭ ਹੀ ਬਲਿ ਜਾਵੈ ॥੭॥",
      "transliteration": "chhaadd kai sok tiralokee ke lok bilok prabhaa sabh hee bal jaavai ||7||",
      "translation": "",
      "punjabiViakhya": "ਤਿੰਨਾ ਲੋਕਾ ਦੇ ਲੋਗ ਦੁਖਾ ਨੂੰ ਛਡ ਕੇ (ਉਨ੍ਰਹਾ ਦੀ) ਸੁੰਦਰਤਾ ਨੂੰ ਵੇਖ ਕੇ ਬਲਿਹਾਰੇ ਜਾਦੇ ਸਨ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "छाडि कै सोक तृलोकी के लोक बिलोकि प्रभा सभ ही बलि जावै ॥७॥",
      "sourceLineId": "125075",
      "sourceShabadId": "11699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕੋਕ ਕੀ ਰੀਤਿ ਸੋ ਪ੍ਰੀਤਿ ਕਰੈ ਸੁਭ ਕਾਮ ਕਲੋਲ ਅਮੋਲ ਕਮਾਵੈ ॥",
      "transliteration": "kok kee reet so preet karai subh kaam kalol amol kamaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਕੋਕ ਸ਼ਾਸਤ੍ਰ ਦੀ ਵਿਧੀ ਅਨੁਸਾਰ ਪ੍ਰੀਤ ਕਰਦੇ ਸਨ ਅਤੇ ਅਨੇਕ ਤਰ੍ਰਹਾ ਦੇ ਚੰਗੇ ਕਾਮ ਕਲੋਲ ਕਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "कोक की रीति सो प्रीति करै सुभ काम कलोल अमोल कमावै ॥",
      "sourceLineId": "125076",
      "sourceShabadId": "11699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਾਰਹਿ ਬਾਰ ਰਮੈ ਰੁਚਿ ਸੋ ਦੋਊ ਹੇਰਿ ਪ੍ਰਭਾ ਤਨ ਕੀ ਬਲਿ ਜਾਵੈ ॥",
      "transliteration": "baareh baar ramai ruch so dhouoo her prabhaa tan kee bal jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਬਾਰ ਬਾਰ ਰੁਚੀ ਪੂਰਵਕ ਰਮਣ ਕਰਦੇ ਸਨ। ਉਨ੍ਰਹਾ ਦੇ ਸ਼ਰੀਰਾ ਦੀ ਸੁੰਦਰਤਾ ਨੂੰ ਵੇਖ ਕੇ ਬਲਿਹਾਰੇ ਜਾਈਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "बारहि बार रमै रुचि सो दोऊ हेरि प्रभा तन की बलि जावै ॥",
      "sourceLineId": "125077",
      "sourceShabadId": "11699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬੀਰੀ ਚਬਾਇ ਸਿੰਗਾਰ ਬਨਾਇ ਸੁ ਨੈਨ ਨਚਾਇ ਮਿਲੈ ਮੁਸਕਾਵੈ ॥",
      "transliteration": "beeree chabai si(n)gaar banai su nain nachai milai musakaavai ||",
      "translation": "",
      "punjabiViakhya": "ਪਾਨ ਚਬਾ ਕੇ, ਸ਼ਿੰਗਾਰ ਕਰ ਕੇ ਅਤੇ ਅੱਖਾ ਮਟਕਾ ਕੇ ਮਿਲਦੇ ਅਤੇ ਹਸਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "बीरी चबाइ सिंगार बनाइ सु नैन नचाइ मिलै मुसकावै ॥",
      "sourceLineId": "125078",
      "sourceShabadId": "11699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਾਨਹੁ ਬੀਰ ਜੁਟੇ ਰਨ ਮੈ ਸਿਤ ਤਾਨਿ ਕਮਾਨਨ ਬਾਨ ਚਲਾਵੈ ॥੮॥",
      "transliteration": "maanahu beer juTe ran mai sit taan kamaanan baan chalaavai ||8||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਦੋ ਸੂਰਮੇ ਰਣ ਵਿਚ ਜੁਟੇ ਹੋਣ ਅਤੇ ਤਣ ਕੇ ਕਮਾਨਾ ਤੋਂ ਤਿਖੇ ਤੀਰ ਚਲਾਉਾਂਦੇ ਹੋਣ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "मानहु बीर जुटे रन मै सित तानि कमानन बान चलावै ॥८॥",
      "sourceLineId": "125079",
      "sourceShabadId": "11699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "125080",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਐਸੀ ਪ੍ਰੀਤਿ ਦੁਹੁਨ ਮੈ ਭਈ ॥",
      "transliteration": "aaisee preet dhuhun mai bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਵਿਚ ਅਜਿਹਾ ਪਿਆਰ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "ऐसी प्रीति दुहुन मै भई ॥",
      "sourceLineId": "125081",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਿਸਰਿ ਲੋਕ ਕੀ ਲਜਾ ਗਈ ॥",
      "transliteration": "bisar lok kee lajaa giee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ (ਉਨ੍ਰਹਾ ਨੂੰ) ਲੋਕ ਲਾਜ ਵੀ ਭੁਲ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "बिसरि लोक की लजा गई ॥",
      "sourceLineId": "125082",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨੋਖੋ ਨੇਹ ਨਿਗੋਡੋ ਲਾਗੋ ॥",
      "transliteration": "nokho neh nigoddo laago ||",
      "translation": "",
      "punjabiViakhya": "ਅਜਿਹਾ ਭੈੜਾ ਅਨੋਖਾ ਪਿਆਰ ਲਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "नोखो नेह निगोडो लागो ॥",
      "sourceLineId": "125083",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਾ ਤੇ ਨੀਂਦ ਭੂਖਿ ਦੋਊ ਭਾਗੋ ॥੯॥",
      "transliteration": "jaa te nee(n)dh bhookh dhouoo bhaago ||9||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਨੀਂਦਰ ਅਤੇ ਭੁਖ ਦੋਵੇਾਂ ਭਜ ਗਏ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "जा ते नींद भूखि दोऊ भागो ॥९॥",
      "sourceLineId": "125084",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਤ੍ਰਿਯ ਮੀਤ ਬੁਲਾਯੋ ॥",
      "transliteration": "ek dhivas tiray meet bulaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਇਸਤਰੀ ਨੇ ਮਿਤਰ ਨੂੰ ਬੁਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "एक दिवस तृय मीत बुलायो ॥",
      "sourceLineId": "125085",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੋਤ ਸੰਗਿ ਸਵਤਨਿਨ ਤਕਾਯੋ ॥",
      "transliteration": "sot sa(n)g savatanin takaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨਾਲ) ਸੁੱਤੀ ਹੋਈ ਨੂੰ ਸੌਂਕਣਾ ਨੇ ਵੇਖ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "सोत संगि सवतनिन तकायो ॥",
      "sourceLineId": "125086",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭੇਵ ਰਛਪਾਲਨ ਕੋ ਦੀਨੋ ॥",
      "transliteration": "bhev rachhapaalan ko dheeno ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ ਇਹ) ਭੇਦ ਪਹਿਰੇਦਾਰਾ ਨੂੰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "भेव रछपालन को दीनो ॥",
      "sourceLineId": "125087",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਿਨ ਕੋ ਕੋਪ ਆਤਮਾ ਕੀਨੋ ॥੧੦॥",
      "transliteration": "tin ko kop aatamaa keeno ||10||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਮਨ ਵਿਚ ਬਹੁਤ ਕ੍ਰੋਧ ਪੈਦਾ ਕੀਤਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "तिन को कोप आतमा कीनो ॥१०॥",
      "sourceLineId": "125088",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਛਪਾਲ ਕ੍ਰੁਧਿਤ ਅਤਿ ਭਏ ॥",
      "transliteration": "rachhapaal krudhit at bhe ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਰੇਦਾਰ ਬਹੁਤ ਕ੍ਰੋਧਿਤ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "रछपाल क्रुधित अति भए ॥",
      "sourceLineId": "125089",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰਾਨੀ ਹੁਤੀ ਤਹੀ ਤੇ ਗਏ ॥",
      "transliteration": "raanee hutee tahee te ge ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਥੇ ਰਾਣੀ ਸੀ, ਉਥੇ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "रानी हुती तही ते गए ॥",
      "sourceLineId": "125090",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਾਰ ਸਹਿਤ ਤਾ ਕੋ ਲਹਿ ਲੀਨੋ ॥",
      "transliteration": "jaar sahit taa ko leh leeno ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਯਾਰ ਸਹਿਤ ਪਕੜ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "जार सहित ता को लहि लीनो ॥",
      "sourceLineId": "125091",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਿਵਤ ਹਨਨ ਦੁਹੂੰਅਨ ਕੌ ਕੀਨੋ ॥੧੧॥",
      "transliteration": "bivat hanan dhuhoo(n)an kau keeno ||11||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੂੰ ਮਾਰਨ ਦੀ ਯੋਜਨਾ ਬਣਾਈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "बिवत हनन दुहूँअन कौ कीनो ॥११॥",
      "sourceLineId": "125092",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਇਹ ਭਾਤਿ ਉਚਾਰੀ ॥",
      "transliteration": "tab raanee ieh bhaat uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "तब रानी इह भाति उचारी ॥",
      "sourceLineId": "125093",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੁਨੋ ਰਛਕੋ ਬਾਤ ਹਮਾਰੀ ॥",
      "transliteration": "suno rachhako baat hamaaree ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਹਿਰੇਦਾਰੋ! ਮੇਰੀ ਗੱਲ ਸੁਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "सुनो रछको बात हमारी ॥",
      "sourceLineId": "125094",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮੀਤ ਮਰੇ ਨ੍ਰਿਪ ਤ੍ਰਿਯ ਮਰਿ ਜੈ ਹੈ ॥",
      "transliteration": "meet mare nirap tiray mar jai hai ||",
      "translation": "",
      "punjabiViakhya": "ਮਿਤਰ ਦੇ ਮਰਨ ਨਾਲ ਰਾਣੀ ਵੀ ਮਰ ਜਾਵੇਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "मीत मरे नृप तृय मरि जै है ॥",
      "sourceLineId": "125095",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤ੍ਰਿਯਾ ਮਰੈ ਰਾਜਾ ਕੋ ਛੈ ਹੈ ॥੧੨॥",
      "transliteration": "tirayaa marai raajaa ko chhai hai ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਦੇ ਮਰਨ ਨਾਲ ਰਾਜਾ ਵੀ ਮਰ ਜਾਏਗਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "तृया मरै राजा को छै है ॥१२॥",
      "sourceLineId": "125096",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦੋ ਕੁਕਟ ਕੁਕਟੀ ਮੰਗਵਾਈ ॥",
      "transliteration": "dho kukaT kukaTee ma(n)gavaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਦੋ ਕੁਕੜ ਅਤੇ ਕੁਕੜੀਆਂ ਮੰਗਵਾਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "दो कुकट कुकटी मंगवाई ॥",
      "sourceLineId": "125097",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਖਿਯਹਿ ਬੋਲ ਤਿਨੈ ਬਿਖੁ ਖ੍ਵਾਈ ॥",
      "transliteration": "sakhiyeh bol tinai bikh khavaiaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਖੀਆਂ ਨੂੰ ਕਹਿ ਕੇ ਉਨ੍ਰਹਾ ਨੂੰ ਜ਼ਹਿਰ ਖਵਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "सखियहि बोल तिनै बिखु ख्वाई ॥",
      "sourceLineId": "125098",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਿਕਟ ਆਪਨੈ ਦੁਹੁਅਨ ਆਨੋ ॥",
      "transliteration": "nikaT aapanai dhuhuan aano ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੋਹਾ ਨੂੰ ਆਪਣੇ ਕੋਲ ਮੰਗਵਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "निकट आपनै दुहुअन आनो ॥",
      "sourceLineId": "125099",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੂੜ ਰਛਕਨ ਚਰਿਤ ਨ ਜਾਨੋ ॥੧੩॥",
      "transliteration": "mooR rachhakan charit na jaano ||13||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਮੂਰਖ ਪਹਿਰੇਦਾਰ ਚਰਿਤ੍ਰ ਨੂੰ ਸਮਝ ਨਾ ਸਕੇ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "मूड़ रछकन चरित न जानो ॥१३॥",
      "sourceLineId": "125100",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪ੍ਰਥਮ ਮਾਰਿ ਕੁਕਟ ਕੋ ਦਯੋ ॥",
      "transliteration": "pratham maar kukaT ko dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਕੁਕੜ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "प्रथम मारि कुकट को दयो ॥",
      "sourceLineId": "125101",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕੁਕਟੀ ਕੋ ਬਿਨੁ ਬਧ ਬਧ ਭਯੋ ॥",
      "transliteration": "kukaTee ko bin badh badh bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਕੜੀ ਬਿਨਾ ਮਾਰਿਆਂ ਹੀ ਮਰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "कुकटी को बिनु बध बध भयो ॥",
      "sourceLineId": "125102",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਹੁਰਿ ਨਾਸ ਕੁਕਟੀ ਕੋ ਭਯੋ ॥",
      "transliteration": "bahur naas kukaTee ko bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਕੁਕੜੀ ਦਾ ਨਾਸ਼ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "बहुरि नास कुकटी को भयो ॥",
      "sourceLineId": "125103",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪਲਕ ਬਿਖੈ ਕੁਕਟੋ ਮਰਿ ਗਯੋ ॥੧੪॥",
      "transliteration": "palak bikhai kukaTo mar gayo ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਛਿਣ ਭਰ ਵਿਚ ਕੁਕੜ ਵੀ ਮਰ ਗਿਆ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "पलक बिखै कुकटो मरि गयो ॥१४॥",
      "sourceLineId": "125104",
      "sourceShabadId": "11700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਨੀ ਬਾਚ ॥",
      "transliteration": "raanee baach ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "रानी बाच ॥",
      "sourceLineId": "125105",
      "sourceShabadId": "11701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਨਹੁ ਲੋਗ ਮੈ ਤੁਮੈ ਸੁਨਾਊ ॥",
      "transliteration": "sanahu log mai tumai sunaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਲੋਕੋ! ਸੁਣੋ, ਮੈਂ ਤੁਹਾਨੂੰ ਸੁਣਾਉਾਂਦੀ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "सनहु लोग मै तुमै सुनाऊ ॥",
      "sourceLineId": "125106",
      "sourceShabadId": "11701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਿਤ੍ਰ ਮਰੇ ਮੈ ਪ੍ਰਾਨ ਗਵਾਊ ॥",
      "transliteration": "mitr mare mai praan gavaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਮਿਤਰ ਮਰਨ ਨਾਲ ਮੈਂ ਪ੍ਰਾਣ ਤਿਆਗ ਦਿਆਂਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "मित्र मरे मै प्रान गवाऊ ॥",
      "sourceLineId": "125107",
      "sourceShabadId": "11701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮੋਹਿ ਮਰੇ ਰਾਜਾ ਮਰਿ ਜੈ ਹੈ ॥",
      "transliteration": "moh mare raajaa mar jai hai ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਮਰਨ ਨਾਲ ਰਾਜਾ ਮਰ ਜਾਏਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "मोहि मरे राजा मरि जै है ॥",
      "sourceLineId": "125108",
      "sourceShabadId": "11701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤੁਮਰੇ ਕਹੋ ਹਾਥ ਕਾ ਐ ਹੈ ॥੧੫॥",
      "transliteration": "tumare kaho haath kaa aai hai ||15||",
      "translation": "",
      "punjabiViakhya": "(ਦਸੋ ਭਲਾ) ਤੁਹਾਡੇ ਹੱਥ ਕੀ ਆਏਗਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "तुमरे कहो हाथ का ऐ है ॥१५॥",
      "sourceLineId": "125109",
      "sourceShabadId": "11701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹੋ ਰਾਜਾ ਜੌ ਜਿਯਤ ਉਬਰਿ ਹੈ ॥",
      "transliteration": "ho raajaa jau jiyat ubar hai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਰਾਜਾ ਜੀਉਾਂਦਾ ਰਹੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "हो राजा जौ जियत उबरि है ॥",
      "sourceLineId": "125110",
      "sourceShabadId": "11701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤੁਮਰੀ ਸਦਾ ਪਾਲਨਾ ਕਰਿ ਹੈ ॥",
      "transliteration": "tumaree sadhaa paalanaa kar hai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਤੁਹਾਡੀ ਸਦਾ ਪਾਲਨਾ ਕਰੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "तुमरी सदा पालना करि है ॥",
      "sourceLineId": "125111",
      "sourceShabadId": "11701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੋ ਨ੍ਰਿਪ ਤ੍ਰਿਯ ਜੁਤ ਸ੍ਵਰਗ ਸਿਧੈ ਹੈ ॥",
      "transliteration": "jo nirap tiray jut savairag sidhai hai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਰਾਜਾ ਇਸਤਰੀ ਸਮੇਤ ਮਰ ਜਾਏਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "जो नृप तृय जुत स्वरग सिधै है ॥",
      "sourceLineId": "125112",
      "sourceShabadId": "11701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤੁਮ ਧਨ ਤੇ ਵੈ ਜਿਯਤੇ ਜੈ ਹੈ ॥੧੬॥",
      "transliteration": "tum dhan te vai jiyate jai hai ||16||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਤੁਸੀਂ ਵੀ ਉਸ ਧਨ ਤੋਂ ਜੀਉਾਂਦੇ ਜੀ ਵਾਝੇ ਹੋ ਜਾਓਗੇ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "तुम धन ते वै जियते जै है ॥१६॥",
      "sourceLineId": "125113",
      "sourceShabadId": "11701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਾ ਤੇ ਕ੍ਯੋਨ ਨ ਦਰਬੁ ਅਤਿ ਲੀਜੈ ॥",
      "transliteration": "taa te kayon na dharab at leejai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਤੁਸੀਂ ਕਿਉਾਂ ਨਾ ਅਧਿਕ ਧਨ ਲੈ ਲਵੋ",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "ता ते क्योन न दरबु अति लीजै ॥",
      "sourceLineId": "125114",
      "sourceShabadId": "11701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਿਹੂੰ ਜਿਯਨ ਕੀ ਰਛਾ ਕੀਜੈ ॥",
      "transliteration": "tihoo(n) jiyan kee rachhaa keejai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤਿੰਨਾ ਜੀਵਾ ਦੀ ਰਖਿਆ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "तिहूँ जियन की रछा कीजै ॥",
      "sourceLineId": "125115",
      "sourceShabadId": "11701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜੜਨ ਕੁਕਟ ਕੋ ਚਰਿਤ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "jaRan kukaT ko charit nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ) ਮੂਰਖਾ ਨੇ ਕੁਕੜਾ ਦਾ ਚਰਿਤ੍ਰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "जड़न कुकट को चरित निहारियो ॥",
      "sourceLineId": "125116",
      "sourceShabadId": "11701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਾਰ ਸਹਿਤ ਰਾਨੀਯਹਿ ਨ ਮਾਰਿਯੋ ॥੧੭॥",
      "transliteration": "jaar sahit raaneeyeh na maariyo ||17||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਯਾਰ ਸਹਿਤ ਰਾਣੀ ਨੂੰ ਨਾ ਮਾਰਿਆ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "जार सहित रानीयहि न मारियो ॥१७॥",
      "sourceLineId": "125117",
      "sourceShabadId": "11701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "125118",
      "sourceShabadId": "11702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਸਕਮਤੀ ਇਹ ਛਲ ਭਏ ਕੁਕਟ ਕੁਕਟਿਯਹਿ ਘਾਇ ॥",
      "transliteration": "eisakamatee ieh chhal bhe kukaT kukaTiyeh ghai ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਕੜ ਅਤੇ ਕੁਕੜੀ ਨੂੰ ਮਾਰ ਕੇ ਇਸ਼ਕ ਮਤੀ ਨੇ ਇਹ ਚਰਿਤ੍ਰ ਵਿਖਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "इसकमती इह छल भए कुकट कुकटियहि घाइ ॥",
      "sourceLineId": "125119",
      "sourceShabadId": "11702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪ੍ਰਾਨ ਉਬਾਰਿਯੋ ਪ੍ਰਿਯ ਸਹਿਤ ਨ੍ਰਿਪ ਡਰ ਜੜਨ ਦਿਖਾਇ ॥੧੮॥",
      "transliteration": "praan ubaariyo piray sahit nirap ddar jaRan dhikhai ||18||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਮੂਰਖਾ ਨੂੰ ਰਾਜੇ (ਦੇ ਮਰਨ ਦਾ) ਡਰ ਵਿਖਾ ਕੇ ਪ੍ਰਿਯ ਸਹਿਤ ਆਪਣੇ ਪ੍ਰਾਣ ਬਚਾ ਲਏ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "प्रान उबारियो पृय सहित नृप डर जड़न दिखाइ ॥१८॥",
      "sourceLineId": "125120",
      "sourceShabadId": "11702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "125121",
      "sourceShabadId": "11703",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1098_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਿਨ ਇਹ ਭਾਤਿ ਬਿਚਾਰ ਬਿਚਾਰੇ ॥",
      "transliteration": "tin ieh bhaat bichaar bichaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ (ਪਹਿਰੇਦਾਰਾ) ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਵਿਚਾਰ ਬਣਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1098,
      "hindi": "",
      "hindiTransliteration": "तिन इह भाति बिचार बिचारे ॥",
      "sourceLineId": "125122",
      "sourceShabadId": "11703",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
