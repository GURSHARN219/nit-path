{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1099,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1099_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਨੀ ਮਰਤ ਮੀਤ ਕੇ ਮਾਰੇ ॥",
      "transliteration": "raanee marat meet ke maare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮਿਤਰ ਦੇ ਮਾਰਿਆਂ ਰਾਣੀ ਮਰ ਜਾਏਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "रानी मरत मीत के मारे ॥",
      "sourceLineId": "125123",
      "sourceShabadId": "11703",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਾਨੀ ਮਰੈ ਰਾਜਾ ਮਰਿ ਜੈ ਹੈ ॥",
      "transliteration": "raanee marai raajaa mar jai hai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਦੇ ਮਰਿਆਂ ਰਾਜਾ ਮਰ ਜਾਏਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "रानी मरै राजा मरि जै है ॥",
      "sourceLineId": "125124",
      "sourceShabadId": "11703",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਮਰੇ ਕਹਾ ਹਾਥ ਧਨੁ ਐ ਹੈ ॥੧੯॥",
      "transliteration": "hamare kahaa haath dhan aai hai ||19||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਡੇ ਹੱਥ ਧਨ ਕਿਥੋਂ ਆਵੇਗਾ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "हमरे कहा हाथ धनु ऐ है ॥१९॥",
      "sourceLineId": "125125",
      "sourceShabadId": "11703",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਤਿ ਹੀ ਲੋਭ ਰਛਕਨ ਕਿਯੋ ॥",
      "transliteration": "at hee lobh rachhakan kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਰੇਦਾਰਾ ਨੇ ਬਹੁਤ ਲੋਭ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "अति ही लोभ रछकन कियो ॥",
      "sourceLineId": "125126",
      "sourceShabadId": "11703",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰਾਜਾ ਸੰਗ ਭੇਦ ਨਹਿ ਦਿਯੋ ॥",
      "transliteration": "raajaa sa(n)g bhedh neh dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੂੰ ਭੇਦ ਨਹੀਂ ਦਸਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "राजा संग भेद नहि दियो ॥",
      "sourceLineId": "125127",
      "sourceShabadId": "11703",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਹਿਤ ਜਾਰ ਰਾਨਿਯਹਿ ਨ ਮਾਰਿਯੋ ॥",
      "transliteration": "sahit jaar raaniyeh na maariyo ||",
      "translation": "",
      "punjabiViakhya": "ਮਿਤਰ ਸਹਿਤ ਰਾਣੀ ਨੂੰ ਨਹੀਂ ਮਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "सहित जार रानियहि न मारियो ॥",
      "sourceLineId": "125128",
      "sourceShabadId": "11703",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਧਨ ਕੇ ਲੋਭ ਬਾਤ ਕੋ ਟਾਰਿਯੋ ॥੨੦॥",
      "transliteration": "dhan ke lobh baat ko Taariyo ||20||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਧਨ ਦੇ ਲੋਭ ਕਰ ਕੇ ਗੱਲ ਨੂੰ ਟਾਲ ਦਿੱਤਾ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "धन के लोभ बात को टारियो ॥२०॥",
      "sourceLineId": "125129",
      "sourceShabadId": "11703",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਛਠਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੦੬॥੩੮੯੬॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau chhaThavo charitr samaapatam sat subham sat ||206||3896||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੨੦੬ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੦੬॥੩੮੯੬॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ छठवो चरित्र समापतम सतु सुभम सतु ॥२०६॥३८९६॥अफजूँ॥",
      "sourceLineId": "125130",
      "sourceShabadId": "11703",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "125131",
      "sourceShabadId": "11704",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰਾਜਾ ਕੌਚ ਬਿਹਾਰ ਕੋ ਬੀਰ ਦਤ ਤਿਹ ਨਾਮ ॥",
      "transliteration": "raajaa kauach bihaar ko beer dhat teh naam ||",
      "translation": "",
      "punjabiViakhya": "ਕੌਚ (ਕੂਚ) ਬਿਹਾਰ ਦੇ ਰਾਜੇ ਦਾ ਨਾ ਬੀਰ ਦੱਤ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "राजा कौच बिहार को बीर दत तिह नाम ॥",
      "sourceLineId": "125132",
      "sourceShabadId": "11704",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਮਿਤ ਦਰਬੁ ਤਾ ਕੇ ਰਹੈ ਬਸਤੁ ਇੰਦ੍ਰ ਪੁਰ ਗ੍ਰਾਮ ॥੧॥",
      "transliteration": "amit dharab taa ke rahai basat i(n)dhr pur graam ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਾਸ ਬਹੁਤ ਧਨ ਸੀ ਅਤੇ ਇੰਦ੍ਰ ਪੁਰ ਨਗਰ ਵਿਚ ਰਹਿੰਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "अमित दरबु ता के रहै बसतु इंद्र पुर ग्राम ॥१॥",
      "sourceLineId": "125133",
      "sourceShabadId": "11704",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "125134",
      "sourceShabadId": "11705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮੁਸਕ ਮਤੀ ਤਾ ਕੀ ਬਰ ਨਾਰੀ ॥",
      "transliteration": "musak matee taa kee bar naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਮੁਸ਼ਕ ਮਤੀ ਨਾ ਦੀ ਸੁੰਦਰ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "मुसक मती ता की बर नारी ॥",
      "sourceLineId": "125135",
      "sourceShabadId": "11705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਨੁ ਰਤਿ ਪਤਿ ਕੇ ਭਈ ਕੁਮਾਰੀ ॥",
      "transliteration": "jan rat pat ke bhiee kumaaree ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਰਤੀ ਦੇ ਪਤੀ (ਕਾਮ ਦੇਵ) ਦੀ ਪੁੱਤਰੀ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "जनु रति पति के भई कुमारी ॥",
      "sourceLineId": "125136",
      "sourceShabadId": "11705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਾਮ ਕਲਾ ਦੁਹਿਤਾ ਤਿਹ ਸੋਹੈ ॥",
      "transliteration": "kaam kalaa dhuhitaa teh sohai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਕਾਮ ਕਲਾ ਨਾ ਦੀ ਪੁੱਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "काम कला दुहिता तिह सोहै ॥",
      "sourceLineId": "125137",
      "sourceShabadId": "11705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੇਵ ਅਦੇਵਨ ਕੋ ਮਨ ਮੋਹੈ ॥੨॥",
      "transliteration": "dhev adhevan ko man mohai ||2||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਦੇਵਤਿਆਂ ਅਤੇ ਦੈਂਤਾ ਦਾ ਮਨ ਮੋਂਹਦੀ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "देव अदेवन को मन मोहै ॥२॥",
      "sourceLineId": "125138",
      "sourceShabadId": "11705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜੋ ਪੁਰ ਚਹੈ ਤਿਸੀ ਕੌ ਮਾਰੈ ॥",
      "transliteration": "jo pur chahai tisee kau maarai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਨਗਰ ਵਿਚ ਜਿਸ ਨੂੰ ਚਾਹੁੰਦੀ ਸੀ, ਉਸ ਨੂੰ ਮਾਰ ਦਿੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "जो पुर चहै तिसी कौ मारै ॥",
      "sourceLineId": "125139",
      "sourceShabadId": "11705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਕਬਰ ਕੀ ਕਛੁ ਕਾਨਿ ਨ ਧਾਰੈ ॥",
      "transliteration": "akabar kee kachh kaan na dhaarai ||",
      "translation": "",
      "punjabiViakhya": "ਅਕਬਰ ਤਕ ਦੀ ਵੀ ਕੁਝ ਪਰਵਾਹ ਨਹੀਂ ਕਰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "अकबर की कछु कानि न धारै ॥",
      "sourceLineId": "125140",
      "sourceShabadId": "11705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦੇਸ ਤਲਟੀ ਬਸਨ ਨਹਿ ਦੇਵਹਿ ॥",
      "transliteration": "dhes talaTee basan neh dheveh ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਹਟੀ ਖੇਤਰ ਵਿਚ ਕਿਸੇ ਨੂੰ ਵਸਣ ਨਹੀਂ ਦਿੰਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "देस तलटी बसन नहि देवहि ॥",
      "sourceLineId": "125141",
      "sourceShabadId": "11705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਲੂਟਿ ਕੂਟਿ ਸੌਦਾਗ੍ਰਨ ਲੇਵਹਿ ॥੩॥",
      "transliteration": "looT kooT sauadhaagran leveh ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੌਦਾਗਰਾ ਨੂੰ ਲੁਟ ਪੁਟ ਲੈਂਦੀ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "लूटि कूटि सौदाग्रन लेवहि ॥३॥",
      "sourceLineId": "125142",
      "sourceShabadId": "11705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਕਬਰ ਸਾਹਿ ਕੋਪ ਅਤਿ ਆਯੋ ॥",
      "transliteration": "akabar saeh kop at aayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਕਬਰ ਬਾਦਸ਼ਾਹ ਨੂੰ ਬਹੁਤ ਗੁੱਸਾ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "अकबर साहि कोप अति आयो ॥",
      "sourceLineId": "125143",
      "sourceShabadId": "11705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਿਨ ਪੈ ਬੈਰਿਨ ਓਘ ਪਠਾਯੋ ॥",
      "transliteration": "tin pai bairin ogh paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਉਤੇ ਵੈਰੀ-ਦਲ ਚੜ੍ਰਹਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "तिन पै बैरिन ओघ पठायो ॥",
      "sourceLineId": "125144",
      "sourceShabadId": "11705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜੋਰਿ ਸੈਨਿ ਸੂਰਾ ਸਭ ਧਾਏ ॥",
      "transliteration": "jor sain sooraa sabh dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਸੈਨਾ ਜੋੜ ਕੇ ਸਾਰੇ ਸੂਰਮੇ ਧਾ ਕੇ ਪਏ",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "जोरि सैनि सूरा सभ धाए ॥",
      "sourceLineId": "125145",
      "sourceShabadId": "11705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪਹਿਰਿ ਕੌਚ ਦੁੰਦਭੀ ਬਜਾਏ ॥੪॥",
      "transliteration": "pahir kauach dhu(n)dhabhee bajaae ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਵਚ ਪਾ ਕੇ ਨਗਾਰੇ ਵਜਾ ਦਿੱਤੇ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "पहिरि कौच दुँदभी बजाए ॥४॥",
      "sourceLineId": "125146",
      "sourceShabadId": "11705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "125147",
      "sourceShabadId": "11706",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਬ ਹੀ ਕੌਚ ਬਿਹਾਰ ਕੇ ਨਿਕਟ ਪਹੂੰਚੇ ਆਇ ॥",
      "transliteration": "jab hee kauach bihaar ke nikaT pahoo(n)che aai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਉਹ ਕੌਚ ਬਿਹਾਰ ਦੇ ਨੇੜੇ ਆ ਪਹੁੰਚੇ",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "जब ही कौच बिहार के निकट पहूँचे आइ ॥",
      "sourceLineId": "125148",
      "sourceShabadId": "11706",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਲਿਖਿ ਪਤਿਯਾ ਐਸੇ ਪਠੀ ਰਣ ਦੁੰਦਭੀ ਬਜਾਇ ॥੫॥",
      "transliteration": "likh patiyaa aaise paThee ran dhu(n)dhabhee bajai ||5||",
      "translation": "",
      "punjabiViakhya": "(ਤਦੋਂ) ਉਨ੍ਰਹਾ ਨੇ ਰਣ ਦਾ ਨਗਾਰਾ ਵਜਾ ਕੇ (ਰਾਜੇ ਨੂੰ) ਇਸ ਤਰ੍ਰਹਾ ਦੀ ਚਿੱਠੀ ਭੇਜੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "लिखि पतिया ऐसे पठी रण दुँदभी बजाइ ॥५॥",
      "sourceLineId": "125149",
      "sourceShabadId": "11706",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕੈ ਹਮ ਕੌ ਮਿਲੁ ਆਇ ਕੈ ਪਤੀਆ ਲਿਖੀ ਸੁਧਾਰਿ ॥",
      "transliteration": "kai ham kau mil aai kai pateeaa likhee sudhaar ||",
      "translation": "",
      "punjabiViakhya": "ਚਿੱਠੀ ਵਿਚ ਚੰਗੀ ਤਰ੍ਰਹਾ ਲਿਖਿਆ ਕਿ ਜਾ ਤਾ ਆ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "कै हम कौ मिलु आइ कै पतीआ लिखी सुधारि ॥",
      "sourceLineId": "125150",
      "sourceShabadId": "11706",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕੈ ਪਗੁ ਪਰੁ ਕੈ ਅਨਤ ਟਰੁ ਕੈ ਲਰੁ ਸਸਤ੍ਰ ਸੰਭਾਰਿ ॥੬॥",
      "transliteration": "kai pag par kai anat Tar kai lar sasatr sa(n)bhaar ||6||",
      "translation": "",
      "punjabiViakhya": "ਪੈਰੀ ਪੈ ਜਾ ਕਿਤੇ ਹੋਰ ਚਲਾ ਜਾ ਜਾ (ਫਿਰ) ਸ਼ਸਤ੍ਰ ਸੰਭਾਲ ਲੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "कै पगु परु कै अनत टरु कै लरु ससत्र संभारि ॥६॥",
      "sourceLineId": "125151",
      "sourceShabadId": "11706",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "125152",
      "sourceShabadId": "11707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਬ ਨ੍ਰਿਪ ਕੇ ਸ੍ਰਵਨਨ ਸੌ ਪਰਿਯੋ ॥",
      "transliteration": "jab nirap ke sravanan sau pariyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਦੇ ਕੰਨ ਵਿਚ ਇਹ ਗੱਲ ਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "जब नृप के स्रवनन सौ परियो ॥",
      "sourceLineId": "125153",
      "sourceShabadId": "11707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਾਜਿ ਚਲਤ ਭਯੋ ਧੀਰ ਨ ਧਰਿਯੋ ॥",
      "transliteration": "bhaaj chalat bhayo dheer na dhariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਭਜ ਚਲਿਆ, ਧੀਰਜ ਧਾਰਨ ਨਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "भाजि चलत भयो धीर न धरियो ॥",
      "sourceLineId": "125154",
      "sourceShabadId": "11707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮੁਸਕ ਮਤੀ ਜਬ ਹੀ ਸੁਨਿ ਪਾਈ ॥",
      "transliteration": "musak matee jab hee sun paiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਮੁਸ਼ਕ ਮਤੀ ਨੇ ਇਹ ਗੱਲ ਸੁਣੀ",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "मुसक मती जब ही सुनि पाई ॥",
      "sourceLineId": "125155",
      "sourceShabadId": "11707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਾਧਿ ਨ੍ਰਿਪਹਿ ਦੁੰਦਭੀ ਬਜਾਈ ॥੭॥",
      "transliteration": "baadh nirapeh dhu(n)dhabhee bajaiee ||7||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਾਜੇ ਨੂੰ ਬੰਨ੍ਰਹ ਕੇ ਨਗਾਰਾ ਵਜਾ ਦਿੱਤਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "बाधि नृपहि दुँदभी बजाई ॥७॥",
      "sourceLineId": "125156",
      "sourceShabadId": "11707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤੇ ਸੈਨਿ ਸੰਭਾਰੀ ॥",
      "transliteration": "bhaat bhaat te sain sa(n)bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਤਰ੍ਰਹਾ ਨਾਲ (ਉਸ ਨੇ) ਸੈਨਾ ਨੂੰ ਤਿਆਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "भाति भाति ते सैनि संभारी ॥",
      "sourceLineId": "125157",
      "sourceShabadId": "11707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮਾਰੇ ਸੂਰਬੀਰ ਹੰਕਾਰੀ ॥",
      "transliteration": "maare soorabeer ha(n)kaaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੰਕਾਰੀ ਸੂਰਮਿਆਂ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "मारे सूरबीर हंकारी ॥",
      "sourceLineId": "125158",
      "sourceShabadId": "11707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਰਾਜਾ ਕਿਤੇ ਬਾਧਿ ਕਰਿ ਲੀਨੇ ॥",
      "transliteration": "raajaa kite baadh kar leene ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਕਿਤਨੇ ਰਾਜੇ ਬੰਨ੍ਰਹ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "राजा किते बाधि करि लीने ॥",
      "sourceLineId": "125159",
      "sourceShabadId": "11707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਾਇ ਭਵਾਨੀ ਕੇ ਬਲਿ ਦੀਨੇ ॥੮॥",
      "transliteration": "jai bhavaanee ke bal dheene ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਾ ਕੇ ਭਵਾਨੀ ਦੀ ਬਲੀ ਚੜ੍ਰਹਾ ਦਿੱਤੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "जाइ भवानी के बलि दीने ॥८॥",
      "sourceLineId": "125160",
      "sourceShabadId": "11707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "125161",
      "sourceShabadId": "11708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦਲਦਲ ਏਕ ਤਕਾਇ ਕੈ ਦਯੋ ਦਮਾਮੋ ਜਾਇ ॥",
      "transliteration": "dhaladhal ek takai kai dhayo dhamaamo jai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਲਦਲ ਖੇਤਰ ਵੇਖ ਕੇ (ਉਥੇ) ਜਾ ਕੇ ਧੌਂਸਾ ਵਜਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "दलदल एक तकाइ कै दयो दमामो जाइ ॥",
      "sourceLineId": "125162",
      "sourceShabadId": "11708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੁਨਤ ਨਾਦ ਸੂਰਾ ਸਭੈ ਤਹੀ ਪਰੇ ਅਰਰਾਇ ॥੯॥",
      "transliteration": "sunat naadh sooraa sabhai tahee pare ararai ||9||",
      "translation": "",
      "punjabiViakhya": "ਧੌਂਸੇ ਦਾ ਨਾਦ ਸੁਣ ਕੇ (ਵੈਰੀ ਦਲ ਦੇ) ਸਾਰੇ ਸੂਰਮੇ ਅਰੜਾ ਕੇ ਪੈ ਗਏ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "सुनत नाद सूरा सभै तही परे अरराइ ॥९॥",
      "sourceLineId": "125163",
      "sourceShabadId": "11708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "125164",
      "sourceShabadId": "11709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜੌ ਧਾਏ ਫਸਿ ਫਸਿ ਤੇ ਗਏ ॥",
      "transliteration": "jau dhaae fas fas te ge ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੜੇ ਵੀ (ਉਧਰ) ਨੂੰ ਵਧੇ, ਦਲਦਲ ਵਿਚ ਫਸ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "जौ धाए फसि फसि ते गए ॥",
      "sourceLineId": "125165",
      "sourceShabadId": "11709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗਹਿ ਗਹਿ ਤਰੁਨਿ ਤੁਰਤ ਤੇ ਲਏ ॥",
      "transliteration": "geh geh tarun turat te le ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਇਸਤਰੀ ਨੇ ਤੁਰਤ ਪਕੜ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "गहि गहि तरुनि तुरत ते लए ॥",
      "sourceLineId": "125166",
      "sourceShabadId": "11709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਕਲ ਕਾਲਿਕਾ ਕੀ ਬਲਿ ਦੀਨੇ ॥",
      "transliteration": "sakal kaalikaa kee bal dheene ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਨੂੰ ਕਾਲਿਕਾ ਦੀ ਬਲੀ ਚੜ੍ਰਹਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "सकल कालिका की बलि दीने ॥",
      "sourceLineId": "125167",
      "sourceShabadId": "11709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬਾਜ ਤਾਜ ਸਭਹਿਨ ਕੇ ਛੀਨੇ ॥੧੦॥",
      "transliteration": "baaj taaj sabhahin ke chheene ||10||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਦੇ ਤਾਜ ਅਤੇ ਘੋੜੇ ਖੋਹ ਲਏ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "बाज ताज सभहिन के छीने ॥१०॥",
      "sourceLineId": "125168",
      "sourceShabadId": "11709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "125169",
      "sourceShabadId": "11710",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1099_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਏਕ ਭ੍ਰਿਤ ਤਿਹ ਭੀਤਰ ਪਠਿਯੋ ਬਨਾਇ ਕੈ ॥",
      "transliteration": "ek bhirat teh bheetar paThiyo banai kai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਨੌਕਰ ਨੂੰ ਉਸ (ਵੈਰੀ ਧੜੇ) ਵਿਚ ਸਮਝਾ ਕੇ ਭੇਜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1099,
      "hindi": "",
      "hindiTransliteration": "एक भृत तिह भीतर पठियो बनाइ कै ॥",
      "sourceLineId": "125170",
      "sourceShabadId": "11710",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
