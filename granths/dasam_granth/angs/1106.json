{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1106,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1106_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਝਖ ਕੇਤੁਕ ਬਾਨਨ ਪੀੜਤ ਭੀ ਮਨ ਜਾਇ ਰਹਿਯੋ ਮਨ ਮੋਹਨ ਮੈ ॥",
      "transliteration": "jhakh ketuk baanan peeRat bhee man jai rahiyo man mohan mai ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਕਾਮ ਦੇਵ ('ਝਖ ਕੇਤੁ') ਦੇ ਬਾਣ ਲਗਣ ਨਾਲ ਦੁਖੀ ਹੋ ਗਈਆਂ ਹਨ ਅਤੇ ਉਨ੍ਰਹਾ ਦਾ ਮਨ ਮਨਮੋਹਨ ਪਾਸ ਚਲਾ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "झख केतुक बानन पीड़त भी मन जाइ रहियो मन मोहन मै ॥",
      "sourceLineId": "125483",
      "sourceShabadId": "11747",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਨੋ ਦੀਪਕ ਭੇਦ ਸੁਨੋ ਸੁਰ ਨਾਦ ਮ੍ਰਿਗੀ ਗਨ ਜਾਨੁ ਬਿਧੀ ਮਨ ਮੈ ॥੪੮॥",
      "transliteration": "mano dheepak bhedh suno sur naadh miragee gan jaan bidhee man mai ||48||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ) ਮਾਨੋ ਦੀਪਕ ਦਾ ਭੇਦ (ਪਰਵਾਨਿਆਂ ਨੇ ਪਾ ਲਿਆ ਹੋਵੇ) ਜਾ ਮਾਨੋ ਘੰਡਾ ਹੇੜੇ ਦਾ ਨਾਦ ਸੁਣ ਕੇ ਬਹੁਤ ਸਾਰੀਆਂ ਹਿਰਨੀਆਂ ਮਨ ਵਿਚ ਵਿੰਨ੍ਰਹੀਆਂ ਗਈਆਂ ਹੋਣ ॥੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "मनो दीपक भेद सुनो सुर नाद मृगी गन जानु बिधी मन मै ॥४८॥",
      "sourceLineId": "125484",
      "sourceShabadId": "11747",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "125485",
      "sourceShabadId": "11748",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਨਿਕ ਜਤਨ ਕਰਿ ਕਰਿ ਤ੍ਰਿਯਾ ਹਾਰਤ ਭਈ ਅਨੇਕ ॥",
      "transliteration": "anik jatan kar kar tirayaa haarat bhiee anek ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੇਕਾ ਇਸਤਰੀਆਂ ਕਈ ਪ੍ਰਕਾਰ ਦੇ ਯਤਨ ਕਰ ਕਰ ਕੇ ਹਾਰ ਗਈਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "अनिक जतन करि करि तृया हारत भई अनेक ॥",
      "sourceLineId": "125486",
      "sourceShabadId": "11748",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਨ ਹੀ ਕੌ ਨ੍ਰਿਪ ਜਾਤ ਭਯੋ ਮਾਨਿਯੋ ਬਚਨ ਨ ਏਕ ॥੪੯॥",
      "transliteration": "ban hee kau nirap jaat bhayo maaniyo bachan na ek ||49||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਰਾਜਾ ਬਨ ਨੂੰ ਚਲਾ ਗਿਆ ਅਤੇ ਕਿਸੇ ਇਕ ਦੀ ਵੀ ਗੱਲ ਨਾ ਮੰਨੀ ॥੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "बन ही कौ नृप जात भयो मानियो बचन न एक ॥४९॥",
      "sourceLineId": "125487",
      "sourceShabadId": "11748",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਬ ਰਾਜਾ ਬਨ ਮੈ ਗਏ ਗੋਰਖ ਗੁਰੂ ਬੁਲਾਇ ॥",
      "transliteration": "jab raajaa ban mai ge gorakh guroo bulai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜਾ ਬਨ ਵਿਚ ਗਿਆ (ਤਾ) ਗੁਰੂ ਗੋਰਖ ਨਾਥ ਨੇ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "जब राजा बन मै गए गोरख गुरू बुलाइ ॥",
      "sourceLineId": "125488",
      "sourceShabadId": "11748",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਹੁਰਿ ਭਾਤਿ ਸਿਛ੍ਯਾ ਦਈ ਤਾਹਿ ਸਿਖ੍ਯ ਠਹਰਾਇ ॥੫੦॥",
      "transliteration": "bahur bhaat sichhayaa dhiee taeh sikhay Thaharai ||50||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਤਰ੍ਰਹਾ ਦੀ ਸਿਖਿਆ ਦੇ ਕੇ ਉਸ ਨੂੰ ਆਪਣਾ ਚੇਲਾ ਬਣਾ ਲਿਆ ॥੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "बहुरि भाति सिछ्या दई ताहि सिख्य ठहराइ ॥५०॥",
      "sourceLineId": "125489",
      "sourceShabadId": "11748",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭਰਥਰੀ ਬਾਚ ॥",
      "transliteration": "bharatharee baach ||",
      "translation": "",
      "punjabiViakhya": "ਭਰਥਰੀ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "भरथरी बाच ॥",
      "sourceLineId": "125490",
      "sourceShabadId": "11749",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਵਨ ਮਰੈ ਮਾਰੈ ਕਵਨ ਕਹਤ ਸੁਨਤ ਕਹ ਕੋਇ ॥",
      "transliteration": "kavan marai maarai kavan kahat sunat keh koi ||",
      "translation": "",
      "punjabiViakhya": "(ਹੇ ਗੁਰੂ ਗੋਰਖ ਨਾਥ! ਇਹ ਦਸੋ) ਕੌਣ ਮਰਦਾ ਹੈ, ਕੌਣ ਮਾਰਦਾ ਹੈ, ਕੌਣ ਕਹਿੰਦਾ ਹੈ, ਕੌਣ ਸੁਣਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "कवन मरै मारै कवन कहत सुनत कह कोइ ॥",
      "sourceLineId": "125491",
      "sourceShabadId": "11749",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕੋ ਰੋਵੈ ਕਵਨੈ ਹਸੈ ਕਵਨ ਜਰਾ ਜਿਤ ਹੋਇ ॥੫੧॥",
      "transliteration": "ko rovai kavanai hasai kavan jaraa jit hoi ||51||",
      "translation": "",
      "punjabiViakhya": "ਕੌਣ ਰੋਂਦਾ ਹੈ, ਕੌਣ ਹਸਦਾ ਹੈ, ਕੌਣ ਬੁਢਾਪੇ ਨੂੰ ਜਿਤਣ ਵਾਲਾ ਹੈ? ॥੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "को रोवै कवनै हसै कवन जरा जित होइ ॥५१॥",
      "sourceLineId": "125492",
      "sourceShabadId": "11749",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "125493",
      "sourceShabadId": "11750",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਸਿ ਗੋਰਖ ਇਮਿ ਬਚਨ ਉਚਾਰੇ ॥",
      "transliteration": "has gorakh im bachan uchaare ||",
      "translation": "",
      "punjabiViakhya": "ਗੋਰਖ ਨੇ ਹਸ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "हसि गोरख इमि बचन उचारे ॥",
      "sourceLineId": "125494",
      "sourceShabadId": "11750",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੁਨਹੁ ਭਰਥ ਹਰਿ ਰਾਜ ਹਮਾਰੇ ॥",
      "transliteration": "sunahu bharath har raaj hamaare ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮੇਰੇ ਭਰਥਰੀ ਹਰਿ ਰਾਜਾ! ਸੁਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "सुनहु भरथ हरि राज हमारे ॥",
      "sourceLineId": "125495",
      "sourceShabadId": "11750",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਤਿ ਝੂਠ ਮੂਓ ਹੰਕਾਰਾ ॥",
      "transliteration": "sat jhooTh mooo ha(n)kaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸਚ, ਝੂਠ ਅਤੇ ਹੰਕਾਰ ਮਰਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "सति झूठ मूओ हंकारा ॥",
      "sourceLineId": "125496",
      "sourceShabadId": "11750",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਬਹੂ ਮਰਤ ਨ ਬੋਲਨਹਾਰਾ ॥੫੨॥",
      "transliteration": "kabahoo marat na bolanahaaraa ||52||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਬੋਲਣ ਵਾਲੀ ਆਤਮਾ ਕਦੇ ਵੀ ਨਹੀਂ ਮਰਦੀ ॥੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "कबहू मरत न बोलनहारा ॥५२॥",
      "sourceLineId": "125497",
      "sourceShabadId": "11750",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "125498",
      "sourceShabadId": "11751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਾਲ ਮਰੈ ਕਾਯਾ ਮਰੈ ਕਾਲੈ ਕਰਤ ਉਚਾਰ ॥",
      "transliteration": "kaal marai kaayaa marai kaalai karat uchaar ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਮਰਦਾ ਹੈ, ਸ਼ਰੀਰ ਮਰਦਾ ਹੈ ਅਤੇ ਕਾਲ ਹੀ (ਬਚਨ) ਉਚਾਰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "काल मरै काया मरै कालै करत उचार ॥",
      "sourceLineId": "125499",
      "sourceShabadId": "11751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜੀਭੈ ਗੁਨ ਬਖ੍ਯਾਨ ਹੀ ਸ੍ਰਵਨਨ ਸੁਨਤ ਸੁਧਾਰ ॥੫੩॥",
      "transliteration": "jeebhai gun bakhayaan hee sravanan sunat sudhaar ||53||",
      "translation": "",
      "punjabiViakhya": "ਜੀਭ ਦਾ ਗੁਣ ਬਖਾਨ ਕਰਨਾ ਹੈ ਅਤੇ ਕੰਨਾ ਦਾ ਕੰਮ ਪੂਰੀ ਤਰ੍ਰਹਾ ਸੁਣਨਾ ਹੈ ॥੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "जीभै गुन बख्यान ही स्रवनन सुनत सुधार ॥५३॥",
      "sourceLineId": "125500",
      "sourceShabadId": "11751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "125501",
      "sourceShabadId": "11752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਾਲ ਨੈਨ ਹ੍ਵੈ ਸਭਨ ਨਿਹਰਈ ॥",
      "transliteration": "kaal nain havai sabhan nihariee ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਹੀ ਨੈਣ ਬਣ ਕੇ ਸਭ ਨੂੰ ਵੇਖਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "काल नैन ह्वै सभन निहरई ॥",
      "sourceLineId": "125502",
      "sourceShabadId": "11752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਾਲ ਬਕਤ੍ਰ ਹ੍ਵੈ ਬਾਕ ਉਚਰਈ ॥",
      "transliteration": "kaal bakatr havai baak uchariee ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਮੁਖ ਬਣ ਕੇ ਬਾਣੀ (ਬੋਲ) ਉਚਾਰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "काल बकत्र ह्वै बाक उचरई ॥",
      "sourceLineId": "125503",
      "sourceShabadId": "11752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਾਲ ਮਰਤ ਕਾਲ ਹੀ ਮਾਰੈ ॥",
      "transliteration": "kaal marat kaal hee maarai ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਮਰਦਾ ਹੈ ਅਤੇ ਕਾਲ ਹੀ ਮਾਰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "काल मरत काल ही मारै ॥",
      "sourceLineId": "125504",
      "sourceShabadId": "11752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭੂਲਾ ਲੋਗ ਭਰਮ ਬੀਚਾਰੈ ॥੫੪॥",
      "transliteration": "bhoolaa log bharam beechaarai ||54||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਵਾਸਤਵਿਕਤਾ ਤੋਂ) ਭੁਲੇ ਹੋਏ ਲੋਕੀਂ ਭਰਮਾ ਵਿਚ ਪਏ ਹਨ ॥੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "भूला लोग भरम बीचारै ॥५४॥",
      "sourceLineId": "125505",
      "sourceShabadId": "11752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "125506",
      "sourceShabadId": "11753",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਾਲ ਹਸਤ ਕਾਲੈ ਰੋਵਤ ਕਰਤ ਜਰਾ ਜਿਤ ਹੋਇ ॥",
      "transliteration": "kaal hasat kaalai rovat karat jaraa jit hoi ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਹੀ ਹਸਦਾ ਹੈ, ਕਾਲ ਹੀ ਰੋਂਦਾ ਹੈ, ਕਾਲ ਹੀ ਬੁਢਾਪੇ ਉਤੇ ਜਿਤ ਪ੍ਰਾਪਤ ਕਰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "काल हसत कालै रोवत करत जरा जित होइ ॥",
      "sourceLineId": "125507",
      "sourceShabadId": "11753",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਾਲ ਪਾਇ ਉਪਜਤ ਸਭੈ ਕਾਲ ਪਾਇ ਬਧ ਹੋਇ ॥੫੫॥",
      "transliteration": "kaal pai upajat sabhai kaal pai badh hoi ||55||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਪਾ ਕੇ ਹੀ ਸਭ ਪੈਦਾ ਹੁੰਦੇ ਹਨ ਅਤੇ ਕਾਲ ਪਾ ਕੇ ਹੀ ਮਰਦੇ ਹਨ ॥੫੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "काल पाइ उपजत सभै काल पाइ बध होइ ॥५५॥",
      "sourceLineId": "125508",
      "sourceShabadId": "11753",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "125509",
      "sourceShabadId": "11754",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਾਲੈ ਮਰਤ ਕਾਲ ਹੀ ਮਾਰੈ ॥",
      "transliteration": "kaalai marat kaal hee maarai ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਹੀ ਮਰਦਾ ਹੈ, ਕਾਲ ਹੀ ਮਾਰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "कालै मरत काल ही मारै ॥",
      "sourceLineId": "125510",
      "sourceShabadId": "11754",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭ੍ਰਮਿ ਭ੍ਰਮਿ ਪਿੰਡ ਅਵਾਰਾ ਪਾਰੈ ॥",
      "transliteration": "bhram bhram pi(n)dd avaaraa paarai ||",
      "translation": "",
      "punjabiViakhya": "(ਕਾਲ ਹੀ) ਆਵਾਗਵਣ ਵਿਚ ਭਰਮ ਭਰਮ ਕੇ ਸ਼ਰੀਰ ('ਪਿੰਡ') ਧਾਰਨ ਕਰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "भ्रमि भ्रमि पिंड अवारा पारै ॥",
      "sourceLineId": "125511",
      "sourceShabadId": "11754",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧ ਮੂਓ ਹੰਕਾਰਾ ॥",
      "transliteration": "kaam krodh mooo ha(n)kaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮ, ਕ੍ਰੋਧ ਅਤੇ ਹੰਕਾਰ ਮਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "काम क्रोध मूओ हंकारा ॥",
      "sourceLineId": "125512",
      "sourceShabadId": "11754",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਏਕ ਨ ਮਰਿਯੋ ਸੁ ਬੋਲਣਹਾਰਾ ॥੫੬॥",
      "transliteration": "ek na mariyo su bolanahaaraa ||56||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ ਕੇਵਲ) ਬੋਲਣ ਵਾਲਾ (ਕਰਤਾਰ) ਨਹੀਂ ਮਰਦਾ ॥੫੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "एक न मरियो सु बोलणहारा ॥५६॥",
      "sourceLineId": "125513",
      "sourceShabadId": "11754",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਆਸਾ ਕਰਤ ਸਕਲ ਜਗ ਮਰਈ ॥",
      "transliteration": "aasaa karat sakal jag mariee ||",
      "translation": "",
      "punjabiViakhya": "ਆਸ਼ਾ ਕਰਦਿਆਂ ਕਰਦਿਆਂ ਸਾਰਾ ਜਗਤ ਮਰ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "आसा करत सकल जग मरई ॥",
      "sourceLineId": "125514",
      "sourceShabadId": "11754",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕੌਨ ਪੁਰਖੁ ਆਸਾ ਪਰਹਰਈ ॥",
      "transliteration": "kauan purakh aasaa parahariee ||",
      "translation": "",
      "punjabiViakhya": "ਕੌਣ (ਅਜਿਹਾ) ਮਨੁੱਖ ਹੈ ਜੋ ਆਸ਼ਾ ਨੂੰ ਤਿਆਗਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "कौन पुरखु आसा परहरई ॥",
      "sourceLineId": "125515",
      "sourceShabadId": "11754",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜੋ ਨਰ ਕੋਊ ਆਸ ਕੌ ਤ੍ਯਾਗੈ ॥",
      "transliteration": "jo nar kouoo aas kau tayaagai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਕੋਈ ਵਿਅਕਤੀ ਆਸ਼ਾ ਨੂੰ ਤਿਆਗ ਦਿੰਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "जो नर कोऊ आस कौ त्यागै ॥",
      "sourceLineId": "125516",
      "sourceShabadId": "11754",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੋ ਹਰਿ ਕੇ ਪਾਇਨ ਸੌ ਲਾਗੈ ॥੫੭॥",
      "transliteration": "so har ke pain sau laagai ||57||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਪਰਮਾਤਮਾ ਦੇ ਪੈਰਾ ਵਿਚ ਸਥਾਨ ਪਾਦਾ ਹੈ ॥੫੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "सो हरि के पाइन सौ लागै ॥५७॥",
      "sourceLineId": "125517",
      "sourceShabadId": "11754",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "125518",
      "sourceShabadId": "11755",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਆਸਾ ਕੀ ਆਸਾ ਪੁਰਖ ਜੋ ਕੋਊ ਤਜਤ ਬਨਾਇ ॥",
      "transliteration": "aasaa kee aasaa purakh jo kouoo tajat banai ||",
      "translation": "",
      "punjabiViakhya": "ਆਸ਼ਾ ਦੀ ਆਸ ਜੋ ਕੋਈ ਵਿਅਕਤੀ ਤਿਆਗ ਦਿੰਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "आसा की आसा पुरख जो कोऊ तजत बनाइ ॥",
      "sourceLineId": "125519",
      "sourceShabadId": "11755",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪਾਪ ਪੁੰਨ੍ਯ ਸਰ ਤਰਿ ਤੁਰਤ ਪਰਮ ਪੁਰੀ ਕਹ ਜਾਇ ॥੫੮॥",
      "transliteration": "paap pu(n)nay sar tar turat param puree keh jai ||58||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਪਾਪ ਪੁੰਨ ਦੇ ਸਰੋਵਰ (ਜਗਤ) ਨੂੰ ਤੁਰਤ ਤਰ ਕੇ ਪਰਮ ਪੁਰੀ ਨੂੰ ਚਲਾ ਜਾਦਾ ਹੈ ॥੫੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "पाप पुँन्य सर तरि तुरत परम पुरी कह जाइ ॥५८॥",
      "sourceLineId": "125520",
      "sourceShabadId": "11755",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜ੍ਯੋ ਸਮੁੰਦਹਿ ਗੰਗਾ ਮਿਲਤ ਸਹੰਸ ਧਾਰ ਕੈ ਸਾਜ ॥",
      "transliteration": "jayo samu(n)dheh ga(n)gaa milat saha(n)s dhaar kai saaj ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਸਮੁੰਦਰ ਵਿਚ ਗੰਗਾ ਹਜ਼ਾਰਾ ਧਾਰਾਵਾ ਬਣਾ ਕੇ ਮਿਲ ਜਾਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "ज्यो समुँदहि गंगा मिलत सहंस धार कै साज ॥",
      "sourceLineId": "125521",
      "sourceShabadId": "11755",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤ੍ਯੋਂ ਗੋਰਖ ਰਿਖਿਰਾਜ ਸਿਯੋਂ ਆਜੁ ਮਿਲ੍ਯੋ ਨ੍ਰਿਪ ਰਾਜ ॥੫੯॥",
      "transliteration": "tayo(n) gorakh rikhiraaj siyo(n) aaj milayo nirap raaj ||59||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਤਰ੍ਰਹਾ ਰਿਖੀ ਰਾਜ ਗੋਰਖ ਨਾਲ ਸ਼ਿਰੋਮਣੀ ਰਾਜਾ (ਭਰਥਰੀ) ਮਿਲ ਗਿਆ ਹੈ ॥੫੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "त्यों गोरख रिखिराज सियों आजु मिल्यो नृप राज ॥५९॥",
      "sourceLineId": "125522",
      "sourceShabadId": "11755",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "125523",
      "sourceShabadId": "11756",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਯਾਤੇ ਮੈ ਬਿਸਥਾਰ ਨ ਕਰੌ ॥",
      "transliteration": "yaate mai bisathaar na karau ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਮੈਂ ਹੋਰ ਵਿਸਤਾਰ ਵਿਚ ਨਹੀਂ ਪੈਂਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "याते मै बिसथार न करौ ॥",
      "sourceLineId": "125524",
      "sourceShabadId": "11756",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗ੍ਰੰਥ ਬਢਨ ਤੇ ਅਤਿ ਚਿਤ ਡਰੌ ॥",
      "transliteration": "gra(n)th baddan te at chit ddarau ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਉਾਂਕਿ ਗ੍ਰੰਥ ਦੇ ਵੱਧ ਜਾਣ ਤੋਂ ਮਨ ਵਿਚ ਡਰਦਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "ग्रंथ बढन ते अति चित डरौ ॥",
      "sourceLineId": "125525",
      "sourceShabadId": "11756",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਾ ਤੇ ਕਥਾ ਨ ਅਧਿਕ ਬਢਾਈ ॥",
      "transliteration": "taa te kathaa na adhik baddaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਕਥਾ ਨੂੰ ਅਧਿਕ ਨਹੀਂ ਵਧਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "ता ते कथा न अधिक बढाई ॥",
      "sourceLineId": "125526",
      "sourceShabadId": "11756",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭੂਲ ਪਰੀ ਤਹ ਲੇਹੁ ਬਨਾਈ ॥੬੦॥",
      "transliteration": "bhool paree teh leh banaiee ||60||",
      "translation": "",
      "punjabiViakhya": "(ਜੇ ਕਿਤੇ) ਭੁਲ ਹੋ ਗਈ ਹੋਵੇ ਤਾ ਸੁਧਾਰ ਲੈਣਾ ॥੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "भूल परी तह लेहु बनाई ॥६०॥",
      "sourceLineId": "125527",
      "sourceShabadId": "11756",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੋਰਖ ਸੋ ਗੋਸਟਿ ਜਬ ਭਈ ॥",
      "transliteration": "gorakh so gosaT jab bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਰਾਜਾ ਭਰਥਰੀ ਹਰਿ ਦੀ) ਗੋਸਟਿ ਗੋਰਖ ਨਾਲ ਹੋਈ",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "गोरख सो गोसटि जब भई ॥",
      "sourceLineId": "125528",
      "sourceShabadId": "11756",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰਾਜਾ ਕੀ ਦੁਰਮਤਿ ਸਭ ਗਈ ॥",
      "transliteration": "raajaa kee dhuramat sabh giee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਾਜੇ ਦੀ ਦੁਰਬੁੱਧੀ ਖ਼ਤਮ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "राजा की दुरमति सभ गई ॥",
      "sourceLineId": "125529",
      "sourceShabadId": "11756",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1106_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੀਖਤ ਗ੍ਯਾਨ ਭਲੀ ਬਿਧਿ ਭਯੋ ॥",
      "transliteration": "seekhat gayaan bhalee bidh bhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਗਿਆਨ ਸਿਖ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1106,
      "hindi": "",
      "hindiTransliteration": "सीखत ग्यान भली बिधि भयो ॥",
      "sourceLineId": "125530",
      "sourceShabadId": "11756",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
