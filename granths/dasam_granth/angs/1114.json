{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1114,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1114_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "125891",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਉਤੈ ਮੀਤ ਤਿਨ ਲਿਯੋ ਬੁਲਾਈ ॥",
      "transliteration": "autai meet tin liyo bulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਧਰ ਉਸ (ਕੁਮਾਰੀ) ਨੇ ਮਿਤਰ ਨੂੰ ਬੁਲਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "उतै मीत तिन लियो बुलाई ॥",
      "sourceLineId": "125892",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਾਮ ਰੀਤਿ ਕਰਿ ਪ੍ਰੀਤੁਪਜਾਈ ॥",
      "transliteration": "kaam reet kar preetupajaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰ ਕੇ ਪ੍ਰੀਤ ਨੂੰ ਪ੍ਰਗਟ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "काम रीति करि प्रीतुपजाई ॥",
      "sourceLineId": "125893",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਰਿ ਕਰਿ ਕੁਵਤਿ ਸੇਜ ਚਰਕਾਵੈ ॥",
      "transliteration": "kar kar kuvat sej charakaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜ਼ੋਰ ('ਕੁਵਤਿ') ਨਾਲ (ਘਰਸ਼ਣ ਕਰਨ ਤੇ) ਮੰਜੀ ਚਰ ਚਰ ਕਰਨ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "करि करि कुवति सेज चरकावै ॥",
      "sourceLineId": "125894",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਏਕ ਹਾਥ ਤਨ ਘੰਟ ਬਜਾਵੈ ॥੧੧॥",
      "transliteration": "ek haath tan gha(n)T bajaavai ||11||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕੁਮਾਰੀ) ਇਕ ਹੱਥ ਨਾਲ ਘੰਟਾ ਵਜਾਉਣ ਲਗੀ (ਤਾ ਜੋ ਮੰਜੀ ਦੀ ਆਵਾਜ਼ ਸੁਣਾਈ ਨਾ ਦੇਵੇ) ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "एक हाथ तन घंट बजावै ॥११॥",
      "sourceLineId": "125895",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਾ ਕੌ ਰਤਿ ਕੀਨੀ ॥",
      "transliteration": "bhaat bhaat taa kau rat keenee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਕਈ ਢੰਗਾ ਨਾਲ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "भाति भाति ता कौ रति कीनी ॥",
      "sourceLineId": "125896",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨ੍ਰਿਪ ਜੜ ਧੁਨਿ ਘੰਟਾ ਕੀ ਚੀਨੀ ॥",
      "transliteration": "nirap jaR dhun gha(n)Taa kee cheenee ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਰਾਜੇ ਨੇ ਉਸ ਨੂੰ ਘੰਟੇ ਦੀ ਧੁਨੀ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "नृप जड़ धुनि घंटा की चीनी ॥",
      "sourceLineId": "125897",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਕਛੂ ਨਹਿ ਪਾਯੋ ॥",
      "transliteration": "bhedh abhedh kachhoo neh paayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਭੇਦ ਅਭੇਦ ਕੁਝ ਨਾ ਜਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद कछू नहि पायो ॥",
      "sourceLineId": "125898",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਇਹ ਦੁਹਿਤਾ ਕਸ ਕਰਮ ਕਮਾਯੋ ॥੧੨॥",
      "transliteration": "eeh dhuhitaa kas karam kamaayo ||12||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਸ ਪੁੱਤਰੀ ਨੇ ਕਿਹੋ ਜਿਹਾ ਕਰਮ ਕਮਾਇਆ ਹੈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "इह दुहिता कस करम कमायो ॥१२॥",
      "sourceLineId": "125899",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਾ ਸੌ ਭੋਗ ਬਹੁਤ ਬਿਧਿ ਕੀਨੋ ॥",
      "transliteration": "taa sau bhog bahut bidh keeno ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਬਹੁਤ ਤਰ੍ਰਹਾ ਦਾ ਭੋਗ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "ता सौ भोग बहुत बिधि कीनो ॥",
      "sourceLineId": "125900",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਲਪਟਿ ਲਪਟਿ ਆਸਨ ਕਹ ਦੀਨੋ ॥",
      "transliteration": "lapaT lapaT aasan keh dheeno ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲਿਪਟ ਲਿਪਟ ਕੇ ਆਸਣ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "लपटि लपटि आसन कह दीनो ॥",
      "sourceLineId": "125901",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਚੁੰਬਨ ਆਲਿੰਗਨ ਕੀਨੇ ਤਿਨ ॥",
      "transliteration": "chu(n)ban aali(n)gan keene tin ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਚੁੰਬਨ ਅਤੇ ਆਲਿੰਗਨ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "चुँबन आलिंगन कीने तिन ॥",
      "sourceLineId": "125902",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭੇਦ ਨ ਲਹਿਯੋ ਮੂੜ ਰਾਜੈ ਇਨ ॥੧੩॥",
      "transliteration": "bhedh na lahiyo mooR raajai in ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਮੂਰਖ ਰਾਜੇ ਨੇ ਭੇਦ ਨਾ ਜਾਣਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "भेद न लहियो मूड़ राजै इन ॥१३॥",
      "sourceLineId": "125903",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਾਮ ਕੇਲ ਤਾ ਸੌ ਬਹੁ ਕਿਯੋ ॥",
      "transliteration": "kaam kel taa sau bahu kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ (ਕੁਮਾਰੀ ਨੇ) ਬਹੁਤ ਕਾਮ-ਕ੍ਰੀੜੀ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "काम केल ता सौ बहु कियो ॥",
      "sourceLineId": "125904",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਹੁਰੋ ਛੋਰ ਦ੍ਵਾਰ ਕਹ ਦਿਯੋ ॥",
      "transliteration": "bahuro chhor dhavaiaar keh dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਦਰਵਾਜ਼ਾ ਖੋਲ੍ਰਹ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "बहुरो छोर द्वार कह दियो ॥",
      "sourceLineId": "125905",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪਠੈ ਸਹਚਰੀ ਪਿਤਾ ਬੁਲਾਇਯੋ ॥",
      "transliteration": "paThai sahacharee pitaa bulaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਸਖੀ ਨੂੰ ਭੇਜ ਕੇ ਪਿਤਾ ਨੂੰ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "पठै सहचरी पिता बुलाइयो ॥",
      "sourceLineId": "125906",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਨ ਮੈ ਅਧਿਕ ਜਾਰ ਦੁਖ ਪਾਯੋ ॥੧੪॥",
      "transliteration": "man mai adhik jaar dhukh paayo ||14||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਕਰ ਕੇ) ਯਾਰ ਨੇ ਮਨ ਵਿਚ ਬਹੁਤ ਦੁਖ ਪਾਇਆ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "मन मै अधिक जार दुख पायो ॥१४॥",
      "sourceLineId": "125907",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਯਾ ਕੌ ਪਿਤਾ ਮੋਹਿ ਗਹਿ ਲੈਹੈ ॥",
      "transliteration": "yaa kau pitaa moh geh laihai ||",
      "translation": "",
      "punjabiViakhya": "(ਯਾਰ ਮਨ ਵਿਚ ਸੋਚਣ ਲਗਿਆ ਕਿ) ਇਸ ਦਾ ਪਿਤਾ ਮੈਨੂੰ ਪਕੜ ਲਵੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "या कौ पिता मोहि गहि लैहै ॥",
      "sourceLineId": "125908",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਹੁਰਿ ਹਮੈ ਜਮਪੁਰੀ ਪਠੈਹੈ ॥",
      "transliteration": "bahur hamai jamapuree paThaihai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਮੈਨੂੰ ਯਮਲੋਕ ਭੇਜ ਦੇਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "बहुरि हमै जमपुरी पठैहै ॥",
      "sourceLineId": "125909",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚਿੰਤਾਤੁਰ ਥਰਹਰਿ ਕੰਪਾਵੈ ॥",
      "transliteration": "chi(n)taatur tharahar ka(n)paavai ||",
      "translation": "",
      "punjabiViakhya": "ਚਿੰਤਾਵਾਨ ਹੋ ਕੇ ਥਰ ਥਰ ਕੰਬਣ ਲਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "चिंतातुर थरहरि कंपावै ॥",
      "sourceLineId": "125910",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜ੍ਯੋਂ ਕਦਲੀ ਕਹ ਬਾਤ ਡੁਲਾਵੈ ॥੧੫॥",
      "transliteration": "jayo(n) kadhalee keh baat ddulaavai ||15||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕੇਲੇ ਦੇ ਬੂਟੇ ਨੂੰ ਹਵਾ ਹਿਲਾਉਾਂਦੀ ਹੈ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "ज्यों कदली कह बात डुलावै ॥१५॥",
      "sourceLineId": "125911",
      "sourceShabadId": "11812",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਾਰ ਬਾਚ ॥",
      "transliteration": "jaar baach ||",
      "translation": "",
      "punjabiViakhya": "ਯਾਰ ਨੇ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "जार बाच ॥",
      "sourceLineId": "125912",
      "sourceShabadId": "11813",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "125913",
      "sourceShabadId": "11813",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮੋਰੇ ਪ੍ਰਾਨ ਰਾਖਿ ਅਬ ਲੀਜੈ ॥",
      "transliteration": "more praan raakh ab leejai ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੇਰੀ ਜਾਨ ਬਚਾ ਲੈ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "मोरे प्रान राखि अब लीजै ॥",
      "sourceLineId": "125914",
      "sourceShabadId": "11813",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਾਹਕ ਮੁਹਿ ਨ ਅਜਾਏ ਕੀਜੈ ॥",
      "transliteration": "naahak muh na ajaae keejai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੈਨੂੰ ਵਿਅਰਥ ਵਿਚ ਨਾ ਖ਼ਤਮ ਕਰਵਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "नाहक मुहि न अजाए कीजै ॥",
      "sourceLineId": "125915",
      "sourceShabadId": "11813",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੋਰੋ ਮੂੰਡਿ ਕਾਟ ਨ੍ਰਿਪ ਦੈਹੈ ॥",
      "transliteration": "moro moo(n)dd kaaT nirap dhaihai ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰਾ ਸਿਰ ਰਾਜਾ ਕਟ ਦੇਵੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "मोरो मूँडि काट नृप दैहै ॥",
      "sourceLineId": "125916",
      "sourceShabadId": "11813",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਾਪਰਦੀ ਕੇ ਕੰਠ ਚੜੈਹੈ ॥੧੬॥",
      "transliteration": "kaaparadhee ke ka(n)Th chaRaihai ||16||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਿਵ ('ਕਾਪਰਦੀ') ਦੇ ਗਲੇ ਵਿਚ ਪਾ ਦੇਵੇਗਾ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "कापरदी के कंठ चड़ैहै ॥१६॥",
      "sourceLineId": "125917",
      "sourceShabadId": "11813",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੁਤਾ ਬਾਚ ॥",
      "transliteration": "sutaa baach ||",
      "translation": "",
      "punjabiViakhya": "ਪੁੱਤਰੀ ਨੇ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "सुता बाच ॥",
      "sourceLineId": "125918",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "125919",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਿਨ ਕਹਿਯੋ ਤਰੁਨ ਨ ਚਿੰਤਾ ਕਰੋ ॥",
      "transliteration": "tin kahiyo tarun na chi(n)taa karo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਕਿਹਾ, ਹੇ ਨੌਜਵਾਨ! ਚਿੰਤਾ ਨਾ ਕਰ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "तिन कहियो तरुन न चिंता करो ॥",
      "sourceLineId": "125920",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਧੀਰਜ ਚਿਤ ਆਪਨੇ ਧਰੋ ॥",
      "transliteration": "dheeraj chit aapane dharo ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਚਿਤ ਵਿਚ ਧੀਰਜ ਧਾਰਨ ਕਰ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "धीरज चित आपने धरो ॥",
      "sourceLineId": "125921",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤੇਰੋ ਅਬ ਮੈ ਪ੍ਰਾਨ ਉਬਰਿਹੌ ॥",
      "transliteration": "tero ab mai praan ubarihau ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਹੁਣ ਤੇਰੇ ਪ੍ਰਾਣ ਬਚਾਉਾਂਦੀ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "तेरो अब मै प्रान उबरिहौ ॥",
      "sourceLineId": "125922",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪਿਤ ਹੇਰਤ ਤੋ ਕੌ ਪਤਿ ਕਰਿਹੌ ॥੧੭॥",
      "transliteration": "pit herat to kau pat karihau ||17||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਿਤਾ ਦੇ ਵੇਖਦਿਆਂ ਵੇਖਦਿਆਂ ਤੈਨੂੰ ਪਤੀ (ਵਜੋਂ ਗ੍ਰਹਿਣ) ਕਰਦੀ ਹਾ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "पित हेरत तो कौ पति करिहौ ॥१७॥",
      "sourceLineId": "125923",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਆਪ ਪਿਤਾ ਤਨ ਜਾਇ ਉਚਰੀ ॥",
      "transliteration": "aap pitaa tan jai ucharee ||",
      "translation": "",
      "punjabiViakhya": "ਆਪ (ਕੁਮਾਰੀ) ਪਿਤਾ ਕੋਲ ਜਾ ਕੇ ਕਹਿਣ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "आप पिता तन जाइ उचरी ॥",
      "sourceLineId": "125924",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮੋ ਪਰ ਕ੍ਰਿਪਾ ਅਧਿਕ ਸਿਵ ਕਰੀ ॥",
      "transliteration": "mo par kirapaa adhik siv karee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮੇਰੇ ਉਤੇ ਸ਼ਿਵ ਜੀ ਨੇ ਬਹੁਤ ਕ੍ਰਿਪਾ ਕੀਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "मो पर कृपा अधिक सिव करी ॥",
      "sourceLineId": "125925",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਿਜੁ ਕਰ ਪਕਰਿ ਮੋਹਿ ਪਤਿ ਦੀਨੋ ॥",
      "transliteration": "nij kar pakar moh pat dheeno ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਹੱਥ ਨਾਲ ਪਕੜ ਕੇ ਮੈਨੂੰ ਪਤੀ ਦਿੱਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "निजु कर पकरि मोहि पति दीनो ॥",
      "sourceLineId": "125926",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਹਮ ਪਰ ਅਧਿਕ ਅਨੁਗ੍ਰਹ ਕੀਨੋ ॥੧੮॥",
      "transliteration": "ham par adhik anugreh keeno ||18||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੇ ਉਤੇ ਬਹੁਤ ਮਿਹਰ ਕੀਤੀ ਹੈ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "हम पर अधिक अनुग्रह कीनो ॥१८॥",
      "sourceLineId": "125927",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਚਲਹੁ ਪਿਤਾ ਤਹ ਤਾਹਿ ਦਿਖਾਊ ॥",
      "transliteration": "chalahu pitaa teh taeh dhikhaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਿਤਾ ਜੀ! ਚਲੋ, ਉਹ ਤੁਹਾਨੂੰ ਵਿਖਾਉਾਂਦੀ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "चलहु पिता तह ताहि दिखाऊ ॥",
      "sourceLineId": "125928",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਾ ਸੌ ਬਹੁਰਿ ਸੁ ਬ੍ਯਾਹ ਕਰਾਊ ॥",
      "transliteration": "taa sau bahur su bayaeh karaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਉਸ ਨਾਲ ਵਿਆਹ ਕਰਵਾਉਾਂਦੀ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "ता सौ बहुरि सु ब्याह कराऊ ॥",
      "sourceLineId": "125929",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਾਹਿ ਪਕਰਿ ਰਾਜਾ ਕੌ ਲ੍ਯਾਈ ॥",
      "transliteration": "baeh pakar raajaa kau layaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬਾਹ ਪਕੜ ਕੇ ਰਾਜੇ ਨੂੰ ਲੈ ਆਈ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "बाहि पकरि राजा कौ ल्याई ॥",
      "sourceLineId": "125930",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਆਨਿ ਜਾਰ ਸੌ ਦਿਯੋ ਦਿਖਾਈ ॥੧੯॥",
      "transliteration": "aan jaar sau dhiyo dhikhaiee ||19||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆ ਕੇ (ਆਪਣਾ) ਮਿਤਰ ਵਿਖਾ ਦਿੱਤਾ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "आनि जार सौ दियो दिखाई ॥१९॥",
      "sourceLineId": "125931",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਧੰਨ੍ਯ ਧੰਨ੍ਯ ਤਾ ਕੌ ਪਿਤੁ ਕਹਿਯੋ ॥",
      "transliteration": "dha(n)nay dha(n)nay taa kau pit kahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਤਾ ਨੇ ਉਸ ਨੂੰ ਧੰਨ ਧੰਨ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "धंन्य धंन्य ता कौ पितु कहियो ॥",
      "sourceLineId": "125932",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਰ ਸੌ ਕਰਿ ਦੁਹਿਤਾ ਕੌ ਗਹਿਯੋ ॥",
      "transliteration": "kar sau kar dhuhitaa kau gahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਹੱਥ ਨਾਲ ਪੁੱਤਰੀ ਦਾ ਹੱਥ ਪਕੜ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "कर सौ करि दुहिता कौ गहियो ॥",
      "sourceLineId": "125933",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਕਟਾਛ ਅਧਿਕ ਸਿਵ ਕੀਨੋ ॥",
      "transliteration": "kirapaa kaTaachh adhik siv keeno ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ ਕਿਹਾ) ਸ਼ਿਵ ਜੀ ਨੇ ਬਹੁਤ ਮਿਹਰ ਦੀ ਦ੍ਰਿਸ਼ਟੀ ਕੀਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "कृपा कटाछ अधिक सिव कीनो ॥",
      "sourceLineId": "125934",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਾ ਤੇ ਬਰ ਉਤਮ ਤੁਹਿ ਦੀਨੋ ॥੨੦॥",
      "transliteration": "taa te bar utam tuh dheeno ||20||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਤੈਨੂੰ ਉਤਮ ਵਰ ਦਿੱਤਾ ਹੈ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "ता ते बर उतम तुहि दीनो ॥२०॥",
      "sourceLineId": "125935",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤੁਮ ਪਰ ਕ੍ਰਿਪਾ ਜੁ ਸਿਵ ਜੂ ਕੀਨੀ ॥",
      "transliteration": "tum par kirapaa ju siv joo keenee ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਰੇ ਉਤੇ ਸ਼ਿਵ ਜੀ ਨੇ ਜੋ ਕ੍ਰਿਪਾ ਕੀਤੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "तुम पर कृपा जु सिव जू कीनी ॥",
      "sourceLineId": "125936",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਮਹੂੰ ਆਜੁ ਤਾਹਿ ਤੁਹਿ ਦੀਨੀ ॥",
      "transliteration": "hamahoo(n) aaj taeh tuh dheenee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਵਾਸਤੇ) ਅਜ ਮੈ ਤੈਨੂੰ ਉਸੇ ਨੂੰ ਸੌਂਪਦਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "हमहूँ आजु ताहि तुहि दीनी ॥",
      "sourceLineId": "125937",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬੋਲਿ ਦਿਜਨ ਕਹ ਬ੍ਯਾਹ ਕਰਾਯੋ ॥",
      "transliteration": "bol dhijan keh bayaeh karaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਬ੍ਰਾਹਮਣਾ ਨੂੰ ਬੁਲਾ ਕੇ ਵਿਆਹ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "बोलि दिजन कह ब्याह करायो ॥",
      "sourceLineId": "125938",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਮੂੜ ਨਹਿ ਪਾਯੋ ॥੨੧॥",
      "transliteration": "bhedh abhedh mooR neh paayo ||21||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ (ਰਾਜਾ) ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਾ ਪਾ ਸਕਿਆ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद मूड़ नहि पायो ॥२१॥",
      "sourceLineId": "125939",
      "sourceShabadId": "11814",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "125940",
      "sourceShabadId": "11815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਤਹ ਚੰਚਲਾ ਬ੍ਯਾਹ ਜਾਰ ਸੋ ਕੀਨ ॥",
      "transliteration": "eeh charitr teh cha(n)chalaa bayaeh jaar so keen ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਚਰਿਤ੍ਰ ਨਾਲ ਉਸ ਇਸਤਰੀ ਨੇ ਯਾਰ ਨਾਲ ਵਿਆਹ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र तह चंचला ब्याह जार सो कीन ॥",
      "sourceLineId": "125941",
      "sourceShabadId": "11815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਪਿਤੁ ਹੂੰ ਲੈ ਤਾ ਕੋ ਦਈ ਸਕ੍ਯੋ ਨ ਛਲ ਜੜ ਚੀਨ ॥੨੨॥",
      "transliteration": "pit hoo(n) lai taa ko dhiee sakayo na chhal jaR cheen ||22||",
      "translation": "",
      "punjabiViakhya": "ਪਿਤਾ ਨੇ ਹੀ ਲੈ ਕੇ ਉਸ ਨੂੰ ਦੇ ਦਿੱਤਾ। (ਉਹ) ਮੂਰਖ ਛਲ ਨੂੰ ਸਮਝ ਨਾ ਸਕਿਆ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "पितु हूँ लै ता को दई सक्यो न छल जड़ चीन ॥२२॥",
      "sourceLineId": "125942",
      "sourceShabadId": "11815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਤੇਰਹ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੧੩॥੪੦੯੬॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau tereh charitr samaapatam sat subham sat ||213||4096||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੨੧੩ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੧੩॥੪੦੯੬॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ तेरह चरित्र समापतम सतु सुभम सतु ॥२१३॥४०९६॥अफजूँ॥",
      "sourceLineId": "125943",
      "sourceShabadId": "11815",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "125944",
      "sourceShabadId": "11816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਚਾਦਾ ਸਹਿਰ ਬਸਤ ਜਹ ਭਾਰੋ ॥",
      "transliteration": "chaadhaa sahir basat jeh bhaaro ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਚਾਦਾ ਨਾ ਦਾ ਵੱਡਾ ਸ਼ਹਿਰ ਵਸਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "चादा सहिर बसत जह भारो ॥",
      "sourceLineId": "125945",
      "sourceShabadId": "11816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਧਰਨੀ ਤਲ ਮਹਿ ਅਤਿ ਉਜਿਯਾਰੋ ॥",
      "transliteration": "dharanee tal meh at ujiyaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਜੋ) ਧਰਤੀ ਉਤੇ ਬਹੁਤ ਪ੍ਰਸਿੱਧ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "धरनी तल महि अति उजियारो ॥",
      "sourceLineId": "125946",
      "sourceShabadId": "11816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਬਿਸੁਨ ਕੇਤੁ ਰਾਜਾ ਤਹ ਰਹਈ ॥",
      "transliteration": "bisun ket raajaa teh rahiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਬਿਸਨ ਕੇਤੁ ਨਾ ਦਾ ਰਾਜਾ ਰਹਿੰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "बिसुन केतु राजा तह रहई ॥",
      "sourceLineId": "125947",
      "sourceShabadId": "11816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਕਰਮ ਧਰਮ ਸੁਚਿ ਬ੍ਰਤ ਖਗ ਕਹਈ ॥੧॥",
      "transliteration": "karam dharam such brat khag kahiee ||1||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਕਰਮ, ਧਰਮ, ਪਵਿਤ੍ਰਤਾ, ਬ੍ਰਤ ਅਤੇ ਤਲਵਾਰ ਵਿਚ ਪ੍ਰਬੀਨ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "करम धरम सुचि ब्रत खग कहई ॥१॥",
      "sourceLineId": "125948",
      "sourceShabadId": "11816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਸ੍ਰੀ ਬੁੰਦੇਲ ਮਤੀ ਤਾ ਕੀ ਤ੍ਰਿਯ ॥",
      "transliteration": "sree bu(n)dhel matee taa kee tiray ||",
      "translation": "",
      "punjabiViakhya": "ਬੁੰਦੇਲ ਮਤੀ ਨਾ ਦੀ ਉਸ ਦੀ ਇਸਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "स्री बुँदेल मती ता की तृय ॥",
      "sourceLineId": "125949",
      "sourceShabadId": "11816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਜਾ ਮਹਿ ਬਸਤ ਸਦਾ ਨ੍ਰਿਪ ਕੋ ਜਿਯ ॥",
      "transliteration": "jaa meh basat sadhaa nirap ko jiy ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਿਚ ਰਾਜੇ ਦਾ ਮਨ ਸਦਾ ਸਮਾਇਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "जा महि बसत सदा नृप को जिय ॥",
      "sourceLineId": "125950",
      "sourceShabadId": "11816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਸ੍ਰੀ ਗੁਲਜਾਰ ਮਤੀ ਦੁਹਿਤਾ ਤਿਹ ॥",
      "transliteration": "sree gulajaar matee dhuhitaa teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪੁੱਤਰੀ ਦਾ ਨਾ ਗੁਲਜ਼ਾਰ ਮਤੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "स्री गुलजार मती दुहिता तिह ॥",
      "sourceLineId": "125951",
      "sourceShabadId": "11816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਕਹੂੰ ਨ ਤਰੁਨਿ ਜਗਤ ਮੈ ਸਮ ਜਿਹ ॥੨॥",
      "transliteration": "kahoo(n) na tarun jagat mai sam jeh ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਸੰਸਾਰ ਵਿਚ ਕੋਈ ਮੁਟਿਆਰ ਨਹੀਂ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "कहूँ न तरुनि जगत मै सम जिह ॥२॥",
      "sourceLineId": "125952",
      "sourceShabadId": "11816",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "125953",
      "sourceShabadId": "11817",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਤਿਨ ਇਕ ਤਰੁਨ ਬਿਲੋਕਿਯੋ ਅਮਿਤ ਰੂਪ ਕੀ ਖਾਨਿ ॥",
      "transliteration": "tin ik tarun bilokiyo amit roop kee khaan ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਅਪਾਰ ਸੁੰਦਰਤਾ ਦੇ ਖਾਣ ਵਰਗਾ ਇਕ ਨੌਜਵਾਨ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "तिन इक तरुन बिलोकियो अमित रूप की खानि ॥",
      "sourceLineId": "125954",
      "sourceShabadId": "11817",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਲੀਨੋ ਸਦਨ ਬੁਲਾਇ ਕੈ ਰਮਤ ਭਈ ਰੁਚਿ ਮਾਨਿ ॥੩॥",
      "transliteration": "leeno sadhan bulai kai ramat bhiee ruch maan ||3||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਘਰ ਬੁਲਾ ਕੇ ਰੁਚੀ ਪੂਰਵਕ ਉਸ ਨਾਲ ਰਮਣ ਕੀਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "लीनो सदन बुलाइ कै रमत भई रुचि मानि ॥३॥",
      "sourceLineId": "125955",
      "sourceShabadId": "11817",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "125956",
      "sourceShabadId": "11818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਤਾ ਸੌ ਲਪਟਿ ਕਰਤ ਰਸ ਭਈ ॥",
      "transliteration": "taa sau lapaT karat ras bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਲਿਪਟ ਕੇ ਆਨੰਦ ਲੈਣ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "ता सौ लपटि करत रस भई ॥",
      "sourceLineId": "125957",
      "sourceShabadId": "11818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਗ੍ਰਿਹ ਕੀ ਸੁਧਿ ਸਭਹੂੰ ਤਜਿ ਦਈ ॥",
      "transliteration": "gireh kee sudh sabhahoo(n) taj dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘਰ ਦੀ ਸਭ ਸੁੱਧ ਬੁੱਧ ਭੁਲਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "गृह की सुधि सभहूँ तजि दई ॥",
      "sourceLineId": "125958",
      "sourceShabadId": "11818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਨਿਸ ਦਿਨ ਤਾ ਸੌ ਭੋਗ ਕਮਾਵੈ ॥",
      "transliteration": "nis dhin taa sau bhog kamaavai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਦਿਨ ਉਸ ਨਾਲ ਭੋਗ ਕਰਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "निस दिन ता सौ भोग कमावै ॥",
      "sourceLineId": "125959",
      "sourceShabadId": "11818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਲਪਟਿ ਲਪਟਿ ਤਾ ਕੇ ਉਰ ਜਾਵੈ ॥੪॥",
      "transliteration": "lapaT lapaT taa ke ur jaavai ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਲਿਪਟ ਲਿਪਟ ਕੇ ਗਲੇ ਨਾਲ ਲਗਾਉਾਂਦੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "लपटि लपटि ता के उर जावै ॥४॥",
      "sourceLineId": "125960",
      "sourceShabadId": "11818",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "125961",
      "sourceShabadId": "11819",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1114_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਤਰੁਨ ਪੁਰਖ ਤਰੁਨੀ ਤਰੁਨ ਬਾਢੀ ਪ੍ਰੀਤਿ ਅਪਾਰ ॥",
      "transliteration": "tarun purakh tarunee tarun baaddee preet apaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਵਾਨ ਮਰਦ ਅਤੇ ਜਵਾਨ ਔਰਤ (ਹੋਣ ਕਰ ਕੇ ਦੋਹਾ ਵਿਚ) ਬਹੁਤ ਅਧਿਕ ਪ੍ਰੀਤ ਵੱਧ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1114,
      "hindi": "",
      "hindiTransliteration": "तरुन पुरख तरुनी तरुन बाढी प्रीति अपार ॥",
      "sourceLineId": "125962",
      "sourceShabadId": "11819",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
