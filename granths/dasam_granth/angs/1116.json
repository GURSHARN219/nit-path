{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1116,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1116_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਇਹੈ ਆਪਨੇ ਚਿਤ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "eihai aapane chit bichaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਆਪਣੇ ਚਿਤ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਵਿਚਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "इहै आपने चित बिचारियो ॥",
      "sourceLineId": "126011",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਯਾ ਕੌ ਭਲੀ ਭਾਤਿ ਗਹਿ ਤੋਰੋ ॥",
      "transliteration": "yaa kau bhalee bhaat geh toro ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨੂੰ (ਮੈਂ) ਚੰਗੀ ਤਰ੍ਰਹਾ ਪਕੜ ਕੇ ਤੋੜਾਗਾ (ਅਰਥਾਤ-ਕਾਮ-ਭੋਗ ਵਿਚ ਥਕਾ ਦਿਆਂਗਾ)।",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "या कौ भली भाति गहि तोरो ॥",
      "sourceLineId": "126012",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬ੍ਰਾਹਮਨੀ ਹਮ ਨ ਕਛੁ ਛੋਰੋ ॥੩॥",
      "transliteration": "braahamanee ham na kachh chhoro ||3||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਾਹਮਣੀ ਹੋਣ ਤੇ ਵੀ ਮੈਂ (ਇਸ ਨੂੰ) ਬਿਲਕੁਲ ਨਹੀਂ ਛਡਾਗਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "ब्राहमनी हम न कछु छोरो ॥३॥",
      "sourceLineId": "126013",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਏਕ ਸਹਿਚਰੀ ਤਹਾ ਪਠਾਈ ॥",
      "transliteration": "ek sahicharee tahaa paThaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਇਕ ਦਾਸੀ ਉਸ ਪਾਸ ਭੇਜੀ",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "एक सहिचरी तहा पठाई ॥",
      "sourceLineId": "126014",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਰੁਨਿ ਕੁਅਰਿ ਤਨ ਬਾਤ ਜਤਾਈ ॥",
      "transliteration": "tarun kuar tan baat jataiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਵਾਨ ਲੜਕੀ ਤਕ (ਆਪਣੇ ਮਨ ਦੀ) ਗੱਲ ਪਹੁੰਚਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "तरुनि कुअरि तन बात जताई ॥",
      "sourceLineId": "126015",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਆਜੁ ਨ੍ਰਿਪਤਿ ਕੇ ਸਦਨ ਸਿਧਾਰੋ ॥",
      "transliteration": "aaj nirapat ke sadhan sidhaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਦਾਸੀ ਨੇ ਉਸ ਨੂੰ ਸਮਝਾਇਆ ਕਿ) ਅਜ ਰਾਜੇ ਦੇ ਮਹੱਲ ਵਿਚ ਜਾਓ",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "आजु नृपति के सदन सिधारो ॥",
      "sourceLineId": "126016",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਲਪਟਿ ਲਪਟਿ ਤਿਹ ਸੰਗ ਬਿਹਾਰੋ ॥੪॥",
      "transliteration": "lapaT lapaT teh sa(n)g bihaaro ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲਿਪਟ ਲਿਪਟ ਕੇ ਉਸ ਨਾਲ ਸੰਯੋਗ ਕਰੋ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "लपटि लपटि तिह संग बिहारो ॥४॥",
      "sourceLineId": "126017",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਰੁਨਿ ਕੁਅਰਿ ਮਨ ਮੈ ਯੌ ਕਹੀ ॥",
      "transliteration": "tarun kuar man mai yau kahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਜਵਾਨ ਲੜਕੀ ਨੇ ਮਨ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਸੋਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "तरुनि कुअरि मन मै यौ कही ॥",
      "sourceLineId": "126018",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹਮਰੀ ਬਾਤ ਧਰਮ ਕੀ ਰਹੀ ॥",
      "transliteration": "hamaree baat dharam kee rahee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮੇਰੇ ਧਰਮ ਦੀ ਗੱਲ ਟਲ ਰਹੀ ਹੈ (ਭਾਵ-ਧਰਮ ਭ੍ਰਸ਼ਟ ਹੁੰਦਾ ਦਿਸਦਾ ਹੈ)।",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "हमरी बात धरम की रही ॥",
      "sourceLineId": "126019",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਹਾ ਭਾਖੌ ਤੌ ਧਰਮ ਗਵਾਊਾਂ ॥",
      "transliteration": "haa bhaakhau tau dharam gavaauooaa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹਾ' ਕਹਿੰਦੀ ਹਾ ਤਾ ਧਰਮ ਨਸ਼ਟ ਕਰਵਾ ਲਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "हा भाखौ तौ धरम गवाऊाँ ॥",
      "sourceLineId": "126020",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਹਿ ਕਰੇ ਬਾਧੀ ਘਰ ਜਾਊਾਂ ॥੫॥",
      "transliteration": "naeh kare baadhee ghar jaauooaa(n) ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ 'ਨਾਹ' ਕਰਦੀ ਹਾ ਤਾ ਘਰੋਂ ਬੰਨ੍ਰਹੀ ਹੋਈ ਜਾਵਾਗੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "नाहि करे बाधी घर जाऊाँ ॥५॥",
      "sourceLineId": "126021",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਾ ਤੇ ਜਤਨ ਐਸ ਕਛੁ ਕਰਿਯੈ ॥",
      "transliteration": "taa te jatan aais kachh kariyai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਕਰ ਕੇ ਕੁਝ ਅਜਿਹਾ ਯਤਨ ਕਰਨਾ ਚਾਹੀਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "ता ते जतन ऐस कछु करियै ॥",
      "sourceLineId": "126022",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਧਰਮ ਰਾਖਿ ਮੂਰਖ ਕਹ ਮਰਿਯੈ ॥",
      "transliteration": "dharam raakh moorakh keh mariyai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਧਰਮ ਨੂੰ ਬਚਾ ਕੇ ਮੂਰਖ (ਰਾਜੇ) ਨੂੰ ਮਾਰ ਦਿੱਤਾ ਜਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "धरम राखि मूरख कह मरियै ॥",
      "sourceLineId": "126023",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਹਿ ਨਾਮ ਪਾਪੀ ਸੁਨਿ ਲੈਹੈ ॥",
      "transliteration": "naeh naam paapee sun laihai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਪਾਪੀ ਜਦੋਂ 'ਨਾਹ' ਸ਼ਬਦ ਸੁਣ ਲਵੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "नाहि नाम पापी सुनि लैहै ॥",
      "sourceLineId": "126024",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਖਾਟਿ ਉਠਾਇ ਮੰਗਾਇ ਪਠੈਹੈ ॥੬॥",
      "transliteration": "khaaT uThai ma(n)gai paThaihai ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮੰਜੀ (ਸਮੇਤ) ਉਠਵਾ ਕੇ ਮੰਗਵਾ ਲਵੇਗਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "खाटि उठाइ मंगाइ पठैहै ॥६॥",
      "sourceLineId": "126025",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਬ ਤਿਨ ਕਹਿਯੋ ਬਚਨ ਸਹਚਰਿ ਸੁਨਿ ॥",
      "transliteration": "tab tin kahiyo bachan sahachar sun ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਨੇ ਦਾਸੀ ਨੂੰ ਕਿਹਾ, (ਮੇਰੀ) ਗੱਲ ਸੁਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "तब तिन कहियो बचन सहचरि सुनि ॥",
      "sourceLineId": "126026",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪੂਜਨ ਕਾਲਿ ਜਾਊਗੀ ਮੈ ਮੁਨਿ ॥",
      "transliteration": "poojan kaal jaauoogee mai mun ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੂੰ ਕਹੀਂ ਕਿ) ਮੈਂ ਕਲ 'ਮੁਨਿ' (ਸ਼ਿਵ) ਨੂੰ ਪੂਜਣ ਜਾਵਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "पूजन कालि जाऊगी मै मुनि ॥",
      "sourceLineId": "126027",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਹ ਹੀ ਆਪ ਨ੍ਰਿਪਤਿ ਤੁਮ ਐਯਹੁ ॥",
      "transliteration": "teh hee aap nirapat tum aaiyahu ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਹੀ ਹੇ ਰਾਜਨ! ਤੁਸੀਂ ਆਪ ਆ ਜਾਣਾ",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "तह ही आप नृपति तुम ऐयहु ॥",
      "sourceLineId": "126028",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਮੁਹਿ ਸਾਥ ਕਮੈਯਹੁ ॥੭॥",
      "transliteration": "kaam bhog muh saath kamaiyahu ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੇ ਨਾਲ ਕਾਮ-ਭੋਗ ਕਰਨਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "काम भोग मुहि साथ कमैयहु ॥७॥",
      "sourceLineId": "126029",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਭੋਰ ਭਯੋ ਪੂਜਨ ਸਿਵ ਗਈ ॥",
      "transliteration": "bhor bhayo poojan siv giee ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੇਰ ਹੋਣ ਤੇ (ਉਹ) ਸ਼ਿਵ ਪੂਜਾ ਲਈ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "भोर भयो पूजन सिव गई ॥",
      "sourceLineId": "126030",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨ੍ਰਿਪਹੂੰ ਤਹਾ ਬੁਲਾਵਤ ਭਈ ॥",
      "transliteration": "nirapahoo(n) tahaa bulaavat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੂੰ ਉਥੇ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "नृपहूँ तहा बुलावत भई ॥",
      "sourceLineId": "126031",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਉਤੈ ਦੁਸਮਨਨ ਦੂਤ ਪਠਾਯੋ ॥",
      "transliteration": "autai dhusamanan dhoot paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਧਰ ਦੁਸ਼ਮਣ ਵਲ ਦੂਤ ਭੇਜ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "उतै दुसमनन दूत पठायो ॥",
      "sourceLineId": "126032",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੰਭਹਿ ਮ੍ਰਿਤੁ ਸ੍ਵਾਨ ਕੀ ਘਾਯੋ ॥੮॥",
      "transliteration": "sa(n)bheh mrit savaiaan kee ghaayo ||8||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਸੰਭਾ ਨੂੰ ਕੁੱਤੇ ਦੀ ਮੌਤੇ ਮਾਰੋ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "संभहि मृतु स्वान की घायो ॥८॥",
      "sourceLineId": "126033",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਬ ਹੀ ਫੌਜ ਸਤ੍ਰੁ ਕੀ ਧਈ ॥",
      "transliteration": "jab hee fauaj satr kee dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਵੈਰੀ ਦੀ ਫ਼ੌਜ ਚੜ੍ਰਹ ਆਈ",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "जब ही फौज सत्रु की धई ॥",
      "sourceLineId": "126034",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਬਲਾ ਸਹਿਤ ਨ੍ਰਿਪਤਿ ਗਹਿ ਲਈ ॥",
      "transliteration": "abalaa sahit nirapat geh liee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਸਤਰੀ ਸਮੇਤ ਰਾਜੇ ਨੂੰ ਪਕੜ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "अबला सहित नृपति गहि लई ॥",
      "sourceLineId": "126035",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਿਰਖਿ ਰੂਪ ਤਾ ਕੋ ਲਲਚਾਯੋ ॥",
      "transliteration": "nirakh roop taa ko lalachaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਲੜਕੀ ਦਾ) ਰੂਪ ਵੇਖ ਕੇ ਵੈਰੀ ਵੀ ਲਲਚਾ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "निरखि रूप ता को ललचायो ॥",
      "sourceLineId": "126036",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਭੋਗ ਕਰਨ ਤਾ ਸੌ ਚਿਤ ਭਾਯੋ ॥੯॥",
      "transliteration": "bhog karan taa sau chit bhaayo ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਭੋਗ ਕਰਨ ਲਈ ਮਨ ਵਿਚ ਸੋਚਣ ਲਗਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "भोग करन ता सौ चित भायो ॥९॥",
      "sourceLineId": "126037",
      "sourceShabadId": "11824",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "126038",
      "sourceShabadId": "11825",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਰੁਨ ਕਲਾ ਤਰੁਨੀ ਤਬੈ ਅਧਿਕ ਕਟਾਛ ਦਿਖਾਇ ॥",
      "transliteration": "tarun kalaa tarunee tabai adhik kaTaachh dhikhai ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਰੁਨ ਕਲਾ ਨਾ ਦੀ ਇਸਤਰੀ ਨੇ ਉਸ ਨੂੰ ਬਹੁਤ ਅਧਿਕ ਹਾਵ ਭਾਵ ਵਿਖਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "तरुन कला तरुनी तबै अधिक कटाछ दिखाइ ॥",
      "sourceLineId": "126039",
      "sourceShabadId": "11825",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮੂੜ ਮੁਗਲ ਕੌ ਆਤਮਾ ਛਿਨ ਮੈ ਲਯੋ ਚੁਰਾਇ ॥੧੦॥",
      "transliteration": "mooR mugal kau aatamaa chhin mai layo churai ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੂਰਖ ਮੁਗ਼ਲ ਦੀ ਆਤਮਾ ਨੂੰ ਛਿਣ ਭਰ ਵਿਚ ਚੁਰਾ ਲਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "मूड़ मुगल कौ आतमा छिन मै लयो चुराइ ॥१०॥",
      "sourceLineId": "126040",
      "sourceShabadId": "11825",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "126041",
      "sourceShabadId": "11826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਧਿਕ ਕੈਫ ਤਬ ਤਾਹਿ ਪਿਵਾਈ ॥",
      "transliteration": "adhik kaif tab taeh pivaiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਨੂੰ ਬਹੁਤ ਸ਼ਰਾਬ ਪਿਲਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "अधिक कैफ तब ताहि पिवाई ॥",
      "sourceLineId": "126042",
      "sourceShabadId": "11826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਤਾਹਿ ਗਰੇ ਲਪਟਾਈ ॥",
      "transliteration": "bahu bidh taeh gare lapaTaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਢੰਗ ਨਾਲ ਉਸ ਦੇ ਗਲੇ ਨਾਲ ਲਿਪਟੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि ताहि गरे लपटाई ॥",
      "sourceLineId": "126043",
      "sourceShabadId": "11826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦੋਊ ਏਕ ਖਾਟ ਪਰ ਸੋਏ ॥",
      "transliteration": "dhouoo ek khaaT par soe ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਇਕ ਮੰਜੀ ਉਤੇ ਸੁਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "दोऊ एक खाट पर सोए ॥",
      "sourceLineId": "126044",
      "sourceShabadId": "11826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਨ ਕੇ ਮੁਗਲ ਸਗਲ ਦੁਖ ਖੋਏ ॥੧੧॥",
      "transliteration": "man ke mugal sagal dhukh khoe ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੁਗ਼ਲ ਨੇ ਆਪਣੇ ਮਨ ਦੇ ਸਾਰੇ ਦੁਖ ਖ਼ਤਮ ਕਰ ਦਿੱਤੇ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "मन के मुगल सगल दुख खोए ॥११॥",
      "sourceLineId": "126045",
      "sourceShabadId": "11826",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "126046",
      "sourceShabadId": "11827",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਿਰਖਿ ਮੁਗਲ ਸੋਯੋ ਪਰਿਯੋ ਕਾਢਿ ਲਈ ਕਰਵਾਰਿ ॥",
      "transliteration": "nirakh mugal soyo pariyo kaadd liee karavaar ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਗ਼ਲ ਨੂੰ ਸੁਤਾ ਹੋਇਆ ਵੇਖ ਕੇ (ਲੜਕੀ ਨੇ) ਤਲਵਾਰ ਕਢ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "निरखि मुगल सोयो परियो काढि लई करवारि ॥",
      "sourceLineId": "126047",
      "sourceShabadId": "11827",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਾਟਿ ਕੰਠ ਤਾ ਕੋ ਗਈ ਅਪਨੋ ਧਰਮ ਉਬਾਰਿ ॥੧੨॥",
      "transliteration": "kaaT ka(n)Th taa ko giee apano dharam ubaar ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦਾ ਗੱਲਾ ਕਟ ਕੇ ਆਪਣੇ ਧਰਮ ਨੂੰ ਬਚਾ ਕੇ ਚਲੀ ਗਈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "काटि कंठ ता को गई अपनो धरम उबारि ॥१२॥",
      "sourceLineId": "126048",
      "sourceShabadId": "11827",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚੰਚਲਾਨ ਕੇ ਚਰਿਤ੍ਰ ਕੋ ਚੀਨਿ ਸਕਤ ਨਹਿ ਕੋਇ ॥",
      "transliteration": "cha(n)chalaan ke charitr ko cheen sakat neh koi ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀਆਂ ਦੇ ਚਰਿਤ੍ਰ ਨੂੰ ਕੋਈ ਵੀ ਸਮਝ ਨਹੀਂ ਸਕਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "चंचलान के चरित्र को चीनि सकत नहि कोइ ॥",
      "sourceLineId": "126049",
      "sourceShabadId": "11827",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬ੍ਰਹਮ ਬਿਸਨ ਰੁਦ੍ਰਾਦਿ ਸਭ ਸੁਰ ਸੁਰਪਤਿ ਕੋਊ ਹੋਇ ॥੧੩॥",
      "transliteration": "braham bisan rudhraadh sabh sur surapat kouoo hoi ||13||",
      "translation": "",
      "punjabiViakhya": "ਭਾਵੇਾਂ ਬ੍ਰਹਮਾ, ਵਿਸ਼ਣੂ, ਰੁਦ੍ਰ, ਸਾਰੇ ਦੇਵਤੇ ਅਤੇ ਇੰਦਰ ਵੀ ਕਿਉਾਂ ਨਾ ਹੋਵੇ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "ब्रहम बिसन रुद्रादि सभ सुर सुरपति कोऊ होइ ॥१३॥",
      "sourceLineId": "126050",
      "sourceShabadId": "11827",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਪੰਦਰਹ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੧੫॥੪੧੨੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau pa(n)dhareh charitr samaapatam sat subham sat ||215||4123||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੨੧੫ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੧੫॥੪੧੨੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ पंदरह चरित्र समापतम सतु सुभम सतु ॥२१५॥४१२३॥अफजूँ॥",
      "sourceLineId": "126051",
      "sourceShabadId": "11827",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "126052",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜੋਗੀ ਇਕ ਗਹਬਰ ਬਨ ਰਹਈ ॥",
      "transliteration": "jogee ik gahabar ban rahiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਜੋਗੀ ਸੰਘਣੇ ਬਨ ਵਿਚ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "जोगी इक गहबर बन रहई ॥",
      "sourceLineId": "126053",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੇਟਕ ਨਾਥ ਤਾਹਿ ਜਗ ਕਹਈ ॥",
      "transliteration": "cheTak naath taeh jag kahiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸਾਰੇ ਚੇਟਕ ਨਾਥ ਕਹਿੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "चेटक नाथ ताहि जग कहई ॥",
      "sourceLineId": "126054",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਏਕ ਪੁਰਖ ਪੁਰ ਤੇ ਨਿਤਿ ਖਾਵੈ ॥",
      "transliteration": "ek purakh pur te nit khaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸ਼ਹਿਰ ਦਾ ਇਕ ਬੰਦਾ ਰੋਜ਼ ਖਾਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "एक पुरख पुर ते निति खावै ॥",
      "sourceLineId": "126055",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਾ ਤੇ ਤ੍ਰਾਸ ਸਭਨ ਚਿਤ ਆਵੈ ॥੧॥",
      "transliteration": "taa te traas sabhan chit aavai ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਸਭ ਚਿਤ ਵਿਚ ਡਰਦੇ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "ता ते त्रास सभन चित आवै ॥१॥",
      "sourceLineId": "126056",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਹਾ ਕਟਾਛਿ ਕੁਅਰਿ ਇਕ ਰਾਨੀ ॥",
      "transliteration": "tahaa kaTaachh kuar ik raanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਕਟਾਛ ਕੁਅਰਿ ਨਾ ਦੀ ਰਾਣੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "तहा कटाछि कुअरि इक रानी ॥",
      "sourceLineId": "126057",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1116_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਾ ਕੀ ਪ੍ਰਭਾ ਨ ਜਾਤ ਬਖਾਨੀ ॥",
      "transliteration": "jaa kee prabhaa na jaat bakhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਸੁੰਦਰਤਾ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1116,
      "hindi": "",
      "hindiTransliteration": "जा की प्रभा न जात बखानी ॥",
      "sourceLineId": "126058",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
