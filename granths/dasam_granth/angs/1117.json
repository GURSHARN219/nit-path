{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1117,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1117_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੁੰਦਰਿ ਸਕਲ ਜਗਤ ਤੇ ਰਹਈ ॥",
      "transliteration": "su(n)dhar sakal jagat te rahiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸਾਰੇ ਸੰਸਾਰ ਵਿਚੋਂ ਸੋਹਣੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "सुँदरि सकल जगत ते रहई ॥",
      "sourceLineId": "126059",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬੇਦ ਸਾਸਤ੍ਰ ਸਿੰਮ੍ਰਿਤ ਸਭ ਕਹਈ ॥੨॥",
      "transliteration": "bedh saasatr si(n)mirat sabh kahiee ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵੇਦਾ, ਸ਼ਾਸਤ੍ਰਾ ਅਤੇ ਸਮ੍ਰਿਤੀਆਂ ਨੂੰ ਜਾਣਦੀ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "बेद सासत्र सिंमृत सभ कहई ॥२॥",
      "sourceLineId": "126060",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਾ ਕੋ ਨਾਥ ਅਧਿਕ ਡਰੁ ਪਾਵੈ ॥",
      "transliteration": "taa ko naath adhik ddar paavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਪਤੀ (ਜੋਗੀ ਤੋਂ) ਬਹੁਤ ਡਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "ता को नाथ अधिक डरु पावै ॥",
      "sourceLineId": "126061",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਏਕ ਪੁਰਖ ਤਿਹ ਨਿਤ ਖਵਾਵੈ ॥",
      "transliteration": "ek purakh teh nit khavaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਲਈ) ਉਸ ਨੂੰ ਇਕ ਆਦਮੀ ਰੋਜ਼ ਖਵਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "एक पुरख तिह नित खवावै ॥",
      "sourceLineId": "126062",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚਿਤ ਕੇ ਬਿਖੈ ਤ੍ਰਾਸ ਅਤਿ ਧਰੈ ॥",
      "transliteration": "chit ke bikhai traas at dharai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਚਿਤ ਵਿਚ ਬਹੁਤ ਡਰ ਮੰਨਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "चित के बिखै त्रास अति धरै ॥",
      "sourceLineId": "126063",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮੇਰੋ ਭਛ ਜੁਗਿਸ ਮਤਿ ਕਰੈ ॥੩॥",
      "transliteration": "mero bhachh jugis mat karai ||3||",
      "translation": "",
      "punjabiViakhya": "ਮਤਾ ਜੋਗੀ ਉਸ ਨੂੰ ਹੀ ਖਾ ਜਾਏ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "मेरो भछ जुगिस मति करै ॥३॥",
      "sourceLineId": "126064",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਹਸਿ ਬਚਨ ਉਚਾਰੇ ॥",
      "transliteration": "tab raanee has bachan uchaare ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਨੇ ਹੱਸ ਕੇ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "तब रानी हसि बचन उचारे ॥",
      "sourceLineId": "126065",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੁਨੁ ਰਾਜਾ ਪ੍ਰਾਨਨ ਤੇ ਪ੍ਯਾਰੇ ॥",
      "transliteration": "sun raajaa praanan te payaare ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪ੍ਰਾਣਾ ਤੋਂ ਪਿਆਰੇ ਰਾਜੇ! ਸੁਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "सुनु राजा प्रानन ते प्यारे ॥",
      "sourceLineId": "126066",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਐਸੋ ਜਤਨ ਕ੍ਯੋਨ ਨਹੀ ਕਰੀਯੈ ॥",
      "transliteration": "aaiso jatan kayon nahee kareeyai ||",
      "translation": "",
      "punjabiViakhya": "ਅਜਿਹਾ ਯਤਨ ਕਿਉਾਂ ਨਾ ਕੀਤਾ ਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "ऐसो जतन क्योन नही करीयै ॥",
      "sourceLineId": "126067",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪ੍ਰਜਾ ਉਬਾਰਿ ਜੋਗਿਯਹਿ ਮਰੀਯੈ ॥੪॥",
      "transliteration": "prajaa ubaar jogiyeh mareeyai ||4||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜੋਗੀ ਨੂੰ ਮਾਰ ਕੇ ਪ੍ਰਜਾ ਨੂੰ ਬਚਾ ਲਿਆ ਜਾਏ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "प्रजा उबारि जोगियहि मरीयै ॥४॥",
      "sourceLineId": "126068",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਾਜਾ ਤਨ ਇਹ ਭਾਤਿ ਉਚਾਰਿਯੋ ॥",
      "transliteration": "raajaa tan ieh bhaat uchaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "राजा तन इह भाति उचारियो ॥",
      "sourceLineId": "126069",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਭਰਨ ਸਕਲ ਅੰਗ ਮੈ ਧਾਰਿਯੋ ॥",
      "transliteration": "abharan sakal a(n)g mai dhaariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸਾਰੇ ਸ਼ਰੀਰ ਉਤੇ ਸੁੰਦਰ ਗਹਿਣੇ ਸਜਾ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "अभरन सकल अंग मै धारियो ॥",
      "sourceLineId": "126070",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਲਿ ਕੀ ਬਹੁਤ ਸਮਗ੍ਰੀ ਲਈ ॥",
      "transliteration": "bal kee bahut samagree liee ||",
      "translation": "",
      "punjabiViakhya": "ਬਲੀ ਦੀ ਬਹੁਤ ਸਾਮਗ੍ਰੀ ਲੈ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "बलि की बहुत समग्री लई ॥",
      "sourceLineId": "126071",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਰਧ ਰਾਤ੍ਰੀ ਜੋਗੀ ਪਹਿ ਗਈ ॥੫॥",
      "transliteration": "aradh raatree jogee peh giee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅੱਧੀ ਰਾਤ ਨੂੰ ਜੋਗੀ ਕੋਲ ਗਈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "अरध रात्री जोगी पहि गई ॥५॥",
      "sourceLineId": "126072",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਛ ਭੋਜ ਤਿਹ ਪ੍ਰਥਮ ਖਵਾਯੋ ॥",
      "transliteration": "bhachh bhoj teh pratham khavaayo ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਉਸ ਨੂੰ ਭੋਜਨ ਖਵਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "भछ भोज तिह प्रथम खवायो ॥",
      "sourceLineId": "126073",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਧਿਕ ਮਦ੍ਰਯ ਲੈ ਬਹੁਰਿ ਪਿਵਾਯੋ ॥",
      "transliteration": "adhik madhray lai bahur pivaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਬਹੁਤ ਸ਼ਰਾਬ ਲੈ ਕੇ ਪਿਲਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "अधिक मद्रय लै बहुरि पिवायो ॥",
      "sourceLineId": "126074",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਹੁਰਿ ਆਪੁ ਹਸਿ ਬਚਨ ਉਚਾਰੇ ॥",
      "transliteration": "bahur aap has bachan uchaare ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਆਪ ਹੱਸ ਕੇ ਕਹਿਣ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "बहुरि आपु हसि बचन उचारे ॥",
      "sourceLineId": "126075",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਹੌ ਆਈ ਹਿਤ ਭਜਨ ਤਿਹਾਰੇ ॥੬॥",
      "transliteration": "hau aaiee hit bhajan tihaare ||6||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮੈਂ ਤੇਰੇ ਨਾਲ ਭੋਗ ਕਰਨ ਲਈ ਆਈ ਹਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "हौ आई हित भजन तिहारे ॥६॥",
      "sourceLineId": "126076",
      "sourceShabadId": "11828",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "126077",
      "sourceShabadId": "11829",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਿਹ ਬਿਧਿ ਤੁਮ ਭਛਤ ਪੁਰਖ ਸੋ ਮੁਹਿ ਪ੍ਰਥਮ ਬਤਾਇ ॥",
      "transliteration": "jeh bidh tum bhachhat purakh so muh pratham batai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਮੈਨੂੰ ਇਹ ਦਸੋ ਜਿਸ ਢੰਗ ਨਾਲ ਕਿ ਤੁਸੀਂ ਬੰਦੇ ਨੂੰ ਖਾਦੇ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "जिह बिधि तुम भछत पुरख सो मुहि प्रथम बताइ ॥",
      "sourceLineId": "126078",
      "sourceShabadId": "11829",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਹੁਰਿ ਅਧਿਕ ਰੁਚਿ ਮਾਨਿ ਕਰਿ ਭੋਗ ਕਰੋ ਲਪਟਾਇ ॥੭॥",
      "transliteration": "bahur adhik ruch maan kar bhog karo lapaTai ||7||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਬਹੁਤ ਰੁਚੀ ਪੂਰਵਕ ਮੇਰੇ ਨਾਲ ਲਿਪਟ ਕੇ ਭੋਗ ਕਰੋ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "बहुरि अधिक रुचि मानि करि भोग करो लपटाइ ॥७॥",
      "sourceLineId": "126079",
      "sourceShabadId": "11829",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਬ ਜੋਗੀ ਐਸੇ ਸੁਨਿਯੋ ਫੂਲ ਗਯੋ ਮਨ ਮਾਹਿ ॥",
      "transliteration": "jab jogee aaise suniyo fool gayo man maeh ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਜੋਗੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣਿਆ, ਉਹ ਮਨ ਵਿਚ ਬਹੁਤ ਫੁਲ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "जब जोगी ऐसे सुनियो फूल गयो मन माहि ॥",
      "sourceLineId": "126080",
      "sourceShabadId": "11829",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਆਜ ਬਰਾਬਰ ਸੁਖ ਕਹੂੰ ਪ੍ਰਿਥਵੀ ਤਲ ਮੈ ਨਾਹਿ ॥੮॥",
      "transliteration": "aaj baraabar sukh kahoo(n) pirathavee tal mai naeh ||8||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿਣ ਲਗਾ ਕਿ) ਅਜ ਵਰਗਾ ਸੁਖ ਪ੍ਰਿਥਵੀ ਉਤੇ ਕਿਤੇ ਵੀ ਨਹੀਂ ਹੈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "आज बराबर सुख कहूँ पृथवी तल मै नाहि ॥८॥",
      "sourceLineId": "126081",
      "sourceShabadId": "11829",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "126082",
      "sourceShabadId": "11830",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭਰਭਰਾਇ ਠਾਢਾ ਉਠ ਭਯੋ ॥",
      "transliteration": "bharabharai Thaaddaa uTh bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਅਬੜਵਾਏ ਉਠ ਖੜੋਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "भरभराइ ठाढा उठ भयो ॥",
      "sourceLineId": "126083",
      "sourceShabadId": "11830",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਾਨਿਯਹਿ ਸੰਗ ਆਪੁਨੇ ਲਯੋ ॥",
      "transliteration": "raaniyeh sa(n)g aapune layo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਨੂੰ ਆਪਣੇ ਨਾਲ ਲੈ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "रानियहि संग आपुने लयो ॥",
      "sourceLineId": "126084",
      "sourceShabadId": "11830",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗਹਿ ਬਹਿਯਾ ਮਨ ਮੈ ਹਰਖਾਯੋ ॥",
      "transliteration": "geh bahiyaa man mai harakhaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਬਾਹ ਪਕੜ ਕੇ ਮਨ ਵਿਚ ਬਹੁਤ ਪ੍ਰਸੰਨ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "गहि बहिया मन मै हरखायो ॥",
      "sourceLineId": "126085",
      "sourceShabadId": "11830",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਕਛੂ ਨਹਿ ਪਾਯੋ ॥੯॥",
      "transliteration": "bhedh abhedh kachhoo neh paayo ||9||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ ਉਸ ਨੇ) ਭੇਦ ਅਭੇਦ ਨੂੰ ਕੁਝ ਨਾ ਸਮਝਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद कछू नहि पायो ॥९॥",
      "sourceLineId": "126086",
      "sourceShabadId": "11830",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਡੋ ਕਰਾਹ ਬਿਲੋਕਤ ਭਯੋ ॥",
      "transliteration": "baddo karaeh bilokat bhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ ਉਸ ਨੇ ਇਕ) ਵੱਡਾ ਸਾਰਾ ਕੜਾਹ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "बडो कराह बिलोकत भयो ॥",
      "sourceLineId": "126087",
      "sourceShabadId": "11830",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਾਤ ਭਾਵਰਨਿ ਤਾ ਪਰ ਲਯੋ ॥",
      "transliteration": "saat bhaavaran taa par layo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੇ ਸੱਤ ਫੇਰੇ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "सात भावरनि ता पर लयो ॥",
      "sourceLineId": "126088",
      "sourceShabadId": "11830",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਨੀ ਪਕਰਿ ਤਾਹਿ ਤਹ ਡਾਰਿਯੋ ॥",
      "transliteration": "raanee pakar taeh teh ddaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਉਸ ਨੂੰ ਪਕੜ ਕੇ ਕੜਾਹੇ ਵਿਚ ਸੁਟ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "रानी पकरि ताहि तह डारियो ॥",
      "sourceLineId": "126089",
      "sourceShabadId": "11830",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜੀਵਤ ਹੁਤੋ ਭੂੰਜਿ ਕਰਿ ਮਾਰਿਯੋ ॥੧੦॥",
      "transliteration": "jeevat huto bhoo(n)j kar maariyo ||10||",
      "translation": "",
      "punjabiViakhya": "ਜੀਉਾਂਦੇ ਨੂੰ ਹੀ ਭੁੰਨ ਕੇ ਮਾਰ ਦਿੱਤਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "जीवत हुतो भूँजि करि मारियो ॥१०॥",
      "sourceLineId": "126090",
      "sourceShabadId": "11830",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "126091",
      "sourceShabadId": "11831",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਆਪਨੋ ਆਪੁ ਬਚਾਇ ਕੈ ਭੂੰਨਿ ਜੋਗਿਯਹਿ ਦੀਨ ॥",
      "transliteration": "aapano aap bachai kai bhoo(n)n jogiyeh dheen ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਆਪ ਨੂੰ ਬਚਾ ਕੇ (ਰਾਣੀ ਨੇ) ਜੋਗੀ ਨੂੰ ਭੁੰਨ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "आपनो आपु बचाइ कै भूँनि जोगियहि दीन ॥",
      "sourceLineId": "126092",
      "sourceShabadId": "11831",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਲੀਨੀ ਪ੍ਰਜਾ ਉਬਾਰਿ ਕੈ ਚਰਿਤ ਚੰਚਲਾ ਕੀਨ ॥੧੧॥",
      "transliteration": "leenee prajaa ubaar kai charit cha(n)chalaa keen ||11||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਚਰਿਤ੍ਰ ਕਰ ਕੇ ਇਸਤਰੀ ਨੇ ਪ੍ਰਜਾ ਨੂੰ ਬਚਾ ਲਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "लीनी प्रजा उबारि कै चरित चंचला कीन ॥११॥",
      "sourceLineId": "126093",
      "sourceShabadId": "11831",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਸੋਲਹ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੧੬॥੪੧੩੪॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau soleh charitr samaapatam sat subham sat ||216||4134||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੨੧੬ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੧੬॥੪੧੩੪॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ सोलह चरित्र समापतम सतु सुभम सतु ॥२१६॥४१३४॥अफजूँ॥",
      "sourceLineId": "126094",
      "sourceShabadId": "11831",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "126095",
      "sourceShabadId": "11832",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਫੈਲਕੂਸ ਪਾਤਿਸਾਹ ਕੇ ਸੂਰ ਸਿਕੰਦਰ ਪੂਤ ॥",
      "transliteration": "failakoos paatisaeh ke soor sika(n)dhar poot ||",
      "translation": "",
      "punjabiViakhya": "ਫੈਲਕੂਸ ਬਾਦਸ਼ਾਹ ਦਾ ਸਿਕੰਦਰ ਨਾ ਦਾ ਸ਼ੂਰਵੀਰ ਪੁੱਤਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "फैलकूस पातिसाह के सूर सिकंदर पूत ॥",
      "sourceLineId": "126096",
      "sourceShabadId": "11832",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੰਬਰਾਰਿ ਲਾਜਤ ਨਿਰਖਿ ਸੀਰਤਿ ਸੂਰਤਿ ਸਪੂਤ ॥੧॥",
      "transliteration": "sa(n)baraar laajat nirakh seerat soorat sapoot ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਸੁਪੁੱਤਰ ਦੀ ਸੀਰਤ ਅਤੇ ਸੂਰਤ ਨੂੰ ਵੇਖ ਕੇ ਕਾਮ ਦੇਵ ('ਸੰਬਰਾਰਿ') ਵੀ ਸ਼ਰਮਿੰਦਾ ਹੁੰਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "संबरारि लाजत निरखि सीरति सूरति सपूत ॥१॥",
      "sourceLineId": "126097",
      "sourceShabadId": "11832",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "126098",
      "sourceShabadId": "11833",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰਾਜ ਸਾਜ ਜਬ ਹੀ ਤਿਨ ਧਰਿਯੋ ॥",
      "transliteration": "raaj saaj jab hee tin dhariyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਉਸ ਨੇ ਰਾਜ-ਪਾਟ ਸੰਭਾਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "राज साज जब ही तिन धरियो ॥",
      "sourceLineId": "126099",
      "sourceShabadId": "11833",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪ੍ਰਥਮ ਜੰਗ ਜੰਗਿਰ ਸੌ ਕਰਿਯੋ ॥",
      "transliteration": "pratham ja(n)g ja(n)gir sau kariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਪਹਿਲੀ ਲੜਾਈ ਜੰਗਿਰ ਨਾਲ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "प्रथम जंग जंगिर सौ करियो ॥",
      "sourceLineId": "126100",
      "sourceShabadId": "11833",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਾ ਕੋ ਦੇਸ ਛੀਨਿ ਕਰਿ ਲੀਨੋ ॥",
      "transliteration": "taa ko dhes chheen kar leeno ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਦੇਸ਼ ਖੋਹ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "ता को देस छीनि करि लीनो ॥",
      "sourceLineId": "126101",
      "sourceShabadId": "11833",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਮੁ ਸਿਕੰਦਰ ਸਾਹ ਕੋ ਕੀਨੋ ॥੨॥",
      "transliteration": "naam sika(n)dhar saeh ko keeno ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣਾ ਨਾ ਸਿਕੰਦਰ ਸ਼ਾਹ ਰਖਿਆ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "नामु सिकंदर साह को कीनो ॥२॥",
      "sourceLineId": "126102",
      "sourceShabadId": "11833",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਹੁਰਿ ਸਾਹ ਦਾਰਾ ਕੌ ਮਾਰਿਯੋ ॥",
      "transliteration": "bahur saeh dhaaraa kau maariyo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਉਸ ਨੇ ਦਾਰਾ ਬਾਦਸ਼ਾਹ ਨੂੰ ਮਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "बहुरि साह दारा कौ मारियो ॥",
      "sourceLineId": "126103",
      "sourceShabadId": "11833",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਿੰਦੁਸਤਾ ਕੌ ਬਹੁਰਿ ਪਧਾਰਿਯੋ ॥",
      "transliteration": "hi(n)dhusataa kau bahur padhaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਗਰੋਂ ਹਿੰਦੁਸਤਾਨ ਵਲ ਚੜ੍ਰਹ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "हिंदुसता कौ बहुरि पधारियो ॥",
      "sourceLineId": "126104",
      "sourceShabadId": "11833",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਨਕਬਜਾ ਏਸ੍ਵਰ ਕੌ ਜਿਨਿਯੋ ॥",
      "transliteration": "kanakabajaa esavair kau jiniyo ||",
      "translation": "",
      "punjabiViakhya": "(ਪਹਿਲਾ) ਕਾਨਕੁਬਜ ਦੇ ਰਾਜੇ (ਜਾ ਐਸ਼ਵਰਜ) ਨੂੰ ਜਿਤਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "कनकबजा एस्वर कौ जिनियो ॥",
      "sourceLineId": "126105",
      "sourceShabadId": "11833",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1117_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਾਮੁਹਿ ਭਯੋ ਤਾਹਿ ਤਿਹ ਝਿਨਿਯੋ ॥੩॥",
      "transliteration": "saamuh bhayo taeh teh jhiniyo ||3||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਜੋ ਵੀ) ਸਾਹਮਣੇ ਆਇਆ, ਉਸ ਨੂੰ ਪਛਾੜ ਦਿੱਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1117,
      "hindi": "",
      "hindiTransliteration": "सामुहि भयो ताहि तिह झिनियो ॥३॥",
      "sourceLineId": "126106",
      "sourceShabadId": "11833",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
