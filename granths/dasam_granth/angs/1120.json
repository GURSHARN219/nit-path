{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1120,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1120_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜੋ ਕੋਊ ਸੁਭਟ ਤਵਨ ਪਰ ਧਾਵੈ ॥",
      "transliteration": "jo kouoo subhaT tavan par dhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਕੋਈ ਸੂਰਮਾ ਉਸ ਉਤੇ ਹਮਲਾ ਕਰਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "जो कोऊ सुभट तवन पर धावै ॥",
      "sourceLineId": "126203",
      "sourceShabadId": "11849",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਏਕ ਚੋਟ ਜਮ ਲੋਕ ਪਠਾਵੈ ॥੨੭॥",
      "transliteration": "ek choT jam lok paThaavai ||27||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਕ ਚੋਟ ਨਾਲ ਹੀ (ਉਸ ਨੂੰ) ਯਮ ਲੋਕ ਵਿਚ ਭੇਜ ਦਿੰਦਾ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "एक चोट जम लोक पठावै ॥२७॥",
      "sourceLineId": "126204",
      "sourceShabadId": "11849",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਨ ਤੇ ਏਕ ਪੈਗ ਨਹਿ ਭਾਜੈ ॥",
      "transliteration": "ran te ek paig neh bhaajai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਰਣ ਤੋਂ ਇਕ ਕਦਮ ਤਕ ਨਹੀਂ ਭਜਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "रन ते एक पैग नहि भाजै ॥",
      "sourceLineId": "126205",
      "sourceShabadId": "11849",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਠਾਢੋ ਬੀਰ ਖੇਤ ਮੈ ਗਾਜੈ ॥",
      "transliteration": "Thaaddo beer khet mai gaajai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸੂਰਮਾ ਯੁੱਧਭੂਮੀ ਵਿਚ ਖੜੋਤਾ ਗਜਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "ठाढो बीर खेत मै गाजै ॥",
      "sourceLineId": "126206",
      "sourceShabadId": "11849",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਧਿਕ ਰਾਵ ਰਾਜਨ ਕੌ ਮਾਰਿਯੋ ॥",
      "transliteration": "adhik raav raajan kau maariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਬਹੁਤ ਸਾਰੇ ਰਾਜਿਆਂ ਰਜਵਾੜਿਆਂ ਨੂੰ (ਜਦ) ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "अधिक राव राजन कौ मारियो ॥",
      "sourceLineId": "126207",
      "sourceShabadId": "11849",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਾਪਿ ਸਿਕੰਦਰ ਮੰਤ੍ਰ ਬਿਚਾਰਿਯੋ ॥੨੮॥",
      "transliteration": "kaap sika(n)dhar ma(n)tr bichaariyo ||28||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸਿਕੰਦਰ ਨੇ (ਡਰ ਨਾਲ) ਕੰਬ ਕੇ ਵਿਚਾਰ ਕੀਤਾ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "कापि सिकंदर मंत्र बिचारियो ॥२८॥",
      "sourceLineId": "126208",
      "sourceShabadId": "11849",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "126209",
      "sourceShabadId": "11850",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸ੍ਰੀ ਦਿਨਨਾਥ ਮਤੀ ਤਰੁਨਿ ਸਾਹ ਚੀਨ ਕੇ ਦੀਨ ॥",
      "transliteration": "sree dhinanaath matee tarun saeh cheen ke dheen ||",
      "translation": "",
      "punjabiViakhya": "ਦਿਨਨਾਥ ਮਤੀ ਨਾ ਦੀ ਇਸਤਰੀ (ਜੋ) ਚੀਨ ਦੇ ਬਾਦਸ਼ਾਹ ਨੇ (ਸਿਕੰਦਰ ਨੂੰ) ਦਿੱਤੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "स्री दिननाथ मती तरुनि साह चीन के दीन ॥",
      "sourceLineId": "126210",
      "sourceShabadId": "11850",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੋ ਤਾ ਪਰ ਧਾਵਤ ਭਈ ਭੇਸ ਪੁਰਖ ਕੋ ਕੀਨ ॥੨੯॥",
      "transliteration": "so taa par dhaavat bhiee bhes purakh ko keen ||29||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਪੁਰਸ਼ ਦਾ ਭੇਸ ਧਾਰਨ ਕਰ ਕੇ ਉਸ ਉਤੇ ਟੁੱਟ ਕੇ ਪੈ ਗਈ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "सो ता पर धावत भई भेस पुरख को कीन ॥२९॥",
      "sourceLineId": "126211",
      "sourceShabadId": "11850",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "126212",
      "sourceShabadId": "11851",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪਹਿਲੇ ਤੀਰ ਤਵਨ ਕੌ ਮਾਰੈ ॥",
      "transliteration": "pahile teer tavan kau maarai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਉਸ ਨੂੰ ਤੀਰ ਮਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "पहिले तीर तवन कौ मारै ॥",
      "sourceLineId": "126213",
      "sourceShabadId": "11851",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਰਛਾ ਬਹੁਰਿ ਕੋਪ ਤਨ ਝਾਰੈ ॥",
      "transliteration": "barachhaa bahur kop tan jhaarai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਉਸ ਦੇ ਸ਼ਰੀਰ ਉਤੇ ਬਰਛੇ ਦਾ ਵਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "बरछा बहुरि कोप तन झारै ॥",
      "sourceLineId": "126214",
      "sourceShabadId": "11851",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਮਕਿ ਤੇਗ ਕੋ ਘਾਇ ਪ੍ਰਹਾਰਿਯੋ ॥",
      "transliteration": "tamak teg ko ghai prahaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਰੋਹ ਨਾਲ ਤਲਵਾਰ ਦਾ ਵਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "तमकि तेग को घाइ प्रहारियो ॥",
      "sourceLineId": "126215",
      "sourceShabadId": "11851",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਗਿਰਿਯੋ ਭੂਮਿ ਜਾਨੁ ਹਨਿ ਡਾਰਿਯੋ ॥੩੦॥",
      "transliteration": "giriyo bhoom jaan han ddaariyo ||30||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨਾਲ ਉਹ) ਧਰਤੀ ਉਤੇ ਡਿਗ ਪਿਆ, ਮਾਨੋ ਮਾਰ ਹੀ ਦਿੱਤਾ ਗਿਆ ਹੋਵੇ ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "गिरियो भूमि जानु हनि डारियो ॥३०॥",
      "sourceLineId": "126216",
      "sourceShabadId": "11851",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭੂ ਪਰ ਗਿਰਿਯੋ ਠਾਢਿ ਉਠਿ ਭਯੋ ॥",
      "transliteration": "bhoo par giriyo Thaadd uTh bhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਧਰਤੀ ਉਤੇ ਡਿਗਿਆ ਅਤੇ ਫਿਰ ਉਠ ਖੜੋਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "भू पर गिरियो ठाढि उठि भयो ॥",
      "sourceLineId": "126217",
      "sourceShabadId": "11851",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਾ ਕੌ ਪਕਰਿ ਕੰਠ ਤੇ ਲਯੋ ॥",
      "transliteration": "taa kau pakar ka(n)Th te layo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਇਸਤਰੀ) ਨੂੰ ਗਲੇ ਤੋਂ ਪਕੜ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "ता कौ पकरि कंठ ते लयो ॥",
      "sourceLineId": "126218",
      "sourceShabadId": "11851",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੁੰਦਰ ਬਦਨ ਅਧਿਕ ਤਿਹ ਚੀਨੋ ॥",
      "transliteration": "su(n)dhar badhan adhik teh cheeno ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਬਹੁਤ ਸੁੰਦਰ ਮੁਖ ('ਬਦਨ') ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "सुँदर बदन अधिक तिह चीनो ॥",
      "sourceLineId": "126219",
      "sourceShabadId": "11851",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਾਰਿ ਨ ਦਈ ਰਾਖਿ ਤਿਹ ਲੀਨੋ ॥੩੧॥",
      "transliteration": "maar na dhiee raakh teh leeno ||31||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ) ਉਸ ਨੂੰ ਮਾਰਿਆ ਨ, ਛਡ ਦਿੱਤਾ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "मारि न दई राखि तिह लीनो ॥३१॥",
      "sourceLineId": "126220",
      "sourceShabadId": "11851",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਾ ਕਹ ਪਕਰਿ ਰੂਸਿਯਨ ਦਯੋ ॥",
      "transliteration": "taa keh pakar roosiyan dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਪਕੜ ਕੇ ਰੂਸੀਆਂ ਨੂੰ ਦੇ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "ता कह पकरि रूसियन दयो ॥",
      "sourceLineId": "126221",
      "sourceShabadId": "11851",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਆਪੁ ਉਦਿਤ ਰਨ ਕੋ ਪੁਨਿ ਭਯੋ ॥",
      "transliteration": "aap udhit ran ko pun bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪ ਫਿਰ ਯੁੱਧ ਲਈ ਤਿਆਰ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "आपु उदित रन को पुनि भयो ॥",
      "sourceLineId": "126222",
      "sourceShabadId": "11851",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਅਰਿ ਅਮਿਤ ਸੰਘਾਰੈ ॥",
      "transliteration": "bhaat bhaat ar amit sa(n)ghaarai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਕਈ ਢੰਗਾ ਨਾਲ ਬੇਸ਼ੁਮਾਰ ਵੈਰੀਆਂ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "भाति भाति अरि अमित संघारै ॥",
      "sourceLineId": "126223",
      "sourceShabadId": "11851",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਨੁ ਦ੍ਰੁਮ ਪਵਨ ਪ੍ਰਚੰਡ ਉਖਾਰੈ ॥੩੨॥",
      "transliteration": "jan dhrum pavan pracha(n)dd ukhaarai ||32||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਤੇਜ਼ ਹਵਾ ਨੇ ਬ੍ਰਿਛਾ ਨੂੰ ਉਖਾੜ ਸੁਟਿਆ ਹੋਵੇ ॥੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "जनु द्रुम पवन प्रचंड उखारै ॥३२॥",
      "sourceLineId": "126224",
      "sourceShabadId": "11851",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਵੈਯਾ ॥",
      "transliteration": "savaiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੈਯਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "सवैया ॥",
      "sourceLineId": "126225",
      "sourceShabadId": "11852",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਾਤੀ ਕ੍ਰਿਪਾਨ ਕਸੇ ਕਟਿ ਮੈ ਭਟ ਭਾਰੀ ਭੁਜਾਨ ਕੌ ਭਾਰ ਭਰੇ ਹੈ ॥",
      "transliteration": "kaatee kirapaan kase kaT mai bhaT bhaaree bhujaan kau bhaar bhare hai ||",
      "translation": "",
      "punjabiViakhya": "ਕਟਾਰ, ਕ੍ਰਿਪਾਨ ਨੂੰ ਲਕ ਨਾਲ ਕਸ ਕੇ ਭਾਰੀ ਭੁਜਾਵਾ ਵਾਲੇ ਸੂਰਮੇ ਬਹੁਤ ਬਲ ਨਾਲ ਭਰੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "काती कृपान कसे कटि मै भट भारी भुजान कौ भार भरे है ॥",
      "sourceLineId": "126226",
      "sourceShabadId": "11852",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭੂਤ ਭਵਿਖ੍ਯ ਭਵਾਨ ਸਦਾ ਕਬਹੂੰ ਰਨ ਮੰਡਲ ਤੇ ਨ ਟਰੇ ਹੈ ॥",
      "transliteration": "bhoot bhavikhay bhavaan sadhaa kabahoo(n) ran ma(n)ddal te na Tare hai ||",
      "translation": "",
      "punjabiViakhya": "ਭੂਤ, ਭਵਿਖਤ ਅਤੇ ਵਰਤਮਾਨ ਕਾਲਾ ਵਿਚ ਕਦੇ ਵੀ ਯੁੱਧ-ਭੂਮੀ ਵਿਚੋਂ ਹਟੇ ਨਹੀਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "भूत भविख्य भवान सदा कबहूँ रन मंडल ते न टरे है ॥",
      "sourceLineId": "126227",
      "sourceShabadId": "11852",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭੀਰ ਪਰੇ ਨਹਿ ਭੀਰ ਭੇ ਭੂਪਤਿ ਲੈ ਲੈ ਭਲਾ ਭਲੀ ਭਾਤਿ ਅਰੇ ਹੈ ॥",
      "transliteration": "bheer pare neh bheer bhe bhoopat lai lai bhalaa bhalee bhaat are hai ||",
      "translation": "",
      "punjabiViakhya": "ਭੀੜ ਪੈਣ ਤੇ ਇਹ ਰਾਜੇ ਡਰਦੇ ਨਹੀਂ, ਸਗੋਂ ਭਾਲੇ ਲੈ ਲੈ ਕੇ ਚੰਗੀ ਤਰ੍ਰਹਾ ਡੱਟੇ ਰਹਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "भीर परे नहि भीर भे भूपति लै लै भला भली भाति अरे है ॥",
      "sourceLineId": "126228",
      "sourceShabadId": "11852",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੇ ਇਨ ਬੀਰ ਮਹਾ ਰਨਧੀਰ ਸੁ ਹਾਕਿ ਹਜਾਰ ਅਨੇਕ ਹਰੇ ਹੈ ॥੩੩॥",
      "transliteration": "te in beer mahaa ranadheer su haak hajaar anek hare hai ||33||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਮਹਾਨ ਯੋਧੇ ਨੇ ਹਜ਼ਾਰਾ ਨੂੰ ਵੰਗਾਰ ਵੰਗਾਰ ਕੇ ਮਾਰ ਦਿੱਤਾ ਹੈ ॥੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "ते इन बीर महा रनधीर सु हाकि हजार अनेक हरे है ॥३३॥",
      "sourceLineId": "126229",
      "sourceShabadId": "11852",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "126230",
      "sourceShabadId": "11853",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਬ ਹੀ ਸਾਹ ਸਕੰਦਰ ਡਰਿਯੋ ॥",
      "transliteration": "tab hee saeh saka(n)dhar ddariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਸਿਕੰਦਰ ਬਾਦਸ਼ਾਹ ਡਰ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "तब ही साह सकंदर डरियो ॥",
      "sourceLineId": "126231",
      "sourceShabadId": "11853",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬੋਲਿ ਅਰਸਤੂ ਮੰਤ੍ਰ ਬਿਚਰਿਯੋ ॥",
      "transliteration": "bol arasatoo ma(n)tr bichariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਰਸਤੂ ਨੂੰ ਬੁਲਾ ਕੇ ਸਲਾਹ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "बोलि अरसतू मंत्र बिचरियो ॥",
      "sourceLineId": "126232",
      "sourceShabadId": "11853",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਲੀ ਨਾਸ ਕੋ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "transliteration": "balee naas ko bol paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਬਲੀ ਨਾਸ (ਨਾ ਦੇ ਦੈਂਤ) ਨੂੰ ਬੁਲਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "बली नास को बोलि पठायो ॥",
      "sourceLineId": "126233",
      "sourceShabadId": "11853",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚਿਤ ਮੈ ਅਧਿਕ ਤ੍ਰਾਸ ਉਪਜਾਯੋ ॥੩੪॥",
      "transliteration": "chit mai adhik traas upajaayo ||34||",
      "translation": "",
      "punjabiViakhya": "ਚਿਤ ਵਿਚ ਬਹੁਤ ਡਰ ਪੈਦਾ ਹੋ ਜਾਣ ਕਾਰਨ ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "चित मै अधिक त्रास उपजायो ॥३४॥",
      "sourceLineId": "126234",
      "sourceShabadId": "11853",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "126235",
      "sourceShabadId": "11854",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜੋ ਤੁਮ ਹਮ ਕੌ ਕਹੋ ਤੋ ਹ੍ਯਾਂ ਤੈ ਭਾਜਿਯੈ ॥",
      "transliteration": "jo tum ham kau kaho to hayaa(n) tai bhaajiyai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੁਸੀਂ ਮੈਨੂੰ ਕਹੋ ਤਾ (ਮੈਂ) ਇਥੋਂ ਭਜ ਜਾਵਾ",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "जो तुम हम कौ कहो तो ह्याँ तै भाजियै ॥",
      "sourceLineId": "126236",
      "sourceShabadId": "11854",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰੂਸ ਸਹਿਰ ਕੇ ਭੀਤਰਿ ਜਾਇ ਬਿਰਾਜਿਯੈ ॥",
      "transliteration": "roos sahir ke bheetar jai biraajiyai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰੂਸ ਸ਼ਹਿਰ ਦੇ ਵਿਚ ਜਾ ਰਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "रूस सहिर के भीतरि जाइ बिराजियै ॥",
      "sourceLineId": "126237",
      "sourceShabadId": "11854",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗੋਲ ਬ੍ਰਯਾਬਾਨੀ ਸਭ ਹੀ ਕੌ ਮਾਰਿ ਹੈ ॥",
      "transliteration": "gol brayaabaanee sabh hee kau maar hai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ) ਮ੍ਰਿਗ ਤ੍ਰਿਸਨਾ ਵਾਲਾ ਮਰੁਸਥਲੀ ਛਲਾਵਾ (ਸਾਨੂੰ) ਸਾਰਿਆਂ ਨੂੰ (ਭਜਾ ਭਜਾ ਕੇ) ਮਾਰ ਦੇਵੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "गोल ब्रयाबानी सभ ही कौ मारि है ॥",
      "sourceLineId": "126238",
      "sourceShabadId": "11854",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਹੋ ਕਾਟਿ ਕਾਟਿ ਮੂੰਡਨ ਕੇ ਕੋਟ ਉਸਾਰਿ ਹੈ ॥੩੫॥",
      "transliteration": "ho kaaT kaaT moo(n)ddan ke koT usaar hai ||35||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਿਰਾ ਨੂੰ ਕਟ ਕਟ ਕੇ ਕਿਲਾ ਬਣਾ ਦੇਵੇਗਾ ॥੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "हो काटि काटि मूँडन के कोट उसारि है ॥३५॥",
      "sourceLineId": "126239",
      "sourceShabadId": "11854",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "126240",
      "sourceShabadId": "11855",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਲੀ ਨਾਸ ਜੋਤਕ ਬਿਖੈ ਅਧਿਕ ਹੁਤੋ ਪਰਬੀਨ ॥",
      "transliteration": "balee naas jotak bikhai adhik huto parabeen ||",
      "translation": "",
      "punjabiViakhya": "ਬਲੀ ਨਾਸ ਜੋਤਿਸ਼ ਵਿਚ ਬਹੁਤ ਪ੍ਰਬੀਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "बली नास जोतक बिखै अधिक हुतो परबीन ॥",
      "sourceLineId": "126241",
      "sourceShabadId": "11855",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਧੀਰਜ ਦੀਯਾ ਸਕੰਦਰਹਿ ਬਿਜੈ ਆਪਨੀ ਚੀਨ ॥੩੬॥",
      "transliteration": "dheeraj dheeyaa saka(n)dhareh bijai aapanee cheen ||36||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਆਪਣੀ ਜਿਤ ਪਛਾਣ ਕੇ (ਵੇਖ ਕੇ) ਸਿਕੰਦਰ ਨੂੰ ਧੀਰਜ ਦਿੱਤਾ ॥੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "धीरज दीया सकंदरहि बिजै आपनी चीन ॥३६॥",
      "sourceLineId": "126242",
      "sourceShabadId": "11855",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "126243",
      "sourceShabadId": "11856",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਲੀ ਨਾਸ ਹਜਰਤਿਹਿ ਉਚਾਰੋ ॥",
      "transliteration": "balee naas hajarateh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਬਲੀ ਨਾਸ ਨੇ ਬਾਦਸ਼ਾਹ ਨੂੰ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "बली नास हजरतिहि उचारो ॥",
      "sourceLineId": "126244",
      "sourceShabadId": "11856",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤੁਮਹੂੰ ਆਪੁ ਕਮੰਦਹਿ ਡਾਰੋ ॥",
      "transliteration": "tumahoo(n) aap kama(n)dheh ddaaro ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੂੰ ਆਪ (ਉਸ ਦੇ ਗਲ ਵਿਚ) ਫਾਹੀ ਪਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "तुमहूँ आपु कमंदहि डारो ॥",
      "sourceLineId": "126245",
      "sourceShabadId": "11856",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤੁਮਰੇ ਬਿਨਾ ਜੀਤਿ ਨਹਿ ਹੋਈ ॥",
      "transliteration": "tumare binaa jeet neh hoiee ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਰੇ (ਅਜਿਹਾ ਕੀਤੇ ਬਿਨਾ) ਜਿਤ ਨਹੀਂ ਹੋ ਸਕੇਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "तुमरे बिना जीति नहि होई ॥",
      "sourceLineId": "126246",
      "sourceShabadId": "11856",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਮਿਤਿ ਸੁਭਟ ਧਾਵਹਿਾਂ ਮਿਲਿ ਕੋਈ ॥੩੭॥",
      "transliteration": "amit subhaT dhaavahiaa(n) mil koiee ||37||",
      "translation": "",
      "punjabiViakhya": "ਭਾਵੇਾਂ ਬੇਸ਼ੁਮਾਰ ਸੂਰਮੇ ਮਿਲ ਕੇ ਹਮਲਾ ਕਿਉਾਂ ਨਾ ਕਰਨ ॥੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "अमिति सुभट धावहिाँ मिलि कोई ॥३७॥",
      "sourceLineId": "126247",
      "sourceShabadId": "11856",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "126248",
      "sourceShabadId": "11857",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੁਨਤ ਸਿਕੰਦਰ ਏ ਬਚਨ ਕਰਿਯੋ ਤੈਸੋਈ ਕਾਮ ॥",
      "transliteration": "sunat sika(n)dhar e bachan kariyo taisoiee kaam ||",
      "translation": "",
      "punjabiViakhya": "ਸਿਕੰਦਰ ਨੇ ਇਹ ਗੱਲ ਸੁਣ ਕੇ ਉਹੋ ਜਿਹਾ ਹੀ ਕੰਮ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "सुनत सिकंदर ए बचन करियो तैसोई काम ॥",
      "sourceLineId": "126249",
      "sourceShabadId": "11857",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਮੰਦ ਡਾਰਿ ਤਾ ਕੋ ਗਰੇ ਬਾਧ ਲਿਆਇਯੋ ਧਾਮ ॥੩੮॥",
      "transliteration": "kama(n)dh ddaar taa ko gare baadh liaaiyo dhaam ||38||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਗਲੇ ਵਿਚ ਫਾਹੀ ਪਾ ਕੇ ਘਰ (ਠਿਕਾਣੇ) ਨੂੰ ਬੰਨ੍ਰਹ ਲਿਆਂਦਾ ॥੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "कमंद डारि ता को गरे बाध लिआइयो धाम ॥३८॥",
      "sourceLineId": "126250",
      "sourceShabadId": "11857",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "126251",
      "sourceShabadId": "11858",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਭੋਜਨ ਸਾਹਿ ਭਲੀ ਬਿਧਿ ਤਾਹਿ ਖਵਾਇਯੋ ॥",
      "transliteration": "bhojan saeh bhalee bidh taeh khavaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਦਸ਼ਾਹ ਨੇ ਉਸ ਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਭੋਜਨ ਖਵਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "भोजन साहि भली बिधि ताहि खवाइयो ॥",
      "sourceLineId": "126252",
      "sourceShabadId": "11858",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬੰਧਨ ਤਾ ਕੇ ਕਾਟਿ ਭਲੇ ਬੈਠਾਇਯੋ ॥",
      "transliteration": "ba(n)dhan taa ke kaaT bhale baiThaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਬੰਧਨ ਕਟ ਕੇ ਉਸ ਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਬਿਠਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "बंधन ता के काटि भले बैठाइयो ॥",
      "sourceLineId": "126253",
      "sourceShabadId": "11858",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਛੂਟਤ ਬੰਧਨ ਭਜ੍ਯੋ ਤਹਾ ਹੀ ਕੋ ਗਯੋ ॥",
      "transliteration": "chhooTat ba(n)dhan bhajayo tahaa hee ko gayo ||",
      "translation": "",
      "punjabiViakhya": "ਬੰਧਨਾ ਤੋਂ ਖ਼ਲਾਸ ਹੁੰਦਿਆਂ ਹੀ ਉਹ ਉਥੇ ਭਜ ਕੇ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "छूटत बंधन भज्यो तहा ही को गयो ॥",
      "sourceLineId": "126254",
      "sourceShabadId": "11858",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਹੋ ਆਨਿ ਲੌਂਡਿਯਹਿ ਬਹੁਰਿ ਸਿਕੰਦਰ ਕੌ ਦਯੋ ॥੩੯॥",
      "transliteration": "ho aan laua(n)ddiyeh bahur sika(n)dhar kau dhayo ||39||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸਤਰੀ (ਲੌਂਡੀ) ਨੂੰ ਲਿਆ ਕੇ ਫਿਰ ਸਿਕੰਦਰ ਨੂੰ ਆਣ ਦਿੱਤਾ ॥੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "हो आनि लौंडियहि बहुरि सिकंदर कौ दयो ॥३९॥",
      "sourceLineId": "126255",
      "sourceShabadId": "11858",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "126256",
      "sourceShabadId": "11859",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਤਾ ਕੋ ਰੂਪ ਬਿਲੋਕਿ ਕੈ ਹਜਰਤਿ ਰਹਿਯੋ ਲੁਭਾਇ ॥",
      "transliteration": "taa ko roop bilok kai hajarat rahiyo lubhai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਇਸਤਰੀ) ਦਾ ਰੂਪ ਵੇਖ ਕੇ ਸਿਕੰਦਰ ਮੋਹਿਤ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "ता को रूप बिलोकि कै हजरति रहियो लुभाइ ॥",
      "sourceLineId": "126257",
      "sourceShabadId": "11859",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਲੈ ਆਪੁਨੀ ਇਸਤ੍ਰੀ ਕਰੀ ਢੋਲ ਮ੍ਰਿਦੰਗ ਬਜਾਇ ॥੪੦॥",
      "transliteration": "lai aapunee isatree karee ddol miradha(n)g bajai ||40||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਢੋਲ ਮ੍ਰਿਦੰਗ ਵਜਾ ਕੇ ਉਸ ਨੂੰ ਆਪਣੀ ਇਸਤਰੀ ਬਣਾ ਲਿਆ ॥੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "लै आपुनी इसत्री करी ढोल मृदंग बजाइ ॥४०॥",
      "sourceLineId": "126258",
      "sourceShabadId": "11859",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਬਹੁਰਿ ਜਹਾ ਅੰਮ੍ਰਿਤ ਸੁਨ੍ਯੋ ਗਯੋ ਤਵਨ ਕੀ ਓਰ ॥",
      "transliteration": "bahur jahaa a(n)mirat sunayo gayo tavan kee or ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਜਿਥੇ ਅੰਮ੍ਰਿਤ-ਕੁੰਡ ਸੁਣਿਆ ਸੀ, ਉਧਰ ਵਲ ਚਲ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "बहुरि जहा अंमृत सुन्यो गयो तवन की ओर ॥",
      "sourceLineId": "126259",
      "sourceShabadId": "11859",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਕਰਿ ਇਸਤ੍ਰੀ ਚੇਰੀ ਲਈ ਔਰ ਬੇਗਮਨ ਛੋਰਿ ॥੪੧॥",
      "transliteration": "kar isatree cheree liee aauar begaman chhor ||41||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਦਾਸੀ ਨੂੰ ਇਸਤਰੀ ਬਣਾ ਲਿਆ ਅਤੇ ਹੋਰਨਾ ਬੇਗਮਾ ਨੂੰ ਛਡ ਦਿੱਤਾ ॥੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "करि इसत्री चेरी लई और बेगमन छोरि ॥४१॥",
      "sourceLineId": "126260",
      "sourceShabadId": "11859",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "126261",
      "sourceShabadId": "11860",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਜੁ ਤ੍ਰਿਯ ਰੈਨਿ ਕੌ ਸੇਜ ਸੁਹਾਵੈ ॥",
      "transliteration": "j tiray rain kau sej suhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਇਸਤਰੀ ਰਾਤ ਨੂੰ ਸੇਜ ਨੂੰ ਸੁਸ਼ੋਭਿਤ ਕਰਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "जु तृय रैनि कौ सेज सुहावै ॥",
      "sourceLineId": "126262",
      "sourceShabadId": "11860",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਦਿਵਸ ਬੈਰਿਯਨ ਖੜਗ ਬਜਾਵੈ ॥",
      "transliteration": "dhivas bairiyan khaRag bajaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦਿਨ ਨੂੰ ਵੈਰੀਆਂ ਨਾਲ ਤਲਵਾਰ ਚਲਾਉਾਂਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "दिवस बैरियन खड़ग बजावै ॥",
      "sourceLineId": "126263",
      "sourceShabadId": "11860",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਐਸੀ ਤਰੁਨਿ ਕਰਨ ਜੌ ਪਰਈ ॥",
      "transliteration": "aaisee tarun karan jau pariee ||",
      "translation": "",
      "punjabiViakhya": "ਅਜਿਹੀ ਇਸਤਰੀ ਜੇ ਹੱਥ ਲਗ ਜਾਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "ऐसी तरुनि करन जौ परई ॥",
      "sourceLineId": "126264",
      "sourceShabadId": "11860",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਤਿਹ ਤਜਿ ਔਰ ਕਵਨ ਚਿਤ ਕਰਈ ॥੪੨॥",
      "transliteration": "teh taj aauar kavan chit kariee ||42||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੂੰ ਛਡ ਕੇ ਕਿਸੇ ਹੋਰ ਨੂੰ ਚਿਤ ਵਿਚ (ਕਿਉਾਂ) ਲਿਆਇਆ ਜਾਏ ॥੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "तिह तजि और कवन चित करई ॥४२॥",
      "sourceLineId": "126265",
      "sourceShabadId": "11860",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਾ ਸੋ ਰਤਿ ਠਾਨੀ ॥",
      "transliteration": "bhaat bhaat taa so rat Thaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਇਸਤਰੀ) ਨਾਲ ਭਾਤ ਭਾਤ ਦੀ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "भाति भाति ता सो रति ठानी ॥",
      "sourceLineId": "126266",
      "sourceShabadId": "11860",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਚੇਰੀ ਤੇ ਬੇਗਮ ਕਰਿ ਜਾਨੀ ॥",
      "transliteration": "cheree te begam kar jaanee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਨੂੰ ਦਾਸੀ ਤੋਂ ਬੇਗਮ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "चेरी ते बेगम करि जानी ॥",
      "sourceLineId": "126267",
      "sourceShabadId": "11860",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਤਾ ਕੌ ਸੰਗ ਆਪੁਨੇ ਲਯੋ ॥",
      "transliteration": "taa kau sa(n)g aapune layo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਆਪਣੇ ਨਾਲ ਲੈ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "ता कौ संग आपुने लयो ॥",
      "sourceLineId": "126268",
      "sourceShabadId": "11860",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਆਬਹਯਾਤ ਸੁਨ੍ਯੋ ਤਹ ਗਯੋ ॥੪੩॥",
      "transliteration": "aabahayaat sunayo teh gayo ||43||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਥੇ ਅੰਮ੍ਰਿਤ ('ਆਬਹਯਾਤ') ਸੁਣਿਆ ਸੀ, ਉਥੇ ਜਾ ਪਹੁੰਚਿਆ ॥੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "आबहयात सुन्यो तह गयो ॥४३॥",
      "sourceLineId": "126269",
      "sourceShabadId": "11860",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "126270",
      "sourceShabadId": "11861",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਜਹ ਤਾ ਕੌ ਚਸਮਾ ਹੁਤੋ ਤਹੀ ਪਹੂਚੋ ਜਾਇ ॥",
      "transliteration": "jeh taa kau chasamaa huto tahee pahoocho jai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਉਸ (ਅੰਮ੍ਰਿਤ) ਦਾ ਚਸ਼ਮਾ ਸੀ ਉਥੇ ਹੀ ਜਾ ਪਹੁੰਚਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "जह ता कौ चसमा हुतो तही पहूचो जाइ ॥",
      "sourceLineId": "126271",
      "sourceShabadId": "11861",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਮਕਰ ਕੁੰਟ ਜਹ ਡਾਰਿਯੈ ਮਛਲੀ ਹੋਇ ਬਨਾਇ ॥੪੪॥",
      "transliteration": "makar ku(n)T jeh ddaariyai machhalee hoi banai ||44||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਉਸ ਕੁੰਡ ਵਿਚ ਮਗਰਮਛ ਸੁਟ ਦੇਈਏ ਤਾ ਉਹ ਮਛਲੀ ਬਣ ਜਾਦਾ ਹੈ ॥੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "मकर कुँट जह डारियै मछली होइ बनाइ ॥४४॥",
      "sourceLineId": "126272",
      "sourceShabadId": "11861",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "126273",
      "sourceShabadId": "11862",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1120_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਇੰਦ੍ਰ ਦੇਵ ਤਬ ਮੰਤ੍ਰ ਬਤਾਯੋ ॥",
      "transliteration": "ei(n)dhr dhev tab ma(n)tr bataayo ||",
      "translation": "",
      "punjabiViakhya": "ਇੰਦਰ ਦੇਵ ਨੂੰ ਤਦ ਦੇਵਤਿਆਂ ਨੇ ਦਸਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1120,
      "hindi": "",
      "hindiTransliteration": "इंद्र देव तब मंत्र बतायो ॥",
      "sourceLineId": "126274",
      "sourceShabadId": "11862",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
