{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1127,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1127_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਵਲ ਕੁਅਰਹਿ ਬਿਲੋਕਿ ਹਿਯੋ ਲਲਚਾਇਯੋ ॥",
      "transliteration": "naval kuareh bilok hiyo lalachaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਨਵਲ ਕੁਮਾਰ ਨੂੰ ਵੇਖ ਕੇ ਉਸ ਦਾ ਜੀ ਲਲਚਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "नवल कुअरहि बिलोकि हियो ललचाइयो ॥",
      "sourceLineId": "126587",
      "sourceShabadId": "11913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪਠੈ ਸਹਚਰੀ ਨਿਜੁ ਗ੍ਰਿਹ ਬੋਲ ਪਠਾਇਯੋ ॥",
      "transliteration": "paThai sahacharee nij gireh bol paThaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਸਖੀ ਭੇਜ ਕੇ ਉਸ ਨੂੰ ਆਪਣੇ ਘਰ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "पठै सहचरी निजु गृह बोल पठाइयो ॥",
      "sourceLineId": "126588",
      "sourceShabadId": "11913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਧਿਕ ਮਾਨਿ ਰੁਚਿ ਰਮੀ ਹਰਖ ਉਪਜਾਇ ਕੈ ॥",
      "transliteration": "adhik maan ruch ramee harakh upajai kai ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਪ੍ਰਸੰਨ ਹੋ ਕੇ ਉਸ ਨਾਲ ਰੁਚੀ ਪੂਰਵਕ ਰਮਣ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "अधिक मानि रुचि रमी हरख उपजाइ कै ॥",
      "sourceLineId": "126589",
      "sourceShabadId": "11913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹੋ ਕਾਮ ਰੀਤਿ ਜੁਤ ਪ੍ਰੀਤਮ ਅਧਿਕ ਮਚਾਇ ਕੈ ॥੪॥",
      "transliteration": "ho kaam reet jut preetam adhik machai kai ||4||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰੀਤਮ ਨਾਲ ਕਾਮ ਦੀ ਰੀਤ ਨੂੰ ਬਹੁਤ ਅਧਿਕ ਮਚਾਇਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "हो काम रीति जुत प्रीतम अधिक मचाइ कै ॥४॥",
      "sourceLineId": "126590",
      "sourceShabadId": "11913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਛੈਲ ਛੈਲਨੀ ਛਕੈ ਅਧਿਕ ਸੁਖ ਪਾਵਹੀ ॥",
      "transliteration": "chhail chhailanee chhakai adhik sukh paavahee ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰੀਤਮ ਅਤੇ ਪ੍ਰੀਤਮਾ (ਭੋਗ ਦੁਆਰਾ) ਬਹੁਤ ਸੁਖ ਪ੍ਰਾਪਤ ਕਰ ਕੇ ਆਨੰਦਿਤ ਹੋ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "छैल छैलनी छकै अधिक सुख पावही ॥",
      "sourceLineId": "126591",
      "sourceShabadId": "11913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜੋਰ ਜੋਰ ਚਖੁ ਚਾਰ ਦੋਊ ਮੁਸਕਾਵਹੀ ॥",
      "transliteration": "jor jor chakh chaar dhouoo musakaavahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸੁੰਦਰ ਅੱਖਾ ਨੂੰ ਜੋੜ ਜੋੜ ਕੇ ਮੁਸਕਰਾਉਾਂਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "जोर जोर चखु चार दोऊ मुसकावही ॥",
      "sourceLineId": "126592",
      "sourceShabadId": "11913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਲਪਟ ਲਪਟ ਕਰਿ ਜਾਹਿ ਨ ਛਿਨ ਇਕ ਛੋਰਹੀ ॥",
      "transliteration": "lapaT lapaT kar jaeh na chhin ik chhorahee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਕ ਦੂਜੇ ਨਾਲ) ਲਿਪਟ ਰਹੇ ਸਨ ਅਤੇ ਇਕ ਛਿਣ ਲਈ ਵੀ ਨਹੀਂ ਛਡਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "लपट लपट करि जाहि न छिन इक छोरही ॥",
      "sourceLineId": "126593",
      "sourceShabadId": "11913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹੋ ਕਰਿ ਅਧਰਨ ਕੋ ਪਾਨ ਕੁਚਾਨ ਮਰੋਰਹੀ ॥੫॥",
      "transliteration": "ho kar adharan ko paan kuchaan marorahee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੋਠਾ ਨੂੰ ਚੂਸਦੇ ਅਤੇ ਕੁਚਾ ਨੂੰ ਮਰੋੜਦੇ ਸਨ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "हो करि अधरन को पान कुचान मरोरही ॥५॥",
      "sourceLineId": "126594",
      "sourceShabadId": "11913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਚੌਰਾਸਿਯਨ ਆਸਨਨ ਕਰਤ ਬਨਾਇ ਕੈ ॥",
      "transliteration": "chauaraasiyan aasanan karat banai kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਚੰਗੀ ਤਰ੍ਰਹਾ ਚੌਰਾਸੀ ਆਸਣ ਕਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "चौरासियन आसनन करत बनाइ कै ॥",
      "sourceLineId": "126595",
      "sourceShabadId": "11913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਾਮ ਕਲੋਲ ਮਚਾਇ ਅਧਿਕ ਸੁਖ ਪਾਇ ਕੈ ॥",
      "transliteration": "kaam kalol machai adhik sukh pai kai ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮ ਕਲੋਲ ਕਰ ਕੇ ਬਹੁਤ ਸੁਖ ਪਾਉਾਂਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "काम कलोल मचाइ अधिक सुख पाइ कै ॥",
      "sourceLineId": "126596",
      "sourceShabadId": "11913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕੋਕਸਾਰ ਕੇ ਭੇਦ ਉਚਰੈ ਬਨਾਇ ਕਰ ॥",
      "transliteration": "kokasaar ke bhedh ucharai banai kar ||",
      "translation": "",
      "punjabiViakhya": "ਕੋਕ ਸਾਰ ਦੇ ਭੇਦਾ ਨੂੰ ਦਸਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "कोकसार के भेद उचरै बनाइ कर ॥",
      "sourceLineId": "126597",
      "sourceShabadId": "11913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹੋ ਨਿਰਖਿ ਪ੍ਰਭਾ ਬਲਿ ਜਾਹਿ ਦੋਊ ਮੁਸਕਾਇ ਕਰਿ ॥੬॥",
      "transliteration": "ho nirakh prabhaa bal jaeh dhouoo musakai kar ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਵੇਾਂ (ਇਕ ਦੂਜੇ ਦੀ) ਸੁੰਦਰਤਾ ਨੂੰ ਵੇਖ ਕੇ ਹਸਦੇ ਹੋਏ ਕੁਰਬਾਨ ਜਾਦੇ ਸਨ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "हो निरखि प्रभा बलि जाहि दोऊ मुसकाइ करि ॥६॥",
      "sourceLineId": "126598",
      "sourceShabadId": "11913",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "126599",
      "sourceShabadId": "11914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਇਮਿ ਜਾਰ ਉਚਾਰੋ ॥",
      "transliteration": "ek dhivas im jaar uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਮਿਤਰ ਨੇ (ਰਾਣੀ ਨੂੰ) ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "एक दिवस इमि जार उचारो ॥",
      "sourceLineId": "126600",
      "sourceShabadId": "11914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੁਨੁ ਰਾਨੀ ਤੈ ਕਹਿਯੋ ਹਮਾਰੋ ॥",
      "transliteration": "sun raanee tai kahiyo hamaaro ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਣੀ! ਮੇਰੀ ਇਕ ਗੱਲ ਸੁਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "सुनु रानी तै कहियो हमारो ॥",
      "sourceLineId": "126601",
      "sourceShabadId": "11914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਿਨਿ ਤਵ ਨਾਥ ਬਿਲੋਕੈ ਆਈ ॥",
      "transliteration": "jin tav naath bilokai aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਮਤਾ ਕਿਤੇ ਤੇਰੇ ਪਤੀ ਨੇ ਆ ਕੇ ਵੇਖ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "जिनि तव नाथ बिलोकै आई ॥",
      "sourceLineId": "126602",
      "sourceShabadId": "11914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੁਹੂੰਅਨ ਹਨੇ ਕੋਪ ਉਪਜਾਈ ॥੭॥",
      "transliteration": "dhuhoo(n)an hane kop upajaiee ||7||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਦੋਹਾ ਨੂੰ ਮਾਰ ਦੇਵੇਗਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "दुहूँअन हने कोप उपजाई ॥७॥",
      "sourceLineId": "126603",
      "sourceShabadId": "11914",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤ੍ਰਿਯੋ ਬਾਚ ॥",
      "transliteration": "tirayo baach ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "तृयो बाच ॥",
      "sourceLineId": "126604",
      "sourceShabadId": "11915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪ੍ਰਥਮ ਰਾਵ ਤਨ ਭੇਦ ਜਤਾਊ ॥",
      "transliteration": "pratham raav tan bhedh jataauoo ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਮੈਂ ਸਾਰੀ ਗੱਲ ਰਾਜੇ ਨੂੰ ਦਸਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "प्रथम राव तन भेद जताऊ ॥",
      "sourceLineId": "126605",
      "sourceShabadId": "11915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਹੁਰਿ ਢਢੋਰੇ ਨਗਰ ਦਿਵਾਊ ॥",
      "transliteration": "bahur ddaddore nagar dhivaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਨਗਰ ਵਿਚ ਢੰਢੋਰਾ ਪਿਟਵਾਵਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "बहुरि ढढोरे नगर दिवाऊ ॥",
      "sourceLineId": "126606",
      "sourceShabadId": "11915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦੈ ਦੁੰਦਭਿ ਪੁਨਿ ਤੋਹਿ ਬੁਲੈਹੌ ॥",
      "transliteration": "dhai dhu(n)dhabh pun toh bulaihau ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਨਗਾਰਾ ਵਜਾ ਕੇ ਤੈਨੂੰ ਬੁਲਵਾਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "दै दुँदभि पुनि तोहि बुलैहौ ॥",
      "sourceLineId": "126607",
      "sourceShabadId": "11915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਰੁਚਿ ਮਾਨਿ ਮਚੈਹੌ ॥੮॥",
      "transliteration": "kaam bhog ruch maan machaihau ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰੁਚੀ ਪੂਰਵਕ ਕਾਮ ਭੋਗ ਕਰਾਗੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "काम भोग रुचि मानि मचैहौ ॥८॥",
      "sourceLineId": "126608",
      "sourceShabadId": "11915",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "126609",
      "sourceShabadId": "11916",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਧਿਕ ਭੋਗ ਕਰਿ ਮੀਤਹਿ ਦਯੋ ਉਠਾਇ ਕੈ ॥",
      "transliteration": "adhik bhog kar meeteh dhayo uThai kai ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਅਧਿਕ ਭੋਗ ਕਰ ਕੇ ਮਿਤਰ ਨੂੰ ਉਠਾ ਦਿੱਤਾ (ਅਰਥਾਤ ਭੇਜ ਦਿੱਤਾ)।",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "अधिक भोग करि मीतहि दयो उठाइ कै ॥",
      "sourceLineId": "126610",
      "sourceShabadId": "11916",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਪੁ ਨ੍ਰਿਪਤਿ ਸੌ ਕਹੀ ਬਾਤ ਸਮੁਝਾਇ ਕੈ ॥",
      "transliteration": "aap nirapat sau kahee baat samujhai kai ||",
      "translation": "",
      "punjabiViakhya": "ਆਪ ਰਾਜੇ ਨੂੰ ਸਮਝਾ ਕੇ ਗੱਲ ਕਹੀ",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "आपु नृपति सौ कही बात समुझाइ कै ॥",
      "sourceLineId": "126611",
      "sourceShabadId": "11916",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਿਵ ਮੋ ਕੌ ਇਹ ਭਾਤਿ ਕਹਿਯੋ ਹੌ ਆਇ ਕਰਿ ॥",
      "transliteration": "siv mo kau ieh bhaat kahiyo hau aai kar ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਸ਼ਿਵ ਨੇ ਮੈਨੂੰ ਆ ਕੇ ਕਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "सिव मो कौ इह भाति कहियो हौ आइ करि ॥",
      "sourceLineId": "126612",
      "sourceShabadId": "11916",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹੋ ਸੋ ਹਉ ਤੁਮਰੇ ਤੀਰ ਕਹੌ ਅਬ ਆਇ ਕਰਿ ॥੯॥",
      "transliteration": "ho so hau tumare teer kahau ab aai kar ||9||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਹੁਣ ਮੈਂ ਤੁਹਾਡੇ ਕੋਲ ਆ ਕੇ ਕਹਿੰਦੀ ਹਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "हो सो हउ तुमरे तीर कहौ अब आइ करि ॥९॥",
      "sourceLineId": "126613",
      "sourceShabadId": "11916",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "126614",
      "sourceShabadId": "11917",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਬ ਦਿਨ ਏਕ ਸਭਾਗਾ ਹ੍ਵੈ ਹੈ ॥",
      "transliteration": "jab dhin ek sabhaagaa havai hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਇਕ ਸੁਭਾਗਾ ਦਿਨ ਹੋਵੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "जब दिन एक सभागा ह्वै है ॥",
      "sourceLineId": "126615",
      "sourceShabadId": "11917",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਹਾਦੇਵ ਮੇਰੇ ਗ੍ਰਿਹ ਐ ਹੈ ॥",
      "transliteration": "mahaadhev mere gireh aai hai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮਹਾਦੇਵ ਮੇਰੇ ਘਰ ਆਉਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "महादेव मेरे गृह ऐ है ॥",
      "sourceLineId": "126616",
      "sourceShabadId": "11917",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਿਜੁ ਹਾਥਨ ਦੁੰਦਭੀ ਬਜਾਵੈ ॥",
      "transliteration": "nij haathan dhu(n)dhabhee bajaavai ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਹੱਥ ਨਾਲ ਦੁੰਦਭੀ ਵਜਾਉਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "निजु हाथन दुँदभी बजावै ॥",
      "sourceLineId": "126617",
      "sourceShabadId": "11917",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕੂਕਿ ਅਧਿਕ ਸਭ ਪੁਰਹਿ ਸੁਨਾਵੈ ॥੧੦॥",
      "transliteration": "kook adhik sabh pureh sunaavai ||10||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਦੀ) ਧੁਨੀ ਸਾਰੇ ਨਗਰ ਨੂੰ ਸੁਣਾਈ ਦੇਵੇਗੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "कूकि अधिक सभ पुरहि सुनावै ॥१०॥",
      "sourceLineId": "126618",
      "sourceShabadId": "11917",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਬ ਤੁਮ ਐਸ ਸਬਦ ਸੁਨਿ ਲੈਯਹੁ ॥",
      "transliteration": "jab tum aais sabadh sun laiyahu ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਤੁਸੀਂ ਅਜਿਹੀ ਧੁਨੀ ਸੁਣ ਲਵੋ",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "जब तुम ऐस सबद सुनि लैयहु ॥",
      "sourceLineId": "126619",
      "sourceShabadId": "11917",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਬ ਉਠ ਧਾਮ ਹਮਾਰੇ ਐਯਹੁ ॥",
      "transliteration": "tab uTh dhaam hamaare aaiyahu ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਠ ਕੇ ਮੇਰੇ ਮਹੱਲ ਵਿਚ ਆ ਜਾਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "तब उठ धाम हमारे ऐयहु ॥",
      "sourceLineId": "126620",
      "sourceShabadId": "11917",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭੇਦ ਕਿਸੂ ਔਰਹਿ ਨਹਿ ਕਹਿਯਹੁ ॥",
      "transliteration": "bhedh kisoo aauareh neh kahiyahu ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ) ਭੇਦ ਕਿਸੇ ਹੋਰ ਨੂੰ ਨਹੀਂ ਦਸਣਾ",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "भेद किसू औरहि नहि कहियहु ॥",
      "sourceLineId": "126621",
      "sourceShabadId": "11917",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭੋਗ ਸਮੌ ਤ੍ਰਿਯ ਕੋ ਭਯੋ ਲਹਿਯਹੁ ॥੧੧॥",
      "transliteration": "bhog samau tiray ko bhayo lahiyahu ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਮਝ ਲੈਣਾ ਕਿ ਇਸਤਰੀ ਦੇ ਭੋਗ ਦਾ ਸਮਾ ਹੋ ਗਿਆ ਹੈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "भोग समौ तृय को भयो लहियहु ॥११॥",
      "sourceLineId": "126622",
      "sourceShabadId": "11917",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "126623",
      "sourceShabadId": "11918",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤੁਰਤ ਆਨਿ ਮੋ ਕੋ ਭਜਹੁ ਸੁਨੁ ਰਾਜਾ ਸੁਖਧਾਮ ॥",
      "transliteration": "turat aan mo ko bhajahu sun raajaa sukhadhaam ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸੁਖਧਾਮ ਰਾਜੇ! ਸੁਣੋ। (ਤਦ ਤੁਸੀਂ) ਤੁਰਤ ਆ ਕੇ ਮੇਰੇ ਨਾਲ ਭੋਗ ਕਰਨਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "तुरत आनि मो को भजहु सुनु राजा सुखधाम ॥",
      "sourceLineId": "126624",
      "sourceShabadId": "11918",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪਲ੍ਰਯੋ ਪਰੋਸੋ ਹੋਇ ਸੁਤ ਮੋਹਨ ਰਖਿਯਹੁ ਨਾਮ ॥੧੨॥",
      "transliteration": "palrayo paroso hoi sut mohan rakhiyahu naam ||12||",
      "translation": "",
      "punjabiViakhya": "ਪਲਿਆ ਪਲੋਸਿਆ ਪੁੱਤਰ ਹੋਵੇਗਾ (ਅਤੇ ਉਸ ਦਾ) ਨਾ ਮੋਹਨ ਰਖਾਗੇ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "पल्रयो परोसो होइ सुत मोहन रखियहु नाम ॥१२॥",
      "sourceLineId": "126625",
      "sourceShabadId": "11918",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਯੌ ਕਹਿ ਕੈ ਨ੍ਰਿਪ ਸੋ ਬਚਨ ਗ੍ਰਿਹ ਤੇ ਦਿਯੋ ਉਠਾਇ ॥",
      "transliteration": "yau keh kai nirap so bachan gireh te dhiyo uThai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਕਹਿ ਕੇ ਰਾਜੇ ਨੂੰ ਘਰ ਤੋਂ ਭੇਜ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "यौ कहि कै नृप सो बचन गृह ते दियो उठाइ ॥",
      "sourceLineId": "126626",
      "sourceShabadId": "11918",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪਠੈ ਸਹਚਰੀ ਜਾਰ ਕੌ ਲੀਨੋ ਨਿਕਟ ਬੁਲਾਇ ॥੧੩॥",
      "transliteration": "paThai sahacharee jaar kau leeno nikaT bulai ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਖੀ ਭੇਜ ਕੇ ਯਾਰ ਨੂੰ ਕੋਲ ਬੁਲਾ ਲਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "पठै सहचरी जार कौ लीनो निकट बुलाइ ॥१३॥",
      "sourceLineId": "126627",
      "sourceShabadId": "11918",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "126628",
      "sourceShabadId": "11919",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਪ੍ਰੀਤਮ ਸੋ ਕਿਯੋ ॥",
      "transliteration": "kaam bhog preetam so kiyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਪ੍ਰੀਤਮ ਨਾਲ ਭੋਗ ਵਿਲਾਸ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "काम भोग प्रीतम सो कियो ॥",
      "sourceLineId": "126629",
      "sourceShabadId": "11919",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦ੍ਰਿੜ ਕਰਿ ਬਹੁਤ ਦਮਾਮੋ ਦਿਯੋ ॥",
      "transliteration": "dhiraR kar bahut dhamaamo dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬੜੇ ਜ਼ੋਰ ਨਾਲ ਦਮਾਮਾ ਵਜਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "दृड़ करि बहुत दमामो दियो ॥",
      "sourceLineId": "126630",
      "sourceShabadId": "11919",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕੂਕਿ ਕੂਕਿ ਪੁਰ ਸਕਲ ਸੁਨਾਇਸਿ ॥",
      "transliteration": "kook kook pur sakal sunais ||",
      "translation": "",
      "punjabiViakhya": "ਕੂਕ ਕੂਕ ਕੇ ਸਾਰੇ ਨਗਰ ਨੂੰ ਸੁਣਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "कूकि कूकि पुर सकल सुनाइसि ॥",
      "sourceLineId": "126631",
      "sourceShabadId": "11919",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭੋਗ ਸਮੈ ਰਾਨੀ ਕੋ ਆਇਸਿ ॥੧੪॥",
      "transliteration": "bhog samai raanee ko aais ||14||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਰਾਣੀ ਦੇ ਭੋਗ ਦਾ ਸਮਾ ਹੋ ਗਿਆ ਹੈ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "भोग समै रानी को आइसि ॥१४॥",
      "sourceLineId": "126632",
      "sourceShabadId": "11919",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਚਨ ਸੁਨਤ ਰਾਜਾ ਉਠਿ ਧਯੋ ॥",
      "transliteration": "bachan sunat raajaa uTh dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਬੋਲ ਸੁਣ ਕੇ ਰਾਜਾ ਭਜਦਾ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "बचन सुनत राजा उठि धयो ॥",
      "sourceLineId": "126633",
      "sourceShabadId": "11919",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1127_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਭੋਗ ਸਮੋ ਰਾਨੀ ਕੋ ਭਯੋ ॥",
      "transliteration": "bhog samo raanee ko bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਰਾਣੀ ਦੇ ਭੋਗ ਦਾ ਸਮਾ ਹੋ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1127,
      "hindi": "",
      "hindiTransliteration": "भोग समो रानी को भयो ॥",
      "sourceLineId": "126634",
      "sourceShabadId": "11919",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
