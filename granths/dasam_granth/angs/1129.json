{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1129,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1129_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਨਿ ਪ੍ਰਿਯਾ ਕਹ ਪ੍ਰੀਤਮ ਦਯੋ ਮਿਲਾਇ ਕੈ ॥",
      "transliteration": "aan pirayaa keh preetam dhayo milai kai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪ੍ਰੇਮਿਕਾ ਨੂੰ ਪ੍ਰੀਤਮ ਲਿਆ ਕੇ ਮਿਲਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "आनि पृया कह प्रीतम दयो मिलाइ कै ॥",
      "sourceLineId": "126683",
      "sourceShabadId": "11927",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਿਰਖਿ ਕੁਅਰਿ ਤਿਹ ਅੰਗ ਦਿਵਾਨੀ ਸੀ ਭਈ ॥",
      "transliteration": "nirakh kuar teh a(n)g dhivaanee see bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਸ਼ਰੀਰ ਨੂੰ ਵੇਖ ਕੇ ਕੁਮਾਰੀ ਦੀਵਾਨੀ ਜਿਹੀ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "निरखि कुअरि तिह अंग दिवानी सी भई ॥",
      "sourceLineId": "126684",
      "sourceShabadId": "11927",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹੋ ਬਿਰਹ ਸਮੁੰਦ ਕੇ ਮਾਝ ਮਗਨ ਹ੍ਵੈ ਕੈ ਗਈ ॥੭॥",
      "transliteration": "ho bireh samu(n)dh ke maajh magan havai kai giee ||7||",
      "translation": "",
      "punjabiViakhya": "(ਮਾਨੋ) ਬਿਰਹੋਂ ਦੇ ਸਮੁੰਦਰ ਵਿਚ ਮਗਨ ਹੋ ਗਈ ਹੋਵੇ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "हो बिरह समुँद के माझ मगन ह्वै कै गई ॥७॥",
      "sourceLineId": "126685",
      "sourceShabadId": "11927",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "126686",
      "sourceShabadId": "11928",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪ੍ਰੀਤਮ ਸ੍ਰਯੋਂ ਯੌ ਪ੍ਰਿਯਾ ਸੁਨਾਯੋ ॥",
      "transliteration": "preetam srayo(n) yau pirayaa sunaayo ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰੀਤਮ ਨੂੰ ਪ੍ਰੇਮਿਕਾ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "प्रीतम स्रयों यौ पृया सुनायो ॥",
      "sourceLineId": "126687",
      "sourceShabadId": "11928",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤੈ ਮੇਰੋ ਮਨ ਆਜੁ ਚੁਰਾਯੋ ॥",
      "transliteration": "tai mero man aaj churaayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੂੰ ਅਜ ਮੇਰਾ ਮਨ ਚੁਰਾ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "तै मेरो मन आजु चुरायो ॥",
      "sourceLineId": "126688",
      "sourceShabadId": "11928",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹੌ ਹੂੰ ਐਸ ਜਤਨ ਕਛੁ ਕਰਿਹੌ ॥",
      "transliteration": "hau hoo(n) aais jatan kachh karihau ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਕੁਝ ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਯਤਨ ਕਰਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "हौ हूँ ऐस जतन कछु करिहौ ॥",
      "sourceLineId": "126689",
      "sourceShabadId": "11928",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਭਹਿਨ ਛੋਰਿ ਤੋਹਿ ਕੌ ਬਰਿਹੌ ॥੮॥",
      "transliteration": "sabhahin chhor toh kau barihau ||8||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਸਾਰਿਆਂ ਨੂੰ ਛਡ ਕੇ ਤੇਰੇ ਨਾਲ ਵਿਆਹ ਕਰਾਗੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "सभहिन छोरि तोहि कौ बरिहौ ॥८॥",
      "sourceLineId": "126690",
      "sourceShabadId": "11928",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੋ ਤੁਹਿ ਕਹੌ ਮਿਤ੍ਰ ਸੋ ਕਰਿਯਹੁ ॥",
      "transliteration": "jo tuh kahau mitr so kariyahu ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮਿਤਰ! ਜਿਵੇਾਂ (ਮੈਂ) ਤੈਨੂੰ ਕਹਾ, ਉਸੇ ਤਰ੍ਰਹਾ ਕਰਨਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "जो तुहि कहौ मित्र सो करियहु ॥",
      "sourceLineId": "126691",
      "sourceShabadId": "11928",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮੋਰ ਪਿਤਾ ਤੇ ਨੈਕ ਨ ਡਰਿਯਹੁ ॥",
      "transliteration": "mor pitaa te naik na ddariyahu ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਪਿਤਾ ਤੋਂ ਬਿਲਕੁਲ ਨਾ ਡਰਨਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "मोर पिता ते नैक न डरियहु ॥",
      "sourceLineId": "126692",
      "sourceShabadId": "11928",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੂਰਜ ਨਾਮ ਆਪਨੋ ਧਰਿਯਹੁ ॥",
      "transliteration": "sooraj naam aapano dhariyahu ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣਾ ਨਾ ਸੂਰਜ ਰਖ ਲੈ",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "सूरज नाम आपनो धरियहु ॥",
      "sourceLineId": "126693",
      "sourceShabadId": "11928",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮੋਹਿ ਬਿਯਾਹਿ ਲੈ ਧਾਮ ਸਿਧਰਿਯਹੁ ॥੯॥",
      "transliteration": "moh biyaeh lai dhaam sidhariyahu ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੈਨੂੰ ਵਿਆਹ ਕੇ ਘਰ ਲੈ ਜਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "मोहि बियाहि लै धाम सिधरियहु ॥९॥",
      "sourceLineId": "126694",
      "sourceShabadId": "11928",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਬ ਅਬਲਾ ਨਿਜੁ ਪਿਤਾ ਬੁਲਾਯੋ ॥",
      "transliteration": "tab abalaa nij pitaa bulaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਸਤਰੀ ਨੇ ਆਪਣੇ ਪਿਤਾ ਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "तब अबला निजु पिता बुलायो ॥",
      "sourceLineId": "126695",
      "sourceShabadId": "11928",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪਕਰਿ ਬਾਹ ਤੇ ਮਿਤ੍ਰ ਦਿਖਾਯੋ ॥",
      "transliteration": "pakar baeh te mitr dhikhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਾਹ ਤੋਂ ਪਕੜ ਕੇ ਮਿਤਰ ਵਿਖਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "पकरि बाह ते मित्र दिखायो ॥",
      "sourceLineId": "126696",
      "sourceShabadId": "11928",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੁਨੁ ਰਾਜਾ ਸੂਰਜ ਇਹ ਆਹੀ ॥",
      "transliteration": "sun raajaa sooraj ieh aahee ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ) ਹੇ ਰਾਜਾ ਜੀ! ਸੁਣੋ, ਇਹ ਸੂਰਜ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "सुनु राजा सूरज इह आही ॥",
      "sourceLineId": "126697",
      "sourceShabadId": "11928",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚਾਹਤ ਹੈ ਤਵ ਸੁਤਾ ਬਿਯਾਹੀ ॥੧੦॥",
      "transliteration": "chaahat hai tav sutaa biyaahee ||10||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਤੁਹਾਡੀ ਪੁੱਤਰੀ ਨਾਲ ਵਿਆਹ ਕਰਨਾ ਚਾਹੁੰਦਾ ਹੈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "चाहत है तव सुता बियाही ॥१०॥",
      "sourceLineId": "126698",
      "sourceShabadId": "11928",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "126699",
      "sourceShabadId": "11929",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪ੍ਰਥਮ ਪ੍ਰਤਿਗ੍ਰਯਾ ਲੀਜਿਯੈ ਯਾ ਕੀ ਅਬੈ ਬਨਾਇ ॥",
      "transliteration": "pratham pratigrayaa leejiyai yaa kee abai banai ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਹੀ ਪਹਿਲਾ ਇਸ ਤੋਂ ਪ੍ਰਤਿਗਿਆ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "प्रथम प्रतिग्रया लीजियै या की अबै बनाइ ॥",
      "sourceLineId": "126700",
      "sourceShabadId": "11929",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪੁਨਿ ਮੋ ਕੌ ਇਹ ਦੀਜਿਯੈ ਸੁਨੁ ਰਾਜਨ ਕੇ ਰਾਇ ॥੧੧॥",
      "transliteration": "pun mo kau ieh dheejiyai sun raajan ke rai ||11||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਹੇ ਰਾਜਿਆਂ ਦੇ ਰਾਜੇ! ਸੁਣੋ, ਫਿਰ ਮੈਨੂੰ ਇਸ ਨੂੰ ਸੌਂਪ ਦਿਓ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "पुनि मो कौ इह दीजियै सुनु राजन के राइ ॥११॥",
      "sourceLineId": "126701",
      "sourceShabadId": "11929",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਬ ਲੌ ਇਹ ਇਹ ਘਰ ਰਹੈ ਚੜੈ ਨ ਸੂਰਜ ਅਕਾਸ ॥",
      "transliteration": "jab lau ieh ieh ghar rahai chaRai na sooraj akaas ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਤਕ ਇਹ ਇਸ ਘਰ ਵਿਚ ਰਹਿੰਦਾ ਹੈ (ਤਦ ਤਕ) ਸੂਰਜ ਆਕਾਸ਼ ਵਿਚ ਨਹੀਂ ਚੜ੍ਰਹਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "जब लौ इह इह घर रहै चड़ै न सूरज अकास ॥",
      "sourceLineId": "126702",
      "sourceShabadId": "11929",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਬ ਇਹ ਜਾਇ ਤਹਾ ਚੜੇ ਜਗ ਮੈ ਹੋਇ ਪ੍ਰਕਾਸ ॥੧੨॥",
      "transliteration": "jab ieh jai tahaa chaRe jag mai hoi prakaas ||12||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਇਹ ਜਾਦਾ ਹੈ, (ਤਾ) ਉਥੇ ਚੜ੍ਰਹਦਾ ਹੈ ਅਤੇ ਜਗਤ ਵਿਚ ਪ੍ਰਕਾਸ਼ ਹੁੰਦਾ ਹੈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "जब इह जाइ तहा चड़े जग मै होइ प्रकास ॥१२॥",
      "sourceLineId": "126703",
      "sourceShabadId": "11929",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "126704",
      "sourceShabadId": "11930",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਤ੍ਯ ਬਾਤ ਰਾਜੈ ਇਹ ਜਾਨੀ ॥",
      "transliteration": "satay baat raajai ieh jaanee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਇਸ ਗੱਲ ਨੂੰ ਸਚ ਮੰਨ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "सत्य बात राजै इह जानी ॥",
      "sourceLineId": "126705",
      "sourceShabadId": "11930",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭੇਦ ਨ ਲਖਿਯੋ ਕਛੂ ਅਗ੍ਯਾਨੀ ॥",
      "transliteration": "bhedh na lakhiyo kachhoo agayaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਅਗਿਆਨੀ ਨੇ (ਵਾਸਤਵਿਕ) ਭੇਦ ਨਾ ਪਛਾਣਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "भेद न लखियो कछू अग्यानी ॥",
      "sourceLineId": "126706",
      "sourceShabadId": "11930",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਰਾਜ ਕੁਮਾਰਿ ਮੰਤ੍ਰ ਇਕ ਪੜਿਯੋ ॥",
      "transliteration": "raaj kumaar ma(n)tr ik paRiyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਇਕ ਮੰਤ੍ਰ ਪੜ੍ਰਹਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "राज कुमारि मंत्र इक पड़ियो ॥",
      "sourceLineId": "126707",
      "sourceShabadId": "11930",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦ੍ਵੈ ਦਿਨ ਲਗੇ ਸੂਰਜ ਨਹਿ ਚੜਿਯੋ ॥੧੩॥",
      "transliteration": "dhavai dhin lage sooraj neh chaRiyo ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋ ਦਿਨਾ ਤਕ ਸੂਰਜ ਨਹੀਂ ਚੜ੍ਰਹਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "द्वै दिन लगे सूरज नहि चड़ियो ॥१३॥",
      "sourceLineId": "126708",
      "sourceShabadId": "11930",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "126709",
      "sourceShabadId": "11931",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮੰਤ੍ਰਨ ਸੋ ਅਭਿਮੰਤ੍ਰ ਕਰਿ ਬਰਿਯਾ ਦਈ ਉਡਾਇ ॥",
      "transliteration": "ma(n)tran so abhima(n)tr kar bariyaa dhiee uddai ||",
      "translation": "",
      "punjabiViakhya": "ਮੰਤ੍ਰਾ ਨਾਲ ਮੰਦਰ ਕੇ ਬਟੀ (ਗੋਲੀ) ਉਡਾ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "मंत्रन सो अभिमंत्र करि बरिया दई उडाइ ॥",
      "sourceLineId": "126710",
      "sourceShabadId": "11931",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਿਸੁ ਨਾਇਕ ਸੋ ਜਾਨਿਯੈ ਗਗਨ ਰਹਿਯੋ ਥਹਰਾਇ ॥੧੪॥",
      "transliteration": "nis naik so jaaniyai gagan rahiyo thaharai ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇੰਜ ਲਗਿਆ ਕਿ ਚੰਦ੍ਰਮਾ ਆਕਾਸ਼ ਵਿਚ ਥਰਥਰਾ ਰਿਹਾ ਹੈ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "निसु नाइक सो जानियै गगन रहियो थहराइ ॥१४॥",
      "sourceLineId": "126711",
      "sourceShabadId": "11931",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "126712",
      "sourceShabadId": "11932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਬ ਰਾਜੇ ਇਹ ਭਾਤਿ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "jab raaje ieh bhaat nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "जब राजे इह भाति निहारियो ॥",
      "sourceLineId": "126713",
      "sourceShabadId": "11932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਤ੍ਯ ਸੂਰਜ ਕਰਿ ਤਾਹਿ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "satay sooraj kar taeh bichaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੂੰ ਸਚ ਮੁਚ ਸੂਰਜ ਕਰ ਕੇ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "सत्य सूरज करि ताहि बिचारियो ॥",
      "sourceLineId": "126714",
      "sourceShabadId": "11932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤੁਰਤ ਬ੍ਯਾਹਿ ਦੁਹਿਤਾ ਤਿਹ ਦੀਨੀ ॥",
      "transliteration": "turat bayaeh dhuhitaa teh dheenee ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਰਤ ਪੁੱਤਰੀ ਦਾ ਵਿਆਹ ਉਸ ਨਾਲ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "तुरत ब्याहि दुहिता तिह दीनी ॥",
      "sourceLineId": "126715",
      "sourceShabadId": "11932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਕੀ ਬਾਤ ਨ ਚੀਨੀ ॥੧੫॥",
      "transliteration": "bhedh abhedh kee baat na cheenee ||15||",
      "translation": "",
      "punjabiViakhya": "ਭੇਦ ਅਭੇਦ ਦੀ ਕੋਈ ਗੱਲ ਨਾ ਸਮਝੀ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद की बात न चीनी ॥१५॥",
      "sourceLineId": "126716",
      "sourceShabadId": "11932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਪਚੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੨੫॥੪੨੮੯॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau pachees charitr samaapatam sat subham sat ||225||4289||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੨੨੫ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੨੫॥੪੨੮੯॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ पचीस चरित्र समापतम सतु सुभम सतु ॥२२५॥४२८९॥अफजूँ॥",
      "sourceLineId": "126717",
      "sourceShabadId": "11932",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "126718",
      "sourceShabadId": "11933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਾਲਨੇਰ ਕੇ ਦੇਸ ਮੈ ਮਾਲਕੌਸ ਪੁਰ ਗਾਉ ॥",
      "transliteration": "maalaner ke dhes mai maalakauas pur gaau ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਲਨੇਰ ਦੇਸ ਵਿਚ ਇਕ ਮਾਲਕੌਸ ਪੁਰ ਨਾ ਦਾ ਪਿੰਡ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "मालनेर के देस मै मालकौस पुर गाउ ॥",
      "sourceLineId": "126719",
      "sourceShabadId": "11933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਾਨ ਸਾਹ ਇਕ ਚੌਧਰੀ ਬਸਤ ਸੁ ਤਵਨੈ ਠਾਉ ॥੧॥",
      "transliteration": "maan saeh ik chauadharee basat su tavanai Thaau ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਥਾ ਤੇ ਮਾਨ ਸ਼ਾਹ ਨਾ ਦਾ ਇਕ ਚੌਧਰੀ ਵਸਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "मान साह इक चौधरी बसत सु तवनै ठाउ ॥१॥",
      "sourceLineId": "126720",
      "sourceShabadId": "11933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰੁਸਤਮ ਦੇਈ ਤਵਨ ਕੀ ਰਹਤ ਸੁੰਦਰੀ ਨਾਰਿ ॥",
      "transliteration": "rusatam dheiee tavan kee rahat su(n)dharee naar ||",
      "translation": "",
      "punjabiViakhya": "ਰੁਸਤਮ ਦੇਈ ਨਾ ਦੀ ਉਸ ਦੀ ਸੁੰਦਰ ਇਸਤਰੀ ਰਹਿੰਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "रुसतम देई तवन की रहत सुँदरी नारि ॥",
      "sourceLineId": "126721",
      "sourceShabadId": "11933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰੂਪ ਸੀਲ ਸੁਚਿ ਕ੍ਰਿਆ ਸੁਭ ਪਤਿ ਕੀ ਅਤਿ ਹਿਤਕਾਰ ॥੨॥",
      "transliteration": "roop seel such kriaa subh pat kee at hitakaar ||2||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਰੂਪ, ਸ਼ੀਲ, ਪਵਿਤ੍ਰਤਾ ਅਤੇ ਕਰਮ ਕਰ ਕੇ ਸ਼ੁਭ ਸੀ ਅਤੇ ਪਤੀ ਦੀ ਬਹੁਤ ਹਿਤੈਸ਼ੀ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "रूप सील सुचि कृआ सुभ पति की अति हितकार ॥२॥",
      "sourceLineId": "126722",
      "sourceShabadId": "11933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਾ ਕੋ ਪਤਿ ਉਮਰਾਵ ਕੀ ਕਰਤ ਚਾਕਰੀ ਨਿਤਿ ॥",
      "transliteration": "taa ko pat umaraav kee karat chaakaree nit ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਪਤੀ ਉਮਰਾਓ ਦੀ ਨਿੱਤ ਨੌਕਰੀ ਕਰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "ता को पति उमराव की करत चाकरी निति ॥",
      "sourceLineId": "126723",
      "sourceShabadId": "11933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਾਹਜਹਾ ਕੇ ਧਾਮ ਕੋ ਰਾਖੈ ਦਰਬੁ ਅਮਿਤਿ ॥੩॥",
      "transliteration": "saahajahaa ke dhaam ko raakhai dharab amit ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਾਹਜਹਾਨ ਦੇ ਘਰ ਦੇ ਅਮਿਤ ਧਨ ਦੌਲਤ ਦੀ ਰਖਿਆ ਕਰਦਾ ਸੀ (ਭਾਵ ਖ਼ਜ਼ਾਨਚੀ ਦੀ ਜ਼ਿੰਮੇਵਾਰੀ ਨਿਭਾਉਾਂਦਾ ਸੀ) ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "साहजहा के धाम को राखै दरबु अमिति ॥३॥",
      "sourceLineId": "126724",
      "sourceShabadId": "11933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭਾਗ ਪਿਯਤ ਬਹੁ ਚੌਧਰੀ ਔਰ ਅਫੀਮ ਚੜਾਇ ॥",
      "transliteration": "bhaag piyat bahu chauadharee aauar afeem chaRai ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਧਰੀ ਬਹੁਤ ਭੰਗ ਪੀਂਦਾ ਸੀ ਅਤੇ ਅਫ਼ੀਮ ਵੀ ਖਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "भाग पियत बहु चौधरी और अफीम चड़ाइ ॥",
      "sourceLineId": "126725",
      "sourceShabadId": "11933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਆਠ ਪਹਰ ਘੂਮਤ ਰਹੈ ਲੋਗ ਹਸੈ ਬਹੁ ਆਇ ॥੪॥",
      "transliteration": "aaTh pahar ghoomat rahai log hasai bahu aai ||4||",
      "translation": "",
      "punjabiViakhya": "ਉਹੁ ਅੱਠੇ ਪਹਿਰ ਘੁੰਮਦਾ ਰਹਿੰਦਾ ਸੀ ਅਤੇ ਬਹੁਤ ਲੋਕ ਆ ਕੇ ਹਸਦੇ ਸਨ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "आठ पहर घूमत रहै लोग हसै बहु आइ ॥४॥",
      "sourceLineId": "126726",
      "sourceShabadId": "11933",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "126727",
      "sourceShabadId": "11934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਲੋਕ ਸਕਲ ਮਿਲਿ ਤਾਹਿ ਬਖਾਨੈ ॥",
      "transliteration": "lok sakal mil taeh bakhaanai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਲੋਕ ਮਿਲ ਕੇ ਉਸ ਦੀਆਂ ਗੱਲਾ ਕਰਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "लोक सकल मिलि ताहि बखानै ॥",
      "sourceLineId": "126728",
      "sourceShabadId": "11934",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1129_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮੂਰਖ ਸਾਹ ਕਛੂ ਨਹਿ ਜਾਨੈ ॥",
      "transliteration": "moorakh saeh kachhoo neh jaanai ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ (ਉਹ) ਮੂਰਖ ਸ਼ਾਹ ਕੁਝ ਨਹੀਂ ਸਮਝਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": "मूरख साह कछू नहि जानै ॥",
      "sourceLineId": "126729",
