{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1133,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1133_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮੁਹਰਨ ਕੇ ਕੁਲਿ ਸੁਨਤ ਉਚਰੇ ॥",
      "transliteration": "muharan ke kul sunat uchare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਭ ਨੂੰ ਮੋਹਰਾ (ਦੇ ਭਰੇ ਹੋਏ) ਸੁਣਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "मुहरन के कुलि सुनत उचरे ॥",
      "sourceLineId": "126899",
      "sourceShabadId": "11957",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪੁਤ੍ਰ ਪਉਤ੍ਰ ਤਾ ਦਿਨ ਤੇ ਤਾ ਕੇ ॥",
      "transliteration": "putr pautr taa dhin te taa ke ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਪੁੱਤਰ ਪੋਤਰੇ ਉਸ ਦਿਨ ਤੋਂ",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "पुत्र पउत्र ता दिन ते ता के ॥",
      "sourceLineId": "126900",
      "sourceShabadId": "11957",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਉਦਿਤ ਭਏ ਸੇਵਾ ਕਹ ਵਾ ਕੇ ॥੨॥",
      "transliteration": "audhit bhe sevaa keh vaa ke ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੇਵਾ ਵਿਚ ਜੁਟ ਗਏ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "उदित भए सेवा कह वा के ॥२॥",
      "sourceLineId": "126901",
      "sourceShabadId": "11957",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "126902",
      "sourceShabadId": "11958",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜੁ ਕਛੁ ਕਹੈ ਪ੍ਰਿਯ ਮਾਨਹੀ ਸੇਵਾ ਕਰਹਿ ਬਨਾਇ ॥",
      "transliteration": "j kachh kahai piray maanahee sevaa kareh banai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਜੋ ਕਹਿੰਦੀ ਉਸ ਨੂੰ ਸੁਖਾਵਾ ਸਮਝਦੇ ਅਤੇ ਖ਼ੂਬ ਸੇਵਾ ਕਰਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "जु कछु कहै पृय मानही सेवा करहि बनाइ ॥",
      "sourceLineId": "126903",
      "sourceShabadId": "11958",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਆਇਸੁ ਮੈ ਸਭ ਹੀ ਚਲੈ ਦਰਬੁ ਹੇਤ ਲਲਚਾਇ ॥੩॥",
      "transliteration": "aais mai sabh hee chalai dharab het lalachai ||3||",
      "translation": "",
      "punjabiViakhya": "ਧਨ ਦੇ ਲਾਲਚ ਕਰ ਕੇ ਸਭ (ਉਸ ਦੀ) ਆਗਿਆ ਵਿਚ ਚਲਦੇ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "आइसु मै सभ ही चलै दरबु हेत ललचाइ ॥३॥",
      "sourceLineId": "126904",
      "sourceShabadId": "11958",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "126905",
      "sourceShabadId": "11959",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੋ ਆਗ੍ਯਾ ਤ੍ਰਿਯ ਕਰੈ ਸੁ ਮਾਨੈ ॥",
      "transliteration": "jo aagayaa tiray karai su maanai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਸਤਰੀ ਜੋ ਆਗਿਆ ਕਰਦੀ, ਉਹ ਮੰਨ ਲੈਂਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "जो आग्या तृय करै सु मानै ॥",
      "sourceLineId": "126906",
      "sourceShabadId": "11959",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੂਤਿਨ ਕੋ ਮੁਹਰੈ ਪਹਿਚਾਨੈ ॥",
      "transliteration": "jootin ko muharai pahichaanai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜੁਤੀਆਂ ਨੂੰ ਮੋਹਰਾ ਵਜੋਂ ਪਛਾਣਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "जूतिन को मुहरै पहिचानै ॥",
      "sourceLineId": "126907",
      "sourceShabadId": "11959",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਆਜੁ ਕਾਲਿ ਬੁਢਿਯਾ ਮਰਿ ਜੈ ਹੈ ॥",
      "transliteration": "aaj kaal buddiyaa mar jai hai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਮਨ ਵਿਚ ਸੋਚਦੇ ਸਨ ਕਿ) ਅਜ ਕਲ ਬੁੱਡੀ ਮਰ ਜਾਏਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "आजु कालि बुढिया मरि जै है ॥",
      "sourceLineId": "126908",
      "sourceShabadId": "11959",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਭ ਹੀ ਦਰਬੁ ਹਮਾਰੋ ਹ੍ਵੈ ਹੈ ॥੪॥",
      "transliteration": "sabh hee dharab hamaaro havai hai ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਾ ਧਨ ਸਾਡਾ ਹੋ ਜਾਵੇਗਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "सभ ही दरबु हमारो ह्वै है ॥४॥",
      "sourceLineId": "126909",
      "sourceShabadId": "11959",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਬ ਤਿਹ ਨਿਕਟਿ ਕੁਟੰਬ ਸਭਾਵੈ ॥",
      "transliteration": "jab teh nikaT kuTa(n)b sabhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਕਦੇ ਸਾਰਾ ਕੁਟੁੰਬ ਉਸ ਦੇ ਨੇੜੇ ਆਉਾਂਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "जब तिह निकटि कुटंब सभावै ॥",
      "sourceLineId": "126910",
      "sourceShabadId": "11959",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਹ ਬੁਢਿਯਾ ਯੌ ਬਚਨ ਸੁਨਾਵੈ ॥",
      "transliteration": "teh buddiyaa yau bachan sunaavai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਬੁੱਢੀ ਉਨ੍ਰਹਾ ਨੂੰ ਕਹਿੰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "तह बुढिया यौ बचन सुनावै ॥",
      "sourceLineId": "126911",
      "sourceShabadId": "11959",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਿਯਤ ਲਗੇ ਇਹ ਦਰਬ ਹਮਾਰੋ ॥",
      "transliteration": "jiyat lage ieh dharab hamaaro ||",
      "translation": "",
      "punjabiViakhya": "ਜੀਉਾਂਦੇ ਜੀ ਇਹ ਧਨ ਮੇਰਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "जियत लगे इह दरब हमारो ॥",
      "sourceLineId": "126912",
      "sourceShabadId": "11959",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਹੁਰਿ ਲੀਜਿਯਹੁ ਪੂਤ ਤਿਹਾਰੋ ॥੫॥",
      "transliteration": "bahur leejiyahu poot tihaaro ||5||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਹੇ ਪੁੱਤਰੋ! (ਇਹ) ਲੈ ਲੈਣਾ, ਤੁਹਾਡਾ ਹੀ ਹੈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "बहुरि लीजियहु पूत तिहारो ॥५॥",
      "sourceLineId": "126913",
      "sourceShabadId": "11959",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਬ ਵਹੁ ਤ੍ਰਿਯਾ ਰੋਗਨੀ ਭਈ ॥",
      "transliteration": "jab vahu tirayaa roganee bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਇਸਤਰੀ ਬੀਮਾਰ ਹੋ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "जब वहु तृया रोगनी भई ॥",
      "sourceLineId": "126914",
      "sourceShabadId": "11959",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਾਜੀ ਕੁਟਵਾਰਹਿ ਕਹਿ ਗਈ ॥",
      "transliteration": "kaajee kuTavaareh keh giee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਕਾਜ਼ੀ ਕੋਤਵਾਲ ਨੂੰ ਕਹਿ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "काजी कुटवारहि कहि गई ॥",
      "sourceLineId": "126915",
      "sourceShabadId": "11959",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਰਮ ਧਰਮ ਜੋ ਪ੍ਰਥਮ ਕਰੈਹੈ ॥",
      "transliteration": "karam dharam jo pratham karaihai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਪਹਿਲਾ ਜੋ ਮੇਰਾ ਕ੍ਰਿਆ ਕਰਮ ਕਰੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "करम धरम जो प्रथम करैहै ॥",
      "sourceLineId": "126916",
      "sourceShabadId": "11959",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੋ ਸੁਤ ਬਹੁਰਿ ਖਜਾਨੋ ਲੈਹੈ ॥੬॥",
      "transliteration": "so sut bahur khajaano laihai ||6||",
      "translation": "",
      "punjabiViakhya": "ਉਹੀ ਪੁੱਤਰ ਫਿਰ ਖ਼ਜ਼ਾਨਾ ਪ੍ਰਾਪਤ ਕਰੇਗਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "सो सुत बहुरि खजानो लैहै ॥६॥",
      "sourceLineId": "126917",
      "sourceShabadId": "11959",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "126918",
      "sourceShabadId": "11960",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਰਮ ਧਰਮ ਸੁਤ ਜਬ ਲਗੇ ਕਰੈ ਨ ਪ੍ਰਥਮ ਬਨਾਇ ॥",
      "transliteration": "karam dharam sut jab lage karai na pratham banai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਤਕ ਪਹਿਲਾ ਮੇਰਾ ਕ੍ਰਿਆ-ਕਰਮ (ਮੇਰੇ) ਪੁੱਤਰ ਨਾ ਕਰ ਚੁਕਣ",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "करम धरम सुत जब लगे करै न प्रथम बनाइ ॥",
      "sourceLineId": "126919",
      "sourceShabadId": "11960",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਬ ਲੌ ਸੁਤਨ ਨ ਦੀਜਿਯਹੁ ਹਮਰੋ ਦਰਬੁ ਬੁਲਾਇ ॥੭॥",
      "transliteration": "tab lau sutan na dheejiyahu hamaro dharab bulai ||7||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਮੇਰੇ ਪੁੱਤਰਾ ਨੂੰ ਬੁਲਾ ਕੇ ਮੇਰਾ ਧਨ ਨਾ ਦੇਣਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "तब लौ सुतन न दीजियहु हमरो दरबु बुलाइ ॥७॥",
      "sourceLineId": "126920",
      "sourceShabadId": "11960",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "126921",
      "sourceShabadId": "11961",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਿਤਿਕ ਦਿਨਨ ਬੁਢਿਯਾ ਮਰਿ ਗਈ ॥",
      "transliteration": "kitik dhinan buddiyaa mar giee ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਝ ਦਿਨਾ ਤਕ ਬਿਰਧ ਇਸਤਰੀ ਮਰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "कितिक दिनन बुढिया मरि गई ॥",
      "sourceLineId": "126922",
      "sourceShabadId": "11961",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਿਨ ਕੇ ਹ੍ਰਿਦਨ ਖੁਸਾਲੀ ਭਈ ॥",
      "transliteration": "tin ke hiradhan khusaalee bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ (ਪੁੱਤਰਾ ਪੋਤਰਿਆਂ) ਦੇ ਹਿਰਦੇ ਵਿਚ ਖ਼ੁਸ਼ੀ ਹੋਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "तिन के हृदन खुसाली भई ॥",
      "sourceLineId": "126923",
      "sourceShabadId": "11961",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਰਮ ਧਰਮ ਜੋ ਪ੍ਰਥਮ ਕਰੈਹੈ ॥",
      "transliteration": "karam dharam jo pratham karaihai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਜੋ ਕ੍ਰਿਆ ਕਰਮ ਕਰਨਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "करम धरम जो प्रथम करैहै ॥",
      "sourceLineId": "126924",
      "sourceShabadId": "11961",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪੁਨਿ ਇਹ ਬਾਟਿ ਖਜਾਨੋ ਲੈਹੈ ॥੮॥",
      "transliteration": "pun ieh baaT khajaano laihai ||8||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ (ਉਹ) ਇਹ ਖ਼ਜ਼ਾਨਾ ਵੰਡ ਲੈਣਗੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "पुनि इह बाटि खजानो लैहै ॥८॥",
      "sourceLineId": "126925",
      "sourceShabadId": "11961",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "126926",
      "sourceShabadId": "11962",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਰਮ ਧਰਮ ਤਾ ਕੇ ਕਰੇ ਅਤਿ ਧਨੁ ਸੁਤਨ ਲਗਾਇ ॥",
      "transliteration": "karam dharam taa ke kare at dhan sutan lagai ||",
      "translation": "",
      "punjabiViakhya": "ਪੁੱਤਰਾ ਨੇ ਬਹੁਤ ਧਨ ਖ਼ਰਚ ਕਰ ਕੇ ਉਸ ਦਾ ਕ੍ਰਿਆ ਕਰਮ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "करम धरम ता के करे अति धनु सुतन लगाइ ॥",
      "sourceLineId": "126927",
      "sourceShabadId": "11962",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਹੁਰਿ ਸੰਦੂਕ ਪਨ੍ਰਹੀਨ ਕੇ ਛੋਰਤ ਭੇ ਮਿਲਿ ਆਇ ॥੯॥",
      "transliteration": "bahur sa(n)dhook panraheen ke chhorat bhe mil aai ||9||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਮਿਲ ਕੇ ਆਏ ਅਤੇ ਜੁਤੀਆਂ ਦੇ ਸੂੰਦਕ ਖੋਲਣ ਲਗੇ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "बहुरि संदूक पन्रहीन के छोरत भे मिलि आइ ॥९॥",
      "sourceLineId": "126928",
      "sourceShabadId": "11962",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "126929",
      "sourceShabadId": "11963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਤ੍ਰਿਯ ਸੇਵ ਕਰਾਈ ॥",
      "transliteration": "eeh charitr tiray sev karaiee ||",
      "translation": "",
      "punjabiViakhya": "ਪੁੱਤਰਾ ਨੂੰ ਧਨ ਦਾ ਲੋਭ ਵਿਖਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र तृय सेव कराई ॥",
      "sourceLineId": "126930",
      "sourceShabadId": "11963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੁਤਨ ਦਰਬੁ ਕੌ ਲੋਭ ਦਿਖਾਈ ॥",
      "transliteration": "sutan dharab kau lobh dhikhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਚਰਿਤ੍ਰ ਨਾਲ ਇਸਤਰੀ ਨੇ ਸੇਵਾ ਕਰਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "सुतन दरबु कौ लोभ दिखाई ॥",
      "sourceLineId": "126931",
      "sourceShabadId": "11963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਿਨ ਕੇ ਅੰਤ ਨ ਕਛੁ ਕਰ ਆਯੋ ॥",
      "transliteration": "tin ke a(n)t na kachh kar aayo ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਤ ਵਿਚ ਉਨ੍ਰਹਾ ਦੇ ਹੱਥ ਵਿਚ ਕੁਝ ਨਾ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "तिन के अंत न कछु कर आयो ॥",
      "sourceLineId": "126932",
      "sourceShabadId": "11963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਛਲ ਬਲ ਅਪਨੋ ਮੂੰਡ ਮੁੰਡਾਯੋ ॥੧੦॥",
      "transliteration": "chhal bal apano moo(n)dd mu(n)ddaayo ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਛਲ ਦੇ ਬਲ ਕਰ ਕੇ ਆਪਣਾ ਸਿਰ ਮੁੰਨਵਾ ਲਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "छल बल अपनो मूँड मुँडायो ॥१०॥",
      "sourceLineId": "126933",
      "sourceShabadId": "11963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਉਨਤੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੨੯॥੪੩੪੪॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau unatees charitr samaapatam sat subham sat ||229||4344||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੨੨੯ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੨੯॥੪੩੪੪॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पखयाने तृया चरित्रे मंत्री भूप संबादे दोइ सौ उनतीस चरित्र समापतम सतु सुभम सतु ॥२२९॥४३४४॥अफजूँ॥",
      "sourceLineId": "126934",
      "sourceShabadId": "11963",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "126935",
      "sourceShabadId": "11964",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਾਲਨੇਰ ਕੇ ਦੇਸ ਮੈ ਮਰਗਜ ਪੁਰ ਇਕ ਗਾਉਾਂ ॥",
      "transliteration": "maalaner ke dhes mai maragaj pur ik gaauaa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਲਨੇਰ ਦੇਸ ਵਿਚ ਮਰਗਜ ਪੁਰ ਨਾ ਦਾ ਇਕ ਪਿੰਡ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "मालनेर के देस मै मरगज पुर इक गाउाँ ॥",
      "sourceLineId": "126936",
      "sourceShabadId": "11964",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਾਹ ਏਕ ਤਿਹ ਠਾ ਬਸਤ ਮਦਨ ਸਾਹ ਤਿਹ ਨਾਉ ॥੧॥",
      "transliteration": "saeh ek teh Thaa basat madhan saeh teh naau ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸ਼ਾਹ ਵਸਦਾ ਸੀ; ਉਸ ਦਾ ਨਾ ਮਦਨ ਸ਼ਾਹ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "साह एक तिह ठा बसत मदन साह तिह नाउ ॥१॥",
      "sourceLineId": "126937",
      "sourceShabadId": "11964",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਦਨ ਮਤੀ ਤਾ ਕੀ ਤ੍ਰਿਯਾ ਜਾ ਕੋ ਰੂਪ ਅਪਾਰ ॥",
      "transliteration": "madhan matee taa kee tirayaa jaa ko roop apaar ||",
      "translation": "",
      "punjabiViakhya": "ਮਦਨ ਮਤੀ ਉਸ ਦੀ ਇਸਤਰੀ ਸੀ, ਜਿਸ ਦੀ ਸੁੰਦਰਤਾ ਬਹੁਤ ਅਧਿਕ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "मदन मती ता की तृया जा को रूप अपार ॥",
      "sourceLineId": "126938",
      "sourceShabadId": "11964",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਆਪੁ ਮਦਨ ਠਠਕੇ ਰਹੈ ਤਿਹ ਰਤਿ ਰੂਪ ਬਿਚਾਰ ॥੨॥",
      "transliteration": "aap madhan ThaThake rahai teh rat roop bichaar ||2||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮ ਦੇਵ ਉਸ ਨੂੰ ਰਤੀ ਦਾ ਰੂਪ ਵਿਚਾਰ ਕੇ ਹੈਰਾਨ ਹੋ ਜਾਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "आपु मदन ठठके रहै तिह रति रूप बिचार ॥२॥",
      "sourceLineId": "126939",
      "sourceShabadId": "11964",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚੇਲਾ ਰਾਮ ਤਹਾ ਹੁਤੋ ਏਕ ਸਾਹ ਕੋ ਪੂਤ ॥",
      "transliteration": "chelaa raam tahaa huto ek saeh ko poot ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਚੇਲਾ ਰਾਮ ਨਾ ਦਾ ਇਕ ਸ਼ਾਹ ਦਾ ਪੁੱਤਰ ਰਹਿੰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "चेला राम तहा हुतो एक साह को पूत ॥",
      "sourceLineId": "126940",
      "sourceShabadId": "11964",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਗਲ ਗੁਨਨ ਭੀਤਰ ਚਤੁਰ ਸੁੰਦਰ ਮਦਨ ਸਰੂਪ ॥੩॥",
      "transliteration": "sagal gunan bheetar chatur su(n)dhar madhan saroop ||3||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸਾਰਿਆਂ ਗੁਣਾ ਵਿਚ ਚਤੁਰ ਅਤੇ ਕਾਮ ਦੇਵ ਦੇ ਸਰੂਪ ਵਰਗਾ ਸੁੰਦਰ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "सगल गुनन भीतर चतुर सुँदर मदन सरूप ॥३॥",
      "sourceLineId": "126941",
      "sourceShabadId": "11964",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "126942",
      "sourceShabadId": "11965",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੇਲਾ ਰਾਮ ਜਬੈ ਤ੍ਰਿਯ ਲਹਿਯੋ ॥",
      "transliteration": "chelaa raam jabai tiray lahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਚੇਲਾ ਰਾਮ ਨੂੰ ਜਦ ਉਸ ਇਸਤਰੀ ਨੇ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "चेला राम जबै तृय लहियो ॥",
      "sourceLineId": "126943",
      "sourceShabadId": "11965",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਾ ਕੋ ਤਬੈ ਮਦਨ ਤਨ ਗਹਿਯੋ ॥",
      "transliteration": "taa ko tabai madhan tan gahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤੋਂ ਉਸ ਦੇ ਸ਼ਰੀਰ ਨੂੰ ਕਾਮ ਦੇਵ ਨੇ ਕਾਬੂ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "ता को तबै मदन तन गहियो ॥",
      "sourceLineId": "126944",
      "sourceShabadId": "11965",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਰੁਨਿ ਤਦਿਨ ਤੇ ਰਹਤ ਲੁਭਾਈ ॥",
      "transliteration": "tarun tadhin te rahat lubhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਉਸ ਦਿਨ ਤੋਂ (ਚੇਲਾ ਰਾਮ ਪ੍ਰਤਿ) ਲੁਭਾਈ ਰਹਿੰਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "तरुनि तदिन ते रहत लुभाई ॥",
      "sourceLineId": "126945",
      "sourceShabadId": "11965",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1133_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਿਰਖਿ ਸਜਨ ਛਬਿ ਰਹੀ ਬਿਕਾਈ ॥੪॥",
      "transliteration": "nirakh sajan chhab rahee bikaiee ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੱਜਨ ਦੀ ਛਬੀ ਨੂੰ ਵੇਖ ਕੇ ਵਿਕੀ ਰਹਿੰਦੀ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1133,
      "hindi": "",
      "hindiTransliteration": "निरखि सजन छबि रही बिकाई ॥४॥",
      "sourceLineId": "126946",
      "sourceShabadId": "11965",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
