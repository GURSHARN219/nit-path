{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1156,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1156_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗਹਿਰੀ ਨਦੀ ਬਿਖੈ ਲੈ ਡਾਰਿਸਿ ॥",
      "transliteration": "gahiree nadhee bikhai lai ddaaris ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਡੂੰਘੀ ਨਦੀ ਵਿਚ ਸੁਟ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "गहिरी नदी बिखै लै डारिसि ॥",
      "sourceLineId": "128075",
      "sourceShabadId": "12099",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਿਯ ਅਪਨੇ ਕਾ ਲੋਭ ਨ ਕਰਾ ॥",
      "transliteration": "jiy apane kaa lobh na karaa ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੀ ਜਾਨ ਦੀ ਪਰਵਾਹ ਨਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "जिय अपने का लोभ न करा ॥",
      "sourceLineId": "128076",
      "sourceShabadId": "12099",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਇਹ ਛਲ ਰਾਹੁ ਅਸ੍ਵ ਕਹ ਹਰਾ ॥੧੩॥",
      "transliteration": "eeh chhal raahu asavai keh haraa ||13||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਰਾਹੁ ਘੋੜਾ ਚੁਰਾ ਲਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "इह छल राहु अस्व कह हरा ॥१३॥",
      "sourceLineId": "128077",
      "sourceShabadId": "12099",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਬ ਬਾਜੀ ਹਜਰਤਿ ਕੋ ਗਯੋ ॥",
      "transliteration": "jab baajee hajarat ko gayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਬਾਦਸ਼ਾਹ ਦਾ ਘੋੜਾ ਚੋਰੀ ਹੋ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "जब बाजी हजरति को गयो ॥",
      "sourceLineId": "128078",
      "sourceShabadId": "12099",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਭਹਿਨ ਕੋ ਬਿਸਮੈ ਜਿਯ ਭਯੋ ॥",
      "transliteration": "sabhahin ko bisamai jiy bhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ) ਸਭ ਦੇ ਮਨ ਵਿਚ ਬਹੁਤ ਹੈਰਾਨੀ ਹੋਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "सभहिन को बिसमै जिय भयो ॥",
      "sourceLineId": "128079",
      "sourceShabadId": "12099",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਹਾ ਨ ਸਕਤ ਪ੍ਰਵੇਸ ਪਵਨ ਕਰਿ ॥",
      "transliteration": "jahaa na sakat praves pavan kar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਪੌਣ ਵੀ ਪ੍ਰਵੇਸ਼ ਨਹੀਂ ਕਰ ਸਕਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "जहा न सकत प्रवेस पवन करि ॥",
      "sourceLineId": "128080",
      "sourceShabadId": "12099",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਹ ਤੇ ਲਯੋ ਤੁਰੰਗਮ ਕਿਨ ਹਰਿ ॥੧੪॥",
      "transliteration": "teh te layo tura(n)gam kin har ||14||",
      "translation": "",
      "punjabiViakhya": "ਉਥੋਂ ਘੋੜਾ ਕਿਸ ਨੇ ਹਰ ਲਿਆ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "तह ते लयो तुरंगम किन हरि ॥१४॥",
      "sourceLineId": "128081",
      "sourceShabadId": "12099",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪ੍ਰਾਤ ਬਚਨ ਹਜਰਤਿ ਇਮ ਕਿਯੋ ॥",
      "transliteration": "praat bachan hajarat im kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੇਰ ਹੋਣ ਤੇ ਬਾਦਸ਼ਾਹ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਬਚਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "प्रात बचन हजरति इम कियो ॥",
      "sourceLineId": "128082",
      "sourceShabadId": "12099",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਭੈ ਦਾਨ ਚੋਰਹਿ ਮੈ ਦਿਯੋ ॥",
      "transliteration": "abhai dhaan choreh mai dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮੈਂ ਚੋਰ ਦੀ ਜਾਨ ਬਖ਼ਸ਼ੀ ਕਰ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "अभै दान चोरहि मै दियो ॥",
      "sourceLineId": "128083",
      "sourceShabadId": "12099",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜੋ ਵਹ ਮੋ ਕਹ ਬਦਨ ਦਿਖਾਵੈ ॥",
      "transliteration": "jo veh mo keh badhan dhikhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਉਹ ਮੈਨੂੰ ਮੂੰਹ ਵਿਖਾਵੇ ਤਾ (ਮੇਰੇ ਪਾਸੋਂ)",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "जो वह मो कह बदन दिखावै ॥",
      "sourceLineId": "128084",
      "sourceShabadId": "12099",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬੀਸ ਸਹਸ੍ਰ ਅਸਰਫੀ ਪਾਵੈ ॥੧੫॥",
      "transliteration": "bees sahasr asarafee paavai ||15||",
      "translation": "",
      "punjabiViakhya": "ਵੀਹ ਹਜ਼ਾਰ ਅਸ਼ਰਫ਼ੀਆਂ (ਦਾ ਇਨਾਮ) ਪ੍ਰਾਪਤ ਕਰੇ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "बीस सहस्र असरफी पावै ॥१५॥",
      "sourceLineId": "128085",
      "sourceShabadId": "12099",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਭੈ ਦਾਨ ਤਾ ਕੌ ਮੈ ਦ੍ਰਯਾਯੋ ॥",
      "transliteration": "abhai dhaan taa kau mai dhrayaayo ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਦਸ਼ਾਹ ਨੇ ਕੁਰਾਨ ਚੁਕ ਕੇ ਕਸਮ ਖਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "अभै दान ता कौ मै द्रयायो ॥",
      "sourceLineId": "128086",
      "sourceShabadId": "12099",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਖਾਈ ਸਪਤ ਕੁਰਾਨ ਉਚਾਯੋ ॥",
      "transliteration": "khaiee sapat kuraan uchaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੀ ਜਾਨ ਬਖ਼ਸ਼ੀ ਦੀ ਘੋਸ਼ਣਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "खाई सपत कुरान उचायो ॥",
      "sourceLineId": "128087",
      "sourceShabadId": "12099",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਬ ਤ੍ਰਿਯ ਭੇਸ ਪੁਰਖ ਕੋ ਧਰਾ ॥",
      "transliteration": "tab tiray bhes purakh ko dharaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਉਸ) ਇਸਤਰੀ ਨੇ ਪੁਰਸ਼ ਦਾ ਰੂਪ ਧਾਰਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "तब तृय भेस पुरख को धरा ॥",
      "sourceLineId": "128088",
      "sourceShabadId": "12099",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੇਰ ਸਾਹ ਕਹ ਸਿਜਦਾ ਕਰਾ ॥੧੬॥",
      "transliteration": "ser saeh keh sijadhaa karaa ||16||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ੇਰਸ਼ਾਹ ਨੂੰ ਪ੍ਰਨਾਮ ਕੀਤਾ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "सेर साह कह सिजदा करा ॥१६॥",
      "sourceLineId": "128089",
      "sourceShabadId": "12099",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128090",
      "sourceShabadId": "12100",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪੁਰਖ ਭੇਖ ਕਹ ਪਹਿਰ ਤ੍ਰਿਯ ਭੂਖਨ ਸਜੇ ਸੁਰੰਗ ॥",
      "transliteration": "purakh bhekh keh pahir tiray bhookhan saje sura(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਇਸਤਰੀ ਨੇ ਪੁਰਸ਼ ਦਾ ਭੇਸ ਬਣਾ ਕੇ ਅਤੇ ਸੁੰਦਰ ਗਹਿਣੇ ਸਜਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "पुरख भेख कह पहिर तृय भूखन सजे सुरंग ॥",
      "sourceLineId": "128091",
      "sourceShabadId": "12100",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੇਰ ਸਾਹ ਸੌ ਇਮਿ ਕਹਾ ਮੈ ਤਵ ਹਰਾ ਤੁਰੰਗ ॥੧੭॥",
      "transliteration": "ser saeh sau im kahaa mai tav haraa tura(n)g ||17||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੇਰਸ਼ਾਹ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ਕਿ ਮੈਂ ਤੁਹਾਡਾ ਘੋੜਾ ਚੁਰਾਇਆ ਹੈ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "सेर साह सौ इमि कहा मै तव हरा तुरंग ॥१७॥",
      "sourceLineId": "128092",
      "sourceShabadId": "12100",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128093",
      "sourceShabadId": "12101",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਬ ਹਜਰਤਿ ਤਾ ਕੌ ਲਖਿ ਲਯੋ ॥",
      "transliteration": "jab hajarat taa kau lakh layo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਬਾਦਸ਼ਾਹ ਨੇ ਉਸ ਨੂੰ ਵੇਖ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "जब हजरति ता कौ लखि लयो ॥",
      "sourceLineId": "128094",
      "sourceShabadId": "12101",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹਰਖਤ ਭਯੋ ਕੋਪ ਮਿਟਿ ਗਯੋ ॥",
      "transliteration": "harakhat bhayo kop miT gayo ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਉਹ) ਖ਼ੁਸ਼ ਹੋਇਆ ਅਤੇ ਗੁੱਸਾ ਦੂਰ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "हरखत भयो कोप मिटि गयो ॥",
      "sourceLineId": "128095",
      "sourceShabadId": "12101",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਿਰਖਿ ਪ੍ਰਭਾ ਉਪਮਾ ਬਹੁ ਕੀਨੀ ॥",
      "transliteration": "nirakh prabhaa upamaa bahu keenee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਨੂੰ ਵੇਖ ਕੇ ਬਹੁਤ ਸਿਫ਼ਤ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "निरखि प्रभा उपमा बहु कीनी ॥",
      "sourceLineId": "128096",
      "sourceShabadId": "12101",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬੀਸ ਸਹਸ੍ਰ ਅਸਰਫੀ ਦੀਨੀ ॥੧੮॥",
      "transliteration": "bees sahasr asarafee dheenee ||18||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵੀਹ ਹਜ਼ਾਰ ਅਸ਼ਰਫ਼ੀਆਂ (ਇਨਾਮ ਵਜੋਂ) ਦਿੱਤੀਆਂ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "बीस सहस्र असरफी दीनी ॥१८॥",
      "sourceLineId": "128097",
      "sourceShabadId": "12101",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128098",
      "sourceShabadId": "12102",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹਸਿ ਹਜਰਤਿ ਐਸੇ ਕਹਾ ਸੁਨੁ ਤਸਕਰ ਸੁੰਦ੍ਰੰਗ ॥",
      "transliteration": "has hajarat aaise kahaa sun tasakar su(n)dhra(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਦਸ਼ਾਹ ਨੇ ਹੱਸ ਕੇ ਕਿਹਾ, ਹੇ ਸੁੰਦਰ ਅੰਗਾ ਵਾਲੇ ਚੋਰ! ਸੁਣ,",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "हसि हजरति ऐसे कहा सुनु तसकर सुँद्रंग ॥",
      "sourceLineId": "128099",
      "sourceShabadId": "12102",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੋ ਬਿਧਿ ਕਹੋ ਬਨਾਇ ਮੁਹਿ ਕਿਹ ਬਿਧਿ ਹਰਾ ਤੁਰੰਗ ॥੧੯॥",
      "transliteration": "so bidh kaho banai muh keh bidh haraa tura(n)g ||19||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਉਹ ਢੰਗ ਦਸ ਜਿਸ ਢੰਗ ਨਾਲ ਤੂੰ ਘੋੜਾ ਚੁਰਾਇਆ ਹੈ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "सो बिधि कहो बनाइ मुहि किह बिधि हरा तुरंग ॥१९॥",
      "sourceLineId": "128100",
      "sourceShabadId": "12102",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128101",
      "sourceShabadId": "12103",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਬ ਅਬਲਾ ਆਇਸੁ ਇਮਿ ਪਾਵਾ ॥",
      "transliteration": "jab abalaa aais im paavaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਇਸਤਰੀ ਨੇ ਇਹ ਆਗਿਆ ਪ੍ਰਾਪਤ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "जब अबला आइसु इमि पावा ॥",
      "sourceLineId": "128102",
      "sourceShabadId": "12103",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮੁਹਰ ਰਾਖਿ ਮੇਖਨ ਲੈ ਆਵਾ ॥",
      "transliteration": "muhar raakh mekhan lai aavaa ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਉਹ) ਮੋਹਰਾ ਰਖ ਕੇ ਕਿਲਾ ਲੈ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "मुहर राखि मेखन लै आवा ॥",
      "sourceLineId": "128103",
      "sourceShabadId": "12103",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਰਿਤਾ ਮੋ ਤ੍ਰਿਣ ਗੂਲ ਬਹਾਇਸਿ ॥",
      "transliteration": "saritaa mo tiran gool bahais ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਨਦੀ ਵਿਚ ਕੱਖ-ਕਾਨ ਦੇ ਪੂਲੇ ਰੋੜ੍ਰਹ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "सरिता मो तृण गूल बहाइसि ॥",
      "sourceLineId": "128104",
      "sourceShabadId": "12103",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਛਪਾਲ ਤਾ ਪਰ ਡਹਕਾਇਸਿ ॥੨੦॥",
      "transliteration": "rachhapaal taa par ddahakais ||20||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਨਾਲ ਰਾਖਿਆਂ ਨੂੰ ਭੁਲੇਖਾ ਪਾਇਆ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "रछपाल ता पर डहकाइसि ॥२०॥",
      "sourceLineId": "128105",
      "sourceShabadId": "12103",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128106",
      "sourceShabadId": "12104",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਹੁਰਿ ਨਦੀ ਭੀਤਰ ਪਰੀ ਜਾਤ ਭਈ ਤਰਿ ਪਾਰਿ ॥",
      "transliteration": "bahur nadhee bheetar paree jaat bhiee tar paar ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਨਦੀ ਵਿਚ ਪੈ ਕੇ ਅਤੇ ਤਰ ਕੇ ਪਾਰ ਜਾ ਪਹੁੰਚੀ",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "बहुरि नदी भीतर परी जात भई तरि पारि ॥",
      "sourceLineId": "128107",
      "sourceShabadId": "12104",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਾਹਿ ਝਰੋਖਾ ਕੇ ਤਰੇ ਲਾਗਤ ਭਈ ਸੁਧਾਰਿ ॥੨੧॥",
      "transliteration": "saeh jharokhaa ke tare laagat bhiee sudhaar ||21||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਾਦਸ਼ਾਹ ਦੇ ਝਰੋਖੇ ਹੇਠਾ ਜਾ ਲਗੀ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "साहि झरोखा के तरे लागत भई सुधारि ॥२१॥",
      "sourceLineId": "128108",
      "sourceShabadId": "12104",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128109",
      "sourceShabadId": "12105",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਬ ਘਰਿਯਾਰੀ ਘਰੀ ਬਜਾਵੈ ॥",
      "transliteration": "jab ghariyaaree gharee bajaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਘੜਿਆਲੀ ਘੜੀ ਵਜਾਉਾਂਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "जब घरियारी घरी बजावै ॥",
      "sourceLineId": "128110",
      "sourceShabadId": "12105",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਬ ਵਹ ਮੇਖਿਕ ਤਹਾ ਲਗਾਵੈ ॥",
      "transliteration": "tab veh mekhik tahaa lagaavai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਉਥੇ ਇਕ ਕਿਲ ਲਗਾ ਦਿੰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "तब वह मेखिक तहा लगावै ॥",
      "sourceLineId": "128111",
      "sourceShabadId": "12105",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬੀਤਾ ਦਿਵਸ ਰਜਨਿ ਬਡਿ ਗਈ ॥",
      "transliteration": "beetaa dhivas rajan badd giee ||",
      "translation": "",
      "punjabiViakhya": "ਦਿਨ ਗੁਜ਼ਰ ਗਿਆ ਅਤੇ ਰਾਤ ਵੱਧ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "बीता दिवस रजनि बडि गई ॥",
      "sourceLineId": "128112",
      "sourceShabadId": "12105",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਬ ਤ੍ਰਿਯ ਤਹਾ ਪਹੂਚਤ ਭਈ ॥੨੨॥",
      "transliteration": "tab tiray tahaa pahoochat bhiee ||22||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਸਤਰੀ ਉਥੇ ਜਾ ਪਹੁੰਚੀ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "तब तृय तहा पहूचत भई ॥२२॥",
      "sourceLineId": "128113",
      "sourceShabadId": "12105",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "128114",
      "sourceShabadId": "12106",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤੈਸਹਿ ਛੋਰਿ ਤੁਰੰਗ ਝਰੋਖਾ ਬੀਚ ਕਰਿ ॥",
      "transliteration": "taiseh chhor tura(n)g jharokhaa beech kar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਤਰ੍ਰਹਾ ਘੋੜੇ ਨੂੰ ਖੋਲ੍ਰਹ ਕੇ ਅਤੇ ਝਰੋਖੇ ਵਿਚੋਂ ਕਢ ਕੇ ਕੁਦਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "तैसहि छोरि तुरंग झरोखा बीच करि ॥",
      "sourceLineId": "128115",
      "sourceShabadId": "12106",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਲ ਮੋ ਪਰੀ ਕੁਦਾਇ ਜਾਤ ਭੀ ਪਾਰ ਤਰਿ ॥",
      "transliteration": "jal mo paree kudhai jaat bhee paar tar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਲ ਵਿਚ ਆ ਪਈ ਅਤੇ ਤਰ ਕੇ ਪਾਰ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "जल मो परी कुदाइ जात भी पार तरि ॥",
      "sourceLineId": "128116",
      "sourceShabadId": "12106",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਭ ਲੋਕਨ ਕੌ ਕੌਤਕ ਅਧਿਕ ਦਿਖਾਇ ਕੈ ॥",
      "transliteration": "sabh lokan kau kauatak adhik dhikhai kai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਲੋਕਾ ਨੂੰ ਬਹੁਤ (ਵਧੀਆ) ਕੌਤਕ ਵਿਖਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "सभ लोकन कौ कौतक अधिक दिखाइ कै ॥",
      "sourceLineId": "128117",
      "sourceShabadId": "12106",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹੋ ਸੇਰ ਸਾਹ ਸੌ ਬਚਨ ਕਹੇ ਮੁਸਕਾਇ ਕੈ ॥੨੩॥",
      "transliteration": "ho ser saeh sau bachan kahe musakai kai ||23||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੱਸ ਕੇ ਸ਼ੇਰ ਸ਼ਾਹ ਨੂੰ ਕਿਹਾ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "हो सेर साह सौ बचन कहे मुसकाइ कै ॥२३॥",
      "sourceLineId": "128118",
      "sourceShabadId": "12106",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਹੀ ਭਾਤਿ ਸੋ ਪ੍ਰਥਮ ਬਾਜ ਮੁਰਿ ਕਰ ਪਰਿਯੋ ॥",
      "transliteration": "eihee bhaat so pratham baaj mur kar pariyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸੇ ਤਰ੍ਰਹਾ ਪਹਿਲਾ ਘੋੜਾ ਮੇਰੇ ਹੱਥ ਲਗਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "इही भाति सो प्रथम बाज मुरि कर परियो ॥",
      "sourceLineId": "128119",
      "sourceShabadId": "12106",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੁਤਿਯ ਅਸ੍ਵ ਤਵ ਨਿਰਖਿਤ ਇਹ ਛਲ ਸੌ ਹਰਿਯੋ ॥",
      "transliteration": "dhutiy asavai tav nirakhit ieh chhal sau hariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੂਜਾ ਘੋੜਾ ਤੁਹਾਡੇ ਵੇਖਦਿਆਂ ਇਸ ਛਲ ਨਾਲ ਚੁਰਾ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "दुतिय अस्व तव निरखित इह छल सौ हरियो ॥",
      "sourceLineId": "128120",
      "sourceShabadId": "12106",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੇਰ ਸਾਹਿ ਤਬ ਕਹਿਯੋ ਕਹਾ ਬੁਧਿ ਕੋ ਭਯੋ ॥",
      "transliteration": "ser saeh tab kahiyo kahaa budh ko bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੇਰ ਸ਼ਾਹ ਨੇ ਕਿਹਾ ਕਿ (ਮੇਰੀ) ਬੁੱਧੀ ਨੂੰ ਕੀ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "सेर साहि तब कहियो कहा बुधि को भयो ॥",
      "sourceLineId": "128121",
      "sourceShabadId": "12106",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1156_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਹੋ ਰਾਹਾ ਥੋ ਜਹਾ ਤਹੀ ਸੁਰਾਹਾ ਹੂੰ ਗਯੋ ॥੨੪॥",
      "transliteration": "ho raahaa tho jahaa tahee suraahaa hoo(n) gayo ||24||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜਿਥੇ ਰਾਹੁ ਸੀ, ਉਥੇ ਹੀ ਸੁਰਾਹੁ ਵੀ ਚਲਾ ਗਿਆ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": "हो राहा थो जहा तही सुराहा हूँ गयो ॥२४॥",
      "sourceLineId": "128122",
      "sourceShabadId": "12106",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
