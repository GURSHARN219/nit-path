{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1157,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1157_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਾਹ ਸਹਿਤ ਸਭ ਲੋਗ ਚਰਿਤ੍ਰ ਬਿਲੋਕਿ ਬਰ ॥",
      "transliteration": "saeh sahit sabh log charitr bilok bar ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਦਸ਼ਾਹ ਸਮੇਤ ਸਾਰੇ ਲੋਕ ਇਹ ਚਰਿਤ੍ਰ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "साह सहित सभ लोग चरित्र बिलोकि बर ॥",
      "sourceLineId": "128123",
      "sourceShabadId": "12106",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦਾਤ ਦਾਤ ਸੋ ਕਾਟਿ ਕਹੈ ਹੈ ਦਯੋ ਕਰ ॥",
      "transliteration": "dhaat dhaat so kaaT kahai hai dhayo kar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੰਦਾ ਨਾਲ ਆਪਣੇ ਹੱਥ ਕਟ ਕੇ ਕਹਿਣ ਲਗੇ ਕਿ (ਅਸੀਂ ਆਪਣੇ) ਹੱਥੀਂ ਘੋੜਾ ਦੇ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "दात दात सो काटि कहै है दयो कर ॥",
      "sourceLineId": "128124",
      "sourceShabadId": "12106",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਹੈ ਹਮਾਰੀ ਮਤਿਹਿ ਕਵਨ ਕਾਰਨ ਭਯੋ ॥",
      "transliteration": "kahai hamaaree mateh kavan kaaran bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਹਿਣ ਲਗੇ ਕਿ ਸਾਡੀ ਬੁੱਧੀ ਨੂੰ ਕੀ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "कहै हमारी मतिहि कवन कारन भयो ॥",
      "sourceLineId": "128125",
      "sourceShabadId": "12106",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹੋ ਰਾਹਾ ਤਸਕਰ ਹਰਿਯੋ ਸੁਰਾਹਾ ਹਮ ਦਯੋ ॥੨੫॥",
      "transliteration": "ho raahaa tasakar hariyo suraahaa ham dhayo ||25||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਰਾਹੁ ਤਾ ਚੋਰ ਨੇ ਹਰਿਆ ਸੀ, ਪਰ ਸੁਰਾਹੁ ਅਸੀਂ (ਖ਼ੁਦ) ਦੇ ਦਿੱਤਾ ਹੈ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "हो राहा तसकर हरियो सुराहा हम दयो ॥२५॥",
      "sourceLineId": "128126",
      "sourceShabadId": "12106",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128127",
      "sourceShabadId": "12107",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸ੍ਵਰਨ ਮੰਜਰੀ ਬਾਜ ਹਰਿ ਮਿਤ੍ਰਹਿ ਦਏ ਬਨਾਇ ॥",
      "transliteration": "savairan ma(n)jaree baaj har mitreh dhe banai ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਵਰਨ ਮੰਜਰੀ ਨੇ ਘੋੜੇ ਚੁਰਾ ਕੇ ਮਿਤਰ ਨੂੰ ਦੇ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "स्वरन मंजरी बाज हरि मित्रहि दए बनाइ ॥",
      "sourceLineId": "128128",
      "sourceShabadId": "12107",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚਿਤ੍ਰ ਬਰਨ ਸੁਤ ਨ੍ਰਿਪ ਬਰਾ ਹ੍ਰਿਦੈ ਹਰਖ ਉਪਜਾਇ ॥੨੬॥",
      "transliteration": "chitr baran sut nirap baraa hiradhai harakh upajai ||26||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਿਤ੍ਰ ਬਰਨ (ਨਾ ਦੇ) ਰਾਜੇ ਦੇ ਪੁੱਤਰ ਨੂੰ ਖ਼ੁਸ਼ੀ ਪੂਰਵਕ ਵਰ ਲਿਆ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "चित्र बरन सुत नृप बरा हृदै हरख उपजाइ ॥२६॥",
      "sourceLineId": "128129",
      "sourceShabadId": "12107",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਾ ਕੋ ਭਜੈ ਹ੍ਰਿਦੈ ਹਰਖ ਉਪਜਾਇ ॥",
      "transliteration": "bhaat bhaat taa ko bhajai hiradhai harakh upajai ||",
      "translation": "",
      "punjabiViakhya": "ਹਿਰਦੇ ਵਿਚ ਆਨੰਦ ਵਧਾ ਕੇ ਉਸ ਨਾਲ ਤਰ੍ਰਹਾ ਤਰ੍ਰਹਾ ਦਾ ਰਮਣ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "भाति भाति ता को भजै हृदै हरख उपजाइ ॥",
      "sourceLineId": "128130",
      "sourceShabadId": "12107",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੇਰ ਸਾਹਿ ਦਿਲੀਸ ਕਹ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰ ਦਿਖਾਇ ॥੨੭॥",
      "transliteration": "ser saeh dhilees keh tirayaa charitr dhikhai ||27||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਇਹ ਚਰਿਤ੍ਰ ਦਿੱਲੀ ਦੇ ਬਾਦਸ਼ਾਹ ਸ਼ੇਰਸ਼ਾਹ ਨੂੰ ਵਿਖਾਇਆ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "सेर साहि दिलीस कह तृया चरित्र दिखाइ ॥२७॥",
      "sourceLineId": "128131",
      "sourceShabadId": "12107",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਛਯਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੪੬॥੪੬੩੬॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau chhayaalees charitr samaapatam sat subham sat ||246||4636||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੪੬ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੪੬॥੪੬੩੬॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ छयालीस चरित्र समापतम सतु सुभम सतु ॥२४६॥४६३६॥अफजूँ॥",
      "sourceLineId": "128132",
      "sourceShabadId": "12107",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128133",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬੀਰ ਤਿਲਕ ਇਕ ਨ੍ਰਿਪਤਿ ਬਿਚਛਨ ॥",
      "transliteration": "beer tilak ik nirapat bichachhan ||",
      "translation": "",
      "punjabiViakhya": "ਬੀਰ ਤਿਲਕ ਨਾ ਦਾ ਇਕ ਬੁੱਧੀਮਾਨ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "बीर तिलक इक नृपति बिचछन ॥",
      "sourceLineId": "128134",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪੁਹਪ ਮੰਜਰੀ ਨਾਰਿ ਸੁਲਛਨ ॥",
      "transliteration": "puhap ma(n)jaree naar sulachhan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਪੁਹਪ ਮੰਜਰੀ ਨਾ ਦੀ ਸੁਲੱਛਣੀ ਨਾਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "पुहप मंजरी नारि सुलछन ॥",
      "sourceLineId": "128135",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਿਨ ਕੀ ਹਮ ਤੇ ਕਹਿ ਨ ਪਰਤ ਛਬਿ ॥",
      "transliteration": "tin kee ham te keh na parat chhab ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਦਾ ਵਰਣਨ ਮੇਰੇ ਪਾਸੋਂ ਕੀਤਾ ਨਹੀਂ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "तिन की हम ते कहि न परत छबि ॥",
      "sourceLineId": "128136",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਤਿ ਤਿਹ ਰਹਤ ਨਿਰਖਿ ਰਤਿ ਪਤਿ ਦਬਿ ॥੧॥",
      "transliteration": "rat teh rahat nirakh rat pat dhab ||1||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮ ਦੇਵ ਉਸ ਨੂੰ ਦਬਕ ਕੇ ਰਤਿ ਰੂਪ ਵਿਚ ਵੇਖਦਾ ਰਹਿੰਦਾ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "रति तिह रहत निरखि रति पति दबि ॥१॥",
      "sourceLineId": "128137",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸ੍ਰੀ ਸੁਰਤਾਨ ਸਿੰਘ ਤਿਹ ਪੂਤਾ ॥",
      "transliteration": "sree surataan si(n)gh teh pootaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਰਤਾਨ ਸਿੰਘ ਉਨ੍ਰਹਾ ਦਾ ਪੁੱਤਰ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "स्री सुरतान सिंघ तिह पूता ॥",
      "sourceLineId": "128138",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਨੁ ਬਿਧਿ ਗੜਾ ਦੁਤਿਯ ਪੁਰਹੂਤਾ ॥",
      "transliteration": "jan bidh gaRaa dhutiy purahootaa ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ) ਮਾਨੋ ਵਿਧਾਤਾ ਨੇ ਦੂਜਾ ਇੰਦਰ ਬਣਾਇਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "जनु बिधि गड़ा दुतिय पुरहूता ॥",
      "sourceLineId": "128139",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਬ ਵਹੁ ਤਰੁਨ ਭਯੋ ਲਖਿ ਪਾਯੋ ॥",
      "transliteration": "jab vahu tarun bhayo lakh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਪਿਤਾ ਨੇ) ਉਸ ਨੂੰ ਜਵਾਨ ਹੁੰਦਾ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "जब वहु तरुन भयो लखि पायो ॥",
      "sourceLineId": "128140",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਬ ਪਿਤ ਤਾ ਕੋ ਬ੍ਯਾਹ ਰਖਾਯੋ ॥੨॥",
      "transliteration": "tab pit taa ko bayaeh rakhaayo ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਪਿਤਾ ਨੇ ਉਸ ਦਾ ਵਿਆਹ ਰਚਾ ਦਿੱਤਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "तब पित ता को ब्याह रखायो ॥२॥",
      "sourceLineId": "128141",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਾਸਮੀਰ ਇਕ ਨ੍ਰਿਪਤਿ ਰਹਤ ਬਲ ॥",
      "transliteration": "kaasameer ik nirapat rahat bal ||",
      "translation": "",
      "punjabiViakhya": "ਕਸ਼ਮੀਰ ਵਿਚ ਇਕ ਬਲਵਾਨ ਰਾਜਾ ਰਹਿੰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "कासमीर इक नृपति रहत बल ॥",
      "sourceLineId": "128142",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰੂਪਮਾਨ ਧਨਮਾਨ ਰਣਾਚਲ ॥",
      "transliteration": "roopamaan dhanamaan ranaachal ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਰੂਪਮਾਨ ਅਤੇ ਧਨ ਵਾਲਾ ਸੀ ਤੇ ਯੁੱਧ ਵਿਚ (ਸਦਾ) ਅਚਲ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "रूपमान धनमान रणाचल ॥",
      "sourceLineId": "128143",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਾ ਕੇ ਧਾਮ ਸੁਤਾ ਇਕ ਸੁਨੀ ॥",
      "transliteration": "taa ke dhaam sutaa ik sunee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਇਕ ਪੁੱਤਰੀ ਸੁਣੀਂਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "ता के धाम सुता इक सुनी ॥",
      "sourceLineId": "128144",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਕਲ ਗੁਨਨ ਕੇ ਭੀਤਰ ਗੁਨੀ ॥੩॥",
      "transliteration": "sakal gunan ke bheetar gunee ||3||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸਾਰਿਆਂ ਗੁਣਾ ਨਾਲ ਭਰਪੂਰ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "सकल गुनन के भीतर गुनी ॥३॥",
      "sourceLineId": "128145",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬੋਲਿ ਦਿਜੰਬਰਨ ਘਰੀ ਸੁਧਾਈ ॥",
      "transliteration": "bol dhija(n)baran gharee sudhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੇਸ਼ਠ ਬ੍ਰਾਹਮਣਾ ਨੂੰ ਬੁਲਾ ਕੇ (ਉਸ ਦੇ ਵਿਆਹ ਦੀ) ਘੜੀ ਨਿਸਚਿਤ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "बोलि दिजंबरन घरी सुधाई ॥",
      "sourceLineId": "128146",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨ੍ਰਿਪ ਸੁਤ ਕੇ ਸੰਗ ਕਰੀ ਸਗਾਈ ॥",
      "transliteration": "nirap sut ke sa(n)g karee sagaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ (ਬੀਰ ਤਿਲਕ) ਦੇ ਪੁੱਤਰ ਨਾਲ ਉਸ ਦੀ ਮੰਗਣੀ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "नृप सुत के संग करी सगाई ॥",
      "sourceLineId": "128147",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਧਿਕ ਸੁ ਦਰਬੁ ਪਠੈ ਦਿਯ ਤਾ ਕੌ ॥",
      "transliteration": "adhik su dharab paThai dhiy taa kau ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਲ ਬਹੁਤ ਸਾਰਾ ਧਨ ਭੇਜ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "अधिक सु दरबु पठै दिय ता कौ ॥",
      "sourceLineId": "128148",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬ੍ਯਾਹ ਬਿਚਾਰਿ ਬੁਲਾਯੋ ਵਾ ਕੌ ॥੪॥",
      "transliteration": "bayaeh bichaar bulaayo vaa kau ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਵਿਆਹ (ਦਾ ਸਮਾ) ਵਿਚਾਰ ਕੇ ਸਦ ਭੇਜਿਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "ब्याह बिचारि बुलायो वा कौ ॥४॥",
      "sourceLineId": "128149",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੁਤਾ ਕੋ ਬ੍ਯਾਹ ਜਬੈ ਤਿਨ ਦਿਯਾਇਸਿ ॥",
      "transliteration": "sutaa ko bayaeh jabai tin dhiyais ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਿਨ ਉਸ ਨੇ ਪੁੱਤਰੀ ਦਾ ਵਿਆਹ ਕਰਨਾ ਮਿਥਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "सुता को ब्याह जबै तिन दियाइसि ॥",
      "sourceLineId": "128150",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਾਟ ਪਾਟ ਬਸਤ੍ਰਨ ਸਭ ਛਾਇਸਿ ॥",
      "transliteration": "haaT paaT basatran sabh chhais ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸਭ ਗਲੀਆਂ ਅਤੇ ਬਾਜ਼ਾਰ ਬਸਤ੍ਰਾ ਨਾਲ ਸਜਾ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "हाट पाट बसत्रन सभ छाइसि ॥",
      "sourceLineId": "128151",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਘਰ ਘਰ ਗੀਤ ਚੰਚਲਾ ਗਾਵਤ ॥",
      "transliteration": "ghar ghar geet cha(n)chalaa gaavat ||",
      "translation": "",
      "punjabiViakhya": "ਘਰ ਘਰ ਵਿਚ ਇਸਤਰੀਆਂ ਗੀਤ ਗਾਣ ਲਗੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "घर घर गीत चंचला गावत ॥",
      "sourceLineId": "128152",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਬਾਦ੍ਰਿਤ ਬਜਾਵਤ ॥੫॥",
      "transliteration": "bhaat bhaat baadhirat bajaavat ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦੇ ਵਾਜੇ ਵਜਾਣ ਲਗੀਆਂ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "भाति भाति बादृत बजावत ॥५॥",
      "sourceLineId": "128153",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਕਲ ਬ੍ਯਾਹ ਕੀ ਰੀਤਿ ਕਰਹਿ ਤੇ ॥",
      "transliteration": "sakal bayaeh kee reet kareh te ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਵਿਆਹ ਦੀਆਂ ਸਾਰੀਆਂ ਰੀਤਾ ਕੀਤੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "सकल ब्याह की रीति करहि ते ॥",
      "sourceLineId": "128154",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਧਿਕ ਦਿਜਨ ਕਹ ਦਾਨ ਕਰਹਿ ਵੇ ॥",
      "transliteration": "adhik dhijan keh dhaan kareh ve ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬ੍ਰਾਹਮਣਾ ਨੂੰ ਬਹੁਤ ਦਾਨ ਆਦਿ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "अधिक दिजन कह दान करहि वे ॥",
      "sourceLineId": "128155",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਾਚਕ ਸਭੈ ਭੂਪ ਹ੍ਵੈ ਗਏ ॥",
      "transliteration": "jaachak sabhai bhoop havai ge ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਭਿਖਾਰੀ ਰਾਜੇ ਬਣ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "जाचक सभै भूप ह्वै गए ॥",
      "sourceLineId": "128156",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਾਚਤ ਬਹੁਰਿ ਨ ਕਾਹੂ ਭਏ ॥੬॥",
      "transliteration": "jaachat bahur na kaahoo bhe ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਕਿਤੇ ਮੰਗਣ ਨਹੀਂ ਗਏ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "जाचत बहुरि न काहू भए ॥६॥",
      "sourceLineId": "128157",
      "sourceShabadId": "12108",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128158",
      "sourceShabadId": "12109",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਕਲ ਰੀਤਿ ਕਰਿ ਬ੍ਯਾਹ ਕੀ ਚੜੇ ਜਨੇਤ ਬਨਾਇ ॥",
      "transliteration": "sakal reet kar bayaeh kee chaRe janet banai ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਆਹ ਦੀਆਂ ਸਾਰੀਆਂ ਰੀਤਾ ਕਰ ਕੇ (ਲੜਕੇ ਵਾਲੇ) ਬਰਾਤ ਬਣਾ ਕੇ ਚੜ੍ਰਹ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "सकल रीति करि ब्याह की चड़े जनेत बनाइ ॥",
      "sourceLineId": "128159",
      "sourceShabadId": "12109",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਸੋ ਕੁਅਰ ਬਨਿ ਪ੍ਰਭਾ ਨ ਬਰਨੀ ਜਾਇ ॥੭॥",
      "transliteration": "bhaat bhaat so kuar ban prabhaa na baranee jai ||7||",
      "translation": "",
      "punjabiViakhya": "ਕੁੰਵਰ ਨੇ ਭਾਤ ਭਾਤ ਦੇ (ਸਾਜ ਸ਼ਿੰਗਾਰ) ਬਣਾਏ, (ਜਿਸ ਦੀ) ਸੁੰਦਰਤਾ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "भाति भाति सो कुअर बनि प्रभा न बरनी जाइ ॥७॥",
      "sourceLineId": "128160",
      "sourceShabadId": "12109",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128161",
      "sourceShabadId": "12110",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਾਸਮੀਰ ਭੀਤਰ ਪਹੁਚੇ ਜਬ ॥",
      "transliteration": "kaasameer bheetar pahuche jab ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਕਸ਼ਮੀਰ ਵਿਚ ਪਹੁੰਚੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "कासमीर भीतर पहुचे जब ॥",
      "sourceLineId": "128162",
      "sourceShabadId": "12110",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਾਜਨ ਲਗੇ ਬਦਿਤ੍ਰ ਅਮਿਤ ਤਬ ॥",
      "transliteration": "baajan lage badhitr amit tab ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਬੇਸ਼ੁਮਾਰ ਵਾਜੇ ਵਜਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "बाजन लगे बदित्र अमित तब ॥",
      "sourceLineId": "128163",
      "sourceShabadId": "12110",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਾਚਤ ਪਾਤ੍ਰ ਅਪਾਰ ਅਨੂਪਾ ॥",
      "transliteration": "naachat paatr apaar anoopaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਪਾਰ ਅਤੇ ਅਨੂਪਮ (ਸੁੰਦਰਤਾ ਵਾਲੀਆਂ) ਵੇਸਵਾਵਾ ਨਚ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "नाचत पात्र अपार अनूपा ॥",
      "sourceLineId": "128164",
      "sourceShabadId": "12110",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕੰਚਨਿ ਹੁਰਕੁਨਿ ਰੂਪ ਸਰੂਪਾ ॥੮॥",
      "transliteration": "ka(n)chan hurakun roop saroopaa ||8||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ) ਸਰੂਪ ਸੋਨੇ ਅਤੇ ਅੱਗ ਦੀ ਲਾਟ ('ਹੁਰਕੁਨਿ') ਵਰਗੇ ਸਨ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "कंचनि हुरकुनि रूप सरूपा ॥८॥",
      "sourceLineId": "128165",
      "sourceShabadId": "12110",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਾਟ ਪਾਟ ਸਭ ਬਸਤ੍ਰਨ ਛਾਏ ॥",
      "transliteration": "haaT paaT sabh basatran chhaae ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਗਲੀਆਂ ਅਤੇ ਬਾਜ਼ਾਰ ਬਸਤ੍ਰਾ ਨਾਲ ਸਜਾਏ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "हाट पाट सभ बसत्रन छाए ॥",
      "sourceLineId": "128166",
      "sourceShabadId": "12110",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਗਰ ਚੰਦਨ ਭੇ ਮਗੁ ਛਿਰਕਾਏ ॥",
      "transliteration": "agar cha(n)dhan bhe mag chhirakaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਗਰ ਤੇ ਚੰਦਨ ਦਾ ਰਸਤੇ ਵਿਚ ਛਿੜਕਾਓ ਕਰਵਾਇਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "अगर चंदन भे मगु छिरकाए ॥",
      "sourceLineId": "128167",
      "sourceShabadId": "12110",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਭ ਘਰ ਬਾਧੀ ਬੰਧਨਵਾਰੈ ॥",
      "transliteration": "sabh ghar baadhee ba(n)dhanavaarai ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਘਰਾ ਦੇ (ਦੁਆਰ ਤੇ) ਬੰਧਨਵਾਰ ਬੰਨ੍ਰਹੇ ਹੋਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "सभ घर बाधी बंधनवारै ॥",
      "sourceLineId": "128168",
      "sourceShabadId": "12110",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗਾਵਤ ਗੀਤ ਸੁਹਾਵਤ ਨਾਰੈ ॥੯॥",
      "transliteration": "gaavat geet suhaavat naarai ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੁੰਦਰ ਇਸਤਰੀਆਂ ਗੀਤ ਗਾਉਾਂਦੀਆਂ ਸ਼ੋਭਦੀਆਂ ਸਨ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "गावत गीत सुहावत नारै ॥९॥",
      "sourceLineId": "128169",
      "sourceShabadId": "12110",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਗੂਆ ਲੇਨ ਅਗਾਊ ਆਏ ॥",
      "transliteration": "agooaa len agaauoo aae ||",
      "translation": "",
      "punjabiViakhya": "ਅਗਵਾਨੀ ਕਰਨ ਵਾਲੇ ਅਗੋਂ ਲੈਣ ਆਏ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "अगूआ लेन अगाऊ आए ॥",
      "sourceLineId": "128170",
      "sourceShabadId": "12110",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਆਦਰ ਸੌ ਕੁਅਰਹਿ ਗ੍ਰਿਹ ਲ੍ਯਾਏ ॥",
      "transliteration": "aadhar sau kuareh gireh layaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਦਰ ਨਾਲ ਕੁੰਵਰ ਨੂੰ ਘਰ ਲੈ ਕੇ ਆਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "आदर सौ कुअरहि गृह ल्याए ॥",
      "sourceLineId": "128171",
      "sourceShabadId": "12110",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤੇ ਕਰੈ ਬਡਾਈ ॥",
      "transliteration": "bhaat bhaat te karai baddaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਭਾਤ ਭਾਤ ਨਾਲ ਵਡਿਆਈ ਕੀਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "भाति भाति ते करै बडाई ॥",
      "sourceLineId": "128172",
      "sourceShabadId": "12110",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜਾਨੁਕ ਰਾਕਨਿ ਧਨਿ ਨਿਧਿ ਪਾਈ ॥੧੦॥",
      "transliteration": "jaanuk raakan dhan nidh paiee ||10||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ (ਕਿਸੇ) ਕੰਗਾਲ ਨੇ ਧਨ ਦਾ ਖ਼ਜ਼ਾਨਾ ਪ੍ਰਾਪਤ ਕਰ ਲਿਆ ਹੋਵੇ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "जानुक राकनि धनि निधि पाई ॥१०॥",
      "sourceLineId": "128173",
      "sourceShabadId": "12110",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "128174",
      "sourceShabadId": "12111",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਤਬ ਜਸ ਤਿਲਕ ਮੰਜਰੀ ਲਈ ਬੁਲਾਇ ਕੈ ॥",
      "transliteration": "tab jas tilak ma(n)jaree liee bulai kai ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਜਸ ਤਿਲਕ ਮੰਜਰੀ ਨੂੰ ਬੁਲਾਇਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "तब जस तिलक मंजरी लई बुलाइ कै ॥",
      "sourceLineId": "128175",
      "sourceShabadId": "12111",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਬ੍ਯਾਹ ਦਈ ਨ੍ਰਿਪ ਸੁਤ ਕੇ ਸਾਥ ਬਨਾਇ ਕੈ ॥",
      "transliteration": "bayaeh dhiee nirap sut ke saath banai kai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੰਗੀ ਰੀਤ ਨਾਲ (ਉਸ ਨੂੰ) ਰਾਜੇ ਦੇ ਪੁੱਤਰ ਨਾਲ ਵਿਆਹ ਦਿੱਤਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "ब्याह दई नृप सुत के साथ बनाइ कै ॥",
      "sourceLineId": "128176",
      "sourceShabadId": "12111",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਦਾਜ ਅਮਿਤ ਧਨ ਦੀਯੋ ਬਿਦਾ ਕਰਿ ਕੈ ਦਏ ॥",
      "transliteration": "dhaaj amit dhan dheeyo bidhaa kar kai dhe ||",
      "translation": "",
      "punjabiViakhya": "ਦਾਜ ਅਤੇ ਬੇਹਿਸਾਬ ਧਨ ਦੇ ਕੇ (ਉਨ੍ਰਹਾ ਨੂੰ) ਵਿਦਾ ਕਰ ਦਿੱਤਾ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "दाज अमित धन दीयो बिदा करि कै दए ॥",
      "sourceLineId": "128177",
      "sourceShabadId": "12111",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਹੋ ਬਿਰਜਵਤੀ ਨਗਰੀ ਪ੍ਰਤਿ ਤੇ ਆਵਤ ਭਏ ॥੧੧॥",
      "transliteration": "ho birajavatee nagaree prat te aavat bhe ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਹ ਬਿਰਜਵਤੀ ਨਗਰੀ ਵਲ ਆ ਗਏ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "हो बिरजवती नगरी प्रति ते आवत भए ॥११॥",
      "sourceLineId": "128178",
      "sourceShabadId": "12111",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128179",
      "sourceShabadId": "12112",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਏਕ ਸਾਹ ਕੇ ਸਦਨ ਉਤਾਰੇ ॥",
      "transliteration": "ek saeh ke sadhan utaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੂੰ) ਇਕ ਸ਼ਾਹ ਦੇ ਘਰ ਉਤਾਰਿਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "एक साह के सदन उतारे ॥",
      "sourceLineId": "128180",
      "sourceShabadId": "12112",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਗ੍ਰਿਹ ਜੈ ਹੈ ਲਖਿ ਹੈ ਜਬ ਤਾਰੇ ॥",
      "transliteration": "gireh jai hai lakh hai jab taare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜਦ ਸ਼ੁਭ ਤਾਰਾ ਦਿਖੇਗਾ ਤਦ (ਉਹ) ਘਰ ਨੂੰ ਜਾ ਸਕਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "गृह जै है लखि है जब तारे ॥",
      "sourceLineId": "128181",
      "sourceShabadId": "12112",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਕੁਅਰਿ ਸਾਹ ਕੋ ਪੂਤ ਨਿਹਾਰਾ ॥",
      "transliteration": "kuar saeh ko poot nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਮਾਰੀ ਨੇ (ਜਦ) ਸ਼ਾਹ ਦਾ ਪੁੱਤਰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "कुअरि साह को पूत निहारा ॥",
      "sourceLineId": "128182",
      "sourceShabadId": "12112",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਤਿਹ ਤਨ ਤਾਨਿ ਮਦਨ ਸਰ ਮਾਰਾ ॥੧੨॥",
      "transliteration": "teh tan taan madhan sar maaraa ||12||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਦੇ ਸ਼ਰੀਰ ਵਿਚ ਕਾਮ ਦੇਵ ਨੇ ਖਿਚ ਕੇ ਬਾਣ ਮਾਰਿਆ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "तिह तन तानि मदन सर मारा ॥१२॥",
      "sourceLineId": "128183",
      "sourceShabadId": "12112",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128184",
      "sourceShabadId": "12113",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਨਿਰਖਿਤ ਰਹੀ ਲੁਭਾਇ ਛਬਿ ਮਨ ਮੈ ਕਿਯਾ ਬਿਚਾਰ ॥",
      "transliteration": "nirakhit rahee lubhai chhab man mai kiyaa bichaar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਸ਼ਾਹ ਦੇ ਪੁੱਤਰ ਦੀ) ਛਬੀ ਨੂੰ ਵੇਖ ਕੇ ਮੋਹਿਤ ਹੋ ਗਈ ਅਤੇ ਮਨ ਵਿਚ ਵਿਚਾਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "निरखित रही लुभाइ छबि मन मै किया बिचार ॥",
      "sourceLineId": "128185",
      "sourceShabadId": "12113",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਨ੍ਰਿਪ ਸੁਤ ਸੰਗ ਨ ਜਾਇ ਹੌ ਇਹੈ ਹਮਾਰੋ ਯਾਰ ॥੧੩॥",
      "transliteration": "nirap sut sa(n)g na jai hau ihai hamaaro yaar ||13||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਹੁਣ ਰਾਜੇ ਦੇ ਪੁੱਤਰ ਨਾਲ ਨਹੀਂ ਜਾਵਾਗੀ ਅਤੇ ਇਹੀ (ਸ਼ਾਹ ਦਾ ਪੁੱਤਰ) ਮੇਰਾ ਯਾਰ ਹੋਵੇਗਾ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "नृप सुत संग न जाइ हौ इहै हमारो यार ॥१३॥",
      "sourceLineId": "128186",
      "sourceShabadId": "12113",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128187",
      "sourceShabadId": "12114",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਬੋਲਿ ਲਿਯਾ ਤਾ ਕੋ ਅਪੁਨੇ ਘਰ ॥",
      "transliteration": "bol liyaa taa ko apune ghar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਆਪਣੇ ਨਿਵਾਸ ਵਿਚ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "बोलि लिया ता को अपुने घर ॥",
      "sourceLineId": "128188",
      "sourceShabadId": "12114",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਰਤਿ ਮਾਨੀ ਤਾ ਸੌ ਹਸਿ ਹਸਿ ਕਰਿ ॥",
      "transliteration": "rat maanee taa sau has has kar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਹੱਸ ਹੱਸ ਕੇ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "रति मानी ता सौ हसि हसि करि ॥",
      "sourceLineId": "128189",
      "sourceShabadId": "12114",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਆਲਿੰਗਨ ਚੁੰਬਨ ਬਹੁ ਲਏ ॥",
      "transliteration": "aali(n)gan chu(n)ban bahu le ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਸਾਰੇ ਆਲਿੰਗਨ ਅਤੇ ਚੁੰਬਨ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "आलिंगन चुँबन बहु लए ॥",
      "sourceLineId": "128190",
      "sourceShabadId": "12114",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਬਿਬਿਧ ਬਿਧਨ ਸੌ ਆਸਨ ਦਏ ॥੧੪॥",
      "transliteration": "bibidh bidhan sau aasan dhe ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਤਰ੍ਰਹਾ ਦੇ ਆਸਣ ਦਿੱਤੇ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "बिबिध बिधन सौ आसन दए ॥१४॥",
      "sourceLineId": "128191",
      "sourceShabadId": "12114",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "128192",
      "sourceShabadId": "12115",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਬਿਹਸਿ ਬਿਹਸਿ ਦੋਊ ਕੁਅਰ ਕਲੋਲਨ ਕੌ ਕਰੈ ॥",
      "transliteration": "bihas bihas dhouoo kuar kalolan kau karai ||",
      "translation": "",
      "punjabiViakhya": "ਹੱਸ ਹੱਸ ਕੇ ਦੋਵੇਾਂ ਮਿਤਰ ਖ਼ੂਬ ਕਾਮ-ਕਲੋਲਾ ਕਰਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": "बिहसि बिहसि दोऊ कुअर कलोलन कौ करै ॥",
      "sourceLineId": "128193",
      "sourceShabadId": "12115",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1157_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਬਿਬਿਧ ਬਿਧਨ ਕੋਕਨ ਕੇ ਮਤ ਕੌ ਉਚਰੈ ॥",
      "transliteration": "bibidh bidhan kokan ke mat kau ucharai ||",
      "translation": "",
