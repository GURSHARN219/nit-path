{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1159,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1159_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128243",
      "sourceShabadId": "12124",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਾਹ ਸੁਤਾ ਅਤਿ ਪਤਿਬ੍ਰਤਾ ਅਧਿਕ ਚਤੁਰ ਮਤਿਵਾਨ ॥",
      "transliteration": "saeh sutaa at patibrataa adhik chatur mativaan ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਬਹੁਤ ਪਤਿਬ੍ਰਤਾ, ਚਤੁਰ ਅਤੇ ਬੁੱਧੀਮਾਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "साह सुता अति पतिब्रता अधिक चतुर मतिवान ॥",
      "sourceLineId": "128244",
      "sourceShabadId": "12124",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚਾਰਹੁ ਪਠਿਯੋ ਸੰਦੇਸ ਲਿਖਿ ਚਿਤ ਚਰਿਤ੍ਰ ਇਕ ਆਨ ॥੭॥",
      "transliteration": "chaarahu paThiyo sa(n)dhes likh chit charitr ik aan ||7||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਮਨ ਵਿਚ ਇਕ ਚਰਿਤ੍ਰ ਵਿਚਾਰ ਕੇ ਚੌਹਾ ਨੂੰ ਸੰਦੇਸ਼ ਲਿਖ ਕੇ ਭੇਜ ਦਿੱਤਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "चारहु पठियो संदेस लिखि चित चरित्र इक आन ॥७॥",
      "sourceLineId": "128245",
      "sourceShabadId": "12124",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128246",
      "sourceShabadId": "12125",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜੁਦੋ ਜੁਦੋ ਲਿਖਿ ਚਹੂੰਨ ਪਠਾਯੋ ॥",
      "transliteration": "judho judho likh chahoo(n)n paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ ਨੂੰ ਵੱਖਰਾ ਵੱਖਰਾ ਲਿਖ ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "जुदो जुदो लिखि चहूँन पठायो ॥",
      "sourceLineId": "128247",
      "sourceShabadId": "12125",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਿਸ ਕੋ ਭੇਦ ਨ ਕਿਸੂ ਜਤਾਯੋ ॥",
      "transliteration": "kis ko bhedh na kisoo jataayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਸੇ ਦਾ ਭੇਦ ਕਿਸੇ ਹੋਰ ਨੂੰ ਨਾ ਦਸਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "किस को भेद न किसू जतायो ॥",
      "sourceLineId": "128248",
      "sourceShabadId": "12125",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਖੀ ਭਏ ਇਹ ਭਾਤਿ ਸਿਖਾਇਸਿ ॥",
      "transliteration": "sakhee bhe ieh bhaat sikhais ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸਖੀ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਸਿਖਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "सखी भए इह भाति सिखाइसि ॥",
      "sourceLineId": "128249",
      "sourceShabadId": "12125",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਾਜ ਕੁਮਾਰਨ ਬੋਲਿ ਪਠਾਇਸਿ ॥੮॥",
      "transliteration": "raaj kumaaran bol paThais ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ ਕੁਮਾਰਾ ਨੂੰ ਬੁਲਵਾ ਲਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "राज कुमारन बोलि पठाइसि ॥८॥",
      "sourceLineId": "128250",
      "sourceShabadId": "12125",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਾਹੁ ਸੁਤਾ ਬਾਚ ਸਖੀ ਸੋ ॥",
      "transliteration": "saahu sutaa baach sakhee so ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਨੇ ਸਖੀ ਨੂੰ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "साहु सुता बाच सखी सो ॥",
      "sourceLineId": "128251",
      "sourceShabadId": "12126",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128252",
      "sourceShabadId": "12126",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਮਿ ਜਿਮਿ ਨ੍ਰਿਪ ਸੁਤ ਆਇ ਹੈ ਉਤਮ ਭੇਖ ਸੁ ਧਾਰਿ ॥",
      "transliteration": "jim jim nirap sut aai hai utam bhekh su dhaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਜਿਵੇਾਂ ਰਾਜੇ ਦੇ ਪੁੱਤਰ ਉਤਮ ਢੰਗ ਨਾਲ ਸਜ-ਸੰਵਰ ਕੇ ਆਣਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "जिमि जिमि नृप सुत आइ है उतम भेख सु धारि ॥",
      "sourceLineId": "128253",
      "sourceShabadId": "12126",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਿਮਿ ਤਿਮਿ ਪਗਨ ਖਰਾਕ ਤੈ ਕਿਜਿਯੋ ਮੇਰੇ ਦ੍ਵਾਰ ॥੯॥",
      "transliteration": "tim tim pagan kharaak tai kijiyo mere dhavaiaar ||9||",
      "translation": "",
      "punjabiViakhya": "ਤਿਵੇਾਂ ਤਿਵੇਾਂ ਮੇਰੇ ਦੁਆਰ ਤੇ ਪੈਰ ਨਾਲ ਖੜਾਕ ਕਰ ਦੇਣਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "तिमि तिमि पगन खराक तै किजियो मेरे द्वार ॥९॥",
      "sourceLineId": "128254",
      "sourceShabadId": "12126",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪ੍ਰਥਮ ਪੁਤ੍ਰ ਜਬ ਨ੍ਰਿਪਤਿ ਕੋ ਆਯੋ ਭੇਖ ਸੁ ਧਾਰਿ ॥",
      "transliteration": "pratham putr jab nirapat ko aayo bhekh su dhaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਰਾਜੇ ਦਾ ਪਹਿਲਾ ਪੁੱਤਰ ਸਜ-ਧਜ ਕੇ ਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "प्रथम पुत्र जब नृपति को आयो भेख सु धारि ॥",
      "sourceLineId": "128255",
      "sourceShabadId": "12126",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪਾਇਨ ਕੋ ਖਟਕੋ ਕਿਯੋ ਆਨਿ ਸਖੀ ਤਿਹ ਦ੍ਵਾਰ ॥੧੦॥",
      "transliteration": "pain ko khaTako kiyo aan sakhee teh dhavaiaar ||10||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸਖੀ ਨੇ ਆ ਕੇ ਉਸ ਦੇ ਦੁਆਰ ਉਤੇ ਪੈਰ ਦਾ ਖੜਾਕ ਕੀਤਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "पाइन को खटको कियो आनि सखी तिह द्वार ॥१०॥",
      "sourceLineId": "128256",
      "sourceShabadId": "12126",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128257",
      "sourceShabadId": "12127",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹਾ ਹਾ ਪਦ ਤਬ ਤਰੁਨਿ ਉਚਾਰੋ ॥",
      "transliteration": "haa haa padh tab tarun uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕੁਮਾਰੀ ਨੇ 'ਹਾਇ ਹਾਇ' ਸ਼ਬਦ ਉਚਾਰਨਾ ਸ਼ੁਰੂ ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "हा हा पद तब तरुनि उचारो ॥",
      "sourceLineId": "128258",
      "sourceShabadId": "12127",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਾਥਨ ਕੌ ਛਤਿਯਾ ਪਰ ਮਾਰੋ ॥",
      "transliteration": "haathan kau chhatiyaa par maaro ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੱਥਾ ਨੂੰ ਛਾਤੀ ਉਤੇ ਮਾਰਨ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "हाथन कौ छतिया पर मारो ॥",
      "sourceLineId": "128259",
      "sourceShabadId": "12127",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕੋਊ ਆਹਿ ਦ੍ਵਾਰ ਮੁਹਿ ਠਾਢਾ ॥",
      "transliteration": "kouoo aaeh dhavaiaar muh Thaaddaa ||",
      "translation": "",
      "punjabiViakhya": "ਕੋਈ ਮੇਰੇ ਦੁਆਰ ਉਤੇ ਆ ਖੜੋਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "कोऊ आहि द्वार मुहि ठाढा ॥",
      "sourceLineId": "128260",
      "sourceShabadId": "12127",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਾ ਤੇ ਅਧਿਕ ਤ੍ਰਾਸ ਮੁਹਿ ਬਾਢਾ ॥੧੧॥",
      "transliteration": "taa te adhik traas muh baaddaa ||11||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਮੈਨੂੰ ਬਹੁਤ ਡਰ ਲਗ ਰਿਹਾ ਹੈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "ता ते अधिक त्रास मुहि बाढा ॥११॥",
      "sourceLineId": "128261",
      "sourceShabadId": "12127",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨ੍ਰਿਪ ਸੁਤ ਕਹਿਯੋ ਜਤਨ ਇਕ ਕਰੋ ॥",
      "transliteration": "nirap sut kahiyo jatan ik karo ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਰਾਜੇ ਦੇ ਪੁੱਤਰ ਨੂੰ ਕਿਹਾ ਕਿ ਇਕ ਯਤਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "नृप सुत कहियो जतन इक करो ॥",
      "sourceLineId": "128262",
      "sourceShabadId": "12127",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚਾਰਿ ਸੰਦੂਕ ਹੈਂ ਇਕ ਮੈ ਪਰੋ ॥",
      "transliteration": "chaar sa(n)dhook hai(n) ik mai paro ||",
      "translation": "",
      "punjabiViakhya": "ਚਾਰ ਸੰਦੂਕਾ ਵਿਚੋਂ ਇਕ ਵਿਚ ਵੜ ਜਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "चारि संदूक हैं इक मै परो ॥",
      "sourceLineId": "128263",
      "sourceShabadId": "12127",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਏਕ ਸੰਦੂਕ ਮਾਝ ਰਹਿਯੋ ਦੁਰਿ ॥",
      "transliteration": "ek sa(n)dhook maajh rahiyo dhur ||",
      "translation": "",
      "punjabiViakhya": "(ਤੂੰ) ਇਕ ਸੰਦੂਕ ਵਿਚ ਲੁਕਿਆ ਰਹਿ।",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "एक संदूक माझ रहियो दुरि ॥",
      "sourceLineId": "128264",
      "sourceShabadId": "12127",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜੈ ਹੈ ਲੋਕ ਬਿਲੋਕ ਬਿਮੁਖ ਘਰ ॥੧੨॥",
      "transliteration": "jai hai lok bilok bimukh ghar ||12||",
      "translation": "",
      "punjabiViakhya": "ਲੋਕੀਂ ਵੇਖ ਕੇ ਨਿਰਾਸ ਹੋ ਕੇ ਘਰ ਨੂੰ ਪਰਤ ਜਾਣਗੇ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "जै है लोक बिलोक बिमुख घर ॥१२॥",
      "sourceLineId": "128265",
      "sourceShabadId": "12127",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਇਮਿ ਸੰਦੂਕ ਭੀਤਰ ਤਿਹ ਡਾਰੋ ॥",
      "transliteration": "eim sa(n)dhook bheetar teh ddaaro ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਉਸ ਨੂੰ ਸੰਦੂਕ ਵਿਚ ਪਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "इमि संदूक भीतर तिह डारो ॥",
      "sourceLineId": "128266",
      "sourceShabadId": "12127",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦੁਤਿਯ ਨ੍ਰਿਪਤਿ ਕੋ ਪੁਤ੍ਰ ਹਕਾਰੋ ॥",
      "transliteration": "dhutiy nirapat ko putr hakaaro ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਦੇ ਦੂਜੇ ਪੁੱਤਰ ਨੂੰ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "दुतिय नृपति को पुत्र हकारो ॥",
      "sourceLineId": "128267",
      "sourceShabadId": "12127",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਗ ਖਟਕੋ ਸਹਚਰਿ ਤਬ ਕੀਨੋ ॥",
      "transliteration": "pag khaTako sahachar tab keeno ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ ਉਹ ਘਰ ਆ ਗਿਆ) ਤਦ ਸਖੀ ਨੇ ਪੈਰ ਦਾ ਖੜਾਕ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "पग खटको सहचरि तब कीनो ॥",
      "sourceLineId": "128268",
      "sourceShabadId": "12127",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੁਤਿਯ ਸੰਦੂਕ ਡਾਰਿ ਤਿਹ ਦੀਨੋ ॥੧੩॥",
      "transliteration": "dhutiy sa(n)dhook ddaar teh dheeno ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਦੂਜੇ ਸੰਦੂਕ ਵਿਚ ਬੰਦ ਕਰ ਦਿੱਤਾ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "दुतिय संदूक डारि तिह दीनो ॥१३॥",
      "sourceLineId": "128269",
      "sourceShabadId": "12127",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128270",
      "sourceShabadId": "12128",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਇਹ ਛਲ ਨ੍ਰਿਪ ਕੇ ਚਾਰਿ ਸੁਤ ਚਹੂੰ ਸੰਦੂਕਨ ਡਾਰਿ ॥",
      "transliteration": "eeh chhal nirap ke chaar sut chahoo(n) sa(n)dhookan ddaar ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਰਾਜੇ ਦੇ ਚਾਰੇ ਪੁੱਤਰ ਚੌਹਾ ਸੰਦੂਕਾ ਵਿਚ ਪਾ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "इह छल नृप के चारि सुत चहूँ संदूकन डारि ॥",
      "sourceLineId": "128271",
      "sourceShabadId": "12128",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਿਨ ਪਿਤੁ ਗ੍ਰਿਹ ਪਯਾਨੋ ਕਿਯੋ ਉਤਿਮ ਭੇਖ ਸੁ ਧਾਰਿ ॥੧੪॥",
      "transliteration": "tin pit gireh payaano kiyo utim bhekh su dhaar ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਤਮ ਭੇਸ ਬਣਾ ਕੇ ਉਨ੍ਰਹਾ ਦੇ ਪਿਓ (ਰਾਜੇ) ਦੇ ਘਰ ਵਲ ਤੁਰ ਪਈ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "तिन पितु गृह पयानो कियो उतिम भेख सु धारि ॥१४॥",
      "sourceLineId": "128272",
      "sourceShabadId": "12128",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128273",
      "sourceShabadId": "12129",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚਾਰਿ ਸੰਦੂਕ ਸੰਗ ਲੀਨੇ ਕਰ ॥",
      "transliteration": "chaar sa(n)dhook sa(n)g leene kar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਚਾਰੇ ਸੰਦੂਕ ਨਾਲ ਲੈ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "चारि संदूक संग लीने कर ॥",
      "sourceLineId": "128274",
      "sourceShabadId": "12129",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪਹੁਚਤ ਭਈ ਨ੍ਰਿਪਤਿ ਕੈ ਦਰ ਪਰ ॥",
      "transliteration": "pahuchat bhiee nirapat kai dhar par ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਦੇ ਦੁਆਰ ਉਤੇ ਜਾ ਪਹੁੰਚੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "पहुचत भई नृपति कै दर पर ॥",
      "sourceLineId": "128275",
      "sourceShabadId": "12129",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਬ ਰਾਜਾ ਕੋ ਰੂਪ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "jab raajaa ko roop nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਦਾ ਰੂਪ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "जब राजा को रूप निहारियो ॥",
      "sourceLineId": "128276",
      "sourceShabadId": "12129",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਾ ਪਰ ਵਾਰ ਨਦੀ ਤਿਨ ਡਾਰਿਯੋ ॥੧੫॥",
      "transliteration": "taa par vaar nadhee tin ddaariyo ||15||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ) ਉਸ ਉਪਰੋਂ ਚਾਰੇ ਸੰਦੂਕ ਵਾਰ ਕੇ ਨਦੀ ਵਿਚ ਸੁਟ ਦਿੱਤੇ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "ता पर वार नदी तिन डारियो ॥१५॥",
      "sourceLineId": "128277",
      "sourceShabadId": "12129",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128278",
      "sourceShabadId": "12130",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਵਾਰਿ ਸੰਦੂਕ ਨ੍ਰਿਪਾਲ ਪਰ ਦਏ ਨਦੀ ਮੈ ਡਾਰਿ ॥",
      "transliteration": "vaar sa(n)dhook nirapaal par dhe nadhee mai ddaar ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਉਤੋਂ ਸੰਦੂਕ ਵਾਰ ਕੇ ਨਦੀ ਵਿਚ ਸੁਟ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "वारि संदूक नृपाल पर दए नदी मै डारि ॥",
      "sourceLineId": "128279",
      "sourceShabadId": "12130",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਭ ਛਤ੍ਰਿਨ ਛਿਨ ਮੋ ਛਲਾ ਕੋਊ ਨ ਸਕਾ ਬਿਚਾਰ ॥੧੬॥",
      "transliteration": "sabh chhatiran chhin mo chhalaa kouoo na sakaa bichaar ||16||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਛਤ੍ਰੀਆਂ ਨੂੰ ਛਿਣ ਭਰ ਵਿਚ ਛਲ ਲਿਆ ਅਤੇ ਕੋਈ ਵੀ (ਇਸ ਛਲ ਨੂੰ) ਨਾ ਵਿਚਾਰ ਸਕਿਆ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "सभ छतृन छिन मो छला कोऊ न सका बिचार ॥१६॥",
      "sourceLineId": "128280",
      "sourceShabadId": "12130",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128281",
      "sourceShabadId": "12131",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਧੰਨ੍ਯ ਧੰਨ੍ਯ ਸਭ ਲੋਕ ਬਖਾਨੈ ॥",
      "transliteration": "dha(n)nay dha(n)nay sabh lok bakhaanai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਲੋਕ ਧੰਨ ਧੰਨ ਕਹਿਣ ਲਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "धंन्य धंन्य सभ लोक बखानै ॥",
      "sourceLineId": "128282",
      "sourceShabadId": "12131",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਮੂਰਖ ਜਾਨੈ ॥",
      "transliteration": "bhedh abhedh na moorakh jaanai ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਮੂਰਖਾ ਨੇ ਭੇਦ ਅਭੇਦ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न मूरख जानै ॥",
      "sourceLineId": "128283",
      "sourceShabadId": "12131",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭੂਪ ਭਗਤਿ ਤਿਹ ਅਧਿਕ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "bhoop bhagat teh adhik bichaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਉਸ ਨੂੰ ਆਪਣਾ ਪਰਮ ਭਗਤ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "भूप भगति तिह अधिक बिचारियो ॥",
      "sourceLineId": "128284",
      "sourceShabadId": "12131",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨ੍ਰਿਪ ਪਰ ਦਰਬੁ ਇਤੋ ਜਿਨ ਵਾਰਿਯੋ ॥੧੭॥",
      "transliteration": "nirap par dharab ito jin vaariyo ||17||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ) ਉਸ ਨੇ ਰਾਜੇ ਉਤੋਂ ਇੰਨਾ ਧਨ ਵਾਰ ਦਿੱਤਾ ਸੀ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "नृप पर दरबु इतो जिन वारियो ॥१७॥",
      "sourceLineId": "128285",
      "sourceShabadId": "12131",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਬ ਰਾਜੇ ਇਹ ਭਾਤਿ ਉਚਾਰਿਯੋ ॥",
      "transliteration": "tab raaje ieh bhaat uchaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜੇ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "तब राजे इह भाति उचारियो ॥",
      "sourceLineId": "128286",
      "sourceShabadId": "12131",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਾਹ ਸੁਤਾ ਜੇਤੋ ਧਨ ਵਾਰਿਯੋ ॥",
      "transliteration": "saeh sutaa jeto dhan vaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਨੇ ਜਿਤਨਾ ਧਨ ਵਾਰਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "साह सुता जेतो धन वारियो ॥",
      "sourceLineId": "128287",
      "sourceShabadId": "12131",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਛੋਰਿ ਭੰਡਾਰ ਤਿਤੋ ਤਿਹ ਦੀਜੈ ॥",
      "transliteration": "chhor bha(n)ddaar tito teh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਖ਼ਜ਼ਾਨਾ ਖੋਲ੍ਰਹ ਕੇ ਉਤਨਾ ਧਨ ਉਸ ਨੂੰ ਦੇ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "छोरि भंडार तितो तिह दीजै ॥",
      "sourceLineId": "128288",
      "sourceShabadId": "12131",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮੰਤ੍ਰਨ ਕਹਾ ਬਿਲੰਬ ਨ ਕੀਜੈ ॥੧੮॥",
      "transliteration": "ma(n)tran kahaa bila(n)b na keejai ||18||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਮੰਤ੍ਰੀਆਂ ਨੂੰ ਕਿਹਾ ਕਿ ਦੇਰ ਨਾ ਕਰੋ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "मंत्रन कहा बिलंब न कीजै ॥१८॥",
      "sourceLineId": "128289",
      "sourceShabadId": "12131",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1159_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚਾਰਿ ਸੰਦੂਕ ਅਸਰਫੀ ਦੀਨੀ ॥",
      "transliteration": "chaar sa(n)dhook asarafee dheenee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਚਾਰ ਸੰਦੂਕ ਅਸ਼ਰਫ਼ੀਆਂ ਦੇ (ਭਰ ਕੇ) ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": "चारि संदूक असरफी दीनी ॥",
      "sourceLineId": "128290",
      "sourceShabadId": "12131",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
