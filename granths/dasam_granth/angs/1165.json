{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1165,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1165_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਛੁ ਭੋਜਨ ਖੈਬੇ ਕਹ ਦੀਨਾ ॥",
      "transliteration": "kachh bhojan khaibe keh dheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਖਾਣ ਲਈ ਕੁਝ ਭੋਜਨ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "कछु भोजन खैबे कह दीना ॥",
      "sourceLineId": "128555",
      "sourceShabadId": "12163",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਬ ਸੋ ਕਰੋ ਤੁਮ ਜੁ ਮੁਹਿ ਉਚਾਰੋ ॥",
      "transliteration": "ab so karo tum ju muh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਜੋ ਤੁਸੀਂ ਮੈਨੂੰ ਕਹੋ, ਉਹੀ ਕਰਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "अब सो करो तुम जु मुहि उचारो ॥",
      "sourceLineId": "128556",
      "sourceShabadId": "12163",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਿਯਤ ਤਜੋ ਕੈ ਜਿਯ ਤੇ ਮਾਰੋ ॥੧੫॥",
      "transliteration": "jiyat tajo kai jiy te maaro ||15||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਜੀਉਾਂਦਾ ਛਡ ਦਿਆਂ ਜਾ ਜਾਨੋ ਮਾਰ ਦਿਆਂ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "जियत तजो कै जिय ते मारो ॥१५॥",
      "sourceLineId": "128557",
      "sourceShabadId": "12163",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੋ ਚਲਿ ਗ੍ਰਿਹ ਦੁਸਮਨ ਹੂ ਆਵੈ ॥",
      "transliteration": "jo chal gireh dhusaman hoo aavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਘਰ ਵਿਚ ਦੁਸ਼ਮਣ ਵੀ ਚਲ ਕੇ ਆ ਜਾਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "जो चलि गृह दुसमन हू आवै ॥",
      "sourceLineId": "128558",
      "sourceShabadId": "12163",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜੋ ਤਾ ਕੋ ਗ੍ਰਹਿ ਕੈ ਨ੍ਰਿਪ ਘਾਵੈ ॥",
      "transliteration": "jo taa ko greh kai nirap ghaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜੋ ਰਾਜਾ ਉਸ ਨੂੰ ਪਕੜ ਕੇ ਮਾਰ ਦੇਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "जो ता को ग्रहि कै नृप घावै ॥",
      "sourceLineId": "128559",
      "sourceShabadId": "12163",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਰਕ ਬਿਖੈ ਤਾ ਕੌ ਜਮ ਡਾਰੈ ॥",
      "transliteration": "narak bikhai taa kau jam ddaarai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਯਮਰਾਜ ਨਰਕਾ ਵਿਚ ਸੁਟੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "नरक बिखै ता कौ जम डारै ॥",
      "sourceLineId": "128560",
      "sourceShabadId": "12163",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭਲਾ ਨ ਤਾ ਕਹ ਜਗਤ ਉਚਾਰੈ ॥੧੬॥",
      "transliteration": "bhalaa na taa keh jagat uchaarai ||16||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਗਤ ਵੀ ਉਸ ਨੂੰ ਚੰਗਾ ਨਹੀਂ ਕਹੇਗਾ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "भला न ता कह जगत उचारै ॥१६॥",
      "sourceLineId": "128561",
      "sourceShabadId": "12163",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128562",
      "sourceShabadId": "12164",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੋ ਆਵੈ ਨਿਜੁ ਧਾਮ ਚਲਿ ਧਰਮ ਭ੍ਰਾਤ ਤਿਹ ਜਾਨਿ ॥",
      "transliteration": "jo aavai nij dhaam chal dharam bhraat teh jaan ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਅਪਣੇ ਘਰ ਵਿਚ ਚਲ ਕੇ ਆ ਜਾਵੇ, ਉਸ ਨੂੰ ਧਰਮ ਦਾ ਭਰਾ ਸਮਝਣਾ ਚਾਹੀਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "जो आवै निजु धाम चलि धरम भ्रात तिह जानि ॥",
      "sourceLineId": "128563",
      "sourceShabadId": "12164",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜੋ ਕਛੁ ਕਹੈ ਸੁ ਕੀਜਿਯੈ ਭੂਲਿ ਨ ਕਰਿਯੈ ਹਾਨਿ ॥੧੭॥",
      "transliteration": "jo kachh kahai su keejiyai bhool na kariyai haan ||17||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਜੋ ਕੁਝ ਕਹੇ, ਉਹੀ ਕਰਨਾ ਚਾਹੀਦਾ ਹੈ ਅਤੇ ਭੁਲ ਕੇ ਵੀ ਉਸ ਨੂੰ ਨੁਕਸਾਨ ਨਹੀਂ ਪਹੁੰਚਾਣਾ ਚਾਹੀਦਾ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "जो कछु कहै सु कीजियै भूलि न करियै हानि ॥१७॥",
      "sourceLineId": "128564",
      "sourceShabadId": "12164",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128565",
      "sourceShabadId": "12165",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਬ ਨ੍ਰਿਪ ਤਾ ਕੌ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "transliteration": "tab nirap taa kau bol paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜੇ ਨੇ ਉਸ ਨੂੰ ਬੁਲਵਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "तब नृप ता कौ बोलि पठायो ॥",
      "sourceLineId": "128566",
      "sourceShabadId": "12165",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਿਕਟਿ ਆਪਨੇ ਤਿਹ ਬੈਠਾਯੋ ॥",
      "transliteration": "nikaT aapane teh baiThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਆਪਣੇ ਕੋਲ ਬਿਠਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "निकटि आपने तिह बैठायो ॥",
      "sourceLineId": "128567",
      "sourceShabadId": "12165",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੁਹਿਤਾ ਵਹੈ ਤਵਨ ਕਹ ਦੀਨੀ ॥",
      "transliteration": "dhuhitaa vahai tavan keh dheenee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਉਹੀ ਪੁੱਤਰੀ ਦੇ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "दुहिता वहै तवन कह दीनी ॥",
      "sourceLineId": "128568",
      "sourceShabadId": "12165",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਾ ਸੌ ਰਤਿ ਆਗੇ ਜਿਨ ਕੀਨੀ ॥੧੮॥",
      "transliteration": "jaa sau rat aage jin keenee ||18||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਅਗੇ ਹੀ ਉਸ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ ਹੋਈ ਸੀ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "जा सौ रति आगे जिन कीनी ॥१८॥",
      "sourceLineId": "128569",
      "sourceShabadId": "12165",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128570",
      "sourceShabadId": "12166",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਲੈ ਦੁਹਿਤਾ ਤਾ ਕੌ ਦਈ ਚਿਤ ਮੌ ਭਯੋ ਅਸੋਗ ॥",
      "transliteration": "lai dhuhitaa taa kau dhiee chit mau bhayo asog ||",
      "translation": "",
      "punjabiViakhya": "ਪੁੱਤਰੀ ਨੂੰ ਪਕੜ ਕੇ ਉਸ ਨੂੰ ਸੌਂਪ ਦਿੱਤੀ ਅਤੇ ਮਨ ਵਿਚ ਪ੍ਰਸੰਨ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "लै दुहिता ता कौ दई चित मौ भयो असोग ॥",
      "sourceLineId": "128571",
      "sourceShabadId": "12166",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦੁਹਿਤਾ ਕੋ ਕਛੁ ਨ ਲਹਾ ਗੂੜ ਅਗੂੜ ਪ੍ਰਯੋਗ ॥੧੯॥",
      "transliteration": "dhuhitaa ko kachh na lahaa gooR agooR prayog ||19||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਪੁੱਤਰੀ ਦੇ ਗੂੜ੍ਰਹ ਅਗੂੜ੍ਰਹ ਚਰਿਤ੍ਰ ਨੂੰ ਕੁਝ ਵੀ ਸਮਝ ਨਾ ਸਕਿਆ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "दुहिता को कछु न लहा गूड़ अगूड़ प्रयोग ॥१९॥",
      "sourceLineId": "128572",
      "sourceShabadId": "12166",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128573",
      "sourceShabadId": "12167",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਨ ਭਾਵਤ ਪਾਵਤ ਪਤਿ ਭਈ ॥",
      "transliteration": "man bhaavat paavat pat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਮਨ ਚਾਹਿਆ ਪਤੀ ਪ੍ਰਾਪਤ ਕਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "मन भावत पावत पति भई ॥",
      "sourceLineId": "128574",
      "sourceShabadId": "12167",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਹ ਛਲ ਸੋ ਪਿਤੁ ਕਹ ਛਲਿ ਗਈ ॥",
      "transliteration": "eeh chhal so pit keh chhal giee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਛਲ ਨਾਲ ਪਿਤਾ ਨੂੰ ਛਲ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "इह छल सो पितु कह छलि गई ॥",
      "sourceLineId": "128575",
      "sourceShabadId": "12167",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਕਿਨਹੂੰ ਨਹਿ ਪਾਯੋ ॥",
      "transliteration": "bhedh abhedh kinahoo(n) neh paayo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਭੇਦ ਅਭੇਦ ਕੁਝ ਵੀ ਨਾ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद किनहूँ नहि पायो ॥",
      "sourceLineId": "128576",
      "sourceShabadId": "12167",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਲੈ ਨਾਗਰ ਤ੍ਰਿਯ ਧਾਮ ਸਿਧਾਯੋ ॥੨੦॥",
      "transliteration": "lai naagar tiray dhaam sidhaayo ||20||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਾਗਰ ਇਸਤਰੀ ਲੈ ਕੇ (ਆਪਣੇ) ਘਰ ਚਲਿਆ ਗਿਆ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "लै नागर तृय धाम सिधायो ॥२०॥",
      "sourceLineId": "128577",
      "sourceShabadId": "12167",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਬਾਵਨੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੫੨॥੪੭੪੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau baavano charitr samaapatam sat subham sat ||252||4742||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੫੨ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੫੨॥੪੭੪੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ बावनो चरित्र समापतम सतु सुभम सतु ॥२५२॥४७४२॥अफजूँ॥",
      "sourceLineId": "128578",
      "sourceShabadId": "12167",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128579",
      "sourceShabadId": "12168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਛਤ੍ਰਾਨੀ ਇਸਤਰੀ ਇਕ ਰਹੈ ॥",
      "transliteration": "chhatraanee isataree ik rahai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਛਤ੍ਰਾਣੀ ਇਸਤਰੀ ਰਹਿੰਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "छत्रानी इसतरी इक रहै ॥",
      "sourceLineId": "128580",
      "sourceShabadId": "12168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੀਯੋ ਨਾਮ ਤਾਹਿ ਜਗ ਕਹੈ ॥",
      "transliteration": "jeeyo naam taeh jag kahai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਲੋਕੀ ਜੀਯੋ (ਮਤੀ) ਕਹਿੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "जीयो नाम ताहि जग कहै ॥",
      "sourceLineId": "128581",
      "sourceShabadId": "12168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਾਨਿਕ ਚੰਦ ਤਵਨ ਕਹ ਬਰਾ ॥",
      "transliteration": "maanik cha(n)dh tavan keh baraa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨਿਕ ਚੰਦ ਨੇ ਉਸ ਨੂੰ ਵਿਆਹਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "मानिक चंद तवन कह बरा ॥",
      "sourceLineId": "128582",
      "sourceShabadId": "12168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਭੋਗਨ ਭਰਾ ॥੧॥",
      "transliteration": "bhaat bhaat ke bhogan bharaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦੇ ਭੋਗ ਕਰ ਕੇ (ਆਨੰਦ) ਮਾਣਿਆ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के भोगन भरा ॥१॥",
      "sourceLineId": "128583",
      "sourceShabadId": "12168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਵਹ ਜੜ ਏਕ ਜਾਟਨੀ ਸੌ ਰਤਿ ॥",
      "transliteration": "veh jaR ek jaaTanee sau rat ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮੂਰਖ ਇਕ ਜਾਟਣੀ ਨਾਲ ਫਸਿਆ ਹੋਇਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "वह जड़ एक जाटनी सौ रति ॥",
      "sourceLineId": "128584",
      "sourceShabadId": "12168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਛੂ ਨ ਜਾਨਤ ਮੂੜ ਮਹਾ ਮਤਿ ॥",
      "transliteration": "kachhoo na jaanat mooR mahaa mat ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਹ ਮਹਾ ਮੂਰਖ ਕੁਝ ਵੀ ਨਹੀਂ ਜਾਣਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "कछू न जानत मूड़ महा मति ॥",
      "sourceLineId": "128585",
      "sourceShabadId": "12168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਲੰਬੋਦਰੁ ਪਸੁ ਕੋ ਅਵਤਾਰਾ ॥",
      "transliteration": "la(n)bodhar pas ko avataaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਲੰਬੋਦਰ ਪਸ਼ੂ (ਲੰਮਕੇ ਹੋਏ ਢਿਡ ਵਾਲਾ ਪਸ਼ੂ, ਭਾਵ ਖੋਤਾ) ਦਾ ਅਵਤਾਰ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "लंबोदरु पसु को अवतारा ॥",
      "sourceLineId": "128586",
      "sourceShabadId": "12168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗਰਧਭ ਜੋਨਿ ਡਰਾ ਕਰਤਾਰਾ ॥੨॥",
      "transliteration": "garadhabh jon ddaraa karataaraa ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਰਮਾਤਮਾ ਨੇ ਉਸ ਨੂੰ ਖੋਤੇ ਦੀ ਜੂਨ ਵਿਚ ਪਾਇਆ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "गरधभ जोनि डरा करतारा ॥२॥",
      "sourceLineId": "128587",
      "sourceShabadId": "12168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਲੋਗਨ ਤੇ ਅਤਿ ਤਵਨ ਲਜਾਵੈ ॥",
      "transliteration": "logan te at tavan lajaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਲੋਕਾ ਤੋਂ ਬਹੁਤ ਸ਼ਰਮਾਉਾਂਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "लोगन ते अति तवन लजावै ॥",
      "sourceLineId": "128588",
      "sourceShabadId": "12168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਾ ਤੇ ਧਾਮ ਨ ਤਾ ਕੌ ਲ੍ਯਾਵੈ ॥",
      "transliteration": "taa te dhaam na taa kau layaavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਉਸ ਨੂੰ ਘਰ ਨਹੀਂ ਲਿਆਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "ता ते धाम न ता कौ ल्यावै ॥",
      "sourceLineId": "128589",
      "sourceShabadId": "12168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਾ ਤੇ ਔਰ ਗਾਵ ਤ੍ਰਿਯ ਰਾਖੀ ॥",
      "transliteration": "taa te aauar gaav tiray raakhee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਦੂਜੇ ਪਿੰਡ ਵਿਚ (ਉਹ) ਇਸਤਰੀ ਰਖੀ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "ता ते और गाव तृय राखी ॥",
      "sourceLineId": "128590",
      "sourceShabadId": "12168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਸਿ ਸੂਰਜ ਤਾ ਕੇ ਸਭ ਸਾਖੀ ॥੩॥",
      "transliteration": "sas sooraj taa ke sabh saakhee ||3||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਜ ਅਤੇ ਚੰਦ੍ਰਮਾ ਸਭ ਇਸ ਦੇ ਸਾਖੀ ਸਨ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "ससि सूरज ता के सभ साखी ॥३॥",
      "sourceLineId": "128591",
      "sourceShabadId": "12168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਾਜ ਅਰੂੜਿ ਤਹਾ ਹ੍ਵੈ ਜਾਵੈ ॥",
      "transliteration": "baaj arooR tahaa havai jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜੇ ਉਤੇ ਚੜ੍ਰਹ ਕੇ ਉਥੇ ਜਾਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "बाज अरूड़ि तहा ह्वै जावै ॥",
      "sourceLineId": "128592",
      "sourceShabadId": "12168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਾਹੂ ਕੀ ਲਾਜੈ ਨ ਲਜਾਵੈ ॥",
      "transliteration": "kaahoo kee laajai na lajaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਸ ਦੀ ਲਾਜ ਤੋਂ ਨਹੀਂ ਲਜਾਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "काहू की लाजै न लजावै ॥",
      "sourceLineId": "128593",
      "sourceShabadId": "12168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜੀਯੋ ਜਿਯ ਭੀਤਰ ਅਤਿ ਜਰੈ ॥",
      "transliteration": "jeeyo jiy bheetar at jarai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ ਇਸਤਰੀ) ਜੀਯੋ ਹਿਰਦੇ ਵਿਚ ਬਹੁਤ ਸੜਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "जीयो जिय भीतर अति जरै ॥",
      "sourceLineId": "128594",
      "sourceShabadId": "12168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਾਢੀ ਏਕ ਸਾਥ ਰਤਿ ਕਰੈ ॥੪॥",
      "transliteration": "baaddee ek saath rat karai ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਤਰਖਾਣ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਦੀ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "बाढी एक साथ रति करै ॥४॥",
      "sourceLineId": "128595",
      "sourceShabadId": "12168",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128596",
      "sourceShabadId": "12169",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਬ ਵਹੁ ਅਸ੍ਵ ਅਰੂੜ ਹ੍ਵੈ ਗਾਵ ਤਵਨ ਮੋ ਜਾਤ ॥",
      "transliteration": "jab vahu asavai arooR havai gaav tavan mo jaat ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਉਹ ਘੋੜੇ ਤੇ ਚੜ੍ਰਹ ਕੇ ਉਸ ਦੇ ਪਿੰਡ ਜਾਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "जब वहु अस्व अरूड़ ह्वै गाव तवन मो जात ॥",
      "sourceLineId": "128597",
      "sourceShabadId": "12169",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜੀਯੋ ਮਤੀ ਤਿਹ ਬਾਢੀਅਹਿ ਅਪਨੇ ਧਾਮ ਬੁਲਾਤ ॥੫॥",
      "transliteration": "jeeyo matee teh baadde'eeh apane dhaam bulaat ||5||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਜੀਯੋ ਮਤੀ ਉਸ ਤਰਖਾਣ ਨੂੰ ਆਪਣੇ ਘਰ ਬੁਲਾ ਲੈਂਦੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "जीयो मती तिह बाढीअहि अपने धाम बुलात ॥५॥",
      "sourceLineId": "128598",
      "sourceShabadId": "12169",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128599",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਿਹ ਤ੍ਰਿਯ ਹੋਡ ਨਨਦ ਸੌ ਪਾਰੀ ॥",
      "transliteration": "teh tiray hodd nanadh sau paaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਨੇ ਨਨਾਣ ਨਾਲ ਸ਼ਰਤ ਲਗਾ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "तिह तृय होड ननद सौ पारी ॥",
      "sourceLineId": "128600",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਿਹਸਿਤ ਇਹ ਭਾਤਿਨ ਉਚਾਰੀ ॥",
      "transliteration": "bihasit ieh bhaatin uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਹਸਦਿਆਂ ਹਸਦਿਆਂ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿਣ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "बिहसित इह भातिन उचारी ॥",
      "sourceLineId": "128601",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1165_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੁ ਮੈ ਕਹਤ ਹੌ ਤੀਰ ਤਿਹਾਰੇ ॥",
      "transliteration": "s mai kahat hau teer tihaare ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਉਹ ਤੁਹਾਨੂੰ ਦਸਦਾ ਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": "सु मै कहत हौ तीर तिहारे ॥",
      "sourceLineId": "128602",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
