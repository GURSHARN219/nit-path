{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1166,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1166_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੁਨਹੁ ਸ੍ਰਵਨ ਧਰਿ ਕਥਾ ਪ੍ਯਾਰੇ ॥੬॥",
      "transliteration": "sunahu sravan dhar kathaa payaare ||6||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਿਆਰੇ (ਰਾਜਨ!) (ਉਹ) ਕਥਾ ਕੰਨ ਦੇ ਕੇ ਸੁਣੋ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "सुनहु स्रवन धरि कथा प्यारे ॥६॥",
      "sourceLineId": "128603",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪਤਿ ਦੇਖਤ ਕਹਿਯੋ ਭੋਗ ਕਮੈ ਹੌ ॥",
      "transliteration": "pat dhekhat kahiyo bhog kamai hau ||",
      "translation": "",
      "punjabiViakhya": "ਪਤੀ ਦੇ ਵੇਖਦੇ ਹੋਇਆਂ (ਕਿਸੇ ਹੋਰ ਨਾਲ) ਭੋਗ ਕੀਤਾ ਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "पति देखत कहियो भोग कमै हौ ॥",
      "sourceLineId": "128604",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬ੍ਰਹਮ ਭੋਜ ਤਾ ਤੇ ਕਰਵੈ ਹੌ ॥",
      "transliteration": "braham bhoj taa te karavai hau ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਉਸ ਤੋਂ ਬ੍ਰਹਮ ਭੋਜ ਕਰਵਾਇਆ ਜਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "ब्रहम भोज ता ते करवै हौ ॥",
      "sourceLineId": "128605",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੀਯੋ ਮਤੀ ਤਬਹੂੰ ਤੁਮ ਜਨਿਯਹੁ ॥",
      "transliteration": "jeeyo matee tabahoo(n) tum janiyahu ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਤੈਨੂੰ ਤਦ ਹੀ ਜੀਯੋ ਮਤੀ ਸਮਝਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "जीयो मती तबहूँ तुम जनियहु ॥",
      "sourceLineId": "128606",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮੋਰੀ ਸਾਚ ਕਹੀ ਤਬ ਮਨਿਯਹੁ ॥੭॥",
      "transliteration": "moree saach kahee tab maniyahu ||7||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਮੇਰੀ ਕਹੀ ਗੱਲ ਸਚ ਕਰ ਵਿਖਾਵੇਾਂਗੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "मोरी साच कही तब मनियहु ॥७॥",
      "sourceLineId": "128607",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਯੌ ਕਹਿ ਬਚਨਨ ਬਹੁਰਿ ਉਚਾਰਾ ॥",
      "transliteration": "yau keh bachanan bahur uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਗੱਲ ਕਹਿ ਕੇ ਫਿਰ ਦਸਣ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "यौ कहि बचनन बहुरि उचारा ॥",
      "sourceLineId": "128608",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪਤਿ ਗਯੋ ਜਬ ਹੀ ਅਨਤ ਨਿਹਾਰਾ ॥",
      "transliteration": "pat gayo jab hee anat nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਹੀ ਪਤੀ ਨੂੰ ਹੋਰ ਪਾਸੇ ਜਾਦਿਆਂ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "पति गयो जब ही अनत निहारा ॥",
      "sourceLineId": "128609",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਬ ਬਾਢੀ ਤਿਹ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "transliteration": "tab baaddee teh bol paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਰਖਾਣ ਨੂੰ ਬੁਲਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "तब बाढी तिह बोलि पठायो ॥",
      "sourceLineId": "128610",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਿਹ ਸੰਗ ਕਮਾਯੋ ॥੮॥",
      "transliteration": "kaam bhog teh sa(n)g kamaayo ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਕਾਮ-ਭੋਗ ਕੀਤਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "काम भोग तिह संग कमायो ॥८॥",
      "sourceLineId": "128611",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਾਟਿਨਿ ਭੋਗ ਜਬੈ ਜੜ ਆਯੋ ॥",
      "transliteration": "jaaTin bhog jabai jaR aayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਾਟਣੀ ਨਾਲ ਭੋਗ ਕਰ ਕੇ ਜਦੋਂ ਮੂਰਖ (ਪਰਤ ਕੇ) ਆਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "जाटिनि भोग जबै जड़ आयो ॥",
      "sourceLineId": "128612",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਆਨ ਰਮਤ ਲਖਿ ਤ੍ਰਿਯਹਿ ਰਿਸਾਯੋ ॥",
      "transliteration": "aan ramat lakh tirayeh risaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਸਤਰੀ ਨੂੰ ਦੂਜੇ ਨਾਲ ਰਮਣ ਕਰਦਿਆਂ ਵੇਖ ਕੇ ਬਹੁਤ ਕ੍ਰੋਧਿਤ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "आन रमत लखि तृयहि रिसायो ॥",
      "sourceLineId": "128613",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਾਢਿ ਕ੍ਰਿਪਾਨ ਮਹਾ ਪਸੁ ਧਯੋ ॥",
      "transliteration": "kaadd kirapaan mahaa pas dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਨ ਕਢ ਕੇ ਮਹਾ ਮੂਰਖ (ਉਸ ਵਲ) ਵਧਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "काढि कृपान महा पसु धयो ॥",
      "sourceLineId": "128614",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਰ ਤੇ ਪਕਰਿ ਸਹਚਰੀ ਲਯੋ ॥੯॥",
      "transliteration": "kar te pakar sahacharee layo ||9||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਦਾਸੀ ਨੇ ਹੱਥ ਨਾਲ ਪਕੜ ਲਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "कर ते पकरि सहचरी लयो ॥९॥",
      "sourceLineId": "128615",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਾਰ ਏਕ ਉਠਿ ਲਾਤ ਪ੍ਰਹਾਰੀ ॥",
      "transliteration": "jaar ek uTh laat prahaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਇਤਨੇ ਤਕ) ਯਾਰ ਨੇ ਉਠ ਕੇ ਇਕ ਲਤ ਮਾਰੀ",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "जार एक उठि लात प्रहारी ॥",
      "sourceLineId": "128616",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗਿਰਤ ਭਯੋ ਪਸੁ ਪ੍ਰਿਥੀ ਮੰਝਾਰੀ ॥",
      "transliteration": "girat bhayo pas pirathee ma(n)jhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਹ) ਪਸ਼ੂ ਧਰਤੀ ਉਤੇ ਡਿਗ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "गिरत भयो पसु पृथी मंझारी ॥",
      "sourceLineId": "128617",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੇਹਿ ਛੀਨ ਤੈ ਉਠਿ ਨ ਸਕਤ ਭਯੋ ॥",
      "transliteration": "dheh chheen tai uTh na sakat bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਦੇਹ ਨਿਰਬਲ ਸੀ, (ਇਸ ਲਈ) ਉਠ ਨਾ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "देहि छीन तै उठि न सकत भयो ॥",
      "sourceLineId": "128618",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਾਰ ਪਤਰਿ ਭਾਜਿ ਜਾਤ ਭਯੋ ॥੧੦॥",
      "transliteration": "jaar patar bhaaj jaat bhayo ||10||",
      "translation": "",
      "punjabiViakhya": "ਯਾਰ ਪਤਲਾ ਸੀ, ਉਹ ਭਜ ਗਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "जार पतरि भाजि जात भयो ॥१०॥",
      "sourceLineId": "128619",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਉਠਤ ਭਯੋ ਮੂਰਖ ਬਹੁ ਕਾਲਾ ॥",
      "transliteration": "auThat bhayo moorakh bahu kaalaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਮੂਰਖ ਬਹੁਤ ਦੇਰ ਬਾਦ ਉਠ ਖੜੋਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "उठत भयो मूरख बहु काला ॥",
      "sourceLineId": "128620",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪਾਇਨ ਆਇ ਲਗੀ ਤਬ ਬਾਲਾ ॥",
      "transliteration": "pain aai lagee tab baalaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਹ ਇਸਤਰੀ ਉਸ ਦੇ ਪੈਰੀਂ ਆ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "पाइन आइ लगी तब बाला ॥",
      "sourceLineId": "128621",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੌ ਪਿਯ ਮੁਰ ਅਪਰਾਧ ਬਿਚਾਰੋ ॥",
      "transliteration": "jau piy mur aparaadh bichaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗੀ) ਹੇ ਪਿਆਰੇ! ਜੇ ਮੇਰਾ ਕੋਈ ਕਸੂਰ ਸਮਝੋ",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "जौ पिय मुर अपराध बिचारो ॥",
      "sourceLineId": "128622",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਾਢਿ ਕ੍ਰਿਪਾਨ ਮਾਰ ਹੀ ਡਾਰੋ ॥੧੧॥",
      "transliteration": "kaadd kirapaan maar hee ddaaro ||11||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਕ੍ਰਿਪਾਨ ਕਢ ਕੇ ਮਾਰ ਹੀ ਦਿਓ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "काढि कृपान मार ही डारो ॥११॥",
      "sourceLineId": "128623",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਨ ਨਿਰਭੈ ਤੁਹਿ ਲਾਤ ਪ੍ਰਹਾਰੀ ॥",
      "transliteration": "jin nirabhai tuh laat prahaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਿਅਕਤੀ ਨੇ ਨਿਰਭੈ ਹੋ ਕੇ ਤੁਹਾਨੂੰ ਲਤ ਮਾਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "जिन निरभै तुहि लात प्रहारी ॥",
      "sourceLineId": "128624",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਵਹਿ ਆਗੈ ਮੈ ਕਵਨ ਬਿਚਾਰੀ ॥",
      "transliteration": "veh aagai mai kavan bichaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਅਗੇ ਮੈਂ ਵਿਚਾਰੀ ਕੀ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "वहि आगै मै कवन बिचारी ॥",
      "sourceLineId": "128625",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤੁਮ ਭੂਅ ਗਿਰੇ ਜਵਨ ਕੇ ਮਾਰੇ ॥",
      "transliteration": "tum bhooa gire javan ke maare ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ (ਦੇ ਲਤ) ਮਾਰਨ ਤੇ ਤੁਸੀਂ ਧਰਤੀ ਉਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "तुम भूअ गिरे जवन के मारे ॥",
      "sourceLineId": "128626",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਖਾਇ ਲੋਟਨੀ ਕਛੁ ਨ ਸੰਭਾਰੇ ॥੧੨॥",
      "transliteration": "khai loTanee kachh na sa(n)bhaare ||12||",
      "translation": "",
      "punjabiViakhya": "ਭਵਾਟਣੀ ਖਾ ਕੇ ਡਿਗ ਪਏ ਅਤੇ ਕੁਝ ਵੀ ਸੰਭਲ ਨਹੀਂ ਸਕੇ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "खाइ लोटनी कछु न संभारे ॥१२॥",
      "sourceLineId": "128627",
      "sourceShabadId": "12170",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128628",
      "sourceShabadId": "12171",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੋ ਨਰ ਤੁਮ ਤੇ ਨ ਡਰਾ ਲਾਤਨ ਕਿਯਾ ਪ੍ਰਹਾਰ ॥",
      "transliteration": "jo nar tum te na ddaraa laatan kiyaa prahaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੜਾ ਵਿਅਕਤੀ ਤੁਹਾਡੇ ਕੋਲੋਂ ਨਾ ਡਰਿਆ ਅਤੇ ਲਤਾ ਨਾਲ ਪ੍ਰਹਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "जो नर तुम ते न डरा लातन किया प्रहार ॥",
      "sourceLineId": "128629",
      "sourceShabadId": "12171",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਾ ਕੇ ਆਗੇ ਹੇਰੁ ਮੈ ਕਹਾ ਬਿਚਾਰੀ ਨਾਰਿ ॥੧੩॥",
      "transliteration": "taa ke aage her mai kahaa bichaaree naar ||13||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਅਗੇ ਵੇਖੋ ਮੈਂ ਵਿਚਾਰੀ ਇਸਤਰੀ ਕੀ ਹਾ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "ता के आगे हेरु मै कहा बिचारी नारि ॥१३॥",
      "sourceLineId": "128630",
      "sourceShabadId": "12171",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128631",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਬ ਮੇਰੋ ਤਿਨ ਰੂਪ ਨਿਹਾਰਾ ॥",
      "transliteration": "jab mero tin roop nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਨੇ ਮੇਰਾ ਰੂਪ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "जब मेरो तिन रूप निहारा ॥",
      "sourceLineId": "128632",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਰ ਅਨੰਗ ਤਬ ਹੀ ਤਿਹ ਮਾਰਾ ॥",
      "transliteration": "sar ana(n)g tab hee teh maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਕਾਮ ਦੇਵ ਨੇ ਉਸ ਨੂੰ ਤੀਰ ਮਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "सर अनंग तब ही तिह मारा ॥",
      "sourceLineId": "128633",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜੋਰਾਵਰੀ ਮੋਹਿ ਗਹਿ ਲੀਨਾ ॥",
      "transliteration": "joraavaree moh geh leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਮੈਨੂੰ ਜ਼ਬਰਦਸਤੀ ਪਕੜ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "जोरावरी मोहि गहि लीना ॥",
      "sourceLineId": "128634",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਲ ਸੌ ਦਾਬਿ ਰਾਨ ਤਰ ਦੀਨਾ ॥੧੪॥",
      "transliteration": "bal sau dhaab raan tar dheenaa ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਲ ਪੂਰਵਕ ਪਟਾ ('ਰਾਨ') ਹੇਠਾ ਦਬ ਲਿਆ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "बल सौ दाबि रान तर दीना ॥१४॥",
      "sourceLineId": "128635",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮੋਰ ਧਰਮ ਪ੍ਰਭੁ ਆਪ ਬਚਾਯੋ ॥",
      "transliteration": "mor dharam prabh aap bachaayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰਾ ਧਰਮ ਤਾ ਪ੍ਰਭੂ ਨੇ ਆਪ ਬਚਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "मोर धरम प्रभु आप बचायो ॥",
      "sourceLineId": "128636",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਾ ਤੇ ਦਰਸੁ ਤਿਹਾਰੋ ਪਯੋ ॥",
      "transliteration": "jaa te dharas tihaaro payo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਤੁਹਾਡਾ ਦੀਦਾਰ ਪ੍ਰਾਪਤ ਕਰ ਲਿਆ (ਅਰਥਾਤ ਤੁਸੀਂ ਵਕਤ ਸਿਰ ਪਹੁੰਚ ਗਏ)।",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "जा ते दरसु तिहारो पयो ॥",
      "sourceLineId": "128637",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜੌ ਤੂੰ ਅਬ ਇਹ ਠੌਰ ਨ ਆਤੋ ॥",
      "transliteration": "jau too(n) ab ieh Thauar na aato ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੁਸੀਂ ਇਸ ਸਮੇਾਂ ਇਥੇ ਨਾ ਆਉਾਂਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "जौ तूँ अब इह ठौर न आतो ॥",
      "sourceLineId": "128638",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜੋਰਾਵਰੀ ਜਾਰ ਭਜਿ ਜਾਤੋ ॥੧੫॥",
      "transliteration": "joraavaree jaar bhaj jaato ||15||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਯਾਰ ਜ਼ਬਰਦਸਤੀ ਭੋਗ ਕਰ ਜਾਦਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "जोरावरी जार भजि जातो ॥१५॥",
      "sourceLineId": "128639",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਬ ਮੁਰਿ ਏਕ ਪਰੀਛਾ ਲੀਜੈ ॥",
      "transliteration": "ab mur ek pareechhaa leejai ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਤੁਸੀਂ ਮੇਰੀ ਇਕ ਪਰੀਖਿਆ ਲਵੋ",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "अब मुरि एक परीछा लीजै ॥",
      "sourceLineId": "128640",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਾ ਤੇ ਦੂਰਿ ਚਿਤ ਭ੍ਰਮੁ ਕੀਜੈ ॥",
      "transliteration": "jaa te dhoor chit bhram keejai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ (ਤੁਸੀਂ ਆਪਣੇ) ਚਿਤ ਦਾ ਭਰਮ ਦੂਰ ਕਰ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "जा ते दूरि चित भ्रमु कीजै ॥",
      "sourceLineId": "128641",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮੂਤ੍ਰ ਜਰਤ ਜੌ ਦਿਯਾ ਨਿਹਾਰੋ ॥",
      "transliteration": "mootr jarat jau dhiyaa nihaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਜੇ ਮੇਰੇ) ਪਿਸ਼ਾਬ ਨਾਲ ਦੀਵਾ ਜਲਦਾ ਹੋਇਆ ਵੇਖੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "मूत्र जरत जौ दिया निहारो ॥",
      "sourceLineId": "128642",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਬ ਹਸਿ ਹਸਿ ਮੁਹਿ ਸਾਥ ਬਿਹਾਰੋ ॥੧੬॥",
      "transliteration": "tab has has muh saath bihaaro ||16||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਹੱਸ ਹੱਸ ਕੇ ਮੇਰੇ ਨਾਲ ਰਮਣ ਕਰੋ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "तब हसि हसि मुहि साथ बिहारो ॥१६॥",
      "sourceLineId": "128643",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪਾਤ੍ਰ ਏਕ ਤਟ ਮੂਤ੍ਰਿਯੋ ਜਾਈ ॥",
      "transliteration": "paatr ek taT mootirayo jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਇਕ ਬਰਤਨ ਕੋਲ ਪਿਸ਼ਾਬ ਕਰਨ ਲਈ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "पात्र एक तट मूतृयो जाई ॥",
      "sourceLineId": "128644",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਾ ਮੈ ਰਾਖ ਤੇਲ ਕੋ ਆਈ ॥",
      "transliteration": "jaa mai raakh tel ko aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਿਚ ਉਹ ਤੇਲ ਪਾ ਕੇ ਆ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "जा मै राख तेल को आई ॥",
      "sourceLineId": "128645",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪਿਯ ਮੁਰ ਚਿਤ ਤੋ ਸੌ ਅਤਿ ਡਰਾ ॥",
      "transliteration": "piy mur chit to sau at ddaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ ਪਤੀ ਨੂੰ ਕਹਿਣ ਲਗੀ) ਹੇ ਪ੍ਰਿਯ! ਮੇਰਾ ਚਿਤ ਤੁਹਾਡੇ ਤੋਂ ਬਹੁਤ ਅਧਿਕ ਡਰ ਗਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "पिय मुर चित तो सौ अति डरा ॥",
      "sourceLineId": "128646",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਾ ਤੇ ਲਘੁ ਅਤਿ ਹੀ ਮੈ ਕਰਾ ॥੧੭॥",
      "transliteration": "taa te lagh at hee mai karaa ||17||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਮੈਂ ਬਹੁਤ ਅਧਿਕ ਪਿਸ਼ਾਬ ('ਲਘੁ') ਕਰ ਦਿੱਤਾ ਹੈ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "ता ते लघु अति ही मै करा ॥१७॥",
      "sourceLineId": "128647",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਲਘ ਕੋ ਕਰੈ ਪਾਤ੍ਰ ਸਭ ਭਰਾ ॥",
      "transliteration": "lagh ko karai paatr sabh bharaa ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਸ਼ਾਬ ਦੇ ਕਰਨ ਨਾਲ ਸਾਰਾ ਬਰਤਨ ਭਰ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "लघ को करै पात्र सभ भरा ॥",
      "sourceLineId": "128648",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਾਕੀ ਬਚਤ ਮੂਤ੍ਰ ਭੂਅ ਪਰਾ ॥",
      "transliteration": "baakee bachat mootr bhooa paraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਾਕੀ ਬਚਿਆ ਪਿਸ਼ਾਬ ਧਰਤੀ ਉਤੇ ਵਗ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "बाकी बचत मूत्र भूअ परा ॥",
      "sourceLineId": "128649",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1166_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤੁਮਰੋ ਤ੍ਰਾਸ ਅਧਿਕ ਬਲਵਾਨਾ ॥",
      "transliteration": "tumaro traas adhik balavaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਹਾਡਾ ਡਰ ਇਤਨਾ ਬਲਵਾਨ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": "तुमरो त्रास अधिक बलवाना ॥",
      "sourceLineId": "128650",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
