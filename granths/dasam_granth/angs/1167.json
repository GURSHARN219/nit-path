{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1167,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1167_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਾ ਤੇ ਡਰਤ ਹਮਾਰੇ ਪ੍ਰਾਨਾ ॥੧੮॥",
      "transliteration": "jaa te ddarat hamaare praanaa ||18||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਮੇਰੀ ਜਾਨ ਡਰਦੀ ਹੈ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "जा ते डरत हमारे प्राना ॥१८॥",
      "sourceLineId": "128651",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਵਹੀ ਤੇਲ ਭੇ ਦੀਪ ਜਗਾਯੋ ॥",
      "transliteration": "vahee tel bhe dheep jagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੇਲ ਨਾਲ ਦੀਪਕ ਜਗਾਇਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "वही तेल भे दीप जगायो ॥",
      "sourceLineId": "128652",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪਤਿ ਦੇਖਤ ਜਿਹ ਲਘੁ ਠਹਰਾਯੋ ॥",
      "transliteration": "pat dhekhat jeh lagh Thaharaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਪਤੀ ਦੇ ਵੇਖਦੇ ਹੋਇਆਂ ਪਿਸ਼ਾਬ ਆਖਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "पति देखत जिह लघु ठहरायो ॥",
      "sourceLineId": "128653",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਜੜ ਕਛੂ ਨ ਜਾਨਾ ॥",
      "transliteration": "bhedh abhedh jaR kachhoo na jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਨੇ ਭੇਦ ਅਭੇਦ ਕੁਝ ਨਾ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद जड़ कछू न जाना ॥",
      "sourceLineId": "128654",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੀਲਵਤੀ ਇਸਤ੍ਰੀ ਕਰ ਮਾਨਾ ॥੧੯॥",
      "transliteration": "seelavatee isatree kar maanaa ||19||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸਤਰੀ ਨੂੰ ਸ਼ੀਲਵਤੀ ਮੰਨ ਲਿਆ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "सीलवती इसत्री कर माना ॥१९॥",
      "sourceLineId": "128655",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰੀਝਿ ਬਚਨ ਇਹ ਭਾਤਿ ਉਚਾਰੋ ॥",
      "transliteration": "reejh bachan ieh bhaat uchaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਪਤੀ ਨੇ) ਰੀਝ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "रीझि बचन इह भाति उचारो ॥",
      "sourceLineId": "128656",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮੈ ਤੇਰੋ ਸਤ ਸਾਚੁ ਨਿਹਾਰੋ ॥",
      "transliteration": "mai tero sat saach nihaaro ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਤੇਰਾ ਸਤਿ ਸਚੁਮਚ ਵੇਖ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "मै तेरो सत साचु निहारो ॥",
      "sourceLineId": "128657",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਬ ਚੇਰਾ ਮੈ ਭਯੋ ਤਿਹਾਰਾ ॥",
      "transliteration": "ab cheraa mai bhayo tihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੈਂ ਤੇਰਾ ਦਾਸ ਹੋ ਗਿਆ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "अब चेरा मै भयो तिहारा ॥",
      "sourceLineId": "128658",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਹੋ ਸੁ ਕਰੌ ਕਾਜ ਬਹੁ ਹਾਰਾ ॥੨੦॥",
      "transliteration": "kaho su karau kaaj bahu haaraa ||20||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਤਰ੍ਰਹਾ ਦੇ ਜੋ ਕੰਮ ਵੀ ਤੂੰ ਕਹੇਾਂਗੀ, ਉਹੀ ਕਰਾਗਾ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "कहो सु करौ काज बहु हारा ॥२०॥",
      "sourceLineId": "128659",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮੂਤ੍ਰ ਭਏ ਤੈ ਦੀਪ ਜਗਾਯੋ ॥",
      "transliteration": "mootr bhe tai dheep jagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਸ਼ਾਬ ਨਾਲ ਤੂੰ ਦੀਪਕ ਜਗਾ ਦਿੱਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "मूत्र भए तै दीप जगायो ॥",
      "sourceLineId": "128660",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚਮਤਕਾਰ ਇਹ ਹਮੈ ਦਿਖਾਯੋ ॥",
      "transliteration": "chamatakaar ieh hamai dhikhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਹ ਚਮਤਕਾਰ ਮੈਨੂੰ ਵਿਖਾਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "चमतकार इह हमै दिखायो ॥",
      "sourceLineId": "128661",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪਟੁਕਾ ਡਾਰਿ ਗ੍ਰੀਵ ਪਗ ਪਰਾ ॥",
      "transliteration": "paTukaa ddaar greev pag paraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਗੱਲ ਵਿਚ ਪਟਕਾ ਪਾ ਕੇ (ਉਸ ਦੇ) ਪੈਰਾ ਉਤੇ ਡਿਗ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "पटुका डारि ग्रीव पग परा ॥",
      "sourceLineId": "128662",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਘਰੀ ਚਾਰਿ ਲਗਿ ਨਾਕ ਰਗਰਾ ॥੨੧॥",
      "transliteration": "gharee chaar lag naak ragaraa ||21||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਾਰ ਘੜੀਆਂ ਤਕ ਨਕ ਰਗੜਦਾ ਰਿਹਾ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "घरी चारि लगि नाक रगरा ॥२१॥",
      "sourceLineId": "128663",
      "sourceShabadId": "12172",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128664",
      "sourceShabadId": "12173",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਏਕ ਰਿਸਾਲੂ ਨਿਰਖ੍ਰਯੋ ਆਂਖਿਨ ਐਸ ਚਰਿਤ੍ਰ ॥",
      "transliteration": "ek risaaloo nirakhrayo aa(n)khin aais charitr ||",
      "translation": "",
      "punjabiViakhya": "ਅਜਿਹਾ ਇਕ ਚਰਿਤ੍ਰ ਰਾਜਾ ਰਿਸਾਲੂ ਨੇ ਅੱਖਾ ਨਾਲ ਵੇਖਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "एक रिसालू निरख्रयो आँखिन ऐस चरित्र ॥",
      "sourceLineId": "128665",
      "sourceShabadId": "12173",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕੈ ਹਮ ਆਜੁ ਬਿਲੋਕਿਯੋ ਸਾਚ ਕਹਤ ਤ੍ਰਿਯ ਮਿਤ੍ਰ ॥੨੨॥",
      "transliteration": "kai ham aaj bilokiyo saach kahat tiray mitr ||22||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਮੈਂ ਅਜ ਵੇਖਿਆ ਹੈ। ਹੇ ਮਿਤਰ ਭਾਵ ਇਸਤਰੀ! ਮੈਂ ਸਚ ਕਹਿੰਦਾ ਹਾ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "कै हम आजु बिलोकियो साच कहत तृय मित्र ॥२२॥",
      "sourceLineId": "128666",
      "sourceShabadId": "12173",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128667",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਬ ਤੂ ਕਹੈ ਜੁ ਮੁਹਿ ਸੋਈ ਕਰੌ ॥",
      "transliteration": "ab too kahai ju muh soiee karau ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਜੋ ਤੂੰ ਕਹੇਾਂਗੀ, ਮੈਂ ਉਹੀ ਕਰਾਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "अब तू कहै जु मुहि सोई करौ ॥",
      "sourceLineId": "128668",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹ੍ਵੈ ਕਰ ਦਾਸ ਨੀਰ ਤਵ ਭਰੌ ॥",
      "transliteration": "havai kar dhaas neer tav bharau ||",
      "translation": "",
      "punjabiViakhya": "ਦਾਸ ਹੋ ਕੇ ਤੇਰਾ ਪਾਣੀ ਭਰਾਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "ह्वै कर दास नीर तव भरौ ॥",
      "sourceLineId": "128669",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹਸਿ ਹਸਿ ਤ੍ਰਿਯ ਕੌ ਗਰੇ ਲਗਾਵੈ ॥",
      "transliteration": "has has tiray kau gare lagaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਹੱਸ ਹੱਸ ਕੇ ਇਸਤਰੀ ਨੂੰ ਗਲੇ ਨਾਲ ਲਗਾ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "हसि हसि तृय कौ गरे लगावै ॥",
      "sourceLineId": "128670",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭੇਦ ਕਛੂ ਮੂਰਖ ਨਹਿ ਪਾਵੈ ॥੨੩॥",
      "transliteration": "bhedh kachhoo moorakh neh paavai ||23||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਹ) ਮੂਰਖ ਕੁਝ ਵੀ ਭੇਦ ਨਹੀਂ ਸਮਝ ਰਿਹਾ ਸੀ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "भेद कछू मूरख नहि पावै ॥२३॥",
      "sourceLineId": "128671",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਿਹਸਿ ਨਾਰਿ ਇਹ ਭਾਤਿ ਉਚਾਰਾ ॥",
      "transliteration": "bihas naar ieh bhaat uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਸਤਰੀ ਨੇ ਹੱਸ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "बिहसि नारि इह भाति उचारा ॥",
      "sourceLineId": "128672",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬ੍ਰਹਮ ਭੋਜ ਕਰੁ ਨਾਥ ਸ ਭਾਰਾ ॥",
      "transliteration": "braham bhoj kar naath s bhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਹੇ ਨਾਥ! ਇਕ ਵੱਡਾ ਬ੍ਰਹਮ ਭੋਜ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "ब्रहम भोज करु नाथ स भारा ॥",
      "sourceLineId": "128673",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭਲੀ ਭਾਤਿ ਦਿਜ ਪ੍ਰਿਥਮ ਜਿਵਾਵੋ ॥",
      "transliteration": "bhalee bhaat dhij piratham jivaavo ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਬ੍ਰਾਹਮਣਾ ਨੂੰ ਖਵਾਓ",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "भली भाति दिज पृथम जिवावो ॥",
      "sourceLineId": "128674",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਹੁਰੋ ਸੇਜ ਹਮਾਰੀ ਆਵੋ ॥੨੪॥",
      "transliteration": "bahuro sej hamaaree aavo ||24||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਮੇਰੀ ਸੇਜ ਉਤੇ ਆਓ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "बहुरो सेज हमारी आवो ॥२४॥",
      "sourceLineId": "128675",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਛੂ ਨ ਲਖਾ ਦੈਵ ਕੇ ਮਾਰੇ ॥",
      "transliteration": "kachhoo na lakhaa dhaiv ke maare ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੈਵ ਦੇ ਮਾਰੇ ਨੇ ਕੁਝ ਨਾ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "कछू न लखा दैव के मारे ॥",
      "sourceLineId": "128676",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬ੍ਰਹਮ ਭੋਜ ਕਹ ਕਿਯਾ ਸਵਾਰੇ ॥",
      "transliteration": "braham bhoj keh kiyaa savaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੰਗੀ ਤਰ੍ਰਹਾ ਬ੍ਰਹਮ ਭੋਜ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "ब्रहम भोज कह किया सवारे ॥",
      "sourceLineId": "128677",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭਲੀ ਭਾਤਿ ਦਿਜ ਪ੍ਰਥਮ ਜਿਵਾਏ ॥",
      "transliteration": "bhalee bhaat dhij pratham jivaae ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਗੀ ਤਰ੍ਰਹਾ ਪਹਿਲਾ ਬ੍ਰਾਹਮਣਾ ਨੂੰ ਖਵਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "भली भाति दिज प्रथम जिवाए ॥",
      "sourceLineId": "128678",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਹੁਰਿ ਨਾਰਿ ਕੀ ਸੇਜ ਸਿਧਾਏ ॥੨੫॥",
      "transliteration": "bahur naar kee sej sidhaae ||25||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਨਾਰੀ ਦੀ ਸੇਜ ਉਪਰ ਗਿਆ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "बहुरि नारि की सेज सिधाए ॥२५॥",
      "sourceLineId": "128679",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜੋ ਤ੍ਰਿਯ ਕਹੀ ਵਹੈ ਗਤਿ ਕੀਨੀ ॥",
      "transliteration": "jo tiray kahee vahai gat keenee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਇਸਤਰੀ ਨੇ ਕਿਹਾ, ਉਸੇ ਤਰ੍ਰਹਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "जो तृय कही वहै गति कीनी ॥",
      "sourceLineId": "128680",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜੀਤਿ ਹੋਡ ਨਨਦਿ ਤੇ ਲੀਨੀ ॥",
      "transliteration": "jeet hodd nanadh te leenee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ ਉਸ ਇਸਤਰੀ ਨੇ) ਨਨਾਣ ਤੋਂ ਸ਼ਰਤ ਜਿਤ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "जीति होड ननदि ते लीनी ॥",
      "sourceLineId": "128681",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤੇਲ ਮੂਤ੍ਰ ਕਹਿ ਦੀਪ ਜਗਾਯੋ ॥",
      "transliteration": "tel mootr keh dheep jagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਸ਼ਾਬ ਨੂੰ ਤੇਲ ਤੇਲ ਕਹਿ ਕੇ ਦੀਪਕ ਜਗਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "तेल मूत्र कहि दीप जगायो ॥",
      "sourceLineId": "128682",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬ੍ਰਹਮ ਦੰਡ ਪਤਿ ਤੇ ਕਰਵਾਯੋ ॥੨੬॥",
      "transliteration": "braham dha(n)dd pat te karavaayo ||26||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਤੀ ਤੋਂ ਬ੍ਰਹਮ ਦੰਡ ਵੀ ਕਰਵਾ ਲਿਆ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "ब्रहम दंड पति ते करवायो ॥२६॥",
      "sourceLineId": "128683",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਧਿਕ ਹਰੀਫ ਕਹਾਵਤ ਹੁਤੋ ॥",
      "transliteration": "adhik hareef kahaavat huto ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਆਪਣੇ ਆਪ ਨੂੰ ਬਹੁਤ ਕਪਟੀ ('ਹਰੀਫ') ਅਖਵਾਉਾਂਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "अधिक हरीफ कहावत हुतो ॥",
      "sourceLineId": "128684",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭੂਲਿ ਨ ਭਾਗਹਿ ਪੀਵਤ ਸੁਤੋ ॥",
      "transliteration": "bhool na bhaageh peevat suto ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਕਦੇ ਭੰਗ ਪੀ ਕੇ ਨਾ ਸੁੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "भूलि न भागहि पीवत सुतो ॥",
      "sourceLineId": "128685",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਕਰਿ ਦ੍ਰਿਗਨ ਦਿਖਾਯੋ ॥",
      "transliteration": "eeh charitr kar dhiragan dhikhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਚਰਿਤ੍ਰ ਕਰ ਕੇ ਉਸ ਇਸਤਰੀ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र करि दृगन दिखायो ॥",
      "sourceLineId": "128686",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਇਹ ਛਲ ਸੌ ਵਹਿ ਤ੍ਰਿਯ ਡਹਕਾਯੋ ॥੨੭॥",
      "transliteration": "eeh chhal sau veh tiray ddahakaayo ||27||",
      "translation": "",
      "punjabiViakhya": "ਅੱਖਾ ਨਾਲ ਵਿਖਾ ਕੇ (ਪਤੀ ਨੂੰ) ਭਰਮਾ ਦਿੱਤਾ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "इह छल सौ वहि तृय डहकायो ॥२७॥",
      "sourceLineId": "128687",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪ੍ਰਥਮ ਭੋਗ ਪਿਯ ਲਖਤ ਕਮਾਯੋ ॥",
      "transliteration": "pratham bhog piy lakhat kamaayo ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ (ਉਸ ਨੇ) ਪਤੀ ਦੇ ਵੇਖਦੇ ਹੋਇਆਂ ਭੋਗ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "प्रथम भोग पिय लखत कमायो ॥",
      "sourceLineId": "128688",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਾਰਿ ਮੂਤ੍ਰ ਭੇ ਦੀਪ ਦਖਾਯੋ ॥",
      "transliteration": "jaar mootr bhe dheep dhakhaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਪਿਸ਼ਾਬ ਨਾਲ ਦੀਪਕ ਜਲਾ ਕੇ ਵਿਖਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "जारि मूत्र भे दीप दखायो ॥",
      "sourceLineId": "128689",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬ੍ਰਹਮ ਭੋਜ ਉਲਟੋ ਤਾ ਪਰ ਕਰਿ ॥",
      "transliteration": "braham bhoj ulaTo taa par kar ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਲਟਾ ਉਸ ਤੋਂ ਬ੍ਰਹਮ ਭੋਜ ਕਰਵਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "ब्रहम भोज उलटो ता पर करि ॥",
      "sourceLineId": "128690",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪਤਿ ਜਾਨੀ ਪਤਿਬ੍ਰਤਾ ਤ੍ਰਿਯਾ ਘਰ ॥੨੮॥",
      "transliteration": "pat jaanee patibrataa tirayaa ghar ||28||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਤੀ ਨੇ ਜਾਣ ਲਿਆ ਕਿ ਮੇਰੇ ਘਰ ਪਤੀਬ੍ਰਤਾ ਇਸਤਰੀ ਹੈ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "पति जानी पतिब्रता तृया घर ॥२८॥",
      "sourceLineId": "128691",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਤਿਰਪਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੫੩॥੪੭੭੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau tirapan charitr samaapatam sat subham sat ||253||4770||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੫੩ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੫੩॥੪੭੭੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ तिरपन चरित्र समापतम सतु सुभम सतु ॥२५३॥४७७०॥अफजूँ॥",
      "sourceLineId": "128692",
      "sourceShabadId": "12174",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128693",
      "sourceShabadId": "12175",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬੇਸ੍ਵਾ ਏਕ ਠੌਰ ਇਕ ਸੁਨੀ ॥",
      "transliteration": "besavaiaa ek Thauar ik sunee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਥਾ ਇਕ ਵੇਸਵਾ ਸੁਣੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "बेस्वा एक ठौर इक सुनी ॥",
      "sourceLineId": "128694",
      "sourceShabadId": "12175",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪਾਤ੍ਰ ਕਲਾ ਨਾਮਾ ਬਹੁ ਗੁਨੀ ॥",
      "transliteration": "paatr kalaa naamaa bahu gunee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਨਾ ਪਾਤ੍ਰ ਕਲਾ ਸੀ ਅਤੇ ਬਹੁਤ ਗੁਣਵਾਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "पात्र कला नामा बहु गुनी ॥",
      "sourceLineId": "128695",
      "sourceShabadId": "12175",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਧਿਕ ਤਰੁਨਿ ਕੀ ਦਿਪਤਿ ਬਿਰਾਜੈ ॥",
      "transliteration": "adhik tarun kee dhipat biraajai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਇਸਤਰੀ ਦੀ ਸੁੰਦਰਤਾ ਬਹੁਤ ਅਧਿਕ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "अधिक तरुनि की दिपति बिराजै ॥",
      "sourceLineId": "128696",
      "sourceShabadId": "12175",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰੰਭਾ ਕੋ ਨਿਰਖਤ ਮਨ ਲਾਜੈ ॥੧॥",
      "transliteration": "ra(n)bhaa ko nirakhat man laajai ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਰੰਭਾ (ਅਪੱਛਰਾ) ਵੀ ਸ਼ਰਮਾਉਾਂਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "रंभा को निरखत मन लाजै ॥१॥",
      "sourceLineId": "128697",
      "sourceShabadId": "12175",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1167_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬਿਸਨ ਕੇਤੁ ਇਕ ਰਾਇ ਤਹਾ ਕੋ ॥",
      "transliteration": "bisan ket ik rai tahaa ko ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਸਨ ਕੇਤੁ ਉਥੋਂ ਦਾ ਇਕ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": "बिसन केतु इक राइ तहा को ॥",
      "sourceLineId": "128698",
      "sourceShabadId": "12175",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
