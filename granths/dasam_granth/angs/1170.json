{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1170,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1170_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਰਿਤਾ ਬਹੁਤ ਬਹਤ ਜਿਹ ਬਨ ਮੈ ॥",
      "transliteration": "saritaa bahut bahat jeh ban mai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਬਨ ਵਿਚ ਬਹੁਤ ਨਦੀਆਂ ਵਗਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "सरिता बहुत बहत जिह बन मै ॥",
      "sourceLineId": "128819",
      "sourceShabadId": "12190",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਝਰਨਾ ਚਲਤ ਲਗਤ ਸੁਖ ਮਨ ਮੈ ॥",
      "transliteration": "jharanaa chalat lagat sukh man mai ||",
      "translation": "",
      "punjabiViakhya": "ਝਰਨੇ ਚਲਦੇ ਸਨ ਜਿਸ ਕਰ ਕੇ ਮਨ ਵਿਚ ਆਨੰਦ ਪ੍ਰਾਪਤ ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "झरना चलत लगत सुख मन मै ॥",
      "sourceLineId": "128820",
      "sourceShabadId": "12190",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੋਭਾ ਅਧਿਕ ਨ ਬਰਨੀ ਜਾਵੈ ॥",
      "transliteration": "sobhaa adhik na baranee jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਬਹੁਤ ਅਧਿਕ ਸ਼ੋਭਾ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "सोभा अधिक न बरनी जावै ॥",
      "sourceLineId": "128821",
      "sourceShabadId": "12190",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਿਰਖੇ ਹੀ ਆਭਾ ਬਨਿ ਆਵੈ ॥੯॥",
      "transliteration": "nirakhe hee aabhaa ban aavai ||9||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੀ ਖ਼ੂਬਸੂਰਤੀ ਵੇਖਦਿਆਂ ਹੀ ਬਣਦੀ ਸੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "निरखे ही आभा बनि आवै ॥९॥",
      "sourceLineId": "128822",
      "sourceShabadId": "12190",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਹ ਹੀ ਜਾਤ ਭਯਾ ਸੋ ਰਾਈ ॥",
      "transliteration": "teh hee jaat bhayaa so raiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਉਥੇ ਹੀ ਜਾ ਪਹੁੰਚਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "तह ही जात भया सो राई ॥",
      "sourceLineId": "128823",
      "sourceShabadId": "12190",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਾ ਕੀ ਪ੍ਰਭਾ ਨ ਬਰਨੀ ਜਾਈ ॥",
      "transliteration": "jaa kee prabhaa na baranee jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ (ਥਾ) ਦੀ ਸ਼ੋਭਾ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "जा की प्रभा न बरनी जाई ॥",
      "sourceLineId": "128824",
      "sourceShabadId": "12190",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਰਤ ਭਯੋ ਮ੍ਰਿਗਹਿ ਲੈ ਤਹਾ ॥",
      "transliteration": "marat bhayo mirageh lai tahaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਉਥੇ ਲੈ ਜਾ ਕੇ ਹਿਰਨ ਮਰ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "मरत भयो मृगहि लै तहा ॥",
      "sourceLineId": "128825",
      "sourceShabadId": "12190",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੇਵ ਦੈਂਤ ਜਾ ਨਿਰਖਤ ਜਹਾ ॥੧੦॥",
      "transliteration": "dhev dhai(n)t jaa nirakhat jahaa ||10||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਦੇਵਤੇ ਅਤੇ ਦੈਂਤ ਵੇਖ ਰਹੇ ਸਨ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "देव दैंत जा निरखत जहा ॥१०॥",
      "sourceLineId": "128826",
      "sourceShabadId": "12190",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128827",
      "sourceShabadId": "12191",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੇਵ ਦਾਨਵਨ ਕੀ ਸੁਤਾ ਜਿਹ ਬਨ ਸੇਵਤ ਨਿਤ੍ਯ ॥",
      "transliteration": "dhev dhaanavan kee sutaa jeh ban sevat nitay ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤਿਆਂ ਅਤੇ ਦੈਂਤਾ ਦੀਆਂ ਪੁੱਤਰੀਆਂ ਉਸ ਬਨ ਦਾ ਨਿੱਤ ਸੇਵਨ ਕਰਦੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "देव दानवन की सुता जिह बन सेवत नित्य ॥",
      "sourceLineId": "128828",
      "sourceShabadId": "12191",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਦਾ ਬਸਾਯੋ ਰਾਖ ਹੀ ਤਾਹਿ ਚਿਤ ਜ੍ਯੋ ਮਿਤ੍ਰਯ ॥੧੧॥",
      "transliteration": "sadhaa basaayo raakh hee taeh chit jayo mitray ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਮਿਤਰ ਵਾਗ ਸਦਾ ਮਨ ਵਿਚ ਵਸਾਈ ਰਖਦੀਆਂ ਸਨ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "सदा बसायो राख ही ताहि चित ज्यो मित्रय ॥११॥",
      "sourceLineId": "128829",
      "sourceShabadId": "12191",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128830",
      "sourceShabadId": "12192",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਛ ਗੰਧ੍ਰਬੀ ਅਤਿ ਉਨਮਦਾ ॥",
      "transliteration": "jachh ga(n)dhrabee at unamadhaa ||",
      "translation": "",
      "punjabiViakhya": "ਯਕਸ਼ ਅਤੇ ਗੰਧਰਬ ਇਸਤਰੀਆਂ ਬਹੁਤ ਮਸਤ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "जछ गंध्रबी अति उनमदा ॥",
      "sourceLineId": "128831",
      "sourceShabadId": "12192",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੇਵਤ ਹੈਂ ਤਿਹ ਬਨ ਕੌ ਸਦਾ ॥",
      "transliteration": "sevat hai(n) teh ban kau sadhaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਬਨ (ਵਿਚ ਵਿਚਰਦੀਆਂ ਹੋਈਆਂ) ਇਸ ਦਾ ਧਿਆਨ ਰਖਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "सेवत हैं तिह बन कौ सदा ॥",
      "sourceLineId": "128832",
      "sourceShabadId": "12192",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਰੀ ਨਾਗਨੀ ਕੌ ਚਿਤ ਲ੍ਯਾਵੈ ॥",
      "transliteration": "naree naaganee kau chit layaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਨਾਰੀਆਂ ਅਤੇ ਨਾਗ ਕੰਨਿਆਂ ਦੇ ਚਿਤ ਮੋਹ ਲੈਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "नरी नागनी कौ चित ल्यावै ॥",
      "sourceLineId": "128833",
      "sourceShabadId": "12192",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਟੀ ਨ੍ਰਿਤਕਾ ਕੌਨ ਗਨਾਵੈ ॥੧੨॥",
      "transliteration": "naTee niratakaa kauan ganaavai ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨੱਚਣ ਵਾਲੀਆਂ ਦੀ ਤਾ ਗਿਣਤੀ ਹੀ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕਦੀ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "नटी नृतका कौन गनावै ॥१२॥",
      "sourceLineId": "128834",
      "sourceShabadId": "12192",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128835",
      "sourceShabadId": "12193",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਿਨ ਕੀ ਦੁਤਿ ਤਿਨ ਹੀ ਬਨੀ ਕੋ ਕਬਿ ਸਕਤ ਬਤਾਇ ॥",
      "transliteration": "tin kee dhut tin hee banee ko kab sakat batai ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੀ ਸੁੰਦਰਤਾ ਉਨ੍ਰਹਾ ਵਰਗੀ ਹੀ ਸੀ, ਕੋਈ ਕਵੀ ਕੀ ਬਿਆਨ ਕਰ ਸਕਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "तिन की दुति तिन ही बनी को कबि सकत बताइ ॥",
      "sourceLineId": "128836",
      "sourceShabadId": "12193",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਲਖੇ ਲਗਨ ਲਾਗੀ ਰਹੈ ਪਲਕ ਨ ਜੋਰੀ ਜਾਇ ॥੧੩॥",
      "transliteration": "lakhe lagan laagee rahai palak na joree jai ||13||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਵੇਖ ਕੇ ਲਗਨ ਲਗੀ ਰਹਿ ਜਾਦੀ ਅਤੇ ਪਲਕਾ ਨੂੰ ਜੋੜਿਆ ਤਕ ਨਹੀਂ ਜਾ ਸਕਦਾ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "लखे लगन लागी रहै पलक न जोरी जाइ ॥१३॥",
      "sourceLineId": "128837",
      "sourceShabadId": "12193",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128838",
      "sourceShabadId": "12194",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਤਿਨ ਕੌ ਜਬ ਲਹਾ ॥",
      "transliteration": "raaj kuar tin kau jab lahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜ ਕੁੰਵਰ ਨੇ ਉਨ੍ਰਹਾ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "राज कुअर तिन कौ जब लहा ॥",
      "sourceLineId": "128839",
      "sourceShabadId": "12194",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਨ ਮਹਿ ਅਤਿਹਿ ਬਿਸਮ ਹ੍ਵੈ ਰਹਾ ॥",
      "transliteration": "man meh ateh bisam havai rahaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮਨ ਵਿਚ ਬਹੁਤ ਹੈਰਾਨ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "मन महि अतिहि बिसम ह्वै रहा ॥",
      "sourceLineId": "128840",
      "sourceShabadId": "12194",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚਿਤ ਭਰਿ ਚੌਪ ਡੀਠ ਇਮਿ ਜੋਰੀ ॥",
      "transliteration": "chit bhar chauap ddeeTh im joree ||",
      "translation": "",
      "punjabiViakhya": "ਮਨ ਵਿਚ ਬਹੁਤ ਉਲਸਿਤ ਹੋ ਕੇ ਉਨ੍ਰਹਾ ਨਾਲ ਨਜ਼ਰਾ ਜੋੜੀਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "चित भरि चौप डीठ इमि जोरी ॥",
      "sourceLineId": "128841",
      "sourceShabadId": "12194",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਨੁਕ ਚੰਦ੍ਰ ਕੇ ਸਾਥ ਚਕੋਰੀ ॥੧੪॥",
      "transliteration": "januk cha(n)dhr ke saath chakoree ||14||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਚੰਦ੍ਰਮਾ ਨਾਲ ਚਕੋਰੀ ਜੋੜਦੀ ਹੋਵੇ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "जनुक चंद्र के साथ चकोरी ॥१४॥",
      "sourceLineId": "128842",
      "sourceShabadId": "12194",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128843",
      "sourceShabadId": "12195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਯਾ ਰਾਜਾ ਕੋ ਰੂਪ ਲਖਿ ਅਟਕਿ ਰਹੀ ਵੈ ਬਾਲ ॥",
      "transliteration": "yaa raajaa ko roop lakh aTak rahee vai baal ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਰਾਜੇ ਦਾ ਰੂਪ ਵੇਖ ਕੇ ਉਹ ਇਸਤਰੀਆਂ ਅਟਕ ਕੇ ਰਹਿ ਗਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "या राजा को रूप लखि अटकि रही वै बाल ॥",
      "sourceLineId": "128844",
      "sourceShabadId": "12195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਲਲਨਾ ਕੇ ਲੋਇਨ ਨਿਰਖਿ ਸਭ ਹੀ ਭਈ ਗੁਲਾਲ ॥੧੫॥",
      "transliteration": "lalanaa ke loin nirakh sabh hee bhiee gulaal ||15||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪ੍ਰੀਤਮ ਦੀਆਂ ਅੱਖੀਆਂ ਵੇਖ ਕੇ ਸਭ ਹੀ ਲਾਲੋ ਲਾਲ ਹੋ ਗਈਆਂ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "ललना के लोइन निरखि सभ ही भई गुलाल ॥१५॥",
      "sourceLineId": "128845",
      "sourceShabadId": "12195",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128846",
      "sourceShabadId": "12196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਟਕਤ ਭਈ ਲਾਲ ਲਖਿ ਬਾਲਾ ॥",
      "transliteration": "aTakat bhiee laal lakh baalaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪ੍ਰਿਯ ਨੂੰ ਵੇਖ ਕੇ ਸਾਰੀਆਂ ਇੰਜ ਅਟਕ ਗਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "अटकत भई लाल लखि बाला ॥",
      "sourceLineId": "128847",
      "sourceShabadId": "12196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜੈਸੇ ਮਨਿ ਲਾਲਨ ਕੀ ਮਾਲਾ ॥",
      "transliteration": "jaise man laalan kee maalaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਮਣੀਆਂ ਅਤੇ ਹੀਰਿਆਂ ਦੀਆਂ ਮਾਲਾਵਾ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "जैसे मनि लालन की माला ॥",
      "sourceLineId": "128848",
      "sourceShabadId": "12196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਹਿਯੋ ਚਹਤ ਕਛੁ ਤਊ ਲਜਾਵੈ ॥",
      "transliteration": "kahiyo chahat kachh tuoo lajaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਕੁਝ ਕਹਿਣਾ ਚਾਹੁੰਦੀਆਂ ਸਨ, ਪਰ ਲਜਾਉਾਂਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "कहियो चहत कछु तऊ लजावै ॥",
      "sourceLineId": "128849",
      "sourceShabadId": "12196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚਲਿ ਚਲਿ ਤੀਰ ਕੁਅਰ ਕੇ ਆਵੈ ॥੧੬॥",
      "transliteration": "chal chal teer kuar ke aavai ||16||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਵੀ ਚਲ ਚਲ ਕੇ ਕੁੰਵਰ ਦੇ ਨੇੜੇ ਆ ਰਹੀਆਂ ਸਨ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "चलि चलि तीर कुअर के आवै ॥१६॥",
      "sourceLineId": "128850",
      "sourceShabadId": "12196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕੈ ਕੁਰਬਾਨ ਲਲਾ ਮਨ ਡਾਰੈ ॥",
      "transliteration": "kai kurabaan lalaa man ddaarai ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਿਯ ਤੋਂ ਮਨ ਕੁਰਬਾਨ ਕਰ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "कै कुरबान लला मन डारै ॥",
      "sourceLineId": "128851",
      "sourceShabadId": "12196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭੂਖਨ ਚੀਰ ਪਟੰਬਰ ਵਾਰੈ ॥",
      "transliteration": "bhookhan cheer paTa(n)bar vaarai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਗਹਿਣੇ, ਬਸਤ੍ਰ ਅਤੇ ਰੇਸ਼ਮੀ ਦੁਪਟੇ ਵਾਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "भूखन चीर पटंबर वारै ॥",
      "sourceLineId": "128852",
      "sourceShabadId": "12196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਫੂਲ ਪਾਨ ਕੋਊ ਲੈ ਆਵੈ ॥",
      "transliteration": "fool paan kouoo lai aavai ||",
      "translation": "",
      "punjabiViakhya": "ਕੋਈ ਫੁਲ ਅਤੇ ਪਾਨ ਲਿਆ ਰਹੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "फूल पान कोऊ लै आवै ॥",
      "sourceLineId": "128853",
      "sourceShabadId": "12196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਸੌ ਗੀਤਨ ਗਾਵੈ ॥੧੭॥",
      "transliteration": "bhaat bhaat sau geetan gaavai ||17||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦੇ ਗੀਤ ਗਾ ਰਹੀ ਸੀ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "भाति भाति सौ गीतन गावै ॥१७॥",
      "sourceLineId": "128854",
      "sourceShabadId": "12196",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128855",
      "sourceShabadId": "12197",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਿਰਖਿ ਨ੍ਰਿਪਤ ਕੀ ਅਤਿ ਪ੍ਰਭਾ ਰੀਝ ਰਹੀ ਸਭ ਨਾਰਿ ॥",
      "transliteration": "nirakh nirapat kee at prabhaa reejh rahee sabh naar ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦੀ ਅਤਿ ਅਧਿਕ ਪ੍ਰਭਾ ਨੂੰ ਵੇਖ ਕੇ ਸਭ ਨਾਰੀਆਂ ਮੋਹਿਤ ਹੋ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "निरखि नृपत की अति प्रभा रीझ रही सभ नारि ॥",
      "sourceLineId": "128856",
      "sourceShabadId": "12197",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਭੂਖਨ ਚੀਰ ਪਟੰਬ੍ਰ ਸਭ ਦੇਇ ਛਿਨਿਕ ਮਹਿ ਵਾਰ ॥੧੮॥",
      "transliteration": "bhookhan cheer paTa(n)br sabh dhei chhinik meh vaar ||18||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਗਹਿਣੇ, ਬਸਤ੍ਰ ਅਤੇ ਰੇਸ਼ਮੀ ਦੁਪਟੇ ਛਿਣ ਵਿਚ ਵਾਰ ਦਿੱਤੇ ਸਨ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "भूखन चीर पटंब्र सभ देइ छिनिक महि वार ॥१८॥",
      "sourceLineId": "128857",
      "sourceShabadId": "12197",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਨੁ ਕੁਰੰਗਨਿ ਨਾਦ ਧੁਨਿ ਰੀਝਿ ਰਹੀ ਸੁਨਿ ਕਾਨ ॥",
      "transliteration": "jan kura(n)gan naadh dhun reejh rahee sun kaan ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਹਿਰਨੀ ਨਾਦ ਕੰਨ ਨਾਲ ਸੁਣ ਕੇ ਰੀਝ ਰਹੀ ਹੋਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "जनु कुरंगनि नाद धुनि रीझि रही सुनि कान ॥",
      "sourceLineId": "128858",
      "sourceShabadId": "12197",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤ੍ਯੋਂ ਅਬਲਾ ਬੇਧੀ ਸਕਲ ਬਧੀ ਬਿਰਹ ਕੇ ਬਾਨ ॥੧੯॥",
      "transliteration": "tayo(n) abalaa bedhee sakal badhee bireh ke baan ||19||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਤਰ੍ਰਹਾ ਸਾਰੀਆਂ ਇਸਤਰੀਆਂ ਬਿਰਹੋਂ ਦੇ ਬਾਣ ਨਾਲ ਵਿੰਨ੍ਰਹੀਆਂ ਗਈਆਂ ਸਨ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "त्यों अबला बेधी सकल बधी बिरह के बान ॥१९॥",
      "sourceLineId": "128859",
      "sourceShabadId": "12197",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਭ ਰੀਝੀ ਲਖਿ ਰਾਇ ਛਬਿ ਦਿਤਿਯਾਦਿਤਿ ਕੁਮਾਰਿ ॥",
      "transliteration": "sabh reejhee lakh rai chhab dhitiyaadhit kumaar ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦੀ ਸੁੰਦਰਤਾ ਨੂੰ ਵੇਖ ਕੇ ਸਭ ਦੇਵ ਦਾਨਵ ਇਸਤਰੀਆਂ ਰੁਚਿਤ ਹੋ ਗਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "सभ रीझी लखि राइ छबि दितियादिति कुमारि ॥",
      "sourceLineId": "128860",
      "sourceShabadId": "12197",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਿੰਨ੍ਰਨਿ ਜਛ ਭੁਜੰਗਜਾ ਮੋਹਿ ਰਹੀ ਸਭ ਨਾਰਿ ॥੨੦॥",
      "transliteration": "ki(n)nran jachh bhuja(n)gajaa moh rahee sabh naar ||20||",
      "translation": "",
      "punjabiViakhya": "ਕਿੰਨਰਾ, ਯਕਸ਼ਾ ਅਤੇ ਨਾਗਾ ਦੀਆਂ ਪੁੱਤਰੀਆਂ, ਸਭ ਇਸਤਰੀਆਂ ਮੋਹਿਤ ਹੋ ਗਈਆਂ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "किंन्रनि जछ भुजंगजा मोहि रही सभ नारि ॥२०॥",
      "sourceLineId": "128861",
      "sourceShabadId": "12197",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128862",
      "sourceShabadId": "12198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਭ ਅਬਲਾ ਇਹ ਭਾਤਿ ਬਿਚਾਰੈ ॥",
      "transliteration": "sabh abalaa ieh bhaat bichaarai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਇਸਤਰੀਆਂ ਇਸ ਤਰ੍ਰਹਾ ਸੋਚ ਰਹੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "सभ अबला इह भाति बिचारै ॥",
      "sourceLineId": "128863",
      "sourceShabadId": "12198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜੋਰ ਡੀਠ ਨ੍ਰਿਪ ਓਰ ਨਿਹਾਰੈ ॥",
      "transliteration": "jor ddeeTh nirap or nihaarai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਜ਼ਰਾ ਟਿਕਾ ਕੇ ਰਾਜੇ ਵਲ ਵੇਖ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "जोर डीठ नृप ओर निहारै ॥",
      "sourceLineId": "128864",
      "sourceShabadId": "12198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕੈ ਹਮ ਆਜੁ ਇਹੀ ਕਰ ਬਰਿਹੈ ॥",
      "transliteration": "kai ham aaj ihee kar barihai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਤਾ ਅਸੀਂ ਅਜ ਇਸ ਨੂੰ ਵਰ ਲਵਾਗੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "कै हम आजु इही कर बरिहै ॥",
      "sourceLineId": "128865",
      "sourceShabadId": "12198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1170_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਾਤਰ ਇਹੀ ਛੇਤ੍ਰ ਪਰ ਮਰਿਹੈ ॥੨੧॥",
      "transliteration": "naatar ihee chhetr par marihai ||21||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਫਿਰ ਇਸੇ ਥਾ ਤੇ ਜਾਨ ਦੇ ਦਿਆਂਗੀਆਂ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1170,
      "hindi": "",
      "hindiTransliteration": "नातर इही छेत्र पर मरिहै ॥२१॥",
      "sourceLineId": "128866",
      "sourceShabadId": "12198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
