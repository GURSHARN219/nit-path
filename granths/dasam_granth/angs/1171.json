{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1171,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1171_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਹਤ ਦੈਤਜਾ ਹਮ ਹੀ ਬਰਿ ਹੈਂ ॥",
      "transliteration": "kahat dhaitajaa ham hee bar hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤਾ ਦੀਆਂ ਧੀਆਂ ਕਹਿਣ ਲਗੀਆਂ ਕਿ ਅਸੀਂ ਹੀ ਵਰਾਗੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "कहत दैतजा हम ही बरि हैं ॥",
      "sourceLineId": "128867",
      "sourceShabadId": "12198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੇਵ ਸੁਤਾ ਭਾਖੈ ਹਮ ਕਰਿ ਹੈਂ ॥",
      "transliteration": "dhev sutaa bhaakhai ham kar hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੇਵਤਿਆਂ ਦੀਆਂ ਪੁੱਤਰੀਆਂ ਕਹਿੰਦੀਆਂ ਕਿ ਅਸੀਂ ਵਿਆਹ ਕਰਾਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "देव सुता भाखै हम करि हैं ॥",
      "sourceLineId": "128868",
      "sourceShabadId": "12198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਛ ਕਿੰਨ੍ਰਜਾ ਕਹਿ ਹਮ ਲੈ ਹੈਂ ॥",
      "transliteration": "jachh ki(n)nrajaa keh ham lai hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਯਕਸ਼ ਅਤੇ ਕਿੰਨਰਾ ਦੀ ਜਾਈਆਂ ਕਹਿੰਦੀਆਂ ਕਿ ਅਸੀਂ ਪ੍ਰਾਪਤ ਕਰਾਗੀਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "जछ किंन्रजा कहि हम लै हैं ॥",
      "sourceLineId": "128869",
      "sourceShabadId": "12198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾਤਰ ਪਿਯ ਕਾਰਨ ਜਿਯ ਦੈ ਹੈਂ ॥੨੨॥",
      "transliteration": "naatar piy kaaran jiy dhai hai(n) ||22||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਪ੍ਰਿਯ ਲਈ ਆਪਣੀਆਂ ਜਾਨਾ ਦੇ ਦਿਆਂਗੀਆਂ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "नातर पिय कारन जिय दै हैं ॥२२॥",
      "sourceLineId": "128870",
      "sourceShabadId": "12198",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128871",
      "sourceShabadId": "12199",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਛ ਗੰਧ੍ਰਬੀ ਕਿੰਨ੍ਰਨੀ ਲਖਿ ਛਬਿ ਗਈ ਬਿਕਾਇ ॥",
      "transliteration": "jachh ga(n)dhrabee ki(n)nranee lakh chhab giee bikai ||",
      "translation": "",
      "punjabiViakhya": "ਯਕਸ਼, ਗੰਧਰਬ ਅਤੇ ਕਿੰਨਰ ਇਸਤਰੀਆਂ ਉਸ ਦੀ ਸੂਰਤ ਨੂੰ ਵੇਖ ਕੇ ਵਿਕ ਗਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "जछ गंध्रबी किंन्रनी लखि छबि गई बिकाइ ॥",
      "sourceLineId": "128872",
      "sourceShabadId": "12199",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੁਰੀ ਆਸੁਰੀ ਨਾਗਨੀ ਨੈਨਨ ਰਹੀ ਲਗਾਇ ॥੨੩॥",
      "transliteration": "suree aasuree naaganee nainan rahee lagai ||23||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤਿਆਂ, ਦੈਂਤਾ, ਨਾਗਾ ਦੀਆਂ ਇਸਤਰੀਆਂ ਨੈਣਾ ਨਾਲ ਨੈਣ ਲਗਾ ਕੇ (ਟਿਕ ਗਈਆਂ) ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "सुरी आसुरी नागनी नैनन रही लगाइ ॥२३॥",
      "sourceLineId": "128873",
      "sourceShabadId": "12199",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128874",
      "sourceShabadId": "12200",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਇਕ ਤ੍ਰਿਯ ਰੂਪ ਬਿਸਨ ਕੋ ਧਰਾ ॥",
      "transliteration": "eik tiray roop bisan ko dharaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਇਸਤਰੀ ਨੇ ਵਿਸ਼ਣੂ ਦਾ ਰੂਪ ਧਾਰਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "इक तृय रूप बिसन को धरा ॥",
      "sourceLineId": "128875",
      "sourceShabadId": "12200",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਏਕਨ ਰੂਪ ਬ੍ਰਹਮਾ ਕੋ ਕਰਾ ॥",
      "transliteration": "ekan roop brahamaa ko karaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਨੇ ਬ੍ਰਹਮਾ ਦਾ ਰੂਪ ਬਣਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "एकन रूप ब्रहमा को करा ॥",
      "sourceLineId": "128876",
      "sourceShabadId": "12200",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਕ ਤ੍ਰਿਯ ਭੇਸ ਰੁਦ੍ਰ ਕੋ ਧਾਰਿਯੋ ॥",
      "transliteration": "eik tiray bhes rudhr ko dhaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਇਸਤਰੀ ਨੇ ਰੁਦ੍ਰ ਦਾ ਰੂਪ ਧਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "इक तृय भेस रुद्र को धारियो ॥",
      "sourceLineId": "128877",
      "sourceShabadId": "12200",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਇਕਨ ਧਰਮ ਕੋ ਰੂਪ ਸੁਧਾਰਿਯੋ ॥੨੪॥",
      "transliteration": "eikan dharam ko roop sudhaariyo ||24||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਨੇ ਧਰਮ ਰਾਜ ਦਾ ਰੂਪ ਸੰਵਾਰਿਆ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "इकन धरम को रूप सुधारियो ॥२४॥",
      "sourceLineId": "128878",
      "sourceShabadId": "12200",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਏਕੈ ਭੇਸ ਇੰਦ੍ਰ ਕੋ ਕਿਯਾ ॥",
      "transliteration": "ekai bhes i(n)dhr ko kiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਨੇ ਇੰਦਰ ਦਾ ਭੇਸ ਬਣਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "एकै भेस इंद्र को किया ॥",
      "sourceLineId": "128879",
      "sourceShabadId": "12200",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਏਕਨ ਰੂਪ ਸੂਰਜ ਕੋ ਲਿਯਾ ॥",
      "transliteration": "ekan roop sooraj ko liyaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਨੇ ਸੂਰਜ ਦੀ ਸ਼ਕਲ ਸੰਵਾਰ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "एकन रूप सूरज को लिया ॥",
      "sourceLineId": "128880",
      "sourceShabadId": "12200",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਏਕਨ ਭੇਸ ਚੰਦ੍ਰ ਕੌ ਧਾਰਿਯੋ ॥",
      "transliteration": "ekan bhes cha(n)dhr kau dhaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਨੇ ਚੰਦ੍ਰਮਾ ਦਾ ਭੇਸ ਧਾਰਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "एकन भेस चंद्र कौ धारियो ॥",
      "sourceLineId": "128881",
      "sourceShabadId": "12200",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਨਹੁ ਮਦਨ ਕੌ ਮਾਨ ਉਤਾਰਿਯੋ ॥੨੫॥",
      "transliteration": "manahu madhan kau maan utaariyo ||25||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਕਾਮ ਦੇਵ ਦਾ ਹੰਕਾਰ ਤੋੜ ਦਿੱਤਾ ਹੋਵੇ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "मनहु मदन कौ मान उतारियो ॥२५॥",
      "sourceLineId": "128882",
      "sourceShabadId": "12200",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "128883",
      "sourceShabadId": "12201",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਾਤ ਕੁਮਾਰੀ ਚਲੀ ਭੇਸ ਇਹ ਧਾਰਿ ਕੈ ॥",
      "transliteration": "saat kumaaree chalee bhes ieh dhaar kai ||",
      "translation": "",
      "punjabiViakhya": "ਸੱਤ ਕੁਮਾਰੀਆਂ ਇਸ ਪ੍ਰਕਾਰ ਦਾ ਰੂਪ ਧਾਰਨ ਕਰ ਕੇ ਚਲੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "सात कुमारी चली भेस इह धारि कै ॥",
      "sourceLineId": "128884",
      "sourceShabadId": "12201",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਵਾ ਰਾਜਾ ਕਹ ਦਰਸਨ ਦੀਯਾ ਸੁਧਾਰਿ ਕੈ ॥",
      "transliteration": "vaa raajaa keh dharasan dheeyaa sudhaar kai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਰਾਜੇ ਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਦਰਸ਼ਨ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "वा राजा कह दरसन दीया सुधारि कै ॥",
      "sourceLineId": "128885",
      "sourceShabadId": "12201",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਾਤ ਸੁਤਾ ਰਾਜਾ ਹਮਰੀ ਏ ਬਰੁ ਅਬੈ ॥",
      "transliteration": "saat sutaa raajaa hamaree e bar abai ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ) ਹੇ ਰਾਜਨ! ਸਾਡੀਆਂ ਇਨ੍ਰਹਾ ਸੱਤ ਪੁੱਤਰੀਆਂ ਨਾਲ ਹੁਣੇ ਵਿਆਹ ਕਰ ਲਵੋ",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "सात सुता राजा हमरी ए बरु अबै ॥",
      "sourceLineId": "128886",
      "sourceShabadId": "12201",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹੋ ਰਾਜ ਪਾਟ ਪੁਨਿ ਕਰਹੁ ਜੀਤਿ ਖਲ ਦਲ ਸਭੈ ॥੨੬॥",
      "transliteration": "ho raaj paaT pun karahu jeet khal dhal sabhai ||26||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਸਾਰੇ ਵੈਰੀਆਂ ਦੇ ਦਲਾ ਨੂੰ ਜਿਤ ਕੇ ਰਾਜ-ਪਾਟ ਕਰੋ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "हो राज पाट पुनि करहु जीति खल दल सभै ॥२६॥",
      "sourceLineId": "128887",
      "sourceShabadId": "12201",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128888",
      "sourceShabadId": "12202",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਬ ਰਾਜੈ ਉਨ ਰੂਪ ਨਿਹਰਾ ॥",
      "transliteration": "jab raajai un roop niharaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਉਨ੍ਰਹਾ ਦਾ ਰੂਪ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "जब राजै उन रूप निहरा ॥",
      "sourceLineId": "128889",
      "sourceShabadId": "12202",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਟਪਟਾਇ ਪਾਇਨ ਪਰ ਪਰਾ ॥",
      "transliteration": "saTapaTai pain par paraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੁਰਤ ਪੈਰਾ ਉਤੇ ਪੈ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "सटपटाइ पाइन पर परा ॥",
      "sourceLineId": "128890",
      "sourceShabadId": "12202",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਧਕ ਧਕ ਅਧਿਕ ਹ੍ਰਿਦੈ ਤਿਹ ਭਈ ॥",
      "transliteration": "dhak dhak adhik hiradhai teh bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਹਿਰਦੇ ਵਿਚ ਬਹੁਤ ਧਕ ਧਕ ਹੋਣ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "धक धक अधिक हृदै तिह भई ॥",
      "sourceLineId": "128891",
      "sourceShabadId": "12202",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਚਟਪਟ ਸਕਲ ਬਿਸਰ ਸੁਧਿ ਗਈ ॥੨੭॥",
      "transliteration": "chaTapaT sakal bisar sudh giee ||27||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਝਟਪਟ (ਉਸ ਦੀ) ਸਾਰੀ ਹੋਸ਼ ਗੁੰਮ ਹੋ ਗਈ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "चटपट सकल बिसर सुधि गई ॥२७॥",
      "sourceLineId": "128892",
      "sourceShabadId": "12202",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਧੀਰਜ ਧਰਾ ਜਬੈ ਸੁਧਿ ਆਈ ॥",
      "transliteration": "dheeraj dharaa jabai sudh aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜਦ ਹੋਸ਼ ਆਈ ਤਾ ਧੀਰਜ ਧਾਰਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "धीरज धरा जबै सुधि आई ॥",
      "sourceLineId": "128893",
      "sourceShabadId": "12202",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪੁਨਿ ਪਾਇਨ ਲਪਟਾਨਾ ਧਾਈ ॥",
      "transliteration": "pun pain lapaTaanaa dhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ (ਉਨ੍ਰਹਾ ਦੇ) ਚਰਨਾ ਨੂੰ ਪਕੜਨ ਲਈ ਅਗੇ ਵਧਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "पुनि पाइन लपटाना धाई ॥",
      "sourceLineId": "128894",
      "sourceShabadId": "12202",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਧੰਨਿ ਧੰਨਿ ਭਾਗ ਹਮਾਰੇ ਭਏ ॥",
      "transliteration": "dha(n)n dha(n)n bhaag hamaare bhe ||",
      "translation": "",
      "punjabiViakhya": "(ਨਾਲ ਹੀ ਕਹਿਣ ਲਗਾ ਕਿ) ਮੇਰੇ ਧੰਨ ਭਾਗ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "धंनि धंनि भाग हमारे भए ॥",
      "sourceLineId": "128895",
      "sourceShabadId": "12202",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਭ ਦੇਵਨ ਦਰਸਨ ਮੁਹਿ ਦਏ ॥੨੮॥",
      "transliteration": "sabh dhevan dharasan muh dhe ||28||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸਾਰਿਆਂ ਦੇਵਤਿਆਂ ਨੇ ਮੈਨੂੰ ਦਰਸ਼ਨ ਦਿੱਤਾ ਹੈ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "सभ देवन दरसन मुहि दए ॥२८॥",
      "sourceLineId": "128896",
      "sourceShabadId": "12202",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128897",
      "sourceShabadId": "12203",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪਾਪੀ ਤੇ ਧਰਮੀ ਭਯੋ ਚਰਨ ਤਿਹਾਰੇ ਲਾਗ ॥",
      "transliteration": "paapee te dharamee bhayo charan tihaare laag ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਤੁਹਾਡੇ ਚਰਨਾ ਨਾਲ ਲਗ ਕੇ ਪਾਪੀ ਤੋਂ ਧਰਮੀ ਹੋ ਗਿਆ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "पापी ते धरमी भयो चरन तिहारे लाग ॥",
      "sourceLineId": "128898",
      "sourceShabadId": "12203",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਰੰਕ ਹੁਤੋ ਰਾਜਾ ਭਯੋ ਧੰਨ੍ਯ ਹਮਾਰੇ ਭਾਗ ॥੨੯॥",
      "transliteration": "ra(n)k huto raajaa bhayo dha(n)nay hamaare bhaag ||29||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਰੰਕ (ਨਿਰਧਨ) ਸਾ, (ਹੁਣ) ਰਾਜਾ ਬਣ ਗਿਆ ਹਾ। (ਸਚਮੁਚ) ਮੇਰੇ ਧੰਨ ਭਾਗ ਹਨ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "रंक हुतो राजा भयो धंन्य हमारे भाग ॥२९॥",
      "sourceLineId": "128899",
      "sourceShabadId": "12203",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128900",
      "sourceShabadId": "12204",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮੈ ਸੁਈ ਕਰੌ ਜੁ ਤੁਮ ਮੁਹਿ ਭਾਖੌ ॥",
      "transliteration": "mai suiee karau ju tum muh bhaakhau ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਉਹੀ (ਕੰਮ) ਕਰਾਗਾ, ਜੋ ਤੁਸੀਂ ਮੈਨੂੰ ਕਹੋਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "मै सुई करौ जु तुम मुहि भाखौ ॥",
      "sourceLineId": "128901",
      "sourceShabadId": "12204",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚਰਨਨ ਧ੍ਯਾਨ ਤਿਹਾਰੇ ਰਾਖੌ ॥",
      "transliteration": "charanan dhayaan tihaare raakhau ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ ਸਦਾ) ਤੁਹਾਡੇ ਚਰਨਾ ਵਿਚ ਧਿਆਨ ਰਖਾਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "चरनन ध्यान तिहारे राखौ ॥",
      "sourceLineId": "128902",
      "sourceShabadId": "12204",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਥ ਸਨਾਥ ਅਨਾਥਹਿ ਕਿਯਾ ॥",
      "transliteration": "naath sanaath anaatheh kiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਨਾਥ! (ਤੁਸੀਂ ਮੈਨੂੰ) ਅਨਾਥ ਤੋਂ ਸਨਾਥ ਕਰ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "नाथ सनाथ अनाथहि किया ॥",
      "sourceLineId": "128903",
      "sourceShabadId": "12204",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਕਰੀ ਦਰਸਨ ਮੁਹਿ ਦਿਯਾ ॥੩੦॥",
      "transliteration": "kirapaa karee dharasan muh dhiyaa ||30||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰਿਪਾ ਕਰ ਕੇ ਮੈਨੂੰ ਦਰਸ਼ਨ ਦਿੱਤਾ ਹੈ ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "कृपा करी दरसन मुहि दिया ॥३०॥",
      "sourceLineId": "128904",
      "sourceShabadId": "12204",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਯੌ ਬਚ ਸੁਨਿ ਲੋਪਿਤ ਤੇ ਭਈ ॥",
      "transliteration": "yau bach sun lopit te bhiee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਦੀ) ਇਹ ਗੱਲ ਸੁਣ ਕੇ ਉਹ ਅਲੋਪ ਹੋ ਗਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "यौ बच सुनि लोपित ते भई ॥",
      "sourceLineId": "128905",
      "sourceShabadId": "12204",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹ੍ਵੈ ਕਰ ਸਾਤ ਕੁਮਾਰੀ ਗਈ ॥",
      "transliteration": "havai kar saat kumaaree giee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਫਿਰ) ਸੱਤ ਕੁਮਾਰੀਆਂ ਬਣ ਕੇ ਆ ਗਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "ह्वै कर सात कुमारी गई ॥",
      "sourceLineId": "128906",
      "sourceShabadId": "12204",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚਲਿ ਕਰਿ ਤੀਰ ਨ੍ਰਿਪਤਿ ਕੇ ਆਈ ॥",
      "transliteration": "chal kar teer nirapat ke aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਚਲ ਕੇ ਰਾਜੇ ਕੋਲ ਆਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "चलि करि तीर नृपति के आई ॥",
      "sourceLineId": "128907",
      "sourceShabadId": "12204",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਹਿਯੋ ਆਜੁ ਮੁਹਿ ਬਰੋ ਇਹਾਈ ॥੩੧॥",
      "transliteration": "kahiyo aaj muh baro ihaiee ||31||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਹਿਣ ਲਗੀਆਂ ਕਿ ਅਜ ਸਾਡੇ ਨਾਲ ਇਥੇ ਹੀ ਵਿਆਹ ਕਰੋ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "कहियो आजु मुहि बरो इहाई ॥३१॥",
      "sourceLineId": "128908",
      "sourceShabadId": "12204",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128909",
      "sourceShabadId": "12205",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਯੌ ਜਬ ਤਿਨ ਉਚਰੇ ਬਚਨ ਕਛੁ ਨ ਲਹਾ ਅਗ੍ਯਾਨ ॥",
      "transliteration": "yau jab tin uchare bachan kachh na lahaa agayaan ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਉਨ੍ਰਹਾ (ਕੁਮਾਰੀਆਂ) ਨੇ ਇਹ ਬਚਨ ਕਹੇ, (ਤਾ ਉਹ) ਮੂਰਖ ਕੁਝ ਨਾ ਸਮਝ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "यौ जब तिन उचरे बचन कछु न लहा अग्यान ॥",
      "sourceLineId": "128910",
      "sourceShabadId": "12205",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਿਹ ਕਹ ਤੁਰਤ ਬਰਤ ਭਯੋ ਬਚ ਕਰਿ ਸੁਰਨ ਪ੍ਰਮਾਨ ॥੩੨॥",
      "transliteration": "teh keh turat barat bhayo bach kar suran pramaan ||32||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤਿਆਂ ਦੇ ਬਚਨ ਨੂੰ ਪ੍ਰਮਾਣਿਤ ਮੰਨ ਕੇ ਉਨ੍ਰਹਾ ਨਾਲ ਤੁਰਤ ਵਿਆਹ ਕਰ ਲਿਆ ॥੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "तिह कह तुरत बरत भयो बच करि सुरन प्रमान ॥३२॥",
      "sourceLineId": "128911",
      "sourceShabadId": "12205",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128912",
      "sourceShabadId": "12206",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਬ ਤਿਹ ਠੌਰ ਬਧਾਈ ਬਾਜੀ ॥",
      "transliteration": "tab teh Thauar badhaiee baajee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਸਥਾਨ ਉਤੇ ਵਧਾਈ ਦੇ ਵਾਜੇ ਵਜੇ",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "तब तिह ठौर बधाई बाजी ॥",
      "sourceLineId": "128913",
      "sourceShabadId": "12206",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1171_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੁਰੀ ਆਸੁਰੀ ਜਹਾ ਬਿਰਾਜੀ ॥",
      "transliteration": "suree aasuree jahaa biraajee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਦੇਵਤਿਆਂ ਅਤੇ ਦੈਂਤਾ ਦੀਆਂ ਇਸਤਰੀਆਂ ਬੈਠੀਆਂ ਹੋਈਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1171,
      "hindi": "",
      "hindiTransliteration": "सुरी आसुरी जहा बिराजी ॥",
      "sourceLineId": "128914",
      "sourceShabadId": "12206",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
