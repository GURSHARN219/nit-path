{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1173,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1173_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੁਨਤ ਬਚਨ ਸਹਚਰਿ ਚਤੁਰਿ ਤਹਾ ਪਹੂਚੀ ਜਾਇ ॥",
      "transliteration": "sunat bachan sahachar chatur tahaa pahoochee jai ||",
      "translation": "",
      "punjabiViakhya": "(ਕੁਮਾਰੀ ਦੇ) ਬਚਨ ਸੁਣ ਕੇ ਚਤੁਰ ਸਖੀ ਉਥੇ ਜਾ ਪਹੁੰਚੀ",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "सुनत बचन सहचरि चतुरि तहा पहूची जाइ ॥",
      "sourceLineId": "128963",
      "sourceShabadId": "12211",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਹ ਮਨਿ ਤਿਲਕ ਨ੍ਰਿਪਤਿ ਚੜਾ ਆਖੇਟਕਹਿ ਬਨਾਇ ॥੧੦॥",
      "transliteration": "jeh man tilak nirapat chaRaa aakheTakeh banai ||10||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਤਿਲਕ ਮਨਿ ਰਾਜਾ ਸ਼ਿਕਾਰ ਲਈ ਚੜ੍ਰਹਿਆ ਹੋਇਆ ਸੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "जह मनि तिलक नृपति चड़ा आखेटकहि बनाइ ॥१०॥",
      "sourceLineId": "128964",
      "sourceShabadId": "12211",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128965",
      "sourceShabadId": "12212",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਹਚਰਿ ਤਹਾ ਪਹੂੰਚਿਤ ਭਈ ॥",
      "transliteration": "sahachar tahaa pahoo(n)chit bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਸਖੀ ਉਥੇ ਜਾ ਪਹੁੰਚੀ",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "सहचरि तहा पहूँचित भई ॥",
      "sourceLineId": "128966",
      "sourceShabadId": "12212",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨ੍ਰਿਪ ਆਗਮਨ ਜਹਾ ਸੁਨਿ ਲਈ ॥",
      "transliteration": "nirap aagaman jahaa sun liee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਰਾਜੇ ਦੇ ਆਉਣ ਬਾਰੇ ਸੁਣ ਲਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "नृप आगमन जहा सुनि लई ॥",
      "sourceLineId": "128967",
      "sourceShabadId": "12212",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅੰਗ ਅੰਗ ਸੁਭ ਸਜੇ ਸਿੰਗਾਰਾ ॥",
      "transliteration": "a(n)g a(n)g subh saje si(n)gaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਸਖੀ ਦੇ) ਅੰਗ ਅੰਗ ਸੁੰਦਰ ਸ਼ਿੰਗਾਰ ਨਾਲ ਸੱਜੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "अंग अंग सुभ सजे सिंगारा ॥",
      "sourceLineId": "128968",
      "sourceShabadId": "12212",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਨੁ ਨਿਸਪਤਿ ਸੌਭਿਤ ਜੁਤ ਤਾਰਾ ॥੧੧॥",
      "transliteration": "jan nisapat sauabhit jut taaraa ||11||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਤਾਰਿਆਂ ਵਿਚ ਚੰਦ੍ਰਮਾ ਸ਼ੋਭਦਾ ਹੋਵੇ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "जनु निसपति सौभित जुत तारा ॥११॥",
      "sourceLineId": "128969",
      "sourceShabadId": "12212",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੀਸ ਫੂਲ ਸਿਰ ਪਰ ਤ੍ਰਿਯ ਝਾਰਾ ॥",
      "transliteration": "sees fool sir par tiray jhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਸਿਰ ਉਤੇ ਚੌਕ ਸਜਾਇਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "सीस फूल सिर पर तृय झारा ॥",
      "sourceLineId": "128970",
      "sourceShabadId": "12212",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਰਨ ਫੂਲ ਦੁਹੂੰ ਕਰਨ ਸੁ ਧਾਰਾ ॥",
      "transliteration": "karan fool dhuhoo(n) karan su dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕੰਨਾ ਵਿਚ ਦੋ ਕਰਨ-ਫੂਲ ਧਾਰਨ ਕੀਤੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "करन फूल दुहूँ करन सु धारा ॥",
      "sourceLineId": "128971",
      "sourceShabadId": "12212",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮੋਤਿਨ ਕੀ ਮਾਲਾ ਕੋ ਧਰਾ ॥",
      "transliteration": "motin kee maalaa ko dharaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੋਤੀਆਂ ਦੀ ਮਾਲਾ ਪਾਈ ਹੋਈ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "मोतिन की माला को धरा ॥",
      "sourceLineId": "128972",
      "sourceShabadId": "12212",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮੋਤਿਨ ਹੀ ਸੋ ਮਾਗਹਿ ਭਰਾ ॥੧੨॥",
      "transliteration": "motin hee so maageh bharaa ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੋਤੀਆਂ ਨਾਲ ਹੀ ਮਾਗ ਭਰੀ ਹੋਈ ਸੀ (ਭਾਵ-ਮੀਢੀਆਂ ਵਿਚ ਮੋਤੀ ਗੁੰਦੇ ਹੋਏ ਸਨ) ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "मोतिन ही सो मागहि भरा ॥१२॥",
      "sourceLineId": "128973",
      "sourceShabadId": "12212",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਭ ਭੂਖਨ ਮੋਤਿਨ ਕੇ ਧਾਰੇ ॥",
      "transliteration": "sabh bhookhan motin ke dhaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸਾਰੇ ਗਹਿਣੇ ਮੋਤੀਆਂ ਦੇ ਹੀ ਪਾਏ ਹੋਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "सभ भूखन मोतिन के धारे ॥",
      "sourceLineId": "128974",
      "sourceShabadId": "12212",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਿਨ ਮਹਿ ਬਜ੍ਰ ਲਾਲ ਗੁਹਿ ਡਾਰੇ ॥",
      "transliteration": "jin meh bajr laal guh ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਵਿਚ ਲਾਲ ਹੀਰੇ ('ਬਜ੍ਰ') ਗੁੰਦੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "जिन महि बज्र लाल गुहि डारे ॥",
      "sourceLineId": "128975",
      "sourceShabadId": "12212",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨੀਲ ਹਰਿਤ ਮਨਿ ਪ੍ਰੋਈ ਭਲੀ ॥",
      "transliteration": "neel harit man proiee bhalee ||",
      "translation": "",
      "punjabiViakhya": "ਨੀਲੀਆਂ ਅਤੇ ਹਰੀਆਂ ਮਣੀਆਂ ਚੰਗੀ ਤਰ੍ਰਹਾ ਪਰੋਈਆਂ ਹੋਈਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "नील हरित मनि प्रोई भली ॥",
      "sourceLineId": "128976",
      "sourceShabadId": "12212",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਨੁ ਤੇ ਹਸਿ ਉਡਗਨ ਕਹ ਚਲੀ ॥੧੩॥",
      "transliteration": "jan te has uddagan keh chalee ||13||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਹੱਸ ਕੇ ਤਾਰਿਆਂ ਕੋਲ ਚਲੀਆਂ ਹੋਣ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "जनु ते हसि उडगन कह चली ॥१३॥",
      "sourceLineId": "128977",
      "sourceShabadId": "12212",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਬ ਰਾਜੈ ਵਾ ਤ੍ਰਿਯ ਕੋ ਲਹਾ ॥",
      "transliteration": "jab raajai vaa tiray ko lahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਉਸ ਇਸਤਰੀ ਨੂੰ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "जब राजै वा तृय को लहा ॥",
      "sourceLineId": "128978",
      "sourceShabadId": "12212",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਨ ਮਹਿ ਅਧਿਕ ਚਕ੍ਰਿਤ ਹ੍ਵੈ ਰਹਾ ॥",
      "transliteration": "man meh adhik chakirat havai rahaa ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ) ਮਨ ਵਿਚ ਬਹੁਤ ਹੈਰਾਨ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "मन महि अधिक चकृत ह्वै रहा ॥",
      "sourceLineId": "128979",
      "sourceShabadId": "12212",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦੇਵ ਅਦੇਵ ਜਛ ਗੰਧ੍ਰਬਜਾ ॥",
      "transliteration": "dhev adhev jachh ga(n)dhrabajaa ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ ਸੋਚੀਂ ਪੈ ਗਿਆ ਕਿ) ਕੀ ਇਹ ਦੇਵ, ਦੈਂਤ, ਯਕਸ਼ ਜਾ ਗੰਧਰਬ ਕੰਨਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "देव अदेव जछ गंध्रबजा ॥",
      "sourceLineId": "128980",
      "sourceShabadId": "12212",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਰੀ ਨਾਗਨੀ ਸੁਰੀ ਪਰੀਜਾ ॥੧੪॥",
      "transliteration": "naree naaganee suree pareejaa ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਥਵਾ ਨਰੀ, ਨਾਗਨੀ, ਸੁਰੀ ਜਾ ਪਰੀ ਦੀ ਜਾਈ ਹੈ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "नरी नागनी सुरी परीजा ॥१४॥",
      "sourceLineId": "128981",
      "sourceShabadId": "12212",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128982",
      "sourceShabadId": "12213",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨ੍ਰਿਪ ਚਿਤ੍ਰਯੋ ਇਹ ਪੂਛੀਯੈ ਕ੍ਯੋ ਆਈ ਇਹ ਦੇਸ ॥",
      "transliteration": "nirap chitrayo ieh poochheeyai kayo aaiee ieh dhes ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਇਹ ਸੋਚਿਆ ਕਿ ਇਸ ਨੂੰ ਪੁਛਿਆ ਜਾਵੇ ਕਿ ਇਸ ਦੇਸ ਵਿਚ ਕਿਸ ਲਈ ਆਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "नृप चित्रयो इह पूछीयै क्यो आई इह देस ॥",
      "sourceLineId": "128983",
      "sourceShabadId": "12213",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੂਰ ਸੁਤਾ ਕੈ ਚੰਦ੍ਰਜਾ ਕੈ ਦੁਹਿਤਾ ਅਲਿਕੇਸ ॥੧੫॥",
      "transliteration": "soor sutaa kai cha(n)dhrajaa kai dhuhitaa alikes ||15||",
      "translation": "",
      "punjabiViakhya": "ਕੀ ਇਹ ਸੂਰਜ ਦੀ ਪੁੱਤਰੀ, ਜਾ ਚੰਦ੍ਰਮਾ ਦੀ ਧੀ ਜਾ ਕੁਬੇਰ ਦੀ ਲੜਕੀ ਹੈ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "सूर सुता कै चंद्रजा कै दुहिता अलिकेस ॥१५॥",
      "sourceLineId": "128984",
      "sourceShabadId": "12213",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128985",
      "sourceShabadId": "12214",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚਲਿਯੋ ਚਲਿਯੋ ਤਾ ਕੇ ਤਟ ਗਯੋ ॥",
      "transliteration": "chaliyo chaliyo taa ke taT gayo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ) ਚਲਦਾ ਚਲਦਾ ਉਸ ਦੇ ਕੋਲ ਜਾ ਪਹੁੰਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "चलियो चलियो ता के तट गयो ॥",
      "sourceLineId": "128986",
      "sourceShabadId": "12214",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਲਖਿ ਦੁਤਿ ਤਿਹ ਅਤਿ ਰੀਝਤ ਭਯੋ ॥",
      "transliteration": "lakh dhut teh at reejhat bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਨੂੰ ਵੇਖ ਕੇ ਮੋਹਿਤ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "लखि दुति तिह अति रीझत भयो ॥",
      "sourceLineId": "128987",
      "sourceShabadId": "12214",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰੂਪ ਨਿਰਖਿ ਰਹਿਯੋ ਉਰਝਾਈ ॥",
      "transliteration": "roop nirakh rahiyo urajhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਰੂਪ ਵੇਖ ਕੇ ਅਟਕ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "रूप निरखि रहियो उरझाई ॥",
      "sourceLineId": "128988",
      "sourceShabadId": "12214",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਵਨ ਦੇਵ ਦਾਨੋ ਇਹ ਜਾਈ ॥੧੬॥",
      "transliteration": "kavan dhev dhaano ieh jaiee ||16||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਸੋਚਣ ਲਗਾ ਕਿ) ਇਹ ਕਿਸ ਦੇਵਤੇ ਜਾ ਦੈਂਤ ਦੀ ਪੈਦਾ ਕੀਤੀ ਹੋਈ ਹੈ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "कवन देव दानो इह जाई ॥१६॥",
      "sourceLineId": "128989",
      "sourceShabadId": "12214",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮੋਤਿਨ ਮਾਲ ਬਾਲ ਤਿਨ ਲਈ ॥",
      "transliteration": "motin maal baal tin liee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਨੇ ਮੋਤੀਆਂ ਦੀ ਮਾਲਾ ਲਈ ਹੋਈ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "मोतिन माल बाल तिन लई ॥",
      "sourceLineId": "128990",
      "sourceShabadId": "12214",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਿਹ ਭੀਤਰਿ ਪਤਿਯਾ ਗੁਹਿ ਗਈ ॥",
      "transliteration": "jeh bheetar patiyaa guh giee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਿਚ ਉਹ ਚਿੱਠੀ ਗੁੰਦ ਕੇ ਲੈ ਗਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "जिह भीतरि पतिया गुहि गई ॥",
      "sourceLineId": "128991",
      "sourceShabadId": "12214",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਹਿਯੋ ਕਿ ਜੈਸੀ ਮੁਝਹਿ ਨਿਹਾਰਹੁ ॥",
      "transliteration": "kahiyo k jaisee mujheh nihaarahu ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗੀ ਕਿ) ਜਿਹੋ ਜਿਹੀ (ਤੁਸੀਂ) ਮੈਨੂੰ ਵੇਖਦੇ ਹੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "कहियो कि जैसी मुझहि निहारहु ॥",
      "sourceLineId": "128992",
      "sourceShabadId": "12214",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤੈਸਿਯੈ ਤਿਹ ਨ੍ਰਿਪ ਸਹਸ ਬਿਚਾਰਹੁ ॥੧੭॥",
      "transliteration": "taisiyai teh nirap sahas bichaarahu ||17||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਉਸ ਨੂੰ ਮੇਰੇ ਨਾਲ ਹਜ਼ਾਰ ਗੁਣਾ ਅਧਿਕ (ਸੁੰਦਰ) ਸਮਝੋ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "तैसियै तिह नृप सहस बिचारहु ॥१७॥",
      "sourceLineId": "128993",
      "sourceShabadId": "12214",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "128994",
      "sourceShabadId": "12215",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨ੍ਰਿਪ ਬਰ ਬਾਲ ਬਿਲੋਕਿ ਛਬਿ ਮੋਹਿ ਰਹਾ ਸਰਬੰਗ ॥",
      "transliteration": "nirap bar baal bilok chhab moh rahaa saraba(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਉਸ ਉਤਮ ਇਸਤਰੀ ਦੀ ਸੁੰਦਰਤਾ ਨੂੰ ਵੇਖ ਕੇ ਸਭ ਤਰ੍ਰਹਾ ਨਾਲ ਮੋਹਿਤ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "नृप बर बाल बिलोकि छबि मोहि रहा सरबंग ॥",
      "sourceLineId": "128995",
      "sourceShabadId": "12215",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੁਧਿ ਗ੍ਰਿਹ ਕੀ ਬਿਸਰੀ ਸਭੈ ਚਲਤ ਭਯੋ ਤਿਹ ਸੰਗ ॥੧੮॥",
      "transliteration": "sudh gireh kee bisaree sabhai chalat bhayo teh sa(n)g ||18||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਘਰ ਦੀ ਸਾਰੀ ਸੁਰਤ ਭੁਲ ਗਈ ਅਤੇ ਉਸ ਦੇ ਨਾਲ ਚਲ ਪਿਆ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "सुधि गृह की बिसरी सभै चलत भयो तिह संग ॥१८॥",
      "sourceLineId": "128996",
      "sourceShabadId": "12215",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "128997",
      "sourceShabadId": "12216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਲਾਲ ਮਾਲ ਕੌ ਬਹੁਰਿ ਨਿਕਾਰਾ ॥",
      "transliteration": "laal maal kau bahur nikaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਫਿਰ ਲਾਲਾ ਦੀ ਮਾਲਾ ਨੂੰ ਕਢਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "लाल माल कौ बहुरि निकारा ॥",
      "sourceLineId": "128998",
      "sourceShabadId": "12216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪਤਿਯਾ ਛੋਰਿ ਬਾਚਿ ਸਿਰ ਝਾਰਾ ॥",
      "transliteration": "patiyaa chhor baach sir jhaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਉਸ ਵਿਚੋਂ) ਚਿੱਠੀ ਖੋਲ ਕੇ ਪੜ੍ਰਹੀ ਅਤੇ ਸਿਰ ਨੂੰ ਹਿਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "पतिया छोरि बाचि सिर झारा ॥",
      "sourceLineId": "128999",
      "sourceShabadId": "12216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੋ ਸਰੂਪ ਦੀਯੋ ਬਿਧਿ ਯਾ ਕੇ ॥",
      "transliteration": "jo saroop dheeyo bidh yaa ke ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਸੋਚਿਆ) ਜੋ ਸਰੂਪ ਵਿਧਾਤਾ ਨੇ ਇਸ (ਇਸਤਰੀ) ਨੂੰ ਦਿੱਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "जो सरूप दीयो बिधि या के ॥",
      "sourceLineId": "129000",
      "sourceShabadId": "12216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤੈਸੀ ਸੁਨੀ ਸਾਤ ਸਤ ਵਾ ਕੇ ॥੧੯॥",
      "transliteration": "taisee sunee saat sat vaa ke ||19||",
      "translation": "",
      "punjabiViakhya": "ਅਜਿਹੀਆਂ ਉਸ ਕੋਲ ਸੱਤ ਸੌ ਸੁਣੀਂਦੀਆਂ ਹਨ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "तैसी सुनी सात सत वा के ॥१९॥",
      "sourceLineId": "129001",
      "sourceShabadId": "12216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਿਹ ਬਿਧਿ ਵਾ ਕੋ ਰੂਪ ਨਿਹਾਰੌ ॥",
      "transliteration": "keh bidh vaa ko roop nihaarau ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਸਰੂਪ ਕਿਸ ਤਰ੍ਰਹਾ ਵੇਖਾ",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "किह बिधि वा को रूप निहारौ ॥",
      "sourceLineId": "129002",
      "sourceShabadId": "12216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਫਲ ਜਨਮ ਕਰਿ ਤਦਿਨ ਬਿਚਾਰੌ ॥",
      "transliteration": "safal janam kar tadhin bichaarau ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦਿਨ ਤੋਂ ਆਪਣਾ ਜੀਵਨ ਸਫਲ ਸਮਝਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "सफल जनम करि तदिन बिचारौ ॥",
      "sourceLineId": "129003",
      "sourceShabadId": "12216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜੋ ਐਸੀ ਭੇਟਨ ਕਹ ਪਾਊ ॥",
      "transliteration": "jo aaisee bheTan keh paauoo ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਅਜਿਹੀ (ਇਸਤਰੀ) ਮਿਲ ਜਾਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "जो ऐसी भेटन कह पाऊ ॥",
      "sourceLineId": "129004",
      "sourceShabadId": "12216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਨ ਰਾਨਿਨ ਫਿਰਿ ਮੁਖ ਨ ਦਿਖਾਊ ॥੨੦॥",
      "transliteration": "ein raanin fir mukh na dhikhaauoo ||20||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਨ੍ਰਹਾ ਰਾਣੀਆਂ ਨੂੰ ਫਿਰ ਮੁਖ ਵੀ ਨਾ ਵਿਖਾਵਾ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "इन रानिन फिरि मुख न दिखाऊ ॥२०॥",
      "sourceLineId": "129005",
      "sourceShabadId": "12216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਵਹੀ ਬਾਟ ਤੇ ਉਹੀ ਸਿਧਾਯੋ ॥",
      "transliteration": "vahee baaT te uhee sidhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਰਸਤੇ ਉਸ ਵਲ ਚਲ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "वही बाट ते उही सिधायो ॥",
      "sourceLineId": "129006",
      "sourceShabadId": "12216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਵਨਿ ਤਰੁਨਿ ਕਹ ਰਥਹਿ ਚੜਾਯੋ ॥",
      "transliteration": "tavan tarun keh ratheh chaRaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਇਸਤਰੀ ਨੂੰ ਰਥ ਉਤੇ ਚੜ੍ਰਹਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "तवनि तरुनि कह रथहि चड़ायो ॥",
      "sourceLineId": "129007",
      "sourceShabadId": "12216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚਲਤ ਚਲਤ ਆਵਤ ਭਯੋ ਤਹਾ ॥",
      "transliteration": "chalat chalat aavat bhayo tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਚਲਦਾ ਚਲਦਾ ਉਥੇ ਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "चलत चलत आवत भयो तहा ॥",
      "sourceLineId": "129008",
      "sourceShabadId": "12216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਬਲਾ ਮਗਹਿ ਨਿਹਾਰਤ ਜਹਾ ॥੨੧॥",
      "transliteration": "abalaa mageh nihaarat jahaa ||21||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ (ਉਹ) ਇਸਤਰੀ ਵਾਟ ਜੋਹ ਰਹੀ ਸੀ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "अबला मगहि निहारत जहा ॥२१॥",
      "sourceLineId": "129009",
      "sourceShabadId": "12216",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1173_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "129010",
      "sourceShabadId": "12217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
