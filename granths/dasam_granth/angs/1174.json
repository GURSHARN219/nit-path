{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1174,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1174_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਜ ਸਾਜ ਸਭ ਤ੍ਯਾਗਿ ਕਰਿ ਭੇਖ ਅਤਿਥ ਬਨਾਇ ॥",
      "transliteration": "raaj saaj sabh tayaag kar bhekh atith banai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਸਾਰਾ ਰਾਜ-ਸਾਜ ਛਡ ਕੇ ਜੋਗੀ ਦਾ ਭੇਖ ਬਣਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "राज साज सभ त्यागि करि भेख अतिथ बनाइ ॥",
      "sourceLineId": "129011",
      "sourceShabadId": "12217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਵਨਿ ਝਰੋਖਾ ਕੇ ਤਰੇ ਬੈਠਿਯੋ ਧੂੰਆ ਲਾਇ ॥੨੨॥",
      "transliteration": "tavan jharokhaa ke tare baiThiyo dhoo(n)aa lai ||22||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੇ ਝਰੋਖੇ ਹੇਠਾ ਧੂੰਣੀ ਰਮਾ ਕੇ ਬੈਠ ਗਿਆ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "तवनि झरोखा के तरे बैठियो धूँआ लाइ ॥२२॥",
      "sourceLineId": "129012",
      "sourceShabadId": "12217",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "129013",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਭਿਛਾ ਲੈ ਆਵੈ ॥",
      "transliteration": "raaj sutaa bhichhaa lai aavai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ-ਪੁੱਤਰੀ ਭਿਖਿਆ ਲੈ ਕੇ ਆਉਾਂਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "राज सुता भिछा लै आवै ॥",
      "sourceLineId": "129014",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਾ ਕਹ ਅਪਨੇ ਹਾਥ ਜਿਵਾਵੈ ॥",
      "transliteration": "taa keh apane haath jivaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਆਪਣੇ ਹੱਥ ਨਾਲ ਖਵਾਉਾਂਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "ता कह अपने हाथ जिवावै ॥",
      "sourceLineId": "129015",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਿਸਿ ਕਹ ਲੋਗ ਜਬੈ ਸ੍ਵੈ ਜਾਹੀ ॥",
      "transliteration": "nis keh log jabai savai jaahee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਨੂੰ ਜਦ ਸਾਰੇ ਲੋਕ ਸੌਂ ਜਾਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "निसि कह लोग जबै स्वै जाही ॥",
      "sourceLineId": "129016",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਲਪਟਿ ਲਪਟਿ ਦੋਊ ਭੋਗ ਕਮਾਹੀ ॥੨੩॥",
      "transliteration": "lapaT lapaT dhouoo bhog kamaahee ||23||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਲਿਪਟ ਲਿਪਟ ਕੇ ਦੋਵੇਾਂ ਭੋਗ ਕਰਦੇ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "लपटि लपटि दोऊ भोग कमाही ॥२३॥",
      "sourceLineId": "129017",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਕੁਅਰਿ ਅਧਿਕ ਸੁਖ ਲੀਏ ॥",
      "transliteration": "eeh bidh kuar adhik sukh le'ee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਨਾਲ ਕੁਮਾਰੀ ਨੇ ਬਹੁਤ ਸੁਖ ਪ੍ਰਾਪਤ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "इह बिधि कुअरि अधिक सुख लीए ॥",
      "sourceLineId": "129018",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਭ ਹੀ ਲੋਗ ਬਿਸ੍ਵਾਸਿਤ ਕੀਏ ॥",
      "transliteration": "sabh hee log bisavaiaasit ke'ee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਲੋਕਾ ਨੂੰ ਵਿਸ਼ਵਸਤ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "सभ ही लोग बिस्वासित कीए ॥",
      "sourceLineId": "129019",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਤਿਥ ਲੋਗ ਕਹਿ ਤਾਹਿ ਬਖਾਨੈ ॥",
      "transliteration": "atith log keh taeh bakhaanai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਲੋਕ ਉਸ ਨੂੰ ਜੋਗੀ ਕਹਿੰਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "अतिथ लोग कहि ताहि बखानै ॥",
      "sourceLineId": "129020",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਾਜਾ ਕਰਿ ਕੋਊ ਨ ਪਛਾਨੈ ॥੨੪॥",
      "transliteration": "raajaa kar kouoo na pachhaanai ||24||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਵਜੋਂ (ਉਸ ਨੂੰ) ਕੋਈ ਵੀ ਨਹੀਂ ਪਛਾਣਦਾ ਸੀ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "राजा करि कोऊ न पछानै ॥२४॥",
      "sourceLineId": "129021",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਇਕ ਦਿਨ ਕੁਅਰਿ ਪਿਤਾ ਪਹਿ ਗਈ ॥",
      "transliteration": "eik dhin kuar pitaa peh giee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਕੁਮਾਰੀ ਪਿਤਾ ਕੋਲ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "इक दिन कुअरि पिता पहि गई ॥",
      "sourceLineId": "129022",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਚਨ ਕਠੋਰ ਬਖਾਨਤ ਭਈ ॥",
      "transliteration": "bachan kaThor bakhaanat bhiee ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਉਸ ਨੂੰ) ਕਠੋਰ ਬਚਨ ਕਹਿਣ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "बचन कठोर बखानत भई ॥",
      "sourceLineId": "129023",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕੋਪ ਬਹੁਤ ਰਾਜਾ ਤਬ ਭਯੋ ॥",
      "transliteration": "kop bahut raajaa tab bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜਾ ਬਹੁਤ ਗੁੱਸੇ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "कोप बहुत राजा तब भयो ॥",
      "sourceLineId": "129024",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਨ ਬਾਸਾ ਦੁਹਿਤਾ ਕਹ ਦਯੋ ॥੨੫॥",
      "transliteration": "ban baasaa dhuhitaa keh dhayo ||25||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੁੱਤਰੀ ਨੂੰ ਬਨਵਾਸ ਦੇ ਦਿੱਤਾ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "बन बासा दुहिता कह दयो ॥२५॥",
      "sourceLineId": "129025",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੁਨ ਬਨਬਾਸ ਪ੍ਰਗਟਿ ਅਤਿ ਰੋਵੈ ॥",
      "transliteration": "sun banabaas pragaT at rovai ||",
      "translation": "",
      "punjabiViakhya": "ਬਨਵਾਸ (ਦੀ ਗੱਲ ਸੁਣ ਕੇ) ਉਪਰੋਂ ਬਹੁਤ ਰੋਂਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "सुन बनबास प्रगटि अति रोवै ॥",
      "sourceLineId": "129026",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚਿਤ ਕੇ ਬਿਖੈ ਸਕਲ ਦੁਖ ਖੋਵੈ ॥",
      "transliteration": "chit ke bikhai sakal dhukh khovai ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਚਿਤ ਵਿਚੋਂ ਸਾਰੇ ਦੁਖ ਖ਼ਤਮ ਕਰਦੀ ਸੀ (ਭਾਵ ਖ਼ੁਸ਼ ਹੁੰਦੀ ਸੀ ਅਤੇ ਕਹਿੰਦੀ ਸੀ ਕਿ)",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "चित के बिखै सकल दुख खोवै ॥",
      "sourceLineId": "129027",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਿਧਿ ਕਾਜ ਮੋਰਾ ਪ੍ਰਭੁ ਕੀਨਾ ॥",
      "transliteration": "sidh kaaj moraa prabh keenaa ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਮਾਤਮਾ ਨੇ ਮੇਰਾ ਕਾਰਜ ਸਿਧ ਕਰ ਦਿੱਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "सिधि काज मोरा प्रभु कीना ॥",
      "sourceLineId": "129028",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਾਤ ਹਮੈ ਬਨ ਬਾਸਾ ਦੀਨਾ ॥੨੬॥",
      "transliteration": "taat hamai ban baasaa dheenaa ||26||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਪਿਤਾ ਨੇ ਮੈਨੂੰ ਬਨਵਾਸ ਦੇ ਦਿੱਤਾ ਹੈ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "तात हमै बन बासा दीना ॥२६॥",
      "sourceLineId": "129029",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਿਵਕਨ ਸੰਗ ਇਮਿ ਰਾਜ ਉਚਾਰੋ ॥",
      "transliteration": "sivakan sa(n)g im raaj uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਸੇਵਕਾ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "सिवकन संग इमि राज उचारो ॥",
      "sourceLineId": "129030",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਏਹ ਕੰਨ੍ਯਾ ਕਹ ਬੇਗਿ ਨਿਕਾਰੋ ॥",
      "transliteration": "eh ka(n)nayaa keh beg nikaaro ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਸ ਕੰਨਿਆ ਨੂੰ (ਇਥੋਂ) ਜਲਦੀ ਕਢ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "एह कंन्या कह बेगि निकारो ॥",
      "sourceLineId": "129031",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਹ ਬਨ ਹੋਇ ਘੋਰ ਬਿਕਰਾਲਾ ॥",
      "transliteration": "jeh ban hoi ghor bikaraalaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਘੋਰ ਭਿਆਨਕ ਬਨ ਹੋਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "जह बन होइ घोर बिकराला ॥",
      "sourceLineId": "129032",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਿਹ ਇਹ ਛਡ ਆਵਹੁ ਤਤਕਾਲਾ ॥੨੭॥",
      "transliteration": "teh ieh chhadd aavahu tatakaalaa ||27||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਸ ਨੂੰ ਤੁਰਤ ਛਡ ਆਓ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "तिह इह छड आवहु ततकाला ॥२७॥",
      "sourceLineId": "129033",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਲੈ ਸੇਵਕ ਤਿਤ ਸੰਗ ਸਿਧਾਏ ॥",
      "transliteration": "lai sevak tit sa(n)g sidhaae ||",
      "translation": "",
      "punjabiViakhya": "ਸੇਵਕ ਉਸ ਨੂੰ ਨਾਲ ਲੈ ਕੇ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "लै सेवक तित संग सिधाए ॥",
      "sourceLineId": "129034",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਾ ਕੋ ਬਨ ਭੀਤਰ ਤਜਿ ਆਏ ॥",
      "transliteration": "taa ko ban bheetar taj aae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਬਨ ਵਿਚ ਛਡ ਆਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "ता को बन भीतर तजि आए ॥",
      "sourceLineId": "129035",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਵਹ ਰਾਜਾ ਆਵਤ ਤਹ ਭਯੋ ॥",
      "transliteration": "veh raajaa aavat teh bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰਾਜਾ ਵੀ ਉਥੇ ਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "वह राजा आवत तह भयो ॥",
      "sourceLineId": "129036",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਹੀ ਤਵਨਿ ਤੇ ਆਸਨ ਲਯੋ ॥੨੮॥",
      "transliteration": "tahee tavan te aasan layo ||28||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਥੇ ਹੀ ਉਸ ਨੇ ਆਸਣ ਲਗਾ ਲਿਆ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "तही तवनि ते आसन लयो ॥२८॥",
      "sourceLineId": "129037",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦ੍ਰਿੜ ਰਤਿ ਪ੍ਰਥਮ ਤਵਨ ਸੌ ਕਰੀ ॥",
      "transliteration": "dhiraR rat pratham tavan sau karee ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਉਸ ਨਾਲ ਚੰਗੀ ਤਰ੍ਰਹਾ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "दृड़ रति प्रथम तवन सौ करी ॥",
      "sourceLineId": "129038",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੈ ਭੋਗਨ ਭਰੀ ॥",
      "transliteration": "bhaat bhaat kai bhogan bharee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦੇ ਭੋਗ ਕਰ ਕੇ (ਮਨ ਨੂੰ) ਭਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "भाति भाति कै भोगन भरी ॥",
      "sourceLineId": "129039",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹੈ ਆਰੂੜਤ ਪੁਨਿ ਤਿਹ ਕੀਨਾ ॥",
      "transliteration": "hai aarooRat pun teh keenaa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਉਸ ਨੂੰ ਘੋੜੇ ਉਤੇ ਚੜ੍ਰਹਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "है आरूड़त पुनि तिह कीना ॥",
      "sourceLineId": "129040",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਗਰ ਅਪਨ ਕੋ ਮਾਰਗ ਲੀਨਾ ॥੨੯॥",
      "transliteration": "nagar apan ko maarag leenaa ||29||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਸ਼ਹਿਰ ਦਾ ਰਾਹ ਫੜਿਆ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "नगर अपन को मारग लीना ॥२९॥",
      "sourceLineId": "129041",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਸਤਾਵਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੫੭॥੪੮੫੬॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau sataavan charitr samaapatam sat subham sat ||257||4856||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੫੭ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੫੭॥੪੮੫੬॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ सतावन चरित्र समापतम सतु सुभम सतु ॥२५७॥४८५६॥अफजूँ॥",
      "sourceLineId": "129042",
      "sourceShabadId": "12218",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "129043",
      "sourceShabadId": "12219",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਹੰਸਾ ਧੁਜ ਰਾਜਾ ਇਕ ਸੁਨਿਯਤ ॥",
      "transliteration": "ha(n)saa dhuj raajaa ik suniyat ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਹੰਸਾ ਧੁਜ ਨਾ ਦਾ ਰਾਜਾ ਸੁਣੀਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "हंसा धुज राजा इक सुनियत ॥",
      "sourceLineId": "129044",
      "sourceShabadId": "12219",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਲ ਪ੍ਰਤਾਪ ਜਿਹ ਅਤਿ ਜਗ ਗੁਨਿਯਤ ॥",
      "transliteration": "bal prataap jeh at jag guniyat ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਬਲ ਅਤੇ ਪ੍ਰਤਾਪ ਨੂੰ ਸਾਰਾ ਜਗਤ ਮੰਨਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "बल प्रताप जिह अति जग गुनियत ॥",
      "sourceLineId": "129045",
      "sourceShabadId": "12219",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕੇਸੋਤਮਾ ਧਾਮ ਤਿਹ ਨਾਰੀ ॥",
      "transliteration": "kesotamaa dhaam teh naaree ||",
      "translation": "",
      "punjabiViakhya": "ਕੇਸੋਤਮਾ ਨਾ ਦੀ ਉਸ ਦੇ ਘਰ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "केसोतमा धाम तिह नारी ॥",
      "sourceLineId": "129046",
      "sourceShabadId": "12219",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਾ ਸਮ ਸੁਨੀ ਨ ਨੈਨ ਨਿਹਾਰੀ ॥੧॥",
      "transliteration": "jaa sam sunee na nain nihaaree ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ (ਸੁੰਦਰ ਇਸਤਰੀ) ਨਾ ਪਹਿਲਾ ਸੁਣੀ ਸੀ ਅਤੇ ਨਾ ਅੱਖਾ ਨਾਲ ਵੇਖੀ ਹੈ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "जा सम सुनी न नैन निहारी ॥१॥",
      "sourceLineId": "129047",
      "sourceShabadId": "12219",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹੰਸ ਮਤੀ ਤਿਹ ਗ੍ਰਿਹ ਦੁਹਿਤਾ ਇਕ ॥",
      "transliteration": "ha(n)s matee teh gireh dhuhitaa ik ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਘਰ ਹੰਸ ਮਤੀ ਨਾ ਦੀ ਇਕ ਲੜਕੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "हंस मती तिह गृह दुहिता इक ॥",
      "sourceLineId": "129048",
      "sourceShabadId": "12219",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪੜੀ ਬ੍ਯਾਕਰਨ ਕੋਕ ਸਾਸਤ੍ਰਨਿਕ ॥",
      "transliteration": "paRee bayaakaran kok saasatranik ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਵਿਆਕਰਣ, ਕੋਕ ਅਤੇ ਹੋਰ ਅਨੇਕ ਸ਼ਾਸਤ੍ਰ ਪੜ੍ਰਹੀ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "पड़ी ब्याकरन कोक सासत्रनिक ॥",
      "sourceLineId": "129049",
      "sourceShabadId": "12219",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਾ ਸਮ ਅਵਰ ਨ ਕੋਊ ਜਗ ਮੈ ॥",
      "transliteration": "taa sam avar na kouoo jag mai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗਾ ਸੰਸਾਰ ਵਿਚ ਹੋਰ ਕੋਈ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "ता सम अवर न कोऊ जग मै ॥",
      "sourceLineId": "129050",
      "sourceShabadId": "12219",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਥਕਿਤ ਰਹਿਤ ਨਿਰਖਤ ਰਵਿ ਮਗ ਮੈ ॥੨॥",
      "transliteration": "thakit rahit nirakhat rav mag mai ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖਦੇ ਹੋਇਆਂ ਸੂਰਜ ਵੀ ਰਸਤੇ ਵਿਚ ਥਕ ਜਾਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "थकित रहित निरखत रवि मग मै ॥२॥",
      "sourceLineId": "129051",
      "sourceShabadId": "12219",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "129052",
      "sourceShabadId": "12220",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਤਿ ਸੁੰਦਰਿ ਵਹ ਬਾਲ ਜਗਤ ਮਹਿ ਜਾਨਿਯੈ ॥",
      "transliteration": "at su(n)dhar veh baal jagat meh jaaniyai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਨੂੰ ਸੰਸਾਰ ਵਿਚ ਅਤਿ ਸੁੰਦਰ ਸਮਝਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "अति सुँदरि वह बाल जगत महि जानियै ॥",
      "sourceLineId": "129053",
      "sourceShabadId": "12220",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਹ ਸਮ ਅਵਰ ਸੁੰਦਰੀ ਕਹੂੰ ਨ ਬਖਾਨਿਯੈ ॥",
      "transliteration": "jeh sam avar su(n)dharee kahoo(n) na bakhaaniyai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ ਹੋਰ ਕੋਈ ਸੁੰਦਰੀ ਦਸੀ ਨਹੀਂ ਜਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "जिह सम अवर सुँदरी कहूँ न बखानियै ॥",
      "sourceLineId": "129054",
      "sourceShabadId": "12220",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜੋਬਨ ਜੇਬ ਅਧਿਕ ਤਾ ਕੇ ਤਨ ਰਾਜਈ ॥",
      "transliteration": "joban jeb adhik taa ke tan raajiee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋਬਨ ਅਤੇ ਸੁੰਦਰਤਾ ਉਸ ਦੇ ਸ਼ਰੀਰ ਉਤੇ ਬਹੁਤ ਸੁਸ਼ੋਭਿਤ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "जोबन जेब अधिक ता के तन राजई ॥",
      "sourceLineId": "129055",
      "sourceShabadId": "12220",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹੋ ਨਿਰਖਿ ਚੰਦ੍ਰ ਅਰੁ ਸੂਰ ਮਦਨ ਛਬਿ ਲਾਜਈ ॥੩॥",
      "transliteration": "ho nirakh cha(n)dhr ar soor madhan chhab laajiee ||3||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਛਬੀ ਨੂੰ ਸੂਰਜ, ਚੰਦ੍ਰਮਾ ਅਤੇ ਕਾਮ ਦੇਵ ਵੀ ਵੇਖ ਕੇ ਸ਼ਰਮਾਉਾਂਦੇ ਸਨ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "हो निरखि चंद्र अरु सूर मदन छबि लाजई ॥३॥",
      "sourceLineId": "129056",
      "sourceShabadId": "12220",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰੂਪ ਕੁਅਰ ਸੁਕੁਮਾਰ ਜਬੈ ਅਬਲਾ ਲਹਾ ॥",
      "transliteration": "roop kuar sukumaar jabai abalaa lahaa ||",
      "translation": "",
      "punjabiViakhya": "(ਇਕ ਦਿਨ) ਜਦ ਇਸਤਰੀ ਨੇ ਕੋਮਲ ਕੁੰਵਰ ਦਾ ਰੂਪ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "रूप कुअर सुकुमार जबै अबला लहा ॥",
      "sourceLineId": "129057",
      "sourceShabadId": "12220",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1174_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਾ ਸਮ ਨਿਰਖਾ ਕਹੂੰ ਨ ਕਹੂੰ ਕਿਨਹੂੰ ਕਹਾ ॥",
      "transliteration": "jaa sam nirakhaa kahoo(n) na kahoo(n) kinahoo(n) kahaa ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਸੋਚਣ ਲਗੀ ਕਿ) ਇਸ ਵਰਗਾ (ਸੁੰਦਰ) ਨਾ ਕੋਈ ਵੇਖਿਆ ਹੈ ਅਤੇ ਨਾ ਹੀ ਕਿਸੇ ਨੇ ਕਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": "जा सम निरखा कहूँ न कहूँ किनहूँ कहा ॥",
      "sourceLineId": "129058",
      "sourceShabadId": "12220",
