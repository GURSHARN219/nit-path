{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1178,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1178_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਉਦਿਤ ਦੋਊ ਆਹਵ ਕਹ ਭਏ ॥",
      "transliteration": "audhit dhouoo aahav keh bhe ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਲੜਾਈ ਕਰਨ ਲਈ ਉਤਾਰੂ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "उदित दोऊ आहव कह भए ॥",
      "sourceLineId": "129227",
      "sourceShabadId": "12245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਾਢਿ ਕ੍ਰਿਪਾਨ ਕੋਪ ਤਨ ਤਏ ॥",
      "transliteration": "kaadd kirapaan kop tan te ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤਲਵਾਰਾ ਕੱਢ ਕੇ ਗੁੱਸੇ ਨਾਲ ਤਪ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "काढि कृपान कोप तन तए ॥",
      "sourceLineId": "129228",
      "sourceShabadId": "12245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਸਿ ਲੈ ਪਿਤੁ ਸੁਤ ਕੇ ਸਿਰ ਝਾਰਾ ॥",
      "transliteration": "as lai pit sut ke sir jhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਉ ਨੇ ਤਲਵਾਰ ਲੈ ਕੇ ਪੁੱਤਰ ਦੇ ਸਿਰ ਵਿਚ ਮਾਰੀ",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "असि लै पितु सुत के सिर झारा ॥",
      "sourceLineId": "129229",
      "sourceShabadId": "12245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪੂਤ ਕਾਢਿ ਪਿਤੁ ਸੀਸ ਪ੍ਰਹਾਰਾ ॥੧੪॥",
      "transliteration": "poot kaadd pit sees prahaaraa ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੁੱਤਰ ਨੇ (ਤਲਵਾਰ) ਕਢ ਕੇ ਪਿਤਾ ਦੇ ਸਿਰ ਵਿਚ ਮਾਰੀ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "पूत काढि पितु सीस प्रहारा ॥१४॥",
      "sourceLineId": "129230",
      "sourceShabadId": "12245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮੈ ਠਾਢੀ ਇਹ ਚਰਿਤ ਨਿਹਾਰਾ ॥",
      "transliteration": "mai Thaaddee ieh charit nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਖੜੋਤੀ ਹੋਈ ਨੇ ਇਹ ਚਰਿਤ੍ਰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "मै ठाढी इह चरित निहारा ॥",
      "sourceLineId": "129231",
      "sourceShabadId": "12245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਫੂਟਿ ਨ ਗਏ ਨੈਨ ਕਰਤਾਰਾ ॥",
      "transliteration": "fooT na ge nain karataaraa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਰਮਾਤਮਾ! ਮੇਰੀਆਂ ਅੱਖਾ ਫਟ ਕਿਉਾਂ ਨਾ ਗਈਆਂ?",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "फूटि न गए नैन करतारा ॥",
      "sourceLineId": "129232",
      "sourceShabadId": "12245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦਾਵ ਬਚਾਇ ਨ ਇਨ ਤੇ ਅਯੋ ॥",
      "transliteration": "dhaav bachai na in te ayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਨੂੰ ਦਾਉ ਬਚਾਣਾ ਨਾ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "दाव बचाइ न इन ते अयो ॥",
      "sourceLineId": "129233",
      "sourceShabadId": "12245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਾ ਤੇ ਕਾਲ ਦੁਹੂੰਨ ਕੇ ਭਯੋ ॥੧੫॥",
      "transliteration": "taa te kaal dhuhoo(n)n ke bhayo ||15||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਦੋਹਾ ਦਾ ਕਾਲ ਆ ਗਿਆ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "ता ते काल दुहूँन के भयो ॥१५॥",
      "sourceLineId": "129234",
      "sourceShabadId": "12245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਬ ਹੌ ਦੈਵ ਕਹੌ ਕਾ ਕਰੌਂ ॥",
      "transliteration": "ab hau dhaiv kahau kaa karaua(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪ੍ਰਭੂ! ਹੁਣ ਦਸੋ ਮੈਂ ਕੀ ਕਰਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "अब हौ दैव कहौ का करौं ॥",
      "sourceLineId": "129235",
      "sourceShabadId": "12245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਉਰ ਮਹਿ ਮਾਰਿ ਕਟਾਰੀ ਮਰੌਂ ॥",
      "transliteration": "aur meh maar kaTaaree maraua(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕੀ ਹਿਰਦੇ ਵਿਚ ਕਟਾਰ ਮਾਰ ਕੇ ਮਰ ਜਾਵਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "उर महि मारि कटारी मरौं ॥",
      "sourceLineId": "129236",
      "sourceShabadId": "12245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਾਨ ਪ੍ਰਸਥ ਹ੍ਵੈ ਬਨਹਿ ਸਿਧੈ ਹੌਂ ॥",
      "transliteration": "baan prasath havai baneh sidhai haua(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਨਿਆਸੀ ਹੋ ਕੇ ਬਨ ਨੂੰ ਚਲੀ ਜਾਵਾ",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "बान प्रसथ ह्वै बनहि सिधै हौं ॥",
      "sourceLineId": "129237",
      "sourceShabadId": "12245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਲਹੁ ਸੁਤ ਕੇ ਸਿਰ ਛਤ੍ਰ ਢੁਰੈ ਹੌਂ ॥੧੬॥",
      "transliteration": "lahu sut ke sir chhatr ddurai haua(n) ||16||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਛੋਟੇ ਪੁੱਤਰ ਦੇ ਸਿਰ ਉਤੇ ਰਾਜ-ਛਤ੍ਰ ਝੁਲਾ ਦਿਆਂ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "लहु सुत के सिर छत्र ढुरै हौं ॥१६॥",
      "sourceLineId": "129238",
      "sourceShabadId": "12245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪ੍ਰਥਮ ਪੂਤ ਪਤਿ ਕੋ ਬਧ ਕੀਨਾ ॥",
      "transliteration": "pratham poot pat ko badh keenaa ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਪਤੀ ਅਤੇ ਪੁੱਤਰ ਨੂੰ ਮਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "प्रथम पूत पति को बध कीना ॥",
      "sourceLineId": "129239",
      "sourceShabadId": "12245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਹੁਰਿ ਰਾਜ ਲਹੁ ਸੁਤ ਕਹ ਦੀਨਾ ॥",
      "transliteration": "bahur raaj lahu sut keh dheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਛੋਟੇ ਪੁੱਤਰ ਨੂੰ ਰਾਜ ਦੇ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "बहुरि राज लहु सुत कह दीना ॥",
      "sourceLineId": "129240",
      "sourceShabadId": "12245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਹੁਰੌ ਭੇਖ ਅਤਿਥ ਕੋ ਧਾਰੀ ॥",
      "transliteration": "bahurau bhekh atith ko dhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਜੋਗਣ ਦਾ ਰੂਪ ਧਾਰਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "बहुरौ भेख अतिथ को धारी ॥",
      "sourceLineId": "129241",
      "sourceShabadId": "12245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪੰਥ ਉਤਰਾ ਓਰ ਸਿਧਾਰੀ ॥੧੭॥",
      "transliteration": "pa(n)th utaraa or sidhaaree ||17||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਉਤਰ ਦਿਸ਼ਾ ਦੇ ਮਾਰਗ ਉਤੇ ਪੈ ਗਈ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "पंथ उतरा ओर सिधारी ॥१७॥",
      "sourceLineId": "129242",
      "sourceShabadId": "12245",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "129243",
      "sourceShabadId": "12246",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਹਾ ਜਾਇ ਤਪਸਾ ਕਰੀ ਸਿਵ ਕੀ ਬਿਬਿਧ ਪ੍ਰਕਾਰ ॥",
      "transliteration": "tahaa jai tapasaa karee siv kee bibidh prakaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਜਾ ਕੇ ਸ਼ਿਵ ਦੀ ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਤਪਸਿਆ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "तहा जाइ तपसा करी सिव की बिबिध प्रकार ॥",
      "sourceLineId": "129244",
      "sourceShabadId": "12246",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭੂਤ ਰਾਟ ਰੀਝਤ ਭਏ ਨਿਰਖਿ ਨਿਠੁਰਤਾ ਨਾਰਿ ॥੧੮॥",
      "transliteration": "bhoot raaT reejhat bhe nirakh niThurataa naar ||18||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਇਸਤਰੀ ਦੀ ਕਠੋਰ ਸਾਧਨਾ (ਤਪਸਿਆ) ਨੂੰ ਵੇਖ ਕੇ ਰੁਦ੍ਰ ('ਭੂਤ ਰਾਟ') ਪ੍ਰਸੰਨ ਹੋ ਗਏ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "भूत राट रीझत भए निरखि निठुरता नारि ॥१८॥",
      "sourceLineId": "129245",
      "sourceShabadId": "12246",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "129246",
      "sourceShabadId": "12247",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਰੰਬ੍ਰਯੂਹ ਪੁਤ੍ਰੀ ਹੈ ਕਹਾ ॥",
      "transliteration": "bara(n)brayooh putree hai kahaa ||",
      "translation": "",
      "punjabiViakhya": "(ਸ਼ਿਵ ਨੇ) ਕਿਹਾ ਹੇ ਪੁੱਤਰੀ! (ਤੂੰ) ਵਰ ਮੰਗ ('ਬਰੰਬ੍ਰਯਹ')",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "बरंब्रयूह पुत्री है कहा ॥",
      "sourceLineId": "129247",
      "sourceShabadId": "12247",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜੋ ਤਵ ਬ੍ਯਾਪਿ ਹ੍ਰਿਦੈ ਮਹਿ ਰਹਾ ॥",
      "transliteration": "jo tav bayaap hiradhai meh rahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਤੇਰੇ ਹਿਰਦੇ ਵਿਚ ਵਿਆਪ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "जो तव ब्यापि हृदै महि रहा ॥",
      "sourceLineId": "129248",
      "sourceShabadId": "12247",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦੇਹੁ ਤ ਪਿਤਾ ਇਹੈ ਬਰ ਪਾਊ ॥",
      "transliteration": "dheh ta pitaa ihai bar paauoo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ ਕਿਹਾ) ਹੇ ਪਿਤਾ! ਜੇ ਦੇਣਾ ਚਾਹੋ, (ਤਾ ਮੈਂ) ਤੁਹਾਡੇ ਤੋਂ ਇਹ ਵਰ ਪ੍ਰਾਪਤ ਕਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "देहु त पिता इहै बर पाऊ ॥",
      "sourceLineId": "129249",
      "sourceShabadId": "12247",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਿਰਧਾ ਤੇ ਤਰੁਨੀ ਹ੍ਵੈ ਜਾਊ ॥੧੯॥",
      "transliteration": "biradhaa te tarunee havai jaauoo ||19||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਬਿਰਧ ਤੋਂ ਜਵਾਨ ਹੋ ਜਾਵਾ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "बिरधा ते तरुनी ह्वै जाऊ ॥१९॥",
      "sourceLineId": "129250",
      "sourceShabadId": "12247",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "129251",
      "sourceShabadId": "12248",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਿਰਧਾ ਤੇ ਤਰੁਨੀ ਭਈ ਬਰੁ ਦੀਨਾ ਤ੍ਰਿਪਰਾਰਿ ॥",
      "transliteration": "biradhaa te tarunee bhiee bar dheenaa tiraparaar ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਨੇ (ਵਰ) ਦਿੱਤਾ ਅਤੇ (ਉਹ) ਬੁੱਢੀ ਤੋਂ ਜਵਾਨ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "बिरधा ते तरुनी भई बरु दीना तृपरारि ॥",
      "sourceLineId": "129252",
      "sourceShabadId": "12248",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੁਚਾ ਪੁਰਾਤਨ ਛਾਡਿ ਕਰਿ ਜ੍ਯੋ ਅਹਿ ਕੁੰਚੁਰ ਡਾਰਿ ॥੨੦॥",
      "transliteration": "tuchaa puraatan chhaadd kar jayo eh ku(n)chur ddaar ||20||",
      "translation": "",
      "punjabiViakhya": "ਸੱਪ ਦੇ ਕੁੰਜ ਉਤਾਰਨ ਵਾਗ (ਉਸ ਇਸਤਰੀ ਨੇ) ਪੁਰਾਤਨ ਚਮੜੀ ਉਤਾਰ ਦਿੱਤੀ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "तुचा पुरातन छाडि करि ज्यो अहि कुँचुर डारि ॥२०॥",
      "sourceLineId": "129253",
      "sourceShabadId": "12248",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "129254",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਿਰਧਾ ਤੇ ਤਰੁਨੀ ਜਬ ਭਈ ॥",
      "transliteration": "biradhaa te tarunee jab bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਬਿਰਧ ਤੋਂ ਜਵਾਨ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "बिरधा ते तरुनी जब भई ॥",
      "sourceLineId": "129255",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਬ ਚਲਿ ਤਿਸੀ ਨਗਰ ਕਹ ਗਈ ॥",
      "transliteration": "tab chal tisee nagar keh giee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਚਲ ਕੇ ਉਸੇ ਨਗਰ ਵਲ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "तब चलि तिसी नगर कह गई ॥",
      "sourceLineId": "129256",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਹ ਖੇਲਤ ਸੁਤ ਚੜਾ ਸਿਕਾਰਾ ॥",
      "transliteration": "jeh khelat sut chaRaa sikaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ (ਉਸ ਦਾ) ਪੁੱਤਰ ਸ਼ਿਕਾਰ ਖੇਡਣ ਚੜ੍ਰਹਿਆ ਹੋਇਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "जह खेलत सुत चड़ा सिकारा ॥",
      "sourceLineId": "129257",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਾਰੇ ਰੀਛ ਰੋਝ ਝੰਖਾਰਾ ॥੨੧॥",
      "transliteration": "maare reechh rojh jha(n)khaaraa ||21||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਬਹੁਤ ਸਾਰੇ) ਰਿਛ, ਰੋਝ ਅਤੇ ਬਾਰਾਸਿੰਘੇ ਮਾਰੇ ਹੋਏ ਸਨ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "मारे रीछ रोझ झंखारा ॥२१॥",
      "sourceLineId": "129258",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਏਕ ਮ੍ਰਿਗੀ ਕਾ ਭੇਸ ਧਰਾ ਤਬ ॥",
      "transliteration": "ek miragee kaa bhes dharaa tab ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਉਸ ਇਸਤਰੀ ਨੇ) ਇਕ ਹਿਰਨੀ ਦਾ ਭੇਸ ਧਾਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "एक मृगी का भेस धरा तब ॥",
      "sourceLineId": "129259",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਨ ਕੇ ਬਸਤ੍ਰ ਛੋਡ ਸੁੰਦਰ ਸਬ ॥",
      "transliteration": "tan ke basatr chhodd su(n)dhar sab ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਰੀਰ ਦੇ ਸਾਰੇ ਸੁੰਦਰ ਬਸਤ੍ਰ ਉਤਾਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "तन के बसत्र छोड सुँदर सब ॥",
      "sourceLineId": "129260",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਖੇਲਤ ਹੁਤੋ ਅਖਿਟ ਸੁਤ ਜਹਾ ॥",
      "transliteration": "khelat huto akhiT sut jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਹਿਰਨੀ ਦਾ ਰੂਪ ਧਾਰ ਕੇ ਉਥੇ ਜਾ ਨਿਕਲੀ",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "खेलत हुतो अखिट सुत जहा ॥",
      "sourceLineId": "129261",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹਰਨੀ ਹ੍ਵੈ ਨਿਕਸਤ ਭੀ ਤਹਾ ॥੨੨॥",
      "transliteration": "haranee havai nikasat bhee tahaa ||22||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਪੁੱਤਰ ਸ਼ਿਕਾਰ ਖੇਡ ਰਿਹਾ ਸੀ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "हरनी ह्वै निकसत भी तहा ॥२२॥",
      "sourceLineId": "129262",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਤਿਹ ਸੁਤ ਹੈ ਡਾਰਾ ॥",
      "transliteration": "taa paachhe teh sut hai ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਹਿਰਨੀ ਬਣੀ ਰਾਣੀ) ਦੇ ਪਿਛੇ ਪੁੱਤਰ ਨੇ (ਘੋੜਾ) ਭਜਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "ता पाछे तिह सुत है डारा ॥",
      "sourceLineId": "129263",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੰਗੀ ਕਿਸੂ ਨ ਓਰ ਨਿਹਾਰਾ ॥",
      "transliteration": "sa(n)gee kisoo na or nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਸੇ ਸੰਗੀ ਸਾਥੀ ਵਲ ਨਾ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "संगी किसू न ओर निहारा ॥",
      "sourceLineId": "129264",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਏਕਲ ਜਾਤ ਦੂਰਿ ਭਯੋ ਤਹਾ ॥",
      "transliteration": "ekal jaat dhoor bhayo tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਇਕੱਲਾ ਬਹੁਤ ਦੂਰ ਨਿਕਲ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "एकल जात दूरि भयो तहा ॥",
      "sourceLineId": "129265",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਥੋ ਬਨ ਘੋਰ ਭਯਾਨਕ ਜਹਾ ॥੨੩॥",
      "transliteration": "tho ban ghor bhayaanak jahaa ||23||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਬਹੁਤ ਭਿਆਨਕ ਬਨ ਸੀ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "थो बन घोर भयानक जहा ॥२३॥",
      "sourceLineId": "129266",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਾਲ ਤਮਾਲ ਜਹਾ ਦ੍ਰੁਮ ਭਾਰੇ ॥",
      "transliteration": "saal tamaal jahaa dhrum bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਸਾਲ ਅਤੇ ਤਮਾਲ ਦੇ ਵੱਡੇ ਬ੍ਰਿਛ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "साल तमाल जहा द्रुम भारे ॥",
      "sourceLineId": "129267",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਿੰਬੂ ਕਦਮ ਸੁ ਬਟ ਜਟਿਯਾਰੇ ॥",
      "transliteration": "ni(n)boo kadham su baT jaTiyaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਿੰਬੂ, ਕਦਮ ਅਤੇ ਜਟਾਵਾ ਵਾਲੇ ਬੋਹੜ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "निंबू कदम सु बट जटियारे ॥",
      "sourceLineId": "129268",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੀਬਰ ਤਾਰ ਖਜੂਰੇ ਭਾਰੀ ॥",
      "transliteration": "seebar taar khajoore bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਸੀਬਰ (ਸਿੰਬਲ ਜਾ ਸ੍ਰੀਫਲ) ਤਾੜ, ਖਜੂਰ ਆਦਿ ਦੇ ਭਾਰੀ (ਦਰਖ਼ਤ) ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "सीबर तार खजूरे भारी ॥",
      "sourceLineId": "129269",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਿਜ ਹਾਥਨ ਜਨੁ ਈਸ ਸੁਧਾਰੀ ॥੨੪॥",
      "transliteration": "nij haathan jan iees sudhaaree ||24||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਪਰਮਾਤਮਾ ਨੇ ਆਪਣੇ ਹੱਥਾ ਨਾਲ ਉਨ੍ਰਹਾ ਨੂੰ ਬਣਾਇਆ ਹੋਵੇ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "निज हाथन जनु ईस सुधारी ॥२४॥",
      "sourceLineId": "129270",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮ੍ਰਿਗੀ ਜਾਇ ਤਹ ਗਈ ਭੁਲਾਈ ॥",
      "transliteration": "miragee jai teh giee bhulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਹਿਰਨੀ ਉਥੇ ਪਹੁੰਚ ਕੇ ਅਲੋਪ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "मृगी जाइ तह गई भुलाई ॥",
      "sourceLineId": "129271",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਉਤਮਾਗਨਾ ਭੇਸ ਬਨਾਈ ॥",
      "transliteration": "autamaaganaa bhes banaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉੱਤਮ ਇਸਤਰੀ ਦਾ ਭੇਸ ਬਣਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "उतमागना भेस बनाई ॥",
      "sourceLineId": "129272",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਆਨਿ ਅਪਨ ਤਿਹ ਰੂਪ ਦਿਖਾਰਾ ॥",
      "transliteration": "aan apan teh roop dhikhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਆ ਕੇ ਉਸ ਨੂੰ ਆਪਣਾ ਰੂਪ ਵਿਖਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "आनि अपन तिह रूप दिखारा ॥",
      "sourceLineId": "129273",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1178_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਮੋਹਿਤ ਕਰਿ ਡਾਰਾ ॥੨੫॥",
      "transliteration": "raaj kuar mohit kar ddaaraa ||25||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ ਕੁੰਵਰ ਨੂੰ ਮੋਹਿਤ ਕਰ ਦਿੱਤਾ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1178,
      "hindi": "",
      "hindiTransliteration": "राज कुअर मोहित करि डारा ॥२५॥",
      "sourceLineId": "129274",
      "sourceShabadId": "12249",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
