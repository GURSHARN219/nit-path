{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1180,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1180_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸ੍ਰੀ ਮਾਸੂਕ ਮਤੀ ਤਿਹ ਰਾਨੀ ॥",
      "transliteration": "sree maasook matee teh raanee ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਸੂਕ ਮਤੀ ਉਸ ਦੀ ਰਾਣੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "स्री मासूक मती तिह रानी ॥",
      "sourceLineId": "129323",
      "sourceShabadId": "12257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਵੀ ਚੰਦ੍ਰਵੀ ਕੈ ਇੰਦ੍ਰਾਨੀ ॥੧॥",
      "transliteration": "ravee cha(n)dhravee kai i(n)dhraanee ||1||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸੂਰਜ, ਚੰਦ੍ਰਮਾ ਜਾ ਇੰਦਰ ਦੀਆਂ ਪਤਨੀਆਂ (ਵਰਗੀ ਸੁੰਦਰ ਸੀ) ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "रवी चंद्रवी कै इंद्रानी ॥१॥",
      "sourceLineId": "129324",
      "sourceShabadId": "12257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਾ ਕੇ ਪੁਤ੍ਰ ਹੋਤ ਗ੍ਰਿਹ ਨਾਹੀ ॥",
      "transliteration": "taa ke putr hot gireh naahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਪੁੱਤਰ ਨਹੀਂ ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "ता के पुत्र होत गृह नाही ॥",
      "sourceLineId": "129325",
      "sourceShabadId": "12257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਹ ਚਿੰਤਾ ਤ੍ਰਿਯ ਕੇ ਜਿਯ ਮਾਹੀ ॥",
      "transliteration": "eeh chi(n)taa tiray ke jiy maahee ||",
      "translation": "",
      "punjabiViakhya": "ਇਹੀ ਚਿੰਤਾ ਉਸ ਇਸਤਰੀ ਦੇ ਮਨ ਵਿਚ ਰਹਿੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "इह चिंता तृय के जिय माही ॥",
      "sourceLineId": "129326",
      "sourceShabadId": "12257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰਾਜਾ ਤੇ ਜਿਯ ਮਹਿ ਡਰ ਪਾਵੈ ॥",
      "transliteration": "raajaa te jiy meh ddar paavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰਾਜੇ ਤੋਂ ਮਨ ਵਿਚ ਬਹੁਤ ਡਰਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "राजा ते जिय महि डर पावै ॥",
      "sourceLineId": "129327",
      "sourceShabadId": "12257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਹੁ ਪੁਰਖਨ ਸੰਗ ਕੇਲ ਕਮਾਵੈ ॥੨॥",
      "transliteration": "bahu purakhan sa(n)g kel kamaavai ||2||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਬਹੁਤ ਸਾਰੇ ਮਰਦਾ ਨਾਲ ਰਤੀ-ਕ੍ਰੀੜਾ ਕਰਦੀ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "बहु पुरखन संग केल कमावै ॥२॥",
      "sourceLineId": "129328",
      "sourceShabadId": "12257",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "129329",
      "sourceShabadId": "12258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਸੁੰਦਰੀ ਝਰੋਖਾ ਬੈਠਿ ਬਰ ॥",
      "transliteration": "ek dhivas su(n)dharee jharokhaa baiTh bar ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਉਹ ਉੱਤਮ ਸੁੰਦਰੀ (ਆਪਣੇ ਮੱਹਲ ਦੇ) ਝਰੋਖੇ ਵਿਚ ਬੈਠੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "एक दिवस सुँदरी झरोखा बैठि बर ॥",
      "sourceLineId": "129330",
      "sourceShabadId": "12258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਹਿਖਨ ਕੋ ਪਾਲਕ ਤਹ ਨਿਕਸਿਯੋ ਆਇ ਕਰਿ ॥",
      "transliteration": "mahikhan ko paalak teh nikasiyo aai kar ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਉਥੋਂ ਇਹ ਮੱਝਾ ਦਾ ਪਾਲੀ ਆ ਨਿਕਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "महिखन को पालक तह निकसियो आइ करि ॥",
      "sourceLineId": "129331",
      "sourceShabadId": "12258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮੇਹੀਵਾਲ ਸੋਹਨੀ ਮੁਖ ਤੇ ਗਾਵਤੋ ॥",
      "transliteration": "meheevaal sohanee mukh te gaavato ||",
      "translation": "",
      "punjabiViakhya": "ਮੂੰਹ ਤੋਂ ਸੋਹਣੀ ਮੇਹੀਂਵਾਲ (ਦਾ ਕਿੱਸਾ) ਗਾ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "मेहीवाल सोहनी मुख ते गावतो ॥",
      "sourceLineId": "129332",
      "sourceShabadId": "12258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹੋ ਸਭ ਨਾਰਿਨ ਕੇ ਚਿਤ ਕੌ ਚਲਾ ਚੁਰਾਵਤੋ ॥੩॥",
      "transliteration": "ho sabh naarin ke chit kau chalaa churaavato ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੀਆਂ ਇਸਤਰੀਆਂ ਦਾ ਚਿਤ ਚੁਰਾਈ ਜਾਦਾ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "हो सभ नारिन के चित कौ चला चुरावतो ॥३॥",
      "sourceLineId": "129333",
      "sourceShabadId": "12258",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "129334",
      "sourceShabadId": "12259",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੁਨਿ ਰਾਨੀ ਸ੍ਰੁਤ ਨਾਦ ਧੁਨਿ ਮਾਰ ਕਰੀ ਬਿਸੰਭਾਰ ॥",
      "transliteration": "sun raanee srut naadh dhun maar karee bisa(n)bhaar ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ (ਜਦ ਉਸ) ਦੀ ਸੁੰਦਰ ਧੁਨੀ ਕੰਨਾ ਨਾਲ ਸੁਣੀ ਤਾ ਕਾਮ ਦੇਵ ਨੇ (ਬਾਣ ਮਾਰ ਕੇ) ਬੇਸੁੱਧ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "सुनि रानी स्रुत नाद धुनि मार करी बिसंभार ॥",
      "sourceLineId": "129335",
      "sourceShabadId": "12259",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਮੋ ਮਹਿਖ ਪਾਲਕ ਭਏ ਇਹ ਬਿਧ ਕਿਯਾ ਬਿਚਾਰ ॥੪॥",
      "transliteration": "ramo mahikh paalak bhe ieh bidh kiyaa bichaar ||4||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਮਨ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਸੋਚਿਆ ਕਿ ਮੱਝਾ ਦੇ ਪਾਲੀ ਨਾਲ ਰਮਣ ਕੀਤਾ ਜਾਏ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "रमो महिख पालक भए इह बिध किया बिचार ॥४॥",
      "sourceLineId": "129336",
      "sourceShabadId": "12259",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "129337",
      "sourceShabadId": "12260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਹਿਖ ਚਰਾਵਤ ਥੋ ਵਹੁ ਜਹਾ ॥",
      "transliteration": "mahikh charaavat tho vahu jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਉਹ ਮੱਝਾ ਚਰਾਉਾਂਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "महिख चरावत थो वहु जहा ॥",
      "sourceLineId": "129338",
      "sourceShabadId": "12260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਾਨੀ ਗਈ ਰਾਤ੍ਰਿ ਕਹ ਤਹਾ ॥",
      "transliteration": "raanee giee raatr keh tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਰਾਤ ਨੂੰ ਉਥੇ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "रानी गई रातृ कह तहा ॥",
      "sourceLineId": "129339",
      "sourceShabadId": "12260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦ੍ਵੈਕ ਘਰੀ ਪਾਛੇ ਪਤਿ ਜਾਗਾ ॥",
      "transliteration": "dhavaik gharee paachhe pat jaagaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋ ਕੁ ਘੜੀਆਂ ਬਾਦ ਪਤੀ ਜਾਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "द्वैक घरी पाछे पति जागा ॥",
      "sourceLineId": "129340",
      "sourceShabadId": "12260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਸਿ ਗਹਿ ਕਰ ਪਾਛੇ ਤ੍ਰਿਯ ਲਾਗਾ ॥੫॥",
      "transliteration": "as geh kar paachhe tiray laagaa ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤਲਵਾਰ ਪਕੜ ਕੇ ਰਾਣੀ ਦੇ ਪਿਛੇ ਲਗ ਗਿਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "असि गहि कर पाछे तृय लागा ॥५॥",
      "sourceLineId": "129341",
      "sourceShabadId": "12260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਖੀ ਹੁਤੀ ਇਕ ਤਹਾ ਸ੍ਯਾਨੀ ॥",
      "transliteration": "sakhee hutee ik tahaa sayaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸਿਆਣੀ ਸਹੇਲੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "सखी हुती इक तहा स्यानी ॥",
      "sourceLineId": "129342",
      "sourceShabadId": "12260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਿਨ ਇਹ ਬਾਤ ਸਕਲ ਜਿਯ ਜਾਨੀ ॥",
      "transliteration": "tin ieh baat sakal jiy jaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਹ ਸਾਰੀ ਗੱਲ ਦਿਲ ਵਿਚ ਜਾਣ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "तिन इह बात सकल जिय जानी ॥",
      "sourceLineId": "129343",
      "sourceShabadId": "12260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜੌ ਤਾ ਕੌ ਪਤਿ ਐਸ ਲਹੈ ਹੈ ॥",
      "transliteration": "jau taa kau pat aais lahai hai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਸੋਚਿਆ ਕਿ) ਜੇ ਉਸ ਦਾ ਪਤੀ ਇਸ ਤਰ੍ਰਹਾ (ਦੂਜੇ ਪੁਰਸ਼ ਨਾਲ ਰਮਣ ਕਰਨ ਦੀ ਹਾਲਤ ਵਿਚ) ਵੇਖ ਲਵੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "जौ ता कौ पति ऐस लहै है ॥",
      "sourceLineId": "129344",
      "sourceShabadId": "12260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤੌ ਗ੍ਰਿਹ ਜਮ ਕੇ ਦੁਹੂੰ ਪਠੈ ਹੈ ॥੬॥",
      "transliteration": "tau gireh jam ke dhuhoo(n) paThai hai ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਦੋਹਾ ਨੂੰ ਯਮ ਲੋਕ ਭੇਜ ਦੇਵੇਗਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "तौ गृह जम के दुहूँ पठै है ॥६॥",
      "sourceLineId": "129345",
      "sourceShabadId": "12260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਗੂ ਆਪਿ ਤਹਾ ਉਠਿ ਗਈ ॥",
      "transliteration": "aagoo aap tahaa uTh giee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਆਪ ਉਠ ਕੇ ਉਥੇ ਪਹਿਲਾ ਪਹੁੰਚ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "आगू आपि तहा उठि गई ॥",
      "sourceLineId": "129346",
      "sourceShabadId": "12260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਰਾਨੀ ਜਹਾ ਮਿਲਤ ਤਿਹ ਭਈ ॥",
      "transliteration": "raanee jahaa milat teh bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਰਾਣੀ ਉਸ (ਪਾਲੀ) ਨਾਲ ਸੰਯੋਗ ਸੁਖ ਮਾਣ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "रानी जहा मिलत तिह भई ॥",
      "sourceLineId": "129347",
      "sourceShabadId": "12260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਐਚਿ ਅੰਗ ਤਿਹ ਤਬੈ ਜਗਾਯਾ ॥",
      "transliteration": "aaich a(n)g teh tabai jagaayaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਉਸ ਦੇ ਸ਼ਰੀਰ ਨੂੰ ਟੁੰਬ ਕੇ ਜਗਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "ऐचि अंग तिह तबै जगाया ॥",
      "sourceLineId": "129348",
      "sourceShabadId": "12260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਭ ਬ੍ਰਿਤਾਤ ਕਹਿ ਤਾਹਿ ਸੁਨਾਯਾ ॥੭॥",
      "transliteration": "sabh birataat keh taeh sunaayaa ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਸਾਰਾ ਬ੍ਰਿਤਾਤ ਕਹਿ ਕੇ ਸੁਣਾ ਦਿੱਤਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "सभ बृतात कहि ताहि सुनाया ॥७॥",
      "sourceLineId": "129349",
      "sourceShabadId": "12260",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "129350",
      "sourceShabadId": "12261",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤ੍ਰਾਸ ਸਮੁੰਦ ਕੇ ਬਿਖੈ ਬੂਡਿ ਤਰੁਨੀ ਗਈ ॥",
      "transliteration": "traas samu(n)dh ke bikhai boodd tarunee giee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ ਗੱਲ ਸੁਣ ਕੇ) ਰਾਣੀ ਡਰ ਕੇ ਸਮੁੰਦਰ ਵਿਚ ਡੁਬ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "त्रास समुँद के बिखै बूडि तरुनी गई ॥",
      "sourceLineId": "129351",
      "sourceShabadId": "12261",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗਰੇ ਪਗਰਿਯਾ ਡਾਰਿ ਤਿਸੈ ਮਾਰਤ ਭਈ ॥",
      "transliteration": "gare pagariyaa ddaar tisai maarat bhiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਗੱਲ ਵਿਚ ਪਗੜੀ ਪਾ ਕੇ ਉਸ (ਪਾਲੀ) ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "गरे पगरिया डारि तिसै मारत भई ॥",
      "sourceLineId": "129352",
      "sourceShabadId": "12261",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਏਕ ਬਡੇ ਦ੍ਰੁਮ ਸੰਗ ਦਯੋ ਲਟਕਾਇ ਕੈ ॥",
      "transliteration": "ek badde dhrum sa(n)g dhayo laTakai kai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਵੱਡੇ ਬ੍ਰਿਛ ਨਾਲ (ਉਸ ਨੂੰ) ਲਟਕਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "एक बडे द्रुम संग दयो लटकाइ कै ॥",
      "sourceLineId": "129353",
      "sourceShabadId": "12261",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਹੋ ਬਸਤ੍ਰ ਉਤਾਰਿ ਤਰ ਨ੍ਰਹਾਤ ਭਈ ਤਹ ਜਾਇ ਕੈ ॥੮॥",
      "transliteration": "ho basatr utaar tar nrahaat bhiee teh jai kai ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਸਤ੍ਰ ਉਤਾਰ ਕੇ ਉਸ ਦੇ ਹੇਠਾ ਜਾ ਕੇ ਨਹਾਉਣ ਲਗ ਗਈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "हो बसत्र उतारि तर न्रहात भई तह जाइ कै ॥८॥",
      "sourceLineId": "129354",
      "sourceShabadId": "12261",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "129355",
      "sourceShabadId": "12262",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਹਿ ਧੁਜ ਰਾਜ ਤਹਾ ਤਬ ਆਯੋ ॥",
      "transliteration": "eh dhuj raaj tahaa tab aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜਾ ਅਹਿ ਧੁਜ ਉਥੇ ਪਹੁੰਚ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "अहि धुज राज तहा तब आयो ॥",
      "sourceLineId": "129356",
      "sourceShabadId": "12262",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨ੍ਰਹਾਤ ਮ੍ਰਿਤਕ ਤਰ ਤ੍ਰਿਯ ਲਖਿ ਪਾਯੋ ॥",
      "transliteration": "nrahaat mritak tar tiray lakh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੁਰਦੇ ਦੇ ਹੇਠਾ ਇਸਤਰੀ ਨੂੰ ਨਹਾਉਾਂਦਿਆਂ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "न्रहात मृतक तर तृय लखि पायो ॥",
      "sourceLineId": "129357",
      "sourceShabadId": "12262",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪੂਛਤ ਪਕਰਿ ਤਬੈ ਤਿਹ ਭਯੋ ॥",
      "transliteration": "poochhat pakar tabai teh bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ (ਉਸ ਨੇ) ਇਸਤਰੀ ਨੂੰ ਪਕੜ ਕੇ ਪੁਛਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "पूछत पकरि तबै तिह भयो ॥",
      "sourceLineId": "129358",
      "sourceShabadId": "12262",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਰਿ ਬਰਿ ਆਠ ਟੂਕ ਹ੍ਵੈ ਗਯੋ ॥੯॥",
      "transliteration": "jar bar aaTh Took havai gayo ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੜ ਬਲ ਕੇ ਅੱਠ ਟੋਟੇ ਹੋ ਗਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "जरि बरि आठ टूक ह्वै गयो ॥९॥",
      "sourceLineId": "129359",
      "sourceShabadId": "12262",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "129360",
      "sourceShabadId": "12263",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਿਜੁ ਧਾਮਨ ਕਹ ਛੋਰਿ ਕੈ ਕ੍ਯੋ ਆਈ ਇਹ ਠੌਰ ॥",
      "transliteration": "nij dhaaman keh chhor kai kayo aaiee ieh Thauar ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗਾ ਕਿ) ਆਪਣੇ ਘਰ ਨੂੰ ਛਡ ਕੇ (ਤੂੰ) ਇਥੇ ਕਿਉਾਂ ਆਈ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "निजु धामन कह छोरि कै क्यो आई इह ठौर ॥",
      "sourceLineId": "129361",
      "sourceShabadId": "12263",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਾਚੁ ਕਹੈ ਤੌ ਛਾਡਿ ਹੌ ਹਨੋ ਕਹੈ ਕਛੁ ਔਰ ॥੧੦॥",
      "transliteration": "saach kahai tau chhaadd hau hano kahai kachh aauar ||10||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਸੱਚ ਕਹੇਾਂਗੀ ਤਾ ਛਡ ਦਿਆਂਗਾ ਅਤੇ ਜੇ ਕੁਝ ਹੋਰ ਕਹੇਾਂਗੀ ਤਾ ਮਾਰ ਦਿਆਂਗਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "साचु कहै तौ छाडि हौ हनो कहै कछु और ॥१०॥",
      "sourceLineId": "129362",
      "sourceShabadId": "12263",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "129363",
      "sourceShabadId": "12264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਬ ਤ੍ਰਿਯ ਜੋਰਿ ਦੁਹੂੰ ਕਰ ਲਿਆ ॥",
      "transliteration": "tab tiray jor dhuhoo(n) kar liaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਸਤਰੀ ਨੇ ਦੋਵੇਾਂ ਹੱਥ ਜੋੜ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "तब तृय जोरि दुहूँ कर लिआ ॥",
      "sourceLineId": "129364",
      "sourceShabadId": "12264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪਤਿ ਪਾਇਨਿ ਤਰ ਮਸਤਕਿ ਦਿਯਾ ॥",
      "transliteration": "pat pain tar masatak dhiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਤੀ ਦੇ ਪੈਰਾ ਵਿਚ ਸਿਰ ਰਖ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "पति पाइनि तर मसतकि दिया ॥",
      "sourceLineId": "129365",
      "sourceShabadId": "12264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪ੍ਰਥਮ ਸੁਨਹੁ ਪਿਯ ਬੈਨ ਹਮਾਰੇ ॥",
      "transliteration": "pratham sunahu piy bain hamaare ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪ੍ਰੀਤਮ! ਪਹਿਲਾ ਮੇਰੀ ਗੱਲ ਸੁਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "प्रथम सुनहु पिय बैन हमारे ॥",
      "sourceLineId": "129366",
      "sourceShabadId": "12264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਹੁਰਿ ਕਰਹੁ ਜੋ ਹ੍ਰਿਦੈ ਤਿਹਾਰੇ ॥੧੧॥",
      "transliteration": "bahur karahu jo hiradhai tihaare ||11||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਜੋ ਦਿਲ ਵਿਚ ਆਏ, ਉਹੀ ਕਰੋ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "बहुरि करहु जो हृदै तिहारे ॥११॥",
      "sourceLineId": "129367",
      "sourceShabadId": "12264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮੋਰੇ ਬਢੀ ਅਧਿਕ ਚਿੰਤਾ ਚਿਤ ॥",
      "transliteration": "more baddee adhik chi(n)taa chit ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਚਿਤ ਵਿਚ ਬਹੁਤ ਚਿੰਤਾ ਵੱਧ ਗਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "मोरे बढी अधिक चिंता चित ॥",
      "sourceLineId": "129368",
      "sourceShabadId": "12264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਧ੍ਰਯਾਨ ਧਰੋ ਸ੍ਰੀਪਤਿ ਕੌ ਨਿਤਿਪ੍ਰਤਿ ॥",
      "transliteration": "dhrayaan dharo sreepat kau nitiprat ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਲਈ ਮੈਂ) ਹਰ ਰੋਜ਼ ਵਿਸ਼ਣੂ ਭਗਵਾਨ ਦਾ ਧਿਆਨ ਧਰਦੀ ਸਾ",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "ध्रयान धरो स्रीपति कौ नितिप्रति ॥",
      "sourceLineId": "129369",
      "sourceShabadId": "12264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1180_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪੂਤ ਦੇਹੁ ਪ੍ਰਭੁ ਧਾਮ ਹਮਾਰੇ ॥",
      "transliteration": "poot dheh prabh dhaam hamaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਹੇ ਪ੍ਰਭੂ! ਸਾਡੇ ਘਰ (ਇਕ) ਪੁੱਤਰ ਦੇ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": "पूत देहु प्रभु धाम हमारे ॥",
      "sourceLineId": "129370",
      "sourceShabadId": "12264",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
