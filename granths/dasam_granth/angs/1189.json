{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1189,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1189_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਾਹੂ ਕੋ ਬਹੁ ਕੈਫ ਪਿਵਾਈ ॥",
      "transliteration": "taahoo ko bahu kaif pivaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਬਹੁਤ ਸਾਰੀ ਸ਼ਰਾਬ ਪਿਲਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "ताहू को बहु कैफ पिवाई ॥",
      "sourceLineId": "129803",
      "sourceShabadId": "12325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਹੁਰੋ ਲਯੋ ਗਰੇ ਸੋ ਲਾਈ ॥",
      "transliteration": "bahuro layo gare so laiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਆਪਣੇ ਗਲੇ ਨਾਲ ਲਗਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "बहुरो लयो गरे सो लाई ॥",
      "sourceLineId": "129804",
      "sourceShabadId": "12325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਆਸਨ ਚੁੰਬਨ ਬਹੁ ਬਿਧਿ ਕੀਏ ॥",
      "transliteration": "aasan chu(n)ban bahu bidh ke'ee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਬਹੁਤ ਢੰਗਾ ਨਾਲ ਚੁੰਬਨ ਅਤੇ ਆਸਣ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "आसन चुँबन बहु बिधि कीए ॥",
      "sourceLineId": "129805",
      "sourceShabadId": "12325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚਿਤ ਕੇ ਤਾਪ ਬਿਦਾ ਕਰਿ ਦੀਏ ॥੭੫॥",
      "transliteration": "chit ke taap bidhaa kar dhe'ee ||75||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਿਤ ਦੇ ਸਾਰੇ ਦੁਖ ਦੂਰ ਕਰ ਦਿੱਤੇ ॥੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "चित के ताप बिदा करि दीए ॥७५॥",
      "sourceLineId": "129806",
      "sourceShabadId": "12325",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "129807",
      "sourceShabadId": "12326",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕੁਅਰਿ ਸਜਨ ਸੋ ਰਤਿ ਕਰਤ ਰੀਝ ਰਹੀ ਮਨ ਮਾਹਿ ॥",
      "transliteration": "kuar sajan so rat karat reejh rahee man maeh ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਪ੍ਰੀਤਮ ਨਾਲ ਰਤੀ-ਕ੍ਰੀੜਾ ਕਰ ਕੇ ਮਨ ਵਿਚ ਪ੍ਰਸੰਨ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "कुअरि सजन सो रति करत रीझ रही मन माहि ॥",
      "sourceLineId": "129808",
      "sourceShabadId": "12326",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਵਹਿ ਦਿਨ ਪੂਜਾ ਰੁਦ੍ਰ ਕੀ ਭੂਲਿ ਕਰੀ ਤਿਨ ਨਾਹਿ ॥੭੬॥",
      "transliteration": "veh dhin poojaa rudhr kee bhool karee tin naeh ||76||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਿਨ ਉਸ ਨੇ ਭੁਲ ਕੇ ਰੁਦ੍ਰ ਦੀ ਪੂਜਾ ਨਾ ਕੀਤੀ ॥੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "वहि दिन पूजा रुद्र की भूलि करी तिन नाहि ॥७६॥",
      "sourceLineId": "129809",
      "sourceShabadId": "12326",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "129810",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕੁਅਰਿ ਕੁਅਰ ਕੈ ਸੰਗ ਸਿਧਾਈ ॥",
      "transliteration": "kuar kuar kai sa(n)g sidhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਰਾਜ ਕੁਮਾਰ ਨਾਲ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "कुअरि कुअर कै संग सिधाई ॥",
      "sourceLineId": "129811",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਏਕ ਬਿਵਤ ਮਨ ਮਾਹਿ ਪਕਾਈ ॥",
      "transliteration": "ek bivat man maeh pakaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਆਪਣੇ ਮਨ ਵਿਚ ਇਹ ਵਿਉਾਂਤ ਬਣਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "एक बिवत मन माहि पकाई ॥",
      "sourceLineId": "129812",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਕ ਦੁਰਬਲ ਤ੍ਰਿਯ ਨਿਕਟ ਬਲਾਇਸਿ ॥",
      "transliteration": "eik dhurabal tiray nikaT balais ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਕ ਦੁਰਬਲ ਜਿਹੀ (ਕਾਲੇ ਰੰਗ ਦੀ) ਇਸਤਰੀ ਨੂੰ ਕੋਲ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "इक दुरबल तृय निकट बलाइसि ॥",
      "sourceLineId": "129813",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਾਨ ਲਾਗਿ ਤਿਹ ਮੰਤ੍ਰ ਸਿਖਾਇਸਿ ॥੭੭॥",
      "transliteration": "kaan laag teh ma(n)tr sikhais ||77||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕੰਨਾ ਨਾਲ ਲਗ ਕੇ ਉਸ ਨੂੰ ਗੱਲ ਸਮਝਾਈ ॥੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "कान लागि तिह मंत्र सिखाइसि ॥७७॥",
      "sourceLineId": "129814",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਪਨੀ ਠੌਰ ਤਾਹਿ ਬੈਠਾਯੋ ॥",
      "transliteration": "apanee Thauar taeh baiThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਆਪਣੀ ਥਾ ਤੇ ਬਿਠਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "अपनी ठौर ताहि बैठायो ॥",
      "sourceLineId": "129815",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਾਹਿ ਭਲੀ ਬਿਧਿ ਚਰਿਤ ਸਿਖਾਯੋ ॥",
      "transliteration": "taeh bhalee bidh charit sikhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਚਰਿਤ੍ਰ ਸਿਖਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "ताहि भली बिधि चरित सिखायो ॥",
      "sourceLineId": "129816",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਭ ਸਖਿਯਨ ਜਬ ਤਾਹਿ ਨਿਹਾਰਾ ॥",
      "transliteration": "sabh sakhiyan jab taeh nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਦੀਆਂ ਸਾਰੀਆਂ ਸਹੇਲੀਆਂ ਨੇ (ਆ ਕੇ) ਉਸ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "सभ सखियन जब ताहि निहारा ॥",
      "sourceLineId": "129817",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਿਨ ਤ੍ਰਿਯ ਤਬ ਇਹ ਭਾਤਿ ਉਚਾਰਾ ॥੭੮॥",
      "transliteration": "tin tiray tab ieh bhaat uchaaraa ||78||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ (ਰਾਜ ਕੁਮਾਰੀ ਦੀ ਥਾ ਬੈਠੀ) ਇਸਤਰੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ॥੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "तिन तृय तब इह भाति उचारा ॥७८॥",
      "sourceLineId": "129818",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੈ ਸਿਵ ਪੂਜਨ ਕਾਲਿ ਨ ਗਈ ॥",
      "transliteration": "mai siv poojan kaal na giee ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਕਲ ਸ਼ਿਵ ਪੂਜਾ ਲਈ ਨਹੀਂ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "मै सिव पूजन कालि न गई ॥",
      "sourceLineId": "129819",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾ ਤੇ ਸ੍ਰਾਪ ਰੁਦ੍ਰ ਮੁਹਿ ਦਈ ॥",
      "transliteration": "taa te sraap rudhr muh dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਕਰ ਕੇ ਸ਼ਿਵ ਨੇ ਮੈਨੂੰ ਸਰਾਪ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "ता ते स्राप रुद्र मुहि दई ॥",
      "sourceLineId": "129820",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਯਾ ਤੇ ਅਵਰ ਬਰਨ ਹ੍ਵੈ ਗਯੋ ॥",
      "transliteration": "yaa te avar baran havai gayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਕਰ ਕੇ ਮੇਰਾ ਹੋਰ ਹੀ ਰੰਗ ਹੋ ਗਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "या ते अवर बरन ह्वै गयो ॥",
      "sourceLineId": "129821",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗੋਰ ਬਰਨ ਤੇ ਸਾਵਰ ਭਯੋ ॥੭੯॥",
      "transliteration": "gor baran te saavar bhayo ||79||",
      "translation": "",
      "punjabiViakhya": "ਗੋਰੇ ਰੰਗ ਤੋਂ ਕਾਲਾ ਰੰਗ ਹੋ ਗਿਆ ਹੈ ॥੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "गोर बरन ते सावर भयो ॥७९॥",
      "sourceLineId": "129822",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਭ ਸਖਿਯਨ ਇਹ ਭਾਤਿ ਸੁਨਾ ਜਬ ॥",
      "transliteration": "sabh sakhiyan ieh bhaat sunaa jab ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸਾਰੀਆਂ ਸਖੀਆਂ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "सभ सखियन इह भाति सुना जब ॥",
      "sourceLineId": "129823",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਿਲਿ ਰਾਜਾ ਪਹਿ ਜਾਤ ਭਈ ਸਬ ॥",
      "transliteration": "mil raajaa peh jaat bhiee sab ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸਭ ਮਿਲ ਕੇ ਰਾਜੇ ਕੋਲ ਗਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "मिलि राजा पहि जात भई सब ॥",
      "sourceLineId": "129824",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਭ ਬ੍ਰਿਤਾਤ ਕਹਿ ਤਾਹਿ ਸੁਨਾਯੋ ॥",
      "transliteration": "sabh birataat keh taeh sunaayo ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਾ ਬ੍ਰਿੱਤਾਤ ਉਸ ਨੂੰ ਕਹਿ ਸੁਣਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "सभ बृतात कहि ताहि सुनायो ॥",
      "sourceLineId": "129825",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੁਹਿਤਹਿ ਤਾਤ ਬਿਲੋਕਨ ਆਯੋ ॥੮੦॥",
      "transliteration": "dhuhiteh taat bilokan aayo ||80||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ (ਉਨ੍ਰਹਾ ਦੀ ਗੱਲ ਸੁਣ ਕੇ ਆਪਣੀ) ਧੀ ਨੂੰ ਵੇਖਣ ਆਇਆ ॥੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "दुहितहि तात बिलोकन आयो ॥८०॥",
      "sourceLineId": "129826",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਨਤ ਬਰਨ ਰਾਜੈ ਜਬ ਲਹਾ ॥",
      "transliteration": "anat baran raajai jab lahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਉਸ ਦਾ ਹੋਰ ਰੰਗ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "अनत बरन राजै जब लहा ॥",
      "sourceLineId": "129827",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਸੋ ਰਾਨੀ ਤਨ ਕਹਾ ॥",
      "transliteration": "eeh bidh so raanee tan kahaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਾਣੀ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "इह बिधि सो रानी तन कहा ॥",
      "sourceLineId": "129828",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਹਾ ਭਯੋ ਇਹ ਰਾਜ ਦੁਲਾਰੀ ॥",
      "transliteration": "kahaa bhayo ieh raaj dhulaaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਰਾਜ ਕੁਮਾਰੀ ਨੂੰ ਕੀ ਹੋ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "कहा भयो इह राज दुलारी ॥",
      "sourceLineId": "129829",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗੋਰੀ ਹੁਤੀ ਹ੍ਵੈ ਗਈ ਕਾਰੀ ॥੮੧॥",
      "transliteration": "goree hutee havai giee kaaree ||81||",
      "translation": "",
      "punjabiViakhya": "ਗੋਰੀ ਹੁੰਦੀ ਸੀ, (ਹੁਣ) ਕਾਲੀ ਹੋ ਗਈ ਹੈ ॥੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "गोरी हुती ह्वै गई कारी ॥८१॥",
      "sourceLineId": "129830",
      "sourceShabadId": "12327",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "129831",
      "sourceShabadId": "12328",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਿਰਧ ਤਰੁਨਿ ਤੇ ਹ੍ਵੈ ਗਈ ਭਈ ਗੋਰਿ ਤੇ ਸ੍ਯਾਮ ॥",
      "transliteration": "biradh tarun te havai giee bhiee gor te sayaam ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ) ਜਵਾਨ ਤੋਂ ਬੁੱਢੀ ਹੋ ਗਈ ਹੈ ਅਤੇ ਗੋਰੀ ਤੋਂ ਕਾਲੀ ਹੋ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "बिरध तरुनि ते ह्वै गई भई गोरि ते स्याम ॥",
      "sourceLineId": "129832",
      "sourceShabadId": "12328",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਤਿ ਸ੍ਰਾਪ ਸਿਵ ਐਸਈ ਜਪੋ ਸਕਲ ਸਭ ਜਾਮ ॥੮੨॥",
      "transliteration": "sat sraap siv aaisiee japo sakal sabh jaam ||82||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਦਾ ਸਰਾਪ ਸਚ ਮੁਚ ਅਜਿਹਾ ਹੀ ਹੈ। (ਉਸ ਦੇ ਜਾਪ ਨੂੰ) ਸਾਰੇ ਅੱਠੇ ਪਹਿਰ ਜਪਦੇ ਰਹੋ ॥੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "सति स्राप सिव ऐसई जपो सकल सभ जाम ॥८२॥",
      "sourceLineId": "129833",
      "sourceShabadId": "12328",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "129834",
      "sourceShabadId": "12329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮੂਰਖ ਰਾਜ ਬਾਤ ਨਹਿ ਜਾਨੀ ॥",
      "transliteration": "moorakh raaj baat neh jaanee ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਰਾਜੇ ਨੇ ਗੱਲ ਨਹੀਂ ਸਮਝੀ",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "मूरख राज बात नहि जानी ॥",
      "sourceLineId": "129835",
      "sourceShabadId": "12329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਔਰ ਨਾਰਿ ਦੁਹਿਤਾ ਪਹਿਚਾਨੀ ॥",
      "transliteration": "aauar naar dhuhitaa pahichaanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਕਿਸੇ) ਹੋਰ ਕੁੜੀ ਨੂੰ ਆਪਣੀ ਧੀ ਵਜੋਂ ਪਛਾਣ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "और नारि दुहिता पहिचानी ॥",
      "sourceLineId": "129836",
      "sourceShabadId": "12329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਿਰਹ ਮਤੀ ਮਿਤਵਾ ਸੰਗ ਗਈ ॥",
      "transliteration": "bireh matee mitavaa sa(n)g giee ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਰਹ ਮਤੀ ਤਾ ਮਿਤਰ ਨਾਲ ਚਲੀ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "बिरह मती मितवा संग गई ॥",
      "sourceLineId": "129837",
      "sourceShabadId": "12329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਭੋਗ ਕਮਾਵਤ ਭਈ ॥੮੩॥",
      "transliteration": "bahu bidh bhog kamaavat bhiee ||83||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਪ੍ਰਕਾਰ ਦੇ ਭੋਗ ਕਰਨ ਲਗੀ ॥੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि भोग कमावत भई ॥८३॥",
      "sourceLineId": "129838",
      "sourceShabadId": "12329",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "129839",
      "sourceShabadId": "12330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਇਕ ਦਿਨ ਧਾਮ ਪਰੀ ਕੇ ਦੇਤ ਪਠਾਇ ਕੈ ॥",
      "transliteration": "eik dhin dhaam paree ke dhet paThai kai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ (ਉਹ ਰਾਜ ਕੁਮਾਰ ਨੂੰ) ਸ਼ਾਹ ਪਰੀ ਦੇ ਘਰ ਭੇਜ ਦਿੰਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "इक दिन धाम परी के देत पठाइ कै ॥",
      "sourceLineId": "129840",
      "sourceShabadId": "12330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਕ ਦਿਨ ਆਪੁ ਕਲੋਲ ਕਰਤ ਸੁਖ ਪਾਇ ਕੈ ॥",
      "transliteration": "eik dhin aap kalol karat sukh pai kai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਦਿਨ ਆਪ ਕਲੋਲ ਕਰ ਕੇ ਸੁਖ ਮਾਣਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "इक दिन आपु कलोल करत सुख पाइ कै ॥",
      "sourceLineId": "129841",
      "sourceShabadId": "12330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਰਧਾਰਧ ਬਜਾਵੈ ਤਾ ਸੌ ਰੈਨਿ ਦਿਨ ॥",
      "transliteration": "aradhaaradh bajaavai taa sau rain dhin ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਉਸ ਨਾਲ ਦਿਨ ਰਾਤ ਅਧੇ ਅਧੇ ਸਮੇਾਂ ਲਈ ਰਤੀ-ਕ੍ਰੀੜਾ ਕਰਦੀਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "अरधारध बजावै ता सौ रैनि दिन ॥",
      "sourceLineId": "129842",
      "sourceShabadId": "12330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹੋ ਮੂਰਖ ਬਾਤ ਨ ਪਾਈ ਰਾਜੈ ਕਛੂ ਇਨ ॥੮੪॥",
      "transliteration": "ho moorakh baat na paiee raajai kachhoo in ||84||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਮੂਰਖ ਰਾਜੇ ਨੇ ਇਨ੍ਰਹਾ ਦਾ ਛਲ ਨਾ ਸਮਝਿਆ ॥੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "हो मूरख बात न पाई राजै कछू इन ॥८४॥",
      "sourceLineId": "129843",
      "sourceShabadId": "12330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਚੌਸਠਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੬੪॥੫੦੫੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau chauasaTh charitr samaapatam sat subham sat ||264||5052||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੬੪ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੬੪॥੫੦੫੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ चौसठि चरित्र समापतम सतु सुभम सतु ॥२६४॥५०५२॥अफजूँ॥",
      "sourceLineId": "129844",
      "sourceShabadId": "12330",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "129845",
      "sourceShabadId": "12331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪੂਰਬ ਦਿਸਿ ਰਥ ਚਿਤ੍ਰ ਨਰਾਧਿਪ ॥",
      "transliteration": "poorab dhis rath chitr naraadhip ||",
      "translation": "",
      "punjabiViakhya": "ਪੂਰਬ ਦਿਸ਼ਾ ਵਿਚ ਚਿਤ੍ਰ ਰਥ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "पूरब दिसि रथ चित्र नराधिप ॥",
      "sourceLineId": "129846",
      "sourceShabadId": "12331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਕਲ ਪ੍ਰਿਥੀ ਤਲ ਹੁਤੋ ਨ੍ਰਿਪਾਧਿਪ ॥",
      "transliteration": "sakal pirathee tal huto nirapaadhip ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸਾਰੀ ਧਰਤੀ ਦਾ ਸੁਆਮੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "सकल पृथी तल हुतो नृपाधिप ॥",
      "sourceLineId": "129847",
      "sourceShabadId": "12331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪ੍ਰਕ੍ਰਿਤ ਮਤੀ ਤਾ ਕੀ ਪਟਰਾਨੀ ॥",
      "transliteration": "prakirat matee taa kee paTaraanee ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਕ੍ਰਿਤ ਮਤੀ ਨਾ ਦੀ ਉਸ ਦੀ ਪਟਰਾਣੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "प्रकृत मती ता की पटरानी ॥",
      "sourceLineId": "129848",
      "sourceShabadId": "12331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਰੀ ਸੁਰੀ ਜਿਹ ਨਿਰਖਿ ਲਜਾਨੀ ॥੧॥",
      "transliteration": "naree suree jeh nirakh lajaanee ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਦੇਵ ਇਸਤਰੀਆਂ ਅਤੇ ਨਾਰੀਆਂ ਲਜਾਉਾਂਦੀਆਂ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "नरी सुरी जिह निरखि लजानी ॥१॥",
      "sourceLineId": "129849",
      "sourceShabadId": "12331",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1189_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "129850",
      "sourceShabadId": "12332",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
