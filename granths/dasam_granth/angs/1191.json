{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1191,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1191_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਜਾ ਕੀ ਜਾਘੈ ਗਹਿ ਲੀਨੀ ॥",
      "transliteration": "raajaa kee jaaghai geh leenee ||",
      "translation": "",
      "punjabiViakhya": "(ਗ਼ਲਤੀ ਨਾਲ ਉਸ ਨੇ) ਰਾਜੇ ਦੀਆਂ ਟੰਗਾ ਪਕੜ ਲਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "राजा की जाघै गहि लीनी ॥",
      "sourceLineId": "129899",
      "sourceShabadId": "12336",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਲ ਸੋ ਐਂਚਿ ਆਪੁ ਤਰ ਕੀਨੀ ॥੧੪॥",
      "transliteration": "bal so aai(n)ch aap tar keenee ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜ਼ੋਰ ਨਾਲ ਖਿਚ ਕੇ ਆਪਣੇ ਹੇਠਾ ਕਰ ਲਈਆਂ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "बल सो ऐंचि आपु तर कीनी ॥१४॥",
      "sourceLineId": "129900",
      "sourceShabadId": "12336",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਬ ਨ੍ਰਿਪ ਜਗਾ ਕੋਪ ਕਰਿ ਭਾਰਾ ॥",
      "transliteration": "tab nirap jagaa kop kar bhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜਾ ਬਹੁਤ ਰੋਹ ਵਿਚ ਆ ਕੇ ਜਾਗ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "तब नृप जगा कोप करि भारा ॥",
      "sourceLineId": "129901",
      "sourceShabadId": "12336",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚੋਰ ਚੋਰ ਕਹਿ ਖੜਗ ਸੰਭਾਰਾ ॥",
      "transliteration": "chor chor keh khaRag sa(n)bhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੋਰ ਚੋਰ ਕਰ ਕੇ (ਆਪਣੀ) ਤਲਵਾਰ ਸੰਭਾਲ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "चोर चोर कहि खड़ग संभारा ॥",
      "sourceLineId": "129902",
      "sourceShabadId": "12336",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰਾਨੀ ਜਗੀ ਹਾਥ ਗਹਿ ਲੀਨਾ ॥",
      "transliteration": "raanee jagee haath geh leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਵੀ ਜਾਗ ਗਈ ਅਤੇ (ਉਸ ਨੇ ਰਾਜੇ ਦਾ) ਹੱਥ ਪਕੜ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "रानी जगी हाथ गहि लीना ॥",
      "sourceLineId": "129903",
      "sourceShabadId": "12336",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਯੌ ਜੜ ਕੌ ਪ੍ਰਤਿ ਉਤਰ ਦੀਨਾ ॥੧੫॥",
      "transliteration": "yau jaR kau prat utar dheenaa ||15||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮੂਰਖ (ਰਾਜੇ) ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਉੱਤਰ ਦਿੱਤਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "यौ जड़ कौ प्रति उतर दीना ॥१५॥",
      "sourceLineId": "129904",
      "sourceShabadId": "12336",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "129905",
      "sourceShabadId": "12337",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤੀਰਥ ਨਿਮਿਤ ਆਯੋ ਹੁਤੋ ਯਹ ਢਾਕਾ ਕੋ ਰਾਇ ॥",
      "transliteration": "teerath nimit aayo huto yeh ddaakaa ko rai ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਢਾਕਾ ਦਾ ਰਾਜਾ ਤੀਰਥ-ਯਾਤ੍ਰਾ ਲਈ ਆਇਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "तीरथ निमित आयो हुतो यह ढाका को राइ ॥",
      "sourceLineId": "129906",
      "sourceShabadId": "12337",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਹਾ ਪ੍ਰਥਮ ਨ੍ਰਿਪ ਪਦ ਪਰਸਿ ਬਹੁਰਿ ਅਨੈਹੋ ਜਾਇ ॥੧੬॥",
      "transliteration": "kahaa pratham nirap padh paras bahur anaiho jai ||16||",
      "translation": "",
      "punjabiViakhya": "ਕਹਿੰਦਾ ਸੀ ਕਿ ਪਹਿਲਾ ਰਾਜੇ ਦੇ ਪੈਰ ਛੋਹ ਕੇ ਫਿਰ ਨਹਾਣ ਲਈ ਜਾਵਾਗਾ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "कहा प्रथम नृप पद परसि बहुरि अनैहो जाइ ॥१६॥",
      "sourceLineId": "129907",
      "sourceShabadId": "12337",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "129908",
      "sourceShabadId": "12338",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤੁਮਰੇ ਪਗ ਪਰਸਨ ਕੇ ਕਾਜਾ ॥",
      "transliteration": "tumare pag parasan ke kaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਉਹ ਤਾ ਤੁਹਾਡੇ ਚਰਨਾ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "तुमरे पग परसन के काजा ॥",
      "sourceLineId": "129909",
      "sourceShabadId": "12338",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਇਹ ਕਾਰਨ ਆਯੋ ਇਹ ਰਾਜਾ ॥",
      "transliteration": "eeh kaaran aayo ieh raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਛੋਹਣ ਲਈ ਹੀ ਇਥੇ ਆਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "इह कारन आयो इह राजा ॥",
      "sourceLineId": "129910",
      "sourceShabadId": "12338",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਿਹ ਨ ਹਨੋ ਇਹ ਬਹੁ ਧਨ ਦੀਜੈ ॥",
      "transliteration": "teh na hano ieh bahu dhan dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਮਾਰੋ ਨ, ਸਗੋਂ ਬਹੁਤ ਸਾਰਾ ਧਨ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "तिह न हनो इह बहु धन दीजै ॥",
      "sourceLineId": "129911",
      "sourceShabadId": "12338",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚਰਨ ਲਗਾ ਪਤਿ ਬਿਦਾ ਕਰੀਜੈ ॥੧੭॥",
      "transliteration": "charan lagaa pat bidhaa kareejai ||17||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੇ ਪਤੀ ਦੇਵ! ਚਰਨਾ ਨੂੰ ਛੋਹਾ ਕੇ ਵਿਦਾ ਕਰ ਦਿਓ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "चरन लगा पति बिदा करीजै ॥१७॥",
      "sourceLineId": "129912",
      "sourceShabadId": "12338",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "129913",
      "sourceShabadId": "12339",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਿਦਾ ਕਿਯਾ ਨ੍ਰਿਪ ਦਰਬ ਦੈ ਤਾ ਕੋ ਚਰਨ ਲਗਾਇ ॥",
      "transliteration": "bidhaa kiyaa nirap dharab dhai taa ko charan lagai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਉਸ ਨੂੰ ਆਪਣੇ ਚਰਨਾ ਨਾਲ ਲਗਾ ਕੇ ਬਹੁਤ ਧਨ ਦੇ ਕੇ ਵਿਦਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "बिदा किया नृप दरब दै ता को चरन लगाइ ॥",
      "sourceLineId": "129914",
      "sourceShabadId": "12339",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਇਹ ਛਲ ਸੌ ਮੂਰਖ ਛਲਾ ਸਕਾ ਨ ਛਲ ਕੋ ਪਾਇ ॥੧੮॥",
      "transliteration": "eeh chhal sau moorakh chhalaa sakaa na chhal ko pai ||18||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ (ਰਾਣੀ ਨੇ) ਮੂਰਖ ਰਾਜੇ ਨੂੰ ਛਲ ਲਿਆ, (ਪਰ ਉਹ) ਛਲ ਨੂੰ ਨਾ ਸਮਝ ਸਕਿਆ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "इह छल सौ मूरख छला सका न छल को पाइ ॥१८॥",
      "sourceLineId": "129915",
      "sourceShabadId": "12339",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਪੈਸਠਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੬੫॥੫੦੭੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau paisaTh charitr samaapatam sat subham sat ||265||5070||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੬੫ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੬੫॥੫੦੭੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ पैसठि चरित्र समापतम सतु सुभम सतु ॥२६५॥५०७०॥अफजूँ॥",
      "sourceLineId": "129916",
      "sourceShabadId": "12339",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "129917",
      "sourceShabadId": "12340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੁਮਤਿ ਸੈਨ ਇਕ ਨ੍ਰਿਪਤਿ ਸੁਨਾ ਬਰ ॥",
      "transliteration": "sumat sain ik nirapat sunaa bar ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਮਤਿ ਸੈਨ ਨਾ ਦਾ ਇਕ ਮਹਾਨ ਰਾਜਾ ਸੁਣੀਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "सुमति सैन इक नृपति सुना बर ॥",
      "sourceLineId": "129918",
      "sourceShabadId": "12340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦੁਤਿਯ ਦਿਵਾਕਰ ਕਿਧੌ ਕਿਰਨਿਧਰ ॥",
      "transliteration": "dhutiy dhivaakar kidhau kiranidhar ||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਕਿਤੇ ਦੂਜਾ ਸੂਰਜ ਜਾ ਚੰਦ੍ਰਮਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "दुतिय दिवाकर किधौ किरनिधर ॥",
      "sourceLineId": "129919",
      "sourceShabadId": "12340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਮਰ ਮਤੀ ਰਾਨੀ ਗ੍ਰਿਹ ਤਾ ਕੇ ॥",
      "transliteration": "samar matee raanee gireh taa ke ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਸਮਰ ਮਤੀ ਨਾ ਦੀ ਰਾਣੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "समर मती रानी गृह ता के ॥",
      "sourceLineId": "129920",
      "sourceShabadId": "12340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੁਰੀ ਆਸੁਰੀ ਸਮ ਨਹਿ ਜਾ ਕੇ ॥੧॥",
      "transliteration": "suree aasuree sam neh jaa ke ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀਆਂ ਦੇਵ ਇਸਤਰੀਆਂ ਤੇ ਮਨੁੱਖ ਇਸਤਰੀਆਂ ਨਹੀਂ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "सुरी आसुरी सम नहि जा के ॥१॥",
      "sourceLineId": "129921",
      "sourceShabadId": "12340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸ੍ਰੀ ਰਨਖੰਭ ਕਲਾ ਦੁਹਿਤਾ ਤਿਹ ॥",
      "transliteration": "sree ranakha(n)bh kalaa dhuhitaa teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੀ ਰਨਖੰਭ ਕਲਾ (ਨਾ ਦੀ ਇਕ) ਧੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "स्री रनखंभ कला दुहिता तिह ॥",
      "sourceLineId": "129922",
      "sourceShabadId": "12340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜੀਤਿ ਲਈ ਸਸਿ ਅੰਸ ਕਲਾ ਜਿਹ ॥",
      "transliteration": "jeet liee sas a(n)s kalaa jeh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਚੰਦ੍ਰਮਾ ਦੀਆਂ ਕਲਾਵਾ ਨੂੰ ਜਿਤ ਲਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "जीति लई ससि अंस कला जिह ॥",
      "sourceLineId": "129923",
      "sourceShabadId": "12340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਿਰਖਿ ਭਾਨ ਜਿਹ ਪ੍ਰਭਾ ਰਹਤ ਦਬਿ ॥",
      "transliteration": "nirakh bhaan jeh prabhaa rahat dhab ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਸੁੰਦਰਤਾ ਨੂੰ ਵੇਖ ਕੇ ਸੂਰਜ ਵੀ ਦਬਿਆ ਦਬਿਆ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "निरखि भान जिह प्रभा रहत दबि ॥",
      "sourceLineId": "129924",
      "sourceShabadId": "12340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੁਰੀ ਆਸੁਰਿਨ ਕੀ ਨਹਿ ਸਮ ਛਬਿ ॥੨॥",
      "transliteration": "suree aasurin kee neh sam chhab ||2||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵ ਇਸਤਰੀਆਂ ਅਤੇ ਦੈਂਤ ਇਸਤਰੀਆਂ ਦੀ ਸੁੰਦਰਤਾ ਵੀ (ਉਸ ਦੇ) ਸਮਾਨ ਨਹੀਂ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "सुरी आसुरिन की नहि सम छबि ॥२॥",
      "sourceLineId": "129925",
      "sourceShabadId": "12340",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "129926",
      "sourceShabadId": "12341",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਰੁਨਿ ਭਈ ਤਰੁਨੀ ਜਬੈ ਅਧਿਕ ਸੁਖਨ ਕੇ ਸੰਗ ॥",
      "transliteration": "tarun bhiee tarunee jabai adhik sukhan ke sa(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜ ਕੁਮਾਰੀ ਬਹੁਤ ਸੁਖਾ ਨਾਲ ਪਲ ਕੇ ਵੱਡੀ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "तरुनि भई तरुनी जबै अधिक सुखन के संग ॥",
      "sourceLineId": "129927",
      "sourceShabadId": "12341",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਲਰਿਕਾਪਨ ਮਿਟਿ ਜਾਤ ਭਯੋ ਦੁੰਦਭਿ ਦਿਯੋ ਅਨੰਗ ॥੩॥",
      "transliteration": "larikaapan miT jaat bhayo dhu(n)dhabh dhiyo ana(n)g ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਦਾ ਬਚਪਨਾ ਖ਼ਤਮ ਹੋ ਗਿਆ ਅਤੇ ਕਾਮ ਦੇਵ ਨੇ ਨਗਾਰਾ ਵਜਾ ਦਿੱਤਾ (ਭਾਵ ਭਰ ਜਵਾਨ ਹੋ ਗਈ) ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "लरिकापन मिटि जात भयो दुँदभि दियो अनंग ॥३॥",
      "sourceLineId": "129928",
      "sourceShabadId": "12341",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "129929",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚਾਰਿ ਭ੍ਰਾਤ ਤਾ ਕੇ ਬਲਵਾਨਾ ॥",
      "transliteration": "chaar bhraat taa ke balavaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਚਾਰ ਬਹੁਤ ਬਲਵਾਨ ਭਰਾ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "चारि भ्रात ता के बलवाना ॥",
      "sourceLineId": "129930",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੂਰਬੀਰ ਸਭ ਸਸਤ੍ਰ ਨਿਧਾਨਾ ॥",
      "transliteration": "soorabeer sabh sasatr nidhaanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸਾਰੇ ਸ਼ੂਰਵੀਰ ਅਤੇ ਸ਼ਸਤ੍ਰ ਵਿਦਿਆ ਦੇ ਧਨੀ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "सूरबीर सभ ससत्र निधाना ॥",
      "sourceLineId": "129931",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤੇਜਵਾਨ ਦੁਤਿਮਾਨ ਅਤੁਲ ਬਲ ॥",
      "transliteration": "tejavaan dhutimaan atul bal ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬਹੁਤ ਤੇਜਵਾਨ, ਸੁੰਦਰ ਅਤੇ ਅਦੁੱਤੀ ਬਲ ਵਾਲੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "तेजवान दुतिमान अतुल बल ॥",
      "sourceLineId": "129932",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਰਿ ਅਨੇਕ ਜੀਤੇ ਜਿਹ ਦਲਿ ਮਲਿ ॥੪॥",
      "transliteration": "ar anek jeete jeh dhal mal ||4||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਅਨੇਕ ਵੈਰੀਆਂ ਨੂੰ ਮਸਲ ਕੇ ਜਿਤ ਲਿਆ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "अरि अनेक जीते जिह दलि मलि ॥४॥",
      "sourceLineId": "129933",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਾਰਦੂਲ ਧੁਜ ਨਾਹਰ ਧੁਜ ਭਨ ॥",
      "transliteration": "saaradhool dhuj naahar dhuj bhan ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਦੂਲ ਧੁਜ, ਨਾਹਰ ਧੁਜ,",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "सारदूल धुज नाहर धुज भन ॥",
      "sourceLineId": "129934",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਿੰਘ ਕੇਤੁ ਹਰਿ ਕੇਤੁ ਮਹਾ ਮਨ ॥",
      "transliteration": "si(n)gh ket har ket mahaa man ||",
      "translation": "",
      "punjabiViakhya": "ਸਿੰਘ ਕੇਤੁ ਅਤੇ ਹਰਿ ਕੇਤੁ ਨਾ ਵਾਲੇ ਬਹੁਤ ਮਹਾਨ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "सिंघ केतु हरि केतु महा मन ॥",
      "sourceLineId": "129935",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਚਾਰੌ ਸੂਰਬੀਰ ਬਲਵਾਨਾ ॥",
      "transliteration": "chaarau soorabeer balavaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਚਾਰੇ ਸੂਰਮੇ ਬਹੁਤ ਬਲਵਾਨ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "चारौ सूरबीर बलवाना ॥",
      "sourceLineId": "129936",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮਾਨਤ ਸਤ੍ਰੁ ਸਕਲ ਜਿਹ ਆਨਾ ॥੫॥",
      "transliteration": "maanat satr sakal jeh aanaa ||5||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੀ ਅਧੀਨਗੀ ਨੂੰ ਸਾਰੇ ਵੈਰੀ ਮੰਨਦੇ ਸਨ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "मानत सत्रु सकल जिह आना ॥५॥",
      "sourceLineId": "129937",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚਾਰੌ ਕੁਅਰਿ ਪੜਨ ਕੇ ਕਾਜਾ ॥",
      "transliteration": "chaarau kuar paRan ke kaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ ਰਾਜ ਕੁਮਾਰਾ ਨੂੰ ਪੜ੍ਰਹਾਉਣ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "चारौ कुअरि पड़न के काजा ॥",
      "sourceLineId": "129938",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦਿਜ ਇਕ ਬੋਲਿ ਪਠਾਯੋ ਰਾਜਾ ॥",
      "transliteration": "dhij ik bol paThaayo raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਇਕ ਬ੍ਰਾਹਮਣ ਨੂੰ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "दिज इक बोलि पठायो राजा ॥",
      "sourceLineId": "129939",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭਾਖ੍ਰਯਾਦਿਕ ਬ੍ਯਾਕਰਨ ਪੜੇ ਜਿਨ ॥",
      "transliteration": "bhaakhrayaadhik bayaakaran paRe jin ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਭਾਸ਼੍ਰਯ, ਵਿਆਕਰਣ ਆਦਿ ਪੜ੍ਰਹੇ ਹੋਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "भाख्रयादिक ब्याकरन पड़े जिन ॥",
      "sourceLineId": "129940",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਔਗਾਹਨ ਸਭ ਕਿਯ ਪੁਰਾਨ ਤਿਨ ॥੬॥",
      "transliteration": "aauagaahan sabh kiy puraan tin ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਸ ਨੇ ਸਾਰਿਆਂ ਪੁਰਾਣਾ ਦਾ ਅਧਿਐਨ ਕੀਤਾ ਹੋਇਆ ਸੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "औगाहन सभ किय पुरान तिन ॥६॥",
      "sourceLineId": "129941",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਧਿਕ ਦਰਬ ਨ੍ਰਿਪ ਬਰ ਤਿਹ ਦੀਯਾ ॥",
      "transliteration": "adhik dharab nirap bar teh dheeyaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾਨ ਰਾਜੇ ਨੇ ਉਸ ਨੂੰ ਬਹੁਤ ਧਨ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "अधिक दरब नृप बर तिह दीया ॥",
      "sourceLineId": "129942",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਿਬਿਧ ਬਿਧਨ ਕਰਿ ਆਦਰ ਕੀਯਾ ॥",
      "transliteration": "bibidh bidhan kar aadhar keeyaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਮਾਣ ਸਤਿਕਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "बिबिध बिधन करि आदर कीया ॥",
      "sourceLineId": "129943",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੁਤਾ ਸਹਿਤ ਸੌਪੇ ਸੁਤ ਤਿਹ ਘਰ ॥",
      "transliteration": "sutaa sahit sauape sut teh ghar ||",
      "translation": "",
      "punjabiViakhya": "ਪੁੱਤਰੀ ਸਮੇਤ ਚਾਰੇ ਪੁੱਤਰ ਉਸ ਦੇ ਘਰ ਭੇਜ ਦਿੱਤੇ ਅਤੇ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "सुता सहित सौपे सुत तिह घर ॥",
      "sourceLineId": "129944",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਛੁ ਬਿਦ੍ਯਾ ਦਿਜਿ ਦੇਹੁ ਕ੍ਰਿਪਾ ਕਰਿ ॥੭॥",
      "transliteration": "kachh bidhayaa dhij dheh kirapaa kar ||7||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸ੍ਰੇਸ਼ਠ ਪੰਡਿਤ! ਮਿਹਰਬਾਨੀ ਕਰ ਕੇ ਇਨ੍ਰਹਾ ਨੂੰ ਕੁਝ ਵਿਦਿਆ ਦਾ ਦਾਨ ਦਿਓ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1191,
      "hindi": "",
      "hindiTransliteration": "कछु बिद्या दिजि देहु कृपा करि ॥७॥",
      "sourceLineId": "129945",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1191_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਬ ਤੇ ਤਹ ਪੜਬੇ ਕਹ ਆਵੈ ॥",
      "transliteration": "jab te teh paRabe keh aavai ||",
      "translation": "",
