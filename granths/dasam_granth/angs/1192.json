{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1192,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1192_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਪਨੋ ਬਿਪ ਕਹ ਸੀਸ ਝੁਕਾਵੈ ॥",
      "transliteration": "apano bip keh sees jhukaavai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਆਪਣਾ ਸਿਰ ਬ੍ਰਾਹਮਣ ਅਗੇ ਝੁਕਾਉਾਂਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "अपनो बिप कह सीस झुकावै ॥",
      "sourceLineId": "129947",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜੋ ਸਿਖ੍ਯਾ ਦਿਜ ਦੇਤ ਸੁ ਲੇਹੀ ॥",
      "transliteration": "jo sikhayaa dhij dhet su lehee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸਿਖਿਆ ਬ੍ਰਾਹਮਣ ਦਿੰਦਾ ਸੀ, ਉਹੀ ਪ੍ਰਾਪਤ ਕਰਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "जो सिख्या दिज देत सु लेही ॥",
      "sourceLineId": "129948",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਮਿਤ ਦਰਬ ਪੰਡਿਤ ਕਹ ਦੇਹੀ ॥੮॥",
      "transliteration": "amit dharab pa(n)ddit keh dhehee ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬ੍ਰਾਹਮਣ ਨੂੰ ਬਹੁਤ ਧਨ ਦਿੰਦੇ ਸਨ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "अमित दरब पंडित कह देही ॥८॥",
      "sourceLineId": "129949",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਕ ਦਿਨ ਕੁਅਰਿ ਅਗਮਨੋ ਗਈ ॥",
      "transliteration": "eik dhin kuar agamano giee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਰਾਜ ਕੁਮਾਰੀ ਪਹਿਲਾ ਚਲੀ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "इक दिन कुअरि अगमनो गई ॥",
      "sourceLineId": "129950",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦਿਜ ਕਹ ਸੀਸ ਝੁਕਾਵਤ ਭਈ ॥",
      "transliteration": "dhij keh sees jhukaavat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬ੍ਰਾਹਮਣ ਨੂੰ ਸਿਰ ਝੁਕਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "दिज कह सीस झुकावत भई ॥",
      "sourceLineId": "129951",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਾਲਿਗ੍ਰਾਮ ਪੂਜਤ ਥਾ ਦਿਜਬਰ ॥",
      "transliteration": "saaligraam poojat thaa dhijabar ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਾਹਮਣ ਭਾਤ ਭਾਤ ਨਾਲ ਸਿਰ ਨਿਵਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "सालिग्राम पूजत था दिजबर ॥",
      "sourceLineId": "129952",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਿਹ ਸੀਸ ਨ੍ਯਾਇ ਕਰਿ ॥੯॥",
      "transliteration": "bhaat bhaat teh sees nayai kar ||9||",
      "translation": "",
      "punjabiViakhya": "ਸਾਲਗ੍ਰਾਮ ਦੀ ਪੂਜਾ ਕਰ ਰਿਹਾ ਸੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तिह सीस न्याइ करि ॥९॥",
      "sourceLineId": "129953",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਾ ਕੌ ਨਿਰਖਿ ਕੁਅਰਿ ਮੁਸਕਾਨੀ ॥",
      "transliteration": "taa kau nirakh kuar musakaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਰਾਜ ਕੁਮਾਰੀ ਹਸ ਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "ता कौ निरखि कुअरि मुसकानी ॥",
      "sourceLineId": "129954",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੋ ਪ੍ਰਤਿਮਾ ਪਾਹਨ ਪਹਿਚਾਨੀ ॥",
      "transliteration": "so pratimaa paahan pahichaanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਮੂਰਤੀ ਨੂੰ ਪੱਥਰ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "सो प्रतिमा पाहन पहिचानी ॥",
      "sourceLineId": "129955",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਾਹਿ ਕਹਾ ਪੂਜਤ ਕਿਹ ਨਮਿਤਿਹ ॥",
      "transliteration": "taeh kahaa poojat keh namiteh ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਬ੍ਰਾਹਮਣ) ਨੂੰ ਪੁੱਛਣ ਲਗੀ ਕਿ ਇਸ ਨੂੰ ਕਿਸ ਨਿਮਿਤ ਪੂਜ ਰਹੇ ਹੋ",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "ताहि कहा पूजत किह नमितिह ॥",
      "sourceLineId": "129956",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਿਰ ਨਾਵਤ ਕਰ ਜੋਰਿ ਕਾਜ ਜਿਹ ॥੧੦॥",
      "transliteration": "sir naavat kar jor kaaj jeh ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਸ ਲਈ ਹੱਥ ਜੋੜ ਕੇ ਸਿਰ ਨਿਵਾ ਰਹੇ ਹੋ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "सिर नावत कर जोरि काज जिह ॥१०॥",
      "sourceLineId": "129957",
      "sourceShabadId": "12342",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦਿਜ ਬਾਚ ॥",
      "transliteration": "dhij baach ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਾਹਮਣ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "दिज बाच ॥",
      "sourceLineId": "129958",
      "sourceShabadId": "12343",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਾਲਗ੍ਰਾਮ ਠਾਕੁਰ ਏ ਬਾਲਾ ॥",
      "transliteration": "saalagraam Thaakur e baalaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜ ਕੁਮਾਰੀ! ਇਹ ਸਾਲਗ੍ਰਾਮ ਠਾਕੁਰ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "सालग्राम ठाकुर ए बाला ॥",
      "sourceLineId": "129959",
      "sourceShabadId": "12343",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪੂਜਤ ਜਿਨੈ ਬਡੇ ਨਰਪਾਲਾ ॥",
      "transliteration": "poojat jinai badde narapaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੱਡੇ ਵੱਡੇ ਰਾਜੇ ਪੂਜਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "पूजत जिनै बडे नरपाला ॥",
      "sourceLineId": "129960",
      "sourceShabadId": "12343",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤੈ ਅਗ੍ਯਾਨ ਇਹ ਕਹਾ ਪਛਾਨੈ ॥",
      "transliteration": "tai agayaan ieh kahaa pachhaanai ||",
      "translation": "",
      "punjabiViakhya": "ਤੂੰ ਮੂਰਖ ਇਸ ਨੂੰ ਕੀ ਸਮਝੇਾਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "तै अग्यान इह कहा पछानै ॥",
      "sourceLineId": "129961",
      "sourceShabadId": "12343",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪਰਮੇਸ੍ਵਰ ਕਹ ਪਾਹਨ ਜਾਨੈ ॥੧੧॥",
      "transliteration": "paramesavair keh paahan jaanai ||11||",
      "translation": "",
      "punjabiViakhya": "ਪਰਮੇਸ਼੍ਵਰ ਨੂੰ ਪੱਥਰ ਸਮਝ ਰਹੀ ਹੈਂ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "परमेस्वर कह पाहन जानै ॥११॥",
      "sourceLineId": "129962",
      "sourceShabadId": "12343",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਾਜਾ ਸੁਤ ਬਾਚ ॥",
      "transliteration": "raajaa sut baach ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "राजा सुत बाच ॥",
      "sourceLineId": "129963",
      "sourceShabadId": "12344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਵੈਯਾ ॥",
      "transliteration": "savaiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੈਯਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "सवैया ॥",
      "sourceLineId": "129964",
      "sourceShabadId": "12344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਾਹਿ ਪਛਾਨਤ ਹੈ ਨ ਮਹਾ ਜੜ ਜਾ ਕੋ ਪ੍ਰਤਾਪ ਤਿਹੂੰ ਪੁਰ ਮਾਹੀ ॥",
      "transliteration": "taeh pachhaanat hai na mahaa jaR jaa ko prataap tihoo(n) pur maahee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮਹਾ ਮੂਰਖ! ਤੂੰ ਉਸ ਨੂੰ ਨਹੀਂ ਪਛਾਣਦਾ ਜਿਸ ਦਾ ਪ੍ਰਤਾਪ ਤਿੰਨਾ ਲੋਕਾ ਵਿਚ (ਪਸਰਿਆ ਹੋਇਆ) ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "ताहि पछानत है न महा जड़ जा को प्रताप तिहूँ पुर माही ॥",
      "sourceLineId": "129965",
      "sourceShabadId": "12344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪੂਜਤ ਹੈ ਪ੍ਰਭੁ ਕੈ ਤਿਸ ਕੌ ਜਿਨ ਕੇ ਪਰਸੇ ਪਰਲੋਕ ਪਰਾਹੀ ॥",
      "transliteration": "poojat hai prabh kai tis kau jin ke parase paralok paraahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਪ੍ਰਭੂ ਕਰ ਕੇ ਪੂਜਦਾ ਹੈਂ, ਜਿਸ ਦੇ ਪੂਜਣ ਨਾਲ ਪਰਲੋਕ (ਹੋਰ ਵੀ) ਦੂਰ ਹੋ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "पूजत है प्रभु कै तिस कौ जिन के परसे परलोक पराही ॥",
      "sourceLineId": "129966",
      "sourceShabadId": "12344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪਾਪ ਕਰੋ ਪਰਮਾਰਥ ਕੈ ਜਿਹ ਪਾਪਨ ਤੇ ਅਤਿ ਪਾਪ ਡਰਾਹੀ ॥",
      "transliteration": "paap karo paramaarath kai jeh paapan te at paap ddaraahee ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਮਾਰਥ ਲਈ ਪਾਪ ਕਰਦਾ ਹੈਂ, ਜਿਨ੍ਰਹਾ ਪਾਪਾ ਨੂੰ ਵੇਖ ਕੇ ਪਾਪ ਵੀ ਬਹੁਤ ਡਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "पाप करो परमारथ कै जिह पापन ते अति पाप डराही ॥",
      "sourceLineId": "129967",
      "sourceShabadId": "12344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪਾਇ ਪਰੋ ਪਰਮੇਸ੍ਵਰ ਕੇ ਪਸੁ ਪਾਹਨ ਮੈ ਪਰਮੇਸ੍ਵਰ ਨਾਹੀ ॥੧੨॥",
      "transliteration": "pai paro paramesavair ke pas paahan mai paramesavair naahee ||12||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮੂਰਖ! ਪਰਮੇਸ਼੍ਵਰ ਦੇ ਪੈਰਾ ਵਿਚ ਪੈ, ਪੱਥਰਾ ਵਿਚ ਪਰਮਾਤਮਾ ਨਹੀਂ ਹੈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "पाइ परो परमेस्वर के पसु पाहन मै परमेस्वर नाही ॥१२॥",
      "sourceLineId": "129968",
      "sourceShabadId": "12344",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਿਜੈ ਛੰਦ ॥",
      "transliteration": "bijai chha(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਜੈ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "बिजै छंद ॥",
      "sourceLineId": "129969",
      "sourceShabadId": "12345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜੀਵਨ ਮੈ ਜਲ ਮੈ ਥਲ ਮੈ ਸਭ ਰੂਪਨ ਮੈ ਸਭ ਭੂਪਨ ਮਾਹੀ ॥",
      "transliteration": "jeevan mai jal mai thal mai sabh roopan mai sabh bhoopan maahee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਪਰਮਾਤਮਾ) ਸਾਰਿਆਂ ਜੀਵਾ ਵਿਚ, ਜਲ ਵਿਚ, ਥਲ ਵਿਚ, ਸਭ ਰੂਪਾ ਵਿਚ ਅਤੇ ਸਾਰਿਆਂ ਰਾਜਿਆਂ ਵਿਚ,",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "जीवन मै जल मै थल मै सभ रूपन मै सभ भूपन माही ॥",
      "sourceLineId": "129970",
      "sourceShabadId": "12345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੂਰਜ ਮੈ ਸਸਿ ਮੈ ਨਭ ਮੈ ਜਹ ਹੇਰੌ ਤਹਾ ਚਿਤ ਲਾਇ ਤਹਾ ਹੀ ॥",
      "transliteration": "sooraj mai sas mai nabh mai jeh herau tahaa chit lai tahaa hee ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਜ ਵਿਚ, ਚੰਦ੍ਰਮਾ ਵਿਚ, ਆਕਾਸ਼ ਵਿਚ, ਜਿਥੇ ਵੇਖੋ, ਉਥੇ ਚਿਤ ਟਿਕਾਉਣ ਨਾਲ (ਪ੍ਰਾਪਤ ਕੀਤਾ ਜਾ ਸਕਦਾ ਹੈ)।",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "सूरज मै ससि मै नभ मै जह हेरौ तहा चित लाइ तहा ही ॥",
      "sourceLineId": "129971",
      "sourceShabadId": "12345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਾਵਕ ਮੈ ਅਰੁ ਪੌਨ ਹੂੰ ਮੈ ਪ੍ਰਿਥਵੀ ਤਲ ਮੈ ਸੁ ਕਹਾ ਨਹਿ ਜਾਹੀ ॥",
      "transliteration": "paavak mai ar pauan hoo(n) mai pirathavee tal mai su kahaa neh jaahee ||",
      "translation": "",
      "punjabiViakhya": "ਅਗਨੀ ਵਿਚ, ਪੌਣ ਵਿਚ, ਧਰਤੀ ਉਤੇ, (ਅਤੇ ਉਹ) ਕਿਹੜੀ ਥਾ ਤੇ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "पावक मै अरु पौन हूँ मै पृथवी तल मै सु कहा नहि जाही ॥",
      "sourceLineId": "129972",
      "sourceShabadId": "12345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬ੍ਯਾਪਕ ਹੈ ਸਭ ਹੀ ਕੇ ਬਿਖੈ ਕਛੁ ਪਾਹਨ ਮੈ ਪਰਮੇਸ੍ਵਵਰ ਨਾਹੀ ॥੧੩॥",
      "transliteration": "bayaapak hai sabh hee ke bikhai kachh paahan mai paramesavaivar naahee ||13||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸਭ ਵਿਚ ਵਿਆਪਕ ਹੈ, ਬਸ ਪੱਥਰਾ ਵਿਚ ਪਰਮਾਤਮਾ ਨਹੀਂ ਹੈ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "ब्यापक है सभ ही के बिखै कछु पाहन मै परमेस्ववर नाही ॥१३॥",
      "sourceLineId": "129973",
      "sourceShabadId": "12345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਾਗਜ ਦੀਪ ਸਭੈ ਕਰਿ ਕੈ ਅਰੁ ਸਾਤ ਸਮੁੰਦ੍ਰਨ ਕੀ ਮਸੁ ਕੈਯੈ ॥",
      "transliteration": "kaagaj dheep sabhai kar kai ar saat samu(n)dhran kee mas kaiyai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਦੀਪਾ (ਟਾਪੂਆਂ) ਨੂੰ ਕਾਗ਼ਜ਼ ਬਣਾ ਕੇ ਅਤੇ ਸੱਤ ਸਮੁੰਦਰਾ ਦੀ ਸਿਆਹੀ ਕਰ ਲਈਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "कागज दीप सभै करि कै अरु सात समुँद्रन की मसु कैयै ॥",
      "sourceLineId": "129974",
      "sourceShabadId": "12345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਾਟਿ ਬਨਾਸਪਤੀ ਸਿਗਰੀ ਲਿਖਬੇ ਹੂੰ ਕੌ ਲੇਖਨਿ ਕਾਜ ਬਨੈਯੈ ॥",
      "transliteration": "kaaT banaasapatee sigaree likhabe hoo(n) kau lekhan kaaj banaiyai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਬਨਸਪਤੀ ਨੂੰ ਕਟ ਕੇ ਲਿਖਣ ਲਈ ਕਲਮਾ ਬਣਾ ਲਈਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "काटि बनासपती सिगरी लिखबे हूँ कौ लेखनि काज बनैयै ॥",
      "sourceLineId": "129975",
      "sourceShabadId": "12345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਾਰਸ੍ਵਤੀ ਬਕਤਾ ਕਰਿ ਕੈ ਸਭ ਜੀਵਨ ਤੇ ਜੁਗ ਸਾਠਿ ਲਿਖੈਯੈ ॥",
      "transliteration": "saarasavaitee bakataa kar kai sabh jeevan te jug saaTh likhaiyai ||",
      "translation": "",
      "punjabiViakhya": "ਸਰਸਵਤੀ ਨੂੰ ਬੋਲਣ ਵਾਲਾ ਕਰ ਕੇ ਸਾਰਿਆਂ ਜੀਵਾ ਤੋਂ ਸਠ ਯੁਗਾ ਤਕ ਲਿਖਵਾਇਆ ਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "सारस्वती बकता करि कै सभ जीवन ते जुग साठि लिखैयै ॥",
      "sourceLineId": "129976",
      "sourceShabadId": "12345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜੋ ਪ੍ਰਭੁ ਪਾਯੁਤ ਹੈ ਨਹਿ ਕੈਸੇ ਹੂੰ ਸੋ ਜੜ ਪਾਹਨ ਮੌ ਠਹਰੈਯੈ ॥੧੪॥",
      "transliteration": "jo prabh paayut hai neh kaise hoo(n) so jaR paahan mau Thaharaiyai ||14||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ ਵੀ) ਜਿਸ ਪ੍ਰਭੂ ਨੂੰ ਕਿਸੇ ਤਰ੍ਰਹਾ ਪ੍ਰਾਪਤ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ, ਹੇ ਮੂਰਖ! ਉਸ ਨੂੰ ਪੱਥਰਾ ਵਿਚ ਸਥਿਤ ਕਰ ਰਿਹਾ ਹੈਂ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "जो प्रभु पायुत है नहि कैसे हूँ सो जड़ पाहन मौ ठहरैयै ॥१४॥",
      "sourceLineId": "129977",
      "sourceShabadId": "12345",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "129978",
      "sourceShabadId": "12346",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਏ ਜਨ ਭੇਵ ਨ ਹਰਿ ਕੋ ਪਾਵੈ ॥",
      "transliteration": "e jan bhev na har ko paavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਪੱਥਰ ਵਿਚ ਪਰਮਾਤਮਾ ਨੂੰ ਸਥਿਤ ਮੰਨਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "ए जन भेव न हरि को पावै ॥",
      "sourceLineId": "129979",
      "sourceShabadId": "12346",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪਾਹਨ ਮੈ ਹਰਿ ਕੌ ਠਹਰਾਵੈ ॥",
      "transliteration": "paahan mai har kau Thaharaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਵਿਅਕਤੀ ਪਰਮਾਤਮਾ ਦੇ ਭੇਦ ਨੂੰ ਨਹੀਂ ਸਮਝ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "पाहन मै हरि कौ ठहरावै ॥",
      "sourceLineId": "129980",
      "sourceShabadId": "12346",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਿਹ ਕਿਹ ਬਿਧਿ ਲੋਗਨ ਭਰਮਾਹੀ ॥",
      "transliteration": "jeh keh bidh logan bharamaahee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਲੋਕਾ ਨੂੰ ਭਰਮਾਉਾਂਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "जिह किह बिधि लोगन भरमाही ॥",
      "sourceLineId": "129981",
      "sourceShabadId": "12346",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗ੍ਰਿਹ ਕੋ ਦਰਬੁ ਲੂਟਿ ਲੈ ਜਾਹੀ ॥੧੫॥",
      "transliteration": "gireh ko dharab looT lai jaahee ||15||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘਰ ਨੂੰ ਧਨ ਲੁਟ ਕੇ ਲੈ ਜਾਦਾ ਹੈ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "गृह को दरबु लूटि लै जाही ॥१५॥",
      "sourceLineId": "129982",
      "sourceShabadId": "12346",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "129983",
      "sourceShabadId": "12347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਗ ਮੈ ਆਪੁ ਕਹਾਵਈ ਪੰਡਿਤ ਸੁਘਰ ਸੁਚੇਤ ॥",
      "transliteration": "jag mai aap kahaaviee pa(n)ddit sughar suchet ||",
      "translation": "",
      "punjabiViakhya": "ਜਗਤ ਵਿਚ (ਤੂੰ) ਆਪਣੇ ਆਪ ਨੂੰ ਵਿਦਵਾਨ, ਸੁਘੜ ਅਤੇ ਸਚੇਤ ਅਖਵਾਉਾਂਦਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "जग मै आपु कहावई पंडित सुघर सुचेत ॥",
      "sourceLineId": "129984",
      "sourceShabadId": "12347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪਾਹਨ ਕੀ ਪੂਜਾ ਕਰੈ ਯਾ ਤੇ ਲਗਤ ਅਚੇਤ ॥੧੬॥",
      "transliteration": "paahan kee poojaa karai yaa te lagat achet ||16||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਪੱਥਰਾ ਦੀ ਪੂਜਾ ਕਰਦਾ ਹੈਂ, ਇਸ ਲਈ ਮੂਰਖ ਲਗਦਾ ਹੈਂ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "पाहन की पूजा करै या ते लगत अचेत ॥१६॥",
      "sourceLineId": "129985",
      "sourceShabadId": "12347",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "129986",
      "sourceShabadId": "12348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚਿਤ ਭੀਤਰ ਆਸਾ ਧਨ ਧਾਰੈਂ ॥",
      "transliteration": "chit bheetar aasaa dhan dhaarai(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਤੂੰ) ਮਨ ਵਿਚ (ਧਨ ਆਦਿ ਦੀ) ਲਾਲਸਾ ਰਖਦਾ ਹੈਂ",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "चित भीतर आसा धन धारैं ॥",
      "sourceLineId": "129987",
      "sourceShabadId": "12348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਿਵ ਸਿਵ ਸਿਵ ਮੁਖ ਤੇ ਉਚਾਰੈਂ ॥",
      "transliteration": "siv siv siv mukh te uchaarai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੂੰਹੋਂ 'ਸ਼ਿਵ ਸ਼ਿਵ' ਦਾ ਉਚਾਰਨ ਕਰਦਾ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "सिव सिव सिव मुख ते उचारैं ॥",
      "sourceLineId": "129988",
      "sourceShabadId": "12348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਧਿਕ ਡਿੰਭ ਕਰਿ ਜਗਿ ਦਿਖਾਵੈਂ ॥",
      "transliteration": "adhik ddi(n)bh kar jag dhikhaavai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਪਾਖੰਡ ਕਰ ਕੇ ਸੰਸਾਰ ਨੂੰ ਵਿਖਾਉਾਂਦਾ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "अधिक डिंभ करि जगि दिखावैं ॥",
      "sourceLineId": "129989",
      "sourceShabadId": "12348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦ੍ਵਾਰ ਦ੍ਵਾਰ ਮਾਗਤ ਨ ਲਜਾਵੈਂ ॥੧੭॥",
      "transliteration": "dhavaiaar dhavaiaar maagat na lajaavai(n) ||17||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਦੁਆਰ ਦੁਆਰ ਉਤੇ ਮੰਗਣੋ ਸ਼ਰਮਾਉਾਂਦਾ ਨਹੀਂ ਹੈਂ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "द्वार द्वार मागत न लजावैं ॥१७॥",
      "sourceLineId": "129990",
      "sourceShabadId": "12348",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "129991",
      "sourceShabadId": "12349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਕ ਮੂੰਦਿ ਕਰਿ ਚਾਰਿ ਘਰੀ ਠਾਢੇ ਰਹੈ ॥",
      "transliteration": "naak moo(n)dh kar chaar gharee Thaadde rahai ||",
      "translation": "",
      "punjabiViakhya": "ਨਕ ਨੂੰ ਬੰਦ ਕਰ ਕੇ ਚਾਰ ਘੜੀਆਂ ਤਕ ਖੜੋਤਾ ਰਹਿੰਦਾ ਹੈਂ",
      "source": "DASAM_GRANTH",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": "नाक मूँदि करि चारि घरी ठाढे रहै ॥",
      "sourceLineId": "129992",
      "sourceShabadId": "12349",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1192_line_0047",
      "lineIndex": 47,
