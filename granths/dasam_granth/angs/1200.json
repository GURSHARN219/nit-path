{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1200,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1200_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਾਲ ਡੰਡ ਬਿਨ ਬਚਾ ਨ ਕੋਈ ॥",
      "transliteration": "kaal dda(n)dd bin bachaa na koiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਦੇ ਡੰਡੇ ਤੋਂ ਸ਼ਿਵ, ਬ੍ਰਹਮਾ, ਵਿਸ਼ਣੂ, ਇੰਦਰ ਆਦਿ",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "काल डंड बिन बचा न कोई ॥",
      "sourceLineId": "130355",
      "sourceShabadId": "12384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਿਵ ਬਿਰੰਚ ਬਿਸਨਿੰਦ੍ਰ ਨ ਸੋਈ ॥੧੦੨॥",
      "transliteration": "siv bira(n)ch bisani(n)dhr na soiee ||102||",
      "translation": "",
      "punjabiViakhya": "ਕੋਈ ਵੀ ਬਚ ਨਹੀਂ ਸਕਿਆ ॥੧੦੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "सिव बिरंच बिसनिंद्र न सोई ॥१०२॥",
      "sourceLineId": "130356",
      "sourceShabadId": "12384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜੈਸਿ ਜੂਨਿ ਇਕ ਦੈਤ ਬਖਨਿਯਤ ॥",
      "transliteration": "jais joon ik dhait bakhaniyat ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਇਕ ਦੈਂਤ ਜੂਨ ਕਹੀ ਜਾਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "जैसि जूनि इक दैत बखनियत ॥",
      "sourceLineId": "130357",
      "sourceShabadId": "12384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤ੍ਰਯੋ ਇਕ ਜੂਨਿ ਦੇਵਤਾ ਜਨਿਯਤ ॥",
      "transliteration": "trayo ik joon dhevataa janiyat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਤਰ੍ਰਹਾ ਇਕ ਦੇਵਤਾ ਜੂਨ ਵੀ ਜਾਣੀ ਜਾਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "त्रयो इक जूनि देवता जनियत ॥",
      "sourceLineId": "130358",
      "sourceShabadId": "12384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜੈਸੇ ਹਿੰਦੂਆਨੋ ਤੁਰਕਾਨਾ ॥",
      "transliteration": "jaise hi(n)dhooaano turakaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕੋਈ ਹਿੰਦੂ ਜਾ ਮੁਸਲਮਾਨ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "जैसे हिंदूआनो तुरकाना ॥",
      "sourceLineId": "130359",
      "sourceShabadId": "12384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਭਹਿਨ ਸੀਸ ਕਾਲ ਜਰਵਾਨਾ ॥੧੦੩॥",
      "transliteration": "sabhahin sees kaal jaravaanaa ||103||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਨ੍ਰਹਾ ਸਾਰਿਆਂ ਦੇ ਸਿਰ ਉਤੇ ਕਾਲ ਮਹਾਬਲੀ ਹੈ ॥੧੦੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "सभहिन सीस काल जरवाना ॥१०३॥",
      "sourceLineId": "130360",
      "sourceShabadId": "12384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਬਹੂੰ ਦੈਤ ਦੇਵਤਨ ਮਾਰੈਂ ॥",
      "transliteration": "kabahoo(n) dhait dhevatan maarai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਦੀ ਦੇਵਤਿਆਂ ਨੇ ਦੈਂਤਾ ਨੂੰ ਮਾਰਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "कबहूँ दैत देवतन मारैं ॥",
      "sourceLineId": "130361",
      "sourceShabadId": "12384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਬਹੂੰ ਦੈਤਨ ਦੇਵ ਸੰਘਾਰੈਂ ॥",
      "transliteration": "kabahoo(n) dhaitan dhev sa(n)ghaarai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਦੇ ਦੈਂਤਾ ਨੇ ਦੇਵਤਿਆਂ ਨੂੰ ਸੰਘਾਰਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "कबहूँ दैतन देव संघारैं ॥",
      "sourceLineId": "130362",
      "sourceShabadId": "12384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੇਵ ਦੈਤ ਜਿਨ ਦੋਊ ਸੰਘਾਰਾ ॥",
      "transliteration": "dhev dhait jin dhouoo sa(n)ghaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਦੇਵਤਿਆਂ ਅਤੇ ਦੈਂਤਾ ਦੋਹਾ ਨੂੰ ਮਾਰਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "देव दैत जिन दोऊ संघारा ॥",
      "sourceLineId": "130363",
      "sourceShabadId": "12384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਵਹੈ ਪੁਰਖ ਪ੍ਰਤਿਪਾਲ ਹਮਾਰਾ ॥੧੦੪॥",
      "transliteration": "vahai purakh pratipaal hamaaraa ||104||",
      "translation": "",
      "punjabiViakhya": "ਉਹ (ਕਾਲ) ਪੁਰਖ ਮੇਰਾ ਪ੍ਰਤਿਪਾਲਕ ਹੈ ॥੧੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "वहै पुरख प्रतिपाल हमारा ॥१०४॥",
      "sourceLineId": "130364",
      "sourceShabadId": "12384",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "130365",
      "sourceShabadId": "12385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਇੰਦ੍ਰ ਉਪਿੰਦ੍ਰ ਦਿਨਿੰਦ੍ਰਹਿ ਜੌਨ ਸੰਘਾਰਿਯੋ ॥",
      "transliteration": "ei(n)dhr upi(n)dhr dhini(n)dhreh jauan sa(n)ghaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਇੰਦਰ, ਉਪਿੰਦਰ (ਵਾਮਨ) ਸੂਰਜ,",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "इंद्र उपिंद्र दिनिंद्रहि जौन संघारियो ॥",
      "sourceLineId": "130366",
      "sourceShabadId": "12385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚੰਦ੍ਰ ਕੁਬੇਰ ਜਲਿੰਦ੍ਰ ਅਹਿੰਦ੍ਰਹਿ ਮਾਰਿਯੋ ॥",
      "transliteration": "cha(n)dhr kuber jali(n)dhr ahi(n)dhreh maariyo ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਦ੍ਰਮਾ, ਕੁਬੇਰ, ਵਰੁਣ ਅਤੇ ਸ਼ੇਸ਼ਨਾਗ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "चंद्र कुबेर जलिंद्र अहिंद्रहि मारियो ॥",
      "sourceLineId": "130367",
      "sourceShabadId": "12385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪੁਰੀ ਚੌਦਹੂੰ ਚਕ੍ਰ ਜਵਨ ਸੁਨਿ ਲੀਜਿਯੈ ॥",
      "transliteration": "puree chauadhahoo(n) chakr javan sun leejiyai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਚੌਦਾ ਲੋਕਾ ਵਿਚ ਚੱਕਰ ਚਲਦਾ ਸੁਣੀਂਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "पुरी चौदहूँ चक्र जवन सुनि लीजियै ॥",
      "sourceLineId": "130368",
      "sourceShabadId": "12385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਹੋ ਨਮਸਕਾਰ ਤਾਹੀ ਕੋ ਗੁਰ ਕਰਿ ਕੀਜਿਯੈ ॥੧੦੫॥",
      "transliteration": "ho namasakaar taahee ko gur kar keejiyai ||105||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਨੂੰ ਪ੍ਰਨਾਮ ਕਰ ਕੇ ਗੁਰੂ ਧਾਰਨ ਕਰਨਾ ਚਾਹੀਦਾ ਹੈ ॥੧੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "हो नमसकार ताही को गुर करि कीजियै ॥१०५॥",
      "sourceLineId": "130369",
      "sourceShabadId": "12385",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦਿਜ ਬਾਚ ॥",
      "transliteration": "dhij baach ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਾਹਮਣ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "दिज बाच ॥",
      "sourceLineId": "130370",
      "sourceShabadId": "12386",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130371",
      "sourceShabadId": "12386",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਬਿਪ੍ਰਹਿ ਕੋ ਸਮਝਾਯੋ ॥",
      "transliteration": "bahu bidh bipreh ko samajhaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜ ਕੁਮਾਰੀ ਨੇ) ਕਈ ਤਰ੍ਰਹਾ ਨਾਲ ਬ੍ਰਾਹਮਣ ਨੂੰ ਸਮਝਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि बिप्रहि को समझायो ॥",
      "sourceLineId": "130372",
      "sourceShabadId": "12386",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪੁਨਿ ਮਿਸ੍ਰਹਿ ਅਸ ਭਾਖਿ ਸੁਨਾਯੋ ॥",
      "transliteration": "pun misreh as bhaakh sunaayo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਬ੍ਰਾਹਮਣ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "पुनि मिस्रहि अस भाखि सुनायो ॥",
      "sourceLineId": "130373",
      "sourceShabadId": "12386",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੇ ਪਾਹਨ ਕੀ ਪੂਜਾ ਕਰਿ ਹੈ ॥",
      "transliteration": "je paahan kee poojaa kar hai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਪੱਥਰ ਦੀ ਪੂਜਾ ਕਰਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "जे पाहन की पूजा करि है ॥",
      "sourceLineId": "130374",
      "sourceShabadId": "12386",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਾ ਕੇ ਪਾਪ ਸਕਲ ਸਿਵ ਹਰਿ ਹੈ ॥੧੦੬॥",
      "transliteration": "taa ke paap sakal siv har hai ||106||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਸਾਰੇ ਪਾਪ ਸ਼ਿਵ ਖ਼ੁਦ ਦੂਰ ਕਰ ਦਿੰਦਾ ਹੈ ॥੧੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "ता के पाप सकल सिव हरि है ॥१०६॥",
      "sourceLineId": "130375",
      "sourceShabadId": "12386",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜੇ ਨਰ ਸਾਲਿਗ੍ਰਾਮ ਕਹ ਧਯੈਹੈ ॥",
      "transliteration": "je nar saaligraam keh dhayaihai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਵਿਅਕਤੀ ਸਾਲਿਗ੍ਰਾਮ ਨੂੰ ਧਿਆਏਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "जे नर सालिग्राम कह धयैहै ॥",
      "sourceLineId": "130376",
      "sourceShabadId": "12386",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਾ ਕੇ ਸਕਲ ਪਾਪ ਕੋ ਛੈਹੈ ॥",
      "transliteration": "taa ke sakal paap ko chhaihai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਸਾਰੇ ਪਾਪ ਖ਼ਤਮ ਹੈ ਜਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "ता के सकल पाप को छैहै ॥",
      "sourceLineId": "130377",
      "sourceShabadId": "12386",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜੋ ਇਹ ਛਾਡਿ ਅਵਰ ਕਹ ਧਯੈ ਹੈ ॥",
      "transliteration": "jo ieh chhaadd avar keh dhayai hai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਇਸ ਨੂੰ ਛਡ ਕੇ ਹੋਰ ਕਿਸੇ ਦਾ ਧਿਆਨ ਕਰੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "जो इह छाडि अवर कह धयै है ॥",
      "sourceLineId": "130378",
      "sourceShabadId": "12386",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤੇ ਨਰ ਮਹਾ ਨਰਕ ਮਹਿ ਜੈ ਹੈ ॥੧੦੭॥",
      "transliteration": "te nar mahaa narak meh jai hai ||107||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਪੁਰਸ਼ ਮਹਾ ਨਰਕ ਵਿਚ ਪਵੇਗਾ ॥੧੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "ते नर महा नरक महि जै है ॥१०७॥",
      "sourceLineId": "130379",
      "sourceShabadId": "12386",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੇ ਨਰ ਕਛੁ ਧਨ ਬਿਪ੍ਰਹਿ ਦੈ ਹੈ ॥",
      "transliteration": "je nar kachh dhan bipreh dhai hai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਵਿਅਕਤੀ ਬ੍ਰਾਹਮਣ ਨੂੰ ਕੁਝ ਧਨ ਦੇਵੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "जे नर कछु धन बिप्रहि दै है ॥",
      "sourceLineId": "130380",
      "sourceShabadId": "12386",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਆਗੇ ਮਾਗ ਦਸ ਗੁਨੋ ਲੈਹੈ ॥",
      "transliteration": "aage maag dhas guno laihai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਅਗਲੇ ਜਨਮ ਵਿਚ ਦਸ ਗੁਣਾ ਮੰਗ ਲਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "आगे माग दस गुनो लैहै ॥",
      "sourceLineId": "130381",
      "sourceShabadId": "12386",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜੋ ਬਿਪ੍ਰਨ ਬਿਨੁ ਅਨਤੈ ਦੇਹੀ ॥",
      "transliteration": "jo bipran bin anatai dhehee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਬ੍ਰਾਹਮਣ ਤੋਂ ਬਿਨਾ ਕਿਸੇ ਹੋਰ ਨੂੰ ਦੇਵੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "जो बिप्रन बिनु अनतै देही ॥",
      "sourceLineId": "130382",
      "sourceShabadId": "12386",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਾ ਕੌ ਕਛੁ ਸੁ ਫਲੈ ਨਹਿ ਸੇਈ ॥੧੦੮॥",
      "transliteration": "taa kau kachhu su falai neh seiee ||108||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਉਸ ਦਾ ਕੋਈ ਫਲ ਪ੍ਰਾਪਤ ਨਹੀਂ ਹੋਵੇਗਾ ॥੧੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "ता कौ कछु सु फलै नहि सेई ॥१०८॥",
      "sourceLineId": "130383",
      "sourceShabadId": "12386",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "130384",
      "sourceShabadId": "12387",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਬੈ ਕੁਅਰਿ ਪ੍ਰਤਿਮਾ ਸਿਵ ਕੀ ਕਰ ਮੈ ਲਈ ॥",
      "transliteration": "tabai kuar pratimaa siv kee kar mai liee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਸ਼ਿਵ ਦੀ ਮੂਰਤੀ ਹੱਥ ਵਿਚ ਲੈ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "तबै कुअरि प्रतिमा सिव की कर मै लई ॥",
      "sourceLineId": "130385",
      "sourceShabadId": "12387",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਹਸਿ ਹਸਿ ਕਰਿ ਦਿਜ ਕੇ ਮੁਖ ਕਸਿ ਕਸਿ ਕੈ ਦਈ ॥",
      "transliteration": "has has kar dhij ke mukh kas kas kai dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹਸ ਹਸ ਕੇ ਬ੍ਰਾਹਮਣ ਦੇ ਮੂੰਹ ਉਤੇ ਕਸ ਕਸ ਕੇ ਮਾਰੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "हसि हसि करि दिज के मुख कसि कसि कै दई ॥",
      "sourceLineId": "130386",
      "sourceShabadId": "12387",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਾਲਿਗ੍ਰਾਮ ਭੇ ਦਾਤਿ ਫੋਰਿ ਸਭ ਹੀ ਦੀਏ ॥",
      "transliteration": "saaligraam bhe dhaat for sabh hee dhe'ee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਲਿਗ੍ਰਾਮ ਨਾਲ (ਬ੍ਰਾਹਮਣ ਦੇ) ਸਾਰੇ ਦੰਦ ਭੰਨ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "सालिग्राम भे दाति फोरि सभ ही दीए ॥",
      "sourceLineId": "130387",
      "sourceShabadId": "12387",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਹੋ ਛੀਨਿ ਛਾਨਿ ਕਰਿ ਬਸਤ੍ਰ ਮਿਸ੍ਰ ਕੇ ਸਭ ਲੀਏ ॥੧੦੯॥",
      "transliteration": "ho chheen chhaan kar basatr misr ke sabh le'ee ||109||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬ੍ਰਾਹਮਣ ਦੇ ਸਾਰੇ ਬਸਤ੍ਰ (ਅਤੇ ਦਰਬ) ਖੋਹ ਖਾਹ ਲਏ ॥੧੦੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "हो छीनि छानि करि बसत्र मिस्र के सभ लीए ॥१०९॥",
      "sourceLineId": "130388",
      "sourceShabadId": "12387",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਹੋ ਮਿਸ੍ਰ ਅਬ ਰੁਦ੍ਰ ਤਿਹਾਰੋ ਕਹ ਗਯੋ ॥",
      "transliteration": "kaho misr ab rudhr tihaaro keh gayo ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿਣ ਲਗੀ) ਹੇ ਬ੍ਰਾਹਮਣ! ਦਸ, ਹੁਣ ਤੇਰਾ ਸ਼ਿਵ ਕਿਥੇ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "कहो मिस्र अब रुद्र तिहारो कह गयो ॥",
      "sourceLineId": "130389",
      "sourceShabadId": "12387",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਿਹ ਸੇਵਤ ਥੋ ਸਦਾ ਦਾਤਿ ਛੈ ਤਿਨ ਕਿਯੋ ॥",
      "transliteration": "jeh sevat tho sadhaa dhaat chhai tin kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ (ਤੂੰ) ਸਦਾ ਪੂਜਦਾ ਸੈਂ, ਉਸ ਨੇ (ਤੇਰੇ) ਦੰਦ ਭੰਨ ਦਿੱਤੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "जिह सेवत थो सदा दाति छै तिन कियो ॥",
      "sourceLineId": "130390",
      "sourceShabadId": "12387",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਹ ਲਿੰਗਹਿ ਕੌ ਜਪਤੇ ਕਾਲ ਬਤਾਇਯੋ ॥",
      "transliteration": "jeh li(n)geh kau japate kaal bataiyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਲਿੰਗ ਦੀ ਪੂਜਾ ਕਰਦਿਆਂ (ਤੂੰ ਇਤਨਾ) ਸਮਾ ਬਿਤਾਇਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "जिह लिंगहि कौ जपते काल बताइयो ॥",
      "sourceLineId": "130391",
      "sourceShabadId": "12387",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹੋ ਅੰਤ ਕਾਲ ਸੋ ਤੁਮਰੇ ਮੁਖ ਮਹਿ ਆਇਯੋ ॥੧੧੦॥",
      "transliteration": "ho a(n)t kaal so tumare mukh meh aaiyo ||110||",
      "translation": "",
      "punjabiViakhya": "ਉਹੀ ਅੰਤ ਨੂੰ ਤੇਰੇ ਮੂੰਹ ਵਿਚ ਆਇਆ ਹੈ (ਅਰਥਾਤ ਤੇਰੇ ਮੂੰਹ ਉਤੇ ਆ ਕੇ ਵਜਿਆ ਹੈ) ॥੧੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "हो अंत काल सो तुमरे मुख महि आइयो ॥११०॥",
      "sourceLineId": "130392",
      "sourceShabadId": "12387",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130393",
      "sourceShabadId": "12388",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਾ ਕੋ ਦਰਬੁ ਛੀਨਿ ਜੋ ਲਿਯੋ ॥",
      "transliteration": "taa ko dharab chheen jo liyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਬ੍ਰਾਹਮਣ) ਦਾ ਜੋ ਦਰਬ (ਦੌਲਤ) ਧਨ ਖੋਹਿਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "ता को दरबु छीनि जो लियो ॥",
      "sourceLineId": "130394",
      "sourceShabadId": "12388",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜੋ ਸਭ ਦਾਨ ਦਿਜਨ ਕਰਿ ਦਿਯੋ ॥",
      "transliteration": "jo sabh dhaan dhijan kar dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸਭ ਬ੍ਰਾਹਮਣਾ ਨੂੰ ਦਾਨ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "जो सभ दान दिजन करि दियो ॥",
      "sourceLineId": "130395",
      "sourceShabadId": "12388",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਹਿਯੋ ਮਿਸ੍ਰ ਕਛੁ ਚਿੰਤ ਨ ਕਰਹੂੰ ॥",
      "transliteration": "kahiyo misr kachh chi(n)t na karahoo(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਹਾ ਹੇ ਬ੍ਰਾਹਮਣ! (ਧਨ ਦੀ) ਕੁਝ ਵੀ ਚਿੰਤਾ ਨਾ ਕਰੋ",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "कहियो मिस्र कछु चिंत न करहूँ ॥",
      "sourceLineId": "130396",
      "sourceShabadId": "12388",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦਾਨ ਦਸ ਗੁਨੋ ਆਗੈ ਫਰਹੂੰ ॥੧੧੧॥",
      "transliteration": "dhaan dhas guno aagai farahoo(n) ||111||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ) ਅਗਲੇ ਜਨਮ ਵਿਚ ਇਹ ਦਸ ਗੁਣਾ ਹੋ ਕੇ ਫਲੇਗਾ ॥੧੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "दान दस गुनो आगै फरहूँ ॥१११॥",
      "sourceLineId": "130397",
      "sourceShabadId": "12388",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਬਿਤੁ ॥",
      "transliteration": "kabit ||",
      "translation": "",
      "punjabiViakhya": "ਕਬਿੱਤ:",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "कबितु ॥",
      "sourceLineId": "130398",
      "sourceShabadId": "12389",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਔਰਨ ਕੋ ਕਹਤ ਲੁਟਾਵੋ ਤੁਮ ਖਾਹੁ ਧਨ ਆਪੁ ਪਹਿਤੀ ਮੈ ਡਾਰਿ ਖਾਤ ਨ ਬਿਸਾਰ ਹੈਂ ॥",
      "transliteration": "aauaran ko kahat luTaavo tum khaahu dhan aap pahitee mai ddaar khaat na bisaar hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰਨਾ ਨੂੰ ਕਹਿੰਦੇ ਹਨ ਕਿ ਤੁਸੀਂ ਖੂਬ ਧਨ ਲੁਟਾਓ, ਪਰ ਆਪ ਧਨ ਨੂੰ ਖਾਉਾਂਦੇ ਹਨ (ਅਰਥਾਤ-ਮੌਜ ਨਾਲ ਵਰਤਦੇ ਹਨ) (ਅਤੇ ਕੰਜੂਸ ਇਤਨੇ ਹਨ ਕਿ) ਦਾਲ ('ਪਹਿਤੀ') ਵਿਚ ਹਲਦੀ ('ਬਿਸਾਰ') ਪਾ ਕੇ ਨਹੀਂ ਖਾਉਾਂਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "औरन को कहत लुटावो तुम खाहु धन आपु पहिती मै डारि खात न बिसार हैं ॥",
      "sourceLineId": "130399",
      "sourceShabadId": "12389",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬਡੇ ਹੀ ਪ੍ਰਪੰਚੀ ਪਰਪਚੰਨ ਕੋ ਲੀਏ ਫਿਰੈ ਦਿਨ ਹੀ ਮੈ ਲੋਗਨ ਕੋ ਲੂਟਤ ਬਜਾਰ ਹੈਂ ॥",
      "transliteration": "badde hee prapa(n)chee parapacha(n)n ko le'ee firai dhin hee mai logan ko looTat bajaar hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਵੱਡੇ ਪ੍ਰਪੰਚੀ ਹਨ ਅਤੇ ਪ੍ਰਪੰਚਾ (ਪਾਖੰਡਾ) ਦਾ ਹੀ ਪ੍ਰਦਰਸ਼ਨ ਕਰਦੇ ਫਿਰਦੇ ਹਨ ਅਤੇ ਦਿਨ ਵਿਚ ਹੀ ਲੋਕਾ ਨੂੰ ਬਾਜ਼ਾਰ ਵਿਚ ਲੁਟ ਲੈਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "बडे ही प्रपंची परपचंन को लीए फिरै दिन ही मै लोगन को लूटत बजार हैं ॥",
      "sourceLineId": "130400",
      "sourceShabadId": "12389",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਾਥ ਤੇ ਨ ਕੌਡੀ ਦੇਤ ਕੌਡੀ ਕੌਡੀ ਮਾਗ ਲੇਤ ਪੁਤ੍ਰੀ ਕਹਤ ਤਾ ਸੋ ਕਰੈ ਬਿਭਚਾਰ ਹੈਂ ॥",
      "transliteration": "haath te na kauaddee dhet kauaddee kauaddee maag let putree kahat taa so karai bibhachaar hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਹੱਥੋਂ ਕੌਡੀ ਨਹੀਂ ਦਿੰਦੇ, (ਪਰ ਸਭ ਤੋਂ) ਕੌਡੀ ਕੌਡੀ ਮੰਗ ਲੈਂਦੇ ਹਨ। (ਜਿਸ ਨੂੰ) ਪੁੱਤਰੀ ਕਹਿੰਦੇ ਹਨ, ਉਸ ਨਾਲ ਵਿਭਚਾਰ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "हाथ ते न कौडी देत कौडी कौडी माग लेत पुत्री कहत ता सो करै बिभचार हैं ॥",
      "sourceLineId": "130401",
      "sourceShabadId": "12389",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਲੋਭਤਾ ਕੇ ਜਏ ਹੈਂ ਕਿ ਮਮਤਾ ਕੇ ਭਏ ਹੈਂ ਏ ਸੂਮਤਾ ਕੇ ਪੁਤ੍ਰ ਕੈਧੌ ਦਰਿਦ੍ਰਾਵਤਾਰ ਹੈਂ ॥੧੧੨॥",
      "transliteration": "lobhataa ke je hai(n) k mamataa ke bhe hai(n) e soomataa ke putr kaidhau dharidhraavataar hai(n) ||112||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ ਇਹ) ਲੋਭ ਦੇ ਪੈਦਾ ਕੀਤੇ ਹੋਏ ਸੁਆਰਥੀ ਬਣੇ ਫਿਰਦੇ ਹਨ। (ਇਹ) ਕੰਜੂਸੀ ਦੇ ਪੁੱਤਰ ਜਾ ਦਰਿਦ੍ਰਤਾ ਦੇ ਅਵਤਾਰ ਹਨ ॥੧੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "लोभता के जए हैं कि ममता के भए हैं ए सूमता के पुत्र कैधौ दरिद्रावतार हैं ॥११२॥",
      "sourceLineId": "130402",
      "sourceShabadId": "12389",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130403",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਪਹਤੀ ਬਿਖੈ ਬਿਸਾਰ ਨ ਡਾਰਹਿ ॥",
      "transliteration": "pahatee bikhai bisaar na ddaareh ||",
      "translation": "",
      "punjabiViakhya": "(ਆਪ ਤਾ) ਦਾਲ ਵਿਚ ਹਲਦੀ ਨਹੀਂ ਪਾਉਾਂਦੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "पहती बिखै बिसार न डारहि ॥",
      "sourceLineId": "130404",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਔਰਨ ਪਾਸ ਗਾਲ ਕੋ ਮਾਰਹਿ ॥",
      "transliteration": "aauaran paas gaal ko maareh ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਹੋਰਨਾ ਪਾਸ ਸ਼ੇਖੀ ਮਾਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "औरन पास गाल को मारहि ॥",
      "sourceLineId": "130405",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਨਿਯਤ ਕਿਸੀ ਦੇਸ ਕੇ ਰਾਜਾ ॥",
      "transliteration": "janiyat kisee dhes ke raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਲਗਦੇ ਤਾ ਕਿਸੇ ਦੇਸ਼ ਦੇ ਰਾਜੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "जनियत किसी देस के राजा ॥",
      "sourceLineId": "130406",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕੌਡੀ ਕੇ ਆਵਤ ਨਹਿ ਕਾਜਾ ॥੧੧੩॥",
      "transliteration": "kauaddee ke aavat neh kaajaa ||113||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਕੌਡੀ ਦੇ ਕੰਮ ਵੀ ਨਹੀਂ ਆਉਾਂਦੇ ॥੧੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "कौडी के आवत नहि काजा ॥११३॥",
      "sourceLineId": "130407",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜੌ ਇਨ ਮੰਤ੍ਰ ਜੰਤ੍ਰ ਸਿਧਿ ਹੋਈ ॥",
      "transliteration": "jau in ma(n)tr ja(n)tr sidh hoiee ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਇਨ੍ਰਹਾ ਮੰਤ੍ਰਾ ਜੰਤ੍ਰਾ ਤੋਂ ਸਿੱਧੀ ਪ੍ਰਾਪਤ ਹੁੰਦੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "जौ इन मंत्र जंत्र सिधि होई ॥",
      "sourceLineId": "130408",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਦਰ ਦਰ ਭੀਖਿ ਨ ਮਾਗੈ ਕੋਈ ॥",
      "transliteration": "dhar dhar bheekh na maagai koiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਕੋਈ ਦਰ ਦਰ ਭਿਖ ਨਾ ਮੰਗਦਾ ਫਿਰਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "दर दर भीखि न मागै कोई ॥",
      "sourceLineId": "130409",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਏਕੈ ਮੁਖ ਤੇ ਮੰਤ੍ਰ ਉਚਾਰੈ ॥",
      "transliteration": "ekai mukh te ma(n)tr uchaarai ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਖ ਤੋਂ ਇਕੋ ਮੰਤ੍ਰ ਉਚਾਰਨ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "एकै मुख ते मंत्र उचारै ॥",
      "sourceLineId": "130410",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਧਨ ਸੌ ਸਕਲ ਧਾਮ ਭਰਿ ਡਾਰੈ ॥੧੧੪॥",
      "transliteration": "dhan sau sakal dhaam bhar ddaarai ||114||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਘਰ ਨੂੰ ਧਨ ਨਾਲ ਭਰ ਲੈਂਦੇ ਹਨ ॥੧੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "धन सौ सकल धाम भरि डारै ॥११४॥",
      "sourceLineId": "130411",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਰਾਮ ਕ੍ਰਿਸਨ ਏ ਜਿਨੈ ਬਖਾਨੈ ॥",
      "transliteration": "raam kirasan e jinai bakhaanai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ, ਕ੍ਰਿਸ਼ਨ, ਇਹ ਜਿਤਨੇ ਹੀ ਦਸੇ ਜਾਦੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "राम कृसन ए जिनै बखानै ॥",
      "sourceLineId": "130412",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਸਿਵ ਬ੍ਰਹਮਾ ਏ ਜਾਹਿ ਪ੍ਰਮਾਨੈ ॥",
      "transliteration": "siv brahamaa e jaeh pramaanai ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ, ਬ੍ਰਹਮਾ ਆਦਿ।",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "सिव ब्रहमा ए जाहि प्रमानै ॥",
      "sourceLineId": "130413",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਤੇ ਸਭ ਹੀ ਸ੍ਰੀ ਕਾਲ ਸੰਘਾਰੇ ॥",
      "transliteration": "te sabh hee sree kaal sa(n)ghaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਸਭ ਨੂੰ ਕਾਲ ਨੇ ਮਾਰ ਦਿੱਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "ते सभ ही स्री काल संघारे ॥",
      "sourceLineId": "130414",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਕਾਲ ਪਾਇ ਕੈ ਬਹੁਰਿ ਸਵਾਰੇ ॥੧੧੫॥",
      "transliteration": "kaal pai kai bahur savaare ||115||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਾਲ ਨੇ ਹੀ ਉਨ੍ਰਹਾ ਨੂੰ ਫਿਰ ਸਾਜਿਆ ਹੈ ॥੧੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "काल पाइ कै बहुरि सवारे ॥११५॥",
      "sourceLineId": "130415",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਕੇਤੇ ਰਾਮਚੰਦ ਅਰੁ ਕ੍ਰਿਸਨਾ ॥",
      "transliteration": "kete raamacha(n)dh ar kirasanaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਰਾਮ ਚੰਦ੍ਰ, ਕ੍ਰਿਸ਼ਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "केते रामचंद अरु कृसना ॥",
      "sourceLineId": "130416",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਕੇਤੇ ਚਤੁਰਾਨਨ ਸਿਵ ਬਿਸਨਾ ॥",
      "transliteration": "kete chaturaanan siv bisanaa ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਹਮਾ, ਸ਼ਿਵ ਅਤੇ ਵਿਸ਼ਣੂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "केते चतुरानन सिव बिसना ॥",
      "sourceLineId": "130417",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਚੰਦ ਸੂਰਜ ਏ ਕਵਨ ਬਿਚਾਰੇ ॥",
      "transliteration": "cha(n)dh sooraj e kavan bichaare ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਦ੍ਰਮਾ ਅਤੇ ਸੂਰਜ ਵਿਚਾਰੇ ਕੀ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "चंद सूरज ए कवन बिचारे ॥",
      "sourceLineId": "130418",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਪਾਨੀ ਭਰਤ ਕਾਲ ਕੇ ਦ੍ਵਾਰੇ ॥੧੧੬॥",
      "transliteration": "paanee bharat kaal ke dhavaiaare ||116||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਸਾਰੇ ਕਾਲ ਦੇ ਦੁਆਰ ਉਤੇ ਪਾਣੀ ਭਰਦੇ ਹਨ ॥੧੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "पानी भरत काल के द्वारे ॥११६॥",
      "sourceLineId": "130419",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਕਾਲ ਪਾਇ ਸਭ ਹੀ ਏ ਭਏ ॥",
      "transliteration": "kaal pai sabh hee e bhe ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਦੇ ਪ੍ਰਾਪਤ ਹੋਣ ਤੇ ਹੀ ਇਹ ਸਭ ਹੋਂਦ ਵਿਚ ਆਏ",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "काल पाइ सभ ही ए भए ॥",
      "sourceLineId": "130420",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਕਾਲੋ ਪਾਇ ਕਾਲ ਹ੍ਵੈ ਗਏ ॥",
      "transliteration": "kaalo pai kaal havai ge ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਾਲ ਦੇ ਪ੍ਰਾਪਤ ਹੋਣ ਤੇ ਇਹ ਕਾਲ-ਵਸ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "कालो पाइ काल ह्वै गए ॥",
      "sourceLineId": "130421",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਕਾਲਹਿ ਪਾਇ ਬਹੁਰਿ ਅਵਤਰਿ ਹੈ ॥",
      "transliteration": "kaaleh pai bahur avatar hai ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਦੇ ਪ੍ਰਾਪਤ ਹੋਣ ਤੇ ਫਿਰ ਪ੍ਰਗਟ ਹੁੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "कालहि पाइ बहुरि अवतरि है ॥",
      "sourceLineId": "130422",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਕਾਲਹਿ ਕਾਲ ਪਾਇ ਸੰਘਰਿ ਹੈ ॥੧੧੭॥",
      "transliteration": "kaaleh kaal pai sa(n)ghar hai ||117||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਦੇ ਪ੍ਰਾਪਤ ਹੋਣ ਤੇ ਫਿਰ ਕਾਲ ਦੁਆਰਾ ਮਾਰੇ ਜਾਦੇ ਹਨ ॥੧੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "कालहि काल पाइ संघरि है ॥११७॥",
      "sourceLineId": "130423",
      "sourceShabadId": "12390",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1200,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "130424",
      "sourceShabadId": "12391",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1200_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਸ੍ਰਾਪ ਰਾਛਸੀ ਕੇ ਦਏ ਜੋ ਭਯੋ ਪਾਹਨ ਜਾਇ ॥",
      "transliteration": "sraap raachhasee ke dhe jo bhayo paahan jai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਕ) ਰਾਖਸ਼ੀ ਦੇ ਸ੍ਰਾਪ ਦੇਣ ਤੇ ਜੋ ਪੱਥਰ ਬਣ ਜਾਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1200,
