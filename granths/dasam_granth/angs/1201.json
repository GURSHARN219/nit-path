{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1201,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1201_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦਿਜ ਬਾਚ ॥",
      "transliteration": "dhij baach ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਾਹਮਣ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "दिज बाच ॥",
      "sourceLineId": "130427",
      "sourceShabadId": "12392",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130428",
      "sourceShabadId": "12392",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਬ ਦਿਜ ਅਧਿਕ ਕੋਪ ਹ੍ਵੈ ਗਯੋ ॥",
      "transliteration": "tab dhij adhik kop havai gayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਬ੍ਰਾਹਮਣ ਬਹੁਤ ਕ੍ਰੋਧਵਾਨ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "तब दिज अधिक कोप ह्वै गयो ॥",
      "sourceLineId": "130429",
      "sourceShabadId": "12392",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭਰਭਰਾਇ ਠਾਢਾ ਉਠਿ ਭਯੋ ॥",
      "transliteration": "bharabharai Thaaddaa uTh bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘਬਰਾ ('ਭਰਭਰਾਇ') ਕੇ ਉਠ ਖੜੋਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "भरभराइ ठाढा उठि भयो ॥",
      "sourceLineId": "130430",
      "sourceShabadId": "12392",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਬ ਮੈ ਇਹ ਰਾਜਾ ਪੈ ਜੈਹੌ ॥",
      "transliteration": "ab mai ieh raajaa pai jaihau ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿਣ ਲਗਿਆ) ਹੁਣ ਮੈਂ ਇਸ ਰਾਜੇ ਕੋਲ ਜਾਦਾ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "अब मै इह राजा पै जैहौ ॥",
      "sourceLineId": "130431",
      "sourceShabadId": "12392",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਹੀ ਬਾਧਿ ਕਰਿ ਤੋਹਿ ਮੰਗੈ ਹੌ ॥੧੧੯॥",
      "transliteration": "tahee baadh kar toh ma(n)gai hau ||119||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੈਨੂੰ ਬੰਨ੍ਰਹਵਾ ਕੇ ਉਥੇ ਹੀ ਮੰਗਵਾਉਾਂਦਾ ਹਾ ॥੧੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "तही बाधि करि तोहि मंगै हौ ॥११९॥",
      "sourceLineId": "130432",
      "sourceShabadId": "12392",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕੁਅਰਿ ਬਾਚ ॥",
      "transliteration": "kuar baach ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "कुअरि बाच ॥",
      "sourceLineId": "130433",
      "sourceShabadId": "12393",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਬ ਤਿਨ ਕੁਅਰਿ ਦਿਜਹਿ ਗਹਿ ਲਿਆ ॥",
      "transliteration": "tab tin kuar dhijeh geh liaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਬ੍ਰਾਹਮਣ ਨੂੰ ਪਕੜ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "तब तिन कुअरि दिजहि गहि लिआ ॥",
      "sourceLineId": "130434",
      "sourceShabadId": "12393",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਡਾਰ ਨਦੀ ਕੇ ਭੀਤਰ ਦਿਯਾ ॥",
      "transliteration": "ddaar nadhee ke bheetar dhiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਦੀ ਵਿਚ ਸੁਟ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "डार नदी के भीतर दिया ॥",
      "sourceLineId": "130435",
      "sourceShabadId": "12393",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗੋਤਾ ਪਕਰਿ ਆਠ ਸੈ ਦੀਨਾ ॥",
      "transliteration": "gotaa pakar aaTh sai dheenaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਪਕੜ ਕੇ ਅੱਠ ਸੌ ਗ਼ੋਤੇ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "गोता पकरि आठ सै दीना ॥",
      "sourceLineId": "130436",
      "sourceShabadId": "12393",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਾਹਿ ਪਵਿਤ੍ਰ ਭਲੀ ਬਿਧਿ ਕੀਨਾ ॥੧੨੦॥",
      "transliteration": "taeh pavitr bhalee bidh keenaa ||120||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਪਵਿਤ੍ਰ ਕੀਤਾ ॥੧੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "ताहि पवित्र भली बिधि कीना ॥१२०॥",
      "sourceLineId": "130437",
      "sourceShabadId": "12393",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਹੀ ਕੁਅਰਿ ਪਿਤੁ ਪਹਿ ਮੈ ਜੈ ਹੌਂ ॥",
      "transliteration": "kahee kuar pit peh mai jai haua(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਕਹਿਣ ਲਗੀ ਕਿ ਮੈਂ ਪਿਤਾ ਕੋਲ ਜਾਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "कही कुअरि पितु पहि मै जै हौं ॥",
      "sourceLineId": "130438",
      "sourceShabadId": "12393",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤੈ ਮੁਹਿ ਡਾਰਾ ਹਾਥ ਬਤੈ ਹੌਂ ॥",
      "transliteration": "tai muh ddaaraa haath batai haua(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦਸਾਗੀ ਕਿ ਤੂੰ ਮੈਨੂੰ ਹੱਥ ਪਾਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "तै मुहि डारा हाथ बतै हौं ॥",
      "sourceLineId": "130439",
      "sourceShabadId": "12393",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤੇਰੇ ਦੋਨੋ ਹਾਥ ਕਟਾਊਾਂ ॥",
      "transliteration": "tere dhono haath kaTaauooaa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਰੇ ਦੋਵੇਾਂ ਹੱਥ ਕਟਵਾਵਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "तेरे दोनो हाथ कटाऊाँ ॥",
      "sourceLineId": "130440",
      "sourceShabadId": "12393",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤੌ ਰਾਜਾ ਕੀ ਸੁਤਾ ਕਹਾਊਾਂ ॥੧੨੧॥",
      "transliteration": "tau raajaa kee sutaa kahaauooaa(n) ||121||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਰਾਜੇ ਦੀ ਪੁੱਤਰੀ ਅਖਵਾਵਾਗੀ ॥੧੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "तौ राजा की सुता कहाऊाँ ॥१२१॥",
      "sourceLineId": "130441",
      "sourceShabadId": "12393",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦਿਜ ਵਾਚ ॥",
      "transliteration": "dhij vaach ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਾਹਮਣ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "दिज वाच ॥",
      "sourceLineId": "130442",
      "sourceShabadId": "12394",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਇਹ ਸੁਨਿ ਬਾਤ ਮਿਸ੍ਰ ਡਰ ਪਯੋ ॥",
      "transliteration": "eeh sun baat misr ddar payo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਗੱਲ ਸੁਣ ਕੇ ਬ੍ਰਾਹਮਣ ਡਰ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "इह सुनि बात मिस्र डर पयो ॥",
      "sourceLineId": "130443",
      "sourceShabadId": "12394",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਲਾਗਤ ਪਾਇ ਕੁਅਰਿ ਕੇ ਭਯੋ ॥",
      "transliteration": "laagat pai kuar ke bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ ਕੁਮਾਰੀ ਦੇ ਪੈਰੀਂ ਪੈ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "लागत पाइ कुअरि के भयो ॥",
      "sourceLineId": "130444",
      "sourceShabadId": "12394",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੋਊ ਕਰੋ ਜੁ ਮੋਹਿ ਉਚਾਰੋ ॥",
      "transliteration": "souoo karo ju moh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗਿਆ ਕਿ ਮੈਂ) ਉਹੀ ਕਰਾਗਾ ਜੋ (ਤੂੰ) ਮੈਨੂੰ ਕਹੇਾਂਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "सोऊ करो जु मोहि उचारो ॥",
      "sourceLineId": "130445",
      "sourceShabadId": "12394",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤੁਮ ਨਿਜੁ ਜਿਯ ਤੇ ਕੋਪ ਨਿਵਾਰੋ ॥੧੨੨॥",
      "transliteration": "tum nij jiy te kop nivaaro ||122||",
      "translation": "",
      "punjabiViakhya": "ਤੂੰ ਆਪਣੇ ਮਨ ਤੋਂ ਕ੍ਰੋਧ ਦੂਰ ਕਰ ਦੇ ॥੧੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "तुम निजु जिय ते कोप निवारो ॥१२२॥",
      "sourceLineId": "130446",
      "sourceShabadId": "12394",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕੁਅਰਿ ਬਾਚ ॥",
      "transliteration": "kuar baach ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "कुअरि बाच ॥",
      "sourceLineId": "130447",
      "sourceShabadId": "12395",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤੁਮ ਕਹਿਯਹੁ ਮੈ ਪ੍ਰਥਮ ਅਨਾਯੋ ॥",
      "transliteration": "tum kahiyahu mai pratham anaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤੂੰ ਕਹੀਂ ਕਿ (ਮੈਂ) ਪਹਿਲਾ ਇਸ਼ਨਾਨ ਕੀਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "तुम कहियहु मै प्रथम अनायो ॥",
      "sourceLineId": "130448",
      "sourceShabadId": "12395",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਧਨ ਨਿਮਿਤਿ ਮੈ ਦਰਬੁ ਲੁਟਾਯੋ ॥",
      "transliteration": "dhan nimit mai dharab luTaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਅਗਲੇ ਜਨਮ ਵਿਚ ਅਧਿਕ) ਧਨ ਪ੍ਰਾਪਤ ਕਰਨ ਲਈ ਦਰਬ ਲੁਟਾਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "धन निमिति मै दरबु लुटायो ॥",
      "sourceLineId": "130449",
      "sourceShabadId": "12395",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪਾਹਨ ਕੀ ਪੂਜਾ ਨਹਿ ਕਰਿਯੈ ॥",
      "transliteration": "paahan kee poojaa neh kariyai ||",
      "translation": "",
      "punjabiViakhya": "(ਤੂੰ ਹੁਣ) ਪੱਥਰ ਦੀ ਪੂਜਾ ਨਹੀਂ ਕਰੇਾਂਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "पाहन की पूजा नहि करियै ॥",
      "sourceLineId": "130450",
      "sourceShabadId": "12395",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਕੇ ਪਾਇਨ ਪਰਿਯੈ ॥੧੨੩॥",
      "transliteration": "mahaa kaal ke pain pariyai ||123||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਹਾ ਕਾਲ ਦੇ ਚਰਨੀਂ ਲਗੇਾਂਗਾ ॥੧੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "महा काल के पाइन परियै ॥१२३॥",
      "sourceLineId": "130451",
      "sourceShabadId": "12395",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਬਿਯੋ ਬਾਚ ॥",
      "transliteration": "kabiyo baach ||",
      "translation": "",
      "punjabiViakhya": "ਕਵੀ ਦਾ ਕਥਨ ਹੈ:",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "कबियो बाच ॥",
      "sourceLineId": "130452",
      "sourceShabadId": "12396",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਬ ਦਿਜ ਮਹਾ ਕਾਲ ਕੋ ਧ੍ਯਾਯੋ ॥",
      "transliteration": "tab dhij mahaa kaal ko dhayaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਬ੍ਰਾਹਮਣ ਨੇ ਮਹਾ ਕਾਲ ਦੀ ਪੂਜਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "तब दिज महा काल को ध्यायो ॥",
      "sourceLineId": "130453",
      "sourceShabadId": "12396",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਰਿਤਾ ਮਹਿ ਪਾਹਨਨ ਬਹਾਯੋ ॥",
      "transliteration": "saritaa meh paahanan bahaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੱਥਰ (ਸਾਲਿਗ੍ਰਾਮ) ਨੂੰ ਨਦੀ ਵਿਚ ਵਹਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "सरिता महि पाहनन बहायो ॥",
      "sourceLineId": "130454",
      "sourceShabadId": "12396",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੂਜੇ ਕਾਨ ਨ ਕਿਨਹੂੰ ਜਾਨਾ ॥",
      "transliteration": "dhooje kaan na kinahoo(n) jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੂਜੇ ਕੰਨ ਤਕ ਕਿਸੇ ਨੇ ਨਾ ਜਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "दूजे कान न किनहूँ जाना ॥",
      "sourceLineId": "130455",
      "sourceShabadId": "12396",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਹਾ ਮਿਸ੍ਰ ਪਰ ਹਾਲ ਬਿਹਾਨਾ ॥੧੨੪॥",
      "transliteration": "kahaa misr par haal bihaanaa ||124||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਬ੍ਰਾਹਮਣ ਉਤੇ ਕੀ ਬੀਤੀ ਹੈ ॥੧੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "कहा मिस्र पर हाल बिहाना ॥१२४॥",
      "sourceLineId": "130456",
      "sourceShabadId": "12396",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "130457",
      "sourceShabadId": "12397",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਇਹ ਛਲ ਸੌ ਮਿਸਰਹਿ ਛਲਾ ਪਾਹਨ ਦਏ ਬਹਾਇ ॥",
      "transliteration": "eeh chhal sau misareh chhalaa paahan dhe bahai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ (ਰਾਜ ਕੁਮਾਰੀ ਨੇ) ਬ੍ਰਾਹਮਣ ਨੂੰ ਛਲ ਲਿਆ ਅਤੇ ਪੱਥਰ ਨੂੰ ਰੋੜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "इह छल सौ मिसरहि छला पाहन दए बहाइ ॥",
      "sourceLineId": "130458",
      "sourceShabadId": "12397",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਕੋ ਸਿਖ੍ਯ ਕਰਿ ਮਦਰਾ ਭਾਗ ਪਿਵਾਇ ॥੧੨੫॥",
      "transliteration": "mahaa kaal ko sikhay kar madharaa bhaag pivai ||125||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਸ਼ਰਾਬ ਅਤੇ ਭੰਗ ਪਿਆ ਕੇ ਮਹਾ ਕਾਲ ਦਾ ਸੇਵਕ ਬਣਾ ਦਿੱਤਾ ॥੧੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "महा काल को सिख्य करि मदरा भाग पिवाइ ॥१२५॥",
      "sourceLineId": "130459",
      "sourceShabadId": "12397",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਛਿਆਸਠਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੬੬॥੫੧੯੫॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau chhiaasaTh charitr samaapatam sat subham sat ||266||5195||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੬੬ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੬੬॥੫੧੯੫॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ छिआसठि चरित्र समापतम सतु सुभम सतु ॥२६६॥५१९५॥अफजूँ॥",
      "sourceLineId": "130460",
      "sourceShabadId": "12397",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130461",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰੂਪ ਸੈਨ ਇਕ ਨ੍ਰਿਪਤਿ ਸੁਲਛਨ ॥",
      "transliteration": "roop sain ik nirapat sulachhan ||",
      "translation": "",
      "punjabiViakhya": "ਰੂਪ ਸੈਨ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "रूप सैन इक नृपति सुलछन ॥",
      "sourceLineId": "130462",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤੇਜਵਾਨ ਬਲਵਾਨ ਬਿਚਛਨ ॥",
      "transliteration": "tejavaan balavaan bichachhan ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਚੰਗਿਆਂ ਲੱਛਣਾ ਵਾਲਾ, ਤੇਜਵਾਨ, ਬਲਵਾਨ ਅਤੇ ਸੂਝਵਾਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "तेजवान बलवान बिचछन ॥",
      "sourceLineId": "130463",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਕਲ ਮਤੀ ਤਾ ਕੇ ਘਰ ਦਾਰਾ ॥",
      "transliteration": "sakal matee taa ke ghar dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸਕਲ ਮਤੀ ਉਸ ਦੀ ਇਸਤਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "सकल मती ता के घर दारा ॥",
      "sourceLineId": "130464",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਾ ਸਮ ਕਹੂੰ ਨ ਰਾਜ ਕੁਮਾਰਾ ॥੧॥",
      "transliteration": "jaa sam kahoo(n) na raaj kumaaraa ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਕਿਤੇ ਕੋਈ ਰਾਜ ਕੁਮਾਰੀ ਵੀ ਨਹੀਂ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "जा सम कहूँ न राज कुमारा ॥१॥",
      "sourceLineId": "130465",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਹਿ ਇਕ ਬਸੈ ਤੁਰਕਨੀ ਨਾਰੀ ॥",
      "transliteration": "teh ik basai turakanee naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਤੁਰਕ (ਮੁਸਲਮਾਨ) ਇਸਤਰੀ ਰਹਿੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "तहि इक बसै तुरकनी नारी ॥",
      "sourceLineId": "130466",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਿਹ ਸਮ ਰੂਪ ਨ ਮੈਨ ਦੁਲਾਰੀ ॥",
      "transliteration": "teh sam roop na main dhulaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗਾ ਕਾਮ ਦੇਵ ਦੀ ਪਤਨੀ (ਰਤੀ) ਦਾ ਵੀ ਰੂਪ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "तिह सम रूप न मैन दुलारी ॥",
      "sourceLineId": "130467",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਿਨ ਰਾਜਾ ਕੀ ਛਬਿ ਨਿਰਖੀ ਜਬ ॥",
      "transliteration": "tin raajaa kee chhab nirakhee jab ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਜਦ ਰਾਜੇ ਦੀ ਸੁੰਦਰਤਾ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "तिन राजा की छबि निरखी जब ॥",
      "sourceLineId": "130468",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮੋਹਿ ਰਹੀ ਤਰੁਨੀ ਤਾ ਪਰ ਤਬ ॥੨॥",
      "transliteration": "moh rahee tarunee taa par tab ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਹ ਨੌਜਵਾਨ ਇਸਤਰੀ ਉਸ ਉਤੇ ਮੋਹਿਤ ਹੋ ਗਈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "मोहि रही तरुनी ता पर तब ॥२॥",
      "sourceLineId": "130469",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰੂਪ ਸੈਨ ਪਹਿ ਸਖੀ ਪਠਾਈ ॥",
      "transliteration": "roop sain peh sakhee paThaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਤੁਰਕਨੀ ਨੇ) ਰੂਪ ਸੈਨ ਪ੍ਰਤਿ ਆਪਣੀ ਸਖੀ ਭੇਜੀ",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "रूप सैन पहि सखी पठाई ॥",
      "sourceLineId": "130470",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਲਗੀ ਲਗਨ ਤੁਹਿ ਸਾਥ ਜਤਾਈ ॥",
      "transliteration": "lagee lagan tuh saath jataiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ (ਆਪਣੀ) ਪ੍ਰੇਮ-ਲਗਨ ਬਾਰੇ ਜਾਣਕਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "लगी लगन तुहि साथ जताई ॥",
      "sourceLineId": "130471",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਇਕ ਦਿਨ ਮੁਰਿ ਕਹਿਯੋ ਸੇਜ ਸੁਹੈਯੈ ॥",
      "transliteration": "eik dhin mur kahiyo sej suhaiyai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਹਾ ਕਿ ਇਕ ਦਿਨ ਮੇਰੀ ਸੇਜ ਨੂੰ ਸੁਸ਼ੋਭਿਤ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "इक दिन मुरि कहियो सेज सुहैयै ॥",
      "sourceLineId": "130472",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਾਥ ਸਨਾਥ ਅਨਾਥਹਿ ਕੈਯੈ ॥੩॥",
      "transliteration": "naath sanaath anaatheh kaiyai ||3||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਨਾਥ! (ਮੈਨੂੰ) ਅਨਾਥ ਨੂੰ ਸਨਾਥ ਕਰ ਦਿਓ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "नाथ सनाथ अनाथहि कैयै ॥३॥",
      "sourceLineId": "130473",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1201_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਇਮਿ ਦੂਤੀ ਪ੍ਰਤਿ ਨ੍ਰਿਪਤਿ ਉਚਾਰਾ ॥",
      "transliteration": "eim dhootee prat nirapat uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਦੂਤੀ ਪ੍ਰਤਿ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1201,
      "hindi": "",
      "hindiTransliteration": "इमि दूती प्रति नृपति उचारा ॥",
      "sourceLineId": "130474",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
