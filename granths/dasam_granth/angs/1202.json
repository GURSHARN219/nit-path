{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1202,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1202_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤ੍ਰਿਯ ਆਗੇ ਪਤਿ ਜਿਯਤ ਤਿਹਾਰਾ ॥",
      "transliteration": "tiray aage pat jiyat tihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਇਸਤਰੀ! ਤੇਰਾ ਅਗਲਾ ਪਤੀ ਜੀਉਾਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "तृय आगे पति जियत तिहारा ॥",
      "sourceLineId": "130475",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜੌ ਤੌ ਪ੍ਰਥਮ ਕਾਜਿਯਹਿ ਮਾਰੈ ॥",
      "transliteration": "jau tau pratham kaajiyeh maarai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੂੰ ਪਹਿਲਾ ਕਾਜ਼ੀ ਨੂੰ ਮਾਰ ਦੇਏਾਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "जौ तौ प्रथम काजियहि मारै ॥",
      "sourceLineId": "130476",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਿਹ ਪਾਛੇ ਮੁਹਿ ਸੰਗਿ ਬਿਹਾਰੈ ॥੪॥",
      "transliteration": "teh paachhe muh sa(n)g bihaarai ||4||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਉਸ ਪਿਛੋਂ ਮੇਰੇ ਨਾਲ ਵਿਹਾਰ ਕਰੀਂ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "तिह पाछे मुहि संगि बिहारै ॥४॥",
      "sourceLineId": "130477",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੁਨਿ ਸਹਚਰਿ ਤਿਹ ਜਾਇ ਜਤਾਈ ॥",
      "transliteration": "sun sahachar teh jai jataiee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ ਗੱਲ) ਸੁਣ ਕੇ ਸਖੀ ਨੇ ਉਸ ਨੂੰ ਜਾ ਦਸਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "सुनि सहचरि तिह जाइ जताई ॥",
      "sourceLineId": "130478",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨ੍ਰਿਪ ਹਮ ਕੋ ਇਮਿ ਭਾਖ ਸੁਨਾਈ ॥",
      "transliteration": "nirap ham ko im bhaakh sunaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਰਾਜੇ ਨੇ ਮੈਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "नृप हम को इमि भाख सुनाई ॥",
      "sourceLineId": "130479",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜੌ ਤੈ ਪ੍ਰਥਮ ਕਾਜਿਯਹਿ ਘਾਵੈ ॥",
      "transliteration": "jau tai pratham kaajiyeh ghaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੂੰ ਪਹਿਲਾ ਕਾਜ਼ੀ ਨੂੰ ਮਾਰ ਦੇਏਾਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "जौ तै प्रथम काजियहि घावै ॥",
      "sourceLineId": "130480",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਿਹ ਉਪਰਾਤ ਬਹੁਰਿ ਮੁਹਿ ਪਾਵੈ ॥੫॥",
      "transliteration": "teh uparaat bahur muh paavai ||5||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਉਪਰੰਤ ਫਿਰ ਮੈਨੂੰ ਪ੍ਰਾਪਤ ਕਰੀਂ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "तिह उपरात बहुरि मुहि पावै ॥५॥",
      "sourceLineId": "130481",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੁਨਿ ਤ੍ਰਿਯ ਬਾਤ ਚਿਤ ਮਹਿ ਰਾਖੀ ॥",
      "transliteration": "sun tiray baat chit meh raakhee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਇਸਤਰੀ ਨੇ ਇਹ ਗੱਲ ਸੁਣ ਕੇ ਚਿਤ ਵਿਚ ਹੀ ਰਖੀ",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "सुनि तृय बात चित महि राखी ॥",
      "sourceLineId": "130482",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਔਰ ਨ ਕਿਸੀ ਔਰਤਹਿ ਭਾਖੀ ॥",
      "transliteration": "aauar na kisee aauarateh bhaakhee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਸੇ ਹੋਰ ਇਸਤਰੀ ਨਾਲ ਸਾਝੀ ਨਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "और न किसी औरतहि भाखी ॥",
      "sourceLineId": "130483",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰੈਨਿ ਸਮੈ ਕਾਜੀ ਜਬ ਆਯੋ ॥",
      "transliteration": "rain samai kaajee jab aayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਵੇਲੇ ਜਦ ਕਾਜ਼ੀ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "रैनि समै काजी जब आयो ॥",
      "sourceLineId": "130484",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਾਢਿ ਕ੍ਰਿਪਾਨ ਸੋਵਤਹਿ ਘਾਯੋ ॥੬॥",
      "transliteration": "kaadd kirapaan sovateh ghaayo ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਤਲਵਾਰ ਕਢ ਕੇ ਸੁੱਤੇ ਹੋਏ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "काढि कृपान सोवतहि घायो ॥६॥",
      "sourceLineId": "130485",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਾ ਕੋ ਕਾਟਿ ਮੂੰਡ ਕਰਿ ਲਿਯੋ ॥",
      "transliteration": "taa ko kaaT moo(n)dd kar liyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਸਿਰ ਕਟ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "ता को काटि मूँड करि लियो ॥",
      "sourceLineId": "130486",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਲੈ ਰਾਜਾ ਕੇ ਹਾਜਰ ਕਿਯੋ ॥",
      "transliteration": "lai raajaa ke haajar kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਦੇ (ਸਾਹਮਣੇ) ਹਾਜ਼ਰ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "लै राजा के हाजर कियो ॥",
      "sourceLineId": "130487",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਵ ਨਿਮਿਤ ਕਾਜੀ ਮੈ ਘਾਯੋ ॥",
      "transliteration": "tav nimit kaajee mai ghaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿਣ ਲਗੀ) ਤੇਰੇ ਲਈ ਮੈਂ ਕਾਜ਼ੀ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "तव निमित काजी मै घायो ॥",
      "sourceLineId": "130488",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਬ ਮੁਹਿ ਸੰਗ ਕਰੋ ਮਨ ਭਾਯੋ ॥੭॥",
      "transliteration": "ab muh sa(n)g karo man bhaayo ||7||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੇਰੇ ਨਾਲ ਮਨ ਚਾਹਿਆ ਰਮਣ ਕਰੋ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "अब मुहि संग करो मन भायो ॥७॥",
      "sourceLineId": "130489",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਬ ਸਿਰ ਨਿਰਖਿ ਨ੍ਰਿਪਤਿ ਤਿਹ ਲਯੋ ॥",
      "transliteration": "jab sir nirakh nirapat teh layo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਦਾ ਸਿਰ ਰਾਜੇ ਨੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "जब सिर निरखि नृपति तिह लयो ॥",
      "sourceLineId": "130490",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਨ ਕੇ ਬਿਖੈ ਅਧਿਕ ਡਰ ਪਯੋ ॥",
      "transliteration": "man ke bikhai adhik ddar payo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮਨ ਵਿਚ ਬਹੁਤ ਡਰ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "मन के बिखै अधिक डर पयो ॥",
      "sourceLineId": "130491",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪਤਿ ਮਾਰਤ ਜਿਹ ਲਗੀ ਨ ਬਾਰਾ ॥",
      "transliteration": "pat maarat jeh lagee na baaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਸੋਚਣ ਲਗਾ ਕਿ) ਜਿਸ ਨੂੰ ਪਤੀ ਮਾਰਨ ਲਗਿਆਂ ਦੇਰ ਨਹੀਂ ਲਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "पति मारत जिह लगी न बारा ॥",
      "sourceLineId": "130492",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਾ ਉਪਪਤਿ ਤਿਹ ਅਗ੍ਰ ਬਿਚਾਰਾ ॥੮॥",
      "transliteration": "kaa upapat teh agr bichaaraa ||8||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਸਾਹਮਣੇ ਉਪ-ਪਤੀ (ਪ੍ਰੇਮੀ) ਵਿਚਾਰਾ ਕੀ ਹੈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "का उपपति तिह अग्र बिचारा ॥८॥",
      "sourceLineId": "130493",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਧਿਕ ਧਿਕ ਬਚ ਤਿਹ ਤ੍ਰਿਯਹ ਉਚਾਰਾ ॥",
      "transliteration": "dhik dhik bach teh tirayeh uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ (ਉਸ) ਇਸਤਰੀ ਪ੍ਰਤਿ 'ਧਿਕਾਰ ਧਿਕਾਰ' ਦੇ ਬਚਨ ਕਹੇ",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "धिक धिक बच तिह तृयह उचारा ॥",
      "sourceLineId": "130494",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭੋਗ ਕਰਬ ਮੈ ਤਜਾ ਤਿਹਾਰਾ ॥",
      "transliteration": "bhog karab mai tajaa tihaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਫਿਰ ਕਿਹਾ) ਮੈਂ ਤੇਰੇ ਨਾਲ ਭੋਗ ਕਰਨਾ ਤਿਆਗ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "भोग करब मै तजा तिहारा ॥",
      "sourceLineId": "130495",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤ੍ਰਿਯ ਪਾਪਨਿ ਤੈ ਭਰਤਾ ਘਾਯੋ ॥",
      "transliteration": "tiray paapan tai bharataa ghaayo ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਾਪਣ ਇਸਤਰੀ! ਤੂੰ ਆਪਣਾ ਪਤੀ ਮਾਰ ਦਿੱਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "तृय पापनि तै भरता घायो ॥",
      "sourceLineId": "130496",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਾ ਤੇ ਮੋਹਿ ਅਧਿਕ ਡਰ ਆਯੋ ॥੯॥",
      "transliteration": "taa te moh adhik ddar aayo ||9||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਮੈਨੂੰ ਬਹੁਤ ਡਰ ਲਗ ਗਿਆ ਹੈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "ता ते मोहि अधिक डर आयो ॥९॥",
      "sourceLineId": "130497",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਬ ਤੈ ਜਾਹਿ ਪਾਪਨੀ ਤਹੀ ॥",
      "transliteration": "ab tai jaeh paapanee tahee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਾਪਣੇ! ਹੁਣ ਤੂੰ ਉਥੇ ਹੀ ਜਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "अब तै जाहि पापनी तही ॥",
      "sourceLineId": "130498",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਿਜ ਕਰ ਨਾਥ ਸੰਘਾਰਾ ਜਹੀ ॥",
      "transliteration": "nij kar naath sa(n)ghaaraa jahee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਤੂੰ ਆਪਣੇ ਹੱਥ ਨਾਲ ਪਤੀ ਨੂੰ ਮਾਰਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "निज कर नाथ संघारा जही ॥",
      "sourceLineId": "130499",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਬ ਤੇਰੋ ਸਭ ਹੀ ਧ੍ਰਿਗ ਸਾਜਾ ॥",
      "transliteration": "ab tero sabh hee dhirag saajaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਤੇਰਾ ਸਾਰਾ ਸਾਜ ਸ਼ਿੰਗਾਰ ਲਾਹਨਤ ਪਾਣ ਯੋਗ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "अब तेरो सभ ही धृग साजा ॥",
      "sourceLineId": "130500",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਬ ਹੀ ਲਗਿ ਜੀਵਤ ਨਿਰਲਾਜਾ ॥੧੦॥",
      "transliteration": "ab hee lag jeevat niralaajaa ||10||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਨਿਰਲਜ! ਤੂੰ ਹੁਣ ਤਕ ਜੀਉਾਂਦੀ ਹੈਂ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "अब ही लगि जीवत निरलाजा ॥१०॥",
      "sourceLineId": "130501",
      "sourceShabadId": "12398",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "130502",
      "sourceShabadId": "12399",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਿਤ ਮੇਰੇ ਜਿਨ ਪਤਿ ਹਨਾ ਕੀਨਾ ਬਡਾ ਕੁਕਾਜ ॥",
      "transliteration": "hit mere jin pat hanaa keenaa baddaa kukaaj ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਲਈ ਜਿਸ ਨੇ ਆਪਣਾ ਪਤੀ ਮਾਰ ਕੇ ਬੜਾ ਮਾੜਾ ਕੰਮ ਕੀਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "हित मेरे जिन पति हना कीना बडा कुकाज ॥",
      "sourceLineId": "130503",
      "sourceShabadId": "12399",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਮਧਰ ਮਾਰਿ ਨ ਮਰਤ ਹੈ ਅਬ ਲੌ ਜਿਯਤ ਨਿਲਾਜ ॥੧੧॥",
      "transliteration": "jamadhar maar na marat hai ab lau jiyat nilaaj ||11||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਜਮਧਾੜ (ਕਟਾਰ) ਮਾਰ ਕੇ ਮਰਦੀ (ਕਿਉਾਂ) ਨਹੀਂ ਅਤੇ ਨਿਰਲਜ ਅਜੇ ਤਕ ਜੀਉਾਂਦੀ ਹੈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "जमधर मारि न मरत है अब लौ जियत निलाज ॥११॥",
      "sourceLineId": "130504",
      "sourceShabadId": "12399",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130505",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੁਨਤ ਬਚਨ ਏ ਨਾਰਿ ਰਿਸਾਈ ॥",
      "transliteration": "sunat bachan e naar risaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਬਚਨ ਸੁਣ ਕੇ (ਉਹ) ਇਸਤਰੀ ਬਹੁਤ ਕ੍ਰੋਧਿਤ ਹੋਈ",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "सुनत बचन ए नारि रिसाई ॥",
      "sourceLineId": "130506",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਲਜਿਤ ਭਈ ਘਰ ਕੋ ਫਿਰੀ ਆਈ ॥",
      "transliteration": "lajit bhiee ghar ko firee aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲਜਿਤ ਹੋ ਕੇ ਘਰ ਨੂੰ ਪਰਤ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "लजित भई घर को फिरी आई ॥",
      "sourceLineId": "130507",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪਤਿ ਕੋ ਮੂੰਡ ਤਿਸੀ ਘਰ ਡਾਰਾ ॥",
      "transliteration": "pat ko moo(n)dd tisee ghar ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਪਤੀ ਦਾ ਸਿਰ ਉਸੇ (ਰਾਜੇ) ਦੇ ਘਰ ਛਡ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "पति को मूँड तिसी घर डारा ॥",
      "sourceLineId": "130508",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਇ ਧਾਮ ਇਸ ਭਾਤਿ ਪੁਕਾਰਾ ॥੧੨॥",
      "transliteration": "aai dhaam is bhaat pukaaraa ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘਰ ਆ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਪੁਕਾਰਨ ਲਗੀ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "आइ धाम इस भाति पुकारा ॥१२॥",
      "sourceLineId": "130509",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪ੍ਰਾਤ ਭਏ ਸਭ ਲੋਗ ਬੁਲਾਏ ॥",
      "transliteration": "praat bhe sabh log bulaae ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੇਰ ਹੁੰਦਿਆਂ ਹੀ ਸਭ ਲੋਕ ਬੁਲਾ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "प्रात भए सभ लोग बुलाए ॥",
      "sourceLineId": "130510",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਭਹਿਨ ਕਾਜੀ ਮ੍ਰਿਤਕ ਦਿਖਾਏ ॥",
      "transliteration": "sabhahin kaajee mritak dhikhaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਨੂੰ ਮਰਿਆ ਹੋਇਆ ਕਾਜ਼ੀ ਵਿਖਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "सभहिन काजी मृतक दिखाए ॥",
      "sourceLineId": "130511",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸ੍ਰੋਨਤ ਧਾਰ ਪਰਤ ਜਿਹ ਗਈ ॥",
      "transliteration": "sronat dhaar parat jeh giee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਲਹੂ ਦੀ ਧਾਰ ਪਈ ਹੋਈ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "स्रोनत धार परत जिह गई ॥",
      "sourceLineId": "130512",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੋ ਮਗੁ ਹ੍ਵੈ ਕਰਿ ਖੋਜਤ ਭਈ ॥੧੩॥",
      "transliteration": "so mag havai kar khojat bhiee ||13||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਰਸਤੇ ਉਤੇ ਖੋਜਣ ਲਈ ਚਲ ਪਈ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "सो मगु ह्वै करि खोजत भई ॥१३॥",
      "sourceLineId": "130513",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਹ ਜਹ ਜਾਇ ਸ੍ਰੋਨ ਕੀ ਧਾਰਾ ॥",
      "transliteration": "jeh jeh jai sron kee dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਜਿਥੇ ਲਹੂ ਦੀ ਧਾਰ ਚਲਦੀ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "जह जह जाइ स्रोन की धारा ॥",
      "sourceLineId": "130514",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਿਹ ਹੇਰਤ ਜਨ ਚਲੇ ਅਪਾਰਾ ॥",
      "transliteration": "teh herat jan chale apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਵਲ ਵੇਖਦੇ ਹੋਇਆਂ ਬਹੁਤ ਸਾਰੇ ਲੋਕ ਚਲ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "तिह हेरत जन चले अपारा ॥",
      "sourceLineId": "130515",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਹ ਸਭਹੂੰ ਲੈ ਠਾਢੋ ਕੀਨਾ ॥",
      "transliteration": "teh sabhahoo(n) lai Thaaddo keenaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਉਥੇ ਲਿਆ ਖੜਾ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "तह सभहूँ लै ठाढो कीना ॥",
      "sourceLineId": "130516",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਹ ਨਿਜੁ ਹਾਥ ਡਾਰਿ ਸਿਰ ਦੀਨਾ ॥੧੪॥",
      "transliteration": "jeh nij haath ddaar sir dheenaa ||14||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ (ਉਸ ਨੇ) ਆਪਣੇ ਹੱਥ ਨਾਲ (ਕਾਜ਼ੀ ਦਾ) ਸਿਰ ਸੁਟਿਆ ਸੀ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "जह निजु हाथ डारि सिर दीना ॥१४॥",
      "sourceLineId": "130517",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮੂੰਡ ਕਟ੍ਯੋ ਸਭਹਿਨ ਲਖਿ ਪਾਯੋ ॥",
      "transliteration": "moo(n)dd kaTayo sabhahin lakh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਟਿਆ ਹੋਇਆ ਸਿਰ ਸਾਰਿਆਂ ਨੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "मूँड कट्यो सभहिन लखि पायो ॥",
      "sourceLineId": "130518",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਹ ਕਾਜੀ ਯਾਹੀ ਨ੍ਰਿਪ ਘਾਯੋ ॥",
      "transliteration": "eeh kaajee yaahee nirap ghaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਸੋਚਿਆ ਕਿ) ਇਸੇ ਰਾਜੇ ਨੇ ਕਾਜ਼ੀ ਨੂੰ ਕਤਲ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "इह काजी याही नृप घायो ॥",
      "sourceLineId": "130519",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਾ ਕਹ ਬਾਧਿ ਲੈ ਗਏ ਤਹਾ ॥",
      "transliteration": "taa keh baadh lai ge tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਬੰਨ੍ਰਹ ਕੇ ਉਥੇ ਲੈ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "ता कह बाधि लै गए तहा ॥",
      "sourceLineId": "130520",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਹਾਗੀਰ ਬੈਠਾ ਥੋ ਜਹਾ ॥੧੫॥",
      "transliteration": "jahaageer baiThaa tho jahaa ||15||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਜਹਾਗੀਰ (ਦਰਬਾਰ ਲਗਾ ਕੇ) ਬੈਠਾ ਸੀ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "जहागीर बैठा थो जहा ॥१५॥",
      "sourceLineId": "130521",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1202_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਭ ਬ੍ਰਿਤਾਤ ਕਹਿ ਪ੍ਰਥਮ ਸੁਨਾਯੋ ॥",
      "transliteration": "sabh birataat keh pratham sunaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਸਭ ਨੇ) ਪਹਿਲਾ (ਬਾਦਸ਼ਾਹ ਨੂੰ) ਸਾਰਾ ਬ੍ਰਿਤਾਤ ਸੁਣਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1202,
      "hindi": "",
      "hindiTransliteration": "सभ बृतात कहि प्रथम सुनायो ॥",
      "sourceLineId": "130522",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
