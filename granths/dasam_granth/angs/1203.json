{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1203,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1203_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਇਹ ਕਾਜੀ ਰਾਜੈ ਇਨ ਘਾਯੋ ॥",
      "transliteration": "eeh kaajee raajai in ghaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ) ਇਸ ਰਾਜੇ ਨੇ ਇਸ ਕਾਜ਼ੀ ਨੂੰ ਮਾਰਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "इह काजी राजै इन घायो ॥",
      "sourceLineId": "130523",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਹਜਰਤਿ ਬਾਧਿ ਤ੍ਰਿਯਹਿ ਕਹ ਦੀਨਾ ॥",
      "transliteration": "hajarat baadh tirayeh keh dheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਦਸ਼ਾਹ ਨੇ (ਰਾਜੇ ਨੂੰ) ਬੰਨ੍ਰਹ ਕੇ ਇਸਤਰੀ ਦੇ ਹਵਾਲੇ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "हजरति बाधि तृयहि कह दीना ॥",
      "sourceLineId": "130524",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭੇਦ ਕਛੂ ਜਿਯ ਮਾਝ ਨ ਚੀਨਾ ॥੧੬॥",
      "transliteration": "bhedh kachhoo jiy maajh na cheenaa ||16||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਕਿਸੇ ਨੇ ਵੀ (ਆਪਣੇ) ਹਿਰਦੇ ਵਿਚ (ਅਸਲ) ਭੇਦ ਨੂੰ ਨਹੀਂ ਸਮਝਿਆ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "भेद कछू जिय माझ न चीना ॥१६॥",
      "sourceLineId": "130525",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਾਰਨ ਕੌ ਲੈ ਤਾਹਿ ਸਿਧਾਈ ॥",
      "transliteration": "maaran kau lai taeh sidhaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਤੁਰਕਨੀ) ਉਸ ਨੂੰ ਮਾਰਨ ਲਈ ਲੈ ਕੇ ਚਲ ਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "मारन कौ लै ताहि सिधाई ॥",
      "sourceLineId": "130526",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਆਂਖਿਨ ਹੀ ਮਹਿ ਨ੍ਰਿਪਹਿ ਜਤਾਈ ॥",
      "transliteration": "aa(n)khin hee meh nirapeh jataiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅੱਖਾ ਨਾਲ ਹੀ ਰਾਜੇ ਨੂੰ ਸਮਝਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "आँखिन ही महि नृपहि जताई ॥",
      "sourceLineId": "130527",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮੁਰ ਜਿਯ ਰਾਖੁ ਕਹੈ ਸੌ ਕਰਿ ਹੌ ॥",
      "transliteration": "mur jiy raakh kahai sau kar hau ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜੇ ਮੇਰੀ ਜਿੰਦ ਰਖ ਲਵੇਾਂ ਤਾ ਜੋ ਕਹੇਾਂ, ਉਹੀ ਕਰਾਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "मुर जिय राखु कहै सौ करि हौ ॥",
      "sourceLineId": "130528",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਲੈ ਘਟ ਸੀਸ ਪਾਨਿ ਕੌ ਭਰਿ ਹੌ ॥੧੭॥",
      "transliteration": "lai ghaT sees paan kau bhar hau ||17||",
      "translation": "",
      "punjabiViakhya": "ਸਿਰ ਉਤੇ ਘੜਾ ਚੁਕ ਕੇ ਪਾਣੀ ਭਰਾਗਾ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "लै घट सीस पानि कौ भरि हौ ॥१७॥",
      "sourceLineId": "130529",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਬ ਸੁੰਦਰਿ ਇਹ ਭਾਤਿ ਬਿਚਾਰੋ ॥",
      "transliteration": "tab su(n)dhar ieh bhaat bichaaro ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਸੁੰਦਰੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਵਿਚਾਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "तब सुँदरि इह भाति बिचारो ॥",
      "sourceLineId": "130530",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਬ ਮਾਨਾ ਨ੍ਰਿਪ ਕਹਾ ਹਮਾਰੋ ॥",
      "transliteration": "ab maanaa nirap kahaa hamaaro ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਹੁਣ ਰਾਜੇ ਨੇ ਮੇਰਾ ਕਿਹਾ ਮੰਨ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "अब माना नृप कहा हमारो ॥",
      "sourceLineId": "130531",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਾ ਕੌ ਛਾਡਿ ਹਾਥ ਤੇ ਦੀਨਾ ॥",
      "transliteration": "taa kau chhaadd haath te dheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਆਪਣੇ ਹੱਥੋਂ ਛਡ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "ता कौ छाडि हाथ ते दीना ॥",
      "sourceLineId": "130532",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਖੂਨ ਬਖਸ੍ਯੋ ਮੈ ਇਹ ਕੀਨਾ ॥੧੮॥",
      "transliteration": "khoon bakhasayo mai ieh keenaa ||18||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ) ਮੈਂ ਇਸ ਦਾ ਕੀਤਾ ਖ਼ੂਨ ਬਖ਼ਸ਼ ਦਿੱਤਾ ਹੈ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "खून बखस्यो मै इह कीना ॥१८॥",
      "sourceLineId": "130533",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪ੍ਰਥਮਹਿ ਛਾਡਿ ਮਿਤ੍ਰ ਕਹ ਦੀਨਾ ॥",
      "transliteration": "prathameh chhaadd mitr keh dheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਮਿਤਰ ਨੂੰ ਛਡ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "प्रथमहि छाडि मित्र कह दीना ॥",
      "sourceLineId": "130534",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪੁਨ ਇਹ ਭਾਤਿ ਉਚਾਰਨ ਕੀਨਾ ॥",
      "transliteration": "pun ieh bhaat uchaaran keenaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "पुन इह भाति उचारन कीना ॥",
      "sourceLineId": "130535",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਬ ਮੈ ਸੈਰ ਮਕਾ ਕੇ ਜੈ ਹੌ ॥",
      "transliteration": "ab mai sair makaa ke jai hau ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੈਂ ਮੱਕੇ ਦੀ ਯਾਤਰਾ ਨੂੰ ਜਾਵਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "अब मै सैर मका के जै हौ ॥",
      "sourceLineId": "130536",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਰੀ ਤ ਗਈ ਜਿਯਤ ਫਿਰਿ ਐ ਹੌ ॥੧੯॥",
      "transliteration": "maree ta giee jiyat fir aai hau ||19||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਮਰ ਗਈ, ਤਾ ਵਾਹ ਭਲਾ। ਅਤੇ ਜੇ ਜੀਉਾਂਦੀ ਰਹੀ ਤਾ ਪਰਤ ਆਵਾਗੀ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "मरी त गई जियत फिरि ऐ हौ ॥१९॥",
      "sourceLineId": "130537",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਲੋਗਨ ਸੈਰ ਭਵਾਰੋ ਦਿਯੋ ॥",
      "transliteration": "logan sair bhavaaro dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਲੋਕਾ ਨੂੰ ਯਾਤਰਾ ਦਾ ਭਰਮ ਪਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "लोगन सैर भवारो दियो ॥",
      "sourceLineId": "130538",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਆਪੁ ਪੈਂਡ ਤਿਹ ਗ੍ਰਿਹ ਕੌ ਲਿਯੋ ॥",
      "transliteration": "aap pai(n)dd teh gireh kau liyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪ ਉਸ (ਰਾਜੇ) ਦੇ ਘਰ ਦਾ ਰਸਤਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "आपु पैंड तिह गृह कौ लियो ॥",
      "sourceLineId": "130539",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾਹਿ ਨਿਰਖਿ ਰਾਜਾ ਡਰਪਾਨਾ ॥",
      "transliteration": "taeh nirakh raajaa ddarapaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਰਾਜਾ ਡਰ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "ताहि निरखि राजा डरपाना ॥",
      "sourceLineId": "130540",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਿਹ ਸੰਗ ਕਮਾਨਾ ॥੨੦॥",
      "transliteration": "kaam bhog teh sa(n)g kamaanaa ||20||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਕਾਮ ਭੋਗ ਕੀਤਾ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "काम भोग तिह संग कमाना ॥२०॥",
      "sourceLineId": "130541",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਲੋਗ ਕਹੈ ਮਕਾ ਕਹ ਗਈ ॥",
      "transliteration": "log kahai makaa keh giee ||",
      "translation": "",
      "punjabiViakhya": "ਲੋਕੀਂ ਕਹਿੰਦੇ ਕਿ ਮੱਕੇ ਨੂੰ ਗਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "लोग कहै मका कह गई ॥",
      "sourceLineId": "130542",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹੁਆਂ ਕੀ ਸੁਧਿ ਕਿਨਹੂੰ ਨਹਿ ਲਈ ॥",
      "transliteration": "huaa(n) kee sudh kinahoo(n) neh liee ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਥੋਂ ਦੀ ਖ਼ਬਰ ਕਿਸੇ ਨੇ ਨਾ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "हुआँ की सुधि किनहूँ नहि लई ॥",
      "sourceLineId": "130543",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਹਾ ਬਾਲ ਇਨ ਚਰਿਤ ਦਿਖਾਯੋ ॥",
      "transliteration": "kahaa baal in charit dhikhaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਇਸਤਰੀ ਨੇ ਕੀ ਚਰਿਤ੍ਰ ਵਿਖਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "कहा बाल इन चरित दिखायो ॥",
      "sourceLineId": "130544",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਿਹ ਛਲ ਸੌ ਕਾਜੀ ਕਹ ਘਾਯੋ ॥੨੧॥",
      "transliteration": "keh chhal sau kaajee keh ghaayo ||21||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਸ ਛਲ ਨਾਲ ਕਾਜ਼ੀ ਨੂੰ ਕਤਲ ਕੀਤਾ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "किह छल सौ काजी कह घायो ॥२१॥",
      "sourceLineId": "130545",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਇਹ ਛਲ ਸਾਥ ਕਾਜਿਯਹਿ ਮਾਰਾ ॥",
      "transliteration": "eeh chhal saath kaajiyeh maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਕਾਜ਼ੀ ਨੂੰ ਮਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "इह छल साथ काजियहि मारा ॥",
      "sourceLineId": "130546",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਹੁਰਿ ਮਿਤ੍ਰ ਕਹ ਚਰਿਤ ਦਿਖਾਰਾ ॥",
      "transliteration": "bahur mitr keh charit dhikhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਮਿਤਰ ਨੂੰ ਚਰਿਤ੍ਰ ਵਿਖਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "बहुरि मित्र कह चरित दिखारा ॥",
      "sourceLineId": "130547",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਇਨ ਕੀ ਅਗਮ ਅਗਾਧਿ ਕਹਾਨੀ ॥",
      "transliteration": "ein kee agam agaadh kahaanee ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ (ਇਸਤਰੀਆਂ) ਦੀ ਕਹਾਣੀ ਅਗਮ ਅਤੇ ਅਗਾਧ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "इन की अगम अगाधि कहानी ॥",
      "sourceLineId": "130548",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦਾਨਵ ਦੇਵ ਨ ਕਿਨਹੂੰ ਜਾਨੀ ॥੨੨॥",
      "transliteration": "dhaanav dhev na kinahoo(n) jaanee ||22||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਨੂੰ) ਦੇਵਤਿਆਂ ਅਤੇ ਦੈਂਤਾ ਵਿਚੋਂ ਕਿਸੇ ਨੇ ਵੀ ਨਹੀਂ ਸਮਝਿਆ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "दानव देव न किनहूँ जानी ॥२२॥",
      "sourceLineId": "130549",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਸਤਸਠਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੬੭॥੫੨੧੭॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau satasaTh charitr samaapatam sat subham sat ||267||5217||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੬੭ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੬੭॥੫੨੧੭॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ सतसठि चरित्र समापतम सतु सुभम सतु ॥२६७॥५२१७॥अफजूँ॥",
      "sourceLineId": "130550",
      "sourceShabadId": "12400",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130551",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚੰਪਾਵਤੀ ਨਗਰ ਦਿਸਿ ਦਛਿਨ ॥",
      "transliteration": "cha(n)paavatee nagar dhis dhachhin ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਖਣ ਦਿਸ਼ਾ ਵਿਚ ਚੰਪਾਵਤੀ (ਨਾ ਦਾ ਇਕ) ਨਗਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "चंपावती नगर दिसि दछिन ॥",
      "sourceLineId": "130552",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚੰਪਤ ਰਾਇ ਨ੍ਰਿਪਤਿ ਸੁਭ ਲਛਨ ॥",
      "transliteration": "cha(n)pat rai nirapat subh lachhan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੋਂ ਦਾ) ਚੰਪਤ ਰਾਇ (ਨਾ ਦਾ) ਸ਼ੁਭ ਲੱਛਣਾ ਵਾਲਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "चंपत राइ नृपति सुभ लछन ॥",
      "sourceLineId": "130553",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚੰਪਾਵਤੀ ਧਾਮ ਤਿਹ ਦਾਰਾ ॥",
      "transliteration": "cha(n)paavatee dhaam teh dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਚੰਪਾਵਤੀ ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "चंपावती धाम तिह दारा ॥",
      "sourceLineId": "130554",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਾ ਸਮ ਕਹੂੰ ਨ ਰਾਜ ਦੁਲਾਰਾ ॥੧॥",
      "transliteration": "jaa sam kahoo(n) na raaj dhulaaraa ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ ਕੋਈ ਹੋਰ ਰਾਜ ਕੁਮਾਰੀ ਨਹੀਂ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "जा सम कहूँ न राज दुलारा ॥१॥",
      "sourceLineId": "130555",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਚੰਪਕਲਾ ਦੁਹਿਤਾ ਤਾ ਕੇ ਗ੍ਰਿਹ ॥",
      "transliteration": "cha(n)pakalaa dhuhitaa taa ke gireh ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਘਰ ਚੰਪਕਲਾ (ਨਾ ਦੀ) ਲੜਕੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "चंपकला दुहिता ता के गृह ॥",
      "sourceLineId": "130556",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰੂਪਮਾਨ ਦੁਤਿਮਾਨ ਅਧਿਕ ਵਹ ॥",
      "transliteration": "roopamaan dhutimaan adhik veh ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਬਹੁਤ ਰੂਪਵਾਨ ਅਤੇ ਸ਼ੋਭਾਸ਼ਾਲੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "रूपमान दुतिमान अधिक वह ॥",
      "sourceLineId": "130557",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਬ ਤਿਹ ਅੰਗ ਮੈਨਤਾ ਵਈ ॥",
      "transliteration": "jab teh a(n)g mainataa viee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਦੇ ਅੰਗਾ ਵਿਚ ਕਾਮ ਨੇ ਹੁਲਾਰਾ ਮਾਰਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "जब तिह अंग मैनता वई ॥",
      "sourceLineId": "130558",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਲਰਿਕਾਪਨ ਕੀ ਸੁਧਿ ਬੁਧਿ ਗਈ ॥੨॥",
      "transliteration": "larikaapan kee sudh budh giee ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਬਚਪਨ ਦੀ ਸਾਰੀ ਸੁੱਧ ਬੁੱਧ ਭੁਲ ਗਈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "लरिकापन की सुधि बुधि गई ॥२॥",
      "sourceLineId": "130559",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹੁਤੋ ਬਾਗ ਇਕ ਤਹਾ ਅਪਾਰਾ ॥",
      "transliteration": "huto baag ik tahaa apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਬਹੁਤ ਵੱਡਾ ਬਾਗ਼ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "हुतो बाग इक तहा अपारा ॥",
      "sourceLineId": "130560",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਿਹ ਸਰ ਨੰਦਨ ਕਹਾ ਬਿਚਾਰਾ ॥",
      "transliteration": "jeh sar na(n)dhan kahaa bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਬਰਾਬਰ ਨੰਦਨ ਵਿਚਾਰਾ ਕੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "जिह सर नंदन कहा बिचारा ॥",
      "sourceLineId": "130561",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਹਾ ਗਈ ਵਹੁ ਕੁਅਰਿ ਮੁਦਿਤ ਮਨ ॥",
      "transliteration": "tahaa giee vahu kuar mudhit man ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰਾਜ ਕੁਮਾਰੀ ਪ੍ਰਸੰਨ ਚਿਤ ਨਾਲ ਉਥੇ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "तहा गई वहु कुअरि मुदित मन ॥",
      "sourceLineId": "130562",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਲਏ ਸੁੰਦਰੀ ਸੰਗ ਕਰਿ ਅਨਗਨ ॥੩॥",
      "transliteration": "le su(n)dharee sa(n)g kar anagan ||3||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਸੁੰਦਰੀਆਂ ਨੂੰ ਨਾਲ ਲੈ ਕੇ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "लए सुँदरी संग करि अनगन ॥३॥",
      "sourceLineId": "130563",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਹ ਨਿਰਖਾ ਇਕ ਸਾਹ ਸਰੂਪਾ ॥",
      "transliteration": "teh nirakhaa ik saeh saroopaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਉਸ ਨੇ ਇਕ ਸੁੰਦਰ ਸਰੂਪ ਵਾਲੇ ਸ਼ਾਹ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "तह निरखा इक साह सरूपा ॥",
      "sourceLineId": "130564",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੂਰਤਿ ਸੀਰਤਿ ਮਾਝਿ ਅਨੂਪਾ ॥",
      "transliteration": "soorat seerat maajh anoopaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸੂਰਤ ਅਤੇ ਸ਼ੀਲ ਵਿਚ ਅਦੁੱਤੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "सूरति सीरति माझि अनूपा ॥",
      "sourceLineId": "130565",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰੀਝੀ ਕੁਅਰਿ ਅਟਕਿ ਗੀ ਤਬ ਹੀ ॥",
      "transliteration": "reejhee kuar aTak gee tab hee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਸੁੰਦਰੀ ਨੇ ਜਦੋਂ ਹੀ ਉਸ ਸੁੰਦਰ ਅਤੇ ਸੁਘੜ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "रीझी कुअरि अटकि गी तब ही ॥",
      "sourceLineId": "130566",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੁੰਦਰ ਸੁਘਰ ਨਿਹਾਰਿਯੋ ਜਬ ਹੀ ॥੪॥",
      "transliteration": "su(n)dhar sughar nihaariyo jab hee ||4||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਪ੍ਰਸੰਨ ਹੋ ਕੇ ਉਸ ਵਿਚ ਅਟਕ ਗਈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "सुँदर सुघर निहारियो जब ही ॥४॥",
      "sourceLineId": "130567",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਭ ਸੁਧਿ ਭੂਲਿ ਸਦਨ ਕੀ ਗਈ ॥",
      "transliteration": "sabh sudh bhool sadhan kee giee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਘਰ ਦੀ ਸਾਰੀ ਸੁੱਧ ਬੁੱਧ ਭੁਲ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "सभ सुधि भूलि सदन की गई ॥",
      "sourceLineId": "130568",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਆਠ ਟੂਕ ਤਿਹ ਉਪਰ ਭਈ ॥",
      "transliteration": "aaTh Took teh upar bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਉਤੋਂ ਅੱਠ ਟੋਟੇ ਹੋ ਕੇ (ਨਿਛਾਵਰ) ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "आठ टूक तिह उपर भई ॥",
      "sourceLineId": "130569",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1203_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗ੍ਰਿਹ ਐਬੇ ਕੀ ਬੁਧਿ ਨ ਆਈ ॥",
      "transliteration": "gireh aaibe kee budh na aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਘਰ ਆਉਣ ਦੀ ਬੁੱਧੀ ਵੀ ਨਾ ਰਹੀ",
      "source": "DASAM_GRANTH",
      "ang": 1203,
      "hindi": "",
      "hindiTransliteration": "गृह ऐबे की बुधि न आई ॥",
      "sourceLineId": "130570",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
