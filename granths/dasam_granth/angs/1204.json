{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1204,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1204_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਹੀ ਉਧਰਿ ਤਿਹ ਸੰਗ ਸਿਧਾਈ ॥੫॥",
      "transliteration": "tahee udhar teh sa(n)g sidhaiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਉਥੋਂ ਹੀ ਚਲੀ ਗਈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "तही उधरि तिह संग सिधाई ॥५॥",
      "sourceLineId": "130571",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਹਚਰਿ ਭੇਦ ਚਰਿਤ ਇਕ ਜਾਨਾ ॥",
      "transliteration": "sahachar bhedh charit ik jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਸਖੀ ਨੇ (ਉਸ ਦਾ ਇਹ) ਚਰਿਤ੍ਰ ਸਮਝ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "सहचरि भेद चरित इक जाना ॥",
      "sourceLineId": "130572",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਸਾਥ ਚਰਿਤ੍ਰ ਪ੍ਰਮਾਨਾ ॥",
      "transliteration": "eeh bidh saath charitr pramaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਢੰਗ ਨਾਲ ਚਰਿਤ੍ਰ ਖੇਡਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "इह बिधि साथ चरित्र प्रमाना ॥",
      "sourceLineId": "130573",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰੋਇ ਰੋਇ ਧੁਨਿ ਊਚ ਪੁਕਾਰੈ ॥",
      "transliteration": "roi roi dhun uooch pukaarai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਰੋ ਰੋ ਕੇ ਉੱਚੀ ਆਵਾਜ਼ ਵਿਚ ਪੁਕਾਰਨ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "रोइ रोइ धुनि ऊच पुकारै ॥",
      "sourceLineId": "130574",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੈ ਦੈ ਮੂੰਡ ਧਰਨਿ ਸੌ ਮਾਰੈ ॥੬॥",
      "transliteration": "dhai dhai moo(n)dd dharan sau maarai ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਿਰ ਨੂੰ ਚੁਕ ਚੁਕ ਕੇ ਧਰਤੀ ਉਤੇ ਮਾਰਨ ਲਗੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "दै दै मूँड धरनि सौ मारै ॥६॥",
      "sourceLineId": "130575",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚੰਪਕਲਾ ਰਾਜਾ ਕੀ ਜਾਈ ॥",
      "transliteration": "cha(n)pakalaa raajaa kee jaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗੀ ਕਿ) ਰਾਜ ਕੁਮਾਰੀ ਚੰਪਕਲਾ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "चंपकला राजा की जाई ॥",
      "sourceLineId": "130576",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਾਛਸ ਗਹੀ ਆਨਿ ਦੁਖਦਾਈ ॥",
      "transliteration": "raachhas gahee aan dhukhadhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦੁਖਦਾਇਕ ਰਾਖਸ਼ ਚੁਕ ਕੇ ਲੈ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "राछस गही आनि दुखदाई ॥",
      "sourceLineId": "130577",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਾਹਿ ਛੁਰੈਯੈ ਜਾਨ ਨ ਦੀਜੈ ॥",
      "transliteration": "taeh chhuraiyai jaan na dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਛੁੜਾ ਲਵੋ ਅਤੇ ਜਾਣ ਨਾ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "ताहि छुरैयै जान न दीजै ॥",
      "sourceLineId": "130578",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬੇਗਹਿ ਬਧ ਦਾਨਵ ਕੋ ਕੀਜੈ ॥੭॥",
      "transliteration": "begeh badh dhaanav ko keejai ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਲਦੀ ਹੀ ਦਾਨਵ ਦਾ ਕਤਲ ਕਰ ਦਿਓ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "बेगहि बध दानव को कीजै ॥७॥",
      "sourceLineId": "130579",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਏ ਸੁਨਿ ਬੈਨ ਲੋਗ ਸਭ ਧਾਏ ॥",
      "transliteration": "e sun bain log sabh dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਗੱਲ ਸੁਣ ਕੇ ਸਾਰੇ ਲੋਗ ਤਲਵਾਰਾ ਕਢ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "ए सुनि बैन लोग सभ धाए ॥",
      "sourceLineId": "130580",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਾਢੇ ਖੜਗ ਬਾਗ ਮੈ ਆਏ ॥",
      "transliteration": "kaadde khaRag baag mai aae ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਗ਼ ਵਿਚ ਆ ਪਹੁੰਚੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "काढे खड़ग बाग मै आए ॥",
      "sourceLineId": "130581",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦੈਤ ਵੈਤ ਤਹ ਕਛੁ ਨ ਨਿਹਾਰਾ ॥",
      "transliteration": "dhait vait teh kachh na nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਉਥੇ ਕੋਈ ਦੈਂਤ ਵੈਂਤ ਨਾ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "दैत वैत तह कछु न निहारा ॥",
      "sourceLineId": "130582",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚਕ੍ਰਿਤ ਭੇ ਜਿਯ ਮਾਝ ਬਿਚਾਰਾ ॥੮॥",
      "transliteration": "chakirat bhe jiy maajh bichaaraa ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੈਰਾਨ ਹੋ ਕੇ ਮਨ ਵਿਚ ਵਿਚਾਰਨ ਲਗੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "चकृत भे जिय माझ बिचारा ॥८॥",
      "sourceLineId": "130583",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹਰਿ ਦਾਨਵ ਤਿਹ ਗਯੋ ਅਕਾਸਾ ॥",
      "transliteration": "har dhaanav teh gayo akaasaa ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿ) ਰਾਖਸ਼ ਉਸ ਨੂੰ ਚੁਕ ਕੇ ਆਕਾਸ਼ ਵਲ ਚਲਾ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "हरि दानव तिह गयो अकासा ॥",
      "sourceLineId": "130584",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਾਜ ਕੁਅਰਿ ਤੇ ਭਏ ਨਿਰਾਸਾ ॥",
      "transliteration": "raaj kuar te bhe niraasaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰਾਜ ਕੁਮਾਰੀ ਵਲੋਂ ਨਿਰਾਸ਼ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "राज कुअरि ते भए निरासा ॥",
      "sourceLineId": "130585",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰੋਇ ਪੀਟ ਦੁਹਿਤਾ ਕਹ ਹਾਰੇ ॥",
      "transliteration": "roi peeT dhuhitaa keh haare ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਰਾਜ ਕੁਮਾਰੀ ਨੂੰ ਖੁਹਾ ਕੇ ਬਹੁਤ ਦੁਖੀ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "रोइ पीट दुहिता कह हारे ॥",
      "sourceLineId": "130586",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਾਜਾ ਭਏ ਅਧਿਕ ਦੁਖਿਯਾਰੇ ॥੯॥",
      "transliteration": "raajaa bhe adhik dhukhiyaare ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰੋ ਪਿਟ ਕੇ ਬੈਠ ਗਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "राजा भए अधिक दुखियारे ॥९॥",
      "sourceLineId": "130587",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕੇਤਿਕ ਦਿਨਨ ਸਕਲ ਧਨ ਖਾਯੋ ॥",
      "transliteration": "ketik dhinan sakal dhan khaayo ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਝ ਦਿਨਾ ਤਕ (ਉਨ੍ਰਹਾ ਨੇ) ਸਾਰਾ ਧਨ ਖ਼ਰਚ ਕਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "केतिक दिनन सकल धन खायो ॥",
      "sourceLineId": "130588",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦੇਸ ਬਿਦੇਸ ਫਿਰਤ ਦੁਖ ਪਾਯੋ ॥",
      "transliteration": "dhes bidhes firat dhukh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੇਸ ਵਿਦੇਸ਼ ਵਿਚ ਫਿਰ ਕੇ ਬਹੁਤ ਦੁਖ-ਪ੍ਰਾਪਤ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "देस बिदेस फिरत दुख पायो ॥",
      "sourceLineId": "130589",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਾਜ ਕੁਅਰਿ ਮਿਤ੍ਰਹਿ ਕੌ ਤ੍ਯਾਗੀ ॥",
      "transliteration": "raaj kuar mitreh kau tayaagee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਮਿਤਰ ਨੂੰ ਤਿਆਗ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "राज कुअरि मित्रहि कौ त्यागी ॥",
      "sourceLineId": "130590",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਆਧੀ ਰਤਿ ਦੇਸ ਕੌ ਭਾਗੀ ॥੧੦॥",
      "transliteration": "aadhee rat dhes kau bhaagee ||10||",
      "translation": "",
      "punjabiViakhya": "ਅੱਧੀ ਰਾਤ ਨੂੰ ਆਪਣੇ ਦੇਸ ਵਲ ਭਜ ਗਈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "आधी रति देस कौ भागी ॥१०॥",
      "sourceLineId": "130591",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਲਿਖਿ ਪਤ੍ਰੀ ਪਿਤ ਪਾਸ ਪਠਾਈ ॥",
      "transliteration": "likh patree pit paas paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਚਿੱਠੀ ਲਿਖ ਕੇ ਪਿਤਾ ਪਾਸ ਭੇਜੀ",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "लिखि पत्री पित पास पठाई ॥",
      "sourceLineId": "130592",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦਾਨਵ ਤੇ ਮੈ ਦੇਵ ਛੁਰਾਈ ॥",
      "transliteration": "dhaanav te mai dhev chhuraiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮੈਨੂੰ ਪ੍ਰਭੂ ਨੇ ਰਾਖਸ਼ ਤੋਂ ਛੁੜਵਾ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "दानव ते मै देव छुराई ॥",
      "sourceLineId": "130593",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪਠੈ ਮਨੁਛ ਅਬ ਬੋਲਿ ਪਠਾਵਹੁ ॥",
      "transliteration": "paThai manuchh ab bol paThaavahu ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਬੰਦਾ ਭੇਜ ਕੇ (ਮੈਨੂੰ) ਬੁਲਵਾ ਲਵੋ",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "पठै मनुछ अब बोलि पठावहु ॥",
      "sourceLineId": "130594",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮੋਹਿ ਮਿਲਾਇ ਅਧਿਕ ਸੁਖ ਪਾਵਹੁ ॥੧੧॥",
      "transliteration": "moh milai adhik sukh paavahu ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੈਨੂੰ ਮਿਲ ਕੇ ਅਧਿਕ ਸੁਖ ਪ੍ਰਾਪਤ ਕਰੋ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "मोहि मिलाइ अधिक सुख पावहु ॥११॥",
      "sourceLineId": "130595",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪੜਿ ਪਤ੍ਰੀ ਪਿਤ ਕੰਠ ਲਗਾਈ ॥",
      "transliteration": "paR patree pit ka(n)Th lagaiee ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਤਾ ਨੇ ਚਿੱਠੀ ਪੜ੍ਰਹ ਕੇ (ਆਪਣੇ) ਗਲੇ ਨਾਲ ਲਗਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "पड़ि पत्री पित कंठ लगाई ॥",
      "sourceLineId": "130596",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਧਿਕ ਪਾਲਕੀ ਤਹਾ ਪਠਾਈ ॥",
      "transliteration": "adhik paalakee tahaa paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਸਾਰੀਆਂ ਪਾਲਕੀਆਂ ਉਥੇ ਭੇਜ ਦਿੱਤੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "अधिक पालकी तहा पठाई ॥",
      "sourceLineId": "130597",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚੰਪਕਲਾ ਕਹ ਗ੍ਰਿਹ ਲੈ ਆਯੋ ॥",
      "transliteration": "cha(n)pakalaa keh gireh lai aayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਚੰਪਕਲਾ ਨੂੰ ਘਰ ਲੈ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "चंपकला कह गृह लै आयो ॥",
      "sourceLineId": "130598",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮੂਰਖ ਭੇਦ ਅਭੇਦ ਨ ਪਾਯੋ ॥੧੨॥",
      "transliteration": "moorakh bhedh abhedh na paayo ||12||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਭੇਦ ਅਭੇਦ ਨੂੰ ਕੁਝ ਨਾ ਸਮਝ ਸਕਿਆ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "मूरख भेद अभेद न पायो ॥१२॥",
      "sourceLineId": "130599",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਅਠਸਠ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੬੮॥੫੨੨੯॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau aThasaTh charitr samaapatam sat subham sat ||268||5229||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੬੮ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੬੮॥੫੨੨੯॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ अठसठ चरित्र समापतम सतु सुभम सतु ॥२६८॥५२२९॥अफजूँ॥",
      "sourceLineId": "130600",
      "sourceShabadId": "12401",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130601",
      "sourceShabadId": "12402",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੂਆ ਬੰਦਰ ਇਕ ਰਹਤ ਨ੍ਰਿਪਾਲਾ ॥",
      "transliteration": "gooaa ba(n)dhar ik rahat nirapaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਗੋਆ ਬੰਦਰਗਾਹ ਵਿਚ ਇਕ ਰਾਜਾ ਰਹਿੰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "गूआ बंदर इक रहत नृपाला ॥",
      "sourceLineId": "130602",
      "sourceShabadId": "12402",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਾ ਕੋ ਡੰਡ ਭਰਤ ਭੂਆਲਾ ॥",
      "transliteration": "jaa ko dda(n)dd bharat bhooaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਸਾਰੇ ਰਾਜੇ ਦੰਡ ਭਰਦੇ ਸਨ (ਅਰਥਾਤ ਅਧੀਨਗੀ ਸਵੀਕਾਰ ਕਰਦੇ ਸਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "जा को डंड भरत भूआला ॥",
      "sourceLineId": "130603",
      "sourceShabadId": "12402",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਪ੍ਰਮਾਨ ਤਾ ਕੇ ਘਰ ਮੈ ਧਨ ॥",
      "transliteration": "apramaan taa ke ghar mai dhan ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਬੇਹਿਸਾਬ ਧਨ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "अप्रमान ता के घर मै धन ॥",
      "sourceLineId": "130604",
      "sourceShabadId": "12402",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚੰਦ੍ਰ ਸੂਰ ਕੈ ਇੰਦ੍ਰ ਦੁਤਿਯ ਜਨੁ ॥੧॥",
      "transliteration": "cha(n)dhr soor kai i(n)dhr dhutiy jan ||1||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਦੂਜਾ ਸੂਰਜ ਜਾ ਚੰਦ੍ਰਮਾ ਜਾ ਇੰਦਰ ਹੋਵੇ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "चंद्र सूर कै इंद्र दुतिय जनु ॥१॥",
      "sourceLineId": "130605",
      "sourceShabadId": "12402",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮਿਤ੍ਰ ਮਤੀ ਤਾ ਕੀ ਅਰਧੰਗਾ ॥",
      "transliteration": "mitr matee taa kee aradha(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਿਤ੍ਰ ਮਤੀ (ਨਾ ਦੀ) ਉਸ ਦੀ ਇਸਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "मित्र मती ता की अरधंगा ॥",
      "sourceLineId": "130606",
      "sourceShabadId": "12402",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪੁੰਨ੍ਰਯਮਾਨ ਦੂਸਰ ਜਨੁ ਗੰਗਾ ॥",
      "transliteration": "pu(n)nrayamaan dhoosar jan ga(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਮਾਨੋ ਦੂਜੀ ਪਵਿਤ੍ਰ ਗੰਗਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "पुँन्रयमान दूसर जनु गंगा ॥",
      "sourceLineId": "130607",
      "sourceShabadId": "12402",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮੀਨ ਕੇਤੁ ਰਾਜਾ ਤਹ ਰਾਜੈ ॥",
      "transliteration": "meen ket raajaa teh raajai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਮੀਨ ਕੇਤੁ ਨਾ ਦਾ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "मीन केतु राजा तह राजै ॥",
      "sourceLineId": "130608",
      "sourceShabadId": "12402",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਾ ਕੋ ਨਿਰਖਿ ਮੀਨ ਧੁਜ ਲਾਜੈ ॥੨॥",
      "transliteration": "jaa ko nirakh meen dhuj laajai ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਕਾਮ ਦੇਵ ਵੀ ਸ਼ਰਮਸਾਰ ਹੁੰਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "जा को निरखि मीन धुज लाजै ॥२॥",
      "sourceLineId": "130609",
      "sourceShabadId": "12402",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "130610",
      "sourceShabadId": "12403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸ੍ਰੀ ਝਖਕੇਤੁ ਮਤੀ ਦੁਹਿਤਾ ਤਿਹ ਜਾਨਿਯੈ ॥",
      "transliteration": "sree jhakhaket matee dhuhitaa teh jaaniyai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਝਖਕੇਤੁ ਮਤੀ ਨਾ ਦੀ ਪੁੱਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "स्री झखकेतु मती दुहिता तिह जानियै ॥",
      "sourceLineId": "130611",
      "sourceShabadId": "12403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਪ੍ਰਮਾਨ ਅਬਲਾ ਕੀ ਪ੍ਰਭਾ ਪ੍ਰਮਾਨਿਯੈ ॥",
      "transliteration": "apramaan abalaa kee prabhaa pramaaniyai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਅਬਲਾ ਦੀ ਅਸੀਮ ਸੁੰਦਰਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "अप्रमान अबला की प्रभा प्रमानियै ॥",
      "sourceLineId": "130612",
      "sourceShabadId": "12403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਾ ਸਮ ਸੁੰਦਰਿ ਕਹੂੰ ਨ ਜਗ ਮਹਿ ਜਾਨਿਯਤ ॥",
      "transliteration": "jaa sam su(n)dhar kahoo(n) na jag meh jaaniyat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗਾ ਕੋਈ ਵੀ ਜਗਤ ਵਿਚ ਸੁੰਦਰ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "जा सम सुँदरि कहूँ न जग महि जानियत ॥",
      "sourceLineId": "130613",
      "sourceShabadId": "12403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹੋ ਰੂਪਮਾਨ ਉਹਿ ਕੀ ਸੀ ਵਹੀ ਬਖਾਨਿਯਤ ॥੩॥",
      "transliteration": "ho roopamaan uh kee see vahee bakhaaniyat ||3||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ ਰੂਪਮਾਨ ਉਹੀ ਦਸੀ ਜਾਦੀ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "हो रूपमान उहि की सी वही बखानियत ॥३॥",
      "sourceLineId": "130614",
      "sourceShabadId": "12403",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130615",
      "sourceShabadId": "12404",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪ੍ਰਾਤ ਭਏ ਨ੍ਰਿਪ ਸਭਾ ਲਗਾਈ ॥",
      "transliteration": "praat bhe nirap sabhaa lagaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਕ ਦਿਨ) ਸਵੇਰ ਵੇਲੇ ਰਾਜੇ ਨੇ ਸਭਾ ਲਗਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "प्रात भए नृप सभा लगाई ॥",
      "sourceLineId": "130616",
      "sourceShabadId": "12404",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਊਚ ਨੀਚ ਸਭ ਲਿਯਾ ਬੁਲਾਈ ॥",
      "transliteration": "uooch neech sabh liyaa bulaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਵਿਚ ਉਸ ਨੇ) ਉੱਚੇ ਨੀਵੇਾਂ ਸਭ ਬੁਲਾ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "ऊच नीच सभ लिया बुलाई ॥",
      "sourceLineId": "130617",
      "sourceShabadId": "12404",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1204_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਹ ਇਕ ਪੁਤ੍ਰ ਸਾਹੁ ਕੋ ਆਯੋ ॥",
      "transliteration": "teh ik putr saahu ko aayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸ਼ਾਹ ਦਾ ਪੁੱਤਰ ਵੀ ਆਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1204,
      "hindi": "",
      "hindiTransliteration": "तह इक पुत्र साहु को आयो ॥",
      "sourceLineId": "130618",
      "sourceShabadId": "12404",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
