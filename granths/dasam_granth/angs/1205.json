{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1205,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1205_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਹ ਸਮ ਦਿਤਿ ਆਦਿਤਿ ਨ ਜਾਯੋ ॥੪॥",
      "transliteration": "jeh sam dhit aadhit na jaayo ||4||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਸੁੰਦਰ ਦੇਵਤਿਆਂ ਅਤੇ ਦੈਂਤਾ ਵਿਚੋਂ ਕੋਈ ਵੀ ਨਹੀਂ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "जिह सम दिति आदिति न जायो ॥४॥",
      "sourceLineId": "130619",
      "sourceShabadId": "12404",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "130620",
      "sourceShabadId": "12405",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਾਜ ਕੁਅਰਿ ਰਹੀ ਥਕਿਤ ਸੁ ਤਾਹਿ ਨਿਹਾਰਿ ਕਰਿ ॥",
      "transliteration": "raaj kuar rahee thakit su taeh nihaar kar ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਨਿਢਾਲ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "राज कुअरि रही थकित सु ताहि निहारि करि ॥",
      "sourceLineId": "130621",
      "sourceShabadId": "12405",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚਕ੍ਰਿਤ ਚਿਤ ਮਹਿ ਰਹੀ ਚਰਿਤ੍ਰ ਬਿਚਾਰਿ ਕਰਿ ॥",
      "transliteration": "chakirat chit meh rahee charitr bichaar kar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਨ ਵਿਚ (ਇਕ) ਚਰਿਤ੍ਰ ਵਿਚਾਰ ਕੇ ਹੈਰਾਨ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "चकृत चित महि रही चरित्र बिचारि करि ॥",
      "sourceLineId": "130622",
      "sourceShabadId": "12405",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਖੀ ਪਠੀ ਤਿਹ ਧਾਮ ਮਿਲਨ ਕੀ ਆਸ ਕੈ ॥",
      "transliteration": "sakhee paThee teh dhaam milan kee aas kai ||",
      "translation": "",
      "punjabiViakhya": "ਮਿਲਣ ਦੀ ਆਸ ਨਾਲ ਇਕ ਦਾਸੀ ਨੂੰ ਉਸ ਦੇ ਘਰ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "सखी पठी तिह धाम मिलन की आस कै ॥",
      "sourceLineId": "130623",
      "sourceShabadId": "12405",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹੋ ਚਾਹ ਰਹੀ ਜਸ ਮੇਘ ਪਪਿਹਰਾ ਪ੍ਯਾਸ ਕੈ ॥੫॥",
      "transliteration": "ho chaeh rahee jas megh papiharaa payaas kai ||5||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਲਈ ਮਨ ਵਿਚ) ਇਹੋ ਜਿਹੀ ਚਾਹ ਪੈਦਾ ਹੋ ਗਈ ਜਿਵੇਾਂ ਬਦਲ ਲਈ ਪਪੀਹੇ ਦੀ ਪਿਆਸ ਹੁੰਦੀ ਹੈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "हो चाह रही जस मेघ पपिहरा प्यास कै ॥५॥",
      "sourceLineId": "130624",
      "sourceShabadId": "12405",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "130625",
      "sourceShabadId": "12406",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਤਿ ਪ੍ਰਸੰਨ੍ਯ ਚਿਤ ਮਹਿ ਭਈ ਮਨ ਭਾਵਨ ਕਹ ਪਾਇ ॥",
      "transliteration": "at prasa(n)nay chit meh bhiee man bhaavan keh pai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮਨ ਪਸੰਦ (ਮਿਤਰ) ਨੂੰ ਪ੍ਰਾਪਤ ਕਰ ਕੇ ਚਿਤ ਵਿਚ ਬਹੁਤ ਖ਼ੁਸ਼ ਹੋਈ",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "अति प्रसंन्य चित महि भई मन भावन कह पाइ ॥",
      "sourceLineId": "130626",
      "sourceShabadId": "12406",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਹਚਰਿ ਕੋ ਜੁ ਦਰਦ੍ਰਿ ਥੋ ਤਤਛਿਨ ਦਿਯਾ ਮਿਟਾਇ ॥੬॥",
      "transliteration": "sahachar ko ju dharadhr tho tatachhin dhiyaa miTai ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ) ਦਾਸੀ ਦੀ ਜੋ ਗ਼ਰੀਬੀ ਸੀ, ਉਹ ਛਿਣ ਵਿਚ ਮਿਟਾ ਦਿੱਤੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "सहचरि को जु दरदृ थो ततछिन दिया मिटाइ ॥६॥",
      "sourceLineId": "130627",
      "sourceShabadId": "12406",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130628",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਬ ਹੀ ਤਰੁਨਿ ਤਰੁਨ ਕੌ ਪਾਯੋ ॥",
      "transliteration": "jab hee tarun tarun kau paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਸ਼ਾਹ ਦੇ ਪੁੱਤਰ ਨੂੰ ਪ੍ਰਾਪਤ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "जब ही तरुनि तरुन कौ पायो ॥",
      "sourceLineId": "130629",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਿਨ ਗਰੇ ਲਗਾਯੋ ॥",
      "transliteration": "bhaat bhaat tin gare lagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਭਾਤ ਭਾਤ ਨਾਲ ਉਸ ਨੂੰ ਗਲੇ ਨਾਲ ਲਗਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तिन गरे लगायो ॥",
      "sourceLineId": "130630",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰੈਨਿ ਸਗਰਿ ਰਤਿ ਕਰਤ ਬਿਹਾਨੀ ॥",
      "transliteration": "rain sagar rat karat bihaanee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਰਾਤ ਰਤੀ-ਕ੍ਰੀੜਾ ਕਰਦਿਆਂ ਗੁਜ਼ਾਰ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "रैनि सगरि रति करत बिहानी ॥",
      "sourceLineId": "130631",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚਾਰਿ ਪਹਰ ਪਲ ਚਾਰ ਪਛਾਨੀ ॥੭॥",
      "transliteration": "chaar pahar pal chaar pachhaanee ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਾਰ ਪਹਿਰਾ (ਦੀ ਲੰਬੀ ਰਾਤ ਨੂੰ) ਚਾਰ ਪਲਾ ਜਿਤਨੀ (ਲੰਬੀ) ਸਮਝਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "चारि पहर पल चार पछानी ॥७॥",
      "sourceLineId": "130632",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪਿਛਲੀ ਪਹਰ ਰਾਤ੍ਰਿ ਜਬ ਰਹੀ ॥",
      "transliteration": "pichhalee pahar raatr jab rahee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਤ ਦਾ ਪਿਛਲਾ ਪਹਿਰ ਰਹਿ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "पिछली पहर रातृ जब रही ॥",
      "sourceLineId": "130633",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰਾਜ ਕੁਅਰਿ ਐਸੇ ਤਿਹ ਕਹੀ ॥",
      "transliteration": "raaj kuar aaise teh kahee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਉਸ (ਸ਼ਾਹ ਦੇ ਪੁੱਤਰ ਨੂੰ) ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "राज कुअरि ऐसे तिह कही ॥",
      "sourceLineId": "130634",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਮ ਤੁਮ ਆਵ ਨਿਕਸਿ ਦੋਊ ਜਾਵੈ ॥",
      "transliteration": "ham tum aav nikas dhouoo jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਆਓ ਅਸੀਂ ਤੁਸੀਂ ਦੋਵੇਾਂ (ਇਥੋਂ) ਭਜ ਚਲੀਏ",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "हम तुम आव निकसि दोऊ जावै ॥",
      "sourceLineId": "130635",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਔਰ ਦੇਸ ਦੋਊ ਕਹੂੰ ਸੁਹਾਵੈ ॥੮॥",
      "transliteration": "aauar dhes dhouoo kahoo(n) suhaavai ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਵੇਾਂ ਕਿਸੇ ਹੋਰ ਦੇਸ਼ ਵਿਚ ਜਾ ਵਸੀਏ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "और देस दोऊ कहूँ सुहावै ॥८॥",
      "sourceLineId": "130636",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤੁਹਿ ਮੁਹਿ ਕਹ ਧਨ ਕੀ ਥੁਰ ਨਾਹੀ ॥",
      "transliteration": "tuh muh keh dhan kee thur naahee ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਤੈਨੂੰ ਧਨ ਦੀ ਕੋਈ ਥੁੜ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "तुहि मुहि कह धन की थुर नाही ॥",
      "sourceLineId": "130637",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤੁਮਰੀ ਚਹਤ ਕੁਸਲ ਮਨ ਮਾਹੀ ॥",
      "transliteration": "tumaree chahat kusal man maahee ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਮਨ ਵਿਚ ਤੇਰੀ ਸੁਖਸਾਦ ਚਾਹੁੰਦੀ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "तुमरी चहत कुसल मन माही ॥",
      "sourceLineId": "130638",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਯੌ ਕਹਿ ਦੁਹੂੰ ਅਧਿਕ ਧਨੁ ਲੀਨਾ ॥",
      "transliteration": "yau keh dhuhoo(n) adhik dhan leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਕਹਿ ਕੇ ਦੋਹਾ ਨੇ ਬਹੁਤ ਧਨ ਲੈ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "यौ कहि दुहूँ अधिक धनु लीना ॥",
      "sourceLineId": "130639",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਔਰੇ ਦੇਸ ਪਯਾਨਾ ਕੀਨਾ ॥੯॥",
      "transliteration": "aauare dhes payaanaa keenaa ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਸੇ ਹੋਰ ਦੇਸ ਵਲ ਚਲੇ ਗਏ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "औरे देस पयाना कीना ॥९॥",
      "sourceLineId": "130640",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚਤੁਰਿ ਭੇਦ ਸਹਚਰਿ ਇਕ ਪਾਈ ॥",
      "transliteration": "chatur bhedh sahachar ik paiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਚਤੁਰ ਸਖੀ ਨੇ ਇਕ ਭੇਦ (ਦੀ ਗੱਲ) ਸੋਚੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "चतुरि भेद सहचरि इक पाई ॥",
      "sourceLineId": "130641",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਿਹ ਗ੍ਰਿਹ ਕੋ ਦਈ ਆਗਿ ਲਗਾਈ ॥",
      "transliteration": "teh gireh ko dhiee aag lagaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਨੂੰ ਅਗ ਲਗਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "तिह गृह को दई आगि लगाई ॥",
      "sourceLineId": "130642",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਰਨਿਯਨਿ ਰਾਨੀ ਜਰੀ ਸੁਨਾਈ ॥",
      "transliteration": "raniyan raanee jaree sunaiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀਆਂ ਨੂੰ ਰਾਜ ਕੁਮਾਰੀ ਦੇ ਸੜਨ ਦੀ ਗੱਲ ਸੁਣਾ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "रनियनि रानी जरी सुनाई ॥",
      "sourceLineId": "130643",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰੋਵਤ ਆਪੁ ਨ੍ਰਿਪਹਿ ਪਹਿ ਧਾਈ ॥੧੦॥",
      "transliteration": "rovat aap nirapeh peh dhaiee ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪ ਰੋਂਦੀ ਹੋਈ ਰਾਜੇ ਕੋਲ ਗਈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "रोवत आपु नृपहि पहि धाई ॥१०॥",
      "sourceLineId": "130644",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰਾਨੀ ਕਹਾ ਨ੍ਰਿਪਹਿ ਜਰਿ ਮਰੀ ॥",
      "transliteration": "raanee kahaa nirapeh jar maree ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਕਿਹਾ ਕਿ ਰਾਜ ਕੁਮਾਰੀ ਸੜ ਮੋਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "रानी कहा नृपहि जरि मरी ॥",
      "sourceLineId": "130645",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤੁਮ ਤਾ ਕੀ ਕਛੁ ਸੁਧਿ ਨ ਕਰੀ ॥",
      "transliteration": "tum taa kee kachh sudh na karee ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਉਸ ਬਾਰੇ ਕੋਈ ਸੁੱਧ ਨਹੀਂ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "तुम ता की कछु सुधि न करी ॥",
      "sourceLineId": "130646",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਬ ਤਿਨ ਕੇ ਚਲਿ ਅਸਤਿ ਉਠਾਵੌ ॥",
      "transliteration": "ab tin ke chal asat uThaavau ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਚਲ ਕੇ ਉਸ ਦੀਆਂ ਅਸਥੀਆਂ ਨੂੰ ਉਠਾਓ",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "अब तिन के चलि असति उठावौ ॥",
      "sourceLineId": "130647",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਾਨੁਖ ਦੈ ਗੰਗਾ ਪਹੁਚਾਵੌ ॥੧੧॥",
      "transliteration": "maanukh dhai ga(n)gaa pahuchaavau ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬੰਦੇ ਨੂੰ ਭੇਜ ਕੇ ਗੰਗਾ ਵਿਚ ਪਹੁੰਚਾਓ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "मानुख दै गंगा पहुचावौ ॥११॥",
      "sourceLineId": "130648",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨ੍ਰਿਪ ਸੁਨਿ ਬਚਨ ਉਤਾਇਲ ਧਾਯੋ ॥",
      "transliteration": "nirap sun bachan utail dhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਇਹ ਗੱਲ ਸੁਣ ਕੇ ਜਲਦੀ ਨਾਲ ਭਜ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "नृप सुनि बचन उताइल धायो ॥",
      "sourceLineId": "130649",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਹ ਗ੍ਰਿਹ ਜਰਤ ਹੁਤੋ ਤਹ ਆਯੋ ॥",
      "transliteration": "jeh gireh jarat huto teh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਥੇ ਘਰ ਸੜ ਰਿਹਾ ਸੀ, ਉਥੇ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "जह गृह जरत हुतो तह आयो ॥",
      "sourceLineId": "130650",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਹਾ ਕਰਤ ਰਾਨੀਯਹਿ ਨਿਕਾਰਹੁ ॥",
      "transliteration": "hahaa karat raaneeyeh nikaarahu ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਹਾਕਾਰ ਕਰਨ ਲਗਾ ਕਿ ਰਾਜ ਕੁਮਾਰੀ ਨੂੰ ਬਾਹਰ ਕਢੋ",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "हहा करत रानीयहि निकारहु ॥",
      "sourceLineId": "130651",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਰਤਿ ਅਗਨਿ ਤੇ ਯਾਹਿ ਉਬਾਰਹੁ ॥੧੨॥",
      "transliteration": "jarat agan te yaeh ubaarahu ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਬਲਦੀ ਅੱਗ ਵਿਚੋਂ ਬਚਾ ਲਵੋ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "जरति अगनि ते याहि उबारहु ॥१२॥",
      "sourceLineId": "130652",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਾਨੀ ਜਰੀ ਅਗਨਿ ਮਹਿ ਰਾਨੀ ॥",
      "transliteration": "jaanee jaree agan meh raanee ||",
      "translation": "",
      "punjabiViakhya": "(ਸਭ ਨੇ) ਜਾਣ ਲਿਆ ਕਿ ਰਾਜ ਕੁਮਾਰੀ ਅੱਗ ਵਿਚ ਸੜ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "जानी जरी अगनि महि रानी ॥",
      "sourceLineId": "130653",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਉਧਲਿ ਗਈ ਮਨ ਬਿਖੈ ਨ ਆਨੀ ॥",
      "transliteration": "audhal giee man bikhai na aanee ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ ਕਿਸੇ ਨੇ) ਮਨ ਵਿਚ ਇਹ ਨਹੀਂ ਸੋਚਿਆ ਕਿ (ਉਹ) ਉਧਲ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "उधलि गई मन बिखै न आनी ॥",
      "sourceLineId": "130654",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਧਿਕ ਸੋਕ ਮਨ ਮਾਹਿ ਬਢਾਯੋ ॥",
      "transliteration": "adhik sok man maeh baddaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਮਨ ਵਿਚ ਬਹੁਤ ਦੁਖ ਮੰਨਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "अधिक सोक मन माहि बढायो ॥",
      "sourceLineId": "130655",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪ੍ਰਜਾ ਸਹਿਤ ਕਛੁ ਭੇਦ ਨ ਪਾਯੋ ॥੧੩॥",
      "transliteration": "prajaa sahit kachh bhedh na paayo ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪ੍ਰਜਾ ਸਮੇਤ ਕਿਸੇ ਨੇ ਵਾਸਤਵਿਕਤਾ ਨੂੰ ਨਾ ਸਮਝਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "प्रजा सहित कछु भेद न पायो ॥१३॥",
      "sourceLineId": "130656",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਧਨਿ ਧਨਿ ਇਹ ਰਾਨੀ ਕੋ ਧਰਮਾ ॥",
      "transliteration": "dhan dhan ieh raanee ko dharamaa ||",
      "translation": "",
      "punjabiViakhya": "(ਸਾਰੇ ਕਹਿਣ ਲਗੇ ਕਿ) ਰਾਜ ਕੁਮਾਰੀ ਦਾ ਧਰਮ ਧੰਨ ਧੰਨ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "धनि धनि इह रानी को धरमा ॥",
      "sourceLineId": "130657",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਿਨ ਅਸਿ ਕੀਨਾ ਦੁਹਕਰਿ ਕਰਮਾ ॥",
      "transliteration": "jin as keenaa dhuhakar karamaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਇਤਨਾ ਜੁਰਤ ਵਾਲਾ ਕੰਮ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "जिन असि कीना दुहकरि करमा ॥",
      "sourceLineId": "130658",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਲਜਾ ਨਿਮਿਤ ਪ੍ਰਾਨ ਦੈ ਡਾਰਾ ॥",
      "transliteration": "lajaa nimit praan dhai ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਲਾਜ ਲਈ ਪ੍ਰਾਣ ਦੇ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "लजा निमित प्रान दै डारा ॥",
      "sourceLineId": "130659",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਰਿ ਕਰਿ ਮਰੀ ਨ ਰੌਰਨ ਪਾਰਾ ॥੧੪॥",
      "transliteration": "jar kar maree na rauaran paaraa ||14||",
      "translation": "",
      "punjabiViakhya": "ਸੜ ਕੇ ਮਰ ਗਈ, ਪਰ ਚੀਖੀ ਤਕ ਨਹੀਂ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "जरि करि मरी न रौरन पारा ॥१४॥",
      "sourceLineId": "130660",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਉਨਹਤਰਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੬੯॥੫੨੪੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau unahatar charitr samaapatam sat subham sat ||269||5243||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੬੯ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੬੯॥੫੨੪੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ उनहतरि चरित्र समापतम सतु सुभम सतु ॥२६९॥५२४३॥अफजूँ॥",
      "sourceLineId": "130661",
      "sourceShabadId": "12407",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130662",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮੋਰੰਗ ਦਿਸਿ ਇਕ ਰਹਤ ਨ੍ਰਿਪਾਲਾ ॥",
      "transliteration": "mora(n)g dhis ik rahat nirapaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੋਰੰਗ (ਨੇਪਾਲ ਦਾ ਪੂਰਬੀ ਹਿੱਸਾ) ਦਿਸ਼ਾ ਵਲ ਇਕ ਰਾਜਾ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "मोरंग दिसि इक रहत नृपाला ॥",
      "sourceLineId": "130663",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਾ ਕੇ ਦਿਪਤ ਤੇਜ ਕੀ ਜ੍ਵਾਲਾ ॥",
      "transliteration": "jaa ke dhipat tej kee javaiaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਤੇਜ ਅਗਨੀ ਵਰਗ ਪ੍ਰਕਾਸ਼ਮਾਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "जा के दिपत तेज की ज्वाला ॥",
      "sourceLineId": "130664",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪੂਰਬ ਦੇ ਤਿਹ ਨਾਰਿ ਭਣਿਜੈ ॥",
      "transliteration": "poorab dhe teh naar bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਨਾਰੀ ਦਾ ਨਾ ਪੂਰਬ ਦੇ (ਪੂਰਬ ਦੇਈ) ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1205,
      "hindi": "",
      "hindiTransliteration": "पूरब दे तिह नारि भणिजै ॥",
      "sourceLineId": "130665",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1205_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕੋ ਅਬਲਾ ਪਟਤਰ ਤਿਹ ਦਿਜੈ ॥੧॥",
      "transliteration": "ko abalaa paTatar teh dhijai ||1||",
      "translation": "",
