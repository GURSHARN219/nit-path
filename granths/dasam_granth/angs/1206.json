{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1206,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1206_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪੂਰਬ ਸੈਨ ਨ੍ਰਿਪਤਿ ਕੋ ਨਾਮਾ ॥",
      "transliteration": "poorab sain nirapat ko naamaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦਾ ਨਾ ਪੂਰਬ ਸੈਨ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "पूरब सैन नृपति को नामा ॥",
      "sourceLineId": "130667",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਿਨ ਜੀਤੇ ਅਨਗਨ ਸੰਗ੍ਰਾਮਾ ॥",
      "transliteration": "jin jeete anagan sa(n)graamaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਅਣਗਿਣਤ ਜੰਗਾ ਜਿਤੀਆਂ ਹੋਈਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "जिन जीते अनगन संग्रामा ॥",
      "sourceLineId": "130668",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਾ ਕੇ ਚੜਤ ਅਮਿਤ ਦਲ ਸੰਗਾ ॥",
      "transliteration": "jaa ke chaRat amit dhal sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਅਣਗਿਣਤ ਹਾਥੀ, ਘੋੜੇ, ਰਥ",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "जा के चड़त अमित दल संगा ॥",
      "sourceLineId": "130669",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹੈ ਗੈ ਰਥ ਪੈਦਲ ਚਤੁਰੰਗਾ ॥੨॥",
      "transliteration": "hai gai rath paidhal chatura(n)gaa ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੈਦਲ ਚਾਰ ਪ੍ਰਕਾਰ ਦੀ ਚਤੁਰੰਗਨੀ ਸੈਨਾ ਚੜ੍ਰਹਦੀ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "है गै रथ पैदल चतुरंगा ॥२॥",
      "sourceLineId": "130670",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਹ ਇਕ ਆਯੋ ਸਾਹ ਅਪਾਰਾ ॥",
      "transliteration": "teh ik aayo saeh apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਵੱਡਾ ਸ਼ਾਹ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "तह इक आयो साह अपारा ॥",
      "sourceLineId": "130671",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਾ ਕੇ ਸੰਗ ਇਕ ਪੁਤ੍ਰ ਪ੍ਯਾਰਾ ॥",
      "transliteration": "jaa ke sa(n)g ik putr payaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਇਕ ਪਿਆਰਾ ਪੁੱਤਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "जा के संग इक पुत्र प्यारा ॥",
      "sourceLineId": "130672",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਾ ਕੋ ਰੂਪ ਕਹੈ ਨਹੀ ਆਵੈ ॥",
      "transliteration": "jaa ko roop kahai nahee aavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਰੂਪ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "जा को रूप कहै नही आवै ॥",
      "sourceLineId": "130673",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਊਖ ਲਿਖਤ ਲੇਖਨ ਹ੍ਵੈ ਜਾਵੈ ॥੩॥",
      "transliteration": "uookh likhat lekhan havai jaavai ||3||",
      "translation": "",
      "punjabiViakhya": "(ਇਥੋਂ ਤਕ ਕਿ) ਲਿਖਦਿਆਂ ਲਿਖਦਿਆਂ ਗੰਨਾ ਵੀ ਕਲਮ ਜਿੰਨਾ ਰਹਿ ਜਾਦਾ ਹੈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "ऊख लिखत लेखन ह्वै जावै ॥३॥",
      "sourceLineId": "130674",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪੂਰਬ ਦੇ ਤਿਹ ਊਪਰ ਅਟਕੀ ॥",
      "transliteration": "poorab dhe teh uoopar aTakee ||",
      "translation": "",
      "punjabiViakhya": "ਪੂਰਬ ਦੇਈ (ਨੇ ਜਦ ਉਸ ਨੂੰ ਵੇਖਿਆ ਤਾ) ਉਸ ਉਪਰ ਅਟਕ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "पूरब दे तिह ऊपर अटकी ॥",
      "sourceLineId": "130675",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਭੂਲਿ ਗਈ ਸਭ ਹੀ ਸੁਧਿ ਘਟਿ ਕੀ ॥",
      "transliteration": "bhool giee sabh hee sudh ghaT kee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਸ਼ਰੀਰ ਦੀ ਸੁੱਧ ਬੁੱਧ ਭੁਲ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "भूलि गई सभ ही सुधि घटि की ॥",
      "sourceLineId": "130676",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਲਗਿਯੋ ਕੁਅਰ ਸੋ ਨੇਹ ਅਪਾਰਾ ॥",
      "transliteration": "lagiyo kuar so neh apaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਸ਼ਾਹ ਦੇ ਲੜਕੇ ਨਾਲ ਅਪਾਰ ਪ੍ਰੇਮ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "लगियो कुअर सो नेह अपारा ॥",
      "sourceLineId": "130677",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਿਹ ਬਿਨੁ ਰੁਚੈ ਨ ਭੋਜਨ ਬਾਰਾ ॥੪॥",
      "transliteration": "jeh bin ruchai na bhojan baaraa ||4||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਬਿਨਾ (ਉਸ ਨੂੰ) ਭੋਜਨ ਅਤੇ ਜਲ ਚੰਗੇ ਨਹੀਂ ਲਗਦੇ ਸਨ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "जिह बिनु रुचै न भोजन बारा ॥४॥",
      "sourceLineId": "130678",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਤਿਹ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "transliteration": "ek dhivas teh bol paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਉਸ ਨੂੰ (ਰਾਣੀ ਨੇ) ਬੁਲਾ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "एक दिवस तिह बोलि पठायो ॥",
      "sourceLineId": "130679",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਾਮ ਕੇਲ ਰੁਚਿ ਮਾਨਿ ਕਮਾਯੋ ॥",
      "transliteration": "kaam kel ruch maan kamaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਰੁਚੀ ਪੂਰਵਕ ਕਾਮਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "काम केल रुचि मानि कमायो ॥",
      "sourceLineId": "130680",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੁਹੂੰਅਨ ਐਸੇ ਬਧਾ ਸਨੇਹਾ ॥",
      "transliteration": "dhuhoo(n)an aaise badhaa sanehaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਵਿਚ ਇਤਨਾ ਸਨੇਹ ਵੱਧ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "दुहूँअन ऐसे बधा सनेहा ॥",
      "sourceLineId": "130681",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਿਨ ਕੋ ਭਾਖਿ ਨ ਆਵਤ ਨੇਹਾ ॥੫॥",
      "transliteration": "jin ko bhaakh na aavat nehaa ||5||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਉਸ ਪ੍ਰੇਮ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "जिन को भाखि न आवत नेहा ॥५॥",
      "sourceLineId": "130682",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਾਹੁ ਪੁਤ੍ਰ ਤਬ ਸਾਹੁ ਬਿਸਾਰਿਯੋ ॥",
      "transliteration": "saahu putr tab saahu bisaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਾਹ ਦੇ ਪੁੱਤਰ ਨੇ (ਆਪਣੇ ਪਿਤਾ) ਸ਼ਾਹ ਨੂੰ ਭੁਲਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "साहु पुत्र तब साहु बिसारियो ॥",
      "sourceLineId": "130683",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾ ਕੇ ਸਦਾ ਰਹਿਤ ਜਿਯ ਧਾਰਿਯੋ ॥",
      "transliteration": "taa ke sadhaa rahit jiy dhaariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਹੀ) ਉਸ ਦੇ ਹਿਰਦੇ ਵਿਚ ਸਦਾ ਛਾਈ ਰਹਿੰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "ता के सदा रहित जिय धारियो ॥",
      "sourceLineId": "130684",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪਿਤਾ ਸੰਗ ਕਛੁ ਕਲਹ ਬਢਾਯੋ ॥",
      "transliteration": "pitaa sa(n)g kachh kaleh baddaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਪਿਤਾ ਨਾਲ ਕੁਝ ਝਗੜਾ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "पिता संग कछु कलह बढायो ॥",
      "sourceLineId": "130685",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚੜਿ ਘੋਰਾ ਪਰਦੇਸ ਸਿਧਾਯੋ ॥੬॥",
      "transliteration": "chaR ghoraa paradhes sidhaayo ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘੋੜੇ ਉਤੇ ਚੜ੍ਰਹ ਕੇ ਪਰਦੇਸ ਚਲਾ ਗਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "चड़ि घोरा परदेस सिधायो ॥६॥",
      "sourceLineId": "130686",
      "sourceShabadId": "12408",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "130687",
      "sourceShabadId": "12409",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤ੍ਰਿਯ ਨਿਮਿਤ ਨਿਜੁ ਪਿਤੁ ਸੌ ਕਲਹ ਬਢਾਇ ਕੈ ॥",
      "transliteration": "tiray nimit nij pit sau kaleh baddai kai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਇਸਤਰੀ ਲਈ ਆਪਣੇ ਪਿਓ ਨਾਲ ਕਲੇਸ਼ ਵਧਾ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "तृय निमित निजु पितु सौ कलह बढाइ कै ॥",
      "sourceLineId": "130688",
      "sourceShabadId": "12409",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚੜਿ ਬਾਜੀ ਪਰ ਚਲਾ ਦੇਸ ਕਹ ਧਾਇ ਕੈ ॥",
      "transliteration": "chaR baajee par chalaa dhes keh dhai kai ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜੇ ਉਤੇ ਚੜ੍ਰਹ ਕੇ ਦੇਸ਼ ਵਲ ਚਲ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "चड़ि बाजी पर चला देस कह धाइ कै ॥",
      "sourceLineId": "130689",
      "sourceShabadId": "12409",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪਿਤੁ ਜਾਨ੍ਯੋ ਸੁਤ ਮੇਰੋ ਦੇਸ ਅਪਨੇ ਗਯੋ ॥",
      "transliteration": "pit jaanayo sut mero dhes apane gayo ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਤਾ ਨੇ ਸਮਝਿਆ ਕਿ ਮੇਰਾ ਪੁੱਤਰ ਆਪਣੇ ਦੇਸ ਨੂੰ ਗਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "पितु जान्यो सुत मेरो देस अपने गयो ॥",
      "sourceLineId": "130690",
      "sourceShabadId": "12409",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹੌ ਅਰਧ ਰਾਤ੍ਰਿ ਗੇ ਗ੍ਰਿਹ ਰਾਨੀ ਆਵਤ ਭਯੋ ॥੭॥",
      "transliteration": "hau aradh raatr ge gireh raanee aavat bhayo ||7||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਹ ਅੱਧੀ ਰਾਤ ਦੇ ਬੀਤਣ ਤੇ ਰਾਣੀ ਦੇ ਘਰ ਆ ਗਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "हौ अरध रातृ गे गृह रानी आवत भयो ॥७॥",
      "sourceLineId": "130691",
      "sourceShabadId": "12409",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130692",
      "sourceShabadId": "12410",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਹ ਤੇ ਸਾਹੁ ਜਬੈ ਉਠਿ ਗਯੋ ॥",
      "transliteration": "teh te saahu jabai uTh gayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਉਥੋਂ ਸ਼ਾਹ ਚਲਾ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "तह ते साहु जबै उठि गयो ॥",
      "sourceLineId": "130693",
      "sourceShabadId": "12410",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਅਸ ਚਰਿਤ ਬਨਯੋ ॥",
      "transliteration": "tab raanee as charit banayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਨੇ ਇਹ ਚਰਿਤ੍ਰ ਬਣਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "तब रानी अस चरित बनयो ॥",
      "sourceLineId": "130694",
      "sourceShabadId": "12410",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਾਹਿ ਨਿਪੁੰਸਕ ਕਰਿ ਠਹਰਾਯੋ ॥",
      "transliteration": "taeh nipu(n)sak kar Thaharaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਸ਼ਾਹ ਦੇ ਪੁੱਤਰ ਨੂੰ) ਨਪੁੰਸਕ ਦਸ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "ताहि निपुँसक करि ठहरायो ॥",
      "sourceLineId": "130695",
      "sourceShabadId": "12410",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰਾਜਾ ਸੌ ਇਸ ਭਾਤਿ ਜਤਾਯੋ ॥੮॥",
      "transliteration": "raajaa sau is bhaat jataayo ||8||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "राजा सौ इस भाति जतायो ॥८॥",
      "sourceLineId": "130696",
      "sourceShabadId": "12410",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮੈ ਇਕ ਮੋਲ ਨਿਪੁੰਸਕ ਆਨਾ ॥",
      "transliteration": "mai ik mol nipu(n)sak aanaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਇਕ ਨਪੁੰਸਕ ਮੁੱਲ ਲਿਆਂਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "मै इक मोल निपुँसक आना ॥",
      "sourceLineId": "130697",
      "sourceShabadId": "12410",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਾ ਕੋ ਰੂਪ ਨ ਜਾਤ ਬਖਾਨਾ ॥",
      "transliteration": "jaa ko roop na jaat bakhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਰੂਪ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "जा को रूप न जात बखाना ॥",
      "sourceLineId": "130698",
      "sourceShabadId": "12410",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਾ ਤੇ ਅਪਨੇ ਕਾਜ ਕਰੈ ਹੌ ॥",
      "transliteration": "taa te apane kaaj karai hau ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਆਪਣੇ ਕੰਮ ਕਰਵਾਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "ता ते अपने काज करै हौ ॥",
      "sourceLineId": "130699",
      "sourceShabadId": "12410",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮਨ ਭਾਵਤ ਕੇ ਭੋਗ ਕਮੈ ਹੌ ॥੯॥",
      "transliteration": "man bhaavat ke bhog kamai hau ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਨਚਾਹੇ ਭੋਗ ਵਿਲਾਸ ਕਰਾਗੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "मन भावत के भोग कमै हौ ॥९॥",
      "sourceLineId": "130700",
      "sourceShabadId": "12410",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "130701",
      "sourceShabadId": "12411",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਲੀ ਭਲੀ ਰਾਜਾ ਕਹੀ ਭੇਦ ਨ ਸਕਾ ਬਿਚਾਰ ॥",
      "transliteration": "bhalee bhalee raajaa kahee bhedh na sakaa bichaar ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ 'ਠੀਕ ਹੈ ਠੀਕ ਹੈ' ਕਿਹਾ, ਪਰ ਭੇਦ ਦੀ ਗੱਲ ਵਿਚਾਰ ਨਾ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "भली भली राजा कही भेद न सका बिचार ॥",
      "sourceLineId": "130702",
      "sourceShabadId": "12411",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪੁਰਖ ਨਿਪੁੰਸਕ ਭਾਖਿ ਤ੍ਰਿਯ ਰਾਖਾ ਧਾਮ ਸੁਧਾਰਿ ॥੧੦॥",
      "transliteration": "purakh nipu(n)sak bhaakh tiray raakhaa dhaam sudhaar ||10||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਉਸ ਪੁਰਸ਼ ਨੂੰ ਨਪੁੰਸਕ ਕਹਿ ਕੇ ਘਰ ਵਿਚ ਰਖ ਲਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "पुरख निपुँसक भाखि तृय राखा धाम सुधारि ॥१०॥",
      "sourceLineId": "130703",
      "sourceShabadId": "12411",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਮ੍ਯੋ ਕਰਤ ਰਾਨੀ ਭਏ ਤਵਨ ਪੁਰਖ ਦਿਨ ਰੈਨਿ ॥",
      "transliteration": "ramayo karat raanee bhe tavan purakh dhin rain ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਉਸ ਮਰਦ ਨਾਲ ਦਿਨ ਰਾਤ ਰਮਣ ਕਰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "रम्यो करत रानी भए तवन पुरख दिन रैनि ॥",
      "sourceLineId": "130704",
      "sourceShabadId": "12411",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨ੍ਰਿਪਤਿ ਨਿਪੁੰਸਕ ਤਿਹ ਲਖੈ ਕਛੂ ਨ ਭਾਖੈ ਬੈਨ ॥੧੧॥",
      "transliteration": "nirapat nipu(n)sak teh lakhai kachhoo na bhaakhai bain ||11||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਉਸ ਨੂੰ ਨਪੁੰਸਕ ਸਮਝ ਕੇ ਮੂੰਹੋਂ ਕੁਝ ਨਹੀਂ ਕਹਿੰਦਾ ਸੀ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "नृपति निपुँसक तिह लखै कछू न भाखै बैन ॥११॥",
      "sourceLineId": "130705",
      "sourceShabadId": "12411",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਸਤਰ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੭੦॥੫੨੫੪॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau satar charitr samaapatam sat subham sat ||270||5254||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੭੦ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੭੦॥੫੨੫੪॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ सतर चरित्र समापतम सतु सुभम सतु ॥२७०॥५२५४॥अफजूँ॥",
      "sourceLineId": "130706",
      "sourceShabadId": "12411",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130707",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤੇਲੰਗਾ ਜਹ ਦੇਸ ਅਪਾਰਾ ॥",
      "transliteration": "tela(n)gaa jeh dhes apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਲੰਗਾ ਨਾ ਦਾ ਜੋ ਵੱਡਾ ਦੇਸ਼ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "तेलंगा जह देस अपारा ॥",
      "sourceLineId": "130708",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਮਰ ਸੈਨ ਤਹ ਕੋ ਸਰਦਾਰਾ ॥",
      "transliteration": "samar sain teh ko saradhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਸਰਦਾਰ (ਰਾਜੇ ਦਾ ਨਾ) ਸਮਰ ਸੈਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "समर सैन तह को सरदारा ॥",
      "sourceLineId": "130709",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਾਹਿ ਬਿਲਾਸ ਦੇਇ ਘਰ ਰਾਨੀ ॥",
      "transliteration": "taeh bilaas dhei ghar raanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਲਿਬਾਸ ਦੇਈ ਨਾ ਦੀ ਰਾਣੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "ताहि बिलास देइ घर रानी ॥",
      "sourceLineId": "130710",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਾ ਕੀ ਜਾਤ ਨ ਪ੍ਰਭਾ ਬਖਾਨੀ ॥੧॥",
      "transliteration": "jaa kee jaat na prabhaa bakhaanee ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਪ੍ਰਭਾ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "जा की जात न प्रभा बखानी ॥१॥",
      "sourceLineId": "130711",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਿਹ ਇਕ ਛੈਲ ਪੁਰੀ ਸੰਨ੍ਯਾਸੀ ॥",
      "transliteration": "teh ik chhail puree sa(n)nayaasee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਛੈਲ ਪੁਰੀ ਨਾ ਦਾ ਸੰਨਿਆਸੀ ਸੀ (ਅਰਥਾਤਰ-ਪੁਰੀ ਸੰਪ੍ਰਦਾਇ ਦਾ ਇਕ ਨੌਜਵਾਨ ਸੰਨਿਆਸੀ ਸੀ)।",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "तिह इक छैल पुरी संन्यासी ॥",
      "sourceLineId": "130712",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਿਹ ਪੁਰ ਮਦ੍ਰ ਦੇਸ ਕੌ ਬਾਸੀ ॥",
      "transliteration": "teh pur madhr dhes kau baasee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮਦ੍ਰ ਦੇਸ ਦੇ (ਕਿਸੇ) ਨਗਰ ਦਾ ਨਿਵਾਸੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "तिह पुर मद्र देस कौ बासी ॥",
      "sourceLineId": "130713",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1206_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਾਨੀ ਨਿਰਖਿ ਲਗਨਿ ਤਿਹ ਲਾਗੀ ॥",
      "transliteration": "raanee nirakh lagan teh laagee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਵੇਖ ਕੇ ਰਾਣੀ ਦਾ ਉਸ ਨਾਲ ਪ੍ਰੇਮ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1206,
      "hindi": "",
      "hindiTransliteration": "रानी निरखि लगनि तिह लागी ॥",
      "sourceLineId": "130714",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
