{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1207,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1207_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਾ ਤੇ ਨੀਂਦ ਭੂਖ ਸਭ ਭਾਗੀ ॥੨॥",
      "transliteration": "jaa te nee(n)dh bhookh sabh bhaagee ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਉਸ ਦੀ ਨੀਂਦਰ ਅਤੇ ਭੁਖ ਚਲੀ ਗਈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "जा ते नींद भूख सभ भागी ॥२॥",
      "sourceLineId": "130715",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਾਨੀ ਕੀ ਤਾਹੂ ਸੌ ਲਾਗੀ ॥",
      "transliteration": "raanee kee taahoo sau laagee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਦੀ ਉਸ ਨਾਲ (ਪ੍ਰੀਤ) ਲਗ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "रानी की ताहू सौ लागी ॥",
      "sourceLineId": "130716",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਛੂਟੈ ਕਹਾ ਅਨੋਖੀ ਜਾਗੀ ॥",
      "transliteration": "chhooTai kahaa anokhee jaagee ||",
      "translation": "",
      "punjabiViakhya": "ਜਾਗੀ ਹੋਈ ਉਹ ਅਨੋਖੀ (ਪ੍ਰੀਤ ਭਲਾ) ਕਿਵੇਾਂ ਛੁਟੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "छूटै कहा अनोखी जागी ॥",
      "sourceLineId": "130717",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਕ ਦਿਨ ਤਿਹ ਸੌ ਭੋਗ ਕਮਾਯੋ ॥",
      "transliteration": "eik dhin teh sau bhog kamaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਰਾਣੀ ਨੇ ਉਸ ਨਾਲ ਭੋਗ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "इक दिन तिह सौ भोग कमायो ॥",
      "sourceLineId": "130718",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭੋਗ ਕਿਯਾ ਤਿਮ ਦ੍ਰਿੜ ਤ੍ਰਿਯ ਭਾਯੋ ॥੩॥",
      "transliteration": "bhog kiyaa tim dhiraR tiray bhaayo ||3||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਦ੍ਰਿੜ੍ਰਹਤਾ ਨਾਲ ਭੋਗ ਕੀਤਾ, (ਜਿਸ ਕਰ ਕੇ) ਰਾਣੀ ਨੂੰ ਚੰਗਾ ਲਗਣ ਲਗਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "भोग किया तिम दृड़ तृय भायो ॥३॥",
      "sourceLineId": "130719",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਹੁ ਦਿਨ ਭੋਗ ਤਵਨ ਸੰਗਿ ਕਿਯਾ ॥",
      "transliteration": "bahu dhin bhog tavan sa(n)g kiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ (ਰਾਣੀ ਨੇ) ਬਹੁਤ ਦਿਨਾ ਤਕ ਭੋਗ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "बहु दिन भोग तवन संगि किया ॥",
      "sourceLineId": "130720",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਐਸੁਪਦੇਸ ਤਵਨ ਕਹ ਦਿਯਾ ॥",
      "transliteration": "aaisupadhes tavan keh dhiyaa ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਸ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਸਮਝਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "ऐसुपदेस तवन कह दिया ॥",
      "sourceLineId": "130721",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੌ ਮੈ ਕਹੌ ਮਿਤ੍ਰ ਸੋ ਕੀਜਹੁ ॥",
      "transliteration": "jau mai kahau mitr so keejahu ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮਿਤਰ! ਜੋ ਮੈਂ ਕਹਾ, ਉਸੇ ਤਰ੍ਰਹਾ ਕਰੋ",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "जौ मै कहौ मित्र सो कीजहु ॥",
      "sourceLineId": "130722",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮੇਰੋ ਕਹਿਯੋ ਮਾਨਿ ਕਰਿ ਲੀਜਹੁ ॥੪॥",
      "transliteration": "mero kahiyo maan kar leejahu ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰਾ ਕਿਹਾ ਮੰਨ ਲਵੋ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "मेरो कहियो मानि करि लीजहु ॥४॥",
      "sourceLineId": "130723",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਹੂੰ ਜੁ ਮ੍ਰਿਤਕ ਪਰਿਯੋ ਲਖਿ ਪੈਯੌ ॥",
      "transliteration": "kahoo(n) ju mritak pariyo lakh paiyau ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਕਿਤੇ ਤੁਹਾਨੂੰ ਮੁਰਦਾ ਨਜ਼ਰ ਆਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "कहूँ जु मृतक परियो लखि पैयौ ॥",
      "sourceLineId": "130724",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਾ ਕੋ ਕਾਟਿ ਲਿੰਗ ਲੈ ਐਯੌ ॥",
      "transliteration": "taa ko kaaT li(n)g lai aaiyau ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ) ਉਸ ਦਾ ਲਿੰਗ ਕਟ ਲਿਆਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "ता को काटि लिंग लै ऐयौ ॥",
      "sourceLineId": "130725",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਾਹਿ ਕੁਪੀਨ ਬਿਖੈ ਦ੍ਰਿੜ ਰਖਿਯਹੁ ॥",
      "transliteration": "taeh kupeen bikhai dhiraR rakhiyahu ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਆਪਣੀ ਲੰਗੋਟੀ ਵਿਚ ਚੰਗੀ ਤਰ੍ਰਹਾ ਰਖ ਲੈਣਾ",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "ताहि कुपीन बिखै दृड़ रखियहु ॥",
      "sourceLineId": "130726",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭੇਦ ਦੂਸਰੇ ਨਰਹਿ ਨ ਭਖਿਯਹੁ ॥੫॥",
      "transliteration": "bhedh dhoosare nareh na bhakhiyahu ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਹ ਭੇਦ ਕਿਸੇ ਹੋਰ ਪੁਰਸ਼ ਨੂੰ ਨਾ ਦੇਣਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "भेद दूसरे नरहि न भखियहु ॥५॥",
      "sourceLineId": "130727",
      "sourceShabadId": "12412",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "130728",
      "sourceShabadId": "12413",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਬ ਮੈ ਦੇਹੋ ਤੁਮੈ ਉਰਾਭੇ ਲਾਇ ਕੈ ॥",
      "transliteration": "jab mai dheho tumai uraabhe lai kai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਮੈਂ ਤੁਹਾਡੇ ਉਤੇ ਦੂਸ਼ਣ ਲਗਾਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "जब मै देहो तुमै उराभे लाइ कै ॥",
      "sourceLineId": "130729",
      "sourceShabadId": "12413",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਬ ਤੁਮ ਹਮ ਪਰ ਉਠਿਯਹੁ ਅਧਿਕ ਰਿਸਾਇ ਕੈ ॥",
      "transliteration": "tab tum ham par uThiyahu adhik risai kai ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਸੇ ਪ੍ਰਕਾਰ ਦੇ ਵਿਭਚਾਰ ਦਾ) ਤਾ ਤੁਸੀਂ ਮੇਰੇ ਉਤੇ ਬਹੁਤ ਕ੍ਰੋਧਿਤ ਹੋਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "तब तुम हम पर उठियहु अधिक रिसाइ कै ॥",
      "sourceLineId": "130730",
      "sourceShabadId": "12413",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਾਢਿ ਕੁਪੀਨ ਤੇ ਹਮ ਪਰ ਲਿੰਗ ਚਲਾਇਯੋ ॥",
      "transliteration": "kaadd kupeen te ham par li(n)g chalaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਲੰਗੋਟੀ ਤੋਂ ਲਿੰਗ ਕਢ ਕੇ ਮੇਰੇ ਉਤੇ ਸੁਟਣਾ",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "काढि कुपीन ते हम पर लिंग चलाइयो ॥",
      "sourceLineId": "130731",
      "sourceShabadId": "12413",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਹੋ ਊਚ ਨੀਚ ਰਾਜਾ ਕਹ ਚਰਿਤ ਦਿਖਾਇਯੋ ॥੬॥",
      "transliteration": "ho uooch neech raajaa keh charit dhikhaiyo ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਤੋਂ ਲੈ ਕੇ ਸਾਰਿਆਂ ਉਚਿਆਂ ਨੀਵਿਆਂ ਨੂੰ ਇਹ ਚਰਿਤ੍ਰ ਵਿਖਾਣਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "हो ऊच नीच राजा कह चरित दिखाइयो ॥६॥",
      "sourceLineId": "130732",
      "sourceShabadId": "12413",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130733",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੋਈ ਕਾਮ ਮਿਤ੍ਰ ਤਿਹ ਕੀਨਾ ॥",
      "transliteration": "soiee kaam mitr teh keenaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਮਿਤਰ ਨੇ ਉਹੀ ਕੰਮ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "सोई काम मित्र तिह कीना ॥",
      "sourceLineId": "130734",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਿਹ ਬਿਧਿ ਸੌ ਤਵਨੈ ਸਿਖ ਦੀਨਾ ॥",
      "transliteration": "jeh bidh sau tavanai sikh dheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਨਾਲ ਉਸ ਨੂੰ ਸਿਖਾਇਆ ਗਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "जिह बिधि सौ तवनै सिख दीना ॥",
      "sourceLineId": "130735",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰਾਨੀ ਪ੍ਰਾਤ ਪਤਿਹਿ ਦਿਖਰਾਈ ॥",
      "transliteration": "raanee praat pateh dhikharaiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਸਵੇਰੇ (ਸੰਨਿਆਸੀ ਨੂੰ ਆਪਣਾ) ਪਤੀ ਵਿਖਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "रानी प्रात पतिहि दिखराई ॥",
      "sourceLineId": "130736",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੰਨ੍ਯਾਸੀ ਪਹਿ ਸਖੀ ਪਠਾਈ ॥੭॥",
      "transliteration": "sa(n)nayaasee peh sakhee paThaiee ||7||",
      "translation": "",
      "punjabiViakhya": "(ਨਾਲ ਹੀ) ਸਖੀ ਨੂੰ ਸੰਨਿਆਸੀ ਪਾਸ ਭੇਜ ਦਿੱਤਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "संन्यासी पहि सखी पठाई ॥७॥",
      "sourceLineId": "130737",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੰਨ੍ਯਾਸੀ ਜੁਤ ਸਖੀ ਗਹਾਈ ॥",
      "transliteration": "sa(n)nayaasee jut sakhee gahaiee ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਨਿਆਸੀ ਸਹਿਤ ਸਖੀ ਨੂੰ ਫੜ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "संन्यासी जुत सखी गहाई ॥",
      "sourceLineId": "130738",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਰਾਜਾ ਦੇਖਤ ਨਿਕਟ ਬੁਲਾਈ ॥",
      "transliteration": "raajaa dhekhat nikaT bulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੂੰ ਵੇਖ ਕੇ ਕੋਲ ਬੁਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "राजा देखत निकट बुलाई ॥",
      "sourceLineId": "130739",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਛੈਲ ਗਿਰਹਿ ਬਹੁਤ ਭਾਤਿ ਦੁਖਾਯੋ ॥",
      "transliteration": "chhail gireh bahut bhaat dhukhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਛੈਲ ਗਿਰੀ ਨੂੰ (ਉਸ ਨੇ ਬੋਲ ਕੁਬੋਲ) ਕਰ ਕੇ ਬਹੁਤ ਦੁਖਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "छैल गिरहि बहुत भाति दुखायो ॥",
      "sourceLineId": "130740",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੈ ਚੇਰੀ ਸੰਗ ਭੋਗ ਕਮਾਯੋ ॥੮॥",
      "transliteration": "tai cheree sa(n)g bhog kamaayo ||8||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੂੰ ਦਾਸੀ ਨਾਲ ਭੋਗ ਕੀਤਾ ਹੈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "तै चेरी संग भोग कमायो ॥८॥",
      "sourceLineId": "130741",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਯੌ ਸੁਨਿ ਬਚਨ ਤੇਜ ਮਨ ਤਯੋ ॥",
      "transliteration": "yau sun bachan tej man tayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਗੱਲ ਸੁਣ ਕੇ (ਸੰਨਿਆਸੀ) ਦੇ ਮਨ ਵਿਚ ਬਹੁਤ ਕ੍ਰੋਧ ਵੱਧ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "यौ सुनि बचन तेज मन तयो ॥",
      "sourceLineId": "130742",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਰ ਮਹਿ ਕਾਢਿ ਛੁਰਾ ਕਹ ਲਯੋ ॥",
      "transliteration": "kar meh kaadd chhuraa keh layo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਨੇ) ਹੱਥ ਵਿਚ ਛੁਰਾ ਕਢ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "कर महि काढि छुरा कह लयो ॥",
      "sourceLineId": "130743",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਟਿਯੋ ਲਿੰਗ ਬਸਤ੍ਰ ਤੇ ਨਿਕਾਰਾ ॥",
      "transliteration": "kaTiyo li(n)g basatr te nikaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਕਟਿਆ ਹੋਇਆ ਲਿੰਗ ਲੰਗੋਟੀ ਵਿਚੋਂ ਕਢਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "कटियो लिंग बसत्र ते निकारा ॥",
      "sourceLineId": "130744",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਜ ਤਰੁਨਿ ਕੇ ਮੁਖ ਪਰ ਮਾਰਾ ॥੯॥",
      "transliteration": "raaj tarun ke mukh par maaraa ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਦੇ ਮੂੰਹ ਉਤੇ ਮਾਰਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "राज तरुनि के मुख पर मारा ॥९॥",
      "sourceLineId": "130745",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਹਾਇ ਹਾਇ ਰਾਨੀ ਕਹਿ ਭਾਗੀ ॥",
      "transliteration": "hai hai raanee keh bhaagee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ 'ਹਾਇ ਹਾਇ' ਕਰਦੀ ਭਜੀ",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "हाइ हाइ रानी कहि भागी ॥",
      "sourceLineId": "130746",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਾ ਕੇ ਉਠਿ ਚਰਨਨ ਸੰਗ ਲਾਗੀ ॥",
      "transliteration": "taa ke uTh charanan sa(n)g laagee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਠ ਕੇ ਉਸ (ਸੰਨਿਆਸੀ) ਦੇ ਚਰਨਾ ਨਾਲ ਲਗ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "ता के उठि चरनन संग लागी ॥",
      "sourceLineId": "130747",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਹਮਿ ਰਿਖਿ ਤੁਮਰੋ ਚਰਿਤ ਨ ਜਾਨਾ ॥",
      "transliteration": "ham rikh tumaro charit na jaanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗੀ) ਹੇ ਰਿਖੀ! ਮੈਂ ਤੁਹਾਡੇ ਚਰਿਤ੍ਰ (ਆਚਰਣ) ਨੂੰ ਨਹੀਂ ਸਮਝਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "हमि रिखि तुमरो चरित न जाना ॥",
      "sourceLineId": "130748",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਿਨੁ ਸਮੁਝੇ ਤੁਹਿ ਝੂਠ ਬਖਾਨਾ ॥੧੦॥",
      "transliteration": "bin samujhe tuh jhooTh bakhaanaa ||10||",
      "translation": "",
      "punjabiViakhya": "ਬਿਨਾ ਸਮਝੇ ਤੁਹਾਨੂੰ ਝੂਠਾ ਠਹਿਰਾਇਆ ਸੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "बिनु समुझे तुहि झूठ बखाना ॥१०॥",
      "sourceLineId": "130749",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਬ ਰਾਜੇ ਇਹ ਭਾਤਿ ਬਿਚਾਰੀ ॥",
      "transliteration": "tab raaje ieh bhaat bichaaree ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜੇ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਵਿਚਾਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "तब राजे इह भाति बिचारी ॥",
      "sourceLineId": "130750",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਇੰਦ੍ਰੀ ਕਾਟਿ ਸੰਨ੍ਯਾਸੀ ਡਾਰੀ ॥",
      "transliteration": "ei(n)dhree kaaT sa(n)nayaasee ddaaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਸੰਨਿਆਸੀ ਨੇ ਇੰਦਰੀ ਕਟ ਕੇ ਸੁਟ ਦਿੱਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "इंद्री काटि संन्यासी डारी ॥",
      "sourceLineId": "130751",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਧ੍ਰਿਗ ਧ੍ਰਿਗ ਕੁਪਿ ਰਾਨਿਯਹਿ ਉਚਾਰਾ ॥",
      "transliteration": "dhirag dhirag kup raaniyeh uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਰਾਣੀ ਨੂੰ 'ਧ੍ਰਿਗ ਧ੍ਰਿਗ' ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "धृग धृग कुपि रानियहि उचारा ॥",
      "sourceLineId": "130752",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤੈ ਤ੍ਰਿਯ ਕਿਯਾ ਦੋਖ ਯਹ ਭਾਰਾ ॥੧੧॥",
      "transliteration": "tai tiray kiyaa dhokh yeh bhaaraa ||11||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਣੀ! ਤੂੰ ਇਹ ਵੱਡਾ ਅਨਰਥ ਕੀਤਾ ਹੈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "तै तृय किया दोख यह भारा ॥११॥",
      "sourceLineId": "130753",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਬ ਇਹ ਰਾਖੁ ਆਪਨੇ ਧਾਮਾ ॥",
      "transliteration": "ab ieh raakh aapane dhaamaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਇਸ ਨੂੰ ਆਪਣੇ ਘਰ ਰਖ",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "अब इह राखु आपने धामा ॥",
      "sourceLineId": "130754",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੇਵਾ ਕਰਹੁ ਸਕਲ ਮਿਲਿ ਬਾਮਾ ॥",
      "transliteration": "sevaa karahu sakal mil baamaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੀਆਂ ਇਸਤਰੀਆਂ ਮਿਲ ਕੇ ਇਸ ਦੀ ਸੇਵਾ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "सेवा करहु सकल मिलि बामा ॥",
      "sourceLineId": "130755",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਬ ਲਗਿ ਜਿਯੈ ਜਾਨ ਨਹਿ ਦੀਜੈ ॥",
      "transliteration": "jab lag jiyai jaan neh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਤਕ ਇਹ ਜੀਉਾਂਦਾ ਰਹੇ, (ਇਸ ਨੂੰ) ਜਾਣ ਨਾ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "जब लगि जियै जान नहि दीजै ॥",
      "sourceLineId": "130756",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਦਾ ਜਤੀ ਕੀ ਪੂਜਾ ਕੀਜੈ ॥੧੨॥",
      "transliteration": "sadhaa jatee kee poojaa keejai ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਦਾ (ਇਸ) ਜਤੀ ਦੀ ਪੂਜਾ ਕਰੋ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "सदा जती की पूजा कीजै ॥१२॥",
      "sourceLineId": "130757",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰਾਨੀ ਬਚਨ ਨ੍ਰਿਪਤਿ ਕੋ ਮਾਨਾ ॥",
      "transliteration": "raanee bachan nirapat ko maanaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਰਾਜੇ ਦਾ ਬਚਨ ਮੰਨ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "रानी बचन नृपति को माना ॥",
      "sourceLineId": "130758",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਸਾਥ ਤਾਹਿ ਗ੍ਰਿਹ ਆਨਾ ॥",
      "transliteration": "bahu bidh saath taeh gireh aanaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ (ਆਦਰ ਸਤਿਕਾਰ ਕਰ ਕੇ ਉਸ ਨੂੰ) ਘਰ ਲੈ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि साथ ताहि गृह आना ॥",
      "sourceLineId": "130759",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭੋਗ ਕਰੈ ਬਹੁ ਹਰਖ ਬਢਾਈ ॥",
      "transliteration": "bhog karai bahu harakh baddaiee ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਖ਼ੁਸ਼ ਹੋ ਕੇ ਉਸ ਨਾਲ ਭੋਗ ਕਰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "भोग करै बहु हरख बढाई ॥",
      "sourceLineId": "130760",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮੂਰਖ ਬਾਤ ਨ ਰਾਜੈ ਪਾਈ ॥੧੩॥",
      "transliteration": "moorakh baat na raajai paiee ||13||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਮੂਰਖ ਰਾਜਾ ਗੱਲ ਨੂੰ ਸਮਝ ਨਾ ਸਕਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "मूरख बात न राजै पाई ॥१३॥",
      "sourceLineId": "130761",
      "sourceShabadId": "12414",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "130762",
      "sourceShabadId": "12415",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਚਰਿਤ ਬਨਾਇ ਕੈ ਤਾਹਿ ਭਜਾ ਰੁਚਿ ਮਾਨ ॥",
      "transliteration": "eeh bidh charit banai kai taeh bhajaa ruch maan ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ) ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਚਰਿਤ੍ਰ ਬਣਾ ਕੇ ਉਸ ਨਾਲ ਰੁਚੀ ਪੂਰਵਕ ਸੰਯੋਗ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "इह बिधि चरित बनाइ कै ताहि भजा रुचि मान ॥",
      "sourceLineId": "130763",
      "sourceShabadId": "12415",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜੀਵਤ ਲਗਿ ਰਾਖਾ ਸਦਨ ਸਕਾ ਨ ਨ੍ਰਿਪਤਿ ਪਛਾਨ ॥੧੪॥",
      "transliteration": "jeevat lag raakhaa sadhan sakaa na nirapat pachhaan ||14||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜੀਉਾਂਦੇ ਜੀ ਮਹੱਲ ਵਿਚ ਰਖਿਆ, ਪਰ ਰਾਜਾ (ਇਸ ਭੇਦ ਨੂੰ) ਨਹੀਂ ਸਮਝ ਸਕਿਆ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "जीवत लगि राखा सदन सका न नृपति पछान ॥१४॥",
      "sourceLineId": "130764",
      "sourceShabadId": "12415",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਇਕਹਤਰਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੭੧॥੫੨੬੭॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau ikahatar charitr samaapatam sat subham sat ||271||5267||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੭੧ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੭੧॥੫੨੬੭॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ इकहतरि चरित्र समापतम सतु सुभम सतु ॥२७१॥५२६७॥अफजूँ॥",
      "sourceLineId": "130765",
      "sourceShabadId": "12415",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130766",
      "sourceShabadId": "12416",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਏਕ ਸੁਗੰਧ ਸੈਨ ਨ੍ਰਿਪ ਨਾਮਾ ॥",
      "transliteration": "ek suga(n)dh sain nirap naamaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਸੁਗੰਧ ਸੈਨ ਨਾ ਦਾ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "एक सुगंध सैन नृप नामा ॥",
      "sourceLineId": "130767",
      "sourceShabadId": "12416",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਗੰਧਾਗਿਰ ਪਰਬਤ ਜਿਹ ਧਾਮਾ ॥",
      "transliteration": "ga(n)dhaagir parabat jeh dhaamaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਘਰ ਗੰਧਾਗਿਰ ਪਰਬਤ ਵਿਚ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "गंधागिर परबत जिह धामा ॥",
      "sourceLineId": "130768",
      "sourceShabadId": "12416",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸੁਗੰਧ ਮਤੀ ਤਾ ਕੀ ਚੰਚਲਾ ॥",
      "transliteration": "suga(n)dh matee taa kee cha(n)chalaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਇਸਤਰੀ ਦਾ ਨਾ ਸੁੰਗਧ ਮਤੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "सुगंध मती ता की चंचला ॥",
      "sourceLineId": "130769",
      "sourceShabadId": "12416",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਹੀਨ ਕਰੀ ਸਸਿ ਕੀ ਜਿਨ ਕਲਾ ॥੧॥",
      "transliteration": "heen karee sas kee jin kalaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਚੰਦ੍ਰਮਾ ਦੀ ਕਲਾ ਨੂੰ ਵੀ ਹੀਣਾ ਕੀਤਾ ਹੋਇਆ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "हीन करी ससि की जिन कला ॥१॥",
      "sourceLineId": "130770",
      "sourceShabadId": "12416",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਬੀਰ ਕਰਨ ਇਕ ਸਾਹੁ ਬਿਖ੍ਯਾਤਾ ॥",
      "transliteration": "beer karan ik saahu bikhayaataa ||",
      "translation": "",
      "punjabiViakhya": "ਬੀਰ ਕਰਨ ਨਾ ਦਾ ਇਕ ਪ੍ਰਸਿੱਧ ਸ਼ਾਹ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "बीर करन इक साहु बिख्याता ॥",
      "sourceLineId": "130771",
      "sourceShabadId": "12416",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਜਿਹ ਸਮ ਦੁਤਿਯ ਨ ਰਚਾ ਬਿਧਾਤਾ ॥",
      "transliteration": "jeh sam dhutiy na rachaa bidhaataa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਵਿਧਾਤਾ ਨੇ ਕੋਈ ਹੋਰ ਨਹੀਂ ਰਚਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "जिह सम दुतिय न रचा बिधाता ॥",
      "sourceLineId": "130772",
      "sourceShabadId": "12416",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਧਨ ਕਰਿ ਸਕਲ ਭਰੇ ਜਿਹ ਧਾਮਾ ॥",
      "transliteration": "dhan kar sakal bhare jeh dhaamaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਸਾਰੇ ਘਰ ਧਨ ਨਾਲ ਭਰੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "धन करि सकल भरे जिह धामा ॥",
      "sourceLineId": "130773",
      "sourceShabadId": "12416",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਰੀਝਿ ਰਹਤ ਦੁਤਿ ਲਖਿ ਸਭ ਬਾਮਾ ॥੨॥",
      "transliteration": "reejh rahat dhut lakh sabh baamaa ||2||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਸੁੰਦਰਤਾ ਨੂੰ ਵੇਖ ਕੇ ਸਾਰੀਆਂ ਇਸਤਰੀਆਂ ਮੋਹਿਤ ਹੋ ਜਾਦੀਆਂ ਸਨ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "रीझि रहत दुति लखि सभ बामा ॥२॥",
      "sourceLineId": "130774",
      "sourceShabadId": "12416",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਸੌਦਾ ਨਮਿਤਿ ਤਹਾ ਵਹ ਆਯੋ ॥",
      "transliteration": "sauadhaa namit tahaa veh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸੌਦਾਗਰੀ ਲਈ ਉਥੇ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "सौदा नमिति तहा वह आयो ॥",
      "sourceLineId": "130775",
      "sourceShabadId": "12416",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਜਾ ਕਹ ਨਿਰਖਿ ਰੂਪ ਸਿਰ ਨ੍ਯਾਯੋ ॥",
      "transliteration": "jaa keh nirakh roop sir nayaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਰੂਪ ਨੂੰ ਵੇਖ ਕੇ (ਰਾਣੀ ਨੇ) ਸਿਰ ਨਿਵਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "जा कह निरखि रूप सिर न्यायो ॥",
      "sourceLineId": "130776",
      "sourceShabadId": "12416",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਜਾ ਸਮ ਸੁੰਦਰ ਸੁਨਾ ਨ ਸੂਰਾ ॥",
      "transliteration": "jaa sam su(n)dhar sunaa na sooraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗਾ ਸੁੰਦਰ ਅਤੇ ਸੂਰਮਾ (ਅਗੇ) ਨਹੀਂ ਸੁਣਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "जा सम सुँदर सुना न सूरा ॥",
      "sourceLineId": "130777",
      "sourceShabadId": "12416",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਦੇਗ ਤੇਗ ਸਾਚੋ ਭਰਪੂਰਾ ॥੩॥",
      "transliteration": "dheg teg saacho bharapooraa ||3||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸਚਮੁਚ ਦੇਗ ਅਤੇ ਤੇਗ (ਦੇ ਗੁਣਾ ਨਾਲ) ਭਰਪੂਰ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "देग तेग साचो भरपूरा ॥३॥",
      "sourceLineId": "130778",
      "sourceShabadId": "12416",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "130779",
      "sourceShabadId": "12417",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਰਾਨੀ ਤਾ ਕੋ ਰੂਪ ਲਖਿ ਮਨ ਮਹਿ ਰਹੀ ਲੁਭਾਇ ॥",
      "transliteration": "raanee taa ko roop lakh man meh rahee lubhai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਉਸ ਦਾ ਰੂਪ ਵੇਖ ਕੇ ਮਨ ਵਿਚ ਮੋਹਿਤ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "रानी ता को रूप लखि मन महि रही लुभाइ ॥",
      "sourceLineId": "130780",
      "sourceShabadId": "12417",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਮਿਲਿਬੇ ਕੇ ਜਤਨਨ ਕਰੈ ਮਿਲ੍ਯੋ ਨ ਤਾ ਸੋ ਜਾਇ ॥੪॥",
      "transliteration": "milibe ke jatanan karai milayo na taa so jai ||4||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਉਸ ਨੂੰ) ਮਿਲਣ ਦੇ ਯਤਨ ਕਰਦੀ, ਪਰ ਉਸ ਨਾਲ ਮੇਲ ਨਹੀਂ ਹੋ ਰਿਹਾ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "मिलिबे के जतनन करै मिल्यो न ता सो जाइ ॥४॥",
      "sourceLineId": "130781",
      "sourceShabadId": "12417",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130782",
      "sourceShabadId": "12418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਰਾਨੀ ਬਹੁ ਉਪਚਾਰ ਬਨਾਏ ॥",
      "transliteration": "raanee bahu upachaar banaae ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਬਹੁਤ ਉਪਾ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "रानी बहु उपचार बनाए ॥",
      "sourceLineId": "130783",
      "sourceShabadId": "12418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਬਹੁਤ ਮਨੁਖ ਤਿਹ ਠੌਰ ਪਠਾਏ ॥",
      "transliteration": "bahut manukh teh Thauar paThaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਸਾਰੇ ਬੰਦੇ ਉਸ ਕੋਲ ਭੇਜੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "बहुत मनुख तिह ठौर पठाए ॥",
      "sourceLineId": "130784",
      "sourceShabadId": "12418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਬਹੁ ਕਰਿ ਜਤਨ ਏਕ ਦਿਨ ਆਨਾ ॥",
      "transliteration": "bahu kar jatan ek dhin aanaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਯਤਨ ਕਰ ਕੇ (ਉਸ ਨੂੰ) ਇਕ ਦਿਨ ਲਿਆਂਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "बहु करि जतन एक दिन आना ॥",
      "sourceLineId": "130785",
      "sourceShabadId": "12418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1207_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਿਹ ਸੰਗ ਕਮਾਨਾ ॥੫॥",
      "transliteration": "kaam bhog teh sa(n)g kamaanaa ||5||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਕਾਮ ਭੋਗ ਕੀਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1207,
      "hindi": "",
      "hindiTransliteration": "काम भोग तिह संग कमाना ॥५॥",
      "sourceLineId": "130786",
      "sourceShabadId": "12418",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
