{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1209,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1209_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਪੁ ਭਾਜ ਪੁਨਿ ਤਹ ਤੇ ਗਯੋ ॥",
      "transliteration": "aap bhaaj pun teh te gayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਆਪ ਉਥੋਂ ਭਜ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "आपु भाज पुनि तह ते गयो ॥",
      "sourceLineId": "130835",
      "sourceShabadId": "12419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤੇਜ ਭਏ ਤ੍ਰਿਯ ਕੋ ਤਨ ਤਯੋ ॥੬॥",
      "transliteration": "tej bhe tiray ko tan tayo ||6||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਨਾਲ ਰਾਣੀ ਦਾ ਸ਼ਰੀਰ ਤਪ ਗਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "तेज भए तृय को तन तयो ॥६॥",
      "sourceLineId": "130836",
      "sourceShabadId": "12419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਲਿਖਿ ਪਤਿਯਾ ਅਸਿ ਤਾਹਿ ਪਠਾਈ ॥",
      "transliteration": "likh patiyaa as taeh paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਚਿੱਠੀ ਲਿਖ ਕੇ ਭੇਜੀ",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "लिखि पतिया असि ताहि पठाई ॥",
      "sourceLineId": "130837",
      "sourceShabadId": "12419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤੋਹਿ ਮਿਤ੍ਰ ਮੁਹਿ ਤਜਾ ਨ ਜਾਈ ॥",
      "transliteration": "toh mitr muh tajaa na jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਹੇ ਮਿਤਰ! ਮੇਰੇ ਤੋਂ ਤੂੰ ਛਡਿਆ ਨਹੀਂ ਜਾਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "तोहि मित्र मुहि तजा न जाई ॥",
      "sourceLineId": "130838",
      "sourceShabadId": "12419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਛਿਮਾ ਕਰਹੁ ਇਹ ਭੂਲਿ ਹਮਾਰੀ ॥",
      "transliteration": "chhimaa karahu ieh bhool hamaaree ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੀ ਇਹ ਭੁਲ ਮਾਫ਼ ਕਰ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "छिमा करहु इह भूलि हमारी ॥",
      "sourceLineId": "130839",
      "sourceShabadId": "12419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਬ ਦਾਸੀ ਮੈ ਭਈ ਤਿਹਾਰੀ ॥੭॥",
      "transliteration": "ab dhaasee mai bhiee tihaaree ||7||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੈਂ ਤੁਹਾਡੀ ਦਾਸੀ ਹੋ ਗਈ ਹਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "अब दासी मै भई तिहारी ॥७॥",
      "sourceLineId": "130840",
      "sourceShabadId": "12419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜੌ ਆਗੇ ਫਿਰਿ ਐਸ ਨਿਹਰਿਯਹੁ ॥",
      "transliteration": "jau aage fir aais nihariyahu ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੁਸੀਂ ਅਗੋਂ ਫਿਰ (ਮੈਨੂੰ) ਇਸ ਤਰ੍ਰਹਾ ਵੇਖੋ",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "जौ आगे फिरि ऐस निहरियहु ॥",
      "sourceLineId": "130841",
      "sourceShabadId": "12419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮੋਹੂ ਸਹਿਤ ਮਾਰਿ ਤਿਹ ਡਰਿਯਹੁ ॥",
      "transliteration": "mohoo sahit maar teh ddariyahu ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨਾਲ ਹੀ ਮੈਨੂੰ ਵੀ ਮਾਰ ਦੇਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "मोहू सहित मारि तिह डरियहु ॥",
      "sourceLineId": "130842",
      "sourceShabadId": "12419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭਲਾ ਕਿਯਾ ਤੁਮ ਤਾਹਿ ਸੰਘਾਰਾ ॥",
      "transliteration": "bhalaa kiyaa tum taeh sa(n)ghaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਚੰਗਾ ਕੀਤਾ ਜੋ ਉਸ ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "भला किया तुम ताहि संघारा ॥",
      "sourceLineId": "130843",
      "sourceShabadId": "12419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਆਗੇ ਰਾਹ ਮਿਤ੍ਰ ਮੁਹਿ ਡਾਰਾ ॥੮॥",
      "transliteration": "aage raeh mitr muh ddaaraa ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੇ ਮਿਤਰ! ਮੈਨੂੰ ਅਗੋਂ ਲਈ (ਸਹੀ) ਰਸਤੇ ਉਤੇ ਪਾ ਦਿੱਤਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "आगे राह मित्र मुहि डारा ॥८॥",
      "sourceLineId": "130844",
      "sourceShabadId": "12419",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "130845",
      "sourceShabadId": "12420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪਤਿਯਾ ਬਾਚਤ ਮੂੜ ਮਤਿ ਫੂਲ ਗਯੋ ਮਨ ਮਾਹਿ ॥",
      "transliteration": "patiyaa baachat mooR mat fool gayo man maeh ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਮੂਰਖ ਮਤ ਵਾਲਾ ਚਿੱਠੀ ਪੜ੍ਰਹ ਕੇ ਮਨ ਵਿਚ ਫੁਲ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "पतिया बाचत मूड़ मति फूल गयो मन माहि ॥",
      "sourceLineId": "130846",
      "sourceShabadId": "12420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਹੁਰਿ ਤਹਾ ਆਵਤ ਭਯੋ ਭੇਦ ਪਛਾਨਿਯੋ ਨਾਹਿ ॥੯॥",
      "transliteration": "bahur tahaa aavat bhayo bhedh pachhaaniyo naeh ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੇਦ ਜਾਣੇ ਬਿਨਾ ਫਿਰ ਉਸ ਕੋਲ ਆ ਗਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "बहुरि तहा आवत भयो भेद पछानियो नाहि ॥९॥",
      "sourceLineId": "130847",
      "sourceShabadId": "12420",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130848",
      "sourceShabadId": "12421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪ੍ਰਥਮ ਮਿਤ੍ਰ ਤਿਹ ਠਾ ਜਬ ਆਯੋ ॥",
      "transliteration": "pratham mitr teh Thaa jab aayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਪਹਿਲਾ ਮਿਤਰ ਉਸ ਥਾ ਤੇ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "प्रथम मित्र तिह ठा जब आयो ॥",
      "sourceLineId": "130849",
      "sourceShabadId": "12421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੁਤਿਯ ਮਿਤ੍ਰ ਸੌ ਬਾਧਿ ਜਰਾਯੋ ॥",
      "transliteration": "dhutiy mitr sau baadh jaraayo ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਉਸ ਨੂੰ) ਦੂਜੇ ਮਿਤਰ (ਦੀ ਲੋਥ ਨਾਲ) ਬੰਨ੍ਰਹ ਕੇ ਸਾੜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "दुतिय मित्र सौ बाधि जरायो ॥",
      "sourceLineId": "130850",
      "sourceShabadId": "12421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਿਨ ਮੇਰੇ ਮਿਤਵਾ ਕਹ ਮਾਰਿਯੋ ॥",
      "transliteration": "jin mere mitavaa keh maariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਮਨ ਵਿਚ ਸੋਚਿਆ ਕਿ) ਜਿਸ ਨੇ ਮੇਰੇ ਮਿਤਰ ਨੂੰ ਮਾਰਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "जिन मेरे मितवा कह मारियो ॥",
      "sourceLineId": "130851",
      "sourceShabadId": "12421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਵਹੈ ਚਾਹਿਯਤ ਪਕਰਿ ਸੰਘਾਰਿਯੋ ॥੧੦॥",
      "transliteration": "vahai chaahiyat pakar sa(n)ghaariyo ||10||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੀ ਪਕੜ ਕੇ ਮਾਰ ਦੇਣਾ ਚਾਹੀਦਾ ਹੈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "वहै चाहियत पकरि संघारियो ॥१०॥",
      "sourceLineId": "130852",
      "sourceShabadId": "12421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਸ ਤ੍ਰਿਯ ਪ੍ਰਥਮ ਭਜਤ ਭੀ ਜਾ ਕੋ ॥",
      "transliteration": "as tiray pratham bhajat bhee jaa ko ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਜਿਸ ਨਾਲ ਇਸਤਰੀ ਪਹਿਲਾ ਸੰਯੋਗ ਕਰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "अस तृय प्रथम भजत भी जा को ॥",
      "sourceLineId": "130853",
      "sourceShabadId": "12421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਪੁਨਿ ਮਾਰਿਯੋ ਤਾ ਕੋ ॥",
      "transliteration": "eeh charitr pun maariyo taa ko ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਚਰਿਤ੍ਰ ਨਾਲ ਉਸ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र पुनि मारियो ता को ॥",
      "sourceLineId": "130854",
      "sourceShabadId": "12421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਨ ਅਬਲਨ ਕੀ ਰੀਤਿ ਅਪਾਰਾ ॥",
      "transliteration": "ein abalan kee reet apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਇਸਤਰੀਆਂ ਦੀ ਰੀਤ ਅਪਾਰ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "इन अबलन की रीति अपारा ॥",
      "sourceLineId": "130855",
      "sourceShabadId": "12421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਨ ਕੋ ਆਵਤ ਵਾਰ ਨ ਪਾਰਾ ॥੧੧॥",
      "transliteration": "jin ko aavat vaar na paaraa ||11||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਆਰਪਾਰ ਨਹੀਂ ਪਾਇਆ ਜਾ ਸਕਦਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "जिन को आवत वार न पारा ॥११॥",
      "sourceLineId": "130856",
      "sourceShabadId": "12421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਤਿਹਤਰ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੭੩॥੫੨੯੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau tihatar charitr samaapatam sat subham sat ||273||5290||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੭੩ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੭੩॥੫੨੯੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ तिहतर चरित्र समापतम सतु सुभम सतु ॥२७३॥५२९०॥अफजूँ॥",
      "sourceLineId": "130857",
      "sourceShabadId": "12421",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130858",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਇਕ ਅੰਬਸਟ ਕੇ ਦੇਸ ਨ੍ਰਿਪਾਲਾ ॥",
      "transliteration": "eik a(n)basaT ke dhes nirapaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਬਸਟ ਦੇਸ ਦਾ ਇਕ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "इक अंबसट के देस नृपाला ॥",
      "sourceLineId": "130859",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਦੁਮਿਨਿ ਦੇ ਜਾ ਕੇ ਗ੍ਰਿਹ ਬਾਲਾ ॥",
      "transliteration": "padhumin dhe jaa ke gireh baalaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਪਦਮਨੀ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "पदुमिनि दे जा के गृह बाला ॥",
      "sourceLineId": "130860",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਪ੍ਰਮਾਨ ਤਿਹ ਪ੍ਰਭਾ ਭਨਿਜੈ ॥",
      "transliteration": "apramaan teh prabhaa bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਬਹੁਤ ਅਧਿਕ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "अप्रमान तिह प्रभा भनिजै ॥",
      "sourceLineId": "130861",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਿਹ ਕੋ ਕੋ ਪਤਟਰ ਤ੍ਰਿਯ ਦਿਜੈ ॥੧॥",
      "transliteration": "jeh ko ko pataTar tiray dhijai ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਤੁਲਨਾ ਕਿਸ ਇਸਤਰੀ ਨਾਲ ਦੇਈਏ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "जिह को को पतटर तृय दिजै ॥१॥",
      "sourceLineId": "130862",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਾ ਕੇ ਏਕ ਦਾਸ ਘਰ ਮਾਹੀ ॥",
      "transliteration": "taa ke ek dhaas ghar maahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਇਕ ਦਾਸ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "ता के एक दास घर माही ॥",
      "sourceLineId": "130863",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਿਹ ਸਮ ਸ੍ਯਾਮ ਬਰਨ ਕਹੂੰ ਨਾਹੀ ॥",
      "transliteration": "jeh sam sayaam baran kahoo(n) naahee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੇ ਕਾਲੇ ਰੰਗ ਵਾਲਾ ਹੋਰ ਕੋਈ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "जिह सम स्याम बरन कहूँ नाही ॥",
      "sourceLineId": "130864",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਾਮਾਫਿਕ ਸੰਖ੍ਯਾ ਤਿਹ ਰਹੈ ॥",
      "transliteration": "naamaafik sa(n)khayaa teh rahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਾ 'ਨਾਮਾਫਿਕ' ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "नामाफिक संख्या तिह रहै ॥",
      "sourceLineId": "130865",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਾਨੁਖ ਜੋਨਿ ਕਵਨ ਤਿਹ ਕਹੈ ॥੨॥",
      "transliteration": "maanukh jon kavan teh kahai ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਮਨੁੱਖ ਜੂਨ ਵਾਲਾ ਕੋਈ ਕਿਵੇਾਂ ਕਹਿ ਸਕਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "मानुख जोनि कवन तिह कहै ॥२॥",
      "sourceLineId": "130866",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚੇਰੀ ਏਕ ਹੁਤੀ ਤਾ ਸੌ ਰਤਿ ॥",
      "transliteration": "cheree ek hutee taa sau rat ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਾਸੀ ਉਸ ਵਿਚ ਮਗਨ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "चेरी एक हुती ता सौ रति ॥",
      "sourceLineId": "130867",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਾ ਕੇ ਹੁਤੀ ਨ ਕਛੁ ਘਟ ਮਹਿ ਮਤਿ ॥",
      "transliteration": "jaa ke hutee na kachh ghaT meh mat ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤੋਂ ਘਟ ਮੂਰਖ ਇਸ ਧਰਤੀ ਉਤੇ ਕੋਈ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "जा के हुती न कछु घट महि मति ॥",
      "sourceLineId": "130868",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਮਾਫਿਕ ਤਿਨ ਨਾਰਿ ਬੁਲਾਯੋ ॥",
      "transliteration": "naamaafik tin naar bulaayo ||",
      "translation": "",
      "punjabiViakhya": "ਨਾਮਾਫਿਕ ਨੂੰ ਉਸ ਇਸਤਰੀ ਨੇ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "नामाफिक तिन नारि बुलायो ॥",
      "sourceLineId": "130869",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਮਨ ਖੋਲਿ ਮਚਾਯੋ ॥੩॥",
      "transliteration": "kaam bhog man khol machaayo ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਨ ਭਰ ਕੇ ਉਸ ਨਾਲ ਕਾਮ ਭੋਗ ਕੀਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "काम भोग मन खोलि मचायो ॥३॥",
      "sourceLineId": "130870",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਬ ਲਗਿ ਆਇ ਨ੍ਰਿਪਤਿ ਗਯੋ ਤਹਾ ॥",
      "transliteration": "tab lag aai nirapat gayo tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਉਥੇ ਰਾਜਾ ਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "तब लगि आइ नृपति गयो तहा ॥",
      "sourceLineId": "130871",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਚੇਰੀ ਰਮਤ ਦਾਸਿ ਸੰਗ ਜਹਾ ॥",
      "transliteration": "cheree ramat dhaas sa(n)g jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਦਾਸੀ (ਉਸ) ਦਾਸ ਨਾਲ ਰਮਣ ਕਰ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "चेरी रमत दासि संग जहा ॥",
      "sourceLineId": "130872",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਲਟਪਟਾਇ ਦਾਸੀ ਤਬ ਗਈ ॥",
      "transliteration": "laTapaTai dhaasee tab giee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦਾਸੀ ਘਬਰਾ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "लटपटाइ दासी तब गई ॥",
      "sourceLineId": "130873",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚਟਪਟ ਜਾਤ ਸਕਲ ਸੁਧਿ ਭਈ ॥੪॥",
      "transliteration": "chaTapaT jaat sakal sudh bhiee ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਝਟਪਟ ਸਾਰੀ ਹੋਸ਼ ਚਲੀ ਗਈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "चटपट जात सकल सुधि भई ॥४॥",
      "sourceLineId": "130874",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਤਨ ਅਵਰ ਕਛੁ ਹਾਥ ਨ ਆਯੋ ॥",
      "transliteration": "jatan avar kachh haath na aayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਹੋਰ ਕੁਝ ਉਪਾ ਨਾ ਫੁਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "जतन अवर कछु हाथ न आयो ॥",
      "sourceLineId": "130875",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮਾਰਿ ਦਾਸ ਉਲਟੋ ਲਟਕਾਯੋ ॥",
      "transliteration": "maar dhaas ulaTo laTakaayo ||",
      "translation": "",
      "punjabiViakhya": "ਦਾਸ ਨੂੰ ਮਾਰ ਕੇ ਉਲਟਾ ਲਟਕਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "मारि दास उलटो लटकायो ॥",
      "sourceLineId": "130876",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹਰੇ ਹਰੇ ਤਰ ਆਗਿ ਜਰਾਈ ॥",
      "transliteration": "hare hare tar aag jaraiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ ਹੇਠਾ) ਮਠੀ ਮਠੀ ਅੱਗ ਬਾਲ ਦਿੱਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "हरे हरे तर आगि जराई ॥",
      "sourceLineId": "130877",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਾਢਤ ਹੈ ਜਨੁ ਕਰਿ ਮਿਮਿਯਾਈ ॥੫॥",
      "transliteration": "kaaddat hai jan kar mimiyaiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਉਸ ਦੀ ਚਰਬੀ ਕਢ ਰਹੀ ਹੋਵੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "काढत है जनु करि मिमियाई ॥५॥",
      "sourceLineId": "130878",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨ੍ਰਿਪਤਿ ਮ੍ਰਿਤਕ ਜਬ ਦਾਸ ਨਿਹਾਰਾ ॥",
      "transliteration": "nirapat mritak jab dhaas nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਦਾਸ ਨੂੰ ਮਰਿਆ ਹੋਇਆ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "नृपति मृतक जब दास निहारा ॥",
      "sourceLineId": "130879",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਦਭੁਦ ਹ੍ਵੈ ਇਹ ਭਾਤਿ ਉਚਾਰਾ ॥",
      "transliteration": "adhabhudh havai ieh bhaat uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਹੈਰਾਨ ਹੋ ਕੇ ਪੁਛਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "अदभुद ह्वै इह भाति उचारा ॥",
      "sourceLineId": "130880",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕ੍ਯੋ ਇਹ ਹਨਿ ਤੈ ਦਿਯ ਲਟਕਾਈ ॥",
      "transliteration": "kayo ieh han tai dhiy laTakaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਮਾਰ ਕੇ ਤੂੰ ਪੁਠਾ ਕਿਉਾਂ ਲਟਕਾਇਆ ਹੋਇਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "क्यो इह हनि तै दिय लटकाई ॥",
      "sourceLineId": "130881",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1209_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਿਹ ਕਾਰਨ ਤਰ ਆਗਿ ਜਰਾਈ ॥੬॥",
      "transliteration": "keh kaaran tar aag jaraiee ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਦੇ ਹੇਠਾ ਅੱਗ ਕਿਸ ਲਈ ਬਾਲੀ ਹੋਈ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1209,
      "hindi": "",
      "hindiTransliteration": "किह कारन तर आगि जराई ॥६॥",
      "sourceLineId": "130882",
      "sourceShabadId": "12422",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
