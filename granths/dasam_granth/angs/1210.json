{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1210,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1210_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚੇਰੀ ਬਾਚ ॥",
      "transliteration": "cheree baach ||",
      "translation": "",
      "punjabiViakhya": "ਦਾਸੀ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "चेरी बाच ॥",
      "sourceLineId": "130883",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਿਲ੍ਯੋ ਬੈਦ ਮੁਹਿ ਏਕ ਨ੍ਰਿਪਾਰਾ ॥",
      "transliteration": "milayo baidh muh ek nirapaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਮੈਨੂੰ ਇਕ ਵੈਦ ਮਿਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "मिल्यो बैद मुहि एक नृपारा ॥",
      "sourceLineId": "130884",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕ੍ਰਿਯਾ ਦਈ ਤਿਨ ਮੋਹਿ ਸੁਧਾਰਾ ॥",
      "transliteration": "kirayaa dhiee tin moh sudhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਮੈਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ (ਦਵਾਈ ਦੀ ਇਕ) ਵਿਧੀ ਦਸੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "कृया दई तिन मोहि सुधारा ॥",
      "sourceLineId": "130885",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮੈ ਇਹ ਕਰੀ ਚਕਿਤਸਾ ਤਾ ਤੇ ॥",
      "transliteration": "mai ieh karee chakitasaa taa te ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਮੈਂ ਉਹ ਚਿਕਿਤਸਾ-ਕ੍ਰਿਆ ਕੀਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "मै इह करी चकितसा ता ते ॥",
      "sourceLineId": "130886",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਲੀਜੈ ਸਕਲ ਬ੍ਰਿਥਾ ਸੁਨਿ ਯਾ ਤੇ ॥੭॥",
      "transliteration": "leejai sakal birathaa sun yaa te ||7||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਬਾਰੇ (ਮੇਰੇ ਕੋਲੋਂ) ਪੂਰੀ ਵਿਥਿਆ ਸੁਣ ਲਵੋ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "लीजै सकल बृथा सुनि या ते ॥७॥",
      "sourceLineId": "130887",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਖਈ ਰੋਗ ਇਹ ਕਹਿਯੋ ਰਾਜ ਮਹਿ ॥",
      "transliteration": "khiee rog ieh kahiyo raaj meh ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਵੈਦ) ਨੇ ਮੈਨੂੰ ਦਸਿਆ ਕਿ ਰਾਜੇ ਨੂੰ ਤਪੇਦਿਕ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "खई रोग इह कहियो राज महि ॥",
      "sourceLineId": "130888",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਾ ਤੇ ਮਾਰਿ ਦਾਸ ਤੂ ਇਹ ਕਹਿ ॥",
      "transliteration": "taa te maar dhaas too ieh keh ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਤੂੰ ਇਸ ਦਾਸ ਨੂੰ ਮਾਰ ਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "ता ते मारि दास तू इह कहि ॥",
      "sourceLineId": "130889",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਰਿ ਮਿਮਿਯਾਈ ਨ੍ਰਿਪਹਿ ਖਵਾਵੈ ॥",
      "transliteration": "kar mimiyaiee nirapeh khavaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ ਮਗ਼ਜ਼ ਦੀ) ਚਰਬੀ ਕਢ ਕੇ ਰਾਜੇ ਨੂੰ ਖੁਆਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "करि मिमियाई नृपहि खवावै ॥",
      "sourceLineId": "130890",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਬ ਤਿਹ ਦੋਖ ਦੂਰ ਹ੍ਵੈ ਜਾਵੈ ॥੮॥",
      "transliteration": "tab teh dhokh dhoor havai jaavai ||8||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਦਾ ਦੁਖ ਦੂਰ ਹੋ ਜਾਏਗਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "तब तिह दोख दूर ह्वै जावै ॥८॥",
      "sourceLineId": "130891",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਿਹ ਨਿਮਿਤ ਯਾ ਕੋ ਮੈ ਘਾਯੋ ॥",
      "transliteration": "teh nimit yaa ko mai ghaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਮੈਂ ਇਸ ਨੂੰ ਮਾਰਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "तिह निमित या को मै घायो ॥",
      "sourceLineId": "130892",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਿਮਿਯਾਈ ਕੋ ਬਿਵਤ ਬਨਾਯੋ ॥",
      "transliteration": "mimiyaiee ko bivat banaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਰਬੀ (ਕਢਣ ਦੀ) ਵਿਉਾਂਤ ਬਣਾਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "मिमियाई को बिवत बनायो ॥",
      "sourceLineId": "130893",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੌ ਤੁਮ ਭਛਨ ਕਰਹੁ ਤੇ ਕੀਜੈ ॥",
      "transliteration": "jau tum bhachhan karahu te keejai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੁਸੀਂ (ਇਸ ਚਰਬੀ ਨੂੰ) ਖਾਣਾ ਹੋਵੇ ਤਾ ਮੈਂ ਕਢਾ?",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "जौ तुम भछन करहु ते कीजै ॥",
      "sourceLineId": "130894",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾਤਰ ਛਾਡਿ ਆਜੁ ਹੀ ਦੀਜੈ ॥੯॥",
      "transliteration": "naatar chhaadd aaj hee dheejai ||9||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਹੁਣੇ ਹੀ (ਇਸ ਨੂੰ) ਛਡ ਦਿਆਂ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "नातर छाडि आजु ही दीजै ॥९॥",
      "sourceLineId": "130895",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਬ ਇਹ ਭਾਤਿ ਨ੍ਰਿਪਤਿ ਸੁਨਿ ਪਾਯੋ ॥",
      "transliteration": "jab ieh bhaat nirapat sun paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "जब इह भाति नृपति सुनि पायो ॥",
      "sourceLineId": "130896",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਾਹਿ ਬੈਦਨੀ ਕਰਿ ਠਹਰਾਯੋ ॥",
      "transliteration": "taeh baidhanee kar Thaharaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੂੰ ਵੈਦਣੀ ਵਜੋਂ ਮੰਨ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "ताहि बैदनी करि ठहरायो ॥",
      "sourceLineId": "130897",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਨ ਮਹਿ ਕਹਿਯੋ ਭਲੀ ਬਿਧਿ ਕੀਨੀ ॥",
      "transliteration": "man meh kahiyo bhalee bidh keenee ||",
      "translation": "",
      "punjabiViakhya": "ਮਨ ਵਿਚ ਕਹਿਣ ਲਗਾ ਕਿ ਵਿਧਾਤਾ ਨੇ ਚੰਗਾ ਕੀਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "मन महि कहियो भली बिधि कीनी ॥",
      "sourceLineId": "130898",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਘਰ ਮਹਿ ਨਾਰਿ ਰੋਗਿਹਾ ਦੀਨੀ ॥੧੦॥",
      "transliteration": "ghar meh naar rogihaa dheenee ||10||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਘਰ ਵਿਚ ਹੀ ਰੋਗ ਖ਼ਤਮ ਕਰਨ ਵਾਲੀ ਇਸਤਰੀ ਦੇ ਦਿੱਤੀ ਹੈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "घर महि नारि रोगिहा दीनी ॥१०॥",
      "sourceLineId": "130899",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਧੰਨਿ ਧੰਨਿ ਕਹਿ ਤਾਹਿ ਬਖਾਨਾ ॥",
      "transliteration": "dha(n)n dha(n)n keh taeh bakhaanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਉਸ ਨੂੰ ਧੰਨ ਧੰਨ ਕਿਹਾ (ਅਤੇ ਦਸਿਆ ਕਿ)",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "धंनि धंनि कहि ताहि बखाना ॥",
      "sourceLineId": "130900",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤੇਰੋ ਗੁਨ ਹਮ ਆਜੁ ਪਛਾਨਾ ॥",
      "transliteration": "tero gun ham aaj pachhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਰਾ ਗੁਣ ਮੈਂ ਅਜ ਪਛਾਣਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "तेरो गुन हम आजु पछाना ॥",
      "sourceLineId": "130901",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪਛਮ ਦਿਸਿ ਹਮ ਸੁਨੀ ਬਨੈਯਤ ॥",
      "transliteration": "pachham dhis ham sunee banaiyat ||",
      "translation": "",
      "punjabiViakhya": "ਪੱਛਮ ਦਿਸ਼ਾ (ਦੇ ਦੇਸ਼ਾ) ਵਿਚ (ਇਸ ਪ੍ਰਕਾਰ ਦੀ ਦਵਾਈ) ਬਣਦੀ ਸੁਣੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "पछम दिसि हम सुनी बनैयत ॥",
      "sourceLineId": "130902",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹਮਰੇ ਦੇਸ ਨ ਢੂੰਡੀ ਪੈਯਤ ॥੧੧॥",
      "transliteration": "hamare dhes na ddoo(n)ddee paiyat ||11||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਸਾਡੇ ਦੇਸ ਵਿਚ ਕਿਤੇ ਢੂੰਢਿਆਂ ਨਹੀਂ ਮਿਲਦੀ ਹੈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "हमरे देस न ढूँडी पैयत ॥११॥",
      "sourceLineId": "130903",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤੁਹਿ ਜਾਨਤ ਮੁਹਿ ਕਹਤ ਬਤਾਈ ॥",
      "transliteration": "tuh jaanat muh kahat bataiee ||",
      "translation": "",
      "punjabiViakhya": "ਤੂੰ ਜਾਣਦੀ ਹੈਂ ਅਤੇ ਮੈਨੂੰ ਦਸ ਰਹੀ ਹੈਂ",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "तुहि जानत मुहि कहत बताई ॥",
      "sourceLineId": "130904",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਿਮਿਆਈ ਇਹ ਦੇਸ ਬਨਾਈ ॥",
      "transliteration": "mimiaaiee ieh dhes banaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਸ ਦੇਸ ਵਿਚ ਵੀ ਚਰਬੀ (ਦੀ ਦਵਾਈ) ਬਣਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "मिमिआई इह देस बनाई ॥",
      "sourceLineId": "130905",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਹਾ ਭਯੋ ਇਕ ਦਾਸ ਸੰਘਾਰਾ ॥",
      "transliteration": "kahaa bhayo ik dhaas sa(n)ghaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕੀ ਹੋਇਆ ਜੇ ਇਕ ਦਾਸ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "कहा भयो इक दास संघारा ॥",
      "sourceLineId": "130906",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹਮਰੋ ਰੋਗ ਬਡੋ ਤੈ ਟਾਰਾ ॥੧੨॥",
      "transliteration": "hamaro rog baddo tai Taaraa ||12||",
      "translation": "",
      "punjabiViakhya": "ਤੂੰ ਤਾ ਮੇਰਾ ਵੱਡਾ ਰੋਗ ਖ਼ਤਮ ਕਰ ਦਿੱਤਾ ਹੈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "हमरो रोग बडो तै टारा ॥१२॥",
      "sourceLineId": "130907",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਚੌਹਤਰ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੭੪॥੫੩੦੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau chauahatar charitr samaapatam sat subham sat ||274||5302||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੭੪ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੭੪॥੫੩੦੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ चौहतर चरित्र समापतम सतु सुभम सतु ॥२७४॥५३०२॥अफजूँ॥",
      "sourceLineId": "130908",
      "sourceShabadId": "12423",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130909",
      "sourceShabadId": "12424",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬੰਦਰ ਬਸ ਤਹ ਬਾਸੀ ਜਹਾ ॥",
      "transliteration": "ba(n)dhar bas teh baasee jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਬੰਦਰ ਬਸ ਨਾ ਦੀ ਬਸਤੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "बंदर बस तह बासी जहा ॥",
      "sourceLineId": "130910",
      "sourceShabadId": "12424",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਬਸੀ ਰਾਇ ਨਰਾਧਿਪ ਤਹਾ ॥",
      "transliteration": "habasee rai naraadhip tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਹਬਸ਼ੀ ਰਾਇ ਨਾ ਦਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "हबसी राइ नराधिप तहा ॥",
      "sourceLineId": "130911",
      "sourceShabadId": "12424",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹਬਸ ਮਤੀ ਤਾ ਕੈ ਘਰ ਰਾਨੀ ॥",
      "transliteration": "habas matee taa kai ghar raanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਹਬਸ਼ ਮਤੀ ਨਾ ਦੀ ਰਾਣੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "हबस मती ता कै घर रानी ॥",
      "sourceLineId": "130912",
      "sourceShabadId": "12424",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਨੁ ਪੁਰ ਖੋਜਿ ਚੌਦਹੂੰ ਆਨੀ ॥੧॥",
      "transliteration": "jan pur khoj chauadhahoo(n) aanee ||1||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਚੌਦਾ ਲੋਕਾ ਨੂੰ ਖੋਜ ਕੇ ਲਿਆਂਦੀ ਹੋਵੇ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "जनु पुर खोजि चौदहूँ आनी ॥१॥",
      "sourceLineId": "130913",
      "sourceShabadId": "12424",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਹਾਸਿਮ ਖਾਨ ਪਠਾਨ ਇਕ ਤਹਾ ॥",
      "transliteration": "haasim khaan paThaan ik tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਹਾਸ਼ਿਮ ਖ਼ਾਨ ਨਾ ਦਾ ਪਠਾਣ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "हासिम खान पठान इक तहा ॥",
      "sourceLineId": "130914",
      "sourceShabadId": "12424",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਾ ਸਮ ਸੁੰਦਰ ਕੋਊ ਨ ਕਹਾ ॥",
      "transliteration": "jaa sam su(n)dhar kouoo na kahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਕਿਤੇ ਕੋਈ ਸੁੰਦਰ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "जा सम सुँदर कोऊ न कहा ॥",
      "sourceLineId": "130915",
      "sourceShabadId": "12424",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰਾਨੀ ਤਾਹਿ ਨਿਰਖਿ ਉਰਝਾਨੀ ॥",
      "transliteration": "raanee taeh nirakh urajhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਉਲਝ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "रानी ताहि निरखि उरझानी ॥",
      "sourceLineId": "130916",
      "sourceShabadId": "12424",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਿਰਹ ਬਿਕਲ ਹ੍ਵੈ ਗਈ ਦਿਵਾਨੀ ॥੨॥",
      "transliteration": "bireh bikal havai giee dhivaanee ||2||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਉਸ ਦੇ) ਵਿਯੋਗ ਵਿਚ ਵਿਆਕੁਲ ਹੋ ਕੇ ਦੀਵਾਨੀ ਹੋ ਗਈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "बिरह बिकल ह्वै गई दिवानी ॥२॥",
      "sourceLineId": "130917",
      "sourceShabadId": "12424",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰਾਨੀ ਜਤਨ ਅਨੇਕ ਬਨਾਏ ॥",
      "transliteration": "raanee jatan anek banaae ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਅਨੇਕ ਤਰ੍ਰਹਾ ਦੇ ਯਤਨ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "रानी जतन अनेक बनाए ॥",
      "sourceLineId": "130918",
      "sourceShabadId": "12424",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਛਲ ਬਲ ਸੌ ਗ੍ਰਿਹ ਮਿਤ੍ਰ ਬੁਲਾਏ ॥",
      "transliteration": "chhal bal sau gireh mitr bulaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵਲ ਛਲ ਨਾਲ ਮਿਤਰ ਨੂੰ ਘਰ ਬੁਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "छल बल सौ गृह मित्र बुलाए ॥",
      "sourceLineId": "130919",
      "sourceShabadId": "12424",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਿਹ ਸੰਗ ਕਮਾਨਾ ॥",
      "transliteration": "kaam bhog teh sa(n)g kamaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਕਾਮ ਭੋਗ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "काम भोग तिह संग कमाना ॥",
      "sourceLineId": "130920",
      "sourceShabadId": "12424",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਆਸਨ ਚੁੰਬਨ ਕੀਏ ਪ੍ਰਮਾਨਾ ॥੩॥",
      "transliteration": "aasan chu(n)ban ke'ee pramaanaa ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਚੰਬਨ ਅਤੇ ਆਸਣ ਕੀਤੇ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "आसन चुँबन कीए प्रमाना ॥३॥",
      "sourceLineId": "130921",
      "sourceShabadId": "12424",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "130922",
      "sourceShabadId": "12425",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਨਿਕ ਭਾਤਿ ਭਜਿ ਮਿਤ੍ਰ ਕਹ ਗਰੇ ਰਹੀ ਲਪਟਾਇ ॥",
      "transliteration": "anik bhaat bhaj mitr keh gare rahee lapaTai ||",
      "translation": "",
      "punjabiViakhya": "(ਆਪਣੇ) ਮਿਤਰ ਨਾਲ ਅਨੇਕ ਤਰ੍ਰਹਾ ਦੀ ਰਤੀ-ਕ੍ਰੀੜਾ ਕਰ ਕੇ ਉਸ ਦੇ ਗਲੇ ਨਾਲ ਲਿਪਟ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "अनिक भाति भजि मित्र कह गरे रही लपटाइ ॥",
      "sourceLineId": "130923",
      "sourceShabadId": "12425",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਾਨੁ ਨਿਰਧਨੀ ਪਾਇ ਧਨ ਰਹਿਯੋ ਹੀਯ ਸੌ ਲਾਇ ॥੪॥",
      "transliteration": "jaan niradhanee pai dhan rahiyo heey sau lai ||4||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਕੋਈ ਨਿਰਧਨ ਵਿਅਕਤੀ, ਧਨ ਦੇ ਪ੍ਰਾਪਤ ਹੋ ਜਾਣ ਤੇ ਉਸ ਨੂੰ ਹਿਰਦੇ ਨਾਲ ਲਗਾਈ ਰਖਦਾ ਹੋਵੇ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "जानु निरधनी पाइ धन रहियो हीय सौ लाइ ॥४॥",
      "sourceLineId": "130924",
      "sourceShabadId": "12425",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130925",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਬ ਰਾਜਾ ਤਾ ਕੇ ਗ੍ਰਿਹ ਆਯੋ ॥",
      "transliteration": "tab raajaa taa ke gireh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜਾ ਉਸ ਦੇ ਘਰ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "तब राजा ता के गृह आयो ॥",
      "sourceLineId": "130926",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਿਰਖਿ ਸੇਜ ਪਰ ਤਾਹਿ ਰਿਸਾਯੋ ॥",
      "transliteration": "nirakh sej par taeh risaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸੇਜ ਉਤੇ ਬੈਠਾ ਵੇਖ ਕੇ ਬਹੁਤ ਕ੍ਰੋਧਿਤ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "निरखि सेज पर ताहि रिसायो ॥",
      "sourceLineId": "130927",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਸਿ ਗਹਿ ਧਯੋ ਹਾਥ ਗਹਿ ਨਾਰੀ ॥",
      "transliteration": "as geh dhayo haath geh naaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਤਲਵਾਰ ਪਕੜ ਕੇ ਝਪਟਿਆ ਪਰ ਇਸਤਰੀ ਨੇ (ਉਸ ਦਾ) ਹੱਥ ਪਕੜ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "असि गहि धयो हाथ गहि नारी ॥",
      "sourceLineId": "130928",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਸੌ ਹਸਿ ਬਾਤ ਉਚਾਰੀ ॥੫॥",
      "transliteration": "eeh bidh sau has baat uchaaree ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹਸ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਗੱਲ ਕਹੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "इह बिधि सौ हसि बात उचारी ॥५॥",
      "sourceLineId": "130929",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1210_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤੈ ਰਾਜਾ ਇਹ ਭੇਦ ਨ ਜਾਨਾ ॥",
      "transliteration": "tai raajaa ieh bhedh na jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਤੁਸੀਂ ਇਸ (ਗੱਲ) ਦਾ ਭੇਦ ਨਹੀਂ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1210,
      "hindi": "",
      "hindiTransliteration": "तै राजा इह भेद न जाना ॥",
      "sourceLineId": "130930",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
