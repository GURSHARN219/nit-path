{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1211,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1211_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਿਨੁ ਬੂਝੇ ਅਸਿ ਕੋਪ ਪ੍ਰਮਾਨਾ ॥",
      "transliteration": "bin boojhe as kop pramaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਿਨਾ ਵਿਚਾਰੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਤਲਵਾਰ ਖਿਚ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "बिनु बूझे असि कोप प्रमाना ॥",
      "sourceLineId": "130931",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪ੍ਰਥਮਹਿ ਬਾਤ ਜਾਨਿਯੈ ਯਾ ਕੀ ॥",
      "transliteration": "prathameh baat jaaniyai yaa kee ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਇਸ ਦੀ (ਸਾਰੀ) ਗੱਲ ਜਾਣੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "प्रथमहि बात जानियै या की ॥",
      "sourceLineId": "130932",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਹੁਰੌ ਸੁਧਿ ਲੀਜੈ ਕਛੁ ਤਾ ਕੀ ॥੬॥",
      "transliteration": "bahurau sudh leejai kachh taa kee ||6||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਉਸ ਦੀ ਕੁਝ ਖ਼ਬਰ ਸਾਰ ਲਵੋ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "बहुरौ सुधि लीजै कछु ता की ॥६॥",
      "sourceLineId": "130933",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਹ ਹੈ ਮਿਤ੍ਰ ਮਛਿੰਦਰ ਰਾਜਾ ॥",
      "transliteration": "eeh hai mitr machhi(n)dhar raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਇਹ ਤਾ ਮਿਤਰ ਮਛਿੰਦ੍ਰ ਨਾਥ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "इह है मित्र मछिंदर राजा ॥",
      "sourceLineId": "130934",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਆਯੋ ਨ੍ਯਾਇ ਲਹਨ ਤਵ ਕਾਜਾ ॥",
      "transliteration": "aayo nayai lahan tav kaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੁਹਾਡਾ ਨਿਆਂ ਵੇਖਣ ਦੇ ਕੰਮ ਆਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "आयो न्याइ लहन तव काजा ॥",
      "sourceLineId": "130935",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਪਸ੍ਯਾ ਬਲ ਆਯੋ ਇਹ ਠੌਰਾ ॥",
      "transliteration": "tapasayaa bal aayo ieh Thauaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਤਪਸਿਆ ਦੇ ਬਲ ਨਾਲ ਇਥੇ ਆਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "तपस्या बल आयो इह ठौरा ॥",
      "sourceLineId": "130936",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹੈ ਸਭ ਤਪਸਿਨ ਕਾ ਸਿਰਮੌਰਾ ॥੭॥",
      "transliteration": "hai sabh tapasin kaa siramauaraa ||7||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਸਾਰਿਆਂ ਤਪਸਵੀਆਂ ਦਾ ਸ਼ਿਰੋਮਣੀ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "है सभ तपसिन का सिरमौरा ॥७॥",
      "sourceLineId": "130937",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਯਾ ਸੰਗ ਮਿਤ੍ਰਾਚਾਰ ਕਰੀਜੈ ॥",
      "transliteration": "yaa sa(n)g mitraachaar kareejai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨਾਲ ਮਿਤਰਾ ਵਾਲਾ ਵਿਵਹਾਰ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "या संग मित्राचार करीजै ॥",
      "sourceLineId": "130938",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭੁਗਤਿ ਜੁਗਤਿ ਬਹੁ ਬਿਧਿ ਤਿਹ ਦੀਜੈ ॥",
      "transliteration": "bhugat jugat bahu bidh teh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਖਾਣ ਪੀਣ ਦੀਆਂ ਵਸਤੂਆਂ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "भुगति जुगति बहु बिधि तिह दीजै ॥",
      "sourceLineId": "130939",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਭਲੀ ਭਲੀ ਤੁਹਿ ਕ੍ਰਿਯਾ ਸਿਖੈਹੈ ॥",
      "transliteration": "bhalee bhalee tuh kirayaa sikhaihai ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਤੁਹਾਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ (ਯੋਗ ਦੀਆਂ) ਵਿਧੀਆਂ ਦਸਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "भली भली तुहि कृया सिखैहै ॥",
      "sourceLineId": "130940",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਾਜ ਜੋਗ ਬੈਠੋ ਗ੍ਰਿਹ ਪੈਹੈ ॥੮॥",
      "transliteration": "raaj jog baiTho gireh paihai ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘਰ ਬੈਠਿਆਂ ਹੀ ਰਾਜ ਜੋਗ ਪ੍ਰਾਪਤ ਕਰੋਗੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "राज जोग बैठो गृह पैहै ॥८॥",
      "sourceLineId": "130941",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨ੍ਰਿਪ ਏ ਬਚਨ ਸੁਨਤ ਪਗ ਪਰਾ ॥",
      "transliteration": "nirap e bachan sunat pag paraa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਇਹ ਬੋਲ ਸੁਣ ਕੇ (ਮਛਿੰਦ੍ਰ ਜੋਗੀ ਬਣੇ ਵਿਅਕਤੀ ਦੇ) ਪੈਰੀਂ ਪੈ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "नृप ए बचन सुनत पग परा ॥",
      "sourceLineId": "130942",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਿਤ੍ਰਾਚਾਰ ਤਵਨ ਸੰਗ ਕਰਾ ॥",
      "transliteration": "mitraachaar tavan sa(n)g karaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਮਿਤਰਾ ਵਾਲਾ ਸਲੂਕ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "मित्राचार तवन संग करा ॥",
      "sourceLineId": "130943",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਾਹਿ ਮਛਿੰਦ੍ਰਾ ਨਾਥ ਪਛਾਨ੍ਯੋ ॥",
      "transliteration": "taeh machhi(n)dhraa naath pachhaanayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਮਛਿੰਦ੍ਰ ਨਾਥ ਵਜੋਂ ਸਮਝ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "ताहि मछिंद्रा नाथ पछान्यो ॥",
      "sourceLineId": "130944",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮੂਰਖ ਭੇਵ ਅਭੇਵ ਨ ਜਾਨ੍ਯੋ ॥੯॥",
      "transliteration": "moorakh bhev abhev na jaanayo ||9||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਮੂਰਖ ਨੇ ਭੇਦ ਅਭੇਦ ਨਾ ਸਮਝਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "मूरख भेव अभेव न जान्यो ॥९॥",
      "sourceLineId": "130945",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਤਨ ਪੂਜਾ ਤਿਹ ਕਰੈ ॥",
      "transliteration": "bahu bidh tan poojaa teh karai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਬਹੁਤ ਢੰਗਾ ਨਾਲ ਪੂਜਾ ਕਰਨ ਲਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि तन पूजा तिह करै ॥",
      "sourceLineId": "130946",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਾਰੰਬਾਰ ਪਾਇ ਪਸੁ ਪਰੈ ॥",
      "transliteration": "baara(n)baar pai pas parai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੂਰਖ ਬਾਰ ਬਾਰ ਉਸ ਦੇ ਪੈਰੀਂ ਪੈਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "बारंबार पाइ पसु परै ॥",
      "sourceLineId": "130947",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾਹਿ ਸਹੀ ਰਿਖਿਰਾਜ ਪਛਾਨਾ ॥",
      "transliteration": "taeh sahee rikhiraaj pachhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸਹੀ ਰਿਖੀ ਰਾਜ (ਮਛਿੰਦ੍ਰ) ਵਜੋਂ ਪਛਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "ताहि सही रिखिराज पछाना ॥",
      "sourceLineId": "130948",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਤਿ ਬਚਨ ਤ੍ਰਿਯ ਕੌ ਕਰਿ ਜਾਨਾ ॥੧੦॥",
      "transliteration": "sat bachan tiray kau kar jaanaa ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਦੇ ਬਚਨ ਨੂੰ ਸਚ ਕਰ ਕੇ ਜਾਣ ਲਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "सति बचन तृय कौ करि जाना ॥१०॥",
      "sourceLineId": "130949",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਾਹਿ ਮਛਿੰਦਰ ਕਰਿ ਠਹਰਾਯੋ ॥",
      "transliteration": "taeh machhi(n)dhar kar Thaharaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ ਨੇ) ਉਸ ਨੂੰ ਮਛਿੰਦ੍ਰ ਮੰਨ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "ताहि मछिंदर करि ठहरायो ॥",
      "sourceLineId": "130950",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤ੍ਰਿਯ ਕਹ ਸੌਪਿ ਤਾਹਿ ਉਠਿ ਆਯੋ ॥",
      "transliteration": "tiray keh sauap taeh uTh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੀ ਇਸਤਰੀ ਉਸ ਨੂੰ ਸੌਂਪ ਕੇ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "तृय कह सौपि ताहि उठि आयो ॥",
      "sourceLineId": "130951",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਵਹ ਤਾ ਸੌ ਨਿਤਿ ਭੋਗ ਕਮਾਵੈ ॥",
      "transliteration": "veh taa sau nit bhog kamaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰਾਣੀ ਨਾਲ ਨਿੱਤ ਭੋਗ ਕਰਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "वह ता सौ निति भोग कमावै ॥",
      "sourceLineId": "130952",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮੂਰਖ ਬਾਤ ਨ ਰਾਜਾ ਪਾਵੈ ॥੧੧॥",
      "transliteration": "moorakh baat na raajaa paavai ||11||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਮੂਰਖ ਰਾਜਾ (ਅਸਲੀ) ਗੱਲ ਨੂੰ ਸਮਝ ਨਾ ਸਕਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "मूरख बात न राजा पावै ॥११॥",
      "sourceLineId": "130953",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਇਹ ਛਲ ਸਾਥ ਜਾਰ ਭਜਿ ਗਯੋ ॥",
      "transliteration": "eeh chhal saath jaar bhaj gayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਛਲ ਕਰ ਕੇ ਯਾਰ (ਮਛਿੰਦ੍ਰ) ਭਜ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "इह छल साथ जार भजि गयो ॥",
      "sourceLineId": "130954",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਤਿ ਬਿਸਮੈ ਰਾਜਾ ਕੌ ਭਯੋ ॥",
      "transliteration": "at bisamai raajaa kau bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਬਹੁਤ ਹੈਰਾਨੀ ਹੋਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "अति बिसमै राजा कौ भयो ॥",
      "sourceLineId": "130955",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਰਾਜਾ ਢਿਗ ਆਈ ॥",
      "transliteration": "tab raanee raajaa ddig aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਰਾਜੇ ਕੋਲ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "तब रानी राजा ढिग आई ॥",
      "sourceLineId": "130956",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੋਰਿ ਹਾਥ ਅਸ ਬਿਨੈ ਸੁਨਾਈ ॥੧੨॥",
      "transliteration": "jor haath as binai sunaiee ||12||",
      "translation": "",
      "punjabiViakhya": "ਹੱਥ ਜੋੜ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਬੇਨਤੀ ਕਰਨ ਲਗੀ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "जोरि हाथ अस बिनै सुनाई ॥१२॥",
      "sourceLineId": "130957",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਿਨ ਨ੍ਰਿਪ ਰਾਜ ਆਪਨਾ ਤ੍ਯਾਗਾ ॥",
      "transliteration": "jin nirap raaj aapanaa tayaagaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਰਾਜੇ ਨੇ ਯੋਗ ਸਾਧਨਾ ਵਿਚ ਪੂਰੀ ਤਰ੍ਰਹਾ ਮਗਨ ਹੋਣ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "जिन नृप राज आपना त्यागा ॥",
      "sourceLineId": "130958",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜੋਗ ਕਰਨ ਕੇ ਰਸ ਅਨੁਰਾਗਾ ॥",
      "transliteration": "jog karan ke ras anuraagaa ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣਾ ਰਾਜ ਤਿਆਗ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "जोग करन के रस अनुरागा ॥",
      "sourceLineId": "130959",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੋ ਤੇਰੀ ਪਰਵਾਹਿ ਨ ਰਾਖੈ ॥",
      "transliteration": "so teree paravaeh na raakhai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਤੇਰੀ ਪਰਵਾਹ ਨਹੀਂ ਰਖਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "सो तेरी परवाहि न राखै ॥",
      "sourceLineId": "130960",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਇਮਿ ਰਾਨੀ ਰਾਜਾ ਤਨ ਭਾਖੈ ॥੧੩॥",
      "transliteration": "eim raanee raajaa tan bhaakhai ||13||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਰਾਣੀ ਨੇ ਰਾਜੇ ਨੂੰ ਕਿਹਾ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "इमि रानी राजा तन भाखै ॥१३॥",
      "sourceLineId": "130961",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਤਿ ਸਤਿ ਤਬ ਰਾਜ ਬਖਾਨਾ ॥",
      "transliteration": "sat sat tab raaj bakhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜੇ ਨੇ 'ਸਤਿ ਸਤਿ' ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "सति सति तब राज बखाना ॥",
      "sourceLineId": "130962",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਾ ਕੋ ਦਰਸ ਸਫਲ ਕਰਿ ਮਾਨਾ ॥",
      "transliteration": "taa ko dharas safal kar maanaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੇ ਦਰਸ਼ਨ ਨੂੰ ਸਫਲਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "ता को दरस सफल करि माना ॥",
      "sourceLineId": "130963",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਜੜ ਕਛੂ ਨ ਪਾਯੋ ॥",
      "transliteration": "bhedh abhedh jaR kachhoo na paayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮੂਰਖ ਨੇ ਭੇਦ ਅਭੇਦ ਕੁਝ ਨਾ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद जड़ कछू न पायो ॥",
      "sourceLineId": "130964",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤ੍ਰਿਯ ਸੰਗ ਚੌਗੁਨ ਨੇਹ ਬਢਾਯੋ ॥੧੪॥੧॥",
      "transliteration": "tiray sa(n)g chauagun neh baddaayo ||14||1||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸਤਰੀ (ਰਾਣੀ) ਨਾਲ ਚਾਰ ਗੁਣਾ ਅਧਿਕ ਪਿਆਰ ਕਰਨ ਲਗਾ ॥੧੪॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "तृय संग चौगुन नेह बढायो ॥१४॥१॥",
      "sourceLineId": "130965",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਪਚਹਤਰਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੭੫॥੫੩੧੬॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau pachahatar charitr samaapatam sat subham sat ||275||5316||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੭੫ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੭੫॥੫੩੧੬॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ पचहतरि चरित्र समापतम सतु सुभम सतु ॥२७५॥५३१६॥अफजूँ॥",
      "sourceLineId": "130966",
      "sourceShabadId": "12426",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130967",
      "sourceShabadId": "12427",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੰਕ੍ਰਾਵਤੀ ਨਗਰ ਇਕ ਰਾਜਤ ॥",
      "transliteration": "sa(n)kraavatee nagar ik raajat ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਕ੍ਰਾਵਤੀ ਨਾ ਦਾ ਇਕ ਨਗਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "संक्रावती नगर इक राजत ॥",
      "sourceLineId": "130968",
      "sourceShabadId": "12427",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਨੁ ਸੰਕਰ ਕੇ ਲੋਕ ਬਿਰਾਜਤ ॥",
      "transliteration": "jan sa(n)kar ke lok biraajat ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸ਼ੰਕਰ ਦਾ ਹੀ ਲੋਕ ਸ਼ੋਭਦਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "जनु संकर के लोक बिराजत ॥",
      "sourceLineId": "130969",
      "sourceShabadId": "12427",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੰਕਰ ਸੈਨ ਤਹਾ ਕੋ ਰਾਜਾ ॥",
      "transliteration": "sa(n)kar sain tahaa ko raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਕਰ ਸੈਨ ਉਥੋਂ ਦਾ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "संकर सैन तहा को राजा ॥",
      "sourceLineId": "130970",
      "sourceShabadId": "12427",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਾ ਸਮ ਦੁਤਿਯ ਨ ਬਿਧਨਾ ਸਾਜਾ ॥੧॥",
      "transliteration": "jaa sam dhutiy na bidhanaa saajaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਵਿਧਾਤਾ ਨੇ ਦੂਜਾ ਨਹੀਂ ਸਿਰਜਿਆ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "जा सम दुतिय न बिधना साजा ॥१॥",
      "sourceLineId": "130971",
      "sourceShabadId": "12427",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੰਕਰ ਦੇ ਤਾ ਕੀ ਬਰ ਨਾਰੀ ॥",
      "transliteration": "sa(n)kar dhe taa kee bar naaree ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਕਰ ਦੇ (ਦੇਈ) ਉਸ ਦੀ ਸੁੰਦਰ ਇਸਤਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "संकर दे ता की बर नारी ॥",
      "sourceLineId": "130972",
      "sourceShabadId": "12427",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਨੁਕ ਆਪੁ ਜਗਦੀਸ ਸਵਾਰੀ ॥",
      "transliteration": "januk aap jagadhees savaaree ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਜਗਦੀਸ਼ ਨੇ ਆਪ ਸੰਵਾਰੀ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "जनुक आपु जगदीस सवारी ॥",
      "sourceLineId": "130973",
      "sourceShabadId": "12427",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰੁਦ੍ਰ ਮਤੀ ਦੁਹਿਤਾ ਤਿਹ ਸੋਹੈ ॥",
      "transliteration": "rudhr matee dhuhitaa teh sohai ||",
      "translation": "",
      "punjabiViakhya": "ਰੁਦ੍ਰ ਮਤੀ ਨਾ ਦੀ ਉਨ੍ਰਹਾ ਦੀ ਪੁੱਤਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "रुद्र मती दुहिता तिह सोहै ॥",
      "sourceLineId": "130974",
      "sourceShabadId": "12427",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੁਰ ਨਰ ਨਾਗ ਅਸੁਰ ਮਨ ਮੋਹੈ ॥੨॥",
      "transliteration": "sur nar naag asur man mohai ||2||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਦੇਵਤਿਆਂ, ਦੈਂਤਾ, ਮਨੁੱਖਾ ਅਤੇ ਨਾਗਾ ਦਾ ਮਨ ਮੋਹੰਦੀ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "सुर नर नाग असुर मन मोहै ॥२॥",
      "sourceLineId": "130975",
      "sourceShabadId": "12427",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਹਾ ਛਬੀਲ ਦਾਸ ਥੋ ਛਤ੍ਰੀ ॥",
      "transliteration": "tahaa chhabeel dhaas tho chhatree ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ (ਇਕ) ਛਬੀਲ ਦਾਸ ਨਾ ਦਾ ਛਤ੍ਰੀ ਰਹਿੰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "तहा छबील दास थो छत्री ॥",
      "sourceLineId": "130976",
      "sourceShabadId": "12427",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰੂਪਵਾਨ ਛਬਿ ਮਾਨ ਅਤਿ ਅਤ੍ਰੀ ॥",
      "transliteration": "roopavaan chhab maan at atree ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਬਹੁਤ ਰੂਪਵਾਨ ਅਤੇ ਸੁੰਦਰ ਛਬੀ ਵਾਲਾ ਅਸਤ੍ਰਧਾਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "रूपवान छबि मान अति अत्री ॥",
      "sourceLineId": "130977",
      "sourceShabadId": "12427",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1211_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਾ ਪਰ ਅਟਕ ਕੁਅਰਿ ਕੀ ਭਈ ॥",
      "transliteration": "taa par aTak kuar kee bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਉਤੇ ਰਾਜ ਕੁਮਾਰੀ ਮੋਹਿਤ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1211,
      "hindi": "",
      "hindiTransliteration": "ता पर अटक कुअरि की भई ॥",
      "sourceLineId": "130978",
      "sourceShabadId": "12427",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
