{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1212,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1212_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਠ ਟੂਕ ਵਾ ਪਰ ਹ੍ਵੈ ਗਈ ॥੩॥",
      "transliteration": "aaTh Took vaa par havai giee ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅੱਠ ਟੋਟੇ ਹੋ ਕੇ ਨਿਛਾਵਰ ਹੋ ਗਈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "आठ टूक वा पर ह्वै गई ॥३॥",
      "sourceLineId": "130979",
      "sourceShabadId": "12427",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "130980",
      "sourceShabadId": "12428",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਲਗਨ ਨਿਗੋਡੀ ਲਗਿ ਗਈ ਛੁਟਿਤ ਛੁਟਾਈ ਨਾਹਿ ॥",
      "transliteration": "lagan nigoddee lag giee chhuTit chhuTaiee naeh ||",
      "translation": "",
      "punjabiViakhya": "ਭੈੜੀ ਪ੍ਰੀਤ (ਜੋ ਇਕ ਵਾਰ) ਲਗ ਗਈ, (ਉਹ ਫਿਰ) ਛਡਿਆਂ ਛਡੀ ਨਹੀਂ ਜਾ ਸਕਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "लगन निगोडी लगि गई छुटित छुटाई नाहि ॥",
      "sourceLineId": "130981",
      "sourceShabadId": "12428",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਤ ਭਈ ਮਨੁ ਮਦ ਪੀਆ ਮੋਹਿ ਰਹੀ ਮਨ ਮਾਹਿ ॥੪॥",
      "transliteration": "mat bhiee man madh peeaa moh rahee man maeh ||4||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮਸਤ ਹੋ ਗਈ ਮਾਨੋ ਸ਼ਰਾਬ ਪੀਤੀ ਹੋਵੇ ਅਤੇ ਮਨ ਵਿਚ ਮੋਹੀ ਗਈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "मत भई मनु मद पीआ मोहि रही मन माहि ॥४॥",
      "sourceLineId": "130982",
      "sourceShabadId": "12428",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130983",
      "sourceShabadId": "12429",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਏਕ ਸਹਚਰੀ ਤਹਾ ਪਠਾਈ ॥",
      "transliteration": "ek sahacharee tahaa paThaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਦਾਸੀ ਉਥੇ (ਯਾਰ ਪਾਸ) ਭੇਜੀ",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "एक सहचरी तहा पठाई ॥",
      "sourceLineId": "130984",
      "sourceShabadId": "12429",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚਿਤ ਜੁ ਹੁਤੀ ਕਹਿ ਤਾਹਿ ਸੁਨਾਈ ॥",
      "transliteration": "chit ju hutee keh taeh sunaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜੋ (ਗੱਲ ਉਸ ਦੇ) ਮਨ ਵਿਚ ਸੀ, ਉਸ ਨੂੰ ਦਸ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "चित जु हुती कहि ताहि सुनाई ॥",
      "sourceLineId": "130985",
      "sourceShabadId": "12429",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੋ ਚਲਿ ਸਖੀ ਸਜਨ ਪਹਿ ਗਈ ॥",
      "transliteration": "so chal sakhee sajan peh giee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸਖੀ ਚਲ ਕੇ ਯਾਰ ਪਾਸ ਪਹੁੰਚੀ",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "सो चलि सखी सजन पहि गई ॥",
      "sourceLineId": "130986",
      "sourceShabadId": "12429",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਤਾਹਿ ਪ੍ਰਬੋਧਤ ਭਈ ॥੫॥",
      "transliteration": "bahu bidh taeh prabodhat bhiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਤਰ੍ਰਹਾ ਨਾਲ ਉਸ ਨੂੰ ਸਮਝਾਉਣ ਲਗੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि ताहि प्रबोधत भई ॥५॥",
      "sourceLineId": "130987",
      "sourceShabadId": "12429",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "130988",
      "sourceShabadId": "12430",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਬੈ ਛਬੀਲੋ ਛੈਲ ਤਹਾ ਚਲਿ ਆਇਯੋ ॥",
      "transliteration": "tabai chhabeelo chhail tahaa chal aaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਹ ਸੁੰਦਰ (ਛਬੀਲ ਦਾਸ) ਨੌਜਵਾਨ ਉਥੇ ਚਲ ਕੇ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "तबै छबीलो छैल तहा चलि आइयो ॥",
      "sourceLineId": "130989",
      "sourceShabadId": "12430",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਮਿਯੋ ਤਰੁਨ ਬਹੁ ਭਾਤਿ ਕੁਅਰਿ ਸੁਖ ਪਾਇਯੋ ॥",
      "transliteration": "ramiyo tarun bahu bhaat kuar sukh paiyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਯੁਵਕ ਨਾਲ ਕਈ ਤਰ੍ਰਹਾ ਨਾਲ ਸੰਯੋਗ ਕਰ ਕੇ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਬਹੁਤ ਸੁਖ ਪ੍ਰਾਪਤ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "रमियो तरुन बहु भाति कुअरि सुख पाइयो ॥",
      "sourceLineId": "130990",
      "sourceShabadId": "12430",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਲਪਟਿ ਲਪਟਿ ਤਰ ਜਾਇ ਪਿਯਰਵਹਿ ਭੁਜਨ ਭਰਿ ॥",
      "transliteration": "lapaT lapaT tar jai piyaraveh bhujan bhar ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਪ੍ਰੀਤਮ ਨੂੰ ਭੁਜਾਵਾ ਵਿਚ ਲੈ ਕੇ ਬਹੁਤ ਲਿਪਟ ਰਹੀ ਸੀ (ਅਤੇ ਛਬੀਲ ਦਾਸ ਨੇ ਵੀ ਉਸ ਨੂੰ)",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "लपटि लपटि तर जाइ पियरवहि भुजन भरि ॥",
      "sourceLineId": "130991",
      "sourceShabadId": "12430",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹੋ ਦ੍ਰਿੜ ਆਸਨ ਦੈ ਰਹਿਯੋ ਨ ਇਤ ਉਤ ਜਾਤਿ ਟਰਿ ॥੬॥",
      "transliteration": "ho dhiraR aasan dhai rahiyo na it ut jaat Tar ||6||",
      "translation": "",
      "punjabiViakhya": "ਦ੍ਰਿੜ੍ਰਹਤਾ ਪੂਰਵਕ ਆਸਣ ਦਿੱਤਾ ਹੋਇਆ ਸੀ ਅਤੇ ਇਧਰ ਉਧਰ ਹਿਲਣ ਨਹੀਂ ਦਿੰਦਾ ਸੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "हो दृड़ आसन दै रहियो न इत उत जाति टरि ॥६॥",
      "sourceLineId": "130992",
      "sourceShabadId": "12430",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "130993",
      "sourceShabadId": "12431",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਏਕ ਸੁਘਰ ਦੂਜੇ ਤਰੁਨਿ ਤ੍ਰਿਤੀਏ ਸੁੰਦਰ ਮੀਤ ॥",
      "transliteration": "ek sughar dhooje tarun tirate'ee su(n)dhar meet ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਮਿਤਰ ਇਕ ਸੁਘੜ, ਦੂਜਾ ਜਵਾਨ ਅਤੇ ਤੀਜਾ ਸੁੰਦਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "एक सुघर दूजे तरुनि तृतीए सुँदर मीत ॥",
      "sourceLineId": "130994",
      "sourceShabadId": "12431",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਸਿਯੋ ਰਹਤ ਨਿਸ ਦਿਨ ਸਦਾ ਪਲ ਪਲ ਚਿਤ ਜਿਮਿ ਚੀਤਿ ॥੭॥",
      "transliteration": "basiyo rahat nis dhin sadhaa pal pal chit jim cheet ||7||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸਦਾ ਰਾਤ ਦਿਨ ਪਲ ਪਲ ਉਸ ਦੇ ਚਿਤ ਵਿਚ ਵਸਿਆ ਰਹਿੰਦਾ ਸੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "बसियो रहत निस दिन सदा पल पल चित जिमि चीति ॥७॥",
      "sourceLineId": "130995",
      "sourceShabadId": "12431",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "130996",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਇਕ ਦਿਨ ਮਿਤਿ ਇਮਿ ਬਚਨ ਬਖਾਨਾ ॥",
      "transliteration": "eik dhin mit im bachan bakhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਮਿਤਰ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "इक दिन मिति इमि बचन बखाना ॥",
      "sourceLineId": "130997",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਵ ਪਿਤ ਕੇ ਹੌ ਤ੍ਰਾਸ ਤ੍ਰਸਾਨਾ ॥",
      "transliteration": "tav pit ke hau traas trasaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਰੇ ਪਿਤਾ ਦੇ ਡਰ ਕਰ ਕੇ (ਮੈਂ) ਬਹੁਤ ਡਰਿਆ ਹੋਇਆ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "तव पित के हौ त्रास त्रसाना ॥",
      "sourceLineId": "130998",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜੌ ਤੁਹਿ ਭਜਤ ਨ੍ਰਿਪਤਿ ਮੁਹਿ ਪਾਵੈ ॥",
      "transliteration": "jau tuh bhajat nirapat muh paavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੇਰੇ ਨਾਲ ਸੰਯੋਗ ਕਰਦਿਆਂ ਰਾਜਾ ਮੈਨੂੰ ਵੇਖ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "जौ तुहि भजत नृपति मुहि पावै ॥",
      "sourceLineId": "130999",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪਕਰਿ ਕਾਲ ਕੇ ਧਾਮ ਪਠਾਵੈ ॥੮॥",
      "transliteration": "pakar kaal ke dhaam paThaavai ||8||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਪਕੜ ਕੇ ਯਮਲੋਕ ਭੇਜ ਦੇਵੇਗਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "पकरि काल के धाम पठावै ॥८॥",
      "sourceLineId": "131000",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਿਹਸਿ ਕੁਅਰਿ ਅਸ ਤਾਹਿ ਬਖਾਨਾ ॥",
      "transliteration": "bihas kuar as taeh bakhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਹਸ ਕੇ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "बिहसि कुअरि अस ताहि बखाना ॥",
      "sourceLineId": "131001",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤੈ ਇਸਤ੍ਰਿਨ ਕੇ ਚਰਿਤ ਨ ਜਾਨਾ ॥",
      "transliteration": "tai isatiran ke charit na jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਇਸਤਰੀਆਂ ਦੇ ਚਰਿਤ੍ਰ ਨੂੰ ਨਹੀਂ ਜਾਣਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "तै इसतृन के चरित न जाना ॥",
      "sourceLineId": "131002",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪੁਰਖ ਭੇਖ ਤੁਹਿ ਸੇਜ ਬੁਲਾਊ ॥",
      "transliteration": "purakh bhekh tuh sej bulaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਤੈਨੂੰ ਪੁਰਸ਼ ਭੇਸ ਵਿਚ ਸੇਜ ਉਤੇ ਬੁਲਾਵਾਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "पुरख भेख तुहि सेज बुलाऊ ॥",
      "sourceLineId": "131003",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤੌ ਮੈ ਤੁਮਰੀ ਯਾਰ ਕਹਾਊ ॥੯॥",
      "transliteration": "tau mai tumaree yaar kahaauoo ||9||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਮੈਂ ਤੇਰੀ ਯਾਰ ਅਖਵਾਵਾਗੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "तौ मै तुमरी यार कहाऊ ॥९॥",
      "sourceLineId": "131004",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰੋਮਨਾਸਨੀ ਤਾਹਿ ਲਗਾਈ ॥",
      "transliteration": "romanaasanee taeh lagaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਯਾਰ) ਨੂੰ ਰੋਮ ਨਾਸ ਕਰਨ ਵਾਲਾ (ਤੇਲ) ਲਗਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "रोमनासनी ताहि लगाई ॥",
      "sourceLineId": "131005",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਕਲ ਸਮਸ ਤਿਹ ਦੂਰਿ ਕਰਾਈ ॥",
      "transliteration": "sakal samas teh dhoor karaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੀ ਦਾੜ੍ਰਹੀ ਮੁੱਛਾ (ਦੇ ਸਾਰੇ ਵਾਲ) ਸਾਫ਼ ਕਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "सकल समस तिह दूरि कराई ॥",
      "sourceLineId": "131006",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਰ ਮਹਿ ਤਾਹਿ ਤੰਬੂਰਾ ਦੀਯਾ ॥",
      "transliteration": "kar meh taeh ta(n)booraa dheeyaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਹੱਥ ਵਿਚ ਤੂੰਬੀ ਦੇ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "कर महि ताहि तंबूरा दीया ॥",
      "sourceLineId": "131007",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗਾਇਨ ਭੇਸ ਸਜਨ ਕੋ ਕੀਯਾ ॥੧੦॥",
      "transliteration": "gain bhes sajan ko keeyaa ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਿਤਰ ਦਾ (ਇਕ) ਗਵੈਣ ਵਾਲਾ ਰੂਪ ਕਰ ਦਿੱਤਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "गाइन भेस सजन को कीया ॥१०॥",
      "sourceLineId": "131008",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪਿਤਿ ਬੈਠੇ ਤਿਹ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "transliteration": "pit baiThe teh bol paThaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ ਉਸ ਨੂੰ ਉਥੇ) ਬੁਲਵਾ ਲਿਆ, ਜਿਥੇ ਪਿਤਾ ਬੈਠਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "पिति बैठे तिह बोलि पठायो ॥",
      "sourceLineId": "131009",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਲੇ ਭਲੇ ਗੀਤਾਨ ਗਵਾਯੋ ॥",
      "transliteration": "bhale bhale geetaan gavaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਗਵੈਣ) ਤੋਂ ਚੰਗੇ ਚੰਗੇ ਗੀਤ ਗਵਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "भले भले गीतान गवायो ॥",
      "sourceLineId": "131010",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੁਨਿ ਸੁਨਿ ਨਾਦ ਰੀਝਿ ਨ੍ਰਿਪ ਰਹਿਯੋ ॥",
      "transliteration": "sun sun naadh reejh nirap rahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਸੰਗੀਤ ਸੁਣ ਕੇ ਰਾਜਾ ਬਹੁਤ ਰੀਝ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "सुनि सुनि नाद रीझि नृप रहियो ॥",
      "sourceLineId": "131011",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭਲੀ ਭਲੀ ਗਾਇਨ ਇਹ ਕਹਿਯੋ ॥੧੧॥",
      "transliteration": "bhalee bhalee gain ieh kahiyo ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਗਵੈਣ ਨੂੰ 'ਚੰਗਾ ਚੰਗਾ' ਕਿਹਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "भली भली गाइन इह कहियो ॥११॥",
      "sourceLineId": "131012",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੰਕਰ ਦੇ ਇਹ ਭਾਤਿ ਉਚਾਰੀ ॥",
      "transliteration": "sa(n)kar dhe ieh bhaat uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਕਰ ਦੇਈ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "संकर दे इह भाति उचारी ॥",
      "sourceLineId": "131013",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੁਨ ਗਾਇਨ ਤੈ ਬਾਤ ਹਮਾਰੀ ॥",
      "transliteration": "sun gain tai baat hamaaree ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਗਵੈਣ! ਤੂੰ ਮੇਰੀ (ਇਕ) ਗੱਲ ਸੁਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "सुन गाइन तै बात हमारी ॥",
      "sourceLineId": "131014",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪੁਰਖ ਭੇਸ ਧਰਿ ਤੁਮ ਨਿਤਿ ਐਯਹੁ ॥",
      "transliteration": "purakh bhes dhar tum nit aaiyahu ||",
      "translation": "",
      "punjabiViakhya": "ਤੂੰ ਪੁਰਸ਼ ਦਾ ਭੇਸ ਧਾਰ ਕੇ ਨਿੱਤ ਇਥੇ ਆਇਆ ਕਰ",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "पुरख भेस धरि तुम निति ऐयहु ॥",
      "sourceLineId": "131015",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਇਹ ਠਾ ਗੀਤਿ ਮਧੁਰਿ ਧੁਨਿ ਗੈਯਹੁ ॥੧੨॥",
      "transliteration": "eeh Thaa geet madhur dhun gaiyahu ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਥੇ ਮਿਠੀ ਧੁਨ ਵਾਲੇ ਗੀਤ ਗਾਇਆ ਕਰ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "इह ठा गीति मधुरि धुनि गैयहु ॥१२॥",
      "sourceLineId": "131016",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਯੌ ਸੁਨਿ ਪੁਰਖ ਭੇਸ ਤਿਨ ਧਰਾ ॥",
      "transliteration": "yau sun purakh bhes tin dharaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਸੁਣ ਕੇ ਉਸ ਨੇ ਪੁਰਸ਼ ਦਾ ਭੇਸ ਧਾਰਨ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "यौ सुनि पुरख भेस तिन धरा ॥",
      "sourceLineId": "131017",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪ੍ਰਾਚੀ ਦਿਸਾ ਚਾਦ ਜਨ ਚਰਾ ॥",
      "transliteration": "praachee dhisaa chaadh jan charaa ||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਪੂਰਬ ਦਿਸ਼ਾ ਵਿਚ ਚੰਨ ਚੜ੍ਰਹਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "प्राची दिसा चाद जन चरा ॥",
      "sourceLineId": "131018",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਕਲ ਲੋਗ ਇਸਤ੍ਰੀ ਤਿਹ ਜਾਨੈ ॥",
      "transliteration": "sakal log isatree teh jaanai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਲੋਕ ਉਸ ਨੂੰ ਇਸਤਰੀ ਸਮਝਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "सकल लोग इसत्री तिह जानै ॥",
      "sourceLineId": "131019",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰ ਨ ਮੂੜ ਪਛਾਨੈ ॥੧੩॥",
      "transliteration": "tirayaa charitr na mooR pachhaanai ||13||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਮੂਰਖ ਇਸਤਰੀ ਚਰਿਤ੍ਰ ਨੂੰ ਨਹੀਂ ਸਮਝਦੇ ਸਨ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "तृया चरित्र न मूड़ पछानै ॥१३॥",
      "sourceLineId": "131020",
      "sourceShabadId": "12432",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "131021",
      "sourceShabadId": "12433",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮਿਤ੍ਰ ਪੁਰਖ ਕੌ ਭੇਸ ਧਰੇ ਨਿਤ ਆਵਈ ॥",
      "transliteration": "mitr purakh kau bhes dhare nit aaviee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਮਿਤਰ ਪੁਰਸ਼ ਦਾ ਭੇਸ ਧਾਰ ਕੇ ਆਉਾਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "मित्र पुरख कौ भेस धरे नित आवई ॥",
      "sourceLineId": "131022",
      "sourceShabadId": "12433",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਆਨ ਕੁਅਰਿ ਸੌ ਕਾਮ ਕਲੋਲ ਕਮਾਵਈ ॥",
      "transliteration": "aan kuar sau kaam kalol kamaaviee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆ ਕੇ ਰਾਜ ਕੁਮਾਰੀ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "आन कुअरि सौ काम कलोल कमावई ॥",
      "sourceLineId": "131023",
      "sourceShabadId": "12433",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕੋਊ ਨ ਤਾ ਕਹ ਰੋਕਤ ਗਾਇਨ ਜਾਨਿ ਕੈ ॥",
      "transliteration": "kouoo na taa keh rokat gain jaan kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਗਵੈਣ ਸਮਝ ਕੇ ਕੋਈ ਵੀ ਨਹੀਂ ਰੋਕਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "कोऊ न ता कह रोकत गाइन जानि कै ॥",
      "sourceLineId": "131024",
      "sourceShabadId": "12433",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹੋ ਤ੍ਰਿਯ ਚਰਿਤ੍ਰ ਕਹ ਮੂੜ ਨ ਸਕਹਿ ਪਛਾਨਿ ਕੈ ॥੧੪॥",
      "transliteration": "ho tiray charitr keh mooR na sakeh pachhaan kai ||14||",
      "translation": "",
      "punjabiViakhya": "(ਕੋਈ ਵੀ) ਮੂਰਖ ਇਸਤਰੀ ਦੇ ਚਰਿਤ੍ਰ ਨੂੰ ਨਹੀਂ ਸਮਝਦਾ ਸੀ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "हो तृय चरित्र कह मूड़ न सकहि पछानि कै ॥१४॥",
      "sourceLineId": "131025",
      "sourceShabadId": "12433",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1212_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1212,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "131026",
      "sourceShabadId": "12434",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
