{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1213,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1213_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਇਹ ਛਲ ਸੌ ਤਾ ਸੌ ਸਦਾ ਨਿਸੁ ਦਿਨ ਕਰਤ ਬਿਹਾਰ ॥",
      "transliteration": "eeh chhal sau taa sau sadhaa nis dhin karat bihaar ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਉਹ ਉਸ (ਰਾਜ ਕੁਮਾਰੀ) ਨਾਲ ਰਾਤ ਦਿਨ ਰਮਣ ਕਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "इह छल सौ ता सौ सदा निसु दिन करत बिहार ॥",
      "sourceLineId": "131027",
      "sourceShabadId": "12434",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦਿਨ ਦੇਖਤ ਸਭ ਕੋ ਛਲੈ ਕੋਊ ਨ ਸਕੈ ਬਿਚਾਰ ॥੧੫॥",
      "transliteration": "dhin dhekhat sabh ko chhalai kouoo na sakai bichaar ||15||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦਿਨ ਵਿਚ ਹੀ ਸਭ ਦੇ ਵੇਖਦੇ ਹੋਇਆਂ ਛਲ ਜਾਦਾ ਸੀ (ਪਰ ਇਸ ਭੇਦ ਨੂੰ) ਕੋਈ ਵੀ ਵਿਚਾਰ ਨਹੀਂ ਸਕਦਾ ਸੀ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "दिन देखत सभ को छलै कोऊ न सकै बिचार ॥१५॥",
      "sourceLineId": "131028",
      "sourceShabadId": "12434",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131029",
      "sourceShabadId": "12435",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੰਕਰ ਦੇਵ ਨ ਤਾਹਿ ਪਛਾਨੈ ॥",
      "transliteration": "sa(n)kar dhev na taeh pachhaanai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ) ਸੰਕਰ ਦੇਵ ਉਸ ਨੂੰ ਨਹੀਂ ਪਛਾਣਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "संकर देव न ताहि पछानै ॥",
      "sourceLineId": "131030",
      "sourceShabadId": "12435",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੁਹਿਤਾ ਕੀ ਗਾਇਨ ਤਿਹ ਮਾਨੈ ॥",
      "transliteration": "dhuhitaa kee gain teh maanai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਪੁੱਤਰੀ ਦੀ ਗਵੈਣ ਮੰਨਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "दुहिता की गाइन तिह मानै ॥",
      "sourceLineId": "131031",
      "sourceShabadId": "12435",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਤਿ ਸ੍ਯਾਨਪ ਤੇ ਕੈਫਨ ਖਾਵੈ ॥",
      "transliteration": "at sayaanap te kaifan khaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬਹੁਤ ਸਿਆਣਪ ਨਾਲ ਨਸ਼ੇ ਕਰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "अति स्यानप ते कैफन खावै ॥",
      "sourceLineId": "131032",
      "sourceShabadId": "12435",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਹਾ ਮੂੜ ਨਿਤਿ ਮੂੰਡ ਮੁੰਡਾਵੈ ॥੧੬॥",
      "transliteration": "mahaa mooR nit moo(n)dd mu(n)ddaavai ||16||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਹਾ ਮੂਰਖ (ਰਾਜਾ) ਨਿੱਤ ਛਲਿਆ ਜਾਦਾ ਸੀ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "महा मूड़ निति मूँड मुँडावै ॥१६॥",
      "sourceLineId": "131033",
      "sourceShabadId": "12435",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਹਾ ਭਯੋ ਜੋ ਚਤੁਰ ਕਹਾਇਸਿ ॥",
      "transliteration": "kahaa bhayo jo chatur kahais ||",
      "translation": "",
      "punjabiViakhya": "ਕੀ ਹੋਇਆ (ਜੇ ਉਹ) ਚਤੁਰ ਅਖਵਾਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "कहा भयो जो चतुर कहाइसि ॥",
      "sourceLineId": "131034",
      "sourceShabadId": "12435",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭੂਲਿ ਭਾਗ ਭੌਦੂ ਨ ਚੜਾਇਸਿ ॥",
      "transliteration": "bhool bhaag bhauadhoo na chaRais ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਭੌਂਦੂ ਭੁਲ ਕੇ ਵੀ ਭੰਗ ਨਹੀਂ ਪੀਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "भूलि भाग भौदू न चड़ाइसि ॥",
      "sourceLineId": "131035",
      "sourceShabadId": "12435",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਮਲੀ ਭਲੋ ਖਤਾ ਜੁ ਨ ਖਾਵੈ ॥",
      "transliteration": "amalee bhalo khataa ju na khaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨਾਲੋਂ ਤਾ) ਅਮਲੀ ਚੰਗਾ ਹੈ ਜੋ ਗ਼ਲਤੀ (ਜਾ ਗੁਨਾਹ) ਨਹੀਂ ਕਰਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "अमली भलो खता जु न खावै ॥",
      "sourceLineId": "131036",
      "sourceShabadId": "12435",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮੂੰਡ ਮੂੰਡ ਸੋਫਿਨ ਕੋ ਜਾਵੈ ॥੧੭॥",
      "transliteration": "moo(n)dd moo(n)dd sofin ko jaavai ||17||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੋਫ਼ੀਆਂ ਨੂੰ ਠਗ ਠਗ ਲੈ ਜਾਦਾ ਹੈ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "मूँड मूँड सोफिन को जावै ॥१७॥",
      "sourceLineId": "131037",
      "sourceShabadId": "12435",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੰਕਰ ਸੈਨ ਨ੍ਰਿਪਹਿ ਅਸ ਛਲਾ ॥",
      "transliteration": "sa(n)kar sain nirapeh as chhalaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਸੰਕਰ ਸੈਨ ਰਾਜੇ ਨੂੰ ਛਲਿਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "संकर सैन नृपहि अस छला ॥",
      "sourceLineId": "131038",
      "sourceShabadId": "12435",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਹ ਕਿਯ ਚਰਿਤ ਸੰਕਰਾ ਕਲਾ ॥",
      "transliteration": "keh kiy charit sa(n)karaa kalaa ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਇਸ ਢੰਗ ਦਾ) ਸੰਕਰਾ ਕਲਾ ਨੇ ਚਰਿਤ੍ਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "कह किय चरित संकरा कला ॥",
      "sourceLineId": "131039",
      "sourceShabadId": "12435",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਿਹ ਗਾਇਨ ਕੀ ਦੁਹਿਤਾ ਗਨਿਯੋ ॥",
      "transliteration": "teh gain kee dhuhitaa ganiyo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਉਸ ਨੂੰ ਪੁੱਤਰੀ ਦੀ ਗਵੈਣ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "तिह गाइन की दुहिता गनियो ॥",
      "sourceLineId": "131040",
      "sourceShabadId": "12435",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮੂਰਖ ਭੇਦ ਅਭੇਦ ਨ ਜਨਿਯੋ ॥੧੮॥",
      "transliteration": "moorakh bhedh abhedh na janiyo ||18||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਮੂਰਖ ਨੇ (ਇਸ ਗੱਲ ਦਾ) ਭੇਦ ਅਭੇਦ ਨਾ ਸਮਝਿਆ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "मूरख भेद अभेद न जनियो ॥१८॥",
      "sourceLineId": "131041",
      "sourceShabadId": "12435",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਛਿਹਤਰਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੭੬॥੫੩੩੪॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau chhihatar charitr samaapatam sat subham sat ||276||5334||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੭੬ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੭੬॥੫੩੩੪॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ छिहतरि चरित्र समापतम सतु सुभम सतु ॥२७६॥५३३४॥अफजूँ॥",
      "sourceLineId": "131042",
      "sourceShabadId": "12435",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "131043",
      "sourceShabadId": "12436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਹਿਰ ਮੁਰਾਦਾਬਾਦ ਮੁਗਲ ਕੀ ਚੰਚਲਾ ॥",
      "transliteration": "sahir muraadhaabaadh mugal kee cha(n)chalaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਰਾਦਾਬਾਦ ਸ਼ਹਿਰ ਵਿਚ (ਇਕ) ਮੁਗ਼ਲ ਦੀ ਇਸਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "सहिर मुरादाबाद मुगल की चंचला ॥",
      "sourceLineId": "131044",
      "sourceShabadId": "12436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹੀਨ ਕਰੀ ਜਿਹ ਰੂਪ ਚੰਦ੍ਰਮਾ ਕੀ ਕਲਾ ॥",
      "transliteration": "heen karee jeh roop cha(n)dhramaa kee kalaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਚੰਦ੍ਰਮਾ ਦੀ ਕਲਾ ਦਾ ਰੂਪ ਹੀਣਾ ਕੀਤਾ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "हीन करी जिह रूप चंद्रमा की कला ॥",
      "sourceLineId": "131045",
      "sourceShabadId": "12436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰੂਪ ਮਤੀ ਤਾ ਕੇ ਸਮ ਸੋਈ ਜਾਨਿਯੈ ॥",
      "transliteration": "roop matee taa ke sam soiee jaaniyai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ ਰੂਪਵਾਨ ਉਸ ਨੂੰ ਹੀ ਸਮਝੋ",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "रूप मती ता के सम सोई जानियै ॥",
      "sourceLineId": "131046",
      "sourceShabadId": "12436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹੋ ਤਿਹ ਸਮਾਨ ਤਿਹੁ ਲੋਕ ਨ ਔਰ ਪ੍ਰਮਾਨਿਯੈ ॥੧॥",
      "transliteration": "ho teh samaan tih lok na aauar pramaaniyai ||1||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤਿੰਨਾ ਲੋਕਾ ਵਿਚ ਉਸ ਵਰਗੀ ਕੋਈ ਹੋਰ ਨਾ ਮੰਨੋ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "हो तिह समान तिहु लोक न और प्रमानियै ॥१॥",
      "sourceLineId": "131047",
      "sourceShabadId": "12436",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131048",
      "sourceShabadId": "12437",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦੂਸਰਿ ਏਕ ਤਿਸੀ ਕੀ ਨਾਰੀ ॥",
      "transliteration": "dhoosar ek tisee kee naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਮੁਗ਼ਲ) ਦੀ ਇਕ ਹੋਰ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "दूसरि एक तिसी की नारी ॥",
      "sourceLineId": "131049",
      "sourceShabadId": "12437",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਿਹ ਸਮ ਹੋਤ ਨ ਤਾਹਿ ਪਿਯਾਰੀ ॥",
      "transliteration": "teh sam hot na taeh piyaaree ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਹ ਉਸ ਨੂੰ (ਇਸ ਵਰਗੀ) ਪਿਆਰੀ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "तिह सम होत न ताहि पियारी ॥",
      "sourceLineId": "131050",
      "sourceShabadId": "12437",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਿਨ ਇਹ ਜਾਨਿ ਰੋਸ ਜਿਯ ਠਾਨੋ ॥",
      "transliteration": "tin ieh jaan ros jiy Thaano ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਹ ਗੱਲ ਜਾਣ ਕੇ ਮਨ ਵਿਚ ਰੋਸ ਭਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "तिन इह जानि रोस जिय ठानो ॥",
      "sourceLineId": "131051",
      "sourceShabadId": "12437",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਔਰ ਪੁਰਖ ਸੰਗ ਕੀਯਾ ਯਰਾਨੋ ॥੨॥",
      "transliteration": "aauar purakh sa(n)g keeyaa yaraano ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਹੋਰ ਪੁਰਸ਼ ਨਾਲ ਯਾਰਾਨਾ ਲਗਾ ਲਿਆ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "और पुरख संग कीया यरानो ॥२॥",
      "sourceLineId": "131052",
      "sourceShabadId": "12437",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "131053",
      "sourceShabadId": "12438",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜੈਸੇ ਵਾ ਤ੍ਰਿਯ ਕੀ ਹੁਤੀ ਸਵਤਿਨ ਕੀ ਅਨੁਹਾਰਿ ॥",
      "transliteration": "jaise vaa tiray kee hutee savatin kee anuhaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੋ ਜਿਹੀ ਉਸ (ਇਸਤਰੀ) ਦੀ ਸੌਂਕਣ ਦੀ ਨੁਹਾਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "जैसे वा तृय की हुती सवतिन की अनुहारि ॥",
      "sourceLineId": "131054",
      "sourceShabadId": "12438",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤੈਸੋ ਈ ਤਿਨ ਖੋਜਿ ਨਰ ਤਿਹ ਸੰਗ ਕੀਯਾ ਪîਾਰ ॥੩॥",
      "transliteration": "taiso iee tin khoj nar teh sa(n)g keeyaa paar ||3||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ ਨੁਹਾਰ ਵਾਲਾ ਇਕ ਪੁਰਸ਼ ਲਭ ਕੇ ਉਸ ਨਾਲ ਪ੍ਰੇਮ ਕਰਨ ਲਗੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "तैसो ई तिन खोजि नर तिह संग कीया पîार ॥३॥",
      "sourceLineId": "131055",
      "sourceShabadId": "12438",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131056",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤ੍ਰਿਯ ਇਕ ਦਿਨ ਤਿਹ ਧਾਮ ਬੁਲਾਇਸਿ ॥",
      "transliteration": "tiray ik dhin teh dhaam bulais ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਨੇ ਉਸ (ਯਾਰ) ਨੂੰ (ਆਪਣੇ) ਘਰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "तृय इक दिन तिह धाम बुलाइसि ॥",
      "sourceLineId": "131057",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਾਮ ਕੇਲ ਤਿਹ ਸੰਗ ਕਮਾਇਸਿ ॥",
      "transliteration": "kaam kel teh sa(n)g kamais ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "काम केल तिह संग कमाइसि ॥",
      "sourceLineId": "131058",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਵਤਿਹ ਫਾਸਿ ਡਾਰਿ ਗਰ ਮਾਰਿਯੋ ॥",
      "transliteration": "savateh faas ddaar gar maariyo ||",
      "translation": "",
      "punjabiViakhya": "ਸੌਂਕਣ ਦੇ ਗਲੇ ਵਿਚ ਫਾਹੀ ਪਾ ਕੇ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "सवतिह फासि डारि गर मारियो ॥",
      "sourceLineId": "131059",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਾਇ ਮੁਗਲ ਤਨ ਐਸ ਉਚਾਰਿਯੋ ॥੪॥",
      "transliteration": "jai mugal tan aais uchaariyo ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੁਗ਼ਲ ਪਾਸ ਜਾ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "जाइ मुगल तन ऐस उचारियो ॥४॥",
      "sourceLineId": "131060",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਦਭੁਤ ਬਾਤ ਨਾਥ ਇਕ ਭਈ ॥",
      "transliteration": "adhabhut baat naath ik bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸੁਆਮੀ! ਇਕ ਅਜੀਬ ਗੱਲ ਹੋਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "अदभुत बात नाथ इक भई ॥",
      "sourceLineId": "131061",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤੁਮਰੀ ਨਾਰ ਪੁਰਖੁ ਹ੍ਵੈ ਗਈ ॥",
      "transliteration": "tumaree naar purakh havai giee ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਹਾਡੀ ਇਸਤਰੀ ਪੁਰਸ਼ ਬਣ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "तुमरी नार पुरखु ह्वै गई ॥",
      "sourceLineId": "131062",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਐਸੀ ਬਾਤ ਸੁਨੀ ਨਹਿ ਹੇਰੀ ॥",
      "transliteration": "aaisee baat sunee neh heree ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਤੁਹਾਡੀ ਇਸਤਰੀ ਦੀ ਹਾਲਤ ਹੋਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "ऐसी बात सुनी नहि हेरी ॥",
      "sourceLineId": "131063",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੋ ਗਤਿ ਭਈ ਨਾਰਿ ਕੀ ਤੇਰੀ ॥੫॥",
      "transliteration": "jo gat bhiee naar kee teree ||5||",
      "translation": "",
      "punjabiViakhya": "ਇਹੋ ਜਿਹੀ ਗੱਲ ਨਾ ਸੁਣਨ ਵਿਚ ਆਈ ਹੈ ਅਤੇ ਨਾ ਅੱਖੀਂ ਵੇਖੀ ਹੈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "जो गति भई नारि की तेरी ॥५॥",
      "sourceLineId": "131064",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੁਨਿ ਏ ਬਚਨ ਚਕ੍ਰਿਤ ਜੜ ਭਯੋ ॥",
      "transliteration": "sun e bachan chakirat jaR bhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਮੂਰਖ (ਮੁਗ਼ਲ) ਗੱਲ ਸੁਣ ਕੇ ਹੈਰਾਨ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "सुनि ए बचन चकृत जड़ भयो ॥",
      "sourceLineId": "131065",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਉਠਿ ਤਿਹ ਆਪੁ ਬਿਲੋਕਨ ਗਯੋ ॥",
      "transliteration": "auTh teh aap bilokan gayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪ ਉਠ ਕੇ ਉਸ ਨੂੰ ਵੇਖਣ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "उठि तिह आपु बिलोकन गयो ॥",
      "sourceLineId": "131066",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਾ ਕੇ ਲਿੰਗ ਛੋਰਿ ਜੌ ਲਹਾ ॥",
      "transliteration": "taa ke li(n)g chhor jau lahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਦਾ ਲਿੰਗ (ਵਾਲਾ ਬਸਤ੍ਰ) ਖੁਲ੍ਰਹਵਾ ਕੇ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "ता के लिंग छोरि जौ लहा ॥",
      "sourceLineId": "131067",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਹਿਯੋ ਭਯੋ ਜੋ ਮੁਹਿ ਤ੍ਰਿਯ ਕਹਾ ॥੬॥",
      "transliteration": "kahiyo bhayo jo muh tiray kahaa ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਕਹਿਣ ਲਗਾ ਕਿ ਜੋ (ਇਸਤਰੀ ਨੇ) ਕਿਹਾ ਸੀ, ਉਹ ਸਹੀ ਨਿਕਲਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "कहियो भयो जो मुहि तृय कहा ॥६॥",
      "sourceLineId": "131068",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਤਿ ਚਿੰਤਾਤੁਰ ਚਿਤ ਮਹਿ ਭਯੋ ॥",
      "transliteration": "at chi(n)taatur chit meh bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਚਿਤ ਵਿਚ ਬਹੁਤ ਚਿੰਤਾਵਾਨ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "अति चिंतातुर चित महि भयो ॥",
      "sourceLineId": "131069",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬੂਡਿ ਸੋਕ ਸਾਗਰ ਮਹਿ ਗਯੋ ॥",
      "transliteration": "boodd sok saagar meh gayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੁਖ ਦੇ ਸਮੁੰਦਰ ਵਿਚ ਡੁਬ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "बूडि सोक सागर महि गयो ॥",
      "sourceLineId": "131070",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਐ ਇਲਾਹ ਤੈਂ ਇਹ ਕਸ ਕੀਨਾ ॥",
      "transliteration": "aai ilaeh tai(n) ieh kas keenaa ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗਾ) ਹੇ ਅੱਲਾਹ! ਤੂੰ ਇਹ ਕੀ ਕੀਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "ऐ इलाह तैं इह कस कीना ॥",
      "sourceLineId": "131071",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਇਸਤ੍ਰੀ ਕੌ ਮਾਨਸ ਕਰ ਦੀਨਾ ॥੭॥",
      "transliteration": "eisatree kau maanas kar dheenaa ||7||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਇਸਤਰੀ ਨੂੰ ਪੁਰਸ਼ ਬਣਾ ਦਿੱਤਾ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "इसत्री कौ मानस कर दीना ॥७॥",
      "sourceLineId": "131072",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਯਹ ਮੋ ਕੋ ਥੀ ਅਧਿਕ ਪਿਯਾਰੀ ॥",
      "transliteration": "yeh mo ko thee adhik piyaaree ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਮੈਨੂੰ ਬਹੁਤ ਪਿਆਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "यह मो को थी अधिक पियारी ॥",
      "sourceLineId": "131073",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਬ ਇਹ ਦੈਵ ਪੁਰਖ ਕਰਿ ਡਾਰੀ ॥",
      "transliteration": "ab ieh dhaiv purakh kar ddaaree ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਦੈਵ! (ਤੁਸੀਂ) ਹੁਣ ਇਸ ਨੂੰ ਪੁਰਸ਼ ਬਣਾ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "अब इह दैव पुरख करि डारी ॥",
      "sourceLineId": "131074",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਦੂਸਰ ਨਾਰਿ ਇਸੈ ਦੇ ਡਾਰੂੰ ॥",
      "transliteration": "dhoosar naar isai dhe ddaaroo(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ ਸੋਚਦਾ ਹਾ ਕਿ) ਦੂਜੀ ਇਸਤਰੀ ਇਸੇ ਨੂੰ ਦੇ ਦੇਵਾ",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "दूसर नारि इसै दे डारूँ ॥",
      "sourceLineId": "131075",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਭੇਦ ਨ ਦੂਸਰ ਪਾਸ ਉਚਾਰੂੰ ॥੮॥",
      "transliteration": "bhedh na dhoosar paas uchaaroo(n) ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਸੇ ਪਾਸ ਇਸ ਦਾ ਭੇਦ ਨਾ ਦਸਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "भेद न दूसर पास उचारूँ ॥८॥",
      "sourceLineId": "131076",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਨਿਸਚੈ ਬਾਤ ਇਹੈ ਠਹਰਈ ॥",
      "transliteration": "nisachai baat ihai Thahariee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਹ ਗੱਲ ਨਿਸਚੈ ਕਰ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "निसचै बात इहै ठहरई ॥",
      "sourceLineId": "131077",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਪਹਿਲੀ ਨਾਰਿ ਤਿਸੈ ਲੈ ਦਈ ॥",
      "transliteration": "pahilee naar tisai lai dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਹਿਲੀ ਇਸਤਰੀ ਉਸੇ ਨੂੰ ਹੀ ਦੇ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "पहिली नारि तिसै लै दई ॥",
      "sourceLineId": "131078",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਜੜ ਕਛੂ ਨ ਪਾਯੋ ॥",
      "transliteration": "bhedh abhedh jaR kachhoo na paayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮੂਰਖ ਨੇ ਭੇਦ ਅਭੇਦ ਕੁਝ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद जड़ कछू न पायो ॥",
      "sourceLineId": "131079",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਇਹ ਛਲ ਅਪਨੋ ਮੂੰਡ ਮੁੰਡਾਯੋ ॥੯॥",
      "transliteration": "eeh chhal apano moo(n)dd mu(n)ddaayo ||9||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਆਪਣੇ ਆਪ ਨੂੰ ਛਲਵਾ ਲਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "इह छल अपनो मूँड मुँडायो ॥९॥",
      "sourceLineId": "131080",
      "sourceShabadId": "12439",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "131081",
      "sourceShabadId": "12440",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਪੁਰਖ ਭਈ ਨਿਜੁ ਨਾਰਿ ਲਹਿ ਤਾਹਿ ਦਈ ਨਿਜੁ ਨਾਰਿ ॥",
      "transliteration": "purakh bhiee nij naar leh taeh dhiee nij naar ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੀ ਇਸਤਰੀ ਨੂੰ ਪੁਰਸ਼ ਬਣੀ ਹੋਈ ਵੇਖ ਕੇ ਉਸ ਨੂੰ ਆਪਣੀ (ਦੂਜੀ) ਇਸਤਰੀ ਵੀ ਦੇ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "पुरख भई निजु नारि लहि ताहि दई निजु नारि ॥",
      "sourceLineId": "131082",
      "sourceShabadId": "12440",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਕੀ ਬਾਤ ਕੌ ਸਕਾ ਨ ਮੂੜ ਬਿਚਾਰਿ ॥੧੦॥",
      "transliteration": "bhedh abhedh kee baat kau sakaa na mooR bichaar ||10||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮੂਰਖ ਭੇਦ ਅਭੇਦ ਦੀ ਗੱਲ ਨੂੰ ਸਮਝ ਨਾ ਸਕਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद की बात कौ सका न मूड़ बिचारि ॥१०॥",
      "sourceLineId": "131083",
      "sourceShabadId": "12440",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131084",
      "sourceShabadId": "12441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਇਸਤ੍ਰੀ ਪੁਰਖ ਭਈ ਠਹਿਰਾਈ ॥",
      "transliteration": "eisatree purakh bhiee Thahiraiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੂੰ ਪੁਰਸ਼ ਬਣਿਆ ਹੋਇਆ ਮੰਨ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "इसत्री पुरख भई ठहिराई ॥",
      "sourceLineId": "131085",
      "sourceShabadId": "12441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਇਸਤ੍ਰੀ ਤਾ ਕਹ ਦਈ ਬਨਾਈ ॥",
      "transliteration": "eisatree taa keh dhiee banaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਆਪਣੀ ਦੂਜੀ) ਇਸਤਰੀ ਉਸ ਨੂੰ ਸਜਾ ਕੇ ਦੇ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "इसत्री ता कह दई बनाई ॥",
      "sourceLineId": "131086",
      "sourceShabadId": "12441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਦੁਤਿਯ ਨ ਪੁਰਖਹਿ ਭੇਦ ਜਤਾਯੋ ॥",
      "transliteration": "dhutiy na purakheh bhedh jataayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਹੋਰ ਬੰਦੇ ਨੂੰ ਇਸ ਬਾਰੇ ਨਾ ਦਸਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "दुतिय न पुरखहि भेद जतायो ॥",
      "sourceLineId": "131087",
      "sourceShabadId": "12441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਇਹ ਛਲ ਅਪਨੋ ਮੂੰਡ ਮੁੰਡਾਯੋ ॥੧੧॥",
      "transliteration": "eeh chhal apano moo(n)dd mu(n)ddaayo ||11||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਆਪਣਾ ਸਿਰ ਮੁੰਨਵਾ ਲਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "इह छल अपनो मूँड मुँडायो ॥११॥",
      "sourceLineId": "131088",
      "sourceShabadId": "12441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਸਤਹਤਰਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੭੭॥੫੩੪੫॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau satahatar charitr samaapatam sat subham sat ||277||5345||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੭੭ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੭੭॥੫੩੪੫॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ सतहतरि चरित्र समापतम सतु सुभम सतु ॥२७७॥५३४५॥अफजूँ॥",
      "sourceLineId": "131089",
      "sourceShabadId": "12441",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131090",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਸਹਰ ਜਹਾਨਾਬਾਦ ਬਸਤ ਜਹ ॥",
      "transliteration": "sahar jahaanaabaadh basat jeh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਜਹਾਨਾਬਾਦ ਸ਼ਹਿਰ ਵਸਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "सहर जहानाबाद बसत जह ॥",
      "sourceLineId": "131091",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਸਾਹਿਜਹਾ ਜੂ ਰਾਜ ਕਰਤ ਤਹ ॥",
      "transliteration": "saahijahaa joo raaj karat teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਸ਼ਾਹਜਹਾਨ ਬਾਦਸ਼ਾਹ ਰਾਜ ਕਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "साहिजहा जू राज करत तह ॥",
      "sourceLineId": "131092",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਦੁਹਿਤ ਰਾਇ ਰੌਸਨਾ ਤਾ ਕੇ ॥",
      "transliteration": "dhuhit rai rauasanaa taa ke ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪੁੱਤਰੀ ਦਾ ਨਾ ਰੌਸ਼ਨਾ ਰਾਇ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "दुहित राइ रौसना ता के ॥",
      "sourceLineId": "131093",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਔਰ ਨਾਰਿ ਸਮ ਰੂਪ ਨ ਵਾ ਕੇ ॥੧॥",
      "transliteration": "aauar naar sam roop na vaa ke ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗਾ ਕਿਸੇ ਹੋਰ ਇਸਤਰੀ ਦਾ ਰੂਪ ਨਹੀਂ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "और नारि सम रूप न वा के ॥१॥",
      "sourceLineId": "131094",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਸਾਹਿਜਹਾ ਜਬ ਹੀ ਮਰਿ ਗਏ ॥",
      "transliteration": "saahijahaa jab hee mar ge ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸ਼ਾਹ ਜਹਾਨ ਮਰ ਗਿਆ ਅਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "साहिजहा जब ही मरि गए ॥",
      "sourceLineId": "131095",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਔਰੰਗ ਸਾਹ ਪਾਤਿਸਾਹ ਭਏ ॥",
      "transliteration": "aauara(n)g saeh paatisaeh bhe ||",
      "translation": "",
      "punjabiViakhya": "ਔਰੰਗਜ਼ੇਬ ਬਾਦਸ਼ਾਹ ਬਣ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "औरंग साह पातिसाह भए ॥",
      "sourceLineId": "131096",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਸੈਫਦੀਨ ਸੰਗ ਯਾ ਕੋ ਪ੍ਯਾਰਾ ॥",
      "transliteration": "saifadheen sa(n)g yaa ko payaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸੈਫ਼ਦੀਨ (ਪੀਰ) ਨਾਲ ਉਸ ਦਾ ਪਿਆਰ ਹੋ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "सैफदीन संग या को प्यारा ॥",
      "sourceLineId": "131097",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1213_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਪੀਰ ਅਪਨ ਕਰਿ ਤਾਹਿ ਬਿਚਾਰਾ ॥੨॥",
      "transliteration": "peer apan kar taeh bichaaraa ||2||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਸ ਨੂੰ ਆਪਣਾ ਪੀਰ ਕਰ ਕੇ (ਲੋਕਾ ਨੂੰ) ਦਸਿਆ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1213,
      "hindi": "",
      "hindiTransliteration": "पीर अपन करि ताहि बिचारा ॥२॥",
      "sourceLineId": "131098",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
