{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1214,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1214_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਾ ਕੇ ਸੰਗ ਰੋਸਨਾ ਰਾਈ ॥",
      "transliteration": "taa ke sa(n)g rosanaa raiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਰੌਸ਼ਨਾ ਰਾਇ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "ता के संग रोसना राई ॥",
      "sourceLineId": "131099",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਿਬਿਧ ਬਿਧਨ ਤਨ ਪ੍ਰੀਤੁਪਜਾਈ ॥",
      "transliteration": "bibidh bidhan tan preetupajaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਢੰਗਾ ਨਾਲ ਪ੍ਰੇਮ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "बिबिध बिधन तन प्रीतुपजाई ॥",
      "sourceLineId": "131100",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਿਹ ਸੰਗ ਕਮਾਯੋ ॥",
      "transliteration": "kaam bhog teh sa(n)g kamaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਕਾਮ-ਭੋਗ ਕੀਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "काम भोग तिह संग कमायो ॥",
      "sourceLineId": "131101",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਾਹਿ ਪੀਰ ਅਪਨੋ ਠਹਿਰਾਯੋ ॥੩॥",
      "transliteration": "taeh peer apano Thahiraayo ||3||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਸ ਨੂੰ ਆਪਣਾ ਪੀਰ ਦਰਸਾਇਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "ताहि पीर अपनो ठहिरायो ॥३॥",
      "sourceLineId": "131102",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਔਰੰਗ ਸਾਹ ਭੇਦ ਨਹਿ ਜਾਨੈ ॥",
      "transliteration": "aauara(n)g saeh bhedh neh jaanai ||",
      "translation": "",
      "punjabiViakhya": "ਔਰੰਗਜ਼ੇਬ (ਇਸ) ਭੇਦ ਨੂੰ ਨਹੀਂ ਜਾਣਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "औरंग साह भेद नहि जानै ॥",
      "sourceLineId": "131103",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਵਹੈ ਮੁਰੀਦ ਭਈ ਤਿਹ ਮਾਨੈ ॥",
      "transliteration": "vahai mureedh bhiee teh maanai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਹੀ ਮੰਨਦਾ ਕਿ ਉਹ (ਰੌਸ਼ਨਾਰਾ) ਉਸ ਦੀ ਮੁਰੀਦ ਹੋ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "वहै मुरीद भई तिह मानै ॥",
      "sourceLineId": "131104",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪੀਯ ਸਮੁਝਿ ਤਿਹ ਭੋਗ ਕਮਾਵੈ ॥",
      "transliteration": "peey samujh teh bhog kamaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਰੌਸ਼ਨਾਰਾ) ਉਸ ਨੂੰ ਪ੍ਰੀਤਮ ਸਮਝ ਕੇ ਭੋਗ ਕਰਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "पीय समुझि तिह भोग कमावै ॥",
      "sourceLineId": "131105",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪੀਰ ਭਾਖਿ ਸਭਹੂੰਨ ਸੁਨਾਵੈ ॥੪॥",
      "transliteration": "peer bhaakh sabhahoo(n)n sunaavai ||4||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਸਭ ਨੂੰ ਪੀਰ ਕਹਿ ਕੇ ਸੁਣਾਉਾਂਦੀ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "पीर भाखि सभहूँन सुनावै ॥४॥",
      "sourceLineId": "131106",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਇਕ ਦਿਨ ਪੀਰ ਗਯੋ ਅਪਨੇ ਘਰ ॥",
      "transliteration": "eik dhin peer gayo apane ghar ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਪੀਰ ਆਪਣੇ ਘਰ ਚਲਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "इक दिन पीर गयो अपने घर ॥",
      "sourceLineId": "131107",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਾਹਿ ਬਿਨਾ ਤਿਹ ਪਰਤ ਨ ਛਿਨ ਕਰ ॥",
      "transliteration": "taeh binaa teh parat na chhin kar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਬਿਨਾ ਉਸ ਨੂੰ ਛਿਣ ਭਰ ਵੀ (ਚੈਨ ਨ) ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "ताहि बिना तिह परत न छिन कर ॥",
      "sourceLineId": "131108",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰੋਗਨਿ ਤਨ ਅਪਨੇ ਠਹਰਾਈ ॥",
      "transliteration": "rogan tan apane Thaharaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਆਪਣੇ ਆਪ ਨੂੰ ਰੋਗੀ ਠਹਿਰਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "रोगनि तन अपने ठहराई ॥",
      "sourceLineId": "131109",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਵਾ ਪਹਿ ਬੈਠਿ ਸਾਢਨੀ ਆਈ ॥੫॥",
      "transliteration": "vaa peh baiTh saaddanee aaiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਢਨੀ ਉਤੇ ਬੈਠ ਕੇ ਉਸ ਪਾਸ ਆ ਗਈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "वा पहि बैठि साढनी आई ॥५॥",
      "sourceLineId": "131110",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਾ ਕੇ ਰਹਤ ਬਹੁਤ ਦਿਨ ਭਈ ॥",
      "transliteration": "taa ke rahat bahut dhin bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਾਸ (ਉਹ) ਬਹੁਤ ਦਿਨ ਰਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "ता के रहत बहुत दिन भई ॥",
      "sourceLineId": "131111",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਹੁਰੌ ਸਹਿਰ ਦਿਲੀ ਮਹਿ ਗਈ ॥",
      "transliteration": "bahurau sahir dhilee meh giee ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਦਿੱਲੀ ਸ਼ਹਿਰ ਵਿਚ ਆ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "बहुरौ सहिर दिली महि गई ॥",
      "sourceLineId": "131112",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਈ ਅਰੋਗਨਿ ਭਾਖਿ ਅਨਾਈ ॥",
      "transliteration": "bhiee arogan bhaakh anaiee ||",
      "translation": "",
      "punjabiViakhya": "ਆ ਕੇ (ਉਸ ਨੇ) ਦਸਿਆ ਕਿ (ਹੁਣ) ਸੁਅਸਥ ਹੋ ਗਈ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "भई अरोगनि भाखि अनाई ॥",
      "sourceLineId": "131113",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਾਤ ਭੇਦ ਕੀ ਕਿਨੂੰ ਨ ਪਾਈ ॥੬॥",
      "transliteration": "baat bhedh kee kinoo(n) na paiee ||6||",
      "translation": "",
      "punjabiViakhya": "ਪਰ (ਉਸ ਦੇ) ਭੇਦ ਦੀ ਗੱਲ ਕੋਈ ਵੀ ਸਮਝ ਨਾ ਸਕਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "बात भेद की किनूँ न पाई ॥६॥",
      "sourceLineId": "131114",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਭ੍ਰਾਤ ਭਏ ਇਹ ਭਾਤਿ ਉਚਾਰੀ ॥",
      "transliteration": "bhraat bhe ieh bhaat uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਭਰਾ (ਔਰੰਗਜ਼ੇਬ) ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "भ्रात भए इह भाति उचारी ॥",
      "sourceLineId": "131115",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰੋਗ ਬਡਾ ਪ੍ਰਭੁ ਹਰੀ ਹਮਾਰੀ ॥",
      "transliteration": "rog baddaa prabh haree hamaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਨੂੰ) ਵੱਡਾ ਰੋਗ ਸੀ, ਪਰਮਾਤਮਾ ਨੇ ਮੇਰੀ (ਬਿਮਾਰੀ) ਠੀਕ ਕਰ ਦਿੱਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "रोग बडा प्रभु हरी हमारी ॥",
      "sourceLineId": "131116",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬੈਦਨ ਅਧਿਕ ਇਨਾਮ ਦਿਲਾਯੋ ॥",
      "transliteration": "baidhan adhik inaam dhilaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਵੈਦ ਨੂੰ ਬਹੁਤ ਇਨਾਮ ਦਿਵਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "बैदन अधिक इनाम दिलायो ॥",
      "sourceLineId": "131117",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਔਰੰਗ ਪਾਯੋ ॥੭॥",
      "transliteration": "bhedh abhedh na aauara(n)g paayo ||7||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਦਾ ਭੇਦ ਅਭੇਦ ਔਰੰਗਜ਼ੇਬ ਨਾ ਪਾ ਸਕਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न औरंग पायो ॥७॥",
      "sourceLineId": "131118",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਅਠਹਤਰਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੭੮॥੫੩੫੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau aThahatar charitr samaapatam sat subham sat ||278||5352||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੭੮ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੭੮॥੫੩੫੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ अठहतरि चरित्र समापतम सतु सुभम सतु ॥२७८॥५३५२॥अफजूँ॥",
      "sourceLineId": "131119",
      "sourceShabadId": "12442",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131120",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪ੍ਰੇਮਾਵਤੀ ਨਗਰ ਇਕ ਰਾਜਤ ॥",
      "transliteration": "premaavatee nagar ik raajat ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰੇਮਾਵਤੀ ਨਾ ਦਾ ਇਕ ਨਗਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "प्रेमावती नगर इक राजत ॥",
      "sourceLineId": "131121",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪ੍ਰੇਮ ਸੈਨ ਜਹ ਨ੍ਰਿਪਤਿ ਬਿਰਾਜਤ ॥",
      "transliteration": "prem sain jeh nirapat biraajat ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਪ੍ਰੇਮ ਸੈਨ ਨਾ ਦਾ ਰਾਜਾ ਬਿਰਾਜਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "प्रेम सैन जह नृपति बिराजत ॥",
      "sourceLineId": "131122",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪ੍ਰੇਮ ਮੰਜਰੀ ਤਿਹ ਗ੍ਰਿਹ ਦਾਰਾ ॥",
      "transliteration": "prem ma(n)jaree teh gireh dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਪ੍ਰੇਮ ਮੰਜਰੀ ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "प्रेम मंजरी तिह गृह दारा ॥",
      "sourceLineId": "131123",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਾ ਸਮ ਦਿਤਿ ਨ ਅਦਿਤਿ ਕੁਮਾਰਾ ॥੧॥",
      "transliteration": "jaa sam dhit na adhit kumaaraa ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀਆਂ ਦੇਵਤਿਆਂ ਅਤੇ ਦੈਂਤਾ ਦੀਆਂ ਇਸਤਰੀਆਂ ਨਹੀਂ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "जा सम दिति न अदिति कुमारा ॥१॥",
      "sourceLineId": "131124",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਹਾ ਸਾਹੁ ਕੇ ਪੂਤ ਸੁਘਰ ਅਤਿ ॥",
      "transliteration": "tahaa saahu ke poot sughar at ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਸ਼ਾਹ ਦਾ (ਇਕ) ਬਹੁਤ ਸੁਘੜ ਪੁੱਤਰ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "तहा साहु के पूत सुघर अति ॥",
      "sourceLineId": "131125",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਾ ਸਮ ਰਾਜ ਕੁਅਰ ਨ ਕਹੂੰ ਕਤ ॥",
      "transliteration": "jaa sam raaj kuar na kahoo(n) kat ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਕਿਤੇ ਵੀ ਕੋਈ ਰਾਜ ਕੁਮਾਰ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "जा सम राज कुअर न कहूँ कत ॥",
      "sourceLineId": "131126",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਾ ਕੀ ਪ੍ਰਭਾ ਕਹਨ ਨਹਿ ਆਵੈ ॥",
      "transliteration": "jaa kee prabhaa kahan neh aavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "जा की प्रभा कहन नहि आवै ॥",
      "sourceLineId": "131127",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹੇਰੈ ਪਲਕ ਨ ਜੋਰੀ ਜਾਵੈ ॥੨॥",
      "transliteration": "herai palak na joree jaavai ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖਦਿਆਂ ਪਲਕਾ ਨਹੀਂ ਝਪਕਦੀਆਂ ਸਨ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "हेरै पलक न जोरी जावै ॥२॥",
      "sourceLineId": "131128",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਬ ਰਾਨੀ ਤਿਹ ਕੀ ਦੁਤਿ ਲਹੀ ॥",
      "transliteration": "jab raanee teh kee dhut lahee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਣੀ ਨੇ ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "जब रानी तिह की दुति लही ॥",
      "sourceLineId": "131129",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਐਸੀ ਭਾਤਿ ਚਿਤ ਮਹਿ ਕਹੀ ॥",
      "transliteration": "aaisee bhaat chit meh kahee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮਨ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਵਿਚਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "ऐसी भाति चित महि कही ॥",
      "sourceLineId": "131130",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕੈ ਇਹ ਕੇ ਸੰਗ ਭੋਗ ਕਮਾਊ ॥",
      "transliteration": "kai ieh ke sa(n)g bhog kamaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਤਾ ਮੈਂ ਇਸ ਨਾਲ ਭੋਗ ਕਰਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "कै इह के संग भोग कमाऊ ॥",
      "sourceLineId": "131131",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਤਰ ਹ੍ਵੈ ਜੋਗਨਿ ਬਨ ਜਾਊ ॥੩॥",
      "transliteration": "naatar havai jogan ban jaauoo ||3||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਜੋਗਣ ਹੋ ਕੇ ਬਨ ਨੂੰ ਚਲੀ ਜਾਵਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "नातर ह्वै जोगनि बन जाऊ ॥३॥",
      "sourceLineId": "131132",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਏਕ ਸਹਚਰੀ ਤਹਾ ਪਠਾਈ ॥",
      "transliteration": "ek sahacharee tahaa paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਕ ਦਾਸੀ ਨੂੰ ਉਥੇ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "एक सहचरी तहा पठाई ॥",
      "sourceLineId": "131133",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਾਹਿ ਪ੍ਰਬੋਧਿ ਤਹਾ ਲੈ ਆਈ ॥",
      "transliteration": "taeh prabodh tahaa lai aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸਮਝਾ ਕੇ (ਦਾਸੀ) ਉਥੇ ਲੈ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "ताहि प्रबोधि तहा लै आई ॥",
      "sourceLineId": "131134",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਨਿ ਠਨਿ ਬੈਠ ਚੰਚਲਾ ਜਹਾ ॥",
      "transliteration": "ban Than baiTh cha(n)chalaa jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਉਹ ਇਸਤਰੀ ਬਣ ਠਣ ਕੇ ਬੈਠੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "बनि ठनि बैठ चंचला जहा ॥",
      "sourceLineId": "131135",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਲੈ ਆਈ ਸਹਚਰਿ ਤਿਹ ਜਹਾ ॥੪॥",
      "transliteration": "lai aaiee sahachar teh jahaa ||4||",
      "translation": "",
      "punjabiViakhya": "ਦਾਸੀ ਉਸ ਨੂੰ ਉਥੇ ਲੈ ਆਈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "लै आई सहचरि तिह जहा ॥४॥",
      "sourceLineId": "131136",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਆਤੁਰ ਕੁਅਰਿ ਤਾਹਿ ਲਪਟਾਈ ॥",
      "transliteration": "aatur kuar taeh lapaTaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਕਾਮ ਤੋਂ) ਆਤੁਰ ਹੋਈ ਰਾਣੀ ਉਸ ਨਾਲ ਲਿਪਟ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "आतुर कुअरि ताहि लपटाई ॥",
      "sourceLineId": "131137",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਭਜ੍ਯੋ ਮਿਤ੍ਰ ਸੁਖਦਾਈ ॥",
      "transliteration": "bahu bidh bhajayo mitr sukhadhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੁਖਦਾਇਕ ਮਿਤਰ ਨਾਲ ਕਈ ਤਰ੍ਰਹਾ ਨਾਲ ਭੋਗ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि भज्यो मित्र सुखदाई ॥",
      "sourceLineId": "131138",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚਤੁਰ ਪਹਰ ਰਜਨੀ ਰਤਿ ਮਾਨੀ ॥",
      "transliteration": "chatur pahar rajanee rat maanee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਚਾਰ ਪਹਿਰ ਰਾਤ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "चतुर पहर रजनी रति मानी ॥",
      "sourceLineId": "131139",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਰਤ ਕਾਮ ਕੀ ਕੇਲ ਕਹਾਨੀ ॥੫॥",
      "transliteration": "karat kaam kee kel kahaanee ||5||",
      "translation": "",
      "punjabiViakhya": "(ਸਾਰੀ ਰਾਤ ਉਹ ਦੀ) ਕਾਮ-ਕੇਲੀ ਦੀ ਕਹਾਣੀ ਕਰਦੇ ਰਹੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "करत काम की केल कहानी ॥५॥",
      "sourceLineId": "131140",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਟਕਿ ਗਈ ਅਬਲਾ ਤਿਹ ਸੰਗਾ ॥",
      "transliteration": "aTak giee abalaa teh sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਅਬਲਾ ਉਸ ਨਾਲ ਅਟਕ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "अटकि गई अबला तिह संगा ॥",
      "sourceLineId": "131141",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰੰਗਿਤ ਭਈ ਉਹੀ ਕੇ ਰੰਗਾ ॥",
      "transliteration": "ra(n)git bhiee uhee ke ra(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸੇ ਦੇ ਰੰਗ ਵਿਚ ਰੰਗੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "रंगित भई उही के रंगा ॥",
      "sourceLineId": "131142",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਾ ਕਹ ਐਸ ਪ੍ਰਬੋਧ ਦ੍ਰਿੜਾਯੋ ॥",
      "transliteration": "taa keh aais prabodh dhiraRaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਸਮਝਾਇਆ ਅਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "ता कह ऐस प्रबोध दृड़ायो ॥",
      "sourceLineId": "131143",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਆਪੁ ਨ੍ਰਿਪਹਿ ਚਲਿ ਸੀਸ ਝੁਕਾਯੋ ॥੬॥",
      "transliteration": "aap nirapeh chal sees jhukaayo ||6||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਆਪ ਚਲ ਕੇ ਰਾਜੇ ਅਗੇ ਸਿਰ ਨਿਵਾਇਆ (ਅਰਥਾਤ ਪ੍ਰਨਾਮ ਕੀਤਾ) ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "आपु नृपहि चलि सीस झुकायो ॥६॥",
      "sourceLineId": "131144",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜੋ ਮੁਹਿ ਭਯੋ ਸੁਪਨ ਸੁਨੁ ਰਾਈ ॥",
      "transliteration": "jo muh bhayo supan sun raiee ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿਣ ਲਗੀ) ਹੇ ਰਾਜਨ! ਮੈਨੂੰ (ਇਕ) ਸੁਪਨਾ ਆਇਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "जो मुहि भयो सुपन सुनु राई ॥",
      "sourceLineId": "131145",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1214_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੋਵਤ ਰੁਦ੍ਰ ਜਗਾਇ ਪਠਾਈ ॥",
      "transliteration": "sovat rudhr jagai paThaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸੁਣੋ। (ਮੈਨੂੰ) ਸੁਤੀ ਹੋਈ ਨੂੰ ਸ਼ਿਵ ਨੇ ਜਗਾ ਕੇ (ਤੁਹਾਡੇ ਕੋਲ) ਭੇਜਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1214,
      "hindi": "",
      "hindiTransliteration": "सोवत रुद्र जगाइ पठाई ॥",
      "sourceLineId": "131146",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
