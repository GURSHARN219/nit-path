{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1215,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1215_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਠ ਬਰਸਿ ਹਮ ਸੌ ਤੁਮ ਸੋਵੌ ॥",
      "transliteration": "aaTh baras ham sau tum sovau ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ ਹੈ ਕਿ) ਤੁਸੀਂ ਅੱਠ ਸਾਲ ਮੇਰੇ ਨਾਲ ਸੌਂਵੋ",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "आठ बरसि हम सौ तुम सोवौ ॥",
      "sourceLineId": "131147",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰੈਨਿ ਦਿਵਸ ਮੋਰੇ ਗ੍ਰਿਹ ਖੋਵੌ ॥੭॥",
      "transliteration": "rain dhivas more gireh khovau ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਤ ਦਿਨ ਮੇਰੇ ਹੀ ਘਰ ਬਤੀਤ ਕਰੋ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "रैनि दिवस मोरे गृह खोवौ ॥७॥",
      "sourceLineId": "131148",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪਟੀ ਬਾਧਿ ਦ੍ਰਿਗਨ ਦੁਹੂੰ ਸੋਵੌ ॥",
      "transliteration": "paTee baadh dhiragan dhuhoo(n) sovau ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਅੱਖਾ ਉਤੇ ਪਟੀ ਬੰਨ੍ਰਹ ਕੇ ਸੌਂਵੋ",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "पटी बाधि दृगन दुहूँ सोवौ ॥",
      "sourceLineId": "131149",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਆਠ ਬਰਸਿ ਲਗਿ ਜਗਹਿ ਨ ਜੋਵੌ ॥",
      "transliteration": "aaTh baras lag jageh na jovau ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅੱਠ ਸਾਲ ਤਕ ਜਗਤ ਨੂੰ ਨਾ ਵੇਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "आठ बरसि लगि जगहि न जोवौ ॥",
      "sourceLineId": "131150",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਉਪਜੋ ਪੂਤ ਧਾਮ ਬਿਨ ਸਾਸਾ ॥",
      "transliteration": "aupajo poot dhaam bin saasaa ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਹਾਡੇ ਘਰ ਬਿਨਾ ਕਿਸੇ ਸ਼ੰਸੇ ਦਾ ਪੁੱਤਰ ਪੈਦਾ ਹੋਵੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "उपजो पूत धाम बिन सासा ॥",
      "sourceLineId": "131151",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਕਲ ਖਲਨ ਕੋ ਹ੍ਵੈ ਹੈ ਨਾਸਾ ॥੮॥",
      "transliteration": "sakal khalan ko havai hai naasaa ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਦੁਸ਼ਟਾ ਦਾ ਨਾਸ ਹੋਵੇਗਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "सकल खलन को ह्वै है नासा ॥८॥",
      "sourceLineId": "131152",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਿਲਬਿਖ ਏਕ ਨ ਤਵ ਤਨ ਰਹੈ ॥",
      "transliteration": "kilabikh ek na tav tan rahai ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਹਾਡੇ ਸ਼ਰੀਰ ਵਿਚ ਇਕ ਵੀ ਪਾਪ ਨਹੀਂ ਰਹੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "किलबिख एक न तव तन रहै ॥",
      "sourceLineId": "131153",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮੁਹਿ ਸਿਵ ਸੁਪਨ ਬਿਖੈ ਇਮਿ ਕਹੈ ॥",
      "transliteration": "muh siv supan bikhai im kahai ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਨੇ ਮੈਨੂੰ ਸੁਪਨੇ ਵਿਚ ਇੰਜ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "मुहि सिव सुपन बिखै इमि कहै ॥",
      "sourceLineId": "131154",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਪ੍ਰਮਾਨ ਧਨ ਭਰੇ ਭੰਡਾਰਾ ॥",
      "transliteration": "apramaan dhan bhare bha(n)ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਤੁਹਾਡੇ) ਭੰਡਾਰੇ ਅਸੀਮ ਧਨ ਨਾਲ ਭਰ ਜਾਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "अप्रमान धन भरे भंडारा ॥",
      "sourceLineId": "131155",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਕਲ ਕਾਜ ਸਭ ਹੋਇ ਤਿਹਾਰਾ ॥੯॥",
      "transliteration": "sakal kaaj sabh hoi tihaaraa ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੁਹਾਡੇ ਸਾਰੇ ਕੰਮ ਸੰਵਰ ਜਾਣਗੇ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "सकल काज सभ होइ तिहारा ॥९॥",
      "sourceLineId": "131156",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਾਜੈ ਸਤਿ ਇਹੀ ਦ੍ਰਿੜ ਕੀਨੀ ॥",
      "transliteration": "raajai sat ihee dhiraR keenee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਇਸ ਨੂੰ ਸਚ ਮੰਨ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "राजै सति इही दृड़ कीनी ॥",
      "sourceLineId": "131157",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪਟੀ ਬਾਧਿ ਦੁਹੂੰ ਦ੍ਰਿਗ ਲੀਨੀ ॥",
      "transliteration": "paTee baadh dhuhoo(n) dhirag leenee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਹਾ ਅੱਖਾ ਉਤੇ ਪਟ ਬੰਨ੍ਰਹ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "पटी बाधि दुहूँ दृग लीनी ॥",
      "sourceLineId": "131158",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਠ ਬਰਸ ਰਾਨੀ ਸੰਗ ਸੋਯੋ ॥",
      "transliteration": "aaTh baras raanee sa(n)g soyo ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਠ ਸਾਲ ਰਾਣੀ ਨਾਲ ਸੁਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "आठ बरस रानी संग सोयो ॥",
      "sourceLineId": "131159",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚਿਤ ਜੁ ਹੁਤੋ ਸਕਲ ਦੁਖੁ ਖੋਯੋ ॥੧੦॥",
      "transliteration": "chit ju huto sakal dhukh khoyo ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਿਤ ਵਿਚ ਜੋ ਦੁਖ ਸਨ, ਸਭ ਨਸ਼ਟ ਕਰ ਦਿੱਤੇ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "चित जु हुतो सकल दुखु खोयो ॥१०॥",
      "sourceLineId": "131160",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਆਖੈ ਬਾਧਿ ਤਹਾ ਨ੍ਰਿਪ ਸੋਵੈ ॥",
      "transliteration": "aakhai baadh tahaa nirap sovai ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਖਾ ਬੰਨ੍ਰਹ ਕੇ ਰਾਜਾ ਉਥੇ ਸੌਂਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "आखै बाधि तहा नृप सोवै ॥",
      "sourceLineId": "131161",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਆਵਤ ਜਾਤ ਨ ਕਾਹੂ ਜੋਵੈ ॥",
      "transliteration": "aavat jaat na kaahoo jovai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਉਾਂਦੇ ਜਾਉਾਂਦੇ ਕਿਸੇ ਨੂੰ ਵੀ ਨਾ ਵੇਖ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "आवत जात न काहू जोवै ॥",
      "sourceLineId": "131162",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਉਤ ਰਾਨੀ ਕਹ ਜੋ ਨਰ ਭਾਵੈ ॥",
      "transliteration": "aut raanee keh jo nar bhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਧਰ ਰਾਣੀ ਨੂੰ ਜੋ ਪੁਰਸ਼ ਚੰਗਾ ਲਗਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "उत रानी कह जो नर भावै ॥",
      "sourceLineId": "131163",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾਹਿ ਤੁਰਤ ਗ੍ਰਿਹ ਬੋਲਿ ਪਠਾਵੈ ॥੧੧॥",
      "transliteration": "taeh turat gireh bol paThaavai ||11||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਤੁਰਤ ਘਰ ਬੁਲਾ ਲੈਂਦੀ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "ताहि तुरत गृह बोलि पठावै ॥११॥",
      "sourceLineId": "131164",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਕਰੈ ਕੇਲ ਸੰਗ ਤਾ ਕੇ ॥",
      "transliteration": "bahu bidh karai kel sa(n)g taa ke ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਪੁਰਸ਼ ਉਸ (ਰਾਣੀ) ਦੇ ਮਨ ਨੂੰ ਚੰਗਾ ਲਗਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि करै केल संग ता के ॥",
      "sourceLineId": "131165",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੋ ਨਰ ਰੁਚੈ ਚਿਤ ਤ੍ਰਿਯ ਵਾ ਕੇ ॥",
      "transliteration": "jo nar ruchai chit tiray vaa ke ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਭੋਗ ਬਿਲਾਸ ਕਰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "जो नर रुचै चित तृय वा के ॥",
      "sourceLineId": "131166",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਾਤ ਕਰਤ ਪਤਿ ਸੋ ਇਤ ਜਾਵੈ ॥",
      "transliteration": "baat karat pat so it jaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਧਰ ਪਤੀ ਨਾਲ ਗੱਲਾ ਕਰਦੀ ਰਹਿੰਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "बात करत पति सो इत जावै ॥",
      "sourceLineId": "131167",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਉਤੈ ਜਾਰ ਤਰ ਪਰੀ ਠੁਕਾਵੈ ॥੧੨॥",
      "transliteration": "autai jaar tar paree Thukaavai ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਧਰ ਯਾਰ ਦੇ ਹੇਠਾ ਪਈ ਕਾਮ-ਕ੍ਰੀੜਾ ਵਿਚ ਰੁਝੀ ਰਹਿੰਦੀ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "उतै जार तर परी ठुकावै ॥१२॥",
      "sourceLineId": "131168",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜੋ ਤ੍ਰਿਯ ਚਹੈ ਵਹੈ ਤਹ ਆਵੈ ॥",
      "transliteration": "jo tiray chahai vahai teh aavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਇਸਤਰੀ ਚਾਹੁੰਦੀ, ਉਹੀ ਉਥੇ ਆਉਾਂਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "जो तृय चहै वहै तह आवै ॥",
      "sourceLineId": "131169",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਖੈਚਿ ਤਰੁਨਿ ਤਰੁ ਐਚਿ ਬਜਾਵੈ ॥",
      "transliteration": "khaich tarun tar aaich bajaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਸਤਰੀ ਨੂੰ ਹੇਠਾ ਖਿਚ ਕੇ ਚੰਗੀ ਤਰ੍ਰਹਾ ਭੋਗ ਕਰਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "खैचि तरुनि तरु ऐचि बजावै ॥",
      "sourceLineId": "131170",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਹੁ ਨਰ ਜਾ ਸੌ ਭੋਗ ਕਮਾਹੀ ॥",
      "transliteration": "bahu nar jaa sau bhog kamaahee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਬਹੁਤ ਵਿਅਕਤੀ ਭੋਗ ਕਰਨ",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "बहु नर जा सौ भोग कमाही ॥",
      "sourceLineId": "131171",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਏਕੋ ਪੂਤ ਹੋਇ ਗ੍ਰਿਹ ਨਾਹੀ ॥੧੩॥",
      "transliteration": "eko poot hoi gireh naahee ||13||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਘਰ ਇਕ ਵੀ ਪੁੱਤਰ ਨਹੀਂ ਹੁੰਦਾ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "एको पूत होइ गृह नाही ॥१३॥",
      "sourceLineId": "131172",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਿਤਕ ਦਿਨਨ ਮਹਿ ਸੁਤ ਇਕ ਜਾਯੋ ॥",
      "transliteration": "kitak dhinan meh sut ik jaayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਦਿਨਾ (ਭਾਵ ਵਰ੍ਰਹਿਆਂ) ਬਾਦ (ਰਾਣੀ ਨੇ) ਇਕ ਪੁੱਤਰ ਨੂੰ ਜਨਮ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "कितक दिनन महि सुत इक जायो ॥",
      "sourceLineId": "131173",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨ੍ਰਿਪ ਕੋ ਸਾਚ ਹਿਯੇ ਮਹਿ ਆਯੋ ॥",
      "transliteration": "nirap ko saach hiye meh aayo ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸਤਰੀ ਦੀ ਦਸੀ ਗੱਲ ਦਾ) ਰਾਜੇ ਦੇ ਮਨ ਵਿਚ ਯਕੀਨ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "नृप को साच हिये महि आयो ॥",
      "sourceLineId": "131174",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਆਗੈ ਜੋ ਤ੍ਰਿਯ ਕਹੈ ਸੁ ਮਾਨੈ ॥",
      "transliteration": "aagai jo tiray kahai su maanai ||",
      "translation": "",
      "punjabiViakhya": "ਅਗੋਂ ਜੋ ਇਸਤਰੀ ਕਹਿੰਦੀ ਸੀ, ਉਹ ਮੰਨ ਲੈਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "आगै जो तृय कहै सु मानै ॥",
      "sourceLineId": "131175",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਮੂੜ ਪਛਾਨੈ ॥੧੪॥",
      "transliteration": "bhedh abhedh na mooR pachhaanai ||14||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਮੂਰਖ ਭੇਦ ਅਭੇਦ ਦੀ ਗੱਲ ਨਹੀਂ ਸਮਝਦਾ ਸੀ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न मूड़ पछानै ॥१४॥",
      "sourceLineId": "131176",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਉਨਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੭੯॥੫੩੬੬॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau unaasee charitr samaapatam sat subham sat ||279||5366||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੭੯ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੭੯॥੫੩੬੬॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ उनासी चरित्र समापतम सतु सुभम सतु ॥२७९॥५३६६॥अफजूँ॥",
      "sourceLineId": "131177",
      "sourceShabadId": "12443",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131178",
      "sourceShabadId": "12444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਿਸਨ ਚੰਦ ਇਕ ਨ੍ਰਿਪਤ ਫਿਰੰਗਾ ॥",
      "transliteration": "bisan cha(n)dh ik nirapat fira(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਸਨ ਚੰਦ ਇਕ ਫਿਰੰਗੀ (ਦੇਸ਼) ਦਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "बिसन चंद इक नृपत फिरंगा ॥",
      "sourceLineId": "131179",
      "sourceShabadId": "12444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਾ ਕੇ ਦਿਪਤ ਅਧਿਕ ਛਬਿ ਅੰਗਾ ॥",
      "transliteration": "jaa ke dhipat adhik chhab a(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਸ਼ਰੀਰ ਉਤੇ ਸੁੰਦਰਤਾ ਬਹੁਤ ਚਮਕਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "जा के दिपत अधिक छबि अंगा ॥",
      "sourceLineId": "131180",
      "sourceShabadId": "12444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸ੍ਰੀ ਜੁਗਰਾਜ ਮੰਜਰੀ ਰਾਨੀ ॥",
      "transliteration": "sree jugaraaj ma(n)jaree raanee ||",
      "translation": "",
      "punjabiViakhya": "ਜੁਗਰਾਜ ਮੰਜਰੀ ਉਸ ਦੀ ਰਾਣੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "स्री जुगराज मंजरी रानी ॥",
      "sourceLineId": "131181",
      "sourceShabadId": "12444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੁੰਦਰਿ ਭਵਨ ਚਤੁਰਦਸ ਜਾਨੀ ॥੧॥",
      "transliteration": "su(n)dhar bhavan chaturadhas jaanee ||1||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਚੌਦਾ ਲੋਕਾ ਵਿਚ ਸੁੰਦਰ ਮੰਨੀ ਜਾਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "सुँदरि भवन चतुरदस जानी ॥१॥",
      "sourceLineId": "131182",
      "sourceShabadId": "12444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੁਕ੍ਰਿਤ ਨਾਥ ਜੋਗੀ ਇਕ ਤਹਾ ॥",
      "transliteration": "sukirat naath jogee ik tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸੁਕ੍ਰਿਤ ਨਾਥ ਜੋਗੀ (ਰਹਿੰਦਾ) ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "सुकृत नाथ जोगी इक तहा ॥",
      "sourceLineId": "131183",
      "sourceShabadId": "12444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸ੍ਰੀ ਜੁਗਰਾਜ ਮਤੀ ਤ੍ਰਿਯ ਜਹਾ ॥",
      "transliteration": "sree jugaraaj matee tiray jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਜੁਗਰਾਜ ਮਤੀ ਇਸਤਰੀ (ਰਹਿੰਦੀ) ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "स्री जुगराज मती तृय जहा ॥",
      "sourceLineId": "131184",
      "sourceShabadId": "12444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜੋਗੀ ਦ੍ਰਿਸਟਿ ਜਬੈ ਤਿਹ ਆਯੋ ॥",
      "transliteration": "jogee dhirasaT jabai teh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਜਦ ਜੋਗੀ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "जोगी दृसटि जबै तिह आयो ॥",
      "sourceLineId": "131185",
      "sourceShabadId": "12444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਦਨ ਚੰਚਲੈ ਬੋਲਿ ਪਠਾਯੋ ॥੨॥",
      "transliteration": "sadhan cha(n)chalai bol paThaayo ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਚੰਚਲਾ ਨੇ ਉਸ ਨੂੰ ਘਰ ਬੁਲਾ ਲਿਆ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "सदन चंचलै बोलि पठायो ॥२॥",
      "sourceLineId": "131186",
      "sourceShabadId": "12444",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "131187",
      "sourceShabadId": "12445",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਾ ਸੋ ਕਿਯੋ ਹ੍ਰਿਦੈ ਹਰਖ ਉਪਜਾਇ ॥",
      "transliteration": "kaam bhog taa so kiyo hiradhai harakh upajai ||",
      "translation": "",
      "punjabiViakhya": "ਹਿਰਦੇ ਵਿਚ ਪ੍ਰਸੰਨ ਹੋ ਕੇ ਉਸ ਨਾਲ ਕਾਮ-ਭੋਗ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "काम भोग ता सो कियो हृदै हरख उपजाइ ॥",
      "sourceLineId": "131188",
      "sourceShabadId": "12445",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪਕਰਿ ਭੁਜਨ ਆਸਨ ਤਰੇ ਜਾਤ ਭਈ ਲਪਟਾਇ ॥੩॥",
      "transliteration": "pakar bhujan aasan tare jaat bhiee lapaTai ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਦੀਆਂ) ਭੁਜਾਵਾ ਨੂੰ ਪਕੜ ਕੇ ਆਸਣ ਹੇਠਾ ਲਿਪਟ ਗਈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "पकरि भुजन आसन तरे जात भई लपटाइ ॥३॥",
      "sourceLineId": "131189",
      "sourceShabadId": "12445",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131190",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਭੋਗ ਤਾਹਿ ਤਿਨ ਕੀਯਾ ॥",
      "transliteration": "bahu bidh bhog taeh tin keeyaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਰਾਣੀ) ਨਾਲ ਉਸ ਨੇ ਕਈ ਤਰ੍ਰਹਾ ਦਾ ਭੋਗ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि भोग ताहि तिन कीया ॥",
      "sourceLineId": "131191",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮੋਹਿ ਹ੍ਰਿਦੈ ਰਾਨੀ ਕੋ ਲੀਯਾ ॥",
      "transliteration": "moh hiradhai raanee ko leeyaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਦੇ ਹਿਰਦੇ ਨੂੰ ਮੋਹ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "मोहि हृदै रानी को लीया ॥",
      "sourceLineId": "131192",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤ੍ਰਿਯ ਤਾ ਸੌ ਅਤਿ ਹਿਤ ਉਪਜਾਯੋ ॥",
      "transliteration": "tiray taa sau at hit upajaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਉਸ ਨਾਲ ਬਹੁਤ ਹਿਤ ਪੈਦਾ ਕਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "तृय ता सौ अति हित उपजायो ॥",
      "sourceLineId": "131193",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1215_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਾਜਾ ਕਹ ਚਿਤ ਤੇ ਬਿਸਰਾਯੋ ॥੪॥",
      "transliteration": "raajaa keh chit te bisaraayo ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੂੰ ਚਿਤ ਤੋਂ ਭੁਲਾ ਦਿੱਤਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1215,
      "hindi": "",
      "hindiTransliteration": "राजा कह चित ते बिसरायो ॥४॥",
      "sourceLineId": "131194",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
