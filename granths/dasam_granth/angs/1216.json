{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1216,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1216_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤ੍ਰਿਯ ਐਸੀ ਬਿਧਿ ਚਿਤਹਿ ਬਿਚਾਰਾ ॥",
      "transliteration": "tiray aaisee bidh chiteh bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਚਿਤ ਵਿਚ ਵਿਚਾਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "तृय ऐसी बिधि चितहि बिचारा ॥",
      "sourceLineId": "131195",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਹ ਰਾਜਾ ਕਹ ਚਹਿਯਤ ਮਾਰਾ ॥",
      "transliteration": "eeh raajaa keh chahiyat maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਸ ਰਾਜੇ ਨੂੰ ਮਾਰ ਦੇਣਾ ਚਾਹੀਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "इह राजा कह चहियत मारा ॥",
      "sourceLineId": "131196",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਲੈ ਤਿਹ ਰਾਜ ਜੋਗਿਯਹਿ ਦੀਜੈ ॥",
      "transliteration": "lai teh raaj jogiyeh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤੋਂ ਰਾਜ ਲੈ ਕੇ ਜੋਗੀ ਨੂੰ ਦਿੱਤਾ ਜਾਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "लै तिह राज जोगियहि दीजै ॥",
      "sourceLineId": "131197",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਛੂ ਚਰਿਤ੍ਰ ਐਸਿ ਬਿਧਿ ਕੀਜੈ ॥੫॥",
      "transliteration": "kachhoo charitr aais bidh keejai ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਜਿਹੇ ਢੰਗ ਦਾ ਕੁਝ ਚਰਿਤ੍ਰ ਕੀਤਾ ਜਾਵੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "कछू चरित्र ऐसि बिधि कीजै ॥५॥",
      "sourceLineId": "131198",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੋਵਤ ਸਮੈ ਨ੍ਰਿਪਤਿ ਕਹ ਮਾਰਿਯੋ ॥",
      "transliteration": "sovat samai nirapat keh maariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸੁਤੇ ਪਏ ਰਾਜੇ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "सोवत समै नृपति कह मारियो ॥",
      "sourceLineId": "131199",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗਾਡਿ ਤਾਹਿ ਇਹ ਭਾਤਿ ਉਚਾਰਿਯੋ ॥",
      "transliteration": "gaadd taeh ieh bhaat uchaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ (ਭੂਮੀ ਵਿਚ) ਗਡ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "गाडि ताहि इह भाति उचारियो ॥",
      "sourceLineId": "131200",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਾਜੈ ਰਾਜ ਜੋਗਿਯਹਿ ਦੀਨਾ ॥",
      "transliteration": "raajai raaj jogiyeh dheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਰਾਜ ਜੋਗੀ ਨੂੰ ਦੇ ਦਿੱਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "राजै राज जोगियहि दीना ॥",
      "sourceLineId": "131201",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਆਪਨ ਭੇਸ ਜੋਗ ਕੋ ਲੀਨਾ ॥੬॥",
      "transliteration": "aapan bhes jog ko leenaa ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪ ਯੋਗ ਦਾ ਭੇਸ ਧਾਰਨ ਕਰ ਲਿਆ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "आपन भेस जोग को लीना ॥६॥",
      "sourceLineId": "131202",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੋਗ ਭੇਸ ਧਾਰਤ ਨ੍ਰਿਪ ਭਏ ॥",
      "transliteration": "jog bhes dhaarat nirap bhe ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਜੋਗ ਭੇਸ ਲੈ ਲਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "जोग भेस धारत नृप भए ॥",
      "sourceLineId": "131203",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੈ ਇਹ ਰਾਜ ਬਨਹਿ ਉਠ ਗਏ ॥",
      "transliteration": "dhai ieh raaj baneh uTh ge ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਨੂੰ ਰਾਜ ਦੇ ਕੇ ਬਨ ਨੂੰ ਉਠ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "दै इह राज बनहि उठ गए ॥",
      "sourceLineId": "131204",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹਮਹੂੰ ਰਾਜ ਜੋਗਿਯਹਿ ਦੈ ਹੈ ॥",
      "transliteration": "hamahoo(n) raaj jogiyeh dhai hai ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਵੀ ਰਾਜ ਜੋਗੀ ਨੂੰ ਦਿੰਦੀ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "हमहूँ राज जोगियहि दै है ॥",
      "sourceLineId": "131205",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਥ ਗਏ ਜਿਤ ਤਹੀ ਸਿਧੈ ਹੈ ॥੭॥",
      "transliteration": "naath ge jit tahee sidhai hai ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਥੇ ਰਾਜਾ ਗਿਆ ਹੈ, ਉਧਰ ਨੂੰ ਜਾਦੀ ਹਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "नाथ गए जित तही सिधै है ॥७॥",
      "sourceLineId": "131206",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਤਿ ਸਤਿ ਸਭ ਪ੍ਰਜਾ ਬਖਾਨਿਯੋ ॥",
      "transliteration": "sat sat sabh prajaa bakhaaniyo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਦੀ ਗੱਲ ਸੁਣ ਕੇ) ਸਾਰੀ ਪ੍ਰਜਾ ਨੇ 'ਸਤਿ ਸਤਿ' ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "सति सति सभ प्रजा बखानियो ॥",
      "sourceLineId": "131207",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜੋ ਨ੍ਰਿਪ ਕਹਿਯੋ ਵਹੈ ਹਮ ਮਾਨਿਯੋ ॥",
      "transliteration": "jo nirap kahiyo vahai ham maaniyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੇ ਜੋ ਕਿਹਾ, ਉਸ ਨੂੰ ਅਸੀਂ ਮੰਨ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "जो नृप कहियो वहै हम मानियो ॥",
      "sourceLineId": "131208",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਭਹਿਨ ਰਾਜ ਜੋਗਯਹਿ ਦੀਨਾ ॥",
      "transliteration": "sabhahin raaj jogayeh dheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਨੇ ਜੋਗੀ ਨੂੰ ਰਾਜ ਦੇ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "सभहिन राज जोगयहि दीना ॥",
      "sourceLineId": "131209",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਮੂੜ ਨਹਿ ਚੀਨਾ ॥੮॥",
      "transliteration": "bhedh abhedh mooR neh cheenaa ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੂਰਖਾ ਨੇ ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਾ ਸਮਝਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद मूड़ नहि चीना ॥८॥",
      "sourceLineId": "131210",
      "sourceShabadId": "12446",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "131211",
      "sourceShabadId": "12447",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਾਰਿ ਨ੍ਰਿਪਤਿ ਕਹ ਚੰਚਲੈ ਕਿਯੋ ਆਪਨੇ ਕਾਜ ॥",
      "transliteration": "maar nirapat keh cha(n)chalai kiyo aapane kaaj ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਰਾਜੇ ਨੂੰ ਮਾਰ ਕੇ ਆਪਣਾ ਕੰਮ ਕਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "मारि नृपति कह चंचलै कियो आपने काज ॥",
      "sourceLineId": "131212",
      "sourceShabadId": "12447",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਕਲ ਪ੍ਰਜਾ ਡਾਰੀ ਪਗਨ ਦੈ ਜੋਗੀ ਕਹ ਰਾਜ ॥੯॥",
      "transliteration": "sakal prajaa ddaaree pagan dhai jogee keh raaj ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜੋਗੀ ਨੂੰ ਰਾਜ ਦੇ ਕੇ ਸਾਰੀ ਪ੍ਰਜਾ ਉਸ ਦੇ ਪੈਰੀਂ ਪਾ ਦਿੱਤੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "सकल प्रजा डारी पगन दै जोगी कह राज ॥९॥",
      "sourceLineId": "131213",
      "sourceShabadId": "12447",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131214",
      "sourceShabadId": "12448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਰਾਜ ਜੋਗਿਯਹਿ ਦੀਯਾ ॥",
      "transliteration": "eeh bidh raaj jogiyeh dheeyaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਜੋਗੀ ਨੂੰ ਰਾਜ ਦੇ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "इह बिधि राज जोगियहि दीया ॥",
      "sourceLineId": "131215",
      "sourceShabadId": "12448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਇਹ ਛਲ ਸੌ ਪਤਿ ਕੋ ਬਧ ਕੀਯਾ ॥",
      "transliteration": "eeh chhal sau pat ko badh keeyaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਛਲ ਨਾਲ ਪਤੀ ਨੂੰ ਕਤਲ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "इह छल सौ पति को बध कीया ॥",
      "sourceLineId": "131216",
      "sourceShabadId": "12448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮੂਰਖ ਅਬ ਲਗ ਭੇਦ ਨ ਪਾਵੈ ॥",
      "transliteration": "moorakh ab lag bhedh na paavai ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖਾ ਨੇ ਅਜੇ ਤਕ ਭੇਦ ਨਹੀਂ ਸਮਝਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "मूरख अब लग भेद न पावै ॥",
      "sourceLineId": "131217",
      "sourceShabadId": "12448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਬ ਤਕ ਆਇ ਸੁ ਰਾਜ ਕਮਾਵੈ ॥੧੦॥",
      "transliteration": "ab tak aai su raaj kamaavai ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੁਣ ਤਕ ਉਹ ਰਾਜ ਕਮਾਉਾਂਦਾ ਆ ਰਿਹਾ ਹੈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "अब तक आइ सु राज कमावै ॥१०॥",
      "sourceLineId": "131218",
      "sourceShabadId": "12448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਅਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੮੦॥੫੩੭੬॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau asee charitr samaapatam sat subham sat ||280||5376||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੮੦ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੮੦॥੫੩੭੬॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ असी चरित्र समापतम सतु सुभम सतु ॥२८०॥५३७६॥अफजूँ॥",
      "sourceLineId": "131219",
      "sourceShabadId": "12448",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131220",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਿਜੈ ਨਗਰ ਇਕ ਰਾਇ ਬਖਨਿਯਤ ॥",
      "transliteration": "bijai nagar ik rai bakhaniyat ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਜੈ ਨਗਰ ਦਾ ਇਕ ਰਾਜਾ ਦਸਿਆ ਜਾਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "बिजै नगर इक राइ बखनियत ॥",
      "sourceLineId": "131221",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਾ ਕੋ ਤ੍ਰਾਸ ਦੇਸ ਸਭ ਮਨਿਯਤ ॥",
      "transliteration": "jaa ko traas dhes sabh maniyat ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਡਰ ਸਾਰੇ ਦੇਸ ਮੰਨਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "जा को त्रास देस सभ मनियत ॥",
      "sourceLineId": "131222",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਿਜੈ ਸੈਨ ਜਿਹ ਨਾਮ ਨ੍ਰਿਪਤਿ ਬਰ ॥",
      "transliteration": "bijai sain jeh naam nirapat bar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਸ੍ਰੇਸ਼ਠ ਰਾਜੇ ਦਾ ਨਾ ਬਿਜੈ ਸੈਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "बिजै सैन जिह नाम नृपति बर ॥",
      "sourceLineId": "131223",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਿਜੈ ਮਤੀ ਰਾਨੀ ਜਿਹ ਕੇ ਘਰ ॥੧॥",
      "transliteration": "bijai matee raanee jeh ke ghar ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਬਿਜੈ ਮਤੀ (ਨਾ ਦੀ) ਰਾਣੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "बिजै मती रानी जिह के घर ॥१॥",
      "sourceLineId": "131224",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਜੈ ਮਤੀ ਦੂਸਰਿ ਤਿਹ ਰਾਨੀ ॥",
      "transliteration": "ajai matee dhoosar teh raanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਜੈ ਮਤੀ ਉਸ ਦੀ ਦੂਜੀ ਰਾਣੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "अजै मती दूसरि तिह रानी ॥",
      "sourceLineId": "131225",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਾ ਕੇ ਕਰ ਨ੍ਰਿਪ ਦੇਹਿ ਬਿਕਾਨੀ ॥",
      "transliteration": "jaa ke kar nirap dheh bikaanee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਹੱਥ ਵਿਚ ਰਾਜਾ ਵਿਕਿਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "जा के कर नृप देहि बिकानी ॥",
      "sourceLineId": "131226",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਿਜੈ ਮਤੀ ਕੇ ਸੁਤ ਇਕ ਧਾਮਾ ॥",
      "transliteration": "bijai matee ke sut ik dhaamaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਜੈ ਮਤੀ ਦੇ ਘਰ ਇਕ ਪੁੱਤਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "बिजै मती के सुत इक धामा ॥",
      "sourceLineId": "131227",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸ੍ਰੀ ਸੁਲਤਾਨ ਸੈਨ ਤਿਹ ਨਾਮਾ ॥੨॥",
      "transliteration": "sree sulataan sain teh naamaa ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਾ ਸੁਲਤਾਨ ਸੈਨ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "स्री सुलतान सैन तिह नामा ॥२॥",
      "sourceLineId": "131228",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਿਜੈ ਮਤੀ ਕੋ ਰੂਪ ਅਪਾਰਾ ॥",
      "transliteration": "bijai matee ko roop apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਜੈ ਮਤੀ ਦਾ ਰੂਪ ਅਪਾਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "बिजै मती को रूप अपारा ॥",
      "sourceLineId": "131229",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਾ ਸੰਗ ਨਹੀ ਨ੍ਰਿਪਤਿ ਕੋ ਪ੍ਯਾਰਾ ॥",
      "transliteration": "jaa sa(n)g nahee nirapat ko payaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਸ ਨਾਲ ਰਾਜੇ ਦਾ ਪਿਆਰ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "जा संग नही नृपति को प्यारा ॥",
      "sourceLineId": "131230",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਜੈ ਮਤੀ ਕੀ ਸੁੰਦਰਿ ਕਾਯਾ ॥",
      "transliteration": "ajai matee kee su(n)dhar kaayaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਜੈ ਮਤੀ ਦਾ ਸ਼ਰੀਰ ਬਹੁਤ ਸੁੰਦਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "अजै मती की सुँदरि काया ॥",
      "sourceLineId": "131231",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਿਨ ਰਾਜਾ ਕੋ ਚਿਤ ਲੁਭਾਯਾ ॥੩॥",
      "transliteration": "jin raajaa ko chit lubhaayaa ||3||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਰਾਜੇ ਦਾ ਚਿਤ ਲੁਭਾਇਆ ਹੋਇਆ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "जिन राजा को चित लुभाया ॥३॥",
      "sourceLineId": "131232",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਾ ਕੇ ਰਹਤ ਰੈਨਿ ਦਿਨ ਪਰਾ ॥",
      "transliteration": "taa ke rahat rain dhin paraa ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ) ਰਾਤ ਦਿਨ ਉਸੇ ਦੇ ਹੀ ਪਿਆ ਰਹਿੰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "ता के रहत रैनि दिन परा ॥",
      "sourceLineId": "131233",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜੈਸੀ ਭਾਤਿ ਗੋਰ ਮਹਿ ਮਰਾ ॥",
      "transliteration": "jaisee bhaat gor meh maraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਕਿ ਕਬਰ ਵਿਚ ਮਰਿਆ ਪਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "जैसी भाति गोर महि मरा ॥",
      "sourceLineId": "131234",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੁਤਿਯ ਨਾਰਿ ਕੇ ਧਾਮ ਨ ਜਾਵੈ ॥",
      "transliteration": "dhutiy naar ke dhaam na jaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਦੂਜੀ ਰਾਣੀ ਦੇ ਘਰ ਨਹੀਂ ਜਾਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "दुतिय नारि के धाम न जावै ॥",
      "sourceLineId": "131235",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਾ ਤੇ ਤਰੁਨਿ ਅਧਿਕ ਕੁਰਰਾਵੈ ॥੪॥",
      "transliteration": "taa te tarun adhik kuraraavai ||4||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਉਹ ਇਸਤਰੀ ਬਹੁਤ ਕੁੜ੍ਰਹਦੀ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "ता ते तरुनि अधिक कुररावै ॥४॥",
      "sourceLineId": "131236",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਆਗ੍ਯਾ ਚਲਤ ਤਵਨ ਕੀ ਦੇਸਾ ॥",
      "transliteration": "aagayaa chalat tavan kee dhesaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਦੂਜੀ ਰਾਣੀ ਦਾ) ਹੁਕਮ ਹੀ ਦੇਸ ਵਿਚ ਚਲਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "आग्या चलत तवन की देसा ॥",
      "sourceLineId": "131237",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰਾਨੀ ਭਈ ਨ੍ਰਿਪਤਿ ਕੇ ਭੇਸਾ ॥",
      "transliteration": "raanee bhiee nirapat ke bhesaa ||",
      "translation": "",
      "punjabiViakhya": "(ਅਸਲ ਵਿਚ) ਰਾਣੀ ਹੀ ਰਾਜੇ ਦੇ ਭੇਸ ਵਿਚ (ਰਾਜ ਕਰਦੀ ਸੀ)।",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "रानी भई नृपति के भेसा ॥",
      "sourceLineId": "131238",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਯਹਿ ਰਿਸਿ ਨਾਰਿ ਦੁਤਿਯ ਜਿਯ ਰਾਖੀ ॥",
      "transliteration": "yeh ris naar dhutiy jiy raakhee ||",
      "translation": "",
      "punjabiViakhya": "ਦੂਜੀ ਰਾਣੀ ਨੇ (ਸਾੜੇ ਕਾਰਨ) ਮਨ ਵਿਚ ਇਹ ਰੋਸ ਪਾਲ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "यहि रिसि नारि दुतिय जिय राखी ॥",
      "sourceLineId": "131239",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬੋਲਿਕ ਬੈਦ ਪ੍ਰਗਟ ਅਸਿ ਭਾਖੀ ॥੫॥",
      "transliteration": "bolik baidh pragaT as bhaakhee ||5||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਵੈਦ ਨੂੰ ਬੁਲਾ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਸਾਫ਼ ਕਿਹਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "बोलिक बैद प्रगट असि भाखी ॥५॥",
      "sourceLineId": "131240",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਯਾ ਰਾਜਾ ਕਹ ਜੁ ਤੈ ਖਪਾਵੈਂ ॥",
      "transliteration": "yaa raajaa keh ju tai khapaavai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੂੰ ਇਸ ਰਾਜੇ ਨੂੰ ਖਪਾ ਦੇਵੇਾਂ",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "या राजा कह जु तै खपावैं ॥",
      "sourceLineId": "131241",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1216_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮੁਖ ਮਾਗੈ ਮੋ ਤੇ ਸੋ ਪਾਵੈਂ ॥",
      "transliteration": "mukh maagai mo te so paavai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮੇਰੇ ਕੋਲੋਂ ਮੂੰਹ ਮੰਗਿਆ (ਇਨਾਮ) ਪ੍ਰਾਪਤ ਕਰੇਾਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1216,
      "hindi": "",
      "hindiTransliteration": "मुख मागै मो ते सो पावैं ॥",
      "sourceLineId": "131242",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
