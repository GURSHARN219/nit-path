{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1217,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1217_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਬ ਚਲਿ ਬੈਦ ਨ੍ਰਿਪਤਿ ਪਹਿ ਗਯੋ ॥",
      "transliteration": "tab chal baidh nirapat peh gayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਵੈਦ ਚਲ ਕੇ ਰਾਜੇ ਕੋਲ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "तब चलि बैद नृपति पहि गयो ॥",
      "sourceLineId": "131243",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰੋਗੀ ਬਪੁ ਤਿਹ ਕੋ ਠਹਰਯੋ ॥੬॥",
      "transliteration": "rogee bap teh ko Thaharayo ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੇ ਸ਼ਰੀਰ ਨੂੰ ਰੋਗੀ ਦਸਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "रोगी बपु तिह को ठहरयो ॥६॥",
      "sourceLineId": "131244",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜੋ ਤੁਮ ਕਹੋ ਤੁ ਕਰੋ ਉਪਾਈ ॥",
      "transliteration": "jo tum kaho ta karo upaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ) ਜੇ ਤੁਸੀਂ ਕਹੋ, ਤਾ ਉਪਾ ਕਰਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "जो तुम कहो तु करो उपाई ॥",
      "sourceLineId": "131245",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਕਹਿ ਤਿਹ ਬਰੀ ਖਵਾਈ ॥",
      "transliteration": "jayo(n) tayo(n) keh teh baree khavaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਉਸ ਨੂੰ ਇਕ ਬੱਟੀ ('ਬਰੀ') ਖਵਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "ज्यों त्यों कहि तिह बरी खवाई ॥",
      "sourceLineId": "131246",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰੋਗੀ ਭਯੋ ਅਰੋਗੀ ਤਨ ਸੌ ॥",
      "transliteration": "rogee bhayo arogee tan sau ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨਾਲ) ਰਾਜੇ ਦਾ ਅਰੋਗੀ ਸ਼ਰੀਰ ਰੋਗੀ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "रोगी भयो अरोगी तन सौ ॥",
      "sourceLineId": "131247",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਪਾਵਤ ਜੜ ਸੌ ॥੭॥",
      "transliteration": "bhedh abhedh na paavat jaR sau ||7||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਹ ਮੂਰਖ ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਾ ਸਮਝ ਸਕਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न पावत जड़ सौ ॥७॥",
      "sourceLineId": "131248",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭਛਤ ਬਰੀ ਪੇਟ ਤਿਹ ਛੂਟਾ ॥",
      "transliteration": "bhachhat baree peT teh chhooTaa ||",
      "translation": "",
      "punjabiViakhya": "ਬੱਟੀ ਖਾਦਿਆਂ ਹੀ ਉਸ ਦਾ ਪੇਟ ਚਲ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "भछत बरी पेट तिह छूटा ॥",
      "sourceLineId": "131249",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਾਵਨ ਜਾਨ ਪਨਾਰਾ ਫੂਟਾ ॥",
      "transliteration": "saavan jaan panaaraa fooTaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸਾਵਣ (ਦੇ ਮਹੀਨੇ ਵਿਚ) ਪਰਨਾਲਾ ਵਗਣ ਲਗ ਗਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "सावन जान पनारा फूटा ॥",
      "sourceLineId": "131250",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੂਸਰਿ ਬਰੀ ਥੰਭ ਕੇ ਕਾਜੈ ॥",
      "transliteration": "dhoosar baree tha(n)bh ke kaajai ||",
      "translation": "",
      "punjabiViakhya": "(ਦਸਤਾ ਨੂੰ) ਰੋਕਣ ਲਈ ਰਾਜੇ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "दूसरि बरी थंभ के काजै ॥",
      "sourceLineId": "131251",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜੋਰਾਵਰੀ ਖਵਾਈ ਰਾਜੈ ॥੮॥",
      "transliteration": "joraavaree khavaiee raajai ||8||",
      "translation": "",
      "punjabiViakhya": "ਮਲੋਮਲੀ ਦੂਜੀ ਬੱਟੀ ਖਵਾ ਦਿੱਤੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "जोरावरी खवाई राजै ॥८॥",
      "sourceLineId": "131252",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਾ ਤੇ ਅਧਿਕ ਪੇਟ ਛੁਟਿ ਗਯੋ ॥",
      "transliteration": "taa te adhik peT chhuT gayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਪੇਟ ਹੋਰ ਜ਼ਿਆਦਾ ਚਲ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "ता ते अधिक पेट छुटि गयो ॥",
      "sourceLineId": "131253",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਾ ਤੇ ਬਹੁ ਬਿਹਬਲ ਨ੍ਰਿਪ ਭਯੋ ॥",
      "transliteration": "jaa te bahu bihabal nirap bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਰਾਜਾ ਬਹੁਤ ਨਿਢਾਲ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "जा ते बहु बिहबल नृप भयो ॥",
      "sourceLineId": "131254",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੰਨ ਭਯੋ ਇਹ ਬੈਦ ਉਚਾਰਾ ॥",
      "transliteration": "sa(n)n bhayo ieh baidh uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਵੈਦ ਨੇ ਕਿਹਾ, ਰਾਜੇ ਨੂੰ ਸੰਨਪਾਤ (ਰੋਗ) ਹੋ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "संन भयो इह बैद उचारा ॥",
      "sourceLineId": "131255",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਹ ਬਿਧ ਕਿਯ ਉਪਚਾਰ ਬਿਚਾਰਾ ॥੯॥",
      "transliteration": "eeh bidh kiy upachaar bichaaraa ||9||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਵਿਚਾਰ ਪੂਰਵਕ ਇਸ ਢੰਗ ਦਾ ਇਲਾਜ ਕੀਤਾ ਹੈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "इह बिध किय उपचार बिचारा ॥९॥",
      "sourceLineId": "131256",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦਸ ਤੋਲੇ ਅਹਿਫੇਨ ਮੰਗਾਈ ॥",
      "transliteration": "dhas tole ahifen ma(n)gaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਵੈਦ ਨੇ) ਦਸ ਤੋਲੇ ਹਫ਼ੀਮ ਮੰਗਵਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "दस तोले अहिफेन मंगाई ॥",
      "sourceLineId": "131257",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਹੁ ਬਿਖਿ ਵਾ ਕੇ ਸੰਗ ਮਿਲਾਈ ॥",
      "transliteration": "bahu bikh vaa ke sa(n)g milaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਸਾਰੀ ਬਿਖ ਉਸ ਵਿਚ ਮਿਲਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "बहु बिखि वा के संग मिलाई ॥",
      "sourceLineId": "131258",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਧੂਰਾ ਕੀਯਾ ਤਵਨ ਕੇ ਅੰਗਾ ॥",
      "transliteration": "dhooraa keeyaa tavan ke a(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਵਾਈ ਦਾ) ਰਾਜੇ ਦੇ ਸ਼ਰੀਰ ਉਪਰ ਧੂੜਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "धूरा कीया तवन के अंगा ॥",
      "sourceLineId": "131259",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚਾਮ ਗਯੋ ਤਾ ਕੇ ਤਿਹ ਸੰਗਾ ॥੧੦॥",
      "transliteration": "chaam gayo taa ke teh sa(n)gaa ||10||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ (ਰਾਜੇ ਦੀ) ਚਮੜੀ ਉਤਰ ਗਈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "चाम गयो ता के तिह संगा ॥१०॥",
      "sourceLineId": "131260",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹਾਇ ਹਾਇ ਰਾਜਾ ਜਬ ਕਰੈ ॥",
      "transliteration": "hai hai raajaa jab karai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜਾ 'ਹਾਇ ਹਾਇ' ਕਰਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "हाइ हाइ राजा जब करै ॥",
      "sourceLineId": "131261",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਿਮਿ ਤਿਮਿ ਬੈਦ ਇਹ ਭਾਤਿ ਉਚਰੈ ॥",
      "transliteration": "tim tim baidh ieh bhaat ucharai ||",
      "translation": "",
      "punjabiViakhya": "ਤਿਵੇਾਂ ਤਿਵੇਾਂ ਵੈਦ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿੰਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "तिमि तिमि बैद इह भाति उचरै ॥",
      "sourceLineId": "131262",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਯਾ ਕਹੁ ਅਧਿਕ ਨ ਬੋਲਨ ਦੇਹੂ ॥",
      "transliteration": "yaa kahu adhik na bolan dhehoo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਅਧਿਕ ਬੋਲਣ ਨਾ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "या कहु अधिक न बोलन देहू ॥",
      "sourceLineId": "131263",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮੂੰਦਿ ਬਦਨ ਰਾਜਾ ਕੋ ਲੇਹੂ ॥੧੧॥",
      "transliteration": "moo(n)dh badhan raajaa ko lehoo ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਦਾ ਮੂੰਹ ਬੰਦ ਕਰ ਲਵੋ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "मूँदि बदन राजा को लेहू ॥११॥",
      "sourceLineId": "131264",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਿਮਿ ਜਿਮਿ ਧੂਰੋ ਤਿਹ ਤਨ ਪਰੈ ॥",
      "transliteration": "jim jim dhooro teh tan parai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਜਿਵੇਾਂ ਧੂੜਾ ਰਾਜੇ ਦੇ ਸ਼ਰੀਰ ਉਤੇ ਪੈਂਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "जिमि जिमि धूरो तिह तन परै ॥",
      "sourceLineId": "131265",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹਾਇ ਹਾਇ ਤਿਮ ਨ੍ਰਿਪਤਿ ਉਚਰੈ ॥",
      "transliteration": "hai hai tim nirapat ucharai ||",
      "translation": "",
      "punjabiViakhya": "ਤਿਵੇਾਂ ਤਿਵੇਾਂ ਰਾਜਾ 'ਹਾਇ ਹਾਇ' ਕਹਿੰਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "हाइ हाइ तिम नृपति उचरै ॥",
      "sourceLineId": "131266",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨਹੂੰ ਚੀਨੋ ॥",
      "transliteration": "bhedh abhedh na kinahoo(n) cheeno ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਗੱਲ ਦਾ) ਭੇਦ ਅਭੇਦ ਕਿਸੇ ਨੇ ਨਾ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न किनहूँ चीनो ॥",
      "sourceLineId": "131267",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਇਹ ਛਲ ਪ੍ਰਾਨ ਤਵਨ ਕੋ ਲੀਨੋ ॥੧੨॥",
      "transliteration": "eeh chhal praan tavan ko leeno ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਛਲ ਨਾਲ ਉਸ ਦੇ ਪ੍ਰਾਣ ਲੈ ਲਏ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "इह छल प्रान तवन को लीनो ॥१२॥",
      "sourceLineId": "131268",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਇਹ ਛਲ ਸਾਥ ਨ੍ਰਿਪਤਿ ਕਹ ਮਾਰਾ ॥",
      "transliteration": "eeh chhal saath nirapat keh maaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ) ਇਸ ਛਲ ਨਾਲ ਰਾਜੇ ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "इह छल साथ नृपति कह मारा ॥",
      "sourceLineId": "131269",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਪਨੇ ਛਤ੍ਰ ਪੁਤ੍ਰ ਸਿਰ ਢਾਰਾ ॥",
      "transliteration": "apane chhatr putr sir ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਪੁੱਤਰ ਦੇ ਸਿਰ ਉਤੇ ਛੱਤਰ ਝੁਲਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "अपने छत्र पुत्र सिर ढारा ॥",
      "sourceLineId": "131270",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਭ ਸੌਅਨ ਕਹ ਦੇਤ ਨਿਕਾਰਿਯੋ ॥",
      "transliteration": "sabh sauan keh dhet nikaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਸੌਂਕਣਾ ਨੂੰ ਕਢ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "सभ सौअन कह देत निकारियो ॥",
      "sourceLineId": "131271",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨੂ ਬਿਚਾਰਿਯੋ ॥੧੩॥",
      "transliteration": "bhedh abhedh na kinoo bichaariyo ||13||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਕਿਸੇ ਨੇ ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਾ ਸਮਝਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न किनू बिचारियो ॥१३॥",
      "sourceLineId": "131272",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਇਕਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੮੧॥੫੩੮੯॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau ikaasee charitr samaapatam sat subham sat ||281||5389||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੮੧ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੮੧॥੫੩੮੯॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ इकासी चरित्र समापतम सतु सुभम सतु ॥२८१॥५३८९॥अफजूँ॥",
      "sourceLineId": "131273",
      "sourceShabadId": "12449",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131274",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਮੀ ਕਰਨ ਇਕ ਸੁਨਾ ਨ੍ਰਿਪਾਲਾ ॥",
      "transliteration": "amee karan ik sunaa nirapaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਮੀ ਕਰਨ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੁਣਿਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "अमी करन इक सुना नृपाला ॥",
      "sourceLineId": "131275",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਮਰ ਕਲਾ ਜਾ ਕੇ ਗ੍ਰਿਹ ਬਾਲਾ ॥",
      "transliteration": "amar kalaa jaa ke gireh baalaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਘਰ ਅਮਰ ਕਲਾ ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "अमर कला जा के गृह बाला ॥",
      "sourceLineId": "131276",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗੜ ਸਿਰਾਜ ਕੋ ਰਾਜ ਕਮਾਵੈ ॥",
      "transliteration": "gaR siraaj ko raaj kamaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸਿਰਾਜ ਗੜ੍ਰਹ ਉਤੇ ਰਾਜ ਕਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "गड़ सिराज को राज कमावै ॥",
      "sourceLineId": "131277",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੀਰਾਜੀ ਜਗ ਨਾਮ ਕਹਾਵੈ ॥੧॥",
      "transliteration": "seeraajee jag naam kahaavai ||1||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਲਈ ਉਹ) ਜਗਤ ਵਿਚ 'ਸੀਰਾਜੀ' ਦੇ ਨਾ ਨਾਲ ਬੁਲਾਇਆ ਜਾਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "सीराजी जग नाम कहावै ॥१॥",
      "sourceLineId": "131278",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਸੁਰ ਕਲਾ ਦੂਸਰਿ ਤਾ ਕੀ ਤ੍ਰਿਯ ॥",
      "transliteration": "asur kalaa dhoosar taa kee tiray ||",
      "translation": "",
      "punjabiViakhya": "ਅਸੁਰ ਕਲਾ ਉਸ ਦੀ ਦੂਜੀ ਰਾਣੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "असुर कला दूसरि ता की तृय ॥",
      "sourceLineId": "131279",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਿਸਿ ਦਿਨ ਰਹਤ ਨ੍ਰਿਪਤਿ ਜਾ ਮੈ ਜਿਯ ॥",
      "transliteration": "nis dhin rahat nirapat jaa mai jiy ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਰਾਤ ਦਿਨ ਰਾਜੇ ਦੇ ਹਿਰਦੇ ਵਿਚ ਵਸਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "निसि दिन रहत नृपति जा मै जिय ॥",
      "sourceLineId": "131280",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਮਰ ਕਲਾ ਜਿਯ ਮਾਝ ਰਿਸਾਵੈ ॥",
      "transliteration": "amar kalaa jiy maajh risaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਮਰ ਕਲਾ ਮਨ ਵਿਚ ਬਹੁਤ ਕ੍ਰੋਧ ਕਰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "अमर कला जिय माझ रिसावै ॥",
      "sourceLineId": "131281",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਸੁਰ ਕਲਹਿ ਪਿਯ ਰੋਜ ਬੁਲਾਵੈ ॥੨॥",
      "transliteration": "asur kaleh piy roj bulaavai ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਸੁਰ ਕਲਾ ਨੂੰ ਰਾਜਾ ਨਿੱਤ ਬੁਲਾਉਾਂਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "असुर कलहि पिय रोज बुलावै ॥२॥",
      "sourceLineId": "131282",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਏਕ ਬਨਿਕ ਕੌ ਲਯੋ ਬੁਲਾਈ ॥",
      "transliteration": "ek banik kau layo bulaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਅਮਰ ਕਲਾ ਰਾਣੀ ਨੇ) ਇਕ ਬਨੀਏ ਨੂੰ ਬੁਲਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "एक बनिक कौ लयो बुलाई ॥",
      "sourceLineId": "131283",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮਦਨ ਕ੍ਰੀੜ ਤਿਹ ਸਾਥ ਕਮਾਈ ॥",
      "transliteration": "madhan kreeR teh saath kamaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "मदन क्रीड़ तिह साथ कमाई ॥",
      "sourceLineId": "131284",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਨਦ ਕੁਅਰ ਤਿਹ ਨਰ ਕੋ ਨਾਮਾ ॥",
      "transliteration": "anadh kuar teh nar ko naamaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪੁਰਸ਼ ਦਾ ਨਾ ਅਨੰਦ ਕੁਮਾਰ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "अनद कुअर तिह नर को नामा ॥",
      "sourceLineId": "131285",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਾ ਕੌ ਭਜਾ ਨ੍ਰਿਪਤਿ ਕੀ ਬਾਮਾ ॥੩॥",
      "transliteration": "jaa kau bhajaa nirapat kee baamaa ||3||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਰਾਜੇ ਦੀ ਇਸਤਰੀ ਨੇ ਸੰਯੋਗ ਕੀਤਾ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "जा कौ भजा नृपति की बामा ॥३॥",
      "sourceLineId": "131286",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਸੁਰ ਕਲਾ ਕੌ ਨਿਜੁ ਕਰ ਘਾਯੋ ॥",
      "transliteration": "asur kalaa kau nij kar ghaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਅਸੁਰ ਕਲਾ ਨੂੰ ਆਪਣੇ ਹੱਥਾ ਨਾਲ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "असुर कला कौ निजु कर घायो ॥",
      "sourceLineId": "131287",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਰੀ ਨਾਰਿ ਤਵ ਪਤਿਹਿ ਸੁਨਾਯੋ ॥",
      "transliteration": "maree naar tav pateh sunaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਪਤੀ ਨੂੰ ਦਸਿਆ ਕਿ ਤੇਰੀ ਇਸਤਰੀ ਮਰ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "मरी नारि तव पतिहि सुनायो ॥",
      "sourceLineId": "131288",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਰ ਤਖਤਾ ਕੇ ਮਿਤ੍ਰਹਿ ਧਰਾ ॥",
      "transliteration": "tar takhataa ke mitreh dharaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ (ਅਰਥੀ ਦੇ) ਫਟੇ ਹੇਠਾ ਮਿਤਰ ਨੂੰ ਢਕ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "तर तखता के मित्रहि धरा ॥",
      "sourceLineId": "131289",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1217_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਾ ਪਰ ਬਡੋ ਅਡੰਬਰ ਕਰਾ ॥੪॥",
      "transliteration": "taa par baddo adda(n)bar karaa ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਉਤੇ ਸੁੰਦਰ ਸਜਾਵਟ ਕਰ ਦਿੱਤੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1217,
      "hindi": "",
      "hindiTransliteration": "ता पर बडो अडंबर करा ॥४॥",
      "sourceLineId": "131290",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
