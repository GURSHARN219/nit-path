{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1218,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1218_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਰ ਤਖਤਾ ਕੇ ਮਿਤ੍ਰ ਦੁਰਾਯੋ ॥",
      "transliteration": "tar takhataa ke mitr dhuraayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਖਦੇ ਹੇਠਾ ਮਿਤਰ ਲੁਕਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "तर तखता के मित्र दुरायो ॥",
      "sourceLineId": "131291",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਾ ਪਰ ਸਵਤਿ ਲੋਥ ਕਹਿ ਪਾਯੋ ॥",
      "transliteration": "taa par savat loth keh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਉਤੇ ਸੌਂਕਣ ਦੀ ਲੋਥ ਪਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "ता पर सवति लोथ कहि पायो ॥",
      "sourceLineId": "131292",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨੂੰ ਬਿਚਾਰਾ ॥",
      "transliteration": "bhedh abhedh na kinoo(n) bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਗੱਲ ਦਾ) ਭੇਦ ਅਭੇਦ ਕਿਸੇ ਨੇ ਨਾ ਵਿਚਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न किनूँ बिचारा ॥",
      "sourceLineId": "131293",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਹ ਛਲ ਅਪਨੋ ਯਾਰ ਨਿਕਾਰਾ ॥੫॥",
      "transliteration": "eeh chhal apano yaar nikaaraa ||5||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਆਪਣੇ ਯਾਰ ਨੂੰ (ਬਾਹਰ) ਕਢ ਦਿੱਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "इह छल अपनो यार निकारा ॥५॥",
      "sourceLineId": "131294",
      "sourceShabadId": "12450",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "131295",
      "sourceShabadId": "12451",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਵਤਿ ਸੰਘਾਰੀ ਪਤਿ ਛਲਾ ਮ੍ਰਿਤਹਿ ਲਯੋ ਉਬਾਰਿ ॥",
      "transliteration": "savat sa(n)ghaaree pat chhalaa mriteh layo ubaar ||",
      "translation": "",
      "punjabiViakhya": "ਸੌਂਕਣ ਨੂੰ ਮਾਰ ਕੇ ਅਤੇ ਪਤੀ ਨੂੰ ਛਲ ਕੇ (ਆਪਣੇ) ਮਿਤਰ ਨੂੰ ਬਚਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "सवति संघारी पति छला मृतहि लयो उबारि ॥",
      "sourceLineId": "131296",
      "sourceShabadId": "12451",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭੇਦ ਕਿਸੂ ਪਾਯੋ ਨਹੀ ਧੰਨ ਸੁ ਅਮਰ ਕੁਮਾਰਿ ॥੬॥",
      "transliteration": "bhedh kisoo paayo nahee dha(n)n su amar kumaar ||6||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਵੀ (ਇਸ ਗੱਲ ਦਾ) ਭੇਦ ਨਾ ਪਾਇਆ। ਅਮਰ ਕੁਮਾਰੀ (ਸਚਮੁਚ) ਧੰਨ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "भेद किसू पायो नही धंन सु अमर कुमारि ॥६॥",
      "sourceLineId": "131297",
      "sourceShabadId": "12451",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਬਿਆਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੮੨॥੫੩੯੫॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau biaasee charitr samaapatam sat subham sat ||282||5395||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੮੨ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੮੨॥੫੩੯੫॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ बिआसी चरित्र समापतम सतु सुभम सतु ॥२८२॥५३९५॥अफजूँ॥",
      "sourceLineId": "131298",
      "sourceShabadId": "12451",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131299",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਹਿਰ ਪਲਾਊ ਏਕ ਨ੍ਰਿਪਾਰਾ ॥",
      "transliteration": "sahir palaauoo ek nirapaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਪਲਾਊ ਨਾ ਦੇ ਨਗਰ ਵਿਚ ਇਕ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "सहिर पलाऊ एक नृपारा ॥",
      "sourceLineId": "131300",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਹ ਧਨਿ ਭਰੇ ਸਕਲ ਭੰਡਾਰਾ ॥",
      "transliteration": "jeh dhan bhare sakal bha(n)ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਸਾਰੇ ਭੰਡਾਰ ਧਨ ਨਾਲ ਭਰੇ ਰਹਿੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "जिह धनि भरे सकल भंडारा ॥",
      "sourceLineId": "131301",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਿੰਨ੍ਰ ਮਤੀ ਤਿਹ ਰਾਜ ਦੁਲਾਰੀ ॥",
      "transliteration": "ki(n)nr matee teh raaj dhulaaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਿੰਨ੍ਰ ਮਤੀ ਉਸ ਦੀ ਰਾਣੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "किंन्र मती तिह राज दुलारी ॥",
      "sourceLineId": "131302",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਾਨੁਕ ਚੰਦ੍ਰ ਲਈ ਉਜਿਯਾਰੀ ॥੧॥",
      "transliteration": "jaanuk cha(n)dhr liee ujiyaaree ||1||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਚੰਦ੍ਰਮਾ ਨੇ (ਉਸ ਪਾਸੋਂ) ਪ੍ਰਕਾਸ਼ ਲਿਆ ਹੋਵੇ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "जानुक चंद्र लई उजियारी ॥१॥",
      "sourceLineId": "131303",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਿਕ੍ਰਮ ਸਿੰਘ ਸਾਹੁ ਸੁਤ ਇਕ ਤਹ ॥",
      "transliteration": "bikram si(n)gh saahu sut ik teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਬਿਕ੍ਰਮ ਸਿੰਘ ਨਾ ਦੀ ਇਕ ਸ਼ਾਹ ਦਾ ਪੁੱਤਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "बिक्रम सिंघ साहु सुत इक तह ॥",
      "sourceLineId": "131304",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਾ ਸਮ ਸੁੰਦਰ ਦੁਤਿਯ ਨ ਮਹਿ ਮਹ ॥",
      "transliteration": "jaa sam su(n)dhar dhutiy na meh meh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਧਰਤੀ ਉਤੇ ਕੋਈ ਹੋਰ ਸੁੰਦਰ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "जा सम सुँदर दुतिय न महि मह ॥",
      "sourceLineId": "131305",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਪ੍ਰਮਾਨ ਤਿਹ ਪ੍ਰਭਾ ਬਿਰਾਜੈ ॥",
      "transliteration": "apramaan teh prabhaa biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਅਸੀਮ ਸ਼ੋਭਾ ਸ਼ੋਭਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "अप्रमान तिह प्रभा बिराजै ॥",
      "sourceLineId": "131306",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੁਰ ਨਰ ਅਸੁਰ ਨਿਰਖਿ ਮਨ ਲਾਜੈ ॥੨॥",
      "transliteration": "sur nar asur nirakh man laajai ||2||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ) ਵੇਖ ਕੇ ਦੇਵਤੇ, ਦੈਂਤ ਅਤੇ ਮੱਨੁਖ ਮਨ ਵਿਚ ਸ਼ਰਮਾਉਾਂਦੇ ਸਨ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "सुर नर असुर निरखि मन लाजै ॥२॥",
      "sourceLineId": "131307",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਿੰਨ੍ਰ ਮਤੀ ਵਾ ਸੌ ਹਿਤ ਕਿਯੌ ॥",
      "transliteration": "ki(n)nr matee vaa sau hit kiyau ||",
      "translation": "",
      "punjabiViakhya": "ਕਿੰਨ੍ਰ ਮਤੀ ਨੇ ਉਸ ਨਾਲ ਪ੍ਰੇਮ ਪਾਲ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "किंन्र मती वा सौ हित कियौ ॥",
      "sourceLineId": "131308",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਾਹਿ ਬੋਲਿ ਗ੍ਰਿਹ ਅਪਨੇ ਲਿਯੋ ॥",
      "transliteration": "taeh bol gireh apane liyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਆਪਣੇ ਘਰ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "ताहि बोलि गृह अपने लियो ॥",
      "sourceLineId": "131309",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਾ ਸੌ ਦ੍ਰਿੜ ਕਿਯਾ ॥",
      "transliteration": "kaam bhog taa sau dhiraR kiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਚੰਗੀ ਤਰ੍ਰਹਾ ਕਾਮ ਭੋਗ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "काम भोग ता सौ दृड़ किया ॥",
      "sourceLineId": "131310",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚਿਤ ਕੋ ਸੋਕ ਦੂਰਿ ਕਰ ਦਿਯਾ ॥੩॥",
      "transliteration": "chit ko sok dhoor kar dhiyaa ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦਿਲ ਦਾ ਦੁਖ ਦੂਰ ਕਰ ਦਿੱਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "चित को सोक दूरि कर दिया ॥३॥",
      "sourceLineId": "131311",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰਾਨੀ ਭੋਗ ਮਿਤ੍ਰ ਕੋ ਰਸਿ ਕੈ ॥",
      "transliteration": "raanee bhog mitr ko ras kai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਮਿਤਰ ਦੇ ਭੋਗ ਵਿਚ ਮਗਨ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "रानी भोग मित्र को रसि कै ॥",
      "sourceLineId": "131312",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਬਚਨ ਬਖਾਨ੍ਯੋ ਹਸਿ ਕੈ ॥",
      "transliteration": "eeh bidh bachan bakhaanayo has kai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹਸ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਇਸ ਤਰ੍ਰਹਾ ਗੱਲ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "इह बिधि बचन बखान्यो हसि कै ॥",
      "sourceLineId": "131313",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤੁਮ ਹਮ ਕਹ ਲੈ ਸੰਗ ਸਿਧਾਵਹੁ ॥",
      "transliteration": "tum ham keh lai sa(n)g sidhaavahu ||",
      "translation": "",
      "punjabiViakhya": "ਤੂੰ ਮੈਨੂੰ ਨਾਲ ਲੈ ਕੇ ਇਥੋਂ ਚਲਾ ਜਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "तुम हम कह लै संग सिधावहु ॥",
      "sourceLineId": "131314",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪਿਯ ਚਰਿਤ੍ਰ ਕਛੁ ਐਸ ਬਨਾਵਹੁ ॥੪॥",
      "transliteration": "piy charitr kachh aais banaavahu ||4||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪ੍ਰੀਤਮ! ਕੁਝ ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਚਰਿਤ੍ਰ ਕਰ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "पिय चरित्र कछु ऐस बनावहु ॥४॥",
      "sourceLineId": "131315",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਿਤ੍ਰ ਕਹਿਯੋ ਮੈ ਕਹੌ ਸੁ ਕਰਿਯਹੁ ॥",
      "transliteration": "mitr kahiyo mai kahau su kariyahu ||",
      "translation": "",
      "punjabiViakhya": "ਮਿਤਰ ਨੇ ਕਿਹਾ ਜੋ ਮੈਂ ਕਹਾਗਾ, ਉਹੀ ਕਰਨਾ",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "मित्र कहियो मै कहौ सु करियहु ॥",
      "sourceLineId": "131316",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਭੇਦ ਪੁਰਖ ਦੂਸਰ ਨ ਉਚਰਿਯਹੁ ॥",
      "transliteration": "bhedh purakh dhoosar na uchariyahu ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਸੇ ਹੋਰ ਬੰਦੇ ਨੂੰ ਭੇਦ ਨਾ ਦਸਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "भेद पुरख दूसर न उचरियहु ॥",
      "sourceLineId": "131317",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰੁਦ੍ਰ ਭਵਨ ਪੂਜਨ ਤੁਮ ਜੈ ਹੌ ॥",
      "transliteration": "rudhr bhavan poojan tum jai hau ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਤੂੰ ਰੁਦ੍ਰ ਦੇ ਮੰਦਿਰ ਵਿਚ ਪੂਜਾ ਲਈ ਜਾਵੇਾਂਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "रुद्र भवन पूजन तुम जै हौ ॥",
      "sourceLineId": "131318",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਬ ਹੀ ਹਿਤੂ ਹਿਤੂ ਕਹ ਪੈ ਹੌ ॥੫॥",
      "transliteration": "tab hee hitoo hitoo keh pai hau ||5||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਹੀ (ਤੂੰ) ਆਪਣੇ ਹਿਤੂ ਮਿਤਰ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰੇਾਂਗੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "तब ही हितू हितू कह पै हौ ॥५॥",
      "sourceLineId": "131319",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪਤਿ ਤਨ ਭਾਖਿ ਦੇਹਰੇ ਗਈ ॥",
      "transliteration": "pat tan bhaakh dhehare giee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਪਤੀ ਨੂੰ ਕਹਿ ਕੇ ਮੰਦਿਰ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "पति तन भाखि देहरे गई ॥",
      "sourceLineId": "131320",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਹ ਤੇ ਜਾਤ ਮਿਤ੍ਰ ਸੰਗ ਭਈ ॥",
      "transliteration": "teh te jaat mitr sa(n)g bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਥੋਂ ਮਿਤਰ ਨਾਲ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "तह ते जात मित्र संग भई ॥",
      "sourceLineId": "131321",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਿਨਹੂੰ ਪੁਰਖ ਭੇਦ ਨਹਿ ਜਾਨਾ ॥",
      "transliteration": "kinahoo(n) purakh bhedh neh jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਵਿਅਕਤੀ ਨੇ ਭੇਦ ਨਾ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "किनहूँ पुरख भेद नहि जाना ॥",
      "sourceLineId": "131322",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਸ ਰਾਜਾ ਤਨ ਬਚਨ ਬਖਾਨਾ ॥੬॥",
      "transliteration": "as raajaa tan bachan bakhaanaa ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੂੰ ਆ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "अस राजा तन बचन बखाना ॥६॥",
      "sourceLineId": "131323",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰਾਨੀ ਰੁਦ੍ਰ ਭਵਨ ਜਬ ਗਈ ॥",
      "transliteration": "raanee rudhr bhavan jab giee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਜਦੋਂ ਰੁਦ੍ਰ ਦੇ ਮੰਦਿਰ ਵਿਚ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "रानी रुद्र भवन जब गई ॥",
      "sourceLineId": "131324",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਿਵ ਜੂ ਬਿਖੈ ਲੀਨ ਸੋ ਭਈ ॥",
      "transliteration": "siv joo bikhai leen so bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸ਼ਿਵ ਜੀ ਵਿਚ ਹੀ ਲੀਨ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "सिव जू बिखै लीन सो भई ॥",
      "sourceLineId": "131325",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਿਨ ਸਾਜੁਜ ਮੁਕਤਿ ਕਹ ਪਾਯੋ ॥",
      "transliteration": "tin saajuj mukat keh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ 'ਸਾਜੁਜ' (ਅਭੇਦ ਅਵਸਥਾ ਵਾਲੀ ਮੁਕਤੀ) ਨੂੰ ਪ੍ਰਾਪਤ ਕਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "तिन साजुज मुकति कह पायो ॥",
      "sourceLineId": "131326",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਨਮ ਮਰਨ ਕੋ ਤਾਪ ਮਿਟਾਯੋ ॥੭॥",
      "transliteration": "janam maran ko taap miTaayo ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਨਮ ਮਰਨ ਦੇ ਦੁਖ ਖ਼ਤਮ ਕਰ ਲਏ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "जनम मरन को ताप मिटायो ॥७॥",
      "sourceLineId": "131327",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨ੍ਰਿਪ ਸੁਨਿ ਰੁਦ੍ਰ ਭਗਤਿ ਅਨੁਰਾਗਾ ॥",
      "transliteration": "nirap sun rudhr bhagat anuraagaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ (ਇਹ ਗੱਲ) ਸੁਣ ਕੇ ਰੁਦ੍ਰ ਦੀ ਭਗਤੀ ਦਾ ਪ੍ਰੇਮੀ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "नृप सुनि रुद्र भगति अनुरागा ॥",
      "sourceLineId": "131328",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਧਨਿ ਧਨਿ ਤ੍ਰਿਯਹਿ ਬਖਾਨਨ ਲਾਗਾ ॥",
      "transliteration": "dhan dhan tirayeh bakhaanan laagaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸਤਰੀ ਨੂੰ 'ਧੰਨ ਧੰਨ' ਕਹਿਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "धनि धनि तृयहि बखानन लागा ॥",
      "sourceLineId": "131329",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੁਹਕਰ ਕਰਮ ਕੀਆ ਜਿਨ ਦਾਰਾ ॥",
      "transliteration": "dhuhakar karam keeaa jin dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਇਸਤਰੀ ਨੇ (ਇਤਨਾ) ਕਠਿਨ ਕੰਮ ਕੀਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "दुहकर करम कीआ जिन दारा ॥",
      "sourceLineId": "131330",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪਲਿ ਪਲਿ ਪ੍ਰਤਿ ਤਾ ਕੇ ਬਲਿਹਾਰਾ ॥੮॥",
      "transliteration": "pal pal prat taa ke balihaaraa ||8||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਉਤੋਂ ਪਲ ਪਲ ਬਲਿਹਾਰ ਹੋਣਾ ਚਾਹੀਦਾ ਹੈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "पलि पलि प्रति ता के बलिहारा ॥८॥",
      "sourceLineId": "131331",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਤਰਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੮੩॥੫੪੦੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau taraasee charitr samaapatam sat subham sat ||283||5403||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੮੩ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੮੩॥੫੪੦੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ तरासी चरित्र समापतम सतु सुभम सतु ॥२८३॥५४०३॥अफजूँ॥",
      "sourceLineId": "131332",
      "sourceShabadId": "12452",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131333",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦਛਨਿ ਸੈਨ ਦਛਨੀ ਰਾਜਾ ॥",
      "transliteration": "dhachhan sain dhachhanee raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਖਣ (ਦਿਸ਼ਾ) ਵਿਚ ਦਛਨਿ ਸੈਨ ਨਾ ਦਾ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "दछनि सैन दछनी राजा ॥",
      "sourceLineId": "131334",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਦਛਨਿ ਦੇ ਰਾਨੀ ਸਿਰਤਾਜਾ ॥",
      "transliteration": "dhachhan dhe raanee sirataajaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਦਛਨਿ ਦੇ (ਦੇਈ) ਨਾ ਵਾਲੀ ਰਾਣੀ ਦਾ ਸਿਰਤਾਜ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "दछनि दे रानी सिरताजा ॥",
      "sourceLineId": "131335",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਾ ਸਮ ਔਰ ਨ ਦੂਜੀ ਰਾਨੀ ॥",
      "transliteration": "jaa sam aauar na dhoojee raanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ ਕੋਈ ਦੂਜੀ ਰਾਣੀ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "जा सम और न दूजी रानी ॥",
      "sourceLineId": "131336",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦਛਿਨ ਵਤੀ ਬਸਤ ਰਜਧਾਨੀ ॥੧॥",
      "transliteration": "dhachhin vatee basat rajadhaanee ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦਛਨਿਵਤੀ ਨਾ ਦੀ ਰਾਜਧਾਨੀ ਵਿਚ ਰਹਿੰਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1218,
      "hindi": "",
      "hindiTransliteration": "दछिन वती बसत रजधानी ॥१॥",
      "sourceLineId": "131337",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1218_line_0048",
