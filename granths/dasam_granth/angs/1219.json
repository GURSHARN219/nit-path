{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1219,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1219_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰੂਪਮਾਨ ਜਨੁ ਦੁਤਿਯ ਦਿਵਾਕਰ ॥",
      "transliteration": "roopamaan jan dhutiy dhivaakar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਬਹੁਤ) ਰੂਪਵਾਨ ਸੀ, ਮਾਨੋ ਦੂਜਾ ਸੂਰਜ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "रूपमान जनु दुतिय दिवाकर ॥",
      "sourceLineId": "131339",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਾ ਕੀ ਜਾਤ ਪ੍ਰਭਾ ਨਹਿ ਕਹੀ ॥",
      "transliteration": "taa kee jaat prabhaa neh kahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "ता की जात प्रभा नहि कही ॥",
      "sourceLineId": "131340",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਾਨੁਕ ਫੂਲਿ ਚੰਬੇਲੀ ਰਹੀ ॥੨॥",
      "transliteration": "jaanuk fool cha(n)belee rahee ||2||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਚੰਬੇਲੀ ਦਾ ਫੁਲ ਹੋਵੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "जानुक फूलि चंबेली रही ॥२॥",
      "sourceLineId": "131341",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰੂਪ ਤਵਨ ਕੋ ਦਿਪਤ ਅਪਾਰਾ ॥",
      "transliteration": "roop tavan ko dhipat apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਰੂਪ ਦੀ ਅਪਾਰ ਚਮਕ ਸਾਹਮਣੇ",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "रूप तवन को दिपत अपारा ॥",
      "sourceLineId": "131342",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਿਹ ਆਗੇ ਕ੍ਯਾ ਸੂਰ ਬਿਚਾਰਾ ॥",
      "transliteration": "teh aage kayaa soor bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਜ ਵਿਚਾਰਾ ਕੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "तिह आगे क्या सूर बिचारा ॥",
      "sourceLineId": "131343",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੋਭਾ ਕਹੀ ਨ ਹਮ ਤੇ ਜਾਈ ॥",
      "transliteration": "sobhaa kahee na ham te jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਡੇ ਤੋਂ (ਉਸ ਦੀ) ਸ਼ੋਭਾ ਕਹੀ ਨਹੀਂ ਜਾਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "सोभा कही न हम ते जाई ॥",
      "sourceLineId": "131344",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਕਲ ਤ੍ਰਿਯਾ ਲਖਿ ਰਹਤ ਬਿਕਾਈ ॥੩॥",
      "transliteration": "sakal tirayaa lakh rahat bikaiee ||3||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਇਸਤਰੀਆਂ ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਵਿਕੀਆਂ ਰਹਿ ਜਾਦੀਆਂ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "सकल तृया लखि रहत बिकाई ॥३॥",
      "sourceLineId": "131345",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਾਨੀ ਦਰਸ ਤਵਨ ਕੋ ਪਾਯੋ ॥",
      "transliteration": "raanee dharas tavan ko paayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਜਦੋਂ ਉਸ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "रानी दरस तवन को पायो ॥",
      "sourceLineId": "131346",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪਠੈ ਸਹਚਰੀ ਧਾਮ ਬੁਲਾਯੋ ॥",
      "transliteration": "paThai sahacharee dhaam bulaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਦਾਸੀ ਨੂੰ ਭੇਜ ਕੇ ਘਰ ਬੁਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "पठै सहचरी धाम बुलायो ॥",
      "sourceLineId": "131347",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਾਮ ਕੇਲ ਤਾ ਸੌ ਹਸਿ ਮਾਨੀ ॥",
      "transliteration": "kaam kel taa sau has maanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਹਸ ਕੇ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "काम केल ता सौ हसि मानी ॥",
      "sourceLineId": "131348",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਮਤ ਰਮਤ ਸਭ ਨਿਸਾ ਬਿਹਾਨੀ ॥੪॥",
      "transliteration": "ramat ramat sabh nisaa bihaanee ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਮਣ ਕਰਦਿਆਂ ਸਾਰੀ ਰਾਤ ਗੁਜ਼ਰ ਗਈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "रमत रमत सभ निसा बिहानी ॥४॥",
      "sourceLineId": "131349",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੈਸੇ ਹੁਤੋ ਨ੍ਰਿਪਤਿ ਕੇ ਰੂਪਾ ॥",
      "transliteration": "jaise huto nirapat ke roopaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਰਾਜੇ ਦਾ ਰੂਪ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "जैसे हुतो नृपति के रूपा ॥",
      "sourceLineId": "131350",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤੈਸੋ ਤਾ ਕੋ ਹੁਤੋ ਸਰੂਪਾ ॥",
      "transliteration": "taiso taa ko huto saroopaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਤਰ੍ਰਹਾ ਦਾ ਉਸ ਦਾ ਸਰੂਪ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "तैसो ता को हुतो सरूपा ॥",
      "sourceLineId": "131351",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਾ ਸੌ ਅਟਕ ਕੁਅਰਿ ਕੀ ਭਈ ॥",
      "transliteration": "jaa sau aTak kuar kee bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਨਾਲ ਰਾਣੀ ਦੀ ਪ੍ਰੀਤ ਹੋ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "जा सौ अटक कुअरि की भई ॥",
      "sourceLineId": "131352",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨ੍ਰਿਪ ਕੀ ਬਾਤ ਬਿਸਰਿ ਕਰਿ ਗਈ ॥੫॥",
      "transliteration": "nirap kee baat bisar kar giee ||5||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਾਜੇ ਦੀ ਗੱਲ ਭੁਲਾ ਦਿੱਤੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "नृप की बात बिसरि करि गई ॥५॥",
      "sourceLineId": "131353",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਾ ਸੌ ਹਿਤ ਰਾਨੀ ਕੋ ਭਯੋ ॥",
      "transliteration": "taa sau hit raanee ko bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਰਾਣੀ ਦਾ ਪ੍ਰੇਮ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "ता सौ हित रानी को भयो ॥",
      "sourceLineId": "131354",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਾਜਾ ਸਾਥ ਹੇਤੁ ਤਜਿ ਦਯੋ ॥",
      "transliteration": "raajaa saath het taj dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨਾਲ ਹਿਤ ਕਰਨਾ ਛਡ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "राजा साथ हेतु तजि दयो ॥",
      "sourceLineId": "131355",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਦਰਾ ਅਧਿਕ ਨ੍ਰਿਪਤਿ ਕਹ ਪ੍ਰਯਾਯੋ ॥",
      "transliteration": "madharaa adhik nirapat keh prayaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਰਾਜੇ ਨੂੰ ਬਹੁਤ ਸ਼ਰਾਬ ਪਿਲਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "मदरा अधिक नृपति कह प्रयायो ॥",
      "sourceLineId": "131356",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਾਜ ਸਿੰਘਾਸਨ ਜਾਰ ਬੈਠਾਯੋ ॥੬॥",
      "transliteration": "raaj si(n)ghaasan jaar baiThaayo ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ ਸਿੰਘਾਸਨ ਉਤੇ ਯਾਰ ਨੂੰ ਬਿਠਾ ਦਿੱਤਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "राज सिंघासन जार बैठायो ॥६॥",
      "sourceLineId": "131357",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਤ ਭਏ ਨ੍ਰਿਪ ਸੋ ਧਨ ਪਾਯੋ ॥",
      "transliteration": "mat bhe nirap so dhan paayo ||",
      "translation": "",
      "punjabiViakhya": "ਬੇਹੋਸ਼ ਹੋਏ ਰਾਜੇ ਤੋਂ ਧਨ ਖੋਹ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "मत भए नृप सो धन पायो ॥",
      "sourceLineId": "131358",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਾਧਿ ਮ੍ਰਿਤ ਕੇ ਧਾਮ ਪਠਾਯੋ ॥",
      "transliteration": "baadh mirat ke dhaam paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਨੂੰ) ਬੰਨ੍ਰਹ ਕੇ ਮਿਤਰ ਦੇ ਘਰ ਭੇਜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "बाधि मृत के धाम पठायो ॥",
      "sourceLineId": "131359",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਾ ਕੋ ਪ੍ਰਜਾ ਨ੍ਰਿਪਤਿ ਕਰਿ ਮਾਨਾ ॥",
      "transliteration": "taa ko prajaa nirapat kar maanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਨੌਕਰ) ਨੂੰ ਪ੍ਰਜਾ ਨੇ ਰਾਜਾ ਕਰ ਕੇ ਮੰਨਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "ता को प्रजा नृपति करि माना ॥",
      "sourceLineId": "131360",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਾਜਾ ਕਹ ਚਾਕਰ ਪਹਿਚਾਨਾ ॥੭॥",
      "transliteration": "raajaa keh chaakar pahichaanaa ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੂੰ ਨੌਕਰ ਸਮਝ ਲਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "राजा कह चाकर पहिचाना ॥७॥",
      "sourceLineId": "131361",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੁਹੂੰਅਨ ਕੀ ਏਕੈ ਅਨੁਹਾਰਾ ॥",
      "transliteration": "dhuhoo(n)an kee ekai anuhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਦੀ ਇਕੋ ਜਿਹੀ ਨੁਹਾਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "दुहूँअन की एकै अनुहारा ॥",
      "sourceLineId": "131362",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਰਾਵ ਰੰਕ ਨਹਿ ਜਾਤ ਬਿਚਾਰਾ ॥",
      "transliteration": "raav ra(n)k neh jaat bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਦੋਹਾ) ਰਾਜੇ ਅਤੇ ਨੌਕਰ (ਵਿਚ ਕੋਈ ਭੇਦ) ਵਿਚਾਰਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "राव रंक नहि जात बिचारा ॥",
      "sourceLineId": "131363",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਾ ਕੌ ਲੋਗ ਨ੍ਰਿਪਤਿ ਕਰਿ ਮਾਨੈ ॥",
      "transliteration": "taa kau log nirapat kar maanai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਲੋਕੀਂ ਰਾਜਾ ਕਰ ਕੇ ਮੰਨਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "ता कौ लोग नृपति करि मानै ॥",
      "sourceLineId": "131364",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਲਜਤ ਬਚਨ ਨ ਨ੍ਰਿਪਤਿ ਬਖਾਨੈ ॥੮॥",
      "transliteration": "lajat bachan na nirapat bakhaanai ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲਜਾ ਦਾ ਮਾਰਿਆ ਰਾਜਾ ਕੁਝ ਨਹੀਂ ਬੋਲਦਾ ਸੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "लजत बचन न नृपति बखानै ॥८॥",
      "sourceLineId": "131365",
      "sourceShabadId": "12453",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "131366",
      "sourceShabadId": "12454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਰੰਕ ਰਾਜ ਐਸੇ ਕਰਾ ਦਿਯਾ ਰੰਕ ਕੌ ਰਾਜ ॥",
      "transliteration": "ra(n)k raaj aaise karaa dhiyaa ra(n)k kau raaj ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਰੰਕ ਨੂੰ ਰਾਜਾ ਕਰ ਦਿੱਤਾ ਅਤੇ ਰੰਕ ਨੂੰ ਰਾਜ ਦੇ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "रंक राज ऐसे करा दिया रंक कौ राज ॥",
      "sourceLineId": "131367",
      "sourceShabadId": "12454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹ੍ਵੈ ਅਤੀਤ ਪਤਿ ਬਨ ਗਯੋ ਤਜਿ ਗਯੋ ਸਕਲ ਸਮਾਜ ॥੯॥",
      "transliteration": "havai ateet pat ban gayo taj gayo sakal samaaj ||9||",
      "translation": "",
      "punjabiViakhya": "ਪਤੀ (ਰਾਜਾ) ਸਾਰੇ ਰਾਜ-ਸਮਾਜ ਨੂੰ ਛਡ ਕੇ ਅਤੇ ਸਾਧ ਬਣ ਕੇ ਬਨ ਵਿਚ ਚਲਾ ਗਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "ह्वै अतीत पति बन गयो तजि गयो सकल समाज ॥९॥",
      "sourceLineId": "131368",
      "sourceShabadId": "12454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਚੌਰਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੮੪॥੫੪੧੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau chauaraasee charitr samaapatam sat subham sat ||284||5412||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੮੪ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੮੪॥੫੪੧੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ चौरासी चरित्र समापतम सतु सुभम सतु ॥२८४॥५४१२॥अफजूँ॥",
      "sourceLineId": "131369",
      "sourceShabadId": "12454",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "131370",
      "sourceShabadId": "12455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹੁਤੋ ਏਕ ਰਾਜਾ ਪ੍ਰਜਾ ਸੈਨ ਨਾਮਾ ॥",
      "transliteration": "huto ek raajaa prajaa sain naamaa ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਜਾ ਸੈਨ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "हुतो एक राजा प्रजा सैन नामा ॥",
      "sourceLineId": "131371",
      "sourceShabadId": "12455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪ੍ਰਜਾ ਪਾਲਨੀ ਧਾਮ ਤਾ ਕੇ ਸੁ ਬਾਮਾ ॥",
      "transliteration": "prajaa paalanee dhaam taa ke su baamaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਪ੍ਰਜਾ ਪਾਲਨੀ ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "प्रजा पालनी धाम ता के सु बामा ॥",
      "sourceLineId": "131372",
      "sourceShabadId": "12455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪ੍ਰਜਾ ਲੋਗ ਜਾ ਕੀ ਸਭੈ ਆਨਿ ਮਾਨੈ ॥",
      "transliteration": "prajaa log jaa kee sabhai aan maanai ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਜਾ ਦੇ ਸਾਰੇ ਲੋਗ ਉਸ ਦੀ ਅਧੀਨਗੀ ਮੰਨਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "प्रजा लोग जा की सभै आनि मानै ॥",
      "sourceLineId": "131373",
      "sourceShabadId": "12455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਿਸੈ ਦੂਸਰੋ ਜਾਨ ਰਾਜਾ ਪ੍ਰਮਾਨੈ ॥੧॥",
      "transliteration": "tisai dhoosaro jaan raajaa pramaanai ||1||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਦੂਜਾ ਰਾਜਾ ਸਮਝਦੇ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "तिसै दूसरो जान राजा प्रमानै ॥१॥",
      "sourceLineId": "131374",
      "sourceShabadId": "12455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੁਧਾ ਸੈਨ ਨਾਮਾ ਰਹੈ ਭ੍ਰਿਤ ਤਾ ਕੇ ॥",
      "transliteration": "sudhaa sain naamaa rahai bhirat taa ke ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਕੋਲ ਇਕ ਸੁਧਾ ਸੈਨ ਨਾ ਦਾ ਨੌਕਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "सुधा सैन नामा रहै भृत ता के ॥",
      "sourceLineId": "131375",
      "sourceShabadId": "12455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਹੈ ਰੀਝਿ ਬਾਲਾ ਲਖੈ ਨੈਨ ਵਾ ਕੇ ॥",
      "transliteration": "rahai reejh baalaa lakhai nain vaa ke ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਨੈਣਾ ਨੂੰ ਵੇਖ ਕੇ ਰਾਣੀ ਮੋਹਿਤ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "रहै रीझि बाला लखै नैन वा के ॥",
      "sourceLineId": "131376",
      "sourceShabadId": "12455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨ ਹ੍ਵੈਹੈ ਨ ਹੈ ਨ ਬਿਧਾਤਾ ਬਨਾਯੋ ॥",
      "transliteration": "n havaihai na hai na bidhaataa banaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਵਰਗਾ) ਨਾ ਕੋਈ ਹੋਇਆ ਹੈ, ਨਾ ਕੋਈ ਹੈ ਅਤੇ ਨਾ ਹੀ ਵਿਧਾਤਾ ਨੇ ਬਣਾਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "न ह्वैहै न है न बिधाता बनायो ॥",
      "sourceLineId": "131377",
      "sourceShabadId": "12455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਰੀ ਨਾਗਨੀ ਗੰਧ੍ਰਬੀ ਕੋ ਨ ਜਾਯੋ ॥੨॥",
      "transliteration": "naree naaganee ga(n)dhrabee ko na jaayo ||2||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨਰੀ, ਨਾਗਨੀ ਜਾ ਗੰਧਰਬੀ ਨੇ (ਇਸ ਪ੍ਰਕਾਰ ਦਾ ਬੰਦਾ) ਪੈਦਾ ਨਹੀਂ ਕੀਤਾ ਹੈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "नरी नागनी गंध्रबी को न जायो ॥२॥",
      "sourceLineId": "131378",
      "sourceShabadId": "12455",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131379",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਨਿਕ ਏਕ ਧਨਵਾਨ ਰਹਤ ਤਹ ॥",
      "transliteration": "banik ek dhanavaan rahat teh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਪ੍ਰਜਾ ਸੈਨ ਰਾਜਾ ਰਾਜ ਕਰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "बनिक एक धनवान रहत तह ॥",
      "sourceLineId": "131380",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪ੍ਰਜਾ ਸੈਨ ਨ੍ਰਿਪ ਰਾਜ ਕਰਤ ਜਹ ॥",
      "transliteration": "prajaa sain nirap raaj karat jeh ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਧਨਵਾਨ ਬਨੀਆ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "प्रजा सैन नृप राज करत जह ॥",
      "sourceLineId": "131381",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੁਮਤਿ ਮਤੀ ਤਾ ਕੀ ਇਕ ਕੰਨ੍ਯਾ ॥",
      "transliteration": "sumat matee taa kee ik ka(n)nayaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁਮਤਿ ਮਤੀ ਨਾ ਦੀ ਇਕ ਕੰਨਿਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "सुमति मती ता की इक कंन्या ॥",
      "sourceLineId": "131382",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਧਰਨੀ ਤਲ ਕੇ ਭੀਤਰ ਧੰਨ੍ਰਯਾ ॥੩॥",
      "transliteration": "dharanee tal ke bheetar dha(n)nrayaa ||3||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਧਰਤੀ ਉਤੇ ਧੰਨ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "धरनी तल के भीतर धंन्रया ॥३॥",
      "sourceLineId": "131383",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੁਧਾ ਸੈਨ ਤਿਨ ਜਬੈ ਨਿਹਾਰਾ ॥",
      "transliteration": "sudhaa sain tin jabai nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਧਾ ਸੈਨ ਨੂੰ ਜਦ ਉਸ ਨੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "सुधा सैन तिन जबै निहारा ॥",
      "sourceLineId": "131384",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਰਿ ਅਰਿ ਸਰ ਤਾ ਕੇ ਤਨ ਮਾਰਾ ॥",
      "transliteration": "har ar sar taa ke tan maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਕਾਮ ਦੇਵ ਨੇ ਉਸ ਦੇ ਸ਼ਰੀਰ ਵਿਚ ਬਾਣ ਮਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "हरि अरि सर ता के तन मारा ॥",
      "sourceLineId": "131385",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪਠੌ ਸਹਚਰੀ ਤਾਹਿ ਬੁਲਾਯੋ ॥",
      "transliteration": "paThau sahacharee taeh bulaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਦਾਸੀ ਨੂੰ ਭੇਜ ਕੇ ਉਸ ਨੂੰ ਬੁਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "पठौ सहचरी ताहि बुलायो ॥",
      "sourceLineId": "131386",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸੋ ਨਰ ਧਾਮ ਨ ਵਾ ਕੇ ਆਯੋ ॥੪॥",
      "transliteration": "so nar dhaam na vaa ke aayo ||4||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਹ ਪੁਰਸ਼ ਉਸ ਦੇ ਘਰ ਨਾ ਆਇਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "सो नर धाम न वा के आयो ॥४॥",
      "sourceLineId": "131387",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਹਿ ਨਾਹਿ ਜਿਮਿ ਜਿਮਿ ਵਹ ਕਹੈ ॥",
      "transliteration": "naeh naeh jim jim veh kahai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਜਿਵੇਾਂ ਉਹ ਨਾਹ ਨਾਹ ਕਰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "नाहि नाहि जिमि जिमि वह कहै ॥",
      "sourceLineId": "131388",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਤਿਮਿ ਤਿਮਿ ਹਠਿ ਇਸਤ੍ਰੀ ਕਰ ਗਹੈ ॥",
      "transliteration": "tim tim haTh isatree kar gahai ||",
      "translation": "",
      "punjabiViakhya": "ਤਿਵਾਂ ਤਿਵੇਾਂ ਇਸਤਰੀ ਦਾ ਹਠ ਹੋਰ ਵੀ ਵਧਦਾ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "तिमि तिमि हठि इसत्री कर गहै ॥",
      "sourceLineId": "131389",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਧਿਕ ਦੂਤਕਾ ਤਹਾ ਪਠਾਵੈ ॥",
      "transliteration": "adhik dhootakaa tahaa paThaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਬਹੁਤ ਸਾਰੀਆਂ ਦਾਸੀਆਂ ਉਸ ਵਲ ਭੇਜੀਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "अधिक दूतका तहा पठावै ॥",
      "sourceLineId": "131390",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕ੍ਯੋਹੂੰ ਧਾਮ ਮਿਤ੍ਰ ਨਹਿ ਆਵੈ ॥੫॥",
      "transliteration": "kayohoo(n) dhaam mitr neh aavai ||5||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਕਿਵੇਾਂ ਵੀ (ਉਹ) ਮਿਤਰ ਉਸ ਦੇ ਘਰ ਨਾ ਆਇਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "क्योहूँ धाम मित्र नहि आवै ॥५॥",
      "sourceLineId": "131391",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜ੍ਯੋਂ ਜ੍ਯੋਂ ਮਿਤ੍ਰ ਨ ਆਵੈ ਧਾਮਾ ॥",
      "transliteration": "jayo(n) jayo(n) mitr na aavai dhaamaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਉਾਂ ਜਿਉਾਂ ਉਹ ਮਿਤਰ ਘਰ ਨਹੀਂ ਆ ਰਿਹਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "ज्यों ज्यों मित्र न आवै धामा ॥",
      "sourceLineId": "131392",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਤ੍ਯੋਂ ਤ੍ਯੋਂ ਅਤਿ ਬ੍ਯਾਕੁਲ ਹ੍ਵੈ ਬਾਮਾ ॥",
      "transliteration": "tayo(n) tayo(n) at bayaakul havai baamaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਿਉਾਂ ਤਿਉਾਂ ਉਹ ਇਸਤਰੀ ਬਹੁਤ ਵਿਆਕੁਲ ਹੁੰਦੀ ਜਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "त्यों त्यों अति ब्याकुल ह्वै बामा ॥",
      "sourceLineId": "131393",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਬਹੁ ਦੂਤਿਨ ਤੇ ਧਾਮ ਲੁਟਾਵੈ ॥",
      "transliteration": "bahu dhootin te dhaam luTaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਦਾਸੀਆਂ ਉਤੇ ਬਹੁਤ ਘਰ (ਭਾਵ ਧਨ) ਲੁਟਾ ਰਹੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "बहु दूतिन ते धाम लुटावै ॥",
      "sourceLineId": "131394",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਪਲ ਪਲ ਪ੍ਰਤਿ ਤਿਹ ਧਾਮ ਪਠਾਵੈ ॥੬॥",
      "transliteration": "pal pal prat teh dhaam paThaavai ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਲ ਪ੍ਰਤਿਪਲ ਉਸ ਦੇ ਘਰ (ਦਾਸੀਆਂ ਨੂੰ) ਭੇਜਦੀ ਰਹਿੰਦੀ ਸੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "पल पल प्रति तिह धाम पठावै ॥६॥",
      "sourceLineId": "131395",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਸਾਹ ਸੁਤਾ ਬਹੁ ਬਿਧਿ ਕਰਿ ਹਾਰੀ ॥",
      "transliteration": "saeh sutaa bahu bidh kar haaree ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਬਹੁਤ ਯਤਨ ਕਰ ਕੇ ਹਾਰ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "साह सुता बहु बिधि करि हारी ॥",
      "sourceLineId": "131396",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਸੁਧਾ ਸੈਨ ਸੌ ਭਈ ਨ ਯਾਰੀ ॥",
      "transliteration": "sudhaa sain sau bhiee na yaaree ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਸੁਧਾ ਸੈਨ ਨਾਲ ਉਸ ਦੀ ਯਾਰੀ ਨਾ ਹੋ ਸਕੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "सुधा सैन सौ भई न यारी ॥",
      "sourceLineId": "131397",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਤਬ ਅਬਲਾ ਇਹ ਮੰਤ੍ਰ ਪਕਾਯੋ ॥",
      "transliteration": "tab abalaa ieh ma(n)tr pakaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਉਸ) ਅਬਲਾ ਨੇ ਇਹ ਵਿਚਾਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "तब अबला इह मंत्र पकायो ॥",
      "sourceLineId": "131398",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਇਕ ਦੂਤੀ ਕਹ ਤਹਾ ਪਠਾਯੋ ॥੭॥",
      "transliteration": "eik dhootee keh tahaa paThaayo ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਦੂਤੀ ਨੂੰ ਉਸ ਕੋਲ ਭੇਜਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "इक दूती कह तहा पठायो ॥७॥",
      "sourceLineId": "131399",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਚਲੀ ਚਲੀ ਸਹਚਰਿ ਤਹ ਗਈ ॥",
      "transliteration": "chalee chalee sahachar teh giee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦਾਸੀ ਚਲਦੀ ਚਲਦੀ ਉਥੇ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "चली चली सहचरि तह गई ॥",
      "sourceLineId": "131400",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਜਿਹ ਗ੍ਰਿਹ ਸੁਧਿ ਮਿਤਵਾ ਕੀ ਭਈ ॥",
      "transliteration": "jeh gireh sudh mitavaa kee bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਘਰ ਵਿਚ ਉਸ ਮਿਤਰ ਦੇ ਹੋਣ ਦਾ ਪਤਾ ਲਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "जिह गृह सुधि मितवा की भई ॥",
      "sourceLineId": "131401",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਪਕਰਿ ਭੁਜਾ ਤੇ ਸੋਤ ਜਗਾਯੋ ॥",
      "transliteration": "pakar bhujaa te sot jagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਸੁਤੇ ਹੋਏ ਨੂੰ ਬਾਹੋਂ ਪਕੜ ਕੇ ਉਠਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "पकरि भुजा ते सोत जगायो ॥",
      "sourceLineId": "131402",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਚਲਹੁ ਅਬੈ ਨ੍ਰਿਪ ਤ੍ਰਿਯਹਿ ਬੁਲਾਯੋ ॥੮॥",
      "transliteration": "chalahu abai nirap tirayeh bulaayo ||8||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ) ਚਲੋ, ਤੁਹਾਨੂੰ ਰਾਜੇ ਦੀ ਇਸਤਰੀ (ਰਾਣੀ) ਨੇ ਬੁਲਾਇਆ ਹੈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "चलहु अबै नृप तृयहि बुलायो ॥८॥",
      "sourceLineId": "131403",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਮੂਰਖ ਕਛੂ ਬਾਤ ਨਹਿ ਪਾਈ ॥",
      "transliteration": "moorakh kachhoo baat neh paiee ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਨੇ ਕੁਝ ਗੱਲ ਨਾ ਸਮਝੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "मूरख कछू बात नहि पाई ॥",
      "sourceLineId": "131404",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਸਹਚਰਿ ਤਹਾ ਸੰਗ ਕਰਿ ਲ੍ਯਾਈ ॥",
      "transliteration": "sahachar tahaa sa(n)g kar layaiee ||",
      "translation": "",
      "punjabiViakhya": "ਦਾਸੀ ਉਸ ਨੂੰ ਨਾਲ ਲੈ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "सहचरि तहा संग करि ल्याई ॥",
      "sourceLineId": "131405",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਬੈਠੀ ਸੁਤਾ ਸਾਹੁ ਕੀ ਜਹਾ ॥",
      "transliteration": "baiThee sutaa saahu kee jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਬੈਠੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "बैठी सुता साहु की जहा ॥",
      "sourceLineId": "131406",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਲੈ ਆਈ ਮਿਤਵਾ ਕਹ ਤਹਾ ॥੯॥",
      "transliteration": "lai aaiee mitavaa keh tahaa ||9||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਮਿਤਰ ਨੂੰ ਲੈ ਆਈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "लै आई मितवा कह तहा ॥९॥",
      "sourceLineId": "131407",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਵਹਿ ਮੂਰਖ ਐਸੇ ਜਿਯ ਜਾਨਾ ॥",
      "transliteration": "veh moorakh aaise jiy jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮੂਰਖ ਨੇ ਮਨ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਸੋਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "वहि मूरख ऐसे जिय जाना ॥",
      "sourceLineId": "131408",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਸਾਹੁ ਸੁਤਾ ਕੋ ਛਲ ਨ ਪਛਾਨਾ ॥",
      "transliteration": "saahu sutaa ko chhal na pachhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਦਾ ਛਲ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "साहु सुता को छल न पछाना ॥",
      "sourceLineId": "131409",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1219_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਰਾਨੀ ਅਟਕਿ ਸੁ ਮੁਹਿ ਪਰ ਗਈ ॥",
      "transliteration": "raanee aTak su muh par giee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਸੋਚਿਆ ਕਿ) ਰਾਣੀ ਮੇਰੇ ਉਤੇ ਮੋਹਿਤ ਹੋ ਗਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1219,
      "hindi": "",
      "hindiTransliteration": "रानी अटकि सु मुहि पर गई ॥",
      "sourceLineId": "131410",
      "sourceShabadId": "12456",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
