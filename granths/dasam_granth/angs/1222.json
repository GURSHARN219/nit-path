{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1222,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1222_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭਗਨੀ ਦਰਬ ਬਿਲੋਕਿ ਕੈ ਲੋਭ ਸਿੰਧ ਕੈ ਮਾਹਿ ॥",
      "transliteration": "bhaganee dharab bilok kai lobh si(n)dh kai maeh ||",
      "translation": "",
      "punjabiViakhya": "ਭੈਣ ਧਨ ਨੂੰ ਵੇਖ ਕੇ ਲੋਭ ਦੇ ਸਮੁੰਦਰ ਵਿਚ (ਡੁਬ ਗਈ)।",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "भगनी दरब बिलोकि कै लोभ सिंध कै माहि ॥",
      "sourceLineId": "131507",
      "sourceShabadId": "12461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਖ ਸਿਖ ਲੌ ਬੂਡਤ ਭਈ ਸੁਧਿ ਨ ਰਹੀ ਜਿਯ ਮਾਹਿ ॥੫॥",
      "transliteration": "nakh sikh lau booddat bhiee sudh na rahee jiy maeh ||5||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸਿਰ ਤੋਂ ਪੈਰਾ ਤਕ (ਲੋਭ ਦੇ ਸਮੁੰਦਰ ਵਿਚ) ਡੁਬ ਗਈ ਅਤੇ ਉਸ ਦੇ ਮਨ ਵਿਚ ਕੋਈ ਸੁੱਧ ਬੁੱਧ ਨਾ ਰਹੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "नख सिख लौ बूडत भई सुधि न रही जिय माहि ॥५॥",
      "sourceLineId": "131508",
      "sourceShabadId": "12461",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131509",
      "sourceShabadId": "12462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭ੍ਰਾਤ ਵਾਤ ਭਗਨੀ ਨ ਬਿਚਾਰਾ ॥",
      "transliteration": "bhraat vaat bhaganee na bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਭੈਣ ਨੇ ਭਰਾ ਵਰਾ ਕੁਝ ਨਾ ਵਿਚਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "भ्रात वात भगनी न बिचारा ॥",
      "sourceLineId": "131510",
      "sourceShabadId": "12462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਫਾਸੀ ਡਾਰਿ ਕੰਠਿ ਮਹਿ ਮਾਰਾ ॥",
      "transliteration": "faasee ddaar ka(n)Th meh maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਗਲ ਵਿਚ ਫਾਹੀ ਪਾ ਕੇ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "फासी डारि कंठि महि मारा ॥",
      "sourceLineId": "131511",
      "sourceShabadId": "12462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਲੀਨਾ ਲੂਟਿ ਸਕਲ ਤਿਹ ਧਨ ਕੌ ॥",
      "transliteration": "leenaa looT sakal teh dhan kau ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਸਾਰੇ ਧਨ ਨੂੰ ਲੁਟ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "लीना लूटि सकल तिह धन कौ ॥",
      "sourceLineId": "131512",
      "sourceShabadId": "12462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਰਿਯੋ ਅਮੋਹ ਆਪਨੇ ਮਨ ਕੌ ॥੬॥",
      "transliteration": "kariyo amoh aapane man kau ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਮਨ ਨੂੰ ਨਿਰਮੋਹੀ ਕਰ ਦਿੱਤਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "करियो अमोह आपने मन कौ ॥६॥",
      "sourceLineId": "131513",
      "sourceShabadId": "12462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪ੍ਰਾਤ ਭਏ ਰੋਵਨ ਤਬ ਲਾਗੀ ॥",
      "transliteration": "praat bhe rovan tab laagee ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੇਰ ਹੋਣ ਤੇ ਉਹ ਰੋਣ ਲਗ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "प्रात भए रोवन तब लागी ॥",
      "sourceLineId": "131514",
      "sourceShabadId": "12462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਬ ਸਭ ਪ੍ਰਜਾ ਗਾਵ ਕੀ ਜਾਗੀ ॥",
      "transliteration": "jab sabh prajaa gaav kee jaagee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਪਿੰਡ ਦੇ ਸਾਰੇ ਲੋਕ ਜਾਗ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "जब सभ प्रजा गाव की जागी ॥",
      "sourceLineId": "131515",
      "sourceShabadId": "12462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮ੍ਰਿਤਕ ਬੰਧੁ ਤਬ ਸਭਨ ਦਿਖਾਯੋ ॥",
      "transliteration": "mritak ba(n)dh tab sabhan dhikhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਮਰਿਆ ਹੋਇਆ ਭਰਾ ਸਭ ਨੂੰ ਵਿਖਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "मृतक बंधु तब सभन दिखायो ॥",
      "sourceLineId": "131516",
      "sourceShabadId": "12462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਰਿਯੋ ਆਜੁ ਇਹ ਸਾਪ ਚਬਾਯੋ ॥੭॥",
      "transliteration": "mariyo aaj ieh saap chabaayo ||7||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ) ਸੱਪ ਦੇ ਡੰਗਣ ਨਾਲ ਇਹ ਮਰ ਗਿਆ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "मरियो आजु इह साप चबायो ॥७॥",
      "sourceLineId": "131517",
      "sourceShabadId": "12462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਲੀ ਭਾਤ ਤਨ ਤਾਹਿ ਗਡਾਯੋ ॥",
      "transliteration": "bhalee bhaat tan taeh gaddaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਸ਼ਰੀਰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਗਡਵਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "भली भात तन ताहि गडायो ॥",
      "sourceLineId": "131518",
      "sourceShabadId": "12462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਯੌ ਕਾਜੀ ਤਨ ਆਪੁ ਜਤਾਯੋ ॥",
      "transliteration": "yau kaajee tan aap jataayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪ ਕਾਜ਼ੀ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "यौ काजी तन आपु जतायो ॥",
      "sourceLineId": "131519",
      "sourceShabadId": "12462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਾਜ ਬਾਜਿ ਇਕ ਯਾ ਕੋ ਘੋਰੋ ॥",
      "transliteration": "saaj baaj ik yaa ko ghoro ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਦਾ ਸਾਮਾਨ ਅਤੇ ਇਕ ਘੋੜਾ",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "साज बाजि इक या को घोरो ॥",
      "sourceLineId": "131520",
      "sourceShabadId": "12462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਔਰ ਜੁ ਕਛੁ ਯਾ ਕੌ ਧਨੁ ਥੋਰੋ ॥੮॥",
      "transliteration": "aauar ju kachh yaa kau dhan thoro ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਥੋੜਾ ਜਿਹਾ ਧਨ (ਮੇਰੇ ਪਾਸ ਹੈ) ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "और जु कछु या कौ धनु थोरो ॥८॥",
      "sourceLineId": "131521",
      "sourceShabadId": "12462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੋ ਇਹ ਤ੍ਰਿਯਹਿ ਪਠਾਵਨ ਕੀਜੈ ॥",
      "transliteration": "so ieh tirayeh paThaavan keejai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਇਸ ਦੀ ਇਸਤਰੀ ਨੂੰ ਭੇਜ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "सो इह तृयहि पठावन कीजै ॥",
      "sourceLineId": "131522",
      "sourceShabadId": "12462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਫਾਰਖਤੀ ਹਮ ਕੌ ਲਿਖਿ ਦੀਜੈ ॥",
      "transliteration": "faarakhatee ham kau likh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੈਨੂੰ ਫ਼ਾਰਖ਼ਤੀ (ਬੇਬਾਕੀ) ਲਿਖ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "फारखती हम कौ लिखि दीजै ॥",
      "sourceLineId": "131523",
      "sourceShabadId": "12462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਬੁਜ ਲਿਖਾ ਕਾਜੀ ਤੇ ਲਈ ॥",
      "transliteration": "kabuj likhaa kaajee te liee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਕਾਜ਼ੀ ਤੋਂ ਰਸੀਦ ('ਕਬੁਜ') ਲਿਖਵਾ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "कबुज लिखा काजी ते लई ॥",
      "sourceLineId": "131524",
      "sourceShabadId": "12462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਛੁ ਧਨ ਮ੍ਰਿਤਕ ਤ੍ਰਿਯਾ ਕਹ ਦਈ ॥੯॥",
      "transliteration": "kachh dhan mritak tirayaa keh dhiee ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕੁਝ ਧਨ ਮ੍ਰਿਤਕ ਦੀ ਇਸਤਰੀ ਨੂੰ ਦੇ ਦਿੱਤਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "कछु धन मृतक तृया कह दई ॥९॥",
      "sourceLineId": "131525",
      "sourceShabadId": "12462",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "131526",
      "sourceShabadId": "12463",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਹ ਛਲ ਅਪਨੋ ਭ੍ਰਾਤ ਹਤਿ ਲੀਨੀ ਕਬੁਜਿ ਲਿਖਾਇ ॥",
      "transliteration": "eeh chhal apano bhraat hat leenee kabuj likhai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਆਪਣੇ ਭਰਾ ਨੂੰ ਮਾਰ ਕੇ ਰਸੀਦ ਲਿਖਵਾ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "इह छल अपनो भ्रात हति लीनी कबुजि लिखाइ ॥",
      "sourceLineId": "131527",
      "sourceShabadId": "12463",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਿਸਾ ਕਰੀ ਤਿਹ ਨਾਰਿ ਕੀ ਸਭ ਧਨ ਗਈ ਪਚਾਇ ॥੧੦॥",
      "transliteration": "nisaa karee teh naar kee sabh dhan giee pachai ||10||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪਤਨੀ ਦੀ ਵੀ ਤਸੱਲੀ ਕਰਾ ਕੇ ਸਾਰਾ ਧਨ ਪਚਾ ਗਈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "निसा करी तिह नारि की सभ धन गई पचाइ ॥१०॥",
      "sourceLineId": "131528",
      "sourceShabadId": "12463",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਸਤਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੮੭॥੫੪੫੧॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau sataasee charitr samaapatam sat subham sat ||287||5451||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੮੭ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੮੭॥੫੪੫੧॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ सतासी चरित्र समापतम सतु सुभम सतु ॥२८७॥५४५१॥अफजूँ॥",
      "sourceLineId": "131529",
      "sourceShabadId": "12463",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131530",
      "sourceShabadId": "12464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਯੂਨਾ ਸਹਿਰ ਰੂਮ ਮਹਿ ਜਹਾ ॥",
      "transliteration": "yoonaa sahir room meh jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਰੂਮ (ਦੇਸ) ਵਿਚ ਜਿਥੇ ਯੂਨਾ ਨਾ ਦਾ ਨਗਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "यूना सहिर रूम महि जहा ॥",
      "sourceLineId": "131531",
      "sourceShabadId": "12464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੇਵ ਛਤ੍ਰ ਰਾਜਾ ਇਕ ਤਹਾ ॥",
      "transliteration": "dhev chhatr raajaa ik tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਛਤ੍ਰ ਦੇਵ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "देव छत्र राजा इक तहा ॥",
      "sourceLineId": "131532",
      "sourceShabadId": "12464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਛੈਲ ਦੇਇ ਦੁਹਿਤਾ ਤਾ ਕੇ ਇਕ ॥",
      "transliteration": "chhail dhei dhuhitaa taa ke ik ||",
      "translation": "",
      "punjabiViakhya": "ਛੈਲ ਦੇਈ ਨਾ ਦੀ ਉਸ ਦੀ ਇਕ ਪੁੱਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "छैल देइ दुहिता ता के इक ॥",
      "sourceLineId": "131533",
      "sourceShabadId": "12464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪੜੀ ਬ੍ਯਾਕਰਨ ਕੋਕ ਸਾਸਤ੍ਰਨਿਕ ॥੧॥",
      "transliteration": "paRee bayaakaran kok saasatranik ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਅਨੇਕ ਵਿਆਕਰਨ ਅਤੇ ਕੋਕ ਸ਼ਾਸਤ੍ਰ ਪੜ੍ਰਹੀ ਹੋਈ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "पड़ी ब्याकरन कोक सासत्रनिक ॥१॥",
      "sourceLineId": "131534",
      "sourceShabadId": "12464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਜਿਤ ਸੈਨ ਤਿਹ ਠਾ ਇਕ ਛਤ੍ਰੀ ॥",
      "transliteration": "ajit sain teh Thaa ik chhatree ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਅਜਿਤ ਸੈਨ ਨਾ ਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "अजित सैन तिह ठा इक छत्री ॥",
      "sourceLineId": "131535",
      "sourceShabadId": "12464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤੇਜਵਾਨ ਬਲਵਾਨ ਧਰਤ੍ਰੀ ॥",
      "transliteration": "tejavaan balavaan dharatree ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਤੇਜਵੰਤ, ਬਲਵਾਨ ਅਤੇ ਅਸਤ੍ਰ-ਧਾਰੀ ਛਤ੍ਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "तेजवान बलवान धरत्री ॥",
      "sourceLineId": "131536",
      "sourceShabadId": "12464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰੂਪਵਾਨ ਬਲਵਾਨ ਅਪਾਰਾ ॥",
      "transliteration": "roopavaan balavaan apaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬਹੁਤ ਰੂਪਵਾਨ ਅਤੇ ਬਹਾਦਰ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "रूपवान बलवान अपारा ॥",
      "sourceLineId": "131537",
      "sourceShabadId": "12464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪੂਰੋ ਪੁਰਖ ਜਗਤ ਉਜਿਯਾਰਾ ॥੨॥",
      "transliteration": "pooro purakh jagat ujiyaaraa ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਗਤ ਵਿਚ ਪੂਰਨ ਪੁਰਸ਼ ਵਜੋਂ ਉਜਾਗਰ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "पूरो पुरख जगत उजियारा ॥२॥",
      "sourceLineId": "131538",
      "sourceShabadId": "12464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤੇਜਵਾਨ ਦੁਤਿਵਾਨ ਅਤੁਲ ਬਲ ॥",
      "transliteration": "tejavaan dhutivaan atul bal ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਤੇਜਵਾਨ, ਸੁੰਦਰ ਅਤੇ ਅਤੁਲ ਬਲ ਵਾਲਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "तेजवान दुतिवान अतुल बल ॥",
      "sourceLineId": "131539",
      "sourceShabadId": "12464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਰਿ ਅਨੇਕ ਜੀਤੇ ਜਿਨ ਦਲਿ ਮਲਿ ॥",
      "transliteration": "ar anek jeete jin dhal mal ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਅਨੇਕ ਵੈਰੀ ਮਸਲ ਕੇ ਜਿਤ ਲਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "अरि अनेक जीते जिन दलि मलि ॥",
      "sourceLineId": "131540",
      "sourceShabadId": "12464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਵਤ ਤਾਹਿ ਬਿਲੋਕ੍ਯੋ ਰਾਨੀ ॥",
      "transliteration": "aavat taeh bilokayo raanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਆਉਾਂਦਿਆਂ ਰਾਣੀ ਨੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "आवत ताहि बिलोक्यो रानी ॥",
      "sourceLineId": "131541",
      "sourceShabadId": "12464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦੁਹਿਤਾ ਸੋ ਇਹ ਭਾਤਿ ਬਖਾਨੀ ॥੩॥",
      "transliteration": "dhuhitaa so ieh bhaat bakhaanee ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੁੱਤਰੀ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "दुहिता सो इह भाति बखानी ॥३॥",
      "sourceLineId": "131542",
      "sourceShabadId": "12464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜੌ ਇਹ ਧਾਮ ਨ੍ਰਿਪਤਿ ਕੇ ਹੋਤੋ ॥",
      "transliteration": "jau ieh dhaam nirapat ke hoto ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਇਹ (ਕਿਸੇ) ਰਾਜੇ ਦੇ ਘਰ (ਪੈਦਾ) ਹੋਇਆ ਹੁੰਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "जौ इह धाम नृपति के होतो ॥",
      "sourceLineId": "131543",
      "sourceShabadId": "12464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤੌ ਤੁਮਰੇ ਲਾਇਕ ਬਰ ਕੋ ਥੋ ॥",
      "transliteration": "tau tumare laik bar ko tho ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਤੇਰੇ ਲਈ ਯੋਗ ਵਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "तौ तुमरे लाइक बर को थो ॥",
      "sourceLineId": "131544",
      "sourceShabadId": "12464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਬ ਮੈ ਅਸ ਕਹ ਕਰੌ ਉਪਾਊ ॥",
      "transliteration": "ab mai as keh karau upaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਹੁਣ ਇਹੋ ਜਿਹਾ ਉਪਾ ਕਰਦੀ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "अब मै अस कह करौ उपाऊ ॥",
      "sourceLineId": "131545",
      "sourceShabadId": "12464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਐਸੋ ਬਰ ਤੁਹਿ ਆਨ ਮਿਲਾਊ ॥੪॥",
      "transliteration": "aaiso bar tuh aan milaauoo ||4||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੈਨੂੰ ਅਜਿਹਾ ਵਰ ਲਭ ਕੇ ਲਿਆ ਦਿਆਂ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "ऐसो बर तुहि आन मिलाऊ ॥४॥",
      "sourceLineId": "131546",
      "sourceShabadId": "12464",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "131547",
      "sourceShabadId": "12465",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਨਿਕ ਕੁਅਰਿ ਕੇ ਧੁਨਿ ਜਬ ਅਸਿ ਕਾਨਨ ਪਰੀ ॥",
      "transliteration": "tanik kuar ke dhun jab as kaanan paree ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜ ਕੁਮਾਰੀ ਦੇ ਕੰਨ ਵਿਚ ਮਾੜੀ ਜਿੰਨੀ ਭਿਣਕ ਪਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "तनिक कुअरि के धुनि जब असि कानन परी ॥",
      "sourceLineId": "131548",
      "sourceShabadId": "12465",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦੇਖਿ ਰਹੀ ਤਹਿ ਓਰ ਮੈਨ ਅਰੁ ਮਦ ਭਰੀ ॥",
      "transliteration": "dhekh rahee teh or main ar madh bharee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਕਾਮ ਅਤੇ (ਸੁੰਦਰਤਾ ਦੇ) ਮਦ ਵਿਚ ਮਸਤ ਹੋ ਕੇ ਉਸ ਵਲ ਵੇਖਣ ਲਗ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "देखि रही तहि ओर मैन अरु मद भरी ॥",
      "sourceLineId": "131549",
      "sourceShabadId": "12465",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮੋਹਿ ਰਹੀ ਮਨ ਮਾਹਿ ਨ ਪ੍ਰਗਟ ਜਤਾਇਯੋ ॥",
      "transliteration": "moh rahee man maeh na pragaT jataiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮਨ ਵਿਚ ਮੋਹਿਤ ਹੋ ਗਈ, ਪਰ ਕਿਸੇ ਅਗੇ ਪ੍ਰਗਟ ਨਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "मोहि रही मन माहि न प्रगट जताइयो ॥",
      "sourceLineId": "131550",
      "sourceShabadId": "12465",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹੋ ਪਲ ਪਲ ਬਲਿ ਬਲਿ ਜਾਤੀ ਦਿਵਸ ਗਵਾਇਯੋ ॥੫॥",
      "transliteration": "ho pal pal bal bal jaatee dhivas gavaiyo ||5||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਉਤੋਂ ਪਲ ਪਲ ਵਾਰਨੇ ਹੁੰਦੀ ਹੋਈ ਨੇ ਸਾਰਾ ਦਿਨ ਬਤੀਤ ਕਰ ਦਿੱਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "हो पल पल बलि बलि जाती दिवस गवाइयो ॥५॥",
      "sourceLineId": "131551",
      "sourceShabadId": "12465",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131552",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰੈਨਿ ਭਏ ਸਹਚਰੀ ਬੁਲਾਈ ॥",
      "transliteration": "rain bhe sahacharee bulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਹੋਣ ਤੇ ਉਸ ਨੇ ਦਾਸੀ ਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "रैनि भए सहचरी बुलाई ॥",
      "sourceLineId": "131553",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1222_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚਿਤ ਬ੍ਰਿਥਾ ਤਿਹ ਸਕਲ ਸੁਨਾਈ ॥",
      "transliteration": "chit birathaa teh sakal sunaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ (ਆਪਣੇ) ਮਨ ਦੀ ਸਾਰੀ ਵਿਥਿਆ ਸੁਣਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1222,
      "hindi": "",
      "hindiTransliteration": "चित बृथा तिह सकल सुनाई ॥",
      "sourceLineId": "131554",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
