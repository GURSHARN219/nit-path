{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1223,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1223_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜੌ ਤਿਹ ਦੈ ਮਿਲਾਇ ਮੁਹਿ ਪ੍ਯਾਰੀ ॥",
      "transliteration": "jau teh dhai milai muh payaaree ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਿਆਰੀ! ਜੇ ਤੂੰ ਮੈਨੂੰ ਉਸ ਨਾਲ ਮਿਲਾ ਦੇਵੇਾਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "जौ तिह दै मिलाइ मुहि प्यारी ॥",
      "sourceLineId": "131555",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤੌ ਜਾਨੌ ਤੂ ਹਿਤੂ ਹਮਾਰੀ ॥੬॥",
      "transliteration": "tau jaanau too hitoo hamaaree ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਾ (ਮੈਂ) ਜਾਣਾਗੀ ਕਿ ਤੂੰ ਮੇਰੀ ਹਿਤੂ ਹੈਂ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "तौ जानौ तू हितू हमारी ॥६॥",
      "sourceLineId": "131556",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਹਿਯੋ ਕੁਅਰਿ ਸਹਚਰਿ ਸੌ ਜਾਨਾ ॥",
      "transliteration": "kahiyo kuar sahachar sau jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ (ਜੋ) ਕਿਹਾ, ਉਹ ਸਖੀ ਨੇ ਸਮਝ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "कहियो कुअरि सहचरि सौ जाना ॥",
      "sourceLineId": "131557",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭੇਦ ਨ ਦੂਸਰ ਕਾਨ ਬਖਾਨਾ ॥",
      "transliteration": "bhedh na dhoosar kaan bakhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਕਿਸੇ ਹੋਰ ਨੂੰ ਇਹ ਭੇਦ ਨਾ ਦਸਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "भेद न दूसर कान बखाना ॥",
      "sourceLineId": "131558",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਤਛਿਨ ਦੌਰ ਤਵਨ ਪਹਿ ਗਈ ॥",
      "transliteration": "tatachhin dhauar tavan peh giee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਦਾਸੀ) ਤੁਰਤ ਦੌੜ ਕੇ ਉਸ (ਵਿਅਕਤੀ) ਕੋਲ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "ततछिन दौर तवन पहि गई ॥",
      "sourceLineId": "131559",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਤਾਹਿ ਪ੍ਰਬੋਧਤ ਭਈ ॥੭॥",
      "transliteration": "bahu bidh taeh prabodhat bhiee ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਕਈ ਤਰ੍ਰਹਾ ਨਾਲ ਸਮਝਾਣ ਲਗੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि ताहि प्रबोधत भई ॥७॥",
      "sourceLineId": "131560",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਤਾਹਿ ਪ੍ਰਬੋਧ ਜਤਾਈ ॥",
      "transliteration": "bahu bidh taeh prabodh jataiee ||",
      "translation": "",
      "punjabiViakhya": "(ਦਾਸੀ ਨੇ) ਉਸ ਨੂੰ ਕਈ ਤਰ੍ਰਹਾ ਨਾਲ ਸਮਝਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि ताहि प्रबोध जताई ॥",
      "sourceLineId": "131561",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਤਾਹਿ ਤਹਾ ਲੈ ਆਈ ॥",
      "transliteration": "jayo(n) tayo(n) taeh tahaa lai aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਉਸ ਨੂੰ ਉਥੇ ਲੈ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "ज्यों त्यों ताहि तहा लै आई ॥",
      "sourceLineId": "131562",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਾਰਗ ਕੁਅਰਿ ਬਿਲੋਕ ਜਹਾ ॥",
      "transliteration": "maarag kuar bilok jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਰਾਜਾ ਕੁਮਾਰੀ (ਉਸ ਦੀ) ਵਾਟ ਜੋਹ ਰਹੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "मारग कुअरि बिलोक जहा ॥",
      "sourceLineId": "131563",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਲੈ ਪਹੁਚੀ ਮਿਤਵਾ ਕਹ ਤਹਾ ॥੮॥",
      "transliteration": "lai pahuchee mitavaa keh tahaa ||8||",
      "translation": "",
      "punjabiViakhya": "(ਦਾਸੀ) ਮਿਤਰ ਨੂੰ ਲੈ ਕੇ ਉਥੇ ਆ ਪਹੁੰਚੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "लै पहुची मितवा कह तहा ॥८॥",
      "sourceLineId": "131564",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਲਖਿ ਤਿਹ ਕੁਅਰਿ ਪ੍ਰਫੁਲਿਤ ਭਈ ॥",
      "transliteration": "lakh teh kuar prafulit bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਰਾਜ ਕੁਮਾਰੀ ਖਿੜ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "लखि तिह कुअरि प्रफुलित भई ॥",
      "sourceLineId": "131565",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਨੁਕ ਰਾਕ ਨਵੋ ਨਿਧਿ ਪਈ ॥",
      "transliteration": "januk raak navo nidh piee ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ (ਕਿਸੇ) ਰੰਕ ਨੇ ਨੌਂ ਨਿੱਧੀਆਂ ਪ੍ਰਾਪਤ ਕੀਤੀਆਂ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "जनुक राक नवो निधि पई ॥",
      "sourceLineId": "131566",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਿਹਸਿ ਬਿਹਸਿ ਤਿਹ ਕੰਠ ਲਗਾਯੋ ॥",
      "transliteration": "bihas bihas teh ka(n)Th lagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ (ਰਾਜ ਕੁਮਾਰੀ ਨੇ) ਹਸ ਹਸ ਕੇ ਗਲੇ ਨਾਲ ਲਗਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "बिहसि बिहसि तिह कंठ लगायो ॥",
      "sourceLineId": "131567",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਨ ਮਾਨਤ ਕੋ ਭੋਗ ਕਮਾਯੋ ॥੯॥",
      "transliteration": "man maanat ko bhog kamaayo ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਨਾਲ) ਮਨ ਭਾਉਾਂਦਾ ਸੰਯੋਗ ਕੀਤਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "मन मानत को भोग कमायो ॥९॥",
      "sourceLineId": "131568",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਾ ਕੋ ਦੂਰ ਦਰਿਦ੍ਰ ਦਿਯਾ ਕਰਿ ॥",
      "transliteration": "taa ko dhoor dharidhr dhiyaa kar ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜ ਕੁਮਾਰੀ ਨੇ) ਉਸ (ਦਾਸੀ) ਦੀ ਗ਼ਰੀਬੀ ਦੂਰ ਕਰ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "ता को दूर दरिद्र दिया करि ॥",
      "sourceLineId": "131569",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੀਸ ਰਹੀ ਧਰ ਸਖੀ ਪਗਨ ਪਰ ॥",
      "transliteration": "sees rahee dhar sakhee pagan par ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਖੀ ਦੇ ਪੈਰਾ ਉਤੇ ਸਿਰ ਧਰਨ ਲਗ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "सीस रही धर सखी पगन पर ॥",
      "sourceLineId": "131570",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਵਪ੍ਰਸਾਦ ਮੈ ਮਿਤ੍ਰਹਿ ਲਹਿਯੋ ॥",
      "transliteration": "tavaprasaadh mai mitreh lahiyo ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿਣ ਲਗੀ) ਤੇਰੀ ਕ੍ਰਿਪਾ ਨਾਲ ਹੀ ਮੈਂ ਮਿਤਰ ਨੂੰ ਪ੍ਰਾਪਤ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "तवप्रसाद मै मित्रहि लहियो ॥",
      "sourceLineId": "131571",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਹਾ ਕਹੋ ਤੁਹਿ ਜਾਤ ਨ ਕਹਿਯੋ ॥੧੦॥",
      "transliteration": "kahaa kaho tuh jaat na kahiyo ||10||",
      "translation": "",
      "punjabiViakhya": "ਤੈਨੂੰ ਕੀ ਕਹਾ? ਕੁਝ ਕਿਹਾ ਨਹੀਂ ਜਾਦਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "कहा कहो तुहि जात न कहियो ॥१०॥",
      "sourceLineId": "131572",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਬ ਕਛੁ ਐਸ ਚਰਿਤ੍ਰ ਬਨੈਯੇ ॥",
      "transliteration": "ab kachh aais charitr banaiye ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਕੁਝ ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਚਰਿਤ੍ਰ ਕਰਨਾ ਚਾਹੀਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "अब कछु ऐस चरित्र बनैये ॥",
      "sourceLineId": "131573",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਾ ਤੇ ਸਦਾ ਮਿਤ੍ਰ ਕਹ ਪੈਯੇ ॥",
      "transliteration": "jaa te sadhaa mitr keh paiye ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੁਆਰਾ ਮਿਤਰ ਨੂੰ ਸਦਾ ਲਈ ਪ੍ਰਾਪਤ ਕੀਤਾ ਜਾ ਸਕੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "जा ते सदा मित्र कह पैये ॥",
      "sourceLineId": "131574",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੋਵੌ ਸਦਾ ਸੰਗ ਲੈ ਤਾ ਕੌ ॥",
      "transliteration": "sovau sadhaa sa(n)g lai taa kau ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸਦਾ ਨਾਲ ਲੈ ਕੇ ਸੌਵਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "सोवौ सदा संग लै ता कौ ॥",
      "sourceLineId": "131575",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੀਨਿ ਸਕੈ ਕੋਊ ਨਹਿ ਵਾ ਕੌ ॥੧੧॥",
      "transliteration": "cheen sakai kouoo neh vaa kau ||11||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਸ ਨੂੰ ਹੋਰ ਕੋਈ ਜਾਣ ਨਾ ਸਕੇ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "चीनि सकै कोऊ नहि वा कौ ॥११॥",
      "sourceLineId": "131576",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤ੍ਰਿਯ ਚਰਿਤ੍ਰ ਅਸ ਚਿਤ ਬਿਚਾਰੇ ॥",
      "transliteration": "tiray charitr as chit bichaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਇਸਤਰੀ ਨੇ ਮਨ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਚਰਿਤ੍ਰ ਵਿਚਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "तृय चरित्र अस चित बिचारे ॥",
      "sourceLineId": "131577",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੁ ਮੈ ਕਹਤ ਹੋ ਸੁਨਹੁ ਪ੍ਯਾਰੇ ॥",
      "transliteration": "s mai kahat ho sunahu payaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮੈਂ ਕਹਿੰਦਾ ਹਾ, ਹੇ ਪਿਆਰੇ (ਰਾਜਨ)! ਸੁਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "सु मै कहत हो सुनहु प्यारे ॥",
      "sourceLineId": "131578",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਾਹਿ ਛਪਾਇ ਸਦਨ ਮਹਿ ਰਾਖਾ ॥",
      "transliteration": "taeh chhapai sadhan meh raakhaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਘਰ ਵਿਚ ਲੁਕਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "ताहि छपाइ सदन महि राखा ॥",
      "sourceLineId": "131579",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਾਨੀ ਸੌ ਐਸੀ ਬਿਧਿ ਭਾਖਾ ॥੧੨॥",
      "transliteration": "raanee sau aaisee bidh bhaakhaa ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "रानी सौ ऐसी बिधि भाखा ॥१२॥",
      "sourceLineId": "131580",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰਾਨੀ ਜੋ ਤੁਮ ਪੁਰਖ ਸਰਾਹਾ ॥",
      "transliteration": "raanee jo tum purakh saraahaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਨੀ (ਮਾਤਾ)! ਜਿਸ ਪੁਰਸ਼ ਨੂੰ ਤੁਸੀਂ ਸਲਾਹਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "रानी जो तुम पुरख सराहा ॥",
      "sourceLineId": "131581",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਾ ਕਹ ਸ੍ਰੀ ਬਿਸੁਨਾਥਨ ਚਾਹਾ ॥",
      "transliteration": "taa keh sree bisunaathan chaahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵਿਧਾਤਾ ਨੇ ਚਾਹਿਆ ਹੈ (ਭਾਵ ਭਗਵਾਨ ਨੂੰ ਪਿਆਰਾ ਹੋ ਗਿਆ ਹੈ)।",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "ता कह स्री बिसुनाथन चाहा ॥",
      "sourceLineId": "131582",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਵਾ ਕੋ ਕਾਲਿ ਕਾਲ ਹ੍ਵੈ ਗਯੋ ॥",
      "transliteration": "vaa ko kaal kaal havai gayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਕਲ ਹੀ ਮ੍ਰਿਤੂ ਹੋ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "वा को कालि काल ह्वै गयो ॥",
      "sourceLineId": "131583",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਯਾ ਸਖਿ ਕੇ ਮੁਖ ਤੇ ਸੁਨਿ ਲਯੋ ॥੧੩॥",
      "transliteration": "yaa sakh ke mukh te sun layo ||13||",
      "translation": "",
      "punjabiViakhya": "ਇਹ (ਗੱਲ ਇਸ) ਸਖੀ ਦੇ ਮੂੰਹ ਤੋਂ ਸੁਣ ਲਵੋ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "या सखि के मुख ते सुनि लयो ॥१३॥",
      "sourceLineId": "131584",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹਮ ਸਭਹਿਨ ਜੋ ਤਾਹਿ ਸਰਾਹਾ ॥",
      "transliteration": "ham sabhahin jo taeh saraahaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਸੀਂ ਸਾਰਿਆਂ ਨੇ ਜੋ ਉਸ ਨੂੰ ਸਲਾਹਿਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "हम सभहिन जो ताहि सराहा ॥",
      "sourceLineId": "131585",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਾ ਤੇ ਤਿਸੁ ਬਿਸੁਨਾਥਨ ਚਾਹਾ ॥",
      "transliteration": "taa te tis bisunaathan chaahaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਵਿਧਾਤਾ ਨੇ ਉਸ ਨੂੰ ਪਸੰਦ ਕਰ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "ता ते तिसु बिसुनाथन चाहा ॥",
      "sourceLineId": "131586",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਨਿਯਤ ਦ੍ਰਿਸਟਿ ਤ੍ਰਿਯਨ ਕੀ ਲਾਗੀ ॥",
      "transliteration": "janiyat dhirasaT tirayan kee laagee ||",
      "translation": "",
      "punjabiViakhya": "ਲਗਦਾ ਹੈ ਉਸ ਨੂੰ ਇਸਤਰੀਆਂ ਦੀ ਨਜ਼ਰ ਲਗ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "जनियत दृसटि तृयन की लागी ॥",
      "sourceLineId": "131587",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਾ ਤੇ ਤਾਹਿ ਮ੍ਰਿਤੁ ਲੈ ਭਾਗੀ ॥੧੪॥",
      "transliteration": "taa te taeh mrit lai bhaagee ||14||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਉਸ ਨੂੰ ਮ੍ਰਿਤੂ ਲੈ ਕੇ ਭਜ ਗਈ ਹੈ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "ता ते ताहि मृतु लै भागी ॥१४॥",
      "sourceLineId": "131588",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰਾਨੀ ਸੋਕ ਤਵਨ ਕੋ ਕਿਯੋ ॥",
      "transliteration": "raanee sok tavan ko kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਉਸ ਦਾ ਬਹੁਤ ਸੋਗ ਮੰਨਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "रानी सोक तवन को कियो ॥",
      "sourceLineId": "131589",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਾ ਦਿਨ ਅੰਨ ਨ ਪਾਨੀ ਪਿਯੋ ॥",
      "transliteration": "taa dhin a(n)n na paanee piyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦਿਨ ਤੋਂ ਨਾ ਅੰਨ ਖਾਇਆ ਅਤੇ ਨਾ ਪਾਣੀ ਪੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "ता दिन अंन न पानी पियो ॥",
      "sourceLineId": "131590",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਾਚ ਮਰਿਯੋ ਜਾਨ੍ਯੋ ਜਿਯ ਤਾ ਕੌ ॥",
      "transliteration": "saach mariyo jaanayo jiy taa kau ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸਚਮੁਚ ਮਰਿਆ ਹੋਇਆ ਮਨ ਵਿਚ ਸਮਝ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "साच मरियो जान्यो जिय ता कौ ॥",
      "sourceLineId": "131591",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਪਾਯੋ ਯਾ ਕੌ ॥੧੫॥",
      "transliteration": "bhedh abhedh na paayo yaa kau ||15||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਸ ਦਾ ਭੇਦ ਅਭੇਦ ਕੁਝ ਨਾ ਸਮਝਿਆ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न पायो या कौ ॥१५॥",
      "sourceLineId": "131592",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਸ ਤੁਮ ਸੁੰਦਰ ਯਾਹਿ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "jas tum su(n)dhar yaeh nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਦਾ ਸੁੰਦਰ ਤੁਸੀਂ ਉਹ ਵੇਖਿਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "जस तुम सुँदर याहि निहारियो ॥",
      "sourceLineId": "131593",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭਯੌ ਨ ਹੈ ਹ੍ਵੈਹੈ ਨ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "bhayau na hai havaihai na bichaariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਵਰਗਾ) ਨਾ ਕੋਈ ਸੀ, ਨਾ ਹੈ ਅਤੇ ਨਾ ਹੀ ਹੋਵੇਗਾ, ਵਿਚਾਰਿਆ ਜਾ ਸਕਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "भयौ न है ह्वैहै न बिचारियो ॥",
      "sourceLineId": "131594",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਯਾ ਕੀ ਬਹਿਨਿ ਏਕ ਤਿਹ ਘਰ ਮੈ ॥",
      "transliteration": "yaa kee bahin ek teh ghar mai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਇਕ ਭੈਣ ਘਰ ਵਿਚ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "या की बहिनि एक तिह घर मै ॥",
      "sourceLineId": "131595",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਛਾਡਿ ਅਯੋ ਜਿਹ ਭ੍ਰਾਤ ਨਗਰ ਮੈ ॥੧੬॥",
      "transliteration": "chhaadd ayo jeh bhraat nagar mai ||16||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਭਰਾ ਪਿਛੇ ਨਗਰ ਵਿਚ ਛਡ ਆਇਆ ਸੀ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "छाडि अयो जिह भ्रात नगर मै ॥१६॥",
      "sourceLineId": "131596",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮੁਹਿ ਤੁਮ ਕਹੋ ਤੁ ਤਹ ਮੈ ਜਾਊ ॥",
      "transliteration": "muh tum kaho ta teh mai jaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਣੀ ਜੀ! ਜੇ ਤੁਸੀਂ ਮੈਨੂੰ ਕਹੋ ਤਾ ਮੈਂ ਉਥੇ ਜਾਵਾ",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "मुहि तुम कहो तु तह मै जाऊ ॥",
      "sourceLineId": "131597",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਵਾ ਕੀ ਖੋਜਿ ਬਹਿਨਿ ਮੈ ਲਯਾਊ ॥",
      "transliteration": "vaa kee khoj bahin mai layaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੀ ਭੈਣ ਨੂੰ ਲਭ ਲਿਆਵਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "वा की खोजि बहिनि मै लयाऊ ॥",
      "sourceLineId": "131598",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੋ ਅਤਿ ਚਤੁਰਿ ਸਭਨ ਗੁਨ ਆਗਰਿ ॥",
      "transliteration": "so at chatur sabhan gun aagar ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬਹੁਤ ਸਿਆਣੀ ਅਤੇ ਸਭ ਗੁਣਾ ਦੀ ਖਾਣ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "सो अति चतुरि सभन गुन आगरि ॥",
      "sourceLineId": "131599",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਆਣਿ ਦਿਖਾਊ ਤੁਹਿ ਨ੍ਰਿਪ ਨਾਗਰਿ ॥੧੭॥",
      "transliteration": "aan dhikhaauoo tuh nirap naagar ||17||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਉਸ ਨੂੰ ਲਿਆ ਕੇ ਤੁਹਾਨੂੰ ਅਤੇ ਚਤੁਰ ਰਾਜੇ ਨੂੰ ਵਿਖਾਉਾਂਦੀ ਹਾ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "आणि दिखाऊ तुहि नृप नागरि ॥१७॥",
      "sourceLineId": "131600",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭਲੀ ਭਲੀ ਸਭ ਤ੍ਰਿਯ ਬਖਾਨੀ ॥",
      "transliteration": "bhalee bhalee sabh tiray bakhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਕਿਹਾ, ਸਭ 'ਠੀਕ ਹੈ, ਠੀਕ ਹੈ'",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "भली भली सभ तृय बखानी ॥",
      "sourceLineId": "131601",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1223_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਗਤਿ ਕਿਨੂੰ ਨ ਜਾਨੀ ॥",
      "transliteration": "bhedh abhedh gat kinoo(n) na jaanee ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਭੇਦ ਅਭੇਦ ਦੀ ਸਥਿਤੀ ਕਿਸੇ ਨੇ ਨਾ ਸਮਝੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1223,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद गति किनूँ न जानी ॥",
      "sourceLineId": "131602",
      "sourceShabadId": "12466",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
