{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1225,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1225_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਾਰ ਨ ਲਗੀ ਸਖੀ ਤਹ ਆਈ ॥",
      "transliteration": "baar na lagee sakhee teh aaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਜ਼ਰਾ) ਦੇਰ ਨਾ ਲਗੀ ਅਤੇ ਦਾਸੀ ਉਥੇ ਆ ਪਹੁੰਚੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "बार न लगी सखी तह आई ॥",
      "sourceLineId": "131651",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਆਨ ਕੁਅਰ ਤਨ ਬ੍ਰਿਥਾ ਜਤਾਈ ॥",
      "transliteration": "aan kuar tan birathaa jataiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਆ ਕੇ ਕੁਮਾਰ ਨੂੰ ਸਾਰੀ ਵਿਥਿਆ ਸੁਣਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "आन कुअर तन बृथा जताई ॥",
      "sourceLineId": "131652",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤੋ ਪਰ ਅਟਕਤ ਨ੍ਰਿਪ ਤ੍ਰਿਯ ਭਈ ॥",
      "transliteration": "to par aTakat nirap tiray bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੇਰੇ ਉਤੇ ਰਾਜੇ ਦੀ ਇਸਤਰੀ ਮੋਹਿਤ ਹੋ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "तो पर अटकत नृप तृय भई ॥",
      "sourceLineId": "131653",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਛੂਟਹੁ ਕਸਬ ਲਗਨ ਲਗਿ ਗਈ ॥੫॥",
      "transliteration": "chhooTahu kasab lagan lag giee ||5||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਕੰਮ ਕਾਰ ਛੁਟ ਗਿਆ ਹੈ, (ਬਸ ਇਕੋ) ਲਗਨ ਲਗ ਗਈ ਹੈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "छूटहु कसब लगन लगि गई ॥५॥",
      "sourceLineId": "131654",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਬ ਵਹ ਧਾਮ ਕ੍ਰਿਤਾਰਥ ਕੀਜੈ ॥",
      "transliteration": "ab veh dhaam kirataarath keejai ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਉਸ ਦੇ ਘਰ (ਚਲ ਕੇ ਉਸ ਨੂੰ) ਸਫਲ ਮਨੋਰਥ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "अब वह धाम कृतारथ कीजै ॥",
      "sourceLineId": "131655",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹ੍ਯਾਂ ਤੇ ਚਲਿ ਵਹਿ ਗ੍ਰਿਹ ਪਗੁ ਦੀਜੈ ॥",
      "transliteration": "hayaa(n) te chal veh gireh pag dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਇਥੋਂ ਚਲ ਕੇ ਉਸ ਦੇ ਘਰ ਚਰਨ ਪਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "ह्याँ ते चलि वहि गृह पगु दीजै ॥",
      "sourceLineId": "131656",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਉਠਹੁ ਕੁਅਰ ਜੂ ਬਿਲਮ ਨ ਲੈਯੈ ॥",
      "transliteration": "auThahu kuar joo bilam na laiyai ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਕੁਮਾਰ ਜੀ! ਜਲਦੀ ਉਠੋ, ਦੇਰ ਨਾ ਲਗਾਓ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "उठहु कुअर जू बिलम न लैयै ॥",
      "sourceLineId": "131657",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਾਜ ਤਰੁਨਿ ਕੇ ਸੇਜ ਸੁਹੈਯੈ ॥੬॥",
      "transliteration": "raaj tarun ke sej suhaiyai ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ ਰਾਣੀ ਦੀ ਸੇਜ ਨੂੰ ਸੁਹਾਵਣਾ ਕਰੋ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "राज तरुनि के सेज सुहैयै ॥६॥",
      "sourceLineId": "131658",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਿਹ ਤਿਹ ਬਿਧ ਤਾ ਕੋ ਮਨ ਲੀਨਾ ॥",
      "transliteration": "jeh teh bidh taa ko man leenaa ||",
      "translation": "",
      "punjabiViakhya": "(ਦਾਸੀ ਨੇ) ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਉਸ ਦਾ ਮਨ ਜਿਤ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "जिह तिह बिध ता को मन लीना ॥",
      "sourceLineId": "131659",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਆਨਿ ਮਿਲਾਇ ਕੁਅਰਿ ਕਹ ਦੀਨਾ ॥",
      "transliteration": "aan milai kuar keh dheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲਿਆ ਕੇ ਰਾਣੀ ਨੂੰ ਮਿਲਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "आनि मिलाइ कुअरि कह दीना ॥",
      "sourceLineId": "131660",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਿਹ ਤਾਹਿ ਰਿਝਾਯੋ ॥",
      "transliteration": "bhaat bhaat teh taeh rijhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਭਾਤ ਭਾਤ ਨਾਲ ਰਾਣੀ ਨੂੰ ਰਿਝਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तिह ताहि रिझायो ॥",
      "sourceLineId": "131661",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਚਾਰਿ ਪਹਰ ਨਿਸਿ ਭੋਗ ਕਮਾਯੋ ॥੭॥",
      "transliteration": "chaar pahar nis bhog kamaayo ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਾਰ ਪਹਿਰ ਰਾਤ ਸੰਯੋਗ ਕੀਤਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "चारि पहर निसि भोग कमायो ॥७॥",
      "sourceLineId": "131662",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕੇਲ ਕਰਤ ਨਿਸਿ ਸਕਲ ਬਿਹਾਨੀ ॥",
      "transliteration": "kel karat nis sakal bihaanee ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮ-ਕੇਲ ਕਰਦਿਆਂ ਸਾਰੀ ਰਾਤ ਬੀਤ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "केल करत निसि सकल बिहानी ॥",
      "sourceLineId": "131663",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਰਤ ਕਾਮ ਕੀ ਕੋਟਿ ਕਹਾਨੀ ॥",
      "transliteration": "karat kaam kee koT kahaanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਾਮ ਸੰਬੰਧੀ ਬਹੁਤ ਗੱਲਾ ਕਰਦੇ ਰਹੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "करत काम की कोटि कहानी ॥",
      "sourceLineId": "131664",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਆਸਨ ਕਰਿ ਕੈ ॥",
      "transliteration": "bhaat bhaat ke aasan kar kai ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦੇ ਆਸਣ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के आसन करि कै ॥",
      "sourceLineId": "131665",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਾਮ ਤਪਤ ਸਭ ਹੀ ਕਹਿ ਹਰਿ ਕੈ ॥੮॥",
      "transliteration": "kaam tapat sabh hee keh har kai ||8||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮ ਦੇ ਸਾਰੇ ਤਾਪ ਨੂੰ ਦੂਰ ਕਰ ਦਿੱਤਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "काम तपत सभ ही कहि हरि कै ॥८॥",
      "sourceLineId": "131666",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਭੋਰ ਭਯੋ ਰਜਨੀ ਜਬ ਗਈ ॥",
      "transliteration": "bhor bhayo rajanee jab giee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਰਾਤ ਬੀਤ ਗਈ ਅਤੇ ਸਵੇਰ ਹੋ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "भोर भयो रजनी जब गई ॥",
      "sourceLineId": "131667",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਚਿਰਈ ਚੁਹਚਈ ॥",
      "transliteration": "bhaat bhaat chiriee chuhachiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਕਈ ਤਰ੍ਰਹਾ ਦੀਆਂ ਚਿੜੀਆਂ ਚਿਚਲਾਉਣ ਲਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "भाति भाति चिरई चुहचई ॥",
      "sourceLineId": "131668",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸ੍ਰਮਿਤ ਭਏ ਦੋਊ ਕੇਲ ਕਮਾਤੇ ॥",
      "transliteration": "sramit bhe dhouoo kel kamaate ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮ ਕਰਦਿਆਂ ਦੋਵੇਾਂ ਥਕ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "स्रमित भए दोऊ केल कमाते ॥",
      "sourceLineId": "131669",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਏਕਹਿ ਸੇਜ ਸੋਏ ਰਸ ਮਾਤੇ ॥੯॥",
      "transliteration": "ekeh sej soe ras maate ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਕਾਮ) ਰਸ ਵਿਚ ਮਸਤੇ ਹੋਏ ਇਕੋ ਸੇਜ ਉਤੇ ਸੌਂ ਗਏ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "एकहि सेज सोए रस माते ॥९॥",
      "sourceLineId": "131670",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੋਵਤ ਤ੍ਯਾਗ ਨੀਦਿ ਜਬ ਜਗੇ ॥",
      "transliteration": "sovat tayaag needh jab jage ||",
      "translation": "",
      "punjabiViakhya": "ਸੌਣ ਤੋਂ ਬਾਦ ਜਦ ਨੀਂਦਰ ਨੂੰ ਤਿਆਗ ਕੇ ਜਾਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "सोवत त्याग नीदि जब जगे ॥",
      "sourceLineId": "131671",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਿਲਿ ਕਰਿ ਕੇਲ ਕਰਨ ਤਬ ਲਗੇ ॥",
      "transliteration": "mil kar kel karan tab lage ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਫਿਰ) ਮਿਲ ਕੇ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਨ ਲਗ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "मिलि करि केल करन तब लगे ॥",
      "sourceLineId": "131672",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਆਸਨ ਕਰਤ ਅਨੇਕ ਪ੍ਰਕਾਰਾ ॥",
      "transliteration": "aasan karat anek prakaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੇਕ ਤਰ੍ਰਹਾ ਦੇ ਆਸਣ ਕਰਨ ਲਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "आसन करत अनेक प्रकारा ॥",
      "sourceLineId": "131673",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕੋਕਹੁੰ ਤੇ ਦਸ ਗੁਨ ਬਿਸਤਾਰਾ ॥੧੦॥",
      "transliteration": "kokahu(n) te dhas gun bisataaraa ||10||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਕੋਕ ਸ਼ਾਸਤ੍ਰ ਤੋਂ ਦਸ ਗੁਣਾ ਜ਼ਿਆਦਾ ਸਨ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "कोकहुँ ते दस गुन बिसतारा ॥१०॥",
      "sourceLineId": "131674",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕੇਲ ਕਮਾਤ ਅਧਿਕ ਰਸ ਮਾਤੈ ॥",
      "transliteration": "kel kamaat adhik ras maatai ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਨ ਵਿਚ ਬਹੁਤ ਮਗਨ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "केल कमात अधिक रस मातै ॥",
      "sourceLineId": "131675",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭੂਲਿ ਗਈ ਘਰ ਕੀ ਸੁਧਿ ਸਾਤੈ ॥",
      "transliteration": "bhool giee ghar kee sudh saatai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘਰ ਦੀ ਸੱਤੇ ਸੁੱਧਾ ਭੁਲ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "भूलि गई घर की सुधि सातै ॥",
      "sourceLineId": "131676",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚਿਤ ਅਪਨੋ ਅਸ ਕੀਯਾ ਬਿਚਾਰਾ ॥",
      "transliteration": "chit apano as keeyaa bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਰਾਣੀ ਨੇ) ਮਨ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਵਿਚਾਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "चित अपनो अस कीया बिचारा ॥",
      "sourceLineId": "131677",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪ੍ਰਗਟ ਮਿਤ੍ਰ ਕੇ ਸਾਥ ਉਚਾਰਾ ॥੧੧॥",
      "transliteration": "pragaT mitr ke saath uchaaraa ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਿਤਰ ਨੂੰ ਸਪਸ਼ਟ ਦਸਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "प्रगट मित्र के साथ उचारा ॥११॥",
      "sourceLineId": "131678",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੁਨਹੁ ਬਾਤ ਪ੍ਯਾਰੇ ਤੁਮ ਮੇਰੀ ॥",
      "transliteration": "sunahu baat payaare tum meree ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਿਆਰੇ! ਤੁਸੀਂ ਮੇਰੀ ਗੱਲ ਸੁਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "सुनहु बात प्यारे तुम मेरी ॥",
      "sourceLineId": "131679",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦਾਸੀ ਭਈ ਆਜ ਮੈ ਤੇਰੀ ॥",
      "transliteration": "dhaasee bhiee aaj mai teree ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਅਜ ਤੋਂ ਤੁਹਾਡੀ ਦਾਸੀ ਹੋ ਗਈ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "दासी भई आज मै तेरी ॥",
      "sourceLineId": "131680",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮੇਰੇ ਤੋਟ ਦਰਬ ਕੀ ਨਾਹੀ ॥",
      "transliteration": "mere toT dharab kee naahee ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਧਨ ਦੀ ਕੋਈ ਘਾਟ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "मेरे तोट दरब की नाही ॥",
      "sourceLineId": "131681",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਹਮ ਤੁਮ ਆਵਹੁ ਕਹੂੰ ਸਿਧਾਹੀ ॥੧੨॥",
      "transliteration": "ham tum aavahu kahoo(n) sidhaahee ||12||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਲਈ) ਆਓ ਤੁਸੀਂ ਅਤੇ ਮੈਂ ਕਿਧਰੇ ਨਿਕਲ ਚਲੀਏ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "हम तुम आवहु कहूँ सिधाही ॥१२॥",
      "sourceLineId": "131682",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਐਸੋ ਜਤਨ ਮਿਤ੍ਰ ਕਛੁ ਕਰਿਯੈ ॥",
      "transliteration": "aaiso jatan mitr kachh kariyai ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮਿਤਰ! ਕੋਈ ਅਜਿਹਾ ਯਤਨ ਕਰੋ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "ऐसो जतन मित्र कछु करियै ॥",
      "sourceLineId": "131683",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਪਨੇ ਲੈ ਮੁਹਿ ਸੰਗ ਸਿਧਰਿਯੈ ॥",
      "transliteration": "apane lai muh sa(n)g sidhariyai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮੈਨੂੰ ਨਾਲ ਲੈ ਕੇ ਚਲੇ ਜਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "अपने लै मुहि संग सिधरियै ॥",
      "sourceLineId": "131684",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਤਿਥ ਭੇਸ ਦੋਊ ਧਰਿ ਲੈਹੈਂ ॥",
      "transliteration": "atith bhes dhouoo dhar laihai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਸਾਧਭੇਸ ਧਾਰਨ ਕਰ ਲਵਾਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "अतिथ भेस दोऊ धरि लैहैं ॥",
      "sourceLineId": "131685",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਕ ਠਾ ਬੈਠ ਖਜਾਨਾ ਖੈਹੈਂ ॥੧੩॥",
      "transliteration": "eik Thaa baiTh khajaanaa khaihai(n) ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਥਾ ਤੇ ਟਿਕ ਕੇ ਖ਼ਜ਼ਾਨਾ ਖਾਵਾਗੇ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "इक ठा बैठ खजाना खैहैं ॥१३॥",
      "sourceLineId": "131686",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਾਰ ਕਹਿਯੋ ਅਬਲਾ ਸੌ ਐਸੇ ॥",
      "transliteration": "jaar kahiyo abalaa sau aaise ||",
      "translation": "",
      "punjabiViakhya": "ਯਾਰ ਨੇ ਇਸਤਰੀ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "जार कहियो अबला सौ ऐसे ॥",
      "sourceLineId": "131687",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤੁਹਿ ਨਿਕਸੇ ਲੈ ਕਰਿ ਸੰਗਿ ਕੈਸੇ ॥",
      "transliteration": "tuh nikase lai kar sa(n)g kaise ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਤੈਨੂੰ ਨਾਲ ਲੈ ਕੇ ਕਿਵੇਾਂ ਨਿਕਲਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "तुहि निकसे लै करि संगि कैसे ॥",
      "sourceLineId": "131688",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਠਾਢੇ ਈਹਾ ਅਨਿਕ ਰਖਵਾਰੇ ॥",
      "transliteration": "Thaadde ieehaa anik rakhavaare ||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਅਨੇਕ ਰਖਵਾਲੇ ਖੜੋਤੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "ठाढे ईहा अनिक रखवारे ॥",
      "sourceLineId": "131689",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਭ ਕੇ ਜਾਤ ਪਖੇਰੂ ਮਾਰੈ ॥੧੪॥",
      "transliteration": "nabh ke jaat pakheroo maarai ||14||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਆਕਾਸ਼ ਵਿਚ ਉਡਦੇ ਪੰਖੇਰੂਆਂ ਨੂੰ ਵੀ ਮਾਰ ਦਿੰਦੇ ਹਨ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "नभ के जात पखेरू मारै ॥१४॥",
      "sourceLineId": "131690",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜੌ ਤੁਹਿ ਮੁਹਿ ਕੌ ਨ੍ਰਿਪਤਿ ਨਿਹਾਰੈ ॥",
      "transliteration": "jau tuh muh kau nirapat nihaarai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੈਨੂੰ ਅਤੇ ਮੈਨੂੰ ਰਾਜਾ ਵੇਖ ਲਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "जौ तुहि मुहि कौ नृपति निहारै ॥",
      "sourceLineId": "131691",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੁਹੂੰਅਨ ਠੌਰ ਮਾਰਿ ਕਰ ਡਾਰੈ ॥",
      "transliteration": "dhuhoo(n)an Thauar maar kar ddaarai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸਾਨੂੰ ਦੋਹਾ ਨੂੰ ਥਾ ਮਾਰ ਦੇਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "दुहूँअन ठौर मारि कर डारै ॥",
      "sourceLineId": "131692",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਾ ਤੇ ਤੁਮ ਅਸ ਕਰਹੁ ਉਪਾਵੈ ॥",
      "transliteration": "taa te tum as karahu upaavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਤੂੰ ਅਜਿਹਾ ਉਪਾ ਕਰ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "ता ते तुम अस करहु उपावै ॥",
      "sourceLineId": "131693",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮੁਰ ਤੁਰ ਭੇਦ ਨ ਦੂਸਰ ਪਾਵੈ ॥੧੫॥",
      "transliteration": "mur tur bhedh na dhoosar paavai ||15||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮੇਰੇ ਤੇਰੇ ਬਿਨਾ ਹੋਰ ਕੋਈ ਭੇਦ ਨਾ ਪਾ ਸਕੇ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "मुर तुर भेद न दूसर पावै ॥१५॥",
      "sourceLineId": "131694",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੂਰ ਸੂਰ ਕਰਿ ਗਿਰੀ ਤਰੁਨਿ ਧਰਿ ॥",
      "transliteration": "soor soor kar giree tarun dhar ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ ਤੁਰਤ ਚਰਿਤ੍ਰ ਖੇਡਿਆ) 'ਸੂਲ ਸੂਲ' ਕਰਦੀ ਰਾਣੀ ਧਰਤੀ ਉਤੇ ਡਿਗ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "सूर सूर करि गिरी तरुनि धरि ॥",
      "sourceLineId": "131695",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਾਨੁਕ ਗਈ ਸਾਚੁ ਦੈਕੈ ਮਰਿ ॥",
      "transliteration": "jaanuk giee saach dhaikai mar ||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਣ ਲਗੀ) ਮਾਨੋ ਸਚੀ ਮੁਚੀ ਮਰ ਗਈ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "जानुक गई साचु दैकै मरि ॥",
      "sourceLineId": "131696",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਾਇ ਹਾਇ ਕਹ ਨਾਥ ਉਚਾਈ ॥",
      "transliteration": "hai hai keh naath uchaiee ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਇ ਹਾਇ' ਕਹਿ ਕੇ ਪਤੀ ਨੂੰ ਬੁਲਾਉਣ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "हाइ हाइ कह नाथ उचाई ॥",
      "sourceLineId": "131697",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬੈਦ ਲਏ ਸਭ ਨਿਕਟਿ ਬੁਲਾਈ ॥੧੬॥",
      "transliteration": "baidh le sabh nikaT bulaiee ||16||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸਾਰੇ ਵੈਦਾ ਨੂੰ ਕੋਲ ਬੁਲਾ ਲਿਆ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "बैद लए सभ निकटि बुलाई ॥१६॥",
      "sourceLineId": "131698",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਭ ਬੈਦਨ ਸੌ ਨ੍ਰਿਪਤਿ ਉਚਾਰਾ ॥",
      "transliteration": "sabh baidhan sau nirapat uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਵੈਦਾ ਪ੍ਰਤਿ ਰਾਜੇ ਨੇ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "सभ बैदन सौ नृपति उचारा ॥",
      "sourceLineId": "131699",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਯਾ ਕੋ ਕਰਹੁ ਕਛੂ ਉਪਚਾਰਾ ॥",
      "transliteration": "yaa ko karahu kachhoo upachaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਸ ਦਾ ਕੁਝ ਉਪਚਾਰ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "या को करहु कछू उपचारा ॥",
      "sourceLineId": "131700",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜਾ ਤੇ ਰਾਨੀ ਮਰੈ ਨ ਪਾਵੈ ॥",
      "transliteration": "jaa te raanee marai na paavai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਜੋ ਰਾਣੀ ਮਰ ਨਾ ਸਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "जा ते रानी मरै न पावै ॥",
      "sourceLineId": "131701",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਬਹੁਰਿ ਹਮਾਰੀ ਸੇਜ ਸੁਹਾਵੈ ॥੧੭॥",
      "transliteration": "bahur hamaaree sej suhaavai ||17||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੀ ਸੇਜ ਨੂੰ ਫਿਰ ਤੋਂ ਸੁਹਾਵਣਾ ਬਣਾਵੇ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "बहुरि हमारी सेज सुहावै ॥१७॥",
      "sourceLineId": "131702",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਬੋਲਤ ਭੀ ਇਕ ਸਖੀ ਸਿਯਾਨੀ ॥",
      "transliteration": "bolat bhee ik sakhee siyaanee ||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਨੇ ਵਿਚ) ਇਕ ਸਿਆਣੀ ਸਖੀ ਬੋਲ ਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "बोलत भी इक सखी सियानी ॥",
      "sourceLineId": "131703",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਿਨ ਤ੍ਰਿਯ ਕੀ ਰਤਿ ਕ੍ਰਿਯਾ ਪਛਾਨੀ ॥",
      "transliteration": "jin tiray kee rat kirayaa pachhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਰਾਣੀ ਦੀ ਰਤੀ-ਕ੍ਰੀੜਾ ਨੂੰ ਸਮਝਿਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "जिन तृय की रति कृया पछानी ॥",
      "sourceLineId": "131704",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਏਕ ਨਾਰਿ ਬੈਦਨੀ ਹਮਾਰੇ ॥",
      "transliteration": "ek naar baidhanee hamaare ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗੀ ਕਿ) ਸਾਡੇ ਇਕ ਇਸਤਰੀ ਵੈਦਣ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "एक नारि बैदनी हमारे ॥",
      "sourceLineId": "131705",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਜਿਹ ਆਗੇ ਕ੍ਯਾ ਬੈਦ ਬਿਚਾਰੇ ॥੧੮॥",
      "transliteration": "jeh aage kayaa baidh bichaare ||18||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਦੀ ਯੋਗਤਾ) ਅਗੇ ਵੈਦ ਵਿਚਾਰੇ ਕੀ ਹਨ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "जिह आगे क्या बैद बिचारे ॥१८॥",
      "sourceLineId": "131706",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜੌ ਰਾਜਾ ਤੁਮ ਤਾਹਿ ਬੁਲਾਵੋ ॥",
      "transliteration": "jau raajaa tum taeh bulaavo ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਜੇ ਤੁਸੀਂ ਉਸ ਨੂੰ ਬੁਲਾਓ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "जौ राजा तुम ताहि बुलावो ॥",
      "sourceLineId": "131707",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਤਾਹੀ ਤੇ ਉਪਚਾਰ ਕਰਾਵੋ ॥",
      "transliteration": "taahee te upachaar karaavo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਕੋਲੋਂ ਇਲਾਜ ਕਰਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "ताही ते उपचार करावो ॥",
      "sourceLineId": "131708",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਰਾਨੀ ਬਚੈ ਬਿਲੰਬ ਨ ਲਾਵੈ ॥",
      "transliteration": "raanee bachai bila(n)b na laavai ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਉਹ) ਦੇਰ ਨਹੀਂ ਲਗਾਏਗੀ ਅਤੇ ਰਾਣੀ ਬਚ ਜਾਵੇਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "रानी बचै बिलंब न लावै ॥",
      "sourceLineId": "131709",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਬਹੁਰਿ ਤਿਹਾਰੀ ਸੇਜ ਸੁਹਾਵੈ ॥੧੯॥",
      "transliteration": "bahur tihaaree sej suhaavai ||19||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਤੁਹਾਡੀ ਸੇਜ ਨੂੰ ਸੁਹਾਵਣਾ ਕਰੇਗੀ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "बहुरि तिहारी सेज सुहावै ॥१९॥",
      "sourceLineId": "131710",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਸੋਈ ਬਾਤ ਰਾਜੈ ਜਬ ਮਾਨੀ ॥",
      "transliteration": "soiee baat raajai jab maanee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਉਹ ਗੱਲ ਮੰਨ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "सोई बात राजै जब मानी ॥",
      "sourceLineId": "131711",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਬੋਲ ਪਠਾਈ ਵਹੈ ਸਿਯਾਨੀ ॥",
      "transliteration": "bol paThaiee vahai siyaanee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਸਿਆਣੀ (ਵੈਦਣ) ਨੂੰ ਬੁਲਵਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "बोल पठाई वहै सियानी ॥",
      "sourceLineId": "131712",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਜੋ ਤਿਨ ਪੁਰਖ ਨਾਰਿ ਕਰਿ ਭਾਖਾ ॥",
      "transliteration": "jo tin purakh naar kar bhaakhaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਪੁਰਸ਼ ਉਨ੍ਰਹਾ ਨੇ ਇਸਤਰੀ ਕਰ ਕੇ ਦਸਿਆ ਹੋਇਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "जो तिन पुरख नारि करि भाखा ॥",
      "sourceLineId": "131713",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਤਾਹੀ ਕਹ ਬੈਦਨਿ ਕਰਿ ਰਾਖਾ ॥੨੦॥",
      "transliteration": "taahee keh baidhan kar raakhaa ||20||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਨੂੰ ਵੈਦਣ ਕਰ ਕੇ ਰਖ ਲਿਆ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "ताही कह बैदनि करि राखा ॥२०॥",
      "sourceLineId": "131714",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਸਖੀ ਤਬੈ ਰਾਜਾ ਪਹਿ ਗਈ ॥",
      "transliteration": "sakhee tabai raajaa peh giee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦਾਸੀ ਰਾਜੇ ਕੋਲੋਂ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "सखी तबै राजा पहि गई ॥",
      "sourceLineId": "131715",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਤਾਹਿ ਤਰੁਨਿ ਕਰਿ ਲ੍ਯਾਵਤ ਭਈ ॥",
      "transliteration": "taeh tarun kar layaavat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ (ਪੁਰਸ਼ ਨੂੰ ਵੈਦਣ) ਇਸਤਰੀ ਬਣਾ ਕੇ ਲੈ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "ताहि तरुनि करि ल्यावत भई ॥",
      "sourceLineId": "131716",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਜਬ ਤਿਨ ਤ੍ਰਿਯ ਕੀ ਨਾਰਿ ਨਿਹਾਰੀ ॥",
      "transliteration": "jab tin tiray kee naar nihaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਜਦ ਇਸਤਰੀ ਦੀ ਨਾੜੀ (ਨਬਜ਼) ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "जब तिन तृय की नारि निहारी ॥",
      "sourceLineId": "131717",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਰਾਜਾ ਸੋ ਇਹ ਭਾਤਿ ਉਚਾਰੀ ॥੨੧॥",
      "transliteration": "raajaa so ieh bhaat uchaaree ||21||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਾਜੇ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "राजा सो इह भाति उचारी ॥२१॥",
      "sourceLineId": "131718",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਰਾਜ ਰੋਗ ਰਾਨੀ ਕਹ ਧਰਿਯੋ ॥",
      "transliteration": "raaj rog raanee keh dhariyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੂੰ ਰਾਜ ਰੋਗ (ਤਪੇਦਿਕ) ਹੋ ਗਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "राज रोग रानी कह धरियो ॥",
      "sourceLineId": "131719",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਜਾਤਿ ਸਿਤਾਬੀ ਦੂਰਿ ਨ ਕਰਿਯੋ ॥",
      "transliteration": "jaat sitaabee dhoor na kariyo ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਜਲਦੀ ਠੀਕ ਨਹੀਂ ਹੋ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "जाति सिताबी दूरि न करियो ॥",
      "sourceLineId": "131720",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਆਠ ਬਰਿਸ ਲਗਿ ਰਹੈ ਜੁ ਕੋਈ ॥",
      "transliteration": "aaTh baris lag rahai ju koiee ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਕੋਈ ਅੱਠ ਸਾਲ ਤਕ ਲਗ ਕੇ (ਇਲਾਜ) ਕਰੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "आठ बरिस लगि रहै जु कोई ॥",
      "sourceLineId": "131721",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1225_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਯਾ ਕੋ ਦੂਰਿ ਦੂਖ ਤਬ ਹੋਈ ॥੨੨॥",
      "transliteration": "yaa ko dhoor dhookh tab hoiee ||22||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਸ ਦਾ ਦੁਖ ਦੂਰ ਹੋਵੇਗਾ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1225,
      "hindi": "",
      "hindiTransliteration": "या को दूरि दूख तब होई ॥२२॥",
      "sourceLineId": "131722",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
