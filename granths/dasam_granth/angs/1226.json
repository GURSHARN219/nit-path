{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1226,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1226_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੋਈ ਸਤਿ ਨ੍ਰਿਪਤਿ ਕਰਿ ਮਾਨੀ ॥",
      "transliteration": "soiee sat nirapat kar maanee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਉਹ ਸਚ ਕਰ ਕੇ ਮੰਨ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "सोई सति नृपति करि मानी ॥",
      "sourceLineId": "131723",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਿਹ ਬਿਧਿ ਤਾ ਸੌ ਜਾਰ ਬਖਾਨੀ ॥",
      "transliteration": "jeh bidh taa sau jaar bakhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਉਸ ਨੂੰ (ਰਾਣੀ ਦੇ) ਯਾਰ ਨੇ ਦਸਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "जिह बिधि ता सौ जार बखानी ॥",
      "sourceLineId": "131724",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਾ ਕੇ ਧਾਮ ਬੈਦਨੀ ਰਾਖੀ ॥",
      "transliteration": "taa ke dhaam baidhanee raakhee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਰਾਣੀ) ਦੇ ਘਰ ਵੈਦਣ ਰਖ ਦਿੱਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "ता के धाम बैदनी राखी ॥",
      "sourceLineId": "131725",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੋ ਨਰ ਤੇ ਇਸਤ੍ਰੀ ਕਰਿ ਭਾਖੀ ॥੨੩॥",
      "transliteration": "jo nar te isatree kar bhaakhee ||23||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਪੁਰਸ਼ ਤੋਂ ਇਸਤਰੀ ਕਰ ਕੇ ਦਸੀ ਗਈ ਸੀ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "जो नर ते इसत्री करि भाखी ॥२३॥",
      "sourceLineId": "131726",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰੈਨਿ ਦਿਵਸ ਤਾ ਕੇ ਸੋ ਰਹੈ ॥",
      "transliteration": "rain dhivas taa ke so rahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ (ਵੈਦਣ) ਰਾਤ ਦਿਨ ਉਥੇ ਰਹਿੰਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "रैनि दिवस ता के सो रहै ॥",
      "sourceLineId": "131727",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭੋਗ ਕਰੈ ਤਰੁਨੀ ਜਬ ਚਹੈ ॥",
      "transliteration": "bhog karai tarunee jab chahai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਦ ਰਾਣੀ ਚਾਹੁੰਦੀ ਭੋਗ ਬਿਲਾਸ ਕਰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "भोग करै तरुनी जब चहै ॥",
      "sourceLineId": "131728",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮੂਰਖ ਰਾਵ ਭੇਦ ਨਹਿ ਪਾਯੋ ॥",
      "transliteration": "moorakh raav bhedh neh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਰਾਜੇ ਨੇ ਇਸ ਭੇਦ ਨੂੰ ਨਾ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "मूरख राव भेद नहि पायो ॥",
      "sourceLineId": "131729",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਆਠ ਬਰਿਸ ਲਗਿ ਮੂੰਡ ਮੁੰਡਾਯੋ ॥੨੪॥",
      "transliteration": "aaTh baris lag moo(n)dd mu(n)ddaayo ||24||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅੱਠ ਸਾਲ ਤਕ ਸਿਰ ਮੁੰਨਵਾਉਾਂਦਾ ਰਿਹਾ (ਭਾਵ ਛਲਿਆ ਜਾਦਾ ਰਿਹਾ) ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "आठ बरिस लगि मूँड मुँडायो ॥२४॥",
      "sourceLineId": "131730",
      "sourceShabadId": "12473",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "131731",
      "sourceShabadId": "12474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਤਿਨ ਚੰਚਲਾ ਨ੍ਰਿਪ ਕਹ ਛਲਾ ਸੁਧਾਰਿ ॥",
      "transliteration": "eeh charitr tin cha(n)chalaa nirap keh chhalaa sudhaar ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਚਰਿਤ੍ਰ ਨਾਲ ਉਸ ਚੰਚਲਾ (ਰਾਣੀ) ਨੇ ਰਾਜੇ ਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਛਲ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र तिन चंचला नृप कह छला सुधारि ॥",
      "sourceLineId": "131732",
      "sourceShabadId": "12474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਆਠਿ ਬਰਸਿ ਮਿਤ੍ਰਹਿ ਭਜਿਯੋ ਸਕਿਯੋ ਨ ਮੂੜ ਬਿਚਾਰਿ ॥੨੫॥",
      "transliteration": "aaTh baras mitreh bhajiyo sakiyo na mooR bichaar ||25||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਅੱਠ ਸਾਲ ਤਕ ਮਿਤਰ ਨਾਲ ਸੰਯੋਗ ਸੁਖ ਮਾਣਿਆ, ਪਰ ਮੂਰਖ ਰਾਜਾ ਵਿਚਾਰ ਨਾ ਸਕਿਆ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "आठि बरसि मित्रहि भजियो सकियो न मूड़ बिचारि ॥२५॥",
      "sourceLineId": "131733",
      "sourceShabadId": "12474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਉਨਾਨਵੇ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੮੯॥੫੫੦੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau unaanave charitr samaapatam sat subham sat ||289||5502||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੮੯ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੮੯॥੫੫੦੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ उनानवे चरित्र समापतम सतु सुभम सतु ॥२८९॥५५०२॥अफजूँ॥",
      "sourceLineId": "131734",
      "sourceShabadId": "12474",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131735",
      "sourceShabadId": "12475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪੂਰਬ ਦੇਸ ਏਕ ਨ੍ਰਿਪ ਰਹੈ ॥",
      "transliteration": "poorab dhes ek nirap rahai ||",
      "translation": "",
      "punjabiViakhya": "ਪੂਰਬ (ਦਿਸ਼ਾ) ਦੇ (ਇਕ) ਦੇਸ਼ ਵਿਚ ਇਕ ਰਾਜਾ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "पूरब देस एक नृप रहै ॥",
      "sourceLineId": "131736",
      "sourceShabadId": "12475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪੂਰਬ ਸੈਨ ਨਾਮ ਜਗ ਕਹੈ ॥",
      "transliteration": "poorab sain naam jag kahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਪੂਰਬ ਸੈਨ ਦੇ ਨਾ ਨਾਲ ਜਗਤ ਵਿਚ ਜਾਣਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "पूरब सैन नाम जग कहै ॥",
      "sourceLineId": "131737",
      "sourceShabadId": "12475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪੂਰਬ ਦੇ ਤਾ ਕੇ ਘਰ ਨਾਰੀ ॥",
      "transliteration": "poorab dhe taa ke ghar naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਪੂਰਬ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "पूरब दे ता के घर नारी ॥",
      "sourceLineId": "131738",
      "sourceShabadId": "12475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਾ ਸਮ ਲਗਤ ਨ ਦੇਵ ਕੁਮਾਰੀ ॥੧॥",
      "transliteration": "jaa sam lagat na dhev kumaaree ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ ਦੇਵ ਕੁਮਾਰੀ ਵੀ ਨਹੀਂ ਲਗਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "जा सम लगत न देव कुमारी ॥१॥",
      "sourceLineId": "131739",
      "sourceShabadId": "12475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰੂਪ ਸੈਨ ਛਤ੍ਰੀ ਇਕ ਤਹਾ ॥",
      "transliteration": "roop sain chhatree ik tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਰੂਪ ਸੈਨ ਛਤ੍ਰੀ ਵੀ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "रूप सैन छत्री इक तहा ॥",
      "sourceLineId": "131740",
      "sourceShabadId": "12475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਾ ਸਮ ਸੁੰਦਰ ਕਹੂੰ ਨ ਕਹਾ ॥",
      "transliteration": "taa sam su(n)dhar kahoo(n) na kahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗਾ ਸੁੰਦਰ ਕੋਈ ਵੀ ਕਿਤੇ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "ता सम सुँदर कहूँ न कहा ॥",
      "sourceLineId": "131741",
      "sourceShabadId": "12475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਪ੍ਰਮਾਨ ਤਿਹ ਤੇਜ ਬਿਰਾਜੈ ॥",
      "transliteration": "apramaan teh tej biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਅਪਾਰ ਤੇਜ ਸ਼ੋਭਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "अप्रमान तिह तेज बिराजै ॥",
      "sourceLineId": "131742",
      "sourceShabadId": "12475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਰੀ ਨਾਗਨਿਨ ਕੋ ਮਨੁ ਲਾਜੈ ॥੨॥",
      "transliteration": "naree naaganin ko man laajai ||2||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ) ਮੱਨੁਖ ਇਸਤਰੀਆਂ ਅਤੇ ਨਾਗ ਇਸਤਰੀਆਂ ਦਾ ਮਨ ਲਜਾ ਜਾਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "नरी नागनिन को मनु लाजै ॥२॥",
      "sourceLineId": "131743",
      "sourceShabadId": "12475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰਾਜ ਤਰੁਨਿ ਜਬ ਤਾਹਿ ਨਿਹਾਰਾ ॥",
      "transliteration": "raaj tarun jab taeh nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਜਦ ਉਸ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "राज तरुनि जब ताहि निहारा ॥",
      "sourceLineId": "131744",
      "sourceShabadId": "12475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਨ ਬਚ ਕ੍ਰਮ ਇਹ ਭਾਤਿ ਬਿਚਾਰਾ ॥",
      "transliteration": "man bach kram ieh bhaat bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮਨ ਬਚਨ ਅਤੇ ਕਰਮ ਕਰ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਸੋਚਣ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "मन बच क्रम इह भाति बिचारा ॥",
      "sourceLineId": "131745",
      "sourceShabadId": "12475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕੈਸੇ ਕੇਲ ਸੁ ਯਾ ਸੰਗ ਕਰੌ ॥",
      "transliteration": "kaise kel su yaa sa(n)g karau ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਸ ਨਾਲ ਕਿਸ ਤਰ੍ਰਹਾ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "कैसे केल सु या संग करौ ॥",
      "sourceLineId": "131746",
      "sourceShabadId": "12475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਾਤਰ ਮਾਰਿ ਕਟਾਰੀ ਮਰੌ ॥੩॥",
      "transliteration": "naatar maar kaTaaree marau ||3||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਕਟਾਰ ਮਾਰ ਕੇ ਮਰ ਜਾਵਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "नातर मारि कटारी मरौ ॥३॥",
      "sourceLineId": "131747",
      "sourceShabadId": "12475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਿਤ੍ਰ ਜਾਨਿ ਇਕ ਹਿਤੂ ਹਕਾਰੀ ॥",
      "transliteration": "mitr jaan ik hitoo hakaaree ||",
      "translation": "",
      "punjabiViakhya": "ਮਿਤਰ ਸਮਝ ਕੇ ਉਸ ਨੇ ਇਕ ਹਿਤ ਕਰਨ ਵਾਲੀ (ਸਖੀ) ਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "मित्र जानि इक हितू हकारी ॥",
      "sourceLineId": "131748",
      "sourceShabadId": "12475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਾ ਪ੍ਰਤਿ ਚਿਤ ਕੀ ਬਾਤ ਉਚਾਰੀ ॥",
      "transliteration": "taa prat chit kee baat uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਚਿਤ ਦੀ ਗੱਲ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "ता प्रति चित की बात उचारी ॥",
      "sourceLineId": "131749",
      "sourceShabadId": "12475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕੈ ਇਹ ਮੁਹਿ ਤੈ ਦੇਹਿ ਮਿਲਾਈ ॥",
      "transliteration": "kai ieh muh tai dheh milaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਤਾ ਇਹ ਮੈਨੂੰ ਮਿਲਾ ਦੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "कै इह मुहि तै देहि मिलाई ॥",
      "sourceLineId": "131750",
      "sourceShabadId": "12475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾਤਰ ਮੁਹਿ ਨ ਨਿਰਖਿ ਹੈ ਆਈ ॥੪॥",
      "transliteration": "naatar muh na nirakh hai aaiee ||4||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਮੈਨੂੰ ਆ ਕੇ ਨਾ ਵੇਖੀਂ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "नातर मुहि न निरखि है आई ॥४॥",
      "sourceLineId": "131751",
      "sourceShabadId": "12475",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "131752",
      "sourceShabadId": "12476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕੈ ਸਜਨੀ ਮੁਹਿ ਮਿਤ੍ਰ ਕਹ ਅਬ ਹੀ ਦੇਹੁ ਮਿਲਾਇ ॥",
      "transliteration": "kai sajanee muh mitr keh ab hee dheh milai ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸਖੀ! ਜਾ ਤਾ ਮੈਨੂੰ ਹੁਣੇ ਮਿਤਰ ਨਾਲ ਮਿਲਾ ਦੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "कै सजनी मुहि मित्र कह अब ही देहु मिलाइ ॥",
      "sourceLineId": "131753",
      "sourceShabadId": "12476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਤਰ ਰਾਨੀ ਮ੍ਰਿਤ ਕੌ ਬਹੁਰਿ ਨਿਰਖਿਯਹੁ ਆਇ ॥੫॥",
      "transliteration": "naatar raanee mirat kau bahur nirakhiyahu aai ||5||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਫਿਰ ਰਾਣੀ ਨੂੰ ਮਰਿਆ ਹੋਇਆ ਆ ਕੇ ਵੇਖੀਂ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "नातर रानी मृत कौ बहुरि निरखियहु आइ ॥५॥",
      "sourceLineId": "131754",
      "sourceShabadId": "12476",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131755",
      "sourceShabadId": "12477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਬ ਇਹ ਭਾਤਿ ਉਚਾਰੋ ਰਾਨੀ ॥",
      "transliteration": "jab ieh bhaat uchaaro raanee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਣੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "जब इह भाति उचारो रानी ॥",
      "sourceLineId": "131756",
      "sourceShabadId": "12477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਾਨਿ ਗਈ ਤਬ ਸਖੀ ਸਿਯਾਨੀ ॥",
      "transliteration": "jaan giee tab sakhee siyaanee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਹ ਸਿਆਣੀ ਸਖੀ ਜਾਣ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "जानि गई तब सखी सियानी ॥",
      "sourceLineId": "131757",
      "sourceShabadId": "12477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਯਾ ਕੀ ਲਗਨ ਮਿਤ੍ਰ ਸੌ ਲਾਗੀ ॥",
      "transliteration": "yaa kee lagan mitr sau laagee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਦੀ ਮਿਤਰ ਨਾਲ ਲਗਨ ਲਗ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "या की लगन मित्र सौ लागी ॥",
      "sourceLineId": "131758",
      "sourceShabadId": "12477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਾ ਤੇ ਨੀਂਦ ਭੂਖ ਸਭ ਭਾਗੀ ॥੬॥",
      "transliteration": "taa te nee(n)dh bhookh sabh bhaagee ||6||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਕਰ ਕੇ (ਇਸ ਦੀ) ਨੀਂਦਰ ਭੁਖ ਸਭ ਭਜ ਗਈ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "ता ते नींद भूख सभ भागी ॥६॥",
      "sourceLineId": "131759",
      "sourceShabadId": "12477",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "131760",
      "sourceShabadId": "12478",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਨਿਕ ਨ ਲਗੀ ਅਵਾਰ ਸਜਨ ਕੈ ਘਰ ਗਈ ॥",
      "transliteration": "tanik na lagee avaar sajan kai ghar giee ||",
      "translation": "",
      "punjabiViakhya": "ਜ਼ਰਾ ਵੀ ਦੇਰ ਨਾ ਲਗੀ ਅਤੇ (ਉਹ ਦਾਸੀ) ਮਿਤਰ ਦੇ ਘਰ ਜਾ ਪਹੁੰਚੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "तनिक न लगी अवार सजन कै घर गई ॥",
      "sourceLineId": "131761",
      "sourceShabadId": "12478",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਤਾਹਿ ਪ੍ਰਬੋਧਤ ਤਹ ਲ੍ਯਾਵਤ ਭਈ ॥",
      "transliteration": "bahu bidh taeh prabodhat teh layaavat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਸਮਝਾ ਕੇ ਉਥੇ ਲੈ ਆਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि ताहि प्रबोधत तह ल्यावत भई ॥",
      "sourceLineId": "131762",
      "sourceShabadId": "12478",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਹ ਆਗੇ ਤ੍ਰਿਯ ਬੈਠੀ ਸੇਜ ਡਸਾਇ ਕੈ ॥",
      "transliteration": "jeh aage tiray baiThee sej ddasai kai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਅਗੇ ਰਾਣੀ ਸੇਜ ਵਿਛਾ ਕੇ ਬੈਠੀ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "जह आगे तृय बैठी सेज डसाइ कै ॥",
      "sourceLineId": "131763",
      "sourceShabadId": "12478",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਹੋ ਤਹੀ ਤਵਨ ਕਹ ਹਿਤੂ ਨਿਕਾਸਿਯੋ ਲ੍ਯਾਇ ਕੈ ॥੭॥",
      "transliteration": "ho tahee tavan keh hitoo nikaasiyo layai kai ||7||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਹੀ ਉਸ ਦੇ ਮਿਤਰ ਨੂੰ ਲੈ ਕੇ ਆ ਪਹੁੰਚੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "हो तही तवन कह हितू निकासियो ल्याइ कै ॥७॥",
      "sourceLineId": "131764",
      "sourceShabadId": "12478",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131765",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਉਠਿ ਕਰਿ ਕੁਅਰਿ ਅਲਿੰਗਨ ਕਿਯੋ ॥",
      "transliteration": "auTh kar kuar ali(n)gan kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਉਠ ਕੇ (ਯਾਰ ਨੂੰ) ਗਲਵਕੜੀ ਵਿਚ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "उठि करि कुअरि अलिंगन कियो ॥",
      "sourceLineId": "131766",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਚੁੰਬਨ ਤਿਹ ਲਿਯੋ ॥",
      "transliteration": "bhaat bhaat chu(n)ban teh liyo ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਤਰ੍ਰਹਾ ਨਾਲ ਉਸ ਦੇ ਚੁੰਬਨ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "भाति भाति चुँबन तिह लियो ॥",
      "sourceLineId": "131767",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਾਮ ਕੇਲ ਰੁਚਿ ਮਾਨ ਕਮਾਯੋ ॥",
      "transliteration": "kaam kel ruch maan kamaayo ||",
      "translation": "",
      "punjabiViakhya": "ਮਨ ਪਸੰਦ ਦੀ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "काम केल रुचि मान कमायो ॥",
      "sourceLineId": "131768",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭਾਗਿ ਅਫੀਮ ਸਰਾਬ ਚੜਾਯੋ ॥੮॥",
      "transliteration": "bhaag afeem saraab chaRaayo ||8||",
      "translation": "",
      "punjabiViakhya": "ਭੰਗ, ਅਫ਼ੀਮ ਅਤੇ ਸ਼ਰਾਬ ਪੀਤੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "भागि अफीम सराब चड़ायो ॥८॥",
      "sourceLineId": "131769",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1226_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਬ ਮਦ ਕਰਿ ਮਤਵਾਰਾ ਕਿਯੋ ॥",
      "transliteration": "jab madh kar matavaaraa kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸ਼ਰਾਬ ਪਿਲਾ ਕੇ (ਉਸ ਨੂੰ) ਮਤਵਾਲਾ ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1226,
      "hindi": "",
      "hindiTransliteration": "जब मद करि मतवारा कियो ॥",
      "sourceLineId": "131770",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
