{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1227,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1227_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭੁਜ ਤੇ ਪਕਰਿ ਸੇਜ ਪਰ ਦਿਯੋ ॥",
      "transliteration": "bhuj te pakar sej par dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਬਾਹੋਂ ਪਕੜ ਕੇ ਸੇਜ ਉਪਰ ਪਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "भुज ते पकरि सेज पर दियो ॥",
      "sourceLineId": "131771",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਧਿਕ ਮਾਨਿ ਰੁਚਿ ਗਰੇ ਲਗਾਯੋ ॥",
      "transliteration": "adhik maan ruch gare lagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਪ੍ਰਸੰਨ ਹੋ ਕੇ (ਉਸ ਨੂੰ) ਗਲੇ ਨਾਲ ਲਗਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "अधिक मानि रुचि गरे लगायो ॥",
      "sourceLineId": "131772",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਉਛਰਿ ਉਛਰਿ ਕਰਿ ਭੋਗ ਕਮਾਯੋ ॥੯॥",
      "transliteration": "auchhar uchhar kar bhog kamaayo ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਛਲ ਉਛਲ ਕੇ ਉਸ ਨਾਲ ਸੰਯੋਗ ਕੀਤਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "उछरि उछरि करि भोग कमायो ॥९॥",
      "sourceLineId": "131773",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਏਕ ਤਰੁਨ ਦੂਸਰ ਮਦ ਮਾਤੋ ॥",
      "transliteration": "ek tarun dhoosar madh maato ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਜਵਾਨ ਅਤੇ ਦੂਜਾ ਸ਼ਰਾਬ ਨਾਲ ਮਸਤ",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "एक तरुन दूसर मद मातो ॥",
      "sourceLineId": "131774",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤੀਸਰ ਭੋਗ ਤਰੁਨਿ ਕੇ ਰਾਤੋ ॥",
      "transliteration": "teesar bhog tarun ke raato ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੀਜਾ ਨੌਜਵਾਨ ਇਸਤਰੀ ਨਾਲ ਭੋਗ ਵਿਚ ਮਗਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "तीसर भोग तरुनि के रातो ॥",
      "sourceLineId": "131775",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਦੁਹੂੰਅਨ ਮਧ ਹਾਰ ਕੋ ਮਾਨੈ ॥",
      "transliteration": "dhuhoo(n)an madh haar ko maanai ||",
      "translation": "",
      "punjabiViakhya": "ਦਸੋ (ਇਨ੍ਰਹਾ) ਦੋਹਾ ਵਿਚੋਂ ਹਾਰ ਕੌਣ ਮੰਨੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "दुहूँअन मध हार को मानै ॥",
      "sourceLineId": "131776",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚਾਰਹੁ ਬੇਦ ਭੇਦ ਇਹ ਜਾਨੈ ॥੧੦॥",
      "transliteration": "chaarahu bedh bhedh ieh jaanai ||10||",
      "translation": "",
      "punjabiViakhya": "ਚਾਰੇ ਵੇਦ ਇਸ ਭੇਦ ਨੂੰ ਜਾਣਦੇ ਹਨ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "चारहु बेद भेद इह जानै ॥१०॥",
      "sourceLineId": "131777",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਬ ਤ੍ਰਿਯ ਤਰੁਨਿ ਤਰੁਨ ਕਹ ਪਾਵੈ ॥",
      "transliteration": "jab tiray tarun tarun keh paavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਕੋਈ ਜਵਾਨ ਇਸਤਰੀ ਜਵਾਨ ਮਰਦ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "जब तृय तरुनि तरुन कह पावै ॥",
      "sourceLineId": "131778",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਛਿਨ ਛਤਿਯਾ ਤੇ ਛੋਰਿ ਨ ਭਾਵੈ ॥",
      "transliteration": "chhin chhatiyaa te chhor na bhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਛਿਣ ਭਰ ਲਈ ਵੀ ਛਾਤੀ ਨਾਲ ਵਖਰਾ ਕਰਨਾ ਪਸੰਦ ਨਹੀਂ ਕਰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "छिन छतिया ते छोरि न भावै ॥",
      "sourceLineId": "131779",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗਹਿ ਗਹਿ ਤਾ ਕਹ ਗਰੇ ਲਗਾਵੈ ॥",
      "transliteration": "geh geh taa keh gare lagaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ) ਪਕੜ ਪਕੜ ਕੇ ਉਸ ਨੂੰ ਗਲੇ ਨਾਲ ਲਗਾਉਾਂਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "गहि गहि ता कह गरे लगावै ॥",
      "sourceLineId": "131780",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚਾਰਿ ਪਹਿਰ ਨਿਸਿ ਭੋਗ ਕਮਾਵੈ ॥੧੧॥",
      "transliteration": "chaar pahir nis bhog kamaavai ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਾਰ ਪਹਿਰ ਰਾਤ ਤਕ ਭੋਗ ਕਰਦੀ ਰਹੀ ਸੀ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "चारि पहिर निसि भोग कमावै ॥११॥",
      "sourceLineId": "131781",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭੋਗ ਕਰਤ ਤਰੁਨੀ ਬਸਿ ਭਈ ॥",
      "transliteration": "bhog karat tarunee bas bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਭੋਗ ਕਰਦਿਆਂ ਰਾਣੀ ਉਸ ਦੇ ਵਸ ਵਿਚ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "भोग करत तरुनी बसि भई ॥",
      "sourceLineId": "131782",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪਰ ਕੀ ਤੇ ਵਾ ਕੀ ਹ੍ਵੈ ਗਈ ॥",
      "transliteration": "par kee te vaa kee havai giee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਪਰਾਈ (ਇਸਤਰੀ) ਹੁਣ ਉਸ ਦੀ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "पर की ते वा की ह्वै गई ॥",
      "sourceLineId": "131783",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਛਿਨ ਇਕ ਛੈਲ ਨ ਛੋਰਿਯੋ ਜਾਵੈ ॥",
      "transliteration": "chhin ik chhail na chhoriyo jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਛਿਣ ਲਈ ਵੀ (ਉਸ) ਪੁਰਸ਼ ਨੂੰ ਛਡਿਆ ਨਹੀਂ ਜਾ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "छिन इक छैल न छोरियो जावै ॥",
      "sourceLineId": "131784",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਛੈਲਿਯਹਿ ਯਾਰ ਛਬੀਲੋ ਭਾਵੈ ॥੧੨॥",
      "transliteration": "chhailiyeh yaar chhabeelo bhaavai ||12||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਨੌਜਵਾਨ (ਰਾਣੀ ਨੂੰ) ਜਵਾਨ ਯਾਰ ਚੰਗਾ ਲਗ ਰਿਹਾ ਸੀ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "छैलियहि यार छबीलो भावै ॥१२॥",
      "sourceLineId": "131785",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕੋਕਸਾਰ ਕੇ ਮਤਨ ਉਚਾਰੈ ॥",
      "transliteration": "kokasaar ke matan uchaarai ||",
      "translation": "",
      "punjabiViakhya": "ਕੋਕ ਸ਼ਾਸਤ੍ਰ ਦੇ ਪਾਠ ('ਮਤਨ') ਨੂੰ ਉਚਾਰਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "कोकसार के मतन उचारै ॥",
      "sourceLineId": "131786",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਮਲ ਪਾਨ ਕਰਿ ਦ੍ਰਿੜ ਰਤਿ ਧਾਰੈ ॥",
      "transliteration": "amal paan kar dhiraR rat dhaarai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਮਲ ਪੀ ਕੇ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਰਤੀ-ਕ੍ਰੀੜਾ ਕਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "अमल पान करि दृड़ रति धारै ॥",
      "sourceLineId": "131787",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਆਨ ਪੁਰਖ ਕੀ ਕਾਨਿ ਨ ਕਰਹੀ ॥",
      "transliteration": "aan purakh kee kaan na karahee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਕਿਸੇ ਹੋਰ ਪੁਰਸ਼ ਦੀ ਪਰਵਾਹ ਨਹੀਂ ਕਰਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "आन पुरख की कानि न करही ॥",
      "sourceLineId": "131788",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਭੋਗਨ ਭਰਹੀ ॥੧੩॥",
      "transliteration": "bhaat bhaat ke bhogan bharahee ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦੇ ਭੋਗ ਕਰ ਕੇ ਤ੍ਰਿਪਤ ਹੋ ਰਹੇ ਸਨ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के भोगन भरही ॥१३॥",
      "sourceLineId": "131789",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪੋਸਤ ਭਾਗ ਅਫੀਮ ਮੰਗਾਵੈ ॥",
      "transliteration": "posat bhaag afeem ma(n)gaavai ||",
      "translation": "",
      "punjabiViakhya": "ਪੋਸਤ, ਭੰਗ ਅਤੇ ਅਫ਼ੀਮ ਮੰਗਵਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "पोसत भाग अफीम मंगावै ॥",
      "sourceLineId": "131790",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਏਕ ਖਾਟ ਪਰ ਬੈਠਿ ਚੜਾਵੈ ॥",
      "transliteration": "ek khaaT par baiTh chaRaavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਮੰਜੇ ਉਤੇ ਬੈਠ ਕੇ ਚੜ੍ਰਹਾ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "एक खाट पर बैठि चड़ावै ॥",
      "sourceLineId": "131791",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਹਸਿ ਹਸਿ ਕਰਿ ਦੋਊ ਜਾਘਨ ਲੇਹੀ ॥",
      "transliteration": "has has kar dhouoo jaaghan lehee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਪੁਰਸ਼) ਹਸ ਹਸ ਕੇ (ਰਾਣੀ) ਦੀਆਂ ਦੋਵੇਾਂ ਟੰਗਾ ਪਕੜ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "हसि हसि करि दोऊ जाघन लेही ॥",
      "sourceLineId": "131792",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਾਜ ਤਰੁਨਿ ਕੌ ਬਹੁ ਸੁਖ ਦੇਹੀ ॥੧੪॥",
      "transliteration": "raaj tarun kau bahu sukh dhehee ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਨੂੰ ਬਹੁਤ ਸੁਖ ਦੇ ਰਿਹਾ ਸੀ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "राज तरुनि कौ बहु सुख देही ॥१४॥",
      "sourceLineId": "131793",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭੋਗ ਕਰਤ ਨਿਸਿ ਸਕਲ ਬਿਤਾਵੈ ॥",
      "transliteration": "bhog karat nis sakal bitaavai ||",
      "translation": "",
      "punjabiViakhya": "ਭੋਗ ਕਰਦਿਆਂ ਸਾਰੀ ਰਾਤ ਬਿਤਾ ਦਿੰਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "भोग करत निसि सकल बितावै ॥",
      "sourceLineId": "131794",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੋਇ ਰਹੈ ਉਠਿ ਕੇਲਿ ਕਮਾਵੈ ॥",
      "transliteration": "soi rahai uTh kel kamaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੌਂ ਕੇ ਉਠਦੇ (ਤਾ ਫਿਰ) ਰਤੀ-ਕ੍ਰੀੜਾ ਕਰਨ ਲਗ ਜਾਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "सोइ रहै उठि केलि कमावै ॥",
      "sourceLineId": "131795",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਫਿਰਿ ਫਿਰਿ ਤ੍ਰਿਯ ਆਸਨ ਕਹ ਲੈ ਕੈ ॥",
      "transliteration": "fir fir tiray aasan keh lai kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਫਿਰ ਫਿਰ ਇਸਤਰੀ ਨਾਲ ਆਸਣ ਜਮਾਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "फिरि फिरि तृय आसन कह लै कै ॥",
      "sourceLineId": "131796",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੈ ਚੁੰਬਨ ਕੈ ਕੈ ॥੧੫॥",
      "transliteration": "bhaat bhaat kai chu(n)ban kai kai ||15||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦੇ ਚੁੰਬਨ ਕਰਦਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "भाति भाति कै चुँबन कै कै ॥१५॥",
      "sourceLineId": "131797",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭੋਗ ਕਰਤ ਤਰੁਨਿਯਹਿ ਰਿਝਾਯੋ ॥",
      "transliteration": "bhog karat taruniyeh rijhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਭੋਗ ਕਰ ਕੇ ਉਸ ਨੇ ਇਸਤਰੀ ਨੂੰ ਬਹੁਤ ਪ੍ਰਸੰਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "भोग करत तरुनियहि रिझायो ॥",
      "sourceLineId": "131798",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭਾਤਿ ਅਨਿਕ ਤਿਨ ਕੇਲ ਮਚਾਯੋ ॥",
      "transliteration": "bhaat anik tin kel machaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਨੇਕ ਤਰ੍ਰਹਾ ਨਾਲ ਉਸ ਨੇ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "भाति अनिक तिन केल मचायो ॥",
      "sourceLineId": "131799",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਹੌ ਹਸਿ ਤਾਹਿ ਉਚਾਰੋ ॥",
      "transliteration": "eeh bidh hau has taeh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਰਾਣੀ) ਨੇ ਹਸ ਕੇ ਉਸ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "इह बिधि हौ हसि ताहि उचारो ॥",
      "sourceLineId": "131800",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਹੌ ਜੁ ਤੁਮ ਸੌ ਸੁਨਹੋ ਪ੍ਯਾਰੋ ॥੧੬॥",
      "transliteration": "kahau ju tum sau sunaho payaaro ||16||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਿਆਰੇ! ਜੋ ਤੁਹਾਨੂੰ ਕਹਾ, ਉਸ ਨੂੰ ਸੁਣੋ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "कहौ जु तुम सौ सुनहो प्यारो ॥१६॥",
      "sourceLineId": "131801",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਬ ਤਰੁਨੀ ਸੰਗ ਦ੍ਰਿੜ ਰਤਿ ਕਰੀ ॥",
      "transliteration": "jab tarunee sa(n)g dhiraR rat karee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਉਸ ਨੇ) ਇਸਤਰੀ ਨਾਲ ਚੰਗੀ ਤਰ੍ਰਹਾ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "जब तरुनी संग दृड़ रति करी ॥",
      "sourceLineId": "131802",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਭੋਗਨ ਭਰੀ ॥",
      "transliteration": "bhaat bhaat ke bhogan bharee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦੇ ਭੋਗਾ ਨਾਲ ਰਜਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के भोगन भरी ॥",
      "sourceLineId": "131803",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰੀਝਿ ਤਰੁਨਿ ਇਹ ਭਾਤਿ ਉਚਾਰੀ ॥",
      "transliteration": "reejh tarun ieh bhaat uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਸਤਰੀ ਨੇ ਪ੍ਰਸੰਨ ਹੋ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "रीझि तरुनि इह भाति उचारी ॥",
      "sourceLineId": "131804",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਿਤ੍ਰ ਭਈ ਮੈ ਦਾਸ ਤਿਹਾਰੀ ॥੧੭॥",
      "transliteration": "mitr bhiee mai dhaas tihaaree ||17||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮਿਤਰ! ਮੈਂ (ਹੁਣ) ਤੇਰੀ ਦਾਸੀ ਹੋ ਗਈ ਹਾ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "मित्र भई मै दास तिहारी ॥१७॥",
      "sourceLineId": "131805",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਬ ਜੌ ਕਹੋ ਨੀਰ ਭਰਿ ਲ੍ਯਾਊ ॥",
      "transliteration": "ab jau kaho neer bhar layaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਹੁਣ ਕਹੋ ਤਾ ਪਾਣੀ ਭਰ ਲਿਆਵਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "अब जौ कहो नीर भरि ल्याऊ ॥",
      "sourceLineId": "131806",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਾਰ ਅਨੇਕ ਬਜਾਰ ਬਿਕਾਊ ॥",
      "transliteration": "baar anek bajaar bikaauoo ||",
      "translation": "",
      "punjabiViakhya": "(ਜਾ ਤੁਹਾਡੇ ਲਈ) ਬਾਜ਼ਾਰ ਵਿਚ ਅਨੇਕ ਵਾਰ ਵਿਕਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "बार अनेक बजार बिकाऊ ॥",
      "sourceLineId": "131807",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੇ ਤੁਮ ਕਹੋ ਵਹੈ ਮੈ ਕਰਿਹੌ ॥",
      "transliteration": "je tum kaho vahai mai karihau ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਤੁਸੀਂ ਕਹੋ, ਉਹੀ ਮੈਂ ਕਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "जे तुम कहो वहै मै करिहौ ॥",
      "sourceLineId": "131808",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਔਰ ਕਿਸੂ ਤੇ ਨੈਕੁ ਨ ਡਰਿਹੋ ॥੧੮॥",
      "transliteration": "aauar kisoo te naik na ddariho ||18||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੋਰ ਕਿਸੇ ਤੋਂ ਜ਼ਰਾ ਜਿੰਨੀ ਵੀ ਨਹੀਂ ਡਰਾ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "और किसू ते नैकु न डरिहो ॥१८॥",
      "sourceLineId": "131809",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਿਤ੍ਰ ਬਿਹਸਿ ਇਹ ਭਾਤਿ ਉਚਾਰਾ ॥",
      "transliteration": "mitr bihas ieh bhaat uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਮਿਤਰ ਨੇ ਹਸ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "मित्र बिहसि इह भाति उचारा ॥",
      "sourceLineId": "131810",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਬ ਮੈ ਭਯੋ ਗੁਲਾਮ ਤਿਹਾਰਾ ॥",
      "transliteration": "ab mai bhayo gulaam tihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਹੁਣ ਤੇਰਾ ਗ਼ੁਲਾਮ ਹੋ ਗਿਆ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "अब मै भयो गुलाम तिहारा ॥",
      "sourceLineId": "131811",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤੋ ਸੀ ਤਰੁਨਿ ਭੋਗ ਕਹ ਪਾਈ ॥",
      "transliteration": "to see tarun bhog keh paiee ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਰੇ ਵਰਗੀ ਇਸਤਰੀ ਸੰਯੋਗ ਲਈ ਪ੍ਰਾਪਤ ਹੋਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "तो सी तरुनि भोग कह पाई ॥",
      "sourceLineId": "131812",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪੂਰਨ ਭਈ ਮੋਰਿ ਭਗਤਾਈ ॥੧੯॥",
      "transliteration": "pooran bhiee mor bhagataiee ||19||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਮੇਰੀ ਭਗਤੀ ਪੂਰੀ ਹੋ ਗਈ ਹੈ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "पूरन भई मोरि भगताई ॥१९॥",
      "sourceLineId": "131813",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਬ ਇਹ ਬਾਤ ਚਿਤ ਮੈ ਮੇਰੇ ॥",
      "transliteration": "ab ieh baat chit mai mere ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੇਰੇ ਚਿਤ ਵਿਚ ਇਹ ਗੱਲ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "अब इह बात चित मै मेरे ॥",
      "sourceLineId": "131814",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੋ ਮੈ ਕਹਤ ਯਾਰ ਸੰਗ ਤੇਰੇ ॥",
      "transliteration": "so mai kahat yaar sa(n)g tere ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪ੍ਰਿਯਾ! ਉਹ ਤੇਰੇ ਨਾਲ ਸਾਝੀ ਕਰਦਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "सो मै कहत यार संग तेरे ॥",
      "sourceLineId": "131815",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਬ ਕਛੁ ਐਸ ਉਪਾਵ ਬਨੈਯੈ ॥",
      "transliteration": "ab kachh aais upaav banaiyai ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਕੋਈ ਅਜਿਹਾ ਉਪਾ ਕਰੀਏ",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "अब कछु ऐस उपाव बनैयै ॥",
      "sourceLineId": "131816",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਾ ਤੇ ਤੋ ਕਹ ਸਦਾ ਹੰਢੈਯੈ ॥੨੦॥",
      "transliteration": "jaa te to keh sadhaa ha(n)ddaiyai ||20||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ (ਮੈਂ) ਤੈਨੂੰ ਸਦਾ ਮਾਣਦਾ ਰਹਾ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "जा ते तो कह सदा हंढैयै ॥२०॥",
      "sourceLineId": "131817",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1227_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਬ ਤੁਮ ਐਸ ਚਰਿਤ੍ਰ ਬਨਾਵਹੁ ॥",
      "transliteration": "ab tum aais charitr banaavahu ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਤੂੰ (ਕੋਈ) ਅਜਿਹਾ ਚਰਿਤ੍ਰ ਖੇਡ",
      "source": "DASAM_GRANTH",
      "ang": 1227,
      "hindi": "",
      "hindiTransliteration": "अब तुम ऐस चरित्र बनावहु ॥",
      "sourceLineId": "131818",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
