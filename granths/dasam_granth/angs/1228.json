{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1228,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1228_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਾ ਤੇ ਮੋਹਿ ਸਦਾ ਤੁਮ ਪਾਵਹੁ ॥",
      "transliteration": "jaa te moh sadhaa tum paavahu ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਤੂੰ ਮੈਨੂੰ ਸਦਾ ਲਈ ਪ੍ਰਾਪਤ ਕਰ ਲੈਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "जा ते मोहि सदा तुम पावहु ॥",
      "sourceLineId": "131819",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਭੇਦ ਦੂਸਰੋ ਪੁਰਖ ਨ ਪਾਵੈ ॥",
      "transliteration": "bhedh dhoosaro purakh na paavai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਗੱਲ ਦਾ) ਭੇਦ ਕੋਈ ਦੂਜਾ ਬੰਦਾ ਨਾ ਪਾ ਸਕੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "भेद दूसरो पुरख न पावै ॥",
      "sourceLineId": "131820",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਲਹੈ ਨ ਸ੍ਵਾਨ ਨ ਭੂਸਨ ਆਵੈ ॥੨੧॥",
      "transliteration": "lahai na savaiaan na bhoosan aavai ||21||",
      "translation": "",
      "punjabiViakhya": "ਨਾ ਕੁੱਤਾ ਵੇਖੇ ਅਤੇ ਨਾ ਭੌਂਕਣ ਲਈ ਆਵੇ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "लहै न स्वान न भूसन आवै ॥२१॥",
      "sourceLineId": "131821",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਾਨੀ ਸੁਨੀ ਬਾਤ ਐਸੀ ਜਬ ॥",
      "transliteration": "raanee sunee baat aaisee jab ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਜਦ ਇਸ ਤਰ੍ਰਹਾ ਦੀ ਗੱਲ ਸੁਣੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "रानी सुनी बात ऐसी जब ॥",
      "sourceLineId": "131822",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਚਨ ਕਹਾ ਹਸਿ ਕਰਿ ਪਿਯ ਸੋ ਤਬ ॥",
      "transliteration": "bachan kahaa has kar piy so tab ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹਸ ਕੇ ਪ੍ਰੀਤਮ ਨਾਲ ਇਸ ਤਰ੍ਰਹਾ ਬੋਲ ਸਾਝੇ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "बचन कहा हसि करि पिय सो तब ॥",
      "sourceLineId": "131823",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰੋਮ ਨਾਸ ਤੁਮ ਬਦਨ ਲਗਾਵਹੁ ॥",
      "transliteration": "rom naas tum badhan lagaavahu ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਕਿਹਾ) ਤੂੰ ਆਪਣੇ ਮੁਖ ('ਬਦਨ') ਉਤੇ ਰੋਮਨਾਸਨੀ ਲਗਾ ਲੈ",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "रोम नास तुम बदन लगावहु ॥",
      "sourceLineId": "131824",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਕਲ ਨਾਰਿ ਕੋ ਭੇਸ ਬਨਾਵਹੁ ॥੨੨॥",
      "transliteration": "sakal naar ko bhes banaavahu ||22||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸਤਰੀ ਦਾ ਸਾਰਾ ਭੇਸ ਬਣਾ ਲੈ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "सकल नारि को भेस बनावहु ॥२२॥",
      "sourceLineId": "131825",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰੋਮਾਤਕ ਰਾਨਿਯਹਿ ਮੰਗਾਯੋ ॥",
      "transliteration": "romaatak raaniyeh ma(n)gaayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਰੋਮਨਾਸਨੀ ਮੰਗਵਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "रोमातक रानियहि मंगायो ॥",
      "sourceLineId": "131826",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਾ ਕੇ ਬਦਨ ਸਾਥ ਲੈ ਲਾਯੋ ॥",
      "transliteration": "taa ke badhan saath lai laayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲੈ ਕੇ ਉਸ ਦੇ ਸਾਰੇ ਮੂੰਹ ਉਤੇ ਲਗਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "ता के बदन साथ लै लायो ॥",
      "sourceLineId": "131827",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਭ ਹੀ ਕੇਸ ਦੂਰਿ ਜਬ ਭਏ ॥",
      "transliteration": "sabh hee kes dhoor jab bhe ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਮੂੰਹ ਦੇ) ਸਾਰੇ ਵਾਲ ਉਤਰ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "सभ ही केस दूरि जब भए ॥",
      "sourceLineId": "131828",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਾ ਕਹ ਬਸਤ੍ਰ ਨਾਰਿ ਕੇ ਦਏ ॥੨੩॥",
      "transliteration": "taa keh basatr naar ke dhe ||23||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੂੰ ਇਸਤਰੀ ਦੇ ਬਸਤ੍ਰ ਪਵਾ ਦਿੱਤੇ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "ता कह बसत्र नारि के दए ॥२३॥",
      "sourceLineId": "131829",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬੀਨਾ ਦਈ ਕੰਧ ਤਾ ਕੈ ਪਰ ॥",
      "transliteration": "beenaa dhiee ka(n)dh taa kai par ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਮੋਢੇ ਉਤੇ ਵੀਣਾ ਟਿਕਾ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "बीना दई कंध ता कै पर ॥",
      "sourceLineId": "131830",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੁਨਨ ਨਮਿਤਿ ਰਾਖਿਯੋ ਤਾ ਕੌ ਘਰ ॥",
      "transliteration": "sunan namit raakhiyo taa kau ghar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਸੰਗੀਤ) ਸੁਣਨ ਲਈ ਉਸ ਨੂੰ ਘਰ ਰਖ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "सुनन नमिति राखियो ता कौ घर ॥",
      "sourceLineId": "131831",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਬ ਰਾਜਾ ਤਾ ਕੇ ਗ੍ਰਿਹ ਆਵੈ ॥",
      "transliteration": "jab raajaa taa ke gireh aavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜਾ ਉਸ (ਰਾਣੀ) ਦੇ ਘਰ ਆਉਾਂਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "जब राजा ता के गृह आवै ॥",
      "sourceLineId": "131832",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਬ ਤੰਤ੍ਰੀ ਸੌ ਬੈਠਿ ਬਜਾਵੈ ॥੨੪॥",
      "transliteration": "tab ta(n)tree sau baiTh bajaavai ||24||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਹ ਬੈਠ ਕੇ ਤੰਤੀ ਵਜਾਉਾਂਦੀ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "तब तंत्री सौ बैठि बजावै ॥२४॥",
      "sourceLineId": "131833",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰਾਜ ਬੀਨ ਸੁਨਿ ਤ੍ਰਿਯ ਤਿਹ ਮਾਨੈ ॥",
      "transliteration": "raaj been sun tiray teh maanai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ (ਉਸ ਤੋਂ) ਵੀਣਾ ਸੁਣ ਕੇ ਉਸ ਨੂੰ ਇਸਤਰੀ ਮੰਨਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "राज बीन सुनि तृय तिह मानै ॥",
      "sourceLineId": "131834",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪੁਰਖ ਵਾਹਿ ਇਸਤ੍ਰੀ ਪਹਿਚਾਨੈ ॥",
      "transliteration": "purakh vaeh isatree pahichaanai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਪੁਰਸ਼ ਨੂੰ (ਉਹ) ਇਸਤਰੀ ਸਮਝਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "पुरख वाहि इसत्री पहिचानै ॥",
      "sourceLineId": "131835",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾ ਕੋ ਹੇਰਿ ਰੂਪ ਲਲਚਾਨਾ ॥",
      "transliteration": "taa ko her roop lalachaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਰੂਪ ਵੇਖ ਕੇ (ਰਾਜਾ) ਲਲਚਾ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "ता को हेरि रूप ललचाना ॥",
      "sourceLineId": "131836",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਘਰ ਬਾਹਰ ਤਜਿ ਭਯੋ ਦਿਵਾਨਾ ॥੨੫॥",
      "transliteration": "ghar baahar taj bhayo dhivaanaa ||25||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘਰ ਬਾਹਰ ਛਡ ਕੇ (ਉਸ ਦਾ) ਦੀਵਾਨਾ ਹੋ ਗਿਆ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "घर बाहर तजि भयो दिवाना ॥२५॥",
      "sourceLineId": "131837",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਇਕ ਦੂਤੀ ਤਬ ਰਾਇ ਬੁਲਾਇਸਿ ॥",
      "transliteration": "eik dhootee tab rai bulais ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜੇ ਨੇ ਇਕ ਦੂਤੀ ਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "इक दूती तब राइ बुलाइसि ॥",
      "sourceLineId": "131838",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਧਿਕ ਦਰਬ ਦੈ ਤਹਾ ਪਠਾਇਸਿ ॥",
      "transliteration": "adhik dharab dhai tahaa paThais ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਧਨ ਦੇ ਕੇ ਉਸ ਪਾਸ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "अधिक दरब दै तहा पठाइसि ॥",
      "sourceLineId": "131839",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਬ ਰਾਨੀ ਐਸੇ ਸੁਨਿ ਪਾਈ ॥",
      "transliteration": "jab raanee aaise sun paiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਣੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਦੀ (ਗੱਲ) ਸੁਣੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "जब रानी ऐसे सुनि पाई ॥",
      "sourceLineId": "131840",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਚਨ ਕਹਾ ਤਾ ਸੋ ਮੁਸਕਾਈ ॥੨੬॥",
      "transliteration": "bachan kahaa taa so musakaiee ||26||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਹਸ ਕੇ ਉਸ ਨੂੰ ਕਹਿਣ ਲਗੀ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "बचन कहा ता सो मुसकाई ॥२६॥",
      "sourceLineId": "131841",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਿਨਿ ਤੋ ਕੋ ਰਾਜਾ ਯਹ ਬਰੈ ॥",
      "transliteration": "jin to ko raajaa yeh barai ||",
      "translation": "",
      "punjabiViakhya": "ਮਤਾ ਇਹ ਰਾਜਾ ਤੈਨੂੰ ਵਰ ਲਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "जिनि तो को राजा यह बरै ॥",
      "sourceLineId": "131842",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹਮ ਸੋ ਨੇਹੁ ਸਕਲ ਤਜਿ ਡਰੈ ॥",
      "transliteration": "ham so neh sakal taj ddarai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੇ ਨਾਲ ਸਾਰਾ ਸਨੇਹ ਛਡ ਦੇਵੇਾਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "हम सो नेहु सकल तजि डरै ॥",
      "sourceLineId": "131843",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੈ ਅਪਨੇ ਸੰਗ ਲੈ ਤੁਹਿ ਸ੍ਵੈਹੋ ॥",
      "transliteration": "mai apane sa(n)g lai tuh savaiho ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਤੈਨੂੰ ਆਪਣੇ ਨਾਲ ਲੈ ਕੇ ਸਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "मै अपने संग लै तुहि स्वैहो ॥",
      "sourceLineId": "131844",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚਿਤ ਕੇ ਸਕਲ ਸੋਕ ਕਹ ਖ੍ਵੈਹੋ ॥੨੭॥",
      "transliteration": "chit ke sakal sok keh khavaiho ||27||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਿਤ ਦੇ ਸਾਰੇ ਗ਼ਮ ਦੂਰ ਕਰ ਦਿਆਂਗੀ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "चित के सकल सोक कह ख्वैहो ॥२७॥",
      "sourceLineId": "131845",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜੋ ਤਾ ਪਹਿ ਨ੍ਰਿਪ ਸਖੀ ਪਠਾਵੈ ॥",
      "transliteration": "jo taa peh nirap sakhee paThaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਾਸ (ਜਦ) ਰਾਜਾ ਸਖੀ ਨੂੰ ਭੇਜਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "जो ता पहि नृप सखी पठावै ॥",
      "sourceLineId": "131846",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੋ ਚਲਿ ਤੀਰ ਤਵਨ ਕੈ ਆਵੈ ॥",
      "transliteration": "so chal teer tavan kai aavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਹ ਚਲ ਕੇ ਉਸ ਪਾਸ ਆਉਾਂਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "सो चलि तीर तवन कै आवै ॥",
      "sourceLineId": "131847",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰਾਨੀ ਕੇ ਸੰਗ ਸੋਤ ਨਿਹਾਰੈ ॥",
      "transliteration": "raanee ke sa(n)g sot nihaarai ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ) ਉਸ ਨੂੰ ਰਾਣੀ ਨਾਲ ਸੁਤਿਆਂ ਵੇਖਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "रानी के संग सोत निहारै ॥",
      "sourceLineId": "131848",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਨ੍ਰਿਪ ਸੋ ਜਾਇ ਉਚਾਰੈ ॥੨੮॥",
      "transliteration": "eeh bidh nirap so jai uchaarai ||28||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸੇ ਤਰ੍ਰਹਾ ਰਾਜੇ ਨੂੰ ਜਾ ਦਸਦੀ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "इह बिधि नृप सो जाइ उचारै ॥२८॥",
      "sourceLineId": "131849",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਰਾਨੀ ਨ੍ਰਿਪਤਿ ਭੇਦ ਲਖ ਗਈ ॥",
      "transliteration": "raanee nirapat bhedh lakh giee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ ਸੋਚਿਆ ਕਿ) ਰਾਣੀ ਮੇਰਾ ਭੇਦ ਸਮਝ ਗਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "रानी नृपति भेद लख गई ॥",
      "sourceLineId": "131850",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਾ ਤੇ ਵਹਿ ਛੋਰਤ ਨਹਿ ਭਈ ॥",
      "transliteration": "taa te veh chhorat neh bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਉਹ (ਉਸ ਨੂੰ) ਛਡ ਨਹੀਂ ਰਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "ता ते वहि छोरत नहि भई ॥",
      "sourceLineId": "131851",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਪਨੇ ਸੰਗ ਤਾਹਿ ਲੈ ਸੋਈ ॥",
      "transliteration": "apane sa(n)g taeh lai soiee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸੇ ਲਈ) ਉਸ ਨੂੰ ਨਾਲ ਲੈ ਕੇ ਸੌਂਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "अपने संग ताहि लै सोई ॥",
      "sourceLineId": "131852",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਮਰੋ ਦਾਵ ਨ ਲਾਗਤ ਕੋਈ ॥੨੯॥",
      "transliteration": "hamaro dhaav na laagat koiee ||29||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰਾ ਕੋਈ ਦਾਓ ਨਹੀਂ ਲਗਦਾ ਹੈ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "हमरो दाव न लागत कोई ॥२९॥",
      "sourceLineId": "131853",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਬ ਇਹ ਭਾਤਿ ਨ੍ਰਿਪਤਿ ਸੁਨਿ ਪਾਵੈ ॥",
      "transliteration": "jab ieh bhaat nirapat sun paavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜਾ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "जब इह भाति नृपति सुनि पावै ॥",
      "sourceLineId": "131854",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਹ ਤਿਹ ਆਪੁ ਬਿਲੋਕਨ ਆਵੈ ॥",
      "transliteration": "teh teh aap bilokan aavai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਥੇ ਆਪ ਵੇਖਣ ਲਈ ਆਉਾਂਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "तह तिह आपु बिलोकन आवै ॥",
      "sourceLineId": "131855",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤ੍ਰਿਯ ਸੋ ਸੋਤ ਜਾਰ ਕੋ ਹੇਰੈ ॥",
      "transliteration": "tiray so sot jaar ko herai ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਉਹ (ਆਪਣੀ) ਯਾਰ ਨੂੰ ਰਾਣੀ ਨਾਲ ਸੁਤਾ ਵੇਖਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "तृय सो सोत जार को हेरै ॥",
      "sourceLineId": "131856",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਿਹਫਲ ਜਾਇ ਤਿਨੈ ਨਾਹਿ ਛੇਰੈ ॥੩੦॥",
      "transliteration": "nihafal jai tinai naeh chherai ||30||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਨ੍ਰਹਾ ਨੂੰ ਨਾ ਛੇੜਦਾ (ਅਤੇ ਉਸ ਦਾ ਉਦਮ) ਨਿਸਫਲ ਹੋ ਜਾਦਾ ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "निहफल जाइ तिनै नाहि छेरै ॥३०॥",
      "sourceLineId": "131857",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਾਥੋ ਧੁਨ੍ਰਯੋ ਨ੍ਰਿਪਤਿ ਸੌ ਕਹਿਯੋ ॥",
      "transliteration": "maatho dhunrayo nirapat sau kahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਮੱਥੇ (ਸਿਰ) ਨੂੰ ਹਿਲਾਇਆ ਅਤੇ ਇਸ ਤਰ੍ਰਹਾ (ਮਨ ਵਿਚ) ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "माथो धुन्रयो नृपति सौ कहियो ॥",
      "sourceLineId": "131858",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਮਰੋ ਭੇਦ ਰਾਨਿਯਹਿ ਲਹਿਯੋ ॥",
      "transliteration": "hamaro bhedh raaniyeh lahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਰਾਣੀ ਨੂੰ ਮੇਰੇ ਭੇਦ ਦਾ ਪਤਾ ਲਗ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "हमरो भेद रानियहि लहियो ॥",
      "sourceLineId": "131859",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਾ ਤੇ ਯਾਹਿ ਸੰਗ ਲੈ ਸੋਈ ॥",
      "transliteration": "taa te yaeh sa(n)g lai soiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਇਸ ਨੂੰ ਨਾਲ ਲੈ ਕੇ ਸੁਤੀ ਪਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "ता ते याहि संग लै सोई ॥",
      "sourceLineId": "131860",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮੇਰੀ ਘਾਤ ਨ ਲਾਗਤ ਕੋਈ ॥੩੧॥",
      "transliteration": "meree ghaat na laagat koiee ||31||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰਾ ਕੋਈ ਦਾਓ ਨਹੀਂ ਲਗ ਰਿਹਾ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "मेरी घात न लागत कोई ॥३१॥",
      "sourceLineId": "131861",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਉਨ ਰਾਨੀ ਐਸੋ ਤਬ ਕੀਯੋ ॥",
      "transliteration": "aun raanee aaiso tab keeyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਰਾਣੀ ਨੇ ਤਦ ਇਸ ਤਰ੍ਰਹਾ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "उन रानी ऐसो तब कीयो ॥",
      "sourceLineId": "131862",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭੇਦ ਭਾਖਿ ਸਖਯਿਨ ਸਭ ਦੀਯੋ ॥",
      "transliteration": "bhedh bhaakh sakhayin sabh dheeyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਭ ਦਾਸੀਆਂ ਨੂੰ ਭੇਦ ਸਮਝਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "भेद भाखि सखयिन सभ दीयो ॥",
      "sourceLineId": "131863",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜੋ ਇਹ ਸੋਤ ਅਨਤ ਨ੍ਰਿਪ ਪਾਵੈ ॥",
      "transliteration": "jo ieh sot anat nirap paavai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜੇ ਰਾਜਾ ਇਸ ਨੂੰ ਹੋਰ ਕਿਤੇ ਸੁਤੀ ਹੋਈ ਵੇਖੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "जो इह सोत अनत नृप पावै ॥",
      "sourceLineId": "131864",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪਕਰਿ ਭੋਗਬੇ ਕਾਜ ਮੰਗਾਵੈ ॥੩੨॥",
      "transliteration": "pakar bhogabe kaaj ma(n)gaavai ||32||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਭੋਗ ਕਰਨ ਲਈ ਮੰਗਵਾ ਲਵੇਗਾ ॥੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "पकरि भोगबे काज मंगावै ॥३२॥",
      "sourceLineId": "131865",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1228_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮੈ ਸੋਵਤ ਤਾ ਤੇ ਇਹ ਸੰਗਾ ॥",
      "transliteration": "mai sovat taa te ieh sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਮੈਂ ਇਸ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 1228,
      "hindi": "",
      "hindiTransliteration": "मै सोवत ता ते इह संगा ॥",
      "sourceLineId": "131866",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
