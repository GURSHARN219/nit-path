{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1229,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1229_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਪਨੇ ਜੋਰ ਅੰਗ ਸੋ ਅੰਗਾ ॥",
      "transliteration": "apane jor a(n)g so a(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਗ ਨਾਲ ਅੰਗ ਜੋੜ ਕੇ ਸੌਂਦੀ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "अपने जोर अंग सो अंगा ॥",
      "sourceLineId": "131867",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਭਲੀ ਭਲੀ ਇਸਤ੍ਰਿਨ ਸਭ ਭਾਖੀ ॥",
      "transliteration": "bhalee bhalee isatiran sabh bhaakhee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਦਾਸੀਆਂ ਨੇ (ਰਾਣੀ ਦੀ ਗੱਲ ਸੁਣ ਕੇ) 'ਭਲੀ ਭਲੀ' ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "भली भली इसतृन सभ भाखी ॥",
      "sourceLineId": "131868",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਨਾਰਿ ਨਾਹ ਤੇ ਰਾਖੀ ॥੩੩॥",
      "transliteration": "jayo(n) tayo(n) naar naeh te raakhee ||33||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਵੇਾਂ ਕਿਵੇਾਂ (ਮਰਦ ਤੋਂ) ਇਸਤਰੀ (ਬਣੀ) ਨੂੰ ਰਾਜੇ ਤੋਂ ਬਚਾਇਆ ॥੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "ज्यों त्यों नारि नाह ते राखी ॥३३॥",
      "sourceLineId": "131869",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦਿਨ ਦੇਖਤ ਰਾਨੀ ਤਿਹ ਸੰਗਾ ॥",
      "transliteration": "dhin dhekhat raanee teh sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਦਿਨ ਵਿਚ ਸਭ ਦੇ ਵੇਖਦਿਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "दिन देखत रानी तिह संगा ॥",
      "sourceLineId": "131870",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੋਵਤ ਜੋਰ ਅੰਗ ਸੋ ਅੰਗਾ ॥",
      "transliteration": "sovat jor a(n)g so a(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਅੰਗ ਨਾਲ ਅੰਗ ਮਿਲਾ ਕੇ ਸੌਂਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "सोवत जोर अंग सो अंगा ॥",
      "sourceLineId": "131871",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮੂਰਖ ਰਾਵ ਭੇਦ ਨਹਿ ਪਾਵੈ ॥",
      "transliteration": "moorakh raav bhedh neh paavai ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਰਾਜਾ ਭੇਦ ਨਹੀਂ ਸਮਝ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "मूरख राव भेद नहि पावै ॥",
      "sourceLineId": "131872",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕੋਰੋ ਅਪਨੋ ਮੂੰਡ ਮੁਡਾਵੈ ॥੩੪॥",
      "transliteration": "koro apano moo(n)dd muddaavai ||34||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੁਕਾ ਹੀ ਸਿਰ ਮੁੰਨਵਾ ਰਿਹਾ ਸੀ ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "कोरो अपनो मूँड मुडावै ॥३४॥",
      "sourceLineId": "131873",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਨਬੇ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੯੦॥੫੫੩੬॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau nabe charitr samaapatam sat subham sat ||290||5536||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੯੦ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੯੦॥੫੫੩੬॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ नबे चरित्र समापतम सतु सुभम सतु ॥२९०॥५५३६॥अफजूँ॥",
      "sourceLineId": "131874",
      "sourceShabadId": "12479",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131875",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪਛਿਮਾਵਤੀ ਨਗਰ ਇਕ ਸੋਹੈ ॥",
      "transliteration": "pachhimaavatee nagar ik sohai ||",
      "translation": "",
      "punjabiViakhya": "ਪਛਿਮਾਵਤੀ ਨਾ ਦਾ ਇਕ ਨਗਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "पछिमावती नगर इक सोहै ॥",
      "sourceLineId": "131876",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪਸਚਿਮ ਸੈਨ ਨ੍ਰਿਪਤਿ ਤਹ ਕੋ ਹੈ ॥",
      "transliteration": "pasachim sain nirapat teh ko hai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੋਂ ਦਾ ਰਾਜਾ ਪਸਚਿਮ ਸੈਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "पसचिम सैन नृपति तह को है ॥",
      "sourceLineId": "131877",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪਸਚਿਮ ਦੇ ਰਾਨੀ ਤਾ ਕੇ ਘਰ ॥",
      "transliteration": "pasachim dhe raanee taa ke ghar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਪਸਚਿਮ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਰਾਣੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "पसचिम दे रानी ता के घर ॥",
      "sourceLineId": "131878",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਹਤ ਪੰਡਿਤਾ ਸਕਲ ਲੋਭਿ ਕਰਿ ॥੧॥",
      "transliteration": "rahat pa(n)dditaa sakal lobh kar ||1||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ) ਪੰਡਿਤ ਵੀ ਲੋਭਾਇਮਾਨ ਹੋ ਜਾਦੇ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "रहत पंडिता सकल लोभि करि ॥१॥",
      "sourceLineId": "131879",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਧਿਕ ਰੂਪ ਰਾਨੀ ਕੋ ਰਹੈ ॥",
      "transliteration": "adhik roop raanee ko rahai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਦੀ ਬਹੁਤ ਰੂਪ ਸੁੰਦਰਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "अधिक रूप रानी को रहै ॥",
      "sourceLineId": "131880",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਗ ਤਿਹ ਦੁਤਿਯ ਚੰਦ੍ਰਮਾ ਕਹੈ ॥",
      "transliteration": "jag teh dhutiy cha(n)dhramaa kahai ||",
      "translation": "",
      "punjabiViakhya": "ਜਗਤ ਉਸ ਨੂੰ ਦੂਜਾ ਚੰਦ੍ਰਮਾ ਕਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "जग तिह दुतिय चंद्रमा कहै ॥",
      "sourceLineId": "131881",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਾ ਪਰ ਰੀਝਿ ਨ੍ਰਿਪਤਿ ਕੀ ਭਾਰੀ ॥",
      "transliteration": "taa par reejh nirapat kee bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਉਤੇ ਰਾਜੇ ਦੀ ਬਹੁਤ ਰੀਝ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "ता पर रीझि नृपति की भारी ॥",
      "sourceLineId": "131882",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਾਨਤ ਊਚ ਨੀਚਿ ਪਨਿਹਾਰੀ ॥੨॥",
      "transliteration": "jaanat uooch neech panihaaree ||2||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਗੱਲ ਨੂੰ) ਅਮੀਰ ਗ਼ਰੀਬ ਅਤੇ ਪਨਿਹਾਰਨਾ ਤਕ ਜਾਣਦੀਆਂ ਸਨ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "जानत ऊच नीचि पनिहारी ॥२॥",
      "sourceLineId": "131883",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਹ ਹੁਤੋ ਰਾਇ ਦਿਲਵਾਲੀ ॥",
      "transliteration": "teh huto rai dhilavaalee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਦਿਲਵਾਲੀ ਰਾਇ (ਨਾ ਦਾ ਵਿਅਕਤੀ) ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "तह हुतो राइ दिलवाली ॥",
      "sourceLineId": "131884",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਾਨਕ ਦੂਸਰਾਸੁ ਹੈ ਮਾਲੀ ॥",
      "transliteration": "jaanak dhoosaraas hai maalee ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਦੂਜਾ ਸੂਰਜ ('ਅੰਸ਼ੁਮਾਲੀ') ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "जानक दूसरासु है माली ॥",
      "sourceLineId": "131885",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੋ ਪਹਿ ਜਾਤ ਨ ਪ੍ਰਭਾ ਬਖਾਨੀ ॥",
      "transliteration": "so peh jaat na prabhaa bakhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪ੍ਰਭਾ ਦਾ (ਮੇਰੇ ਤੋਂ) ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "सो पहि जात न प्रभा बखानी ॥",
      "sourceLineId": "131886",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਉਰਝਿ ਰਹੀ ਦੁਤਿ ਹੇਰਤ ਰਾਨੀ ॥੩॥",
      "transliteration": "aurajh rahee dhut herat raanee ||3||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਸੁੰਦਰਤਾ ਨੂੰ ਵੇਖ ਕੇ ਰਾਣੀ ਮੋਹਿਤ ਹੋ ਗਈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "उरझि रही दुति हेरत रानी ॥३॥",
      "sourceLineId": "131887",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਾ ਸੌ ਅਧਿਕ ਸਨੇਹ ਬਢਾਯੋ ॥",
      "transliteration": "taa sau adhik saneh baddaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ (ਰਾਣੀ ਨੇ) ਬਹੁਤ ਸਨੇਹ ਵਧਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "ता सौ अधिक सनेह बढायो ॥",
      "sourceLineId": "131888",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਗ੍ਰਿਹ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "transliteration": "ek dhivas gireh bol paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਨੂੰ) ਇਕ ਦਿਨ ਘਰ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "एक दिवस गृह बोलि पठायो ॥",
      "sourceLineId": "131889",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੋ ਤਬ ਹੀ ਸੁਨਿ ਬਚ ਪਹ ਗਯੋ ॥",
      "transliteration": "so tab hee sun bach peh gayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਤਦ ਹੀ ਬੋਲ ਸੁਣ ਕੇ (ਉਸ ਕੋਲ) ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "सो तब ही सुनि बच पह गयो ॥",
      "sourceLineId": "131890",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭੇਟਤ ਰਾਜ ਕੁਅਰਿ ਕਹ ਭਯੋ ॥੪॥",
      "transliteration": "bheTat raaj kuar keh bhayo ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਨੂੰ ਜਾ ਕੇ ਮਿਲਿਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "भेटत राज कुअरि कह भयो ॥४॥",
      "sourceLineId": "131891",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪੋਸਤ ਭਾਗ ਅਫੀਮ ਮੰਗਾਈ ॥",
      "transliteration": "posat bhaag afeem ma(n)gaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ) ਪੋਸਤ, ਭੰਗ ਅਤੇ ਅਫ਼ੀਮ ਮੰਗਵਾ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "पोसत भाग अफीम मंगाई ॥",
      "sourceLineId": "131892",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਏਕ ਸੇਜ ਪਰ ਬੈਠਿ ਚੜਾਈ ॥",
      "transliteration": "ek sej par baiTh chaRaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕੋ ਸੇਜ ਉਤੇ ਬੈਠ ਕੇ ਗ੍ਰਹਿਣ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "एक सेज पर बैठि चड़ाई ॥",
      "sourceLineId": "131893",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਬ ਮਦ ਸੋ ਮਤਵਾਰੇ ਭਏ ॥",
      "transliteration": "jab madh so matavaare bhe ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਦੋਵੇਾਂ) ਨਸ਼ੇ ਨਾਲ ਮਤਵਾਲੇ ਹੋ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "जब मद सो मतवारे भए ॥",
      "sourceLineId": "131894",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਬ ਹੀ ਸੋਕ ਬਿਸਰਿ ਸਭ ਗਏ ॥੫॥",
      "transliteration": "tab hee sok bisar sabh ge ||5||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਸਾਰੇ ਗ਼ਮ ਦੂਰ ਹੋ ਗਏ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "तब ही सोक बिसरि सभ गए ॥५॥",
      "sourceLineId": "131895",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਏਕ ਸੇਜ ਪਰ ਬੈਠਿ ਕਲੋਲਹਿ ॥",
      "transliteration": "ek sej par baiTh kaloleh ||",
      "translation": "",
      "punjabiViakhya": "ਇਕੋ ਸੇਜ ਉਤੇ ਬੈਠ ਕੇ ਕਲੋਲ ਕਰਨ ਲਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "एक सेज पर बैठि कलोलहि ॥",
      "sourceLineId": "131896",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਸ ਕੀ ਕਥਾ ਰਸਿਕ ਮਿਲਿ ਬੋਲਹਿ ॥",
      "transliteration": "ras kee kathaa rasik mil boleh ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਦੋਵੇਾਂ) ਰਸਿਕ ਰਸ ਦੀਆਂ ਗੱਲਾ ਕਰਨ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "रस की कथा रसिक मिलि बोलहि ॥",
      "sourceLineId": "131897",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚੁੰਬਨ ਔਰ ਅਲਿੰਗਨ ਕਰਹੀ ॥",
      "transliteration": "chu(n)ban aauar ali(n)gan karahee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਚੁੰਬਨ ਅਤੇ ਆਲਿੰਗਨ ਕਰਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "चुँबन और अलिंगन करही ॥",
      "sourceLineId": "131898",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਭੋਗਨ ਭਰਹੀ ॥੬॥",
      "transliteration": "bhaat bhaat ke bhogan bharahee ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦੇ ਭਰਪੂਰ ਭੋਗ ਕਰਦੇ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के भोगन भरही ॥६॥",
      "sourceLineId": "131899",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰਾਨੀ ਰਮਤ ਅਧਿਕ ਉਰਝਾਈ ॥",
      "transliteration": "raanee ramat adhik urajhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ (ਉਸ ਨਾਲ) ਰਮਣ ਕਰਦਿਆਂ ਬਹੁਤ ਮੋਹਿਤ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "रानी रमत अधिक उरझाई ॥",
      "sourceLineId": "131900",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭੋਗ ਗਏ ਦਿਲਵਾਲੀ ਰਾਈ ॥",
      "transliteration": "bhog ge dhilavaalee raiee ||",
      "translation": "",
      "punjabiViakhya": "ਦਿਲਵਾਲੀ ਰਾਇ ਭੋਗ ਕਰ ਕੇ ਚਲੇ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "भोग गए दिलवाली राई ॥",
      "sourceLineId": "131901",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚਿਤ ਅਪਨੈ ਇਹ ਭਾਤਿ ਬਿਚਾਰੋ ॥",
      "transliteration": "chit apanai ieh bhaat bichaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ) ਆਪਣੇ ਚਿਤ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਸੋਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "चित अपनै इह भाति बिचारो ॥",
      "sourceLineId": "131902",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮੈ ਯਾਹੀ ਕੇ ਸੰਗ ਸਿਧਾਰੋ ॥੭॥",
      "transliteration": "mai yaahee ke sa(n)g sidhaaro ||7||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮੈਂ ਵੀ ਇਸ ਨਾਲ ਹੀ ਚਲੀ ਜਾਵਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "मै याही के संग सिधारो ॥७॥",
      "sourceLineId": "131903",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਾਜ ਪਾਟ ਮੇਰੇ ਕਿਹ ਕਾਜਾ ॥",
      "transliteration": "raaj paaT mere keh kaajaa ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ) ਰਾਜ-ਪਾਟ ਮੇਰੇ ਕਿਸ ਕੰਮ ਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "राज पाट मेरे किह काजा ॥",
      "sourceLineId": "131904",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮੋ ਕਹ ਨਹੀ ਸੁਹਾਵਤ ਰਾਜਾ ॥",
      "transliteration": "mo keh nahee suhaavat raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਇਹ ਰਾਜਾ ਵੀ ਚੰਗਾ ਨਹੀਂ ਲਗਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "मो कह नही सुहावत राजा ॥",
      "sourceLineId": "131905",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮੈ ਸਾਜਨ ਕੇ ਸਾਥ ਸਿਧੈਹੌ ॥",
      "transliteration": "mai saajan ke saath sidhaihau ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਸੱਜਨ ਦੇ ਨਾਲ ਜਾਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "मै साजन के साथ सिधैहौ ॥",
      "sourceLineId": "131906",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭਲੀ ਬੁਰੀ ਸਿਰ ਮਾਝ ਸਹੈਹੌ ॥੮॥",
      "transliteration": "bhalee buree sir maajh sahaihau ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਾੜੀ ਚੰਗੀ ਆਪਣੇ ਸਿਰ ਉਤੇ ਸਹਾਗੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "भली बुरी सिर माझ सहैहौ ॥८॥",
      "sourceLineId": "131907",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਹਾ ਸਿੰਘ ਮਾਰਤ ਬਨ ਮਾਹੀ ॥",
      "transliteration": "jahaa si(n)gh maarat ban maahee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਬਨ ਵਿਚ ਸ਼ੇਰ ਮਾਰ ਦਿੰਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "जहा सिंघ मारत बन माही ॥",
      "sourceLineId": "131908",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੁਨਾ ਦੋਹਰਾ ਏਕ ਤਹਾ ਹੀ ॥",
      "transliteration": "sunaa dhoharaa ek tahaa hee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਮੰਦਿਰ ਸੁਣੀਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "सुना दोहरा एक तहा ही ॥",
      "sourceLineId": "131909",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੜਿ ਝੰਪਾਨ ਤਿਹ ਠੌਰ ਸਿਧਾਈ ॥",
      "transliteration": "chaR jha(n)paan teh Thauar sidhaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ) ਪਾਲਕੀ ਵਿਚ ਚੜ੍ਰਹ ਕੇ ਉਥੋਂ ਨੂੰ ਚਲੀ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "चड़ि झंपान तिह ठौर सिधाई ॥",
      "sourceLineId": "131910",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮਿਤ੍ਰਹਿ ਤਹੀ ਸਹੇਟ ਬਤਾਈ ॥੯॥",
      "transliteration": "mitreh tahee saheT bataiee ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਿਤਰ ਨੂੰ ਵੀ ਮਿਲਾਪ ਦੀ ਥਾ ('ਸਹੇਟ') ਦਸ ਦਿੱਤੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "मित्रहि तही सहेट बताई ॥९॥",
      "sourceLineId": "131911",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਹਾ ਗਹਿਰ ਬਨ ਮੈ ਜਬ ਗਈ ॥",
      "transliteration": "mahaa gahir ban mai jab giee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸੰਘਣੇ ਬਨ ਵਿਚ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "महा गहिर बन मै जब गई ॥",
      "sourceLineId": "131912",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਲਘੁ ਇਛਾ ਕਹ ਉਤਰਤ ਭਈ ॥",
      "transliteration": "lagh ichhaa keh utarat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਪਿਸ਼ਾਬ ਕਰਨ ਦੇ ਬਹਾਨੇ (ਪਾਲਕੀ ਤੋਂ) ਉਤਰੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "लघु इछा कह उतरत भई ॥",
      "sourceLineId": "131913",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1229_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਹ ਤੇ ਗਈ ਮਿਤ੍ਰ ਕੇ ਸੰਗਾ ॥",
      "transliteration": "teh te giee mitr ke sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੋਂ ਮਿਤਰ ਦੇ ਨਾਲ ਚਲੀ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": "तह ते गई मित्र के संगा ॥",
      "sourceLineId": "131914",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
