{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1230,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1230_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਛਿਤ ਮੈ ਡਾਰਿ ਸ੍ਰੋਣ ਕੇ ਰੰਗਾ ॥੧੦॥",
      "transliteration": "chhit mai ddaar sron ke ra(n)gaa ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਧਰਤੀ ਉਤੇ ਲਹੂ ਵਰਗਾ ਰੰਗ ਸੁਟਦੀ ਗਈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "छित मै डारि स्रोण के रंगा ॥१०॥",
      "sourceLineId": "131915",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਬ ਤ੍ਰਿਯ ਸਾਥ ਸਜਨ ਕੇ ਗਈ ॥",
      "transliteration": "jab tiray saath sajan ke giee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਣੀ ਸੱਜਨ ਦੇ ਨਾਲ ਚਲੀ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "जब तृय साथ सजन के गई ॥",
      "sourceLineId": "131916",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਬ ਅਸ ਸਖੀ ਪੁਕਾਰਤ ਭਈ ॥",
      "transliteration": "tab as sakhee pukaarat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਸਖੀ ਇਸ ਤਰ੍ਰਹਾ ਪੁਕਾਰਨ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "तब अस सखी पुकारत भई ॥",
      "sourceLineId": "131917",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਲਏ ਸਿੰਘ ਰਾਨੀ ਕਹ ਜਾਈ ॥",
      "transliteration": "le si(n)gh raanee keh jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਰਾਣੀ ਨੂੰ ਸ਼ੇਰ ਲਈ ਜਾ ਰਿਹਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "लए सिंघ रानी कह जाई ॥",
      "sourceLineId": "131918",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕੋਊ ਆਨਿ ਲੇਹੁ ਛੁਟਕਾਈ ॥੧੧॥",
      "transliteration": "kouoo aan leh chhuTakaiee ||11||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਤੋਂ) ਕੋਈ ਆ ਕੇ ਛੁੜਵਾ ਲਏ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "कोऊ आनि लेहु छुटकाई ॥११॥",
      "sourceLineId": "131919",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੂਰਨ ਸਿੰਘ ਨਾਮ ਸੁਨਿ ਪਾਯੋ ॥",
      "transliteration": "sooran si(n)gh naam sun paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਸੂਰਮਿਆਂ ਨੇ ਸ਼ੇਰ ਦਾ ਨਾ ਸੁਣਿਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "सूरन सिंघ नाम सुनि पायो ॥",
      "sourceLineId": "131920",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤ੍ਰਸਤ ਭਏ ਅਸ ਕਰਨ ਉਚਾਯੋ ॥",
      "transliteration": "trasat bhe as karan uchaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਡਰ ਗਏ ਅਤੇ ਤਲਵਾਰਾ ਹੱਥਾ ਵਿਚ ਖਿਚ ਲਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "त्रसत भए अस करन उचायो ॥",
      "sourceLineId": "131921",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਾਇ ਭੇਦ ਰਾਜਾ ਤਨ ਦਯੋ ॥",
      "transliteration": "jai bhedh raajaa tan dhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਜਾ ਕੇ ਰਾਜੇ ਨੂੰ ਸਾਰੀ ਗੱਲ ਦਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "जाइ भेद राजा तन दयो ॥",
      "sourceLineId": "131922",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਲੈ ਕਰਿ ਸਿੰਘ ਰਾਨਿਯਹਿ ਗਯੋ ॥੧੨॥",
      "transliteration": "lai kar si(n)gh raaniyeh gayo ||12||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਰਾਣੀ ਨੂੰ ਸ਼ੇਰ ਲੈ ਗਿਆ ਹੈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "लै करि सिंघ रानियहि गयो ॥१२॥",
      "sourceLineId": "131923",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨ੍ਰਿਪ ਧੁਨਿ ਸੀਸ ਬਾਇ ਮੁਖ ਰਹਾ ॥",
      "transliteration": "nirap dhun sees bai mukh rahaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਸਿਰ ਹਿਲਾਉਾਂਦਾ ਹੋਇਆ ਮੂੰਹ ਅੱਡੀ ਰਹਿ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "नृप धुनि सीस बाइ मुख रहा ॥",
      "sourceLineId": "131924",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹੋਨਹਾਰ ਭਯੋ ਹੋਤ ਸੁ ਕਹਾ ॥",
      "transliteration": "honahaar bhayo hot su kahaa ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗਾ) ਹੋਣਹਾਰ ਹੋ ਗਈ ਹੈ, (ਹੁਣ) ਕੀ ਹੋ ਸਕਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "होनहार भयो होत सु कहा ॥",
      "sourceLineId": "131925",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਕਛੂ ਨਹਿ ਪਾਯੋ ॥",
      "transliteration": "bhedh abhedh kachhoo neh paayo ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਗੱਲ ਦਾ) ਭੇਦ ਅਭੇਦ ਕਿਸੇ ਨੇ ਨਹੀਂ ਪਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद कछू नहि पायो ॥",
      "sourceLineId": "131926",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਲੈ ਰਾਨੀ ਕਹ ਜਾਰ ਸਿਧਾਯੋ ॥੧੩॥",
      "transliteration": "lai raanee keh jaar sidhaayo ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਨੂੰ ਯਾਰ ਲੈ ਕੇ ਚਲਾ ਗਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "लै रानी कह जार सिधायो ॥१३॥",
      "sourceLineId": "131927",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਇਕ੍ਰਯਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੯੧॥੫੫੪੯॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau ikrayaanavo charitr samaapatam sat subham sat ||291||5549||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੯੧ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੯੧॥੫੫੪੯॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ इक्रयानवो चरित्र समापतम सतु सुभम सतु ॥२९१॥५५४९॥अफजूँ॥",
      "sourceLineId": "131928",
      "sourceShabadId": "12480",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "131929",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਉਤਰ ਸਿੰਘ ਨ੍ਰਿਪਤਿ ਇਕ ਭਾਰੋ ॥",
      "transliteration": "autar si(n)gh nirapat ik bhaaro ||",
      "translation": "",
      "punjabiViakhya": "ਉੱਤਰ ਸਿੰਘ ਨਾ ਦਾ ਇਕ ਵੱਡਾ ਰਾਜਾ",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "उतर सिंघ नृपति इक भारो ॥",
      "sourceLineId": "131930",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਉਤਰ ਦਿਸਿ ਕੋ ਰਹਤ ਨ੍ਰਿਪਾਰੋ ॥",
      "transliteration": "autar dhis ko rahat nirapaaro ||",
      "translation": "",
      "punjabiViakhya": "ਉੱਤਰ ਦਿਸ਼ਾ ਵਿਚ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "उतर दिसि को रहत नृपारो ॥",
      "sourceLineId": "131931",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਉਤਰ ਮਤੀ ਧਾਮ ਤਿਹ ਨਾਰੀ ॥",
      "transliteration": "autar matee dhaam teh naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਉੱਤਰ ਮਤੀ ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "उतर मती धाम तिह नारी ॥",
      "sourceLineId": "131932",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਾ ਸਮ ਕਾਨ ਸੁਨੀ ਨ ਨਿਹਾਰੀ ॥੧॥",
      "transliteration": "jaa sam kaan sunee na nihaaree ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਨਾ ਕੰਨ ਨਾਲ ਸੁਣੀ ਹੈ ਅਤੇ ਨਾ ਹੀ (ਅੱਖਾ ਨਾਲ) ਵੇਖੀ ਹੈ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "जा सम कान सुनी न निहारी ॥१॥",
      "sourceLineId": "131933",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਹਾ ਲਹੌਰੀ ਰਾਇਕ ਆਯੋ ॥",
      "transliteration": "tahaa lahauaree raik aayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਲਹੌਰੀ ਰਾਇ ਨਾ ਦਾ ਇਕ (ਵਿਅਕਤੀ) ਆਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "तहा लहौरी राइक आयो ॥",
      "sourceLineId": "131934",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰੂਪਵਾਨ ਸਭ ਗੁਨਨ ਸਵਾਯੋ ॥",
      "transliteration": "roopavaan sabh gunan savaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਰੂਪਵਾਨ ਅਤੇ ਸਭ ਗੁਣਾ ਵਿਚ ਸਵਾਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "रूपवान सभ गुनन सवायो ॥",
      "sourceLineId": "131935",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਬ ਅਬਲਾ ਤਿਹ ਹੇਰਤ ਭਈ ॥",
      "transliteration": "jab abalaa teh herat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਇਸਤਰੀ ਨੇ ਉਸ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "जब अबला तिह हेरत भई ॥",
      "sourceLineId": "131936",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਤਛਿਨ ਸਭ ਸੁਧਿ ਬੁਧਿ ਤਜਿ ਦਈ ॥੨॥",
      "transliteration": "tatachhin sabh sudh budh taj dhiee ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸੇ ਛਿਣ ਸਾਰੀ ਸੁੱਧ ਬੁੱਧ ਭੁਲਾ ਦਿੱਤੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "ततछिन सभ सुधि बुधि तजि दई ॥२॥",
      "sourceLineId": "131937",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਉਰ ਅੰਚਰਾ ਅੰਗਿਯਾ ਨ ਸੰਭਾਰੈ ॥",
      "transliteration": "aur a(n)charaa a(n)giyaa na sa(n)bhaarai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਤੋਂ) ਛਾਤੀ ਦਾ ਕਪੜਾ ਅਤੇ ਅੰਗਾ ਦਾ ਬਸਤ੍ਰ ਸੰਭਾਲਿਆ ਨਹੀਂ ਜਾ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "उर अंचरा अंगिया न संभारै ॥",
      "sourceLineId": "131938",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਹਬ ਕਛੂ ਹ੍ਵੈ ਕਛੂ ਉਚਾਰੈ ॥",
      "transliteration": "kahab kachhoo havai kachhoo uchaarai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਕਹਿਣਾ ਕੁਝ ਚਾਹੁੰਦੀ ਸੀ ਅਤੇ ਕਿਹਾ ਕੁਝ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "कहब कछू ह्वै कछू उचारै ॥",
      "sourceLineId": "131939",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਿਯ ਪਿਯ ਰਟਤ ਸਦਾ ਮੁਖ ਰਹੈ ॥",
      "transliteration": "piy piy raTat sadhaa mukh rahai ||",
      "translation": "",
      "punjabiViakhya": "ਮੂੰਹ ਤੋਂ ਸਦਾ 'ਪ੍ਰਿਯ ਪ੍ਰਿਯ' ਬੋਲਦੀ ਰਹਿੰਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "पिय पिय रटत सदा मुख रहै ॥",
      "sourceLineId": "131940",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਿਸ ਦਿਨ ਜਲ ਅਖਿਯਾ ਤੇ ਬਹੈ ॥੩॥",
      "transliteration": "nis dhin jal akhiyaa te bahai ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਤ ਦਿਨ ਅੱਖਾ ਤੋਂ ਜਲ ਵਗਦਾ ਰਹਿੰਦਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "निस दिन जल अखिया ते बहै ॥३॥",
      "sourceLineId": "131941",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪੂਛਨ ਤਾਹਿ ਰਾਇ ਜਬ ਆਵੈ ॥",
      "transliteration": "poochhan taeh rai jab aavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜਦ ਰਾਜਾ ਪੁਛਣ ਆਉਾਂਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "पूछन ताहि राइ जब आवै ॥",
      "sourceLineId": "131942",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮੁਹੌ ਨ ਭਾਖਿ ਉਤਰਹਿ ਦ੍ਰਯਾਵੈ ॥",
      "transliteration": "muhau na bhaakh utareh dhrayaavai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਮੂੰਹ ਵਿਚੋਂ ਕਹਿ ਕੇ ਕੋਈ ਉਤਰ ਨਾ ਦਿੰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "मुहौ न भाखि उतरहि द्रयावै ॥",
      "sourceLineId": "131943",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਝੂਮ ਝੂਮਿ ਝਟ ਦੈ ਛਿਤ ਝਰੈ ॥",
      "transliteration": "jhoom jhoom jhaT dhai chhit jharai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਝੂੰਮ ਝੂੰਮ ਕੇ ਝਟ ਧਰਤੀ ਉਤੇ ਡਿਗ ਪੈਂਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "झूम झूमि झट दै छित झरै ॥",
      "sourceLineId": "131944",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਾਰ ਬਾਰ ਪਿਯ ਸਬਦ ਉਚਰੈ ॥੪॥",
      "transliteration": "baar baar piy sabadh ucharai ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਾਰ ਬਾਰ 'ਪ੍ਰਿਯ' ਸ਼ਬਦ ਉਚਾਰਦੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "बार बार पिय सबद उचरै ॥४॥",
      "sourceLineId": "131945",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਦਭੁਤ ਹੇਰਿ ਰਾਇ ਹ੍ਵੈ ਰਹੈ ॥",
      "transliteration": "adhabhut her rai havai rahai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ (ਇਹ) ਵੇਖ ਕੇ ਹੈਰਾਨ ਹੋ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "अदभुत हेरि राइ ह्वै रहै ॥",
      "sourceLineId": "131946",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਖਿਯਨ ਸੌ ਐਸੀ ਬਿਧਿ ਕਹੈ ॥",
      "transliteration": "sakhiyan sau aaisee bidh kahai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦਾਸੀਆਂ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿੰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "सखियन सौ ऐसी बिधि कहै ॥",
      "sourceLineId": "131947",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਯਾ ਅਬਲਾ ਕੌ ਕਸ ਹ੍ਵੈ ਗਯੋ ॥",
      "transliteration": "yaa abalaa kau kas havai gayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਸ ਅਬਲਾ ਨੂੰ ਕੀ ਹੋ ਗਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "या अबला कौ कस ह्वै गयो ॥",
      "sourceLineId": "131948",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਾ ਤੇ ਹਾਲ ਐਸ ਇਹ ਭਯੋ ॥੫॥",
      "transliteration": "jaa te haal aais ieh bhayo ||5||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਇਸ ਦਾ ਅਜਿਹਾ ਹਾਲ ਹੋ ਗਿਆ ਹੈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "जा ते हाल ऐस इह भयो ॥५॥",
      "sourceLineId": "131949",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਯਾ ਕੌ ਕੌਨ ਜਤਨ ਤਬ ਕਰੈ ॥",
      "transliteration": "yaa kau kauan jatan tab karai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਦਾ ਤਦ ਕਿਹੜਾ ਉਪਾ ਕਰੀਐ,",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "या कौ कौन जतन तब करै ॥",
      "sourceLineId": "131950",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਾ ਤੇ ਯਹ ਰਾਨੀ ਨਹਿ ਮਰੈ ॥",
      "transliteration": "jaa te yeh raanee neh marai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਇਹ ਰਾਣੀ ਨਾ ਮਰੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "जा ते यह रानी नहि मरै ॥",
      "sourceLineId": "131951",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੋ ਵਹ ਮਾਗੈ ਸੋ ਮੈ ਦੈ ਹੌ ॥",
      "transliteration": "jo veh maagai so mai dhai hau ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਉਹ (ਉਪਾ ਕਰਨ ਵਾਲਾ) ਮੰਗੇਗਾ, ਉਹੀ ਮੈਂ ਦਿਆਂਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "जो वह मागै सो मै दै हौ ॥",
      "sourceLineId": "131952",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਾਨੀ ਨਿਮਿਤਿ ਕਰਵਤਹਿ ਲੈ ਹੌ ॥੬॥",
      "transliteration": "raanee nimit karavateh lai hau ||6||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਰਾਣੀ ਲਈ ਆਰੇ ਨਾਲ ਚੀਰੇ ਜਾਣ ਲਈ ਵੀ ਤਿਆਰ ਹਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "रानी निमिति करवतहि लै हौ ॥६॥",
      "sourceLineId": "131953",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਿਰ ਕਰਿ ਤਿਹ ਆਗੈ ਜਲ ਭਰੌ ॥",
      "transliteration": "sir kar teh aagai jal bharau ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਉਸ ਅਗੇ ਸਿਰ ਉਤੇ (ਚੁਕ ਕੇ) ਪਾਣੀ ਭਰਾਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "सिर करि तिह आगै जल भरौ ॥",
      "sourceLineId": "131954",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਾਰ ਬਾਰ ਤਾ ਕੇ ਪਗ ਪਰੌ ॥",
      "transliteration": "baar baar taa ke pag parau ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਾਰ ਬਾਰ ਉਸ ਦੇ ਪੈਰੀਂ ਪਵਾਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "बार बार ता के पग परौ ॥",
      "sourceLineId": "131955",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜੋ ਰਾਨੀ ਕਾ ਰੋਗ ਮਿਟਾਵੈ ॥",
      "transliteration": "jo raanee kaa rog miTaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਰਾਣੀ ਦਾ ਰੋਗ ਮਿਟਾ ਦੇਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "जो रानी का रोग मिटावै ॥",
      "sourceLineId": "131956",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਰਾਨੀ ਸਹਿਤ ਰਾਜ ਕਹ ਪਾਵੈ ॥੭॥",
      "transliteration": "raanee sahit raaj keh paavai ||7||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰਾਣੀ ਸਮੇਤ (ਮੇਰੇ) ਰਾਜ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰ ਲਵੇ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "रानी सहित राज कह पावै ॥७॥",
      "sourceLineId": "131957",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜੋ ਰਾਨੀ ਕਾ ਰੋਗੁ ਮਿਟਾਵੈ ॥",
      "transliteration": "jo raanee kaa rog miTaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਰਾਣੀ ਦਾ ਰੋਗ ਮਿਟਾਏਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "जो रानी का रोगु मिटावै ॥",
      "sourceLineId": "131958",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੋ ਨਰ ਹਮ ਕਹ ਬਹੁਰਿ ਜਿਯਾਵੈ ॥",
      "transliteration": "so nar ham keh bahur jiyaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਆਦਮੀ ਮੈਨੂੰ ਫਿਰ ਤੋਂ ਜੀਵਨ ਦਾਨ ਦੇਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "सो नर हम कह बहुरि जियावै ॥",
      "sourceLineId": "131959",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਰਧ ਰਾਜ ਰਾਨੀ ਜੁਤ ਲੇਈ ॥",
      "transliteration": "aradh raaj raanee jut leiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਭਾਵੇਾਂ) ਰਾਣੀ ਸਮੇਤ ਅੱਧਾ ਰਾਜ ਲੈ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "अरध राज रानी जुत लेई ॥",
      "sourceLineId": "131960",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਏਕ ਰਾਤ੍ਰਿ ਹਮ ਕਹ ਤ੍ਰਿਯ ਦੇਈ ॥੮॥",
      "transliteration": "ek raatr ham keh tiray dheiee ||8||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਰਾਤ ਲਈ (ਉਹ) ਮੈਨੂੰ ਇਸਤਰੀ ਦੇ ਦਿਆ ਕਰੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "एक रातृ हम कह तृय देई ॥८॥",
      "sourceLineId": "131961",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1230_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਵਹੁ ਰਾਜ ਕਰਾਵੈ ॥",
      "transliteration": "ek dhivas vahu raaj karaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ ਵੀ ਰਾਣੀ ਨੂੰ ਠੀਕ ਕਰ ਦੇਵੇ) ਉਹ ਇਕ ਦਿਨ ਰਾਜ ਕਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 1230,
      "hindi": "",
      "hindiTransliteration": "एक दिवस वहु राज करावै ॥",
      "sourceLineId": "131962",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
