{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1231,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1231_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਨੀ ਕੇ ਸੰਗ ਭੋਗ ਕਮਾਵੈ ॥",
      "transliteration": "raanee ke sa(n)g bhog kamaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਦਾ ਸੰਯੋਗ ਸੁਖ ਮਾਣੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "रानी के संग भोग कमावै ॥",
      "sourceLineId": "131963",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੂਸਰ ਦਿਨ ਹਮ ਰਾਜ ਕਮਾਵਹਿ ॥",
      "transliteration": "dhoosar dhin ham raaj kamaaveh ||",
      "translation": "",
      "punjabiViakhya": "ਦੂਜੇ ਦਿਨ ਮੈਂ ਰਾਜ ਕਰਾਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "दूसर दिन हम राज कमावहि ॥",
      "sourceLineId": "131964",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਲੈ ਅਪਨੀ ਇਸਤ੍ਰਿਯਹਿ ਬਜਾਵਹਿ ॥੯॥",
      "transliteration": "lai apanee isatirayeh bajaaveh ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੀ ਇਸਤਰੀ ਲੈ ਕੇ ਸੰਯੋਗ ਕਰਾਗਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "लै अपनी इसतृयहि बजावहि ॥९॥",
      "sourceLineId": "131965",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਬ ਬਹੁ ਬਿਧਿ ਨ੍ਰਿਪ ਐਸ ਉਚਰਾ ॥",
      "transliteration": "jab bahu bidh nirap aais ucharaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਇੰਜ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "जब बहु बिधि नृप ऐस उचरा ॥",
      "sourceLineId": "131966",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਹਚਰਿ ਏਕ ਜੋਰ ਦੋਊ ਕਰਾ ॥",
      "transliteration": "sahachar ek jor dhouoo karaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਕ ਸਖੀ ਨੇ ਦੋਵੇਾਂ ਹੱਥ ਜੋੜ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "सहचरि एक जोर दोऊ करा ॥",
      "sourceLineId": "131967",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਯੌ ਰਾਜਾ ਸੌ ਬਚਨ ਉਚਾਰੇ ॥",
      "transliteration": "yau raajaa sau bachan uchaare ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਪ੍ਰਤਿ ਇਸ ਤਰ੍ਰਹਾ ਬੋਲ ਉਚਾਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "यौ राजा सौ बचन उचारे ॥",
      "sourceLineId": "131968",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੁ ਮੈ ਕਹਤ ਹੌ ਸੁਨਹੋ ਪ੍ਯਾਰੇ ॥੧੦॥",
      "transliteration": "s mai kahat hau sunaho payaare ||10||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਿਆਰੇ ਰਾਜਨ! (ਇਸ ਬਾਰੇ) ਜੋ ਮੈਂ ਕਹਿੰਦੀ ਹਾ, ਉਹ ਸੁਣੋ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "सु मै कहत हौ सुनहो प्यारे ॥१०॥",
      "sourceLineId": "131969",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਏਕ ਬੈਦ ਤੁਮ ਤਾਹਿ ਬੁਲਾਵੌ ॥",
      "transliteration": "ek baidh tum taeh bulaavau ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਵੈਦ ਹੈ, ਤੁਸੀਂ ਉਸ ਨੂੰ ਬੁਲਾਓ",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "एक बैद तुम ताहि बुलावौ ॥",
      "sourceLineId": "131970",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਾ ਤੇ ਇਹ ਉਪਚਾਰ ਕਰਾਵੋ ॥",
      "transliteration": "taa te ieh upachaar karaavo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਤੋਂ ਇਸ ਦਾ ਇਲਾਜ ਕਰਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "ता ते इह उपचार करावो ॥",
      "sourceLineId": "131971",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੋ ਛਿਨ ਮੈ ਯਾ ਕੋ ਦੁਖ ਹਰਿ ਹੈ ॥",
      "transliteration": "so chhin mai yaa ko dhukh har hai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਛਿਣ ਵਿਚ ਇਸ ਦਾ ਦੁਖ ਦੂਰ ਕਰ ਦੇਵੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "सो छिन मै या को दुख हरि है ॥",
      "sourceLineId": "131972",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰੋਗਨਿ ਤੇ ਸੁ ਅਰੋਗਿਨਿ ਕਰਿ ਹੈ ॥੧੧॥",
      "transliteration": "rogan te su arogin kar hai ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰੋਗਣ ਤੋਂ ਅਰੋਗਣ ਕਰ ਦੇਵੇਗਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "रोगनि ते सु अरोगिनि करि है ॥११॥",
      "sourceLineId": "131973",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਬ ਰਾਜੇ ਐਸੇ ਸੁਨਿ ਪਾਵਾ ॥",
      "transliteration": "jab raaje aaise sun paavaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "जब राजे ऐसे सुनि पावा ॥",
      "sourceLineId": "131974",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਤਛਿਨ ਤਾ ਕਹ ਬੋਲਿ ਪਠਾਵਾ ॥",
      "transliteration": "tatachhin taa keh bol paThaavaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਤੁਰਤ ਉਸ ਨੂੰ ਬੁਲਾਵਾ ਭੇਜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "ततछिन ता कह बोलि पठावा ॥",
      "sourceLineId": "131975",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਾਨੀ ਕੀ ਨਾਟਿਕਾ ਦਿਖਾਈ ॥",
      "transliteration": "raanee kee naaTikaa dhikhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਦੀ ਨਬਜ਼ ਵਿਖਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "रानी की नाटिका दिखाई ॥",
      "sourceLineId": "131976",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬੋਲਾ ਬੈਦ ਦੇਖਿ ਸੁਖਦਾਈ ॥੧੨॥",
      "transliteration": "bolaa baidh dhekh sukhadhaiee ||12||",
      "translation": "",
      "punjabiViakhya": "(ਨਬਜ਼) ਵੇਖ ਕੇ ਸੁਖ ਪ੍ਰਦਾਨ ਕਰਨ ਵਾਲਾ ਵੈਦ ਬੋਲਿਆ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "बोला बैद देखि सुखदाई ॥१२॥",
      "sourceLineId": "131977",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੁਖ ਜੌਨੇ ਇਹ ਤਰੁਨਿ ਦੁਖਾਈ ॥",
      "transliteration": "dhukh jauane ieh tarun dhukhaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਹੇ ਰਾਜਨ!) ਜਿਸ ਦੁਖ ਨੇ ਇਹ ਇਸਤਰੀ ਨੂੰ ਦੁਖੀ ਕੀਤਾ ਹੋਇਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "दुख जौने इह तरुनि दुखाई ॥",
      "sourceLineId": "131978",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੋ ਦੁਖ ਤੁਮ ਸੋ ਕਹਿਯੋ ਨ ਜਾਈ ॥",
      "transliteration": "so dhukh tum so kahiyo na jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦੁਖ ਤੁਹਾਨੂੰ ਦਸਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "सो दुख तुम सो कहियो न जाई ॥",
      "sourceLineId": "131979",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਾਨ ਮਾਫ ਹਮਰੀ ਜੋ ਕੀਜੈ ॥",
      "transliteration": "jaan maaf hamaree jo keejai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ (ਪਹਿਲਾ) ਮੇਰੀ ਜਾਨ-ਬਖ਼ਸ਼ੀ ਕਰ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "जान माफ हमरी जो कीजै ॥",
      "sourceLineId": "131980",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪਾਛੇ ਬਾਤ ਸਕਲ ਸੁਨਿ ਲੀਜੈ ॥੧੩॥",
      "transliteration": "paachhe baat sakal sun leejai ||13||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਬਾਦ ਵਿਚ (ਮੇਰੀ) ਸਾਰੀ ਗੱਲ ਸੁਣ ਲਵੋ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "पाछे बात सकल सुनि लीजै ॥१३॥",
      "sourceLineId": "131981",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਯਾ ਰਾਨੀ ਕਹ ਕਾਮ ਸੰਤਾਯੋ ॥",
      "transliteration": "yaa raanee keh kaam sa(n)taayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਰਾਣੀ ਨੂੰ ਕਾਮ ਦੁਖੀ ਕਰ ਰਿਹਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "या रानी कह काम संतायो ॥",
      "sourceLineId": "131982",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤੁਮ ਨਹਿ ਇਹ ਸੰਗ ਭੋਗ ਕਮਾਯੋ ॥",
      "transliteration": "tum neh ieh sa(n)g bhog kamaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੁਸੀਂ ਇਸ ਨਾਲ ਭੋਗ ਨਹੀਂ ਕਰ ਰਹੇ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "तुम नहि इह संग भोग कमायो ॥",
      "sourceLineId": "131983",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਾ ਤੇ ਯਹਿ ਰੋਗ ਗਹਿ ਲੀਨਾ ॥",
      "transliteration": "taa te yeh rog geh leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਰੋਗ ਨੇ ਇਸ ਨੂੰ ਗ੍ਰਸਿਤ ਕਰ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "ता ते यहि रोग गहि लीना ॥",
      "sourceLineId": "131984",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਮ ਤੇ ਜਾਤ ਉਪਾ ਨ ਕੀਨਾ ॥੧੪॥",
      "transliteration": "ham te jaat upaa na keenaa ||14||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਕੋਲੋਂ ਇਸ ਦਾ (ਕੋਈ) ਉਪਚਾਰ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "हम ते जात उपा न कीना ॥१४॥",
      "sourceLineId": "131985",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਯਹ ਮਦ ਮਤ ਮੈਨ ਤ੍ਰਿਯ ਭਰੀ ॥",
      "transliteration": "yeh madh mat main tiray bharee ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਇਸਤਰੀ ਕਾਮ ਭਾਵਨਾ ਨਾਲ ਭਰੀ ਹੋਈ ਮਦਮਸਤ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "यह मद मत मैन तृय भरी ॥",
      "sourceLineId": "131986",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤੁਮ ਕ੍ਰੀੜਾ ਇਹ ਸਾਥ ਨ ਕਰੀ ॥",
      "transliteration": "tum kreeRaa ieh saath na karee ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਇਸ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਨਹੀਂ ਕੀਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "तुम क्रीड़ा इह साथ न करी ॥",
      "sourceLineId": "131987",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਬ ਯਹ ਅਧਿਕ ਭੋਗ ਜਬ ਪਾਵੈ ॥",
      "transliteration": "ab yeh adhik bhog jab paavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਇਸ ਨਾਲ ਬਹੁਤ ਭੋਗ ਕੀਤਾ ਜਾਵੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "अब यह अधिक भोग जब पावै ॥",
      "sourceLineId": "131988",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਯਾ ਕੋ ਰੋਗ ਦੂਰ ਹ੍ਵੈ ਜਾਵੈ ॥੧੫॥",
      "transliteration": "yaa ko rog dhoor havai jaavai ||15||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਸ ਦਾ ਰੋਗ ਦੂਰ ਹੋ ਜਾਵੇਗਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "या को रोग दूर ह्वै जावै ॥१५॥",
      "sourceLineId": "131989",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਹ ਤੁਮ ਤਬ ਉਪਚਾਰ ਕਰਾਵੋ ॥",
      "transliteration": "eeh tum tab upachaar karaavo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਦਾ (ਮੇਰੇ ਪਾਸੋਂ) ਤਦ ਤੁਸੀਂ ਉਪਚਾਰ ਕਰਵਾਓ,",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "इह तुम तब उपचार करावो ॥",
      "sourceLineId": "131990",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਚਨ ਹਾਥ ਮੋਰੇ ਪਰ ਦ੍ਰਯਾਵੋ ॥",
      "transliteration": "bachan haath more par dhrayaavo ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ ਪਹਿਲਾ) ਤੁਸੀਂ ਮੇਰੇ ਹੱਥ ਉਤੇ ਬਚਨ ਦਿਓਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "बचन हाथ मोरे पर द्रयावो ॥",
      "sourceLineId": "131991",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਬ ਇਹ ਦੁਖ ਮੈ ਦੂਰ ਕਰਾਊ ॥",
      "transliteration": "jab ieh dhukh mai dhoor karaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਮੈਂ ਇਸ ਦਾ ਦੁਖ ਦੂਰ ਕਰ ਦਿਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "जब इह दुख मै दूर कराऊ ॥",
      "sourceLineId": "131992",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਰਧ ਰਾਜ ਰਾਨੀ ਜੁਤ ਪਾਊ ॥੧੬॥",
      "transliteration": "aradh raaj raanee jut paauoo ||16||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਾਣੀ ਸਮੇਤ ਅੱਧਾ ਰਾਜ ਪ੍ਰਾਪਤ ਕਰਾ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "अरध राज रानी जुत पाऊ ॥१६॥",
      "sourceLineId": "131993",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਲੀ ਭਲੀ ਰਾਜੈ ਤਬ ਭਾਖੀ ॥",
      "transliteration": "bhalee bhalee raajai tab bhaakhee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ (ਗੱਲ ਸੁਣ ਕੇ) 'ਚੰਗਾ ਚੰਗਾ' ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "भली भली राजै तब भाखी ॥",
      "sourceLineId": "131994",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਮਹੂੰ ਇਹ ਹਿਰਦੈ ਮਥਿ ਰਾਖੀ ॥",
      "transliteration": "hamahoo(n) ieh hiradhai math raakhee ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਸਪਸ਼ਟ ਕੀਤਾ ਕਿ) ਮੈਂ ਵੀ ਇਹੀ ਮਨ ਵਿਚ ਸੋਚ ਰਖਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "हमहूँ इह हिरदै मथि राखी ॥",
      "sourceLineId": "131995",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪ੍ਰਥਮ ਰੋਗ ਤੁਮ ਯਾਹਿ ਮਿਟਾਵੋ ॥",
      "transliteration": "pratham rog tum yaeh miTaavo ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਤੁਸੀਂ ਇਸ ਦਾ ਰੋਗ ਮਿਟਾ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "प्रथम रोग तुम याहि मिटावो ॥",
      "sourceLineId": "131996",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਰਧ ਰਾਜ ਰਾਨੀ ਜੁਤ ਪਾਵੋ ॥੧੭॥",
      "transliteration": "aradh raaj raanee jut paavo ||17||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਰਾਣੀ ਸਮੇਤ ਅੱਧਾ ਰਾਜ ਪ੍ਰਾਪਤ ਕਰੋ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "अरध राज रानी जुत पावो ॥१७॥",
      "sourceLineId": "131997",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪ੍ਰਥਮਹਿ ਬਚਨ ਨ੍ਰਿਪਤਿ ਤੇ ਲਿਯਾ ॥",
      "transliteration": "prathameh bachan nirapat te liyaa ||",
      "translation": "",
      "punjabiViakhya": "(ਵੈਦ ਨੇ) ਪਹਿਲਾ ਰਾਜੇ ਤੋਂ ਬਚਨ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "प्रथमहि बचन नृपति ते लिया ॥",
      "sourceLineId": "131998",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪੁਨਿ ਉਪਚਾਰ ਤਰੁਨਿ ਕੋ ਕਿਯਾ ॥",
      "transliteration": "pun upachaar tarun ko kiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਇਸਤਰੀ ਦਾ ਉਪਚਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "पुनि उपचार तरुनि को किया ॥",
      "sourceLineId": "131999",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭੋਗ ਕਿਯੋ ਤ੍ਰਿਯ ਰੋਗ ਮਿਟਾਯੋ ॥",
      "transliteration": "bhog kiyo tiray rog miTaayo ||",
      "translation": "",
      "punjabiViakhya": "ਭੋਗ ਕਰ ਕੇ ਇਸਤਰੀ ਦਾ ਰੋਗ ਮਿਟਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "भोग कियो तृय रोग मिटायो ॥",
      "sourceLineId": "132000",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਰਧ ਰਾਜ ਰਾਨੀ ਜੁਤ ਪਾਯੋ ॥੧੮॥",
      "transliteration": "aradh raaj raanee jut paayo ||18||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਸਮੇਤ ਅੱਧਾ ਰਾਜ ਪ੍ਰਾਪਤ ਕੀਤਾ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "अरध राज रानी जुत पायो ॥१८॥",
      "sourceLineId": "132001",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਰਧ ਰਾਜ ਇਹ ਛਲ ਤਿਹ ਦਿਯੋ ॥",
      "transliteration": "aradh raaj ieh chhal teh dhiyo ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸਤਰੀ ਨੇ) ਇਸ ਛਲ ਨਾਲ ਅੱਧਾ ਰਾਜ ਉਸ (ਯਾਰ) ਨੂੰ ਦਿਵਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "अरध राज इह छल तिह दियो ॥",
      "sourceLineId": "132002",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰਾਨੀ ਭੋਗ ਮਿਤ੍ਰ ਸੰਗ ਕਿਯੋ ॥",
      "transliteration": "raanee bhog mitr sa(n)g kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਨੇ ਮਿਤਰ ਨਾਲ ਸੰਯੋਗ ਸੁਖ ਮਾਣਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "रानी भोग मित्र संग कियो ॥",
      "sourceLineId": "132003",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮੂਰਖ ਨਾਹ ਨਾਹਿ ਛਲ ਪਾਯੋ ॥",
      "transliteration": "moorakh naeh naeh chhal paayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਰਾਜਾ ਛਲ ਨੂੰ ਨਾ ਸਮਝ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "मूरख नाह नाहि छल पायो ॥",
      "sourceLineId": "132004",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪ੍ਰਗਟ ਆਪਨੋ ਮੂੰਡ ਮੁੰਡਾਯੋ ॥੧੯॥",
      "transliteration": "pragaT aapano moo(n)dd mu(n)ddaayo ||19||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਗਟ ਰੂਪ ਵਿਚ ਆਪਣਾ ਸਿਰ ਮੁੰਨਵਾਇਆ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "प्रगट आपनो मूँड मुँडायो ॥१९॥",
      "sourceLineId": "132005",
      "sourceShabadId": "12481",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "132006",
      "sourceShabadId": "12482",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਹ ਛਲ ਰਾਨੀ ਨ੍ਰਿਪ ਛਲਾ ਰਮੀ ਮਿਤ੍ਰ ਕੇ ਸਾਥ ॥",
      "transliteration": "eeh chhal raanee nirap chhalaa ramee mitr ke saath ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਰਾਣੀ ਨੇ ਰਾਜੇ ਨੂੰ ਛਲ ਲਿਆ ਅਤੇ ਮਿਤਰ ਨਾਲ ਰਮਣ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "इह छल रानी नृप छला रमी मित्र के साथ ॥",
      "sourceLineId": "132007",
      "sourceShabadId": "12482",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਰਧ ਰਾਜ ਤਾ ਕੋ ਦਿਯਾ ਭੇਦ ਨ ਪਾਯੋ ਨਾਥ ॥੨੦॥",
      "transliteration": "aradh raaj taa ko dhiyaa bhedh na paayo naath ||20||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਅੱਧਾ ਰਾਜ ਦੇ ਦਿੱਤਾ, ਪਰ (ਉਸ ਦਾ) ਭੇਦ ਰਾਜਾ ('ਨਾਥ') ਨਾ ਪਾ ਸਕਿਆ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "अरध राज ता को दिया भेद न पायो नाथ ॥२०॥",
      "sourceLineId": "132008",
      "sourceShabadId": "12482",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "132009",
      "sourceShabadId": "12483",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਅਰਧ ਰਾਜ ਤਿਹ ਦੀਯੋ ॥",
      "transliteration": "eeh bidh aradh raaj teh dheeyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਅੱਧਾ ਰਾਜ ਉਸ (ਮਿਤਰ) ਨੂੰ ਦੇ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "इह बिधि अरध राज तिह दीयो ॥",
      "sourceLineId": "132010",
      "sourceShabadId": "12483",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਮੂਰਖ ਪਤਿ ਕਹ ਅਸਿ ਛਲਿ ਲੀਯੋ ॥",
      "transliteration": "moorakh pat keh as chhal leeyo ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਪਤੀ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਛਲ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "मूरख पति कह असि छलि लीयो ॥",
      "sourceLineId": "132011",
      "sourceShabadId": "12483",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਇਕ ਦਿਨ ਰਨਿਯਹਿ ਜਾਰ ਬਜਾਵੈ ॥",
      "transliteration": "eik dhin raniyeh jaar bajaavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਯਾਰ ਰਾਣੀ ਨਾਲ ਸੰਯੋਗ ਕਰਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "इक दिन रनियहि जार बजावै ॥",
      "sourceLineId": "132012",
      "sourceShabadId": "12483",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅਰਧ ਰਾਜ ਤਿਹ ਆਪ ਕਮਾਵੈ ॥੨੧॥",
      "transliteration": "aradh raaj teh aap kamaavai ||21||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪ ਉਸ ਦਾ ਅੱਧਾ ਰਾਜ ਵੀ ਮਾਣਦਾ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "अरध राज तिह आप कमावै ॥२१॥",
      "sourceLineId": "132013",
      "sourceShabadId": "12483",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਇਕ ਦਿਨ ਆਵੈ ਨ੍ਰਿਪ ਕੈ ਧਾਮਾ ॥",
      "transliteration": "eik dhin aavai nirap kai dhaamaa ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ) ਇਕ ਦਿਨ ਰਾਜੇ ਦੇ ਘਰ ਆਉਾਂਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "इक दिन आवै नृप कै धामा ॥",
      "sourceLineId": "132014",
      "sourceShabadId": "12483",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਇਕ ਦਿਨ ਭਜੈ ਜਾਰ ਕੌ ਬਾਮਾ ॥",
      "transliteration": "eik dhin bhajai jaar kau baamaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਦਿਨ (ਉਸ) ਇਸਤਰੀ ਨਾਲ ਯਾਰ ਸੰਯੋਗ ਕਰਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "इक दिन भजै जार कौ बामा ॥",
      "sourceLineId": "132015",
      "sourceShabadId": "12483",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਇਕ ਦਿਨ ਰਾਜਾ ਰਾਜ ਕਮਾਵੈ ॥",
      "transliteration": "eik dhin raajaa raaj kamaavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਰਾਜਾ ਰਾਜ ਕਰਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "इक दिन राजा राज कमावै ॥",
      "sourceLineId": "132016",
      "sourceShabadId": "12483",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਾਰ ਛਤ੍ਰ ਦਿਨ ਦੁਤਿਯ ਢਰਾਵੈ ॥੨੨॥",
      "transliteration": "jaar chhatr dhin dhutiy ddaraavai ||22||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੂਜੇ ਦਿਨ ਯਾਰ (ਸ਼ਾਹੀ) ਛੱਤਰ ਝੁਲਵਾਉਾਂਦਾ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "जार छत्र दिन दुतिय ढरावै ॥२२॥",
      "sourceLineId": "132017",
      "sourceShabadId": "12483",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਬਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੯੨॥੫੫੭੧॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau baanavo charitr samaapatam sat subham sat ||292||5571||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੯੨ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੯੨॥੫੫੭੧॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ बानवो चरित्र समापतम सतु सुभम सतु ॥२९२॥५५७१॥अफजूँ॥",
      "sourceLineId": "132018",
      "sourceShabadId": "12483",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "132019",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਰਾਜਪੁਰੀ ਨਗਰੀ ਹੈ ਜਹਾ ॥",
      "transliteration": "raajapuree nagaree hai jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਰਾਜਪੁਰੀ ਨਾ ਦੀ ਨਗਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "राजपुरी नगरी है जहा ॥",
      "sourceLineId": "132020",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਰਾਜ ਸੈਨ ਰਾਜਾ ਇਕ ਤਹਾ ॥",
      "transliteration": "raaj sain raajaa ik tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਰਾਜ ਸੈਨ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "राज सैन राजा इक तहा ॥",
      "sourceLineId": "132021",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਰਾਜ ਦੇਈ ਤਾ ਕੇ ਗ੍ਰਿਹ ਨਾਰੀ ॥",
      "transliteration": "raaj dheiee taa ke gireh naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਰਾਜ ਦੇਈ ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "राज देई ता के गृह नारी ॥",
      "sourceLineId": "132022",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਚੰਦ੍ਰ ਲਈ ਜਾ ਤੇ ਉਜਿਯਾਰੀ ॥੧॥",
      "transliteration": "cha(n)dhr liee jaa te ujiyaaree ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤੋਂ (ਮਾਨੋ) ਚੰਦ੍ਰਮਾ ਨੇ ਜੋਤਿ ਲਈ ਹੋਵੇ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "चंद्र लई जा ते उजियारी ॥१॥",
      "sourceLineId": "132023",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਨ੍ਰਿਪ ਸੌ ਅਤਿ ਤ੍ਰਿਯ ਕੋ ਹਿਤ ਰਹੈ ॥",
      "transliteration": "nirap sau at tiray ko hit rahai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦਾ ਇਸਤਰੀ ਨਾਲ ਬਹੁਤ ਹਿਤ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "नृप सौ अति तृय को हित रहै ॥",
      "sourceLineId": "132024",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਸੋਈ ਕਰਤ ਜੁ ਰਾਨੀ ਕਹੈ ॥",
      "transliteration": "soiee karat ju raanee kahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹੀ ਕਰਦਾ ਸੀ ਜੋ ਰਾਣੀ ਕਹਿੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "सोई करत जु रानी कहै ॥",
      "sourceLineId": "132025",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਔਰ ਨਾਰਿ ਕੇ ਧਾਮ ਨ ਜਾਵੈ ॥",
      "transliteration": "aauar naar ke dhaam na jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ (ਕਿਸੇ) ਇਸਤਰੀ ਦੇ ਘਰ ਨਹੀਂ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "और नारि के धाम न जावै ॥",
      "sourceLineId": "132026",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਅਧਿਕ ਨਾਰ ਕੇ ਤ੍ਰਾਸ ਤ੍ਰਸਾਵੈ ॥੨॥",
      "transliteration": "adhik naar ke traas trasaavai ||2||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ ਉਹ ਇਸ) ਇਸਤਰੀ ਦੇ ਡਰ ਤੋਂ ਭੈ ਭੀਤ ਰਹਿੰਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "अधिक नार के त्रास त्रसावै ॥२॥",
      "sourceLineId": "132027",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਰਾਨੀ ਕੀ ਆਗ੍ਯਾ ਸਭ ਮਾਨੈ ॥",
      "transliteration": "raanee kee aagayaa sabh maanai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਰਾਣੀ ਦੀ ਆਗਿਆ ਮੰਨਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "रानी की आग्या सभ मानै ॥",
      "sourceLineId": "132028",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਰਾਜਾ ਕੋ ਕਰਿ ਕਛੂ ਨ ਜਾਨੈ ॥",
      "transliteration": "raajaa ko kar kachhoo na jaanai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੂੰ ਕੁਝ ਨਹੀਂ ਸਮਝਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "राजा को करि कछू न जानै ॥",
      "sourceLineId": "132029",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਮਾਰਿਯੋ ਚਹਤ ਨਾਰਿ ਤਿਹ ਮਾਰੈ ॥",
      "transliteration": "maariyo chahat naar teh maarai ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ) ਰਾਣੀ ਮਾਰਨਾ ਚਾਹੁੰਦੀ, ਉਸ ਨੂੰ ਮਾਰ ਦਿੰਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "मारियो चहत नारि तिह मारै ॥",
      "sourceLineId": "132030",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਜਿਹ ਜਾਨੈ ਤਿਹ ਪ੍ਰਾਨ ਉਬਾਰੈ ॥੩॥",
      "transliteration": "jeh jaanai teh praan ubaarai ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਸ ਨੂੰ ਚਾਹੁੰਦੀ, ਉਸ ਦੇ ਪ੍ਰਾਣ ਬਚਾ ਲੈਂਦੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "जिह जानै तिह प्रान उबारै ॥३॥",
      "sourceLineId": "132031",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਬੇਸ੍ਵਾ ਏਕ ਠੌਰ ਤਿਹ ਆਈ ॥",
      "transliteration": "besavaiaa ek Thauar teh aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਜਗ੍ਰਹਾ ਇਕ ਵੇਸਵਾ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "बेस्वा एक ठौर तिह आई ॥",
      "sourceLineId": "132032",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਤਿਹ ਪਰ ਰਹੇ ਨ੍ਰਿਪਤਿ ਉਰਝਾਈ ॥",
      "transliteration": "teh par rahe nirapat urajhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਉਤੇ ਰਾਜਾ ਮੋਹਿਤ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "तिह पर रहे नृपति उरझाई ॥",
      "sourceLineId": "132033",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1231_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਚਹਤ ਚਿਤ ਮਹਿ ਤਾਹਿ ਬੁਲਾਵੈ ॥",
      "transliteration": "chahat chit meh taeh bulaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਚਿਤ ਕਰਦਾ ਕਿ ਉਸ ਨੂੰ ਬੁਲਾਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1231,
      "hindi": "",
      "hindiTransliteration": "चहत चित महि ताहि बुलावै ॥",
      "sourceLineId": "132034",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
