{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1233,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1233_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹ੍ਰਿਦੈ ਨ੍ਰਿਪਤਿ ਕੀ ਸੰਕ ਨ ਧਰਈ ॥੧੬॥",
      "transliteration": "hiradhai nirapat kee sa(n)k na dhariee ||16||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹਿਰਦੇ ਵਿਚ ਰਾਜੇ ਦਾ ਸੰਕੋਚ ਨਾ ਧਰਦੀ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "हृदै नृपति की संक न धरई ॥१६॥",
      "sourceLineId": "132083",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਾਨੀ ਬੇਸ੍ਵਹਿ ਆਪੁ ਬੁਲਾਯੋ ॥",
      "transliteration": "raanee besavaih aap bulaayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਵੇਸਵਾ ਨੂੰ ਆਪ ਬੁਲਵਾਇਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "रानी बेस्वहि आपु बुलायो ॥",
      "sourceLineId": "132084",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਇਹ ਛਲ ਰਾਜਾ ਤੇ ਲਿਖਿਵਾਯੋ ॥",
      "transliteration": "eeh chhal raajaa te likhivaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਛਲ ਨਾਲ ਰਾਜੇ ਤੋਂ (ਮਾਫ਼ੀਪੱਤਰ) ਲਿਖਵਾਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "इह छल राजा ते लिखिवायो ॥",
      "sourceLineId": "132085",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਿਹ ਚਾਹੈ ਤਿਹ ਬੋਲਿ ਪਠਾਵੈ ॥",
      "transliteration": "jeh chaahai teh bol paThaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ) ਜਿਸ ਨੂੰ ਚਾਹੁੰਦੀ, ਬੁਲਵਾ ਲੈਂਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "जिह चाहै तिह बोलि पठावै ॥",
      "sourceLineId": "132086",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਾਮ ਭੋਗਿ ਰੁਚਿ ਮਾਨਿ ਕਮਾਵੈ ॥੧੭॥",
      "transliteration": "kaam bhog ruch maan kamaavai ||17||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਰੁਚੀ ਪੂਰਵਕ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਦੀ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "काम भोगि रुचि मानि कमावै ॥१७॥",
      "sourceLineId": "132087",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮੂਰਖ ਭੇਦ ਨ ਰਾਜੈ ਪਾਯੋ ॥",
      "transliteration": "moorakh bhedh na raajai paayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਰਾਜੇ ਨੇ ਭੇਦ ਨੂੰ ਨਾ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "मूरख भेद न राजै पायो ॥",
      "sourceLineId": "132088",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਇਹ ਛਲ ਅਪਨੋ ਮੂੰਡ ਮੁਡਾਯੋ ॥",
      "transliteration": "eeh chhal apano moo(n)dd muddaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਛਲ ਨਾਲ (ਆਪਣੇ ਆਪ ਨੂੰ) ਛਲਵਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "इह छल अपनो मूँड मुडायो ॥",
      "sourceLineId": "132089",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਬਲਾ ਐਸੋ ਚਰਿਤ ਬਨਯੋ ॥",
      "transliteration": "abalaa aaiso charit banayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਚਰਿਤ੍ਰ ਬਣਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "अबला ऐसो चरित बनयो ॥",
      "sourceLineId": "132090",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪਤਿ ਤੇ ਭੋਗ ਮਾਫ ਕਰਿ ਲਯੋ ॥੧੮॥",
      "transliteration": "pat te bhog maaf kar layo ||18||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਤੀ ਤੋਂ (ਗ਼ੈਰ ਮਰਦ ਨਾਲ) ਭੋਗ ਕਰਨ ਦਾ ਮਾਫ਼ੀ (ਪੱਤਰ) ਲਿਖਵਾ ਲਿਆ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "पति ते भोग माफ करि लयो ॥१८॥",
      "sourceLineId": "132091",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਤਰਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੯੩॥੫੫੮੯॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau taraanavo charitr samaapatam sat subham sat ||293||5589||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੯੩ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੯੩॥੫੫੮੯॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ तरानवो चरित्र समापतम सतु सुभम सतु ॥२९३॥५५८९॥अफजूँ॥",
      "sourceLineId": "132092",
      "sourceShabadId": "12484",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "132093",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਨਦਾਵਤੀ ਨਗਰ ਇਕ ਸੁਨਾ ॥",
      "transliteration": "anadhaavatee nagar ik sunaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਨਦਾਵਤੀ ਨਾ ਦਾ ਇਕ ਨਗਰ ਸੁਣੀਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "अनदावती नगर इक सुना ॥",
      "sourceLineId": "132094",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਨਦ ਸੈਨ ਨ੍ਰਿਪਤਿ ਬਹੁ ਗੁਨਾ ॥",
      "transliteration": "aanadh sain nirapat bahu gunaa ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਦਾ) ਰਾਜਾ ਆਨਦ ਸੈਨ ਬਹੁਤ ਗੁਣਵਾਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "आनद सैन नृपति बहु गुना ॥",
      "sourceLineId": "132095",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਨਦਾਵਤੀ ਸਦਨ ਤਿਹ ਬਾਲਾ ॥",
      "transliteration": "anadhaavatee sadhan teh baalaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਅਨਦਾਵਤੀ ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "अनदावती सदन तिह बाला ॥",
      "sourceLineId": "132096",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਗਤ ਭਯੋ ਤਾ ਤੇ ਉਜਿਯਾਲਾ ॥੧॥",
      "transliteration": "jagat bhayo taa te ujiyaalaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤੋਂ ਸਾਰਾ ਜਗਤ ਪ੍ਰਕਾਸ਼ਮਾਨ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "जगत भयो ता ते उजियाला ॥१॥",
      "sourceLineId": "132097",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਧਿਕ ਰੂਪ ਬਿਧਿਨਾ ਤਿਹ ਕੀਨਾ ॥",
      "transliteration": "adhik roop bidhinaa teh keenaa ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਧਾਤਾ ਨੇ ਉਸ ਨੂੰ ਬਹੁਤ ਰੂਪਵਾਨ ਬਣਾਇਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "अधिक रूप बिधिना तिह कीना ॥",
      "sourceLineId": "132098",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਾ ਸਮ ਰੂਪ ਨ ਦੂਸਰ ਦੀਨਾ ॥",
      "transliteration": "jaa sam roop na dhoosar dheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਰੂਪ ਕਿਸੇ ਹੋਰ ਨੂੰ ਨਹੀਂ ਦਿੱਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "जा सम रूप न दूसर दीना ॥",
      "sourceLineId": "132099",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਆਯੋ ਪੁਰਖ ਏਕ ਤਬ ਬਨੋ ॥",
      "transliteration": "aayo purakh ek tab bano ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਥੇ ਇਕ ਬਨੀਆ ('ਬਨੋ') ਪੁਰਸ਼ ਆਇਆ (ਅਰਥਾਤਰਬਣਿਆ ਠਣਿਆ ਪੁਰਸ਼ ਆਇਆ)।",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "आयो पुरख एक तब बनो ॥",
      "sourceLineId": "132100",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਾਨੀ ਤੇ ਸੁੰਦਰਿ ਥੋ ਘਨੋ ॥੨॥",
      "transliteration": "raanee te su(n)dhar tho ghano ||2||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਰਾਣੀ ਤੋਂ ਵੀ ਅਧਿਕ ਸੁੰਦਰ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "रानी ते सुँदरि थो घनो ॥२॥",
      "sourceLineId": "132101",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਬ ਅਬਲਾ ਤਿਹ ਰੂਪ ਨਿਹਾਰਾ ॥",
      "transliteration": "jab abalaa teh roop nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਣੀ ਨੇ ਉਸ ਦਾ ਰੂਪ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "जब अबला तिह रूप निहारा ॥",
      "sourceLineId": "132102",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਦਨ ਬਾਨ ਤਾ ਕੇ ਤਨ ਮਾਰਾ ॥",
      "transliteration": "madhan baan taa ke tan maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕਾਮ ਦੇਵ ਨੇ ਉਸ ਦੇ ਸ਼ਰੀਰ ਵਿਚ ਬਾਣ ਮਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "मदन बान ता के तन मारा ॥",
      "sourceLineId": "132103",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰੀਝਿ ਰਹੀ ਸੁੰਦਰਿ ਮਨ ਮਾਹੀ ॥",
      "transliteration": "reejh rahee su(n)dhar man maahee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸੁੰਦਰੀ ਮਨ ਵਿਚ ਮੋਹਿਤ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "रीझि रही सुँदरि मन माही ॥",
      "sourceLineId": "132104",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਘਰ ਬਾਹਰ ਕੀ ਕਛੁ ਸੁਧਿ ਨਾਹੀ ॥੩॥",
      "transliteration": "ghar baahar kee kachh sudh naahee ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਨੂੰ) ਘਰ ਦੀ ਕੁਝ ਸੁੱਧ ਬੁੱਧ ਨਾ ਰਹੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "घर बाहर की कछु सुधि नाही ॥३॥",
      "sourceLineId": "132105",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪਠੈ ਹਿਤੂ ਇਕ ਤਾਹਿ ਬੁਲਾਵਾ ॥",
      "transliteration": "paThai hitoo ik taeh bulaavaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਹਿਤ ਕਰਨ ਵਾਲੀ (ਸਖੀ) ਨੂੰ ਭੇਜ ਕੇ ਉਸ ਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "पठै हितू इक ताहि बुलावा ॥",
      "sourceLineId": "132106",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਿਹ ਸਾਥ ਕਮਾਵਾ ॥",
      "transliteration": "kaam bhog teh saath kamaavaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਕਾਮ-ਭੋਗ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "काम भोग तिह साथ कमावा ॥",
      "sourceLineId": "132107",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਨ ਮਾਨਤ ਆਸਨ ਤਿਹ ਦਏ ॥",
      "transliteration": "man maanat aasan teh dhe ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਮਨ ਭਾਉਾਂਦੇ ਆਸਣ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "मन मानत आसन तिह दए ॥",
      "sourceLineId": "132108",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚੁੰਬਨ ਔਰ ਅਲਿੰਗਨ ਲਏ ॥੪॥",
      "transliteration": "chu(n)ban aauar ali(n)gan le ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੁੰਬਨ ਤੇ ਆਲਿੰਗਨ ਲਿਤੇ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "चुँबन और अलिंगन लए ॥४॥",
      "sourceLineId": "132109",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਧਿਕ ਮਿਤ੍ਰ ਰਾਨੀ ਕਹ ਭਾਯੋ ॥",
      "transliteration": "adhik mitr raanee keh bhaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਮਿਤਰ ਰਾਣੀ ਨੂੰ ਬਹੁਤ ਚੰਗਾ ਲਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "अधिक मित्र रानी कह भायो ॥",
      "sourceLineId": "132110",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਤਾਹਿ ਪ੍ਰਬੋਧ ਜਨਾਯੋ ॥",
      "transliteration": "eeh bidh taeh prabodh janaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਤਰ੍ਰਹਾ ਨਾਲ ਉਸ ਨੂੰ ਸਮਝਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "इह बिधि ताहि प्रबोध जनायो ॥",
      "sourceLineId": "132111",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਹਾ ਉਜਾਰਿ ਜਹਾ ਬਡ ਅਹੀ ॥",
      "transliteration": "kahaa ujaar jahaa badd ahee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਹਾ ਕਿ ਜਿਥੇ ਵੱਡੀ ਉਜਾੜ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "कहा उजारि जहा बड अही ॥",
      "sourceLineId": "132112",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਆਸਨ ਲਾਇ ਬੈਠਿਯੋ ਤਹੀ ॥੫॥",
      "transliteration": "aasan lai baiThiyo tahee ||5||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਆਸਣ ਲਗਾ ਕੇ ਬੈਠ ਜਾਓ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "आसन लाइ बैठियो तही ॥५॥",
      "sourceLineId": "132113",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਭ ਹੀ ਅੰਗ ਬਿਭੂਤਿ ਚੜੈਯਹੁ ॥",
      "transliteration": "sabh hee a(n)g bibhoot chaRaiyahu ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਸ਼ਰੀਰ ਉਤੇ ਵਿਭੂਤੀ (ਸੁਆਹ) ਮਲ ਲਵੋ",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "सभ ही अंग बिभूति चड़ैयहु ॥",
      "sourceLineId": "132114",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦ੍ਰੁਮ ਤਰ ਬੈਠੇ ਧ੍ਯਾਨ ਲਗੈਯਹੁ ॥",
      "transliteration": "dhrum tar baiThe dhayaan lagaiyahu ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬ੍ਰਿਛ ਹੇਠਾ ਬੈਠ ਕੇ ਧਿਆਨ ਲਗਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "द्रुम तर बैठे ध्यान लगैयहु ॥",
      "sourceLineId": "132115",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰਾਜਾ ਸਹਿਤ ਤਹਾ ਹਮ ਐਹੈਂ ॥",
      "transliteration": "raajaa sahit tahaa ham aaihai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਸਮੇਤ ਮੈਂ ਉਥੇ ਆਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "राजा सहित तहा हम ऐहैं ॥",
      "sourceLineId": "132116",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤੁਮੈ ਧਾਮ ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਲੈ ਜੈਹੈਂ ॥੬॥",
      "transliteration": "tumai dhaam jayo(n) tayo(n) lai jaihai(n) ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੈਨੂੰ ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਘਰ ਲੈ ਜਾਵਾਗੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "तुमै धाम ज्यों त्यों लै जैहैं ॥६॥",
      "sourceLineId": "132117",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮਾਨਿ ਜਾਰ ਸੋਈ ਬਚ ਲਯੋ ॥",
      "transliteration": "maan jaar soiee bach layo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਦੀ) ਉਸ ਗੱਲ ਨੂੰ ਯਾਰ ਨੇ ਮੰਨ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "मानि जार सोई बच लयो ॥",
      "sourceLineId": "132118",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭੇਖ ਅਤਿਥ ਕੋ ਧਾਰਤ ਭਯੋ ॥",
      "transliteration": "bhekh atith ko dhaarat bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਧ ਦਾ ਭੇਖ ਧਾਰਨ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "भेख अतिथ को धारत भयो ॥",
      "sourceLineId": "132119",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਸਨ ਏਕ ਬ੍ਰਿਛ ਤਰ ਮਾਰਾ ॥",
      "transliteration": "aasan ek birachh tar maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਬ੍ਰਿਛ ਹੇਠਾ ਆਸਣ ਲਗਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "आसन एक बृछ तर मारा ॥",
      "sourceLineId": "132120",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਯੌ ਰਾਜਾ ਸੌ ਨਾਰਿ ਉਚਾਰਾ ॥੭॥",
      "transliteration": "yau raajaa sau naar uchaaraa ||7||",
      "translation": "",
      "punjabiViakhya": "(ਉਧਰ) ਰਾਜੇ ਪ੍ਰਤਿ ਰਾਣੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "यौ राजा सौ नारि उचारा ॥७॥",
      "sourceLineId": "132121",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੋਵਤ ਹੁਤੀ ਸੁਪਨ ਮੈ ਪਾਯੋ ॥",
      "transliteration": "sovat hutee supan mai paayo ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੱਤੇ ਹੋਇਆਂ ਮੈਨੂੰ ਇਕ ਸੁਪਨਾ ਆਇਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "सोवत हुती सुपन मै पायो ॥",
      "sourceLineId": "132122",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮਹਾ ਰੁਦ੍ਰ ਮੇਰੇ ਗ੍ਰਿਹ ਆਯੋ ॥",
      "transliteration": "mahaa rudhr mere gireh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮਹਾ ਰੁਦ੍ਰ ਮੇਰੇ ਘਰ ਆਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "महा रुद्र मेरे गृह आयो ॥",
      "sourceLineId": "132123",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪਾਵ ਸਾਥ ਤਿਨ ਮੋਹਿ ਜਗਾਯੋ ॥",
      "transliteration": "paav saath tin moh jagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਪੈਰ ਨਾਲ ਮੈਨੂੰ ਜਗਾਇਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "पाव साथ तिन मोहि जगायो ॥",
      "sourceLineId": "132124",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਧਿਕ ਕ੍ਰਿਪਾ ਕਰਿ ਬਚਨ ਸੁਨਾਯੋ ॥੮॥",
      "transliteration": "adhik kirapaa kar bachan sunaayo ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਕ੍ਰਿਪਾ ਕਰ ਕੇ ਬਚਨ ਕਿਹਾ ਹੈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "अधिक कृपा करि बचन सुनायो ॥८॥",
      "sourceLineId": "132125",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤੁਮ ਰਾਜਾ ਜੂ ਸਾਥ ਉਚਰਿਯਹੁ ॥",
      "transliteration": "tum raajaa joo saath uchariyahu ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਾ ਜੀ! (ਮੈਂ) ਤੁਹਾਨੂੰ ਕਹਿੰਦੀ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "तुम राजा जू साथ उचरियहु ॥",
      "sourceLineId": "132126",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਏਕ ਬਾਤ ਚਿਤ ਭੀਤਰਿ ਧਰਿਯਹੁ ॥",
      "transliteration": "ek baat chit bheetar dhariyahu ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੁਸੀਂ ਇਕ ਗੱਲ ਮਨ ਵਿਚ ਰਖ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "एक बात चित भीतरि धरियहु ॥",
      "sourceLineId": "132127",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਏਕ ਰਖੀਸੁਰ ਬਨ ਮਹਿ ਸੁਨਾ ॥",
      "transliteration": "ek rakheesur ban meh sunaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਰਿਖੀਸੁਰ ਬਨ ਵਿਚ (ਆਇਆ) ਸੁਣਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "एक रखीसुर बन महि सुना ॥",
      "sourceLineId": "132128",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਾ ਸਮ ਭਯੋ ਨ ਹੈ ਕਹੂੰ ਮੁਨਾ ॥੯॥",
      "transliteration": "taa sam bhayo na hai kahoo(n) munaa ||9||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗਾ ਕੋਈ ਮੁਨੀ ਨਹੀਂ ਹੋਇਆ ਹੈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "ता सम भयो न है कहूँ मुना ॥९॥",
      "sourceLineId": "132129",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1233_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਾਜਾ ਸਹਿਤ ਜਾਇ ਤਿਹ ਲ੍ਰਯੈਯਹੁ ॥",
      "transliteration": "raajaa sahit jai teh lrayaiyahu ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਸਮੇਤ ਉਥੇ ਜਾਓ (ਅਤੇ ਉਸ ਨੂੰ) ਲੈ ਆਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1233,
      "hindi": "",
      "hindiTransliteration": "राजा सहित जाइ तिह ल्रयैयहु ॥",
      "sourceLineId": "132130",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
