{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1234,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1234_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦ੍ਵਾਦਸ ਬਰਖ ਸੰਗ ਲੈ ਸ੍ਵੈਯਹੁ ॥",
      "transliteration": "dhavaiaadhas barakh sa(n)g lai savaiyahu ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਰ੍ਰਹਾ ਸਾਲ (ਉਸ ਨੂੰ) ਨਾਲ ਲੈ ਕੇ ਸਵੋਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "द्वादस बरख संग लै स्वैयहु ॥",
      "sourceLineId": "132131",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਿਹਸੰਸੈ ਘਰ ਮੈ ਸੁਤ ਹੋਈ ॥",
      "transliteration": "nihasa(n)sai ghar mai sut hoiee ||",
      "translation": "",
      "punjabiViakhya": "ਨਿਰਸੰਦੇਹ ਘਰ ਵਿਚ ਪੁੱਤਰ (ਦਾ ਜਨਮ) ਹੋਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "निहसंसै घर मै सुत होई ॥",
      "sourceLineId": "132132",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਯਾ ਮੈ ਬਾਤ ਨ ਦੂਜੀ ਕੋਈ ॥੧੦॥",
      "transliteration": "yaa mai baat na dhoojee koiee ||10||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਵਿਚ ਕੋਈ ਹੋਰ ਗੱਲ (ਅਥਵਾ ਭਾਵ) ਨਹੀਂ ਹੈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "या मै बात न दूजी कोई ॥१०॥",
      "sourceLineId": "132133",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਹਾ ਜਤੀ ਤਿਹ ਮੁਨਿ ਕੋ ਜਾਨਹੁ ॥",
      "transliteration": "mahaa jatee teh mun ko jaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮੁਨੀ ਨੂੰ ਮਹਾਨ ਜਤੀ ਸਮਝੋ",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "महा जती तिह मुनि को जानहु ॥",
      "sourceLineId": "132134",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਹੂੰ ਨ ਬਿਨਸਾ ਤਾਹਿ ਪਛਾਨਹੁ ॥",
      "transliteration": "kahoo(n) na binasaa taeh pachhaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਕਦੇ ਵੀ ਨਾਸ਼ਮਾਨ ('ਬਿਨਸਾ') ਨਾ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "कहूँ न बिनसा ताहि पछानहु ॥",
      "sourceLineId": "132135",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰੰਭਾਦਿਕ ਇਸਤ੍ਰੀ ਪਚਿ ਹਾਰੀ ॥",
      "transliteration": "ra(n)bhaadhik isatree pach haaree ||",
      "translation": "",
      "punjabiViakhya": "ਰੰਭਾ ਵਰਗੀਆਂ ਇਸਤਰੀਆਂ (ਅਪੱਛਰਾਵਾ) ਖਪ ਗਈਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "रंभादिक इसत्री पचि हारी ॥",
      "sourceLineId": "132136",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬ੍ਰਤ ਤੇ ਟਰਾ ਨ ਰਿਖਿ ਬ੍ਰਤ ਧਾਰੀ ॥੧੧॥",
      "transliteration": "brat te Taraa na rikh brat dhaaree ||11||",
      "translation": "",
      "punjabiViakhya": "ਪਰ (ਉਹ) ਬ੍ਰਤਧਾਰੀ ਰਿਖੀ ਆਪਣੇ ਬ੍ਰਤ ਤੋਂ ਟਲਿਆ ਨਹੀਂ ਹੈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "ब्रत ते टरा न रिखि ब्रत धारी ॥११॥",
      "sourceLineId": "132137",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹਮ ਤੁਮ ਸਾਥ ਤਹਾ ਦੋਊ ਜਾਵੈਂ ॥",
      "transliteration": "ham tum saath tahaa dhouoo jaavai(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਲਈ) ਤੁਸੀਂ ਤੇ ਮੈਂ ਦੋਵੇਾਂ ਇਕੱਠੇ ਉਥੇ ਜਾਈਏ",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "हम तुम साथ तहा दोऊ जावैं ॥",
      "sourceLineId": "132138",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਮੁਨਹਿ ਪਾਇ ਪਰ ਲ੍ਯਾਵੈਂ ॥",
      "transliteration": "jayo(n) tayo(n) muneh pai par layaavai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਪੈਰੀਂ ਪੈ ਕੇ ਮੁਨੀ ਨੂੰ (ਘਰ) ਲਿਆਈਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "ज्यों त्यों मुनहि पाइ पर ल्यावैं ॥",
      "sourceLineId": "132139",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਾਰਹ ਬਰਿਸ ਮੋਰਿ ਸੰਗ ਸ੍ਵਾਵਹੁ ॥",
      "transliteration": "baareh baris mor sa(n)g savaiaavahu ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਬਾਰ੍ਰਹਾ ਸਾਲ ਮੇਰੇ ਨਾਲ ਸੌਣ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "बारह बरिस मोरि संग स्वावहु ॥",
      "sourceLineId": "132140",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਿਹਸੰਸੈ ਘਰ ਮੈ ਸੁਤ ਪਾਵਹੁ ॥੧੨॥",
      "transliteration": "nihasa(n)sai ghar mai sut paavahu ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਿਨਾ ਕਿਸੇ ਸੰਸੇ ਦੇ ਘਰ ਵਿਚ ਪੁੱਤਰ ਪ੍ਰਾਪਤ ਕਰੋ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "निहसंसै घर मै सुत पावहु ॥१२॥",
      "sourceLineId": "132141",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੁਨਿ ਬਚ ਨ੍ਰਿਪ ਉਠਿ ਠਾਢੋ ਭਯੋ ॥",
      "transliteration": "sun bach nirap uTh Thaaddo bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਬਚਨ ਸੁਣ ਕੇ ਰਾਜਾ ਉਠ ਖੜੋਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "सुनि बच नृप उठि ठाढो भयो ॥",
      "sourceLineId": "132142",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਾਨੀ ਸਹਿਤ ਤਵਨ ਬਨ ਗਯੋ ॥",
      "transliteration": "raanee sahit tavan ban gayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਸਮੇਤ ਉਸ ਬਨ ਵਿਚ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "रानी सहित तवन बन गयो ॥",
      "sourceLineId": "132143",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਹ ਛ੍ਵੈ ਬ੍ਰਿਛ ਗਗਨ ਤਨ ਰਹੇ ॥",
      "transliteration": "jeh chhavai birachh gagan tan rahe ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਬ੍ਰਿਛ ਆਕਾਸ਼ ਨੂੰ ਛੋਹ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "जह छ्वै बृछ गगन तन रहे ॥",
      "sourceLineId": "132144",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਘੋਰ ਭਯਾਨਕ ਜਾਤ ਨ ਕਹੇ ॥੧੩॥",
      "transliteration": "ghor bhayaanak jaat na kahe ||13||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਬਨ) ਬਹੁਤ ਭਿਆਨਕ ਸੀ (ਜਿਸ ਦਾ) ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "घोर भयानक जात न कहे ॥१३॥",
      "sourceLineId": "132145",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰਾਨੀ ਸਹਿਤ ਰਾਵ ਤਹ ਗਯੋ ॥",
      "transliteration": "raanee sahit raav teh gayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਸਮੇਤ ਰਾਜਾ ਉਥੇ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "रानी सहित राव तह गयो ॥",
      "sourceLineId": "132146",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹੇਰਤ ਤਵਨ ਮੁਨੀਸਹਿ ਭਯੋ ॥",
      "transliteration": "herat tavan muneeseh bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਜਾ ਕੇ) ਉਸ ਮੁਨੀ ਨੂੰ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "हेरत तवन मुनीसहि भयो ॥",
      "sourceLineId": "132147",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਰਿ ਸਹਿਤ ਪਾਇਨ ਤਿਹ ਪਰਿਯੋ ॥",
      "transliteration": "naar sahit pain teh pariyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਸਮੇਤ ਉਸ ਦੇ ਪੈਰੀਂ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "नारि सहित पाइन तिह परियो ॥",
      "sourceLineId": "132148",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚਿਤ ਮੈ ਇਹੈ ਬਿਚਾਰ ਬਿਚਾਰਿਯੋ ॥੧੪॥",
      "transliteration": "chit mai ihai bichaar bichaariyo ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਿਤ ਵਿਚ ਇਹ ਵਿਚਾਰ ਬਣਾ ਲਿਆ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "चित मै इहै बिचार बिचारियो ॥१४॥",
      "sourceLineId": "132149",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੋ ਸਿਵ ਸੁਪਨ ਸਮੈ ਕਹਿ ਗਯੋ ॥",
      "transliteration": "jo siv supan samai keh gayo ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸ਼ਿਵ ਸੁਪਨੇ ਵਿਚ ਕਹਿ ਗਿਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "जो सिव सुपन समै कहि गयो ॥",
      "sourceLineId": "132150",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੋ ਹਮ ਸਾਚੁ ਦ੍ਰਿਗਨ ਲਹਿ ਲਯੋ ॥",
      "transliteration": "so ham saach dhiragan leh layo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮੈਂ ਸਚਮੁਚ ਅੱਖਾ ਨਾਲ ਵੇਖ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "सो हम साचु दृगन लहि लयो ॥",
      "sourceLineId": "132151",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਕਰਿ ਇਹ ਗ੍ਰਿਹ ਲੈ ਜਾਊਾਂ ॥",
      "transliteration": "jayo(n) tayo(n) kar ieh gireh lai jaauooaa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਕਰ ਕੇ ਇਸ ਨੂੰ ਘਰ ਲੈ ਜਾਵਾ",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "ज्यों त्यों करि इह गृह लै जाऊाँ ॥",
      "sourceLineId": "132152",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਲੈ ਰਾਨੀ ਕੇ ਸਾਥ ਸੁਵਾਊਾਂ ॥੧੫॥",
      "transliteration": "lai raanee ke saath suvaauooaa(n) ||15||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲੈ ਕੇ ਰਾਣੀ ਦੇ ਨਾਲ ਸਵਾਵਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "लै रानी के साथ सुवाऊाँ ॥१५॥",
      "sourceLineId": "132153",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜ੍ਯੋਂ ਜ੍ਯੋਂ ਨ੍ਰਿਪ ਪਾਇਨ ਪਰ ਪਰੈ ॥",
      "transliteration": "jayo(n) jayo(n) nirap pain par parai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਉਾਂ ਜਿਉਾਂ ਰਾਜਾ ਉਸ ਦੇ ਪੈਰੀਂ ਪੈਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "ज्यों ज्यों नृप पाइन पर परै ॥",
      "sourceLineId": "132154",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤ੍ਯੋਂ ਤ੍ਯੋਂ ਮੁਨਿ ਆਂਖੈ ਨ ਉਘਰੈ ॥",
      "transliteration": "tayo(n) tayo(n) mun aa(n)khai na ugharai ||",
      "translation": "",
      "punjabiViakhya": "ਤਿਉਾਂ ਤਿਉਾਂ ਮੁਨੀ ਅੱਖਾ ਨਹੀਂ ਉਘਾੜਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "त्यों त्यों मुनि आँखै न उघरै ॥",
      "sourceLineId": "132155",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤ੍ਯੋਂ ਰਾਜਾ ਸੀਸਹਿ ਨਿਹੁਰਾਵੈ ॥",
      "transliteration": "tayo(n) raajaa seeseh nihuraavai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਸਿਰ ਨੂੰ ਨਿਵਾਉਾਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "त्यों राजा सीसहि निहुरावै ॥",
      "sourceLineId": "132156",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਾ ਕਹ ਮਹਾ ਮੁਨੀ ਠਹਰਾਵੈ ॥੧੬॥",
      "transliteration": "taa keh mahaa munee Thaharaavai ||16||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਮਹਾ ਮੁਨੀ ਸਮਝਦਾ ਸੀ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "ता कह महा मुनी ठहरावै ॥१६॥",
      "sourceLineId": "132157",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਬ ਨ੍ਰਿਪ ਅਨਿਕ ਬਾਰ ਪਗ ਪਰਾ ॥",
      "transliteration": "jab nirap anik baar pag paraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜਾ ਅਨੇਕ ਵਾਰ ਪੈਰੀਂ ਪਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "जब नृप अनिक बार पग परा ॥",
      "sourceLineId": "132158",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਬ ਆਂਖੈ ਮੁਨਿ ਦੁਹੂੰ ਉਘਰਾ ॥",
      "transliteration": "tab aa(n)khai mun dhuhoo(n) ugharaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਮੁਨੀ ਨੇ ਦੋਵੇਾਂ ਅੱਖਾ ਉਘਾੜੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "तब आँखै मुनि दुहूँ उघरा ॥",
      "sourceLineId": "132159",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਾ ਸੌ ਕਹਾ ਕਿਹ ਨਮਿਤਿ ਆਯੋ ॥",
      "transliteration": "taa sau kahaa keh namit aayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਕਿਹਾ ਕਿ ਕਿਸ (ਕੰਮ) ਲਈ ਆਏ ਹੋ",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "ता सौ कहा किह नमिति आयो ॥",
      "sourceLineId": "132160",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਿਹ ਕਾਰਨ ਇਸਤ੍ਰੀ ਸੰਗ ਲ੍ਯਾਯੋ ॥੧੭॥",
      "transliteration": "keh kaaran isatree sa(n)g layaayo ||17||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਸ ਕਾਰਨ ਇਸਤਰੀ ਨੂੰ ਨਾਲ ਲਿਆਏ ਹੋ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "किह कारन इसत्री संग ल्यायो ॥१७॥",
      "sourceLineId": "132161",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਹਮ ਹੈ ਮੁਨਿ ਕਾਨਨ ਕੇ ਬਾਸੀ ॥",
      "transliteration": "ham hai mun kaanan ke baasee ||",
      "translation": "",
      "punjabiViakhya": "ਅਸੀਂ ਮੁਨੀ ਲੋਗ ਜੰਗਲ ਦੇ ਵਾਸੀ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "हम है मुनि कानन के बासी ॥",
      "sourceLineId": "132162",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਏਕ ਨਾਮ ਜਾਨਤ ਅਬਿਨਾਸੀ ॥",
      "transliteration": "ek naam jaanat abinaasee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਅਬਿਨਾਸ਼ੀ ਦਾ ਹੀ ਨਾਮ ਜਾਣਦੇ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "एक नाम जानत अबिनासी ॥",
      "sourceLineId": "132163",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰਾਜਾ ਪ੍ਰਜਾ ਬਸਤ ਕਿਹ ਠੌਰਾ ॥",
      "transliteration": "raajaa prajaa basat keh Thauaraa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਅਤੇ ਪ੍ਰਜਾ ਕਿਥੇ ਵਸਦੇ ਹਨ (ਅਸੀਂ ਨਹੀਂ ਜਾਣਦੇ)।",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "राजा प्रजा बसत किह ठौरा ॥",
      "sourceLineId": "132164",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਮ ਪ੍ਰਭ ਕੇ ਰਾਚੇ ਰਸ ਬੌਰਾ ॥੧੮॥",
      "transliteration": "ham prabh ke raache ras bauaraa ||18||",
      "translation": "",
      "punjabiViakhya": "ਅਸੀਂ ਤਾ ਪ੍ਰਭੂ ਦੇ ਰਸ ਵਿਚ ਮਗਨ ਬੌਰਾਏ ਹੋਏ ਹਾ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "हम प्रभ के राचे रस बौरा ॥१८॥",
      "sourceLineId": "132165",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਯਹ ਸੰਪਤਿ ਹਮਰੇ ਕਿਹ ਕਾਜਾ ॥",
      "transliteration": "yeh sa(n)pat hamare keh kaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਇਹ ਸੰਪੱਤੀ ਸਾਡੇ ਕਿਸ ਕੰਮ ਦੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "यह संपति हमरे किह काजा ॥",
      "sourceLineId": "132166",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜੋ ਲੈ ਹਮੈ ਦਿਖਾਵਤ ਰਾਜਾ ॥",
      "transliteration": "jo lai hamai dhikhaavat raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ (ਤੁਸੀਂ) ਸਾਨੂੰ ਵਿਖਾਉਾਂਦੇ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "जो लै हमै दिखावत राजा ॥",
      "sourceLineId": "132167",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹਮ ਨਹਿ ਧਾਮ ਕਿਸੂ ਕੇ ਜਾਹੀ ॥",
      "transliteration": "ham neh dhaam kisoo ke jaahee ||",
      "translation": "",
      "punjabiViakhya": "ਅਸੀਂ ਕਿਸੇ ਦੇ ਘਰ ਨਹੀਂ ਜਾਦੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "हम नहि धाम किसू के जाही ॥",
      "sourceLineId": "132168",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਨ ਹੀ ਮਹਿ ਹਰਿ ਧ੍ਯਾਨ ਲਗਾਹੀ ॥੧੯॥",
      "transliteration": "ban hee meh har dhayaan lagaahee ||19||",
      "translation": "",
      "punjabiViakhya": "(ਬਸ) ਬਨ ਵਿਚ ਹੀ ਹਰਿ ਵਿਚ ਧਿਆਨ ਲਗਾਉਾਂਦੇ ਹਾ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "बन ही महि हरि ध्यान लगाही ॥१९॥",
      "sourceLineId": "132169",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਕਰਹੁ ਨ੍ਰਿਪ ਧਾਮ ਪਧਾਰੋ ॥",
      "transliteration": "kirapaa karahu nirap dhaam padhaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਉੱਤਰ ਵਿਚ ਰਾਜਾ ਮੁਨੀ ਨੂੰ ਕਹਿਣ ਲਗਿਆ)",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "कृपा करहु नृप धाम पधारो ॥",
      "sourceLineId": "132170",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਮਰੇ ਬਡੇ ਅਘਨ ਕਹ ਟਾਰੋ ॥",
      "transliteration": "hamare badde aghan keh Taaro ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰਿਪਾ ਕਰ ਕੇ ਰਾਜੇ ਦੇ ਘਰ ਚਲੋ ਅਤੇ ਸਾਡੇ ਵੱਡੇ ਪਾਪਾ ਨੂੰ ਦੂਰ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "हमरे बडे अघन कह टारो ॥",
      "sourceLineId": "132171",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਾਰਹ ਬਰਿਸ ਕ੍ਰਿਪਾ ਕਰਿ ਰਹਿਯੈ ॥",
      "transliteration": "baareh baris kirapaa kar rahiyai ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਰ੍ਰਹਾ ਸਾਲ ਕ੍ਰਿਪਾ ਕਰ ਕੇ ਰਹਿਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "बारह बरिस कृपा करि रहियै ॥",
      "sourceLineId": "132172",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਹੁਰੋ ਮਗ ਬਨ ਹੀ ਕੋ ਗਹਿਯੈ ॥੨੦॥",
      "transliteration": "bahuro mag ban hee ko gahiyai ||20||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਬਨ ਦਾ ਹੀ ਰਸਤਾ ਫੜ ਲੈਣਾ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "बहुरो मग बन ही को गहियै ॥२०॥",
      "sourceLineId": "132173",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਬ ਨ੍ਰਿਪ ਅਧਿਕ ਨਿਹੋਰਾ ਕਿਯੋ ॥",
      "transliteration": "jab nirap adhik nihoraa kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਬਹੁਤ ਤਰਲਾ ਕੀਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "जब नृप अधिक निहोरा कियो ॥",
      "sourceLineId": "132174",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਬ ਇਹ ਬਿਧਿ ਉਤਰਿ ਰਿਖਿ ਦਿਯੋ ॥",
      "transliteration": "tab ieh bidh utar rikh dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਿਖੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਉੱਤਰ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "तब इह बिधि उतरि रिखि दियो ॥",
      "sourceLineId": "132175",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਮਰੋ ਕਹਾ ਧਾਮ ਤਵ ਕਾਜਾ ॥",
      "transliteration": "hamaro kahaa dhaam tav kaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਡਾ ਤੇਰੇ ਘਰ ਕੀ ਕੰਮ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "हमरो कहा धाम तव काजा ॥",
      "sourceLineId": "132176",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਾਰ ਬਾਰ ਪਕਰਤ ਪਗ ਰਾਜਾ ॥੨੧॥",
      "transliteration": "baar baar pakarat pag raajaa ||21||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! (ਤੂੰ) ਬਾਰ ਬਾਰ (ਕਿਉਾਂ) ਪੈਰ ਪਕੜਦਾ ਹੈਂ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "बार बार पकरत पग राजा ॥२१॥",
      "sourceLineId": "132177",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1234_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਹਮ ਕਹ ਸਿਵ ਤੁਹਿ ਆਪੁ ਬਤਾਯੋ ॥",
      "transliteration": "ham keh siv tuh aap bataayo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ ਉੱਤਰ ਦਿੱਤਾ) ਤੁਹਾਡੇ ਬਾਰੇ ਸ਼ਿਵ ਨੇ ਸਾਨੂੰ ਖ਼ੁਦ ਦਸਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1234,
      "hindi": "",
      "hindiTransliteration": "हम कह सिव तुहि आपु बतायो ॥",
      "sourceLineId": "132178",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
