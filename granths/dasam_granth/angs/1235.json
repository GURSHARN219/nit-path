{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1235,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1235_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੋਵਤ ਇਹਾ ਜਗਾਇ ਪਠਾਯੋ ॥",
      "transliteration": "sovat ihaa jagai paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਤੇ ਹੋਇਆਂ ਨੂੰ ਜਗਾ ਕੇ ਇਥੇ ਭੇਜਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "सोवत इहा जगाइ पठायो ॥",
      "sourceLineId": "132179",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਾ ਤੇ ਮਾਨਿ ਸੰਭੁ ਕੋ ਕਹੋ ॥",
      "transliteration": "taa te maan sa(n)bh ko kaho ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਸ਼ਿਵ ਸ਼ੰਭੂ ਦਾ ਕਿਹਾ ਮੰਨ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "ता ते मानि संभु को कहो ॥",
      "sourceLineId": "132180",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਾਰਹ ਬਰਖ ਹਮਾਰੋ ਰਹੋ ॥੨੨॥",
      "transliteration": "baareh barakh hamaaro raho ||22||",
      "translation": "",
      "punjabiViakhya": "ਬਾਰ੍ਰਹਾ ਵਰ੍ਰਹੇ ਸਾਡੇ ਘਰ ਰਹੋ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "बारह बरख हमारो रहो ॥२२॥",
      "sourceLineId": "132181",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਿਵ ਕੀ ਸੁਨਤ ਭਯੋ ਜਬ ਬਾਨੀ ॥",
      "transliteration": "siv kee sunat bhayo jab baanee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸ਼ਿਵ-ਬਾਣੀ ਬਾਰੇ ਸੁਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "सिव की सुनत भयो जब बानी ॥",
      "sourceLineId": "132182",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਬ ਮੁਨਿ ਸਾਥ ਚਲਨ ਕੀ ਮਾਨੀ ॥",
      "transliteration": "tab mun saath chalan kee maanee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਮੁਨੀ ਨਾਲ ਚਲਣ ਦੀ ਗੱਲ ਮੰਨ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "तब मुनि साथ चलन की मानी ॥",
      "sourceLineId": "132183",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਾਜਾ ਕੇ ਹ੍ਵੈ ਸੰਗ ਸਿਧਾਰਾ ॥",
      "transliteration": "raajaa ke havai sa(n)g sidhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦੇ ਨਾਲ ਹੋ ਕੇ ਚਲ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "राजा के ह्वै संग सिधारा ॥",
      "sourceLineId": "132184",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਾਨੀ ਸਹਿਤ ਸਦਨ ਪਗ ਧਾਰਾ ॥੨੩॥",
      "transliteration": "raanee sahit sadhan pag dhaaraa ||23||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਸਮੇਤ ਮਹੱਲ ਵਿਚ ਪ੍ਰਵੇਸ਼ ਕੀਤਾ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "रानी सहित सदन पग धारा ॥२३॥",
      "sourceLineId": "132185",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਖਾਨ ਪਾਨ ਆਗੈ ਨ੍ਰਿਪ ਧਰਾ ॥",
      "transliteration": "khaan paan aagai nirap dharaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਖਾਣ ਪੀਣ (ਦੀਆਂ ਚੀਜ਼ਾ) ਅਗੇ ਧਰੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "खान पान आगै नृप धरा ॥",
      "sourceLineId": "132186",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਾਹਿ ਨਿਰਖਿ ਰਿਖਿ ਐਸ ਉਚਰਾ ॥",
      "transliteration": "taeh nirakh rikh aais ucharaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਵੇਖ ਕੇ ਰਿਖੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "ताहि निरखि रिखि ऐस उचरा ॥",
      "sourceLineId": "132187",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਹ ਭੋਜਨ ਹਮਰੇ ਕਿਹ ਕਾਜਾ ॥",
      "transliteration": "eeh bhojan hamare keh kaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਭੋਜਨ ਸਾਡੇ ਕਿਸ ਕੰਮ ਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "इह भोजन हमरे किह काजा ॥",
      "sourceLineId": "132188",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਏ ਹੈ ਇਨ ਗ੍ਰਿਹਸਤਨ ਕੇ ਸਾਜਾ ॥੨੪॥",
      "transliteration": "e hai in girahasatan ke saajaa ||24||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਤਾ ਗ੍ਰਿਹਸਥੀਆਂ (ਦੇ ਖਾਣ ਦੀ) ਸਾਮਗ੍ਰੀ ਹੈ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "ए है इन गृहसतन के साजा ॥२४॥",
      "sourceLineId": "132189",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਮ ਇਸਤ੍ਰਿਨ ਤਨ ਨੈਨ ਨ ਲਾਵਹਿ ॥",
      "transliteration": "ham isatiran tan nain na laaveh ||",
      "translation": "",
      "punjabiViakhya": "ਅਸੀਂ ਇਸਤਰੀਆਂ ਵਲ ਨਹੀਂ ਵੇਖਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "हम इसतृन तन नैन न लावहि ॥",
      "sourceLineId": "132190",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਇਨ ਰਸ ਕਸਨ ਭੂਲ ਨਹਿ ਖਾਵਹਿ ॥",
      "transliteration": "ein ras kasan bhool neh khaaveh ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਨ੍ਰਹਾ ਰਸਾ ਕਸਾ ਨੂੰ ਭੁਲ ਕੇ ਵੀ ਨਹੀਂ ਖਾਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "इन रस कसन भूल नहि खावहि ॥",
      "sourceLineId": "132191",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਿਨ ਹਰਿ ਨਾਮ ਕਾਮ ਨਹਿ ਆਵੈ ॥",
      "transliteration": "bin har naam kaam neh aavai ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਮਾਤਮਾ ਦੇ ਨਾਮ ਤੋਂ ਬਿਨਾ (ਕੋਈ ਚੀਜ਼ ਵੀ) ਕੰਮ ਨਹੀਂ ਆਉਾਂਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "बिन हरि नाम काम नहि आवै ॥",
      "sourceLineId": "132192",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬੇਦ ਕਤੇਬ ਯੌ ਭੇਦ ਬਤਾਵੈ ॥੨੫॥",
      "transliteration": "bedh kateb yau bhedh bataavai ||25||",
      "translation": "",
      "punjabiViakhya": "ਬੇਦ ਕਤੇਬ ਇਹੀ ਭੇਦ ਦੀ ਗੱਲ ਦਸਦੇ ਹਨ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "बेद कतेब यौ भेद बतावै ॥२५॥",
      "sourceLineId": "132193",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਬ ਨ੍ਰਿਪ ਤਾਹਿ ਸਹੀ ਮੁਨਿ ਮਾਨਾ ॥",
      "transliteration": "tab nirap taeh sahee mun maanaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜੇ ਨੇ ਉਸ ਨੂੰ ਸਹੀ ਮੁਨੀ ਮੰਨਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "तब नृप ताहि सही मुनि माना ॥",
      "sourceLineId": "132194",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਮੂੜ ਪਛਾਨਾ ॥",
      "transliteration": "bhedh abhedh na mooR pachhaanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਮੂਰਖ ਨੇ ਭੇਦ ਅਭੇਦ ਕੁਝ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न मूड़ पछाना ॥",
      "sourceLineId": "132195",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਿਜੁ ਰਾਨੀ ਤਨ ਤਾਹਿ ਸੁਵਾਯੋ ॥",
      "transliteration": "nij raanee tan taeh suvaayo ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੀ ਰਾਣੀ ਨੂੰ ਉਸ ਨਾਲ ਸਵਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "निजु रानी तन ताहि सुवायो ॥",
      "sourceLineId": "132196",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮੂਰਖ ਅਪਨੋ ਮੂੰਡ ਮੁਡਾਯੋ ॥੨੬॥",
      "transliteration": "moorakh apano moo(n)dd muddaayo ||26||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਮੂਰਖ ਨੇ ਆਪਣਾ ਸਿਰ ਮੁੰਨਵਾਇਆ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "मूरख अपनो मूँड मुडायो ॥२६॥",
      "sourceLineId": "132197",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਿਜੁ ਕਰ ਮੂਰਖ ਸੇਜ ਬਿਛਾਵੈ ॥",
      "transliteration": "nij kar moorakh sej bichhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਰਾਜਾ ਆਪਣੇ ਹੱਥਾ ਨਾਲ ਸੇਜ ਵਿਛਾਉਾਂਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "निजु कर मूरख सेज बिछावै ॥",
      "sourceLineId": "132198",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਾਹਿ ਤ੍ਰਿਯਾ ਕੇ ਸਾਥ ਸੁਵਾਵੈ ॥",
      "transliteration": "taeh tirayaa ke saath suvaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਫਿਰ) ਉਸ ਨੂੰ ਇਸਤਰੀ ਦੇ ਨਾਲ ਸਵਾਉਾਂਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "ताहि तृया के साथ सुवावै ॥",
      "sourceLineId": "132199",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਧਿਕ ਜਤੀ ਤਾ ਕਹ ਪਹਿਚਾਨੈ ॥",
      "transliteration": "adhik jatee taa keh pahichaanai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਬਹੁਤ ਵੱਡਾ ਜਤੀ ਸਮਝਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "अधिक जती ता कह पहिचानै ॥",
      "sourceLineId": "132200",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਮੂਰਖ ਜਾਨੈ ॥੨੭॥",
      "transliteration": "bhedh abhedh na moorakh jaanai ||27||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਮੂਰਖ ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਾ ਸਮਝਦਾ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न मूरख जानै ॥२७॥",
      "sourceLineId": "132201",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਬ ਪਤਿ ਨਹਿ ਹੇਰਤ ਤ੍ਰਿਯ ਜਾਨੈ ॥",
      "transliteration": "jab pat neh herat tiray jaanai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਇਸਤਰੀ ਸਮਝਦੀ ਕਿ ਪਤੀ ਨਹੀਂ ਵੇਖ ਰਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "जब पति नहि हेरत तृय जानै ॥",
      "sourceLineId": "132202",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਾ ਸੋ ਦ੍ਰਿੜ ਠਾਨੈ ॥",
      "transliteration": "kaam bhog taa so dhiraR Thaanai ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਨਾਲ ਖ਼ੂਬ ਭੋਗ ਵਿਲਾਸ ਕਰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "काम भोग ता सो दृड़ ठानै ॥",
      "sourceLineId": "132203",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭਾਗ ਅਫੀਮ ਅਧਿਕ ਤਿਹ ਖ੍ਵਾਰੀ ॥",
      "transliteration": "bhaag afeem adhik teh khavaiaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਬਹੁਤ ਸਾਰੀ ਭੰਗ ਅਤੇ ਅਫ਼ੀਮ ਖੁਆਉਾਂਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "भाग अफीम अधिक तिह ख्वारी ॥",
      "sourceLineId": "132204",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚਾਰਿ ਪਹਰ ਰਤਿ ਕਰੀ ਪ੍ਯਾਰੀ ॥੨੮॥",
      "transliteration": "chaar pahar rat karee payaaree ||28||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਪਿਆਰੀ (ਇਸਤਰੀ) ਚਾਰ ਪਹਿਰ ਤਕ ਰਤੀ-ਕ੍ਰੀੜਾ ਕਰਦੀ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "चारि पहर रति करी प्यारी ॥२८॥",
      "sourceLineId": "132205",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭੋਗ ਕਰਤ ਇਕ ਕ੍ਰਿਯਾ ਬਿਚਾਰੀ ॥",
      "transliteration": "bhog karat ik kirayaa bichaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਇਸਤਰੀ ਨੇ) ਭੋਗ ਕਰਦਿਆਂ ਇਕ ਕੰਮ ਸੋਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "भोग करत इक कृया बिचारी ॥",
      "sourceLineId": "132206",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਊਪਰ ਏਕ ਤੁਲਾਈ ਡਾਰੀ ॥",
      "transliteration": "uoopar ek tulaiee ddaaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਆਪਣੇ) ਉਪਰ ਇਕ ਤੁਲਾਈ ਪਾ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "ऊपर एक तुलाई डारी ॥",
      "sourceLineId": "132207",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨ੍ਰਿਪ ਬੈਠੋ ਮੂਕਿਯੈ ਲਗਾਵੈ ॥",
      "transliteration": "nirap baiTho mookiyai lagaavai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਬੈਠਾ ਮੁਕੀਆਂ ਮਾਰਦਾ (ਭਾਵ ਮੁਠੀ ਚਾਪੀ ਕਰਦਾ)",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "नृप बैठो मूकियै लगावै ॥",
      "sourceLineId": "132208",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੋ ਅੰਤਰ ਰਾਨਿਯਹਿ ਬਜਾਵੈ ॥੨੯॥",
      "transliteration": "so a(n)tar raaniyeh bajaavai ||29||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਹ (ਮੁਨੀ ਤੁਲਾਈ ਦੇ) ਅੰਦਰ ਰਾਣੀ ਨਾਲ ਭੋਗ ਕਰਦਾ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "सो अंतर रानियहि बजावै ॥२९॥",
      "sourceLineId": "132209",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਇਹ ਛਲ ਸੌ ਮਿਤ੍ਰਹਿ ਤਿਨ ਪਾਵਾ ॥",
      "transliteration": "eeh chhal sau mitreh tin paavaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਰਾਣੀ ਨੇ ਮਿਤਰ ਨੂੰ ਪ੍ਰਾਪਤ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "इह छल सौ मित्रहि तिन पावा ॥",
      "sourceLineId": "132210",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮੂਰਖ ਭੂਪ ਨ ਭੇਵ ਜਤਾਵਾ ॥",
      "transliteration": "moorakh bhoop na bhev jataavaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਰਾਜੇ ਨੂੰ ਭੇਦ ਨਾ ਪਾਣ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "मूरख भूप न भेव जतावा ॥",
      "sourceLineId": "132211",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪਾਵਦ ਬੈਠਿ ਮੂਕਿਯਨ ਮਾਰੈ ॥",
      "transliteration": "paavadh baiTh mookiyan maarai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ) ਪਵਾਦ ਵਲ ਬੈਠ ਕੇ ਮੁਕੀਆਂ ਮਾਰਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "पावद बैठि मूकियन मारै ॥",
      "sourceLineId": "132212",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਉਤ ਰਾਨੀ ਸੰਗ ਜਾਰ ਬਿਹਾਰੈ ॥੩੦॥",
      "transliteration": "aut raanee sa(n)g jaar bihaarai ||30||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਧਰ ਰਾਣੀ ਨਾਲ ਯਾਰ ਰਮਣ ਕਰਦਾ ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "उत रानी संग जार बिहारै ॥३०॥",
      "sourceLineId": "132213",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਹ ਛਲ ਸੌ ਰਾਨੀ ਪਤਿ ਛਰਿਯੋ ॥",
      "transliteration": "eeh chhal sau raanee pat chhariyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਰਾਣੀ ਨੇ ਪਤੀ ਨੂੰ ਛਲ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "इह छल सौ रानी पति छरियो ॥",
      "sourceLineId": "132214",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਾਰ ਗਵਨ ਤ੍ਰਿਯਿ ਦੇਖਤ ਕਰਿਯੋ ॥",
      "transliteration": "jaar gavan tiray dhekhat kariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਯਾਰ ਨੇ (ਰਾਜੇ ਦੇ) ਵੇਖਦਿਆਂ ਹੋਇਆਂ ਇਸਤਰੀ ਨਾਲ ਰਮਣ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "जार गवन तृयि देखत करियो ॥",
      "sourceLineId": "132215",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮੂਰਖਿ ਭੇਦ ਅਭੇਦ ਨ ਪਾਯੋ ॥",
      "transliteration": "moorakh bhedh abhedh na paayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ (ਰਾਜੇ) ਨੇ ਭੇਦ ਅਭੇਦ ਨਾ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "मूरखि भेद अभेद न पायो ॥",
      "sourceLineId": "132216",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੋ ਇਸਤ੍ਰੀ ਤੇ ਮੂੰਡ ਮੁਡਾਯੋ ॥੩੧॥",
      "transliteration": "so isatree te moo(n)dd muddaayo ||31||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਇਸਤਰੀ ਦੁਆਰਾ ਠਗਿਆ ਗਿਆ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "सो इसत्री ते मूँड मुडायो ॥३१॥",
      "sourceLineId": "132217",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਚੌਰਾਨਵੇ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੯੪॥੫੬੨੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau chauaraanave charitr samaapatam sat subham sat ||294||5620||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੯੪ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੯੪॥੫੬੨੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ चौरानवे चरित्र समापतम सतु सुभम सतु ॥२९४॥५६२०॥अफजूँ॥",
      "sourceLineId": "132218",
      "sourceShabadId": "12485",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "132219",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚੰਚਲ ਸੈਨ ਨ੍ਰਿਪਤਿ ਇਕ ਨਰਵਰ ॥",
      "transliteration": "cha(n)chal sain nirapat ik naravar ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਚਲ ਸੈਨ ਨਾ ਦਾ ਇਕ ਸ੍ਰੇਸ਼ਠ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "चंचल सैन नृपति इक नरवर ॥",
      "sourceLineId": "132220",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਵਰ ਨ੍ਰਿਪਤਿ ਤਾ ਕੀ ਨਹਿ ਸਰਬਰ ॥",
      "transliteration": "avar nirapat taa kee neh sarabar ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ ਕੋਈ ਰਾਜਾ ਉਸ ਦੇ ਬਰਾਬਰ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "अवर नृपति ता की नहि सरबर ॥",
      "sourceLineId": "132221",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੰਚਲ ਦੇ ਤਾ ਕੇ ਘਰ ਦਾਰਾ ॥",
      "transliteration": "cha(n)chal dhe taa ke ghar dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਚੰਚਲ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "चंचल दे ता के घर दारा ॥",
      "sourceLineId": "132222",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਾ ਸਮ ਦੇਵ ਨ ਦੇਵ ਕੁਮਾਰਾ ॥੧॥",
      "transliteration": "taa sam dhev na dhev kumaaraa ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਨਾ ਦੇਵ ਇਸਤਰੀ ਅਤੇ ਨਾ ਹੀ ਦੇਵ-ਕੁਮਾਰੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "ता सम देव न देव कुमारा ॥१॥",
      "sourceLineId": "132223",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੁੰਦਰਿਤਾ ਇਹ ਕਹੀ ਨ ਆਵੈ ॥",
      "transliteration": "su(n)dharitaa ieh kahee na aavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਦੀ ਸੁੰਦਰਤਾ ਦਾ ਬਖਾਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "सुँदरिता इह कही न आवै ॥",
      "sourceLineId": "132224",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਾ ਕੋ ਮਦਨ ਹੇਰਿ ਲਲਚਾਵੈ ॥",
      "transliteration": "jaa ko madhan her lalachaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਕਾਮ ਦੇਵ ਵੀ ਵੇਖ ਕੇ ਲਲਚਾਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "जा को मदन हेरि ललचावै ॥",
      "sourceLineId": "132225",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1235_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜੋਬਨ ਜੇਬ ਅਧਿਕ ਤਿਹ ਧਰੀ ॥",
      "transliteration": "joban jeb adhik teh dharee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਬਹੁਤ ਜੋਬਨ ਅਤੇ ਸਜ ਧਜ ਧਾਰਨ ਕੀਤੀ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1235,
      "hindi": "",
      "hindiTransliteration": "जोबन जेब अधिक तिह धरी ॥",
      "sourceLineId": "132226",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
