{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1236,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1236_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮੈਨ ਸੁ ਨਾਰ ਭਰਤ ਜਨੁ ਭਰੀ ॥੨॥",
      "transliteration": "main su naar bharat jan bharee ||2||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ (ਉਹ) ਇਸਤਰੀ ਕਾਮ ਨਾਲ ਪੂਰੀ ਤਰ੍ਰਹਾ ਭਰੀ ਹੋਈ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "मैन सु नार भरत जनु भरी ॥२॥",
      "sourceLineId": "132227",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਾ ਕੇ ਏਕ ਧਾਮ ਸੁਤ ਭਯੋ ॥",
      "transliteration": "taa ke ek dhaam sut bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਘਰ ਇਕ ਪੁੱਤਰ ਹੋਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "ता के एक धाम सुत भयो ॥",
      "sourceLineId": "132228",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬੀਸ ਬਰਿਸ ਕੋ ਹ੍ਵੈ ਮਰਿ ਗਯੋ ॥",
      "transliteration": "bees baris ko havai mar gayo ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਵੀਹ ਵਰ੍ਰਹਿਆਂ ਦਾ ਹੋ ਕੇ ਮਰ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "बीस बरिस को ह्वै मरि गयो ॥",
      "sourceLineId": "132229",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਨਿਯਹਿ ਬਾਢਾ ਸੋਕ ਅਪਾਰਾ ॥",
      "transliteration": "raniyeh baaddaa sok apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਦਾ ਦੁਖ ਬਹੁਤ ਵਧ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "रनियहि बाढा सोक अपारा ॥",
      "sourceLineId": "132230",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਾ ਤੇ ਸਭ ਬਿਸਰਾ ਘਰ ਬਾਰਾ ॥੩॥",
      "transliteration": "jaa te sabh bisaraa ghar baaraa ||3||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਸਭ ਘਰ ਬਾਰ ਭੁਲ ਗਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "जा ते सभ बिसरा घर बारा ॥३॥",
      "sourceLineId": "132231",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਹ ਇਕ ਪੂਤ ਸਾਹ ਕੋ ਆਯੋ ॥",
      "transliteration": "teh ik poot saeh ko aayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਸ਼ਾਹ ਦਾ ਇਕ ਪੁੱਤਰ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "तह इक पूत साह को आयो ॥",
      "sourceLineId": "132232",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤੇਜਵਾਨ ਦੁਤਿ ਕੋ ਜਨੁ ਜਾਯੋ ॥",
      "transliteration": "tejavaan dhut ko jan jaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਇਤਨਾ) ਤੇਜਵਾਨ ਸੀ, ਮਾਨੋ ਪ੍ਰਕਾਸ਼ ਨੇ ਹੀ ਉਸ ਨੂੰ ਜਨਮਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "तेजवान दुति को जनु जायो ॥",
      "sourceLineId": "132233",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੈਸੋ ਤਿਹ ਸੁਤ ਕੋ ਥੋ ਰੂਪਾ ॥",
      "transliteration": "jaiso teh sut ko tho roopaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੋ ਜਿਹਾ ਰਾਣੀ ਦੇ ਪੁੱਤਰ ਦਾ ਸਰੂਪ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "जैसो तिह सुत को थो रूपा ॥",
      "sourceLineId": "132234",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤੈਸੋ ਈ ਤਿਹ ਲਗਤ ਸਰੂਪਾ ॥੪॥",
      "transliteration": "taiso iee teh lagat saroopaa ||4||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਤਰ੍ਰਹਾ ਇਸ ਦਾ ਰੂਪ ਵੀ ਲਗਦਾ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "तैसो ई तिह लगत सरूपा ॥४॥",
      "sourceLineId": "132235",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਬ ਰਾਨੀ ਸੋ ਪੁਰਖ ਨਿਹਾਰਾ ॥",
      "transliteration": "jab raanee so purakh nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਣੀ ਨੇ ਉਹ ਪੁਰਸ਼ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "जब रानी सो पुरख निहारा ॥",
      "sourceLineId": "132236",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਲਾਜ ਸਾਜ ਤਜ ਹ੍ਰਿਦੈ ਬਿਚਾਰਾ ॥",
      "transliteration": "laaj saaj taj hiradhai bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਲਾਜ ਮਰਯਾਦਾ ਨੂੰ ਛਡ ਕੇ ਹਿਰਦੇ ਵਿਚ ਵਿਚਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "लाज साज तज हृदै बिचारा ॥",
      "sourceLineId": "132237",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਯਾ ਸੌ ਕਾਮ ਭੋਗ ਅਬ ਕਰਿਯੈ ॥",
      "transliteration": "yaa sau kaam bhog ab kariyai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨਾਲ ਹੁਣ ਕਾਮ ਭੋਗ ਕਰਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "या सौ काम भोग अब करियै ॥",
      "sourceLineId": "132238",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾਤਰ ਮਾਰ ਛੁਰਕਿਆ ਮਰਿਯੈ ॥੫॥",
      "transliteration": "naatar maar chhurakiaa mariyai ||5||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਛੁਰੀ ਮਾਰ ਕੇ ਮਰ ਜਾਵਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "नातर मार छुरकिआ मरियै ॥५॥",
      "sourceLineId": "132239",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਬ ਵਹੁ ਕੁਅਰ ਰਾਹ ਤਿਹ ਆਵੈ ॥",
      "transliteration": "jab vahu kuar raeh teh aavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਕੁਮਾਰ ਰਾਹ ਤੋਂ ਲੰਘਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "जब वहु कुअर राह तिह आवै ॥",
      "sourceLineId": "132240",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚੰਚਲ ਦੇਖਨ ਕੌ ਤਿਹ ਜਾਵੈ ॥",
      "transliteration": "cha(n)chal dhekhan kau teh jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਉਸ ਨੂੰ ਵੇਖਣ ਜਾਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "चंचल देखन कौ तिह जावै ॥",
      "sourceLineId": "132241",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਇਕ ਦਿਨ ਤਾ ਕੇ ਨਾਥ ਨਿਹਾਰੀ ॥",
      "transliteration": "eik dhin taa ke naath nihaaree ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਉਸ ਨੂੰ (ਵੇਖਦੇ ਹੋਇਆਂ) ਰਾਜੇ ਨੇ ਵੇਖ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "इक दिन ता के नाथ निहारी ॥",
      "sourceLineId": "132242",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਸੌ ਤਿਹ ਬਾਤ ਉਚਾਰੀ ॥੬॥",
      "transliteration": "eeh bidh sau teh baat uchaaree ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਗੱਲ ਕਹੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "इह बिधि सौ तिह बात उचारी ॥६॥",
      "sourceLineId": "132243",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਿਹ ਨਿਮਿਤਿ ਇਹ ਠਾ ਤੂ ਆਈ ॥",
      "transliteration": "keh nimit ieh Thaa too aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸ ਕਰ ਕੇ ਤੂੰ ਇਥੇ ਆਈ ਹੈਂ",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "किह निमिति इह ठा तू आई ॥",
      "sourceLineId": "132244",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹੇਰਿ ਰਹੀ ਕਿਹ ਕਹ ਦ੍ਰਿਗ ਲਾਈ ॥",
      "transliteration": "her rahee keh keh dhirag laiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਸ ਨੂੰ ਅੱਖਾ ਲਗਾ ਕੇ ਵੇਖ ਰਹੀ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "हेरि रही किह कह दृग लाई ॥",
      "sourceLineId": "132245",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਇਹ ਭਾਤਿ ਉਚਾਰੋ ॥",
      "transliteration": "tab raanee ieh bhaat uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "तब रानी इह भाति उचारो ॥",
      "sourceLineId": "132246",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੁਨਹੁ ਨ੍ਰਿਪਤਿ ਤੁਮ ਬਚਨ ਹਮਾਰੋ ॥੭॥",
      "transliteration": "sunahu nirapat tum bachan hamaaro ||7||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਤੁਸੀਂ ਮੇਰੀ ਗੱਲ ਸੁਣੋ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "सुनहु नृपति तुम बचन हमारो ॥७॥",
      "sourceLineId": "132247",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਸ ਤਵ ਸੁਤ ਸੁਰ ਲੋਕ ਸਿਧਾਯੋ ॥",
      "transliteration": "jas tav sut sur lok sidhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਦਾ ਤੁਹਾਡਾ ਪੁੱਤਰ ਸਵਰਗ ਸਿਧਾਰਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "जस तव सुत सुर लोक सिधायो ॥",
      "sourceLineId": "132248",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੋ ਧਰਿ ਰੂਪ ਦੁਤਿਯ ਜਨੁ ਆਯੋ ॥",
      "transliteration": "so dhar roop dhutiy jan aayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ (ਕੁਮਾਰ) ਮਾਨੋ ਉਸ ਦਾ ਦੂਜਾ ਰੂਪ ਧਾਰਨ ਕਰ ਕੇ ਆਇਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "सो धरि रूप दुतिय जनु आयो ॥",
      "sourceLineId": "132249",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਿਹ ਤੁਮ ਮੁਰਿ ਢਿਗ ਸੇਜ ਸੁਵਾਵੋ ॥",
      "transliteration": "teh tum mur ddig sej suvaavo ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਇਸ ਨੂੰ ਮੇਰੀ ਸੇਜ ਦੇ ਨੇੜੇ ਸਵਾਓ",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "तिह तुम मुरि ढिग सेज सुवावो ॥",
      "sourceLineId": "132250",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹਮਰੇ ਚਿਤ ਕੋ ਤਾਪ ਮਿਟਾਵੋ ॥੮॥",
      "transliteration": "hamare chit ko taap miTaavo ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੇ ਚਿਤ ਦੇ ਦੁਖ ਨੂੰ ਦੂਰ ਕਰ ਦਿਓ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "हमरे चित को ताप मिटावो ॥८॥",
      "sourceLineId": "132251",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੂਰਖ ਭੇਦ ਅਭੇਦ ਨ ਪਾਯੋ ॥",
      "transliteration": "moorakh bhedh abhedh na paayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ (ਰਾਜੇ) ਨੇ ਭੇਦ ਅਭੇਦ ਨਾ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "मूरख भेद अभेद न पायो ॥",
      "sourceLineId": "132252",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਾਹਿ ਬੁਲਾਇ ਆਪੁ ਲੈ ਆਯੋ ॥",
      "transliteration": "taeh bulai aap lai aayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਯੁਵਕ ਨੂੰ ਆਪ ਬੁਲਾ ਲਿਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "ताहि बुलाइ आपु लै आयो ॥",
      "sourceLineId": "132253",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨ੍ਰਿਪ ਪੁਨਿ ਤਿਹ ਭਰੁਆਪਨ ਕਰਿਯੋ ॥",
      "transliteration": "nirap pun teh bharuaapan kariyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਆਪ ਦਲਾਲੀ ('ਭਰੁਆਪਨ') ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "नृप पुनि तिह भरुआपन करियो ॥",
      "sourceLineId": "132254",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭਲੋ ਬੁਰੋ ਨ ਬਿਚਾਰਿ ਬਿਚਰਿਯੋ ॥੯॥",
      "transliteration": "bhalo buro na bichaar bichariyo ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੰਗੇ ਮਾੜੇ ਦਾ ਵਿਚਾਰ ਨਾ ਕੀਤਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "भलो बुरो न बिचारि बिचरियो ॥९॥",
      "sourceLineId": "132255",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭਰੂਆ ਕੀ ਕ੍ਰਿਆ ਕਹ ਕਰਿਯੋ ॥",
      "transliteration": "bharooaa kee kriaa keh kariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਦਲਾਲੀ ਦਾ ਕੰਮ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "भरूआ की कृआ कह करियो ॥",
      "sourceLineId": "132256",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚਾਰਿ ਬਿਚਾਰ ਕਛੂ ਨ ਬਿਚਰਿਯੋ ॥",
      "transliteration": "chaar bichaar kachhoo na bichariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਠੀਕ ਗ਼ਲਤ ਦਾ ਕੁਝ ਵੀ ਵਿਚਾਰ ਨਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "चारि बिचार कछू न बिचरियो ॥",
      "sourceLineId": "132257",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੂਤੀ ਪਠਵਨ ਤੇ ਤ੍ਰਿਯ ਬਚੀ ॥",
      "transliteration": "dhootee paThavan te tiray bachee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਦੂਤੀ ਭੇਜ ਕੇ (ਉਸ ਨੂੰ ਬੁਲਾਉਣ ਤੋਂ) ਬਚ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "दूती पठवन ते तृय बची ॥",
      "sourceLineId": "132258",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭੂਪਤਿ ਕੀ ਦੂਤੀ ਕਰਿ ਰਚੀ ॥੧੦॥",
      "transliteration": "bhoopat kee dhootee kar rachee ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੂੰ ਹੀ ਦੂਤੀ ਬਣਾ ਦਿੱਤਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "भूपति की दूती करि रची ॥१०॥",
      "sourceLineId": "132259",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਾਹਿ ਸੇਜ ਕੇ ਨਿਕਟ ਸੁਵਾਵੈ ॥",
      "transliteration": "taeh sej ke nikaT suvaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਆਪਣੀ ਸੇਜ ਦੇ ਨੇੜੇ ਸਵਾਉਾਂਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "ताहि सेज के निकट सुवावै ॥",
      "sourceLineId": "132260",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭਲੋ ਭਲੋ ਭੋਜਨ ਤਿਹ ਖੁਵਾਵੈ ॥",
      "transliteration": "bhalo bhalo bhojan teh khuvaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਚੰਗਾ ਚੰਗਾ ਭੋਜਨ ਖਵਾਉਾਂਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "भलो भलो भोजन तिह खुवावै ॥",
      "sourceLineId": "132261",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਹੈ ਸੁ ਸੁਤ ਮੁਰ ਕੀ ਅਨੁਹਾਰਾ ॥",
      "transliteration": "kahai su sut mur kee anuhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਹਿੰਦੀ ਕਿ (ਇਸ ਦੀ) ਮੇਰੇ ਪੁੱਤਰ ਵਰਗੀ ਨੁਹਾਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "कहै सु सुत मुर की अनुहारा ॥",
      "sourceLineId": "132262",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਾ ਤੇ ਯਾ ਸੰਗ ਹਮਰੋ ਪ੍ਯਾਰਾ ॥੧੧॥",
      "transliteration": "taa te yaa sa(n)g hamaro payaaraa ||11||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਇਸ ਦੀ ਸੰਗਤ ਮੈਨੂੰ ਬਹੁਤ ਪਿਆਰੀ ਲਗਦੀ ਹੈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "ता ते या संग हमरो प्यारा ॥११॥",
      "sourceLineId": "132263",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੋ ਤ੍ਰਿਯ ਤਾ ਕੌ ਭੋਜ ਖੁਵਾਰੈ ॥",
      "transliteration": "jo tiray taa kau bhoj khuvaarai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ (ਹੋਰ ਕੋਈ) ਇਸਤਰੀ ਉਸ ਨੂੰ ਭੋਜਨ ਖਵਾਉਾਂਦੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "जो तृय ता कौ भोज खुवारै ॥",
      "sourceLineId": "132264",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਾਨੀ ਝਝਕਿ ਤਾਹਿ ਤ੍ਰਿਯ ਡਾਰੈ ॥",
      "transliteration": "raanee jhajhak taeh tiray ddaarai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੂੰ ਰਾਣੀ ਝਿੜਕ ਦਿੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "रानी झझकि ताहि तृय डारै ॥",
      "sourceLineId": "132265",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਇਹ ਮੋਰੇ ਸੁਤ ਕੀ ਅਨੁਹਾਰਾ ॥",
      "transliteration": "eeh more sut kee anuhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਦੀ ਨੁਹਾਰ ਮੇਰੇ ਪੁੱਤਰ ਵਰਗੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "इह मोरे सुत की अनुहारा ॥",
      "sourceLineId": "132266",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭਲੋ ਭਲੋ ਚਹਿਯਤ ਤਿਹ ਖ੍ਵਾਰਾ ॥੧੨॥",
      "transliteration": "bhalo bhalo chahiyat teh khavaiaaraa ||12||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਲਈ) ਇਸ ਨੂੰ ਚੰਗਾ ਚੰਗਾ ਭੋਜਨ ਕਰਾਉਣਾ ਚਾਹੀਦਾ ਹੈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "भलो भलो चहियत तिह ख्वारा ॥१२॥",
      "sourceLineId": "132267",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਿਕਟਿ ਆਪਨੇ ਤਾਹਿ ਸੁਵਾਵੈ ॥",
      "transliteration": "nikaT aapane taeh suvaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਆਪਣੇ ਕੋਲ ਸਵਾਉਾਂਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "निकटि आपने ताहि सुवावै ॥",
      "sourceLineId": "132268",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਿਹ ਢਿਗ ਅਪਨੀ ਸੇਜ ਬਿਛਾਵੈ ॥",
      "transliteration": "teh ddig apanee sej bichhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੇ ਨੇੜੇ ਆਪਣੀ ਸੇਜ ਵਿਛਾਉਾਂਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "तिह ढिग अपनी सेज बिछावै ॥",
      "sourceLineId": "132269",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਬ ਤਾ ਸੰਗ ਨ੍ਰਿਪਤਿ ਸ੍ਵੈ ਜਾਵੈ ॥",
      "transliteration": "jab taa sa(n)g nirapat savai jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਨਾਲ ਰਾਜਾ ਸੌਂ ਜਾਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "जब ता संग नृपति स्वै जावै ॥",
      "sourceLineId": "132270",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਬ ਤ੍ਰਿਯ ਤਾ ਸੰਗ ਭੋਗ ਕਮਾਵੈ ॥੧੩॥",
      "transliteration": "tab tiray taa sa(n)g bhog kamaavai ||13||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਾਣੀ ਉਸ (ਕੁਮਾਰ) ਨਾਲ ਕਾਮ-ਭੋਗ ਕਰਦੀ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "तब तृय ता संग भोग कमावै ॥१३॥",
      "sourceLineId": "132271",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਸਿ ਕਸਿ ਰਮੈ ਜਾਰ ਕੇ ਸੰਗਾ ॥",
      "transliteration": "kas kas ramai jaar ke sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਕਸ ਕਸ ਕੇ ਯਾਰ ਨਾਲ ਰਮਣ ਕਰਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "कसि कसि रमै जार के संगा ॥",
      "sourceLineId": "132272",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦਲਿ ਮਲਿ ਤਾਹਿ ਕਰੈ ਸਰਬੰਗਾ ॥",
      "transliteration": "dhal mal taeh karai saraba(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੇ ਸਾਰਿਆਂ ਅੰਗਾ ਨੂੰ ਮਿਧ ਦਿੰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "दलि मलि ताहि करै सरबंगा ॥",
      "sourceLineId": "132273",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1236_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਭੋਗ ਕਮਾਈ ॥",
      "transliteration": "bhaat bhaat tan bhog kamaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨਾਲ) ਭਾਤ ਭਾਤ ਦੇ ਭੋਗ ਕਰਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन भोग कमाई ॥",
      "sourceLineId": "132274",
      "sourceShabadId": "12486",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
