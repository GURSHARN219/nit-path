{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1238,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1238_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਾਹੁ ਤਵਨ ਕੀ ਬਾਤ ਨ ਮਾਨੀ ॥",
      "transliteration": "saahu tavan kee baat na maanee ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਾਹ ਨੇ ਉਸ ਇਸਤਰੀ ਦੀ ਗੱਲ ਨਾ ਮੰਨੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "साहु तवन की बात न मानी ॥",
      "sourceLineId": "132323",
      "sourceShabadId": "12492",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਧਿਕ ਮੰਗਲਾ ਭਈ ਖਿਸਾਨੀ ॥",
      "transliteration": "adhik ma(n)galaa bhiee khisaanee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤੇ) ਮੰਗਲਾ ਬਹੁਤ ਖਿਝ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "अधिक मंगला भई खिसानी ॥",
      "sourceLineId": "132324",
      "sourceShabadId": "12492",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਧਿਕ ਕੋਪ ਕਰਿ ਹੇਤੁ ਬਿਸਾਰਾ ॥",
      "transliteration": "adhik kop kar het bisaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਬਹੁਤ ਕ੍ਰੋਧ ਕਰ ਕੇ ਪਿਆਰ ਨੂੰ ਭੁਲਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "अधिक कोप करि हेतु बिसारा ॥",
      "sourceLineId": "132325",
      "sourceShabadId": "12492",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਰਧਾ ਅਰਧ ਚੀਰ ਤਿਹ ਡਾਰਾ ॥੮॥",
      "transliteration": "aradhaa aradh cheer teh ddaaraa ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਅਧੋ ਅਧ ਚੀਰ ਸੁਟਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "अरधा अरध चीर तिह डारा ॥८॥",
      "sourceLineId": "132326",
      "sourceShabadId": "12492",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਲੂਟਿ ਲਯੋ ਤਾ ਕੋ ਸਭ ਹੀ ਧਨ ॥",
      "transliteration": "looT layo taa ko sabh hee dhan ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਸਾਰਾ ਧਨ ਲੁਟ ਲਿਆ (ਅਤੇ ਕਿਹਾ ਕਿ)",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "लूटि लयो ता को सभ ही धन ॥",
      "sourceLineId": "132327",
      "sourceShabadId": "12492",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਘੋਰ ਅਪ੍ਰਾਧ ਕਿਯੋ ਪਾਪੀ ਇਨ ॥",
      "transliteration": "ghor apraadh kiyo paapee in ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਪਾਪੀ ਨੇ ਬਹਤੁ ਵੱਡਾ ਪਾਪ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "घोर अप्राध कियो पापी इन ॥",
      "sourceLineId": "132328",
      "sourceShabadId": "12492",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਯਾ ਕਹ ਚੀਰਿ ਮਤ ਗਜ ਡਾਰਾ ॥",
      "transliteration": "yaa keh cheer mat gaj ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ ਕਹਿਣ ਲਗੀ) ਇਸ ਨੂੰ ਮਸਤ ਹਾਥੀ ਨੇ ਚੀਰਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "या कह चीरि मत गज डारा ॥",
      "sourceLineId": "132329",
      "sourceShabadId": "12492",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਿਨਹੂੰ ਪੁਰਖ ਨ ਕਰੀ ਨਿਵਾਰਾ ॥੯॥",
      "transliteration": "kinahoo(n) purakh na karee nivaaraa ||9||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਵਿਅਕਤੀ ਨੇ ਵੀ ਹਾਥੀ ('ਕਰੀ') ਨੂੰ ਨਹੀਂ ਹਟਾਇਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "किनहूँ पुरख न करी निवारा ॥९॥",
      "sourceLineId": "132330",
      "sourceShabadId": "12492",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਵਾਰਸ ਭਈ ਆਪੁ ਤਾ ਕੀ ਤਿਯ ॥",
      "transliteration": "vaaras bhiee aap taa kee tiy ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਸਤਰੀ ਆਪ ਉਸ ਦੀ ਵਾਰਸ ਬਣ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "वारस भई आपु ता की तिय ॥",
      "sourceLineId": "132331",
      "sourceShabadId": "12492",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਾਤ੍ਰਾ ਲਈ ਮਾਰਿ ਤਾ ਕੋ ਜਿਯ ॥",
      "transliteration": "maatraa liee maar taa ko jiy ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜਾਨੋ ਮਾਰ ਕੇ ਸਾਰੀ ਦੌਲਤ ('ਮਾਤ੍ਰਾ') ਲੈ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "मात्रा लई मारि ता को जिय ॥",
      "sourceLineId": "132332",
      "sourceShabadId": "12492",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨੂੰ ਬਿਚਾਰਾ ॥",
      "transliteration": "bhedh abhedh na kinoo(n) bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਵੀ ਭੇਦ ਅਭੇਦ ਨਹੀਂ ਵਿਚਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न किनूँ बिचारा ॥",
      "sourceLineId": "132333",
      "sourceShabadId": "12492",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭੋਗ ਨ ਕਿਯਾ ਤਿਸੈ ਕੌ ਮਾਰਾ ॥੧੦॥",
      "transliteration": "bhog na kiyaa tisai kau maaraa ||10||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਸ਼ਾਹ ਨੇ) ਭੋਗ ਕਰਨਾ ਨਾ ਮੰਨਿਆ, (ਇਸ ਲਈ) ਉਸ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "भोग न किया तिसै कौ मारा ॥१०॥",
      "sourceLineId": "132334",
      "sourceShabadId": "12492",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "132335",
      "sourceShabadId": "12493",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਹ ਛਲ ਮਾਰਾ ਤਾਹਿ ਕੌ ਜੌ ਨ ਰਮਾ ਤਿਹ ਸੰਗ ॥",
      "transliteration": "eeh chhal maaraa taeh kau jau na ramaa teh sa(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਉਸ ਨੂੰ ਮਾਰ ਦਿੱਤਾ, ਜੋ ਉਸ ਨਾਲ ਨਾ ਰਮਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "इह छल मारा ताहि कौ जौ न रमा तिह संग ॥",
      "sourceLineId": "132336",
      "sourceShabadId": "12493",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੁ ਕਬਿ ਸ੍ਯਾਮ ਪੂਰਨ ਭਯੋ ਤਬ ਹੀ ਕਥਾ ਪ੍ਰਸੰਗ ॥੧੧॥",
      "transliteration": "s kab sayaam pooran bhayo tab hee kathaa prasa(n)g ||11||",
      "translation": "",
      "punjabiViakhya": "ਕਵੀ ਸਿਆਮ ਅਨੁਸਾਰ ਤਦ ਹੀ ਕਥਾ ਪ੍ਰਸੰਗ ਪੂਰਾ ਹੋ ਗਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "सु कबि स्याम पूरन भयो तब ही कथा प्रसंग ॥११॥",
      "sourceLineId": "132337",
      "sourceShabadId": "12493",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਛ੍ਰਯਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੯੬॥੫੬੪੯॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dhoi sau chhrayaanavo charitr samaapatam sat subham sat ||296||5649||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੯੬ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੯੬॥੫੬੪੯॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दोइ सौ छ्रयानवो चरित्र समापतम सतु सुभम सतु ॥२९६॥५६४९॥अफजूँ॥",
      "sourceLineId": "132338",
      "sourceShabadId": "12493",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "132339",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਿਜੈ ਸੂਰ ਖਤ੍ਰੀ ਇਕ ਰਹੈ ॥",
      "transliteration": "bijai soor khatree ik rahai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਬਿਜੈ ਸੂਰ ਨਾ ਖਤ੍ਰੀ (ਛਤ੍ਰੀ) ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "बिजै सूर खत्री इक रहै ॥",
      "sourceLineId": "132340",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਿਧ ਪਾਲ ਤਾ ਕਹ ਜਗ ਕਹੈ ॥",
      "transliteration": "sidh paal taa keh jag kahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸਾਰਾ ਜਗਤ ਸਿਧ ਪਾਲ ਕਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "सिध पाल ता कह जग कहै ॥",
      "sourceLineId": "132341",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਮਸਦੀਨ ਦਿਲੀਸ ਦਿਵਾਨਾ ॥",
      "transliteration": "samasadheen dhilees dhivaanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਦਿੱਲੀ ਦੇ ਬਾਦਸ਼ਾਹ ਸ਼ਮਸਦੀਨ ਦਾ ਦੀਵਾਨ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "समसदीन दिलीस दिवाना ॥",
      "sourceLineId": "132342",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਾਨਤ ਸਕਲ ਰਾਵ ਅਰੁ ਰਾਨਾ ॥੧॥",
      "transliteration": "jaanat sakal raav ar raanaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਸਾਰੇ ਰਾਜੇ ਅਤੇ ਰਾਣੇ ਜਾਣਦੇ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "जानत सकल राव अरु राना ॥१॥",
      "sourceLineId": "132343",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਲਛਿਮਨ ਸੈਨ ਧਾਮ ਸੁਤ ਸੁਭ ਮਤਿ ॥",
      "transliteration": "lachhiman sain dhaam sut subh mat ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਘਰ ਲਛਿਮਨ ਸੈਨ ਨਾ ਦਾ ਇਕ ਸ਼ੁਭ ਮਤਿ ਵਾਲਾ ਪੁੱਤਰ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "लछिमन सैन धाम सुत सुभ मति ॥",
      "sourceLineId": "132344",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਜ੍ਰ ਸੈਨ ਦੂਸਰੋ ਬਿਕਟ ਮਤਿ ॥",
      "transliteration": "bajr sain dhoosaro bikaT mat ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਜ੍ਰ ਸੈਨ ਨਾ ਵਾਲਾ ਦੂਜਾ ਭੈੜੀ ਮਤਿ ਵਾਲਾ (ਪੁੱਤਰ) ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "बज्र सैन दूसरो बिकट मति ॥",
      "sourceLineId": "132345",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਕੁਚ ਮਤੀ ਦੁਹਿਤਾ ਇਕ ਤਾ ਕੇ ॥",
      "transliteration": "sakuch matee dhuhitaa ik taa ke ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸਕੁਚ ਮਤੀ ਨਾ ਦੀ ਇਕ ਪੁੱਤਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "सकुच मती दुहिता इक ता के ॥",
      "sourceLineId": "132346",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਰੀ ਨਾਗਨੀ ਸਮ ਨਹਿ ਜਾ ਕੇ ॥੨॥",
      "transliteration": "naree naaganee sam neh jaa ke ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਕੋਈ ਨਰੀ ਜਾ ਨਾਗਨੀ ਨਹੀਂ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "नरी नागनी सम नहि जा के ॥२॥",
      "sourceLineId": "132347",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਮਸਦੀਨ ਦਿਲੀਸ ਜੁਵਾਨਾ ॥",
      "transliteration": "samasadheen dhilees juvaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਦਿੱਲੀ ਦਾ ਬਾਦਸ਼ਾਹ ਸ਼ਮਸਦੀਨ ਜਵਾਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "समसदीन दिलीस जुवाना ॥",
      "sourceLineId": "132348",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਾਨਤ ਆਨਿ ਦੇਸ ਜਿਹ ਨਾਨਾ ॥",
      "transliteration": "maanat aan dhes jeh naanaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਸਾਰੇ ਦੇਸ ਉਸ ਦੀ ਈਨ ਮੰਨਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "मानत आनि देस जिह नाना ॥",
      "sourceLineId": "132349",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਵਹੁ ਗਯੋ ਸਿਕਾਰਾ ॥",
      "transliteration": "ek dhivas vahu gayo sikaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਉਹ ਸ਼ਿਕਾਰ ਉਤੇ ਉਸ ਦਿਸ਼ਾ ਵਲ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "एक दिवस वहु गयो सिकारा ॥",
      "sourceLineId": "132350",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਾ ਦਿਸ ਹੁਤੀ ਕੇਹਰੀ ਬਾਰਾ ॥੩॥",
      "transliteration": "jaa dhis hutee keharee baaraa ||3||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਸ਼ੇਰਾ ਦੀ ਬਾਰ (ਜੰਗਲ) ਸੀ। (ਉਥੇ ਉਸ ਨੇ ਇਕ ਸ਼ੇਰਨੀ ਵੇਖੀ) ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "जा दिस हुती केहरी बारा ॥३॥",
      "sourceLineId": "132351",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਹੀ ਦਿਲੀਸ ਆਪੁ ਚਲਿ ਗਯੋ ॥",
      "transliteration": "tahee dhilees aap chal gayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਬਾਦਸ਼ਾਹ ਆਪ ਵੀ ਸ਼ਿਕਾਰ ਲਈ ਚਲ ਕੇ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "तही दिलीस आपु चलि गयो ॥",
      "sourceLineId": "132352",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਹਾ ਸਿੰਘਨੀ ਚਿਤਵਤ ਭਯੋ ॥",
      "transliteration": "jahaa si(n)ghanee chitavat bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ (ਉਸ ਨੇ) ਸ਼ੇਰਨੀ ਨੂੰ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "जहा सिंघनी चितवत भयो ॥",
      "sourceLineId": "132353",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਿਧ ਪਾਲ ਲੀਏ ਅਪਨੇ ਸੰਗਾ ॥",
      "transliteration": "sidh paal le'ee apane sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਸਿਧ ਪਾਲ ਨੂੰ ਆਪਣੇ ਨਾਲ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "सिध पाल लीए अपने संगा ॥",
      "sourceLineId": "132354",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਔਰ ਲੀਏ ਅਨਗਨ ਚਤੁਰੰਗਾ ॥੪॥",
      "transliteration": "aauar le'ee anagan chatura(n)gaa ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੌਹਾ ਤਰ੍ਰਹਾ ਦੇ ਹੋਰ ਅਣਗਿਣਤ ਸੈਨਿਕ ਵੀ ਲੈ ਲਏ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "और लीए अनगन चतुरंगा ॥४॥",
      "sourceLineId": "132355",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਾ ਪਰ ਕਰੀ ਝੁਕਾਵਤ ਭਯੋ ॥",
      "transliteration": "taa par karee jhukaavat bhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਆਪਣੇ) ਹਾਥੀ ('ਕਰੀ') ਨੂੰ ਉਸ (ਸ਼ੇਰਨੀ) ਵਲ ਪ੍ਰੇਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "ता पर करी झुकावत भयो ॥",
      "sourceLineId": "132356",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕੇਹਰਿ ਸਮੈ ਜਨਮ ਤਬ ਲਯੋ ॥",
      "transliteration": "kehar samai janam tab layo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵੇਲੇ (ਸ਼ੇਰਨੀ ਦੀ ਕੁਖ ਵਿਚੋਂ) ਸ਼ੇਰ ਨੇ ਜਨਮ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "केहरि समै जनम तब लयो ॥",
      "sourceLineId": "132357",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਰਧ ਰਹਾਤਨ ਮਾਤ ਕੁਖੂਤਰ ॥",
      "transliteration": "aradh rahaatan maat kukhootar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਅਜੇ) ਅੱਧਾ ਮਾ ਦੀ ਕੁੱਖ ਵਿਚ ਹੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "अरध रहातन मात कुखूतर ॥",
      "sourceLineId": "132358",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਰਧਹ ਨਾਕਰ ਗਜ ਮਸਤਕ ਪਰ ॥੫॥",
      "transliteration": "aradheh naakar gaj masatak par ||5||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਹਾਥੀ ਦੇ ਮਸਤਕ ਵਿਚ ਨਾਖੁਨ (ਗਡ ਦਿੱਤੇ) ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "अरधह नाकर गज मसतक पर ॥५॥",
      "sourceLineId": "132359",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਹ ਇਕ ਭਾਟ ਕੌਤਕ ਅਸ ਲਹਾ ॥",
      "transliteration": "teh ik bhaaT kauatak as lahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਭਾਟ ਨੇ ਇਹ ਕੌਤਕ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "तह इक भाट कौतक अस लहा ॥",
      "sourceLineId": "132360",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹਜਰਤਿ ਸੁਨਤ ਦੋਹਰਾ ਕਹਾ ॥",
      "transliteration": "hajarat sunat dhoharaa kahaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਾਦਸ਼ਾਹ ਨੂੰ ਸੁਣਾਣ ਲਈ ਇਕ ਦੋਹਰਾ ਕਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "हजरति सुनत दोहरा कहा ॥",
      "sourceLineId": "132361",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੁ ਮੈ ਕਹਤ ਹੋ ਸੁਨਹੁ ਪ੍ਯਾਰੇ ॥",
      "transliteration": "s mai kahat ho sunahu payaare ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਿਆਰੇ! ਮੈਂ ਉਹ ਕਹਿੰਦਾ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "सु मै कहत हो सुनहु प्यारे ॥",
      "sourceLineId": "132362",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜੋ ਤਿਨ ਸਾਹ ਨ ਚਿਤ ਤੇ ਟਾਰੇ ॥੬॥",
      "transliteration": "jo tin saeh na chit te Taare ||6||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਉਸ ਬਾਦਸ਼ਾਹ ਨੇ ਕਦੇ ਚਿਤ ਤੋਂ ਭੁਲਾਇਆ ਨਹੀਂ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "जो तिन साह न चित ते टारे ॥६॥",
      "sourceLineId": "132363",
      "sourceShabadId": "12494",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "132364",
      "sourceShabadId": "12495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਿੰਘ ਸਾਪੁਰਸ ਪਦਮਿਨੀ ਇਨ ਕਾ ਇਹੈ ਸੁਭਾਉ ॥",
      "transliteration": "si(n)gh saapuras padhaminee in kaa ihai subhaau ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੇਰ, ਸੱਚਾ ਪੁਰਸ਼ ('ਸਾਪੁਰਸ') ਅਤੇ ਪਦਮਿਨੀ ਇਨ੍ਰਹਾ ਦਾ ਇਹੀ ਸੁਭਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "सिंघ सापुरस पदमिनी इन का इहै सुभाउ ॥",
      "sourceLineId": "132365",
      "sourceShabadId": "12495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜ੍ਯੋਂ ਜ੍ਯੋਂ ਦੁਖ ਗਾੜੋ ਪਰੈ ਤ੍ਯੋਂ ਤ੍ਯੋਂ ਆਗੇ ਪਾਉ ॥੭॥",
      "transliteration": "jayo(n) jayo(n) dhukh gaaRo parai tayo(n) tayo(n) aage paau ||7||",
      "translation": "",
      "punjabiViakhya": "(ਇਨ੍ਰਹਾ ਉਤੇ) ਜਿਉਾਂ ਜਿਉਾਂ ਬਹੁਤ ਦੁਖ ਪੈਂਦਾ ਹੈ, ਤਿਉਾਂ ਤਿਉਾਂ ਇਨ੍ਰਹਾ ਦਾ ਕਦਮ ਅਗੇ ਵਧਦਾ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "ज्यों ज्यों दुख गाड़ो परै त्यों त्यों आगे पाउ ॥७॥",
      "sourceLineId": "132366",
      "sourceShabadId": "12495",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "132367",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭਾਟ ਜਬੈ ਇਹ ਭਾਤਿ ਉਚਾਰਾ ॥",
      "transliteration": "bhaaT jabai ieh bhaat uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਭਾਟ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਉਚਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "भाट जबै इह भाति उचारा ॥",
      "sourceLineId": "132368",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਜਰਤਿ ਬਚਨ ਸ੍ਰਵਨ ਇਹ ਧਾਰਾ ॥",
      "transliteration": "hajarat bachan sravan ieh dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਤਦ) ਇਸ ਬਚਨ ਨੂੰ ਹਜ਼ਰਤ ਨੇ ਸੁਣਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "हजरति बचन स्रवन इह धारा ॥",
      "sourceLineId": "132369",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਬ ਅਪਨੇ ਮਹਲਨ ਮਹਿ ਆਯੋ ॥",
      "transliteration": "jab apane mahalan meh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਆਪਣੇ ਮੱਹਲਾ ਵਿਚ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "जब अपने महलन महि आयो ॥",
      "sourceLineId": "132370",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਿਧ ਪਾਲ ਕਹ ਬੋਲ ਪਠਾਯੋ ॥੮॥",
      "transliteration": "sidh paal keh bol paThaayo ||8||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸਿਧ ਪਾਲ ਨੂੰ ਬੁਲਵਾ ਲਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "सिध पाल कह बोल पठायो ॥८॥",
      "sourceLineId": "132371",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤਾ ਸੋ ਇਹ ਬਿਧਿ ਨਾਥ ਬਖਾਨਾ ॥",
      "transliteration": "taa so ieh bidh naath bakhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਦਸ਼ਾਹ ਨੇ ਉਸ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "ता सो इह बिधि नाथ बखाना ॥",
      "sourceLineId": "132372",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਤੈ ਹੈਂ ਮੋਰ ਵਜੀਰ ਸ੍ਯਾਨਾ ॥",
      "transliteration": "tai hai(n) mor vajeer sayaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਤੂੰ ਮੇਰਾ ਸਿਆਣਾ ਵਜ਼ੀਰ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "तै हैं मोर वजीर स्याना ॥",
      "sourceLineId": "132373",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਬ ਕਛੁ ਅਸ ਤੁਮ ਕਰਹੁ ਉਪਾਈ ॥",
      "transliteration": "ab kachh as tum karahu upaiee ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਤੂੰ ਕੁਝ ਅਜਿਹਾ ਉਪਾ ਕਰ,",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "अब कछु अस तुम करहु उपाई ॥",
      "sourceLineId": "132374",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਾ ਤੇ ਮਿਲੈ ਪਦੁਮਿਨਿ ਆਈ ॥੯॥",
      "transliteration": "jaa te milai padhumin aaiee ||9||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਮੈਨੂੰ ਪਦਮਿਨੀ (ਇਸਤਰੀ) ਆ ਮਿਲੇ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "जा ते मिलै पदुमिनि आई ॥९॥",
      "sourceLineId": "132375",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਿਧ ਪਾਲ ਇਹ ਭਾਤਿ ਉਚਾਰਾ ॥",
      "transliteration": "sidh paal ieh bhaat uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸਿਧ ਪਾਲ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "सिध पाल इह भाति उचारा ॥",
      "sourceLineId": "132376",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸੁਨ ਹਜਰਤਿ ਜੂ ਬਚਨ ਹਮਾਰਾ ॥",
      "transliteration": "sun hajarat joo bachan hamaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਬਾਦਸ਼ਾਹ! ਮੇਰੀ ਗੱਲ ਸੁਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "सुन हजरति जू बचन हमारा ॥",
      "sourceLineId": "132377",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਭ ਅਪਨੀ ਤੁਮ ਸੈਨ ਬੁਲਾਵੋ ॥",
      "transliteration": "sabh apanee tum sain bulaavo ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਆਪਣੀ ਸਾਰੀ ਸੈਨਾ ਬੁਲਾਓ",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "सभ अपनी तुम सैन बुलावो ॥",
      "sourceLineId": "132378",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਮੋਹਿ ਸਿੰਗਲਾਦੀਪ ਪਠਾਵੋ ॥੧੦॥",
      "transliteration": "moh si(n)galaadheep paThaavo ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੈਨੂੰ ਸਿੰਗਲਾਦੀਪ ਭੇਜੋ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "मोहि सिंगलादीप पठावो ॥१०॥",
      "sourceLineId": "132379",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਜੌ ਤੁਮਰੀ ਆਗ੍ਯਾ ਕਹ ਪਾਊ ॥",
      "transliteration": "jau tumaree aagayaa keh paauoo ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੁਹਾਡੀ ਆਗਿਆ ਹੋ ਜਾਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "जौ तुमरी आग्या कह पाऊ ॥",
      "sourceLineId": "132380",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਅਮਿਤ ਸੈਨ ਲੈ ਤਹਾ ਸਿਧਾਊ ॥",
      "transliteration": "amit sain lai tahaa sidhaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਬੇਸ਼ੁਮਾਰ ਸੈਨਾ ਲੈ ਕੇ ਉਥੇ ਜਾਵਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "अमित सैन लै तहा सिधाऊ ॥",
      "sourceLineId": "132381",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਖੜਗ ਸਿੰਗਲਾਦੀਪ ਮਚੈਹੋ ॥",
      "transliteration": "khaRag si(n)galaadheep machaiho ||",
      "translation": "",
      "punjabiViakhya": "ਸਿੰਗਲਾਦੀਪ ਵਿਚ (ਜਾ ਕੇ) ਤਲਵਾਰ ਚਲਾਵਾ (ਭਾਵ ਯੁੱਧ ਕਰਾ)",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "खड़ग सिंगलादीप मचैहो ॥",
      "sourceLineId": "132382",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਕੈ ਪਦੁਮਿਨਿ ਲੈ ਐਹੋ ॥੧੧॥",
      "transliteration": "jayo(n) tayo(n) kai padhumin lai aaiho ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਪਦਮਿਨੀ ਨੂੰ ਲੈ ਆਵਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "ज्यों त्यों कै पदुमिनि लै ऐहो ॥११॥",
      "sourceLineId": "132383",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਯੌ ਕਹਿ ਗਯੋ ਧਾਮ ਜਬ ਰਾਜਾ ॥",
      "transliteration": "yau keh gayo dhaam jab raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜਾ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿ ਕੇ ਘਰ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "यौ कहि गयो धाम जब राजा ॥",
      "sourceLineId": "132384",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਬਾਜਤ ਭਾਤ ਅਨੇਕਨ ਬਾਜਾ ॥",
      "transliteration": "baajat bhaat anekan baajaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਕਈ ਤਰ੍ਰਹਾ ਦੇ ਵਾਜੇ ਵਜਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "बाजत भात अनेकन बाजा ॥",
      "sourceLineId": "132385",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਬੈਰੀ ਹੁਤੋ ਤਹਾ ਇਕ ਤਾ ਕੋ ॥",
      "transliteration": "bairee huto tahaa ik taa ko ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਉਸ (ਸਿਧ ਪਾਲ) ਦਾ ਇਕ ਵੈਰੀ ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "बैरी हुतो तहा इक ता को ॥",
      "sourceLineId": "132386",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਭੇਦ ਕਹਾ ਹਜਰਤਿ ਪੈ ਵਾ ਕੋ ॥੧੨॥",
      "transliteration": "bhedh kahaa hajarat pai vaa ko ||12||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਬਾਦਸ਼ਾਹ ਨੂੰ ਉਸ (ਸਿਧ ਪਾਲ) ਦਾ ਭੇਦ ਦਸ ਦਿੱਤਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "भेद कहा हजरति पै वा को ॥१२॥",
      "sourceLineId": "132387",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਏਕ ਧਾਮ ਦੁਹਿਤਾ ਹੈ ਯਾ ਕੇ ॥",
      "transliteration": "ek dhaam dhuhitaa hai yaa ke ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ (ਸਿਧ ਪਾਲ) ਦੇ ਘਰ ਇਕ ਪੁੱਤਰੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "एक धाम दुहिता है या के ॥",
      "sourceLineId": "132388",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਪਰੀ ਪਦਮਿਨਿ ਤੁਲਿ ਨ ਤਾ ਕੇ ॥",
      "transliteration": "paree padhamin tul na taa ke ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਬਰਾਬਰ ਪਰੀ ਅਤੇ ਪਦਮਿਨੀ ਵੀ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "परी पदमिनि तुलि न ता के ॥",
      "sourceLineId": "132389",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਪਠੈ ਮਨੁਛ ਤਿਹ ਹੇਰਿ ਮੰਗਾਵਹੁ ॥",
      "transliteration": "paThai manuchh teh her ma(n)gaavahu ||",
      "translation": "",
      "punjabiViakhya": "ਬੰਦਾ ਭੇਜ ਕੇ ਉਸ ਨੂੰ ਮੰਗਵਾ ਕੇ ਵੇਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "पठै मनुछ तिह हेरि मंगावहु ॥",
      "sourceLineId": "132390",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਤਿਹ ਪਾਛੇ ਪਦੁਮਿਨਿ ਖੁਜਾਵਹੁ ॥੧੩॥",
      "transliteration": "teh paachhe padhumin khujaavahu ||13||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਬਾਦ ਪਦਮਿਨੀ (ਦੀ ਸਿੰਗਲਾਦੀਪ ਤੋਂ) ਖੋਜ ਕਰਵਾਓ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "तिह पाछे पदुमिनि खुजावहु ॥१३॥",
      "sourceLineId": "132391",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਹਜਰਤਿ ਸੁਨਤ ਜਬੈ ਸੇ ਭਯੋ ॥",
      "transliteration": "hajarat sunat jabai se bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਹਜ਼ਰਤ ਨੇ ਇਹ ਸੁਣ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "हजरति सुनत जबै से भयो ॥",
      "sourceLineId": "132392",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਤਤਛਿਨ ਦੂਤੀ ਤਹਾ ਪਠਯੋ ॥",
      "transliteration": "tatachhin dhootee tahaa paThayo ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਤੁਰਤ ਦੂਤੀ ਉਥੇ ਭੇਜ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "ततछिन दूती तहा पठयो ॥",
      "sourceLineId": "132393",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1238_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਚਤੁਰਿ ਚਿਤੇਰੀ ਰੂਪ ਉਜਿਯਾਰੀ ॥",
      "transliteration": "chatur chiteree roop ujiyaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਦੂਤੀ) ਚਤੁਰ, ਚਿਤੇਰੀ (ਚਿਤ੍ਰਕਾਰ) ਅਤੇ ਉਜਲੇ ਰੂਪ ਵਾਲੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1238,
      "hindi": "",
      "hindiTransliteration": "चतुरि चितेरी रूप उजियारी ॥",
      "sourceLineId": "132394",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
