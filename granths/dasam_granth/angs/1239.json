{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1239,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1239_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਿਸੁਕਰਮਾ ਕੀ ਜਾਨ ਕੁਮਾਰੀ ॥੧੪॥",
      "transliteration": "bisukaramaa kee jaan kumaaree ||14||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਵਿਸ਼ਵਕਰਮਾ ਦੀ ਪੁੱਤਰੀ ਹੋਵੇ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "बिसुकरमा की जान कुमारी ॥१४॥",
      "sourceLineId": "132395",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਕ ਚਤੁਰਾ ਅਰੁ ਦੁਤਿਯ ਚਿਤੇਰੀ ॥",
      "transliteration": "eik chaturaa ar dhutiy chiteree ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਉਹ ਚਾਲਾਕ ਅਤੇ ਦੂਜੇ ਚਿਤੇਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "इक चतुरा अरु दुतिय चितेरी ॥",
      "sourceLineId": "132396",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪ੍ਰਤਿਮਾ ਦੁਤਿਯ ਮਦਨ ਜਨ ਕੇਰੀ ॥",
      "transliteration": "pratimaa dhutiy madhan jan keree ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਕਾਮ ਦੀ ਹੀ ਦੂਜੀ ਮੂਰਤੀ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "प्रतिमा दुतिय मदन जन केरी ॥",
      "sourceLineId": "132397",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੋਰ ਬਰਨ ਅਰੁ ਖਾਏ ਪਾਨਾ ॥",
      "transliteration": "gor baran ar khaae paanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਗੋਰਾ ਰੰਗ ਸੀ ਅਤੇ ਪਾਨ ਖਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "गोर बरन अरु खाए पाना ॥",
      "sourceLineId": "132398",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਾਨੁਕ ਚੜਾ ਚੰਦ ਅਸਮਾਨਾ ॥੧੫॥",
      "transliteration": "jaanuk chaRaa cha(n)dh asamaanaa ||15||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਆਸਮਾਨ ਵਿਚ ਚੰਦ ਚੜ੍ਰਹਿਆ ਹੋਵੇ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "जानुक चड़ा चंद असमाना ॥१५॥",
      "sourceLineId": "132399",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਾ ਕੇ ਧਾਮ ਚਿਤੇਰਨਿ ਗਈ ॥",
      "transliteration": "taa ke dhaam chiteran giee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਚਿਤੇਰੀ (ਦੂਤੀ) ਉਸ ਦੇ ਘਰ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "ता के धाम चितेरनि गई ॥",
      "sourceLineId": "132400",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਲਿਖਿ ਲ੍ਯਾਵਤ ਪ੍ਰਤਿਮਾ ਤਿਹ ਭਈ ॥",
      "transliteration": "likh layaavat pratimaa teh bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦਾ ਚਿਤਰ ਬਣਾ ਕੇ ਲੈ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "लिखि ल्यावत प्रतिमा तिह भई ॥",
      "sourceLineId": "132401",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਬ ਲੈ ਕਰਿ ਕਰ ਸਾਹ ਨਿਹਾਰੀ ॥",
      "transliteration": "jab lai kar kar saeh nihaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਬਾਦਸ਼ਾਹ ਨੇ ਚਿਤਰ ਨੂੰ ਹੱਥ ਵਿਚ ਲੈ ਕੇ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "जब लै करि कर साह निहारी ॥",
      "sourceLineId": "132402",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਾਨੁਕ ਤਾਨਿ ਕਟਾਰੀ ਮਾਰੀ ॥੧੬॥",
      "transliteration": "jaanuk taan kaTaaree maaree ||16||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਿਆ) ਮਾਨੋ (ਕਾਮ ਦੇਵ ਨੇ) ਕਸ ਕੇ ਕਟਾਰ ਮਾਰੀ ਹੋਵੇ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "जानुक तानि कटारी मारी ॥१६॥",
      "sourceLineId": "132403",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਭ ਸੁਧਿ ਗਈ ਮਤ ਹ੍ਵੈ ਝੂੰਮਾ ॥",
      "transliteration": "sabh sudh giee mat havai jhoo(n)maa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਸਭ ਸੁਧ ਬੁਧ ਚਲੀ ਗਈ ਅਤੇ ਮਸਤ ਹੋ ਕੇ ਝੂੰਮਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "सभ सुधि गई मत ह्वै झूँमा ॥",
      "sourceLineId": "132404",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਘਾਇ ਲਗੇ ਘਾਯਲ ਜਨੁ ਘੂੰਮਾ ॥",
      "transliteration": "ghai lage ghaayal jan ghoo(n)maa ||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਘਾਉ ਲਗਣ ਤੇ ਘਾਇਲ ਘੁੰਮਦਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "घाइ लगे घायल जनु घूँमा ॥",
      "sourceLineId": "132405",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਨ ਕੀ ਰਹੀ ਨ ਤਨਿਕ ਸੰਭਾਰਾ ॥",
      "transliteration": "tan kee rahee na tanik sa(n)bhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸ਼ਰੀਰ ਦੀ ਜ਼ਰਾ ਜਿੰਨੀ ਵੀ ਸੰਭਾਲ ਨਾ ਰਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "तन की रही न तनिक संभारा ॥",
      "sourceLineId": "132406",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਨੁ ਡਸਿ ਗਯੋ ਨਾਗ ਕੌਡਿਯਾਰਾ ॥੧੭॥",
      "transliteration": "jan ddas gayo naag kauaddiyaaraa ||17||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਕੌਡੀਆਂ ਵਾਲਾ ਸੱਪ ਡੰਗ ਗਿਆ ਹੋਵੇ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "जनु डसि गयो नाग कौडियारा ॥१७॥",
      "sourceLineId": "132407",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਕ ਦਿਨ ਕਰੀ ਸਾਹ ਮਿਜਮਾਨੀ ॥",
      "transliteration": "eik dhin karee saeh mijamaanee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਬਾਦਸ਼ਾਹ ਨੇ ਮਿਜਮਾਨੀ (ਪ੍ਰੀਤੀ-ਭੋਜਨ) ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "इक दिन करी साह मिजमानी ॥",
      "sourceLineId": "132408",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਭ ਪੁਰ ਨਾਰਿ ਧਾਮ ਮਹਿ ਆਨੀ ॥",
      "transliteration": "sabh pur naar dhaam meh aanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਗਰ ਦੀਆਂ ਸਾਰੀਆਂ ਇਸਤਰੀਆਂ ਨੂੰ ਮਹੱਲ ਵਿਚ ਲਿਆਂਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "सभ पुर नारि धाम महि आनी ॥",
      "sourceLineId": "132409",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਿਧ ਪਾਲ ਕੀ ਸੁਤਾ ਜਬਾਈ ॥",
      "transliteration": "sidh paal kee sutaa jabaiee ||",
      "translation": "",
      "punjabiViakhya": "ਸਿਧ ਪਾਲ ਦੀ ਪੁੱਤਰੀ ਜਦ ਆਈ, (ਤਾ ਇੰਜ ਪ੍ਰਤੀਤ ਹੋਇਆ)",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "सिध पाल की सुता जबाई ॥",
      "sourceLineId": "132410",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਕਲ ਦੀਪ ਜ੍ਯੋਂ ਸਭਾ ਸੁਹਾਈ ॥੧੮॥",
      "transliteration": "sakal dheep jayo(n) sabhaa suhaiee ||18||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸਾਰੀ ਸਭਾ ਵਿਚ ਦੀਪਕ ਸ਼ੁਭਾਇਮਾਨ ਹੋ ਗਿਆ ਹੋਵੇ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "सकल दीप ज्यों सभा सुहाई ॥१८॥",
      "sourceLineId": "132411",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਛਿਦ੍ਰ ਬੀਚ ਕਰਿ ਤਾਹਿ ਨਿਹਾਰਾ ॥",
      "transliteration": "chhidhr beech kar taeh nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਮੋਰੀ ਵਿਚੋਂ ਉਸ ਨੂੰ (ਬਾਦਸ਼ਾਹ ਨੇ) ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "छिद्र बीच करि ताहि निहारा ॥",
      "sourceLineId": "132412",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹਜਰਤਿ ਭਯੋ ਤਬੈ ਮਤਵਾਰਾ ॥",
      "transliteration": "hajarat bhayo tabai matavaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਹਜ਼ਰਤ ਮਤਵਾਲਾ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "हजरति भयो तबै मतवारा ॥",
      "sourceLineId": "132413",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਨ ਤਰੁਨੀ ਕੇ ਰੂਪ ਬਿਕਾਨ੍ਰਯੋ ॥",
      "transliteration": "man tarunee ke roop bikaanrayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਮਨ ਇਸਤਰੀ ਦੇ ਰੂਪ ਉਤੇ ਹੀ ਵਿਕ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "मन तरुनी के रूप बिकान्रयो ॥",
      "sourceLineId": "132414",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮ੍ਰਿਤਕ ਸੋ ਤਨੁ ਰਹਿਯੋ ਪਛਾਨ੍ਯੋ ॥੧੯॥",
      "transliteration": "mritak so tan rahiyo pachhaanayo ||19||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਇਹ) ਸਮਝੋ ਕਿ ਉਸ ਦਾ ਸ਼ਰੀਰ ਲੋਥ ਵਾਗ ਹੋ ਗਿਆ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "मृतक सो तनु रहियो पछान्यो ॥१९॥",
      "sourceLineId": "132415",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਹਜਰਤਿ ਸਕਲ ਪਠਾਨ ਬੁਲਾਏ ॥",
      "transliteration": "hajarat sakal paThaan bulaae ||",
      "translation": "",
      "punjabiViakhya": "ਹਜ਼ਰਤ ਨੇ ਸਾਰੇ ਪਠਾਣ ਬੁਲਾ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "हजरति सकल पठान बुलाए ॥",
      "sourceLineId": "132416",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਿਧ ਪਾਲ ਕੈ ਧਾਮ ਪਠਾਏ ॥",
      "transliteration": "sidh paal kai dhaam paThaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਿਧ ਪਾਲ ਦੇ ਘਰ ਭੇਜ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "सिध पाल कै धाम पठाए ॥",
      "sourceLineId": "132417",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕੈ ਅਪਨੀ ਦੁਹਿਤਾ ਮੁਹਿ ਦੀਜੈ ॥",
      "transliteration": "kai apanee dhuhitaa muh dheejai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਰਾਹੀਂ ਇਹ ਕਹਿ ਭੇਜਿਆ ਕਿ) ਜਾ ਤਾ ਆਪਣੀ ਪੁੱਤਰੀ ਮੈਨੂੰ ਦੇ ਦਿਓ,",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "कै अपनी दुहिता मुहि दीजै ॥",
      "sourceLineId": "132418",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਾਤਰ ਮੀਚ ਮੂੰਡ ਪਰ ਲੀਜੈ ॥੨੦॥",
      "transliteration": "naatar meech moo(n)dd par leejai ||20||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਮੌਤ ਸਿਰ ਉਤੇ ਆਈ ਸਮਝੋ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "नातर मीच मूँड पर लीजै ॥२०॥",
      "sourceLineId": "132419",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਕਲ ਪਠਾਨ ਤਵਨ ਕੇ ਗਏ ॥",
      "transliteration": "sakal paThaan tavan ke ge ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਪਠਾਣ ਉਸ ਦੇ (ਘਰ) ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "सकल पठान तवन के गए ॥",
      "sourceLineId": "132420",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹਜਰਤਿ ਕਹੀ ਸੁ ਭਾਖਤ ਭਏ ॥",
      "transliteration": "hajarat kahee su bhaakhat bhe ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਹਜ਼ਰਤ ਨੇ (ਗੱਲ) ਕਹੀ ਸੀ, ਉਹ ਕਹਿ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "हजरति कही सु भाखत भए ॥",
      "sourceLineId": "132421",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਿਧ ਪਾਲ ਧੰਨ ਭਾਗ ਤਿਹਾਰੇ ॥",
      "transliteration": "sidh paal dha(n)n bhaag tihaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਹੇ ਸਿਧ ਪਾਲ! ਤੇਰੇ ਧੰਨਭਾਗ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "सिध पाल धंन भाग तिहारे ॥",
      "sourceLineId": "132422",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗ੍ਰਿਹ ਆਵਹਿਗੇ ਸਾਹ ਸਵਾਰੇ ॥੨੧॥",
      "transliteration": "gireh aavahige saeh savaare ||21||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ) ਬਾਦਸ਼ਾਹ ਦੀ ਸਵਾਰੀ ਤੇਰੇ ਘਰ ਆਵੇਗੀ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "गृह आवहिगे साह सवारे ॥२१॥",
      "sourceLineId": "132423",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਿਧ ਪਾਲ ਐਸੋ ਜਬ ਸੁਨਾ ॥",
      "transliteration": "sidh paal aaiso jab sunaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਿਧ ਪਾਲ ਨੇ ਜਦ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "सिध पाल ऐसो जब सुना ॥",
      "sourceLineId": "132424",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਧਿਕ ਦੁਖਿਤ ਹ੍ਵੈ ਮਸਤਕ ਧੁਨਾ ॥",
      "transliteration": "adhik dhukhit havai masatak dhunaa ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਬਹੁਤ ਦੁਖੀ ਹੋ ਕੇ ਮੱਥੇ ਨੂੰ ਧੁਨਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "अधिक दुखित ह्वै मसतक धुना ॥",
      "sourceLineId": "132425",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੈਵ ਕਵਨ ਗਤਿ ਕਰੀ ਹਮਾਰੀ ॥",
      "transliteration": "dhaiv kavan gat karee hamaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਸੋਚਣ ਲਗਾ ਕਿ) ਪਰਮਾਤਮਾ ਨੇ ਮੇਰੀ ਕੀ ਹਾਲਤ ਕਰ ਦਿੱਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "दैव कवन गति करी हमारी ॥",
      "sourceLineId": "132426",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗ੍ਰਿਹ ਅਸਿ ਉਪਜੀ ਸੁਤਾ ਦੁਖਾਰੀ ॥੨੨॥",
      "transliteration": "gireh as upajee sutaa dhukhaaree ||22||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਘਰ ਅਜਿਹੀ ਦੁਖਦਾਇਕ ਪੁੱਤਰੀ ਪੈਦਾ ਹੋਈ ਹੈ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "गृह असि उपजी सुता दुखारी ॥२२॥",
      "sourceLineId": "132427",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜੌ ਨਹਿ ਦੇਤ ਤੁ ਬਿਗਰਤ ਕਾਜਾ ॥",
      "transliteration": "jau neh dhet ta bigarat kaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਨਹੀਂ ਦਿੰਦਾ ਤਾ ਕੰਮ ਵਿਗੜਦਾ ਹੈ (ਅਰਥਾਤ ਬਾਦਸ਼ਾਹ ਨਾਰਾਜ਼ ਹੁੰਦਾ ਹੈ)।",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "जौ नहि देत तु बिगरत काजा ॥",
      "sourceLineId": "132428",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਾਤ ਦਏ ਛਤ੍ਰਿਨ ਕੀ ਲਾਜਾ ॥",
      "transliteration": "jaat dhe chhatiran kee laajaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਦਿੰਦਾ ਹਾ ਤਾ ਛਤ੍ਰੀਆਂ ਨੂੰ ਲਾਜ ਲਗਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "जात दए छतृन की लाजा ॥",
      "sourceLineId": "132429",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮੁਗਲ ਪਠਾਨ ਤੁਰਕ ਘਰ ਮਾਹੀ ॥",
      "transliteration": "mugal paThaan turak ghar maahee ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ) ਮੁਗ਼ਲ, ਪਠਾਣ ਜਾ ਤੁਰਕ ਦੇ ਘਰ",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "मुगल पठान तुरक घर माही ॥",
      "sourceLineId": "132430",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਬ ਲਗਿ ਗੀ ਛਤ੍ਰਾਨੀ ਨਾਹੀ ॥੨੩॥",
      "transliteration": "ab lag gee chhatraanee naahee ||23||",
      "translation": "",
      "punjabiViakhya": "ਅਜੇ ਤਕ (ਕੋਈ) ਛਤ੍ਰਾਣੀ ਨਹੀਂ ਗਈ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "अब लगि गी छत्रानी नाही ॥२३॥",
      "sourceLineId": "132431",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਛਤ੍ਰਿਨ ਕੇ ਅਬ ਲਗੇ ਨ ਭਈ ॥",
      "transliteration": "chhatiran ke ab lage na bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਛਤ੍ਰੀਆਂ ਵਿਚ ਅਜੇ ਇਹ ਨਹੀਂ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "छतृन के अब लगे न भई ॥",
      "sourceLineId": "132432",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੁਹਿਤਾ ਕਾਢਿ ਤੁਰਕ ਕਹ ਦਈ ॥",
      "transliteration": "dhuhitaa kaadd turak keh dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੁਰਕਾ ਨੂੰ (ਘਰੋਂ) ਕਢ ਕੇ ਪੁੱਤਰੀ ਦਿੱਤੀ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "दुहिता काढि तुरक कह दई ॥",
      "sourceLineId": "132433",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰਜਪੂਤਨ ਕੇ ਹੋਤਹ ਆਈ ॥",
      "transliteration": "rajapootan ke hoteh aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਪੂਤਾ ਵਿਚ ਹੁੰਦਾ ਆਇਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "रजपूतन के होतह आई ॥",
      "sourceLineId": "132434",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪੁਤ੍ਰੀ ਧਾਮ ਮਲੇਛ ਪਠਾਈ ॥੨੪॥",
      "transliteration": "putree dhaam malechh paThaiee ||24||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਪੁੱਤਰੀਆਂ ਨੂੰ ਮਲੇਛਾ (ਦੇ ਘਰ) ਭੇਜਿਆ ਹੈ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "पुत्री धाम मलेछ पठाई ॥२४॥",
      "sourceLineId": "132435",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਹਾਡਨ ਏਕ ਦੂਸਰਨ ਖਤ੍ਰੀ ॥",
      "transliteration": "haaddan ek dhoosaran khatree ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ) ਇਨ੍ਰਹਾ ਇਕ ਹਾਡੀਆਂ ਅਤੇ ਦੂਜੇ ਛਤ੍ਰੀਆਂ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "हाडन एक दूसरन खत्री ॥",
      "sourceLineId": "132436",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤੁਰਕਨ ਕਹ ਇਨ ਦਈ ਨ ਪੁਤ੍ਰੀ ॥",
      "transliteration": "turakan keh in dhiee na putree ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਰਕਾ ਨੂੰ ਕਦੇ ਆਪਣੀ ਪੁੱਤਰੀ ਨਹੀਂ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "तुरकन कह इन दई न पुत्री ॥",
      "sourceLineId": "132437",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜੋ ਛਤ੍ਰੀ ਅਸ ਕਰਮ ਕਮਾਵੈ ॥",
      "transliteration": "jo chhatree as karam kamaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਛਤ੍ਰੀ ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਕਰਮ ਕਰਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "जो छत्री अस करम कमावै ॥",
      "sourceLineId": "132438",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕੁੰਭੀ ਨਰਕ ਦੇਹ ਜੁਤ ਜਾਵੈ ॥੨੫॥",
      "transliteration": "ku(n)bhee narak dheh jut jaavai ||25||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ) ਉਹ ਦੇਹ ਸਹਿਤ ਕੁੰਭੀ ਨਰਕ ਵਿਚ ਜਾਦਾ ਹੈ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "कुँभी नरक देह जुत जावै ॥२५॥",
      "sourceLineId": "132439",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜੋ ਨਰ ਤੁਰਕਹਿ ਦੇਤ ਦੁਲਾਰੀ ॥",
      "transliteration": "jo nar turakeh dhet dhulaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਪੁਰਸ਼ ਤੁਰਕਾ ਨੂੰ ਧੀ ਦਿੰਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "जो नर तुरकहि देत दुलारी ॥",
      "sourceLineId": "132440",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਧ੍ਰਿਗ ਧ੍ਰਿਗ ਜਗ ਤਿਹ ਕਰਤ ਉਚਾਰੀ ॥",
      "transliteration": "dhirag dhirag jag teh karat uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜਗਤ 'ਧ੍ਰਿਗ ਧ੍ਰਿਗ' ਕਹਿੰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "धृग धृग जग तिह करत उचारी ॥",
      "sourceLineId": "132441",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1239_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਲੋਕ ਪ੍ਰਲੋਕ ਤਾਹਿ ਕੋ ਜੈਹੈ ॥",
      "transliteration": "lok pralok taeh ko jaihai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਛਤ੍ਰੀ) ਦਾ ਲੋਕ ਪਰਲੋਕ (ਦੋਵੇਾਂ) ਜਾਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1239,
      "hindi": "",
      "hindiTransliteration": "लोक प्रलोक ताहि को जैहै ॥",
      "sourceLineId": "132442",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
