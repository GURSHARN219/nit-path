{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1240,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1240_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਛਤ੍ਰੀ ਸੁਤਾ ਤੁਰਕ ਕਹ ਦੈਹੈ ॥੨੬॥",
      "transliteration": "chhatree sutaa turak keh dhaihai ||26||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਛਤ੍ਰੀ ਤੁਰਕ ਨੂੰ (ਆਪਣੀ) ਪੁੱਤਰੀ ਦੇਵੇਗਾ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "छत्री सुता तुरक कह दैहै ॥२६॥",
      "sourceLineId": "132443",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਹਾਡਿਯਨ ਸੁਤਾ ਤੁਰਕਿ ਨਹਿ ਦਈ ॥",
      "transliteration": "haaddiyan sutaa turak neh dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਡੀਆਂ ਨੇ (ਅਜੇ ਤਕ) ਤੁਰਕਾ ਨੂੰ ਪੁੱਤਰੀ ਨਹੀਂ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "हाडियन सुता तुरकि नहि दई ॥",
      "sourceLineId": "132444",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਛਤ੍ਰਾਨੀ ਤੁਰਕਨੀ ਨ ਭਈ ॥",
      "transliteration": "chhatraanee turakanee na bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਕੋਈ) ਛਤ੍ਰਾਣੀ ਤੁਰਕਣੀ ਨਹੀਂ ਹੋਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "छत्रानी तुरकनी न भई ॥",
      "sourceLineId": "132445",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਛ ਰਜਪੂਤਨ ਲਾਜ ਗਵਾਈ ॥",
      "transliteration": "kachh rajapootan laaj gavaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਝ ਰਾਜਪੂਤਾ ਨੇ ਲਾਜ ਗਵਾਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "कछ रजपूतन लाज गवाई ॥",
      "sourceLineId": "132446",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰਾਨੀ ਤੇ ਬੇਗਮਾ ਕਹਾਈ ॥੨੭॥",
      "transliteration": "raanee te begamaa kahaiee ||27||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਨ੍ਰਹਾ ਦੀਆਂ ਇਸਤਰੀਆਂ) ਰਾਣੀਆਂ ਤੋਂ ਬੇਗਮਾ ਅਖਵਾਈਆਂ ਹਨ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "रानी ते बेगमा कहाई ॥२७॥",
      "sourceLineId": "132447",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਬ ਮੈ ਧਰੈ ਇਹੌ ਨਿਜੁ ਬੁਧਾ ॥",
      "transliteration": "ab mai dharai ihau nij budhaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੇਰੀ ਬੁੱਧੀ ਵਿਚ ਇਹ ਗੱਲ ਆਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "अब मै धरै इहौ निजु बुधा ॥",
      "sourceLineId": "132448",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮੰਡੌ ਬੀਰ ਖੇਤ ਮਹਿ ਕ੍ਰੁਧਾ ॥",
      "transliteration": "ma(n)ddau beer khet meh krudhaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਸੂਰਮੇ ਵਾਗ ਰਣਖੇਤਰ ਵਿਚ ਯੁੱਧ ਮਚਾਵਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "मंडौ बीर खेत महि क्रुधा ॥",
      "sourceLineId": "132449",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪਹਿਰਿ ਕੌਚ ਕਰਿ ਖੜਗ ਸੰਭਾਰੌਂ ॥",
      "transliteration": "pahir kauach kar khaRag sa(n)bhaaraua(n) ||",
      "translation": "",
      "punjabiViakhya": "ਕਵਚ ਪਾ ਕੇ ਖੜਗ ਸੰਭਾਲਾ",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "पहिरि कौच करि खड़ग संभारौं ॥",
      "sourceLineId": "132450",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਚੁਨਿ ਚੁਨਿ ਆਜੁ ਪਖਰਿਯਾ ਮਾਰੌਂ ॥੨੮॥",
      "transliteration": "chun chun aaj pakhariyaa maaraua(n) ||28||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੁਣ ਚੁਣ ਕੇ ਘੋੜ ਸਵਾਰਾ ਨੂੰ ਮਾਰਾ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "चुनि चुनि आजु पखरिया मारौं ॥२८॥",
      "sourceLineId": "132451",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਬ ਕੰਨ੍ਯਾ ਨਿਜੁ ਪਿਤਾ ਹਕਾਰਾ ॥",
      "transliteration": "tab ka(n)nayaa nij pitaa hakaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਆਪਣੀ ਪੁੱਤਰੀ ਨੂੰ ਪਿਤਾ ਨੇ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "तब कंन्या निजु पिता हकारा ॥",
      "sourceLineId": "132452",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਤਾ ਸੌ ਮੰਤ੍ਰ ਉਚਾਰਾ ॥",
      "transliteration": "eeh bidh taa sau ma(n)tr uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਤਰ੍ਰਹਾ ਉਸ ਨਾਲ ਵਿਚਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "इह बिधि ता सौ मंत्र उचारा ॥",
      "sourceLineId": "132453",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਾਤ ਤਨਿਕ ਚਿੰਤਾ ਨਹਿ ਕਰੀਯੈ ॥",
      "transliteration": "taat tanik chi(n)taa neh kareeyai ||",
      "translation": "",
      "punjabiViakhya": "(ਪੁੱਤਰੀ ਨੇ ਉੱਤਰ ਦਿੱਤਾ) ਹੇ ਪਿਤਾ ਜੀ! ਜ਼ਰਾ ਜਿੰਨੀ ਵੀ ਚਿੰਤਾ ਨਾ ਕਰੋ",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "तात तनिक चिंता नहि करीयै ॥",
      "sourceLineId": "132454",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਨਮੁਖ ਪਾਤਿਸਾਹ ਸੌ ਲਰੀਯੈ ॥੨੯॥",
      "transliteration": "sanamukh paatisaeh sau lareeyai ||29||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਨਮੁਖ ਹੋ ਕੇ ਬਾਦਸ਼ਾਹ ਨਾਲ ਲੜੋ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "सनमुख पातिसाह सौ लरीयै ॥२९॥",
      "sourceLineId": "132455",
      "sourceShabadId": "12496",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "132456",
      "sourceShabadId": "12497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬੋਲ ਸਦਾ ਥਿਰ ਰਹੈ ਦਿਵਸਰੇ ਜਾਇ ਹੈ ॥",
      "transliteration": "bol sadhaa thir rahai dhivasare jai hai ||",
      "translation": "",
      "punjabiViakhya": "ਦਿਨ ਬੀਤ ਜਾਦੇ ਹਨ, ਪਰ ਬੋਲ ਸਦਾ ਕਾਇਮ ਰਹਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "बोल सदा थिर रहै दिवसरे जाइ है ॥",
      "sourceLineId": "132457",
      "sourceShabadId": "12497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਰੇ ਕਰਮ ਛਤ੍ਰਿਨ ਕੇ ਚਾਰਣ ਗਾਇ ਹੈ ॥",
      "transliteration": "kare karam chhatiran ke chaaran gai hai ||",
      "translation": "",
      "punjabiViakhya": "ਛਤ੍ਰੀਆਂ ਵਾਲੇ ਕੀਤੇ ਕਰਮਾ ਨੂੰ ਚਾਰਣ (ਭਾਟ) ਲੋਕ ਗਾਉਾਂਦੇ ਰਹਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "करे करम छतृन के चारण गाइ है ॥",
      "sourceLineId": "132458",
      "sourceShabadId": "12497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਾਤ ਨ ਮੋ ਕੋ ਦੀਜੈ ਆਹਵ ਕੀਜਿਯੈ ॥",
      "transliteration": "taat na mo ko dheejai aahav keejiyai ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਿਤਾ ਜੀ! ਮੈਨੂੰ (ਤੁਰਕਾ ਨੂੰ) ਨਾ ਦਿਓ ਅਤੇ ਯੁੱਧ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "तात न मो को दीजै आहव कीजियै ॥",
      "sourceLineId": "132459",
      "sourceShabadId": "12497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਹੋ ਦਾਨ ਕ੍ਰਿਪਾਨ ਦੁਹੂੰ ਜਗ ਮੈ ਜਸ ਲੀਜਿਯੈ ॥੩੦॥",
      "transliteration": "ho dhaan kirapaan dhuhoo(n) jag mai jas leejiyai ||30||",
      "translation": "",
      "punjabiViakhya": "ਦਾਨ ਕਰਨਾ ਅਤੇ ਕ੍ਰਿਪਾਨ ਚਲਾਉਣਾ ਦੋਵੇਾਂ ਕਾਰਜ ਕਰ ਕੇ ਜਗ ਵਿਚ ਜਸ ਖਟੋ (ਅਰਥਾਤਰ- ਕ੍ਰਿਪਾਨ ਦਾ ਦਾਨ ਕਰ ਕੇ ਦੋਹਾ ਲੋਕਾ ਵਿਚ ਜਸ ਲਵੋ।)॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "हो दान कृपान दुहूँ जग मै जस लीजियै ॥३०॥",
      "sourceLineId": "132460",
      "sourceShabadId": "12497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਖੜਗ ਹਾਥ ਜਿਨਿ ਤਜਹੁ ਖੜਗਧਾਰਾ ਸਹੋ ॥",
      "transliteration": "khaRag haath jin tajahu khaRagadhaaraa saho ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰ ਨੂੰ ਹੱਥ ਵਿਚੋਂ ਨਾ ਛਡੋ ਅਤੇ ਖੜਗ ਦੀ ਧਾਰ ਨੂੰ ਸਹਿਣ (ਦੀ ਹਿੰਮਤ ਰਖੋ)।",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "खड़ग हाथ जिनि तजहु खड़गधारा सहो ॥",
      "sourceLineId": "132461",
      "sourceShabadId": "12497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਭਾਜਿ ਨ ਚਲਿਯਹੁ ਤਾਤ ਮੰਡਿ ਰਨ ਕੌ ਰਹੋ ॥",
      "transliteration": "bhaaj na chaliyahu taat ma(n)dd ran kau raho ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਿਤਾ ਜੀ! ਯੁੱਧ ਨੂੰ ਆਰੰਭ ਕਰ ਕੇ ਡਟੇ ਰਹੋ ਅਤੇ ਭਜ ਕੇ ਨਾ ਜਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "भाजि न चलियहु तात मंडि रन कौ रहो ॥",
      "sourceLineId": "132462",
      "sourceShabadId": "12497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪਠੇ ਪਖਰਿਯਾ ਹਨਿਯਹੁ ਬਿਸਿਖ ਪ੍ਰਹਾਰ ਕਰਿ ॥",
      "transliteration": "paThe pakhariyaa haniyahu bisikh prahaar kar ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰਾ ਦੇ ਵਾਰ ਕਰ ਕੇ ਜਵਾਨ ਘੋੜ ਸਵਾਰਾ ਨੂੰ ਮਾਰ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "पठे पखरिया हनियहु बिसिख प्रहार करि ॥",
      "sourceLineId": "132463",
      "sourceShabadId": "12497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਹੋ ਮਾਰਿ ਅਰਿਨ ਕੌ ਮਰਿਯਹੁ ਹਮਹਿ ਸੰਘਾਰਿ ਕਰਿ ॥੩੧॥",
      "transliteration": "ho maar arin kau mariyahu hameh sa(n)ghaar kar ||31||",
      "translation": "",
      "punjabiViakhya": "ਵੈਰੀਆਂ ਨੂੰ ਮਾਰ ਕੇ ਅਤੇ (ਫਿਰ) ਮੈਨੂੰ ਸੰਘਾਰ ਕੇ ਆਪ ਵੀ ਮਰ ਜਾਓ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "हो मारि अरिन कौ मरियहु हमहि संघारि करि ॥३१॥",
      "sourceLineId": "132464",
      "sourceShabadId": "12497",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "132465",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੁਨਹੁ ਪਿਤਾ ਇਕ ਕਰਹੁ ਉਪਾਈ ॥",
      "transliteration": "sunahu pitaa ik karahu upaiee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਿਤਾ ਜੀ! ਸੁਣੋ, (ਮੈਂ) ਇਕ ਉਪਾ ਕਰਦੀ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "सुनहु पिता इक करहु उपाई ॥",
      "sourceLineId": "132466",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਮਸਦੀਨ ਕਹ ਲੇਹੁ ਬੁਲਾਈ ॥",
      "transliteration": "samasadheen keh leh bulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਮਸਦੀਨ ਨੂੰ ਬੁਲਾ ਲੈਂਦੀ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "समसदीन कह लेहु बुलाई ॥",
      "sourceLineId": "132467",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਬ ਆਵੇ ਤਬ ਪਕਰਿ ਸੰਘਰਿਯਹੁ ॥",
      "transliteration": "jab aave tab pakar sa(n)ghariyahu ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਉਹ) ਆਵੇ ਤਦ ਪਕੜ ਕੇ ਮਾਰ ਦੇਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "जब आवे तब पकरि संघरियहु ॥",
      "sourceLineId": "132468",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਹੁਰੌ ਨਿਕਸਿ ਜੁਧ ਕੌ ਕਰਿਯਹੁ ॥੩੨॥",
      "transliteration": "bahurau nikas judh kau kariyahu ||32||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਨਿਕਲ ਕੇ (ਵੈਰੀ ਨਾਲ) ਯੁੱਧ ਕਰਨਾ ॥੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "बहुरौ निकसि जुध कौ करियहु ॥३२॥",
      "sourceLineId": "132469",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਿਧ ਪਾਲ ਤਬ ਐਸ ਬਿਚਾਰੀ ॥",
      "transliteration": "sidh paal tab aais bichaaree ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਸਿਧ ਪਾਲ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਵਿਚਾਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "सिध पाल तब ऐस बिचारी ॥",
      "sourceLineId": "132470",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭਲੀ ਬਾਤ ਇਨ ਸੁਤਾ ਉਚਾਰੀ ॥",
      "transliteration": "bhalee baat in sutaa uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਬੇਟੀ ਨੇ ਚੰਗੀ ਗੱਲ ਦਸੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "भली बात इन सुता उचारी ॥",
      "sourceLineId": "132471",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅੰਤਹਪੁਰ ਤੇ ਬਾਹਿਰ ਆਯੋ ॥",
      "transliteration": "a(n)tahapur te baahir aayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰਣਵਾਸ ਤੋਂ ਬਾਹਰ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "अंतहपुर ते बाहिर आयो ॥",
      "sourceLineId": "132472",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬੋਲਿ ਪਠਾਨਨ ਐਸ ਜਤਾਯੋ ॥੩੩॥",
      "transliteration": "bol paThaanan aais jataayo ||33||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਠਾਣਾ ਨੂੰ ਬੁਲਾ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਸਮਝਾਇਆ ॥੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "बोलि पठानन ऐस जतायो ॥३३॥",
      "sourceLineId": "132473",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਏ ਹੈ ਪ੍ਰਭੁ ਕੇ ਬਡੇ ਬਨਾਏ ॥",
      "transliteration": "e hai prabh ke badde banaae ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ (ਬਾਦਸ਼ਾਹ ਲੋਗ) ਪ੍ਰਭੂ ਦੇ ਬਣਾਏ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "ए है प्रभु के बडे बनाए ॥",
      "sourceLineId": "132474",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਮ ਤੁਮ ਸੇ ਇਨ ਕੇ ਪਗ ਲਾਏ ॥",
      "transliteration": "ham tum se in ke pag laae ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਡੇ ਤੁਹਾਡੇ ਵਰਗੇ ਇਨ੍ਰਹਾ ਦੇ ਪੈਰੀਂ ਲਗਾਏ ਹੋਏ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "हम तुम से इन के पग लाए ॥",
      "sourceLineId": "132475",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜੋ ਇਨ ਕਹਾ ਵਹੈ ਮਨ ਮਾਨਾ ॥",
      "transliteration": "jo in kahaa vahai man maanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਇਨ੍ਰਹਾ ਨੇ ਕਿਹਾ ਹੈ, ਉਹੀ ਮਨ ਵਿਚ ਮੰਨਦਾ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "जो इन कहा वहै मन माना ॥",
      "sourceLineId": "132476",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਿਰ ਪਰ ਹੁਕਮ ਸਾਹ ਕੋ ਆਨਾ ॥੩੪॥",
      "transliteration": "sir par hukam saeh ko aanaa ||34||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਾਦਸ਼ਾਹ ਦੇ ਹੁਕਮ ਨੂੰ ਸਿਰ ਮੱਥੇ ਉਤੇ ਲੈਂਦਾ ਹਾ ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "सिर पर हुकम साह को आना ॥३४॥",
      "sourceLineId": "132477",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਬ ਮਿਲਿ ਖਾਨ ਸਾਹ ਕੇ ਗਏ ॥",
      "transliteration": "tab mil khaan saeh ke ge ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਪਠਾਣ ਮਿਲ ਕੇ ਬਾਦਸ਼ਾਹ ਕੋਲ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "तब मिलि खान साह के गए ॥",
      "sourceLineId": "132478",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਤਿ ਹੀ ਹ੍ਰਿਦੈ ਅਨੰਦਿਤ ਭਏ ॥",
      "transliteration": "at hee hiradhai ana(n)dhit bhe ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹਿਰਦੇ ਵਿਚ ਬਹੁਤ ਪ੍ਰਸੰਨ ਹੋਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "अति ही हृदै अनंदित भए ॥",
      "sourceLineId": "132479",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤੁਰਕਹਿ ਛਤ੍ਰਿਨ ਸੁਤਾ ਨ ਦਈ ॥",
      "transliteration": "turakeh chhatiran sutaa na dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਰਕਾ ਨੂੰ ਛਤ੍ਰੀਆਂ ਨੇ ਕਦੇ ਪੁੱਤਰੀ ਨਹੀਂ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "तुरकहि छतृन सुता न दई ॥",
      "sourceLineId": "132480",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹਸਿ ਹੈ ਇਨੈ ਭਲੀ ਇਹ ਭਈ ॥੩੫॥",
      "transliteration": "has hai inai bhalee ieh bhiee ||35||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਨੇ ਪ੍ਰਸੰਨਤਾ ਨਾਲ (ਗੱਲ ਮੰਨ ਲਈ, ਇਸ ਲਈ) ਇਹ ਚੰਗਾ ਹੀ ਹੋਇਆ। (ਅਰਥਾਤਰ-ਇਹ ਚੰਗੀ ਗੱਲ ਹੋਈ, ਹੁਣ ਅਸੀਂ ਇਨ੍ਰਹਾ ਦੀ ਹਾਸੀ ਕਰਾਗੇ) ॥੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "हसि है इनै भली इह भई ॥३५॥",
      "sourceLineId": "132481",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੁਹਿਤਾ ਇਤੈ ਪਿਤਹਿ ਸਮੁਝਾਵੈ ॥",
      "transliteration": "dhuhitaa itai piteh samujhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਧਰ ਪੁੱਤਰੀ ਪਿਤਾ ਨੂੰ ਸਮਝਾਣ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "दुहिता इतै पितहि समुझावै ॥",
      "sourceLineId": "132482",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਛਤ੍ਰੀ ਜਨਮੁ ਫੇਰਿ ਨਹਿ ਆਵੈ ॥",
      "transliteration": "chhatree janam fer neh aavai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਛਤ੍ਰੀ ਜਨਮ ਫਿਰ ਨਹੀਂ ਮਿਲਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "छत्री जनमु फेरि नहि आवै ॥",
      "sourceLineId": "132483",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਬ ਲੌ ਐਸੀ ਬਾਤ ਨ ਪਈ ॥",
      "transliteration": "ab lau aaisee baat na piee ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਤਕ ਅਜਿਹੀ ਗੱਲ ਨਹੀਂ ਹੋਈ",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "अब लौ ऐसी बात न पई ॥",
      "sourceLineId": "132484",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤੁਰਕਨ ਕੇ ਛਤ੍ਰਾਨੀ ਗਈ ॥੩੬॥",
      "transliteration": "turakan ke chhatraanee giee ||36||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੁਰਕਾ ਦੇ (ਘਰ) ਛਤ੍ਰਾਣੀ ਗਈ ਹੋਵੇ ॥੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "तुरकन के छत्रानी गई ॥३६॥",
      "sourceLineId": "132485",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਾ ਤੇ ਮੋਹਿ ਨ ਦੀਜੈ ਤਾਤਾ ॥",
      "transliteration": "taa te moh na dheejai taataa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਹੇ ਪਿਤਾ ਜੀ! ਮੈਨੂੰ (ਬਾਦਸ਼ਾਹ ਦੇ ਹਵਾਲੇ) ਨਾ ਕਰੋ",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "ता ते मोहि न दीजै ताता ॥",
      "sourceLineId": "132486",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮੰਡਹੁ ਜੁਧ ਹੋਤ ਹੀ ਪ੍ਰਾਤਾ ॥",
      "transliteration": "ma(n)ddahu judh hot hee praataa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਵੇਰ ਹੁੰਦਿਆਂ ਹੀ ਯੁੱਧ ਰਚਾ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "मंडहु जुध होत ही प्राता ॥",
      "sourceLineId": "132487",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚਲਿ ਹੈ ਕਥਾ ਸਦਾ ਜਗ ਮਾਹੀ ॥",
      "transliteration": "chal hai kathaa sadhaa jag maahee ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਕਥਾ ਸਦਾ ਜਗ ਵਿਚ ਚਲੇਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "चलि है कथा सदा जग माही ॥",
      "sourceLineId": "132488",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪ੍ਰਾਤ ਪਠਾਨ ਕਿ ਛਤ੍ਰੀ ਨਾਹੀ ॥੩੭॥",
      "transliteration": "praat paThaan k chhatree naahee ||37||",
      "translation": "",
      "punjabiViakhya": "ਸਵੇਰ ਹੋਣ ਤੇ ਜਾ ਪਠਾਣ ਨਹੀਂ ਹੋਣਗੇ ਜਾ ਛਤ੍ਰੀ ਨਹੀਂ ਹੋਣਗੇ ॥੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "प्रात पठान कि छत्री नाही ॥३७॥",
      "sourceLineId": "132489",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1240_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪਹਿਰਹੁ ਕੌਚ ਬਜਾਇ ਨਗਾਰੇ ॥",
      "transliteration": "pahirahu kauach bajai nagaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਵਚ ਪਾ ਕੇ ਨਗਾਰੇ ਵਜਾਓ",
      "source": "DASAM_GRANTH",
      "ang": 1240,
      "hindi": "",
      "hindiTransliteration": "पहिरहु कौच बजाइ नगारे ॥",
