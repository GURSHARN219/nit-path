{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1241,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1241_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪੀ ਪੀ ਅਮਲ ਹੋਹੁ ਮਤਵਾਰੇ ॥",
      "transliteration": "pee pee amal hoh matavaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਮਲ ਪੀ ਪੀ ਕੇ ਮਤਵਾਲੇ ਹੋ ਜਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "पी पी अमल होहु मतवारे ॥",
      "sourceLineId": "132491",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪ੍ਰਾਤ ਮਚਤ ਹੈ ਜੁਧ ਅਪਾਰਾ ॥",
      "transliteration": "praat machat hai judh apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੇਰ ਵੇਲੇ ਅਪਾਰ ਯੁੱਧ ਮਚੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "प्रात मचत है जुध अपारा ॥",
      "sourceLineId": "132492",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹ੍ਵੈ ਹੈ ਅੰਧ ਧੁੰਧ ਬਿਕਰਾਰਾ ॥੩੮॥",
      "transliteration": "havai hai a(n)dh dhu(n)dh bikaraaraa ||38||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਅੰਨ੍ਰਹੇ ਵਾਹ ਭਿਆਨਕ ਰੂਪ ਵਿਚ ਹੋਵੇਗਾ ॥੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "ह्वै है अंध धुँध बिकरारा ॥३८॥",
      "sourceLineId": "132493",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਾਤਿਸਾਹ ਸੰਗ ਹੈ ਸੰਗ੍ਰਾਮਾ ॥",
      "transliteration": "paatisaeh sa(n)g hai sa(n)graamaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਦਸ਼ਾਹ ਨਾਲ ਯੁੱਧ ਹੋਵੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "पातिसाह संग है संग्रामा ॥",
      "sourceLineId": "132494",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਭ ਹੀ ਕਰਹੁ ਕੇਸਰੀ ਜਾਮਾ ॥",
      "transliteration": "sabh hee karahu kesaree jaamaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਸਾਰੇ ਕੇਸਰੀ ਬਾਣੇ ਧਾਰ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "सभ ही करहु केसरी जामा ॥",
      "sourceLineId": "132495",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਟਾਕਿ ਆਫੂਐ ਤੁਰੈ ਨਚਾਵੌ ॥",
      "transliteration": "Taak aafooaai turai nachaavau ||",
      "translation": "",
      "punjabiViakhya": "ਅਫ਼ੀਮ ਨੂੰ ਖਾ ਕੇ ਘੋੜਿਆਂ ਨੂੰ ਨਚਾਓ",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "टाकि आफूऐ तुरै नचावौ ॥",
      "sourceLineId": "132496",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਾਗ ਝਲਕਤੀ ਹਾਥ ਫਿਰਾਵੌ ॥੩੯॥",
      "transliteration": "saag jhalakatee haath firaavau ||39||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਝਲਕਦੀਆਂ ਹੋਈਆਂ ਬਰਛੀਆਂ ਹੱਥ ਵਿਚ ਘੁਮਾਓ ॥੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "साग झलकती हाथ फिरावौ ॥३९॥",
      "sourceLineId": "132497",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪ੍ਰਥਮ ਤ੍ਯਾਗਿ ਪ੍ਰਾਨਨ ਕੀ ਆਸਾ ॥",
      "transliteration": "pratham tayaag praanan kee aasaa ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਪ੍ਰਾਣਾ ਦੀ ਆਸ ਛਡ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "प्रथम त्यागि प्रानन की आसा ॥",
      "sourceLineId": "132498",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਾਹਹੁ ਖੜਗ ਸਕਲ ਤਜਿ ਤ੍ਰਾਸਾ ॥",
      "transliteration": "baahahu khaRag sakal taj traasaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਾ ਡਰ ਛਡ ਕੇ ਤਲਵਾਰ ਚਲਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "बाहहु खड़ग सकल तजि त्रासा ॥",
      "sourceLineId": "132499",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪੋਸਤ ਭਾਗ ਅਫੀਮ ਚੜਾਵੋ ॥",
      "transliteration": "posat bhaag afeem chaRaavo ||",
      "translation": "",
      "punjabiViakhya": "ਪੋਸਤ, ਭੰਗ ਅਤੇ ਅਫ਼ੀਮ ਚੜ੍ਰਹਾਓ",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "पोसत भाग अफीम चड़ावो ॥",
      "sourceLineId": "132500",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰੇਤੀ ਮਾਝ ਚਰਿਤ੍ਰ ਦਿਖਾਵੋ ॥੪੦॥",
      "transliteration": "retee maajh charitr dhikhaavo ||40||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰੇਤਲੀ ਧਰਤੀ ਵਿਚ (ਆਪਣੇ) ਚਰਿਤ੍ਰ ਵਿਖਾਓ ॥੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "रेती माझ चरित्र दिखावो ॥४०॥",
      "sourceLineId": "132501",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਜਰਤਿ ਜੋਰਿ ਤਹਾ ਦਲ ਆਯੋ ॥",
      "transliteration": "hajarat jor tahaa dhal aayo ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਦਸ਼ਾਹ ਫ਼ੌਜ ਜੋੜ ਕੇ ਉਥੇ ਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "हजरति जोरि तहा दल आयो ॥",
      "sourceLineId": "132502",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਕਲ ਬ੍ਯਾਹ ਕੋ ਸਾਜ ਬਨਾਯੋ ॥",
      "transliteration": "sakal bayaeh ko saaj banaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵਿਆਹ ਦਾ ਸਾਰਾ ਸਾਜ ਬਣਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "सकल ब्याह को साज बनायो ॥",
      "sourceLineId": "132503",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਿਧ ਪਾਲ ਕੇ ਜਬ ਘਰਿ ਆਏ ॥",
      "transliteration": "sidh paal ke jab ghar aae ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵੇਲੇ (ਉਹ ਸਾਰੇ) ਸਿਧ ਪਾਲ ਦੇ ਘਰ ਆਏ",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "सिध पाल के जब घरि आए ॥",
      "sourceLineId": "132504",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪੁਨਿ ਕੰਨ੍ਯਾ ਅਸ ਬਚਨ ਸੁਨਾਏ ॥੪੧॥",
      "transliteration": "pun ka(n)nayaa as bachan sunaae ||41||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਕੰਨਿਆਂ ਨੇ ਫਿਰ ਇਸ ਤਰ੍ਰਹਾ ਬੋਲ ਸੁਣਾਏ ॥੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "पुनि कंन्या अस बचन सुनाए ॥४१॥",
      "sourceLineId": "132505",
      "sourceShabadId": "12498",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "132506",
      "sourceShabadId": "12499",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗ੍ਰਿਹ ਆਵੈ ਜੋ ਸਤ੍ਰੁ ਨ ਤਾਹਿ ਸੰਘਾਰਿਯੈ ॥",
      "transliteration": "gireh aavai jo satr na taeh sa(n)ghaariyai ||",
      "translation": "",
      "punjabiViakhya": "ਘਰ ਵਿਚ ਜੇ ਵੈਰੀ ਵੀ ਆਵੇ, ਤਾ ਉਸ ਨੂੰ ਵੀ ਨਹੀਂ ਮਾਰਨਾ ਚਾਹੀਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "गृह आवै जो सत्रु न ताहि संघारियै ॥",
      "sourceLineId": "132507",
      "sourceShabadId": "12499",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਧਾਮ ਗਏ ਇਹੁ ਮਾਰਹੁ ਮੰਤ੍ਰ ਬਿਚਾਰਿਯੈ ॥",
      "transliteration": "dhaam ge ih maarahu ma(n)tr bichaariyai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਇਹ ਸਲਾਹ ਕੀਤੀ ਕਿ ਘਰ ਜਾਣ 'ਤੇ ਇਸ ਨੂੰ ਮਾਰਨਾ ਚਾਹੀਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "धाम गए इहु मारहु मंत्र बिचारियै ॥",
      "sourceLineId": "132508",
      "sourceShabadId": "12499",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਲਛਿਮਨ ਪੁਤ੍ਰਹਿ ਡਾਰਿ ਡੋਰਿ ਦਿਯ ਤ੍ਰਿਯ ਉਚਰਿ ॥",
      "transliteration": "lachhiman putreh ddaar ddor dhiy tiray uchar ||",
      "translation": "",
      "punjabiViakhya": "ਲੱਛਮਣ ਨਾ ਦੇ ਪੁੱਤਰ ਨੂੰ ਇਸਤਰੀ ਕਹਿ ਕੇ ਡੋਲੀ ਵਿਚ ਬਿਠਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "लछिमन पुत्रहि डारि डोरि दिय तृय उचरि ॥",
      "sourceLineId": "132509",
      "sourceShabadId": "12499",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹੋ ਸੰਗ ਸਤ ਸੈ ਖਤਿਰੇਟਾ ਗਯੋ ਤ੍ਰਿਯ ਭੇਸ ਧਰਿ ॥੪੨॥",
      "transliteration": "ho sa(n)g sat sai khatireTaa gayo tiray bhes dhar ||42||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਸੱਤ ਸੌ ਛਤ੍ਰੀ ਸੂਰਮੇ ਇਸਤਰੀਆਂ ਦੇ ਭੇਸ ਵਿਚ ਗਏ ॥੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "हो संग सत सै खतिरेटा गयो तृय भेस धरि ॥४२॥",
      "sourceLineId": "132510",
      "sourceShabadId": "12499",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "132511",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਬ ਤੇ ਜਾਤ ਧਾਮ ਤੇ ਭਏ ॥",
      "transliteration": "jab te jaat dhaam te bhe ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਘਰ ਤੋਂ ਚਲੇ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "जब ते जात धाम ते भए ॥",
      "sourceLineId": "132512",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਬ ਤਾ ਕੇ ਮੰਦਰ ਮੋ ਅਏ ॥",
      "transliteration": "tab taa ke ma(n)dhar mo ae ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਦੇ ਮਹਲ ਵਿਚ ਆ ਪਹੁੰਚੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "तब ता के मंदर मो अए ॥",
      "sourceLineId": "132513",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਲੁਬਧਮਾਨ ਹ੍ਵੈ ਹਾਥ ਚਲਾਯੋ ॥",
      "transliteration": "lubadhamaan havai haath chalaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਬਾਦਸ਼ਾਹ ਨੇ ਪਿਆਰ ਦੇ ਲੋਰ ਵਿਚ ਆ ਕੇ ਹੱਥ ਵਧਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "लुबधमान ह्वै हाथ चलायो ॥",
      "sourceLineId": "132514",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਲਛਿਮਨ ਕਾਢਿ ਕਟਾਰੀ ਘਾਯੋ ॥੪੩॥",
      "transliteration": "lachhiman kaadd kaTaaree ghaayo ||43||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲੱਛਮਣ ਨੇ ਕਟਾਰ ਕਢ ਕੇ ਮਾਰ ਦਿੱਤਾ ॥੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "लछिमन काढि कटारी घायो ॥४३॥",
      "sourceLineId": "132515",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਾਕਹ ਐਸ ਕਟਾਰੀ ਮਾਰਾ ॥",
      "transliteration": "taakeh aais kaTaaree maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਅਜਿਹੀ ਕਟਾਰ ਮਾਰੀ",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "ताकह ऐस कटारी मारा ॥",
      "sourceLineId": "132516",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਹੁਰਿ ਨ ਹਜਰਤਿ ਬੈਨ ਉਚਾਰਾ ॥",
      "transliteration": "bahur na hajarat bain uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਫਿਰ ਬਾਦਸ਼ਾਹ (ਮੂੰਹੋਂ) ਬੋਲ ਹੀ ਨਾ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "बहुरि न हजरति बैन उचारा ॥",
      "sourceLineId": "132517",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਾਕਹ ਮਾਰਿ ਭੇਸ ਨਰ ਧਾਰੋ ॥",
      "transliteration": "taakeh maar bhes nar dhaaro ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਮਾਰ ਕੇ ਪੁਰਸ਼ ਦਾ ਭੇਸ ਧਾਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "ताकह मारि भेस नर धारो ॥",
      "sourceLineId": "132518",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਲੋਗਨ ਮਹਿ ਇਹ ਭਾਤਿ ਉਚਾਰੋ ॥੪੪॥",
      "transliteration": "logan meh ieh bhaat uchaaro ||44||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲੋਕਾ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ॥੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "लोगन महि इह भाति उचारो ॥४४॥",
      "sourceLineId": "132519",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮੋਹਿ ਅਮਲ ਕੇ ਕਾਜ ਪਠਾਵਾ ॥",
      "transliteration": "moh amal ke kaaj paThaavaa ||",
      "translation": "",
      "punjabiViakhya": "(ਬਾਦਸ਼ਾਹ ਨੇ) ਮੈਨੂੰ ਅਮਲ (ਲਿਆਉਣ ਦੇ) ਕੰਮ ਲਈ ਭੇਜਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "मोहि अमल के काज पठावा ॥",
      "sourceLineId": "132520",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤੁਮ ਤਨ ਇਹ ਬਿਧਿ ਆਪੁ ਕਹਾਵਾ ॥",
      "transliteration": "tum tan ieh bidh aap kahaavaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੁਹਾਡੇ ਪ੍ਰਤਿ (ਉਨ੍ਰਹਾ ਨੇ) ਆਪ ਆਖਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "तुम तन इह बिधि आपु कहावा ॥",
      "sourceLineId": "132521",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਧਾਮ ਆਵਨੇ ਕੋਈ ਨ ਪਾਵੈ ॥",
      "transliteration": "dhaam aavane koiee na paavai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮਹੱਲ ਦੇ ਅੰਦਰ ਕੋਈ ਨਾ ਆਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "धाम आवने कोई न पावै ॥",
      "sourceLineId": "132522",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜੋ ਆਵੈ ਸੋ ਜਾਨ ਗਵਾਵੈ ॥੪੫॥",
      "transliteration": "jo aavai so jaan gavaavai ||45||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਆਏਗਾ, ਉਹ ਜਾਨ ਗਵਾਏਗਾ ॥੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "जो आवै सो जान गवावै ॥४५॥",
      "sourceLineId": "132523",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਇਹ ਛਲ ਲਾਘਿ ਡਿਵਢੀਯਨ ਆਯੋ ॥",
      "transliteration": "eeh chhal laagh ddivaddeeyan aayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਉਹ ਡੇਉਢੀ ਤੋਂ ਲੰਘ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "इह छल लाघि डिवढीयन आयो ॥",
      "sourceLineId": "132524",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚੋਬਦਾਰ ਨਹਿ ਕਿਨੀ ਹਟਾਯੋ ॥",
      "transliteration": "chobadhaar neh kinee haTaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਕਿਸੇ ਚੋਬਦਾਰ ਨੇ ਨਹੀਂ ਹਟਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "चोबदार नहि किनी हटायो ॥",
      "sourceLineId": "132525",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਬ ਹੀ ਕੁਮਕ ਆਪਨੀ ਗਯੋ ॥",
      "transliteration": "jab hee kumak aapanee gayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਹੀ (ਉਹ) ਆਪਣੀ ਸਹਾਇਕ ਸੈਨਾ ਵਿਚ ਪਹੁੰਚ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "जब ही कुमक आपनी गयो ॥",
      "sourceLineId": "132526",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਬ ਹੀ ਅਮਿਤ ਕੁਲਾਹਲ ਭਯੋ ॥੪੬॥",
      "transliteration": "tab hee amit kulaahal bhayo ||46||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਹੀ ਬਹੁਤ ਰੌਲਾ ਪੈ ਗਿਆ ॥੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "तब ही अमित कुलाहल भयो ॥४६॥",
      "sourceLineId": "132527",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਾਜੈ ਲਗੇ ਤਹਾ ਸਦਿਯਾਨੇ ॥",
      "transliteration": "baajai lage tahaa sadhiyaane ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਖ਼ੁਸ਼ੀ ਦੇ ਵਾਜੇ ਵਜਣ ਲਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "बाजै लगे तहा सदियाने ॥",
      "sourceLineId": "132528",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਾਜਤ ਤਿਹੂੰ ਭਵਨ ਮਹਿ ਜਾਨੇ ॥",
      "transliteration": "baajat tihoo(n) bhavan meh jaane ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦੀ ਆਵਾਜ਼ ਤਿੰਨਾ ਲੋਕਾ ਵਿਚ ਜਾਣੀ ਜਾਣ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "बाजत तिहूँ भवन महि जाने ॥",
      "sourceLineId": "132529",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਢੋਲ ਮ੍ਰਿਦੰਗ ਮੁਚੰਗ ਨਗਾਰੇ ॥",
      "transliteration": "ddol miradha(n)g mucha(n)g nagaare ||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲ, ਮ੍ਰਿਦੰਗ, ਮੁਚੰਗ, ਨਗਾਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "ढोल मृदंग मुचंग नगारे ॥",
      "sourceLineId": "132530",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮੰਦਲ ਤੂਰ ਉਪੰਗ ਅਪਾਰੇ ॥੪੭॥",
      "transliteration": "ma(n)dhal toor upa(n)g apaare ||47||",
      "translation": "",
      "punjabiViakhya": "ਮੰਦਲ, ਤੁਰੀਆਂ ਅਤੇ ਬਹੁਤ ਸਾਰੇ ਉਪੰਗ ਵਜਣ ਲਗੇ ॥੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "मंदल तूर उपंग अपारे ॥४७॥",
      "sourceLineId": "132531",
      "sourceShabadId": "12500",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "132532",
      "sourceShabadId": "12501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਜੈ ਦਮਾਮਾ ਜਬ ਲਗੇ ਸੁਨਿ ਮਾਰੂ ਧੁਨਿ ਕਾਨ ॥",
      "transliteration": "bajai dhamaamaa jab lage sun maaroo dhun kaan ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਦਮਾਮੇ ਵਜਣ ਲਗੇ ਅਤੇ (ਉਨ੍ਰਹਾ ਦੀ) ਮਾਰੂ ਧੁਨੀ ਨੂੰ ਕੰਨਾ ਨਾਲ ਸੁਣਿਆ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "बजै दमामा जब लगे सुनि मारू धुनि कान ॥",
      "sourceLineId": "132533",
      "sourceShabadId": "12501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਖਾਨ ਖਵੀਨ ਜਿਤੇ ਹੁਤੇ ਟੂਟਿ ਪਰੇ ਤਹ ਆਨਿ ॥੪੮॥",
      "transliteration": "khaan khaveen jite hute TooT pare teh aan ||48||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਜਿਤਨੇ ਵੀ ਖ਼ਾਨ ਅਤੇ ਖਵੀਨ ਸਨ, ਉਥੇ ਟੁੱਟ ਕੇ ਆ ਪਏ ॥੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "खान खवीन जिते हुते टूटि परे तह आनि ॥४८॥",
      "sourceLineId": "132534",
      "sourceShabadId": "12501",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "132535",
      "sourceShabadId": "12502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਐਸੋ ਕਵਨ ਦ੍ਵੈਖਨੀ ਜਾਯੋ ॥",
      "transliteration": "aaiso kavan dhavaikhanee jaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਜਿਹਾ ਕਿਹੜਾ ਦ੍ਵੈਸ਼ਣ ਇਸਤਰੀ ਦਾ ਜਾਇਆ ਹੋਇਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "ऐसो कवन द्वैखनी जायो ॥",
      "sourceLineId": "132536",
      "sourceShabadId": "12502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਿਨੈ ਜੁਝਊਆ ਇਹਾ ਬਜਾਯੋ ॥",
      "transliteration": "jinai jujhuooaa ihaa bajaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਇਥੇ ਜੁਝਾਰੂ ਦਮਾਮਾ ਵਜਾਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "जिनै जुझऊआ इहा बजायो ॥",
      "sourceLineId": "132537",
      "sourceShabadId": "12502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1241_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਐਸਾ ਭਯੋ ਕਵਨ ਮਤਵਾਲਾ ॥",
      "transliteration": "aaisaa bhayo kavan matavaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਜਿਹਾ ਕਿਹੜਾ ਪਾਗਲ ਹੋਇਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1241,
      "hindi": "",
      "hindiTransliteration": "ऐसा भयो कवन मतवाला ॥",
      "sourceLineId": "132538",
      "sourceShabadId": "12502",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
