{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1245,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1245_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਬੈ ਆਪਨੇ ਸੀਸ ਪੈ ਛਤ੍ਰ ਢਾਰਿਯੋ ॥੯੧॥",
      "transliteration": "tabai aapane sees pai chhatr ddaariyo ||91||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਉਸ ਨੇ) ਆਪਣੇ ਸਿਰ ਉਤੇ ਛਤ੍ਰ ਝੁਲਾ ਦਿੱਤਾ ॥੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "तबै आपने सीस पै छत्र ढारियो ॥९१॥",
      "sourceLineId": "132707",
      "sourceShabadId": "12506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਬੈ ਸਿਧ ਪਾਲੈ ਘਨੀ ਸੈਨ ਕੂਟੀ ॥",
      "transliteration": "jabai sidh paalai ghanee sain kooTee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਸਿਧ ਪਾਲ ਨੇ ਬਹੁਤ ਸਾਰੀ ਸੈਨਾ ਕੁਚਲ ਦਿੱਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "जबै सिध पालै घनी सैन कूटी ॥",
      "sourceLineId": "132708",
      "sourceShabadId": "12506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਚੈ ਪ੍ਰਾਨ ਲੈ ਕੈ ਚਹੂੰ ਓਰ ਫੂਟੀ ॥",
      "transliteration": "bachai praan lai kai chahoo(n) or fooTee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਬਾਕੀ ਬਚੀ (ਸੈਨਾ) ਪ੍ਰਾਣ ਬਚਾ ਕੇ ਇਧਰ ਉਧਰ ਖਿੰਡ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "बचै प्रान लै कै चहूँ ओर फूटी ॥",
      "sourceLineId": "132709",
      "sourceShabadId": "12506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਲਈ ਪਾਤਿਸਾਹੀ ਸਿਰੈ ਛਤ੍ਰ ਢਾਰਿਯੋ ॥",
      "transliteration": "liee paatisaahee sirai chhatr ddaariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਦੀਵਾਨ ਸਿਧ ਪਾਲ ਨੇ) ਬਾਦਸ਼ਾਹੀ ਲੈ ਲਈ (ਅਤੇ ਆਪਣੇ) ਸਿਰ ਉਤੇ ਛਤ੍ਰ ਝੁਲਵਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "लई पातिसाही सिरै छत्र ढारियो ॥",
      "sourceLineId": "132710",
      "sourceShabadId": "12506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪਰਿਯੋ ਪਾਸੁ ਬਾਚ੍ਯੋ ਅਰਿਯੋ ਸੋ ਸੰਘਾਰਿਯੋ ॥੯੨॥",
      "transliteration": "pariyo paas baachayo ariyo so sa(n)ghaariyo ||92||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸ਼ਰਨ ਵਿਚ ਆ ਗਿਆ, ਉਹ ਬਚ ਗਿਆ। ਜੋ ਅੜਿਆ, ਉਹ ਮਾਰਿਆ ਗਿਆ ॥੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "परियो पासु बाच्यो अरियो सो संघारियो ॥९२॥",
      "sourceLineId": "132711",
      "sourceShabadId": "12506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਲਈ ਪਾਤਸਾਹੀ ਹ੍ਰਿਦੈ ਯੌ ਬਿਚਾਰਾ ॥",
      "transliteration": "liee paatasaahee hiradhai yau bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਬਾਦਸ਼ਾਹੀ ਹਾਸਲ ਕਰ ਕੇ ਦਿਲ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਵਿਚਾਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "लई पातसाही हृदै यौ बिचारा ॥",
      "sourceLineId": "132712",
      "sourceShabadId": "12506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਰਿਯੋ ਕਾਜ ਨੀਕੋ ਨ ਸਾਹੈ ਸੰਘਾਰਾ ॥",
      "transliteration": "kariyo kaaj neeko na saahai sa(n)ghaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਬਾਦਸ਼ਾਹ ਨੂੰ ਮਾਰ ਕੇ ਚੰਗਾ ਕੰਮ ਨਹੀਂ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "करियो काज नीको न साहै संघारा ॥",
      "sourceLineId": "132713",
      "sourceShabadId": "12506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਗ੍ਯੋ ਰੈਨਿ ਸਾਰੀ ਧਰਿਯੋ ਧ੍ਯਾਨ ਤਾ ਕੋ ॥",
      "transliteration": "jagayo rain saaree dhariyo dhayaan taa ko ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਰਾਤ ਜਾਗਦਾ ਰਿਹਾ ਅਤੇ ਉਸੇ ਦਾ ਧਿਆਨ ਕਰਦਾ ਰਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "जग्यो रैनि सारी धरियो ध्यान ता को ॥",
      "sourceLineId": "132714",
      "sourceShabadId": "12506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦਿਯੋ ਪਾਤਿਸਾਹੀ ਮਿਲੈ ਪ੍ਰਾਤ ਵਾ ਕੋ ॥੯੩॥",
      "transliteration": "dhiyo paatisaahee milai praat vaa ko ||93||",
      "translation": "",
      "punjabiViakhya": "(ਕਿ) ਜੋ ਵੀ ਸਵੇਰੇ ਮਿਲ ਪਏ, ਉਸੇ ਨੂੰ ਬਾਦਸ਼ਾਹੀ ਦੇ ਦਿੱਤੀ ਜਾਵੇ ॥੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "दियो पातिसाही मिलै प्रात वा को ॥९३॥",
      "sourceLineId": "132715",
      "sourceShabadId": "12506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਸਾਈਨ ਕੌ ਦਾਸ ਤਹ ਏਕ ਆਯੋ ॥",
      "transliteration": "kasaieen kau dhaas teh ek aayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਸਵੇਰੇ ਇਕ ਕਸਾਈ ਦਾ ਨੌਕਰ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "कसाईन कौ दास तह एक आयो ॥",
      "sourceLineId": "132716",
      "sourceShabadId": "12506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਦੀ ਡਾਰਬੇ ਓਝਰੀ ਲੈ ਸਿਧਾਯੋ ॥",
      "transliteration": "nadhee ddaarabe ojharee lai sidhaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਨਦੀ ਵਿਚ ਓਝਰੀ ਲੈ ਕੇ ਸੁਟਣ ਜਾ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "नदी डारबे ओझरी लै सिधायो ॥",
      "sourceLineId": "132717",
      "sourceShabadId": "12506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗਹਿਯੋ ਜਾਹਿ ਤਾ ਕੋ ਦਈ ਪਾਤਿਸਾਹੀ ॥",
      "transliteration": "gahiyo jaeh taa ko dhiee paatisaahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜਾ ਪਕੜਿਆ ਅਤੇ ਬਾਦਸ਼ਾਹੀ ਦੇ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "गहियो जाहि ता को दई पातिसाही ॥",
      "sourceLineId": "132718",
      "sourceShabadId": "12506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਧਰਿਯੋ ਜੈਨ ਆਲਾਵਦੀ ਨਾਮ ਤਾਹੀ ॥੯੪॥",
      "transliteration": "dhariyo jain aalaavadhee naam taahee ||94||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਾ ਜੈਨ-ਆਲਾਵਦੀ ਰਖ ਦਿੱਤਾ ॥੯੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "धरियो जैन आलावदी नाम ताही ॥९४॥",
      "sourceLineId": "132719",
      "sourceShabadId": "12506",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "132720",
      "sourceShabadId": "12507",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਬ ਹੀ ਰਾਜ ਤਵਨ ਕਹ ਦਯੋ ॥",
      "transliteration": "jab hee raaj tavan keh dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਹੀ ਉਸ ਨੂੰ ਰਾਜ ਦੇ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "जब ही राज तवन कह दयो ॥",
      "sourceLineId": "132721",
      "sourceShabadId": "12507",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੁਤਾ ਸਹਿਤ ਬਨ ਮਾਰਗ ਲਯੋ ॥",
      "transliteration": "sutaa sahit ban maarag layo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਪੁੱਤਰੀ ਸਮੇਤ ਜੰਗਲ ਦਾ ਰਸਤਾ ਪਕੜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "सुता सहित बन मारग लयो ॥",
      "sourceLineId": "132722",
      "sourceShabadId": "12507",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਦ੍ਰਕਾਸਿ ਮਹਿ ਕਿਯਾ ਪ੍ਰਵੇਸਾ ॥",
      "transliteration": "badhrakaas meh kiyaa pravesaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਦ੍ਰਕਾਸਿ' (ਬਦਰੀ ਨਾਥ) ਵਿਚ ਪੁੱਤਰੀ ਸਮੇਤ",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "बद्रकासि महि किया प्रवेसा ॥",
      "sourceLineId": "132723",
      "sourceShabadId": "12507",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦੁਹਿਤਾ ਸਹਿਤ ਅਤਿਥ ਕੇ ਭੇਸਾ ॥੯੫॥",
      "transliteration": "dhuhitaa sahit atith ke bhesaa ||95||",
      "translation": "",
      "punjabiViakhya": "ਸਾਧ ਦਾ ਭੇਸ ਧਾਰਨ ਕਰ ਕੇ ਪ੍ਰਵੇਸ਼ ਕੀਤਾ ॥੯੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "दुहिता सहित अतिथ के भेसा ॥९५॥",
      "sourceLineId": "132724",
      "sourceShabadId": "12507",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "132725",
      "sourceShabadId": "12508",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਬ ਬਹੁ ਤਹ ਤਪਸਾ ਕਰੀ ਪ੍ਰਗਟ ਭਈ ਜਗ ਮਾਇ ॥",
      "transliteration": "jab bahu teh tapasaa karee pragaT bhiee jag mai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਉਸ ਨੇ) ਉਥੇ ਬਹੁਤ ਤਪਸਿਆ ਕੀਤੀ (ਤਾ) ਜਗਤ ਮਾਤਾ (ਦੇਵੀ) ਪ੍ਰਗਟ ਹੋਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "जब बहु तह तपसा करी प्रगट भई जग माइ ॥",
      "sourceLineId": "132726",
      "sourceShabadId": "12508",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਰੰਬ੍ਰੂਹ ਤਾ ਸੌ ਕਹਿਯੋ ਜੋ ਤੁਹਿ ਸੁਤਾ ਸੁਹਾਇ ॥੯੬॥",
      "transliteration": "bara(n)braooh taa sau kahiyo jo tuh sutaa suhai ||96||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਕਿਹਾ, ਹੇ ਪੁੱਤਰੀ! ਜੋ ਤੈਨੂੰ ਚੰਗਾ ਲਗਦਾ ਹੈ, ਉਹ ਵਰ ਮੰਗ ਲੈ ('ਬਰੰਬ੍ਰੂਹ') ॥੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "बरंब्रूह ता सौ कहियो जो तुहि सुता सुहाइ ॥९६॥",
      "sourceLineId": "132727",
      "sourceShabadId": "12508",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "132728",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮੈਯਾ ਇਹੈ ਦਾਨੁ ਮੁਹਿ ਦੀਜੈ ॥",
      "transliteration": "maiyaa ihai dhaan muh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮਾਤਾ! ਮੈਨੂੰ ਇਹੋ ਵਰ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "मैया इहै दानु मुहि दीजै ॥",
      "sourceLineId": "132729",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਛਾ ਆਪੁ ਹਮਾਰੀ ਕੀਜੈ ॥",
      "transliteration": "rachhaa aap hamaaree keejai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪ ਮੇਰੀ ਰਛਿਆ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "रछा आपु हमारी कीजै ॥",
      "sourceLineId": "132730",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਛਤ੍ਰਾਨੀ ਗ੍ਰਿਹਿ ਤੁਰਕ ਨ ਜਾਇ ॥",
      "transliteration": "chhatraanee gireh turak na jai ||",
      "translation": "",
      "punjabiViakhya": "ਕਦੇ ਛਤ੍ਰਾਣੀ ਤੁਰਕ ਦੇ ਘਰ ਨਾ ਜਾਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "छत्रानी गृहि तुरक न जाइ ॥",
      "sourceLineId": "132731",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੁਹਿ ਬਰ ਦੇਹੁ ਇਹੇ ਜਗ ਮਾਇ ॥੯੭॥",
      "transliteration": "muh bar dheh ihe jag mai ||97||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਜਗਮਾਤਾ! ਮੈਨੂੰ ਇਹੋ ਵਰ ਦਿਓ ॥੯੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "मुहि बर देहु इहे जग माइ ॥९७॥",
      "sourceLineId": "132732",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚਰਨਨ ਰਹੈ ਤਿਹਾਰੈ ਚਿਤਾ ॥",
      "transliteration": "charanan rahai tihaarai chitaa ||",
      "translation": "",
      "punjabiViakhya": "(ਮੇਰਾ) ਚਿਤ (ਹਰ ਵੇਲੇ) ਤੁਹਾਡੇ ਚਰਨਾ ਵਿਚ ਰਹੇ",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "चरनन रहै तिहारै चिता ॥",
      "sourceLineId": "132733",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗ੍ਰਿਹ ਮਹਿ ਹੋਇ ਅਨਗਨਤ ਬਿਤਾ ॥",
      "transliteration": "gireh meh hoi anaganat bitaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘਰ ਵਿਚ ਅਣਗਿਣਤ ਧਨ-ਦੌਲਤ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "गृह महि होइ अनगनत बिता ॥",
      "sourceLineId": "132734",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਤ੍ਰੁ ਨ ਜੀਤਿ ਹਮੈ ਕੋਈ ਜਾਇ ॥",
      "transliteration": "satr na jeet hamai koiee jai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਨੂੰ ਕੋਈ ਵੈਰੀ ਜਿਤ ਕੇ ਨਾ ਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "सत्रु न जीति हमै कोई जाइ ॥",
      "sourceLineId": "132735",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤੁਮ ਮਹਿ ਰਹੈ ਮੋਰ ਮਨ ਮਾਇ ॥੯੮॥",
      "transliteration": "tum meh rahai mor man mai ||98||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੇ ਮਾਤਾ! ਮੇਰਾ ਮਨ ਸਦਾ ਤੁਹਾਡੇ ਵਿਚ ਲਗਾ ਰਹੇ ॥੯੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "तुम महि रहै मोर मन माइ ॥९८॥",
      "sourceLineId": "132736",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਗ ਮਾਤੈ ਐਸੇ ਬਰੁ ਦੀਯੋ ॥",
      "transliteration": "jag maatai aaise bar dheeyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਗਤ ਮਾਤਾ ਨੇ ਅਜਿਹਾ ਹੀ ਵਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "जग मातै ऐसे बरु दीयो ॥",
      "sourceLineId": "132737",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਿਨ ਕਹ ਰਾਜ ਅਸਾਮ ਕੋ ਕੀਯੋ ॥",
      "transliteration": "tin keh raaj asaam ko keeyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਆਸਾਮ ਦਾ ਰਾਜਾ ਬਣਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "तिन कह राज असाम को कीयो ॥",
      "sourceLineId": "132738",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਬ ਲਗਿ ਰਾਜ ਤਹਾ ਤੈ ਕਰੈ ॥",
      "transliteration": "ab lag raaj tahaa tai karai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਹੁਣ ਤਕ ਉਥੇ ਰਾਜ ਕਰਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "अब लगि राज तहा तै करै ॥",
      "sourceLineId": "132739",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦਿਲੀਪਤਿ ਕੀ ਕਾਨਿ ਨ ਧਰੈ ॥੯੯॥",
      "transliteration": "dhileepat kee kaan na dharai ||99||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦਿੱਲੀ ਦੇ ਬਾਦਸ਼ਾਹ ਦੀ ਪਰਵਾਹ ਨਹੀਂ ਕਰਦਾ ॥੯੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "दिलीपति की कानि न धरै ॥९९॥",
      "sourceLineId": "132740",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਿਨ ਕਹ ਰਾਜ ਭਵਾਨੀ ਦੀਯੋ ॥",
      "transliteration": "jin keh raaj bhavaanee dheeyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਿਸੇ ਨੂੰ ਭਵਾਨੀ ਨੇ (ਖ਼ੁਦ) ਰਾਜ ਦਿੱਤਾ ਹੋਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "जिन कह राज भवानी दीयो ॥",
      "sourceLineId": "132741",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਿਨ ਤੇ ਛੀਨਿ ਨ ਕਿਨਹੂੰ ਲੀਯੋ ॥",
      "transliteration": "tin te chheen na kinahoo(n) leeyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਾਸੋਂ ਕੋਈ ਖੋਹ ਨਹੀਂ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "तिन ते छीनि न किनहूँ लीयो ॥",
      "sourceLineId": "132742",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਬ ਲੌ ਕਰਤ ਤਹਾ ਕੋ ਰਾਜਾ ॥",
      "transliteration": "ab lau karat tahaa ko raajaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਹੁਣ ਤਕ ਉਥੇ ਰਾਜ ਕਰਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "अब लौ करत तहा को राजा ॥",
      "sourceLineId": "132743",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਿਧਿ ਸਿਧਿ ਸਭ ਹੀ ਘਰ ਸਾਜਾ ॥੧੦੦॥",
      "transliteration": "ridh sidh sabh hee ghar saajaa ||100||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘਰ ਵਿਚ ਸਭ ਹੀ ਰਿਧੀਆਂ ਸਿਧੀਆਂ ਮੌਜੂਦ ਹਨ ॥੧੦੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "रिधि सिधि सभ ही घर साजा ॥१००॥",
      "sourceLineId": "132744",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪ੍ਰਥਮ ਦਿਲਿਸ ਸੌ ਪਿਤਾ ਜੁਝਾਯੋ ॥",
      "transliteration": "pratham dhilis sau pitaa jujhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਦਿੱਲੀ ਦੇ ਬਾਦਸ਼ਾਹ ਨਾਲ ਪਿਤਾ ਨੂੰ ਲੜਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "प्रथम दिलिस सौ पिता जुझायो ॥",
      "sourceLineId": "132745",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪੁਨਿ ਦੇਬੀ ਤੇ ਅਸ ਬਰ ਪਾਯੋ ॥",
      "transliteration": "pun dhebee te as bar paayo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਦੇਵੀ ਤੋਂ ਇਹ ਵਰ ਪ੍ਰਾਪਤ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "पुनि देबी ते अस बर पायो ॥",
      "sourceLineId": "132746",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅੰਗ ਦੇਸ ਕੇ ਭਏ ਨ੍ਰਿਪਾਰਾ ॥",
      "transliteration": "a(n)g dhes ke bhe nirapaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ ਪਿਤਾ) 'ਅੰਗ ਦੇਸ' (ਆਸਾਮ) ਦਾ ਰਾਜਾ ਬਣਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "अंग देस के भए नृपारा ॥",
      "sourceLineId": "132747",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਇਹ ਛਲ ਅਬਲਾ ਧਰਮ ਉਬਾਰਾ ॥੧੦੧॥",
      "transliteration": "eeh chhal abalaa dharam ubaaraa ||101||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ (ਉਸ) ਅਬਲਾ ਨੇ ਆਪਣਾ ਧਰਮ ਬਚਾ ਲਿਆ ॥੧੦੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "इह छल अबला धरम उबारा ॥१०१॥",
      "sourceLineId": "132748",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋ ਸੌ ਸਤਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੯੭॥੫੭੫੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dho sau sataanavo charitr samaapatam sat subham sat ||297||5750||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੯੭ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੯੭॥੫੭੫੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दो सौ सतानवो चरित्र समापतम सतु सुभम सतु ॥२९७॥५७५०॥अफजूँ॥",
      "sourceLineId": "132749",
      "sourceShabadId": "12509",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "132750",
      "sourceShabadId": "12510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੁਨਿਯਤ ਏਕ ਸਾਹ ਕੀ ਦਾਰਾ ॥",
      "transliteration": "suniyat ek saeh kee dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਸ਼ਾਹ ਦੀ ਇਸਤਰੀ ਸੁਣੀਂਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "सुनियत एक साह की दारा ॥",
      "sourceLineId": "132751",
      "sourceShabadId": "12510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਰੂਪਵਾਨ ਗੁਨਵਾਨ ਅਪਾਰਾ ॥",
      "transliteration": "roopavaan gunavaan apaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਬਹੁਤ ਰੂਪਵਾਨ ਅਤੇ ਗੁਣਵਾਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "रूपवान गुनवान अपारा ॥",
      "sourceLineId": "132752",
      "sourceShabadId": "12510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਝਿਲਮਿਲ ਦੇ ਤਿਹ ਨਾਮ ਭਨਿਜੈ ॥",
      "transliteration": "jhilamil dhe teh naam bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਾ ਝਿਲਮਿਲ ਦੇ (ਦੇਈ) ਕਿਹਾ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "झिलमिल दे तिह नाम भनिजै ॥",
      "sourceLineId": "132753",
      "sourceShabadId": "12510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1245_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕੋ ਦੂਸਰ ਪਟਤਰ ਤਿਹ ਦਿਜੈ ॥੧॥",
      "transliteration": "ko dhoosar paTatar teh dhijai ||1||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ ਕਿਸ ਨਾਲ ਉਸ ਦੀ ਤੁਲਨਾ ਕੀਤੀ ਜਾਏ। (ਅਰਥਾਤ ਉਹ ਬਹੁਤ ਸੁੰਦਰ ਸੀ) ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1245,
      "hindi": "",
      "hindiTransliteration": "को दूसर पटतर तिह दिजै ॥१॥",
      "sourceLineId": "132754",
