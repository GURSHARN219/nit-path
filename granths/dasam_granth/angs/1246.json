{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1246,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1246_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰੂਪ ਕੇਤੁ ਰਾਜਾ ਇਕ ਤਹਾ ॥",
      "transliteration": "roop ket raajaa ik tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਰੂਪ ਕੇਤੁ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "रूप केतु राजा इक तहा ॥",
      "sourceLineId": "132755",
      "sourceShabadId": "12510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰੂਪਮਾਨ ਅਰੁ ਸੂਰਾ ਮਹਾ ॥",
      "transliteration": "roopamaan ar sooraa mahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਬਹੁਤ ਰੂਪਵਾਨ ਅਤੇ ਸੂਰਮਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "रूपमान अरु सूरा महा ॥",
      "sourceLineId": "132756",
      "sourceShabadId": "12510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਥਰਹਰ ਕੰਪੈ ਸਤ੍ਰੁ ਜਾ ਕੇ ਡਰ ॥",
      "transliteration": "tharahar ka(n)pai satr jaa ke ddar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਡਰ ਦੇ ਮਾਰੇ ਵੈਰੀ ਥਰ ਥਰ ਕੰਬਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "थरहर कंपै सत्रु जा के डर ॥",
      "sourceLineId": "132757",
      "sourceShabadId": "12510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪ੍ਰਗਟ ਭਯੋ ਜਨੁ ਦੁਤਿਯ ਨਿਸਾਕਰ ॥੨॥",
      "transliteration": "pragaT bhayo jan dhutiy nisaakar ||2||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਦੂਜਾ ਚੰਦ੍ਰਮਾ ਪੈਦਾ ਹੋ ਗਿਆ ਹੋਵੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "प्रगट भयो जनु दुतिय निसाकर ॥२॥",
      "sourceLineId": "132758",
      "sourceShabadId": "12510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਏਕ ਸਪੂਤ ਪੂਤ ਤਿਨ ਜਯੋ ॥",
      "transliteration": "ek sapoot poot tin jayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ (ਘਰ) ਇਕ ਸੁਪੁੱਤਰ ਪੁੱਤਰ ਪੈਦਾ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "एक सपूत पूत तिन जयो ॥",
      "sourceLineId": "132759",
      "sourceShabadId": "12510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਾ ਸੌ ਔਰ ਨ ਜਗ ਮਹਿ ਭਯੋ ॥",
      "transliteration": "jaa sau aauar na jag meh bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਜਗਤ ਵਿਚ ਹੋਰ ਕੋਈ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "जा सौ और न जग महि भयो ॥",
      "sourceLineId": "132760",
      "sourceShabadId": "12510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਝਿਲਮਿਲ ਦੇ ਤਾ ਕੌ ਲਖਿ ਗਈ ॥",
      "transliteration": "jhilamil dhe taa kau lakh giee ||",
      "translation": "",
      "punjabiViakhya": "ਝਿਲਮਿਲ ਦੇਈ ਨੇ ਉਸ ਨੂੰ ਵੇਖ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "झिलमिल दे ता कौ लखि गई ॥",
      "sourceLineId": "132761",
      "sourceShabadId": "12510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਬ ਹੀ ਤੇ ਬਵਰੀ ਸੀ ਭਈ ॥੩॥",
      "transliteration": "tab hee te bavaree see bhiee ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤੋਂ ਹੀ ਦੀਵਾਨੀ ਜਿਹੀ ਹੋ ਗਈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "तब ही ते बवरी सी भई ॥३॥",
      "sourceLineId": "132762",
      "sourceShabadId": "12510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਵਾ ਸੌ ਬਾਧਾ ਅਧਿਕ ਸਨੇਹਾ ॥",
      "transliteration": "vaa sau baadhaa adhik sanehaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ (ਉਸ ਨੇ) ਬਹੁਤ ਸਨੇਹ ਵਧਾ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "वा सौ बाधा अधिक सनेहा ॥",
      "sourceLineId": "132763",
      "sourceShabadId": "12510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦ੍ਵੈ ਤੇ ਕਰੀ ਏਕ ਜਨੁ ਦੇਹਾ ॥",
      "transliteration": "dhavai te karee ek jan dhehaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਦੋ ਤੋਂ ਇਕ ਸ਼ਰੀਰ ਕਰ ਦਿੱਤਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "द्वै ते करी एक जनु देहा ॥",
      "sourceLineId": "132764",
      "sourceShabadId": "12510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਔਰ ਉਪਾਉ ਨ ਚਲਿਯੋ ਚਲਾਯੋ ॥",
      "transliteration": "aauar upaau na chaliyo chalaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ (ਉਸ ਨੂੰ ਮਿਲ ਸਕਣ ਦਾ) ਕੋਈ ਹੋਰ ਉਪਾ ਨਾ ਚਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "और उपाउ न चलियो चलायो ॥",
      "sourceLineId": "132765",
      "sourceShabadId": "12510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਬ ਅਬਲਾ ਨਰ ਭੇਸ ਬਨਾਯੋ ॥੪॥",
      "transliteration": "tab abalaa nar bhes banaayo ||4||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਅਬਲਾ ਨੇ ਮਰਦ ਦਾ ਭੇਸ ਬਣਾਇਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "तब अबला नर भेस बनायो ॥४॥",
      "sourceLineId": "132766",
      "sourceShabadId": "12510",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "132767",
      "sourceShabadId": "12511",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਧਰਿ ਕਰਿ ਭੇਸ ਕਰੌਲ ਕੌ ਗਈ ਤਵਨ ਕੇ ਧਾਮ ॥",
      "transliteration": "dhar kar bhes karaual kau giee tavan ke dhaam ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸ਼ਿਕਾਰੀ ਦਾ ਭੇਸ ਧਾਰ ਕੇ ਉਸ ਦੇ ਘਰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "धरि करि भेस करौल कौ गई तवन के धाम ॥",
      "sourceLineId": "132768",
      "sourceShabadId": "12511",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਭ ਕੋ ਨਰ ਜਾਨੇ ਤਿਸੈ ਕੋਈ ਨ ਜਾਨੈ ਬਾਮ ॥੫॥",
      "transliteration": "sabh ko nar jaane tisai koiee na jaanai baam ||5||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸਭ ਮਰਦ ਹੀ ਸਮਝਦੇ ਸਨ, ਕੋਈ ਵੀ ਇਸਤਰੀ ਨਹੀਂ ਸਮਝਦਾ ਸੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "सभ को नर जाने तिसै कोई न जानै बाम ॥५॥",
      "sourceLineId": "132769",
      "sourceShabadId": "12511",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "132770",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕੁਅਰਹਿ ਰੋਜ ਸਿਕਾਰ ਖਿਲਾਵੈ ॥",
      "transliteration": "kuareh roj sikaar khilaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਕੁਮਾਰ ਨੂੰ ਰੋਜ਼ ਸ਼ਿਕਾਰ ਖਿਡਾਉਾਂਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "कुअरहि रोज सिकार खिलावै ॥",
      "sourceLineId": "132771",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਮ੍ਰਿਗਹਿ ਹਨਾਵੈ ॥",
      "transliteration": "bhaat bhaat tan mirageh hanaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਤੋਂ) ਤਰ੍ਰਹਾ ਤਰ੍ਰਹਾ ਦੇ ਮ੍ਰਿਗ (ਜੰਗਲੀ ਪਸ਼ੂ) ਮਰਵਾਉਾਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन मृगहि हनावै ॥",
      "sourceLineId": "132772",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਇਕਲੀ ਫਿਰੈ ਸਜਨ ਕੇ ਸੰਗਾ ॥",
      "transliteration": "eikalee firai sajan ke sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਰੀਰ ਉਤੇ ਮਰਦਾਵਾ ਭੇਸ ਪਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "इकली फिरै सजन के संगा ॥",
      "sourceLineId": "132773",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪਹਿਰੇ ਪੁਰਖ ਭੇਸ ਕਹ ਅੰਗਾ ॥੬॥",
      "transliteration": "pahire purakh bhes keh a(n)gaa ||6||",
      "translation": "",
      "punjabiViakhya": "ਇਕੱਲੀ ਹੀ ਮਿਤਰ ਨਾਲ ਫਿਰਦੀ ਸੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "पहिरे पुरख भेस कह अंगा ॥६॥",
      "sourceLineId": "132774",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਕ ਦਿਨ ਸਦਨ ਨ ਜਾਤ ਸੁ ਭਈ ॥",
      "transliteration": "eik dhin sadhan na jaat su bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਉਹ ਘਰ ਨੂੰ ਨਾ ਪਰਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "इक दिन सदन न जात सु भई ॥",
      "sourceLineId": "132775",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪਿਤ ਤਨ ਕਹੀ ਸੁਤਾ ਮਰਿ ਗਈ ॥",
      "transliteration": "pit tan kahee sutaa mar giee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਿਤਾ ਨੂੰ ਅਖਵਾ ਭੇਜਿਆ ਕਿ (ਤੁਹਾਡੀ) ਪੁੱਤਰੀ ਮਰ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "पित तन कही सुता मरि गई ॥",
      "sourceLineId": "132776",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਪਨੀ ਠਵਰ ਬਕਰਿਯਹਿ ਜਾਰਾ ॥",
      "transliteration": "apanee Thavar bakariyeh jaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੀ ਥਾ ਤੇ ਇਕ ਬਕਰੀ ਨੂੰ ਸਾੜ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "अपनी ठवर बकरियहि जारा ॥",
      "sourceLineId": "132777",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੂਸਰ ਪੁਰਖ ਨ ਭੇਦ ਬਿਚਾਰਾ ॥੭॥",
      "transliteration": "dhoosar purakh na bhedh bichaaraa ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਸੇ ਹੋਰ ਪੁਰਸ਼ ਨੂੰ ਭੇਦ ਨਾ ਸਮਝਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "दूसर पुरख न भेद बिचारा ॥७॥",
      "sourceLineId": "132778",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਾਹ ਲਹਿਯੋ ਦੁਹਿਤਾ ਮਰ ਗਈ ॥",
      "transliteration": "saeh lahiyo dhuhitaa mar giee ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਾਹ ਨੇ ਸਮਝ ਲਿਆ ਕਿ ਪੁੱਤਰੀ ਮਰ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "साह लहियो दुहिता मर गई ॥",
      "sourceLineId": "132779",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਯੌ ਨਹੀ ਲਖਿਯੋ ਕਰੌਲਨ ਭਈ ॥",
      "transliteration": "yau nahee lakhiyo karaualan bhiee ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ ਉਸ ਨੇ) ਇਹ ਨਾ ਸਮਝਿਆ (ਕਿ ਪੁੱਤਰੀ) ਸ਼ਿਕਾਰਨ ਹੋ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "यौ नही लखियो करौलन भई ॥",
      "sourceLineId": "132780",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੰਗ ਨਿਤ ਲੈ ਨ੍ਰਿਪ ਸੁਤ ਕੌ ਜਾਵੈ ॥",
      "transliteration": "sa(n)g nit lai nirap sut kau jaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਰੋਜ਼ ਰਾਜੇ ਦੇ ਪੁੱਤਰ ਨੂੰ ਨਾਲ ਲੈ ਕੇ ਜਾਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "संग नित लै नृप सुत कौ जावै ॥",
      "sourceLineId": "132781",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਨ ਉਪਬਨ ਭੀਤਰ ਭ੍ਰਮਿ ਆਵੈ ॥੮॥",
      "transliteration": "ban upaban bheetar bhram aavai ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਨ, ਉਪਬਨ ਵਿਚ ਘੁੰਮ ਫਿਰ ਕੇ ਆ ਜਾਦੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "बन उपबन भीतर भ्रमि आवै ॥८॥",
      "sourceLineId": "132782",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਹੁਤ ਕਾਲ ਇਹ ਭਾਤਿ ਬਿਤਾਯੋ ॥",
      "transliteration": "bahut kaal ieh bhaat bitaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਉਸ ਨੇ ਬਹੁਤ ਸਮਾ ਬਿਤਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "बहुत काल इह भाति बितायो ॥",
      "sourceLineId": "132783",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਕਹ ਬਹੁ ਬਿਰਮਾਯੋ ॥",
      "transliteration": "raaj kuar keh bahu biramaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ ਕੁਮਾਰ ਨੂੰ ਬਹੁਤ ਪ੍ਰਸੰਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "राज कुअर कह बहु बिरमायो ॥",
      "sourceLineId": "132784",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੋ ਤਾ ਕਹ ਨਹਿ ਨਾਰਿ ਪਛਾਨੈ ॥",
      "transliteration": "so taa keh neh naar pachhaanai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਉਸ ਨੂੰ ਇਸਤਰੀ ਵਜੋਂ ਨਹੀਂ ਪਛਾਣਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "सो ता कह नहि नारि पछानै ॥",
      "sourceLineId": "132785",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਲੋ ਕਰੌਲ ਤਾਹਿ ਕਰਿ ਮਾਨੈ ॥੯॥",
      "transliteration": "bhalo karaual taeh kar maanai ||9||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਚੰਗਾ ਸ਼ਿਕਾਰੀ ਹੀ ਮੰਨਦਾ ਸੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "भलो करौल ताहि करि मानै ॥९॥",
      "sourceLineId": "132786",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਇਕ ਦਿਨ ਗਏ ਗਹਿਰ ਬਨ ਦੋਊ ॥",
      "transliteration": "eik dhin ge gahir ban dhouoo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਦੋਵੇਾਂ ਸੰਘਣੇ ਬਨ ਵਿਚ ਚਲੇ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "इक दिन गए गहिर बन दोऊ ॥",
      "sourceLineId": "132787",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਾਥੀ ਦੁਤਿਯ ਨ ਪਹੁਚਾ ਕੋਊ ॥",
      "transliteration": "saathee dhutiy na pahuchaa kouoo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ ਉਨ੍ਰਹਾ ਕੋਲ) ਕੋਈ ਹੋਰ ਸਾਥੀ ਨਾ ਪਹੁੰਚ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "साथी दुतिय न पहुचा कोऊ ॥",
      "sourceLineId": "132788",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਥ੍ਰਯੋ ਦਿਵਸ ਰਜਨੀ ਹ੍ਵੈ ਆਈ ॥",
      "transliteration": "athrayo dhivas rajanee havai aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਦਿਨ ਗੁਜ਼ਰ ਗਿਆ ਅਤੇ ਰਾਤ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "अथ्रयो दिवस रजनी ह्वै आई ॥",
      "sourceLineId": "132789",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਏਕ ਬ੍ਰਿਛ ਤਰ ਬਸੇ ਬਨਾਈ ॥੧੦॥",
      "transliteration": "ek birachh tar base banaiee ||10||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਬ੍ਰਿਛ ਹੇਠਾ (ਥਾ) ਬਣਾ ਕੇ ਠਹਿਰ ਗਏ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "एक बृछ तर बसे बनाई ॥१०॥",
      "sourceLineId": "132790",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਹ ਇਕ ਆਯੋ ਸਿੰਘ ਅਪਾਰਾ ॥",
      "transliteration": "teh ik aayo si(n)gh apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਵੱਡਾ ਸ਼ੇਰ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "तह इक आयो सिंघ अपारा ॥",
      "sourceLineId": "132791",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਾਢੇ ਦਾਤ ਬਡੇ ਬਿਕਰਾਰਾ ॥",
      "transliteration": "kaadde dhaat badde bikaraaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਭਿਆਨਕ ਦੰਦ ਕਢੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "काढे दात बडे बिकरारा ॥",
      "sourceLineId": "132792",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਾਹਿ ਨਿਰਖਿ ਨ੍ਰਿਪ ਸੁਤ ਡਰ ਪਾਯੋ ॥",
      "transliteration": "taeh nirakh nirap sut ddar paayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਰਾਜੇ ਦਾ ਪੁੱਤਰ ਡਰ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "ताहि निरखि नृप सुत डर पायो ॥",
      "sourceLineId": "132793",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਾਹ ਸੁਤਾ ਤਿਹ ਧੀਰ ਬੰਧਾਯੋ ॥੧੧॥",
      "transliteration": "saeh sutaa teh dheer ba(n)dhaayo ||11||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਨੇ ਉਸ ਨੂੰ ਧੀਰਜ ਬੰਨ੍ਰਹਾਇਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "साह सुता तिह धीर बंधायो ॥११॥",
      "sourceLineId": "132794",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਬ ਤਿਹ ਤਾਕਿ ਤੁਪਕ ਸੌ ਮਾਰਿਯੋ ॥",
      "transliteration": "tab teh taak tupak sau maariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਨੂੰ ਵੇਖ ਕੇ (ਸ਼ਿਕਾਰਨ ਨੇ) ਬੰਦੂਕ ਨਾਲ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "तब तिह ताकि तुपक सौ मारियो ॥",
      "sourceLineId": "132795",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨ੍ਰਿਪ ਸੁਤ ਦੇਖਤ ਸਿੰਘ ਪ੍ਰਹਾਰਿਯੋ ॥",
      "transliteration": "nirap sut dhekhat si(n)gh prahaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ ਕੁਮਾਰ ਦੇ ਦੇਖਦੇ ਹੋਇਆਂ ਸ਼ੇਰ ਨੂੰ ਸੰਘਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "नृप सुत देखत सिंघ प्रहारियो ॥",
      "sourceLineId": "132796",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਅਸ ਬਚਨ ਉਚਾਰੇ ॥",
      "transliteration": "raaj kuar as bachan uchaare ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਰਾਜ ਕੁਮਾਰ ਨੇ ਇਹ ਕਿਹਾ, (ਹੇ ਸ਼ਿਕਾਰੀ!)",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "राज कुअर अस बचन उचारे ॥",
      "sourceLineId": "132797",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮਾਗਹੁ ਜੋ ਜਿਯ ਰੁਚਤ ਤਿਹਾਰੇ ॥੧੨॥",
      "transliteration": "maagahu jo jiy ruchat tihaare ||12||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਤੇਰੇ ਜੀ ਆਏ, ਮੰਗ ਲਵੋ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "मागहु जो जिय रुचत तिहारे ॥१२॥",
      "sourceLineId": "132798",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਬ ਤਿਨ ਤਾ ਸੌ ਬ੍ਰਿਥਾ ਉਚਾਰੀ ॥",
      "transliteration": "tab tin taa sau birathaa uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ (ਸ਼ਿਕਾਰੀ ਬਣੀ ਲੜਕੀ) ਨੇ ਉਸ ਨੂੰ ਸਾਰੀ ਬਿਰਥਾ ਸੁਣਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "तब तिन ता सौ बृथा उचारी ॥",
      "sourceLineId": "132799",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਮੈ ਸਾਹ ਦੁਲਾਰੀ ॥",
      "transliteration": "raaj kuar mai saeh dhulaaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਹੇ ਰਾਜ ਕੁਮਾਰ! ਮੈਂ ਸ਼ਾਹ ਦੀ ਬੇਟੀ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "राज कुअर मै साह दुलारी ॥",
      "sourceLineId": "132800",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤੋ ਸੌ ਮੋਰਿ ਲਗਨਿ ਲਗ ਗਈ ॥",
      "transliteration": "to sau mor lagan lag giee ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰਾ ਤੇਰੇ ਨਾਲ ਪ੍ਰੇਮ ਹੋ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "तो सौ मोरि लगनि लग गई ॥",
      "sourceLineId": "132801",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1246_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਾ ਤੇ ਭੇਸ ਧਰਤ ਇਹ ਭਈ ॥੧੩॥",
      "transliteration": "taa te bhes dharat ieh bhiee ||13||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਇਹ ਭੇਸ ਧਾਰਨ ਕੀਤਾ ਹੈ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1246,
      "hindi": "",
      "hindiTransliteration": "ता ते भेस धरत इह भई ॥१३॥",
      "sourceLineId": "132802",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
