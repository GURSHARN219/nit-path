{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1247,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1247_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਬ ਤੁਮ ਹਮਰੇ ਸਾਥ ਬਿਹਾਰੋ ॥",
      "transliteration": "ab tum hamare saath bihaaro ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਤੁਸੀਂ ਮੇਰੇ ਨਾਲ ਰਮਣ ਕਰੋ",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "अब तुम हमरे साथ बिहारो ॥",
      "sourceLineId": "132803",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਸਤ੍ਰੀ ਕਰਿ ਗ੍ਰਿਹ ਮਹਿ ਮੁਹਿ ਬਾਰੋ ॥",
      "transliteration": "eisatree kar gireh meh muh baaro ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੈਨੂੰ ਇਸਤਰੀ ਬਣਾ ਕੇ ਘਰ ਲੈ ਜਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "इसत्री करि गृह महि मुहि बारो ॥",
      "sourceLineId": "132804",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਸ ਮੁਰਿ ਲਗਨ ਤੁਮੂ ਪਰ ਲਾਗੀ ॥",
      "transliteration": "jas mur lagan tumoo par laagee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਮੇਰਾ ਤੁਹਾਡੇ ਨਾਲ ਪ੍ਰੇਮ ਪੈ ਗਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "जस मुरि लगन तुमू पर लागी ॥",
      "sourceLineId": "132805",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਸ ਤੁਮ ਹੋਹੁ ਮੋਰ ਅਨੁਰਾਗੀ ॥੧੪॥",
      "transliteration": "tas tum hoh mor anuraagee ||14||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਤਰ੍ਰਹਾ ਤੁਸੀਂ ਮੇਰੇ ਪ੍ਰੇਮੀ ਹੋ ਜਾਓ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "तस तुम होहु मोर अनुरागी ॥१४॥",
      "sourceLineId": "132806",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਆਨੰਦ ਭਯੋ ਕੁਅਰ ਕੇ ਚੀਤਾ ॥",
      "transliteration": "aana(n)dh bhayo kuar ke cheetaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰ ਦਾ ਮਨ ਪ੍ਰਸੰਨ ਹੋ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "आनंद भयो कुअर के चीता ॥",
      "sourceLineId": "132807",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਨੁ ਕਰਿ ਮਿਲੀ ਰਾਮ ਕਹ ਸੀਤਾ ॥",
      "transliteration": "jan kar milee raam keh seetaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਰਾਮ ਨੂੰ ਸੀਤਾ ਮਿਲ ਗਈ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "जनु करि मिली राम कह सीता ॥",
      "sourceLineId": "132808",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭੋਜਨ ਜਾਨੁ ਛੁਧਾਤਰੁ ਪਾਈ ॥",
      "transliteration": "bhojan jaan chhudhaatar paiee ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਭੁਖੇ ਨੂੰ ਭੋਜਨ ਮਿਲ ਗਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "भोजन जानु छुधातरु पाई ॥",
      "sourceLineId": "132809",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਨੁ ਨਲ ਮਿਲੀ ਦਮਾਵਤਿ ਆਈ ॥੧੫॥",
      "transliteration": "jan nal milee dhamaavat aaiee ||15||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਨਲ ਨੂੰ ਦਮਯੰਤੀ ਆ ਕੇ ਮਿਲ ਪਈ ਹੋਵੇ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "जनु नल मिली दमावति आई ॥१५॥",
      "sourceLineId": "132810",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਉਹੀ ਬ੍ਰਿਛ ਤਰ ਤਾ ਕੌ ਭਜਾ ॥",
      "transliteration": "auhee birachh tar taa kau bhajaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਬ੍ਰਿਛ ਹੇਠਾ ਉਸ ਨਾਲ ਸੰਯੋਗ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "उही बृछ तर ता कौ भजा ॥",
      "sourceLineId": "132811",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਆਸਨ ਕਹ ਸਜਾ ॥",
      "transliteration": "bhaat bhaat aasan keh sajaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦੇ ਆਸਣ ਸਜਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "भाति भाति आसन कह सजा ॥",
      "sourceLineId": "132812",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਾਹਿ ਸਿੰਘ ਕੋ ਚਰਮ ਨਿਕਾਰੀ ॥",
      "transliteration": "taeh si(n)gh ko charam nikaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਸ਼ੇਰ ਦੀ ਖਲ੍ਰਹ ਉਤਾਰੀ",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "ताहि सिंघ को चरम निकारी ॥",
      "sourceLineId": "132813",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭੋਗ ਕਰੇ ਤਾ ਪਰ ਨਰ ਨਾਰੀ ॥੧੬॥",
      "transliteration": "bhog kare taa par nar naaree ||16||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਉਤੇ ਇਸਤਰੀ ਮਰਦ (ਦੋਹਾ) ਭੋਗ ਕੀਤਾ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "भोग करे ता पर नर नारी ॥१६॥",
      "sourceLineId": "132814",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਾ ਕੋ ਨਾਮ ਅਪਛਰਾ ਧਰਾ ॥",
      "transliteration": "taa ko naam apachharaa dharaa ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜ ਕੁਮਾਰ ਨੇ) ਉਸ ਦਾ ਨਾ ਅਪੱਛਰਾ ਰਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "ता को नाम अपछरा धरा ॥",
      "sourceLineId": "132815",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਹੀ ਕਿ ਰੀਝਿ ਮੋਹਿ ਇਹ ਬਰਾ ॥",
      "transliteration": "kahee k reejh moh ieh baraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਧੁੰਮਾ ਦਿੱਤਾ ਕਿ ਇਸ ਨੇ ਪ੍ਰਸੰਨ ਹੋ ਕੇ ਮੈਨੂੰ ਵਰਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "कही कि रीझि मोहि इह बरा ॥",
      "sourceLineId": "132816",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਇਹ ਛਲ ਤਾਹਿ ਨਾਰਿ ਕਰਿ ਲ੍ਯਾਯੋ ॥",
      "transliteration": "eeh chhal taeh naar kar layaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਉਸ ਨੂੰ ਇਸਤਰੀ ਬਣਾ ਕੇ ਲੈ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "इह छल ताहि नारि करि ल्यायो ॥",
      "sourceLineId": "132817",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰੂਪ ਕੇਤੁ ਪਿਤੁ ਭੇਦ ਨ ਪਾਯੋ ॥੧੭॥",
      "transliteration": "roop ket pit bhedh na paayo ||17||",
      "translation": "",
      "punjabiViakhya": "ਪਿਤਾ ਰੂਪ ਕੇਤੁ ਕੁਝ ਵੀ ਭੇਦ ਨਾ ਪਾ ਸਕਿਆ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "रूप केतु पितु भेद न पायो ॥१७॥",
      "sourceLineId": "132818",
      "sourceShabadId": "12512",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "132819",
      "sourceShabadId": "12513",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਇਹ ਛਲ ਤਾ ਕੌ ਬ੍ਯਾਹਿ ਕੈ ਲੈ ਆਯੋ ਨਿਜੁ ਧਾਮ ॥",
      "transliteration": "eeh chhal taa kau bayaeh kai lai aayo nij dhaam ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਉਸ ਨੂੰ ਵਿਆਹ ਕੇ ਆਪਣੇ ਘਰ ਲੈ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "इह छल ता कौ ब्याहि कै लै आयो निजु धाम ॥",
      "sourceLineId": "132820",
      "sourceShabadId": "12513",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਲੋਕ ਅਪਛਰਾ ਤਿਹ ਲਖੈ ਕੋਊ ਨ ਜਾਨੈ ਬਾਮ ॥੧੮॥",
      "transliteration": "lok apachharaa teh lakhai kouoo na jaanai baam ||18||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਉਸ ਨੂੰ ਅਪੱਛਰਾ ਹੀ ਸਮਝਦੇ, ਕੋਈ ਵੀ ਇਸਤਰੀ ਨਾ ਮੰਨਦਾ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "लोक अपछरा तिह लखै कोऊ न जानै बाम ॥१८॥",
      "sourceLineId": "132821",
      "sourceShabadId": "12513",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨ੍ਰਿਪ ਸੁਤ ਬਰਾ ਕਰੌਲ ਹ੍ਵੈ ਭਈ ਅਨਾਥ ਸਨਾਥ ॥",
      "transliteration": "nirap sut baraa karaual havai bhiee anaath sanaath ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਕਾਰੀ ਬਣ ਕੇ ਉਸ ਨੇ ਰਾਜ ਕੁਮਾਰ ਨਾਲ ਵਿਆਹ ਕਰ ਲਿਆ ਅਤੇ ਅਨਾਥ ਤੋਂ ਸਨਾਥ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "नृप सुत बरा करौल ह्वै भई अनाथ सनाथ ॥",
      "sourceLineId": "132822",
      "sourceShabadId": "12513",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਭਹੂੰ ਸਿਰ ਰਾਨੀ ਭਈ ਇਹ ਬਿਧਿ ਛਲ ਕੇ ਸਾਥ ॥੧੯॥",
      "transliteration": "sabhahoo(n) sir raanee bhiee ieh bidh chhal ke saath ||19||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦੇ ਛਲ ਨਾਲ ਉਹ ਸਭ ਦੇ ਸਿਰ ਉਤੇ ਰਾਣੀ (ਵਜੋਂ ਪ੍ਰਤਿਸ਼ਠਿਤ) ਹੋਈ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "सभहूँ सिर रानी भई इह बिधि छल के साथ ॥१९॥",
      "sourceLineId": "132823",
      "sourceShabadId": "12513",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋ ਸੌ ਅਠਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੯੮॥੫੭੬੯॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dho sau aThaanavo charitr samaapatam sat subham sat ||298||5769||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੯੮ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੯੮॥੫੭੬੯॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दो सौ अठानवो चरित्र समापतम सतु सुभम सतु ॥२९८॥५७६९॥अफजूँ॥",
      "sourceLineId": "132824",
      "sourceShabadId": "12513",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "132825",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚੰਦ੍ਰ ਚੂੜ ਇਕ ਰਹਤ ਭੂਪਾਲਾ ॥",
      "transliteration": "cha(n)dhr chooR ik rahat bhoopaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਦ੍ਰ ਚੂੜ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਰਹਿੰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "चंद्र चूड़ इक रहत भूपाला ॥",
      "sourceLineId": "132826",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਮਿਤ ਪ੍ਰਭਾ ਜਾ ਕੇ ਗ੍ਰਿਹ ਬਾਲਾ ॥",
      "transliteration": "amit prabhaa jaa ke gireh baalaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਘਰ ਅਮਿਤ ਪ੍ਰਭਾ ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "अमित प्रभा जा के गृह बाला ॥",
      "sourceLineId": "132827",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਾ ਸੀ ਦੂਸਰਿ ਜਗ ਮਹਿ ਨਾਹੀ ॥",
      "transliteration": "taa see dhoosar jag meh naahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ ਜਗ ਵਿਚ ਦੂਜੀ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "ता सी दूसरि जग महि नाही ॥",
      "sourceLineId": "132828",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਰੀ ਨਾਗਨੀ ਨਿਰਖਿ ਲਜਾਹੀ ॥੧॥",
      "transliteration": "naree naaganee nirakh lajaahee ||1||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਵੇਖ ਕੇ ਨਰੀ ਅਤੇ ਨਾਗਨੀ ਲਜਾਉਾਂਦੀਆਂ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "नरी नागनी निरखि लजाही ॥१॥",
      "sourceLineId": "132829",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਾਹਿਕ ਹੁਤੋ ਅਧਿਕ ਧਨਵਾਨਾ ॥",
      "transliteration": "saahik huto adhik dhanavaanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ) ਇਕ ਬਹੁਤ ਧਨਵਾਨ ਸ਼ਾਹ ਹੁੰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "साहिक हुतो अधिक धनवाना ॥",
      "sourceLineId": "132830",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਾ ਸੌ ਧਨੀ ਨ ਜਗ ਮੈ ਆਨਾ ॥",
      "transliteration": "jaa sau dhanee na jag mai aanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਸੰਸਾਰ ਵਿਚ ਕੋਈ ਹੋਰ ਧਨੀ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "जा सौ धनी न जग मै आना ॥",
      "sourceLineId": "132831",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਛਲ ਦੇਇ ਦੁਹਿਤਾ ਤਾ ਕੇ ਘਰ ॥",
      "transliteration": "achhal dhei dhuhitaa taa ke ghar ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਘਰ ਅਛਲ ਦੇਈ ਨਾ ਦੀ ਪੁੱਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "अछल देइ दुहिता ता के घर ॥",
      "sourceLineId": "132832",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਹਤ ਪੰਡਿਤਾ ਸਭ ਮਤਿ ਹਰਿ ਕਰਿ ॥੨॥",
      "transliteration": "rahat pa(n)dditaa sabh mat har kar ||2||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਪੰਡਿਤਾ ਦੀ ਸਾਰੀ ਬੁੱਧੀ ਨੂੰ ਚੁਰਾਈ ਰਖਦੀ ਸੀ (ਅਰਥਾਤ-ਬਹੁਤ ਬੁੱਧੀਮਾਨ ਸੀ) ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "रहत पंडिता सभ मति हरि करि ॥२॥",
      "sourceLineId": "132833",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚੰਦ੍ਰ ਚੂੜ ਕੋ ਹੁਤੋ ਪੁਤ੍ਰ ਇਕ ॥",
      "transliteration": "cha(n)dhr chooR ko huto putr ik ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਦ੍ਰ ਚੂੜ ਦਾ ਇਕ ਪੁੱਤਰ ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "चंद्र चूड़ को हुतो पुत्र इक ॥",
      "sourceLineId": "132834",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪੜਾ ਬ੍ਯਾਕਰਨ ਅਰੁ ਸਾਸਤ੍ਰ ਨਿਕ ॥",
      "transliteration": "paRaa bayaakaran ar saasatr nik ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਵਿਆਕਰਨ ਅਤੇ ਅਨੇਕ ਸ਼ਾਸਤ੍ਰ ਪੜ੍ਰਹਿਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "पड़ा ब्याकरन अरु सासत्र निक ॥",
      "sourceLineId": "132835",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਾ ਕੋ ਨਾਮ ਨ ਕਹਬੇ ਆਵੈ ॥",
      "transliteration": "taa ko naam na kahabe aavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਨਾਮ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "ता को नाम न कहबे आवै ॥",
      "sourceLineId": "132836",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਲਿਖਤ ਊਖ ਲਿਖਨੀ ਹ੍ਵੈ ਜਾਵੈ ॥੩॥",
      "transliteration": "likhat uookh likhanee havai jaavai ||3||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਲਿਖੀਏ ਤਾ ਗੰਨੇ ਜਿੰਨੀ ਲੰਬੀ ਕਲਮ (ਘਿਸ ਕੇ ਸਾਧਾਰਨ) ਕਲਮ ਹੋ ਜਾਵੇਗੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "लिखत ऊख लिखनी ह्वै जावै ॥३॥",
      "sourceLineId": "132837",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਕ ਦਿਨ ਕੁਅਰ ਅਖੇਟਕ ਗਯੋ ॥",
      "transliteration": "eik dhin kuar akheTak gayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਰਾਜ ਕੁਮਾਰ ਸ਼ਿਕਾਰ ਖੇਡਣ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "इक दिन कुअर अखेटक गयो ॥",
      "sourceLineId": "132838",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਾਹੁ ਸੁਤਾ ਕੋ ਨਿਰਖਤ ਭਯੋ ॥",
      "transliteration": "saahu sutaa ko nirakhat bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਨੂੰ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "साहु सुता को निरखत भयो ॥",
      "sourceLineId": "132839",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਵਾ ਕੀ ਲਗੀ ਲਗਨ ਇਹ ਸੰਗਾ ॥",
      "transliteration": "vaa kee lagee lagan ieh sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਵੀ ਲਗਨ ਇਸ ਨਾਲ ਲਗ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "वा की लगी लगन इह संगा ॥",
      "sourceLineId": "132840",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮਗਨ ਭਈ ਤਰੁਨੀ ਸਰਬੰਗਾ ॥੪॥",
      "transliteration": "magan bhiee tarunee saraba(n)gaa ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਹ) ਲੜਕੀ ਤਨੋ ਮਨੋ ਉਸ ਵਿਚ ਮਗਨ ਹੋ ਗਈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "मगन भई तरुनी सरबंगा ॥४॥",
      "sourceLineId": "132841",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚਤੁਰਿ ਦੂਤਿ ਇਕ ਤਹਾ ਪਠਾਈ ॥",
      "transliteration": "chatur dhoot ik tahaa paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਚਤੁਰ ਦੂਤੀ ਨੂੰ ਉਸ ਪਾਸ ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "चतुरि दूति इक तहा पठाई ॥",
      "sourceLineId": "132842",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਹਿਯਹੁ ਐਸ ਕੁਅਰ ਕਹ ਜਾਈ ॥",
      "transliteration": "kahiyahu aais kuar keh jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਕੰਵਰ ਨੂੰ ਜਾ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਹੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "कहियहु ऐस कुअर कह जाई ॥",
      "sourceLineId": "132843",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਮੋਰੇ ਘਰ ਆਵਹੁ ॥",
      "transliteration": "ek dhivas more ghar aavahu ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਮੇਰੇ ਘਰ ਆਓ",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "एक दिवस मोरे घर आवहु ॥",
      "sourceLineId": "132844",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਾਥ ਹਮਾਰੇ ਭੋਗ ਮਚਾਵਹੁ ॥੫॥",
      "transliteration": "saath hamaare bhog machaavahu ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੇ ਨਾਲ ਰਮਣ ਕਰੋ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "साथ हमारे भोग मचावहु ॥५॥",
      "sourceLineId": "132845",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਬ ਵਹੁ ਸਖੀ ਕੁਅਰ ਪਹਿ ਆਈ ॥",
      "transliteration": "tab vahu sakhee kuar peh aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਹ ਦੂਤੀ ਕੰਵਰ ਕੋਲ ਆਈ",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "तब वहु सखी कुअर पहि आई ॥",
      "sourceLineId": "132846",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਹੀ ਕੁਅਰਿ ਸੋ ਤਾਹਿ ਸੁਨਾਈ ॥",
      "transliteration": "kahee kuar so taeh sunaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਜੋ) ਕੁਮਾਰੀ ਨੇ ਕਿਹਾ ਸੀ, ਉਸ ਨੂੰ ਸੁਣਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "कही कुअरि सो ताहि सुनाई ॥",
      "sourceLineId": "132847",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬਿਹਸਿ ਸਾਜਨ ਇਹ ਭਾਤਿ ਉਚਾਰੀ ॥",
      "transliteration": "bihas saajan ieh bhaat uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਮਿਤਰ ਨੇ ਹਸ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "बिहसि साजन इह भाति उचारी ॥",
      "sourceLineId": "132848",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਹਿਯਹੁ ਜਾਇ ਐਸ ਤੁਮ ਪ੍ਯਾਰੀ ॥੬॥",
      "transliteration": "kahiyahu jai aais tum payaaree ||6||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੂੰ ਪਿਆਰੀ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਹੀਂ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "कहियहु जाइ ऐस तुम प्यारी ॥६॥",
      "sourceLineId": "132849",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1247_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਇਕ ਅਵਧੂਤ ਸੁ ਛਤ੍ਰ ਨ੍ਰਿਪਾਰਾ ॥",
      "transliteration": "eik avadhoot su chhatr nirapaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਅਵਧੂਤ ਛਤ੍ਰਪਤੀ ਰਾਜਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1247,
      "hindi": "",
      "hindiTransliteration": "इक अवधूत सु छत्र नृपारा ॥",
      "sourceLineId": "132850",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
