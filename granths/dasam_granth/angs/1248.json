{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1248,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1248_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੁਨਿਯਤ ਬਸਤ ਸਮੁਦ ਕੇ ਪਾਰਾ ॥",
      "transliteration": "suniyat basat samudh ke paaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਣਿਆ ਹੈ, ਸਮੁੰਦਰ ਦੇ ਪਾਰ ਰਹਿੰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "सुनियत बसत समुद के पारा ॥",
      "sourceLineId": "132851",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਹੈ ਅਵਧੂਤ ਮਤੀ ਦੁਹਿਤਾ ਤਿਹ ॥",
      "transliteration": "hai avadhoot matee dhuhitaa teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਅਵਧੂਤ ਮਤੀ ਨਾ ਦੀ (ਇਕ) ਪੁੱਤਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "है अवधूत मती दुहिता तिह ॥",
      "sourceLineId": "132852",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਵਰ ਨ ਘੜੀ ਬਿਧਾਤਾ ਸਮ ਜਿਹ ॥੭॥",
      "transliteration": "avar na ghaRee bidhaataa sam jeh ||7||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਵਿਧਾਤਾ ਨੇ ਹੋਰ ਕੋਈ ਘੜੀ ਨਹੀਂ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "अवर न घड़ी बिधाता सम जिह ॥७॥",
      "sourceLineId": "132853",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪ੍ਰਥਮ ਤੂ ਤਿਸੈ ਮੋਹਿ ਮਿਲਾਵੈ ॥",
      "transliteration": "pratham too tisai moh milaavai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਤੂੰ ਉਸ ਨੂੰ ਮੈਨੂੰ ਮਿਲਾ ਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "प्रथम तू तिसै मोहि मिलावै ॥",
      "sourceLineId": "132854",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਮੋ ਸੌ ਪਤਿ ਪਾਵੈ ॥",
      "transliteration": "taa paachhe mo sau pat paavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਿਛੋਂ ਮੇਰੇ ਵਰਗਾ ਪਤੀ ਪ੍ਰਾਪਤ ਕਰ।",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "ता पाछे मो सौ पति पावै ॥",
      "sourceLineId": "132855",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਯੌ ਜੋ ਕੋਟਿ ਉਪਾਵ ਬਨੈ ਹੈ ॥",
      "transliteration": "yau jo koT upaav banai hai ||",
      "translation": "",
      "punjabiViakhya": "ਉਾਂਜ ਜੇ ਤੂੰ ਕਰੋੜਾ ਉਪਾ ਕਰ ਲਏਾਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "यौ जो कोटि उपाव बनै है ॥",
      "sourceLineId": "132856",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤੌ ਮੋ ਸੋ ਨਹਿ ਭੋਗਨ ਪੈ ਹੈ ॥੮॥",
      "transliteration": "tau mo so neh bhogan pai hai ||8||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਵੀ ਤੂੰ ਮੇਰੇ ਨਾਲ ਰਮਣ ਨਹੀਂ ਕਰ ਸਕੇਾਂਗੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "तौ मो सो नहि भोगन पै है ॥८॥",
      "sourceLineId": "132857",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਯੌ ਹੀ ਸਖੀ ਜਾਇ ਤਿਹ ਕਹੀ ॥",
      "transliteration": "yau hee sakhee jai teh kahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਤਰ੍ਰਹਾ ਸਖੀ ਨੇ ਜਾ ਕੇ ਉਸ ਨੂੰ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "यौ ही सखी जाइ तिह कही ॥",
      "sourceLineId": "132858",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਨ ਬਚ ਕੁਅਰਿ ਚਕ੍ਰਿਤ ਹ੍ਵੈ ਰਹੀ ॥",
      "transliteration": "man bach kuar chakirat havai rahee ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ ਸੁਣ ਕੇ) ਕੁਮਾਰੀ ਮਨ ਅਤੇ ਬਚਨ ਤੋਂ ਹੈਰਾਨ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "मन बच कुअरि चकृत ह्वै रही ॥",
      "sourceLineId": "132859",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚਿਤ ਮੌ ਅਨਿਕ ਚਟਪਟੀ ਲਾਗੀ ॥",
      "transliteration": "chit mau anik chaTapaTee laagee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਮਨ ਵਿਚ ਬਹੁਤ ਬੇਚੈਨੀ ਹੋਣ ਲਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "चित मौ अनिक चटपटी लागी ॥",
      "sourceLineId": "132860",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਾ ਤੇ ਨੀਂਦ ਭੂਖ ਸਭ ਭਾਗੀ ॥੯॥",
      "transliteration": "taa te nee(n)dh bhookh sabh bhaagee ||9||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਨੀਂਦਰ ਭੁਖ ਸਭ ਚਲੀ ਗਈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "ता ते नींद भूख सभ भागी ॥९॥",
      "sourceLineId": "132861",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਮੁੰਦਰ ਪਾਰ ਜਾਯੋ ਨਹਿ ਜਾਵੈ ॥",
      "transliteration": "samu(n)dhar paar jaayo neh jaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ ਤਕ) ਸਮੁੰਦਰ ਪਾਰ ਜਾਇਆ ਨਹੀਂ ਜਾਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "समुँदर पार जायो नहि जावै ॥",
      "sourceLineId": "132862",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਊ ਕੁਅਰਿ ਕੋ ਸਾਤਿ ਨ ਆਵੈ ॥",
      "transliteration": "tuoo kuar ko saat na aavai ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਕੁਮਾਰੀ ਨੂੰ ਸ਼ਾਤੀ ਨਹੀਂ ਮਿਲਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "तऊ कुअरि को साति न आवै ॥",
      "sourceLineId": "132863",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਾਜ ਤਹਾ ਚਲਿਬੇ ਕੋ ਕਰਾ ॥",
      "transliteration": "saaj tahaa chalibe ko karaa ||",
      "translation": "",
      "punjabiViakhya": "(ਕੁਮਾਰੀ ਨੇ) ਉਥੇ ਜਾਣ ਲਈ ਤਿਆਰੀ ਕਰ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "साज तहा चलिबे को करा ॥",
      "sourceLineId": "132864",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤੀਰਥ ਜਾਤ ਹੌ ਪਿਤਹਿ ਉਚਰਾ ॥੧੦॥",
      "transliteration": "teerath jaat hau piteh ucharaa ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਿਤਾ ਨੂੰ ਤੀਰਥਾ ਉਤੇ ਜਾਣਾ ਦਸਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "तीरथ जात हौ पितहि उचरा ॥१०॥",
      "sourceLineId": "132865",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਾਜ ਬਾਜ ਸਭ ਕੀਆ ਤ੍ਯਾਰਾ ॥",
      "transliteration": "saaj baaj sabh keeaa tayaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਜ਼ ਬਾਜ਼ ਦੀ ਸਾਰੀ ਤਿਆਰੀ ਮੁਕੰਮਲ ਕਰ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "साज बाज सभ कीआ त्यारा ॥",
      "sourceLineId": "132866",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਹ ਹ੍ਵੈ ਚਲੀ ਬਾਜ ਅਸਵਾਰਾ ॥",
      "transliteration": "teh havai chalee baaj asavaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘੋੜੇ ਉਤੇ ਸਵਾਰ ਹੋ ਕੇ ਚਲ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "तह ह्वै चली बाज असवारा ॥",
      "sourceLineId": "132867",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੇਤਬੰਧ ਰਾਮੇਸ੍ਵਰ ਗਈ ॥",
      "transliteration": "setaba(n)dh raamesavair giee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸੇਤਬੰਧ ਰਾਮੇਸ਼੍ਵਰ ਪਹੁੰਚ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "सेतबंध रामेस्वर गई ॥",
      "sourceLineId": "132868",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਹ੍ਰਿਦੈ ਬਿਚਾਰਤ ਭਈ ॥੧੧॥",
      "transliteration": "eeh bidh hiradhai bichaarat bhiee ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਨ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਵਿਚਾਰ ਕਰਨ ਲਗੀ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "इह बिधि हृदै बिचारत भई ॥११॥",
      "sourceLineId": "132869",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਾ ਤੇ ਹ੍ਵੈ ਜਹਾਜ ਅਸਵਾਰਾ ॥",
      "transliteration": "taa te havai jahaaj asavaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੋਂ ਜਹਾਜ਼ ਵਿਚ ਸਵਾਰ ਹੋਈ",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "ता ते ह्वै जहाज असवारा ॥",
      "sourceLineId": "132870",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗਈ ਸਿੰਗਲਾਦੀਪ ਮਝਾਰਾ ॥",
      "transliteration": "giee si(n)galaadheep majhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਿੰਗਲਾਦੀਪ ਵਿਚ ਜਾ ਪਹੁੰਚੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "गई सिंगलादीप मझारा ॥",
      "sourceLineId": "132871",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਹ ਤਿਹ ਸੁਨਾ ਰਾਜ ਕੋ ਧਾਮਾ ॥",
      "transliteration": "jeh teh sunaa raaj ko dhaamaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਧਰ ਨੂੰ ਰਾਜੇ ਦਾ ਮਹੱਲ ਸੁਣਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "जह तिह सुना राज को धामा ॥",
      "sourceLineId": "132872",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਾਤ ਭਈ ਤਹ ਹੀ ਕੌ ਬਾਮਾ ॥੧੨॥",
      "transliteration": "jaat bhiee teh hee kau baamaa ||12||",
      "translation": "",
      "punjabiViakhya": "ਉਧਰ ਨੂੰ ਹੀ ਉਹ ਇਸਤਰੀ ਚਲੀ ਗਈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "जात भई तह ही कौ बामा ॥१२॥",
      "sourceLineId": "132873",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਹ ਗੀ ਪੁਰਖ ਭੇਸ ਕੋ ਕਰਿ ਕੈ ॥",
      "transliteration": "teh gee purakh bhes ko kar kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਉਹ ਭਾਤ ਭਾਤ ਦੇ ਗਹਿਣੇ ਪਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "तह गी पुरख भेस को करि कै ॥",
      "sourceLineId": "132874",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਭੂਖਨ ਧਰਿ ਕੈ ॥",
      "transliteration": "bhaat bhaat ke bhookhan dhar kai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੁਰਸ਼ ਭੇਸ ਧਾਰਨ ਕਰ ਕੇ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के भूखन धरि कै ॥",
      "sourceLineId": "132875",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਬ ਅਵਧੂਤ ਮਤੀ ਤਿਹ ਹੇਰਾ ॥",
      "transliteration": "jab avadhoot matee teh heraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਅਵਧੂਤ ਮਤੀ ਨੇ ਉਸ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "जब अवधूत मती तिह हेरा ॥",
      "sourceLineId": "132876",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਜਾਨ੍ਯੋ ਕਹੂੰ ਕੇਰਾ ॥੧੩॥",
      "transliteration": "raaj kuar jaanayo kahoo(n) keraa ||13||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਕਿਸੇ (ਦੇਸ਼) ਦਾ ਰਾਜ ਕੁਮਾਰ ਸਮਝਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "राज कुअर जान्यो कहूँ केरा ॥१३॥",
      "sourceLineId": "132877",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਿਰਖਤ ਕੁਅਰਿ ਮਦਨ ਬਸਿ ਭਈ ॥",
      "transliteration": "nirakhat kuar madhan bas bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਰਾਜ ਕੁਮਾਰੀ ਕਾਮ ਵਸ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "निरखत कुअरि मदन बसि भई ॥",
      "sourceLineId": "132878",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅੰਗ ਅੰਗ ਬਿਹਬਲ ਹ੍ਵੈ ਗਈ ॥",
      "transliteration": "a(n)g a(n)g bihabal havai giee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਅੰਗ ਅੰਗ ਬਿਹਬਲ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "अंग अंग बिहबल ह्वै गई ॥",
      "sourceLineId": "132879",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚਿਤ ਮਹਿ ਕਹਾ ਇਸੀ ਕਹ ਬਰਿ ਹੌ ॥",
      "transliteration": "chit meh kahaa isee keh bar hau ||",
      "translation": "",
      "punjabiViakhya": "ਚਿਤ ਵਿਚ ਕਹਿਣ ਲਗੀ ਕਿ ਇਸੇ ਨੂੰ ਵਰਾਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "चित महि कहा इसी कह बरि हौ ॥",
      "sourceLineId": "132880",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਾਤਰ ਘਾਇ ਕਟਾਰੀ ਮਰਿ ਹੌ ॥੧੪॥",
      "transliteration": "naatar ghai kaTaaree mar hau ||14||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਕਟਾਰ ਮਾਰ ਕੇ ਮਰ ਜਾਵਾਗੀ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "नातर घाइ कटारी मरि हौ ॥१४॥",
      "sourceLineId": "132881",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੇਖੈ ਲਗੀ ਸੀਸ ਨਿਹੁਰਾਈ ॥",
      "transliteration": "dhekhai lagee sees nihuraiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸਿਰ ਨੀਵਾ ਕਰ ਕੇ ਵੇਖਣ ਲਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "देखै लगी सीस निहुराई ॥",
      "sourceLineId": "132882",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਿਹ ਤ੍ਰਿਯ ਘਾਤ ਇਹੈ ਕਰ ਆਈ ॥",
      "transliteration": "teh tiray ghaat ihai kar aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਇਸਤਰੀ ਮੌਕਾ ਤਾੜ ਕੇ ਇਥੇ ਆ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "तिह तृय घात इहै कर आई ॥",
      "sourceLineId": "132883",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤੁਰੰਗ ਧਵਾਇ ਜਾਤ ਤਹ ਭਈ ॥",
      "transliteration": "tura(n)g dhavai jaat teh bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜੇ ਨੂੰ ਦੌੜਾ ਕੇ ਉਥੇ ਜਾ ਪਹੁੰਚੀ",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "तुरंग धवाइ जात तह भई ॥",
      "sourceLineId": "132884",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਿੰਘਨਿ ਜਾਨੁ ਮ੍ਰਿਗੀ ਗਹਿ ਲਈ ॥੧੫॥",
      "transliteration": "si(n)ghan jaan miragee geh liee ||15||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਸ਼ੇਰਨੀ ਨੇ ਹਿਰਨੀ ਪਕੜ ਲਈ ਹੋਵੇ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "सिंघनि जानु मृगी गहि लई ॥१५॥",
      "sourceLineId": "132885",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਝਟਕਿ ਝਰੋਖਾ ਤੇ ਗਹਿ ਲਈ ॥",
      "transliteration": "jhaTak jharokhaa te geh liee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਝਰੋਖੇ ਤੋਂ ਝਟਕਾ ਦੇ ਕੇ ਪਕੜ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "झटकि झरोखा ते गहि लई ॥",
      "sourceLineId": "132886",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਾਧਤ ਸਾਥ ਪ੍ਰਿਸਟ ਕੇ ਭਈ ॥",
      "transliteration": "baadhat saath pirasaT ke bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਿਠ ਨਾਲ ਬੰਨ੍ਰਹ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "बाधत साथ पृसट के भई ॥",
      "sourceLineId": "132887",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹਾਹਾ ਭਾਖਿ ਲੋਗ ਪਚਿ ਹਾਰੇ ॥",
      "transliteration": "haahaa bhaakh log pach haare ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਲੋਗ ਹਾਹਾਕਾਰ ਕਰ ਕੇ ਥਕ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "हाहा भाखि लोग पचि हारे ॥",
      "sourceLineId": "132888",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਾਖਿ ਨ ਸਕੇ ਤਾਹਿ ਰਖਵਾਰੇ ॥੧੬॥",
      "transliteration": "raakh na sake taeh rakhavaare ||16||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਸ ਨੂੰ ਕੋਈ ਵੀ ਰਖਵਾਲਾ ਬਚਾ ਨਾ ਸਕਿਆ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "राखि न सके ताहि रखवारे ॥१६॥",
      "sourceLineId": "132889",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਾਧਿ ਪ੍ਰਿਸਟਿ ਤਿਹ ਤੁਰੰਗ ਧਵਾਯੋ ॥",
      "transliteration": "baadh pirasaT teh tura(n)g dhavaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਪਿਠ ਨਾਲ ਬੰਨ੍ਰਹ ਕੇ (ਇਸਤਰੀ ਨੇ) ਘੋੜਾ ਭਜਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "बाधि पृसटि तिह तुरंग धवायो ॥",
      "sourceLineId": "132890",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਏਕੈ ਬਾਨ ਮਿਲਾ ਸੋ ਘਾਯੋ ॥",
      "transliteration": "ekai baan milaa so ghaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਟਕਰਿਆ, ਉਸ ਨੂੰ ਇਕੋ ਬਾਣ ਨਾਲ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "एकै बान मिला सो घायो ॥",
      "sourceLineId": "132891",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਾ ਕਹ ਜੀਤਿ ਧਾਮ ਲੈ ਆਈ ॥",
      "transliteration": "taa keh jeet dhaam lai aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜਿਤ ਕੇ ਘਰ ਲੈ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "ता कह जीति धाम लै आई ॥",
      "sourceLineId": "132892",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਖੀ ਕੁਅਰ ਕੇ ਧਾਮ ਪਠਾਈ ॥੧੭॥",
      "transliteration": "sakhee kuar ke dhaam paThaiee ||17||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਸਖੀ ਨੂੰ ਰਾਜ ਕੁਮਾਰ ਦੇ ਘਰ ਭੇਜ ਦਿੱਤਾ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "सखी कुअर के धाम पठाई ॥१७॥",
      "sourceLineId": "132893",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜੋ ਤੁਮ ਕਹਾ ਕਾਜ ਮੈ ਕਿਯਾ ॥",
      "transliteration": "jo tum kahaa kaaj mai kiyaa ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿ ਭੇਜਿਆ) ਜੋ ਤੂੰ ਕਿਹਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "जो तुम कहा काज मै किया ॥",
      "sourceLineId": "132894",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਪਨੋ ਬੋਲ ਨਿਬਾਹਹੁ ਪਿਯਾ ॥",
      "transliteration": "apano bol nibaahahu piyaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਕੰਮ ਮੈਂ ਕਰ ਦਿੱਤਾ ਹੈ। ਹੇ ਪ੍ਰਿਯ!",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "अपनो बोल निबाहहु पिया ॥",
      "sourceLineId": "132895",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪ੍ਰਥਮ ਬ੍ਯਾਹਿ ਮੋ ਕੌ ਲੈ ਜਾਵੌ ॥",
      "transliteration": "pratham bayaeh mo kau lai jaavau ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਤੁਸੀਂ ਆਪਣਾ ਬਚਨ ਪੂਰਾ ਕਰੋ। ਪਹਿਲਾ ਮੈਨੂੰ ਵਿਆਹ ਕੇ ਲੈ ਜਾਓ,",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "प्रथम ब्याहि मो कौ लै जावौ ॥",
      "sourceLineId": "132896",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਾ ਪਾਛੇ ਯਾ ਕਹ ਤੁਮ ਪਾਵੌ ॥੧੮॥",
      "transliteration": "taa paachhe yaa keh tum paavau ||18||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਿਛੋਂ ਤੁਸੀਂ ਇਸ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰੋ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "ता पाछे या कह तुम पावौ ॥१८॥",
      "sourceLineId": "132897",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1248_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਤਬ ਹੀ ਤਹ ਆਯੋ ॥",
      "transliteration": "raaj kuar tab hee teh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰ ਤਦ ਹੀ ਉਥੇ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1248,
      "hindi": "",
      "hindiTransliteration": "राज कुअर तब ही तह आयो ॥",
      "sourceLineId": "132898",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
