{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1249,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1249_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਾ ਸੌ ਪ੍ਰਥਮੈ ਬ੍ਯਾਹ ਕਰਾਯੋ ॥",
      "transliteration": "taa sau prathamai bayaeh karaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਹਿਲਾ ਉਸ ਨਾਲ ਵਿਆਹ ਕਰਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "ता सौ प्रथमै ब्याह करायो ॥",
      "sourceLineId": "132899",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਹੁਰੌ ਬ੍ਯਾਹਿ ਤਾਹਿ ਲੈ ਗਯੋ ॥",
      "transliteration": "bahurau bayaeh taeh lai gayo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਉਸ (ਅਵਧੂਤ ਕੰਨਿਆ) ਨੂੰ ਵਿਆਹ ਕੇ ਲੈ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "बहुरौ ब्याहि ताहि लै गयो ॥",
      "sourceLineId": "132900",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਸਿ ਚਰਿਤ੍ਰ ਚੰਚਲਾ ਦਿਖਯੋ ॥੧੯॥",
      "transliteration": "as charitr cha(n)chalaa dhikhayo ||19||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਚਰਿਤ੍ਰ ਉਸ ਇਸਤਰੀ ਨੇ ਵਿਖਾਇਆ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "असि चरित्र चंचला दिखयो ॥१९॥",
      "sourceLineId": "132901",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪ੍ਰਥਮਹਿ ਪਾਰ ਸਮੁੰਦ ਕੈ ਗਈ ॥",
      "transliteration": "prathameh paar samu(n)dh kai giee ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਸਮੁੰਦਰ ਦੇ ਪਾਰ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "प्रथमहि पार समुँद कै गई ॥",
      "sourceLineId": "132902",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰਾਜ ਸੁਤਹਿ ਹਰਿ ਲ੍ਯਾਵਤ ਭਈ ॥",
      "transliteration": "raaj suteh har layaavat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਥੋਂ) ਰਾਜ ਕੁਮਾਰੀ ਨੂੰ ਭਜਾ ਲਿਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "राज सुतहि हरि ल्यावत भई ॥",
      "sourceLineId": "132903",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਹੁਰੌ ਮਨ ਭਾਵਤ ਪਤਿ ਕਰਿਯੋ ॥",
      "transliteration": "bahurau man bhaavat pat kariyo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਮਨ ਭਾਉਾਂਦੇ ਪਤੀ ਨੂੰ ਪ੍ਰਾਪਤ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "बहुरौ मन भावत पति करियो ॥",
      "sourceLineId": "132904",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰ ਨ ਜਾਤ ਬਿਚਰਿਯੋ ॥੨੦॥",
      "transliteration": "tirayaa charitr na jaat bichariyo ||20||",
      "translation": "",
      "punjabiViakhya": "ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਨੂੰ ਵਿਚਾਰਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "तृया चरित्र न जात बिचरियो ॥२०॥",
      "sourceLineId": "132905",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋ ਸੌ ਨੰਨ੍ਯਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੯੯॥੫੭੮੯॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe dho sau na(n)nayaanavo charitr samaapatam sat subham sat ||299||5789||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੨੯੯ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੨੯੯॥੫੭੮੯॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे दो सौ नंन्यानवो चरित्र समापतम सतु सुभम सतु ॥२९९॥५७८९॥अफजूँ॥",
      "sourceLineId": "132906",
      "sourceShabadId": "12514",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "132907",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੀਸਸਾਰ ਕੇਤੁ ਇਕ ਰਾਜਾ ॥",
      "transliteration": "seesasaar ket ik raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੀਸਸਾਰ ਕੇਤੁ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "सीससार केतु इक राजा ॥",
      "sourceLineId": "132908",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਾ ਸੋ ਬਿਧਿ ਦੂਸਰ ਨ ਸਾਜਾ ॥",
      "transliteration": "jaa so bidh dhoosar na saajaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਵਿਧਾਤਾ ਨੇ ਦੂਜਾ ਨਹੀਂ ਸਾਜਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "जा सो बिधि दूसर न साजा ॥",
      "sourceLineId": "132909",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੀਸੈ ਸਾਰ ਦੇਇ ਤਿਹ ਰਾਨੀ ॥",
      "transliteration": "seesai saar dhei teh raanee ||",
      "translation": "",
      "punjabiViakhya": "ਸੀਸੈ ਸਾਰ ਦੇਈ ਨਾ ਦੀ ਉਸ ਦੀ ਰਾਣੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "सीसै सार देइ तिह रानी ॥",
      "sourceLineId": "132910",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਾ ਸਮ ਦੂਸਰ ਹ੍ਵੈ ਨ ਬਖਾਨੀ ॥੧॥",
      "transliteration": "jaa sam dhoosar havai na bakhaanee ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਸੁੰਦਰ ਹੋਰ ਕੋਈ ਨਹੀਂ ਕਹੀ ਜਾ ਸਕਦੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "जा सम दूसर ह्वै न बखानी ॥१॥",
      "sourceLineId": "132911",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਾ ਸੌ ਅਧਿਕ ਨ੍ਰਿਪਤਿ ਕੀ ਪ੍ਰੀਤਾ ॥",
      "transliteration": "taa sau adhik nirapat kee preetaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਰਾਜੇ ਦਾ ਬਹੁਤ ਪਿਆਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "ता सौ अधिक नृपति की प्रीता ॥",
      "sourceLineId": "132912",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਿਸ ਦਿਨ ਰਹੈ ਤਰੁਨਿ ਮੈ ਚੀਤਾ ॥",
      "transliteration": "nis dhin rahai tarun mai cheetaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਦਿਨ (ਉਹ) ਇਸਤਰੀ (ਉਸ ਦੇ) ਚਿਤ ਵਿਚ ਰਹਿੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "निस दिन रहै तरुनि मै चीता ॥",
      "sourceLineId": "132913",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਿਤਕ ਦਿਨਨ ਰਾਨੀ ਮਰਿ ਗਈ ॥",
      "transliteration": "kitak dhinan raanee mar giee ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਝ ਸਮੇਾਂ ਬਾਦ ਰਾਣੀ ਮਰ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "कितक दिनन रानी मरि गई ॥",
      "sourceLineId": "132914",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਾਜਾ ਕੀ ਉਦਾਸ ਮਤਿ ਭਈ ॥੨॥",
      "transliteration": "raajaa kee udhaas mat bhiee ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਦੀ ਬੁੱਧੀ ਉਦਾਸ ਹੋ ਗਈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "राजा की उदास मति भई ॥२॥",
      "sourceLineId": "132915",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਵਰ ਨਾਰਿ ਕੀ ਓਰ ਨ ਹੇਰੈ ॥",
      "transliteration": "avar naar kee or na herai ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ ਕਿਸੇ ਇਸਤਰੀ ਵਲ ਨਹੀਂ ਵੇਖਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "अवर नारि की ओर न हेरै ॥",
      "sourceLineId": "132916",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭੂਲ ਨ ਜਾਤ ਕਿਸੀ ਕੇ ਡੇਰੈ ॥",
      "transliteration": "bhool na jaat kisee ke dderai ||",
      "translation": "",
      "punjabiViakhya": "ਭੁਲ ਕੇ ਵੀ ਕਿਸੇ ਦੇ ਡੇਰੇ ਨਹੀਂ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "भूल न जात किसी के डेरै ॥",
      "sourceLineId": "132917",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾਰੀ ਔਰ ਅਧਿਕ ਦੁਖ ਪਾਵੈ ॥",
      "transliteration": "naaree aauar adhik dhukh paavai ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ ਇਸਤਰੀਆਂ ਬਹੁਤ ਦੁਖੀ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "नारी और अधिक दुख पावै ॥",
      "sourceLineId": "132918",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਾਥ ਮਿਲੇ ਬਿਨੁ ਮੈਨ ਸੰਤਾਵੈ ॥੩॥",
      "transliteration": "naath mile bin main sa(n)taavai ||3||",
      "translation": "",
      "punjabiViakhya": "ਕਿਉਾਂਕਿ ਨਾਥ ਨੂੰ ਮਿਲੇ ਬਿਨਾ (ਉਨ੍ਰਹਾ ਨੂੰ) ਕਾਮ ਸਤਾਉਾਂਦਾ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "नाथ मिले बिनु मैन संतावै ॥३॥",
      "sourceLineId": "132919",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਿਲਿ ਬੈਠੀ ਇਕ ਦਿਨ ਸਭ ਰਾਨੀ ॥",
      "transliteration": "mil baiThee ik dhin sabh raanee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਸਾਰੀਆਂ ਰਾਣੀਆਂ ਇਕੱਠੀਆਂ ਹੋਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "मिलि बैठी इक दिन सभ रानी ॥",
      "sourceLineId": "132920",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਆਪੁ ਬਿਖੈ ਮਿਲਿ ਕਰਤ ਕਹਾਨੀ ॥",
      "transliteration": "aap bikhai mil karat kahaanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਸ ਵਿਚ ਗੱਲਾ ਕਰਨ ਲਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "आपु बिखै मिलि करत कहानी ॥",
      "sourceLineId": "132921",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਇਹ ਜੜ ਪਤਿ ਮਤਿ ਕਿਨ ਹਰਿ ਲਈ ॥",
      "transliteration": "eeh jaR pat mat kin har liee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਮੂਰਖ ਪਤੀ ਦੀ ਅਕਲ (ਪਤਾ ਨਹੀਂ) ਕਿਸ ਨੇ ਹਰ ਲਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "इह जड़ पति मति किन हरि लई ॥",
      "sourceLineId": "132922",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਹਾ ਭਯੋ ਰਾਨੀ ਮਰਿ ਗਈ ॥੪॥",
      "transliteration": "kahaa bhayo raanee mar giee ||4||",
      "translation": "",
      "punjabiViakhya": "ਕੀ ਹੋਇਆ ਜੇ ਰਾਣੀ ਮਰ ਗਈ ਹੈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "कहा भयो रानी मरि गई ॥४॥",
      "sourceLineId": "132923",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਏਤੋ ਸੋਕ ਕਿਯੋ ਜਾ ਕੋ ਇਹ ॥",
      "transliteration": "eto sok kiyo jaa ko ieh ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਇਸ (ਰਾਜੇ) ਨੇ ਇਤਨਾ ਦੁਖ ਮੰਨਾਇਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "एतो सोक कियो जा को इह ॥",
      "sourceLineId": "132924",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਤਿ ਹਰਿ ਲਈ ਕਹਾ ਯਾ ਕੀ ਤਿਹ ॥",
      "transliteration": "mat har liee kahaa yaa kee teh ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਉਸ ਨੇ ਕਿਤੇ ਇਸ ਦੀ ਅਕਲ ਹੀ ਖੋਹ ਲਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "मति हरि लई कहा या की तिह ॥",
      "sourceLineId": "132925",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਹ੍ਵੈ ਹੈ ਤ੍ਰਿਯਾ ਨ੍ਰਿਪਨ ਕੇ ਘਨੀ ॥",
      "transliteration": "havai hai tirayaa nirapan ke ghanee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਿਆਂ ਦੇ ਘਰ ਬਹੁਤ ਇਸਤਰੀਆਂ ਹੁੰਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "ह्वै है तृया नृपन के घनी ॥",
      "sourceLineId": "132926",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਦਾ ਸਲਾਮਤਿ ਚਹਿਯਤ ਧਨੀ ॥੫॥",
      "transliteration": "sadhaa salaamat chahiyat dhanee ||5||",
      "translation": "",
      "punjabiViakhya": "(ਬਸ) ਪਤੀ ਸਦਾ ਸਲਾਮਤ ਰਹਿਣਾ ਚਾਹੀਦਾ ਹੈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "सदा सलामति चहियत धनी ॥५॥",
      "sourceLineId": "132927",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਖੀ ਏਕ ਸ੍ਯਾਨੀ ਤਹ ਅਹੀ ॥",
      "transliteration": "sakhee ek sayaanee teh ahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸਿਆਣੀ ਸਖੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "सखी एक स्यानी तह अही ॥",
      "sourceLineId": "132928",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਿਹ ਇਹ ਭਾਤਿ ਬਿਹਸਿ ਕਰਿ ਕਹੀ ॥",
      "transliteration": "teh ieh bhaat bihas kar kahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਹਸ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿਣ ਲਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "तिह इह भाति बिहसि करि कही ॥",
      "sourceLineId": "132929",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮੈ ਨ੍ਰਿਪ ਤੇ ਤ੍ਰਿਯ ਸੋਕ ਮਿਟੈਹੌ ॥",
      "transliteration": "mai nirap te tiray sok miTaihau ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਰਾਜੇ ਦਾ ਇਸਤਰੀ ਵਾਲਾ ਦੁਖ ਦੂਰ ਕਰਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "मै नृप ते तृय सोक मिटैहौ ॥",
      "sourceLineId": "132930",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਹੁਰਿ ਤਿਹਾਰੇ ਸਾਥ ਮਿਲੈਹੌ ॥੬॥",
      "transliteration": "bahur tihaare saath milaihau ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੁਹਾਡੇ ਨਾਲ ਫਿਰ ਮਿਲਾ ਦੇਵਾਗੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "बहुरि तिहारे साथ मिलैहौ ॥६॥",
      "sourceLineId": "132931",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਾਰਿਕ ਪਕਰਿ ਕੋਠਰੀ ਰਾਖਾ ॥",
      "transliteration": "jaarik pakar koTharee raakhaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਯਾਰ ਫੜ ਕੇ ਕੋਠੜੀ ਵਿਚ ਬੰਦ ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "जारिक पकरि कोठरी राखा ॥",
      "sourceLineId": "132932",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨ੍ਰਿਪ ਕੇ ਸੁਨਤ ਐਸ ਬਿਧਿ ਭਾਖਾ ॥",
      "transliteration": "nirap ke sunat aais bidh bhaakhaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੂੰ ਸੁਣਾ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "नृप के सुनत ऐस बिधि भाखा ॥",
      "sourceLineId": "132933",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਧ੍ਰਿਗ ਇਹ ਮੂੜ ਨ੍ਰਿਪ ਕੋ ਜੀਆ ॥",
      "transliteration": "dhirag ieh mooR nirap ko jeeaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਰਾਜੇ ਦੇ ਜੀਣ ਨੂੰ ਧਿੱਕਾਰ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "धृग इह मूड़ नृप को जीआ ॥",
      "sourceLineId": "132934",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਹ ਅਬਿਬੇਕ ਬਿਬੇਕ ਨ ਕੀਆ ॥੭॥",
      "transliteration": "jeh abibek bibek na keeaa ||7||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਵਿਵੇਕ ਅਤੇ ਅਵਿਵੇਕ ਵਿਚ (ਅੰਤਰ) ਨਹੀਂ ਕਰਦਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "जिह अबिबेक बिबेक न कीआ ॥७॥",
      "sourceLineId": "132935",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੁ ਤ੍ਰਿਯਾ ਔਰ ਸੌ ਭੋਗ ਕਮਾਵੈ ॥",
      "transliteration": "j tirayaa aauar sau bhog kamaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਇਸਤਰੀ ਕਿਸੇ ਹੋਰ ਨਾਲ ਭੋਗ ਕਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "जु तृया और सौ भोग कमावै ॥",
      "sourceLineId": "132936",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਾਤਨ ਸਾਥ ਪਤਿਹਿ ਉਰਝਾਵੈ ॥",
      "transliteration": "baatan saath pateh urajhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਗੱਲਾ ਨਾਲ ਹੀ ਪਤੀ ਨੂੰ ਰਿਝਾਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "बातन साथ पतिहि उरझावै ॥",
      "sourceLineId": "132937",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨ੍ਰਿਪ ਜੁ ਕੋਠਰੀ ਛੋਰਿ ਨਿਹਾਰੈ ॥",
      "transliteration": "nirap ju koTharee chhor nihaarai ||",
      "translation": "",
      "punjabiViakhya": "(ਜੇ) ਰਾਜਾ (ਆਪ ਉਸ ਦੀ) ਕੋਠੜੀ ਖੋਲ੍ਰਹ ਕੇ ਵੇਖੇ",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "नृप जु कोठरी छोरि निहारै ॥",
      "sourceLineId": "132938",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਾਚ ਝੂਠ ਤਬ ਆਪੁ ਬਿਚਾਰੈ ॥੮॥",
      "transliteration": "saach jhooTh tab aap bichaarai ||8||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸਚ ਝੂਠ ਦਾ ਆਪ ਵਿਚਾਰ ਕਰ ਲਵੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "साच झूठ तब आपु बिचारै ॥८॥",
      "sourceLineId": "132939",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨ੍ਰਿਪ ਕੇ ਸ੍ਰਵਨਨ ਧੁਨਿ ਇਹ ਪਰੀ ॥",
      "transliteration": "nirap ke sravanan dhun ieh paree ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਰਾਜੇ ਦੇ ਕੰਨਾ ਵਿਚ ਇਹ ਆਵਾਜ਼ ਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "नृप के स्रवनन धुनि इह परी ॥",
      "sourceLineId": "132940",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤੁਰਤੁ ਕੁਠਰੀਯਾ ਜਾਇ ਉਘਰੀ ॥",
      "transliteration": "turat kuThareeyaa jai ugharee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਤੁਰਤ ਜਾ ਕੇ ਕੋਠੜੀ ਖੋਲ੍ਰਹ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "तुरतु कुठरीया जाइ उघरी ॥",
      "sourceLineId": "132941",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹੇਰਾ ਜਬ ਵਹੁ ਮਨੁਛ ਬਨਾਈ ॥",
      "transliteration": "heraa jab vahu manuchh banaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਬੰਦੇ ਨੂੰ (ਰਾਜੇ ਨੇ) ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "हेरा जब वहु मनुछ बनाई ॥",
      "sourceLineId": "132942",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਬ ਐਸੇ ਤਿਹ ਕਹਾ ਰਿਸਾਈ ॥੯॥",
      "transliteration": "tab aaise teh kahaa risaiee ||9||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਗੁੱਸੇ ਨਾਲ ਉਸ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "तब ऐसे तिह कहा रिसाई ॥९॥",
      "sourceLineId": "132943",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਇਤੋ ਸੋਕ ਹਮ ਕੀਯੋ ਨਿਕਾਜਾ ॥",
      "transliteration": "eito sok ham keeyo nikaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਇਤਨਾ ਦੁਖ ਵਿਅਰਥ ਦਾ ਮੰਨਾਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "इतो सोक हम कीयो निकाजा ॥",
      "sourceLineId": "132944",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਇਹ ਨ ਲਹਤ ਥੋ ਐਸ ਨਿਲਾਜਾ ॥",
      "transliteration": "eeh na lahat tho aais nilaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਨਹੀਂ ਜਾਣਦਾ ਸਾ (ਕਿ ਉਹ) ਇਤਨੀ ਨਿਰਲਜ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "इह न लहत थो ऐस निलाजा ॥",
      "sourceLineId": "132945",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1249_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਬ ਮੈ ਰਨਿਯਨ ਅਵਰ ਬਿਹਾਰੌ ॥",
      "transliteration": "ab mai raniyan avar bihaarau ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੈਂ ਹੋਰਨਾ ਰਾਣੀਆਂ ਨਾਲ ਰਮਣ ਕਰਾਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1249,
      "hindi": "",
      "hindiTransliteration": "अब मै रनियन अवर बिहारौ ॥",
      "sourceLineId": "132946",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
