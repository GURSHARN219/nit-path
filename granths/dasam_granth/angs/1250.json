{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1250,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1250_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਨੀ ਮਰੀ ਨ ਫੇਰਿ ਚਿਤਾਰੌ ॥੧੦॥",
      "transliteration": "raanee maree na fer chitaarau ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਰ ਗਈ ਰਾਣੀ ਨੂੰ ਫਿਰ ਯਾਦ ਨਹੀਂ ਕਰਾਗਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "रानी मरी न फेरि चितारौ ॥१०॥",
      "sourceLineId": "132947",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਔਰ ਤ੍ਰਿਯਨ ਕੇ ਸਾਥ ਬਿਹਾਰਾ ॥",
      "transliteration": "aauar tirayan ke saath bihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਹੋਰਨਾ ਰਾਣੀਆਂ ਨਾਲ ਰਮਣ ਕਰਨ ਲਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "और तृयन के साथ बिहारा ॥",
      "sourceLineId": "132948",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਵਾ ਰਾਨੀ ਕਹ ਨ੍ਰਿਪਤਿ ਬਿਸਾਰਾ ॥",
      "transliteration": "vaa raanee keh nirapat bisaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਰਾਣੀ ਨੂੰ ਰਾਜੇ ਨੇ ਭੁਲਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "वा रानी कह नृपति बिसारा ॥",
      "sourceLineId": "132949",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਹ ਛਲ ਤ੍ਰਿਯਨ ਨਰਿੰਦ੍ਰਹਿ ਛਰਾ ॥",
      "transliteration": "eeh chhal tirayan nari(n)dhreh chharaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਇਸਤਰੀਆਂ ਨੇ ਰਾਜੇ ਨੂੰ ਛਲ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "इह छल तृयन नरिंद्रहि छरा ॥",
      "sourceLineId": "132950",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤ੍ਰਿਯ ਚਰਿਤ੍ਰ ਅਤਿਭੁਤ ਇਹ ਕਰਾ ॥੧੧॥",
      "transliteration": "tiray charitr atibhut ieh karaa ||11||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਇਹ ਅਨੋਖਾ ਚਰਿਤ੍ਰ ਕੀਤਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "तृय चरित्र अतिभुत इह करा ॥११॥",
      "sourceLineId": "132951",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੦੦॥੫੮੦੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau charitr samaapatam sat subham sat ||300||5800||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੦੦ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੦੦॥੫੮੦੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ चरित्र समापतम सतु सुभम सतु ॥३००॥५८००॥अफजूँ॥",
      "sourceLineId": "132952",
      "sourceShabadId": "12515",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "132953",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਇਛਾਵਤੀ ਨਗਰ ਇਕ ਸੁਨਾ ॥",
      "transliteration": "eichhaavatee nagar ik sunaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਛਾਵਤੀ ਨਾ ਦਾ ਇਕ ਨਗਰ ਸੁਣਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "इछावती नगर इक सुना ॥",
      "sourceLineId": "132954",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਇਛ ਸੈਨ ਰਾਜਾ ਬਹੁ ਗੁਨਾ ॥",
      "transliteration": "eichh sain raajaa bahu gunaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਰਾਜਾ ਇਛ ਸੈਨ ਬਹੁਤ ਗੁਣਵਾਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "इछ सैन राजा बहु गुना ॥",
      "sourceLineId": "132955",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਸਟ ਮਤੀ ਤਾ ਕੇ ਘਰ ਨਾਰੀ ॥",
      "transliteration": "eisaT matee taa ke ghar naaree ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ਼ਟ ਮਤੀ ਉਸ ਦੇ ਘਰ ਰਾਣੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "इसट मती ता के घर नारी ॥",
      "sourceLineId": "132956",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਸਟ ਦੇਵਕਾ ਰਹਤ ਦੁਲਾਰੀ ॥੧॥",
      "transliteration": "eisaT dhevakaa rahat dhulaaree ||1||",
      "translation": "",
      "punjabiViakhya": "ਇਸ਼ਟ ਦੇਵਕਾ (ਉਨ੍ਰਹਾ ਦੀ) ਪੁੱਤਰੀ ਹੁੰਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "इसट देवका रहत दुलारी ॥१॥",
      "sourceLineId": "132957",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਜੈ ਸੈਨ ਖਤਰੇਟਾ ਤਹਾ ॥",
      "transliteration": "ajai sain khatareTaa tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਅਜੈ ਸੈਨ ਨਾ ਦਾ ਇਕ ਖਤਰੇਟਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "अजै सैन खतरेटा तहा ॥",
      "sourceLineId": "132958",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਵਤ ਭਯੋ ਧਾਮ ਤ੍ਰਿਯ ਜਹਾ ॥",
      "transliteration": "aavat bhayo dhaam tiray jahaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਉਥੇ ਆਇਆ ਜਿਥੇ ਇਸਤਰੀ (ਰਾਣੀ) ਦਾ ਘਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "आवत भयो धाम तृय जहा ॥",
      "sourceLineId": "132959",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਾਣੀ ਤਾ ਕੋ ਰੂਪ ਨਿਹਾਰਾ ॥",
      "transliteration": "raanee taa ko roop nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਉਸ ਦੇ ਰੂਪ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "राणी ता को रूप निहारा ॥",
      "sourceLineId": "132960",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗਿਰੀ ਧਰਨਿ ਜਨੁ ਲਗਿਯੋ ਕਟਾਰਾ ॥੨॥",
      "transliteration": "giree dharan jan lagiyo kaTaaraa ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਧਰਤੀ ਉਤੇ ਡਿਗ ਪਈ, ਮਾਨੋ ਕਟਾਰ ਲਗੀ ਹੋਵੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "गिरी धरनि जनु लगियो कटारा ॥२॥",
      "sourceLineId": "132961",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਉੜਦਾ ਬੇਗ ਨਿਪੁੰਸਕ ਬਨੇ ॥",
      "transliteration": "auRadhaa beg nipu(n)sak bane ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਉੜਦਾ ਬੇਗ",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "उड़दा बेग निपुँसक बने ॥",
      "sourceLineId": "132962",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪਠੈ ਦਏ ਰਾਨੀ ਤਹ ਘਨੇ ॥",
      "transliteration": "paThai dhe raanee teh ghane ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੋਰ ਬਹੁਤ ਸਾਰੇ ਖੁਸਰਿਆਂ ਨੂੰ ਉਸ ਕੋਲ ਭੇਜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "पठै दए रानी तह घने ॥",
      "sourceLineId": "132963",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗਹਿ ਕਰਿ ਤਾਹਿ ਲੈ ਗਏ ਤਹਾ ॥",
      "transliteration": "geh kar taeh lai ge tahaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਖੁਸਰੇ) ਉਸ ਨੂੰ ਪਕੜ ਕੇ ਉਥੇ ਲੈ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "गहि करि ताहि लै गए तहा ॥",
      "sourceLineId": "132964",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਰਨੀ ਪੰਥ ਬਿਲੋਕਤ ਜਹਾ ॥੩॥",
      "transliteration": "taranee pa(n)th bilokat jahaa ||3||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਰਾਣੀ (ਉਸ ਦਾ) ਰਸਤਾ ਵੇਖ ਰਹੀ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "तरनी पंथ बिलोकत जहा ॥३॥",
      "sourceLineId": "132965",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਾ ਸੌ ਰਾਨੀ ਕਰਿ ॥",
      "transliteration": "kaam bhog taa sau raanee kar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਰਾਣੀ ਨੇ ਕਾਮ-ਭੋਗ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "काम भोग ता सौ रानी करि ॥",
      "sourceLineId": "132966",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪੌਢੇ ਦੋਊ ਜਾਇ ਪਲਘਾ ਪਰ ॥",
      "transliteration": "pauadde dhouoo jai palaghaa par ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਵੇਾਂ ਪਲੰਘ ਉਤੇ ਸੌਂ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "पौढे दोऊ जाइ पलघा पर ॥",
      "sourceLineId": "132967",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਬ ਲਗਿ ਆਇ ਨ੍ਰਿਪਤਿ ਤਹ ਗਏ ॥",
      "transliteration": "tab lag aai nirapat teh ge ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਰਾਜਾ ਉਥੇ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "तब लगि आइ नृपति तह गए ॥",
      "sourceLineId": "132968",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੋਵਤ ਦੁਹੂੰ ਬਿਲੋਕਤ ਭਏ ॥੪॥",
      "transliteration": "sovat dhuhoo(n) bilokat bhe ||4||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੂੰ (ਇਕੱਠਾ) ਸੁਤਿਆਂ ਵੇਖ ਲਿਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "सोवत दुहूँ बिलोकत भए ॥४॥",
      "sourceLineId": "132969",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭਰਭਰਾਇ ਤ੍ਰਿਯ ਜਗੀ ਦੁਖਾਤੁਰ ॥",
      "transliteration": "bharabharai tiray jagee dhukhaatur ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਦੁਖੀ ਹੋਈ ਘਬਰਾ ਕੇ ਜਾਗ ਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "भरभराइ तृय जगी दुखातुर ॥",
      "sourceLineId": "132970",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਡਾਰਿ ਦਯੋ ਦੁਪਟਾ ਪਤਿ ਮੁਖ ਪਰ ॥",
      "transliteration": "ddaar dhayo dhupaTaa pat mukh par ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਤੀ ਦੇ ਮੂੰਹ ਉਤੇ ਦੁਪੱਟਾ ਸੁਟ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "डारि दयो दुपटा पति मुख पर ॥",
      "sourceLineId": "132971",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਬ ਲੌ ਕਰਤ ਦੂਰਿ ਨ੍ਰਿਪ ਭਯੋ ॥",
      "transliteration": "jab lau karat dhoor nirap bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਤਕ ਰਾਜੇ ਨੇ (ਦੁਪੱਟੇ ਨੂੰ ਮੂੰਹ ਤੋਂ) ਹਟਾਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "जब लौ करत दूरि नृप भयो ॥",
      "sourceLineId": "132972",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਬ ਲੌ ਜਾਰਿ ਭਾਜਿ ਕਰਿ ਗਯੋ ॥੫॥",
      "transliteration": "tab lau jaar bhaaj kar gayo ||5||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਯਾਰ ਭਜ ਗਿਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "तब लौ जारि भाजि करि गयो ॥५॥",
      "sourceLineId": "132973",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੁਪਟਾ ਦੂਰਿ ਕਰਾ ਨ੍ਰਿਪ ਜਬੈ ॥",
      "transliteration": "dhupaTaa dhoor karaa nirap jabai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਜਦ ਦੁਪੱਟਾ ਦੂਰ ਕੀਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "दुपटा दूरि करा नृप जबै ॥",
      "sourceLineId": "132974",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪਕਰ ਲਿਯੋ ਰਾਨੀ ਕਹ ਤਬੈ ॥",
      "transliteration": "pakar liyo raanee keh tabai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੇ ਰਾਣੀ ਨੂੰ ਪਕੜ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "पकर लियो रानी कह तबै ॥",
      "sourceLineId": "132975",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਹਾ ਗਯੋ ਵਹੁ ਜੁ ਮੈ ਨਿਹਾਰਾ ॥",
      "transliteration": "kahaa gayo vahu ju mai nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਪੁੱਛਣ ਲਗਾ) ਉਹ ਕਿਥੇ ਗਿਆ ਹੈ, ਜਿਸ ਨੂੰ ਮੈਂ ਵੇਖਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "कहा गयो वहु जु मै निहारा ॥",
      "sourceLineId": "132976",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਿਨੁ ਨ ਕਹੈ ਭ੍ਰਮ ਮਿਟੈ ਹਮਾਰਾ ॥੬॥",
      "transliteration": "bin na kahai bhram miTai hamaaraa ||6||",
      "translation": "",
      "punjabiViakhya": "ਬਿਨਾ (ਸਚ) ਦਸੇ, ਮੇਰਾ ਭਰਮ ਨਹੀਂ ਮਿਟਣਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "बिनु न कहै भ्रम मिटै हमारा ॥६॥",
      "sourceLineId": "132977",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪ੍ਰਥਮੈ ਜਾਨ ਮਾਫ ਮੁਰ ਕੀਜੈ ॥",
      "transliteration": "prathamai jaan maaf mur keejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਮੇਰੀ ਜਾਨ ਮਾਫ਼ ਕਰ ਦਿਓ,",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "प्रथमै जान माफ मुर कीजै ॥",
      "sourceLineId": "132978",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਹੁਰੌ ਬਾਤ ਸਾਚ ਸੁਨਿ ਲੀਜੈ ॥",
      "transliteration": "bahurau baat saach sun leejai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ (ਮੇਰੇ ਪਾਸੋਂ) ਸੱਚੀ ਗੱਲ ਸੁਣ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "बहुरौ बात साच सुनि लीजै ॥",
      "sourceLineId": "132979",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਚਨੁ ਦੇਹੁ ਮੇਰੇ ਜੌ ਹਾਥਾ ॥",
      "transliteration": "bachan dheh mere jau haathaa ||",
      "translation": "",
      "punjabiViakhya": "(ਪਹਿਲਾ) ਮੈਨੂੰ ਹੱਥ ਨਾਲ ਬਚਨ ਦਿਓ,",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "बचनु देहु मेरे जौ हाथा ॥",
      "sourceLineId": "132980",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਹੁਰਿ ਲੇਹੁ ਬਿਨਤੀ ਸੁਨਿ ਨਾਥਾ ॥੭॥",
      "transliteration": "bahur leh binatee sun naathaa ||7||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਹੇ ਨਾਥ! ਮੇਰੀ ਬੇਨਤੀ ਸੁਣ ਲਵੋ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "बहुरि लेहु बिनती सुनि नाथा ॥७॥",
      "sourceLineId": "132981",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭੈਂਗੇ ਨੇਤ੍ਰ ਤੋਰਿ ਬਿਧਿ ਕਰੇ ॥",
      "transliteration": "bhai(n)ge netr tor bidh kare ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਧਾਤਾ ਨੇ ਤੁਹਾਡੀਆਂ ਅੱਖਾ ਭੈਂਗੀਆਂ ਕਰ ਦਿੱਤੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "भैंगे नेत्र तोरि बिधि करे ॥",
      "sourceLineId": "132982",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਇਕ ਤੈ ਜਾਤ ਦੋਇ ਲਖ ਪਰੇ ॥",
      "transliteration": "eik tai jaat dhoi lakh pare ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਕਰ ਕੇ ਤੁਹਾਨੂੰ) ਇਕ ਦੀ ਥਾ ਦੋ ਦਿਸ ਪੈਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "इक तै जात दोइ लख परे ॥",
      "sourceLineId": "132983",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤੁਮ ਕਹ ਕਛੂ ਝਾਵਰੋ ਆਯੋ ॥",
      "transliteration": "tum keh kachhoo jhaavaro aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਹਾਨੂੰ ਕੁਝ ਝੌਲਾ ਜਿਹਾ ਪਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "तुम कह कछू झावरो आयो ॥",
      "sourceLineId": "132984",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮੁਹਿ ਕੋ ਦਿਖਿ ਲਖਿ ਕਰਿ ਦ੍ਵੈ ਪਾਯੋ ॥੮॥",
      "transliteration": "muh ko dhikh lakh kar dhavai paayo ||8||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਵੇਖ ਕੇ (ਤੁਹਾਨੂੰ) ਦੋ ਵੇਖਣ ਦਾ (ਭੁਲੇਖਾ) ਪਿਆ ਹੈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "मुहि को दिखि लखि करि द्वै पायो ॥८॥",
      "sourceLineId": "132985",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨ੍ਰਿਪ ਸੁਨਿ ਬਚਨ ਚਕ੍ਰਿਤ ਹ੍ਵੈ ਰਹਾ ॥",
      "transliteration": "nirap sun bachan chakirat havai rahaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ (ਰਾਣੀ ਦੇ) ਬਚਨ ਸੁਣ ਕੇ ਹੈਰਾਨ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "नृप सुनि बचन चकृत ह्वै रहा ॥",
      "sourceLineId": "132986",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤ੍ਰਿਯ ਸੌ ਬਹੁਰਿ ਬਚਨ ਨਹਿ ਕਹਾ ॥",
      "transliteration": "tiray sau bahur bachan neh kahaa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਇਸਤਰੀ ਨੂੰ ਕੁਝ ਨਾ ਕਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "तृय सौ बहुरि बचन नहि कहा ॥",
      "sourceLineId": "132987",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮੁਖ ਮੂੰਦੇ ਘਰ ਕੌ ਫਿਰਿ ਆਯੋ ॥",
      "transliteration": "mukh moo(n)dhe ghar kau fir aayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੂੰਹ ਬੰਦ ਕਰ ਕੇ ਘਰ ਨੂੰ ਪਰਤ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "मुख मूँदे घर कौ फिरि आयो ॥",
      "sourceLineId": "132988",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਰਮ ਰੇਖ ਕਹ ਦੋਸ ਲਗਾਯੋ ॥੯॥",
      "transliteration": "karam rekh keh dhos lagaayo ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਰਮ-ਰੇਖਾ ਨੂੰ ਦੋਸ਼ ਲਗਾਉਣ ਲਗਾ (ਜਿਸ ਕਰ ਕੇ ਉਸ ਦੇ ਨੇਤਰਾ ਵਿਚ ਨੁਕਸ ਪੈ ਗਿਆ ਸੀ) ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "करम रेख कह दोस लगायो ॥९॥",
      "sourceLineId": "132989",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਇਕ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੦੧॥੫੮੦੯॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau ik charitr samaapatam sat subham sat ||301||5809||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੦੧ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੦੧॥੫੮੦੯॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ इक चरित्र समापतम सतु सुभम सतु ॥३०१॥५८०९॥अफजूँ॥",
      "sourceLineId": "132990",
      "sourceShabadId": "12516",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "132991",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੋਰਠ ਸੈਨ ਏਕ ਭੂਪਾਲਾ ॥",
      "transliteration": "soraTh sain ek bhoopaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੋਰਠ ਸੈਨ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "सोरठ सैन एक भूपाला ॥",
      "sourceLineId": "132992",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤੇਜਵਾਨ ਬਲਵਾਨ ਛਿਤਾਲਾ ॥",
      "transliteration": "tejavaan balavaan chhitaalaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਬਹੁਤ) ਤੇਜਵਾਨ, ਬਲਵਾਨ ਅਤੇ ਚਾਲਾਕ ('ਛਿਤਾਲਾ') ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "तेजवान बलवान छिताला ॥",
      "sourceLineId": "132993",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੋਰਠ ਦੇ ਤਾ ਕੈ ਘਰ ਰਾਨੀ ॥",
      "transliteration": "soraTh dhe taa kai ghar raanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਸੋਰਠ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਰਾਣੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "सोरठ दे ता कै घर रानी ॥",
      "sourceLineId": "132994",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸੁੰਦਰ ਸਕਲ ਭਵਨ ਮਹਿ ਜਾਨੀ ॥੧॥",
      "transliteration": "su(n)dhar sakal bhavan meh jaanee ||1||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਚੌਦਾ ਲੋਕਾ ਵਿਚ ਸੁੰਦਰ ਸਮਝੀ ਜਾਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "सुँदर सकल भवन महि जानी ॥१॥",
      "sourceLineId": "132995",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਛਤ੍ਰਿ ਸੈਨ ਤਹ ਸਾਹ ਭਨਿਜੈ ॥",
      "transliteration": "chhatr sain teh saeh bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਛਤ੍ਰਿ ਸੈਨ ਨਾ ਦਾ ਉਥੇ ਇਕ ਸ਼ਾਹ ਦਸਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "छतृ सैन तह साह भनिजै ॥",
      "sourceLineId": "132996",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਛਤ੍ਰ ਦੇਇ ਇਕ ਸੁਤਾ ਕਹਿਜੈ ॥",
      "transliteration": "chhatr dhei ik sutaa kahijai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਛਤ੍ਰ ਦੇਈ ਨਾ ਦੀ ਇਕ ਪੁੱਤਰੀ ਕਹੀ ਜਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "छत्र देइ इक सुता कहिजै ॥",
      "sourceLineId": "132997",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਭੂਤ ਭਵਾਨ ਭਵਿਖ੍ਯ ਮਝਾਰੀ ॥",
      "transliteration": "bhoot bhavaan bhavikhay majhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ (ਸੁੰਦਰ) ਕੁਮਾਰੀ ਭੂਤ, ਭਵਿਖ ਅਤੇ ਵਰਤਮਾਨ ਵਿਚ ਨਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "भूत भवान भविख्य मझारी ॥",
      "sourceLineId": "132998",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਭਈ ਨ ਹੈ ਹ੍ਵੈ ਹੈ ਨ ਕੁਮਾਰੀ ॥੨॥",
      "transliteration": "bhiee na hai havai hai na kumaaree ||2||",
      "translation": "",
      "punjabiViakhya": "ਨਾ ਹੈ ਅਤੇ ਨਾ ਹੀ ਹੋਵੇਗੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "भई न है ह्वै है न कुमारी ॥२॥",
      "sourceLineId": "132999",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਬ ਵਹੁ ਤਰੁਨਿ ਚੰਚਲਾ ਭਈ ॥",
      "transliteration": "jab vahu tarun cha(n)chalaa bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਕੁੜੀ ਮੁਟਿਆਰ ('ਚੰਚਲ') ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "जब वहु तरुनि चंचला भई ॥",
      "sourceLineId": "133000",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਲਰਿਕਾਪਨ ਕੀ ਸੁਧਿ ਬੁਧਿ ਗਈ ॥",
      "transliteration": "larikaapan kee sudh budh giee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਚਪਨ ਦੀ ਸੁੱਧ ਬੁੱਧ ਖ਼ਤਮ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "लरिकापन की सुधि बुधि गई ॥",
      "sourceLineId": "133001",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਛਤਿਯਾ ਕੁਚਨ ਤਬੈ ਉਠਿ ਆਏ ॥",
      "transliteration": "chhatiyaa kuchan tabai uTh aae ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਦੀ ਛਾਤੀ ਉਤੇ ਕੁਚ ਉਭਰ ਆਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "छतिया कुचन तबै उठि आए ॥",
      "sourceLineId": "133002",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਮਦਨ ਭਰਤਿਯਾ ਭਰਤ ਭਰਾਏ ॥੩॥",
      "transliteration": "madhan bharatiyaa bharat bharaae ||3||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੋਣ ਲਗਾ ਮਾਨੋ) ਸੰਚੇ ਭਰਨ ਵਾਲੇ ਕਾਰੀਗਰ ('ਭਰਤਿਯਾ') ਕਾਮ ਦੇਵ ਨੇ ਸੰਚੇ ਭਰ ਦਿੱਤੇ ਹੋਣ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "मदन भरतिया भरत भराए ॥३॥",
      "sourceLineId": "133003",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਅਭਰਨ ਸੈਨ ਕੁਅਰ ਤਿਨ ਲਹਾ ॥",
      "transliteration": "abharan sain kuar tin lahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਅਭਰਨ ਸੈਨ ਨਾ ਦਾ ਕੁਮਾਰ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "अभरन सैन कुअर तिन लहा ॥",
      "sourceLineId": "133004",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਤੇਜਵਾਨ ਕਛੁ ਜਾਤ ਨ ਕਹਾ ॥",
      "transliteration": "tejavaan kachh jaat na kahaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਬਹੁਤ) ਤੇਜਵਾਨ ਸੀ ਕਿ ਬਖਾਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "तेजवान कछु जात न कहा ॥",
      "sourceLineId": "133005",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਲਾਗੀ ਲਗਨ ਛੂਟਿ ਨਹਿ ਗਈ ॥",
      "transliteration": "laagee lagan chhooT neh giee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨਾਲ ਉਸ ਦੀ) ਲਗਨ ਲਗ ਗਈ (ਜੋ ਛੁੜਾਇਆਂ) ਛੁਟਦੀ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "लागी लगन छूटि नहि गई ॥",
      "sourceLineId": "133006",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਸੁਕ ਨਲਨੀ ਕੀ ਸੀ ਗਤਿ ਭਈ ॥੪॥",
      "transliteration": "suk nalanee kee see gat bhiee ||4||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਹਾਲਤ ਤੋਤੇ ਅਤੇ ਨਲਨੀ (ਇਕ ਪ੍ਰਕਾਰ ਦੀ ਨਲਕੀ ਦੀ ਬਣੀ ਕੁੜਿਕੀ) ਵਰਗੀ ਹੋ ਗਈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "सुक नलनी की सी गति भई ॥४॥",
      "sourceLineId": "133007",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਤਾ ਸੌ ਲਗੀ ਲਗਨ ਬਹੁ ਭਾਤਾ ॥",
      "transliteration": "taa sau lagee lagan bahu bhaataa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ (ਉਸ ਦੀ) ਕਈ ਤਰ੍ਰਹਾ ਦੀ ਲਗਨ ਲਗ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "ता सौ लगी लगन बहु भाता ॥",
      "sourceLineId": "133008",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਕਿਹ ਬਿਧਿ ਬਰਨ ਸੁਨਾਊ ਬਾਤਾ ॥",
      "transliteration": "keh bidh baran sunaauoo baataa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ) ਗੱਲਾ ਦਾ ਭਲਾ (ਮੈਂ) ਕਿਸ ਤਰ੍ਰਹਾ ਵਰਣਨ ਕਰ ਕੇ ਸੁਣਾਵਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "किह बिधि बरन सुनाऊ बाता ॥",
      "sourceLineId": "133009",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਨਿਤਿਪ੍ਰਤਿ ਤਾ ਕਹ ਬੋਲਿ ਪਠਾਵੈ ॥",
      "transliteration": "nitiprat taa keh bol paThaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਇਸਤਰੀ) ਉਸ ਨੂੰ ਹਰ ਰੋਜ਼ ਬੁਲਾ ਲੈਂਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "नितिप्रति ता कह बोलि पठावै ॥",
      "sourceLineId": "133010",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਰੁਚਿ ਮਾਨ ਕਮਾਵੈ ॥੫॥",
      "transliteration": "kaam bhog ruch maan kamaavai ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰੁਚੀ ਪੂਰਵਕ (ਉਸ ਨਾਲ) ਸੰਯੋਗ ਕਰਦੀ ਸੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "काम भोग रुचि मान कमावै ॥५॥",
      "sourceLineId": "133011",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਤਾ ਕੇ ਲਏ ਨਾਥ ਕਹ ਮਾਰਾ ॥",
      "transliteration": "taa ke le naath keh maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਲਈ (ਉਸ ਨੇ) ਆਪਣੇ ਪਤੀ ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "ता के लए नाथ कह मारा ॥",
      "sourceLineId": "133012",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਤਨ ਮੈ ਰਾਡ ਭੇਸ ਕੋ ਧਾਰਾ ॥",
      "transliteration": "tan mai raadd bhes ko dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਸ਼ਰੀਰ ਉਤੇ ਵਿਧਵਾ ਦਾ ਭੇਸ ਧਾਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "तन मै राड भेस को धारा ॥",
      "sourceLineId": "133013",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਜਬ ਗ੍ਰਿਹ ਅਪਨੇ ਜਾਰ ਬੁਲਾਯੋ ॥",
      "transliteration": "jab gireh apane jaar bulaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਉਸ ਨੇ) ਆਪਣੇ ਘਰ ਯਾਰ ਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "जब गृह अपने जार बुलायो ॥",
      "sourceLineId": "133014",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਸਭ ਪ੍ਰਸੰਗ ਕਹਿ ਤਾਹਿ ਸੁਨਾਯੋ ॥੬॥",
      "transliteration": "sabh prasa(n)g keh taeh sunaayo ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸਾਰੀ ਗੱਲ ਉਸ ਨੂੰ ਦਸ ਦਿੱਤੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "सभ प्रसंग कहि ताहि सुनायो ॥६॥",
      "sourceLineId": "133015",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਸੁਨਿ ਕੈ ਜਾਰ ਬਚਨ ਅਸ ਡਰਾ ॥",
      "transliteration": "sun kai jaar bachan as ddaraa ||",
      "translation": "",
      "punjabiViakhya": "ਯਾਰ (ਉਸ ਦਾ) ਬੋਲ ਸੁਣ ਕੇ ਅਜਿਹਾ ਡਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "सुनि कै जार बचन अस डरा ॥",
      "sourceLineId": "133016",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਧ੍ਰਿਗ ਧ੍ਰਿਗ ਬਚ ਤਿਹ ਤ੍ਰਿਯਹਿ ਉਚਰਾ ॥",
      "transliteration": "dhirag dhirag bach teh tirayeh ucharaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਉਸ ਇਸਤਰੀ ਨੂੰ 'ਧ੍ਰਿਗ ਧ੍ਰਿਗ' ਕਹਿਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "धृग धृग बच तिह तृयहि उचरा ॥",
      "sourceLineId": "133017",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1250_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਜਿਨ ਅਪਨੋ ਪਤਿ ਆਪੁ ਸੰਘਰਿਯੋ ॥",
      "transliteration": "jin apano pat aap sa(n)ghariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਮਨ ਵਿਚ ਸੋਚਣ ਲਗਾ ਕਿ) ਜਿਸ ਨੇ ਆਪਣੇ ਪਤੀ ਨੂੰ ਆਪ ਮਾਰ ਦਿੱਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1250,
      "hindi": "",
      "hindiTransliteration": "जिन अपनो पति आपु संघरियो ॥",
