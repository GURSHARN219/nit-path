{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1251,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1251_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮੁਹਿ ਕਸ ਚਹਤ ਭਲਾਈ ਕਰਿਯੋ ॥੭॥",
      "transliteration": "muh kas chahat bhalaiee kariyo ||7||",
      "translation": "",
      "punjabiViakhya": "ਉਹ (ਭਲਾ) ਮੇਰੀ ਕੀ ਭਲਿਆਈ ਕਰਨੀ ਚਾਹੇਗੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "मुहि कस चहत भलाई करियो ॥७॥",
      "sourceLineId": "133019",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪਤਿ ਮਾਰਿਯੋ ਜਾ ਕੇ ਹਿਤ ਗਯੋ ॥",
      "transliteration": "pat maariyo jaa ke hit gayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਲਈ ਪਤੀ ਮਾਰਿਆ ਸੀ, (ਉਹ ਵੀ) ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "पति मारियो जा के हित गयो ॥",
      "sourceLineId": "133020",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੋ ਭੀ ਅੰਤ ਨ ਤਾ ਕੋ ਭਯੋ ॥",
      "transliteration": "so bhee a(n)t na taa ko bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਵੀ ਅੰਤ ਨੂੰ ਉਸ ਦਾ ਨਾ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "सो भी अंत न ता को भयो ॥",
      "sourceLineId": "133021",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਐਸੋ ਮਿਤ੍ਰ ਕਛੂ ਨਹੀ ਕਰਿਯੋ ॥",
      "transliteration": "aaiso mitr kachhoo nahee kariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਮਨ ਵਿਚ ਸੋਚਣ ਲਗੀ) ਅਜਿਹੇ ਮਿਤਰ ਤੋਂ ਕੁਝ ਨਹੀਂ ਕਰਾਉਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "ऐसो मित्र कछू नही करियो ॥",
      "sourceLineId": "133022",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਇਹ ਰਾਖੇ ਤੇ ਭਲੋ ਸੰਘਰਿਯੋ ॥੮॥",
      "transliteration": "eeh raakhe te bhalo sa(n)ghariyo ||8||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਰਖਣ ਨਾਲੋਂ ਚੰਗਾ ਹੈ, ਮਾਰ ਦੇਈਏ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "इह राखे ते भलो संघरियो ॥८॥",
      "sourceLineId": "133023",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਰ ਮਹਿ ਕਾਢਿ ਭਗੌਤੀ ਲਈ ॥",
      "transliteration": "kar meh kaadd bhagauatee liee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਹੱਥ ਵਿਚ ਤਲਵਾਰ ਕਢ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "कर महि काढि भगौती लई ॥",
      "sourceLineId": "133024",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦੁਹੂੰ ਹਾਥ ਤਾ ਕੋ ਸਿਰ ਦਈ ॥",
      "transliteration": "dhuhoo(n) haath taa ko sir dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਹਾ ਹੱਥਾ ਨਾਲ ਉਸ ਦੇ ਸਿਰ ਉਪਰ ਮਾਰੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "दुहूँ हाथ ता को सिर दई ॥",
      "sourceLineId": "133025",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹਾਇ ਹਾਇ ਜਿਮਿ ਭੂਪ ਪੁਕਾਰੈ ॥",
      "transliteration": "hai hai jim bhoop pukaarai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਜਿਵੇਾਂ ਜਿਵੇਾਂ 'ਹਾਇ ਹਾਇ' ਪੁਕਾਰਦਾ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "हाइ हाइ जिमि भूप पुकारै ॥",
      "sourceLineId": "133026",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤ੍ਰਯੋ ਤ੍ਰਯੋ ਨਾਰਿ ਕ੍ਰਿਪਾਨਨ ਮਾਰੈ ॥੯॥",
      "transliteration": "trayo trayo naar kirapaanan maarai ||9||",
      "translation": "",
      "punjabiViakhya": "ਤਿਉਾਂ ਤਿਉਾਂ ਇਸਤਰੀ ਤਲਵਾਰ ਦਾ ਵਾਰ ਕਰਦੀ ਗਈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "त्रयो त्रयो नारि कृपानन मारै ॥९॥",
      "sourceLineId": "133027",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦ੍ਵੈ ਦਿਨ ਭਏ ਨ ਪਤਿ ਕੇ ਮਰੈ ॥",
      "transliteration": "dhavai dhin bhe na pat ke marai ||",
      "translation": "",
      "punjabiViakhya": "(ਲੋਕਾ ਨੂੰ ਕਹਿਣ ਲਗੀ ਕਿ ਅਜੇ ਮੇਰੇ) ਪਤੀ ਨੂੰ ਮਰਿਆਂ ਦੋ ਦਿਨ ਵੀ ਨਹੀਂ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "द्वै दिन भए न पति के मरै ॥",
      "sourceLineId": "133028",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਐਸੀ ਲਗੇ ਅਬੈ ਏ ਕਰੈ ॥",
      "transliteration": "aaisee lage abai e karai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੁਣੇ ਹੀ ਇਹ ਅਜਿਹਾ ਕਰਨ ਲਗ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "ऐसी लगे अबै ए करै ॥",
      "sourceLineId": "133029",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਧ੍ਰਿਗ ਜਿਯਬੋ ਪਿਯ ਬਿਨੁ ਜਗ ਮਾਹੀ ॥",
      "transliteration": "dhirag jiyabo piy bin jag maahee ||",
      "translation": "",
      "punjabiViakhya": "ਪਤੀ ਤੋਂ ਬਿਨਾ ਸੰਸਾਰ ਵਿਚ ਜੀਉਣ ਨੂੰ ਧਿੱਕਾਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "धृग जियबो पिय बिनु जग माही ॥",
      "sourceLineId": "133030",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਾਰ ਚੋਰ ਜਿਹ ਹਾਥ ਚਲਾਹੀ ॥੧੦॥",
      "transliteration": "jaar chor jeh haath chalaahee ||10||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਚੋਰ ਯਾਰ ਹੱਥ ਚਲਾਉਾਂਦੇ ਹੋਣ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "जार चोर जिह हाथ चलाही ॥१०॥",
      "sourceLineId": "133031",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਰਿਯੋ ਨਿਰਖਿ ਤਿਹ ਸਭਨ ਉਚਾਰਾ ॥",
      "transliteration": "mariyo nirakh teh sabhan uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਮਰਿਆ ਵੇਖ ਕੇ ਸਭ ਨੇ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "मरियो निरखि तिह सभन उचारा ॥",
      "sourceLineId": "133032",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਲਾ ਕਰਾ ਤੈ ਜਾਰ ਸੰਘਾਰਾ ॥",
      "transliteration": "bhalaa karaa tai jaar sa(n)ghaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤੂੰ ਚੰਗਾ ਕੀਤਾ ਹੈ ਜੋ ਯਾਰ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "भला करा तै जार संघारा ॥",
      "sourceLineId": "133033",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚਾਦਰ ਕੀ ਲਜਾ ਤੈ ਰਾਖੀ ॥",
      "transliteration": "chaadhar kee lajaa tai raakhee ||",
      "translation": "",
      "punjabiViakhya": "ਤੂੰ ਤਾ ਪਰਦੇ (ਮਰਯਾਦਾ) ਦੀ ਲਾਜ ਬਚਾ ਲਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "चादर की लजा तै राखी ॥",
      "sourceLineId": "133034",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਧੰਨ੍ਯ ਧੰਨ੍ਯ ਪੁਤ੍ਰੀ ਤੂ ਭਾਖੀ ॥੧੧॥",
      "transliteration": "dha(n)nay dha(n)nay putree too bhaakhee ||11||",
      "translation": "",
      "punjabiViakhya": "(ਸਭ) ਕਹਿਣ ਲਗੇ, ਹੇ ਪੁੱਤਰੀ! ਤੂੰ ਧੰਨ ਹੈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "धंन्य धंन्य पुत्री तू भाखी ॥११॥",
      "sourceLineId": "133035",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਦੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੦੨॥੫੮੨੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau dho charitr samaapatam sat subham sat ||302||5820||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੦੨ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੦੨॥੫੮੨੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ दो चरित्र समापतम सतु सुभम सतु ॥३०२॥५८२०॥अफजूँ॥",
      "sourceLineId": "133036",
      "sourceShabadId": "12517",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133037",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਭਰਨ ਸਿੰਘ ਸੁਨਾ ਇਕ ਨ੍ਰਿਪ ਬਰ ॥",
      "transliteration": "abharan si(n)gh sunaa ik nirap bar ||",
      "translation": "",
      "punjabiViakhya": "ਅਭਰਨ ਸਿੰਘ ਨਾ ਦਾ ਇਕ ਸ੍ਰੇਸ਼ਠ ਰਾਜਾ ਸੁਣਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "अभरन सिंघ सुना इक नृप बर ॥",
      "sourceLineId": "133038",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਲਜਤ ਹੋਤ ਜਿਹ ਨਿਰਖਿ ਦਿਵਾਕਰ ॥",
      "transliteration": "lajat hot jeh nirakh dhivaakar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਸੂਰਜ ਵੀ ਲਜਿਤ ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "लजत होत जिह निरखि दिवाकर ॥",
      "sourceLineId": "133039",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਭਰਨ ਦੇਇ ਸਦਨ ਮਹਿ ਨਾਰੀ ॥",
      "transliteration": "abharan dhei sadhan meh naaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਭਰਨ ਦੇਈ ਉਸ ਦੇ ਘਰ ਇਸਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "अभरन देइ सदन महि नारी ॥",
      "sourceLineId": "133040",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਥਿ ਅਭਰਨ ਜਣੁ ਸਕਲ ਨਿਕਾਰੀ ॥੧॥",
      "transliteration": "math abharan jan sakal nikaaree ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਮਾਨੋ ਅਭਰਨ (ਗਹਿਣਿਆਂ) ਨੂੰ ਰਿੜਕ ਕੇ ਕਢਿਆ ਹੋਵੇ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "मथि अभरन जणु सकल निकारी ॥१॥",
      "sourceLineId": "133041",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਾਨੀ ਹੁਤੀ ਮਿਤ੍ਰ ਸੇਤੀ ਰਤਿ ॥",
      "transliteration": "raanee hutee mitr setee rat ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ (ਇਕ) ਮਿਤਰ ਨਾਲ ਲਗੀ ਹੋਈ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "रानी हुती मित्र सेती रति ॥",
      "sourceLineId": "133042",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭੋਗਤ ਹੁਤੀ ਤਵਨ ਕਹ ਨਿਤਿਪ੍ਰਤਿ ॥",
      "transliteration": "bhogat hutee tavan keh nitiprat ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਨਿੱਤ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "भोगत हुती तवन कह नितिप्रति ॥",
      "sourceLineId": "133043",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਇਕ ਦਿਨ ਭੇਦ ਰਾਵ ਲਖਿ ਪਾਯੋ ॥",
      "transliteration": "eik dhin bhedh raav lakh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਰਾਜੇ ਨੂੰ ਭੇਦ ਦਾ ਪਤਾ ਲਗ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "इक दिन भेद राव लखि पायो ॥",
      "sourceLineId": "133044",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤ੍ਰਿਯ ਕੇ ਧਾਮ ਬਿਲੋਕਨ ਆਯੋ ॥੨॥",
      "transliteration": "tiray ke dhaam bilokan aayo ||2||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਸਤਰੀ ਦੇ ਘਰ ਵੇਖਣ ਲਈ ਆਇਆ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "तृय के धाम बिलोकन आयो ॥२॥",
      "sourceLineId": "133045",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਹ ਤੇ ਲਯੋ ਪਕਰਿ ਇਕ ਜਾਰਾ ॥",
      "transliteration": "teh te layo pakar ik jaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਹੀ (ਰਾਣੀ ਦੇ) ਇਕ ਯਾਰ ਨੂੰ ਪਕੜ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "तह ते लयो पकरि इक जारा ॥",
      "sourceLineId": "133046",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤੌਨੇ ਠੌਰਿ ਮਾਰਿ ਕਰਿ ਡਾਰਾ ॥",
      "transliteration": "tauane Thauar maar kar ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸੇ ਥਾ ਤੇ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "तौने ठौरि मारि करि डारा ॥",
      "sourceLineId": "133047",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਸਤ੍ਰੀ ਜਾਨਿ ਨ ਇਸਤ੍ਰੀ ਮਾਰੀ ॥",
      "transliteration": "eisatree jaan na isatree maaree ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੂੰ ਇਸਤਰੀ ਸਮਝ ਕੇ ਨਾ ਮਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "इसत्री जानि न इसत्री मारी ॥",
      "sourceLineId": "133048",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚਿਤ ਅਪਨੇ ਤੇ ਦਈ ਬਿਸਾਰੀ ॥੩॥",
      "transliteration": "chit apane te dhiee bisaaree ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਚਿਤ ਤੋਂ ਭੁਲਾ ਦਿੱਤੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "चित अपने ते दई बिसारी ॥३॥",
      "sourceLineId": "133049",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬੀਤਤ ਬਰਖ ਅਧਿਕ ਜਬ ਭਏ ॥",
      "transliteration": "beetat barakh adhik jab bhe ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਬਹੁਤ ਸਾਲ ਬੀਤ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "बीतत बरख अधिक जब भए ॥",
      "sourceLineId": "133050",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਰਾਨੀ ਬਹੁ ਉਪਚਾਰ ਬਨਏ ॥",
      "transliteration": "raanee bahu upachaar bane ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਨੇ ਵੀ ਕਈ ਉਪਾ ਕਰ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "रानी बहु उपचार बनए ॥",
      "sourceLineId": "133051",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰਾਜਾ ਤਾ ਕੇ ਧਾਮ ਨ ਆਯੋ ॥",
      "transliteration": "raajaa taa ke dhaam na aayo ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਰਾਜਾ ਉਸ ਦੇ ਘਰ ਨਹੀਂ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "राजा ता के धाम न आयो ॥",
      "sourceLineId": "133052",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਬ ਇਕ ਔਰੁਪਚਾਰ ਬਨਾਯੋ ॥੪॥",
      "transliteration": "tab ik aauarupachaar banaayo ||4||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਉਸ ਨੇ) ਇਕ ਹੋਰ ਉਪਚਾਰ ਕੀਤਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "तब इक औरुपचार बनायो ॥४॥",
      "sourceLineId": "133053",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰਾਨੀ ਭੇਸ ਸੰਨ੍ਯਾਸਿਨਿ ਕੋ ਧਰਿ ॥",
      "transliteration": "raanee bhes sa(n)nayaasin ko dhar ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਸੰਨਿਆਸਣ ਦਾ ਭੇਸ ਧਾਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "रानी भेस संन्यासिनि को धरि ॥",
      "sourceLineId": "133054",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਾਤ ਭਈ ਤਜਿ ਧਾਮ ਨਿਕਰਿ ਕਰਿ ॥",
      "transliteration": "jaat bhiee taj dhaam nikar kar ||",
      "translation": "",
      "punjabiViakhya": "ਘਰ ਨੂੰ ਤਿਆਗ ਕੇ ਨਿਕਲ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "जात भई तजि धाम निकरि करि ॥",
      "sourceLineId": "133055",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਖੇਲਤ ਨ੍ਰਿਪਤਿ ਅਖਿਟ ਜਬ ਆਯੋ ॥",
      "transliteration": "khelat nirapat akhiT jab aayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜਾ ਸ਼ਿਕਾਰ ਖੇਡਣ ਲਈ ਆਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "खेलत नृपति अखिट जब आयो ॥",
      "sourceLineId": "133056",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਏਕ ਹਰਿਨ ਲਖਿ ਤੁਰੰਗ ਧਵਾਯੋ ॥੫॥",
      "transliteration": "ek harin lakh tura(n)g dhavaayo ||5||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਇਕ ਹਿਰਨ ਨੂੰ ਵੇਖ ਕੇ (ਉਸ ਪਿਛੇ) ਘੋੜਾ ਭਜਾਇਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "एक हरिन लखि तुरंग धवायो ॥५॥",
      "sourceLineId": "133057",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜੋਜਨ ਕਿਤਕ ਨਗਰ ਤੇ ਗਯੋ ॥",
      "transliteration": "jojan kitak nagar te gayo ||",
      "translation": "",
      "punjabiViakhya": "ਨਗਰ ਤੋਂ ਕਿਤਨੇ ਕੁ ਯੋਜਨ (ਦੂਰ) ਚਲਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "जोजन कितक नगर ते गयो ॥",
      "sourceLineId": "133058",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪਹੁਚਤ ਜਹ ਨ ਮਨੁਛ ਇਕ ਭਯੋ ॥",
      "transliteration": "pahuchat jeh na manuchh ik bhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ) ਜਾ ਪਹੁੰਚਿਆ ਜਿਥੇ ਇਕ ਵੀ ਮਨੁੱਖ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "पहुचत जह न मनुछ इक भयो ॥",
      "sourceLineId": "133059",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਉਤਰਿਯੋ ਬਿਕਲ ਬਾਗ ਮੈ ਜਾਈ ॥",
      "transliteration": "autariyo bikal baag mai jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਆਕੁਲ ਹੋ ਕੇ ਇਕ ਬਾਗ਼ ਵਿਚ ਉਤਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "उतरियो बिकल बाग मै जाई ॥",
      "sourceLineId": "133060",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਰਾਨੀ ਇਕਲ ਪਹੂਚੀ ਆਈ ॥੬॥",
      "transliteration": "raanee ikal pahoochee aaiee ||6||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ) ਇਕਲੀ (ਸੰਨਿਆਸਣ ਬਣੀ) ਰਾਣੀ ਆ ਪਹੁੰਚੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "रानी इकल पहूची आई ॥६॥",
      "sourceLineId": "133061",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੰਨ੍ਯਾਸਿਨਿ ਕੋ ਭੇਸ ਬਨਾਏ ॥",
      "transliteration": "sa(n)nayaasin ko bhes banaae ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਸੰਨਿਆਸਣ ਦਾ ਭੇਸ ਬਣਾਇਆ ਹੋਇਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "संन्यासिनि को भेस बनाए ॥",
      "sourceLineId": "133062",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੀਸ ਜਟਨ ਕੋ ਜੂਟ ਛਕਾਏ ॥",
      "transliteration": "sees jaTan ko jooT chhakaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਿਰ ਉਤੇ ਜਟਾਵਾ ਦਾ ਜੂੜਾ ਕੀਤਾ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "सीस जटन को जूट छकाए ॥",
      "sourceLineId": "133063",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜੋ ਨਰੁ ਤਾ ਕੋ ਰੂਪ ਨਿਹਾਰੈ ॥",
      "transliteration": "jo nar taa ko roop nihaarai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਵਿਅਕਤੀ ਉਸ ਦੇ ਰੂਪ ਨੂੰ ਵੇਖਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "जो नरु ता को रूप निहारै ॥",
      "sourceLineId": "133064",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਉਰਝਿ ਰਹੈ ਨਹਿ ਸੰਕ ਬਿਚਾਰੈ ॥੭॥",
      "transliteration": "aurajh rahai neh sa(n)k bichaarai ||7||",
      "translation": "",
      "punjabiViakhya": "ਉਲਝ ਕੇ ਰਹਿ ਜਾਦਾ ਅਤੇ ਕੋਈ ਸ਼ੰਕਾ ਨਾ ਕਰਦਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "उरझि रहै नहि संक बिचारै ॥७॥",
      "sourceLineId": "133065",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1251_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਉਤਰਤ ਬਾਗ ਤਿਹੀ ਤ੍ਰਿਯ ਭਈ ॥",
      "transliteration": "autarat baag tihee tiray bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਹੀ ਬਾਗ਼ ਵਿਚ ਉਹ ਇਸਤਰੀ ਵੀ ਉਤਰੀ",
      "source": "DASAM_GRANTH",
      "ang": 1251,
      "hindi": "",
      "hindiTransliteration": "उतरत बाग तिही तृय भई ॥",
      "sourceLineId": "133066",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
