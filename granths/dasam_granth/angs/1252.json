{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1252,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1252_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਉਹਿ ਰਾਜਾ ਤਨ ਭੇਟ ਹੁਈ ॥",
      "transliteration": "auh raajaa tan bheT huiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੀ ਰਾਜੇ ਨਾਲ ਭੇਾਂਟ ਹੋਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "उहि राजा तन भेट हुई ॥",
      "sourceLineId": "133067",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਿਰਖਤ ਰੂਪ ਉਰਝਿ ਨ੍ਰਿਪ ਰਹਿਯੋ ॥",
      "transliteration": "nirakhat roop urajh nirap rahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਰੂਪ ਵੇਖ ਕੇ ਰਾਜਾ ਮੋਹਿਤ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "निरखत रूप उरझि नृप रहियो ॥",
      "sourceLineId": "133068",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਰੀ ਨਾਗਨੀ ਕੋ ਇਹ ਕਹਿਯੋ ॥੮॥",
      "transliteration": "naree naaganee ko ieh kahiyo ||8||",
      "translation": "",
      "punjabiViakhya": "ਕਹਿਣ ਲਗਿਆ ਕਿ ਇਹ ਨਰੀ ਜਾ ਨਾਗਨੀ ਵਿਚੋਂ ਕੌਣ ਹੈ? ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "नरी नागनी को इह कहियो ॥८॥",
      "sourceLineId": "133069",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਵਨ ਰੂਪ ਰਾਨੀ ਤੁਮ ਹੋ ਜੂ ॥",
      "transliteration": "kavan roop raanee tum ho joo ||",
      "translation": "",
      "punjabiViakhya": "(ਪੁਛਣ ਲਗਿਆ) ਹੇ ਰਾਣੀ! ਤੂੰ ਕਿਸ ਦਾ ਰੂਪ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "कवन रूप रानी तुम हो जू ॥",
      "sourceLineId": "133070",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਿਧੋ ਅਪਛਰਾ ਸਾਚ ਕਹੋ ਜੂ ॥",
      "transliteration": "kidho apachharaa saach kaho joo ||",
      "translation": "",
      "punjabiViakhya": "ਕੀ ਤੂੰ ਅਪੱਛਰਾ ਹੈਂ, ਸਚ ਦਸ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "किधो अपछरा साच कहो जू ॥",
      "sourceLineId": "133071",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕੈ ਤੁਮ ਹੋ ਰਤਿ ਪਤਿ ਕੀ ਨਾਰੀ ॥",
      "transliteration": "kai tum ho rat pat kee naaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਤੂੰ ਕਾਮ ਦੀ ਇਸਤਰੀ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "कै तुम हो रति पति की नारी ॥",
      "sourceLineId": "133072",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕੈ ਨਿਸਿ ਪਤਿ ਕੀ ਅਹਹੁ ਕੁਮਾਰੀ ॥੯॥",
      "transliteration": "kai nis pat kee ahahu kumaaree ||9||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਚੰਦ੍ਰਮਾ ਦੀ ਕੁਮਾਰੀ ਹੈਂ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "कै निसि पति की अहहु कुमारी ॥९॥",
      "sourceLineId": "133073",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਚਰਚਾ ਕਰੀ ॥",
      "transliteration": "bhaat bhaat tan charachaa karee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਭਾਤ ਭਾਤ ਦੀ ਚਰਚਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन चरचा करी ॥",
      "sourceLineId": "133074",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬੇਦ ਬ੍ਯਾਕਰਨ ਕੋਕ ਉਚਰੀ ॥",
      "transliteration": "bedh bayaakaran kok ucharee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵੇਦ, ਵਿਆਕਰਨ ਅਤੇ ਕੋਕ ਸ਼ਾਸਤ੍ਰ ਦਾ ਉਚਾਰਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "बेद ब्याकरन कोक उचरी ॥",
      "sourceLineId": "133075",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਚਿਤ ਤਾ ਕੋ ਹਰਿ ਲੀਨਾ ॥",
      "transliteration": "jayo(n) tayo(n) chit taa ko har leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕਿਵੇਾਂ (ਰਾਣੀ ਨੇ) ਰਾਜੇ ਦਾ ਦਿਲ ਜਿਤ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "ज्यों त्यों चित ता को हरि लीना ॥",
      "sourceLineId": "133076",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਿਨਾ ਘਾਇ ਘਾਯਲ ਪਤਿ ਕੀਨਾ ॥੧੦॥",
      "transliteration": "binaa ghai ghaayal pat keenaa ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਿਨਾ ਘਾਓ ਦੇ (ਪ੍ਰੇਮ ਦੇ ਤੀਰਾ ਨਾਲ) ਆਪਣੇ ਪਤੀ ਨੂੰ ਘਾਇਲ ਕਰ ਦਿੱਤਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "बिना घाइ घायल पति कीना ॥१०॥",
      "sourceLineId": "133077",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮਗਨ ਭਯੋ ਚਿਤ ਭੀਤਰ ਭੂਪਾ ॥",
      "transliteration": "magan bhayo chit bheetar bhoopaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਨਾਰੀ ਦਾ ਅਨੂਪਮ ਰੂਪ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "मगन भयो चित भीतर भूपा ॥",
      "sourceLineId": "133078",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਿਰਖਿ ਨਾਰਿ ਕੋ ਰੂਪ ਅਨੂਪਾ ॥",
      "transliteration": "nirakh naar ko roop anoopaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਮਨ ਵਿਚ ਮਗਨ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "निरखि नारि को रूप अनूपा ॥",
      "sourceLineId": "133079",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਏਕ ਬਾਰ ਕਹ ਜੌ ਇਹ ਪਾਊਾਂ ॥",
      "transliteration": "ek baar keh jau ieh paauooaa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਵਿਚਾਰਨ ਲਗਿਆ ਕਿ) ਜੇ ਇਕ ਵਾਰ ਇਸ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰ ਲਵਾ",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "एक बार कह जौ इह पाऊाँ ॥",
      "sourceLineId": "133080",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਨਮ ਅਨੇਕ ਲਗੇ ਬਲਿ ਜਾਊਾਂ ॥੧੧॥",
      "transliteration": "janam anek lage bal jaauooaa(n) ||11||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਅਨੇਕ ਜਨਮਾ ਤਕ ਇਸ ਤੋਂ ਬਲਿਹਾਰ ਜਾਵਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "जनम अनेक लगे बलि जाऊाँ ॥११॥",
      "sourceLineId": "133081",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨ੍ਰਿਪਹੁ ਨਾਰਿ ਕਹ ਅਧਿਕ ਰਿਝਾਯੋ ॥",
      "transliteration": "nirapahu naar keh adhik rijhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਇਸਤਰੀ ਨੂੰ ਬਹੁਤ ਪ੍ਰਸੰਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "नृपहु नारि कह अधिक रिझायो ॥",
      "sourceLineId": "133082",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਭਾਤਿ ਅਨਿਕ ਸੇਤੀ ਉਰਝਾਯੋ ॥",
      "transliteration": "bhaat anik setee urajhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਨੇਕ ਤਰ੍ਰਹਾ ਨਾਲ ਉਸ ਨੂੰ ਉਲਝਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "भाति अनिक सेती उरझायो ॥",
      "sourceLineId": "133083",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਭਜੌ ਯਾਹਿ ਮਨ ਮਾਹਿ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "bhajau yaeh man maeh bichaariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਮਨ ਵਿਚ ਵਿਚਾਰ ਕੀਤਾ ਕਿ ਇਸ ਨਾਲ ਰਮਣ ਕਰਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "भजौ याहि मन माहि बिचारियो ॥",
      "sourceLineId": "133084",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਤਾ ਸੌ ਬਚਨ ਉਚਾਰਿਯੋ ॥੧੨॥",
      "transliteration": "eeh bidh taa sau bachan uchaariyo ||12||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਲਈ ਉਸ ਨੇ) ਰਾਣੀ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "इह बिधि ता सौ बचन उचारियो ॥१२॥",
      "sourceLineId": "133085",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹਮ ਤੁਮ ਆਉ ਰਮੈ ਮਿਲਿ ਦੋਊ ॥",
      "transliteration": "ham tum aau ramai mil dhouoo ||",
      "translation": "",
      "punjabiViakhya": "ਆਓ! ਮੈਂ ਅਤੇ ਤੂੰ ਦੋਵੇਾਂ ਮਿਲ ਕੇ ਰਮਣ ਕਰੀਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "हम तुम आउ रमै मिलि दोऊ ॥",
      "sourceLineId": "133086",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਔਰ ਨ ਲਖਤ ਹਮੈ ਹ੍ਯਾਂ ਕੋਊ ॥",
      "transliteration": "aauar na lakhat hamai hayaa(n) kouoo ||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸਾਨੂੰ ਹੋਰ ਕੋਈ ਵੇਖ ਨਹੀਂ ਰਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "और न लखत हमै ह्याँ कोऊ ॥",
      "sourceLineId": "133087",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕ੍ਯੋ ਤਰੁਨਾਪਨ ਬ੍ਰਿਥਾ ਗਵਾਵਤ ॥",
      "transliteration": "kayo tarunaapan birathaa gavaavat ||",
      "translation": "",
      "punjabiViakhya": "(ਤੂੰ ਆਪਣੀ) ਜਵਾਨੀ ਨੂੰ ਕਿਉਾਂ ਵਿਅਰਥ ਗਵਾ ਰਹੀ ਹੈਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "क्यो तरुनापन बृथा गवावत ॥",
      "sourceLineId": "133088",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਾਨੀ ਹ੍ਵੈ ਕ੍ਯੋ ਨ ਸੇਜ ਸੁਹਾਵਤ ॥੧੩॥",
      "transliteration": "raanee havai kayo na sej suhaavat ||13||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਬਣ ਕੇ ਕਿਉਾਂ ਨਹੀਂ (ਮੇਰੀ) ਸੇਜ ਨੂੰ ਸੁਸ਼ੋਭਿਤ ਕਰਦੀ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "रानी ह्वै क्यो न सेज सुहावत ॥१३॥",
      "sourceLineId": "133089",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਸ ਤਨ ਸੁੰਦਰਿ ਧੂਰਿ ਨ ਲਾਵਹੁ ॥",
      "transliteration": "as tan su(n)dhar dhoor na laavahu ||",
      "translation": "",
      "punjabiViakhya": "ਅਜਿਹੇ ਸੁੰਦਰ ਸ਼ਰੀਰ ਨੂੰ ਮਿਟੀ ਵਿਚ ਨਾ ਰੋਲੋ",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "अस तन सुँदरि धूरि न लावहु ॥",
      "sourceLineId": "133090",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜੋਬਨ ਜਾਲ ਨ ਬ੍ਰਿਥਾ ਗਵਾਵਹੁ ॥",
      "transliteration": "joban jaal na birathaa gavaavahu ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਜੋਬਨ ਜਾਲ ਨੂੰ ਵਿਅਰਥ ਨਾ ਗਵਾਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "जोबन जाल न बृथा गवावहु ॥",
      "sourceLineId": "133091",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਿਰਧਾਪਨੋ ਆਇ ਜਬ ਜੈ ਹੈ ॥",
      "transliteration": "biradhaapano aai jab jai hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਬੁਢਾਪਾ ਆ ਜਾਏਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "बिरधापनो आइ जब जै है ॥",
      "sourceLineId": "133092",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਇਹ ਜ੍ਵਾਨੀ ਕਹ ਤਬ ਪਛਤੈ ਹੈ ॥੧੪॥",
      "transliteration": "eeh javaiaanee keh tab pachhatai hai ||14||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਸ ਜਵਾਨੀ ਲਈ ਤਦ ਪਛਤਾਓਗੀ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "इह ज्वानी कह तब पछतै है ॥१४॥",
      "sourceLineId": "133093",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਹ ਜੋਬਨ ਕੇ ਕਹਾ ਗੁਮਾਨਾ ॥",
      "transliteration": "eeh joban ke kahaa gumaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਜੋਬਨ ਦਾ ਕੀ ਗੁਮਾਨ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "इह जोबन के कहा गुमाना ॥",
      "sourceLineId": "133094",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜੋ ਕਾਹੂ ਪਰ ਥਿਰ ਨ ਰਹਾਨਾ ॥",
      "transliteration": "jo kaahoo par thir na rahaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਕਿਸੇ ਉਤੇ ਵੀ ਸਥਾਈ ਤੌਰ ਤੇ ਨਹੀਂ ਰਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "जो काहू पर थिर न रहाना ॥",
      "sourceLineId": "133095",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਆਉ ਕਰੈ ਦੋਊ ਭੋਗ ਬਿਲਾਸਾ ॥",
      "transliteration": "aau karai dhouoo bhog bilaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਆਓ, ਦੋਵੇਾਂ ਭੋਗ ਵਿਲਾਸ ਕਰੀਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "आउ करै दोऊ भोग बिलासा ॥",
      "sourceLineId": "133096",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਹਾ ਕਰਤ ਯਾ ਕੋ ਭਰਵਾਸਾ ॥੧੫॥",
      "transliteration": "kahaa karat yaa ko bharavaasaa ||15||",
      "translation": "",
      "punjabiViakhya": "ਇਸ (ਜਵਾਨੀ) ਦਾ ਕੀ ਭਰੋਸਾ ਕਰਨਾ ਹੈ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "कहा करत या को भरवासा ॥१५॥",
      "sourceLineId": "133097",
      "sourceShabadId": "12518",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "133098",
      "sourceShabadId": "12519",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਧਨ ਜੋਬਨ ਕੋ ਕਹਾ ਗੁਮਾਨ ਨ ਕੀਜਿਯੈ ॥",
      "transliteration": "dhan joban ko kahaa gumaan na keejiyai ||",
      "translation": "",
      "punjabiViakhya": "ਧਨ ਅਤੇ ਜੋਬਨ ਦਾ ਕਦੇ ਗੁਮਾਨ ਨਹੀਂ ਕਰਨਾ ਚਾਹੀਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "धन जोबन को कहा गुमान न कीजियै ॥",
      "sourceLineId": "133099",
      "sourceShabadId": "12519",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੁਖ ਹਮ ਕੌ ਦੈ ਤਰੁਨਿ ਆਪਿ ਸੁਖੁ ਲੀਜਿਯੈ ॥",
      "transliteration": "sukh ham kau dhai tarun aap sukh leejiyai ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਜਵਾਨ ਇਸਤਰੀ! ਮੈਨੂੰ ਸੁਖ ਦੇ ਅਤੇ ਆਪ ਵੀ ਸੁਖ ਲੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "सुख हम कौ दै तरुनि आपि सुखु लीजियै ॥",
      "sourceLineId": "133100",
      "sourceShabadId": "12519",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਿਰਧਾਪਨੁ ਐ ਹੈ ਤਰਨਾਪਨ ਜਾਇ ਹੈ ॥",
      "transliteration": "biradhaapan aai hai taranaapan jai hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਵਾਨੀ ਚਲੀ ਜਾਏਗੀ ਅਤੇ ਬੁਢਾਪਾ ਆ ਜਾਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "बिरधापनु ऐ है तरनापन जाइ है ॥",
      "sourceLineId": "133101",
      "sourceShabadId": "12519",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹੋ ਤਬ ਇਹ ਸਮੈ ਸੰਭਾਰਿ ਅਧਿਕ ਪਛੁਤਾਇ ਹੈ ॥੧੬॥",
      "transliteration": "ho tab ieh samai sa(n)bhaar adhik pachhutai hai ||16||",
      "translation": "",
      "punjabiViakhya": "(ਤੂੰ) ਇਸ ਸਮੇਾਂ ਨੂੰ ਯਾਦ ਕਰ ਕੇ, (ਸਮਾ ਬੀਤ ਜਾਣ ਤੇ) ਬਹੁਤ ਪਛਤਾਏਾਂਗੀ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "हो तब इह समै संभारि अधिक पछुताइ है ॥१६॥",
      "sourceLineId": "133102",
      "sourceShabadId": "12519",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133103",
      "sourceShabadId": "12520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪ੍ਰਥਮ ਕਹੀ ਮੇਰੀ ਜੋ ਕਰੈ ॥",
      "transliteration": "pratham kahee meree jo karai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ ਕਿਹਾ) ਜੇ (ਤੁਸੀਂ) ਪਹਿਲਾ ਮੇਰੀ ਕਹੀ ਗੱਲ ਨੂੰ ਮੰਨੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "प्रथम कही मेरी जो करै ॥",
      "sourceLineId": "133104",
      "sourceShabadId": "12520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਿਹ ਪਾਛੈ ਮੁਹਿ ਸਾਥ ਬਿਹਰੈ ॥",
      "transliteration": "teh paachhai muh saath biharai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਿਛੋਂ ਮੇਰੇ ਨਾਲ ਰਮਣ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "तिह पाछै मुहि साथ बिहरै ॥",
      "sourceLineId": "133105",
      "sourceShabadId": "12520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਚਨ ਦੀਜਿਐ ਮੇਰੋ ਹਾਥਾ ॥",
      "transliteration": "bachan dheejiaai mero haathaa ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਮੈਨੂੰ ਹੱਥ ਨਾਲ ਬਚਨ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "बचन दीजिऐ मेरो हाथा ॥",
      "sourceLineId": "133106",
      "sourceShabadId": "12520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤੌ ਮੈ ਮਾਨੌ ਬਚ ਤੌ ਨਾਥਾ ॥੧੭॥",
      "transliteration": "tau mai maanau bach tau naathaa ||17||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਨਾਥ! ਤਦ ਮੈਂ ਤੁਹਾਡਾ ਬਚਨ ਮੰਨਾਗੀ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "तौ मै मानौ बच तौ नाथा ॥१७॥",
      "sourceLineId": "133107",
      "sourceShabadId": "12520",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "133108",
      "sourceShabadId": "12521",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪ੍ਰਿਥਮ ਤ੍ਰਿਯਾ ਕੋ ਦੋਖ ਛਿਮਾਪਨ ਕੀਜਿਯੈ ॥",
      "transliteration": "piratham tirayaa ko dhokh chhimaapan keejiyai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ (ਆਪਣੀ) ਇਸਤਰੀ ਦਾ ਦੋਸ਼ ਖਿਮਾ ਕਰ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "पृथम तृया को दोख छिमापन कीजियै ॥",
      "sourceLineId": "133109",
      "sourceShabadId": "12521",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਿਹ ਪਾਛੇ ਮੋਰਾ ਮਨ ਨ੍ਰਿਪ ਬਰ ਲੀਜਿਯੈ ॥",
      "transliteration": "teh paachhe moraa man nirap bar leejiyai ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸ੍ਰੇਸ਼ਠ ਰਾਜੇ! ਉਸ ਪਿਛੋਂ ਮੇਰਾ ਮਨ ਲੈ ਲੈਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "तिह पाछे मोरा मन नृप बर लीजियै ॥",
      "sourceLineId": "133110",
      "sourceShabadId": "12521",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਦੋਖ ਛਿਮਾਪਨ ਕੀਨ ਬਚਨ ਤ੍ਰਿਯ ਕੋ ਤਬੈ ॥",
      "transliteration": "dhokh chhimaapan keen bachan tiray ko tabai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਤਦ ਇਸਤਰੀ ਦੇ ਦੋਸ਼ ਨੂੰ ਖਿਮਾ ਕਰਨ ਦਾ ਬਚਨ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "दोख छिमापन कीन बचन तृय को तबै ॥",
      "sourceLineId": "133111",
      "sourceShabadId": "12521",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹੋ ਸੁਨੇ ਸੰਨ੍ਯਾਸਿਨਿ ਬੈਨ ਸ੍ਰਵਨ ਭੀਤਰ ਜਬੈ ॥੧੮॥",
      "transliteration": "ho sune sa(n)nayaasin bain sravan bheetar jabai ||18||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸੰਨਿਆਸਣ ਨੇ ਆਪਣੇ ਕੰਨਾ ਨਾਲ ਸੁਣਿਆ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "हो सुने संन्यासिनि बैन स्रवन भीतर जबै ॥१८॥",
      "sourceLineId": "133112",
      "sourceShabadId": "12521",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133113",
      "sourceShabadId": "12522",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1252_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਤ੍ਰਿਯ ਕੇ ਗ੍ਰਿਹ ਆਵੈ ॥",
      "transliteration": "ek dhivas tiray ke gireh aavai ||",
      "translation": "",
      "punjabiViakhya": "(ਹੁਣ ਰਾਜਾ) ਇਕ ਦਿਨ (ਪਹਿਲੀ) ਰਾਣੀ ਦੇ ਘਰ ਆਂਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1252,
      "hindi": "",
      "hindiTransliteration": "एक दिवस तृय के गृह आवै ॥",
      "sourceLineId": "133114",
      "sourceShabadId": "12522",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
