{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1253,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1253_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੁਤਿਯ ਦਿਵਸ ਤਾ ਕੇ ਘਰ ਜਾਵੈ ॥",
      "transliteration": "dhutiy dhivas taa ke ghar jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੂਜੇ ਦਿਨ ਉਸ (ਸੰਨਿਆਸਣ ਬਣੀ) ਇਸਤਰੀ ਦੇ ਘਰ ਜਾਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "दुतिय दिवस ता के घर जावै ॥",
      "sourceLineId": "133115",
      "sourceShabadId": "12522",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਾਨੀ ਭੇਸ ਸੰਨ੍ਯਾਸਿਨਿ ਧਰੈ ॥",
      "transliteration": "raanee bhes sa(n)nayaasin dharai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਸੰਨਿਆਸਣ ਦਾ ਭੇਸ ਧਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "रानी भेस संन्यासिनि धरै ॥",
      "sourceLineId": "133116",
      "sourceShabadId": "12522",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਰਾਜਾ ਤਨ ਕਰੈ ॥੧੯॥",
      "transliteration": "kaam bhog raajaa tan karai ||19||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨਾਲ ਕਾਮ ਭੋਗ ਕਰਦੀ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "काम भोग राजा तन करै ॥१९॥",
      "sourceLineId": "133117",
      "sourceShabadId": "12522",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਿਹ ਨ੍ਰਿਪ ਦੁਤਿਯ ਨਾਰਿ ਕਰਿ ਜਾਨੈ ॥",
      "transliteration": "teh nirap dhutiy naar kar jaanai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਰਾਜਾ ਦੂਜੀ ਇਸਤਰੀ ਕਰ ਕੇ ਸਮਝਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "तिह नृप दुतिय नारि करि जानै ॥",
      "sourceLineId": "133118",
      "sourceShabadId": "12522",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਮੂੜ੍ਰਹ ਪਛਾਨੈ ॥",
      "transliteration": "bhedh abhedh na mooRreh pachhaanai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਮੂਰਖ ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਹੀਂ ਸਮਝਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न मूड़्रह पछानै ॥",
      "sourceLineId": "133119",
      "sourceShabadId": "12522",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਇਸਤ੍ਰੀ ਚਰਿਤ੍ਰ ਨਹੀ ਲਖਿ ਪਾਵੈ ॥",
      "transliteration": "eisatree charitr nahee lakh paavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਸਤਰੀ ਦੇ ਚਰਿਤ੍ਰ ਨੂੰ ਨਹੀਂ ਸਮਝ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "इसत्री चरित्र नही लखि पावै ॥",
      "sourceLineId": "133120",
      "sourceShabadId": "12522",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਿਤਪ੍ਰਤਿ ਅਪਨੋ ਮੂੰਡ ਮੁੰਡਾਵੈ ॥੨੦॥",
      "transliteration": "nitaprat apano moo(n)dd mu(n)ddaavai ||20||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਰਾਜਾ) ਨਿੱਤ ਆਪਣਾ ਸਿਰ ਮੁੰਨਵਾਉਾਂਦਾ ਸੀ (ਭਾਵ-ਠਗਿਆ ਜਾਦਾ ਸੀ) ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "नितप्रति अपनो मूँड मुँडावै ॥२०॥",
      "sourceLineId": "133121",
      "sourceShabadId": "12522",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਤੀਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੦੩॥੫੮੪੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau teen charitr samaapatam sat subham sat ||303||5840||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੦੩ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੦੩॥੫੮੪੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ तीन चरित्र समापतम सतु सुभम सतु ॥३०३॥५८४०॥अफजूँ॥",
      "sourceLineId": "133122",
      "sourceShabadId": "12522",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133123",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਿਧੀ ਸੈਨ ਰਾਜਾ ਇਕ ਸੂਰੋ ॥",
      "transliteration": "bidhee sain raajaa ik sooro ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਧੀ ਸੈਨ ਨਾ ਦਾ ਇਕ ਸੂਰਮਾ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "बिधी सैन राजा इक सूरो ॥",
      "sourceLineId": "133124",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤੇਗ ਦੇਗ ਦੁਹੂੰਅਨਿ ਕਰਿ ਪੂਰੋ ॥",
      "transliteration": "teg dheg dhuhoo(n)an kar pooro ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਦੇਗ ਅਤੇ ਤੇਗ ਦੋਹਾ ਵਿਚ ਨਿਪੁਣ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "तेग देग दुहूँअनि करि पूरो ॥",
      "sourceLineId": "133125",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤੇਜਵਾਨ ਦੁਤਿਵਾਨ ਅਤੁਲ ਬਲ ॥",
      "transliteration": "tejavaan dhutivaan atul bal ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਤੇਜਵਾਨ, ਸੁੰਦਰ ਅਤੇ ਅਤੁਲ ਬਲ ਵਾਲਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "तेजवान दुतिवान अतुल बल ॥",
      "sourceLineId": "133126",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਰਿ ਅਨੇਕ ਜੀਤੇ ਜਿਨ ਦਲਿ ਮਲਿ ॥੧॥",
      "transliteration": "ar anek jeete jin dhal mal ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਅਨੇਕ ਵੈਰੀ ਦਰੜ ਕੇ ਜਿਤ ਲਏ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "अरि अनेक जीते जिन दलि मलि ॥१॥",
      "sourceLineId": "133127",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਿਧ੍ਰਯ ਮਤੀ ਦੁਹਿਤਾ ਇਕ ਤਾ ਕੇ ॥",
      "transliteration": "bidhray matee dhuhitaa ik taa ke ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਧ੍ਰਯ ਮਤੀ ਨਾ ਦੀ ਉਸ ਦੀ ਇਕ ਪੁੱਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "बिध्रय मती दुहिता इक ता के ॥",
      "sourceLineId": "133128",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਰੀ ਨਾਗਨੀ ਸਮ ਨਹਿ ਜਾ ਕੇ ॥",
      "transliteration": "naree naaganee sam neh jaa ke ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਸਮਾਨ (ਕੋਈ) ਨਰੀ ਜਾ ਨਾਗਨੀ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "नरी नागनी सम नहि जा के ॥",
      "sourceLineId": "133129",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਪ੍ਰਮਾਨ ਤਿਹ ਸੇਜ ਸੁਹਾਵੈ ॥",
      "transliteration": "apramaan teh sej suhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੇਜ ਬਹੁਤ ਅਧਿਕ ਸੁਹਾਵਣੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "अप्रमान तिह सेज सुहावै ॥",
      "sourceLineId": "133130",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਵਿ ਸਸਿ ਰੋਜ ਬਿਲੋਕਨ ਆਵੈ ॥੨॥",
      "transliteration": "rav sas roj bilokan aavai ||2||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ) ਚੰਦ੍ਰਮਾ ਅਤੇ ਸੂਰਜ ਰੋਜ਼ ਵੇਖਣ ਆਉਾਂਦੇ ਸਨ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "रवि ससि रोज बिलोकन आवै ॥२॥",
      "sourceLineId": "133131",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾ ਕੋ ਲਗਿਯੋ ਏਕ ਸੰਗ ਨੇਹਾ ॥",
      "transliteration": "taa ko lagiyo ek sa(n)g nehaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਇਕ ਨਾਲ ਪਿਆਰ ਹੋ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "ता को लगियो एक संग नेहा ॥",
      "sourceLineId": "133132",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜ੍ਯੋਂ ਸਾਵਨ ਕੋ ਬਰਿਸਤ ਮੇਹਾ ॥",
      "transliteration": "jayo(n) saavan ko barisat mehaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਸਾਵਣ ਦੇ ਮਹੀਨੇ ਵਿਚ ਮੀਂਹ ਵਰ੍ਰਹਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "ज्यों सावन को बरिसत मेहा ॥",
      "sourceLineId": "133133",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚਤੁਰ ਕੁਅਰ ਤਿਹ ਨਾਮ ਭਨਿਜੈ ॥",
      "transliteration": "chatur kuar teh naam bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਾ ਚਤੁਰ ਕੁਮਾਰ ਕਿਹਾ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "चतुर कुअर तिह नाम भनिजै ॥",
      "sourceLineId": "133134",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਵਨ ਪੁਰਖ ਪਟਤਰ ਤਿਹ ਦਿਜੈ ॥੩॥",
      "transliteration": "kavan purakh paTatar teh dhijai ||3||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਕਿਸ ਪੁਰਸ਼ ਨਾਲ ਤੁਲਨਾ ਦਿੱਤੀ ਜਾ ਸਕਦੀ ਹੈ? (ਭਾਵ ਨਹੀਂ ਦਿੱਤੀ ਜਾ ਸਕਦੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "कवन पुरख पटतर तिह दिजै ॥३॥",
      "sourceLineId": "133135",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਿਧ੍ਯਾ ਦੇਈ ਇਕ ਦਿਨ ਰਸਿ ਕੈ ॥",
      "transliteration": "bidhayaa dheiee ik dhin ras kai ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਧ੍ਰਯਾ ਦੇਈ ਨੇ ਇਕ ਦਿਨ ਪ੍ਰਸੰਨਤਾ ਪੂਰਵਕ",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "बिध्या देई इक दिन रसि कै ॥",
      "sourceLineId": "133136",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬੋਲਿ ਲਿਯਾ ਪ੍ਰੀਤਮ ਕਹ ਕਸਿ ਕੈ ॥",
      "transliteration": "bol liyaa preetam keh kas kai ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰੀਤਮ ਨੂੰ ਜ਼ਬਰਦਸਤੀ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "बोलि लिया प्रीतम कह कसि कै ॥",
      "sourceLineId": "133137",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਿਹ ਸਾਥ ਕਮਾਯੋ ॥",
      "transliteration": "kaam bhog teh saath kamaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਕਾਮ ਭੋਗ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "काम भोग तिह साथ कमायो ॥",
      "sourceLineId": "133138",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਰੁਨੀ ਤਰੁਨ ਅਧਿਕ ਸੁਖ ਪਾਯੋ ॥੪॥",
      "transliteration": "tarunee tarun adhik sukh paayo ||4||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਅਤੇ ਪੁਰਸ਼ ਦੋਹਾ ਨੇ ਬਹੁਤ ਸੁਖ ਪ੍ਰਾਪਤ ਕੀਤਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "तरुनी तरुन अधिक सुख पायो ॥४॥",
      "sourceLineId": "133139",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਿਧੀ ਸੈਨ ਸੌ ਕਿਨਹਿ ਜਤਾਈ ॥",
      "transliteration": "bidhee sain sau kineh jataiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਬਿਧੀ ਸੈਨ ਨੂੰ ਦਸ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "बिधी सैन सौ किनहि जताई ॥",
      "sourceLineId": "133140",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੋਰਿ ਸੁਤਾ ਗ੍ਰਿਹ ਜਾਰ ਬੁਲਾਈ ॥",
      "transliteration": "tor sutaa gireh jaar bulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੇਰੀ ਪੁੱਤਰੀ ਨੇ ਘਰ ਵਿਚ ਯਾਰ ਨੂੰ ਬੁਲਾਇਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "तोरि सुता गृह जार बुलाई ॥",
      "sourceLineId": "133141",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਿਹ ਸਾਥ ਕਰਤ ਹੈ ॥",
      "transliteration": "kaam bhog teh saath karat hai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਕਾਮ ਭੋਗ ਕਰਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "काम भोग तिह साथ करत है ॥",
      "sourceLineId": "133142",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤੋ ਤੇ ਨ੍ਰਿਪ ਨਹਿ ਨੈਕੁ ਡਰਤ ਹੈ ॥੫॥",
      "transliteration": "to te nirap neh naik ddarat hai ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੇ ਰਾਜਨ! ਤੇਰੇ ਤੋਂ ਬਿਲਕੁਲ ਨਹੀਂ ਡਰਦੀ ਹੈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "तो ते नृप नहि नैकु डरत है ॥५॥",
      "sourceLineId": "133143",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਬ ਨ੍ਰਿਪ ਸਾਥ ਤਿਸੀ ਕੋ ਲੈ ਕੈ ॥",
      "transliteration": "tab nirap saath tisee ko lai kai ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜਾ ਉਸੇ ਨੂੰ ਨਾਲ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "तब नृप साथ तिसी को लै कै ॥",
      "sourceLineId": "133144",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਾਤ ਭਯੋ ਤਹ ਅਧਿਕ ਰਿਸੈ ਕੈ ॥",
      "transliteration": "jaat bhayo teh adhik risai kai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰੋਹ ਵਿਚ ਆ ਕੇ ਉਧਰ ਵਲ ਤੁਰ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "जात भयो तह अधिक रिसै कै ॥",
      "sourceLineId": "133145",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਿਧ੍ਯਾ ਮਤੀ ਜਬੈ ਸੁਨਿ ਪਾਈ ॥",
      "transliteration": "bidhayaa matee jabai sun paiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਬਿਧ੍ਰਯਾ ਮਤੀ ਨੇ ਸੁਣਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "बिध्या मती जबै सुनि पाई ॥",
      "sourceLineId": "133146",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮੀਤ ਸਹਿਤ ਜਿਯ ਮੈ ਡਰ ਪਾਈ ॥੬॥",
      "transliteration": "meet sahit jiy mai ddar paiee ||6||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਮਿਤਰ ਸਹਿਤ ਮਨ ਵਿਚ ਬਹੁਤ ਡਰ ਗਈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "मीत सहित जिय मै डर पाई ॥६॥",
      "sourceLineId": "133147",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਖੋਦਿ ਛਾਤ ਦ੍ਵੈ ਛੇਦ ਸਵਾਰੇ ॥",
      "transliteration": "khodh chhaat dhavai chhedh savaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਛਤ ਨੂੰ ਪੁਟ ਕੇ ਦੋ ਮਘੋਰੇ ਕੀਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "खोदि छात द्वै छेद सवारे ॥",
      "sourceLineId": "133148",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਿਹ ਆਵਤ ਵੈ ਰਾਹ ਬਿਚਾਰੇ ॥",
      "transliteration": "jeh aavat vai raeh bichaare ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਪਾਸੇ ਤੋਂ ਉਨ੍ਰਹਾ ਨੂੰ ਆਉਾਂਦਿਆਂ ਵਿਚਾਰਿਆ ਸੀ (ਭਾਵ ਆਉਾਂਦੇ ਵੇਖੇ ਸਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "जिह आवत वै राह बिचारे ॥",
      "sourceLineId": "133149",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਿਹ ਮਗ ਹ੍ਵੈ ਬਿਸਟਾ ਦੁਹੂੰ ਕਰਾ ॥",
      "transliteration": "teh mag havai bisaTaa dhuhoo(n) karaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ (ਮਘੋਰਿਆਂ ਰਾਹੀਂ) ਦੋਹਾ ਨੇ ਵਿਸ਼ਟਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "तिह मग ह्वै बिसटा दुहूँ करा ॥",
      "sourceLineId": "133150",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੂਤ ਸਹਿਤ ਨ੍ਰਿਪ ਕੇ ਸਿਰ ਪਰਾ ॥੭॥",
      "transliteration": "dhoot sahit nirap ke sir paraa ||7||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਦੂਤ ਸਮੇਤ ਰਾਜੇ ਦੇ ਸਿਰ ਉਤੇ ਪਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "दूत सहित नृप के सिर परा ॥७॥",
      "sourceLineId": "133151",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅੰਧ ਗਏ ਹ੍ਵੈ ਸੂਝ ਨ ਆਯੋ ॥",
      "transliteration": "a(n)dh ge havai soojh na aayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਦੋਵੇਾਂ) ਅੰਨ੍ਰਹੇ ਹੋ ਗਏ ਅਤੇ ਕੁਝ ਵੀ ਵੇਖ ਨਾ ਸਕੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "अंध गए ह्वै सूझ न आयो ॥",
      "sourceLineId": "133152",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਿਸੀ ਪੈਡ ਗ੍ਰਿਹਿ ਜਾਰ ਪਠਾਯੋ ॥",
      "transliteration": "tisee paidd gireh jaar paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਰਸਤੇ ਦੁਆਰਾ ਯਾਰ ਨੂੰ ਘਰ ਪਹੁੰਚਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "तिसी पैड गृहि जार पठायो ॥",
      "sourceLineId": "133153",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰਾਜਾ ਭੇਦ ਅਭੇਦ ਨ ਲਹਾ ॥",
      "transliteration": "raajaa bhedh abhedh na lahaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਭੇਦ ਅਭੇਦ ਕੁਝ ਨਾ ਸਮਝ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "राजा भेद अभेद न लहा ॥",
      "sourceLineId": "133154",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੁਹਿਤਾ ਕਾਮ ਕੈ ਗਈ ਕਹਾ ॥੮॥",
      "transliteration": "dhuhitaa kaam kai giee kahaa ||8||",
      "translation": "",
      "punjabiViakhya": "(ਸੋਚਣ ਲਗਿਆ) ਪੁੱਤਰੀ ਕਿਸੇ ਕੰਮ ਲਈ ਕਿਤੇ ਗਈ ਹੈ। (ਅਰਥਾਤਰ-ਪੁੱਤਰੀ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰ ਕੇ ਕਿਥੇ ਗਈ ਹੈ) ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "दुहिता काम कै गई कहा ॥८॥",
      "sourceLineId": "133155",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਿਸਟਾ ਰਹੀ ਦੁਹੂੰ ਕੇ ਲਗਿ ਕੈ ॥",
      "transliteration": "bisaTaa rahee dhuhoo(n) ke lag kai ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਸ਼ਟਾ ਦੋਹਾ (ਦੇ ਸਿਰ ਉਤੇ) ਲਗ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "बिसटा रही दुहूँ के लगि कै ॥",
      "sourceLineId": "133156",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੁ ਘਰ ਗਯੋ ਤਿਹ ਕੇ ਸਿਰ ਹਗਿ ਕੈ ॥",
      "transliteration": "s ghar gayo teh ke sir hag kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਵਿਅਕਤੀ ਦੋਹਾ ਦੇ ਸਿਰ ਉਤੇ ਹਗ ਕੇ ਚਲਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "सु घर गयो तिह के सिर हगि कै ॥",
      "sourceLineId": "133157",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਘਰੀਕ ਲਗੀ ਧੋਵਤੇ ਬਦਨਨ ॥",
      "transliteration": "ghareek lagee dhovate badhanan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੂੰ) ਮੂੰਹ ਸਿਰ ਧੋਣ ਤੇ ਇਕ ਘੜੀ ਲਗ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "घरीक लगी धोवते बदनन ॥",
      "sourceLineId": "133158",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਹੁਰਿ ਗਏ ਦੁਹਿਤਾ ਕੈ ਸਦਨਨ ॥੯॥",
      "transliteration": "bahur ge dhuhitaa kai sadhanan ||9||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤੋਂ ਬਾਦ (ਉਹ) ਪੁੱਤਰੀ ਦੇ ਘਰ ਨੂੰ ਗਏ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "बहुरि गए दुहिता कै सदनन ॥९॥",
      "sourceLineId": "133159",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਹਾ ਜਾਇ ਜੌ ਨ੍ਰਿਪਤਿ ਨਿਹਰਾ ॥",
      "transliteration": "tahaa jai jau nirapat niharaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਜਾ ਕੇ ਜੋ ਰਾਜੇ ਨੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "तहा जाइ जौ नृपति निहरा ॥",
      "sourceLineId": "133160",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਾਰ ਵਾਰ ਕਛੁ ਦਿਸਟਿ ਨ ਪਰਾ ॥",
      "transliteration": "jaar vaar kachh dhisaT na paraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਕੋਈ ਯਾਰ ਵਾਰ ਨਜ਼ਰ ਨਾ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "जार वार कछु दिसटि न परा ॥",
      "sourceLineId": "133161",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1253_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਬ ਨ੍ਰਿਪ ਉਲਟਿ ਤਿਸੀ ਕੋ ਮਰਿਯੋ ॥",
      "transliteration": "tab nirap ulaT tisee ko mariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜੇ ਨੇ ਉਲਟਾ ਉਸੇ (ਵਿਅਕਤੀ) ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1253,
      "hindi": "",
      "hindiTransliteration": "तब नृप उलटि तिसी को मरियो ॥",
