{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1254,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1254_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਿਸਟਾ ਪ੍ਰਥਮ ਜਾਹਿ ਸਿਰ ਪਰਿਯੋ ॥੧੦॥",
      "transliteration": "bisaTaa pratham jaeh sir pariyo ||10||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਸਿਰ ਉਤੇ ਪਹਿਲਾ ਵਿਸ਼ਟਾ ਪਿਆ ਸੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "बिसटा प्रथम जाहि सिर परियो ॥१०॥",
      "sourceLineId": "133163",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਹ ਛਲ ਸੌ ਤ੍ਰਿਯ ਪਿਯਹਿ ਉਬਾਰਿਯੋ ॥",
      "transliteration": "eeh chhal sau tiray piyeh ubaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਇਸਤਰੀ ਨੇ ਪ੍ਰੀਤਮ ਨੂੰ ਬਚਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "इह छल सौ तृय पियहि उबारियो ॥",
      "sourceLineId": "133164",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਿਨ ਕੇ ਮੁਖ ਬਿਸਟਾ ਕੌ ਡਾਰਿਯੋ ॥",
      "transliteration": "tin ke mukh bisaTaa kau ddaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਦੇ ਮੂੰਹ ਤੇ ਵਿਸ਼ਟਾ ਸੁਟਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "तिन के मुख बिसटा कौ डारियो ॥",
      "sourceLineId": "133165",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭਲਾ ਬੁਰਾ ਭੂਪਤਿ ਨ ਬਿਚਾਰਾ ॥",
      "transliteration": "bhalaa buraa bhoopat na bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਮਾੜਾ ਚੰਗਾ ਕੁਝ ਨਾ ਸੋਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "भला बुरा भूपति न बिचारा ॥",
      "sourceLineId": "133166",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭੇਦ ਦਾਇਕਹਿ ਪਕਰਿ ਪਛਾਰਾ ॥੧੧॥",
      "transliteration": "bhedh dhaikeh pakar pachhaaraa ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੇਦ ਦੇਣ ਵਾਲੇ ਨੂੰ ਹੀ ਪਕੜ ਕੇ ਪਛਾੜ ਦਿੱਤਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "भेद दाइकहि पकरि पछारा ॥११॥",
      "sourceLineId": "133167",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚਾਰ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੦੪॥੫੮੫੧॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau chaar charitr samaapatam sat subham sat ||304||5851||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੦੪ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੦੪॥੫੮੫੧॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ चार चरित्र समापतम सतु सुभम सतु ॥३०४॥५८५१॥अफजूँ॥",
      "sourceLineId": "133168",
      "sourceShabadId": "12523",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133169",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤ੍ਰਿਪੁਰਾ ਸਹਰ ਬਸਤ ਹੈ ਜਹਾ ॥",
      "transliteration": "tirapuraa sahar basat hai jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਤ੍ਰਿਪੁਰਾ ਸ਼ਹਿਰ ਵਸਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "तृपुरा सहर बसत है जहा ॥",
      "sourceLineId": "133170",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤ੍ਰਿਪੁਰ ਪਾਲ ਰਾਜਾ ਥੋ ਤਹਾ ॥",
      "transliteration": "tirapur paal raajaa tho tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਤ੍ਰਿਪੁਰ ਪਾਲ ਨਾ ਦਾ (ਇਕ) ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "तृपुर पाल राजा थो तहा ॥",
      "sourceLineId": "133171",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤ੍ਰਿਪੁਰ ਮਤੀ ਤਾ ਕੀ ਬਰ ਨਾਰੀ ॥",
      "transliteration": "tirapur matee taa kee bar naaree ||",
      "translation": "",
      "punjabiViakhya": "ਤ੍ਰਿਪੁਰ ਮਤੀ ਉਸ ਦੀ ਸੁੰਦਰ ਰਾਣੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "तृपुर मती ता की बर नारी ॥",
      "sourceLineId": "133172",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਨਕ ਅਵਟਿ ਸਾਚੇ ਜਨੁ ਢਾਰੀ ॥੧॥",
      "transliteration": "kanak avaT saache jan ddaaree ||1||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਮਾਨੋ ਸੋਨੇ ਨੂੰ ਪੰਘਾਰ ਕੇ ਸੰਚੇ ਵਿਚ ਢਾਲੀ ਗਈ ਹੋਵੇ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "कनक अवटि साचे जनु ढारी ॥१॥",
      "sourceLineId": "133173",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਫੂਲ ਮਤੀ ਦੂਸਰਿ ਤਿਹ ਸਵਤਿਨਿ ॥",
      "transliteration": "fool matee dhoosar teh savatin ||",
      "translation": "",
      "punjabiViakhya": "ਦੂਜੀ ਫੂਲ ਮਤੀ ਉਸ ਦੀ ਸੌਂਕਣ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "फूल मती दूसरि तिह सवतिनि ॥",
      "sourceLineId": "133174",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਨੁ ਤਿਹ ਹੁਤਾ ਆਖਿ ਮੈਂ ਸੌ ਕਨਿ ॥",
      "transliteration": "jan teh hutaa aakh mai(n) sau kan ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਉਸ ਦੀ ਅੱਖ ਵਿਚ ਕਿਣਕਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "जनु तिह हुता आखि मैं सौ कनि ॥",
      "sourceLineId": "133175",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਾ ਸੌ ਤਾਹਿ ਸਿਪਰਧਾ ਰਹੈ ॥",
      "transliteration": "taa sau taeh siparadhaa rahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਚਿਤ ਵਿਚ ਉਸ ਨਾਲ ਈਰਖਾ ਰਹਿੰਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "ता सौ ताहि सिपरधा रहै ॥",
      "sourceLineId": "133176",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚਿਤ ਭੀਤਰ ਮੁਖ ਤੇ ਨਹਿ ਕਹੈ ॥੨॥",
      "transliteration": "chit bheetar mukh te neh kahai ||2||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਮੁਖ ਤੋਂ ਕੁਝ ਨਹੀਂ ਕਹਿੰਦੀ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "चित भीतर मुख ते नहि कहै ॥२॥",
      "sourceLineId": "133177",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤ੍ਰਿਪੁਰਾ ਮਤੀ ਏਕ ਦਿਜ ਊਪਰ ॥",
      "transliteration": "tirapuraa matee ek dhij uoopar ||",
      "translation": "",
      "punjabiViakhya": "ਤ੍ਰਿਪੁਰਾ ਮਤੀ ਇਕ ਬ੍ਰਾਹਮਣ ਉਪਰ",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "तृपुरा मती एक दिज ऊपर ॥",
      "sourceLineId": "133178",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਟਕੀ ਰਹੈ ਅਧਿਕ ਹੀ ਚਿਤ ਕਰਿ ॥",
      "transliteration": "aTakee rahai adhik hee chit kar ||",
      "translation": "",
      "punjabiViakhya": "ਮਨੋ ਤਨੋ ਬਹੁਤ ਮੋਹਿਤ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "अटकी रहै अधिक ही चित करि ॥",
      "sourceLineId": "133179",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰੈਨਿ ਦਿਵਸ ਗ੍ਰਿਹ ਤਾਹਿ ਬੁਲਾਵੇ ॥",
      "transliteration": "rain dhivas gireh taeh bulaave ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਦਿਨ ਉਸ ਨੂੰ ਘਰ ਬੁਲਾਉਾਂਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "रैनि दिवस गृह ताहि बुलावे ॥",
      "sourceLineId": "133180",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਾਮ ਕੇਲ ਰੁਚਿ ਮਾਨ ਮਚਾਵੈ ॥੩॥",
      "transliteration": "kaam kel ruch maan machaavai ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਰੁਚੀ ਪੂਰਵਕ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਦੀ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "काम केल रुचि मान मचावै ॥३॥",
      "sourceLineId": "133181",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਏਕ ਨਾਰਿ ਤਿਨ ਬੋਲਿ ਪਠਾਈ ॥",
      "transliteration": "ek naar tin bol paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਕ ਇਸਤਰੀ ਨੂੰ ਬੁਲਵਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "एक नारि तिन बोलि पठाई ॥",
      "sourceLineId": "133182",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਧਿਕ ਦਰਬ ਦੈ ਐਸਿ ਸਿਖਾਈ ॥",
      "transliteration": "adhik dharab dhai aais sikhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਧਨ ਦੇ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਸਿਖਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "अधिक दरब दै ऐसि सिखाई ॥",
      "sourceLineId": "133183",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਬ ਹੀ ਜਾਇ ਪ੍ਰਜਾ ਸਭ ਸੋਈ ॥",
      "transliteration": "jab hee jai prajaa sabh soiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜਦੋਂ ਸਾਰੀ ਪ੍ਰਜਾ ਸੌਂ ਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "जब ही जाइ प्रजा सभ सोई ॥",
      "sourceLineId": "133184",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਊਚ ਸਬਦ ਉਠਿਯਹੁ ਤਬ ਰੋਈ ॥੪॥",
      "transliteration": "uooch sabadh uThiyahu tab roiee ||4||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉੱਚੀ ਆਵਾਜ਼ ਵਿਚ ਰੋਣ ਲਗ ਜਾਈਂ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "ऊच सबद उठियहु तब रोई ॥४॥",
      "sourceLineId": "133185",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਯੌ ਕਹਿ ਜਾਇ ਨ੍ਰਿਪਤਿ ਤਨ ਸੋਈ ॥",
      "transliteration": "yau keh jai nirapat tan soiee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ) ਇਹ ਕਹਿ ਕੇ ਰਾਜੇ ਕੋਲ ਜਾ ਕੇ ਸੌਂ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "यौ कहि जाइ नृपति तन सोई ॥",
      "sourceLineId": "133186",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਧੀ ਰਾਤਿ ਅੰਧੇਰੀ ਹੋਈ ॥",
      "transliteration": "aadhee raat a(n)dheree hoiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਅੱਧੀ ਹਨੇਰੀ ਰਾਤ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "आधी राति अंधेरी होई ॥",
      "sourceLineId": "133187",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਧਿਕ ਦੁਖਿਤ ਹ੍ਵੈ ਨਾਰਿ ਪੁਕਾਰੀ ॥",
      "transliteration": "adhik dhukhit havai naar pukaaree ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਬਹੁਤ ਦੁਖੀ ਅਵਸਥਾ ਵਿਚ ਉਸ ਇਸਤਰੀ ਨੇ ਰੋਣਾ ਧੋਣਾ ਸ਼ੁਰੂ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "अधिक दुखित ह्वै नारि पुकारी ॥",
      "sourceLineId": "133188",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨ੍ਰਿਪ ਕੇ ਪਰੀ ਕਾਨ ਧੁਨਿ ਭਾਰੀ ॥੫॥",
      "transliteration": "nirap ke paree kaan dhun bhaaree ||5||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਉੱਚੀ ਆਵਾਜ਼ ਰਾਜੇ ਦੇ ਕੰਨ ਵਿਚ ਵੀ ਪਈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "नृप के परी कान धुनि भारी ॥५॥",
      "sourceLineId": "133189",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰਾਣੀ ਲਈ ਸੰਗ ਅਪਨੇ ਕਰਿ ॥",
      "transliteration": "raanee liee sa(n)g apane kar ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਹੱਥ ਵਿਚ ਤਲਵਾਰ ਧਾਰਨ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "राणी लई संग अपने करि ॥",
      "sourceLineId": "133190",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਾਥ ਬਿਖੈ ਅਪਨੇ ਅਸ ਕੌ ਧਰਿ ॥",
      "transliteration": "haath bikhai apane as kau dhar ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੂੰ ਆਪਣੇ ਨਾਲ ਲੈ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "हाथ बिखै अपने अस कौ धरि ॥",
      "sourceLineId": "133191",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦੋਊ ਚਲਿ ਤੀਰ ਤਵਨ ਕੇ ਗਏ ॥",
      "transliteration": "dhouoo chal teer tavan ke ge ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਚਲ ਕੇ ਉਸ ਕੋਲ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "दोऊ चलि तीर तवन के गए ॥",
      "sourceLineId": "133192",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਸੌ ਪੂਛਤ ਤਿਹ ਭਏ ॥੬॥",
      "transliteration": "eeh bidh sau poochhat teh bhe ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਪੁਛਣ ਲਗੇ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "इह बिधि सौ पूछत तिह भए ॥६॥",
      "sourceLineId": "133193",
      "sourceShabadId": "12524",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "133194",
      "sourceShabadId": "12525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕੋ ਹੈ ਰੀ ਤੂ ਰੋਤ ਕ੍ਯੋ ਕਹਾ ਲਗਿਯੋ ਦੁਖ ਤੋਹਿ ॥",
      "transliteration": "ko hai ree too rot kayo kahaa lagiyo dhukh toh ||",
      "translation": "",
      "punjabiViakhya": "ਓਏ! ਤੂੰ ਕੌਣ ਹੈਂ? ਕਿਉਾਂ ਰੋ ਰਹੀਂ ਹੈਂ? ਤੈਨੂੰ ਕੀ ਦੁਖ ਲਗਾ ਹੈ?",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "को है री तू रोत क्यो कहा लगियो दुख तोहि ॥",
      "sourceLineId": "133195",
      "sourceShabadId": "12525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮਾਰਤ ਹੌ ਨਹਿ ਠੌਰ ਤੁਹਿ ਸਾਚ ਬਤਾਵਹੁ ਮੋਹਿ ॥੭॥",
      "transliteration": "maarat hau neh Thauar tuh saach bataavahu moh ||7||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਸਚ ਦਸ, ਨਹੀਂ ਤਾ ਤੈਨੂੰ ਇਸ ਥਾ ਮਾਰਦਾ ਹਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "मारत हौ नहि ठौर तुहि साच बतावहु मोहि ॥७॥",
      "sourceLineId": "133196",
      "sourceShabadId": "12525",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133197",
      "sourceShabadId": "12526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮੁਹਿ ਅਰਬਲਾ ਨ੍ਰਿਪਤਿ ਕੀ ਜਾਨਹੁ ॥",
      "transliteration": "muh arabalaa nirapat kee jaanahu ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸਤਰੀ ਕਹਿਣ ਲਗੀ) ਤੁਸੀਂ ਮੈਨੂੰ ਰਾਜੇ ਦੀ ਉਮਰ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "मुहि अरबला नृपति की जानहु ॥",
      "sourceLineId": "133198",
      "sourceShabadId": "12526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭੂਪਤਿ ਭੋਰ ਕਾਲ ਪਹਿਚਾਨਹੁ ॥",
      "transliteration": "bhoopat bhor kaal pahichaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਲਈ ਸਵੇਰ ਕਾਲ ਸਮਾਨ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "भूपति भोर काल पहिचानहु ॥",
      "sourceLineId": "133199",
      "sourceShabadId": "12526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਾ ਤੇ ਮੈ ਰੋਵਤ ਦੁਖਿਯਾਰੀ ॥",
      "transliteration": "taa te mai rovat dhukhiyaaree ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਮੈਂ ਦੁਖਿਆਰੀ ਰੋ ਰਹੀ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "ता ते मै रोवत दुखियारी ॥",
      "sourceLineId": "133200",
      "sourceShabadId": "12526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਭੈ ਬਿਛੁਰਿ ਹੈਂ ਨਿਸੁਪਤਿ ਪ੍ਯਾਰੀ ॥੮॥",
      "transliteration": "sabhai bichhur hai(n) nisupat payaaree ||8||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਪਿਆਰੀਆਂ (ਰਾਣੀਆਂ) ਚੰਦ੍ਰਮਾ (ਵਰਗੇ ਰਾਜੇ ਤੋਂ) ਵਿਛੜ ਜਾਣਗੀਆਂ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "सभै बिछुरि हैं निसुपति प्यारी ॥८॥",
      "sourceLineId": "133201",
      "sourceShabadId": "12526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਿਹ ਬਿਧਿ ਬਚੈ ਨ੍ਰਿਪਤਿ ਕੇ ਪ੍ਰਾਨਾ ॥",
      "transliteration": "keh bidh bachai nirapat ke praanaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਤਰ੍ਰਹਾ ਰਾਜੇ ਦੇ ਪ੍ਰਾਣ ਬਚ ਜਾਣ,",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "किह बिधि बचै नृपति के प्राना ॥",
      "sourceLineId": "133202",
      "sourceShabadId": "12526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪ੍ਰਾਤ ਕੀਜਿਯੈ ਸੋਈ ਬਿਧਾਨਾ ॥",
      "transliteration": "praat keejiyai soiee bidhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੇਰੇ ਉਹੀ ਵਿਵਸਥਾ ਕੀਤੀ ਜਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "प्रात कीजियै सोई बिधाना ॥",
      "sourceLineId": "133203",
      "sourceShabadId": "12526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਹ ਤ੍ਰਿਯ ਕਹਿਯੋ ਕ੍ਰਿਯਾ ਇਕ ਕਰੈ ॥",
      "transliteration": "teh tiray kahiyo kirayaa ik karai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਨੇ ਕਿਹਾ ਕਿ ਇਕ ਕੰਮ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "तह तृय कहियो कृया इक करै ॥",
      "sourceLineId": "133204",
      "sourceShabadId": "12526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਬ ਮਰਬੇ ਤੇ ਨ੍ਰਿਪਤਿ ਉਬਰੈ ॥੯॥",
      "transliteration": "tab marabe te nirapat ubarai ||9||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜਾ ਮਰਨ ਤੋਂ ਬਚ ਸਕਦਾ ਹੈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "तब मरबे ते नृपति उबरै ॥९॥",
      "sourceLineId": "133205",
      "sourceShabadId": "12526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤ੍ਰਿਪੁਰ ਮਤੀ ਦਿਜਬਰ ਕਹ ਦੇਹੂ ॥",
      "transliteration": "tirapur matee dhijabar keh dhehoo ||",
      "translation": "",
      "punjabiViakhya": "ਤ੍ਰਿਪੁਰ ਮਤੀ ਬ੍ਰਾਮਹਣ ਨੂੰ ਦੇ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "तृपुर मती दिजबर कह देहू ॥",
      "sourceLineId": "133206",
      "sourceShabadId": "12526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਡੋਰੀ ਨਿਜੁ ਕਾਧੇ ਕਰਿ ਲੇਹੂ ॥",
      "transliteration": "ddoree nij kaadhe kar lehoo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਡੋਲੀ ਨੂੰ ਆਪਣੇ ਮੋਢੇ ਉਤੇ ਚੁਕ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "डोरी निजु काधे करि लेहू ॥",
      "sourceLineId": "133207",
      "sourceShabadId": "12526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦਰਬ ਸਹਿਤ ਤਿਹ ਗ੍ਰਿਹਿ ਪਹੁਚਾਵੈ ॥",
      "transliteration": "dharab sahit teh gireh pahuchaavai ||",
      "translation": "",
      "punjabiViakhya": "ਧਨ ਸਹਿਤ ਉਸ (ਬ੍ਰਾਹਮਣ) ਦੇ ਘਰ ਪਹੁੰਚਾ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "दरब सहित तिह गृहि पहुचावै ॥",
      "sourceLineId": "133208",
      "sourceShabadId": "12526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਬ ਨ੍ਰਿਪ ਨਿਕਟ ਕਾਲ ਨਹਿ ਆਵੈ ॥੧੦॥",
      "transliteration": "tab nirap nikaT kaal neh aavai ||10||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜੇ ਪਾਸ ਕਾਲ ਨਹੀਂ ਆਏਗਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "तब नृप निकट काल नहि आवै ॥१०॥",
      "sourceLineId": "133209",
      "sourceShabadId": "12526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1254_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਫੂਲਿ ਦੇਇ ਜੁ ਦੁਤਿਯ ਤ੍ਰਿਯ ਘਰ ਮੈ ॥",
      "transliteration": "fool dhei ju dhutiy tiray ghar mai ||",
      "translation": "",
      "punjabiViakhya": "ਫੂਲਿ ਦੇਈ ਨਾ ਦੀ ਜੋ ਦੂਜੀ ਰਾਣੀ ਘਰ ਵਿਚ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1254,
      "hindi": "",
      "hindiTransliteration": "फूलि देइ जु दुतिय तृय घर मै ॥",
      "sourceLineId": "133210",
      "sourceShabadId": "12526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
