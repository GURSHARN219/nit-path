{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1255,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1255_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਿਹ ਦੇਵੈ ਚੰਡਾਰਹਿ ਕਰ ਮੈ ॥",
      "transliteration": "teh dhevai cha(n)ddaareh kar mai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਚੰਡਾਲ ਦੇ ਹੱਥ ਵਿਚ ਦੇ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "तिह देवै चंडारहि कर मै ॥",
      "sourceLineId": "133211",
      "sourceShabadId": "12526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤ੍ਰਿਪੁਰ ਮਤੀ ਕਹ ਗ੍ਰਿਹ ਨ ਬੁਲਾਵੈ ॥",
      "transliteration": "tirapur matee keh gireh na bulaavai ||",
      "translation": "",
      "punjabiViakhya": "ਤ੍ਰਿਪੁਰ ਮਤੀ ਨੂੰ (ਫਿਰ) ਘਰ ਨਾ ਬੁਲਾਇਆ ਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "तृपुर मती कह गृह न बुलावै ॥",
      "sourceLineId": "133212",
      "sourceShabadId": "12526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਾ ਕੌ ਫੇਰਿ ਨ ਬਦਨ ਦਿਖਾਵੈ ॥੧੧॥",
      "transliteration": "taa kau fer na badhan dhikhaavai ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਾ ਹੀ ਉਹ ਫਿਰ ਮੂੰਹ ਵਿਖਾਏ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "ता कौ फेरि न बदन दिखावै ॥११॥",
      "sourceLineId": "133213",
      "sourceShabadId": "12526",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "133214",
      "sourceShabadId": "12527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪ੍ਰਾਤ ਆਇ ਅਪਨੇ ਸਦਨ ਵਹੈ ਕ੍ਰਿਯਾ ਨ੍ਰਿਪ ਕੀਨ ॥",
      "transliteration": "praat aai apane sadhan vahai kirayaa nirap keen ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੇਰ ਵੇਲੇ ਰਾਜਾ ਆਪਣੇ ਮਹੱਲ ਵਿਚ ਆਇਆ ਅਤੇ ਉਹੀ ਕ੍ਰਿਆ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "प्रात आइ अपने सदन वहै कृया नृप कीन ॥",
      "sourceLineId": "133215",
      "sourceShabadId": "12527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਇਕ ਰਾਨੀ ਦਿਜਬਰ ਦਈ ਦੁਤਿਯ ਚੰਡਾਰਹਿ ਦੀਨ ॥੧੨॥",
      "transliteration": "eik raanee dhijabar dhiee dhutiy cha(n)ddaareh dheen ||12||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਰਾਣੀ ਬ੍ਰਾਹਮਣ ਨੂੰ ਦੇ ਦਿੱਤੀ ਅਤੇ ਦੂਜੀ ਚੰਡਾਲ ਦੇ ਹਵਾਲੇ ਕਰ ਦਿੱਤੀ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "इक रानी दिजबर दई दुतिय चंडारहि दीन ॥१२॥",
      "sourceLineId": "133216",
      "sourceShabadId": "12527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਤ੍ਰਿਯਾਨ ਕੇ ਮੂਢ ਨ ਸਕਿਯੋ ਬਿਚਾਰਿ ॥",
      "transliteration": "bhedh abhedh tirayaan ke moodd na sakiyo bichaar ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ (ਰਾਜਾ) ਇਸਤਰੀ ਦੇ ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਾ ਪਛਾਣ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद तृयान के मूढ न सकियो बिचारि ॥",
      "sourceLineId": "133217",
      "sourceShabadId": "12527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦਈ ਦੋਊ ਤ੍ਰਿਯ ਪੁੰਨ੍ਯ ਕਰਿ ਜਿਯ ਕੋ ਤ੍ਰਾਸ ਨਿਵਾਰ ॥੧੩॥",
      "transliteration": "dhiee dhouoo tiray pu(n)nay kar jiy ko traas nivaar ||13||",
      "translation": "",
      "punjabiViakhya": "ਮਨ ਦਾ ਡਰ ਦੂਰ ਕਰ ਕੇ (ਉਸ ਨੇ) ਦੋਵੇਾਂ ਇਸਤਰੀਆਂ ਪੁੰਨ-ਦਾਨ ਕਰ ਦਿੱਤੀਆਂ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "दई दोऊ तृय पुँन्य करि जिय को त्रास निवार ॥१३॥",
      "sourceLineId": "133218",
      "sourceShabadId": "12527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਪਾਚ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੦੫॥੫੮੬੪॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau paach charitr samaapatam sat subham sat ||305||5864||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੦੫ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੦੫॥੫੮੬੪॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ पाच चरित्र समापतम सतु सुभम सतु ॥३०५॥५८६४॥अफजूँ॥",
      "sourceLineId": "133219",
      "sourceShabadId": "12527",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133220",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਹੜਾਇਚਿ ਕੋ ਦੇਸ ਬਸਤ ਜਹ ॥",
      "transliteration": "bahaRaich ko dhes basat jeh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਬਹੜਾਇਚ ਦੇਸ ਵਸਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "बहड़ाइचि को देस बसत जह ॥",
      "sourceLineId": "133221",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਧੁੰਧ ਪਾਲ ਨ੍ਰਿਪ ਬਸਤ ਹੋਤ ਤਹ ॥",
      "transliteration": "dhu(n)dh paal nirap basat hot teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਧੁੰਧ ਪਾਲ ਨਾ ਦਾ ਰਾਜਾ ਰਹਿੰਦਾ ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "धुँध पाल नृप बसत होत तह ॥",
      "sourceLineId": "133222",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦੁੰਦਭ ਦੇ ਤਾ ਕੇ ਘਰ ਰਾਨੀ ॥",
      "transliteration": "dhu(n)dhabh dhe taa ke ghar raanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਦੁੰਦਭ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਰਾਣੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "दुँदभ दे ता के घर रानी ॥",
      "sourceLineId": "133223",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਾ ਕੀ ਸਮ ਸੁੰਦਰ ਨ ਸਕ੍ਰਾਨੀ ॥੧॥",
      "transliteration": "jaa kee sam su(n)dhar na sakraanee ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਸੁੰਦਰ ਇੰਦਰ ਦੀ ਪਤਨੀ ਵੀ ਨਹੀਂ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "जा की सम सुँदर न सक्रानी ॥१॥",
      "sourceLineId": "133224",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਹਿਕ ਸੁਲਛਨ ਰਾਇ ਬਖਨਿਯਤ ॥",
      "transliteration": "tahik sulachhan rai bakhaniyat ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸੁਲਛਨ ਰਾਇ ਨਾ ਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "तहिक सुलछन राइ बखनियत ॥",
      "sourceLineId": "133225",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਛਤ੍ਰੀ ਕੋ ਤਿਹ ਪੂਤ ਪ੍ਰਮਨਿਯਤ ॥",
      "transliteration": "chhatree ko teh poot pramaniyat ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਸੇ) ਛਤ੍ਰੀ ਦਾ ਪੁੱਤਰ ਦਸਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "छत्री को तिह पूत प्रमनियत ॥",
      "sourceLineId": "133226",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਾ ਕੇ ਤਨ ਸੁੰਦਰਤਾ ਘਨੀ ॥",
      "transliteration": "taa ke tan su(n)dharataa ghanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਸ਼ਰੀਰ ਬਹੁਤ ਸੁੰਦਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "ता के तन सुँदरता घनी ॥",
      "sourceLineId": "133227",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮੋਰ ਬਦਨ ਤੇ ਜਾਤਿ ਨ ਭਨੀ ॥੨॥",
      "transliteration": "mor badhan te jaat na bhanee ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਵਰਣਨ ਮੇਰੇ ਮੂੰਹ ਤੋਂ ਨਹੀਂ ਹੋ ਸਕਦਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "मोर बदन ते जाति न भनी ॥२॥",
      "sourceLineId": "133228",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਾ ਸੌ ਬਧੀ ਕੁਅਰਿ ਕੀ ਪ੍ਰੀਤਾ ॥",
      "transliteration": "taa sau badhee kuar kee preetaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਕੁਮਾਰੀ (ਰਾਣੀ) ਦੀ ਪ੍ਰੀਤ ਵੱਧ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "ता सौ बधी कुअरि की प्रीता ॥",
      "sourceLineId": "133229",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੈਸੀ ਭਾਤਿ ਰਾਮ ਸੋ ਸੀਤਾ ॥",
      "transliteration": "jaisee bhaat raam so seetaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਰਾਮ ਨਾਲ ਸੀਤਾ ਦੀ (ਪ੍ਰੀਤ) ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "जैसी भाति राम सो सीता ॥",
      "sourceLineId": "133230",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰੈਨਿ ਦਿਵਸ ਤਿਹ ਬੋਲਿ ਪਠਾਵੈ ॥",
      "transliteration": "rain dhivas teh bol paThaavai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਦਿਨ ਉਸ ਨੂੰ ਬੁਲਵਾ ਲੈਂਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "रैनि दिवस तिह बोलि पठावै ॥",
      "sourceLineId": "133231",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੰਕ ਤ੍ਯਾਗ ਤ੍ਰਿਯ ਭੋਗ ਮਚਾਵੈ ॥੩॥",
      "transliteration": "sa(n)k tayaag tiray bhog machaavai ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਿਸੰਗ ਹੋ ਕੇ ਉਸ ਨਾਲ ਕਾਮ-ਕੇਲ ਕਰਦੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "संक त्याग तृय भोग मचावै ॥३॥",
      "sourceLineId": "133232",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇਕ ਦਿਨ ਖਬਰਿ ਨ੍ਰਿਪਤਿ ਕਹ ਭਈ ॥",
      "transliteration": "eik dhin khabar nirapat keh bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਰਾਜੇ ਨੂੰ ਖ਼ਬਰ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "इक दिन खबरि नृपति कह भई ॥",
      "sourceLineId": "133233",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭੇਦੀ ਕਿਨਹਿ ਬ੍ਰਿਥਾ ਕਹਿ ਦਈ ॥",
      "transliteration": "bhedhee kineh birathaa keh dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਭੇਦੀ ਨੇ ਸਾਰੀ ਬਿਰਥਾ ਦਸ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "भेदी किनहि बृथा कहि दई ॥",
      "sourceLineId": "133234",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਧਿਕ ਕੋਪ ਕਰਿ ਗਯੋ ਨ੍ਰਿਪਤਿ ਤਹ ॥",
      "transliteration": "adhik kop kar gayo nirapat teh ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਕ੍ਰੋਧ ਕਰ ਕੇ ਰਾਜਾ ਉਥੇ ਚਲਾ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "अधिक कोप करि गयो नृपति तह ॥",
      "sourceLineId": "133235",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭੋਗਤ ਹੁਤੀ ਜਾਰ ਕਹ ਤ੍ਰਿਯ ਜਹ ॥੪॥",
      "transliteration": "bhogat hutee jaar keh tiray jeh ||4||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਯਾਰ ਨਾਲ ਰਾਣੀ ਭੋਗ ਕਰ ਰਹੀ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "भोगत हुती जार कह तृय जह ॥४॥",
      "sourceLineId": "133236",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰਾਨੀ ਭੇਦ ਪਾਇ ਅਸ ਕੀਯਾ ॥",
      "transliteration": "raanee bhedh pai as keeyaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਪਤਾ ਲਗਣ ਤੇ ਇਸ ਤਰ੍ਰਹਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "रानी भेद पाइ अस कीया ॥",
      "sourceLineId": "133237",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਾਧਿ ਔਧ ਸਿਹਜਾ ਤਰ ਲੀਯਾ ॥",
      "transliteration": "baadh aauadh sihajaa tar leeyaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਯਾਰ ਨੂੰ) ਪਲੰਘ ('ਸਿਹਜਾ') ਹੇਠਾ ਪੁਠਾ ਬੰਨ੍ਰਹ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "बाधि औध सिहजा तर लीया ॥",
      "sourceLineId": "133238",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਰਾਵ ਸਹਿਤ ਊਪਰਹਿ ਬਹਿਠੀ ॥",
      "transliteration": "raav sahit uoopareh bahiThee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਸਹਿਤ (ਉਹ ਪਲੰਘ) ਉਪਰ ਬੈਠ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "राव सहित ऊपरहि बहिठी ॥",
      "sourceLineId": "133239",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਹੋਇ ਇਕਠੀ ॥੫॥",
      "transliteration": "bhaat bhaat tan hoi ikaThee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦੀਆਂ ਗਲਵਕੜੀਆਂ ਪਾਣ ਲਗੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन होइ इकठी ॥५॥",
      "sourceLineId": "133240",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਤਿ ਮਾਨੀ ਨ੍ਰਿਪ ਸਾਥ ਬਨਾਈ ॥",
      "transliteration": "rat maanee nirap saath banaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਰਾਜੇ ਨਾਲ ਚੰਗੀ ਤਰ੍ਰਹਾ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "रति मानी नृप साथ बनाई ॥",
      "sourceLineId": "133241",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮੂਰਖ ਕੰਤ ਬਾਤ ਨਹਿ ਪਾਈ ॥",
      "transliteration": "moorakh ka(n)t baat neh paiee ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਪਤੀ ਗੱਲ ਨੂੰ ਸਮਝ ਨਾ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "मूरख कंत बात नहि पाई ॥",
      "sourceLineId": "133242",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਰੀਝਿ ਰਹਾ ਅਬਲਾ ਕਹ ਭਜਿ ਕੈ ॥",
      "transliteration": "reejh rahaa abalaa keh bhaj kai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਰਾਣੀ ਨਾਲ ਭਿੰਨ ਭਿੰਨ ਪ੍ਰਕਾਰ ਦੇ ਆਸਣ ਸਜਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "रीझि रहा अबला कह भजि कै ॥",
      "sourceLineId": "133243",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਆਸਨ ਸਜਿ ਕੈ ॥੬॥",
      "transliteration": "bhaat bhaat ke aasan saj kai ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੰਭੋਗ ਕਰ ਕੇ ਪ੍ਰਸੰਨ ਹੋ ਗਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के आसन सजि कै ॥६॥",
      "sourceLineId": "133244",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭੋਗ ਕਮਾਤ ਅਧਿਕ ਥਕਿ ਗਯੋ ॥",
      "transliteration": "bhog kamaat adhik thak gayo ||",
      "translation": "",
      "punjabiViakhya": "ਭੋਗ ਕਰ ਕੇ (ਜਦ) ਬਹੁਤ ਥਕ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "भोग कमात अधिक थकि गयो ॥",
      "sourceLineId": "133245",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੋਵਤ ਸੇਜ ਤਿਸੀ ਪਰ ਭਯੋ ॥",
      "transliteration": "sovat sej tisee par bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸੇ ਸੇਜ ਉਤੇ ਸੌਂ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "सोवत सेज तिसी पर भयो ॥",
      "sourceLineId": "133246",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜੌ ਨ੍ਰਿਚੇਸਟ ਤ੍ਰਿਯ ਪਿਯ ਲਖਿ ਪਾਯੋ ॥",
      "transliteration": "jau nirachesaT tiray piy lakh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਣੀ ਨੇ ਰਾਜੇ ਨੂੰ ਬੇਸੁਧ (ਜਾ ਅਹਿਲ) ਵੇਖ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "जौ नृचेसट तृय पिय लखि पायो ॥",
      "sourceLineId": "133247",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਾਰਿ ਕਾਢਿ ਕਰਿ ਧਾਮ ਪਠਾਯੋ ॥੭॥",
      "transliteration": "jaar kaadd kar dhaam paThaayo ||7||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਯਾਰ ਨੂੰ ਕਢ ਕੇ ਘਰ ਭੇਜ ਦਿੱਤਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "जारि काढि करि धाम पठायो ॥७॥",
      "sourceLineId": "133248",
      "sourceShabadId": "12528",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "133249",
      "sourceShabadId": "12529",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਾਗਿ ਖੋਜਿ ਨ੍ਰਿਪ ਘਰ ਥਕਾ ਜਾਰ ਨ ਲਹਿਯੋ ਨਿਕਾਰਿ ॥",
      "transliteration": "jaag khoj nirap ghar thakaa jaar na lahiyo nikaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਾਗ ਕੇ ਰਾਜਾ ਘਰ ਵਿਚ ਲਭ ਲਭ ਕੇ ਥਕ ਗਿਆ, ਪਰ ਯਾਰ ਨੂੰ (ਕਿਤੋਂ) ਕਢ ਨਾ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "जागि खोजि नृप घर थका जार न लहियो निकारि ॥",
      "sourceLineId": "133250",
      "sourceShabadId": "12529",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭੇਦ ਦਿਯੋ ਜਿਹ ਜਾਨ ਤਿਹ ਝੂਠੋ ਹਨ੍ਯੋ ਗਵਾਰ ॥੮॥",
      "transliteration": "bhedh dhiyo jeh jaan teh jhooTho hanayo gavaar ||8||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਭੇਦ ਦਿੱਤਾ ਸੀ, ਉਸ ਨੂੰ ਝੂਠਾ ਜਾਣ ਕੇ ਮੂਰਖ ਰਾਜੇ ਨੇ ਮਾਰ ਦਿੱਤਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "भेद दियो जिह जान तिह झूठो हन्यो गवार ॥८॥",
      "sourceLineId": "133251",
      "sourceShabadId": "12529",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਛੇ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੦੬॥੫੮੭੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau chhe charitr samaapatam sat subham sat ||306||5872||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੦੬ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੦੬॥੫੮੭੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ छे चरित्र समापतम सतु सुभम सतु ॥३०६॥५८७२॥अफजूँ॥",
      "sourceLineId": "133252",
      "sourceShabadId": "12529",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133253",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਭੈਰੋ ਪਾਲ ਸੁਨਾ ਇਕ ਰਾਜਾ ॥",
      "transliteration": "bhairo paal sunaa ik raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਭੈਰੋ ਪਾਲ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੁਣੀਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "भैरो पाल सुना इक राजा ॥",
      "sourceLineId": "133254",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰਾਜ ਪਾਟ ਤਾ ਹੀ ਕਹ ਛਾਜਾ ॥",
      "transliteration": "raaj paaT taa hee keh chhaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਨੂੰ ਹੀ ਰਾਜ-ਪਾਟ ਸਜਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "राज पाट ता ही कह छाजा ॥",
      "sourceLineId": "133255",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚਪਲਾ ਵਤੀ ਸੁਨੀ ਤਿਹ ਤ੍ਰਿਯ ਬਰ ॥",
      "transliteration": "chapalaa vatee sunee teh tiray bar ||",
      "translation": "",
      "punjabiViakhya": "ਚਪਲਾ ਵਤੀ ਨਾ ਦੀ ਉਸ ਦੀ ਇਸਤਰੀ ਸੁਣੀਂਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "चपला वती सुनी तिह तृय बर ॥",
      "sourceLineId": "133256",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1255_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹੁਤੀ ਪੰਡਿਤਾ ਸਕਲ ਹੁਨਰ ਕਰਿ ॥੧॥",
      "transliteration": "hutee pa(n)dditaa sakal hunar kar ||1||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸਾਰਿਆਂ ਹੁਨਰਾ ਵਿਚ ਨਿਪੁਣ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1255,
      "hindi": "",
      "hindiTransliteration": "हुती पंडिता सकल हुनर करि ॥१॥",
