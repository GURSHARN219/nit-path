{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1256,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1256_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੇਗ ਤੇਗ ਕੋ ਜਾਹਿ ਭਰੋਸਾ ॥",
      "transliteration": "dheg teg ko jaeh bharosaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਦੇਗ ਅਤੇ ਤੇਗ ਦਾ (ਬਹੁਤ) ਭਰੋਸਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "देग तेग को जाहि भरोसा ॥",
      "sourceLineId": "133259",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੁਘਨਾ ਵਤੀ ਸੁਤਾ ਇਕ ਤਾ ਕੀ ॥",
      "transliteration": "sughanaa vatee sutaa ik taa kee ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਘਨਾ ਵਤੀ ਨਾ ਦੀ ਉਸ ਦੀ ਇਕ ਪੁੱਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "सुघना वती सुता इक ता की ॥",
      "sourceLineId": "133260",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰੋਸਨ ਭਯੋ ਜੋਤਿ ਸਸਿ ਵਾ ਕੀ ॥੨॥",
      "transliteration": "rosan bhayo jot sas vaa kee ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਜੋਤਿ ਨਾਲ ਹੀ ਚੰਦ੍ਰਮਾ ਰੋਸ਼ਨ ਹੁੰਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "रोसन भयो जोति ससि वा की ॥२॥",
      "sourceLineId": "133261",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਕ ਦਿਨ ਨਿਕਸਾ ਨ੍ਰਿਪਤਿ ਸਿਕਾਰਾ ॥",
      "transliteration": "eik dhin nikasaa nirapat sikaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਰਾਜਾ ਸ਼ਿਕਾਰ ਖੇਡਣ ਨੂੰ ਨਿਕਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "इक दिन निकसा नृपति सिकारा ॥",
      "sourceLineId": "133262",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਲਏ ਸ੍ਵਾਨ ਸੀਚਾਨ ਹਜਾਰਾ ॥",
      "transliteration": "le savaiaan seechaan hajaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਆਪਣੇ ਨਾਲ) ਹਜ਼ਾਰਾ ਕੁੱਤੇ, ਬਾਜ਼,",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "लए स्वान सीचान हजारा ॥",
      "sourceLineId": "133263",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚੀਤਾ ਔਰ ਜਾਰਿਯਨ ਲੀਨੇ ॥",
      "transliteration": "cheetaa aauar jaariyan leene ||",
      "translation": "",
      "punjabiViakhya": "ਚਿਤਰੇ, ਜਾਰਿਯ (ਮਸ਼ਾਲਚੀ) ਲੈ ਲਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "चीता और जारियन लीने ॥",
      "sourceLineId": "133264",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸ੍ਰਯਾਹ ਗੋਸ ਨਹਿ ਜਾਹਿ ਸੁ ਚੀਨੇ ॥੩॥",
      "transliteration": "srayaeh gos neh jaeh su cheene ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਿਆਹ ਗੋਸ਼ ਜਿਨ੍ਰਹਾ ਦੀ ਗਿਣਤੀ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕਦੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "स्रयाह गोस नहि जाहि सु चीने ॥३॥",
      "sourceLineId": "133265",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਲਗਰ ਝਗਰ ਜੁਰਰਾ ਅਰੁ ਬਾਜਾ ॥",
      "transliteration": "lagar jhagar juraraa ar baajaa ||",
      "translation": "",
      "punjabiViakhya": "ਲਗਰ, ਝਗਰ, ਜੁਰਰਾ, ਬਾਜ਼,",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "लगर झगर जुररा अरु बाजा ॥",
      "sourceLineId": "133266",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਹਰੀ ਕੁਹੀ ਸਿਚਾਨ ਸਮਾਜਾ ॥",
      "transliteration": "baharee kuhee sichaan samaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਹਿਰੀ, ਕੂਹੀ ਆਦਿ ਸ਼ਿਕਾਰੀ ਪੰਛੀ (ਨਾਲ ਲੈ ਲਏ)।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "बहरी कुही सिचान समाजा ॥",
      "sourceLineId": "133267",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਾਸੇ ਔਰ ਬਸੀਨੈ ਘਨੀ ॥",
      "transliteration": "baase aauar baseenai ghanee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਨ੍ਰਹਾ ਤੋਂ ਇਲਾਵਾ) ਬਹੁਤ ਸਾਰੇ ਬਾਸ਼ੇ, ਬਸੀਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "बासे और बसीनै घनी ॥",
      "sourceLineId": "133268",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚਿਪਕ ਧੂਤਿਯੈ ਜਾਹਿ ਨ ਗਨੀ ॥੪॥",
      "transliteration": "chipak dhootiyai jaeh na ganee ||4||",
      "translation": "",
      "punjabiViakhya": "ਚਿਪਕ, ਧੂਤੀਏ ਆਦਿ ਵੀ ਲੈ ਲਏ ਜਿਨ੍ਰਹਾ ਦੀ ਗਿਣਤੀ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕਦੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "चिपक धूतियै जाहि न गनी ॥४॥",
      "sourceLineId": "133269",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਖੇਲ ਸਿਕਾਰਾ ॥",
      "transliteration": "bhaat bhaat tan khel sikaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਭਾਤ ਭਾਤ ਦਾ ਸ਼ਿਕਾਰ ਖੇਡਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन खेल सिकारा ॥",
      "sourceLineId": "133270",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਧਿਕ ਮ੍ਰਿਗਨ ਕਹ ਖੇਦਿ ਪਛਾਰਾ ॥",
      "transliteration": "adhik miragan keh khedh pachhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਸਾਰੇ ਹਿਰਨਾ ਨੂੰ ਖਦੇੜ ਕੇ ਪਛਾੜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "अधिक मृगन कह खेदि पछारा ॥",
      "sourceLineId": "133271",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਬ ਲਗਿ ਦ੍ਰਿਸਟਿ ਬਰਾਹਿਕ ਆਯੋ ॥",
      "transliteration": "tab lag dhirasaT baraahik aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਦੀ ਨਜ਼ਰ ਵਿਚ ਇਕ ਸੂਰ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "तब लगि दृसटि बराहिक आयो ॥",
      "sourceLineId": "133272",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਿਹ ਪਾਛੇ ਤਿਹ ਤੁਰੰਗ ਧਵਾਯੋ ॥੫॥",
      "transliteration": "teh paachhe teh tura(n)g dhavaayo ||5||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਿਛੇ ਉਸ ਨੇ ਘੋੜਾ ਭਜਾ ਦਿੱਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "तिह पाछे तिह तुरंग धवायो ॥५॥",
      "sourceLineId": "133273",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਾਤ ਭਯੋ ਤਾਹੀ ਕੇ ਦੇਸਾ ॥",
      "transliteration": "jaat bhayo taahee ke dhesaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਹਵਾ ਦੀ ਤੇਜ਼ੀ ਨਾਲ ਘੋੜੇ ਨੂੰ ਭਜਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "जात भयो ताही के देसा ॥",
      "sourceLineId": "133274",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਾਕਿ ਤੁਰੰਗ ਪਵਨ ਕੇ ਭੇਸਾ ॥",
      "transliteration": "haak tura(n)g pavan ke bhesaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ (ਸੁਘਨਾ ਵਤੀ) ਦੇ ਦੇਸ਼ ਜਾ ਪਹੁੰਚਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "हाकि तुरंग पवन के भेसा ॥",
      "sourceLineId": "133275",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੁਘਨਾ ਵਤੀ ਲਖਾ ਜਬ ਤਾ ਕੌ ॥",
      "transliteration": "sughanaa vatee lakhaa jab taa kau ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜਦ ਸੁਘਨਾ ਵਤੀ ਨੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "सुघना वती लखा जब ता कौ ॥",
      "sourceLineId": "133276",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਲਯੋ ਬੁਲਾਇ ਤਹੀ ਤੇ ਵਾ ਕੌ ॥੬॥",
      "transliteration": "layo bulai tahee te vaa kau ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਥੋਂ ਹੀ (ਉਸ ਨੇ) ਉਸ ਰਾਜੇ ਨੂੰ ਬੁਲਾ ਲਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "लयो बुलाइ तही ते वा कौ ॥६॥",
      "sourceLineId": "133277",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਧੌਲਰ ਤਰ ਕਮੰਦ ਲਰਕਾਈ ॥",
      "transliteration": "dhaualar tar kama(n)dh larakaiee ||",
      "translation": "",
      "punjabiViakhya": "ਮਹੱਲ ਦੇ ਹੇਠਾ ਕਮੰਦ ਲਟਕਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "धौलर तर कमंद लरकाई ॥",
      "sourceLineId": "133278",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਲਯੋ ਤਿਸੌ ਤਿਹ ਪੈਡ ਚੜਾਈ ॥",
      "transliteration": "layo tisau teh paidd chaRaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਰਸਤੇ ਰਾਹੀਂ ਉਸ ਨੂੰ (ਉਪਰ) ਚੜ੍ਰਹਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "लयो तिसौ तिह पैड चड़ाई ॥",
      "sourceLineId": "133279",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਅਤਿ ਰੁਚ ਕਰਿ ਮਾਨਾ ॥",
      "transliteration": "kaam bhog at ruch kar maanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਰੁਚੀ ਪੂਰਵਕ ਕਾਮ ਭੋਗ ਕੀਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "काम भोग अति रुच करि माना ॥",
      "sourceLineId": "133280",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭੇਦ ਦੂਸਰੇ ਮਨੁਖ ਨ ਜਾਨਾ ॥੭॥",
      "transliteration": "bhedh dhoosare manukh na jaanaa ||7||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਦਾ) ਭੇਦ ਕਿਸੇ ਦੂਜੇ ਮਨੁੱਖ ਨੇ ਨਾ ਜਾਣਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "भेद दूसरे मनुख न जाना ॥७॥",
      "sourceLineId": "133281",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਬ ਤਿਹ ਪਿਤ ਯੌ ਹ੍ਰਿਦੈ ਬਿਚਾਰਾ ॥",
      "transliteration": "tab teh pit yau hiradhai bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਦੇ ਪਿਤਾ ਨੇ ਹਿਰਦੇ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਵਿਚਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "तब तिह पित यौ हृदै बिचारा ॥",
      "sourceLineId": "133282",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਿਜੁ ਰਾਨੀ ਕੇ ਸਾਥ ਉਚਾਰਾ ॥",
      "transliteration": "nij raanee ke saath uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੀ ਰਾਣੀ ਨੂੰ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "निजु रानी के साथ उचारा ॥",
      "sourceLineId": "133283",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹਮ ਤੁਮ ਆਉ ਸੁਤਾ ਕੇ ਜਾਹੀ ॥",
      "transliteration": "ham tum aau sutaa ke jaahee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੂੰ ਤੇ ਮੈਂ (ਦੋਵੇਾਂ) ਪੁੱਤਰੀ ਦੇ ਘਰ ਜਾਈਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "हम तुम आउ सुता के जाही ॥",
      "sourceLineId": "133284",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੁਹਿਤਾ ਹੋਇ ਖੁਸੀ ਮਨ ਮਾਹੀ ॥੮॥",
      "transliteration": "dhuhitaa hoi khusee man maahee ||8||",
      "translation": "",
      "punjabiViakhya": "ਪੁੱਤਰੀ (ਸਾਨੂੰ ਆਇਆ ਵੇਖ ਕੇ) ਮਨ ਵਿਚ ਬਹੁਤ ਖ਼ੁਸ਼ ਹੋਏਗੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "दुहिता होइ खुसी मन माही ॥८॥",
      "sourceLineId": "133285",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਬ ਵੈ ਦੋਊ ਸੁਤਾ ਕੇ ਗਏ ॥",
      "transliteration": "tab vai dhouoo sutaa ke ge ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਹ ਦੋਵੇਾਂ ਪੁੱਤਰੀ ਦੇ (ਘਰ) ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "तब वै दोऊ सुता के गए ॥",
      "sourceLineId": "133286",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਾ ਕੇ ਪ੍ਰਾਪਤਿ ਦ੍ਵਾਰ ਪਰ ਭਏ ॥",
      "transliteration": "taa ke praapat dhavaiaar par bhe ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੇ ਦਰਵਾਜ਼ੇ ਉਤੇ ਜਾ ਪਹੁੰਚੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "ता के प्रापति द्वार पर भए ॥",
      "sourceLineId": "133287",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੁਘਨਾ ਵਤੀ ਤਿਹ ਲਖਿ ਦੁਖ ਪਾਯੋ ॥",
      "transliteration": "sughanaa vatee teh lakh dhukh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਵੇਖ ਕੇ ਸੁਘਨਾ ਵਤੀ ਬਹੁਤ ਦੁਖੀ ਹੋਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "सुघना वती तिह लखि दुख पायो ॥",
      "sourceLineId": "133288",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਧਿਕ ਅਸਰਫੀ ਕਾਢਿ ਮੰਗਾਯੋ ॥੯॥",
      "transliteration": "adhik asarafee kaadd ma(n)gaayo ||9||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ ਉਸ ਨੇ) ਬਹੁਤ ਸਾਰੀਆਂ ਅਸ਼ਰਫ਼ੀਆਂ ਕਢ ਕੇ ਮੰਗਵਾਈਆਂ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "अधिक असरफी काढि मंगायो ॥९॥",
      "sourceLineId": "133289",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਔਰ ਅਧਿਕ ਤਿਨ ਅਤਿਥ ਬੁਲਾਏ ॥",
      "transliteration": "aauar adhik tin atith bulaae ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਬਹੁਤ ਸਾਰੇ ਸਾਧ ਬੁਲਵਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "और अधिक तिन अतिथ बुलाए ॥",
      "sourceLineId": "133290",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਏਕ ਏਕ ਦੈ ਮੁਹਰ ਪਠਾਏ ॥",
      "transliteration": "ek ek dhai muhar paThaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਇਕ ਮੋਹਰ ਦੇ ਕੇ ਤੋਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "एक एक दै मुहर पठाए ॥",
      "sourceLineId": "133291",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਿਨ ਕੇ ਮਾਹਿ ਨ੍ਰਿਪਤਿ ਕਰ ਮੰਗਨਾ ॥",
      "transliteration": "tin ke maeh nirapat kar ma(n)ganaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਵਿਚ ਹੀ ਰਾਜੇ ਨੂੰ ਵੀ ਮੰਗਤਾ ਬਣਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "तिन के माहि नृपति कर मंगना ॥",
      "sourceLineId": "133292",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੈ ਸਤ ਮੁਹਰ ਨਿਕਾਰਿਯੋ ਅੰਗਨਾ ॥੧੦॥",
      "transliteration": "dhai sat muhar nikaariyo a(n)ganaa ||10||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸੱਤ (ਅਰਥਾਤਰ-ਸੌ) ਮੁਹਰਾ ਦੇ ਕੇ ਵੇਹੜੇ ਵਿਚੋਂ ਕਢ ਦਿੱਤਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "दै सत मुहर निकारियो अंगना ॥१०॥",
      "sourceLineId": "133293",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮੁਰ ਪਰਵਾਰ ਲਖ੍ਯੋ ਇਨ ਰਾਜਾ ॥",
      "transliteration": "mur paravaar lakhayo in raajaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ ਪਿਤਾ) ਰਾਜੇ ਨੇ ਸਮਝਿਆ ਕਿ ਇਹ ਮੇਰੇ ਪਰਿਵਾਰ ਦੀ ਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "मुर परवार लख्यो इन राजा ॥",
      "sourceLineId": "133294",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਏਤੋ ਦਯੋ ਦਰਬ ਬਿਨੁ ਕਾਜਾ ॥",
      "transliteration": "eto dhayo dharab bin kaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਨਾ ਕਿਸੇ ਕੰਮ ਦੇ ਹੀ (ਇਸ ਨੇ) ਇਤਨਾ ਧਨ ਦਾਨ ਕਰ ਦਿੱਤਾ ਹੈ (ਭਾਵ-ਮੇਰੇ ਸਿਰ ਤੋਂ ਆਉਣ ਦੀ ਖ਼ੁਸ਼ੀ ਵਿਚ ਵਾਰ ਦਿੱਤਾ ਹੈ)।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "एतो दयो दरब बिनु काजा ॥",
      "sourceLineId": "133295",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਾ ਤੇ ਦੁਗੁਨ ਤਵਨ ਕਹ ਦਯੋ ॥",
      "transliteration": "taa te dhugun tavan keh dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਉਸ ਨੂੰ ਦੁਗਣਾ (ਧਨ) ਦੇ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "ता ते दुगुन तवन कह दयो ॥",
      "sourceLineId": "133296",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਜਾਨਤ ਭਯੋ ॥੧੧॥",
      "transliteration": "bhedh abhedh na jaanat bhayo ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੇਦ ਅਭੇਦ ਨੂੰ ਕੁਝ ਨਾ ਸਮਝ ਸਕਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न जानत भयो ॥११॥",
      "sourceLineId": "133297",
      "sourceShabadId": "12530",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "133298",
      "sourceShabadId": "12531",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਪਿਯ ਮਿਤ੍ਰ ਕੌ ਇਹ ਛਲ ਅਤਿਥ ਬਨਾਇ ॥",
      "transliteration": "raaj sutaa piy mitr kau ieh chhal atith banai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ (ਆਪਣੇ) ਪਿਆਰੇ ਮਿਤਰ ਨੂੰ ਛਲ ਨਾਲ ਸਾਧ ਬਣਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "राज सुता पिय मित्र कौ इह छल अतिथ बनाइ ॥",
      "sourceLineId": "133299",
      "sourceShabadId": "12531",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੈ ਅਸਰਫੀ ਨਿਕਾਰਿਯੋ ਭੇਦ ਨ ਜਾਨਾ ਰਾਇ ॥੧੨॥",
      "transliteration": "dhai asarafee nikaariyo bhedh na jaanaa rai ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਅਸ਼ਰਫ਼ੀ ਦੇ ਕੇ ਕਢ ਦਿੱਤਾ। ਰਾਜਾ ਇਹ ਭੇਦ ਨਾ ਸਮਝ ਸਕਿਆ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "दै असरफी निकारियो भेद न जाना राइ ॥१२॥",
      "sourceLineId": "133300",
      "sourceShabadId": "12531",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮਨ ਮਾਨਤ ਕੋ ਭੋਗ ਕਰਿ ਪਿਤ ਅਰੁ ਮਾਤ ਦਿਖਾਇ ॥",
      "transliteration": "man maanat ko bhog kar pit ar maat dhikhai ||",
      "translation": "",
      "punjabiViakhya": "ਮਨ ਭਾਉਾਂਦਾ ਭੋਗ ਕਰ ਕੇ ਮਾਤਾ ਪਿਤਾ ਨੂੰ (ਯਾਰ) ਵਿਖਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "मन मानत को भोग करि पित अरु मात दिखाइ ॥",
      "sourceLineId": "133301",
      "sourceShabadId": "12531",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇਹ ਛਲ ਸੌ ਕਾਢਾ ਤਿਸੈ ਕਿਨਹੂੰ ਨ ਗਹਿਯੋ ਬਨਾਇ ॥੧੩॥",
      "transliteration": "eeh chhal sau kaaddaa tisai kinahoo(n) na gahiyo banai ||13||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਇਹ ਛਲ ਕਰ ਕੇ ਕਢ ਦਿੱਤਾ (ਪਰ ਉਸ ਨੂੰ) ਕੋਈ ਵੀ ਫੜ ਨਾ ਸਕਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "इह छल सौ काढा तिसै किनहूँ न गहियो बनाइ ॥१३॥",
      "sourceLineId": "133302",
      "sourceShabadId": "12531",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸਾਤ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੦੭॥੫੮੮੫॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau saat charitr samaapatam sat subham sat ||307||5885||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੦੭ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੦੭॥੫੮੮੫॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ सात चरित्र समापतम सतु सुभम सतु ॥३०७॥५८८५॥अफजूँ॥",
      "sourceLineId": "133303",
      "sourceShabadId": "12531",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133304",
      "sourceShabadId": "12532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕੋਚ ਬਿਹਾਰ ਸਹਿਰ ਜਹ ਬਸੈ ॥",
      "transliteration": "koch bihaar sahir jeh basai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕੋਚ (ਕੂਚ) ਬਿਹਾਰ ਸ਼ਹਿਰ ਵਸਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "कोच बिहार सहिर जह बसै ॥",
      "sourceLineId": "133305",
      "sourceShabadId": "12532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਮਰਾਵਤੀ ਪੁਰੀ ਕਹ ਹਸੈ ॥",
      "transliteration": "amaraavatee puree keh hasai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਅਮਰਾਵਤੀ (ਇੰਦਰ) ਪੁਰੀ ਨੂੰ (ਵੇਖ ਕੇ) ਹਸਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "अमरावती पुरी कह हसै ॥",
      "sourceLineId": "133306",
      "sourceShabadId": "12532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਬ੍ਰਿਧ ਕੇਤੁ ਤਿਹ ਭੂਪ ਭਨਿਜੈ ॥",
      "transliteration": "biradh ket teh bhoop bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਿਧ ਕੇਤੁ ਉਥੋਂ ਦਾ ਰਾਜਾ ਦਸਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "बृध केतु तिह भूप भनिजै ॥",
      "sourceLineId": "133307",
      "sourceShabadId": "12532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕੋ ਰਾਜਾ ਪਟਤਰ ਤਿਹ ਦਿਜੈ ॥੧॥",
      "transliteration": "ko raajaa paTatar teh dhijai ||1||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸ ਰਾਜੇ ਨਾਲ ਉਸ ਦੀ ਤੁਲਨਾ ਕਰੀਏ (ਅਰਥਾਤ-ਉਸ ਦੇ ਸਮਾਨ ਹੋਰ ਕੋਈ ਰਾਜਾ ਨਹੀਂ ਸੀ) ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "को राजा पटतर तिह दिजै ॥१॥",
      "sourceLineId": "133308",
      "sourceShabadId": "12532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸ੍ਰੀ ਫੁਟ ਬੇਸਰਿ ਦੇ ਤਹ ਦਾਰਾ ॥",
      "transliteration": "sree fuT besar dhe teh dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪਤਨੀ ਦਾ ਨਾ ਸ੍ਰੀ ਫੁਟ ਬੇਸਰਿ ਦੇ (ਦੇਈ) ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "स्री फुट बेसरि दे तह दारा ॥",
      "sourceLineId": "133309",
      "sourceShabadId": "12532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਿਹ ਸਮ ਦੇਵ ਨ ਦੇਵ ਕੁਮਾਰਾ ॥",
      "transliteration": "jeh sam dhev na dhev kumaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਦੇਵਇਸ ਤਰੀ ਜਾ ਦੇਵ ਕੁਮਾਰੀ (ਕੋਈ ਵੀ) ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "जिह सम देव न देव कुमारा ॥",
      "sourceLineId": "133310",
      "sourceShabadId": "12532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਤਾ ਕੋ ਜਾਤ ਨ ਰੂਪ ਉਚਾਰਾ ॥",
      "transliteration": "taa ko jaat na roop uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਰੂਪ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "ता को जात न रूप उचारा ॥",
      "sourceLineId": "133311",
      "sourceShabadId": "12532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਦਿਵਸ ਭਯੋ ਤਾ ਤੇ ਉਜਿਯਾਰਾ ॥੨॥",
      "transliteration": "dhivas bhayo taa te ujiyaaraa ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਦਿਨ ਵੀ ਪ੍ਰਕਾਸ਼ ਪ੍ਰਾਪਤ ਕਰਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "दिवस भयो ता ते उजियारा ॥२॥",
      "sourceLineId": "133312",
      "sourceShabadId": "12532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਹਾਜੀ ਰਾਇ ਤਹਾ ਖਤਿਰੇਟਾ ॥",
      "transliteration": "haajee rai tahaa khatireTaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਹਾਜੀ ਰਾਇ ਨਾ ਦਾ ਖਤਰੇਟਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "हाजी राइ तहा खतिरेटा ॥",
      "sourceLineId": "133313",
      "sourceShabadId": "12532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਇਸਕ ਮੁਸਕ ਕੇ ਸਾਥ ਲਪੇਟਾ ॥",
      "transliteration": "eisak musak ke saath lapeTaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਸ਼ਕ ਮੁਸ਼ਕ ਵਿਚ ਪੂਰੀ ਤਰ੍ਰਹਾ ਲਿਪਤ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "इसक मुसक के साथ लपेटा ॥",
      "sourceLineId": "133314",
      "sourceShabadId": "12532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਤਾ ਕੀ ਜਾਤ ਨ ਪ੍ਰਭਾ ਉਚਾਰੀ ॥",
      "transliteration": "taa kee jaat na prabhaa uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪ੍ਰਭਾ ਦਾ ਬਖਾਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "ता की जात न प्रभा उचारी ॥",
      "sourceLineId": "133315",
      "sourceShabadId": "12532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਫੂਲਿ ਰਹੀ ਜਾਨੁਕ ਫੁਲਵਾਰੀ ॥੩॥",
      "transliteration": "fool rahee jaanuk fulavaaree ||3||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਫੁਲਵਾੜੀ ਖਿੜੀ ਹੋਵੇ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "फूलि रही जानुक फुलवारी ॥३॥",
      "sourceLineId": "133316",
      "sourceShabadId": "12532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਸ੍ਰੀ ਫੁਟ ਬੇਸਰਿ ਦੇ ਤਿਹ ਲਹਾ ॥",
      "transliteration": "sree fuT besar dhe teh lahaa ||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰੀ ਫੁਟ ਬੇਸਰਿ ਦੇਈ ਨੇ ਉਸ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "स्री फुट बेसरि दे तिह लहा ॥",
      "sourceLineId": "133317",
      "sourceShabadId": "12532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਚਿਤ ਅਪਨੇ ਮਹਿ ਕਹਾ ॥",
      "transliteration": "eeh bidh chit apane meh kahaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਚਿਤ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "इह बिधि चित अपने महि कहा ॥",
      "sourceLineId": "133318",
      "sourceShabadId": "12532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਕੈ ਅਬ ਮਰੌ ਕਟਾਰੀ ਹਨਿ ਕੈ ॥",
      "transliteration": "kai ab marau kaTaaree han kai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਤਾ ਮੈਂ ਹੁਣ ਕਟਾਰ ਮਾਰ ਕੇ ਮਰ ਜਾਵਾਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "कै अब मरौ कटारी हनि कै ॥",
      "sourceLineId": "133319",
      "sourceShabadId": "12532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਕੈ ਇਹ ਭਜੌ ਆਜੁ ਬਨਿ ਠਨਿ ਕੈ ॥੪॥",
      "transliteration": "kai ieh bhajau aaj ban Than kai ||4||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਅਜ ਬਣ ਠਣ ਕੇ ਇਸ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਾਗੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "कै इह भजौ आजु बनि ठनि कै ॥४॥",
      "sourceLineId": "133320",
      "sourceShabadId": "12532",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "133321",
      "sourceShabadId": "12533",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਮਸਿ ਭੀਜਤ ਤਿਹ ਬਦਨ ਪਰ ਅਤਿ ਸੁੰਦਰ ਸਰਬੰਗ ॥",
      "transliteration": "mas bheejat teh badhan par at su(n)dhar saraba(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਮੂੰਹ ('ਬਦਨ') ਤੇ ਮੁੱਛਾ ਫੁਟ ਰਹੀਆਂ ਸਨ ਅਤੇ ਉਸ ਦਾ ਸਾਰਾ ਸ਼ਰੀਰ ਸੁੰਦਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "मसि भीजत तिह बदन पर अति सुँदर सरबंग ॥",
      "sourceLineId": "133322",
      "sourceShabadId": "12533",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਕਨਕ ਅਵਟਿ ਸਾਚੇ ਢਰਿਯੋ ਲੂਟੀ ਪ੍ਰਭਾ ਅਨੰਗ ॥੫॥",
      "transliteration": "kanak avaT saache ddariyo looTee prabhaa ana(n)g ||5||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ ਮਾਨੋ) ਸੋਨਾ ਪੰਘਾਰ ਕੇ (ਉਸ ਨੂੰ) ਸੰਚੇ ਵਿਚ ਢਾਲਿਆ ਗਿਆ ਹੋਵੇ ਅਤੇ ਕਾਮ ਦੇਵ ਦੀ ਸੁੰਦਰਤਾ ਲੁਟੀ ਹੋਈ ਹੋਵੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "कनक अवटि साचे ढरियो लूटी प्रभा अनंग ॥५॥",
      "sourceLineId": "133323",
      "sourceShabadId": "12533",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133324",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਸੁਘਰਿ ਸਹਚਰੀ ਤਹਾ ਪਠਾਈ ॥",
      "transliteration": "sughar sahacharee tahaa paThaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ) ਇਕ ਸਿਆਣੀ ਸਖੀ ਉਥੇ (ਉਸ ਪਾਸ) ਭੇਜੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "सुघरि सहचरी तहा पठाई ॥",
      "sourceLineId": "133325",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਛਲ ਸੌ ਤਾਹਿ ਤਹਾ ਲੈ ਆਈ ॥",
      "transliteration": "chhal sau taeh tahaa lai aaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਛਲ ਨਾਲ ਉਸ ਨੂੰ ਉਥੇ ਲੈ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "छल सौ ताहि तहा लै आई ॥",
      "sourceLineId": "133326",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਜਬ ਤਿਹ ਹਾਥ ਚਲਾਯੋ ਰਾਨੀ ॥",
      "transliteration": "jab teh haath chalaayo raanee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਣੀ ਨੇ ਉਸ ਵਲ ਹੱਥ ਵਧਾਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "जब तिह हाथ चलायो रानी ॥",
      "sourceLineId": "133327",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਹਾਜੀ ਰਾਇ ਬਾਤ ਨਹਿ ਮਾਨੀ ॥੬॥",
      "transliteration": "haajee rai baat neh maanee ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਹਾਜੀ ਰਾਇ ਨੇ (ਉਸ ਦੀ) ਗੱਲ ਨਹੀਂ ਮੰਨੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "हाजी राइ बात नहि मानी ॥६॥",
      "sourceLineId": "133328",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਅਬਲਾ ਕੋਟਿ ਜਤਨ ਕਰਿ ਹਾਰੀ ॥",
      "transliteration": "abalaa koT jatan kar haaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਬਲਾ ਬੇਸ਼ੁਮਾਰ ਯਤਨ ਕਰ ਕੇ ਹਾਰ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": "अबला कोटि जतन करि हारी ॥",
      "sourceLineId": "133329",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1256_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਕ੍ਯੋਹੂੰ ਨ ਭਜੀ ਤਾਹਿ ਨ੍ਰਿਪ ਨਾਰੀ ॥",
      "transliteration": "kayohoo(n) na bhajee taeh nirap naaree ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਕਿਵੇਾਂ ਵੀ ਉਸ ਨੇ ਰਾਣੀ ਨਾਲ ਰਮਣ ਨਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
