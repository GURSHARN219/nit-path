{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1257,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1257_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਾਇ ਹਾਇ ਗਿਰਿ ਭੂਮ ਉਚਾਰਾ ॥",
      "transliteration": "hai hai gir bhoom uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ ਸਫਲ ਨਾ ਹੁੰਦੇ ਵੇਖ ਕੇ ਇਕ ਚਰਿਤ੍ਰ ਕੀਤਾ)। ਧਰਤੀ ਉਤੇ ਡਿਗ ਕੇ 'ਹਾਇ ਹਾਇ' ਕਰਨ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "हाइ हाइ गिरि भूम उचारा ॥",
      "sourceLineId": "133331",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮੁਰ ਕਰੇਜ ਡਾਇਨੀ ਨਿਹਾਰਾ ॥੭॥",
      "transliteration": "mur karej ddainee nihaaraa ||7||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿਣ ਲਗੀ ਕਿ) ਮੇਰਾ ਕਲੇਜਾ (ਇਸ) ਡਾਇਣ ਨੇ ਵੇਖਿਆ (ਅਰਥਾਤ ਕਢਿਆ) ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "मुर करेज डाइनी निहारा ॥७॥",
      "sourceLineId": "133332",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਿਹ ਤ੍ਰਿਯ ਬਸਤ੍ਰ ਹੁਤੇ ਪਹਿਰਾਏ ॥",
      "transliteration": "teh tiray basatr hute pahiraae ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ (ਰਾਣੀ ਨੇ) ਇਸਤਰੀ ਦੇ ਬਸਤ੍ਰ ਪਵਾਏ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "तिह तृय बसत्र हुते पहिराए ॥",
      "sourceLineId": "133333",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਡਾਇਨ ਸੁਨਤ ਲੋਗ ਉਠਿ ਧਾਏ ॥",
      "transliteration": "ddain sunat log uTh dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਡਾਇਣ (ਦਾ ਨਾ) ਸੁਣ ਕੇ ਸਭ ਲੋਗ ਉਠ ਕੇ ਆ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "डाइन सुनत लोग उठि धाए ॥",
      "sourceLineId": "133334",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਬ ਗਹਿ ਤਾਹਿ ਬਹੁਤ ਬਿਧਿ ਮਾਰਾ ॥",
      "transliteration": "jab geh taeh bahut bidh maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਨੂੰ ਪਕੜ ਕੇ ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਮਾਰਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "जब गहि ताहि बहुत बिधि मारा ॥",
      "sourceLineId": "133335",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਬ ਤਿਨ ਮਨਾ ਜੁ ਤ੍ਰਿਯਾ ਉਚਾਰਾ ॥੮॥",
      "transliteration": "tab tin manaa ju tirayaa uchaaraa ||8||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੇ ਮੰਨਿਆ ਜੋ ਰਾਣੀ ਨੇ ਕਿਹਾ ਸੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "तब तिन मना जु तृया उचारा ॥८॥",
      "sourceLineId": "133336",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਬ ਲਗਿ ਤਹਾ ਨ੍ਰਿਪਤਿ ਹੂੰ ਆਯੋ ॥",
      "transliteration": "tab lag tahaa nirapat hoo(n) aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਰਾਜਾ ਉਥੇ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "तब लगि तहा नृपति हूँ आयो ॥",
      "sourceLineId": "133337",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੁਨਿ ਕਰੇਜ ਤ੍ਰਿਯ ਹਰਿਯੋ ਰਿਸਾਯੋ ॥",
      "transliteration": "sun karej tiray hariyo risaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਕਲੇਜਾ ਚੁਰਾ ਲਿਆ, ਇਹ ਸੁਣ ਕੇ ਕ੍ਰੋਧਿਤ ਹੋਇਆ ਅਤੇ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "सुनि करेज तृय हरियो रिसायो ॥",
      "sourceLineId": "133338",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਇਹ ਡਾਇਨਿ ਕਹ ਕਹਾ ਸੰਘਾਰੋ ॥",
      "transliteration": "eeh ddain keh kahaa sa(n)ghaaro ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਡਾਇਣ ਨੂੰ ਮਾਰ ਦਿਓ,",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "इह डाइनि कह कहा संघारो ॥",
      "sourceLineId": "133339",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕੈ ਅਬ ਹੀ ਰਾਨੀਯਹਿ ਜਿਯਾਰੋ ॥੯॥",
      "transliteration": "kai ab hee raaneeyeh jiyaaro ||9||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਇਹ ਹੁਣੇ ਰਾਣੀ ਨੂੰ ਜੀਵਿਤ ਕਰ ਦੇਏ (ਭਾਵ-ਕਲੇਜਾ ਵਾਪਸ ਕਰ ਦੇਏ) ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "कै अब ही रानीयहि जियारो ॥९॥",
      "sourceLineId": "133340",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਬ ਤਿਨ ਦੂਰਿ ਠਾਢ ਨ੍ਰਿਪ ਕੀਏ ॥",
      "transliteration": "tab tin dhoor Thaadd nirap ke'ee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ (ਹਾਜੀ ਰਾਇ) ਨੇ ਰਾਜੇ ਨੂੰ ਦੂਰ ਖੜਾ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "तब तिन दूरि ठाढ नृप कीए ॥",
      "sourceLineId": "133341",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਾਨੀ ਕੇ ਚੁੰਬਨ ਤਿਨ ਲੀਏ ॥",
      "transliteration": "raanee ke chu(n)ban tin le'ee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੇ ਰਾਣੀ ਦੇ ਚੁੰਬਨ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "रानी के चुँबन तिन लीए ॥",
      "sourceLineId": "133342",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਾਜਾ ਲਖੈ ਕਰੇਜੋ ਡਾਰੈ ॥",
      "transliteration": "raajaa lakhai karejo ddaarai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਕ੍ਰਿਆ ਨੂੰ) ਰਾਜਾ ਸਮਝ ਰਿਹਾ ਸੀ ਕਿ (ਰਾਣੀ ਦੇ ਅੰਦਰ) ਕਲੇਜਾ ਪਾ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "राजा लखै करेजो डारै ॥",
      "sourceLineId": "133343",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨਹਿ ਮੂੜ ਬਿਚਾਰੈ ॥੧੦॥",
      "transliteration": "bhedh abhedh neh mooR bichaarai ||10||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮੂਰਖ ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਹੀਂ ਸਮਝ ਰਿਹਾ ਸੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद नहि मूड़ बिचारै ॥१०॥",
      "sourceLineId": "133344",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਭ ਤਬ ਹੀ ਲੋਗਾਨ ਹਟਾਯੋ ॥",
      "transliteration": "sabh tab hee logaan haTaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਉਸ ਨੇ) ਸਾਰਿਆਂ ਲੋਕਾ ਨੂੰ ਹਟਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "सभ तब ही लोगान हटायो ॥",
      "sourceLineId": "133345",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਧਿਕ ਨਾਰਿ ਸੌ ਭੋਗ ਮਚਾਯੋ ॥",
      "transliteration": "adhik naar sau bhog machaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਨਾਲ ਬਹੁਤ ਭੋਗ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "अधिक नारि सौ भोग मचायो ॥",
      "sourceLineId": "133346",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਾਖੈ ਜੋ ਮੁਰਿ ਕਹਿ ਪ੍ਰਿਯ ਪ੍ਰਾਨਾ ॥",
      "transliteration": "raakhai jo mur keh piray praanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ ਕਹਿਣ ਲਗੀ) ਹੇ ਪ੍ਰਿਯ! ਤੂੰ ਜੋ ਮੇਰੇ ਪ੍ਰਾਣਾ ਦੀ ਰਖਿਆ ਕੀਤੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "राखै जो मुरि कहि पृय प्राना ॥",
      "sourceLineId": "133347",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤੁਮ ਸੌ ਰਮੌ ਸਦਾ ਬਿਧਿ ਨਾਨਾ ॥੧੧॥",
      "transliteration": "tum sau ramau sadhaa bidh naanaa ||11||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਲਈ) ਮੈਂ ਸਦਾ ਤੇਰੇ ਨਾਲ ਭਿੰਨ ਭਿੰਨ ਢੰਗ ਨਾਲ ਰਮਣ (ਕਰਦੀ ਰਹਾਗੀ) ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "तुम सौ रमौ सदा बिधि नाना ॥११॥",
      "sourceLineId": "133348",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਧਿਕ ਭੋਗ ਤਾ ਸੌ ਤ੍ਰਿਯ ਕਰਿ ਕੈ ॥",
      "transliteration": "adhik bhog taa sau tiray kar kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਬਹੁਤ ਭੋਗ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "अधिक भोग ता सौ तृय करि कै ॥",
      "sourceLineId": "133349",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਧਾਇ ਭੇਸ ਦੈ ਦਯੋ ਨਿਕਰਿ ਕੈ ॥",
      "transliteration": "dhai bhes dhai dhayo nikar kai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਉਸ ਨੂੰ ਦਾਈ ਦਾ ਭੇਸ ਕਰਾ ਕੇ ਕਢ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "धाइ भेस दै दयो निकरि कै ॥",
      "sourceLineId": "133350",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭਾਖਤ ਜਾਇ ਪਤਿਹਿ ਅਸ ਭਈ ॥",
      "transliteration": "bhaakhat jai pateh as bhiee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ) ਪਤੀ ਪਾਸ ਜਾ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿਣ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "भाखत जाइ पतिहि अस भई ॥",
      "sourceLineId": "133351",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦੇਇ ਕਰਿਜਵਾ ਡਾਇਨਿ ਗਈ ॥੧੨॥",
      "transliteration": "dhei karijavaa ddain giee ||12||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮੈਨੂੰ ਡਾਇਣ ਕਲੇਜਾ ਦੇ ਗਈ ਹੈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "देइ करिजवा डाइनि गई ॥१२॥",
      "sourceLineId": "133352",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦਿਤ ਮੁਹਿ ਪ੍ਰਥਮ ਕਰਿਜਵਾ ਭਈ ॥",
      "transliteration": "dhit muh pratham karijavaa bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਮੈਨੂੰ ਪਹਿਲਾ ਕਲੇਜਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "दित मुहि प्रथम करिजवा भई ॥",
      "sourceLineId": "133353",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪੁਨਿ ਵਹ ਅੰਤ੍ਰਧ੍ਯਾਨ ਹ੍ਵੈ ਗਈ ॥",
      "transliteration": "pun veh a(n)tradhayaan havai giee ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਉਹ ਅੰਤਰ ਧਿਆਨ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "पुनि वह अंत्रध्यान ह्वै गई ॥",
      "sourceLineId": "133354",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨ੍ਰਿਪ ਬਰ ਦ੍ਰਿਸਟਿ ਨ ਹਮਰੀ ਆਈ ॥",
      "transliteration": "nirap bar dhirasaT na hamaree aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸ੍ਰੇਸ਼ਠ ਰਾਜੇ! (ਫਿਰ) ਉਹ ਮੇਰੀ ਨਜ਼ਰ ਨਹੀਂ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "नृप बर दृसटि न हमरी आई ॥",
      "sourceLineId": "133355",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕ੍ਯਾ ਜਨਿਯੈ ਕਿਹ ਦੇਸ ਸਿਧਾਈ ॥੧੩॥",
      "transliteration": "kayaa janiyai keh dhes sidhaiee ||13||",
      "translation": "",
      "punjabiViakhya": "ਕੀ ਪਤਾ, ਕਿਹੜੇ ਦੇਸ਼ ਵਲ ਚਲੀ ਗਈ ਹੈ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "क्या जनियै किह देस सिधाई ॥१३॥",
      "sourceLineId": "133356",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਤਿ ਸਤਿ ਤਬ ਨ੍ਰਿਪਤਿ ਉਚਾਰਾ ॥",
      "transliteration": "sat sat tab nirapat uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਤਦ 'ਸਤਿ ਸਤਿ' ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "सति सति तब नृपति उचारा ॥",
      "sourceLineId": "133357",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਮੂੜ ਬਿਚਾਰਾ ॥",
      "transliteration": "bhedh abhedh na mooR bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਮੂਰਖ ਨੇ ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਾ ਪਛਾਣਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न मूड़ बिचारा ॥",
      "sourceLineId": "133358",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਿਰਖਤ ਥੋ ਤ੍ਰਿਯ ਜਾਰ ਬਜਾਈ ॥",
      "transliteration": "nirakhat tho tiray jaar bajaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਸਭ ਦੇ) ਦੇਖਦੇ ਹੋਇਆਂ, ਯਾਰ ਨੇ ਇਸਤਰੀ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "निरखत थो तृय जार बजाई ॥",
      "sourceLineId": "133359",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਗਯੋ ਆਂਖਿ ਚੁਰਾਈ ॥੧੪॥",
      "transliteration": "eeh charitr gayo aa(n)kh churaiee ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਹ ਚਰਿਤ੍ਰ ਕਰ ਕੇ ਅੱਖ ਬਚਾ ਕੇ ਨਿਕਲ ਗਿਆ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र गयो आँखि चुराई ॥१४॥",
      "sourceLineId": "133360",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪ੍ਰਥਮ ਮਿਤ੍ਰ ਤ੍ਰਿਯ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "transliteration": "pratham mitr tiray bol paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਇਸਤਰੀ ਨੇ ਮਿਤਰ ਨੂੰ ਬੁਲਵਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "प्रथम मित्र तृय बोलि पठायो ॥",
      "sourceLineId": "133361",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਹਿਯੋ ਨ ਕਿਯ ਤ੍ਰਿਯ ਤ੍ਰਾਸ ਦਿਖਾਯੋ ॥",
      "transliteration": "kahiyo na kiy tiray traas dhikhaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਉਸ ਨੇ ਕਿਹਾ ਨਾ ਮੰਨਿਆ (ਤਦ) ਇਸਤਰੀ ਨੇ (ਉਸ ਨੂੰ) ਡਰਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "कहियो न किय तृय त्रास दिखायो ॥",
      "sourceLineId": "133362",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਹੁਰਿ ਭਜਾ ਇਹ ਚਰਿਤ ਲਖਾਯਾ ॥",
      "transliteration": "bahur bhajaa ieh charit lakhaayaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਚਰਿਤ੍ਰ ਵਿਖਾ ਕੇ ਕਾਮ-ਕੇਲ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "बहुरि भजा इह चरित लखाया ॥",
      "sourceLineId": "133363",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਠਾਢ ਨ੍ਰਿਪਤਿ ਜੜ ਮੂੰਡ ਮੁੰਡਾਯਾ ॥੧੫॥",
      "transliteration": "Thaadd nirapat jaR moo(n)dd mu(n)ddaayaa ||15||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਖੜੇ ਖੜੋਤੇ ਆਪਣਾ ਸਿਰ ਮੁੰਨਵਾਇਆ (ਭਾਵ-ਖੜੇ ਖੜੋਤੇ ਠਗਿਆ ਗਿਆ) ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "ठाढ नृपति जड़ मूँड मुँडाया ॥१५॥",
      "sourceLineId": "133364",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਆਠ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੦੮॥੫੯੦੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau aaTh charitr samaapatam sat subham sat ||308||5900||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੦੮ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੦੮॥੫੯੦੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ आठ चरित्र समापतम सतु सुभम सतु ॥३०८॥५९००॥अफजूँ॥",
      "sourceLineId": "133365",
      "sourceShabadId": "12534",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133366",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਰਨਾਟਕ ਕੋ ਦੇਸ ਬਸਤ ਜਹ ॥",
      "transliteration": "karanaaTak ko dhes basat jeh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਰਨਾਟਕ ਦਾ ਦੇਸ ਵਸਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "करनाटक को देस बसत जह ॥",
      "sourceLineId": "133367",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸ੍ਰੀ ਕਰਨਾਟਕ ਸੈਨ ਨ੍ਰਿਪਤਿ ਤਹ ॥",
      "transliteration": "sree karanaaTak sain nirapat teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਕਰਨਾਟਕ ਸੈਨਾ ਨਾ ਦਾ ਰਾਜਾ (ਰਾਜ ਕਰਦਾ) ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "स्री करनाटक सैन नृपति तह ॥",
      "sourceLineId": "133368",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਰਨਾਟਕ ਦੇਈ ਗ੍ਰਿਹ ਨਾਰੀ ॥",
      "transliteration": "karanaaTak dheiee gireh naaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਘਰ ਕਰਨਾਟਕ ਦੇਈ ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "करनाटक देई गृह नारी ॥",
      "sourceLineId": "133369",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਾ ਤੇ ਲਿਯ ਰਵਿ ਸਸਿ ਉਜਿਯਾਰੀ ॥੧॥",
      "transliteration": "jaa te liy rav sas ujiyaaree ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤੋਂ ਸੂਰਜ ਅਤੇ ਚੰਦ੍ਰਮਾ ਪ੍ਰਕਾਸ਼ ਲੈਂਦੇ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "जा ते लिय रवि ससि उजियारी ॥१॥",
      "sourceLineId": "133370",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਹ ਇਕ ਸਾਹ ਬਸਤ ਥੋ ਨੀਕੋ ॥",
      "transliteration": "teh ik saeh basat tho neeko ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸੁੰਦਰ ਸ਼ਾਹ ਵਸਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "तह इक साह बसत थो नीको ॥",
      "sourceLineId": "133371",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਾਹਿ ਨਿਰਖਿ ਸੁਖ ਉਪਜਤ ਜੀ ਕੋ ॥",
      "transliteration": "jaeh nirakh sukh upajat jee ko ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਮਨ ਪ੍ਰਸੰਨ ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "जाहि निरखि सुख उपजत जी को ॥",
      "sourceLineId": "133372",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਾ ਕੇ ਸੁਤਾ ਹੁਤੀ ਇਕ ਧਾਮਾ ॥",
      "transliteration": "taa ke sutaa hutee ik dhaamaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਇਕ ਬੇਟੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "ता के सुता हुती इक धामा ॥",
      "sourceLineId": "133373",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਥਕਿਤ ਰਹਤ ਨਿਰਖਤ ਜਿਹ ਬਾਮਾ ॥੨॥",
      "transliteration": "thakit rahat nirakhat jeh baamaa ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖਦਿਆਂ ਇਸਤਰੀਆਂ ਥਕ ਜਾਦੀਆਂ ਸਨ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "थकित रहत निरखत जिह बामा ॥२॥",
      "sourceLineId": "133374",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੁਤਾ ਅਪੂਰਬ ਦੇ ਤਿਹ ਨਾਮਾ ॥",
      "transliteration": "sutaa apoorab dhe teh naamaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪੁੱਤਰੀ ਦਾ ਨਾ ਅਪੂਰਬ ਦੇ (ਦੇਈ) ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "सुता अपूरब दे तिह नामा ॥",
      "sourceLineId": "133375",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਿਹ ਸੀ ਕਹੂੰ ਕੋਊ ਨਹਿ ਬਾਮਾ ॥",
      "transliteration": "jeh see kahoo(n) kouoo neh baamaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ ਕੋਈ ਇਸਤਰੀ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "जिह सी कहूँ कोऊ नहि बामा ॥",
      "sourceLineId": "133376",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਏਕ ਸਾਹ ਕੇ ਸੁਤ ਕਹ ਬ੍ਯਾਹੀ ॥",
      "transliteration": "ek saeh ke sut keh bayaahee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਕ ਸ਼ਾਹ ਦੇ ਪੁੱਤਰ ਨੂੰ ਵਿਆਹੀ ਹੋਈ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1257,
      "hindi": "",
      "hindiTransliteration": "एक साह के सुत कह ब्याही ॥",
      "sourceLineId": "133377",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1257_line_0048",
      "lineIndex": 48,
