{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1258,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1258_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਬ ਵਹੁ ਬ੍ਯਾਹਿ ਤਾਹਿ ਲੈ ਗਯੋ ॥",
      "transliteration": "jab vahu bayaeh taeh lai gayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਉਸ ਨੂੰ ਵਿਆਹ ਕੇ ਲੈ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "जब वहु ब्याहि ताहि लै गयो ॥",
      "sourceLineId": "133379",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਿਜੁ ਸਦਨਨ ਲੈ ਪ੍ਰਾਪਤਿ ਭਯੋ ॥",
      "transliteration": "nij sadhanan lai praapat bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲੈ ਕੇ ਆਪਣੇ ਘਰ ਪਹੁੰਚ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "निजु सदनन लै प्रापति भयो ॥",
      "sourceLineId": "133380",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਏਕ ਪੁਰਖ ਤਿਨ ਨਾਰਿ ਨਿਹਾਰਾ ॥",
      "transliteration": "ek purakh tin naar nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ) ਉਸ ਇਸਤਰੀ ਨੇ ਇਕ ਪੁਰਸ਼ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "एक पुरख तिन नारि निहारा ॥",
      "sourceLineId": "133381",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਾ ਕੀ ਸਮ ਨਹਿ ਰਾਜ ਕੁਮਾਰਾ ॥੪॥",
      "transliteration": "jaa kee sam neh raaj kumaaraa ||4||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਕੋਈ ਰਾਜ ਕੁਮਾਰ ਵੀ ਨਹੀਂ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "जा की सम नहि राज कुमारा ॥४॥",
      "sourceLineId": "133382",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਿਰਖਤ ਤਾਹਿ ਲਗਨ ਤਿਹ ਲਗੀ ॥",
      "transliteration": "nirakhat taeh lagan teh lagee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਉਸ ਦੀ ਲਗਨ ਲਗ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "निरखत ताहि लगन तिह लगी ॥",
      "sourceLineId": "133383",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨੀਦ ਭੂਖਿ ਤਬ ਹੀ ਤੇ ਭਗੀ ॥",
      "transliteration": "needh bhookh tab hee te bhagee ||",
      "translation": "",
      "punjabiViakhya": "ਨੀਂਦਰ ਭੁਖ ਉਸੇ ਵੇਲੇ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "नीद भूखि तब ही ते भगी ॥",
      "sourceLineId": "133384",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪਠੈ ਸਹਚਰੀ ਤਾਹਿ ਬੁਲਾਵੈ ॥",
      "transliteration": "paThai sahacharee taeh bulaavai ||",
      "translation": "",
      "punjabiViakhya": "ਸਖੀ ਭੇਜ ਕੇ ਉਸ ਨੂੰ ਬੁਲਵਾਉਾਂਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "पठै सहचरी ताहि बुलावै ॥",
      "sourceLineId": "133385",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਰੁਚਿ ਮਾਨ ਕਮਾਵੈ ॥੫॥",
      "transliteration": "kaam bhog ruch maan kamaavai ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਰੁਚੀ ਪੂਰਵਕ ਰਤੀ-ਕ੍ਰੀੜਾ ਕਰਦੀ ਸੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "काम भोग रुचि मान कमावै ॥५॥",
      "sourceLineId": "133386",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੰਗ ਤਾ ਕੇ ਬਹੁ ਬਧਾ ਸਨੇਹਾ ॥",
      "transliteration": "sa(n)g taa ke bahu badhaa sanehaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਉਸ ਦਾ ਸਨੇਹ ਬਹੁਤ ਵੱਧ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "संग ता के बहु बधा सनेहा ॥",
      "sourceLineId": "133387",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰਾਝਨ ਔਰ ਹੀਰ ਕੋ ਜੇਹਾ ॥",
      "transliteration": "raajhan aauar heer ko jehaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਪ੍ਰਕਾਰ ਹੀਰ ਅਤੇ ਰਾਝੇ ਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "राझन और हीर को जेहा ॥",
      "sourceLineId": "133388",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬੀਰਜ ਕੇਤ ਕਹ ਯਾਦਿ ਨ ਲ੍ਯਾਵੈ ॥",
      "transliteration": "beeraj ket keh yaadh na layaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਆਪਣੇ ਪਤੀ) ਧੀਰਜ ਕੇਤੁ ਨੂੰ ਯਾਦ ਵੀ ਨਹੀਂ ਕਰਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "बीरज केत कह यादि न ल्यावै ॥",
      "sourceLineId": "133389",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਧਰਮ ਭ੍ਰਾਤ ਕਹਿ ਤਾਹਿ ਬੁਲਾਵੈ ॥੬॥",
      "transliteration": "dharam bhraat keh taeh bulaavai ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ (ਦੂਜੇ ਪੁਰਸ਼) ਨੂੰ ਧਰਮ ਦਾ ਭਰਾ ਕਹਿ ਕੇ ਬੁਲਾਉਾਂਦੀ ਸੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "धरम भ्रात कहि ताहि बुलावै ॥६॥",
      "sourceLineId": "133390",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭੇਦ ਸਸੁਰ ਕੇ ਲੋਗ ਨ ਜਾਨੈ ॥",
      "transliteration": "bhedh sasur ke log na jaanai ||",
      "translation": "",
      "punjabiViakhya": "ਸੌਹਰੇ ਘਰ ਦੇ ਲੋਗ ਭੇਦ ਨੂੰ ਨਹੀਂ ਸਮਝਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "भेद ससुर के लोग न जानै ॥",
      "sourceLineId": "133391",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਧਰਮ ਭ੍ਰਾਤ ਤਿਹ ਤ੍ਰਿਯ ਪਹਿਚਾਨੈ ॥",
      "transliteration": "dharam bhraat teh tiray pahichaanai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਨੂੰ) ਉਸ ਇਸਤਰੀ ਦਾ ਧਰਮ-ਭਰਾ ਸਮਝਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "धरम भ्रात तिह तृय पहिचानै ॥",
      "sourceLineId": "133392",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਮੂਰਖ ਲਹਹੀ ॥",
      "transliteration": "bhedh abhedh na moorakh lahahee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਮੂਰਖ ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਹੀਂ ਸਮਝਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न मूरख लहही ॥",
      "sourceLineId": "133393",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭ੍ਰਾਤਾ ਜਾਨ ਕਛੂ ਨਹਿ ਕਹਹੀ ॥੭॥",
      "transliteration": "bhraataa jaan kachhoo neh kahahee ||7||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਭਰਾ ਸਮਝ ਕੇ ਕੁਝ ਨਹੀਂ ਕਹਿੰਦੇ ਸਨ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "भ्राता जान कछू नहि कहही ॥७॥",
      "sourceLineId": "133394",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਇਕ ਦਿਨ ਤ੍ਰਿਯ ਇਹ ਭਾਤਿ ਉਚਾਰਾ ॥",
      "transliteration": "eik dhin tiray ieh bhaat uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਇਸਤਰੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "इक दिन तृय इह भाति उचारा ॥",
      "sourceLineId": "133395",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਿਜੁ ਪਤਿ ਕੌ ਦੈ ਕੈ ਬਿਖੁ ਮਾਰਾ ॥",
      "transliteration": "nij pat kau dhai kai bikh maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਪਤੀ ਨੂੰ ਜ਼ਹਿਰ ਦੇ ਕੇ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "निजु पति कौ दै कै बिखु मारा ॥",
      "sourceLineId": "133396",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਸੌ ਰੋਦਨ ਕਰੈ ॥",
      "transliteration": "bhaat bhaat sau rodhan karai ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦਾ ਰੋਣਾ ਪਿਟਣਾ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "भाति भाति सौ रोदन करै ॥",
      "sourceLineId": "133397",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਲੋਗ ਲਖਤ ਸਿਰ ਕੇਸ ਉਪਰੈ ॥੮॥",
      "transliteration": "log lakhat sir kes uparai ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲੋਕਾ ਦੇ ਵੇਖਦਿਆਂ ਸਿਰ ਦੇ ਵਾਲਾ ਨੂੰ ਪੁਟਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "लोग लखत सिर केस उपरै ॥८॥",
      "sourceLineId": "133398",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਬ ਮੈ ਧਾਮ ਕਵਨ ਕੇ ਰਹੋ ॥",
      "transliteration": "ab mai dhaam kavan ke raho ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗੀ) ਹੁਣ ਮੈਂ ਕਿਸ ਦੇ ਘਰ ਰਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "अब मै धाम कवन के रहो ॥",
      "sourceLineId": "133399",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮੈ ਪਿਯ ਸਬਦ ਕਵਨ ਸੌ ਕਹੋ ॥",
      "transliteration": "mai piy sabadh kavan sau kaho ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ 'ਪ੍ਰਿਯ' ਸ਼ਬਦ ਕਿਸ ਨੂੰ ਸੰਬੋਧਨ ਕਰਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "मै पिय सबद कवन सौ कहो ॥",
      "sourceLineId": "133400",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨ੍ਯਾਇ ਨਹੀ ਹਰਿ ਕੇ ਘਰਿ ਭੀਤਰਿ ॥",
      "transliteration": "nayai nahee har ke ghar bheetar ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਮਾਤਮਾ ਦੇ ਘਰ ਨਿਆਂ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "न्याइ नही हरि के घरि भीतरि ॥",
      "sourceLineId": "133401",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਇਹ ਗਤਿ ਕਰੀ ਮੋਰਿ ਅਵਨੀ ਤਰ ॥੯॥",
      "transliteration": "eeh gat karee mor avanee tar ||9||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਧਰਤੀ ਉਤੇ ਮੇਰੀ ਇਹ ਹਾਲਤ ਕਰ ਦਿੱਤੀ ਹੈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "इह गति करी मोरि अवनी तर ॥९॥",
      "sourceLineId": "133402",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗ੍ਰਿਹ ਕੋ ਦਰਬ ਸੰਗ ਕਰਿ ਲੀਨਾ ॥",
      "transliteration": "gireh ko dharab sa(n)g kar leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਘਰ ਦਾ ਸਾਰਾ ਧਨ ਨਾਲ ਲੈ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "गृह को दरब संग करि लीना ॥",
      "sourceLineId": "133403",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਿਤ੍ਰਹਿ ਸੰਗ ਪਯਾਨਾ ਕੀਨਾ ॥",
      "transliteration": "mitreh sa(n)g payaanaa keenaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਿਤਰ ਨਾਲ ਪ੍ਰਸਥਾਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "मित्रहि संग पयाना कीना ॥",
      "sourceLineId": "133404",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਧਰਮ ਭਾਇ ਜਾ ਕੌ ਕਰਿ ਭਾਖਾ ॥",
      "transliteration": "dharam bhai jaa kau kar bhaakhaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਧਰਮ-ਭਰਾ ਕਿਹਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "धरम भाइ जा कौ करि भाखा ॥",
      "sourceLineId": "133405",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਹ ਛਲ ਨਾਥ ਧਾਮ ਕਰਿ ਰਾਖਾ ॥੧੦॥",
      "transliteration": "eeh chhal naath dhaam kar raakhaa ||10||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਇਸ ਛਲ ਨਾਲ ਘਰ ਵਿਚ ਸੁਆਮੀ ਬਣਾ ਕੇ ਰਖ ਲਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "इह छल नाथ धाम करि राखा ॥१०॥",
      "sourceLineId": "133406",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਲੋਗ ਸਭੈ ਇਹ ਭਾਤਿ ਉਚਾਰਾ ॥",
      "transliteration": "log sabhai ieh bhaat uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਲੋਗ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿੰਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "लोग सभै इह भाति उचारा ॥",
      "sourceLineId": "133407",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਆਪੁ ਬਿਖੈ ਮਿਲਿ ਕਰਤ ਬਿਚਾਰਾ ॥",
      "transliteration": "aap bikhai mil karat bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਸ ਵਿਚ ਮਿਲ ਕੇ ਵਿਚਾਰ ਕਰਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "आपु बिखै मिलि करत बिचारा ॥",
      "sourceLineId": "133408",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਹਾ ਕਰੈ ਇਹ ਨਾਰਿ ਬਿਚਾਰੀ ॥",
      "transliteration": "kahaa karai ieh naar bichaaree ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਇਸਤਰੀ ਵਿਚਾਰੀ ਕੀ ਕਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "कहा करै इह नारि बिचारी ॥",
      "sourceLineId": "133409",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਾ ਕੀ ਦੈਵ ਐਸ ਗਤਿ ਧਾਰੀ ॥੧੧॥",
      "transliteration": "jaa kee dhaiv aais gat dhaaree ||11||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਪਰਮਾਤਮਾ ਨੇ ਅਜਿਹੀ ਹਾਲਤ ਕਰ ਦਿੱਤੀ ਹੈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "जा की दैव ऐस गति धारी ॥११॥",
      "sourceLineId": "133410",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਾ ਤੇ ਲੈ ਸਭ ਹੀ ਧਨ ਧਾਮਾ ॥",
      "transliteration": "taa te lai sabh hee dhan dhaamaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਘਰ ਦਾ ਸਾਰਾ ਧਨ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "ता ते लै सभ ही धन धामा ॥",
      "sourceLineId": "133411",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਪੁਨੇ ਗਈ ਭਾਇ ਕੇ ਬਾਮਾ ॥",
      "transliteration": "apune giee bhai ke baamaa ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਭਰਾ ਦੀ ਇਸਤਰੀ ਕੋਲ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "अपुने गई भाइ के बामा ॥",
      "sourceLineId": "133412",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਸਕਤ ਬਿਚਰਿ ਕੈ ॥",
      "transliteration": "bhedh abhedh na sakat bichar kai ||",
      "translation": "",
      "punjabiViakhya": "(ਕੋਈ ਵੀ) ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਾ ਸਮਝ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न सकत बिचरि कै ॥",
      "sourceLineId": "133413",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗਈ ਜਾਰ ਕੇ ਨਾਥ ਸੰਘਰਿ ਕੈ ॥੧੨॥",
      "transliteration": "giee jaar ke naath sa(n)ghar kai ||12||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਇਸਤਰੀ) ਸੁਆਮੀ ਨੂੰ ਮਾਰ ਕੇ ਯਾਰ ਨਾਲ ਚਲੀ ਗਈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "गई जार के नाथ संघरि कै ॥१२॥",
      "sourceLineId": "133414",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਨੌ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੦੯॥੫੯੧੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau nau charitr samaapatam sat subham sat ||309||5912||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੦੯ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੦੯॥੫੯੧੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ नौ चरित्र समापतम सतु सुभम सतु ॥३०९॥५९१२॥अफजूँ॥",
      "sourceLineId": "133415",
      "sourceShabadId": "12535",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133416",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪੁਨਿ ਮੰਤ੍ਰੀ ਇਹ ਭਾਤਿ ਉਚਾਰਾ ॥",
      "transliteration": "pun ma(n)tree ieh bhaat uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਮੰਤ੍ਰੀ ਨੇ ਫਿਰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "पुनि मंत्री इह भाति उचारा ॥",
      "sourceLineId": "133417",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੁਨਹੁ ਨ੍ਰਿਪਤਿ ਜੂ ਬਚਨ ਹਮਾਰਾ ॥",
      "transliteration": "sunahu nirapat joo bachan hamaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਤੁਸੀਂ ਮੇਰਾ (ਅਗਲਾ) ਬਚਨ ਸੁਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "सुनहु नृपति जू बचन हमारा ॥",
      "sourceLineId": "133418",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗਾਰਵ ਦੇਸ ਬਸਤ ਹੈ ਜਹਾ ॥",
      "transliteration": "gaarav dhes basat hai jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਗਾਰਵ ਦੇਸ਼ ਵਸਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "गारव देस बसत है जहा ॥",
      "sourceLineId": "133419",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗੌਰ ਸੈਨ ਰਾਜਾ ਥੋ ਤਹਾ ॥੧॥",
      "transliteration": "gauar sain raajaa tho tahaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਗੌਰਸੈਨ ਨਾ ਦਾ ਰਾਜਾ (ਰਾਜ ਕਰਦਾ) ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "गौर सैन राजा थो तहा ॥१॥",
      "sourceLineId": "133420",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸ੍ਰੀ ਰਸ ਤਿਲਕ ਦੇਇ ਤਿਹ ਦਾਰਾ ॥",
      "transliteration": "sree ras tilak dhei teh dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪਤਨੀ ਦਾ ਨਾ ਰਸ ਤਿਲਕ ਦੇਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "स्री रस तिलक देइ तिह दारा ॥",
      "sourceLineId": "133421",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੰਦ੍ਰ ਲਿਯੋ ਜਾ ਤੇ ਉਜਿਯਾਰਾ ॥",
      "transliteration": "cha(n)dhr liyo jaa te ujiyaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਚੰਦ੍ਰਮਾ ਨੇ ਰੌਸ਼ਨੀ ਲਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "चंद्र लियो जा ते उजियारा ॥",
      "sourceLineId": "133422",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਾਮੁੰਦ੍ਰਕ ਲਛਨ ਤਾ ਮੈ ਸਬਿ ॥",
      "transliteration": "saamu(n)dhrak lachhan taa mai sab ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਮੁੰਦ੍ਰਕ (ਜੋਤਿਸ਼ ਸ਼ਾਸਤ੍ਰ ਗ੍ਰੰਥ ਵਿਚ ਇਸਤਰੀ ਦੇ ਜੋ ਲੱਛਣ ਲਿਖੇ ਹਨ ਉਹ) ਸਾਰੇ ਲੱਛਣ ਉਸ ਵਿਚ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "सामुँद्रक लछन ता मै सबि ॥",
      "sourceLineId": "133423",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਛਬਿ ਉਚਾਰ ਤਿਹ ਸਕੈ ਕਵਨ ਕਬਿ ॥੨॥",
      "transliteration": "chhab uchaar teh sakai kavan kab ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਛਬੀ ਬਾਰੇ ਕਿਹੜਾ ਕਵੀ ਬਖਾਨ ਕਰ ਸਕਦਾ ਹੈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "छबि उचार तिह सकै कवन कबि ॥२॥",
      "sourceLineId": "133424",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਹ ਇਕ ਹੁਤੋ ਸਾਹ ਕੋ ਪੂਤਾ ॥",
      "transliteration": "teh ik huto saeh ko pootaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸ਼ਾਹ ਦਾ ਪੁੱਤਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "तह इक हुतो साह को पूता ॥",
      "sourceLineId": "133425",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1258_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਭੂਤਲ ਕੋ ਜਾਨੁਕ ਪੁਰਹੂਤਾ ॥",
      "transliteration": "bhootal ko jaanuk purahootaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਧਰਤੀ ਉਤੇ ਇੰਦਰ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1258,
      "hindi": "",
      "hindiTransliteration": "भूतल को जानुक पुरहूता ॥",
      "sourceLineId": "133426",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
