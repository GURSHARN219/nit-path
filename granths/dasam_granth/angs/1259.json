{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1259,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1259_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਧਿਕ ਤਰੁਨ ਕੋ ਤੇਜ ਬਿਰਾਜੈ ॥",
      "transliteration": "adhik tarun ko tej biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਯੁਵਕ ਦਾ ਬਹੁਤ ਅਧਿਕ ਤੇਜ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "अधिक तरुन को तेज बिराजै ॥",
      "sourceLineId": "133427",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਰੀ ਨਾਗਨੀ ਕੋ ਮਨ ਲਾਜੈ ॥੩॥",
      "transliteration": "naree naaganee ko man laajai ||3||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ) ਨਰੀ ਅਤੇ ਨਾਗਨੀ ਦਾ ਮਨ ਲਜਿਤ ਹੁੰਦਾ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "नरी नागनी को मन लाजै ॥३॥",
      "sourceLineId": "133428",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਬ ਰਾਨੀ ਤਿਹ ਪ੍ਰਭਾ ਨਿਹਾਰੀ ॥",
      "transliteration": "jab raanee teh prabhaa nihaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਣੀ ਨੇ ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਵੇਖੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "जब रानी तिह प्रभा निहारी ॥",
      "sourceLineId": "133429",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਬ ਤੇ ਭਈ ਅਧਿਕ ਮਤਵਾਰੀ ॥",
      "transliteration": "tab te bhiee adhik matavaaree ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤੋਂ (ਉਹ ਉਸ ਦੀ) ਬਹੁਤ ਮਤਵਾਲੀ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "तब ते भई अधिक मतवारी ॥",
      "sourceLineId": "133430",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਿਰਖਿ ਮਿਤ੍ਰ ਕੇ ਨੈਨ ਬਿਕਾਨੀ ॥",
      "transliteration": "nirakh mitr ke nain bikaanee ||",
      "translation": "",
      "punjabiViakhya": "ਮਿਤਰ ਦੀਆਂ ਅੱਖਾ ਵੇਖ ਕੇ ਵਿਕ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "निरखि मित्र के नैन बिकानी ॥",
      "sourceLineId": "133431",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਬ ਹੀ ਤੇ ਹ੍ਵੈ ਗਈ ਦਿਵਾਨੀ ॥੪॥",
      "transliteration": "tab hee te havai giee dhivaanee ||4||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤੋਂ ਹੀ (ਉਸ ਦੀ) ਦੀਵਾਨੀ ਹੋ ਗਈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "तब ही ते ह्वै गई दिवानी ॥४॥",
      "sourceLineId": "133432",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਬ ਤਿਹ ਬੋਲਿ ਲੀਯੋ ਅਪਨੇ ਘਰ ॥",
      "transliteration": "tab teh bol leeyo apane ghar ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਨੂੰ ਆਪਣੇ ਘਰ ਬੁਲਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "तब तिह बोलि लीयो अपने घर ॥",
      "sourceLineId": "133433",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਾਮ ਕੇਲ ਕੀਨਾ ਅਤਿ ਰੁਚਿ ਕਰਿ ॥",
      "transliteration": "kaam kel keenaa at ruch kar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਰੁਚੀ ਪੂਰਵਕ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "काम केल कीना अति रुचि करि ॥",
      "sourceLineId": "133434",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਿਹ ਗਰੇ ਲਗਾਯੋ ॥",
      "transliteration": "bhaat bhaat teh gare lagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਨਾਲ ਉਸ ਨੂੰ ਗਲੇ ਲਗਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तिह गरे लगायो ॥",
      "sourceLineId": "133435",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਬਲਾ ਅਧਿਕ ਹ੍ਰਿਦੈ ਸੁਖੁ ਪਾਯੋ ॥੫॥",
      "transliteration": "abalaa adhik hiradhai sukh paayo ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸਤਰੀ ਨੇ ਹਿਰਦੇ ਵਿਚ ਬਹੁਤ ਸੁਖ ਪ੍ਰਾਪਤ ਕੀਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "अबला अधिक हृदै सुखु पायो ॥५॥",
      "sourceLineId": "133436",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਬ ਲਗ ਆਇ ਨ੍ਰਿਪਤਿ ਤਹ ਗਯੋ ॥",
      "transliteration": "tab lag aai nirapat teh gayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਰਾਜਾ ਉਥੇ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "तब लग आइ नृपति तह गयो ॥",
      "sourceLineId": "133437",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਤਛਿਨ ਡਾਰਿ ਮਹਲ ਤੇ ਦਯੋ ॥",
      "transliteration": "tatachhin ddaar mahal te dhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ) ਉਸੇ ਛਿਣ (ਰਾਜੇ ਨੂੰ) ਮਹੱਲ ਤੋਂ ਹੇਠਾ ਸੁਟ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "ततछिन डारि महल ते दयो ॥",
      "sourceLineId": "133438",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਰਿ ਗਯੋ ਨ੍ਰਿਪਤਿ ਨ ਭੇਦ ਬਿਚਾਰਾ ॥",
      "transliteration": "mar gayo nirapat na bhedh bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਮਰ ਗਿਆ ਅਤੇ (ਕਿਸੇ ਨੇ ਵੀ) ਭੇਦ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "मरि गयो नृपति न भेद बिचारा ॥",
      "sourceLineId": "133439",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜੋ ਜਨ ਅਰਧ ਉਰਧ ਤੇ ਪਾਰਾ ॥੬॥",
      "transliteration": "jo jan aradh uradh te paaraa ||6||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਵਿਅਕਤੀ ਉਪਰੋਂ ਹੇਠਾ ਸੁਟਿਆ ਸੀ (ਉਹ ਸਚਮੁਚ ਮਰ ਗਿਆ) ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "जो जन अरध उरध ते पारा ॥६॥",
      "sourceLineId": "133440",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਆਪ ਰੋਤ ਇਹ ਭਾਤਿ ਉਚਾਰਾ ॥",
      "transliteration": "aap rot ieh bhaat uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਇਸਤਰੀ ਆਪ ਰੋ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿਣ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "आप रोत इह भाति उचारा ॥",
      "sourceLineId": "133441",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੇਵ ਪਕਰਿ ਕਰਿ ਨ੍ਰਿਪਤਿ ਪਛਾਰਾ ॥",
      "transliteration": "dhev pakar kar nirapat pachhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਦੈਵ (ਅਥਵਾ ਦੈਂਤ) ਨੇ ਰਾਜੇ ਨੂੰ ਪਕੜ ਕੇ ਸੁਟਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "देव पकरि करि नृपति पछारा ॥",
      "sourceLineId": "133442",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੋਰੇ ਸਾਥ ਕਿਯੋ ਥੋ ਸੰਗਾ ॥",
      "transliteration": "more saath kiyo tho sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਮੇਰੇ ਨਾਲ ਸੰਯੋਗ ਕੀਤਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "मोरे साथ कियो थो संगा ॥",
      "sourceLineId": "133443",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾ ਤੇ ਭਯੋ ਅਪਵਿਤ੍ਰ ਸ੍ਰਬੰਗਾ ॥੭॥",
      "transliteration": "taa te bhayo apavitr sraba(n)gaa ||7||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ (ਉਸ ਦਾ) ਸਾਰਾ ਸ਼ਰੀਰ ਅਪਵਿਤ੍ਰ ਹੋ ਗਿਆ ਸੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "ता ते भयो अपवित्र स्रबंगा ॥७॥",
      "sourceLineId": "133444",
      "sourceShabadId": "12536",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "133445",
      "sourceShabadId": "12537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਇਹ ਛਲ ਜਾਰ ਨਿਕਾਰਿਯੋ ਨਿਜੁ ਨਾਇਕਹਿ ਸੰਘਾਰਿ ॥",
      "transliteration": "eeh chhal jaar nikaariyo nij naikeh sa(n)ghaar ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਯਾਰ ਨੂੰ ਕਢ ਦਿੱਤਾ ਅਤੇ ਆਪਣੇ ਪਤੀ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "इह छल जार निकारियो निजु नाइकहि संघारि ॥",
      "sourceLineId": "133446",
      "sourceShabadId": "12537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਮੂਰਖ ਕਿਛੂ ਸਕਾ ਨ ਨੈਕ ਬਿਚਾਰਿ ॥੮॥",
      "transliteration": "bhedh abhedh moorakh kichhoo sakaa na naik bichaar ||8||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮੂਰਖ ਭੇਦ ਅਭੇਦ ਕੁਝ ਵੀ ਵਿਚਾਰ ਨਾ ਸਕਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद मूरख किछू सका न नैक बिचारि ॥८॥",
      "sourceLineId": "133447",
      "sourceShabadId": "12537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਿਜੁ ਨਾਇਕ ਕੌ ਮਹਲ ਤੇ ਤਿਹ ਹਿਤ ਦਿਯੋ ਗਿਰਾਇ ॥",
      "transliteration": "nij naik kau mahal te teh hit dhiyo girai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਪ੍ਰੇਮੀ) ਲਈ ਆਪਣੇ ਪਤੀ ਨੂੰ ਮਹੱਲ ਤੋਂ ਹੇਠਾ ਡਿਗਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "निजु नाइक कौ महल ते तिह हित दियो गिराइ ॥",
      "sourceLineId": "133448",
      "sourceShabadId": "12537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਯਾਰ ਬਚਾਯੋ ਆਪਨੋ ਨੈਕ ਨ ਰਹੀ ਲਜਾਇ ॥੯॥",
      "transliteration": "yaar bachaayo aapano naik na rahee lajai ||9||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਯਾਰ ਨੂੰ ਬਚਾ ਲਿਆ ਅਤੇ ਜ਼ਰਾ ਜਿੰਨੀ ਵੀ ਸ਼ਰਮਿੰਦੀ ਨਾ ਹੋਈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "यार बचायो आपनो नैक न रही लजाइ ॥९॥",
      "sourceLineId": "133449",
      "sourceShabadId": "12537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਦਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੧੦॥੫੯੨੧॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau dhas charitr samaapatam sat subham sat ||310||5921||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੧੦ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੧੦॥੫੯੨੧॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ दस चरित्र समापतम सतु सुभम सतु ॥३१०॥५९२१॥अफजूँ॥",
      "sourceLineId": "133450",
      "sourceShabadId": "12537",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133451",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਿਰਹ ਸੈਨ ਇਕ ਨ੍ਰਿਪਤਿ ਸੁਜਾਨਾ ॥",
      "transliteration": "bireh sain ik nirapat sujaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਰਹ ਸੈਨ ਨਾ ਦਾ ਇਕ ਸੁਜਾਨ ਰਾਜਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "बिरह सैन इक नृपति सुजाना ॥",
      "sourceLineId": "133452",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਾਨਤ ਆਨਿ ਦੇਸ ਜਿਹ ਨਾਨਾ ॥",
      "transliteration": "maanat aan dhes jeh naanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਬਹੁਤ ਸਾਰੇ ਦੇਸ ਈਨ ਮੰਨਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "मानत आनि देस जिह नाना ॥",
      "sourceLineId": "133453",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਿਰਹ ਮੰਜਰੀ ਤਾ ਕੀ ਰਾਨੀ ॥",
      "transliteration": "bireh ma(n)jaree taa kee raanee ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਰਹ ਮੰਜਰੀ ਉਸ ਦੀ ਰਾਣੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "बिरह मंजरी ता की रानी ॥",
      "sourceLineId": "133454",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੁੰਦਰਿ ਭਵਨ ਚਤ੍ਰਦਸ ਜਾਨੀ ॥੧॥",
      "transliteration": "su(n)dhar bhavan chatradhas jaanee ||1||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਚੌਦਾ ਲੋਕਾ ਵਿਚ ਸੁੰਦਰੀ ਸਮਝੀ ਜਾਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "सुँदरि भवन चत्रदस जानी ॥१॥",
      "sourceLineId": "133455",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਾ ਕੈ ਧਾਮ ਏਕ ਸੁਤ ਭਯੋ ॥",
      "transliteration": "taa kai dhaam ek sut bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਘਰ ਇਕ ਪੁੱਤਰ ਹੋਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "ता कै धाम एक सुत भयो ॥",
      "sourceLineId": "133456",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਾਨਕ ਰਵਿ ਦੁਤਿਯੋ ਪ੍ਰਗਟਯੋ ॥",
      "transliteration": "jaanak rav dhutiyo pragaTayo ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਦੂਜਾ ਸੂਰਜ ਪ੍ਰਗਟ ਹੋਇਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "जानक रवि दुतियो प्रगटयो ॥",
      "sourceLineId": "133457",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੁੰਦਰਿਤਾ ਤਿਹ ਕਹੀ ਨ ਆਵੈ ॥",
      "transliteration": "su(n)dharitaa teh kahee na aavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਦਾ ਬਖਾਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "सुँदरिता तिह कही न आवै ॥",
      "sourceLineId": "133458",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਿਰਖਤ ਪਲਕ ਨ ਜੋਰੀ ਜਾਵੈ ॥੨॥",
      "transliteration": "nirakhat palak na joree jaavai ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖਦਿਆਂ ਪਲਕਾ ਜੋੜੀਆਂ ਨਹੀਂ ਜਾ ਸਕਦੀਆਂ ਸਨ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "निरखत पलक न जोरी जावै ॥२॥",
      "sourceLineId": "133459",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਹ ਇਕ ਤਰਨਿ ਸਾਹ ਕੀ ਜਾਈ ॥",
      "transliteration": "teh ik taran saeh kee jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "तह इक तरनि साह की जाई ॥",
      "sourceLineId": "133460",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਾ ਕੀ ਛਬਿ ਨਹਿ ਜਾਤ ਬਤਾਈ ॥",
      "transliteration": "jaa kee chhab neh jaat bataiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਛਬੀ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ। (ਇਸ ਤਰ੍ਰਹਾ ਲਗਦੀ ਸੀ)",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "जा की छबि नहि जात बताई ॥",
      "sourceLineId": "133461",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕੈ ਸਸਿ ਤੇ ਰੋਹਨਿ ਇਹ ਜਈ ॥",
      "transliteration": "kai sas te rohan ieh jiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਚੰਦ੍ਰਮਾ ਅਤੇ ਰੋਹਿਣੀ ਨੇ ਇਸ ਨੂੰ ਜਨਮ ਦਿੱਤਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "कै ससि ते रोहनि इह जई ॥",
      "sourceLineId": "133462",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਆਗੇ ਹ੍ਵੈ ਹੈ ਨ ਪਾਛੇ ਭਈ ॥੩॥",
      "transliteration": "aage havai hai na paachhe bhiee ||3||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਵਰਗੀ) ਨਾ ਪਹਿਲਾ ਹੋਈ ਹੈ ਅਤੇ ਨਾ ਹੀ ਅਗੋਂ ਹੋਵੇਗੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "आगे ह्वै है न पाछे भई ॥३॥",
      "sourceLineId": "133463",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਜਬ ਤਵਨ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "raaj kuar jab tavan nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰ ਨੂੰ ਜਦੋਂ ਉਸ ਨੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "राज कुअर जब तवन निहारियो ॥",
      "sourceLineId": "133464",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮਦਨ ਬਾਨ ਤਨ ਤਾਹਿ ਪ੍ਰਹਾਰਿਯੋ ॥",
      "transliteration": "madhan baan tan taeh prahaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਕਾਮ ਦੇਵ ਨੇ ਉਸ ਦੇ ਸ਼ਰੀਰ ਵਿਚ ਬਾਣ ਮਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "मदन बान तन ताहि प्रहारियो ॥",
      "sourceLineId": "133465",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਲਗੀ ਅਟਕਿ ਸੁਧਿ ਬੁਧਿ ਛੁਟ ਗਈ ॥",
      "transliteration": "lagee aTak sudh budh chhuT giee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਪ੍ਰੇਮ ਹੋ ਜਾਣ ਕਰ ਕੇ ਸੁੱਧ ਬੁੱਧ ਭੁਲਾ ਬੈਠੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "लगी अटकि सुधि बुधि छुट गई ॥",
      "sourceLineId": "133466",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਬਹਿ ਤਰੁਨਿ ਮਤਵਾਰੀ ਭਈ ॥੪॥",
      "transliteration": "tabeh tarun matavaaree bhiee ||4||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ (ਉਹ) ਇਸਤਰੀ ਮਤਵਾਲੀ ਹੋ ਗਈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "तबहि तरुनि मतवारी भई ॥४॥",
      "sourceLineId": "133467",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਦਰਬੁ ਲੁਟਾਈ ॥",
      "transliteration": "bhaat bhaat tan dharab luTaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਅਨੇਕ ਤਰ੍ਰਹਾ ਨਾਲ ਧਨ ਲੁਟਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन दरबु लुटाई ॥",
      "sourceLineId": "133468",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਧਿਕ ਸਖਿਨ ਕਹ ਰਹੀ ਪਠਾਈ ॥",
      "transliteration": "adhik sakhin keh rahee paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਸਖੀਆਂ ਨੂੰ ਭੇਜਦੀ ਰਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "अधिक सखिन कह रही पठाई ॥",
      "sourceLineId": "133469",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਕ੍ਯੋਹੂੰ ਨਹਿ ਆਏ ॥",
      "transliteration": "raaj kuar kayohoo(n) neh aae ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਰਾਜ ਕੁਮਾਰ ਕਿਸੇ ਤਰ੍ਰਹਾ ਵੀ ਨਾ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "राज कुअर क्योहूँ नहि आए ॥",
      "sourceLineId": "133470",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਾ ਸੌ ਕਰੇ ਨ ਮਨ ਕੇ ਭਾਏ ॥੫॥",
      "transliteration": "taa sau kare na man ke bhaae ||5||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਮਨ ਦੀ ਭਾਵਨਾ (ਵਾਲਾ ਪ੍ਰੇਮ) ਨਾ ਕਰਦਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "ता सौ करे न मन के भाए ॥५॥",
      "sourceLineId": "133471",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਰਿ ਕਰਿ ਜਤਨ ਕੁਅਰਿ ਬਹੁ ਹਾਰੀ ॥",
      "transliteration": "kar kar jatan kuar bahu haaree ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਯਤਨ ਕਰ ਕਰ ਕੇ ਕੁਮਾਰੀ ਹਾਰ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "करि करि जतन कुअरि बहु हारी ॥",
      "sourceLineId": "133472",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕੈਸਹੂੰ ਭਜੀ ਮਿਤ੍ਰ ਨਹਿ ਪ੍ਯਾਰੀ ॥",
      "transliteration": "kaisahoo(n) bhajee mitr neh payaaree ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਕਿਸੇ ਤਰ੍ਰਹਾ ਵੀ ਮਿਤਰ ਨੇ ਪਿਆਰੀ ਨਾਲ ਰਮਣ ਨਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1259,
      "hindi": "",
      "hindiTransliteration": "कैसहूँ भजी मित्र नहि प्यारी ॥",
      "sourceLineId": "133473",
      "sourceShabadId": "12538",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1259_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਘਾਯਲ ਫਿਰੈ ਕੁਅਰਿ ਮਤਵਾਰੀ ॥",
      "transliteration": "ghaayal firai kuar matavaaree ||",
      "translation": "",
