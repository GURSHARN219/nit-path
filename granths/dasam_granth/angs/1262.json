{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1262,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1262_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਿਸ੍ਵਮਤੀ ਤਾ ਕੇ ਇਕ ਨਾਰੀ ॥",
      "transliteration": "bisavaimatee taa ke ik naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਾਸ ਇਕ ਬਿਸ੍ਵਮਤੀ ਇਸਤਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "बिस्वमती ता के इक नारी ॥",
      "sourceLineId": "133571",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਾਤ ਨ ਜਿਹ ਕੀ ਪ੍ਰਭਾ ਉਚਾਰੀ ॥੧॥",
      "transliteration": "jaat na jeh kee prabhaa uchaaree ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਸੁੰਦਰਤਾ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "जात न जिह की प्रभा उचारी ॥१॥",
      "sourceLineId": "133572",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਾਇਨੇਕ ਤਿਨ ਨ੍ਰਿਪਤਿ ਨਿਹਾਰੀ ॥",
      "transliteration": "nainek tin nirapat nihaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਰਾਜੇ ਨੇ ਇਕ ਨੈਣ ਵੇਖੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "नाइनेक तिन नृपति निहारी ॥",
      "sourceLineId": "133573",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰੂਪਮਾਨ ਗੁਨਮਾਨ ਬਿਚਾਰੀ ॥",
      "transliteration": "roopamaan gunamaan bichaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਬਹੁਤ ਰੂਪਮਾਨ ਅਤੇ ਗੁਣਵਾਨ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "रूपमान गुनमान बिचारी ॥",
      "sourceLineId": "133574",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਾ ਕਹ ਪਕਰਿ ਸਦਨ ਲੈ ਆਯੋ ॥",
      "transliteration": "taa keh pakar sadhan lai aayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਪਕੜ ਕੇ ਮਹੱਲ ਵਿਚ ਲੈ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "ता कह पकरि सदन लै आयो ॥",
      "sourceLineId": "133575",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਿਹ ਸਾਥ ਕਮਾਯੋ ॥੨॥",
      "transliteration": "kaam bhog teh saath kamaayo ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਕਾਮ ਭੋਗ ਕੀਤਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "काम भोग तिह साथ कमायो ॥२॥",
      "sourceLineId": "133576",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਾ ਕੋ ਲੈ ਇਸਤ੍ਰੀ ਨ੍ਰਿਪ ਕਰੋ ॥",
      "transliteration": "taa ko lai isatree nirap karo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਰਾਜੇ ਨੇ ਆਪਣੀ ਇਸਤਰੀ ਬਣਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "ता को लै इसत्री नृप करो ॥",
      "sourceLineId": "133577",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਿਹ ਸਾਥ ਬਿਹਰੋ ॥",
      "transliteration": "bhaat bhaat teh saath biharo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦਾ ਉਸ ਨਾਲ ਰਮਣ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तिह साथ बिहरो ॥",
      "sourceLineId": "133578",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਾ ਤ੍ਰਿਯ ਕੀ ਕੁਟੇਵ ਨਹਿ ਜਾਈ ॥",
      "transliteration": "taa tiray kee kuTev neh jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਦੀ 'ਕੁਵੇਟ' ('ਕੁਵਾਟ'-ਕੁਮਾਰਗ ਉਤੇ ਜਾਣ ਦੀ ਰੁਚੀ) ਨਹੀਂ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "ता तृय की कुटेव नहि जाई ॥",
      "sourceLineId": "133579",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਵਰਨ ਸਾਥ ਰਮੈ ਲਪਟਾਈ ॥੩॥",
      "transliteration": "avaran saath ramai lapaTaiee ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੋਰਨਾ (ਬੰਦਿਆਂ) ਨਾਲ ਰਮਣ ਕਰਦੀ ਰਹੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "अवरन साथ रमै लपटाई ॥३॥",
      "sourceLineId": "133580",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਕ ਦਿਨ ਅਰਧ ਨਿਸਾ ਜਬ ਭਈ ॥",
      "transliteration": "eik dhin aradh nisaa jab bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਜਦ ਅੱਧੀ ਰਾਤ ਹੋ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "इक दिन अरध निसा जब भई ॥",
      "sourceLineId": "133581",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਾਰ ਧਾਮ ਨਾਇਨ ਵਹ ਗਈ ॥",
      "transliteration": "jaar dhaam nain veh giee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਨੈਣ ਯਾਰ ਦੇ ਘਰ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "जार धाम नाइन वह गई ॥",
      "sourceLineId": "133582",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚੌਕੀਦਾਰਨ ਗਹਿ ਤਾ ਕੌ ਲਿਯ ॥",
      "transliteration": "chauakeedhaaran geh taa kau liy ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਕੀਦਾਰਾ ਨੇ ਉਸ ਨੂੰ ਪਕੜ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "चौकीदारन गहि ता कौ लिय ॥",
      "sourceLineId": "133583",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਕ ਕਾਟਿ ਕਰ ਬਹੁਰਿ ਛਾਡਿ ਦਿਯ ॥੪॥",
      "transliteration": "naak kaaT kar bahur chhaadd dhiy ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨੱਕ ਕਟ ਕੇ ਫਿਰ ਛਡ ਦਿੱਤਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "नाक काटि कर बहुरि छाडि दिय ॥४॥",
      "sourceLineId": "133584",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਇਨਿ ਕਟੀ ਨਾਕ ਲੈ ਕੈ ਕਰ ॥",
      "transliteration": "nain kaTee naak lai kai kar ||",
      "translation": "",
      "punjabiViakhya": "ਨੈਣ ਕਟੀ ਹੋਈ ਨੱਕ ਹੱਥ ਵਿਚ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "नाइनि कटी नाक लै कै कर ॥",
      "sourceLineId": "133585",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਫਿਰਿ ਆਈ ਨ੍ਰਿਪ ਕੇ ਭੀਤਰ ਘਰ ॥",
      "transliteration": "fir aaiee nirap ke bheetar ghar ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਰਾਜੇ ਦੇ ਘਰ ਅੰਦਰ ਆ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "फिरि आई नृप के भीतर घर ॥",
      "sourceLineId": "133586",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਬ ਨ੍ਰਿਪ ਰੋਮ ਮੂੰਡਬੇ ਕਾਜਾ ॥",
      "transliteration": "tab nirap rom moo(n)ddabe kaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜੇ ਨੇ ਵਾਲ ਮੁੰਨਣ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "तब नृप रोम मूँडबे काजा ॥",
      "sourceLineId": "133587",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਾਗ੍ਯੋ ਤੁਰਤੁ ਉਸਤਰਾ ਰਾਜਾ ॥੫॥",
      "transliteration": "maagayo turat usataraa raajaa ||5||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਉਸਤਰਾ ਮੰਗਿਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "माग्यो तुरतु उसतरा राजा ॥५॥",
      "sourceLineId": "133588",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਬ ਤਿਨ ਵਹੈ ਉਸਤਰਾ ਦੀਯੋ ॥",
      "transliteration": "tab tin vahai usataraa dheeyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਨੇ ਉਹ ਉਸਤਰਾ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "तब तिन वहै उसतरा दीयो ॥",
      "sourceLineId": "133589",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਾ ਪਰ ਬਾਢਿ ਨ ਕਬਹੂੰ ਕੀਯੋ ॥",
      "transliteration": "jaa par baadd na kabahoo(n) keeyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਪਹਿਲਾ ਕਦੇ ਵਾਲ ਨਹੀਂ ਮੁੰਨੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "जा पर बाढि न कबहूँ कीयो ॥",
      "sourceLineId": "133590",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਿਰਖਿ ਨ੍ਰਿਪਤਿ ਤਿਹ ਅਧਿਕ ਰਿਸਾਯੋ ॥",
      "transliteration": "nirakh nirapat teh adhik risaayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਬਹੁਤ ਕ੍ਰੋਧਿਤ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "निरखि नृपति तिह अधिक रिसायो ॥",
      "sourceLineId": "133591",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗਹਿ ਤਾ ਤ੍ਰਿਯ ਕੀ ਓਰ ਚਲਾਯੋ ॥੬॥",
      "transliteration": "geh taa tiray kee or chalaayo ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਕੜ ਕੇ ਉਸ ਇਸਤਰੀ ਵਲ ਸੁਟਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "गहि ता तृय की ओर चलायो ॥६॥",
      "sourceLineId": "133592",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਬ ਤ੍ਰਿਯ ਹਾਇ ਹਾਇ ਕਹਿ ਉਠੀ ॥",
      "transliteration": "tab tiray hai hai keh uThee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਹ ਇਸਤਰੀ 'ਹਾਇ ਹਾਇ' ਕਰਨ ਲਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "तब तृय हाइ हाइ कहि उठी ॥",
      "sourceLineId": "133593",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਾਟਿ ਨਾਕ ਰਾਜਾ ਜੂ ਸੁਟੀ ॥",
      "transliteration": "kaaT naak raajaa joo suTee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਾ ਜੀ! (ਤੁਸੀਂ ਮੇਰੀ) ਨੱਕ ਹੀ ਵਢ ਸੁਟੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "काटि नाक राजा जू सुटी ॥",
      "sourceLineId": "133594",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਬ ਰਾਜਾ ਹੇਰਨ ਤਿਹ ਧਾਯੋ ॥",
      "transliteration": "tab raajaa heran teh dhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜਾ ਉਸ ਨੂੰ ਵੇਖਣ ਲਈ ਵਧਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "तब राजा हेरन तिह धायो ॥",
      "sourceLineId": "133595",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸ੍ਰੋਨ ਪੁਲਤ ਲਖਿ ਮੁਖ ਬਿਸਮਾਯੋ ॥੭॥",
      "transliteration": "sron pulat lakh mukh bisamaayo ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲਹੂ ਲਿਬੜਿਆ ਮੂੰਹ ਵੇਖ ਕੇ ਹੈਰਾਨ ਰਹਿ ਗਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "स्रोन पुलत लखि मुख बिसमायो ॥७॥",
      "sourceLineId": "133596",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹਾਹਾ ਪਦ ਤਬ ਨ੍ਰਿਪਤਿ ਉਚਾਰਾ ॥",
      "transliteration": "haahaa padh tab nirapat uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜੇ ਨੇ 'ਹਾਇ ਹਾਇ' ਸ਼ਬਦ ਉਚਾਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "हाहा पद तब नृपति उचारा ॥",
      "sourceLineId": "133597",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮੈ ਨਹਿ ਐਸੇ ਭੇਦ ਬਿਚਾਰਾ ॥",
      "transliteration": "mai neh aaise bhedh bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ) ਕਿ ਮੈਂ ਇਹ ਸੋਚਿਆ ਤਕ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "मै नहि ऐसे भेद बिचारा ॥",
      "sourceLineId": "133598",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਿਰਖਹੁ ਤਾ ਤ੍ਰਿਯ ਕੀ ਚਤੁਰਈ ॥",
      "transliteration": "nirakhahu taa tiray kee chaturiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਦੀ ਚਾਲਾਕੀ ਵੇਖੋ",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "निरखहु ता तृय की चतुरई ॥",
      "sourceLineId": "133599",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰਾਜਾ ਮੂੰਡ ਬੁਰਾਈ ਦਈ ॥੮॥",
      "transliteration": "raajaa moo(n)dd buraiee dhiee ||8||",
      "translation": "",
      "punjabiViakhya": "ਕਿ (ਸਾਰੀ) ਬੁਰਿਆਈ ਰਾਜੇ ਦੇ ਸਿਰ ਮੜ੍ਰਹ ਦਿੱਤੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "राजा मूँड बुराई दई ॥८॥",
      "sourceLineId": "133600",
      "sourceShabadId": "12543",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "133601",
      "sourceShabadId": "12544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਕੌ ਤਿਨ ਨ੍ਰਿਪਤਿ ਕਿਯਾ ਨ ਹ੍ਰਿਦੈ ਬਿਚਾਰ ॥",
      "transliteration": "bhedh abhedh kau tin nirapat kiyaa na hiradhai bichaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਰਾਜੇ ਨੇ ਭੇਦ ਅਭੇਦ ਦਾ ਮਨ ਵਿਚ ਵਿਚਾਰ ਨਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद कौ तिन नृपति किया न हृदै बिचार ॥",
      "sourceLineId": "133602",
      "sourceShabadId": "12544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਾਹਿ ਬੁਰਾਈ ਸਿਰ ਦਈ ਨਾਕ ਕਟਾਈ ਨਾਰਿ ॥੯॥",
      "transliteration": "taeh buraiee sir dhiee naak kaTaiee naar ||9||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਇਸਤਰੀ ਨੇ ਨੱਕ (ਕਿਤੇ ਹੋਰ ਕਟਾਈ ਸੀ) ਪਰ ਬੁਰਿਆਈ ਉਸ (ਰਾਜੇ) ਦੇ ਸਿਰ ਮੜ੍ਰਹ ਦਿੱਤੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "ताहि बुराई सिर दई नाक कटाई नारि ॥९॥",
      "sourceLineId": "133603",
      "sourceShabadId": "12544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਤੇਰਹ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੧੩॥੫੯੫੮॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau tereh charitr samaapatam sat subham sat ||313||5958||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੧੩ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੧੩॥੫੯੫੮॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ तेरह चरित्र समापतम सतु सुभम सतु ॥३१३॥५९५८॥अफजूँ॥",
      "sourceLineId": "133604",
      "sourceShabadId": "12544",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133605",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦਛਿਨ ਸੈਨ ਸੁ ਦਛਿਨ ਨ੍ਰਿਪ ਇਕ ॥",
      "transliteration": "dhachhin sain su dhachhin nirap ik ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਛਣ (ਦਿਸ਼ਾ) ਵਿਚ ਇਕ ਦਛਿਨ ਸੈਨ ਨਾ ਦਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "दछिन सैन सु दछिन नृप इक ॥",
      "sourceLineId": "133606",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਾਸਤ੍ਰ ਸਿਮ੍ਰਿਤ ਜਾਨਤ ਥੋ ਨਿਕ ॥",
      "transliteration": "saasatr simirat jaanat tho nik ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਅਨੇਕ ਸ਼ਾਸਤ੍ਰ ਸਮ੍ਰਿਤੀਆਂ ਜਾਣਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "सासत्र सिमृत जानत थो निक ॥",
      "sourceLineId": "133607",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਦਨ ਸੁ ਦਛਿਨ ਦੇ ਤਿਹ ਦਾਰਾ ॥",
      "transliteration": "sadhan su dhachhin dhe teh dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਰਾਜੇ) ਦੇ ਘਰ ਦਛਿਨ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "सदन सु दछिन दे तिह दारा ॥",
      "sourceLineId": "133608",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਨੁ ਸਸਿ ਚੜਿਯੋ ਗਗਨ ਮੰਝਾਰਾ ॥੧॥",
      "transliteration": "jan sas chaRiyo gagan ma(n)jhaaraa ||1||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦੀ ਸੀ) ਮਾਨੋ ਆਕਾਸ਼ ਵਿਚ ਚੰਦ੍ਰਮਾ ਚੜ੍ਰਹਿਆ ਹੋਵੇ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "जनु ससि चड़ियो गगन मंझारा ॥१॥",
      "sourceLineId": "133609",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਪ੍ਰਮਾਨ ਰਾਨੀ ਕੀ ਥੀ ਛਬਿ ॥",
      "transliteration": "apramaan raanee kee thee chhab ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਦੀ ਅਸੀਮ ਸੁੰਦਰਤਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "अप्रमान रानी की थी छबि ॥",
      "sourceLineId": "133610",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਿਰਖਿ ਪ੍ਰਭਾ ਜਿਹ ਰਹਤ ਭਾਨ ਦਬਿ ॥",
      "transliteration": "nirakh prabhaa jeh rahat bhaan dhab ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਪ੍ਰਭਾ ਨੂੰ ਵੇਖ ਕੇ ਸੂਰਜ ਦਬਿਆ ਦਬਿਆ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "निरखि प्रभा जिह रहत भान दबि ॥",
      "sourceLineId": "133611",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰਾਜਾ ਅਧਿਕ ਆਸਕਤ ਤਾ ਪਰਿ ॥",
      "transliteration": "raajaa adhik aasakat taa par ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਉਸ ਉਤੇ ਬਹੁਤ ਮੋਹਿਤ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "राजा अधिक आसकत ता परि ॥",
      "sourceLineId": "133612",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਿਹ ਬਿਧਿ ਅਲਿ ਪੰਖੁਰੀ ਕਮਲ ਕਰਿ ॥੨॥",
      "transliteration": "jeh bidh al pa(n)khuree kamal kar ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਭੌਰਾ ਕਮਲ ਦੀ ਪੰਖੜੀ ਉਤੇ ਹੁੰਦਾ ਹੈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "जिह बिधि अलि पंखुरी कमल करि ॥२॥",
      "sourceLineId": "133613",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਹਾ ਸਾਹ ਕੀ ਹੁਤੀ ਦੁਲਾਰੀ ॥",
      "transliteration": "tahaa saeh kee hutee dhulaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ (ਇਕ) ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਹੁੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "तहा साह की हुती दुलारी ॥",
      "sourceLineId": "133614",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਿਨ ਰਾਜਾ ਕੀ ਪ੍ਰਭਾ ਨਿਹਾਰੀ ॥",
      "transliteration": "tin raajaa kee prabhaa nihaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ (ਇਕ ਦਿਨ) ਰਾਜੇ ਦੀ ਸੁੰਦਰਤਾ ਵੇਖੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "तिन राजा की प्रभा निहारी ॥",
      "sourceLineId": "133615",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸ੍ਰੀ ਸੁ ਕੁਮਾਰ ਦੇਇ ਤਿਹ ਨਾਮਾ ॥",
      "transliteration": "sree su kumaar dhei teh naamaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਾਮ ਸੁਕੁਮਾਰ ਦੇਈ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "स्री सु कुमार देइ तिह नामा ॥",
      "sourceLineId": "133616",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਿਹ ਸੀ ਭਈ ਨ ਮਹਿ ਮਹਿ ਬਾਮਾ ॥੩॥",
      "transliteration": "jeh see bhiee na meh meh baamaa ||3||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਧਰਤੀ ਉਤੇ ਕੋਈ ਇਸਤਰੀ ਨਹੀਂ ਹੋਈ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "जिह सी भई न महि महि बामा ॥३॥",
      "sourceLineId": "133617",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚਿਤ ਮਹਿ ਸਾਹ ਸੁਤਾ ਯੌ ਕਹਿਯੋ ॥",
      "transliteration": "chit meh saeh sutaa yau kahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਨੇ ਮਨ ਵਿਚ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "चित महि साह सुता यौ कहियो ॥",
      "sourceLineId": "133618",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਬ ਤਿਹ ਹੇਰਿ ਅਟਕ ਮਨ ਰਹਿਯੋ ॥",
      "transliteration": "jab teh her aTak man rahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜਦ ਦਾ ਉਸ ਨੂੰ ਵੇਖਿਆ ਹੈ, ਮਨ (ਉਸ ਵਿਚ) ਅਟਕ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "जब तिह हेरि अटक मन रहियो ॥",
      "sourceLineId": "133619",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕੌਨ ਜਤਨ ਜਾ ਤੇ ਨ੍ਰਿਪ ਪਾਊ ॥",
      "transliteration": "kauan jatan jaa te nirap paauoo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਹੜੇ ਯਤਨ ਨਾਲ ਰਾਜੇ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "कौन जतन जा ते नृप पाऊ ॥",
      "sourceLineId": "133620",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਚਿਤ ਤੇ ਤ੍ਰਿਯ ਪਹਿਲੀ ਬਿਸਰਾਊ ॥੪॥",
      "transliteration": "chit te tiray pahilee bisaraauoo ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਦੇ) ਮਨ ਤੋਂ ਪਹਿਲੀ ਇਸਤਰੀ ਨੂੰ ਭੁਲਵਾ ਦਿਆਂ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "चित ते तृय पहिली बिसराऊ ॥४॥",
      "sourceLineId": "133621",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਬਸਤ੍ਰਤਿ ਉਤਮ ਸਕਲ ਉਤਾਰੇ ॥",
      "transliteration": "basatrat utam sakal utaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਸਾਰੇ ਅਤਿ ਉਤਮ ਬਸਤ੍ਰ ਉਤਾਰ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "बसत्रति उतम सकल उतारे ॥",
      "sourceLineId": "133622",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮੇਖਲਾਦਿ ਤਨ ਮੋ ਪਟ ਧਾਰੇ ॥",
      "transliteration": "mekhalaadh tan mo paT dhaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਖਲਾ ਆਦਿ ਬਸਤ੍ਰ ਸ਼ਰੀਰ ਉਤੇ ਧਾਰਨ ਕਰ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "मेखलादि तन मो पट धारे ॥",
      "sourceLineId": "133623",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤਾ ਕੇ ਧੂਮ ਦ੍ਵਾਰ ਪਰ ਡਾਰਿਯੋ ॥",
      "transliteration": "taa ke dhoom dhavaiaar par ddaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਰਾਜੇ) ਦੇ ਦੁਆਰ ਉਤੇ ਧੂਣੀ ਧੁੰਮਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "ता के धूम द्वार पर डारियो ॥",
      "sourceLineId": "133624",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਇਸਤ੍ਰੀ ਪੁਰਖ ਨ ਕਿਨੂੰ ਬਿਚਾਰਿਯੋ ॥੫॥",
      "transliteration": "eisatree purakh na kinoo(n) bichaariyo ||5||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਇਸਤਰੀ ਪੁਰਸ਼ ਨੇ (ਇਸ ਨੂੰ) ਨਾ ਵਿਚਾਰਿਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "इसत्री पुरख न किनूँ बिचारियो ॥५॥",
      "sourceLineId": "133625",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕੇਤਿਕ ਦਿਵਸ ਬੀਤ ਜਬ ਗਏ ॥",
      "transliteration": "ketik dhivas beet jab ge ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਕੁਝ ਦਿਨ ਬੀਤ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "केतिक दिवस बीत जब गए ॥",
      "sourceLineId": "133626",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਲਖਨ ਨਗਰ ਨਿਕਸਤ ਪ੍ਰਭ ਭਏ ॥",
      "transliteration": "lakhan nagar nikasat prabh bhe ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਾਜਾ ਨਗਰ ਵੇਖਣ ਲਈ ਨਿਕਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "लखन नगर निकसत प्रभ भए ॥",
      "sourceLineId": "133627",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਭਾਖਾ ਸੁਨਨ ਸਭਨ ਕੀ ਕਾਜਾ ॥",
      "transliteration": "bhaakhaa sunan sabhan kee kaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਦੀਆਂ ਗੱਲਾ ਸੁਣਨ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "भाखा सुनन सभन की काजा ॥",
      "sourceLineId": "133628",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਅਤਿਥ ਭੇਸ ਧਰਿ ਨਿਕਸਿਯੋ ਰਾਜਾ ॥੬॥",
      "transliteration": "atith bhes dhar nikasiyo raajaa ||6||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਸਾਧ ਦਾ ਭੇਖ ਧਾਰ ਕੇ ਨਿਕਲਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "अतिथ भेस धरि निकसियो राजा ॥६॥",
      "sourceLineId": "133629",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਤਿਨ ਤ੍ਰਿਯ ਭੇਸ ਅਤਿਥ ਕੋ ਧਰਿ ਕੈ ॥",
      "transliteration": "tin tiray bhes atith ko dhar kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਨੇ ਵੀ ਸਾਧ ਦਾ ਰੂਪ ਧਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "तिन तृय भेस अतिथ को धरि कै ॥",
      "sourceLineId": "133630",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਬਚਨ ਉਚਾਰਿਯੋ ਨ੍ਰਿਪਹਿ ਨਿਹਰਿ ਕੈ ॥",
      "transliteration": "bachan uchaariyo nirapeh nihar kai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਵੇਖ ਕੇ ਬਚਨ ਉਚਾਰੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "बचन उचारियो नृपहि निहरि कै ॥",
      "sourceLineId": "133631",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਕਹ ਭਯੋ ਰਾਜਾ ਮੂਰਖ ਮਤਿ ਕੌ ॥",
      "transliteration": "keh bhayo raajaa moorakh mat kau ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਮਤਿ ਵਾਲੇ ਰਾਜੇ ਨੂੰ ਕੀ ਹੋ ਗਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "कह भयो राजा मूरख मति कौ ॥",
      "sourceLineId": "133632",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਭਲੀ ਬੁਰੀ ਜਾਨਤ ਨਹਿ ਗਤਿ ਕੌ ॥੭॥",
      "transliteration": "bhalee buree jaanat neh gat kau ||7||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਚੰਗੇ ਮਾੜੇ ਦੀ ਸਥਿਤੀ ਨੂੰ ਸਮਝਦਾ ਹੀ ਨਹੀਂ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "भली बुरी जानत नहि गति कौ ॥७॥",
      "sourceLineId": "133633",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਦੁਰਾਚਾਰ ਰਾਨੀ ਜੁ ਕਮਾਵੈ ॥",
      "transliteration": "dhuraachaar raanee ju kamaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਰਾਣੀ ਬਹੁਤ ਦੁਰਾਚਾਰ ਕਰਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "दुराचार रानी जु कमावै ॥",
      "sourceLineId": "133634",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਤਾ ਕੇ ਧਾਮ ਨਿਤ੍ਯ ਨ੍ਰਿਪ ਜਾਵੈ ॥",
      "transliteration": "taa ke dhaam nitay nirap jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਰਾਜਾ ਨਿੱਤ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "ता के धाम नित्य नृप जावै ॥",
      "sourceLineId": "133635",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਜੜ ਇਹ ਲਖਤ ਮੋਰਿ ਹਿਤਕਾਰਨਿ ॥",
      "transliteration": "jaR ieh lakhat mor hitakaaran ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ (ਰਾਜਾ) ਇਹ ਸਮਝਦਾ ਹੈ (ਕਿ ਇਹ) ਮੇਰੇ ਨਾਲ ਹਿਤ ਕਰਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "जड़ इह लखत मोरि हितकारनि ॥",
      "sourceLineId": "133636",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਸੋ ਨਿਤ ਸੋਤ ਸੰਗ ਲੈ ਯਾਰਨਿ ॥੮॥",
      "transliteration": "so nit sot sa(n)g lai yaaran ||8||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਹ ਨਿੱਤ ਯਾਰਾ ਨੂੰ ਨਾਲ ਲੈ ਕੇ ਸੌਂਦੀ ਹੈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "सो नित सोत संग लै यारनि ॥८॥",
      "sourceLineId": "133637",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਨ੍ਰਿਪ ਯਹ ਧੁਨਿ ਸ੍ਰਵਨਨ ਸੁਨਿ ਪਾਈ ॥",
      "transliteration": "nirap yeh dhun sravanan sun paiee ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਰਾਜੇ ਨੇ ਇਹ ਗੱਲ ਕੰਨਾ ਨਾਲ ਸੁਣੀ",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "नृप यह धुनि स्रवनन सुनि पाई ॥",
      "sourceLineId": "133638",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਪੂਛਤ ਭਯੋ ਤਿਸੀ ਕਹ ਜਾਈ ॥",
      "transliteration": "poochhat bhayo tisee keh jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੂੰ ਜਾ ਕੇ ਪੁਛਣ ਲਗਾ,।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "पूछत भयो तिसी कह जाई ॥",
      "sourceLineId": "133639",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਅਥਿਤ ਨ੍ਰਿਪਤਿ ਹ੍ਯਾਂ ਦੋ ਕ੍ਯਾ ਕਰੈ ॥",
      "transliteration": "athit nirapat hayaa(n) dho kayaa karai ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸਾਧ ਜੀ! ਇਥੋਂ ਦਾ ਰਾਜਾ ਕੀ ਕਰੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "अथित नृपति ह्याँ दो क्या करै ॥",
      "sourceLineId": "133640",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਜੋ ਤੁਮ ਕਹਹੁ ਸੋ ਬਿਧਿ ਪਰਹਰੈ ॥੯॥",
      "transliteration": "jo tum kahahu so bidh paraharai ||9||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਤੁਸੀਂ ਕਹਿ ਰਹੇ ਹੋ, (ਉਸ ਨੂੰ) ਕਿਹੜੀ ਵਿਧੀ ਨਾਲ ਦੂਰ ਕਰੇ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "जो तुम कहहु सो बिधि परहरै ॥९॥",
      "sourceLineId": "133641",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1262_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਇਹ ਨ੍ਰਿਪ ਜੋਗ ਨ ਐਸੀ ਨਾਰੀ ॥",
      "transliteration": "eeh nirap jog na aaisee naaree ||",
      "translation": "",
      "punjabiViakhya": "(ਸਾਧ ਨੇ ਉੱਤਰ ਦਿੱਤਾ) ਇਸ ਰਾਜੇ ਜੋਗ ਅਜਿਹੀ ਨਾਰੀ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": "इह नृप जोग न ऐसी नारी ॥",
      "sourceLineId": "133642",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
