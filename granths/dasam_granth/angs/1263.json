{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1263,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1263_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚਹਿਯਤ ਹਨੀ ਕਿ ਤੁਰਤ ਨਿਕਾਰੀ ॥",
      "transliteration": "chahiyat hanee k turat nikaaree ||",
      "translation": "",
      "punjabiViakhya": "ਚਾਹੀਦਾ ਇਹ ਹੈ ਕਿ ਇਸ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ਜਾਵੇ ਜਾ ਤੁਰੰਤ ਕਢ ਦਿੱਤਾ ਜਾਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "चहियत हनी कि तुरत निकारी ॥",
      "sourceLineId": "133643",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਭਲੋ ਨ ਗਵਨ ਕਰੋ ਤਾ ਕੇ ਛਿਨ ॥",
      "transliteration": "bhalo na gavan karo taa ke chhin ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਗਾ ਇਹ ਹੈ ਕਿ ਉਸ ਕੋਲ ਛਿਣ ਭਰ ਲਈ ਵੀ ਨਾ ਜਾਇਆ ਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "भलो न गवन करो ता के छिन ॥",
      "sourceLineId": "133644",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੁਰਾਚਾਰ ਤ੍ਰਿਯ ਕਰਤ ਜੁ ਨਿਸ ਦਿਨ ॥੧੦॥",
      "transliteration": "dhuraachaar tiray karat ju nis dhin ||10||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਇਸਤਰੀ ਰਾਤ ਦਿਨ ਦੁਰਾਚਾਰ ਕਰਦੀ ਹੈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "दुराचार तृय करत जु निस दिन ॥१०॥",
      "sourceLineId": "133645",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਨ ਕੇ ਜੋਗ ਏਕ ਤ੍ਰਿਯ ਅਹੀ ॥",
      "transliteration": "ein ke jog ek tiray ahee ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਦੇ ਯੋਗ ਇਕ ਇਸਤਰੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "इन के जोग एक तृय अही ॥",
      "sourceLineId": "133646",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਏਕ ਸਾਹ ਕੇ ਜਾਈ ਕਹੀ ॥",
      "transliteration": "ek saeh ke jaiee kahee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਇਕ ਸ਼ਾਹ ਦੇ ਘਰ ਪੈਦਾ ਹੋਈ ਦਸੀ ਜਾਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "एक साह के जाई कही ॥",
      "sourceLineId": "133647",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜ੍ਯੋਂ ਇਹ ਨ੍ਰਿਪ ਪੁਰਖਨ ਕੋ ਰਾਜਾ ॥",
      "transliteration": "jayo(n) ieh nirap purakhan ko raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਇਹ ਰਾਜ ਪੁਰਸ਼ਾ ਦਾ ਰਾਜਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "ज्यों इह नृप पुरखन को राजा ॥",
      "sourceLineId": "133648",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤ੍ਰਯੋ ਵਹੁ ਨਾਰਿ ਤ੍ਰਿਯਨ ਸਿਰਤਾਜਾ ॥੧੧॥",
      "transliteration": "trayo vahu naar tirayan sirataajaa ||11||",
      "translation": "",
      "punjabiViakhya": "ਉਵੇਾਂ ਉਹ ਇਸਤਰੀ ਨਾਰੀਆਂ ਦੀ ਸਿਰਤਾਜ ਹੈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "त्रयो वहु नारि तृयन सिरताजा ॥११॥",
      "sourceLineId": "133649",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੌ ਵਾ ਕੌ ਰਾਜਾ ਗ੍ਰਿਹ ਲ੍ਯਾਵੈ ॥",
      "transliteration": "jau vaa kau raajaa gireh layaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਉਸ ਨੂੰ ਰਾਜਾ (ਆਪਣੇ) ਘਰ ਲੈ ਆਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "जौ वा कौ राजा गृह ल्यावै ॥",
      "sourceLineId": "133650",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰਾਜ ਪਾਟ ਤਬ ਸਕਲ ਸੁਹਾਵੈ ॥",
      "transliteration": "raaj paaT tab sakal suhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ (ਉਸ ਦਾ) ਸਾਰਾ ਰਾਜ-ਪਾਟ ਸ਼ੋਭਾਸ਼ਾਲੀ ਹੋ ਜਾਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "राज पाट तब सकल सुहावै ॥",
      "sourceLineId": "133651",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਾਹਿ ਲਖੇ ਤ੍ਰਿਯ ਸਭ ਦੁਰਿ ਜਾਹੀ ॥",
      "transliteration": "taeh lakhe tiray sabh dhur jaahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਸਾਰੀਆਂ ਇਸਤਰੀਆਂ ਲੁਕ ਜਾਣਗੀਆਂ (ਭਾਵ-ਹੀਣੀਆਂ ਹੋ ਜਾਣਗੀਆਂ)",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "ताहि लखे तृय सभ दुरि जाही ॥",
      "sourceLineId": "133652",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਮਿ ਉਡਗਨ ਰਵਿ ਕੀ ਪਰਛਾਹੀ ॥੧੨॥",
      "transliteration": "jim uddagan rav kee parachhaahee ||12||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਸੂਰਜ ਦੀ ਪਰਛਾਈ ਪੈਣ ਨਾਲ ਤਾਰੇ (ਛਿਪ ਜਾਦੇ ਹਨ) ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "जिमि उडगन रवि की परछाही ॥१२॥",
      "sourceLineId": "133653",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਬ ਰਾਜੈ ਇਹ ਬਿਧਿ ਸੁਨ ਪਾਯੋ ॥",
      "transliteration": "jab raajai ieh bidh sun paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "जब राजै इह बिधि सुन पायो ॥",
      "sourceLineId": "133654",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਇਹੈ ਮਤੋ ਜਿਯ ਮਾਝ ਪਕਾਯੋ ॥",
      "transliteration": "eihai mato jiy maajh pakaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮਨ ਵਿਚ ਇਹ ਵਿਚਾਰ ਪੱਕਾ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "इहै मतो जिय माझ पकायो ॥",
      "sourceLineId": "133655",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੁਰਾਚਾਰਿ ਇਸਤ੍ਰੀ ਪਰਹਰੌ ॥",
      "transliteration": "dhuraachaar isatree paraharau ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਦੁਰਾਚਾਰੀ ਇਸਤਰੀ ਨੂੰ ਤਿਆਗ ਦੇਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "दुराचारि इसत्री परहरौ ॥",
      "sourceLineId": "133656",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਿਜੁ ਤ੍ਰਿਯ ਸਾਹ ਸੁਤਾ ਲੈ ਕਰੌ ॥੧੩॥",
      "transliteration": "nij tiray saeh sutaa lai karau ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੀ ਇਸਤਰੀ ਵਜੋਂ ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਨੂੰ ਲੈ ਆਵੇ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "निजु तृय साह सुता लै करौ ॥१३॥",
      "sourceLineId": "133657",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪ੍ਰਾਤੈ ਕਾਲ ਧਾਮ ਜਬ ਆਯੋ ॥",
      "transliteration": "praatai kaal dhaam jab aayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਰਾਜਾ) ਸਵੇਰੇ ਘਰ ਨੂੰ ਆਇਆ ਤਾ ਲਾਗੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "प्रातै काल धाम जब आयो ॥",
      "sourceLineId": "133658",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨੇਗੀ ਮਹਤਨ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "transliteration": "negee mahatan bol paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੌਧਰੀਆਂ ਨੂੰ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "नेगी महतन बोलि पठायो ॥",
      "sourceLineId": "133659",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਾਹ ਸੁਤਾ ਜਿਹ ਤਿਹ ਬਿਧਿ ਲਈ ॥",
      "transliteration": "saeh sutaa jeh teh bidh liee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਸ਼ਾਹ ਦੀ ਧੀ ਪ੍ਰਾਪਤ ਕਰ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "साह सुता जिह तिह बिधि लई ॥",
      "sourceLineId": "133660",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਾਨੀ ਡਾਰਿ ਹ੍ਰਿਦੈ ਤੇ ਦਈ ॥੧੪॥",
      "transliteration": "raanee ddaar hiradhai te dhiee ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਨੂੰ ਦਿਲੋਂ ਕਢ ਦਿੱਤਾ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "रानी डारि हृदै ते दई ॥१४॥",
      "sourceLineId": "133661",
      "sourceShabadId": "12545",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "133662",
      "sourceShabadId": "12546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਤਹ ਚੰਚਲਾ ਤਾ ਕੋ ਚਰਿਤ ਦਿਖਾਇ ॥",
      "transliteration": "eeh charitr teh cha(n)chalaa taa ko charit dhikhai ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਚਰਿਤ ਉਸ ਇਸਤਰੀ ਨੇ ਉਸ (ਰਾਜੇ) ਨੂੰ ਵਿਖਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र तह चंचला ता को चरित दिखाइ ॥",
      "sourceLineId": "133663",
      "sourceShabadId": "12546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਿਜੁ ਤ੍ਰਿਯ ਸਾਥ ਤੁਰਾਇ ਤਿਹ ਆਪਨ ਭਜ੍ਯੋ ਬਨਾਇ ॥੧੫॥",
      "transliteration": "nij tiray saath turai teh aapan bhajayo banai ||15||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਆਪਣੀ ਇਸਤਰੀ ਨਾਲੋਂ ਤੋੜ ਦਿੱਤਾ ਅਤੇ ਆਪ ਉਸ ਨਾਲ ਸੰਯੋਗ ਸੁਖ ਮਾਣਨ ਲਗੀ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "निजु तृय साथ तुराइ तिह आपन भज्यो बनाइ ॥१५॥",
      "sourceLineId": "133664",
      "sourceShabadId": "12546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚੌਦਹ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੧੪॥੫੯੭੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau chauadheh charitr samaapatam sat subham sat ||314||5973||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੧੪ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੧੪॥੫੯੭੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ चौदह चरित्र समापतम सतु सुभम सतु ॥३१४॥५९७३॥अफजूँ॥",
      "sourceLineId": "133665",
      "sourceShabadId": "12546",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133666",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਹਿਰ ਇਟਾਵਾ ਗੰਗ ਤੀਰ ਜਹ ॥",
      "transliteration": "sahir iTaavaa ga(n)g teer jeh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਗੰਗਾ ਨਦੀ ਦੇ ਕੰਢੇ ਇਟਾਵਾ ਨਗਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "सहिर इटावा गंग तीर जह ॥",
      "sourceLineId": "133667",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਾਲ ਸੁ ਪਛਿਮ ਹੁਤੇ ਨ੍ਰਿਪਤਿ ਤਹ ॥",
      "transliteration": "paal su pachhim hute nirapat teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਪਛਿਮ ਪਾਲ ਨਾ ਦਾ ਰਾਜਾ ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "पाल सु पछिम हुते नृपति तह ॥",
      "sourceLineId": "133668",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਾਰਿ ਸੁ ਪਛਿਮ ਦੇ ਤਾ ਕੇ ਘਰ ॥",
      "transliteration": "naar su pachhim dhe taa ke ghar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਪਛਿਮ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "नारि सु पछिम दे ता के घर ॥",
      "sourceLineId": "133669",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੁਰੀ ਨਾਗਨੀ ਨਰੀ ਨ ਸਰਬਰ ॥੧॥",
      "transliteration": "suree naaganee naree na sarabar ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਸਮਾਨ ਕੋਈ ਦੇਵਤਾ, ਨਾਗ ਜਾ ਮਨੁੱਖ (ਨਰ) ਇਸਤਰੀ ਨਹੀਂ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "सुरी नागनी नरी न सरबर ॥१॥",
      "sourceLineId": "133670",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਾਢੀ ਏਕ ਰਾਨਿਯਹਿ ਹੇਰਾ ॥",
      "transliteration": "baaddee ek raaniyeh heraa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ (ਇਕ ਵਾਰ) ਇਕ ਬਾਢੀ (ਤਰਖਾਣ) ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "बाढी एक रानियहि हेरा ॥",
      "sourceLineId": "133671",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਦਨ ਦੇਹ ਤਬ ਹੀ ਤਿਹ ਘੇਰਾ ॥",
      "transliteration": "madhan dheh tab hee teh gheraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਉਸ ਦੀ ਦੇਹ ਨੂੰ ਕਾਮ ਦੇਵ ਨੇ ਘੇਰ ਲਿਆ (ਅਰਥਾਤ ਕਾਮ ਨਾਲ ਆਤੁਰ ਹੋ ਗਈ)।",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "मदन देह तब ही तिह घेरा ॥",
      "sourceLineId": "133672",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਧਿਕ ਨੇਹ ਤਿਹ ਸਾਥ ਬਢਾਯੋ ॥",
      "transliteration": "adhik neh teh saath baddaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ (ਰਾਣੀ ਨੇ) ਬਹੁਤ ਪ੍ਰੇਮ ਵਧਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "अधिक नेह तिह साथ बढायो ॥",
      "sourceLineId": "133673",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਰਾਜਾ ਕੋ ਚਿਤ ਤੇ ਬਿਸਰਾਯੋ ॥੨॥",
      "transliteration": "raajaa ko chit te bisaraayo ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੂੰ ਚਿਤ ਤੋਂ ਭੁਲਾ ਦਿੱਤਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "राजा को चित ते बिसरायो ॥२॥",
      "sourceLineId": "133674",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਐਸੀ ਰਸਿਗੀ ਤਾ ਸੌ ਨਾਰੀ ॥",
      "transliteration": "aaisee rasigee taa sau naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ (ਉਹ) ਇਸਤਰੀ ਅਜਿਹੀ ਲੀਨ ਹੋ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "ऐसी रसिगी ता सौ नारी ॥",
      "sourceLineId": "133675",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਾ ਤੇ ਪਤਿ ਤਨ ਪ੍ਰੀਤਿ ਬਿਸਾਰੀ ॥",
      "transliteration": "jaa te pat tan preet bisaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਉਸ ਨੇ ਪਤੀ ਦੀ ਪ੍ਰੀਤ ਨੂੰ ਭੁਲਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "जा ते पति तन प्रीति बिसारी ॥",
      "sourceLineId": "133676",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗੇਰੂ ਘੋਰਿ ਪਾਨ ਕਰਿ ਲੀਯੋ ॥",
      "transliteration": "geroo ghor paan kar leeyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਇਕ ਦਿਨ) ਗੇਰੂ ਘੋਲ ਕੇ ਪੀ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "गेरू घोरि पान करि लीयो ॥",
      "sourceLineId": "133677",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮੁਖ ਤੇ ਡਾਰਿ ਲਖਤ ਨ੍ਰਿਪ ਦੀਯੋ ॥੩॥",
      "transliteration": "mukh te ddaar lakhat nirap dheeyo ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਦੇ ਵੇਖਦੇ ਹੋਇਆਂ ਮੂੰਹੋਂ ਕਢ (ਉਲਟ) ਦਿੱਤੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "मुख ते डारि लखत नृप दीयो ॥३॥",
      "sourceLineId": "133678",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਾਨਾ ਸ੍ਰੋਣ ਬਦਨ ਤੇ ਬਮਾ ॥",
      "transliteration": "jaanaa sron badhan te bamaa ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਸਮਝਿਆ (ਕਿ ਉਸ ਨੇ) ਮੂੰਹ ਤੋਂ ਲਹੂ ਦੀ ਉਲਟੀ ਕੀਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "जाना स्रोण बदन ते बमा ॥",
      "sourceLineId": "133679",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨ੍ਰਿਪ ਮਨ ਮੈ ਇਹ ਸੂਲ ਨ ਛਮਾ ॥",
      "transliteration": "nirap man mai ieh sool na chhamaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਤੋਂ ਇਹ ਦੁਖ (ਸੂਲ) ਨਾ ਸਹਾਰਿਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "नृप मन मै इह सूल न छमा ॥",
      "sourceLineId": "133680",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਤਿ ਆਤੁਰ ਹ੍ਵੈ ਬੈਦ ਬੁਲਾਏ ॥",
      "transliteration": "at aatur havai baidh bulaae ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਆਤੁਰ ਹੋ ਕੇ (ਉਸ ਨੇ) ਵੈਦ ਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "अति आतुर ह्वै बैद बुलाए ॥",
      "sourceLineId": "133681",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚਿਹਨ ਰੋਗ ਤਿਹ ਨਾਰਿ ਸੁਨਾਏ ॥੪॥",
      "transliteration": "chihan rog teh naar sunaae ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਵੈਦ ਨੂੰ) ਉਸ ਨਾਰੀ ਦੇ ਰੋਗ ਦੇ ਚਿੰਨ੍ਰਹ ਦਸੇ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "चिहन रोग तिह नारि सुनाए ॥४॥",
      "sourceLineId": "133682",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਬ ਤਿਨ ਪੀ ਗੇਰੂ ਪੁਨਿ ਡਾਰਾ ॥",
      "transliteration": "tab tin pee geroo pun ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ (ਇਸਤਰੀ) ਨੇ ਫਿਰ ਗੇਰੂ ਪੀ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "तब तिन पी गेरू पुनि डारा ॥",
      "sourceLineId": "133683",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸ੍ਰੋਣ ਬਮਾ ਸਭਹੂਨ ਬਿਚਾਰਾ ॥",
      "transliteration": "sron bamaa sabhahoon bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਸਭ ਨੇ ਲਹੂ ਦੀ ਉਲਟੀ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "स्रोण बमा सभहून बिचारा ॥",
      "sourceLineId": "133684",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਬ ਪਤਿ ਸੋ ਇਮ ਨਾਰਿ ਉਚਾਰੋ ॥",
      "transliteration": "tab pat so im naar uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਇਸਤਰੀ ਨੇ ਪਤੀ ਨੂੰ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "तब पति सो इम नारि उचारो ॥",
      "sourceLineId": "133685",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਬ ਰਾਨੀ ਕਹ ਮਰੀ ਬਿਚਾਰੋ ॥੫॥",
      "transliteration": "ab raanee keh maree bichaaro ||5||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਰਾਣੀ ਨੂੰ ਮਰਿਆ ਹੀ ਸਮਝੋ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "अब रानी कह मरी बिचारो ॥५॥",
      "sourceLineId": "133686",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰਾਨੀ ਕਹਤ ਨ੍ਰਿਪਤਿ ਸੋ ਕਰਿਯਹੁ ॥",
      "transliteration": "raanee kahat nirapat so kariyahu ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਰਾਜੇ ਨੂੰ ਕਹਿਣ ਲਗੀ ਕਿ (ਤੁਸੀਂ) (ਜੋ ਮੈਂ ਕਿਹਾ ਹੈ) ਉਹੀ ਕਰਨਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "रानी कहत नृपति सो करियहु ॥",
      "sourceLineId": "133687",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮੇਰੋ ਬਹੁਰਿ ਨ ਬਦਨ ਨਿਹਰਿਯਹੁ ॥",
      "transliteration": "mero bahur na badhan nihariyahu ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰਾ ਮੂੰਹ ਫਿਰ ਨਾ ਵੇਖਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "मेरो बहुरि न बदन निहरियहु ॥",
      "sourceLineId": "133688",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਔਰ ਸਖੀ ਕਾਹੂ ਨ ਦਿਖੈਯੋ ॥",
      "transliteration": "aauar sakhee kaahoo na dhikhaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ ਕਿਸੇ ਸਖੀ ਨੂੰ ਵੀ ਨਹੀਂ ਵਿਖਾਉਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1263,
      "hindi": "",
      "hindiTransliteration": "और सखी काहू न दिखैयो ॥",
      "sourceLineId": "133689",
      "sourceShabadId": "12547",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1263_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਾਨੀ ਜਾਇ ਜਾਰ ਘਰਿ ਐਯੋ ॥੬॥",
      "transliteration": "raanee jai jaar ghar aaiyo ||6||",
      "translation": "",
