{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1265,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1265_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਾਸ ਘੂਟਿ ਜਨੁ ਕਰਿ ਮਰਿ ਗਈ ॥",
      "transliteration": "saas ghooT jan kar mar giee ||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਹੈ) ਮਾਨੋ ਸਾਹ ਘੁਟ ਕੇ ਮਰ ਗਈ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "सास घूटि जनु करि मरि गई ॥",
      "sourceLineId": "133739",
      "sourceShabadId": "12548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਖਿਯਨ ਲਪਿਟਿ ਬਸਤ੍ਰ ਮਹਿ ਲਈ ॥੭॥",
      "transliteration": "sakhiyan lapiT basatr meh liee ||7||",
      "translation": "",
      "punjabiViakhya": "ਸਖੀਆਂ ਨੇ ਉਸ ਨੂੰ ਬਸਤ੍ਰਾ ਵਿਚ ਲਪੇਟ ਲਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "सखियन लपिटि बसत्र महि लई ॥७॥",
      "sourceLineId": "133740",
      "sourceShabadId": "12548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਕਰੀ ਬਾਧਿ ਸਿਰ੍ਰਹੀ ਮਧਿ ਦੀਨੀ ॥",
      "transliteration": "bakaree baadh sirrahee madh dheenee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਸਿੜ੍ਰਹੀ (ਅਰਥੀ ਦੇ ਤਖਤੇ) ਵਿਚ ਬਕਰੀ ਬੰਨ੍ਰਹ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "बकरी बाधि सिर्रही मधि दीनी ॥",
      "sourceLineId": "133741",
      "sourceShabadId": "12548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਛੋਰ ਬਸਤ੍ਰ ਪਿਤੁ ਮਾਤ ਨ ਚੀਨੀ ॥",
      "transliteration": "chhor basatr pit maat na cheenee ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਤਾ ਪਿਤਾ ਨੇ ਵੀ ਕਪੜਾ ਚੁਕ ਕੇ ਨਾ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "छोर बसत्र पितु मात न चीनी ॥",
      "sourceLineId": "133742",
      "sourceShabadId": "12548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੁਹੂੰ ਸੁਤਾ ਕੋ ਬਚਨ ਸੰਭਾਰਾ ॥",
      "transliteration": "dhuhoo(n) sutaa ko bachan sa(n)bhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੇ ਪੁੱਤਰੀ ਦਾ ਬਚਨ ਯਾਦ ਰਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "दुहूँ सुता को बचन संभारा ॥",
      "sourceLineId": "133743",
      "sourceShabadId": "12548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਲ ਕੇ ਮਾਝ ਬਕਰਿਯਹਿ ਜਾਰਾ ॥੮॥",
      "transliteration": "sal ke maajh bakariyeh jaaraa ||8||",
      "translation": "",
      "punjabiViakhya": "ਚਿੱਤਾ ('ਸਲ') ਵਿਚ ਬਕਰੀ ਨੂੰ ਸਾੜ ਦਿੱਤਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "सल के माझ बकरियहि जारा ॥८॥",
      "sourceLineId": "133744",
      "sourceShabadId": "12548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗਈ ਜਾਰ ਸੰਗ ਰਾਜ ਕੁਮਾਰੀ ॥",
      "transliteration": "giee jaar sa(n)g raaj kumaaree ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਯਾਰ ਨਾਲ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "गई जार संग राज कुमारी ॥",
      "sourceLineId": "133745",
      "sourceShabadId": "12548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਕਿਨੀ ਨ ਬਿਚਾਰੀ ॥",
      "transliteration": "bhedh abhedh kinee na bichaaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਵੀ ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਾ ਵਿਚਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद किनी न बिचारी ॥",
      "sourceLineId": "133746",
      "sourceShabadId": "12548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੁਹਿਤਾ ਮਰੀ ਜਾਰਿ ਜਨੁ ਦੀਨੀ ॥",
      "transliteration": "dhuhitaa maree jaar jan dheenee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਪੁੱਤਰੀ ਨੂੰ ਮਰਿਆ ਜਾਣ ਕੇ ਸਾੜ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "दुहिता मरी जारि जनु दीनी ॥",
      "sourceLineId": "133747",
      "sourceShabadId": "12548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤ੍ਰਿਯ ਚਰਿਤ੍ਰ ਕੀ ਕ੍ਰਿਯਾ ਨ ਚੀਨੀ ॥੯॥",
      "transliteration": "tiray charitr kee kirayaa na cheenee ||9||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਇਸਤਰੀ ਦੇ ਚਰਿਤ੍ਰ ਦੀ ਗਤੀ ਨੂੰ ਨਾ ਸਮਝਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "तृय चरित्र की कृया न चीनी ॥९॥",
      "sourceLineId": "133748",
      "sourceShabadId": "12548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸੋਲਹ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੧੬॥੫੯੯੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau soleh charitr samaapatam sat subham sat ||316||5993||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੧੫ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੧੬॥੫੯੯੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ सोलह चरित्र समापतम सतु सुभम सतु ॥३१६॥५९९३॥अफजूँ॥",
      "sourceLineId": "133749",
      "sourceShabadId": "12548",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133750",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮੰਤ੍ਰੀ ਕਥਾ ਉਚਾਰੀ ਔਰੈ ॥",
      "transliteration": "ma(n)tree kathaa uchaaree aauarai ||",
      "translation": "",
      "punjabiViakhya": "ਮੰਤ੍ਰੀ ਨੇ ਹੋਰ ਕਥਾ ਦਾ ਬਖਾਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "मंत्री कथा उचारी औरै ॥",
      "sourceLineId": "133751",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਾਜਾ ਦੇਸ ਬੰਗਲਾ ਗੌਰੈ ॥",
      "transliteration": "raajaa dhes ba(n)galaa gauarai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਬੰਗਲਾ ਦੇਸ ਦਾ (ਇਕ) ਗੌੜ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "राजा देस बंगला गौरै ॥",
      "sourceLineId": "133752",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਮਨ ਪ੍ਰਭਾ ਤਾ ਕੀ ਪਟਰਾਨੀ ॥",
      "transliteration": "saman prabhaa taa kee paTaraanee ||",
      "translation": "",
      "punjabiViakhya": "ਸਮਨ ਪ੍ਰਭਾ ਉਸ ਦੀ ਪਟਰਾਣੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "समन प्रभा ता की पटरानी ॥",
      "sourceLineId": "133753",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਿਹ ਸਮ ਸੁਨੀ ਨ ਕਿਨੀ ਬਖਾਨੀ ॥੧॥",
      "transliteration": "jeh sam sunee na kinee bakhaanee ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਨਾ (ਕੋਈ ਹੋਰ) ਸੁਣੀ ਹੈ ਅਤੇ ਨਾ ਹੀ ਕਿਸੇ ਦਸੀ ਹੈ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "जिह सम सुनी न किनी बखानी ॥१॥",
      "sourceLineId": "133754",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪੁਹਪ ਪ੍ਰਭਾ ਇਕ ਰਾਜ ਦੁਲਾਰੀ ॥",
      "transliteration": "puhap prabhaa ik raaj dhulaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੀ) ਪੁਹਪ ਪ੍ਰਭਾ ਨਾ ਦੀ ਇਕ ਪੁੱਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "पुहप प्रभा इक राज दुलारी ॥",
      "sourceLineId": "133755",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਹੁਰਿ ਬਿਧਾਤਾ ਤਸਿ ਨ ਸਵਾਰੀ ॥",
      "transliteration": "bahur bidhaataa tas na savaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ ਵਿਧਾਤਾ ਨੇ ਹੋਰ ਨਹੀਂ ਬਣਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "बहुरि बिधाता तसि न सवारी ॥",
      "sourceLineId": "133756",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਾ ਕੀ ਆਭਾ ਜਾਤ ਨ ਕਹੀ ॥",
      "transliteration": "taa kee aabhaa jaat na kahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "ता की आभा जात न कही ॥",
      "sourceLineId": "133757",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਨੁ ਕਰਿ ਫੂਲਿ ਅਬਾਸੀ ਰਹੀ ॥੨॥",
      "transliteration": "jan kar fool abaasee rahee ||2||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦੀ ਸੀ) ਮਾਨੋ ਗੁਲਬਾਸੀ ਖਿੜੀ ਹੋਵੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "जनु करि फूलि अबासी रही ॥२॥",
      "sourceLineId": "133758",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭੂਮਿ ਗਿਰੀ ਤਾ ਕੀ ਸੁੰਦ੍ਰਾਈ ॥",
      "transliteration": "bhoom giree taa kee su(n)dhraiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਧਰਤੀ ਉਤੇ ਵਿਛੀ ਪਈ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "भूमि गिरी ता की सुँद्राई ॥",
      "sourceLineId": "133759",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਾ ਤੇ ਅਬਾਸੀ ਲਈ ਲਲਾਈ ॥",
      "transliteration": "taa te abaasee liee lalaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਮਾਨੋ) ਉਸ ਤੋਂ ਗੁਲਬਾਸੀ ਨੇ ਲਾਲੀ ਲਈ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "ता ते अबासी लई ललाई ॥",
      "sourceLineId": "133760",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗਾਲ੍ਰਹਨ ਤੇ ਜੋ ਰਸ ਚੁਇ ਪਰਾ ॥",
      "transliteration": "gaalrahan te jo ras chui paraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀਆਂ) ਗਲ੍ਰਹਾ ਤੋਂ ਜੋ ਰਸ ਚੋਇਆ ਹੋਇਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "गाल्रहन ते जो रस चुइ परा ॥",
      "sourceLineId": "133761",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭਯੋ ਗੁਲਾਬ ਤਿਸੀ ਤੇ ਹਰਾ ॥੩॥",
      "transliteration": "bhayo gulaab tisee te haraa ||3||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਤੋਂ ਗੁਲਾਬ ਹਰਾ ਭਰਾ ਹੋਇਆ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "भयो गुलाब तिसी ते हरा ॥३॥",
      "sourceLineId": "133762",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜੋਬਨ ਜਬ ਆਯੋ ਅੰਗ ਤਾ ਕੇ ॥",
      "transliteration": "joban jab aayo a(n)g taa ke ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਉਸ ਦੇ ਸ਼ਰੀਰ ਵਿਚ ਜੋਬਨ ਆਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "जोबन जब आयो अंग ता के ॥",
      "sourceLineId": "133763",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਾਹ ਏਕ ਆਯੌ ਤਬ ਵਾ ਕੇ ॥",
      "transliteration": "saeh ek aayau tab vaa ke ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਪਾਸ ਇਕ ਸ਼ਾਹ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "साह एक आयौ तब वा के ॥",
      "sourceLineId": "133764",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਏਕ ਪੁਤ੍ਰ ਸੁੰਦਰਿ ਤਿਹ ਸੰਗਾ ॥",
      "transliteration": "ek putr su(n)dhar teh sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਸ਼ਾਹ) ਨਾਲ ਇਕ ਸੁੰਦਰ ਪੁੱਤਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "एक पुत्र सुँदरि तिह संगा ॥",
      "sourceLineId": "133765",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਨ ਮਨਸਾ ਦ੍ਵੈ ਜਏ ਅਨੰਗਾ ॥੪॥",
      "transliteration": "jan manasaa dhavai je ana(n)gaa ||4||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਮਨਸਾ ਨੂੰ ਦੋ ਕਾਮ ਦੇਵਾ ਨੂੰ ਜਨਮ ਦਿੱਤਾ ਹੋਵੇ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "जन मनसा द्वै जए अनंगा ॥४॥",
      "sourceLineId": "133766",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗਾਜੀ ਰਾਇ ਨਾਮ ਤਿਹ ਨਰ ਕੋ ॥",
      "transliteration": "gaajee rai naam teh nar ko ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਬੰਦੇ ਦਾ ਨਾ ਗਾਜੀ ਰਾਇ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "गाजी राइ नाम तिह नर को ॥",
      "sourceLineId": "133767",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕੰਕਨ ਜਾਨ ਕਾਮ ਕੇ ਕਰ ਕੋ ॥",
      "transliteration": "ka(n)kan jaan kaam ke kar ko ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਕਾਮ ਦੇਵ ਦੇ ਹੱਥ ਦਾ ਕੜਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "कंकन जान काम के कर को ॥",
      "sourceLineId": "133768",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭੂਖਨ ਕੋ ਭੂਖਨ ਤਿਹ ਮਾਨੋ ॥",
      "transliteration": "bhookhan ko bhookhan teh maano ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਗਹਿਣਿਆਂ ਨੂੰ ਸਜਾਉਣ ਵਾਲਾ ਮਨੋ",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "भूखन को भूखन तिह मानो ॥",
      "sourceLineId": "133769",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੂਖਨ ਕੋ ਦੂਖਨ ਪਹਿਚਾਨੋ ॥੫॥",
      "transliteration": "dhookhan ko dhookhan pahichaano ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਖੀਆਂ ਨੂੰ ਦੁਖੀ ਕਰਨ ਵਾਲਾ ਸਮਝੋ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "दूखन को दूखन पहिचानो ॥५॥",
      "sourceLineId": "133770",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪੁਹਪ ਪ੍ਰਭਾ ਤਾ ਕੋ ਜਬ ਲਹਾ ॥",
      "transliteration": "puhap prabhaa taa ko jab lahaa ||",
      "translation": "",
      "punjabiViakhya": "ਪੁਹਪ ਪ੍ਰਭਾ ਨੇ ਜਦੋਂ ਉਸ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "पुहप प्रभा ता को जब लहा ॥",
      "sourceLineId": "133771",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮਨ ਬਚ ਕ੍ਰਮ ਐਸੇ ਕਰ ਕਹਾ ॥",
      "transliteration": "man bach kram aaise kar kahaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮਨ ਬਚ ਕਰਮ ਕਰ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "मन बच क्रम ऐसे कर कहा ॥",
      "sourceLineId": "133772",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਐਸਿ ਕਰੌ ਮੈ ਕਵਨ ਉਪਾਈ ॥",
      "transliteration": "aais karau mai kavan upaiee ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਅਜਿਹਾ ਕਿਹੜਾ ਉਪਾ ਕਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "ऐसि करौ मै कवन उपाई ॥",
      "sourceLineId": "133773",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮੋਰਿ ਇਹੀ ਸੰਗ ਹੋਇ ਸਗਾਈ ॥੬॥",
      "transliteration": "mor ihee sa(n)g hoi sagaiee ||6||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮੇਰੀ ਇਸ ਨਾਲ ਮੰਗਣੀ ਹੋ ਜਾਏ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "मोरि इही संग होइ सगाई ॥६॥",
      "sourceLineId": "133774",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪ੍ਰਾਤਹਿ ਕਾਲ ਸੁਯੰਬਰ ਕਿਯਾ ॥",
      "transliteration": "praateh kaal suya(n)bar kiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੇਰ ਵੇਲੇ ਹੀ ਉਸ ਨੇ ਸੁਅੰਬਰ ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "प्रातहि काल सुयंबर किया ॥",
      "sourceLineId": "133775",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕੁੰਕਮ ਡਾਰਿ ਤਿਸੀ ਪਰ ਦਿਯਾ ॥",
      "transliteration": "ku(n)kam ddaar tisee par dhiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸੇ ਉਤੇ ਕੇਸਰ ਪਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "कुँकम डारि तिसी पर दिया ॥",
      "sourceLineId": "133776",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਰੁ ਪੁਹਪਨ ਤੈ ਡਾਰਿਸਿ ਹਾਰਾ ॥",
      "transliteration": "ar puhapan tai ddaaris haaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫੁਲਾ ਦਾ ਹਾਰ ਵੀ ਪਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "अरु पुहपन तै डारिसि हारा ॥",
      "sourceLineId": "133777",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹੇਰਿ ਰਹੇ ਮੁਖ ਭੂਪ ਅਪਾਰਾ ॥੭॥",
      "transliteration": "her rahe mukh bhoop apaaraa ||7||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ ਅਨੇਕਾ ਰਾਜੇ ਮੂੰਹ ਵੇਖਦੇ ਰਹਿ ਗਏ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "हेरि रहे मुख भूप अपारा ॥७॥",
      "sourceLineId": "133778",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਿਹ ਨ੍ਰਿਪ ਸੁਤ ਸਭਹੂੰ ਕਰਿ ਜਾਨਾ ॥",
      "transliteration": "teh nirap sut sabhahoo(n) kar jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਨੇ ਉਸ ਨੂੰ ਰਾਜ-ਕੁਮਾਰ ਸਮਝ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "तिह नृप सुत सभहूँ करि जाना ॥",
      "sourceLineId": "133779",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਾਹ ਪੁਤ੍ਰ ਕਿਨਹੂੰ ਨ ਪਛਾਨਾ ॥",
      "transliteration": "saeh putr kinahoo(n) na pachhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਾਹ ਦਾ ਪੁੱਤਰ ਕਿਸੇ ਨੇ ਨਾ ਪਛਾਣਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "साह पुत्र किनहूँ न पछाना ॥",
      "sourceLineId": "133780",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮਾਤ ਪਿਤਾ ਨਹਿ ਭੇਦ ਬਿਚਰਾ ॥",
      "transliteration": "maat pitaa neh bhedh bicharaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਤਾ ਪਿਤਾ ਨੇ ਵੀ ਭੇਦ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "मात पिता नहि भेद बिचरा ॥",
      "sourceLineId": "133781",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇਹ ਛਲ ਕੁਅਰਿ ਸਭਨ ਕਹ ਛਰਾ ॥੮॥",
      "transliteration": "eeh chhal kuar sabhan keh chharaa ||8||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਸਭ ਨੂੰ ਛਲ ਲਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "इह छल कुअरि सभन कह छरा ॥८॥",
      "sourceLineId": "133782",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸਤ੍ਰਹ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੧੭॥੬੦੦੧॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau satreh charitr samaapatam sat subham sat ||317||6001||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੧੭ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੧੭॥੬੦੦੧॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ सत्रह चरित्र समापतम सतु सुभम सतु ॥३१७॥६००१॥अफजूँ॥",
      "sourceLineId": "133783",
      "sourceShabadId": "12549",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133784",
      "sourceShabadId": "12550",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮਰਗਜ ਸੈਨ ਹੁਤੋ ਇਕ ਨ੍ਰਿਪ ਬਰ ॥",
      "transliteration": "maragaj sain huto ik nirap bar ||",
      "translation": "",
      "punjabiViakhya": "ਮਰਗਜ ਸੈਨ ਨਾ ਦਾ ਇਕ ਚੰਗਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1265,
      "hindi": "",
      "hindiTransliteration": "मरगज सैन हुतो इक नृप बर ॥",
      "sourceLineId": "133785",
      "sourceShabadId": "12550",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1265_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮਰਗਜ ਦੇਇ ਨਾਰਿ ਜਾ ਕੇ ਘਰ ॥",
      "transliteration": "maragaj dhei naar jaa ke ghar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਮਰਗਜ ਦੇਈ ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1265,
