{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1266,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1266_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰੂਪਵਾਨ ਧਨਵਾਨ ਬਿਸਾਲਾ ॥",
      "transliteration": "roopavaan dhanavaan bisaalaa ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ) ਬਹੁਤ ਰੂਪਵਾਨ ਅਤੇ ਧਨਵਾਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "रूपवान धनवान बिसाला ॥",
      "sourceLineId": "133787",
      "sourceShabadId": "12550",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਭਿਛਕ ਕਲਪਤਰੁ ਦ੍ਰੁਜਨਨ ਕਾਲਾ ॥੧॥",
      "transliteration": "bhichhak kalapatar dhrujanan kaalaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਮੰਗਤਿਆਂ ਲਈ ਉਹ ਕਲਪਤਰੂ (ਦੇ ਸਮਾਨ) ਸੀ ਅਤੇ ਦੁਰਜਨਾ ਲਈ ਕਾਲ (ਦਾ ਹੀ ਰੂਪ ਸੀ) ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "भिछक कलपतरु द्रुजनन काला ॥१॥",
      "sourceLineId": "133788",
      "sourceShabadId": "12550",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮੂੰਗੀ ਪਟਨਾ ਦੇਸ ਤਵਨ ਕੋ ॥",
      "transliteration": "moo(n)gee paTanaa dhes tavan ko ||",
      "translation": "",
      "punjabiViakhya": "ਮੂੰਗੀ ਪਟਨ ਉਸ ਦਾ ਦੇਸ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "मूँगी पटना देस तवन को ॥",
      "sourceLineId": "133789",
      "sourceShabadId": "12550",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੀਤਿ ਕਵਨ ਰਿਪੁ ਸਕਤ ਜਵਨ ਕੋ ॥",
      "transliteration": "jeet kavan rip sakat javan ko ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਕੋਈ ਵੈਰੀ ਵੀ ਜਿਤ ਨਹੀਂ ਸਕਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "जीति कवन रिपु सकत जवन को ॥",
      "sourceLineId": "133790",
      "sourceShabadId": "12550",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਪ੍ਰਮਾਨ ਤਿਹ ਪ੍ਰਭਾ ਬਿਰਾਜੈ ॥",
      "transliteration": "apramaan teh prabhaa biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪ੍ਰਭਾ ਅਸੀਮ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "अप्रमान तिह प्रभा बिराजै ॥",
      "sourceLineId": "133791",
      "sourceShabadId": "12550",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੁਰ ਨਰ ਨਾਗ ਅਸੁਰ ਮਨ ਲਾਜੈ ॥੨॥",
      "transliteration": "sur nar naag asur man laajai ||2||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ ਸਾਹਮਣੇ) ਦੇਵਤੇ, ਮਨੁੱਖ, ਨਾਗ ਅਤੇ ਦੈਂਤ ਮਨ ਵਿਚ ਲਜਿਤ ਹੁੰਦੇ ਸਨ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "सुर नर नाग असुर मन लाजै ॥२॥",
      "sourceLineId": "133792",
      "sourceShabadId": "12550",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਏਕ ਪੁਰਖ ਰਾਨੀ ਲਖਿ ਪਾਯੋ ॥",
      "transliteration": "ek purakh raanee lakh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਇਕ ਪੁਰਸ਼ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "एक पुरख रानी लखि पायो ॥",
      "sourceLineId": "133793",
      "sourceShabadId": "12550",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤੇਜਮਾਨ ਗੁਨਮਾਨ ਸਵਾਯੋ ॥",
      "transliteration": "tejamaan gunamaan savaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ ਰਾਜੇ ਤੋਂ) ਗੁਣ ਅਤੇ ਤੇਜ ਵਿਚ ਸਵਾਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "तेजमान गुनमान सवायो ॥",
      "sourceLineId": "133794",
      "sourceShabadId": "12550",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪੁਹਪ ਰਾਜ ਜਨੁ ਮਧਿ ਪੁਹਪਨ ਕੇ ॥",
      "transliteration": "puhap raaj jan madh puhapan ke ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮਾਨੋ ਫੁਲਾ ਵਿਚੋਂ ਉਤਮ ਫੁਲ ਹੋਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "पुहप राज जनु मधि पुहपन के ॥",
      "sourceLineId": "133795",
      "sourceShabadId": "12550",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚੋਰਿ ਲੇਤਿ ਜਨੁ ਚਿਤ ਇਸਤ੍ਰਿਨ ਕੇ ॥੩॥",
      "transliteration": "chor let jan chit isatiran ke ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸਤਰੀਆਂ ਦਾ ਮਾਨੋ ਚਿਤ ਚੁਰਾਉਣ ਵਾਲਾ ਹੋਵੇ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "चोरि लेति जनु चित इसतृन के ॥३॥",
      "sourceLineId": "133796",
      "sourceShabadId": "12550",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੋਰਠਾ ॥",
      "transliteration": "soraThaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੋਰਠਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "सोरठा ॥",
      "sourceLineId": "133797",
      "sourceShabadId": "12551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਾਨੀ ਲਯੋ ਬੁਲਾਇ ਤਵਨ ਪੁਰਖ ਅਪਨੇ ਸਦਨ ॥",
      "transliteration": "raanee layo bulai tavan purakh apane sadhan ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਉਸ ਪੁਰਸ਼ ਨੂੰ ਆਪਣੇ ਘਰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "रानी लयो बुलाइ तवन पुरख अपने सदन ॥",
      "sourceLineId": "133798",
      "sourceShabadId": "12551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਤਿ ਰੁਚਿ ਅਧਿਕ ਬਢਾਇ ਤਾ ਸੌ ਰਤਿ ਮਾਨਤ ਭਈ ॥੪॥",
      "transliteration": "at ruch adhik baddai taa sau rat maanat bhiee ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਰੁਚੀ ਵਧਾ ਕੇ ਉਸ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "अति रुचि अधिक बढाइ ता सौ रति मानत भई ॥४॥",
      "sourceLineId": "133799",
      "sourceShabadId": "12551",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133800",
      "sourceShabadId": "12552",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਬ ਲਗਿ ਨਾਥ ਧਾਮ ਤਿਹ ਆਯੋ ॥",
      "transliteration": "tab lag naath dhaam teh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਉਸ ਦਾ ਪਤੀ ਘਰ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "तब लगि नाथ धाम तिह आयो ॥",
      "sourceLineId": "133801",
      "sourceShabadId": "12552",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਨਹਾਤਰ ਤ੍ਰਿਯ ਜਾਰ ਛਪਾਯੋ ॥",
      "transliteration": "manahaatar tiray jaar chhapaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਯਾਰ ਨੂੰ ਮੰਨ੍ਰਹੀ (ਪੜਛਤੀ) ਹੇਠਾ ਲੁਕਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "मनहातर तृय जार छपायो ॥",
      "sourceLineId": "133802",
      "sourceShabadId": "12552",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਹੁ ਬੁਗਚਾ ਆਗੇ ਦੈ ਡਾਰੇ ॥",
      "transliteration": "bahu bugachaa aage dhai ddaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਅਗੇ ਬਹੁਤ ਸਾਰੀਆਂ ਗਠੜੀਆਂ ਰਖ ਦਿੱਤੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "बहु बुगचा आगे दै डारे ॥",
      "sourceLineId": "133803",
      "sourceShabadId": "12552",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾ ਕੇ ਜਾਤ ਨ ਅੰਗ ਨਿਹਾਰੇ ॥੫॥",
      "transliteration": "taa ke jaat na a(n)g nihaare ||5||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਜੋ ਉਸ ਦਾ (ਕੋਈ) ਅੰਗ ਨਾ ਵੇਖਿਆ ਜਾ ਸਕੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "ता के जात न अंग निहारे ॥५॥",
      "sourceLineId": "133804",
      "sourceShabadId": "12552",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਹੁ ਚਿਰ ਤਹ ਬੈਠਾ ਨ੍ਰਿਪ ਰਹਾ ॥",
      "transliteration": "bahu chir teh baiThaa nirap rahaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਬਹੁਤ ਦੇਰ ਉਥੇ ਬੈਠਾ ਰਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "बहु चिर तह बैठा नृप रहा ॥",
      "sourceLineId": "133805",
      "sourceShabadId": "12552",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਭਲਾ ਬੁਰਾ ਕਛੁ ਭੇਦ ਨ ਲਹਾ ॥",
      "transliteration": "bhalaa buraa kachh bhedh na lahaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਲੇ ਬੁਰੇ ਦਾ ਕੁਝ ਵੀ ਭੇਦ ਨਾ ਪਾ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "भला बुरा कछु भेद न लहा ॥",
      "sourceLineId": "133806",
      "sourceShabadId": "12552",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਬ ਹੀ ਉਠਿ ਅਪਨੋ ਘਰ ਆਯੋ ॥",
      "transliteration": "jab hee uTh apano ghar aayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਹੀ ਉਠ ਕੇ ਆਪਣੇ ਘਰ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "जब ही उठि अपनो घर आयो ॥",
      "sourceLineId": "133807",
      "sourceShabadId": "12552",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਬ ਹੀ ਤ੍ਰਿਯ ਘਰ ਮੀਤ ਪਠਾਯੋ ॥੬॥",
      "transliteration": "tab hee tiray ghar meet paThaayo ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਹੀ ਇਸਤਰੀ ਨੇ ਮਿਤਰ ਨੂੰ (ਮੰਨ੍ਰਹੀ ਹੇਠੋਂ ਕਢ ਕੇ) ਘਰ ਭੇਜ ਦਿੱਤਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "तब ही तृय घर मीत पठायो ॥६॥",
      "sourceLineId": "133808",
      "sourceShabadId": "12552",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਅਠਾਰਹ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੧੮॥੬੦੦੭॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau aThaareh charitr samaapatam sat subham sat ||318||6007||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੧੮ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੧੮॥੬੦੦੭॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ अठारह चरित्र समापतम सतु सुभम सतु ॥३१८॥६००७॥अफजूँ॥",
      "sourceLineId": "133809",
      "sourceShabadId": "12552",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133810",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੁਨੋ ਨ੍ਰਿਪਤਿ ਮੈ ਭਾਖਤ ਕਥਾ ॥",
      "transliteration": "suno nirapat mai bhaakhat kathaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਸੁਣੋ, (ਤੁਹਾਨੂੰ) ਮੈਂ ਇਕ ਕਥਾ ਸੁਣਾਉਾਂਦਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "सुनो नृपति मै भाखत कथा ॥",
      "sourceLineId": "133811",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਹ ਮਿਲਿ ਦੇਵ ਸਮੁਦ ਕਹ ਮਥਾ ॥",
      "transliteration": "jeh mil dhev samudh keh mathaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਦੇਵਤਿਆਂ (ਅਤੇ ਦੈਂਤਾ) ਨੇ ਮਿਲ ਕੇ ਸਮੁੰਦਰ ਨੂੰ ਮਥਿਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "जह मिलि देव समुद कह मथा ॥",
      "sourceLineId": "133812",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਹਾ ਸੁਬ੍ਰਤ ਨਾਮਾ ਮੁਨਿ ਰਹੈ ॥",
      "transliteration": "tahaa subrat naamaa mun rahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਸੁਬ੍ਰਤ ਨਾ ਦਾ ਇਕ ਮੁਨੀ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "तहा सुब्रत नामा मुनि रहै ॥",
      "sourceLineId": "133813",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਧਿਕ ਬ੍ਰਤੀ ਜਾ ਕਹ ਜਗ ਕਹੈ ॥੧॥",
      "transliteration": "adhik bratee jaa keh jag kahai ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸਾਰਾ ਸੰਸਾਰ ਬਹੁਤ ਬ੍ਰਤੀ ਕਹਿੰਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "अधिक ब्रती जा कह जग कहै ॥१॥",
      "sourceLineId": "133814",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤ੍ਰਿਯ ਮੁਨਿ ਰਾਜ ਮਤੀ ਤਿਹ ਰਹੈ ॥",
      "transliteration": "tiray mun raaj matee teh rahai ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਨੀ ਦੀ ਇਸਤਰੀ ਰਾਜ ਮਤੀ ਵੀ ਉਥੇ ਰਹਿੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "तृय मुनि राज मती तिह रहै ॥",
      "sourceLineId": "133815",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰੂਪ ਅਧਿਕ ਜਾ ਕੋ ਸਭ ਕਹੈ ॥",
      "transliteration": "roop adhik jaa ko sabh kahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸਭ ਬਹੁਤ ਰੂਪਵਾਨ ਕਹਿੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "रूप अधिक जा को सभ कहै ॥",
      "sourceLineId": "133816",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਸਿ ਸੁੰਦਰਿ ਨਹਿ ਔਰ ਉਤਰੀ ॥",
      "transliteration": "as su(n)dhar neh aauar utaree ||",
      "translation": "",
      "punjabiViakhya": "ਇਹੋ ਜਿਹੀ ਸੁੰਦਰੀ ਕੋਈ ਹੋਰ (ਸੰਸਾਰ ਵਿਚ) ਪੈਦਾ ਨਹੀਂ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "असि सुँदरि नहि और उतरी ॥",
      "sourceLineId": "133817",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਹੈ ਹ੍ਵੈਹੈ ਨ ਬਿਧਾਤਾ ਕਰੀ ॥੨॥",
      "transliteration": "hai havaihai na bidhaataa karee ||2||",
      "translation": "",
      "punjabiViakhya": "ਵਿਧਾਤਾ ਨੇ (ਉਸ ਵਰਗੀ ਸੁੰਦਰ) ਨਾ ਪਹਿਲਾ ਸਿਰਜੀ ਹੈ ਅਤੇ ਨਾ ਹੁਣ ਹੀ (ਕੋਈ ਬਣਾਈ ਹੈ) ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "है ह्वैहै न बिधाता करी ॥२॥",
      "sourceLineId": "133818",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਾਗਰ ਮਥਨ ਦੇਵ ਜਬ ਲਾਗੇ ॥",
      "transliteration": "saagar mathan dhev jab laage ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤੇ ਜਦੋਂ ਸਮੁੰਦਰ ਰਿੜਕਣ ਲਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "सागर मथन देव जब लागे ॥",
      "sourceLineId": "133819",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮਥ੍ਰਯੋ ਨ ਜਾਇ ਸਗਲ ਦੁਖ ਪਾਗੇ ॥",
      "transliteration": "mathrayo na jai sagal dhukh paage ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਿੜਕਿਆ ਨਾ ਜਾ ਸਕਿਆ ਅਤੇ ਸਾਰੇ ਦੁਖੀ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "मथ्रयो न जाइ सगल दुख पागे ॥",
      "sourceLineId": "133820",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਬ ਤਿਨ ਤ੍ਰਿਯ ਇਹ ਭਾਤਿ ਉਚਾਰੋ ॥",
      "transliteration": "tab tin tiray ieh bhaat uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਇਸਤਰੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "तब तिन तृय इह भाति उचारो ॥",
      "sourceLineId": "133821",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੁਨੋ ਦੇਵਤਿਯੋ ਬਚਨ ਹਮਾਰੋ ॥੩॥",
      "transliteration": "suno dhevatiyo bachan hamaaro ||3||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਦੇਵਤਿਓ! ਮੇਰੀ ਇਕ ਗੱਲ ਸੁਣੋ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "सुनो देवतियो बचन हमारो ॥३॥",
      "sourceLineId": "133822",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜੋ ਬਿਧਿ ਧਰੈ ਸੀਸ ਪਰ ਝਾਰੀ ॥",
      "transliteration": "jo bidh dharai sees par jhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਬ੍ਰਹਮਾ ਸਿਰ ਉਤੇ ਸੁਰਾਹੀ ਚੁਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "जो बिधि धरै सीस पर झारी ॥",
      "sourceLineId": "133823",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪਾਨਿ ਭਰੈ ਜਲ ਰਾਸਿ ਮੰਝਾਰੀ ॥",
      "transliteration": "paan bharai jal raas ma(n)jhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਮੁੰਦਰ ('ਜਲ ਰਾਸਿ') ਵਿਚੋਂ ਪਾਣੀ ਭਰੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "पानि भरै जल रासि मंझारी ॥",
      "sourceLineId": "133824",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮੇਰੋ ਧੂਰਿ ਪਗਨ ਕੀ ਧੋਵੈ ॥",
      "transliteration": "mero dhoor pagan kee dhovai ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਪੈਰਾ ਦੀ ਧੂੜ ਨੂੰ (ਆ ਕੇ) ਧੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "मेरो धूरि पगन की धोवै ॥",
      "sourceLineId": "133825",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਬ ਯਹ ਸਫਲ ਮਨੋਰਥ ਹੋਵੈ ॥੪॥",
      "transliteration": "tab yeh safal manorath hovai ||4||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਹ ਮਨੋਰਥ ਸਫਲ ਹੋਵੇਗਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "तब यह सफल मनोरथ होवै ॥४॥",
      "sourceLineId": "133826",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬ੍ਰਹਮ ਅਤਿ ਆਤੁਰ ਕਛੁ ਨ ਬਿਚਰਾ ॥",
      "transliteration": "braham at aatur kachh na bicharaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤਿ ਵਿਆਕੁਲ ਹੋਏ ਬ੍ਰਹਮਾ ਨੇ ਕੁਝ ਵੀ ਵਿਚਾਰ ਨਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "ब्रहम अति आतुर कछु न बिचरा ॥",
      "sourceLineId": "133827",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਝਾਰੀ ਰਾਖਿ ਸੀਸ ਜਲ ਭਰਾ ॥",
      "transliteration": "jhaaree raakh sees jal bharaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਰਾਹੀ ਨੂੰ ਸਿਰ ਉਤੇ ਚੁਕ ਕੇ ਜਲ ਭਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "झारी राखि सीस जल भरा ॥",
      "sourceLineId": "133828",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦੇਖਹੁ ਇਹ ਇਸਤ੍ਰਿਨ ਕੇ ਚਰਿਤਾ ॥",
      "transliteration": "dhekhahu ieh isatiran ke charitaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਇਸਤਰੀਆਂ ਦੇ ਚਰਿਤ੍ਰ ਨੂੰ ਵੇਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "देखहु इह इसतृन के चरिता ॥",
      "sourceLineId": "133829",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਚਰਿਤ ਦਿਖਾਯੋ ਕਰਤਾ ॥੫॥",
      "transliteration": "eeh bidh charit dhikhaayo karataa ||5||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਬ੍ਰਹਮਾ ਨੂੰ ਵੀ ਇਨ੍ਰਹਾ ਨੇ ਚਰਿਤ੍ਰ ਵਿਖਾ ਦਿੱਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "इह बिधि चरित दिखायो करता ॥५॥",
      "sourceLineId": "133830",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਉਨੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੧੯॥੬੦੧੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau unees charitr samaapatam sat subham sat ||319||6012||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੧੯ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੧੯॥੬੦੧੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ उनीस चरित्र समापतम सतु सुभम सतु ॥३१९॥६०१२॥अफजूँ॥",
      "sourceLineId": "133831",
      "sourceShabadId": "12553",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133832",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭੂਮਿ ਭਾਰ ਤੇ ਅਤਿ ਦੁਖ ਪਾਯੋ ॥",
      "transliteration": "bhoom bhaar te at dhukh paayo ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦੋਂ) ਧਰਤੀ ਨੇ (ਪਾਪਾ ਦੇ) ਭਾਰ ਕਾਰਨ ਬਹੁਤ ਦੁਖ ਪਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1266,
      "hindi": "",
      "hindiTransliteration": "भूमि भार ते अति दुख पायो ॥",
      "sourceLineId": "133833",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1266_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬ੍ਰਹਮਾ ਪੈ ਦੁਖ ਰੋਇ ਸੁਨਾਯੋ ॥",
