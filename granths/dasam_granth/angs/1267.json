{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1267,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1267_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬ੍ਰਹਮਾ ਕਰੀ ਬਿਸਨ ਕੀ ਸੇਵਾ ॥",
      "transliteration": "brahamaa karee bisan kee sevaa ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਹਮਾ ਨੇ ਵਿਸ਼ਣੂ ਦੀ ਸੇਵਾ ਕੀਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "ब्रहमा करी बिसन की सेवा ॥",
      "sourceLineId": "133835",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਾ ਤੇ ਭਏ ਕ੍ਰਿਸਨ ਜਗ ਦੇਵਾ ॥੧॥",
      "transliteration": "taa te bhe kirasan jag dhevaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਜਗਤ ਦੇਵ ਸ੍ਰੀ ਕ੍ਰਿਸ਼ਨ ਪ੍ਰਗਟ ਹੋਏ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "ता ते भए कृसन जग देवा ॥१॥",
      "sourceLineId": "133836",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮੁਰ ਦਾਨਵ ਕੋ ਕੰਸ ਵਤਾਰਾ ॥",
      "transliteration": "mur dhaanav ko ka(n)s vataaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕੰਸ ਮੁਰ ਦੈਂਤ ਦਾ ਅਵਤਾਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "मुर दानव को कंस वतारा ॥",
      "sourceLineId": "133837",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਰਤ ਪੂਰਬ ਲੌ ਦ੍ਰੋਹ ਸੰਭਾਰਾ ॥",
      "transliteration": "karat poorab lau dhroh sa(n)bhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਛਲੇ ਜਨਮ ਦੀ ਦੁਸ਼ਮਣੀ ਨੂੰ (ਉਹ) ਯਾਦ ਰਖਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "करत पूरब लौ द्रोह संभारा ॥",
      "sourceLineId": "133838",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਵਾ ਕੇ ਕਰਤ ਹਨਨ ਕੇ ਦਾਵੈ ॥",
      "transliteration": "vaa ke karat hanan ke dhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਕ੍ਰਿਸ਼ਨ) ਨੂੰ ਮਾਰਨ ਦੇ ਦਾਵੇ ਕਰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "वा के करत हनन के दावै ॥",
      "sourceLineId": "133839",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਿਤਪ੍ਰਤਿ ਆਸੁਰਨ ਤਹਾ ਪਠਾਵੈ ॥੨॥",
      "transliteration": "nitaprat aasuran tahaa paThaavai ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਿੱਤ ਉਥੇ ਦੈਂਤਾ ਨੂੰ ਭੇਜਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "नितप्रति आसुरन तहा पठावै ॥२॥",
      "sourceLineId": "133840",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪ੍ਰਥਮ ਪੂਤਨਾ ਕ੍ਰਿਸਨ ਸੰਘਾਰੀ ॥",
      "transliteration": "pratham pootanaa kirasan sa(n)ghaaree ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਪੂਤਨਾ ਨੂੰ ਕ੍ਰਿਸ਼ਨ ਨੇ ਮਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "प्रथम पूतना कृसन संघारी ॥",
      "sourceLineId": "133841",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪੁਨਿ ਸਕਟਾਸੁਰ ਦੇਹ ਉਧਾਰੀ ॥",
      "transliteration": "pun sakaTaasur dheh udhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਸ਼ਕਟਾਸੁਰ (ਦੈਂਤ) ਦੀ ਦੇਹ ਦਾ ਉੱਧਾਰ ਕੀਤਾ (ਅਰਥਾਤ-ਮਾਰ ਕੇ ਯਮਲੋਕ ਭੇਜਿਆ)।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "पुनि सकटासुर देह उधारी ॥",
      "sourceLineId": "133842",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਹੁਰਿ ਬਕਾਸੁਰ ਅਸੁਰ ਸੰਘਾਰਿਯੋ ॥",
      "transliteration": "bahur bakaasur asur sa(n)ghaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ ਬਕਾਸੁਰ ਦੈਂਤ ਨੂੰ ਮਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "बहुरि बकासुर असुर संघारियो ॥",
      "sourceLineId": "133843",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬ੍ਰਿਖਭਾਸੁਰ ਕੇ ਬ੍ਰਿਖਨ ਉਪਾਰਿਯੋ ॥੩॥",
      "transliteration": "birakhabhaasur ke birakhan upaariyo ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬ੍ਰਿਖਭਾਸੁਰ ਦੇ ਸਿੰਗਾ ('ਬ੍ਰਿਖਨ') ਨੂੰ ਉਖਾੜਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "बृखभासुर के बृखन उपारियो ॥३॥",
      "sourceLineId": "133844",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਆਘਾਸੁਰ ਕੋ ਅਘ ਨਿਵਰਤ ਕਰਿ ॥",
      "transliteration": "aaghaasur ko agh nivarat kar ||",
      "translation": "",
      "punjabiViakhya": "ਅਘਾਸੁਰ ਦੇ ਪਾਪ ('ਅਘ') ਖ਼ਤਮ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "आघासुर को अघ निवरत करि ॥",
      "sourceLineId": "133845",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪੁਨਿ ਕੇਸੀ ਮਾਰਿਯੋ ਚਰਨਨ ਧਰਿ ॥",
      "transliteration": "pun kesee maariyo charanan dhar ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਕੇਸੀ (ਦੈਂਤ) ਨੂੰ ਪੈਰਾ ਤੋਂ ਪਕੜ ਕੇ ਮਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "पुनि केसी मारियो चरनन धरि ॥",
      "sourceLineId": "133846",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਹੁਰਿ ਬ੍ਰਹਮ ਕਹ ਚਰਿਤ ਦਿਖਾਯੋ ॥",
      "transliteration": "bahur braham keh charit dhikhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ ਬ੍ਰਹਮਾ ਨੂੰ (ਆਪਣਾ) ਕੌਤਕ ਵਿਖਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "बहुरि ब्रहम कह चरित दिखायो ॥",
      "sourceLineId": "133847",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਧਰਿ ਕਰਿ ਪਰ ਗਿਰ ਇੰਦ੍ਰ ਹਰਾਯੋ ॥੪॥",
      "transliteration": "dhar kar par gir i(n)dhr haraayo ||4||",
      "translation": "",
      "punjabiViakhya": "ਪਰਬਤ ਨੂੰ ਹੱਥ ਉਤੇ ਚੁਕ ਕੇ ਇੰਦਰ ਨੂੰ ਹਰਾਇਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "धरि करि पर गिर इंद्र हरायो ॥४॥",
      "sourceLineId": "133848",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨੰਦਹਿ ਛੀਨ ਬਰਨ ਤੇ ਲ੍ਯਾਯੋ ॥",
      "transliteration": "na(n)dheh chheen baran te layaayo ||",
      "translation": "",
      "punjabiViakhya": "ਨੰਦ ਨੂੰ ਵਰੁਣ ਤੋਂ ਖੋਹ ਕੇ ਲਿਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "नंदहि छीन बरन ते ल्यायो ॥",
      "sourceLineId": "133849",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੰਦੀਪਨ ਕੇ ਸੁਤਹਿ ਮਿਲਾਯੋ ॥",
      "transliteration": "sa(n)dheepan ke suteh milaayo ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਦੀਪਨ ਦੇ ਪੁੱਤਰਾ ਨੂੰ ਮਿਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "संदीपन के सुतहि मिलायो ॥",
      "sourceLineId": "133850",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦਾਵਾਨਲ ਤੇ ਗੋਪ ਉਬਾਰੇ ॥",
      "transliteration": "dhaavaanal te gop ubaare ||",
      "translation": "",
      "punjabiViakhya": "ਦਾਵਾਨਲ ਤੋਂ ਗਵਾਲਿਆਂ ਨੂੰ ਬਚਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "दावानल ते गोप उबारे ॥",
      "sourceLineId": "133851",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੋਪਨ ਸੌ ਬ੍ਰਿਜ ਕਰੇ ਅਖਾਰੇ ॥੫॥",
      "transliteration": "gopan sau biraj kare akhaare ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬ੍ਰਜਭੂਮੀ ਵਿਚ ਗਵਾਲਿਆਂ ਨਾਲ ਅਖਾੜੇ ਰਚਾਏ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "गोपन सौ बृज करे अखारे ॥५॥",
      "sourceLineId": "133852",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕੁਬਲਯਾ ਗਜ ਕੋ ਦਾਤ ਲਯੋ ਹਰਿ ॥",
      "transliteration": "kubalayaa gaj ko dhaat layo har ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਵਲੀਆ ਹਾਥੀ ਦੇ ਦੰਦ ਉਖਾੜ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "कुबलया गज को दात लयो हरि ॥",
      "sourceLineId": "133853",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚਾਡੂਰਹਿ ਮੁਸਟਕਹਿ ਪ੍ਰਹਰਿ ਕਰਿ ॥",
      "transliteration": "chaaddooreh musaTakeh prahar kar ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਡੂਰ ਉਤੇ ਮੁੱਕੇ ਦਾ ਪ੍ਰਹਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "चाडूरहि मुसटकहि प्रहरि करि ॥",
      "sourceLineId": "133854",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪਕਰਿ ਕੇਸ ਤੇ ਕੰਸ ਪਛਾਰਾ ॥",
      "transliteration": "pakar kes te ka(n)s pachhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕੇਸਾ ਤੋਂ ਪਕੜ ਕੇ ਕੰਸ ਨੂੰ ਪਛਾੜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "पकरि केस ते कंस पछारा ॥",
      "sourceLineId": "133855",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਉਪ੍ਰਸੈਨ ਸਿਰ ਛਤ੍ਰਹਿ ਢਾਰਾ ॥੬॥",
      "transliteration": "auprasain sir chhatreh ddaaraa ||6||",
      "translation": "",
      "punjabiViakhya": "ਉਗ੍ਰਸੈਨ ਦੇ ਸਿਰ ਉਤੇ ਛਤ੍ਰ ਝੁਲਾਇਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "उप्रसैन सिर छत्रहि ढारा ॥६॥",
      "sourceLineId": "133856",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਰਾਸਿੰਧੁ ਕੀ ਚਮੂੰ ਸੰਘਾਰੀ ॥",
      "transliteration": "jaraasi(n)dh kee chamoo(n) sa(n)ghaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਰਾਸੰਧ ਦੀ ਸੈਨਾ ਨੂੰ ਨਸ਼ਟ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "जरासिंधु की चमूँ संघारी ॥",
      "sourceLineId": "133857",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੰਖ ਲਯੋ ਸੰਖਾਸੁਰ ਮਾਰੀ ॥",
      "transliteration": "sa(n)kh layo sa(n)khaasur maaree ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਖਾਸੁਰ ਨੂੰ ਮਾਰ ਕੇ ਸੰਖ ਲੈ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "संख लयो संखासुर मारी ॥",
      "sourceLineId": "133858",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਗਰ ਦ੍ਵਾਰਿਕਾ ਕੀਯਾ ਪ੍ਰਵੇਸਾ ॥",
      "transliteration": "nagar dhavaiaarikaa keeyaa pravesaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਸਾ ਦੇਸਾ ਦੇ ਰਾਜਿਆਂ ਨੂੰ ਜਿਤ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "नगर द्वारिका कीया प्रवेसा ॥",
      "sourceLineId": "133859",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੇਸ ਦੇਸ ਕੇ ਜੀਤਿ ਨਰੇਸਾ ॥੭॥",
      "transliteration": "dhes dhes ke jeet naresaa ||7||",
      "translation": "",
      "punjabiViakhya": "ਦੁਆਰਿਕਾ ਨਗਰ ਵਿਚ ਪ੍ਰਵੇਸ਼ ਕੀਤਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "देस देस के जीति नरेसा ॥७॥",
      "sourceLineId": "133860",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੰਤਬਕ੍ਰ ਨਰਕਾਸੁਰ ਘਾਯੋ ॥",
      "transliteration": "dha(n)tabakr narakaasur ghaayo ||",
      "translation": "",
      "punjabiViakhya": "ਦੰਤਬਕ੍ਰ ਅਤੇ ਨਰਕਾਸੁਰ ਨੂੰ ਮਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "दंतबक्र नरकासुर घायो ॥",
      "sourceLineId": "133861",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੋਰਹ ਸਹਸ ਬਧੂ ਬਰਿ ਲ੍ਯਾਯੋ ॥",
      "transliteration": "soreh sahas badhoo bar layaayo ||",
      "translation": "",
      "punjabiViakhya": "ਸੋਲ੍ਰਹਾ ਹਜ਼ਾਰ ਇਸਤਰੀਆਂ ਨੂੰ ਵਿਆਹ ਲਿਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "सोरह सहस बधू बरि ल्यायो ॥",
      "sourceLineId": "133862",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪਾਰਜਾਤ ਸੁਰ ਪੁਰ ਤੇ ਲ੍ਯਾਯਾ ॥",
      "transliteration": "paarajaat sur pur te layaayaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਵਰਗ ਵਿਚੋਂ ਪਾਰਜਾਤ ਬ੍ਰਿਛ ਲਿਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "पारजात सुर पुर ते ल्याया ॥",
      "sourceLineId": "133863",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਿੰਦ੍ਰਾਬਨ ਮਹਿ ਖੇਲ ਦਿਖਾਯਾ ॥੮॥",
      "transliteration": "bi(n)dhraaban meh khel dhikhaayaa ||8||",
      "translation": "",
      "punjabiViakhya": "ਬਿੰਦ੍ਰਾਬਨ ਵਿਚ ਲੀਲਾ ਰਚਾਈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "बिंद्राबन महि खेल दिखाया ॥८॥",
      "sourceLineId": "133864",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪੰਡ੍ਵਨ ਕੀ ਜਿਨ ਕਰੀ ਜਿਤਾਰੀ ॥",
      "transliteration": "pa(n)ddavain kee jin karee jitaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਪਾਡਵਾ ਦੀ ਜਿਤ ਕਰਵਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "पंड्वन की जिन करी जितारी ॥",
      "sourceLineId": "133865",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦ੍ਰੁਪਦ ਸੁਤਾ ਕੀ ਲਾਜ ਉਬਾਰੀ ॥",
      "transliteration": "dhrupadh sutaa kee laaj ubaaree ||",
      "translation": "",
      "punjabiViakhya": "ਦ੍ਰੋਪਤੀ ਦੀ ਲਾਜ ਨੂੰ ਬਚਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "द्रुपद सुता की लाज उबारी ॥",
      "sourceLineId": "133866",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਭ ਕੌਰਵ ਕੇ ਦਲਹਿ ਖਪਾਈ ॥",
      "transliteration": "sabh kauarav ke dhaleh khapaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕੌਰਵਾ ਦੇ ਸਾਰੇ ਦਲ ਨੂੰ ਨਸ਼ਟ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "सभ कौरव के दलहि खपाई ॥",
      "sourceLineId": "133867",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੰਤਹਿ ਆਂਚ ਨ ਲਾਗਨ ਪਾਈ ॥੯॥",
      "transliteration": "sa(n)teh aa(n)ch na laagan paiee ||9||",
      "translation": "",
      "punjabiViakhya": "ਸੰਤਾ ਨੂੰ (ਦੁਖ ਦਾ) ਸੇਕ ਤਕ ਨਾ ਲਗਣ ਦਿੱਤਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "संतहि आँच न लागन पाई ॥९॥",
      "sourceLineId": "133868",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਭ ਸੂਚਨਤਾ ਜੌ ਕਰਿ ਜੈਯੈ ॥",
      "transliteration": "sabh soochanataa jau kar jaiyai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਸਾਰੀ ਸੂਚਨਾ ਦਿੰਦੇ ਜਾਈਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "सभ सूचनता जौ करि जैयै ॥",
      "sourceLineId": "133869",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗ੍ਰੰਥ ਬਢਨ ਤੇ ਅਧਿਕ ਡਰੈਯੈ ॥",
      "transliteration": "gra(n)th baddan te adhik ddaraiyai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਗ੍ਰੰਥ ਦੇ ਵੱਡੇ ਹੋ ਜਾਣ ਦਾ ਡਰ ਲਗਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "ग्रंथ बढन ते अधिक डरैयै ॥",
      "sourceLineId": "133870",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਾ ਤੇ ਥੋਰੀ ਕਥਾ ਉਚਾਰੀ ॥",
      "transliteration": "taa te thoree kathaa uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਥੋੜੀ ਗੱਲ (ਅਰਥਾਤਰ- ਸੰਖਿਪਤ ਗੱਲ) ਹੀ ਕੀਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "ता ते थोरी कथा उचारी ॥",
      "sourceLineId": "133871",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਚੂਕ ਹੋਇ ਕਬਿ ਲੇਹੁ ਸੁਧਾਰੀ ॥੧੦॥",
      "transliteration": "chook hoi kab leh sudhaaree ||10||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਥੇ) ਗ਼ਲਤੀ ਹੋ ਗਈ ਹੋਵੇ, (ਉਹ) ਕਵੀ ਲੋਕ ਸੁਧਾਰ ਲੈਣ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "चूक होइ कबि लेहु सुधारी ॥१०॥",
      "sourceLineId": "133872",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਬ ਮੈ ਕਹਤ ਕਥਾ ਰੁਕਮਨੀ ॥",
      "transliteration": "ab mai kahat kathaa rukamanee ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੈਂ ਰੁਕਮਣੀ ਦੀ ਕਥਾ ਕਹਿੰਦਾ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "अब मै कहत कथा रुकमनी ॥",
      "sourceLineId": "133873",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਿਹ ਛਲ ਬਰਿਯੋ ਕ੍ਰਿਸਨ ਸੋ ਧਨੀ ॥",
      "transliteration": "jeh chhal bariyo kirasan so dhanee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਛਲ ਪੂਰਵਕ ਕ੍ਰਿਸ਼ਨ ਵਰਗੇ ਪਤੀ ਨਾਲ ਵਿਆਹ ਕੀਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "जिह छल बरियो कृसन सो धनी ॥",
      "sourceLineId": "133874",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਲਿਖਿ ਪਤਿਯਾ ਦਿਜ ਹਾਥ ਪਠਾਈ ॥",
      "transliteration": "likh patiyaa dhij haath paThaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਇਕ) ਚਿੱਠੀ ਲਿਖ ਕੇ ਬ੍ਰਾਹਮਣ ਦੇ ਹੱਥ ਭੇਜੀ",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "लिखि पतिया दिज हाथ पठाई ॥",
      "sourceLineId": "133875",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਹਿਯਹੁ ਮਹਾਰਾਜ ਤਨ ਜਾਈ ॥੧੧॥",
      "transliteration": "kahiyahu mahaaraaj tan jaiee ||11||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ ਕਿ) ਮਹਾਰਾਜ (ਸ੍ਰੀ ਕ੍ਰਿਸ਼ਨ) ਤਕ ਜਾ ਕੇ ਕਹਿਣਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "कहियहु महाराज तन जाई ॥११॥",
      "sourceLineId": "133876",
      "sourceShabadId": "12554",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਵੈਯਾ ॥",
      "transliteration": "savaiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੈਯਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "सवैया ॥",
      "sourceLineId": "133877",
      "sourceShabadId": "12555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬ੍ਯਾਹ ਬਦ੍ਯੋ ਸਿਸਪਾਲ ਭਏ ਸੁਈ ਜੋਰਿ ਬਰਾਤ ਬਿਯਾਹਨ ਆਏ ॥",
      "transliteration": "bayaeh badhayo sisapaal bhe suiee jor baraat biyaahan aae ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰਾ ਵਿਆਹ ਸ਼ਿਸ਼ੁਪਾਲ ਨਾਲ ਪੱਕਾ ਕੀਤਾ ਗਿਆ ਹੈ। ਉਹ ਬਰਾਤ ਲੈ ਕੇ ਵਿਆਹੁਣ ਲਈ ਆਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "ब्याह बद्यो सिसपाल भए सुई जोरि बरात बियाहन आए ॥",
      "sourceLineId": "133878",
      "sourceShabadId": "12555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹੌ ਅਟਕੀ ਮਧਸੂਦਨ ਸੌ ਜਿਨ ਕੀ ਛਬਿ ਹਾਟਕ ਹੇਰਿ ਹਿਰਾਏ ॥",
      "transliteration": "hau aTakee madhasoodhan sau jin kee chhab haaTak her hiraae ||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ) ਮੈਂ ਮਧੁਸੂਦਨ ਉਤੇ ਮੋਹਿਤ ਹਾ, ਜਿਸ ਦੀ ਛਬੀ ਨੂੰ ਵੇਖ ਕੇ ਸੋਨਾ ('ਹਾਟਨ') ਵੀ ਲਜਾ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "हौ अटकी मधसूदन सौ जिन की छबि हाटक हेरि हिराए ॥",
      "sourceLineId": "133879",
      "sourceShabadId": "12555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚਾਤ੍ਰਿਕ ਕੀ ਜਿਮਿ ਪ੍ਯਾਸ ਘਟੇ ਨ ਬਿਨਾ ਘਨ ਸੇ ਘਨ ਸ੍ਯਾਮ ਸੁਹਾਏ ॥",
      "transliteration": "chaatirak kee jim payaas ghaTe na binaa ghan se ghan sayaam suhaae ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਚਾਤ੍ਰਿਕ ਦੀ ਪਿਆਸ ਬਦਲ ਤੋਂ ਬਿਨਾ ਨਹੀਂ ਮਿਟਦੀ (ਉਸ ਤਰ੍ਰਹਾ ਮੇਰੀ ਪਿਆਸ ਵੀ) ਘਨ ਸ਼ਿਆਮ ਦੇ ਸੁਸ਼ੋਭਿਤ (ਹੋਣ ਨਾਲ ਤ੍ਰਿਪਤ ਹੁੰਦੀ ਹੈ)।",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "चातृक की जिमि प्यास घटे न बिना घन से घन स्याम सुहाए ॥",
      "sourceLineId": "133880",
      "sourceShabadId": "12555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਾਰੀ ਗਿਰੀ ਨ ਹਿਰਿਯੋ ਹਿਯ ਕੋ ਦੁਖ ਹੇਰਿ ਰਹੀ ਨ ਹਹਾ ਹਰਿ ਆਏ ॥੧੨॥",
      "transliteration": "haaree giree na hiriyo hiy ko dhukh her rahee na hahaa har aae ||12||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਹਾਰ ਕੇ ਡਿਗ ਪਈ ਹਾ, ਪਰ ਹਿਰਦੇ ਦਾ ਦੁਖ ਦੂਰ ਨਹੀਂ ਹੋਇਆ। ਵੇਖ ਰਹੀ ਹਾ, ਪਰ ਹਾਇ ਕ੍ਰਿਸ਼ਨ ਨਹੀਂ ਆਏ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1267,
      "hindi": "",
      "hindiTransliteration": "हारी गिरी न हिरियो हिय को दुख हेरि रही न हहा हरि आए ॥१२॥",
      "sourceLineId": "133881",
      "sourceShabadId": "12555",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1267_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
