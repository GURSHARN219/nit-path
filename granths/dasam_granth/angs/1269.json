{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1269,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1269_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗੜੇਦਾਰ ਮਾਨੋ ਕਰੀ ਮਤ ਕੀ ਜ੍ਯੋ ॥੨੪॥",
      "transliteration": "gaRedhaar maano karee mat kee jayo ||24||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਭਾਲਿਆਂ ਵਾਲਿਆਂ ('ਗੜੇਦਾਰ') ਨੇ ਮਸਤ ਹਾਥੀ ਨੂੰ ਘੇਰ ਲਿਆ ਹੋਵੇ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "गड़ेदार मानो करी मत की ज्यो ॥२४॥",
      "sourceLineId": "133931",
      "sourceShabadId": "12559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਬੈ ਕੋਪ ਕੈ ਕ੍ਰਿਸਨ ਮਾਰੇ ਚੰਦੇਲੇ ॥",
      "transliteration": "tabai kop kai kirasan maare cha(n)dhele ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਸ੍ਰੀ ਕ੍ਰਿਸ਼ਨ ਨੇ ਰੋਹ ਵਿਚ ਆ ਕੇ ਚੰਦੇਲੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "तबै कोप कै कृसन मारे चंदेले ॥",
      "sourceLineId": "133932",
      "sourceShabadId": "12559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਘੇਲੇ ਧਧੇਲੇ ਬਘੇਲੇ ਬੁੰਦੇਲੇ ॥",
      "transliteration": "maghele dhadhele baghele bu(n)dhele ||",
      "translation": "",
      "punjabiViakhya": "ਮਘੇਲੇ, ਧਧੇਲੇ, ਬਘੇਲੇ ਅਤੇ ਬੁੰਦੇਲੇ ਮਾਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "मघेले धधेले बघेले बुँदेले ॥",
      "sourceLineId": "133933",
      "sourceShabadId": "12559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚੰਦੇਰੀਸ ਹੂੰ ਕੌ ਤਬੈ ਬਾਨ ਮਾਰਾ ॥",
      "transliteration": "cha(n)dherees hoo(n) kau tabai baan maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ 'ਚੰਦੇਰੀਸ' (ਚੰਦੇਰੀ ਦੇ ਰਾਜਾ ਸ਼ਿਸ਼ੁਪਾਲ) ਨੂੰ ਬਾਣ ਮਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "चंदेरीस हूँ कौ तबै बान मारा ॥",
      "sourceLineId": "133934",
      "sourceShabadId": "12559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗਿਰਿਯੋ ਭੂਮਿ ਪੈ ਨ ਹਥ੍ਯਾਰੈ ਸੰਭਾਰਾ ॥੨੫॥",
      "transliteration": "giriyo bhoom pai na hathayaarai sa(n)bhaaraa ||25||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਧਰਤੀ ਉਤੇ ਡਿਗ ਪਿਆ ਅਤੇ ਹਥਿਆਰਾ ਨੂੰ ਸੰਭਾਲ ਨਾ ਸਕਿਆ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "गिरियो भूमि पै न हथ्यारै संभारा ॥२५॥",
      "sourceLineId": "133935",
      "sourceShabadId": "12559",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133936",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਰਾਸਿੰਧ ਕਹਿ ਪੁਨਿ ਸਰ ਮਾਰਾ ॥",
      "transliteration": "jaraasi(n)dh keh pun sar maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਜਰਾਸੰਧ ਨੂੰ ਤੀਰ ਮਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "जरासिंध कहि पुनि सर मारा ॥",
      "sourceLineId": "133937",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭਾਗਿ ਚਲਿਯੋ ਨ ਹਥ੍ਯਾਰ ਸੰਭਾਰਾ ॥",
      "transliteration": "bhaag chaliyo na hathayaar sa(n)bhaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਹਥਿਆਰ ਸੰਭਾਲੇ ਬਿਨਾ ਭਜ ਚਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "भागि चलियो न हथ्यार संभारा ॥",
      "sourceLineId": "133938",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭਿਰੇ ਸੁ ਮਰੇ ਬਚੇ ਤੇ ਹਾਰੇ ॥",
      "transliteration": "bhire su mare bache te haare ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ (ਯੁੱਧ-ਭੂਮੀ ਵਿਚ) ਲੜੇ ਸਨ, ਉਹ ਮਾਰੇ ਗਏ, ਜੋ ਬਚ ਗਏ, ਉਹ ਹਾਰ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "भिरे सु मरे बचे ते हारे ॥",
      "sourceLineId": "133939",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚੰਦੇਰਿਯਹਿ ਚੰਦੇਲ ਸਿਧਾਰੇ ॥੨੬॥",
      "transliteration": "cha(n)dheriyeh cha(n)dhel sidhaare ||26||",
      "translation": "",
      "punjabiViakhya": "ਚੰਦੇਲੇ ਚੰਦੇਰੀ ਵਲ ਭਜ ਗਏ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "चंदेरियहि चंदेल सिधारे ॥२६॥",
      "sourceLineId": "133940",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਬ ਰੁਕਮੀ ਪਹੁਚਤ ਭਯੋ ਜਾਈ ॥",
      "transliteration": "tab rukamee pahuchat bhayo jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰੁਕਮੀ ਉਥੇ ਆ ਪਹੁੰਚਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "तब रुकमी पहुचत भयो जाई ॥",
      "sourceLineId": "133941",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਧਿਕ ਕ੍ਰਿਸਨ ਸੌ ਕਰੀ ਲਰਾਈ ॥",
      "transliteration": "adhik kirasan sau karee laraiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਕ੍ਰਿਸ਼ਨ ਨਾਲ ਬਹੁਤ ਲੜਾਈ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "अधिक कृसन सौ करी लराई ॥",
      "sourceLineId": "133942",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਬਿਸਿਖ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "bhaat bhaat tan bisikh prahaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਕਈ ਤਰ੍ਰਹਾ ਨਾਲ ਤੀਰ ਚਲਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन बिसिख प्रहारे ॥",
      "sourceLineId": "133943",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹਾਰਿਯੋ ਵਹੈ ਕ੍ਰਿਸਨ ਨਹਿ ਹਾਰੇ ॥੨੭॥",
      "transliteration": "haariyo vahai kirasan neh haare ||27||",
      "translation": "",
      "punjabiViakhya": "ਉਹੀ ਹਾਰਿਆ, ਕ੍ਰਿਸ਼ਨ ਨਾ ਹਾਰੇ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "हारियो वहै कृसन नहि हारे ॥२७॥",
      "sourceLineId": "133944",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚਿਤ ਮੈ ਅਧਿਕ ਠਾਨਿ ਕੈ ਕ੍ਰੁਧਾ ॥",
      "transliteration": "chit mai adhik Thaan kai krudhaa ||",
      "translation": "",
      "punjabiViakhya": "ਚਿਤ ਵਿਚ ਬਹੁਤ ਕ੍ਰੋਧ ਵਧਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "चित मै अधिक ठानि कै क्रुधा ॥",
      "sourceLineId": "133945",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਾਡਤ ਭਯੋ ਕ੍ਰਿਸਨ ਸੌ ਜੁਧਾ ॥",
      "transliteration": "maaddat bhayo kirasan sau judhaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਕ੍ਰਿਸ਼ਨ ਨਾਲ ਯੁੱਧ ਸ਼ੁਰੂ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "माडत भयो कृसन सौ जुधा ॥",
      "sourceLineId": "133946",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਏਕ ਬਾਨ ਤਬ ਸ੍ਯਾਮ ਪ੍ਰਹਾਰਾ ॥",
      "transliteration": "ek baan tab sayaam prahaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਕ ਬਾਣ ਸ਼ਿਆਮ ਨੇ ਚਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "एक बान तब स्याम प्रहारा ॥",
      "sourceLineId": "133947",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗਿਰਿਯੋ ਪ੍ਰਿਥੀ ਪਰ ਜਾਨੁ ਸੰਘਾਰਾ ॥੨੮॥",
      "transliteration": "giriyo pirathee par jaan sa(n)ghaaraa ||28||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਧਰਤੀ ਉਤੇ (ਇੰਜ) ਡਿਗ ਪਿਆ, ਮਾਨੋ ਮਾਰਿਆ ਗਿਆ ਹੋਵੇ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "गिरियो पृथी पर जानु संघारा ॥२८॥",
      "sourceLineId": "133948",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਰ ਸੌ ਮੂੰਡਿ ਪ੍ਰਥਮ ਤਿਹ ਸੀਸਾ ॥",
      "transliteration": "sar sau moo(n)dd pratham teh seesaa ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਤੀਰ ਨਾਲ ਉਸ ਦਾ ਸਿਰ ਮੁੰਨ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "सर सौ मूँडि प्रथम तिह सीसा ॥",
      "sourceLineId": "133949",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਾਧਿ ਲਯੋ ਰਥ ਸੌ ਜਦੁਈਸਾ ॥",
      "transliteration": "baadh layo rath sau jadhuieesaa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਸ੍ਰੀ ਕ੍ਰਿਸ਼ਨ ਨੇ ਰਥ ਨਾਲ ਬੰਨ੍ਰਹ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "बाधि लयो रथ सौ जदुईसा ॥",
      "sourceLineId": "133950",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭ੍ਰਾਤ ਜਾਨਿ ਰੁਕਮਿਨੀ ਛਡਾਯੋ ॥",
      "transliteration": "bhraat jaan rukaminee chhaddaayo ||",
      "translation": "",
      "punjabiViakhya": "ਭਰਾ ਸਮਝ ਕੇ ਰੁਕਮਣੀ ਨੇ (ਉਸ ਨੂੰ) ਛੁੜਵਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "भ्रात जानि रुकमिनी छडायो ॥",
      "sourceLineId": "133951",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਲਜਤ ਧਾਮ ਸਿਸਪਾਲ ਸਿਧਾਯੋ ॥੨੯॥",
      "transliteration": "lajat dhaam sisapaal sidhaayo ||29||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਿਸ਼ੁਪਾਲ ਵੀ ਲਜਿਤ ਹੋ ਕੇ ਘਰ ਨੂੰ ਚਲਾ ਗਿਆ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "लजत धाम सिसपाल सिधायो ॥२९॥",
      "sourceLineId": "133952",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਿਨੂੰ ਚੰਦੇਲਨ ਕੇ ਸਿਰ ਤੂਟੇ ॥",
      "transliteration": "kinoo(n) cha(n)dhelan ke sir tooTe ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਚੰਦੇਲਿਆਂ ਦੇ ਸਿਰ ਫੁਟ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "किनूँ चंदेलन के सिर तूटे ॥",
      "sourceLineId": "133953",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਈਕ ਗਏ ਮੂੰਡ ਘਰ ਟੂਟੇ ॥",
      "transliteration": "kieek ge moo(n)dd ghar TooTe ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਜ਼ਖ਼ਮੀ ਸਿਰਾ ਨਾਲ ਘਰਾ ਨੂੰ ਪਰਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "कईक गए मूँड घर टूटे ॥",
      "sourceLineId": "133954",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਕਲ ਚੰਦੇਲੇ ਲਾਜ ਲਜਾਏ ॥",
      "transliteration": "sakal cha(n)dhele laaj lajaae ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਚੰਦੇਲੇ ਲਾਜ ਲਈ ਲਜਿਤ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "सकल चंदेले लाज लजाए ॥",
      "sourceLineId": "133955",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾਰਿ ਗਵਾਇ ਚੰਦੇਰੀ ਆਏ ॥੩੦॥",
      "transliteration": "naar gavai cha(n)dheree aae ||30||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ ਉਹ) ਇਸਤਰੀ ਨੂੰ ਗਵਾ ਕੇ ਚੰਦੇਰੀ ਪਰਤੇ ਸਨ ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "नारि गवाइ चंदेरी आए ॥३०॥",
      "sourceLineId": "133956",
      "sourceShabadId": "12560",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "133957",
      "sourceShabadId": "12561",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗਏ ਚੰਦੇਲ ਚੰਦੇਰਿਯਹਿ ਕਰ ਤੇ ਨਾਰਿ ਗਵਾਇ ॥",
      "transliteration": "ge cha(n)dhel cha(n)dheriyeh kar te naar gavai ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਦੇਲ ਹੱਥੋਂ ਇਸਤਰੀ ਖੁਹਾ ਕੇ ਚੰਦੇਰੀ ਨਗਰ ਨੂੰ ਚਲੇ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "गए चंदेल चंदेरियहि कर ते नारि गवाइ ॥",
      "sourceLineId": "133958",
      "sourceShabadId": "12561",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਤਨ ਰੁਕਮਨੀ ਬਰਤ ਭਈ ਜਦੁਰਾਇ ॥੩੧॥",
      "transliteration": "eeh charitr tan rukamanee barat bhiee jadhurai ||31||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਚਰਿਤ੍ਰ ਨਾਲ ਰੁਕਮਣੀ ਨੇ ਸ੍ਰੀ ਕ੍ਰਿਸ਼ਨ ਨਾਲ ਵਿਆਹ ਕਰ ਲਿਆ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र तन रुकमनी बरत भई जदुराइ ॥३१॥",
      "sourceLineId": "133959",
      "sourceShabadId": "12561",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਬੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੨੦॥੬੦੪੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau bees charitr samaapatam sat subham sat ||320||6043||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੨੦ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੨੦॥੬੦੪੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ बीस चरित्र समापतम सतु सुभम सतु ॥३२०॥६०४३॥अफजूँ॥",
      "sourceLineId": "133960",
      "sourceShabadId": "12561",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "133961",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੁਕ੍ਰਾਚਾਰਜ ਦਾਨ੍ਵਨ ਕੋ ਗੁਰ ॥",
      "transliteration": "sukraachaaraj dhaanavain ko gur ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੁਕ੍ਰਾਚਾਰੀਆ ਦੈਂਤਾ ਦਾ ਗੁਰੂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "सुक्राचारज दान्वन को गुर ॥",
      "sourceLineId": "133962",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੁਕ੍ਰਾਵਤੀ ਬਸਤ ਜਾ ਕੋ ਪੁਰ ॥",
      "transliteration": "sukraavatee basat jaa ko pur ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ (ਨਾ ਤੇ) ਸੁਕ੍ਰਾਵਤੀ ਨਗਰ ਵਸਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "सुक्रावती बसत जा को पुर ॥",
      "sourceLineId": "133963",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮਾਰਿ ਦੇਵ ਜਾ ਕੌ ਰਨ ਜਾਵੈ ॥",
      "transliteration": "maar dhev jaa kau ran jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਦੇਵਤੇ ਯੁੱਧ ਵਿਚ ਮਾਰ ਜਾਦੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "मारि देव जा कौ रन जावै ॥",
      "sourceLineId": "133964",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪੜਿ ਸੰਜੀਵਨਿ ਤਾਹਿ ਜਿਯਾਵੈ ॥੧॥",
      "transliteration": "paR sa(n)jeevan taeh jiyaavai ||1||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਉਹ) ਸੰਜੀਵਨੀ (ਵਿਦਿਆ) ਪੜ੍ਰਹ ਕੇ ਉਸ ਨੂੰ ਜਿਵਾ ਦਿੰਦਾ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "पड़ि संजीवनि ताहि जियावै ॥१॥",
      "sourceLineId": "133965",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦੇਵਜਾਨਿ ਇਕ ਸੁਤਾ ਤਵਨ ਕੀ ॥",
      "transliteration": "dhevajaan ik sutaa tavan kee ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਯਾਨੀ ਨਾ ਦੀ ਉਸ ਦੀ ਇਕ ਪੁੱਤਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "देवजानि इक सुता तवन की ॥",
      "sourceLineId": "133966",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਪ੍ਰਮਾਨ ਛਬਿ ਹੁਤੀ ਜਵਨ ਕੀ ॥",
      "transliteration": "apramaan chhab hutee javan kee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਅਸੀਮ ਸੁੰਦਰਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "अप्रमान छबि हुती जवन की ॥",
      "sourceLineId": "133967",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਚ ਨਾਮਾ ਦੇਵਨ ਕੋ ਦਿਜਬਰ ॥",
      "transliteration": "kach naamaa dhevan ko dhijabar ||",
      "translation": "",
      "punjabiViakhya": "ਕਚ ਨਾ ਦਾ (ਇਕ) ਦੇਵਤਿਆਂ ਦਾ ਪਰੋਹਿਤ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "कच नामा देवन को दिजबर ॥",
      "sourceLineId": "133968",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਆਵਤ ਭਯੋ ਸੁਕ੍ਰ ਕੇ ਤਬ ਘਰ ॥੨॥",
      "transliteration": "aavat bhayo sukr ke tab ghar ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਹ (ਇਕ ਵਾਰ) ਸ਼ੁਕ੍ਰਾਚਾਰੀਆ ਦੇ ਘਰ ਆਇਆ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "आवत भयो सुक्र के तब घर ॥२॥",
      "sourceLineId": "133969",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੇਵਜਾਨਿ ਸੰਗਿ ਕਿਯਾ ਅਧਿਕ ਹਿਤ ॥",
      "transliteration": "dhevajaan sa(n)g kiyaa adhik hit ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਦੇਵਯਾਨੀ ਨਾਲ ਬਹੁਤ ਹਿਤ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "देवजानि संगि किया अधिक हित ॥",
      "sourceLineId": "133970",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਰਿ ਲੀਨੋ ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਤ੍ਰਿਯ ਕੋ ਚਿਤ ॥",
      "transliteration": "har leeno jayo(n) tayo(n) tiray ko chit ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਉਸ ਇਸਤਰੀ ਦਾ ਚਿਤ ਹਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "हरि लीनो ज्यों त्यों तृय को चित ॥",
      "sourceLineId": "133971",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮੰਤ੍ਰਹਿ ਲੇਨ ਸੰਜੀਵਨ ਕਾਜਾ ॥",
      "transliteration": "ma(n)treh len sa(n)jeevan kaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਦੇਵਤਿਆਂ ਦੇ ਰਾਜੇ ਨੇ ਛਲ ਪੂਰਵਕ",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "मंत्रहि लेन संजीवन काजा ॥",
      "sourceLineId": "133972",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਹ ਛਲ ਪਠਿਯੋ ਦੇਵਤਨ ਰਾਜਾ ॥੩॥",
      "transliteration": "eeh chhal paThiyo dhevatan raajaa ||3||",
      "translation": "",
      "punjabiViakhya": "ਸੰਜੀਵਨੀ ਮੰਤ੍ਰ ਸਿਖਣ ਲਈ ਭੇਜਿਆ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "इह छल पठियो देवतन राजा ॥३॥",
      "sourceLineId": "133973",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦੈਤ ਭੇਦ ਪਾਵਤ ਜਬ ਭਏ ॥",
      "transliteration": "dhait bhedh paavat jab bhe ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ (ਇਸ) ਭੇਦ ਦਾ ਪਤਾ ਦੈਂਤਾ ਨੂੰ ਲਗ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "दैत भेद पावत जब भए ॥",
      "sourceLineId": "133974",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਾ ਕੋ ਡਾਰਿ ਨਦੀ ਹਨਿ ਗਏ ॥",
      "transliteration": "taa ko ddaar nadhee han ge ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੂੰ ਮਾਰ ਕੇ ਨਦੀ ਵਿਚ ਸੁਟ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "ता को डारि नदी हनि गए ॥",
      "sourceLineId": "133975",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬਿਲਮ ਲਗੀ ਵਹ ਧਾਮ ਨ ਆਯੋ ॥",
      "transliteration": "bilam lagee veh dhaam na aayo ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਕਾਫੀ ਦੇਰ ਹੋ ਗਈ ਅਤੇ ਉਹ ਘਰ ਨਾ ਪਰਤਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "बिलम लगी वह धाम न आयो ॥",
      "sourceLineId": "133976",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦੇਵਜਾਨਿ ਅਤਿ ਹੀ ਦੁਖ ਪਾਯੋ ॥੪॥",
      "transliteration": "dhevajaan at hee dhukh paayo ||4||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਦੇਵਯਾਨੀ ਨੇ ਬਹੁਤ ਦੁਖ ਮਹਿਸੂਸ ਕੀਤਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "देवजानि अति ही दुख पायो ॥४॥",
      "sourceLineId": "133977",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਭਾਖਿ ਪਿਤਾ ਤਨ ਬਹੁਰਿ ਜਿਯਾਯੋ ॥",
      "transliteration": "bhaakh pitaa tan bahur jiyaayo ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਤਾ ਨੂੰ ਕਹਿ ਕੇ ਉਸ ਨੂੰ ਫਿਰ ਜਿਵਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "भाखि पिता तन बहुरि जियायो ॥",
      "sourceLineId": "133978",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਦੈਤਨ ਦੇਖ ਅਧਿਕ ਦੁਖ ਪਾਯੋ ॥",
      "transliteration": "dhaitan dhekh adhik dhukh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤ ਇਹ ਵੇਖ ਕੇ ਬਹੁਤ ਦੁਖੀ ਹੋਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "दैतन देख अधिक दुख पायो ॥",
      "sourceLineId": "133979",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਿਤਿਪ੍ਰਤਿ ਮਾਰਿ ਤਾਹਿ ਉਠਿ ਜਾਵੈ ॥",
      "transliteration": "nitiprat maar taeh uTh jaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਉਸ ਨੂੰ ਰੋਜ਼ ਮਾਰ ਕੇ ਚਲੇ ਜਾਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "नितिप्रति मारि ताहि उठि जावै ॥",
      "sourceLineId": "133980",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਪੁਨਿ ਪੁਨਿ ਤਾ ਕੌ ਸੁਕ੍ਰ ਜਿਯਾਵੈ ॥੫॥",
      "transliteration": "pun pun taa kau sukr jiyaavai ||5||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਬਾਰ ਬਾਰ ਸ਼ੁਕ੍ਰਾਚਾਰੀਆ ਜਿਵਾ ਦਿੰਦਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "पुनि पुनि ता कौ सुक्र जियावै ॥५॥",
      "sourceLineId": "133981",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਤਬ ਤਿਹ ਮਾਰਿ ਮਦ੍ਰਯ ਮਹਿ ਡਾਰਿਯੋ ॥",
      "transliteration": "tab teh maar madhray meh ddaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਉਨ੍ਰਹਾ ਨੇ) ਉਸ ਨੂੰ ਮਾਰ ਕੇ ਸ਼ਰਾਬ ਵਿਚ ਪਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "तब तिह मारि मद्रय महि डारियो ॥",
      "sourceLineId": "133982",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਬਚਤ ਭੂੰਜਿ ਨਿਜੁ ਗੁਰਹਿ ਖਵਾਰਿਯੋ ॥",
      "transliteration": "bachat bhoo(n)j nij gureh khavaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜੋ ਬਚ ਰਿਹਾ, ਉਹ ਭੁੰਨ ਕੇ ਗੁਰੂ ਨੂੰ ਖਵਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "बचत भूँजि निजु गुरहि खवारियो ॥",
      "sourceLineId": "133983",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਦੇਵਜਾਨਿ ਜਬ ਤਾਹਿ ਨ ਲਹਾ ॥",
      "transliteration": "dhevajaan jab taeh na lahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਦੇਵਯਾਨੀ ਨੇ ਉਸ ਨੂੰ ਨਾ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "देवजानि जब ताहि न लहा ॥",
      "sourceLineId": "133984",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਅਧਿਕ ਦੁਖਿਤ ਹ੍ਵੈ ਪਿਤ ਪ੍ਰਤਿ ਕਹਾ ॥੬॥",
      "transliteration": "adhik dhukhit havai pit prat kahaa ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਬਹੁਤ ਦੁਖੀ ਹੋ ਕੇ ਪਿਤਾ ਪ੍ਰਤਿ ਕਿਹਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "अधिक दुखित ह्वै पित प्रति कहा ॥६॥",
      "sourceLineId": "133985",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਅਬ ਲੌ ਕਚ ਜੁ ਧਾਮ ਨਹਿ ਆਯੋ ॥",
      "transliteration": "ab lau kach ju dhaam neh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਤਕ ਕਚ ਘਰ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "अब लौ कच जु धाम नहि आयो ॥",
      "sourceLineId": "133986",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜਨਿਯਤ ਕਿਨਹੂੰ ਅਸੁਰ ਚਬਾਯੋ ॥",
      "transliteration": "janiyat kinahoo(n) asur chabaayo ||",
      "translation": "",
      "punjabiViakhya": "ਲਗਦਾ ਹੈ ਕਿਸੇ ਦੈਂਤ ਨੇ ਉਸ ਨੂੰ ਖਾ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "जनियत किनहूँ असुर चबायो ॥",
      "sourceLineId": "133987",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਤਾ ਤੇ ਪਿਤੁ ਤਿਹ ਬਹੁਰਿ ਜਿਯਾਵੋ ॥",
      "transliteration": "taa te pit teh bahur jiyaavo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਹੇ ਪਿਤਾ ਜੀ! ਉਸ ਨੂੰ ਫਿਰ ਜਿਵਾ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "ता ते पितु तिह बहुरि जियावो ॥",
      "sourceLineId": "133988",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਹਮਰੇ ਮਨ ਕੋ ਸੋਕ ਮਿਟਾਵੋ ॥੭॥",
      "transliteration": "hamare man ko sok miTaavo ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੇ ਮਨ ਦਾ ਗ਼ਮ ਦੂਰ ਕਰ ਦਿਓ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "हमरे मन को सोक मिटावो ॥७॥",
      "sourceLineId": "133989",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਤਬ ਹੀ ਸੁਕ੍ਰ ਧ੍ਯਾਨ ਮਹਿ ਗਏ ॥",
      "transliteration": "tab hee sukr dhayaan meh ge ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਸ਼ੁਕ੍ਰਾਚਾਰੀਆ ਧਿਆਨ ਮਗਨ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "तब ही सुक्र ध्यान महि गए ॥",
      "sourceLineId": "133990",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਤਿਹ ਨਿਜੁ ਪੇਟ ਬਿਲੋਕਤ ਭਏ ॥",
      "transliteration": "teh nij peT bilokat bhe ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਆਪਣੇ ਪੇਟ ਵਿਚ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "तिह निजु पेट बिलोकत भए ॥",
      "sourceLineId": "133991",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਮੰਤ੍ਰ ਸਜੀਵਨ ਕੌ ਕਿਹ ਦੈ ਕਰਿ ॥",
      "transliteration": "ma(n)tr sajeevan kau keh dhai kar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸੰਜੀਵਨੀ ਮੰਤ੍ਰ ਦੇ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "मंत्र सजीवन कौ किह दै करि ॥",
      "sourceLineId": "133992",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਕਾਢਤ ਭਯੋ ਉਦਰ ਅਪਨੋ ਫਰਿ ॥੮॥",
      "transliteration": "kaaddat bhayo udhar apano far ||8||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਪੇਟ ਨੂੰ ਪਾੜ ਕੇ ਕਢਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "काढत भयो उदर अपनो फरि ॥८॥",
      "sourceLineId": "133993",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਕਾਢਤ ਤਾਹਿ ਸੁਕ੍ਰ ਮਰਿ ਗਯੋ ॥",
      "transliteration": "kaaddat taeh sukr mar gayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਕਢਦਿਆਂ ਹੀ ਸ਼ੁਕ੍ਰਾਚਾਰੀਆ ਮਰ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "काढत ताहि सुक्र मरि गयो ॥",
      "sourceLineId": "133994",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਬਹੁਰਿ ਮੰਤ੍ਰ ਬਲ ਕਚਹਿ ਜਿਯਯੋ ॥",
      "transliteration": "bahur ma(n)tr bal kacheh jiyayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਚ ਨੇ ਮੰਤ੍ਰ ਦੇ ਬਲ ਨਾਲ ਉਸ ਨੂੰ ਜੀਵਿਤ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "बहुरि मंत्र बल कचहि जिययो ॥",
      "sourceLineId": "133995",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਸ੍ਰਾਪ ਦਯੋ ਮਦਾ ਕੋ ਤਿਹ ਤਹ ॥",
      "transliteration": "sraap dhayo madhaa ko teh teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਤਦ ਤੋਂ ਸ਼ਰਾਬ ਨੂੰ ਸ੍ਰਾਪ ਦੇ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "स्राप दयो मदा को तिह तह ॥",
      "sourceLineId": "133996",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਤਾ ਤੇ ਪਿਯਤ ਨ ਯਾਕਹ ਕੋਊ ਕਹ ॥੯॥",
      "transliteration": "taa te piyat na yaakeh kouoo keh ||9||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਉਸ ਨੂੰ ਕੋਈ (ਸ਼ਰਾਬ, ਮਦ) ਕਹਿ ਕੇ ਨਹੀਂ ਪੀਂਦਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "ता ते पियत न याकह कोऊ कह ॥९॥",
      "sourceLineId": "133997",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਦੇਵਿਜਾਨ ਪੁਨਿ ਐਸ ਬਿਚਾਰਾ ॥",
      "transliteration": "dhevijaan pun aais bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਯਾਨੀ ਨੇ ਫਿਰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "देविजान पुनि ऐस बिचारा ॥",
      "sourceLineId": "133998",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਯੌ ਕਚ ਤਨ ਤਜਿ ਲਾਜ ਉਚਾਰਾ ॥",
      "transliteration": "yau kach tan taj laaj uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲਾਜ ਨੂੰ ਤਿਆਗ ਕੇ ਕਚ ਪ੍ਰਤਿ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "यौ कच तन तजि लाज उचारा ॥",
      "sourceLineId": "133999",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਮੋ ਸੌ ਤੈ ਕਰੁ ਰੇ ॥",
      "transliteration": "kaam bhog mo sau tai kar re ||",
      "translation": "",
      "punjabiViakhya": "ਅਰੇ! ਮੇਰੇ ਨਾਲ ਕਾਮ-ਭੋਗ ਕਰ",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "काम भोग मो सौ तै करु रे ॥",
      "sourceLineId": "134000",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਹਮਰੇ ਮਦਨ ਤਾਪ ਕਹ ਹਰੁ ਰੇ ॥੧੦॥",
      "transliteration": "hamare madhan taap keh har re ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੀ ਕਾਮ ਅਗਨੀ ਨੂੰ ਸ਼ਾਤ ਕਰ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "हमरे मदन ताप कह हरु रे ॥१०॥",
      "sourceLineId": "134001",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1269_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਤਿਨ ਰਤਿ ਕਰੀ ਨ ਤਾ ਤੇ ਸੰਗਾ ॥",
      "transliteration": "tin rat karee na taa te sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਵੇਾਂ ਉਸ (ਦੇਵਯਾਨੀ) ਦੇ (ਸ਼ਰੀਰ ਵਿਚ) ਕਾਮ ਵਿਆਪਤ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1269,
      "hindi": "",
      "hindiTransliteration": "तिन रति करी न ता ते संगा ॥",
      "sourceLineId": "134002",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
