{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1270,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1270_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬ੍ਯਾਪਿ ਰਹਿਯੋ ਤਿਹ ਜਦਿਪ ਅਨੰਗਾ ॥",
      "transliteration": "bayaap rahiyo teh jadhip ana(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਸ ਨੇ ਉਸ ਨਾਲ ਸੰਯੋਗ ਨਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "ब्यापि रहियो तिह जदिप अनंगा ॥",
      "sourceLineId": "134003",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੇਵਜਾਨਿ ਤਬ ਅਧਿਕ ਰਿਸਾਈ ॥",
      "transliteration": "dhevajaan tab adhik risaiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦੇਵਯਾਨੀ ਬਹੁਤ ਰੋਹ ਵਿਚ ਆ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "देवजानि तब अधिक रिसाई ॥",
      "sourceLineId": "134004",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮੋਹਿ ਨ ਭਜ੍ਯੋ ਯਾਹਿ ਦੁਖਦਾਈ ॥੧੧॥",
      "transliteration": "moh na bhajayo yaeh dhukhadhaiee ||11||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਸ ਦੁਖਦਾਇਕ (ਕਚ) ਨੇ ਮੇਰੇ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਨਹੀਂ ਕੀਤੀ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "मोहि न भज्यो याहि दुखदाई ॥११॥",
      "sourceLineId": "134005",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਸ੍ਰਾਪ ਦੇਤ ਤਿਹ ਭਈ ॥",
      "transliteration": "eeh bidh sraap dhet teh bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਸ੍ਰਾਪ ਦੇ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "इह बिधि स्राप देत तिह भई ॥",
      "sourceLineId": "134006",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਥਾ ਚਉਪਈ ਸੁ ਮੈ ਬਨਈ ॥",
      "transliteration": "kathaa chaupiee su mai baniee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਕਥਾ ਮੈਂ ਚੌਪਈ ਛੰਦ ਵਿਚ ਬੰਨ੍ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "कथा चउपई सु मै बनई ॥",
      "sourceLineId": "134007",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪਾਪੀ ਫੁਰੈ ਮੰਤ੍ਰ ਤਵ ਨਾਹੀ ॥",
      "transliteration": "paapee furai ma(n)tr tav naahee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਾਪੀ! (ਤੈਨੂੰ ਸਮੇਾਂ ਸਿਰ) ਮੰਤ੍ਰ ਨਹੀਂ ਫੁਰੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "पापी फुरै मंत्र तव नाही ॥",
      "sourceLineId": "134008",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤੋ ਤੇ ਸੁਰ ਨ ਜਿਵਾਏ ਜਾਹੀ ॥੧੨॥",
      "transliteration": "to te sur na jivaae jaahee ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੇਰੇ ਕੋਲੋਂ ਦੇਵਤੇ ਜਿਵਾਏ ਨਹੀਂ ਜਾ ਸਕਣਗੇ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "तो ते सुर न जिवाए जाही ॥१२॥",
      "sourceLineId": "134009",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪ੍ਰਥਮ ਜਿਯਾਯੋ ਤਾਹਿ ਕਸਟ ਕਰਿ ॥",
      "transliteration": "pratham jiyaayo taeh kasaT kar ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ (ਦੇਵਯਾਨੀ) ਕਸ਼ਟ ਸਹਿ ਕੇ ਉਸ ਨੂੰ ਜਿਵਾਉਾਂਦੀ ਰਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "प्रथम जियायो ताहि कसट करि ॥",
      "sourceLineId": "134010",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰਮ੍ਯੋ ਨ ਸੋ ਸ੍ਰਾਪ੍ਰਯੋ ਤਬ ਰਿਸਿ ਭਰਿ ॥",
      "transliteration": "ramayo na so sraaprayo tab ris bhar ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਉਸ ਨੇ ਰਮਣ ਨਾ ਕੀਤਾ, ਤਾ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਸ੍ਰਾਪ ਦੇ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "रम्यो न सो स्राप्रयो तब रिसि भरि ॥",
      "sourceLineId": "134011",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪਿਤਾ ਭਏ ਇਹ ਭਾਤਿ ਸੁਨਾਯੋ ॥",
      "transliteration": "pitaa bhe ieh bhaat sunaayo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ (ਉਸ ਨੇ ਆਪਣੇ) ਪਿਤਾ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣਾਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "पिता भए इह भाति सुनायो ॥",
      "sourceLineId": "134012",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦੇਵਰਾਜ ਇਹ ਕਚਹਿ ਪਠਾਯੋ ॥੧੩॥",
      "transliteration": "dhevaraaj ieh kacheh paThaayo ||13||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਕਚ ਨੂੰ ਦੇਵਰਾਜ ਨੇ ਭੇਜਿਆ ਹੈ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "देवराज इह कचहि पठायो ॥१३॥",
      "sourceLineId": "134013",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਾਤ ਬਾਤ ਕਹੋ ਮੈ ਸੋ ਕਰੋ ॥",
      "transliteration": "taat baat kaho mai so karo ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਿਤਾ ਜੀ! ਜੋ ਗੱਲ ਮੈਂ ਕਹਿੰਦੀ ਹਾ, ਉਹੀ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "तात बात कहो मै सो करो ॥",
      "sourceLineId": "134014",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮੰਤ੍ਰ ਸਜੀਵਨ ਇਹ ਨਨੁਸਰੋ ॥",
      "transliteration": "ma(n)tr sajeevan ieh nanusaro ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਸੰਜੀਵਨੀ ਮੰਤ੍ਰ ਦਾ ਅਧਿਕਾਰੀ ਨਾ ਬਣਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "मंत्र सजीवन इह ननुसरो ॥",
      "sourceLineId": "134015",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਬ ਇਹ ਸੀਖਿ ਮੰਤ੍ਰ ਕਹ ਜੈ ਹੈ ॥",
      "transliteration": "jab ieh seekh ma(n)tr keh jai hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਇਹ ਮੰਤ੍ਰ ਸਿਖ ਕੇ ਜਾਏਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "जब इह सीखि मंत्र कह जै है ॥",
      "sourceLineId": "134016",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੇਵਰਾਜ ਫਿਰਿ ਹਾਥ ਨ ਐ ਹੈ ॥੧੪॥",
      "transliteration": "dhevaraaj fir haath na aai hai ||14||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਦੇਵਰਾਜ (ਇੰਦਰ) ਹੱਥ ਨਹੀਂ ਆਵੇਗਾ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "देवराज फिरि हाथ न ऐ है ॥१४॥",
      "sourceLineId": "134017",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮੰਤ੍ਰ ਨ ਫੁਰੈ ਸ੍ਰਾਪ ਇਹ ਦੀਜੈ ॥",
      "transliteration": "ma(n)tr na furai sraap ieh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਸ੍ਰਾਪ ਦਿਓ (ਕਿ ਸਮੇਾਂ ਸਿਰ ਇਸ ਨੂੰ) ਮੰਤ੍ਰ ਨਾ ਫੁਰੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "मंत्र न फुरै स्राप इह दीजै ॥",
      "sourceLineId": "134018",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੇਰੋ ਬਚਨ ਮਾਨਿ ਪਿਤੁ ਲੀਜੈ ॥",
      "transliteration": "mero bachan maan pit leejai ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਿਤਾ ਜੀ! ਮੇਰੀ ਗੱਲ ਮੰਨ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "मेरो बचन मानि पितु लीजै ॥",
      "sourceLineId": "134019",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਕਛੁ ਸੁਕ੍ਰ ਨ ਪਾਯੋ ॥",
      "transliteration": "bhedh abhedh kachh sukr na paayo ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੁਕ੍ਰਾਚਾਰੀਆ ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਾ ਸਮਝ ਸਕਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद कछु सुक्र न पायो ॥",
      "sourceLineId": "134020",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮੰਤ੍ਰ ਨਿਫਲ ਕੋ ਸ੍ਰਾਪੁ ਦਿਵਾਯੋ ॥੧੫॥",
      "transliteration": "ma(n)tr nifal ko sraap dhivaayo ||15||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੰਤ੍ਰ ਦੇ ਨਿਸਫਲ ਹੋਣ ਦਾ ਸ੍ਰਾਪ ਦੇ ਦਿੱਤਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "मंत्र निफल को स्रापु दिवायो ॥१५॥",
      "sourceLineId": "134021",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਾਹਿ ਮਰੇ ਬਹੁ ਬਾਰ ਜਿਯਾਯੋ ॥",
      "transliteration": "taeh mare bahu baar jiyaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਕਚ) ਨੂੰ ਮਰੇ ਹੋਇਆਂ (ਪਹਿਲਾ) ਬਹੁਤ ਵਾਰ ਜੀਵਿਤ ਕਰਵਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "ताहि मरे बहु बार जियायो ॥",
      "sourceLineId": "134022",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਬ ਸ੍ਰਾਪ੍ਰਯੋ ਜਬ ਭੋਗ ਨ ਪਾਯੋ ॥",
      "transliteration": "tab sraaprayo jab bhog na paayo ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਜਦ ਉਸ ਨੇ ਸੰਯੋਗ ਨਾ ਕੀਤਾ, ਤਦ ਸ੍ਰਾਪ ਦੇ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "तब स्राप्रयो जब भोग न पायो ॥",
      "sourceLineId": "134023",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤ੍ਰਿਯ ਚਰਿਤ੍ਰ ਗਤਿ ਕਿਨੂੰ ਨ ਪਾਈ ॥",
      "transliteration": "tiray charitr gat kinoo(n) na paiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਦੇ ਚਰਿਤ੍ਰ ਦੀ ਗਤੀ ਨੂੰ ਕਿਸੇ ਨੇ ਨਹੀਂ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "तृय चरित्र गति किनूँ न पाई ॥",
      "sourceLineId": "134024",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਿਨਿ ਬਿਧਨੈ ਇਹ ਨਾਰਿ ਬਨਾਈ ॥੧੬॥",
      "transliteration": "jin bidhanai ieh naar banaiee ||16||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਵੀ ਨਹੀਂ ਸਮਝ ਸਕਿਆ) ਜਿਸ ਵਿਧਾਤਾ ਨੇ ਇਸ ਇਸਤਰੀ ਨੂੰ ਬਣਾਇਆ ਹੈ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "जिनि बिधनै इह नारि बनाई ॥१६॥",
      "sourceLineId": "134025",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਇਕੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੨੧॥੬੦੫੯॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau ikees charitr samaapatam sat subham sat ||321||6059||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੨੧ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੨੧॥੬੦੫੯॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ इकीस चरित्र समापतम सतु सुभम सतु ॥३२१॥६०५९॥अफजूँ॥",
      "sourceLineId": "134026",
      "sourceShabadId": "12562",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134027",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੁਨੁ ਪ੍ਰਭੁ ਔਰ ਬਖਾਨੋ ਕਥਾ ॥",
      "transliteration": "sun prabh aauar bakhaano kathaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਸੁਣੋ, (ਮੈਂ) ਇਕ ਹੋਰ ਕਥਾ ਕਹਿੰਦਾ ਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "सुनु प्रभु और बखानो कथा ॥",
      "sourceLineId": "134028",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਐਹੈ ਚਿਤ ਹਮਾਰੇ ਜਥਾ ॥",
      "transliteration": "aaihai chit hamaare jathaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕਿ ਉਹ ਮੇਰੇ ਚਿਤ ਵਿਚ ਆਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "ऐहै चित हमारे जथा ॥",
      "sourceLineId": "134029",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਛਜਕਰਨਨ ਕੋ ਦੇਸ ਬਸਤ ਜਹ ॥",
      "transliteration": "chhajakaranan ko dhes basat jeh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਛਜਕਰਨਾ ਦਾ ਦੇਸ ਵਸਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "छजकरनन को देस बसत जह ॥",
      "sourceLineId": "134030",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੁਛਬਿ ਕੇਤੁ ਇਕ ਹੁਤੋ ਨ੍ਰਿਪਤਿ ਤਹ ॥੧॥",
      "transliteration": "suchhab ket ik huto nirapat teh ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸੁਛਬਿ ਕੇਤੁ ਨਾ ਦਾ ਰਾਜਾ ਹੁੰਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "सुछबि केतु इक हुतो नृपति तह ॥१॥",
      "sourceLineId": "134031",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਚਰਜ ਦੇ ਤਾ ਕੇ ਇਕ ਨਾਰੀ ॥",
      "transliteration": "acharaj dhe taa ke ik naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ (ਘਰ) ਅਚਰਜ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਇਕ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "अचरज दे ता के इक नारी ॥",
      "sourceLineId": "134032",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਨਕ ਅਵਟਿ ਸਾਚੇ ਜਨੁ ਢਾਰੀ ॥",
      "transliteration": "kanak avaT saache jan ddaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਸੋਨੇ ਨੂੰ ਪੰਘਾਰ ਕੇ ਸੰਚੇ ਵਿਚ ਢਾਲੀ ਗਈ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "कनक अवटि साचे जनु ढारी ॥",
      "sourceLineId": "134033",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸ੍ਰੀ ਮਕਰਾਛ ਮਤੀ ਦੁਹਿਤਾ ਤਿਹ ॥",
      "transliteration": "sree makaraachh matee dhuhitaa teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਮਕਰਾਛ ਮਤੀ ਨਾ ਦੀ ਪੁੱਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "स्री मकराछ मती दुहिता तिह ॥",
      "sourceLineId": "134034",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਛੀਨਿ ਕਰੀ ਸਸਿ ਅੰਸ ਸਕਲ ਜਿਹ ॥੨॥",
      "transliteration": "chheen karee sas a(n)s sakal jeh ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਚੰਦ੍ਰਮਾ ਦੀਆਂ ਕਲਾਵਾ ਨੂੰ ਖੋਹ ਲਿਆ ਹੋਇਆ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "छीनि करी ससि अंस सकल जिह ॥२॥",
      "sourceLineId": "134035",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਬ ਬਰ ਜੋਗ ਭਈ ਵਹੁ ਦਾਰਾ ॥",
      "transliteration": "jab bar jog bhiee vahu dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਰਾਜ ਕੁਮਾਰੀ ਵਰ ਦੇ ਯੋਗ ਹੋਈ",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "जब बर जोग भई वहु दारा ॥",
      "sourceLineId": "134036",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਾਹੁ ਪੂਤ ਤਨ ਕਿਯਾ ਪ੍ਯਾਰਾ ॥",
      "transliteration": "saahu poot tan kiyaa payaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੇ (ਇਕ) ਸ਼ਾਹ ਦੇ ਪੁੱਤਰ ਨਾਲ ਪ੍ਰੇਮ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "साहु पूत तन किया प्यारा ॥",
      "sourceLineId": "134037",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਾਮ ਕੇਲ ਤਿਹ ਸਾਥ ਕਮਾਵੈ ॥",
      "transliteration": "kaam kel teh saath kamaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ (ਉਹ) ਕਾਮ-ਕੇਲ ਕਰਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "काम केल तिह साथ कमावै ॥",
      "sourceLineId": "134038",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭਾਤਿ ਅਨਿਕ ਤਨ ਤਾਹਿ ਰਿਝਾਵੈ ॥੩॥",
      "transliteration": "bhaat anik tan taeh rijhaavai ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਨੇਕ ਤਰ੍ਰਹਾ ਨਾਲ ਉਸ ਨੂੰ ਪ੍ਰਸੰਨ ਕਰਦੀ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "भाति अनिक तन ताहि रिझावै ॥३॥",
      "sourceLineId": "134039",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨ੍ਰਿਪ ਤਨ ਭੇਦ ਕਿਸੂ ਨਰ ਭਾਖਾ ॥",
      "transliteration": "nirap tan bhedh kisoo nar bhaakhaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਬੰਦੇ ਨੇ ਰਾਜੇ ਨੂੰ ਇਹ ਭੇਦ ਦਸ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "नृप तन भेद किसू नर भाखा ॥",
      "sourceLineId": "134040",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਬ ਤੇ ਤਾਹਿ ਧਾਮ ਅਸਿ ਰਾਖਾ ॥",
      "transliteration": "tab te taeh dhaam as raakhaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤੋਂ (ਰਾਜੇ ਨੇ) ਉਸ ਨੂੰ ਅਜਿਹੇ ਘਰ ਵਿਚ ਰਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "तब ते ताहि धाम असि राखा ॥",
      "sourceLineId": "134041",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਹਾ ਨ ਪੰਛੀ ਕਰੈ ਪ੍ਰਵੇਸਾ ॥",
      "transliteration": "jahaa na pa(n)chhee karai pravesaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਪੰਛੀ ਵੀ ਪ੍ਰਵੇਸ਼ ਨਾ ਕਰ ਸਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "जहा न पंछी करै प्रवेसा ॥",
      "sourceLineId": "134042",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਾਇ ਨ ਜਹਾ ਪਵਨ ਕੋ ਵੇਸਾ ॥੪॥",
      "transliteration": "jai na jahaa pavan ko vesaa ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਥੇ ਪੌਣ ਵੀ ਨਾ ਜਾ ਸਕੇ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "जाइ न जहा पवन को वेसा ॥४॥",
      "sourceLineId": "134043",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕੁਅਰਿ ਮਿਤ੍ਰ ਬਿਨੁ ਬਹੁ ਦੁਖੁ ਪਾਯੋ ॥",
      "transliteration": "kuar mitr bin bahu dhukh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਪ੍ਰੀਤਮ ਤੋਂ ਬਿਨਾ ਬਹੁਤ ਦੁਖ ਪਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "कुअरि मित्र बिनु बहु दुखु पायो ॥",
      "sourceLineId": "134044",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬੀਰ ਹਾਕਿ ਇਕ ਨਿਕਟ ਬੁਲਾਯੋ ॥",
      "transliteration": "beer haak ik nikaT bulaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਬਵੰਜਾ ਬੀਰਾ ਵਿਚੋਂ) ਇਕ ਨੂੰ ਆਵਾਜ਼ ਦੇ ਕੇ ਕੋਲ ਬੁਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "बीर हाकि इक निकट बुलायो ॥",
      "sourceLineId": "134045",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਾ ਸੌ ਕਹਾ ਤਹਾ ਤੁਮ ਜਾਈ ॥",
      "transliteration": "taa sau kahaa tahaa tum jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਕਿਹਾ ਕਿ ਤੂੰ ਉਥੇ ਜਾ",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "ता सौ कहा तहा तुम जाई ॥",
      "sourceLineId": "134046",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਲ੍ਯਾਹੁ ਸਜਨ ਕੀ ਖਾਟਿ ਉਚਾਈ ॥੫॥",
      "transliteration": "layaahu sajan kee khaaT uchaiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੱਜਨ ਦੀ ਮੰਜੀ ਚੁਕ ਕੇ ਲੈ ਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "ल्याहु सजन की खाटि उचाई ॥५॥",
      "sourceLineId": "134047",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੁਨਤ ਬਚਨ ਤਹ ਬੀਰ ਸਿਧਯੋ ॥",
      "transliteration": "sunat bachan teh beer sidhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜ ਕੁਮਾਰੀ ਦਾ) ਬਚਨ ਸੁਣ ਕੇ ਉਹ ਬੀਰ ਚਲਾ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "सुनत बचन तह बीर सिधयो ॥",
      "sourceLineId": "134048",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1270_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਖਾਟ ਉਚਾਇ ਲ੍ਯਾਵਤ ਭਯੋ ॥",
      "transliteration": "khaaT uchai layaavat bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਸੱਜਨ ਸਮੇਤ) ਮੰਜੀ ਨੂੰ ਚੁਕ ਕੇ ਲੈ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": "खाट उचाइ ल्यावत भयो ॥",
