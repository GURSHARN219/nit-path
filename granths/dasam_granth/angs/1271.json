{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1271,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1271_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪਹੁਚਾਯੋ ਗ੍ਰਿਹ ਤਾਹਿ ਤਿਸੀ ਢੰਗ ॥੬॥",
      "transliteration": "pahuchaayo gireh taeh tisee dda(n)g ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਉਸੇ ਢੰਗ ਨਾਲ ਘਰ ਵਾਪਸ ਪਹੁੰਚਾ ਦਿੱਤਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "पहुचायो गृह ताहि तिसी ढंग ॥६॥",
      "sourceLineId": "134051",
      "sourceShabadId": "12563",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "134052",
      "sourceShabadId": "12564",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਤਾ ਕੌ ਪਿਤਾ ਗਯੋ ਸੁਤਾ ਕੇ ਗ੍ਰੇਹ ॥",
      "transliteration": "ek dhivas taa kau pitaa gayo sutaa ke greh ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਰਾਜ ਕੁਮਾਰੀ ਦਾ ਪਿਤਾ ਪੁੱਤਰੀ ਦੇ ਘਰ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "एक दिवस ता कौ पिता गयो सुता के ग्रेह ॥",
      "sourceLineId": "134053",
      "sourceShabadId": "12564",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੇਜ ਦੇਖਿ ਕਰਿ ਦਲਮਲੀ ਚਿਤ ਮਹਿ ਬਢਾ ਸੰਦੇਹ ॥੭॥",
      "transliteration": "sej dhekh kar dhalamalee chit meh baddaa sa(n)dheh ||7||",
      "translation": "",
      "punjabiViakhya": "ਸੇਜ ਨੂੰ ਮਧੋਲਿਆ ਹੋਇਆ ਵੇਖ ਕੇ ਮਨ ਵਿਚ ਸ਼ਕ ਪੈਦਾ ਹੋਇਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "सेज देखि करि दलमली चित महि बढा संदेह ॥७॥",
      "sourceLineId": "134054",
      "sourceShabadId": "12564",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134055",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚਿੰਤਾਤੁਰ ਘਰ ਕੋ ਫਿਰਿ ਆਯੋ ॥",
      "transliteration": "chi(n)taatur ghar ko fir aayo ||",
      "translation": "",
      "punjabiViakhya": "ਚਿੰਤਾਵਾਨ ਹੋ ਕੇ ਘਰ ਨੂੰ ਪਰਤ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "चिंतातुर घर को फिरि आयो ॥",
      "sourceLineId": "134056",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਹਿਰ ਢੰਢੋਰਾ ਐਸ ਦਿਲਾਯੋ ॥",
      "transliteration": "sahir dda(n)ddoraa aais dhilaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਹਿਰ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਢੰਢੋਰਾ ਪਿਟਵਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "सहिर ढंढोरा ऐस दिलायो ॥",
      "sourceLineId": "134057",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੇ ਕੋਈ ਪੁਹਪ ਖਰੀਦਨ ਆਵੈ ॥",
      "transliteration": "je koiee puhap khareedhan aavai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜੇ ਕੋਈ ਫੁਲ ਖਰੀਦਣ ਲਈ ਆਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "जे कोई पुहप खरीदन आवै ॥",
      "sourceLineId": "134058",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮੁਹਿ ਨਿਰਖੇ ਬਿਨੁ ਲੇਨ ਨ ਪਾਵੈ ॥੮॥",
      "transliteration": "muh nirakhe bin len na paavai ||8||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮੇਰੇ ਵੇਖੇ ਬਿਨਾ ਲੈ ਨਾ ਸਕੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "मुहि निरखे बिनु लेन न पावै ॥८॥",
      "sourceLineId": "134059",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪੁਹਪਨ ਸਮੈ ਬਿਕਨ ਜਬ ਭਯੋ ॥",
      "transliteration": "puhapan samai bikan jab bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਫੁਲਾ ਦੇ ਵਿਕਣ ਦਾ ਸਮਾ ਹੋਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "पुहपन समै बिकन जब भयो ॥",
      "sourceLineId": "134060",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਬ ਤਹ ਨ੍ਰਿਪਤਿ ਬਿਲੋਕਨ ਅਯੋ ॥",
      "transliteration": "tab teh nirapat bilokan ayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਾਜਾ ਉਥੇ ਵੇਖਣ ਲਈ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "तब तह नृपति बिलोकन अयो ॥",
      "sourceLineId": "134061",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੋਗੀ ਏਕ ਤਹਾ ਤਬ ਆਯੋ ॥",
      "transliteration": "jogee ek tahaa tab aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਥੇ ਇਕ ਜੋਗੀ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "जोगी एक तहा तब आयो ॥",
      "sourceLineId": "134062",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪੁਹਪ ਪਾਚ ਮਨ ਮੋਲ ਚੁਕਾਯੋ ॥੯॥",
      "transliteration": "puhap paach man mol chukaayo ||9||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਉਸ ਨੇ) ਪੰਜ ਮਣ ਫੁਲਾ ਦਾ ਮੁਲ ਤਾਰਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "पुहप पाच मन मोल चुकायो ॥९॥",
      "sourceLineId": "134063",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਆਇ ਸੁ ਫੂਲ ਮੋਲ ਲੈ ਗਯੋ ॥",
      "transliteration": "aai su fool mol lai gayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਜੋਗੀ) ਆ ਕੇ ਫੁਲ ਮੁੱਲ ਲੈ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "आइ सु फूल मोल लै गयो ॥",
      "sourceLineId": "134064",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪਾਛੋ ਗਹਤ ਨ੍ਰਿਪਤਿ ਤਿਹ ਭਯੋ ॥",
      "transliteration": "paachho gahat nirapat teh bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਉਸ ਦਾ ਪਿਛਾ ਕਰਨਾ ਸ਼ੁਰੂ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "पाछो गहत नृपति तिह भयो ॥",
      "sourceLineId": "134065",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਾਤ ਜਾਤ ਦੋਊ ਗਏ ਗਹਿਰ ਬਨ ॥",
      "transliteration": "jaat jaat dhouoo ge gahir ban ||",
      "translation": "",
      "punjabiViakhya": "ਚਲਦੇ ਚਲਦੇ ਦੋਵੇਾਂ ਸੰਘਣੇ ਬਨ ਵਿਚ ਪਹੁੰਚ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "जात जात दोऊ गए गहिर बन ॥",
      "sourceLineId": "134066",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਹ ਲਖਿ ਜਾਤ ਤੀਸਰੋ ਮਨੁਖ ਨ ॥੧੦॥",
      "transliteration": "jeh lakh jaat teesaro manukh na ||10||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕੋਈ ਤੀਜਾ ਮਨੁੱਖ ਦਿਖਾਈ ਨਹੀਂ ਦਿੰਦਾ ਸੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "जह लखि जात तीसरो मनुख न ॥१०॥",
      "sourceLineId": "134067",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਬ ਜੋਗੀ ਸਰ ਜਟਾ ਉਘਾਰੀ ॥",
      "transliteration": "tab jogee sar jaTaa ughaaree ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਜੋਗੀ ਨੇ ਸਿਰ ਦੀਆਂ ਜਟਾਵਾ ਖੋਲ੍ਰਹ ਦਿੱਤੀਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "तब जोगी सर जटा उघारी ॥",
      "sourceLineId": "134068",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਿਨ ਭੀਤਰ ਤੇ ਨਾਰਿ ਨਿਕਾਰੀ ॥",
      "transliteration": "tin bheetar te naar nikaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਵਿਚੋਂ ਇਕ ਇਸਤਰੀ ਕਢੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "तिन भीतर ते नारि निकारी ॥",
      "sourceLineId": "134069",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਾ ਸੌ ਰਤਿ ਕਰਿ ਕੈ ॥",
      "transliteration": "bhaat bhaat taa sau rat kar kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਭਾਤ ਭਾਤ ਦੀ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "भाति भाति ता सौ रति करि कै ॥",
      "sourceLineId": "134070",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੋਯੋ ਤਾਪ ਮਦਨ ਕੌ ਹਰਿ ਕੈ ॥੧੧॥",
      "transliteration": "soyo taap madhan kau har kai ||11||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮ ਦੇ ਤਾਪ ਨੂੰ ਦੂਰ ਕਰ ਕੇ ਸੌਂ ਗਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "सोयो ताप मदन कौ हरि कै ॥११॥",
      "sourceLineId": "134071",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਬ ਹੀ ਸੋਇ ਸੰਨ੍ਯਾਸੀ ਗਯੋ ॥",
      "transliteration": "jab hee soi sa(n)nayaasee gayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਹੀ ਸੰਨਿਆਸੀ ਸੌਂ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "जब ही सोइ संन्यासी गयो ॥",
      "sourceLineId": "134072",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜੂਤ ਜਟਨ ਤਿਹ ਨਾਰਿ ਛੁਰਯੋ ॥",
      "transliteration": "joot jaTan teh naar chhurayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਇਸਤਰੀ ਨੇ ਜਟਾਵਾ ਦਾ ਜੂੜਾ ਖੋਲ੍ਰਹਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "जूत जटन तिह नारि छुरयो ॥",
      "sourceLineId": "134073",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਹ ਤੇ ਪੁਰਖ ਏਕ ਤਿਹ ਕਾਢਾ ॥",
      "transliteration": "teh te purakh ek teh kaaddaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਿਚੋਂ ਉਸ ਨੇ ਇਕ ਪੁਰਸ਼ ਨੂੰ ਕਢਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "तह ते पुरख एक तिह काढा ॥",
      "sourceLineId": "134074",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਾ ਸੌ ਕਰਿ ਗਾਢਾ ॥੧੨॥",
      "transliteration": "kaam bhog taa sau kar gaaddaa ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਖ਼ੂਬ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "काम भोग ता सौ करि गाढा ॥१२॥",
      "sourceLineId": "134075",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨ੍ਰਿਪ ਠਾਢੋ ਤਿਹ ਚਰਿਤ ਨਿਹਾਰਾ ॥",
      "transliteration": "nirap Thaaddo teh charit nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਖੜੋ ਕੇ ਇਹ ਸਾਰਾ ਚਰਿਤ੍ਰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "नृप ठाढो तिह चरित निहारा ॥",
      "sourceLineId": "134076",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੋਰਿ ਹਾਥ ਜੋਗਿਯਹਿ ਉਚਾਰਾ ॥",
      "transliteration": "jor haath jogiyeh uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੱਥ ਜੋੜ ਕੇ ਜੋਗੀ ਨੂੰ ਕਹਿਣ ਲਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "जोरि हाथ जोगियहि उचारा ॥",
      "sourceLineId": "134077",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮੋ ਗ੍ਰਿਹ ਕਾਲ ਕ੍ਰਿਪਾ ਕਰਿ ਐਯੋ ॥",
      "transliteration": "mo gireh kaal kirapaa kar aaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਘਰ ਕਲ ਕ੍ਰਿਪਾ ਕਰ ਕੇ ਆਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "मो गृह काल कृपा करि ऐयो ॥",
      "sourceLineId": "134078",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਥਾ ਸਕਤਿ ਭੋਜਨ ਕਰਿ ਜੈਯੋ ॥੧੩॥",
      "transliteration": "jathaa sakat bhojan kar jaiyo ||13||",
      "translation": "",
      "punjabiViakhya": "ਯਥਾਸ਼ਕਤੀ ਭੋਜਨ ਜੇਵਨ ਕਰੋ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "जथा सकति भोजन करि जैयो ॥१३॥",
      "sourceLineId": "134079",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪ੍ਰਾਤ ਗਯੋ ਸੰਨ੍ਯਾਸੀ ਤਿਹ ਘਰ ॥",
      "transliteration": "praat gayo sa(n)nayaasee teh ghar ||",
      "translation": "",
      "punjabiViakhya": "(ਅਗਲੇ ਦਿਨ) ਸਵੇਰੇ ਸ਼ਰੀਰ ਉਤੇ ਭਗਵਾ ਭੇਸ ਧਾਰਨ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "प्रात गयो संन्यासी तिह घर ॥",
      "sourceLineId": "134080",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭਗਵਾ ਭੇਸ ਸਕਲ ਤਨ ਮੈ ਧਰਿ ॥",
      "transliteration": "bhagavaa bhes sakal tan mai dhar ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਨਿਆਸੀ ਉਸ (ਰਾਜੇ) ਦੇ ਘਰ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "भगवा भेस सकल तन मै धरि ॥",
      "sourceLineId": "134081",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਪ੍ਰਭਾ ਬਨਾਈ ॥",
      "transliteration": "bhaat bhaat tan prabhaa banaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਭਾਤ ਭਾਤ ਨਾਲ ਆਪਣੇ ਸ਼ਰੀਰ ਦੀ ਪ੍ਰਭੁਤਾ ਨੂੰ ਬਣਾਇਆ ਹੋਇਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन प्रभा बनाई ॥",
      "sourceLineId": "134082",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਹਾ ਧਰਮ ਸੋ ਜਨਿਯੋ ਜਾਈ ॥੧੪॥",
      "transliteration": "mahaa dharam so janiyo jaiee ||14||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਜੋ ਮਹਾਨ ਧਰਮੀ ਵਜੋਂ ਜਾਣਿਆ ਜਾ ਸਕੇ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "महा धरम सो जनियो जाई ॥१४॥",
      "sourceLineId": "134083",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੰਨ੍ਯਾਸੀ ਕਹ ਨ੍ਰਿਪ ਆਗੇ ਧਰਿ ॥",
      "transliteration": "sa(n)nayaasee keh nirap aage dhar ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਨਿਆਸੀ ਨੂੰ ਅਗੇ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "संन्यासी कह नृप आगे धरि ॥",
      "sourceLineId": "134084",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੁਹਿਤਾ ਕੇ ਰਾਜਾ ਆਯੋ ਘਰ ॥",
      "transliteration": "dhuhitaa ke raajaa aayo ghar ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਪੁੱਤਰੀ ਦੇ ਘਰ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "दुहिता के राजा आयो घर ॥",
      "sourceLineId": "134085",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤੀਨ ਥਾਲ ਭੋਜਨ ਕੇ ਭਰਿ ਕੈ ॥",
      "transliteration": "teen thaal bhojan ke bhar kai ||",
      "translation": "",
      "punjabiViakhya": "ਭੋਜਨ ਦੇ ਤਿੰਨ ਥਾਲ ਭਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "तीन थाल भोजन के भरि कै ॥",
      "sourceLineId": "134086",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਆਗੇ ਰਾਖੇ ਬਚਨ ਉਚਰਿ ਕੈ ॥੧੫॥",
      "transliteration": "aage raakhe bachan uchar kai ||15||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਸੰਨਿਆਸੀ ਦੇ) ਅਗੇ ਰਖੇ ਅਤੇ (ਖਾਣ ਲਈ) ਕਿਹਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "आगे राखे बचन उचरि कै ॥१५॥",
      "sourceLineId": "134087",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਬਚਨ ਕਹੇ ਸੰਨ੍ਯਾਸੀ ॥",
      "transliteration": "eeh bidh bachan kahe sa(n)nayaasee ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਨਿਆਸੀ ਨੇ (ਅਗੋਂ) ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "इह बिधि बचन कहे संन्यासी ॥",
      "sourceLineId": "134088",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਹਾ ਕਰਤ ਹੈ ਮੁਹਿ ਤਨ ਹਾਸੀ ॥",
      "transliteration": "kahaa karat hai muh tan haasee ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਮੇਰੇ ਨਾਲ ਹਾਸੀ ਕਿਉਾਂ ਕਰ ਰਹੇ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "कहा करत है मुहि तन हासी ॥",
      "sourceLineId": "134089",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਏਕ ਮਨੁਛ ਹੌ ਇਤਨੌ ਭੋਜਨ ॥",
      "transliteration": "ek manuchh hau itanau bhojan ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਇਕ ਮਨੁੱਖ ਹਾ ਅਤੇ ਇਤਨਾ ਭੋਜਨ",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "एक मनुछ हौ इतनौ भोजन ॥",
      "sourceLineId": "134090",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਖਾਯੋ ਜਾਇ ਕਵਨ ਬਿਧਿ ਮੋ ਤਨ ॥੧੬॥",
      "transliteration": "khaayo jai kavan bidh mo tan ||16||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਕਿਸ ਤਰ੍ਰਹਾ ਖਾ ਸਕਾਗਾ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "खायो जाइ कवन बिधि मो तन ॥१६॥",
      "sourceLineId": "134091",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਏਕ ਥਾਰ ਭੋਜਨ ਤੁਮ ਕਰੋ ॥",
      "transliteration": "ek thaar bhojan tum karo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ ਉੱਤਰ ਦਿੱਤਾ) ਇਕ ਥਾਲ ਦਾ ਭੋਜਨ ਤੁਸੀਂ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "एक थार भोजन तुम करो ॥",
      "sourceLineId": "134092",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦੁਤਿਯ ਜਟਨ ਮੈ ਤਿਹ ਅਨਸਰੋ ॥",
      "transliteration": "dhutiy jaTan mai teh anasaro ||",
      "translation": "",
      "punjabiViakhya": "ਦੂਜਾ ਥਾਲ ਜਟਾਵਾ (ਵਿਚਲੇ) ਬੰਦੇ ਵਾਸਤੇ ਵਰਤੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "दुतिय जटन मै तिह अनसरो ॥",
      "sourceLineId": "134093",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਹ ਤਿਹ ਭਾਤਿ ਜਟਾ ਛੁਰਵਾਇ ॥",
      "transliteration": "jeh teh bhaat jaTaa chhuravai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਜਟਾਵਾ ਨੂੰ ਖੋਲ੍ਰਹ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "जिह तिह भाति जटा छुरवाइ ॥",
      "sourceLineId": "134094",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਹ ਤੇ ਨਾਰਿ ਨਿਕਾਸੀ ਰਾਇ ॥੧੭॥",
      "transliteration": "teh te naar nikaasee rai ||17||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਵਿਚੋਂ ਰਾਜੇ ਨੇ ਇਸਤਰੀ ਨੂੰ ਕਢਿਆ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "तह ते नारि निकासी राइ ॥१७॥",
      "sourceLineId": "134095",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤ੍ਰਿਤਿਯ ਥਾਰ ਆਗੇ ਤਿਹ ਰਾਖਾ ॥",
      "transliteration": "tiratiy thaar aage teh raakhaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਤੀਜਾ ਥਾਲ ਉਸ ਦੇ ਅਗੇ ਰਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "तृतिय थार आगे तिह राखा ॥",
      "sourceLineId": "134096",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਿਹਸਿ ਬਚਨ ਤਾ ਸੌ ਨ੍ਰਿਪ ਭਾਖਾ ॥",
      "transliteration": "bihas bachan taa sau nirap bhaakhaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹਸ ਕੇ ਉਸ ਨੂੰ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "बिहसि बचन ता सौ नृप भाखा ॥",
      "sourceLineId": "134097",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1271_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕੇਸ ਫਾਸ ਤੇ ਪੁਰਖ ਨਿਕਾਰਹੁ ॥",
      "transliteration": "kes faas te purakh nikaarahu ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਕੇਸਾ ਦੇ ਜੂੜੇ ਤੋਂ ਪੁਰਸ਼ ਨੂੰ ਕਢੋ",
      "source": "DASAM_GRANTH",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": "केस फास ते पुरख निकारहु ॥",
      "sourceLineId": "134098",
      "sourceShabadId": "12565",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
