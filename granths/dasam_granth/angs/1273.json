{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1273,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1273_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕੁਅਰ ਬਿਲੋਕ ਥਕਿਤ ਹ੍ਵੈ ਰਹੀ ॥",
      "transliteration": "kuar bilok thakit havai rahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਕੁਮਾਰ ਨੂੰ ਵੇਖ ਕੇ ਨਿਢਾਲ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "कुअर बिलोक थकित ह्वै रही ॥",
      "sourceLineId": "134147",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਹੌਸ ਮਿਲਨ ਕੀ ਹ੍ਰਿਦੈ ਬਢਾਈ ॥",
      "transliteration": "hauas milan kee hiradhai baddaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਮਿਲਣ ਦੀ ਇੱਛਾ ਹਿਰਦੇ ਵਿਚ ਵਧਾ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "हौस मिलन की हृदै बढाई ॥",
      "sourceLineId": "134148",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਏਕ ਸਹਚਰੀ ਤਹਾ ਪਠਾਈ ॥੫॥",
      "transliteration": "ek sahacharee tahaa paThaiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਸਖੀ ਉਸ (ਕੁਮਾਰ ਪਾਸ) ਭੇਜੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "एक सहचरी तहा पठाई ॥५॥",
      "sourceLineId": "134149",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਖੀ ਕੁਅਰ ਤਨ ਬ੍ਰਿਥਾ ਜਨਾਈ ॥",
      "transliteration": "sakhee kuar tan birathaa janaiee ||",
      "translation": "",
      "punjabiViakhya": "ਸਖੀ ਨੇ ਕੁਮਾਰ ਨੂੰ ਸਾਰੀ ਗੱਲ ਦਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "सखी कुअर तन बृथा जनाई ॥",
      "sourceLineId": "134150",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਾਹ ਸੁਤਾ ਤਵ ਹੇਰਿ ਲੁਭਾਈ ॥",
      "transliteration": "saeh sutaa tav her lubhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਤੈਨੂੰ ਵੇਖ ਕੇ ਮੋਹਿਤ ਹੋ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "साह सुता तव हेरि लुभाई ॥",
      "sourceLineId": "134151",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਰਹੁ ਸਜਨ ਤਿਹ ਧਾਮ ਪਯਾਨਾ ॥",
      "transliteration": "karahu sajan teh dhaam payaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸੱਜਨ! ਉਸ ਦੇ ਘਰ ਨੂੰ ਚਲੋ",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "करहु सजन तिह धाम पयाना ॥",
      "sourceLineId": "134152",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭੋਗ ਕਰੋ ਵਾ ਸੌ ਬਿਧਿ ਨਾਨਾ ॥੬॥",
      "transliteration": "bhog karo vaa sau bidh naanaa ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਕਈ ਪ੍ਰਕਾਰ ਦੀ ਰਤੀ-ਕ੍ਰੀੜਾ ਕਰੋ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "भोग करो वा सौ बिधि नाना ॥६॥",
      "sourceLineId": "134153",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦ੍ਵੈ ਹੈਗੇ ਇਹ ਨਗਰ ਖੁਦਾਈ ॥",
      "transliteration": "dhavai haige ieh nagar khudhaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਕੁਮਾਰ ਨੇ ਸਖੀ ਹੱਥ ਸੁਨੇਹਾ ਭੇਜਿਆ ਕਿ) ਇਸ ਨਗਰ ਵਿਚ ਦੋ ਮੌਲਾਣੇ ('ਖੁਦਾਈ') ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "द्वै हैगे इह नगर खुदाई ॥",
      "sourceLineId": "134154",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਿਨ ਦੁਹੂੰਅਨ ਮੌ ਰਾਰਿ ਬਢਾਈ ॥",
      "transliteration": "tin dhuhoo(n)an mau raar baddaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੋਹਾ ਨੇ ਮੇਰੇ ਨਾਲ ਝਗੜਾ ਵਧਾਇਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "तिन दुहूँअन मौ रारि बढाई ॥",
      "sourceLineId": "134155",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜੌ ਤੂ ਦੁਹੂੰ ਜਿਯਨ ਤੈ ਮਾਰੈ ॥",
      "transliteration": "jau too dhuhoo(n) jiyan tai maarai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੂੰ ਉਨ੍ਰਹਾ ਦੋਹਾ ਨੂੰ ਜਾਨੋ ਮਾਰ ਦੇਵੇਾਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "जौ तू दुहूँ जियन तै मारै ॥",
      "sourceLineId": "134156",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਹੁਰਿ ਹਮਾਰੋ ਸਾਥ ਬਿਹਾਰੈ ॥੭॥",
      "transliteration": "bahur hamaaro saath bihaarai ||7||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਫਿਰ ਮੇਰੇ ਨਾਲ ਰਮਣ ਕਰੀਂ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "बहुरि हमारो साथ बिहारै ॥७॥",
      "sourceLineId": "134157",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੁਨਿ ਬਚ ਭੇਸ ਤੁਰਕ ਤ੍ਰਿਯ ਧਰਾ ॥",
      "transliteration": "sun bach bhes turak tiray dharaa ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ) ਗੱਲ ਸੁਣ ਕੇ ਕੁਮਾਰੀ ਨੇ ਤੁਰਕ ਦਾ ਭੇਸ ਧਾਰਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "सुनि बच भेस तुरक तृय धरा ॥",
      "sourceLineId": "134158",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਾਨਾ ਵਹੈ ਆਪਨੋ ਕਰਾ ॥",
      "transliteration": "baanaa vahai aapano karaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣਾ ਉਹੀ ਬਾਣਾ ਬਣਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "बाना वहै आपनो करा ॥",
      "sourceLineId": "134159",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਗਹਿ ਕ੍ਰਿਪਾਨ ਤਿਹ ਕਿਯੋ ਪਯਾਨਾ ॥",
      "transliteration": "geh kirapaan teh kiyo payaanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਕ੍ਰਿਪਾਨ ਪਕੜ ਕੇ ਉਥੋਂ ਲਈ ਪ੍ਰਸਥਾਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "गहि कृपान तिह कियो पयाना ॥",
      "sourceLineId": "134160",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਹਾ ਨਿਮਾਜੀ ਪੜਤ ਦੁਗਾਨਾ ॥੮॥",
      "transliteration": "jahaa nimaajee paRat dhugaanaa ||8||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਨਮਾਜ਼ੀ ਨਮਾਜ਼ ਪੜ੍ਰਹ ਰਹੇ ਸਨ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "जहा निमाजी पड़त दुगाना ॥८॥",
      "sourceLineId": "134161",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਬ ਹੀ ਪੜੀ ਨਿਮਾਜ ਤਿਨੋ ਸਬ ॥",
      "transliteration": "jab hee paRee nimaaj tino sab ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਨ੍ਰਹਾ ਸਭ ਨੇ ਨਮਾਜ਼ ਪੜ੍ਰਹ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "जब ही पड़ी निमाज तिनो सब ॥",
      "sourceLineId": "134162",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਿਜਦਾ ਬਿਖੈ ਸੁ ਗਏ ਤੁਰਕ ਜਬ ॥",
      "transliteration": "sijadhaa bikhai su ge turak jab ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਦ (ਉਹ) ਤੁਰਕ ਸਿਜਦਾ (ਪ੍ਰਨਾਮ) ਕਰਨ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "सिजदा बिखै सु गए तुरक जब ॥",
      "sourceLineId": "134163",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਬ ਇਹ ਘਾਤ ਭਲੀ ਕਰਿ ਪਾਈ ॥",
      "transliteration": "tab ieh ghaat bhalee kar paiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਹ ਚੰਗਾ ਮੌਕਾ ਤਾੜ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "तब इह घात भली करि पाई ॥",
      "sourceLineId": "134164",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਾਟਿ ਮੂੰਡ ਦੁਹੂੰਅਨ ਕੇ ਆਈ ॥੯॥",
      "transliteration": "kaaT moo(n)dd dhuhoo(n)an ke aaiee ||9||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਦੇ ਸਿਰ ਕਟ ਕੇ ਆ ਗਈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "काटि मूँड दुहूँअन के आई ॥९॥",
      "sourceLineId": "134165",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਦੋਊ ਖੁਦਾਈ ਮਾਰੇ ॥",
      "transliteration": "eeh bidh dhouoo khudhaiee maare ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦੋਵੇਾਂ ਮੌਲਾਣੇ ਮਾਰ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "इह बिधि दोऊ खुदाई मारे ॥",
      "sourceLineId": "134166",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰਮੀ ਆਨਿ ਕਰਿ ਸਾਥ ਪ੍ਯਾਰੇ ॥",
      "transliteration": "ramee aan kar saath payaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਿਆਰੇ ਨਾਲ ਆ ਕੇ ਰਮਣ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "रमी आनि करि साथ प्यारे ॥",
      "sourceLineId": "134167",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨੀ ਬਿਚਾਰਾ ॥",
      "transliteration": "bhedh abhedh na kinee bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਵੀ ਭੇਦ ਅਭੇਦ ਨਾ ਵਿਚਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न किनी बिचारा ॥",
      "sourceLineId": "134168",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਿਨਹੀ ਦੁਸਟ ਕਹਿਯੋ ਇਨ ਮਾਰਾ ॥੧੦॥",
      "transliteration": "kinahee dhusaT kahiyo in maaraa ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਹਿੰਦੇ ਰਹੇ ਕਿ ਕਿਸੇ ਦੁਸ਼ਟ ਨੇ ਇਨ੍ਰਹਾ ਨੂੰ ਮਾਰਿਆ ਹੈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "किनही दुसट कहियो इन मारा ॥१०॥",
      "sourceLineId": "134169",
      "sourceShabadId": "12566",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "134170",
      "sourceShabadId": "12567",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਾਰਿ ਖੁਦਾਇਨ ਦੁਹੂੰ ਕਹ ਬਰਿਯੋ ਆਨਿ ਕਰ ਮਿਤ ॥",
      "transliteration": "maar khudhain dhuhoo(n) keh bariyo aan kar mit ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਮੌਲਾਣਿਆਂ ਨੂੰ ਮਾਰ ਕੇ ਆਪਣੇ ਮਿਤਰ ਨੂੰ ਆ ਕੇ ਵਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "मारि खुदाइन दुहूँ कह बरियो आनि कर मित ॥",
      "sourceLineId": "134171",
      "sourceShabadId": "12567",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੇਵ ਅਦੇਵ ਨ ਪਾਵਹੀ ਅਬਲਾਨ ਕੇ ਚਰਿਤ ॥੧੧॥",
      "transliteration": "dhev adhev na paavahee abalaan ke charit ||11||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤੇ ਅਤੇ ਦੈਂਤ ਇਸਤਰੀਆਂ ਦੇ ਚਰਿਤ੍ਰ ਨੂੰ ਨਹੀਂ ਸਮਝ ਸਕਦੇ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "देव अदेव न पावही अबलान के चरित ॥११॥",
      "sourceLineId": "134172",
      "sourceShabadId": "12567",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਤੇਈਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੨੩॥੬੦੯੫॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau teiees charitr samaapatam sat subham sat ||323||6095||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੨੩ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੨੩॥੬੦੯੫॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ तेईस चरित्र समापतम सतु सुभम सतु ॥३२३॥६०९५॥अफजूँ॥",
      "sourceLineId": "134173",
      "sourceShabadId": "12567",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134174",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮੰਤ੍ਰੀ ਕਥਾ ਉਚਾਰਨ ਲਾਗਾ ॥",
      "transliteration": "ma(n)tree kathaa uchaaran laagaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੰਤ੍ਰੀ (ਫਿਰ ਇਕ) ਕਥਾ ਦਾ ਉਚਾਰਨ ਕਰਨ ਲਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "मंत्री कथा उचारन लागा ॥",
      "sourceLineId": "134175",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਾ ਕੇ ਰਸ ਰਾਜਾ ਅਨੁਰਾਗਾ ॥",
      "transliteration": "jaa ke ras raajaa anuraagaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਰਸ ਵਿਚ ਰਾਜਾ ਮਗਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "जा के रस राजा अनुरागा ॥",
      "sourceLineId": "134176",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੂਰਤਿ ਸੈਨ ਨ੍ਰਿਪਤਿ ਇਕ ਸੂਰਤਿ ॥",
      "transliteration": "soorat sain nirapat ik soorat ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਤ ਵਿਚ ਸੂਰਤਿ ਸੈਨ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "सूरति सैन नृपति इक सूरति ॥",
      "sourceLineId": "134177",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਾਨੁਕ ਦੁਤਿਯ ਮੈਨ ਕੀ ਮੂਰਤਿ ॥੧॥",
      "transliteration": "jaanuk dhutiy main kee moorat ||1||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਕਾਮ ਦੇਵ ਦੀ ਦੂਜੀ ਮੂਰਤ ਹੋਵੇ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "जानुक दुतिय मैन की मूरति ॥१॥",
      "sourceLineId": "134178",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਛ੍ਰਾ ਦੇਇ ਸਦਨ ਤਿਹ ਨਾਰੀ ॥",
      "transliteration": "achhraa dhei sadhan teh naaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਛ੍ਰਾ ਦੇਈ ਨਾ ਦੀ ਉਸ ਦੇ ਘਰ ਇਸਤਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "अछ्रा देइ सदन तिह नारी ॥",
      "sourceLineId": "134179",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਨਕ ਅਵਟਿ ਸਾਚੈ ਜਨ ਢਾਰੀ ॥",
      "transliteration": "kanak avaT saachai jan ddaaree ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸੋਨੇ ਨੂੰ ਪੰਘਾਰ ਕੇ ਸੰਚੇ ਵਿਚ ਢਾਲੀ ਗਈ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "कनक अवटि साचै जन ढारी ॥",
      "sourceLineId": "134180",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਪਸਰ ਮਤੀ ਸੁਤਾ ਤਿਹ ਸੋਹੈ ॥",
      "transliteration": "apasar matee sutaa teh sohai ||",
      "translation": "",
      "punjabiViakhya": "ਅਪਸਰ ਮਤੀ ਉਨ੍ਰਹਾ ਦੀ ਪੁੱਤਰੀ ਹੁੰਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "अपसर मती सुता तिह सोहै ॥",
      "sourceLineId": "134181",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੁਰ ਨਰ ਨਾਗ ਅਸੁਰ ਮਨ ਮੋਹੈ ॥੨॥",
      "transliteration": "sur nar naag asur man mohai ||2||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ) ਦੇਵਤੇ, ਮਨੁੱਖ, ਨਾਗ ਅਤੇ ਦੈਂਤ ਆਦਿ ਦੇ ਮਨ ਮੋਹੇ ਜਾਦੇ ਸਨ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "सुर नर नाग असुर मन मोहै ॥२॥",
      "sourceLineId": "134182",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੁਰਿਦ ਸੈਨ ਇਕ ਸਾਹ ਪੁਤ੍ਰ ਤਹ ॥",
      "transliteration": "suridh sain ik saeh putr teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਸੁਰਿਦ ਸੈਨ ਨਾ ਦਾ ਇਕ ਸ਼ਾਹ ਦਾ ਪੁੱਤਰ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "सुरिद सैन इक साह पुत्र तह ॥",
      "sourceLineId": "134183",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਿਹ ਸਮ ਦੂਸਰ ਭਯੋ ਨ ਮਹਿ ਮਹ ॥",
      "transliteration": "jeh sam dhoosar bhayo na meh meh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਧਰਤੀ ਉਤੇ ਕੋਈ ਦੂਜਾ ਨਹੀਂ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "जिह सम दूसर भयो न महि मह ॥",
      "sourceLineId": "134184",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਤਿਹ ਊਪਰ ਅਟਕੀ ॥",
      "transliteration": "raaj sutaa teh uoopar aTakee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਉਸ ਉਤੇ ਮੋਹਿਤ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "राज सुता तिह ऊपर अटकी ॥",
      "sourceLineId": "134185",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਿਸਰਿ ਗਈ ਸਭ ਹੀ ਸੁਧਿ ਘਟ ਕੀ ॥੩॥",
      "transliteration": "bisar giee sabh hee sudh ghaT kee ||3||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸ਼ਰੀਰ ਦੀ ਸਾਰੀ ਸੁੱਧ ਬੁੱਧ ਭੁਲ ਗਈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "बिसरि गई सभ ही सुधि घट की ॥३॥",
      "sourceLineId": "134186",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚਤੁਰਿ ਸਹਚਰੀ ਤਹਾ ਪਠਾਈ ॥",
      "transliteration": "chatur sahacharee tahaa paThaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਇਕ) ਸਿਆਣੀ ਸਖੀ ਨੂੰ ਉਥੇ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "चतुरि सहचरी तहा पठाई ॥",
      "sourceLineId": "134187",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਾਰਿ ਭੇਸ ਕਰਿ ਤਿਹ ਲੈ ਆਈ ॥",
      "transliteration": "naar bhes kar teh lai aaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਉਸ ਨੂੰ ਨਾਰੀ ਦਾ ਭੇਸ ਬਣਾ ਕੇ ਉਥੇ ਲੈ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "नारि भेस करि तिह लै आई ॥",
      "sourceLineId": "134188",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਬ ਵਹੁ ਤਰੁਨ ਤਰੁਨਿਯਹਿ ਪਾਯੋ ॥",
      "transliteration": "jab vahu tarun taruniyeh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਜਵਾਨ ਨੂੰ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਪ੍ਰਾਪਤ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "जब वहु तरुन तरुनियहि पायो ॥",
      "sourceLineId": "134189",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਭਜਿ ਗਰੇ ਲਗਾਯੋ ॥੪॥",
      "transliteration": "bhaat bhaat bhaj gare lagaayo ||4||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਕਈ ਤਰ੍ਰਹਾ ਨਾਲ ਰਤੀ-ਕ੍ਰੀੜਾ ਕਰ ਕੇ (ਉਸ ਨੂੰ) ਗਲੇ ਨਾਲ ਲਗਾਇਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "भाति भाति भजि गरे लगायो ॥४॥",
      "sourceLineId": "134190",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਆਸਨ ਲੈ ਕੈ ॥",
      "transliteration": "bhaat bhaat ke aasan lai kai ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦੇ ਆਸਣ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के आसन लै कै ॥",
      "sourceLineId": "134191",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਚੁੰਬਨ ਕੈ ਕੈ ॥",
      "transliteration": "bhaat bhaat tan chu(n)ban kai kai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤਰ੍ਰਹਾ ਤਰ੍ਰਹਾ ਦੇ ਚੁੰਬਨ ਕਰ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन चुँबन कै कै ॥",
      "sourceLineId": "134192",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਿਹ ਤਿਹ ਬਿਧਿ ਤਾ ਕੋ ਬਿਰਮਾਯੋ ॥",
      "transliteration": "teh teh bidh taa ko biramaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਅਨੇਕ ਢੰਗਾ ਨਾਲ ਭਰਮਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "तिह तिह बिधि ता को बिरमायो ॥",
      "sourceLineId": "134193",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1273_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗ੍ਰਿਹ ਜੈਬੋ ਤਿਨਹੂੰ ਸੁ ਭੁਲਾਯੋ ॥੫॥",
      "transliteration": "gireh jaibo tinahoo(n) su bhulaayo ||5||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਉਸ ਨੂੰ ਘਰ ਜਾਣਾ ਭੁਲਾ ਦਿੱਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1273,
      "hindi": "",
      "hindiTransliteration": "गृह जैबो तिनहूँ सु भुलायो ॥५॥",
      "sourceLineId": "134194",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
