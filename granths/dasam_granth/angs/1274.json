{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1274,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1274_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਖੀ ਭੇਸ ਕਹ ਧਾਰੇ ਰਹੈ ॥",
      "transliteration": "sakhee bhes keh dhaare rahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸਖੀ ਦਾ ਭੇਸ ਧਾਰੇ ਹੋਇਆਂ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "सखी भेस कह धारे रहै ॥",
      "sourceLineId": "134195",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੋਈ ਕਰੈ ਜੁ ਅਬਲਾ ਕਹੈ ॥",
      "transliteration": "soiee karai ju abalaa kahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹੀ ਕਰਦਾ ਜੋ ਰਾਜ ਕੁਮਾਰੀ ਚਾਹੁੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "सोई करै जु अबला कहै ॥",
      "sourceLineId": "134196",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰੋਜ ਭਜੈ ਆਸਨ ਤਿਹ ਲੈ ਕੈ ॥",
      "transliteration": "roj bhajai aasan teh lai kai ||",
      "translation": "",
      "punjabiViakhya": "ਰੋਜ ਆਸਣ ਲੈ ਕੇ ਉਸ ਨਾਲ ਕੇਲ ਕਰਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "रोज भजै आसन तिह लै कै ॥",
      "sourceLineId": "134197",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਾ ਕਹੁ ਸੁਖ ਦੈ ਕੈ ॥੬॥",
      "transliteration": "bhaat bhaat taa kahu sukh dhai kai ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦੇ ਸੁਖ ਉਸ ਨੂੰ ਦਿੰਦਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "भाति भाति ता कहु सुख दै कै ॥६॥",
      "sourceLineId": "134198",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪਿਤ ਤਿਹ ਨਿਰਖੈ ਭੇਦ ਨ ਜਾਨੈ ॥",
      "transliteration": "pit teh nirakhai bhedh na jaanai ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਤਾ ਉਸ ਨੂੰ ਵੇਖ ਕੇ (ਅਸਲ) ਭੇਦ ਨਹੀਂ ਸਮਝਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "पित तिह निरखै भेद न जानै ॥",
      "sourceLineId": "134199",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਦੁਹਿਤਾ ਕੀ ਤਿਹ ਸਖੀ ਪ੍ਰਮਾਨੈ ॥",
      "transliteration": "dhuhitaa kee teh sakhee pramaanai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਪੁੱਤਰੀ ਦੀ ਸਖੀ ਹੀ ਸਮਝਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "दुहिता की तिह सखी प्रमानै ॥",
      "sourceLineId": "134200",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਜੜ ਕੋਇ ਨ ਲਹਹੀ ॥",
      "transliteration": "bhedh abhedh jaR koi na lahahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮੂਰਖ ਭੇਦ ਅਭੇਦ ਕੁਝ ਨਹੀਂ ਜਾਣਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद जड़ कोइ न लहही ॥",
      "sourceLineId": "134201",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਵਾ ਕੀ ਤਾਹਿ ਖਵਾਸਿਨਿ ਕਰਹੀ ॥੭॥",
      "transliteration": "vaa kee taeh khavaasin karahee ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਉਸ ਦੀ ਜਿਗਰੀ ਸਾਥਣ ਸਮਝਦਾ ਸੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "वा की ताहि खवासिनि करही ॥७॥",
      "sourceLineId": "134202",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਇਕ ਦਿਨ ਦੁਹਿਤਾ ਪਿਤਾ ਨਿਹਾਰਤ ॥",
      "transliteration": "eik dhin dhuhitaa pitaa nihaarat ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਪੁੱਤਰੀ ਨੇ ਪਿਤਾ ਦੇ ਵੇਖਦੇ ਹੋਇਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "इक दिन दुहिता पिता निहारत ॥",
      "sourceLineId": "134203",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਭਈ ਖੇਲ ਕੇ ਬੀਚ ਮਹਾ ਰਤ ॥",
      "transliteration": "bhiee khel ke beech mahaa rat ||",
      "translation": "",
      "punjabiViakhya": "ਖੇਡ ਵਿਚ ਬਹੁਤ ਮਗਨ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "भई खेल के बीच महा रत ॥",
      "sourceLineId": "134204",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਵਨ ਪੁਰਖ ਕਹ ਪੁਰਖ ਉਚਰਿ ਕੈ ॥",
      "transliteration": "tavan purakh keh purakh uchar kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਇਸਤਰੀ ਬਣੇ) ਪੁਰਸ਼ ਨੂੰ ਪੁਰਸ਼ ਕਹਿ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "तवन पुरख कह पुरख उचरि कै ॥",
      "sourceLineId": "134205",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਰਤਾ ਕਰਾ ਸੁਯੰਬਰ ਕਰਿ ਕੈ ॥੮॥",
      "transliteration": "bharataa karaa suya(n)bar kar kai ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੁਅੰਬਰ ਰਚ ਕੇ (ਉਸ ਨੂੰ ਆਪਣਾ) ਪਤੀ ਬਣਾ ਲਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "भरता करा सुयंबर करि कै ॥८॥",
      "sourceLineId": "134206",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬੈਠੀ ਬਹੁਰਿ ਸੋਕ ਮਨ ਧਰਿ ਕੈ ॥",
      "transliteration": "baiThee bahur sok man dhar kai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਮਨ ਵਿਚ ਦੁਖ ਮੰਨਾ ਕੇ ਬੈਠ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "बैठी बहुरि सोक मन धरि कै ॥",
      "sourceLineId": "134207",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੁਨਤ ਮਾਤ ਪਿਤ ਬਚਨ ਉਚਰਿ ਕੈ ॥",
      "transliteration": "sunat maat pit bachan uchar kai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਾਤਾ ਪਿਤਾ ਨੂੰ ਸੁਣਾ ਕੇ ਕਹਿਣ ਲਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "सुनत मात पित बचन उचरि कै ॥",
      "sourceLineId": "134208",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਹ ਇਹ ਕਰੀ ਲਖਹੁ ਹਮਰੀ ਗਤਿ ॥",
      "transliteration": "keh ieh karee lakhahu hamaree gat ||",
      "translation": "",
      "punjabiViakhya": "ਵੇਖੋ! ਇਨ੍ਰਹਾ ਨੇ ਮੇਰੀ ਕੀ ਹਾਲਤ ਕਰ ਦਿੱਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "कह इह करी लखहु हमरी गति ॥",
      "sourceLineId": "134209",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮੁਹਿ ਇਨ ਦੀਨ ਸਹਚਰੀ ਕਰਿ ਪਤਿ ॥੯॥",
      "transliteration": "muh in dheen sahacharee kar pat ||9||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਇਨ੍ਰਹਾ ਨੇ ਸਹੇਲੀ ਪਤੀ ਬਣਾ ਕੇ ਦੇ ਦਿੱਤੀ ਹੈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "मुहि इन दीन सहचरी करि पति ॥९॥",
      "sourceLineId": "134210",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਬ ਮੁਹਿ ਭਈ ਇਹੈ ਸਹਚਰਿ ਪਤਿ ॥",
      "transliteration": "ab muh bhiee ihai sahachar pat ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੇਰੀ ਇਹ ਸਖੀ ਹੀ ਪਤੀ ਬਣ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "अब मुहि भई इहै सहचरि पति ॥",
      "sourceLineId": "134211",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਖੇਲਤ ਦਈ ਲਰਿਕਵਨ ਸੁਭ ਮਤਿ ॥",
      "transliteration": "khelat dhiee larikavan subh mat ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਨਾਲ ਇਹ ਬਚਪਨ ਤੋਂ ਹੀ ਖੇਡਦੀ ਆਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "खेलत दई लरिकवन सुभ मति ॥",
      "sourceLineId": "134212",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਬ ਜੌ ਹੈ ਮੋਰੈ ਸਤ ਮਾਹੀ ॥",
      "transliteration": "ab jau hai morai sat maahee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਦੈਵ! ਹੁਣ ਜੇ ਮੇਰੇ ਵਿਚ ਸਤ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "अब जौ है मोरै सत माही ॥",
      "sourceLineId": "134213",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤੌ ਇਹ ਨਾਰਿ ਪੁਰਖ ਹ੍ਵੈ ਜਾਹੀ ॥੧੦॥",
      "transliteration": "tau ieh naar purakh havai jaahee ||10||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਹ ਇਸਤਰੀ ਪੁਰਸ਼ ਬਣ ਜਾਏ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "तौ इह नारि पुरख ह्वै जाही ॥१०॥",
      "sourceLineId": "134214",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤ੍ਰਿਯ ਤੇ ਇਹੈ ਪੁਰਖ ਹ੍ਵੈ ਜਾਹੀ ॥",
      "transliteration": "tiray te ihai purakh havai jaahee ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਇਸਤਰੀ ਤੋਂ ਮਰਦ ਬਣ ਜਾਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "तृय ते इहै पुरख ह्वै जाही ॥",
      "sourceLineId": "134215",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜੌ ਕਛੁ ਸਤ ਮੇਰੇ ਮਹਿ ਆਹੀ ॥",
      "transliteration": "jau kachh sat mere meh aahee ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਮੇਰੇ ਵਿਚ ਕੁਝ ਸਤ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "जौ कछु सत मेरे महि आही ॥",
      "sourceLineId": "134216",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਯਹ ਅਬ ਜੂਨਿ ਪੁਰਖ ਕੀ ਪਾਵੈ ॥",
      "transliteration": "yeh ab joon purakh kee paavai ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਇਹ ਮਰਦ ਦੀ ਜੂਨ ਪਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "यह अब जूनि पुरख की पावै ॥",
      "sourceLineId": "134217",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮਦਨ ਭੋਗ ਮੁਰਿ ਸੰਗ ਕਮਾਵੈ ॥੧੧॥",
      "transliteration": "madhan bhog mur sa(n)g kamaavai ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੇ ਨਾਲ ਕਾਮ-ਕੇਲ ਕਰੇ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "मदन भोग मुरि संग कमावै ॥११॥",
      "sourceLineId": "134218",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚਕ੍ਰਿਤ ਭਯੋ ਰਾਜਾ ਇਨ ਬਚਨਨ ॥",
      "transliteration": "chakirat bhayo raajaa in bachanan ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਬਚਨਾ ਤੋਂ ਰਾਜਾ ਹੈਰਾਨ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "चकृत भयो राजा इन बचनन ॥",
      "sourceLineId": "134219",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਾਨੀ ਸਹਿਤ ਬਿਚਾਰ ਕਿਯੋ ਮਨ ॥",
      "transliteration": "raanee sahit bichaar kiyo man ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਸਮੇਤ ਮਨ ਵਿਚ ਵਿਚਾਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "रानी सहित बिचार कियो मन ॥",
      "sourceLineId": "134220",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੁਹਿਤਾ ਕਹਾ ਕਹਤ ਬੈਨਨ ਕਹ ॥",
      "transliteration": "dhuhitaa kahaa kahat bainan keh ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਪੁੱਤਰੀ ਕਿਸ ਤਰ੍ਰਹਾ ਦੀਆਂ ਗੱਲਾ ਕਰਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "दुहिता कहा कहत बैनन कह ॥",
      "sourceLineId": "134221",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਚਰਜ ਸੋ ਆਵਤ ਹੈ ਜਿਯ ਮਹ ॥੧੨॥",
      "transliteration": "acharaj so aavat hai jiy meh ||12||",
      "translation": "",
      "punjabiViakhya": "(ਸਾਡੇ) ਮਨ ਵਿਚ ਬਹੁਤ ਅਸਚਰਜ ਲਗਦੀਆਂ ਹਨ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "अचरज सो आवत है जिय मह ॥१२॥",
      "sourceLineId": "134222",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਬ ਤਿਹ ਬਸਤ੍ਰ ਛੋਰਿ ਨ੍ਰਿਪ ਲਹਾ ॥",
      "transliteration": "jab teh basatr chhor nirap lahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਉਸ ਦੇ ਬਸਤ੍ਰ ਉਤਰਵਾ ਕੇ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "जब तिह बसत्र छोरि नृप लहा ॥",
      "sourceLineId": "134223",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨ੍ਰਿਕਸ੍ਰਯੋ ਵਹੈ ਜੁ ਦੁਹਿਤਾ ਕਹਾ ॥",
      "transliteration": "nirakasrayo vahai ju dhuhitaa kahaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਉਹੀ ਨਿਕਲਿਆ ਜੋ ਪੁੱਤਰੀ ਨੇ ਕਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "नृकस्रयो वहै जु दुहिता कहा ॥",
      "sourceLineId": "134224",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਧਿਕ ਸਤੀ ਤਾ ਕਹਿ ਕਰਿ ਜਾਨਾ ॥",
      "transliteration": "adhik satee taa keh kar jaanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਉਸ ਨੂੰ ਅਧਿਕ ਸਤੀ ਕਰ ਕੇ ਜਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "अधिक सती ता कहि करि जाना ॥",
      "sourceLineId": "134225",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਲਾ ਬੁਰਾ ਨਹਿ ਮੂੜ ਪਛਾਨਾ ॥੧੩॥",
      "transliteration": "bhalaa buraa neh mooR pachhaanaa ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੂਰਖ ਨੇ ਭਲੇ ਬੁਰੇ ਨੂੰ ਨਾ ਪਛਾਣਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "भला बुरा नहि मूड़ पछाना ॥१३॥",
      "sourceLineId": "134226",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚੌਬੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੨੪॥੬੧੦੮॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau chauabees charitr samaapatam sat subham sat ||324||6108||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੨੪ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੨੪॥੬੧੦੮॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ चौबीस चरित्र समापतम सतु सुभम सतु ॥३२४॥६१०८॥अफजूँ॥",
      "sourceLineId": "134227",
      "sourceShabadId": "12568",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134228",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸ੍ਰੀ ਸੁਲਤਾਨ ਸੈਨ ਇਕ ਰਾਜਾ ॥",
      "transliteration": "sree sulataan sain ik raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਸੁਲਤਾਨ ਸੈਨ ਨਾ ਦਾ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "स्री सुलतान सैन इक राजा ॥",
      "sourceLineId": "134229",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਾ ਸਮ ਦੁਤਿਯ ਨ ਬਿਧਨਾ ਸਾਜਾ ॥",
      "transliteration": "jaa sam dhutiy na bidhanaa saajaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਵਿਧਾਤਾ ਨੇ ਕੋਈ ਹੋਰ ਨਹੀਂ ਸਿਰਜਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "जा सम दुतिय न बिधना साजा ॥",
      "sourceLineId": "134230",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸ੍ਰੀ ਸੁਲਤਾਨ ਦੇਇ ਤਿਹ ਨਾਰੀ ॥",
      "transliteration": "sree sulataan dhei teh naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁਲਤਾਨ ਦੇਈ ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "स्री सुलतान देइ तिह नारी ॥",
      "sourceLineId": "134231",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰੂਪਵਾਨ ਗੁਨਵਾਨ ਉਜਿਯਾਰੀ ॥੧॥",
      "transliteration": "roopavaan gunavaan ujiyaaree ||1||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਬਹੁਤ ਰੂਪਵਾਨ, ਗੁਣਵਾਨ ਅਤੇ ਉਜਲੇ ਆਚਾਰ ਵਾਲੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "रूपवान गुनवान उजियारी ॥१॥",
      "sourceLineId": "134232",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਾ ਕੇ ਭਵਨ ਭਈ ਇਕ ਬਾਲਾ ॥",
      "transliteration": "taa ke bhavan bhiee ik baalaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਘਰ ਇਕ ਪੁੱਤਰੀ ਹੋਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "ता के भवन भई इक बाला ॥",
      "sourceLineId": "134233",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਾਨੁਕ ਸਿਥਰ ਅਗਨਿ ਕੀ ਜ੍ਵਾਲਾ ॥",
      "transliteration": "jaanuk sithar agan kee javaiaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਅੱਗ ਦੀ ਲਾਟ ਸਥਿਤ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "जानुक सिथर अगनि की ज्वाला ॥",
      "sourceLineId": "134234",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸ੍ਰੀ ਸੁਲਤਾਨ ਕੁਅਰਿ ਉਜਿਯਾਰੀ ॥",
      "transliteration": "sree sulataan kuar ujiyaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸੁਲਤਾਨ ਕੁਅਰਿ ਬਹੁਤ ਸੁੰਦਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "स्री सुलतान कुअरि उजियारी ॥",
      "sourceLineId": "134235",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਨਕ ਅਵਟਿ ਸਾਚੇ ਜਨ ਢਾਰੀ ॥੨॥",
      "transliteration": "kanak avaT saache jan ddaaree ||2||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਸੋਨੇ ਨੂੰ ਪੰਘਾਰ ਕੇ ਸੰਚੇ ਵਿਚ ਢਾਲੀ ਗਈ ਹੋਵੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "कनक अवटि साचे जन ढारी ॥२॥",
      "sourceLineId": "134236",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜੋਬਨੰਗ ਤਾ ਕੇ ਜਬ ਭਯੋ ॥",
      "transliteration": "jobana(n)g taa ke jab bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਦੇ ਸ਼ਰੀਰ ਵਿਚ ਜੋਬਨ ਪਸਰ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "जोबनंग ता के जब भयो ॥",
      "sourceLineId": "134237",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਾਲਾਪਨ ਤਬ ਹੀ ਸਭ ਗਯੋ ॥",
      "transliteration": "baalaapan tab hee sabh gayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਸਾਰਾ ਬਚਪਨਾ ਚਲਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "बालापन तब ही सभ गयो ॥",
      "sourceLineId": "134238",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅੰਗ ਅੰਗ ਦਯੋ ਅਨੰਗ ਦਮਾਮਾ ॥",
      "transliteration": "a(n)g a(n)g dhayo ana(n)g dhamaamaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਅੰਗ ਅੰਗ ਉਤੇ ਕਾਮ ਦੇਵ ਨੇ ਦਮਾਮਾ ਵਜਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "अंग अंग दयो अनंग दमामा ॥",
      "sourceLineId": "134239",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਾਹਿਰ ਭਈ ਜਗਤ ਮਹਿ ਬਾਮਾ ॥੩॥",
      "transliteration": "jaahir bhiee jagat meh baamaa ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਹ ਇਸਤਰੀ ਜਗਤ ਵਿਚ ਪ੍ਰਸਿੱਧ ਹੋ ਗਈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "जाहिर भई जगत महि बामा ॥३॥",
      "sourceLineId": "134240",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੁਨਿ ਸੁਨਿ ਪ੍ਰਭਾ ਕੁਅਰ ਤਹ ਆਵੈ ॥",
      "transliteration": "sun sun prabhaa kuar teh aavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਨੂੰ ਸੁਣ ਸੁਣ ਕੇ ਰਾਜ ਕੁਮਾਰ ਉਥੇ ਆਉਾਂਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "सुनि सुनि प्रभा कुअर तह आवै ॥",
      "sourceLineId": "134241",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1274_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦ੍ਵਾਰੈ ਭੀਰ ਬਾਰ ਨਹਿ ਪਾਵੈ ॥",
      "transliteration": "dhavaiaarai bheer baar neh paavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੁਆਰ ਉਤੇ ਭੀੜ ਹੋਣ ਕਾਰਨ (ਵੇਖਣ ਲਈ) ਵਾਰੀ ਹੀ ਨਹੀਂ ਮਿਲਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1274,
      "hindi": "",
      "hindiTransliteration": "द्वारै भीर बार नहि पावै ॥",
      "sourceLineId": "134242",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
