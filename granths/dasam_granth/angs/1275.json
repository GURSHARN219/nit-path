{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1275,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1275_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਏਕ ਤਰੁਨ ਤਰੁਨੀ ਕੌ ਭਾਯੋ ॥",
      "transliteration": "ek tarun tarunee kau bhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਨੌਜਵਾਨ ਰਾਜ ਕੁਮਾਰੀ ਨੂੰ ਜਚ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "एक तरुन तरुनी कौ भायो ॥",
      "sourceLineId": "134243",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਾਨੁਕ ਮਦਨ ਰੂਪ ਧਰਿ ਆਯੋ ॥੪॥",
      "transliteration": "jaanuk madhan roop dhar aayo ||4||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਕਾਮ ਦੇਵ ਦਾ ਰੂਪ ਹੀ ਧਾਰ ਕੇ ਆ ਗਿਆ ਹੋਵੇ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "जानुक मदन रूप धरि आयो ॥४॥",
      "sourceLineId": "134244",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੋਇ ਕੁਅਰ ਤਰੁਨੀ ਕੌ ਭਾਯੋ ॥",
      "transliteration": "soi kuar tarunee kau bhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹੀ ਕੁਮਾਰ ਰਾਜ ਕੁਮਾਰੀ ਨੂੰ ਚੰਗਾ ਲਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "सोइ कुअर तरुनी कौ भायो ॥",
      "sourceLineId": "134245",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਠੈ ਸਹਚਰੀ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "transliteration": "paThai sahacharee bol paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਖੀ ਭੇਜ ਕੇ ਉਸ ਨੂੰ ਬੁਲਵਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "पठै सहचरी बोलि पठायो ॥",
      "sourceLineId": "134246",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕ੍ਰੀੜਾ ਕਰੀ ਬਹੁਤ ਬਿਧਿ ਵਾ ਸੋ ॥",
      "transliteration": "kreeRaa karee bahut bidh vaa so ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਕਾਮ-ਕੇਲ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "क्रीड़ा करी बहुत बिधि वा सो ॥",
      "sourceLineId": "134247",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕੀਨੋ ਪ੍ਰਾਤ ਸੁਯੰਬਰ ਤਾ ਸੋ ॥੫॥",
      "transliteration": "keeno praat suya(n)bar taa so ||5||",
      "translation": "",
      "punjabiViakhya": "ਸਵੇਰ ਵੇਲੇ ਉਸ ਨਾਲ ਸੁਅੰਬਰ ਰਚਾ ਲਿਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "कीनो प्रात सुयंबर ता सो ॥५॥",
      "sourceLineId": "134248",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਬ ਹੀ ਬ੍ਯਾਹ ਤਵਨ ਸੌ ਕੀਯੋ ॥",
      "transliteration": "jab hee bayaeh tavan sau keeyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਨਾਲ ਵਿਆਹ ਕਰ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "जब ही ब्याह तवन सौ कीयो ॥",
      "sourceLineId": "134249",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਹੁਤਿਕ ਬਰਿਸ ਨ ਜਾਨੇ ਦੀਯੋ ॥",
      "transliteration": "bahutik baris na jaane dheeyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੂੰ ਬਹੁਤ ਵਰ੍ਰਹਿਆਂ ਤਕ ਜਾਣ ਨਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "बहुतिक बरिस न जाने दीयो ॥",
      "sourceLineId": "134250",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕ੍ਰੀੜਾ ਕਰੈ ਭਾਤਿ ਭਾਤਿਨ ਤਨ ॥",
      "transliteration": "kreeRaa karai bhaat bhaatin tan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨਾਲ) ਭਾਤ ਭਾਤ ਦੀ ਰਤੀ-ਕ੍ਰੀੜਾ ਕਰਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "क्रीड़ा करै भाति भातिन तन ॥",
      "sourceLineId": "134251",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਹਰਖ ਬਢਾਇ ਬਢਾਇ ਅਧਿਕ ਮਨ ॥੬॥",
      "transliteration": "harakh baddai baddai adhik man ||6||",
      "translation": "",
      "punjabiViakhya": "ਮਨ ਵਿਚ ਬਹੁਤ ਆਨੰਦ ਵਧਾ ਵਧਾ ਕੇ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "हरख बढाइ बढाइ अधिक मन ॥६॥",
      "sourceLineId": "134252",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭੋਗ ਬਹੁਤ ਦਿਨ ਤਾ ਸੰਗ ਕਯੋ ॥",
      "transliteration": "bhog bahut dhin taa sa(n)g kayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਬਹੁਤ ਦਿਨਾ ਤਕ ਭੋਗ ਵਿਲਾਸ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "भोग बहुत दिन ता संग कयो ॥",
      "sourceLineId": "134253",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਾ ਕੋ ਬਲ ਸਭ ਹੀ ਹਰਿ ਲਯੋ ॥",
      "transliteration": "taa ko bal sabh hee har layo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੀ ਸਾਰੀ ਤਾਕਤ ਖ਼ਤਮ ਕਰ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "ता को बल सभ ही हरि लयो ॥",
      "sourceLineId": "134254",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਬੈ ਨ੍ਰਿਧਾਤ ਕੁਅਰ ਵਹ ਭਯੋ ॥",
      "transliteration": "jabai niradhaat kuar veh bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਕੁਮਾਰ ਨਿਰ-ਧਾਤ (ਸ਼ਕਤੀਹੀਨ) ਹੋ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "जबै नृधात कुअर वह भयो ॥",
      "sourceLineId": "134255",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਬ ਹੀ ਡਾਰਿ ਹ੍ਰਿਦੈ ਤੇ ਦਯੋ ॥੭॥",
      "transliteration": "tab hee ddaar hiradhai te dhayo ||7||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਦੋਂ ਹੀ (ਰਾਜ ਕੁਮਾਰੀ ਨੇ) ਉਸ ਨੂੰ ਮਨ ਵਿੱਚੋਂ ਹਟਾ ਦਿੱਤਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "तब ही डारि हृदै ते दयो ॥७॥",
      "sourceLineId": "134256",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਔਰਨ ਸਾਥ ਕਰੈ ਤਬ ਪ੍ਰੀਤਾ ॥",
      "transliteration": "aauaran saath karai tab preetaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਹ ਹੋਰਾ ਨਾਲ ਪ੍ਰੀਤ ਕਰਨ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "औरन साथ करै तब प्रीता ॥",
      "sourceLineId": "134257",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਿਸੁ ਦਿਨ ਕਰੈ ਕਾਮ ਕੀ ਰੀਤਾ ॥",
      "transliteration": "nis dhin karai kaam kee reetaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਤ ਦਿਨ ਕਾਮ-ਕ੍ਰੀੜਾ ਦੀ ਰੀਤ ਕਰਨ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "निसु दिन करै काम की रीता ॥",
      "sourceLineId": "134258",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪਤਿਹਿ ਤੋਰਿ ਖੋਜਾ ਕਰਿ ਡਾਰਾ ॥",
      "transliteration": "pateh tor khojaa kar ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਪਤੀ ਦੀ ਮਰਦਾਵੀਂ ਤਾਕਤ ਨੂੰ ਖ਼ਤਮ ਕਰ ਕੇ ਖੁਸਰਾ (ਨਾਮਰਦ) ਬਣਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "पतिहि तोरि खोजा करि डारा ॥",
      "sourceLineId": "134259",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਆਪੁ ਅਵਰ ਸੋ ਕੇਲ ਮਚਾਰਾ ॥੮॥",
      "transliteration": "aap avar so kel machaaraa ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪ ਹੋਰਾ ਨਾਲ ਕੇਲ-ਕ੍ਰੀੜਾ ਮਚਾਉਣ ਲਗੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "आपु अवर सो केल मचारा ॥८॥",
      "sourceLineId": "134260",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਿਰਹ ਰਾਇ ਤਾ ਕੋ ਥੋ ਯਾਰਾ ॥",
      "transliteration": "bireh rai taa ko tho yaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਬਿਰਹ ਰਾਇ ਨਾ ਦਾ ਇਕ ਯਾਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "बिरह राइ ता को थो यारा ॥",
      "sourceLineId": "134261",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਾ ਸੋ ਬਧਿਯੋ ਕੁਅਰਿ ਕੇ ਪ੍ਯਾਰਾ ॥",
      "transliteration": "jaa so badhiyo kuar ke payaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਕੁਮਾਰੀ ਦਾ ਬਹੁਤ ਪ੍ਰੇਮ ਵੱਧ ਗਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "जा सो बधियो कुअरि के प्यारा ॥",
      "sourceLineId": "134262",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਾ ਪਰ ਰਹੀ ਹੋਇ ਸੋ ਲਟਕਨ ॥",
      "transliteration": "taa par rahee hoi so laTakan ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਉਸ ਉਤੇ ਲਟੂ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "ता पर रही होइ सो लटकन ॥",
      "sourceLineId": "134263",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਿਹ ਹਿਤ ਮਰਤ ਪ੍ਯਾਸ ਅਰੁ ਭੂਖਨ ॥੯॥",
      "transliteration": "teh hit marat payaas ar bhookhan ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਵਿਚ (ਮਗਨ ਰਹਿਣ ਕਰ ਕੇ) ਭੁਖ ਤੇ ਪਿਆਸ ਨਾਲ ਮਰਨ ਲਗੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "तिह हित मरत प्यास अरु भूखन ॥९॥",
      "sourceLineId": "134264",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇਕ ਦਿਨ ਭਾਗ ਮਿਤ੍ਰ ਤਿਹ ਲਈ ॥",
      "transliteration": "eik dhin bhaag mitr teh liee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਉਸ ਦੇ ਮਿਤਰ ਨੇ ਭੰਗ ਪੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "इक दिन भाग मित्र तिह लई ॥",
      "sourceLineId": "134265",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪੋਸਤ ਸਹਿਤ ਅਫੀਮ ਚੜਈ ॥",
      "transliteration": "posat sahit afeem chaRiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੋਸਤ ਸਹਿਤ ਅਫ਼ੀਮ ਚੜ੍ਰਹਾ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "पोसत सहित अफीम चड़ई ॥",
      "sourceLineId": "134266",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਹੁ ਰਤਿ ਕਰੀ ਨ ਬੀਰਜ ਗਿਰਾਈ ॥",
      "transliteration": "bahu rat karee na beeraj giraiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਬਿਨਾ ਵੀਰਜ ਡਿਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "बहु रति करी न बीरज गिराई ॥",
      "sourceLineId": "134267",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਆਠ ਪਹਿਰ ਲਗਿ ਕੁਅਰਿ ਬਜਾਈ ॥੧੦॥",
      "transliteration": "aaTh pahir lag kuar bajaiee ||10||",
      "translation": "",
      "punjabiViakhya": "ਅੱਠ ਪਹਿਰਾ ਤਕ ਰਾਜ ਕੁਮਾਰੀ ਨਾਲ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "आठ पहिर लगि कुअरि बजाई ॥१०॥",
      "sourceLineId": "134268",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਭ ਨਿਸਿ ਨਾਰਿ ਭੋਗ ਜਬ ਪਾਯੋ ॥",
      "transliteration": "sabh nis naar bhog jab paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਇਸਤਰੀ ਨੇ ਸਾਰੀ ਰਾਤ ਸੰਯੋਗ ਸੁਖ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "सभ निसि नारि भोग जब पायो ॥",
      "sourceLineId": "134269",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਹੁ ਆਸਨ ਕਰਿ ਹਰਖ ਬਢਾਯੋ ॥",
      "transliteration": "bahu aasan kar harakh baddaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਸਾਰੇ ਆਸਣ ਕਰ ਕੇ ਸੁਖ ਮਾਣਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "बहु आसन करि हरख बढायो ॥",
      "sourceLineId": "134270",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਾ ਪਰ ਤਰੁਨਿ ਚਿਤ ਤੇ ਅਟਕੀ ॥",
      "transliteration": "taa par tarun chit te aTakee ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਇਸਤਰੀ ਉਸ ਉਤੇ ਮਨੋ ਅਟਕ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "ता पर तरुनि चित ते अटकी ॥",
      "sourceLineId": "134271",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭੂਲਿ ਗਈ ਸਭ ਹੀ ਸੁਧਿ ਘਟ ਕੀ ॥੧੧॥",
      "transliteration": "bhool giee sabh hee sudh ghaT kee ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਰੀਰ ਦੀ ਸੁੱਧ ਬੁੱਧ ਭੁਲ ਗਈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "भूलि गई सभ ही सुधि घट की ॥११॥",
      "sourceLineId": "134272",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦ੍ਵੈ ਘਟਿਕਾ ਜੋ ਭੋਗ ਕਰਤ ਨਰ ॥",
      "transliteration": "dhavai ghaTikaa jo bhog karat nar ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਪੁਰਸ਼ ਦੋ ਘੜੀਆਂ ਤਕ (ਇਸਤਰੀ ਨਾਲ) ਭੋਗ ਕਰਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "द्वै घटिका जो भोग करत नर ॥",
      "sourceLineId": "134273",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਾ ਪਰ ਰੀਝਤ ਨਾਰਿ ਬਹੁਤ ਕਰਿ ॥",
      "transliteration": "taa par reejhat naar bahut kar ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ) ਉਸ ਉਤੇ ਇਸਤਰੀ ਬਹੁਤ ਰੀਝਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "ता पर रीझत नारि बहुत करि ॥",
      "sourceLineId": "134274",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚਾਰਿ ਪਹਰ ਜੋ ਕੇਲ ਕਮਾਵੈ ॥",
      "transliteration": "chaar pahar jo kel kamaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ (ਵਿਅਕਤੀ) ਚਾਰ ਪਹਿਰ ਤਕ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "चारि पहर जो केल कमावै ॥",
      "sourceLineId": "134275",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੋ ਕ੍ਯੋਨ ਨ ਤ੍ਰਿਯ ਕੌ ਚਿਤ ਚੁਰਾਵੈ ॥੧੨॥",
      "transliteration": "so kayon na tiray kau chit churaavai ||12||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਭਲਾ ਇਸਤਰੀ ਦਾ ਚਿਤ ਕਿਉਾਂ ਨਹੀਂ ਚੁਰਾਏਗਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "सो क्योन न तृय कौ चित चुरावै ॥१२॥",
      "sourceLineId": "134276",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰੈਨਿ ਸਕਲ ਤਿਨ ਤਰੁਨਿ ਬਜਾਈ ॥",
      "transliteration": "rain sakal tin tarun bajaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਸਾਰੀ ਰਾਤ ਇਸਤਰੀ ਨਾਲ ਸੰਭੋਗ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "रैनि सकल तिन तरुनि बजाई ॥",
      "sourceLineId": "134277",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਸਾਥ ਹੰਢਾਈ ॥",
      "transliteration": "bhaat bhaat ke saath ha(n)ddaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਤਰ੍ਰਹਾ ਨਾਲ ਵਰਤਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के साथ हंढाई ॥",
      "sourceLineId": "134278",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਆਸਨ ਕਰੇ ਤਰੁਨਿ ਬਹੁ ਬਾਰਾ ॥",
      "transliteration": "aasan kare tarun bahu baaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਇਸਤਰੀ ਦੇ ਬਹੁਤ ਵਾਰ ਆਸਣ ਜਮਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "आसन करे तरुनि बहु बारा ॥",
      "sourceLineId": "134279",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਚੁੰਬਨਾਦਿ ਨਖ ਘਾਤ ਅਪਾਰਾ ॥੧੩॥",
      "transliteration": "chu(n)banaadh nakh ghaat apaaraa ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਸਾਰੇ ਚੁੰਬਨ (ਲਏ) ਅਤੇ ਨਹੁੰਆਂ ਦੇ ਜ਼ਖ਼ਮ ਕੀਤੇ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "चुँबनादि नख घात अपारा ॥१३॥",
      "sourceLineId": "134280",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਚਤੁਰਾਸਨ ਕਰਿ ॥",
      "transliteration": "bhaat bhaat ke chaturaasan kar ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਤਰ੍ਰਹਾ ਦੇ ਚਤੁਰਤਾ ਵਾਲੇ ਆਸਣ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के चतुरासन करि ॥",
      "sourceLineId": "134281",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭਜ੍ਯੋ ਤਾਹਿ ਤਰ ਦਾਬਿ ਭੁਜਨ ਭਰਿ ॥",
      "transliteration": "bhajayo taeh tar dhaab bhujan bhar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੁਜਾਵਾ ਵਿਚ ਲੈ ਕੇ ਉਸ ਨਾਲ ਚੰਗੀ ਤਰ੍ਰਹਾ ਸੰਭੋਗ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "भज्यो ताहि तर दाबि भुजन भरि ॥",
      "sourceLineId": "134282",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚੁੰਬਨ ਆਸਨ ਕਰਤ ਬਿਚਛਨ ॥",
      "transliteration": "chu(n)ban aasan karat bichachhan ||",
      "translation": "",
      "punjabiViakhya": "ਚਤੁਰਾਈ ਭਰੇ ਚੁੰਬਨ ਅਤੇ ਆਸਣ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "चुँबन आसन करत बिचछन ॥",
      "sourceLineId": "134283",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕੋਕ ਕਲਾ ਕੋਬਿਦ ਸਭ ਲਛਨ ॥੧੪॥",
      "transliteration": "kok kalaa kobidh sabh lachhan ||14||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸਾਰੇ ਕੋਕ ਕਲਾ ਵਿਚ ਦਸੇ ਲੱਛਣਾ ਅਨੁਸਾਰ ਸਨ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "कोक कला कोबिद सभ लछन ॥१४॥",
      "sourceLineId": "134284",
      "sourceShabadId": "12569",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "134285",
      "sourceShabadId": "12570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪੋਸਤ ਸ੍ਰਾਬ ਅਫੀਮ ਬਹੁ ਘੋਟਿ ਚੜਾਵਤ ਭੰਗ ॥",
      "transliteration": "posat sraab afeem bahu ghoT chaRaavat bha(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਪੋਸਤ, ਸ਼ਰਾਬ, ਅਫ਼ੀਮ ਅਤੇ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਘੋਟੀ ਹੋਈ ਭੰਗ ਚੜ੍ਰਹਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "पोसत स्राब अफीम बहु घोटि चड़ावत भंग ॥",
      "sourceLineId": "134286",
      "sourceShabadId": "12570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚਾਰਿ ਪਹਰ ਭਾਮਹਿ ਭਜਾ ਤਊ ਨ ਮੁਚਾ ਅਨੰਗ ॥੧੫॥",
      "transliteration": "chaar pahar bhaameh bhajaa tuoo na muchaa ana(n)g ||15||",
      "translation": "",
      "punjabiViakhya": "ਚਾਰ ਪਹਿਰ ਤਕ ਉਸ ਇਸਤਰੀ ਨਾਲ ਸੰਯੋਗ ਕੀਤਾ, ਪਰ ਤਾ ਵੀ ਉਸ ਦਾ ਕਾਮ ਸ਼ਾਤ ਨਾ ਹੋਇਆ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "चारि पहर भामहि भजा तऊ न मुचा अनंग ॥१५॥",
      "sourceLineId": "134287",
      "sourceShabadId": "12570",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134288",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭੋਗ ਕਰਤ ਸਭ ਰੈਨਿ ਬਿਤਾਵਤ ॥",
      "transliteration": "bhog karat sabh rain bitaavat ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਭੋਗ ਕਰਦਿਆਂ ਸਾਰੀ ਰਾਤ ਬਿਤਾ ਦਿੰਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "भोग करत सभ रैनि बितावत ॥",
      "sourceLineId": "134289",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦਲਿਮਲਿ ਸੇਜ ਮਿਲਿਨ ਹ੍ਵੈ ਜਾਵਤ ॥",
      "transliteration": "dhalimal sej milin havai jaavat ||",
      "translation": "",
      "punjabiViakhya": "ਮਿਲਣ ਨਾਲ ਸੇਜ ਮਧੋਲੀ ਜਾਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "दलिमलि सेज मिलिन ह्वै जावत ॥",
      "sourceLineId": "134290",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਹੋਤ ਦਿਵਾਕਰ ਕੀ ਅਨੁਰਾਈ ॥",
      "transliteration": "hot dhivaakar kee anuraiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਸਵੇਰ ਦੀ ਲਾਲੀ ਹੁੰਦੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "होत दिवाकर की अनुराई ॥",
      "sourceLineId": "134291",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਛੈਲ ਸੇਜ ਮਿਲਿ ਬਹੁਰਿ ਬਿਛਾਈ ॥੧੬॥",
      "transliteration": "chhail sej mil bahur bichhaiee ||16||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਪ੍ਰੀਤਮ ਨਾਲ ਮਿਲ ਕੇ ਸੇਜ ਨੂੰ ਫਿਰ ਵਿਛਾ ਲੈਂਦੀ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "छैल सेज मिलि बहुरि बिछाई ॥१६॥",
      "sourceLineId": "134292",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਪੌਢਿ ਪ੍ਰਜੰਕ ਅੰਕ ਭਰਿ ਸੋਊ ॥",
      "transliteration": "pauadd praja(n)k a(n)k bhar souoo ||",
      "translation": "",
      "punjabiViakhya": "ਪਲੰਘ ਉਤੇ (ਦੋਵੇਾਂ) ਜਫੀ ਪਾ ਕੇ ਸੌਂਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "पौढि प्रजंक अंक भरि सोऊ ॥",
      "sourceLineId": "134293",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਭਾਗ ਅਫੀਮ ਪਿਯਤ ਮਿਲਿ ਦੋਊ ॥",
      "transliteration": "bhaag afeem piyat mil dhouoo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਵੇਾਂ ਮਿਲ ਕੇ ਅਫ਼ੀਮ ਅਤੇ ਭੰਗ ਪੀਂਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "भाग अफीम पियत मिलि दोऊ ॥",
      "sourceLineId": "134294",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਬਹੁਰਿ ਕਾਮ ਕੀ ਕੇਲ ਮਚਾਵੈ ॥",
      "transliteration": "bahur kaam kee kel machaavai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਕਾਮ-ਕ੍ਰੀੜਾ ਸ਼ੁਰੂ ਕਰ ਦਿੰਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "बहुरि काम की केल मचावै ॥",
      "sourceLineId": "134295",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕੋਕ ਸਾਰ ਮਤ ਪ੍ਰਗਟ ਦਿਖਾਵੈ ॥੧੭॥",
      "transliteration": "kok saar mat pragaT dhikhaavai ||17||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕੋਕ-ਸ਼ਾਸਤ੍ਰ ਦੇ ਸਾਰ ਨੂੰ ਸਪਸ਼ਟ ਕ੍ਰਿਆਸ਼ੀਲ ਕਰਦੇ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "कोक सार मत प्रगट दिखावै ॥१७॥",
      "sourceLineId": "134296",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕੈਫਨ ਸਾਥ ਰਸ ਮਸੇ ਹ੍ਵੈ ਕਰਿ ॥",
      "transliteration": "kaifan saath ras mase havai kar ||",
      "translation": "",
      "punjabiViakhya": "ਨਸ਼ਿਆਂ ਦੇ ਰਸ ਵਿਚ ਮਸਤ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "कैफन साथ रस मसे ह्वै करि ॥",
      "sourceLineId": "134297",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਪ੍ਰੋਢਿ ਪ੍ਰਜੰਕ ਰਹਤ ਦੋਊ ਸ੍ਵੈ ਕਰਿ ॥",
      "transliteration": "prodd praja(n)k rahat dhouoo savai kar ||",
      "translation": "",
      "punjabiViakhya": "('ਰਸ ਮਸੇ') ਦੋਵੇਾਂ ਪਲੰਘ ਉਤੇ ਸੁਤੇ ਰਹਿੰਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "प्रोढि प्रजंक रहत दोऊ स्वै करि ॥",
      "sourceLineId": "134298",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਬਹੁਰਿ ਜਗੈ ਰਸ ਰੀਤਿ ਮਚਾਵੈ ॥",
      "transliteration": "bahur jagai ras reet machaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾਗਣ ਤੇ ਫਿਰ ਕਾਮ-ਕ੍ਰੀੜਾ ਸ਼ੁਰੂ ਕਰਦੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "बहुरि जगै रस रीति मचावै ॥",
      "sourceLineId": "134299",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਕਵਿਤ ਉਚਾਰਹਿ ਧੁਰਪਦ ਗਾਵੈ ॥੧੮॥",
      "transliteration": "kavit uchaareh dhurapadh gaavai ||18||",
      "translation": "",
      "punjabiViakhya": "ਕਵਿਤਾ ਪੜ੍ਰਹਦੇ ਅਤੇ ਧੁਰਪਦ ਗਾਉਾਂਦੇ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "कवित उचारहि धुरपद गावै ॥१८॥",
      "sourceLineId": "134300",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਤਬ ਲਗਿ ਬਿਰਹ ਨਟਾ ਤਾ ਕੋ ਪਤਿ ॥",
      "transliteration": "tab lag bireh naTaa taa ko pat ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਉਸ ਦਾ ਮੂਰਖ ਮਤ ਵਾਲਾ ਪਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "तब लगि बिरह नटा ता को पति ॥",
      "sourceLineId": "134301",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਨਿਕਸਿਯੋ ਆਇ ਤਹਾ ਮੂਰਖ ਮਤਿ ॥",
      "transliteration": "nikasiyo aai tahaa moorakh mat ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਰਹ ਨਟਾ ਉਥੇ ਆ ਨਿਕਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "निकसियो आइ तहा मूरख मति ॥",
      "sourceLineId": "134302",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਤਬ ਤ੍ਰਿਯ ਚਤੁਰ ਚਰਿਤ੍ਰ ਬਿਚਰਿ ਕੈ ॥",
      "transliteration": "tab tiray chatur charitr bichar kai ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਚਾਲਾਕ ਇਸਤਰੀ ਨੇ ਚਰਿਤ੍ਰ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "तब तृय चतुर चरित्र बिचरि कै ॥",
      "sourceLineId": "134303",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਹਨ੍ਯੋ ਤਾਹਿ ਫਾਸੀ ਗਰ ਡਰਿ ਕੈ ॥੧੯॥",
      "transliteration": "hanayo taeh faasee gar ddar kai ||19||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਗਲੇ ਵਿਚ ਫਾਹੀ ਪਾ ਕੇ ਮਾਰ ਦਿੱਤਾ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "हन्यो ताहि फासी गर डरि कै ॥१९॥",
      "sourceLineId": "134304",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਏਕ ਕੋਠਰੀ ਮਿਤ੍ਰ ਛਪਾਯੋ ॥",
      "transliteration": "ek koTharee mitr chhapaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਕੋਠੜੀ ਵਿਚ ਮਿਤਰ ਨੂੰ ਛੁਪਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "एक कोठरी मित्र छपायो ॥",
      "sourceLineId": "134305",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਪਤਿਹਿ ਮਾਰਿ ਸੁਰ ਊਚ ਉਘਾਯੋ ॥",
      "transliteration": "pateh maar sur uooch ughaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਤੀ ਨੂੰ ਮਾਰ ਕੇ ਉੱਚੀ ਉੱਚੀ ਰੋਣ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "पतिहि मारि सुर ऊच उघायो ॥",
      "sourceLineId": "134306",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਰਾਜਾ ਪ੍ਰਜਾ ਸਬਦ ਸੁਨਿ ਧਾਏ ॥",
      "transliteration": "raajaa prajaa sabadh sun dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਅਤੇ ਪ੍ਰਜਾ (ਰੋਣ ਦੀ) ਆਵਾਜ਼ ਸੁਣ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "राजा प्रजा सबद सुनि धाए ॥",
      "sourceLineId": "134307",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਦੁਹਿਤਾ ਕੇ ਮੰਦਰਿ ਚਲਿ ਆਏ ॥੨੦॥",
      "transliteration": "dhuhitaa ke ma(n)dhar chal aae ||20||",
      "translation": "",
      "punjabiViakhya": "ਪੁੱਤਰੀ ਦੇ ਘਰ ਵਲ ਭਜਦੇ ਹੋਏ ਆ ਗਏ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "दुहिता के मंदरि चलि आए ॥२०॥",
      "sourceLineId": "134308",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਮ੍ਰਿਤਕ ਪਰਿਯੋ ਤਾ ਕੌ ਭਰਤਾਰਾ ॥",
      "transliteration": "mritak pariyo taa kau bharataaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਮਰੇ ਪਏ ਪਤੀ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "मृतक परियो ता कौ भरतारा ॥",
      "sourceLineId": "134309",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਰਾਵ ਰੰਕ ਸਭਹੂੰਨ ਨਿਹਾਰਾ ॥",
      "transliteration": "raav ra(n)k sabhahoo(n)n nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਅਤੇ ਰੰਕ (ਅਮੀਰ ਅਤੇ ਗ਼ਰੀਬ) ਸਭ ਨੇ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "राव रंक सभहूँन निहारा ॥",
      "sourceLineId": "134310",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਪੂਛਤ ਭਯੋ ਤਿਸੀ ਕਹ ਰਾਜਨ ॥",
      "transliteration": "poochhat bhayo tisee keh raajan ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਰਾਜੇ ਨੇ ਪੁਛਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "पूछत भयो तिसी कह राजन ॥",
      "sourceLineId": "134311",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਕਹਾ ਭਈ ਯਾ ਕੀ ਗਤਿ ਕਾਮਨਿ ॥੨੧॥",
      "transliteration": "kahaa bhiee yaa kee gat kaaman ||21||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਹੇ ਪੁੱਤਰੀ! ਇਸ ਦੀ ਇਹ ਹਾਲਤ ਕਿਵੇਾਂ ਹੋਈ (ਅਰਥਾਤ ਇਹ ਕਿਵੇਾਂ ਮਰ ਗਿਆ) ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "कहा भई या की गति कामनि ॥२१॥",
      "sourceLineId": "134312",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਸੁਨਹੁ ਪਿਤਾ ਮੈ ਕਛੂ ਨ ਜਾਨੋ ॥",
      "transliteration": "sunahu pitaa mai kachhoo na jaano ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਉੱਤਰ ਦਿੱਤਾ) ਹੇ ਪਿਤਾ ਜੀ! ਸੁਣੋ!",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "सुनहु पिता मै कछू न जानो ॥",
      "sourceLineId": "134313",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1275_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਰੋਗ ਯਾਹਿ ਜੋ ਤੁਮੈ ਬਖਾਨੋ ॥",
      "transliteration": "rog yaeh jo tumai bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ (ਇਸ ਸੰਬੰਧ ਵਿਚ) ਕੁਝ ਨਹੀਂ ਜਾਣਦੀ। ਜੇ ਇਸ ਨੂੰ ਰੋਗ ਹੁੰਦਾ ਤਾ ਤੁਹਾਨੂੰ ਦਸਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1275,
      "hindi": "",
      "hindiTransliteration": "रोग याहि जो तुमै बखानो ॥",
      "sourceLineId": "134314",
      "sourceShabadId": "12571",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
