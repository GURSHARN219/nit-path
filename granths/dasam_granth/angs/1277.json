{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1277,
  "lineCount": 47,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1277_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਿਤ ਪ੍ਰਤਿ ਤਾ ਸੌ ਕਰਤ ਬਿਲਾਸਾ ॥੩੪॥",
      "transliteration": "nit prat taa sau karat bilaasaa ||34||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਨਿੱਤ ਭੋਗ ਵਿਲਾਸ ਕਰਨ ਲਗੀ ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "नित प्रति ता सौ करत बिलासा ॥३४॥",
      "sourceLineId": "134364",
      "sourceShabadId": "12573",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਪਚੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੨੫॥੬੧੪੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau pachees charitr samaapatam sat subham sat ||325||6142||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੨੫ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੨੫॥੬੧੪੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ पचीस चरित्र समापतम सतु सुभम सतु ॥३२५॥६१४२॥अफजूँ॥",
      "sourceLineId": "134365",
      "sourceShabadId": "12573",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134366",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗਹਰਵਾਰ ਰਾਜਾ ਇਕ ਅਤਿ ਬਲ ॥",
      "transliteration": "gaharavaar raajaa ik at bal ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਗਹਰਵਾਰ (ਰਾਜਪੂਤ) ਰਾਜਾ ਬਹੁਤ ਬਲਵਾਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "गहरवार राजा इक अति बल ॥",
      "sourceLineId": "134367",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਬੈ ਨ ਚਲਿਯਾ ਪੀਰ ਹਲਾਚਲ ॥",
      "transliteration": "kabai na chaliyaa peer halaachal ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਕਦੇ ਵੀ (ਕੋਈ) ਦੁਖ ਜਾ ਹਲਚਲ ਡਾਵਾਡੋਲ ਨਹੀਂ ਕਰ ਸਕੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "कबै न चलिया पीर हलाचल ॥",
      "sourceLineId": "134368",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗੂੜ੍ਰਹ ਮਤੀ ਨਾਰੀ ਤਾ ਕੇ ਘਰ ॥",
      "transliteration": "gooRreh matee naaree taa ke ghar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਗੂੜ੍ਰਹ ਮਤੀ ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "गूड़्रह मती नारी ता के घर ॥",
      "sourceLineId": "134369",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਹੀ ਨ ਪਰਤ ਪ੍ਰਭਾ ਤਾ ਕੀ ਬਰ ॥੧॥",
      "transliteration": "kahee na parat prabhaa taa kee bar ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁੰਦਰ ਸ਼ੋਭਾ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "कही न परत प्रभा ता की बर ॥१॥",
      "sourceLineId": "134370",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਹ ਇਕ ਹੁਤੋ ਸਾਹ ਬਡਭਾਗੀ ॥",
      "transliteration": "teh ik huto saeh baddabhaagee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਵਡਭਾਗੀ ਸ਼ਾਹ ਹੁੰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "तह इक हुतो साह बडभागी ॥",
      "sourceLineId": "134371",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰੂਪਵਾਨ ਗੁਨਵਾਨ ਨੁਰਾਗੀ ॥",
      "transliteration": "roopavaan gunavaan nuraagee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਬਹੁਤ ਰੂਪਵਾਨ, ਗੁਣਵਾਨ ਅਤੇ ਸਨੇਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "रूपवान गुनवान नुरागी ॥",
      "sourceLineId": "134372",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੁਕਚ ਮਤੀ ਦੁਹਿਤਾ ਤਾ ਕੇ ਘਰ ॥",
      "transliteration": "sukach matee dhuhitaa taa ke ghar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਸੁਕਚ ਮਤੀ ਨਾ ਦੀ ਪੁੱਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "सुकच मती दुहिता ता के घर ॥",
      "sourceLineId": "134373",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪ੍ਰਗਟ ਭਈ ਜਨੁ ਕਲਾ ਕਿਰਣਿਧਰ ॥੨॥",
      "transliteration": "pragaT bhiee jan kalaa kiranidhar ||2||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦੀ ਸੀ) ਮਾਨੋ ਚੰਦ੍ਰਮਾ ਦੀ ਕਲਾ ਪ੍ਰਗਟ ਹੋਈ ਹੋਵੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "प्रगट भई जनु कला किरणिधर ॥२॥",
      "sourceLineId": "134374",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਏਕ ਤਹਾ ਬੈਪਾਰੀ ਆਯੋ ॥",
      "transliteration": "ek tahaa baipaaree aayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ (ਇਕ ਦਿਨ) ਇਕ ਵਪਾਰੀ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "एक तहा बैपारी आयो ॥",
      "sourceLineId": "134375",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਮਿਤ ਦਰਬ ਨਹਿ ਜਾਤ ਗਨਾਯੋ ॥",
      "transliteration": "amit dharab neh jaat ganaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਪਾਸ) ਬੇਹਿਸਾਬ ਧਨ-ਦੌਲਤ ਸੀ, ਜਿਸ ਨੂੰ ਗਿਣਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "अमित दरब नहि जात गनायो ॥",
      "sourceLineId": "134376",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਵਿਤ੍ਰ ਜਾਇਫਰ ਉਸਟੈ ਭਰੇ ॥",
      "transliteration": "javitr jaifar usaTai bhare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਜਾਵਿਤਰੀ, ਜਾਫਲ, ਲੌਂਗ, ਇਲਾਇਚੀ ਦੇ ਊਠ ਲਦੇ ਹੋਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "जवित्र जाइफर उसटै भरे ॥",
      "sourceLineId": "134377",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਲੌਂਗ ਲਾਯਚੀ ਕਵਨ ਉਚਰੇ ॥੩॥",
      "transliteration": "laua(n)g laayachee kavan uchare ||3||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਦਾ) ਵਰਣਨ (ਭਲਾ) ਕੌਣ ਕਰ ਸਕਦਾ ਹੈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "लौंग लायची कवन उचरे ॥३॥",
      "sourceLineId": "134378",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਉਤਰਤ ਧਾਮ ਤਵਨ ਕੇ ਭਯੋ ॥",
      "transliteration": "autarat dhaam tavan ke bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਉਸ ਦੇ ਘਰ ਹੀ ਉਤਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "उतरत धाम तवन के भयो ॥",
      "sourceLineId": "134379",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਿਲਬੋ ਕਾਜ ਸਾਹ ਸੰਗ ਗਯੋ ॥",
      "transliteration": "milabo kaaj saeh sa(n)g gayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਿਲਣ ਲਈ ਸ਼ਾਹ ਕੋਲ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "मिलबो काज साह संग गयो ॥",
      "sourceLineId": "134380",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦੁਹਿਤ ਘਾਤ ਤਵਨ ਕੀ ਪਾਈ ॥",
      "transliteration": "dhuhit ghaat tavan kee paiee ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਕਚ ਮਤੀ ਨੇ ਉਸ ਮੌਕੇ ਨੂੰ ਤਾੜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "दुहित घात तवन की पाई ॥",
      "sourceLineId": "134381",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਕਲ ਦਰਬੁ ਤਿਹ ਲਿਯੋ ਚੁਰਾਈ ॥੪॥",
      "transliteration": "sakal dharab teh liyo churaiee ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਧਨ ਨੂੰ ਚੁਰਾ ਲਿਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "सकल दरबु तिह लियो चुराई ॥४॥",
      "sourceLineId": "134382",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਾਤ੍ਰਾ ਗ੍ਰਿਹ ਕੀ ਸਕਲ ਨਿਕਾਰਿ ॥",
      "transliteration": "maatraa gireh kee sakal nikaar ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਸਾਰੇ ਘਰ ਦੀ ਧਨ-ਦੌਲਤ ਕਢ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "मात्रा गृह की सकल निकारि ॥",
      "sourceLineId": "134383",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦਈ ਬਹੁਰਿ ਤਹ ਆਗਿ ਪ੍ਰਜਾਰ ॥",
      "transliteration": "dhiee bahur teh aag prajaar ||",
      "translation": "",
      "punjabiViakhya": "ਮਗਰੋਂ ਘਰ ਨੂੰ ਅੱਗ ਲਗਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "दई बहुरि तह आगि प्रजार ॥",
      "sourceLineId": "134384",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰੋਵਤ ਸੁਤਾ ਪਿਤਾ ਪਹਿ ਆਈ ॥",
      "transliteration": "rovat sutaa pitaa peh aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਰੋਂਦੀ ਹੋਈ ਪੁੱਤਰੀ ਪਿਤਾ ਕੋਲ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "रोवत सुता पिता पहि आई ॥",
      "sourceLineId": "134385",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਰਿਯੋ ਧਾਮ ਕਹਿ ਤਾਹਿ ਸੁਨਾਈ ॥੫॥",
      "transliteration": "jariyo dhaam keh taeh sunaiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਦਸਿਆ ਕਿ ਘਰ ਸੜ ਗਿਆ ਹੈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "जरियो धाम कहि ताहि सुनाई ॥५॥",
      "sourceLineId": "134386",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੁਨ ਤ੍ਰਿਯ ਬਚਨ ਸਾਹ ਦ੍ਵੈ ਧਾਏ ॥",
      "transliteration": "sun tiray bachan saeh dhavai dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਕੁੜੀ ਦੀ ਗੱਲ ਸੁਣ ਕੇ ਦੋਵੇਾਂ ਸ਼ਾਹ (ਉਥੋਂ ਨੂੰ) ਭਜ ਪਏ",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "सुन तृय बचन साह द्वै धाए ॥",
      "sourceLineId": "134387",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਘਰ ਕੋ ਮਾਲ ਨਿਕਾਸਨ ਆਏ ॥",
      "transliteration": "ghar ko maal nikaasan aae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘਰ ਦਾ ਮਾਲ ਕੱਢਣ ਲਈ ਪਹੁੰਚੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "घर को माल निकासन आए ॥",
      "sourceLineId": "134388",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਆਗੇ ਆਇ ਨਿਹਾਰੈ ਕਹਾ ॥",
      "transliteration": "aage aai nihaarai kahaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਗੇ ਆ ਕੇ ਉਨ੍ਰਹਾ ਨੇ ਕੀ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "आगे आइ निहारै कहा ॥",
      "sourceLineId": "134389",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਿਰਖਾ ਢੇਰ ਭਸਮ ਕਾ ਤਹਾ ॥੬॥",
      "transliteration": "nirakhaa dder bhasam kaa tahaa ||6||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਉਥੇ (ਸਾਰਾ ਘਰ) ਸੁਆਹ ਦਾ ਢੇਰ ਬਣਿਆ ਪਿਆ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "निरखा ढेर भसम का तहा ॥६॥",
      "sourceLineId": "134390",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਹੁਰਿ ਸੁਤਾ ਇਮਿ ਬਚਨ ਉਚਾਰੇ ॥",
      "transliteration": "bahur sutaa im bachan uchaare ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਪੁੱਤਰੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "बहुरि सुता इमि बचन उचारे ॥",
      "sourceLineId": "134391",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਯਹੈ ਪਿਤਾ ਦੁਖ ਹ੍ਰਿਦੈ ਹਮਾਰੇ ॥",
      "transliteration": "yahai pitaa dhukh hiradhai hamaare ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਿਤਾ ਜੀ! ਮੇਰੇ ਹਿਰਦੇ ਵਿਚ ਇਹ ਦੁਖ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "यहै पिता दुख हृदै हमारे ॥",
      "sourceLineId": "134392",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਆਪਨਿ ਗਏ ਕਾ ਸੋਕ ਨ ਆਵਾ ॥",
      "transliteration": "aapan ge kaa sok na aavaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਆਪਣੇ (ਸਾਮਾਨ ਦੇ) ਨੁਕਸਾਨ ਦਾ ਦੁਖ ਨਹੀਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "आपनि गए का सोक न आवा ॥",
      "sourceLineId": "134393",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਯਾ ਕੋ ਲਗਤ ਹਮੈ ਪਛਤਾਵਾ ॥੭॥",
      "transliteration": "yaa ko lagat hamai pachhataavaa ||7||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਇਨ੍ਰਹਾ ਦੇ (ਨੁਕਸਾਨ ਦਾ) ਮੈਨੂੰ ਬਹੁਤ ਪਛਤਾਵਾ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "या को लगत हमै पछतावा ॥७॥",
      "sourceLineId": "134394",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪੁਨਿ ਸੁਤਾ ਕੌ ਅਸ ਸਾਹ ਉਚਾਰੇ ॥",
      "transliteration": "pun sutaa kau as saeh uchaare ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਪੁੱਤਰੀ ਨੂੰ ਸ਼ਾਹ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "पुनि सुता कौ अस साह उचारे ॥",
      "sourceLineId": "134395",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੋਈ ਭਯੋ ਜੁ ਲਿਖਿਯੋ ਹਮਾਰੇ ॥",
      "transliteration": "soiee bhayo ju likhiyo hamaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਉਹੀ ਹੋਇਆ ਹੈ ਜੋ ਸਾਡੇ ਭਾਗਾ ਵਿਚ ਲਿਖਿਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "सोई भयो जु लिखियो हमारे ॥",
      "sourceLineId": "134396",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤੁਮ ਯਾ ਕੋ ਕਛੁ ਸੋਕ ਕਰਹੁ ਜਿਨ ॥",
      "transliteration": "tum yaa ko kachh sok karahu jin ||",
      "translation": "",
      "punjabiViakhya": "ਤੂੰ ਇਸ ਦਾ ਕੁਝ ਵੀ ਦੁਖ ਨਾ ਮੰਨਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "तुम या को कछु सोक करहु जिन ॥",
      "sourceLineId": "134397",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੈ ਹੋ ਦਰਬੁ ਜਰਿਯੋ ਜਿਤਨੋ ਇਨ ॥੮॥",
      "transliteration": "dhai ho dharab jariyo jitano in ||8||",
      "translation": "",
      "punjabiViakhya": "(ਪ੍ਰਭੂ ਆਪ ਹੀ) ਇਨ੍ਰਹਾ ਨੂੰ ਸਾਰਾ ਸਾੜਿਆ ਹੋਇਆ ਧਨ ਦੇ ਦੇਵੇਗਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "दै हो दरबु जरियो जितनो इन ॥८॥",
      "sourceLineId": "134398",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭੇਦ ਅਭੇਵ ਨ ਕਛੁ ਜੜ ਪਾਯੋ ॥",
      "transliteration": "bhedh abhev na kachh jaR paayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮੂਰਖ ਨੇ ਭੇਦ ਅਭੇਦ ਨੂੰ ਕੁਝ ਨਾ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "भेद अभेव न कछु जड़ पायो ॥",
      "sourceLineId": "134399",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮੂੰਡ ਮੁੰਡਾਇ ਬਹੁਰਿ ਘਰ ਆਯੋ ॥",
      "transliteration": "moo(n)dd mu(n)ddai bahur ghar aayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਠਗਿਆ ਹੋਇਆ ਫਿਰ ਘਰ ਪਰਤ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "मूँड मुँडाइ बहुरि घर आयो ॥",
      "sourceLineId": "134400",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਰਮ ਰੇਖ ਅਪਨੀ ਪਹਿਚਾਨੀ ॥",
      "transliteration": "karam rekh apanee pahichaanee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਸ ਨੂੰ ਆਪਣੀ ਕਰਮ ਰੇਖਾ ਵਜੋਂ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "करम रेख अपनी पहिचानी ॥",
      "sourceLineId": "134401",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤ੍ਰਿਯ ਚਰਿਤ੍ਰ ਕੀ ਰੀਤਿ ਨ ਜਾਨੀ ॥੯॥",
      "transliteration": "tiray charitr kee reet na jaanee ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸਤਰੀ ਦੇ ਚਰਿਤ੍ਰ ਦੀ ਰੀਤ ਨੂੰ ਨਾ ਸਮਝਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "तृय चरित्र की रीति न जानी ॥९॥",
      "sourceLineId": "134402",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਾਹੁ ਸੁਤਾ ਇਹ ਛਲ ਧਨ ਹਰਾ ॥",
      "transliteration": "saahu sutaa ieh chhal dhan haraa ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਦੇ ਛਲ ਨਾਲ ਧਨ ਹਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "साहु सुता इह छल धन हरा ॥",
      "sourceLineId": "134403",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭੇਦ ਨ ਤਾ ਕੇ ਪਿਤੈ ਬਿਚਰਾ ॥",
      "transliteration": "bhedh na taa ke pitai bicharaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਭੇਦ ਨੂੰ ਉਸ ਦਾ ਪਿਤਾ ਵੀ ਨਾ ਸਮਝ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "भेद न ता के पितै बिचरा ॥",
      "sourceLineId": "134404",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸ੍ਯਾਨਾ ਹੁਤੋ ਭੇਦ ਨਹਿ ਪਾਯੋ ॥",
      "transliteration": "sayaanaa huto bhedh neh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਸਿਆਣਾ ਹੋਣ ਤੇ ਵੀ ਭੇਦ ਨਹੀਂ ਸਮਝ ਸਕਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "स्याना हुतो भेद नहि पायो ॥",
      "sourceLineId": "134405",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਿਨੁ ਲਾਗੇ ਜਲ ਮੂੰਡ ਮੁੰਡਾਯੋ ॥੧੦॥",
      "transliteration": "bin laage jal moo(n)dd mu(n)ddaayo ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਿਨਾ ਪਾਣੀ ਲਗਾਏ ਸਿਰ ਮੁੰਨਵਾ ਲਿਆ (ਅਰਥਾਤ ਬੁਰੀ ਤਰ੍ਰਹਾ ਠਗਿਆ ਗਿਆ) ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "बिनु लागे जल मूँड मुँडायो ॥१०॥",
      "sourceLineId": "134406",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਛਬੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੨੬॥੬੧੫੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau chhabees charitr samaapatam sat subham sat ||326||6152||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੨੬ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੨੬॥੬੧੫੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ छबीस चरित्र समापतम सतु सुभम सतु ॥३२६॥६१५२॥अफजूँ॥",
      "sourceLineId": "134407",
      "sourceShabadId": "12574",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134408",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਚਲਾਵਤੀ ਨਗਰ ਇਕ ਸੋਹੈ ॥",
      "transliteration": "achalaavatee nagar ik sohai ||",
      "translation": "",
      "punjabiViakhya": "ਅਚਲਾਵਤੀ ਨਾ ਦਾ ਇਕ ਨਗਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "अचलावती नगर इक सोहै ॥",
      "sourceLineId": "134409",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1277_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਚਲ ਸੈਨ ਰਾਜਾ ਤਹ ਕੋਹੈ ॥",
      "transliteration": "achal sain raajaa teh kohai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੋਂ ਦਾ ਰਾਜਾ ਅਚਲ ਸੈਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1277,
      "hindi": "",
      "hindiTransliteration": "अचल सैन राजा तह कोहै ॥",
      "sourceLineId": "134410",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
