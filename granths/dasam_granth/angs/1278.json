{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1278,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1278_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਚਲ ਦੇਇ ਤਾ ਕੇ ਘਰ ਰਾਨੀ ॥",
      "transliteration": "achal dhei taa ke ghar raanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਚਲ ਦੇਈ ਨਾ ਦੀ ਉਸ ਦੇ ਘਰ ਰਾਣੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "अचल देइ ता के घर रानी ॥",
      "sourceLineId": "134411",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੁੰਦਰਿ ਭਵਨ ਚਤ੍ਰਦਸ ਜਾਨੀ ॥੧॥",
      "transliteration": "su(n)dhar bhavan chatradhas jaanee ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਚੌਦਾ ਲੋਕਾ ਵਿਚ ਸੁੰਦਰ ਸਮਝੀ ਜਾਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "सुँदरि भवन चत्रदस जानी ॥१॥",
      "sourceLineId": "134412",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਚਲ ਮਤੀ ਦੂਸਰ ਤਿਹ ਦਾਰਾ ॥",
      "transliteration": "achal matee dhoosar teh dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਚਲ ਮਤੀ ਉਸ ਦੀ ਦੂਜੀ ਰਾਣੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "अचल मती दूसर तिह दारा ॥",
      "sourceLineId": "134413",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਾ ਤੇ ਸੁੰਦਰਿ ਹੁਤੀ ਅਪਾਰਾ ॥",
      "transliteration": "taa te su(n)dhar hutee apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਉਸ (ਪਹਿਲੀ) ਨਾਲੋਂ ਅਧਿਕ ਸੁੰਦਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "ता ते सुँदरि हुती अपारा ॥",
      "sourceLineId": "134414",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਾ ਸੌ ਨ੍ਰਿਪ ਕੋ ਨੇਹ ਅਪਾਰਾ ॥",
      "transliteration": "taa sau nirap ko neh apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਰਾਜੇ ਨੂੰ ਬਹੁਤ ਅਧਿਕ ਪ੍ਰੇਮ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "ता सौ नृप को नेह अपारा ॥",
      "sourceLineId": "134415",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਾਨਤ ਊਚ ਨੀਚ ਤਿਹ ਪ੍ਯਾਰਾ ॥੨॥",
      "transliteration": "jaanat uooch neech teh payaaraa ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਪ੍ਰੇਮ ਨੂੰ ਅਮੀਰ ਗ਼ਰੀਬ ਸਭ ਸਮਝਦੇ ਸਨ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "जानत ऊच नीच तिह प्यारा ॥२॥",
      "sourceLineId": "134416",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦੁਤਿਯ ਨਾਰਿ ਅਸ ਚਰਿਤ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "dhutiy naar as charit bichaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਦੂਜੀ (ਭਾਵ ਪਹਿਲੇ ਵਾਲੀ) ਰਾਣੀ ਨੇ ਇਹ ਚਰਿਤ੍ਰ ਕਰਨਾ ਵਿਚਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "दुतिय नारि अस चरित बिचारियो ॥",
      "sourceLineId": "134417",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਏਕ ਨਾਰਿ ਕੇ ਸਾਥ ਸਿਖਾਰਿਯੋ ॥",
      "transliteration": "ek naar ke saath sikhaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਇਸਤਰੀ ਨੂੰ ਮਿਲ ਕੇ ਸਿਖਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "एक नारि के साथ सिखारियो ॥",
      "sourceLineId": "134418",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਾ ਕੋ ਭਰਿਯੋ ਦਰਬ ਸੌ ਧਾਮਾ ॥",
      "transliteration": "taa ko bhariyo dharab sau dhaamaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਘਰ ਧਨ ਨਾਲ ਭਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "ता को भरियो दरब सौ धामा ॥",
      "sourceLineId": "134419",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਾਨਤ ਅਵਰ ਨ ਦੂਜੀ ਬਾਮਾ ॥੩॥",
      "transliteration": "jaanat avar na dhoojee baamaa ||3||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਦਾ ਦੂਜੀ ਰਾਣੀ ਨੂੰ ਪਤਾ ਨਾ ਲਗਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "जानत अवर न दूजी बामा ॥३॥",
      "sourceLineId": "134420",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਬ ਸਭ ਅਰਧ ਰਾਤ੍ਰਿ ਸ੍ਵੈ ਜਾਹਿ ॥",
      "transliteration": "jab sabh aradh raatr savai jaeh ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ ਉਸ ਇਸਤਰੀ ਨੂੰ ਸਿਖਾਇਆ) ਜਦ ਅੱਧੀ ਰਾਤ ਵੇਲੇ ਸਾਰੇ ਸੌਂ ਜਾਣ",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "जब सभ अरध रातृ स्वै जाहि ॥",
      "sourceLineId": "134421",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਾਗਤ ਰਹੈ ਏਕ ਜਨ ਨਾਹਿ ॥",
      "transliteration": "jaagat rahai ek jan naeh ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਵਿਅਕਤੀ ਵੀ ਜਾਗਦਾ ਹੋਇਆ ਨਾ ਰਹੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "जागत रहै एक जन नाहि ॥",
      "sourceLineId": "134422",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦੀਪ ਜਰਿਯੋ ਧੌਲਰ ਜਬ ਲਹਿਯਹੁ ॥",
      "transliteration": "dheep jariyo dhaualar jab lahiyahu ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਮਹੱਲ ਉਤੇ ਦੀਵਾ ਬਲਦਾ ਹੋਇਆ ਵੇਖੇਾਂ",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "दीप जरियो धौलर जब लहियहु ॥",
      "sourceLineId": "134423",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਬ ਤੁਮ ਅਸ ਰਾਜਾ ਸੌ ਕਹਿਯਹੁ ॥੪॥",
      "transliteration": "tab tum as raajaa sau kahiyahu ||4||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਾਜੇ ਕੋਲ ਇਸ ਤਰ੍ਰਹਾ ਕਹੀਂ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "तब तुम अस राजा सौ कहियहु ॥४॥",
      "sourceLineId": "134424",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਾਯਾ ਗਡੀ ਮੋਹਿ ਨ੍ਰਿਪ ਜਾਨੋ ॥",
      "transliteration": "maayaa gaddee moh nirap jaano ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਤੁਸੀਂ ਮੈਨੂੰ (ਧਰਤੀ ਵਿਚ) ਗਡੀ ਹੋਈ ਮਾਇਆ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "माया गडी मोहि नृप जानो ॥",
      "sourceLineId": "134425",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਏਕ ਬਾਤ ਮੈ ਤੁਮੈ ਬਖਾਨੋ ॥",
      "transliteration": "ek baat mai tumai bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਗੱਲ ਮੈਂ ਤੁਹਾਨੂੰ ਕਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "एक बात मै तुमै बखानो ॥",
      "sourceLineId": "134426",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਛਲਾ ਦੇ ਤ੍ਰਿਯ ਕੌ ਬਲਿ ਦੈ ਕੈ ॥",
      "transliteration": "achhalaa dhe tiray kau bal dhai kai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਅਚਲਾ ਦੇਈ ਇਸਤਰੀ ਦੀ ਬਲੀ ਦੇ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "अछला दे तृय कौ बलि दै कै ॥",
      "sourceLineId": "134427",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗ੍ਰਿਹ ਲੈ ਜਾਹਿ ਕਾਢਿ ਮੁਹਿ ਲੈ ਕੈ ॥੫॥",
      "transliteration": "gireh lai jaeh kaadd muh lai kai ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੈਨੂੰ (ਦਬੇ ਹੋਏ ਧਨ ਨੂੰ) ਕਢ ਕੇ ਘਰ ਲੈ ਜਾਓ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "गृह लै जाहि काढि मुहि लै कै ॥५॥",
      "sourceLineId": "134428",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਛਲਾ ਦੇ ਜਬ ਹੀ ਸੁਨਿ ਪਾਯੋ ॥",
      "transliteration": "achhalaa dhe jab hee sun paayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਛਲਾ ਦੇਈ ਨੇ ਜਦ ਇਹ ਸੁਣਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "अछला दे जब ही सुनि पायो ॥",
      "sourceLineId": "134429",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਉਲਟਿ ਭੇਦ ਤਿਹ ਤ੍ਰਿਯਹਿ ਸਿਖਾਯੋ ॥",
      "transliteration": "aulaT bhedh teh tirayeh sikhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਇਸਤਰੀ (ਨੂੰ ਬੁਲਾ ਕੇ) ਉਲਟੀ ਗੱਲ ਸਮਝਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "उलटि भेद तिह तृयहि सिखायो ॥",
      "sourceLineId": "134430",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਏਕ ਬਾਤ ਮਾਗੇ ਮੁਹਿ ਦੇਹੁ ॥",
      "transliteration": "ek baat maage muh dheh ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਬਚਨ ਮੰਗਦੀ ਹਾ, ਮੈਨੂੰ ਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "एक बात मागे मुहि देहु ॥",
      "sourceLineId": "134431",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨ੍ਰਿਪ ਪਹਿ ਨਾਮ ਤਿਸੀ ਕਾ ਲੇਹੁ ॥੬॥",
      "transliteration": "nirap peh naam tisee kaa leh ||6||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਕੋਲ (ਮੇਰੀ ਥਾ ਤੇ) ਉਸ ਦਾ ਨਾ ਲੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "नृप पहि नाम तिसी का लेहु ॥६॥",
      "sourceLineId": "134432",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪ੍ਰਥਮੈ ਅਧਿਕ ਦਰਬੁ ਤਿਹ ਦਿਯਾ ॥",
      "transliteration": "prathamai adhik dharab teh dhiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲੀ (ਰਾਣੀ ਨੇ) ਉਸ ਨੂੰ ਬਹੁਤ ਧਨ ਦਿੱਤਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "प्रथमै अधिक दरबु तिह दिया ॥",
      "sourceLineId": "134433",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੁਗਨੋ ਦਰਬ ਦੇਨ ਤਿਹ ਕਿਯਾ ॥",
      "transliteration": "dhugano dharab dhen teh kiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਇਸ ਨੇ ਦੁਗਣਾ ਧਨ ਦੇਣਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "दुगनो दरब देन तिह किया ॥",
      "sourceLineId": "134434",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਿਨ ਸਹੇਟ ਉਤ ਦੀਪ ਜਗਾਯੋ ॥",
      "transliteration": "tin saheT ut dheep jagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਮਿਥੇ ਹੋਏ ਸਥਾਨ ਉਤੇ ਦੀਵਾ ਜਗਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "तिन सहेट उत दीप जगायो ॥",
      "sourceLineId": "134435",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਇਤਿ ਇਸਤ੍ਰੀ ਇਮਿ ਭਾਖਿ ਸੁਨਾਯੋ ॥੭॥",
      "transliteration": "eit isatree im bhaakh sunaayo ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਧਰ ਇਸਤਰੀ ਨੇ ਉੱਚੀ ਆਵਾਜ਼ ਵਿਚ ਕਿਹਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "इति इसत्री इमि भाखि सुनायो ॥७॥",
      "sourceLineId": "134436",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹੇ ਨ੍ਰਿਪ ਮੁਹਿ ਮਾਯਾ ਤੁਮ ਜਾਨੋ ॥",
      "transliteration": "he nirap muh maayaa tum jaano ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਤੁਸੀਂ ਮੈਨੂੰ ਮਾਇਆ ਜਾਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "हे नृप मुहि माया तुम जानो ॥",
      "sourceLineId": "134437",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਿਕਟ ਕੇਤੁ ਕੀ ਗਡੀ ਪਛਾਨੋ ॥",
      "transliteration": "bikaT ket kee gaddee pachhaano ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਕਟ ਕੇਤੁ (ਰਾਜੇ) ਦੀ ਦਬੀ ਹੋਈ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "बिकट केतु की गडी पछानो ॥",
      "sourceLineId": "134438",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਪਨੀ ਇਸਤ੍ਰੀ ਕਹ ਬਲਿ ਦੈ ਕੈ ॥",
      "transliteration": "apanee isatree keh bal dhai kai ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੀ ਇਸਤਰੀ ਦੀ ਬਲੀ ਦੇ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "अपनी इसत्री कह बलि दै कै ॥",
      "sourceLineId": "134439",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਯਾ ਤੇ ਭਖਹੁ ਕਾਢਿ ਧਨ ਲੈ ਕੈ ॥੮॥",
      "transliteration": "yaa te bhakhahu kaadd dhan lai kai ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਥੋਂ ਧਨ ਕਢ ਕੇ ਲੈ ਜਾਓ ਅਤੇ ਵਰਤੋ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "या ते भखहु काढि धन लै कै ॥८॥",
      "sourceLineId": "134440",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਨੀ ਸਾਥ ਜਹਾ ਨ੍ਰਿਪ ਸੋਯੋ ॥",
      "transliteration": "raanee saath jahaa nirap soyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨਾਲ ਜਿਥੇ ਰਾਜਾ ਸੁਤਾ ਪਿਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "रानी साथ जहा नृप सोयो ॥",
      "sourceLineId": "134441",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਰਧਿਕ ਰਾਤ੍ਰਿ ਬਚਨ ਤਹ ਹੋਯੋ ॥",
      "transliteration": "aradhik raatr bachan teh hoyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਅੱਧੀ ਰਾਤ ਨੂੰ ਇਕ ਆਵਾਜ਼ ਹੋਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "अरधिक रातृ बचन तह होयो ॥",
      "sourceLineId": "134442",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮੁਹਿ ਮਾਯਾ ਕੌ ਘਰ ਹੀ ਰਾਖਹੁ ॥",
      "transliteration": "muh maayaa kau ghar hee raakhahu ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਮਾਇਆ ਨੂੰ ਆਪਣੇ ਘਰ ਵਿਚ ਹੀ ਰਖੋ",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "मुहि माया कौ घर ही राखहु ॥",
      "sourceLineId": "134443",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਇਸਤ੍ਰੀ ਦੈ ਅਪਨੀ ਬਲਿ ਭਾਖਹੁ ॥੯॥",
      "transliteration": "eisatree dhai apanee bal bhaakhahu ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੀ ਇਸਤਰੀ ਦੀ ਬਲੀ ਦੇ ਕੇ (ਮੈਨੂੰ) ਵਰਤੋ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "इसत्री दै अपनी बलि भाखहु ॥९॥",
      "sourceLineId": "134444",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਿਨ ਇਸਤ੍ਰੀ ਇਹ ਚਰਿਤ ਬਨਾਯੋ ॥",
      "transliteration": "jin isatree ieh charit banaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਇਸਤਰੀ (ਰਾਣੀ) ਨੇ ਇਹ ਚਰਿਤ੍ਰ ਰਚਿਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "जिन इसत्री इह चरित बनायो ॥",
      "sourceLineId": "134445",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਾ ਹੀ ਕੋ ਨ੍ਰਿਪ ਨਾਮ ਸੁਨਾਯੋ ॥",
      "transliteration": "taa hee ko nirap naam sunaayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਉਸੇ ਦਾ ਨਾ ਕਹਿ ਸੁਣਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "ता ही को नृप नाम सुनायो ॥",
      "sourceLineId": "134446",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਰਾਜਾ ਲੋਭ ਦਰਬ ਕੇ ਮਾਰੇ ॥",
      "transliteration": "raajaa lobh dharab ke maare ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਧਨ ਦੇ ਲਾਲਚ ਵਿਚ,",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "राजा लोभ दरब के मारे ॥",
      "sourceLineId": "134447",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਿਸੀ ਨਾਰਿ ਕਹ ਬਲਿ ਦੈ ਡਾਰੇ ॥੧੦॥",
      "transliteration": "tisee naar keh bal dhai ddaare ||10||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਦੀ ਬਲੀ ਦੇ ਦਿੱਤੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "तिसी नारि कह बलि दै डारे ॥१०॥",
      "sourceLineId": "134448",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਿਨਹੁ ਨਾਰਿ ਕੌ ਮਤੋ ਸਿਖਾਯੋ ॥",
      "transliteration": "jinahu naar kau mato sikhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਇਸਤਰੀ (ਦਾਸੀ) ਨੂੰ ਭੇਦ ਸਿਖਾਇਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "जिनहु नारि कौ मतो सिखायो ॥",
      "sourceLineId": "134449",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪਲਟਿ ਕਾਮ ਤਾਹੀ ਕੇ ਆਯੋ ॥",
      "transliteration": "palaT kaam taahee ke aayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਚਰਿਤ੍ਰ ਪਲਟ ਕੇ ਉਸ ਦੇ ਹੀ ਕੰਮ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "पलटि काम ताही के आयो ॥",
      "sourceLineId": "134450",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਉਨ ਤ੍ਰਿਯ ਦਰਬ ਤਾਹਿ ਬਹੁ ਦ੍ਰਯਾਇ ॥",
      "transliteration": "aun tiray dharab taeh bahu dhrayai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਨੇ ਉਸ (ਦਾਸੀ) ਨੂੰ ਬਹੁਤ ਧਨ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "उन तृय दरब ताहि बहु द्रयाइ ॥",
      "sourceLineId": "134451",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਾਰਿ ਤਿਸੀ ਕੌ ਹਨ੍ਯੌ ਬਨਾਇ ॥੧੧॥",
      "transliteration": "naar tisee kau hanayau banai ||11||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਸ ਇਸਤਰੀ ਨੇ ਉਸੇ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "नारि तिसी कौ हन्यौ बनाइ ॥११॥",
      "sourceLineId": "134452",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬੁਰੀ ਬਾਤ ਜੋ ਕੋਈ ਬਨਾਵੈ ॥",
      "transliteration": "buree baat jo koiee banaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਕੋਈ ਮਾੜਾ ਕੰਮ ਕਰਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "बुरी बात जो कोई बनावै ॥",
      "sourceLineId": "134453",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਉਲਟਿ ਕਾਮ ਤਾਹੀ ਕੇ ਆਵੈ ॥",
      "transliteration": "aulaT kaam taahee ke aavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਉਲਟਾ ਉਸੇ ਦੇ ਸਿਰ ਪੈਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "उलटि काम ताही के आवै ॥",
      "sourceLineId": "134454",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜੈਸਾ ਕਿਯੋ ਤੈਸ ਫਲ ਪਾਯੋ ॥",
      "transliteration": "jaisaa kiyo tais fal paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੋ ਜਿਹਾ (ਉਸ ਰਾਣੀ ਨੇ) ਕੀਤਾ ਸੀ, ਉਹੋ ਜਿਹਾ ਫਲ ਪਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "जैसा कियो तैस फल पायो ॥",
      "sourceLineId": "134455",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਾਹਿ ਹਨਤ ਥੀ ਆਪੁ ਹਨਾਯੋ ॥੧੨॥",
      "transliteration": "taeh hanat thee aap hanaayo ||12||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਦੂਜੀ ਰਾਣੀ) ਨੂੰ ਮਾਰਨਾ ਚਾਹੁੰਦੀ ਸੀ, ਪਰ ਆਪ ਹੀ ਮਾਰੀ ਗਈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "ताहि हनत थी आपु हनायो ॥१२॥",
      "sourceLineId": "134456",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸਤਾਈਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੨੭॥੬੧੬੪॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau sataiees charitr samaapatam sat subham sat ||327||6164||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੨੭ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੨੭॥੬੧੬੪॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ सताईस चरित्र समापतम सतु सुभम सतु ॥३२७॥६१६४॥अफजूँ॥",
      "sourceLineId": "134457",
      "sourceShabadId": "12575",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1278_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1278,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134458",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
