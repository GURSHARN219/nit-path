{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1279,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1279_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਥੰਭਕਰਨ ਇਕ ਥੰਭ੍ਰ ਦੇਸ ਨ੍ਰਿਪ ॥",
      "transliteration": "tha(n)bhakaran ik tha(n)bhr dhes nirap ||",
      "translation": "",
      "punjabiViakhya": "ਥੰਭ੍ਰ ਦੇਸ਼ ਦਾ ਇਕ ਥੰਭਕਰਨ ਨਾ ਦਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "थंभकरन इक थंभ्र देस नृप ॥",
      "sourceLineId": "134459",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਿਖ੍ਯ ਸਾਧੁ ਕੋ ਦੁਸਟਨ ਕੋ ਰਿਪੁ ॥",
      "transliteration": "sikhay saadh ko dhusaTan ko rip ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸਾਧਾ ਦਾ ਸੇਵਕ ਅਤੇ ਦੁਸ਼ਟਾ ਦਾ ਵੈਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "सिख्य साधु को दुसटन को रिपु ॥",
      "sourceLineId": "134460",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਾ ਕੇ ਸ੍ਵਾਨ ਏਕ ਥੋ ਆਛਾ ॥",
      "transliteration": "taa ke savaiaan ek tho aachhaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਇਕ ਬਹੁਤ ਵਧੀਆ ਕੁੱਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "ता के स्वान एक थो आछा ॥",
      "sourceLineId": "134461",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੁੰਦਰ ਘਨੋ ਸਿੰਘ ਸੋ ਕਾਛਾ ॥੧॥",
      "transliteration": "su(n)dhar ghano si(n)gh so kaachhaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬਹੁਤ ਸੁੰਦਰ ਸੀ ਅਤੇ ਸ਼ੇਰ ਵਰਗੀ ਉਸ ਦੀ ਡੀਲ ਡੌਲ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "सुँदर घनो सिंघ सो काछा ॥१॥",
      "sourceLineId": "134462",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਇਕ ਦਿਨ ਧਾਮ ਨ੍ਰਿਪਤਿ ਕੇ ਆਯੋ ॥",
      "transliteration": "eik dhin dhaam nirapat ke aayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ (ਉਹ ਕੁੱਤਾ) ਰਾਜੇ ਦੇ ਘਰ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "इक दिन धाम नृपति के आयो ॥",
      "sourceLineId": "134463",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪਾਹਨ ਹਨਿ ਤਿਹ ਤਾਹਿ ਹਟਾਯੋ ॥",
      "transliteration": "paahan han teh taeh haTaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਉਸ ਨੂੰ ਵੱਟੇ ਮਾਰ ਕੇ ਹਟਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "पाहन हनि तिह ताहि हटायो ॥",
      "sourceLineId": "134464",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤ੍ਰਿਯ ਕੀ ਹੁਤੀ ਸ੍ਵਾਨ ਸੌ ਪ੍ਰੀਤਾ ॥",
      "transliteration": "tiray kee hutee savaiaan sau preetaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਦੀ ਕੁੱਤੇ ਨਾਲ ਬਹੁਤ ਪ੍ਰੀਤ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "तृय की हुती स्वान सौ प्रीता ॥",
      "sourceLineId": "134465",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪਾਹਨ ਲਗੇ ਭਯੋ ਦੁਖ ਚੀਤਾ ॥੨॥",
      "transliteration": "paahan lage bhayo dhukh cheetaa ||2||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਵੱਟੇ ਲਗਣ ਕਰ ਕੇ (ਰਾਣੀ ਦਾ) ਚਿਤ ਦੁਖੀ ਹੋਇਆ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "पाहन लगे भयो दुख चीता ॥२॥",
      "sourceLineId": "134466",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪਾਹਨ ਲਗੇ ਸ੍ਵਾਨ ਮਰਿ ਗਯੋ ॥",
      "transliteration": "paahan lage savaiaan mar gayo ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਟੇ ਲਗਣ ਨਾਲ ਕੁੱਤਾ ਮਰ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "पाहन लगे स्वान मरि गयो ॥",
      "sourceLineId": "134467",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰਾਨੀ ਦੋਸ ਨ੍ਰਿਪਤਿ ਕਹ ਦਯੋ ॥",
      "transliteration": "raanee dhos nirapat keh dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਇਸ ਦਾ ਦੋਸ਼ ਰਾਜੇ ਨੂੰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "रानी दोस नृपति कह दयो ॥",
      "sourceLineId": "134468",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਰਿਯੋ ਸ੍ਵਾਨ ਭਯੋ ਕਹਾ ਉਚਾਰਾ ॥",
      "transliteration": "mariyo savaiaan bhayo kahaa uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਕਿਹਾ, ਕੀ ਹੋਇਆ ਜੇ ਕੁੱਤਾ ਮਰ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "मरियो स्वान भयो कहा उचारा ॥",
      "sourceLineId": "134469",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਐਸੇ ਹਮਰੇ ਪਰੈ ਹਜਾਰਾ ॥੩॥",
      "transliteration": "aaise hamare parai hajaaraa ||3||",
      "translation": "",
      "punjabiViakhya": "ਇਹੋ ਜਿਹੇ (ਕੁੱਤੇ) ਸਾਡੇ ਕੋਲ ਹਜ਼ਾਰਾ ਪਏ ਹਨ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "ऐसे हमरे परै हजारा ॥३॥",
      "sourceLineId": "134470",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਬ ਤੈ ਯਾ ਕੌ ਪੀਰ ਪਛਾਨਾ ॥",
      "transliteration": "ab tai yaa kau peer pachhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਤੂੰ ਇਸੇ ਨੂੰ ਪੀਰ ਸਮਝ ਲਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "अब तै या कौ पीर पछाना ॥",
      "sourceLineId": "134471",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਾ ਕੋ ਭਾਤਿ ਪੂਜਿ ਹੈ ਨਾਨਾ ॥",
      "transliteration": "taa ko bhaat pooj hai naanaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਦੀ ਕਈ ਤਰ੍ਰਹਾ ਨਾਲ ਪੂਜਾ ਕਰੇਾਂਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "ता को भाति पूजि है नाना ॥",
      "sourceLineId": "134472",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਹਿਯੋ ਸਹੀ ਤਬ ਯਾਹਿ ਪੁਜਾਊ ॥",
      "transliteration": "kahiyo sahee tab yaeh pujaauoo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ ਕਿਹਾ) (ਤੁਸੀਂ) ਸਹੀ ਕਿਹਾ ਹੈ, ਤਦ (ਮੈਂ) ਇਸੇ ਨੂੰ ਪੂਜਵਾਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "कहियो सही तब याहि पुजाऊ ॥",
      "sourceLineId": "134473",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭਲੇ ਭਲੇ ਤੇ ਨੀਰ ਭਰਾਊ ॥੪॥",
      "transliteration": "bhale bhale te neer bharaauoo ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੰਗੇ ਚੰਗੇ ਤੋਂ ਪਾਣੀ ਭਰਵਾਵਾਗੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "भले भले ते नीर भराऊ ॥४॥",
      "sourceLineId": "134474",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕੁਤਬ ਸਾਹ ਰਾਖਾ ਤਿਹ ਨਾਮਾ ॥",
      "transliteration": "kutab saeh raakhaa teh naamaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਉਸ ਦਾ ਨਾ ਕੁਤਬ ਸ਼ਾਹ ਰਖ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "कुतब साह राखा तिह नामा ॥",
      "sourceLineId": "134475",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਹੀ ਖੋਦਿ ਭੂਅ ਗਾਡਿਯੋ ਬਾਮਾ ॥",
      "transliteration": "tahee khodh bhooa gaaddiyo baamaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਧਰਤੀ ਪੁਟ ਕੇ ਉਥੇ ਹੀ ਦਬ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "तही खोदि भूअ गाडियो बामा ॥",
      "sourceLineId": "134476",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਾ ਕੀ ਗੋਰ ਬਣਾਈ ਐਸੀ ॥",
      "transliteration": "taa kee gor banaiee aaisee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਅਜਿਹੀ ਕਬਰ ਬਣਾਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "ता की गोर बणाई ऐसी ॥",
      "sourceLineId": "134477",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਿਸੀ ਪੀਰ ਕੀ ਹੋਇ ਨ ਜੈਸੀ ॥੫॥",
      "transliteration": "kisee peer kee hoi na jaisee ||5||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਕਿਸੇ ਪੀਰ ਦੀ ਵੀ ਨਾ ਹੋਵੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "किसी पीर की होइ न जैसी ॥५॥",
      "sourceLineId": "134478",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਕ ਦਿਨ ਆਪੁ ਤਹਾ ਤ੍ਰਿਯ ਗਈ ॥",
      "transliteration": "eik dhin aap tahaa tiray giee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਰਾਣੀ ਆਪ ਉਥੇ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "इक दिन आपु तहा तृय गई ॥",
      "sourceLineId": "134479",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਿਰਨੀ ਕਛੂ ਚੜਾਵਤ ਭਈ ॥",
      "transliteration": "siranee kachhoo chaRaavat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕੁਝ ਸ਼ੀਰਨੀ (ਮਿਠਿਆਈ) ਚੜ੍ਰਹਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "सिरनी कछू चड़ावत भई ॥",
      "sourceLineId": "134480",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮੰਨਤਿ ਮੋਰਿ ਕਹੀ ਬਰ ਆਈ ॥",
      "transliteration": "ma(n)nat mor kahee bar aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਹਿਣ ਲਗੀ, (ਮੈਨੂੰ) ਮਿਹਰਬਾਨ ਪੀਰ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "मंनति मोरि कही बर आई ॥",
      "sourceLineId": "134481",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੁਪਨਾ ਦਿਯੋ ਪੀਰ ਸੁਖਦਾਈ ॥੬॥",
      "transliteration": "supanaa dhiyo peer sukhadhaiee ||6||",
      "translation": "",
      "punjabiViakhya": "ਸੁਪਨੇ ਵਿਚ (ਦਰਸ਼ਨ) ਦੇ ਕੇ ਮੇਰੀ ਮੰਨਤ ਪੂਰੀ ਕਰ ਦਿੱਤੀ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "सुपना दियो पीर सुखदाई ॥६॥",
      "sourceLineId": "134482",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮੋਹਿ ਸੋਵਤੇ ਪੀਰ ਜਗਾਯੋ ॥",
      "transliteration": "moh sovate peer jagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਸੁੱਤੀ ਹੋਈ ਨੂੰ ਪੀਰ ਨੇ ਜਗਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "मोहि सोवते पीर जगायो ॥",
      "sourceLineId": "134483",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਆਪੁ ਆਪਨੀ ਕਬੁਰ ਬਤਾਯੋ ॥",
      "transliteration": "aap aapanee kabur bataayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਖ਼ੁਦ ਆਪਣੀ ਕਬਰ ਵਿਖਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "आपु आपनी कबुर बतायो ॥",
      "sourceLineId": "134484",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਾ ਤੇ ਮੈ ਇਹ ਠੌਰ ਪਛਾਨੀ ॥",
      "transliteration": "taa te mai ieh Thauar pachhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਮੇਰੀ ਮਨਸ਼ਾ ਪੂਰੀ ਹੋ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "ता ते मै इह ठौर पछानी ॥",
      "sourceLineId": "134485",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਬ ਹਮਰੀ ਮਨਸਾ ਬਰ ਆਨੀ ॥੭॥",
      "transliteration": "jab hamaree manasaa bar aanee ||7||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਆ ਕੇ ਮੈਂ ਇਹ ਸਥਾਨ ਪਛਾਣ ਲਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "जब हमरी मनसा बर आनी ॥७॥",
      "sourceLineId": "134486",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਜਬ ਪੁਰ ਮੈ ਸੁਨਿ ਪਾਯੋ ॥",
      "transliteration": "eeh bidh jab pur mai sun paayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਜਦ ਨਗਰ ਵਾਸੀਆਂ ਨੇ ਸੁਣਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "इह बिधि जब पुर मै सुनि पायो ॥",
      "sourceLineId": "134487",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜ੍ਰਯਾਰਤਿ ਸਕਲ ਲੋਗ ਮਿਲਿ ਆਯੋ ॥",
      "transliteration": "jrayaarat sakal log mil aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਦੇ ਜ਼ਿਆਰਤ (ਦਰਸ਼ਨ) ਕਰਨ ਲਈ ਸਾਰੇ ਲੋਕ ਆ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "ज्रयारति सकल लोग मिलि आयो ॥",
      "sourceLineId": "134488",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਸੀਰਨੀ ਚੜਾਵੈ ॥",
      "transliteration": "bhaat bhaat seeranee chaRaavai ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦੀਆਂ ਮਿਠਿਆਈਆਂ ਚੜ੍ਰਹਾਉਾਂਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "भाति भाति सीरनी चड़ावै ॥",
      "sourceLineId": "134489",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚੂੰਬਿ ਕਬੁਰ ਕੂਕਰ ਕੀ ਜਾਵੈ ॥੮॥",
      "transliteration": "choo(n)b kabur kookar kee jaavai ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕੁੱਤੇ ਦੀ ਕਬਰ ਨੂੰ ਚੁੰਮ ਕੇ ਜਾਦੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "चूँबि कबुर कूकर की जावै ॥८॥",
      "sourceLineId": "134490",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਾਜੀ ਸੇਖ ਸੈਯਦ ਤਹ ਆਵੈ ॥",
      "transliteration": "kaajee sekh saiyadh teh aavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਕਾਜ਼ੀ, ਸ਼ੇਖ, ਸੈਯਦ ਆਦਿ ਆਉਾਂਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "काजी सेख सैयद तह आवै ॥",
      "sourceLineId": "134491",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪੜਿ ਫਾਤਯਾ ਸੀਰਨੀ ਬਟਾਵੈ ॥",
      "transliteration": "paR faatayaa seeranee baTaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਾਤਿਆ (ਕਲਮਾ) ਪੜ੍ਰਹ ਕੇ ਸ਼ੀਰਨੀ ਵੰਡਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "पड़ि फातया सीरनी बटावै ॥",
      "sourceLineId": "134492",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਧੂਰਿ ਸਮਸ ਝਾਰੂਅਨ ਉਡਾਹੀ ॥",
      "transliteration": "dhoor samas jhaarooan uddaahee ||",
      "translation": "",
      "punjabiViakhya": "ਦਾੜ੍ਰਹੀਆਂ ਨੂੰ ਝਾੜੂ ਵਜੋਂ ਵਰਤ ਕੇ ਧੂੜ ਉਡਾਉਾਂਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "धूरि समस झारूअन उडाही ॥",
      "sourceLineId": "134493",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚੂੰਮਿ ਕਬੁਰ ਕੂਕਰ ਕੀ ਜਾਹੀ ॥੯॥",
      "transliteration": "choo(n)m kabur kookar kee jaahee ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕੁੱਤੇ ਦੀ ਕਬਰ ਨੂੰ ਚੁੰਮ ਕੇ ਜਾਦੇ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "चूँमि कबुर कूकर की जाही ॥९॥",
      "sourceLineId": "134494",
      "sourceShabadId": "12576",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "134495",
      "sourceShabadId": "12577",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਇਹ ਛਲ ਅਪਨੈ ਸ੍ਵਾਨ ਕੋ ਚਰਿਤ ਦਿਖਾਯੋ ਬਾਮ ॥",
      "transliteration": "eeh chhal apanai savaiaan ko charit dhikhaayo baam ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਚਰਿਤ੍ਰ ਇਸਤਰੀ ਨੇ ਆਪਣੇ ਕੁੱਤੇ ਲਈ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "इह छल अपनै स्वान को चरित दिखायो बाम ॥",
      "sourceLineId": "134496",
      "sourceShabadId": "12577",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਬ ਲਗਿ ਕਹ ਜ੍ਰਯਾਰਤਿ ਕਰੈ ਸਾਹੁ ਕੁਤਬ ਦੀ ਨਾਮ ॥੧੦॥",
      "transliteration": "ab lag keh jrayaarat karai saahu kutab dhee naam ||10||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਤਕ ਉਥੇ ਲੋਕੀਂ ਕੁਤਬ ਸ਼ਾਹ ਦੇ ਨਾ ਦੀ ਯਾਤ੍ਰਾ ਕਰਦੇ ਹਨ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "अब लगि कह ज्रयारति करै साहु कुतब दी नाम ॥१०॥",
      "sourceLineId": "134497",
      "sourceShabadId": "12577",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਅਠਾਈਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੨੮॥੬੧੭੪॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau aThaiees charitr samaapatam sat subham sat ||328||6174||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੨੮ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੨੮॥੬੧੭੪॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ अठाईस चरित्र समापतम सतु सुभम सतु ॥३२८॥६१७४॥अफजूँ॥",
      "sourceLineId": "134498",
      "sourceShabadId": "12577",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134499",
      "sourceShabadId": "12578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਿਜਿਯਾਵਤੀ ਨਗਰ ਇਕ ਸੋਹੈ ॥",
      "transliteration": "bijiyaavatee nagar ik sohai ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਜਿਯਾਵਤੀ ਨਾ ਦਾ ਇਕ ਨਗਰ ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "बिजियावती नगर इक सोहै ॥",
      "sourceLineId": "134500",
      "sourceShabadId": "12578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬ੍ਰਿਭ੍ਰਮ ਸੈਨ ਨ੍ਰਿਪਤਿ ਤਹ ਕੋਹੈ ॥",
      "transliteration": "birabhram sain nirapat teh kohai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੋਂ ਦਾ ਰਾਜਾ ਬ੍ਰਿਭ੍ਰਮ ਸੈਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "बृभ्रम सैन नृपति तह कोहै ॥",
      "sourceLineId": "134501",
      "sourceShabadId": "12578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬ੍ਰਯਾਘ੍ਰ ਮਤੀ ਤਾ ਕੇ ਘਰ ਦਾਰਾ ॥",
      "transliteration": "brayaaghr matee taa ke ghar dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਆਘ੍ਰ ਮਤੀ ਨਾ ਦੇ ਉਸ ਘਰ ਦੇ ਘਰ ਰਾਣੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "ब्रयाघ्र मती ता के घर दारा ॥",
      "sourceLineId": "134502",
      "sourceShabadId": "12578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੰਦ੍ਰ ਲਯੋ ਤਾ ਤੇ ਉਜਿਯਾਰਾ ॥੧॥",
      "transliteration": "cha(n)dhr layo taa te ujiyaaraa ||1||",
      "translation": "",
      "punjabiViakhya": "(ਇਤਨੀ ਸੁੰਦਰ ਸੀ) ਮਾਨੋ ਚੰਦ੍ਰਮਾ ਨੇ ਉਸ ਤੋਂ ਪ੍ਰਕਾਸ਼ ਲਿਆ ਹੋਵੇ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "चंद्र लयो ता ते उजियारा ॥१॥",
      "sourceLineId": "134503",
      "sourceShabadId": "12578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਿਹ ਠਾ ਹੁਤੀ ਏਕ ਪਨਿਹਾਰੀ ॥",
      "transliteration": "teh Thaa hutee ek panihaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਪਨਿਹਾਰੀ (ਝੀਊਰੀ) ਹੁੰਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "तिह ठा हुती एक पनिहारी ॥",
      "sourceLineId": "134504",
      "sourceShabadId": "12578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨ੍ਰਿਪ ਕੇ ਬਾਰ ਭਰਤ ਥੀ ਦ੍ਵਾਰੀ ॥",
      "transliteration": "nirap ke baar bharat thee dhavaiaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਰਾਜੇ ਦੇ ਦੁਆਰ ਤੇ ਪਾਣੀ ਭਰਦੀ ਹੁੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "नृप के बार भरत थी द्वारी ॥",
      "sourceLineId": "134505",
      "sourceShabadId": "12578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1279_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਿਹ ਕੰਚਨ ਕੇ ਭੂਖਨ ਲਹਿ ਕੈ ॥",
      "transliteration": "teh ka(n)chan ke bhookhan leh kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ (ਇਕ ਦਿਨ) ਸੋਨੇ ਦੇ ਗਹਿਣੇ ਵੇਖੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1279,
      "hindi": "",
      "hindiTransliteration": "तिह कंचन के भूखन लहि कै ॥",
      "sourceLineId": "134506",
      "sourceShabadId": "12578",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
